    "tags": ["spiral-test"],
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always"
  },
  {
    "label": "spiral: run file tests",
    "command": "pwsh",
    "args": ["-NoProfile", "-File", "$ZED_WORKTREE_ROOT/apps/zed/tasks/test-at-row.ps1", "-File", "$ZED_FILE"],
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always"
  }
