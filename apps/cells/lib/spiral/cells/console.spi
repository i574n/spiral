inl (~!\\) forall t u. ((args : t), (code : string)) : u =
    $'__spiral_emit_rust !args !code '

inl show_value forall t. (value : t) : () =
    inl rust () : () =
        inl _ : () =
            !\\(value, $'"{ struct SpiralKinoShow<T>(T); trait SpiralKinoDebug { fn spiral_cells_show(&self) -> \
                String; } impl<T: std::fmt::Debug> SpiralKinoDebug for SpiralKinoShow<T> { fn \
                spiral_cells_show(&self) -> String { format\!(\\\"{:?}\\\", self.0) } } trait SpiralKinoOther { fn \
                spiral_cells_show(&self) -> String; } impl<T> SpiralKinoOther for &SpiralKinoShow<T> { fn \
                spiral_cells_show(&self) -> String { String::from(std::any::type_name::<T>()) } } let text = \
                (&SpiralKinoShow(&$0)).spiral_cells_show(); let mut out = std::io::stdout(); let _ = <std::io::Stdout \
                as std::io::Write>::write_all(&mut out, format\!(\\\"SPIRAL_CELLS_VALUE:{}\\\", text).as_bytes()); \
                let _ = <std::io::Stdout as std::io::Write>::write_all(&mut out, &[10u8]); let _ = <std::io::Stdout \
                as std::io::Write>::flush(&mut out); }"')
        ()
    inl gleam () : () =
        global "import gleam/io"
        global "import gleam/string"
        $'io.println(string.inspect(!value))' : ()
    inl cpp () : () =
        global "#include <iostream>"
        $'std::cout << !value << std::endl' : ()
    !!!!BackendSwitch({
        Rust = fun () => rust ()
        Fsharp = fun () => $'System.Console.WriteLine(match box !value with :? string as s -> s | v -> sprintf "%A" \
            v)' : ()
        TypeScript = fun () => $'console.log(!value)' : ()
        Python = fun () => $'print(!value)' : ()
        Lua = fun () =>
            real
                typecase t with
                | i64 => $'print(spiral_w64.tostring(!value, true))' : ()
                | u64 => $'print(spiral_w64.tostring(!value, false))' : ()
                | _ => $'print(!value)' : ()
        Gleam = fun () => gleam ()
        Cpp = fun () => cpp ()
        Zig = fun () => $'{ spiralPrintAny(!value); spiralPrint(&[_]u8{10}); }' : ()
        Lean = fun () => $'IO.println (toString !value)' : ()
        CppHost = fun () => cpp ()
        C = fun () => $'backend_switch_has_no_C_arm_in_cells_console' : ()
        Delphi = fun () => $'backend_switch_has_no_Delphi_arm_in_cells_console' : ()
        Wasm = fun () => $'backend_switch_has_no_Wasm_arm_in_cells_console' : ()
        Bend = fun () => $'backend_switch_has_no_Bend_arm_in_cells_console' : ()
    })

inl write_line forall t. (text : t) : () =
    inl rust () : () =
        inl _ : () =
            !\\(text, $'"{ let mut out = std::io::stdout(); let _ = <std::io::Stdout as \
                std::io::Write>::write_all(&mut out, ToString::to_string(&$0).as_bytes()); let _ = <std::io::Stdout \
                as std::io::Write>::write_all(&mut out, &[10u8]); let _ = <std::io::Stdout as \
                std::io::Write>::flush(&mut out); }"')
        ()
    inl gleam () : () =
        global "import gleam/io"
        $'io.println(!text)' : ()
    inl cpp () : () =
        global "#include <iostream>"
        $'std::cout << !text << std::endl' : ()
    !!!!BackendSwitch({
        Rust = fun () => rust ()
        Fsharp = fun () => $'System.Console.WriteLine(!text)' : ()
        TypeScript = fun () => $'console.log(!text)' : ()
        Python = fun () => $'print(!text)' : ()
        Lua = fun () =>
            real
                typecase t with
                | i64 => $'print(spiral_w64.tostring(!text, true))' : ()
                | u64 => $'print(spiral_w64.tostring(!text, false))' : ()
                | _ => $'print(!text)' : ()
        Gleam = fun () => gleam ()
        Cpp = fun () => cpp ()
        Zig = fun () => $'{ spiralPrintAny(!text); spiralPrint(&[_]u8{10}); }' : ()
        Lean = fun () => $'IO.println (toString !text)' : ()
        CppHost = fun () => cpp ()
        C = fun () => $'backend_switch_has_no_C_arm_in_cells_console' : ()
        Delphi = fun () => $'backend_switch_has_no_Delphi_arm_in_cells_console' : ()
        Wasm = fun () => $'backend_switch_has_no_Wasm_arm_in_cells_console' : ()
        Bend = fun () => $'backend_switch_has_no_Bend_arm_in_cells_console' : ()
    })

inl display (mime : string) (data : string) : () =
    write_line "SPIRAL_CELLS_DISPLAY_BEGIN"
    write_line mime
    write_line data
    write_line "SPIRAL_CELLS_DISPLAY_END"
