///- --package .
///> gleam
:# builder_output static =
    :< testing
    :< json_value

:< json_value

:= space3 (b1 : i32) (b2 : i32) : bool =
    (b1 = 128i32 && ((b2 >= 128i32 && b2 <= 138i32) || b2 = 168i32 || b2 = 169i32 || b2 = 175i32)) || (b1 = 129i32 && b2 = 159i32)

:= space_width (s : string) (i : i32) : i32 =
    := b = at s i
    := b1 = at s (i + 1i32)
    := b2 = at s (i + 2i32)
    ? b = 32i32 || (b >= 9i32 && b <= 13i32) ?> 1i32
    |? b = 194i32 && (b1 = 133i32 || b1 = 160i32) ?> 2i32
    |? b = 225i32 && b1 = 154i32 && b2 = 128i32 ?> 3i32
    |? b = 226i32 && space3 b1 b2 ?> 3i32
    |? b = 227i32 && b1 = 128i32 && b2 = 128i32 ?> 3i32
    |: 0i32

:~ ^ content_start (s : string) (i : i32) : i32 =
    := w = space_width s i
    ? w > 0i32 ?> content_start s (i + w) |: i

:~ ^ content_end (s : string) (i : i32) (last : i32) : i32 =
    := w = space_width s i
    ? i >= text::length s ?> last
    |? w > 0i32 ?> content_end s (i + w) last
    |:
        := next = i + text::utf8_width (at s i)
        content_end s next next

:= utrim (s : string) : string =
    := a = content_start s 0i32
    text::slice_len s a (content_end s a a - a)

:= has (key : string) (v : json) : bool =
    ?= field key v ?|
    | Some _ => !+
    | None => !-

:= result_of (s : string) : option json =
    ?= parse s ?|
    | Some v => ? has "output" v || has "command_result" v ?> Some v |: None
    | None => None

:= pcre_space (b : i32) : bool = b = 32i32 || (b >= 9i32 && b <= 13i32)

:~ ^ last_content (s : string) (i : i32) : i32 = ? i >= 0i32 && pcre_space (at s i) ?> last_content s (i - 1i32) |: i

:~ ^ line_start (s : string) (i : i32) : i32 = ? i <= 0i32 || at s (i - 1i32) = 10i32 ?> i |: line_start s (i - 1i32)

:= tail_object (s : string) : option string =
    := e = last_content s (text::length s - 1i32)
    := p = ? e >= 0i32 && at s e = 125i32 ?> text::find_from s "{" (line_start s e) |: -1i32
    ? p >= 0i32 && p <= e ?> Some (text::slice_len s p (e - p + 1i32)) |: None

:= result_map (s : string) : option json =
    ?= result_of s ?|
    | Some v => Some v
    | None =>
        ?= tail_object s ?|
        | Some candidate => result_of candidate
        | None => None

:= drop_cr (line : string) : string = ? text::length line > 0i32 && at line (text::length line - 1i32) = 13i32 ?> text::take line (text::length line - 1i32) |: line

:~ ^ crlf_lines (pieces : list string) (acc : list string) : list string =
    ?= pieces ?|
    | last :: [] => listm::rev (last :: acc)
    | line :: rest => crlf_lines rest (drop_cr line :: acc)
    | [] => listm::rev acc

:= lines_of (s : string) : list string = crlf_lines (sm'::split_list "\n" s) []

:~ ^ params_end (s : string) (i : i32) : i32 =
    := b = at s i
    ? is_digit b || b = 59i32 ?> params_end s (i + 1i32) |: i

:~ ^ ansi_from (s : string) (i : i32) (start : i32) (acc : string) : string =
    := j = params_end s (i + 2i32)
    ? i >= text::length s ?> acc ++ text::slice_len s start (i - start)
    |? at s i = 27i32 && at s (i + 1i32) = 91i32 && at s j = 109i32 ?> ansi_from s (j + 1i32) (j + 1i32) (acc ++ text::slice_len s start (i - start))
    |: ansi_from s (i + 1i32) start acc

:= strip_ansi (s : string) : string = ansi_from s 0i32 0i32 ""

:= is_trace_line (line : string) : bool =
    := t = utrim line
    ?= result_map t ?|
    | Some _ => !-
    | None => t <> ""

:~ ^ kept (lines : list string) (acc : list string) : list string =
    ?= lines ?|
    | line :: rest => kept rest (? is_trace_line line ?> line :: acc |: acc)
    | [] => listm::rev acc

:= trace_text (s : string) : string = utrim (sm'::concat_list "\n" (kept (lines_of (strip_ansi s)) []))

:= text_of (v : option json) : option string =
    ?= v ?|
    | Some (JStr t) => Some t
    | _ => None

:= inner_of (map : json) : option json =
    ?= field "command_result" map ?|
    | Some (JStr t) => parse t
    | Some (JObj members) => Some (JObj members)
    | _ => None

:= shown_output (map : json) : option string =
    := inner = ?= inner_of map ?| Some v => text_of (field "output" v) | None => None
    ?= inner ?|
    | Some t => Some t
    | None => text_of (field "output" map)

:~ ^ last_result (lines : list string) : option json =
    ?= lines ?|
    | line :: rest =>
        ?= result_map line ?|
        | Some v => Some v
        | None => last_result rest
    | [] => None

:= output_field (s : string) : option string =
    := found = ?= result_map s ?| Some v => Some v | None => last_result (listm::rev (lines_of s))
    ?= found ?|
    | Some map => shown_output map
    | None => None

:= present (output : string) : string =
    := trimmed = utrim output
    := trace = trace_text trimmed
    ?= output_field trimmed ?|
    | Some field => ? utrim field <> "" ?> utrim field |: trace
    | None => ? trace <> "" ?> trace |: trimmed

:= failed_text (trace : string) : bool =
    := down = text::lowercase trace
    text::contains down "error" || text::contains down "failed"

:= failure_trace (output : string) : string =
    := trace = trace_text output
    := shown = ?= output_field output ?| Some field => utrim field <> "" | None => !-
    ? shown ?> "" |? failed_text trace ?> trace |: ""

:= esc () : string = unicode::char_of 27i32

:# builder_outputs_show_the_result_field_or_the_trace =
    present "  {\"output\":\" hi \"}\n" |> _assert_eq "hi"
    present ("warming up\n" ++ esc () ++ "[31mbuild failed" ++ esc () ++ "[0m\r\n{\"command_result\":\"{\\\"output\\\":\\\"inner\\\"}\"}") |> _assert_eq "inner"
    present "noise\n{\"output\":\"\"}" |> _assert_eq "noise"
    present "plain text" |> _assert_eq "plain text"
    failure_trace "compile ERROR at 3\n{\"output\":\"\"}" |> _assert_eq "compile ERROR at 3"
    failure_trace "{\"output\":\"ok\"}" |> _assert_eq ""
