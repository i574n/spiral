///- --package .
:# builders static =
    :< testing

:= (++) (left : string) (right : string) : string = left ^^ right

:= ffi () : () =
    global "import gleam/string"
    global """
        fn builders_graphemes(text: String) -> Int {
          string.length(text)
        }
        """
    global """
        fn builders_first(text: String) -> String {
          case string.pop_grapheme(text) {
            Ok(#(first, _)) -> first
            Error(_) -> ""
          }
        }
        """
    global """
        fn builders_rest(text: String) -> String {
          case string.pop_grapheme(text) {
            Ok(#(_, rest)) -> rest
            Error(_) -> ""
          }
        }
        """
    global """
        fn builders_slice(text: String, at: Int, len: Int) -> String {
          string.slice(text, at, len)
        }
        """

:= grapheme_count (s : string) : i32 =
    ffi ()
    $'builders_graphemes(!s)' : i32

:= first_grapheme (s : string) : string =
    ffi ()
    $'builders_first(!s)' : string

:= rest_graphemes (s : string) : string =
    ffi ()
    $'builders_rest(!s)' : string

:= grapheme_slice (s : string) (at : i32) (n : i32) : string =
    ffi ()
    $'builders_slice(!s, !at, !n)' : string

:| tool =
    | ForRust
    | ForFsharp
    | ForTypescript
    | ForPython
    | ForCuda
    | ForCpp
    | ForGleam
    | ForLua
    | ForC
    | ForPascal
    | ForZig
    | ForLean
    | ForWgsl

:| field =
    | FContract
    | FWasm
    | FTarget
    | FEnv

:| flag_kind =
    | TakesOptional : field
    | TakesOne : field
    | TakesDeps
    | TakesCleanup

:| inline =
    | Bare
    | Inline : string

:| dep_version =
    | NoVersion
    | AnyVersion
    | Version : string

:== dep = { name : string; version : dep_version; raw : string }

:== builder_values = { contract : option string; wasm : option string; target : option string; env : option string }

:== builder = { tool : tool; raw : string; values : builder_values; deps : list dep; cleanup : option bool }

:| command =
    | Builder : builder

:= tool_of (name : string) : option tool =
    ? name = "rust"
    ?> Some ForRust
    |? name = "fsharp" || name = "fs"
    ?> Some ForFsharp
    |? name = "typescript" || name = "ts"
    ?> Some ForTypescript
    |? name = "python" || name = "py"
    ?> Some ForPython
    |? name = "cuda"
    ?> Some ForCuda
    |? name = "cpp"
    ?> Some ForCpp
    |? name = "gleam"
    ?> Some ForGleam
    |? name = "lua"
    ?> Some ForLua
    |? name = "c"
    ?> Some ForC
    |? name = "pascal" || name = "delphi"
    ?> Some ForPascal
    |? name = "zig"
    ?> Some ForZig
    |? name = "lean"
    ?> Some ForLean
    |? name = "wgsl"
    ?> Some ForWgsl
    |: None

:= tool_name (t : tool) : string =
    ?= t ?|
    | ForRust => "rust"
    | ForFsharp => "fsharp"
    | ForTypescript => "typescript"
    | ForPython => "python"
    | ForCuda => "cuda"
    | ForCpp => "cpp"
    | ForGleam => "gleam"
    | ForLua => "lua"
    | ForC => "c"
    | ForPascal => "pascal"
    | ForZig => "zig"
    | ForLean => "lean"
    | ForWgsl => "wgsl"

:= expected () : string =
    "rust, fsharp, typescript, python, cuda, cpp, gleam, lua, c, pascal, delphi, zig, lean, or wgsl"

:= deps_long (name : string) : option flag_kind = ? name = "deps" ?> Some TakesDeps |: None

:= deps_short (letter : string) : option flag_kind = ? letter = "d" ?> Some TakesDeps |: None

:= rust_long (name : string) : option flag_kind =
    ? name = "contract"
    ?> Some (TakesOptional FContract)
    |? name = "wasm"
    ?> Some (TakesOptional FWasm)
    |? name = "cleanup"
    ?> Some TakesCleanup
    |: deps_long name

:= rust_short (letter : string) : option flag_kind =
    ? letter = "c"
    ?> Some (TakesOptional FContract)
    |? letter = "w"
    ?> Some (TakesOptional FWasm)
    |? letter = "l"
    ?> Some TakesCleanup
    |: deps_short letter

:= long_flag (t : tool) (name : string) : option flag_kind =
    ?= t ?|
    | ForRust => rust_long name
    | ForGleam => ? name = "target" ?> Some (TakesOne FTarget) |: deps_long name
    | ForPython => ? name = "env" ?> Some (TakesOne FEnv) |: deps_long name
    | ForCuda => ? name = "env" ?> Some (TakesOne FEnv) |: deps_long name
    | ForTypescript => deps_long name
    | _ => None

:= short_flag (t : tool) (letter : string) : option flag_kind =
    ?= t ?|
    | ForRust => rust_short letter
    | ForGleam => ? letter = "t" ?> Some (TakesOne FTarget) |: deps_short letter
    | ForPython => ? letter = "e" ?> Some (TakesOne FEnv) |: deps_short letter
    | ForCuda => ? letter = "e" ?> Some (TakesOne FEnv) |: deps_short letter
    | ForTypescript => deps_short letter
    | _ => None

:= blank (t : tool) (raw : string) : builder =
    {
        tool = t
        raw = raw
        values = { contract = None; wasm = None; target = None; env = None }
        deps = []
        cleanup = None
    }

:= set_value (f : field) (v : string) (x : builder_values) : builder_values =
    ?= f ?|
    | FContract => { x ?| contract = Some v }
    | FWasm => { x ?| wasm = Some v }
    | FTarget => { x ?| target = Some v }
    | FEnv => { x ?| env = Some v }

:= with_value (f : field) (v : string) (b : builder) : builder = { b ?| values = set_value f v b::values }

:= upper_hex (n : i32) : string = text::one "0123456789ABCDEF" n

:= hex4_upper (c : i32) : string =
    upper_hex (c / 4096i32 % 16i32)
    ++ upper_hex (c / 256i32 % 16i32)
    ++ upper_hex (c / 16i32 % 16i32)
    ++ upper_hex (c % 16i32)

:= named_escape (c : i32) : string =
    ? c = 7i32
    ?> "\\a"
    |? c = 8i32
    ?> "\\b"
    |? c = 9i32
    ?> "\\t"
    |? c = 10i32
    ?> "\\n"
    |? c = 11i32
    ?> "\\v"
    |? c = 12i32
    ?> "\\f"
    |? c = 13i32
    ?> "\\r"
    |? c = 27i32
    ?> "\\e"
    |? c = 127i32
    ?> "\\d"
    |? c = 34i32
    ?> "\\\""
    |? c = 92i32
    ?> "\\\\"
    |: ""

:= within (c : i32) (lo : i32) (hi : i32) : bool = c >= lo && c <= hi

:= unicode_escaped (c : i32) : bool =
    c = 160i32 || c = 847i32 || c = 1564i32 || within c 8192i32 8207i32 || within c 8232i32 8238i32
    || within c 8287i32 8292i32 || within c 8294i32 8297i32 || c = 65279i32 || within c 65529i32 65532i32

:= unprintable (c : i32) : bool =
    (c < 32i32 && (c < 7i32 || c > 13i32) && c <> 27i32) || within c 128i32 159i32 || c = 65534i32 || c = 65535i32

:~ ^ printable_from (s : string) (i : i32) : bool =
    := w = json_value::utf8_width_at s i
    ? i >= text::length s
    ?> !+
    |? json_value::at s i < 128i32
    ?> ? unprintable (json_value::at s i) ?> !- |: printable_from s (i + 1i32)
    |? w = 0i32 || unprintable (text::code_point s i)
    ?> !-
    |: printable_from s (i + w)

:~ ^ bytes_from (s : string) (i : i32) (acc : string) : string =
    ? i >= text::length s
    ?> acc
    |:
        bytes_from s
            (i + 1i32)
            (? i = 0i32 ?> text::show_i32 (text::byte_at s i) |: acc ++ ", " ++ text::show_i32 (text::byte_at s i))

:~ ^ quoted_from (s : string) (i : i32) (acc : string) : string =
    := b = json_value::at s i
    := w = ? b < 128i32 ?> 1i32 |: json_value::utf8_width_at s i
    := c = ? b < 128i32 ?> b |: text::code_point s i
    := named = named_escape c
    ? i >= text::length s
    ?> acc
    |? named <> ""
    ?> quoted_from s (i + 1i32) (acc ++ named)
    |? c = 35i32 && json_value::at s (i + 1i32) = 123i32
    ?> quoted_from s (i + 1i32) (acc ++ "\\#")
    |? unicode_escaped c
    ?> quoted_from s (i + w) (acc ++ "\\u" ++ hex4_upper c)
    |: quoted_from s (i + w) (acc ++ text::slice_len s i w)

:= inspect (s : string) : string =
    ? printable_from s 0i32 ?> "\"" ++ quoted_from s 0i32 "" ++ "\"" |: "<<" ++ bytes_from s 0i32 "" ++ ">>"

:= is_quote (g : string) : bool = g = "\"" || g = "'"

:~ ^ tokens_from (s : string) (current : string) (q : option string) (acc : list string) : result (list string) string =
    := g = first_grapheme s
    := rest = rest_graphemes s
    := pushed = ? current = "" ?> acc |: current :: acc
    ? s = "" ?>
        ?= q ?|
        | Some _ => Error "unterminated quote in builder arguments"
        | None => Ok (listm::rev pushed)
    |:
        ?= q ?|
        | None =>
            ? g = " " || g = "\t"
            ?> tokens_from rest "" None pushed
            |? g = "\\" && is_quote (first_grapheme rest)
            ?> tokens_from (rest_graphemes rest) (current ++ first_grapheme rest) None acc
            |? is_quote g
            ?> tokens_from rest current (Some g) acc
            |: tokens_from rest (current ++ g) None acc
        | Some open_q =>
            ? g = "\\" && first_grapheme rest = open_q
            ?> tokens_from (rest_graphemes rest) (current ++ open_q) q acc
            |? g = open_q
            ?> tokens_from rest current None acc
            |: tokens_from rest (current ++ g) q acc

:= ends_with (s : string) (p : string) : bool =
    text::length s >= text::length p && text::starts_at s (text::length s - text::length p) p

:= quoted_by (v : string) (mark : string) : bool =
    text::starts_with v mark && ends_with v mark && text::length v >= 2i32

:= unquoted (v : string) : string =
    := n = grapheme_count v
    ? quoted_by v "\"" || quoted_by v "'" ?> grapheme_slice v 1i32 (? n >= 2i32 ?> n - 2i32 |: 0i32) |: v

:= dep_of (token : string) : dep =
    := k = text::find_from token "=" 0i32
    ? k >= 0i32
    ?> { name = text::take token k; version = Version (unquoted (text::drop token (k + 1i32))); raw = token }
    |? ends_with token "]"
    ?> { name = token; version = NoVersion; raw = token }
    |: { name = token; version = AnyVersion; raw = token }

:= is_flag_token (t : string) : bool = text::starts_with t "-" && t <> "-"

:= bool_of (v : string) (flag : string) : result bool string =
    ? v = "true"
    ?> Ok !+
    |? v = "false"
    ?> Ok !-
    |: Error ("expected true or false for " ++ flag ++ ", got: " ++ inspect v)

:~ ^ deps_run (tokens : list string) (taken : list dep) : list dep * list string =
    ?= tokens ?|
    | t :: rest => ? is_flag_token t ?> listm::rev taken, tokens |: deps_run rest (dep_of t :: taken)
    | [] => listm::rev taken, []

:= add_deps (b : builder) (more : list dep) : builder = { b ?| deps = listm::append b::deps more }

:= optional_step (f : field) (rest : list string) (b : builder) : result (builder * list string) string =
    ?= rest ?|
    | next :: left => ? is_flag_token next ?> Ok (with_value f "" b, rest) |: Ok (with_value f next b, left)
    | [] => Ok (with_value f "" b, [])

:= one_step (f : field) (rest : list string) (b : builder) (flag : string) : result (builder * list string) string =
    ?= rest ?|
    | next :: left => ? is_flag_token next ?> Error ("expected a value for " ++ flag) |: Ok (with_value f next b, left)
    | [] => Error ("expected a value for " ++ flag)

:= cleanup_step (rest : list string) (b : builder) : builder * list string =
    ?= rest ?|
    | next :: left =>
        ? next = "true"
        ?> { b ?| cleanup = Some !+ }, left
        |? next = "false"
        ?> { b ?| cleanup = Some !- }, left
        |: { b ?| cleanup = Some !- }, rest
    | [] => { b ?| cleanup = Some !- }, rest

:= optional_flag
    (f : field) (value : inline) (rest : list string) (b : builder)
    : result (builder * list string) string
    =
    ?= value ?|
    | Inline v => Ok (with_value f v b, rest)
    | Bare => optional_step f rest b

:= one_flag
    (f : field) (value : inline) (rest : list string) (b : builder) (flag : string)
    : result (builder * list string) string
    =
    ?= value ?|
    | Inline v => Ok (with_value f v b, rest)
    | Bare => one_step f rest b flag

:= deps_bare (rest : list string) (b : builder) (flag : string) : result (builder * list string) string =
    := taken, left = deps_run rest []
    ? listm::length taken = 0i32 ?> Error ("expected a dependency name for " ++ flag) |: Ok (add_deps b taken, left)

:= deps_flag
    (value : inline) (rest : list string) (b : builder) (flag : string)
    : result (builder * list string) string
    =
    ?= value ?|
    | Inline v => Ok (add_deps b [ dep_of v ], rest)
    | Bare => deps_bare rest b flag

:= cleanup_inline
    (v : string) (rest : list string) (b : builder) (flag : string)
    : result (builder * list string) string
    =
    ?= bool_of v flag ?|
    | Ok on => Ok ({ b ?| cleanup = Some on }, rest)
    | Error e => Error e

:= cleanup_flag
    (value : inline) (rest : list string) (b : builder) (flag : string)
    : result (builder * list string) string
    =
    ?= value ?|
    | Inline v => cleanup_inline v rest b flag
    | Bare => Ok (cleanup_step rest b)

:~ apply_flag
    (kind : flag_kind) (value : inline) (rest : list string) (b : builder) (flag : string)
    : result (builder * list string) string
    =
    ?= kind ?|
    | TakesOptional f => optional_flag f value rest b
    | TakesOne f => one_flag f value rest b flag
    | TakesDeps => deps_flag value rest b flag
    | TakesCleanup => cleanup_flag value rest b flag

:= unknown_flag (flag : string) : result (builder * list string) string =
    Error ("unknown builder flag " ++ inspect flag)

:= consuming (kind : flag_kind) : bool =
    ?= kind ?|
    | TakesOne _ => !+
    | TakesDeps => !+
    | _ => !-

:= cluster_value (kind : flag_kind) : inline =
    ?= kind ?|
    | TakesCleanup => Inline "false"
    | _ => Inline ""

:~ ^ cluster (t : tool) (letters : string) (rest : list string) (b : builder) : result (builder * list string) string =
    := letter = first_grapheme letters
    := others = rest_graphemes letters
    := flag = "-" ++ letter
    ? letters = ""
    ?> Ok (b, rest)
    |:
        ?= short_flag t letter ?|
        | None => unknown_flag flag
        | Some kind =>
            ? consuming kind && others <> ""
            ?> Error ("builder flag " ++ flag ++ " must be the last flag in -" ++ letter ++ others)
            |? consuming kind
            ?> apply_flag kind Bare rest b flag
            |:
                ?= apply_flag kind (cluster_value kind) [] b flag ?|
                | Ok (next, _) => cluster t others rest next
                | Error e => Error e

:= split_eq (body : string) : string * inline =
    := k = text::find_from body "=" 0i32
    ? k < 0i32 ?> body, Bare |: text::take body k, Inline (text::drop body (k + 1i32))

:= long_step (t : tool) (token : string) (rest : list string) (b : builder) : result (builder * list string) string =
    := name, value = split_eq (text::drop token 2i32)
    ?= long_flag t name ?|
    | Some kind => apply_flag kind value rest b ("--" ++ name)
    | None => unknown_flag ("--" ++ name)

:= short_step (t : tool) (token : string) (rest : list string) (b : builder) : result (builder * list string) string =
    := letters, value = split_eq (text::drop token 1i32)
    ?= value ?|
    | Bare => cluster t letters rest b
    | Inline v =>
        ? grapheme_count letters <> 1i32
        ?> unknown_flag token
        |:
            ?= short_flag t letters ?|
            | Some kind => apply_flag kind (Inline v) rest b ("-" ++ letters)
            | None => unknown_flag ("-" ++ letters)

:~ ^ parse_tokens (t : tool) (tokens : list string) (b : builder) : result builder string =
    ?= tokens ?|
    | [] => Ok b
    | token :: rest =>
        := step =
            ? text::starts_with token "--"
            ?> long_step t token rest b
            |? is_flag_token token
            ?> short_step t token rest b
            |: Error ("unexpected builder argument " ++ inspect token)
        ?= step ?|
        | Ok (next, left) => parse_tokens t left next
        | Error e => Error e

:= unknown_backend (name : string) : result command string =
    Error ("unknown Spiral backend " ++ inspect name ++ ", expected " ++ expected ())

:= chosen_command (t : tool) (args : list string) (raw : string) : result command string =
    ?= parse_tokens t args (blank t raw) ?|
    | Ok b => Ok (Builder b)
    | Error e => Error e

:= named_command (name : string) (args : list string) (raw : string) : result command string =
    ?= tool_of (text::lowercase name) ?|
    | Some t => chosen_command t args raw
    | None => unknown_backend name

:= retired_skip () : result command string =
    Error (
        "///> _ is retired: Cells infers the cells that never run. A file with any test cell never runs its main; "
        ^^ "a main that only registers exports, or that dispatches on the backend (backend_switch, ? is_rust ()), "
        ^^ "never runs. Delete the line."
    )

:= command_of (tokens : list string) (raw : string) : result command string =
    ?= tokens ?|
    | [] => unknown_backend ""
    | name :: args =>
        ? name <> "_" ?> named_command name args raw |: retired_skip ()

:= parse_command (rest : string) : result command string =
    ? rest = "_"
    ?> retired_skip ()
    |:
        ?= tokens_from rest "" None [] ?|
        | Ok tokens => command_of tokens rest
        | Error e => Error e

:= command_text (line : string) : option string =
    := lead = builder_output::content_start line 0i32
    := trimmed = text::drop line lead
    ? text::starts_with trimmed "////" ?> None
    |? text::starts_with trimmed "///>" ?> Some (builder_output::utrim (text::drop trimmed 4i32))
    |: None

:~ ^ split_lines
    (lines : list string) (body : list string) (commands : list command)
    : result (list command * string) string
    =
    ?= lines ?|
    | [] => Ok (listm::rev commands, sm'::concat_list "\n" (listm::rev body))
    | line :: rest =>
        ?= command_text line ?|
        | None => split_lines rest (line :: body) commands
        | Some text_in =>
            ?= parse_command text_in ?|
            | Ok c => split_lines rest body (c :: commands)
            | Error e => Error e

:= split (code : string) : result (list command * string) string =
    split_lines (sm'::split_list "\n" (text::replace code "\r\n" "\n")) [] []

:= field_text (s : string) : string = text::show_i32 (text::length s) ++ ":" ++ s

:= option_text (v : option string) : string =
    ?= v ?|
    | Some x => field_text ("+" ++ x)
    | None => field_text "-"

:= cleanup_text (v : option bool) : string =
    ?= v ?|
    | Some on => field_text (? on ?> "t" |: "f")
    | None => field_text "-"

:= version_text (v : dep_version) : string =
    ?= v ?|
    | NoVersion => field_text "-"
    | AnyVersion => field_text "+*"
    | Version x => field_text ("+" ++ x)

:= dep_text (d : dep) : string = field_text d::name ++ version_text d::version ++ field_text d::raw

:= builder_text (b : builder) : string =
    := v = b::values
    := head = field_text (tool_name b::tool) ++ field_text b::raw ++ option_text v::contract ++ option_text v::wasm
    := tail =
        cleanup_text b::cleanup
        ++ option_text v::target
        ++ option_text v::env
        ++ field_text (text::show_i32 (listm::length b::deps))
    head ++ tail ++ sm'::concat_list "" (listm::map dep_text b::deps)

:= command_wire (c : command) : string =
    ?= c ?|
    | Builder b => builder_text b


:= split_ok_wire (commands : list command) (body : string) : string =
    "K"
    ++ field_text body
    ++ field_text (text::show_i32 (listm::length commands))
    ++ sm'::concat_list "" (listm::map command_wire commands)

:= split_wire (code : string) : string =
    ?= split code ?|
    | Ok (commands, body) => split_ok_wire commands body
    | Error e => "E" ++ e

///> gleam
:# builder_lines_parse_into_typed_builders =
    := f = field_text
    := head =
        "K"
        ++ f "fn main\n////> kept"
        ++ f "1"
        ++ f "rust"
        ++ f "rust -c --deps serde=\"1.0\" rand"
        ++ f "+"
        ++ f "-"
        ++ f "-"
        ++ f "-"
        ++ f "-"
    := deps = f "2" ++ f "serde" ++ f "+1.0" ++ f "serde=1.0" ++ f "rand" ++ f "+*" ++ f "rand"
    split_wire "///> rust -c --deps serde=\"1.0\" rand\nfn main\n////> kept" |> _assert_eq (head ++ deps)
    split_wire "///> haskell" |> _assert_eq ("Eunknown Spiral backend \"haskell\", expected " ++ expected ())
    split_wire "///> rust -dc x" |> _assert_eq "Ebuilder flag -d must be the last flag in -dc"
    split_wire "///> gleam -l" |> _assert_eq "Eunknown builder flag \"-l\""
    inspect ("a\tb#{" ++ unicode::char_of 160i32) |> _assert_eq "\"a\\tb\\#{\\u00A0\""
