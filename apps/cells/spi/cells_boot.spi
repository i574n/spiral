///- --package .
:< erlang_term
:# cells_boot static =
    :< testing

:~ b (s : string) : term = erlang_term::of s

:~ apc (m : string) (f : string) (args : list term) : term = apply ("Elixir.Spiral.Cells." ^^ m) f args

:~ is_tuple (t : term) : bool = apply "erlang" "is_tuple" [ t ] |> erlang_term::cast

:~ env_is (name : string) (val : string) : bool =
    erlang_term::equal (apply "os" "getenv" [ erlang_term::charlist name; erlang_term::charlist "" ]) (erlang_term::charlist val)

:~ has_flag (flag : string) (argv : term) : bool = apply "lists" "member" [ b flag; argv ] |> erlang_term::cast

:~ not_gate (t : term) : bool = not (erlang_term::equal t (b "--gate"))

:~ reject_gate (argv : term) : term = list_term (listm'::filter not_gate (erlang_term::items_of argv))

:~ append2 (base : term) (x : string) (y : string) : term = apply "lists" "append" [ base; list_term [ b x; b y ] ]

:~ has_output (argv : term) : bool = has_flag "--output-dir" argv || has_flag "--output-path" argv

:~ gate_args (argv : term) (dir : string) : term =
    := base = append2 (reject_gate argv) "--no-memo" "--no-html"
    ? has_output base ?> base |: append2 base "--output-dir" dir

:~ pin_args_when (process : bool) : term =
    ? process ?> list_term []
    |:
        := pin = apc "CompilerDaemon" "gate_pin" [ tool_lookup::tool "compiler_dll" (list_term []) ]
        ? is_binary pin ?> list_term [ b "--compiler-pin"; pin ] |: list_term []

:~ pin_args () : term = pin_args_when (env_is "SPIRAL_CELLS_COMPILER" "process")

:~ strings_of (t : term) : list string = listm::map erlang_term::cast (erlang_term::items_of t)

:~ gate_strings (argv : list string) : list string = strings_of (gate_args (list_term (listm::map b argv)) "scratch")

///> gleam
:# a_gate_turns_memo_and_html_off_and_reports_to_a_scratch_dir_unless_the_caller_chose_one =
    gate_strings [ "--gate"; "--path"; "a.spi" ]
    |> _assert_eq [ "--path"; "a.spi"; "--no-memo"; "--no-html"; "--output-dir"; "scratch" ]
    gate_strings [ "--gate"; "--path"; "a.spi"; "--output-dir"; "mine" ]
    |> _assert_eq [ "--path"; "a.spi"; "--output-dir"; "mine"; "--no-memo"; "--no-html" ]
    gate_strings [ "--path"; "a.spi"; "--output-path"; "a.ipynb"; "--gate" ]
    |> _assert_eq [ "--path"; "a.spi"; "--output-path"; "a.ipynb"; "--no-memo"; "--no-html" ]

///> gleam
:# a_process_mode_gate_passes_no_pin_since_it_compiles_with_its_own_process =
    strings_of (pin_args_when !+) |> _assert_eq []

:~ uniq () : string =
    erlang_term::cast (apply "erlang" "integer_to_binary" [ apply "erlang" "unique_integer" [ list_term [ erlang_term::atom "positive" ] ] ]) : string

:~ unique_dir () : string =
    := tmp = erlang_term::cast (apply "Elixir.System" "tmp_dir!" []) : string
    tmp ^^ "/spiral-cells-gate-" ^^ uniq ()

:~ expand (argv : term) (gate : bool) (dir : string) : term =
    ? gate ?> apply "lists" "append" [ gate_args argv dir; pin_args () ] |: argv

:~ run (argv : term) : term =
    := served = apc "Server" "try_execute" [ argv ]
    ? is_tuple served && is_atom "served" (element_at 1i32 served) ?> element_at 2i32 served
    |: apc "NotebookCli" "execute" [ argv ]

:~ put_line (line : term) : () = apply "io" "put_chars" [ list_term [ line; b "\n" ] ] |> ignore

:~ print_lines (lines : term) : () = listm::iter put_line (erlang_term::items_of lines)

:~ warm () : bool = not (env_is "SPIRAL_CELLS_WARM" "0") && not (env_is "SPIRAL_CELLS_COMPILER" "process")

:~ in_job () : bool = not (env_is "KIT_JOB_ID" "") || not (env_is "RIG_JOB_ID" "")

:~ cold () : bool = env_is "SPIRAL_CELLS_WARM" "0" && not (env_is "SPIRAL_CELLS_COMPILER" "process")

:~ retire () : () = apc "CompilerClient" "shutdown" [] |> ignore

:~ cleanup (gate : bool) (dir : string) : () =
    ? gate
    ?>
        := _r = apply "file" "del_dir_r" [ b dir ]
        retire ()
    |? in_job () || cold () ?> retire ()
    |? warm () ?> (apc "CompilerClient" "prestart" [] |> ignore)
    |: ()

:~ said (status : term) (code : i32) : i32 =
    put_line (element_at 2i32 status)
    code

:~ exit_code (status : term) : i32 =
    ? is_atom "ok" status ?> 0i32
    |? is_tuple status && is_atom "void" (element_at 1i32 status) ?> said status 3i32
    |: said status 1i32

:~ guards () : () =
    := _g = apc "Domain" "guard_start" []
    := _t = apc "Domain" "temp_sweep" []
    apc "Domain" "ensure!" [] |> ignore

:~ env_text (name : string) : string =
    erlang_term::charlist_text (apply "os" "getenv" [ erlang_term::charlist name; erlang_term::charlist "" ])

:~ texts_of (lines : term) : list string = listm::map erlang_term::binary_text (erlang_term::items_of lines)

:~ blocked_now (gate : bool) (lines : term) (code : i32) : list string =
    := optional = env_text "SPIRAL_CELLS_OPTIONAL_TARGETS"
    ? gate && code = 0i32 ?> run_result::gate_blocked optional (texts_of lines) |: []

:~ unsupported_hint () : string =
    "cells gate: an unsupported target fails the gate; list the targets this host lacks in SPIRAL_CELLS_OPTIONAL_TARGETS"

:~ refused (blocked : list string) : i32 =
    listm::iter (\ l => put_line (b l)) blocked
    put_line (b (unsupported_hint ()))
    1i32

:~ gated (gate : bool) (lines : term) (code : i32) : i32 =
    := blocked = blocked_now gate lines code
    ? blocked = [] ?> code |: refused blocked

:~ finish (gate : bool) (dir : string) (result : term) : i32 =
    := _p = print_lines (element_at 2i32 result)
    := _c = cleanup gate dir
    gated gate (element_at 2i32 result) (exit_code (element_at 1i32 result))

:~ main (argv : term) : i32 =
    := _x = guards ()
    := gate = has_flag "--gate" argv
    := dir = ? gate ?> unique_dir () |: ""
    finish gate dir (run (expand argv gate dir))
