///- --package .
:# daemon static =
    :< testing

:= (++) (left : string) (right : string) : string = left ^^ right

:~ ^ fields_from (line : string) (at : i32) (acc : list string) : list string =
    := tab = text::find_from line "\t" at
    ? tab < 0i32
    ?> listm::rev (text::drop line at :: acc)
    |: fields_from line (tab + 1i32) (text::slice_len line at (tab - at) :: acc)

:= fields (line : string) : list string = fields_from line 0i32 []

:= tabbed (xs : list string) : string = sm'::concat_list "\t" xs

:~ ^ digits_from (s : string) (i : i32) : bool =
    ? i >= text::length s
    ?> !+
    |? text::digit_val (text::index s i) < 0i32
    ?> !-
    |: digits_from s (i + 1i32)

:= queue_ms (s : string) : option i32 = ? s <> "" && digits_from s 0i32 ?> Some (text::parse_i32 s) |: None

:| compile_wait =
    | Unbounded
    | WithinMs : i32

:== compile_ask = { backend : string; spi : string; rs : string; wait : compile_wait; mtime : string; client : string }

:| compile_reply =
    | Compiled : string * option i32
    | CompileTimedOut : option i32
    | CompileFailed : option i32 * string

:| retiring =
    | NotRetiring
    | RetiringSince : string

:== status_reply = { pid : string; stamp : string; idle : string; queue : string; retiring : retiring; owner : string }

:== hello_reply = { pid : string; stamp : string }

:== pool_reply = { served : i32; refused : i32; peak : i32; free_mb : option i32 }

:| request r =
    | Hello :: request hello_reply
    | Status :: request status_reply
    | Pool :: request pool_reply
    | Retire :: request ()
    | Compile :: compile_ask -> request compile_reply

:= wait_text (w : compile_wait) : string = ?= w ?| Unbounded => "-1" | WithinMs ms => text::show_i32 ms

:= wait_of (s : string) : compile_wait = ? s = "-1" ?> Unbounded |: WithinMs (text::parse_i32 s)

:= ask_fields (a : compile_ask) : list string = [ a::backend; a::spi; a::rs; wait_text a::wait; a::mtime; a::client ]

:= request_line \* r. (q : request r) : string =
    ?= q ?|
    | Compile a => tabbed (sm'::to_lower (reflection::case_name q) :: ask_fields a)
    | _ => sm'::to_lower (reflection::case_name q)

:= retiring_text (r : retiring) : string = ?= r ?| NotRetiring => "false" | RetiringSince ms => ms

:= retiring_of (s : string) : retiring = ? s = "false" ?> NotRetiring |: RetiringSince s

:= with_queue (head : list string) (queue : option i32) : list string =
    ?= queue ?| Some ms => listm::append head [ text::show_i32 ms ] | None => head

:= compile_text (c : compile_reply) : string =
    ?= c ?|
    | Compiled (revision, queue) => tabbed (with_queue [ "ok"; revision ] queue)
    | CompileTimedOut queue => tabbed (with_queue [ "error"; "timeout" ] queue)
    | CompileFailed (queue, message) => tabbed (listm::append (with_queue [ "error" ] queue) [ message ])

:= status_text (s : status_reply) : string =
    tabbed [ "status"; s::pid; s::stamp; s::idle; s::queue; retiring_text s::retiring; s::owner ]

:= free_text (free : option i32) : string = ?= free ?| Some mb => text::show_i32 mb | None => "-"

:= pool_text (p : pool_reply) : string =
    tabbed [ "pool"; text::show_i32 p::served; text::show_i32 p::refused; text::show_i32 p::peak; free_text p::free_mb ]

:= reply_line \* r. (q : request r) (reply : r) : string =
    ?= q ?|
    | Hello => tabbed [ "spiral-cells"; "1"; reply::pid; reply::stamp ]
    | Status => status_text reply
    | Pool => pool_text reply
    | Retire => "retiring"
    | Compile _ => compile_text reply

:= failed_of (rest : list string) : compile_reply =
    ?= rest ?|
    | queue :: message :: more ?& queue_ms queue <> None => CompileFailed (queue_ms queue, tabbed (message :: more))
    | _ => CompileFailed (None, tabbed rest)

:= unexpected (line : string) : compile_reply = CompileFailed (None, "unexpected compiler reply: " ++ line)

:= compile_of (line : string) : compile_reply =
    ?= fields line ?|
    | "ok" :: revision :: [] => Compiled (revision, None)
    | "ok" :: revision :: queue :: [] => Compiled (revision, queue_ms queue)
    | "error" :: "timeout" :: [] => CompileTimedOut None
    | "error" :: "timeout" :: queue :: [] => CompileTimedOut (queue_ms queue)
    | "error" :: "timeout" :: _ :: _ :: _ => CompileTimedOut None
    | "error" :: [] => unexpected line
    | "error" :: rest => failed_of rest
    | _ => unexpected line

:= status_of (line : string) : status_reply =
    ?= fields line ?|
    | "status" :: pid :: stamp :: idle :: queue :: retiring :: owner =>
        { pid; stamp; idle; queue; retiring = retiring_of retiring; owner = sm'::concat_list " " owner }
    | _ => { pid = ""; stamp = ""; idle = ""; queue = ""; retiring = NotRetiring; owner = "" }

:= compile_row (line : string) : string =
    ?= compile_of line ?|
    | Compiled (revision, queue) => tabbed [ "ok"; free_text queue; revision ]
    | CompileTimedOut queue => tabbed [ "timeout"; free_text queue; "" ]
    | CompileFailed (queue, message) => tabbed [ "failed"; free_text queue; message ]

:= status_row (line : string) : string =
    := s = status_of line
    tabbed [ s::pid; s::stamp; s::idle; s::queue; retiring_text s::retiring; s::owner ]

:= hello_of (line : string) : hello_reply =
    ?= fields line ?|
    | "spiral-cells" :: "1" :: pid :: stamp :: _ => { pid; stamp }
    | _ => { pid = ""; stamp = "" }

:= count_of (s : string) : i32 = ?= queue_ms s ?| Some n => n | None => 0i32

:= no_pool () : pool_reply = { served = 0i32; refused = 0i32; peak = 1i32; free_mb = None }

:= pool_of (line : string) : pool_reply =
    ?= fields line ?|
    | "pool" :: served :: refused :: peak :: free :: [] =>
        { served = count_of served; refused = count_of refused; peak = count_of peak; free_mb = queue_ms free }
    | _ => no_pool ()

:= counted (s : string) : bool = queue_ms s <> None

:= pool_row (line : string) : string =
    ?= fields line ?|
    | "pool" :: served :: refused :: peak :: _ :: [] ?& counted served && counted refused && counted peak =>
        := p = pool_of line
        tabbed [ text::show_i32 p::served; text::show_i32 p::refused; text::show_i32 p::peak; free_text p::free_mb ]
    | _ => ""

:= hello_row (line : string) : string =
    ?= fields line ?|
    | "spiral-cells" :: "1" :: pid :: stamp :: tag :: _ ?& counted pid && counted stamp => tabbed [ "banner"; pid; stamp; tag ]
    | "spiral-cells" :: "1" :: pid :: stamp :: [] ?& counted pid && counted stamp => tabbed [ "legacy"; pid; stamp; "" ]
    | "spiral-cells" :: "1" :: _ :: _ => tabbed [ "unreadable"; ""; ""; "" ]
    | _ => tabbed [ "other"; ""; ""; "" ]

:= reply_of \* r. (q : request r) (line : string) : r =
    ?= q ?|
    | Hello => hello_of line
    | Status => status_of line
    | Pool => pool_of line
    | Retire => ()
    | Compile _ => compile_of line

:= sample_ask () : compile_ask =
    { backend = "rust"; spi = "a.spi"; rs = "a.rs"; wait = WithinMs 900000i32; mtime = "17"; client = "42" }

///> gleam
:# a_compile_request_is_one_tab_separated_line =
    request_line (Compile (sample_ask ())) |> _assert_eq "compile\trust\ta.spi\ta.rs\t900000\t17\t42"

///> gleam
:# compile_replies_round_trip_through_their_line =
    := q = Compile (sample_ask ())
    := done = [ Compiled ("r1", None); Compiled ("r1", Some 7i32) ]
    := late = [ CompileTimedOut None; CompileTimedOut (Some 3i32) ]
    := more = [ CompileFailed (None, "boom"); CompileFailed (Some 5i32, "no main") ]
    := all = listm::append done (listm::append late more)
    listm::map (\ c => reply_of q (reply_line q c) = c) all |> _assert_eq [ !+; !+; !+; !+; !+; !+ ]

///> gleam
:# compile_lines_read_like_the_elixir_client_did =
    := lines =
        [ "ok\tr1\t7\textra"; "error\ttimeout\t3\tx"; "error"; "error\t5\tno\tmain"; "error\tbare text"; "error\t" ]
    := odd = [ unexpected "ok\tr1\t7\textra"; CompileTimedOut None; unexpected "error" ]
    := failed = [ CompileFailed (Some 5i32, "no\tmain"); CompileFailed (None, "bare text"); CompileFailed (None, "") ]
    listm::map compile_of lines |> _assert_eq (listm::append odd failed)

///> gleam
:# a_status_line_keeps_an_owner_with_spaces =
    := s = { pid = "9"; stamp = "1"; idle = "0"; queue = "2"; retiring = RetiringSince "123"; owner = "x lane" }
    reply_of Status (reply_line Status s) |> _assert_eq s

///> gleam
:# a_status_row_drops_the_tag_and_joins_owner_fields =
    := lines = [ "status\t9\t1\t0\t2\t123\tx\tlane"; "status\t9\t1\t0\t2\tfalse"; "ok\tr1" ]
    listm::map status_row lines |> _assert_eq [ "9\t1\t0\t2\t123\tx lane"; "9\t1\t0\t2\tfalse\t"; "\t\t\t\tfalse\t" ]

///> gleam
:# a_compile_row_tags_the_outcome_and_keeps_the_queue =
    := lines = [ "ok\tr1\t7"; "error\ttimeout"; "error\t5\tno\tmain"; "huh" ]
    := rows = [ "ok\t7\tr1"; "timeout\t-\t"; "failed\t5\tno\tmain"; "failed\t-\tunexpected compiler reply: huh" ]
    listm::map compile_row lines |> _assert_eq rows

///> gleam
:# a_pool_line_round_trips_and_a_dash_is_no_reading =
    := busy = { served = 12i32; refused = 1i32; peak = 3i32; free_mb = Some 2048i32 }
    (reply_of Pool (reply_line Pool busy), reply_of Pool "pool\t0\t0\t1\t-") |> _assert_eq (busy, no_pool ())

///> gleam
:# a_pool_row_is_empty_unless_every_count_reads =
    := lines = [ "pool\t12\t1\t3\t2048"; "pool\t0\t0\t1\t-"; "pool\t1\tx\t3\t5"; "pool\t1\t2\t3"; "status\t1" ]
    listm::map pool_row lines |> _assert_eq [ "12\t1\t3\t2048"; "0\t0\t1\t-"; ""; ""; "" ]

///> gleam
:# a_hello_row_names_the_banner_kind =
    := lines = [ "spiral-cells\t1\t77\t5\tbun"; "spiral-cells\t1\t77\t5"; "spiral-cells\t1\t77\tx"; "spiral-cells\t1"; "ok" ]
    := rows = [ "banner\t77\t5\tbun"; "legacy\t77\t5\t"; "unreadable\t\t\t"; "other\t\t\t"; "other\t\t\t" ]
    listm::map hello_row lines |> _assert_eq rows

///> gleam
:# hello_reads_the_banner_pid_and_stamp =
    reply_of Hello "spiral-cells\t1\t77\t5\textra" |> _assert_eq { pid = "77"; stamp = "5" }
