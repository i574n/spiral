:= (++) (left : string) (right : string) : string = !!!!StaticStringConcat(left, right)

:| ^ tokens =
    | NoToken
    | Token : string * tokens

:~ ^ rev_tokens (xs : tokens) (acc : tokens) : tokens =
    ?= xs ?|
    | NoToken => acc
    | Token (s, rest) => rev_tokens rest (Token (s, acc))

:~ ^ take_token (src : string) (i : i32) : i32 =
    ? i >= text.length src ?> i
    |:
        := ch = text.index src i
        ? ch = ' ' ?> i
        |? ch = '\t' ?> i
        |: take_token src (i + 1i32)

:~ ^ skip_ws (src : string) (i : i32) : i32 =
    ? i >= text.length src ?> i
    |:
        := ch = text.index src i
        ? ch = ' ' ?> skip_ws src (i + 1i32)
        |? ch = '\t' ?> skip_ws src (i + 1i32)
        |: i

:~ ^ tokens_from (src : string) (i : i32) (acc : tokens) : tokens =
    := j = skip_ws src i
    ? j >= text.length src ?> rev_tokens acc NoToken
    |:
        := k = take_token src j
        tokens_from src k (Token (text.slice_len src j (k - j), acc))

:| parsed =
    | Parsed : i32 * i32 * string
    | ParseBad : string

:~ ^ pair (xs : tokens) (print_code : i32) (timeout : i32) (packages : string) : parsed =
    ?= xs ?|
    | NoToken => Parsed (print_code, timeout, packages)
    | Token ("--print-code", rest) => pair rest 1i32 timeout packages
    | Token ("--timeout", Token (ms, rest)) =>
        := n = text.parse_i32 ms
        ? n > 0i32 ?> pair rest print_code n packages
        |: ParseBad (text.err "timeout" ms)
    | Token ("--package", Token (path, rest)) =>
        := packages2 = ? packages = "" ?> path |: packages ++ "\t" ++ path
        pair rest print_code timeout packages2
    | Token ("--test", Token ("static", rest)) => pair rest print_code timeout packages
    | Token ("--test", rest) => pair rest print_code timeout packages
    | Token ("--symbol", rest) => pair rest print_code timeout packages
    | Token ("--import-types", Token (_, rest)) => pair rest print_code timeout packages
    | Token ("--name", Token (_, rest)) => pair rest print_code timeout packages
    | Token (flag, _) => ParseBad (text.err "flag" flag)

:= merge (args : string) (print_code : i32) (timeout : i32) (packages : string) : parsed =
    pair (tokens_from args 0i32 NoToken) print_code timeout packages

:= accept_backend (rest : string) : string =
    := trimmed = text.trim rest
    ? trimmed = "_" ?> "skip"
    |? trimmed = "rust" ?> ""
    |? text.starts_with trimmed "rust " ?> ""
    |: text.err "backend" trimmed

:= finish (kept : string) (print_code : i32) (timeout : i32) (packages : string) (skip : i32) : string =
    ? text.contains kept "\n#!"
    ?> text.err "dib" ""
    |? text.starts_with kept "#!"
    ?> text.err "dib" ""
    |:
        := wrapped, generated = cell.wrap kept
        := timeout_text = ? timeout < 0i32 ?> "-" |: text.show_i32 timeout
        "ok\n"
        ++ text.show_i32 print_code
        ++ "\n"
        ++ timeout_text
        ++ "\n"
        ++ text.show_i32 generated
        ++ "\n"
        ++ packages
        ++ "\n"
        ++ text.show_i32 skip
        ++ "\n"
        ++ wrapped

:~ ^ scan
    (src : string) (i : i32) (kept : string) (print_code : i32) (timeout : i32) (packages : string) (seen : i32)
    (started : i32) (skip : i32)
    : string
    =
    ?= text.next_line src i ?|
    | LineDone => finish kept print_code timeout packages skip
    | LineGot (line, next) =>
        ? text.starts_with line "////" ?> scan src next kept print_code timeout packages seen started skip
        |? text.starts_with line "///- " ?>
            ? seen = 1i32 ?> scan src next kept print_code timeout packages 1i32 started skip
            |:
                ?= merge (text.drop line (text.length "///- ")) print_code timeout packages ?|
                | ParseBad message => message
                | Parsed (print2, timeout2, packages2) => scan src next kept print2 timeout2 packages2 1i32 started skip
        |? text.starts_with line "///> " ?>
            := backend = accept_backend (text.drop line (text.length "///> "))
            ? text.is_error backend ?> backend
            |? backend = "skip" ?> scan src next kept print_code timeout packages seen started 1i32
            |: scan src next kept print_code timeout packages seen started skip
        |? text.starts_with line "///" ?> text.err "directive" line
        |:
            := kept2 = ? started = 0i32 ?> line |: kept ++ "\n" ++ line
            scan src next kept2 print_code timeout packages seen 1i32 skip

:= prepare (code : string) : string =
    scan (text.replace code "\r\n" "\n") 0i32 "" 0i32 -1i32 "" 0i32 0i32 0i32
