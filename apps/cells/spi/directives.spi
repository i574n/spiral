:= (++) (left : string) (right : string) : string = left ^^ right

:~ ^ take_token (src : string) (i : i32) : i32 =
    ? i >= text::length src ?> i
    |:
        := ch = text::index src i
        ? ch = ' ' ?> i
        |? ch = '\t' ?> i
        |: take_token src (i + 1i32)

:~ ^ skip_ws (src : string) (i : i32) : i32 =
    ? i >= text::length src ?> i
    |:
        := ch = text::index src i
        ? ch = ' ' ?> skip_ws src (i + 1i32)
        |? ch = '\t' ?> skip_ws src (i + 1i32)
        |: i

:~ ^ tokens_from (src : string) (i : i32) (acc : list string) : list string =
    := j = skip_ws src i
    ? j >= text::length src ?> listm::rev acc
    |:
        := k = take_token src j
        tokens_from src k (text::slice_len src j (k - j) :: acc)

:| directive_error =
    | ShebangLine
    | UnknownDirective : string
    | UnknownFlag : string
    | BadTimeout : string
    | UnknownBackend : string

:| outcome t =
    | Ready : t
    | Refused : directive_error

:| timeout =
    | NoTimeout
    | TimeoutMs : i32

:| backend_line =
    | RustCell

:== flags = { print_code : bool; timeout : timeout; packages : list string }

:== prepared = { code : string; flags : flags; main : cell::main_source }

:== scan_state = { kept : string; flags : flags; seen : bool; started : bool }

:= no_flags () : flags = { print_code = !-; timeout = NoTimeout; packages = [] }

:= positive_timeout (ms : string) : outcome timeout =
    := n = text::parse_i32 ms
    ? n > 0i32 ?> Ready (TimeoutMs n) |: Refused (BadTimeout ms)

:~ ^ merged (xs : list string) (f : flags) : outcome flags =
    ?= xs ?|
    | [] => Ready f
    | "--print-code" :: rest => merged rest { f ?| print_code = !+ }
    | "--timeout" :: ms :: rest =>
        ?= positive_timeout ms ?|
        | Ready t => merged rest { f ?| timeout = t }
        | Refused e => Refused e
    | "--package" :: path :: rest => merged rest { f ?| packages = path :: f::packages }
    | "--test" :: "static" :: rest => merged rest f
    | "--test" :: rest => merged rest f
    | "--symbol" :: rest => merged rest f
    | "--name" :: _ :: rest => merged rest f
    | flag :: _ => Refused (UnknownFlag flag)

:= backend_of (rest : string) : outcome backend_line =
    := trimmed = text::trim rest
    ? trimmed = "rust" || text::starts_with trimmed "rust " ?> Ready RustCell
    |: Refused (UnknownBackend trimmed)

:= finished (s : scan_state) : outcome prepared =
    ? text::contains s::kept "\n#!" || text::starts_with s::kept "#!" ?> Refused ShebangLine
    |:
        := wrapped, generated = cell::wrap s::kept
        Ready { code = wrapped; flags = s::flags; main = generated }

:= kept_line (s : scan_state) (line : string) : scan_state =
    { s ?| kept = (? s::started ?> s::kept ++ "\n" ++ line |: line); started = !+ }

:= flags_line (s : scan_state) (line : string) : outcome flags =
    merged (tokens_from (text::drop line (text::length "///- ")) 0i32 []) s::flags

:~ ^ scanned (src : string) (i : i32) (s : scan_state) : outcome prepared =
    ?= text::next_line src i ?|
    | LineDone => finished s
    | LineGot (line, next) =>
        ? text::starts_with line "////" ?> scanned src next s
        |? text::starts_with line "///- " ?>
            ? s::seen ?> scanned src next s
            |:
                ?= flags_line s line ?|
                | Ready f => scanned src next { s ?| flags = f; seen = !+ }
                | Refused e => Refused e
        |? text::starts_with line "///> " ?>
            ?= backend_of (text::drop line (text::length "///> ")) ?|
            | Ready _ => scanned src next s
            | Refused e => Refused e
        |? text::starts_with line "///" ?> Refused (UnknownDirective line)
        |: scanned src next (kept_line s line)

:= flag_text (b : bool) : string = ? b ?> "1" |: "0"

:= timeout_text (t : timeout) : string = ?= t ?| NoTimeout => "-" | TimeoutMs n => text::show_i32 n

:= error_text (e : directive_error) : string =
    ?= e ?|
    | ShebangLine => text::err "dib" ""
    | UnknownDirective line => text::err "directive" line
    | UnknownFlag flag => text::err "flag" flag
    | BadTimeout ms => text::err "timeout" ms
    | UnknownBackend backend => text::err "backend" backend

:= prepared_text (p : prepared) : string =
    := f = p::flags
    := head = "ok\n" ++ flag_text f::print_code ++ "\n" ++ timeout_text f::timeout ++ "\n" ++ cell::main_text p::main
    head ++ "\n" ++ sm'::concat_list "\t" (listm::rev f::packages) ++ "\n" ++ p::code

:= encoded (o : outcome prepared) : string = ?= o ?| Ready p => prepared_text p | Refused e => error_text e

:= initial () : scan_state = { kept = ""; flags = no_flags (); seen = !-; started = !- }

:= prepare (code : string) : string = encoded (scanned (text::replace code "\r\n" "\n") 0i32 (initial ()))
