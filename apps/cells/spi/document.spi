:= (++) (left : string) (right : string) : string = !!!!StaticStringConcat(left, right)

:| ^ rows =
    | NoRow
    | Row : string * rows

:| ^ cells =
    | NoCell
    | Cell : string * string * cells

:| mark =
    | NoMark
    | Mark : string * string

:| ^ tokens =
    | NoWord
    | Word : string * tokens

:~ ^ rev_rows (xs : rows) (acc : rows) : rows =
    ?= xs ?|
    | NoRow => acc
    | Row (s, rest) => rev_rows rest (Row (s, acc))

:~ ^ snoc (xs : rows) (item : string) : rows =
    ?= xs ?|
    | NoRow => Row (item, NoRow)
    | Row (s, rest) => Row (s, snoc rest item)

:~ ^ has_row (xs : rows) (item : string) : bool =
    ?= xs ?|
    | NoRow => !-
    | Row (s, rest) => ? s = item ?> !+ |: has_row rest item

:= add_row (xs : rows) (item : string) : rows =
    ? has_row xs item ?> xs |: snoc xs item

:~ ^ join_rows (xs : rows) : string =
    ?= xs ?|
    | NoRow => ""
    | Row (s, NoRow) => s
    | Row (s, rest) => s ++ "\n" ++ join_rows rest

:~ ^ join_rev (xs : rows) (acc : string) (started : i32) : string =
    ?= xs ?|
    | NoRow => acc
    | Row (s, rest) =>
        ? started = 0i32 ?> join_rev rest s 1i32
        |: join_rev rest (s ++ "\n" ++ acc) 1i32

:~ ^ count_cells (xs : cells) : i32 =
    ?= xs ?|
    | NoCell => 0i32
    | Cell (_, _, rest) => 1i32 + count_cells rest

:~ ^ rev_cells (xs : cells) (acc : cells) : cells =
    ?= xs ?|
    | NoCell => acc
    | Cell (k, s, rest) => rev_cells rest (Cell (k, s, acc))

:~ ^ emit_cells (xs : cells) : string =
    ?= xs ?|
    | NoCell => ""
    | Cell (k, s, rest) =>
        k ++ "\n" ++ text.show_i32 (text.length s) ++ "\n" ++ s ++ emit_cells rest

:= wire (xs : cells) : string =
    := ordered = rev_cells xs NoCell
    text.show_i32 (count_cells ordered) ++ "\n" ++ emit_cells ordered

:~ ^ letter_end (line : string) (i : i32) : i32 =
    ? i >= text.length line ?> i
    |? text.is_letter (text.index line i) ?> letter_end line (i + 1i32)
    |: i

:= marker (line : string) : mark =
    ? text.starts_with line "#!" ?>
        := n = letter_end line 2i32
        ? n = 2i32 ?> NoMark
        |: Mark (text.slice_len line 2i32 (n - 2i32), text.drop line n)
    |: NoMark

:= add_line (buffer : string) (line : string) : string =
    ? buffer = "" ?> line |: buffer ++ "\n" ++ line

:= push (xs : cells) (kind : string) (buffer : string) : cells =
    ? kind = "" ?> xs
    |:
        := source = text.trim buffer
        ? source = "" ?> xs |: Cell (kind, source, xs)

:~ ^ walk (src : string) (i : i32) (xs : cells) (kind : string) (buffer : string) : cells =
    ?= text.next_line src i ?|
    | LineDone => push xs kind buffer
    | LineGot (line, next) =>
        ?= marker line ?|
        | NoMark => walk src next xs kind (add_line buffer line)
        | Mark (name, rest) =>
            := xs2 = push xs kind buffer
            ? name = "import" ?> walk src next (Cell ("import", text.trim rest, xs2)) kind ""
            |? name = "meta" ?> walk src next xs2 "" ""
            |? name = "markdown" ?> walk src next xs2 name ""
            |? name = "spiral" ?> walk src next xs2 name ""
            |? name = "fsharp" ?> walk src next xs2 name ""
            |: walk src next xs2 ("code/" ++ name) ""

:= parse_dib (src : string) : string =
    wire (walk (text.replace src "\r\n" "\n") 0i32 NoCell "" "")


:= spir_cell (source : string) : bool = text.contains source "///- " && text.contains source " --real"

:~ ^ directive_line_has (source : string) (flag : string) (i : i32) : bool =
    ?= text.next_line source i ?|
    | LineDone => !-
    | LineGot (line, next) =>
        ? text.starts_with line "///- " && text.contains line flag ?> !+
        |: directive_line_has source flag next

:= test_cell (source : string) : bool =
    directive_line_has source " --test" 0i32 || directive_line_has source " --ignore" 0i32

:| export_kind =
    | SpiExport
    | SpirExport

:= export_cell (kind : export_kind) (cell_kind : string) (source : string) : bool =
    ?= kind ?|
    | SpiExport => cell_kind = "spiral" && spir_cell (text.trim source) = !-
    | SpirExport => cell_kind = "spiral" && spir_cell (text.trim source)

:~ ^ export_blocks (kind : export_kind) (xs : cells) (acc : cells) : cells =
    ?= xs ?|
    | NoCell => rev_cells acc NoCell
    | Cell (cell_kind, source, rest) =>
        ? cell_kind = "markdown" || export_cell kind cell_kind source
        ?> export_blocks kind rest (Cell (cell_kind, source, acc))
        |: export_blocks kind rest acc

:~ ^ keep_docs (xs : cells) : cells =
    ?= xs ?|
    | NoCell => NoCell
    | Cell (kind, source, rest) =>
        ?= rest ?|
        | NoCell => ? kind = "markdown" ?> NoCell |: Cell (kind, source, NoCell)
        | _ => Cell (kind, source, keep_docs rest)

:~ ^ lead_ws (line : string) (i : i32) : i32 =
    ? i >= text.length line ?> i
    |:
        := ch = text.index line i
        ? ch = ' ' ?> lead_ws line (i + 1i32)
        |? ch = '\t' ?> lead_ws line (i + 1i32)
        |: i

:= doc_line (line : string) : string =
    ? line = "" ?> "/// "
    |:
        := i = lead_ws line 0i32
        ? i >= text.length line ?> line
        |: text.take line i ++ "/// " ++ text.drop line i

:= test_heading (line : string) : bool =
    := n = text.length line
    := m = text.length " (test)"
    ? n >= m ?> text.starts_at line (n - m) " (test)" |: !-

:~ ^ md_go (src : string) (i : i32) (acc : rows) : rows =
    ?= text.next_line src i ?|
    | LineDone => rev_rows acc NoRow
    | LineGot (line, next) =>
        := t = text.take line (text.trim_end line (text.length line))
        ? test_heading t ?> md_go src next acc |: md_go src next (Row (doc_line t, acc))

:= format_cell (kind : string) (source : string) : string =
    := t = text.trim source
    ? kind = "markdown" ?> join_rows (md_go t 0i32 NoRow)
    |? kind = "test" ?> t
    |? test_cell t ?> ""
    |: t

:~ ^ formatted (xs : cells) (acc : cells) : cells =
    ?= xs ?|
    | NoCell => rev_cells acc NoCell
    | Cell (kind, source, rest) =>
        := s = format_cell kind source
        ? s = "" ?> formatted rest acc |: formatted rest (Cell (kind, s, acc))

:~ ^ emit_spi (xs : cells) : string =
    ?= xs ?|
    | NoCell => ""
    | Cell (kind, s, rest) =>
        ?= rest ?|
        | NoCell => s ++ "\n"
        | Cell (next, _, _) =>
            := brk = ? kind = "markdown" && next <> "markdown" ?> "" |: "\n"
            s ++ brk ++ "\n" ++ emit_spi rest

:~ ^ read_cells (src : string) (i : i32) (n : i32) (acc : cells) : cells =
    ? n <= 0i32 ?> rev_cells acc NoCell
    |:
        ?= text.next_line src i ?|
        | LineDone => rev_cells acc NoCell
        | LineGot (kind, j) =>
            ?= text.next_line src j ?|
            | LineDone => rev_cells acc NoCell
            | LineGot (len_text, k) =>
                := nlen = text.parse_i32 len_text
                read_cells src (k + nlen) (n - 1i32) (Cell (kind, text.slice_len src k nlen, acc))

:= load (src : string) : cells =
    ?= text.next_line src 0i32 ?|
    | LineDone => NoCell
    | LineGot (count, next) => read_cells src next (text.parse_i32 count) NoCell

:| test_policy =
    | DropTests
    | KeepTests

:= upper_set () : string = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"

:= lower_set () : string = "abcdefghijklmnopqrstuvwxyz"

:= test_name_set () : string = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_"

:= lower_one (src : string) (i : i32) : string =
    := k = text.find_char (upper_set ()) 0i32 (text.index src i)
    ? k >= 0i32 ?> text.one (lower_set ()) k |: text.one src i

:= in_range (cp : i32) (low : i32) (high : i32) : bool = cp >= low && cp <= high

:= latin_letter (cp : i32) : bool = in_range cp 192i32 591i32 && cp <> 215i32 && cp <> 247i32

:= greek_letter (cp : i32) : bool = in_range cp 902i32 1013i32 && cp <> 903i32

:= cyrillic_letter (cp : i32) : bool = in_range cp 1024i32 1153i32 || in_range cp 1162i32 1327i32

:= armenian_letter (cp : i32) : bool = in_range cp 1329i32 1366i32 || in_range cp 1377i32 1415i32

:= hebrew_arabic_letter (cp : i32) : bool = in_range cp 1488i32 1514i32 || in_range cp 1568i32 1610i32

:= hangul_letter (cp : i32) : bool =
    in_range cp 4352i32 4607i32 || in_range cp 12593i32 12686i32 || in_range cp 44032i32 55203i32

:= kana_han_letter (cp : i32) : bool =
    in_range cp 12353i32 12438i32 || in_range cp 12449i32 12538i32 || in_range cp 19968i32 40959i32

:= unicode_letter (cp : i32) : bool =
    latin_letter cp
    || greek_letter cp
    || cyrillic_letter cp
    || armenian_letter cp
    || hebrew_arabic_letter cp
    || hangul_letter cp
    || kana_han_letter cp

:= name_piece (pending : bool) (acc : string) (piece : string) : string =
    := sep = ? pending && acc <> "" ?> "_" |: ""
    acc ++ sep ++ piece

:~ ^ test_name_go (src : string) (i : i32) (pending : bool) (acc : string) : string =
    ? i >= text.length src
    ?> acc
    |? text.byte_at src i >= 128i32
    ?>
        := width = text.utf8_width (text.byte_at src i)
        ? unicode_letter (text.code_point src i)
        ?> test_name_go src (i + width) !- (name_piece pending acc (text.lowercase (text.slice_len src i width)))
        |: test_name_go src (i + width) !+ acc
    |? text.has_char (test_name_set ()) 0i32 (text.index src i)
    ?> test_name_go src (i + 1i32) !- (name_piece pending acc (lower_one src i))
    |: test_name_go src (i + 1i32) !+ acc

:~ ^ symbol_go (name : string) (i : i32) (acc : string) : string =
    ? i >= text.length name
    ?> acc
    |? text.byte_at name i < 128i32 && text.has_char (test_name_set ()) 0i32 (text.index name i)
    ?> symbol_go name (i + 1i32) (acc ++ text.one name i)
    |:
        := width = text.utf8_width (text.byte_at name i)
        symbol_go name (i + width) (acc ++ "u" ++ text.show_hex (text.code_point name i) ++ "_")

:= test_symbol (name : string) : string =
    := escaped = symbol_go name 0i32 ""
    ? escaped = name ?> name |: "test_" ++ escaped

:~ ^ underscore_start (src : string) (i : i32) : i32 =
    ? i < text.length src && text.index src i = '_' ?> underscore_start src (i + 1i32) |: i

:~ ^ underscore_end (src : string) (i : i32) : i32 =
    ? i > 0i32 && text.index src (i - 1i32) = '_' ?> underscore_end src (i - 1i32) |: i

:= strip_underscores (src : string) : string =
    := a = underscore_start src 0i32
    := b = underscore_end src (text.length src)
    ? b <= a ?> "" |: text.slice_len src a (b - a)

:~ ^ last_heading_line (src : string) (i : i32) (found : string) : string =
    ?= text.next_line src i ?|
    | LineDone => found
    | LineGot (line, next) =>
        ? text.starts_with (text.trim line) "#" ?> last_heading_line src next line
        |: last_heading_line src next found

:= heading_test_name (source : string) : string =
    := line = last_heading_line (text.trim source) 0i32 ""
    ? line = "" ?> "" |: strip_underscores (test_name_go (text.replace line " (test)" "") 0i32 !- "")

:~ ^ count_row (xs : rows) (item : string) : i32 =
    ?= xs ?|
    | NoRow => 0i32
    | Row (s, rest) => ? s = item ?> 1i32 + count_row rest item |: count_row rest item

:~ ^ append_rows (xs : rows) (ys : rows) : rows =
    ?= xs ?|
    | NoRow => ys
    | Row (s, rest) => Row (s, append_rows rest ys)

:~ ^ drop_blank_rows (xs : rows) : rows =
    ?= xs ?|
    | NoRow => NoRow
    | Row (s, rest) => ? text.blank s ?> drop_blank_rows rest |: xs

:= body_row (line : string) : string = ? text.blank line ?> "" |: "    " ++ line

:= test_mode (options : string) (word : string) (shown : string) : string =
    ? text.contains (" " ++ options ++ " ") (" " ++ word ++ " ") ?> " " ++ shown |: ""

:= cut_before (s : string) (marker : string) : string =
    := k = text.find_from s marker 0i32
    ? k >= 0i32 ?> text.take s k |: s

:= clause_after (s : string) (marker : string) (shown : string) : string =
    := k = text.find_from s marker 0i32
    ? k >= 0i32 ?> shown ++ text.trim (text.drop s (k + text.length marker)) |: ""

:= quoted_end (s : string) : i32 =
    ? text.starts_with s " \"" ?>
        := close = text.find_char s 2i32 '"'
        ? close >= 2i32 ?> close + 1i32 |: -1i32
    |: 0i32

:= reason_after (s : string) (marker : string) : string =
    := k = text.find_from (s ++ " ") (marker ++ " ") 0i32
    ? k < 0i32 ?> ""
    |:
        := rest = text.drop s (k + text.length marker)
        := n = quoted_end rest
        ? n > 0i32 ?> text.take rest n |: ""

:= word_after (s : string) (marker : string) : string =
    := k = text.find_from s marker 0i32
    ? k < 0i32 ?> ""
    |:
        := start = k + text.length marker
        text.slice_len s start (text.take_unicode_ident s start - start)

:= reference_mode (head : string) : string =
    := target = word_after (head ++ " ") " --reference "
    ? target = "" ?> "" |: " reference " ++ target

:= agree_mode (head : string) (word : string) (shown : string) : string =
    ? text.contains (" " ++ head ++ " ") (" " ++ word ++ " ") || text.contains (" " ++ head) (" " ++ word ++ " \"")
    ?> " " ++ shown ++ reason_after head word
    |: ""

:~ ^ test_block_go
    (src : string) (i : i32) (targets : rows) (options : string) (body : rows) (name : string)
    : string
    =
    ?= text.next_line src i ?|
    | LineDone =>
        := head = cut_before options " --fails "
        := header =
            "test "
            ++ name
            ++ test_mode head "static" "static"
            ++ test_mode head "--print-code" "print_code"
            ++ test_mode head "--ignore" "ignore"
            ++ agree_mode head "--no-agree" "no_agree"
            ++ reference_mode head
            ++ test_mode head "--build-only" "build_only"
            ++ clause_after options " --fails " " fails "
            ++ " ="
        := lines = rev_rows (drop_blank_rows body) NoRow
        join_rows (append_rows (rev_rows targets NoRow) (Row (header, lines)))
    | LineGot (line, next) =>
        ? text.starts_with line "///-"
        ?> test_block_go src next targets (options ++ " " ++ text.trim (text.drop line 4i32)) body name
        |? text.starts_with line "///>"
        ?> test_block_go src next (Row (line, targets)) options body name
        |:
            ?= body ?|
            | NoRow =>
                ? text.blank line
                ?> test_block_go src next targets options NoRow name
                |: test_block_go src next targets options (Row (body_row line, NoRow)) name
            | _ => test_block_go src next targets options (Row (body_row line, body)) name

:= test_block (source : string) (name : string) : string = test_block_go source 0i32 NoRow "" NoRow name

:~ ^ name_tests (xs : cells) (last : string) (used : rows) (acc : cells) : cells =
    ?= xs ?|
    | NoCell => rev_cells acc NoCell
    | Cell (kind, source, rest) =>
        ? kind = "markdown" ?>
            := heading = heading_test_name source
            := last2 = ? heading = "" ?> last |: heading
            name_tests rest last2 used (Cell (kind, source, acc))
        |? test_cell (text.trim source) ?>
            := base = ? last = "" ?> "cell" |: last
            := n = count_row used base
            := name = ? n = 0i32 ?> base |: base ++ "_" ++ text.show_i32 (n + 1i32)
            name_tests rest last (Row (base, used)) (Cell ("test", test_block (text.trim source) name, acc))
        |: name_tests rest last used (Cell (kind, source, acc))

:= first_line (source : string) : string =
    ?= text.next_line source 0i32 ?|
    | LineDone => ""
    | LineGot (line, _) => line

:~ ^ only_opens_from (source : string) (i : i32) (seen : bool) : bool =
    ?= text.next_line source i ?|
    | LineDone => seen
    | LineGot (line, next) =>
        := t = text.trim line
        ? t = "" || text.starts_with t "///" ?> only_opens_from source next seen
        |? text.starts_with t "open " || text.starts_with t ":< " ?> only_opens_from source next !+
        |: !-

:= opens_only_body (source : string) : bool =
    ?= text.next_line source 0i32 ?|
    | LineDone => !-
    | LineGot (_, next) => only_opens_from source next !-

:= test_mode_of (source : string) : string =
    := head = " " ++ first_line source ++ " "
    ? text.contains head " --ignore " ?> "ignore"
    |? text.contains head " --fails " ?> "fails"
    |? text.contains head " --build-only " ?> "build_only"
    |? text.contains head " --test static " ?> (? opens_only_body source ?> "prelude" |: "static")
    |: "test"

:~ ^ heading_marks_end (line : string) (i : i32) : i32 =
    ? i < text.length line && text.index line i = '#' ?> heading_marks_end line (i + 1i32) |: i

:= heading_title (source : string) : string =
    := line = text.trim (last_heading_line (text.trim source) 0i32 "")
    text.trim (text.replace (text.drop line (heading_marks_end line 0i32)) " (test)" "")

:~ ^ index_tests
    (real_wanted : bool) (xs : cells) (i : i32) (last : string) (title : string) (used : rows) (acc : rows)
    : rows
    =
    ?= xs ?|
    | NoCell => acc
    | Cell (kind, source, rest) =>
        := t = text.trim source
        ? kind = "markdown"
        ?>
            := heading = heading_test_name source
            ? heading = "" ?> index_tests real_wanted rest (i + 1i32) last title used acc
            |: index_tests real_wanted rest (i + 1i32) heading (heading_title source) used acc
        |? kind = "spiral" && test_cell t && spir_cell t = real_wanted
        ?>
            := base = ? last = "" ?> "cell" |: last
            := n = count_row used base
            := name = ? n = 0i32 ?> base |: base ++ "_" ++ text.show_i32 (n + 1i32)
            := realm = ? real_wanted ?> "real" |: "spi"
            := shown = ? title = "" ?> name |: title
            := row =
                text.show_i32 i
                ++ "\t"
                ++ name
                ++ "\t"
                ++ test_mode_of t
                ++ "\t"
                ++ realm
                ++ "\t"
                ++ test_symbol name
                ++ "\t"
                ++ shown
            index_tests real_wanted rest (i + 1i32) last title (Row (base, used)) (Row (row, acc))
        |: index_tests real_wanted rest (i + 1i32) last title used acc

:= test_index (src : string) : string =
    := xs = load src
    join_rows (rev_rows (index_tests !+ xs 0i32 "" "" NoRow (index_tests !- xs 0i32 "" "" NoRow NoRow)) NoRow)

:= policy_blocks (policy : test_policy) (xs : cells) : cells =
    ?= policy ?|
    | DropTests => xs
    | KeepTests => name_tests xs "" NoRow NoCell

:= export_text (kind : export_kind) (policy : test_policy) (src : string) : string =
    emit_spi (formatted (keep_docs (policy_blocks policy (export_blocks kind (load src) NoCell))) NoCell)

:= to_spi (src : string) : string = export_text SpiExport DropTests src

:= to_spir (src : string) : string = export_text SpirExport DropTests src

:= to_spi_tested (src : string) : string = export_text SpiExport KeepTests src

:= to_spir_tested (src : string) : string = export_text SpirExport KeepTests src

:~ ^ flags_valid (s : string) : bool =
    ? s = "" ?> !+
    |? text.starts_with s " static" ?> flags_valid (text.drop s 7i32)
    |? text.starts_with s " print_code" ?> flags_valid (text.drop s 11i32)
    |? text.starts_with s " ignore" ?> flags_valid (text.drop s 7i32)
    |? text.starts_with s " no_agree" ?>
        := rest = text.drop s 9i32
        := n = quoted_end rest
        ? n < 0i32 ?> !- |: flags_valid (text.drop rest n)
    |? text.starts_with s " build_only" ?> flags_valid (text.drop s 11i32)
    |? text.starts_with s " reference " ?>
        := n = text.take_unicode_ident s 11i32
        ? n > 11i32 ?> flags_valid (text.drop s n) |: !-
    |: !-

:= expectation_valid (clause : string) : bool =
    := n = text.length clause
    ? n >= 2i32 ?> text.index clause (n - 1i32) = '"' && text.find_char clause 0i32 '"' < n - 1i32 |: !-

:= modes_valid (s : string) : bool =
    := k = text.find_from s " fails " 0i32
    ? k >= 0i32 ?> flags_valid (text.take s k) && expectation_valid (text.drop s (k + 7i32)) |: flags_valid s

:| test_header =
    | NoHeader
    | Header : string * string

:= header_of (line : string) : test_header =
    ? text.starts_with line "test " ?>
        := n = text.take_unicode_ident line 5i32
        := rest = text.take (text.drop line n) (text.trim_end (text.drop line n) (text.length (text.drop line n)))
        := m = text.length rest
        ? n > 5i32 && m >= 2i32 && text.starts_at rest (m - 2i32) " =" && modes_valid (text.take rest (m - 2i32))
        ?> Header (text.slice_len line 5i32 (n - 5i32), text.take rest (m - 2i32))
        |: NoHeader
    |: NoHeader

:= real_marker (real_mode : bool) (src : string) : string =
    if real_mode && text.starts_with src "///- --real" = false then """
        ///- --real


        """ ++ src else src

:= test_options (real_mode : bool) (modes : string) : string =
    := padded = cut_before modes " fails " ++ " "
    := run = ? text.contains padded " ignore " ?> "--ignore" |: "--test"
    := base = ? real_mode ?> "--real " ++ run |: run
    := stat = ? text.contains padded " static " ?> " static" |: ""
    := show = ? text.contains padded " print_code " ?> " --print-code" |: ""
    := agree =
        ? text.contains padded " no_agree " || text.contains padded " no_agree \""
        ?> " --no-agree" ++ reason_after modes " no_agree"
        |: ""
    := build = ? text.contains padded " build_only " ?> " --build-only" |: ""
    := target = word_after padded " reference "
    := reference = ? target = "" ?> "" |: " --reference " ++ target
    base ++ stat ++ show ++ agree ++ reference ++ build ++ clause_after modes " fails " " --fails "

:= test_cell_source (real_mode : bool) (modes : string) (targets : rows) (body : rows) : string =
    join_rows (Row ("///- " ++ test_options real_mode modes, append_rows targets (Row ("", body))))

:| header_form =
    | WellFormed
    | Malformed : string

:= comment_line (line : string) : bool = text.starts_with line "//" || text.starts_with line "(* "

:= test_like (line : string) : bool =
    ? text.starts_with line "test" ?>
        ? text.length line = 4i32 ?> !+ |: text.ident_char (text.index line 4i32) = !-
    |: !-

:= malformed_name (line : string) : string =
    := start = lead_ws line 4i32
    := stop = text.take_unicode_ident line start
    ? stop > start ?> text.slice_len line start (stop - start) |: "test"

:~ ^ resumes_test (src : string) (i : i32) : bool =
    ?= text.next_line src i ?|
    | LineDone => !-
    | LineGot (line, next) =>
        ? text.blank line || comment_line line ?> resumes_test src next
        |: text.is_space (text.index line 0i32)

:| spi_mode =
    | Between
    | InDoc : rows
    | InCode : rows
    | InTest : string * string * rows * rows * header_form * i32

:= doc_start (line : string) : bool = text.starts_with line "/// " || line = "///"

:= doc_more (line : string) : bool =
    := i = lead_ws line 0i32
    text.starts_at line i "/// " || text.drop line i = "///"

:= undoc (line : string) : string =
    := i = lead_ws line 0i32
    ? text.starts_at line i "/// " ?> text.take line i ++ text.drop line (i + 4i32)
    |: text.take line i

:= no_rows (xs : rows) : bool =
    ?= xs ?|
    | NoRow => !+
    | _ => !-

:= unindent (line : string) : string = ? text.starts_with line "    " ?> text.drop line 4i32 |: line

:= indented (line : string) : bool = ? line = "" ?> !+ |: text.is_space (text.index line 0i32)

:= code_cell (lines : rows) (real_mode : bool) (acc : cells) : cells =
    := source = text.trim_newlines (join_rows (rev_rows lines NoRow))
    ? text.blank source ?> acc |: Cell ("spiral", real_marker real_mode source, acc)

:= doc_cell (lines : rows) (real_mode : bool) (acc : cells) : cells =
    := source = text.trim_newlines (join_rows (rev_rows lines NoRow))
    ? source = "" ?> acc |: Cell ("markdown", source, acc)

:= malformed_body (line : string) : rows =
    := quoted = text.replace (text.replace line "\\" "\\\\") "\"" "\\\""
    Row ("failwith \"malformed test header: " ++ quoted ++ "\" : ()", NoRow)

:= test_body (form : header_form) (body : rows) : rows =
    ?= form ?|
    | WellFormed => rev_rows (drop_blank_rows body) NoRow
    | Malformed line => malformed_body line

:= test_cell_of
    (name : string) (modes : string) (targets : rows) (body : rows) (form : header_form) (real_mode : bool)
    (acc : cells)
    : cells
    =
    := source = test_cell_source real_mode modes (rev_rows targets NoRow) (test_body form body)
    ? real_mode ?> Cell ("real_test:" ++ name, source, acc) |: Cell ("test:" ++ name, source, acc)

:= close_mode (mode : spi_mode) (targets : rows) (real_mode : bool) (acc : cells) : cells =
    ?= mode ?|
    | Between => code_cell targets real_mode acc
    | InDoc lines => code_cell targets real_mode (doc_cell lines real_mode acc)
    | InCode lines => code_cell (append_rows targets lines) real_mode acc
    | InTest (name, modes, test_targets, body, form, _) =>
        code_cell targets real_mode (test_cell_of name modes test_targets body form real_mode acc)

:= close_open (code : rows) (targets : rows) (real_mode : bool) (acc : cells) : cells =
    ? no_rows code ?> code_cell targets real_mode acc |: code_cell (append_rows targets code) real_mode acc

:~ open_step
    (line : string) (code : rows) (targets : rows) (real_mode : bool) (acc : cells)
    : spi_mode * rows * cells
    =
    ? text.starts_with line "///>"
    ?>
        ? no_rows code ?> Between, Row (line, targets), acc |: InCode code, Row (line, targets), acc
    |:
        ?= header_of line ?|
        | Header (name, modes) =>
            InTest (name, modes, targets, NoRow, WellFormed, -1i32), NoRow, close_open code NoRow real_mode acc
        | NoHeader =>
            ? test_like line
            ?>
                InTest (malformed_name line, "", targets, NoRow, Malformed line, -1i32),
                NoRow,
                close_open code NoRow real_mode acc
            |? doc_start line
            ?> InDoc (Row (undoc line, NoRow)), NoRow, close_open code targets real_mode acc
            |? no_rows code
            ?>
                ? line = "" && no_rows targets ?> Between, NoRow, acc
                |: InCode (Row (line, targets)), NoRow, acc
            |: InCode (Row (line, append_rows targets code)), NoRow, acc

:~ ^ tab_field (line : string) (from : i32) (n : i32) : string =
    := stop = text.find_char line from '\t'
    ? n = 0i32 ?> (? stop < 0i32 ?> text.drop line from |: text.slice_len line from (stop - from))
    |? stop < 0i32 ?> ""
    |: tab_field line (stop + 1i32) (n - 1i32)

:~ ^ body_last_of (bounds : string) (i : i32) (header_row : i32) : i32 =
    ?= text.next_line bounds i ?|
    | LineDone => -1i32
    | LineGot (line, next) =>
        ? text.parse_i32 (tab_field line 0i32 1i32) = header_row ?> text.parse_i32 (tab_field line 0i32 3i32)
        |: body_last_of bounds next header_row

:= bounded (mode : spi_mode) (bounds : string) (row : i32) : spi_mode =
    ?= mode ?|
    | InTest (name, modes, test_targets, body, form, _) =>
        InTest (
            name,
            modes,
            test_targets,
            body,
            form,
            ? bounds = ""
            ?> -1i32
            |: body_last_of bounds 0i32 (row + 1i32)
        )
    | _ => mode

:= bounded_line (line : string) : string = ? indented line ?> unindent line |: line

:~ ^ spi_walk
    (src : string) (i : i32) (row : i32) (bounds : string) (mode : spi_mode) (targets : rows) (real_mode : bool)
    (acc : cells)
    : cells
    =
    ?= text.next_line src i ?|
    | LineDone => close_mode mode targets real_mode acc
    | LineGot (line, next) =>
        ?= mode ?|
        | InTest (name, modes, test_targets, body, form, last) =>
            ? last >= 0i32
            ?>
                ? row + 1i32 <= last
                ?>
                    spi_walk src next
                        (row + 1i32)
                        bounds
                        (InTest (name, modes, test_targets, Row (bounded_line line, body), form, last))
                        targets
                        real_mode
                        acc
                |:
                    spi_walk src i row bounds Between NoRow real_mode (
                        test_cell_of name modes test_targets body form real_mode acc
                    )
            |? indented line
            ?>
                spi_walk src next
                    (row + 1i32)
                    bounds
                    (InTest (name, modes, test_targets, Row (unindent line, body), form, last))
                    targets
                    real_mode
                    acc
            |? comment_line line && resumes_test src next
            ?>
                spi_walk src next
                    (row + 1i32)
                    bounds
                    (InTest (name, modes, test_targets, Row (line, body), form, last))
                    targets
                    real_mode
                    acc
            |:
                spi_walk src i row bounds Between NoRow real_mode (
                    test_cell_of name modes test_targets body form real_mode acc
                )
        | InDoc lines =>
            ? doc_more line
            ?> spi_walk src next (row + 1i32) bounds (InDoc (Row (undoc line, lines))) targets real_mode acc
            |? line = ""
            ?> spi_walk src next (row + 1i32) bounds Between targets real_mode (doc_cell lines real_mode acc)
            |: spi_walk src i row bounds Between targets real_mode (doc_cell lines real_mode acc)
        | InCode lines =>
            := mode2, targets2, acc2 = open_step line lines targets real_mode acc
            spi_walk src next (row + 1i32) bounds (bounded mode2 bounds row) targets2 real_mode acc2
        | Between =>
            := mode2, targets2, acc2 = open_step line NoRow targets real_mode acc
            spi_walk src next (row + 1i32) bounds (bounded mode2 bounds row) targets2 real_mode acc2

:| test_realm =
    | SpiRealm
    | RealRealm

:= realm_of (kind : string) : test_realm = ? text.starts_with kind "real_test:" ?> RealRealm |: SpiRealm

:= realm_rows (realm : test_realm) (spi_used : rows) (real_used : rows) : rows =
    ?= realm ?|
    | SpiRealm => spi_used
    | RealRealm => real_used

:= spi_row (realm : test_realm) (name : string) (xs : rows) : rows =
    ?= realm ?|
    | SpiRealm => Row (name, xs)
    | RealRealm => xs

:= real_row (realm : test_realm) (name : string) (xs : rows) : rows =
    ?= realm ?|
    | SpiRealm => xs
    | RealRealm => Row (name, xs)

:= test_named_kind (kind : string) : bool = text.starts_with kind "test:" || text.starts_with kind "real_test:"

:= kind_test_name (kind : string) : string = text.drop kind (text.find_char kind 0i32 ':' + 1i32)

:~ ^ name_tested (xs : cells) (last : string) (spi_used : rows) (real_used : rows) (acc : cells) : cells =
    ?= xs ?|
    | NoCell => acc
    | Cell (kind, source, rest) =>
        ? kind = "markdown"
        ?>
            := heading = heading_test_name source
            name_tested rest (? heading = "" ?> last |: heading) spi_used real_used (Cell (kind, source, acc))
        |? test_named_kind kind
        ?>
            := realm = realm_of kind
            := used = realm_rows realm spi_used real_used
            := name = kind_test_name kind
            := base = ? last = "" ?> "cell" |: last
            := n = count_row used base
            := derived = ? n = 0i32 ?> base |: base ++ "_" ++ text.show_i32 (n + 1i32)
            := spi_more = spi_row realm base spi_used
            := real_more = real_row realm base real_used
            ? derived = name
            ?> name_tested rest last spi_more real_more (Cell ("spiral", source, acc))
            |:
                := heading_source = "#### " ++ name ++ " (test)"
                := heading = heading_test_name heading_source
                := spi_named = spi_row realm heading spi_used
                := real_named = real_row realm heading real_used
                name_tested rest heading spi_named real_named (
                    Cell ("spiral", source, Cell ("markdown", heading_source, acc))
                )
        |: name_tested rest last spi_used real_used (Cell (kind, source, acc))

:= spi_cells (src : string) (bounds : string) (real_mode : bool) (acc : cells) : cells =
    spi_walk (text.replace src "\r\n" "\n") 0i32 0i32 bounds Between NoRow real_mode acc

:~ ^ interleave (spi : cells) (real_cells : cells) (acc : cells) : cells =
    ?= real_cells ?|
    | NoCell => rev_cells acc spi
    | Cell (real_kind, real_source, real_rest) =>
        ? real_kind <> "markdown" ?> interleave spi real_rest (Cell (real_kind, real_source, acc))
        |:
            ?= spi ?|
            | NoCell => rev_cells acc real_cells
            | Cell (kind, source, rest) =>
                ? kind <> "markdown" ?> interleave rest real_cells (Cell (kind, source, acc))
                |? source = real_source ?> interleave rest real_rest (Cell (kind, source, acc))
                |: interleave rest real_cells (Cell (kind, source, acc))

:= from_spi_bounded (spi : string) (spir : string) (spi_bounds : string) (spir_bounds : string) : string =
    := spi_doc = rev_cells (spi_cells spi spi_bounds !- NoCell) NoCell
    := real_doc = rev_cells (spi_cells spir spir_bounds !+ NoCell) NoCell
    wire (name_tested (interleave spi_doc real_doc NoCell) "" NoRow NoRow NoCell)

:= from_spi (spi : string) (spir : string) : string = from_spi_bounded spi spir "" ""
