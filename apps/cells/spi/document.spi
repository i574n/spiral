:= (++) (left : string) (right : string) : string = left ^^ right

:== rows = list string

:| test_realm =
    | SpiRealm
    | RealRealm

:= realm_text (r : test_realm) : string = ?= r ?| SpiRealm => "spi" | RealRealm => "real"

:| cell_kind =
    | Markdown
    | SpiralCode
    | FsharpCode
    | ImportCell
    | TestCell
    | CodeIn : string
    | NamedTest : test_realm * string
    | OtherKind : string

:= kind_text (k : cell_kind) : string =
    ?= k ?|
    | Markdown => "markdown"
    | SpiralCode => "spiral"
    | FsharpCode => "fsharp"
    | ImportCell => "import"
    | TestCell => "test"
    | CodeIn lang => "code/" ++ lang
    | NamedTest (realm, name) => ?= realm ?| SpiRealm => "test:" ++ name | RealRealm => "real_test:" ++ name
    | OtherKind s => s

:= kind_of (s : string) : cell_kind =
    ? s = "markdown"
    ?> Markdown
    |? s = "spiral"
    ?> SpiralCode
    |? s = "fsharp"
    ?> FsharpCode
    |? s = "import"
    ?> ImportCell
    |? s = "test"
    ?> TestCell
    |? text::starts_with s "code/"
    ?> CodeIn (text::drop s 5i32)
    |? text::starts_with s "real_test:"
    ?> NamedTest (RealRealm, text::drop s 10i32)
    |? text::starts_with s "test:"
    ?> NamedTest (SpiRealm, text::drop s 5i32)
    |: OtherKind s

:== cells = list (cell_kind * string)

:== mark = option (string * string)

:== tokens = list string

:~ ^ rev_rows (xs : rows) (acc : rows) : rows =
    ?= xs ?|
    | [] => acc
    | s :: rest => rev_rows rest (s :: acc)

:~ ^ snoc (xs : rows) (item : string) : rows =
    ?= xs ?|
    | [] => item :: []
    | s :: rest => s :: (snoc rest item)

:~ ^ has_row (xs : rows) (item : string) : bool =
    ?= xs ?|
    | [] => !-
    | s :: rest => ? s = item ?> !+ |: has_row rest item

:= add_row (xs : rows) (item : string) : rows =
    ? has_row xs item ?> xs |: snoc xs item

:~ ^ rows_joined_after (xs : rows) (acc : string) : string =
    ?= xs ?|
    | [] => acc
    | s :: rest => rows_joined_after rest (acc ++ "\n" ++ s)

:~ join_rows (xs : rows) : string =
    ?= xs ?|
    | [] => ""
    | s :: rest => rows_joined_after rest s

:~ ^ count_cells (xs : cells) : i32 =
    ?= xs ?|
    | [] => 0i32
    | (_, _) :: rest => 1i32 + count_cells rest

:~ ^ rev_cells (xs : cells) (acc : cells) : cells =
    ?= xs ?|
    | [] => acc
    | (k, s) :: rest => rev_cells rest ((k, s) :: acc)

:~ ^ emit_cells (xs : cells) : string =
    ?= xs ?|
    | [] => ""
    | (k, s) :: rest =>
        kind_text k ++ "\n" ++ text::show_i32 (text::length s) ++ "\n" ++ s ++ emit_cells rest

:= wire (xs : cells) : string =
    := ordered = rev_cells xs []
    text::show_i32 (count_cells ordered) ++ "\n" ++ emit_cells ordered

:~ ^ letter_end (line : string) (i : i32) : i32 =
    ? i >= text::length line
    ?> i
    |? text::is_letter (text::index line i)
    ?> letter_end line (i + 1i32)
    |: i

:= marker (line : string) : mark =
    ? text::starts_with line "#!" ?>
        := n = letter_end line 2i32
        ? n = 2i32
        ?> None
        |: Some (text::slice_len line 2i32 (n - 2i32), text::drop line n)
    |: None

:= add_line (buffer : string) (line : string) : string =
    ? buffer = "" ?> line |: buffer ++ "\n" ++ line

:= push (xs : cells) (kind : option cell_kind) (buffer : string) : cells =
    ?= kind ?|
    | None => xs
    | Some k =>
        := source = text::trim buffer
        ? source = "" ?> xs |: (k, source) :: xs

:~ ^ walk (src : string) (i : i32) (xs : cells) (kind : option cell_kind) (buffer : string) : cells =
    ?= text::next_line src i ?|
    | LineDone => push xs kind buffer
    | LineGot (line, next) =>
        ?= marker line ?|
        | None => walk src next xs kind (add_line buffer line)
        | Some (name, rest) =>
            := xs2 = push xs kind buffer
            ? name = "meta"
            ?> walk src next xs2 None ""
            |:
                ?= kind_of name ?|
                | ImportCell => walk src next ((ImportCell, text::trim rest) :: xs2) kind ""
                | Markdown => walk src next xs2 (Some Markdown) ""
                | SpiralCode => walk src next xs2 (Some SpiralCode) ""
                | FsharpCode => walk src next xs2 (Some FsharpCode) ""
                | _ => walk src next xs2 (Some (CodeIn name)) ""

:= parse_dib (src : string) : string =
    wire (walk (text::replace src "\r\n" "\n") 0i32 [] None "")


:= spir_cell (source : string) : bool = text::contains source "///- " && text::contains source " --real"

:~ ^ directive_line_has (source : string) (flag : string) (i : i32) : bool =
    ?= text::next_line source i ?|
    | LineDone => !-
    | LineGot (line, next) =>
        ? text::starts_with line "///- " && text::contains line flag ?> !+
        |: directive_line_has source flag next

:= test_cell (source : string) : bool =
    directive_line_has source " --test" 0i32 || directive_line_has source " --ignore" 0i32

:| export_kind =
    | SpiExport
    | SpirExport

:= export_cell (kind : export_kind) (ck : cell_kind) (source : string) : bool =
    ?= kind ?|
    | SpiExport => ck = SpiralCode && spir_cell (text::trim source) = !-
    | SpirExport => ck = SpiralCode && spir_cell (text::trim source)

:~ ^ export_blocks (kind : export_kind) (xs : cells) (acc : cells) : cells =
    ?= xs ?|
    | [] => rev_cells acc []
    | (ck, source) :: rest =>
        ? ck = Markdown || export_cell kind ck source
        ?> export_blocks kind rest ((ck, source) :: acc)
        |: export_blocks kind rest acc

:~ ^ drop_bare_docs (xs : cells) : cells =
    ?= xs ?|
    | [] => []
    | (kind, source) :: rest =>
        := bare =
            ?= rest ?|
            | [] => kind = Markdown
            | (next_kind, _) :: _ => kind = Markdown && next_kind = Markdown
        ? bare ?> drop_bare_docs rest |: (kind, source) :: (drop_bare_docs rest)

:= export_docs (kind : export_kind) (xs : cells) : cells =
    ?= kind ?|
    | SpiExport => xs
    | SpirExport => drop_bare_docs xs

:~ ^ keep_docs (xs : cells) : cells =
    ?= xs ?|
    | [] => []
    | (kind, source) :: rest =>
        ?= rest ?|
        | [] => ? kind = Markdown ?> [] |: (kind, source) :: []
        | _ => (kind, source) :: (keep_docs rest)

:~ ^ lead_ws (line : string) (i : i32) : i32 =
    ? i >= text::length line
    ?> i
    |:
        := ch = text::index line i
        ? ch = ' '
        ?> lead_ws line (i + 1i32)
        |? ch = '\t'
        ?> lead_ws line (i + 1i32)
        |: i

:= doc_line (line : string) : string =
    ? line = "" ?> "/// "
    |:
        := i = lead_ws line 0i32
        ? i >= text::length line
        ?> line
        |: text::take line i ++ "/// " ++ text::drop line i

:= test_heading (line : string) : bool =
    := n = text::length line
    := m = text::length " (test)"
    ? n >= m ?> text::starts_at line (n - m) " (test)" |: !-

:~ ^ md_go (src : string) (i : i32) (acc : rows) : rows =
    ?= text::next_line src i ?|
    | LineDone => rev_rows acc []
    | LineGot (line, next) =>
        := t = text::take line (text::trim_end line (text::length line))
        ? test_heading t ?> md_go src next acc |: md_go src next ((doc_line t) :: acc)

:= format_cell (kind : cell_kind) (source : string) : string =
    := t = text::trim source
    ? kind = Markdown
    ?> join_rows (md_go t 0i32 [])
    |? kind = TestCell
    ?> t
    |? test_cell t
    ?> ""
    |: t

:~ ^ formatted (xs : cells) (acc : cells) : cells =
    ?= xs ?|
    | [] => rev_cells acc []
    | (kind, source) :: rest =>
        := s = format_cell kind source
        ? s = "" ?> formatted rest acc |: formatted rest ((kind, s) :: acc)

:~ ^ emit_spi (xs : cells) : string =
    ?= xs ?|
    | [] => ""
    | (kind, s) :: rest =>
        ?= rest ?|
        | [] => s ++ "\n"
        | (next, _) :: _ =>
            := lone_directive =
                kind <> Markdown
                && text::starts_with s "///- "
                && text::contains s "--package"
                && text::contains s "\n" = !-
            := brk = ? (kind = Markdown && next <> Markdown) || lone_directive ?> "" |: "\n"
            s ++ brk ++ "\n" ++ emit_spi rest

:~ ^ read_cells (src : string) (i : i32) (n : i32) (acc : cells) : cells =
    ? n <= 0i32
    ?> rev_cells acc []
    |:
        ?= text::next_line src i ?|
        | LineDone => rev_cells acc []
        | LineGot (kind, j) =>
            ?= text::next_line src j ?|
            | LineDone => rev_cells acc []
            | LineGot (len_text, k) =>
                := nlen = text::parse_i32 len_text
                read_cells src (k + nlen) (n - 1i32) ((kind_of kind, text::slice_len src k nlen) :: acc)

:= load (src : string) : cells =
    ?= text::next_line src 0i32 ?|
    | LineDone => []
    | LineGot (count, next) => read_cells src next (text::parse_i32 count) []

:| test_policy =
    | DropTests
    | KeepTests

:= upper_set () : string = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"

:= lower_set () : string = "abcdefghijklmnopqrstuvwxyz"

:= test_name_set () : string = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_"

:= lower_one (src : string) (i : i32) : string =
    := k = text::find_char (upper_set ()) 0i32 (text::index src i)
    ? k >= 0i32 ?> text::one (lower_set ()) k |: text::one src i

:= in_range (cp : i32) (low : i32) (high : i32) : bool = cp >= low && cp <= high

:= latin_letter (cp : i32) : bool = in_range cp 192i32 591i32 && cp <> 215i32 && cp <> 247i32

:= greek_letter (cp : i32) : bool = in_range cp 902i32 1013i32 && cp <> 903i32

:= cyrillic_letter (cp : i32) : bool = in_range cp 1024i32 1153i32 || in_range cp 1162i32 1327i32

:= armenian_letter (cp : i32) : bool = in_range cp 1329i32 1366i32 || in_range cp 1377i32 1415i32

:= hebrew_arabic_letter (cp : i32) : bool = in_range cp 1488i32 1514i32 || in_range cp 1568i32 1610i32

:= hangul_letter (cp : i32) : bool =
    in_range cp 4352i32 4607i32 || in_range cp 12593i32 12686i32 || in_range cp 44032i32 55203i32

:= kana_han_letter (cp : i32) : bool =
    in_range cp 12353i32 12438i32 || in_range cp 12449i32 12538i32 || in_range cp 19968i32 40959i32

:= unicode_letter (cp : i32) : bool =
    latin_letter cp
    || greek_letter cp
    || cyrillic_letter cp
    || armenian_letter cp
    || hebrew_arabic_letter cp
    || hangul_letter cp
    || kana_han_letter cp

:= name_piece (pending : bool) (acc : string) (piece : string) : string =
    := sep = ? pending && acc <> "" ?> "_" |: ""
    acc ++ sep ++ piece

:~ ^ test_name_go (src : string) (i : i32) (pending : bool) (acc : string) : string =
    ? i >= text::length src
    ?> acc
    |? text::byte_at src i >= 128i32 ?>
        := width = text::utf8_width (text::byte_at src i)
        ? unicode_letter (text::code_point src i)
        ?> test_name_go src (i + width) !- (name_piece pending acc (text::lowercase (text::slice_len src i width)))
        |: test_name_go src (i + width) !+ acc
    |? text::has_char (test_name_set ()) 0i32 (text::index src i)
    ?> test_name_go src (i + 1i32) !- (name_piece pending acc (lower_one src i))
    |: test_name_go src (i + 1i32) !+ acc

:~ ^ symbol_go (name : string) (i : i32) (acc : string) : string =
    ? i >= text::length name
    ?> acc
    |? text::byte_at name i < 128i32 && text::has_char (test_name_set ()) 0i32 (text::index name i)
    ?> symbol_go name (i + 1i32) (acc ++ text::one name i)
    |:
        := width = text::utf8_width (text::byte_at name i)
        symbol_go name (i + width) (acc ++ "u" ++ text::show_hex (text::code_point name i) ++ "_")

:= test_symbol (name : string) : string =
    := escaped = symbol_go name 0i32 ""
    ? escaped = name ?> name |: "test_" ++ escaped

:~ ^ underscore_start (src : string) (i : i32) : i32 =
    ? i < text::length src && text::index src i = '_' ?> underscore_start src (i + 1i32) |: i

:~ ^ underscore_end (src : string) (i : i32) : i32 =
    ? i > 0i32 && text::index src (i - 1i32) = '_' ?> underscore_end src (i - 1i32) |: i

:= strip_underscores (src : string) : string =
    := a = underscore_start src 0i32
    := b = underscore_end src (text::length src)
    ? b <= a ?> "" |: text::slice_len src a (b - a)

:~ ^ last_heading_line (src : string) (i : i32) (found : string) : string =
    ?= text::next_line src i ?|
    | LineDone => found
    | LineGot (line, next) =>
        ? text::starts_with (text::trim line) "#"
        ?> last_heading_line src next line
        |: last_heading_line src next found

:= heading_test_name (source : string) : string =
    := line = last_heading_line (text::trim source) 0i32 ""
    ? line = "" ?> "" |: strip_underscores (test_name_go (text::replace line " (test)" "") 0i32 !- "")

:~ ^ count_row (xs : rows) (item : string) : i32 =
    ?= xs ?|
    | [] => 0i32
    | s :: rest => ? s = item ?> 1i32 + count_row rest item |: count_row rest item

:~ ^ append_rows (xs : rows) (ys : rows) : rows =
    ?= xs ?|
    | [] => ys
    | s :: rest => s :: (append_rows rest ys)

:~ ^ drop_blank_rows (xs : rows) : rows =
    ?= xs ?|
    | [] => []
    | s :: rest => ? text::blank s ?> drop_blank_rows rest |: xs

:= body_row (line : string) : string = ? text::blank line ?> "" |: "    " ++ line

:= cut_before (s : string) (marker : string) : string =
    := k = text::find_from s marker 0i32
    ? k >= 0i32 ?> text::take s k |: s

:= clause_after (s : string) (marker : string) (shown : string) : string =
    := k = text::find_from s marker 0i32
    ? k >= 0i32 ?> shown ++ text::trim (text::drop s (k + text::length marker)) |: ""

:= quoted_end (s : string) : i32 =
    ? text::starts_with s " \"" ?>
        := close = text::find_char s 2i32 '"'
        ? close >= 2i32 ?> close + 1i32 |: -1i32
    |: 0i32

:= reason_after (s : string) (marker : string) : string =
    := k = text::find_from (s ++ " ") (marker ++ " ") 0i32
    ? k < 0i32
    ?> ""
    |:
        := rest = text::drop s (k + text::length marker)
        := n = quoted_end rest
        ? n > 0i32 ?> text::take rest n |: ""

:= word_after (s : string) (marker : string) : string =
    := k = text::find_from s marker 0i32
    ? k < 0i32
    ?> ""
    |:
        := start = k + text::length marker
        text::slice_len s start (text::take_unicode_ident s start - start)

:= head_and_tail (source : string) : string * string =
    := k = text::find_char source 0i32 '\n'
    ? k < 0i32 ?> source, "" |: text::take source k, text::drop source k

:= explicit_name (source : string) (derived : string) : string =
    := head, _ = head_and_tail source
    := explicit = word_after (head ++ " ") " --name "
    ? explicit = "" ?> derived |: explicit

:= with_name (source : string) (name : string) : string =
    := head, tail = head_and_tail source
    := k = text::find_from head " --fails " 0i32
    := named = ? k < 0i32 ?> head ++ " --name " ++ name |: text::take head k ++ " --name " ++ name ++ text::drop head k
    named ++ tail

:== test_switches = { symbol : bool; static : bool; print_code : bool; ignore : bool; build_only : bool }

:== test_flags = { switches : test_switches; no_agree : option string; refers : option string; fails : option string }

:= has_word (head : string) (word : string) : bool = text::contains (" " ++ head ++ " ") (" " ++ word ++ " ")

:= agree_of (head : string) (word : string) : option string =
    ? has_word head word || text::contains (" " ++ head) (" " ++ word ++ " \"") ?> Some (reason_after head word) |: None

:= reference_of (head : string) : option string =
    := target = word_after (head ++ " ") " --reference "
    ? target = "" ?> None |: Some target

:= fails_of (options : string) : option string =
    := k = text::find_from options " --fails " 0i32
    ? k >= 0i32 ?> Some (text::trim (text::drop options (k + text::length " --fails "))) |: None

:= flags_of (options : string) : test_flags =
    := head = cut_before options " --fails "
    := symbol = text::contains (" " ++ options ++ " ") " --symbol "
    := static = has_word head "static"
    := print_code = has_word head "--print-code"
    := ignore = has_word head "--ignore"
    := build_only = has_word head "--build-only"
    := switches = { symbol; static; print_code; ignore; build_only }
    { switches; no_agree = agree_of head "--no-agree"; refers = reference_of head; fails = fails_of options }

:= flag_text (on : bool) (shown : string) : string = ? on ?> " " ++ shown |: ""

:= some_text (o : option string) (prefix : string) : string = ?= o ?| Some s => prefix ++ s | None => ""

:= header_text (name : string) (f : test_flags) : string =
    := s = f::switches
    := opener = ? s::symbol ?> ":# " |: "test "
    := plain = flag_text s::static "static" ++ flag_text s::print_code "print_code" ++ flag_text s::ignore "ignore"
    := agree = some_text f::no_agree " no_agree" ++ some_text f::refers " reference "
    opener ++ name ++ plain ++ agree ++ flag_text s::build_only "build_only" ++ some_text f::fails " fails " ++ " ="

:= user_flag_row (line : string) : bool =
    := flags = text::trim (text::drop line 4i32)
    text::starts_with line "///- "
    && not (text::starts_with flags "--test" || text::starts_with flags "--ignore" || text::starts_with flags "--real")

:~ ^ test_block_go
    (src : string) (i : i32) (targets : rows) (options : string) (body : rows) (name : string)
    : string
    =
    ?= text::next_line src i ?|
    | LineDone =>
        := header = header_text name (flags_of options)
        := lines = rev_rows (drop_blank_rows body) []
        join_rows (append_rows (rev_rows targets []) (header :: lines))
    | LineGot (line, next) =>
        ? text::starts_with line "///-" && not (user_flag_row line)
        ?> test_block_go src next targets (options ++ " " ++ text::trim (text::drop line 4i32)) body name
        |? user_flag_row line
        ?> test_block_go src next (line :: targets) options body name
        |? text::starts_with line "///>"
        ?> test_block_go src next (line :: targets) options body name
        |:
            ?= body ?|
            | [] =>
                ? text::blank line
                ?> test_block_go src next targets options [] name
                |: test_block_go src next targets options ((body_row line) :: []) name
            | _ => test_block_go src next targets options ((body_row line) :: body) name

:= test_block (source : string) (name : string) : string = test_block_go source 0i32 [] "" [] name

:= nonempty (s : string) : option string = ? s = "" ?> None |: Some s

:= or_name (fallback : string) (x : option string) : string = ?= x ?| Some s => s | None => fallback

:= heading_name (source : string) : option string = nonempty (heading_test_name source)

:~ ^ name_tests (xs : cells) (last : option string) (used : rows) (acc : cells) : cells =
    ?= xs ?|
    | [] => rev_cells acc []
    | (kind, source) :: rest =>
        ? kind = Markdown ?>
            := last2 = ?= heading_name source ?| Some heading => Some heading | None => last
            name_tests rest last2 used ((kind, source) :: acc)
        |? test_cell (text::trim source) ?>
            := base = or_name "cell" last
            := n = count_row used base
            := name = ? n = 0i32 ?> base |: base ++ "_" ++ text::show_i32 (n + 1i32)
            := named = explicit_name (text::trim source) name
            name_tests rest last (base :: used) ((TestCell, test_block (text::trim source) named) :: acc)
        |: name_tests rest last used ((kind, source) :: acc)

:= first_line (source : string) : string =
    ?= text::next_line source 0i32 ?|
    | LineDone => ""
    | LineGot (line, _) => line

:~ ^ only_opens_from (source : string) (i : i32) (seen : bool) : bool =
    ?= text::next_line source i ?|
    | LineDone => seen
    | LineGot (line, next) =>
        := t = text::trim line
        ? t = "" || text::starts_with t "///" ?> only_opens_from source next seen
        |? text::starts_with t "open " || text::starts_with t ":< "
        ?> only_opens_from source next !+
        |: !-

:= opens_only_body (source : string) : bool =
    ?= text::next_line source 0i32 ?|
    | LineDone => !-
    | LineGot (_, next) => only_opens_from source next !-

:| test_mode =
    | IgnoredTest
    | FailingTest
    | BuildOnlyTest
    | PreludeTest
    | StaticTest
    | PlainTest

:= mode_text (m : test_mode) : string =
    ?= m ?|
    | IgnoredTest => "ignore"
    | FailingTest => "fails"
    | BuildOnlyTest => "build_only"
    | PreludeTest => "prelude"
    | StaticTest => "static"
    | PlainTest => "test"

:= test_mode_of (source : string) : test_mode =
    := head = " " ++ first_line source ++ " "
    ? text::contains head " --ignore "
    ?> IgnoredTest
    |? text::contains head " --fails "
    ?> FailingTest
    |? text::contains head " --build-only "
    ?> BuildOnlyTest
    |? text::contains head " --test static "
    ?> (? opens_only_body source ?> PreludeTest |: StaticTest)
    |: PlainTest

:== test_row = { at : i32; name : string; mode : test_mode; realm : test_realm; symbol : string; shown : string }

:= row_text (r : test_row) : string =
    sm'::concat_list "\t" [ text::show_i32 r::at; r::name; mode_text r::mode; realm_text r::realm; r::symbol; r::shown ]

:~ ^ heading_marks_end (line : string) (i : i32) : i32 =
    ? i < text::length line && text::index line i = '#' ?> heading_marks_end line (i + 1i32) |: i

:= heading_title (source : string) : string =
    := line = text::trim (last_heading_line (text::trim source) 0i32 "")
    text::trim (text::replace (text::drop line (heading_marks_end line 0i32)) " (test)" "")

:~ ^ index_tests
    (real_wanted : bool) (xs : cells) (i : i32) (last : option string) (title : option string) (used : rows)
    (acc : list test_row)
    : list test_row
    =
    ?= xs ?|
    | [] => acc
    | (kind, source) :: rest =>
        := t = text::trim source
        ? kind = Markdown ?>
            ?= heading_name source ?|
            | None => index_tests real_wanted rest (i + 1i32) last title used acc
            | Some heading =>
                index_tests real_wanted rest (i + 1i32) (Some heading) (nonempty (heading_title source)) used acc
        |? kind = SpiralCode && test_cell t && spir_cell t = real_wanted ?>
            := base = or_name "cell" last
            := n = count_row used base
            := name = explicit_name t (? n = 0i32 ?> base |: base ++ "_" ++ text::show_i32 (n + 1i32))
            := realm = ? real_wanted ?> RealRealm |: SpiRealm
            := shown = or_name name title
            := row = { at = i; name; mode = test_mode_of t; realm; symbol = test_symbol name; shown }
            index_tests real_wanted rest (i + 1i32) last title (base :: used) (row :: acc)
        |: index_tests real_wanted rest (i + 1i32) last title used acc

:= test_index (src : string) : string =
    := xs = load src
    := rows_found = index_tests !+ xs 0i32 None None [] (index_tests !- xs 0i32 None None [] [])
    sm'::concat_list "\n" (listm::map row_text (listm::rev rows_found))

:= policy_blocks (policy : test_policy) (xs : cells) : cells =
    ?= policy ?|
    | DropTests => xs
    | KeepTests => name_tests xs None [] []

:= export_text (kind : export_kind) (policy : test_policy) (src : string) : string =
    emit_spi (formatted (keep_docs (export_docs kind (policy_blocks policy (export_blocks kind (load src) [])))) [])

:= to_spi (src : string) : string = export_text SpiExport DropTests src

:= to_spir (src : string) : string = export_text SpirExport DropTests src

:= to_spi_tested (src : string) : string = export_text SpiExport KeepTests src

:= to_spir_tested (src : string) : string = export_text SpirExport KeepTests src

:~ ^ flags_valid (s : string) : bool =
    ? s = ""
    ?> !+
    |? text::starts_with s " static"
    ?> flags_valid (text::drop s 7i32)
    |? text::starts_with s " print_code"
    ?> flags_valid (text::drop s 11i32)
    |? text::starts_with s " ignore"
    ?> flags_valid (text::drop s 7i32)
    |? text::starts_with s " no_agree" ?>
        := rest = text::drop s 9i32
        := n = quoted_end rest
        ? n < 0i32 ?> !- |: flags_valid (text::drop rest n)
    |? text::starts_with s " build_only"
    ?> flags_valid (text::drop s 11i32)
    |? text::starts_with s " reference " ?>
        := n = text::take_unicode_ident s 11i32
        ? n > 11i32 ?> flags_valid (text::drop s n) |: !-
    |: !-

:= expectation_valid (clause : string) : bool =
    := n = text::length clause
    ? n >= 2i32 ?> text::index clause (n - 1i32) = '"' && text::find_char clause 0i32 '"' < n - 1i32 |: !-

:= modes_valid (s : string) : bool =
    := k = text::find_from s " fails " 0i32
    ? k >= 0i32 ?> flags_valid (text::take s k) && expectation_valid (text::drop s (k + 7i32)) |: flags_valid s

:= header_of (line : string) : option (string * string) =
    := p = ? text::starts_with line "test " ?> 5i32 |? text::starts_with line ":# " ?> 3i32 |: 0i32
    ? p > 0i32 ?>
        := n = text::take_unicode_ident line p
        := rest = text::take (text::drop line n) (text::trim_end (text::drop line n) (text::length (text::drop line n)))
        := m = text::length rest
        := spelling = ? p = 3i32 ?> " symbol" |: ""
        ? n > p && m >= 2i32 && text::starts_at rest (m - 2i32) " =" && modes_valid (text::take rest (m - 2i32))
        ?> Some (text::slice_len line p (n - p), spelling ++ text::take rest (m - 2i32))
        |: None
    |: None

:= real_marker (real_mode : bool) (src : string) : string =
    if real_mode && text.starts_with src "///- --real" = false then """
        ///- --real


        """ ++ src else src

:= test_options (real_mode : bool) (modes : string) : string =
    := padded = cut_before modes " fails " ++ " "
    := run = ? text::contains padded " ignore " ?> "--ignore" |: "--test"
    := base = ? real_mode ?> "--real " ++ run |: run
    := stat = ? text::contains padded " static " ?> " static" |: ""
    := show = ? text::contains padded " print_code " ?> " --print-code" |: ""
    := agree =
        ? text::contains padded " no_agree " || text::contains padded " no_agree \""
        ?> " --no-agree" ++ reason_after modes " no_agree"
        |: ""
    := build = ? text::contains padded " build_only " ?> " --build-only" |: ""
    := symbol = ? text::contains (" " ++ padded) " symbol " ?> " --symbol" |: ""
    := target = word_after padded " reference "
    := reference = ? target = "" ?> "" |: " --reference " ++ target
    base ++ stat ++ show ++ agree ++ reference ++ build ++ symbol ++ clause_after modes " fails " " --fails "

:= test_cell_source (real_mode : bool) (modes : string) (targets : rows) (body : rows) : string =
    join_rows (("///- " ++ test_options real_mode modes) :: (append_rows targets ("" :: body)))

:| header_form =
    | WellFormed
    | Malformed : string

:= comment_line (line : string) : bool = text::starts_with line "//" || text::starts_with line "(* "

:= test_like (line : string) : bool =
    ? text::starts_with line ":# "
    ?> !+
    |? text::starts_with line "test" ?>
        ? text::length line = 4i32 ?> !+ |: text::ident_char (text::index line 4i32) = !-
    |: !-

:= malformed_name (line : string) : string =
    := start = lead_ws line (? text::starts_with line ":#" ?> 2i32 |: 4i32)
    := stop = text::take_unicode_ident line start
    ? stop > start ?> text::slice_len line start (stop - start) |: "test"

:~ ^ resumes_test (src : string) (i : i32) : bool =
    ?= text::next_line src i ?|
    | LineDone => !-
    | LineGot (line, next) =>
        ? text::blank line || comment_line line
        ?> resumes_test src next
        |: text::is_space (text::index line 0i32)

:== open_test = { name : string; modes : string; targets : rows; body : rows; form : header_form; last : i32 }

:| spi_mode =
    | Between
    | InDoc : rows
    | InCode : rows
    | InTest : open_test

:= doc_start (line : string) : bool = text::starts_with line "/// " || line = "///"

:= doc_more (line : string) : bool =
    := i = lead_ws line 0i32
    text::starts_at line i "/// " || text::drop line i = "///"

:= undoc (line : string) : string =
    := i = lead_ws line 0i32
    ? text::starts_at line i "/// " ?> text::take line i ++ text::drop line (i + 4i32)
    |: text::take line i

:= no_rows (xs : rows) : bool =
    ?= xs ?|
    | [] => !+
    | _ => !-

:= unindent (line : string) : string = ? text::starts_with line "    " ?> text::drop line 4i32 |: line

:= indented (line : string) : bool = ? line = "" ?> !+ |: text::is_space (text::index line 0i32)

:= code_cell (lines : rows) (real_mode : bool) (acc : cells) : cells =
    := source = text::trim_newlines (join_rows (rev_rows lines []))
    ? text::blank source ?> acc |: (SpiralCode, real_marker real_mode source) :: acc

:= doc_cell (lines : rows) (real_mode : bool) (acc : cells) : cells =
    := source = text::trim_newlines (join_rows (rev_rows lines []))
    ? source = "" ?> acc |: (Markdown, source) :: acc

:= malformed_body (line : string) : rows =
    := quoted = text::replace (text::replace line "\\" "\\\\") "\"" "\\\""
    ("failwith \"malformed test header: " ++ quoted ++ "\" : ()") :: []

:= test_body (form : header_form) (body : rows) : rows =
    ?= form ?|
    | WellFormed => rev_rows (drop_blank_rows body) []
    | Malformed line => malformed_body line

:= test_cell_of (t : open_test) (real_mode : bool) (acc : cells) : cells =
    := source = test_cell_source real_mode t::modes (rev_rows t::targets []) (test_body t::form t::body)
    := realm = ? real_mode ?> RealRealm |: SpiRealm
    (NamedTest (realm, t::name), source) :: acc

:= close_mode (mode : spi_mode) (targets : rows) (real_mode : bool) (acc : cells) : cells =
    ?= mode ?|
    | Between => code_cell targets real_mode acc
    | InDoc lines => code_cell targets real_mode (doc_cell lines real_mode acc)
    | InCode lines => code_cell (append_rows targets lines) real_mode acc
    | InTest t => code_cell targets real_mode (test_cell_of t real_mode acc)

:= close_open (code : rows) (targets : rows) (real_mode : bool) (acc : cells) : cells =
    ? no_rows code ?> code_cell targets real_mode acc |: code_cell (append_rows targets code) real_mode acc

:= test_flag_row (line : string) : bool = text::starts_with line "///- " && not (text::contains line "--package")

:= directive_row (line : string) : bool = text::starts_with line "///>" || test_flag_row line

:~ ^ split_directives (xs : rows) (acc : rows) : rows * rows =
    ?= xs ?|
    | x :: rest ?& directive_row x => split_directives rest (x :: acc)
    | _ => rev_rows acc [], xs

:~ open_step
    (line : string) (code : rows) (targets : rows) (real_mode : bool) (acc : cells)
    : spi_mode * rows * cells
    =
    ? text::starts_with line "///>" ?>
        ? no_rows code ?> Between, line :: targets, acc |: InCode code, line :: targets, acc
    |:
        ?= header_of line ?|
        | Some (name, modes) =>
            := directives, rest_code = split_directives code []
            := opened =
                { name; modes; targets = append_rows targets directives; body = []; form = WellFormed; last = -1i32 }
            InTest opened, [], close_open rest_code [] real_mode acc
        | None =>
            ? test_like line ?>
                := form = Malformed line
                := broken = { name = malformed_name line; modes = ""; targets; body = []; form; last = -1i32 }
                InTest broken, [], close_open code [] real_mode acc
            |? doc_start line
            ?> InDoc ((undoc line) :: []), [], close_open code targets real_mode acc
            |? no_rows code ?>
                ? line = "" && no_rows targets ?> Between, [], acc
                |: InCode (line :: targets), [], acc
            |: InCode (line :: (append_rows targets code)), [], acc

:~ ^ tab_field (line : string) (from : i32) (n : i32) : string =
    := stop = text::find_char line from '\t'
    ? n = 0i32
    ?> (? stop < 0i32 ?> text::drop line from |: text::slice_len line from (stop - from))
    |? stop < 0i32
    ?> ""
    |: tab_field line (stop + 1i32) (n - 1i32)

:== body_bound = { header : i32; last : i32 }

:= bound_of (line : string) : body_bound =
    { header = text::parse_i32 (tab_field line 0i32 1i32); last = text::parse_i32 (tab_field line 0i32 3i32) }

:~ ^ bounds_from (source : string) (i : i32) (acc : list body_bound) : list body_bound =
    ?= text::next_line source i ?|
    | LineDone => listm::rev acc
    | LineGot (line, next) => bounds_from source next (bound_of line :: acc)

:= bounds_of (source : string) : list body_bound = ? source = "" ?> [] |: bounds_from source 0i32 []

:~ ^ body_last_of (bounds : list body_bound) (header_row : i32) : i32 =
    ?= bounds ?|
    | [] => -1i32
    | b :: rest => ? b::header = header_row ?> b::last |: body_last_of rest header_row

:= bounded (mode : spi_mode) (bounds : list body_bound) (row : i32) : spi_mode =
    ?= mode ?|
    | InTest t =>
        := last = body_last_of bounds (row + 1i32)
        InTest { t ?| last = last }
    | _ => mode

:= bounded_line (line : string) : string = ? indented line ?> unindent line |: line

:~ ^ spi_walk
    (src : string) (i : i32) (row : i32) (bounds : list body_bound) (mode : spi_mode) (targets : rows)
    (real_mode : bool) (acc : cells)
    : cells
    =
    ?= text::next_line src i ?|
    | LineDone => close_mode mode targets real_mode acc
    | LineGot (line, next) =>
        ?= mode ?|
        | InTest t =>
            := grown = \ (kept : string) => InTest { t ?| body = kept :: t::body }
            ? t::last >= 0i32 ?>
                ? row + 1i32 <= t::last
                ?> spi_walk src next (row + 1i32) bounds (grown (bounded_line line)) targets real_mode acc
                |: spi_walk src i row bounds Between [] real_mode (test_cell_of t real_mode acc)
            |? indented line
            ?> spi_walk src next (row + 1i32) bounds (grown (unindent line)) targets real_mode acc
            |? comment_line line && resumes_test src next
            ?> spi_walk src next (row + 1i32) bounds (grown line) targets real_mode acc
            |: spi_walk src i row bounds Between [] real_mode (test_cell_of t real_mode acc)
        | InDoc lines =>
            ? doc_more line
            ?> spi_walk src next (row + 1i32) bounds (InDoc ((undoc line) :: lines)) targets real_mode acc
            |? line = ""
            ?> spi_walk src next (row + 1i32) bounds Between targets real_mode (doc_cell lines real_mode acc)
            |: spi_walk src i row bounds Between targets real_mode (doc_cell lines real_mode acc)
        | InCode lines =>
            := mode2, targets2, acc2 = open_step line lines targets real_mode acc
            spi_walk src next (row + 1i32) bounds (bounded mode2 bounds row) targets2 real_mode acc2
        | Between =>
            := mode2, targets2, acc2 = open_step line [] targets real_mode acc
            spi_walk src next (row + 1i32) bounds (bounded mode2 bounds row) targets2 real_mode acc2

:~ ^ target_gaps_walk (src : string) (i : i32) (row : i32) (in_force : string) (after_doc : bool) (acc : rows) : rows =
    ?= text::next_line src i ?|
    | LineDone => acc
    | LineGot (line, next) =>
        ? text::starts_with line "/// #" ?> target_gaps_walk src next (row + 1i32) "" !- acc
        |? text::starts_with line "///>" ?> target_gaps_walk src next (row + 1i32) line !- acc
        |? doc_start line
        ?> target_gaps_walk src next (row + 1i32) in_force (after_doc || in_force <> "") acc
        |? after_doc && indented line = !- && text::starts_with line "//" = !-
        ?> target_gaps_walk src next (row + 1i32) in_force !- ((text::show_i32 row ++ "\t" ++ in_force) :: acc)
        |: target_gaps_walk src next (row + 1i32) in_force after_doc acc

:= target_gaps (src : string) : string = join_rows (rev_rows (target_gaps_walk src 0i32 1i32 "" !- []) [])

:= realm_of (kind : cell_kind) : test_realm = ?= kind ?| NamedTest (realm, _) => realm | _ => SpiRealm

:= realm_rows (realm : test_realm) (spi_used : rows) (real_used : rows) : rows =
    ?= realm ?|
    | SpiRealm => spi_used
    | RealRealm => real_used

:= spi_row (realm : test_realm) (name : string) (xs : rows) : rows =
    ?= realm ?|
    | SpiRealm => name :: xs
    | RealRealm => xs

:= real_row (realm : test_realm) (name : string) (xs : rows) : rows =
    ?= realm ?|
    | SpiRealm => xs
    | RealRealm => name :: xs

:= test_named_kind (kind : cell_kind) : bool = ?= kind ?| NamedTest _ => !+ | _ => !-

:= kind_test_name (kind : cell_kind) : string = ?= kind ?| NamedTest (_, name) => name | _ => ""

:~ ^ name_tested (xs : cells) (last : option string) (spi_used : rows) (real_used : rows) (acc : cells) : cells =
    ?= xs ?|
    | [] => acc
    | (kind, source) :: rest =>
        ? kind = Markdown ?>
            := last2 = ?= heading_name source ?| Some heading => Some heading | None => last
            name_tested rest last2 spi_used real_used ((kind, source) :: acc)
        |? test_named_kind kind ?>
            := realm = realm_of kind
            := used = realm_rows realm spi_used real_used
            := name = kind_test_name kind
            := base = or_name "cell" last
            := n = count_row used base
            := derived = ? n = 0i32 ?> base |: base ++ "_" ++ text::show_i32 (n + 1i32)
            := spi_more = spi_row realm base spi_used
            := real_more = real_row realm base real_used
            ? derived = name
            ?> name_tested rest last spi_more real_more ((SpiralCode, source) :: acc)
            |:
                := heading_source = "#### " ++ name ++ " (test)"
                := heading = heading_test_name heading_source
                := shown = ? heading = name ?> source |: with_name source name
                := spi_named = spi_row realm heading spi_used
                := real_named = real_row realm heading real_used
                name_tested rest (nonempty heading) spi_named real_named (
                    (SpiralCode, shown) :: ((Markdown, heading_source) :: acc)
                )
        |: name_tested rest last spi_used real_used ((kind, source) :: acc)

:= spi_cells (src : string) (bounds : string) (real_mode : bool) (acc : cells) : cells =
    spi_walk (text::replace src "\r\n" "\n") 0i32 0i32 (bounds_of bounds) Between [] real_mode acc

:~ ^ interleave (spi : cells) (real_cells : cells) (acc : cells) : cells =
    ?= real_cells ?|
    | [] => rev_cells acc spi
    | (real_kind, real_source) :: real_rest =>
        ? real_kind <> Markdown
        ?> interleave spi real_rest ((real_kind, real_source) :: acc)
        |:
            ?= spi ?|
            | [] => rev_cells acc real_cells
            | (kind, source) :: rest =>
                ? kind <> Markdown
                ?> interleave rest real_cells ((kind, source) :: acc)
                |? source = real_source
                ?> interleave rest real_rest ((kind, source) :: acc)
                |: interleave rest real_cells ((kind, source) :: acc)

:= from_spi_bounded (spi : string) (spir : string) (spi_bounds : string) (spir_bounds : string) : string =
    := spi_doc = rev_cells (spi_cells spi spi_bounds !- []) []
    := real_doc = rev_cells (spi_cells spir spir_bounds !+ []) []
    wire (name_tested (interleave spi_doc real_doc []) None [] [] [])

:= from_spi (spi : string) (spir : string) : string = from_spi_bounded spi spir "" ""
