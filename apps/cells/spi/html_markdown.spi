///- --package .
:# html_markdown static =
    :< testing

:= (++) (left : string) (right : string) : string = left ^^ right

:= markdown (source : string) : string = markup::markup_text (doc_render::blocks_html (doc_parse::parse_markdown source))

///> gleam
:# markdown_blocks_and_inline_spans_render_like_the_elixir_one =
    := got = markdown "# T\nsome `x` and [a](b)\nmore\n- one\n- two\n```\n<x>\n```\nend"
    := head = "<h1>T</h1>\n<p>some <code>x</code> and <a href=\"b\">a</a> more</p>\n"
    := tail = "<ul>\n<li>one</li>\n<li>two</li>\n</ul>\n<pre><code>&lt;x&gt;\n</code></pre>\n<p>end</p>\n"
    got |> _assert_eq (head ++ tail)
