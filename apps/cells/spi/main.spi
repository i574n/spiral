:= export \* t. (name : string) (f : t) : () = !!!!Export(name, f)

:= main () : i32 =
    export "prepare" ((\ code => directives.prepare code) : string -> string)
    export
        "patch_rust"
        ((\ (rust : string), (show : string) => cell.patch_rust rust show) : string * string -> string)
    export "split_output" ((\ output => cell.split_output output) : string -> string)
    export "unit_result" ((\ output => cell.unit_result output) : string -> string)
    export "package_project" ((\ includes => cell.package_project includes) : string -> string)
    export "parse_dib" ((\ text => document.parse_dib text) : string -> string)
    export "to_spi" ((\ text => document.to_spi text) : string -> string)
    export "to_spir" ((\ text => document.to_spir text) : string -> string)
    export "to_spi_tested" ((\ text => document.to_spi_tested text) : string -> string)
    export "to_spir_tested" ((\ text => document.to_spir_tested text) : string -> string)
    export "from_spi" ((\ (spi : string), (spir : string) => document.from_spi spi spir) : string * string -> string)
    export
        "from_spi_bounded"
        (
            \ (spi : string), (spir : string), (spi_bounds : string), (spir_bounds : string) =>
                document.from_spi_bounded spi spir spi_bounds spir_bounds
            : string * string * string * string -> string
        )
    export "test_index" ((\ text => document.test_index text) : string -> string)
    export "target_gaps" ((\ text => document.target_gaps text) : string -> string)
    export "target_backend" ((\ tool => targets.backend (targets.target_of tool)) : string -> string)
    export "target_extension" ((\ tool => targets.extension (targets.target_of tool)) : string -> string)
    export "plan" ((\ text => notebook.plan text) : string -> string)
    export "plan_tests" ((\ text => notebook.plan_tests text) : string -> string)
    0i32
