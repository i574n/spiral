:= export \* t. (name : string) (f : t) : () = !!!!Export(name, f)

:= main () : i32 =
    export "prepare" ((\ code => directives::prepare code) : string -> string)
    export
        "patch_rust"
        ((\ (rust : string), (show : string) => cell::patch_rust rust (cell::shown_of show)) : string * string -> string)
    export "split_output" ((\ output => cell::run_output_text (cell::split_output output)) : string -> string)
    export "unit_result" ((\ output => cell::flag_text (cell::unit_result output)) : string -> string)
    export "package_project" ((\ includes => cell::package_project includes) : string -> string)
    export "parse_dib" ((\ text => document::parse_dib text) : string -> string)
    export "to_spi" ((\ text => document::to_spi text) : string -> string)
    export "to_spir" ((\ text => document::to_spir text) : string -> string)
    export "to_spi_tested" ((\ text => document::to_spi_tested text) : string -> string)
    export "to_spir_tested" ((\ text => document::to_spir_tested text) : string -> string)
    export "from_spi" ((\ (spi : string), (spir : string) => document::from_spi spi spir) : string * string -> string)
    export
        "from_spi_bounded"
        (
            \ (spi : string), (spir : string), (spi_bounds : string), (spir_bounds : string) =>
                document::from_spi_bounded spi spir spi_bounds spir_bounds
            : string * string * string * string -> string
        )
    export "test_index" ((\ text => document::test_index text) : string -> string)
    export "target_gaps" ((\ text => document::target_gaps text) : string -> string)
    export "target_backend" ((\ tool => targets::backend (targets::target_of tool)) : string -> string)
    export "target_extension" ((\ tool => targets::extension (targets::target_of tool)) : string -> string)
    export "plan" ((\ text => notebook::plan text) : string -> string)
    export "plan_tests" ((\ text => notebook::plan_tests text) : string -> string)
    export
        "reached_program"
        ((\ (program : string), (rows : string) => memo::reached_program_wire program rows) : string * string -> string)
    export "from_toml" ((\ text => manifest::from_toml text) : string -> string)
    export "declares_modules" ((\ text => ? manifest::declares_modules text ?> "true" |: "false") : string -> string)
    export
        "source_remap"
        (
            \ (message : string), (program : string), (source : string), (path : string) =>
                source_map::remap message program source path
            : string * string * string * string -> string
        )
    export "markdown_html" ((\ text => html_markdown::markdown text) : string -> string)
    export "json_canonical" ((\ text => json_value::canonical text) : string -> string)
    export "builder_present" ((\ text => builder_output::present text) : string -> string)
    export "builder_failure_trace" ((\ text => builder_output::failure_trace text) : string -> string)
    export "builder_split" ((\ text => builders::split_wire text) : string -> string)
    export "builder_deps" ((\ text => builders::deps_wire text) : string -> string)
    export "host_language" ((\ text => targets::host_language text) : string -> string)
    export "host_extension" ((\ text => targets::host_extension text) : string -> string)
    export "is_cl_compiler" ((\ text => ? targets::is_cl text ?> "true" |: "false") : string -> string)
    export "gleam_strip_warnings" ((\ text => gleam_project::strip_warnings text) : string -> string)
    export "gleam_manifest" ((\ wire => gleam_project::manifest_wire wire) : string -> string)
    0i32
