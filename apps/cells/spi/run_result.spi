///- --package .
:# run_result static =
    :< testing
    :< json_tree
    :< json_value

:= (++) (left : string) (right : string) : string = left ^^ right

:< json_tree
:< json_value

:| output =
    | ValueOut : string
    | StdoutOut : string
    | StderrOut : string
    | HtmlOut : string
    | OtherOut

:~ output_of (tag : string) (body : string) : output =
    ? tag = "v"
    ?> ValueOut body
    |? tag = "o"
    ?> StdoutOut body
    |? tag = "e"
    ?> StderrOut body
    |? tag = "h"
    ?> HtmlOut body
    |: OtherOut

:~ ^ outputs_from (wire : string) (i : i32) (acc : list output) : list output =
    := colon = text::find_char wire i ':'
    ? i >= text::length wire || colon < 0i32
    ?> listm::rev acc
    |:
        := n = text::parse_i32 (text::slice_len wire (i + 1i32) (colon - i - 1i32))
        := item = output_of (text::slice_len wire i 1i32) (text::slice_len wire (colon + 1i32) n)
        outputs_from wire (colon + 1i32 + n) (item :: acc)

:~ value_of (o : output) : list string = ?= o ?| ValueOut v => [ v ] | _ => []

:~ printed_of (o : output) : list string = ?= o ?| StdoutOut t => [ t ] | StderrOut t => [ t ] | _ => []

:~ html_of (o : output) : list string = ?= o ?| HtmlOut h => [ h ] | _ => []

:= gather (pick : output -> list string) (outputs : list output) : list string =
    listm::fold (\ acc o => listm::append (listm::rev (pick o)) acc) [] outputs |> listm::rev

:~ field (tag : string) (body : string) : string = tag ++ text::show_i32 (text::length body) ++ ":" ++ body

:~ value_field (values : list string) : string =
    ?= values ?|
    | [] => "n0:"
    | _ => field "v" (sm'::concat_list "\n" values)

:~ fields_wire (outputs : list output) : string =
    := html = listm::map (field "h") (gather html_of outputs)
    value_field (gather value_of outputs)
    ++ field "o" (sm'::concat_list "" (gather printed_of outputs))
    ++ sm'::concat_list "" html

:~ result_fields_wire (wire : string) : string = fields_wire (outputs_from wire 0i32 [])

///> gleam
:# values_join_with_newlines_and_streams_concatenate =
    result_fields_wire "v1:ao3:x\nye1:!v2:bch3:<p>x5:12345" |> _assert_eq "v4:a\nbco4:x\ny!h3:<p>"

///> gleam
:# no_value_is_marked_and_html_keeps_its_order =
    result_fields_wire "h1:1o0:h1:2" |> _assert_eq "n0:o0:h1:1h1:2"

///> gleam
:# an_empty_wire_has_no_value_and_no_output =
    result_fields_wire "" |> _assert_eq "n0:o0:"

:~ json_truthy (v : json) : bool =
    ?= v ?|
    | JNull => !-
    | JBool b => b
    | _ => !+

:~ truthy (v : option json) : bool =
    ?= v ?|
    | Some x => json_truthy x
    | None => !-

:~ got (key : string) (row : json) : json = ?= json_tree::field key row ?| Some v => v | None => JNull

:~ row_text (key : string) (row : json) : string = ?= json_tree::field key row ?| Some (JStr t) => t | _ => ""

:~ failed (row : json) : bool = row_text "status" row = "failed"

:~ has (key : string) (row : json) : bool = truthy (json_tree::field key row)

:~ keyed (keep : json -> bool) (pick : json -> json) (rows : list json) : json =
    JObj (rows |> listm'::filter keep |> listm::map (\ r => (row_text "name" r, pick r)))

:~ failing_targets (row : json) : list json =
    ?= json_tree::field "targets" row ?|
    | Some (JArr ts) => ts |> listm'::filter failed |> listm::map (got "target")
    | _ => []

:~ target_failures (row : json) : list (string * json) =
    ?= failing_targets row ?|
    | [] => []
    | ts => [ (row_text "name" row, JArr ts) ]

:~ unsupported_of (row : json) : list json =
    ?= json_tree::field "targets" row ?|
    | Some (JArr ts) => ts |> listm'::filter (\ t => row_text "status" t = "unsupported") |> listm::map (got "target")
    | _ => []

:~ target_unsupported (row : json) : list (string * json) =
    ?= unsupported_of row ?|
    | [] => []
    | ts => [ (row_text "name" row, JArr ts) ]

:~ mismatch (row : json) : json = JObj [ ("actual", got "actual" row); ("expected", got "expected" row) ]

:~ joined_lines (v : option json) : string =
    ?= v ?|
    | Some (JStr t) => t
    | Some (JArr xs) => sm'::concat_list "" (listm::map (\ x => ?= x ?| JStr t => t | _ => "") xs)
    | _ => ""

:~ present (v : option json) : bool = ?= v ?| Some _ => !+ | None => !-

:~ pre_output (kind : string) (body : string) : string = "<pre class=\"output" ++ kind ++ "\">" ++ html_page::html_escape body ++ "</pre>\n"

:~ data_html (data : json) : string =
    := mime (m : string) : option json = json_tree::field m data
    ? present (mime "image/svg+xml")
    ?> "<div class=\"plot\">" ++ joined_lines (mime "image/svg+xml") ++ "</div>\n"
    |? present (mime "text/html")
    ?> "<div class=\"html\">" ++ joined_lines (mime "text/html") ++ "</div>\n"
    |? present (mime "image/png")
    ?> "<img class=\"plot\" alt=\"\" src=\"data:image/png;base64," ++ text::trim (joined_lines (mime "image/png")) ++ "\">\n"
    |? present (mime "text/plain")
    ?> pre_output "" (joined_lines (mime "text/plain"))
    |: ""

:~ output_html (output_json : string) : string =
    ?= json_tree::parse output_json ?|
    | Some o ?& present (json_tree::field "text" o) => pre_output "" (joined_lines (json_tree::field "text" o))
    | Some o ?& present (json_tree::field "traceback" o) => pre_output " error" (joined_lines (json_tree::field "traceback" o))
    | Some o => ?= json_tree::field "data" o ?| Some d => data_html d | None => ""
    | None => ""

///> gleam
:# a_stream_and_a_plain_value_render_as_escaped_output_blocks =
    (output_html "{\"output_type\":\"stream\",\"text\":[\"1 < 2\\n\",\"x\"]}", output_html "{\"data\":{\"text/plain\":\"a&b\"}}")
    |> _assert_eq ("<pre class=\"output\">1 &lt; 2\nx</pre>\n", "<pre class=\"output\">a&amp;b</pre>\n")

///> gleam
:# an_error_output_renders_its_traceback_instead_of_vanishing =
    output_html "{\"output_type\":\"error\",\"ename\":\"SpiralError\",\"evalue\":\"bad\",\"traceback\":[\"bad <x>\\n\",\"at 2\"]}"
    |> _assert_eq "<pre class=\"output error\">bad &lt;x&gt;\nat 2</pre>\n"

///> gleam
:# svg_wins_over_html_png_and_plain_and_each_rich_kind_renders_inline =
    := d (body : string) = output_html ("{\"output_type\":\"display_data\",\"data\":{" ++ body ++ "}}")
    (d "\"text/plain\":\"p\",\"image/svg+xml\":[\"<svg/>\"]", d "\"text/html\":\"<b>b</b>\"", d "\"image/png\":\"iVBO\\n\"")
    |> _assert_eq ("<div class=\"plot\"><svg/></div>\n", "<div class=\"html\"><b>b</b></div>\n", "<img class=\"plot\" alt=\"\" src=\"data:image/png;base64,iVBO\">\n")

///> gleam
:# an_unknown_or_broken_output_renders_nothing =
    (output_html "{\"output_type\":\"display_data\",\"data\":{\"application/x\":\"z\"}}", output_html "{}", output_html "not json")
    |> _assert_eq ("", "", "")

:~ ms_text (ms : i32) : string =
    ? ms < 1000i32
    ?> text::show_i32 ms ++ " ms"
    |: text::show_i32 (ms / 1000i32) ++ "." ++ text::show_i32 ((ms - ms / 1000i32 * 1000i32) / 100i32) ++ " s"

:~ ms_of (v : option json) : option i32 =
    ?= v ?|
    | Some (JNum n) ?& text::length n > 0i32 && json_tree::digits_end n 0i32 = text::length n => Some (text::parse_i32 n)
    | _ => None

:~ timed (label : string) (v : option json) : list string = ?= ms_of v ?| Some ms => [ label ++ ms_text ms ] | None => []

:~ phase_parts (phases : option json) : list string =
    ?= phases ?|
    | Some (JObj members) => listm'::collect (\ (k, v) => timed (k ++ " ") (Some v)) members
    | _ => []

:~ target_part (t : json) : list string =
    ?= json_tree::field "target" t ?|
    | Some (JStr name) => [ name ++ " " ++ row_text "status" t ++ sm'::concat_list "" (timed " " (json_tree::field "ms" t)) ]
    | _ => []

:~ targets_of (test : json) : list json = ?= json_tree::field "targets" test ?| Some (JArr ts) => ts | _ => []

:~ badge_html (test : json) : string =
    ?= (json_tree::field "name" test, json_tree::field "status" test) ?|
    | (Some (JStr name), Some (JStr status)) =>
        := kind = ? status = "passed" || status = "failed" ?> status |: "other"
        "<span class=\"badge " ++ kind ++ "\">test " ++ html_page::html_escape name ++ ": " ++ html_page::html_escape status ++ "</span>\n"
    | _ => ""

:~ meta_html (parts : list string) : string =
    ?= parts ?|
    | [] => ""
    | _ => "<div class=\"meta\">" ++ html_page::html_escape (sm'::concat_list " · " parts) ++ "</div>\n"

:~ cell_head_html (metadata_json : string) : string =
    := m = ?= json_tree::parse metadata_json ?| Some v => v | None => JObj []
    := test = ?= json_tree::field "spiral_test" m ?| Some t => t | None => JObj []
    := targets = listm'::collect target_part (targets_of test)
    badge_html test ++ meta_html (listm::append (timed "" (json_tree::field "duration_ms" m)) (listm::append (phase_parts (json_tree::field "phases_ms" m)) targets))

///> gleam
:# a_test_cell_head_keeps_the_old_badge_and_adds_its_timings =
    := m = "{\"duration_ms\":2150,\"phases_ms\":{\"compile\":1400,\"run\":7},\"spiral_test\":{\"name\":\"a<b\",\"status\":\"passed\",\"targets\":[{\"target\":\"rust\",\"status\":\"passed\",\"ms\":12}]}}"
    cell_head_html m
    |> _assert_eq "<span class=\"badge passed\">test a&lt;b: passed</span>\n<div class=\"meta\">2.1 s · compile 1.4 s · run 7 ms · rust passed 12 ms</div>\n"

///> gleam
:# a_cell_without_test_or_timings_has_no_head_and_odd_statuses_read_other =
    (cell_head_html "{\"language\":\"spiral\"}", cell_head_html "", cell_head_html "{\"spiral_test\":{\"name\":\"t\",\"status\":\"skipped\"}}")
    |> _assert_eq ("", "", "<span class=\"badge other\">test t: skipped</span>\n")

///> gleam
:# timings_print_ms_below_a_second_and_tenths_above =
    (ms_text 0i32, ms_text 999i32, ms_text 1000i32, ms_text 61999i32) |> _assert_eq ("0 ms", "999 ms", "1.0 s", "61.9 s")

:~ exact_decimals (slowest : i32) (timeout : i32) : string =
    := opts = erlang_term::list_term [ erlang_term::tuple [ erlang_term::atom "decimals"; erlang_term::of 70i32 ] ]
    := ratio = erlang_term::apply "erlang" "/" [ erlang_term::of slowest; erlang_term::of timeout ]
    erlang_term::apply "erlang" "float_to_binary" [ ratio; opts ] |> erlang_term::cast

:~ digit_of (s : string) (i : i32) : i32 = ? i < text::length s ?> text::byte_at s i - 48i32 |: 0i32

:~ hundredths (exact : string) : i32 =
    := dot = text::find_from exact "." 0i32
    := whole = text::parse_i32 (text::slice_len exact 0i32 dot)
    := up = ? digit_of exact (dot + 3i32) >= 5i32 ?> 1i32 |: 0i32
    whole * 100i32 + digit_of exact (dot + 1i32) * 10i32 + digit_of exact (dot + 2i32) + up

:~ short_hundredths (k : i32) : string =
    := whole = text::show_i32 (k / 100i32)
    := frac = k - k / 100i32 * 100i32
    ? frac = 0i32 ?> whole ++ ".0"
    |? frac - frac / 10i32 * 10i32 = 0i32 ?> whole ++ "." ++ text::show_i32 (frac / 10i32)
    |? frac < 10i32 ?> whole ++ ".0" ++ text::show_i32 frac
    |: whole ++ "." ++ text::show_i32 frac

:~ headroom_text (slowest : i32) (timeout : i32) : string =
    short_hundredths (hundredths (exact_decimals slowest timeout))

///> gleam
:# headroom_matches_elixir_float_round_on_ties_and_trailing_zeros =
    (headroom_text 1i32 8i32, headroom_text 3i32 200i32, headroom_text 67i32 200i32, headroom_text 1i32 1i32)
    |> _assert_eq ("0.13", "0.01", "0.34", "1.0")
    (headroom_text 1i32 2i32, headroom_text 7i32 100i32, headroom_text 0i32 5i32, headroom_text 1234i32 100i32)
    |> _assert_eq ("0.5", "0.07", "0.0", "12.34")

:~ ^ text_before_from (a : string) (b : string) (i : i32) : bool =
    ? i >= text::length a ?> i < text::length b
    |? i >= text::length b ?> !-
    |? text::byte_at a i <> text::byte_at b i ?> text::byte_at a i < text::byte_at b i
    |: text_before_from a b (i + 1i32)

:~ key_before ((ka, _) : string * json) ((kb, _) : string * json) : bool = text_before_from ka kb 0i32

:~ ^ sorted_json (v : json) : json =
    ?= v ?|
    | JObj members => JObj (list_sort::sorted_by key_before (listm::map (\ (k, x) => (k, sorted_json x)) members))
    | JArr items => JArr (listm::map sorted_json items)
    | other => other

:~ short_escape (c : i32) : string =
    := slash (letter : string) = "\\" ++ letter
    ? c = 8i32 ?> slash "b" |? c = 9i32 ?> slash "t" |? c = 10i32 ?> slash "n" |? c = 12i32 ?> slash "f" |? c = 13i32 ?> slash "r"
    |: slash "u00" ++ text::one "0123456789ABCDEF" (c / 16i32) ++ text::one "0123456789ABCDEF" (c - c / 16i32 * 16i32)

:~ ^ elixir_quoted_from (s : string) (i : i32) (start : i32) (acc : string) : string =
    := c = ? i < text::length s ?> text::byte_at s i |: -1i32
    := chunk = text::slice_len s start (i - start)
    ? c < 0i32 ?> acc ++ chunk
    |? c = 34i32 || c = 92i32 ?> elixir_quoted_from s (i + 1i32) (i + 1i32) (acc ++ chunk ++ "\\" ++ text::one s i)
    |? c < 32i32 ?> elixir_quoted_from s (i + 1i32) (i + 1i32) (acc ++ chunk ++ short_escape c)
    |: elixir_quoted_from s (i + 1i32) start acc

:~ elixir_quoted (s : string) : string = "\"" ++ elixir_quoted_from s 0i32 0i32 "" ++ "\""

:~ ^ elixir_render (v : json) : string =
    ?= v ?|
    | JStr t => elixir_quoted t
    | JArr items => "[" ++ sm'::concat_list "," (listm::map elixir_render items) ++ "]"
    | JObj members => "{" ++ sm'::concat_list "," (listm::map (\ (k, x) => elixir_quoted k ++ ":" ++ elixir_render x) members) ++ "}"
    | other => json_tree::render other

:~ sorted_render (text : string) : string = ?= json_tree::parse text ?| Some v => elixir_render (sorted_json v) | None => ""

///> gleam
:# sorted_render_orders_keys_by_bytes_at_every_depth =
    sorted_render "{\"b\":1,\"a\":{\"z\":[{\"y\":2,\"x\":3}],\"B\":true},\"ab\":null}"
    |> _assert_eq "{\"a\":{\"B\":true,\"z\":[{\"x\":3,\"y\":2}]},\"ab\":null,\"b\":1}"
    := bs = "\\"
    := escaped = "{\"k\":\"a" ++ bs ++ "nb" ++ bs ++ "tc" ++ bs ++ "u0001" ++ bs ++ bs ++ "d\"}"
    sorted_render escaped |> _assert_eq escaped

:~ summary_fields (rows_json : string) : string =
    := rows = ?= json_tree::parse rows_json ?| Some (JArr items) => items | _ => []
    := failed_tests = JArr (rows |> listm'::filter failed |> listm::map (got "name"))
    := refused = keyed (has "accept_refused") (got "accept_refused") rows
    := targets = JObj (listm'::collect target_failures rows)
    := messages = keyed (\ r => failed r && has "message" r) (got "message") rows
    := mismatches = keyed (\ r => failed r && has "actual" r) mismatch rows
    := sites = keyed (has "accepted_site") (got "accepted_site") rows
    := unsupported = JObj (listm'::collect target_unsupported rows)
    json_tree::render
        (JObj
            [
                ("failed_tests", failed_tests)
                ("accept_refused", refused)
                ("failed_targets", targets)
                ("failed_messages", messages)
                ("mismatches", mismatches)
                ("accepted_sites", sites)
                ("unsupported_targets", unsupported)
            ])

:~ optional_target (optional : list string) (target : json) : bool =
    ?= target ?| JStr t => listm'::exists' (\ o => o = t) optional | _ => !-

:~ blocked_in (file : string) (optional : list string) ((test, targets) : string * json) : list string =
    ?= targets ?|
    | JArr ts =>
        ts
        |> listm'::filter (\ x => optional_target optional x |> not)
        |> listm::map (\ x => file ++ ": " ++ test ++ " needs " ++ (?= x ?| JStr t => t | _ => "?") ++ ", which is unsupported here")
    | _ => []

:~ gate_blocked_line (optional : list string) (line : string) : list string =
    := prefix = "spiral-tests file "
    ? text::starts_with line prefix |> not ?> [] |:
        ?= json_tree::parse (text::drop line (text::length prefix)) ?|
        | Some report =>
            ?= json_tree::field "unsupported_targets" report ?|
            | Some (JObj entries) => listm'::collect (blocked_in (row_text "file" report) optional) entries
            | _ => []
        | None => []

:~ gate_blocked (optional_text : string) (lines : list string) : list string =
    := optional = sm'::split_list "," optional_text |> listm'::filter (\ o => o <> "")
    listm'::collect (gate_blocked_line optional) lines

:~ num_text (key : string) (row : json) : option string =
    ?= json_tree::field key row ?| Some (JNum n) => Some n | _ => None

:~ source_file (path : string) (realm : string) : string =
    := n = text::length path
    ? realm = "real" && n >= 4i32 && text::drop path (n - 4i32) = ".spi" ?> text::slice_len path 0i32 (n - 4i32) ++ "_real.spir" |: path

:~ counts_members (rows : list json) : list (string * json) =
    := wire = sm'::concat_list "\n" (listm::map (\ r => sm'::concat_list "\t" [ row_text "status" r; row_text "memo" r; row_text "no_agree" r ]) rows)
    := lines = listm'::filter (\ l => l <> "") (sm'::split_list "\n" (verdicts::counts_wire wire))
    := reasons = listm'::collect (\ l => ?= sm'::split_list "\t" l ?| "no_agree" :: reason :: n :: [] => [ (reason, JNum n) ] | _ => []) lines
    := counts = listm'::collect (\ l => ?= sm'::split_list "\t" l ?| key :: n :: [] => [ (key, JNum n) ] | _ => []) lines
    listm::append counts [ ("no_agree_reasons", JObj reasons) ]

:~ float_of (t : string) : erlang_term::term = erlang_term::apply "erlang" "binary_to_float" [ erlang_term::of t ]

:~ ratio_of (r : json) : erlang_term::term =
    ?= (num_text "slowest_ms" r, num_text "timeout_ms" r) ?|
    | (Some s, Some t) => erlang_term::apply "erlang" "/" [ float_of (s ++ ".0"); float_of (t ++ ".0") ]
    | _ => float_of "0.0"

:~ greater (a : erlang_term::term) (b : erlang_term::term) : bool = erlang_term::apply "erlang" ">" [ a; b ] |> erlang_term::cast

:~ timed (r : json) : bool = ?= num_text "timeout_ms" r ?| Some t => t <> "0" && text::byte_at t 0i32 <> 45i32 | None => !-

:~ headroom_members (rows : list json) : list (string * json) =
    := pick = listm::fold (\ best r => ? timed r ?> (?= best ?| Some b ?& not (greater (ratio_of r) (ratio_of b)) => best | _ => Some r) |: best) None rows
    ?= pick ?|
    | Some r ?& num_text "slowest_ms" r <> None =>
        := s = ?= num_text "slowest_ms" r ?| Some v => v | None => "0"
        := t = ?= num_text "timeout_ms" r ?| Some v => v | None => "1"
        [ ("headroom", JNum (headroom_text (text::parse_i32 s) (text::parse_i32 t))); ("slowest_ms", JNum s); ("timeout_ms", JNum t) ]
    | _ => []

:~ file_object (file : string) (rows : list json) (with_headroom : bool) : json =
    := summary = ?= json_tree::parse (summary_fields (json_tree::render (JArr rows))) ?| Some (JObj m) => m | _ => []
    JObj (listm::append (counts_members rows) (listm::append [ ("file", JStr file) ] (listm::append summary (? with_headroom ?> headroom_members rows |: []))))

:~ ^ has_text (x : string) (xs : list string) : bool = ?= xs ?| y :: rest => y = x || has_text x rest | [] => !-

:~ files_of (path : string) (rows : list json) : list json =
    := named = listm::map (\ r => (source_file path (row_text "realm" r), r)) rows
    := names = listm::fold (\ acc (f, _) => ? has_text f acc ?> acc |: listm::append acc [ f ]) [] named
    ?= list_sort::sorted_by (\ a b => text_before_from a b 0i32) names ?|
    | [] => [ file_object path [] !- ]
    | sorted => listm::map (\ f => file_object f (listm'::collect (\ (g, r) => ? g = f ?> [ r ] |: []) named) !+) sorted

:~ count_of (key : string) (file : json) : i32 = ?= num_text key file ?| Some n => text::parse_i32 n | None => 0i32

:~ total_object (files : list json) : json =
    := keys = [ "discovered"; "executed"; "passed"; "failed"; "accepted"; "built"; "static"; "preludes"; "skipped"; "unsupported"; "filtered"; "not_run"; "memo_hits" ]
    := sums = listm::map (\ k => (k, JNum (text::show_i32 (listm::fold (\ n f => n + count_of k f) 0i32 files)))) keys
    := reason_of (f : json) : list (string * json) = ?= json_tree::field "no_agree_reasons" f ?| Some (JObj m) => m | _ => []
    := all = listm'::collect reason_of files
    := names = listm::fold (\ acc (k, _) => ? has_text k acc ?> acc |: listm::append acc [ k ]) [] all
    := merged = listm::map (\ k => (k, JNum (text::show_i32 (listm::fold (\ n (k2, v) => ? k2 = k ?> n + (?= v ?| JNum t => text::parse_i32 t | _ => 0i32) |: n) 0i32 all)))) names
    JObj (listm::append sums [ ("files", JNum (text::show_i32 (listm::length files))); ("no_agree_reasons", JObj merged) ])

:~ warning_of (warn : string) (f : json) : list string =
    ?= num_text "headroom" f ?|
    | Some h ?& not (greater (float_of warn) (float_of h)) =>
        := pick = ?= f ?| JObj m => listm'::filter (\ (k, _) => k = "file" || k = "headroom" || k = "slowest_ms" || k = "timeout_ms") m | _ => []
        [ "spiral-tests headroom " ++ elixir_render (sorted_json (JObj pick)) ]
    | _ => []

:~ summary_lines_json ((reports_json : string), (warn : string)) : string =
    := reports = ?= json_tree::parse reports_json ?| Some (JArr rs) => rs | _ => []
    := files = listm'::collect (\ rep => files_of (row_text "path" rep) (?= json_tree::field "tests" rep ?| Some (JArr ts) => ts | _ => [])) reports
    := file_lines = listm::map (\ f => "spiral-tests file " ++ elixir_render (sorted_json f)) files
    sm'::concat_list "\n" (listm::append file_lines (listm::append (listm'::collect (warning_of warn) files) [ "spiral-tests total " ++ elixir_render (sorted_json (total_object files)) ]))

:~ cell_text (v : option json) : string =
    ?= v ?| Some (JStr t) => t | Some (JNum n) => n | Some (JBool b) => (? b ?> "true" |: "false") | _ => ""

:~ metric_row (stem : string) (test : json) (target : json) : string =
    := f (key : string) (from : json) = cell_text (json_tree::field key from)
    sm'::concat_list "\t" [ stem; f "name" test; f "target" target; f "status" target; f "ms" target; f "memo" test ]

:~ metrics_tsv (reports_json : string) : string =
    := reports = ?= json_tree::parse reports_json ?| Some (JArr rs) => rs | _ => []
    := tests_of (rep : json) : list json = ?= json_tree::field "tests" rep ?| Some (JArr ts) => ts | _ => []
    := rows_of (rep : json) = listm'::collect (\ t => ? row_text "mode" t = "test" ?> listm::map (metric_row (row_text "stem" rep) t) (targets_of t) |: []) (tests_of rep)
    sm'::concat_list "\n" ("File\tTest\tTarget\tStatus\tMs\tMemo" :: listm'::collect rows_of reports) ++ "\n"

///> gleam
:# metrics_tsv_lists_every_target_of_every_test_mode_block =
    metrics_tsv "[{\"stem\":\"s\",\"tests\":[{\"name\":\"x\",\"mode\":\"static\",\"targets\":[]},{\"name\":\"g\",\"mode\":\"test\",\"memo\":\"hit\",\"targets\":[{\"target\":\"rust\",\"status\":\"passed\",\"ms\":812},{\"target\":\"zig\",\"status\":\"passed\",\"ms\":null}]}]}]"
    |> _assert_eq "File\tTest\tTarget\tStatus\tMs\tMemo\ns\tg\trust\tpassed\t812\thit\ns\tg\tzig\tpassed\t\thit\n"

///> gleam
:# an_empty_file_summarises_to_empty_fields =
    (summary_fields "[]", summary_fields "")
    |> _assert_eq ("{\"failed_tests\":[],\"accept_refused\":{},\"failed_targets\":{},\"failed_messages\":{},\"mismatches\":{},\"accepted_sites\":{},\"unsupported_targets\":{}}", "{\"failed_tests\":[],\"accept_refused\":{},\"failed_targets\":{},\"failed_messages\":{},\"mismatches\":{},\"accepted_sites\":{},\"unsupported_targets\":{}}")

///> gleam
:# summary_fields_keep_failed_rows_messages_with_tabs_targets_and_sites =
    := a = "{\"name\":\"a\",\"status\":\"failed\",\"message\":\"x\\ty\\nz\",\"actual\":\"1\",\"expected\":\"2\",\"targets\":[{\"target\":\"rust\",\"status\":\"failed\"},{\"target\":\"c\",\"status\":\"passed\"}]}"
    := b = "{\"name\":\"b\",\"status\":\"passed\",\"message\":\"ignored\",\"targets\":null,\"accepted_site\":false}"
    := c = "{\"name\":\"c\",\"status\":\"accepted\",\"accepted_site\":\"t.spi:4\",\"accept_refused\":null}"
    := d = "{\"name\":\"d\",\"status\":\"failed\",\"accept_refused\":\"exit-code step\",\"message\":null}"
    summary_fields ("[" ++ a ++ "," ++ b ++ "," ++ c ++ "," ++ d ++ "]")
    |> _assert_eq "{\"failed_tests\":[\"a\",\"d\"],\"accept_refused\":{\"d\":\"exit-code step\"},\"failed_targets\":{\"a\":[\"rust\"]},\"failed_messages\":{\"a\":\"x\\u0009y\\u000az\"},\"mismatches\":{\"a\":{\"actual\":\"1\",\"expected\":\"2\"}},\"accepted_sites\":{\"c\":\"t.spi:4\"},\"unsupported_targets\":{}}"

///> gleam
:# an_unsupported_target_is_named_in_the_summary =
    := a = "{\"name\":\"a\",\"status\":\"unsupported\",\"targets\":[{\"target\":\"cuda\",\"status\":\"unsupported\"},{\"target\":\"rust\",\"status\":\"passed\"}]}"
    summary_fields ("[" ++ a ++ "]")
    |> _assert_eq "{\"failed_tests\":[],\"accept_refused\":{},\"failed_targets\":{},\"failed_messages\":{},\"mismatches\":{},\"accepted_sites\":{},\"unsupported_targets\":{\"a\":[\"cuda\"]}}"

///> gleam
:# a_gate_blocks_an_unsupported_target_unless_it_is_listed_optional =
    := line = "spiral-tests file {\"file\":\"f.spi\",\"unsupported_targets\":{\"a\":[\"cuda\"]}}"
    (gate_blocked "" [ line; "other" ], gate_blocked "cuda" [ line ], gate_blocked "wgsl,cuda" [ line ])
    |> _assert_eq ([ "f.spi: a needs cuda, which is unsupported here" ], [], [])
