:# run_result static =
    :< testing

:= (++) (left : string) (right : string) : string = left ^^ right

:| output =
    | ValueOut : string
    | StdoutOut : string
    | StderrOut : string
    | HtmlOut : string
    | OtherOut

:= output_of (tag : string) (body : string) : output =
    ? tag = "v" ?> ValueOut body
    |? tag = "o" ?> StdoutOut body
    |? tag = "e" ?> StderrOut body
    |? tag = "h" ?> HtmlOut body
    |: OtherOut

:~ ^ outputs_from (wire : string) (i : i32) (acc : list output) : list output =
    := colon = text::find_char wire i ':'
    ? i >= text::length wire || colon < 0i32 ?> listm::rev acc
    |:
        := n = text::parse_i32 (text::slice_len wire (i + 1i32) (colon - i - 1i32))
        := item = output_of (text::slice_len wire i 1i32) (text::slice_len wire (colon + 1i32) n)
        outputs_from wire (colon + 1i32 + n) (item :: acc)

:= value_of (o : output) : list string = ?= o ?| ValueOut v => [ v ] | _ => []

:= printed_of (o : output) : list string = ?= o ?| StdoutOut t => [ t ] | StderrOut t => [ t ] | _ => []

:= html_of (o : output) : list string = ?= o ?| HtmlOut h => [ h ] | _ => []

:= gather (pick : output -> list string) (outputs : list output) : list string =
    listm::fold (\ acc o => listm::append (listm::rev (pick o)) acc) [] outputs |> listm::rev

:= field (tag : string) (body : string) : string = tag ++ text::show_i32 (text::length body) ++ ":" ++ body

:= value_field (values : list string) : string = ?= values ?| [] => "n0:" | _ => field "v" (sm'::concat_list "\n" values)

:= fields_wire (outputs : list output) : string =
    := html = listm::map (field "h") (gather html_of outputs)
    value_field (gather value_of outputs) ++ field "o" (sm'::concat_list "" (gather printed_of outputs)) ++ sm'::concat_list "" html

:= result_fields_wire (wire : string) : string = fields_wire (outputs_from wire 0i32 [])

///> zig
:# values_join_with_newlines_and_streams_concatenate =
    result_fields_wire "v1:ao3:x\nye1:!v2:bch3:<p>x5:12345" |> _assert_eq "v4:a\nbco4:x\ny!h3:<p>"

///> zig
:# no_value_is_marked_and_html_keeps_its_order =
    result_fields_wire "h1:1o0:h1:2" |> _assert_eq "n0:o0:h1:1h1:2"

///> zig
:# an_empty_wire_has_no_value_and_no_output =
    result_fields_wire "" |> _assert_eq "n0:o0:"
