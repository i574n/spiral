:| target =
    | RustTarget
    | FsharpTarget
    | TypescriptTarget
    | PythonTarget
    | CudaTarget
    | CppTarget
    | GleamTarget
    | LuaTarget
    | CTarget
    | DelphiTarget
    | ZigTarget
    | LeanTarget
    | WgslTarget

:= target_of (tool : string) : option target =
    ? tool = "rust" ?> Some RustTarget
    |? tool = "fsharp" ?> Some FsharpTarget
    |? tool = "typescript" ?> Some TypescriptTarget
    |? tool = "python" ?> Some PythonTarget
    |? tool = "cuda" ?> Some CudaTarget
    |? tool = "cpp" ?> Some CppTarget
    |? tool = "gleam" ?> Some GleamTarget
    |? tool = "lua" ?> Some LuaTarget
    |? tool = "c" ?> Some CTarget
    |? tool = "delphi" ?> Some DelphiTarget
    |? tool = "zig" ?> Some ZigTarget
    |? tool = "lean" ?> Some LeanTarget
    |? tool = "wgsl" ?> Some WgslTarget
    |: None

:= backend_name (t : target) : string =
    ?= t ?|
    | RustTarget => "Rust"
    | FsharpTarget => "Fsharp"
    | TypescriptTarget => "TypeScript"
    | PythonTarget => "Python + Cuda"
    | CudaTarget => "Python + Cuda"
    | CppTarget => "Cpp + Cuda"
    | GleamTarget => "Gleam"
    | LuaTarget => "Lua"
    | CTarget => "C"
    | DelphiTarget => "Delphi"
    | ZigTarget => "Zig"
    | LeanTarget => "Lean"
    | WgslTarget => "Wgsl"

:= extension_name (t : target) : string =
    ?= t ?|
    | RustTarget => ".rs"
    | FsharpTarget => ".fsx"
    | TypescriptTarget => ".ts"
    | PythonTarget => ".py"
    | CudaTarget => ".py"
    | CppTarget => ".cpp"
    | GleamTarget => ".gleam"
    | LuaTarget => ".lua"
    | CTarget => ".c"
    | DelphiTarget => ".pas"
    | ZigTarget => ".zig"
    | LeanTarget => ".lean"
    | WgslTarget => ".wgsl"

:= backend (t : option target) : string =
    ?= t ?|
    | Some t => backend_name t
    | None => ""

:= extension (t : option target) : string =
    ?= t ?|
    | Some t => extension_name t
    | None => ""

/// ## host cells: languages Cells runs directly, without a Spiral build
:| host =
    | FsiHost
    | PythonHost
    | LuaHost
    | JavascriptHost
    | PowershellHost

:= host_of (language : string) : option host =
    ? language = "fsharp" || language = "fs" ?> Some FsiHost
    |? language = "python" || language = "py" ?> Some PythonHost
    |? language = "lua" ?> Some LuaHost
    |? language = "javascript" || language = "js" ?> Some JavascriptHost
    |? language = "powershell" || language = "pwsh" ?> Some PowershellHost
    |: None

:= host_name (h : host) : string =
    ?= h ?|
    | FsiHost => "fsharp"
    | PythonHost => "python"
    | LuaHost => "lua"
    | JavascriptHost => "javascript"
    | PowershellHost => "powershell"

:= host_file_extension (h : host) : string =
    ?= h ?|
    | FsiHost => ".fsx"
    | PythonHost => ".py"
    | LuaHost => ".lua"
    | JavascriptHost => ".js"
    | PowershellHost => ".ps1"

:= host_language (language : string) : string =
    ?= host_of (text::lowercase language) ?|
    | Some h => host_name h
    | None => ""

:= host_extension (name : string) : string =
    ?= host_of name ?|
    | Some h => host_file_extension h
    | None => ""

:~ ^ without_exe (s : string) : string =
    ? text::length s >= 4i32 && text::starts_at s (text::length s - 4i32) ".exe" ?> without_exe (text::take s (text::length s - 4i32)) |: s

:= is_cl (basename : string) : bool = without_exe (text::lowercase basename) = "cl"
