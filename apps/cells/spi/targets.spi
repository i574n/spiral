:| target =
    | RustTarget
    | FsharpTarget
    | TypescriptTarget
    | PythonTarget
    | CudaTarget
    | CppTarget
    | GleamTarget
    | LuaTarget
    | CTarget
    | DelphiTarget
    | ZigTarget
    | LeanTarget
    | WgslTarget
    | UnknownTarget

:= target_of (tool : string) : target =
    ? tool = "rust" ?> RustTarget
    |? tool = "fsharp" ?> FsharpTarget
    |? tool = "typescript" ?> TypescriptTarget
    |? tool = "python" ?> PythonTarget
    |? tool = "cuda" ?> CudaTarget
    |? tool = "cpp" ?> CppTarget
    |? tool = "gleam" ?> GleamTarget
    |? tool = "lua" ?> LuaTarget
    |? tool = "c" ?> CTarget
    |? tool = "delphi" ?> DelphiTarget
    |? tool = "zig" ?> ZigTarget
    |? tool = "lean" ?> LeanTarget
    |? tool = "wgsl" ?> WgslTarget
    |: UnknownTarget

:= backend (t : target) : string =
    ?= t ?|
    | RustTarget => "Rust"
    | FsharpTarget => "Fsharp"
    | TypescriptTarget => "TypeScript"
    | PythonTarget => "Python + Cuda"
    | CudaTarget => "Python + Cuda"
    | CppTarget => "Cpp + Cuda"
    | GleamTarget => "Gleam"
    | LuaTarget => "Lua"
    | CTarget => "C"
    | DelphiTarget => "Delphi"
    | ZigTarget => "Zig"
    | LeanTarget => "Lean"
    | WgslTarget => "Wgsl"
    | UnknownTarget => ""

:= extension (t : target) : string =
    ?= t ?|
    | RustTarget => ".rs"
    | FsharpTarget => ".fsx"
    | TypescriptTarget => ".ts"
    | PythonTarget => ".py"
    | CudaTarget => ".py"
    | CppTarget => ".cpp"
    | GleamTarget => ".gleam"
    | LuaTarget => ".lua"
    | CTarget => ".c"
    | DelphiTarget => ".pas"
    | ZigTarget => ".zig"
    | LeanTarget => ".lean"
    | WgslTarget => ".wgsl"
    | UnknownTarget => ""
