  "profile": "x",
  "post": {
    "weight_limit": 280,
    "link_weight": 23
  },
  "code_point_weight": {
    "default": 2,
    "ranges": [
      [
        0,
        4351,
        1
      ],
      [
        8192,
        8205,
        1
      ],
      [
        8208,
        8223,
        1
      ],
      [
        8242,
