:! sample_a = ()
:! hg38 = ()
:! chr1 = ()
:! fingerprint_a = ()
:! fingerprint_b = ()
:! app_scope = ()
:! epoch1 = ()
:! sealed = ()
:! live = ()

:| chain_authority fingerprint state =
    | ChainAuthority :: \* fingerprint state. string -> chain_authority fingerprint state

:| genome_batch sample build contig fingerprint =
    | GenomeBatch :: \* sample build contig fingerprint. string -> genome_batch sample build contig fingerprint

:| resource scope epoch sample build contig fingerprint state =
    | Resource :: \* scope epoch sample build contig fingerprint state.
        string ->
        resource scope epoch sample build contig fingerprint state

:= publish \* scope epoch sample build contig fingerprint.
    (authority : chain_authority fingerprint sealed)
    (batch : genome_batch sample build contig fingerprint)
    : resource scope epoch sample build contig fingerprint live =
    ?= authority, batch ?|
    | ChainAuthority _, GenomeBatch label => Resource label

:= main () =
    := stale : chain_authority fingerprint_b sealed = ChainAuthority "stale"
    := batch : genome_batch sample_a hg38 chr1 fingerprint_a = GenomeBatch "variants"
    := resource : resource app_scope epoch1 sample_a hg38 chr1 fingerprint_a live = publish stale batch
    resource
