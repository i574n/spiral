:! root_a = ()
:! root_b = ()
:! signer_a = ()
:! fingerprint_a = ()
:! sample_a = ()
:! hg38 = ()
:! chr1 = ()
:! scope_a = ()
:! epoch1 = ()
:! verified = ()
:! mounted = ()
:| rooted_authority root signer fingerprint state =
    | RootedAuthority :: \* root signer fingerprint state. string -> rooted_authority root signer fingerprint state
:| genome_resource root signer fingerprint sample build contig =
    | GenomeResource :: \* root signer fingerprint sample build contig.
        string ->
        genome_resource root signer fingerprint sample build contig
:| dashboard scope epoch root state =
    | Dashboard :: \* scope epoch root state. string -> dashboard scope epoch root state
:= mount \* root signer fingerprint sample build contig scope epoch.
    (authority : rooted_authority root signer fingerprint verified)
    (resource : genome_resource root signer fingerprint sample build contig)
    (dashboard : dashboard scope epoch root mounted)
    : string
    =
    "mounted"
:= main () =
    := authority : rooted_authority root_a signer_a fingerprint_a verified = RootedAuthority "authority"
    := resource : genome_resource root_a signer_a fingerprint_a sample_a hg38 chr1 = GenomeResource "resource"
    := stale_dashboard : dashboard scope_a epoch1 root_b mounted = Dashboard "stale"
    mount authority resource stale_dashboard
