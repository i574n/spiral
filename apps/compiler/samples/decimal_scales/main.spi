:! amount currency scale = i64

:! qty uom scale = i64

:! brl = ()

:! litre = ()

:= times \* u c s1 s2. ((qty q) : qty u s1) ((amount p) : amount c s2) : amount c (type_arith::add s1 s2) = amount (q * p)

:~ ^ pow10 (n : i32) (acc : i64) : i64 = ? n <= 0i32 ?> acc |: pow10 (n - 1i32) (acc * 10i64)

:= rescale \* c s_from s_to. ((amount x) : amount c s_from) : amount c s_to =
    := from : i32 = ~> real_core::type_lit_to_lit `s_from
    := to : i32 = ~> real_core::type_lit_to_lit `s_to
    := d = pow10 (from - to) 1i64
    amount ((x + d / 2i64) / d)

:= main () : i32 =
    := litres : qty litre 4i32 = qty 425000i64
    := price : amount brl 10i32 = amount 17350000000i64
    := (amount cents) : amount brl 2i32 = rescale (times litres price)
    conv cents
