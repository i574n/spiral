///> rust
///> fsharp
///> gleam
:# corpus_v1_lists_every_frozen_file_once_with_a_full_sha256 =
    := c = corpus_v1 ()
    (listm.length c : i32, listm'.filter (\ (x : corpus_file) => (sm'.length x.sha256 : i32) <> 64) c |> listm.length : i32)
    |> _assert_eq (79, 0)
