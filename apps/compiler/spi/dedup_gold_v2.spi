///> rust
///> fsharp
///> gleam
:# gold_v2_holds_every_judged_site_once =
    := g = gold_v2 ()
    (listm::length g, count_if (\ (r : gold_row) => must_not_flag r.verdict) g, count_if (\ (r : gold_row) => lib_target_of r.verdict <> "") g)
    |> _assert_eq (484, 9, 170)
