:| associativity = AssocNone | AssocLeft | AssocRight

:~ inbuilt_operators (x : string) : option (i32 * associativity) =
    ? x = "+" || x = "-" ?> Some (60, AssocLeft)
    |? x = "*" || x = "/" || x = "%" ?> Some (70, AssocLeft)
    |? x = "</>" ?> Some (43, AssocLeft)
    |? x = "<|>" ?> Some (42, AssocLeft)
    |? x = "|>" || x = "||>" || x = "|||>" ?> Some (41, AssocLeft)
    |? x = ">>" || x = "<<" ?> Some (45, AssocLeft)
    |? x = "<-" ?> Some (4, AssocLeft)
    |? x = "<=" || x = "<" || x = "=" || x = "`=" || x = ">" || x = ">=" || x = "<>" ?> Some (40, AssocNone)
    |? x = "<<<" || x = ">>>" || x = "&&&" || x = "|||" ?> Some (40, AssocNone)
    |? x = "||" ?> Some (20, AssocLeft)
    |? x = "&&" ?> Some (30, AssocLeft)
    |? x = "::" ?> Some (50, AssocRight)
    |? x = "^" ?> Some (45, AssocRight)
    |? x = "<|" ?> Some (41, AssocRight)
    |? x = "." ?> Some (2, AssocRight)
    |? x = "," ?> Some (6, AssocRight)
    |? x = ":>" || x = ":?>" ?> Some (35, AssocRight)
    |? x = "**" ?> Some (80, AssocRight)
    |: None

:~ ^ precedence_associativity (name : string) : option (i32 * associativity) =
    := n = (sm'::length name : i32)
    ? n = 0 ?> None
    |? n > 1 && sm'::index 0i32 name = '.' ?> precedence_associativity (sm'::slice 1 (n - 1) name)
    |? n = 1 ?> inbuilt_operators name
    |:
        ?= inbuilt_operators name ?|
        | Some found => Some found
        | None => precedence_associativity (sm'::slice 0 (n - 2) name)

:~ is_separator (x : string) : bool = x = "=>" || x = "|" || x = ":" || x = ";"

:~ assoc_word (a : associativity) : string =
    ?= a ?|
    | AssocNone => "N"
    | AssocLeft => "L"
    | AssocRight => "R"

:~ shown (name : string) : string =
    ?= precedence_associativity name ?|
    | Some (p, a) => sm'::format p ++# assoc_word a
    | None => "none"

///> rust
///> fsharp
///> gleam
:# operator_precedence_strips_dots_and_trailing_chars_like_the_reference =
    listm::map shown [ "+"; ".+"; "+++"; "|>>"; "<=>"; "."; ".."; "^^"; "**"; "abc"; "::" ]
    |> _assert_eq [ "60L"; "60L"; "60L"; "41L"; "40N"; "2R"; "2R"; "45R"; "80R"; "none"; "50R" ]

///> rust
///> fsharp
///> gleam
:# op_of_name_finds_every_case_by_its_reference_name =
    (op_of_name "StringLength", op_of_name "SizeOf", op_of_name "ToFunPtr", op_of_name "Nope") |> _assert_eq (Some StringLength, Some SizeOf, Some ToFunPtr, None)
