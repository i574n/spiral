///- --package .
:< sm'_operators

:# terms static =
    :< testing

:== term_env = { top_down : bool; operator_floor : option i32; continuation_column : option i32; default_int : ast::prim_type; default_float : ast::prim_type; upstream : bool }

:~ top_env () : term_env = { top_down = !+; operator_floor = None; continuation_column = None; default_int = ast::Int32T; default_float = ast::Float64T; upstream = !- }

:~ lowest_binding () : i32 = -1000000i32

:~ annot_flags (e : term_env) : parse_types::type_flags = { allow_wildcard = e::top_down; allow_typecase_metavars = !-; allow_term = e::top_down = !- }

:~ floor_or_col (floor : option i32) (c : cursor::cursor) : i32 =
    := at = parse_types::col c
    ?= floor ?|
    | Some f => ? f < at ?> f |: at
    | None => at

:~ joined_exprs (a : ast::raw_expr) (b : ast::raw_expr) : ast::range = ast::joined (ast::range_of_expr a) (ast::range_of_expr b)

:~ ^ fold_apply (a : ast::raw_expr) (xs : list ast::raw_expr) : ast::raw_expr =
    ?= xs ?|
    | [] => a
    | b :: rest => fold_apply (ast::RawApply (joined_exprs a b, a, b)) rest

:~ ^ fold_tuple (a : ast::raw_expr) (xs : list ast::raw_expr) : ast::raw_expr =
    ?= xs ?|
    | [] => a
    | b :: rest => fold_tuple (ast::RawPair (joined_exprs a b, a, b)) rest

:~ tuple_of (xs : list ast::raw_expr) (r : ast::range) : ast::raw_expr =
    ?= xs ?|
    | [] => ast::RawB r
    | x :: rest => fold_tuple x rest

:~ ^ fold_list (r : ast::range) (xs : list ast::raw_expr) : ast::raw_expr =
    ?= xs ?|
    | [] => ast::rawv (r, "Nil")
    | a :: rest => ast::RawApply (r, ast::rawv (r, "Cons"), ast::RawPair (r, a, fold_list r rest))

:~ ^ fold_seq (xs : list ast::raw_expr) : ast::raw_expr =
    ?= xs ?|
    | [ x ] => x
    | a :: rest =>
        := b = fold_seq rest
        ast::RawSeq (joined_exprs a b, a, b)
    | [] => ast::RawB (cursor::origin ())

:~ ^ concat_lists (xs : list (list ast::raw_expr)) : list ast::raw_expr =
    ?= xs ?|
    | [] => []
    | a :: rest => listm::append a (concat_lists rest)

:~ ^ collect_args (args : list ast::raw_expr) (x : ast::raw_expr) : ast::raw_expr * list ast::raw_expr =
    ?= x ?|
    | ast::RawApply (_, f, a) => collect_args (a :: args) f
    | f => f, args

:~ apply_operator (parsed : ast::parsed_operator) (left : ast::raw_expr) (right : ast::raw_expr) : ast::raw_expr =
    := r = joined_exprs left right
    ?= parsed ?|
    | ast::ParsedSequence => ast::RawSeq (r, left, right)
    | ast::ParsedAnd s => ast::RawIfThenElse (r, left, right, ast::RawLit (s, tokens::LitBool !-))
    | ast::ParsedOr s => ast::RawIfThenElse (r, left, ast::RawLit (s, tokens::LitBool !+), right)
    | ast::ParsedPair => ast::RawPair (r, left, right)
    | ast::ParsedStringConcat => ast::RawAnnot (r, ast::RawOp (r, ops::StaticStringConcat, [ left; right ]), ast::RawTPrim (r, ast::StringT))
    | ast::ParsedHeapMutableSet =>
        := (target, args) = collect_args [] left
        ast::RawHeapMutableSet (r, target, args, right)
    | ast::ParsedNamed (s, name) => ast::RawApply (r, ast::RawApply (ast::joined r s, ast::rawv (s, name), left), right)

:~ read_operator (c : cursor::cursor) : cursor::step (i32 * ops::associativity * ast::parsed_operator) =
    ?= cursor::current c ?|
    | Some (r, tokens::TokOperator (x, _)) =>
        ? ops::is_separator x ?> cursor::Failed ([], c)
        |:
            ?= ops::precedence_associativity x ?|
            | Some (p, a) => cursor::Took ((p, a, ast::parsed_of r x), cursor::advance c)
            | None => cursor::Failed ([ (r, ast::UnknownOperator) ], cursor::advance c)
    | Some (r, _) => cursor::Failed ([ (r, ast::ExpectedAnyOperator) ], c)
    | None => cursor::Failed ([], c)

:~ parsed_default \* t. (r : ast::range) (x : string) (literal_of : t -> tokens::literal) (description : string) (after : cursor::cursor) : cursor::step tokens::literal =
    ?= convert::try_convert x ?|
    | Some value => cursor::Took (literal_of value, after)
    | None => cursor::Failed ([ (r, ast::BottomUpNumberParseError (x, description)) ], after)

:~ bottom_up_number (e : term_env) (r : ast::range) (x : string) (after : cursor::cursor) : cursor::step tokens::literal =
    ? sm'::contains "." x ?>
        ?= e::default_float ?|
        | ast::Float32T => parsed_default r x (\ (v : f32) => tokens::LitFloat32 v) "f32" after
        | ast::Float64T => parsed_default r x (\ (v : f64) => tokens::LitFloat64 v) "f64" after
        | _ => failwith "Compiler error: Invalid default float type."
    |:
        ?= e::default_int ?|
        | ast::Int8T => parsed_default r x (\ (v : i8) => tokens::LitInt8 v) "i8" after
        | ast::Int16T => parsed_default r x (\ (v : i16) => tokens::LitInt16 v) "i16" after
        | ast::Int32T => parsed_default r x (\ (v : i32) => tokens::LitInt32 v) "i32" after
        | ast::Int64T => parsed_default r x (\ (v : i64) => tokens::LitInt64 v) "i64" after
        | ast::UInt8T => parsed_default r x (\ (v : u8) => tokens::LitUInt8 v) "u8" after
        | ast::UInt16T => parsed_default r x (\ (v : u16) => tokens::LitUInt16 v) "u16" after
        | ast::UInt32T => parsed_default r x (\ (v : u32) => tokens::LitUInt32 v) "u32" after
        | ast::UInt64T => parsed_default r x (\ (v : u64) => tokens::LitUInt64 v) "u64" after
        | _ => failwith "Compiler error: Invalid default int type."

:~ read_default (e : term_env) (c : cursor::cursor) : cursor::step ast::raw_expr =
    ?= cursor::take c (\ r t => ?= t ?| | tokens::TokDefaultValue x => Some (r, x) | _ => None) ast::ExpectedLit ?|
    | cursor::Took ((r, x), after) =>
        ? e::top_down ?> cursor::Took (ast::RawDefaultLit (r, x), after)
        |: cursor::map_p (\ (l : tokens::literal) => ast::RawLit (r, l)) (bottom_up_number e r x) after
    | cursor::Failed (er, at) => cursor::Failed (er, at)

:~ type_expr (c : cursor::cursor) : cursor::step ast::raw_texpr =
    := var = cursor::map_p (\ ((r, x) : ast::named) => ast::RawTVar (r, x)) parse_types::read_small_var
    := value = cursor::map_p (\ ((r, x) : ast::range * tokens::literal) => ast::RawTLit (r, x)) parse_types::read_value
    := text = cursor::map_p (\ ((a, s, b) : ast::range * string * ast::range) => ast::RawTLit (ast::joined a b, tokens::LitString s)) parse_types::read_string
    := inner = cursor::rounds_p (parse_types::root_type { allow_wildcard = !-; allow_typecase_metavars = !-; allow_term = !+ })
    cursor::alt_p var (cursor::alt_p value (cursor::alt_p text inner)) c

:~ join_point (is_let : bool) (name : option string) (x : ast::raw_expr) : ast::raw_expr =
    ?= x ?|
    | ast::RawJoinPoint (a, b, body, _) => ast::RawJoinPoint (a, b, body, name)
    | ast::RawAnnot (r, a, t) ?& is_let => ast::RawAnnot (r, ast::RawJoinPoint (r, None, ast::RawAnnot (r, a, t), name), t)
    | _ ?& is_let => ast::RawJoinPoint (ast::range_of_expr x, None, x, name)
    | _ => x

:== ranged_expr = ast::range * ast::raw_expr

:~ if_part ((cr, cond) : ranged_expr) ((tr_range, tr) : ranged_expr) (otherwise : option ranged_expr) : ranged_expr =
    ?= otherwise ?|
    | Some (fr, fl) => fr, ast::RawIfThenElse (ast::joined cr fr, cond, tr, fl)
    | None => tr_range, ast::RawIfThen (ast::joined cr tr_range, cond, tr)

:~ ^ fold_elifs (xs : list (ranged_expr * ranged_expr)) (otherwise : option ranged_expr) : option ranged_expr =
    ?= xs ?|
    | [] => otherwise
    | (cond, tr) :: rest => Some (if_part cond tr (fold_elifs rest otherwise))

:== clause = ast::pattern * ast::raw_expr

:~ ^ bound_vars (p : ast::pattern) : list string =
    ?= p ?|
    | ast::PatVar (_, x) => [ x ]
    | ast::PatDyn (_, x) => bound_vars x
    | ast::PatAnnot (_, x, _) => bound_vars x
    | ast::PatNominal (_, _, _, x) => bound_vars x
    | ast::PatUnbox (_, _, x) => bound_vars x
    | ast::PatWhen (_, x, _) => bound_vars x
    | ast::PatExists (_, _, x) => bound_vars x
    | ast::PatPair (_, x, y) => listm::append (bound_vars x) (bound_vars y)
    | ast::PatAnd (_, x, y) => listm::append (bound_vars x) (bound_vars y)
    | ast::PatOr (_, x, _) => bound_vars x
    | ast::PatArray (_, l) => bound_list l
    | ast::PatRecordMembers (_, l) => bound_members l
    | _ => []

:& :~ bound_list (xs : list ast::pattern) : list string =
    ?= xs ?|
    | [] => []
    | x :: rest => listm::append (bound_vars x) (bound_list rest)

:& :~ bound_members (xs : list ast::pat_record_member) : list string =
    ?= xs ?|
    | [] => []
    | ast::PatRecordMembersSymbol (_, x) :: rest => listm::append (bound_vars x) (bound_members rest)
    | ast::PatRecordMembersInjectVar (_, x) :: rest => listm::append (bound_vars x) (bound_members rest)

:~ ^ type_directed (p : ast::pattern) : bool =
    ?= p ?|
    | ast::PatAnnot _ => !+
    | ast::PatExists _ => !+
    | ast::PatFilledDefaultValue _ => !+
    | ast::PatDefaultValue _ => !+
    | ast::PatNominal _ => !+
    | ast::PatDyn (_, x) => type_directed x
    | ast::PatUnbox (_, _, x) => type_directed x
    | ast::PatWhen (_, x, _) => type_directed x
    | ast::PatPair (_, x, y) => type_directed x || type_directed y
    | ast::PatOr (_, x, y) => type_directed x || type_directed y
    | ast::PatAnd (_, x, y) => type_directed x || type_directed y
    | ast::PatRecordMembers (_, l) => members_directed l
    | ast::PatArray (_, l) => list_directed l
    | _ => !-

:& :~ list_directed (xs : list ast::pattern) : bool =
    ?= xs ?|
    | [] => !-
    | x :: rest => type_directed x || list_directed rest

:& :~ members_directed (xs : list ast::pat_record_member) : bool =
    ?= xs ?|
    | [] => !-
    | ast::PatRecordMembersSymbol (_, x) :: rest => type_directed x || members_directed rest
    | ast::PatRecordMembersInjectVar (_, x) :: rest => type_directed x || members_directed rest

:~ trivial_body (x : ast::raw_expr) : bool =
    ?= x ?|
    | ast::RawLit _ => !+
    | ast::RawV _ => !+
    | ast::RawSymbol _ => !+
    | ast::RawB _ => !+
    | _ => !-

:~ lifted (p : ast::pattern) (body : ast::raw_expr) : bool =
    ?= p ?|
    | ast::PatOr _ => trivial_body body = !- && type_directed p = !-
    | _ => !-

:~ ^ distinct_from (xs : list string) (seen : list string) : list string =
    ?= xs ?|
    | [] => listm::rev seen
    | x :: rest => ? listm'::contains x seen ?> distinct_from rest seen |: distinct_from rest (x :: seen)

:~ ^ fold_parameters (r : ast::range) (acc : ast::pattern * ast::raw_expr) (xs : list string) : ast::pattern * ast::raw_expr =
    ?= xs ?|
    | [] => acc
    | y :: rest =>
        := (pattern, argument) = acc
        fold_parameters r (ast::PatPair (r, pattern, ast::PatVar (r, y)), ast::RawPair (r, argument, ast::rawv (r, y))) rest

:~ parameters (r : ast::range) (vars : list string) : ast::pattern * ast::raw_expr =
    ?= vars ?|
    | [] => ast::PatB r, ast::RawB r
    | x :: rest => fold_parameters r (ast::PatVar (r, x), ast::rawv (r, x)) rest

:~ ^ lift_clauses (r : ast::range) (k : i32) (cs : list clause) (joins : list (string * ast::raw_expr)) : list clause * list (string * ast::raw_expr) =
    ?= cs ?|
    | [] => [], listm::rev joins
    | (p, body) :: rest =>
        ? lifted p body ?>
            := name = " or " ++# sm'::format k
            := (parameter, argument) = parameters r (distinct_from (bound_vars p) [])
            := join_fn = ast::RawFun (r, [ (parameter, ast::RawJoinPoint (r, None, body, None)) ])
            := (more, all) = lift_clauses r (k + 1i32) rest ((name, join_fn) :: joins)
            (p, ast::RawApply (r, ast::rawv (r, name), argument)) :: more, all
        |:
            := (more, all) = lift_clauses r k rest joins
            (p, body) :: more, all

:~ ^ wrap_joins (r : ast::range) (joins : list (string * ast::raw_expr)) (inner : ast::raw_expr) : ast::raw_expr =
    ?= joins ?|
    | [] => inner
    | (name, join_fn) :: rest => ast::RawMatch (r, join_fn, [ (ast::PatVar (r, name), wrap_joins r rest inner) ])

:~ lift (r : ast::range) (scrutinee : ast::raw_expr) (cs : list clause) : ast::raw_expr =
    := (lowered, joins) = lift_clauses r 0i32 cs []
    wrap_joins r joins (ast::RawMatch (r, scrutinee, lowered))

:~ ^ fold_funs (pats : list ast::pattern) (body : ast::raw_expr) : ast::raw_expr =
    ?= pats ?|
    | [] => body
    | p :: rest =>
        := inner = fold_funs rest body
        ast::RawFun (ast::joined (ast::range_of_pattern p) (ast::range_of_expr inner), [ (p, inner) ])

:~ ^ fold_foralls (vars : list ast::type_var) (body : ast::raw_expr) : ast::raw_expr =
    ?= vars ?|
    | [] => body
    | a :: rest =>
        := inner = fold_foralls rest body
        ast::RawForall (ast::joined (ast::range_of_type_var a) (ast::range_of_expr inner), a, inner)

:~ ^ concat_found (xs : list cursor::failure) : cursor::failure =
    ?= xs ?|
    | [] => []
    | a :: rest => listm::append a (concat_found rest)

:~ pure_p \* a. (x : a) (c : cursor::cursor) : cursor::step a = cursor::Took (x, c)

:~ value_p (c : cursor::cursor) : cursor::step ast::raw_expr = cursor::map_p (\ ((r, x) : ast::range * tokens::literal) => ast::RawLit (r, x)) parse_types::read_value c

:~ text_p (c : cursor::cursor) : cursor::step ast::raw_expr = cursor::map_p (\ ((a, s, b) : ast::range * string * ast::range) => ast::RawLit (ast::joined a b, tokens::LitString s)) parse_types::read_string c

:~ small_var_p (c : cursor::cursor) : cursor::step ast::raw_expr = cursor::map_p ast::rawv parse_types::read_small_var c

:~ dyn_if_let (is_let : bool) (p : ast::pattern) : ast::pattern = ? is_let ?> ast::PatDyn (ast::range_of_pattern p, p) |: p

:~ ^ adjust_join_point (is_let : bool) (name : option string) (x : ast::raw_expr) : ast::raw_expr =
    ?= x ?|
    | ast::RawForall (r, a, b) => ast::RawForall (r, a, adjust_join_point is_let name b)
    | ast::RawFun (r, [ (a, b) ]) => ast::RawFun (r, [ (dyn_if_let is_let a, adjust_join_point is_let name b) ])
    | ast::RawFun (r, l) =>
        := (from, _) = r
        := empty = from, from
        := arg = " arg"
        ast::RawFun (r, [ (dyn_if_let is_let (ast::PatVar (empty, arg)), join_point is_let name (ast::RawMatch (empty, ast::rawv (empty, arg), l))) ])
    | _ => join_point is_let name x

:~ adjust_join_point_head (is_let : bool) (name : option string) (x : ast::raw_expr) : ast::raw_expr =
    ?= x ?|
    | ast::RawForall _ => adjust_join_point is_let name x
    | ast::RawFun _ => adjust_join_point is_let name x
    | _ => x

:~ ^ fold_let_funs (is_let : bool) (pats : list ast::pattern) (body : ast::raw_expr) : ast::raw_expr =
    ?= pats ?|
    | [] => body
    | p :: rest =>
        := inner = fold_let_funs is_let rest body
        ast::RawFun (ast::joined (ast::range_of_pattern p) (ast::range_of_expr inner), [ (dyn_if_let is_let p, inner) ])

:~ is_function (x : ast::raw_expr) : bool =
    ?= x ?|
    | ast::RawFun _ => !+
    | ast::RawForall _ => !+
    | _ => !-

:~ pattern_var_name (p : ast::pattern) : option string =
    ?= p ?|
    | ast::PatVar (_, x) => Some x
    | _ => None

:== binding = { is_let : bool; is_rec : bool; name : ast::pattern; foralls : list ast::type_var; pats : list ast::pattern; body : ast::raw_expr }

:== bound = (ast::range * ast::pattern * ast::raw_expr) * bool

:~ process_binding (r : ast::range) (b : binding) (after : cursor::cursor) : cursor::step bound =
    := var_name = pattern_var_name b::name
    ?= b::foralls, b::pats ?|
    | [], [] ?& b::is_rec = !- =>
        ?= patterns::patterns_validate [ b::name ] ?|
        | [] => cursor::Took (((r, b::name, adjust_join_point_head b::is_let var_name b::body), !-), after)
        | er => cursor::Failed (er, after)
    | _ =>
        ?= var_name ?|
        | Some _ =>
            := checked = ? b::is_rec ?> b::name :: b::pats |: b::pats
            ?= patterns::patterns_validate checked ?|
            | [] =>
                := body = fold_foralls b::foralls (fold_let_funs b::is_let b::pats (adjust_join_point b::is_let var_name b::body))
                ? b::is_rec && is_function body = !- ?> cursor::Failed ([ (r, ast::ExpectedFunctionAsBodyOfRecStatement) ], after)
                |: cursor::Took (((r, b::name, body), b::is_rec), after)
            | er => cursor::Failed (er, after)
        | None =>
            ? b::is_rec ?> cursor::Failed ([ (ast::range_of_pattern b::name, ast::ExpectedVarOrOpAsNameOfRecStatement) ], after)
            |: cursor::Failed ([ (ast::range_of_pattern b::name, ast::ExpectedSinglePatternWhenStatementNameIsNorVarOrOp) ], after)

:| statement =
    | StatementBind : ast::range * ast::pattern * ast::raw_expr
    | StatementRec : ast::range * list (ast::named * ast::raw_expr)
    | StatementOpen : ast::range * ast::named * list ast::named

:~ statement_apply (s : statement) (on_succ : ast::raw_expr) : ast::raw_expr =
    ?= s ?|
    | StatementBind (r, name, body) => ast::RawMatch (r, body, [ (name, on_succ) ])
    | StatementRec (r, l) => ast::RawRecBlock (r, l, on_succ)
    | StatementOpen (r, name, symbols) => ast::RawOpen (r, name, symbols, on_succ)

:== block = list (ast::range * statement) * ast::raw_expr

:~ ^ apply_statements (xs : list (ast::range * statement)) (inner : ast::raw_expr) : ast::raw_expr =
    ?= xs ?|
    | [] => inner
    | (_, s) :: rest => statement_apply s (apply_statements rest inner)

:~ ^ fold_blocks (xs : list block) : ast::raw_expr =
    ?= xs ?|
    | [ (stmts, x) ] => apply_statements stmts x
    | (stmts, x) :: rest =>
        := tail = fold_blocks rest
        apply_statements stmts (ast::RawSeq (joined_exprs x tail, x, tail))
    | [] => ast::RawB (cursor::origin ())

:~ ^ last_range (xs : list (ast::range * statement)) : ast::range =
    ?= xs ?|
    | [ (r, _) ] => r
    | _ :: rest => last_range rest
    | [] => cursor::origin ()

:~ bare_block (x : ast::raw_expr) : block = [], x

:== rec_entry = ast::range * (ast::named * ast::raw_expr)

:~ ^ rec_entries (xs : list bound) : list rec_entry =
    ?= xs ?|
    | [] => []
    | ((r, ast::PatVar (o, name), body), _) :: rest => (r, ((o, name), body)) :: rec_entries rest
    | _ :: _ => failwith "Compiler error: Recursive inl/let statements should always have PatVar for names and should always be recursive."

:~ ^ joined_ranges (r : ast::range) (xs : list rec_entry) : ast::range =
    ?= xs ?|
    | [] => r
    | (x, _) :: rest => joined_ranges (ast::joined r x) rest

:~ combine_bindings ((head, head_rec) : bound) (xs : list bound) (after : cursor::cursor) : cursor::step statement =
    := (r, name, body) = head
    ? head_rec = !- ?>
        ?= xs ?|
        | [] => cursor::Took (StatementBind (r, name, body), after)
        | _ => cursor::Failed (listm::map (\ (((x, _, _), _) : bound) => x, ast::UnexpectedAndInlRec) xs, after)
    |:
        := l = rec_entries ((head, head_rec) :: xs)
        := names = listm::map (\ ((_, (n, _)) : rec_entry) => n) l
        ?= parse_types::duplicates ast::DuplicateRecFunctionName names ?|
        | [] => cursor::Took (StatementRec (joined_ranges r l, listm::map snd l), after)
        | er => cursor::Failed (er, after)

:~ let_keyword (c : cursor::cursor) : cursor::step bool =
    cursor::alt_p (cursor::map_p (\ _ => !-) (cursor::skip_keyword tokens::SpecInl)) (cursor::map_p (\ _ => !+) (cursor::skip_keyword tokens::SpecLet)) c

:~ first_head (c : cursor::cursor) : cursor::step (bool * bool) =
    cursor::pair_p let_keyword (cursor::alt_p (cursor::map_p (\ _ => !+) (cursor::skip_keyword tokens::SpecRec)) (pure_p !-)) c

:~ and_head (c : cursor::cursor) : cursor::step (bool * bool) =
    cursor::map_p (\ (l : bool) => l, !+) (cursor::right_p (cursor::skip_keyword tokens::SpecAnd) let_keyword) c

:~ module_open (c : cursor::cursor) : cursor::step statement =
    := head = cursor::right_p (cursor::skip_keyword tokens::SpecOpen) parse_types::read_small_var
    cursor::map_p (\ ((r, (name, symbols)) : ast::range * (ast::named * list ast::named)) => StatementOpen (r, name, symbols)) (cursor::ranged_p (cursor::pair_p head (cursor::many_p parse_types::read_symbol))) c

:~ ^ with_symbols (xs : list ast::raw_record_with) : list ast::named =
    ?= xs ?|
    | [] => []
    | ast::RawRecordWithSymbol (a, _) :: rest => a :: with_symbols rest
    | ast::RawRecordWithSymbolModify (a, _) :: rest => a :: with_symbols rest
    | _ :: rest => with_symbols rest

:~ ^ with_injects (xs : list ast::raw_record_with) : list ast::named =
    ?= xs ?|
    | [] => []
    | ast::RawRecordWithInjectVar (a, _) :: rest => a :: with_injects rest
    | ast::RawRecordWithInjectVarModify (a, _) :: rest => a :: with_injects rest
    | _ :: rest => with_injects rest

:~ ^ without_symbols (xs : list ast::raw_record_without) : list ast::named =
    ?= xs ?|
    | [] => []
    | ast::RawRecordWithoutSymbol a :: rest => a :: without_symbols rest
    | _ :: rest => without_symbols rest

:~ ^ without_injects (xs : list ast::raw_record_without) : list ast::named =
    ?= xs ?|
    | [] => []
    | ast::RawRecordWithoutInjectVar a :: rest => a :: without_injects rest
    | _ :: rest => without_injects rest

:== record_parts = ast::range * list ast::raw_expr * list ast::raw_record_with * list ast::raw_record_without

:~ record_validate ((r, xs, withs, withouts) : record_parts) (after : cursor::cursor) : cursor::step ast::raw_expr =
    := symbols = listm::append (parse_types::duplicates ast::DuplicateTermRecordSymbol (with_symbols withs)) (parse_types::duplicates ast::DuplicateTermRecordInjection (with_injects withs))
    := removed = listm::append (parse_types::duplicates ast::DuplicateTermRecordSymbol (without_symbols withouts)) (parse_types::duplicates ast::DuplicateTermRecordInjection (without_injects withouts))
    ?= listm::append symbols removed ?|
    | [] => cursor::Took (ast::RawRecordWith (r, xs, withs, withouts), after)
    | er => cursor::Failed (er, after)

:== typecase_state = { metavars : list string; vars : list string; errors : cursor::failure }

:~ typecase_error (r : ast::range) (er : ast::parser_error) (s : typecase_state) : typecase_state = { s ?| errors = (r, er) :: s::errors }

:~ ^ typecase_walk (t : ast::raw_texpr) (s : typecase_state) : typecase_state =
    ?= t ?|
    | ast::RawTForall (r, _, _) => typecase_error r ast::ForallNotAllowedInTypecase s
    | ast::RawTExists (r, _, _) => typecase_error r ast::ExistsNotAllowedInTypecase s
    | ast::RawTMetaVar (r, a) => ? listm'::contains a s::vars ?> typecase_error r ast::MetavarShadowedByVar s |: { s ?| metavars = a :: s::metavars }
    | ast::RawTVar (r, a) => ? listm'::contains a s::metavars ?> typecase_error r ast::VarShadowedByMetavar s |: { s ?| vars = a :: s::vars }
    | ast::RawTApply (_, a, b) => typecase_walk b (typecase_walk a s)
    | ast::RawTFun (_, a, b, _) => typecase_walk b (typecase_walk a s)
    | ast::RawTPair (_, a, b) => typecase_walk b (typecase_walk a s)
    | ast::RawTLayout (_, a, _) => typecase_walk a s
    | ast::RawTArray (_, a) => typecase_walk a s
    | ast::RawTUnion (_, cases, _, _) => typecase_cases cases s
    | ast::RawTRecord (_, fields) => typecase_fields fields s
    | ast::RawTMacro (_, l) => typecase_macros l s
    | ast::RawTFilledNominal _ => failwith "Compiler error: This case is not supposed to appear in typecase."
    | ast::RawTTerm _ => failwith "Compiler error: This case is not supposed to appear in typecase."
    | ast::RawTTypecase _ => failwith "Compiler error: This case is not supposed to appear in typecase."
    | _ => s

:& :~ typecase_cases (xs : list ((i32 * string) * (bool * ast::raw_texpr))) (s : typecase_state) : typecase_state =
    ?= xs ?|
    | [] => s
    | (_, (_, x)) :: rest => typecase_cases rest (typecase_walk x s)

:& :~ typecase_fields (xs : list ((i32 * string) * ast::raw_texpr)) (s : typecase_state) : typecase_state =
    ?= xs ?|
    | [] => s
    | (_, x) :: rest => typecase_fields rest (typecase_walk x s)

:& :~ typecase_macros (xs : list ast::raw_macro) (s : typecase_state) : typecase_state =
    ?= xs ?|
    | [] => s
    | ast::RawMacroType (_, x) :: rest => typecase_macros rest (typecase_walk x s)
    | _ :: rest => typecase_macros rest s

:~ typecase_validate (t : ast::raw_texpr) (after : cursor::cursor) : cursor::step ast::raw_texpr =
    := walked = typecase_walk t { metavars = []; vars = []; errors = [] }
    ?= listm::rev walked::errors ?|
    | [] => cursor::Took (t, after)
    | er => cursor::Failed (er, after)

:~ ^ concat_types (xs : list (list ast::raw_texpr)) : list ast::raw_texpr =
    ?= xs ?|
    | [] => []
    | a :: rest => listm::append a (concat_types rest)

:~ lit_type_of (o : ast::range) ((r, x) : ast::range * ast::raw_expr) : ast::raw_expr =
    := whole = ast::joined o r
    ast::RawType (whole, ast::RawTTerm (whole, ast::RawOp (whole, ops::LitToTypeLit, [ x ])))

:~ macro_term_of (mode : tokens::macro_term_mode) (x : ast::raw_expr) : ast::raw_macro = ast::RawMacroTerm (ast::range_of_expr x, x, mode)

:~ macro_type_of (x : ast::raw_texpr) : ast::raw_macro = ast::RawMacroType (ast::range_of_texpr x, x)

:~ macro_type_lit_of (x : ast::raw_texpr) : ast::raw_macro = ast::RawMacroTypeLit (ast::range_of_texpr x, x)

:~ ^ root_term (e : term_env) (c : cursor::cursor) : cursor::step ast::raw_expr =
    := i = parse_types::col c
    := stmt = parse_types::indented i (\ a b => a = b) (cursor::ranged_p (statement_p e))
    := tail_in = parse_types::indented i (\ a b => a <= b) (cursor::right_p (cursor::skip_keyword tokens::SpecIn) (root_term e))
    := tail_expr = parse_types::indented i (\ a b => a = b) (operators e)
    := stmts = \ (c : cursor::cursor) =>
        ?= cursor::pair_p (cursor::many1_p stmt) (cursor::opt_p (cursor::alt_p tail_in tail_expr)) c ?|
        | cursor::Took ((a, b), after) =>
            ?= b ?|
            | Some x => cursor::Took ((a, x), after)
            | None => cursor::Took ((a, ast::RawB (last_range a)), after)
        | cursor::Failed (er, at) => cursor::Failed (er, at)
    cursor::map_p fold_blocks (cursor::many1_p (cursor::alt_p stmts (cursor::map_p bare_block tail_expr))) c

:& :~ statement_p (e : term_env) (c : cursor::cursor) : cursor::step statement =
    cursor::alt_p (bindings_p e) module_open c

:& :~ bindings_p (e : term_env) (c : cursor::cursor) : cursor::step statement =
    ?= cursor::pair_p (binding_p e first_head) (cursor::many_p (binding_p e and_head)) c ?|
    | cursor::Took ((x, xs), after) => combine_bindings x xs after
    | cursor::Failed (er, at) => cursor::Failed (er, at)

:& :~ binding_p (e : term_env) (head : cursor::cursor -> cursor::step (bool * bool)) (c : cursor::cursor) : cursor::step bound =
    := foralls = cursor::alt_p parse_types::forall_p (pure_p [])
    := parts = cursor::pair_p head (cursor::pair_p patterns::root_pattern_pair (cursor::pair_p foralls (cursor::pair_p (cursor::many_p patterns::root_pattern_pair) (annotated e "="))))
    ?= cursor::ranged_p parts c ?|
    | cursor::Took ((r, ((is_let, is_rec), (name, (fs, (pats, body))))), after) => process_binding r { is_let = is_let; is_rec = is_rec; name = name; foralls = fs; pats = pats; body = body } after
    | cursor::Failed (er, at) => cursor::Failed (er, at)

:& :~ exists_form (e : term_env) (c : cursor::cursor) : cursor::step ast::raw_expr =
    := sequence_type = \ (c : cursor::cursor) =>
        := i = parse_types::col c
        cursor::map_p concat_types (cursor::many_p (parse_types::indented i (\ a b => a = b) (cursor::sep_by1_p (parse_types::root_type (parse_types::type_defaults ())) (cursor::skip_op ";")))) c
    := head = cursor::pair_p (cursor::ranged_p (cursor::skip_keyword tokens::SpecExists)) (cursor::opt_p (cursor::squares_p sequence_type))
    ?= cursor::pair_p head (root_term e) c ?|
    | cursor::Took ((((r, _), vars), body), after) =>
        := explicit = ?= vars ?| | Some _ => !+ | None => e::top_down
        ? explicit ?> cursor::Took (ast::RawExists (ast::joined r (ast::range_of_expr body), (r, vars), body), after)
        |: cursor::Failed ([ (r, ast::TypeVarsNeedToBeExplicitForExists) ], after)
    | cursor::Failed (er, at) => cursor::Failed (er, at)

:& :~ typecase_form (e : term_env) (c : cursor::cursor) : cursor::step ast::raw_expr =
    ? e::top_down ?> cursor::Failed ([], c)
    |:
        := clauses = \ (c : cursor::cursor) =>
            := bar = parse_types::bar (parse_types::col c)
            := pattern = cursor::bind_p (parse_types::root_type { allow_wildcard = !+; allow_typecase_metavars = !+; allow_term = !- }) typecase_validate
            cursor::right_p (parse_types::optional_p bar) (cursor::sep_by1_p (cursor::pair_p pattern (cursor::right_p (cursor::skip_op "=>") (root_term e))) bar) c
        := scrutinee = cursor::left_p (cursor::right_p (cursor::skip_keyword tokens::SpecTypecase) (parse_types::root_type { allow_wildcard = !-; allow_typecase_metavars = !-; allow_term = !+ })) (cursor::skip_keyword tokens::SpecWith)
        cursor::map_p (\ ((r, (a, b)) : ast::range * (ast::raw_texpr * list (ast::raw_texpr * ast::raw_expr))) => ast::RawTypecase (r, a, b)) (cursor::ranged_p (cursor::pair_p scrutinee clauses)) c

:& :~ macro_form (e : term_env) (c : cursor::cursor) : cursor::step ast::raw_expr =
    := within = \ (kind : tokens::macro_kind) (p : cursor::cursor -> cursor::step ast::raw_macro) => cursor::left_p (cursor::right_p (cursor::skip_macro_expression kind tokens::Open) p) (cursor::skip_macro_expression kind tokens::Close)
    := plain = within tokens::MTerm (cursor::map_p (macro_term_of tokens::TermPlain) (root_term e))
    := inlined = within tokens::MTermInline (cursor::map_p (macro_term_of tokens::TermInline) (root_term e))
    := typed = within tokens::MType (cursor::map_p macro_type_of (parse_types::root_type (parse_types::type_defaults ())))
    := type_lit = within tokens::MTypeLit (cursor::map_p macro_type_lit_of (parse_types::root_type (parse_types::type_defaults ())))
    := text = cursor::map_p (\ ((r, s) : ast::range * string) => ast::RawMacroText (r, s)) (cursor::read_text !+)
    := body = cursor::many_p (cursor::alt_p text (cursor::alt_p cursor::read_macro_var (cursor::alt_p plain (cursor::alt_p inlined (cursor::alt_p typed type_lit)))))
    cursor::bind_p cursor::skip_macro_open (\ (a : ast::range) => cursor::bind_p body (\ (l : list ast::raw_macro) => cursor::map_p (\ (b : ast::range) => ast::RawMacro (ast::joined a b, l)) cursor::skip_macro_close)) c

:& :~ record_form (e : term_env) (c : cursor::cursor) : cursor::step ast::raw_expr =
    := field_value = \ (column : i32) => root_term { e ?| operator_floor = Some (column + 1i32) }
    := create = \ (column : i32) => cursor::right_p (cursor::skip_op "=") (field_value column)
    := modify = \ (column : i32) => cursor::right_p (cursor::skip_op "#=") (field_value column)
    := var = cursor::ranged_p parse_types::record_var
    := inject = cursor::right_p (cursor::skip_unary_op "$") parse_types::read_small_var
    := or_self = \ (a : ast::named) (b : option ast::raw_expr) => ?= b ?| | Some x => x | None => ast::rawv a
    := create_body = \ (c : cursor::cursor) =>
        := column = parse_types::col c
        := symbol = cursor::map_p (\ ((a, b) : ast::named * option ast::raw_expr) => ast::RawRecordWithSymbol (a, or_self a b)) (cursor::pair_p var (cursor::opt_p (create column)))
        := injected = cursor::map_p (\ ((a, b) : ast::named * ast::raw_expr) => ast::RawRecordWithInjectVar (a, b)) (cursor::pair_p inject (create column))
        cursor::alt_p symbol injected c
    := with_body = \ (c : cursor::cursor) =>
        := column = parse_types::col c
        := symbol = cursor::bind_p var (\ (a : ast::named) => cursor::alt_p (cursor::map_p (\ (b : ast::raw_expr) => ast::RawRecordWithSymbolModify (a, b)) (modify column)) (cursor::map_p (\ (b : option ast::raw_expr) => ast::RawRecordWithSymbol (a, or_self a b)) (cursor::opt_p (create column))))
        := injected = cursor::bind_p inject (\ (a : ast::named) => cursor::alt_p (cursor::map_p (\ (b : ast::raw_expr) => ast::RawRecordWithInjectVarModify (a, b)) (modify column)) (cursor::map_p (\ (b : ast::raw_expr) => ast::RawRecordWithInjectVar (a, b)) (create column)))
        cursor::alt_p symbol injected c
    := without_body = cursor::alt_p (cursor::map_p (\ (a : ast::named) => ast::RawRecordWithoutSymbol a) var) (cursor::map_p (\ (a : ast::named) => ast::RawRecordWithoutInjectVar a) inject)
    := separator = parse_types::optional_p (cursor::skip_op ";")
    := record_create = cursor::map_p (\ ((r, withs) : ast::range * list ast::raw_record_with) => r, [], withs, []) (cursor::ranged_p (cursor::curlies_p (cursor::sep_by_p create_body separator)))
    := base_arg = cursor::alt_p small_var_p (cursor::alt_p value_p (cursor::alt_p (read_default e) (cursor::alt_p text_p (cursor::rounds_p (root_term e)))))
    := record_base = cursor::alt_p (cursor::bind_p small_var_p (\ (a : ast::raw_expr) => cursor::map_p (fold_apply a) (cursor::many_p base_arg))) (cursor::rounds_p (root_term e))
    := accessor = cursor::alt_p (cursor::map_p (\ (a : ast::named) => ast::RawSymbol a) parse_types::read_symbol) (cursor::right_p (cursor::skip_op "$") small_var_p)
    := withs = cursor::alt_p (cursor::right_p (cursor::skip_keyword tokens::SpecWith) (cursor::sep_by_p with_body separator)) (pure_p [])
    := withouts = cursor::alt_p (cursor::right_p (cursor::skip_keyword tokens::SpecWithout) (cursor::many_p without_body)) (pure_p [])
    := parts = cursor::pair_p record_base (cursor::pair_p (cursor::many_p accessor) (cursor::pair_p withs withouts))
    := record_with = cursor::map_p (\ ((r, (x, (xs, (ws, wos)))) : ast::range * (ast::raw_expr * (list ast::raw_expr * (list ast::raw_record_with * list ast::raw_record_without)))) => r, x :: xs, ws, wos) (cursor::ranged_p (cursor::curlies_p parts))
    cursor::bind_p (cursor::alt_p (cursor::restore_p 3i32 record_create) record_with) record_validate c

:& :~ expressions (e : term_env) (c : cursor::cursor) : cursor::step ast::raw_expr =
    := next = root_term e
    := value = value_p
    := default_value = read_default e
    := var = cursor::map_p ast::rawv cursor::read_var
    := join_form = cursor::map_p (join_point !+ None) (cursor::right_p (cursor::skip_keyword tokens::SpecJoin) next)
    := backend_join = cursor::map_p (\ ((a, b) : ast::named * ast::raw_expr) => ast::RawJoinPoint (ast::range_of_expr b, Some a, b, None)) (cursor::right_p (cursor::skip_keyword tokens::SpecJoinBackend) (cursor::pair_p cursor::read_big_var next))
    := real_form = cursor::map_p (\ (x : ast::raw_expr) => ast::RawReal (ast::range_of_expr x, x)) (cursor::right_p (cursor::skip_keyword tokens::SpecReal) (root_term { e ?| top_down = !- }))
    := symbol = cursor::map_p (\ (a : ast::named) => ast::RawSymbol a) parse_types::read_symbol
    := rounds_item = cursor::alt_p (cursor::map_p ast::rawv cursor::read_op) next
    := rounds = cursor::map_p (\ ((r, xs) : ast::range * list ast::raw_expr) => tuple_of xs r) (cursor::ranged_p (cursor::rounds_p (cursor::sep_by_p rounds_item (cursor::skip_op ","))))
    := list = \ c =>
        ?= cursor::ranged_p (cursor::squares_p (sequence_body e)) c ?|
        | cursor::Took ((r, xs), after) =>
            := (from, _) = r
            ? e::top_down ?> cursor::Took (fold_list (from, from) xs, after) |: cursor::Failed ([ (r, ast::ListLiteralsNotAllowedInBottomUp) ], after)
        | cursor::Failed (er, at) => cursor::Failed (er, at)
    := text = text_p
    cursor::alt_p value (cursor::alt_p default_value (cursor::alt_p var (cursor::alt_p join_form (cursor::alt_p backend_join (cursor::alt_p real_form (cursor::alt_p symbol (cursor::alt_p (typecase_form e) (cursor::alt_p (match_or_function e) (cursor::alt_p rounds (cursor::alt_p list (cursor::alt_p (record_form e) (cursor::alt_p (type_if_then_else e) (cursor::alt_p (if_then_else e) (cursor::alt_p (fun_form e) (cursor::alt_p (forall_form e) (cursor::alt_p text (cursor::alt_p (macro_form e) (exists_form e)))))))))))))))))) c

:& :~ pattern_when (e : term_env) (c : cursor::cursor) : cursor::step ast::pattern =
    := guard = cursor::opt_p (cursor::right_p (cursor::skip_keyword tokens::SpecWhen) (root_term e))
    := guarded = \ ((a, b) : ast::pattern * option ast::raw_expr) => ?= b ?| | Some x => ast::PatWhen (ast::joined (ast::range_of_pattern a) (ast::range_of_expr x), a, x) | None => a
    cursor::map_p guarded (cursor::pair_p patterns::root_pattern guard) c

:& :~ annotated (e : term_env) (sep : string) (c : cursor::cursor) : cursor::step ast::raw_expr =
    := ty = cursor::opt_p (cursor::right_p (cursor::skip_op ":") (parse_types::root_type (annot_flags e)))
    := body = cursor::pair_p (cursor::skip_op sep) (cursor::opt_p (root_term e))
    := build = \ ((a, (r, b)) : option ast::raw_texpr * (ast::range * option ast::raw_expr)) =>
        := x = ?= b ?| | Some x => x | None => ast::RawMissingBody r
        ?= a ?| | Some t => ast::RawAnnot (ast::joined (ast::range_of_expr x) (ast::range_of_texpr t), x, t) | None => x
    cursor::map_p build (cursor::pair_p ty body) c

:& :~ fun_form (e : term_env) (c : cursor::cursor) : cursor::step ast::raw_expr =
    ?= cursor::right_p (cursor::skip_keyword tokens::SpecFun) (cursor::pair_p (cursor::many1_p patterns::root_pattern_pair) (annotated e "=>")) c ?|
    | cursor::Took ((pats, body), after) =>
        ?= patterns::patterns_validate pats ?|
        | [] => cursor::Took (fold_funs pats body, after)
        | er => cursor::Failed (er, after)
    | cursor::Failed (er, at) => cursor::Failed (er, at)

:& :~ forall_form (e : term_env) (c : cursor::cursor) : cursor::step ast::raw_expr =
    ? e::top_down ?> cursor::Failed ([], c)
    |:
        ?= cursor::pair_p parse_types::forall_p (cursor::pair_p (cursor::many_p patterns::root_pattern_pair) (annotated e "=>")) c ?|
        | cursor::Took ((vars, (pats, body)), after) =>
            ?= patterns::patterns_validate pats ?|
            | [] => cursor::Took (fold_foralls vars (fold_funs pats body), after)
            | er => cursor::Failed (er, after)
        | cursor::Failed (er, at) => cursor::Failed (er, at)

:& :~ clauses (e : term_env) (allow_empty : bool) (c : cursor::cursor) : cursor::step (list clause) =
    := bar = parse_types::bar (parse_types::col c)
    := one = cursor::pair_p (pattern_when e) (cursor::right_p (cursor::skip_op "=>") (root_term e))
    := items = ? allow_empty ?> cursor::sep_by_p one bar |: cursor::sep_by1_p one bar
    ?= cursor::right_p (parse_types::optional_p bar) items c ?|
    | cursor::Took (l, after) =>
        ?= concat_found (listm::map (\ ((a, _) : clause) => patterns::patterns_validate [ a ]) l) ?|
        | [] => cursor::Took (l, after)
        | er => cursor::Failed (er, after)
    | cursor::Failed (er, at) => cursor::Failed (er, at)

:& :~ match_or_function (e : term_env) (c : cursor::cursor) : cursor::step ast::raw_expr =
    := function_form = cursor::map_p (\ ((r, l) : ast::range * list clause) => ast::RawFun (r, l)) (cursor::ranged_p (cursor::right_p (cursor::skip_keyword tokens::SpecFunction) (clauses e !-)))
    := match_form = \ (c : cursor::cursor) =>
        := scrutinee = root_term { e ?| continuation_column = Some (parse_types::col c) }
        := head = cursor::left_p (cursor::right_p (cursor::skip_keyword tokens::SpecMatch) scrutinee) (cursor::skip_keyword tokens::SpecWith)
        cursor::map_p (\ ((r, (a, cs)) : ast::range * (ast::raw_expr * list clause)) => lift r a cs) (cursor::ranged_p (cursor::pair_p head (clauses e !+))) c
    cursor::alt_p function_form match_form c

:& :~ if_then_else (e : term_env) (c : cursor::cursor) : cursor::step ast::raw_expr =
    := i = parse_types::col c
    := part = \ (k : tokens::token_keyword) => cursor::ranged_p (cursor::right_p (cursor::skip_keyword k) (root_term e))
    := aligned = \ (k : tokens::token_keyword) => parse_types::indented i (\ a b => a <= b) (part k)
    := head = cursor::pair_p (part tokens::SpecIf) (aligned tokens::SpecThen)
    := elifs = cursor::many_p (cursor::pair_p (aligned tokens::SpecElif) (aligned tokens::SpecThen))
    := build = \ ((((cond, tr), more), otherwise) : ((ranged_expr * ranged_expr) * list (ranged_expr * ranged_expr)) * option ranged_expr) => snd (if_part cond tr (fold_elifs more otherwise))
    cursor::map_p build (cursor::pair_p (cursor::pair_p head elifs) (cursor::opt_p (aligned tokens::SpecElse))) c

:& :~ type_if_then_else (e : term_env) (c : cursor::cursor) : cursor::step ast::raw_expr =
    := i = parse_types::col c
    := annot = parse_types::root_type (annot_flags e)
    := opening = cursor::attempt_p (cursor::right_p (cursor::skip_keyword tokens::SpecIf) (cursor::skip_keyword tokens::SpecType))
    := head = parse_types::indented i (\ a b => a <= b) (cursor::ranged_p (cursor::right_p opening (cursor::pair_p annot (cursor::right_p (cursor::skip_op "=") annot))))
    := part = \ (k : tokens::token_keyword) => parse_types::indented i (\ a b => a <= b) (cursor::ranged_p (cursor::right_p (cursor::skip_keyword k) (root_term e)))
    := build = \ ((((cr, (a, b)), (tr_range, tr)), otherwise) : ((ast::range * (ast::raw_texpr * ast::raw_texpr)) * ranged_expr) * option ranged_expr) =>
        ?= otherwise ?|
        | Some (fr, fl) => ast::RawTypeIfThenElse (ast::joined cr fr, a, b, tr, fl)
        | None => ast::RawTypeIfThen (ast::joined cr tr_range, a, b, tr)
    cursor::map_p build (cursor::pair_p (cursor::pair_p head (part tokens::SpecThen)) (cursor::opt_p (part tokens::SpecElse))) c

:& :~ application_tight (e : term_env) (c : cursor::cursor) : cursor::step ast::raw_expr =
    := next = expressions e
    cursor::bind_p next (\ a => cursor::map_p (fold_apply a) (cursor::many_p (parse_types::expr_tight next))) c

:& :~ sequence_body (e : term_env) (c : cursor::cursor) : cursor::step (list ast::raw_expr) =
    := i = parse_types::col c
    cursor::map_p concat_lists (cursor::many_p (parse_types::indented i (\ a b => a = b) (cursor::sep_by1_p (operators e) (cursor::skip_op ";")))) c

:& :~ inbuilt_op (e : term_env) (c : cursor::cursor) : cursor::step ast::raw_expr =
    := tuple_binding = ?= ops::inbuilt_operators "," ?| | Some (p, _) => p | None => 0i32
    := argument = operator_chain { e ?| top_down = !- } tuple_binding
    ?= cursor::ranged_p (cursor::pair_p cursor::read_big_var (cursor::rounds_p (cursor::sep_by_p argument (cursor::skip_op ",")))) c ?|
    | cursor::Took ((r, ((ra, a), b)), after) =>
        ?= ops::op_of_name a ?|
        | Some op => cursor::Took (ast::RawOp (r, op, b), after)
        | None => cursor::Failed ([ (ra, ast::InbuiltOpNotFound) ], after)
    | cursor::Failed (er, at) => cursor::Failed (er, at)

:& :~ unary_op (e : term_env) (c : cursor::cursor) : cursor::step ast::raw_expr =
    := next = application_tight e
    := array = \ (o : ast::range) (c : cursor::cursor) =>
        ? e::top_down ?> cursor::map_p (\ ((_, xs) : ast::range * list ast::raw_expr) => ast::RawApply (o, ast::RawV (o, "array", !+), ast::RawArray (o, xs))) (cursor::ranged_p (cursor::squares_p (sequence_body e))) c
        |: cursor::Failed ([ (o, ast::ArrayLiteralsNotAllowedInBottomUp) ], c)
    := bottom_up_only = \ (p : cursor::cursor -> cursor::step ast::raw_expr) (c : cursor::cursor) => ? e::top_down ?> cursor::Failed ([], c) |: p c
    := typed = cursor::map_p (\ ((r, x) : ast::range * ast::raw_texpr) => ast::RawType (r, x)) (cursor::ranged_p type_expr)
    := type_to_var = \ (o : ast::range) => cursor::map_p (\ ((r, x) : ast::range * ast::raw_texpr) => ast::RawOp (ast::joined o r, ops::TypeToVar, [ ast::RawType (r, x) ])) (cursor::ranged_p type_expr)
    := after = \ ((o, a) : ast::named) =>
        ? a = ";" ?> array o
        |? a = "!!!!" ?> inbuilt_op e
        |? a = "`" ?> bottom_up_only typed
        |? a = "``" ?> bottom_up_only (type_to_var o)
        |? a = "`@" ?> bottom_up_only (cursor::map_p (lit_type_of o) (cursor::ranged_p (cursor::alt_p (cursor::map_p ast::rawv cursor::read_var) (cursor::alt_p value_p (cursor::alt_p (read_default e) (cursor::alt_p text_p (cursor::rounds_p (root_term e))))))))
        |? a = "`$" ?> cursor::map_p (\ ((r, x) : ast::named) => ast::RawV (r, x, !-)) cursor::read_var
        |? a = "*" && e::upstream ?> cursor::map_p (\ ((r, x) : ast::range * ast::raw_expr) => ast::RawLayoutIndex (r, x)) (cursor::ranged_p (cursor::alt_p (cursor::map_p ast::rawv cursor::read_var) (cursor::rounds_p (root_term e))))
        |: cursor::map_p (\ (b : ast::raw_expr) => ast::RawApply (ast::joined o (ast::range_of_expr b), ast::rawv (o, "~" ++# a), b)) next
    cursor::alt_p (cursor::bind_p cursor::read_unary_op after) next c

:& :~ application (e : term_env) (c : cursor::cursor) : cursor::step ast::raw_expr =
    := column = floor_or_col e::continuation_column c
    := next = unary_op { e ?| continuation_column = None }
    cursor::bind_p next (\ a => cursor::map_p (fold_apply a) (cursor::many_p (parse_types::indented column (\ x y => x < y) next))) c

:& :~ operators (e : term_env) (c : cursor::cursor) : cursor::step ast::raw_expr =
    := i = parse_types::col c
    := annotation = cursor::opt_p (parse_types::indented i (\ a b => a <= b) (cursor::right_p (cursor::skip_op ":") (parse_types::root_type (annot_flags e))))
    := annotate = \ ((a, b) : ast::raw_expr * option ast::raw_texpr) => ?= b ?| | Some t => ast::RawAnnot (ast::joined (ast::range_of_expr a) (ast::range_of_texpr t), a, t) | None => a
    cursor::map_p annotate (cursor::pair_p (operator_chain e (lowest_binding ())) annotation) c

:& :~ operator_chain (e : term_env) (rbp_floor : i32) (c : cursor::cursor) : cursor::step ast::raw_expr =
    tdop { e ?| operator_floor = None } (floor_or_col e::operator_floor c) rbp_floor c

:& :~ tdop (e : term_env) (i : i32) (rbp : i32) (c : cursor::cursor) : cursor::step ast::raw_expr =
    cursor::bind_p (application e) (chain_loop e i rbp) c

:& :~ chain_loop (e : term_env) (i : i32) (rbp : i32) (left : ast::raw_expr) (c : cursor::cursor) : cursor::step ast::raw_expr =
    ?= parse_types::indented i (\ a b => a <= b) read_operator c ?|
    | cursor::Took ((prec, assoc, parsed), next) =>
        ? rbp < prec ?>
            := right_binding = ?= assoc ?| | ops::AssocRight => prec - 1i32 | _ => prec
            ?= tdop e i right_binding next ?|
            | cursor::Took (right, after) => chain_loop e i rbp (apply_operator parsed left right) after
            | cursor::Failed (er, at) => cursor::Failed (er, at)
        |: cursor::Took (left, c)
    | cursor::Failed (er, at) => ? cursor::consumed c at ?> cursor::Failed (er, at) |: cursor::Took (left, c)

:~ pattern_type_text (t : ast::raw_texpr) : string =
    ?= t ?|
    | ast::RawTMetaVar (_, x) => "~" ++# x
    | _ => parse_types::type_text t

:~ ^ expr_text (x : ast::raw_expr) : string =
    ?= x ?|
    | ast::RawB _ => "()"
    | ast::RawV (_, n, plain) => ? plain ?> n |: "$" ++# n
    | ast::RawLit (_, tokens::LitString s) => "\"" ++# s ++# "\""
    | ast::RawLit (_, tokens::LitInt32 n) => sm'::format n
    | ast::RawLit (_, tokens::LitBool b) => ? b ?> "true" |: "false"
    | ast::RawLit _ => "lit"
    | ast::RawDefaultLit (_, s) => s
    | ast::RawSymbol (_, s) => "." ++# s
    | ast::RawApply (_, a, b) => "(" ++# expr_text a ++# " " ++# expr_text b ++# ")"
    | ast::RawPair (_, a, b) => "(" ++# expr_text a ++# ", " ++# expr_text b ++# ")"
    | ast::RawSeq (_, a, b) => "(" ++# expr_text a ++# "; " ++# expr_text b ++# ")"
    | ast::RawIfThenElse (_, a, b, otherwise) => "if(" ++# expr_text a ++# ", " ++# expr_text b ++# ", " ++# expr_text otherwise ++# ")"
    | ast::RawIfThen (_, a, b) => "if(" ++# expr_text a ++# ", " ++# expr_text b ++# ")"
    | ast::RawTypeIfThenElse (_, a, b, tr, fl) => "tif(" ++# parse_types::type_text a ++# " = " ++# parse_types::type_text b ++# ", " ++# expr_text tr ++# ", " ++# expr_text fl ++# ")"
    | ast::RawTypeIfThen (_, a, b, tr) => "tif(" ++# parse_types::type_text a ++# " = " ++# parse_types::type_text b ++# ", " ++# expr_text tr ++# ")"
    | ast::RawJoinPoint (_, backend, body, _) => "join " ++# (?= backend ?| | Some (_, n) => n ++# " " | None => "") ++# expr_text body
    | ast::RawAnnot (_, a, t) => "(" ++# expr_text a ++# " : " ++# parse_types::type_text t ++# ")"
    | ast::RawOp (_, _, xs) => "op(" ++# sm'::concat_list ", " (listm::map expr_text xs) ++# ")"
    | ast::RawArray (_, xs) => ";[" ++# sm'::concat_list "; " (listm::map expr_text xs) ++# "]"
    | ast::RawReal (_, a) => "real " ++# expr_text a
    | ast::RawHeapMutableSet (_, t, xs, v) => "set(" ++# expr_text t ++# " [" ++# sm'::concat_list "; " (listm::map expr_text xs) ++# "] " ++# expr_text v ++# ")"
    | ast::RawFun (_, cs) => "fun(" ++# sm'::concat_list "; " (listm::map clause_text cs) ++# ")"
    | ast::RawMatch (_, a, cs) => "match(" ++# expr_text a ++# ": " ++# sm'::concat_list "; " (listm::map clause_text cs) ++# ")"
    | ast::RawForall (_, ((_, (n, _)), _), b) => "forall " ++# n ++# ". " ++# expr_text b
    | ast::RawMissingBody _ => "missing"
    | ast::RawLayoutIndex (_, a) => "layout_index " ++# expr_text a
    | ast::RawRecordWith (_, xs, ws, wos) => "rec{" ++# sm'::concat_list " " (listm::map expr_text xs) ++# "|" ++# sm'::concat_list "; " (listm::map with_text ws) ++# "|" ++# sm'::concat_list " " (listm::map without_text wos) ++# "}"
    | ast::RawRecBlock (_, l, on_succ) => "recblock(" ++# sm'::concat_list "; " (listm::map (\ (((_, n), b) : ast::named * ast::raw_expr) => n ++# " = " ++# expr_text b) l) ++# " in " ++# expr_text on_succ ++# ")"
    | ast::RawExists (_, (_, vars), b) => "exists" ++# (?= vars ?| | Some l => "[" ++# sm'::concat_list "; " (listm::map parse_types::type_text l) ++# "]" | None => "") ++# " " ++# expr_text b
    | ast::RawTypecase (_, a, cs) => "typecase(" ++# parse_types::type_text a ++# ": " ++# sm'::concat_list "; " (listm::map (\ ((t, b) : ast::raw_texpr * ast::raw_expr) => pattern_type_text t ++# " => " ++# expr_text b) cs) ++# ")"
    | ast::RawMacro (_, l) => "macro(" ++# sm'::concat_list "|" (listm::map macro_text l) ++# ")"
    | ast::RawType (_, ast::RawTTerm (_, x)) => "type(term " ++# expr_text x ++# ")"
    | ast::RawType (_, t) => "type(" ++# parse_types::type_text t ++# ")"
    | ast::RawOpen (_, (_, n), symbols, on_succ) => "open " ++# n ++# sm'::concat_list "" (listm::map (\ ((_, s) : ast::named) => " ." ++# s) symbols) ++# " in " ++# expr_text on_succ
    | _ => "?"

:& :~ clause_text ((p, body) : clause) : string =
    := head = ?= p ?| | ast::PatWhen (_, a, w) => patterns::pattern_text a ++# " when " ++# expr_text w | _ => patterns::pattern_text p
    head ++# " => " ++# expr_text body

:& :~ with_text (w : ast::raw_record_with) : string =
    ?= w ?|
    | ast::RawRecordWithSymbol ((_, n), x) => n ++# " = " ++# expr_text x
    | ast::RawRecordWithSymbolModify ((_, n), x) => n ++# " #= " ++# expr_text x
    | ast::RawRecordWithInjectVar ((_, n), x) => "$" ++# n ++# " = " ++# expr_text x
    | ast::RawRecordWithInjectVarModify ((_, n), x) => "$" ++# n ++# " #= " ++# expr_text x

:& :~ macro_text (m : ast::raw_macro) : string =
    ?= m ?|
    | ast::RawMacroText (_, s) => "text " ++# s
    | ast::RawMacroTerm (_, x, tokens::TermInline) => "inline " ++# expr_text x
    | ast::RawMacroTerm (_, x, _) => "term " ++# expr_text x
    | ast::RawMacroType (_, t) => "type " ++# parse_types::type_text t
    | ast::RawMacroTypeLit (_, t) => "typelit " ++# parse_types::type_text t

:& :~ without_text (w : ast::raw_record_without) : string =
    ?= w ?|
    | ast::RawRecordWithoutSymbol (_, n) => n
    | ast::RawRecordWithoutInjectVar (_, n) => "$" ++# n

:~ shown_with (e : term_env) (c : cursor::cursor) : string =
    ?= root_term e c ?|
    | cursor::Took (x, next) => ? (listm::length next::rest : i32) = 0i32 ?> expr_text x |: expr_text x ++# " +rest"
    | cursor::Failed (er, _) => "fail " ++# sm'::format (listm::length er : i32)

:~ shown_cursor (c : cursor::cursor) : string = shown_with (top_env ()) c

:~ shown_term (text : string) : string = shown_cursor (cursor::line_cursor text)

:~ shown_upstream (text : string) : string =
    := e = top_env ()
    shown_with { e ?| upstream = !+ } (cursor::line_cursor text)

:~ shown_bottom_with (default_int : ast::prim_type) (text : string) : string =
    := e = top_env ()
    shown_with { e ?| top_down = !-; default_int = default_int } (cursor::line_cursor text)

:~ shown_bottom (text : string) : string =
    := e = top_env ()
    shown_with { e ?| top_down = !- } (cursor::line_cursor text)

:~ shown_lines (xs : list string) : string = shown_cursor (cursor::of_lines 0i32 (listm::map (\ (x : string) => (tokens::tokenize_line (tokens::lex_state_init ()) x)::tokens) xs))

///> rust
///> fsharp
///> gleam
:# operators_bind_by_precedence_and_associativity_like_the_reference =
    (shown_term "a + b * c", shown_term "a |> f |> g", shown_term "a, b, c", shown_term "a = b && c", shown_term "a && b || c", shown_term "1 + 2")
    |> _assert_eq ("((+ a) ((* b) c))", "((|> ((|> a) f)) g)", "(a, (b, c))", "if(((= a) b), c, false)", "if(if(a, b, false), true, c)", "((+ 1) 2)")

///> rust
///> fsharp
///> gleam
:# application_tuples_lists_and_annotations_build_the_reference_shapes =
    (shown_term "f x y", shown_term "f(x)", shown_term "(a, b)", shown_term "()", shown_term "[a; b]", shown_term "x : i32")
    |> _assert_eq ("((f x) y)", "(f x)", "(a, b)", "()", "(Cons (a, (Cons (b, Nil))))", "(x : i32)")

///> rust
///> fsharp
///> gleam
:# unary_forms_and_a_dangling_operator_follow_the_reference =
    (shown_term ";[a; b]", shown_term "!!!!Dyn(x)", shown_term "real x", shown_term "a +", shown_term "\"s\" .x")
    |> _assert_eq ("(array ;[a; b])", "op(x)", "real x", "fail 0", "(\"s\" .x)")

///> rust
///> fsharp
///> gleam
:# conditionals_and_join_points_follow_the_reference =
    (shown_term "? a ?> b |: c", shown_term "if a then b elif c then d else e", shown_term "? a ?> b", shown_term "join f x", shown_term "join_backend Rust x", shown_term "? :== a = b ?> x |: y")
    |> _assert_eq ("if(a, b, c)", "if(a, b, if(c, d, e))", "if(a, b)", "join (f x)", "join Rust x", "tif(a = b, x, y)")

///> rust
///> fsharp
///> gleam
:# lambdas_and_their_validation_follow_the_reference =
    (shown_term "fun x => x", shown_term "fun x y => x", shown_term "fun x : i32 => x", shown_term "fun x x => x", shown_term "real forall a. x => x")
    |> _assert_eq ("fun(x => x)", "fun(x => fun(y => x))", "fun(x => (x : i32))", "fail 1", "real forall a. fun(x => x)")

///> rust
///> fsharp
///> gleam
:# matches_functions_guards_and_or_pattern_joins_follow_the_reference =
    (shown_term "?= a ?| | Some x => x | None => b", shown_term "function | A => 1 | B => 2", shown_term "?= a ?| | x ?& f x => x", shown_term "?= a ?| | A x | B x => f x", shown_term "?= a ?| | A x | B x => x")
    |> _assert_eq ("match(a: Some(x) => x; None(_) => b)", "fun(A(_) => 1; B(_) => 2)", "match(a: x when (f x) => x)", "match(fun(x => join (f x)):  or 0 => match(a: (A(x) | B(x)) => ( or 0 x)))", "match(a: (A(x) | B(x)) => x)")

///> rust
///> fsharp
///> gleam
:# statements_bind_join_and_validate_like_the_reference =
    (shown_term ":= x = 1 in x", shown_term ":~ y = 1 in y", shown_term ":= f x = x in f", shown_term ":~ g x = x in g", shown_term ":= ^ f x = f x :& := g y = y in f", shown_term ":= f x = x :& := g y = y in f", shown_term ":= ^ x = 1 in x", shown_term ":= (a, b) x = a in a")
    |> _assert_eq ("match(1: x => x)", "match(1: y => y)", "match(fun(x => x): f => f)", "match(fun(~x => join x): g => g)", "recblock(f = fun(x => (f x)); g = fun(y => y) in f)", "fail 1", "fail 1", "fail 1")

///> rust
///> fsharp
///> gleam
:# statement_lines_opens_and_records_follow_the_reference =
    (shown_lines [ ":= x = 1"; "x" ], shown_lines [ "f a"; "g b" ], shown_lines [ ":= x = 1" ], shown_lines [ ":< sm .a"; "x" ], shown_term "{a = 1; b}", shown_term "{x with a = 1}", shown_term "{x .a with b #= f}", shown_term "{x without a}", shown_term "{a = 1; a = 2}", shown_term "{f x with a = 1}", shown_term "{$k = 1}")
    |> _assert_eq ("match(1: x => x)", "((f a); (g b))", "match(1: x => ())", "open sm .a in x", "rec{|a = 1; b = b|}", "rec{x|a = 1|}", "rec{x .a|b #= f|}", "rec{x||a}", "fail 1", "rec{(f x)|a = 1|}", "rec{|$k = 1|}")

///> rust
///> fsharp
///> gleam
:# exists_typecase_macros_and_literal_types_follow_the_reference =
    (shown_term "exists x", shown_term "exists [i32; f64] x", shown_bottom "exists x", shown_bottom "typecase a with | i32 => x | ~t => y", shown_bottom "typecase a with | ~t * t => x", shown_term "$'a !x b'", shown_bottom "`@3i32")
    |> _assert_eq ("exists x", "exists[i32; f64] x", "fail 1", "typecase(a: i32 => x; ~t => y)", "fail 1", "macro(text a |term x|text  b)", "type(term op(3))")

///> rust
///> fsharp
///> gleam
:# bottom_up_defaults_and_the_upstream_layout_index_follow_the_reference =
    (shown_term "3", shown_bottom "3", shown_bottom "2.5", shown_bottom "99999999999", shown_bottom_with ast::UInt8T "255", shown_bottom_with ast::UInt8T "256", shown_upstream "*x", shown_term "*x")
    |> _assert_eq ("3", "3", "lit", "fail 1", "lit", "fail 1", "layout_index x", "(~* x)")
