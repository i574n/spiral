:< sm'_operators

:| token_keyword =
    | SpecIn
    | SpecAnd
    | SpecFun
    | SpecMatch
    | SpecTypecase
    | SpecFunction
    | SpecWith
    | SpecWithout
    | SpecAs
    | SpecWhen
    | SpecInl
    | SpecForall
    | SpecExists
    | SpecLet
    | SpecInm
    | SpecInb
    | SpecRec
    | SpecIf
    | SpecThen
    | SpecElif
    | SpecElse
    | SpecJoin
    | SpecJoinBackend
    | SpecType
    | SpecNominal
    | SpecReal
    | SpecUnion
    | SpecOpen
    | SpecWildcard
    | SpecPrototype
    | SpecInstance

:| parenthesis_state = Open | Close

:| parenthesis = Round | Square | Curly

:| macro_kind = MTerm | MType | MTypeLit | MTermInline | MTermBorrowed

:| macro_term_mode = TermPlain | TermInline | TermBorrowed

:| literal =
    | LitUInt8 : u8
    | LitUInt16 : u16
    | LitUInt32 : u32
    | LitUInt64 : u64
    | LitInt8 : i8
    | LitInt16 : i16
    | LitInt32 : i32
    | LitInt64 : i64
    | LitFloat32 : f32
    | LitFloat64 : f64
    | LitBool : bool
    | LitString : string
    | LitChar : char

:| semantic_token_legend =
    | LegendVariable
    | LegendSymbol
    | LegendString
    | LegendNumber
    | LegendOperator
    | LegendUnaryOperator
    | LegendComment
    | LegendKeyword
    | LegendParenthesis
    | LegendTypeVariable
    | LegendEscapedChar
    | LegendUnescapedChar
    | LegendNumberSuffix
    | LegendEscapedVar

:= legend_code (legend : semantic_token_legend) : i32 =
    ?= legend ?|
    | LegendVariable => 0
    | LegendSymbol => 1
    | LegendString => 2
    | LegendNumber => 3
    | LegendOperator => 4
    | LegendUnaryOperator => 5
    | LegendComment => 6
    | LegendKeyword => 7
    | LegendParenthesis => 8
    | LegendTypeVariable => 9
    | LegendEscapedChar => 10
    | LegendUnescapedChar => 11
    | LegendNumberSuffix => 12
    | LegendEscapedVar => 13

:| spiral_token =
    | TokVar : string * semantic_token_legend
    | TokSymbol : string * semantic_token_legend
    | TokOperator : string * semantic_token_legend
    | TokUnaryOperator : string * semantic_token_legend
    | TokValue : literal
    | TokValueSuffix
    | TokDefaultValue : string
    | TokComment : string
    | TokKeyword : token_keyword
    | TokParenthesis : parenthesis * parenthesis_state
    | TokStringOpen
    | TokStringClose
    | TokText : string
    | TokEscapedChar : char
    | TokEscapedVar
    | TokUnescapedChar : char
    | TokMacroOpen
    | TokMacroClose
    | TokMacroTermVar : string * macro_term_mode
    | TokMacroTypeVar : string
    | TokMacroTypeLitVar : string
    | TokMacroExpression : macro_kind * parenthesis_state

:== lex_state = { triple_quotes : i32; comment_depth : i32; macro_close : option char }

:= lex_state_init () : lex_state = { triple_quotes = 0; comment_depth = 0; macro_close = None }

:= in_triple (state : lex_state) : bool = 0 < state::triple_quotes

:= lex_state_error (state : lex_state) : option string =
    ? in_triple state
    ?> Some ("Unterminated triple-quoted string. Expected '" ++# sm'::replicate state::triple_quotes "\"" ++# "'.")
    |? 0 < state::comment_depth
    ?> Some "Unterminated multiline comment. Expected '*)'."
    |:
        ?= state::macro_close ?|
        | Some _ =>
            Some "Unterminated macro: a line ending in '\\' continues the macro on the next line, which must close it."
        | None => None

:~ comment_scan (text : string) (from : i32) (open_depth : i32) : i32 * i32 =
    := length : i32 = sm'::length text
    := char_is (i : i32) (expected : char) : bool = ? i < length ?> sm'::index i text = expected |: !-
    :~ ^ scan (i : i32) (depth : i32) : i32 * i32 =
        ? i < length && 0 < depth ?>
            ? char_is i '(' && char_is (i + 1) '*' ?>
                ? char_is (i + 2) ')' ?> scan (i + 3) depth |: scan (i + 2) (depth + 1)
            |? char_is i '*' && char_is (i + 1) ')' ?> scan (i + 2) (depth - 1)
            |: scan (i + 1) depth
        |: i, depth
    scan from open_depth

:~ i574n_symbol_token (symbol : string) : option spiral_token =
    ?= symbol ?|
    | ":=" => Some (TokKeyword SpecInl)
    | ":~" => Some (TokKeyword SpecLet)
    | "^" => Some (TokKeyword SpecRec)
    | ":&" => Some (TokKeyword SpecAnd)
    | ";;" => Some (TokKeyword SpecIn)
    | "\\" => Some (TokKeyword SpecFun)
    | "\\|" => Some (TokKeyword SpecFunction)
    | "\\*" => Some (TokKeyword SpecForall)
    | "\\?" => Some (TokKeyword SpecExists)
    | "?" => Some (TokKeyword SpecIf)
    | "?>" => Some (TokKeyword SpecThen)
    | "|?" => Some (TokKeyword SpecElif)
    | "|:" => Some (TokKeyword SpecElse)
    | "?=" => Some (TokKeyword SpecMatch)
    | "?:" => Some (TokKeyword SpecTypecase)
    | "?|" => Some (TokKeyword SpecWith)
    | "-|" => Some (TokKeyword SpecWithout)
    | "&=" => Some (TokKeyword SpecAs)
    | "?&" => Some (TokKeyword SpecWhen)
    | ":==" => Some (TokKeyword SpecType)
    | ":!" => Some (TokKeyword SpecNominal)
    | ":|" => Some (TokKeyword SpecUnion)
    | ":?" => Some (TokKeyword SpecPrototype)
    | ":+" => Some (TokKeyword SpecInstance)
    | ":<" => Some (TokKeyword SpecOpen)
    | "~>" => Some (TokKeyword SpecReal)
    | "~~" => Some (TokKeyword SpecJoin)
    | "~~>" => Some (TokKeyword SpecJoinBackend)
    | "!+" => Some (TokValue (LitBool !+))
    | "!-" => Some (TokValue (LitBool !-))
    | ":#" => Some (TokVar ("test", LegendVariable))
    | _ => None

:~ word_token (word : string) : spiral_token =
    ?= word ?|
    | "in" => TokKeyword SpecIn
    | "and" => TokKeyword SpecAnd
    | "fun" => TokKeyword SpecFun
    | "match" => TokKeyword SpecMatch
    | "typecase" => TokKeyword SpecTypecase
    | "function" => TokKeyword SpecFunction
    | "with" => TokKeyword SpecWith
    | "without" => TokKeyword SpecWithout
    | "as" => TokKeyword SpecAs
    | "when" => TokKeyword SpecWhen
    | "inl" => TokKeyword SpecInl
    | "forall" => TokKeyword SpecForall
    | "let" => TokKeyword SpecLet
    | "inm" => TokKeyword SpecInm
    | "inb" => TokKeyword SpecInb
    | "rec" => TokKeyword SpecRec
    | "if" => TokKeyword SpecIf
    | "then" => TokKeyword SpecThen
    | "elif" => TokKeyword SpecElif
    | "else" => TokKeyword SpecElse
    | "join" => TokKeyword SpecJoin
    | "join_backend" => TokKeyword SpecJoinBackend
    | "type" => TokKeyword SpecType
    | "nominal" => TokKeyword SpecNominal
    | "real" => TokKeyword SpecReal
    | "union" => TokKeyword SpecUnion
    | "open" => TokKeyword SpecOpen
    | "_" => TokKeyword SpecWildcard
    | "prototype" => TokKeyword SpecPrototype
    | "instance" => TokKeyword SpecInstance
    | "true" => TokValue (LitBool !+)
    | "false" => TokValue (LitBool !-)
    | "exists" => TokKeyword SpecExists
    | _ => TokVar (word, LegendVariable)

:~ token_group (token : spiral_token) : semantic_token_legend =
    ?= token ?|
    | TokVar (_, legend) | TokSymbol (_, legend) | TokOperator (_, legend) | TokUnaryOperator (_, legend) => legend
    | TokValue (LitChar _) | TokValue (LitString _) => LegendString
    | TokStringOpen | TokStringClose | TokText _ | TokMacroOpen | TokMacroClose => LegendString
    | TokComment _ => LegendComment
    | TokKeyword _ => LegendKeyword
    | TokParenthesis _ | TokMacroExpression _ => LegendParenthesis
    | TokMacroTypeVar _ | TokMacroTypeLitVar _ => LegendTypeVariable
    | TokMacroTermVar _ => LegendVariable
    | TokEscapedChar _ => LegendEscapedChar
    | TokEscapedVar => LegendEscapedVar
    | TokUnescapedChar _ => LegendUnescapedChar
    | TokValue _ | TokDefaultValue _ => LegendNumber
    | TokValueSuffix => LegendNumberSuffix

:= token_legend (token : spiral_token) : i32 = token |> token_group |> legend_code

///> c
///> rust
///> gleam
:# keywords_and_variables_get_their_legends =
    ? token_legend (word_token "typecase") <> 7 ?> failwith "typecase is a keyword"
    ? token_legend (word_token "join_backend") <> 7 ?> failwith "join_backend is a keyword"
    ? token_legend (word_token "spiral") <> 0 ?> failwith "a plain word is a variable"
    ? token_legend (TokValue (LitInt32 3)) <> 3 ?> failwith "an int literal is a number"
    ? token_legend (TokParenthesis (Round, Open)) <> 8 ?> failwith "a parenthesis has the parenthesis legend"
    ? token_legend (TokValue (LitBool !+)) <> 3 ?> failwith "a bool literal is a number, as in token_groups"
    ? token_legend (TokValue (LitString "s")) <> 2 ?> failwith "a string literal is a string"
    ? token_legend TokValueSuffix <> 12 ?> failwith "a value suffix has its own legend"
    ? token_legend (TokMacroTypeLitVar "t") <> 9 ?> failwith "a macro type literal var is a type variable"

///> c
///> rust
///> gleam
:# lex_state_reports_triple_quotes =
    := clean = lex_state_init ()
    ? in_triple clean ?> failwith "no triple quotes"
    ? in_triple { clean ?| triple_quotes = 3 } = !- ?> failwith "inside triple quotes"

///> c
///> rust
///> fsharp
///> gleam
:# lex_state_error_names_what_is_unterminated =
    := clean = lex_state_init ()
    := message state =
        ?= lex_state_error state ?|
        | Some text => text
        | None => ""
    ? message clean <> "" ?> failwith "a clean state has no error"
    ? message { clean ?| triple_quotes = 3 } <> "Unterminated triple-quoted string. Expected '\"\"\"'."
    ?> failwith "the triple quote count is spelled out"
    ? message { clean ?| comment_depth = 2 } <> "Unterminated multiline comment. Expected '*)'."
    ?> failwith "an open comment is named"
    ? message { clean ?| macro_close = Some '"' } = "" ?> failwith "an open macro is an error"

///> c
///> rust
///> fsharp
///> gleam
:# comment_scan_nests_and_skips_the_multiplication_operator =
    ? comment_scan "a *) b" 0 1 <> (4, 0) ?> failwith "one close ends one level"
    ? comment_scan "x (* y *) z *) w" 0 1 <> (14, 0) ?> failwith "a nested comment closes before the outer"
    ? comment_scan "(*) still" 0 1 <> (9, 1) ?> failwith "(*) neither opens nor closes"
    ? comment_scan "abc" 0 2 <> (3, 2) ?> failwith "an unclosed comment runs to the line end"
    ? comment_scan "*) tail" 5 1 <> (7, 1) ?> failwith "the scan starts at the given index"

///> c
///> rust
///> fsharp
///> gleam
:# i574n_symbols_map_to_keywords =
    := legend symbol =
        ?= i574n_symbol_token symbol ?|
        | Some token => token_legend token
        | None => -1
    ? legend ":=" <> 7 ?> failwith ":= is inl"
    ? legend "\\|" <> 7 ?> failwith "backslash bar is function"
    ? legend "~~>" <> 7 ?> failwith "~~> is join_backend"
    ? legend "!+" <> 3 ?> failwith "!+ is the literal true"
    ? legend "+" <> -1 ?> failwith "plus is an ordinary operator"

:| lexer_char =
    | Glyph : char
    | LineEnd

:= code (c : char) : i32 = sm'::convert_to_utf32 c

:= in_range (low : char) (high : char) (c : char) : bool = code c >= code low && code c <= code high

:= is_ascii_lower (c : char) : bool = c |> in_range 'a' 'z'

:= is_ascii_upper (c : char) : bool = c |> in_range 'A' 'Z'

:= is_digit (c : char) : bool = c |> in_range '0' '9'

:= is_hex_digit (c : char) : bool = is_digit c || in_range 'a' 'f' c || in_range 'A' 'F' c

:= is_letter (c : char) : bool = is_ascii_lower c || is_ascii_upper c || code c > code '~'

:= is_small_var_char_starting (c : char) : bool = is_ascii_lower c || c = '_'

:= is_big_var_char_starting (c : char) : bool = is_ascii_upper c

:= is_var_char_starting (c : char) : bool = is_letter c || c = '_'

:= is_var_char (c : char) : bool = is_letter c || is_digit c || c = '_' || c = '\''

:= is_parenth_open (c : char) : bool = c = '(' || c = '[' || c = '{'

:= is_parenth_close (c : char) : bool = c = ')' || c = ']' || c = '}'

:= is_operator_char (c : char) : bool =
    in_range '!' '~' c && (is_var_char c || c = '"' || is_parenth_open c || is_parenth_close c) = !-

:= is_prefix_separator (x : lexer_char) : bool =
    ?= x ?|
    | LineEnd => !+
    | Glyph c => c = ' ' || is_parenth_open c

:= is_postfix_separator (x : lexer_char) : bool =
    ?= x ?|
    | LineEnd => !+
    | Glyph c => c = ' ' || is_parenth_close c

:= is_separator (x : lexer_char) : bool =
    is_prefix_separator x || (?= x ?| Glyph c => is_parenth_close c | LineEnd => !-)

///> rust
///> fsharp
///> gleam
:# char_classes_match_the_fsharp_tokenizer =
    ? is_var_char_starting '1' ?> failwith "a digit cannot start a variable"
    ? is_var_char_starting '_' = !- ?> failwith "an underscore starts a variable"
    ? is_var_char '\'' = !- ?> failwith "a prime continues a variable"
    ? is_small_var_char_starting 'A' ?> failwith "an upper letter is not small"
    ? is_big_var_char_starting 'A' = !- ?> failwith "an upper letter is big"
    ? is_operator_char '+' = !- ?> failwith "plus is an operator char"
    ? is_operator_char '(' ?> failwith "a parenthesis is not an operator char"
    ? is_operator_char '"' ?> failwith "a quote is not an operator char"
    ? is_operator_char 'x' ?> failwith "a letter is not an operator char"
    ? is_prefix_separator LineEnd = !- ?> failwith "the line end separates"
    ? is_prefix_separator (Glyph '(') = !- ?> failwith "an open parenthesis prefixes"
    ? is_postfix_separator (Glyph ')') = !- ?> failwith "a close parenthesis postfixes"
    ? is_separator (Glyph 'a') ?> failwith "a letter does not separate"
    ? is_hex_digit 'F' = !- ?> failwith "F is a hex digit"
    ? is_hex_digit 'g' ?> failwith "g is not a hex digit"

:== cursor = { text : string; from : i32 }

:== span = { from : i32; near_to : i32 }

:| lexed =
    | Lexed : span * spiral_token * cursor
    | LexError : i32 * string

:= cursor_of (text : string) : cursor = { text = text; from = 0 }

:= peek_at (offset : i32) (at : cursor) : lexer_char =
    := i = at::from + offset
    ? 0 <= i && i < sm'::length at::text ?> Glyph (sm'::index i at::text) |: LineEnd

:= peek (at : cursor) : lexer_char = peek_at 0 at

:= advance (count : i32) (at : cursor) : cursor = { at ?| from = at::from + count }

:= glyph_is (predicate : char -> bool) (x : lexer_char) : bool =
    ?= x ?|
    | Glyph c => predicate c
    | LineEnd => !-

:~ ^ skip_while (predicate : char -> bool) (at : cursor) : cursor =
    ? peek at |> glyph_is predicate ?> at |> advance 1 |> skip_while predicate |: at

:= skip_spaces (at : cursor) : cursor = at |> skip_while (\ c => c = ' ')

:= text_between (start : cursor) (stop : cursor) : string = start::text |> sm'::slice start::from (stop::from - 1)

:= span_between (start : cursor) (stop : cursor) : span = { from = start::from; near_to = stop::from }

:~ module_path_follows (past : cursor) : bool =
    (peek_at 1 past |> glyph_is (\ c => c = ':')) && (peek_at 2 past |> glyph_is (\ c => is_var_char_starting c || c = '('))

:~ lex_var (start : cursor) : lexed =
    ? peek start |> glyph_is is_var_char_starting ?>
        := past = start |> advance 1 |> skip_while is_var_char
        ? (peek past |> glyph_is (\ c => c = ':')) && not (module_path_follows past)
        ?> LexError (start::from, ": is not allowed directly after a var.")
        |: Lexed (span_between start past, text_between start past |> word_token, skip_spaces past)
    |: LexError (start::from, "variable")

:~ symbol_prefix (start : cursor) : i32 =
    := colon offset = peek_at offset start |> glyph_is (\ c => c = ':')
    ? colon 0 && colon 1 ?> 2 |? peek start |> glyph_is (\ c => c = '.') ?> 1 |: 0

:~ symbol_operator (start : cursor) (body : cursor) : lexed =
    := past = body |> skip_while is_operator_char
    ? past::from = body::from
    ?> LexError (body::from, "operator")
    |? peek past |> glyph_is (\ c => c = ')') ?>
        := closed = past |> advance 1
        Lexed (span_between start closed, TokSymbol (text_between body past, LegendSymbol), skip_spaces closed)
    |: LexError (past::from, "')'")

:~ lex_symbol (start : cursor) : lexed =
    := prefix = symbol_prefix start
    := after = start |> advance prefix
    ? 0 < prefix && (peek after |> glyph_is (\ c => c = '(')) ?> symbol_operator start (after |> advance 1)
    |? 0 < prefix && (peek after |> glyph_is is_var_char_starting) ?>
        := past = after |> skip_while is_var_char
        Lexed (span_between start past, TokSymbol (text_between after past, LegendSymbol), skip_spaces past)
    |: LexError (start::from, "symbol")

:~ ^ without_list_separators (text : string) : string =
    := length : i32 = sm'::length text
    ? length = 0
    ?> text
    |:
        := last = sm'::index (length - 1) text
        ? last = ',' || last = ';' ?> text |> sm'::slice 0 (length - 2) |> without_list_separators |: text

:~ lex_operator (start : cursor) : lexed =
    ? peek start |> glyph_is is_operator_char ?>
        := past = start |> advance 1 |> skip_while is_operator_char
        := name = text_between start past
        ?= i574n_symbol_token name ?|
        | Some keyword => Lexed (span_between start past, keyword, skip_spaces past)
        | None =>
            := trimmed = without_list_separators name
            := trimmed_length : i32 = sm'::length trimmed
            := trimmed_keyword =
                ? 0 < trimmed_length && trimmed_length < sm'::length name ?> i574n_symbol_token trimmed |: None
            ?= trimmed_keyword ?|
            | Some keyword =>
                := stop = { start ?| from = start::from + trimmed_length }
                Lexed (span_between start stop, keyword, skip_spaces stop)
            | None =>
                := unary = is_prefix_separator (peek_at -1 start) && is_postfix_separator (peek past) = !-
                := token =
                    ? unary ?> TokUnaryOperator (name, LegendUnaryOperator) |: TokOperator (name, LegendOperator)
                Lexed (span_between start past, token, skip_spaces past)
    |: LexError (start::from, "operator")

:= lexed_summary (result : lexed) : i32 * i32 * i32 =
    ?= result ?|
    | Lexed (range, token, rest) => token_legend token, range::near_to, rest::from
    | LexError (at, _) => -1, at, -1

:= lexed_text (result : lexed) : string =
    ?= result ?|
    | Lexed (_, TokVar (name, _), _) | Lexed (_, TokSymbol (name, _), _) => name
    | Lexed (_, TokOperator (name, _), _) | Lexed (_, TokUnaryOperator (name, _), _) => name
    | Lexed (_, TokComment text, _) => text
    | Lexed _ => ""
    | LexError (_, message) => message

///> rust
///> fsharp
///> gleam
:# lex_var_reads_words_keywords_and_rejects_a_colon =
    ? cursor_of "foo bar" |> lex_var |> lexed_summary <> (0, 3, 4) ?> failwith "a word is a variable up to the space"
    ? cursor_of "foo bar" |> lex_var |> lexed_text <> "foo" ?> failwith "the variable text is the word"
    ? cursor_of "inl x" |> lex_var |> lexed_summary <> (7, 3, 4) ?> failwith "inl is a keyword"
    ? cursor_of "x': y" |> lex_var |> lexed_summary <> (-1, 0, -1) ?> failwith "no colon right after a var"
    ? cursor_of "sm'::f" |> lex_var |> lexed_summary <> (0, 3, 3) ?> failwith "a module path's var stops before ::"
    ? cursor_of "1x" |> lex_var |> lexed_summary <> (-1, 0, -1) ?> failwith "a digit cannot start a var"
    ? { text = "a  b"; from = 3 } |> lex_var |> lexed_summary <> (0, 4, 4) ?> failwith "a var at the line end"

///> rust
///> fsharp
///> gleam
:# lex_symbol_reads_dot_names_and_dot_operators =
    ? cursor_of ".foo x" |> lex_symbol |> lexed_summary <> (1, 4, 5) ?> failwith "a dot name is a symbol"
    ? cursor_of ".foo x" |> lex_symbol |> lexed_text <> "foo" ?> failwith "the symbol text drops the dot"
    ? cursor_of ".(+) x" |> lex_symbol |> lexed_summary <> (1, 4, 5) ?> failwith "a dot operator in parentheses"
    ? cursor_of ".(+) x" |> lex_symbol |> lexed_text <> "+" ?> failwith "the operator text is inside the parentheses"
    ? cursor_of ".(+ x" |> lex_symbol |> lexed_summary <> (-1, 3, -1) ?> failwith "an unclosed dot operator"
    ? cursor_of ".1" |> lex_symbol |> lexed_summary <> (-1, 0, -1) ?> failwith "a dot and a digit is no symbol"

///> rust
///> fsharp
///> gleam
:# lex_operator_tells_unary_binary_and_i574n_keywords =
    ? cursor_of "+ 1" |> lex_operator |> lexed_summary <> (4, 1, 2) ?> failwith "plus before a space is binary"
    ? { text = "a -b"; from = 2 } |> lex_operator |> lexed_summary <> (5, 3, 3) ?> failwith "glued minus is unary"
    ? { text = "a - b"; from = 2 } |> lex_operator |> lexed_summary <> (4, 3, 4) ?> failwith "spaced minus is binary"
    ? cursor_of ":= x" |> lex_operator |> lexed_summary <> (7, 2, 3) ?> failwith ":= is the inl keyword"
    ? cursor_of "|?, x" |> lex_operator |> lexed_summary <> (7, 2, 2) ?> failwith "keyword gives the comma back"
    ? cursor_of "+=, x" |> lex_operator |> lexed_text <> "+=," ?> failwith "an operator keeps its comma"
    ? cursor_of "x" |> lex_operator |> lexed_summary <> (-1, 0, -1) ?> failwith "a letter is no operator"

:= char_at_is (offset : i32) (expected : char) (at : cursor) : bool =
    peek_at offset at |> glyph_is (\ c => c = expected)

:~ ^ skip_doc_markers (at : cursor) : cursor =
    := spaced_marker = (char_at_is 0 '!' at || char_at_is 0 '-' at || char_at_is 0 '>' at) && char_at_is 1 ' ' at
    ? char_at_is 0 '/' at || spaced_marker ?> at |> advance 1 |> skip_doc_markers |: at

:~ lex_comment (state : lex_state) (start : cursor) : lexed * lex_state =
    ? char_at_is 0 '/' start && char_at_is 1 '/' start ?>
        := marked = start |> advance 2 |> skip_doc_markers
        ? char_at_is 0 ' ' marked ?>
            := body = marked |> advance 1
            := stop = { body ?| from = sm'::length body::text }
            Lexed (span_between start stop, TokComment (text_between body stop), stop), state
        |: LexError (marked::from, "whitespace"), state
    |? char_at_is 0 '(' start && char_at_is 1 '*' start && (char_at_is 2 ' ' start || peek_at 2 start = LineEnd) ?>
        := stop_index, depth = comment_scan start::text (start::from + 2) 1
        := stop = { start ?| from = stop_index }
        := comment = TokComment (text_between start stop)
        Lexed (span_between start stop, comment, stop), { state ?| comment_depth = depth }
    |: LexError (start::from, "comment"), state
:~ utf8_continuation (c : char) : bool = code c >= 128 && code c < 192

:~ lex_char_quoted (start : cursor) : lexed =
    := escaped c =
        ? c = 'n'
        ?> '\n'
        |? c = 'r'
        ?> '\r'
        |? c = 't'
        ?> '\t'
        |? c = 'b'
        ?> '\b'
        |: c
    := closed (body : cursor) (value : char) : lexed =
        ? peek body |> glyph_is (\ c => c = '\'') ?>
            := stop = body |> advance 1
            Lexed (span_between start stop, TokValue (LitChar value), skip_spaces stop)
        |: LexError (body::from, "'''")
    ? peek start |> glyph_is (\ c => c = '\'') ?>
        := body = start |> advance 1
        ?= peek body ?|
        | LineEnd => LexError (body::from, "character or '")
        | Glyph c ?& c = '\\' =>
            := escape = body |> advance 1
            ?= peek escape ?|
            | LineEnd => LexError (escape::from, "character or '")
            | Glyph c => closed (escape |> advance 1) (escaped c)
        | Glyph c => closed (body |> advance 1 |> skip_while utf8_continuation) c
    |: LexError (start::from, "'''")

///> rust
///> fsharp
///> gleam
:# lex_comment_reads_line_and_block_comments =
    := clean = lex_state_init ()
    := summary text =
        := result, _ = cursor_of text |> lex_comment clean
        lexed_summary result
    := body text =
        := result, _ = cursor_of text |> lex_comment clean
        lexed_text result
    := depth text =
        := _, state = cursor_of text |> lex_comment clean
        state::comment_depth
    ? summary "// note" <> (6, 7, 7) ?> failwith "a line comment runs to the end"
    ? body "// note" <> "note" ?> failwith "the comment text starts after the space"
    ? body "///> rust" <> "rust" ?> failwith "doc and target markers are skipped"
    ? summary "//x" <> (-1, 2, -1) ?> failwith "a line comment needs a space"
    ? summary "(* a *) b" <> (6, 7, 7) ?> failwith "a block comment ends after its close"
    ? depth "(* a" <> 1 ?> failwith "an open block comment carries its depth"
    ? depth "(*" <> 1 ?> failwith "an open block comment may end the line"
    ? summary "(*) x" <> (-1, 0, -1) ?> failwith "(*) is the multiplication operator"

///> rust
///> fsharp
///> gleam
:# lex_char_quoted_reads_plain_and_escaped_chars =
    := value text =
        ?= cursor_of text |> lex_char_quoted ?|
        | Lexed (_, TokValue (LitChar c), _) => c
        | _ => '?'
    ? cursor_of "'a' x" |> lex_char_quoted |> lexed_summary <> (2, 3, 4) ?> failwith "a quoted char is a string"
    ? value "'a'" <> 'a' ?> failwith "a plain char"
    ? value "'\\n'" <> '\n' ?> failwith "an escaped newline"
    ? value "'\\q'" <> 'q' ?> failwith "an unknown escape is the char itself"
    ? cursor_of "'ab'" |> lex_char_quoted |> lexed_summary <> (-1, 2, -1) ?> failwith "two chars do not close"
    ? cursor_of "'" |> lex_char_quoted |> lexed_summary <> (-1, 1, -1) ?> failwith "a lone quote ends the line"

:| lexed_number =
    | NumberSuffixed : span * literal * span * cursor
    | NumberPlain : span * string * cursor
    | NumberError : i32 * string

:~ digit_run (start : cursor) : option (string * cursor) =
    ? peek start |> glyph_is is_digit ?>
        := past = start |> advance 1 |> skip_while (\ c => is_digit c || c = '_')
        Some (text_between start past |> sm'::replace "_" "", past)
    |: None

:~ number_suffixed (start : cursor) (text : string) (suffix : cursor) : lexed_number =
    := parsed literal_of (description : string) (stop : cursor) : lexed_number =
        ? is_separator (peek stop) || (peek stop |> glyph_is is_operator_char) ?>
            ?= convert::try_convert text ?|
            | Some value =>
                := value_span = { from = start::from; near_to = suffix::from }
                NumberSuffixed (value_span, literal_of value, span_between suffix stop, skip_spaces stop)
            | None =>
                := message = "The string " ++# text ++# " cannot be safely parsed as " ++# description ++# "."
                NumberError (start::from, message)
        |: NumberError (stop::from, "separator")
    := width = suffix |> advance 1
    := two (a : char) (b : char) : bool = char_at_is 0 a width && char_at_is 1 b width
    ? char_at_is 0 'i' suffix ?>
        ? char_at_is 0 '8' width
        ?> parsed (\ (x : i8) => LitInt8 x) "i8" (width |> advance 1)
        |? two '1' '6'
        ?> parsed (\ (x : i16) => LitInt16 x) "i16" (width |> advance 2)
        |? two '3' '2'
        ?> parsed (\ (x : i32) => LitInt32 x) "i32" (width |> advance 2)
        |? two '6' '4'
        ?> parsed (\ (x : i64) => LitInt64 x) "i64" (width |> advance 2)
        |: NumberError (width::from, "8,16,32 or 64")
    |? char_at_is 0 'u' suffix ?>
        ? char_at_is 0 '8' width
        ?> parsed (\ (x : u8) => LitUInt8 x) "uint8" (width |> advance 1)
        |? two '1' '6'
        ?> parsed (\ (x : u16) => LitUInt16 x) "u16" (width |> advance 2)
        |? two '3' '2'
        ?> parsed (\ (x : u32) => LitUInt32 x) "u32" (width |> advance 2)
        |? two '6' '4'
        ?> parsed (\ (x : u64) => LitUInt64 x) "u64" (width |> advance 2)
        |: NumberError (width::from, "8,16,32 or 64")
    |? char_at_is 0 'f' suffix ?>
        ? two '3' '2'
        ?> parsed (\ (x : f32) => LitFloat32 x) "f32" (width |> advance 2)
        |? two '6' '4'
        ?> parsed (\ (x : f64) => LitFloat64 x) "f64" (width |> advance 2)
        |: NumberError (width::from, "32 or 64")
    |: NumberPlain (span_between start suffix, text, skip_spaces suffix)

:~ lex_number (start : cursor) : lexed_number =
    := negative =
        char_at_is 0 '-' start && (peek_at 1 start |> glyph_is is_digit) && is_prefix_separator (peek_at -1 start)
    := body = ? negative ?> start |> advance 1 |: start
    := sign = ? negative ?> "-" |: ""
    ?= digit_run body ?|
    | None => NumberError (body::from, "number")
    | Some (whole, after_whole) =>
        ? char_at_is 0 '.' after_whole ?>
            ?= after_whole |> advance 1 |> digit_run ?|
            | Some (fraction, after_fraction) =>
                number_suffixed start (sign ++# whole ++# "." ++# fraction) after_fraction
            | None => NumberError (after_whole::from + 1, "number")
        |: number_suffixed start (sign ++# whole) after_whole

:= number_value (result : lexed_number) : option literal =
    ?= result ?|
    | NumberSuffixed (_, value, _, _) => Some value
    | _ => None

:| number_ends =
    | EndsSuffixed : { value_end : i32; suffix_end : i32; rest_from : i32 }
    | EndsPlain : { value_end : i32; rest_from : i32 }
    | EndsError : { at : i32 }

:= number_spans (result : lexed_number) : number_ends =
    ?= result ?|
    | NumberSuffixed (value_span, _, suffix_span, rest) => EndsSuffixed { value_end = value_span::near_to; suffix_end = suffix_span::near_to; rest_from = rest::from }
    | NumberPlain (range, _, rest) => EndsPlain { value_end = range::near_to; rest_from = rest::from }
    | NumberError (at, _) => EndsError { at = at }

:= number_text (result : lexed_number) : string =
    ?= result ?|
    | NumberPlain (_, text, _) => text
    | NumberError (_, message) => message
    | NumberSuffixed _ => ""

///> rust
///> fsharp
///> gleam
:# lex_number_reads_suffixes_signs_and_fractions =
    := lexed text = cursor_of text |> lex_number
    ? lexed "42 x" |> number_spans <> EndsPlain { value_end = 2; rest_from = 3 } ?> failwith "an unsuffixed number"
    ? lexed "42 x" |> number_text <> "42" ?> failwith "the unsuffixed text"
    ? lexed "1_000i32" |> number_value <> Some (LitInt32 1000) ?> failwith "underscores are dropped"
    ? lexed "1_000i32" |> number_spans <> EndsSuffixed { value_end = 5; suffix_end = 8; rest_from = 8 } ?> failwith "the value span ends where the suffix starts"
    ? { text = "a -5i8"; from = 2 } |> lex_number |> number_value <> Some (LitInt8 -5i8) ?> failwith "signed"
    ? { text = "x-5"; from = 1 } |> lex_number |> number_spans <> EndsError { at = 1 } ?> failwith "a glued minus is no sign"
    ? lexed "1.5f32 " |> number_value <> Some (LitFloat32 1.5f32) ?> failwith "a float with a suffix"
    ? lexed "2.25" |> number_text <> "2.25" ?> failwith "an unsuffixed fraction keeps its text"
    ? lexed "1.x" |> number_spans <> EndsError { at = 2 } ?> failwith "a dot needs digits after it"
    ? lexed "300u8" |> number_text <> "The string 300 cannot be safely parsed as uint8." ?> failwith "u8 overflow"
    ? lexed "7i32x" |> number_spans <> EndsError { at = 4 } ?> failwith "a suffix needs a separator after it"
    ? lexed "7i32+" |> number_value <> Some (LitInt32 7) ?> failwith "an operator char separates"
    ? lexed "7i9" |> number_spans <> EndsError { at = 2 } ?> failwith "an unknown width"

:| lexed_tokens =
    | LexedTokens : list (span * spiral_token) * cursor * lex_state
    | LexFailure : i32 * string

:~ lex_bracket (start : cursor) : lexed =
    := stop = start |> advance 1
    := bracket kind = Lexed (span_between start stop, TokParenthesis kind, skip_spaces stop)
    ?= peek start ?|
    | Glyph c ?& c = '(' => bracket (Round, Open)
    | Glyph c ?& c = '[' => bracket (Square, Open)
    | Glyph c ?& c = '{' => bracket (Curly, Open)
    | Glyph c ?& c = ')' => bracket (Round, Close)
    | Glyph c ?& c = ']' => bracket (Square, Close)
    | Glyph c ?& c = '}' => bracket (Curly, Close)
    | _ => LexError (start::from, "`(`,`[`,`{`,`}`,`]` or `)`")

:~ escaped_token (c : char) : spiral_token =
    ? c = 'n'
    ?> TokEscapedChar '\n'
    |? c = 'r'
    ?> TokEscapedChar '\r'
    |? c = 't'
    ?> TokEscapedChar '\t'
    |? c = 'b'
    ?> TokEscapedChar '\b'
    |: TokUnescapedChar c

:~ ^ quoted_text
    (state : lex_state)
    (segment : cursor)
    (at : cursor)
    (tokens : list (span * spiral_token))
    : lexed_tokens
    =
    := flushed () =
        ? segment::from < at::from
        ?> (span_between segment at, TokText (text_between segment at)) :: tokens
        |: tokens
    ?= peek at ?|
    | LineEnd => LexFailure (at::from, "character or \"")
    | Glyph c ?& c = '"' =>
        := stop = at |> advance 1
        LexedTokens (listm::rev ((span_between at stop, TokStringClose) :: flushed ()), skip_spaces stop, state)
    | Glyph c ?& c = '\\' =>
        ?= peek_at 1 at ?|
        | LineEnd => LexFailure (at::from + 1, "character")
        | Glyph escaped =>
            := stop = at |> advance 2
            quoted_text state stop stop ((span_between at stop, escaped_token escaped) :: flushed ())
    | Glyph _ => quoted_text state segment (at |> advance 1) tokens

:~ lex_string_quoted (state : lex_state) (start : cursor) : lexed_tokens =
    ? char_at_is 0 '"' start ?>
        := body = start |> advance 1
        quoted_text state body body [ (span_between start body, TokStringOpen) ]
    |: LexFailure (start::from, "\"")

:~ ^ triple_close_from (quotes : i32) (at : cursor) : option cursor =
    ?= peek at ?|
    | LineEnd => None
    | Glyph c ?& c = '"' =>
        := run_end = at |> skip_while (\ c => c = '"')
        ? quotes <= run_end::from - at::from ?> Some at |: triple_close_from quotes run_end
    | Glyph _ => at |> advance 1 |> triple_close_from quotes

:~ lex_triple_body (state : lex_state) (body : cursor) : lexed_tokens =
    ?= triple_close_from state::triple_quotes body ?|
    | Some run =>
        := run_end = run |> skip_while (\ c => c = '"')
        := close = { run_end ?| from = run_end::from - state::triple_quotes }
        := closing = [ (span_between close run_end, TokStringClose) ]
        := text = span_between body close, TokText (text_between body close)
        := tokens = ? body::from < close::from ?> text :: closing |: closing
        LexedTokens (tokens, run_end, { state ?| triple_quotes = 0 })
    | None =>
        := stop = { body ?| from = sm'::length body::text }
        LexedTokens ([ (span_between body stop, TokText (text_between body stop ++# "\n")) ], stop, state)

:~ lex_triple_open (state : lex_state) (start : cursor) : lexed_tokens =
    ? char_at_is 0 '"' start && char_at_is 1 '"' start && char_at_is 2 '"' start ?>
        := run = (start |> skip_while (\ c => c = '"'))::from - start::from
        := quotes = ? run = 6 ?> 3 |: run
        := body = start |> advance quotes
        := opening = span_between start body, TokStringOpen
        ?= lex_triple_body { state ?| triple_quotes = quotes } body ?|
        | LexedTokens (tokens, rest, next) => LexedTokens (opening :: tokens, skip_spaces rest, next)
        | failure => failure
    |: LexFailure (start::from, "triple-string: not a triple opener nor continuation")

:~ ^ token_tags (tokens : list (span * spiral_token)) : string =
    := tag token =
        ?= token ?|
        | TokStringOpen => "open"
        | TokStringClose => "close"
        | TokText text => "text:" ++# text
        | TokEscapedChar _ => "esc"
        | TokUnescapedChar _ => "unesc"
        | _ => "other"
    ?= tokens ?|
    | [] => ""
    | [ (_, token) ] => tag token
    | (_, token) :: rest => tag token ++# " " ++# token_tags rest

:= lexed_tokens_summary (result : lexed_tokens) : string * i32 * i32 =
    ?= result ?|
    | LexedTokens (tokens, rest, state) => token_tags tokens, rest::from, state::triple_quotes
    | LexFailure (at, message) => message, at, -1

///> rust
///> fsharp
///> gleam
:# lex_bracket_reads_each_bracket =
    ? cursor_of "( x" |> lex_bracket |> lexed_summary <> (8, 1, 2) ?> failwith "an open round bracket"
    ? cursor_of "}" |> lex_bracket |> lexed_summary <> (8, 1, 1) ?> failwith "a close curly bracket"
    ? cursor_of "a" |> lex_bracket |> lexed_summary <> (-1, 0, -1) ?> failwith "a letter is no bracket"

///> rust
///> fsharp
///> gleam
:# lex_string_quoted_splits_text_and_escapes =
    := clean = lex_state_init ()
    := summary text = cursor_of text |> lex_string_quoted clean |> lexed_tokens_summary
    ? summary "\"ab\" x" <> ("open text:ab close", 5, 0) ?> failwith "a plain string"
    ? summary "\"a\\nb\"" <> ("open text:a esc text:b close", 6, 0) ?> failwith "an escape splits the text"
    ? summary "\"a\\qb\"" <> ("open text:a unesc text:b close", 6, 0) ?> failwith "an unknown escape is unescaped"
    ? summary "\"\"" <> ("open close", 2, 0) ?> failwith "an empty string has no text"
    ? summary "\"ab" <> ("character or \"", 3, -1) ?> failwith "an unclosed string"

///> rust
///> fsharp
///> gleam
:# lex_triple_strings_open_close_and_continue =
    := clean = lex_state_init ()
    := opened text = cursor_of text |> lex_triple_open clean |> lexed_tokens_summary
    ? opened "\"\"\"abc\"\"\" x" <> ("open text:abc close", 10, 0) ?> failwith "a one-line raw string"
    ? opened "\"\"\"abc" <> ("open text:abc\n", 6, 3) ?> failwith "an unclosed raw string goes on"
    ? opened "\"\"\"\"\"\"" <> ("open close", 6, 0) ?> failwith "six quotes are the empty string"
    ? opened "\"\"\"\"x\"\"\"\"" <> ("open text:x close", 9, 0) ?> failwith "four quotes close with four"
    ? opened "\"\"\" a \"\" b \"\"\"" <> ("open text: a \"\" b  close", 14, 0) ?> failwith "short runs are text"
    := inside = { clean ?| triple_quotes = 3 }
    := continued = cursor_of "end\"\"\" tail" |> lex_triple_body inside |> lexed_tokens_summary
    ? continued <> ("text:end close", 6, 0) ?> failwith "a continued raw string closes"

:== token_row = span * spiral_token

:~ as_tokens (state : lex_state) (result : lexed) : lexed_tokens =
    ?= result ?|
    | Lexed (range, token, rest) => LexedTokens ([ (range, token) ], rest, state)
    | LexError (at, message) => LexFailure (at, message)

:~ number_tokens (state : lex_state) (result : lexed_number) : lexed_tokens =
    ?= result ?|
    | NumberSuffixed (value, literal, suffix, rest) => LexedTokens ([ (value, TokValue literal); (suffix, TokValueSuffix) ], skip_spaces rest, state)
    | NumberPlain (range, text, rest) => LexedTokens ([ (range, TokDefaultValue text) ], skip_spaces rest, state)
    | NumberError (at, message) => LexFailure (at, message)

:~ comment_tokens (state : lex_state) (start : cursor) : lexed_tokens =
    := result, next = lex_comment state start
    ?= result ?|
    | Lexed (_, _, rest) => LexedTokens ([], skip_spaces rest, next)
    | LexError (at, message) => LexFailure (at, message)

:~ hex_digit_value (c : char) : i32 =
    ? is_digit c ?> code c - code '0' |? in_range 'a' 'f' c ?> code c - code 'a' + 10 |: code c - code 'A' + 10

:~ ^ hex_value (text : string) (i : i32) (acc : i32) : i32 =
    ? i >= sm'::length text ?> acc |: hex_value text (i + 1) (acc * 16 + hex_digit_value (sm'::index i text))

:~ hex_token (state : lex_state) (start : cursor) (digits : cursor) (past : cursor) : lexed_tokens =
    := value = TokValue (LitInt32 (hex_value (text_between digits past) 0 0))
    LexedTokens ([ (span_between start past, value) ], skip_spaces past, state)

:~ lex_hex (state : lex_state) (start : cursor) : lexed_tokens =
    ? char_at_is 0 '0' start && (char_at_is 1 'x' start || char_at_is 1 'X' start) ?>
        := digits = start |> advance 2
        := past = digits |> skip_while is_hex_digit
        ? past::from = digits::from ?> LexFailure (digits::from, "hexadecimal digit") |: hex_token state start digits past
    |: LexFailure (start::from, "0x prefix")

:~ raw_token (state : lex_state) (start : cursor) (body : cursor) (close : cursor) : lexed_tokens =
    := after = close |> advance 1
    LexedTokens ([ (span_between start after, TokValue (LitString (text_between body close))) ], skip_spaces after, state)

:~ lex_raw_string (state : lex_state) (start : cursor) : lexed_tokens =
    ? char_at_is 0 '@' start && char_at_is 1 '"' start ?>
        := body = start |> advance 2
        := close = body |> skip_while (\ c => c <> '"')
        ? peek close = LineEnd ?> LexFailure (close::from, "\"") |: raw_token state start body close
    |: LexFailure (start::from, "@\"")

:~ or_else (start : cursor) (next : () -> lexed_tokens) (first : lexed_tokens) : lexed_tokens =
    ?= first ?|
    | LexFailure (at, _) ?& at = start::from => next ()
    | result => result

:~ lex_word_like (state : lex_state) (start : cursor) : lexed_tokens =
    lex_var start |> as_tokens state
    |> or_else start (\ () => lex_symbol start |> as_tokens state)
    |> or_else start (\ () => lex_raw_string state start)
    |> or_else start (\ () => lex_char_quoted start |> as_tokens state)

:~ lex_mark_like (state : lex_state) (start : cursor) : lexed_tokens =
    comment_tokens state start
    |> or_else start (\ () => lex_bracket start |> as_tokens state)
    |> or_else start (\ () => lex_operator start |> as_tokens state)

:~ macro_kind_of (c : char) : macro_kind = ? c = '`' ?> MType |? c = '@' ?> MTypeLit |? c = '#' ?> MTermInline |: MTerm

:~ macro_start_char (c : char) : bool = c = '`' || c = '!' || c = '@' || c = '#'

:~ macro_text_char (close : char) (c : char) : bool = c <> close && not (macro_start_char c) && c <> '\\'

:~ macro_escape_token (c : char) : spiral_token = ? c = 'v' ?> TokEscapedVar |: escaped_token c

:~ shifted (by : i32) ((range, token) : token_row) : token_row = ({ from = range::from + by; near_to = range::near_to + by }, token)

:~ ^ paren_end (at : cursor) (depth : i32) : option cursor =
    ?= peek at ?|
    | LineEnd => None
    | Glyph c ?& c = '(' => paren_end (at |> advance 1) (depth + 1)
    | Glyph c ?& c = ')' => ? depth = 1 ?> Some at |: paren_end (at |> advance 1) (depth - 1)
    | Glyph _ => paren_end (at |> advance 1) depth

:~ macro_expression (inner : string -> list token_row) (kind : macro_kind) (start : cursor) (close_at : cursor) : list token_row * cursor =
    := body = start |> advance 2
    := after = close_at |> advance 1
    := middle = inner (text_between body close_at) |> listm::map (shifted body::from)
    := opening = span_between start body, TokMacroExpression (kind, Open)
    (opening :: listm::append middle [ (span_between close_at after, TokMacroExpression (kind, Close)) ], after)

:~ var_backs_off (close : char) (name : string) (past : cursor) : bool =
    := rest = sm'::slice past::from (sm'::length past::text - 1) past::text
    := ends = (sm'::length name : i32) > 1 && sm'::ends_with (sm'::of_char close) name
    is_var_char close && ends && not (sm'::contains (sm'::of_char close) rest || sm'::ends_with "\\" (sm'::trim_end [ ' ' ] rest))

:~ macro_var_end (close : char) (start : cursor) : cursor =
    := past = start |> skip_while is_var_char
    ? var_backs_off close (text_between start past) past ?> past |> advance -1 |: past

:~ macro_var_token (kind : macro_kind) (name : string) : spiral_token =
    ?= kind ?|
    | MType => TokMacroTypeVar name
    | MTypeLit => TokMacroTypeLitVar name
    | MTermInline => TokMacroTermVar (name, TermInline)
    | MTermBorrowed => TokMacroTermVar (name, TermBorrowed)
    | MTerm => TokMacroTermVar (name, TermPlain)

:~ macro_var (close : char) (kind : macro_kind) (start : cursor) (name_at : cursor) : list token_row * cursor =
    := past = macro_var_end close name_at
    ([ (span_between start past, macro_var_token kind (text_between name_at past)) ], past)

:~ macro_unescaped (c : char) (start : cursor) : list token_row * cursor =
    := past = start |> advance 2
    ([ (span_between start past, TokUnescapedChar c) ], past)

:~ macro_named (close : char) (kind : macro_kind) (start : cursor) (name_at : cursor) : option (list token_row * cursor) =
    ? peek name_at |> glyph_is is_var_char_starting ?> Some (macro_var close kind start name_at) |: None

:~ macro_expr (inner : string -> list token_row) (close : char) (c : char) (start : cursor) : option (list token_row * cursor) =
    := next = start |> advance 1
    := kind = macro_kind_of c
    ? char_at_is 0 '(' next ?> paren_end (next |> advance 1) 1 |> optionm::map (macro_expression inner kind start)
    |? char_at_is 0 c next ?> Some (macro_unescaped c start)
    |? c = '!' && char_at_is 0 '&' next ?> macro_named close MTermBorrowed start (next |> advance 1)
    |: macro_named close kind start next

:~ macro_close_token (state : lex_state) (at : cursor) (acc : list token_row) : lexed_tokens =
    := after = at |> advance 1
    LexedTokens (listm::rev ((span_between at after, TokMacroClose) :: acc), skip_spaces after, state)

:~ macro_text (close : char) (at : cursor) : token_row * cursor =
    := past = at |> skip_while (macro_text_char close)
    ((span_between at past, TokText (text_between at past)), past)

:~ ^ macro_parts (inner : string -> list token_row) (state : lex_state) (close : char) (at : cursor) (acc : list token_row) : lexed_tokens =
    := more (rows : list token_row) (rest : cursor) = macro_parts inner state close rest (listm::append (listm::rev rows) acc)
    ?= peek at ?|
    | LineEnd => LexFailure (at::from, sm'::of_char close)
    | Glyph c ?& c = close => macro_close_token state at acc
    | Glyph c ?& c = '\\' && peek_at 1 at = LineEnd => LexedTokens (listm::rev acc, at |> advance 1, { state ?| macro_close = Some close })
    | Glyph c ?& c = '\\' => more [ (span_between at (at |> advance 2), macro_escape_token (sm'::index (at::from + 1) at::text)) ] (at |> advance 2)
    | Glyph c ?& macro_start_char c =>
        ?= macro_expr inner close c at ?|
        | Some (rows, rest) => more rows rest
        | None => LexFailure (at::from, "macro expression")
    | Glyph _ =>
        := row, rest = macro_text close at
        more [ row ] rest

:~ lex_macro (inner : string -> list token_row) (state : lex_state) (start : cursor) : lexed_tokens =
    ? char_at_is 0 '$' start && (char_at_is 1 '"' start || char_at_is 1 '\'' start) ?>
        := close = sm'::index (start::from + 1) start::text
        := body = start |> advance 2
        ?= macro_parts inner state close body [] ?|
        | LexedTokens (rows, rest, next) => LexedTokens ((span_between start body, TokMacroOpen) :: rows, rest, next)
        | failure => failure
    |: LexFailure (start::from, "$\" or $'")

:~ lex_token (inner : string -> list token_row) (state : lex_state) (start : cursor) : lexed_tokens =
    lex_macro inner state start
    |> or_else start (\ () => lex_triple_open state start)
    |> or_else start (\ () => lex_string_quoted state start)
    |> or_else start (\ () => lex_hex state start)
    |> or_else start (\ () => lex_number start |> number_tokens state)
    |> or_else start (\ () => lex_word_like state start)
    |> or_else start (\ () => lex_mark_like state start)

:== line_lexed = { tokens : list token_row; state : lex_state; error : option (i32 * string) }

:~ line_done (acc : list token_row) (state : lex_state) (error : option (i32 * string)) : line_lexed =
    { tokens = listm::rev acc; state = state; error = error }

:~ step_failed (at : cursor) (result : lexed_tokens) : option (i32 * string) =
    ?= result ?|
    | LexedTokens (_, rest, _) ?& rest::from <= at::from => Some (at::from, "tokenizer: zero-length token")
    | LexedTokens _ => None
    | LexFailure (pos, message) => Some (pos, message)

:~ ^ tokens_from (inner : string -> list token_row) (state : lex_state) (at : cursor) (acc : list token_row) : line_lexed =
    ?= peek at ?|
    | LineEnd => line_done acc state None
    | Glyph c ?& c = '\t' => line_done acc state (Some (at::from, "Tabs are not allowed."))
    | Glyph _ =>
        := result = lex_token inner state at
        ?= result ?|
        | LexedTokens (tokens, rest, next) ?& step_failed at result = None => tokens_from inner next rest (listm::append (listm::rev tokens) acc)
        | _ => line_done acc state (step_failed at result)

:~ continued_triple (state : lex_state) (at : cursor) : list token_row * cursor * lex_state =
    ?= lex_triple_body state at ?|
    | LexedTokens (tokens, rest, next) => (tokens, rest, next)
    | LexFailure _ => ([], at, state)

:~ continued_macro (inner : string -> list token_row) (state : lex_state) (close : char) (at : cursor) : list token_row * cursor * lex_state =
    ?= macro_parts inner { state ?| macro_close = None } close (skip_spaces at) [] ?|
    | LexedTokens (tokens, rest, next) => (tokens, rest, next)
    | LexFailure _ => ([], at, { state ?| macro_close = None })

:~ line_start (inner : string -> list token_row) (state : lex_state) (text : string) : list token_row * cursor * lex_state =
    := at = cursor_of text
    ? 0 < state::comment_depth ?>
        := stop, depth = comment_scan text 0 state::comment_depth
        ([], { at ?| from = stop }, { state ?| comment_depth = depth })
    |? in_triple state ?> continued_triple state at
    |:
        ?= state::macro_close ?|
        | Some close => continued_macro inner state close at
        | None => ([], at, state)

:~ ^ tokenize_line (state : lex_state) (text : string) : line_lexed =
    := inner sub = (tokenize_line (lex_state_init ()) sub)::tokens
    := first, at, started = line_start inner state text
    := rest = tokens_from inner started (skip_spaces at) []
    { rest ?| tokens = listm::append first rest::tokens }

:~ utf16_column (text : string) (native : i32) : i32 =
    backend_switch {
        Fsharp = \ () => $'System.Text.Encoding.UTF8.GetBytes(!text: string) |> Seq.truncate !native |> Seq.sumBy (fun b -> if b &&& 0xC0uy = 0x80uy then 0 elif b >= 0xF0uy then 2 else 1)' : i32
        Rust = \ () => $'(&(*!text)).as_bytes().iter().take(!native as usize).map(|b| if b & 0xC0 == 0x80 { 0i32 } else if *b >= 0xF0 { 2i32 } else { 1i32 }).sum::<i32>()' : i32
        Gleam = \ () =>
            global "import gleam/string"
            global "import gleam/list"
            global "import gleam/bit_array"
            $'case bit_array.slice(<<!text:utf8>>, 0, !native) { Ok(prefix) -> case bit_array.to_string(prefix) { Ok(head) -> list.fold(string.to_utf_codepoints(head), 0, fn(units, cp) { case string.utf_codepoint_to_int(cp) > 65535 { True -> units + 2 False -> units + 1 } }) Error(_) -> !native } Error(_) -> !native }' : i32
    }

:~ utf16_row (text : string) ((range, token) : token_row) : token_row =
    ({ from = utf16_column text range::from; near_to = utf16_column text range::near_to }, token)

:~ ascii_text (text : string) : bool =
    backend_switch {
        Fsharp = \ () => $'String.forall (fun c -> int c < 128) !text' : bool
        Rust = \ () => $'(&(*!text)).is_ascii()' : bool
        Gleam = \ () =>
            global "import gleam/string"
            $'string.byte_size(!text) == string.length(!text)' : bool
    }

:~ editor_line (state : lex_state) (text : string) : line_lexed =
    := lexed = tokenize_line state text
    ? ascii_text text ?> lexed |:
        := error = lexed::error |> optionm::map (\ ((at, message) : i32 * string) => (utf16_column text at, message))
        { lexed ?| tokens = listm::map (utf16_row text) lexed::tokens; error = error }

:~ legend_word (legend : semantic_token_legend) : string =
    ?= legend ?|
    | LegendVariable => "variable"
    | LegendSymbol => "symbol"
    | LegendString => "string"
    | LegendNumber => "number"
    | LegendOperator => "operator"
    | LegendUnaryOperator => "unary_operator"
    | LegendComment => "comment"
    | LegendKeyword => "keyword"
    | LegendParenthesis => "parenthesis"
    | LegendTypeVariable => "type_variable"
    | LegendEscapedChar => "escaped_char"
    | LegendUnescapedChar => "unescaped_char"
    | LegendNumberSuffix => "number_suffix"
    | LegendEscapedVar => "escaped_var"

:~ legend_name (token : spiral_token) : string = legend_word (token_group token)

:~ token_line_row (line : i32) ((range, token) : token_row) : string =
    sm'::concat_list "\t" [ sm'::format line; sm'::format range::from; sm'::format range::near_to; legend_name token ]

:~ ^ rendered_rows (state : lex_state) (lines : list string) (line : i32) (acc : list string) : list string =
    ?= lines ?|
    | [] => listm::rev acc
    | text :: rest =>
        := lexed = editor_line state text
        := rows = listm::map (token_line_row line) lexed::tokens
        rendered_rows lexed::state rest (line + 1) (listm::append (listm::rev rows) acc)

:~ render (text : string) : string =
    := rows = rendered_rows (lex_state_init ()) (sm'::split_list "\n" (sm'::replace "\r\n" "\n" text)) 0 []
    sm'::concat_list "" (listm::map (\ row => row ++# "\n") rows)

:~ line_legends (text : string) : string =
    sm'::concat_list " " (listm::map (\ ((_, token) : token_row) => legend_name token) (editor_line (lex_state_init ()) text)::tokens)

:~ line_spans (text : string) : string =
    := span_text ((range, _) : token_row) = sm'::format range::from ++# "-" ++# sm'::format range::near_to
    sm'::concat_list " " (listm::map span_text (editor_line (lex_state_init ()) text)::tokens)

:~ decl_line () : string = ":= x (a : i32) : i32 = a + 0x1F + 12i32 - 3.5"

///> rust
///> fsharp
///> gleam
:# a_declaration_line_has_the_fsharp_token_classes =
    := classes = "keyword variable parenthesis variable operator variable parenthesis operator variable operator variable operator number operator number number_suffix operator number"
    ? line_legends (decl_line ()) <> classes ?> failwith ("classes differ from TokensCli: " ++# line_legends (decl_line ()))

///> rust
///> fsharp
///> gleam
:# a_declaration_line_has_the_fsharp_token_spans =
    := spans = "0-2 3-4 5-6 6-7 8-9 10-13 13-14 15-16 17-20 21-22 23-24 25-26 27-31 32-33 34-36 36-39 40-41 42-45"
    ? line_spans (decl_line ()) <> spans ?> failwith ("spans differ from TokensCli: " ++# line_spans (decl_line ()))

:~ cont_text () : string = "(* open\nstill (* nested *) *) x .y\n\"a\\nb\" @\"raw\" 7u8\n"

:~ cont_rows () : string =
    := first = "1\t22\t23\tvariable\n1\t24\t26\tsymbol\n2\t0\t1\tstring\n2\t1\t2\tstring\n2\t2\t4\tescaped_char\n"
    first ++# "2\t4\t5\tstring\n2\t5\t6\tstring\n2\t7\t13\tstring\n2\t14\t15\tnumber\n2\t15\t17\tnumber_suffix\n"

///> rust
///> fsharp
///> gleam
:# a_comment_continues_and_strings_split_like_tokens_cli =
    ? render (cont_text ()) <> cont_rows () ?> failwith ("rows differ from TokensCli:\n" ++# render (cont_text ()))

:~ macro_line () : string = "$'!x + !(a b) + `t + @n + #y + !&z !! \\n \\v'"

:~ macro_classes () : string =
    := head = "string variable string parenthesis variable variable parenthesis string type_variable string type_variable string "
    head ++# "variable string variable string unescaped_char string escaped_char string escaped_var string"

///> rust
///> fsharp
///> gleam
:# a_macro_line_has_the_fsharp_token_classes =
    ? line_legends (macro_line ()) <> macro_classes () ?> failwith ("macro classes differ from TokensCli: " ++# line_legends (macro_line ()))

///> rust
///> fsharp
///> gleam
:# a_macro_line_has_the_fsharp_token_spans =
    := spans = "0-2 2-4 4-7 7-9 9-10 11-12 12-13 13-16 16-18 18-21 21-23 23-26 26-28 28-31 31-34 34-35 35-37 37-38 38-40 40-41 41-43 43-44"
    ? line_spans (macro_line ()) <> spans ?> failwith ("macro spans differ from TokensCli: " ++# line_spans (macro_line ()))

:~ term_mode_word (row : token_row) : string =
    ?= row ?|
    | (_, TokMacroTermVar (_, TermPlain)) => "plain "
    | (_, TokMacroTermVar (_, TermInline)) => "inline "
    | (_, TokMacroTermVar (_, TermBorrowed)) => "borrowed "
    | _ => ""

///> rust
///> fsharp
///> gleam
:# a_borrowed_macro_var_keeps_its_mode_like_the_reference =
    := rows = (editor_line (lex_state_init ()) "$'!x #y !&z'")::tokens
    := modes = sm'::concat_list "" (listm::map term_mode_word rows)
    ? modes <> "plain inline borrowed " ?> failwith ("macro term modes differ from TokensCli: " ++# modes)

:~ macro_cont_text () : string = "$\"f(!q, \\\n  !(c))\" x\n$'!a'\n"

:~ macro_cont_rows () : string =
    := first = "0\t0\t2\tstring\n0\t2\t4\tstring\n0\t4\t6\tvariable\n0\t6\t8\tstring\n1\t2\t4\tparenthesis\n1\t4\t5\tvariable\n"
    first ++# "1\t5\t6\tparenthesis\n1\t6\t7\tstring\n1\t7\t8\tstring\n1\t9\t10\tvariable\n2\t0\t2\tstring\n2\t2\t4\tvariable\n2\t4\t5\tstring\n"

///> rust
///> fsharp
///> gleam
:# a_macro_continues_across_a_line_and_backs_off_its_closing_quote =
    ? render (macro_cont_text ()) <> macro_cont_rows () ?> failwith ("macro rows differ from TokensCli:\n" ++# render (macro_cont_text ()))

:~ wide_line () : string = ":= 루프 = \"é😀x\" + y"

///> rust
///> fsharp
///> gleam
:# wide_chars_count_as_utf16_units_like_tokens_cli =
    ? line_spans (wide_line ()) <> "0-2 3-5 6-7 8-9 9-13 13-14 15-16 17-18" ?> failwith ("wide spans differ from TokensCli: " ++# line_spans (wide_line ()))

///> rust
///> fsharp
///> gleam
:# only_pure_ascii_lines_skip_the_utf16_conversion =
    ? not (ascii_text (decl_line ())) || ascii_text (wide_line ()) || ascii_text "x = 'é'" ?> failwith "ascii_text misclassifies a line"
