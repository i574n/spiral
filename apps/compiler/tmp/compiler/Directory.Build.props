<Project>
  <!--
    One host, one compiler core (../../spiral_compiler.fs). `SpiralCore` selects the build: single-flight (the
    sequential evaluator) or hopacsota (single-flight plus the parallel layer, SPIRAL_CORE_HOPACSOTA).
    All build output goes to an external cache so the bundle never contains obj/bin trees.
  -->
  <PropertyGroup>
    <SpiralCore Condition="'$(SpiralCore)' == ''">single-flight</SpiralCore>
    <SpiralCacheDir Condition="'$(SpiralCacheDir)' == '' and '$(SPIRAL_BIN_CACHE_DIR)' != ''">$(SPIRAL_BIN_CACHE_DIR)</SpiralCacheDir>
    <SpiralCacheDir Condition="'$(SpiralCacheDir)' == '' and '$(LOCALAPPDATA)' != ''">$(LOCALAPPDATA)/spiral-bin</SpiralCacheDir>
    <SpiralCacheDir Condition="'$(SpiralCacheDir)' == ''">$(HOME)/.cache/spiral-bin</SpiralCacheDir>
    <SpiralSharedCacheDir Condition="'$(LOCALAPPDATA)' != ''">$(LOCALAPPDATA)/spiral-bin</SpiralSharedCacheDir>
    <SpiralSharedCacheDir Condition="'$(SpiralSharedCacheDir)' == ''">$(HOME)/.cache/spiral-bin</SpiralSharedCacheDir>
    <SpiralDetRoot Condition="'$(SPIRAL_DET_ROOT)' != ''">$(SPIRAL_DET_ROOT)</SpiralDetRoot>
    <SpiralDetRoot Condition="'$(SpiralDetRoot)' == '' and '$(LOCALAPPDATA)' != ''">C:\home\spiral-cache</SpiralDetRoot>
    <SpiralDetRoot Condition="'$(SpiralDetRoot)' == ''">$(HOME)/spiral-cache</SpiralDetRoot>
    <TargetFrameworkMonikerAssemblyAttributesPath>$(SpiralDetRoot)/obj-shared/$(MSBuildProjectName)/$(TargetFramework).AssemblyAttributes.fs</TargetFrameworkMonikerAssemblyAttributesPath>
    <BaseIntermediateOutputPath>$(SpiralCacheDir)/obj/$(SpiralCore)/$(MSBuildProjectName)/</BaseIntermediateOutputPath>
    <MSBuildProjectExtensionsPath>$(BaseIntermediateOutputPath)</MSBuildProjectExtensionsPath>
    <BaseOutputPath>$(SpiralCacheDir)/bin/$(SpiralCore)/$(MSBuildProjectName)/</BaseOutputPath>
    <TargetFramework>net11.0</TargetFramework>
    <LangVersion>preview</LangVersion>
    <RollForward>Major</RollForward>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- CCMR Phase-2: keep git/checkout-specific data out of the PDB so the dll debug dir is machine-independent. -->
    <EnableSourceLink>false</EnableSourceLink>
    <EnableSourceControlManagerQueries>false</EnableSourceControlManagerQueries>
    <EmbedUntrackedSources>false</EmbedUntrackedSources>
    <EmbedAllSources>false</EmbedAllSources>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <RestoreIgnoreFailedSources>true</RestoreIgnoreFailedSources>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);FS0064;FS3370;FS0025;FS0049;FS1182;FS3560</NoWarn>
  </PropertyGroup>
</Project>
