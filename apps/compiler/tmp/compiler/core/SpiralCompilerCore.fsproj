<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The compiler core as its own assembly, so host edits (Program.fs) never
    recompile the monolith. The core is apps/compiler/spiral_compiler.fs: -p:SpiralCore=hopacsota defines
    SPIRAL_CORE_HOPACSOTA, which adds the parallel evaluation layer; -p:SpiralCore=single-flight leaves it
    undefined. -p:SpiralCoreSource=<path> builds any other copy.
  -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <AssemblyName>SpiralCompilerCore</AssemblyName>
    <RootNamespace>Spiral</RootNamespace>
    <SpiralCoreSource Condition="'$(SpiralCoreSource)' == ''">../../../spiral_compiler.fs</SpiralCoreSource>
    <Tailcalls>true</Tailcalls>
  </PropertyGroup>
  <PropertyGroup Condition="'$(SpiralCore)' == 'hopacsota'">
    <DefineConstants>$(DefineConstants);SPIRAL_CORE_HOPACSOTA</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(SpiralCoreSource)" Link="spiral_compiler.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../runtime-compat/SpiralCompilerRuntimeCompat.fsproj" />
  </ItemGroup>
  <Import Project="../lib/References.props" />
</Project>
