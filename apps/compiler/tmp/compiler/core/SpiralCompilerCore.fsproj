<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The compiler core as its own assembly, so host edits (Program.fs, PortableBackends.fs) never
    recompile the monolith. -p:SpiralCore=single-flight builds the repo's main core
    (apps/compiler/spiral_compiler.fs), -p:SpiralCore=hopac builds cores/hopac/spiral_compiler.fs;
    -p:SpiralCoreSource=<path> builds any other copy.
  -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <AssemblyName>SpiralCompilerCore</AssemblyName>
    <RootNamespace>Polyglot</RootNamespace>
    <SpiralCoreSource Condition="'$(SpiralCoreSource)' == '' and '$(SpiralCore)' == 'single-flight'">../../../spiral_compiler.fs</SpiralCoreSource>
    <SpiralCoreSource Condition="'$(SpiralCoreSource)' == ''">../cores/$(SpiralCore)/spiral_compiler.fs</SpiralCoreSource>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(SpiralCoreSource)" Link="spiral_compiler.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../runtime-compat/SpiralCompilerRuntimeCompat.fsproj" />
  </ItemGroup>
  <Import Project="../lib/References.props" />
</Project>
