<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The compiler executable. Build with -p:SpiralCore=single-flight (default) or -p:SpiralCore=hopacsota.
    Program.fs talks to the core only through SupervisorReq (built by reflection), new_server and
    startupParse. The core is a separate assembly (../core), so editing the host rebuilds in seconds.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>SpiralCompiler</AssemblyName>
    <RootNamespace>Spiral</RootNamespace>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
  </PropertyGroup>
  <PropertyGroup Condition="'$(SpiralCore)' == 'single-flight'">
    <DefineConstants>$(DefineConstants);SPIRAL_CORE_SINGLE_FLIGHT</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(SpiralCore)' == 'hopacsota'">
    <DefineConstants>$(DefineConstants);SPIRAL_CORE_SINGLE_FLIGHT;SPIRAL_CORE_HOPACSOTA</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(SpiralHostSource)" Condition="'$(SpiralHostSource)' != ''" />
    <Compile Include="Program.fs" Condition="'$(SpiralHostSource)' == ''" />
    <!-- The C++/CUDA and Python backends' runtime (apps/compiler/runtime, upstream corelib + CPU-host deltas):
         CodegenCpp/CodegenPython read it next to the compiler binary. -->
    <None Include="..\..\..\runtime\corelib.cuh;..\..\..\runtime\corelib.py" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../runtime-compat/SpiralCompilerRuntimeCompat.fsproj" />
    <ProjectReference Include="../core/SpiralCompilerCore.fsproj" />
  </ItemGroup>
  <Import Project="../lib/References.props" />
</Project>
