:= main () : i32 =
    := ~n = 4i32
    := ~lhs : array u8 = create n
    := ~rhs : array u8 = create n
    set lhs 0i32 65u8
    set lhs 1i32 66u8
    set lhs 2i32 67u8
    set lhs 3i32 68u8
    set rhs 0i32 65u8
    set rhs 1i32 66u8
    set rhs 2i32 67u8
    set rhs 3i32 69u8
    := ~prefix_count = 3i32
    := ~full_count = 4i32
    := ~prefix_order = $"spiral_abi_libc_memcmp(!lhs,!rhs,!prefix_count)" : i32
    := ~full_order = $"spiral_abi_libc_memcmp(!lhs,!rhs,!full_count)" : i32
    ? (=.) prefix_order 0i32 ?>
        ? (=.) full_order 0i32 ?> 2i32
        |? (=.) (index lhs 3i32) 68u8 ?>
            ? (=.) (index rhs 3i32) 69u8 ?> 0i32 |: 4i32
        |: 3i32
    |: 1i32
