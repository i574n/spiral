:= main () : i32 =
    := ~n = 4i32
    := ~buffer : array u8 = create n
    set buffer 0i32 0
    set buffer 1i32 0
    set buffer 2i32 0
    set buffer 3i32 0
    := ~byte_value = 65i32
    := ~count = 3i32
    := ~written = $"spiral_abi_libc_memset(!buffer,!byte_value,!count)" : i32
    ? (=.) written 3i32 ?>
        ? (=.) (index buffer 0i32) 65 ?>
            ? (=.) (index buffer 1i32) 65 ?>
                ? (=.) (index buffer 2i32) 65 ?>
                    ? (=.) (index buffer 3i32) 0 ?> 0i32 |: 4i32
                |: 3i32
            |: 2i32
        |: 1i32
    |: 5i32
