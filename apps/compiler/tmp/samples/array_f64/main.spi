:! f64_array = array_base f64

:= create (n : i32) : f64_array = f64_array !!!!ArrayCreate(`f64, n)
:= get (array : f64_array) (i : i32) : f64 =
    ?= array ?|
    | f64_array values => !!!!ArrayIndex(values, i)
:= set (array : f64_array) (i : i32) (value : f64) : () =
    ?= array ?|
    | f64_array values => !!!!ArrayIndexSet(values, i, value)

:= main () : i32 =
    := ~n = 2i32
    := a = create n
    := ~x = 1.5f64
    set a 0i32 x
    set a 1i32 2.5f64
    := y = get a 0i32
    ? !!!!EQ(y, 1.5f64) ?> 0i32 |: 1i32
