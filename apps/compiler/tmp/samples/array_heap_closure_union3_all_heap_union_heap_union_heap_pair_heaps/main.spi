union slot =
    | None
    | Held : (heap { value : (heap { value : heap { value : i32 * string } * heap { value : i32 * string } }) * i32 })

union wrap =
    | Absent
    | Box : (heap { value : slot })
    | Mark : i32

nominal box_array = array_base (heap { value : wrap })

inl create (n : i32) : box_array = box_array !!!!ArrayCreate(`(heap { value : wrap }), n)
inl get (values : box_array) (i : i32) : heap { value : wrap } =
    match values with
    | box_array raw => !!!!ArrayIndex(raw, i)
inl set (values : box_array) (i : i32) (value : heap { value : wrap }) : () =
    match values with
    | box_array raw => !!!!ArrayIndexSet(raw, i, value)
let score x : i32 =
    match x with
    | Absent => 1i32
    | Mark k => if k =. 0i32 then 1i32 else 1i32
    | Box box =>
        inl opened = !!!!LayoutIndex(box)
        match opened.value with
        | None => 1i32
        | Held inner =>
            inl inner_opened = !!!!LayoutIndex(inner)
            inl ~(inner_held, flag) = inner_opened.value
            inl deep_opened = !!!!LayoutIndex(inner_held)
            inl ~(left, right) = deep_opened.value
            inl left_opened = !!!!LayoutIndex(left)
            inl ~(a, b) = left_opened.value
            inl right_opened = !!!!LayoutIndex(right)
            inl ~(c, d) = right_opened.value
            if a =. 7i32 && !!!!EQ(b, "hi") && c =. 4i32 && !!!!EQ(d, "yo") && flag =. 2i32 then 0i32 else 1i32

inl main () : i32 =
    inl ~n = 7i32
    inl ~word = "hi"
    inl left_pair = n, word
    inl left_heap = !!!!LayoutToHeap({ value = left_pair })
    inl ~m = 4i32
    inl ~other = "yo"
    inl right_pair = m, other
    inl right_heap = !!!!LayoutToHeap({ value = right_pair })
    inl pair = left_heap, right_heap
    inl inner = !!!!LayoutToHeap({ value = pair })
    inl ~mark = 2i32
    inl outer_pair = inner, mark
    inl outer = !!!!LayoutToHeap({ value = outer_pair })
    inl ~on = true
    inl held = if on then Held outer else None
    inl box = !!!!LayoutToHeap({ value = held })
    inl ~use_box = true
    inl wrapped = if use_box then Box box else Mark 1i32
    inl ~tag = 3i32
    inl marked = Mark tag
    inl absent = Absent
    inl f (z : i32) : wrap =
        if z =. 0i32 then
            absent
        elif z =. 1i32 then
            wrapped
        else
            marked
    inl ~g = f
    inl cover_box = !!!!LayoutToHeap({ value = g 1i32 })
    inl cover_mark = !!!!LayoutToHeap({ value = g 2i32 })
    inl cover_absent = !!!!LayoutToHeap({ value = g 0i32 })
    inl values = create 3i32
    set values 0i32 cover_box
    set values 1i32 cover_mark
    set values 2i32 cover_absent
    inl opened_box = !!!!LayoutIndex(get values 0i32)
    inl opened_mark = !!!!LayoutIndex(get values 1i32)
    inl opened_absent = !!!!LayoutIndex(get values 2i32)
    inl box_score = score opened_box.value
    inl mark_score = score opened_mark.value
    inl absent_score = score opened_absent.value
    if box_score =. 0i32 && mark_score =. 1i32 && absent_score =. 1i32 then 0i32 else 1i32
