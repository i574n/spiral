:! cell_array = array_base (heap { value : i32 * string })

:= create (n : i32) : cell_array = cell_array !!!!ArrayCreate(`(heap { value : i32 * string }), n)
:= get (array : cell_array) (i : i32) : heap { value : i32 * string } =
    ?= array ?|
    | cell_array values => !!!!ArrayIndex(values, i)
:= set (array : cell_array) (i : i32) (value : heap { value : i32 * string }) : () =
    ?= array ?|
    | cell_array values => !!!!ArrayIndexSet(values, i, value)

:= main () : i32 =
    := ~n = 7i32
    := ~word = "hi"
    := pair = n, word
    := cell = !!!!LayoutToHeap({ value = pair })
    := a = create 1i32
    set a 0i32 cell
    := held = get a 0i32
    := opened = !!!!LayoutIndex(held)
    := ~(left, right) = opened::value
    ? left =. 7i32 && !!!!EQ(right, "hi") ?> 0i32 |: 1i32
