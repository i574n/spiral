nominal cell_array = array_base (heap {value : heap {value : i32 * string} * heap {value : i32 * string}})

inl create (n : i32) : cell_array = cell_array !!!!ArrayCreate(`(heap {value : heap {value : i32 * string} * heap {value : i32 * string}}), n)
inl get (array : cell_array) (i : i32) : heap {value : heap {value : i32 * string} * heap {value : i32 * string}} =
    match array with
    | cell_array values => !!!!ArrayIndex(values, i)
inl set (array : cell_array) (i : i32) (value : heap {value : heap {value : i32 * string} * heap {value : i32 * string}}) : () =
    match array with
    | cell_array values => !!!!ArrayIndexSet(values, i, value)

inl main () : i32 =
    inl ~n = 7i32
    inl ~word = "hi"
    inl left_pair = n, word
    inl left_heap = !!!!LayoutToHeap({value = left_pair})
    inl ~m = 4i32
    inl ~other = "yo"
    inl right_pair = m, other
    inl right_heap = !!!!LayoutToHeap({value = right_pair})
    inl pair = left_heap, right_heap
    inl box = !!!!LayoutToHeap({value = pair})
    inl a = create 1i32
    set a 0i32 box
    inl held = get a 0i32
    inl opened = !!!!LayoutIndex(held)
    inl ~(left, right) = opened.value
    inl left_opened = !!!!LayoutIndex(left)
    inl ~(a0, b) = left_opened.value
    inl right_opened = !!!!LayoutIndex(right)
    inl ~(c, d) = right_opened.value
    if a0 =. 7i32 && !!!!EQ(b, "hi") && c =. 4i32 && !!!!EQ(d, "yo") then 0i32 else 1i32
