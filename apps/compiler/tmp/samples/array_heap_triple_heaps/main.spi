:! cell_array =
    array_base
        (heap { value : heap { value : i32 * string } * heap { value : i32 * string } * heap { value : i32 * string } })

:= create (n : i32) : cell_array =
    cell_array
        !!!!ArrayCreate(`(heap { value : heap { value : i32 * string } * heap { value : i32 * string } * heap { value : i32 * string } }), n)
:= get
    (array : cell_array) (i : i32)
    : heap { value : heap { value : i32 * string } * heap { value : i32 * string } * heap { value : i32 * string } }
    =
    ?= array ?|
    | cell_array values => !!!!ArrayIndex(values, i)
:= set
    (array : cell_array) (i : i32)
    (value :
        heap { value : heap { value : i32 * string } * heap { value : i32 * string } * heap { value : i32 * string } })
    : ()
    =
    ?= array ?|
    | cell_array values => !!!!ArrayIndexSet(values, i, value)

:= main () : i32 =
    := ~n = 7i32
    := ~word = "hi"
    := left_pair = n, word
    := left_heap = !!!!LayoutToHeap({ value = left_pair })
    := ~m = 4i32
    := ~other = "yo"
    := mid_pair = m, other
    := mid_heap = !!!!LayoutToHeap({ value = mid_pair })
    := ~k = 9i32
    := ~tail = "ok"
    := right_pair = k, tail
    := right_heap = !!!!LayoutToHeap({ value = right_pair })
    := trip = left_heap, mid_heap, right_heap
    := box = !!!!LayoutToHeap({ value = trip })
    := a = create 1i32
    set a 0i32 box
    := held = get a 0i32
    := opened = !!!!LayoutIndex(held)
    := ~(left, mid, right) = opened::value
    := left_opened = !!!!LayoutIndex(left)
    := ~(p, q) = left_opened::value
    := mid_opened = !!!!LayoutIndex(mid)
    := ~(r, s) = mid_opened::value
    := right_opened = !!!!LayoutIndex(right)
    := ~(t, u) = right_opened::value
    ? p =. 7i32 && !!!!EQ(q, "hi") && r =. 4i32 && !!!!EQ(s, "yo") && t =. 9i32 && !!!!EQ(u, "ok") ?> 0i32 |: 1i32
