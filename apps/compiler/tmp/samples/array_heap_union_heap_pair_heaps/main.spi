:| slot =
    | None
    | Held : (heap { value : (heap { value : heap { value : i32 * string } * heap { value : i32 * string } }) * i32 })

:! box_array = array_base (heap { value : slot })

:= create (n : i32) : box_array = box_array !!!!ArrayCreate(`(heap { value : slot }), n)
:= get (values : box_array) (i : i32) : heap { value : slot } =
    ?= values ?|
    | box_array raw => !!!!ArrayIndex(raw, i)
:= set (values : box_array) (i : i32) (value : heap { value : slot }) : () =
    ?= values ?|
    | box_array raw => !!!!ArrayIndexSet(raw, i, value)

:~ score x : i32 =
    ?= x ?|
    | None => 1i32
    | Held box =>
        := opened = !!!!LayoutIndex(box)
        := ~(inner_held, flag) = opened::value
        := inner_opened = !!!!LayoutIndex(inner_held)
        := ~(left, right) = inner_opened::value
        := left_opened = !!!!LayoutIndex(left)
        := ~(a, b) = left_opened::value
        := right_opened = !!!!LayoutIndex(right)
        := ~(c, d) = right_opened::value
        ? a =. 7i32 && !!!!EQ(b, "hi") && c =. 4i32 && !!!!EQ(d, "yo") && flag =. 2i32 ?> 0i32 |: 1i32

:= main () : i32 =
    := ~n = 7i32
    := ~word = "hi"
    := left_pair = n, word
    := left_heap = !!!!LayoutToHeap({ value = left_pair })
    := ~m = 4i32
    := ~other = "yo"
    := right_pair = m, other
    := right_heap = !!!!LayoutToHeap({ value = right_pair })
    := pair = left_heap, right_heap
    := inner = !!!!LayoutToHeap({ value = pair })
    := ~mark = 2i32
    := outer_pair = inner, mark
    := outer = !!!!LayoutToHeap({ value = outer_pair })
    := ~on = !+
    := held = ? on ?> Held outer |: None
    := box = !!!!LayoutToHeap({ value = held })
    := values = create 1i32
    set values 0i32 box
    := loaded = get values 0i32
    := opened = !!!!LayoutIndex(loaded)
    score opened::value
