:! i16_array = array_base i16

:= create (n : i32) : i16_array = i16_array !!!!ArrayCreate(`i16, n)
:= get (values : i16_array) (i : i32) : i16 =
    ?= values ?|
    | i16_array raw => !!!!ArrayIndex(raw, i)
:= set (values : i16_array) (i : i32) (value : i16) : () =
    ?= values ?|
    | i16_array raw => !!!!ArrayIndexSet(raw, i, value)

:= main () : i32 =
    := values = create 1i32
    := ~n = 20000i16
    set values 0i32 n
    ? get values 0i32 =. 20000i16 ?> 0i32 |: 1i32
