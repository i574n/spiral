:! i8_array = array_base i8

:= create (n : i32) : i8_array = i8_array !!!!ArrayCreate(`i8, n)
:= get (values : i8_array) (i : i32) : i8 =
    ?= values ?|
    | i8_array raw => !!!!ArrayIndex(raw, i)
:= set (values : i8_array) (i : i32) (value : i8) : () =
    ?= values ?|
    | i8_array raw => !!!!ArrayIndexSet(raw, i, value)

:= main () : i32 =
    := values = create 1i32
    := ~n = 100i8
    set values 0i32 n
    ? get values 0i32 =. 100i8 ?> 0i32 |: 1i32
