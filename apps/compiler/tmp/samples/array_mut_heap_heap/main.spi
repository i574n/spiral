nominal cell_array = array_base (mut {value : heap {value : (heap {value : i32 * string}) * i32}})

inl create (n : i32) : cell_array = cell_array !!!!ArrayCreate(`(mut {value : heap {value : (heap {value : i32 * string}) * i32}}), n)
inl get (array : cell_array) (i : i32) : mut {value : heap {value : (heap {value : i32 * string}) * i32}} =
    match array with
    | cell_array values => !!!!ArrayIndex(values, i)
inl set (array : cell_array) (i : i32) (value : mut {value : heap {value : (heap {value : i32 * string}) * i32}}) : () =
    match array with
    | cell_array values => !!!!ArrayIndexSet(values, i, value)

inl main () : i32 =
    inl ~n = 3i32
    inl ~word = "no"
    inl inner_pair = n, word
    inl inner = !!!!LayoutToHeap({value = inner_pair})
    inl ~extra = 1i32
    inl outer_pair = inner, extra
    inl outer = !!!!LayoutToHeap({value = outer_pair})
    inl cell : mut {value : heap {value : (heap {value : i32 * string}) * i32}} = !!!!LayoutToHeapMutable({value = outer})
    inl a = create 1i32
    set a 0i32 cell
    inl ~m = 7i32
    inl ~next = "hi"
    inl next_pair = m, next
    inl next_inner = !!!!LayoutToHeap({value = next_pair})
    inl ~count = 4i32
    inl next_outer_pair = next_inner, count
    inl next_outer = !!!!LayoutToHeap({value = next_outer_pair})
    inl held = get a 0i32
    held <- {value = next_outer}
    inl opened = !!!!LayoutIndex(held)
    inl heap_held = opened.value
    inl outer_opened = !!!!LayoutIndex(heap_held)
    inl ~(inner_held, seen) = outer_opened.value
    inl inner_opened = !!!!LayoutIndex(inner_held)
    inl ~(left, right) = inner_opened.value
    if left =. 7i32 && !!!!EQ(right, "hi") && seen =. 4i32 then 0i32 else 1i32
