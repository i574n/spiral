:! cell_array = array_base (mut { value : heap { value : (heap { value : i32 * string }) * i32 } })

:= create (n : i32) : cell_array =
    cell_array !!!!ArrayCreate(`(mut { value : heap { value : (heap { value : i32 * string }) * i32 } }), n)
:= get (array : cell_array) (i : i32) : mut { value : heap { value : (heap { value : i32 * string }) * i32 } } =
    ?= array ?|
    | cell_array values => !!!!ArrayIndex(values, i)
:= set
    (array : cell_array) (i : i32) (value : mut { value : heap { value : (heap { value : i32 * string }) * i32 } })
    : ()
    =
    ?= array ?|
    | cell_array values => !!!!ArrayIndexSet(values, i, value)

:= main () : i32 =
    := ~n = 3i32
    := ~word = "no"
    := inner_pair = n, word
    := inner = !!!!LayoutToHeap({ value = inner_pair })
    := ~extra = 1i32
    := outer_pair = inner, extra
    := outer = !!!!LayoutToHeap({ value = outer_pair })
    := cell : mut { value : heap { value : (heap { value : i32 * string }) * i32 } } =
        !!!!LayoutToHeapMutable({ value = outer })
    := a = create 1i32
    set a 0i32 cell
    := ~m = 7i32
    := ~next = "hi"
    := next_pair = m, next
    := next_inner = !!!!LayoutToHeap({ value = next_pair })
    := ~count = 4i32
    := next_outer_pair = next_inner, count
    := next_outer = !!!!LayoutToHeap({ value = next_outer_pair })
    := held = get a 0i32
    held <- { value = next_outer }
    := opened = !!!!LayoutIndex(held)
    := heap_held = opened::value
    := outer_opened = !!!!LayoutIndex(heap_held)
    := ~(inner_held, seen) = outer_opened::value
    := inner_opened = !!!!LayoutIndex(inner_held)
    := ~(left, right) = inner_opened::value
    ? left =. 7i32 && !!!!EQ(right, "hi") && seen =. 4i32 ?> 0i32 |: 1i32
