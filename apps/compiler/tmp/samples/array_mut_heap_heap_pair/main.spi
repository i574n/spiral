:! cell_array =
    array_base
        (
            mut
                {
                    value :
                        heap
                            {
                                value :
                                    (heap { value : heap { value : i32 * string } * heap { value : i32 * string } }) *
                                    i32
                            }
                }
        )

:= create (n : i32) : cell_array =
    cell_array
        !!!!ArrayCreate(`(mut { value : heap { value : (heap { value : heap { value : i32 * string } * heap { value : i32 * string } }) * i32 } }), n)
:= get
    (array : cell_array) (i : i32)
    : mut
        {
            value :
                heap
                    { value : (heap { value : heap { value : i32 * string } * heap { value : i32 * string } }) * i32 }
        }
    =
    ?= array ?|
    | cell_array values => !!!!ArrayIndex(values, i)
:= set
    (array : cell_array) (i : i32)
    (value :
        mut
            {
                value :
                    heap
                        {
                            value :
                                (heap { value : heap { value : i32 * string } * heap { value : i32 * string } }) * i32
                        }
            })
    : ()
    =
    ?= array ?|
    | cell_array values => !!!!ArrayIndexSet(values, i, value)

:= main () : i32 =
    := ~n = 1i32
    := ~word = "no"
    := left_pair = n, word
    := left_heap = !!!!LayoutToHeap({ value = left_pair })
    := ~m = 2i32
    := ~other = "zz"
    := right_pair = m, other
    := right_heap = !!!!LayoutToHeap({ value = right_pair })
    := pair = left_heap, right_heap
    := inner = !!!!LayoutToHeap({ value = pair })
    := ~mark = 3i32
    := outer_pair = inner, mark
    := outer = !!!!LayoutToHeap({ value = outer_pair })
    := cell
        : mut
            {
                value :
                    heap
                        {
                            value :
                                (heap { value : heap { value : i32 * string } * heap { value : i32 * string } }) * i32
                        }
            }
        =
        !!!!LayoutToHeapMutable({ value = outer })
    := a = create 1i32
    set a 0i32 cell
    := ~a0 = 7i32
    := ~b0 = "hi"
    := next_left_pair = a0, b0
    := next_left = !!!!LayoutToHeap({ value = next_left_pair })
    := ~c0 = 4i32
    := ~d0 = "yo"
    := next_right_pair = c0, d0
    := next_right = !!!!LayoutToHeap({ value = next_right_pair })
    := next_pair = next_left, next_right
    := next_inner = !!!!LayoutToHeap({ value = next_pair })
    := ~flag = 2i32
    := next_outer_pair = next_inner, flag
    := next_outer = !!!!LayoutToHeap({ value = next_outer_pair })
    := held = get a 0i32
    held <- { value = next_outer }
    := opened = !!!!LayoutIndex(held)
    := heap_held = opened::value
    := outer_opened = !!!!LayoutIndex(heap_held)
    := ~(inner_held, seen) = outer_opened::value
    := inner_opened = !!!!LayoutIndex(inner_held)
    := ~(left, right) = inner_opened::value
    := left_opened = !!!!LayoutIndex(left)
    := ~(p, q) = left_opened::value
    := right_opened = !!!!LayoutIndex(right)
    := ~(r, s) = right_opened::value
    ? p =. 7i32 && !!!!EQ(q, "hi") && r =. 4i32 && !!!!EQ(s, "yo") && seen =. 2i32 ?> 0i32 |: 1i32
