:| slot =
    | None
    | Held : (heap { value : (heap { value : heap { value : i32 * string } * heap { value : i32 * string } }) * i32 })

:| wrap =
    | Absent
    | Box : (heap { value : slot })
    | Mark : i32

:! cell_array = array_base (mut { value : heap { value : wrap } })

:= create (n : i32) : cell_array = cell_array !!!!ArrayCreate(`(mut { value : heap { value : wrap } }), n)
:= get (array : cell_array) (i : i32) : mut { value : heap { value : wrap } } =
    ?= array ?|
    | cell_array values => !!!!ArrayIndex(values, i)
:= set (array : cell_array) (i : i32) (value : mut { value : heap { value : wrap } }) : () =
    ?= array ?|
    | cell_array values => !!!!ArrayIndexSet(values, i, value)
:~ score x : i32 =
    ?= x ?|
    | Absent => 1i32
    | Mark k => ? k =. 0i32 ?> 1i32 |: 1i32
    | Box box =>
        := opened = !!!!LayoutIndex(box)
        ?= opened::value ?|
        | None => 1i32
        | Held inner =>
            := inner_opened = !!!!LayoutIndex(inner)
            := ~(inner_held, flag) = inner_opened::value
            := deep_opened = !!!!LayoutIndex(inner_held)
            := ~(left, right) = deep_opened::value
            := left_opened = !!!!LayoutIndex(left)
            := ~(a, b) = left_opened::value
            := right_opened = !!!!LayoutIndex(right)
            := ~(c, d) = right_opened::value
            ? a =. 7i32 && !!!!EQ(b, "hi") && c =. 4i32 && !!!!EQ(d, "yo") && flag =. 2i32 ?> 0i32 |: 1i32

:= main () : i32 =
    := ~n = 7i32
    := ~word = "hi"
    := left_pair = n, word
    := left_heap = !!!!LayoutToHeap({ value = left_pair })
    := ~m = 4i32
    := ~other = "yo"
    := right_pair = m, other
    := right_heap = !!!!LayoutToHeap({ value = right_pair })
    := pair = left_heap, right_heap
    := inner = !!!!LayoutToHeap({ value = pair })
    := ~mark = 2i32
    := outer_pair = inner, mark
    := outer = !!!!LayoutToHeap({ value = outer_pair })
    := ~on = !+
    := held = ? on ?> Held outer |: None
    := box = !!!!LayoutToHeap({ value = held })
    := ~use_box = !+
    := wrapped = ? use_box ?> Box box |: Mark 1i32
    := ~tag = 3i32
    := marked = Mark tag
    := cover_box = !!!!LayoutToHeap({ value = wrapped })
    := cover_mark = !!!!LayoutToHeap({ value = marked })
    := cell : mut { value : heap { value : wrap } } = !!!!LayoutToHeapMutable({ value = cover_box })
    := cells = create 1i32
    set cells 0i32 cell
    := held = get cells 0i32
    := before = !!!!LayoutIndex(held)
    := before_heap = before::value
    := before_opened = !!!!LayoutIndex(before_heap)
    := before_score = score before_opened::value
    held <- { value = cover_mark }
    := after = !!!!LayoutIndex(held)
    := after_heap = after::value
    := after_opened = !!!!LayoutIndex(after_heap)
    := after_score = score after_opened::value
    ? before_score =. 0i32 && after_score =. 1i32 ?> 0i32 |: 1i32
