:| slot =
    | None
    | Held : (heap { value : (heap { value : heap { value : i32 * string } * heap { value : i32 * string } }) * i32 })

:| wrap =
    | Absent
    | Box : (heap { value : slot })

:! cell_array = array_base (mut { value : heap { value : wrap } })

:= create (n : i32) : cell_array = cell_array !!!!ArrayCreate(`(mut { value : heap { value : wrap } }), n)
:= get (array : cell_array) (i : i32) : mut { value : heap { value : wrap } } =
    ?= array ?|
    | cell_array values => !!!!ArrayIndex(values, i)
:= set (array : cell_array) (i : i32) (value : mut { value : heap { value : wrap } }) : () =
    ?= array ?|
    | cell_array values => !!!!ArrayIndexSet(values, i, value)

:~ score x : i32 =
    ?= x ?|
    | Absent => 1i32
    | Box box =>
        := opened = !!!!LayoutIndex(box)
        ?= opened::value ?|
        | None => 1i32
        | Held inner =>
            := inner_opened = !!!!LayoutIndex(inner)
            := ~(inner_held, flag) = inner_opened::value
            := deep_opened = !!!!LayoutIndex(inner_held)
            := ~(left, right) = deep_opened::value
            := left_opened = !!!!LayoutIndex(left)
            := ~(a, b) = left_opened::value
            := right_opened = !!!!LayoutIndex(right)
            := ~(c, d) = right_opened::value
            ? a =. 7i32 && !!!!EQ(b, "hi") && c =. 4i32 && !!!!EQ(d, "yo") && flag =. 2i32 ?> 0i32 |: 1i32

:= main () : i32 =
    := ~n = 1i32
    := ~word = "no"
    := left_pair = n, word
    := left_heap = !!!!LayoutToHeap({ value = left_pair })
    := ~m = 2i32
    := ~other = "zz"
    := right_pair = m, other
    := right_heap = !!!!LayoutToHeap({ value = right_pair })
    := pair = left_heap, right_heap
    := inner = !!!!LayoutToHeap({ value = pair })
    := ~mark = 3i32
    := outer_pair = inner, mark
    := outer = !!!!LayoutToHeap({ value = outer_pair })
    := ~on = !+
    := held0 = ? on ?> Held outer |: None
    := box0 = !!!!LayoutToHeap({ value = held0 })
    := ~use0 = !+
    := wrapped0 = ? use0 ?> Box box0 |: Absent
    := cover0 = !!!!LayoutToHeap({ value = wrapped0 })
    := cell : mut { value : heap { value : wrap } } = !!!!LayoutToHeapMutable({ value = cover0 })
    := cells = create 1i32
    set cells 0i32 cell
    := ~a0 = 7i32
    := ~b0 = "hi"
    := next_left_pair = a0, b0
    := next_left = !!!!LayoutToHeap({ value = next_left_pair })
    := ~c0 = 4i32
    := ~d0 = "yo"
    := next_right_pair = c0, d0
    := next_right = !!!!LayoutToHeap({ value = next_right_pair })
    := next_pair = next_left, next_right
    := next_inner = !!!!LayoutToHeap({ value = next_pair })
    := ~flag = 2i32
    := next_outer_pair = next_inner, flag
    := next_outer = !!!!LayoutToHeap({ value = next_outer_pair })
    := ~next_on = !+
    := held1 = ? next_on ?> Held next_outer |: None
    := box1 = !!!!LayoutToHeap({ value = held1 })
    := ~use1 = !+
    := wrapped1 = ? use1 ?> Box box1 |: Absent
    := cover1 = !!!!LayoutToHeap({ value = wrapped1 })
    := held = get cells 0i32
    held <- { value = cover1 }
    := opened = !!!!LayoutIndex(held)
    := heap_held = opened::value
    := heap_opened = !!!!LayoutIndex(heap_held)
    score heap_opened::value
