:! text_array = array_base string

:= create (n : i32) : text_array = text_array !!!!ArrayCreate(`string, n)
:= get (values : text_array) (i : i32) : string =
    ?= values ?|
    | text_array raw => !!!!ArrayIndex(raw, i)
:= set (values : text_array) (i : i32) (value : string) : () =
    ?= values ?|
    | text_array raw => !!!!ArrayIndexSet(raw, i, value)

:= main () : i32 =
    := values = create 2i32
    := ~word = "hi"
    set values 1i32 word
    ? !!!!EQ(get values 1i32, "hi") ?> 0i32 |: 1i32
