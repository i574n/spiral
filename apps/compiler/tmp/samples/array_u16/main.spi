:! u16_array = array_base u16

:= create (n : i32) : u16_array = u16_array !!!!ArrayCreate(`u16, n)
:= get (values : u16_array) (i : i32) : u16 =
    ?= values ?|
    | u16_array raw => !!!!ArrayIndex(raw, i)
:= set (values : u16_array) (i : i32) (value : u16) : () =
    ?= values ?|
    | u16_array raw => !!!!ArrayIndexSet(raw, i, value)

:= main () : i32 =
    := values = create 1i32
    := ~n = 40000u16
    set values 0i32 n
    ? get values 0i32 =. 40000u16 ?> 0i32 |: 1i32
