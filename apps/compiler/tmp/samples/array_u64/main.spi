:! u64_array = array_base u64

:= create (n : i32) : u64_array = u64_array !!!!ArrayCreate(`u64, n)
:= get (values : u64_array) (i : i32) : u64 =
    ?= values ?|
    | u64_array raw => !!!!ArrayIndex(raw, i)
:= set (values : u64_array) (i : i32) (value : u64) : () =
    ?= values ?|
    | u64_array raw => !!!!ArrayIndexSet(raw, i, value)

:= main () : i32 =
    := values = create 1i32
    := ~n = 4294967297u64
    set values 0i32 n
    ? get values 0i32 =. 4294967297u64 ?> 0i32 |: 1i32
