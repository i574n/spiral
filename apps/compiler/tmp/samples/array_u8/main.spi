nominal u8_array = array_base u8

inl create (n : i32) : u8_array = u8_array !!!!ArrayCreate(`u8, n)
inl get (values : u8_array) (i : i32) : u8 =
    match values with
    | u8_array raw => !!!!ArrayIndex(raw, i)
inl set (values : u8_array) (i : i32) (value : u8) : () =
    match values with
    | u8_array raw => !!!!ArrayIndexSet(raw, i, value)

inl main () : i32 =
    inl values = create 1i32
    inl ~n = 200u8
    set values 0i32 n
    if get values 0i32 =. 200u8 then 0i32 else 1i32
