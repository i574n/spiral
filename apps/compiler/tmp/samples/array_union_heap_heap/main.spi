union slot =
    | None
    | Held : (heap { value : (heap { value : i32 * string }) * i32 })

nominal slot_array = array_base slot

inl create (n : i32) : slot_array = slot_array !!!!ArrayCreate(`slot, n)
inl get (values : slot_array) (i : i32) : slot =
    match values with
    | slot_array raw => !!!!ArrayIndex(raw, i)
inl set (values : slot_array) (i : i32) (value : slot) : () =
    match values with
    | slot_array raw => !!!!ArrayIndexSet(raw, i, value)

let score x : i32 =
    match x with
    | None => 1i32
    | Held box =>
        inl opened = !!!!LayoutIndex(box)
        inl ~(cell, count) = opened.value
        inl inner_opened = !!!!LayoutIndex(cell)
        inl ~(left, right) = inner_opened.value
        if left =. 7i32 && !!!!EQ(right, "hi") && count =. 1i32 then 0i32 else 1i32

inl main () : i32 =
    inl ~n = 7i32
    inl ~word = "hi"
    inl inner_pair = n, word
    inl inner = !!!!LayoutToHeap({ value = inner_pair })
    inl ~extra = 1i32
    inl outer_pair = inner, extra
    inl outer = !!!!LayoutToHeap({ value = outer_pair })
    inl values = create 1i32
    inl ~flag = true
    inl held = if flag then Held outer else None
    set values 0i32 held
    inl loaded = get values 0i32
    score loaded
