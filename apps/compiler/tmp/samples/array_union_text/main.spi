union slot =
    | None
    | Both : string * string

nominal slot_array = array_base slot

inl create (n : i32) : slot_array = slot_array !!!!ArrayCreate(`slot, n)
inl get (values : slot_array) (i : i32) : slot =
    match values with
    | slot_array raw => !!!!ArrayIndex(raw, i)
inl set (values : slot_array) (i : i32) (value : slot) : () =
    match values with
    | slot_array raw => !!!!ArrayIndexSet(raw, i, value)

let score x : i32 =
    match x with
    | None => 1i32
    | Both (left, right) =>
        if !!!!EQ(left, "hi") && !!!!EQ(right, "yo") then 0i32 else 1i32

inl main () : i32 =
    inl values = create 1i32
    inl ~a = "hi"
    inl ~b = "yo"
    inl ~flag = true
    inl held = if flag then Both (a, b) else None
    set values 0i32 held
    inl loaded = get values 0i32
    score loaded
