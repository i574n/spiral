///> gleam
:# overhead_gleam =
    := ~seed = 197i32
    !!!!Mod(seed, 256i32) |> _assert_eq 197i32

///> gleam
:# sieve_gleam =
    := ~n = 2000000i32
    sieve_rounds n 1i32 |> _assert_eq 148933i32

///> gleam
:# tree_gleam =
    := ~depth = 20i32
    tree_rounds depth 1i32 |> _assert_eq !+

///> gleam
