:= main () : i32 =
    := ~x = 1.5f32
    := ~word = "hi"
    := pair = x, word
    := box = !!!!LayoutToHeap({ value = pair })
    := f (z : i32) : heap { value : f32 * string } =
        ? z =. 0i32 ?>
            box
        |:
            box
    := ~g = f
    := held = g 1i32
    := opened = !!!!LayoutIndex(held)
    := ~(left, right) = opened::value
    ? left =. 1.5f32 && !!!!EQ(right, "hi") ?> 0i32 |: 1i32
