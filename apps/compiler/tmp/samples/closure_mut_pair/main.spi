:= main () : i32 =
    := ~n = 3i32
    := ~word = "no"
    := pair = n, word
    := box : mut { value : i32 * string } = !!!!LayoutToHeapMutable({ value = pair })
    := f (z : i32) : mut { value : i32 * string } =
        ? z =. 0i32 ?> box |: box
    := ~g = f
    := held : mut { value : i32 * string } = g 1i32
    := ~m = 7i32
    := ~next = "hi"
    := replaced = m, next
    held <- { value = replaced }
    := opened = !!!!LayoutIndex(held)
    := ~(left, right) = opened::value
    ? left =. 7i32 && !!!!EQ(right, "hi") ?> 0i32 |: 1i32
