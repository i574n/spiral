nominal i32_array = array_base i32

inl create (n : i32) : i32_array = i32_array !!!!ArrayCreate(`i32, n)
inl get (array : i32_array) (i : i32) : i32 =
    match array with
    | i32_array values => !!!!ArrayIndex(values, i)
inl set (array : i32_array) (i : i32) (value : i32) : () =
    match array with
    | i32_array values => !!!!ArrayIndexSet(values, i, value)

inl main () : i32 =
    inl ~n = 3i32
    inl ~m = 4i32
    inl f (z : i32) : i32_array * i32_array =
        inl left = create 1i32
        inl right = create 1i32
        if z =. 0i32 then
            set left 0i32 0i32
            set right 0i32 0i32
            left, right
        else
            set left 0i32 n
            set right 0i32 m
            left, right
    inl ~g = f
    inl pair = g 1i32
    inl ~(left, right) = pair
    if get left 0i32 +. get right 0i32 =. 7i32 then 0i32 else 1i32
