:= main () : i32 =
    := ~a = 3i32
    := ~b = 4i32
    := cell = !!!!LayoutToHeap({ value = a })
    := f (n : i32) : heap { value : i32 } * i32 =
        ? n =. 0i32 ?>
            cell, 0i32
        |:
            cell, b
    := ~g = f
    := pair = g 1i32
    := ~(left, right) = pair
    := obj = !!!!LayoutIndex(left)
    ? obj::value +. right =. 7i32 ?> 0i32 |: 1i32
