inl main () : i32 =
    inl ~a = 3i32
    inl ~b = 4i32
    inl cell = !!!!LayoutToHeap({ value = a })
    inl f (n : i32) : heap { value : i32 } * i32 =
        if n =. 0i32 then
            cell, 0i32
        else
            cell, b
    inl ~g = f
    inl pair = g 1i32
    inl ~(left, right) = pair
    inl obj = !!!!LayoutIndex(left)
    if obj.value +. right =. 7i32 then 0i32 else 1i32
