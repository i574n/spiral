inl main () : i32 =
    inl ~x = 1.5f64
    inl f (n : i32) : f64 * f64 =
        if n =. 0i32 then
            0.0f64, 0.0f64
        else
            x, 2.5f64
    inl ~g = f
    inl pair = g 1i32
    inl ~(left, right) = pair
    if !!!!EQ(left, 1.5f64) && !!!!EQ(right, 2.5f64) then 0i32 else 1i32
