:= main () : i32 =
    := ~a = 3i32
    := ~b = 4i32
    := left = !!!!LayoutToHeap({ value = a })
    := right = !!!!LayoutToHeap({ value = b })
    := f (n : i32) : heap { value : i32 } * heap { value : i32 } =
        ? n =. 0i32 ?>
            right, left
        |:
            left, right
    := ~g = f
    := pair = g 1i32
    := ~(x, y) = pair
    := ox = !!!!LayoutIndex(x)
    := oy = !!!!LayoutIndex(y)
    ? ox::value +. oy::value =. 7i32 ?> 0i32 |: 1i32
