:= main () : i32 =
    := ~n = 5000000000i64
    := ~word = "hi"
    := f (z : i32) : i64 * string =
        ? z =. 0i32 ?>
            0i64, "no"
        |:
            n, word
    := ~g = f
    := pair = g 1i32
    := ~(left, right) = pair
    ? left =. 5000000000i64 && !!!!EQ(right, "hi") ?> 0i32 |: 1i32
