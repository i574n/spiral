inl main () : i32 =
    inl ~n = 5000000000i64
    inl ~word = "hi"
    inl f (z : i32) : i64 * string =
        if z =. 0i32 then
            0i64, "no"
        else
            n, word
    inl ~g = f
    inl pair = g 1i32
    inl ~(left, right) = pair
    if left =. 5000000000i64 && !!!!EQ(right, "hi") then 0i32 else 1i32
