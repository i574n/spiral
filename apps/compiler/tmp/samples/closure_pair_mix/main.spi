inl main () : i32 =
    inl ~n = 7i32
    inl ~word = "hi"
    inl f (z : i32) : i32 * string =
        if z =. 0i32 then
            0i32, "no"
        else
            n, word
    inl ~g = f
    inl pair = g 1i32
    inl ~(left, right) = pair
    if left =. 7i32 && !!!!EQ(right, "hi") then 0i32 else 1i32
