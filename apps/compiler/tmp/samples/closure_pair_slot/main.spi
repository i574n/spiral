union slot =
    | None
    | Some : i32

inl main () : i32 =
    inl ~n = 7i32
    inl f (z : i32) : slot * i32 =
        if z =. 0i32 then
            None, 0i32
        else
            Some n, n
    inl ~g = f
    inl pair = g 1i32
    inl ~(left, right) = pair
    match left with
    | Some value => if value =. 7i32 && right =. 7i32 then 0i32 else 1i32
    | None => 1i32
