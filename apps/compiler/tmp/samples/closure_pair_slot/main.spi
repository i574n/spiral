:| slot =
    | None
    | Some : i32

:= main () : i32 =
    := ~n = 7i32
    := f (z : i32) : slot * i32 =
        ? z =. 0i32 ?>
            None, 0i32
        |:
            Some n, n
    := ~g = f
    := pair = g 1i32
    := ~(left, right) = pair
    ?= left ?|
    | Some value => ? value =. 7i32 && right =. 7i32 ?> 0i32 |: 1i32
    | None => 1i32
