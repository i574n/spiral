:| slot =
    | None
    | Some : i32

:= main () : i32 =
    := ~n = 7i32
    := f (z : i32) : slot * slot =
        ? z =. 0i32 ?>
            None, None
        |:
            Some n, None
    := ~g = f
    := pair = g 1i32
    := ~(left, right) = pair
    ?= left ?|
    | Some value =>
        ?= right ?|
        | None => ? value =. 7i32 ?> 0i32 |: 1i32
        | Some other => 1i32
    | None => 1i32
