inl main () : i32 =
    inl ~a = "hi"
    inl ~b = "yo"
    inl f (z : i32) : string * string =
        if z =. 0i32 then
            "no", "nay"
        else
            a, b
    inl ~g = f
    inl pair = g 1i32
    inl ~(left, right) = pair
    if !!!!EQ(left, "hi") && !!!!EQ(right, "yo") then 0i32 else 1i32
