:| pair =
    | One : i32
    | Both : i32 * string

:= main () : i32 =
    := ~n = 3i32
    := ~word = "hi"
    := f (z : i32) : pair =
        ? z =. 0i32 ?>
            One 0i32
        |:
            Both (n, word)
    := ~g = f
    := held = g 1i32
    ?= held ?|
    | One value => 1i32
    | Both (left, right) => ? left =. 3i32 && !!!!EQ(right, "hi") ?> 0i32 |: 1i32
