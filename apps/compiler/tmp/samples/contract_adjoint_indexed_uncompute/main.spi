nominal lineage_a = ()
nominal program_a = ()
nominal dirty = ()
nominal clean = ()
nominal verified = ()

union workspace lineage program state = | Workspace :: forall lineage program state. string -> workspace lineage program state
union adjoint_proof program state = | Adjoint :: forall program state. string -> adjoint_proof program state

inl uncompute forall lineage program. (workspace : workspace lineage program dirty) (proof : adjoint_proof program verified) : workspace lineage program clean =
    match workspace, proof with | Workspace _, Adjoint _ => Workspace "adjoint-uncompute-clean"

inl main () : string =
    inl workspace : workspace lineage_a program_a dirty = Workspace "dirty"
    inl proof : adjoint_proof program_a verified = Adjoint "adjoint"
    match uncompute workspace proof with | Workspace label => label
