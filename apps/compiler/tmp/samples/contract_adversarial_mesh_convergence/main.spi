:! payload_a = ()
:! digest_a = ()
:! transfer_a = ()
:! manifest_a = ()
:! route_mesh = ()
:! peer_a = ()
:! peer_b = ()
:! peer_c = ()
:! chunk_0 = ()
:! chunk_1 = ()
:! chunk_2 = ()
:! inbox_a = ()
:! inbox_b = ()
:! inbox_c = ()

:! source_ready = ()
:! scheduled = ()
:! throttled = ()
:! delivered = ()
:! converged = ()
:! committed = ()
:! accepted = ()
:! rejected = ()
:! distinct = ()
:! idempotent = ()
:! non_idempotent = ()

:| payload artifact digest state =
    | Payload :: \* artifact digest state. string -> payload artifact digest state

:| mesh_manifest transfer artifact digest route manifest state =
    | MeshManifest :: \* transfer artifact digest route manifest state.
        string -> mesh_manifest transfer artifact digest route manifest state

:| peer_identity peer state =
    | PeerIdentity :: \* peer state. string -> peer_identity peer state

:| peer_distinct a b c state =
    | PeerDistinct :: \* a b c state. string -> peer_distinct a b c state

:| chunk_delivery transfer manifest peer chunk inbox state =
    | ChunkDelivery :: \* transfer manifest peer chunk inbox state.
        string -> chunk_delivery transfer manifest peer chunk inbox state

:| duplicate_receipt transfer manifest peer chunk state =
    | DuplicateReceipt :: \* transfer manifest peer chunk state.
        string -> duplicate_receipt transfer manifest peer chunk state

:| corruption_rejection transfer manifest peer chunk state =
    | CorruptionRejection :: \* transfer manifest peer chunk state.
        string -> corruption_rejection transfer manifest peer chunk state

:| backpressure_receipt transfer manifest peer inbox state =
    | BackpressureReceipt :: \* transfer manifest peer inbox state.
        string -> backpressure_receipt transfer manifest peer inbox state

:| peer_output transfer manifest peer artifact digest state =
    | PeerOutput :: \* transfer manifest peer artifact digest state.
        string -> peer_output transfer manifest peer artifact digest state

:| mesh_commit transfer manifest route artifact digest state =
    | MeshCommit :: \* transfer manifest route artifact digest state.
        string -> mesh_commit transfer manifest route artifact digest state

:| mesh_op transfer artifact digest route manifest pa pb pc ca cb cc ia ib ic from to effect =
    | ScheduleAdversarially :: \* transfer artifact digest route manifest pa pb pc ca cb cc ia ib ic.
        payload artifact digest source_ready *
        mesh_manifest transfer artifact digest route manifest scheduled *
        peer_identity pa accepted *
        peer_identity pb accepted *
        peer_identity pc accepted *
        peer_distinct pa pb pc distinct ->
        mesh_op transfer artifact digest route manifest pa pb pc ca cb cc ia ib ic source_ready scheduled idempotent
    | ApplyBackpressure :: \* transfer artifact digest route manifest pa pb pc ca cb cc ia ib ic.
        backpressure_receipt transfer manifest pa ia accepted *
        backpressure_receipt transfer manifest pb ib accepted *
        backpressure_receipt transfer manifest pc ic accepted ->
        mesh_op transfer artifact digest route manifest pa pb pc ca cb cc ia ib ic scheduled throttled non_idempotent
    | DeliverOutOfOrder :: \* transfer artifact digest route manifest pa pb pc ca cb cc ia ib ic.
        chunk_delivery transfer manifest pa cc ia accepted *
        chunk_delivery transfer manifest pa ca ia accepted *
        chunk_delivery transfer manifest pb cb ib accepted *
        chunk_delivery transfer manifest pb ca ib accepted *
        chunk_delivery transfer manifest pc cc ic accepted *
        chunk_delivery transfer manifest pc cb ic accepted ->
        mesh_op transfer artifact digest route manifest pa pb pc ca cb cc ia ib ic throttled delivered idempotent
    | DeduplicateAndRejectCorruption :: \* transfer artifact digest route manifest pa pb pc ca cb cc ia ib ic.
        duplicate_receipt transfer manifest pb cb accepted *
        duplicate_receipt transfer manifest pc cc accepted *
        corruption_rejection transfer manifest pa cb rejected ->
        mesh_op transfer artifact digest route manifest pa pb pc ca cb cc ia ib ic delivered converged idempotent
    | PublishConvergedMesh :: \* transfer artifact digest route manifest pa pb pc ca cb cc ia ib ic.
        mesh_manifest transfer artifact digest route manifest scheduled *
        peer_output transfer manifest pa artifact digest accepted *
        peer_output transfer manifest pb artifact digest accepted *
        peer_output transfer manifest pc artifact digest accepted *
        peer_distinct pa pb pc distinct *
        mesh_commit transfer manifest route artifact digest committed ->
        mesh_op transfer artifact digest route manifest pa pb pc ca cb cc ia ib ic converged committed non_idempotent

:| mesh_row transfer manifest from to effect =
    | MeshRow :: \* transfer manifest from to effect. string -> mesh_row transfer manifest from to effect

:| mesh_node transfer artifact digest route manifest pa pb pc ca cb cc ia ib ic from to =
    | MeshNode :: \* transfer artifact digest route manifest pa pb pc ca cb cc ia ib ic from to.
        (\? effect.
            mesh_op transfer artifact digest route manifest pa pb pc ca cb cc ia ib ic from to effect *
            mesh_row transfer manifest from to effect)
        -> mesh_node transfer artifact digest route manifest pa pb pc ca cb cc ia ib ic from to

:| ^ mesh_plan transfer artifact digest route manifest pa pb pc ca cb cc ia ib ic from to =
    | MeshLeaf :: \* transfer artifact digest route manifest pa pb pc ca cb cc ia ib ic from to.
        mesh_node transfer artifact digest route manifest pa pb pc ca cb cc ia ib ic from to ->
        mesh_plan transfer artifact digest route manifest pa pb pc ca cb cc ia ib ic from to
    | MeshThen :: \* transfer artifact digest route manifest pa pb pc ca cb cc ia ib ic from to.
        (\? middle.
            mesh_plan transfer artifact digest route manifest pa pb pc ca cb cc ia ib ic from middle *
            mesh_node transfer artifact digest route manifest pa pb pc ca cb cc ia ib ic middle to)
        -> mesh_plan transfer artifact digest route manifest pa pb pc ca cb cc ia ib ic from to

:| packed_mesh transfer artifact digest =
    | PackedMesh :: \* transfer artifact digest.
        (\? route manifest pa pb pc ca cb cc ia ib ic.
            mesh_plan transfer artifact digest route manifest pa pb pc ca cb cc ia ib ic source_ready committed)
        -> packed_mesh transfer artifact digest

:= with_packed_mesh \* transfer artifact digest result.
    (visit : \* route manifest pa pb pc ca cb cc ia ib ic.
        mesh_plan transfer artifact digest route manifest pa pb pc ca cb cc ia ib ic source_ready committed -> result)
    (packed : packed_mesh transfer artifact digest) : result =
    ?= packed ?|
    | PackedMesh payload =>
        := \? route manifest pa pb pc ca cb cc ia ib ic. plan = payload
        visit plan

:= node_label \* transfer artifact digest route manifest pa pb pc ca cb cc ia ib ic from to.
    (node : mesh_node transfer artifact digest route manifest pa pb pc ca cb cc ia ib ic from to) : string =
    ?= node ?|
    | MeshNode payload =>
        := \? effect. _, MeshRow label = payload
        label

:= ^ terminal_label \* transfer artifact digest route manifest pa pb pc ca cb cc ia ib ic from to.
    (plan : mesh_plan transfer artifact digest route manifest pa pb pc ca cb cc ia ib ic from to) : string =
    ?= plan ?|
    | MeshLeaf node => node_label node
    | MeshThen payload =>
        := \? middle. _, node = payload
        node_label node

:= manifest () : mesh_manifest transfer_a payload_a digest_a route_mesh manifest_a scheduled =
    MeshManifest "mesh-manifest-a"
:= distinct_peers () : peer_distinct peer_a peer_b peer_c distinct = PeerDistinct "a-ne-b-ne-c"

:= schedule_node
    ()
    : mesh_node transfer_a payload_a digest_a route_mesh manifest_a peer_a peer_b peer_c chunk_0 chunk_1 chunk_2 inbox_a
        inbox_b inbox_c source_ready scheduled
    =
    MeshNode (\? (
        ScheduleAdversarially (
            Payload "checkpoint-payload",
            manifest (),
            PeerIdentity "peer-a",
            PeerIdentity "peer-b",
            PeerIdentity "peer-c",
            distinct_peers ()
        ),
        MeshRow "schedule-reversed-duplicated-corrupted"
    ))

:= throttle_node
    ()
    : mesh_node transfer_a payload_a digest_a route_mesh manifest_a peer_a peer_b peer_c chunk_0 chunk_1 chunk_2 inbox_a
        inbox_b inbox_c scheduled throttled
    =
    MeshNode (\? (
        ApplyBackpressure (
            BackpressureReceipt "peer-a-limit-2",
            BackpressureReceipt "peer-b-limit-2",
            BackpressureReceipt "peer-c-limit-2"
        ),
        MeshRow "bounded-inbox-backpressure"
    ))

:= deliver_node
    ()
    : mesh_node transfer_a payload_a digest_a route_mesh manifest_a peer_a peer_b peer_c chunk_0 chunk_1 chunk_2 inbox_a
        inbox_b inbox_c throttled delivered
    =
    MeshNode (\? (
        DeliverOutOfOrder (
            ChunkDelivery "a-c2", ChunkDelivery "a-c0",
            ChunkDelivery "b-c1", ChunkDelivery "b-c0",
            ChunkDelivery "c-c2", ChunkDelivery "c-c1"
        ),
        MeshRow "out-of-order-content-addressed-delivery"
    ))

:= converge_node
    ()
    : mesh_node transfer_a payload_a digest_a route_mesh manifest_a peer_a peer_b peer_c chunk_0 chunk_1 chunk_2 inbox_a
        inbox_b inbox_c delivered converged
    =
    MeshNode (\? (
        DeduplicateAndRejectCorruption (
            DuplicateReceipt "b-c1-duplicate",
            DuplicateReceipt "c-c2-duplicate",
            CorruptionRejection "a-c1-corrupt-rejected"
        ),
        MeshRow "deduplicate-and-recover"
    ))

:= commit_node
    ()
    : mesh_node transfer_a payload_a digest_a route_mesh manifest_a peer_a peer_b peer_c chunk_0 chunk_1 chunk_2 inbox_a
        inbox_b inbox_c converged committed
    =
    MeshNode (\? (
        PublishConvergedMesh (
            manifest (),
            PeerOutput "peer-a-sha256-exact",
            PeerOutput "peer-b-sha256-exact",
            PeerOutput "peer-c-sha256-exact",
            distinct_peers (),
            MeshCommit "atomic-mesh-commit"
        ),
        MeshRow "adversarial-mesh-converged"
    ))

:= plan
    ()
    : mesh_plan transfer_a payload_a digest_a route_mesh manifest_a peer_a peer_b peer_c chunk_0 chunk_1 chunk_2 inbox_a
        inbox_b inbox_c source_ready committed
    =
    MeshThen (\? (
        MeshThen (\? (
            MeshThen (\? (
                MeshThen (\? (
                    MeshLeaf (schedule_node ()),
                    throttle_node ()
                )),
                deliver_node ()
            )),
            converge_node ()
        )),
        commit_node ()
    ))

:= inspect \* route manifest pa pb pc ca cb cc ia ib ic.
    (plan : mesh_plan transfer_a payload_a digest_a route manifest pa pb pc ca cb cc ia ib ic source_ready committed)
    : string
    =
    terminal_label plan

:= main () : string =
    := packed : packed_mesh transfer_a payload_a digest_a = PackedMesh (\? (plan ()))
    with_packed_mesh `$inspect packed
