:! zero = ()
:! succ n = n
:! dna = ()
:! rna = ()

:| nucleotide alphabet =
    | A :: \* alphabet. nucleotide alphabet
    | C :: \* alphabet. nucleotide alphabet
    | G :: \* alphabet. nucleotide alphabet
    | T :: nucleotide dna
    | U :: nucleotide rna

:| ^ strand alphabet n =
    | SNil :: \* alphabet. strand alphabet zero
    | SCons :: \* alphabet n. nucleotide alphabet * strand alphabet n -> strand alphabet (succ n)

:| codon alphabet =
    | Codon :: \* alphabet. strand alphabet (succ (succ (succ zero))) -> codon alphabet

:= translate_start (_ : codon dna) : string = "dna-codon-atg"

:= main () : string =
    translate_start (Codon (SCons (A, SCons (T, SCons (G, SNil)))))
