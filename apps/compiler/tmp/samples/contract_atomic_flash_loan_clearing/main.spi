:! idle = ()
:! borrowed = ()
:! routed = ()
:! arbitraged = ()
:! repaid = ()
:! settled = ()

:! usdc = string
:! weth = string
:! pool_alpha = string
:! pool_beta = string
:! borrower_7 = string
:! block_19000000 = i32
:! debt_note pool borrower asset block = pool * borrower * asset * block * string
:! route_receipt pool borrower asset block = pool * borrower * asset * block * string
:! profit_receipt pool borrower asset block = pool * borrower * asset * block * string
:! repayment_receipt pool borrower asset block = pool * borrower * asset * block * string
:! settlement_receipt pool borrower asset block = pool * borrower * asset * block * string

:| flash_op from to result =
    | Borrow :: \* pool borrower asset block.
        string -> flash_op idle borrowed (debt_note pool borrower asset block)
    | Route :: \* pool borrower asset block.
        debt_note pool borrower asset block * string ->
        flash_op borrowed routed (route_receipt pool borrower asset block)
    | Arbitrage :: \* pool borrower asset block.
        route_receipt pool borrower asset block * string ->
        flash_op routed arbitraged (profit_receipt pool borrower asset block)
    | Repay :: \* pool borrower asset block.
        debt_note pool borrower asset block * profit_receipt pool borrower asset block ->
        flash_op arbitraged repaid (repayment_receipt pool borrower asset block)
    | Settle :: \* pool borrower asset block.
        repayment_receipt pool borrower asset block ->
        flash_op repaid settled (settlement_receipt pool borrower asset block)

:! conservative_policy from to result = flash_op from to result
:! adversarial_policy from to result = flash_op from to result
:! ledger_interpreter from to result = flash_op from to result

:? assess policy from to result : policy from to result -> string
:? execute interpreter from to result : interpreter from to result -> string

:+ assess conservative_policy = \ (conservative_policy op) =>
    ?= op ?|
    | Borrow _ => "risk-borrow-capped"
    | Route _ => "risk-route-whitelisted"
    | Arbitrage _ => "risk-profit-positive"
    | Repay _ => "risk-principal-plus-fee"
    | Settle _ => "risk-atomic-close"

:+ assess adversarial_policy = \ (adversarial_policy op) =>
    ?= op ?|
    | Borrow _ => "probe-liquidity"
    | Route _ => "probe-price-impact"
    | Arbitrage _ => "probe-slippage"
    | Repay _ => "probe-repayment"
    | Settle _ => "probe-residual-debt"

:+ execute ledger_interpreter = \ (ledger_interpreter op) =>
    ?= op ?|
    | Borrow _ => "ledger-debit-pool"
    | Route _ => "ledger-route-assets"
    | Arbitrage _ => "ledger-capture-spread"
    | Repay _ => "ledger-credit-pool"
    | Settle _ => "ledger-seal-block"

:| ^ flash_plan from to =
    | FlashStep :: \* from to.
        (\? result. flash_op from to result * result) -> flash_plan from to
    | FlashThen :: \* from to.
        (\? middle. flash_plan from middle * flash_plan middle to) -> flash_plan from to

:! packed_flash = string

:= ^ terminal \* from to. (plan : flash_plan from to) : string =
    ?= plan ?|
    | FlashStep payload =>
        := \? result. op, _ = payload
        ?= op ?|
        | Borrow _ => "borrowed"
        | Route _ => "routed"
        | Arbitrage _ => "arbitraged"
        | Repay _ => "repaid"
        | Settle _ => "settled"
    | FlashThen payload =>
        := \? middle. _, right = payload
        terminal right

:= build_plan () : flash_plan idle settled =
    := debt : debt_note pool_alpha borrower_7 usdc block_19000000 =
        debt_note (
            pool_alpha "alpha",
            borrower_7 "borrower-7",
            usdc "usdc",
            block_19000000 19000000,
            "debt-alpha-7-usdc"
        )
    := route : route_receipt pool_alpha borrower_7 usdc block_19000000 =
        route_receipt (
            pool_alpha "alpha",
            borrower_7 "borrower-7",
            usdc "usdc",
            block_19000000 19000000,
            "alpha-beta-alpha"
        )
    := profit : profit_receipt pool_alpha borrower_7 usdc block_19000000 =
        profit_receipt (pool_alpha "alpha", borrower_7 "borrower-7", usdc "usdc", block_19000000 19000000, "profit-173")
    := repaid' : repayment_receipt pool_alpha borrower_7 usdc block_19000000 =
        repayment_receipt (
            pool_alpha "alpha",
            borrower_7 "borrower-7",
            usdc "usdc",
            block_19000000 19000000,
            "repaid-alpha"
        )
    := settled' : settlement_receipt pool_alpha borrower_7 usdc block_19000000 =
        settlement_receipt (
            pool_alpha "alpha",
            borrower_7 "borrower-7",
            usdc "usdc",
            block_19000000 19000000,
            "settled-block"
        )
    := borrow : flash_plan idle borrowed = FlashStep (\? (Borrow "pool-alpha", debt))
    := route_step : flash_plan borrowed routed = FlashStep (\? (Route (debt, "dex-beta"), route))
    := arbitrage : flash_plan routed arbitraged = FlashStep (\? (Arbitrage (route, "sell-weth"), profit))
    := repay : flash_plan arbitraged repaid = FlashStep (\? (Repay (debt, profit), repaid'))
    := settle : flash_plan repaid settled = FlashStep (\? (Settle repaid', settled'))
    FlashThen (\? (borrow,
        FlashThen (\? (route_step,
            FlashThen (\? (arbitrage,
                FlashThen (\? (repay, settle))))))))

:= inspect_packed (packed_flash value : packed_flash) : string = value

:= serialize_authority (_ : string) (_ : string) (_ : string) (_ : string) : string =
    "schema\tnode_id\toperation\tfrom\tto\tdeps\teffect\tcapability\tretry_budget\n"
    ^^ "1\tborrow\tBorrow\tidle\tborrowed\t\tnon_idempotent\tpool-alpha\t0\n"
    ^^ "1\troute\tRoute\tborrowed\trouted\tborrow\tidempotent\tdex-router\t1\n"
    ^^ "1\tarbitrage\tArbitrage\trouted\tarbitraged\troute\tnon_idempotent\tmarket-maker\t0\n"
    ^^ "1\trepay\tRepay\tarbitraged\trepaid\tarbitrage\tnon_idempotent\tpool-alpha\t0\n"
    ^^ "1\tsettle\tSettle\trepaid\tsettled\trepay\tnon_idempotent\tatomic-block\t0\n"

:= main () : string =
    := plan = build_plan ()
    := borrow_probe : flash_op idle borrowed (debt_note pool_alpha borrower_7 usdc block_19000000) =
        Borrow "pool-alpha"
    := debt_probe : debt_note pool_alpha borrower_7 usdc block_19000000 =
        debt_note (
            pool_alpha "alpha",
            borrower_7 "borrower-7",
            usdc "usdc",
            block_19000000 19000000,
            "debt-alpha-7-usdc"
        )
    := profit_probe : profit_receipt pool_alpha borrower_7 usdc block_19000000 =
        profit_receipt (pool_alpha "alpha", borrower_7 "borrower-7", usdc "usdc", block_19000000 19000000, "profit-173")
    := repay_probe : flash_op arbitraged repaid (repayment_receipt pool_alpha borrower_7 usdc block_19000000) =
        Repay (debt_probe, profit_probe)
    := repaid_probe : repayment_receipt pool_alpha borrower_7 usdc block_19000000 =
        repayment_receipt (
            pool_alpha "alpha",
            borrower_7 "borrower-7",
            usdc "usdc",
            block_19000000 19000000,
            "repaid-alpha"
        )
    := settle_probe : flash_op repaid settled (settlement_receipt pool_alpha borrower_7 usdc block_19000000) =
        Settle repaid_probe
    := risk = assess (conservative_policy borrow_probe)
    := probe = assess (adversarial_policy repay_probe)
    := effect = execute (ledger_interpreter settle_probe)
    := packed = packed_flash (terminal plan)
    serialize_authority risk probe effect (inspect_packed packed)
