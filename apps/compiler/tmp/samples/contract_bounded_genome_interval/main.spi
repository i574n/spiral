:! hg38 = ()
:! chr1 = ()
:! zero = ()
:! succ n = n

:| ^ lt a b =
    | LtZero :: \* n. lt zero (succ n)
    | LtSucc :: \* a b. lt a b -> lt (succ a) (succ b)

:| interval build contig start finish =
    | Interval :: \* build contig start finish. string * lt start finish -> interval build contig start finish

:= create_interval \* build contig start finish.
    (label : string)
    (proof : lt start finish)
    : interval build contig start finish =
    Interval (label, proof)

:= main () : string =
    := proof : lt zero (succ zero) = LtZero
    := interval : interval hg38 chr1 zero (succ zero) = create_interval "bounded-genome-interval" proof
    ?= interval ?|
    | Interval (label, _) => label
