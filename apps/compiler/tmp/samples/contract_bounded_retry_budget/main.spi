:! zero = ()
:! succ n = n
:! retryable = ()

:| ^ budget n =
    | ZeroBudget :: budget zero
    | MoreBudget :: \* n. budget n -> budget (succ n)

:| request effect result =
    | QueryStatus :: string -> request retryable string

:= run_request \* result. (request : request retryable result) : result =
    ?= request ?|
    | QueryStatus _ => "retry-budget-2"

:= retry_once \* n result.
    (budget : budget (succ n))
    (request : request retryable result)
    : result * budget n =
    ?= budget ?|
    | MoreBudget rest => run_request request, rest

:= main () : string =
    := budget2 = MoreBudget (MoreBudget ZeroBudget)
    := _, budget1 = retry_once budget2 (QueryStatus "135")
    := result, _ = retry_once budget1 (QueryStatus "135")
    result
