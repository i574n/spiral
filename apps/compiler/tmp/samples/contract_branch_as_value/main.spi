:! address = string
:! value = i32
:! condition = bool
:! branch_result = string
:! buffer = string
:! kernel = string
:! event = string

:| ir_op result =
    | Load :: address -> ir_op value
    | Add :: value * value -> ir_op value
    | Branch :: condition -> ir_op branch_result
    | Allocate :: i32 -> ir_op buffer
    | Launch :: kernel * buffer -> ir_op event

:| ^ program result =
    | Operation :: \* result. ir_op result -> program result
    | PairProgram :: \* left right. program left * program right -> program (left * right)
    | MapProgram :: \* result. (\? input. program input * (input -> result)) -> program result

:= ^ describe \* result. (value : program result) : string =
    ?= value ?|
    | Operation op =>
        ?= op ?|
        | Load _ => "load"
        | Add _ => "add"
        | Branch _ => "branch"
        | Allocate _ => "allocate"
        | Launch _ => "launch"
    | PairProgram (left, right) =>
        := _ = describe left
        := _ = describe right
        "pair-program"
    | MapProgram payload =>
        := \? input. inner, _ = payload
        := _ = describe inner
        "map-program"

:! cpu result = program result
:! cuda result = program result
:! wasm result = program result

:? lower target result : target result -> string
:+ lower cpu = \ (cpu value) => describe value
:+ lower cuda = \ (cuda value) => describe value
:+ lower wasm = \ (wasm value) => describe value

:| executable =
    | CpuExecutable :: (\? result. cpu result * result) -> executable
    | CudaExecutable :: (\? result. cuda result * result) -> executable
    | WasmExecutable :: (\? result. wasm result * result) -> executable

:= with_executable \* output.
    (visit : \* result. program result -> result -> output)
    (value : executable) : output =
    ?= value ?|
    | CpuExecutable payload =>
        := \? result. wrapped, result_value = payload
        ?= wrapped ?| cpu program => visit program result_value
    | CudaExecutable payload =>
        := \? result. wrapped, result_value = payload
        ?= wrapped ?| cuda program => visit program result_value
    | WasmExecutable payload =>
        := \? result. wrapped, result_value = payload
        ?= wrapped ?| wasm program => visit program result_value

:= conceal \* result. (_ : program result) (_ : result) : string = "result-parametric"

:= value_program () : program value =
    MapProgram (
        \? (
            PairProgram (Operation (Load (address "0x10")), Operation (Add (value 3, value 4))),
            \ (_ : value * value) => value 7
        )
    )

:= branch_program () : program branch_result =
    Operation (Branch (condition !+))

:= launch_program () : program event =
    Operation (Launch (kernel "fused-kernel", buffer "device-buffer"))

:= executable_value () : executable =
    CudaExecutable (\? (cuda (launch_program ()), event "event-42"))

:= emit (_ : string) (_ : string) (_ : string) (_ : string) : string =
    "schema\tkind\tnode_id\toperation\tfrom\tto\tdeps\teffect\tcapability\tretry_budget\tresult\tsequence\n"
    ^^ "1\tplan\tload\tLoad\taddress\tvalue\t\tidempotent\tmemory\t2\t\t\n"
    ^^ "1\tplan\tadd\tAdd\tvalues\tvalue\tload\tidempotent\tcompute\t2\t\t\n"
    ^^ "1\tplan\tbranch\tBranch\tcondition\tbranch-result\tadd\tidempotent\tcontrol\t1\t\t\n"
    ^^ "1\tplan\tallocate\tAllocate\tsize\tbuffer\tbranch\tnon_idempotent\tmemory\t0\t\t\n"
    ^^ "1\tplan\tlaunch\tLaunch\tkernel-buffer\tevent\tallocate\tnon_idempotent\taccelerator\t0\t\t\n"
    ^^ "1\treceipt\tload\tLoad\taddress\tvalue\t\t\t\t\tcommitted\t1\n"
    ^^ "1\treceipt\tadd\tAdd\tvalues\tvalue\t\t\t\t\tcommitted\t3\n"
    ^^ "1\treceipt\tbranch\tBranch\tcondition\tbranch-result\t\t\t\t\tcommitted\t5\n"
    ^^ "1\treceipt\tallocate\tAllocate\tsize\tbuffer\t\t\t\t\tcommitted\t7\n"
    ^^ "1\treceipt\tlaunch\tLaunch\tkernel-buffer\tevent\t\t\t\t\tcommitted\t9\n"
    ^^ "1\tevent\tload\tLoad\taddress\tvalue\t\t\t\t\tsuccess\t2\n"
    ^^ "1\tevent\tadd\tAdd\tvalues\tvalue\t\t\t\t\tsuccess\t4\n"
    ^^ "1\tevent\tbranch\tBranch\tcondition\tbranch-result\t\t\t\t\tsuccess\t6\n"
    ^^ "1\tevent\tallocate\tAllocate\tsize\tbuffer\t\t\t\t\tsuccess\t8\n"
    ^^ "1\tevent\tlaunch\tLaunch\tkernel-buffer\tevent\t\t\t\t\tsuccess\t10\n"

:= requires_value (_ : program value) : string = "value-program"

:= main () : string =
    requires_value (Operation (Branch (condition !+)))
