nominal build_37 = ()
nominal contig_1 = ()
nominal cohort_a = ()
nominal calibration_a = ()
nominal normalized = ()
nominal phased = ()
nominal authorized = ()
nominal released = ()

union likelihood build contig cohort calibration state = | Likelihood :: forall build contig cohort calibration state. string -> likelihood build contig cohort calibration state
union phase_set build contig cohort state = | PhaseSet :: forall build contig cohort state. string -> phase_set build contig cohort state
union release_permit cohort calibration state = | Permit :: forall cohort calibration state. string -> release_permit cohort calibration state
union cohort_release build contig cohort calibration state = | Release :: forall build contig cohort calibration state. string -> cohort_release build contig cohort calibration state

inl publish forall build contig cohort calibration. (likelihood : likelihood build contig cohort calibration normalized) (phase : phase_set build contig cohort phased) (permit : release_permit cohort calibration authorized) : cohort_release build contig cohort calibration released =
    match likelihood, phase, permit with | Likelihood _, PhaseSet _, Permit _ => Release "calibrated-cohort-released"

inl main () : string =
    inl likelihood : likelihood build_37 contig_1 cohort_a calibration_a normalized = Likelihood "normalized"
    inl phase : phase_set build_37 contig_1 cohort_a phased = PhaseSet "phased"
    inl permit : release_permit cohort_a calibration_a authorized = Permit "approved"
    match publish likelihood phase permit with | Release label => label
