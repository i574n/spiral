:! build_37 = ()
:! contig_1 = ()
:! cohort_a = ()
:! calibration_a = ()
:! normalized = ()
:! phased = ()
:! authorized = ()
:! released = ()

:| likelihood build contig cohort calibration state =
    | Likelihood :: \* build contig cohort calibration state.
        string ->
        likelihood build contig cohort calibration state
:| phase_set build contig cohort state =
    | PhaseSet :: \* build contig cohort state. string -> phase_set build contig cohort state
:| release_permit cohort calibration state =
    | Permit :: \* cohort calibration state. string -> release_permit cohort calibration state
:| cohort_release build contig cohort calibration state =
    | Release :: \* build contig cohort calibration state.
        string ->
        cohort_release build contig cohort calibration state

:= publish \* build contig cohort calibration.
    (likelihood : likelihood build contig cohort calibration normalized) (phase : phase_set build contig cohort phased)
    (permit : release_permit cohort calibration authorized)
    : cohort_release build contig cohort calibration released
    =
    ?= likelihood, phase, permit ?| | Likelihood _, PhaseSet _, Permit _ => Release "calibrated-cohort-released"

:= main () : string =
    := likelihood : likelihood build_37 contig_1 cohort_a calibration_a normalized = Likelihood "normalized"
    := phase : phase_set build_37 contig_1 cohort_a phased = PhaseSet "phased"
    := permit : release_permit cohort_a calibration_a authorized = Permit "approved"
    ?= publish likelihood phase permit ?| | Release label => label
