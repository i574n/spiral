nominal sample_a = ()
nominal hg38 = ()
nominal chr1 = ()
nominal aligned = ()
nominal calibrated = ()
nominal model_v1 = ()

union readset sample build contig stage = | Reads :: forall sample build contig stage. string -> readset sample build contig stage
union calibration sample build contig model = | Calibration :: forall sample build contig model. string -> calibration sample build contig model
union genotype_likelihood sample build contig model = | Likelihood :: forall sample build contig model. string -> genotype_likelihood sample build contig model

inl calibrate forall sample build contig. (reads : readset sample build contig aligned) : readset sample build contig calibrated * calibration sample build contig model_v1 =
    Reads "calibrated", Calibration "model"

inl likelihood forall sample build contig model. (reads : readset sample build contig calibrated) (model : calibration sample build contig model) : genotype_likelihood sample build contig model =
    match reads, model with | Reads _, Calibration _ => Likelihood "calibrated-genotype-likelihood"

inl main () : string =
    inl reads : readset sample_a hg38 chr1 aligned = Reads "aligned"
    match calibrate reads with
    | calibrated_reads, model =>
        match likelihood calibrated_reads model with
        | Likelihood label => label
