:! reader = ()
:! writer = ()
:! administrator = ()
:! row = string
:! receipt = string
:! version = i32

:| ^ capability_token capability =
    | ReaderToken :: string -> capability_token reader
    | WriterToken :: string -> capability_token writer
    | AdministratorToken :: string -> capability_token administrator
    | PairToken :: \* left right. capability_token left * capability_token right -> capability_token (left * right)

:| ^ request capability result =
    | Read :: string -> request reader row
    | Write :: row -> request writer receipt
    | CompareSwap :: row * version -> request administrator version
    | Batch :: \* left_cap left_result right_cap right_result.
        request left_cap left_result * request right_cap right_result ->
        request (left_cap * right_cap) (left_result * right_result)
    | MapRequest :: \* capability result.
        (\? input. request capability input * (input -> result)) -> request capability result

:= ^ describe \* capability result. (value : request capability result) : string =
    ?= value ?|
    | Read _ => "read"
    | Write _ => "write"
    | CompareSwap _ => "compare-swap"
    | Batch (left, right) =>
        := _ = describe left
        := _ = describe right
        "batch"
    | MapRequest payload =>
        := \? input. inner, _ = payload
        := _ = describe inner
        "map-request"

:! strict capability = capability_token capability
:! emergency capability = capability_token capability

:? authorize policy capability : policy capability -> string
:+ authorize strict = \ (strict token) =>
    ?= token ?|
    | ReaderToken _ => "strict-reader"
    | WriterToken _ => "strict-writer"
    | AdministratorToken _ => "strict-administrator"
    | PairToken _ => "strict-pair"
:+ authorize emergency = \ (emergency token) =>
    ?= token ?|
    | ReaderToken _ => "emergency-reader"
    | WriterToken _ => "emergency-writer"
    | AdministratorToken _ => "emergency-administrator"
    | PairToken _ => "emergency-pair"

:| sealed_request =
    | SealedRequest ::
        (\? capability result. request capability result * capability_token capability) ->
        sealed_request

:= inspect \* capability result.
    (request : request capability result)
    (_ : capability_token capability) : string =
    describe request

:= with_sealed \* output.
    (visit : \* capability result. request capability result -> capability_token capability -> output)
    (value : sealed_request) : output =
    ?= value ?|
    | SealedRequest payload =>
        := \? capability result. request, token = payload
        visit request token

:= batch_request () : request (reader * writer) (row * receipt) =
    Batch (Read "user-7", Write (row "row-7"))

:= batch_token () : capability_token (reader * writer) =
    PairToken (ReaderToken "reader-key", WriterToken "writer-key")

:= mapped_request () : request administrator string =
    MapRequest (\? (CompareSwap (row "row-7", version 41), \ (_ : version) => "version-advanced"))

:= sealed_value () : sealed_request =
    SealedRequest (\? (batch_request (), batch_token ()))

:= serialize_authority (_ : string) (_ : string) (_ : string) (_ : string) : string =
    "schema\tnode_id\toperation\tfrom\tto\tdeps\teffect\tcapability\tretry_budget\n"
    ^^ "1\tread\tRead\tkey\trow\t\tidempotent\treader\t2\n"
    ^^ "1\twrite\tWrite\trow\treceipt\tread\tnon_idempotent\twriter\t0\n"
    ^^ "1\tbatch\tBatch\trequests\tpaired-result\tread,write\tidempotent\treader-writer\t1\n"
    ^^ "1\tcompare\tCompareSwap\trow-version\tversion\tbatch\tnon_idempotent\tadministrator\t0\n"
    ^^ "1\tmap\tMapRequest\tversion\tmapped\tcompare\tidempotent\tmapper\t1\n"

:= main () : string =
    := strict_label = authorize (strict (batch_token ()))
    := emergency_label = authorize (emergency (AdministratorToken "break-glass"))
    := sealed_label = with_sealed `$inspect (sealed_value ())
    := mapped_label = describe (mapped_request ())
    serialize_authority strict_label emergency_label sealed_label mapped_label
