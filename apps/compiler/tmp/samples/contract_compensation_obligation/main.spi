:! no_compensation = ()
:! requires_compensation = ()

:| effect obligation =
    | Idempotent :: effect no_compensation
    | NonIdempotent :: effect requires_compensation

:| compensation_proof obligation =
    | NoCompensationNeeded :: compensation_proof no_compensation
    | CompensationReceipt :: string -> compensation_proof requires_compensation

:| sealed_operation obligation =
    | Sealed :: \* obligation.
        effect obligation * compensation_proof obligation
        -> sealed_operation obligation

:= seal \* obligation.
    (effect : effect obligation)
    (proof : compensation_proof obligation)
    : sealed_operation obligation =
    Sealed (effect, proof)

:= render (operation : sealed_operation requires_compensation) : string =
    ?= operation ?|
    | Sealed _ => "compensation-obligation-sealed"

:= main () : string =
    render (seal NonIdempotent (CompensationReceipt "rollback-publish"))
