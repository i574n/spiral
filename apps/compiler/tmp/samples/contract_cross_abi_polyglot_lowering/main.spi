:! source_module_a = ()
:! schema_hash_a = ()
:! backend_fsharp = ()
:! abi_net11 = ()
:! abi_cuda = ()
:! memory_gc = ()
:! capability_managed = ()
:! registry_root_a = ()
:! observer_a = ()
:! artifact_hash_a = ()

:! raw_source = ()
:! parsed = ()
:! elaborated = ()
:! normalized = ()
:! scheduled = ()
:! lowered = ()
:! linked = ()
:! attested = ()
:! available = ()
:! observed = ()
:! idempotent = ()
:! non_idempotent = ()

:| source_text source schema state =
    | SourceText :: \* source schema state. string -> source_text source schema state

:| typed_ir source schema stage state =
    | TypedIr :: \* source schema stage state. string -> typed_ir source schema stage state

:| backend_capability backend abi memory capability state =
    | BackendCapability :: \* backend abi memory capability state.
        string ->
        backend_capability backend abi memory capability state

:| linked_artifact source schema backend abi memory artifact_hash state =
    | LinkedArtifact :: \* source schema backend abi memory artifact_hash state.
        string ->
        linked_artifact source schema backend abi memory artifact_hash state

:| transparency_checkpoint root observer artifact_hash state =
    | TransparencyCheckpoint :: \* root observer artifact_hash state.
        string ->
        transparency_checkpoint root observer artifact_hash state

:| compiler_op source schema backend abi memory capability root observer artifact_hash from to effect =
    | Parse :: \* source schema backend abi memory capability root observer artifact_hash.
        source_text source schema raw_source ->
        compiler_op source schema backend abi memory capability root observer artifact_hash raw_source parsed idempotent
    | Elaborate :: \* source schema backend abi memory capability root observer artifact_hash.
        typed_ir source schema parsed available ->
        compiler_op source schema backend abi memory capability root observer artifact_hash parsed elaborated idempotent
    | Normalize :: \* source schema backend abi memory capability root observer artifact_hash.
        typed_ir source schema elaborated available ->
        compiler_op
            source schema backend abi memory capability root observer artifact_hash elaborated normalized idempotent
    | Schedule :: \* source schema backend abi memory capability root observer artifact_hash.
        typed_ir source schema normalized available * backend_capability backend abi memory capability available ->
        compiler_op
            source schema backend abi memory capability root observer artifact_hash normalized scheduled idempotent
    | Lower :: \* source schema backend abi memory capability root observer artifact_hash.
        typed_ir source schema scheduled available * backend_capability backend abi memory capability available ->
        compiler_op source schema backend abi memory capability root observer artifact_hash scheduled lowered idempotent
    | Link :: \* source schema backend abi memory capability root observer artifact_hash.
        linked_artifact source schema backend abi memory artifact_hash lowered ->
        compiler_op
            source schema backend abi memory capability root observer artifact_hash lowered linked non_idempotent
    | Attest :: \* source schema backend abi memory capability root observer artifact_hash.
        linked_artifact source schema backend abi memory artifact_hash linked *
        transparency_checkpoint root observer artifact_hash observed ->
        compiler_op
            source schema backend abi memory capability root observer artifact_hash linked attested non_idempotent

:| compiler_row source schema backend abi memory capability from to effect =
    | CompilerRow :: \* source schema backend abi memory capability from to effect.
        string ->
        compiler_row source schema backend abi memory capability from to effect

:| compiler_node source schema backend abi memory capability root observer artifact_hash from to =
    | CompilerNode :: \* source schema backend abi memory capability root observer artifact_hash from to.
        (\? effect.
            compiler_op source schema backend abi memory capability root observer artifact_hash from to effect *
            compiler_row source schema backend abi memory capability from to effect)
        -> compiler_node source schema backend abi memory capability root observer artifact_hash from to

:| ^ compiler_plan source schema backend abi memory capability root observer artifact_hash from to =
    | CompilerLeaf :: \* source schema backend abi memory capability root observer artifact_hash from to.
        compiler_node source schema backend abi memory capability root observer artifact_hash from to ->
        compiler_plan source schema backend abi memory capability root observer artifact_hash from to
    | CompilerThen :: \* source schema backend abi memory capability root observer artifact_hash from to.
        (\? middle.
            compiler_plan source schema backend abi memory capability root observer artifact_hash from middle *
            compiler_node source schema backend abi memory capability root observer artifact_hash middle to)
        -> compiler_plan source schema backend abi memory capability root observer artifact_hash from to

:| emitted_node source schema backend abi memory capability from to =
    | EmittedNode :: \* source schema backend abi memory capability from to.
        (\? effect. compiler_row source schema backend abi memory capability from to effect)
        -> emitted_node source schema backend abi memory capability from to

:| ^ emitted_plan source schema backend abi memory capability from to =
    | EmittedLeaf :: \* source schema backend abi memory capability from to.
        emitted_node source schema backend abi memory capability from to ->
        emitted_plan source schema backend abi memory capability from to
    | EmittedThen :: \* source schema backend abi memory capability from to.
        (\? middle.
            emitted_plan source schema backend abi memory capability from middle *
            emitted_node source schema backend abi memory capability middle to)
        -> emitted_plan source schema backend abi memory capability from to

:| packed_artifact source schema backend abi memory artifact_hash =
    | PackedArtifact :: \* source schema backend abi memory artifact_hash.
        (\? state. linked_artifact source schema backend abi memory artifact_hash state)
        -> packed_artifact source schema backend abi memory artifact_hash

:= emit_node \* source schema backend abi memory capability root observer artifact_hash from to.
    (node : compiler_node source schema backend abi memory capability root observer artifact_hash from to)
    : emitted_node source schema backend abi memory capability from to =
    ?= node ?|
    | CompilerNode payload =>
        := \? effect. _, row = payload
        EmittedNode (\? row)

:= ^ emit_plan \* source schema backend abi memory capability root observer artifact_hash from to.
    (plan : compiler_plan source schema backend abi memory capability root observer artifact_hash from to)
    : emitted_plan source schema backend abi memory capability from to =
    ?= plan ?|
    | CompilerLeaf node => EmittedLeaf (emit_node node)
    | CompilerThen payload =>
        := \? middle. prefix, node = payload
        EmittedThen (\? (emit_plan prefix, emit_node node))

:= ^ terminal_row \* source schema backend abi memory capability from to.
    (plan : emitted_plan source schema backend abi memory capability from to) : string =
    ?= plan ?|
    | EmittedLeaf (EmittedNode payload) =>
        := \? effect. CompilerRow label = payload
        label
    | EmittedThen payload =>
        := \? middle. _, EmittedNode row = payload
        := \? effect. CompilerRow label = row
        label

:= inspect_artifact \* source schema backend abi memory artifact_hash state.
    (artifact : linked_artifact source schema backend abi memory artifact_hash state) : string =
    ?= artifact ?| | LinkedArtifact label => label

:= with_artifact \* source schema backend abi memory artifact_hash result.
    (visitor :
        \* source schema backend abi memory artifact_hash state.
            linked_artifact source schema backend abi memory artifact_hash state -> result)
    (packed : packed_artifact source schema backend abi memory artifact_hash)
    : result
    =
    ?= packed ?|
    | PackedArtifact payload =>
        := \? state. artifact = payload
        visitor artifact

:= parse_node
    ()
    : compiler_node source_module_a schema_hash_a backend_fsharp abi_net11 memory_gc capability_managed registry_root_a
        observer_a artifact_hash_a raw_source parsed
    =
    CompilerNode (\? (Parse (SourceText "spiral-source"), CompilerRow "parse"))

:= elaborate_node
    ()
    : compiler_node source_module_a schema_hash_a backend_fsharp abi_net11 memory_gc capability_managed registry_root_a
        observer_a artifact_hash_a parsed elaborated
    =
    CompilerNode (\? (Elaborate (TypedIr "elaborated-ir"), CompilerRow "elaborate"))

:= normalize_node
    ()
    : compiler_node source_module_a schema_hash_a backend_fsharp abi_net11 memory_gc capability_managed registry_root_a
        observer_a artifact_hash_a elaborated normalized
    =
    CompilerNode (\? (Normalize (TypedIr "normalized-ir"), CompilerRow "normalize"))

:= schedule_node
    ()
    : compiler_node source_module_a schema_hash_a backend_fsharp abi_net11 memory_gc capability_managed registry_root_a
        observer_a artifact_hash_a normalized scheduled
    =
    CompilerNode (
        \? (Schedule (TypedIr "normalized-ir", BackendCapability "managed-backend"), CompilerRow "schedule")
    )

:= lower_node
    ()
    : compiler_node source_module_a schema_hash_a backend_fsharp abi_net11 memory_gc capability_managed registry_root_a
        observer_a artifact_hash_a scheduled lowered
    =
    := wrong : backend_capability backend_fsharp abi_cuda memory_gc capability_managed available =
        BackendCapability "cuda-abi-on-managed-target"
    CompilerNode (\? (Lower (TypedIr "scheduled-ir", wrong), CompilerRow "must-not-lower"))

:= link_node
    ()
    : compiler_node source_module_a schema_hash_a backend_fsharp abi_net11 memory_gc capability_managed registry_root_a
        observer_a artifact_hash_a lowered linked
    =
    CompilerNode (\? (Link (LinkedArtifact "linked-net11-artifact"), CompilerRow "link"))

:= attest_node
    ()
    : compiler_node source_module_a schema_hash_a backend_fsharp abi_net11 memory_gc capability_managed registry_root_a
        observer_a artifact_hash_a linked attested
    =
    CompilerNode (
        \? (
            Attest (LinkedArtifact "linked-net11-artifact", TransparencyCheckpoint "observer-checkpoint"),
            CompilerRow "type-preserving-polyglot-compiler"
        )
    )

:= plan
    ()
    : compiler_plan source_module_a schema_hash_a backend_fsharp abi_net11 memory_gc capability_managed registry_root_a
        observer_a artifact_hash_a raw_source attested
    =
    CompilerThen (\? (
        CompilerThen (\? (
            CompilerThen (\? (
                CompilerThen (\? (
                    CompilerThen (\? (
                        CompilerThen (\? (
                            CompilerLeaf (parse_node ()),
                            elaborate_node ()
                        )),
                        normalize_node ()
                    )),
                    schedule_node ()
                )),
                lower_node ()
            )),
            link_node ()
        )),
        attest_node ()
    ))

:= main () : string =
    := emitted = emit_plan (plan ())
    := artifact
        : linked_artifact source_module_a schema_hash_a backend_fsharp abi_net11 memory_gc artifact_hash_a linked
        =
        LinkedArtifact "linked-net11-artifact"
    := packed : packed_artifact source_module_a schema_hash_a backend_fsharp abi_net11 memory_gc artifact_hash_a =
        PackedArtifact (\? artifact)
    := inspected = with_artifact `$inspect_artifact packed
    := _ = inspected
    terminal_row emitted
