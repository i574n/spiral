nominal donor_a = ()
nominal hg38 = ()
nominal chr1 = ()
nominal chr2 = ()

union callset sample build contig =
    | Callset :: forall sample build contig. string -> callset sample build contig

inl merge_calls forall sample build contig.
    (left : callset sample build contig)
    (right : callset sample build contig)
    : callset sample build contig =
    match left, right with
    | Callset _, Callset _ => Callset "merged-calls"

inl main () : string =
    inl left : callset donor_a hg38 chr1 = Callset "left"
    inl right : callset donor_a hg38 chr2 = Callset "right"
    inl _ : callset donor_a hg38 chr1 = merge_calls left right
    "unreachable"
