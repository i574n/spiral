:! owner_a = ()
:! owner_b = ()
:! clean = ()
:! borrowed = ()

:| ancilla owner state =
    | Ancilla :: \* owner state. string -> ancilla owner state

:| loan owner =
    | Loan :: \* owner. string -> loan owner

:= release \* owner.
    (ancilla : ancilla owner borrowed)
    (loan : loan owner)
    : ancilla owner clean =
    ?= ancilla, loan ?|
    | Ancilla _, Loan _ => Ancilla "ancilla-clean"

:= main () : string =
    := ancilla : ancilla owner_a borrowed = Ancilla "borrowed"
    := foreign : loan owner_b = Loan "foreign-loan"
    := _ : ancilla owner_a clean = release ancilla foreign
    "unreachable"
