:! patient_a = ()
:! sample_a = ()
:! build_38 = ()
:! contig_7 = ()
:! cohort_a = ()
:! calibration_a = ()
:! therapy_purpose = ()
:! privacy_round_9 = ()
:! registry_root_a = ()
:! registry_root_b = ()
:! observer_a = ()
:! observer_b = ()
:! batch_a = ()
:! route_a = ()
:! map_frame = ()
:! hospital_host = ()
:! epoch_12 = ()

:! intake = ()
:! normalized = ()
:! phased = ()
:! consented = ()
:! privacy_committed = ()
:! authorized = ()
:! packaged = ()
:! routed = ()
:! administered = ()
:! published = ()
:! raw = ()
:! active = ()
:! spent = ()
:! sealed = ()
:! live = ()
:! pinned = ()
:! observed = ()
:! distinct = ()
:! idempotent = ()
:! non_idempotent = ()

:| genomic_evidence patient sample build contig cohort calibration state =
    | GenomicEvidence :: \* patient sample build contig cohort calibration state.
        string ->
        genomic_evidence patient sample build contig cohort calibration state

:| consent_witness patient purpose state =
    | Consent :: \* patient purpose state. string -> consent_witness patient purpose state

:| privacy_budget cohort round state =
    | PrivacyBudget :: \* cohort round state. string -> privacy_budget cohort round state

:| therapy_batch patient batch state =
    | TherapyBatch :: \* patient batch state. string -> therapy_batch patient batch state

:| route_plan route frame state =
    | RoutePlan :: \* route frame state. string -> route_plan route frame state

:| host_lease host epoch state =
    | HostLease :: \* host epoch state. string -> host_lease host epoch state

:| registry_pin root state =
    | RegistryPin :: \* root state. string -> registry_pin root state

:| observer_checkpoint root observer state =
    | ObserverCheckpoint :: \* root observer state. string -> observer_checkpoint root observer state

:| distinct_observers left right state =
    | DistinctObservers :: \* left right state. string -> distinct_observers left right state

:| mission_op patient sample build contig cohort calibration purpose round root observer_left observer_right batch
    route frame host epoch from to effect =
    | Normalize :: \* patient sample build contig cohort calibration purpose round root observer_left observer_right
        batch route frame host epoch.
        genomic_evidence patient sample build contig cohort calibration raw ->
        mission_op
            patient sample build contig cohort calibration purpose round root observer_left observer_right batch route
            frame host epoch intake normalized idempotent
    | Phase :: \* patient sample build contig cohort calibration purpose round root observer_left observer_right
        batch route frame host epoch.
        genomic_evidence patient sample build contig cohort calibration normalized ->
        mission_op
            patient sample build contig cohort calibration purpose round root observer_left observer_right batch route
            frame host epoch normalized phased idempotent
    | RecordConsent :: \* patient sample build contig cohort calibration purpose round root observer_left
        observer_right batch route frame host epoch.
        consent_witness patient purpose active ->
        mission_op
            patient sample build contig cohort calibration purpose round root observer_left observer_right batch route
            frame host epoch phased consented non_idempotent
    | CommitPrivacy :: \* patient sample build contig cohort calibration purpose round root observer_left
        observer_right batch route frame host epoch.
        privacy_budget cohort round active ->
        mission_op
            patient sample build contig cohort calibration purpose round root observer_left observer_right batch route
            frame host epoch consented privacy_committed non_idempotent
    | AuthorizeTherapy :: \* patient sample build contig cohort calibration purpose round root observer_left
        observer_right batch route frame host epoch.
        genomic_evidence patient sample build contig cohort calibration phased *
        consent_witness patient purpose active *
        privacy_budget cohort round spent ->
        mission_op
            patient sample build contig cohort calibration purpose round root observer_left observer_right batch route
            frame host epoch privacy_committed authorized non_idempotent
    | SealBatch :: \* patient sample build contig cohort calibration purpose round root observer_left observer_right
        batch route frame host epoch.
        therapy_batch patient batch sealed ->
        mission_op
            patient sample build contig cohort calibration purpose round root observer_left observer_right batch route
            frame host epoch authorized packaged non_idempotent
    | RouteBatch :: \* patient sample build contig cohort calibration purpose round root observer_left
        observer_right batch route frame host epoch.
        therapy_batch patient batch sealed * route_plan route frame active ->
        mission_op
            patient sample build contig cohort calibration purpose round root observer_left observer_right batch route
            frame host epoch packaged routed idempotent
    | Administer :: \* patient sample build contig cohort calibration purpose round root observer_left
        observer_right batch route frame host epoch.
        therapy_batch patient batch sealed * route_plan route frame active * host_lease host epoch live ->
        mission_op
            patient sample build contig cohort calibration purpose round root observer_left observer_right batch route
            frame host epoch routed administered non_idempotent
    | PublishMission :: \* patient sample build contig cohort calibration purpose round root observer_left
        observer_right batch route frame host epoch.
        registry_pin root pinned *
        observer_checkpoint root observer_left observed *
        observer_checkpoint root observer_right observed *
        distinct_observers observer_left observer_right distinct ->
        mission_op
            patient sample build contig cohort calibration purpose round root observer_left observer_right batch route
            frame host epoch administered published idempotent

:| audit_row patient sample build contig cohort calibration purpose round root batch route host epoch from to effect
    =
    | AuditRow :: \* patient sample build contig cohort calibration purpose round root batch route host epoch from
        to effect.
        string ->
        audit_row
            patient sample build contig cohort calibration purpose round root batch route host epoch from to effect

:| mission_node patient sample build contig cohort calibration purpose round root observer_left observer_right batch
    route frame host epoch from to =
    | MissionNode :: \* patient sample build contig cohort calibration purpose round root observer_left
        observer_right batch route frame host epoch from to.
        (\? effect.
            mission_op
                patient sample build contig cohort calibration purpose round root observer_left observer_right batch
                route frame host epoch from to effect *
            audit_row
                patient sample build contig cohort calibration purpose round root batch route host epoch from to
                effect) ->
        mission_node
            patient sample build contig cohort calibration purpose round root observer_left observer_right batch route
            frame host epoch from to

:| ^ mission_plan patient sample build contig cohort calibration purpose round root observer_left observer_right
    batch route frame host epoch from to =
    | MissionLeaf :: \* patient sample build contig cohort calibration purpose round root observer_left
        observer_right batch route frame host epoch from to.
        mission_node
            patient sample build contig cohort calibration purpose round root observer_left observer_right batch
            route frame host epoch from to ->
        mission_plan
            patient sample build contig cohort calibration purpose round root observer_left observer_right batch route
            frame host epoch from to
    | MissionThen :: \* patient sample build contig cohort calibration purpose round root observer_left
        observer_right batch route frame host epoch from to.
        (\? middle.
            mission_plan
                patient sample build contig cohort calibration purpose round root observer_left observer_right batch
                route frame host epoch from middle *
            mission_node
                patient sample build contig cohort calibration purpose round root observer_left observer_right batch
                route frame host epoch middle to) ->
        mission_plan
            patient sample build contig cohort calibration purpose round root observer_left observer_right batch route
            frame host epoch from to

:| serialized_node patient sample build contig cohort calibration purpose round root batch route host epoch from to =
    | SerializedNode :: \* patient sample build contig cohort calibration purpose round root batch route host epoch
        from to.
        (\? effect.
            audit_row
                patient sample build contig cohort calibration purpose round root batch route host epoch from to
                effect) ->
        serialized_node patient sample build contig cohort calibration purpose round root batch route host epoch from to

:| ^ serialized_plan patient sample build contig cohort calibration purpose round root batch route host epoch from
    to =
    | SerializedLeaf :: \* patient sample build contig cohort calibration purpose round root batch route host epoch
        from to.
        serialized_node
            patient sample build contig cohort calibration purpose round root batch route host epoch from to ->
        serialized_plan patient sample build contig cohort calibration purpose round root batch route host epoch from to
    | SerializedThen :: \* patient sample build contig cohort calibration purpose round root batch route host epoch
        from to.
        (\? middle.
            serialized_plan
                patient sample build contig cohort calibration purpose round root batch route host epoch from middle *
            serialized_node
                patient sample build contig cohort calibration purpose round root batch route host epoch middle to) ->
        serialized_plan patient sample build contig cohort calibration purpose round root batch route host epoch from to

:| packed_node patient sample build contig cohort calibration purpose round root observer_left observer_right batch
    route frame host epoch =
    | PackedNode :: \* patient sample build contig cohort calibration purpose round root observer_left
        observer_right batch route frame host epoch.
        (\? from to.
            mission_node
                patient sample build contig cohort calibration purpose round root observer_left observer_right batch
                route frame host epoch from to) ->
        packed_node
            patient sample build contig cohort calibration purpose round root observer_left observer_right batch route
            frame host epoch

:= serialize_node \* patient sample build contig cohort calibration purpose round root observer_left observer_right
    batch route frame host epoch from to.
    (node :
        mission_node
            patient sample build contig cohort calibration purpose round root observer_left observer_right batch route
            frame host epoch from to)
    : serialized_node patient sample build contig cohort calibration purpose round root batch route host epoch from to
    =
    ?= node ?|
    | MissionNode payload =>
        := \? effect. _, row = payload
        SerializedNode (\? row)

:= ^ serialize_plan \* patient sample build contig cohort calibration purpose round root observer_left
    observer_right batch route frame host epoch from to.
    (plan :
        mission_plan
            patient sample build contig cohort calibration purpose round root observer_left observer_right batch route
            frame host epoch from to)
    : serialized_plan patient sample build contig cohort calibration purpose round root batch route host epoch from to
    =
    ?= plan ?|
    | MissionLeaf node => SerializedLeaf (serialize_node node)
    | MissionThen payload =>
        := \? middle. prefix, node = payload
        SerializedThen (\? (serialize_plan prefix, serialize_node node))

:= node_label \* patient sample build contig cohort calibration purpose round root observer_left observer_right
    batch route frame host epoch from to.
    (node :
        mission_node
            patient sample build contig cohort calibration purpose round root observer_left observer_right batch route
            frame host epoch from to)
    : string
    =
    ?= node ?|
    | MissionNode payload =>
        := \? effect. _, AuditRow label = payload
        label

:= audit_packed \* patient sample build contig cohort calibration purpose round root observer_left observer_right
    batch route frame host epoch result.
    (visitor :
        \* patient sample build contig cohort calibration purpose round root observer_left observer_right batch
            route frame host epoch from to.
            mission_node
                patient sample build contig cohort calibration purpose round root observer_left observer_right batch
                route frame host epoch from to ->
            result)
    (packed :
        packed_node
            patient sample build contig cohort calibration purpose round root observer_left observer_right batch route
            frame host epoch)
    : result
    =
    ?= packed ?|
    | PackedNode payload =>
        := \? from to. node = payload
        visitor node

:= ^ final_row \* patient sample build contig cohort calibration purpose round root batch route host epoch from
    to.
    (plan :
        serialized_plan
            patient sample build contig cohort calibration purpose round root batch route host epoch from to)
    : string
    =
    ?= plan ?|
    | SerializedLeaf (SerializedNode payload) =>
        := \? effect. AuditRow label = payload
        label
    | SerializedThen payload =>
        := \? middle. _, SerializedNode row = payload
        := \? effect. AuditRow label = row
        label

:= normalize_node
    ()
    : mission_node patient_a sample_a build_38 contig_7 cohort_a calibration_a therapy_purpose privacy_round_9
        registry_root_a observer_a observer_b batch_a route_a map_frame hospital_host epoch_12 intake normalized
    =
    MissionNode (\? (Normalize (GenomicEvidence "raw-reads"), AuditRow "normalize"))

:= phase_node
    ()
    : mission_node patient_a sample_a build_38 contig_7 cohort_a calibration_a therapy_purpose privacy_round_9
        registry_root_a observer_a observer_b batch_a route_a map_frame hospital_host epoch_12 normalized phased
    =
    MissionNode (\? (Phase (GenomicEvidence "phased-callset"), AuditRow "phase"))

:= consent_node
    ()
    : mission_node patient_a sample_a build_38 contig_7 cohort_a calibration_a therapy_purpose privacy_round_9
        registry_root_a observer_a observer_b batch_a route_a map_frame hospital_host epoch_12 phased consented
    =
    MissionNode (\? (RecordConsent (Consent "patient-consent"), AuditRow "consent"))

:= privacy_node
    ()
    : mission_node patient_a sample_a build_38 contig_7 cohort_a calibration_a therapy_purpose privacy_round_9
        registry_root_a observer_a observer_b batch_a route_a map_frame hospital_host epoch_12 consented
        privacy_committed
    =
    MissionNode (\? (CommitPrivacy (PrivacyBudget "epsilon-spend"), AuditRow "privacy"))

:= authorize_node
    ()
    : mission_node patient_a sample_a build_38 contig_7 cohort_a calibration_a therapy_purpose privacy_round_9
        registry_root_a observer_a observer_b batch_a route_a map_frame hospital_host epoch_12 privacy_committed
        authorized
    =
    MissionNode (
        \? (
            AuthorizeTherapy (GenomicEvidence "phased", Consent "consented", PrivacyBudget "spent"),
            AuditRow "authorize"
        )
    )

:= batch_node
    ()
    : mission_node patient_a sample_a build_38 contig_7 cohort_a calibration_a therapy_purpose privacy_round_9
        registry_root_a observer_a observer_b batch_a route_a map_frame hospital_host epoch_12 authorized packaged
    =
    MissionNode (\? (SealBatch (TherapyBatch "sealed-batch"), AuditRow "package"))

:= route_node
    ()
    : mission_node patient_a sample_a build_38 contig_7 cohort_a calibration_a therapy_purpose privacy_round_9
        registry_root_a observer_a observer_b batch_a route_a map_frame hospital_host epoch_12 packaged routed
    =
    MissionNode (\? (RouteBatch (TherapyBatch "sealed-batch", RoutePlan "hospital-route"), AuditRow "route"))

:= administer_node
    ()
    : mission_node patient_a sample_a build_38 contig_7 cohort_a calibration_a therapy_purpose privacy_round_9
        registry_root_a observer_a observer_b batch_a route_a map_frame hospital_host epoch_12 routed administered
    =
    MissionNode (
        \? (
            Administer (TherapyBatch "sealed-batch", RoutePlan "hospital-route", HostLease "host-epoch"),
            AuditRow "administer"
        )
    )

:= publish_node
    ()
    : mission_node patient_a sample_a build_38 contig_7 cohort_a calibration_a therapy_purpose privacy_round_9
        registry_root_a observer_a observer_b batch_a route_a map_frame hospital_host epoch_12 administered published
    =
    := wrong : observer_checkpoint registry_root_b observer_b observed = ObserverCheckpoint "observer-b-wrong-root"
    MissionNode (
        \? (
            PublishMission (RegistryPin "root-a", ObserverCheckpoint "observer-a", wrong, DistinctObservers "a-ne-b"),
            AuditRow "must-not-publish"
        )
    )

:= plan
    ()
    : mission_plan patient_a sample_a build_38 contig_7 cohort_a calibration_a therapy_purpose privacy_round_9
        registry_root_a observer_a observer_b batch_a route_a map_frame hospital_host epoch_12 intake published
    =
    MissionThen (\? (
        MissionThen (\? (
            MissionThen (\? (
                MissionThen (\? (
                    MissionThen (\? (
                        MissionThen (\? (
                            MissionThen (\? (
                                MissionThen (\? (
                                    MissionLeaf (normalize_node ()),
                                    phase_node ()
                                )),
                                consent_node ()
                            )),
                            privacy_node ()
                        )),
                        authorize_node ()
                    )),
                    batch_node ()
                )),
                route_node ()
            )),
            administer_node ()
        )),
        publish_node ()
    ))

:= main () : string =
    := serialized = serialize_plan (plan ())
    := packed
        : packed_node patient_a sample_a build_38 contig_7 cohort_a calibration_a therapy_purpose privacy_round_9
            registry_root_a observer_a observer_b batch_a route_a map_frame hospital_host epoch_12
        =
        PackedNode (\? (publish_node ()))
    := audited = audit_packed `$node_label packed
    := _ = audited
    final_row serialized
