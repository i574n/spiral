:| replica_snapshot host registry_epoch registry_digest batch state =
    | ReplicaSnapshot :: \* host registry_epoch registry_digest batch state.
        string ->
        replica_snapshot host registry_epoch registry_digest batch state

:| registry_successor old_epoch old_digest new_epoch new_digest state =
    | RegistrySuccessor :: \* old_epoch old_digest new_epoch new_digest state.
        string ->
        registry_successor old_epoch old_digest new_epoch new_digest state

:| partition_witness left_host right_host batch state =
    | PartitionWitness :: \* left_host right_host batch state.
        string ->
        partition_witness left_host right_host batch state

:| distinct_replica_hosts first second third state =
    | DistinctReplicaHosts :: \* first second third state. string -> distinct_replica_hosts first second third state

:| replay_merge_receipt left_host right_host coordinator batch registry_epoch registry_digest state =
    | ReplayMergeReceipt :: \* left_host right_host coordinator batch registry_epoch registry_digest state.
        string ->
        replay_merge_receipt left_host right_host coordinator batch registry_epoch registry_digest state

:| mh_lane_receipt lane batch wave state =
    | MhLaneReceipt :: \* lane batch wave state. string -> mh_lane_receipt lane batch wave state

:| mh_lane_failure lane batch wave state =
    | MhLaneFailure :: \* lane batch wave state. string -> mh_lane_failure lane batch wave state

:| mh_cancel_token lane batch wave cancellation_epoch state =
    | MhCancelToken :: \* lane batch wave cancellation_epoch state.
        string ->
        mh_cancel_token lane batch wave cancellation_epoch state

:| mh_compensation lane batch wave state =
    | MhCompensation :: \* lane batch wave state. string -> mh_compensation lane batch wave state

:| compensation_order first_lane second_lane batch wave state =
    | CompensationOrder :: \* first_lane second_lane batch wave state.
        string ->
        compensation_order first_lane second_lane batch wave state

:| timeout_witness batch wave deadline state =
    | TimeoutWitness :: \* batch wave deadline state. string -> timeout_witness batch wave deadline state

:| failure_bundle batch wave =
    | FailureBundle :: \* batch wave.
        (\? first_lane second_lane.
            mh_lane_failure first_lane batch wave mh_failed *
            mh_lane_failure second_lane batch wave mh_failed *
            compensation_order first_lane second_lane batch wave mh_distinct)
        -> failure_bundle batch wave

:= with_failure_bundle \* batch wave result.
    (visit : \* first_lane second_lane.
        mh_lane_failure first_lane batch wave mh_failed ->
        mh_lane_failure second_lane batch wave mh_failed ->
        compensation_order first_lane second_lane batch wave mh_distinct -> result)
    (bundle : failure_bundle batch wave) : result =
    ?= bundle ?|
    | FailureBundle payload =>
        := \? first_lane second_lane. first_failure, second_failure, order = payload
        visit first_failure second_failure order

:| multihost_recovery_op old_epoch old_digest new_epoch new_digest batch wave left_host right_host coordinator
    observer_left observer_right observer_third from to effect =
    | CapturePartition :: \* old_epoch old_digest new_epoch new_digest batch wave left_host right_host coordinator
        observer_left observer_right observer_third.
        replica_snapshot left_host old_epoch old_digest batch mh_available *
        replica_snapshot right_host old_epoch old_digest batch mh_available *
        partition_witness left_host right_host batch mh_partitioned ->
        multihost_recovery_op
            old_epoch old_digest new_epoch new_digest batch wave left_host right_host coordinator observer_left
            observer_right observer_third mh_available mh_partitioned mh_idempotent
    | AlignRegistry :: \* old_epoch old_digest new_epoch new_digest batch wave left_host right_host coordinator
        observer_left observer_right observer_third.
        registry_successor old_epoch old_digest new_epoch new_digest mh_fresh ->
        multihost_recovery_op
            old_epoch old_digest new_epoch new_digest batch wave left_host right_host coordinator observer_left
            observer_right observer_third mh_partitioned mh_registry_aligned mh_idempotent
    | ObserveConcurrentLanes :: \* old_epoch old_digest new_epoch new_digest batch wave left_host right_host
        coordinator observer_left observer_right observer_third.
        mh_lane_receipt lane_inventory batch wave mh_succeeded *
        mh_lane_failure lane_payment batch wave mh_failed *
        mh_lane_failure lane_shipping batch wave mh_failed *
        mh_lane_receipt lane_risk batch wave mh_succeeded ->
        multihost_recovery_op
            old_epoch old_digest new_epoch new_digest batch wave left_host right_host coordinator observer_left
            observer_right observer_third mh_registry_aligned mh_lanes_observed mh_non_idempotent
    | ResolveShippingCancellation :: \* old_epoch old_digest new_epoch new_digest batch wave left_host right_host
        coordinator observer_left observer_right observer_third.
        mh_lane_failure lane_shipping batch wave mh_failed *
        mh_cancel_token lane_shipping batch wave cancellation_epoch_a mh_cancelled ->
        multihost_recovery_op
            old_epoch old_digest new_epoch new_digest batch wave left_host right_host coordinator observer_left
            observer_right observer_third mh_lanes_observed mh_shipping_cancelled mh_non_idempotent
    | CompensateShippingFirst :: \* old_epoch old_digest new_epoch new_digest batch wave left_host right_host
        coordinator observer_left observer_right observer_third.
        mh_lane_failure lane_shipping batch wave mh_failed *
        mh_compensation lane_shipping batch wave mh_compensated ->
        multihost_recovery_op
            old_epoch old_digest new_epoch new_digest batch wave left_host right_host coordinator observer_left
            observer_right observer_third mh_shipping_cancelled mh_shipping_compensated mh_non_idempotent
    | CompensateBankAfterShipping :: \* old_epoch old_digest new_epoch new_digest batch wave left_host right_host
        coordinator observer_left observer_right observer_third.
        mh_lane_failure lane_payment batch wave mh_failed *
        mh_compensation lane_payment batch wave mh_compensated *
        compensation_order lane_shipping lane_payment batch wave mh_distinct ->
        multihost_recovery_op
            old_epoch old_digest new_epoch new_digest batch wave left_host right_host coordinator observer_left
            observer_right observer_third mh_shipping_compensated mh_bank_compensated mh_non_idempotent
    | FormTimedReplicaQuorum :: \* old_epoch old_digest new_epoch new_digest batch wave left_host right_host
        coordinator observer_left observer_right observer_third.
        timeout_witness batch wave timeout_deadline_a mh_fresh *
        distinct_replica_hosts left_host right_host coordinator mh_distinct *
        observer_checkpoint registry_root_a observer_left observed *
        observer_checkpoint registry_root_a observer_right observed *
        observer_checkpoint registry_root_a observer_third observed ->
        multihost_recovery_op
            old_epoch old_digest new_epoch new_digest batch wave left_host right_host coordinator observer_left
            observer_right observer_third mh_bank_compensated mh_quorum_ready mh_idempotent
    | HealReplayReplica :: \* old_epoch old_digest new_epoch new_digest batch wave left_host right_host coordinator
        observer_left observer_right observer_third.
        replay_merge_receipt left_host right_host coordinator batch new_epoch new_digest mh_healed ->
        multihost_recovery_op
            old_epoch old_digest new_epoch new_digest batch wave left_host right_host coordinator observer_left
            observer_right observer_third mh_quorum_ready mh_healed mh_non_idempotent
    | PublishHealedAudit :: \* old_epoch old_digest new_epoch new_digest batch wave left_host right_host coordinator
        observer_left observer_right observer_third.
        registry_pin registry_root_a available *
        distinct_observers observer_left observer_right distinct *
        observer_checkpoint registry_root_a observer_left observed *
        observer_checkpoint registry_root_a observer_right observed ->
        multihost_recovery_op
            old_epoch old_digest new_epoch new_digest batch wave left_host right_host coordinator observer_left
            observer_right observer_third mh_healed mh_published mh_idempotent

:| multihost_recovery_row batch wave from to effect =
    | MultihostRecoveryRow :: \* batch wave from to effect.
        string ->
        multihost_recovery_row batch wave from to effect

:| multihost_recovery_node old_epoch old_digest new_epoch new_digest batch wave left_host right_host coordinator
    observer_left observer_right observer_third from to =
    | MultihostRecoveryNode :: \* old_epoch old_digest new_epoch new_digest batch wave left_host right_host
        coordinator observer_left observer_right observer_third from to.
        (\? effect.
            multihost_recovery_op
                old_epoch old_digest new_epoch new_digest batch wave left_host right_host coordinator observer_left
                observer_right observer_third from to effect *
            multihost_recovery_row batch wave from to effect) ->
        multihost_recovery_node
            old_epoch old_digest new_epoch new_digest batch wave left_host right_host coordinator observer_left
            observer_right observer_third from to

:| ^ multihost_recovery_plan old_epoch old_digest new_epoch new_digest batch wave left_host right_host coordinator
    observer_left observer_right observer_third from to =
    | MultihostRecoveryLeaf :: \* old_epoch old_digest new_epoch new_digest batch wave left_host right_host
        coordinator observer_left observer_right observer_third from to.
        multihost_recovery_node
            old_epoch old_digest new_epoch new_digest batch wave left_host right_host coordinator observer_left
            observer_right observer_third from to ->
        multihost_recovery_plan
            old_epoch old_digest new_epoch new_digest batch wave left_host right_host coordinator observer_left
            observer_right observer_third from to
    | MultihostRecoveryThen :: \* old_epoch old_digest new_epoch new_digest batch wave left_host right_host
        coordinator observer_left observer_right observer_third from to.
        (\? middle.
            multihost_recovery_plan
                old_epoch old_digest new_epoch new_digest batch wave left_host right_host coordinator observer_left
                observer_right observer_third from middle *
            multihost_recovery_node
                old_epoch old_digest new_epoch new_digest batch wave left_host right_host coordinator observer_left
                observer_right observer_third middle to) ->
        multihost_recovery_plan
            old_epoch old_digest new_epoch new_digest batch wave left_host right_host coordinator observer_left
            observer_right observer_third from to

:= multihost_node_label \* old_epoch old_digest new_epoch new_digest batch wave left_host right_host coordinator
    observer_left observer_right observer_third from to.
    (node :
        multihost_recovery_node
            old_epoch old_digest new_epoch new_digest batch wave left_host right_host coordinator observer_left
            observer_right observer_third from to)
    : string
    =
    ?= node ?|
    | MultihostRecoveryNode payload =>
        := \? effect. _, MultihostRecoveryRow label = payload
        label

:= ^ multihost_terminal \* old_epoch old_digest new_epoch new_digest batch wave left_host right_host coordinator
    observer_left observer_right observer_third from to.
    (plan :
        multihost_recovery_plan
            old_epoch old_digest new_epoch new_digest batch wave left_host right_host coordinator observer_left
            observer_right observer_third from to)
    : string
    =
    ?= plan ?|
    | MultihostRecoveryLeaf node => multihost_node_label node
    | MultihostRecoveryThen payload =>
        := \? middle. _, node = payload
        multihost_node_label node

:= partition_node
    ()
    : multihost_recovery_node registry_epoch_old registry_digest_old registry_epoch_new registry_digest_new
        replay_batch_a recovery_wave_1 replica_host_a replica_host_b replica_host_c observer_a observer_b observer_a
        mh_available mh_partitioned
    =
    MultihostRecoveryNode (\? (
        CapturePartition (ReplicaSnapshot "host-a", ReplicaSnapshot "host-b", PartitionWitness "network-cut"),
        MultihostRecoveryRow "capture-partitioned-replicas"
    ))

:= registry_node
    ()
    : multihost_recovery_node registry_epoch_old registry_digest_old registry_epoch_new registry_digest_new
        replay_batch_a recovery_wave_1 replica_host_a replica_host_b replica_host_c observer_a observer_b observer_a
        mh_partitioned mh_registry_aligned
    =
    MultihostRecoveryNode (\? (
        AlignRegistry (RegistrySuccessor "registry-v1-to-v2"),
        MultihostRecoveryRow "align-rotated-registry"
    ))

:= lanes_node
    ()
    : multihost_recovery_node registry_epoch_old registry_digest_old registry_epoch_new registry_digest_new
        replay_batch_a recovery_wave_1 replica_host_a replica_host_b replica_host_c observer_a observer_b observer_a
        mh_registry_aligned mh_lanes_observed
    =
    MultihostRecoveryNode (
        \? (
            ObserveConcurrentLanes (
                MhLaneReceipt "inventory-ok",
                MhLaneFailure "bank-timeout",
                MhLaneFailure "carrier-timeout",
                MhLaneReceipt "risk-ok"
            ),
            MultihostRecoveryRow "observe-four-lanes-two-failures"
        )
    )

:= cancel_node
    ()
    : multihost_recovery_node registry_epoch_old registry_digest_old registry_epoch_new registry_digest_new
        replay_batch_a recovery_wave_1 replica_host_a replica_host_b replica_host_c observer_a observer_b observer_a
        mh_lanes_observed mh_shipping_cancelled
    =
    MultihostRecoveryNode (\? (
        ResolveShippingCancellation (MhLaneFailure "carrier-timeout", MhCancelToken "cancel-before-dispatch"),
        MultihostRecoveryRow "resolve-shipping-cancellation-race"
    ))

:= shipping_compensation_node
    ()
    : multihost_recovery_node registry_epoch_old registry_digest_old registry_epoch_new registry_digest_new
        replay_batch_a recovery_wave_1 replica_host_a replica_host_b replica_host_c observer_a observer_b observer_a
        mh_shipping_cancelled mh_shipping_compensated
    =
    MultihostRecoveryNode (\? (
        CompensateShippingFirst (MhLaneFailure "carrier-timeout", MhCompensation "release-shipping-slot"),
        MultihostRecoveryRow "compensate-shipping-first"
    ))

:= bank_compensation_node
    ()
    : multihost_recovery_node registry_epoch_old registry_digest_old registry_epoch_new registry_digest_new
        replay_batch_a recovery_wave_1 replica_host_a replica_host_b replica_host_c observer_a observer_b observer_a
        mh_shipping_compensated mh_bank_compensated
    =
    := bank_comp : mh_compensation lane_shipping replay_batch_a recovery_wave_1 mh_compensated =
        MhCompensation "refund-bank"
    MultihostRecoveryNode (\? (
        CompensateBankAfterShipping (MhLaneFailure "bank-timeout", bank_comp, CompensationOrder "shipping-before-bank"),
        MultihostRecoveryRow "compensate-bank-after-shipping"
    ))

:= quorum_node
    ()
    : multihost_recovery_node registry_epoch_old registry_digest_old registry_epoch_new registry_digest_new
        replay_batch_a recovery_wave_1 replica_host_a replica_host_b replica_host_c observer_a observer_b observer_a
        mh_bank_compensated mh_quorum_ready
    =
    MultihostRecoveryNode (
        \? (
            FormTimedReplicaQuorum (
                TimeoutWitness "deadline-fresh",
                DistinctReplicaHosts "a-ne-b-ne-c",
                ObserverCheckpoint "observer-a",
                ObserverCheckpoint "observer-b",
                ObserverCheckpoint "observer-c"
            ),
            MultihostRecoveryRow "form-time-bounded-replica-quorum"
        )
    )

:= heal_node
    ()
    : multihost_recovery_node registry_epoch_old registry_digest_old registry_epoch_new registry_digest_new
        replay_batch_a recovery_wave_1 replica_host_a replica_host_b replica_host_c observer_a observer_b observer_a
        mh_quorum_ready mh_healed
    =
    MultihostRecoveryNode (\? (
        HealReplayReplica (ReplayMergeReceipt "join-semilattice-merge"),
        MultihostRecoveryRow "heal-partitioned-replay-state"
    ))

:= publish_healed_node
    ()
    : multihost_recovery_node registry_epoch_old registry_digest_old registry_epoch_new registry_digest_new
        replay_batch_a recovery_wave_1 replica_host_a replica_host_b replica_host_c observer_a observer_b observer_a
        mh_healed mh_published
    =
    MultihostRecoveryNode (
        \? (
            PublishHealedAudit (
                RegistryPin "root",
                DistinctObservers "a-ne-b",
                ObserverCheckpoint "observer-a",
                ObserverCheckpoint "observer-b"
            ),
            MultihostRecoveryRow "multihost-partition-healed"
        )
    )

:= multihost_plan
    ()
    : multihost_recovery_plan registry_epoch_old registry_digest_old registry_epoch_new registry_digest_new
        replay_batch_a recovery_wave_1 replica_host_a replica_host_b replica_host_c observer_a observer_b observer_a
        mh_available mh_published
    =
    MultihostRecoveryThen (\? (
        MultihostRecoveryThen (\? (
            MultihostRecoveryThen (\? (
                MultihostRecoveryThen (\? (
                    MultihostRecoveryThen (\? (
                        MultihostRecoveryThen (\? (
                            MultihostRecoveryThen (\? (
                                MultihostRecoveryThen (\? (
                                    MultihostRecoveryLeaf (partition_node ()),
                                    registry_node ()
                                )),
                                lanes_node ()
                            )),
                            cancel_node ()
                        )),
                        shipping_compensation_node ()
                    )),
                    bank_compensation_node ()
                )),
                quorum_node ()
            )),
            heal_node ()
        )),
        publish_healed_node ()
    ))

:= failure_bundle_label \* first_lane second_lane.
    (_ : mh_lane_failure first_lane replay_batch_a recovery_wave_1 mh_failed)
    (_ : mh_lane_failure second_lane replay_batch_a recovery_wave_1 mh_failed)
    (_ : compensation_order first_lane second_lane replay_batch_a recovery_wave_1 mh_distinct) : string =
    "two-failures-ordered"

:= main () : string =
    := first_failure : mh_lane_failure lane_shipping replay_batch_a recovery_wave_1 mh_failed =
        MhLaneFailure "carrier-timeout"
    := second_failure : mh_lane_failure lane_payment replay_batch_a recovery_wave_1 mh_failed =
        MhLaneFailure "bank-timeout"
    := order : compensation_order lane_shipping lane_payment replay_batch_a recovery_wave_1 mh_distinct =
        CompensationOrder "shipping-before-bank"
    := bundle : failure_bundle replay_batch_a recovery_wave_1 =
        FailureBundle (\? (first_failure, second_failure, order))
    := inspected = with_failure_bundle `$failure_bundle_label bundle
    := _ = inspected
    multihost_terminal (multihost_plan ())
