nominal mh_idempotent = ()
nominal mh_non_idempotent = ()

union replica_snapshot host registry_epoch registry_digest batch state =
    | ReplicaSnapshot :: forall host registry_epoch registry_digest batch state. string -> replica_snapshot host registry_epoch registry_digest batch state

union registry_successor old_epoch old_digest new_epoch new_digest state =
    | RegistrySuccessor :: forall old_epoch old_digest new_epoch new_digest state. string -> registry_successor old_epoch old_digest new_epoch new_digest state

union partition_witness left_host right_host batch state =
    | PartitionWitness :: forall left_host right_host batch state. string -> partition_witness left_host right_host batch state

union distinct_replica_hosts first second third state =
    | DistinctReplicaHosts :: forall first second third state. string -> distinct_replica_hosts first second third state

union replay_merge_receipt left_host right_host coordinator batch registry_epoch registry_digest state =
    | ReplayMergeReceipt :: forall left_host right_host coordinator batch registry_epoch registry_digest state. string -> replay_merge_receipt left_host right_host coordinator batch registry_epoch registry_digest state

union mh_lane_receipt lane batch wave state =
    | MhLaneReceipt :: forall lane batch wave state. string -> mh_lane_receipt lane batch wave state

union mh_lane_failure lane batch wave state =
    | MhLaneFailure :: forall lane batch wave state. string -> mh_lane_failure lane batch wave state

union mh_cancel_token lane batch wave cancellation_epoch state =
    | MhCancelToken :: forall lane batch wave cancellation_epoch state. string -> mh_cancel_token lane batch wave cancellation_epoch state

union mh_compensation lane batch wave state =
    | MhCompensation :: forall lane batch wave state. string -> mh_compensation lane batch wave state

union compensation_order first_lane second_lane batch wave state =
    | CompensationOrder :: forall first_lane second_lane batch wave state. string -> compensation_order first_lane second_lane batch wave state

union timeout_witness batch wave deadline state =
    | TimeoutWitness :: forall batch wave deadline state. string -> timeout_witness batch wave deadline state

union failure_bundle batch wave =
    | FailureBundle :: forall batch wave.
        (exists first_lane second_lane.
            mh_lane_failure first_lane batch wave mh_failed *
            mh_lane_failure second_lane batch wave mh_failed *
            compensation_order first_lane second_lane batch wave mh_distinct)
        -> failure_bundle batch wave

inl with_failure_bundle forall batch wave result.
    (visit : forall first_lane second_lane.
        mh_lane_failure first_lane batch wave mh_failed ->
        mh_lane_failure second_lane batch wave mh_failed ->
        compensation_order first_lane second_lane batch wave mh_distinct -> result)
    (bundle : failure_bundle batch wave) : result =
    match bundle with
    | FailureBundle payload =>
        inl exists first_lane second_lane. first_failure, second_failure, order = payload
        visit first_failure second_failure order

union multihost_recovery_op old_epoch old_digest new_epoch new_digest batch wave left_host right_host coordinator observer_left observer_right observer_third from to effect =
    | CapturePartition :: forall old_epoch old_digest new_epoch new_digest batch wave left_host right_host coordinator observer_left observer_right observer_third.
        replica_snapshot left_host old_epoch old_digest batch mh_available *
        replica_snapshot right_host old_epoch old_digest batch mh_available *
        partition_witness left_host right_host batch mh_partitioned ->
        multihost_recovery_op old_epoch old_digest new_epoch new_digest batch wave left_host right_host coordinator observer_left observer_right observer_third mh_available mh_partitioned mh_idempotent
    | AlignRegistry :: forall old_epoch old_digest new_epoch new_digest batch wave left_host right_host coordinator observer_left observer_right observer_third.
        registry_successor old_epoch old_digest new_epoch new_digest mh_fresh ->
        multihost_recovery_op old_epoch old_digest new_epoch new_digest batch wave left_host right_host coordinator observer_left observer_right observer_third mh_partitioned mh_registry_aligned mh_idempotent
    | ObserveConcurrentLanes :: forall old_epoch old_digest new_epoch new_digest batch wave left_host right_host coordinator observer_left observer_right observer_third.
        mh_lane_receipt lane_inventory batch wave mh_succeeded *
        mh_lane_failure lane_payment batch wave mh_failed *
        mh_lane_failure lane_shipping batch wave mh_failed *
        mh_lane_receipt lane_risk batch wave mh_succeeded ->
        multihost_recovery_op old_epoch old_digest new_epoch new_digest batch wave left_host right_host coordinator observer_left observer_right observer_third mh_registry_aligned mh_lanes_observed mh_non_idempotent
    | ResolveShippingCancellation :: forall old_epoch old_digest new_epoch new_digest batch wave left_host right_host coordinator observer_left observer_right observer_third.
        mh_lane_failure lane_shipping batch wave mh_failed *
        mh_cancel_token lane_shipping batch wave cancellation_epoch_a mh_cancelled ->
        multihost_recovery_op old_epoch old_digest new_epoch new_digest batch wave left_host right_host coordinator observer_left observer_right observer_third mh_lanes_observed mh_shipping_cancelled mh_non_idempotent
    | CompensateShippingFirst :: forall old_epoch old_digest new_epoch new_digest batch wave left_host right_host coordinator observer_left observer_right observer_third.
        mh_lane_failure lane_shipping batch wave mh_failed *
        mh_compensation lane_shipping batch wave mh_compensated ->
        multihost_recovery_op old_epoch old_digest new_epoch new_digest batch wave left_host right_host coordinator observer_left observer_right observer_third mh_shipping_cancelled mh_shipping_compensated mh_non_idempotent
    | CompensateBankAfterShipping :: forall old_epoch old_digest new_epoch new_digest batch wave left_host right_host coordinator observer_left observer_right observer_third.
        mh_lane_failure lane_payment batch wave mh_failed *
        mh_compensation lane_payment batch wave mh_compensated *
        compensation_order lane_shipping lane_payment batch wave mh_distinct ->
        multihost_recovery_op old_epoch old_digest new_epoch new_digest batch wave left_host right_host coordinator observer_left observer_right observer_third mh_shipping_compensated mh_bank_compensated mh_non_idempotent
    | FormTimedReplicaQuorum :: forall old_epoch old_digest new_epoch new_digest batch wave left_host right_host coordinator observer_left observer_right observer_third.
        timeout_witness batch wave timeout_deadline_a mh_fresh *
        distinct_replica_hosts left_host right_host coordinator mh_distinct *
        observer_checkpoint registry_root_a observer_left observed *
        observer_checkpoint registry_root_a observer_right observed *
        observer_checkpoint registry_root_a observer_third observed ->
        multihost_recovery_op old_epoch old_digest new_epoch new_digest batch wave left_host right_host coordinator observer_left observer_right observer_third mh_bank_compensated mh_quorum_ready mh_idempotent
    | HealReplayReplica :: forall old_epoch old_digest new_epoch new_digest batch wave left_host right_host coordinator observer_left observer_right observer_third.
        replay_merge_receipt left_host right_host coordinator batch new_epoch new_digest mh_healed ->
        multihost_recovery_op old_epoch old_digest new_epoch new_digest batch wave left_host right_host coordinator observer_left observer_right observer_third mh_quorum_ready mh_healed mh_non_idempotent
    | PublishHealedAudit :: forall old_epoch old_digest new_epoch new_digest batch wave left_host right_host coordinator observer_left observer_right observer_third.
        registry_pin registry_root_a available *
        distinct_observers observer_left observer_right distinct *
        observer_checkpoint registry_root_a observer_left observed *
        observer_checkpoint registry_root_a observer_right observed ->
        multihost_recovery_op old_epoch old_digest new_epoch new_digest batch wave left_host right_host coordinator observer_left observer_right observer_third mh_healed mh_published mh_idempotent

union multihost_recovery_row batch wave from to effect =
    | MultihostRecoveryRow :: forall batch wave from to effect. string -> multihost_recovery_row batch wave from to effect

union multihost_recovery_node old_epoch old_digest new_epoch new_digest batch wave left_host right_host coordinator observer_left observer_right observer_third from to =
    | MultihostRecoveryNode :: forall old_epoch old_digest new_epoch new_digest batch wave left_host right_host coordinator observer_left observer_right observer_third from to.
        (exists effect.
            multihost_recovery_op old_epoch old_digest new_epoch new_digest batch wave left_host right_host coordinator observer_left observer_right observer_third from to effect *
            multihost_recovery_row batch wave from to effect)
        -> multihost_recovery_node old_epoch old_digest new_epoch new_digest batch wave left_host right_host coordinator observer_left observer_right observer_third from to

union rec multihost_recovery_plan old_epoch old_digest new_epoch new_digest batch wave left_host right_host coordinator observer_left observer_right observer_third from to =
    | MultihostRecoveryLeaf :: forall old_epoch old_digest new_epoch new_digest batch wave left_host right_host coordinator observer_left observer_right observer_third from to.
        multihost_recovery_node old_epoch old_digest new_epoch new_digest batch wave left_host right_host coordinator observer_left observer_right observer_third from to ->
        multihost_recovery_plan old_epoch old_digest new_epoch new_digest batch wave left_host right_host coordinator observer_left observer_right observer_third from to
    | MultihostRecoveryThen :: forall old_epoch old_digest new_epoch new_digest batch wave left_host right_host coordinator observer_left observer_right observer_third from to.
        (exists middle.
            multihost_recovery_plan old_epoch old_digest new_epoch new_digest batch wave left_host right_host coordinator observer_left observer_right observer_third from middle *
            multihost_recovery_node old_epoch old_digest new_epoch new_digest batch wave left_host right_host coordinator observer_left observer_right observer_third middle to)
        -> multihost_recovery_plan old_epoch old_digest new_epoch new_digest batch wave left_host right_host coordinator observer_left observer_right observer_third from to

inl multihost_node_label forall old_epoch old_digest new_epoch new_digest batch wave left_host right_host coordinator observer_left observer_right observer_third from to.
    (node : multihost_recovery_node old_epoch old_digest new_epoch new_digest batch wave left_host right_host coordinator observer_left observer_right observer_third from to) : string =
    match node with
    | MultihostRecoveryNode payload =>
        inl exists effect. _, MultihostRecoveryRow label = payload
        label

inl rec multihost_terminal forall old_epoch old_digest new_epoch new_digest batch wave left_host right_host coordinator observer_left observer_right observer_third from to.
    (plan : multihost_recovery_plan old_epoch old_digest new_epoch new_digest batch wave left_host right_host coordinator observer_left observer_right observer_third from to) : string =
    match plan with
    | MultihostRecoveryLeaf node => multihost_node_label node
    | MultihostRecoveryThen payload =>
        inl exists middle. _, node = payload
        multihost_node_label node

inl partition_node () : multihost_recovery_node registry_epoch_old registry_digest_old registry_epoch_new registry_digest_new replay_batch_a recovery_wave_1 replica_host_a replica_host_b replica_host_c observer_a observer_b observer_a mh_available mh_partitioned =
    MultihostRecoveryNode (exists (
        CapturePartition (ReplicaSnapshot "host-a", ReplicaSnapshot "host-b", PartitionWitness "network-cut"),
        MultihostRecoveryRow "capture-partitioned-replicas"
    ))

inl registry_node () : multihost_recovery_node registry_epoch_old registry_digest_old registry_epoch_new registry_digest_new replay_batch_a recovery_wave_1 replica_host_a replica_host_b replica_host_c observer_a observer_b observer_a mh_partitioned mh_registry_aligned =
    MultihostRecoveryNode (exists (
        AlignRegistry (RegistrySuccessor "registry-v1-to-v2"),
        MultihostRecoveryRow "align-rotated-registry"
    ))

inl lanes_node () : multihost_recovery_node registry_epoch_old registry_digest_old registry_epoch_new registry_digest_new replay_batch_a recovery_wave_1 replica_host_a replica_host_b replica_host_c observer_a observer_b observer_a mh_registry_aligned mh_lanes_observed =
    MultihostRecoveryNode (exists (
        ObserveConcurrentLanes (MhLaneReceipt "inventory-ok", MhLaneFailure "bank-timeout", MhLaneFailure "carrier-timeout", MhLaneReceipt "risk-ok"),
        MultihostRecoveryRow "observe-four-lanes-two-failures"
    ))

inl cancel_node () : multihost_recovery_node registry_epoch_old registry_digest_old registry_epoch_new registry_digest_new replay_batch_a recovery_wave_1 replica_host_a replica_host_b replica_host_c observer_a observer_b observer_a mh_lanes_observed mh_shipping_cancelled =
    MultihostRecoveryNode (exists (
        ResolveShippingCancellation (MhLaneFailure "carrier-timeout", MhCancelToken "cancel-before-dispatch"),
        MultihostRecoveryRow "resolve-shipping-cancellation-race"
    ))

inl shipping_compensation_node () : multihost_recovery_node registry_epoch_old registry_digest_old registry_epoch_new registry_digest_new replay_batch_a recovery_wave_1 replica_host_a replica_host_b replica_host_c observer_a observer_b observer_a mh_shipping_cancelled mh_shipping_compensated =
    MultihostRecoveryNode (exists (
        CompensateShippingFirst (MhLaneFailure "carrier-timeout", MhCompensation "release-shipping-slot"),
        MultihostRecoveryRow "compensate-shipping-first"
    ))

inl bank_compensation_node () : multihost_recovery_node registry_epoch_old registry_digest_old registry_epoch_new registry_digest_new replay_batch_a recovery_wave_1 replica_host_a replica_host_b replica_host_c observer_a observer_b observer_a mh_shipping_compensated mh_bank_compensated =
    inl bank_comp : mh_compensation lane_shipping replay_batch_a recovery_wave_1 mh_compensated = MhCompensation "refund-bank"
    MultihostRecoveryNode (exists (
        CompensateBankAfterShipping (MhLaneFailure "bank-timeout", bank_comp, CompensationOrder "shipping-before-bank"),
        MultihostRecoveryRow "compensate-bank-after-shipping"
    ))

inl quorum_node () : multihost_recovery_node registry_epoch_old registry_digest_old registry_epoch_new registry_digest_new replay_batch_a recovery_wave_1 replica_host_a replica_host_b replica_host_c observer_a observer_b observer_a mh_bank_compensated mh_quorum_ready =
    MultihostRecoveryNode (exists (
        FormTimedReplicaQuorum (TimeoutWitness "deadline-fresh", DistinctReplicaHosts "a-ne-b-ne-c", ObserverCheckpoint "observer-a", ObserverCheckpoint "observer-b", ObserverCheckpoint "observer-c"),
        MultihostRecoveryRow "form-time-bounded-replica-quorum"
    ))

inl heal_node () : multihost_recovery_node registry_epoch_old registry_digest_old registry_epoch_new registry_digest_new replay_batch_a recovery_wave_1 replica_host_a replica_host_b replica_host_c observer_a observer_b observer_a mh_quorum_ready mh_healed =
    MultihostRecoveryNode (exists (
        HealReplayReplica (ReplayMergeReceipt "join-semilattice-merge"),
        MultihostRecoveryRow "heal-partitioned-replay-state"
    ))

inl publish_healed_node () : multihost_recovery_node registry_epoch_old registry_digest_old registry_epoch_new registry_digest_new replay_batch_a recovery_wave_1 replica_host_a replica_host_b replica_host_c observer_a observer_b observer_a mh_healed mh_published =
    MultihostRecoveryNode (exists (
        PublishHealedAudit (RegistryPin "root", DistinctObservers "a-ne-b", ObserverCheckpoint "observer-a", ObserverCheckpoint "observer-b"),
        MultihostRecoveryRow "multihost-partition-healed"
    ))

inl multihost_plan () : multihost_recovery_plan registry_epoch_old registry_digest_old registry_epoch_new registry_digest_new replay_batch_a recovery_wave_1 replica_host_a replica_host_b replica_host_c observer_a observer_b observer_a mh_available mh_published =
    MultihostRecoveryThen (exists (
        MultihostRecoveryThen (exists (
            MultihostRecoveryThen (exists (
                MultihostRecoveryThen (exists (
                    MultihostRecoveryThen (exists (
                        MultihostRecoveryThen (exists (
                            MultihostRecoveryThen (exists (
                                MultihostRecoveryThen (exists (
                                    MultihostRecoveryLeaf (partition_node ()),
                                    registry_node ()
                                )),
                                lanes_node ()
                            )),
                            cancel_node ()
                        )),
                        shipping_compensation_node ()
                    )),
                    bank_compensation_node ()
                )),
                quorum_node ()
            )),
            heal_node ()
        )),
        publish_healed_node ()
    ))

inl failure_bundle_label forall first_lane second_lane.
    (_ : mh_lane_failure first_lane replay_batch_a recovery_wave_1 mh_failed)
    (_ : mh_lane_failure second_lane replay_batch_a recovery_wave_1 mh_failed)
    (_ : compensation_order first_lane second_lane replay_batch_a recovery_wave_1 mh_distinct) : string =
    "two-failures-ordered"

inl main () : string =
    inl first_failure : mh_lane_failure lane_shipping replay_batch_a recovery_wave_1 mh_failed = MhLaneFailure "carrier-timeout"
    inl second_failure : mh_lane_failure lane_payment replay_batch_a recovery_wave_1 mh_failed = MhLaneFailure "bank-timeout"
    inl order : compensation_order lane_shipping lane_payment replay_batch_a recovery_wave_1 mh_distinct = CompensationOrder "shipping-before-bank"
    inl bundle : failure_bundle replay_batch_a recovery_wave_1 = FailureBundle (exists (first_failure, second_failure, order))
    inl inspected = with_failure_bundle `$failure_bundle_label bundle
    inl _ = inspected
    multihost_terminal (multihost_plan ())
