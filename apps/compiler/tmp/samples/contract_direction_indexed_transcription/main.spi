:! coding = ()
:! template = ()
:! five_to_three = ()
:! three_to_five = ()

:| dna_strand role direction =
    | CodingStrand :: string -> dna_strand coding five_to_three
    | TemplateStrand :: string -> dna_strand template three_to_five

:| transcript direction =
    | MessengerRna :: string -> transcript five_to_three

:= transcribe (strand : dna_strand template three_to_five) : transcript five_to_three =
    ?= strand ?|
    | TemplateStrand sequence => MessengerRna sequence

:= render_transcript (transcript : transcript five_to_three) : string =
    ?= transcript ?|
    | MessengerRna _ => "TAC:mrna-5to3"

:= main () : string =
    render_transcript (transcribe (TemplateStrand "TAC"))
