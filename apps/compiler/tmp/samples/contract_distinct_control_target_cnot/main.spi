:! register_a = ()
:! slot0 = ()
:! slot1 = ()
:! coherent = ()

:| qubit register slot phase = | Qubit :: \* register slot phase. string -> qubit register slot phase
:| distinct left right = | Slot0Slot1 :: distinct slot0 slot1

:= cnot \* register control target.
    (control : qubit register control coherent)
    (target : qubit register target coherent)
    (proof : distinct control target)
    : qubit register control coherent * qubit register target coherent =
    ?= control, target, proof ?|
    | Qubit _, Qubit _, Slot0Slot1 => Qubit "control", Qubit "distinct-cnot-applied"

:= main () : string =
    := control : qubit register_a slot0 coherent = Qubit "q0"
    := target : qubit register_a slot1 coherent = Qubit "q1"
    ?= cnot control target Slot0Slot1 ?|
    | Qubit _, Qubit label => label
