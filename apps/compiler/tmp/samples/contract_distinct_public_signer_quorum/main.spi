:! signer_a = ()
:! signer_b = ()
:! key_a = ()
:! key_b = ()
:! digest_a = ()
:! verified = ()

:| public_signature signer key digest state =
    | Signature :: \* signer key digest state. string -> public_signature signer key digest state
:| distinct left right = | SignerAB :: distinct signer_a signer_b
:| quorum digest left right = | Quorum :: \* digest left right. string -> quorum digest left right

:= authorize \* left right key_left key_right digest.
    (first : public_signature left key_left digest verified)
    (second : public_signature right key_right digest verified)
    (proof : distinct left right)
    : quorum digest left right =
    ?= first, second, proof ?| | Signature _, Signature _, SignerAB => Quorum "public-signer-quorum-formed"

:= main () : string =
    := first : public_signature signer_a key_a digest_a verified = Signature "a"
    := second : public_signature signer_b key_b digest_a verified = Signature "b"
    ?= authorize first second SignerAB ?| | Quorum label => label
