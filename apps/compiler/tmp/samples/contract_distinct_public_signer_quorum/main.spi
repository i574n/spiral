:! signer_a = ()
:! signer_b = ()
:! key_a = ()
:! key_b = ()
:! fingerprint_a = ()
:! verified = ()

:| public_signature signer key fingerprint state =
    | Signature :: \* signer key fingerprint state. string -> public_signature signer key fingerprint state
:| distinct left right = | SignerAB :: distinct signer_a signer_b
:| quorum fingerprint left right = | Quorum :: \* fingerprint left right. string -> quorum fingerprint left right

:= authorize \* left right key_left key_right fingerprint.
    (first : public_signature left key_left fingerprint verified)
    (second : public_signature right key_right fingerprint verified)
    (proof : distinct left right)
    : quorum fingerprint left right =
    ?= first, second, proof ?| | Signature _, Signature _, SignerAB => Quorum "public-signer-quorum-formed"

:= main () : string =
    := first : public_signature signer_a key_a fingerprint_a verified = Signature "a"
    := second : public_signature signer_b key_b fingerprint_a verified = Signature "b"
    ?= authorize first second SignerAB ?| | Quorum label => label
