:! log_a = ()
:! pin_a = ()
:! observer_a = ()
:! observer_b = ()
:! head_2 = ()
:! head_3 = ()
:! pinned = ()
:! observed = ()
:! distinct = ()
:! reconciled = ()
:| genesis_pin log pin state = | Pin :: \* log pin state. string -> genesis_pin log pin state
:| observer_checkpoint log pin observer head state =
    | Checkpoint :: \* log pin observer head state. string -> observer_checkpoint log pin observer head state
:| distinct_observers left right state =
    | Distinct :: \* left right state. string -> distinct_observers left right state
:| gossip_quorum log pin state = | Quorum :: \* log pin state. string -> gossip_quorum log pin state
:= reconcile \* log pin left right head_left head_right.
    (pin : genesis_pin log pin pinned) (left : observer_checkpoint log pin left head_left observed)
    (right : observer_checkpoint log pin right head_right observed) (proof : distinct_observers left right distinct)
    : gossip_quorum log pin reconciled
    =
    Quorum "ok"
:= main () =
    := pin : genesis_pin log_a pin_a pinned = Pin "external-pin"
    := left : observer_checkpoint log_a pin_a observer_a head_2 observed = Checkpoint "a"
    := duplicate : observer_checkpoint log_a pin_a observer_a head_3 observed = Checkpoint "a-again"
    := proof : distinct_observers observer_a observer_b distinct = Distinct "a-ne-b"
    reconcile pin left duplicate proof
