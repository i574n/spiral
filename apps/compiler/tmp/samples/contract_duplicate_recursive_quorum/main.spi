:! approver_a = ()
:! approver_b = ()
:! missing = ()
:! present = ()

:| approval who =
    | ApprovalA :: approval approver_a
    | ApprovalB :: approval approver_b

:| ^ approval_quorum a b =
    | EmptyQuorum :: approval_quorum missing missing
    | AddA :: \* b. approval_quorum missing b * approval approver_a -> approval_quorum present b
    | AddB :: \* a. approval_quorum a missing * approval approver_b -> approval_quorum a present

:= main () : string =
    := once = AddA (EmptyQuorum, ApprovalA)
    := _ = AddA (once, ApprovalA)
    "unreachable"
