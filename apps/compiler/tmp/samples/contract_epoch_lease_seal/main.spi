:! epoch_one = ()
:! epoch_two = ()
:! unbound = ()
:! bound = ()
:! consumed = ()

:| authority epoch =
    | AuthorityOne :: authority epoch_one
    | AuthorityTwo :: authority epoch_two

:| lease epoch state =
    | LeaseOneFresh :: lease epoch_one unbound
    | LeaseTwoFresh :: lease epoch_two unbound
    | LeaseOneBound :: lease epoch_one bound
    | LeaseTwoBound :: lease epoch_two bound
    | LeaseOneConsumed :: lease epoch_one consumed
    | LeaseTwoConsumed :: lease epoch_two consumed

:= bind \* epoch.
    (lease : lease epoch unbound)
    (authority : authority epoch)
    : lease epoch bound =
    ?= lease ?|
    | LeaseOneFresh =>
        ?= authority ?|
        | AuthorityOne => LeaseOneBound
    | LeaseTwoFresh =>
        ?= authority ?|
        | AuthorityTwo => LeaseTwoBound

:= consume \* epoch. (lease : lease epoch bound) : lease epoch consumed =
    ?= lease ?|
    | LeaseOneBound => LeaseOneConsumed
    | LeaseTwoBound => LeaseTwoConsumed

:| terminal_seal epoch =
    | TerminalSeal :: \* epoch. lease epoch consumed * authority epoch -> terminal_seal epoch

:= seal \* epoch.
    (lease : lease epoch consumed)
    (authority : authority epoch)
    : terminal_seal epoch =
    TerminalSeal (lease, authority)

:= render (seal : terminal_seal epoch_two) : string =
    ?= seal ?|
    | TerminalSeal _ => "epoch-lease-terminal-seal"

:= main () : string =
    := bound = bind LeaseTwoFresh AuthorityTwo
    := consumed = consume bound
    render (seal consumed AuthorityTwo)
