:! model_a = ()
:! round_9 = ()
:! client_a = ()
:! budget_a = ()
:! available = ()
:! spent = ()
:! aggregated = ()
:| privacy_budget client budget state =
    | Budget :: \* client budget state. string -> privacy_budget client budget state
:| clipped_update model round client budget state =
    | Update :: \* model round client budget state. string -> clipped_update model round client budget state
:| aggregate model round state = | Aggregate :: \* model round state. string -> aggregate model round state
:= consume \* model round client budget.
    (budget : privacy_budget client budget available) (update : clipped_update model round client budget available)
    : aggregate model round aggregated
    =
    Aggregate "ok"
:= main () =
    := exhausted : privacy_budget client_a budget_a spent = Budget "spent"
    := update : clipped_update model_a round_9 client_a budget_a available = Update "gradient"
    consume exhausted update
