:! hg38 = ()
:! chr1 = ()
:! i0 = ()
:! i1 = ()
:! i2 = ()
:! i3 = ()
:| segment build contig start finish =
    | Segment :: \* build contig start finish. string -> segment build contig start finish
:| region build contig start finish =
    | Region :: \* build contig start finish. string -> region build contig start finish
:= merge \* build contig start middle finish.
    (left : segment build contig start middle) (right : segment build contig middle finish)
    : region build contig start finish
    =
    Region "merged"
:= main () =
    := left : segment hg38 chr1 i0 i1 = Segment "left"
    := right : segment hg38 chr1 i2 i3 = Segment "right"
    merge left right
