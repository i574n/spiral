type singleton t = t

nominal draft = ()
nominal signed = ()

nominal nfe_draft = { id : string }
nominal nfe_signed = { xml : string; digest : string }

union document state =
    | Draft :: nfe_draft -> document draft
    | Signed :: nfe_signed -> document signed

nominal stamped state = { payload : document state; label : string }

inl sign (document : document draft) : document signed =
    match document with
    | Draft _ => Signed (nfe_signed { xml = "nfe.xml"; digest = "sha256" })

inl stamp forall state. (document : document state) : stamped state =
    stamped { payload = document; label = "audited" }

union rec compound (f : * -> *) t =
    | Singleton :: forall (f : * -> *) t. f t -> compound f (singleton t)
    | Pair :: forall (f : * -> *) a b. compound f a * compound f b -> compound f (a * b)

inl rec compound_map forall (f : * -> *) (g : * -> *) t.
    (transform : forall state. f state -> g state)
    (value : compound f t)
    : compound g t =
    match value with
    | Singleton item => Singleton (transform item)
    | Pair (left, right) => Pair (compound_map `$transform left, compound_map `$transform right)

inl main () : string =
    inl draft = Draft (nfe_draft { id = "4" })
    inl signed = sign draft
    inl documents = Pair (Singleton draft, Singleton signed)
    inl _ = compound_map `$stamp documents
    "hkt-audited"
