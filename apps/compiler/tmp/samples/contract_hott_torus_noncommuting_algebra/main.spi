:! torus_t = ()
:! torus_base = ()
:! loop_x = ()
:! loop_y = ()
:! torus_commutator = ()
:! motive_p = ()
:! fiber_base = ()
:! auto_x = ()
:! auto_y = ()
:! auto_y_wrong = ()
:! compose_xy = ()
:! compose_yx = ()
:! commute_xy = ()
:! section_witness = ()

:| torus_hit torus base x_loop y_loop commutator =
    | TorusHit :: \* torus base x_loop y_loop commutator. string -> torus_hit torus base x_loop y_loop commutator

:| motive_fiber motive point fiber_id =
    | MotiveFiber :: \* motive point fiber_id. string -> motive_fiber motive point fiber_id

:| fiber_automorphism motive fiber_id map_id =
    | FiberAutomorphism :: \* motive fiber_id map_id. string -> fiber_automorphism motive fiber_id map_id

:| automorphism_composition motive fiber_id left right composite =
    | AutomorphismComposition :: \* motive fiber_id left right composite.
        fiber_automorphism motive fiber_id left *
        fiber_automorphism motive fiber_id right *
        string -> automorphism_composition motive fiber_id left right composite

:| commuting_2homotopy motive fiber_id map_x map_y composite_xy composite_yx filler =
    | Commuting2Homotopy :: \* motive fiber_id map_x map_y composite_xy composite_yx filler.
        automorphism_composition motive fiber_id map_x map_y composite_xy *
        automorphism_composition motive fiber_id map_y map_x composite_yx *
        string -> commuting_2homotopy motive fiber_id map_x map_y composite_xy composite_yx filler

:| torus_dependent_algebra torus base x_loop y_loop commutator motive fiber_id map_x map_y composite_xy composite_yx
    filler =
    | TorusDependentAlgebra :: \* torus base x_loop y_loop commutator motive fiber_id map_x map_y composite_xy
        composite_yx filler.
        torus_hit torus base x_loop y_loop commutator *
        motive_fiber motive base fiber_id *
        fiber_automorphism motive fiber_id map_x *
        fiber_automorphism motive fiber_id map_y *
        commuting_2homotopy motive fiber_id map_x map_y composite_xy composite_yx filler *
        string ->
        torus_dependent_algebra
            torus base x_loop y_loop commutator motive fiber_id map_x map_y composite_xy composite_yx filler

:| torus_section torus motive base fiber_id map_x map_y filler witness =
    | TorusSection :: \* torus motive base fiber_id map_x map_y filler witness.
        string ->
        torus_section torus motive base fiber_id map_x map_y filler witness

:| torus_dependent_eliminator torus base x_loop y_loop commutator motive fiber_id map_x map_y composite_xy
    composite_yx filler section =
    | TorusDependentEliminator :: \* torus base x_loop y_loop commutator motive fiber_id map_x map_y composite_xy
        composite_yx filler section.
        torus_dependent_algebra
            torus base x_loop y_loop commutator motive fiber_id map_x map_y composite_xy composite_yx filler *
        torus_section torus motive base fiber_id map_x map_y filler section *
        string ->
        torus_dependent_eliminator
            torus base x_loop y_loop commutator motive fiber_id map_x map_y composite_xy composite_yx filler section

:| packed_torus_eliminator torus motive =
    | PackedTorusEliminator :: \* torus motive.
        (\? base x_loop y_loop commutator fiber_id map_x map_y composite_xy composite_yx filler section.
            torus_dependent_eliminator
                torus base x_loop y_loop commutator motive fiber_id map_x map_y composite_xy composite_yx filler
                section) ->
        packed_torus_eliminator torus motive

:= with_torus_eliminator \* torus motive result.
    (visit :
        \* base x_loop y_loop commutator fiber_id map_x map_y composite_xy composite_yx filler section.
            torus_dependent_eliminator
                torus base x_loop y_loop commutator motive fiber_id map_x map_y composite_xy composite_yx filler
                section ->
            result)
    (packed : packed_torus_eliminator torus motive)
    : result
    =
    ?= packed ?|
    | PackedTorusEliminator payload =>
        := \?
            base x_loop y_loop commutator fiber_id map_x map_y composite_xy composite_yx filler section. eliminator
            =
            payload
        visit eliminator

:= x_auto () : fiber_automorphism motive_p fiber_base auto_x = FiberAutomorphism "monodromy-x"
:= y_auto () : fiber_automorphism motive_p fiber_base auto_y = FiberAutomorphism "monodromy-y"
:= y_auto_wrong () : fiber_automorphism motive_p fiber_base auto_y_wrong = FiberAutomorphism "monodromy-y-wrong"

:= xy_composite () : automorphism_composition motive_p fiber_base auto_x auto_y compose_xy =
    AutomorphismComposition (x_auto (), y_auto (), "x-after-y")

:= yx_composite () : automorphism_composition motive_p fiber_base auto_y_wrong auto_x compose_yx =
    AutomorphismComposition (y_auto_wrong (), x_auto (), "wrong-y-after-x")

:= commuting_square () : commuting_2homotopy motive_p fiber_base auto_x auto_y compose_xy compose_yx commute_xy =
    Commuting2Homotopy (xy_composite (), yx_composite (), "torus-commutator-filled")

:= torus_algebra
    ()
    : torus_dependent_algebra torus_t torus_base loop_x loop_y torus_commutator motive_p fiber_base auto_x auto_y
        compose_xy compose_yx commute_xy
    =
    TorusDependentAlgebra (
        TorusHit "higher-inductive-torus",
        MotiveFiber "fiber-at-base",
        x_auto (),
        y_auto (),
        commuting_square (),
        "dependent-torus-algebra"
    )

:= torus_eliminator
    ()
    : torus_dependent_eliminator torus_t torus_base loop_x loop_y torus_commutator motive_p fiber_base auto_x auto_y
        compose_xy compose_yx commute_xy section_witness
    =
    TorusDependentEliminator (
        torus_algebra (),
        TorusSection "section-respects-two-loops-and-commutator",
        "torus-dependent-eliminator"
    )

:= eliminator_label \* base x_loop y_loop commutator fiber_id map_x map_y composite_xy composite_yx filler section.
    (_ :
        torus_dependent_eliminator
            torus_t base x_loop y_loop commutator motive_p fiber_id map_x map_y composite_xy composite_yx filler
            section)
    : string
    =
    "hott-torus-dependent-eliminator"

:= main () : string =
    := packed : packed_torus_eliminator torus_t motive_p = PackedTorusEliminator (\? (torus_eliminator ()))
    with_torus_eliminator `$eliminator_label packed
