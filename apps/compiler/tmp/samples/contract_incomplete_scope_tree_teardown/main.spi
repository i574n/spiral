:! app_scope = ()
:! root_owner = ()
:! child_a = ()
:! child_b = ()
:! live = ()
:! disposed = ()
:| subtree scope root left right state =
    | Subtree :: \* scope root left right state. string -> subtree scope root left right state
:| disposal scope owner state = | Disposal :: \* scope owner state. string -> disposal scope owner state
:= commit_teardown \* scope root left right.
    (tree : subtree scope root left right live) (left_proof : disposal scope left disposed)
    (right_proof : disposal scope right disposed)
    : subtree scope root left right disposed
    =
    Subtree "disposed"
:= main () =
    := tree : subtree app_scope root_owner child_a child_b live = Subtree "root"
    := left : disposal app_scope child_a disposed = Disposal "a"
    commit_teardown tree left left
