:! hg38 = ()
:! chr1 = ()
:! start = ()
:! overlap_a = ()
:! overlap_b = ()
:! overlap_c = ()
:! finish = ()

:| kmer build contig left right =
    | Kmer :: \* build contig left right. string -> kmer build contig left right

:| assembly_path build contig left right =
    | AssemblyPath :: \* build contig left right. string -> assembly_path build contig left right

:= singleton \* build contig left right.
    (kmer : kmer build contig left right)
    : assembly_path build contig left right =
    ?= kmer ?|
    | Kmer label => AssemblyPath label

:= append \* build contig left middle right.
    (path : assembly_path build contig left middle)
    (next : kmer build contig middle right)
    : assembly_path build contig left right =
    ?= path, next ?|
    | AssemblyPath _, Kmer label => AssemblyPath label

:= main () : assembly_path hg38 chr1 start finish =
    := k1 : kmer hg38 chr1 start overlap_a = Kmer "ACGT"
    := k2 : kmer hg38 chr1 overlap_c finish = Kmer "TTAA"
    append (singleton k1) k2
