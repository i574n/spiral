:! validate_id = ()
:! publish_id = ()
:! parallel = ()
:! serial = ()
:! validation_cap = ()
:! publish_cap = ()
:! draft = ()
:! validated = ()
:! authorized = ()

:| node id effect capability from to =
    | ValidateNode :: node validate_id parallel validation_cap draft validated
    | PublishNode :: node publish_id serial publish_cap validated authorized

:| packed_node from to =
    | PackedNode :: \* from to.
        (\? id. \? effect. \? capability.
            node id effect capability from to)
        -> packed_node from to

:| ^ manifest from to =
    | ManifestNode :: \* from to. packed_node from to -> manifest from to
    | Depends :: \* from to.
        (\? middle. manifest from middle * packed_node middle to)
        -> manifest from to

:= invalid () : manifest draft authorized =
    Depends (\? (
        ManifestNode (PackedNode (\? (\? (\? PublishNode)))),
        PackedNode (\? (\? (\? ValidateNode)))
    ))

:= main () : string = "unreachable"
