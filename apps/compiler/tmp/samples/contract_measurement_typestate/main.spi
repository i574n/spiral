:! zero = ()
:! succ n = n
:! coherent = ()
:! measured = ()

:| ^ qregister n =
    | QOne :: qregister (succ zero)
    | QSucc :: \* n. qregister n -> qregister (succ n)

:| qstate phase n =
    | CoherentState :: \* n. qregister n -> qstate coherent n
    | MeasuredState :: \* n. i32 -> qstate measured n

:= unitary \* n. (state : qstate coherent n) : qstate coherent n = state
:= measure \* n. (_ : qstate coherent n) : qstate measured n = MeasuredState 0

:= render_measurement \* n. (state : qstate measured n) : string =
    ?= state ?|
    | MeasuredState _ => "measured:0"

:= main () : string =
    render_measurement (measure (unitary (CoherentState QOne)))
