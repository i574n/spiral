nominal zero = ()
nominal succ n = n
nominal coherent = ()
nominal measured = ()

union rec qregister n =
    | QOne :: qregister (succ zero)
    | QSucc :: forall n. qregister n -> qregister (succ n)

union qstate phase n =
    | CoherentState :: forall n. qregister n -> qstate coherent n
    | MeasuredState :: forall n. i32 -> qstate measured n

inl unitary forall n. (state : qstate coherent n) : qstate coherent n = state
inl measure forall n. (_ : qstate coherent n) : qstate measured n = MeasuredState 0

inl render_measurement forall n. (state : qstate measured n) : string =
    match state with
    | MeasuredState _ => "measured:0"

inl main () : string =
    render_measurement (measure (unitary (CoherentState QOne)))
