:! state_proved = ()
:! finalized = ()
:! batch_700 = ()
:! epoch_31 = ()
:! root_poseidon_7 = ()
:! root_poseidon_8 = ()
:! availability_certificate batch epoch root = string
:! zk_proof batch epoch root = string
:! finality_receipt batch epoch root = string

:| rollup_op from to result =
    | FinalizeBatch :: \* batch epoch root.
        zk_proof batch epoch root * availability_certificate batch epoch root ->
        rollup_op state_proved finalized (finality_receipt batch epoch root)

:= finalize_root_7
    (proof : zk_proof batch_700 epoch_31 root_poseidon_7)
    (availability : availability_certificate batch_700 epoch_31 root_poseidon_7)
    : finality_receipt batch_700 epoch_31 root_poseidon_7 =
    ?= FinalizeBatch (proof, availability) ?|
    | FinalizeBatch _ => finality_receipt "finalized-root-7"

:= main () : finality_receipt batch_700 epoch_31 root_poseidon_7 =
    := proof : zk_proof batch_700 epoch_31 root_poseidon_7 = zk_proof "proof-root-7"
    := wrong : availability_certificate batch_700 epoch_31 root_poseidon_8 =
        availability_certificate "availability-root-8"
    finalize_root_7 proof wrong
