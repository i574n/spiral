:! signer_a = ()
:! signer_b = ()
:! key_a = ()
:! key_b = ()
:! root_digest = ()
:! epoch0 = ()
:! epoch1 = ()
:! verified = ()
:| root_vote signer key root epoch state =
    | RootVote :: \* signer key root epoch state. string -> root_vote signer key root epoch state
:| distinct left right = | SignerAB :: distinct signer_a signer_b
:| root_quorum root epoch left right =
    | RootQuorum :: \* root epoch left right. string -> root_quorum root epoch left right
:= form \* left right key_left key_right root epoch.
    (first : root_vote left key_left root epoch verified) (second : root_vote right key_right root epoch verified)
    (proof : distinct left right)
    : root_quorum root epoch left right
    =
    RootQuorum "quorum"
:= main () =
    := first : root_vote signer_a key_a root_digest epoch1 verified = RootVote "a"
    := stale : root_vote signer_b key_b root_digest epoch0 verified = RootVote "b"
    form first stale SignerAB
