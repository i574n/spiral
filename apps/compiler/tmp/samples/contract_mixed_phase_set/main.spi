:! sample_a = ()
:! hg38 = ()
:! chr1 = ()
:! pos0 = ()
:! pos1 = ()
:! pos2 = ()
:! phase_set_a = ()
:! phase_set_b = ()
:| phase_block sample build contig start finish phase_set =
    | PhaseBlock :: \* sample build contig start finish phase_set.
        string ->
        phase_block sample build contig start finish phase_set
:= append \* sample build contig start middle finish phase_set.
    (left : phase_block sample build contig start middle phase_set)
    (right : phase_block sample build contig middle finish phase_set)
    : phase_block sample build contig start finish phase_set
    =
    PhaseBlock "merged"
:= main () =
    := left : phase_block sample_a hg38 chr1 pos0 pos1 phase_set_a = PhaseBlock "left"
    := right : phase_block sample_a hg38 chr1 pos1 pos2 phase_set_b = PhaseBlock "right"
    append left right
