:! homologation = ()
:! production = ()
:! schema_v4 = ()
:! normal = ()
:! contingency = ()
:! draft = ()
:! signed = ()
:! authorized = ()

:! nfe_draft = { id : string; issuer : string }
:! nfe_signed = { xml : string; digest : string }
:! nfe_authorized = { xml : string; protocol : string; reconciled : bool }

:| document env schema state mode =
    | Draft :: \* env schema mode. nfe_draft -> document env schema draft mode
    | Signed :: \* env schema mode. nfe_signed -> document env schema signed mode
    | Authorized :: \* env schema mode. nfe_authorized -> document env schema authorized mode

:| transition env schema from to mode_from mode_to =
    | SignTransition :: \* env schema mode. transition env schema draft signed mode mode
    | EnterContingency :: \* env schema. transition env schema signed signed normal contingency
    | AuthorizeNormal :: \* env schema. transition env schema signed authorized normal normal
    | AuthorizeContingency :: \* env schema. transition env schema signed authorized contingency contingency
    | Reconcile :: \* env schema. transition env schema authorized authorized contingency normal

:= execute \* env schema from to mode_from mode_to.
    (transition : transition env schema from to mode_from mode_to)
    (document : document env schema from mode_from)
    : document env schema to mode_to =
    ?= transition, document ?|
    | SignTransition, Draft payload =>
        Signed (nfe_signed { xml = payload::id; digest = "sha256" })
    | EnterContingency, Signed payload =>
        Signed payload
    | AuthorizeNormal, Signed payload =>
        Authorized (nfe_authorized { xml = payload::xml; protocol = "normal"; reconciled = !+ })
    | AuthorizeContingency, Signed payload =>
        Authorized (nfe_authorized { xml = payload::xml; protocol = "contingency"; reconciled = !- })
    | Reconcile, Authorized payload =>
        Authorized (nfe_authorized { xml = payload::xml; protocol = payload::protocol; reconciled = !+ })

:= main () : string =
    := draft_document : document production schema_v4 draft normal =
        Draft (nfe_draft { id = "NFE-07"; issuer = "ACME" })
    := signed_document = execute SignTransition draft_document
    := contingency_document = execute EnterContingency signed_document
    := authorized_document = execute AuthorizeContingency contingency_document
    := reconciled_document = execute Reconcile authorized_document
    ?= reconciled_document ?|
    | Authorized payload =>
        ? payload::reconciled ?> "contingency-reconciled" |: "invalid"
