nominal draft = ()
nominal validated = ()
nominal authorized = ()
nominal idempotent = ()
nominal non_idempotent = ()

union operation from to effect =
    | Validate :: operation draft validated idempotent
    | Publish :: operation validated authorized non_idempotent

union row from to effect =
    | Row :: forall from to effect. string -> row from to effect

inl codec_bad (operation : operation draft validated idempotent) : row draft validated idempotent =
    match operation with
    | Validate => Row "validate-only"

inl emit forall from to effect.
    (serializer : forall a b e. operation a b e -> row a b e)
    (operation : operation from to effect)
    : row from to effect =
    serializer operation

inl main () = emit `$codec_bad Publish
