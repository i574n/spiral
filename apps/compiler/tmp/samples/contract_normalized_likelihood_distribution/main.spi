:! sample_a = ()
:! hg38 = ()
:! chr1 = ()
:! model_v2 = ()
:! raw = ()
:! normalized = ()
:! sums_to_one = ()

:| likelihoods sample build contig model state =
    | Likelihoods :: \* sample build contig model state. string -> likelihoods sample build contig model state
:| normalization_witness sample build contig model state =
    | Normalized :: \* sample build contig model state.
        string ->
        normalization_witness sample build contig model state
:| genotype_call sample build contig model =
    | Call :: \* sample build contig model. string -> genotype_call sample build contig model

:= normalize \* sample build contig model.
    (values : likelihoods sample build contig model raw)
    : likelihoods sample build contig model normalized * normalization_witness sample build contig model sums_to_one
    =
    Likelihoods "normalized", Normalized "one"
:= call \* sample build contig model.
    (values : likelihoods sample build contig model normalized)
    (proof : normalization_witness sample build contig model sums_to_one)
    : genotype_call sample build contig model
    =
    ?= values, proof ?| | Likelihoods _, Normalized _ => Call "normalized-likelihood-call"

:= main () : string =
    := values : likelihoods sample_a hg38 chr1 model_v2 raw = Likelihoods "raw"
    ?= normalize values ?| | normalized_values, proof =>
        ?= call normalized_values proof ?| | Call label => label
