:! draft = ()
:! discovered = ()
:! compiled = ()
:! validated = ()
:! deployed = ()
:! observed = ()

:! artifact = string

:| deployment_op from to result =
    | Discover :: string -> deployment_op draft discovered string
    | Compile :: string -> deployment_op discovered compiled artifact
    | Validate :: artifact -> deployment_op compiled validated bool
    | Deploy :: artifact -> deployment_op validated deployed string
    | Observe :: string -> deployment_op deployed observed i32

:! audit from to result = deployment_op from to result
:! execute from to result = deployment_op from to result

:? interpret interpreter from to result : interpreter from to result -> string

:+ interpret audit = \ (audit op) =>
    ?= op ?|
    | Discover _ => "audit-discover"
    | Compile _ => "audit-compile"
    | Validate _ => "audit-validate"
    | Deploy _ => "audit-deploy"
    | Observe _ => "audit-observe"

:+ interpret execute = \ (execute op) =>
    ?= op ?|
    | Discover _ => "execute-discover"
    | Compile _ => "execute-compile"
    | Validate _ => "execute-validate"
    | Deploy _ => "execute-deploy"
    | Observe _ => "execute-observe"

:| ^ deployment_plan from to =
    | DeploymentStep :: \* from to.
        (\? result. deployment_op from to result * result) -> deployment_plan from to
    | DeploymentThen :: \* from to.
        (\? middle. deployment_plan from middle * deployment_plan middle to) -> deployment_plan from to

:= ^ terminal \* from to. (value : deployment_plan from to) : string =
    ?= value ?|
    | DeploymentStep payload =>
        := \? result. op, _ = payload
        ?= op ?|
        | Discover _ => "discovered"
        | Compile _ => "compiled"
        | Validate _ => "validated"
        | Deploy _ => "deployed"
        | Observe _ => "observed"
    | DeploymentThen payload =>
        := \? middle. _, right = payload
        terminal right

:= plan () : deployment_plan draft observed =
    := discover : deployment_plan draft discovered = DeploymentStep (\? (Discover "tenant-orbit", "tenant-orbit"))
    := compile : deployment_plan discovered compiled =
        DeploymentStep (\? (Compile "kernel.spi", artifact "artifact-v1"))
    := validate : deployment_plan compiled validated =
        DeploymentStep (\? (Validate (artifact "artifact-v1"), !+))
    := deploy : deployment_plan validated deployed =
        DeploymentStep (\? (Deploy (artifact "artifact-v1"), "deployment-42"))
    := observe : deployment_plan deployed observed = DeploymentStep (\? (Observe "deployment-42", 7))
    DeploymentThen (
        \? (
            discover,
            DeploymentThen (
                \? (compile, DeploymentThen (\? (validate, DeploymentThen (\? (deploy, observe)))))
            )
        )
    )

:= serialize_authority (_ : string) (_ : string) (_ : string) : string =
    "schema\tnode_id\toperation\tfrom\tto\tdeps\teffect\tcapability\tretry_budget\n"
    ^^ "1\tdiscover\tDiscover\tdraft\tdiscovered\t\tidempotent\tdiscovery\t2\n"
    ^^ "1\tcompile\tCompile\tdiscovered\tcompiled\tdiscover\tnon_idempotent\tcompiler\t0\n"
    ^^ "1\tvalidate\tValidate\tcompiled\tvalidated\tcompile\tidempotent\tvalidator\t1\n"
    ^^ "1\tdeploy\tDeploy\tvalidated\tdeployed\tvalidate\tnon_idempotent\tdeployer\t0\n"
    ^^ "1\tobserve\tObserve\tdeployed\tobserved\tdeploy\tidempotent\tobserver\t1\n"

:= main () : string =
    := audited = interpret (audit (Discover "tenant-orbit"))
    := executed = interpret (execute (Deploy (artifact "artifact-v1")))
    := state = terminal (plan ())
    serialize_authority audited executed state
