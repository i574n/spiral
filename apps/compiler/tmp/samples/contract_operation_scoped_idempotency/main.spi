:! query = ()
:! authorize = ()
:! committed = ()

:| key operation =
    | QueryKey :: string -> key query
    | AuthorizeKey :: string -> key authorize

:| request operation result =
    | QueryStatus :: request query string
    | AuthorizeDocument :: string -> request authorize string

:| receipt operation status result =
    | Committed :: \* operation result.
        string * result -> receipt operation committed result

:= execute_once \* operation result.
    (key : key operation)
    (request : request operation result)
    : receipt operation committed result =
    ?= key, request ?|
    | QueryKey id, QueryStatus =>
        Committed (id, "authorized")
    | AuthorizeKey id, AuthorizeDocument protocol =>
        Committed (id, protocol)

:= consume_authorization
    (receipt : receipt authorize committed string)
    : string =
    ?= receipt ?|
    | Committed _ => "operation-scoped-idempotency"

:= main () : string =
    consume_authorization (
        execute_once
            (AuthorizeKey "authorize:NFe-42")
            (AuthorizeDocument "135240000000061")
    )
