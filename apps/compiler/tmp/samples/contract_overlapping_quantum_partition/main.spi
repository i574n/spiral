:! lineage_a = ()
:! whole = ()
:! left_slots = ()
:! right_slots = ()
:! coherent = ()
:| qregister lineage slots phase = | QRegister :: \* lineage slots phase. string -> qregister lineage slots phase
:| partition lineage whole left right =
    | Partition :: \* lineage whole left right. string -> partition lineage whole left right
:= merge \* lineage.
    (left : qregister lineage left_slots coherent) (right : qregister lineage right_slots coherent)
    (proof : partition lineage whole left_slots right_slots)
    : qregister lineage whole coherent
    =
    QRegister "merged"
:= main () =
    := left : qregister lineage_a left_slots coherent = QRegister "left"
    := proof : partition lineage_a whole left_slots right_slots = Partition "disjoint"
    merge left left proof
