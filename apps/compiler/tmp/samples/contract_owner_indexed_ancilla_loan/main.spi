:! owner_a = ()
:! clean = ()
:! borrowed = ()

:| ancilla owner state =
    | Ancilla :: \* owner state. string -> ancilla owner state

:| loan owner =
    | Loan :: \* owner. string -> loan owner

:= borrow \* owner.
    (ancilla : ancilla owner clean)
    : ancilla owner borrowed * loan owner =
    ?= ancilla ?|
    | Ancilla label => Ancilla label, Loan "loan"

:= release \* owner.
    (ancilla : ancilla owner borrowed)
    (loan : loan owner)
    : ancilla owner clean =
    ?= ancilla, loan ?|
    | Ancilla _, Loan _ => Ancilla "ancilla-clean"

:= label \* owner state. (ancilla : ancilla owner state) : string =
    ?= ancilla ?|
    | Ancilla value => value

:= main () : string =
    := ancilla : ancilla owner_a clean = Ancilla "clean"
    := borrowed, loan = borrow ancilla
    label (release borrowed loan)
