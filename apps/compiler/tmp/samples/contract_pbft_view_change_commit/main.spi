:! cold = ()
:! prepared = ()
:! view_change_started = ()
:! new_view_installed = ()
:! committed = ()

:! view_7 = ()
:! view_8 = ()
:! epoch_11 = ()
:! replica_a = ()
:! replica_b = ()
:! replica_c = ()
:! replica_d = ()
:! request_42 = ()

:| request_digest request =
    | Request42Digest :: string -> request_digest request_42

:| prepare_vote replica view epoch request =
    | PrepareA7 :: string -> prepare_vote replica_a view_7 epoch_11 request_42
    | PrepareB7 :: string -> prepare_vote replica_b view_7 epoch_11 request_42
    | PrepareC7 :: string -> prepare_vote replica_c view_7 epoch_11 request_42
    | PrepareD7 :: string -> prepare_vote replica_d view_7 epoch_11 request_42

:| view_change_vote replica old_view new_view epoch request =
    | ViewChangeA78 :: string -> view_change_vote replica_a view_7 view_8 epoch_11 request_42
    | ViewChangeB78 :: string -> view_change_vote replica_b view_7 view_8 epoch_11 request_42
    | ViewChangeC78 :: string -> view_change_vote replica_c view_7 view_8 epoch_11 request_42
    | ViewChangeD78 :: string -> view_change_vote replica_d view_7 view_8 epoch_11 request_42

:| quorum3 a b c =
    | Quorum3 :: \* a b c. a * b * c -> quorum3 a b c

:| new_view_certificate a b c old_view new_view epoch request =
    | NewViewBCD78 ::
        quorum3
            (view_change_vote replica_b view_7 view_8 epoch_11 request_42)
            (view_change_vote replica_c view_7 view_8 epoch_11 request_42)
            (view_change_vote replica_d view_7 view_8 epoch_11 request_42) ->
        new_view_certificate replica_b replica_c replica_d view_7 view_8 epoch_11 request_42

:| commit_certificate a b c old_view new_view epoch request =
    | CommitBCD78 ::
        new_view_certificate replica_b replica_c replica_d view_7 view_8 epoch_11 request_42 ->
        commit_certificate replica_b replica_c replica_d view_7 view_8 epoch_11 request_42

:| pbft_op from to result =
    | Prepare :: \* replica view epoch request.
        request_digest request ->
        pbft_op cold prepared (prepare_vote replica view epoch request)
    | StartViewChange :: \* replica old_view new_view epoch request.
        prepare_vote replica old_view epoch request ->
        pbft_op prepared view_change_started
            (view_change_vote replica old_view new_view epoch request)
    | InstallNewView :: \* a b c old_view new_view epoch request.
        quorum3
            (view_change_vote a old_view new_view epoch request)
            (view_change_vote b old_view new_view epoch request)
            (view_change_vote c old_view new_view epoch request) ->
        pbft_op view_change_started new_view_installed
            (new_view_certificate a b c old_view new_view epoch request)
    | Commit :: \* a b c old_view new_view epoch request.
        new_view_certificate a b c old_view new_view epoch request ->
        pbft_op new_view_installed committed
            (commit_certificate a b c old_view new_view epoch request)

:! signature_interpreter from to result = pbft_op from to result
:! network_interpreter from to result = pbft_op from to result
:! audit_interpreter from to result = pbft_op from to result

:? interpret interpreter from to result : interpreter from to result -> string

:+ interpret signature_interpreter = \ (signature_interpreter op) =>
    ?= op ?|
    | Prepare _ => "verify-client-digest"
    | StartViewChange _ => "verify-prepare-signature"
    | InstallNewView _ => "verify-distinct-view-change-signatures"
    | Commit _ => "verify-new-view-certificate"

:+ interpret network_interpreter = \ (network_interpreter op) =>
    ?= op ?|
    | Prepare _ => "broadcast-prepare"
    | StartViewChange _ => "broadcast-view-change"
    | InstallNewView _ => "broadcast-new-view"
    | Commit _ => "broadcast-commit"

:+ interpret audit_interpreter = \ (audit_interpreter op) =>
    ?= op ?|
    | Prepare _ => "audit-request-binding"
    | StartViewChange _ => "audit-old-new-view"
    | InstallNewView _ => "audit-quorum-distinctness"
    | Commit _ => "audit-commit-finality"

:| ^ pbft_plan from to =
    | PbftStep :: \* from to.
        (\? result. pbft_op from to result * result) -> pbft_plan from to
    | PbftThen :: \* from to.
        (\? middle. pbft_plan from middle * pbft_plan middle to) -> pbft_plan from to

:= ^ terminal \* from to. (plan : pbft_plan from to) : string =
    ?= plan ?|
    | PbftStep payload =>
        := \? result. op, _ = payload
        ?= op ?|
        | Prepare _ => "prepared"
        | StartViewChange _ => "view-change-started"
        | InstallNewView _ => "new-view-installed"
        | Commit _ => "committed"
    | PbftThen payload =>
        := \? middle. _, right = payload
        terminal right

:= prepare_vote_a () : prepare_vote replica_a view_7 epoch_11 request_42 =
    PrepareA7 "prepare-a"

:= change_vote_a () : view_change_vote replica_a view_7 view_8 epoch_11 request_42 =
    ViewChangeA78 "vc-a"

:= quorum_bcd () =
    Quorum3 (ViewChangeB78 "vc-b", ViewChangeC78 "vc-c", ViewChangeD78 "vc-d")

:= new_view_bcd () : new_view_certificate replica_b replica_c replica_d view_7 view_8 epoch_11 request_42 =
    NewViewBCD78 (quorum_bcd ())

:= commit_bcd () : commit_certificate replica_b replica_c replica_d view_7 view_8 epoch_11 request_42 =
    CommitBCD78 (new_view_bcd ())

:= build_plan () : pbft_plan cold committed =
    := prepare : pbft_plan cold prepared =
        PbftStep (\? (Prepare (Request42Digest "request-42"), prepare_vote_a ()))
    := change : pbft_plan prepared view_change_started =
        PbftStep (\? (StartViewChange (prepare_vote_a ()), change_vote_a ()))
    := install : pbft_plan view_change_started new_view_installed =
        PbftStep (\? (InstallNewView (quorum_bcd ()), new_view_bcd ()))
    := commit : pbft_plan new_view_installed committed =
        PbftStep (\? (Commit (new_view_bcd ()), commit_bcd ()))
    PbftThen (\? (prepare,
        PbftThen (\? (change,
            PbftThen (\? (install, commit))))))

:| sealed_commit =
    | SealedCommit ::
        (\? a b c old_view new_view epoch request.
            commit_certificate a b c old_view new_view epoch request) ->
        sealed_commit

:= inspect_commit \* a b c old_view new_view epoch request.
    (_ : commit_certificate a b c old_view new_view epoch request) : string =
    "commit-certificate-bound"

:= with_sealed \* output.
    (visit :
        \* a b c old_view new_view epoch request.
            commit_certificate a b c old_view new_view epoch request -> output)
    (value : sealed_commit) : output =
    ?= value ?|
    | SealedCommit payload =>
        := \? a b c old_view new_view epoch request. certificate = payload
        visit certificate

:= serialize_authority (_ : string) (_ : string) (_ : string) (_ : string) : string =
    "schema\tnode_id\toperation\tfrom\tto\tdeps\teffect\tcapability\tretry_budget\n"
    ^^ "1\tprepare\tPrepare\tcold\tprepared\t\tidempotent\treplica-a\t1\n"
    ^^ "1\tview-change\tStartViewChange\tprepared\tview_change_started\tprepare\tidempotent\tview-8\t1\n"
    ^^ "1\tinstall-new-view\tInstallNewView\tview_change_started\tnew_view_installed\tview-change\tnon_idempotent\tquo"
    ^^ "rum-3\t0\n1\tcommit\tCommit\tnew_view_installed\tcommitted\tinstall-new-view\tnon_idempotent\tview-8\t0\n"

:= main () : string =
    := prepare_op : pbft_op cold prepared (prepare_vote replica_a view_7 epoch_11 request_42) =
        Prepare (Request42Digest "request-42")
    := commit_op :
        pbft_op new_view_installed committed
            (commit_certificate replica_b replica_c replica_d view_7 view_8 epoch_11 request_42) =
        Commit (new_view_bcd ())
    := install_op :
        pbft_op view_change_started new_view_installed
            (new_view_certificate replica_b replica_c replica_d view_7 view_8 epoch_11 request_42) =
        InstallNewView (quorum_bcd ())
    := sig = interpret (signature_interpreter prepare_op)
    := net = interpret (network_interpreter commit_op)
    := audit = interpret (audit_interpreter install_op)
    := sealed_label = with_sealed `$inspect_commit (SealedCommit (\? (commit_bcd ())))
    serialize_authority sig net audit (terminal (build_plan ()))
