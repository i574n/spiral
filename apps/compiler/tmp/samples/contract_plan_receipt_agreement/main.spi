:! query_status = ()
:! publish_nfe = ()

:| operation op result =
    | QueryStatus :: operation query_status string
    | PublishNfe :: operation publish_nfe string

:| receipt op result =
    | QueryReceipt :: string -> receipt query_status string
    | PublishReceipt :: string -> receipt publish_nfe string

:= accept \* op result.
    (operation : operation op result)
    (receipt : receipt op result)
    : string =
    ?= operation, receipt ?|
    | QueryStatus, QueryReceipt value => value
    | PublishNfe, PublishReceipt value => value

:= main () : string =
    accept QueryStatus (QueryReceipt "plan-receipt-agreement")
