:! haploid = ()
:! diploid = ()

:| genome ploidy =
    | Gamete :: string -> genome haploid
    | HomologPair :: string * string -> genome diploid

:= meiosis (genome : genome diploid) : genome haploid * genome haploid =
    ?= genome ?|
    | HomologPair (maternal, paternal) => Gamete maternal, Gamete paternal

:= render_gametes (pair : genome haploid * genome haploid) : string =
    ?= pair ?|
    | Gamete _, Gamete _ => "maternal:paternal"

:= main () : string =
    render_gametes (meiosis (HomologPair ("maternal", "paternal")))
