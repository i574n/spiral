nominal validate_id = ()
nominal publish_id = ()
nominal parallel = ()
nominal serial = ()
nominal validation_cap = ()
nominal publish_cap = ()
nominal draft = ()
nominal validated = ()
nominal authorized = ()

union node id effect capability from to =
    | ValidateNode :: node validate_id parallel validation_cap draft validated
    | PublishNode :: node publish_id serial publish_cap validated authorized

union packed_node from to =
    | PackedNode :: forall from to.
        (exists id. exists effect. exists capability.
            node id effect capability from to)
        -> packed_node from to

union rec manifest from to =
    | ManifestNode :: forall from to. packed_node from to -> manifest from to
    | Depends :: forall from to.
        (exists middle. manifest from middle * packed_node middle to)
        -> manifest from to

inl render_node forall from to. (node : packed_node from to) : string =
    match node with
    | PackedNode node =>
        inl exists id. exists effect. exists capability. node = node
        match node with
        | ValidateNode => "validate|parallel|validation-cap"
        | PublishNode => "publish|serial|publish-cap"

inl rec render forall from to. (plan : manifest from to) : string =
    match plan with
    | ManifestNode node => render_node node
    | Depends _ => "proof-carrying-manifest"

inl plan () : manifest draft authorized =
    Depends (exists (
        ManifestNode (PackedNode (exists (exists (exists ValidateNode)))),
        PackedNode (exists (exists (exists PublishNode)))
    ))

inl main () : string =
    render (plan ())