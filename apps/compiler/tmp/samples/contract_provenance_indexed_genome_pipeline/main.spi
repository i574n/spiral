:! donor_a = ()
:! hg38 = ()
:! raw = ()
:! aligned = ()
:! variants = ()

:| readset source build stage =
    | ReadSet :: \* source build stage. string -> readset source build stage

:= align \* source build. (reads : readset source build raw) : readset source build aligned =
    ?= reads ?|
    | ReadSet label => ReadSet label

:= call_variants \* source build. (reads : readset source build aligned) : readset source build variants =
    ?= reads ?|
    | ReadSet label => ReadSet label

:= publish (calls : readset donor_a hg38 variants) : string =
    ?= calls ?|
    | ReadSet label => label

:= main () : string =
    := reads : readset donor_a hg38 raw = ReadSet "donor-a:hg38:variants"
    publish (call_variants (align reads))
