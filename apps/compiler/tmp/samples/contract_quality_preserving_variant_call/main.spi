:! sample_a = ()
:! hg38 = ()
:! raw = ()
:! aligned = ()
:! filtered = ()
:! called = ()

:| readset sample build stage =
    | RawReads :: \* sample build. string -> readset sample build raw
    | AlignedReads :: \* sample build. string -> readset sample build aligned
    | FilteredReads :: \* sample build. string -> readset sample build filtered

:| callset sample build stage =
    | Callset :: \* sample build. string -> callset sample build called

:= align \* sample build.
    (reads : readset sample build raw)
    : readset sample build aligned =
    ?= reads ?|
    | RawReads _ => AlignedReads "aligned"

:= filter_quality \* sample build.
    (reads : readset sample build aligned)
    : readset sample build filtered =
    ?= reads ?|
    | AlignedReads _ => FilteredReads "quality-filtered"

:= call_variants \* sample build.
    (reads : readset sample build filtered)
    : callset sample build called =
    ?= reads ?|
    | FilteredReads _ => Callset "quality-preserving-callset"

:= main () : string =
    := raw_reads : readset sample_a hg38 raw = RawReads "fastq"
    ?= call_variants (filter_quality (align raw_reads)) ?|
    | Callset label => label
