:! zero = ()
:! succ n = n
:! lineage_a = ()
:! coherent = ()

:| ^ budget n =
    | ZeroBudget :: budget zero
    | MoreBudget :: \* n. budget n -> budget (succ n)

:| qstate lineage phase = | QState :: \* lineage phase. string -> qstate lineage phase

:= apply_gate \* lineage n.
    (state : qstate lineage coherent) (budget : budget (succ n))
    : qstate lineage coherent * budget n
    =
    ?= budget ?| | MoreBudget rest => state, rest

:= main () : string =
    := state : qstate lineage_a coherent = QState "psi"
    := budget : budget (succ (succ zero)) = MoreBudget (MoreBudget ZeroBudget)
    ?= apply_gate state budget ?|
    | state1, budget1 =>
        ?= apply_gate state1 budget1 ?|
        | QState _, ZeroBudget => "quantum-depth-budget-accounted"
