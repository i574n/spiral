:! idle = ()
:! route_requested = ()
:! track_proved_clear = ()
:! points_locked = ()
:! signal_cleared = ()
:! train_entered = ()
:! route_released = ()

:! route_north = ()
:! route_south = ()
:! train_77 = ()
:! epoch_5 = ()
:! track_a = ()
:! track_b = ()
:! point_12 = ()
:! flank_9 = ()

:| route_request route train epoch =
    | NorthRequest77 :: string -> route_request route_north train_77 epoch_5
    | SouthRequest77 :: string -> route_request route_south train_77 epoch_5

:| clearance track route train epoch =
    | TrackANorth77Clear :: string -> clearance track_a route_north train_77 epoch_5
    | TrackBNorth77Clear :: string -> clearance track_b route_north train_77 epoch_5

:| point_lock point route train epoch =
    | Point12North77Lock :: string -> point_lock point_12 route_north train_77 epoch_5

:| flank_lock flank route train epoch =
    | Flank9North77Lock :: string -> flank_lock flank_9 route_north train_77 epoch_5

:| signal_token point flank route train epoch =
    | NorthSignal77 :: string -> signal_token point_12 flank_9 route_north train_77 epoch_5

:| occupancy point flank train route epoch =
    | NorthOccupancy77 :: string -> occupancy point_12 flank_9 train_77 route_north epoch_5

:| release_receipt point flank route train epoch =
    | NorthRelease77 :: string -> release_receipt point_12 flank_9 route_north train_77 epoch_5

:| pair a b =
    | Pair :: \* a b. a * b -> pair a b

:| interlocking_op from to result =
    | RequestRoute :: \* route train epoch.
        string -> interlocking_op idle route_requested (route_request route train epoch)
    | ProveClear :: \* track route train epoch.
        route_request route train epoch * string ->
        interlocking_op route_requested track_proved_clear
            (clearance track route train epoch)
    | LockPoints :: \* point flank route train epoch.
        clearance track_a route train epoch * clearance track_b route train epoch ->
        interlocking_op track_proved_clear points_locked
            (pair
                (point_lock point route train epoch)
                (flank_lock flank route train epoch))
    | ClearSignal :: \* point flank route train epoch.
        route_request route train epoch *
        pair
            (point_lock point route train epoch)
            (flank_lock flank route train epoch) ->
        interlocking_op points_locked signal_cleared
            (signal_token point flank route train epoch)
    | EnterTrain :: \* point flank route train epoch.
        signal_token point flank route train epoch ->
        interlocking_op signal_cleared train_entered
            (occupancy point flank train route epoch)
    | ReleaseRoute :: \* point flank route train epoch.
        occupancy point flank train route epoch * string ->
        interlocking_op train_entered route_released
            (release_receipt point flank route train epoch)

:! topology_interpreter from to result = interlocking_op from to result
:! signal_interpreter from to result = interlocking_op from to result
:! safety_interpreter from to result = interlocking_op from to result

:? interpret interpreter from to result : interpreter from to result -> string

:+ interpret topology_interpreter = \ (topology_interpreter op) =>
    ?= op ?|
    | RequestRoute _ => "topology-reserve-conflict-set"
    | ProveClear _ => "topology-check-axle-counters"
    | LockPoints _ => "topology-lock-route-and-flank"
    | ClearSignal _ => "topology-route-complete"
    | EnterTrain _ => "topology-occupy-track-circuit"
    | ReleaseRoute _ => "topology-progressive-release"

:+ interpret signal_interpreter = \ (signal_interpreter op) =>
    ?= op ?|
    | RequestRoute _ => "signal-request-dark"
    | ProveClear _ => "signal-hold-red"
    | LockPoints _ => "signal-verify-detection"
    | ClearSignal _ => "signal-clear-green"
    | EnterTrain _ => "signal-lock-behind-train"
    | ReleaseRoute _ => "signal-return-red"

:+ interpret safety_interpreter = \ (safety_interpreter op) =>
    ?= op ?|
    | RequestRoute _ => "safety-no-conflicting-route"
    | ProveClear _ => "safety-two-track-clearances"
    | LockPoints _ => "safety-flank-protection"
    | ClearSignal _ => "safety-locks-same-route"
    | EnterTrain _ => "safety-token-same-train"
    | ReleaseRoute _ => "safety-tail-clear"

:| ^ route_plan from to =
    | RouteStep :: \* from to.
        (\? result. interlocking_op from to result * result) -> route_plan from to
    | RouteThen :: \* from to.
        (\? middle. route_plan from middle * route_plan middle to) -> route_plan from to

:= request_north () = NorthRequest77 "north-77"
:= clear_a () = TrackANorth77Clear "track-a-clear"
:= clear_b () = TrackBNorth77Clear "track-b-clear"
:= locks_north () = Pair (Point12North77Lock "point-12-normal", Flank9North77Lock "flank-9-locked")
:= signal_north () = NorthSignal77 "north-green-77"
:= occupancy_north () = NorthOccupancy77 "train-77-north"
:= release_north () = NorthRelease77 "north-released"

:= ^ terminal \* from to. (plan : route_plan from to) : string =
    ?= plan ?|
    | RouteStep payload =>
        := \? result. op, _ = payload
        ?= op ?|
        | RequestRoute _ => "route-requested"
        | ProveClear _ => "track-proved-clear"
        | LockPoints _ => "points-locked"
        | ClearSignal _ => "signal-cleared"
        | EnterTrain _ => "train-entered"
        | ReleaseRoute _ => "route-released"
    | RouteThen payload =>
        := \? middle. _, right = payload
        terminal right

:= build_plan () : route_plan idle route_released =
    := request_step : route_plan idle route_requested =
        RouteStep (\? (RequestRoute "north", request_north ()))
    := clear_step : route_plan route_requested track_proved_clear =
        RouteStep (\? (ProveClear (request_north (), "track-a+b"), clear_a ()))
    := lock_step : route_plan track_proved_clear points_locked =
        RouteStep (\? (LockPoints (clear_a (), clear_b ()), locks_north ()))
    := signal_step : route_plan points_locked signal_cleared =
        RouteStep (\? (ClearSignal (request_north (), locks_north ()), signal_north ()))
    := enter_step : route_plan signal_cleared train_entered =
        RouteStep (\? (EnterTrain (signal_north ()), occupancy_north ()))
    := release_step : route_plan train_entered route_released =
        RouteStep (\? (ReleaseRoute (occupancy_north (), "tail-clear"), release_north ()))
    RouteThen (\? (request_step,
        RouteThen (\? (clear_step,
            RouteThen (\? (lock_step,
                RouteThen (\? (signal_step,
                    RouteThen (\? (enter_step, release_step))))))))))

:| sealed_release =
    | SealedRelease ::
        (\? point flank route train epoch. release_receipt point flank route train epoch) -> sealed_release

:= inspect_release \* point flank route train epoch.
    (_ : release_receipt point flank route train epoch) : string = "route-release-bound-to-train-and-epoch"

:= with_release \* output.
    (visit : \* point flank route train epoch. release_receipt point flank route train epoch -> output)
    (value : sealed_release) : output =
    ?= value ?|
    | SealedRelease payload =>
        := \? point flank route train epoch. receipt = payload
        visit receipt

:= serialize_authority (_ : string) (_ : string) (_ : string) (_ : string) : string =
    "schema\tnode_id\toperation\tfrom\tto\tdeps\teffect\tcapability\tretry_budget\n"
    ^^ "1\trequest-route\tRequestRoute\tidle\troute_requested\t\tidempotent\tdispatcher\t1\n"
    ^^ "1\tprove-clear\tProveClear\troute_requested\ttrack_proved_clear\trequest-route\tidempotent\taxle-counters\t1\n"
    ^^ "1\tlock-points\tLockPoints\ttrack_proved_clear\tpoints_locked\tprove-clear\tnon_idempotent\tinterlocking\t0\n"
    ^^ "1\tclear-signal\tClearSignal\tpoints_locked\tsignal_cleared\tlock-points\tnon_idempotent\tsignal-system\t0\n"
    ^^ "1\tenter-train\tEnterTrain\tsignal_cleared\ttrain_entered\tclear-signal\tnon_idempotent\ttrain-77\t0\n"
    ^^ "1\trelease-route\tReleaseRoute\ttrain_entered\troute_released\tenter-train\tnon_idempotent\ttail-clear\t0\n"

:= main () : string =
    := request_op : interlocking_op idle route_requested (route_request route_north train_77 epoch_5) =
        RequestRoute "north"
    := signal_op
        : interlocking_op points_locked signal_cleared (signal_token point_12 flank_9 route_north train_77 epoch_5)
        =
        ClearSignal (request_north (), locks_north ())
    := release_op
        : interlocking_op train_entered route_released (release_receipt point_12 flank_9 route_north train_77 epoch_5)
        =
        ReleaseRoute (occupancy_north (), "tail-clear")
    := topology = interpret (topology_interpreter request_op)
    := signal = interpret (signal_interpreter signal_op)
    := safety = interpret (safety_interpreter release_op)
    := sealed_label = with_release `$inspect_release (SealedRelease (\? (release_north ())))
    serialize_authority topology signal safety (terminal (build_plan ()))
