:! hg38 = ()
:! chr1 = ()
:! pos100 = ()
:! allele_a = ()
:! allele_t = ()
:! raw = ()
:! normalized = ()

:| reference build contig pos allele =
    | Reference :: \* build contig pos allele. string -> reference build contig pos allele
:| variant build contig pos ref alt state =
    | Variant :: \* build contig pos ref alt state. string -> variant build contig pos ref alt state

:= normalize \* build contig pos ref alt.
    (reference : reference build contig pos ref) (variant : variant build contig pos ref alt raw)
    : variant build contig pos ref alt normalized
    =
    ?= reference, variant ?| | Reference _, Variant _ => Variant "reference-anchored-variant"

:= main () : string =
    := reference : reference hg38 chr1 pos100 allele_a = Reference "A"
    := variant : variant hg38 chr1 pos100 allele_a allele_t raw = Variant "A>T"
    ?= normalize reference variant ?| | Variant label => label
