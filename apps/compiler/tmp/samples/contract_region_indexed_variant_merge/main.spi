:! donor_a = ()
:! hg38 = ()
:! chr1 = ()
:! raw = ()
:! normalized = ()
:! merged = ()

:| callset sample build contig phase =
    | RawCallset :: \* sample build contig. string -> callset sample build contig raw
    | NormalizedCallset :: \* sample build contig. string -> callset sample build contig normalized
    | MergedCallset :: \* sample build contig. string -> callset sample build contig merged

:| normalization sample build contig from to =
    | NormalizeLeft :: \* sample build contig. normalization sample build contig raw normalized
    | NormalizeRight :: \* sample build contig. normalization sample build contig raw normalized

:| merge_input sample build contig =
    | MergeInput :: \* sample build contig.
        callset sample build contig normalized * callset sample build contig normalized
        -> merge_input sample build contig

:| ^ normalization_plan sample build contig from to =
    | NormalizeLeaf :: \* sample build contig from to.
        normalization sample build contig from to
        -> normalization_plan sample build contig from to
    | NormalizeThen :: \* sample build contig from to.
        (\? middle.
            normalization_plan sample build contig from middle
            * normalization sample build contig middle to)
        -> normalization_plan sample build contig from to

:= normalize \* sample build contig.
    (step : normalization sample build contig raw normalized)
    (calls : callset sample build contig raw)
    : callset sample build contig normalized =
    ?= step, calls ?|
    | NormalizeLeft, RawCallset label => NormalizedCallset label
    | NormalizeRight, RawCallset label => NormalizedCallset label

:= merge_calls \* sample build contig.
    (input : merge_input sample build contig)
    : callset sample build contig merged =
    ?= input ?|
    | MergeInput (NormalizedCallset _, NormalizedCallset _) => MergedCallset "merged-calls"

:= label \* sample build contig. (calls : callset sample build contig merged) : string =
    ?= calls ?|
    | MergedCallset value => value

:= main () : string =
    := left : callset donor_a hg38 chr1 raw = RawCallset "left"
    := right : callset donor_a hg38 chr1 raw = RawCallset "right"
    := left' = normalize NormalizeLeft left
    := right' = normalize NormalizeRight right
    label (merge_calls (MergeInput (left', right')))
