:! transfer_a = ()
:! manifest_good = ()
:! manifest_fork = ()
:! round_29 = ()
:! epoch_2 = ()
:! epoch_3 = ()
:! registry_root_29 = ()
:! evidence_root_29 = ()
:! peer_a = ()
:! peer_b = ()
:! peer_c = ()
:! peer_x = ()
:! peer_y = ()
:! key_a_old = ()
:! key_a_new = ()
:! key_b_old = ()
:! key_b_new = ()
:! key_c_old = ()
:! key_c_new = ()
:! key_x_new = ()
:! key_y_new = ()
:! key_revoked = ()
:! collecting = ()
:! registry_loaded = ()
:! equivocation_detected = ()
:! reconfigured = ()
:! quorum_ready = ()
:! committed = ()
:! active = ()
:! retired = ()
:! revoked = ()
:! authenticated = ()
:! distinct = ()
:! durable = ()
:! idempotent = ()
:! non_idempotent = ()

:| public_key peer key round status state =
    | PublicKey :: \* peer key round status state.
        string -> public_key peer key round status state

:| key_successor peer old_key new_key round state =
    | KeySuccessor :: \* peer old_key new_key round state.
        string -> key_successor peer old_key new_key round state

:| registry_entry peer key round status root state =
    | RegistryEntry :: \* peer key round status root state.
        public_key peer key round status authenticated * string -> registry_entry peer key round status root state

:| public_statement transfer manifest peer key round state =
    | PublicStatement :: \* transfer manifest peer key round state.
        string -> public_statement transfer manifest peer key round state

:| public_equivocation transfer peer key round left_manifest right_manifest state =
    | PublicEquivocation :: \* transfer peer key round left_manifest right_manifest state.
        public_statement transfer left_manifest peer key round authenticated *
        public_statement transfer right_manifest peer key round authenticated *
        string -> public_equivocation transfer peer key round left_manifest right_manifest state

:| one_shot_reuse peer key round state =
    | OneShotReuse :: \* peer key round state.
        string -> one_shot_reuse peer key round state

:| key_rotation peer old_key new_key from_epoch to_epoch state =
    | KeyRotation :: \* peer old_key new_key from_epoch to_epoch state.
        key_successor peer old_key new_key round_29 authenticated * string ->
        key_rotation peer old_key new_key from_epoch to_epoch state

:| key_revocation peer key epoch state =
    | KeyRevocation :: \* peer key epoch state.
        string -> key_revocation peer key epoch state

:| public_membership epoch pa ka pb kb pc kc root state =
    | PublicMembership :: \* epoch pa ka pb kb pc kc root state.
        registry_entry pa ka round_29 active root authenticated *
        registry_entry pb kb round_29 active root authenticated *
        registry_entry pc kc round_29 active root authenticated *
        string -> public_membership epoch pa ka pb kb pc kc root state

:| distinct_public_signers pa ka pb kb pc kc state =
    | DistinctPublicSigners :: \* pa ka pb kb pc kc state.
        string -> distinct_public_signers pa ka pb kb pc kc state

:| public_quorum transfer manifest round epoch pa ka pb kb pc kc registry_root state =
    | PublicQuorum :: \* transfer manifest round epoch pa ka pb kb pc kc registry_root state.
        public_statement transfer manifest pa ka round authenticated *
        public_statement transfer manifest pb kb round authenticated *
        public_statement transfer manifest pc kc round authenticated *
        distinct_public_signers pa ka pb kb pc kc distinct *
        public_membership epoch pa ka pb kb pc kc registry_root durable *
        string -> public_quorum transfer manifest round epoch pa ka pb kb pc kc registry_root state

:| public_commit transfer manifest round epoch registry_root evidence_root state =
    | PublicCommit :: \* transfer manifest round epoch registry_root evidence_root state.
        string -> public_commit transfer manifest round epoch registry_root evidence_root state

:| public_byzantine_op transfer good_manifest fork_manifest round pa ka_old ka_new pb kb_old kb_new pc kc_old kc_new
    px kx py ky revoked_key from_epoch to_epoch registry_root evidence_root from to effect =
    | LoadRotatedRegistry :: \* transfer good_manifest fork_manifest round pa ka_old ka_new pb kb_old kb_new pc
        kc_old kc_new px kx py ky revoked_key from_epoch to_epoch registry_root evidence_root.
        registry_entry pa ka_old round retired registry_root authenticated *
        registry_entry pa ka_new round active registry_root authenticated *
        registry_entry pb kb_old round retired registry_root authenticated *
        registry_entry pb kb_new round active registry_root authenticated *
        registry_entry pc kc_old round retired registry_root authenticated *
        registry_entry pc kc_new round active registry_root authenticated *
        registry_entry pa revoked_key round revoked registry_root authenticated *
        key_successor pa ka_old ka_new round authenticated *
        key_successor pb kb_old kb_new round authenticated *
        key_successor pc kc_old kc_new round authenticated ->
        public_byzantine_op
            transfer good_manifest fork_manifest round pa ka_old ka_new pb kb_old kb_new pc kc_old kc_new px kx py ky
            revoked_key from_epoch to_epoch registry_root evidence_root collecting registry_loaded idempotent
    | VerifyPublicEquivocation :: \* transfer good_manifest fork_manifest round pa ka_old ka_new pb kb_old kb_new pc
        kc_old kc_new px kx py ky revoked_key from_epoch to_epoch registry_root evidence_root.
        public_statement transfer good_manifest pa ka_new round authenticated *
        public_statement transfer good_manifest pb kb_new round authenticated *
        public_statement transfer good_manifest pc kc_new round authenticated *
        public_equivocation transfer px kx round good_manifest fork_manifest authenticated *
        public_equivocation transfer py ky round good_manifest fork_manifest authenticated *
        one_shot_reuse px kx round authenticated *
        one_shot_reuse py ky round authenticated ->
        public_byzantine_op
            transfer good_manifest fork_manifest round pa ka_old ka_new pb kb_old kb_new pc kc_old kc_new px kx py ky
            revoked_key from_epoch to_epoch registry_root evidence_root registry_loaded equivocation_detected idempotent
    | RotateRevokeAndExpel :: \* transfer good_manifest fork_manifest round pa ka_old ka_new pb kb_old kb_new pc
        kc_old kc_new px kx py ky revoked_key from_epoch to_epoch registry_root evidence_root.
        key_rotation pa ka_old ka_new from_epoch to_epoch durable *
        key_rotation pb kb_old kb_new from_epoch to_epoch durable *
        key_rotation pc kc_old kc_new from_epoch to_epoch durable *
        key_revocation pa revoked_key to_epoch durable *
        public_membership to_epoch pa ka_new pb kb_new pc kc_new registry_root durable ->
        public_byzantine_op
            transfer good_manifest fork_manifest round pa ka_old ka_new pb kb_old kb_new pc kc_old kc_new px kx py ky
            revoked_key from_epoch to_epoch registry_root evidence_root equivocation_detected reconfigured
            non_idempotent
    | FormPublicQuorum :: \* transfer good_manifest fork_manifest round pa ka_old ka_new pb kb_old kb_new pc kc_old
        kc_new px kx py ky revoked_key from_epoch to_epoch registry_root evidence_root.
        public_statement transfer good_manifest pa ka_new round authenticated *
        public_statement transfer good_manifest pb kb_new round authenticated *
        public_statement transfer good_manifest pc kc_new round authenticated *
        distinct_public_signers pa ka_new pb kb_new pc kc_new distinct *
        public_membership to_epoch pa ka_new pb kb_new pc kc_new registry_root durable *
        public_quorum transfer good_manifest round to_epoch pa ka_new pb kb_new pc kc_new registry_root authenticated ->
        public_byzantine_op
            transfer good_manifest fork_manifest round pa ka_old ka_new pb kb_old kb_new pc kc_old kc_new px kx py ky
            revoked_key from_epoch to_epoch registry_root evidence_root reconfigured quorum_ready idempotent
    | PublishPublicCommit :: \* transfer good_manifest fork_manifest round pa ka_old ka_new pb kb_old kb_new pc
        kc_old kc_new px kx py ky revoked_key from_epoch to_epoch registry_root evidence_root.
        public_quorum transfer good_manifest round to_epoch pa ka_new pb kb_new pc kc_new registry_root authenticated *
        public_commit transfer good_manifest round to_epoch registry_root evidence_root committed ->
        public_byzantine_op
            transfer good_manifest fork_manifest round pa ka_old ka_new pb kb_old kb_new pc kc_old kc_new px kx py ky
            revoked_key from_epoch to_epoch registry_root evidence_root quorum_ready committed non_idempotent

:| public_byzantine_row transfer manifest round registry_root evidence_root from to effect =
    | PublicByzantineRow :: \* transfer manifest round registry_root evidence_root from to effect.
        string -> public_byzantine_row transfer manifest round registry_root evidence_root from to effect

:| public_byzantine_node transfer good_manifest fork_manifest round pa ka_old ka_new pb kb_old kb_new pc kc_old
    kc_new px kx py ky revoked_key from_epoch to_epoch registry_root evidence_root from to =
    | PublicByzantineNode :: \* transfer good_manifest fork_manifest round pa ka_old ka_new pb kb_old kb_new pc
        kc_old kc_new px kx py ky revoked_key from_epoch to_epoch registry_root evidence_root from to.
        (\? effect.
            public_byzantine_op
                transfer good_manifest fork_manifest round pa ka_old ka_new pb kb_old kb_new pc kc_old kc_new px kx py
                ky revoked_key from_epoch to_epoch registry_root evidence_root from to effect *
            public_byzantine_row transfer good_manifest round registry_root evidence_root from to effect) ->
        public_byzantine_node
            transfer good_manifest fork_manifest round pa ka_old ka_new pb kb_old kb_new pc kc_old kc_new px kx py ky
            revoked_key from_epoch to_epoch registry_root evidence_root from to

:| ^ public_byzantine_plan transfer good_manifest fork_manifest round pa ka_old ka_new pb kb_old kb_new pc kc_old
    kc_new px kx py ky revoked_key from_epoch to_epoch registry_root evidence_root from to =
    | PublicByzantineLeaf :: \* transfer good_manifest fork_manifest round pa ka_old ka_new pb kb_old kb_new pc
        kc_old kc_new px kx py ky revoked_key from_epoch to_epoch registry_root evidence_root from to.
        public_byzantine_node
            transfer good_manifest fork_manifest round pa ka_old ka_new pb kb_old kb_new pc kc_old kc_new px kx py ky
            revoked_key from_epoch to_epoch registry_root evidence_root from to ->
        public_byzantine_plan
            transfer good_manifest fork_manifest round pa ka_old ka_new pb kb_old kb_new pc kc_old kc_new px kx py ky
            revoked_key from_epoch to_epoch registry_root evidence_root from to
    | PublicByzantineThen :: \* transfer good_manifest fork_manifest round pa ka_old ka_new pb kb_old kb_new pc
        kc_old kc_new px kx py ky revoked_key from_epoch to_epoch registry_root evidence_root from to.
        (\? middle.
            public_byzantine_plan
                transfer good_manifest fork_manifest round pa ka_old ka_new pb kb_old kb_new pc kc_old kc_new px kx py
                ky revoked_key from_epoch to_epoch registry_root evidence_root from middle *
            public_byzantine_node
                transfer good_manifest fork_manifest round pa ka_old ka_new pb kb_old kb_new pc kc_old kc_new px kx
                py ky revoked_key from_epoch to_epoch registry_root evidence_root middle to) ->
        public_byzantine_plan
            transfer good_manifest fork_manifest round pa ka_old ka_new pb kb_old kb_new pc kc_old kc_new px kx py ky
            revoked_key from_epoch to_epoch registry_root evidence_root from to

:| packed_public_byzantine transfer manifest =
    | PackedPublicByzantine :: \* transfer manifest.
        (
            \? fork_manifest round pa ka_old ka_new pb kb_old kb_new pc kc_old kc_new px kx py ky revoked_key
                from_epoch to_epoch registry_root evidence_root.
                public_byzantine_plan
                    transfer manifest fork_manifest round pa ka_old ka_new pb kb_old kb_new pc kc_old kc_new px kx py ky
                    revoked_key from_epoch to_epoch registry_root evidence_root collecting committed
        ) ->
        packed_public_byzantine transfer manifest

:= with_packed_public_byzantine \* transfer manifest result.
    (visit :
        \* fork_manifest round pa ka_old ka_new pb kb_old kb_new pc kc_old kc_new px kx py ky revoked_key from_epoch
            to_epoch registry_root evidence_root.
            public_byzantine_plan
                transfer manifest fork_manifest round pa ka_old ka_new pb kb_old kb_new pc kc_old kc_new px kx py ky
                revoked_key from_epoch to_epoch registry_root evidence_root collecting committed ->
            result)
    (packed : packed_public_byzantine transfer manifest)
    : result
    =
    ?= packed ?|
    | PackedPublicByzantine payload =>
        := \?
            fork_manifest round pa ka_old ka_new pb kb_old kb_new pc kc_old kc_new px kx py ky revoked_key from_epoch
            to_epoch registry_root evidence_root. plan
            =
            payload
        visit plan

:= node_label \* transfer good_manifest fork_manifest round pa ka_old ka_new pb kb_old kb_new pc kc_old kc_new px
    kx py ky revoked_key from_epoch to_epoch registry_root evidence_root from to.
    (node :
        public_byzantine_node
            transfer good_manifest fork_manifest round pa ka_old ka_new pb kb_old kb_new pc kc_old kc_new px kx py ky
            revoked_key from_epoch to_epoch registry_root evidence_root from to)
    : string
    =
    ?= node ?|
    | PublicByzantineNode payload =>
        := \? effect. _, PublicByzantineRow label = payload
        label

:= ^ terminal_label \* transfer good_manifest fork_manifest round pa ka_old ka_new pb kb_old kb_new pc kc_old
    kc_new px kx py ky revoked_key from_epoch to_epoch registry_root evidence_root from to.
    (plan :
        public_byzantine_plan
            transfer good_manifest fork_manifest round pa ka_old ka_new pb kb_old kb_new pc kc_old kc_new px kx py ky
            revoked_key from_epoch to_epoch registry_root evidence_root from to)
    : string
    =
    ?= plan ?|
    | PublicByzantineLeaf node => node_label node
    | PublicByzantineThen payload =>
        := \? middle. _, node = payload
        node_label node

:= key_a_old_public () : public_key peer_a key_a_old round_29 retired authenticated = PublicKey "peer-a-old-retired"
:= key_a_new_public () : public_key peer_a key_a_new round_29 active authenticated = PublicKey "peer-a-new-active"
:= key_b_old_public () : public_key peer_b key_b_old round_29 retired authenticated = PublicKey "peer-b-old-retired"
:= key_b_new_public () : public_key peer_b key_b_new round_29 active authenticated = PublicKey "peer-b-new-active"
:= key_c_old_public () : public_key peer_c key_c_old round_29 retired authenticated = PublicKey "peer-c-old-retired"
:= key_c_new_public () : public_key peer_c key_c_new round_29 active authenticated = PublicKey "peer-c-new-active"
:= revoked_public () : public_key peer_a key_revoked round_29 revoked authenticated = PublicKey "peer-a-revoked"

:= entry_a_new () : registry_entry peer_a key_a_new round_29 active registry_root_29 authenticated =
    RegistryEntry (key_a_new_public (), "a-new-in-root")
:= entry_b_new () : registry_entry peer_b key_b_new round_29 active registry_root_29 authenticated =
    RegistryEntry (key_b_new_public (), "b-new-in-root")
:= entry_c_new () : registry_entry peer_c key_c_new round_29 active registry_root_29 authenticated =
    RegistryEntry (key_c_new_public (), "c-new-in-root")

:= membership
    ()
    : public_membership epoch_3 peer_a key_a_new peer_b key_b_new peer_c key_c_new registry_root_29 durable
    =
    PublicMembership (entry_a_new (), entry_b_new (), entry_c_new (), "epoch-3-public-membership")

:= distinct_signers () : distinct_public_signers peer_a key_a_new peer_b key_b_new peer_c key_c_new distinct =
    DistinctPublicSigners "three-distinct-peers-and-keys"

:= stmt_a () : public_statement transfer_a manifest_good peer_a key_a_new round_29 authenticated =
    PublicStatement "peer-a-good-public"
:= stmt_a_old () : public_statement transfer_a manifest_good peer_a key_a_old round_29 authenticated =
    PublicStatement "peer-a-retired-key-public"
:= stmt_b () : public_statement transfer_a manifest_good peer_b key_b_new round_29 authenticated =
    PublicStatement "peer-b-good-public"
:= stmt_c () : public_statement transfer_a manifest_good peer_c key_c_new round_29 authenticated =
    PublicStatement "peer-c-good-public"

:= quorum
    ()
    : public_quorum transfer_a manifest_good round_29 epoch_3 peer_a key_a_new peer_b key_b_new peer_c key_c_new
        registry_root_29 authenticated
    =
    PublicQuorum (stmt_a (), stmt_b (), stmt_c (), distinct_signers (), membership (), "public-quorum-5-of-7")

:= load_node
    ()
    : public_byzantine_node transfer_a manifest_good manifest_fork round_29 peer_a key_a_old key_a_new peer_b key_b_old
        key_b_new peer_c key_c_old key_c_new peer_x key_x_new peer_y key_y_new key_revoked epoch_2 epoch_3
        registry_root_29 evidence_root_29 collecting registry_loaded
    =
    PublicByzantineNode (\? (
        LoadRotatedRegistry (
            RegistryEntry (key_a_old_public (), "a-old-retired"),
            entry_a_new (),
            RegistryEntry (key_b_old_public (), "b-old-retired"),
            entry_b_new (),
            RegistryEntry (key_c_old_public (), "c-old-retired"),
            entry_c_new (),
            RegistryEntry (revoked_public (), "a-revoked"),
            KeySuccessor "a-old-to-new",
            KeySuccessor "b-old-to-new",
            KeySuccessor "c-old-to-new"
        ),
        PublicByzantineRow "load-public-registry-and-rotation"
    ))

:= verify_node
    ()
    : public_byzantine_node transfer_a manifest_good manifest_fork round_29 peer_a key_a_old key_a_new peer_b key_b_old
        key_b_new peer_c key_c_old key_c_new peer_x key_x_new peer_y key_y_new key_revoked epoch_2 epoch_3
        registry_root_29 evidence_root_29 registry_loaded equivocation_detected
    =
    PublicByzantineNode (\? (
        VerifyPublicEquivocation (
            stmt_a (),
            stmt_b (),
            stmt_c (),
            PublicEquivocation (PublicStatement "x-good", PublicStatement "x-fork", "x-two-valid-lamport-signatures"),
            PublicEquivocation (PublicStatement "y-good", PublicStatement "y-fork", "y-two-valid-lamport-signatures"),
            OneShotReuse "x-one-shot-key-reused",
            OneShotReuse "y-one-shot-key-reused"
        ),
        PublicByzantineRow "verify-public-equivocation-and-key-reuse"
    ))

:= reconfigure_node
    ()
    : public_byzantine_node transfer_a manifest_good manifest_fork round_29 peer_a key_a_old key_a_new peer_b key_b_old
        key_b_new peer_c key_c_old key_c_new peer_x key_x_new peer_y key_y_new key_revoked epoch_2 epoch_3
        registry_root_29 evidence_root_29 equivocation_detected reconfigured
    =
    PublicByzantineNode (\? (
        RotateRevokeAndExpel (
            KeyRotation (KeySuccessor "a-old-to-new", "a-rotation-receipt"),
            KeyRotation (KeySuccessor "b-old-to-new", "b-rotation-receipt"),
            KeyRotation (KeySuccessor "c-old-to-new", "c-rotation-receipt"),
            KeyRevocation "revoked-key-cannot-vote",
            membership ()
        ),
        PublicByzantineRow "rotate-revoke-expel-and-advance-membership"
    ))

:= quorum_node
    ()
    : public_byzantine_node transfer_a manifest_good manifest_fork round_29 peer_a key_a_old key_a_new peer_b key_b_old
        key_b_new peer_c key_c_old key_c_new peer_x key_x_new peer_y key_y_new key_revoked epoch_2 epoch_3
        registry_root_29 evidence_root_29 reconfigured quorum_ready
    =
    PublicByzantineNode (\? (
        FormPublicQuorum (stmt_a_old (), stmt_b (), stmt_c (), distinct_signers (), membership (), quorum ()),
        PublicByzantineRow "form-public-quorum-with-active-one-shot-keys"
    ))

:= commit_node
    ()
    : public_byzantine_node transfer_a manifest_good manifest_fork round_29 peer_a key_a_old key_a_new peer_b key_b_old
        key_b_new peer_c key_c_old key_c_new peer_x key_x_new peer_y key_y_new key_revoked epoch_2 epoch_3
        registry_root_29 evidence_root_29 quorum_ready committed
    =
    PublicByzantineNode (\? (
        PublishPublicCommit (
            quorum (),
            PublicCommit "public-lamport-byzantine-mesh-committed"
        ),
        PublicByzantineRow "public-byzantine-mesh-rotated-and-committed"
    ))

:= plan
    ()
    : public_byzantine_plan transfer_a manifest_good manifest_fork round_29 peer_a key_a_old key_a_new peer_b key_b_old
        key_b_new peer_c key_c_old key_c_new peer_x key_x_new peer_y key_y_new key_revoked epoch_2 epoch_3
        registry_root_29 evidence_root_29 collecting committed
    =
    PublicByzantineThen (\? (
        PublicByzantineThen (\? (
            PublicByzantineThen (\? (
                PublicByzantineThen (\? (
                    PublicByzantineLeaf (load_node ()),
                    verify_node ()
                )),
                reconfigure_node ()
            )),
            quorum_node ()
        )),
        commit_node ()
    ))

:= inspect \* fork_manifest round pa ka_old ka_new pb kb_old kb_new pc kc_old kc_new px kx py ky revoked_key
    from_epoch to_epoch registry_root evidence_root.
    (plan :
        public_byzantine_plan
            transfer_a manifest_good fork_manifest round pa ka_old ka_new pb kb_old kb_new pc kc_old kc_new px kx py ky
            revoked_key from_epoch to_epoch registry_root evidence_root collecting committed)
    : string
    =
    terminal_label plan

:= main () : string =
    := packed : packed_public_byzantine transfer_a manifest_good = PackedPublicByzantine (\? (plan ()))
    with_packed_public_byzantine `$inspect packed
