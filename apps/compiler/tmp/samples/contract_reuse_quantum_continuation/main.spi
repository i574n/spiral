:! lineage_a = ()
:! epoch0 = ()
:! epoch1 = ()
:! owner_a = ()
:! coherent = ()
:! fresh = ()
:! used = ()
:| qstate lineage epoch phase = | QState :: \* lineage epoch phase. string -> qstate lineage epoch phase
:| qcontinuation lineage from_epoch to_epoch owner state =
    | QContinuation :: \* lineage from_epoch to_epoch owner state.
        string ->
        qcontinuation lineage from_epoch to_epoch owner state
:= resume \* lineage from_epoch to_epoch owner.
    (state : qstate lineage from_epoch coherent) (continuation : qcontinuation lineage from_epoch to_epoch owner fresh)
    : qstate lineage to_epoch coherent * qcontinuation lineage from_epoch to_epoch owner used
    =
    QState "next", QContinuation "used"
:= main () =
    := state : qstate lineage_a epoch0 coherent = QState "psi"
    := spent : qcontinuation lineage_a epoch0 epoch1 owner_a used = QContinuation "spent"
    resume state spent
