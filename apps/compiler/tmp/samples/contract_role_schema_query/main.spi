:! schema_v4 = ()
:! schema_v5 = ()
:! operator = ()
:! auditor = ()

:| capability role =
    | OperatorCapability :: capability operator
    | AuditorCapability :: capability auditor

:| document schema =
    | V4Document :: i32 -> document schema_v4
    | V5Document :: string -> document schema_v5

:| query role schema result =
    | AmountQuery :: query operator schema_v4 i32
    | DigestQuery :: query auditor schema_v5 string

:= run_query \* role schema result.
    (capability : capability role)
    (query : query role schema result)
    (document : document schema)
    : result =
    ?= capability, query, document ?|
    | OperatorCapability, AmountQuery, V4Document amount => amount
    | AuditorCapability, DigestQuery, V5Document _ => "role-schema-query"

:= main () : string =
    run_query AuditorCapability DigestQuery (V5Document "sha256")
