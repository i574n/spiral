:! scope_a = ()
:! scope_b = ()

:| signal scope value =
    | Signal :: \* scope value. value -> signal scope value

:| subscription scope =
    | Subscription :: \* scope. string -> subscription scope

:= subscribe \* scope value. (source : signal scope value) : subscription scope =
    ?= source ?|
    | Signal _ => Subscription "owned-subscription"

:= dispose \* scope. (subscription : subscription scope) : string =
    ?= subscription ?|
    | Subscription label => label

:= main () : string =
    := source : signal scope_a i32 = Signal 42
    dispose (subscribe source)
