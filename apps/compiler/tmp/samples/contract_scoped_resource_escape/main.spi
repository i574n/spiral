nominal region_a = ()

union resource region =
    | ResourceA :: string -> resource region_a

union scoped_resource =
    | ScopedResource :: (exists region. resource region) -> scoped_resource

inl leak forall region. (resource : resource region) : resource region = resource

inl with_resource forall result.
    (visitor : forall region. resource region -> result)
    : result =
    inl packed = ScopedResource (exists (ResourceA "nfe.xml"))
    match packed with
    | ScopedResource resource =>
        inl exists region. resource = resource
        visitor resource

inl main () = with_resource `$leak