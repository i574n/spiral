:! region_a = ()

:| resource region =
    | ResourceA :: string -> resource region_a

:| scoped_resource =
    | ScopedResource :: (\? region. resource region) -> scoped_resource

:= leak \* region. (resource : resource region) : resource region = resource

:= with_resource \* result.
    (visitor : \* region. resource region -> result)
    : result =
    := packed = ScopedResource (\? (ResourceA "nfe.xml"))
    ?= packed ?|
    | ScopedResource resource =>
        := \? region. resource = resource
        visitor resource

:= main () = with_resource `$leak
