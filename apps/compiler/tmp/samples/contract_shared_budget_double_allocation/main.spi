:! nat_zero = ()
:! nat_one = ()
:! nat_two = ()
:! nat_three = ()
:! nat_five = ()
:! company_a = string
:! usd = string
:! department_alpha = string
:! department_beta = string

:| nat_add left right total =
    | AddTwoThreeFive :: string -> nat_add nat_two nat_three nat_five
    | AddTwoOneThree :: string -> nat_add nat_two nat_one nat_three

:! shared_budget_certificate entity currency left_department right_department left right remaining intermediate
    total =
    entity *
    currency *
    left_department *
    right_department *
    nat_add left intermediate total *
    nat_add right remaining intermediate

:= wrong_second_split () : nat_add nat_two nat_two nat_three =
    AddTwoOneThree "beta-attempts-two-but-only-one-remains"

:= main () : string =
    := certificate
        : shared_budget_certificate company_a usd department_alpha department_beta nat_two nat_two nat_two nat_three
            nat_five
        =
        shared_budget_certificate (
            company_a "company-a",
            usd "usd",
            department_alpha "alpha",
            department_beta "beta",
            AddTwoThreeFive "alpha-reserves-two",
            wrong_second_split ())
    "should-not-compile-double-allocation"
