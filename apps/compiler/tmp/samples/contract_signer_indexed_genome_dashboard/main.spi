:! signer_a = ()
:! key_a = ()
:! fingerprint_a = ()
:! verified = ()
:! sample_a = ()
:! hg38 = ()
:! chr1 = ()
:! app_scope = ()
:! epoch1 = ()
:! live = ()
:! hydrated = ()

:| signed_authority signer key fingerprint state =
    | SignedAuthority :: \* signer key fingerprint state. string -> signed_authority signer key fingerprint state
:| genome_batch signer fingerprint sample build contig =
    | GenomeBatch :: \* signer fingerprint sample build contig.
        string ->
        genome_batch signer fingerprint sample build contig
:| resource scope epoch signer fingerprint sample build contig state =
    | Resource :: \* scope epoch signer fingerprint sample build contig state.
        string ->
        resource scope epoch signer fingerprint sample build contig state
:| view scope epoch signer fingerprint state =
    | View :: \* scope epoch signer fingerprint state. string -> view scope epoch signer fingerprint state

:= publish \* scope epoch signer key fingerprint sample build contig.
    (authority : signed_authority signer key fingerprint verified)
    (batch : genome_batch signer fingerprint sample build contig)
    : resource scope epoch signer fingerprint sample build contig live =
    ?= authority, batch ?|
    | SignedAuthority _, GenomeBatch label => Resource label

:= mount \* scope epoch signer fingerprint sample build contig.
    (resource : resource scope epoch signer fingerprint sample build contig live)
    (view : view scope epoch signer fingerprint hydrated)
    : string =
    ?= resource, view ?|
    | Resource _, View label => label

:= main () : string =
    := authority : signed_authority signer_a key_a fingerprint_a verified = SignedAuthority "signed"
    := batch : genome_batch signer_a fingerprint_a sample_a hg38 chr1 = GenomeBatch "variants"
    := view : view app_scope epoch1 signer_a fingerprint_a hydrated = View "signed-genome-dashboard-mounted"
    := resource : resource app_scope epoch1 signer_a fingerprint_a sample_a hg38 chr1 live = publish authority batch
    mount resource view
