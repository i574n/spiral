:! compiler_v1 = ()
:! compiler_v2 = ()
:! source_main = ()

:| compilation compiler source result =
    | CompileV1 :: compilation compiler_v1 source_main string
    | CompileV2 :: compilation compiler_v2 source_main string

:| cache_key compiler source result =
    | KeyV1 :: string -> cache_key compiler_v1 source_main string
    | KeyV2 :: string -> cache_key compiler_v2 source_main string

:= restore \* compiler source result.
    (_ : compilation compiler source result)
    (_ : cache_key compiler source result)
    : result = "restored"

:= main () : string =
    restore CompileV2 (KeyV1 "stale-v1")
