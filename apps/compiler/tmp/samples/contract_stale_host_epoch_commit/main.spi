:! app_a = ()
:! host_a = ()
:! generation_6 = ()
:! generation_7 = ()
:! root_scope = ()
:! live = ()
:! drained = ()
:! committed = ()
:| host_lease host generation state =
    | HostLease :: \* host generation state. string -> host_lease host generation state
:| scope_tree app host generation scope state =
    | ScopeTree :: \* app host generation scope state. string -> scope_tree app host generation scope state
:| effect_drain scope generation state =
    | Drain :: \* scope generation state. string -> effect_drain scope generation state
:| dom_commit app host generation state =
    | DomCommit :: \* app host generation state. string -> dom_commit app host generation state
:= commit \* app host generation scope.
    (lease : host_lease host generation live) (tree : scope_tree app host generation scope live)
    (drain : effect_drain scope generation drained)
    : dom_commit app host generation committed
    =
    DomCommit "ok"
:= main () =
    := lease : host_lease host_a generation_7 live = HostLease "browser-host"
    := tree : scope_tree app_a host_a generation_7 root_scope live = ScopeTree "root"
    := stale : effect_drain root_scope generation_6 drained = Drain "stale"
    commit lease tree stale
