:! transfer_a = ()
:! manifest_good = ()
:! manifest_fork = ()
:! round_28 = ()
:! epoch_0 = ()
:! epoch_1 = ()
:! peer_a = ()
:! peer_b = ()
:! peer_c = ()
:! peer_x = ()
:! peer_y = ()
:! collecting = ()
:! equivocation_detected = ()
:! reconfigured = ()
:! quorum_ready = ()
:! committed = ()
:! authenticated = ()
:! distinct = ()
:! durable = ()
:! idempotent = ()
:! non_idempotent = ()

:| signed_statement transfer manifest peer round state =
    | SignedStatement :: \* transfer manifest peer round state.
        string -> signed_statement transfer manifest peer round state

:| equivocation_proof transfer peer round left_manifest right_manifest state =
    | EquivocationProof :: \* transfer peer round left_manifest right_manifest state.
        string -> equivocation_proof transfer peer round left_manifest right_manifest state

:| distinct_honest_peers pa pb pc state =
    | DistinctHonestPeers :: \* pa pb pc state.
        string -> distinct_honest_peers pa pb pc state

:| expulsion_receipt peer from_epoch to_epoch state =
    | ExpulsionReceipt :: \* peer from_epoch to_epoch state.
        string -> expulsion_receipt peer from_epoch to_epoch state

:| membership_epoch epoch pa pb pc state =
    | MembershipEpoch :: \* epoch pa pb pc state.
        string -> membership_epoch epoch pa pb pc state

:| canonical_quorum transfer manifest round epoch pa pb pc state =
    | CanonicalQuorum :: \* transfer manifest round epoch pa pb pc state.
        string -> canonical_quorum transfer manifest round epoch pa pb pc state

:| byzantine_commit transfer manifest round epoch state =
    | ByzantineCommit :: \* transfer manifest round epoch state.
        string -> byzantine_commit transfer manifest round epoch state

:| byzantine_mesh_op transfer good_manifest fork_manifest round pa pb pc px py from_epoch to_epoch from to effect =
    | CollectAuthenticatedStatements :: \* transfer good_manifest fork_manifest round pa pb pc px py from_epoch
        to_epoch.
        signed_statement transfer good_manifest pa round authenticated *
        signed_statement transfer good_manifest pb round authenticated *
        signed_statement transfer good_manifest pc round authenticated *
        signed_statement transfer good_manifest px round authenticated *
        signed_statement transfer fork_manifest px round authenticated *
        signed_statement transfer good_manifest py round authenticated *
        signed_statement transfer fork_manifest py round authenticated ->
        byzantine_mesh_op
            transfer good_manifest fork_manifest round pa pb pc px py from_epoch to_epoch collecting
            equivocation_detected idempotent
    | ProveAndExpelEquivocators :: \* transfer good_manifest fork_manifest round pa pb pc px py from_epoch to_epoch.
        equivocation_proof transfer px round good_manifest fork_manifest authenticated *
        equivocation_proof transfer py round good_manifest fork_manifest authenticated *
        expulsion_receipt px from_epoch to_epoch durable *
        expulsion_receipt py from_epoch to_epoch durable *
        distinct_honest_peers pa pb pc distinct *
        membership_epoch to_epoch pa pb pc durable ->
        byzantine_mesh_op
            transfer good_manifest fork_manifest round pa pb pc px py from_epoch to_epoch equivocation_detected
            reconfigured non_idempotent
    | FormCanonicalQuorum :: \* transfer good_manifest fork_manifest round pa pb pc px py from_epoch to_epoch.
        signed_statement transfer good_manifest pa round authenticated *
        signed_statement transfer good_manifest pb round authenticated *
        signed_statement transfer good_manifest pc round authenticated *
        distinct_honest_peers pa pb pc distinct *
        membership_epoch to_epoch pa pb pc durable *
        canonical_quorum transfer good_manifest round to_epoch pa pb pc authenticated ->
        byzantine_mesh_op
            transfer good_manifest fork_manifest round pa pb pc px py from_epoch to_epoch reconfigured quorum_ready
            idempotent
    | PublishCanonicalManifest :: \* transfer good_manifest fork_manifest round pa pb pc px py from_epoch to_epoch.
        canonical_quorum transfer good_manifest round to_epoch pa pb pc authenticated *
        byzantine_commit transfer good_manifest round to_epoch committed ->
        byzantine_mesh_op
            transfer good_manifest fork_manifest round pa pb pc px py from_epoch to_epoch quorum_ready committed
            non_idempotent

:| byzantine_row transfer good_manifest round from_epoch to_epoch from to effect =
    | ByzantineRow :: \* transfer good_manifest round from_epoch to_epoch from to effect.
        string -> byzantine_row transfer good_manifest round from_epoch to_epoch from to effect

:| byzantine_node transfer good_manifest fork_manifest round pa pb pc px py from_epoch to_epoch from to =
    | ByzantineNode :: \* transfer good_manifest fork_manifest round pa pb pc px py from_epoch to_epoch from to.
        (\? effect.
            byzantine_mesh_op
                transfer good_manifest fork_manifest round pa pb pc px py from_epoch to_epoch from to effect *
            byzantine_row transfer good_manifest round from_epoch to_epoch from to effect) ->
        byzantine_node transfer good_manifest fork_manifest round pa pb pc px py from_epoch to_epoch from to

:| ^ byzantine_plan transfer good_manifest fork_manifest round pa pb pc px py from_epoch to_epoch from to =
    | ByzantineLeaf :: \* transfer good_manifest fork_manifest round pa pb pc px py from_epoch to_epoch from to.
        byzantine_node transfer good_manifest fork_manifest round pa pb pc px py from_epoch to_epoch from to ->
        byzantine_plan transfer good_manifest fork_manifest round pa pb pc px py from_epoch to_epoch from to
    | ByzantineThen :: \* transfer good_manifest fork_manifest round pa pb pc px py from_epoch to_epoch from to.
        (\? middle.
            byzantine_plan transfer good_manifest fork_manifest round pa pb pc px py from_epoch to_epoch from middle *
            byzantine_node transfer good_manifest fork_manifest round pa pb pc px py from_epoch to_epoch middle to)
        -> byzantine_plan transfer good_manifest fork_manifest round pa pb pc px py from_epoch to_epoch from to

:| packed_byzantine_mesh transfer good_manifest =
    | PackedByzantineMesh :: \* transfer good_manifest.
        (\? fork_manifest round pa pb pc px py from_epoch to_epoch.
            byzantine_plan
                transfer good_manifest fork_manifest round pa pb pc px py from_epoch to_epoch collecting committed) ->
        packed_byzantine_mesh transfer good_manifest

:= with_packed_byzantine_mesh \* transfer good_manifest result.
    (visit :
        \* fork_manifest round pa pb pc px py from_epoch to_epoch.
            byzantine_plan
                transfer good_manifest fork_manifest round pa pb pc px py from_epoch to_epoch collecting committed ->
            result)
    (packed : packed_byzantine_mesh transfer good_manifest)
    : result
    =
    ?= packed ?|
    | PackedByzantineMesh payload =>
        := \? fork_manifest round pa pb pc px py from_epoch to_epoch. plan = payload
        visit plan

:= node_label \* transfer good_manifest fork_manifest round pa pb pc px py from_epoch to_epoch from to.
    (node : byzantine_node transfer good_manifest fork_manifest round pa pb pc px py from_epoch to_epoch from to)
    : string
    =
    ?= node ?|
    | ByzantineNode payload =>
        := \? effect. _, ByzantineRow label = payload
        label

:= ^ terminal_label \* transfer good_manifest fork_manifest round pa pb pc px py from_epoch to_epoch from to.
    (plan : byzantine_plan transfer good_manifest fork_manifest round pa pb pc px py from_epoch to_epoch from to)
    : string
    =
    ?= plan ?|
    | ByzantineLeaf node => node_label node
    | ByzantineThen payload =>
        := \? middle. _, node = payload
        node_label node

:= honest_distinct () : distinct_honest_peers peer_a peer_b peer_c distinct =
    DistinctHonestPeers "peer-a-ne-peer-b-ne-peer-c"

:= membership () : membership_epoch epoch_1 peer_a peer_b peer_c durable =
    MembershipEpoch "epoch-1-excludes-peer-x-and-peer-y"

:= quorum () : canonical_quorum transfer_a manifest_good round_28 epoch_1 peer_a peer_b peer_c authenticated =
    CanonicalQuorum "three-honest-authenticated-statements"

:= collect_node
    ()
    : byzantine_node transfer_a manifest_good manifest_fork round_28 peer_a peer_b peer_c peer_x peer_y epoch_0 epoch_1
        collecting equivocation_detected
    =
    ByzantineNode (\? (
        CollectAuthenticatedStatements (
            SignedStatement "peer-a-good",
            SignedStatement "peer-b-good",
            SignedStatement "peer-c-good",
            SignedStatement "peer-x-good",
            SignedStatement "peer-x-fork",
            SignedStatement "peer-y-good",
            SignedStatement "peer-y-fork"
        ),
        ByzantineRow "collect-seven-valid-statements"
    ))

:= expel_node
    ()
    : byzantine_node transfer_a manifest_good manifest_fork round_28 peer_a peer_b peer_c peer_x peer_y epoch_0 epoch_1
        equivocation_detected reconfigured
    =
    ByzantineNode (\? (
        ProveAndExpelEquivocators (
            EquivocationProof "peer-x-two-valid-conflicting-statements",
            EquivocationProof "peer-y-two-valid-conflicting-statements",
            ExpulsionReceipt "peer-x-expelled-epoch-0-to-1",
            ExpulsionReceipt "peer-y-expelled-epoch-0-to-1",
            honest_distinct (),
            membership ()
        ),
        ByzantineRow "expel-only-after-equivocation-proof"
    ))

:= quorum_node
    ()
    : byzantine_node transfer_a manifest_good manifest_fork round_28 peer_a peer_b peer_c peer_x peer_y epoch_0 epoch_1
        reconfigured quorum_ready
    =
    ByzantineNode (\? (
        FormCanonicalQuorum (
            SignedStatement "peer-a-good",
            SignedStatement "peer-b-good",
            SignedStatement "peer-c-good",
            honest_distinct (),
            membership (),
            quorum ()
        ),
        ByzantineRow "form-quorum-from-distinct-honest-peers"
    ))

:= stale_commit () : byzantine_commit transfer_a manifest_good round_28 epoch_0 committed =
    ByzantineCommit "stale-membership-epoch-0"

:= commit_node
    ()
    : byzantine_node transfer_a manifest_good manifest_fork round_28 peer_a peer_b peer_c peer_x peer_y epoch_0 epoch_1
        quorum_ready committed
    =
    ByzantineNode (\? (
        PublishCanonicalManifest (
            quorum (),
            stale_commit ()
        ),
        ByzantineRow "byzantine-mesh-healed-and-committed"
    ))

:= plan
    ()
    : byzantine_plan transfer_a manifest_good manifest_fork round_28 peer_a peer_b peer_c peer_x peer_y epoch_0 epoch_1
        collecting committed
    =
    ByzantineThen (\? (
        ByzantineThen (\? (
            ByzantineThen (\? (
                ByzantineLeaf (collect_node ()),
                expel_node ()
            )),
            quorum_node ()
        )),
        commit_node ()
    ))

:= inspect \* fork_manifest round pa pb pc px py from_epoch to_epoch.
    (plan :
        byzantine_plan
            transfer_a manifest_good fork_manifest round pa pb pc px py from_epoch to_epoch collecting committed)
    : string
    =
    terminal_label plan

:= main () : string =
    := packed : packed_byzantine_mesh transfer_a manifest_good = PackedByzantineMesh (\? (plan ()))
    with_packed_byzantine_mesh `$inspect packed
