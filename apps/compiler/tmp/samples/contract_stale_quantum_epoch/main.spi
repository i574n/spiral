:! zero = ()
:! succ a = a

:| qstate epoch =
    | QState :: \* epoch. string -> qstate epoch

:| gate from to =
    | H :: \* epoch. gate epoch (succ epoch)

:= apply \* from to. (gate : gate from to) (state : qstate from) : qstate to =
    ?= gate, state ?|
    | H, QState _ => QState "h-applied"

:= measure (state : qstate (succ zero)) : string =
    ?= state ?|
    | QState label => label

:= main () : string =
    := initial : qstate zero = QState "zero"
    := _ = apply H initial
    measure initial
