:! lineage_a = ()
:! epoch0 = ()
:! epoch1 = ()
:! owner_a = ()
:! slot0 = ()
:! borrowed = ()
:! available = ()
:! live = ()
:! returned = ()
:| qregister lineage epoch state = | QRegister :: \* lineage epoch state. string -> qregister lineage epoch state
:| qloan lineage epoch owner slot state =
    | QLoan :: \* lineage epoch owner slot state. string -> qloan lineage epoch owner slot state
:= release \* lineage epoch owner slot.
    (register : qregister lineage epoch borrowed) (loan : qloan lineage epoch owner slot live)
    : qregister lineage epoch available * qloan lineage epoch owner slot returned
    =
    QRegister "available", QLoan "returned"
:= main () =
    := register : qregister lineage_a epoch1 borrowed = QRegister "new-epoch"
    := stale : qloan lineage_a epoch0 owner_a slot0 live = QLoan "stale"
    release register stale
