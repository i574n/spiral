:! app_scope = ()
:! epoch0 = ()
:! epoch1 = ()
:! dirty = ()
:! clean = ()
:! live = ()

:| signal scope epoch value =
    | Signal :: \* scope epoch value. value -> signal scope epoch value

:| memo scope epoch state value =
    | Memo :: \* scope epoch state value. value -> memo scope epoch state value

:| render_ticket scope epoch =
    | RenderTicket :: \* scope epoch. string -> render_ticket scope epoch

:= transact \* scope value.
    (source : signal scope epoch0 value)
    (cached : memo scope epoch0 clean value)
    : signal scope epoch1 value * memo scope epoch0 dirty value =
    ?= source, cached ?|
    | Signal value, Memo _ => Signal value, Memo value

:= recompute \* scope value.
    (source : signal scope epoch1 value)
    (stale : memo scope epoch0 dirty value)
    : memo scope epoch1 clean value =
    ?= source, stale ?|
    | Signal value, Memo _ => Memo value

:= render \* scope epoch value.
    (memo : memo scope epoch clean value)
    (ticket : render_ticket scope epoch)
    : string =
    ?= memo, ticket ?|
    | Memo _, RenderTicket label => label

:= main () : string =
    := source : signal app_scope epoch0 i32 = Signal 41
    := cached : memo app_scope epoch0 clean i32 = Memo 40
    := source', stale = transact source cached
    := fresh = recompute source' stale
    := ticket : render_ticket app_scope epoch1 = RenderTicket "reactive-transaction-committed"
    render fresh ticket
