nominal parallel = ()
nominal serial = ()

union task effect result =
    | ValidateIssuer :: task parallel string
    | ValidateTotal :: task parallel i32
    | QueryStatus :: task parallel string
    | Publish :: string -> task serial string

union rec dag result =
    | ParallelNode :: forall result. task parallel result -> dag result
    | SerialNode :: forall result. task serial result -> dag result
    | Zip :: forall a b. dag a * dag b -> dag (a * b)
    | Map :: forall result.
        (exists input. (input -> result) * dag input)
        -> dag result
    | Then :: forall result.
        (exists input. dag input * (input -> dag result))
        -> dag result

inl run_task forall effect result. (task : task effect result) : result =
    match task with
    | ValidateIssuer => "issuer-ok"
    | ValidateTotal => 4200
    | QueryStatus => "committed"
    | Publish message => message

inl rec run forall result. (program : dag result) : result =
    match program with
    | ParallelNode task => run_task task
    | SerialNode task => run_task task
    | Zip (left, right) => run left, run right
    | Map packed =>
        inl exists input. mapping, source = packed
        mapping (run source)
    | Then packed =>
        inl exists input. source, next = packed
        run (next (run source))

inl summarize (data : (string * i32) * string) : string =
    inl (issuer, total), status = data
    "typed-dag"

inl plan () : dag string =
    Then (exists (
        Map (exists (
            summarize,
            Zip (
                Zip (
                    ParallelNode ValidateIssuer,
                    ParallelNode ValidateTotal
                ),
                ParallelNode QueryStatus
            )
        )),
        fun summary => SerialNode (Publish summary)
    ))

inl main () : string =
    run (plan ())
