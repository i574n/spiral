:! idle = ()
:! sent = ()
:! received = ()
:! closed = ()

:| session state =
    | Idle :: session idle
    | Sent :: string -> session sent
    | Received :: string -> session received
    | Closed :: string -> session closed

:| command from to =
    | Send :: string -> command idle sent
    | Receive :: command sent received
    | Close :: command received closed

:| ^ protocol from to =
    | Step :: \* from to. command from to -> protocol from to
    | Compose :: \* from to.
        (\? middle. protocol from middle * protocol middle to)
        -> protocol from to

:= advance \* from to.
    (command : command from to)
    (session : session from)
    : session to =
    ?= command, session ?|
    | Send xml, Idle => Sent xml
    | Receive, Sent _ => Received "135240000000063"
    | Close, Received protocol => Closed protocol

:= ^ run \* from to.
    (program : protocol from to)
    (session : session from)
    : session to =
    ?= program ?|
    | Step command => advance command session
    | Compose packed =>
        := \? middle. left, right = packed
        run right (run left session)

:= plan () : protocol idle closed =
    Compose (\? (
        Step (Send "nfe.xml"),
        Compose (\? (
            Step Receive,
            Step Close
        ))
    ))

:= main () : string =
    ?= run (plan ()) Idle ?|
    | Closed _ => "typed-session-closed"
