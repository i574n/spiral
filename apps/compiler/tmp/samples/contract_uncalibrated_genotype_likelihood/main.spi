:! sample_a = ()
:! hg38 = ()
:! chr1 = ()
:! aligned = ()
:! calibrated = ()
:! model_v1 = ()
:| readset sample build contig stage =
    | Reads :: \* sample build contig stage. string -> readset sample build contig stage
:| calibration sample build contig model =
    | Calibration :: \* sample build contig model. string -> calibration sample build contig model
:| genotype_likelihood sample build contig model =
    | Likelihood :: \* sample build contig model. string -> genotype_likelihood sample build contig model
:= likelihood \* sample build contig model.
    (reads : readset sample build contig calibrated) (model : calibration sample build contig model)
    : genotype_likelihood sample build contig model
    =
    Likelihood "likelihood"
:= main () =
    := reads : readset sample_a hg38 chr1 aligned = Reads "aligned"
    := model : calibration sample_a hg38 chr1 model_v1 = Calibration "model"
    likelihood reads model
