nominal owner_a = ()
nominal owner_b = ()
nominal clean = ()
nominal dirty = ()
nominal computed = ()
nominal restored = ()

union ancilla owner state =
    | Ancilla :: forall owner state. string -> ancilla owner state

union workspace owner stage =
    | Workspace :: forall owner stage. string -> workspace owner stage

union garbage owner witness =
    | Garbage :: forall owner witness. string -> garbage owner witness

inl uncompute forall owner.
    (ancilla : ancilla owner dirty)
    (workspace : workspace owner computed)
    (garbage : garbage owner computed)
    : ancilla owner clean * workspace owner restored =
    match ancilla, workspace, garbage with
    | Ancilla _, Workspace _, Garbage _ => Ancilla "clean", Workspace "restored"

inl main () : ancilla owner_a clean =
    inl dirty : ancilla owner_a dirty = Ancilla "dirty-a"
    inl workspace : workspace owner_a computed = Workspace "computed-a"
    inl garbage : garbage owner_b computed = Garbage "garbage-b"
    inl clean, _ = uncompute dirty workspace garbage
    clean
