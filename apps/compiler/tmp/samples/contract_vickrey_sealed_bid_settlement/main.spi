:! auction_open = ()
:! commitments_closed = ()
:! reveals_open = ()
:! reveals_verified = ()
:! ranked = ()
:! priced = ()
:! settled = ()

:! auction_501 = ()
:! lot_gpu_9 = ()
:! bidder_a = ()
:! bidder_b = ()
:! bidder_c = ()
:! bidders_abc = ()
:! currency_usdc = ()

:| commitment auction bidder lot =
    | CommitmentA501 :: string -> commitment auction_501 bidder_a lot_gpu_9
    | CommitmentB501 :: string -> commitment auction_501 bidder_b lot_gpu_9
    | CommitmentC501 :: string -> commitment auction_501 bidder_c lot_gpu_9

:| reveal auction bidder lot currency =
    | RevealA501 :: string -> reveal auction_501 bidder_a lot_gpu_9 currency_usdc
    | RevealB501 :: string -> reveal auction_501 bidder_b lot_gpu_9 currency_usdc
    | RevealC501 :: string -> reveal auction_501 bidder_c lot_gpu_9 currency_usdc

:| valid_reveal auction bidder lot currency =
    | ValidA501 ::
        commitment auction_501 bidder_a lot_gpu_9 * reveal auction_501 bidder_a lot_gpu_9 currency_usdc ->
        valid_reveal auction_501 bidder_a lot_gpu_9 currency_usdc
    | ValidB501 ::
        commitment auction_501 bidder_b lot_gpu_9 * reveal auction_501 bidder_b lot_gpu_9 currency_usdc ->
        valid_reveal auction_501 bidder_b lot_gpu_9 currency_usdc
    | ValidC501 ::
        commitment auction_501 bidder_c lot_gpu_9 * reveal auction_501 bidder_c lot_gpu_9 currency_usdc ->
        valid_reveal auction_501 bidder_c lot_gpu_9 currency_usdc

:| commitment_root auction lot =
    | CommitmentRoot501 :: string -> commitment_root auction_501 lot_gpu_9

:| reveal_window auction lot =
    | RevealWindow501 :: commitment_root auction_501 lot_gpu_9 -> reveal_window auction_501 lot_gpu_9

:| ranking auction bidders lot currency =
    | RankingABC501 ::
        valid_reveal auction_501 bidder_a lot_gpu_9 currency_usdc *
        valid_reveal auction_501 bidder_b lot_gpu_9 currency_usdc *
        valid_reveal auction_501 bidder_c lot_gpu_9 currency_usdc ->
        ranking auction_501 bidders_abc lot_gpu_9 currency_usdc

:| winner auction bidder bidders lot currency =
    | WinnerA501 :: ranking auction_501 bidders_abc lot_gpu_9 currency_usdc ->
        winner auction_501 bidder_a bidders_abc lot_gpu_9 currency_usdc

:| second_price auction bidders lot currency =
    | SecondPrice501 :: ranking auction_501 bidders_abc lot_gpu_9 currency_usdc * string ->
        second_price auction_501 bidders_abc lot_gpu_9 currency_usdc

:| settlement auction bidder bidders lot currency =
    | SettlementA501 ::
        winner auction_501 bidder_a bidders_abc lot_gpu_9 currency_usdc *
        second_price auction_501 bidders_abc lot_gpu_9 currency_usdc ->
        settlement auction_501 bidder_a bidders_abc lot_gpu_9 currency_usdc

:| auction_op from to result =
    | CloseCommitments :: \* auction lot.
        string -> auction_op auction_open commitments_closed (commitment_root auction lot)
    | OpenReveals :: \* auction lot.
        commitment_root auction lot -> auction_op commitments_closed reveals_open (reveal_window auction lot)
    | VerifyReveal :: \* auction bidder lot currency.
        commitment auction bidder lot * reveal auction bidder lot currency ->
        auction_op reveals_open reveals_verified (valid_reveal auction bidder lot currency)
    | RankBids :: \* auction bidders lot currency.
        valid_reveal auction bidder_a lot currency *
        valid_reveal auction bidder_b lot currency *
        valid_reveal auction bidder_c lot currency ->
        auction_op reveals_verified ranked (ranking auction bidders lot currency)
    | ComputeSecondPrice :: \* auction bidder bidders lot currency.
        ranking auction bidders lot currency ->
        auction_op ranked priced
            (winner auction bidder bidders lot currency * second_price auction bidders lot currency)
    | SettleWinner :: \* auction bidder bidders lot currency.
        winner auction bidder bidders lot currency * second_price auction bidders lot currency ->
        auction_op priced settled (settlement auction bidder bidders lot currency)

:! commitment_interpreter from to result = auction_op from to result
:! pricing_interpreter from to result = auction_op from to result
:! ledger_interpreter from to result = auction_op from to result

:? interpret interpreter from to result : interpreter from to result -> string

:+ interpret commitment_interpreter = \ (commitment_interpreter op) =>
    ?= op ?|
    | CloseCommitments _ => "seal-commitment-root"
    | OpenReveals _ => "open-reveal-window"
    | VerifyReveal _ => "hash-bid-plus-salt"
    | RankBids _ => "verify-distinct-bidders"
    | ComputeSecondPrice _ => "verify-ranked-order"
    | SettleWinner _ => "verify-winner-binding"

:+ interpret pricing_interpreter = \ (pricing_interpreter op) =>
    ?= op ?|
    | CloseCommitments _ => "pricing-no-visibility"
    | OpenReveals _ => "pricing-reveals-public"
    | VerifyReveal _ => "pricing-accept-valid-bid"
    | RankBids _ => "pricing-sort-descending"
    | ComputeSecondPrice _ => "pricing-charge-runner-up"
    | SettleWinner _ => "pricing-final-vickrey-price"

:+ interpret ledger_interpreter = \ (ledger_interpreter op) =>
    ?= op ?|
    | CloseCommitments _ => "ledger-lock-deposits"
    | OpenReveals _ => "ledger-preserve-deposits"
    | VerifyReveal _ => "ledger-mark-revealed"
    | RankBids _ => "ledger-rank-bidders"
    | ComputeSecondPrice _ => "ledger-reserve-second-price"
    | SettleWinner _ => "ledger-transfer-lot-and-refund"

:= ca () = CommitmentA501 "commit-a"
:= cb () = CommitmentB501 "commit-b"
:= cc () = CommitmentC501 "commit-c"
:= ra () = RevealA501 "1000+salt-a"
:= rb () = RevealB501 "850+salt-b"
:= rc () = RevealC501 "700+salt-c"
:= va () = ValidA501 (ca (), ra ())
:= vb () = ValidB501 (cb (), rb ())
:= vc () = ValidC501 (cc (), rc ())
:= root () = CommitmentRoot501 "root-sealed"
:= window () = RevealWindow501 (root ())
:= ranking_abc () = RankingABC501 (va (), vb (), vc ())
:= winner_a () = WinnerA501 (ranking_abc ())
:= price_850 () = SecondPrice501 (ranking_abc (), "850")
:= settlement_a () = SettlementA501 (winner_a (), price_850 ())

:| sealed_auction_result =
    | SealedCommitment :: (\? auction lot. commitment_root auction lot) -> sealed_auction_result
    | SealedRanking ::
        (\? auction bidders lot currency. ranking auction bidders lot currency) ->
        sealed_auction_result
    | SealedSettlement ::
        (\? auction bidder bidders lot currency. settlement auction bidder bidders lot currency) ->
        sealed_auction_result

:= inspect_sealed (value : sealed_auction_result) : string =
    ?= value ?|
    | SealedCommitment payload =>
        := \? auction lot. _ = payload
        "sealed-commitment"
    | SealedRanking payload =>
        := \? auction bidders lot currency. _ = payload
        "sealed-ranking"
    | SealedSettlement payload =>
        := \? auction bidder bidders lot currency. _ = payload
        "sealed-settlement"

:= serialize_authority (_ : string) (_ : string) (_ : string) (_ : string) : string =
    "schema\tnode_id\toperation\tfrom\tto\tdeps\teffect\tcapability\tretry_budget\n"
    ^^ "1\tclose-commitments\tCloseCommitments\topen\tcommitments_closed\t\tnon_idempotent\tauctioneer\t0\n"
    ^^ "1\topen-reveals\tOpenReveals\tcommitments_closed\treveals_open\tclose-commitments\tnon_idempotent\tauctioneer\t"
    ^^ "0\n1\tverify-reveals\tVerifyReveal\treveals_open\treveals_verified\topen-reveals\tidempotent\tcommitment-verif"
    ^^ "ier\t1\n1\trank-bids\tRankBids\treveals_verified\tranked\tverify-reveals\tnon_idempotent\tpricing-engine\t0\n"
    ^^ "1\tsecond-price\tComputeSecondPrice\tranked\tpriced\trank-bids\tnon_idempotent\tvickrey-rule\t0\n"
    ^^ "1\tsettle-winner\tSettleWinner\tpriced\tsettled\tsecond-price\tnon_idempotent\tsettlement-ledger\t0\n"

:= main () : string =
    := verify_op
        : auction_op reveals_open reveals_verified (valid_reveal auction_501 bidder_a lot_gpu_9 currency_usdc)
        =
        VerifyReveal (ca (), ra ())
    := price_op
        : auction_op ranked priced (
            winner auction_501 bidder_a bidders_abc lot_gpu_9 currency_usdc * second_price auction_501 bidders_abc
                lot_gpu_9 currency_usdc
        )
        =
        ComputeSecondPrice (ranking_abc ())
    := settle_op : auction_op priced settled (settlement auction_501 bidder_a bidders_abc lot_gpu_9 currency_usdc) =
        SettleWinner (winner_a (), price_850 ())
    := commitments = interpret (commitment_interpreter verify_op)
    := pricing = interpret (pricing_interpreter price_op)
    := ledger = interpret (ledger_interpreter settle_op)
    := sealed = inspect_sealed (SealedSettlement (\? (settlement_a ())))
    serialize_authority commitments pricing ledger sealed
