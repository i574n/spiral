:! hg38 = ()
:! hg19 = ()
:! chr1 = ()
:! normalized = ()

:| reference build =
    | Reference :: \* build. string -> reference build

:| locus build contig =
    | Locus :: \* build contig. i32 -> locus build contig

:| variant build contig state =
    | Variant :: \* build contig state. string -> variant build contig state

:= normalize \* build contig.
    (reference : reference build)
    (locus : locus build contig)
    : variant build contig normalized =
    ?= reference, locus ?|
    | Reference _, Locus _ => Variant "normalized-locus"

:= main () : string =
    := reference : reference hg19 = Reference "hg19"
    := locus : locus hg38 chr1 = Locus 101
    := _ : variant hg38 chr1 normalized = normalize reference locus
    "unreachable"
