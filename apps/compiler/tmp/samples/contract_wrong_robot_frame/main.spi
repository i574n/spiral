:! robot_a = ()
:! map_a = ()
:! frame_map = ()
:! frame_camera = ()
:! start_a = ()
:! goal_a = ()
:! planned = ()
:! certified = ()
:! committed = ()
:| trajectory robot map frame start goal state =
    | Trajectory :: \* robot map frame start goal state. string -> trajectory robot map frame start goal state
:| safety_envelope robot map frame start goal state =
    | Envelope :: \* robot map frame start goal state. string -> safety_envelope robot map frame start goal state
:= commit \* robot map frame start goal.
    (path : trajectory robot map frame start goal planned)
    (safety : safety_envelope robot map frame start goal certified)
    : trajectory robot map frame start goal committed
    =
    Trajectory "ok"
:= main () =
    := path : trajectory robot_a map_a frame_map start_a goal_a planned = Trajectory "path"
    := wrong : safety_envelope robot_a map_a frame_camera start_a goal_a certified = Envelope "wrong"
    commit path wrong
