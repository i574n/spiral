nominal robot_a = ()
nominal map_a = ()
nominal frame_map = ()
nominal frame_camera = ()
nominal start_a = ()
nominal goal_a = ()
nominal planned = ()
nominal certified = ()
nominal committed = ()
union trajectory robot map frame start goal state = | Trajectory :: forall robot map frame start goal state. string -> trajectory robot map frame start goal state
union safety_envelope robot map frame start goal state = | Envelope :: forall robot map frame start goal state. string -> safety_envelope robot map frame start goal state
inl commit forall robot map frame start goal. (path : trajectory robot map frame start goal planned) (safety : safety_envelope robot map frame start goal certified) : trajectory robot map frame start goal committed = Trajectory "ok"
inl main () =
    inl path : trajectory robot_a map_a frame_map start_a goal_a planned = Trajectory "path"
    inl wrong : safety_envelope robot_a map_a frame_camera start_a goal_a certified = Envelope "wrong"
    commit path wrong
