:! validate_node = ()
:! publish_node = ()
:! draft = ()
:! validated = ()
:! authorized = ()

:| planned_node id from to =
    | ValidatePlan :: planned_node validate_node draft validated
    | PublishPlan :: planned_node publish_node validated authorized

:| runtime_event id from to =
    | ValidateEvent :: runtime_event validate_node draft validated
    | PublishEvent :: runtime_event publish_node validated authorized

:= attest \* id from to.
    (_ : planned_node id from to)
    (_ : runtime_event id from to)
    : string = "attested"

:= main () : string =
    attest ValidatePlan PublishEvent
