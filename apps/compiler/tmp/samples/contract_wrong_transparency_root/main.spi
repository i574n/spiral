nominal log_a = ()
nominal root_a = ()
nominal root_b = ()
nominal leaf_a = ()
nominal index_7 = ()
nominal committed = ()
nominal verified = ()
union transparency_root log root state = | Root :: forall log root state. string -> transparency_root log root state
union inclusion_witness log root leaf index state = | Inclusion :: forall log root leaf index state. string -> inclusion_witness log root leaf index state
union registry_leaf log leaf index state = | Leaf :: forall log leaf index state. string -> registry_leaf log leaf index state
inl admit forall log root leaf index. (root : transparency_root log root committed) (leaf : registry_leaf log leaf index committed) (proof : inclusion_witness log root leaf index verified) : string = "ok"
inl main () =
    inl root : transparency_root log_a root_a committed = Root "root"
    inl leaf : registry_leaf log_a leaf_a index_7 committed = Leaf "leaf"
    inl wrong : inclusion_witness log_a root_b leaf_a index_7 verified = Inclusion "wrong"
    admit root leaf wrong
