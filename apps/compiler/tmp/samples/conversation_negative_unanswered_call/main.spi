:= main () : i32 =
    := ~tokens_out = 7i32
    := t : conversation::transcript conversation::no_pending =
        conversation::System ("short answers",
        conversation::User ("weather for the day?",
        conversation::Call ("getLocation", "{}",
        conversation::Assistant ("Sunny.", { model = "local"; tokens_out = tokens_out }, conversation::Done))))
    conversation::weigh t
