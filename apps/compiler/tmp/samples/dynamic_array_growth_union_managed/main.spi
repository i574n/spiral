:| payload =
    | Empty
    | Values : array i32

:= reserve ~(xs : array i32) ~(requested_capacity : i32) : () =
    $'DynamicArrayReserve0(!xs,!requested_capacity)'

:= capacity ~(xs : array i32) : i32 =
    $'DynamicArrayCapacity0(!xs)'

:= refcount ~(xs : array i32) : i32 =
    $'DynamicArrayRefCount0(!xs)'

:~ observe x : i32 =
    ?= x ?|
    | Empty => 70i32
    | Values values => ~~ capacity values +. ~~ refcount values

:= main () : i32 =
    := ~values : array i32 = create 0i32
    ~~ reserve values 1i32
    := ~c1 = ~~ capacity values
    ~~ reserve values 2i32
    := ~c2 = ~~ capacity values
    ~~ reserve values 3i32
    := ~c3 = ~~ capacity values
    ~~ reserve values 5i32
    := ~c4 = ~~ capacity values
    ~~ reserve values 9i32
    := ~c5 = ~~ capacity values
    := ~refs_before = ~~ refcount values
    := ~alias = values
    := wrapped = Values values
    := ~observed = observe wrapped
    := ~refs_after = ~~ refcount alias
    (c1 -. 1i32)
    +. (c2 -. 2i32)
    +. (c3 -. 4i32)
    +. (c4 -. 8i32)
    +. (c5 -. 16i32)
    +. (refs_before -. 2i32)
    +. (observed -. 20i32)
    +. (refs_after -. 2i32)
