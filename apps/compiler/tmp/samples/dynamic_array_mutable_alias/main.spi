inl write_at ~xs ~index' ~value = set xs index' value
inl read_at ~xs ~index' = index xs index'

inl main () : i32 =
    inl ~n = 2i32
    inl ~xs : array i32 = create n
    set xs 0i32 1i32
    set xs 1i32 2i32
    join write_at xs 1i32 9i32
    inl ~a = join read_at xs 0i32
    inl ~b = join read_at xs 1i32
    a +. b -. 10i32
