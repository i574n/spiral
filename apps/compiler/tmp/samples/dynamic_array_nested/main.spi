:= main () : i32 =
    := ~n = 2i32
    := ~outer : array (array i32) = create n
    := ~left : array i32 = create n
    := ~right : array i32 = create n
    set left 0i32 3i32
    set left 1i32 4i32
    set right 0i32 5i32
    set right 1i32 6i32
    set outer 0i32 left
    set outer 1i32 right
    := ~a = index outer 0i32
    := ~b = index outer 1i32
    index a 0i32 +. index a 1i32 +. index b 0i32 +. index b 1i32 -. 18i32
