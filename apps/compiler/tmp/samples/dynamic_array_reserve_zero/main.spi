:= reserve ~(xs : array i32) ~(requested_capacity : i32) : () =
    $'DynamicArrayReserve0(!xs,!requested_capacity)'

:= resize ~(xs : array i32) ~(new_length : i32) : () =
    $'DynamicArrayResize0(!xs,!new_length)'

:= capacity ~(xs : array i32) : i32 =
    $'DynamicArrayCapacity0(!xs)'

:= main () : i32 =
    := ~xs : array i32 = create 0i32
    ~~ reserve xs 3i32
    := ~alias = xs
    := ~reserved = ~~ capacity alias
    ? reserved < 3i32 ?> 10i32 |:
        ~~ reserve alias 2i32
        := ~reserved_again = ~~ capacity xs
        ? reserved_again =. reserved ?>
            ~~ resize alias 3i32
            set xs 0i32 4i32
            set xs 1i32 5i32
            set xs 2i32 6i32
            ~~ resize xs 0i32
            ~~ resize alias 3i32
            length xs +. index xs 0i32 +. index xs 1i32 +. index xs 2i32 -. 3i32
        |: 11i32
