:= resize ~(xs : array i32) ~(new_length : i32) : () =
    $'DynamicArrayResize0(!xs,!new_length)'

:= capacity ~(xs : array i32) : i32 =
    $'DynamicArrayCapacity0(!xs)'

:= main () : i32 =
    := ~initial_length = 4i32
    := ~xs : array i32 = create initial_length
    set xs 0i32 1i32
    set xs 1i32 2i32
    set xs 2i32 3i32
    set xs 3i32 4i32
    := ~alias = xs
    ~~ resize xs 2i32
    ~~ resize alias 4i32
    set alias 3i32 7i32
    length xs +. index xs 3i32 +. ~~ capacity xs -. 15i32
