:| payload =
    | Empty
    | Nested : array (array i32)

:~ bump x : i32 =
    ?= x ?|
    | Empty => 0i32
    | Nested outer =>
        := ~inner = index outer 0i32
        := ~value = index inner 0i32
        set inner 0i32 (value +. 1i32)
        0i32

:~ score x : i32 =
    ?= x ?|
    | Empty => 0i32
    | Nested outer =>
        := ~a = index outer 0i32
        := ~b = index outer 1i32
        index a 0i32 +. index a 1i32 +. index b 0i32 +. index b 1i32

:= main () : i32 =
    := ~n = 2i32
    := ~outer : array (array i32) = create n
    := ~left : array i32 = create n
    := ~right : array i32 = create n
    set left 0i32 3i32
    set left 1i32 4i32
    set right 0i32 5i32
    set right 1i32 6i32
    set outer 0i32 left
    set outer 1i32 right
    := first = Nested outer
    := bump_result = bump first
    := second = Nested outer
    score second +. bump_result -. 19i32
