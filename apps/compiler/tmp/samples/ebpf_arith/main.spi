:= main () : i32 =
    := ~h = 7i32
    := ~k = 2i32
    := ~e = 4294967295u32
    := nh = 0i32 -. h
    := ~neg3 = 0i32 -. 3i32
    := ~neg12 = 0i32 -. 12i32
    := ~neg4 = 0i32 -. 4i32
    := ~neg1 = 0i32 -. 1i32
    ? (nh /. k) =. neg3 ?>
        ? (nh %. k) =. neg1 ?>
            ? !!!!ShiftRight(nh, 1i32) =. neg4 ?>
                ? !!!!ShiftLeft(neg3, 2i32) =. neg12 ?>
                    ? (e +. 1u32) =. 0u32 ?>
                        ? (e *. e) =. 1u32 ?>
                            ? !!!!ShiftRight(e, 28i32) =. 15u32 ?> 0i32
                            |: 7i32
                        |: 6i32
                    |: 5i32
                |: 4i32
            |: 3i32
        |: 2i32
    |: 1i32
