component spiral_main() -> (out: 32) {
  cells {
    spiral_tick = std_reg(1);
    spiral_ret = std_reg(32);
    v0 = std_reg(32);
    v1 = std_reg(1);
    c2 = sp_method0();
    v2 = std_reg(1);
    c4 = sp_method2();
    b6 = std_reg(1);
    b8 = std_reg(1);
  }
  wires {
    group g1 {
      v0.in = 32'd3;
      v0.write_en = 1'd1;
      g1[done] = v0.done;
    }
    group g3 {
      v1.in = c2.out;
      v1.write_en = 1'd1;
      g3[done] = v1.done;
    }
    group g5 {
      v2.in = c4.out;
      v2.write_en = 1'd1;
      g5[done] = v2.done;
    }
    group g7 {
      b6.in = v1.out;
      b6.write_en = 1'd1;
      g7[done] = b6.done;
    }
    group g9 {
      b8.in = v2.out;
      b8.write_en = 1'd1;
      g9[done] = b8.done;
    }
    group g10 {
      spiral_ret.in = 32'd1;
      spiral_ret.write_en = 1'd1;
      g10[done] = spiral_ret.done;
    }
    group g11 {
      spiral_ret.in = 32'd0;
      spiral_ret.write_en = 1'd1;
      g11[done] = spiral_ret.done;
    }
    group g12 {
      spiral_ret.in = 32'd2;
      spiral_ret.write_en = 1'd1;
      g12[done] = spiral_ret.done;
    }
    out = spiral_ret.out;
  }
  control {
    seq {
      g1;
      invoke c2(in0 = v0.out)();
      g3;
      invoke c4(in0 = v0.out)();
      g5;
      g7;
      if b6.out {
        seq {
          g9;
          if b8.out {
            seq {
              g10;
            }
          } else {
            seq {
              g11;
            }
          };
        }
      } else {
        seq {
          g12;
        }
      };
    }
  }
}
component main() -> () {
  cells {
    @external spiral_io = comb_mem_d1(32, 1, 1);
    entry = spiral_main();
  }
  wires {
    group spiral_store {
      spiral_io.addr0 = 1'd0;
      spiral_io.write_en = 1'd1;
      spiral_io.write_data = entry.out;
      spiral_store[done] = spiral_io.done;
    }
  }
  control {
    seq {
      invoke entry()();
      spiral_store;
    }
  }
}
