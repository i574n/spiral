(module
  (import "wasi_snapshot_preview1" "proc_exit" (func $proc_exit (param i32)))
  (memory (export "memory") 2)
  (global $hp (mut i32) (i32.const 72))
  (func $method1 (param $v0 i32) (param $v1 i32) (result i32)
    (local $v2 i32)
    (local $v4 i32)
    (local $v3 i32)
    (local $v5 i32)
    (loop $self
        (local.set $v2 (i32.sub (local.get $v0) (i32.const 1)))
        (if (local.get $v1)
            (then
                (local.set $v3 (i32.gt_s (local.get $v0) (i32.const 0)))
                (local.set $v4 (local.get $v3))
            )
            (else
                (local.set $v4 (i32.const 0))
            ))
        (local.set $v5 (i32.eq (local.get $v2) (i32.const 0)))
        (if (local.get $v5)
            (then
                (return (local.get $v4))
            )
            (else
                (local.set $v0 (local.get $v2))
                (local.set $v1 (local.get $v4))
                (br $self)
            ))
    )
    (unreachable)
  )
  (func $method0 (param $v0 i32) (result i32)
    (local $v1 i32)
    (local $v2 i32)
    (local.set $v1 (i32.const 1))
    (local.set $v2 (i32.eq (local.get $v0) (i32.const 0)))
    (if (local.get $v2)
        (then
            (return (local.get $v1))
        )
        (else
            (return (call $method1 (local.get $v0) (local.get $v1)))
        ))
    (unreachable)
  )
  (func $method2 (param $v0 i32) (result i32)
    (local $v1 i32)
    (local $v2 i32)
    (local.set $v1 (i32.const 0))
    (local.set $v2 (i32.eq (local.get $v0) (i32.const 0)))
    (if (local.get $v2)
        (then
            (return (local.get $v1))
        )
        (else
            (return (call $method1 (local.get $v0) (local.get $v1)))
        ))
    (unreachable)
  )
  (func $spiralMain (result i32)
    (local $v0 i32)
    (local $v1 i32)
    (local $v2 i32)
    (local.set $v0 (i32.const 3))
    (local.set $v1 (call $method0 (local.get $v0)))
    (local.set $v2 (call $method2 (local.get $v0)))
    (if (local.get $v1)
        (then
            (if (local.get $v2)
                (then
                    (return (i32.const 1))
                )
                (else
                    (return (i32.const 0))
                ))
        )
        (else
            (return (i32.const 2))
        ))
    (unreachable)
  )
  (func $_start (export "_start")
    (call $proc_exit (call $spiralMain)))
)
