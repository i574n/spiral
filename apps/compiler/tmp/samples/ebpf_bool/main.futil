import "primitives/core.futil";
import "primitives/binary_operators.futil";
import "primitives/memories/comb.futil";
component sp_method0(in0: 1) -> (out: 32) {
  cells {
    spiral_tick = std_reg(1);
    spiral_ret = std_reg(32);
    v0 = std_reg(1);
    b2 = std_reg(1);
  }
  wires {
    group g1 {
      v0.in = in0;
      v0.write_en = 1'd1;
      g1[done] = v0.done;
    }
    group g3 {
      b2.in = v0.out;
      b2.write_en = 1'd1;
      g3[done] = b2.done;
    }
    group g4 {
      spiral_ret.in = 32'd1;
      spiral_ret.write_en = 1'd1;
      g4[done] = spiral_ret.done;
    }
    group g5 {
      spiral_ret.in = 32'd3;
      spiral_ret.write_en = 1'd1;
      g5[done] = spiral_ret.done;
    }
    out = spiral_ret.out;
  }
  control {
    seq {
      g1;
      g3;
      if b2.out {
        seq {
          g4;
        }
      } else {
        seq {
          g5;
        }
      };
    }
  }
}
component sp_method1(in0: 1, in1: 1) -> (out: 32) {
  cells {
    spiral_tick = std_reg(1);
    spiral_ret = std_reg(32);
    v0 = std_reg(1);
    v1 = std_reg(1);
    v2 = std_reg(1);
    op2 = std_and(1);
    b4 = std_reg(1);
    v3 = std_reg(1);
    op7 = std_or(1);
    b9 = std_reg(1);
  }
  wires {
    group g1 {
      v0.in = in0;
      v0.write_en = 1'd1;
      v1.in = in1;
      v1.write_en = 1'd1;
      g1[done] = v0.done & v1.done ? 1'd1;
    }
    group g3 {
      op2.left = v0.out;
      op2.right = v1.out;
      v2.in = op2.out;
      v2.write_en = 1'd1;
      g3[done] = v2.done;
    }
    group g5 {
      b4.in = v2.out;
      b4.write_en = 1'd1;
      g5[done] = b4.done;
    }
    group g6 {
      spiral_ret.in = 32'd1;
      spiral_ret.write_en = 1'd1;
      g6[done] = spiral_ret.done;
    }
    group g8 {
      op7.left = v0.out;
      op7.right = v1.out;
      v3.in = op7.out;
      v3.write_en = 1'd1;
      g8[done] = v3.done;
    }
    group g10 {
      b9.in = v3.out;
      b9.write_en = 1'd1;
      g10[done] = b9.done;
    }
    group g11 {
      spiral_ret.in = 32'd2;
      spiral_ret.write_en = 1'd1;
      g11[done] = spiral_ret.done;
    }
    group g12 {
      spiral_ret.in = 32'd3;
      spiral_ret.write_en = 1'd1;
      g12[done] = spiral_ret.done;
    }
    out = spiral_ret.out;
  }
  control {
    seq {
      g1;
      g3;
      g5;
      if b4.out {
        seq {
          g6;
        }
      } else {
        seq {
          g8;
          g10;
          if b9.out {
            seq {
              g11;
            }
          } else {
            seq {
              g12;
            }
          };
        }
      };
    }
  }
}
