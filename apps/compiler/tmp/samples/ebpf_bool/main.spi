:= pick ~a ~b =
    ? a && b ?> 1i32
    |? a || b ?> 2i32
    |: 3i32

:= main () : i32 =
    := ~yes = !+
    := ~no = !-
    := both = ~~ pick yes yes
    := one = ~~ pick yes no
    := none = ~~ pick no no
    := differ = ? yes =. no ?> !- |: !+
    ? both =. 1i32 && one =. 2i32 && none =. 3i32 && differ ?> 0i32
    |: 1i32
