(module
  (import "wasi_snapshot_preview1" "proc_exit" (func $proc_exit (param i32)))
  (memory (export "memory") 2)
  (global $hp (mut i32) (i32.const 72))
  (func $spiralMain (result i32)
    (local $v0 i32)
    (local $v1 i32)
    (local $v2 i32)
    (local $v3 f32)
    (local $v4 f32)
    (local $v5 f32)
    (local $v6 f32)
    (local $v7 i32)
    (local $v8 i32)
    (local $v10 i32)
    (local $v9 i32)
    (local $v12 i32)
    (local $v11 i32)
    (local $v14 i32)
    (local $v13 i32)
    (local.set $v0 (i32.const 3))
    (local.set $v1 (i32.const -2))
    (local.set $v2 (i32.const 7))
    (local.set $v3 (f32.const 2.9))
    (local.set $v4 (f32.convert_i32_s (local.get $v0)))
    (local.set $v5 (f32.convert_i32_s (local.get $v1)))
    (local.set $v6 (f32.convert_i32_u (local.get $v2)))
    (local.set $v7 (i32.trunc_sat_f32_u (local.get $v3)))
    (local.set $v8 (f32.eq (local.get $v4) (f32.const 3)))
    (if (local.get $v8)
        (then
            (local.set $v9 (f32.eq (local.get $v5) (f32.const -2)))
            (local.set $v10 (local.get $v9))
        )
        (else
            (local.set $v10 (i32.const 0))
        ))
    (if (local.get $v10)
        (then
            (local.set $v11 (f32.eq (local.get $v6) (f32.const 7)))
            (local.set $v12 (local.get $v11))
        )
        (else
            (local.set $v12 (i32.const 0))
        ))
    (if (local.get $v12)
        (then
            (local.set $v13 (i32.eq (local.get $v7) (i32.const 2)))
            (local.set $v14 (local.get $v13))
        )
        (else
            (local.set $v14 (i32.const 0))
        ))
    (if (local.get $v14)
        (then
            (return (i32.const 0))
        )
        (else
            (return (i32.const 1))
        ))
    (unreachable)
  )
  (func $_start (export "_start")
    (call $proc_exit (call $spiralMain)))
)
