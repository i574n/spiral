import "primitives/core.futil";
import "primitives/binary_operators.futil";
import "primitives/memories/comb.futil";
component spiral_main() -> (out: 32) {
  cells {
    spiral_tick = std_reg(1);
    spiral_ret = std_reg(32);
    v0 = std_reg(32);
    v1 = std_reg(32);
    v2 = std_reg(1);
    op3 = std_eq(32);
    b5 = std_reg(1);
    v3 = std_reg(1);
    op7 = std_eq(32);
    b9 = std_reg(1);
    v4 = std_reg(1);
    op11 = std_eq(32);
    b13 = std_reg(1);
  }
  wires {
    group g1 {
      v0.in = 32'd65;
      v0.write_en = 1'd1;
      g1[done] = v0.done;
    }
    group g2 {
      v1.in = 32'd66;
      v1.write_en = 1'd1;
      g2[done] = v1.done;
    }
    group g4 {
      op3.left = v0.out;
      op3.right = 32'd65;
      v2.in = op3.out;
      v2.write_en = 1'd1;
      g4[done] = v2.done;
    }
    group g6 {
      b5.in = v2.out;
      b5.write_en = 1'd1;
      g6[done] = b5.done;
    }
    group g8 {
      op7.left = v1.out;
      op7.right = 32'd66;
      v3.in = op7.out;
      v3.write_en = 1'd1;
      g8[done] = v3.done;
    }
    group g10 {
      b9.in = v3.out;
      b9.write_en = 1'd1;
      g10[done] = b9.done;
    }
    group g12 {
      op11.left = v0.out;
      op11.right = v1.out;
      v4.in = op11.out;
      v4.write_en = 1'd1;
      g12[done] = v4.done;
    }
    group g14 {
      b13.in = v4.out;
      b13.write_en = 1'd1;
      g14[done] = b13.done;
    }
    group g15 {
      spiral_ret.in = 32'd2;
      spiral_ret.write_en = 1'd1;
      g15[done] = spiral_ret.done;
    }
    group g16 {
      spiral_ret.in = 32'd0;
      spiral_ret.write_en = 1'd1;
      g16[done] = spiral_ret.done;
    }
    group g17 {
      spiral_ret.in = 32'd3;
      spiral_ret.write_en = 1'd1;
      g17[done] = spiral_ret.done;
    }
    group g18 {
      spiral_ret.in = 32'd1;
      spiral_ret.write_en = 1'd1;
      g18[done] = spiral_ret.done;
    }
    out = spiral_ret.out;
  }
  control {
    seq {
      g1;
      g2;
      g4;
      g6;
      if b5.out {
        seq {
          g8;
          g10;
          if b9.out {
            seq {
              g12;
              g14;
              if b13.out {
                seq {
                  g15;
                }
              } else {
                seq {
                  g16;
                }
              };
            }
          } else {
            seq {
              g17;
            }
          };
        }
      } else {
        seq {
          g18;
        }
      };
    }
  }
}
component main() -> () {
  cells {
    @external spiral_io = comb_mem_d1(32, 1, 1);
    entry = spiral_main();
  }
  wires {
    group spiral_store {
      spiral_io.addr0 = 1'd0;
      spiral_io.write_en = 1'd1;
      spiral_io.write_data = entry.out;
      spiral_store[done] = spiral_io.done;
    }
  }
  control {
    seq {
      invoke entry()();
      spiral_store;
    }
  }
}
