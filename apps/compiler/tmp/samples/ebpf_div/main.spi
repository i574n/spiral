:= main () : i32 =
    := ~n = 7i32
    := ~d = 0i32 -. 2i32
    := ~m = 0i32 -. 7i32
    := ~u = 100u32
    := ~k = 7u32
    := q = n /. d
    := r = n %. d
    := q2 = m /. d
    := r2 = m %. d
    := uq = u /. k
    := ur = u %. k
    ? q =. (0i32 -. 3i32) && r =. 1i32 && q2 =. 3i32 && r2 =. (0i32 -. 1i32) && uq =. 14u32 && ur =. 2u32 ?> 0i32
    |: 1i32
