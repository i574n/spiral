(module
  (import "wasi_snapshot_preview1" "proc_exit" (func $proc_exit (param i32)))
  (memory (export "memory") 2)
  (global $hp (mut i32) (i32.const 72))
  (func $method1 (param $v0 i32) (param $v1 f32) (result f32)
    (local $v2 i32)
    (local $v3 f32)
    (local $v4 i32)
    (loop $self
        (local.set $v2 (i32.sub (local.get $v0) (i32.const 1)))
        (local.set $v3 (f32.add (local.get $v1) (f32.const 1.5)))
        (local.set $v4 (i32.eq (local.get $v2) (i32.const 0)))
        (if (local.get $v4)
            (then
                (return (local.get $v3))
            )
            (else
                (local.set $v0 (local.get $v2))
                (local.set $v1 (local.get $v3))
                (br $self)
            ))
    )
    (unreachable)
  )
  (func $method0 (param $v0 i32) (param $v1 f32) (result f32)
    (local $v2 i32)
    (local.set $v2 (i32.eq (local.get $v0) (i32.const 0)))
    (if (local.get $v2)
        (then
            (return (local.get $v1))
        )
        (else
            (return (call $method1 (local.get $v0) (local.get $v1)))
        ))
    (unreachable)
  )
  (func $spiralMain (result i32)
    (local $v0 i32)
    (local $v1 f32)
    (local $v2 f32)
    (local $v3 i32)
    (local.set $v0 (i32.const 4))
    (local.set $v1 (f32.const 0))
    (local.set $v2 (call $method0 (local.get $v0) (local.get $v1)))
    (local.set $v3 (f32.eq (local.get $v2) (f32.const 6)))
    (if (local.get $v3)
        (then
            (return (i32.const 0))
        )
        (else
            (return (i32.const 1))
        ))
    (unreachable)
  )
  (func $_start (export "_start")
    (call $proc_exit (call $spiralMain)))
)
