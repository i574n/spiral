inl main () : i32 =
    inl ~x = 0.0f32 -. 1.5f32
    inl ~y = 2.0f32
    inl q = x /. y
    inl ~expect = 0.0f32 -. 0.75f32
    inl scaled = x *. y +. 0.5f32
    inl ~scaled_expect = 0.0f32 -. 2.5f32
    if q =. expect then
        if scaled =. scaled_expect then 0i32
        else 2i32
    else 1i32
