#include <stdint.h>
#include <stdbool.h>
#define SPIRAL_MAP_CAP 64
#define SPIRAL_LOOP_CAP 16777216
static int32_t spiral_map_key[SPIRAL_MAP_CAP];
static int32_t spiral_map_val[SPIRAL_MAP_CAP];
static int32_t spiral_map_used[SPIRAL_MAP_CAP];
static int32_t spiral_map_lookup(int32_t key) {
    int32_t i;
    for (i = 0; i < SPIRAL_MAP_CAP; i++) {
        if (spiral_map_used[i] && spiral_map_key[i] == key) return spiral_map_val[i];
    }
    return 0;
}
static int32_t spiral_map_update(int32_t key, int32_t val) {
    int32_t i;
    int32_t free_slot = -1;
    for (i = 0; i < SPIRAL_MAP_CAP; i++) {
        if (spiral_map_used[i] && spiral_map_key[i] == key) { spiral_map_val[i] = val; return 0; }
        if (!spiral_map_used[i] && free_slot < 0) free_slot = i;
    }
    if (free_slot < 0) return 1;
    spiral_map_used[free_slot] = 1;
    spiral_map_key[free_slot] = key;
    spiral_map_val[free_slot] = val;
    return 0;
}
static int32_t spiral_main(void) {
    float v0 = 0.0f;
    v0 = (-2.0f);
    float v1 = 0.0f;
    v1 = (-1.0f);
    float v2 = 0.0f;
    v2 = 0.0f;
    bool v3 = false;
    v3 = (v0 < v1);
    bool v5 = false;
    if (v3) {
        bool v4 = false;
        v4 = (v1 < v2);
        v5 = v4;
    } else {
        v5 = false;
    }
    bool v8 = false;
    if (v5) {
        bool v6 = false;
        v6 = (v0 > v1);
        bool v7 = false;
        v7 = (v6 == false);
        v8 = v7;
    } else {
        v8 = false;
    }
    bool v11 = false;
    if (v8) {
        bool v9 = false;
        v9 = (v0 >= v1);
        bool v10 = false;
        v10 = (v9 == false);
        v11 = v10;
    } else {
        v11 = false;
    }
    bool v13 = false;
    if (v11) {
        bool v12 = false;
        v12 = (v1 <= v2);
        v13 = v12;
    } else {
        v13 = false;
    }
    if (v13) {
        return 0;
    } else {
        return 1;
    }
}
int main(void) {
    return spiral_main();
}
