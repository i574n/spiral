inl main () : i32 =
    inl ~a = 0i32 -. 3i32
    inl ~b = 0i32 -. 4i32
    inl ~c = 0i32 -. 3i32
    inl ~u = 4294967295u32
    inl ~v = 0u32
    inl ~w = 4294967295u32
    inl ~x = 0.0f32 -. 1.5f32
    inl ~y = 0.0f32 -. 0.5f32
    inl ~z = 0.0f32 -. 1.5f32
    inl idiff = !!!!NEQ(a, b)
    inl isame = !!!!NEQ(a, c)
    inl udiff = !!!!NEQ(u, v)
    inl usame = !!!!NEQ(u, w)
    inl fdiff = !!!!NEQ(x, y)
    inl fsame = !!!!NEQ(x, z)
    if idiff && udiff && fdiff then
        if isame then 1i32 else
            if usame then 2i32 else
                if fsame then 3i32 else 0i32
    else 4i32
