:= map_update (key : i32) (value : i32) (expect : i32) : i32 =
    !!!!BackendSwitch({
        C = \ () => $"!expect" : i32
        Ebpf = \ () => $"spiral_map_update(!key, !value)" : i32
        Bend = \ () => expect
        Zig = \ () => expect
    })

:= map_lookup (key : i32) (expect : i32) : i32 =
    !!!!BackendSwitch({
        C = \ () => $"!expect" : i32
        Ebpf = \ () => $"spiral_map_lookup(!key)" : i32
        Bend = \ () => expect
        Zig = \ () => expect
    })

:= main () : i32 =
    := ~k = 3i32
    := ~shift = 1i32
    := key = !!!!ShiftLeft(k, shift)
    := status = map_update key 11i32 0i32
    := got = map_lookup key 11i32
    ? key =. 6i32 && status =. 0i32 && got =. 11i32 ?> 0i32
    |: 1i32
