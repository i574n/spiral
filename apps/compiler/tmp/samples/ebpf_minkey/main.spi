:= map_update (key : i32) (value : i32) (expect : i32) : i32 =
    !!!!BackendSwitch({
        C = \ () => $"!expect" : i32
        Ebpf = \ () => $"spiral_map_update(!key, !value)" : i32
        Bend = \ () => expect
        Zig = \ () => expect
    })

:= map_lookup (key : i32) (expect : i32) : i32 =
    !!!!BackendSwitch({
        C = \ () => $"!expect" : i32
        Ebpf = \ () => $"spiral_map_lookup(!key)" : i32
        Bend = \ () => expect
        Zig = \ () => expect
    })

:= main () : i32 =
    := ~k = -2147483648i32
    := status = map_update k 3i32 0i32
    := got = map_lookup k 3i32
    ? status =. 0i32 && got =. 3i32 ?> 0i32
    |: 1i32
