#include <stdint.h>
#include <stdbool.h>
#define SPIRAL_MAP_CAP 64
#ifdef __bpf__
#define SPIRAL_LOOP_CAP 8192
int32_t spiral_loop_capped;
#define SPIRAL_LOOP_CAPPED() (spiral_loop_capped = 1)
#else
#define SPIRAL_LOOP_CAP 16777216
#define SPIRAL_LOOP_CAPPED() ((void)0)
#endif
static int32_t spiral_map_key[SPIRAL_MAP_CAP];
static int32_t spiral_map_val[SPIRAL_MAP_CAP];
static int32_t spiral_map_used[SPIRAL_MAP_CAP];
static int32_t spiral_map_lookup(int32_t key) {
    int32_t i;
    for (i = 0; i < SPIRAL_MAP_CAP; i++) {
        if (spiral_map_used[i] && spiral_map_key[i] == key) return spiral_map_val[i];
    }
    return 0;
}
static int32_t spiral_map_update(int32_t key, int32_t val) {
    int32_t i;
    int32_t free_slot = -1;
    for (i = 0; i < SPIRAL_MAP_CAP; i++) {
        if (spiral_map_used[i] && spiral_map_key[i] == key) { spiral_map_val[i] = val; return 0; }
        if (!spiral_map_used[i] && free_slot < 0) free_slot = i;
    }
    if (free_slot < 0) return 1;
    spiral_map_used[free_slot] = 1;
    spiral_map_key[free_slot] = key;
    spiral_map_val[free_slot] = val;
    return 0;
}
static int32_t spiral_main(void) {
    int32_t v0 = 0;
    v0 = 3;
    int32_t v1 = 0;
    v1 = 4;
    uint32_t v2 = 0u;
    v2 = 1u;
    uint32_t v3 = 0u;
    v3 = 1u;
    float v4 = 0.0f;
    v4 = 1.5f;
    float v5 = 0.0f;
    v5 = (-(v4));
    bool v6 = false;
    v6 = (v0 != v1);
    if (v6) {
        bool v7 = false;
        v7 = (v2 != v3);
        if (v7) {
            return 2;
        } else {
            bool v8 = false;
            v8 = (v5 == (-1.5f));
            if (v8) {
                return 0;
            } else {
                return 3;
            }
        }
    } else {
        return 1;
    }
}
#ifdef __bpf__
#define SEC(name) __attribute__((section(name), used))
int32_t spiral_exit_code;
SEC("socket")
int spiral_socket(void *context) {
    int32_t spiral_result = spiral_main();
    spiral_exit_code = spiral_loop_capped ? -2147483647 : spiral_result;
    return 0;
}
char LICENSE[] SEC("license") = "GPL";
#else
