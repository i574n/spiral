    }
    group g34 {
      spiral_ret.in = 32'd1;
      spiral_ret.write_en = 1'd1;
      g34[done] = spiral_ret.done;
    }
    out = spiral_ret.out;
  }
  control {
    seq {
      g1;
      g2;
      g3;
      g4;
      g5;
      g7;
      g9;
      g11;
      g13;
      g15;
      g17;
      if b16.out {
        seq {
