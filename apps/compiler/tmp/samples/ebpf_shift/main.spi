:= main () : i32 =
    := ~n = 0i32 -. 8i32
    := ~p = 3i32
    := ~c = 1i32
    := ~u = 4294967295u32
    := ~k = 4i32
    := a = !!!!ShiftRight(n, c)
    := b = !!!!ShiftLeft(p, c)
    := d = !!!!ShiftRight(u, k)
    := e = !!!!ShiftLeft(u, c)
    ? a =. (0i32 -. 4i32) ?>
        ? b =. 6i32 ?>
            ? d =. 268435455u32 ?>
                ? e =. 4294967294u32 ?> 0i32
                |: 4i32
            |: 3i32
        |: 2i32
    |: 1i32
