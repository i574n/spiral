import "primitives/core.futil";
import "primitives/binary_operators.futil";
import "primitives/memories/comb.futil";
component sp_method1(in0: 32, in1: 32) -> (out0: 32, out1: 32) {
  cells {
    spiral_tick = std_reg(1);
    spiral_ret0 = std_reg(32);
    spiral_ret1 = std_reg(32);
    v0 = std_reg(32);
    v1 = std_reg(32);
  }
  wires {
    group g1 {
      v0.in = in0;
      v0.write_en = 1'd1;
      v1.in = in1;
      v1.write_en = 1'd1;
      g1[done] = v0.done & v1.done ? 1'd1;
    }
    group g2 {
      spiral_ret0.in = v0.out;
      spiral_ret0.write_en = 1'd1;
      spiral_ret1.in = v1.out;
      spiral_ret1.write_en = 1'd1;
      g2[done] = spiral_ret0.done & spiral_ret1.done ? 1'd1;
    }
    out0 = spiral_ret0.out;
    out1 = spiral_ret1.out;
  }
  control {
    seq {
      g1;
      g2;
    }
  }
}
component sp_method0(in0: 32, in1: 32) -> (out: 32) {
  cells {
    spiral_tick = std_reg(1);
    spiral_ret = std_reg(32);
    v0 = std_reg(32);
    v1 = std_reg(32);
    v2 = std_reg(32);
    v3 = std_reg(32);
    c2 = sp_method1();
    v4 = std_reg(32);
    op4 = std_add(32);
  }
  wires {
    group g1 {
      v0.in = in0;
      v0.write_en = 1'd1;
      v1.in = in1;
      v1.write_en = 1'd1;
      g1[done] = v0.done & v1.done ? 1'd1;
    }
    group g3 {
      v2.in = c2.out0;
      v2.write_en = 1'd1;
      v3.in = c2.out1;
      v3.write_en = 1'd1;
      g3[done] = v2.done & v3.done ? 1'd1;
    }
    group g5 {
      op4.left = v2.out;
      op4.right = v3.out;
      v4.in = op4.out;
      v4.write_en = 1'd1;
      g5[done] = v4.done;
    }
    group g6 {
      spiral_ret.in = v4.out;
      spiral_ret.write_en = 1'd1;
      g6[done] = spiral_ret.done;
    }
    out = spiral_ret.out;
  }
  control {
    seq {
      g1;
      invoke c2(in0 = v0.out, in1 = v1.out)();
      g3;
      g5;
      g6;
    }
  }
}
component sp_method3(in0: 32, in1: 32, in2: 32) -> (out0: 32, out1: 32, out2: 32) {
  cells {
    spiral_tick = std_reg(1);
    spiral_ret0 = std_reg(32);
    spiral_ret1 = std_reg(32);
    spiral_ret2 = std_reg(32);
    v0 = std_reg(32);
    v1 = std_reg(32);
    v2 = std_reg(32);
  }
  wires {
    group g1 {
      v0.in = in0;
      v0.write_en = 1'd1;
      v1.in = in1;
      v1.write_en = 1'd1;
      v2.in = in2;
      v2.write_en = 1'd1;
      g1[done] = v0.done & v1.done & v2.done ? 1'd1;
    }
    group g2 {
      spiral_ret0.in = v0.out;
      spiral_ret0.write_en = 1'd1;
      spiral_ret1.in = v1.out;
      spiral_ret1.write_en = 1'd1;
      spiral_ret2.in = v2.out;
      spiral_ret2.write_en = 1'd1;
      g2[done] = spiral_ret0.done & spiral_ret1.done & spiral_ret2.done ? 1'd1;
    }
    out0 = spiral_ret0.out;
    out1 = spiral_ret1.out;
    out2 = spiral_ret2.out;
  }
  control {
    seq {
      g1;
      g2;
    }
  }
}
component sp_method2(in0: 32, in1: 32, in2: 32) -> (out: 32) {
  cells {
    spiral_tick = std_reg(1);
    spiral_ret = std_reg(32);
    v0 = std_reg(32);
    v1 = std_reg(32);
    v2 = std_reg(32);
    v3 = std_reg(32);
    v4 = std_reg(32);
    v5 = std_reg(32);
    c2 = sp_method3();
    v6 = std_reg(32);
    op4 = std_add(32);
    v7 = std_reg(32);
    op6 = std_add(32);
  }
  wires {
    group g1 {
      v0.in = in0;
      v0.write_en = 1'd1;
      v1.in = in1;
      v1.write_en = 1'd1;
      v2.in = in2;
      v2.write_en = 1'd1;
      g1[done] = v0.done & v1.done & v2.done ? 1'd1;
    }
    group g3 {
      v3.in = c2.out0;
      v3.write_en = 1'd1;
      v4.in = c2.out1;
      v4.write_en = 1'd1;
      v5.in = c2.out2;
      v5.write_en = 1'd1;
      g3[done] = v3.done & v4.done & v5.done ? 1'd1;
    }
    group g5 {
      op4.left = v3.out;
      op4.right = v4.out;
      v6.in = op4.out;
      v6.write_en = 1'd1;
      g5[done] = v6.done;
    }
    group g7 {
      op6.left = v6.out;
      op6.right = v5.out;
      v7.in = op6.out;
      v7.write_en = 1'd1;
      g7[done] = v7.done;
    }
    group g8 {
      spiral_ret.in = v7.out;
      spiral_ret.write_en = 1'd1;
      g8[done] = spiral_ret.done;
    }
    out = spiral_ret.out;
  }
  control {
    seq {
      g1;
      invoke c2(in0 = v0.out, in1 = v1.out, in2 = v2.out)();
      g3;
      g5;
      g7;
      g8;
    }
  }
}
component spiral_main() -> (out: 32) {
  cells {
    spiral_tick = std_reg(1);
    spiral_ret = std_reg(32);
    v0 = std_reg(32);
    v1 = std_reg(32);
    v2 = std_reg(32);
    v3 = std_reg(32);
    c4 = sp_method0();
    v4 = std_reg(32);
    c6 = sp_method2();
    v5 = std_reg(32);
    op8 = std_add(32);
    v6 = std_reg(32);
    op10 = std_sub(32);
  }
  wires {
    group g1 {
      v0.in = 32'd1;
      v0.write_en = 1'd1;
      g1[done] = v0.done;
    }
    group g2 {
      v1.in = 32'd2;
      v1.write_en = 1'd1;
      g2[done] = v1.done;
    }
    group g3 {
      v2.in = 32'd3;
      v2.write_en = 1'd1;
      g3[done] = v2.done;
    }
    group g5 {
      v3.in = c4.out;
      v3.write_en = 1'd1;
      g5[done] = v3.done;
    }
    group g7 {
      v4.in = c6.out;
      v4.write_en = 1'd1;
      g7[done] = v4.done;
    }
    group g9 {
      op8.left = v3.out;
      op8.right = v4.out;
      v5.in = op8.out;
      v5.write_en = 1'd1;
      g9[done] = v5.done;
    }
    group g11 {
      op10.left = v5.out;
      op10.right = 32'd9;
      v6.in = op10.out;
      v6.write_en = 1'd1;
      g11[done] = v6.done;
    }
    group g12 {
      spiral_ret.in = v6.out;
      spiral_ret.write_en = 1'd1;
      g12[done] = spiral_ret.done;
    }
    out = spiral_ret.out;
  }
  control {
    seq {
      g1;
      g2;
      g3;
      invoke c4(in0 = v0.out, in1 = v1.out)();
      g5;
      invoke c6(in0 = v0.out, in1 = v1.out, in2 = v2.out)();
      g7;
      g9;
      g11;
      g12;
    }
  }
}
component main() -> () {
  cells {
    @external spiral_io = comb_mem_d1(32, 1, 1);
    entry = spiral_main();
  }
  wires {
    group spiral_store {
      spiral_io.addr0 = 1'd0;
      spiral_io.write_en = 1'd1;
      spiral_io.write_data = entry.out;
      spiral_store[done] = spiral_io.done;
    }
  }
  control {
    seq {
      invoke entry()();
      spiral_store;
    }
  }
}
