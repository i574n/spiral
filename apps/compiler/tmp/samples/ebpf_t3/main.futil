    v5 = std_reg(1);
    op8 = std_eq(32);
    v8 = std_reg(1);
    b12 = std_reg(1);
    v7 = std_reg(1);
    op14 = std_eq(32);
    b18 = std_reg(1);
  }
  wires {
    group g1 {
      v0.in = in0;
      v0.write_en = 1'd1;
      g1[done] = v0.done;
    }
    group g3 {
      v1.in = c2.out0;
      v1.write_en = 1'd1;
      v2.in = c2.out1;
      v2.write_en = 1'd1;
      v3.in = c2.out2;
