import "primitives/core.futil";
import "primitives/binary_operators.futil";
import "primitives/memories/comb.futil";
component sp_method2(in0: 32, in1: 32, in2: 32, in3: 32) -> (out0: 32, out1: 32, out2: 32) {
  cells {
    spiral_tick = std_reg(1);
    spiral_ret0 = std_reg(32);
    spiral_ret1 = std_reg(32);
    spiral_ret2 = std_reg(32);
    v0 = std_reg(32);
    v1 = std_reg(32);
    v2 = std_reg(32);
    v3 = std_reg(32);
    spiral_go = std_reg(1);
    v4 = std_reg(32);
    op3 = std_sub(32);
    v5 = std_reg(32);
    op5 = std_add(32);
    v6 = std_reg(32);
    op7 = std_add(32);
    v7 = std_reg(32);
    op9 = std_add(32);
    v8 = std_reg(1);
    op11 = std_eq(32);
    b13 = std_reg(1);
    t17 = std_reg(32);
    t19 = std_reg(32);
    t21 = std_reg(32);
    t23 = std_reg(32);
  }
  wires {
    group g1 {
      v0.in = in0;
      v0.write_en = 1'd1;
      v1.in = in1;
      v1.write_en = 1'd1;
      v2.in = in2;
      v2.write_en = 1'd1;
      v3.in = in3;
      v3.write_en = 1'd1;
      g1[done] = v0.done & v1.done & v2.done & v3.done ? 1'd1;
    }
    group g2 {
      spiral_go.in = 1'd1;
      spiral_go.write_en = 1'd1;
      g2[done] = spiral_go.done;
    }
    group g4 {
      op3.left = v0.out;
      op3.right = 32'd1;
      v4.in = op3.out;
      v4.write_en = 1'd1;
      g4[done] = v4.done;
    }
    group g6 {
      op5.left = v1.out;
      op5.right = 32'd1;
      v5.in = op5.out;
      v5.write_en = 1'd1;
      g6[done] = v5.done;
    }
    group g8 {
      op7.left = v2.out;
      op7.right = 32'd2;
      v6.in = op7.out;
      v6.write_en = 1'd1;
      g8[done] = v6.done;
    }
    group g10 {
      op9.left = v3.out;
      op9.right = 32'd3;
      v7.in = op9.out;
      v7.write_en = 1'd1;
      g10[done] = v7.done;
    }
    group g12 {
      op11.left = v4.out;
      op11.right = 32'd0;
      v8.in = op11.out;
      v8.write_en = 1'd1;
      g12[done] = v8.done;
    }
    group g14 {
      b13.in = v8.out;
      b13.write_en = 1'd1;
      g14[done] = b13.done;
    }
    group g15 {
      spiral_ret0.in = v5.out;
      spiral_ret0.write_en = 1'd1;
      spiral_ret1.in = v6.out;
      spiral_ret1.write_en = 1'd1;
      spiral_ret2.in = v7.out;
      spiral_ret2.write_en = 1'd1;
      g15[done] = spiral_ret0.done & spiral_ret1.done & spiral_ret2.done ? 1'd1;
    }
    group g16 {
      spiral_go.in = 1'd0;
      spiral_go.write_en = 1'd1;
      g16[done] = spiral_go.done;
    }
    group g18 {
      t17.in = v4.out;
      t17.write_en = 1'd1;
      g18[done] = t17.done;
    }
    group g20 {
      t19.in = v5.out;
      t19.write_en = 1'd1;
      g20[done] = t19.done;
    }
    group g22 {
      t21.in = v6.out;
      t21.write_en = 1'd1;
      g22[done] = t21.done;
    }
    group g24 {
      t23.in = v7.out;
      t23.write_en = 1'd1;
      g24[done] = t23.done;
    }
    group g25 {
      v0.in = t17.out;
      v0.write_en = 1'd1;
      g25[done] = v0.done;
    }
    group g26 {
      v1.in = t19.out;
      v1.write_en = 1'd1;
      g26[done] = v1.done;
    }
    group g27 {
      v2.in = t21.out;
      v2.write_en = 1'd1;
      g27[done] = v2.done;
    }
    group g28 {
      v3.in = t23.out;
      v3.write_en = 1'd1;
      g28[done] = v3.done;
    }
    out0 = spiral_ret0.out;
    out1 = spiral_ret1.out;
    out2 = spiral_ret2.out;
  }
  control {
    seq {
      g1;
      g2;
      while spiral_go.out {
        seq {
          g4;
          g6;
          g8;
          g10;
          g12;
          g14;
          if b13.out {
            seq {
              g15;
              g16;
            }
          } else {
            seq {
              g18;
              g20;
              g22;
              g24;
              g25;
              g26;
              g27;
              g28;
            }
          };
        }
      };
    }
  }
}
component sp_method1(in0: 32) -> (out0: 32, out1: 32, out2: 32) {
  cells {
    spiral_tick = std_reg(1);
    spiral_ret0 = std_reg(32);
    spiral_ret1 = std_reg(32);
    spiral_ret2 = std_reg(32);
    v0 = std_reg(32);
    v1 = std_reg(32);
    v2 = std_reg(32);
    v3 = std_reg(32);
    v4 = std_reg(1);
    op5 = std_eq(32);
    b7 = std_reg(1);
    c10 = sp_method2();
  }
  wires {
    group g1 {
      v0.in = in0;
      v0.write_en = 1'd1;
      g1[done] = v0.done;
    }
    group g2 {
      v1.in = 32'd0;
      v1.write_en = 1'd1;
      g2[done] = v1.done;
    }
    group g3 {
      v2.in = 32'd0;
      v2.write_en = 1'd1;
      g3[done] = v2.done;
    }
    group g4 {
      v3.in = 32'd0;
      v3.write_en = 1'd1;
      g4[done] = v3.done;
    }
    group g6 {
      op5.left = v0.out;
      op5.right = 32'd0;
      v4.in = op5.out;
      v4.write_en = 1'd1;
      g6[done] = v4.done;
    }
    group g8 {
      b7.in = v4.out;
      b7.write_en = 1'd1;
      g8[done] = b7.done;
    }
    group g9 {
      spiral_ret0.in = v1.out;
      spiral_ret0.write_en = 1'd1;
      spiral_ret1.in = v2.out;
      spiral_ret1.write_en = 1'd1;
      spiral_ret2.in = v3.out;
      spiral_ret2.write_en = 1'd1;
      g9[done] = spiral_ret0.done & spiral_ret1.done & spiral_ret2.done ? 1'd1;
    }
    group g11 {
      spiral_ret0.in = c10.out0;
      spiral_ret0.write_en = 1'd1;
      spiral_ret1.in = c10.out1;
      spiral_ret1.write_en = 1'd1;
      spiral_ret2.in = c10.out2;
      spiral_ret2.write_en = 1'd1;
      g11[done] = spiral_ret0.done & spiral_ret1.done & spiral_ret2.done ? 1'd1;
    }
    out0 = spiral_ret0.out;
    out1 = spiral_ret1.out;
    out2 = spiral_ret2.out;
  }
  control {
    seq {
      g1;
      g2;
      g3;
      g4;
      g6;
      g8;
      if b7.out {
        seq {
          g9;
        }
      } else {
        seq {
          invoke c10(in0 = v0.out, in1 = v1.out, in2 = v2.out, in3 = v3.out)();
          g11;
        }
      };
    }
  }
}
