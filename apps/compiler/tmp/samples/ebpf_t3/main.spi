inl rec step ~n ~a ~b ~c =
    if n =. 0i32 then a, b, c else
        join step (n -. 1i32) (a +. 1i32) (b +. 2i32) (c +. 3i32)

inl read ~(a, b, c) : i32 =
    if a =. 3i32 && b =. 6i32 && c =. 9i32 then 0i32 else 1i32

inl main () : i32 =
    inl ~n = 3i32
    join read (join step n 0i32 0i32 0i32)
