inl rec climb ~n ~acc =
    if n =. 0i32 then acc else
        join climb (n -. 1i32) (acc +. 3i32)

inl rec drop ~n ~acc =
    if n =. 0i32 then acc else
        join drop (n -. 1i32) (acc -. 2i32)

inl main () : i32 =
    inl ~n = 4i32
    inl up = join climb n 0i32
    inl down = join drop n 0i32
    if up =. 12i32 && down =. (0i32 -. 8i32) then 0i32 else 1i32
