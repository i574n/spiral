import "primitives/core.futil";
import "primitives/binary_operators.futil";
import "primitives/memories/comb.futil";
component spiral_main() -> (out: 32) {
  cells {
    spiral_tick = std_reg(1);
    spiral_ret = std_reg(32);
    v0 = std_reg(32);
    v1 = std_reg(32);
    v2 = std_reg(32);
    v3 = std_reg(32);
    v4 = std_reg(32);
    op5 = std_mult_pipe(32);
    v5 = std_reg(32);
    op7 = std_mult_pipe(32);
    v6 = std_reg(1);
    op9 = std_eq(32);
    v8 = std_reg(1);
    b11 = std_reg(1);
    v7 = std_reg(1);
    op13 = std_eq(32);
    b17 = std_reg(1);
  }
  wires {
    group g1 {
      v0.in = 32'd65536;
      v0.write_en = 1'd1;
      g1[done] = v0.done;
    }
    group g2 {
      v1.in = 32'd65536;
      v1.write_en = 1'd1;
      g2[done] = v1.done;
    }
    group g3 {
      v2.in = 32'd4294967295;
      v2.write_en = 1'd1;
      g3[done] = v2.done;
    }
    group g4 {
      v3.in = 32'd3;
      v3.write_en = 1'd1;
      g4[done] = v3.done;
    }
    group g6 {
      op5.left = v0.out;
      op5.right = v1.out;
      op5.go = !op5.done ? 1'd1;
      v4.in = op5.out;
      v4.write_en = op5.done;
      g6[done] = v4.done;
    }
    group g8 {
      op7.left = v2.out;
      op7.right = v3.out;
      op7.go = !op7.done ? 1'd1;
      v5.in = op7.out;
      v5.write_en = op7.done;
      g8[done] = v5.done;
    }
    group g10 {
      op9.left = v4.out;
      op9.right = 32'd0;
      v6.in = op9.out;
      v6.write_en = 1'd1;
      g10[done] = v6.done;
    }
    group g12 {
      b11.in = v6.out;
      b11.write_en = 1'd1;
      g12[done] = b11.done;
    }
    group g14 {
      op13.left = v5.out;
      op13.right = 32'd4294967293;
      v7.in = op13.out;
      v7.write_en = 1'd1;
      g14[done] = v7.done;
    }
    group g15 {
      v8.in = v7.out;
      v8.write_en = 1'd1;
      g15[done] = v8.done;
    }
    group g16 {
      v8.in = 1'd0;
      v8.write_en = 1'd1;
      g16[done] = v8.done;
    }
    group g18 {
      b17.in = v8.out;
      b17.write_en = 1'd1;
      g18[done] = b17.done;
    }
    group g19 {
      spiral_ret.in = 32'd0;
      spiral_ret.write_en = 1'd1;
      g19[done] = spiral_ret.done;
    }
    group g20 {
      spiral_ret.in = 32'd1;
      spiral_ret.write_en = 1'd1;
      g20[done] = spiral_ret.done;
    }
    out = spiral_ret.out;
  }
  control {
    seq {
      g1;
      g2;
      g3;
      g4;
      g6;
      g8;
      g10;
      g12;
      if b11.out {
        seq {
          g14;
          g15;
        }
      } else {
        seq {
          g16;
        }
      };
      g18;
      if b17.out {
        seq {
          g19;
        }
      } else {
        seq {
          g20;
        }
      };
    }
  }
}
component main() -> () {
  cells {
    @external spiral_io = comb_mem_d1(32, 1, 1);
    entry = spiral_main();
  }
  wires {
    group spiral_store {
      spiral_io.addr0 = 1'd0;
      spiral_io.write_en = 1'd1;
      spiral_io.write_data = entry.out;
      spiral_store[done] = spiral_io.done;
    }
  }
  control {
    seq {
      invoke entry()();
      spiral_store;
    }
  }
}
