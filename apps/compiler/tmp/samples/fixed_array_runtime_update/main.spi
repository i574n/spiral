:= main () =
    := ~xs : array i32 = create 4i32
    set xs 0i32 2i32
    set xs 1i32 3i32
    set xs 2i32 5i32
    set xs 3i32 7i32
    := ~i = 1i32
    set xs i 11i32
    := ~x0 = index xs 0i32
    := ~x1 = index xs 1i32
    := ~x2 = index xs 2i32
    := ~x3 = index xs 3i32
    x0 +. x1 +. x2 +. x3 -. 25i32
