:= ^ spin (k : i32) : i32 =
    ? k = 0i32 ?> 0i32
    |: spin (k - 1i32)

:~ leaf_c () : i32 =
    global "// c1"
    0i32

:~ slow_a () : i32 =
    global "// a1"
    := _ = spin 2000i32
    := x = leaf_c ()
    global "// a2"
    x

:~ fast_b () : i32 =
    global "// b1"
    0i32

:= main () : i32 =
    global "// m1"
    := a = slow_a ()
    := b = fast_b ()
    global "// m2"
    a + b
