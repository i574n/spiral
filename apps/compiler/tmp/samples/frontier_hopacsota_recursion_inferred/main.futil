import "primitives/core.futil";
import "primitives/binary_operators.futil";
import "primitives/memories/comb.futil";
component sp_count_0(in0: 32) -> (out: 32) {
  cells {
    spiral_tick = std_reg(1);
    spiral_ret = std_reg(32);
    v0 = std_reg(32);
    spiral_go = std_reg(1);
    v1 = std_reg(1);
    op3 = std_sle(32);
    b5 = std_reg(1);
    v2 = std_reg(32);
    op9 = std_sub(32);
    t11 = std_reg(32);
  }
  wires {
    group g1 {
      v0.in = in0;
      v0.write_en = 1'd1;
      g1[done] = v0.done;
    }
    group g2 {
      spiral_go.in = 1'd1;
      spiral_go.write_en = 1'd1;
      g2[done] = spiral_go.done;
    }
    group g4 {
      op3.left = v0.out;
      op3.right = 32'd0;
      v1.in = op3.out;
      v1.write_en = 1'd1;
      g4[done] = v1.done;
    }
    group g6 {
      b5.in = v1.out;
      b5.write_en = 1'd1;
      g6[done] = b5.done;
    }
    group g7 {
      spiral_ret.in = 32'd0;
      spiral_ret.write_en = 1'd1;
      g7[done] = spiral_ret.done;
    }
    group g8 {
      spiral_go.in = 1'd0;
      spiral_go.write_en = 1'd1;
      g8[done] = spiral_go.done;
    }
    group g10 {
      op9.left = v0.out;
      op9.right = 32'd1;
      v2.in = op9.out;
      v2.write_en = 1'd1;
      g10[done] = v2.done;
    }
    group g12 {
      t11.in = v2.out;
      t11.write_en = 1'd1;
      g12[done] = t11.done;
    }
    group g13 {
      v0.in = t11.out;
      v0.write_en = 1'd1;
      g13[done] = v0.done;
    }
    out = spiral_ret.out;
  }
  control {
    seq {
      g1;
      g2;
      while spiral_go.out {
        seq {
          g4;
          g6;
          if b5.out {
            seq {
              g7;
              g8;
            }
          } else {
            seq {
              g10;
              g12;
              g13;
            }
          };
        }
      };
    }
  }
}
component spiral_main() -> (out: 32) {
  cells {
    spiral_tick = std_reg(1);
    spiral_ret = std_reg(32);
    v0 = std_reg(32);
    c2 = sp_count_0();
  }
  wires {
    group g1 {
      v0.in = 32'd5;
      v0.write_en = 1'd1;
      g1[done] = v0.done;
    }
    group g3 {
      spiral_ret.in = c2.out;
      spiral_ret.write_en = 1'd1;
      g3[done] = spiral_ret.done;
    }
    out = spiral_ret.out;
  }
  control {
    seq {
      g1;
      invoke c2(in0 = v0.out)();
      g3;
    }
  }
}
component main() -> () {
  cells {
    @external spiral_io = comb_mem_d1(32, 1, 1);
    entry = spiral_main();
  }
  wires {
    group spiral_store {
      spiral_io.addr0 = 1'd0;
      spiral_io.write_en = 1'd1;
      spiral_io.write_data = entry.out;
      spiral_store[done] = spiral_io.done;
    }
  }
  control {
    seq {
      invoke entry()();
      spiral_store;
    }
  }
}
