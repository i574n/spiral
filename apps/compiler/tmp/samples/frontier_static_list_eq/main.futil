import "primitives/core.futil";
import "primitives/binary_operators.futil";
import "primitives/memories/comb.futil";
component spiral_main() -> (out: 32) {
  cells {
    spiral_tick = std_reg(1);
    spiral_ret = std_reg(32);
    v0 = std_reg(32);
    v1 = std_reg(1);
    op2 = std_eq(32);
    v3 = std_reg(1);
    b4 = std_reg(1);
    v2 = std_reg(1);
    op7 = std_eq(32);
    b10 = std_reg(1);
  }
  wires {
    group g1 {
      v0.in = 32'd120;
      v0.write_en = 1'd1;
      g1[done] = v0.done;
    }
    group g3 {
      op2.left = v0.out;
      op2.right = 32'd32;
      v1.in = op2.out;
      v1.write_en = 1'd1;
      g3[done] = v1.done;
    }
    group g5 {
      b4.in = v1.out;
      b4.write_en = 1'd1;
      g5[done] = b4.done;
    }
    group g6 {
      v3.in = 1'd1;
      v3.write_en = 1'd1;
      g6[done] = v3.done;
    }
    group g8 {
      op7.left = v0.out;
      op7.right = 32'd47;
      v2.in = op7.out;
      v2.write_en = 1'd1;
      g8[done] = v2.done;
    }
    group g9 {
      v3.in = v2.out;
      v3.write_en = 1'd1;
      g9[done] = v3.done;
    }
    group g11 {
      b10.in = v3.out;
      b10.write_en = 1'd1;
      g11[done] = b10.done;
    }
    group g12 {
      spiral_ret.in = 32'd1;
      spiral_ret.write_en = 1'd1;
      g12[done] = spiral_ret.done;
    }
    group g13 {
      spiral_ret.in = 32'd0;
      spiral_ret.write_en = 1'd1;
      g13[done] = spiral_ret.done;
    }
    out = spiral_ret.out;
  }
  control {
    seq {
      g1;
      g3;
      g5;
      if b4.out {
        seq {
          g6;
        }
      } else {
        seq {
          g8;
          g9;
        }
      };
      g11;
      if b10.out {
        seq {
          g12;
        }
      } else {
        seq {
          g13;
        }
      };
    }
  }
}
component main() -> () {
  cells {
    @external spiral_io = comb_mem_d1(32, 1, 1);
    entry = spiral_main();
  }
  wires {
    group spiral_store {
      spiral_io.addr0 = 1'd0;
      spiral_io.write_en = 1'd1;
      spiral_io.write_data = entry.out;
      spiral_store[done] = spiral_io.done;
    }
  }
  control {
    seq {
      invoke entry()();
      spiral_store;
    }
  }
}
