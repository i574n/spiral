inl rec try_item i = function
    | Cons (x, _) when i = 0 => Some x
    | Cons (_, xs) => try_item (i - 1) xs
    | Nil => None

inl main () : i32 =
    inl ~a = 40i32
    inl ~b = 42i32
    inl ~c = 44i32
    inl xs = Cons (a, Cons (b, Cons (c, Nil)))
    match try_item 1i32 xs with
    | Some x => x - 42
    | None => 1
