:= ^ listm_try_item_verbatim i = \|
    | Cons (x, _) ?& i = 0 => Some x
    | Cons (_, xs) => listm_try_item_verbatim (i - 1) xs
    | Nil => None

:= main () : i32 =
    := ~a = 40i32
    := ~b = 42i32
    := ~c = 44i32
    := xs = Cons (a, Cons (b, Cons (c, Nil)))
    ?= listm_try_item_verbatim 1i32 xs ?|
    | Some x => x - 42
    | None => 1
