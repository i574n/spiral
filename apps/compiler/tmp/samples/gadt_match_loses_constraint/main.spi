:| ^ length_zero = | LengthZero
:! length_succ n = n

:| ^ vec a n =
    | VecNil :: \* a. vec a length_zero
    | VecCons :: \* a n. a * vec a n -> vec a (length_succ n)

:? eq_like a : a -> a -> bool
:! num = i32
:+ eq_like num = \ (num a) (num b) => !!!!EQ(a, b)

:= ^ contains \* a {eq_like} n. (value : a) (values : vec a n) : bool =
    ?= values ?|
    | VecNil => !-
    | VecCons (head, tail) => ? eq_like value head ?> !+ |: contains value tail

:= main () : i32 =
    := values : vec num (length_succ length_zero) = VecCons (num 1i32, VecNil)
    ? contains (num 1i32) values ?> 0i32 |: 1i32

:= oracle_must_not_record_current_error () = ()
