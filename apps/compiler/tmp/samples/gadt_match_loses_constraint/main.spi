// FOR-D repro (lane G, 2026-10-06): matching a GADT constructor that quantifies the element type itself
// (`VecCons :: forall a n. ...`) inside a function constrained on that type (`forall a {eq_like}`) types the payload
// with the constructor's fresh variable, which lacks the constraint: "Metavariable's constraints must be a subset of
// the forall var 'ta's. Got: {eq_like} Expected: {}" at the pattern, and "Got: a Expected: 'ta" at the use. The
// refinement a = 'ta is known from the scrutinee's type. Workaround in mega_brzozowski_derivatives: capture the
// operation as a function value before the match. Expected: exit 0. Not blessed.
union rec length_zero = | LengthZero
nominal length_succ n = n

union rec vec a n =
    | VecNil :: forall a. vec a length_zero
    | VecCons :: forall a n. a * vec a n -> vec a (length_succ n)

prototype eq_like a : a -> a -> bool
nominal num = i32
instance eq_like num = fun (num a) (num b) => !!!!EQ(a, b)

inl rec contains forall a {eq_like} n. (value : a) (values : vec a n) : bool =
    match values with
    | VecNil => false
    | VecCons (head, tail) => if eq_like value head then true else contains value tail

inl main () : i32 =
    inl values : vec num (length_succ length_zero) = VecCons (num 1i32, VecNil)
    if contains (num 1i32) values then 0i32 else 1i32
