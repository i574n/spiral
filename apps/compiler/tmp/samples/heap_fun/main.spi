inl main () : i32 =
    inl ~k = 3i32
    inl ~n = 4i32
    inl add (x : i32) : i32 = x +. k
    inl pair = add, n
    inl box = !!!!LayoutToHeap({ value = pair })
    inl opened = !!!!LayoutIndex(box)
    inl ~(f, extra) = opened.value
    inl ~g = f
    if g 0i32 +. extra =. 7i32 then 0i32 else 1i32
