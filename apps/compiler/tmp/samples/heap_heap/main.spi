:= main () : i32 =
    := ~n = 7i32
    := ~word = "hi"
    := inner_pair = n, word
    := inner = !!!!LayoutToHeap({ value = inner_pair })
    := ~extra = 1i32
    := outer_pair = inner, extra
    := outer = !!!!LayoutToHeap({ value = outer_pair })
    := opened = !!!!LayoutIndex(outer)
    := ~(held, count) = opened::value
    := inner_opened = !!!!LayoutIndex(held)
    := ~(left, right) = inner_opened::value
    ? left =. 7i32 && !!!!EQ(right, "hi") && count =. 1i32 ?> 0i32 |: 1i32
