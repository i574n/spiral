inl main () : i32 =
    inl ~n = 7i32
    inl ~word = "hi"
    inl ~flag = true
    inl trip = n, word, flag
    inl box = !!!!LayoutToHeap({value = trip})
    inl opened = !!!!LayoutIndex(box)
    inl ~(left, mid, right) = opened.value
    if left =. 7i32 && !!!!EQ(mid, "hi") && right then 0i32 else 1i32
