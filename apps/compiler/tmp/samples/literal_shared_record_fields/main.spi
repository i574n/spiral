:== tally = { report : string; failures : string; count : i32 }

:~ ^ run (n : i32) (t : tally) : tally =
    ? n <= 0i32 ?> t
    |: run (n -. 1i32) { report = t::failures; failures = "y"; count = t::count +. 1i32 }

:= main () : i32 =
    := t = run 5i32 { report = ""; failures = ""; count = 0i32 }
    t::count -. 5i32
