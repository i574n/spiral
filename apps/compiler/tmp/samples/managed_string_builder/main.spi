:= ^ build_abcabc ~count (value : string) : string =
    ? count =. 0i32 ?> value
    |:
        := piece = ? count %. 2i32 =. 0i32 ?> "ab" |: "c"
        ~~ build_abcabc (count -. 1i32) (sm::concat value piece)

:= main () =
    := value = ~~ build_abcabc 4i32 ""
    ? (=.) (sm::length value : i32) 6i32 ?>
        ? (=.) (sm::index value 0i32) 'a' ?>
            ? (=.) (sm::index value 5i32) 'c' ?> 0i32 |: 1i32
        |: 2i32
    |: 3i32
