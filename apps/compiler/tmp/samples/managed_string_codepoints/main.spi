:= main () =
    := value = "Aéλ🙂Z"
    := count = sm::codepoint_length value
    := second = sm::codepoint_index value 1i32
    := fourth = sm::codepoint_index value 3i32
    := middle = sm::codepoint_slice value { from = 1i32; to = 3i32 }
    := fourth_offset = sm::codepoint_byte_offset value 3i32
    := second_head = sm::runtime_byte second 0i32
    := expected_second_head = sm::runtime_byte "é" 0i32
    := fourth_tail = sm::runtime_byte fourth 3i32
    := expected_fourth_tail = sm::runtime_byte "🙂" 3i32
    ? (=.) count 5i32 ?>
        ? (=.) (sm::length second : i32) 2i32 ?>
            ? (=.) second_head expected_second_head ?>
                ? (=.) (sm::length fourth : i32) 4i32 ?>
                    ? (=.) fourth_tail expected_fourth_tail ?>
                        ? (=.) (sm::length middle : i32) 8i32 ?>
                            ? (=.) fourth_offset 5i32 ?> 0i32 |: 1i32
                        |: 2i32
                    |: 3i32
                |: 4i32
            |: 5i32
        |: 6i32
    |: 7i32
