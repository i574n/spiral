:< main

:~ ^ antimirov_insert_unique \* alphabet {symbol_compare}.
    (value : regex alphabet)
    (values : regex_list alphabet)
    : regex_list alphabet =
    := normalized = normalize value
    ? regex_list_contains normalized values ?> values
    |: RegexListCons (normalized, values)

:~ ^ antimirov_union \* alphabet {symbol_compare}.
    (left : regex_list alphabet)
    (right : regex_list alphabet)
    : regex_list alphabet =
    ?= left ?|
    | RegexListNil => right
    | RegexListCons (head, tail) =>
        antimirov_union tail (antimirov_insert_unique head right)

:~ ^ antimirov_map_cat_right \* alphabet {symbol_compare}.
    (values : regex_list alphabet)
    (right : regex alphabet)
    : regex_list alphabet =
    ?= values ?|
    | RegexListNil => RegexListNil
    | RegexListCons (head, tail) =>
        antimirov_insert_unique
            (make_cat head right)
            (antimirov_map_cat_right tail right)

:~ ^ antimirov_partial_derivative \* alphabet {symbol_compare}.
    (value : regex alphabet)
    (symbol : alphabet)
    : regex_list alphabet =
    ?= value ?|
    | RegexEmpty => RegexListNil
    | RegexEpsilon => RegexListNil
    | RegexChar expected =>
        ? symbol_equal expected symbol ?> RegexListCons (RegexEpsilon, RegexListNil)
        |: RegexListNil
    | RegexAlt (left, right) =>
        antimirov_union
            (antimirov_partial_derivative left symbol)
            (antimirov_partial_derivative right symbol)
    | RegexCat (left, right) =>
        := left_terms =
            antimirov_map_cat_right
                (antimirov_partial_derivative left symbol)
                right
        ?= nullable left ?|
        | Nullable => antimirov_union left_terms (antimirov_partial_derivative right symbol)
        | NonNullable => left_terms
    | RegexStar body =>
        antimirov_map_cat_right
            (antimirov_partial_derivative body symbol)
            (RegexStar body)

:~ ^ antimirov_partial_state_step \* alphabet {symbol_compare}.
    (state : regex_list alphabet)
    (symbol : alphabet)
    : regex_list alphabet =
    ?= state ?|
    | RegexListNil => RegexListNil
    | RegexListCons (head, tail) =>
        antimirov_union
            (antimirov_partial_derivative head symbol)
            (antimirov_partial_state_step tail symbol)

:~ ^ antimirov_state_regex \* alphabet {symbol_compare}.
    (state : regex_list alphabet) : regex alphabet =
    ?= state ?|
    | RegexListNil => RegexEmpty
    | RegexListCons (head, tail) => make_alt head (antimirov_state_regex tail)

:~ ^ antimirov_subset \* alphabet {symbol_compare}.
    (left : regex_list alphabet)
    (right : regex_list alphabet)
    : bool =
    ?= left ?|
    | RegexListNil => !+
    | RegexListCons (head, tail) =>
        ? regex_list_contains (normalize head) right ?> antimirov_subset tail right
        |: !-

:~ ^ antimirov_residual_support \* alphabet {symbol_compare}.
    (value : regex alphabet)
    : regex_list alphabet =
    ?= value ?|
    | RegexEmpty => RegexListNil
    | RegexEpsilon => RegexListNil
    | RegexChar _ => RegexListCons (RegexEpsilon, RegexListNil)
    | RegexAlt (left, right) =>
        antimirov_union
            (antimirov_residual_support left)
            (antimirov_residual_support right)
    | RegexCat (left, right) =>
        antimirov_union
            (antimirov_map_cat_right (antimirov_residual_support left) right)
            (antimirov_residual_support right)
    | RegexStar body =>
        antimirov_map_cat_right
            (antimirov_residual_support body)
            (RegexStar body)

:= antimirov_support \* alphabet {symbol_compare}.
    (value : regex alphabet) : regex_list alphabet =
    := normalized = normalize value
    antimirov_insert_unique normalized (antimirov_residual_support normalized)

:~ ^ antimirov_origin_append \* alphabet.
    (left : regex_list alphabet)
    (right : regex_list alphabet)
    : regex_list alphabet =
    ?= left ?|
    | RegexListNil => right
    | RegexListCons (head, tail) =>
        RegexListCons (head, antimirov_origin_append tail right)

:~ ^ antimirov_origin_map_cat_right \* alphabet {symbol_compare}.
    (values : regex_list alphabet)
    (right : regex alphabet)
    : regex_list alphabet =
    ?= values ?|
    | RegexListNil => RegexListNil
    | RegexListCons (head, tail) =>
        RegexListCons (
            normalize (make_cat head right),
            antimirov_origin_map_cat_right tail right)

:~ ^ antimirov_position_origins \* alphabet {symbol_compare}.
    (value : regex alphabet)
    : regex_list alphabet =
    ?= value ?|
    | RegexEmpty => RegexListNil
    | RegexEpsilon => RegexListNil
    | RegexChar _ => RegexListCons (RegexEpsilon, RegexListNil)
    | RegexAlt (left, right) =>
        antimirov_origin_append
            (antimirov_position_origins left)
            (antimirov_position_origins right)
    | RegexCat (left, right) =>
        antimirov_origin_append
            (antimirov_origin_map_cat_right (antimirov_position_origins left) right)
            (antimirov_position_origins right)
    | RegexStar body =>
        antimirov_origin_map_cat_right
            (antimirov_position_origins body)
            (RegexStar body)

:~ ^ regex_list_exact_budget \* alphabet.
    (values : regex_list alphabet)
    (budget : state_budget)
    : bool =
    ?= values, budget ?|
    | RegexListNil, StateBudgetZero => !+
    | RegexListCons (_, rest), StateBudgetSucc remaining =>
        regex_list_exact_budget rest remaining
    | _ => !-

:= antimirov_position_origin_candidate_valid \* alphabet {symbol_compare}.
    (value : regex alphabet)
    (origins : regex_list alphabet) : bool =
    := normalized = normalize value
    := structural_support = RegexListCons (normalized, origins)
    := residual_support = antimirov_residual_support normalized
    := support = antimirov_support normalized
    regex_list_distinct support &&
    antimirov_subset residual_support origins &&
    antimirov_subset origins residual_support &&
    antimirov_subset support structural_support &&
    regex_list_exact_budget origins (regex_position_count normalized) &&
    regex_list_exact_budget
        structural_support
        (StateBudgetSucc (regex_position_count normalized))

:= antimirov_structural_position_certificate \* alphabet {symbol_compare}.
    (value : regex alphabet) : bool =
    antimirov_position_origin_candidate_valid
        value
        (antimirov_position_origins (normalize value))



:= antimirov_partial_derivative_origin_supported \* alphabet {symbol_compare}.
    (value : regex alphabet)
    (symbol : alphabet) : bool =
    := normalized = normalize value
    antimirov_subset
        (antimirov_partial_derivative normalized symbol)
        (antimirov_position_origins normalized)

:~ ^ antimirov_partial_derivatives_origin_supported \* alphabet {symbol_compare}.
    (value : regex alphabet)
    (symbols : symbol_list alphabet) : bool =
    ?= symbols ?|
    | SymbolListNil => !+
    | SymbolListCons (symbol, rest) =>
        ? antimirov_partial_derivative_origin_supported value symbol ?>
            antimirov_partial_derivatives_origin_supported value rest
        |: !-



:= antimirov_partial_derivative_supported \* alphabet {symbol_compare}.
    (root : regex alphabet)
    (value : regex alphabet)
    (symbol : alphabet)
    : bool =
    antimirov_subset
        (antimirov_partial_derivative (normalize value) symbol)
        (antimirov_support root)

:~ ^ antimirov_value_supported_for_symbols \* alphabet {symbol_compare}.
    (root : regex alphabet)
    (value : regex alphabet)
    (symbols : symbol_list alphabet)
    : bool =
    ?= symbols ?|
    | SymbolListNil => !+
    | SymbolListCons (symbol, rest) =>
        ? antimirov_partial_derivative_supported root value symbol ?>
            antimirov_value_supported_for_symbols root value rest
        |: !-

:~ ^ antimirov_support_closed \* alphabet {symbol_compare}.
    (root : regex alphabet)
    (values : regex_list alphabet)
    (symbols : symbol_list alphabet)
    : bool =
    ?= values ?|
    | RegexListNil => !+
    | RegexListCons (value, rest) =>
        ? antimirov_value_supported_for_symbols root value symbols ?>
            antimirov_support_closed root rest symbols
        |: !-

:= antimirov_reconstruction_law \* alphabet {symbol_compare}.
    (value : regex alphabet)
    (symbol : alphabet)
    : bool =
    := normalized = normalize value
    regex_equal
        (normalize (antimirov_state_regex (antimirov_partial_derivative normalized symbol)))
        (canonical_derivative normalized symbol)

:~ ^ antimirov_reconstruction_symbols \* alphabet {symbol_compare}.
    (value : regex alphabet)
    (symbols : symbol_list alphabet)
    : bool =
    ?= symbols ?|
    | SymbolListNil => !+
    | SymbolListCons (symbol, rest) =>
        ? antimirov_reconstruction_law value symbol ?>
            antimirov_reconstruction_symbols value rest
        |: !-

:= antimirov_certificate \* alphabet {symbol_compare; finite_alphabet}.
    (value : regex alphabet) : bool =
    := descriptor : finite_alphabet_descriptor alphabet = finite_alphabet ()
    := symbols = finite_alphabet_symbols descriptor
    := support = antimirov_support value
    finite_alphabet_descriptor_certified descriptor &&
    ? antimirov_structural_position_certificate value ?>
        ? antimirov_partial_derivatives_origin_supported value symbols ?>
            ? antimirov_support_closed value support symbols ?>
                antimirov_reconstruction_symbols value symbols
            |: !-
        |: !-
    |: !-

:~ ^ antimirov_corpus_certificate \* alphabet {symbol_compare; finite_alphabet}.
    (values : regex_list alphabet)
    : bool =
    ?= values ?|
    | RegexListNil => !+
    | RegexListCons (value, rest) =>
        ? antimirov_certificate value ?>
            antimirov_corpus_certificate rest
        |: !-

:! antimirov_certificate_program alphabet =
    capability_program regex matcher_check alphabet

:= capture_antimirov_certificate_program \* alphabet {symbol_compare; finite_alphabet}.
    (value : regex alphabet)
    : antimirov_certificate_program alphabet =
    := interpret (program_regex : regex alphabet) : matcher_check alphabet =
        matcher_check (antimirov_certificate program_regex)
    antimirov_certificate_program (capability_program_make value interpret)

:= run_antimirov_certificate_program \* alphabet.
    (program : antimirov_certificate_program alphabet)
    : matcher_check alphabet =
    ?= program ?|
    | antimirov_certificate_program generic_program => capability_program_run generic_program

:= antimirov_certificate_program_passes \* alphabet.
    (program : antimirov_certificate_program alphabet)
    : bool =
    matcher_check_value (run_antimirov_certificate_program program)

:! derivative_unchecked = ()
:! derivative_normalized = ()
:! derivative_verified = ()

:| derivative_pipeline alphabet phase =
    | DerivativeUnchecked :: \* alphabet.
        regex alphabet * alphabet ->
        derivative_pipeline alphabet derivative_unchecked
    | DerivativeNormalized :: \* alphabet.
        regex alphabet * alphabet ->
        derivative_pipeline alphabet derivative_normalized
    | DerivativeVerified :: \* alphabet.
        regex alphabet * alphabet * regex alphabet ->
        derivative_pipeline alphabet derivative_verified

:! derivative_normalization_capability alphabet = regex alphabet -> regex alphabet

:= derivative_normalization_capability_default \* alphabet {symbol_compare}.
    : derivative_normalization_capability alphabet =
    derivative_normalization_capability normalize

:= derivative_pipeline_begin \* alphabet.
    (value : regex alphabet)
    (symbol : alphabet)
    : derivative_pipeline alphabet derivative_unchecked =
    DerivativeUnchecked (value, symbol)

:= derivative_pipeline_normalize \* alphabet.
    (capability : derivative_normalization_capability alphabet)
    (state : derivative_pipeline alphabet derivative_unchecked)
    : derivative_pipeline alphabet derivative_normalized =
    ?= capability, state ?|
    | derivative_normalization_capability normalize_value, DerivativeUnchecked (value, symbol) =>
        DerivativeNormalized (normalize_value value, symbol)

:! derivative_verification_result alphabet = regex alphabet * bool
:! derivative_verification_capability alphabet =
    regex alphabet -> alphabet -> derivative_verification_result alphabet

:= derivative_verification_capability_default \* alphabet {symbol_compare; finite_alphabet}.
    : derivative_verification_capability alphabet =
    := verify (normalized : regex alphabet) (symbol : alphabet) : derivative_verification_result alphabet =
        := descriptor : finite_alphabet_descriptor alphabet = finite_alphabet ()
        := symbols = finite_alphabet_symbols descriptor
        := canonical = canonical_derivative normalized symbol
        := reference = normalize (reference_derivative normalized symbol)
        := reconstructed = normalize (antimirov_state_regex (antimirov_partial_derivative normalized symbol))
        := certified =
            finite_alphabet_descriptor_certified descriptor &&
            input_symbols_covered (InputCons (symbol, InputEmpty)) symbols &&
            antimirov_structural_position_certificate normalized &&
            antimirov_partial_derivative_origin_supported normalized symbol &&
            regex_equal canonical reference &&
            regex_equal canonical reconstructed
        derivative_verification_result (canonical, certified)
    derivative_verification_capability verify

:| derivative_pipeline_validation alphabet =
    | DerivativePipelineRejected
    | DerivativePipelineVerified : derivative_pipeline alphabet derivative_verified

:= derivative_pipeline_verify \* alphabet.
    (capability : derivative_verification_capability alphabet)
    (state : derivative_pipeline alphabet derivative_normalized)
    : derivative_pipeline_validation alphabet =
    ?= capability, state ?|
    | derivative_verification_capability verify, DerivativeNormalized (normalized, symbol) =>
        ?= verify normalized symbol ?|
        | derivative_verification_result (candidate, certified) =>
            ? certified ?> DerivativePipelineVerified (DerivativeVerified (normalized, symbol, candidate))
            |: DerivativePipelineRejected

:= derivative_pipeline_candidate \* alphabet.
    (state : derivative_pipeline alphabet derivative_verified) : regex alphabet =
    ?= state ?|
    | DerivativeVerified (_, _, candidate) => candidate

:| sealed_verified_derivative =
    | SealedVerifiedDerivative : (\? alphabet. derivative_pipeline alphabet derivative_verified)

:= seal_verified_derivative \* alphabet.
    (state : derivative_pipeline alphabet derivative_verified) : sealed_verified_derivative =
    SealedVerifiedDerivative (\? state)

:! derivative_pipeline_request alphabet = regex alphabet * alphabet
:! derivative_pipeline_program alphabet = capability_program derivative_pipeline_request matcher_check alphabet

:= capture_derivative_pipeline_program \* alphabet {symbol_compare; finite_alphabet}.
    (value : regex alphabet)
    (symbol : alphabet)
    : derivative_pipeline_program alphabet
    =
    := normalization : derivative_normalization_capability alphabet = derivative_normalization_capability_default
    := verification : derivative_verification_capability alphabet = derivative_verification_capability_default
    := interpret (request : derivative_pipeline_request alphabet) : matcher_check alphabet =
        ?= request ?|
        | derivative_pipeline_request (program_regex, program_symbol) =>
            := raw : derivative_pipeline alphabet derivative_unchecked =
                derivative_pipeline_begin program_regex program_symbol
            := normalized : derivative_pipeline alphabet derivative_normalized =
                derivative_pipeline_normalize normalization raw
            ?= derivative_pipeline_verify verification normalized ?|
            | DerivativePipelineRejected => matcher_check !-
            | DerivativePipelineVerified verified =>
                := _ = seal_verified_derivative verified
                matcher_check !+
    derivative_pipeline_program (capability_program_make (derivative_pipeline_request (value, symbol)) interpret)

:= run_derivative_pipeline_program \* alphabet.
    (program : derivative_pipeline_program alphabet) : matcher_check alphabet =
    ?= program ?|
    | derivative_pipeline_program generic_program => capability_program_run generic_program

:= derivative_pipeline_program_passes \* alphabet.
    (program : derivative_pipeline_program alphabet) : bool =
    matcher_check_value (run_derivative_pipeline_program program)

:= main () : string =
    := bit_descriptor : finite_alphabet_descriptor bit_alphabet = finite_alphabet ()
    := tri_descriptor : finite_alphabet_descriptor tri_alphabet = finite_alphabet ()
    := bit_symbols = finite_alphabet_symbols bit_descriptor
    := tri_symbols = finite_alphabet_symbols tri_descriptor
    assert_static
        (finite_alphabet_descriptor_certified bit_descriptor)
        "Antimirov certificate requires the canonical bit finite-domain descriptor"
    assert_static
        (finite_alphabet_descriptor_certified tri_descriptor)
        "Antimirov certificate requires the canonical ternary finite-domain descriptor"

    assert_static
        (antimirov_certificate (ends_with_zero ()))
        "Brzozowski state must reconstruct from its Antimirov partial-derivative subset"
    := bit_position_source = normalize (ends_with_zero ())
    assert_static (
        ?= antimirov_position_origins bit_position_source ?|
        | RegexListNil => !-
        | RegexListCons (_, truncated) =>
            bool_same (regex_list_exact_budget truncated (regex_position_count bit_position_source)) !-
    ) "removing one concrete bit origin must violate the exact position count"
    assert_static (
        ?= antimirov_position_origins bit_position_source ?|
        | RegexListNil => !-
        | RegexListCons (_, rest) =>
            := forged_same_count = RegexListCons (RegexEmpty, rest)
            bool_same
                (antimirov_position_origin_candidate_valid bit_position_source forged_same_count)
                !-
    ) "a same-cardinality forged origin set must fail semantic origin validation"
    assert_static
        (antimirov_certificate (tri_a_star ()))
        "ternary star partial-derivative support must remain bounded and closed"
    assert_static
        (antimirov_certificate (tri_ab_star_then_c ()))
        "ternary concatenation/alt/star support must remain bounded and closed"
    := tri_position_source = normalize (tri_ab_star_then_c ())
    assert_static (
        ?= antimirov_position_origins tri_position_source ?|
        | RegexListNil => !-
        | RegexListCons (_, truncated) =>
            bool_same (regex_list_exact_budget truncated (regex_position_count tri_position_source)) !-
    ) "removing one concrete ternary origin must violate the exact position count"

    := bit_corpus = regex_corpus_depth_one bit_symbols
    := tri_corpus = regex_corpus_depth_one tri_symbols
    assert_static
        (antimirov_corpus_certificate bit_corpus)
        "depth-one bit corpus must satisfy Antimirov reconstruction, support closure and positions-plus-one bound"
    assert_static
        (antimirov_corpus_certificate tri_corpus)
        "depth-one ternary corpus must satisfy Antimirov reconstruction, support closure and positions-plus-one bound"

    := program_batch : matcher_batch antimirov_certificate_program (bit_alphabet * tri_alphabet) =
        MatchBatchPair (
            MatchBatchSingle (capture_antimirov_certificate_program (ends_with_zero ())),
            MatchBatchSingle (capture_antimirov_certificate_program (tri_ab_star_then_c ())))
    assert_static
        (matcher_batch_forall `$antimirov_certificate_program_passes program_batch)
        "higher-ranked Antimirov programs must execute alphabet-indexed certificates without erasing their family"

    := derivative_pipeline_batch : matcher_batch derivative_pipeline_program (bit_alphabet * tri_alphabet) =
        MatchBatchPair (
            MatchBatchSingle (capture_derivative_pipeline_program (RegexStar (RegexChar (zero ()))) (zero ())),
            MatchBatchSingle (capture_derivative_pipeline_program (tri_a_star ()) (tri_a ())))
    assert_static
        (matcher_batch_forall `$derivative_pipeline_program_passes derivative_pipeline_batch)
        "higher-ranked derivative programs must enforce normalize-then-verify before sealing across alphabets"

    := rejecting_bit_normalization : derivative_normalization_capability bit_alphabet =
        derivative_normalization_capability_default
    := rejecting_bit_raw : derivative_pipeline bit_alphabet derivative_unchecked =
        derivative_pipeline_begin (RegexStar (RegexChar (zero ()))) (zero ())
    := rejecting_bit_normalized : derivative_pipeline bit_alphabet derivative_normalized =
        derivative_pipeline_normalize rejecting_bit_normalization rejecting_bit_raw
    := rejecting_bit_verification : derivative_verification_capability bit_alphabet =
        derivative_verification_capability (\ normalized _ => derivative_verification_result (normalized, !-))
    assert_static (
        ?= derivative_pipeline_verify rejecting_bit_verification rejecting_bit_normalized ?|
        | DerivativePipelineRejected => !+
        | DerivativePipelineVerified _ => !-
    ) "a failed verification capability must not manufacture the verified derivative phase"

    "brzozowski-antimirov-certificate-green"

:== root_bit_alphabet = bit_alphabet
:= root_ends_with_zero () = ends_with_zero ()
:= root_zero () = zero ()
