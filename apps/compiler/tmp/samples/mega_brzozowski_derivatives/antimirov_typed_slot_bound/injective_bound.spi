:< main
:< positioned_bound
:< indexed_assignment

:| antimirov_injective_assignment_validation shape support_count =
    | AntimirovInjectiveAssignmentRejected :: \* shape support_count.
        antimirov_injective_assignment_validation shape support_count
    | AntimirovInjectiveAssignmentCertified :: \* shape support_count.
        antimirov_support_slot_assignment shape support_count ->
        antimirov_injective_assignment_validation shape support_count

:~ ^ antimirov_build_injective_support_slot_assignment \* alphabet {symbol_compare} shape support_count.
    (cat_capability : antimirov_slot_cat_capability alphabet)
    (equal_capability : antimirov_slot_equal_capability alphabet)
    (root : regex alphabet)
    (tree : antimirov_position_tree alphabet shape)
    (seen_values : regex_list alphabet)
    (support : antimirov_support_vector alphabet support_count)
    : antimirov_injective_assignment_validation shape support_count =
    ?= support ?|
    | AntimirovSupportVectorNil =>
        AntimirovInjectiveAssignmentCertified AntimirovSupportSlotAssignmentNil
    | AntimirovSupportVectorCons (head, rest) =>
        ?= antimirov_support_slot_find cat_capability equal_capability root head tree ?|
        | SupportSlotMissing => AntimirovInjectiveAssignmentRejected
        | SupportSlotFound slot =>
            ?= equal_capability ?|
            | antimirov_slot_equal_capability equal =>
                := slot_value =
                    antimirov_support_slot_value cat_capability root tree slot
                ? equal head slot_value &&
                   bool_same (regex_list_contains slot_value seen_values) !- ?>
                    ?= antimirov_build_injective_support_slot_assignment
                        cat_capability
                        equal_capability
                        root
                        tree
                        (RegexListCons (slot_value, seen_values))
                        rest ?|
                    | AntimirovInjectiveAssignmentRejected =>
                        AntimirovInjectiveAssignmentRejected
                    | AntimirovInjectiveAssignmentCertified assignment_rest =>
                        := assignment :
                            antimirov_support_slot_assignment shape (finite_length_succ support_count) =
                            AntimirovSupportSlotAssignmentCons (slot, assignment_rest)
                        AntimirovInjectiveAssignmentCertified assignment
                |:
                    AntimirovInjectiveAssignmentRejected

:~ ^ antimirov_support_list_same \* alphabet {symbol_compare}.
    (left : regex_list alphabet)
    (right : regex_list alphabet)
    : bool =
    ?= left, right ?|
    | RegexListNil, RegexListNil => !+
    | RegexListCons (left_head, left_rest), RegexListCons (right_head, right_rest) =>
        ? regex_equal left_head right_head ?>
            antimirov_support_list_same left_rest right_rest
        |:
            !-
    | _, _ => !-

:! antimirov_structural_support_bound alphabet shape support_count =
    antimirov_positioned_regex alphabet shape *
    antimirov_support_vector alphabet support_count *
    antimirov_support_slot_assignment shape support_count

:| antimirov_structural_support_bound_validation alphabet shape support_count =
    | AntimirovStructuralSupportBoundRejected :: \* alphabet shape support_count.
        antimirov_structural_support_bound_validation alphabet shape support_count
    | AntimirovStructuralSupportBoundCertified :: \* alphabet shape support_count.
        antimirov_structural_support_bound alphabet shape support_count ->
        antimirov_structural_support_bound_validation alphabet shape support_count

:= certify_antimirov_structural_support_bound_with_support \* alphabet {symbol_compare} shape support_count.
    (positioned : antimirov_positioned_regex alphabet shape)
    (support : antimirov_support_vector alphabet support_count)
    : antimirov_structural_support_bound_validation alphabet shape support_count =
    := tree = antimirov_positioned_regex_tree positioned
    := normalized = antimirov_positioned_regex_value positioned
    := cat_capability : antimirov_slot_cat_capability alphabet =
        antimirov_slot_cat_capability_default
    := equal_capability : antimirov_slot_equal_capability alphabet =
        antimirov_slot_equal_capability_default
    ? antimirov_support_list_same
        (antimirov_support_vector_to_list support)
        (antimirov_support normalized) ?>
        ?= antimirov_build_injective_support_slot_assignment
            cat_capability
            equal_capability
            normalized
            tree
            RegexListNil
            support ?|
        | AntimirovInjectiveAssignmentRejected =>
            AntimirovStructuralSupportBoundRejected
        | AntimirovInjectiveAssignmentCertified assignment =>
            AntimirovStructuralSupportBoundCertified
                (antimirov_structural_support_bound (positioned, support, assignment))
    |:
        AntimirovStructuralSupportBoundRejected

:= require_antimirov_structural_support_bound \* alphabet shape support_count.
    (_ : antimirov_structural_support_bound alphabet shape support_count)
    : bool = !+

:= structural_support_bound_assignment_is_aligned \* alphabet shape support_count.
    (antimirov_structural_support_bound (_, support, assignment) :
        antimirov_structural_support_bound alphabet shape support_count)
    : bool =
    require_support_assignment_alignment support assignment

:= bit_structural_support_bound_certificate ()
    : antimirov_structural_support_bound bit_alphabet bit_ends_with_zero_shape two_support_count =
    := positioned :
        antimirov_positioned_regex bit_alphabet bit_ends_with_zero_shape =
        antimirov_positioned_regex_from_tree (bit_ends_with_zero_position_tree ())
    ?= certify_antimirov_structural_support_bound_with_support
        positioned
        (two_bit_support_vector_for_certificate ()) ?|
    | AntimirovStructuralSupportBoundRejected =>
        failwith "bit-structural-support-bound-rejected"
    | AntimirovStructuralSupportBoundCertified certificate => certificate

:= tri_structural_support_bound_certificate ()
    : antimirov_structural_support_bound tri_alphabet tri_ab_star_then_c_shape two_support_count =
    := positioned :
        antimirov_positioned_regex tri_alphabet tri_ab_star_then_c_shape =
        antimirov_positioned_regex_from_tree (tri_ab_star_then_c_position_tree ())
    ?= certify_antimirov_structural_support_bound_with_support
        positioned
        (two_tri_support_vector_for_certificate ()) ?|
    | AntimirovStructuralSupportBoundRejected =>
        failwith "tri-structural-support-bound-rejected"
    | AntimirovStructuralSupportBoundCertified certificate => certificate

:= duplicate_bit_support_vector_for_rejection ()
    : antimirov_support_vector bit_alphabet two_support_count =
    := root = normalize (ends_with_zero ())
    AntimirovSupportVectorCons (
        root,
        AntimirovSupportVectorCons (
            root,
            AntimirovSupportVectorNil))

:= main () : string =
    assert_static
        (require_antimirov_structural_support_bound
            (bit_structural_support_bound_certificate ()))
        "bit support must have a structural root-plus-position injection witness"
    assert_static
        (require_antimirov_structural_support_bound
            (tri_structural_support_bound_certificate ()))
        "ternary support must have a structural root-plus-position injection witness"
    assert_static
        (structural_support_bound_assignment_is_aligned
            (bit_structural_support_bound_certificate ()))
        "bit structural bound must retain its exact-count assignment witness"
    assert_static
        (structural_support_bound_assignment_is_aligned
            (tri_structural_support_bound_certificate ()))
        "ternary structural bound must retain its exact-count assignment witness"
    := bit_positioned :
        antimirov_positioned_regex bit_alphabet bit_ends_with_zero_shape =
        antimirov_positioned_regex_from_tree (bit_ends_with_zero_position_tree ())
    ?= certify_antimirov_structural_support_bound_with_support
        bit_positioned
        (duplicate_bit_support_vector_for_rejection ()) ?|
    | AntimirovStructuralSupportBoundRejected => ()
    | AntimirovStructuralSupportBoundCertified _ =>
        failwith "duplicate-support-must-not-certify-structural-bound"
    ?= certify_antimirov_structural_support_bound_with_support
        bit_positioned
        (one_bit_support_vector_for_control ()) ?|
    | AntimirovStructuralSupportBoundRejected => ()
    | AntimirovStructuralSupportBoundCertified _ =>
        failwith "truncated-actual-support-must-not-certify-structural-bound"
    "brzozowski-antimirov-structural-support-bound-green"
