:! payload_zero = ()
:! payload_succ previous = previous

:| ^ payload_index count =
    | PayloadZero :: \* previous. payload_index (payload_succ previous)
    | PayloadSucc :: \* previous. payload_index previous -> payload_index (payload_succ previous)

:| ^ payload_row state_count symbol_count =
    | PayloadRowNil :: \* state_count. payload_row state_count payload_zero
    | PayloadRowCons :: \* state_count symbol_count.
        payload_index state_count * payload_row state_count symbol_count
        -> payload_row state_count (payload_succ symbol_count)

:= ^ payload_lookup \* state_count symbol_count.
    (symbol : payload_index symbol_count)
    (row : payload_row state_count symbol_count) : payload_index state_count =
    ?= symbol, row ?|
    | PayloadZero, PayloadRowCons (target, _) => target
    | PayloadSucc previous, PayloadRowCons (_, rest) => payload_lookup previous rest

:= payload_is_zero \* previous. (x : payload_index (payload_succ previous)) : bool =
    ?= x ?|
    | PayloadZero => !+
    | PayloadSucc _ => !-

:= main () : bool =
    := one : payload_index (payload_succ payload_zero) = PayloadZero
    := row : payload_row (payload_succ payload_zero) (payload_succ payload_zero) =
        PayloadRowCons (one, PayloadRowNil)
    := ~runtime_symbol = one
    := ~runtime_row = row
    payload_is_zero (payload_lookup runtime_symbol runtime_row)
