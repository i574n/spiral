:< main

:= main () : string =
    := bit_descriptor : indexed_finite_alphabet_descriptor bit_alphabet =
        indexed_finite_alphabet_descriptor_from_symbols
            (finite_alphabet_symbols (finite_alphabet ()))
    := bit_capability : indexed_dfa_capability bit_alphabet = make_indexed_dfa_capability ()
    assert_static
        (indexed_finite_alphabet_descriptor_certified bit_capability bit_descriptor)
        "generic bit inventory pack must certify"

    := tri_descriptor : indexed_finite_alphabet_descriptor tri_alphabet =
        indexed_finite_alphabet_descriptor_from_symbols
            (finite_alphabet_symbols (finite_alphabet ()))
    := tri_capability : indexed_dfa_capability tri_alphabet = make_indexed_dfa_capability ()
    assert_static
        (indexed_finite_alphabet_descriptor_certified tri_capability tri_descriptor)
        "generic ternary inventory pack must certify"

    "generic-inventory-pack-green"
