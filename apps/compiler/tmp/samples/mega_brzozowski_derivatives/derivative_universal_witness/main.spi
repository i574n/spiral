:< main

:| derivative_equation_cat_branch =
    | EquationCatNullable
    | EquationCatNonNullable

:= derivative_equation_cat_branch_of \* alphabet. (left : regex alphabet) : derivative_equation_cat_branch =
    ?= nullable left ?|
    | Nullable => EquationCatNullable
    | NonNullable => EquationCatNonNullable

:= derivative_equation_cat_branch_same
    (left : derivative_equation_cat_branch) (right : derivative_equation_cat_branch)
    : bool
    =
    ?= left, right ?|
    | EquationCatNullable, EquationCatNullable => !+
    | EquationCatNonNullable, EquationCatNonNullable => !+
    | _ => !-

:| ^ derivative_equation_proof alphabet =
    | DerivativeEquationProofEmpty : alphabet
    | DerivativeEquationProofEpsilon : alphabet
    | DerivativeEquationProofChar : alphabet * alphabet
    | DerivativeEquationProofAlt : alphabet * derivative_equation_proof alphabet * derivative_equation_proof alphabet
    | DerivativeEquationProofCat :
        alphabet *
        derivative_equation_cat_branch *
        derivative_equation_proof alphabet *
        derivative_equation_proof alphabet
    | DerivativeEquationProofStar : alphabet * derivative_equation_proof alphabet

:~ ^ derivative_equation_proof_source \* alphabet.
    (proof : derivative_equation_proof alphabet)
    : regex alphabet
    =
    ?= proof ?|
    | DerivativeEquationProofEmpty _ => RegexEmpty
    | DerivativeEquationProofEpsilon _ => RegexEpsilon
    | DerivativeEquationProofChar (expected, _) => RegexChar expected
    | DerivativeEquationProofAlt (_, left, right) =>
        RegexAlt (derivative_equation_proof_source left, derivative_equation_proof_source right)
    | DerivativeEquationProofCat (_, _, left, right) =>
        RegexCat (derivative_equation_proof_source left, derivative_equation_proof_source right)
    | DerivativeEquationProofStar (_, inner) => RegexStar (derivative_equation_proof_source inner)

:~ ^ derivative_equation_proof_symbol \* alphabet. (proof : derivative_equation_proof alphabet) : alphabet =
    ?= proof ?|
    | DerivativeEquationProofEmpty symbol => symbol
    | DerivativeEquationProofEpsilon symbol => symbol
    | DerivativeEquationProofChar (_, symbol) => symbol
    | DerivativeEquationProofAlt (symbol, _, _) => symbol
    | DerivativeEquationProofCat (symbol, _, _, _) => symbol
    | DerivativeEquationProofStar (symbol, _) => symbol

:= derivative_equation_proof_context_same \* alphabet {symbol_compare}.
    (parent : derivative_equation_proof alphabet) (child : derivative_equation_proof alphabet)
    : bool
    =
    symbol_equal (derivative_equation_proof_symbol parent) (derivative_equation_proof_symbol child)

:~ ^ derivative_equation_proof_make \* alphabet.
    (value : regex alphabet) (symbol : alphabet)
    : derivative_equation_proof alphabet
    =
    ?= value ?|
    | RegexEmpty => DerivativeEquationProofEmpty symbol
    | RegexEpsilon => DerivativeEquationProofEpsilon symbol
    | RegexChar expected => DerivativeEquationProofChar (expected, symbol)
    | RegexAlt (left, right) =>
        DerivativeEquationProofAlt (
            symbol,
            derivative_equation_proof_make left symbol,
            derivative_equation_proof_make right symbol
        )
    | RegexCat (left, right) =>
        DerivativeEquationProofCat (
            symbol,
            derivative_equation_cat_branch_of left,
            derivative_equation_proof_make left symbol,
            derivative_equation_proof_make right symbol
        )
    | RegexStar inner => DerivativeEquationProofStar (symbol, derivative_equation_proof_make inner symbol)

:~ ^ derivative_equation_proof_candidate \* alphabet {symbol_compare}.
    (proof : derivative_equation_proof alphabet)
    : regex alphabet
    =
    ?= proof ?|
    | DerivativeEquationProofEmpty _ => RegexEmpty
    | DerivativeEquationProofEpsilon _ => RegexEmpty
    | DerivativeEquationProofChar (expected, symbol) =>
        ? symbol_equal expected symbol
        ?> RegexEpsilon
        |: RegexEmpty
    | DerivativeEquationProofAlt (_, left, right) =>
        RegexAlt (derivative_equation_proof_candidate left, derivative_equation_proof_candidate right)
    | DerivativeEquationProofCat (_, branch, left, right) =>
        := left_candidate = derivative_equation_proof_candidate left
        := right_candidate = derivative_equation_proof_candidate right
        := right_source = derivative_equation_proof_source right
        ?= branch ?|
        | EquationCatNullable => RegexAlt (RegexCat (left_candidate, right_source), right_candidate)
        | EquationCatNonNullable => RegexCat (left_candidate, right_source)
    | DerivativeEquationProofStar (_, inner) =>
        RegexCat (derivative_equation_proof_candidate inner, RegexStar (derivative_equation_proof_source inner))

:~ ^ derivative_equation_proof_valid \* alphabet {symbol_compare}.
    (proof : derivative_equation_proof alphabet)
    : bool
    =
    := source = derivative_equation_proof_source proof
    := symbol = derivative_equation_proof_symbol proof
    := candidate = derivative_equation_proof_candidate proof
    := canonical = canonical_derivative source symbol
    := reference = normalize (reference_derivative source symbol)
    := local_equation =
        regex_equal (normalize candidate) canonical &&
        regex_equal (normalize candidate) reference &&
        canonical_derivative_coherent source symbol
    ? local_equation
    ?>
        ?= proof ?|
        | DerivativeEquationProofEmpty _ => !+
        | DerivativeEquationProofEpsilon _ => !+
        | DerivativeEquationProofChar _ => !+
        | DerivativeEquationProofAlt (_, left, right) =>
            derivative_equation_proof_context_same proof left
            && derivative_equation_proof_context_same proof right
            && derivative_equation_proof_valid left
            && derivative_equation_proof_valid right
        | DerivativeEquationProofCat (_, branch, left, right) =>
            derivative_equation_cat_branch_same branch (
                derivative_equation_cat_branch_of (derivative_equation_proof_source left)
            )
            && derivative_equation_proof_context_same proof left
            && derivative_equation_proof_context_same proof right
            && derivative_equation_proof_valid left
            && derivative_equation_proof_valid right
        | DerivativeEquationProofStar (_, inner) =>
            derivative_equation_proof_context_same proof inner && derivative_equation_proof_valid inner
    |: !-

:! derivative_equation_certificate alphabet = regex alphabet * alphabet * derivative_equation_proof alphabet

:= derivative_equation_certificate_make \* alphabet.
    (value : regex alphabet) (symbol : alphabet)
    : derivative_equation_certificate alphabet
    =
    derivative_equation_certificate (value, symbol, derivative_equation_proof_make value symbol)

:= derivative_equation_certificate_valid \* alphabet {symbol_compare}.
    (certificate : derivative_equation_certificate alphabet)
    : bool
    =
    ?= certificate ?|
    | derivative_equation_certificate (claimed_source, claimed_symbol, proof) =>
        ? regex_equal claimed_source (derivative_equation_proof_source proof)
        ?>
            ? symbol_equal claimed_symbol (derivative_equation_proof_symbol proof)
            ?> derivative_equation_proof_valid proof
            |: !-
        |: !-

:! derivative_universal_remainder_family alphabet = linear_input alphabet -> matcher_check alphabet

:= capture_derivative_universal_remainder_family \* alphabet {symbol_compare}.
    (value : regex alphabet) (symbol : alphabet)
    : derivative_universal_remainder_family alphabet
    =
    := certificate = derivative_equation_certificate_make value symbol
    := structure_valid = derivative_equation_certificate_valid certificate
    := candidate = canonical_derivative value symbol
    derivative_universal_remainder_family \ suffix =>
        matcher_check (
            ? structure_valid
            ?> derivative_remainder_candidate_law value symbol suffix candidate
            |: !-
        )

:= derivative_universal_remainder_family_check \* alphabet.
    (family : derivative_universal_remainder_family alphabet) (suffix : linear_input alphabet)
    : matcher_check alphabet
    =
    ?= family ?|
    | derivative_universal_remainder_family verify => verify suffix

:~ ^ derivative_universal_remainder_family_suffixes \* alphabet.
    (family : derivative_universal_remainder_family alphabet) (suffixes : input_list alphabet)
    : bool
    =
    ?= suffixes ?|
    | InputListNil => !+
    | InputListCons (suffix, rest) =>
        ? matcher_check_value (derivative_universal_remainder_family_check family suffix)
        ?> derivative_universal_remainder_family_suffixes family rest
        |: !-

:= main () : string =
    := bit_proof = derivative_equation_proof_make (ends_with_zero ()) (zero ())
    := tri_proof = derivative_equation_proof_make (tri_ab_star_then_c ()) (tri_a ())
    := bit_certificate = derivative_equation_certificate_make (ends_with_zero ()) (zero ())
    := tri_certificate = derivative_equation_certificate_make (tri_ab_star_then_c ()) (tri_a ())
    assert_static
        (derivative_equation_proof_valid bit_proof)
        "suffix-independent bit derivative equation proof must validate"
    assert_static
        (derivative_equation_proof_valid tri_proof)
        "suffix-independent ternary derivative equation proof must validate"
    assert_static
        (derivative_equation_certificate_valid bit_certificate)
        "bit derivative equation certificate must bind source and symbol"
    assert_static
        (derivative_equation_certificate_valid tri_certificate)
        "ternary derivative equation certificate must bind source and symbol"

    := bit_family = capture_derivative_universal_remainder_family (ends_with_zero ()) (zero ())
    := tri_family = capture_derivative_universal_remainder_family (tri_ab_star_then_c ()) (tri_a ())
    := bit_suffixes = input_corpus_depth_two (finite_alphabet_symbols (finite_alphabet ()))
    := tri_suffixes : input_list tri_alphabet = input_corpus_depth_two (finite_alphabet_symbols (finite_alphabet ()))
    assert_static
        (derivative_universal_remainder_family_suffixes bit_family bit_suffixes)
        "one bit structural certificate must instantiate over every finite suffix probe"
    assert_static
        (derivative_universal_remainder_family_suffixes tri_family tri_suffixes)
        "one ternary structural certificate must instantiate over every finite suffix probe"

    := ~bit_runtime_suffix = input_110 ()
    := ~tri_runtime_suffix = InputCons (tri_b (), InputCons (tri_c (), InputEmpty))
    assert_true (matcher_check_value (derivative_universal_remainder_family_check bit_family bit_runtime_suffix))
    assert_true (matcher_check_value (derivative_universal_remainder_family_check tri_family tri_runtime_suffix))

    := forged_equation_context : derivative_equation_proof bit_alphabet =
        DerivativeEquationProofAlt (
            zero (),
            DerivativeEquationProofChar (zero (), zero ()),
            DerivativeEquationProofChar (one (), one ()))
    := forged_equation_branch : derivative_equation_proof bit_alphabet =
        DerivativeEquationProofCat (
            zero (),
            EquationCatNonNullable,
            derivative_equation_proof_make RegexEpsilon (zero ()),
            derivative_equation_proof_make (RegexChar (zero ())) (zero ()))
    := forged_equation_source : derivative_equation_certificate bit_alphabet =
        derivative_equation_certificate (
            RegexEmpty,
            zero (),
            derivative_equation_proof_make RegexEpsilon (zero ()))
    assert_static
        (bool_same (derivative_equation_proof_valid forged_equation_context) !-)
        "a child proof from another symbol context must be rejected"
    assert_static
        (bool_same (derivative_equation_proof_valid forged_equation_branch) !-)
        "a forged nullable concatenation branch must be rejected"
    assert_static
        (bool_same (derivative_equation_certificate_valid forged_equation_source) !-)
        "a forged source binding must be rejected"

    "brzozowski-derivative-universal-witness-green"
