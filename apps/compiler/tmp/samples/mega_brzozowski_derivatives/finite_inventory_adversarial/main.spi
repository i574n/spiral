:< main

:| adversarial_symbol =
    | AdversarialLeft
    | AdversarialRight

:! adversarial_alphabet = adversarial_symbol

:+ symbol_compare adversarial_alphabet = \ (adversarial_alphabet left) (adversarial_alphabet right) =>
    ?= left, right ?|
    | AdversarialLeft, AdversarialLeft => SymbolSame
    | AdversarialLeft, AdversarialRight => SymbolLess
    | AdversarialRight, AdversarialLeft => SymbolGreater
    | AdversarialRight, AdversarialRight => SymbolSame

:= adversarial_symbols () : symbol_list adversarial_alphabet =
    SymbolListCons (
        adversarial_alphabet AdversarialLeft,
        SymbolListCons (adversarial_alphabet AdversarialRight, SymbolListNil))

:= adversarial_cardinality_one () : alphabet_cardinality =
    AlphabetCardinalitySucc AlphabetCardinalityZero

:= adversarial_cardinality_two () : alphabet_cardinality =
    AlphabetCardinalitySucc (AlphabetCardinalitySucc AlphabetCardinalityZero)

:= adversarial_cardinality_three () : alphabet_cardinality =
    AlphabetCardinalitySucc (
        AlphabetCardinalitySucc (
            AlphabetCardinalitySucc AlphabetCardinalityZero))

:= valid_descriptor () : finite_alphabet_descriptor adversarial_alphabet =
    finite_alphabet_descriptor (adversarial_symbols (), adversarial_cardinality_two ())

:+ finite_alphabet adversarial_alphabet = \ () => valid_descriptor ()

:= swapped_descriptor () : finite_alphabet_descriptor adversarial_alphabet =
    := symbols =
        SymbolListCons (
            adversarial_alphabet AdversarialRight,
            SymbolListCons (adversarial_alphabet AdversarialLeft, SymbolListNil))
    finite_alphabet_descriptor (symbols, adversarial_cardinality_two ())

:= short_descriptor () : finite_alphabet_descriptor adversarial_alphabet =
    := symbols = SymbolListCons (adversarial_alphabet AdversarialLeft, SymbolListNil)
    finite_alphabet_descriptor (symbols, adversarial_cardinality_two ())

:= self_consistent_short_descriptor () : finite_alphabet_descriptor adversarial_alphabet =
    := symbols = SymbolListCons (adversarial_alphabet AdversarialLeft, SymbolListNil)
    finite_alphabet_descriptor (symbols, adversarial_cardinality_one ())

:= long_cardinality_descriptor () : finite_alphabet_descriptor adversarial_alphabet =
    finite_alphabet_descriptor (adversarial_symbols (), adversarial_cardinality_three ())

:= duplicate_descriptor () : finite_alphabet_descriptor adversarial_alphabet =
    := symbols =
        SymbolListCons (
            adversarial_alphabet AdversarialLeft,
            SymbolListCons (adversarial_alphabet AdversarialLeft, SymbolListNil))
    finite_alphabet_descriptor (symbols, adversarial_cardinality_two ())

:= lookup_matches_descriptor () : bool =
    := descriptor = valid_descriptor ()
    ?= finite_alphabet_lookup descriptor AlphabetRankZero ?|
    | AlphabetRankFound first =>
        ?= symbol_compare first (adversarial_alphabet AdversarialLeft) ?|
        | SymbolSame =>
            ?= finite_alphabet_lookup descriptor (AlphabetRankSucc AlphabetRankZero) ?|
            | AlphabetRankFound second =>
                ?= symbol_compare second (adversarial_alphabet AdversarialRight) ?|
                | SymbolSame =>
                    ?= finite_alphabet_lookup descriptor (AlphabetRankSucc (AlphabetRankSucc AlphabetRankZero)) ?|
                    | AlphabetRankEnd => !+
                    | AlphabetRankFound _ => !-
                | _ => !-
            | AlphabetRankEnd => !-
        | _ => !-
    | AlphabetRankEnd => !-

:= main () : string =
    := valid = valid_descriptor ()
    assert_static
        (finite_alphabet_descriptor_certified valid)
        "ordered inventory with matching independent cardinality must certify"
    assert_static
        (lookup_matches_descriptor ())
        "rank lookup must be derived deterministically from the certified inventory"

    := swapped = swapped_descriptor ()
    assert_static
        (bool_same (finite_alphabet_descriptor_certified swapped) !-)
        "swapped descriptor inventory must fail canonical ordering"

    := short = short_descriptor ()
    assert_static
        (alphabet_inventory_well_formed (finite_alphabet_symbols short))
        "short inventory may be locally ordered"
    assert_static
        (bool_same (finite_alphabet_descriptor_certified short) !-)
        "cardinality must reject an inventory that omits a domain slot"

    := self_consistent_short = self_consistent_short_descriptor ()
    assert_static
        (
            symbol_list_cardinality_matches
                (finite_alphabet_symbols self_consistent_short)
                (adversarial_cardinality_one ())
        )
        "self-consistent short descriptor should demonstrate the old circularity"
    assert_static
        (bool_same (finite_alphabet_descriptor_certified self_consistent_short) !-)
        "canonical finite-domain authority must reject a self-consistent truncated descriptor"

    := long_cardinality = long_cardinality_descriptor ()
    assert_static
        (bool_same (finite_alphabet_descriptor_certified long_cardinality) !-)
        "cardinality must reject a descriptor claiming more slots than its inventory carries"

    := duplicate = duplicate_descriptor ()
    assert_static
        (bool_same (finite_alphabet_descriptor_certified duplicate) !-)
        "duplicate inventory values must not certify even when cardinality matches"

    := bit_descriptor : finite_alphabet_descriptor bit_alphabet = finite_alphabet ()
    assert_static
        (finite_alphabet_descriptor_certified bit_descriptor)
        "production bit descriptor must certify through list plus cardinality only"

    := forged : certified_alphabet_inventory adversarial_alphabet = certified_alphabet_inventory short
    := forged_runner_rejected =
        ?= dfa_run_certified RegexEpsilon forged InputEmpty ?|
        | DfaEscapedClosure => !+
        | _ => !-
    assert_static forged_runner_rejected
        "a publicly forged certified descriptor nominal must be revalidated by the runner"
    "brzozowski-finite-inventory-adversarial-green"
