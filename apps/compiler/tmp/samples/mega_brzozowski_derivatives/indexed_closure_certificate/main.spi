:< main

:! indexed_symbol_equality alphabet = alphabet -> alphabet -> bool

:= make_indexed_symbol_equality \* alphabet {symbol_compare}. () : indexed_symbol_equality alphabet =
    indexed_symbol_equality symbol_equal

:= indexed_regex_same \* alphabet.
    (capability : indexed_dfa_capability alphabet)
    (left : regex alphabet)
    (right : regex alphabet)
    : bool =
    ?= capability ?|
    | indexed_dfa_capability (_, _, contains, _, _, _) =>
        contains left (RegexListCons (right, RegexListNil))

:= ^ indexed_dfa_transition_vector_sound \* alphabet length.
    (capability : indexed_dfa_capability alphabet)
    (symbol_equality : indexed_symbol_equality alphabet)
    (closure : regex_list alphabet)
    (expected_source : regex alphabet)
    (symbols : finite_symbol_vector alphabet length)
    (values : indexed_dfa_transition_vector alphabet length)
    : bool
    =
    ?= symbols ?|
    | FiniteSymbolVectorNil =>
        ?= values ?|
        | IndexedDfaTransitionVectorNil => !+
    | FiniteSymbolVectorCons (expected_symbol, symbol_rest) =>
        ?= values ?|
        | IndexedDfaTransitionVectorCons (dfa_transition (source, actual_symbol, target), value_rest) =>
            ?= capability, symbol_equality ?|
            | indexed_dfa_capability (_, derive, contains, _, _, _), indexed_symbol_equality symbol_same =>
                := expected_target = derive expected_source expected_symbol
                ?
                    symbol_same actual_symbol expected_symbol
                    && indexed_regex_same capability source expected_source
                    && indexed_regex_same capability target expected_target
                    && contains target closure
                ?>
                    indexed_dfa_transition_vector_sound
                        capability
                        symbol_equality
                        closure
                        expected_source
                        symbol_rest
                        value_rest
                |: !-

:= ^ indexed_dfa_transition_rows_sound \* alphabet length.
    (capability : indexed_dfa_capability alphabet)
    (symbol_equality : indexed_symbol_equality alphabet)
    (closure : regex_list alphabet)
    (symbols : finite_symbol_vector alphabet length)
    (states : regex_list alphabet)
    (rows : indexed_dfa_transition_rows alphabet length)
    : bool =
    ?= states, rows ?|
    | RegexListNil, IndexedDfaTransitionRowsNil => !+
    | RegexListNil, IndexedDfaTransitionRowsCons _ => !-
    | RegexListCons _, IndexedDfaTransitionRowsNil => !-
    | RegexListCons (state, state_rest), IndexedDfaTransitionRowsCons (row, row_rest) =>
        ? indexed_dfa_transition_vector_sound capability symbol_equality closure state symbols row ?>
            indexed_dfa_transition_rows_sound capability symbol_equality closure symbols state_rest row_rest
        |: !-

:| indexed_sound_dfa_surface_validation =
    | IndexedSoundDfaSurfaceRejected
    | IndexedSoundDfaSurfaceCertified : (\? alphabet length. indexed_dfa_surface alphabet length)

:= seal_sound_indexed_dfa_surface \* alphabet.
    (capability : indexed_dfa_capability alphabet)
    (symbol_equality : indexed_symbol_equality alphabet)
    (start : regex alphabet)
    (descriptor : indexed_finite_alphabet_descriptor alphabet)
    : indexed_sound_dfa_surface_validation =
    ? indexed_finite_alphabet_descriptor_certified capability descriptor ?>
        ?= descriptor ?|
        | indexed_finite_alphabet_descriptor packed =>
            := \? length. symbols = packed
            := closure = indexed_dfa_closure_with_vector capability start symbols
            := rows = indexed_dfa_rows_from_states capability symbols closure
            ? indexed_dfa_transition_rows_sound capability symbol_equality closure symbols closure rows ?>
                IndexedSoundDfaSurfaceCertified (\? (
                    indexed_dfa_surface (start, closure, rows)))
            |: IndexedSoundDfaSurfaceRejected
    |: IndexedSoundDfaSurfaceRejected

:! indexed_dfa_sound_case alphabet =
    indexed_dfa_capability alphabet *
    indexed_symbol_equality alphabet *
    regex alphabet *
    indexed_finite_alphabet_descriptor alphabet
:! indexed_dfa_sound_check alphabet = bool
:! indexed_dfa_sound_program alphabet = capability_program indexed_dfa_sound_case indexed_dfa_sound_check alphabet

:= capture_indexed_dfa_sound_program \* alphabet.
    (capability : indexed_dfa_capability alphabet)
    (symbol_equality : indexed_symbol_equality alphabet)
    (start : regex alphabet)
    (descriptor : indexed_finite_alphabet_descriptor alphabet)
    : indexed_dfa_sound_program alphabet
    =
    := interpret (item : indexed_dfa_sound_case alphabet) : indexed_dfa_sound_check alphabet =
        ?= item ?|
        | indexed_dfa_sound_case (program_capability, program_symbol_equality, program_start, program_descriptor) =>
            ?=
                seal_sound_indexed_dfa_surface
                    program_capability
                    program_symbol_equality
                    program_start
                    program_descriptor
            ?|
            | IndexedSoundDfaSurfaceCertified _ => indexed_dfa_sound_check !+
            | IndexedSoundDfaSurfaceRejected => indexed_dfa_sound_check !-
    indexed_dfa_sound_program (
        capability_program_make
            (indexed_dfa_sound_case (capability, symbol_equality, start, descriptor))
            interpret)

:= run_indexed_dfa_sound_program \* alphabet.
    (program : indexed_dfa_sound_program alphabet) : indexed_dfa_sound_check alphabet =
    ?= program ?|
    | indexed_dfa_sound_program generic_program => capability_program_run generic_program

:= indexed_dfa_sound_program_passes \* alphabet.
    (program : indexed_dfa_sound_program alphabet) : bool =
    ?= run_indexed_dfa_sound_program program ?|
    | indexed_dfa_sound_check result => result

:= forged_target_bit_row () : indexed_dfa_transition_vector bit_alphabet bit_finite_length =
    := foreign_target = RegexStar (RegexChar (zero ()))
    IndexedDfaTransitionVectorCons (
        dfa_transition (ends_with_zero (), zero (), foreign_target),
        IndexedDfaTransitionVectorCons (
            dfa_transition (ends_with_zero (), one (), foreign_target),
            IndexedDfaTransitionVectorNil))

:= swapped_symbol_bit_row
    (capability : indexed_dfa_capability bit_alphabet)
    : indexed_dfa_transition_vector bit_alphabet bit_finite_length
    =
    ?= capability ?|
    | indexed_dfa_capability (_, derive, _, _, _, _) =>
        IndexedDfaTransitionVectorCons (
            dfa_transition (ends_with_zero (), one (), derive (ends_with_zero ()) (zero ())),
            IndexedDfaTransitionVectorCons (
                dfa_transition (ends_with_zero (), zero (), derive (ends_with_zero ()) (one ())),
                IndexedDfaTransitionVectorNil))

:= main () : string =
    := bit_capability : indexed_dfa_capability bit_alphabet = make_indexed_dfa_capability ()
    := bit_symbol_equality : indexed_symbol_equality bit_alphabet = make_indexed_symbol_equality ()
    := bit_descriptor = bit_indexed_finite_alphabet_descriptor ()
    := bit_closure = indexed_dfa_closure bit_capability (ends_with_zero ()) bit_descriptor
    := bit_symbols = bit_finite_symbol_vector ()
    := bit_rows = indexed_dfa_rows_from_states bit_capability bit_symbols bit_closure
    assert_static
        (
            indexed_dfa_transition_rows_sound
                bit_capability
                bit_symbol_equality
                bit_closure
                bit_symbols
                bit_closure
                bit_rows
        )
        "constructed bit indexed DFA rows must be source-symbol-target sound and closed"
    := forged_target_rows = IndexedDfaTransitionRowsCons (forged_target_bit_row (), IndexedDfaTransitionRowsNil)
    assert_static
        (
            bool_same
                (
                    indexed_dfa_transition_rows_sound
                        bit_capability
                        bit_symbol_equality
                        bit_closure
                        bit_symbols
                        bit_closure
                        forged_target_rows
                )
                !-
        )
        "out-of-closure or wrong-derivative target must fail soundness"
    := swapped_symbol_rows =
        IndexedDfaTransitionRowsCons (swapped_symbol_bit_row bit_capability, IndexedDfaTransitionRowsNil)
    assert_static
        (
            bool_same
                (
                    indexed_dfa_transition_rows_sound
                        bit_capability
                        bit_symbol_equality
                        bit_closure
                        bit_symbols
                        bit_closure
                        swapped_symbol_rows
                )
                !-
        )
        "row with swapped symbol positions must fail soundness"
    ?= seal_sound_indexed_dfa_surface bit_capability bit_symbol_equality (ends_with_zero ()) bit_descriptor ?|
    | IndexedSoundDfaSurfaceCertified _ => ()
    | IndexedSoundDfaSurfaceRejected => failwith "bit-sound-indexed-surface-must-certify"
    := tri_capability : indexed_dfa_capability tri_alphabet = make_indexed_dfa_capability ()
    := tri_symbol_equality : indexed_symbol_equality tri_alphabet = make_indexed_symbol_equality ()
    := tri_descriptor = tri_indexed_finite_alphabet_descriptor ()
    ?= seal_sound_indexed_dfa_surface tri_capability tri_symbol_equality (tri_ab_star_then_c ()) tri_descriptor ?|
    | IndexedSoundDfaSurfaceCertified _ => ()
    | IndexedSoundDfaSurfaceRejected => failwith "tri-sound-indexed-surface-must-certify"
    := sound_program_batch : matcher_batch indexed_dfa_sound_program (bit_alphabet * tri_alphabet) =
        MatchBatchPair (
            MatchBatchSingle (
                capture_indexed_dfa_sound_program bit_capability bit_symbol_equality (ends_with_zero ()) bit_descriptor
            ),
            MatchBatchSingle (
                capture_indexed_dfa_sound_program tri_capability tri_symbol_equality
                    (tri_ab_star_then_c ())
                    tri_descriptor
            )
        )
    assert_static
        (matcher_batch_forall `$indexed_dfa_sound_program_passes sound_program_batch)
        "higher-ranked DFA certificate programs must preserve alphabet-indexed soundness"
    "brzozowski-indexed-sound-dfa-certificate-green"
