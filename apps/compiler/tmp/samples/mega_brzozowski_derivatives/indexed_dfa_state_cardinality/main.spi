:< main
:< runtime_workload

:| ^ indexed_dfa_state_vector alphabet state_count =
    | IndexedDfaStateVectorNil :: \* alphabet.
        indexed_dfa_state_vector alphabet finite_length_zero
    | IndexedDfaStateVectorCons :: \* alphabet state_count.
        regex alphabet * indexed_dfa_state_vector alphabet state_count ->
        indexed_dfa_state_vector alphabet (finite_length_succ state_count)

:! packed_indexed_dfa_state_vector alphabet =
    \? state_count. indexed_dfa_state_vector alphabet state_count

:= ^ indexed_dfa_state_vector_pack \* alphabet.
    (states : regex_list alphabet) : packed_indexed_dfa_state_vector alphabet =
    ?= states ?|
    | RegexListNil =>
        packed_indexed_dfa_state_vector (\? IndexedDfaStateVectorNil)
    | RegexListCons (state, rest) =>
        ?= indexed_dfa_state_vector_pack rest ?|
        | packed_indexed_dfa_state_vector packed =>
            := \? state_count. state_rest = packed
            packed_indexed_dfa_state_vector (\? (
                IndexedDfaStateVectorCons (state, state_rest)))

:= ^ indexed_dfa_state_lookup \* alphabet state_count.
    (index : finite_symbol_index state_count)
    (states : indexed_dfa_state_vector alphabet state_count)
    : regex alphabet =
    ?= index, states ?|
    | FiniteSymbolIndexZero, IndexedDfaStateVectorCons (state, _) => state
    | FiniteSymbolIndexSucc previous, IndexedDfaStateVectorCons (_, rest) =>
        indexed_dfa_state_lookup previous rest

:| ^ indexed_dfa_exact_transition_rows alphabet symbol_count state_count =
    | IndexedDfaExactTransitionRowsNil :: \* alphabet symbol_count.
        indexed_dfa_exact_transition_rows alphabet symbol_count finite_length_zero
    | IndexedDfaExactTransitionRowsCons :: \* alphabet symbol_count state_count.
        indexed_dfa_transition_vector alphabet symbol_count *
        indexed_dfa_exact_transition_rows alphabet symbol_count state_count ->
        indexed_dfa_exact_transition_rows alphabet symbol_count (finite_length_succ state_count)

:= ^ indexed_dfa_exact_rows_from_states \* alphabet symbol_count state_count.
    (capability : indexed_dfa_capability alphabet)
    (symbols : finite_symbol_vector alphabet symbol_count)
    (states : indexed_dfa_state_vector alphabet state_count)
    : indexed_dfa_exact_transition_rows alphabet symbol_count state_count =
    ?= states ?|
    | IndexedDfaStateVectorNil => IndexedDfaExactTransitionRowsNil
    | IndexedDfaStateVectorCons (state, rest) =>
        IndexedDfaExactTransitionRowsCons (
            indexed_dfa_transitions_from_state capability state symbols,
            indexed_dfa_exact_rows_from_states capability symbols rest)

:= ^ indexed_dfa_exact_row_lookup \* alphabet symbol_count state_count.
    (index : finite_symbol_index state_count)
    (rows : indexed_dfa_exact_transition_rows alphabet symbol_count state_count)
    : indexed_dfa_transition_vector alphabet symbol_count =
    ?= index, rows ?|
    | FiniteSymbolIndexZero, IndexedDfaExactTransitionRowsCons (row, _) => row
    | FiniteSymbolIndexSucc previous, IndexedDfaExactTransitionRowsCons (_, rest) =>
        indexed_dfa_exact_row_lookup previous rest

:= indexed_dfa_state_row_shape_aligned \* alphabet symbol_count state_count.
    (_ : indexed_dfa_state_vector alphabet state_count)
    (_ : indexed_dfa_exact_transition_rows alphabet symbol_count state_count)
    : bool = !+

:! indexed_dfa_cardinality_surface alphabet symbol_count state_count =
    regex alphabet *
    indexed_dfa_state_vector alphabet state_count *
    indexed_dfa_exact_transition_rows alphabet symbol_count state_count

:| indexed_dfa_cardinality_surface_validation =
    | IndexedDfaCardinalitySurfaceRejected
    | IndexedDfaCardinalitySurfaceCertified :
        (\? alphabet symbol_count state_count.
            indexed_dfa_cardinality_surface alphabet symbol_count state_count)

:= seal_indexed_dfa_cardinality_surface \* alphabet.
    (capability : indexed_dfa_capability alphabet)
    (start : regex alphabet)
    (descriptor : indexed_finite_alphabet_descriptor alphabet)
    : indexed_dfa_cardinality_surface_validation =
    ? indexed_finite_alphabet_descriptor_certified capability descriptor ?>
        ?= descriptor ?|
        | indexed_finite_alphabet_descriptor packed_symbols =>
            := \? symbol_count. symbols = packed_symbols
            := closure = indexed_dfa_closure_with_vector capability start symbols
            ?= indexed_dfa_state_vector_pack closure ?|
            | packed_indexed_dfa_state_vector packed_states =>
                := \? state_count. states = packed_states
                := rows = indexed_dfa_exact_rows_from_states capability symbols states
                IndexedDfaCardinalitySurfaceCertified (\? (
                    indexed_dfa_cardinality_surface (start, states, rows)))
    |: IndexedDfaCardinalitySurfaceRejected

:= indexed_dfa_cardinality_surface_passes
    (validation : indexed_dfa_cardinality_surface_validation) : bool =
    ?= validation ?|
    | IndexedDfaCardinalitySurfaceRejected => !-
    | IndexedDfaCardinalitySurfaceCertified packed =>
        := \? alphabet symbol_count state_count. surface = packed
        ?= surface ?|
        | indexed_dfa_cardinality_surface (_, states, rows) =>
            indexed_dfa_state_row_shape_aligned states rows

:! indexed_dfa_cardinality_case alphabet =
    indexed_dfa_capability alphabet * regex alphabet * indexed_finite_alphabet_descriptor alphabet
:! indexed_dfa_cardinality_check alphabet = bool
:! indexed_dfa_cardinality_program alphabet =
    capability_program indexed_dfa_cardinality_case indexed_dfa_cardinality_check alphabet

:= capture_indexed_dfa_cardinality_program \* alphabet.
    (capability : indexed_dfa_capability alphabet)
    (start : regex alphabet)
    (descriptor : indexed_finite_alphabet_descriptor alphabet)
    : indexed_dfa_cardinality_program alphabet =
    := interpret (item : indexed_dfa_cardinality_case alphabet)
        : indexed_dfa_cardinality_check alphabet =
        ?= item ?|
        | indexed_dfa_cardinality_case (program_capability, program_start, program_descriptor) =>
            indexed_dfa_cardinality_check (
                indexed_dfa_cardinality_surface_passes (
                    seal_indexed_dfa_cardinality_surface
                        program_capability program_start program_descriptor))
    indexed_dfa_cardinality_program (
        capability_program_make
            (indexed_dfa_cardinality_case (capability, start, descriptor))
            interpret)

:= run_indexed_dfa_cardinality_program \* alphabet.
    (program : indexed_dfa_cardinality_program alphabet)
    : indexed_dfa_cardinality_check alphabet =
    ?= program ?|
    | indexed_dfa_cardinality_program generic_program =>
        capability_program_run generic_program

:= indexed_dfa_cardinality_program_passes \* alphabet.
    (program : indexed_dfa_cardinality_program alphabet) : bool =
    ?= run_indexed_dfa_cardinality_program program ?|
    | indexed_dfa_cardinality_check result => result

:! indexed_dfa_bisimulation_capability alphabet =
    (regex alphabet -> regex alphabet -> symbol_list alphabet -> bool) *
    (regex alphabet -> regex alphabet -> symbol_list alphabet -> dfa_constructive_distinguishing_result alphabet) *
    (
        regex alphabet ->
        regex alphabet ->
        symbol_list alphabet ->
        dfa_constructive_distinguishing_result alphabet ->
        bool
    )

:= indexed_dfa_bisimulation_capability_default \* alphabet {symbol_compare}.
    : indexed_dfa_bisimulation_capability alphabet =
    indexed_dfa_bisimulation_capability (
        (\ left right symbols => static_states_bisimilar left right symbols),
        (\ left right symbols => static_constructive_distinguishing_result left right symbols),
        (\ left right symbols result => static_constructive_distinguishing_result_valid left right symbols result))

:| indexed_dfa_representative_index_lookup representative_count =
    | IndexedDfaRepresentativeIndexMissing :: \* representative_count.
        indexed_dfa_representative_index_lookup representative_count
    | IndexedDfaRepresentativeIndexFound :: \* representative_count.
        finite_symbol_index representative_count ->
        indexed_dfa_representative_index_lookup representative_count

:= ^ indexed_dfa_find_representative_index \* alphabet representative_count.
    (bisimulation_capability : indexed_dfa_bisimulation_capability alphabet)
    (state : regex alphabet)
    (representatives : indexed_dfa_state_vector alphabet representative_count)
    (symbols : symbol_list alphabet)
    : indexed_dfa_representative_index_lookup representative_count
    =
    ?= bisimulation_capability, representatives ?|
    | indexed_dfa_bisimulation_capability (bisimilar, _, _), IndexedDfaStateVectorNil =>
        IndexedDfaRepresentativeIndexMissing
    | indexed_dfa_bisimulation_capability (bisimilar, _, _), IndexedDfaStateVectorCons (representative, rest) =>
        ? bisimilar state representative symbols ?>
            IndexedDfaRepresentativeIndexFound FiniteSymbolIndexZero
        |:
            ?= indexed_dfa_find_representative_index bisimulation_capability state rest symbols ?|
            | IndexedDfaRepresentativeIndexMissing => IndexedDfaRepresentativeIndexMissing
            | IndexedDfaRepresentativeIndexFound index =>
                IndexedDfaRepresentativeIndexFound (FiniteSymbolIndexSucc index)

:| ^ indexed_dfa_quotient_coverage closure_count representative_count =
    | IndexedDfaQuotientCoverageNil :: \* representative_count.
        indexed_dfa_quotient_coverage finite_length_zero representative_count
    | IndexedDfaQuotientCoverageCons :: \* closure_count representative_count.
        finite_symbol_index representative_count *
        indexed_dfa_quotient_coverage closure_count representative_count ->
        indexed_dfa_quotient_coverage (finite_length_succ closure_count) representative_count

:| indexed_dfa_quotient_coverage_validation closure_count representative_count =
    | IndexedDfaQuotientCoverageRejected :: \* closure_count representative_count.
        indexed_dfa_quotient_coverage_validation closure_count representative_count
    | IndexedDfaQuotientCoverageCertified :: \* closure_count representative_count.
        indexed_dfa_quotient_coverage closure_count representative_count ->
        indexed_dfa_quotient_coverage_validation closure_count representative_count

:= ^ indexed_dfa_build_quotient_coverage \* alphabet closure_count representative_count.
    (bisimulation_capability : indexed_dfa_bisimulation_capability alphabet)
    (closure : indexed_dfa_state_vector alphabet closure_count)
    (representatives : indexed_dfa_state_vector alphabet representative_count)
    (symbols : symbol_list alphabet)
    : indexed_dfa_quotient_coverage_validation closure_count representative_count =
    ?= closure ?|
    | IndexedDfaStateVectorNil =>
        IndexedDfaQuotientCoverageCertified IndexedDfaQuotientCoverageNil
    | IndexedDfaStateVectorCons (state, rest) =>
        ?= indexed_dfa_find_representative_index bisimulation_capability state representatives symbols ?|
        | IndexedDfaRepresentativeIndexMissing => IndexedDfaQuotientCoverageRejected
        | IndexedDfaRepresentativeIndexFound representative_index =>
            ?= indexed_dfa_build_quotient_coverage bisimulation_capability rest representatives symbols ?|
            | IndexedDfaQuotientCoverageRejected => IndexedDfaQuotientCoverageRejected
            | IndexedDfaQuotientCoverageCertified coverage_rest =>
                IndexedDfaQuotientCoverageCertified (
                    IndexedDfaQuotientCoverageCons (representative_index, coverage_rest))

:= ^ indexed_dfa_quotient_coverage_valid \* alphabet closure_count representative_count.
    (bisimulation_capability : indexed_dfa_bisimulation_capability alphabet)
    (closure : indexed_dfa_state_vector alphabet closure_count)
    (representatives : indexed_dfa_state_vector alphabet representative_count)
    (symbols : symbol_list alphabet)
    (coverage : indexed_dfa_quotient_coverage closure_count representative_count)
    : bool
    =
    ?= bisimulation_capability, closure, coverage ?|
    | indexed_dfa_bisimulation_capability (bisimilar, _, _), IndexedDfaStateVectorNil, IndexedDfaQuotientCoverageNil =>
        !+
    | indexed_dfa_bisimulation_capability (bisimilar, _, _),
        IndexedDfaStateVectorCons (state, state_rest),
        IndexedDfaQuotientCoverageCons (representative_index, coverage_rest)
        =>
            := representative = indexed_dfa_state_lookup representative_index representatives
            ? bisimilar state representative symbols
            ?>
                indexed_dfa_quotient_coverage_valid
                    bisimulation_capability
                    state_rest
                    representatives
                    symbols
                    coverage_rest
            |: !-

:| ^ indexed_dfa_representative_origins representative_count closure_count =
    | IndexedDfaRepresentativeOriginsNil :: \* closure_count.
        indexed_dfa_representative_origins finite_length_zero closure_count
    | IndexedDfaRepresentativeOriginsCons :: \* representative_count closure_count.
        finite_symbol_index closure_count *
        indexed_dfa_representative_origins representative_count closure_count ->
        indexed_dfa_representative_origins (finite_length_succ representative_count) closure_count

:| indexed_dfa_representative_origins_validation representative_count closure_count =
    | IndexedDfaRepresentativeOriginsRejected :: \* representative_count closure_count.
        indexed_dfa_representative_origins_validation representative_count closure_count
    | IndexedDfaRepresentativeOriginsCertified :: \* representative_count closure_count.
        indexed_dfa_representative_origins representative_count closure_count ->
        indexed_dfa_representative_origins_validation representative_count closure_count

:= ^ indexed_dfa_build_representative_origins \* alphabet representative_count closure_count.
    (bisimulation_capability : indexed_dfa_bisimulation_capability alphabet)
    (representatives : indexed_dfa_state_vector alphabet representative_count)
    (closure : indexed_dfa_state_vector alphabet closure_count)
    (symbols : symbol_list alphabet)
    : indexed_dfa_representative_origins_validation representative_count closure_count =
    ?= representatives ?|
    | IndexedDfaStateVectorNil =>
        IndexedDfaRepresentativeOriginsCertified IndexedDfaRepresentativeOriginsNil
    | IndexedDfaStateVectorCons (representative, rest) =>
        ?= indexed_dfa_find_representative_index bisimulation_capability representative closure symbols ?|
        | IndexedDfaRepresentativeIndexMissing => IndexedDfaRepresentativeOriginsRejected
        | IndexedDfaRepresentativeIndexFound closure_index =>
            ?= indexed_dfa_build_representative_origins bisimulation_capability rest closure symbols ?|
            | IndexedDfaRepresentativeOriginsRejected => IndexedDfaRepresentativeOriginsRejected
            | IndexedDfaRepresentativeOriginsCertified origin_rest =>
                IndexedDfaRepresentativeOriginsCertified (
                    IndexedDfaRepresentativeOriginsCons (closure_index, origin_rest))

:= ^ indexed_dfa_representative_origins_valid \* alphabet representative_count closure_count.
    (bisimulation_capability : indexed_dfa_bisimulation_capability alphabet)
    (representatives : indexed_dfa_state_vector alphabet representative_count)
    (closure : indexed_dfa_state_vector alphabet closure_count)
    (symbols : symbol_list alphabet)
    (origins : indexed_dfa_representative_origins representative_count closure_count)
    : bool
    =
    ?= bisimulation_capability, representatives, origins ?|
    | indexed_dfa_bisimulation_capability (bisimilar, _, _),
        IndexedDfaStateVectorNil,
        IndexedDfaRepresentativeOriginsNil
        => !+
    | indexed_dfa_bisimulation_capability (bisimilar, _, _),
        IndexedDfaStateVectorCons (representative, rest),
        IndexedDfaRepresentativeOriginsCons (closure_index, origin_rest)
        =>
            := origin = indexed_dfa_state_lookup closure_index closure
            ? bisimilar representative origin symbols ?>
                indexed_dfa_representative_origins_valid bisimulation_capability rest closure symbols origin_rest
            |: !-

:! indexed_dfa_minimized_surface alphabet symbol_count closure_count representative_count =
    regex alphabet *
    indexed_dfa_bisimulation_capability alphabet *
    finite_symbol_vector alphabet symbol_count *
    indexed_dfa_state_vector alphabet closure_count *
    indexed_dfa_state_vector alphabet representative_count *
    indexed_dfa_quotient_coverage closure_count representative_count *
    indexed_dfa_representative_origins representative_count closure_count *
    indexed_dfa_exact_transition_rows alphabet symbol_count representative_count

:| indexed_dfa_minimized_surface_validation =
    | IndexedDfaMinimizedSurfaceRejected
    | IndexedDfaMinimizedSurfaceCertified :
        (\? alphabet symbol_count closure_count representative_count.
            indexed_dfa_minimized_surface alphabet symbol_count closure_count representative_count)

:= seal_indexed_dfa_minimized_surface \* alphabet {symbol_compare; finite_alphabet}.
    (capability : indexed_dfa_capability alphabet)
    (start : regex alphabet)
    (descriptor : indexed_finite_alphabet_descriptor alphabet)
    : indexed_dfa_minimized_surface_validation
    =
    ? indexed_finite_alphabet_descriptor_certified capability descriptor
    ?>
        ?= descriptor ?|
        | indexed_finite_alphabet_descriptor packed_symbols =>
            := \? symbol_count. symbols = packed_symbols
            := symbol_list = finite_symbol_vector_to_list symbols
            := bisimulation_capability : indexed_dfa_bisimulation_capability alphabet =
                indexed_dfa_bisimulation_capability_default
            := closure_list = indexed_dfa_closure_with_vector capability start symbols
            := representative_list = static_minimize_states closure_list symbol_list
            ?
                static_minimal_by_bisimulation representative_list symbol_list
                && static_quotient_closed representative_list symbol_list representative_list
            ?>
                ?= indexed_dfa_state_vector_pack closure_list ?|
                | packed_indexed_dfa_state_vector packed_closure =>
                    := \? closure_count. closure = packed_closure
                    ?= indexed_dfa_state_vector_pack representative_list ?|
                    | packed_indexed_dfa_state_vector packed_representatives =>
                        := \? representative_count. representatives = packed_representatives
                        ?=
                            indexed_dfa_build_quotient_coverage
                                bisimulation_capability
                                closure
                                representatives
                                symbol_list
                        ?|
                        | IndexedDfaQuotientCoverageRejected => IndexedDfaMinimizedSurfaceRejected
                        | IndexedDfaQuotientCoverageCertified coverage =>
                            ?=
                                indexed_dfa_build_representative_origins
                                    bisimulation_capability
                                    representatives
                                    closure
                                    symbol_list
                            ?|
                            | IndexedDfaRepresentativeOriginsRejected => IndexedDfaMinimizedSurfaceRejected
                            | IndexedDfaRepresentativeOriginsCertified origins =>
                                := rows = indexed_dfa_exact_rows_from_states capability symbols representatives
                                IndexedDfaMinimizedSurfaceCertified (\? (
                                    indexed_dfa_minimized_surface (
                                        start,
                                        bisimulation_capability,
                                        symbols,
                                        closure,
                                        representatives,
                                        coverage,
                                        origins,
                                        rows)))
            |: IndexedDfaMinimizedSurfaceRejected
    |: IndexedDfaMinimizedSurfaceRejected

:= indexed_dfa_minimized_surface_passes \* alphabet symbol_count closure_count representative_count.
    (surface : indexed_dfa_minimized_surface alphabet symbol_count closure_count representative_count)
    : bool
    =
    ?= surface ?|
    | indexed_dfa_minimized_surface (
            _,
            bisimulation_capability,
            symbols,
            closure,
            representatives,
            coverage,
            origins,
            rows
        )
        =>
            indexed_dfa_state_row_shape_aligned representatives rows
            && indexed_dfa_quotient_coverage_valid bisimulation_capability closure representatives
                   (finite_symbol_vector_to_list symbols)
                   coverage
            && indexed_dfa_representative_origins_valid bisimulation_capability representatives closure
                   (finite_symbol_vector_to_list symbols)
                   origins

:| ^ indexed_dfa_acceptance_vector state_count =
    | IndexedDfaAcceptanceVectorNil :: indexed_dfa_acceptance_vector finite_length_zero
    | IndexedDfaAcceptanceVectorCons :: \* state_count.
        bool * indexed_dfa_acceptance_vector state_count ->
        indexed_dfa_acceptance_vector (finite_length_succ state_count)

:| ^ indexed_dfa_target_row symbol_count representative_count =
    | IndexedDfaTargetRowNil :: \* representative_count.
        indexed_dfa_target_row finite_length_zero representative_count
    | IndexedDfaTargetRowCons :: \* symbol_count representative_count.
        finite_symbol_index representative_count * indexed_dfa_target_row symbol_count representative_count ->
        indexed_dfa_target_row (finite_length_succ symbol_count) representative_count

:| ^ indexed_dfa_target_matrix symbol_count source_count representative_count =
    | IndexedDfaTargetMatrixNil :: \* symbol_count representative_count.
        indexed_dfa_target_matrix symbol_count finite_length_zero representative_count
    | IndexedDfaTargetMatrixCons :: \* symbol_count source_count representative_count.
        indexed_dfa_target_row symbol_count representative_count *
        indexed_dfa_target_matrix symbol_count source_count representative_count ->
        indexed_dfa_target_matrix symbol_count (finite_length_succ source_count) representative_count

:! indexed_dfa_compiled_core symbol_count representative_count =
    finite_symbol_index representative_count *
    indexed_dfa_acceptance_vector representative_count *
    indexed_dfa_target_matrix symbol_count representative_count representative_count

:= ^ indexed_dfa_acceptance_vector_build \* alphabet state_count.
    (states : indexed_dfa_state_vector alphabet state_count) : indexed_dfa_acceptance_vector state_count =
    ?= states ?|
    | IndexedDfaStateVectorNil => IndexedDfaAcceptanceVectorNil
    | IndexedDfaStateVectorCons (state, rest) =>
        IndexedDfaAcceptanceVectorCons (static_nullable state, indexed_dfa_acceptance_vector_build rest)

:| indexed_dfa_target_row_validation symbol_count representative_count =
    | IndexedDfaTargetRowRejected :: \* symbol_count representative_count.
        indexed_dfa_target_row_validation symbol_count representative_count
    | IndexedDfaTargetRowCertified :: \* symbol_count representative_count.
        indexed_dfa_target_row symbol_count representative_count ->
        indexed_dfa_target_row_validation symbol_count representative_count

:= ^ indexed_dfa_target_row_build \* alphabet symbol_count representative_count.
    (capability : indexed_dfa_capability alphabet)
    (bisimulation_capability : indexed_dfa_bisimulation_capability alphabet)
    (source : regex alphabet)
    (symbols : finite_symbol_vector alphabet symbol_count)
    (representatives : indexed_dfa_state_vector alphabet representative_count)
    (symbol_list : symbol_list alphabet)
    : indexed_dfa_target_row_validation symbol_count representative_count
    =
    ?= capability, symbols ?|
    | _, FiniteSymbolVectorNil => IndexedDfaTargetRowCertified IndexedDfaTargetRowNil
    | indexed_dfa_capability (_, derive, _, _, _, _), FiniteSymbolVectorCons (symbol, rest) =>
        := target = derive source symbol
        ?= indexed_dfa_find_representative_index bisimulation_capability target representatives symbol_list ?|
        | IndexedDfaRepresentativeIndexMissing => IndexedDfaTargetRowRejected
        | IndexedDfaRepresentativeIndexFound index =>
            ?=
                indexed_dfa_target_row_build capability bisimulation_capability source rest representatives symbol_list
            ?|
            | IndexedDfaTargetRowRejected => IndexedDfaTargetRowRejected
            | IndexedDfaTargetRowCertified row => IndexedDfaTargetRowCertified (IndexedDfaTargetRowCons (index, row))

:| indexed_dfa_target_matrix_validation symbol_count source_count representative_count =
    | IndexedDfaTargetMatrixRejected :: \* symbol_count source_count representative_count.
        indexed_dfa_target_matrix_validation symbol_count source_count representative_count
    | IndexedDfaTargetMatrixCertified :: \* symbol_count source_count representative_count.
        indexed_dfa_target_matrix symbol_count source_count representative_count ->
        indexed_dfa_target_matrix_validation symbol_count source_count representative_count

:= ^ indexed_dfa_target_matrix_build \* alphabet symbol_count source_count representative_count.
    (capability : indexed_dfa_capability alphabet)
    (bisimulation_capability : indexed_dfa_bisimulation_capability alphabet)
    (symbols : finite_symbol_vector alphabet symbol_count)
    (sources : indexed_dfa_state_vector alphabet source_count)
    (representatives : indexed_dfa_state_vector alphabet representative_count)
    (symbol_list : symbol_list alphabet)
    : indexed_dfa_target_matrix_validation symbol_count source_count representative_count
    =
    ?= sources ?|
    | IndexedDfaStateVectorNil => IndexedDfaTargetMatrixCertified IndexedDfaTargetMatrixNil
    | IndexedDfaStateVectorCons (source, rest) =>
        ?=
            indexed_dfa_target_row_build capability bisimulation_capability source symbols representatives symbol_list
        ?|
        | IndexedDfaTargetRowRejected => IndexedDfaTargetMatrixRejected
        | IndexedDfaTargetRowCertified row =>
            ?=
                indexed_dfa_target_matrix_build
                    capability
                    bisimulation_capability
                    symbols
                    rest
                    representatives
                    symbol_list
            ?|
            | IndexedDfaTargetMatrixRejected => IndexedDfaTargetMatrixRejected
            | IndexedDfaTargetMatrixCertified matrix =>
                IndexedDfaTargetMatrixCertified (IndexedDfaTargetMatrixCons (row, matrix))

:! indexed_dfa_compiled_runner alphabet symbol_count representative_count =
    (alphabet -> alphabet -> bool) *
    finite_symbol_vector alphabet symbol_count *
    indexed_dfa_compiled_core symbol_count representative_count

:! packed_indexed_dfa_compiled_runner alphabet =
    \? symbol_count representative_count. indexed_dfa_compiled_runner alphabet symbol_count representative_count

:| indexed_dfa_compiled_runner_validation alphabet =
    | IndexedDfaCompiledRunnerRejected
    | IndexedDfaCompiledRunnerCertified : packed_indexed_dfa_compiled_runner alphabet

:= seal_indexed_dfa_compiled_runner \* alphabet {symbol_compare; finite_alphabet}.
    (capability : indexed_dfa_capability alphabet)
    (start : regex alphabet)
    (descriptor : indexed_finite_alphabet_descriptor alphabet)
    : indexed_dfa_compiled_runner_validation alphabet
    =
    ? indexed_finite_alphabet_descriptor_certified capability descriptor
    ?>
        ?= descriptor ?|
        | indexed_finite_alphabet_descriptor packed_symbols =>
            := \? symbol_count. symbols = packed_symbols
            := symbol_list = finite_symbol_vector_to_list symbols
            := bisimulation_capability : indexed_dfa_bisimulation_capability alphabet =
                indexed_dfa_bisimulation_capability_default
            := closure_list = indexed_dfa_closure_with_vector capability start symbols
            := representative_list = static_minimize_states closure_list symbol_list
            ?
                static_states_have_representative closure_list representative_list symbol_list
                && static_minimal_by_bisimulation representative_list symbol_list
                && static_quotient_closed representative_list symbol_list representative_list
            ?>
                ?= indexed_dfa_state_vector_pack representative_list ?|
                | packed_indexed_dfa_state_vector packed_representatives =>
                    := \? representative_count. representatives = packed_representatives
                    ?=
                        indexed_dfa_find_representative_index bisimulation_capability start representatives symbol_list
                    ?|
                    | IndexedDfaRepresentativeIndexMissing => IndexedDfaCompiledRunnerRejected
                    | IndexedDfaRepresentativeIndexFound start_index =>
                        ?=
                            indexed_dfa_target_matrix_build
                                capability
                                bisimulation_capability
                                symbols
                                representatives
                                representatives
                                symbol_list
                        ?|
                        | IndexedDfaTargetMatrixRejected => IndexedDfaCompiledRunnerRejected
                        | IndexedDfaTargetMatrixCertified matrix =>
                            := core : indexed_dfa_compiled_core symbol_count representative_count =
                                indexed_dfa_compiled_core (
                                    start_index,
                                    indexed_dfa_acceptance_vector_build representatives,
                                    matrix
                                )
                            IndexedDfaCompiledRunnerCertified (packed_indexed_dfa_compiled_runner (\? (
                                indexed_dfa_compiled_runner (symbol_equal, symbols, core))))
            |: IndexedDfaCompiledRunnerRejected
    |: IndexedDfaCompiledRunnerRejected


:= ^ indexed_dfa_acceptance_vector_count \* state_count.
    (acceptance : indexed_dfa_acceptance_vector state_count)
    : i32
    =
    ?= acceptance ?|
    | IndexedDfaAcceptanceVectorNil => 0i32
    | IndexedDfaAcceptanceVectorCons (_, rest) => i32_add (indexed_dfa_acceptance_vector_count rest) 1i32

:= ^ finite_symbol_index_to_i32 \* count. (index : finite_symbol_index count) : i32 =
    ?= index ?|
    | FiniteSymbolIndexZero => 0i32
    | FiniteSymbolIndexSucc previous => i32_add (finite_symbol_index_to_i32 previous) 1i32

:= ^ indexed_dfa_acceptance_at \* state_count.
    (acceptance : indexed_dfa_acceptance_vector state_count) (state : i32) (index : i32) : bool =
    ?= acceptance ?|
    | IndexedDfaAcceptanceVectorNil => failwith "brzozowski-compiled-core-without-states"
    | IndexedDfaAcceptanceVectorCons (accepting, rest) =>
        ?= rest ?|
        | IndexedDfaAcceptanceVectorNil => accepting
        | _ => ? i32_eq state index ?> accepting |: indexed_dfa_acceptance_at rest state (i32_add index 1i32)

:= ^ indexed_dfa_row_target \* alphabet symbol_count representative_count.
    (equal : alphabet -> alphabet -> bool)
    (symbols : finite_symbol_vector alphabet symbol_count)
    (row : indexed_dfa_target_row symbol_count representative_count)
    (symbol : alphabet)
    : i32 =
    ?= symbols, row ?|
    | FiniteSymbolVectorCons (expected, symbol_rest), IndexedDfaTargetRowCons (target, row_rest) =>
        ?= symbol_rest ?|
        | FiniteSymbolVectorNil => finite_symbol_index_to_i32 target
        | _ =>
            ? equal symbol expected ?> finite_symbol_index_to_i32 target
            |: indexed_dfa_row_target equal symbol_rest row_rest symbol
    | _ => failwith "brzozowski-compiled-core-without-symbols"

:= ^ indexed_dfa_matrix_next \* alphabet symbol_count source_count representative_count.
    (equal : alphabet -> alphabet -> bool)
    (symbols : finite_symbol_vector alphabet symbol_count)
    (matrix : indexed_dfa_target_matrix symbol_count source_count representative_count)
    (state : i32)
    (index : i32)
    (symbol : alphabet)
    : i32 =
    ?= matrix ?|
    | IndexedDfaTargetMatrixNil => failwith "brzozowski-compiled-core-without-rows"
    | IndexedDfaTargetMatrixCons (row, rest) =>
        ?= rest ?|
        | IndexedDfaTargetMatrixNil => indexed_dfa_row_target equal symbols row symbol
        | _ =>
            ? i32_eq state index ?> indexed_dfa_row_target equal symbols row symbol
            |: indexed_dfa_matrix_next equal symbols rest state (i32_add index 1i32) symbol

:= indexed_dfa_compiled_runner_accepts \* alphabet symbol_count representative_count.
    (runner : indexed_dfa_compiled_runner alphabet symbol_count representative_count)
    (input : linear_input alphabet)
    : bool =
    ?= runner ?|
    | indexed_dfa_compiled_runner (equal, symbols, indexed_dfa_compiled_core (start_index, acceptance, matrix)) =>
        :~ ^ run (state : i32) (input : linear_input alphabet) : bool =
            ?= input ?|
            | InputEmpty => indexed_dfa_acceptance_at acceptance state 0i32
            | InputCons (symbol, rest) => run (indexed_dfa_matrix_next equal symbols matrix state 0i32 symbol) rest
        := ~start = finite_symbol_index_to_i32 start_index
        run start input

:= indexed_dfa_compiled_runner_state_count \* alphabet symbol_count representative_count.
    (runner : indexed_dfa_compiled_runner alphabet symbol_count representative_count) : i32 =
    ?= runner ?|
    | indexed_dfa_compiled_runner (_, _, indexed_dfa_compiled_core (_, acceptance, _)) =>
        indexed_dfa_acceptance_vector_count acceptance

:== one_state_count = finite_length_succ finite_length_zero
:== two_state_count = finite_length_succ (finite_length_succ finite_length_zero)

:= one_bit_state_for_control () : indexed_dfa_state_vector bit_alphabet one_state_count =
    IndexedDfaStateVectorCons (
        static_normalize (ends_with_zero ()),
        IndexedDfaStateVectorNil)

:= one_bit_row_for_negative ()
    : indexed_dfa_exact_transition_rows bit_alphabet bit_finite_length one_state_count =
    := capability : indexed_dfa_capability bit_alphabet = make_indexed_dfa_capability ()
    IndexedDfaExactTransitionRowsCons (
        indexed_dfa_transitions_from_state capability (ends_with_zero ()) (bit_finite_symbol_vector ()),
        IndexedDfaExactTransitionRowsNil)


:= one_coverage_for_two_representatives ()
    : indexed_dfa_quotient_coverage one_state_count two_state_count =
    IndexedDfaQuotientCoverageCons (
        FiniteSymbolIndexZero,
        IndexedDfaQuotientCoverageNil)

:= one_origin_for_two_closure ()
    : indexed_dfa_representative_origins one_state_count two_state_count =
    IndexedDfaRepresentativeOriginsCons (
        FiniteSymbolIndexZero,
        IndexedDfaRepresentativeOriginsNil)

:= require_exact_representative_origin_count \* alphabet representative_count closure_count.
    (representatives : indexed_dfa_state_vector alphabet representative_count)
    (origins : indexed_dfa_representative_origins representative_count closure_count)
    : bool = !+

:= require_exact_state_row_count \* alphabet symbol_count state_count.
    (states : indexed_dfa_state_vector alphabet state_count)
    (rows : indexed_dfa_exact_transition_rows alphabet symbol_count state_count)
    : bool =
    indexed_dfa_state_row_shape_aligned states rows

:= require_exact_quotient_coverage_count \* alphabet closure_count representative_count.
    (states : indexed_dfa_state_vector alphabet closure_count)
    (coverage : indexed_dfa_quotient_coverage closure_count representative_count)
    : bool = !+

:= two_bit_states () : indexed_dfa_state_vector bit_alphabet two_state_count =
    IndexedDfaStateVectorCons (
        static_normalize (ends_with_zero ()),
        IndexedDfaStateVectorCons (
            static_normalize RegexEmpty,
            IndexedDfaStateVectorNil))

:= second_state_index () : finite_symbol_index two_state_count =
    FiniteSymbolIndexSucc FiniteSymbolIndexZero

:= compiled_runner_random_count \* symbol_count representative_count.
    (runner : indexed_dfa_compiled_runner bit_alphabet symbol_count representative_count)
    (value : regex bit_alphabet)
    (count : i32)
    (length : i32)
    : i32 =
    := ~dynamic = value
    :~ ^ loop (count : i32) (seed : u64) (accepted : i32) : i32 =
        ? i32_lt 0i32 count ?>
            ?= random_bit_input seed length InputEmpty ?|
            | input, next =>
                := compiled = indexed_dfa_compiled_runner_accepts runner input
                ? bool_same compiled (accepts dynamic input) ?>
                    loop (i32_sub count 1i32) next (? compiled ?> i32_add accepted 1i32 |: accepted)
                |: failwith "brzozowski-compiled-core-disagrees-on-random-input"
        |: accepted
    := ~seed = 1u64
    := ~none = 0i32
    loop count seed none

:= compiled_runner_zero_runs \* symbol_count representative_count.
    (runner : indexed_dfa_compiled_runner bit_alphabet symbol_count representative_count)
    (value : regex bit_alphabet)
    (max : i32)
    : i32 =
    := ~dynamic = value
    := count_one (input : linear_input bit_alphabet) (accepted : i32) : i32 =
        := compiled = indexed_dfa_compiled_runner_accepts runner input
        ? bool_same compiled (accepts dynamic input) ?> (? compiled ?> i32_add accepted 1i32 |: accepted)
        |: failwith "brzozowski-compiled-core-disagrees-on-zero-run"
    :~ ^ loop (n : i32) (accepted : i32) : i32 =
        ? i32_lt max n ?> accepted
        |:
            := accepted = count_one (zeros_input n InputEmpty) accepted
            := accepted = count_one (zeros_input n (InputCons (one (), InputEmpty))) accepted
            loop (i32_add n 1i32) accepted
    := ~first = 1i32
    := ~none = 0i32
    loop first none

:| compiled_runner_workload =
    | CompiledRandom : i32 * i32
    | CompiledZeroRuns : i32

:= bit_compiled_runner_count
    (capability : indexed_dfa_capability bit_alphabet)
    (value : regex bit_alphabet)
    (representatives : i32)
    (workload : compiled_runner_workload)
    : i32 =
    ?= seal_indexed_dfa_compiled_runner capability value (bit_indexed_finite_alphabet_descriptor ()) ?|
    | IndexedDfaCompiledRunnerRejected => failwith "brzozowski-compiled-core-rejected"
    | IndexedDfaCompiledRunnerCertified packed_runner =>
        ?= packed_runner ?|
        | packed_indexed_dfa_compiled_runner packed =>
            := \? symbol_count representative_count. runner = packed
            assert_static
                (i32_eq (indexed_dfa_compiled_runner_state_count runner) representatives)
                "the compiled core must have the minimal number of states"
            ?= workload ?|
            | CompiledRandom (count, length) => compiled_runner_random_count runner value count length
            | CompiledZeroRuns max => compiled_runner_zero_runs runner value max

:= tri_compiled_runner_agrees (capability : indexed_dfa_capability tri_alphabet) : bool =
    ?=
        seal_indexed_dfa_compiled_runner capability (tri_ab_star_then_c ()) (tri_indexed_finite_alphabet_descriptor ())
    ?|
    | IndexedDfaCompiledRunnerRejected => !-
    | IndexedDfaCompiledRunnerCertified packed_runner =>
        ?= packed_runner ?|
        | packed_indexed_dfa_compiled_runner packed =>
            := \? symbol_count representative_count. runner = packed
            := ~value = tri_ab_star_then_c ()
            := ~accepted_input = input_abac ()
            := ~rejected_input = input_abab ()
            ? indexed_dfa_compiled_runner_accepts runner accepted_input && accepts value accepted_input ?>
                ? indexed_dfa_compiled_runner_accepts runner rejected_input ?> !-
                |? accepts value rejected_input ?> !-
                |: !+
            |: !-

:= expect_compiled_count (actual : i32) (expected : i32) (message : string) : () =
    ? i32_eq actual expected ?> () |: failwith message

:= main () : i32 =
    := bit_capability : indexed_dfa_capability bit_alphabet = make_indexed_dfa_capability ()
    := bit_symbols = bit_finite_symbol_vector ()
    := bit_states = two_bit_states ()
    := bit_rows = indexed_dfa_exact_rows_from_states bit_capability bit_symbols bit_states
    assert_static
        (indexed_dfa_state_row_shape_aligned bit_states bit_rows)
        "state vector and transition rows share one state-count index"
    := state_index = second_state_index ()
    := selected_state = indexed_dfa_state_lookup state_index bit_states
    := selected_row = indexed_dfa_exact_row_lookup state_index bit_rows
    ?= indexed_dfa_transition_lookup (bit_finite_index_zero ()) selected_row ?|
    | dfa_transition (row_source, _, _) =>
        assert_static
            (static_regex_equal selected_state row_source)
            "one typed state index must select the corresponding state and transition row"
    := bit_cardinality =
        seal_indexed_dfa_cardinality_surface bit_capability
            (ends_with_zero ())
            (bit_indexed_finite_alphabet_descriptor ())
    ?= bit_cardinality ?|
    | IndexedDfaCardinalitySurfaceRejected => failwith "bit indexed cardinality surface should certify"
    | IndexedDfaCardinalitySurfaceCertified packed =>
        := \? alphabet symbol_count state_count. surface = packed
        ?= surface ?|
        | indexed_dfa_cardinality_surface (_, states, rows) =>
            assert_static
                (indexed_dfa_state_row_shape_aligned states rows)
                "sealed bit surface must preserve exact state-row cardinality"
    := tri_capability : indexed_dfa_capability tri_alphabet = make_indexed_dfa_capability ()
    := tri_cardinality =
        seal_indexed_dfa_cardinality_surface tri_capability
            (tri_ab_star_then_c ())
            (tri_indexed_finite_alphabet_descriptor ())
    ?= tri_cardinality ?|
    | IndexedDfaCardinalitySurfaceRejected => failwith "ternary indexed cardinality surface should certify"
    | IndexedDfaCardinalitySurfaceCertified packed =>
        := \? alphabet symbol_count state_count. surface = packed
        ?= surface ?|
        | indexed_dfa_cardinality_surface (_, states, rows) =>
            assert_static
                (indexed_dfa_state_row_shape_aligned states rows)
                "sealed ternary surface must preserve exact state-row cardinality"
    := bit_minimized =
        seal_indexed_dfa_minimized_surface bit_capability
            (ends_with_zero ())
            (bit_indexed_finite_alphabet_descriptor ())
    ?= bit_minimized ?|
    | IndexedDfaMinimizedSurfaceRejected => failwith "bit minimized surface should certify typed quotient coverage"
    | IndexedDfaMinimizedSurfaceCertified packed =>
        := \? alphabet symbol_count closure_count representative_count. surface = packed
        assert_static
            (indexed_dfa_minimized_surface_passes surface)
            (
                "bit minimized surface must map every closure state to a finite representative index and align one "
                ^^ "row per representative"
            )
    := tri_minimized =
        seal_indexed_dfa_minimized_surface tri_capability
            (tri_ab_star_then_c ())
            (tri_indexed_finite_alphabet_descriptor ())
    ?= tri_minimized ?|
    | IndexedDfaMinimizedSurfaceRejected => failwith "ternary minimized surface should certify typed quotient coverage"
    | IndexedDfaMinimizedSurfaceCertified packed =>
        := \? alphabet symbol_count closure_count representative_count. surface = packed
        assert_static
            (indexed_dfa_minimized_surface_passes surface)
            (
                "ternary minimized surface must map every closure state to a finite representative index and align "
                ^^ "one row per representative"
            )
    := cardinality_program_batch : matcher_batch indexed_dfa_cardinality_program (bit_alphabet * tri_alphabet) =
        MatchBatchPair (
            MatchBatchSingle (
                capture_indexed_dfa_cardinality_program
                    bit_capability
                    (ends_with_zero ())
                    (bit_indexed_finite_alphabet_descriptor ())),
            MatchBatchSingle (
                capture_indexed_dfa_cardinality_program
                    tri_capability
                    (tri_ab_star_then_c ())
                    (tri_indexed_finite_alphabet_descriptor ())))
    assert_static
        (matcher_batch_forall `$indexed_dfa_cardinality_program_passes cardinality_program_batch)
        (
            "higher-ranked cardinality programs must preserve alphabet-indexed symbol/state counts before "
            ^^ "existential sealing"
        )
    := ~count = 200i32
    := ~length = 32i32
    := ~max_zero_run = 16i32
    expect_compiled_count
        (bit_compiled_runner_count bit_capability (ends_with_zero ()) 2i32 (CompiledRandom (count, length)))
        93i32
        "brzozowski-compiled-ends-with-zero-count"
    expect_compiled_count
        (bit_compiled_runner_count bit_capability (zero_or_two_zeros_then_one ()) 3i32 (CompiledZeroRuns max_zero_run))
        16i32
        "brzozowski-compiled-zero-runs-count"
    ? tri_compiled_runner_agrees tri_capability ?> 0i32 |: failwith "brzozowski-compiled-ternary-disagrees"

:= fourth_from_end_one_left_out_its_compile_time_minimization_takes_43_s () = ()

:== root_bit_alphabet = bit_alphabet
:== root_bit_finite_length = bit_finite_length
:= root_bit_finite_symbol_vector () = bit_finite_symbol_vector ()
