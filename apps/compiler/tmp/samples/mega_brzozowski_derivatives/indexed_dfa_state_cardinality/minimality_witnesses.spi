:< main
:< semantic_witnesses

:! indexed_dfa_pair_distinguishing_witness alphabet =
    regex alphabet * regex alphabet * linear_input alphabet

:| ^ indexed_dfa_distinguishing_against alphabet tail_count =
    | IndexedDfaDistinguishingAgainstNil :: \* alphabet.
        indexed_dfa_distinguishing_against alphabet finite_length_zero
    | IndexedDfaDistinguishingAgainstCons :: \* alphabet tail_count.
        indexed_dfa_pair_distinguishing_witness alphabet *
        indexed_dfa_distinguishing_against alphabet tail_count ->
        indexed_dfa_distinguishing_against alphabet (finite_length_succ tail_count)

:| ^ indexed_dfa_pairwise_distinguishing_witnesses alphabet representative_count =
    | IndexedDfaPairwiseDistinguishingWitnessesNil :: \* alphabet.
        indexed_dfa_pairwise_distinguishing_witnesses alphabet finite_length_zero
    | IndexedDfaPairwiseDistinguishingWitnessesCons :: \* alphabet tail_count.
        indexed_dfa_distinguishing_against alphabet tail_count *
        indexed_dfa_pairwise_distinguishing_witnesses alphabet tail_count ->
        indexed_dfa_pairwise_distinguishing_witnesses
            alphabet
            (finite_length_succ tail_count)

:| indexed_dfa_distinguishing_against_validation alphabet tail_count =
    | IndexedDfaDistinguishingAgainstRejected :: \* alphabet tail_count.
        indexed_dfa_distinguishing_against_validation alphabet tail_count
    | IndexedDfaDistinguishingAgainstCertified :: \* alphabet tail_count.
        indexed_dfa_distinguishing_against alphabet tail_count ->
        indexed_dfa_distinguishing_against_validation alphabet tail_count

:= ^ indexed_dfa_build_distinguishing_against \* alphabet tail_count.
    (bisimulation_capability : indexed_dfa_bisimulation_capability alphabet)
    (head : regex alphabet)
    (tail : indexed_dfa_state_vector alphabet tail_count)
    (symbols : symbol_list alphabet)
    : indexed_dfa_distinguishing_against_validation alphabet tail_count
    =
    ?= bisimulation_capability, tail ?|
    | _, IndexedDfaStateVectorNil =>
        IndexedDfaDistinguishingAgainstCertified
            IndexedDfaDistinguishingAgainstNil
    | indexed_dfa_bisimulation_capability (_, distinguish, distinguishing_valid),
        IndexedDfaStateVectorCons (state, rest)
        =>
            := result = distinguish head state symbols
            ?= result ?|
            | DfaConstructiveEquivalent =>
                IndexedDfaDistinguishingAgainstRejected
            | DfaConstructiveDistinguished input =>
                ? distinguishing_valid head state symbols result
                ?>
                    := rest_witnesses =
                        indexed_dfa_build_distinguishing_against bisimulation_capability head rest symbols
                    ?= rest_witnesses ?|
                    | IndexedDfaDistinguishingAgainstRejected =>
                        IndexedDfaDistinguishingAgainstRejected
                    | IndexedDfaDistinguishingAgainstCertified witnesses =>
                        := witness :
                            indexed_dfa_pair_distinguishing_witness alphabet =
                            indexed_dfa_pair_distinguishing_witness (
                                head,
                                state,
                                input)
                        IndexedDfaDistinguishingAgainstCertified (
                            IndexedDfaDistinguishingAgainstCons (
                                witness,
                                witnesses))
                |: IndexedDfaDistinguishingAgainstRejected

:| indexed_dfa_pairwise_distinguishing_validation alphabet representative_count =
    | IndexedDfaPairwiseDistinguishingRejected :: \* alphabet representative_count.
        indexed_dfa_pairwise_distinguishing_validation alphabet representative_count
    | IndexedDfaPairwiseDistinguishingCertified :: \* alphabet representative_count.
        indexed_dfa_pairwise_distinguishing_witnesses alphabet representative_count ->
        indexed_dfa_pairwise_distinguishing_validation alphabet representative_count

:= ^ indexed_dfa_build_pairwise_distinguishing_witnesses \* alphabet representative_count.
    (bisimulation_capability : indexed_dfa_bisimulation_capability alphabet)
    (representatives : indexed_dfa_state_vector alphabet representative_count)
    (symbols : symbol_list alphabet)
    : indexed_dfa_pairwise_distinguishing_validation alphabet representative_count
    =
    ?= representatives ?|
    | IndexedDfaStateVectorNil =>
        IndexedDfaPairwiseDistinguishingCertified
            IndexedDfaPairwiseDistinguishingWitnessesNil
    | IndexedDfaStateVectorCons (head, tail) =>
        ?= indexed_dfa_build_distinguishing_against bisimulation_capability head tail symbols ?|
        | IndexedDfaDistinguishingAgainstRejected =>
            IndexedDfaPairwiseDistinguishingRejected
        | IndexedDfaDistinguishingAgainstCertified head_witnesses =>
            := tail_validation =
                indexed_dfa_build_pairwise_distinguishing_witnesses bisimulation_capability tail symbols
            ?= tail_validation ?|
            | IndexedDfaPairwiseDistinguishingRejected =>
                IndexedDfaPairwiseDistinguishingRejected
            | IndexedDfaPairwiseDistinguishingCertified tail_witnesses =>
                IndexedDfaPairwiseDistinguishingCertified (
                    IndexedDfaPairwiseDistinguishingWitnessesCons (
                        head_witnesses,
                        tail_witnesses))

:= indexed_dfa_pairwise_distinguishing_shape \* alphabet representative_count.
    (_ : indexed_dfa_state_vector alphabet representative_count)
    (_ : indexed_dfa_pairwise_distinguishing_witnesses alphabet representative_count)
    : bool = !+

:! indexed_dfa_minimality_witness alphabet symbol_count representative_count =
    indexed_dfa_bisimulation_capability alphabet *
    finite_symbol_vector alphabet symbol_count *
    indexed_dfa_state_vector alphabet representative_count *
    indexed_dfa_exact_transition_rows alphabet symbol_count representative_count *
    indexed_dfa_pairwise_distinguishing_witnesses alphabet representative_count

:= with_indexed_dfa_minimality_witness \* alphabet symbol_count representative_count result.
    (witness : indexed_dfa_minimality_witness alphabet symbol_count representative_count)
    (consumer :
        indexed_dfa_bisimulation_capability alphabet ->
        finite_symbol_vector alphabet symbol_count ->
        indexed_dfa_state_vector alphabet representative_count ->
        indexed_dfa_exact_transition_rows alphabet symbol_count representative_count ->
        indexed_dfa_pairwise_distinguishing_witnesses alphabet representative_count ->
        result)
    : result =
    ?= witness ?|
    | indexed_dfa_minimality_witness (
        bisimulation_capability,
        symbols,
        representatives,
        rows,
        pairwise_witnesses) =>
        consumer
            bisimulation_capability
            symbols
            representatives
            rows
            pairwise_witnesses

:! indexed_dfa_fully_semantic_minimized_surface alphabet symbol_count closure_count representative_count =
    indexed_dfa_semantic_minimized_surface alphabet symbol_count closure_count representative_count *
    indexed_dfa_minimality_witness alphabet symbol_count representative_count

:| indexed_dfa_fully_semantic_minimized_surface_validation =
    | IndexedDfaFullySemanticMinimizedSurfaceRejected
    | IndexedDfaFullySemanticMinimizedSurfaceCertified :
        (\? alphabet symbol_count closure_count representative_count.
            indexed_dfa_fully_semantic_minimized_surface
                alphabet symbol_count closure_count representative_count)

:= seal_indexed_dfa_fully_semantic_minimized_surface \* alphabet {symbol_compare; finite_alphabet}.
    (capability : indexed_dfa_capability alphabet)
    (start : regex alphabet)
    (descriptor : indexed_finite_alphabet_descriptor alphabet)
    : indexed_dfa_fully_semantic_minimized_surface_validation
    =
    ?= seal_indexed_dfa_semantic_minimized_surface capability start descriptor ?|
    | IndexedDfaSemanticMinimizedSurfaceRejected =>
        IndexedDfaFullySemanticMinimizedSurfaceRejected
    | IndexedDfaSemanticMinimizedSurfaceCertified packed =>
        := \? sealed_alphabet symbol_count closure_count representative_count. surface = packed
        ?= surface ?|
        | indexed_dfa_semantic_minimized_surface (
                _,
                bisimulation_capability,
                symbols,
                _,
                representatives,
                _,
                rows
            )
            =>
                := symbol_list = finite_symbol_vector_to_list symbols
                := pairwise_validation =
                    indexed_dfa_build_pairwise_distinguishing_witnesses
                        bisimulation_capability
                        representatives
                        symbol_list
                ?= pairwise_validation ?|
                | IndexedDfaPairwiseDistinguishingRejected =>
                    IndexedDfaFullySemanticMinimizedSurfaceRejected
                | IndexedDfaPairwiseDistinguishingCertified pairwise_witnesses =>
                    := minimality_witness =
                        indexed_dfa_minimality_witness (
                            bisimulation_capability,
                            symbols,
                            representatives,
                            rows,
                            pairwise_witnesses)
                    IndexedDfaFullySemanticMinimizedSurfaceCertified (\? (
                        indexed_dfa_fully_semantic_minimized_surface (
                            surface,
                            minimality_witness)))

:= indexed_dfa_fully_semantic_surface_contract \* alphabet symbol_count closure_count representative_count.
    (surface :
        indexed_dfa_fully_semantic_minimized_surface
            alphabet symbol_count closure_count representative_count)
    : bool =
    ?= surface ?|
    | indexed_dfa_fully_semantic_minimized_surface (semantic_surface, minimality_witness) =>
        ?= semantic_surface ?|
        | indexed_dfa_semantic_minimized_surface (_, _, _, _, _, partition_witness, _) =>
            with_indexed_dfa_semantic_partition_witness partition_witness (\ coverage origins =>
                := _ = coverage
                := _ = origins
                with_indexed_dfa_minimality_witness minimality_witness
                    (\ bisimulation_capability symbols representatives rows pairwise_witnesses =>
                        := _ = bisimulation_capability
                        := _ = symbols
                        := _ = rows
                        indexed_dfa_pairwise_distinguishing_shape
                            representatives
                            pairwise_witnesses))

:= require_minimality_witness \* alphabet symbol_count representative_count.
    (witness : indexed_dfa_minimality_witness alphabet symbol_count representative_count)
    : bool =
    with_indexed_dfa_minimality_witness witness
        (\ bisimulation_capability symbols representatives rows pairwise_witnesses =>
            := _ = bisimulation_capability
            := _ = symbols
            := _ = rows
            indexed_dfa_pairwise_distinguishing_shape
                representatives
                pairwise_witnesses)

:! indexed_dfa_fully_semantic_case alphabet =
    indexed_dfa_capability alphabet *
    regex alphabet *
    indexed_finite_alphabet_descriptor alphabet

:! indexed_dfa_fully_semantic_check alphabet = bool

:! indexed_dfa_fully_semantic_program alphabet =
    capability_program
        indexed_dfa_fully_semantic_case
        indexed_dfa_fully_semantic_check
        alphabet

:= capture_indexed_dfa_fully_semantic_program \* alphabet {symbol_compare; finite_alphabet}.
    (capability : indexed_dfa_capability alphabet)
    (start : regex alphabet)
    (descriptor : indexed_finite_alphabet_descriptor alphabet)
    : indexed_dfa_fully_semantic_program alphabet
    =
    := interpret
        (item : indexed_dfa_fully_semantic_case alphabet)
        : indexed_dfa_fully_semantic_check alphabet
        =
        ?= item ?|
        | indexed_dfa_fully_semantic_case (program_capability, program_start, program_descriptor) =>
            := sealed =
                seal_indexed_dfa_fully_semantic_minimized_surface program_capability program_start program_descriptor
            ?= sealed ?|
            | IndexedDfaFullySemanticMinimizedSurfaceRejected =>
                indexed_dfa_fully_semantic_check !-
            | IndexedDfaFullySemanticMinimizedSurfaceCertified packed =>
                := \? sealed_alphabet symbol_count closure_count representative_count. surface = packed
                indexed_dfa_fully_semantic_check (
                    indexed_dfa_fully_semantic_surface_contract surface)
    indexed_dfa_fully_semantic_program (
        capability_program_make
            (indexed_dfa_fully_semantic_case (capability, start, descriptor))
            interpret)

:= run_indexed_dfa_fully_semantic_program \* alphabet.
    (program : indexed_dfa_fully_semantic_program alphabet)
    : indexed_dfa_fully_semantic_check alphabet =
    ?= program ?|
    | indexed_dfa_fully_semantic_program generic_program =>
        capability_program_run generic_program

:= indexed_dfa_fully_semantic_program_passes \* alphabet.
    (program : indexed_dfa_fully_semantic_program alphabet) : bool =
    ?= run_indexed_dfa_fully_semantic_program program ?|
    | indexed_dfa_fully_semantic_check result => result

:= indexed_dfa_minimality_witnesses_contract () : string =
    := bit_capability : indexed_dfa_capability bit_alphabet = make_indexed_dfa_capability ()
    := bit_sealed =
        seal_indexed_dfa_fully_semantic_minimized_surface bit_capability
            (ends_with_zero ())
            (bit_indexed_finite_alphabet_descriptor ())
    ?= bit_sealed ?|
    | IndexedDfaFullySemanticMinimizedSurfaceRejected =>
        failwith "bit fully semantic minimized surface should certify"
    | IndexedDfaFullySemanticMinimizedSurfaceCertified packed =>
        := \? alphabet symbol_count closure_count representative_count. surface = packed
        assert_static
            (indexed_dfa_fully_semantic_surface_contract surface)
            "bit fully semantic surface must consume partition/minimality typestate without replay"

    := tri_capability : indexed_dfa_capability tri_alphabet = make_indexed_dfa_capability ()
    := tri_sealed =
        seal_indexed_dfa_fully_semantic_minimized_surface tri_capability
            (tri_ab_star_then_c ())
            (tri_indexed_finite_alphabet_descriptor ())
    ?= tri_sealed ?|
    | IndexedDfaFullySemanticMinimizedSurfaceRejected =>
        failwith "ternary fully semantic minimized surface should certify"
    | IndexedDfaFullySemanticMinimizedSurfaceCertified packed =>
        := \? alphabet symbol_count closure_count representative_count. surface = packed
        assert_static
            (indexed_dfa_fully_semantic_surface_contract surface)
            "ternary fully semantic surface must retain minimality and quotient closure as typestate"

    := fully_semantic_batch :
        matcher_batch indexed_dfa_fully_semantic_program (bit_alphabet * tri_alphabet) =
        MatchBatchPair (
            MatchBatchSingle (
                capture_indexed_dfa_fully_semantic_program
                    bit_capability
                    (ends_with_zero ())
                    (bit_indexed_finite_alphabet_descriptor ())),
            MatchBatchSingle (
                capture_indexed_dfa_fully_semantic_program
                    tri_capability
                    (tri_ab_star_then_c ())
                    (tri_indexed_finite_alphabet_descriptor ())))
    assert_static
        (matcher_batch_forall `$indexed_dfa_fully_semantic_program_passes fully_semantic_batch)
        "higher-ranked fully semantic programs must preserve alphabet-indexed minimality typestate"
    "brzozowski-indexed-dfa-minimality-witnesses-green"
