:< main

:! indexed_dfa_semantic_partition_witness alphabet closure_count representative_count =
    indexed_dfa_bisimulation_capability alphabet *
    indexed_dfa_quotient_coverage closure_count representative_count *
    indexed_dfa_representative_origins representative_count closure_count

:= with_indexed_dfa_semantic_partition_witness \* alphabet closure_count representative_count result.
    (witness : indexed_dfa_semantic_partition_witness alphabet closure_count representative_count)
    (consumer :
        indexed_dfa_quotient_coverage closure_count representative_count ->
        indexed_dfa_representative_origins representative_count closure_count ->
        result)
    : result =
    ?= witness ?|
    | indexed_dfa_semantic_partition_witness (_, coverage, origins) =>
        consumer coverage origins

:! indexed_dfa_semantic_minimized_surface alphabet symbol_count closure_count representative_count =
    regex alphabet *
    indexed_dfa_bisimulation_capability alphabet *
    finite_symbol_vector alphabet symbol_count *
    indexed_dfa_state_vector alphabet closure_count *
    indexed_dfa_state_vector alphabet representative_count *
    indexed_dfa_semantic_partition_witness alphabet closure_count representative_count *
    indexed_dfa_exact_transition_rows alphabet symbol_count representative_count

:| indexed_dfa_semantic_minimized_surface_validation =
    | IndexedDfaSemanticMinimizedSurfaceRejected
    | IndexedDfaSemanticMinimizedSurfaceCertified :
        (\? alphabet symbol_count closure_count representative_count.
            indexed_dfa_semantic_minimized_surface alphabet symbol_count closure_count representative_count)

:= seal_indexed_dfa_semantic_minimized_surface \* alphabet {symbol_compare; finite_alphabet}.
    (capability : indexed_dfa_capability alphabet)
    (start : regex alphabet)
    (descriptor : indexed_finite_alphabet_descriptor alphabet)
    : indexed_dfa_semantic_minimized_surface_validation =
    ?= seal_indexed_dfa_minimized_surface capability start descriptor ?|
    | IndexedDfaMinimizedSurfaceRejected =>
        IndexedDfaSemanticMinimizedSurfaceRejected
    | IndexedDfaMinimizedSurfaceCertified packed =>
        := \? alphabet' symbol_count closure_count representative_count. surface = packed
        ?= surface ?|
        | indexed_dfa_minimized_surface (
            sealed_start,
            bisimulation_capability,
            symbols,
            closure,
            representatives,
            coverage,
            origins,
            rows) =>
            := witness = indexed_dfa_semantic_partition_witness (bisimulation_capability, coverage, origins)
            IndexedDfaSemanticMinimizedSurfaceCertified (\? (
                indexed_dfa_semantic_minimized_surface (
                    sealed_start,
                    bisimulation_capability,
                    symbols,
                    closure,
                    representatives,
                    witness,
                    rows)))

:= indexed_dfa_semantic_surface_structural_contract \* alphabet symbol_count closure_count representative_count.
    (surface : indexed_dfa_semantic_minimized_surface alphabet symbol_count closure_count representative_count)
    : bool =
    ?= surface ?|
    | indexed_dfa_semantic_minimized_surface (_, _, _, _, representatives, witness, rows) =>
        with_indexed_dfa_semantic_partition_witness witness (\ coverage origins =>
            := _ = coverage
            := _ = origins
            indexed_dfa_state_row_shape_aligned representatives rows)

:= require_semantic_partition_witness \* alphabet closure_count representative_count.
    (witness : indexed_dfa_semantic_partition_witness alphabet closure_count representative_count)
    : bool =
    with_indexed_dfa_semantic_partition_witness witness (\ coverage origins =>
        := _ = coverage
        := _ = origins
        !+)


:! indexed_dfa_semantic_case alphabet =
    indexed_dfa_capability alphabet *
    regex alphabet *
    indexed_finite_alphabet_descriptor alphabet

:! indexed_dfa_semantic_check alphabet = bool

:! indexed_dfa_semantic_program alphabet =
    capability_program indexed_dfa_semantic_case indexed_dfa_semantic_check alphabet

:= capture_indexed_dfa_semantic_program \* alphabet {symbol_compare; finite_alphabet}.
    (capability : indexed_dfa_capability alphabet)
    (start : regex alphabet)
    (descriptor : indexed_finite_alphabet_descriptor alphabet)
    : indexed_dfa_semantic_program alphabet =
    := interpret (item : indexed_dfa_semantic_case alphabet)
        : indexed_dfa_semantic_check alphabet =
        ?= item ?|
        | indexed_dfa_semantic_case (program_capability, program_start, program_descriptor) =>
            := sealed = seal_indexed_dfa_semantic_minimized_surface program_capability program_start program_descriptor
            ?= sealed ?|
            | IndexedDfaSemanticMinimizedSurfaceRejected =>
                indexed_dfa_semantic_check !-
            | IndexedDfaSemanticMinimizedSurfaceCertified packed =>
                := \? sealed_alphabet symbol_count closure_count representative_count. surface = packed
                indexed_dfa_semantic_check (
                    indexed_dfa_semantic_surface_structural_contract surface)
    indexed_dfa_semantic_program (
        capability_program_make
            (indexed_dfa_semantic_case (capability, start, descriptor))
            interpret)

:= run_indexed_dfa_semantic_program \* alphabet.
    (program : indexed_dfa_semantic_program alphabet)
    : indexed_dfa_semantic_check alphabet =
    ?= program ?|
    | indexed_dfa_semantic_program generic_program =>
        capability_program_run generic_program

:= indexed_dfa_semantic_program_passes \* alphabet.
    (program : indexed_dfa_semantic_program alphabet) : bool =
    ?= run_indexed_dfa_semantic_program program ?|
    | indexed_dfa_semantic_check result => result


:= indexed_dfa_semantic_witnesses_contract () : string =
    := bit_capability : indexed_dfa_capability bit_alphabet = make_indexed_dfa_capability ()
    := bit_sealed =
        seal_indexed_dfa_semantic_minimized_surface bit_capability
            (ends_with_zero ())
            (bit_indexed_finite_alphabet_descriptor ())
    ?= bit_sealed ?|
    | IndexedDfaSemanticMinimizedSurfaceRejected =>
        failwith "bit semantic minimized surface should certify"
    | IndexedDfaSemanticMinimizedSurfaceCertified packed =>
        := \? alphabet symbol_count closure_count representative_count. surface = packed
        assert_static
            (indexed_dfa_semantic_surface_structural_contract surface)
            (
                "semantic minimized surface must retain exact representative-row cardinality without replaying "
                ^^ "quotient booleans"
            )
    := tri_capability : indexed_dfa_capability tri_alphabet = make_indexed_dfa_capability ()
    := tri_sealed =
        seal_indexed_dfa_semantic_minimized_surface tri_capability
            (tri_ab_star_then_c ())
            (tri_indexed_finite_alphabet_descriptor ())
    ?= tri_sealed ?|
    | IndexedDfaSemanticMinimizedSurfaceRejected =>
        failwith "ternary semantic minimized surface should certify"
    | IndexedDfaSemanticMinimizedSurfaceCertified packed =>
        := \? alphabet symbol_count closure_count representative_count. surface = packed
        assert_static
            (indexed_dfa_semantic_surface_structural_contract surface)
            "ternary semantic minimized surface must carry sealed quotient/origin typestate"

    := semantic_program_batch :
        matcher_batch indexed_dfa_semantic_program (bit_alphabet * tri_alphabet) =
        MatchBatchPair (
            MatchBatchSingle (
                capture_indexed_dfa_semantic_program
                    bit_capability
                    (ends_with_zero ())
                    (bit_indexed_finite_alphabet_descriptor ())),
            MatchBatchSingle (
                capture_indexed_dfa_semantic_program
                    tri_capability
                    (tri_ab_star_then_c ())
                    (tri_indexed_finite_alphabet_descriptor ())))
    assert_static
        (matcher_batch_forall `$indexed_dfa_semantic_program_passes semantic_program_batch)
        "higher-ranked semantic partition programs must preserve alphabet-indexed quotient typestate"
    "brzozowski-indexed-dfa-semantic-witnesses-green"
