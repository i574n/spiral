:< main

:! finite_symbol_equality_capability alphabet = alphabet -> alphabet -> bool
:! inventory_regex_equality_capability alphabet = regex alphabet -> regex alphabet -> bool
:! inventory_reference_acceptance_capability alphabet = regex alphabet -> linear_input alphabet -> bool
:! inventory_acceptance_capability alphabet = regex alphabet -> linear_input alphabet -> bool
:! inventory_canonical_derivative_capability alphabet = regex alphabet -> alphabet -> regex alphabet
:! inventory_raw_dfa_closure_capability alphabet = regex alphabet -> regex_list alphabet

:= finite_symbol_equality_capability_default \* alphabet {symbol_compare}.
    : finite_symbol_equality_capability alphabet =
    finite_symbol_equality_capability symbol_equal

:= inventory_regex_equality_capability_default \* alphabet {symbol_compare}.
    : inventory_regex_equality_capability alphabet =
    inventory_regex_equality_capability regex_equal

:= inventory_reference_acceptance_capability_default \* alphabet {symbol_compare}.
    : inventory_reference_acceptance_capability alphabet =
    inventory_reference_acceptance_capability reference_accepts

:= inventory_acceptance_capability_default \* alphabet {symbol_compare}.
    : inventory_acceptance_capability alphabet =
    inventory_acceptance_capability accepts

:= inventory_canonical_derivative_capability_default \* alphabet {symbol_compare}.
    : inventory_canonical_derivative_capability alphabet =
    inventory_canonical_derivative_capability canonical_derivative

:= inventory_raw_dfa_closure_capability_default \* alphabet {symbol_compare; finite_alphabet}.
    : inventory_raw_dfa_closure_capability alphabet =
    inventory_raw_dfa_closure_capability dfa_closure

:= inventory_regex_equality_capability_static \* alphabet {symbol_compare}.
    : inventory_regex_equality_capability alphabet =
    inventory_regex_equality_capability (\ left right => static_regex_equal left right)

:= inventory_reference_acceptance_capability_static \* alphabet {symbol_compare}.
    : inventory_reference_acceptance_capability alphabet =
    inventory_reference_acceptance_capability (\ value input => static_reference_accepts value input)

:= inventory_acceptance_capability_static \* alphabet {symbol_compare}.
    : inventory_acceptance_capability alphabet =
    inventory_acceptance_capability (\ value input => static_accepts value input)

:= inventory_canonical_derivative_capability_static \* alphabet {symbol_compare}.
    : inventory_canonical_derivative_capability alphabet =
    inventory_canonical_derivative_capability (\ value symbol => static_canonical_derivative value symbol)

:= inventory_raw_dfa_closure_capability_static \* alphabet {symbol_compare; finite_alphabet}.
    : inventory_raw_dfa_closure_capability alphabet =
    inventory_raw_dfa_closure_capability (\ value => static_dfa_closure value)

:| finite_symbol_search_result length =
    | FiniteSymbolMissing :: \* length. finite_symbol_search_result length
    | FiniteSymbolFound :: \* length. finite_symbol_index length -> finite_symbol_search_result length

:= ^ finite_symbol_vector_find \* alphabet length.
    (equality : finite_symbol_equality_capability alphabet)
    (symbol : alphabet)
    (values : finite_symbol_vector alphabet length)
    : finite_symbol_search_result length =
    ?= equality, values ?|
    | finite_symbol_equality_capability equal, FiniteSymbolVectorNil => FiniteSymbolMissing
    | finite_symbol_equality_capability equal, FiniteSymbolVectorCons (head, tail) =>
        ? equal symbol head ?> FiniteSymbolFound FiniteSymbolIndexZero
        |:
            ?= finite_symbol_vector_find equality symbol tail ?|
            | FiniteSymbolMissing => FiniteSymbolMissing
            | FiniteSymbolFound index => FiniteSymbolFound (FiniteSymbolIndexSucc index)

:= ^ finite_symbol_index_same \* length.
    (left : finite_symbol_index length)
    (right : finite_symbol_index length) : bool =
    ?= left, right ?|
    | FiniteSymbolIndexZero, FiniteSymbolIndexZero => !+
    | FiniteSymbolIndexSucc left_previous, FiniteSymbolIndexSucc right_previous =>
        finite_symbol_index_same left_previous right_previous
    | _ => !-

:| ^ inventory_regex length =
    | InventoryRegexEmpty :: \* length. inventory_regex length
    | InventoryRegexEpsilon :: \* length. inventory_regex length
    | InventoryRegexChar :: \* length. finite_symbol_index length -> inventory_regex length
    | InventoryRegexAlt :: \* length. inventory_regex length * inventory_regex length -> inventory_regex length
    | InventoryRegexCat :: \* length. inventory_regex length * inventory_regex length -> inventory_regex length
    | InventoryRegexStar :: \* length. inventory_regex length -> inventory_regex length

:| inventory_regex_validation length =
    | InventoryRegexRejected :: \* length. inventory_regex_validation length
    | InventoryRegexCertified :: \* length. inventory_regex length -> inventory_regex_validation length

:= ^ inventory_regex_index \* alphabet length.
    (equality : finite_symbol_equality_capability alphabet)
    (value : regex alphabet)
    (symbols : finite_symbol_vector alphabet length)
    : inventory_regex_validation length =
    ?= value ?|
    | RegexEmpty => InventoryRegexCertified InventoryRegexEmpty
    | RegexEpsilon => InventoryRegexCertified InventoryRegexEpsilon
    | RegexChar symbol =>
        ?= finite_symbol_vector_find equality symbol symbols ?|
        | FiniteSymbolMissing => InventoryRegexRejected
        | FiniteSymbolFound index => InventoryRegexCertified (InventoryRegexChar index)
    | RegexAlt (left, right) =>
        ?= inventory_regex_index equality left symbols ?|
        | InventoryRegexRejected => InventoryRegexRejected
        | InventoryRegexCertified left_indexed =>
            ?= inventory_regex_index equality right symbols ?|
            | InventoryRegexRejected => InventoryRegexRejected
            | InventoryRegexCertified right_indexed =>
                InventoryRegexCertified (InventoryRegexAlt (left_indexed, right_indexed))
    | RegexCat (left, right) =>
        ?= inventory_regex_index equality left symbols ?|
        | InventoryRegexRejected => InventoryRegexRejected
        | InventoryRegexCertified left_indexed =>
            ?= inventory_regex_index equality right symbols ?|
            | InventoryRegexRejected => InventoryRegexRejected
            | InventoryRegexCertified right_indexed =>
                InventoryRegexCertified (InventoryRegexCat (left_indexed, right_indexed))
    | RegexStar inner =>
        ?= inventory_regex_index equality inner symbols ?|
        | InventoryRegexCertified inner_indexed => InventoryRegexCertified (InventoryRegexStar inner_indexed)
        | InventoryRegexRejected => InventoryRegexRejected

:= ^ inventory_regex_reify \* alphabet length.
    (symbols : finite_symbol_vector alphabet length)
    (value : inventory_regex length)
    : regex alphabet
    =
    ?= value ?|
    | InventoryRegexEmpty => RegexEmpty
    | InventoryRegexEpsilon => RegexEpsilon
    | InventoryRegexChar index => RegexChar (finite_symbol_vector_lookup index symbols)
    | InventoryRegexAlt (left, right) =>
        RegexAlt (inventory_regex_reify symbols left, inventory_regex_reify symbols right)
    | InventoryRegexCat (left, right) =>
        RegexCat (inventory_regex_reify symbols left, inventory_regex_reify symbols right)
    | InventoryRegexStar inner => RegexStar (inventory_regex_reify symbols inner)

:= ^ inventory_nullable \* length.
    (value : inventory_regex length) : nullable_evidence =
    ?= value ?|
    | InventoryRegexEmpty => NonNullable
    | InventoryRegexEpsilon => Nullable
    | InventoryRegexChar _ => NonNullable
    | InventoryRegexAlt (left, right) =>
        ?= inventory_nullable left, inventory_nullable right ?|
        | Nullable, _ => Nullable
        | _, Nullable => Nullable
        | _ => NonNullable
    | InventoryRegexCat (left, right) =>
        ?= inventory_nullable left, inventory_nullable right ?|
        | Nullable, Nullable => Nullable
        | _ => NonNullable
    | InventoryRegexStar _ => Nullable

:= ^ inventory_derivative \* length.
    (value : inventory_regex length)
    (symbol : finite_symbol_index length)
    : inventory_regex length =
    ?= value ?|
    | InventoryRegexEmpty => InventoryRegexEmpty
    | InventoryRegexEpsilon => InventoryRegexEmpty
    | InventoryRegexChar expected =>
        ? finite_symbol_index_same expected symbol ?> InventoryRegexEpsilon |: InventoryRegexEmpty
    | InventoryRegexAlt (left, right) =>
        InventoryRegexAlt (inventory_derivative left symbol, inventory_derivative right symbol)
    | InventoryRegexCat (left, right) =>
        ?= inventory_nullable left ?|
        | Nullable =>
            InventoryRegexAlt (
                InventoryRegexCat (inventory_derivative left symbol, right),
                inventory_derivative right symbol)
        | NonNullable => InventoryRegexCat (inventory_derivative left symbol, right)
    | InventoryRegexStar inner =>
        InventoryRegexCat (inventory_derivative inner symbol, InventoryRegexStar inner)

:= ^ finite_symbol_index_compare \* length.
    (left : finite_symbol_index length)
    (right : finite_symbol_index length) : symbol_ordering =
    ?= left, right ?|
    | FiniteSymbolIndexZero, FiniteSymbolIndexZero => SymbolSame
    | FiniteSymbolIndexZero, FiniteSymbolIndexSucc _ => SymbolLess
    | FiniteSymbolIndexSucc _, FiniteSymbolIndexZero => SymbolGreater
    | FiniteSymbolIndexSucc left_previous, FiniteSymbolIndexSucc right_previous =>
        finite_symbol_index_compare left_previous right_previous

:= ^ inventory_regex_compare \* length.
    (left : inventory_regex length)
    (right : inventory_regex length) : symbol_ordering =
    ?= left ?|
    | InventoryRegexEmpty =>
        ?= right ?|
        | InventoryRegexEmpty => SymbolSame
        | _ => SymbolLess
    | InventoryRegexEpsilon =>
        ?= right ?|
        | InventoryRegexEmpty => SymbolGreater
        | InventoryRegexEpsilon => SymbolSame
        | _ => SymbolLess
    | InventoryRegexChar left_symbol =>
        ?= right ?|
        | InventoryRegexEmpty => SymbolGreater
        | InventoryRegexEpsilon => SymbolGreater
        | InventoryRegexChar right_symbol => finite_symbol_index_compare left_symbol right_symbol
        | _ => SymbolLess
    | InventoryRegexCat (left_head, left_tail) =>
        ?= right ?|
        | InventoryRegexEmpty => SymbolGreater
        | InventoryRegexEpsilon => SymbolGreater
        | InventoryRegexChar _ => SymbolGreater
        | InventoryRegexCat (right_head, right_tail) =>
            ?= inventory_regex_compare left_head right_head ?|
            | SymbolSame => inventory_regex_compare left_tail right_tail
            | order => order
        | _ => SymbolLess
    | InventoryRegexStar left_inner =>
        ?= right ?|
        | InventoryRegexAlt _ => SymbolLess
        | InventoryRegexStar right_inner => inventory_regex_compare left_inner right_inner
        | _ => SymbolGreater
    | InventoryRegexAlt (left_head, left_tail) =>
        ?= right ?|
        | InventoryRegexAlt (right_head, right_tail) =>
            ?= inventory_regex_compare left_head right_head ?|
            | SymbolSame => inventory_regex_compare left_tail right_tail
            | order => order
        | _ => SymbolGreater

:= ^ inventory_regex_equal \* length.
    (left : inventory_regex length)
    (right : inventory_regex length)
    : bool
    =
    ?= left, right ?|
    | InventoryRegexEmpty, InventoryRegexEmpty => !+
    | InventoryRegexEpsilon, InventoryRegexEpsilon => !+
    | InventoryRegexChar left_symbol, InventoryRegexChar right_symbol =>
        finite_symbol_index_same left_symbol right_symbol
    | InventoryRegexAlt (left_a, left_b), InventoryRegexAlt (right_a, right_b) =>
        ? inventory_regex_equal left_a right_a ?> inventory_regex_equal left_b right_b |: !-
    | InventoryRegexCat (left_a, left_b), InventoryRegexCat (right_a, right_b) =>
        ? inventory_regex_equal left_a right_a ?> inventory_regex_equal left_b right_b |: !-
    | InventoryRegexStar left_inner, InventoryRegexStar right_inner => inventory_regex_equal left_inner right_inner
    | _ => !-

:= ^ inventory_alt_insert_sorted \* length.
    (term : inventory_regex length)
    (value : inventory_regex length) : inventory_regex length =
    ?= value ?|
    | InventoryRegexEmpty => term
    | InventoryRegexAlt (head, tail) =>
        ?= inventory_regex_compare term head ?|
        | SymbolLess => InventoryRegexAlt (term, value)
        | SymbolSame => value
        | SymbolGreater => InventoryRegexAlt (head, inventory_alt_insert_sorted term tail)
    | _ =>
        ?= inventory_regex_compare term value ?|
        | SymbolLess => InventoryRegexAlt (term, value)
        | SymbolSame => value
        | SymbolGreater => InventoryRegexAlt (value, term)

:= ^ inventory_make_alt \* length.
    (left : inventory_regex length)
    (right : inventory_regex length) : inventory_regex length =
    ?= left ?|
    | InventoryRegexEmpty => right
    | InventoryRegexAlt (head, tail) => inventory_make_alt tail (inventory_alt_insert_sorted head right)
    | _ => inventory_alt_insert_sorted left right

:= ^ inventory_make_cat \* length.
    (left : inventory_regex length)
    (right : inventory_regex length)
    : inventory_regex length
    =
    ?= left, right ?|
    | InventoryRegexEmpty, _ => InventoryRegexEmpty
    | _, InventoryRegexEmpty => InventoryRegexEmpty
    | InventoryRegexEpsilon, value => value
    | value, InventoryRegexEpsilon => value
    | InventoryRegexStar left_inner, InventoryRegexStar right_inner =>
        ? inventory_regex_equal left_inner right_inner
        ?> InventoryRegexStar left_inner
        |: InventoryRegexCat (left, right)
    | InventoryRegexCat (head, tail), value => InventoryRegexCat (head, inventory_make_cat tail value)
    | _ => InventoryRegexCat (left, right)

:= inventory_make_star \* length. (value : inventory_regex length) : inventory_regex length =
    ?= value ?|
    | InventoryRegexEmpty => InventoryRegexEpsilon
    | InventoryRegexEpsilon => InventoryRegexEpsilon
    | InventoryRegexStar inner => InventoryRegexStar inner
    | _ => InventoryRegexStar value

:= ^ inventory_normalize \* length.
    (value : inventory_regex length) : inventory_regex length =
    ?= value ?|
    | InventoryRegexEmpty => InventoryRegexEmpty
    | InventoryRegexEpsilon => InventoryRegexEpsilon
    | InventoryRegexChar symbol => InventoryRegexChar symbol
    | InventoryRegexAlt (left, right) => inventory_make_alt (inventory_normalize left) (inventory_normalize right)
    | InventoryRegexCat (left, right) => inventory_make_cat (inventory_normalize left) (inventory_normalize right)
    | InventoryRegexStar inner => inventory_make_star (inventory_normalize inner)

:= inventory_canonical_derivative \* length.
    (value : inventory_regex length)
    (symbol : finite_symbol_index length) : inventory_regex length =
    inventory_normalize (inventory_derivative (inventory_normalize value) symbol)

:| ^ finite_index_vector total_length row_count =
    | FiniteIndexVectorNil :: \* total_length.
        finite_index_vector total_length finite_length_zero
    | FiniteIndexVectorCons :: \* total_length row_count.
        finite_symbol_index total_length * finite_index_vector total_length row_count ->
        finite_index_vector total_length (finite_length_succ row_count)

:= ^ finite_index_vector_lift \* total_length row_count.
    (values : finite_index_vector total_length row_count)
    : finite_index_vector (finite_length_succ total_length) row_count =
    ?= values ?|
    | FiniteIndexVectorNil => FiniteIndexVectorNil
    | FiniteIndexVectorCons (head, tail) =>
        FiniteIndexVectorCons (
            FiniteSymbolIndexSucc head,
            finite_index_vector_lift tail)

:= ^ finite_all_indices \* alphabet length.
    (symbols : finite_symbol_vector alphabet length)
    : finite_index_vector length length =
    ?= symbols ?|
    | FiniteSymbolVectorNil => FiniteIndexVectorNil
    | FiniteSymbolVectorCons (_, tail) =>
        FiniteIndexVectorCons (
            FiniteSymbolIndexZero,
            finite_index_vector_lift (finite_all_indices tail))

:| ^ inventory_regex_list length =
    | InventoryRegexListNil :: \* length. inventory_regex_list length
    | InventoryRegexListCons :: \* length.
        inventory_regex length * inventory_regex_list length -> inventory_regex_list length

:= ^ inventory_regex_list_contains \* length.
    (value : inventory_regex length)
    (values : inventory_regex_list length) : bool =
    ?= values ?|
    | InventoryRegexListNil => !-
    | InventoryRegexListCons (head, tail) =>
        ? inventory_regex_equal value head ?> !+ |: inventory_regex_list_contains value tail

:= ^ inventory_dfa_enqueue_indices \* length row_count.
    (state : inventory_regex length)
    (indices : finite_index_vector length row_count)
    (seen : inventory_regex_list length)
    (pending : inventory_regex_list length)
    : inventory_regex_list length * inventory_regex_list length =
    ?= indices ?|
    | FiniteIndexVectorNil => seen, pending
    | FiniteIndexVectorCons (index, rest) =>
        := next = inventory_canonical_derivative state index
        ? inventory_regex_list_contains next seen ?>
            inventory_dfa_enqueue_indices state rest seen pending
        |:
            inventory_dfa_enqueue_indices
                state
                rest
                (InventoryRegexListCons (next, seen))
                (InventoryRegexListCons (next, pending))

:= ^ inventory_dfa_closure_loop \* length.
    (indices : finite_index_vector length length)
    (seen : inventory_regex_list length)
    (pending : inventory_regex_list length)
    : inventory_regex_list length =
    ?= pending ?|
    | InventoryRegexListNil => seen
    | InventoryRegexListCons (state, rest) =>
        := seen_next, pending_next = inventory_dfa_enqueue_indices state indices seen rest
        inventory_dfa_closure_loop indices seen_next pending_next

:= inventory_dfa_closure_with_indices \* length.
    (indices : finite_index_vector length length)
    (start : inventory_regex length)
    : inventory_regex_list length =
    := normalized = inventory_normalize start
    := initial = InventoryRegexListCons (normalized, InventoryRegexListNil)
    inventory_dfa_closure_loop indices initial initial


:= ^ inventory_regex_list_reify \* alphabet length.
    (symbols : finite_symbol_vector alphabet length)
    (values : inventory_regex_list length)
    : regex_list alphabet =
    ?= values ?|
    | InventoryRegexListNil => RegexListNil
    | InventoryRegexListCons (head, tail) =>
        RegexListCons (
            inventory_regex_reify symbols head,
            inventory_regex_list_reify symbols tail)

:= ^ raw_regex_list_contains_with \* alphabet.
    (equal_regex : inventory_regex_equality_capability alphabet)
    (value : regex alphabet)
    (values : regex_list alphabet) : bool =
    ?= equal_regex, values ?|
    | inventory_regex_equality_capability equal, RegexListNil => !-
    | inventory_regex_equality_capability equal, RegexListCons (head, tail) =>
        ? equal value head ?> !+ |: raw_regex_list_contains_with equal_regex value tail

:= ^ raw_regex_list_subset_with \* alphabet.
    (equal_regex : inventory_regex_equality_capability alphabet)
    (left : regex_list alphabet)
    (right : regex_list alphabet) : bool =
    ?= left ?|
    | RegexListNil => !+
    | RegexListCons (head, tail) =>
        ? raw_regex_list_contains_with equal_regex head right ?>
            raw_regex_list_subset_with equal_regex tail right
        |: !-

:= raw_regex_list_set_equal_with \* alphabet.
    (equal_regex : inventory_regex_equality_capability alphabet)
    (left : regex_list alphabet)
    (right : regex_list alphabet) : bool =
    raw_regex_list_subset_with equal_regex left right &&
    raw_regex_list_subset_with equal_regex right left

:= inventory_dfa_closure_reifies \* alphabet length.
    (equality : finite_symbol_equality_capability alphabet)
    (equal_regex : inventory_regex_equality_capability alphabet)
    (production_closure : inventory_raw_dfa_closure_capability alphabet)
    (value : regex alphabet)
    (symbols : finite_symbol_vector alphabet length) : bool =
    ?= production_closure ?|
    | inventory_raw_dfa_closure_capability raw_closure =>
        ?= inventory_regex_index equality value symbols ?|
        | InventoryRegexRejected => !-
        | InventoryRegexCertified indexed_value =>
            := indices = finite_all_indices symbols
            := indexed_closure = inventory_dfa_closure_with_indices indices indexed_value
            := reified = inventory_regex_list_reify symbols indexed_closure
            raw_regex_list_set_equal_with equal_regex reified (raw_closure value)

:| ^ inventory_dfa_state_vector symbol_count state_count =
    | InventoryDfaStateVectorNil :: \* symbol_count.
        inventory_dfa_state_vector symbol_count finite_length_zero
    | InventoryDfaStateVectorCons :: \* symbol_count state_count.
        inventory_regex symbol_count * inventory_dfa_state_vector symbol_count state_count ->
        inventory_dfa_state_vector symbol_count (finite_length_succ state_count)

:! packed_inventory_dfa_state_vector symbol_count =
    \? state_count. inventory_dfa_state_vector symbol_count state_count

:= ^ inventory_dfa_state_vector_pack \* symbol_count.
    (states : inventory_regex_list symbol_count)
    : packed_inventory_dfa_state_vector symbol_count =
    ?= states ?|
    | InventoryRegexListNil =>
        packed_inventory_dfa_state_vector (\? InventoryDfaStateVectorNil)
    | InventoryRegexListCons (state, rest) =>
        ?= inventory_dfa_state_vector_pack rest ?|
        | packed_inventory_dfa_state_vector hidden =>
            := \? state_count. packed_rest = hidden
            packed_inventory_dfa_state_vector (\? (
                InventoryDfaStateVectorCons (state, packed_rest)))

:= ^ inventory_dfa_state_lookup \* symbol_count state_count.
    (index : finite_symbol_index state_count)
    (states : inventory_dfa_state_vector symbol_count state_count)
    : inventory_regex symbol_count =
    ?= index, states ?|
    | FiniteSymbolIndexZero, InventoryDfaStateVectorCons (state, _) => state
    | FiniteSymbolIndexSucc previous, InventoryDfaStateVectorCons (_, rest) =>
        inventory_dfa_state_lookup previous rest

:| ^ inventory_dfa_acceptance_vector state_count =
    | InventoryDfaAcceptanceVectorNil :: inventory_dfa_acceptance_vector finite_length_zero
    | InventoryDfaAcceptanceVectorCons :: \* state_count.
        bool * inventory_dfa_acceptance_vector state_count ->
        inventory_dfa_acceptance_vector (finite_length_succ state_count)

:= ^ inventory_dfa_acceptance_vector_build \* symbol_count state_count.
    (states : inventory_dfa_state_vector symbol_count state_count)
    : inventory_dfa_acceptance_vector state_count =
    ?= states ?|
    | InventoryDfaStateVectorNil => InventoryDfaAcceptanceVectorNil
    | InventoryDfaStateVectorCons (state, rest) =>
        := accepting =
            ?= inventory_nullable state ?|
            | Nullable => !+
            | NonNullable => !-
        InventoryDfaAcceptanceVectorCons (
            accepting,
            inventory_dfa_acceptance_vector_build rest)

:= ^ inventory_dfa_acceptance_lookup \* state_count.
    (index : finite_symbol_index state_count)
    (acceptance : inventory_dfa_acceptance_vector state_count) : bool =
    ?= index, acceptance ?|
    | FiniteSymbolIndexZero, InventoryDfaAcceptanceVectorCons (value, _) => value
    | FiniteSymbolIndexSucc previous, InventoryDfaAcceptanceVectorCons (_, rest) =>
        inventory_dfa_acceptance_lookup previous rest

:= ^ inventory_dfa_acceptance_vector_reifies \* alphabet symbol_count state_count.
    (production : inventory_acceptance_capability alphabet)
    (symbols : finite_symbol_vector alphabet symbol_count)
    (states : inventory_dfa_state_vector symbol_count state_count)
    (acceptance : inventory_dfa_acceptance_vector state_count) : bool =
    ?= production, states, acceptance ?|
    | inventory_acceptance_capability production_accept,
      InventoryDfaStateVectorNil,
      InventoryDfaAcceptanceVectorNil => !+
    | inventory_acceptance_capability production_accept,
      InventoryDfaStateVectorCons (state, state_rest),
      InventoryDfaAcceptanceVectorCons (accepting, acceptance_rest) =>
        := raw_state = inventory_regex_reify symbols state
        ? bool_same accepting (production_accept raw_state InputEmpty) ?>
            inventory_dfa_acceptance_vector_reifies production symbols state_rest acceptance_rest
        |: !-


:| inventory_dfa_state_index_search_result state_count =
    | InventoryDfaStateIndexMissing :: \* state_count.
        inventory_dfa_state_index_search_result state_count
    | InventoryDfaStateIndexFound :: \* state_count.
        finite_symbol_index state_count -> inventory_dfa_state_index_search_result state_count

:= ^ inventory_dfa_state_vector_find \* symbol_count state_count.
    (value : inventory_regex symbol_count)
    (states : inventory_dfa_state_vector symbol_count state_count)
    : inventory_dfa_state_index_search_result state_count =
    ?= states ?|
    | InventoryDfaStateVectorNil => InventoryDfaStateIndexMissing
    | InventoryDfaStateVectorCons (head, rest) =>
        ? inventory_regex_equal value head ?> InventoryDfaStateIndexFound FiniteSymbolIndexZero
        |:
            ?= inventory_dfa_state_vector_find value rest ?|
            | InventoryDfaStateIndexMissing => InventoryDfaStateIndexMissing
            | InventoryDfaStateIndexFound index =>
                InventoryDfaStateIndexFound (FiniteSymbolIndexSucc index)

:| ^ inventory_dfa_target_vector state_count row_count =
    | InventoryDfaTargetVectorNil :: \* state_count.
        inventory_dfa_target_vector state_count finite_length_zero
    | InventoryDfaTargetVectorCons :: \* state_count row_count.
        finite_symbol_index state_count * inventory_dfa_target_vector state_count row_count ->
        inventory_dfa_target_vector state_count (finite_length_succ row_count)

:| inventory_dfa_target_row_validation state_count row_count =
    | InventoryDfaTargetRowRejected :: \* state_count row_count.
        inventory_dfa_target_row_validation state_count row_count
    | InventoryDfaTargetRowCertified :: \* state_count row_count.
        inventory_dfa_target_vector state_count row_count ->
        inventory_dfa_target_row_validation state_count row_count

:= ^ inventory_dfa_target_row_build \* symbol_count state_count row_count.
    (state : inventory_regex symbol_count)
    (remaining_indices : finite_index_vector symbol_count row_count)
    (states : inventory_dfa_state_vector symbol_count state_count)
    : inventory_dfa_target_row_validation state_count row_count =
    ?= remaining_indices ?|
    | FiniteIndexVectorNil => InventoryDfaTargetRowCertified InventoryDfaTargetVectorNil
    | FiniteIndexVectorCons (symbol_index, rest) =>
        := target = inventory_canonical_derivative state symbol_index
        ?= inventory_dfa_state_vector_find target states ?|
        | InventoryDfaStateIndexMissing => InventoryDfaTargetRowRejected
        | InventoryDfaStateIndexFound target_index =>
            ?= inventory_dfa_target_row_build state rest states ?|
            | InventoryDfaTargetRowRejected => InventoryDfaTargetRowRejected
            | InventoryDfaTargetRowCertified tail =>
                InventoryDfaTargetRowCertified (
                    InventoryDfaTargetVectorCons (target_index, tail))

:| ^ inventory_dfa_closed_rows total_state_count symbol_count source_count =
    | InventoryDfaClosedRowsNil :: \* total_state_count symbol_count.
        inventory_dfa_closed_rows total_state_count symbol_count finite_length_zero
    | InventoryDfaClosedRowsCons :: \* total_state_count symbol_count source_count.
        inventory_dfa_target_vector total_state_count symbol_count *
        inventory_dfa_closed_rows total_state_count symbol_count source_count ->
        inventory_dfa_closed_rows total_state_count symbol_count (finite_length_succ source_count)

:| inventory_dfa_closed_rows_validation total_state_count symbol_count source_count =
    | InventoryDfaClosedRowsRejected :: \* total_state_count symbol_count source_count.
        inventory_dfa_closed_rows_validation total_state_count symbol_count source_count
    | InventoryDfaClosedRowsCertified :: \* total_state_count symbol_count source_count.
        inventory_dfa_closed_rows total_state_count symbol_count source_count ->
        inventory_dfa_closed_rows_validation total_state_count symbol_count source_count

:= ^ inventory_dfa_closed_rows_build \* symbol_count total_state_count source_count.
    (indices : finite_index_vector symbol_count symbol_count)
    (all_states : inventory_dfa_state_vector symbol_count total_state_count)
    (remaining_states : inventory_dfa_state_vector symbol_count source_count)
    : inventory_dfa_closed_rows_validation total_state_count symbol_count source_count =
    ?= remaining_states ?|
    | InventoryDfaStateVectorNil => InventoryDfaClosedRowsCertified InventoryDfaClosedRowsNil
    | InventoryDfaStateVectorCons (state, rest) =>
        ?= inventory_dfa_target_row_build state indices all_states ?|
        | InventoryDfaTargetRowRejected => InventoryDfaClosedRowsRejected
        | InventoryDfaTargetRowCertified row =>
            ?= inventory_dfa_closed_rows_build indices all_states rest ?|
            | InventoryDfaClosedRowsRejected => InventoryDfaClosedRowsRejected
            | InventoryDfaClosedRowsCertified row_rest =>
                InventoryDfaClosedRowsCertified (InventoryDfaClosedRowsCons (row, row_rest))

:= ^ inventory_dfa_target_row_reifies \* alphabet symbol_count state_count row_count.
    (equal_regex : inventory_regex_equality_capability alphabet)
    (production : inventory_canonical_derivative_capability alphabet)
    (all_symbols : finite_symbol_vector alphabet symbol_count)
    (remaining_symbols : finite_symbol_vector alphabet row_count)
    (source : inventory_regex symbol_count)
    (states : inventory_dfa_state_vector symbol_count state_count)
    (row : inventory_dfa_target_vector state_count row_count) : bool =
    ?= equal_regex, production, remaining_symbols, row ?|
    | inventory_regex_equality_capability equal,
      inventory_canonical_derivative_capability production_derivative,
      FiniteSymbolVectorNil,
      InventoryDfaTargetVectorNil => !+
    | inventory_regex_equality_capability equal,
      inventory_canonical_derivative_capability production_derivative,
      FiniteSymbolVectorCons (symbol, symbol_rest),
      InventoryDfaTargetVectorCons (target_index, row_rest) =>
        := raw_source = inventory_regex_reify all_symbols source
        := expected = production_derivative raw_source symbol
        := actual = inventory_regex_reify all_symbols (inventory_dfa_state_lookup target_index states)
        ? equal expected actual ?>
            inventory_dfa_target_row_reifies
                equal_regex production all_symbols symbol_rest source states row_rest
        |: !-

:= ^ inventory_dfa_closed_rows_reify \* alphabet symbol_count state_count source_count.
    (equal_regex : inventory_regex_equality_capability alphabet)
    (production : inventory_canonical_derivative_capability alphabet)
    (symbols : finite_symbol_vector alphabet symbol_count)
    (all_states : inventory_dfa_state_vector symbol_count state_count)
    (remaining_states : inventory_dfa_state_vector symbol_count source_count)
    (rows : inventory_dfa_closed_rows state_count symbol_count source_count) : bool =
    ?= remaining_states, rows ?|
    | InventoryDfaStateVectorNil, InventoryDfaClosedRowsNil => !+
    | InventoryDfaStateVectorCons (state, state_rest), InventoryDfaClosedRowsCons (row, row_rest) =>
        ? inventory_dfa_target_row_reifies equal_regex production symbols symbols state all_states row ?>
            inventory_dfa_closed_rows_reify equal_regex production symbols all_states state_rest row_rest
        |: !-

:! inventory_dfa_compiled_core symbol_count state_count =
    finite_symbol_index state_count *
    inventory_dfa_acceptance_vector state_count *
    inventory_dfa_closed_rows state_count symbol_count state_count

:! inventory_dfa_closed_surface alphabet symbol_count state_count =
    finite_symbol_vector alphabet symbol_count *
    inventory_dfa_state_vector symbol_count state_count *
    inventory_dfa_compiled_core symbol_count state_count

:| packed_inventory_dfa_closed_surface alphabet =
    | PackedInventoryDfaClosedSurface :
        (\? symbol_count state_count. inventory_dfa_closed_surface alphabet symbol_count state_count)

:| packed_inventory_dfa_closed_surface_validation alphabet =
    | PackedInventoryDfaClosedSurfaceRejected
    | PackedInventoryDfaClosedSurfaceCertified : packed_inventory_dfa_closed_surface alphabet

:= seal_inventory_dfa_closed_surface \* alphabet symbol_count.
    (equality : finite_symbol_equality_capability alphabet)
    (value : regex alphabet)
    (symbols : finite_symbol_vector alphabet symbol_count)
    : packed_inventory_dfa_closed_surface_validation alphabet
    =
    ?= inventory_regex_index equality value symbols ?|
    | InventoryRegexRejected => PackedInventoryDfaClosedSurfaceRejected
    | InventoryRegexCertified indexed_value =>
        := indices = finite_all_indices symbols
        := closure = inventory_dfa_closure_with_indices indices indexed_value
        ?= inventory_dfa_state_vector_pack closure ?|
        | packed_inventory_dfa_state_vector packed_states =>
            := \? state_count. states = packed_states
            := normalized_start = inventory_normalize indexed_value
            ?= inventory_dfa_state_vector_find normalized_start states ?|
            | InventoryDfaStateIndexMissing => PackedInventoryDfaClosedSurfaceRejected
            | InventoryDfaStateIndexFound start_index =>
                := acceptance = inventory_dfa_acceptance_vector_build states
                ?= inventory_dfa_closed_rows_build indices states states ?|
                | InventoryDfaClosedRowsRejected => PackedInventoryDfaClosedSurfaceRejected
                | InventoryDfaClosedRowsCertified rows =>
                    PackedInventoryDfaClosedSurfaceCertified (
                        PackedInventoryDfaClosedSurface (
                            \? (
                                inventory_dfa_closed_surface (
                                    symbols,
                                    states,
                                    inventory_dfa_compiled_core (start_index, acceptance, rows)
                                )
                            )
                        )
                    )

:= packed_inventory_dfa_closed_surface_reifies \* alphabet.
    (equal_regex : inventory_regex_equality_capability alphabet)
    (production_derivative : inventory_canonical_derivative_capability alphabet)
    (production_acceptance : inventory_acceptance_capability alphabet)
    (packed : packed_inventory_dfa_closed_surface alphabet) : bool =
    ?= packed ?|
    | PackedInventoryDfaClosedSurface hidden =>
        := \? symbol_count state_count. surface = hidden
        ?= surface ?|
        | inventory_dfa_closed_surface (symbols, states, inventory_dfa_compiled_core (_, acceptance, rows)) =>
            inventory_dfa_acceptance_vector_reifies production_acceptance symbols states acceptance &&
            inventory_dfa_closed_rows_reify equal_regex production_derivative symbols states states rows

:! inventory_dfa_verified_closed_surface alphabet =
    packed_inventory_dfa_closed_surface alphabet

:| inventory_dfa_verified_closed_surface_validation alphabet =
    | InventoryDfaVerifiedClosedSurfaceRejected
    | InventoryDfaVerifiedClosedSurfaceCertified : inventory_dfa_verified_closed_surface alphabet

:= verify_inventory_dfa_closed_surface \* alphabet.
    (equal_regex : inventory_regex_equality_capability alphabet)
    (production_derivative : inventory_canonical_derivative_capability alphabet)
    (production_acceptance : inventory_acceptance_capability alphabet)
    (packed : packed_inventory_dfa_closed_surface alphabet)
    : inventory_dfa_verified_closed_surface_validation alphabet =
    ? packed_inventory_dfa_closed_surface_reifies
        equal_regex production_derivative production_acceptance packed
    ?> InventoryDfaVerifiedClosedSurfaceCertified (inventory_dfa_verified_closed_surface packed)
    |: InventoryDfaVerifiedClosedSurfaceRejected




:! inventory_dfa_surface alphabet length =
    finite_symbol_vector alphabet length *
    inventory_regex length *
    inventory_regex_list length

:| packed_inventory_dfa_surface alphabet =
    | PackedInventoryDfaSurface : (\? length. inventory_dfa_surface alphabet length)

:| packed_inventory_dfa_surface_validation alphabet =
    | PackedInventoryDfaSurfaceRejected
    | PackedInventoryDfaSurfaceCertified : packed_inventory_dfa_surface alphabet

:= seal_inventory_dfa_surface \* alphabet length.
    (equality : finite_symbol_equality_capability alphabet)
    (value : regex alphabet)
    (symbols : finite_symbol_vector alphabet length)
    : packed_inventory_dfa_surface_validation alphabet =
    ?= inventory_regex_index equality value symbols ?|
    | InventoryRegexRejected => PackedInventoryDfaSurfaceRejected
    | InventoryRegexCertified indexed_value =>
        := indices = finite_all_indices symbols
        := closure = inventory_dfa_closure_with_indices indices indexed_value
        PackedInventoryDfaSurfaceCertified (
            PackedInventoryDfaSurface (\? (
                inventory_dfa_surface (symbols, indexed_value, closure))))

:= packed_inventory_dfa_surface_reifies \* alphabet.
    (equal_regex : inventory_regex_equality_capability alphabet)
    (production_closure : inventory_raw_dfa_closure_capability alphabet)
    (source : regex alphabet)
    (packed : packed_inventory_dfa_surface alphabet) : bool =
    ?= equal_regex, production_closure, packed ?|
    | inventory_regex_equality_capability equal,
      inventory_raw_dfa_closure_capability raw_closure,
      PackedInventoryDfaSurface hidden =>
        := \? length. surface = hidden
        ?= surface ?|
        | inventory_dfa_surface (symbols, indexed_source, indexed_closure) =>
            := source_ok = equal source (inventory_regex_reify symbols indexed_source)
            := closure_ok =
                raw_regex_list_set_equal_with
                    equal_regex
                    (inventory_regex_list_reify symbols indexed_closure)
                    (raw_closure source)
            source_ok && closure_ok

:! inventory_dfa_program alphabet =
    capability_program regex packed_inventory_dfa_surface_validation alphabet

:= capture_inventory_dfa_program \* alphabet length.
    (equality : finite_symbol_equality_capability alphabet)
    (symbols : finite_symbol_vector alphabet length)
    (value : regex alphabet)
    : inventory_dfa_program alphabet =
    := interpret (program_value : regex alphabet) : packed_inventory_dfa_surface_validation alphabet =
        seal_inventory_dfa_surface equality program_value symbols
    inventory_dfa_program (capability_program_make value interpret)

:= run_inventory_dfa_program \* alphabet.
    (program : inventory_dfa_program alphabet)
    : packed_inventory_dfa_surface_validation alphabet =
    ?= program ?|
    | inventory_dfa_program generic_program => capability_program_run generic_program

:= inventory_dfa_program_passes \* alphabet.
    (program : inventory_dfa_program alphabet) : bool =
    ?= run_inventory_dfa_program program ?|
    | PackedInventoryDfaSurfaceRejected => !-
    | PackedInventoryDfaSurfaceCertified _ => !+

:| ^ inventory_input length =
    | InventoryInputEmpty :: \* length. inventory_input length
    | InventoryInputCons :: \* length. finite_symbol_index length * inventory_input length -> inventory_input length

:| inventory_input_validation length =
    | InventoryInputRejected :: \* length. inventory_input_validation length
    | InventoryInputCertified :: \* length. inventory_input length -> inventory_input_validation length

:= inventory_input_index \* alphabet length.
    (equality : finite_symbol_equality_capability alphabet)
    (input : linear_input alphabet)
    (symbols : finite_symbol_vector alphabet length)
    : inventory_input_validation length =
    := ^ loop (input : linear_input alphabet) : inventory_input_validation length =
        ?= input ?|
        | InputEmpty => InventoryInputCertified InventoryInputEmpty
        | InputCons (symbol, rest) =>
            ?= finite_symbol_vector_find equality symbol symbols ?|
            | FiniteSymbolMissing => InventoryInputRejected
            | FiniteSymbolFound index =>
                ?= loop rest ?|
                | InventoryInputRejected => InventoryInputRejected
                | InventoryInputCertified indexed_rest =>
                    InventoryInputCertified (InventoryInputCons (index, indexed_rest))
    loop input

:= ^ inventory_accepts \* length.
    (value : inventory_regex length)
    (input : inventory_input length) : bool =
    ?= input ?|
    | InventoryInputEmpty =>
        ?= inventory_nullable value ?|
        | Nullable => !+
        | NonNullable => !-
    | InventoryInputCons (symbol, rest) =>
        inventory_accepts (inventory_derivative value symbol) rest

:= ^ inventory_canonical_accepts \* length.
    (value : inventory_regex length)
    (input : inventory_input length) : bool =
    ?= input ?|
    | InventoryInputEmpty =>
        ?= inventory_nullable (inventory_normalize value) ?|
        | Nullable => !+
        | NonNullable => !-
    | InventoryInputCons (symbol, rest) =>
        inventory_canonical_accepts (inventory_canonical_derivative value symbol) rest

:! inventory_input_index_capability alphabet length =
    linear_input alphabet -> inventory_input_validation length

:! inventory_bound_acceptance_capability length =
    inventory_input length -> bool

:! inventory_dfa_runner_surface alphabet length =
    inventory_dfa_surface alphabet length *
    inventory_input_index_capability alphabet length *
    inventory_bound_acceptance_capability length

:| packed_inventory_dfa_runner alphabet =
    | PackedInventoryDfaRunner : (\? length. inventory_dfa_runner_surface alphabet length)

:| packed_inventory_dfa_runner_validation alphabet =
    | PackedInventoryDfaRunnerRejected
    | PackedInventoryDfaRunnerCertified : packed_inventory_dfa_runner alphabet

:= seal_inventory_dfa_runner \* alphabet length.
    (equality : finite_symbol_equality_capability alphabet)
    (value : regex alphabet)
    (symbols : finite_symbol_vector alphabet length)
    : packed_inventory_dfa_runner_validation alphabet =
    ?= inventory_regex_index equality value symbols ?|
    | InventoryRegexRejected => PackedInventoryDfaRunnerRejected
    | InventoryRegexCertified indexed_value =>
        := indices = finite_all_indices symbols
        := closure = inventory_dfa_closure_with_indices indices indexed_value
        := surface : inventory_dfa_surface alphabet length =
            inventory_dfa_surface (symbols, indexed_value, closure)
        := index_input : inventory_input_index_capability alphabet length =
            inventory_input_index_capability (\ input => inventory_input_index equality input symbols)
        := decide : inventory_bound_acceptance_capability length =
            inventory_bound_acceptance_capability (\ input => inventory_canonical_accepts indexed_value input)
        PackedInventoryDfaRunnerCertified (
            PackedInventoryDfaRunner (\? (
                inventory_dfa_runner_surface (surface, index_input, decide))))

:| inventory_dfa_run_result =
    | InventoryDfaAccepted
    | InventoryDfaRejected
    | InventoryDfaInputOutsideInventory

:= packed_inventory_dfa_run \* alphabet.
    (packed : packed_inventory_dfa_runner alphabet)
    (input : linear_input alphabet) : inventory_dfa_run_result =
    ?= packed ?|
    | PackedInventoryDfaRunner hidden =>
        := \? length. runner = hidden
        ?= runner ?|
        | inventory_dfa_runner_surface (_, index_input, decide) =>
            ?= index_input, decide ?|
            | inventory_input_index_capability index,
              inventory_bound_acceptance_capability accept =>
                ?= index input ?|
                | InventoryInputRejected => InventoryDfaInputOutsideInventory
                | InventoryInputCertified indexed_input =>
                    ? accept indexed_input ?> InventoryDfaAccepted |: InventoryDfaRejected

:= packed_inventory_dfa_run_agrees \* alphabet.
    (production : inventory_acceptance_capability alphabet)
    (source : regex alphabet)
    (input : linear_input alphabet)
    (packed : packed_inventory_dfa_runner alphabet)
    : bool
    =
    ?= production, packed_inventory_dfa_run packed input ?|
    | inventory_acceptance_capability production_accept, InventoryDfaAccepted => production_accept source input
    | inventory_acceptance_capability production_accept, InventoryDfaRejected =>
        bool_same (production_accept source input) !-
    | _, InventoryDfaInputOutsideInventory => !-

:= ^ inventory_dfa_target_lookup \* state_count symbol_count.
    (symbol : finite_symbol_index symbol_count)
    (row : inventory_dfa_target_vector state_count symbol_count)
    : finite_symbol_index state_count =
    ?= symbol, row ?|
    | FiniteSymbolIndexZero, InventoryDfaTargetVectorCons (target, _) => target
    | FiniteSymbolIndexSucc previous, InventoryDfaTargetVectorCons (_, rest) =>
        inventory_dfa_target_lookup previous rest

:= ^ inventory_dfa_closed_row_lookup \* total_state_count symbol_count source_count.
    (state : finite_symbol_index source_count)
    (rows : inventory_dfa_closed_rows total_state_count symbol_count source_count)
    : inventory_dfa_target_vector total_state_count symbol_count =
    ?= state, rows ?|
    | FiniteSymbolIndexZero, InventoryDfaClosedRowsCons (row, _) => row
    | FiniteSymbolIndexSucc previous, InventoryDfaClosedRowsCons (_, rest) =>
        inventory_dfa_closed_row_lookup previous rest

:= inventory_dfa_closed_accepts \* symbol_count state_count.
    (acceptance : inventory_dfa_acceptance_vector state_count)
    (rows : inventory_dfa_closed_rows state_count symbol_count state_count)
    (current : finite_symbol_index state_count)
    (input : inventory_input symbol_count) : bool =
    := ^ loop
        (current : finite_symbol_index state_count)
        (input : inventory_input symbol_count) : bool =
        ?= input ?|
        | InventoryInputEmpty => inventory_dfa_acceptance_lookup current acceptance
        | InventoryInputCons (symbol, rest) =>
            := row = inventory_dfa_closed_row_lookup current rows
            := next = inventory_dfa_target_lookup symbol row
            loop next rest
    loop current input

:= inventory_i32_add (a : i32) (b : i32) : i32 = !!!!Add(a, b)
:= inventory_i32_eq (a : i32) (b : i32) : bool = !!!!EQ(a, b)
:= inventory_i32_lt (a : i32) (b : i32) : bool = !!!!LT(a, b)

:= ^ inventory_finite_index_to_i32 \* count. (index : finite_symbol_index count) : i32 =
    ?= index ?|
    | FiniteSymbolIndexZero => 0i32
    | FiniteSymbolIndexSucc previous => inventory_i32_add (inventory_finite_index_to_i32 previous) 1i32

:= ^ inventory_runtime_symbol_index \* alphabet length.
    (equality : finite_symbol_equality_capability alphabet)
    (symbol : alphabet)
    (symbols : finite_symbol_vector alphabet length)
    (index : i32) : i32 =
    ?= equality, symbols ?|
    | _, FiniteSymbolVectorNil => -1i32
    | finite_symbol_equality_capability equal, FiniteSymbolVectorCons (head, tail) =>
        ? equal symbol head ?> index
        |: inventory_runtime_symbol_index equality symbol tail (inventory_i32_add index 1i32)

:= ^ inventory_runtime_acceptance_at \* state_count.
    (acceptance : inventory_dfa_acceptance_vector state_count) (state : i32) (index : i32)
    : bool
    =
    ?= acceptance ?|
    | InventoryDfaAcceptanceVectorNil => !-
    | InventoryDfaAcceptanceVectorCons (accepting, rest) =>
        ?= rest ?|
        | InventoryDfaAcceptanceVectorNil => accepting
        | _ =>
            ? inventory_i32_eq state index
            ?> accepting
            |: inventory_runtime_acceptance_at rest state (inventory_i32_add index 1i32)

:= ^ inventory_runtime_target \* state_count row_count.
    (row : inventory_dfa_target_vector state_count row_count) (symbol : i32) (index : i32) : i32 =
    ?= row ?|
    | InventoryDfaTargetVectorNil => 0i32
    | InventoryDfaTargetVectorCons (target, rest) =>
        ?= rest ?|
        | InventoryDfaTargetVectorNil => inventory_finite_index_to_i32 target
        | _ =>
            ? inventory_i32_eq symbol index ?> inventory_finite_index_to_i32 target
            |: inventory_runtime_target rest symbol (inventory_i32_add index 1i32)

:= ^ inventory_runtime_next \* total_state_count symbol_count source_count.
    (rows : inventory_dfa_closed_rows total_state_count symbol_count source_count) (state : i32) (symbol : i32)
    (index : i32)
    : i32
    =
    ?= rows ?|
    | InventoryDfaClosedRowsNil => 0i32
    | InventoryDfaClosedRowsCons (row, rest) =>
        ?= rest ?|
        | InventoryDfaClosedRowsNil => inventory_runtime_target row symbol 0i32
        | _ =>
            ? inventory_i32_eq state index ?> inventory_runtime_target row symbol 0i32
            |: inventory_runtime_next rest state symbol (inventory_i32_add index 1i32)

:! inventory_runtime_run_capability alphabet = linear_input alphabet -> inventory_dfa_run_result

:= inventory_dfa_closed_runtime_run \* alphabet symbol_count state_count.
    (equality : finite_symbol_equality_capability alphabet)
    (symbols : finite_symbol_vector alphabet symbol_count)
    (core : inventory_dfa_compiled_core symbol_count state_count)
    (input : linear_input alphabet)
    : inventory_dfa_run_result
    =
    ?= core ?|
    | inventory_dfa_compiled_core (start_index, acceptance, rows) =>
        :~ ^ loop (state : i32) (input : linear_input alphabet) : inventory_dfa_run_result =
            ?= input ?|
            | InputEmpty =>
                ? inventory_runtime_acceptance_at acceptance state 0i32
                ?> InventoryDfaAccepted
                |: InventoryDfaRejected
            | InputCons (symbol, rest) =>
                := symbol_index = inventory_runtime_symbol_index equality symbol symbols 0i32
                ? inventory_i32_lt symbol_index 0i32 ?> InventoryDfaInputOutsideInventory
                |: loop (inventory_runtime_next rows state symbol_index 0i32) rest
        := ~start = inventory_finite_index_to_i32 start_index
        loop start input

:! inventory_dfa_closed_runner_surface alphabet symbol_count state_count =
    inventory_dfa_closed_surface alphabet symbol_count state_count *
    inventory_input_index_capability alphabet symbol_count *
    inventory_bound_acceptance_capability symbol_count *
    inventory_runtime_run_capability alphabet

:| packed_inventory_dfa_closed_runner alphabet =
    | PackedInventoryDfaClosedRunner :
        (\? symbol_count state_count. inventory_dfa_closed_runner_surface alphabet symbol_count state_count)

:| packed_inventory_dfa_closed_runner_validation alphabet =
    | PackedInventoryDfaClosedRunnerRejected
    | PackedInventoryDfaClosedRunnerCertified : packed_inventory_dfa_closed_runner alphabet

:= seal_inventory_dfa_closed_runner \* alphabet symbol_count.
    (equality : finite_symbol_equality_capability alphabet)
    (value : regex alphabet)
    (symbols : finite_symbol_vector alphabet symbol_count)
    : packed_inventory_dfa_closed_runner_validation alphabet
    =
    ?= seal_inventory_dfa_closed_surface equality value symbols ?|
    | PackedInventoryDfaClosedSurfaceRejected => PackedInventoryDfaClosedRunnerRejected
    | PackedInventoryDfaClosedSurfaceCertified packed =>
        ?= packed ?|
        | PackedInventoryDfaClosedSurface hidden =>
            := \? hidden_symbol_count state_count. surface = hidden
            ?= surface ?|
            | inventory_dfa_closed_surface (
                    hidden_symbols,
                    _,
                    inventory_dfa_compiled_core (start_index, acceptance, rows)
                )
                =>
                    := index_input : inventory_input_index_capability alphabet hidden_symbol_count =
                        inventory_input_index_capability (
                            \ input => inventory_input_index equality input hidden_symbols)
                    := decide : inventory_bound_acceptance_capability hidden_symbol_count =
                        inventory_bound_acceptance_capability (
                            \ input => inventory_dfa_closed_accepts acceptance rows start_index input)
                    := runtime_run : inventory_runtime_run_capability alphabet =
                        inventory_runtime_run_capability \ input =>
                            inventory_dfa_closed_runtime_run equality hidden_symbols
                                (inventory_dfa_compiled_core (start_index, acceptance, rows))
                                input
                    PackedInventoryDfaClosedRunnerCertified (
                        PackedInventoryDfaClosedRunner (\? (
                            inventory_dfa_closed_runner_surface (surface, index_input, decide, runtime_run))))

:= packed_inventory_dfa_closed_run \* alphabet.
    (packed : packed_inventory_dfa_closed_runner alphabet)
    (input : linear_input alphabet) : inventory_dfa_run_result =
    ?= packed ?|
    | PackedInventoryDfaClosedRunner hidden =>
        := \? symbol_count state_count. runner = hidden
        ?= runner ?|
        | inventory_dfa_closed_runner_surface (_, index_input, decide, _) =>
            ?= index_input, decide ?|
            | inventory_input_index_capability index,
              inventory_bound_acceptance_capability accept =>
                ?= index input ?|
                | InventoryInputRejected => InventoryDfaInputOutsideInventory
                | InventoryInputCertified indexed_input =>
                    ? accept indexed_input ?> InventoryDfaAccepted |: InventoryDfaRejected

:= packed_inventory_dfa_closed_runner_replays \* alphabet.
    (equal_regex : inventory_regex_equality_capability alphabet)
    (production_derivative : inventory_canonical_derivative_capability alphabet)
    (production_acceptance : inventory_acceptance_capability alphabet)
    (packed : packed_inventory_dfa_closed_runner alphabet) : bool =
    ?= packed ?|
    | PackedInventoryDfaClosedRunner hidden =>
        := \? symbol_count state_count. runner = hidden
        ?= runner ?|
        | inventory_dfa_closed_runner_surface (surface, _, _, _) =>
            ?= surface ?|
            | inventory_dfa_closed_surface (symbols, states, inventory_dfa_compiled_core (_, acceptance, rows)) =>
                inventory_dfa_acceptance_vector_reifies production_acceptance symbols states acceptance &&
                inventory_dfa_closed_rows_reify equal_regex production_derivative symbols states states rows

:= packed_inventory_dfa_closed_run_agrees \* alphabet.
    (production : inventory_acceptance_capability alphabet)
    (source : regex alphabet)
    (input : linear_input alphabet)
    (packed : packed_inventory_dfa_closed_runner alphabet)
    : bool
    =
    ?= production, packed_inventory_dfa_closed_run packed input ?|
    | inventory_acceptance_capability production_accept, InventoryDfaAccepted => production_accept source input
    | inventory_acceptance_capability production_accept, InventoryDfaRejected =>
        bool_same (production_accept source input) !-
    | _, InventoryDfaInputOutsideInventory => !-


:= ^ packed_inventory_dfa_closed_run_agrees_inputs \* alphabet.
    (production : inventory_acceptance_capability alphabet)
    (source : regex alphabet)
    (inputs : input_list alphabet)
    (packed : packed_inventory_dfa_closed_runner alphabet) : bool =
    ?= inputs ?|
    | InputListNil => !+
    | InputListCons (input, rest) =>
        ? packed_inventory_dfa_closed_run_agrees production source input packed ?>
            packed_inventory_dfa_closed_run_agrees_inputs production source rest packed
        |: !-

:! inventory_closed_dfa_program alphabet =
    capability_program regex packed_inventory_dfa_closed_runner_validation alphabet

:= capture_inventory_closed_dfa_program \* alphabet symbol_count.
    (equality : finite_symbol_equality_capability alphabet)
    (symbols : finite_symbol_vector alphabet symbol_count)
    (value : regex alphabet)
    : inventory_closed_dfa_program alphabet =
    := interpret (program_value : regex alphabet) : packed_inventory_dfa_closed_runner_validation alphabet =
        seal_inventory_dfa_closed_runner equality program_value symbols
    inventory_closed_dfa_program (capability_program_make value interpret)

:= run_inventory_closed_dfa_program \* alphabet.
    (program : inventory_closed_dfa_program alphabet)
    : packed_inventory_dfa_closed_runner_validation alphabet =
    ?= program ?|
    | inventory_closed_dfa_program generic_program => capability_program_run generic_program

:= inventory_closed_dfa_program_passes \* alphabet.
    (program : inventory_closed_dfa_program alphabet) : bool =
    ?= run_inventory_closed_dfa_program program ?|
    | PackedInventoryDfaClosedRunnerRejected => !-
    | PackedInventoryDfaClosedRunnerCertified _ => !+

:! inventory_verified_closed_dfa_program alphabet =
    capability_program regex inventory_dfa_verified_closed_surface_validation alphabet

:= capture_inventory_verified_closed_dfa_program \* alphabet symbol_count.
    (equality : finite_symbol_equality_capability alphabet)
    (equal_regex : inventory_regex_equality_capability alphabet)
    (production_derivative : inventory_canonical_derivative_capability alphabet)
    (production_acceptance : inventory_acceptance_capability alphabet)
    (symbols : finite_symbol_vector alphabet symbol_count)
    (value : regex alphabet)
    : inventory_verified_closed_dfa_program alphabet =
    := interpret (program_value : regex alphabet) : inventory_dfa_verified_closed_surface_validation alphabet =
        ?= seal_inventory_dfa_closed_surface equality program_value symbols ?|
        | PackedInventoryDfaClosedSurfaceRejected => InventoryDfaVerifiedClosedSurfaceRejected
        | PackedInventoryDfaClosedSurfaceCertified surface =>
            verify_inventory_dfa_closed_surface equal_regex production_derivative production_acceptance surface
    inventory_verified_closed_dfa_program (capability_program_make value interpret)

:= run_inventory_verified_closed_dfa_program \* alphabet.
    (program : inventory_verified_closed_dfa_program alphabet)
    : inventory_dfa_verified_closed_surface_validation alphabet =
    ?= program ?|
    | inventory_verified_closed_dfa_program generic_program => capability_program_run generic_program

:= inventory_verified_closed_dfa_program_passes \* alphabet.
    (program : inventory_verified_closed_dfa_program alphabet) : bool =
    ?= run_inventory_verified_closed_dfa_program program ?|
    | InventoryDfaVerifiedClosedSurfaceRejected => !-
    | InventoryDfaVerifiedClosedSurfaceCertified _ => !+


:! inventory_indexed_regex alphabet length =
    finite_symbol_vector alphabet length * inventory_regex length

:| packed_inventory_indexed_regex alphabet =
    | PackedInventoryIndexedRegex : (\? length. inventory_indexed_regex alphabet length)

:| packed_inventory_indexed_regex_validation alphabet =
    | PackedInventoryIndexedRegexRejected
    | PackedInventoryIndexedRegexCertified : packed_inventory_indexed_regex alphabet

:= inventory_indexed_regex_pack \* alphabet length.
    (equality : finite_symbol_equality_capability alphabet)
    (value : regex alphabet)
    (symbols : finite_symbol_vector alphabet length)
    : packed_inventory_indexed_regex_validation alphabet =
    ?= inventory_regex_index equality value symbols ?|
    | InventoryRegexRejected => PackedInventoryIndexedRegexRejected
    | InventoryRegexCertified indexed =>
        PackedInventoryIndexedRegexCertified (
            PackedInventoryIndexedRegex (\? (inventory_indexed_regex (symbols, indexed))))

:= packed_inventory_indexed_regex_reifies \* alphabet.
    (equal_regex : inventory_regex_equality_capability alphabet)
    (source : regex alphabet)
    (packed : packed_inventory_indexed_regex alphabet) : bool =
    ?= equal_regex, packed ?|
    | inventory_regex_equality_capability equal, PackedInventoryIndexedRegex hidden =>
        := \? length. indexed = hidden
        ?= indexed ?|
        | inventory_indexed_regex (symbols, core) =>
            equal source (inventory_regex_reify symbols core)

:= indexed_match_agrees \* alphabet length.
    (equality : finite_symbol_equality_capability alphabet)
    (reference : inventory_reference_acceptance_capability alphabet)
    (value : regex alphabet)
    (input : linear_input alphabet)
    (symbols : finite_symbol_vector alphabet length) : bool =
    ?= reference ?|
    | inventory_reference_acceptance_capability reference_accept =>
        ?= inventory_regex_index equality value symbols, inventory_input_index equality input symbols ?|
        | InventoryRegexCertified indexed_value, InventoryInputCertified indexed_input =>
            bool_same (inventory_accepts indexed_value indexed_input) (reference_accept value input)
        | _ => !-

:= indexed_canonical_match_agrees \* alphabet length.
    (equality : finite_symbol_equality_capability alphabet)
    (production : inventory_acceptance_capability alphabet)
    (value : regex alphabet)
    (input : linear_input alphabet)
    (symbols : finite_symbol_vector alphabet length) : bool =
    ?= production ?|
    | inventory_acceptance_capability production_accept =>
        ?= inventory_regex_index equality value symbols, inventory_input_index equality input symbols ?|
        | InventoryRegexCertified indexed_value, InventoryInputCertified indexed_input =>
            bool_same (inventory_canonical_accepts indexed_value indexed_input) (production_accept value input)
        | _ => !-

:= indexed_canonical_derivative_reifies \* alphabet length.
    (equality : finite_symbol_equality_capability alphabet)
    (equal_regex : inventory_regex_equality_capability alphabet)
    (production : inventory_canonical_derivative_capability alphabet)
    (value : regex alphabet)
    (symbol : alphabet)
    (symbols : finite_symbol_vector alphabet length) : bool =
    ?= equal_regex, production ?|
    | inventory_regex_equality_capability equal, inventory_canonical_derivative_capability production_derivative =>
        ?= inventory_regex_index equality value symbols, finite_symbol_vector_find equality symbol symbols ?|
        | InventoryRegexCertified indexed_value, FiniteSymbolFound indexed_symbol =>
            equal
                (production_derivative value symbol)
                (inventory_regex_reify symbols (inventory_canonical_derivative indexed_value indexed_symbol))
        | _ => !-

:! inventory_indexing_program alphabet =
    capability_program regex packed_inventory_indexed_regex_validation alphabet

:= capture_inventory_indexing_program \* alphabet length.
    (equality : finite_symbol_equality_capability alphabet)
    (symbols : finite_symbol_vector alphabet length)
    (value : regex alphabet)
    : inventory_indexing_program alphabet =
    := interpret (program_value : regex alphabet) : packed_inventory_indexed_regex_validation alphabet =
        inventory_indexed_regex_pack equality program_value symbols
    inventory_indexing_program (capability_program_make value interpret)

:= run_inventory_indexing_program \* alphabet.
    (program : inventory_indexing_program alphabet)
    : packed_inventory_indexed_regex_validation alphabet =
    ?= program ?|
    | inventory_indexing_program generic_program => capability_program_run generic_program

:= inventory_indexing_program_passes \* alphabet.
    (program : inventory_indexing_program alphabet) : bool =
    ?= run_inventory_indexing_program program ?|
    | PackedInventoryIndexedRegexRejected => !-
    | PackedInventoryIndexedRegexCertified _ => !+

:| model_symbol =
    | ModelA
    | ModelB
    | ModelC
:! model_alphabet = model_symbol
:+ symbol_compare model_alphabet = \ (model_alphabet left) (model_alphabet right) =>
    ?= left, right ?|
    | ModelA, ModelA => SymbolSame
    | ModelA, _ => SymbolLess
    | _, ModelA => SymbolGreater
    | ModelB, ModelB => SymbolSame
    | ModelB, ModelC => SymbolLess
    | ModelC, ModelB => SymbolGreater
    | ModelC, ModelC => SymbolSame

:== model_two_length = finite_length_succ (finite_length_succ finite_length_zero)
:= model_two_vector () : finite_symbol_vector model_alphabet model_two_length =
    FiniteSymbolVectorCons (
        model_alphabet ModelA,
        FiniteSymbolVectorCons (model_alphabet ModelB, FiniteSymbolVectorNil))

:= bit_inventory_zero_core () : inventory_regex bit_finite_length =
    InventoryRegexChar FiniteSymbolIndexZero

:= require_inventory_core_pair \* alphabet length.
    (_ : finite_symbol_vector alphabet length)
    (_ : inventory_regex length) : bool = !+

:= inventory_indexed_model_contract () : string =
    := bit_equality : finite_symbol_equality_capability bit_alphabet = finite_symbol_equality_capability_default
    := tri_equality : finite_symbol_equality_capability tri_alphabet = finite_symbol_equality_capability_default
    := model_equality : finite_symbol_equality_capability model_alphabet = finite_symbol_equality_capability_default
    := bit_regex_equal : inventory_regex_equality_capability bit_alphabet = inventory_regex_equality_capability_static
    := bit_reference : inventory_reference_acceptance_capability bit_alphabet =
        inventory_reference_acceptance_capability_static
    := tri_reference : inventory_reference_acceptance_capability tri_alphabet =
        inventory_reference_acceptance_capability_static
    := bit_production : inventory_acceptance_capability bit_alphabet = inventory_acceptance_capability_static
    := tri_production : inventory_acceptance_capability tri_alphabet = inventory_acceptance_capability_static
    := bit_derivative : inventory_canonical_derivative_capability bit_alphabet =
        inventory_canonical_derivative_capability_static
    := tri_derivative : inventory_canonical_derivative_capability tri_alphabet =
        inventory_canonical_derivative_capability_static
    := bit_closure : inventory_raw_dfa_closure_capability bit_alphabet = inventory_raw_dfa_closure_capability_static
    := tri_closure : inventory_raw_dfa_closure_capability tri_alphabet = inventory_raw_dfa_closure_capability_static
    := model_production : inventory_acceptance_capability model_alphabet = inventory_acceptance_capability_static

    := bit_symbols = bit_finite_symbol_vector ()
    := tri_symbols = tri_finite_symbol_vector ()
    := bit_value = ends_with_zero ()
    := bit_input = input_110 ()
    := tri_value = tri_ab_star_then_c ()
    := tri_input = InputCons (tri_a (), InputCons (tri_b (), InputCons (tri_c (), InputEmpty)))

    assert_static
        (indexed_match_agrees bit_equality bit_reference bit_value bit_input bit_symbols)
        "alphabet-erased indexed bit matcher must preserve independent reference acceptance"
    assert_static
        (indexed_match_agrees tri_equality tri_reference tri_value tri_input tri_symbols)
        "alphabet-erased indexed ternary matcher must preserve independent reference acceptance"
    assert_static
        (indexed_canonical_match_agrees bit_equality bit_production bit_value bit_input bit_symbols)
        "index-only canonical bit matcher must agree with production acceptance"
    assert_static
        (indexed_canonical_match_agrees tri_equality tri_production tri_value tri_input tri_symbols)
        "index-only canonical ternary matcher must agree with production acceptance"
    assert_static
        (
            indexed_canonical_derivative_reifies bit_equality bit_regex_equal bit_derivative bit_value
                (zero ())
                bit_symbols
        )
        "index-only bit canonical derivative must reify to the production derivative"
    := tri_regex_equal : inventory_regex_equality_capability tri_alphabet = inventory_regex_equality_capability_static
    assert_static
        (
            indexed_canonical_derivative_reifies tri_equality tri_regex_equal tri_derivative tri_value
                (tri_b ())
                tri_symbols
        )
        "index-only ternary canonical derivative must reify to the production derivative"

    assert_static
        (inventory_dfa_closure_reifies bit_equality bit_regex_equal bit_closure bit_value bit_symbols)
        "index-only bit DFA closure must reify to the production closure as a set"
    assert_static
        (inventory_dfa_closure_reifies tri_equality tri_regex_equal tri_closure tri_value tri_symbols)
        "index-only ternary DFA closure must reify to the production closure as a set"

    assert_static
        (?= seal_inventory_dfa_closed_surface bit_equality bit_value bit_symbols ?|
            | PackedInventoryDfaClosedSurfaceRejected => !-
            | PackedInventoryDfaClosedSurfaceCertified surface =>
            ?= verify_inventory_dfa_closed_surface bit_regex_equal bit_derivative bit_production surface ?|
            | InventoryDfaVerifiedClosedSurfaceRejected => !-
            | InventoryDfaVerifiedClosedSurfaceCertified _ => !+)
        "bit closed DFA must become trusted only after exact acceptance and transition replay"

    assert_static
        (?= seal_inventory_dfa_closed_surface tri_equality tri_value tri_symbols ?|
            | PackedInventoryDfaClosedSurfaceRejected => !-
            | PackedInventoryDfaClosedSurfaceCertified surface =>
            ?= verify_inventory_dfa_closed_surface tri_regex_equal tri_derivative tri_production surface ?|
            | InventoryDfaVerifiedClosedSurfaceRejected => !-
            | InventoryDfaVerifiedClosedSurfaceCertified _ => !+)
        "ternary closed DFA must become trusted only after exact acceptance and transition replay"

    := bit_dfa_surface_validation = seal_inventory_dfa_surface bit_equality bit_value bit_symbols
    := tri_dfa_surface_validation = seal_inventory_dfa_surface tri_equality tri_value tri_symbols
    assert_static
        (?= bit_dfa_surface_validation ?|
            | PackedInventoryDfaSurfaceRejected => !-
            | PackedInventoryDfaSurfaceCertified surface =>
            packed_inventory_dfa_surface_reifies bit_regex_equal bit_closure bit_value surface)
        "bit existential DFA surface must retain one exact vector/core/closure length"
    assert_static
        (?= tri_dfa_surface_validation ?|
            | PackedInventoryDfaSurfaceRejected => !-
            | PackedInventoryDfaSurfaceCertified surface =>
            packed_inventory_dfa_surface_reifies tri_regex_equal tri_closure tri_value surface)
        "ternary existential DFA surface must retain one exact vector/core/closure length"
    := bit_dfa_program = capture_inventory_dfa_program bit_equality bit_symbols bit_value
    := tri_dfa_program = capture_inventory_dfa_program tri_equality tri_symbols tri_value
    := dfa_program_batch : matcher_batch inventory_dfa_program (bit_alphabet * tri_alphabet) =
        MatchBatchPair (MatchBatchSingle bit_dfa_program, MatchBatchSingle tri_dfa_program)
    assert_static
        (matcher_batch_forall `$inventory_dfa_program_passes dfa_program_batch)
        "higher-ranked heterogeneous DFA programs must preserve hidden inventory lengths"
    := bit_closed_program = capture_inventory_closed_dfa_program bit_equality bit_symbols bit_value
    := tri_closed_program = capture_inventory_closed_dfa_program tri_equality tri_symbols tri_value
    := closed_program_batch : matcher_batch inventory_closed_dfa_program (bit_alphabet * tri_alphabet) =
        MatchBatchPair (MatchBatchSingle bit_closed_program, MatchBatchSingle tri_closed_program)
    assert_static
        (matcher_batch_forall `$inventory_closed_dfa_program_passes closed_program_batch)
        (
            "higher-ranked heterogeneous closed DFA programs must preserve hidden symbol/state cardinalities and "
            ^^ "total transition matrices"
        )
    := bit_verified_program =
        capture_inventory_verified_closed_dfa_program
            bit_equality bit_regex_equal bit_derivative bit_production bit_symbols bit_value
    := tri_verified_program =
        capture_inventory_verified_closed_dfa_program
            tri_equality tri_regex_equal tri_derivative tri_production tri_symbols tri_value
    := verified_program_batch : matcher_batch inventory_verified_closed_dfa_program (bit_alphabet * tri_alphabet) =
        MatchBatchPair (MatchBatchSingle bit_verified_program, MatchBatchSingle tri_verified_program)
    assert_static
        (matcher_batch_forall `$inventory_verified_closed_dfa_program_passes verified_program_batch)
        "higher-ranked heterogeneous DFA programs must carry only independently replay-verified closed surfaces"

    assert_static
        (?= seal_inventory_dfa_runner bit_equality bit_value bit_symbols ?|
            | PackedInventoryDfaRunnerRejected => !-
            | PackedInventoryDfaRunnerCertified runner =>
            packed_inventory_dfa_run_agrees bit_production bit_value bit_input runner)
        "capability-captured bit DFA runner must agree with production"
    assert_static
        (?= seal_inventory_dfa_runner tri_equality tri_value tri_symbols ?|
            | PackedInventoryDfaRunnerRejected => !-
            | PackedInventoryDfaRunnerCertified runner =>
            packed_inventory_dfa_run_agrees tri_production tri_value tri_input runner)
        "capability-captured ternary DFA runner must agree with production"

    assert_static
        (?= seal_inventory_dfa_closed_runner bit_equality bit_value bit_symbols ?|
            | PackedInventoryDfaClosedRunnerRejected => !-
            | PackedInventoryDfaClosedRunnerCertified runner =>
            packed_inventory_dfa_closed_run_agrees_inputs
                bit_production bit_value
                (static_input_corpus_depth_two (finite_symbol_vector_to_list bit_symbols))
                runner)
        "closed-matrix bit runner must agree with production across the complete depth-two inventory corpus"
    assert_static
        (?= seal_inventory_dfa_closed_runner tri_equality tri_value tri_symbols ?|
            | PackedInventoryDfaClosedRunnerRejected => !-
            | PackedInventoryDfaClosedRunnerCertified runner =>
            packed_inventory_dfa_closed_run_agrees_inputs
                tri_production tri_value
                (static_input_corpus_depth_two (finite_symbol_vector_to_list tri_symbols))
                runner)
        "closed-matrix ternary runner must agree with production across the complete depth-two inventory corpus"

    ?= inventory_indexed_regex_pack bit_equality bit_value bit_symbols ?|
    | PackedInventoryIndexedRegexRejected => "inventory-indexed-unexpected-reject"
    | PackedInventoryIndexedRegexCertified packed =>
        assert_static
            (packed_inventory_indexed_regex_reifies bit_regex_equal bit_value packed)
            "existential vector/core seal must reify to its source"

        := model_valid_regex : regex model_alphabet = RegexStar (RegexChar (model_alphabet ModelA))
        := rogue_input : linear_input model_alphabet = InputCons (model_alphabet ModelC, InputEmpty)
        assert_static
            (?= seal_inventory_dfa_closed_runner model_equality model_valid_regex (model_two_vector ()) ?|
                | PackedInventoryDfaClosedRunnerRejected => !-
                | PackedInventoryDfaClosedRunnerCertified runner =>
                ?= packed_inventory_dfa_closed_run runner rogue_input ?|
                | InventoryDfaInputOutsideInventory => !+
                | _ => !-)
            "closed-matrix runner must classify an omitted-domain input as outside inventory before automaton execution"
        := rogue_regex : regex model_alphabet = RegexChar (model_alphabet ModelC)
        ?=
            inventory_regex_index model_equality rogue_regex (model_two_vector ()),
            inventory_input_index model_equality rogue_input (model_two_vector ())
        ?|
        | InventoryRegexRejected, InventoryInputRejected =>
            := bit_program = capture_inventory_indexing_program bit_equality bit_symbols bit_value
            := tri_program = capture_inventory_indexing_program tri_equality tri_symbols tri_value
            := batch : matcher_batch inventory_indexing_program (bit_alphabet * tri_alphabet) =
                MatchBatchPair (MatchBatchSingle bit_program, MatchBatchSingle tri_program)
            assert_static
                (matcher_batch_forall `$inventory_indexing_program_passes batch)
                (
                    "higher-ranked heterogeneous batch must preserve captured inventory capabilities and "
                    ^^ "existential lengths"
                )
            "inventory-indexed-model-green"
        | _ => "inventory-indexed-rogue-accepted"

:= inventory_indexed_full_proof_contract () : string =
    := _ = run_proof_suite ()
    inventory_indexed_model_contract ()

:= packed_inventory_dfa_closed_runtime_run \* alphabet.
    (packed : packed_inventory_dfa_closed_runner alphabet)
    (input : linear_input alphabet) : inventory_dfa_run_result =
    ?= packed ?|
    | PackedInventoryDfaClosedRunner hidden =>
        := \? symbol_count state_count. runner = hidden
        ?= runner ?|
        | inventory_dfa_closed_runner_surface (_, _, _, inventory_runtime_run_capability run) => run input

:= packed_inventory_dfa_closed_runtime_run_agrees \* alphabet.
    (production : inventory_acceptance_capability alphabet)
    (source : regex alphabet)
    (input : linear_input alphabet)
    (packed : packed_inventory_dfa_closed_runner alphabet) : bool =
    ?= production ?|
    | inventory_acceptance_capability production_accept =>
        ?= packed_inventory_dfa_closed_runtime_run packed input ?|
        | InventoryDfaAccepted => production_accept source input
        | InventoryDfaRejected => bool_same (production_accept source input) !-
        | InventoryDfaInputOutsideInventory => !-

:= packed_inventory_dfa_closed_run_agrees_runtime_corpus \* alphabet.
    (production : inventory_acceptance_capability alphabet)
    (source : regex alphabet)
    (packed : packed_inventory_dfa_closed_runner alphabet)
    (inputs : input_list alphabet) : bool =
    := ~dynamic_source = source
    :~ ^ loop (inputs : input_list alphabet) : bool =
        ?= inputs ?|
        | InputListNil => !+
        | InputListCons (input, rest) =>
            ? packed_inventory_dfa_closed_runtime_run_agrees production dynamic_source input packed ?> loop rest
            |: !-
    loop inputs

:= inventory_indexed_closed_dfa_runtime_probe () : bool =
    := bit_equality : finite_symbol_equality_capability bit_alphabet = finite_symbol_equality_capability_default
    := bit_regex_equal : inventory_regex_equality_capability bit_alphabet = inventory_regex_equality_capability_static
    := bit_derivative : inventory_canonical_derivative_capability bit_alphabet =
        inventory_canonical_derivative_capability_static
    := bit_production : inventory_acceptance_capability bit_alphabet = inventory_acceptance_capability_default
    := bit_replay_acceptance : inventory_acceptance_capability bit_alphabet = inventory_acceptance_capability_static
    := bit_symbols = bit_finite_symbol_vector ()
    := bit_source = ends_with_zero ()
    := tri_equality : finite_symbol_equality_capability tri_alphabet = finite_symbol_equality_capability_default
    := tri_regex_equal : inventory_regex_equality_capability tri_alphabet = inventory_regex_equality_capability_static
    := tri_derivative : inventory_canonical_derivative_capability tri_alphabet =
        inventory_canonical_derivative_capability_static
    := tri_production : inventory_acceptance_capability tri_alphabet = inventory_acceptance_capability_default
    := tri_replay_acceptance : inventory_acceptance_capability tri_alphabet = inventory_acceptance_capability_static
    := tri_symbols = tri_finite_symbol_vector ()
    := tri_source = tri_ab_star_then_c ()
    := model_equality : finite_symbol_equality_capability model_alphabet = finite_symbol_equality_capability_default
    := model_regex_equal : inventory_regex_equality_capability model_alphabet =
        inventory_regex_equality_capability_static
    := model_derivative : inventory_canonical_derivative_capability model_alphabet =
        inventory_canonical_derivative_capability_static
    := model_replay_acceptance : inventory_acceptance_capability model_alphabet =
        inventory_acceptance_capability_static
    := model_symbols = model_two_vector ()
    := model_source : regex model_alphabet = RegexStar (RegexChar (model_alphabet ModelA))
    ?=
        seal_inventory_dfa_closed_runner bit_equality bit_source bit_symbols,
        seal_inventory_dfa_closed_runner tri_equality tri_source tri_symbols,
        seal_inventory_dfa_closed_runner model_equality model_source model_symbols
    ?|
    | PackedInventoryDfaClosedRunnerCertified bit_runner,
        PackedInventoryDfaClosedRunnerCertified tri_runner,
        PackedInventoryDfaClosedRunnerCertified model_runner
        =>
            := replay_ok =
                packed_inventory_dfa_closed_runner_replays
                    bit_regex_equal
                    bit_derivative
                    bit_replay_acceptance
                    bit_runner
                && packed_inventory_dfa_closed_runner_replays
                       tri_regex_equal
                       tri_derivative
                       tri_replay_acceptance
                       tri_runner
                && packed_inventory_dfa_closed_runner_replays
                       model_regex_equal
                       model_derivative
                       model_replay_acceptance
                       model_runner
            := ~bit_inputs = input_corpus_depth_two (finite_symbol_vector_to_list bit_symbols)
            := ~tri_inputs = input_corpus_depth_two (finite_symbol_vector_to_list tri_symbols)
            := ~rogue_input : linear_input model_alphabet = InputCons (model_alphabet ModelC, InputEmpty)
            ? replay_ok
            ?>
                ? packed_inventory_dfa_closed_run_agrees_runtime_corpus bit_production bit_source bit_runner bit_inputs
                ?>
                    ?
                        packed_inventory_dfa_closed_run_agrees_runtime_corpus
                            tri_production
                            tri_source
                            tri_runner
                            tri_inputs
                    ?>
                        ?= packed_inventory_dfa_closed_runtime_run model_runner rogue_input ?|
                        | InventoryDfaInputOutsideInventory => !+
                        | _ => !-
                    |: !-
                |: !-
            |: !-
    | _ => !-

:== root_finite_symbol_vector alphabet length = finite_symbol_vector alphabet length
:== root_tri_alphabet = tri_alphabet
:= root_tri_finite_symbol_vector () = tri_finite_symbol_vector ()
