    inl rejected_sealed = seal_match (ends_with_zero ()) rejected_input
    assert_static (sealed_match_value accepted_sealed) "existential match seal should preserve acceptance"
    assert_static (bool_same (sealed_match_value rejected_sealed) false) "existential match seal should preserve rejection"
    inl bit_dfa_surface = seal_dfa_surface (ends_with_zero ())
