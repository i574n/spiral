    assert_static (dfa_run_agrees (ends_with_zero ()) rejected_input) "bit DFA runner should preserve rejection"
    assert_static (dfa_run_agrees (tri_a_star ()) (input_aaa ())) "ternary star DFA runner should preserve acceptance"
    assert_static (dfa_run_agrees (tri_a_star ()) (input_aab ())) "ternary star DFA runner should preserve rejection"
    assert_static (dfa_run_agrees (tri_ab_star_then_c ()) (input_abac ())) "ternary suffix DFA runner should preserve acceptance"
