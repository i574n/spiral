    assert_static (sealed_dfa_surface_states_normalized tri_dfa_surface) "ternary star DFA states should be normalized"
    assert_static (sealed_dfa_surface_states_normalized tri_complex_dfa_surface) "ternary suffix DFA states should be normalized"
    assert_static (sealed_dfa_surface_nullable_preserved bit_dfa_surface) "bit DFA normalization should preserve nullable"
    assert_static (sealed_dfa_surface_nullable_preserved tri_dfa_surface) "ternary star DFA normalization should preserve nullable"
    assert_static (sealed_dfa_surface_nullable_preserved tri_complex_dfa_surface) "ternary suffix DFA normalization should preserve nullable"
    assert_static (sealed_dfa_surface_ordering_coherent bit_dfa_surface) "bit DFA ordering should be coherent"
    assert_static (sealed_dfa_surface_ordering_coherent tri_dfa_surface) "ternary star DFA ordering should be coherent"
    assert_static (sealed_dfa_surface_ordering_coherent tri_complex_dfa_surface) "ternary suffix DFA ordering should be coherent"
