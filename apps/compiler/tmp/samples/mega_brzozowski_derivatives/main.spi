    assert_static (sealed_minimized_dfa_certified cyclic_minimized_surface) "cyclic quotient should be certified"
    assert_static (sealed_dfa_surface_closed bit_dfa_surface) "bit DFA closure should be closed"
    assert_static (sealed_dfa_surface_closed tri_dfa_surface) "ternary star DFA closure should be closed"
    assert_static (sealed_dfa_surface_closed tri_complex_dfa_surface) "ternary suffix DFA closure should be closed"
