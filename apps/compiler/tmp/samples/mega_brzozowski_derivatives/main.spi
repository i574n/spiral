    ) "boolean-only normalization observation must be able to miss a bad candidate"
    assert_static (
        bool_same
            (normalization_remainder_candidate_law normalization_boolean_blind_source normalization_boolean_blind_input normalization_boolean_blind_candidate)
            false
    ) "remainder-set normalization law must distinguish a bad candidate hidden by the final boolean"
    inl bit_suffix_corpus = input_corpus_depth_two bit_symbols
    inl tri_suffix_corpus = input_corpus_depth_two tri_symbols
    assert_static (derivative_language_law_corpus bit_bases bit_symbols bit_suffix_corpus) "direct-language oracle should validate bit derivative law corpus"
    inl tri_law_corpus = RegexListCons (tri_a_star (), RegexListCons (tri_ab_star_then_c (), RegexListNil))
    assert_static (derivative_language_law_corpus tri_law_corpus tri_symbols tri_suffix_corpus) "direct-language oracle should validate ternary derivative law corpus"
    inl theorem_boundary_probe =
        RegexAlt (
            RegexEmpty,
            RegexAlt (
                RegexEpsilon,
                RegexCat (
                    RegexStar (RegexAlt (RegexChar (zero ()), RegexChar (one ()))),
                    RegexChar (zero ()))))
    assert_static (derivative_semantic_triangle_symbols theorem_boundary_probe bit_symbols bit_suffix_corpus) "structural semantic triangle should cover every regex constructor"
    assert_static (derivative_semantic_triangle_symbols (tri_ab_star_then_c ()) tri_symbols tri_suffix_corpus) "structural semantic triangle should hold for ternary composite regex"
    inl nullable_remainder_probe = RegexStar (RegexChar (zero ()))
    inl nullable_probe_input = InputCons (zero (), InputEmpty)
    inl raw_source_remainders = language_remainders nullable_remainder_probe nullable_probe_input
    inl raw_derivative_remainders = language_remainders (canonical_derivative nullable_remainder_probe (zero ())) InputEmpty
    assert_static (bool_same (input_list_set_equal raw_source_remainders raw_derivative_remainders) false) "raw remainder equality must expose the nullable zero-consumption remainder"
    assert_static (derivative_remainder_candidate_law nullable_remainder_probe (zero ()) InputEmpty (canonical_derivative nullable_remainder_probe (zero ()))) "derivative remainder law should remove only the zero-consumption remainder"
    inl bit_suffix = InputCons (one (), InputCons (zero (), InputEmpty))
    inl tri_suffix = InputCons (tri_a (), InputCons (tri_a (), InputEmpty))
    assert_static (derivative_step_agrees RegexEmpty (zero ()) InputEmpty) "empty derivative step should preserve language"
    assert_static (derivative_step_agrees RegexEpsilon (zero ()) InputEmpty) "epsilon derivative step should preserve language"
    assert_static (derivative_step_agrees (RegexChar (zero ())) (zero ()) bit_suffix) "matching-char derivative step should preserve language"
    assert_static (derivative_step_agrees (RegexChar (zero ())) (one ()) bit_suffix) "mismatching-char derivative step should preserve language"
    assert_static (derivative_step_agrees (RegexAlt (RegexChar (zero ()), RegexChar (one ()))) (one ()) bit_suffix) "alternative derivative step should preserve language"
    assert_static (derivative_step_agrees (RegexCat (RegexChar (zero ()), RegexChar (one ()))) (zero ()) bit_suffix) "nonnullable concatenation derivative step should preserve language"
    assert_static (derivative_step_agrees (RegexCat (RegexEpsilon, RegexChar (one ()))) (one ()) bit_suffix) "nullable concatenation derivative step should preserve language"
    assert_static (derivative_step_agrees (RegexStar (RegexChar (zero ()))) (zero ()) bit_suffix) "star derivative step should preserve language"
    assert_static (derivative_step_agrees (ends_with_zero ()) (one ()) bit_suffix) "composite one derivative step should preserve language"
    assert_static (derivative_step_agrees (ends_with_zero ()) (zero ()) bit_suffix) "composite zero derivative step should preserve language"
    assert_static (derivative_step_agrees (tri_a_star ()) (tri_a ()) tri_suffix) "ternary derivative step should preserve language"
    assert_static (derivative_step_agrees (RegexCat (RegexStar (RegexChar (zero ())), RegexChar (one ()))) (zero ()) bit_suffix) "star-concatenation derivative step should preserve language"
