    assert_static (bool_same (accepts (tri_ab_star_then_c ()) (input_abab ())) false) "ternary suffix matcher should reject the negative case"
    assert_true (accepts RegexEpsilon empty_input)
    assert_false (accepts RegexEmpty empty_input)
