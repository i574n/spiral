    assert_static (dfa_run_minimized_agrees (tri_a_star ()) (input_aab ())) "ternary minimized runner should preserve rejection"
    assert_static (dfa_run_minimized_agrees (tri_cyclic_nonminimal ()) (input_aaa ())) "cyclic quotient should preserve acceptance"
    assert_static (dfa_run_minimized_agrees (tri_cyclic_nonminimal ()) (input_aab ())) "cyclic quotient should preserve rejection"
    inl canonical_alt = RegexAlt (RegexChar (zero ()), RegexChar (one ()))
    inl duplicate_commuted_alt =
        RegexAlt (
            RegexChar (one ()),
            RegexAlt (RegexChar (zero ()), RegexChar (one ())))
    inl commuted_alt = RegexAlt (RegexChar (one ()), RegexChar (zero ()))
    inl associated_cat_left =
        RegexCat (RegexCat (RegexChar (zero ()), RegexEpsilon), RegexChar (one ()))
    inl associated_cat_right =
        RegexCat (RegexChar (zero ()), RegexCat (RegexEpsilon, RegexChar (one ())))
    inl nested_star = RegexStar (RegexStar (RegexChar (zero ())))
    inl flat_star = RegexStar (RegexChar (zero ()))
