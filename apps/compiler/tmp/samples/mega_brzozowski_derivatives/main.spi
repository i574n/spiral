    inl _ : matcher_batch derivative_language_family (bit_alphabet * tri_alphabet) =
        matcher_batch_map `$run_derivative_corpus_program derivative_corpus_program_batch
    inl bit_corpus_family = run_derivative_corpus_program (capture_derivative_corpus_program bit_corpus)
