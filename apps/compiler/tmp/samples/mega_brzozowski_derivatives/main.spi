    assert_static (canonical_acceptance_agrees (ends_with_zero ()) (input_111 ())) "bit reference matcher should agree on rejection"
    assert_static (canonical_acceptance_agrees (tri_a_star ()) (input_aaa ())) "ternary reference matcher should agree on acceptance"
    assert_static (canonical_acceptance_agrees (tri_a_star ()) (input_aab ())) "ternary reference matcher should agree on rejection"
    assert_static (canonical_acceptance_agrees (tri_ab_star_then_c ()) (input_abac ())) "ternary suffix reference matcher should agree on acceptance"
    assert_static (canonical_acceptance_agrees (tri_ab_star_then_c ()) (input_abab ())) "ternary suffix reference matcher should agree on rejection"
    assert_static (independent_acceptance_agrees (ends_with_zero ()) (input_110 ())) "bit direct-language oracle should agree on acceptance"
    assert_static (independent_acceptance_agrees (ends_with_zero ()) (input_111 ())) "bit direct-language oracle should agree on rejection"
    assert_static (independent_acceptance_agrees (tri_a_star ()) (input_aaa ())) "ternary direct-language oracle should agree on acceptance"
    assert_static (independent_acceptance_agrees (tri_a_star ()) (input_aab ())) "ternary direct-language oracle should agree on rejection"
    assert_static (independent_acceptance_agrees (tri_ab_star_then_c ()) (input_abac ())) "ternary suffix direct-language oracle should agree on acceptance"
    assert_static (independent_acceptance_agrees (tri_ab_star_then_c ()) (input_abab ())) "ternary suffix direct-language oracle should agree on rejection"
    inl normalization_boolean_blind_source = RegexStar (RegexChar (zero ()))
    inl normalization_boolean_blind_input = InputCons (zero (), InputCons (one (), InputEmpty))
    inl normalization_boolean_blind_candidate : regex bit_alphabet = RegexEmpty
    assert_static (
        bool_same
            (language_accepts normalization_boolean_blind_source normalization_boolean_blind_input)
