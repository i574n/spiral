    assert_static (sealed_dfa_surface_certified tri_dfa_surface) "ternary star DFA surface should be certified"
    assert_static (sealed_dfa_surface_certified tri_complex_dfa_surface) "ternary suffix DFA surface should be certified"
    inl tri_abc_closure = dfa_closure (tri_abc_sequence ())
    assert_static (bool_same (regex_list_within_budget tri_abc_closure (state_budget_four ())) false) "three-symbol sequence should exceed the four-state budget"
    assert_static (regex_list_within_budget tri_abc_closure (state_budget_eight ())) "three-symbol sequence should fit the eight-state budget"
    assert_static (canonical_closure_within_position_subset_bound (ends_with_zero ())) "bit canonical closure should stay within its structural position-subset bound"
    assert_static (canonical_closure_within_position_subset_bound (tri_ab_star_then_c ())) "ternary suffix closure should stay within its structural position-subset bound"
    assert_static (minimized_within_position_subset_bound (ends_with_zero ())) "bit minimized DFA should stay within its structural position-subset bound"
    assert_static (minimized_within_position_subset_bound (tri_cyclic_nonminimal ())) "cyclic minimized DFA should stay within its structural position-subset bound"
