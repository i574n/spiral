    assert_static (canonical_derivative_coherent_corpus tri_constructor_corpus tri_symbols) "ternary constructor corpus should commute canonical derivation with prior normalization"
    assert_static (dfa_partition_one_distinct (dfa_closure (ends_with_zero ())) bit_symbols) "bit DFA one-step signatures should be distinct"
    assert_static (dfa_partition_one_distinct (dfa_closure (tri_a_star ())) tri_symbols) "ternary star one-step signatures should be distinct"
    assert_static (dfa_partition_one_distinct (dfa_closure (tri_ab_star_then_c ())) tri_symbols) "ternary suffix one-step signatures should be distinct"
    assert_static (dfa_minimal_by_bisimulation (dfa_closure (ends_with_zero ())) bit_symbols) "bit DFA should be behaviorally minimal"
    assert_static (dfa_minimal_by_bisimulation (dfa_closure (tri_a_star ())) tri_symbols) "ternary star DFA should be behaviorally minimal"
    assert_static (dfa_minimal_by_bisimulation (dfa_closure (tri_ab_star_then_c ())) tri_symbols) "ternary suffix DFA should be behaviorally minimal"
