    assert_static (dfa_formula_consistent bit_corpus bit_symbols) "generated derivative equations should hold structurally"
    assert_static (dfa_states_nullable_preserved bit_corpus) "generated corpus should preserve nullable under normalization"
    assert_static (regex_list_normalization_idempotent bit_corpus) "generated corpus normalization should be idempotent"
