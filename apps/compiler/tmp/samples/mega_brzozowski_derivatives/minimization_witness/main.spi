:< main

:~ ^ dfa_state_distinct_with_witness_against \* alphabet {symbol_compare}.
    (head : regex alphabet)
    (tail : regex_list alphabet)
    (symbols : symbol_list alphabet)
    : bool =
    ?= tail ?|
    | RegexListNil => !+
    | RegexListCons (state, rest) =>
        := result = dfa_constructive_distinguishing_result head state symbols
        ?= result ?|
        | DfaConstructiveEquivalent => !-
        | DfaConstructiveDistinguished _ =>
            ? dfa_constructive_distinguishing_result_valid head state symbols result ?>
                dfa_state_distinct_with_witness_against head rest symbols
            |: !-

:~ ^ dfa_minimal_with_distinguishing_witnesses \* alphabet {symbol_compare}.
    (states : regex_list alphabet)
    (symbols : symbol_list alphabet)
    : bool =
    ?= states ?|
    | RegexListNil => !+
    | RegexListCons (head, tail) =>
        ? dfa_state_distinct_with_witness_against head tail symbols ?>
            dfa_minimal_with_distinguishing_witnesses tail symbols
        |: !-

:~ ^ regex_list_exact_budget \* alphabet.
    (states : regex_list alphabet)
    (budget : state_budget)
    : bool =
    ?= states, budget ?|
    | RegexListNil, StateBudgetZero => !+
    | RegexListCons (_, rest), StateBudgetSucc remaining => regex_list_exact_budget rest remaining
    | _ => !-

:= state_budget_two_local () : state_budget =
    StateBudgetSucc (StateBudgetSucc StateBudgetZero)

:= state_budget_three_local () : state_budget =
    StateBudgetSucc (state_budget_two_local ())

:= minimized_representative_count_matches \* alphabet {symbol_compare; finite_alphabet}.
    (start : regex alphabet)
    (expected : state_budget)
    : bool =
    := descriptor : finite_alphabet_descriptor alphabet = finite_alphabet ()
    ?= certify_alphabet_inventory descriptor ?|
    | AlphabetInventoryRejected => !-
    | AlphabetInventoryCertified inventory =>
        := certified_symbols = certified_alphabet_inventory_symbols inventory
        ?= dfa_closure_bounded_with_inventory (normalize start) certified_symbols ?|
        | DfaClosureBudgetExceeded _ => !-
        | DfaClosureComplete closure =>
            := representatives = dfa_minimize_states closure certified_symbols
            regex_list_exact_budget representatives expected

:= minimized_witness_surface \* alphabet {symbol_compare; finite_alphabet}.
    (start : regex alphabet) : bool =
    := descriptor : finite_alphabet_descriptor alphabet = finite_alphabet ()
    ?= certify_alphabet_inventory descriptor ?|
    | AlphabetInventoryRejected => !-
    | AlphabetInventoryCertified inventory =>
        := certified_symbols = certified_alphabet_inventory_symbols inventory
        ?= dfa_closure_bounded_with_inventory (normalize start) certified_symbols ?|
        | DfaClosureBudgetExceeded _ => !-
        | DfaClosureComplete closure =>
            := representatives = dfa_minimize_states closure certified_symbols
            dfa_minimal_with_distinguishing_witnesses representatives certified_symbols

:= main () : string =
    assert_static
        (minimized_witness_surface (ends_with_zero ()))
        "bit minimized DFA representatives should carry independent distinguishing words"
    assert_static
        (minimized_witness_surface (tri_a_star ()))
        "ternary star minimized DFA representatives should carry independent distinguishing words"
    assert_static
        (minimized_witness_surface (tri_cyclic_nonminimal ()))
        "cyclic quotient representatives should carry independent distinguishing words"
    assert_static
        (minimized_representative_count_matches (ends_with_zero ()) (state_budget_two_local ()))
        "bit minimized DFA should match the independent two-state reference quotient"
    assert_static
        (minimized_representative_count_matches (tri_a_star ()) (state_budget_two_local ()))
        "ternary star minimized DFA should match the independent two-state reference quotient"
    assert_static
        (minimized_representative_count_matches (tri_cyclic_nonminimal ()) (state_budget_three_local ()))
        "cyclic minimized DFA should match the independent three-state reference quotient"

    := bit_symbols : symbol_list bit_alphabet = finite_alphabet_symbols (finite_alphabet ())
    := epsilon_bit : regex bit_alphabet = RegexEpsilon
    := empty_bit : regex bit_alphabet = RegexEmpty
    := epsilon_vs_empty = dfa_constructive_distinguishing_result epsilon_bit empty_bit bit_symbols
    assert_static
        (dfa_constructive_distinguishing_result_valid epsilon_bit empty_bit bit_symbols epsilon_vs_empty)
        "nullable mismatch should produce a language-valid distinguishing word"
    := forged_nonwitness : dfa_constructive_distinguishing_result bit_alphabet =
        DfaConstructiveDistinguished (InputCons (zero (), InputEmpty))
    assert_static
        (
            bool_same
                (dfa_constructive_distinguishing_result_valid epsilon_bit empty_bit bit_symbols forged_nonwitness)
                !-
        )
        "independent language semantics must reject a forged non-distinguishing word"

    := duplicate_alt : regex bit_alphabet = RegexAlt (RegexChar (zero ()), RegexChar (zero ()))
    := single_zero : regex bit_alphabet = RegexChar (zero ())
    := equivalent_result = dfa_constructive_distinguishing_result duplicate_alt single_zero bit_symbols
    assert_static
        (dfa_constructive_distinguishing_result_valid duplicate_alt single_zero bit_symbols equivalent_result)
        "normalized language-equivalent states should remain bisimilar"

    "brzozowski-minimization-witness-green"
