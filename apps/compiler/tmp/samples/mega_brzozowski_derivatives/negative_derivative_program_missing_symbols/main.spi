:| symbol_ordering =
    | SymbolLess
    | SymbolSame
    | SymbolGreater

:? symbol_compare alphabet : alphabet -> alphabet -> symbol_ordering

:| ^ regex alphabet =
    | RegexEmpty
    | RegexEpsilon
    | RegexChar : alphabet
    | RegexAlt : regex alphabet * regex alphabet
    | RegexCat : regex alphabet * regex alphabet
    | RegexStar : regex alphabet

:| ^ regex_list alphabet =
    | RegexListNil
    | RegexListCons : regex alphabet * regex_list alphabet

:| ^ symbol_list alphabet =
    | SymbolListNil
    | SymbolListCons : alphabet * symbol_list alphabet

:| ^ linear_input alphabet =
    | InputEmpty
    | InputCons : alphabet * linear_input alphabet

:? finite_alphabet alphabet : () -> symbol_list alphabet

:| derivative_language_program alphabet =
    | DerivativeLanguageProgram : regex alphabet * symbol_list alphabet

:= capture_derivative_language_program \* alphabet {symbol_compare; finite_alphabet}.
    (value : regex alphabet)
    : derivative_language_program alphabet
    =
    DerivativeLanguageProgram (value, finite_alphabet ())

:| law_only_symbol =
    | LawOnly

:! law_only_alphabet = law_only_symbol

:+ symbol_compare law_only_alphabet = \ _ _ => SymbolSame

:= main () =
    capture_derivative_language_program (RegexChar (law_only_alphabet LawOnly))
