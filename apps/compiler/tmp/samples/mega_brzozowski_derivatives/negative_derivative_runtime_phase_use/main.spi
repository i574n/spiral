:< main

:= checked_only (state : derivative_runtime_state root_bit_alphabet derivative_runtime_checked) : bool =
    derivative_runtime_checked_value state

:= main () =
    := ~suffix = root_input_110 ()
    := raw : derivative_runtime_state root_bit_alphabet derivative_runtime_raw =
        DerivativeRuntimeRaw (root_ends_with_zero (), root_zero (), suffix)
    checked_only raw
