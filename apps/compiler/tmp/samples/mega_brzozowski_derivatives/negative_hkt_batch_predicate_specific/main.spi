open main

inl bit_only_program_predicate (program : matcher_program bit_alphabet) : bool =
    matcher_program_passes program

inl main () =
    inl batch : matcher_batch matcher_program (bit_alphabet * tri_alphabet) =
        MatchBatchPair (
            MatchBatchSingle (capture_acceptance_program (ends_with_zero ()) (input_110 ()) true),
            MatchBatchSingle (capture_acceptance_program (tri_a_star ()) (input_aab ()) false)
        )
    matcher_batch_forall `$bit_only_program_predicate batch
