:< main

:= bit_only_program_predicate (program : matcher_program bit_alphabet) : bool =
    matcher_program_passes program

:= main () =
    := batch : matcher_batch matcher_program (bit_alphabet * tri_alphabet) =
        MatchBatchPair (
            MatchBatchSingle (capture_acceptance_program (ends_with_zero ()) (input_110 ()) !+),
            MatchBatchSingle (capture_acceptance_program (tri_a_star ()) (input_aab ()) !-)
        )
    matcher_batch_forall `$bit_only_program_predicate batch
