:< main

:= main () =
    := normalization : derivative_normalization_capability root_bit_alphabet =
        derivative_normalization_capability_default
    := raw : derivative_pipeline root_bit_alphabet derivative_unchecked =
        derivative_pipeline_begin (root_ends_with_zero ()) (root_zero ())
    := normalized : derivative_pipeline root_bit_alphabet derivative_normalized =
        derivative_pipeline_normalize normalization raw
    seal_verified_derivative normalized
