:< main
:< runtime_workload
:< runtime_interned

:= same_counts (left : i32 * i32 * i32) (right : i32 * i32 * i32) : () =
    ?= left, right ?|
    | (a, b, c), (x, y, z) =>
        ? i32_eq a x && i32_eq b y && i32_eq c z ?> () |: failwith "brzozowski-bench-engines-disagree"

:= main () : i32 =
    := derivative = run_workloads EngineDerivative 200i32 32i32 16i32
    same_counts derivative (run_workloads EngineBacktrack 200i32 32i32 16i32)
    same_counts derivative (run_workloads EngineStaged 200i32 32i32 16i32)
    same_counts derivative (run_interned_workloads 200i32 32i32 16i32)
    expect_counts derivative 93i32 97i32 16i32
