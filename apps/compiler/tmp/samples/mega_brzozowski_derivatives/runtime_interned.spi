:< main
:< runtime_workload

:! i32_array = array_base i32

:= i32_array_create (size : i32) : i32_array = i32_array !!!!ArrayCreate(`i32, size)
:= i32_array_get (array : i32_array) (i : i32) : i32 =
    ?= array ?|
    | i32_array values => !!!!ArrayIndex(values, i)
:= i32_array_set (array : i32_array) (i : i32) (value : i32) : () =
    ?= array ?|
    | i32_array values => !!!!ArrayIndexSet(values, i, value)

:= i32_array_fill (array : i32_array) (size : i32) (value : i32) : () =
    :~ ^ loop (i : i32) : () =
        ? i32_lt i size ?>
            i32_array_set array i value
            loop (i32_add i 1i32)
        |: ()
    loop 0i32

:= i32_mul (a : i32) (b : i32) : i32 = !!!!Mult(a, b)
:= i32_and (a : i32) (b : i32) : i32 = !!!!BitwiseAnd(a, b)

:= interned_node_capacity () : i32 = 4096i32
:= interned_table_mask () : i32 = 8191i32

:! interned_store = i32_array * i32_array * i32_array * i32_array * i32_array * i32_array * i32_array

:= interned_kinds (store : interned_store) : i32_array =
    ?= store ?|
    | interned_store (kinds, _, _, _, _, _, _) => kinds
:= interned_lefts (store : interned_store) : i32_array =
    ?= store ?|
    | interned_store (_, lefts, _, _, _, _, _) => lefts
:= interned_rights (store : interned_store) : i32_array =
    ?= store ?|
    | interned_store (_, _, rights, _, _, _, _) => rights
:= interned_nullables (store : interned_store) : i32_array =
    ?= store ?|
    | interned_store (_, _, _, nullables, _, _, _) => nullables
:= interned_table (store : interned_store) : i32_array =
    ?= store ?|
    | interned_store (_, _, _, _, table, _, _) => table
:= interned_derivatives (store : interned_store) : i32_array =
    ?= store ?|
    | interned_store (_, _, _, _, _, derivatives, _) => derivatives
:= interned_count (store : interned_store) : i32_array =
    ?= store ?|
    | interned_store (_, _, _, _, _, _, count) => count

:= interned_kind (store : interned_store) (node : i32) : i32 = i32_array_get (interned_kinds store) node
:= interned_left (store : interned_store) (node : i32) : i32 = i32_array_get (interned_lefts store) node
:= interned_right (store : interned_store) (node : i32) : i32 = i32_array_get (interned_rights store) node
:= interned_nullable (store : interned_store) (node : i32) : bool =
    i32_eq (i32_array_get (interned_nullables store) node) 1i32

:= interned_hash (kind : i32) (left : i32) (right : i32) : i32 =
    i32_and (i32_add (i32_mul (i32_add (i32_mul kind 1024i32) left) 4099i32) right) (interned_table_mask ())

:~ interned_node (store : interned_store) (kind : i32) (left : i32) (right : i32) : i32 =
    :~ ^ probe (slot : i32) : i32 =
        := entry = i32_array_get (interned_table store) slot
        ? i32_eq entry 0i32
        ?>
            := node = i32_array_get (interned_count store) 0i32
            ? i32_lt node (interned_node_capacity ())
            ?>
                i32_array_set (interned_kinds store) node kind
                i32_array_set (interned_lefts store) node left
                i32_array_set (interned_rights store) node right
                := nullable =
                    ? i32_eq kind 1i32
                    ?> !+
                    |? i32_eq kind 5i32
                    ?> !+
                    |? i32_eq kind 3i32
                    ?>
                        ? interned_nullable store left
                        ?> !+
                        |: interned_nullable store right
                    |? i32_eq kind 4i32
                    ?> interned_nullable store left && interned_nullable store right
                    |: !-
                i32_array_set (interned_nullables store) node (? nullable ?> 1i32 |: 0i32)
                i32_array_set (interned_table store) slot (i32_add node 1i32)
                i32_array_set (interned_count store) 0i32 (i32_add node 1i32)
                node
            |: failwith "brzozowski-interned-store-full"
        |:
            := node = i32_sub entry 1i32
            ?
                i32_eq (interned_kind store node) kind
                && i32_eq (interned_left store node) left
                && i32_eq (interned_right store node) right
            ?> node
            |: probe (i32_and (i32_add slot 1i32) (interned_table_mask ()))
    probe (interned_hash kind left right)

:= interned_empty () : i32 = 0i32
:= interned_epsilon () : i32 = 1i32

:= interned_store_create () : interned_store =
    := capacity = interned_node_capacity ()
    := store =
        interned_store (
            i32_array_create capacity,
            i32_array_create capacity,
            i32_array_create capacity,
            i32_array_create capacity,
            i32_array_create (i32_add (interned_table_mask ()) 1i32),
            i32_array_create (i32_mul capacity 2i32),
            i32_array_create 1i32)
    i32_array_fill (interned_table store) (i32_add (interned_table_mask ()) 1i32) 0i32
    i32_array_fill (interned_derivatives store) (i32_mul capacity 2i32) 0i32
    i32_array_fill (interned_count store) 1i32 0i32
    := empty = interned_node store 0i32 0i32 0i32
    := epsilon = interned_node store 1i32 0i32 0i32
    ? i32_eq empty (interned_empty ()) && i32_eq epsilon (interned_epsilon ()) ?> store
    |: failwith "brzozowski-interned-store-init"

:~ ^ interned_alt_insert (store : interned_store) (term : i32) (value : i32) : i32 =
    ? i32_eq value (interned_empty ()) ?> term
    |? i32_eq (interned_kind store value) 3i32 ?>
        := head = interned_left store value
        ? i32_lt term head ?> interned_node store 3i32 term value
        |? i32_eq term head ?> value
        |: interned_node store 3i32 head (interned_alt_insert store term (interned_right store value))
    |? i32_lt term value ?> interned_node store 3i32 term value
    |? i32_eq term value ?> value
    |: interned_node store 3i32 value term

:~ ^ interned_make_alt (store : interned_store) (left : i32) (right : i32) : i32 =
    ? i32_eq left (interned_empty ()) ?> right
    |? i32_eq (interned_kind store left) 3i32 ?>
        interned_make_alt store (interned_right store left) (interned_alt_insert store (interned_left store left) right)
    |: interned_alt_insert store left right

:~ ^ interned_make_cat (store : interned_store) (left : i32) (right : i32) : i32 =
    ? i32_eq left (interned_empty ()) ?> interned_empty ()
    |? i32_eq right (interned_empty ()) ?> interned_empty ()
    |? i32_eq left (interned_epsilon ()) ?> right
    |? i32_eq right (interned_epsilon ()) ?> left
    |? i32_eq (interned_kind store left) 5i32 && i32_eq (interned_kind store right) 5i32 ?>
        ? i32_eq (interned_left store left) (interned_left store right) ?> left
        |: interned_node store 4i32 left right
    |? i32_eq (interned_kind store left) 4i32 ?>
        interned_node store 4i32 (interned_left store left) (interned_make_cat store (interned_right store left) right)
    |: interned_node store 4i32 left right

:= interned_make_star (store : interned_store) (value : i32) : i32 =
    := kind = interned_kind store value
    ? i32_lt kind 2i32 ?> interned_epsilon ()
    |? i32_eq kind 5i32 ?> value
    |: interned_node store 5i32 value 0i32

:= bit_symbol_index (symbol : bit_alphabet) : i32 =
    ?= symbol ?|
    | bit_alphabet bit =>
        ?= bit ?|
        | BitZero => 0i32
        | BitOne => 1i32

:~ ^ interned_of_regex_raw (store : interned_store) (value : regex bit_alphabet) : i32 =
    ?= value ?|
    | RegexEmpty => interned_empty ()
    | RegexEpsilon => interned_epsilon ()
    | RegexChar symbol => interned_node store 2i32 (bit_symbol_index symbol) 0i32
    | RegexAlt (left, right) =>
        interned_make_alt store (interned_of_regex_raw store left) (interned_of_regex_raw store right)
    | RegexCat (left, right) =>
        interned_make_cat store (interned_of_regex_raw store left) (interned_of_regex_raw store right)
    | RegexStar inner => interned_make_star store (interned_of_regex_raw store inner)

:! interned_regex = i32
:! bit_slot = i32

:= bit_symbol_slot (symbol : bit_alphabet) : bit_slot = bit_slot (bit_symbol_index symbol)

:= interned_of_regex (store : interned_store) (value : regex bit_alphabet) : interned_regex =
    interned_regex (interned_of_regex_raw store value)

:~ ^ interned_derivative_raw (store : interned_store) (node : i32) (symbol : i32) : i32 =
    := slot = i32_add (i32_mul node 2i32) symbol
    := cached = i32_array_get (interned_derivatives store) slot
    ? i32_eq cached 0i32
    ?>
        := kind = interned_kind store node
        := result =
            ? i32_lt kind 2i32
            ?> interned_empty ()
            |? i32_eq kind 2i32
            ?>
                ? i32_eq (interned_left store node) symbol
                ?> interned_epsilon ()
                |: interned_empty ()
            |? i32_eq kind 3i32
            ?>
                interned_make_alt store
                    (interned_derivative_raw store (interned_left store node) symbol)
                    (interned_derivative_raw store (interned_right store node) symbol)
            |? i32_eq kind 4i32
            ?>
                := left = interned_left store node
                := right = interned_right store node
                := left_then_right = interned_make_cat store (interned_derivative_raw store left symbol) right
                ? interned_nullable store left
                ?> interned_make_alt store left_then_right (interned_derivative_raw store right symbol)
                |: left_then_right
            |: interned_make_cat store (interned_derivative_raw store (interned_left store node) symbol) node
        i32_array_set (interned_derivatives store) slot (i32_add result 1i32)
        result
    |: i32_sub cached 1i32

:= interned_derivative (store : interned_store) (node : interned_regex) (symbol : bit_slot) : interned_regex =
    ?= node, symbol ?|
    | interned_regex raw_node, bit_slot raw_symbol => interned_regex (interned_derivative_raw store raw_node raw_symbol)

:~ interned_accepts (store : interned_store) (start : interned_regex) (input : linear_input bit_alphabet) : bool =
    :~ ^ loop (node : interned_regex) (input : linear_input bit_alphabet) : bool =
        ?= node ?|
        | interned_regex raw_node =>
            ? i32_eq raw_node (interned_empty ()) ?> !-
            |:
                ?= input ?|
                | InputEmpty => interned_nullable store raw_node
                | InputCons (symbol, rest) => loop (interned_derivative store node (bit_symbol_slot symbol)) rest
    loop start input

:= interned_count_random (store : interned_store) (value : regex bit_alphabet) (length : i32) (count : i32) : i32 =
    := ~dynamic = value
    := start = interned_of_regex store dynamic
    :~ ^ loop (count : i32) (seed : u64) (accepted : i32) : i32 =
        ? i32_lt 0i32 count ?>
            ?= random_bit_input seed length InputEmpty ?|
            | input, next =>
                := accepted = ? interned_accepts store start input ?> i32_add accepted 1i32 |: accepted
                loop (i32_sub count 1i32) next accepted
        |: accepted
    := ~seed = 1u64
    := ~none = 0i32
    loop count seed none

:= interned_count_zero_runs (store : interned_store) (value : regex bit_alphabet) (max : i32) : i32 =
    := ~dynamic = value
    := start = interned_of_regex store dynamic
    :~ ^ loop (n : i32) (accepted : i32) : i32 =
        ? i32_lt max n
        ?> accepted
        |:
            := accepted =
                ? interned_accepts store start (zeros_input n InputEmpty)
                ?> i32_add accepted 1i32
                |: accepted
            := accepted =
                ? interned_accepts store start (zeros_input n (InputCons (one (), InputEmpty)))
                ?> i32_add accepted 1i32
                |: accepted
            loop (i32_add n 1i32) accepted
    := ~first = 1i32
    := ~none = 0i32
    loop first none

:= run_interned_random_workloads (~count : i32) (~length : i32) : i32 * i32 =
    := store = interned_store_create ()
    interned_count_random store (ends_with_zero ()) length count,
    interned_count_random store (fourth_from_end_one ()) length count

:= run_interned_zero_runs (~max_zero_run : i32) : i32 =
    := store = interned_store_create ()
    interned_count_zero_runs store (zero_or_two_zeros_then_one ()) max_zero_run

:= run_interned_workloads (count : i32) (length : i32) (max_zero_run : i32) : i32 * i32 * i32 =
    ?= run_interned_random_workloads count length ?|
    | a, b => a, b, run_interned_zero_runs max_zero_run
