:< main

:= main () : string =
    := ~accepted_input = input_110 ()
    := ~rejected_input = input_111 ()
    assert_true (accepts (ends_with_zero ()) accepted_input)
    assert_false (accepts (ends_with_zero ()) rejected_input)
    := accepted_state = decide_bit_match (BitMatcherRaw (ends_with_zero (), accepted_input))
    := rejected_state = decide_bit_match (BitMatcherRaw (ends_with_zero (), rejected_input))
    assert_true (bit_match_value accepted_state)
    assert_false (bit_match_value rejected_state)
    "brzozowski-runtime-smoke-green"
