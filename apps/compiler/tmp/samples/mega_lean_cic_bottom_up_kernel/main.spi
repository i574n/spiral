:= assert_cic_corrected_context_extension_identity_runtime
    (base_steps : i64) (left_steps : i64) (right_steps : i64)
    (base_size : i64) (left_size : i64) (right_size : i64)
    : ()
    =
    := ok_0 = !!!!EQ(base_steps, 3i64)
    := ok_1 = !!!!EQ(left_steps, base_steps)
    := ok_2 = !!!!EQ(right_steps, base_steps)
    := ok_3 = !!!!EQ(left_size, base_size)
    := ok_4 = !!!!EQ(right_size, base_size)
