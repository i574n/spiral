:= corrected_cic_recursive_single_unary_inner_application_intrinsic () :
    corrected_cic_scoped_application_intrinsic_defeq
        empty_ctx (universe_sort universe_one) (universe_sort universe_one) =
    := universe_value = universe_sort (universe_one "u1")
    := scope =
        corrected_cic_shared_domain_scope_of_binder (corrected_cic_recursive_codomain_binder ())
    := function_term :
        corrected_cic_term empty_ctx
            (function_sort (universe_sort universe_one) (universe_sort universe_one)) =
        CorrectedConstant (
            constant_name (
                function_sort (universe_value, universe_value),
