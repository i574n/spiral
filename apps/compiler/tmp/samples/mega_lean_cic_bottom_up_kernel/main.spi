:= cic_corrected_contextual_identity_beta_terminal () : string =
    := let_binder =
        corrected_cic_generic_binder
            (empty_ctx "empty")
            (bool_sort "Bool")
    := lambda_binder_one =
        corrected_cic_generic_binder
            (ctx_extend (empty_ctx "empty", bool_sort "Bool"))
            (bool_sort "Bool")
    := lambda_binder_two =
        corrected_cic_generic_binder
            (ctx_extend (
                ctx_extend (empty_ctx "empty", bool_sort "Bool"),
                bool_sort "Bool"))
            (bool_sort "Bool")
    := step
        : corrected_cic_generic_identity_beta_step
            (ctx_extend (ctx_extend (ctx_extend empty_ctx bool_sort) bool_sort) bool_sort) bool_sort
        =
        CorrectedCicGenericIdentityBetaStep (
            ctx_extend (
                ctx_extend (
                    ctx_extend (empty_ctx "empty", bool_sort "Bool"),
                    bool_sort "Bool"),
                bool_sort "Bool"),
            bool_sort "Bool",
            CorrectedBoundHere lambda_binder_two,
            "the-directed-beta-step-occurs-below-one-let-and-two-lambda-binders")
    := reduction =
        CicCorrectedContextualIdentityBetaLet (\? (
            let_binder,
            corrected_cic_true (),
            CicCorrectedContextualIdentityBetaLambda (
                lambda_binder_one,
                CicCorrectedContextualIdentityBetaLambda (
                    lambda_binder_two,
                    CicCorrectedContextualIdentityBetaBase (
                        step,
                        "the-base-step-is-the-only-source-of-the-contractum"),
                    "the-second-lambda-is-derived-around-both-endpoints"),
                "the-first-lambda-is-derived-around-both-endpoints"),
            "the-let-frame-is-derived-around-both-endpoints"))
    := source_size, target_size, depth, source_tag, target_tag =
        cic_corrected_contextual_identity_beta_runtime reduction
    := _ =
        assert_cic_corrected_contextual_identity_beta_runtime
            source_size target_size depth source_tag target_tag
    "lambda-and-let-transport-now-share-one-recursive-context-frame-relation-so-an-arbitrarily-nested-stack-can-der"
