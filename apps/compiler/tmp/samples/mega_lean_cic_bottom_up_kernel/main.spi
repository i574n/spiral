    corrected_cic_recursive_sort_zero_replay_metric_consistency_authority (
        consistency,
        application_spine,
        "recursive-Sort-zero-B-of-a-over-x-now-derives-all-term-metrics-from-the-application-spine-authority-which-already-owns-the-two-indexed-targets-instead-of-storing-them-again")

inl corrected_cic_recursive_sort_zero_replay_metric_consistency_authority_note
