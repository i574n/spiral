:= corrected_cic_conversion_constraint_program_accepted_with_recursive_codomain () =
    := application :
        corrected_cic_recursive_codomain_application
            (corrected_cic_substituted_codomain
                (corrected_cic_recursive_codomain_unary
                    (corrected_cic_recursive_codomain_unary
                        corrected_cic_recursive_codomain_identity))
                corrected_cic_closed_type_code_bool) =
        CorrectedCicRecursiveCodomainApplication (
            corrected_cic_recursive_double_unary_codomain_program (),
            CorrectedCicClosedTypeCodeBool
                "Bool-is-the-recursive-codomain-argument-code",
            "the-recursive-codomain-program-is-instantiated-at-Bool")
    ?= application ?|
    | CorrectedCicRecursiveCodomainApplication (program, argument_code, _) =>
        := certificate =
            corrected_cic_dependent_beta_contractum_make
                (corrected_cic_recursive_codomain_binder ())
                (corrected_cic_recursive_codomain_program_body program)
                (corrected_cic_closed_type_code_term argument_code)
        ?= certificate ?|
        | corrected_cic_dependent_beta_contractum (_, substituted_codomain) =>
            ?= substituted_codomain ?|
            | corrected_cic_dependent_substituted_codomain_index result =>
                ?= result ?|
                | corrected_cic_parametric_substitution_result (_, _, recursive_target) =>
                    := expected_recursive_target =
                        corrected_cic_recursive_codomain_program_substitute
                            (corrected_cic_recursive_double_unary_codomain_program ())
                            (
                                CorrectedCicClosedTypeCodeBool (
                                    "Bool-is-the-independent-recursive-target-check-for-the-canonical-recursive-cod"
                                    ^^ "omain-summary-guard"
                                )
                            )
                    := canonical_size = corrected_cic_term_structural_size recursive_target
                    := replay_size = corrected_cic_term_structural_size expected_recursive_target
                    := canonical_constants = corrected_cic_term_constant_count recursive_target
                    := replay_constants = corrected_cic_term_constant_count expected_recursive_target
                    := canonical_bound = corrected_cic_term_bound_here_count recursive_target
                    := replay_bound = corrected_cic_term_bound_here_count expected_recursive_target
                    := canonical_applications = corrected_cic_term_application_count recursive_target
                    := replay_applications = corrected_cic_term_application_count expected_recursive_target
                    := canonical_outer = corrected_cic_term_outer_tag recursive_target
                    := replay_outer = corrected_cic_term_outer_tag expected_recursive_target
                    := _ : () =
                        := ok_0 = !!!!EQ(canonical_size, replay_size)
                        := ok_1 = !!!!EQ(canonical_constants, replay_constants)
                        := ok_2 = !!!!EQ(canonical_bound, replay_bound)
                        := ok_3 = !!!!EQ(canonical_applications, replay_applications)
                        := ok_4 = !!!!EQ(canonical_applications, 2i64)
                        := ok_5 = !!!!EQ(canonical_outer, replay_outer)
                        ? ok_0 && ok_1 && ok_2 && ok_3 && ok_4 && ok_5
                        ?> ()
                        |: mega_runtime_fail "corrected-cic-recursive-codomain-summary-mismatch"
                    corrected_cic_conversion_constraint_program_accepted_with_substituted_codomain ()

:= corrected_cic_conversion_constraint_program_accepted_with_recursive_outer_application () =
    corrected_cic_conversion_constraint_program_scoped_application_from_intrinsic
        (corrected_cic_recursive_double_unary_outer_application_intrinsic ())
