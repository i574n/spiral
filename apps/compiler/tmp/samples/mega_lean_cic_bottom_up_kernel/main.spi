    match authority with
    | corrected_cic_recursive_sort_zero_replay_metric_consistency_authority (_, _, note) => note

nominal corrected_cic_recursive_sort_zero_replay_metric_open_authority =
    corrected_cic_recursive_sort_zero_replay_metric_consistency_authority *
    corrected_cic_recursive_sort_zero_replay_consistency_authority *
    corrected_cic_recursive_sort_zero_replay_application_spine_authority * string

inl corrected_cic_recursive_sort_zero_replay_metric_open_authority_make
    (metric : corrected_cic_recursive_sort_zero_replay_metric_consistency_authority) :
    corrected_cic_recursive_sort_zero_replay_metric_open_authority =
    match metric with
    | corrected_cic_recursive_sort_zero_replay_metric_consistency_authority (consistency, application_spine, metric_note) =>
        inl _ = metric_note
        inl _ = corrected_cic_recursive_sort_zero_replay_consistency_authority_note consistency
        inl _ = corrected_cic_recursive_sort_zero_replay_application_spine_authority_note application_spine
        match application_spine with
        | corrected_cic_recursive_sort_zero_replay_application_spine_authority (canonical_target, replay_target, _) =>
            inl canonical_constants = corrected_cic_term_constant_count canonical_target
            inl replay_constants = corrected_cic_term_constant_count replay_target
            inl canonical_bound = corrected_cic_term_bound_here_count canonical_target
            inl replay_bound = corrected_cic_term_bound_here_count replay_target
            inl canonical_applications = corrected_cic_term_application_count canonical_target
            inl replay_applications = corrected_cic_term_application_count replay_target
            inl _ : () =
                $"if !canonical_constants <> !replay_constants || !canonical_bound <> !replay_bound || !canonical_applications <> !replay_applications then failwith \"recursive-Sort-zero-replay-term-derived-metric-open-mismatch\""
            corrected_cic_recursive_sort_zero_replay_metric_open_authority (
                metric,
                consistency,
                application_spine,
                "recursive-Sort-zero-term-derived-metric-open-now-reopens-the-two-indexed-targets-only-through-the-application-spine-authority-instead-of-storing-a-third-copy")

