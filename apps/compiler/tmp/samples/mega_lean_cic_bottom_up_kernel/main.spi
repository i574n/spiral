        := certificate =
            corrected_cic_dependent_beta_contractum_make
                type_binder codomain_body (corrected_cic_sort_zero ())
        ?= certificate ?|
        | corrected_cic_dependent_beta_contractum (_, substituted_codomain) =>
            ?= substituted_codomain ?|
            | corrected_cic_dependent_substituted_codomain_index result =>
                ?= result ?|
                | corrected_cic_parametric_substitution_result (_, _, target) =>
                    CorrectedCicConversionConstraintProgramNonDefeqTerms (
