:| ^ cic_corrected_renaming source target =
    | CicCorrectedRenamingIdentity :: \* context.
        string -> cic_corrected_renaming context context
    | CicCorrectedRenamingWeaken :: \* source middle head.
        cic_corrected_renaming source middle * string ->
        cic_corrected_renaming source (ctx_extend middle head)

:= ^ cic_corrected_renaming_to_extension \* source target.
    (renaming : cic_corrected_renaming source target)
    : cic_corrected_context_extension source target =
    ?= renaming ?|
    | CicCorrectedRenamingIdentity note =>
        CicCorrectedContextExtensionIdentity note
    | CicCorrectedRenamingWeaken (prefix, note) =>
        CicCorrectedContextExtensionMore (
            cic_corrected_renaming_to_extension prefix,
            note)

:= rename_corrected_cic_term \* source target sort.
    (renaming : cic_corrected_renaming source target)
    (term : corrected_cic_term source sort)
    : corrected_cic_term target sort =
    lift_corrected_cic_term_by_extension
        (cic_corrected_renaming_to_extension renaming)
        term

