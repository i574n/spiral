                    ^^ "lved-oldest-Bool-slot-and-real-replacement-term-without-roundtripping-through-a-solved-count-s"
                    ^^ "calar"

:= corrected_cic_primary_environment_nominal_identity_terminal () : string =
    := primary_assigned_environment =
        corrected_cic_environment_assign_oldest_bool
            (corrected_cic_primary_environment_oldest_bool_selection_value ())
            (corrected_cic_true ())
    := _ = corrected_cic_oldest_bool_assignment_consume primary_assigned_environment
    := secondary_assigned_environment =
        corrected_cic_environment_assign_oldest_bool
            (corrected_cic_secondary_environment_oldest_bool_selection_value ())
            (corrected_cic_true ())
    := _ = corrected_cic_oldest_bool_assignment_consume secondary_assigned_environment
    "the-active-oldest-Bool-assignment-now-consumes-both-primary-and-secondary-environments-structurally-after-the-"
    ^^ "real-mutator-instead-of-roundtripping-each-through-a-solved-count-scalar"



