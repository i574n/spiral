:| ^ cic_corrected_contextual_identity_beta_reduction ctx ty =
    | CicCorrectedContextualIdentityBetaBase :: \* ctx ty.
        corrected_cic_generic_identity_beta_step ctx ty * string ->
        cic_corrected_contextual_identity_beta_reduction ctx ty
    | CicCorrectedContextualIdentityBetaLambda :: \* ctx domain codomain.
        binder ctx domain *
        cic_corrected_contextual_identity_beta_reduction
            (ctx_extend ctx domain) codomain * string ->
        cic_corrected_contextual_identity_beta_reduction
            ctx (function_sort domain codomain)
    | CicCorrectedContextualIdentityBetaLet :: \* ctx codomain.
        (\? domain.
            binder ctx domain *
            corrected_cic_term ctx domain *
            cic_corrected_contextual_identity_beta_reduction
                (ctx_extend ctx domain) codomain * string) ->
        cic_corrected_contextual_identity_beta_reduction ctx codomain

:= ^ cic_corrected_contextual_identity_beta_source \* ctx ty.
    (reduction : cic_corrected_contextual_identity_beta_reduction ctx ty)
    : corrected_cic_term ctx ty =
    ?= reduction ?|
    | CicCorrectedContextualIdentityBetaBase (step, _) =>
        corrected_cic_generic_identity_beta_source step
    | CicCorrectedContextualIdentityBetaLambda (binder_value, body, _) =>
        CorrectedLambda (
            binder_value,
            cic_corrected_contextual_identity_beta_source body)
    | CicCorrectedContextualIdentityBetaLet payload =>
        := \? domain. binder_value, value, body, _ = payload
        CorrectedLet (\? (
            binder_value,
            value,
            cic_corrected_contextual_identity_beta_source body))

:= ^ cic_corrected_contextual_identity_beta_target \* ctx ty.
    (reduction : cic_corrected_contextual_identity_beta_reduction ctx ty)
    : corrected_cic_term ctx ty =
    ?= reduction ?|
    | CicCorrectedContextualIdentityBetaBase (step, _) =>
        corrected_cic_generic_identity_beta_target step
    | CicCorrectedContextualIdentityBetaLambda (binder_value, body, _) =>
        CorrectedLambda (
            binder_value,
            cic_corrected_contextual_identity_beta_target body)
    | CicCorrectedContextualIdentityBetaLet payload =>
        := \? domain. binder_value, value, body, _ = payload
        CorrectedLet (\? (
            binder_value,
            value,
            cic_corrected_contextual_identity_beta_target body))

:= ^ cic_corrected_contextual_identity_beta_depth \* ctx ty.
    (reduction : cic_corrected_contextual_identity_beta_reduction ctx ty) : i64 =
    ?= reduction ?|
    | CicCorrectedContextualIdentityBetaBase _ => 0i64
    | CicCorrectedContextualIdentityBetaLambda (_, body, _) =>
        cic_runtime_add_i64 1i64
            (cic_corrected_contextual_identity_beta_depth body)
    | CicCorrectedContextualIdentityBetaLet payload =>
        := \? domain. _, _, body, _ = payload
        cic_runtime_add_i64 1i64
            (cic_corrected_contextual_identity_beta_depth body)

:= cic_corrected_contextual_identity_beta_runtime \* ctx ty.
    (reduction : cic_corrected_contextual_identity_beta_reduction ctx ty)
    : i64 * i64 * i64 * i64 * i64 =
    := source = cic_corrected_contextual_identity_beta_source reduction
    := target = cic_corrected_contextual_identity_beta_target reduction
    corrected_cic_term_structural_size source,
    corrected_cic_term_structural_size target,
    cic_corrected_contextual_identity_beta_depth reduction,
    corrected_cic_term_outer_tag source,
    corrected_cic_term_outer_tag target

:= assert_cic_corrected_contextual_identity_beta_runtime
    (source_size : i64) (target_size : i64) (depth : i64)
    (source_tag : i64) (target_tag : i64)
