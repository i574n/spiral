nominal corrected_cic_parametric_substitution_result source target sort =
    cic_corrected_substitution source target *
    corrected_cic_term source sort *
    corrected_cic_term target sort

inl corrected_cic_parametric_substitution_result_make forall source target sort.
    (substitution : cic_corrected_substitution source target)
    (body : corrected_cic_term source sort) :
    corrected_cic_parametric_substitution_result source target sort =
    corrected_cic_parametric_substitution_result (
        substitution, body, apply_cic_corrected_substitution substitution body)

nominal corrected_cic_dependent_substituted_codomain_index ctx domain codomain =
    corrected_cic_parametric_substitution_result (ctx_extend ctx domain) ctx codomain

nominal corrected_cic_dependent_beta_contractum ctx domain codomain =
    corrected_cic_term ctx codomain *
    corrected_cic_dependent_substituted_codomain_index ctx domain codomain

inl corrected_cic_dependent_beta_contractum_make forall ctx domain codomain.
    (source_binder : binder ctx domain)
    (body : corrected_cic_term (ctx_extend ctx domain) codomain)
    (argument : corrected_cic_term ctx domain) :
    corrected_cic_dependent_beta_contractum ctx domain codomain =
    inl source : corrected_cic_term ctx codomain =
        CorrectedDependentApplication (exists (source_binder, body, argument))
    match source_binder with
    | binder (context_value, domain_value, _) =>
        inl substitution :
            cic_corrected_substitution (ctx_extend ctx domain) ctx =
            CicCorrectedSubstitutionDropNewest (
                context_value,
                domain_value,
                argument,
                "the-dependent-beta-contractum-certificate-derives-B[a/x]-by-the-total-structural-substitution")
        inl substituted_codomain =
            corrected_cic_dependent_substituted_codomain_index (
                corrected_cic_parametric_substitution_result_make substitution body)
        corrected_cic_dependent_beta_contractum (
            source,
            substituted_codomain)

nominal corrected_cic_closed_type_code_sort_zero = string
nominal corrected_cic_closed_type_code_bool = string
nominal corrected_cic_identity_codomain_code = string
nominal corrected_cic_unary_constructor_codomain_code = string
nominal corrected_cic_substituted_codomain codomain argument = codomain * argument

union corrected_cic_closed_type_code code =
    | CorrectedCicClosedTypeCodeSortZero :: string ->
        corrected_cic_closed_type_code
            corrected_cic_closed_type_code_sort_zero
    | CorrectedCicClosedTypeCodeBool :: string ->
        corrected_cic_closed_type_code
            corrected_cic_closed_type_code_bool

inl corrected_cic_closed_type_code_term forall code.
    (code : corrected_cic_closed_type_code code)
    : corrected_cic_term empty_ctx (universe_sort universe_one) =
    match code with
    | CorrectedCicClosedTypeCodeSortZero _ =>
        corrected_cic_sort_zero ()
    | CorrectedCicClosedTypeCodeBool _ =>
        CorrectedConstant (
            constant_name (
