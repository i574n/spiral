:= corrected_cic_environment_assign_oldest_bool \* identity.
    (selection : corrected_cic_environment_oldest_bool_selection identity)
    (replacement : corrected_cic_term empty_ctx bool_sort) :
    corrected_cic_meta_environment corrected_cic_oldest_bool_solved_states =
    ?= selection ?|
    | CorrectedCicPrimaryEnvironmentOldestBoolSelection (environment, membership) =>
        ?= environment, membership ?|
        | corrected_cic_primary_environment concrete_environment,
          corrected_cic_primary_oldest_bool_membership concrete_membership =>
            corrected_cic_environment_bound_selected_meta_assign
                concrete_environment concrete_membership replacement
    | CorrectedCicSecondaryEnvironmentOldestBoolSelection (environment, membership) =>
        ?= environment, membership ?|
        | corrected_cic_secondary_environment concrete_environment,
          corrected_cic_secondary_oldest_bool_membership concrete_membership =>
            corrected_cic_environment_bound_selected_meta_assign
                concrete_environment concrete_membership replacement

