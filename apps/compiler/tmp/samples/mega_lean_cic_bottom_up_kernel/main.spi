                := replay_whnf_outer = corrected_cic_term_outer_tag replay_whnf
                := canonical_whnf_steps = corrected_cic_whnf_step_count canonical_target
                := replay_whnf_steps = corrected_cic_whnf_step_count replay_target
                := replay_step_pair_authority =
