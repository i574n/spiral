:= mega_runtime_fail \* t. (message : string) : t = !!!!FailWith(`t, message)

:! empty_ctx = string
:! universe_one = string
:! bool_sort = string
:! function_sort domain codomain = domain * codomain
:== identity_sort = function_sort bool_sort bool_sort
:! universe_sort level = level
:! ctx_extend ctx sort = ctx * sort
:! binder ctx sort = ctx * sort * string
:! constant_name sort = sort * string

:= identity_binder () : binder empty_ctx bool_sort =
    binder (empty_ctx "empty", bool_sort "Bool", "x")

:! environment = string
:! cic_chain_zero = ()
:! cic_chain_succ n = n

:= cic_runtime_add_i64 (left : i64) (right : i64) : i64 =
    !!!!Add(left, right)

:= cic_runtime_string_equal (left : string) (right : string) : i64 =
    := test_0 = !!!!EQ(left, right)
    ? test_0 ?> 1i64 |: 0i64

:= cic_runtime_and_i64 (left : i64) (right : i64) : i64 =
    := test_0 = !!!!EQ(left, 1i64)
    := test_1 = !!!!EQ(right, 1i64)
    ? test_0 && test_1 ?> 1i64 |: 0i64

:! cic_inductive_signature_parameter = string
:! cic_inductive_signature_recursive = string
:! cic_inductive_signature_product left right = left * right
:! cic_inductive_signature_arrow domain codomain = domain * codomain

:| ^ cic_inductive_signature schema =
    | CicInductiveSignatureParameter ::
        string -> cic_inductive_signature cic_inductive_signature_parameter
    | CicInductiveSignatureRecursive ::
        string -> cic_inductive_signature cic_inductive_signature_recursive
    | CicInductiveSignatureProduct :: \* left right.
        cic_inductive_signature left *
        cic_inductive_signature right * string ->
        cic_inductive_signature
            (cic_inductive_signature_product left right)
    | CicInductiveSignatureArrow :: \* domain codomain.
        cic_inductive_signature domain *
        cic_inductive_signature codomain * string ->
        cic_inductive_signature
            (cic_inductive_signature_arrow domain codomain)

:| ^ cic_no_recursive_occurrence_certificate schema =
    | CicNoRecursiveOccurrenceParameter ::
        string ->
        cic_no_recursive_occurrence_certificate
            cic_inductive_signature_parameter
    | CicNoRecursiveOccurrenceProduct :: \* left right.
        cic_no_recursive_occurrence_certificate left *
        cic_no_recursive_occurrence_certificate right * string ->
        cic_no_recursive_occurrence_certificate
            (cic_inductive_signature_product left right)
    | CicNoRecursiveOccurrenceArrow :: \* domain codomain.
        cic_no_recursive_occurrence_certificate domain *
        cic_no_recursive_occurrence_certificate codomain * string ->
        cic_no_recursive_occurrence_certificate
            (cic_inductive_signature_arrow domain codomain)

:| cic_no_recursive_occurrence_decision schema =
    | CicNoRecursiveOccurrenceAccepted :: \* schema.
        cic_no_recursive_occurrence_certificate schema * string ->
        cic_no_recursive_occurrence_decision schema
    | CicNoRecursiveOccurrenceRejected :: \* schema.
        string -> cic_no_recursive_occurrence_decision schema

:= ^ decide_cic_no_recursive_occurrence \* schema.
    (signature : cic_inductive_signature schema)
    : cic_no_recursive_occurrence_decision schema =
    ?= signature ?|
    | CicInductiveSignatureParameter note =>
        CicNoRecursiveOccurrenceAccepted (
            CicNoRecursiveOccurrenceParameter note,
            "a-parameter-only-signature-has-no-recursive-occurrence")
    | CicInductiveSignatureRecursive _ =>
        CicNoRecursiveOccurrenceRejected
            "a-recursive-occurrence-was-found-in-a-position-that-requires-a-recursion-free-domain"
    | CicInductiveSignatureProduct (left, right, note) =>
        ?=
            decide_cic_no_recursive_occurrence left,
            decide_cic_no_recursive_occurrence right
        ?|
        | CicNoRecursiveOccurrenceAccepted (left_certificate, _),
          CicNoRecursiveOccurrenceAccepted (right_certificate, _) =>
            CicNoRecursiveOccurrenceAccepted (
                CicNoRecursiveOccurrenceProduct (
                    left_certificate,
                    right_certificate,
                    note),
                "both-product-branches-are-recursion-free")
        | _, _ =>
            CicNoRecursiveOccurrenceRejected
                "at-least-one-product-branch-contains-a-recursive-occurrence"
    | CicInductiveSignatureArrow (domain, codomain, note) =>
        ?=
            decide_cic_no_recursive_occurrence domain,
            decide_cic_no_recursive_occurrence codomain
        ?|
        | CicNoRecursiveOccurrenceAccepted (domain_certificate, _),
          CicNoRecursiveOccurrenceAccepted (codomain_certificate, _) =>
            CicNoRecursiveOccurrenceAccepted (
                CicNoRecursiveOccurrenceArrow (
                    domain_certificate,
                    codomain_certificate,
                    note),
                "the-entire-arrow-signature-is-recursion-free")
        | _, _ =>
            CicNoRecursiveOccurrenceRejected
                "the-arrow-signature-contains-a-recursive-occurrence"

:| ^ cic_strict_positivity_certificate schema =
    | CicStrictPositivityParameter ::
        string ->
        cic_strict_positivity_certificate
            cic_inductive_signature_parameter
    | CicStrictPositivityRecursive ::
        string ->
        cic_strict_positivity_certificate
            cic_inductive_signature_recursive
    | CicStrictPositivityProduct :: \* left right.
        cic_strict_positivity_certificate left *
        cic_strict_positivity_certificate right * string ->
        cic_strict_positivity_certificate
            (cic_inductive_signature_product left right)
    | CicStrictPositivityArrow :: \* domain codomain.
        cic_no_recursive_occurrence_certificate domain *
        cic_strict_positivity_certificate codomain * string ->
        cic_strict_positivity_certificate
            (cic_inductive_signature_arrow domain codomain)

:| cic_strict_positivity_decision schema =
    | CicStrictPositivityAccepted :: \* schema.
        cic_strict_positivity_certificate schema * string ->
        cic_strict_positivity_decision schema
    | CicStrictPositivityRejected :: \* schema.
        string -> cic_strict_positivity_decision schema

:= ^ verify_cic_strict_positivity \* schema.
    (signature : cic_inductive_signature schema)
    : cic_strict_positivity_decision schema
    =
    ?= signature ?|
    | CicInductiveSignatureParameter note =>
        CicStrictPositivityAccepted (
            CicStrictPositivityParameter note,
            "parameters-are-strictly-positive")
    | CicInductiveSignatureRecursive note =>
        CicStrictPositivityAccepted (
            CicStrictPositivityRecursive note,
            "a-direct-recursive-occurrence-is-strictly-positive")
    | CicInductiveSignatureProduct (left, right, note) =>
        ?= verify_cic_strict_positivity left, verify_cic_strict_positivity right ?|
        | CicStrictPositivityAccepted (left_certificate, _),
          CicStrictPositivityAccepted (right_certificate, _) =>
            CicStrictPositivityAccepted (
                CicStrictPositivityProduct (
                    left_certificate,
                    right_certificate,
                    note),
                "both-product-branches-are-strictly-positive")
        | _, _ =>
            CicStrictPositivityRejected
                "a-product-branch-failed-strict-positivity-verification"
    | CicInductiveSignatureArrow (domain, codomain, note) =>
        ?=
            decide_cic_no_recursive_occurrence domain,
            verify_cic_strict_positivity codomain
        ?|
        | CicNoRecursiveOccurrenceAccepted (domain_certificate, _),
            CicStrictPositivityAccepted (codomain_certificate, _)
            =>
                CicStrictPositivityAccepted (
                    CicStrictPositivityArrow (
                        domain_certificate,
                        codomain_certificate,
                        note),
                    "the-arrow-domain-is-recursion-free-and-the-codomain-is-strictly-positive")
        | _, _ =>
            CicStrictPositivityRejected (
                "a-recursive-occurrence-was-detected-in-negative-arrow-domain-position-or-the-codomain-failed-verif"
                ^^ "ication"
            )

:= cic_positive_arrow_signature_value () :
    cic_inductive_signature
        (cic_inductive_signature_arrow
            cic_inductive_signature_parameter
            cic_inductive_signature_recursive) =
    CicInductiveSignatureArrow (
        CicInductiveSignatureParameter
            "the-arrow-domain-is-a-nonrecursive-parameter",
        CicInductiveSignatureRecursive
            "the-arrow-codomain-contains-the-positive-recursive-occurrence",
        "parameter-to-recursive-is-a-strictly-positive-constructor-signature")

:| ^ corrected_cic_term ctx sort =
    | CorrectedSortZero :: \* ctx.
        string -> corrected_cic_term ctx (universe_sort universe_one)
    | CorrectedBoundHere :: \* ctx sort.
        binder ctx sort -> corrected_cic_term (ctx_extend ctx sort) sort
    | CorrectedBoundThere :: \* ctx head sort.
        corrected_cic_term ctx sort * string ->
        corrected_cic_term (ctx_extend ctx head) sort
    | CorrectedConstant :: \* ctx sort.
        constant_name sort -> corrected_cic_term ctx sort
    | CorrectedDefinition :: \* ctx sort.
        corrected_cic_term ctx sort * string -> corrected_cic_term ctx sort
    | CorrectedLambda :: \* ctx domain codomain.
        binder ctx domain * corrected_cic_term (ctx_extend ctx domain) codomain ->
        corrected_cic_term ctx (function_sort domain codomain)
    | CorrectedPi :: \* ctx.
        (\? domain.
            binder ctx domain *
            corrected_cic_term
                (ctx_extend ctx domain)
                (universe_sort universe_one)) ->
        corrected_cic_term ctx (universe_sort universe_one)
    | CorrectedDependentLambda :: \* ctx.
        (\? domain.
            binder ctx domain *
            corrected_cic_term
                (ctx_extend ctx domain)
                (universe_sort universe_one)) ->
        corrected_cic_term ctx (universe_sort universe_one)
    | CorrectedDependentApplication :: \* ctx codomain.
        (\? domain.
            binder ctx domain *
            corrected_cic_term
                (ctx_extend ctx domain)
                codomain *
            corrected_cic_term ctx domain) ->
        corrected_cic_term ctx codomain
    | CorrectedApplication :: \* ctx codomain.
        (\? domain.
            corrected_cic_term ctx (function_sort domain codomain) *
            corrected_cic_term ctx domain) ->
        corrected_cic_term ctx codomain
    | CorrectedLet :: \* ctx codomain.
        (\? domain.
            binder ctx domain *
            corrected_cic_term ctx domain *
            corrected_cic_term (ctx_extend ctx domain) codomain) ->
        corrected_cic_term ctx codomain

:| ^ cic_corrected_substitution source target =
    | CicCorrectedSubstitutionIdentity :: \* context.
        context * string ->
        cic_corrected_substitution context context
    | CicCorrectedSubstitutionDropNewest :: \* target domain.
        target * domain * corrected_cic_term target domain * string ->
        cic_corrected_substitution (ctx_extend target domain) target
    | CicCorrectedSubstitutionLift :: \* source target head.
        target * head * cic_corrected_substitution source target * string ->
        cic_corrected_substitution
            (ctx_extend source head)
            (ctx_extend target head)

:= cic_corrected_substitution_target \* source target.
    (substitution : cic_corrected_substitution source target) : target =
    ?= substitution ?|
    | CicCorrectedSubstitutionIdentity (context_value, _) => context_value
    | CicCorrectedSubstitutionDropNewest (target_value, _, _, _) => target_value
    | CicCorrectedSubstitutionLift (target_value, head_value, _, _) =>
        ctx_extend (target_value, head_value)

:= ^ apply_cic_corrected_substitution \* source target sort.
    (substitution : cic_corrected_substitution source target)
    (term : corrected_cic_term source sort)
    : corrected_cic_term target sort =
    ?= substitution ?|
    | CicCorrectedSubstitutionIdentity _ => term
    | CicCorrectedSubstitutionDropNewest (
        target_value, _, argument, substitution_note) =>
        ?= term ?|
        | CorrectedSortZero note => CorrectedSortZero note
        | CorrectedBoundHere _ => argument
        | CorrectedBoundThere (outer, _) => outer
        | CorrectedConstant constant => CorrectedConstant constant
        | CorrectedDefinition (body, note) =>
            CorrectedDefinition (
                apply_cic_corrected_substitution substitution body,
                note)
        | CorrectedLambda (source_binder, body) =>
            ?= source_binder ?|
            | binder (_, lambda_domain_value, binder_note) =>
                := lifted =
                    CicCorrectedSubstitutionLift (
                        target_value,
                        lambda_domain_value,
                        substitution,
                        "the-substitution-is-lifted-under-the-lambda-binder")
                CorrectedLambda (
                    binder (target_value, lambda_domain_value, binder_note),
                    apply_cic_corrected_substitution lifted body)
        | CorrectedPi payload =>
            := \? pi_domain. source_binder, codomain_body = payload
            ?= source_binder ?|
            | binder (_, pi_domain_value, binder_note) =>
                := lifted =
                    CicCorrectedSubstitutionLift (
                        target_value,
                        pi_domain_value,
                        substitution,
                        "the-substitution-is-lifted-under-the-Pi-binder")
                CorrectedPi (\? (
                    binder (target_value, pi_domain_value, binder_note),
                    apply_cic_corrected_substitution lifted codomain_body))
        | CorrectedDependentLambda payload =>
            := \? lambda_domain. source_binder, body = payload
            ?= source_binder ?|
            | binder (_, lambda_domain_value, binder_note) =>
                := lifted =
                    CicCorrectedSubstitutionLift (
                        target_value,
                        lambda_domain_value,
                        substitution,
                        "the-substitution-is-lifted-under-the-dependent-lambda-binder")
                CorrectedDependentLambda (\? (
                    binder (
                        target_value,
                        lambda_domain_value,
                        binder_note),
                    apply_cic_corrected_substitution lifted body))
        | CorrectedDependentApplication payload =>
            := \? dependent_domain.
                source_binder, body, argument_term = payload
            ?= source_binder ?|
            | binder (_, dependent_domain_value, binder_note) =>
                := lifted =
                    CicCorrectedSubstitutionLift (
                        target_value,
                        dependent_domain_value,
                        substitution,
                        "the-substitution-is-lifted-through-the-dependent-application-body")
                CorrectedDependentApplication (\? (
                    binder (
                        target_value,
                        dependent_domain_value,
                        binder_note),
                    apply_cic_corrected_substitution
                        lifted
                        body,
                    apply_cic_corrected_substitution
                        substitution
                        argument_term))
        | CorrectedApplication payload =>
            := \? domain. function_term, argument_term = payload
            CorrectedApplication (\? (
                apply_cic_corrected_substitution substitution function_term,
                apply_cic_corrected_substitution substitution argument_term))
        | CorrectedLet payload =>
            := \? let_domain. source_binder, value, body = payload
            ?= source_binder ?|
            | binder (_, let_domain_value, binder_note) =>
                := lifted =
                    CicCorrectedSubstitutionLift (
                        target_value,
                        let_domain_value,
                        substitution,
                        "the-substitution-is-lifted-under-the-let-binder")
                CorrectedLet (\? (
                    binder (target_value, let_domain_value, binder_note),
                    apply_cic_corrected_substitution substitution value,
                    apply_cic_corrected_substitution lifted body))
    | CicCorrectedSubstitutionLift (
        target_value, head_value, prefix, substitution_note) =>
        ?= term ?|
        | CorrectedSortZero note => CorrectedSortZero note
        | CorrectedBoundHere _ =>
            CorrectedBoundHere (
                binder (target_value, head_value, substitution_note))
        | CorrectedBoundThere (outer, note) =>
            CorrectedBoundThere (
                apply_cic_corrected_substitution prefix outer,
                note)
        | CorrectedConstant constant => CorrectedConstant constant
        | CorrectedDefinition (body, note) =>
            CorrectedDefinition (
                apply_cic_corrected_substitution substitution body,
                note)
        | CorrectedLambda (source_binder, body) =>
            ?= source_binder ?|
            | binder (_, lambda_domain_value, binder_note) =>
                := target_context =
                    cic_corrected_substitution_target substitution
                := lifted =
                    CicCorrectedSubstitutionLift (
                        target_context,
                        lambda_domain_value,
                        substitution,
                        "the-lifted-substitution-crosses-another-lambda-binder")
                CorrectedLambda (
                    binder (target_context, lambda_domain_value, binder_note),
                    apply_cic_corrected_substitution lifted body)
        | CorrectedPi payload =>
            := \? pi_domain. source_binder, codomain_body = payload
            ?= source_binder ?|
            | binder (_, pi_domain_value, binder_note) =>
                := target_context =
                    cic_corrected_substitution_target substitution
                := lifted =
                    CicCorrectedSubstitutionLift (
                        target_context,
                        pi_domain_value,
                        substitution,
                        "the-lifted-substitution-crosses-another-Pi-binder")
                CorrectedPi (\? (
                    binder (target_context, pi_domain_value, binder_note),
                    apply_cic_corrected_substitution lifted codomain_body))
        | CorrectedDependentLambda payload =>
            := \? lambda_domain. source_binder, body = payload
            ?= source_binder ?|
            | binder (_, lambda_domain_value, binder_note) =>
                := target_context =
                    cic_corrected_substitution_target substitution
                := lifted =
                    CicCorrectedSubstitutionLift (
                        target_context,
                        lambda_domain_value,
                        substitution,
                        "the-lifted-substitution-crosses-another-dependent-lambda-binder")
                CorrectedDependentLambda (\? (
                    binder (
                        target_context,
                        lambda_domain_value,
                        binder_note),
                    apply_cic_corrected_substitution lifted body))
        | CorrectedDependentApplication payload =>
            := \? dependent_domain.
                source_binder, body, argument_term = payload
            ?= source_binder ?|
            | binder (_, dependent_domain_value, binder_note) =>
                := target_context =
                    cic_corrected_substitution_target substitution
                := lifted =
                    CicCorrectedSubstitutionLift (
                        target_context,
                        dependent_domain_value,
                        substitution,
                        "the-lifted-substitution-crosses-the-dependent-application-body")
                CorrectedDependentApplication (\? (
                    binder (
                        target_context,
                        dependent_domain_value,
                        binder_note),
                    apply_cic_corrected_substitution
                        lifted
                        body,
                    apply_cic_corrected_substitution
                        substitution
                        argument_term))
        | CorrectedApplication payload =>
            := \? domain. function_term, argument_term = payload
            CorrectedApplication (\? (
                apply_cic_corrected_substitution substitution function_term,
                apply_cic_corrected_substitution substitution argument_term))
        | CorrectedLet payload =>
            := \? let_domain. source_binder, value, body = payload
            ?= source_binder ?|
            | binder (_, let_domain_value, binder_note) =>
                := target_context =
                    cic_corrected_substitution_target substitution
                := lifted =
                    CicCorrectedSubstitutionLift (
                        target_context,
                        let_domain_value,
                        substitution,
                        "the-lifted-substitution-crosses-another-let-binder")
                CorrectedLet (\? (
                    binder (target_context, let_domain_value, binder_note),
                    apply_cic_corrected_substitution substitution value,
                    apply_cic_corrected_substitution lifted body))

:= ^ reduce_corrected_cic_whnf \* ctx sort.
    (term : corrected_cic_term ctx sort)
    : corrected_cic_term ctx sort =
    ?= term ?|
    | CorrectedSortZero _ => term
    | CorrectedBoundHere _ => term
    | CorrectedBoundThere _ => term
    | CorrectedConstant _ => term
    | CorrectedDefinition (body, _) =>
        reduce_corrected_cic_whnf body
    | CorrectedLambda _ => term
    | CorrectedPi _ => term
    | CorrectedDependentLambda _ => term
    | CorrectedApplication payload =>
        := \? domain. function_term, argument_term = payload
        := function_whnf = reduce_corrected_cic_whnf function_term
        ?= function_whnf ?|
        | CorrectedLambda (source_binder, body) =>
            ?= source_binder ?|
            | binder (context_value, domain_value, _) =>
                := substitution :
                    cic_corrected_substitution
                        (ctx_extend ctx domain)
                        ctx =
                    CicCorrectedSubstitutionDropNewest (
                        context_value,
                        domain_value,
                        argument_term,
                        "WHNF-spine-beta-substitutes-after-normalizing-the-function-head")
                reduce_corrected_cic_whnf
                    (apply_cic_corrected_substitution substitution body)
        | _ => CorrectedApplication (\? (function_whnf, argument_term))
    | CorrectedDependentApplication payload =>
        := \? domain. source_binder, body, argument_term = payload
        ?= source_binder ?|
        | binder (context_value, domain_value, _) =>
            := substitution :
                cic_corrected_substitution
                    (ctx_extend ctx domain)
                    ctx =
                CicCorrectedSubstitutionDropNewest (
                    context_value,
                    domain_value,
                    argument_term,
                    "WHNF-dependent-beta-substitutes-the-argument-into-the-Lambda-body")
            reduce_corrected_cic_whnf
                (apply_cic_corrected_substitution substitution body)
    | CorrectedLet payload =>
        := \? domain. source_binder, value, body = payload
        ?= source_binder ?|
        | binder (context_value, domain_value, _) =>
            := substitution :
                cic_corrected_substitution
                    (ctx_extend ctx domain)
                    ctx =
                CicCorrectedSubstitutionDropNewest (
                    context_value,
                    domain_value,
                    value,
                    "WHNF-let-substitutes-the-value-into-the-body")
            reduce_corrected_cic_whnf
                (apply_cic_corrected_substitution substitution body)

:= ^ corrected_cic_whnf_step_count \* ctx sort.
    (term : corrected_cic_term ctx sort) : i64 =
    ?= term ?|
    | CorrectedDefinition (body, _) =>
        cic_runtime_add_i64 1i64
            (corrected_cic_whnf_step_count body)
    | CorrectedApplication payload =>
        := \? domain. function_term, argument_term = payload
        := function_steps = corrected_cic_whnf_step_count function_term
        := function_whnf = reduce_corrected_cic_whnf function_term
        ?= function_whnf ?|
        | CorrectedLambda (source_binder, body) =>
            ?= source_binder ?|
            | binder (context_value, domain_value, _) =>
                := substitution :
                    cic_corrected_substitution
                        (ctx_extend ctx domain)
                        ctx =
                    CicCorrectedSubstitutionDropNewest (
                        context_value,
                        domain_value,
                        argument_term,
                        "WHNF-step-count-includes-function-spine-and-outer-beta")
                cic_runtime_add_i64 function_steps
                    (cic_runtime_add_i64 1i64
                        (corrected_cic_whnf_step_count
                            (apply_cic_corrected_substitution substitution body)))
        | _ => function_steps
    | CorrectedDependentApplication payload =>
        := \? domain. source_binder, body, argument_term = payload
        ?= source_binder ?|
        | binder (context_value, domain_value, _) =>
            := substitution :
                cic_corrected_substitution
                    (ctx_extend ctx domain)
                    ctx =
                CicCorrectedSubstitutionDropNewest (
                    context_value,
                    domain_value,
                    argument_term,
                    "WHNF-step-count-replays-dependent-beta")
            cic_runtime_add_i64 1i64
                (corrected_cic_whnf_step_count
                    (apply_cic_corrected_substitution substitution body))
    | CorrectedLet payload =>
        := \? domain. source_binder, value, body = payload
        ?= source_binder ?|
        | binder (context_value, domain_value, _) =>
            := substitution :
                cic_corrected_substitution
                    (ctx_extend ctx domain)
                    ctx =
                CicCorrectedSubstitutionDropNewest (
                    context_value,
                    domain_value,
                    value,
                    "WHNF-step-count-replays-let-substitution")
            cic_runtime_add_i64 1i64
                (corrected_cic_whnf_step_count
                    (apply_cic_corrected_substitution substitution body))
    | _ => 0i64

:| ^ corrected_cic_structural_defeq_witness ctx sort =
    | CorrectedCicStructuralDefeqWitnessSortZero :: \* ctx.
        string * string ->
        corrected_cic_structural_defeq_witness ctx (universe_sort universe_one)
    | CorrectedCicStructuralDefeqWitnessBoundHere :: \* ctx sort.
        binder ctx sort * binder ctx sort ->
        corrected_cic_structural_defeq_witness (ctx_extend ctx sort) sort
    | CorrectedCicStructuralDefeqWitnessBoundThere :: \* ctx head sort.
        corrected_cic_structural_defeq_witness ctx sort * string ->
        corrected_cic_structural_defeq_witness (ctx_extend ctx head) sort
    | CorrectedCicStructuralDefeqWitnessConstant :: \* ctx sort.
        constant_name sort * constant_name sort * string ->
        corrected_cic_structural_defeq_witness ctx sort
    | CorrectedCicStructuralDefeqWitnessLambda :: \* ctx domain codomain.
        corrected_cic_structural_defeq_witness (ctx_extend ctx domain) codomain * string ->
        corrected_cic_structural_defeq_witness ctx (function_sort domain codomain)
    | CorrectedCicStructuralDefeqWitnessDefinition :: \* ctx sort.
        corrected_cic_structural_defeq_witness ctx sort * string ->
        corrected_cic_structural_defeq_witness ctx sort

:= ^ corrected_cic_structural_defeq_witness_make \* ctx sort.
    (left : corrected_cic_term ctx sort)
    (right : corrected_cic_term ctx sort) :
    corrected_cic_structural_defeq_witness ctx sort =
    ?= left, right ?|
    | CorrectedSortZero left_note, CorrectedSortZero right_note =>
        CorrectedCicStructuralDefeqWitnessSortZero (left_note, right_note)
    | CorrectedBoundHere left_binder, CorrectedBoundHere right_binder =>
        CorrectedCicStructuralDefeqWitnessBoundHere (left_binder, right_binder)
    | CorrectedBoundThere (left_outer, _),
      CorrectedBoundThere (right_outer, _) =>
        CorrectedCicStructuralDefeqWitnessBoundThere (
            corrected_cic_structural_defeq_witness_make left_outer right_outer,
            "structural-defeq-witness-recurses-through-BoundThere")
    | CorrectedConstant left_constant,
      CorrectedConstant right_constant =>
        ?= left_constant, right_constant ?|
        | constant_name (_, left_name),
          constant_name (_, right_name) =>
            := equal = cic_runtime_string_equal left_name right_name
            := _ : () =
                := ok_0 = !!!!EQ(equal, 1i64)
                ? ok_0 ?> () |: mega_runtime_fail "corrected-cic-structural-defeq-witness-constant-mismatch"
            CorrectedCicStructuralDefeqWitnessConstant (
                left_constant,
                right_constant,
                "structural-defeq-witness-checks-the-constant-name-at-the-leaf")
    | CorrectedLambda (_, left_body),
      CorrectedLambda (_, right_body) =>
        CorrectedCicStructuralDefeqWitnessLambda (
            corrected_cic_structural_defeq_witness_make left_body right_body,
            "structural-defeq-witness-recurses-through-Lambda-bodies")
    | CorrectedDefinition (left_body, _),
      CorrectedDefinition (right_body, _) =>
        CorrectedCicStructuralDefeqWitnessDefinition (
            corrected_cic_structural_defeq_witness_make left_body right_body,
            "structural-defeq-witness-recurses-through-transparent-Definition-bodies")
    | _, _ =>
        mega_runtime_fail "corrected-cic-structural-defeq-witness-shape-mismatch"

:= ^ decide_corrected_cic_structural_defeq \* ctx sort.
    (left : corrected_cic_term ctx sort)
    (right : corrected_cic_term ctx sort) : i64 =
    := left_whnf = reduce_corrected_cic_whnf left
    := right_whnf = reduce_corrected_cic_whnf right
    ?= left_whnf, right_whnf ?|
    | CorrectedSortZero _, CorrectedSortZero _ => 1i64
    | CorrectedBoundHere _, CorrectedBoundHere _ => 1i64
    | CorrectedBoundThere (left_outer, _),
      CorrectedBoundThere (right_outer, _) =>
        decide_corrected_cic_structural_defeq left_outer right_outer
    | CorrectedConstant left_constant,
      CorrectedConstant right_constant =>
        ?= left_constant, right_constant ?|
        | constant_name (_, left_name),
          constant_name (_, right_name) =>
            cic_runtime_string_equal left_name right_name
    | CorrectedLambda (_, left_body),
      CorrectedLambda (_, right_body) =>
        decide_corrected_cic_structural_defeq left_body right_body
    | CorrectedDefinition (left_body, _),
      CorrectedDefinition (right_body, _) =>
        decide_corrected_cic_structural_defeq left_body right_body
    | _, _ => 0i64

:! corrected_cic_structural_defeq_pair_authority ctx sort =
    corrected_cic_term ctx sort * corrected_cic_term ctx sort *
    corrected_cic_term ctx sort * corrected_cic_term ctx sort *
    corrected_cic_structural_defeq_witness ctx sort * string

:= corrected_cic_structural_defeq_pair_authority_make \* ctx sort.
    (left : corrected_cic_term ctx sort)
    (right : corrected_cic_term ctx sort)
    :
        corrected_cic_structural_defeq_pair_authority ctx sort
    =
    := left_whnf = reduce_corrected_cic_whnf left
    := right_whnf = reduce_corrected_cic_whnf right
    := witness = corrected_cic_structural_defeq_witness_make left_whnf right_whnf
    corrected_cic_structural_defeq_pair_authority (
        left,
        right,
        left_whnf,
        right_whnf,
        witness,
        "structural-defeq-success-now-retains-the-indexed-witness-beside-both-inputs-and-their-derived-WHNF-pair-in"
        ^^ "stead-of-discarding-the-proof-after-validation"
    )

:= corrected_cic_structural_defeq_pair_authority_witness \* ctx sort.
    (authority : corrected_cic_structural_defeq_pair_authority ctx sort) :
    corrected_cic_structural_defeq_witness ctx sort =
    ?= authority ?|
    | corrected_cic_structural_defeq_pair_authority (_, _, _, _, witness, _) => witness

:! corrected_cic_structural_nondefeq_authority ctx sort =
    corrected_cic_term ctx sort * corrected_cic_term ctx sort * string



:= corrected_cic_structural_nondefeq_authority_note \* ctx sort.
    (authority : corrected_cic_structural_nondefeq_authority ctx sort) : string =
    ?= authority ?|
    | corrected_cic_structural_nondefeq_authority (_, _, note) => note

:= decide_corrected_cic_shared_domain_pi_defeq \* ctx domain.
    (left_body : corrected_cic_term (ctx_extend ctx domain) (universe_sort universe_one))
    (right_body : corrected_cic_term (ctx_extend ctx domain) (universe_sort universe_one)) : i64 =
    decide_corrected_cic_structural_defeq left_body right_body

:= decide_corrected_cic_shared_domain_application_defeq \* ctx domain codomain.
    (left_function : corrected_cic_term ctx (function_sort domain codomain))
    (left_argument : corrected_cic_term ctx domain)
    (right_function : corrected_cic_term ctx (function_sort domain codomain))
    (right_argument : corrected_cic_term ctx domain) : i64 =
    cic_runtime_and_i64
        (decide_corrected_cic_structural_defeq left_function right_function)
        (decide_corrected_cic_structural_defeq left_argument right_argument)

:= decide_corrected_cic_shared_domain_dependent_application_defeq \* ctx domain.
    (left_body : corrected_cic_term (ctx_extend ctx domain) (universe_sort universe_one))
    (left_argument : corrected_cic_term ctx domain)
    (right_body : corrected_cic_term (ctx_extend ctx domain) (universe_sort universe_one))
    (right_argument : corrected_cic_term ctx domain) : i64 =
    cic_runtime_and_i64
        (decide_corrected_cic_structural_defeq left_body right_body)
        (decide_corrected_cic_structural_defeq left_argument right_argument)

:! corrected_cic_shared_domain_scope ctx domain = binder ctx domain

:= corrected_cic_shared_domain_scope_of_binder \* ctx domain.
    (source_binder : binder ctx domain) : corrected_cic_shared_domain_scope ctx domain =
    corrected_cic_shared_domain_scope source_binder

:! corrected_cic_scoped_pi_comparison ctx domain =
    corrected_cic_shared_domain_scope ctx domain *
    corrected_cic_term (ctx_extend ctx domain) (universe_sort universe_one) *
    corrected_cic_term (ctx_extend ctx domain) (universe_sort universe_one)

:= corrected_cic_scoped_pi_comparison_make \* ctx domain.
    (scope : corrected_cic_shared_domain_scope ctx domain)
    (left_body : corrected_cic_term (ctx_extend ctx domain) (universe_sort universe_one))
    (right_body : corrected_cic_term (ctx_extend ctx domain) (universe_sort universe_one)) :
    corrected_cic_scoped_pi_comparison ctx domain =
    corrected_cic_scoped_pi_comparison (scope, left_body, right_body)

:= decide_corrected_cic_scoped_pi_defeq \* ctx domain.
    (scope : corrected_cic_shared_domain_scope ctx domain)
    (left_body : corrected_cic_term (ctx_extend ctx domain) (universe_sort universe_one))
    (right_body : corrected_cic_term (ctx_extend ctx domain) (universe_sort universe_one)) : i64 =
    ?= scope ?|
    | corrected_cic_shared_domain_scope _ =>
        decide_corrected_cic_shared_domain_pi_defeq left_body right_body

:= decide_corrected_cic_scoped_pi_comparison \* ctx domain.
    (comparison : corrected_cic_scoped_pi_comparison ctx domain) : i64 =
    ?= comparison ?|
    | corrected_cic_scoped_pi_comparison (scope, left_body, right_body) =>
        decide_corrected_cic_scoped_pi_defeq scope left_body right_body

:! corrected_cic_scoped_pi_term_authority ctx domain =
    corrected_cic_term ctx (universe_sort universe_one) *
    corrected_cic_term ctx (universe_sort universe_one) *
    corrected_cic_scoped_pi_comparison ctx domain

:= corrected_cic_scoped_pi_term_authority_make \* ctx domain.
    (scope : corrected_cic_shared_domain_scope ctx domain)
    (left_body : corrected_cic_term (ctx_extend ctx domain) (universe_sort universe_one))
    (right_body : corrected_cic_term (ctx_extend ctx domain) (universe_sort universe_one)) :
    corrected_cic_scoped_pi_term_authority ctx domain =
    ?= scope ?|
    | corrected_cic_shared_domain_scope source_binder =>
        corrected_cic_scoped_pi_term_authority (
            CorrectedPi (\? (source_binder, left_body)),
            CorrectedPi (\? (source_binder, right_body)),
            corrected_cic_scoped_pi_comparison_make scope left_body right_body)

:= decide_corrected_cic_scoped_pi_term_authority \* ctx domain.
    (authority : corrected_cic_scoped_pi_term_authority ctx domain) : i64 =
    ?= authority ?|
    | corrected_cic_scoped_pi_term_authority (left_term, right_term, comparison) =>
        ?= left_term, right_term ?|
        | CorrectedPi _, CorrectedPi _ =>
            decide_corrected_cic_scoped_pi_comparison comparison
        | _, _ => 0i64

:! corrected_cic_scoped_application_term_authority ctx domain codomain =
    corrected_cic_shared_domain_scope ctx domain *
    corrected_cic_term ctx (function_sort domain codomain) *
    corrected_cic_term ctx domain *
    corrected_cic_term ctx (function_sort domain codomain) *
    corrected_cic_term ctx domain

:= corrected_cic_scoped_application_term_authority_make \* ctx domain codomain.
    (scope : corrected_cic_shared_domain_scope ctx domain)
    (left_function : corrected_cic_term ctx (function_sort domain codomain))
    (left_argument : corrected_cic_term ctx domain)
    (right_function : corrected_cic_term ctx (function_sort domain codomain))
    (right_argument : corrected_cic_term ctx domain) :
    corrected_cic_scoped_application_term_authority ctx domain codomain =
    corrected_cic_scoped_application_term_authority (
        scope, left_function, left_argument, right_function, right_argument)

:! corrected_cic_scoped_application_indexed_defeq_authority ctx domain codomain =
    corrected_cic_structural_defeq_pair_authority
        ctx (function_sort domain codomain) *
    corrected_cic_structural_defeq_pair_authority ctx domain * string

:= corrected_cic_scoped_application_indexed_defeq_authority_make \* ctx domain codomain.
    (authority : corrected_cic_scoped_application_term_authority ctx domain codomain)
    :
        corrected_cic_scoped_application_indexed_defeq_authority ctx domain codomain
    =
    ?= authority ?|
    | corrected_cic_scoped_application_term_authority (
            scope,
            left_function,
            left_argument,
            right_function,
            right_argument
        )
        =>
            ?= scope ?|
            | corrected_cic_shared_domain_scope _ =>
                corrected_cic_scoped_application_indexed_defeq_authority (
                    corrected_cic_structural_defeq_pair_authority_make
                        left_function
                        right_function,
                    corrected_cic_structural_defeq_pair_authority_make
                        left_argument
                        right_argument,
                    "scoped-Application-defeq-now-retains-indexed-function-and-argument-WHNF-witnesses-under-the-sa"
                    ^^ "me-domain-index"
                )

:= decide_corrected_cic_scoped_application_term_authority \* ctx domain codomain.
    (authority : corrected_cic_scoped_application_term_authority ctx domain codomain) : i64 =
    ?= authority ?|
    | corrected_cic_scoped_application_term_authority (
        scope, left_function, left_argument, right_function, right_argument) =>
        ?= scope ?|
        | corrected_cic_shared_domain_scope _ =>
            decide_corrected_cic_shared_domain_application_defeq
                left_function left_argument right_function right_argument

:! corrected_cic_scoped_dependent_application_term_authority ctx domain =
    corrected_cic_shared_domain_scope ctx domain *
    corrected_cic_term (ctx_extend ctx domain) (universe_sort universe_one) *
    corrected_cic_term ctx domain *
    corrected_cic_term (ctx_extend ctx domain) (universe_sort universe_one) *
    corrected_cic_term ctx domain

:= corrected_cic_scoped_dependent_application_term_authority_make \* ctx domain.
    (scope : corrected_cic_shared_domain_scope ctx domain)
    (left_body : corrected_cic_term (ctx_extend ctx domain) (universe_sort universe_one))
    (left_argument : corrected_cic_term ctx domain)
    (right_body : corrected_cic_term (ctx_extend ctx domain) (universe_sort universe_one))
    (right_argument : corrected_cic_term ctx domain) :
    corrected_cic_scoped_dependent_application_term_authority ctx domain =
    corrected_cic_scoped_dependent_application_term_authority (
        scope, left_body, left_argument, right_body, right_argument)

:= decide_corrected_cic_scoped_dependent_application_term_authority \* ctx domain.
    (authority : corrected_cic_scoped_dependent_application_term_authority ctx domain) : i64 =
    ?= authority ?|
    | corrected_cic_scoped_dependent_application_term_authority (
        scope, left_body, left_argument, right_body, right_argument) =>
        := pi_authority =
            corrected_cic_scoped_pi_term_authority_make scope left_body right_body
        ?= scope ?|
        | corrected_cic_shared_domain_scope _ =>
            cic_runtime_and_i64
                (decide_corrected_cic_scoped_pi_term_authority pi_authority)
                (decide_corrected_cic_shared_domain_dependent_application_defeq
                    left_body left_argument right_body right_argument)

:| corrected_cic_structural_defeq_request =
    | CorrectedCicStructuralDefeqRequestTerms ::
        (\? ctx sort.
            corrected_cic_term ctx sort *
            corrected_cic_term ctx sort) ->
        corrected_cic_structural_defeq_request
    | CorrectedCicStructuralDefeqRequestScopedPi ::
        (\? ctx domain.
            corrected_cic_scoped_pi_term_authority ctx domain) ->
        corrected_cic_structural_defeq_request
    | CorrectedCicStructuralDefeqRequestScopedApplication ::
        (\? ctx domain codomain.
            corrected_cic_scoped_application_term_authority ctx domain codomain) ->
        corrected_cic_structural_defeq_request
    | CorrectedCicStructuralDefeqRequestScopedDependentApplication ::
        (\? ctx domain.
            corrected_cic_scoped_dependent_application_term_authority ctx domain) ->
        corrected_cic_structural_defeq_request

:= decide_corrected_cic_structural_defeq_request
    (request : corrected_cic_structural_defeq_request) : i64 =
    ?= request ?|
    | CorrectedCicStructuralDefeqRequestTerms payload =>
        := \? ctx sort. left, right = payload
        decide_corrected_cic_structural_defeq left right
    | CorrectedCicStructuralDefeqRequestScopedPi payload =>
        := \? ctx domain. authority = payload
        decide_corrected_cic_scoped_pi_term_authority authority
    | CorrectedCicStructuralDefeqRequestScopedApplication payload =>
        := \? ctx domain codomain. authority = payload
        decide_corrected_cic_scoped_application_term_authority authority
    | CorrectedCicStructuralDefeqRequestScopedDependentApplication payload =>
        := \? ctx domain. authority = payload
        decide_corrected_cic_scoped_dependent_application_term_authority authority

:! corrected_cic_scoped_pi_dependent_application_structural_relation ctx domain =
    corrected_cic_scoped_pi_term_authority ctx domain *
    corrected_cic_scoped_dependent_application_term_authority ctx domain

:= corrected_cic_scoped_pi_dependent_application_structural_relation_make \* ctx domain.
    (authority : corrected_cic_scoped_dependent_application_term_authority ctx domain) :
    corrected_cic_scoped_pi_dependent_application_structural_relation ctx domain =
    ?= authority ?|
    | corrected_cic_scoped_dependent_application_term_authority (
        scope, left_body, _, right_body, _) =>
        corrected_cic_scoped_pi_dependent_application_structural_relation (
            corrected_cic_scoped_pi_term_authority_make scope left_body right_body,
            authority)



:| corrected_cic_scoped_pi_dependent_application_intrinsic_defeq ctx domain =
    | CorrectedCicScopedPiDependentApplicationIntrinsicReflexivity :: \* ctx domain.
        corrected_cic_scoped_pi_term_authority ctx domain *
        corrected_cic_scoped_dependent_application_term_authority ctx domain ->
        corrected_cic_scoped_pi_dependent_application_intrinsic_defeq ctx domain
    | CorrectedCicScopedPiDependentApplicationIntrinsicDefinitionUnfold :: \* ctx domain.
        corrected_cic_scoped_pi_term_authority ctx domain *
        corrected_cic_scoped_dependent_application_term_authority ctx domain ->
        corrected_cic_scoped_pi_dependent_application_intrinsic_defeq ctx domain

:= corrected_cic_scoped_pi_dependent_application_intrinsic_reflexivity_make \* ctx domain.
    (scope : corrected_cic_shared_domain_scope ctx domain)
    (body : corrected_cic_term (ctx_extend ctx domain) (universe_sort universe_one))
    (argument : corrected_cic_term ctx domain) :
    corrected_cic_scoped_pi_dependent_application_intrinsic_defeq ctx domain =
    CorrectedCicScopedPiDependentApplicationIntrinsicReflexivity (
        corrected_cic_scoped_pi_term_authority_make scope body body,
        corrected_cic_scoped_dependent_application_term_authority_make
            scope body argument body argument)

:= corrected_cic_scoped_pi_dependent_application_intrinsic_definition_unfold_make \* ctx domain.
    (scope : corrected_cic_shared_domain_scope ctx domain)
    (body : corrected_cic_term (ctx_extend ctx domain) (universe_sort universe_one))
    (argument : corrected_cic_term ctx domain) :
    corrected_cic_scoped_pi_dependent_application_intrinsic_defeq ctx domain =
    := defined_body = CorrectedDefinition (
        body,
        "definition-unfold-is-a-non-reflexive-structural-defeq-step-before-Pi-and-dependent-Application-comparison")
    CorrectedCicScopedPiDependentApplicationIntrinsicDefinitionUnfold (
        corrected_cic_scoped_pi_term_authority_make scope defined_body body,
        corrected_cic_scoped_dependent_application_term_authority_make
            scope defined_body argument body argument)

:= corrected_cic_scoped_pi_dependent_application_intrinsic_defeq_relation \* ctx domain.
    (proof : corrected_cic_scoped_pi_dependent_application_intrinsic_defeq ctx domain) :
    corrected_cic_scoped_pi_dependent_application_structural_relation ctx domain =
    ?= proof ?|
    | CorrectedCicScopedPiDependentApplicationIntrinsicReflexivity (
        pi_authority, dependent_application_authority) =>
        corrected_cic_scoped_pi_dependent_application_structural_relation (
            pi_authority, dependent_application_authority)
    | CorrectedCicScopedPiDependentApplicationIntrinsicDefinitionUnfold (
        pi_authority, dependent_application_authority) =>
        corrected_cic_scoped_pi_dependent_application_structural_relation (
            pi_authority, dependent_application_authority)

:! corrected_cic_scoped_pi_dependent_application_intrinsic_acceptance ctx domain =
    corrected_cic_scoped_pi_dependent_application_intrinsic_defeq ctx domain

:= corrected_cic_scoped_pi_dependent_application_intrinsic_acceptance_make \* ctx domain.
    (proof : corrected_cic_scoped_pi_dependent_application_intrinsic_defeq ctx domain) :
    corrected_cic_scoped_pi_dependent_application_intrinsic_acceptance ctx domain =
    corrected_cic_scoped_pi_dependent_application_intrinsic_acceptance proof

:= corrected_cic_scoped_pi_dependent_application_intrinsic_acceptance_proof \* ctx domain.
    (acceptance : corrected_cic_scoped_pi_dependent_application_intrinsic_acceptance ctx domain) :
    corrected_cic_scoped_pi_dependent_application_intrinsic_defeq ctx domain =
    ?= acceptance ?|
    | corrected_cic_scoped_pi_dependent_application_intrinsic_acceptance proof => proof

:| corrected_cic_scoped_pi_dependent_application_constraint ctx domain =
    | CorrectedCicScopedPiDependentApplicationConstraintIntrinsic :
        corrected_cic_scoped_pi_dependent_application_intrinsic_acceptance ctx domain
    | CorrectedCicScopedPiDependentApplicationConstraintObstruction :
        corrected_cic_scoped_pi_dependent_application_structural_relation ctx domain

:= corrected_cic_scoped_pi_dependent_application_constraint_relation \* ctx domain.
    (constraint : corrected_cic_scoped_pi_dependent_application_constraint ctx domain) :
    corrected_cic_scoped_pi_dependent_application_structural_relation ctx domain =
    ?= constraint ?|
    | CorrectedCicScopedPiDependentApplicationConstraintIntrinsic acceptance =>
        ?= acceptance ?|
        | corrected_cic_scoped_pi_dependent_application_intrinsic_acceptance proof =>
            corrected_cic_scoped_pi_dependent_application_intrinsic_defeq_relation proof
    | CorrectedCicScopedPiDependentApplicationConstraintObstruction relation => relation


:| corrected_cic_scoped_pi_intrinsic_defeq ctx domain =
    | CorrectedCicScopedPiIntrinsicReflexivity :: \* ctx domain.
        corrected_cic_shared_domain_scope ctx domain *
        corrected_cic_term (ctx_extend ctx domain) (universe_sort universe_one) ->
        corrected_cic_scoped_pi_intrinsic_defeq ctx domain
    | CorrectedCicScopedPiIntrinsicDefinitionUnfold :: \* ctx domain.
        corrected_cic_shared_domain_scope ctx domain *
        corrected_cic_term (ctx_extend ctx domain) (universe_sort universe_one) ->
        corrected_cic_scoped_pi_intrinsic_defeq ctx domain

:= corrected_cic_scoped_pi_intrinsic_defeq_relation \* ctx domain.
    (proof : corrected_cic_scoped_pi_intrinsic_defeq ctx domain) :
    corrected_cic_scoped_pi_term_authority ctx domain =
    ?= proof ?|
    | CorrectedCicScopedPiIntrinsicReflexivity (scope, body) =>
        corrected_cic_scoped_pi_term_authority_make scope body body
    | CorrectedCicScopedPiIntrinsicDefinitionUnfold (scope, body) =>
        corrected_cic_scoped_pi_term_authority_make
            scope
            (CorrectedDefinition (
                body,
                "definition-unfold-is-a-non-reflexive-intrinsic-Pi-defeq-step"))
            body

:| corrected_cic_scoped_pi_constraint ctx domain =
    | CorrectedCicScopedPiConstraintIntrinsic : corrected_cic_scoped_pi_intrinsic_defeq ctx domain
    | CorrectedCicScopedPiConstraintObstruction : corrected_cic_scoped_pi_term_authority ctx domain

:| corrected_cic_scoped_application_intrinsic_defeq ctx domain codomain =
    | CorrectedCicScopedApplicationIntrinsicReflexivity :: \* ctx domain codomain.
        corrected_cic_shared_domain_scope ctx domain *
        corrected_cic_term ctx (function_sort domain codomain) *
        corrected_cic_term ctx domain ->
        corrected_cic_scoped_application_intrinsic_defeq ctx domain codomain
    | CorrectedCicScopedApplicationIntrinsicDefinitionUnfold :: \* ctx domain codomain.
        corrected_cic_shared_domain_scope ctx domain *
        corrected_cic_term ctx (function_sort domain codomain) *
        corrected_cic_term ctx domain ->
        corrected_cic_scoped_application_intrinsic_defeq ctx domain codomain

:= corrected_cic_scoped_application_intrinsic_reflexivity_make \* ctx domain codomain.
    (scope : corrected_cic_shared_domain_scope ctx domain)
    (function_term : corrected_cic_term ctx (function_sort domain codomain))
    (argument : corrected_cic_term ctx domain) :
    corrected_cic_scoped_application_intrinsic_defeq ctx domain codomain =
    CorrectedCicScopedApplicationIntrinsicReflexivity (scope, function_term, argument)

:= corrected_cic_scoped_application_intrinsic_definition_unfold_make \* ctx domain codomain.
    (scope : corrected_cic_shared_domain_scope ctx domain)
    (function_term : corrected_cic_term ctx (function_sort domain codomain))
    (argument : corrected_cic_term ctx domain) :
    corrected_cic_scoped_application_intrinsic_defeq ctx domain codomain =
    CorrectedCicScopedApplicationIntrinsicDefinitionUnfold (scope, function_term, argument)

:= corrected_cic_scoped_application_intrinsic_defeq_relation \* ctx domain codomain.
    (proof : corrected_cic_scoped_application_intrinsic_defeq ctx domain codomain) :
    corrected_cic_scoped_application_term_authority ctx domain codomain =
    ?= proof ?|
    | CorrectedCicScopedApplicationIntrinsicReflexivity (scope, function_term, argument) =>
        corrected_cic_scoped_application_term_authority_make
            scope function_term argument function_term argument
    | CorrectedCicScopedApplicationIntrinsicDefinitionUnfold (scope, function_term, argument) =>
        corrected_cic_scoped_application_term_authority_make
            scope
            (CorrectedDefinition (
                function_term,
                "definition-unfold-is-a-non-reflexive-intrinsic-Application-defeq-step"))
            argument
            function_term
            argument

:| corrected_cic_scoped_application_constraint ctx domain codomain =
    | CorrectedCicScopedApplicationConstraintIntrinsic :
        corrected_cic_scoped_application_intrinsic_defeq ctx domain codomain
    | CorrectedCicScopedApplicationConstraintObstruction :
        corrected_cic_scoped_application_term_authority ctx domain codomain

:| ^ corrected_cic_conversion_constraint_program length =
    | CorrectedCicConversionConstraintProgramDone ::
        corrected_cic_conversion_constraint_program cic_chain_zero
    | CorrectedCicConversionConstraintProgramNonDefeqTerms :: \* previous.
        (\? ctx sort.
            corrected_cic_structural_nondefeq_authority ctx sort *
            corrected_cic_conversion_constraint_program previous *
            string) ->
        corrected_cic_conversion_constraint_program
            (cic_chain_succ previous)
    | CorrectedCicConversionConstraintProgramIntrinsicTerms :: \* previous.
        (\? ctx sort.
            corrected_cic_structural_defeq_pair_authority ctx sort *
            corrected_cic_conversion_constraint_program previous *
            string) ->
        corrected_cic_conversion_constraint_program
            (cic_chain_succ previous)
    | CorrectedCicConversionConstraintProgramScopedPi :: \* previous.
        (\? ctx domain.
            corrected_cic_scoped_pi_constraint ctx domain *
            corrected_cic_conversion_constraint_program previous *
            string) ->
        corrected_cic_conversion_constraint_program
            (cic_chain_succ previous)
    | CorrectedCicConversionConstraintProgramScopedApplication :: \* previous.
        (\? ctx domain codomain.
            corrected_cic_scoped_application_constraint ctx domain codomain *
            corrected_cic_conversion_constraint_program previous *
            string) ->
        corrected_cic_conversion_constraint_program
            (cic_chain_succ previous)
    | CorrectedCicConversionConstraintProgramScopedDependentApplication :: \* previous.
        (\? ctx domain.
            corrected_cic_scoped_pi_dependent_application_constraint ctx domain *
            corrected_cic_conversion_constraint_program previous *
            string) ->
        corrected_cic_conversion_constraint_program
            (cic_chain_succ previous)

:= ^ solve_corrected_cic_conversion_constraints \* length.
    (program : corrected_cic_conversion_constraint_program length)
    : i64
    =
    ?= program ?|
    | CorrectedCicConversionConstraintProgramDone => 1i64
    | CorrectedCicConversionConstraintProgramNonDefeqTerms payload =>
        := \? ctx sort. authority, tail, _ = payload
        := _ = corrected_cic_structural_nondefeq_authority_note authority
        solve_corrected_cic_conversion_constraints tail
    | CorrectedCicConversionConstraintProgramIntrinsicTerms payload =>
        := \? ctx sort. authority, tail, _ = payload
        := _ = corrected_cic_structural_defeq_pair_authority_witness authority
        solve_corrected_cic_conversion_constraints tail
    | CorrectedCicConversionConstraintProgramScopedPi payload =>
        := \? ctx domain. constraint, tail, _ = payload
        ?= constraint ?|
        | CorrectedCicScopedPiConstraintIntrinsic proof =>
            := relation = corrected_cic_scoped_pi_intrinsic_defeq_relation proof
            := _ = relation
            solve_corrected_cic_conversion_constraints tail
        | CorrectedCicScopedPiConstraintObstruction authority =>
            cic_runtime_and_i64
                (decide_corrected_cic_structural_defeq_request (
                    CorrectedCicStructuralDefeqRequestScopedPi (\? authority)))
                (solve_corrected_cic_conversion_constraints tail)
    | CorrectedCicConversionConstraintProgramScopedApplication payload =>
        := \? ctx domain codomain. constraint, tail, _ = payload
        ?= constraint ?|
        | CorrectedCicScopedApplicationConstraintIntrinsic proof =>
            := relation = corrected_cic_scoped_application_intrinsic_defeq_relation proof
            := indexed_authority =
                corrected_cic_scoped_application_indexed_defeq_authority_make relation
            := _ = indexed_authority
            solve_corrected_cic_conversion_constraints tail
        | CorrectedCicScopedApplicationConstraintObstruction authority =>
            cic_runtime_and_i64
                (decide_corrected_cic_structural_defeq_request (
                    CorrectedCicStructuralDefeqRequestScopedApplication (\? authority)))
                (solve_corrected_cic_conversion_constraints tail)
    | CorrectedCicConversionConstraintProgramScopedDependentApplication payload =>
        := \? ctx domain. constraint, tail, _ = payload
        ?= constraint ?|
        | CorrectedCicScopedPiDependentApplicationConstraintIntrinsic acceptance =>
            := proof = corrected_cic_scoped_pi_dependent_application_intrinsic_acceptance_proof acceptance
            := relation = corrected_cic_scoped_pi_dependent_application_intrinsic_defeq_relation proof
            := _ = relation
            solve_corrected_cic_conversion_constraints tail
        | CorrectedCicScopedPiDependentApplicationConstraintObstruction relation =>
            ?= relation ?|
            | corrected_cic_scoped_pi_dependent_application_structural_relation (
                    pi_authority,
                    dependent_application_authority
                )
                =>
                    cic_runtime_and_i64
                        (
                            cic_runtime_and_i64
                                (decide_corrected_cic_scoped_pi_term_authority pi_authority)
                                (
                                    decide_corrected_cic_scoped_dependent_application_term_authority
                                        dependent_application_authority
                                )
                        )
                        (solve_corrected_cic_conversion_constraints tail)

:= ^ corrected_cic_conversion_constraint_count \* length.
    (program : corrected_cic_conversion_constraint_program length) : i64 =
    ?= program ?|
    | CorrectedCicConversionConstraintProgramDone => 0i64
    | CorrectedCicConversionConstraintProgramNonDefeqTerms payload =>
        := \? ctx sort. _, tail, _ = payload
        cic_runtime_add_i64 1i64
            (corrected_cic_conversion_constraint_count tail)
    | CorrectedCicConversionConstraintProgramIntrinsicTerms payload =>
        := \? ctx sort. _, tail, _ = payload
        cic_runtime_add_i64 1i64
            (corrected_cic_conversion_constraint_count tail)
    | CorrectedCicConversionConstraintProgramScopedPi payload =>
        := \? ctx domain. _, tail, _ = payload
        cic_runtime_add_i64 1i64
            (corrected_cic_conversion_constraint_count tail)
    | CorrectedCicConversionConstraintProgramScopedApplication payload =>
        := \? ctx domain codomain. _, tail, _ = payload
        cic_runtime_add_i64 1i64
            (corrected_cic_conversion_constraint_count tail)
    | CorrectedCicConversionConstraintProgramScopedDependentApplication payload =>
        := \? ctx domain. _, tail, _ = payload
        cic_runtime_add_i64 1i64
            (corrected_cic_conversion_constraint_count tail)

:! corrected_cic_typed_meta_zero = ()
:! corrected_cic_typed_meta_succ previous = previous

:| ^ corrected_cic_typed_meta_id identity =
    | CorrectedCicTypedMetaZero :: corrected_cic_typed_meta_id corrected_cic_typed_meta_zero
    | CorrectedCicTypedMetaSucc :: \* previous.
        corrected_cic_typed_meta_id previous ->
        corrected_cic_typed_meta_id (corrected_cic_typed_meta_succ previous)



:| ^ corrected_cic_typed_meta_equal left right =
    | CorrectedCicTypedMetaEqualZero ::
        corrected_cic_typed_meta_equal corrected_cic_typed_meta_zero corrected_cic_typed_meta_zero
    | CorrectedCicTypedMetaEqualSucc :: \* left right.
        corrected_cic_typed_meta_equal left right ->
        corrected_cic_typed_meta_equal
            (corrected_cic_typed_meta_succ left)
            (corrected_cic_typed_meta_succ right)

:| ^ corrected_cic_meta_membership_identity_spine identity =
    | CorrectedCicMetaMembershipIdentityHere ::
        corrected_cic_meta_membership_identity_spine corrected_cic_typed_meta_zero
    | CorrectedCicMetaMembershipIdentityUnderOpen :: \* previous.
        corrected_cic_meta_membership_identity_spine previous ->
        corrected_cic_meta_membership_identity_spine (corrected_cic_typed_meta_succ previous)
    | CorrectedCicMetaMembershipIdentityUnderSolved :: \* previous.
        corrected_cic_meta_membership_identity_spine previous ->
        corrected_cic_meta_membership_identity_spine (corrected_cic_typed_meta_succ previous)

:= ^ corrected_cic_meta_membership_identity_spine_id \* identity.
    (spine : corrected_cic_meta_membership_identity_spine identity) :
    corrected_cic_typed_meta_id identity =
    ?= spine ?|
    | CorrectedCicMetaMembershipIdentityHere =>
        CorrectedCicTypedMetaZero
    | CorrectedCicMetaMembershipIdentityUnderOpen inner =>
        CorrectedCicTypedMetaSucc (
            corrected_cic_meta_membership_identity_spine_id inner)
    | CorrectedCicMetaMembershipIdentityUnderSolved inner =>
        CorrectedCicTypedMetaSucc (
            corrected_cic_meta_membership_identity_spine_id inner)

:| ^ corrected_cic_typed_meta_not_equal left right =
    | CorrectedCicTypedMetaZeroNotSucc :: \* right.
        corrected_cic_typed_meta_id right ->
        corrected_cic_typed_meta_not_equal corrected_cic_typed_meta_zero (corrected_cic_typed_meta_succ right)
    | CorrectedCicTypedMetaSuccNotZero :: \* left.
        corrected_cic_typed_meta_id left ->
        corrected_cic_typed_meta_not_equal (corrected_cic_typed_meta_succ left) corrected_cic_typed_meta_zero
    | CorrectedCicTypedMetaSuccNotSucc :: \* left right.
        corrected_cic_typed_meta_not_equal left right ->
        corrected_cic_typed_meta_not_equal
            (corrected_cic_typed_meta_succ left)
            (corrected_cic_typed_meta_succ right)

:| corrected_cic_typed_meta_identity_decision left right =
    | CorrectedCicTypedMetaIdentityEqual :: \* left right.
        corrected_cic_typed_meta_equal left right ->
        corrected_cic_typed_meta_identity_decision left right
    | CorrectedCicTypedMetaIdentityDifferent :: \* left right.
        corrected_cic_typed_meta_not_equal left right ->
        corrected_cic_typed_meta_identity_decision left right

:= ^ decide_corrected_cic_typed_meta_identity \* left right.
    (left : corrected_cic_typed_meta_id left)
    (right : corrected_cic_typed_meta_id right) :
    corrected_cic_typed_meta_identity_decision left right =
    ?= left, right ?|
    | CorrectedCicTypedMetaZero, CorrectedCicTypedMetaZero =>
        CorrectedCicTypedMetaIdentityEqual CorrectedCicTypedMetaEqualZero
    | CorrectedCicTypedMetaZero, CorrectedCicTypedMetaSucc right_previous =>
        CorrectedCicTypedMetaIdentityDifferent (
            CorrectedCicTypedMetaZeroNotSucc right_previous)
    | CorrectedCicTypedMetaSucc left_previous, CorrectedCicTypedMetaZero =>
        CorrectedCicTypedMetaIdentityDifferent (
            CorrectedCicTypedMetaSuccNotZero left_previous)
    | CorrectedCicTypedMetaSucc left_previous, CorrectedCicTypedMetaSucc right_previous =>
        ?= decide_corrected_cic_typed_meta_identity left_previous right_previous ?|
        | CorrectedCicTypedMetaIdentityEqual equal =>
            CorrectedCicTypedMetaIdentityEqual (
                CorrectedCicTypedMetaEqualSucc equal)
        | CorrectedCicTypedMetaIdentityDifferent different =>
            CorrectedCicTypedMetaIdentityDifferent (
                CorrectedCicTypedMetaSuccNotSucc different)

:| ^ corrected_cic_selected_typed_meta_term selected =
    | CorrectedCicSelectedTypedMetaRigid :: \* selected.
        string -> corrected_cic_selected_typed_meta_term selected
    | CorrectedCicSelectedTypedMetaTarget :: \* selected.
        corrected_cic_typed_meta_id selected ->
        corrected_cic_selected_typed_meta_term selected
    | CorrectedCicSelectedTypedMetaOther :: \* selected.
        (\? other.
            corrected_cic_typed_meta_id other *
            corrected_cic_typed_meta_not_equal selected other) ->
        corrected_cic_selected_typed_meta_term selected
    | CorrectedCicSelectedTypedMetaSuspension :: \* selected.
        corrected_cic_selected_typed_meta_term selected ->
        corrected_cic_selected_typed_meta_term selected

:= ^ apply_corrected_cic_selected_typed_meta_assignment \* selected.
    (replacement : corrected_cic_selected_typed_meta_term selected)
    (term : corrected_cic_selected_typed_meta_term selected) :
    corrected_cic_selected_typed_meta_term selected =
    ?= term ?|
    | CorrectedCicSelectedTypedMetaRigid value =>
        CorrectedCicSelectedTypedMetaRigid value
    | CorrectedCicSelectedTypedMetaTarget _ => replacement
    | CorrectedCicSelectedTypedMetaOther payload =>
        CorrectedCicSelectedTypedMetaOther payload
    | CorrectedCicSelectedTypedMetaSuspension inner =>
        CorrectedCicSelectedTypedMetaSuspension (
            apply_corrected_cic_selected_typed_meta_assignment replacement inner)

:= ^ corrected_cic_selected_typed_meta_term_tag \* selected.
    (term : corrected_cic_selected_typed_meta_term selected) : i64 =
    ?= term ?|
    | CorrectedCicSelectedTypedMetaRigid _ => 1i64
    | CorrectedCicSelectedTypedMetaTarget _ => 2i64
    | CorrectedCicSelectedTypedMetaOther _ => 3i64
    | CorrectedCicSelectedTypedMetaSuspension inner =>
        corrected_cic_selected_typed_meta_term_tag inner

:= corrected_cic_selected_typed_meta_target_from_spine \* identity.
    (spine : corrected_cic_meta_membership_identity_spine identity) :
    corrected_cic_selected_typed_meta_term identity =
    CorrectedCicSelectedTypedMetaTarget (
        corrected_cic_meta_membership_identity_spine_id spine)

:= corrected_cic_selected_typed_meta_spine_assignment_tag \* identity.
    (spine : corrected_cic_meta_membership_identity_spine identity) : i64 =
    := replacement : corrected_cic_selected_typed_meta_term identity =
        CorrectedCicSelectedTypedMetaRigid "assigned-from-membership-identity-spine"
    := target = corrected_cic_selected_typed_meta_target_from_spine spine
    corrected_cic_selected_typed_meta_term_tag (
        apply_corrected_cic_selected_typed_meta_assignment replacement target)

:= corrected_cic_selected_zero_other_from_nonzero_spine \* previous.
    (spine : corrected_cic_meta_membership_identity_spine (corrected_cic_typed_meta_succ previous)) :
    corrected_cic_selected_typed_meta_term corrected_cic_typed_meta_zero =
    ?= spine ?|
    | CorrectedCicMetaMembershipIdentityUnderOpen inner =>
        := inner_id = corrected_cic_meta_membership_identity_spine_id inner
        CorrectedCicSelectedTypedMetaOther (\? (
            CorrectedCicTypedMetaSucc inner_id,
            CorrectedCicTypedMetaZeroNotSucc inner_id))
    | CorrectedCicMetaMembershipIdentityUnderSolved inner =>
        := inner_id = corrected_cic_meta_membership_identity_spine_id inner
        CorrectedCicSelectedTypedMetaOther (\? (
            CorrectedCicTypedMetaSucc inner_id,
            CorrectedCicTypedMetaZeroNotSucc inner_id))

:= corrected_cic_selected_typed_meta_term_from_spine \* selected identity.
    (selected_id : corrected_cic_typed_meta_id selected)
    (spine : corrected_cic_meta_membership_identity_spine identity) :
    corrected_cic_selected_typed_meta_term selected =
    := identity_id = corrected_cic_meta_membership_identity_spine_id spine
    ?= decide_corrected_cic_typed_meta_identity selected_id identity_id ?|
    | CorrectedCicTypedMetaIdentityEqual _ =>
        CorrectedCicSelectedTypedMetaTarget selected_id
    | CorrectedCicTypedMetaIdentityDifferent different =>
        CorrectedCicSelectedTypedMetaOther (\? (identity_id, different))

:= corrected_cic_selected_zero_term_from_spine \* identity.
    (spine : corrected_cic_meta_membership_identity_spine identity) :
    corrected_cic_selected_typed_meta_term corrected_cic_typed_meta_zero =
    corrected_cic_selected_typed_meta_term_from_spine CorrectedCicTypedMetaZero spine



:= assert_corrected_cic_selected_typed_meta_assignment_runtime
    (selected_tag : i64) (other_tag : i64) : () =
    := ok_0 = !!!!EQ(selected_tag, 1i64)
    := ok_1 = !!!!EQ(other_tag, 3i64)
    ? ok_0 && ok_1 ?> () |: mega_runtime_fail "corrected-CIC-typed-meta-selective-assignment-runtime-mismatch"

:= corrected_cic_selected_typed_meta_assignment_terminal () : string =
    := selected = CorrectedCicTypedMetaZero
    := other = CorrectedCicTypedMetaSucc CorrectedCicTypedMetaZero
    := replacement :
        corrected_cic_selected_typed_meta_term corrected_cic_typed_meta_zero =
        CorrectedCicSelectedTypedMetaRigid "True"
    := selected_term :
        corrected_cic_selected_typed_meta_term corrected_cic_typed_meta_zero =
        CorrectedCicSelectedTypedMetaTarget selected
    := other_term :
        corrected_cic_selected_typed_meta_term corrected_cic_typed_meta_zero =
        CorrectedCicSelectedTypedMetaOther (\? (
            other,
            CorrectedCicTypedMetaZeroNotSucc CorrectedCicTypedMetaZero))
    := assigned_selected =
        apply_corrected_cic_selected_typed_meta_assignment replacement selected_term
    := assigned_other =
        apply_corrected_cic_selected_typed_meta_assignment replacement other_term
    := _ =
        ?= assigned_selected, assigned_other ?|
        | CorrectedCicSelectedTypedMetaRigid _, CorrectedCicSelectedTypedMetaOther _ => ()
        | _ => mega_runtime_fail "corrected-CIC-typed-meta-selective-assignment-structural-mismatch"
    "typed-meta-identity-now-lives-in-the-type-index-selected-target-is-replaced-and-a-structurally-proven-differen"
    ^^ "t-target-is-preserved-without-runtime-existential-selection-and-the-legacy-string-unification-machine-has-now-"
    ^^ "been-physically-retired-from-the-mega-surface"

:| ^ corrected_cic_selected_typed_meta_assignment_program selected =
    | CorrectedCicSelectedTypedMetaAssignmentProgramDone :: \* selected.
        corrected_cic_selected_typed_meta_assignment_program selected
    | CorrectedCicSelectedTypedMetaAssignmentProgramMore :: \* selected.
        corrected_cic_selected_typed_meta_term selected *
        corrected_cic_selected_typed_meta_assignment_program selected * string ->
        corrected_cic_selected_typed_meta_assignment_program selected

:= ^ apply_corrected_cic_selected_typed_meta_assignment_program \* selected.
    (replacement : corrected_cic_selected_typed_meta_term selected)
    (program : corrected_cic_selected_typed_meta_assignment_program selected) :
    corrected_cic_selected_typed_meta_assignment_program selected =
    ?= program ?|
    | CorrectedCicSelectedTypedMetaAssignmentProgramDone =>
        CorrectedCicSelectedTypedMetaAssignmentProgramDone
    | CorrectedCicSelectedTypedMetaAssignmentProgramMore (head, tail, note) =>
        CorrectedCicSelectedTypedMetaAssignmentProgramMore (
            apply_corrected_cic_selected_typed_meta_assignment replacement head,
            apply_corrected_cic_selected_typed_meta_assignment_program replacement tail,
            note)

:= ^ corrected_cic_selected_typed_meta_assignment_program_runtime \* selected.
    (program : corrected_cic_selected_typed_meta_assignment_program selected) : i64 * i64 * i64 =
    ?= program ?|
    | CorrectedCicSelectedTypedMetaAssignmentProgramDone => 0i64, 0i64, 0i64
    | CorrectedCicSelectedTypedMetaAssignmentProgramMore (head, tail, _) =>
        := tail_cells, tail_rigid, tail_other =
            corrected_cic_selected_typed_meta_assignment_program_runtime tail
        := tag = corrected_cic_selected_typed_meta_term_tag head
        := rigid : i64 = ? !!!!EQ(tag, 1i64) ?> 1i64 |: 0i64
        := other : i64 = ? !!!!EQ(tag, 3i64) ?> 1i64 |: 0i64
        cic_runtime_add_i64 1i64 tail_cells,
        cic_runtime_add_i64 rigid tail_rigid,
        cic_runtime_add_i64 other tail_other

:= assert_corrected_cic_selected_typed_meta_assignment_program_runtime
    (cells : i64) (rigid : i64) (other : i64)
    : ()
    =
    := ok_0 = !!!!EQ(cells, 3i64)
    := ok_1 = !!!!EQ(rigid, 2i64)
    := ok_2 = !!!!EQ(other, 1i64)
    ? ok_0 && ok_1 && ok_2
    ?> ()
    |: mega_runtime_fail "corrected-CIC-typed-meta-assignment-program-runtime-mismatch"

:= corrected_cic_selected_typed_meta_assignment_program_terminal () : string =
    := selected = CorrectedCicTypedMetaZero
    := other = CorrectedCicTypedMetaSucc CorrectedCicTypedMetaZero
    := replacement : corrected_cic_selected_typed_meta_term corrected_cic_typed_meta_zero =
        CorrectedCicSelectedTypedMetaRigid "True"
    := selected_term : corrected_cic_selected_typed_meta_term corrected_cic_typed_meta_zero =
        CorrectedCicSelectedTypedMetaTarget selected
    := other_term : corrected_cic_selected_typed_meta_term corrected_cic_typed_meta_zero =
        CorrectedCicSelectedTypedMetaOther (\? (
            other,
            CorrectedCicTypedMetaZeroNotSucc CorrectedCicTypedMetaZero))
    := program : corrected_cic_selected_typed_meta_assignment_program corrected_cic_typed_meta_zero =
        CorrectedCicSelectedTypedMetaAssignmentProgramMore (
            selected_term,
            CorrectedCicSelectedTypedMetaAssignmentProgramMore (
                other_term,
                CorrectedCicSelectedTypedMetaAssignmentProgramMore (
                    CorrectedCicSelectedTypedMetaSuspension selected_term,
                    CorrectedCicSelectedTypedMetaAssignmentProgramDone,
                    "the-third-cell-tests-recursive-assignment-under-suspension"),
                "the-second-cell-proves-an-other-meta-survives-the-program"),
            "the-first-cell-selects-the-meta-that-must-be-replaced")
    := assigned =
        apply_corrected_cic_selected_typed_meta_assignment_program replacement program
    := cells, rigid, preserved_other =
        corrected_cic_selected_typed_meta_assignment_program_runtime assigned
    := _ =
        assert_corrected_cic_selected_typed_meta_assignment_program_runtime
            cells rigid preserved_other
    "typed-meta-selective-assignment-now-maps-a-recursive-three-cell-program-so-the-selected-target-and-one-suspend"
    ^^ "ed-occurrence-become-rigid-while-a-structurally-different-meta-remains-other-without-a-runtime-string-guard-an"
    ^^ "d-the-legacy-string-constraint-solver-has-now-been-physically-retired"

:| ^ corrected_cic_selected_typed_meta_constraint_program selected =
    | CorrectedCicSelectedTypedMetaConstraintProgramDone :: \* selected.
        corrected_cic_selected_typed_meta_constraint_program selected
    | CorrectedCicSelectedTypedMetaConstraintProgramMore :: \* selected.
        corrected_cic_selected_typed_meta_term selected *
        corrected_cic_selected_typed_meta_term selected *
        corrected_cic_selected_typed_meta_constraint_program selected * string ->
        corrected_cic_selected_typed_meta_constraint_program selected

:= ^ corrected_cic_selected_typed_meta_occurs \* selected.
    (term : corrected_cic_selected_typed_meta_term selected) : i64 =
    ?= term ?|
    | CorrectedCicSelectedTypedMetaRigid _ => 0i64
    | CorrectedCicSelectedTypedMetaTarget _ => 1i64
    | CorrectedCicSelectedTypedMetaOther _ => 0i64
    | CorrectedCicSelectedTypedMetaSuspension inner =>
        corrected_cic_selected_typed_meta_occurs inner

:= ^ decide_corrected_cic_selected_typed_meta_term_equal \* selected.
    (left : corrected_cic_selected_typed_meta_term selected)
    (right : corrected_cic_selected_typed_meta_term selected) : i64 =
    ?= left, right ?|
    | CorrectedCicSelectedTypedMetaRigid left_value,
      CorrectedCicSelectedTypedMetaRigid right_value =>
        cic_runtime_string_equal left_value right_value
    | CorrectedCicSelectedTypedMetaTarget _,
      CorrectedCicSelectedTypedMetaTarget _ => 1i64
    | CorrectedCicSelectedTypedMetaOther left_payload,
      CorrectedCicSelectedTypedMetaOther right_payload =>
        := \? left_other. left_id, _ = left_payload
        := \? right_other. right_id, _ = right_payload
        ?= decide_corrected_cic_typed_meta_identity left_id right_id ?|
        | CorrectedCicTypedMetaIdentityEqual _ => 1i64
        | CorrectedCicTypedMetaIdentityDifferent _ => 0i64
    | CorrectedCicSelectedTypedMetaSuspension left_inner,
      CorrectedCicSelectedTypedMetaSuspension right_inner =>
        decide_corrected_cic_selected_typed_meta_term_equal left_inner right_inner
    | _, _ => 0i64

:= ^ solve_corrected_cic_selected_typed_meta_constraints_after_assignment \* selected.
    (replacement : corrected_cic_selected_typed_meta_term selected)
    (program : corrected_cic_selected_typed_meta_constraint_program selected) : i64 =
    ?= program ?|
    | CorrectedCicSelectedTypedMetaConstraintProgramDone => 1i64
    | CorrectedCicSelectedTypedMetaConstraintProgramMore (left, right, tail, _) =>
        := assigned_left =
            apply_corrected_cic_selected_typed_meta_assignment replacement left
        := assigned_right =
            apply_corrected_cic_selected_typed_meta_assignment replacement right
        cic_runtime_and_i64
            (decide_corrected_cic_selected_typed_meta_term_equal
                assigned_left assigned_right)
            (solve_corrected_cic_selected_typed_meta_constraints_after_assignment
                replacement tail)

:= solve_corrected_cic_selected_typed_meta_constraints \* selected.
    (replacement : corrected_cic_selected_typed_meta_term selected)
    (program : corrected_cic_selected_typed_meta_constraint_program selected) : i64 =
    ?= corrected_cic_selected_typed_meta_occurs replacement ?|
    | 1i64 => 0i64
    | _ =>
        solve_corrected_cic_selected_typed_meta_constraints_after_assignment
            replacement program

:= ^ corrected_cic_selected_typed_meta_constraint_count \* selected.
    (program : corrected_cic_selected_typed_meta_constraint_program selected) : i64 =
    ?= program ?|
    | CorrectedCicSelectedTypedMetaConstraintProgramDone => 0i64
    | CorrectedCicSelectedTypedMetaConstraintProgramMore (_, _, tail, _) =>
        cic_runtime_add_i64 1i64
            (corrected_cic_selected_typed_meta_constraint_count tail)

:= corrected_cic_selected_typed_meta_constraint_program_from_spine \* identity.
    (spine : corrected_cic_meta_membership_identity_spine identity) :
    corrected_cic_selected_typed_meta_constraint_program identity =
    := target : corrected_cic_selected_typed_meta_term identity =
        corrected_cic_selected_typed_meta_target_from_spine spine
    := rigid_true : corrected_cic_selected_typed_meta_term identity =
        CorrectedCicSelectedTypedMetaRigid "True"
    CorrectedCicSelectedTypedMetaConstraintProgramMore (
        target,
        rigid_true,
        CorrectedCicSelectedTypedMetaConstraintProgramDone,
        "the-membership-identity-spine-builds-one-selected-target-equality-against-True")

:= solve_corrected_cic_selected_typed_meta_constraints_from_spine \* identity.
    (spine : corrected_cic_meta_membership_identity_spine identity) : i64 =
    := replacement : corrected_cic_selected_typed_meta_term identity =
        CorrectedCicSelectedTypedMetaRigid "True"
    solve_corrected_cic_selected_typed_meta_constraints
        replacement
        (corrected_cic_selected_typed_meta_constraint_program_from_spine spine)

:= corrected_cic_selected_typed_meta_constraint_program_accepted () :
    corrected_cic_selected_typed_meta_constraint_program corrected_cic_typed_meta_zero =
    := selected = CorrectedCicTypedMetaZero
    := target : corrected_cic_selected_typed_meta_term corrected_cic_typed_meta_zero =
        CorrectedCicSelectedTypedMetaTarget selected
    := rigid_true : corrected_cic_selected_typed_meta_term corrected_cic_typed_meta_zero =
        CorrectedCicSelectedTypedMetaRigid "True"
    CorrectedCicSelectedTypedMetaConstraintProgramMore (
        target,
        rigid_true,
        CorrectedCicSelectedTypedMetaConstraintProgramMore (
            CorrectedCicSelectedTypedMetaSuspension target,
            CorrectedCicSelectedTypedMetaSuspension rigid_true,
            CorrectedCicSelectedTypedMetaConstraintProgramMore (
                rigid_true,
                rigid_true,
                CorrectedCicSelectedTypedMetaConstraintProgramDone,
                "one-rigid-reflexive-cell-keeps-the-three-constraint-regression-count"),
            "one-suspension-reuses-the-same-selected-meta-identity-without-a-name"),
        "the-first-typed-constraint-solves-the-selected-meta-as-True")

:= corrected_cic_selected_typed_meta_constraint_program_unrelated () :
    corrected_cic_selected_typed_meta_constraint_program corrected_cic_typed_meta_zero =
    := other = CorrectedCicTypedMetaSucc CorrectedCicTypedMetaZero
    := unrelated : corrected_cic_selected_typed_meta_term corrected_cic_typed_meta_zero =
        CorrectedCicSelectedTypedMetaOther (\? (
            other,
            CorrectedCicTypedMetaZeroNotSucc CorrectedCicTypedMetaZero))
    CorrectedCicSelectedTypedMetaConstraintProgramMore (
        unrelated,
        CorrectedCicSelectedTypedMetaRigid "True",
        CorrectedCicSelectedTypedMetaConstraintProgramDone,
        "a-structurally-different-meta-cannot-be-turned-into-the-selected-target-by-assignment")

:! corrected_cic_meta_states_empty = ()
:! corrected_cic_meta_states_open ctx sort tail = ctx * sort * tail
:! corrected_cic_meta_states_solved ctx sort tail = ctx * sort * tail

:| ^ corrected_cic_meta_environment states =
    | CorrectedCicMetaEnvironmentEmpty ::
        string ->
        corrected_cic_meta_environment corrected_cic_meta_states_empty
    | CorrectedCicMetaEnvironmentOpen :: \* ctx sort tail.
        corrected_cic_meta_environment tail * string ->
        corrected_cic_meta_environment
            (corrected_cic_meta_states_open ctx sort tail)
    | CorrectedCicMetaEnvironmentSolved :: \* ctx sort tail.
        corrected_cic_term ctx sort *
        corrected_cic_meta_environment tail * string ->
        corrected_cic_meta_environment
            (corrected_cic_meta_states_solved ctx sort tail)

:| ^ corrected_cic_meta_open_membership ctx sort source target =
    | CorrectedCicMetaOpenMembershipHere :: \* ctx sort tail.
        string ->
        corrected_cic_meta_open_membership ctx sort
            (corrected_cic_meta_states_open ctx sort tail)
            (corrected_cic_meta_states_solved ctx sort tail)
    | CorrectedCicMetaOpenMembershipUnderOpen ::
        \* ctx sort head_ctx head_sort source target.
        corrected_cic_meta_open_membership ctx sort source target * string ->
        corrected_cic_meta_open_membership ctx sort
            (corrected_cic_meta_states_open head_ctx head_sort source)
            (corrected_cic_meta_states_open head_ctx head_sort target)
    | CorrectedCicMetaOpenMembershipUnderSolved ::
        \* ctx sort head_ctx head_sort source target.
        corrected_cic_meta_open_membership ctx sort source target * string ->
        corrected_cic_meta_open_membership ctx sort
            (corrected_cic_meta_states_solved head_ctx head_sort source)
            (corrected_cic_meta_states_solved head_ctx head_sort target)

:| corrected_cic_meta_open_membership_identity =
    | CorrectedCicMetaOpenMembershipIdentity ::
        (\? identity. corrected_cic_meta_membership_identity_spine identity) ->
        corrected_cic_meta_open_membership_identity

:= ^ corrected_cic_meta_open_membership_identity_spine
    \* ctx sort source target.
    (membership : corrected_cic_meta_open_membership ctx sort source target) :
    corrected_cic_meta_open_membership_identity =
    ?= membership ?|
    | CorrectedCicMetaOpenMembershipHere _ =>
        CorrectedCicMetaOpenMembershipIdentity (\?
            CorrectedCicMetaMembershipIdentityHere)
    | CorrectedCicMetaOpenMembershipUnderOpen (inner, _) =>
        ?= corrected_cic_meta_open_membership_identity_spine inner ?|
        | CorrectedCicMetaOpenMembershipIdentity payload =>
            := \? identity. spine = payload
            CorrectedCicMetaOpenMembershipIdentity (\?
                (CorrectedCicMetaMembershipIdentityUnderOpen spine))
    | CorrectedCicMetaOpenMembershipUnderSolved (inner, _) =>
        ?= corrected_cic_meta_open_membership_identity_spine inner ?|
        | CorrectedCicMetaOpenMembershipIdentity payload =>
            := \? identity. spine = payload
            CorrectedCicMetaOpenMembershipIdentity (\?
                (CorrectedCicMetaMembershipIdentityUnderSolved spine))

:| corrected_cic_selected_open_membership_identity =
    | CorrectedCicSelectedOpenMembershipIdentity ::
        (\? identity.
            corrected_cic_typed_meta_id identity *
            corrected_cic_meta_membership_identity_spine identity) ->
        corrected_cic_selected_open_membership_identity

:= corrected_cic_selected_open_membership_identity_from_membership
    \* ctx sort source target.
    (membership : corrected_cic_meta_open_membership ctx sort source target) :
    corrected_cic_selected_open_membership_identity =
    ?= corrected_cic_meta_open_membership_identity_spine membership ?|
    | CorrectedCicMetaOpenMembershipIdentity payload =>
        := \? identity. spine = payload
        CorrectedCicSelectedOpenMembershipIdentity (\? (
            corrected_cic_meta_membership_identity_spine_id spine,
            spine))

:| corrected_cic_context_sort_indexed_open_membership_identity ctx sort source target =
    | CorrectedCicContextSortIndexedOpenMembershipIdentity :: \* ctx sort source target.
        (\? identity.
            corrected_cic_meta_open_membership ctx sort source target *
            corrected_cic_typed_meta_id identity *
            corrected_cic_meta_membership_identity_spine identity) ->
        corrected_cic_context_sort_indexed_open_membership_identity ctx sort source target

:= corrected_cic_context_sort_indexed_open_membership_identity_from_membership
    \* ctx sort source target.
    (membership : corrected_cic_meta_open_membership ctx sort source target) :
    corrected_cic_context_sort_indexed_open_membership_identity ctx sort source target =
    ?= corrected_cic_meta_open_membership_identity_spine membership ?|
    | CorrectedCicMetaOpenMembershipIdentity payload =>
        := \? identity. spine = payload
        CorrectedCicContextSortIndexedOpenMembershipIdentity (\? (
            membership,
            corrected_cic_meta_membership_identity_spine_id spine,
            spine))

:| corrected_cic_context_sort_indexed_selected_meta ctx sort source target =
    | CorrectedCicContextSortIndexedSelectedMeta :: \* ctx sort source target.
        (\? identity.
            corrected_cic_meta_open_membership ctx sort source target *
            corrected_cic_typed_meta_id identity *
            corrected_cic_meta_membership_identity_spine identity *
            corrected_cic_selected_typed_meta_term identity) ->
        corrected_cic_context_sort_indexed_selected_meta ctx sort source target

:= corrected_cic_context_sort_indexed_selected_meta_from_membership
    \* ctx sort source target.
    (membership : corrected_cic_meta_open_membership ctx sort source target) :
    corrected_cic_context_sort_indexed_selected_meta ctx sort source target =
    ?= corrected_cic_meta_open_membership_identity_spine membership ?|
    | CorrectedCicMetaOpenMembershipIdentity payload =>
        := \? identity. spine = payload
        := identity_id = corrected_cic_meta_membership_identity_spine_id spine
        CorrectedCicContextSortIndexedSelectedMeta (\? (
            membership,
            identity_id,
            spine,
            corrected_cic_selected_typed_meta_target_from_spine spine))

:| corrected_cic_environment_bound_selected_meta ctx sort source target =
    | CorrectedCicEnvironmentBoundSelectedMeta :: \* ctx sort source target.
        corrected_cic_meta_environment source *
        corrected_cic_context_sort_indexed_selected_meta ctx sort source target ->
        corrected_cic_environment_bound_selected_meta ctx sort source target

:= corrected_cic_environment_bound_selected_meta_from_environment_membership
    \* ctx sort source target.
    (environment : corrected_cic_meta_environment source)
    (membership : corrected_cic_meta_open_membership ctx sort source target) :
    corrected_cic_environment_bound_selected_meta ctx sort source target =
    CorrectedCicEnvironmentBoundSelectedMeta (
        environment,
        corrected_cic_context_sort_indexed_selected_meta_from_membership membership)

:= corrected_cic_environment_bound_selected_meta_assignment_tag
    \* ctx sort source target.
    (environment : corrected_cic_meta_environment source)
    (membership : corrected_cic_meta_open_membership ctx sort source target) : i64 =
    ?= corrected_cic_environment_bound_selected_meta_from_environment_membership environment membership ?|
    | CorrectedCicEnvironmentBoundSelectedMeta (_, selected) =>
        ?= selected ?|
        | CorrectedCicContextSortIndexedSelectedMeta payload =>
            := \? identity. _, _, spine, target = payload
            := _ =
                solve_corrected_cic_selected_typed_meta_constraints_from_spine spine
            := replacement : corrected_cic_selected_typed_meta_term identity =
                CorrectedCicSelectedTypedMetaRigid "assigned-from-environment-bound-context-sort-membership"
            corrected_cic_selected_typed_meta_term_tag (
                apply_corrected_cic_selected_typed_meta_assignment replacement target)

:= corrected_cic_context_sort_indexed_selected_meta_assignment_tag
    \* ctx sort source target.
    (membership : corrected_cic_meta_open_membership ctx sort source target) : i64 =
    ?= corrected_cic_context_sort_indexed_selected_meta_from_membership membership ?|
    | CorrectedCicContextSortIndexedSelectedMeta payload =>
        := \? identity. _, _, _, target = payload
        := replacement : corrected_cic_selected_typed_meta_term identity =
            CorrectedCicSelectedTypedMetaRigid "assigned-from-context-sort-indexed-membership"
        corrected_cic_selected_typed_meta_term_tag (
            apply_corrected_cic_selected_typed_meta_assignment replacement target)

:= corrected_cic_meta_open_membership_identity_authority_make
    \* ctx sort source target expected.
    (membership : corrected_cic_meta_open_membership ctx sort source target)
    (expected : corrected_cic_typed_meta_id expected)
    : \? identity.
        corrected_cic_typed_meta_id identity * corrected_cic_typed_meta_identity_decision identity expected
    =
    ?= corrected_cic_context_sort_indexed_open_membership_identity_from_membership membership ?|
    | CorrectedCicContextSortIndexedOpenMembershipIdentity payload =>
        := \? identity. _, identity_id, _ = payload
        \? (
            identity_id,
            decide_corrected_cic_typed_meta_identity identity_id expected)

:= corrected_cic_meta_open_membership_identity_equal
    \* ctx sort source target expected.
    (membership : corrected_cic_meta_open_membership ctx sort source target)
    (expected : corrected_cic_typed_meta_id expected) : i64 =
    ?= corrected_cic_context_sort_indexed_open_membership_identity_from_membership membership ?|
    | CorrectedCicContextSortIndexedOpenMembershipIdentity payload =>
        := \? identity. _, identity_id, _ = payload
        ?= decide_corrected_cic_typed_meta_identity identity_id expected ?|
        | CorrectedCicTypedMetaIdentityEqual _ => 1i64
        | CorrectedCicTypedMetaIdentityDifferent _ => 0i64

:= corrected_cic_meta_open_membership_assignment_tag
    \* ctx sort source target.
    (membership : corrected_cic_meta_open_membership ctx sort source target) : i64 =
    corrected_cic_context_sort_indexed_selected_meta_assignment_tag membership

:= corrected_cic_selected_typed_meta_term_from_open_membership
    \* selected ctx sort source target.
    (selected_id : corrected_cic_typed_meta_id selected)
    (membership : corrected_cic_meta_open_membership ctx sort source target) :
    corrected_cic_selected_typed_meta_term selected =
    ?= corrected_cic_meta_open_membership_identity_spine membership ?|
    | CorrectedCicMetaOpenMembershipIdentity payload =>
        := \? identity. spine = payload
        corrected_cic_selected_typed_meta_term_from_spine selected_id spine

:= corrected_cic_selected_zero_term_from_open_membership
    \* ctx sort source target.
    (membership : corrected_cic_meta_open_membership ctx sort source target) :
    corrected_cic_selected_typed_meta_term corrected_cic_typed_meta_zero =
    corrected_cic_selected_typed_meta_term_from_open_membership
        CorrectedCicTypedMetaZero membership

:| ^ corrected_cic_meta_solved_membership ctx sort states =
    | CorrectedCicMetaSolvedMembershipHere :: \* ctx sort tail.
        string ->
        corrected_cic_meta_solved_membership ctx sort
            (corrected_cic_meta_states_solved ctx sort tail)
    | CorrectedCicMetaSolvedMembershipUnderOpen ::
        \* ctx sort head_ctx head_sort tail.
        corrected_cic_meta_solved_membership ctx sort tail * string ->
        corrected_cic_meta_solved_membership ctx sort
            (corrected_cic_meta_states_open head_ctx head_sort tail)
    | CorrectedCicMetaSolvedMembershipUnderSolved ::
        \* ctx sort head_ctx head_sort tail.
        corrected_cic_meta_solved_membership ctx sort tail * string ->
        corrected_cic_meta_solved_membership ctx sort
            (corrected_cic_meta_states_solved head_ctx head_sort tail)

:= ^ lookup_corrected_cic_meta_solution \* ctx sort states.
    (environment : corrected_cic_meta_environment states)
    (membership : corrected_cic_meta_solved_membership ctx sort states)
    : corrected_cic_term ctx sort =
    ?= environment, membership ?|
    | CorrectedCicMetaEnvironmentSolved (solution, _, _),
      CorrectedCicMetaSolvedMembershipHere _ => solution
    | CorrectedCicMetaEnvironmentOpen (tail, _),
      CorrectedCicMetaSolvedMembershipUnderOpen (inner, _) =>
        lookup_corrected_cic_meta_solution tail inner
    | CorrectedCicMetaEnvironmentSolved (_, tail, _),
      CorrectedCicMetaSolvedMembershipUnderSolved (inner, _) =>
        lookup_corrected_cic_meta_solution tail inner

:| corrected_cic_meta_assignment_plan ctx sort states =
    | CorrectedCicMetaAssignmentPlanRigid :: \* ctx sort states.
        corrected_cic_term ctx sort ->
        corrected_cic_meta_assignment_plan ctx sort states
    | CorrectedCicMetaAssignmentPlanSolved :: \* ctx sort states.
        corrected_cic_meta_solved_membership ctx sort states ->
        corrected_cic_meta_assignment_plan ctx sort states
    | CorrectedCicMetaAssignmentPlanSuspendedSolved :: \* ctx sort states.
        corrected_cic_meta_solved_membership ctx sort states * string ->
        corrected_cic_meta_assignment_plan ctx sort states

:= materialize_corrected_cic_meta_assignment_plan \* ctx sort states.
    (environment : corrected_cic_meta_environment states)
    (plan : corrected_cic_meta_assignment_plan ctx sort states)
    : corrected_cic_term ctx sort =
    ?= plan ?|
    | CorrectedCicMetaAssignmentPlanRigid rigid => rigid
    | CorrectedCicMetaAssignmentPlanSolved membership =>
        lookup_corrected_cic_meta_solution environment membership
    | CorrectedCicMetaAssignmentPlanSuspendedSolved (membership, _) =>
        lookup_corrected_cic_meta_solution environment membership

:= ^ assign_corrected_cic_meta_open_slot_with_replacement
    \* ctx sort source target.
    (environment : corrected_cic_meta_environment source)
    (membership : corrected_cic_meta_open_membership ctx sort source target)
    (replacement : corrected_cic_term ctx sort)
    : corrected_cic_meta_environment target =
    ?= environment, membership ?|
    | CorrectedCicMetaEnvironmentOpen (tail, _),
      CorrectedCicMetaOpenMembershipHere _ =>
        CorrectedCicMetaEnvironmentSolved (
            replacement,
            tail,
            "the-selected-open-metavariable-is-solved-exactly-once")
    | CorrectedCicMetaEnvironmentOpen (tail, note),
      CorrectedCicMetaOpenMembershipUnderOpen (inner, _) =>
        CorrectedCicMetaEnvironmentOpen (
            assign_corrected_cic_meta_open_slot_with_replacement
                tail inner replacement,
            note)
    | CorrectedCicMetaEnvironmentSolved (solution, tail, note),
      CorrectedCicMetaOpenMembershipUnderSolved (inner, _) =>
        CorrectedCicMetaEnvironmentSolved (
            solution,
            assign_corrected_cic_meta_open_slot_with_replacement
                tail inner replacement,
            note)

:= ^ corrected_cic_meta_environment_solved_count \* states.
    (environment : corrected_cic_meta_environment states) : i64 =
    ?= environment ?|
    | CorrectedCicMetaEnvironmentEmpty _ => 0i64
    | CorrectedCicMetaEnvironmentOpen (tail, _) =>
        corrected_cic_meta_environment_solved_count tail
    | CorrectedCicMetaEnvironmentSolved (_, tail, _) =>
        cic_runtime_add_i64 1i64 (corrected_cic_meta_environment_solved_count tail)

:= corrected_cic_environment_bound_selected_meta_assign \* ctx sort source target.
    (environment : corrected_cic_meta_environment source)
    (membership : corrected_cic_meta_open_membership ctx sort source target)
    (replacement : corrected_cic_term ctx sort)
    : corrected_cic_meta_environment target =
    ?= corrected_cic_environment_bound_selected_meta_from_environment_membership
            environment membership ?|
    | CorrectedCicEnvironmentBoundSelectedMeta (_, selected) =>
        ?= selected ?|
        | CorrectedCicContextSortIndexedSelectedMeta payload =>
            := \? identity. selected_membership, _, spine, _ = payload
            := _ = solve_corrected_cic_selected_typed_meta_constraints_from_spine spine
            assign_corrected_cic_meta_open_slot_with_replacement
                environment selected_membership replacement

:= assign_corrected_cic_meta_open_slot \* ctx sort source target.
    (environment : corrected_cic_meta_environment source)
    (membership : corrected_cic_meta_open_membership ctx sort source target)
    (plan : corrected_cic_meta_assignment_plan ctx sort source)
    : corrected_cic_meta_environment target =
    assign_corrected_cic_meta_open_slot_with_replacement
        environment
        membership
        (materialize_corrected_cic_meta_assignment_plan environment plan)

:| ^ corrected_cic_meta_assignment_program source target length =
    | CorrectedCicMetaAssignmentProgramDone :: \* states.
        corrected_cic_meta_assignment_program
            states states cic_chain_zero
    | CorrectedCicMetaAssignmentProgramMore ::
        \* source target previous.
        (\? ctx sort middle.
            corrected_cic_meta_open_membership ctx sort source middle *
            corrected_cic_meta_assignment_plan ctx sort source *
            corrected_cic_meta_assignment_program middle target previous *
            string) ->
        corrected_cic_meta_assignment_program
            source target (cic_chain_succ previous)

:= ^ execute_corrected_cic_meta_assignment_program
    \* source target length.
    (environment : corrected_cic_meta_environment source)
    (program : corrected_cic_meta_assignment_program source target length)
    : corrected_cic_meta_environment target =
    ?= program ?|
    | CorrectedCicMetaAssignmentProgramDone => environment
    | CorrectedCicMetaAssignmentProgramMore payload =>
        := \? ctx sort middle.
            membership, plan, tail, _ = payload
        execute_corrected_cic_meta_assignment_program
            (assign_corrected_cic_meta_open_slot
                environment membership plan)
            tail

:= ^ corrected_cic_meta_assignment_program_count
    \* source target length.
    (program : corrected_cic_meta_assignment_program source target length)
    : i64 =
    ?= program ?|
    | CorrectedCicMetaAssignmentProgramDone => 0i64
    | CorrectedCicMetaAssignmentProgramMore payload =>
        := \? ctx sort middle.
            _, _, tail, _ = payload
        cic_runtime_add_i64 1i64
            (corrected_cic_meta_assignment_program_count tail)

:| ^ corrected_cic_meta_authority states =
    | CorrectedCicMetaAuthorityEmpty ::
        corrected_cic_meta_authority corrected_cic_meta_states_empty
    | CorrectedCicMetaAuthorityOpen :: \* ctx sort tail.
        corrected_cic_meta_authority tail * string ->
        corrected_cic_meta_authority
            (corrected_cic_meta_states_open ctx sort tail)

:= ^ materialize_corrected_cic_meta_authority \* states.
    (authority : corrected_cic_meta_authority states)
    : corrected_cic_meta_environment states =
    ?= authority ?|
    | CorrectedCicMetaAuthorityEmpty =>
        CorrectedCicMetaEnvironmentEmpty
            "the-authority-history-materializes-the-empty-environment"
    | CorrectedCicMetaAuthorityOpen (tail_authority, note) =>
        CorrectedCicMetaEnvironmentOpen (
            materialize_corrected_cic_meta_authority tail_authority,
            note)

:= corrected_cic_bound_here () :
    corrected_cic_term (ctx_extend empty_ctx bool_sort) bool_sort =
    CorrectedBoundHere (identity_binder ())

:= corrected_cic_identity () :
    corrected_cic_term empty_ctx (function_sort bool_sort bool_sort) =
    CorrectedLambda (identity_binder (), corrected_cic_bound_here ())

:= corrected_cic_true () : corrected_cic_term empty_ctx bool_sort =
    CorrectedConstant (constant_name (bool_sort "Bool", "True"))

:= corrected_cic_false () : corrected_cic_term empty_ctx bool_sort =
    CorrectedConstant (constant_name (bool_sort "Bool", "False"))

:= corrected_cic_application () : corrected_cic_term empty_ctx bool_sort =
    CorrectedApplication (\? (corrected_cic_identity (), corrected_cic_true ()))

:= corrected_cic_sort_zero () :
    corrected_cic_term empty_ctx (universe_sort universe_one) =
    CorrectedSortZero "predicative-sort-zero-lives-in-sort-one"

:= corrected_cic_generic_binder \* ctx sort.
    (ctx_value : ctx) (sort_value : sort) : binder ctx sort =
    binder (ctx_value, sort_value, "generic-corrected-core-binder")

:= corrected_cic_generic_identity \* ctx sort.
    (ctx_value : ctx) (sort_value : sort) :
    corrected_cic_term ctx (function_sort sort sort) =
    := binder_value = corrected_cic_generic_binder ctx_value sort_value
    CorrectedLambda (
        binder_value,
        CorrectedBoundHere binder_value)

:| corrected_cic_generic_identity_beta_step ctx sort =
    | CorrectedCicGenericIdentityBetaStep :: \* ctx sort.
        ctx * sort * corrected_cic_term ctx sort * string ->
        corrected_cic_generic_identity_beta_step ctx sort

:= corrected_cic_generic_identity_beta_source \* ctx sort.
    (step : corrected_cic_generic_identity_beta_step ctx sort) :
    corrected_cic_term ctx sort =
    ?= step ?|
    | CorrectedCicGenericIdentityBetaStep (
        ctx_value, sort_value, argument, _) =>
        CorrectedApplication (\? (
            corrected_cic_generic_identity ctx_value sort_value,
            argument))

:= corrected_cic_generic_identity_beta_target \* ctx sort.
    (step : corrected_cic_generic_identity_beta_step ctx sort) :
    corrected_cic_term ctx sort =
    ?= step ?|
    | CorrectedCicGenericIdentityBetaStep (_, _, argument, _) => argument

:= corrected_cic_generic_bool_beta_step () :
    corrected_cic_generic_identity_beta_step empty_ctx bool_sort =
    CorrectedCicGenericIdentityBetaStep (
        empty_ctx "empty",
        bool_sort "Bool",
        corrected_cic_true (),
        "the-generic-identity-beta-consumer-is-instantiated-at-Bool")

:= corrected_cic_generic_sort_beta_step () :
    corrected_cic_generic_identity_beta_step
        empty_ctx (universe_sort universe_one) =
    CorrectedCicGenericIdentityBetaStep (
        empty_ctx "empty",
        universe_sort (universe_one "u1"),
        corrected_cic_sort_zero (),
        "the-same-generic-identity-beta-consumer-is-instantiated-at-Sort-zero")

:| corrected_cic_generic_let_step ctx sort =
    | CorrectedCicGenericLetStep :: \* ctx sort.
        ctx * sort * corrected_cic_term ctx sort * string ->
        corrected_cic_generic_let_step ctx sort

:= corrected_cic_generic_let_source \* ctx sort.
    (step : corrected_cic_generic_let_step ctx sort) :
    corrected_cic_term ctx sort =
    ?= step ?|
    | CorrectedCicGenericLetStep (ctx_value, sort_value, value, _) =>
        := binder_value =
            corrected_cic_generic_binder ctx_value sort_value
        CorrectedLet (\? (
            binder_value,
            value,
            CorrectedBoundHere binder_value))

:= corrected_cic_generic_let_target \* ctx sort.
    (step : corrected_cic_generic_let_step ctx sort) :
    corrected_cic_term ctx sort =
    ?= step ?|
    | CorrectedCicGenericLetStep (_, _, value, _) => value

:= corrected_cic_generic_bool_let_step () :
    corrected_cic_generic_let_step empty_ctx bool_sort =
    CorrectedCicGenericLetStep (
        empty_ctx "empty",
        bool_sort "Bool",
        corrected_cic_true (),
        "the-generic-let-consumer-is-instantiated-at-Bool")

:= corrected_cic_generic_sort_let_step () :
    corrected_cic_generic_let_step
        empty_ctx (universe_sort universe_one) =
    CorrectedCicGenericLetStep (
        empty_ctx "empty",
        universe_sort (universe_one "u1"),
        corrected_cic_sort_zero (),
