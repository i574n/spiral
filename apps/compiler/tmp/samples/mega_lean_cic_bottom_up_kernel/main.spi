:= corrected_cic_general_pi_identity_application_runtime () :
    i64 * i64 * i64 * i64 * i64 * i64 * i64 =
    ?= corrected_cic_general_pi_identity_value () ?|
    | corrected_cic_general_pi_identity (type_binder, codomain_body, _) =>
        := certificate =
            corrected_cic_dependent_beta_contractum_make
                type_binder codomain_body (corrected_cic_sort_zero ())
        ?= certificate ?|
        | corrected_cic_dependent_beta_contractum (source, substituted_codomain) =>
            ?= substituted_codomain ?|
            | corrected_cic_dependent_substituted_codomain_index result =>
                ?= result ?|
                | corrected_cic_parametric_substitution_result (_, _, target) =>
                    corrected_cic_term_structural_size source,
                    corrected_cic_term_outer_tag source,
                    corrected_cic_term_bound_here_count source,
                    corrected_cic_term_constant_count source,
                    corrected_cic_term_structural_size target,
                    corrected_cic_term_outer_tag target,
                    corrected_cic_term_bound_here_count target

