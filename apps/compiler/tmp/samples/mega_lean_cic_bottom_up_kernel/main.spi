    (assigned_environment : corrected_cic_meta_environment corrected_cic_oldest_bool_solved_states) : () =
    ?= assigned_environment ?|
    | CorrectedCicMetaEnvironmentOpen (middle_environment, _) =>
        ?= middle_environment ?|
        | CorrectedCicMetaEnvironmentOpen (oldest_environment, _) =>
            ?= oldest_environment ?|
            | CorrectedCicMetaEnvironmentSolved (replacement, tail, _) =>
                ?= replacement, tail ?|
                | CorrectedConstant _, CorrectedCicMetaEnvironmentEmpty _ => ()

