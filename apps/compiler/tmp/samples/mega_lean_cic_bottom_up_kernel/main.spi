:! corrected_cic_dependent_beta_reduction ctx domain =
    binder ctx domain *
    corrected_cic_term
        (ctx_extend ctx domain)
        (universe_sort universe_one) *
    corrected_cic_term ctx domain *
    string

:= corrected_cic_general_pi_identity_beta_reduction () :
    corrected_cic_dependent_beta_reduction
        empty_ctx
        (universe_sort universe_one) =
    ?= corrected_cic_general_pi_identity_value () ?|
    | corrected_cic_general_pi_identity (
        type_binder, codomain_body, _) =>
        corrected_cic_dependent_beta_reduction (
            type_binder,
            codomain_body,
            corrected_cic_sort_zero (),
            "the-general-dependent-identity-lambda-is-applied-to-Sort-zero")

:= corrected_cic_dependent_beta_source \* ctx domain.
    (reduction : corrected_cic_dependent_beta_reduction ctx domain)
    : corrected_cic_term ctx (universe_sort universe_one) =
    ?= reduction ?|
    | corrected_cic_dependent_beta_reduction (
        source_binder, body, argument_term, _) =>
        CorrectedDependentApplication (\? (
            source_binder,
            body,
            argument_term))

:= corrected_cic_dependent_beta_target \* ctx domain.
    (reduction : corrected_cic_dependent_beta_reduction ctx domain)
    : corrected_cic_term ctx (universe_sort universe_one) =
    ?= reduction ?|
    | corrected_cic_dependent_beta_reduction (
        source_binder, body, argument_term, _) =>
        ?= source_binder ?|
        | binder (context_value, domain_value, _) =>
            := substitution :
                cic_corrected_substitution
                    (ctx_extend ctx domain)
                    ctx =
                CicCorrectedSubstitutionDropNewest (
                    context_value,
                    domain_value,
                    argument_term,
                    "dependent-beta-substitutes-the-argument-into-the-lambda-body")
            apply_cic_corrected_substitution
                substitution
                body



:= corrected_cic_whnf_nested_let_beta_source () :
    corrected_cic_term empty_ctx (universe_sort universe_one) =
    ?= corrected_cic_general_pi_identity_value () ?|
    | corrected_cic_general_pi_identity (
        outer_binder, _, _) =>
        ?= outer_binder ?|
        | binder (empty_value, universe_value, _) =>
            := outer_context =
                ctx_extend (empty_value, universe_value)
            := inner_binder :
                binder
                    (ctx_extend empty_ctx (universe_sort universe_one))
                    (universe_sort universe_one) =
                binder (
                    outer_context,
                    universe_value,
                    "WHNF-inner-dependent-Lambda-binder")
            := inner_body :
                corrected_cic_term
                    (ctx_extend
                        (ctx_extend empty_ctx (universe_sort universe_one))
                        (universe_sort universe_one))
                    (universe_sort universe_one) =
                CorrectedBoundHere inner_binder
            := outer_argument :
                corrected_cic_term
                    (ctx_extend empty_ctx (universe_sort universe_one))
                    (universe_sort universe_one) =
                CorrectedBoundHere outer_binder
            := dependent_application :
                corrected_cic_term
                    (ctx_extend empty_ctx (universe_sort universe_one))
                    (universe_sort universe_one) =
                CorrectedDependentApplication (\? (
                    inner_binder,
                    inner_body,
                    outer_argument))
            CorrectedLet (\? (
                outer_binder,
                corrected_cic_sort_zero (),
                dependent_application))

