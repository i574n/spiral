:= corrected_cic_conversion_constraint_solver_runtime
    ()
    : i64 * i64 * i64 * i64 * i64 * i64
    =
    := accepted = corrected_cic_conversion_constraint_program_accepted_with_recursive_inner_application ()
    := rejected = corrected_cic_conversion_constraint_program_rejected ()
    := rejected_scoped_pi = corrected_cic_conversion_constraint_program_rejected_scoped_pi ()
    := rejected_scoped_application = corrected_cic_conversion_constraint_program_rejected_scoped_application ()
    := rejected_scoped_dependent_application =
        corrected_cic_conversion_constraint_program_rejected_scoped_dependent_application ()
    := rejected_substituted_codomain = corrected_cic_conversion_constraint_program_rejected_substituted_codomain ()
    := rejected_scoped_pi_count =
        ?= rejected_scoped_pi ?|
        | CorrectedCicConversionConstraintProgramScopedPi payload =>
            := \? ctx domain. constraint, _, _ = payload
            ?= constraint ?|
            | CorrectedCicScopedPiConstraintObstruction _ =>
                corrected_cic_conversion_constraint_count rejected_scoped_pi
            | CorrectedCicScopedPiConstraintIntrinsic _ =>
                mega_runtime_fail "corrected-cic-rejected-scoped-pi-cannot-be-intrinsic"
    := rejected_scoped_application_count =
        ?= rejected_scoped_application ?|
        | CorrectedCicConversionConstraintProgramScopedApplication payload =>
            := \? ctx domain codomain. constraint, _, _ = payload
            ?= constraint ?|
            | CorrectedCicScopedApplicationConstraintObstruction _ =>
                corrected_cic_conversion_constraint_count rejected_scoped_application
            | CorrectedCicScopedApplicationConstraintIntrinsic _ =>
                mega_runtime_fail "corrected-cic-rejected-scoped-application-cannot-be-intrinsic"
    corrected_cic_conversion_constraint_count accepted,
    (?= rejected ?|
        | CorrectedCicConversionConstraintProgramNonDefeqTerms _ => corrected_cic_conversion_constraint_count rejected),
    rejected_scoped_pi_count,
    rejected_scoped_application_count,
    corrected_cic_conversion_constraint_count rejected_scoped_dependent_application,
    corrected_cic_conversion_constraint_count rejected_substituted_codomain

:= assert_corrected_cic_conversion_constraint_solver_runtime
    (accepted_count : i64)
    (rejected_structural_count : i64)
    (rejected_scoped_pi_count : i64)
    (rejected_scoped_application_count : i64)
    (rejected_scoped_dependent_application_count : i64)
    (rejected_substituted_codomain_count : i64)
    : ()
    =
    := ok_0 = !!!!EQ(accepted_count, 10i64)
    := ok_1 = !!!!EQ(rejected_structural_count, 1i64)
    := ok_2 = !!!!EQ(rejected_scoped_pi_count, 1i64)
    := ok_3 = !!!!EQ(rejected_scoped_application_count, 1i64)
    := ok_4 = !!!!EQ(rejected_scoped_dependent_application_count, 1i64)
    := ok_5 = !!!!EQ(rejected_substituted_codomain_count, 1i64)
    ? ok_0 && ok_1 && ok_2 && ok_3 && ok_4 && ok_5
    ?> ()
    |: mega_runtime_fail "corrected-cic-conversion-constraint-solver-runtime-mismatch"

:= corrected_cic_conversion_constraint_solver_terminal () : string =
    := accepted_count,
        rejected_structural_count,
        rejected_scoped_pi_count,
        rejected_scoped_application_count,
        rejected_scoped_dependent_application_count,
        rejected_substituted_codomain_count =
        corrected_cic_conversion_constraint_solver_runtime ()
    := _ =
        assert_corrected_cic_conversion_constraint_solver_runtime
            accepted_count
            rejected_structural_count
            rejected_scoped_pi_count
            rejected_scoped_application_count
            rejected_scoped_dependent_application_count
            rejected_substituted_codomain_count
    "the-positive-ten-cell-conversion-program-remains-structurally-authorized-and-the-generic-rejected-program-now-"
    ^^ "joins-the-four-specialized-negatives-as-a-typed-structural-cardinality-without-any-aggregate-i64-solver-discri"
    ^^ "minator"

:= corrected_cic_unification_solver_runtime () :
    i64 * i64 * i64 * i64 * i64 * i64 =
    := selected = CorrectedCicTypedMetaZero
    := replacement :
        corrected_cic_selected_typed_meta_term corrected_cic_typed_meta_zero =
        CorrectedCicSelectedTypedMetaRigid "True"
    := cyclic :
        corrected_cic_selected_typed_meta_term corrected_cic_typed_meta_zero =
        CorrectedCicSelectedTypedMetaSuspension (
            CorrectedCicSelectedTypedMetaTarget selected)
    := unrelated_id = CorrectedCicTypedMetaSucc CorrectedCicTypedMetaZero
    := unrelated :
        corrected_cic_selected_typed_meta_term corrected_cic_typed_meta_zero =
        CorrectedCicSelectedTypedMetaOther (\? (
            unrelated_id,
            CorrectedCicTypedMetaZeroNotSucc CorrectedCicTypedMetaZero))
    := accepted = corrected_cic_selected_typed_meta_constraint_program_accepted ()
    solve_corrected_cic_selected_typed_meta_constraints
        replacement accepted,
    corrected_cic_selected_typed_meta_constraint_count accepted,
    corrected_cic_selected_typed_meta_occurs cyclic,
    solve_corrected_cic_selected_typed_meta_constraints
        cyclic accepted,
    corrected_cic_selected_typed_meta_occurs unrelated,
    solve_corrected_cic_selected_typed_meta_constraints
        replacement
        (corrected_cic_selected_typed_meta_constraint_program_unrelated ())

:= assert_corrected_cic_unification_solver_runtime
    (accepted_result : i64)
    (accepted_count : i64)
    (cycle_detected : i64)
    (cyclic_result : i64)
    (unrelated_not_occurs : i64)
    (mixed_target_result : i64)
    : ()
    =
    := ok_0 = !!!!EQ(accepted_result, 1i64)
    := ok_1 = !!!!EQ(accepted_count, 3i64)
    := ok_2 = !!!!EQ(cycle_detected, 1i64)
    := ok_3 = !!!!EQ(cyclic_result, 0i64)
    := ok_4 = !!!!EQ(unrelated_not_occurs, 0i64)
    := ok_5 = !!!!EQ(mixed_target_result, 0i64)
    ? ok_0 && ok_1 && ok_2 && ok_3 && ok_4 && ok_5
    ?> ()
    |: mega_runtime_fail "corrected-cic-unification-solver-runtime-mismatch"

:= corrected_cic_unification_solver_terminal () : string =
    := accepted_result, accepted_count,
        cycle_detected, cyclic_result,
        unrelated_not_occurs, mixed_target_result =
        corrected_cic_unification_solver_runtime ()
    := _ =
        assert_corrected_cic_unification_solver_runtime
            accepted_result accepted_count
            cycle_detected cyclic_result
            unrelated_not_occurs mixed_target_result
    "the-active-CIC-unification-terminal-now-solves-a-recursive-constraint-program-indexed-by-the-selected-metavari"
