:| ^ cic_corrected_one_binder_substitution_program ctx domain sort =
    | CicCorrectedOneBinderSubstitutionBoundHere :: \* ctx domain.
        string ->
        cic_corrected_one_binder_substitution_program ctx domain domain
    | CicCorrectedOneBinderSubstitutionOuter :: \* ctx domain sort.
        corrected_cic_term ctx sort * string ->
        cic_corrected_one_binder_substitution_program ctx domain sort
    | CicCorrectedOneBinderSubstitutionApplication :: \* ctx domain codomain.
        (\? argument_sort.
            cic_corrected_one_binder_substitution_program
                ctx domain (function_sort argument_sort codomain) *
            cic_corrected_one_binder_substitution_program
                ctx domain argument_sort * string) ->
        cic_corrected_one_binder_substitution_program ctx domain codomain

:= ^ cic_corrected_one_binder_substitution_source_body
    \* ctx domain sort.
    (ctx_value : ctx) (domain_value : domain)
    (program : cic_corrected_one_binder_substitution_program ctx domain sort)
    : corrected_cic_term (ctx_extend ctx domain) sort =
    ?= program ?|
    | CicCorrectedOneBinderSubstitutionBoundHere note =>
        CorrectedBoundHere (binder (ctx_value, domain_value, note))
    | CicCorrectedOneBinderSubstitutionOuter (term, note) =>
        CorrectedBoundThere (term, note)
    | CicCorrectedOneBinderSubstitutionApplication payload =>
        := \? argument_sort. function_program, argument_program, _ = payload
        CorrectedApplication (\? (
            cic_corrected_one_binder_substitution_source_body
                ctx_value domain_value function_program,
            cic_corrected_one_binder_substitution_source_body
                ctx_value domain_value argument_program))

:= ^ cic_corrected_one_binder_substitution_target
    \* ctx domain sort.
    (argument : corrected_cic_term ctx domain)
    (program : cic_corrected_one_binder_substitution_program ctx domain sort)
    : corrected_cic_term ctx sort =
    ?= program ?|
    | CicCorrectedOneBinderSubstitutionBoundHere _ => argument
    | CicCorrectedOneBinderSubstitutionOuter (term, _) => term
    | CicCorrectedOneBinderSubstitutionApplication payload =>
        := \? argument_sort. function_program, argument_program, _ = payload
        CorrectedApplication (\? (
            cic_corrected_one_binder_substitution_target
                argument function_program,
            cic_corrected_one_binder_substitution_target
                argument argument_program))

:= ^ cic_corrected_one_binder_substitution_program_nodes
    \* ctx domain sort.
    (program : cic_corrected_one_binder_substitution_program ctx domain sort)
    : i64 =
    ?= program ?|
    | CicCorrectedOneBinderSubstitutionBoundHere _ => 1i64
    | CicCorrectedOneBinderSubstitutionOuter _ => 1i64
    | CicCorrectedOneBinderSubstitutionApplication payload =>
        := \? argument_sort. function_program, argument_program, _ = payload
        cic_runtime_add_i64 1i64
            (cic_runtime_add_i64
                (cic_corrected_one_binder_substitution_program_nodes
                    function_program)
                (cic_corrected_one_binder_substitution_program_nodes
                    argument_program))

:= cic_corrected_one_binder_bool_substitution_program () :
    cic_corrected_one_binder_substitution_program
        empty_ctx bool_sort bool_sort =
    := function_program :
        cic_corrected_one_binder_substitution_program
            empty_ctx bool_sort (function_sort bool_sort bool_sort) =
        CicCorrectedOneBinderSubstitutionOuter (
            corrected_cic_identity (),
            "the-closed-identity-crosses-the-substituted-Bool-binder")
    := argument_program :
        cic_corrected_one_binder_substitution_program
            empty_ctx bool_sort bool_sort =
        CicCorrectedOneBinderSubstitutionBoundHere
            "the-body-selects-the-newest-bound-Bool"
    CicCorrectedOneBinderSubstitutionApplication (\? (
        function_program,
        argument_program,
        "the-recursive-body-applies-the-closed-identity-to-the-bound-Bool"))

:= cic_corrected_one_binder_substitution_runtime () :
    i64 * i64 * i64 * i64 =
    := ctx_value = empty_ctx "one-binder-substitution-empty"
    := domain_value = bool_sort "Bool"
    := argument = corrected_cic_true ()
    := program = cic_corrected_one_binder_bool_substitution_program ()
    := source_body =
        cic_corrected_one_binder_substitution_source_body
            ctx_value domain_value program
    := source = CorrectedApplication (\? (
        CorrectedLambda (
            binder (
                ctx_value,
                domain_value,
                "the-source-lambda-owns-the-recursive-body-program"),
            source_body),
        argument))
    := target =
        cic_corrected_one_binder_substitution_target argument program
    cic_corrected_one_binder_substitution_program_nodes program,
    corrected_cic_term_structural_size source_body,
    corrected_cic_term_structural_size source,
    corrected_cic_term_structural_size target

:= assert_cic_corrected_one_binder_substitution_runtime
    (program_nodes : i64) (source_body_size : i64)
    (source_size : i64) (target_size : i64)
    : ()
    =
    := ok_0 = !!!!EQ(program_nodes, 3i64)
    := ok_1 = !!!!EQ(source_body_size, 5i64)
    := ok_2 = !!!!EQ(source_size, 8i64)
    := ok_3 = !!!!EQ(target_size, 4i64)
    ? ok_0 && ok_1 && ok_2 && ok_3
    ?> ()
    |: mega_runtime_fail "cic-corrected-one-binder-substitution-runtime-mismatch"

:= cic_corrected_one_binder_substitution_terminal () : string =
    := program_nodes, source_body_size, source_size, target_size =
        cic_corrected_one_binder_substitution_runtime ()
    := _ =
        assert_cic_corrected_one_binder_substitution_runtime
            program_nodes source_body_size source_size target_size
    "the-corrected-kernel-now-has-one-total-recursive-BoundHere-Outer-Application-body-program-whose-source-interpr"
    ^^ "eter-weakens-outer-terms-under-a-real-Bool-binder-and-whose-target-interpreter-substitutes-the-closed-argument"
    ^^ "-by-construction-so-one-three-node-body-derives-an-eight-node-beta-source-and-four-node-target-without-a-calle"
    ^^ "r-supplied-contractum-while-dependent-Pi-general-substitution-confluence-and-strong-normalization-remain-open-"
    ^^ "sealed"

:= cic_corrected_function_binder_substitution_runtime () :
    i64 * i64 * i64 * i64 =
    := ctx_value = empty_ctx "function-binder-substitution-empty"
    := domain_value = function_sort (bool_sort "Bool", bool_sort "Bool")
    := argument = corrected_cic_identity ()
    := program :
        cic_corrected_one_binder_substitution_program
            empty_ctx (function_sort bool_sort bool_sort)
            (function_sort bool_sort bool_sort) =
        CicCorrectedOneBinderSubstitutionBoundHere
            "the-function-valued-body-selects-the-newest-bound-function"
    := source_body =
        cic_corrected_one_binder_substitution_source_body
            ctx_value domain_value program
    := source = CorrectedApplication (\? (
        CorrectedLambda (
            binder (
                ctx_value,
                domain_value,
                "the-source-lambda-binds-one-Bool-identity-function"),
            source_body),
        argument))
    := target =
        cic_corrected_one_binder_substitution_target argument program
    cic_corrected_one_binder_substitution_program_nodes program,
    corrected_cic_term_structural_size source_body,
    corrected_cic_term_structural_size source,
    corrected_cic_term_structural_size target

:= assert_cic_corrected_function_binder_substitution_runtime
    (program_nodes : i64) (body_size : i64)
    (source_size : i64) (target_size : i64)
    : ()
    =
    := ok_0 = !!!!EQ(program_nodes, 1i64)
    := ok_1 = !!!!GT(body_size, 0i64)
    := ok_2 = !!!!GT(source_size, target_size)
    := ok_3 = !!!!GT(target_size, 0i64)
    ? ok_0 && ok_1 && ok_2 && ok_3
    ?> ()
    |: mega_runtime_fail "cic-corrected-function-binder-substitution-runtime-mismatch"

:= cic_corrected_function_binder_substitution_terminal () : string =
    := program_nodes, body_size, source_size, target_size =
        cic_corrected_function_binder_substitution_runtime ()
    := _ =
        assert_cic_corrected_function_binder_substitution_runtime
            program_nodes body_size source_size target_size
    "the-total-one-binder-substitution-interpreter-now-also-runs-at-a-function-valued-domain-so-a-bound-Bool-to-Boo"
    ^^ "l-function-body-a-closed-identity-argument-the-beta-source-and-the-contractum-are-derived-from-the-same-BoundH"
    ^^ "ere-program-rather-than-reusing-only-the-Bool-application-fixture-while-dependent-Pi-substitution-under-nested"
    ^^ "-binders-confluence-and-strong-normalization-remain-open-sealed"

:! corrected_cic_bool_true_index = string
:! corrected_cic_bool_false_index = string

:| corrected_cic_bool_index_witness index =
    | CorrectedCicBoolIndexTrue :: string ->
        corrected_cic_bool_index_witness corrected_cic_bool_true_index
    | CorrectedCicBoolIndexFalse :: string ->
        corrected_cic_bool_index_witness corrected_cic_bool_false_index

:| corrected_cic_bool_dependent_result index =
    | CorrectedCicBoolDependentTrueResult ::
        corrected_cic_term empty_ctx (universe_sort universe_one) * string ->
        corrected_cic_bool_dependent_result corrected_cic_bool_true_index
    | CorrectedCicBoolDependentFalseResult ::
        corrected_cic_term empty_ctx bool_sort * string ->
        corrected_cic_bool_dependent_result corrected_cic_bool_false_index

:! corrected_cic_bool_dependent_pi =
    binder empty_ctx bool_sort *
    corrected_cic_term
        (ctx_extend empty_ctx bool_sort)
        (universe_sort universe_one) *
    corrected_cic_term
        (ctx_extend empty_ctx bool_sort)
        bool_sort *
    string

:= corrected_cic_bool_dependent_pi_value () :
    corrected_cic_bool_dependent_pi =
    corrected_cic_bool_dependent_pi (
        identity_binder (),
        CorrectedSortZero
            "the-true-codomain-is-Sort-zero-under-the-Bool-binder",
        CorrectedBoundHere (identity_binder ()),
        "one-finite-dependent-Pi-stores-both-indexed-codomain-bodies-in-the-single-corrected-AST")

:= corrected_cic_bool_index_term \* index.
    (index : corrected_cic_bool_index_witness index)
    : corrected_cic_term empty_ctx bool_sort =
    ?= index ?|
    | CorrectedCicBoolIndexTrue _ =>
        corrected_cic_true ()
    | CorrectedCicBoolIndexFalse _ =>
        CorrectedConstant (
            constant_name (
                bool_sort "Bool",
                "False"))

:= corrected_cic_bool_dependent_pi_apply \* index.
    (pi_value : corrected_cic_bool_dependent_pi)
    (index : corrected_cic_bool_index_witness index)
    : corrected_cic_bool_dependent_result index =
    ?= pi_value ?|
    | corrected_cic_bool_dependent_pi (
        _, true_codomain_body, false_codomain_body, _) =>
        := argument = corrected_cic_bool_index_term index
        := substitution :
            cic_corrected_substitution
                (ctx_extend empty_ctx bool_sort)
                empty_ctx =
            CicCorrectedSubstitutionDropNewest (
                empty_ctx "dependent-Pi-application-empty",
                bool_sort "Bool",
                argument,
                "dependent-Pi-application-substitutes-the-index-term-into-the-selected-codomain")
        ?= index ?|
        | CorrectedCicBoolIndexTrue _ =>
            CorrectedCicBoolDependentTrueResult (
                apply_cic_corrected_substitution
                    substitution true_codomain_body,
                "the-true-index-result-is-calculated-by-substitution-in-the-Pi-codomain")
        | CorrectedCicBoolIndexFalse _ =>
            CorrectedCicBoolDependentFalseResult (
                apply_cic_corrected_substitution
                    substitution false_codomain_body,
                "the-false-index-result-is-calculated-by-substitution-in-the-Pi-codomain")

:= corrected_cic_bool_dependent_apply \* index.
    (index : corrected_cic_bool_index_witness index)
    : corrected_cic_bool_dependent_result index =
    corrected_cic_bool_dependent_pi_apply
        (corrected_cic_bool_dependent_pi_value ())
        index

:| corrected_cic_bool_dependent_application =
    | CorrectedCicBoolDependentApplication ::
        (\? index.
            corrected_cic_bool_index_witness index *
            corrected_cic_bool_dependent_result index * string) ->
        corrected_cic_bool_dependent_application

:= corrected_cic_bool_dependent_application_of_witness \* index.
    (witness : corrected_cic_bool_index_witness index)
    : corrected_cic_bool_dependent_application =
    CorrectedCicBoolDependentApplication (\? (
        witness,
        corrected_cic_bool_dependent_apply witness,
        "the-same-index-witness-derives-the-hidden-dependent-result"))

:| ^ corrected_cic_bool_dependent_application_program =
    | CorrectedCicBoolDependentApplicationProgramDone ::
        corrected_cic_bool_dependent_application_program
    | CorrectedCicBoolDependentApplicationProgramStep ::
        corrected_cic_bool_dependent_application *
        corrected_cic_bool_dependent_application_program * string ->
        corrected_cic_bool_dependent_application_program

:= corrected_cic_bool_dependent_application_runtime
    (application : corrected_cic_bool_dependent_application)
    : i64 * i64 * i64 =
    ?= application ?|
    | CorrectedCicBoolDependentApplication payload =>
        := \? index. _, result, _ = payload
        ?= result ?|
        | CorrectedCicBoolDependentTrueResult (term, _) =>
            1i64, corrected_cic_term_structural_size term, 1i64
        | CorrectedCicBoolDependentFalseResult (term, _) =>
            2i64, corrected_cic_term_structural_size term, 0i64

:= ^ corrected_cic_bool_dependent_application_program_runtime
    (program : corrected_cic_bool_dependent_application_program)
    : i64 * i64 * i64 * i64 =
    ?= program ?|
    | CorrectedCicBoolDependentApplicationProgramDone =>
        0i64, 0i64, 0i64, 0i64
    | CorrectedCicBoolDependentApplicationProgramStep (head, tail, _) =>
        := codomain, size, true_cell =
            corrected_cic_bool_dependent_application_runtime head
        := cells, codomains, sizes, true_cells =
            corrected_cic_bool_dependent_application_program_runtime tail
        cic_runtime_add_i64 1i64 cells,
        cic_runtime_add_i64 codomain codomains,
        cic_runtime_add_i64 size sizes,
        cic_runtime_add_i64 true_cell true_cells

:= assert_corrected_cic_bool_dependent_application_program_runtime
    (cells : i64) (codomains : i64) (sizes : i64) (true_cells : i64)
    : ()
    =
    := ok_0 = !!!!EQ(cells, 3i64)
    := ok_1 = !!!!EQ(codomains, 4i64)
    := ok_2 = !!!!GT(sizes, 0i64)
    := ok_3 = !!!!EQ(true_cells, 2i64)
    ? ok_0 && ok_1 && ok_2 && ok_3
    ?> ()
    |: mega_runtime_fail "corrected-cic-Bool-dependent-application-program-runtime-mismatch"

:= corrected_cic_bool_dependent_application_program_terminal () : string =
    := program =
        CorrectedCicBoolDependentApplicationProgramStep (
            corrected_cic_bool_dependent_application_of_witness (
                CorrectedCicBoolIndexTrue
                    "the-first-cell-carries-the-true-index"),
            CorrectedCicBoolDependentApplicationProgramStep (
                corrected_cic_bool_dependent_application_of_witness (
                    CorrectedCicBoolIndexFalse
                        "the-second-cell-carries-the-false-index"),
                CorrectedCicBoolDependentApplicationProgramStep (
                    corrected_cic_bool_dependent_application_of_witness (
                        CorrectedCicBoolIndexTrue
                            "the-third-cell-restores-the-true-index"),
                    CorrectedCicBoolDependentApplicationProgramDone,
                    "the-third-true-cell-closes-the-heterogeneous-program"),
                "the-false-cell-precedes-the-final-true-cell"),
            "the-first-true-cell-precedes-the-false-cell")
    := cells, codomains, sizes, true_cells =
        corrected_cic_bool_dependent_application_program_runtime program
    := _ =
        assert_corrected_cic_bool_dependent_application_program_runtime
            cells codomains sizes true_cells
    "the-first-finite-dependent-CIC-family-now-materializes-a-recursive-heterogeneous-application-program-where-eac"
    ^^ "h-hidden-cell-carries-one-argument-index-and-the-result-derived-from-that-exact-witness-so-true-false-and-true"
    ^^ "-applications-can-share-a-three-cell-list-without-erasing-their-dependent-result-index-or-permitting-cross-res"
    ^^ "ult-pairing-while-general-Pi-in-the-main-AST-dependent-substitution-confluence-and-strong-normalization-remain"
    ^^ "-open-sealed"

:= ^ corrected_cic_bool_dependent_application_program_append
    (left : corrected_cic_bool_dependent_application_program)
    (right : corrected_cic_bool_dependent_application_program)
    : corrected_cic_bool_dependent_application_program =
    ?= left ?|
    | CorrectedCicBoolDependentApplicationProgramDone => right
    | CorrectedCicBoolDependentApplicationProgramStep (head, tail, note) =>
        CorrectedCicBoolDependentApplicationProgramStep (
            head,
            corrected_cic_bool_dependent_application_program_append tail right,
            note)

:= corrected_cic_bool_dependent_application_program_append_runtime () :
    i64 * i64 * i64 * i64 * i64 * i64 * i64 * i64 =
    := left =
        CorrectedCicBoolDependentApplicationProgramStep (
            corrected_cic_bool_dependent_application_of_witness (
                CorrectedCicBoolIndexTrue "append-left-true"),
            CorrectedCicBoolDependentApplicationProgramStep (
                corrected_cic_bool_dependent_application_of_witness (
                    CorrectedCicBoolIndexFalse "append-left-false"),
                CorrectedCicBoolDependentApplicationProgramDone,
                "append-left-tail"),
            "append-left-head")
    := right =
        CorrectedCicBoolDependentApplicationProgramStep (
            corrected_cic_bool_dependent_application_of_witness (
                CorrectedCicBoolIndexTrue "append-right-true"),
            CorrectedCicBoolDependentApplicationProgramDone,
            "append-right-head")
    := appended = corrected_cic_bool_dependent_application_program_append left right
    := cells, codomains, sizes, true_cells =
        corrected_cic_bool_dependent_application_program_runtime appended
    := left_cells, left_codomains, left_sizes, left_true =
        corrected_cic_bool_dependent_application_program_runtime left
    := right_cells, right_codomains, right_sizes, right_true =
        corrected_cic_bool_dependent_application_program_runtime right
    cells, codomains, sizes, true_cells,
    cic_runtime_add_i64 left_cells right_cells,
    cic_runtime_add_i64 left_codomains right_codomains,
    cic_runtime_add_i64 left_sizes right_sizes,
    cic_runtime_add_i64 left_true right_true

:= assert_corrected_cic_bool_dependent_application_program_append_runtime
    (cells : i64) (codomains : i64) (sizes : i64) (true_cells : i64)
    (expected_cells : i64) (expected_codomains : i64)
    (expected_sizes : i64) (expected_true_cells : i64)
    : ()
    =
    := ok_0 = !!!!EQ(cells, 3i64)
    := ok_1 = !!!!EQ(codomains, 4i64)
    := ok_2 = !!!!GT(sizes, 0i64)
    := ok_3 = !!!!EQ(true_cells, 2i64)
    := ok_4 = !!!!EQ(cells, expected_cells)
    := ok_5 = !!!!EQ(codomains, expected_codomains)
    := ok_6 = !!!!EQ(sizes, expected_sizes)
    := ok_7 = !!!!EQ(true_cells, expected_true_cells)
    ? ok_0 && ok_1 && ok_2 && ok_3 && ok_4 && ok_5 && ok_6 && ok_7
    ?> ()
    |: mega_runtime_fail "corrected-cic-Bool-dependent-application-program-append-runtime-mismatch"

:= corrected_cic_bool_dependent_application_negate
    (application : corrected_cic_bool_dependent_application)
    : corrected_cic_bool_dependent_application =
    ?= application ?|
    | CorrectedCicBoolDependentApplication payload =>
        := \? index. witness, _, _ = payload
        ?= witness ?|
        | CorrectedCicBoolIndexTrue _ =>
            corrected_cic_bool_dependent_application_of_witness (
                CorrectedCicBoolIndexFalse
                    "dependent-index-negation-maps-true-to-false")
        | CorrectedCicBoolIndexFalse _ =>
            corrected_cic_bool_dependent_application_of_witness (
                CorrectedCicBoolIndexTrue
                    "dependent-index-negation-maps-false-to-true")

:= ^ corrected_cic_bool_dependent_application_program_negate
    (program : corrected_cic_bool_dependent_application_program)
    : corrected_cic_bool_dependent_application_program =
    ?= program ?|
    | CorrectedCicBoolDependentApplicationProgramDone =>
        CorrectedCicBoolDependentApplicationProgramDone
    | CorrectedCicBoolDependentApplicationProgramStep (head, tail, note) =>
        CorrectedCicBoolDependentApplicationProgramStep (
            corrected_cic_bool_dependent_application_negate head,
            corrected_cic_bool_dependent_application_program_negate tail,
            note)

:= corrected_cic_bool_dependent_application_program_negation_involution_runtime () :
    i64 * i64 * i64 * i64 * i64 * i64 * i64 * i64 * i64 * i64 * i64 * i64 =
    := original =
        CorrectedCicBoolDependentApplicationProgramStep (
            corrected_cic_bool_dependent_application_of_witness (
                CorrectedCicBoolIndexTrue "negation-source-true-one"),
            CorrectedCicBoolDependentApplicationProgramStep (
                corrected_cic_bool_dependent_application_of_witness (
                    CorrectedCicBoolIndexFalse "negation-source-false"),
                CorrectedCicBoolDependentApplicationProgramStep (
                    corrected_cic_bool_dependent_application_of_witness (
                        CorrectedCicBoolIndexTrue "negation-source-true-two"),
                    CorrectedCicBoolDependentApplicationProgramDone,
                    "negation-source-tail"),
                "negation-source-middle"),
            "negation-source-head")
    := once = corrected_cic_bool_dependent_application_program_negate original
    := twice = corrected_cic_bool_dependent_application_program_negate once
    := oc, od, os, ot =
        corrected_cic_bool_dependent_application_program_runtime original
    := nc, nd, ns, nt =
        corrected_cic_bool_dependent_application_program_runtime once
    := tc, td, ts, tt =
        corrected_cic_bool_dependent_application_program_runtime twice
    oc, od, os, ot, nc, nd, ns, nt, tc, td, ts, tt

:= assert_corrected_cic_bool_dependent_application_program_negation_involution_runtime
    (original_cells : i64) (original_codomains : i64)
    (original_sizes : i64) (original_true : i64)
    (once_cells : i64) (once_codomains : i64)
    (once_sizes : i64) (once_true : i64)
    (twice_cells : i64) (twice_codomains : i64)
    (twice_sizes : i64) (twice_true : i64)
    : ()
    =
    := ok_0 = !!!!EQ(original_cells, 3i64)
    := ok_1 = !!!!EQ(original_codomains, 4i64)
    := ok_2 = !!!!GT(original_sizes, 0i64)
    := ok_3 = !!!!EQ(original_true, 2i64)
    := ok_4 = !!!!EQ(once_cells, 3i64)
    := ok_5 = !!!!EQ(once_codomains, 5i64)
    := ok_6 = !!!!GT(once_sizes, 0i64)
    := ok_7 = !!!!EQ(once_true, 1i64)
    := ok_8 = !!!!EQ(twice_cells, original_cells)
    := ok_9 = !!!!EQ(twice_codomains, original_codomains)
    := ok_10 = !!!!EQ(twice_sizes, original_sizes)
    := ok_11 = !!!!EQ(twice_true, original_true)
    ? ok_0 && ok_1 && ok_2 && ok_3 && ok_4 && ok_5 && ok_6 && ok_7 && ok_8 && ok_9 && ok_10 && ok_11
    ?> ()
    |: mega_runtime_fail "corrected-cic-Bool-dependent-application-program-negation-involution-runtime-mismatch"

:= corrected_cic_bool_dependent_application_program_negation_involution_terminal () : string =
    := original_cells, original_codomains, original_sizes, original_true,
        once_cells, once_codomains, once_sizes, once_true,
        twice_cells, twice_codomains, twice_sizes, twice_true =
        corrected_cic_bool_dependent_application_program_negation_involution_runtime ()
    := _ =
        assert_corrected_cic_bool_dependent_application_program_negation_involution_runtime
            original_cells original_codomains original_sizes original_true
            once_cells once_codomains once_sizes once_true
            twice_cells twice_codomains twice_sizes twice_true
    "the-finite-dependent-CIC-program-now-has-a-total-index-negation-map-that-rebuilds-each-result-from-the-negated"
    ^^ "-witness-so-true-false-true-becomes-false-true-false-and-two-maps-restore-the-original-hidden-codomain-summary"
    ^^ "-without-cross-pairing-results-while-general-Pi-in-the-main-AST-dependent-substitution-confluence-and-strong-n"
    ^^ "ormalization-remain-open-sealed"

:= ^ corrected_cic_term_bound_here_count \* ctx sort.
    (term : corrected_cic_term ctx sort) : i64 =
    ?= term ?|
    | CorrectedSortZero _ => 0i64
    | CorrectedBoundHere _ => 1i64
    | CorrectedBoundThere (outer, _) =>
        corrected_cic_term_bound_here_count outer
    | CorrectedConstant _ => 0i64
    | CorrectedDefinition (body, _) =>
        corrected_cic_term_bound_here_count body
    | CorrectedLambda (_, body) =>
        corrected_cic_term_bound_here_count body
    | CorrectedPi payload =>
        := \? domain. _, codomain_body = payload
        corrected_cic_term_bound_here_count codomain_body
    | CorrectedDependentLambda payload =>
        := \? domain. _, body = payload
        corrected_cic_term_bound_here_count body
    | CorrectedDependentApplication payload =>
        := \? domain. _, body, argument_term = payload
        cic_runtime_add_i64
            (corrected_cic_term_bound_here_count body)
            (corrected_cic_term_bound_here_count argument_term)
    | CorrectedApplication payload =>
        := \? domain. function_term, argument_term = payload
        cic_runtime_add_i64
            (corrected_cic_term_bound_here_count function_term)
            (corrected_cic_term_bound_here_count argument_term)
    | CorrectedLet payload =>
        := \? domain. _, value, body = payload
        cic_runtime_add_i64
            (corrected_cic_term_bound_here_count value)
            (corrected_cic_term_bound_here_count body)

:= ^ corrected_cic_term_constant_count \* ctx sort.
    (term : corrected_cic_term ctx sort) : i64 =
    ?= term ?|
    | CorrectedSortZero _ => 0i64
    | CorrectedBoundHere _ => 0i64
    | CorrectedBoundThere (outer, _) =>
        corrected_cic_term_constant_count outer
    | CorrectedConstant _ => 1i64
    | CorrectedDefinition (body, _) =>
        corrected_cic_term_constant_count body
    | CorrectedLambda (_, body) =>
        corrected_cic_term_constant_count body
    | CorrectedPi payload =>
        := \? domain. _, codomain_body = payload
        corrected_cic_term_constant_count codomain_body
    | CorrectedDependentLambda payload =>
        := \? domain. _, body = payload
        corrected_cic_term_constant_count body
    | CorrectedDependentApplication payload =>
        := \? domain. _, body, argument_term = payload
        cic_runtime_add_i64
            (corrected_cic_term_constant_count body)
            (corrected_cic_term_constant_count argument_term)
    | CorrectedApplication payload =>
        := \? domain. function_term, argument_term = payload
        cic_runtime_add_i64
            (corrected_cic_term_constant_count function_term)
            (corrected_cic_term_constant_count argument_term)
    | CorrectedLet payload =>
        := \? domain. _, value, body = payload
        cic_runtime_add_i64
            (corrected_cic_term_constant_count value)
            (corrected_cic_term_constant_count body)

:= ^ corrected_cic_term_application_count \* ctx sort.
    (term : corrected_cic_term ctx sort) : i64 =
    ?= term ?|
    | CorrectedSortZero _ => 0i64
    | CorrectedBoundHere _ => 0i64
    | CorrectedBoundThere (outer, _) =>
        corrected_cic_term_application_count outer
    | CorrectedConstant _ => 0i64
    | CorrectedDefinition (body, _) =>
        corrected_cic_term_application_count body
    | CorrectedLambda (_, body) =>
        corrected_cic_term_application_count body
    | CorrectedPi payload =>
        := \? domain. _, codomain_body = payload
        corrected_cic_term_application_count codomain_body
    | CorrectedDependentLambda payload =>
        := \? domain. _, body = payload
        corrected_cic_term_application_count body
    | CorrectedDependentApplication payload =>
        := \? domain. _, body, argument_term = payload
        cic_runtime_add_i64 1i64
            (cic_runtime_add_i64
                (corrected_cic_term_application_count body)
                (corrected_cic_term_application_count argument_term))
    | CorrectedApplication payload =>
        := \? domain. function_term, argument_term = payload
        cic_runtime_add_i64 1i64
            (cic_runtime_add_i64
                (corrected_cic_term_application_count function_term)
                (corrected_cic_term_application_count argument_term))
    | CorrectedLet payload =>
        := \? domain. _, value, body = payload
        cic_runtime_add_i64
            (corrected_cic_term_application_count value)
            (corrected_cic_term_application_count body)

:= cic_corrected_total_substitution_nested_lambda_let_source () :
    corrected_cic_term
        (ctx_extend empty_ctx bool_sort)
        (function_sort bool_sort bool_sort) =
    := empty_value = empty_ctx "total-substitution-empty"
    := bool_value = bool_sort "Bool"
    := outer_binder : binder empty_ctx bool_sort =
        binder (
            empty_value,
            bool_value,
            "the-outer-Bool-binder-will-be-substituted")
    := lambda_context_value =
        ctx_extend (empty_value, bool_value)
    := lambda_binder :
        binder (ctx_extend empty_ctx bool_sort) bool_sort =
        binder (
            lambda_context_value,
            bool_value,
            "the-inner-lambda-binder-is-preserved")
    := lambda_body_context_value =
        ctx_extend (lambda_context_value, bool_value)
    := let_binder :
        binder
            (ctx_extend (ctx_extend empty_ctx bool_sort) bool_sort)
            bool_sort =
        binder (
            lambda_body_context_value,
            bool_value,
            "the-inner-let-binder-is-preserved")
    := identity_under_outer_and_lambda :
        corrected_cic_term
            (ctx_extend (ctx_extend empty_ctx bool_sort) bool_sort)
            (function_sort bool_sort bool_sort) =
        weaken_corrected_cic_term_twice (corrected_cic_identity ())
    := outer_under_lambda :
        corrected_cic_term
            (ctx_extend (ctx_extend empty_ctx bool_sort) bool_sort)
            bool_sort =
        CorrectedBoundThere (
            CorrectedBoundHere outer_binder,
            "the-substituted-variable-crosses-the-lambda-binder")
    := application_under_lambda :
        corrected_cic_term
            (ctx_extend (ctx_extend empty_ctx bool_sort) bool_sort)
            bool_sort =
        CorrectedApplication (\? (
            identity_under_outer_and_lambda,
            outer_under_lambda))
    := outer_under_lambda_and_let :
        corrected_cic_term
            (ctx_extend
                (ctx_extend (ctx_extend empty_ctx bool_sort) bool_sort)
                bool_sort)
            bool_sort =
        CorrectedBoundThere (
            CorrectedBoundThere (
                CorrectedBoundHere outer_binder,
                "the-substituted-variable-crosses-the-lambda-binder-in-the-let-body"),
            "the-substituted-variable-also-crosses-the-let-binder")
    CorrectedLambda (
        lambda_binder,
        CorrectedLet (\? (
            let_binder,
            application_under_lambda,
            outer_under_lambda_and_let)))

:= cic_corrected_total_substitution_nested_lambda_let_runtime () :
    i64 * i64 * i64 * i64 * i64 * i64 =
    := source =
        cic_corrected_total_substitution_nested_lambda_let_source ()
    := substitution :
        cic_corrected_substitution
            (ctx_extend empty_ctx bool_sort)
            empty_ctx =
        CicCorrectedSubstitutionDropNewest (
            empty_ctx "total-substitution-empty",
            bool_sort "Bool",
            corrected_cic_true (),
            "the-outer-Bool-binder-is-eliminated-by-the-closed-True-argument")
    := target =
        apply_cic_corrected_substitution substitution source
    corrected_cic_term_structural_size source,
    corrected_cic_term_structural_size target,
    corrected_cic_term_outer_tag target,
    corrected_cic_term_bound_here_count source,
    corrected_cic_term_bound_here_count target,
    corrected_cic_term_constant_count target

:= assert_cic_corrected_total_substitution_nested_lambda_let_runtime
    (source_size : i64) (target_size : i64) (target_tag : i64)
    (source_bound_here : i64) (target_bound_here : i64)
    (target_constants : i64)
    : ()
    =
    := ok_0 = !!!!EQ(source_size, 12i64)
    := ok_1 = !!!!EQ(target_size, 11i64)
    := ok_2 = !!!!EQ(target_tag, 3i64)
    := ok_3 = !!!!EQ(source_bound_here, 3i64)
    := ok_4 = !!!!EQ(target_bound_here, 1i64)
    := ok_5 = !!!!EQ(target_constants, 2i64)
    ? ok_0 && ok_1 && ok_2 && ok_3 && ok_4 && ok_5
    ?> ()
    |: mega_runtime_fail "cic-corrected-total-substitution-nested-lambda-let-runtime-mismatch"

:= cic_corrected_total_substitution_nested_lambda_let_terminal () : string =
    := source_size, target_size, target_tag,
        source_bound_here, target_bound_here, target_constants =
        cic_corrected_total_substitution_nested_lambda_let_runtime ()
    := _ =
        assert_cic_corrected_total_substitution_nested_lambda_let_runtime
            source_size target_size target_tag
            source_bound_here target_bound_here target_constants
    "one-structural-substitution-now-eliminates-the-newest-binder-and-lifts-itself-under-Lambda-and-Let-so-the-same"
    ^^ "-outer-variable-is-replaced-at-depths-one-and-two-while-the-inner-binders-remain-scoped-without-caller-supplie"
    ^^ "d-targets-sealed"

:! corrected_cic_general_pi_identity =
    binder empty_ctx (universe_sort universe_one) *
    corrected_cic_term
        (ctx_extend empty_ctx (universe_sort universe_one))
        (universe_sort universe_one) *
    string

:= corrected_cic_general_pi_identity_value () :
    corrected_cic_general_pi_identity =
    := empty_value = empty_ctx "general-Pi-empty"
    := universe_value = universe_sort (universe_one "u1")
    := type_binder :
        binder empty_ctx (universe_sort universe_one) =
        binder (
            empty_value,
            universe_value,
            "the-general-Pi-binds-one-type-in-Sort-one")
    corrected_cic_general_pi_identity (
        type_binder,
        CorrectedBoundHere type_binder,
        "the-general-Pi-codomain-is-the-bound-type-itself")

:= corrected_cic_general_pi_identity_term () :
    corrected_cic_term empty_ctx (universe_sort universe_one) =
    ?= corrected_cic_general_pi_identity_value () ?|
    | corrected_cic_general_pi_identity (
        type_binder, codomain_body, _) =>
        CorrectedPi (\? (
            type_binder,
            codomain_body))

:= corrected_cic_general_pi_identity_specialization () :
    corrected_cic_term empty_ctx (universe_sort universe_one) =
    ?= corrected_cic_general_pi_identity_value () ?|
    | corrected_cic_general_pi_identity (
        _, codomain_body, _) =>
        := substitution :
            cic_corrected_substitution
                (ctx_extend empty_ctx (universe_sort universe_one))
                empty_ctx =
            CicCorrectedSubstitutionDropNewest (
                empty_ctx "general-Pi-specialization-empty",
                universe_sort (universe_one "u1"),
                corrected_cic_sort_zero (),
                "general-Pi-specialization-substitutes-Sort-zero-for-the-bound-type")
        apply_cic_corrected_substitution
            substitution
            codomain_body

:! corrected_cic_parametric_substitution_result source target sort =
    cic_corrected_substitution source target *
    corrected_cic_term source sort *
    corrected_cic_term target sort

:= corrected_cic_parametric_substitution_result_make \* source target sort.
    (substitution : cic_corrected_substitution source target)
    (body : corrected_cic_term source sort) :
    corrected_cic_parametric_substitution_result source target sort =
    corrected_cic_parametric_substitution_result (
        substitution, body, apply_cic_corrected_substitution substitution body)

:! corrected_cic_dependent_substituted_codomain_index ctx domain codomain =
    corrected_cic_parametric_substitution_result (ctx_extend ctx domain) ctx codomain

:! corrected_cic_dependent_beta_contractum ctx domain codomain =
    corrected_cic_term ctx codomain *
    corrected_cic_dependent_substituted_codomain_index ctx domain codomain

:= corrected_cic_dependent_beta_contractum_make \* ctx domain codomain.
    (source_binder : binder ctx domain)
    (body : corrected_cic_term (ctx_extend ctx domain) codomain)
    (argument : corrected_cic_term ctx domain) :
    corrected_cic_dependent_beta_contractum ctx domain codomain =
    := source : corrected_cic_term ctx codomain =
        CorrectedDependentApplication (\? (source_binder, body, argument))
    ?= source_binder ?|
    | binder (context_value, domain_value, _) =>
        := substitution :
            cic_corrected_substitution (ctx_extend ctx domain) ctx =
            CicCorrectedSubstitutionDropNewest (
                context_value,
                domain_value,
                argument,
                "the-dependent-beta-contractum-certificate-derives-B[a/x]-by-the-total-structural-substitution")
        := substituted_codomain =
            corrected_cic_dependent_substituted_codomain_index (
                corrected_cic_parametric_substitution_result_make substitution body)
        corrected_cic_dependent_beta_contractum (
            source,
            substituted_codomain)

:! corrected_cic_closed_type_code_sort_zero = string
:! corrected_cic_closed_type_code_bool = string
:! corrected_cic_identity_codomain_code = string
:! corrected_cic_unary_constructor_codomain_code = string
:! corrected_cic_substituted_codomain codomain argument = codomain * argument

:| corrected_cic_closed_type_code code =
    | CorrectedCicClosedTypeCodeSortZero :: string ->
        corrected_cic_closed_type_code
            corrected_cic_closed_type_code_sort_zero
    | CorrectedCicClosedTypeCodeBool :: string ->
        corrected_cic_closed_type_code
            corrected_cic_closed_type_code_bool

:= corrected_cic_closed_type_code_term \* code.
    (code : corrected_cic_closed_type_code code)
    : corrected_cic_term empty_ctx (universe_sort universe_one) =
    ?= code ?|
    | CorrectedCicClosedTypeCodeSortZero _ =>
        corrected_cic_sort_zero ()
    | CorrectedCicClosedTypeCodeBool _ =>
        CorrectedConstant (
            constant_name (
                universe_sort (universe_one "u1"),
                "Bool"))

:! corrected_cic_recursive_codomain_identity = string
:! corrected_cic_recursive_codomain_unary child = child

:| ^ corrected_cic_recursive_codomain_program code =
    | CorrectedCicRecursiveCodomainIdentity :: string ->
        corrected_cic_recursive_codomain_program
            corrected_cic_recursive_codomain_identity
    | CorrectedCicRecursiveCodomainUnary :: \* child.
        corrected_cic_recursive_codomain_program child * string ->
        corrected_cic_recursive_codomain_program
            (corrected_cic_recursive_codomain_unary child)

:= corrected_cic_recursive_codomain_binder () :
    binder empty_ctx (universe_sort universe_one) =
    binder (
        empty_ctx "recursive-codomain-program-empty-context",
        universe_sort (universe_one "u1"),
        "the-recursive-codomain-program-binds-one-type")

:= ^ corrected_cic_recursive_codomain_program_body \* code.
    (program : corrected_cic_recursive_codomain_program code)
    : corrected_cic_term
        (ctx_extend empty_ctx (universe_sort universe_one))
        (universe_sort universe_one) =
    ?= program ?|
    | CorrectedCicRecursiveCodomainIdentity _ =>
        CorrectedBoundHere (corrected_cic_recursive_codomain_binder ())
    | CorrectedCicRecursiveCodomainUnary (child, _) =>
        := universe_value = universe_sort (universe_one "u1")
        := type_constructor :
            corrected_cic_term
                (ctx_extend empty_ctx (universe_sort universe_one))
                (function_sort
                    (universe_sort universe_one)
                    (universe_sort universe_one)) =
            CorrectedConstant (
                constant_name (
                    function_sort (universe_value, universe_value),
                    "F"))
        CorrectedApplication (\? (
            type_constructor,
            corrected_cic_recursive_codomain_program_body child))

:= ^ corrected_cic_recursive_codomain_program_substitute \* code argument.
    (program : corrected_cic_recursive_codomain_program code)
    (argument_code : corrected_cic_closed_type_code argument)
    : corrected_cic_term empty_ctx (universe_sort universe_one) =
    ?= program ?|
    | CorrectedCicRecursiveCodomainIdentity _ =>
        corrected_cic_closed_type_code_term argument_code
    | CorrectedCicRecursiveCodomainUnary (child, _) =>
        := universe_value = universe_sort (universe_one "u1")
        := type_constructor :
            corrected_cic_term
                empty_ctx
                (function_sort
                    (universe_sort universe_one)
                    (universe_sort universe_one)) =
            CorrectedConstant (
                constant_name (
                    function_sort (universe_value, universe_value),
                    "F"))
        CorrectedApplication (\? (
            type_constructor,
            corrected_cic_recursive_codomain_program_substitute
                child argument_code))

:| corrected_cic_recursive_codomain_application result =
    | CorrectedCicRecursiveCodomainApplication :: \* codomain argument.
        corrected_cic_recursive_codomain_program codomain *
        corrected_cic_closed_type_code argument * string ->
        corrected_cic_recursive_codomain_application
            (corrected_cic_substituted_codomain codomain argument)

:= corrected_cic_recursive_codomain_application_source \* result.
    (application : corrected_cic_recursive_codomain_application result)
    : corrected_cic_term empty_ctx (universe_sort universe_one) =
    ?= application ?|
    | CorrectedCicRecursiveCodomainApplication (
        program, argument_code, _) =>
        CorrectedDependentApplication (\? (
            corrected_cic_recursive_codomain_binder (),
            corrected_cic_recursive_codomain_program_body program,
            corrected_cic_closed_type_code_term argument_code))

:= corrected_cic_recursive_codomain_application_target \* result.
    (application : corrected_cic_recursive_codomain_application result)
    : corrected_cic_term empty_ctx (universe_sort universe_one) =
    ?= application ?|
    | CorrectedCicRecursiveCodomainApplication (
        program, argument_code, _) =>
        corrected_cic_recursive_codomain_program_substitute program argument_code

:= corrected_cic_recursive_single_unary_codomain_program () :
    corrected_cic_recursive_codomain_program
        (corrected_cic_recursive_codomain_unary
            corrected_cic_recursive_codomain_identity) =
    CorrectedCicRecursiveCodomainUnary (
        CorrectedCicRecursiveCodomainIdentity
            "the-recursive-codomain-base-is-the-bound-type",
        "the-single-unary-constructor-wraps-the-bound-type")

:= corrected_cic_recursive_double_unary_codomain_program () :
    corrected_cic_recursive_codomain_program
        (corrected_cic_recursive_codomain_unary
            (corrected_cic_recursive_codomain_unary
                corrected_cic_recursive_codomain_identity)) =
    CorrectedCicRecursiveCodomainUnary (
        CorrectedCicRecursiveCodomainUnary (
            CorrectedCicRecursiveCodomainIdentity
                "the-recursive-codomain-base-is-the-bound-type",
            "the-inner-unary-constructor-wraps-the-bound-type"),
        "the-outer-unary-constructor-wraps-the-inner-codomain")

:! corrected_cic_recursive_double_unary_argument_family =
    corrected_cic_recursive_codomain_application
        (corrected_cic_substituted_codomain
            (corrected_cic_recursive_codomain_unary
                (corrected_cic_recursive_codomain_unary corrected_cic_recursive_codomain_identity))
            corrected_cic_closed_type_code_sort_zero) *
    corrected_cic_recursive_codomain_application
        (corrected_cic_substituted_codomain
            (corrected_cic_recursive_codomain_unary
                (corrected_cic_recursive_codomain_unary corrected_cic_recursive_codomain_identity))
            corrected_cic_closed_type_code_bool)

:= corrected_cic_recursive_double_unary_argument_family_make () :
    corrected_cic_recursive_double_unary_argument_family =
    := program = corrected_cic_recursive_double_unary_codomain_program ()
    corrected_cic_recursive_double_unary_argument_family (
        CorrectedCicRecursiveCodomainApplication (
            program,
            CorrectedCicClosedTypeCodeSortZero
                "Sort-zero-is-the-shared-recursive-codomain-family-argument",
            "one-shared-recursive-codomain-program-is-instantiated-at-Sort-zero"),
        CorrectedCicRecursiveCodomainApplication (
            program,
            CorrectedCicClosedTypeCodeBool
                "Bool-is-the-shared-recursive-codomain-family-argument",
            "the-same-shared-recursive-codomain-program-is-instantiated-at-Bool"))

:= corrected_cic_recursive_codomain_application_runtime () :
    i64 * i64 * i64 * i64 * i64 * i64 * i64 * i64 =
    ?= corrected_cic_recursive_double_unary_argument_family_make () ?|
    | corrected_cic_recursive_double_unary_argument_family (sort_application, bool_application) =>
        := sort_source = corrected_cic_recursive_codomain_application_source sort_application
        := bool_source = corrected_cic_recursive_codomain_application_source bool_application
        := sort_target = corrected_cic_recursive_codomain_application_target sort_application
        := bool_target = corrected_cic_recursive_codomain_application_target bool_application
        corrected_cic_term_outer_tag sort_source,
        corrected_cic_term_outer_tag bool_source,
        corrected_cic_term_structural_size sort_source,
        corrected_cic_term_structural_size bool_source,
        corrected_cic_term_structural_size sort_target,
        corrected_cic_term_constant_count sort_target,
        corrected_cic_term_structural_size bool_target,
        corrected_cic_term_constant_count bool_target

:= assert_corrected_cic_recursive_codomain_application_runtime
    (sort_source_tag : i64) (bool_source_tag : i64)
    (sort_source_size : i64) (bool_source_size : i64)
    (sort_target_size : i64) (sort_target_constants : i64)
    (bool_target_size : i64) (bool_target_constants : i64)
    : ()
    =
    := ok_0 = !!!!EQ(sort_source_tag, 8i64)
    := ok_1 = !!!!EQ(bool_source_tag, 8i64)
    := ok_2 = !!!!EQ(sort_source_size, bool_source_size)
    := ok_3 = !!!!EQ(sort_target_size, 5i64)
    := ok_4 = !!!!EQ(sort_target_constants, 2i64)
    := ok_5 = !!!!EQ(bool_target_size, 5i64)
    := ok_6 = !!!!EQ(bool_target_constants, 3i64)
    ? ok_0 && ok_1 && ok_2 && ok_3 && ok_4 && ok_5 && ok_6
    ?> ()
    |: mega_runtime_fail "corrected-cic-recursive-codomain-application-runtime-mismatch"

:= corrected_cic_recursive_codomain_application_terminal () : string =
    := _ = corrected_cic_recursive_single_unary_codomain_program ()
    := _ = corrected_cic_recursive_double_unary_codomain_program ()
    := sort_source_tag, bool_source_tag, sort_source_size, bool_source_size,
        sort_target_size, sort_target_constants, bool_target_size, bool_target_constants =
        corrected_cic_recursive_codomain_application_runtime ()
    assert_corrected_cic_recursive_codomain_application_runtime
        sort_source_tag bool_source_tag sort_source_size bool_source_size
        sort_target_size sort_target_constants bool_target_size bool_target_constants
    "one-shared-recursive-B-of-x-equals-F-of-F-of-x-program-now-proves-Sort-zero-and-Bool-instances-have-the-same-d"
    ^^ "ependent-application-source-shape-and-target-shape-while-their-derived-constant-counts-remain-argument-depende"
    ^^ "nt"

:| corrected_cic_indexed_dependent_application result =
    | CorrectedCicIndexedIdentityApplication :: \* argument.
        corrected_cic_closed_type_code argument * string ->
        corrected_cic_indexed_dependent_application
            (corrected_cic_substituted_codomain
                corrected_cic_identity_codomain_code
                argument)
    | CorrectedCicIndexedUnaryConstructorApplication :: \* argument.
        corrected_cic_closed_type_code argument * string ->
        corrected_cic_indexed_dependent_application
            (corrected_cic_substituted_codomain
                corrected_cic_unary_constructor_codomain_code
                argument)

:| corrected_cic_instantiated_codomain result =
    | CorrectedCicInstantiatedIdentityCodomain :: \* argument.
        corrected_cic_closed_type_code argument * string ->
        corrected_cic_instantiated_codomain
            (corrected_cic_substituted_codomain
                corrected_cic_identity_codomain_code
                argument)
    | CorrectedCicInstantiatedUnaryConstructorCodomain :: \* argument.
        corrected_cic_closed_type_code argument * string ->
        corrected_cic_instantiated_codomain
            (corrected_cic_substituted_codomain
                corrected_cic_unary_constructor_codomain_code
                argument)

:= corrected_cic_indexed_dependent_application_source \* result.
    (application : corrected_cic_indexed_dependent_application result)
    : corrected_cic_term empty_ctx (universe_sort universe_one) =
    ?= application ?|
    | CorrectedCicIndexedIdentityApplication (argument_code, _) =>
        ?= corrected_cic_general_pi_identity_value () ?|
        | corrected_cic_general_pi_identity (
            type_binder, codomain_body, _) =>
            CorrectedDependentApplication (\? (
                type_binder,
                codomain_body,
                corrected_cic_closed_type_code_term argument_code))
    | CorrectedCicIndexedUnaryConstructorApplication (argument_code, _) =>
        := empty_value = empty_ctx "indexed-constructor-codomain-empty"
        := universe_value = universe_sort (universe_one "u1")
        := type_binder :
            binder empty_ctx (universe_sort universe_one) =
            binder (
                empty_value,
                universe_value,
                "the-unary-constructor-codomain-binds-one-type")
        := type_constructor :
            corrected_cic_term
                (ctx_extend empty_ctx (universe_sort universe_one))
                (function_sort
                    (universe_sort universe_one)
                    (universe_sort universe_one)) =
            CorrectedConstant (
                constant_name (
                    function_sort (universe_value, universe_value),
                    "F"))
        := codomain_body :
            corrected_cic_term
                (ctx_extend empty_ctx (universe_sort universe_one))
                (universe_sort universe_one) =
            CorrectedApplication (\? (
                type_constructor,
                CorrectedBoundHere type_binder))
        CorrectedDependentApplication (\? (
            type_binder,
            codomain_body,
            corrected_cic_closed_type_code_term argument_code))

:= corrected_cic_indexed_dependent_application_target \* result.
    (application : corrected_cic_indexed_dependent_application result)
    : corrected_cic_instantiated_codomain result =
    ?= application ?|
    | CorrectedCicIndexedIdentityApplication (argument_code, _) =>
        CorrectedCicInstantiatedIdentityCodomain (
            argument_code,
            "the-result-index-is-the-codomain-body-with-the-exact-argument-code-substituted")
    | CorrectedCicIndexedUnaryConstructorApplication (argument_code, _) =>
        CorrectedCicInstantiatedUnaryConstructorCodomain (
            argument_code,
            "the-unary-constructor-codomain-keeps-the-exact-argument-code-in-F-of-a")

:= corrected_cic_instantiated_codomain_term \* result.
    (result : corrected_cic_instantiated_codomain result)
    : corrected_cic_term empty_ctx (universe_sort universe_one) =
    ?= result ?|
    | CorrectedCicInstantiatedIdentityCodomain (argument_code, _) =>
        corrected_cic_closed_type_code_term argument_code
    | CorrectedCicInstantiatedUnaryConstructorCodomain (argument_code, _) =>
        := universe_value = universe_sort (universe_one "u1")
        := type_constructor :
            corrected_cic_term
                empty_ctx
                (function_sort
                    (universe_sort universe_one)
                    (universe_sort universe_one)) =
            CorrectedConstant (
                constant_name (
                    function_sort (universe_value, universe_value),
                    "F"))
        CorrectedApplication (\? (
            type_constructor,
            corrected_cic_closed_type_code_term argument_code))

:= corrected_cic_indexed_dependent_application_target_term \* result.
    (application : corrected_cic_indexed_dependent_application result)
    : corrected_cic_term empty_ctx (universe_sort universe_one) =
    corrected_cic_instantiated_codomain_term
        (corrected_cic_indexed_dependent_application_target application)

:| corrected_cic_codomain_program code =
    | CorrectedCicCodomainProgramIdentity :: string ->
        corrected_cic_codomain_program corrected_cic_identity_codomain_code
    | CorrectedCicCodomainProgramUnaryConstructor :: string ->
        corrected_cic_codomain_program corrected_cic_unary_constructor_codomain_code

:| corrected_cic_programmed_dependent_application result =
    | CorrectedCicProgrammedDependentApplication :: \* codomain argument.
        corrected_cic_codomain_program codomain *
        corrected_cic_closed_type_code argument * string ->
        corrected_cic_programmed_dependent_application
            (corrected_cic_substituted_codomain codomain argument)

:= corrected_cic_programmed_dependent_application_source \* result.
    (application : corrected_cic_programmed_dependent_application result)
    : corrected_cic_term empty_ctx (universe_sort universe_one) =
    ?= application ?|
    | CorrectedCicProgrammedDependentApplication (
        codomain_program, argument_code, note) =>
        ?= codomain_program ?|
        | CorrectedCicCodomainProgramIdentity _ =>
            corrected_cic_indexed_dependent_application_source
                (CorrectedCicIndexedIdentityApplication (
                    argument_code, note))
        | CorrectedCicCodomainProgramUnaryConstructor _ =>
            corrected_cic_indexed_dependent_application_source
                (CorrectedCicIndexedUnaryConstructorApplication (
                    argument_code, note))

:= corrected_cic_programmed_dependent_application_result \* result.
    (application : corrected_cic_programmed_dependent_application result)
    : corrected_cic_instantiated_codomain result =
    ?= application ?|
    | CorrectedCicProgrammedDependentApplication (
        codomain_program, argument_code, note) =>
        ?= codomain_program ?|
        | CorrectedCicCodomainProgramIdentity _ =>
            corrected_cic_indexed_dependent_application_target
                (CorrectedCicIndexedIdentityApplication (
                    argument_code, note))
        | CorrectedCicCodomainProgramUnaryConstructor _ =>
            corrected_cic_indexed_dependent_application_target
                (CorrectedCicIndexedUnaryConstructorApplication (
                    argument_code, note))

:= corrected_cic_programmed_dependent_application_target \* result.
    (application : corrected_cic_programmed_dependent_application result)
    : corrected_cic_term empty_ctx (universe_sort universe_one) =
    corrected_cic_instantiated_codomain_term
        (corrected_cic_programmed_dependent_application_result application)

