nominal corrected_cic_dependent_beta_reduction ctx domain =
    binder ctx domain *
    corrected_cic_term
        (ctx_extend ctx domain)
        (universe_sort universe_one) *
    corrected_cic_term ctx domain *
    string

inl corrected_cic_general_pi_identity_beta_reduction () :
