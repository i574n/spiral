:== cic_corrected_two_cell_swap_source_context =
    ctx_extend (ctx_extend empty_ctx bool_sort) identity_sort

:== cic_corrected_two_cell_swap_target_context =
    ctx_extend (ctx_extend empty_ctx identity_sort) bool_sort

:| cic_corrected_two_cell_swap_member sort =
    | CicCorrectedTwoCellSwapNewestIdentity ::
        string -> cic_corrected_two_cell_swap_member identity_sort
    | CicCorrectedTwoCellSwapOlderBool ::
        string -> cic_corrected_two_cell_swap_member bool_sort

:= cic_corrected_two_cell_swap_source \* sort.
    (member : cic_corrected_two_cell_swap_member sort)
    : corrected_cic_term cic_corrected_two_cell_swap_source_context sort =
    ?= member ?|
    | CicCorrectedTwoCellSwapNewestIdentity _ =>
        CorrectedBoundHere (binder (
            ctx_extend (empty_ctx "swap-source-empty", bool_sort "Bool"),
            function_sort (bool_sort "Bool", bool_sort "Bool"),
            "the-newest-source-cell-is-the-Bool-identity-function"))
    | CicCorrectedTwoCellSwapOlderBool _ =>
        CorrectedBoundThere (
            CorrectedBoundHere (binder (
                empty_ctx "swap-source-empty",
                bool_sort "Bool",
                "the-older-source-cell-is-Bool")),
            "the-older-Bool-crosses-the-newer-function-cell")

:= cic_corrected_two_cell_swap_target \* sort.
    (member : cic_corrected_two_cell_swap_member sort)
    : corrected_cic_term cic_corrected_two_cell_swap_target_context sort =
    ?= member ?|
    | CicCorrectedTwoCellSwapNewestIdentity _ =>
        CorrectedBoundThere (
            CorrectedBoundHere (binder (
                empty_ctx "swap-target-empty",
                function_sort (bool_sort "Bool", bool_sort "Bool"),
                "the-source-newest-function-becomes-the-older-target-cell")),
            "the-function-crosses-the-newest-target-Bool-cell")
    | CicCorrectedTwoCellSwapOlderBool _ =>
        CorrectedBoundHere (binder (
            ctx_extend (
                empty_ctx "swap-target-empty",
                function_sort (bool_sort "Bool", bool_sort "Bool")),
            bool_sort "Bool",
            "the-source-older-Bool-becomes-the-newest-target-cell"))

:= cic_corrected_two_cell_swap_member_runtime \* sort.
    (member : cic_corrected_two_cell_swap_member sort)
    : i64 * i64 * i64 * i64 =
    := source = cic_corrected_two_cell_swap_source member
    := target = cic_corrected_two_cell_swap_target member
    ?= source, target ?|
    | CorrectedBoundHere _, CorrectedBoundThere (CorrectedBoundHere _, _) =>
        0i64, 1i64,
        corrected_cic_term_structural_size source,
        corrected_cic_term_structural_size target
    | CorrectedBoundThere (CorrectedBoundHere _, _), CorrectedBoundHere _ =>
        1i64, 0i64,
        corrected_cic_term_structural_size source,
        corrected_cic_term_structural_size target

