    | corrected_cic_recursive_sort_zero_replay_metric_open_authority (_, _, _, note) => note

inl corrected_cic_recursive_sort_zero_canonical_contractum_shape_terminal () : string =
    inl program = corrected_cic_recursive_double_unary_codomain_program ()
    inl argument_code =
        CorrectedCicClosedTypeCodeSortZero
            "Sort-zero-is-the-second-canonical-recursive-B-of-a-over-x-consumer"
    inl certificate =
        corrected_cic_dependent_beta_contractum_make
            (corrected_cic_recursive_codomain_binder ())
            (corrected_cic_recursive_codomain_program_body program)
            (corrected_cic_closed_type_code_term argument_code)
    match certificate with
    | corrected_cic_dependent_beta_contractum (_, substituted_codomain) =>
        match substituted_codomain with
        | corrected_cic_dependent_substituted_codomain_index result =>
            match result with
            | corrected_cic_parametric_substitution_result (_, _, canonical_target) =>
                inl replay_target =
                    corrected_cic_recursive_codomain_program_substitute program argument_code
                inl canonical_size = corrected_cic_term_structural_size canonical_target
                inl replay_size = corrected_cic_term_structural_size replay_target
                inl canonical_outer = corrected_cic_term_outer_tag canonical_target
                inl replay_outer = corrected_cic_term_outer_tag replay_target
                inl canonical_whnf = reduce_corrected_cic_whnf canonical_target
                inl replay_whnf = reduce_corrected_cic_whnf replay_target
                inl canonical_whnf_size = corrected_cic_term_structural_size canonical_whnf
                inl replay_whnf_size = corrected_cic_term_structural_size replay_whnf
                inl canonical_whnf_outer = corrected_cic_term_outer_tag canonical_whnf
                inl replay_whnf_outer = corrected_cic_term_outer_tag replay_whnf
                inl canonical_whnf_steps = corrected_cic_whnf_step_count canonical_target
                inl replay_whnf_steps = corrected_cic_whnf_step_count replay_target
                inl replay_step_pair_authority =
                    corrected_cic_recursive_sort_zero_replay_step_pair_authority_make
                        canonical_whnf_steps
                        replay_whnf_steps
                inl replay_summary_authority =
                    corrected_cic_recursive_sort_zero_replay_summary_authority_make
                        replay_step_pair_authority
                        canonical_target
                        replay_target
                inl replay_summary_open =
                    corrected_cic_recursive_sort_zero_replay_summary_open_authority_make
                        replay_summary_authority
                inl replay_step_recheck_authority =
                    corrected_cic_recursive_sort_zero_replay_step_recheck_authority_make
                        replay_summary_open
                inl _ = corrected_cic_recursive_sort_zero_replay_step_recheck_authority_note replay_step_recheck_authority
                inl replay_shape_recheck_authority =
                    corrected_cic_recursive_sort_zero_replay_shape_recheck_authority_make
                        replay_summary_open
                inl _ = corrected_cic_recursive_sort_zero_replay_shape_recheck_authority_note replay_shape_recheck_authority
                inl replay_consistency_authority =
                    corrected_cic_recursive_sort_zero_replay_consistency_authority_make
                        replay_step_recheck_authority
                        replay_shape_recheck_authority
                inl _ = corrected_cic_recursive_sort_zero_replay_consistency_authority_note replay_consistency_authority
                inl replay_metric_consistency_authority =
                    corrected_cic_recursive_sort_zero_replay_metric_consistency_authority_make
                        replay_consistency_authority
                        canonical_target
                        replay_target
                inl _ = corrected_cic_recursive_sort_zero_replay_metric_consistency_authority_note replay_metric_consistency_authority
                inl replay_metric_open_authority =
                    corrected_cic_recursive_sort_zero_replay_metric_open_authority_make
                        replay_metric_consistency_authority
                inl _ = corrected_cic_recursive_sort_zero_replay_metric_open_authority_note replay_metric_open_authority
                match replay_summary_open with
                | corrected_cic_recursive_sort_zero_replay_summary_open_authority (_, replay_step_pair_from_summary, open_note) =>
                    inl _ = open_note
                    match replay_step_pair_from_summary with
                    | corrected_cic_recursive_sort_zero_replay_step_pair_authority (canonical_steps_replayed, replay_steps_replayed, step_note) =>
                        inl _ = step_note
                        inl _ : () =
                            $"if !canonical_steps_replayed <> !replay_steps_replayed then failwith \"recursive-Sort-zero-step-pair-authority-open-mismatch\""
                        ()
                inl _ : () =
                    $"if !canonical_size <> !replay_size || !canonical_outer <> !replay_outer || !canonical_whnf_size <> !replay_whnf_size || !canonical_whnf_outer <> !replay_whnf_outer || !canonical_whnf_steps <> !replay_whnf_steps then failwith \"recursive-Sort-zero-canonical-B-of-a-over-x-WHNF-summary-mismatch\""
                "the-recursive-F-of-F-of-x-dependent-codomain-now-relies-on-the-indexed-application-spine-and-term-derived-metric-authorities-for-constant-bound-and-application-shape-instead-of-rechecking-six-detached-scalars-in-the-terminal"

