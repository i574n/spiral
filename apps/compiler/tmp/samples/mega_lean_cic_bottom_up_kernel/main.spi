:= cic_positive_product_signature_value () :
    cic_inductive_signature
        (cic_inductive_signature_product
            cic_inductive_signature_parameter
            cic_inductive_signature_recursive) =
    CicInductiveSignatureProduct (
        CicInductiveSignatureParameter
            "the-product-left-branch-is-a-nonrecursive-parameter",
        CicInductiveSignatureRecursive
            "the-product-right-branch-is-a-positive-recursive-occurrence",
        "products-preserve-strict-positivity-branchwise")

:! cic_inductive_declaration_name = string

:| cic_raw_inductive_declaration schema =
    | CicRawInductiveDeclaration :: \* schema.
        cic_inductive_declaration_name *
        cic_inductive_signature schema * string ->
        cic_raw_inductive_declaration schema

:| cic_verified_inductive_declaration schema =
    | CicVerifiedInductiveDeclaration :: \* schema.
        cic_inductive_declaration_name *
        cic_inductive_signature schema *
        cic_strict_positivity_certificate schema * string ->
        cic_verified_inductive_declaration schema

:| cic_inductive_declaration_verification schema =
    | CicInductiveDeclarationAccepted :: \* schema.
        cic_verified_inductive_declaration schema * string ->
        cic_inductive_declaration_verification schema
    | CicInductiveDeclarationRejected :: \* schema.
        cic_inductive_declaration_name * string ->
        cic_inductive_declaration_verification schema

:= verify_cic_inductive_declaration \* schema.
    (declaration : cic_raw_inductive_declaration schema)
    : cic_inductive_declaration_verification schema =
    ?= declaration ?|
    | CicRawInductiveDeclaration (name, signature, note) =>
        ?= verify_cic_strict_positivity signature ?|
        | CicStrictPositivityAccepted (certificate, _) =>
            CicInductiveDeclarationAccepted (
                CicVerifiedInductiveDeclaration (
                    name,
                    signature,
                    certificate,
                    note),
                "only-a-strictly-positive-signature-can-enter-the-verified-declaration-environment")
        | CicStrictPositivityRejected reason =>
            CicInductiveDeclarationRejected (
                name,
                reason)

:= cic_positive_product_raw_declaration () =
    CicRawInductiveDeclaration (
        cic_inductive_declaration_name "positive-product",
        cic_positive_product_signature_value (),
        "a-product-declaration-is-checked-before-environment-admission")

:= cic_positive_arrow_raw_declaration () =
    CicRawInductiveDeclaration (
        cic_inductive_declaration_name "positive-arrow",
        cic_positive_arrow_signature_value (),
        "a-parameter-domain-arrow-declaration-is-checked-before-environment-admission")

:| ^ cic_generated_strictly_positive_eliminator schema =
    | CicGeneratedEliminatorParameter :: string ->
        cic_generated_strictly_positive_eliminator
            cic_inductive_signature_parameter
    | CicGeneratedEliminatorRecursive :: string ->
        cic_generated_strictly_positive_eliminator
            cic_inductive_signature_recursive
    | CicGeneratedEliminatorProduct :: \* left right.
        cic_generated_strictly_positive_eliminator left *
        cic_generated_strictly_positive_eliminator right * string ->
        cic_generated_strictly_positive_eliminator
            (cic_inductive_signature_product left right)
    | CicGeneratedEliminatorArrow :: \* domain codomain.
        cic_no_recursive_occurrence_certificate domain *
        cic_generated_strictly_positive_eliminator codomain * string ->
        cic_generated_strictly_positive_eliminator
            (cic_inductive_signature_arrow domain codomain)

:= ^ generate_cic_strictly_positive_eliminator \* schema.
    (certificate : cic_strict_positivity_certificate schema)
    : cic_generated_strictly_positive_eliminator schema =
    ?= certificate ?|
    | CicStrictPositivityParameter note =>
        CicGeneratedEliminatorParameter note
    | CicStrictPositivityRecursive note =>
        CicGeneratedEliminatorRecursive note
    | CicStrictPositivityProduct (left, right, note) =>
        CicGeneratedEliminatorProduct (
            generate_cic_strictly_positive_eliminator left,
            generate_cic_strictly_positive_eliminator right,
            note)
    | CicStrictPositivityArrow (domain, codomain, note) =>
        CicGeneratedEliminatorArrow (
            domain,
            generate_cic_strictly_positive_eliminator codomain,
            note)

:| cic_verified_inductive_eliminator schema =
    | CicVerifiedInductiveEliminator :: \* schema.
        cic_verified_inductive_declaration schema *
        cic_generated_strictly_positive_eliminator schema * string ->
        cic_verified_inductive_eliminator schema

:= generate_cic_verified_inductive_eliminator \* schema.
    (declaration : cic_verified_inductive_declaration schema)
    : cic_verified_inductive_eliminator schema =
    ?= declaration ?|
    | CicVerifiedInductiveDeclaration (_, _, certificate, _) =>
        CicVerifiedInductiveEliminator (
            declaration,
            generate_cic_strictly_positive_eliminator certificate,
            "the-eliminator-skeleton-is-generated-only-after-declaration-admission")

:| existential_cic_verified_inductive_eliminator =
    | ExistentialCicVerifiedInductiveEliminator ::
        (\? schema. cic_verified_inductive_eliminator schema) ->
        existential_cic_verified_inductive_eliminator

:| ^ cic_verified_inductive_eliminator_program =
    | CicVerifiedInductiveEliminatorProgramDone
    | CicVerifiedInductiveEliminatorProgramMore ::
        existential_cic_verified_inductive_eliminator *
        cic_verified_inductive_eliminator_program * string ->
        cic_verified_inductive_eliminator_program

:= cic_verified_inductive_eliminator_program_value () :
    cic_verified_inductive_eliminator_program =
    := product_verification =
        verify_cic_inductive_declaration (cic_positive_product_raw_declaration ())
    := arrow_verification =
        verify_cic_inductive_declaration (cic_positive_arrow_raw_declaration ())
    ?= product_verification, arrow_verification ?|
    | CicInductiveDeclarationAccepted (product_declaration, _),
      CicInductiveDeclarationAccepted (arrow_declaration, _) =>
        CicVerifiedInductiveEliminatorProgramMore (
            ExistentialCicVerifiedInductiveEliminator (\? (
                generate_cic_verified_inductive_eliminator product_declaration)),
            CicVerifiedInductiveEliminatorProgramMore (
                ExistentialCicVerifiedInductiveEliminator (\? (
                    generate_cic_verified_inductive_eliminator arrow_declaration)),
                CicVerifiedInductiveEliminatorProgramDone,
                "the-positive-arrow-eliminator-closes-the-program"),
            "the-positive-product-eliminator-opens-the-program")

:! cic_verified_inductive_iota_parameter_conclusion_category = string
:! cic_verified_inductive_iota_recursive_conclusion_category = string
:! cic_verified_inductive_iota_domain_conclusion_category = string

:| cic_verified_inductive_iota_contractum_action category =
    | CicVerifiedInductiveIotaParameterAction :: string ->
        cic_verified_inductive_iota_contractum_action
            cic_verified_inductive_iota_parameter_conclusion_category
    | CicVerifiedInductiveIotaRecursiveHypothesisAction :: string ->
        cic_verified_inductive_iota_contractum_action
            cic_verified_inductive_iota_recursive_conclusion_category
    | CicVerifiedInductiveIotaRecursionFreeDomainAction :: string ->
        cic_verified_inductive_iota_contractum_action
            cic_verified_inductive_iota_domain_conclusion_category

:| existential_cic_verified_inductive_iota_contractum_action =
    | ExistentialCicVerifiedInductiveIotaContractumAction ::
        (\? category.
            cic_verified_inductive_iota_contractum_action category) ->
        existential_cic_verified_inductive_iota_contractum_action

:| ^ cic_verified_inductive_iota_contractum_program =
    | CicVerifiedInductiveIotaContractumProgramDone
    | CicVerifiedInductiveIotaContractumProgramMore ::
        existential_cic_verified_inductive_iota_contractum_action *
        cic_verified_inductive_iota_contractum_program * string ->
        cic_verified_inductive_iota_contractum_program

:= ^ append_cic_verified_inductive_iota_contractum_program
    (left : cic_verified_inductive_iota_contractum_program)
    (right : cic_verified_inductive_iota_contractum_program)
    : cic_verified_inductive_iota_contractum_program =
    ?= left ?|
    | CicVerifiedInductiveIotaContractumProgramDone => right
    | CicVerifiedInductiveIotaContractumProgramMore (head, tail, note) =>
        CicVerifiedInductiveIotaContractumProgramMore (
            head,
            append_cic_verified_inductive_iota_contractum_program tail right,
            note)

:= ^ cic_no_recursive_occurrence_contractum_program \* schema.
    (certificate : cic_no_recursive_occurrence_certificate schema)
    : cic_verified_inductive_iota_contractum_program =
    ?= certificate ?|
    | CicNoRecursiveOccurrenceParameter note =>
        CicVerifiedInductiveIotaContractumProgramMore (
            ExistentialCicVerifiedInductiveIotaContractumAction (\? (
                CicVerifiedInductiveIotaRecursionFreeDomainAction note)),
            CicVerifiedInductiveIotaContractumProgramDone,
            "one-recursion-free-parameter-node-enters-the-iota-contractum")
    | CicNoRecursiveOccurrenceProduct (left, right, note) =>
        CicVerifiedInductiveIotaContractumProgramMore (
            ExistentialCicVerifiedInductiveIotaContractumAction (\? (
                CicVerifiedInductiveIotaRecursionFreeDomainAction note)),
            append_cic_verified_inductive_iota_contractum_program
                (cic_no_recursive_occurrence_contractum_program left)
                (cic_no_recursive_occurrence_contractum_program right),
            "the-recursion-free-product-root-and-both-children-enter-the-contractum")
    | CicNoRecursiveOccurrenceArrow (domain, codomain, note) =>
        CicVerifiedInductiveIotaContractumProgramMore (
            ExistentialCicVerifiedInductiveIotaContractumAction (\? (
                CicVerifiedInductiveIotaRecursionFreeDomainAction note)),
            append_cic_verified_inductive_iota_contractum_program
                (cic_no_recursive_occurrence_contractum_program domain)
                (cic_no_recursive_occurrence_contractum_program codomain),
            "the-recursion-free-arrow-root-and-both-sides-enter-the-contractum")

:= ^ cic_generated_eliminator_iota_contractum_program \* schema.
    (eliminator : cic_generated_strictly_positive_eliminator schema)
    : cic_verified_inductive_iota_contractum_program =
    ?= eliminator ?|
    | CicGeneratedEliminatorParameter note =>
        CicVerifiedInductiveIotaContractumProgramMore (
            ExistentialCicVerifiedInductiveIotaContractumAction (\? (
                CicVerifiedInductiveIotaParameterAction note)),
            CicVerifiedInductiveIotaContractumProgramDone,
            "a-parameter-leaf-survives-iota-contraction")
    | CicGeneratedEliminatorRecursive note =>
        CicVerifiedInductiveIotaContractumProgramMore (
            ExistentialCicVerifiedInductiveIotaContractumAction (\? (
                CicVerifiedInductiveIotaRecursiveHypothesisAction note)),
            CicVerifiedInductiveIotaContractumProgramDone,
            "a-positive-recursive-leaf-becomes-one-recursive-hypothesis")
    | CicGeneratedEliminatorProduct (left, right, _) =>
        append_cic_verified_inductive_iota_contractum_program
            (cic_generated_eliminator_iota_contractum_program left)
            (cic_generated_eliminator_iota_contractum_program right)
    | CicGeneratedEliminatorArrow (domain, codomain, _) =>
        append_cic_verified_inductive_iota_contractum_program
            (cic_no_recursive_occurrence_contractum_program domain)
            (cic_generated_eliminator_iota_contractum_program codomain)

:= cic_verified_eliminator_iota_contractum_program \* schema.
    (eliminator : cic_verified_inductive_eliminator schema)
    : cic_verified_inductive_iota_contractum_program =
    ?= eliminator ?|
    | CicVerifiedInductiveEliminator (_, generated, _) =>
        cic_generated_eliminator_iota_contractum_program generated

:| cic_verified_inductive_iota_parameter_typing_obligation =
    | CicVerifiedInductiveIotaParameterTypingObligationExact :: string ->
        cic_verified_inductive_iota_parameter_typing_obligation

:| cic_verified_inductive_iota_recursive_typing_obligation =
    | CicVerifiedInductiveIotaRecursiveTypingObligationExact :: string ->
        cic_verified_inductive_iota_recursive_typing_obligation

:| cic_verified_inductive_iota_domain_typing_obligation =
    | CicVerifiedInductiveIotaDomainTypingObligationExact :: string ->
        cic_verified_inductive_iota_domain_typing_obligation

:= ^ corrected_cic_term_structural_size \* ctx sort.
    (term : corrected_cic_term ctx sort) : i64 =
    ?= term ?|
    | CorrectedSortZero _ => 1i64
    | CorrectedBoundHere _ => 1i64
    | CorrectedBoundThere (inner, _) =>
        cic_runtime_add_i64 1i64
            (corrected_cic_term_structural_size inner)
    | CorrectedConstant _ => 1i64
    | CorrectedDefinition (body, _) =>
        cic_runtime_add_i64 1i64
            (corrected_cic_term_structural_size body)
    | CorrectedLambda (_, body) =>
        cic_runtime_add_i64 1i64
            (corrected_cic_term_structural_size body)
    | CorrectedPi payload =>
        := \? domain. _, codomain_body = payload
        cic_runtime_add_i64 1i64
            (corrected_cic_term_structural_size codomain_body)
    | CorrectedDependentLambda payload =>
        := \? domain. _, body = payload
        cic_runtime_add_i64 1i64
            (corrected_cic_term_structural_size body)
    | CorrectedDependentApplication payload =>
        := \? domain. _, body, argument_term = payload
        cic_runtime_add_i64 2i64
            (cic_runtime_add_i64
                (corrected_cic_term_structural_size body)
                (corrected_cic_term_structural_size argument_term))
    | CorrectedApplication payload =>
        := \? domain. function_term, argument = payload
        cic_runtime_add_i64 1i64
            (cic_runtime_add_i64
                (corrected_cic_term_structural_size function_term)
                (corrected_cic_term_structural_size argument))
    | CorrectedLet payload =>
        := \? domain. _, value, body = payload
        cic_runtime_add_i64 1i64
            (cic_runtime_add_i64
                (corrected_cic_term_structural_size value)
                (corrected_cic_term_structural_size body))

:! cic_raw_bool_true = string
:! cic_raw_bool_identity_application argument = argument
:! cic_raw_bool_let_identity argument = argument

:| ^ cic_raw_bool_typing term =
    | CicRawBoolTypingTrue ::
        string -> cic_raw_bool_typing cic_raw_bool_true
    | CicRawBoolTypingIdentityApplication :: \* argument.
        cic_raw_bool_typing argument * string ->
        cic_raw_bool_typing (cic_raw_bool_identity_application argument)
    | CicRawBoolTypingLetIdentity :: \* argument.
        cic_raw_bool_typing argument * string ->
        cic_raw_bool_typing (cic_raw_bool_let_identity argument)

:| cic_raw_bool_reduction source target =
    | CicRawBoolBetaIdentity :: \* argument.
        string ->
        cic_raw_bool_reduction
            (cic_raw_bool_identity_application argument) argument
    | CicRawBoolLetIdentity :: \* argument.
        string ->
        cic_raw_bool_reduction
            (cic_raw_bool_let_identity argument) argument

:= derive_cic_raw_bool_subject_reduction
    \* source target.
    (source_typing : cic_raw_bool_typing source)
    (step : cic_raw_bool_reduction source target)
    : cic_raw_bool_typing target =
    ?= source_typing, step ?|
    | CicRawBoolTypingIdentityApplication (argument_typing, _),
      CicRawBoolBetaIdentity _ =>
        argument_typing
    | CicRawBoolTypingLetIdentity (argument_typing, _),
      CicRawBoolLetIdentity _ =>
        argument_typing

:= ^ cic_raw_bool_typing_nodes \* term.
    (typing : cic_raw_bool_typing term) : i64 =
    ?= typing ?|
    | CicRawBoolTypingTrue _ => 1i64
    | CicRawBoolTypingIdentityApplication (argument, _) =>
        cic_runtime_add_i64 1i64 (cic_raw_bool_typing_nodes argument)
    | CicRawBoolTypingLetIdentity (argument, _) =>
        cic_runtime_add_i64 1i64 (cic_raw_bool_typing_nodes argument)

:= cic_raw_bool_two_step_source_typing () :
    cic_raw_bool_typing
        (cic_raw_bool_let_identity
            (cic_raw_bool_identity_application cic_raw_bool_true)) =
    CicRawBoolTypingLetIdentity (
        CicRawBoolTypingIdentityApplication (
            CicRawBoolTypingTrue "true-is-Bool",
            "the-inner-identity-application-is-Bool"),
        "the-outer-let-expression-is-Bool")

:| ^ cic_raw_bool_contextual_reduction source target =
    | CicRawBoolContextualReductionRoot :: \* source target.
        cic_raw_bool_reduction source target * string ->
        cic_raw_bool_contextual_reduction source target
    | CicRawBoolContextualReductionUnderIdentity :: \* source target.
        cic_raw_bool_contextual_reduction source target * string ->
        cic_raw_bool_contextual_reduction
            (cic_raw_bool_identity_application source)
            (cic_raw_bool_identity_application target)
    | CicRawBoolContextualReductionUnderLet :: \* source target.
        cic_raw_bool_contextual_reduction source target * string ->
        cic_raw_bool_contextual_reduction
            (cic_raw_bool_let_identity source)
            (cic_raw_bool_let_identity target)

:= ^ derive_cic_raw_bool_contextual_subject_reduction
    \* source target.
    (source_typing : cic_raw_bool_typing source)
    (step : cic_raw_bool_contextual_reduction source target)
    : cic_raw_bool_typing target =
    ?= source_typing, step ?|
    | source_typing,
      CicRawBoolContextualReductionRoot (root, _) =>
        derive_cic_raw_bool_subject_reduction source_typing root
    | CicRawBoolTypingIdentityApplication (argument_typing, _),
      CicRawBoolContextualReductionUnderIdentity (inner, _) =>
        CicRawBoolTypingIdentityApplication (
            derive_cic_raw_bool_contextual_subject_reduction argument_typing inner,
            "subject-reduction-is-lifted-through-the-identity-application-context")
    | CicRawBoolTypingLetIdentity (argument_typing, _),
      CicRawBoolContextualReductionUnderLet (inner, _) =>
        CicRawBoolTypingLetIdentity (
            derive_cic_raw_bool_contextual_subject_reduction argument_typing inner,
            "subject-reduction-is-lifted-through-the-let-context")

:| ^ cic_raw_bool_contextual_reduction_chain source target =
    | CicRawBoolContextualReductionChainRefl :: \* term.
        string -> cic_raw_bool_contextual_reduction_chain term term
    | CicRawBoolContextualReductionChainStep :: \* source target.
        (\? middle.
            cic_raw_bool_contextual_reduction source middle *
            cic_raw_bool_contextual_reduction_chain middle target * string) ->
        cic_raw_bool_contextual_reduction_chain source target

:= ^ derive_cic_raw_bool_contextual_chain_subject_reduction
    \* source target.
    (source_typing : cic_raw_bool_typing source)
    (chain : cic_raw_bool_contextual_reduction_chain source target)
    : cic_raw_bool_typing target =
    ?= chain ?|
    | CicRawBoolContextualReductionChainRefl _ => source_typing
    | CicRawBoolContextualReductionChainStep payload =>
        := \? middle. head, tail, _ = payload
        derive_cic_raw_bool_contextual_chain_subject_reduction
            (derive_cic_raw_bool_contextual_subject_reduction source_typing head)
            tail

:= cic_raw_bool_contextual_two_step_chain_value () :
    cic_raw_bool_contextual_reduction_chain
        (cic_raw_bool_let_identity
            (cic_raw_bool_identity_application cic_raw_bool_true))
        cic_raw_bool_true =
    CicRawBoolContextualReductionChainStep (\? (
        CicRawBoolContextualReductionUnderLet (
            CicRawBoolContextualReductionRoot (
                CicRawBoolBetaIdentity
                    "beta-reduces-the-inner-identity-application",
                "beta-is-a-root-step-inside-the-let-context"),
            "the-beta-step-is-lifted-through-let"),
        CicRawBoolContextualReductionChainStep (\? (
            CicRawBoolContextualReductionRoot (
                CicRawBoolLetIdentity
                    "the-outer-let-reduces-to-its-now-normal-argument",
                "let-is-the-final-root-step"),
            CicRawBoolContextualReductionChainRefl
                "true-closes-the-contextual-chain",
            "the-second-step-removes-the-let")),
        "the-first-step-reduces-under-the-let-context"))

:= ^ cic_raw_bool_contextual_reduction_runtime \* source target.
    (step : cic_raw_bool_contextual_reduction source target)
    : i64 * i64 * i64 =
    ?= step ?|
    | CicRawBoolContextualReductionRoot (root, _) =>
        ?= root ?|
        | CicRawBoolBetaIdentity _ => 1i64, 0i64, 0i64
        | CicRawBoolLetIdentity _ => 0i64, 1i64, 0i64
    | CicRawBoolContextualReductionUnderIdentity (inner, _) =>
        := beta, lets, depth = cic_raw_bool_contextual_reduction_runtime inner
        beta, lets, cic_runtime_add_i64 1i64 depth
    | CicRawBoolContextualReductionUnderLet (inner, _) =>
        := beta, lets, depth = cic_raw_bool_contextual_reduction_runtime inner
        beta, lets, cic_runtime_add_i64 1i64 depth

:= ^ cic_raw_bool_contextual_chain_runtime \* source target.
    (chain : cic_raw_bool_contextual_reduction_chain source target)
    : i64 * i64 * i64 * i64 =
    ?= chain ?|
    | CicRawBoolContextualReductionChainRefl _ => 0i64, 0i64, 0i64, 0i64
    | CicRawBoolContextualReductionChainStep payload =>
        := \? middle. head, tail, _ = payload
        := beta, lets, depth = cic_raw_bool_contextual_reduction_runtime head
        := tail_steps, tail_beta, tail_lets, tail_depth =
            cic_raw_bool_contextual_chain_runtime tail
        cic_runtime_add_i64 1i64 tail_steps,
        cic_runtime_add_i64 beta tail_beta,
        cic_runtime_add_i64 lets tail_lets,
        cic_runtime_add_i64 depth tail_depth

:= assert_cic_raw_bool_contextual_chain_runtime
    (steps : i64) (beta : i64) (lets : i64) (context_depth : i64)
    (source_nodes : i64) (target_nodes : i64)
    : ()
    =
    := ok_0 = !!!!EQ(steps, 2i64)
    := ok_1 = !!!!EQ(beta, 1i64)
    := ok_2 = !!!!EQ(lets, 1i64)
    := ok_3 = !!!!EQ(context_depth, 1i64)
    := ok_4 = !!!!EQ(source_nodes, 3i64)
    := ok_5 = !!!!EQ(target_nodes, 1i64)
    ? ok_0 && ok_1 && ok_2 && ok_3 && ok_4 && ok_5
    ?> ()
    |: mega_runtime_fail "cic-raw-Bool-contextual-chain-runtime-mismatch"

:= cic_raw_bool_contextual_chain_subject_reduction_terminal () : string =
    := source_typing = cic_raw_bool_two_step_source_typing ()
    := chain = cic_raw_bool_contextual_two_step_chain_value ()
    := target_typing =
        derive_cic_raw_bool_contextual_chain_subject_reduction source_typing chain
    := steps, beta, lets, depth = cic_raw_bool_contextual_chain_runtime chain
    := _ =
        assert_cic_raw_bool_contextual_chain_runtime
            steps beta lets depth
            (cic_raw_bool_typing_nodes source_typing)
            (cic_raw_bool_typing_nodes target_typing)
    "subject-reduction-now-closes-under-term-contexts-because-beta-reduction-occurs-inside-a-let-before-the-outer-l"
    ^^ "et-step-and-the-source-typing-is-transformed-through-both-directed-steps-with-one-context-layer-without-storin"
    ^^ "g-either-intermediate-or-final-target-typing-sealed"

:= corrected_cic_term_outer_tag \* ctx sort.
    (term : corrected_cic_term ctx sort) : i64 =
    ?= term ?|
    | CorrectedSortZero _ => 0i64
    | CorrectedBoundHere _ => 1i64
    | CorrectedConstant _ => 2i64
    | CorrectedDefinition _ => 10i64
    | CorrectedLambda _ => 3i64
    | CorrectedApplication _ => 4i64
    | CorrectedLet _ => 5i64
    | CorrectedBoundThere _ => 6i64
    | CorrectedPi _ => 7i64
    | CorrectedDependentApplication _ => 8i64
    | CorrectedDependentLambda _ => 9i64

:! cic_corrected_lambda_body_reduction ctx domain codomain =
    binder ctx domain *
    corrected_cic_generic_identity_beta_step (ctx_extend ctx domain) codomain * string

:= cic_corrected_lambda_body_reduction_source \* ctx domain codomain.
    (certificate : cic_corrected_lambda_body_reduction ctx domain codomain)
    : corrected_cic_term ctx (function_sort domain codomain) =
    ?= certificate ?|
    | cic_corrected_lambda_body_reduction (binder_value, step, _) =>
        CorrectedLambda (
            binder_value,
            corrected_cic_generic_identity_beta_source step)

:= cic_corrected_lambda_body_reduction_target \* ctx domain codomain.
    (certificate : cic_corrected_lambda_body_reduction ctx domain codomain)
    : corrected_cic_term ctx (function_sort domain codomain) =
    ?= certificate ?|
    | cic_corrected_lambda_body_reduction (binder_value, step, _) =>
        CorrectedLambda (
            binder_value,
            corrected_cic_generic_identity_beta_target step)

:= cic_corrected_lambda_body_reduction_runtime \* ctx domain codomain.
    (certificate : cic_corrected_lambda_body_reduction ctx domain codomain)
    : i64 * i64 * i64 * i64 =
    := source = cic_corrected_lambda_body_reduction_source certificate
    := target = cic_corrected_lambda_body_reduction_target certificate
    corrected_cic_term_structural_size source,
    corrected_cic_term_structural_size target,
    corrected_cic_term_outer_tag source,
    corrected_cic_term_outer_tag target

:= assert_cic_corrected_lambda_body_reduction_runtime
    (source_size : i64) (target_size : i64)
    (source_tag : i64) (target_tag : i64)
    : ()
    =
    := ok_0 = !!!!EQ(source_size, 5i64)
    := ok_1 = !!!!EQ(target_size, 2i64)
    := ok_2 = !!!!EQ(source_tag, 3i64)
    := ok_3 = !!!!EQ(target_tag, 3i64)
    ? ok_0 && ok_1 && ok_2 && ok_3
    ?> ()
    |: mega_runtime_fail "cic-corrected-lambda-body-reduction-runtime-mismatch"

:= cic_corrected_lambda_body_reduction_terminal () : string =
    := outer_binder =
        corrected_cic_generic_binder
            (empty_ctx "empty")
            (bool_sort "Bool")
    := body_step : corrected_cic_generic_identity_beta_step (ctx_extend empty_ctx bool_sort) bool_sort =
        CorrectedCicGenericIdentityBetaStep (
            ctx_extend (empty_ctx "empty", bool_sort "Bool"),
            bool_sort "Bool",
            corrected_cic_bound_here (),
            "the-identity-beta-step-occurs-inside-the-extended-Bool-context")
    := certificate =
        cic_corrected_lambda_body_reduction (
            outer_binder,
            body_step,
            "the-outer-lambda-is-derived-around-both-body-endpoints")
    := source_size, target_size, source_tag, target_tag =
        cic_corrected_lambda_body_reduction_runtime certificate
    := _ =
        assert_cic_corrected_lambda_body_reduction_runtime
            source_size target_size source_tag target_tag
    "the-corrected-core-now-transports-an-indexed-identity-beta-step-under-a-real-lambda-binder-and-derives-both-la"
    ^^ "mbda-endpoints-from-the-same-binder-and-body-step-so-the-source-shrinks-from-five-nodes-to-two-while-remaining"
    ^^ "-lambda-typed-without-a-target-field-sealed"

:! cic_corrected_let_body_reduction ctx domain codomain =
    binder ctx domain *
    corrected_cic_term ctx domain *
    corrected_cic_generic_identity_beta_step (ctx_extend ctx domain) codomain * string

:= cic_corrected_let_body_reduction_source \* ctx domain codomain.
    (certificate : cic_corrected_let_body_reduction ctx domain codomain)
    : corrected_cic_term ctx codomain =
    ?= certificate ?|
    | cic_corrected_let_body_reduction (binder_value, value, step, _) =>
        CorrectedLet (\? (
            binder_value,
            value,
            corrected_cic_generic_identity_beta_source step))

:= cic_corrected_let_body_reduction_target \* ctx domain codomain.
    (certificate : cic_corrected_let_body_reduction ctx domain codomain)
    : corrected_cic_term ctx codomain =
    ?= certificate ?|
    | cic_corrected_let_body_reduction (binder_value, value, step, _) =>
        CorrectedLet (\? (
            binder_value,
            value,
            corrected_cic_generic_identity_beta_target step))

:= cic_corrected_let_body_reduction_runtime \* ctx domain codomain.
    (certificate : cic_corrected_let_body_reduction ctx domain codomain)
    : i64 * i64 * i64 * i64 =
    := source = cic_corrected_let_body_reduction_source certificate
    := target = cic_corrected_let_body_reduction_target certificate
    corrected_cic_term_structural_size source,
    corrected_cic_term_structural_size target,
    corrected_cic_term_outer_tag source,
    corrected_cic_term_outer_tag target

:= assert_cic_corrected_let_body_reduction_runtime
    (source_size : i64) (target_size : i64)
    (source_tag : i64) (target_tag : i64) : () =
    := ok_0 = !!!!EQ(source_size, 6i64)
    := ok_1 = !!!!EQ(target_size, 3i64)
    := ok_2 = !!!!EQ(source_tag, 5i64)
    := ok_3 = !!!!EQ(target_tag, 5i64)
    ? ok_0 && ok_1 && ok_2 && ok_3 ?> () |: mega_runtime_fail "cic-corrected-let-body-reduction-runtime-mismatch"

:= cic_corrected_let_body_reduction_terminal () : string =
    := outer_binder =
        corrected_cic_generic_binder
            (empty_ctx "empty")
            (bool_sort "Bool")
    := body_step : corrected_cic_generic_identity_beta_step (ctx_extend empty_ctx bool_sort) bool_sort =
        CorrectedCicGenericIdentityBetaStep (
            ctx_extend (empty_ctx "empty", bool_sort "Bool"),
            bool_sort "Bool",
            CorrectedBoundHere outer_binder,
            "the-identity-beta-step-occurs-inside-the-let-extended-context")
    := certificate =
        cic_corrected_let_body_reduction (
            outer_binder,
            corrected_cic_true (),
            body_step,
            "the-let-binder-and-value-are-shared-by-both-derived-body-endpoints")
    := source_size, target_size, source_tag, target_tag =
        cic_corrected_let_body_reduction_runtime certificate
    := _ =
        assert_cic_corrected_let_body_reduction_runtime
            source_size target_size source_tag target_tag
    "the-corrected-core-now-transports-an-indexed-identity-beta-step-under-a-real-let-binder-and-derives-both-let-e"
    ^^ "ndpoints-from-one-binder-value-and-body-step-so-the-source-shrinks-from-six-nodes-to-three-without-a-target-ty"
    ^^ "ping-premise-sealed"

:! cic_corrected_let_lambda_body_reduction
    ctx let_domain lambda_domain codomain =
    binder ctx let_domain *
    corrected_cic_term ctx let_domain *
    binder (ctx_extend ctx let_domain) lambda_domain *
    corrected_cic_generic_identity_beta_step
        (ctx_extend (ctx_extend ctx let_domain) lambda_domain)
        codomain * string

:= cic_corrected_let_lambda_body_reduction_source
    \* ctx let_domain lambda_domain codomain.
    (certificate : cic_corrected_let_lambda_body_reduction ctx let_domain lambda_domain codomain)
    : corrected_cic_term ctx (function_sort lambda_domain codomain) =
    ?= certificate ?|
    | cic_corrected_let_lambda_body_reduction (
        let_binder, value, lambda_binder, step, _) =>
        CorrectedLet (\? (
            let_binder,
            value,
            CorrectedLambda (
                lambda_binder,
                corrected_cic_generic_identity_beta_source step)))

:= cic_corrected_let_lambda_body_reduction_target
    \* ctx let_domain lambda_domain codomain.
    (certificate : cic_corrected_let_lambda_body_reduction ctx let_domain lambda_domain codomain)
    : corrected_cic_term ctx (function_sort lambda_domain codomain) =
    ?= certificate ?|
    | cic_corrected_let_lambda_body_reduction (
        let_binder, value, lambda_binder, step, _) =>
        CorrectedLet (\? (
            let_binder,
            value,
            CorrectedLambda (
                lambda_binder,
                corrected_cic_generic_identity_beta_target step)))

:= cic_corrected_let_lambda_body_reduction_runtime
    \* ctx let_domain lambda_domain codomain.
    (certificate : cic_corrected_let_lambda_body_reduction ctx let_domain lambda_domain codomain)
    : i64 * i64 * i64 * i64 =
    := source = cic_corrected_let_lambda_body_reduction_source certificate
    := target = cic_corrected_let_lambda_body_reduction_target certificate
    corrected_cic_term_structural_size source,
    corrected_cic_term_structural_size target,
    corrected_cic_term_outer_tag source,
    corrected_cic_term_outer_tag target

:= assert_cic_corrected_let_lambda_body_reduction_runtime
    (source_size : i64) (target_size : i64)
    (source_tag : i64) (target_tag : i64)
    : ()
    =
    := ok_0 = !!!!EQ(source_size, 7i64)
    := ok_1 = !!!!EQ(target_size, 4i64)
    := ok_2 = !!!!EQ(source_tag, 5i64)
    := ok_3 = !!!!EQ(target_tag, 5i64)
    ? ok_0 && ok_1 && ok_2 && ok_3
    ?> ()
    |: mega_runtime_fail "cic-corrected-let-lambda-body-reduction-runtime-mismatch"

:= cic_corrected_let_lambda_body_reduction_terminal () : string =
    := let_binder =
        corrected_cic_generic_binder
            (empty_ctx "empty")
            (bool_sort "Bool")
    := lambda_binder =
        corrected_cic_generic_binder
            (ctx_extend (empty_ctx "empty", bool_sort "Bool"))
            (bool_sort "Bool")
    := body_step
        : corrected_cic_generic_identity_beta_step (ctx_extend (ctx_extend empty_ctx bool_sort) bool_sort) bool_sort
        =
        CorrectedCicGenericIdentityBetaStep (
            ctx_extend (
                ctx_extend (empty_ctx "empty", bool_sort "Bool"),
                bool_sort "Bool"),
            bool_sort "Bool",
            CorrectedBoundHere lambda_binder,
            "the-identity-beta-step-occurs-below-both-the-let-and-lambda-binders")
    := certificate =
        cic_corrected_let_lambda_body_reduction (
            let_binder,
            corrected_cic_true (),
            lambda_binder,
            body_step,
            "both-context-layers-derive-their-source-and-target-from-the-same-inner-step")
    := source_size, target_size, source_tag, target_tag =
        cic_corrected_let_lambda_body_reduction_runtime certificate
    := _ =
        assert_cic_corrected_let_lambda_body_reduction_runtime
            source_size target_size source_tag target_tag
    "one-directed-identity-beta-step-now-transports-compositionally-through-a-lambda-nested-inside-a-let-so-both-co"
    ^^ "ntext-layers-share-the-same-binders-value-and-inner-relation-and-derive-seven-node-and-four-node-endpoints-wit"
    ^^ "hout-a-target-premise-while-general-contexts-Pi-substitution-and-kernel-unification-remain-open-sealed"

