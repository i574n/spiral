:= corrected_cic_programmed_dependent_application_runtime () :
    i64 * i64 * i64 * i64 =
    := identity_application =
        corrected_cic_programmed_identity_sort_zero_application ()
    := unary_application =
        corrected_cic_programmed_unary_bool_application ()
    := identity_source =
        corrected_cic_programmed_dependent_application_source
            identity_application
    := identity_target =
        corrected_cic_programmed_dependent_application_target
            identity_application
    := unary_source =
        corrected_cic_programmed_dependent_application_source
            unary_application
    := unary_target =
        corrected_cic_programmed_dependent_application_target
            unary_application
    corrected_cic_term_outer_tag identity_source,
    corrected_cic_term_constant_count identity_target,
    corrected_cic_term_outer_tag unary_source,
    corrected_cic_term_constant_count unary_target

:= corrected_cic_programmed_dependent_application_terminal () : string =
    := identity_source_tag, identity_target_constants,
        unary_source_tag, unary_target_constants =
        corrected_cic_programmed_dependent_application_runtime ()
    := ok_0 = !!!!EQ(identity_source_tag, 8i64)
    := ok_1 = !!!!EQ(identity_target_constants, 0i64)
    := ok_2 = !!!!EQ(unary_source_tag, 8i64)
    := ok_3 = !!!!EQ(unary_target_constants, 2i64)
    ? ok_0 && ok_1 && ok_2 && ok_3
    ?> ()
    |: mega_runtime_fail "corrected-cic-programmed-dependent-application-runtime-mismatch"
    "one-dependent-application-constructor-now-consumes-a-codomain-program-and-derives-identity-or-F-of-x-targets"

