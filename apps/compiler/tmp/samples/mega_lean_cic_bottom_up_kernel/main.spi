:= cic_verified_inductive_iota_indexed_recursor_component_terminal () : string =
    := parameter_conclusion =
        CicVerifiedInductiveIotaIndexedParameterConclusion (
            corrected_cic_generic_bool_let_step (),
            CicVerifiedInductiveIotaParameterTypingObligationExact
                "indexed-recursor-parameter-obligation",
            "indexed-recursor-parameter-conclusion")
    := recursive_conclusion_one =
        CicVerifiedInductiveIotaIndexedRecursiveConclusion (
            corrected_cic_generic_bool_beta_step (),
            CicVerifiedInductiveIotaRecursiveTypingObligationExact
                "indexed-recursor-recursive-obligation-one",
            "indexed-recursor-recursive-conclusion-one")
    := domain_conclusion =
        CicVerifiedInductiveIotaIndexedDomainConclusion (
            CorrectedCicReflexiveStep (
                corrected_cic_sort_zero (),
                "indexed-recursor-domain-reflexive-step"),
            CicVerifiedInductiveIotaDomainTypingObligationExact
                "indexed-recursor-domain-obligation",
            "indexed-recursor-domain-conclusion")
    := recursive_conclusion_two =
        CicVerifiedInductiveIotaIndexedRecursiveConclusion (
            corrected_cic_generic_bool_beta_step (),
            CicVerifiedInductiveIotaRecursiveTypingObligationExact
                "indexed-recursor-recursive-obligation-two",
            "indexed-recursor-recursive-conclusion-two")
    := conclusion_program =
        CicVerifiedInductiveIotaIndexedConclusionProgramMore (
            ExistentialCicVerifiedInductiveIotaIndexedConclusion (\? (
                parameter_conclusion)),
            CicVerifiedInductiveIotaIndexedConclusionProgramMore (
                ExistentialCicVerifiedInductiveIotaIndexedConclusion (\? (
                    recursive_conclusion_one)),
                CicVerifiedInductiveIotaIndexedConclusionProgramMore (
                    ExistentialCicVerifiedInductiveIotaIndexedConclusion (\? (
                        domain_conclusion)),
                    CicVerifiedInductiveIotaIndexedConclusionProgramMore (
                        ExistentialCicVerifiedInductiveIotaIndexedConclusion (\? (
                            recursive_conclusion_two)),
                        CicVerifiedInductiveIotaIndexedConclusionProgramDone,
                        "indexed-recursor-recursive-tail"),
                    "indexed-recursor-domain-cell"),
                "indexed-recursor-recursive-head"),
            "indexed-recursor-parameter-head")
    := component_program =
        derive_cic_verified_inductive_iota_indexed_recursor_component_program
            conclusion_program
    := cells, motives, parameters, recursive =
        cic_verified_inductive_iota_indexed_recursor_component_program_runtime
            component_program
    := _ =
        assert_cic_verified_inductive_iota_indexed_recursor_component_runtime
            cells motives parameters recursive
    "iota-actions-now-flow-through-category-indexed-conclusions-witnesses-and-recursor-components-so-parameter-recu"
    ^^ "rsive-and-domain-cases-cannot-be-cross-wired-by-public-construction-sealed"

