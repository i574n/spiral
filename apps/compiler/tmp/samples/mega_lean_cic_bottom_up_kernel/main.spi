    := source_identity : cic_corrected_context_extension empty_ctx empty_ctx =
        CicCorrectedContextExtensionIdentity
            "the-left-identity-starts-and-ends-at-the-empty-source-context"
    := target_identity
        : cic_corrected_context_extension cic_corrected_three_cell_context cic_corrected_three_cell_context
        =
        CicCorrectedContextExtensionIdentity
            "the-right-identity-starts-and-ends-at-the-three-cell-target-context"
    := left_identity =
        compose_cic_corrected_context_extension source_identity whole
    := right_identity =
        compose_cic_corrected_context_extension whole target_identity
    := base =
        lift_corrected_cic_term_by_extension whole (corrected_cic_true ())
    := left =
        lift_corrected_cic_term_by_extension left_identity (corrected_cic_true ())
    := right =
        lift_corrected_cic_term_by_extension right_identity (corrected_cic_true ())
    := _ =
        assert_cic_corrected_context_extension_identity_runtime
            (cic_corrected_context_extension_runtime whole)
            (cic_corrected_context_extension_runtime left_identity)
            (cic_corrected_context_extension_runtime right_identity)
            (corrected_cic_term_structural_size base)
            (corrected_cic_term_structural_size left)
            (corrected_cic_term_structural_size right)
