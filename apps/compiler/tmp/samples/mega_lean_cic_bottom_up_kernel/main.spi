        | ExistentialCicVerifiedInductiveEliminator payload =>
            := \? schema. eliminator = payload
            := contractum =
                cic_verified_eliminator_iota_contractum_program eliminator
            := direct_program =
                conclude_cic_verified_inductive_iota_indexed_directed_reduction_program
                    (derive_cic_verified_inductive_iota_directed_reduction_program
                        contractum)
            := cells, matches, parameters, recursive, domains =
                cic_verified_inductive_iota_indexed_conclusion_program_runtime
                    direct_program
            := tail_cases, tail_cells, tail_matches, tail_parameters,
                tail_recursive, tail_domains =
                cic_verified_inductive_eliminator_program_direct_conclusion_runtime tail
            cic_runtime_add_i64 1i64 tail_cases,
            cic_runtime_add_i64 cells tail_cells,
            cic_runtime_add_i64 matches tail_matches,
            cic_runtime_add_i64 parameters tail_parameters,
            cic_runtime_add_i64 recursive tail_recursive,
            cic_runtime_add_i64 domains tail_domains

:= assert_cic_verified_inductive_eliminator_program_direct_conclusion_runtime
    (cases : i64) (cells : i64) (matches : i64) (parameters : i64)
    (recursive : i64) (domains : i64)
    : ()
    =
    := ok_0 = !!!!EQ(cases, 2i64)
    := ok_1 = !!!!EQ(cells, 4i64)
    := ok_2 = !!!!EQ(matches, 4i64)
    := ok_3 = !!!!EQ(parameters, 1i64)
    := ok_4 = !!!!EQ(recursive, 2i64)
    := ok_5 = !!!!EQ(domains, 1i64)
    ? ok_0 && ok_1 && ok_2 && ok_3 && ok_4 && ok_5
    ?> ()
    |: mega_runtime_fail "cic-verified-inductive-eliminator-program-direct-conclusion-runtime-mismatch"

