            corrected_cic_bool_dependent_result index * string) ->
        corrected_cic_bool_dependent_application

inl corrected_cic_bool_dependent_application_of_witness forall index.
    (witness : corrected_cic_bool_index_witness index)
    : corrected_cic_bool_dependent_application =
    CorrectedCicBoolDependentApplication (exists (
        witness,
        corrected_cic_bool_dependent_apply witness,
        "the-same-index-witness-derives-the-hidden-dependent-result"))

union rec corrected_cic_bool_dependent_application_program =
    | CorrectedCicBoolDependentApplicationProgramDone ::
        corrected_cic_bool_dependent_application_program
    | CorrectedCicBoolDependentApplicationProgramStep ::
        corrected_cic_bool_dependent_application *
        corrected_cic_bool_dependent_application_program * string ->
        corrected_cic_bool_dependent_application_program

inl corrected_cic_bool_dependent_application_runtime
    (application : corrected_cic_bool_dependent_application)
    : i64 * i64 * i64 =
    match application with
    | CorrectedCicBoolDependentApplication payload =>
        inl exists index. _, result, _ = payload
        match result with
        | CorrectedCicBoolDependentTrueResult (term, _) =>
            1i64, corrected_cic_term_structural_size term, 1i64
        | CorrectedCicBoolDependentFalseResult (term, _) =>
            2i64, corrected_cic_term_structural_size term, 0i64

inl rec corrected_cic_bool_dependent_application_program_runtime
    (program : corrected_cic_bool_dependent_application_program)
    : i64 * i64 * i64 * i64 =
    match program with
    | CorrectedCicBoolDependentApplicationProgramDone =>
        0i64, 0i64, 0i64, 0i64
    | CorrectedCicBoolDependentApplicationProgramStep (head, tail, _) =>
        inl codomain, size, true_cell =
            corrected_cic_bool_dependent_application_runtime head
        inl cells, codomains, sizes, true_cells =
            corrected_cic_bool_dependent_application_program_runtime tail
        cic_runtime_add_i64 1i64 cells,
        cic_runtime_add_i64 codomain codomains,
        cic_runtime_add_i64 size sizes,
        cic_runtime_add_i64 true_cell true_cells

inl assert_corrected_cic_bool_dependent_application_program_runtime
    (cells : i64) (codomains : i64) (sizes : i64) (true_cells : i64) : () =
    $"if !cells <> 3L || !codomains <> 4L || !sizes <= 0L || !true_cells <> 2L then failwith \"corrected-cic-Bool-dependent-application-program-runtime-mismatch\""

inl corrected_cic_bool_dependent_application_program_terminal () : string =
    inl program =
        CorrectedCicBoolDependentApplicationProgramStep (
            corrected_cic_bool_dependent_application_of_witness (
                CorrectedCicBoolIndexTrue
                    "the-first-cell-carries-the-true-index"),
            CorrectedCicBoolDependentApplicationProgramStep (
                corrected_cic_bool_dependent_application_of_witness (
                    CorrectedCicBoolIndexFalse
                        "the-second-cell-carries-the-false-index"),
                CorrectedCicBoolDependentApplicationProgramStep (
                    corrected_cic_bool_dependent_application_of_witness (
                        CorrectedCicBoolIndexTrue
                            "the-third-cell-restores-the-true-index"),
                    CorrectedCicBoolDependentApplicationProgramDone,
                    "the-third-true-cell-closes-the-heterogeneous-program"),
                "the-false-cell-precedes-the-final-true-cell"),
            "the-first-true-cell-precedes-the-false-cell")
    inl cells, codomains, sizes, true_cells =
        corrected_cic_bool_dependent_application_program_runtime program
    inl _ =
        assert_corrected_cic_bool_dependent_application_program_runtime
            cells codomains sizes true_cells
    "the-first-finite-dependent-CIC-family-now-materializes-a-recursive-heterogeneous-application-program-where-each-hidden-cell-carries-one-argument-index-and-the-result-derived-from-that-exact-witness-so-true-false-and-true-applications-can-share-a-three-cell-list-without-erasing-their-dependent-result-index-or-permitting-cross-result-pairing-while-general-Pi-in-the-main-AST-dependent-substitution-confluence-and-strong-normalization-remain-open-sealed"

inl rec corrected_cic_bool_dependent_application_program_append
    (left : corrected_cic_bool_dependent_application_program)
    (right : corrected_cic_bool_dependent_application_program)
    : corrected_cic_bool_dependent_application_program =
    match left with
    | CorrectedCicBoolDependentApplicationProgramDone => right
    | CorrectedCicBoolDependentApplicationProgramStep (head, tail, note) =>
        CorrectedCicBoolDependentApplicationProgramStep (
            head,
            corrected_cic_bool_dependent_application_program_append tail right,
            note)

inl corrected_cic_bool_dependent_application_program_append_runtime () :
    i64 * i64 * i64 * i64 * i64 * i64 * i64 * i64 =
    inl left =
        CorrectedCicBoolDependentApplicationProgramStep (
            corrected_cic_bool_dependent_application_of_witness (
                CorrectedCicBoolIndexTrue "append-left-true"),
            CorrectedCicBoolDependentApplicationProgramStep (
                corrected_cic_bool_dependent_application_of_witness (
                    CorrectedCicBoolIndexFalse "append-left-false"),
                CorrectedCicBoolDependentApplicationProgramDone,
                "append-left-tail"),
            "append-left-head")
    inl right =
        CorrectedCicBoolDependentApplicationProgramStep (
            corrected_cic_bool_dependent_application_of_witness (
                CorrectedCicBoolIndexTrue "append-right-true"),
            CorrectedCicBoolDependentApplicationProgramDone,
            "append-right-head")
    inl appended = corrected_cic_bool_dependent_application_program_append left right
    inl cells, codomains, sizes, true_cells =
        corrected_cic_bool_dependent_application_program_runtime appended
    inl left_cells, left_codomains, left_sizes, left_true =
        corrected_cic_bool_dependent_application_program_runtime left
    inl right_cells, right_codomains, right_sizes, right_true =
        corrected_cic_bool_dependent_application_program_runtime right
    cells, codomains, sizes, true_cells,
    cic_runtime_add_i64 left_cells right_cells,
    cic_runtime_add_i64 left_codomains right_codomains,
    cic_runtime_add_i64 left_sizes right_sizes,
    cic_runtime_add_i64 left_true right_true

inl assert_corrected_cic_bool_dependent_application_program_append_runtime
    (cells : i64) (codomains : i64) (sizes : i64) (true_cells : i64)
    (expected_cells : i64) (expected_codomains : i64)
    (expected_sizes : i64) (expected_true_cells : i64) : () =
    $"if !cells <> 3L || !codomains <> 4L || !sizes <= 0L || !true_cells <> 2L || !cells <> !expected_cells || !codomains <> !expected_codomains || !sizes <> !expected_sizes || !true_cells <> !expected_true_cells then failwith \"corrected-cic-Bool-dependent-application-program-append-runtime-mismatch\""

inl corrected_cic_bool_dependent_application_negate
    (application : corrected_cic_bool_dependent_application)
    : corrected_cic_bool_dependent_application =
    match application with
    | CorrectedCicBoolDependentApplication payload =>
        inl exists index. witness, _, _ = payload
        match witness with
        | CorrectedCicBoolIndexTrue _ =>
            corrected_cic_bool_dependent_application_of_witness (
                CorrectedCicBoolIndexFalse
                    "dependent-index-negation-maps-true-to-false")
        | CorrectedCicBoolIndexFalse _ =>
            corrected_cic_bool_dependent_application_of_witness (
                CorrectedCicBoolIndexTrue
                    "dependent-index-negation-maps-false-to-true")

inl rec corrected_cic_bool_dependent_application_program_negate
    (program : corrected_cic_bool_dependent_application_program)
    : corrected_cic_bool_dependent_application_program =
    match program with
    | CorrectedCicBoolDependentApplicationProgramDone =>
        CorrectedCicBoolDependentApplicationProgramDone
    | CorrectedCicBoolDependentApplicationProgramStep (head, tail, note) =>
        CorrectedCicBoolDependentApplicationProgramStep (
            corrected_cic_bool_dependent_application_negate head,
            corrected_cic_bool_dependent_application_program_negate tail,
            note)

inl corrected_cic_bool_dependent_application_program_negation_involution_runtime () :
    i64 * i64 * i64 * i64 * i64 * i64 * i64 * i64 * i64 * i64 * i64 * i64 =
    inl original =
        CorrectedCicBoolDependentApplicationProgramStep (
            corrected_cic_bool_dependent_application_of_witness (
                CorrectedCicBoolIndexTrue "negation-source-true-one"),
            CorrectedCicBoolDependentApplicationProgramStep (
                corrected_cic_bool_dependent_application_of_witness (
                    CorrectedCicBoolIndexFalse "negation-source-false"),
                CorrectedCicBoolDependentApplicationProgramStep (
                    corrected_cic_bool_dependent_application_of_witness (
                        CorrectedCicBoolIndexTrue "negation-source-true-two"),
                    CorrectedCicBoolDependentApplicationProgramDone,
                    "negation-source-tail"),
                "negation-source-middle"),
            "negation-source-head")
    inl once = corrected_cic_bool_dependent_application_program_negate original
    inl twice = corrected_cic_bool_dependent_application_program_negate once
    inl oc, od, os, ot =
        corrected_cic_bool_dependent_application_program_runtime original
    inl nc, nd, ns, nt =
        corrected_cic_bool_dependent_application_program_runtime once
    inl tc, td, ts, tt =
        corrected_cic_bool_dependent_application_program_runtime twice
    oc, od, os, ot, nc, nd, ns, nt, tc, td, ts, tt

inl assert_corrected_cic_bool_dependent_application_program_negation_involution_runtime
    (original_cells : i64) (original_codomains : i64)
    (original_sizes : i64) (original_true : i64)
    (once_cells : i64) (once_codomains : i64)
    (once_sizes : i64) (once_true : i64)
    (twice_cells : i64) (twice_codomains : i64)
    (twice_sizes : i64) (twice_true : i64) : () =
    $"if !original_cells <> 3L || !original_codomains <> 4L || !original_sizes <= 0L || !original_true <> 2L || !once_cells <> 3L || !once_codomains <> 5L || !once_sizes <= 0L || !once_true <> 1L || !twice_cells <> !original_cells || !twice_codomains <> !original_codomains || !twice_sizes <> !original_sizes || !twice_true <> !original_true then failwith \"corrected-cic-Bool-dependent-application-program-negation-involution-runtime-mismatch\""

inl corrected_cic_bool_dependent_application_program_negation_involution_terminal () : string =
    inl original_cells, original_codomains, original_sizes, original_true,
        once_cells, once_codomains, once_sizes, once_true,
        twice_cells, twice_codomains, twice_sizes, twice_true =
        corrected_cic_bool_dependent_application_program_negation_involution_runtime ()
    inl _ =
        assert_corrected_cic_bool_dependent_application_program_negation_involution_runtime
            original_cells original_codomains original_sizes original_true
            once_cells once_codomains once_sizes once_true
            twice_cells twice_codomains twice_sizes twice_true
    "the-finite-dependent-CIC-program-now-has-a-total-index-negation-map-that-rebuilds-each-result-from-the-negated-witness-so-true-false-true-becomes-false-true-false-and-two-maps-restore-the-original-hidden-codomain-summary-without-cross-pairing-results-while-general-Pi-in-the-main-AST-dependent-substitution-confluence-and-strong-normalization-remain-open-sealed"

inl rec corrected_cic_term_bound_here_count forall ctx sort.
    (term : corrected_cic_term ctx sort) : i64 =
    match term with
    | CorrectedSortZero _ => 0i64
    | CorrectedBoundHere _ => 1i64
    | CorrectedBoundThere (outer, _) =>
        corrected_cic_term_bound_here_count outer
    | CorrectedConstant _ => 0i64
    | CorrectedDefinition (body, _) =>
        corrected_cic_term_bound_here_count body
    | CorrectedLambda (_, body) =>
        corrected_cic_term_bound_here_count body
    | CorrectedPi payload =>
        inl exists domain. _, codomain_body = payload
        corrected_cic_term_bound_here_count codomain_body
    | CorrectedDependentLambda payload =>
        inl exists domain. _, body = payload
        corrected_cic_term_bound_here_count body
    | CorrectedDependentApplication payload =>
        inl exists domain. _, body, argument_term = payload
        cic_runtime_add_i64
            (corrected_cic_term_bound_here_count body)
            (corrected_cic_term_bound_here_count argument_term)
    | CorrectedApplication payload =>
        inl exists domain. function_term, argument_term = payload
        cic_runtime_add_i64
            (corrected_cic_term_bound_here_count function_term)
            (corrected_cic_term_bound_here_count argument_term)
    | CorrectedLet payload =>
        inl exists domain. _, value, body = payload
        cic_runtime_add_i64
            (corrected_cic_term_bound_here_count value)
            (corrected_cic_term_bound_here_count body)

inl rec corrected_cic_term_constant_count forall ctx sort.
    (term : corrected_cic_term ctx sort) : i64 =
    match term with
    | CorrectedSortZero _ => 0i64
    | CorrectedBoundHere _ => 0i64
    | CorrectedBoundThere (outer, _) =>
        corrected_cic_term_constant_count outer
    | CorrectedConstant _ => 1i64
    | CorrectedDefinition (body, _) =>
        corrected_cic_term_constant_count body
    | CorrectedLambda (_, body) =>
        corrected_cic_term_constant_count body
    | CorrectedPi payload =>
        inl exists domain. _, codomain_body = payload
        corrected_cic_term_constant_count codomain_body
    | CorrectedDependentLambda payload =>
        inl exists domain. _, body = payload
        corrected_cic_term_constant_count body
    | CorrectedDependentApplication payload =>
        inl exists domain. _, body, argument_term = payload
        cic_runtime_add_i64
            (corrected_cic_term_constant_count body)
            (corrected_cic_term_constant_count argument_term)
    | CorrectedApplication payload =>
        inl exists domain. function_term, argument_term = payload
        cic_runtime_add_i64
            (corrected_cic_term_constant_count function_term)
            (corrected_cic_term_constant_count argument_term)
    | CorrectedLet payload =>
        inl exists domain. _, value, body = payload
        cic_runtime_add_i64
            (corrected_cic_term_constant_count value)
            (corrected_cic_term_constant_count body)

inl rec corrected_cic_term_application_count forall ctx sort.
    (term : corrected_cic_term ctx sort) : i64 =
    match term with
    | CorrectedSortZero _ => 0i64
    | CorrectedBoundHere _ => 0i64
    | CorrectedBoundThere (outer, _) =>
        corrected_cic_term_application_count outer
    | CorrectedConstant _ => 0i64
    | CorrectedDefinition (body, _) =>
        corrected_cic_term_application_count body
    | CorrectedLambda (_, body) =>
        corrected_cic_term_application_count body
    | CorrectedPi payload =>
        inl exists domain. _, codomain_body = payload
        corrected_cic_term_application_count codomain_body
    | CorrectedDependentLambda payload =>
        inl exists domain. _, body = payload
        corrected_cic_term_application_count body
    | CorrectedDependentApplication payload =>
        inl exists domain. _, body, argument_term = payload
        cic_runtime_add_i64 1i64
            (cic_runtime_add_i64
                (corrected_cic_term_application_count body)
                (corrected_cic_term_application_count argument_term))
    | CorrectedApplication payload =>
        inl exists domain. function_term, argument_term = payload
        cic_runtime_add_i64 1i64
            (cic_runtime_add_i64
                (corrected_cic_term_application_count function_term)
                (corrected_cic_term_application_count argument_term))
    | CorrectedLet payload =>
        inl exists domain. _, value, body = payload
        cic_runtime_add_i64
            (corrected_cic_term_application_count value)
            (corrected_cic_term_application_count body)

inl cic_corrected_total_substitution_nested_lambda_let_source () :
    corrected_cic_term
        (ctx_extend empty_ctx bool_sort)
        (function_sort bool_sort bool_sort) =
    inl empty_value = empty_ctx "total-substitution-empty"
    inl bool_value = bool_sort "Bool"
    inl outer_binder : binder empty_ctx bool_sort =
        binder (
            empty_value,
            bool_value,
            "the-outer-Bool-binder-will-be-substituted")
    inl lambda_context_value =
        ctx_extend (empty_value, bool_value)
    inl lambda_binder :
        binder (ctx_extend empty_ctx bool_sort) bool_sort =
        binder (
            lambda_context_value,
            bool_value,
            "the-inner-lambda-binder-is-preserved")
    inl lambda_body_context_value =
        ctx_extend (lambda_context_value, bool_value)
    inl let_binder :
        binder
            (ctx_extend (ctx_extend empty_ctx bool_sort) bool_sort)
            bool_sort =
        binder (
            lambda_body_context_value,
            bool_value,
            "the-inner-let-binder-is-preserved")
    inl identity_under_outer_and_lambda :
        corrected_cic_term
            (ctx_extend (ctx_extend empty_ctx bool_sort) bool_sort)
            (function_sort bool_sort bool_sort) =
        weaken_corrected_cic_term_twice (corrected_cic_identity ())
    inl outer_under_lambda :
        corrected_cic_term
            (ctx_extend (ctx_extend empty_ctx bool_sort) bool_sort)
            bool_sort =
        CorrectedBoundThere (
            CorrectedBoundHere outer_binder,
            "the-substituted-variable-crosses-the-lambda-binder")
    inl application_under_lambda :
        corrected_cic_term
            (ctx_extend (ctx_extend empty_ctx bool_sort) bool_sort)
            bool_sort =
        CorrectedApplication (exists (
            identity_under_outer_and_lambda,
            outer_under_lambda))
    inl outer_under_lambda_and_let :
        corrected_cic_term
            (ctx_extend
                (ctx_extend (ctx_extend empty_ctx bool_sort) bool_sort)
                bool_sort)
            bool_sort =
        CorrectedBoundThere (
            CorrectedBoundThere (
                CorrectedBoundHere outer_binder,
                "the-substituted-variable-crosses-the-lambda-binder-in-the-let-body"),
            "the-substituted-variable-also-crosses-the-let-binder")
    CorrectedLambda (
        lambda_binder,
        CorrectedLet (exists (
            let_binder,
            application_under_lambda,
            outer_under_lambda_and_let)))

inl cic_corrected_total_substitution_nested_lambda_let_runtime () :
    i64 * i64 * i64 * i64 * i64 * i64 =
    inl source =
        cic_corrected_total_substitution_nested_lambda_let_source ()
    inl substitution :
        cic_corrected_substitution
            (ctx_extend empty_ctx bool_sort)
            empty_ctx =
        CicCorrectedSubstitutionDropNewest (
            empty_ctx "total-substitution-empty",
            bool_sort "Bool",
            corrected_cic_true (),
            "the-outer-Bool-binder-is-eliminated-by-the-closed-True-argument")
    inl target =
        apply_cic_corrected_substitution substitution source
    corrected_cic_term_structural_size source,
    corrected_cic_term_structural_size target,
    corrected_cic_term_outer_tag target,
    corrected_cic_term_bound_here_count source,
    corrected_cic_term_bound_here_count target,
    corrected_cic_term_constant_count target

inl assert_cic_corrected_total_substitution_nested_lambda_let_runtime
    (source_size : i64) (target_size : i64) (target_tag : i64)
    (source_bound_here : i64) (target_bound_here : i64)
    (target_constants : i64) : () =
    $"if !source_size <> 12L || !target_size <> 11L || !target_tag <> 3L || !source_bound_here <> 3L || !target_bound_here <> 1L || !target_constants <> 2L then failwith \"cic-corrected-total-substitution-nested-lambda-let-runtime-mismatch\""

inl cic_corrected_total_substitution_nested_lambda_let_terminal () : string =
    inl source_size, target_size, target_tag,
        source_bound_here, target_bound_here, target_constants =
        cic_corrected_total_substitution_nested_lambda_let_runtime ()
    inl _ =
        assert_cic_corrected_total_substitution_nested_lambda_let_runtime
            source_size target_size target_tag
            source_bound_here target_bound_here target_constants
    "one-structural-substitution-now-eliminates-the-newest-binder-and-lifts-itself-under-Lambda-and-Let-so-the-same-outer-variable-is-replaced-at-depths-one-and-two-while-the-inner-binders-remain-scoped-without-caller-supplied-targets-sealed"

nominal corrected_cic_general_pi_identity =
