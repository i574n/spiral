        corrected_cic_identity_indexed_environment identity corrected_cic_three_open_states *
        corrected_cic_identity_indexed_open_membership identity empty_ctx bool_sort
            corrected_cic_three_open_states corrected_cic_oldest_bool_solved_states ->
        corrected_cic_identity_indexed_oldest_bool_selection identity

:= corrected_cic_primary_identity_indexed_oldest_bool_selection_value () :
    corrected_cic_identity_indexed_oldest_bool_selection corrected_cic_primary_environment_identity =
    CorrectedCicIdentityIndexedOldestBoolSelection (
        corrected_cic_identity_indexed_environment (
            corrected_cic_primary_environment_identity "primary-environment",
            corrected_cic_three_open_heterogeneous_meta_environment ()),
        corrected_cic_identity_indexed_open_membership (
            corrected_cic_primary_environment_identity "primary-environment",
            corrected_cic_oldest_bool_open_membership ()))

:= corrected_cic_secondary_identity_indexed_oldest_bool_selection_value () :
    corrected_cic_identity_indexed_oldest_bool_selection corrected_cic_secondary_environment_identity =
    CorrectedCicIdentityIndexedOldestBoolSelection (
        corrected_cic_identity_indexed_environment (
            corrected_cic_secondary_environment_identity "secondary-environment",
            corrected_cic_three_open_heterogeneous_meta_environment ()),
        corrected_cic_identity_indexed_open_membership (
            corrected_cic_secondary_environment_identity "secondary-environment",
            corrected_cic_oldest_bool_open_membership ()))

:= corrected_cic_identity_indexed_assign_oldest_bool \* identity.
    (selection : corrected_cic_identity_indexed_oldest_bool_selection identity)
    (replacement : corrected_cic_term empty_ctx bool_sort) :
    corrected_cic_meta_environment corrected_cic_oldest_bool_solved_states =
    ?= selection ?|
    | CorrectedCicIdentityIndexedOldestBoolSelection (environment, membership) =>
        ?= environment, membership ?|
        | corrected_cic_identity_indexed_environment (_, concrete_environment),
          corrected_cic_identity_indexed_open_membership (_, concrete_membership) =>
            corrected_cic_environment_bound_selected_meta_assign
                concrete_environment concrete_membership replacement

:| ^ corrected_cic_environment_identity_spine identity states =
    | CorrectedCicEnvironmentIdentitySpineEmpty :: \* identity.
        identity ->
        corrected_cic_environment_identity_spine identity corrected_cic_meta_states_empty
    | CorrectedCicEnvironmentIdentitySpineOpen :: \* identity ctx sort tail.
        identity * corrected_cic_environment_identity_spine identity tail ->
        corrected_cic_environment_identity_spine identity
            (corrected_cic_meta_states_open ctx sort tail)
    | CorrectedCicEnvironmentIdentitySpineSolved :: \* identity ctx sort tail.
        identity * corrected_cic_environment_identity_spine identity tail ->
        corrected_cic_environment_identity_spine identity
            (corrected_cic_meta_states_solved ctx sort tail)

:| ^ corrected_cic_environment_open_membership_identity_spine identity ctx sort source target =
    | CorrectedCicEnvironmentOpenMembershipIdentitySpineHere :: \* identity ctx sort tail.
        identity ->
        corrected_cic_environment_open_membership_identity_spine identity ctx sort
            (corrected_cic_meta_states_open ctx sort tail)
            (corrected_cic_meta_states_solved ctx sort tail)
    | CorrectedCicEnvironmentOpenMembershipIdentitySpineUnderOpen ::
        \* identity ctx sort head_ctx head_sort source target.
        identity *
        corrected_cic_environment_open_membership_identity_spine identity ctx sort source target ->
        corrected_cic_environment_open_membership_identity_spine identity ctx sort
            (corrected_cic_meta_states_open head_ctx head_sort source)
            (corrected_cic_meta_states_open head_ctx head_sort target)
    | CorrectedCicEnvironmentOpenMembershipIdentitySpineUnderSolved ::
        \* identity ctx sort head_ctx head_sort source target.
        identity *
        corrected_cic_environment_open_membership_identity_spine identity ctx sort source target ->
        corrected_cic_environment_open_membership_identity_spine identity ctx sort
            (corrected_cic_meta_states_solved head_ctx head_sort source)
            (corrected_cic_meta_states_solved head_ctx head_sort target)

:= ^ corrected_cic_environment_identity_spine_from_environment \* identity states.
    (identity_value : identity)
    (environment : corrected_cic_meta_environment states) :
    corrected_cic_environment_identity_spine identity states =
    ?= environment ?|
    | CorrectedCicMetaEnvironmentEmpty _ =>
        CorrectedCicEnvironmentIdentitySpineEmpty identity_value
    | CorrectedCicMetaEnvironmentOpen (tail, _) =>
        CorrectedCicEnvironmentIdentitySpineOpen (
            identity_value,
            corrected_cic_environment_identity_spine_from_environment
                identity_value tail)
    | CorrectedCicMetaEnvironmentSolved (_, tail, _) =>
        CorrectedCicEnvironmentIdentitySpineSolved (
            identity_value,
            corrected_cic_environment_identity_spine_from_environment
                identity_value tail)

:= ^ corrected_cic_environment_open_membership_identity_spine_from_membership
    \* identity ctx sort source target.
    (identity_value : identity)
    (membership : corrected_cic_meta_open_membership ctx sort source target) :
    corrected_cic_environment_open_membership_identity_spine
        identity ctx sort source target =
    ?= membership ?|
    | CorrectedCicMetaOpenMembershipHere _ =>
        CorrectedCicEnvironmentOpenMembershipIdentitySpineHere identity_value
    | CorrectedCicMetaOpenMembershipUnderOpen (inner, _) =>
        CorrectedCicEnvironmentOpenMembershipIdentitySpineUnderOpen (
            identity_value,
            corrected_cic_environment_open_membership_identity_spine_from_membership
                identity_value inner)
    | CorrectedCicMetaOpenMembershipUnderSolved (inner, _) =>
        CorrectedCicEnvironmentOpenMembershipIdentitySpineUnderSolved (
            identity_value,
            corrected_cic_environment_open_membership_identity_spine_from_membership
                identity_value inner)

:| corrected_cic_recursive_environment_membership_identity_authority identity ctx sort source target =
    | CorrectedCicRecursiveEnvironmentMembershipIdentityAuthority ::
        \* identity ctx sort source target.
        corrected_cic_meta_environment source *
        corrected_cic_meta_open_membership ctx sort source target *
        corrected_cic_environment_identity_spine identity source *
        corrected_cic_environment_open_membership_identity_spine
            identity ctx sort source target ->
        corrected_cic_recursive_environment_membership_identity_authority
            identity ctx sort source target

:= corrected_cic_recursive_environment_membership_identity_authority_from_values
    \* identity ctx sort source target.
    (identity_value : identity)
    (environment : corrected_cic_meta_environment source)
    (membership : corrected_cic_meta_open_membership ctx sort source target) :
    corrected_cic_recursive_environment_membership_identity_authority
        identity ctx sort source target =
    CorrectedCicRecursiveEnvironmentMembershipIdentityAuthority (
        environment,
        membership,
        corrected_cic_environment_identity_spine_from_environment
            identity_value environment,
        corrected_cic_environment_open_membership_identity_spine_from_membership
            identity_value membership)

:= corrected_cic_recursive_environment_membership_identity_assign_oldest_bool \* identity.
    (authority :
        corrected_cic_recursive_environment_membership_identity_authority
            identity empty_ctx bool_sort
            corrected_cic_three_open_states corrected_cic_oldest_bool_solved_states)
    (replacement : corrected_cic_term empty_ctx bool_sort) :
    corrected_cic_meta_environment corrected_cic_oldest_bool_solved_states =
    ?= authority ?|
    | CorrectedCicRecursiveEnvironmentMembershipIdentityAuthority
        (environment, membership, _, _) =>
        corrected_cic_environment_bound_selected_meta_assign
            environment membership replacement

:= corrected_cic_recursive_environment_membership_identity_terminal () : string =
    := primary_authority =
        corrected_cic_recursive_environment_membership_identity_authority_from_values
            (corrected_cic_primary_environment_identity "primary-environment")
            (corrected_cic_three_open_heterogeneous_meta_environment ())
            (corrected_cic_oldest_bool_open_membership ())
    := secondary_authority =
        corrected_cic_recursive_environment_membership_identity_authority_from_values
            (corrected_cic_secondary_environment_identity "secondary-environment")
            (corrected_cic_three_open_heterogeneous_meta_environment ())
            (corrected_cic_oldest_bool_open_membership ())
    := primary_assigned =
        corrected_cic_recursive_environment_membership_identity_assign_oldest_bool
            primary_authority (corrected_cic_true ())
    := secondary_assigned =
        corrected_cic_recursive_environment_membership_identity_assign_oldest_bool
            secondary_authority (corrected_cic_true ())
    := _ = corrected_cic_oldest_bool_assignment_consume primary_assigned
    := _ = corrected_cic_oldest_bool_assignment_consume secondary_assigned
    "the-same-nominal-environment-identity-is-now-replicated-through-the-entire-recursive-environment-shape-and-sel"
    ^^ "ected-membership-path-and-both-assigned-environments-are-consumed-structurally-without-roundtripping-through-s"
    ^^ "olved-count-scalars"

:= corrected_cic_middle_universe_open_membership_after_oldest () :
    corrected_cic_meta_open_membership
        empty_ctx (universe_sort universe_one)
        (corrected_cic_meta_states_open empty_ctx bool_sort
            (corrected_cic_meta_states_open
                empty_ctx (universe_sort universe_one)
                (corrected_cic_meta_states_solved empty_ctx bool_sort
                    corrected_cic_meta_states_empty)))
        (corrected_cic_meta_states_open empty_ctx bool_sort
            (corrected_cic_meta_states_solved
                empty_ctx (universe_sort universe_one)
                (corrected_cic_meta_states_solved empty_ctx bool_sort
                    corrected_cic_meta_states_empty))) =
    CorrectedCicMetaOpenMembershipUnderOpen (
        CorrectedCicMetaOpenMembershipHere
            "the-middle-universe-slot-is-selected-below-the-newest-Bool-slot",
        "the-membership-crosses-the-newest-Bool-slot")

:= corrected_cic_oldest_bool_solved_membership_after_middle () :
    corrected_cic_meta_solved_membership empty_ctx bool_sort
        (corrected_cic_meta_states_open empty_ctx bool_sort
            (corrected_cic_meta_states_solved
                empty_ctx (universe_sort universe_one)
                (corrected_cic_meta_states_solved empty_ctx bool_sort
                    corrected_cic_meta_states_empty))) =
    CorrectedCicMetaSolvedMembershipUnderOpen (
        CorrectedCicMetaSolvedMembershipUnderSolved (
            CorrectedCicMetaSolvedMembershipHere
                "the-oldest-Bool-solution-is-selected-at-the-tail-head",
            "the-lookup-crosses-the-solved-universe-slot"),
        "the-lookup-crosses-the-newest-open-Bool-slot")

:= corrected_cic_newest_bool_open_membership_after_middle () :
    corrected_cic_meta_open_membership empty_ctx bool_sort
        (corrected_cic_meta_states_open empty_ctx bool_sort
            (corrected_cic_meta_states_solved
                empty_ctx (universe_sort universe_one)
                (corrected_cic_meta_states_solved empty_ctx bool_sort
                    corrected_cic_meta_states_empty)))
        (corrected_cic_meta_states_solved empty_ctx bool_sort
            (corrected_cic_meta_states_solved
                empty_ctx (universe_sort universe_one)
                (corrected_cic_meta_states_solved empty_ctx bool_sort
                    corrected_cic_meta_states_empty))) =
    CorrectedCicMetaOpenMembershipHere
        "the-newest-Bool-slot-is-selected-at-the-head"

:= assert_corrected_cic_meta_membership_identity_spine_runtime
    (oldest_equal : i64) (middle_equal : i64) (newest_equal : i64) : () =
    := ok_0 = !!!!EQ(oldest_equal, 1i64)
    := ok_1 = !!!!EQ(middle_equal, 1i64)
    := ok_2 = !!!!EQ(newest_equal, 1i64)
    ? ok_0 && ok_1 && ok_2 ?> () |: mega_runtime_fail "corrected-CIC-membership-identity-spine-runtime-mismatch"

:= assert_corrected_cic_meta_membership_identity_spine_solver_bridge_runtime
    (newest_tag : i64) : () =
    := ok_0 = !!!!EQ(newest_tag, 1i64)
    ? ok_0 ?> () |: mega_runtime_fail "corrected-CIC-membership-identity-spine-solver-bridge-runtime-mismatch"

:= assert_corrected_cic_meta_membership_identity_spine_constraint_solver_runtime
    (newest_solved : i64) : () =
    := ok_0 = !!!!EQ(newest_solved, 1i64)
    ? ok_0 ?> () |: mega_runtime_fail "corrected-CIC-membership-identity-spine-constraint-solver-runtime-mismatch"

:= assert_corrected_cic_meta_membership_identity_spine_other_runtime
    (oldest_tag : i64) (middle_tag : i64) : () =
    := ok_0 = !!!!EQ(oldest_tag, 3i64)
    := ok_1 = !!!!EQ(middle_tag, 3i64)
    ? ok_0 && ok_1 ?> () |: mega_runtime_fail "corrected-CIC-membership-spine-Other-preservation-runtime-mismatch"

:= corrected_cic_meta_membership_identity_spine_terminal () : string =
    := _ = corrected_cic_oldest_bool_open_membership ()
    := _ = corrected_cic_middle_universe_open_membership_after_oldest ()
    := _ = corrected_cic_newest_bool_open_membership_after_middle ()
    := oldest_expected :
        corrected_cic_typed_meta_id
            (corrected_cic_typed_meta_succ
                (corrected_cic_typed_meta_succ corrected_cic_typed_meta_zero)) =
        CorrectedCicTypedMetaSucc (
            CorrectedCicTypedMetaSucc CorrectedCicTypedMetaZero)
    := middle_expected :
        corrected_cic_typed_meta_id
            (corrected_cic_typed_meta_succ corrected_cic_typed_meta_zero) =
        CorrectedCicTypedMetaSucc CorrectedCicTypedMetaZero
    := newest_expected :
        corrected_cic_typed_meta_id corrected_cic_typed_meta_zero =
        CorrectedCicTypedMetaZero
    := \? oldest_identity. _, oldest_decision =
        corrected_cic_meta_open_membership_identity_authority_make
            (corrected_cic_oldest_bool_open_membership ()) oldest_expected
    := \? middle_identity. _, middle_decision =
        corrected_cic_meta_open_membership_identity_authority_make
            (corrected_cic_middle_universe_open_membership_after_oldest ()) middle_expected
    := \? newest_identity. _, newest_decision =
        corrected_cic_meta_open_membership_identity_authority_make
            (corrected_cic_newest_bool_open_membership_after_middle ()) newest_expected
    := _ =
        ?= oldest_decision, middle_decision, newest_decision ?|
        | CorrectedCicTypedMetaIdentityEqual _,
          CorrectedCicTypedMetaIdentityEqual _,
          CorrectedCicTypedMetaIdentityEqual _ => ()
        | _ => mega_runtime_fail "corrected-CIC-membership-identity-spine-proof-authority-mismatch"

    := zero_replacement :
        corrected_cic_selected_typed_meta_term corrected_cic_typed_meta_zero =
        CorrectedCicSelectedTypedMetaRigid "True"
    := oldest_relative_zero =
        corrected_cic_selected_zero_term_from_open_membership (
            corrected_cic_oldest_bool_open_membership ())
    := middle_relative_zero =
        corrected_cic_selected_zero_term_from_open_membership (
            corrected_cic_middle_universe_open_membership_after_oldest ())
    := newest_relative_zero =
        corrected_cic_selected_zero_term_from_open_membership (
            corrected_cic_newest_bool_open_membership_after_middle ())
    := assigned_oldest_other =
        apply_corrected_cic_selected_typed_meta_assignment zero_replacement oldest_relative_zero
    := assigned_middle_other =
        apply_corrected_cic_selected_typed_meta_assignment zero_replacement middle_relative_zero
    := assigned_newest_selected =
        apply_corrected_cic_selected_typed_meta_assignment zero_replacement newest_relative_zero
    := _ =
        assert_corrected_cic_selected_typed_meta_assignment_runtime
            (corrected_cic_selected_typed_meta_term_tag assigned_newest_selected)
            (corrected_cic_selected_typed_meta_term_tag assigned_oldest_other)
    := _ =
        assert_corrected_cic_meta_membership_identity_spine_other_runtime
            (corrected_cic_selected_typed_meta_term_tag assigned_oldest_other)
            (corrected_cic_selected_typed_meta_term_tag assigned_middle_other)
    := selected_middle_identity =
        corrected_cic_selected_open_membership_identity_from_membership (
            corrected_cic_middle_universe_open_membership_after_oldest ())
    ?= selected_middle_identity ?|
    | CorrectedCicSelectedOpenMembershipIdentity selected_payload =>
        := \? selected. selected_middle_id, selected_spine = selected_payload
        := middle_replacement : corrected_cic_selected_typed_meta_term selected =
            CorrectedCicSelectedTypedMetaRigid "Sort0"
        := oldest_relative_middle =
            corrected_cic_selected_typed_meta_term_from_open_membership
                selected_middle_id (corrected_cic_oldest_bool_open_membership ())
        := middle_relative_middle =
            corrected_cic_selected_typed_meta_term_from_open_membership
                selected_middle_id (corrected_cic_middle_universe_open_membership_after_oldest ())
        := newest_relative_middle =
            corrected_cic_selected_typed_meta_term_from_open_membership
                selected_middle_id (corrected_cic_newest_bool_open_membership_after_middle ())
        := assigned_oldest_relative_middle =
            apply_corrected_cic_selected_typed_meta_assignment middle_replacement oldest_relative_middle
        := assigned_middle_selected =
            apply_corrected_cic_selected_typed_meta_assignment middle_replacement middle_relative_middle
        := assigned_newest_relative_middle =
            apply_corrected_cic_selected_typed_meta_assignment middle_replacement newest_relative_middle
        := _ =
            assert_corrected_cic_selected_typed_meta_assignment_runtime
                (corrected_cic_selected_typed_meta_term_tag assigned_middle_selected)
                (corrected_cic_selected_typed_meta_term_tag assigned_oldest_relative_middle)
        ?= assigned_newest_relative_middle ?|
        | CorrectedCicSelectedTypedMetaOther _ =>
            "the-newest-relative-to-middle-assignment-is-now-consumed-as-an-indexed-Other-term-directly-while-the-o"
            ^^ "ldest-relative-control-remains-scalar-for-one-step-at-a-time-migration"

:= corrected_cic_heterogeneous_meta_assignment_program () :
    corrected_cic_meta_assignment_program
        (corrected_cic_meta_states_open empty_ctx bool_sort
            (corrected_cic_meta_states_open
                empty_ctx (universe_sort universe_one)
                (corrected_cic_meta_states_open empty_ctx bool_sort
                    corrected_cic_meta_states_empty)))
        (corrected_cic_meta_states_solved empty_ctx bool_sort
            (corrected_cic_meta_states_solved
                empty_ctx (universe_sort universe_one)
                (corrected_cic_meta_states_solved empty_ctx bool_sort
                    corrected_cic_meta_states_empty)))
        (cic_chain_succ
            (cic_chain_succ
                (cic_chain_succ cic_chain_zero))) =
    CorrectedCicMetaAssignmentProgramMore (\? (
        corrected_cic_oldest_bool_open_membership (),
        CorrectedCicMetaAssignmentPlanRigid (corrected_cic_true ()),
        CorrectedCicMetaAssignmentProgramMore (\? (
            corrected_cic_middle_universe_open_membership_after_oldest (),
            CorrectedCicMetaAssignmentPlanRigid (corrected_cic_sort_zero ()),
            CorrectedCicMetaAssignmentProgramMore (\? (
                corrected_cic_newest_bool_open_membership_after_middle (),
                CorrectedCicMetaAssignmentPlanSuspendedSolved (
                    corrected_cic_oldest_bool_solved_membership_after_middle (),
                    "the-newest-Bool-assignment-reuses-the-oldest-Bool-solution-across-a-heterogeneous-solved-slot"),
                CorrectedCicMetaAssignmentProgramDone,
                "the-third-program-step-solves-the-newest-Bool-slot")),
            "the-second-program-step-solves-the-universe-slot")),
        "the-first-program-step-solves-the-oldest-Bool-slot"))

:= corrected_cic_complete_heterogeneous_meta_environment () :
    corrected_cic_meta_environment
        (corrected_cic_meta_states_solved empty_ctx bool_sort
            (corrected_cic_meta_states_solved
                empty_ctx (universe_sort universe_one)
                (corrected_cic_meta_states_solved empty_ctx bool_sort
                    corrected_cic_meta_states_empty))) =
    execute_corrected_cic_meta_assignment_program
        (corrected_cic_three_open_heterogeneous_meta_environment ())
        (corrected_cic_heterogeneous_meta_assignment_program ())

:= corrected_cic_general_meta_environment_terminal () : string =
    := program = corrected_cic_heterogeneous_meta_assignment_program ()
    := complete = corrected_cic_complete_heterogeneous_meta_environment ()
    := newest_bool =
        lookup_corrected_cic_meta_solution complete
            (CorrectedCicMetaSolvedMembershipHere
                "the-newest-Bool-solution-is-observed-at-the-head")
    := middle_universe =
        lookup_corrected_cic_meta_solution complete
            (CorrectedCicMetaSolvedMembershipUnderSolved (
                CorrectedCicMetaSolvedMembershipHere
                    "the-universe-solution-is-observed-after-one-Bool-prefix",
                "the-lookup-crosses-the-newest-solved-Bool-slot"))
    := oldest_bool =
        lookup_corrected_cic_meta_solution complete
            (CorrectedCicMetaSolvedMembershipUnderSolved (
                CorrectedCicMetaSolvedMembershipUnderSolved (
                    CorrectedCicMetaSolvedMembershipHere
                        "the-oldest-Bool-solution-is-observed-at-the-tail-head",
                    "the-lookup-crosses-the-solved-universe-slot"),
                "the-lookup-crosses-the-newest-solved-Bool-slot"))
    := count = corrected_cic_meta_assignment_program_count program
    := _ = newest_bool
    := _ = middle_universe
    := _ = oldest_bool
    := _ = count
    "the-corrected-CIC-metavariable-source-authority-now-derives-the-empty-and-three-open-heterogeneous-states-from"
    ^^ "-one-constructor-history-materializes-the-only-positive-initial-environment-from-that-authority-and-then-compo"
    ^^ "ses-three-typed-assignments-as-one-source-to-target-program-reusing-an-older-Bool-solution-across-a-solved-uni"
    ^^ "verse-slot-while-direct-construction-of-a-solved-authority-remains-uninhabited-sealed"
:| corrected_cic_ordinary_identity_whnf_step ctx sort =
    | CorrectedCicOrdinaryIdentityWhnfStep :: \* ctx sort.
        corrected_cic_generic_identity_beta_step ctx sort * string ->
        corrected_cic_ordinary_identity_whnf_step ctx sort

:= corrected_cic_ordinary_identity_whnf_source \* ctx sort.
    (step : corrected_cic_ordinary_identity_whnf_step ctx sort)
    : corrected_cic_term ctx sort =
    ?= step ?|
    | CorrectedCicOrdinaryIdentityWhnfStep (beta, _) =>
        corrected_cic_generic_identity_beta_source beta

:= corrected_cic_ordinary_identity_whnf_target \* ctx sort.
    (step : corrected_cic_ordinary_identity_whnf_step ctx sort)
    : corrected_cic_term ctx sort =
    ?= step ?|
    | CorrectedCicOrdinaryIdentityWhnfStep (beta, _) =>
        corrected_cic_generic_identity_beta_target beta

:! corrected_cic_ordinary_identity_whnf_pair_authority =
    corrected_cic_structural_defeq_pair_authority empty_ctx bool_sort *
    corrected_cic_structural_defeq_pair_authority empty_ctx (universe_sort universe_one)

:= corrected_cic_ordinary_identity_whnf_pair_authority_make
    (bool_step : corrected_cic_ordinary_identity_whnf_step empty_ctx bool_sort)
    (sort_step : corrected_cic_ordinary_identity_whnf_step empty_ctx (universe_sort universe_one)) :
    corrected_cic_ordinary_identity_whnf_pair_authority =
    corrected_cic_ordinary_identity_whnf_pair_authority (
        corrected_cic_structural_defeq_pair_authority_make
            (reduce_corrected_cic_whnf
                (corrected_cic_ordinary_identity_whnf_source bool_step))
            (corrected_cic_ordinary_identity_whnf_target bool_step),
        corrected_cic_structural_defeq_pair_authority_make
            (reduce_corrected_cic_whnf
                (corrected_cic_ordinary_identity_whnf_source sort_step))
            (corrected_cic_ordinary_identity_whnf_target sort_step))

:= corrected_cic_ordinary_identity_whnf_terminal () : string =
    := bool_step :
        corrected_cic_ordinary_identity_whnf_step empty_ctx bool_sort =
        CorrectedCicOrdinaryIdentityWhnfStep (
            corrected_cic_generic_bool_beta_step (),
            "the-Bool-instance-is-indexed-by-the-same-source-and-target-type")
    := sort_step :
        corrected_cic_ordinary_identity_whnf_step
            empty_ctx (universe_sort universe_one) =
        CorrectedCicOrdinaryIdentityWhnfStep (
            corrected_cic_generic_sort_beta_step (),
            "the-Sort-instance-is-indexed-by-the-same-source-and-target-type")
    := authority =
        corrected_cic_ordinary_identity_whnf_pair_authority_make
            bool_step sort_step
    := _ = authority
    ?=
        corrected_cic_ordinary_identity_whnf_source bool_step,
        corrected_cic_ordinary_identity_whnf_target bool_step,
        corrected_cic_ordinary_identity_whnf_source sort_step,
        corrected_cic_ordinary_identity_whnf_target sort_step
    ?|
    | CorrectedApplication _,
        CorrectedConstant _,
        CorrectedApplication _,
        CorrectedSortZero _
        =>
