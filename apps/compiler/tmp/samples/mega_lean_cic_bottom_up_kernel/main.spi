                (ctx_extend empty_ctx bool_sort)
                empty_ctx =
            CicCorrectedSubstitutionDropNewest (
                empty_ctx "dependent-Pi-application-empty",
                bool_sort "Bool",
                argument,
                "dependent-Pi-application-substitutes-the-index-term-into-the-selected-codomain")
        match index with
        | CorrectedCicBoolIndexTrue _ =>
            CorrectedCicBoolDependentTrueResult (
                apply_cic_corrected_substitution
