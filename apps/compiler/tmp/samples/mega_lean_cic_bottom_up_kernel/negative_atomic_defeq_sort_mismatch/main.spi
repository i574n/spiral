// The structural defeq decider (successor of the retired atomic decider) compares two terms of one context and one sort: Sort zero (in Sort one) against True (in Bool) must not type-check.
open main

inl impossible_corrected_cic_atomic_defeq_sort_mismatch () : i64 =
    decide_corrected_cic_structural_defeq
        (corrected_cic_sort_zero ())
        (corrected_cic_true ())

inl main () =
    impossible_corrected_cic_atomic_defeq_sort_mismatch ()
