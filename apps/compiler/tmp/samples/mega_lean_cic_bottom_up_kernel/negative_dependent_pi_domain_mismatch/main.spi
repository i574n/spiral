inl impossible_corrected_cic_dependent_pi_domain_mismatch () :
    corrected_cic_bool_dependent_pi =
    inl wrong_domain_binder :
        binder empty_ctx (function_sort bool_sort bool_sort) =
        binder (
            empty_ctx "negative-dependent-Pi-empty",
            function_sort (bool_sort "Bool", bool_sort "Bool"),
            "the-forged-Pi-binder-has-a-function-domain")
    inl true_codomain_body :
        corrected_cic_term
            (ctx_extend empty_ctx bool_sort)
            (universe_sort universe_one) =
        CorrectedSortZero
            "the-true-codomain-body-still-expects-a-Bool-binder"
    inl false_codomain_body :
        corrected_cic_term
            (ctx_extend empty_ctx bool_sort)
            bool_sort =
        CorrectedBoundHere (identity_binder ())
    corrected_cic_bool_dependent_pi (
        wrong_domain_binder,
        true_codomain_body,
        false_codomain_body,
        "a-function-domain-binder-must-not-inhabit-the-Bool-dependent-Pi")

inl main () = impossible_corrected_cic_dependent_pi_domain_mismatch ()