open main

// Type applications on one line: the parser drops a definition whose annotation continues on the next line, without a
// diagnostic (FOR-D, samples/multiline_type_application_dropped), and this negative then compiled vacuously.
inl impossible_nondefeq_authority_not_scoped_pi_authority forall ctx domain.
    (authority : corrected_cic_structural_nondefeq_authority (ctx_extend ctx domain) (universe_sort universe_one))
    : corrected_cic_scoped_pi_term_authority ctx domain =
    authority

inl main () = ()