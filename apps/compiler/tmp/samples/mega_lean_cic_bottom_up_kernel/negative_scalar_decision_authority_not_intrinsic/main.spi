inl impossible_scalar_decision_authority_not_intrinsic () =
    match corrected_cic_general_pi_identity_value () with
    | corrected_cic_general_pi_identity (type_binder, codomain_body, _) =>
        inl scope = corrected_cic_shared_domain_scope_of_binder type_binder
        inl relation =
            corrected_cic_scoped_pi_dependent_application_structural_relation_make (
                corrected_cic_scoped_dependent_application_term_authority_make
                    scope
                    codomain_body
                    (corrected_cic_sort_zero ())
                    codomain_body
                    (corrected_cic_sort_zero ()))
        inl scalar_authority =
            corrected_cic_scoped_pi_dependent_application_structural_relation_decision_authority_make
                relation
        inl impossible :
            corrected_cic_scoped_pi_dependent_application_intrinsic_defeq
                empty_ctx
                (universe_sort universe_zero) =
            scalar_authority
        impossible

inl main () =
    impossible_scalar_decision_authority_not_intrinsic ()