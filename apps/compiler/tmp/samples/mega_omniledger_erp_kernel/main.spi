union typed_fx_fractional_safe_ceiling_decision
    source target input numerator denominator quotient remainder product scaled rounded adjustment =
    | TypedFxFractionalSafeCeilingExact ::
        forall source target input numerator denominator quotient product scaled.
        typed_fx_fractional_floor_step_equation
            source target input numerator denominator quotient nat_zero product scaled *
        runtime_money_nat quotient ->
        typed_fx_fractional_safe_ceiling_decision
            source target input numerator denominator quotient nat_zero product scaled quotient nat_zero
    | TypedFxFractionalSafeCeilingPositive ::
        forall source target input numerator denominator quotient remainder_tail
            product scaled rounded adjustment.
        typed_fx_fractional_floor_step_equation
            source target input numerator denominator quotient
            (nat_succ remainder_tail) product scaled *
        nat_add quotient erp_rate_one rounded *
        nat_add (nat_succ remainder_tail) adjustment denominator *
        runtime_money_nat rounded *
        runtime_money_nat adjustment ->
        typed_fx_fractional_safe_ceiling_decision
            source target input numerator denominator quotient
            (nat_succ remainder_tail) product scaled rounded adjustment

