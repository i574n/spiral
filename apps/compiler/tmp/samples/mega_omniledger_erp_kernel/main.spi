inl apply_typed_fx_hashed_statement_command_to_event_log
    forall command_identity aggregate_identity payload_hash position history.
    (expected : typed_fx_statement_expected_stream_position position position)
    (command : typed_fx_hashed_statement_command command_identity aggregate_identity payload_hash typed_fx_statement_command_fresh)
    (log : typed_fx_hashed_statement_event_log position history)
    : typed_fx_hashed_statement_event_store_decision
        command_identity aggregate_identity payload_hash
        position position history
        (typed_fx_statement_stream_position_next position)
        (typed_fx_hashed_statement_history_more
            command_identity aggregate_identity payload_hash history) =
    match command with
    | typed_fx_hashed_statement_command (
        identity, aggregate, payload_hash_value, fresh, note) =>
        match apply_typed_fx_statement_command_once fresh with
        | TypedFxStatementCommandApply (
            typed_fx_statement_command (statements, _), _) =>
            inl applied =
                typed_fx_statement_command (
                    statements,
                    "the-consumer-derives-the-applied-command-from-the-transition-source")
            inl persisted =
                typed_fx_hashed_statement_command (
                    identity, aggregate, payload_hash_value, applied, note)
            TypedFxHashedStatementEventStoreApplied (
                expected,
                persisted,
                log,
                TypedFxHashedStatementEventLogMore (
                    persisted,
                    log,
                    "the-hashed-command-is-appended-with-identity-aggregate-and-payload-hash"),
                "matching-version-and-fresh-command-produce-an-applied-hashed-event")

inl rec typed_fx_hashed_statement_event_log_runtime forall position history.
    (log : typed_fx_hashed_statement_event_log position history)
    : i64 * i64 * i64 * i64 * i64 =
    match log with
    | TypedFxHashedStatementEventLogEmpty =>
        0i64, 0i64, 0i64, 0i64, 0i64
    | TypedFxHashedStatementEventLogMore (
        typed_fx_hashed_statement_command (_, _, _, applied, _), tail, _) =>
        inl tail_events, tail_statements, tail_debit, tail_credit, tail_mismatch =
            typed_fx_hashed_statement_event_log_runtime tail
        inl statements, _, _, debit, credit, mismatch =
            match applied with
            | typed_fx_statement_command (program, _) =>
                typed_fx_signed_scaled_entity_currency_statement_program_runtime program
        runtime_add_i64 1i64 tail_events,
        runtime_add_i64 statements tail_statements,
        runtime_add_i64 debit tail_debit,
        runtime_add_i64 credit tail_credit,
        runtime_add_i64 mismatch tail_mismatch

inl typed_fx_hashed_statement_event_store_decision_runtime
    forall command_identity aggregate_identity payload_hash
        expected actual history after_position after_history.
    (decision : typed_fx_hashed_statement_event_store_decision command_identity aggregate_identity payload_hash expected actual history after_position after_history)
    : i64 * i64 * i64 * i64 * i64 * i64 * i64 * i64 * i64 =
    match decision with
    | TypedFxHashedStatementEventStoreApplied (_, _, _, after, _) =>
        inl events, statements, debit, credit, mismatch =
            typed_fx_hashed_statement_event_log_runtime after
        1i64, 0i64, 0i64, 0i64, events, statements, debit, credit, mismatch
    | TypedFxHashedStatementEventStoreDuplicateExact (_, log, _) =>
        inl events, statements, debit, credit, mismatch =
            typed_fx_hashed_statement_event_log_runtime log
        0i64, 1i64, 0i64, 0i64, events, statements, debit, credit, mismatch
    | TypedFxHashedStatementEventStoreIdentityCollision (_, log, _) =>
        inl events, statements, debit, credit, mismatch =
            typed_fx_hashed_statement_event_log_runtime log
        0i64, 0i64, 1i64, 0i64, events, statements, debit, credit, mismatch
    | TypedFxHashedStatementEventStoreVersionConflict (_, log, _) =>
        inl events, statements, debit, credit, mismatch =
            typed_fx_hashed_statement_event_log_runtime log
        0i64, 0i64, 0i64, 1i64, events, statements, debit, credit, mismatch

inl assert_typed_fx_hashed_statement_event_store_decisions_runtime
    (applied : i64) (duplicate : i64) (collision : i64) (conflict : i64)
    (events : i64) (statements : i64) (debit : i64)
    (credit : i64) (mismatch : i64) : () =
    inl ok_0 = !!!!EQ(applied, 1i64)
    inl ok_1 = !!!!EQ(duplicate, 1i64)
    inl ok_2 = !!!!EQ(collision, 1i64)
    inl ok_3 = !!!!EQ(conflict, 1i64)
    inl ok_4 = !!!!EQ(events, 4i64)
    inl ok_5 = !!!!EQ(statements, 12i64)
    inl ok_6 = !!!!EQ(debit, 40i64)
    inl ok_7 = !!!!EQ(credit, 40i64)
    inl ok_8 = !!!!EQ(mismatch, 0i64)
    if ok_0 && ok_1 && ok_2 && ok_3 && ok_4 && ok_5 && ok_6 && ok_7 && ok_8 then () else mega_runtime_fail "typed-FX-hashed-statement-event-store-decision-runtime-mismatch"

