union typed_fx_statement_expected_position_raw_decision position =
    | TypedFxStatementExpectedPositionRawAccepted :: forall position.
        typed_fx_statement_expected_stream_position position position *
        i64 * string ->
        typed_fx_statement_expected_position_raw_decision position
    | TypedFxStatementExpectedPositionRawRejected :: forall position.
        i64 * string ->
