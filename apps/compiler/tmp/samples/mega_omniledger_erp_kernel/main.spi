    | TypedFxHashedStatementHistoryContainsThere (tail, _) =>
        runtime_add_i64 1i64
            (typed_fx_hashed_statement_history_contains_depth tail)

inl rec typed_fx_hashed_statement_identity_collision_depth
    forall command_identity incoming_hash history.
    (proof : typed_fx_hashed_statement_identity_collision command_identity incoming_hash history) : i64 =
    match proof with
    | TypedFxHashedStatementIdentityCollisionHere _ => 0i64
    | TypedFxHashedStatementIdentityCollisionThere (tail, _) =>
