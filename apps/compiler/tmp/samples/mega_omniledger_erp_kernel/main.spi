        committed = System.IO.Path.Combine(directory, \"statement.committed\") in let prepared = \
        System.IO.Path.Combine(directory, \"statement.prepared\") in let oldPayload = \
        \"command=stable-old|aggregate=ledger|position=3|debit=19|credit=19\" in let oldBytes = \
        System.Text.Encoding.UTF8.GetBytes(oldPayload) in (use stream = new System.IO.FileStream(committed, \
