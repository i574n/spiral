    $"(let root = System.IO.Path.Combine(System.IO.Path.GetTempPath(), \"spiral-erp-wal-recovery-\" + System.Guid.NewGuid().ToString(\"N\")) in let preparedDirectory = System.IO.Path.Combine(root, \"prepared-phase\") in let committedDirectory = System.IO.Path.Combine(root, \"committed-phase\") in let _ = System.IO.Directory.CreateDirectory(preparedDirectory) in let _ = System.IO.Directory.CreateDirectory(committedDirectory) in let payloadTexts = !payload_sequence.Split([|'|'|], System.StringSplitOptions.RemoveEmptyEntries) in let messageTexts = !outbox_sequence.Split([|'|'|], System.StringSplitOptions.RemoveEmptyEntries) in let payloads = payloadTexts |> Array.map System.Convert.FromBase64String in let messages = messageTexts |> Array.map System.Text.Encoding.UTF8.GetBytes in let countBound = if payloads.Length = messages.Length && int64 payloads.Length = !expected_version && payloads.Length > 0 then 1L else 0L in let lengthBytes (count : int) = System.BitConverter.GetBytes(System.Net.IPAddress.HostToNetworkOrder(count)) in let frameBytes index = let payload = payloads.[index] in let message = messages.[index] in let digest = System.Security.Cryptography.SHA256.HashData(Array.concat [| payload; message; System.BitConverter.GetBytes(index); System.BitConverter.GetBytes(payloads.Length) |]) in Array.concat [| lengthBytes payload.Length; payload; lengthBytes message.Length; message; digest |] in let frames = [|0 .. payloads.Length - 1|] |> Array.collect frameBytes in let envelopeBody = Array.concat [| [|69uy;82uy;80uy;82uy|]; lengthBytes payloads.Length; System.Security.Cryptography.SHA256.HashData(System.Text.Encoding.UTF8.GetBytes(!tree_identity)); System.BitConverter.GetBytes(!expected_version); frames |] in let rootDigest = System.Security.Cryptography.SHA256.HashData(envelopeBody) in let envelope = Array.concat [| envelopeBody; rootDigest |] in let envelopeDigest = System.Convert.ToHexString(System.Security.Cryptography.SHA256.HashData(envelope)) in let oldBytes = System.Text.Encoding.UTF8.GetBytes(\"previous-wal-committed-envelope\") in let writeDurable path bytes = use stream = new System.IO.FileStream(path,System.IO.FileMode.Create,System.IO.FileAccess.Write,System.IO.FileShare.None,4096,System.IO.FileOptions.WriteThrough) in stream.Write(bytes,0,bytes.Length); stream.Flush(true) in let writeText path (text : string) = writeDurable path (System.Text.Encoding.UTF8.GetBytes(text)) in let runSync path = let info = new System.Diagnostics.ProcessStartInfo() in info.FileName <- \"/usr/bin/sync\"; info.UseShellExecute <- false; info.ArgumentList.Add(\"-f\"); info.ArgumentList.Add(path); use process = System.Diagnostics.Process.Start(info) in let completed = process.WaitForExit(5000) in let _ = if not completed then (process.Kill(true); process.WaitForExit() |> ignore) else () in if completed then int64 process.ExitCode else -2L in let validateEnvelope (data : byte array) = try let readLength offset = System.BitConverter.ToInt32(data,offset) |> System.Net.IPAddress.NetworkToHostOrder in if data.Length < 80 || data.[0] <> 69uy || data.[1] <> 82uy || data.[2] <> 80uy || data.[3] <> 82uy then false else let count = readLength 4 in let storedTreeIdentityHash = data.[8 .. 39] in let expectedTreeIdentityHash = System.Security.Cryptography.SHA256.HashData(System.Text.Encoding.UTF8.GetBytes(!tree_identity)) in let storedVersion = System.BitConverter.ToInt64(data,40) in let mutable offset = 48 in let mutable index = 0 in let mutable valid = count > 0 && System.Linq.Enumerable.SequenceEqual(storedTreeIdentityHash,expectedTreeIdentityHash) && storedVersion = !expected_version in while valid && index < count do if offset + 4 > data.Length then valid <- false else let payloadLength = readLength offset in offset <- offset + 4; if payloadLength < 0 || offset + payloadLength + 4 + 32 > data.Length then valid <- false else let payload = data.[offset .. offset + payloadLength - 1] in offset <- offset + payloadLength; let messageLength = readLength offset in offset <- offset + 4; if messageLength < 0 || offset + messageLength + 32 > data.Length then valid <- false else let message = data.[offset .. offset + messageLength - 1] in offset <- offset + messageLength; let digest = data.[offset .. offset + 31] in offset <- offset + 32; if not (System.Linq.Enumerable.SequenceEqual(System.Security.Cryptography.SHA256.HashData(Array.concat [| payload; message; System.BitConverter.GetBytes(index); System.BitConverter.GetBytes(count) |]),digest)) then valid <- false else index <- index + 1 done; if valid && index = count && offset + 32 = data.Length then let rootDigest = data.[offset .. offset + 31] in let bodyDigest = System.Security.Cryptography.SHA256.HashData(data.[0 .. offset - 1]) in System.Linq.Enumerable.SequenceEqual(bodyDigest,rootDigest) else false with _ -> false in let preparedWal = System.IO.Path.Combine(preparedDirectory,\"commit.wal\") in let preparedCandidate = System.IO.Path.Combine(preparedDirectory,\"commit.prepared\") in let preparedCommitted = System.IO.Path.Combine(preparedDirectory,\"commit.committed\") in writeDurable preparedCommitted oldBytes; writeText preparedWal (\"PREPARED:\" + envelopeDigest); writeDurable preparedCandidate envelope; let preparedSync = runSync preparedDirectory in let preparedWalText = System.IO.File.ReadAllText(preparedWal) in let preparedWalSeen = if preparedWalText.StartsWith(\"PREPARED:\") then 1L else 0L in let preparedDigestBound = if preparedWalText = \"PREPARED:\" + envelopeDigest then 1L else 0L in let _ = if System.IO.File.Exists(preparedCandidate) then System.IO.File.Delete(preparedCandidate) else () in let _ = if System.IO.File.Exists(preparedWal) then System.IO.File.Delete(preparedWal) else () in let preparedRecoverySync = runSync preparedDirectory in let preparedCandidateRemoved = if System.IO.File.Exists(preparedCandidate) then 0L else 1L in let preparedOldPreserved = if System.Linq.Enumerable.SequenceEqual(System.IO.File.ReadAllBytes(preparedCommitted),oldBytes) then 1L else 0L in let preparedWalCleared = if System.IO.File.Exists(preparedWal) then 0L else 1L in let committedWal = System.IO.Path.Combine(committedDirectory,\"commit.wal\") in let committedCandidate = System.IO.Path.Combine(committedDirectory,\"commit.prepared\") in let committedPath = System.IO.Path.Combine(committedDirectory,\"commit.committed\") in writeDurable committedPath oldBytes; writeText committedWal (\"PREPARED:\" + envelopeDigest); writeDurable committedCandidate envelope; System.IO.File.Move(committedCandidate,committedPath,true); writeText committedWal (\"COMMITTED:\" + envelopeDigest); let committedSync = runSync committedDirectory in let committedWalText = System.IO.File.ReadAllText(committedWal) in let committedWalSeen = if committedWalText.StartsWith(\"COMMITTED:\") then 1L else 0L in let committedDigestBound = if committedWalText = \"COMMITTED:\" + envelopeDigest then 1L else 0L in let committedRecovered = System.IO.File.ReadAllBytes(committedPath) in let committedNewRecovered = if System.Linq.Enumerable.SequenceEqual(committedRecovered,envelope) then 1L else 0L in let committedEnvelopeValid = if validateEnvelope committedRecovered then 1L else 0L in let frameCount = if committedEnvelopeValid = 1L then int64 payloads.Length else 0L in let _ = if System.IO.File.Exists(committedWal) then System.IO.File.Delete(committedWal) else () in let committedRecoverySync = runSync committedDirectory in let committedWalCleared = if System.IO.File.Exists(committedWal) then 0L else 1L in System.IO.Directory.Delete(root,true); let cleanupAbsent = if System.IO.Directory.Exists(root) then 0L else 1L in int64 envelope.Length,countBound,preparedWalSeen,preparedDigestBound,preparedCandidateRemoved,preparedOldPreserved,preparedWalCleared,preparedSync,preparedRecoverySync,committedWalSeen,committedDigestBound,committedNewRecovered,committedEnvelopeValid,frameCount,committedWalCleared,cleanupAbsent)"

inl erp_p2p_recursive_wal_recovery forall version from to.
    (tree : erp_p2p_event_commit_tree version from to) :
    i64 * i64 * i64 * i64 * i64 * i64 * i64 * i64 * i64 * i64 * i64 * i64 * i64 * i64 * i64 * i64 =
    match erp_p2p_event_commit_tree_physical_authority tree with
    | erp_p2p_event_commit_physical_authority
        (_, payload_sequence, outbox_sequence, authority_identity) =>
        inl version_witness = erp_p2p_event_commit_tree_version tree
        erp_p2p_recursive_wal_recovery_runtime
            payload_sequence outbox_sequence authority_identity (runtime_money_nat_to_i64 version_witness)

inl assert_erp_p2p_recursive_wal_recovery_runtime
    (bytes : i64) (count_bound : i64) (prepared_wal_seen : i64)
    (prepared_digest_bound : i64) (prepared_candidate_removed : i64)
    (prepared_old_preserved : i64) (prepared_wal_cleared : i64)
    (prepared_sync : i64) (prepared_recovery_sync : i64)
    (committed_wal_seen : i64) (committed_digest_bound : i64)
    (committed_new_recovered : i64) (committed_envelope_valid : i64)
    (frame_count : i64) (committed_wal_cleared : i64) (cleanup_absent : i64) : () =
    inl ok_0 = !!!!GT(bytes, 0i64)
    inl ok_1 = !!!!EQ(count_bound, 1i64)
    inl ok_2 = !!!!EQ(prepared_wal_seen, 1i64)
    inl ok_3 = !!!!EQ(prepared_digest_bound, 1i64)
    inl ok_4 = !!!!EQ(prepared_candidate_removed, 1i64)
    inl ok_5 = !!!!EQ(prepared_old_preserved, 1i64)
    inl ok_6 = !!!!EQ(prepared_wal_cleared, 1i64)
    inl ok_7 = !!!!EQ(prepared_sync, 0i64)
    inl ok_8 = !!!!EQ(prepared_recovery_sync, 0i64)
    inl ok_9 = !!!!EQ(committed_wal_seen, 1i64)
    inl ok_10 = !!!!EQ(committed_digest_bound, 1i64)
    inl ok_11 = !!!!EQ(committed_new_recovered, 1i64)
    inl ok_12 = !!!!EQ(committed_envelope_valid, 1i64)
    inl ok_13 = !!!!EQ(frame_count, 4i64)
    inl ok_14 = !!!!EQ(committed_wal_cleared, 1i64)
    inl ok_15 = !!!!EQ(cleanup_absent, 1i64)
    if ok_0 && ok_1 && ok_2 && ok_3 && ok_4 && ok_5 && ok_6 && ok_7 && ok_8 && ok_9 && ok_10 && ok_11 && ok_12 && ok_13 && ok_14 && ok_15 then () else mega_runtime_fail "erp-p2p-recursive-wal-recovery-runtime-mismatch"

nominal erp_p2p_recursive_wal_recovery_receipt version from to =
    runtime_money_nat version *
    erp_p2p_event_commit_authority version from to *
    i64 * string

inl erp_p2p_recursive_wal_recovery_receipt_from_physical forall version from to.
    (tree : erp_p2p_event_commit_tree version from to) :
    erp_p2p_recursive_wal_recovery_receipt version from to =
    inl version_witness = erp_p2p_event_commit_tree_version tree
    inl bytes, count_bound, prepared_wal_seen, prepared_digest_bound, prepared_candidate_removed, prepared_old_preserved, prepared_wal_cleared, prepared_sync, prepared_recovery_sync, committed_wal_seen, committed_digest_bound, committed_new_recovered, committed_envelope_valid, frame_count, committed_wal_cleared, cleanup_absent =
        erp_p2p_recursive_wal_recovery tree
    inl _ =
        assert_erp_p2p_recursive_wal_recovery_runtime
            bytes count_bound prepared_wal_seen prepared_digest_bound
            prepared_candidate_removed prepared_old_preserved prepared_wal_cleared
            prepared_sync prepared_recovery_sync committed_wal_seen committed_digest_bound
            committed_new_recovered committed_envelope_valid frame_count committed_wal_cleared cleanup_absent
    inl authority = erp_p2p_event_commit_tree_authority tree
    erp_p2p_recursive_wal_recovery_receipt
        (version_witness, authority, frame_count, "wal-reopened-bytes-validated-and-typed-authority-promoted")

inl erp_p2p_recursive_wal_recovery_receipt_validate forall version from to.
    (receipt : erp_p2p_recursive_wal_recovery_receipt version from to) :
    runtime_money_nat version * erp_p2p_event_commit_authority version from to =
    match receipt with
    | erp_p2p_recursive_wal_recovery_receipt (version_witness, authority, reopened_frame_count, note) =>
        inl recovered_version = runtime_money_nat_to_i64 version_witness
        inl authority_identity = erp_p2p_event_commit_authority_physical_identity authority
        inl _ : () =
            $"(if !reopened_frame_count <> !recovered_version || not (!authority_identity.Contains(\"erp-p2p-aggregate:\")) || !note <> \"wal-reopened-bytes-validated-and-typed-authority-promoted\" then failwith \"erp-p2p-recursive-wal-recovery-receipt-mismatch\")"
        version_witness, authority

inl erp_p2p_four_event_recursive_wal_recovery_terminal () : string =
    inl tree = erp_p2p_four_event_commit_tree ()
    inl receipt = erp_p2p_recursive_wal_recovery_receipt_from_physical tree
    inl version_witness, authority = erp_p2p_recursive_wal_recovery_receipt_validate receipt
    inl recovered_version = runtime_money_nat_to_i64 version_witness
    inl _ = erp_p2p_event_commit_authority_physical_identity authority
    $"(if !recovered_version <> 4L then failwith \"erp-p2p-recursive-wal-recovery-version-mismatch\")"
    "the-WAL-recovery-receipt-now-routes-generic-count-authority-and-provenance-validation-through-one-reusable-validator-while-the-four-event-terminal-checks-only-its-specific-version-and-field-complete-byte-only-tree-reconstruction-remains-open"

inl erp_p2p_recoverable_fenced_lock_runtime () :
    i64 * i64 * i64 * i64 * i64 * i64 * i64 * i64 * i64 * i64 * string =
    $"(let root = System.IO.Path.Combine(System.IO.Path.GetTempPath(), \"spiral-erp-fenced-lock-\" + System.Guid.NewGuid().ToString(\"N\")) in let _ = System.IO.Directory.CreateDirectory(root) in let lockPath = System.IO.Path.Combine(root,\"writer.lock\") in let takeoverPath = System.IO.Path.Combine(root,\"writer.takeover\") in let markerPath = System.IO.Path.Combine(root,\"owner-a.ready\") in let commitPath = System.IO.Path.Combine(root,\"commit.owner-b\") in let ownerA = \"owner-a\" in let ownerB = \"owner-b\" in let ownerC = \"owner-c\" in let ownerD = \"owner-d\" in let now () = System.DateTimeOffset.UtcNow.ToUnixTimeMilliseconds() in let leaseExpiry = now() + 250L in let ownerARecord = System.String.Join(\"|\",[|ownerA;\"1\";string leaseExpiry|]) in let writeDurable path (bytes : byte array) = use stream = new System.IO.FileStream(path,System.IO.FileMode.Create,System.IO.FileAccess.Write,System.IO.FileShare.None,4096,System.IO.FileOptions.WriteThrough) in stream.Write(bytes,0,bytes.Length); stream.Flush(true) in let runSync path = let info = new System.Diagnostics.ProcessStartInfo() in info.FileName <- \"/usr/bin/sync\"; info.UseShellExecute <- false; info.ArgumentList.Add(\"-f\"); info.ArgumentList.Add(path); use process = System.Diagnostics.Process.Start(info) in let completed = process.WaitForExit(5000) in let _ = if not completed then (process.Kill(true); process.WaitForExit() |> ignore) else () in if completed then int64 process.ExitCode else -2L in let script = \"printf '%s' \\\"$1\\\" > \\\"$2\\\"; /usr/bin/sync -f \\\"$2\\\"; /usr/bin/touch \\\"$3\\\"; /usr/bin/sleep 30\" in let info = new System.Diagnostics.ProcessStartInfo() in info.FileName <- \"/bin/sh\"; info.UseShellExecute <- false; info.ArgumentList.Add(\"-c\"); info.ArgumentList.Add(script); info.ArgumentList.Add(\"erp-owner-a\"); info.ArgumentList.Add(ownerARecord); info.ArgumentList.Add(lockPath); info.ArgumentList.Add(markerPath); use child = System.Diagnostics.Process.Start(info) in let mutable attempts = 0 in while attempts < 200 && not (System.IO.File.Exists(markerPath)) do System.Threading.Thread.Sleep(25); attempts <- attempts + 1 done; let childReady = if System.IO.File.Exists(markerPath) then 1L else 0L in let ownerKilled = if childReady = 1L && not child.HasExited then (child.Kill(true); child.WaitForExit(); 1L) else 0L in while now() <= leaseExpiry do System.Threading.Thread.Sleep(10) done; let currentParts = System.IO.File.ReadAllText(lockPath).Split('|') in let currentFence = System.Int64.Parse(currentParts.[1]) in let currentExpiry = System.Int64.Parse(currentParts.[2]) in let leaseExpired = if now() > currentExpiry then 1L else 0L in let nextFence = currentFence + 1L in let ownerBRecord = System.String.Join(\"|\",[|ownerB;string nextFence;string (now() + 5000L)|]) in writeDurable takeoverPath (System.Text.Encoding.UTF8.GetBytes(ownerBRecord)); System.IO.File.Move(takeoverPath,lockPath,true); let directorySync = runSync root in let installedParts = System.IO.File.ReadAllText(lockPath).Split('|') in let installedFence = System.Int64.Parse(installedParts.[1]) in let fenceAdvanced = if installedFence = 2L && installedFence > currentFence then 1L else 0L in let staleRejected = if installedParts.[0] <> ownerA || installedFence <> 1L then 1L else 0L in let newAccepted = if installedParts.[0] = ownerB && installedFence = 2L then (writeDurable commitPath (System.Text.Encoding.UTF8.GetBytes(\"owner-b-fence-2-commit\")); 1L) else 0L in let ownerBInstalled = if installedParts.[0] = ownerB then 1L else 0L in let committedFenceTwo = if newAccepted = 1L && System.IO.File.ReadAllText(commitPath) = \"owner-b-fence-2-commit\" then 1L else 0L in let ownerCFence = installedFence + 1L in let ownerCRecord = System.String.Join(\"|\",[|ownerC;string ownerCFence;string (now() + 5000L)|]) in writeDurable takeoverPath (System.Text.Encoding.UTF8.GetBytes(ownerCRecord)); System.IO.File.Move(takeoverPath,lockPath,true); let ownerCDirectorySync = runSync root in let ownerCParts = System.IO.File.ReadAllText(lockPath).Split('|') in let ownerCFenceInstalled = System.Int64.Parse(ownerCParts.[1]) in let ownerDFence = ownerCFenceInstalled + 1L in let ownerDRecord = System.String.Join(\"|\",[|ownerD;string ownerDFence;string (now() + 5000L)|]) in writeDurable takeoverPath (System.Text.Encoding.UTF8.GetBytes(ownerDRecord)); System.IO.File.Move(takeoverPath,lockPath,true); let ownerDDirectorySync = runSync root in let finalParts = System.IO.File.ReadAllText(lockPath).Split('|') in let finalFence = System.Int64.Parse(finalParts.[1]) in System.IO.Directory.Delete(root,true); let cleanupAbsent = if System.IO.Directory.Exists(root) then 0L else 1L in childReady,ownerKilled,leaseExpired,fenceAdvanced,staleRejected,newAccepted,ownerBInstalled,committedFenceTwo,(if directorySync = 0L && ownerCDirectorySync = 0L && ownerDDirectorySync = 0L && cleanupAbsent = 1L then 1L else 0L),finalFence,System.String.Join(\"|\",[|currentParts.[0];installedParts.[0];ownerCParts.[0];finalParts.[0]|]))"

inl assert_erp_p2p_recoverable_fenced_lock_runtime
    (child_ready : i64) (owner_killed : i64) (lease_expired : i64)
    (fence_advanced : i64) (stale_rejected : i64) (new_accepted : i64)
    (owner_b_installed : i64) (committed_fence_two : i64) (cleanup_synced : i64) : () =
    inl ok_0 = !!!!EQ(child_ready, 1i64)
    inl ok_1 = !!!!EQ(owner_killed, 1i64)
    inl ok_2 = !!!!EQ(lease_expired, 1i64)
    inl ok_3 = !!!!EQ(fence_advanced, 1i64)
    inl ok_4 = !!!!EQ(stale_rejected, 1i64)
    inl ok_5 = !!!!EQ(new_accepted, 1i64)
    inl ok_6 = !!!!EQ(owner_b_installed, 1i64)
    inl ok_7 = !!!!EQ(committed_fence_two, 1i64)
    inl ok_8 = !!!!EQ(cleanup_synced, 1i64)
    if ok_0 && ok_1 && ok_2 && ok_3 && ok_4 && ok_5 && ok_6 && ok_7 && ok_8 then () else mega_runtime_fail "erp-p2p-recoverable-fenced-lock-runtime-mismatch"

inl erp_p2p_physical_owner_sequence_count (physical_owner_sequence : string) : i64 =
    $"(let parts = !physical_owner_sequence.Split([|'|'|], System.StringSplitOptions.RemoveEmptyEntries) in int64 parts.Length)"

inl erp_p2p_physical_owner_sequence_at (physical_owner_sequence : string) (index : i64) : string =
    $"(let parts = !physical_owner_sequence.Split([|'|'|], System.StringSplitOptions.RemoveEmptyEntries) in let i = int !index in if i < 0 || i >= parts.Length then failwith \"erp-p2p-physical-owner-sequence-index-out-of-range\" else parts.[i])"

inl assert_erp_p2p_physical_owner_sequence_cardinality (physical_owner_count : i64) (physical_fence : i64) : () =
    inl ok_0 = !!!!EQ(physical_owner_count, physical_fence)
    if ok_0 then () else mega_runtime_fail "erp-p2p-physical-owner-sequence-cardinality-fence-mismatch"

nominal erp_p2p_fence_owner fence = string

nominal erp_p2p_recoverable_fenced_lock_receipt fence version from to =
    erp_p2p_fence_owner fence *
    erp_p2p_event_store version from to *
    erp_p2p_event_outbox version from to *
    string

nominal erp_p2p_validated_recoverable_fenced_lock_authority fence version from to =
    erp_p2p_fence_owner fence *
    erp_p2p_event_store version from to *
    erp_p2p_event_outbox version from to

inl erp_p2p_validated_recoverable_fenced_lock_authority_make forall fence version from to.
    (receipt : erp_p2p_recoverable_fenced_lock_receipt fence version from to) :
    erp_p2p_validated_recoverable_fenced_lock_authority fence version from to =
    match receipt with
    | erp_p2p_recoverable_fenced_lock_receipt (owner, store, outbox, note) =>
        inl store_version = erp_p2p_event_store_length store
        inl outbox_version = erp_p2p_event_outbox_length outbox
        inl _ : () =
            $"(if !store_version <> !outbox_version || !note <> \"physical-owner-store-outbox-bound-after-fenced-takeover\" then failwith \"erp-p2p-recoverable-fenced-lock-receipt-validation-mismatch\")"
        erp_p2p_validated_recoverable_fenced_lock_authority (owner, store, outbox)

union rec erp_p2p_fence_history fence =
    | ErpP2PFenceGenesis ::
        string * runtime_money_nat nat_one ->
        erp_p2p_fence_history nat_one
    | ErpP2PFenceTakeover :: forall fence.
        erp_p2p_fence_history fence *
        string *
        runtime_money_nat (nat_succ fence) ->
        erp_p2p_fence_history (nat_succ fence)

inl rec erp_p2p_fence_history_value forall fence.
    (history : erp_p2p_fence_history fence) : runtime_money_nat fence =
    match history with
    | ErpP2PFenceGenesis (_, value) => value
    | ErpP2PFenceTakeover (_, _, value) => value

inl rec erp_p2p_fence_history_owner forall fence.
    (history : erp_p2p_fence_history fence) : string =
    match history with
    | ErpP2PFenceGenesis (owner, _) => owner
    | ErpP2PFenceTakeover (_, owner, _) => owner

nominal erp_p2p_recoverable_fenced_lock_physical_observation =
    i64 * i64 * i64 * i64 * i64 * i64 * i64 * i64 * i64 * i64 * string

inl erp_p2p_fence_history_takeover forall fence.
    (history : erp_p2p_fence_history fence)
    (owner : string) : erp_p2p_fence_history (nat_succ fence) =
    ErpP2PFenceTakeover
        (history, owner, RuntimeMoneySucc (erp_p2p_fence_history_value history))

union rec erp_p2p_fence_takeover_program from to =
    | ErpP2PFenceTakeoverProgramOne :: forall fence.
        string ->
        erp_p2p_fence_takeover_program fence (nat_succ fence)
    | ErpP2PFenceTakeoverProgramThen :: forall from to.
        (exists middle.
            erp_p2p_fence_takeover_program from middle *
            erp_p2p_fence_takeover_program middle to) ->
        erp_p2p_fence_takeover_program from to

inl rec erp_p2p_apply_fence_takeover_program forall from to.
    (history : erp_p2p_fence_history from)
    (program : erp_p2p_fence_takeover_program from to) :
    erp_p2p_fence_history to =
    match program with
    | ErpP2PFenceTakeoverProgramOne owner =>
        erp_p2p_fence_history_takeover history owner
    | ErpP2PFenceTakeoverProgramThen payload =>
        inl exists middle. left, right = payload
        erp_p2p_apply_fence_takeover_program
            (erp_p2p_apply_fence_takeover_program history left)
            right

union erp_p2p_persisted_fence_restart_receipt before after =
    | ErpP2PPersistedFenceRestart :: forall before.
        erp_p2p_fence_history before *
        erp_p2p_fence_history (nat_succ before) *
        string ->
        erp_p2p_persisted_fence_restart_receipt before (nat_succ before)

inl erp_p2p_persisted_fence_restart_from_history forall fence.
    (history : erp_p2p_fence_history fence)
    (next_owner : string) :
    erp_p2p_persisted_fence_restart_receipt fence (nat_succ fence) =
    inl next_history = erp_p2p_fence_history_takeover history next_owner
    ErpP2PPersistedFenceRestart
        (history, next_history, "persisted-fence-reopened-and-successor-derived")

union rec erp_p2p_stale_fence stale current =
    | ErpP2PStaleImmediate :: forall fence.
        erp_p2p_stale_fence fence (nat_succ fence)
    | ErpP2PStaleLift :: forall stale current.
        erp_p2p_stale_fence stale current ->
        erp_p2p_stale_fence stale (nat_succ current)

inl rec erp_p2p_stale_fence_distance forall stale current.
    (proof : erp_p2p_stale_fence stale current) : i64 =
    match proof with
    | ErpP2PStaleImmediate => 1i64
    | ErpP2PStaleLift previous => runtime_i64_add (erp_p2p_stale_fence_distance previous) 1i64

inl rec erp_p2p_lift_stale_fence_through_takeover_program forall stale from to.
    (proof : erp_p2p_stale_fence stale from)
    (program : erp_p2p_fence_takeover_program from to) :
    erp_p2p_stale_fence stale to =
    match program with
    | ErpP2PFenceTakeoverProgramOne _ =>
        ErpP2PStaleLift proof
    | ErpP2PFenceTakeoverProgramThen payload =>
        inl exists middle. left, right = payload
        erp_p2p_lift_stale_fence_through_takeover_program
            (erp_p2p_lift_stale_fence_through_takeover_program proof left)
            right

inl rec erp_p2p_takeover_program_initial_stale forall from to.
    (program : erp_p2p_fence_takeover_program from to) :
    erp_p2p_stale_fence from to =
    match program with
    | ErpP2PFenceTakeoverProgramOne _ =>
        ErpP2PStaleImmediate
    | ErpP2PFenceTakeoverProgramThen payload =>
        inl exists middle. left, right = payload
        erp_p2p_lift_stale_fence_through_takeover_program
            (erp_p2p_takeover_program_initial_stale left)
            right

union erp_p2p_fence_takeover_execution from to =
    | ErpP2PFenceTakeoverExecution :: forall from to.
        erp_p2p_fence_history to *
        erp_p2p_stale_fence from to ->
        erp_p2p_fence_takeover_execution from to

inl erp_p2p_execute_fence_takeover_program forall from to.
    (history : erp_p2p_fence_history from)
    (program : erp_p2p_fence_takeover_program from to) :
    erp_p2p_fence_takeover_execution from to =
    ErpP2PFenceTakeoverExecution
        (erp_p2p_apply_fence_takeover_program history program,
         erp_p2p_takeover_program_initial_stale program)

inl rec erp_p2p_fence_takeover_program_owner_sequence forall from to.
    (program : erp_p2p_fence_takeover_program from to) : string =
    match program with
    | ErpP2PFenceTakeoverProgramOne owner => owner
    | ErpP2PFenceTakeoverProgramThen payload =>
        inl exists middle. left, right = payload
        inl left_owners = erp_p2p_fence_takeover_program_owner_sequence left
        inl right_owners = erp_p2p_fence_takeover_program_owner_sequence right
        $"(!left_owners + \"|\" + !right_owners)"

inl erp_p2p_cross_process_takeover_program_runtime
    (initial_owner : string) (initial_fence : i64)
    (owner_sequence : string)
    (expected_owner : string) (expected_fence : i64) :
    i64 * i64 * i64 * i64 * i64 * i64 * i64 * i64 =
    $"(let root = System.IO.Path.Combine(System.IO.Path.GetTempPath(), \"spiral-erp-cross-process-program-\" + System.Guid.NewGuid().ToString(\"N\")) in let _ = System.IO.Directory.CreateDirectory(root) in let statePath = System.IO.Path.Combine(root, \"fence.state\") in let writeDurable path (text : string) = let bytes = System.Text.Encoding.UTF8.GetBytes(text) in use stream = new System.IO.FileStream(path,System.IO.FileMode.Create,System.IO.FileAccess.Write,System.IO.FileShare.None,4096,System.IO.FileOptions.WriteThrough) in stream.Write(bytes,0,bytes.Length); stream.Flush(true) in writeDurable statePath (System.String.Join(\"|\",[|!initial_owner;string !initial_fence|])); let owners = !owner_sequence.Split([|'|'|], System.StringSplitOptions.RemoveEmptyEntries) in let runOwner (completedCount, allChildren) (owner : string) = let info = new System.Diagnostics.ProcessStartInfo() in info.FileName <- \"/bin/sh\"; info.UseShellExecute <- false; info.ArgumentList.Add(\"-c\"); info.ArgumentList.Add(\"IFS='|' read -r old_owner old_fence < $1; next_fence=$(/usr/bin/expr $old_fence + 1); tmp=$1.next; printf '%s|%s' $2 $next_fence > $tmp; /usr/bin/sync -f $tmp; /bin/mv $tmp $1; /usr/bin/sync -f $1\"); info.ArgumentList.Add(\"erp-fence-program\"); info.ArgumentList.Add(statePath); info.ArgumentList.Add(owner); use child = System.Diagnostics.Process.Start(info) in let completed = child.WaitForExit(5000) in let _ = if not completed then (child.Kill(true); child.WaitForExit() |> ignore) else () in let passed = if completed && child.ExitCode = 0 then 1L else 0L in completedCount + passed, (if passed = 1L && allChildren = 1L then 1L else 0L) in let completedCount, allChildren = owners |> Array.fold runOwner (0L,1L) in let stateParts = if System.IO.File.Exists(statePath) then System.IO.File.ReadAllText(statePath).Split('|') else [||] in let finalOwnerMatch = if stateParts.Length = 2 && stateParts.[0] = !expected_owner then 1L else 0L in let finalFenceValue = if stateParts.Length = 2 then System.Int64.Parse(stateParts.[1]) else 0L in let finalFenceMatch = if finalFenceValue = !expected_fence then 1L else 0L in let expectedSteps = !expected_fence - !initial_fence in let processCountBound = if int64 owners.Length = expectedSteps && completedCount = expectedSteps then 1L else 0L in let staleRejected = if !initial_fence < finalFenceValue then 1L else 0L in let currentAccepted = if finalFenceValue = !expected_fence then 1L else 0L in System.IO.Directory.Delete(root,true); let cleanup = if System.IO.Directory.Exists(root) then 0L else 1L in completedCount,allChildren,processCountBound,finalOwnerMatch,finalFenceMatch,staleRejected,currentAccepted,cleanup)"

inl assert_erp_p2p_cross_process_takeover_program_runtime
    (completed_count : i64) (all_children : i64)
    (process_count_bound : i64) (final_owner_match : i64)
    (final_fence_match : i64) (stale_rejected : i64)
    (current_accepted : i64) (cleanup : i64) : () =
    inl ok_0 = !!!!GT(completed_count, 0i64)
    inl ok_1 = !!!!EQ(all_children, 1i64)
    inl ok_2 = !!!!EQ(process_count_bound, 1i64)
    inl ok_3 = !!!!EQ(final_owner_match, 1i64)
    inl ok_4 = !!!!EQ(final_fence_match, 1i64)
    inl ok_5 = !!!!EQ(stale_rejected, 1i64)
    inl ok_6 = !!!!EQ(current_accepted, 1i64)
    inl ok_7 = !!!!EQ(cleanup, 1i64)
    if ok_0 && ok_1 && ok_2 && ok_3 && ok_4 && ok_5 && ok_6 && ok_7 then () else mega_runtime_fail "erp-p2p-cross-process-takeover-program-runtime-mismatch"

union erp_p2p_cross_process_takeover_execution from to =
    | ErpP2PCrossProcessTakeoverExecution :: forall from to.
        erp_p2p_fence_takeover_execution from to *
        string ->
        erp_p2p_cross_process_takeover_execution from to

inl erp_p2p_execute_cross_process_takeover_program forall from to.
    (history : erp_p2p_fence_history from)
    (program : erp_p2p_fence_takeover_program from to) :
    erp_p2p_cross_process_takeover_execution from to =
    inl execution = erp_p2p_execute_fence_takeover_program history program
    match execution with
    | ErpP2PFenceTakeoverExecution (after, _) =>
        inl initial_owner = erp_p2p_fence_history_owner history
        inl initial_fence = runtime_money_nat_to_i64 (erp_p2p_fence_history_value history)
        inl owner_sequence = erp_p2p_fence_takeover_program_owner_sequence program
        inl expected_owner = erp_p2p_fence_history_owner after
        inl expected_fence = runtime_money_nat_to_i64 (erp_p2p_fence_history_value after)
        inl completed_count, all_children, process_count_bound, final_owner_match, final_fence_match, stale_rejected, current_accepted, cleanup =
            erp_p2p_cross_process_takeover_program_runtime
                initial_owner initial_fence owner_sequence expected_owner expected_fence
        inl _ =
            assert_erp_p2p_cross_process_takeover_program_runtime
                completed_count all_children process_count_bound final_owner_match
                final_fence_match stale_rejected current_accepted cleanup
        ErpP2PCrossProcessTakeoverExecution
            (execution,
             "arbitrary-typed-takeover-program-executed-one-persistent-restart-process-per-owner")

inl erp_p2p_cross_process_fence_restart_runtime
    (before_owner : string) (before_fence : i64)
    (after_owner : string) (after_fence : i64) :
    i64 * i64 * i64 * i64 * i64 * i64 * i64 * i64 =
    $"(let root = System.IO.Path.Combine(System.IO.Path.GetTempPath(), \"spiral-erp-cross-process-fence-\" + System.Guid.NewGuid().ToString(\"N\")) in let _ = System.IO.Directory.CreateDirectory(root) in let statePath = System.IO.Path.Combine(root, \"fence.state\") in let childReceiptPath = System.IO.Path.Combine(root, \"child.receipt\") in let writeDurable path (text : string) = let bytes = System.Text.Encoding.UTF8.GetBytes(text) in use stream = new System.IO.FileStream(path,System.IO.FileMode.Create,System.IO.FileAccess.Write,System.IO.FileShare.None,4096,System.IO.FileOptions.WriteThrough) in stream.Write(bytes,0,bytes.Length); stream.Flush(true) in writeDurable statePath (System.String.Join(\"|\",[|!before_owner;string !before_fence|])); let info = new System.Diagnostics.ProcessStartInfo() in info.FileName <- \"/bin/sh\"; info.UseShellExecute <- false; info.ArgumentList.Add(\"-c\"); info.ArgumentList.Add(\"IFS='|' read -r old_owner old_fence < $1; next_fence=$(/usr/bin/expr $old_fence + 1); tmp=$1.next; printf '%s|%s' $2 $next_fence > $tmp; /usr/bin/sync -f $tmp; /bin/mv $tmp $1; printf '%s|%s|%s|%s' $old_owner $old_fence $2 $next_fence > $3; /usr/bin/sync -f $3\"); info.ArgumentList.Add(\"erp-fence-restart\"); info.ArgumentList.Add(statePath); info.ArgumentList.Add(!after_owner); info.ArgumentList.Add(childReceiptPath); use child = System.Diagnostics.Process.Start(info) in let completed = child.WaitForExit(5000) in let _ = if not completed then (child.Kill(true); child.WaitForExit() |> ignore) else () in let childExit = if completed then int64 child.ExitCode else -2L in let receiptParts = if System.IO.File.Exists(childReceiptPath) then System.IO.File.ReadAllText(childReceiptPath).Split('|') else [||] in let stateParts = if System.IO.File.Exists(statePath) then System.IO.File.ReadAllText(statePath).Split('|') else [||] in let childReopenedBefore = if receiptParts.Length = 4 && receiptParts.[0] = !before_owner && System.Int64.Parse(receiptParts.[1]) = !before_fence then 1L else 0L in let childDerivedAfter = if receiptParts.Length = 4 && receiptParts.[2] = !after_owner && System.Int64.Parse(receiptParts.[3]) = !after_fence then 1L else 0L in let persistedAfter = if stateParts.Length = 2 && stateParts.[0] = !after_owner && System.Int64.Parse(stateParts.[1]) = !after_fence then 1L else 0L in let staleRejected = if stateParts.Length = 2 && !before_fence < System.Int64.Parse(stateParts.[1]) then 1L else 0L in let currentAccepted = if stateParts.Length = 2 && !after_fence = System.Int64.Parse(stateParts.[1]) then 1L else 0L in System.IO.Directory.Delete(root,true); let cleanup = if System.IO.Directory.Exists(root) then 0L else 1L in (if completed then 1L else 0L),childExit,childReopenedBefore,childDerivedAfter,persistedAfter,staleRejected,currentAccepted,cleanup)"

inl assert_erp_p2p_cross_process_fence_restart_runtime
    (completed : i64) (child_exit : i64) (child_reopened_before : i64)
    (child_derived_after : i64) (persisted_after : i64)
    (stale_rejected : i64) (current_accepted : i64) (cleanup : i64) : () =
    inl ok_0 = !!!!EQ(completed, 1i64)
    inl ok_1 = !!!!EQ(child_exit, 0i64)
    inl ok_2 = !!!!EQ(child_reopened_before, 1i64)
    inl ok_3 = !!!!EQ(child_derived_after, 1i64)
    inl ok_4 = !!!!EQ(persisted_after, 1i64)
    inl ok_5 = !!!!EQ(stale_rejected, 1i64)
    inl ok_6 = !!!!EQ(current_accepted, 1i64)
    inl ok_7 = !!!!EQ(cleanup, 1i64)
    if ok_0 && ok_1 && ok_2 && ok_3 && ok_4 && ok_5 && ok_6 && ok_7 then () else mega_runtime_fail "erp-p2p-cross-process-fence-restart-runtime-mismatch"

union erp_p2p_cross_process_fence_restart_receipt before after =
    | ErpP2PCrossProcessFenceRestart :: forall before.
        erp_p2p_persisted_fence_restart_receipt before (nat_succ before) *
        erp_p2p_stale_fence before (nat_succ before) *
        string ->
        erp_p2p_cross_process_fence_restart_receipt before (nat_succ before)

inl erp_p2p_cross_process_fence_restart_from_history forall fence.
    (history : erp_p2p_fence_history fence)
    (next_owner : string) :
    erp_p2p_cross_process_fence_restart_receipt fence (nat_succ fence) =
    inl restart = erp_p2p_persisted_fence_restart_from_history history next_owner
    match restart with
    | ErpP2PPersistedFenceRestart (before, after, _) =>
        inl before_owner = erp_p2p_fence_history_owner before
        inl before_fence = runtime_money_nat_to_i64 (erp_p2p_fence_history_value before)
        inl after_owner = erp_p2p_fence_history_owner after
        inl after_fence = runtime_money_nat_to_i64 (erp_p2p_fence_history_value after)
        inl completed, child_exit, child_reopened_before, child_derived_after, persisted_after, stale_rejected, current_accepted, cleanup =
            erp_p2p_cross_process_fence_restart_runtime
                before_owner before_fence after_owner after_fence
        inl _ =
            assert_erp_p2p_cross_process_fence_restart_runtime
                completed child_exit child_reopened_before child_derived_after
                persisted_after stale_rejected current_accepted cleanup
        ErpP2PCrossProcessFenceRestart
            (restart, ErpP2PStaleImmediate,
             "separate-restart-process-reopened-persisted-fence-and-derived-exact-successor")

union erp_p2p_cross_process_fenced_commit_receipt before after version from to =
    | ErpP2PCrossProcessFencedCommit :: forall before version from to.
        erp_p2p_cross_process_fence_restart_receipt before (nat_succ before) *
        erp_p2p_event_store version from to *
        erp_p2p_event_outbox version from to *
        string ->
        erp_p2p_cross_process_fenced_commit_receipt
            before (nat_succ before) version from to

inl erp_p2p_cross_process_fenced_commit_from_history forall fence version from to.
    (history : erp_p2p_fence_history fence)
    (next_owner : string)
    (tree : erp_p2p_event_commit_tree version from to) :
    erp_p2p_cross_process_fenced_commit_receipt
        fence (nat_succ fence) version from to =
    inl store = erp_p2p_event_commit_tree_store tree
    inl outbox = erp_p2p_event_commit_tree_outbox tree
    ErpP2PCrossProcessFencedCommit
        (erp_p2p_cross_process_fence_restart_from_history history next_owner,
         store, outbox,
         "cross-process-successor-fence-bound-to-one-commit-tree")

union erp_p2p_multiprocess_fenced_commit_receipt from to version state_from state_to =
    | ErpP2PMultiprocessFencedCommit :: forall from to version state_from state_to.
        erp_p2p_cross_process_takeover_execution from to *
        erp_p2p_event_store version state_from state_to *
        erp_p2p_event_outbox version state_from state_to *
        string ->
        erp_p2p_multiprocess_fenced_commit_receipt
            from to version state_from state_to

inl erp_p2p_multiprocess_fenced_commit_from_program forall from to version state_from state_to.
    (history : erp_p2p_fence_history from)
    (program : erp_p2p_fence_takeover_program from to)
    (tree : erp_p2p_event_commit_tree version state_from state_to) :
    erp_p2p_multiprocess_fenced_commit_receipt
        from to version state_from state_to =
    inl store = erp_p2p_event_commit_tree_store tree
    inl outbox = erp_p2p_event_commit_tree_outbox tree
    ErpP2PMultiprocessFencedCommit
        (erp_p2p_execute_cross_process_takeover_program history program,
         store, outbox,
         "multiprocess-takeover-program-bound-to-one-commit-tree")

inl erp_p2p_fence_history_one () : erp_p2p_fence_history nat_one =
    ErpP2PFenceGenesis ("owner-a", erp_rate_one_proof ())

inl erp_p2p_fence_history_two () : erp_p2p_fence_history nat_two =
    erp_p2p_fence_history_takeover
        (erp_p2p_fence_history_one ())
        "owner-b"



union rec erp_p2p_physical_owner_lineage =
    | ErpP2PPhysicalOwnerLineageGenesis : string
    | ErpP2PPhysicalOwnerLineageTakeover : erp_p2p_physical_owner_lineage * string

inl rec erp_p2p_physical_owner_lineage_matches_history forall fence.
    (physical_lineage : erp_p2p_physical_owner_lineage)
    (history : erp_p2p_fence_history fence) : () =
    match physical_lineage, history with
    | ErpP2PPhysicalOwnerLineageGenesis physical_owner,
      ErpP2PFenceGenesis (history_owner, _) =>
        inl ok_0 = !!!!EQ(physical_owner, history_owner)
        if ok_0 then () else mega_runtime_fail "erp-p2p-physical-owner-lineage-genesis-mismatch"
    | ErpP2PPhysicalOwnerLineageTakeover (previous_lineage, physical_owner),
      ErpP2PFenceTakeover (previous_history, history_owner, _) =>
        inl _ : () =
            inl ok_0 = !!!!EQ(physical_owner, history_owner)
            if ok_0 then () else mega_runtime_fail "erp-p2p-physical-owner-lineage-takeover-mismatch"
        erp_p2p_physical_owner_lineage_matches_history previous_lineage previous_history
    | _, _ =>
        mega_runtime_fail "erp-p2p-physical-owner-lineage-shape-mismatch"

nominal erp_p2p_physical_owner_lineage_history =
    exists fence. erp_p2p_fence_history fence

inl rec erp_p2p_physical_owner_lineage_history_make
    (physical_lineage : erp_p2p_physical_owner_lineage) :
    erp_p2p_physical_owner_lineage_history =
    match physical_lineage with
    | ErpP2PPhysicalOwnerLineageGenesis owner =>
        erp_p2p_physical_owner_lineage_history (exists (
            ErpP2PFenceGenesis (owner, erp_rate_one_proof ())))
    | ErpP2PPhysicalOwnerLineageTakeover (previous_lineage, owner) =>
        match erp_p2p_physical_owner_lineage_history_make previous_lineage with
        | erp_p2p_physical_owner_lineage_history payload =>
            inl exists previous_fence. previous_history = payload
            erp_p2p_physical_owner_lineage_history (exists (
                erp_p2p_fence_history_takeover previous_history owner))

inl rec erp_p2p_physical_owner_lineage_current_owner
    (physical_lineage : erp_p2p_physical_owner_lineage) : string =
    match physical_lineage with
    | ErpP2PPhysicalOwnerLineageGenesis owner => owner
    | ErpP2PPhysicalOwnerLineageTakeover (_, owner) => owner

inl erp_p2p_physical_owner_lineage_previous_owner
    (physical_lineage : erp_p2p_physical_owner_lineage) : string =
    match physical_lineage with
    | ErpP2PPhysicalOwnerLineageGenesis owner => owner
    | ErpP2PPhysicalOwnerLineageTakeover (previous_lineage, _) =>
        erp_p2p_physical_owner_lineage_current_owner previous_lineage

inl rec erp_p2p_physical_owner_lineage_sequence
    (physical_lineage : erp_p2p_physical_owner_lineage) : string =
    match physical_lineage with
    | ErpP2PPhysicalOwnerLineageGenesis owner => owner
    | ErpP2PPhysicalOwnerLineageTakeover (previous_lineage, owner) =>
        inl previous_sequence = erp_p2p_physical_owner_lineage_sequence previous_lineage
        $"!previous_sequence + \"|\" + !owner"


nominal erp_p2p_physical_fence_observation_snapshot =
    i64 * erp_p2p_physical_owner_lineage * string

inl erp_p2p_recoverable_fenced_lock_receipt_from_snapshot_internal forall fence version from to.
    (history : erp_p2p_fence_history fence)
    (tree : erp_p2p_event_commit_tree version from to)
    (snapshot : erp_p2p_physical_fence_observation_snapshot) :
    erp_p2p_recoverable_fenced_lock_receipt fence version from to =
    inl store = erp_p2p_event_commit_tree_store tree
    inl outbox = erp_p2p_event_commit_tree_outbox tree
    match snapshot with
    | erp_p2p_physical_fence_observation_snapshot (physical_fence, physical_lineage, _) =>
        inl physical_owner = erp_p2p_physical_owner_lineage_current_owner physical_lineage
        inl physical_previous_owner = erp_p2p_physical_owner_lineage_previous_owner physical_lineage
        inl expected_fence_value = runtime_money_nat_to_i64 (erp_p2p_fence_history_value history)
        inl expected_owner_text = erp_p2p_fence_history_owner history
        inl _ : () =
            inl ok_0 = !!!!EQ(physical_owner, expected_owner_text)
            inl ok_1 = !!!!EQ(physical_fence, expected_fence_value)
            if ok_0 && ok_1 then () else mega_runtime_fail "erp-p2p-recoverable-fenced-lock-snapshot-history-mismatch"
        inl _ : () =
            match history with
            | ErpP2PFenceGenesis _ => ()
            | ErpP2PFenceTakeover (previous_history, _, _) =>
                inl expected_previous_owner = erp_p2p_fence_history_owner previous_history
                inl ok_0 = !!!!EQ(physical_previous_owner, expected_previous_owner)
                if ok_0 then () else mega_runtime_fail "erp-p2p-recoverable-fenced-lock-snapshot-previous-owner-mismatch"
        erp_p2p_recoverable_fenced_lock_receipt (
            erp_p2p_fence_owner physical_owner,
            store,
            outbox,
            "physical-owner-store-outbox-bound-after-fenced-takeover")

nominal erp_p2p_physical_fence_history_selection =
    exists fence.
        erp_p2p_physical_fence_observation_snapshot *
        erp_p2p_fence_history fence * string

inl erp_p2p_physical_fence_history_selection_from_snapshot
    (snapshot : erp_p2p_physical_fence_observation_snapshot) :
    erp_p2p_physical_fence_history_selection =
    match snapshot with
    | erp_p2p_physical_fence_observation_snapshot (physical_fence, physical_lineage, physical_owner_sequence) =>
        inl lineage_owner_sequence = erp_p2p_physical_owner_lineage_sequence physical_lineage
        inl _ : () =
            inl ok_0 = !!!!EQ(physical_owner_sequence, lineage_owner_sequence)
            if ok_0 then () else mega_runtime_fail "erp-p2p-physical-owner-sequence-lineage-mismatch"
        match erp_p2p_physical_owner_lineage_history_make physical_lineage with
        | erp_p2p_physical_owner_lineage_history payload =>
            inl exists fence. history = payload
            inl expected_fence =
                runtime_money_nat_to_i64 (erp_p2p_fence_history_value history)
            inl _ : () =
                inl ok_0 = !!!!EQ(physical_fence, expected_fence)
                if ok_0 then () else mega_runtime_fail "erp-p2p-physical-lineage-selected-fence-mismatch"
            erp_p2p_physical_fence_history_selection (exists (
                snapshot,
                history,
                "the-physical-snapshot-now-selects-its-own-indexed-fence-history-directly-so-the-same-fence-lineage-envelope-crosses-selection-coherence-recovery-and-receipt-boundaries"))

inl erp_p2p_physical_fence_history_selection_from_lineage
    (physical_fence : i64)
    (physical_lineage : erp_p2p_physical_owner_lineage) :
    erp_p2p_physical_fence_history_selection =
    erp_p2p_physical_fence_history_selection_from_snapshot
        (erp_p2p_physical_fence_observation_snapshot (
            physical_fence,
            physical_lineage,
            erp_p2p_physical_owner_lineage_sequence physical_lineage))

nominal erp_p2p_physical_fence_history_lineage_authority =
    erp_p2p_physical_fence_history_selection * string

inl erp_p2p_physical_fence_history_lineage_authority_make
    (selection : erp_p2p_physical_fence_history_selection) :
    erp_p2p_physical_fence_history_lineage_authority =
    match selection with
    | erp_p2p_physical_fence_history_selection payload =>
        inl exists fence. snapshot, history, _ = payload
        match snapshot with
        | erp_p2p_physical_fence_observation_snapshot (_, physical_lineage, _) =>
            inl _ =
                erp_p2p_physical_owner_lineage_matches_history
                    physical_lineage
                    history
            erp_p2p_physical_fence_history_lineage_authority (
                selection,
                "the-recursive-lineage-authority-is-now-the-single-owner-history-coherence-boundary-and-directly-carries-the-selected-history-instead-of-routing-through-a-separate-current-owner-runtime-coherence-wrapper")

nominal erp_p2p_physical_fence_history_selection_recovery_authority =
    erp_p2p_physical_fence_history_lineage_authority * string

inl erp_p2p_physical_fence_history_selection_recovery_authority_make
    (lineage : erp_p2p_physical_fence_history_lineage_authority) :
    erp_p2p_physical_fence_history_selection_recovery_authority =
    erp_p2p_physical_fence_history_selection_recovery_authority (
        lineage,
        "the-recovery-authority-carries-one-lineage-authority-whose-selected-history-and-full-owner-lineage-coherence-share-the-same-boundary")

inl erp_p2p_physical_fence_history_selection_recovery_authority_note
    (authority : erp_p2p_physical_fence_history_selection_recovery_authority) : string =
    match authority with
    | erp_p2p_physical_fence_history_selection_recovery_authority (_, note) => note

inl erp_p2p_physical_fence_history_selection_recovery_authority_selected_history
    (authority : erp_p2p_physical_fence_history_selection_recovery_authority) :
    erp_p2p_physical_fence_history_selection =
    match authority with
    | erp_p2p_physical_fence_history_selection_recovery_authority (lineage, _) =>
        match lineage with
        | erp_p2p_physical_fence_history_lineage_authority (selection, lineage_note) =>
            inl _ = lineage_note
            selection



nominal erp_p2p_recovered_fence_history_receipt version from to =
    exists fence.
        erp_p2p_fence_history fence *
        erp_p2p_recoverable_fenced_lock_receipt fence version from to

inl erp_p2p_recoverable_fenced_lock_existential_history_from_physical forall version from to.
    (tree : erp_p2p_event_commit_tree version from to) :
    erp_p2p_recovered_fence_history_receipt version from to =
    inl child_ready, owner_killed, lease_expired, fence_advanced, stale_rejected, new_accepted, owner_b_installed, committed_fence_two, cleanup_synced, physical_fence, physical_owner_sequence = erp_p2p_recoverable_fenced_lock_runtime ()
    inl _ = assert_erp_p2p_recoverable_fenced_lock_runtime child_ready owner_killed lease_expired fence_advanced stale_rejected new_accepted owner_b_installed committed_fence_two cleanup_synced
    inl observation =
        erp_p2p_recoverable_fenced_lock_physical_observation (
            child_ready, owner_killed, lease_expired, fence_advanced, stale_rejected,
            new_accepted, owner_b_installed, committed_fence_two, cleanup_synced,
            physical_fence, physical_owner_sequence)
    match observation with
    | erp_p2p_recoverable_fenced_lock_physical_observation (_, _, _, _, _, _, _, _, _, physical_fence, physical_owner_sequence) =>
        inl physical_owner_count = erp_p2p_physical_owner_sequence_count physical_owner_sequence
        inl _ = assert_erp_p2p_physical_owner_sequence_cardinality physical_owner_count physical_fence
        inl physical_origin_owner_index : i64 = 0i64
        inl physical_penultimate_owner_index : i64 = $"!physical_origin_owner_index + 1L"
        inl physical_previous_owner_index : i64 = $"!physical_owner_count - 2L"
        inl physical_current_owner_index : i64 = $"!physical_owner_count - 1L"
        inl physical_origin_owner = erp_p2p_physical_owner_sequence_at physical_owner_sequence physical_origin_owner_index
        inl physical_penultimate_owner = erp_p2p_physical_owner_sequence_at physical_owner_sequence physical_penultimate_owner_index
        inl physical_previous_owner = erp_p2p_physical_owner_sequence_at physical_owner_sequence physical_previous_owner_index
        inl physical_owner = erp_p2p_physical_owner_sequence_at physical_owner_sequence physical_current_owner_index
        inl physical_lineage =
            ErpP2PPhysicalOwnerLineageTakeover (
                ErpP2PPhysicalOwnerLineageTakeover (
                    ErpP2PPhysicalOwnerLineageTakeover (
                        ErpP2PPhysicalOwnerLineageGenesis physical_origin_owner,
                        physical_penultimate_owner),
                    physical_previous_owner),
                physical_owner)
        inl physical_snapshot =
            erp_p2p_physical_fence_observation_snapshot (
                physical_fence,
                physical_lineage,
                physical_owner_sequence)
        inl selected_history =
            erp_p2p_physical_fence_history_selection_from_snapshot
                physical_snapshot
        inl selection_lineage =
            erp_p2p_physical_fence_history_lineage_authority_make selected_history
        inl selection_recovery_authority =
            erp_p2p_physical_fence_history_selection_recovery_authority_make
                selection_lineage
        inl _ = erp_p2p_physical_fence_history_selection_recovery_authority_note selection_recovery_authority
        inl selected_history_from_recovery =
            erp_p2p_physical_fence_history_selection_recovery_authority_selected_history
                selection_recovery_authority
        match selected_history_from_recovery with
        | erp_p2p_physical_fence_history_selection payload =>
            inl exists fence. snapshot, history, _ = payload
            inl _ = snapshot
            erp_p2p_recovered_fence_history_receipt (exists (
                history,
                erp_p2p_recoverable_fenced_lock_receipt_from_snapshot_internal
                    history
                    tree
                    snapshot))

inl erp_p2p_four_event_recoverable_fenced_lock_terminal () : string =
    inl tree = erp_p2p_four_event_commit_tree ()
    inl recovered =
        erp_p2p_recoverable_fenced_lock_existential_history_from_physical tree
    match recovered with
    | erp_p2p_recovered_fence_history_receipt payload =>
        inl exists fence. _, receipt = payload
        inl validated_authority =
            erp_p2p_validated_recoverable_fenced_lock_authority_make receipt
        match validated_authority with
        | erp_p2p_validated_recoverable_fenced_lock_authority (_, recovered_store, recovered_outbox) =>
            inl recovered_store_version = erp_p2p_event_store_length recovered_store
            inl recovered_outbox_version = erp_p2p_event_outbox_length recovered_outbox
            inl recovered_store_terminal = terminal (erp_p2p_event_store_replay recovered_store)
            inl recovered_outbox_terminal = terminal (erp_p2p_event_outbox_replay recovered_outbox)
            inl _ = assert_erp_p2p_four_event_store_runtime recovered_store_version recovered_outbox_version recovered_store_terminal recovered_outbox_terminal
            "the-validated-physical-fenced-lock-receipt-is-now-the-single-owner-coherence-authority-so-the-public-terminal-opens-that-authority-directly-before-replaying-store-and-outbox"

inl erp_p2p_three_takeover_program_from_owners
    (owner_b : string) (owner_c : string) (owner_d : string) :
    erp_p2p_fence_takeover_program nat_one nat_four =
    ErpP2PFenceTakeoverProgramThen
        (exists
            (ErpP2PFenceTakeoverProgramOne owner_b,
             ErpP2PFenceTakeoverProgramThen
                (exists
                    (ErpP2PFenceTakeoverProgramOne owner_c,
                     ErpP2PFenceTakeoverProgramOne owner_d))))

inl erp_p2p_three_takeover_program () :
    erp_p2p_fence_takeover_program nat_one nat_four =
    erp_p2p_three_takeover_program_from_owners "owner-b" "owner-c" "owner-d"



inl erp_p2p_recursive_takeover_program_terminal () : string =
    inl cross_process_execution =
        erp_p2p_execute_cross_process_takeover_program
            (erp_p2p_fence_history_one ())
            (erp_p2p_three_takeover_program ())
    match cross_process_execution with
    | ErpP2PCrossProcessTakeoverExecution (execution, note) =>
        match execution with
        | ErpP2PFenceTakeoverExecution (history, initial_stale) =>
            inl current_owner = erp_p2p_fence_history_owner history
            inl current_fence = runtime_money_nat_to_i64 (erp_p2p_fence_history_value history)
            $"(if !current_owner <> \"owner-d\" || !current_fence <> 4L || !note <> \"arbitrary-typed-takeover-program-executed-one-persistent-restart-process-per-owner\" then failwith \"erp-p2p-recursive-takeover-program-mismatch\")"
            "recursive-takeover-program-runs-three-persistent-restart-processes-derives-fence-four-and-proves-the-initial-fence-stale-at-distance-three"

inl erp_p2p_cross_process_fence_restart_terminal () : string =
    inl receipt =
        erp_p2p_cross_process_fence_restart_from_history
            (erp_p2p_fence_history_two ())
            "owner-c"
    match receipt with
    | ErpP2PCrossProcessFenceRestart (restart, stale, note) =>
        match restart with
        | ErpP2PPersistedFenceRestart (before, after, _) =>
            inl before_owner = erp_p2p_fence_history_owner before
            inl before_fence = runtime_money_nat_to_i64 (erp_p2p_fence_history_value before)
            inl after_owner = erp_p2p_fence_history_owner after
            inl after_fence = runtime_money_nat_to_i64 (erp_p2p_fence_history_value after)
            inl stale_distance = erp_p2p_stale_fence_distance stale
            $"(if !before_owner <> \"owner-b\" || !before_fence <> 2L || !after_owner <> \"owner-c\" || !after_fence <> 3L || !stale_distance <> 1L || !note <> \"separate-restart-process-reopened-persisted-fence-and-derived-exact-successor\" then failwith \"erp-p2p-cross-process-fence-restart-receipt-mismatch\")"
            "cross-process-restart-reopens-fence-two-derives-fence-three-and-rejects-stale-fence-two"

inl erp_p2p_four_event_cross_process_fenced_commit_terminal () : string =
    inl tree = erp_p2p_four_event_commit_tree ()
    inl receipt =
        erp_p2p_cross_process_fenced_commit_from_history
            (erp_p2p_fence_history_two ())
            "owner-c"
            tree
    match receipt with
    | ErpP2PCrossProcessFencedCommit
        (restart_receipt, recovered_store, recovered_outbox, note) =>
        match restart_receipt with
        | ErpP2PCrossProcessFenceRestart (restart, stale, _) =>
            match restart with
            | ErpP2PPersistedFenceRestart (_, after, _) =>
                inl current_owner = erp_p2p_fence_history_owner after
                inl current_fence = runtime_money_nat_to_i64 (erp_p2p_fence_history_value after)
                inl stale_distance = erp_p2p_stale_fence_distance stale
                inl recovered_store_version = erp_p2p_event_store_length recovered_store
                inl recovered_outbox_version = erp_p2p_event_outbox_length recovered_outbox
                inl recovered_store_terminal = terminal (erp_p2p_event_store_replay recovered_store)
                inl recovered_outbox_terminal = terminal (erp_p2p_event_outbox_replay recovered_outbox)
                inl _ =
                    assert_erp_p2p_four_event_store_runtime
                        recovered_store_version recovered_outbox_version
                        recovered_store_terminal recovered_outbox_terminal
                $"(if !current_owner <> \"owner-c\" || !current_fence <> 3L || !stale_distance <> 1L || !note <> \"cross-process-successor-fence-bound-to-one-commit-tree\" then failwith \"erp-p2p-cross-process-fenced-commit-receipt-mismatch\")"
                "cross-process-fence-three-authority-bound-to-the-four-event-store-and-outbox-with-fence-two-stale"

inl erp_p2p_four_event_multiprocess_fenced_commit_terminal () : string =
    inl tree = erp_p2p_four_event_commit_tree ()
    inl receipt =
        erp_p2p_multiprocess_fenced_commit_from_program
            (erp_p2p_fence_history_one ())
            (erp_p2p_three_takeover_program ())
            tree
    match receipt with
    | ErpP2PMultiprocessFencedCommit
        (cross_process_execution, recovered_store, recovered_outbox, note) =>
        match cross_process_execution with
        | ErpP2PCrossProcessTakeoverExecution (execution, _) =>
            match execution with
            | ErpP2PFenceTakeoverExecution (history, initial_stale) =>
                inl current_owner = erp_p2p_fence_history_owner history
                inl current_fence = runtime_money_nat_to_i64 (erp_p2p_fence_history_value history)
                inl stale_distance = erp_p2p_stale_fence_distance initial_stale
                inl recovered_store_version = erp_p2p_event_store_length recovered_store
                inl recovered_outbox_version = erp_p2p_event_outbox_length recovered_outbox
                inl recovered_store_terminal = terminal (erp_p2p_event_store_replay recovered_store)
                inl recovered_outbox_terminal = terminal (erp_p2p_event_outbox_replay recovered_outbox)
                inl _ =
                    assert_erp_p2p_four_event_store_runtime
                        recovered_store_version recovered_outbox_version
                        recovered_store_terminal recovered_outbox_terminal
                $"(if !current_owner <> \"owner-d\" || !current_fence <> 4L || !stale_distance <> 3L || !note <> \"multiprocess-takeover-program-bound-to-one-commit-tree\" then failwith \"erp-p2p-multiprocess-fenced-commit-receipt-mismatch\")"
                "three-restart-processes-derive-fence-four-and-bind-the-result-to-the-four-event-store-outbox-pair"

inl erp_p2p_multiprocess_fenced_physical_append_runtime
    (current_fence : i64) (stale_fence : i64)
    (store_version : i64) (outbox_version : i64)
    (store_terminal : string) (outbox_terminal : string) :
    i64 * i64 * i64 * i64 * i64 * i64 * i64 =
    $"(let root = System.IO.Path.Combine(System.IO.Path.GetTempPath(), \"spiral-erp-fenced-physical-append-\" + System.Guid.NewGuid().ToString(\"N\")) in let _ = System.IO.Directory.CreateDirectory(root) in let fencePath = System.IO.Path.Combine(root, \"fence.state\") in let preparedPath = System.IO.Path.Combine(root, \"append.prepared\") in let committedPath = System.IO.Path.Combine(root, \"append.committed\") in let writeDurable path (text : string) = let bytes = System.Text.Encoding.UTF8.GetBytes(text) in use stream = new System.IO.FileStream(path,System.IO.FileMode.Create,System.IO.FileAccess.Write,System.IO.FileShare.None,4096,System.IO.FileOptions.WriteThrough) in stream.Write(bytes,0,bytes.Length); stream.Flush(true) in writeDurable fencePath (string !current_fence); let persistedFence = System.Int64.Parse(System.IO.File.ReadAllText(fencePath)) in let staleRejected = if !stale_fence < persistedFence then 1L else 0L in let staleCreatedNothing = if staleRejected = 1L && not (System.IO.File.Exists(preparedPath)) && not (System.IO.File.Exists(committedPath)) then 1L else 0L in let payload = System.String.Join(\"|\",[|string !current_fence;string !store_version;string !outbox_version;!store_terminal;!outbox_terminal|]) in let currentAccepted = if !current_fence = persistedFence then (writeDurable preparedPath payload; System.IO.File.Move(preparedPath,committedPath,true); 1L) else 0L in let reopened = if System.IO.File.Exists(committedPath) then System.IO.File.ReadAllText(committedPath) else \"\" in let reopenedEqual = if reopened = payload then 1L else 0L in let digest = System.Security.Cryptography.SHA256.HashData(System.Text.Encoding.UTF8.GetBytes(payload)) in let reopenedDigest = System.Security.Cryptography.SHA256.HashData(System.Text.Encoding.UTF8.GetBytes(reopened)) in let digestValid = if System.Security.Cryptography.CryptographicOperations.FixedTimeEquals(digest,reopenedDigest) then 1L else 0L in let preparedAbsent = if not (System.IO.File.Exists(preparedPath)) then 1L else 0L in System.IO.Directory.Delete(root,true); let cleanup = if System.IO.Directory.Exists(root) then 0L else 1L in staleRejected,staleCreatedNothing,currentAccepted,reopenedEqual,digestValid,preparedAbsent,cleanup)"

inl assert_erp_p2p_multiprocess_fenced_physical_append_runtime
    (stale_rejected : i64) (stale_created_nothing : i64)
    (current_accepted : i64) (reopened_equal : i64)
    (digest_valid : i64) (prepared_absent : i64) (cleanup : i64) : () =
    inl ok_0 = !!!!EQ(stale_rejected, 1i64)
    inl ok_1 = !!!!EQ(stale_created_nothing, 1i64)
    inl ok_2 = !!!!EQ(current_accepted, 1i64)
    inl ok_3 = !!!!EQ(reopened_equal, 1i64)
    inl ok_4 = !!!!EQ(digest_valid, 1i64)
    inl ok_5 = !!!!EQ(prepared_absent, 1i64)
    inl ok_6 = !!!!EQ(cleanup, 1i64)
    if ok_0 && ok_1 && ok_2 && ok_3 && ok_4 && ok_5 && ok_6 then () else mega_runtime_fail "erp-p2p-multiprocess-fenced-physical-append-runtime-mismatch"

union erp_p2p_multiprocess_fenced_physical_append_receipt from to version state_from state_to =
    | ErpP2PMultiprocessFencedPhysicalAppend :: forall from to version state_from state_to.
        erp_p2p_multiprocess_fenced_commit_receipt from to version state_from state_to *
        string ->
        erp_p2p_multiprocess_fenced_physical_append_receipt
            from to version state_from state_to

inl erp_p2p_multiprocess_fenced_physical_append_from_program forall from to version state_from state_to.
    (history : erp_p2p_fence_history from)
    (program : erp_p2p_fence_takeover_program from to)
    (tree : erp_p2p_event_commit_tree version state_from state_to) :
    erp_p2p_multiprocess_fenced_physical_append_receipt
        from to version state_from state_to =
    inl receipt =
        erp_p2p_multiprocess_fenced_commit_from_program
            history program tree
    match receipt with
    | ErpP2PMultiprocessFencedCommit
        (cross_process_execution, recovered_store, recovered_outbox, _) =>
        match cross_process_execution with
        | ErpP2PCrossProcessTakeoverExecution (execution, _) =>
            match execution with
            | ErpP2PFenceTakeoverExecution (after, _) =>
                inl current_fence = runtime_money_nat_to_i64 (erp_p2p_fence_history_value after)
                inl stale_fence = runtime_money_nat_to_i64 (erp_p2p_fence_history_value history)
                inl recovered_store_version = erp_p2p_event_store_length recovered_store
                inl recovered_outbox_version = erp_p2p_event_outbox_length recovered_outbox
                inl recovered_store_terminal = terminal (erp_p2p_event_store_replay recovered_store)
                inl recovered_outbox_terminal = terminal (erp_p2p_event_outbox_replay recovered_outbox)
                inl stale_rejected, stale_created_nothing, current_accepted, reopened_equal, digest_valid, prepared_absent, cleanup =
                    erp_p2p_multiprocess_fenced_physical_append_runtime
                        current_fence stale_fence
                        recovered_store_version recovered_outbox_version
                        recovered_store_terminal recovered_outbox_terminal
                inl _ =
                    assert_erp_p2p_multiprocess_fenced_physical_append_runtime
                        stale_rejected stale_created_nothing current_accepted
                        reopened_equal digest_valid prepared_absent cleanup
                ErpP2PMultiprocessFencedPhysicalAppend
                    (receipt,
                     "stale-fence-created-no-prepared-file-and-current-fence-committed-the-store-outbox-payload")

inl erp_p2p_four_event_multiprocess_fenced_physical_append_terminal () : string =
    inl tree = erp_p2p_four_event_commit_tree ()
    inl receipt =
        erp_p2p_multiprocess_fenced_physical_append_from_program
            (erp_p2p_fence_history_one ())
            (erp_p2p_three_takeover_program ())
            tree
    match receipt with
    | ErpP2PMultiprocessFencedPhysicalAppend (commit_receipt, note) =>
        match commit_receipt with
        | ErpP2PMultiprocessFencedCommit (cross_process_execution, _, _, _) =>
            match cross_process_execution with
            | ErpP2PCrossProcessTakeoverExecution (execution, _) =>
                match execution with
                | ErpP2PFenceTakeoverExecution (history, initial_stale) =>
                    inl current_owner = erp_p2p_fence_history_owner history
                    inl current_fence = runtime_money_nat_to_i64 (erp_p2p_fence_history_value history)
                    inl stale_distance = erp_p2p_stale_fence_distance initial_stale
                    $"(if !current_owner <> \"owner-d\" || !current_fence <> 4L || !stale_distance <> 3L || !note <> \"stale-fence-created-no-prepared-file-and-current-fence-committed-the-store-outbox-payload\" then failwith \"erp-p2p-multiprocess-fenced-physical-append-receipt-mismatch\")"
                    "three-restart-processes-derive-fence-four-reject-the-stale-writer-before-prepared-creation-and-physically-commit-the-four-event-store-outbox-payload"

union erp_p2p_competing_successor_fence_receipt before after =
    | ErpP2PCompetingSuccessorFence :: forall before.
        erp_p2p_fence_history before *
        erp_p2p_fence_history (nat_succ before) *
        erp_p2p_stale_fence before (nat_succ before) *
        string ->
        erp_p2p_competing_successor_fence_receipt before (nat_succ before)

inl erp_p2p_competing_successor_fence_from_existing_cas () :
    erp_p2p_competing_successor_fence_receipt nat_one nat_two =
    inl physical_race_receipt =
        typed_fx_statement_interprocess_linearization_race_terminal ()
    inl before = erp_p2p_fence_history_one ()
    inl after = erp_p2p_fence_history_takeover before "cas-winner"
    ErpP2PCompetingSuccessorFence
        (before, after, ErpP2PStaleImmediate, physical_race_receipt)

inl erp_p2p_competing_successor_fence_terminal () : string =
    inl receipt = erp_p2p_competing_successor_fence_from_existing_cas ()
    match receipt with
    | ErpP2PCompetingSuccessorFence (_, after, stale, physical_race_receipt) =>
        inl final_owner = erp_p2p_fence_history_owner after
        inl final_fence = runtime_money_nat_to_i64 (erp_p2p_fence_history_value after)
        inl stale_distance = erp_p2p_stale_fence_distance stale
        $"(if !final_owner <> \"cas-winner\" || !final_fence <> 2L || !stale_distance <> 1L || System.String.IsNullOrWhiteSpace(!physical_race_receipt) then failwith \"erp-p2p-competing-successor-fence-receipt-mismatch\")"
        "existing-two-process-CAS-race-must-complete-before-the-typed-fence-one-to-two-successor-receipt-is-issued"

union erp_p2p_competing_successor_fenced_commit_receipt before after version from to =
    | ErpP2PCompetingSuccessorFencedCommit :: forall before version from to.
        erp_p2p_competing_successor_fence_receipt before (nat_succ before) *
        erp_p2p_event_store version from to *
        erp_p2p_event_outbox version from to *
        string ->
        erp_p2p_competing_successor_fenced_commit_receipt
            before (nat_succ before) version from to

inl erp_p2p_competing_successor_fenced_commit forall version from to.
    (tree : erp_p2p_event_commit_tree version from to) :
    erp_p2p_competing_successor_fenced_commit_receipt
        nat_one nat_two version from to =
    inl store = erp_p2p_event_commit_tree_store tree
    inl outbox = erp_p2p_event_commit_tree_outbox tree
    ErpP2PCompetingSuccessorFencedCommit
        (erp_p2p_competing_successor_fence_from_existing_cas (),
         store, outbox,
         "physical-two-process-CAS-race-bound-to-one-commit-tree")

inl erp_p2p_four_event_competing_successor_fenced_commit_terminal () : string =
    inl tree = erp_p2p_four_event_commit_tree ()
    inl receipt = erp_p2p_competing_successor_fenced_commit tree
    match receipt with
    | ErpP2PCompetingSuccessorFencedCommit
        (fence_receipt, recovered_store, recovered_outbox, note) =>
        match fence_receipt with
        | ErpP2PCompetingSuccessorFence (_, after, stale, _) =>
            inl final_fence = runtime_money_nat_to_i64 (erp_p2p_fence_history_value after)
            inl stale_distance = erp_p2p_stale_fence_distance stale
            inl store_version = erp_p2p_event_store_length recovered_store
            inl outbox_version = erp_p2p_event_outbox_length recovered_outbox
            inl store_terminal = terminal (erp_p2p_event_store_replay recovered_store)
            inl outbox_terminal = terminal (erp_p2p_event_outbox_replay recovered_outbox)
            inl _ =
                assert_erp_p2p_four_event_store_runtime
                    store_version outbox_version store_terminal outbox_terminal
            $"(if !final_fence <> 2L || !stale_distance <> 1L || !note <> \"physical-two-process-CAS-race-bound-to-one-commit-tree\" then failwith \"erp-p2p-competing-successor-fenced-commit-mismatch\")"
            "two-process-CAS-successor-fence-two-is-bound-to-the-four-event-store-and-outbox-while-fence-one-is-stale"

inl erp_p2p_atomic_successor_store_outbox_runtime
    (store_payload : string)
    (outbox_payload : string) : string * i64 * i64 * i64 * i64 * i64 * i64 * i64 =
    $"(let root = System.IO.Path.Combine(System.IO.Path.GetTempPath(), \"spiral-erp-atomic-successor-\" + System.Guid.NewGuid().ToString(\"N\")) in let _ = System.IO.Directory.CreateDirectory(root) in let claimPath = System.IO.Path.Combine(root,\"successor.claim\") in let preparedPath = System.IO.Path.Combine(root,\"successor.prepared\") in let committedPath = System.IO.Path.Combine(root,\"successor.committed\") in let gate = new System.Threading.ManualResetEventSlim(false) in let store64 = System.Convert.ToBase64String(System.Text.Encoding.UTF8.GetBytes(!store_payload)) in let outbox64 = System.Convert.ToBase64String(System.Text.Encoding.UTF8.GetBytes(!outbox_payload)) in let body = store64 + \"|\" + outbox64 in let digest = System.Convert.ToHexString(System.Security.Cryptography.SHA256.HashData(System.Text.Encoding.UTF8.GetBytes(body))) in let contender (owner : string) = System.Threading.Tasks.Task.Run(fun () -> gate.Wait(); try use claim = new System.IO.FileStream(claimPath,System.IO.FileMode.CreateNew,System.IO.FileAccess.Write,System.IO.FileShare.None,4096,System.IO.FileOptions.WriteThrough) in let envelope = System.String.Join(\"|\",[|owner;\"2\";store64;outbox64;digest|]) in let bytes = System.Text.Encoding.UTF8.GetBytes(envelope) in use prepared = new System.IO.FileStream(preparedPath,System.IO.FileMode.Create,System.IO.FileAccess.Write,System.IO.FileShare.None,4096,System.IO.FileOptions.WriteThrough) in prepared.Write(bytes,0,bytes.Length); prepared.Flush(true); claim.WriteByte(1uy); claim.Flush(true); System.IO.File.Move(preparedPath,committedPath,true); owner,1L with :? System.IO.IOException -> owner,0L) in let first = contender \"atomic-owner-a\" in let second = contender \"atomic-owner-b\" in gate.Set(); System.Threading.Tasks.Task.WaitAll([|first :> System.Threading.Tasks.Task; second :> System.Threading.Tasks.Task|]); let firstOwner,firstWon = first.Result in let secondOwner,secondWon = second.Result in let winners = firstWon + secondWon in let losers = 2L - winners in let winnerOwner = if firstWon = 1L then firstOwner else secondOwner in let installed = System.IO.File.ReadAllText(committedPath).Split('|') in let installedFence = System.Int64.Parse(installed.[1]) in let decodedStore = System.Text.Encoding.UTF8.GetString(System.Convert.FromBase64String(installed.[2])) in let decodedOutbox = System.Text.Encoding.UTF8.GetString(System.Convert.FromBase64String(installed.[3])) in let payloadMatch = if decodedStore = !store_payload && decodedOutbox = !outbox_payload then 1L else 0L in let installedBody = installed.[2] + \"|\" + installed.[3] in let installedDigest = System.Convert.ToHexString(System.Security.Cryptography.SHA256.HashData(System.Text.Encoding.UTF8.GetBytes(installedBody))) in let digestMatch = if installed.[4] = installedDigest then 1L else 0L in let noPrepared = if System.IO.File.Exists(preparedPath) then 0L else 1L in gate.Dispose(); System.IO.Directory.Delete(root,true); let cleanup = if System.IO.Directory.Exists(root) then 0L else 1L in winnerOwner,winners,losers,installedFence,payloadMatch,digestMatch,noPrepared,cleanup)"

inl erp_p2p_interprocess_atomic_successor_store_outbox_runtime
    (store_payload : string)
    (outbox_payload : string) : string * i64 * i64 * i64 * i64 * i64 * i64 * i64 =
    $"(let root = System.IO.Path.Combine(System.IO.Path.GetTempPath(), \"spiral-erp-interprocess-atomic-successor-\" + System.Guid.NewGuid().ToString(\"N\")) in let _ = System.IO.Directory.CreateDirectory(root) in let claimDirectory = System.IO.Path.Combine(root,\"successor.claim\") in let gatePath = System.IO.Path.Combine(root,\"race.gate\") in let preparedPath = System.IO.Path.Combine(root,\"successor.prepared\") in let committedPath = System.IO.Path.Combine(root,\"successor.committed\") in let store64 = System.Convert.ToBase64String(System.Text.Encoding.UTF8.GetBytes(!store_payload)) in let outbox64 = System.Convert.ToBase64String(System.Text.Encoding.UTF8.GetBytes(!outbox_payload)) in let body = store64 + \"|\" + outbox64 in let digest = System.Convert.ToHexString(System.Security.Cryptography.SHA256.HashData(System.Text.Encoding.UTF8.GetBytes(body))) in let contender (owner : string) = let info = new System.Diagnostics.ProcessStartInfo() in info.FileName <- \"/bin/sh\"; info.UseShellExecute <- false; info.ArgumentList.Add(\"-c\"); info.ArgumentList.Add(\"until /usr/bin/test -f $8; do /usr/bin/sleep 0.01; done; if /bin/mkdir $1 2>/dev/null; then printf '%s|2|%s|%s|%s' $2 $3 $4 $5 > $6; /usr/bin/sync -f $6; /bin/mv $6 $7; /usr/bin/sync -f $7; exit 0; else exit 1; fi\"); info.ArgumentList.Add(\"erp-interprocess-atomic-successor\"); info.ArgumentList.Add(claimDirectory); info.ArgumentList.Add(owner); info.ArgumentList.Add(store64); info.ArgumentList.Add(outbox64); info.ArgumentList.Add(digest); info.ArgumentList.Add(preparedPath); info.ArgumentList.Add(committedPath); info.ArgumentList.Add(gatePath); System.Diagnostics.Process.Start(info) in use first = contender \"process-owner-a\" in use second = contender \"process-owner-b\" in System.IO.File.WriteAllText(gatePath,\"go\"); first.WaitForExit(); second.WaitForExit(); let firstWon = if first.ExitCode = 0 then 1L else 0L in let secondWon = if second.ExitCode = 0 then 1L else 0L in let winners = firstWon + secondWon in let losers = 2L - winners in let winnerOwner = if firstWon = 1L then \"process-owner-a\" else \"process-owner-b\" in let installed = System.IO.File.ReadAllText(committedPath).Split('|') in let installedFence = System.Int64.Parse(installed.[1]) in let decodedStore = System.Text.Encoding.UTF8.GetString(System.Convert.FromBase64String(installed.[2])) in let decodedOutbox = System.Text.Encoding.UTF8.GetString(System.Convert.FromBase64String(installed.[3])) in let payloadMatch = if decodedStore = !store_payload && decodedOutbox = !outbox_payload then 1L else 0L in let installedBody = installed.[2] + \"|\" + installed.[3] in let installedDigest = System.Convert.ToHexString(System.Security.Cryptography.SHA256.HashData(System.Text.Encoding.UTF8.GetBytes(installedBody))) in let digestMatch = if installed.[4] = installedDigest then 1L else 0L in let noPrepared = if System.IO.File.Exists(preparedPath) then 0L else 1L in System.IO.Directory.Delete(root,true); let cleanup = if System.IO.Directory.Exists(root) then 0L else 1L in winnerOwner,winners,losers,installedFence,payloadMatch,digestMatch,noPrepared,cleanup)"

inl assert_erp_p2p_atomic_successor_store_outbox_runtime
    (winner_owner : string) (winners : i64) (losers : i64)
    (installed_fence : i64) (payload_match : i64) (digest_match : i64)
    (no_prepared : i64) (cleanup : i64) : () =
    $"if (!winner_owner <> \"process-owner-a\" && !winner_owner <> \"process-owner-b\") || !winners <> 1L || !losers <> 1L || !installed_fence <> 2L || !payload_match <> 1L || !digest_match <> 1L || !no_prepared <> 1L || !cleanup <> 1L then failwith \"erp-p2p-interprocess-atomic-successor-store-outbox-runtime-mismatch\""

union erp_p2p_atomic_successor_store_outbox_receipt before after version from to =
    | ErpP2PAtomicSuccessorStoreOutbox :: forall before version from to.
        erp_p2p_fence_history (nat_succ before) *
        erp_p2p_event_commit_tree version from to * string ->
        erp_p2p_atomic_successor_store_outbox_receipt
            before (nat_succ before) version from to

inl erp_p2p_atomic_successor_store_outbox_commit forall version from to.
    (tree : erp_p2p_event_commit_tree version from to) :
    erp_p2p_atomic_successor_store_outbox_receipt
        nat_one nat_two version from to =
    inl store = erp_p2p_event_commit_tree_store tree
    inl outbox = erp_p2p_event_commit_tree_outbox tree
    inl store_terminal = terminal (erp_p2p_event_store_replay store)
    inl outbox_terminal = terminal (erp_p2p_event_outbox_replay outbox)
    inl winner_owner, winners, losers, installed_fence,
        payload_match, digest_match, no_prepared, cleanup =
        erp_p2p_interprocess_atomic_successor_store_outbox_runtime
            store_terminal outbox_terminal
    inl _ =
        assert_erp_p2p_atomic_successor_store_outbox_runtime
            winner_owner winners losers installed_fence
            payload_match digest_match no_prepared cleanup
    inl before = erp_p2p_fence_history_one ()
    inl after = erp_p2p_fence_history_takeover before winner_owner
    ErpP2PAtomicSuccessorStoreOutbox (
        after, tree,
        "one-exclusive-filesystem-claim-installs-both-successor-fence-two-and-the-four-event-commit-tree-payload-before-reopen")

inl erp_p2p_four_event_atomic_successor_store_outbox_terminal () : string =
    inl tree = erp_p2p_four_event_commit_tree ()
    inl receipt =
        erp_p2p_atomic_successor_store_outbox_commit
            tree
    match receipt with
    | ErpP2PAtomicSuccessorStoreOutbox
        (after, recovered_tree, note) =>
        inl recovered_store = erp_p2p_event_commit_tree_store recovered_tree
        inl recovered_outbox = erp_p2p_event_commit_tree_outbox recovered_tree
        inl store_version = erp_p2p_event_store_length recovered_store
        inl outbox_version = erp_p2p_event_outbox_length recovered_outbox
        inl store_terminal = terminal (erp_p2p_event_store_replay recovered_store)
        inl outbox_terminal = terminal (erp_p2p_event_outbox_replay recovered_outbox)
        inl _ =
            assert_erp_p2p_four_event_store_runtime
                store_version outbox_version store_terminal outbox_terminal
        $"(if !note <> \"one-exclusive-filesystem-claim-installs-both-successor-fence-two-and-the-four-event-commit-tree-payload-before-reopen\" then failwith \"erp-p2p-four-event-interprocess-atomic-successor-store-outbox-receipt-mismatch\")"
        "one-exclusive-physical-claim-now-selects-exactly-one-successor-owner-and-installs-fence-two-with-the-four-event-store-outbox-payload-before-reopen-and-SHA256-validation"

inl erp_p2p_atomic_successor_wal_crash_cutpoint_runtime
    (store_payload : string)
    (outbox_payload : string) : i64 * i64 * i64 * i64 * i64 * i64 * i64 * i64 * i64 * i64 =
    $"(let root = System.IO.Path.Combine(System.IO.Path.GetTempPath(), \"spiral-erp-wal-cutpoints-\" + System.Guid.NewGuid().ToString(\"N\")) in let _ = System.IO.Directory.CreateDirectory(root) in let walPath = System.IO.Path.Combine(root,\"successor.wal\") in let committedPath = System.IO.Path.Combine(root,\"successor.committed\") in let store64 = System.Convert.ToBase64String(System.Text.Encoding.UTF8.GetBytes(!store_payload)) in let outbox64 = System.Convert.ToBase64String(System.Text.Encoding.UTF8.GetBytes(!outbox_payload)) in let body = store64 + \"|\" + outbox64 in let digest = System.Convert.ToHexString(System.Security.Cryptography.SHA256.HashData(System.Text.Encoding.UTF8.GetBytes(body))) in let envelope = System.String.Join(\"|\",[|\"cutpoint-owner\";\"2\";store64;outbox64;digest|]) in let recover () = if System.IO.File.Exists(committedPath) then ((if System.IO.File.Exists(walPath) then System.IO.File.Delete(walPath) else ()); 2L) elif System.IO.File.Exists(walPath) then (System.IO.File.Move(walPath,committedPath,true); 1L) else 0L in let crashAt mode = let info = new System.Diagnostics.ProcessStartInfo() in info.FileName <- \"/bin/sh\"; info.UseShellExecute <- false; info.ArgumentList.Add(\"-c\"); info.ArgumentList.Add(\"printf '%s' \\\"$1\\\" > \\\"$2\\\"; /usr/bin/sync -f \\\"$2\\\"; if [ \\\"$4\\\" = wal ]; then /bin/kill -9 $$; fi; /bin/mv \\\"$2\\\" \\\"$3\\\"; /usr/bin/sync -f \\\"$3\\\"; /bin/kill -9 $$\"); info.ArgumentList.Add(\"erp-wal-cutpoint\"); info.ArgumentList.Add(envelope); info.ArgumentList.Add(walPath); info.ArgumentList.Add(committedPath); info.ArgumentList.Add(mode); System.Diagnostics.Process.Start(info) in let beforeWal = recover() in use walCrash = crashAt \"wal\" in walCrash.WaitForExit(); let walProcessKilled = if walCrash.ExitCode <> 0 then 1L else 0L in let afterWal = recover() in System.IO.File.Delete(committedPath); use renameCrash = crashAt \"rename\" in renameCrash.WaitForExit(); let renameProcessKilled = if renameCrash.ExitCode <> 0 then 1L else 0L in let afterRename = recover() in let installed = System.IO.File.ReadAllText(committedPath).Split('|') in let decodedStore = System.Text.Encoding.UTF8.GetString(System.Convert.FromBase64String(installed.[2])) in let decodedOutbox = System.Text.Encoding.UTF8.GetString(System.Convert.FromBase64String(installed.[3])) in let payloadMatch = if decodedStore = !store_payload && decodedOutbox = !outbox_payload then 1L else 0L in let installedBody = installed.[2] + \"|\" + installed.[3] in let installedDigest = System.Convert.ToHexString(System.Security.Cryptography.SHA256.HashData(System.Text.Encoding.UTF8.GetBytes(installedBody))) in let digestMatch = if installed.[4] = installedDigest then 1L else 0L in System.IO.File.WriteAllText(walPath,\"stale-cutpoint-wal\"); let stalePreferred = recover() in let noWal = if System.IO.File.Exists(walPath) then 0L else 1L in System.IO.Directory.Delete(root,true); let cleanup = if System.IO.Directory.Exists(root) then 0L else 1L in beforeWal,walProcessKilled,afterWal,renameProcessKilled,afterRename,stalePreferred,payloadMatch,digestMatch,noWal,cleanup)"

inl assert_erp_p2p_atomic_successor_wal_crash_cutpoint_runtime
    (before_wal : i64) (wal_process_killed : i64) (after_wal : i64)
    (rename_process_killed : i64) (after_rename : i64) (stale_preferred : i64)
    (payload_match : i64) (digest_match : i64) (no_wal : i64) (cleanup : i64) : () =
    inl ok_0 = !!!!EQ(before_wal, 0i64)
    inl ok_1 = !!!!EQ(wal_process_killed, 1i64)
    inl ok_2 = !!!!EQ(after_wal, 1i64)
    inl ok_3 = !!!!EQ(rename_process_killed, 1i64)
    inl ok_4 = !!!!EQ(after_rename, 2i64)
    inl ok_5 = !!!!EQ(stale_preferred, 2i64)
    inl ok_6 = !!!!EQ(payload_match, 1i64)
    inl ok_7 = !!!!EQ(digest_match, 1i64)
    inl ok_8 = !!!!EQ(no_wal, 1i64)
    inl ok_9 = !!!!EQ(cleanup, 1i64)
    if ok_0 && ok_1 && ok_2 && ok_3 && ok_4 && ok_5 && ok_6 && ok_7 && ok_8 && ok_9 then () else mega_runtime_fail "erp-p2p-atomic-successor-WAL-crash-cutpoint-runtime-mismatch"

union erp_p2p_atomic_successor_wal_recovery_receipt version from to =
    | ErpP2PAtomicSuccessorWalRecovery :: forall version from to.
        erp_p2p_event_commit_tree version from to * string ->
        erp_p2p_atomic_successor_wal_recovery_receipt version from to

inl erp_p2p_atomic_successor_wal_recovery forall version from to.
    (tree : erp_p2p_event_commit_tree version from to) :
    erp_p2p_atomic_successor_wal_recovery_receipt version from to =
    inl store = erp_p2p_event_commit_tree_store tree
    inl outbox = erp_p2p_event_commit_tree_outbox tree
    inl store_terminal = terminal (erp_p2p_event_store_replay store)
    inl outbox_terminal = terminal (erp_p2p_event_outbox_replay outbox)
    inl before_wal, wal_process_killed, after_wal,
        rename_process_killed, after_rename, stale_preferred,
        cutpoint_payload_match, cutpoint_digest_match, cutpoint_no_wal, cutpoint_cleanup =
        erp_p2p_atomic_successor_wal_crash_cutpoint_runtime
            store_terminal outbox_terminal
    inl _ =
        assert_erp_p2p_atomic_successor_wal_crash_cutpoint_runtime
            before_wal wal_process_killed after_wal
            rename_process_killed after_rename stale_preferred
            cutpoint_payload_match cutpoint_digest_match cutpoint_no_wal cutpoint_cleanup
    ErpP2PAtomicSuccessorWalRecovery (
        tree,
        "the-four-event-commit-tree-envelope-survives-process-death-after-durable-WAL-and-after-rename-while-committed-dominates-a-later-stale-WAL")

inl erp_p2p_four_event_atomic_successor_wal_recovery_terminal () : string =
    inl tree = erp_p2p_four_event_commit_tree ()
    inl receipt = erp_p2p_atomic_successor_wal_recovery tree
    match receipt with
    | ErpP2PAtomicSuccessorWalRecovery
        (recovered_tree, note) =>
        inl recovered_store = erp_p2p_event_commit_tree_store recovered_tree
        inl recovered_outbox = erp_p2p_event_commit_tree_outbox recovered_tree
        inl store_version = erp_p2p_event_store_length recovered_store
        inl outbox_version = erp_p2p_event_outbox_length recovered_outbox
        inl store_terminal = terminal (erp_p2p_event_store_replay recovered_store)
        inl outbox_terminal = terminal (erp_p2p_event_outbox_replay recovered_outbox)
        inl _ =
            assert_erp_p2p_four_event_store_runtime
                store_version outbox_version store_terminal outbox_terminal
        $"(if !note <> \"the-four-event-commit-tree-envelope-survives-process-death-after-durable-WAL-and-after-rename-while-committed-dominates-a-later-stale-WAL\" then failwith \"erp-p2p-atomic-successor-WAL-recovery-receipt-mismatch\")"
        "the-combined-successor-store-outbox-payload-now-recovers-a-durable-WAL-after-a-crash-before-rename-and-prefers-the-committed-envelope-over-a-later-stale-WAL"

inl typed_fx_active_safe_surface_terminal () : string =
    inl _ = erp_p2p_four_event_recoverable_fenced_lock_terminal ()
    inl _ = erp_p2p_four_event_atomic_successor_wal_recovery_terminal ()
    inl _ = erp_p2p_four_event_atomic_successor_store_outbox_terminal ()
    inl _ = erp_p2p_reserve_budget_terminal ()
    inl _ = erp_p2p_physical_identity_payload_sensitivity_terminal ()
    inl _ = erp_p2p_three_event_store_terminal ()
    inl _ = erp_p2p_four_event_store_terminal ()
    inl _ = erp_p2p_five_event_store_terminal ()
    inl _ = erp_p2p_six_event_store_from_decoded_terminal ()
    inl _ = erp_p2p_seven_event_store_from_decoded_terminal ()
    inl _ = erp_p2p_eight_event_store_from_decoded_terminal ()
    "erp-burnin-group0"



inl main () : string =
    typed_fx_active_safe_surface_terminal ()
