inl mega_runtime_fail forall t. (message : string) : t = !!!!FailWith(`t, message)

nominal requisition_drafted = ()
nominal budget_reserved = ()
nominal approvals_collected = ()
nominal purchase_order_issued = ()
nominal goods_partially_received = ()
nominal invoice_three_way_matched = ()
nominal intercompany_netted = ()
nominal payment_settled = ()
nominal period_closed = ()

nominal company_a = string
nominal company_b = string
nominal company_c = string
nominal usd = string
nominal eur = string
nominal brl = string
nominal each = string
nominal widget_a = string
nominal manager = string
nominal finance_director = string
nominal compliance_officer = string
nominal approver_alpha = string
nominal approver_beta = string
nominal approver_gamma = string
nominal period_2026_07 = string
nominal po_1001 = string
nominal payment_3001 = string
nominal warehouse_north = string
nominal tax_brazil = string
nominal ifrs = string
nominal local_gaap = string

nominal money currency scale = currency * scale * i64
nominal quantity item uom = item * uom * i64
union ordered_partial_quantity item uom =
    | OrderedPartialQuantity :: forall item uom.
        quantity item uom * quantity item uom ->
        ordered_partial_quantity item uom

inl assert_ordered_partial_quantity_runtime
    (ordered_amount : i64) (received_amount : i64) : () =
    inl ok_0 = !!!!GT(received_amount, 0i64)
    inl ok_1 = !!!!LTE(received_amount, ordered_amount)
    if ok_0 && ok_1 then () else mega_runtime_fail "ERP-ordered-partial-quantity-invariant-mismatch"

inl validate_ordered_partial_quantity forall item uom.
    (authority : ordered_partial_quantity item uom) : quantity item uom =
    match authority with
    | OrderedPartialQuantity (ordered_quantity, received_quantity) =>
        match ordered_quantity, received_quantity with
        | quantity (_, _, ordered_amount), quantity (_, _, received_amount) =>
            inl _ = assert_ordered_partial_quantity_runtime ordered_amount received_amount
            received_quantity

nominal budget_token entity currency = entity * currency * i64 * string
nominal requisition entity currency item = entity * currency * item * string
nominal approval role participant document = role * participant * document * string
nominal purchase_order entity currency item document = entity * currency * item * document * string
nominal receipt entity currency item location document = entity * currency * item * location * document * i64 * string
nominal tax_witness jurisdiction currency document = jurisdiction * currency * document * i64 * string
nominal erp_p2p_receipt_tax_authority entity currency item location jurisdiction document =
    receipt entity currency item location document * tax_witness jurisdiction currency document
nominal invoice_match entity currency item location jurisdiction document = entity * currency * item * location * jurisdiction * document * string
nominal mirror_entry left right currency document = left * right * currency * document * i64 * string

union opposed_mirror_pair left right currency document =
    | OpposedMirrorPair :: forall left right currency document.
        left * right * currency * document * i64 * string * string ->
        opposed_mirror_pair left right currency document

inl opposed_mirror_pair_left forall left right currency document.
    (pair : opposed_mirror_pair left right currency document) :
    mirror_entry left right currency document =
    match pair with
    | OpposedMirrorPair (left_value, right_value, currency_value, document_value, amount, left_identity, _) =>
        mirror_entry (left_value, right_value, currency_value, document_value, amount, left_identity)

inl opposed_mirror_pair_right forall left right currency document.
    (pair : opposed_mirror_pair left right currency document) :
    mirror_entry right left currency document =
    match pair with
    | OpposedMirrorPair (left_value, right_value, currency_value, document_value, amount, _, right_identity) =>
        mirror_entry (right_value, left_value, currency_value, document_value, $"-1L * !amount", right_identity)

nominal payment_receipt entity currency item location jurisdiction document = entity * currency * item * location * jurisdiction * document * string
nominal close_certificate entity period standard = entity * period * standard * string

union rec settlement_fx_route source target epoch =
    | SettlementFxUsdEurJuly :: i64 * i64 -> settlement_fx_route usd eur period_2026_07
    | SettlementFxEurBrlJuly :: i64 * i64 -> settlement_fx_route eur brl period_2026_07
    | SettlementFxCompose :: forall source target epoch.
        (exists middle.
            settlement_fx_route source middle epoch * settlement_fx_route middle target epoch) ->
        settlement_fx_route source target epoch

nominal settlement_fx_ratio_certificate source target epoch = source * target * epoch * i64 * i64

union distinct3 a b c =
    | Distinct3 :: forall a b c. a * b * c -> distinct3 a b c

union approval_quorum document =
    | ApprovalQuorum :: forall document.
        distinct3
            (approval manager approver_alpha document)
            (approval finance_director approver_beta document)
            (approval compliance_officer approver_gamma document) ->
        approval_quorum document

union gaap_projection event standard result =
    | ProjectIfrs :: forall event result. event * result -> gaap_projection event ifrs result
    | ProjectLocal :: forall event result. event * result -> gaap_projection event local_gaap result

union erp_op from to result =
    | ReserveBudget :: forall entity currency item.
        requisition entity currency item * budget_token entity currency ->
        erp_op requisition_drafted budget_reserved (requisition entity currency item * budget_token entity currency)
    | CollectApprovals :: forall document.
        approval_quorum document ->
        erp_op budget_reserved approvals_collected (approval_quorum document)
    | IssuePurchaseOrder :: forall entity currency item document.
        budget_token entity currency * approval_quorum document * quantity item each *
        purchase_order entity currency item document ->
        erp_op approvals_collected purchase_order_issued (purchase_order entity currency item document)
    | ReceivePartialGoods :: forall entity currency item document location.
        purchase_order entity currency item document * ordered_partial_quantity item each * location * string ->
        erp_op purchase_order_issued goods_partially_received (receipt entity currency item location document)
    | MatchInvoice :: forall entity currency item document location jurisdiction.
        purchase_order entity currency item document * receipt entity currency item location document * tax_witness jurisdiction currency document ->
        erp_op goods_partially_received invoice_three_way_matched (invoice_match entity currency item location jurisdiction document)
    | NetIntercompany :: forall left right currency item location jurisdiction document.
        invoice_match left currency item location jurisdiction document * opposed_mirror_pair left right currency document ->
        erp_op invoice_three_way_matched intercompany_netted (mirror_entry left right currency document * invoice_match left currency item location jurisdiction document)
    | SettlePayment :: forall entity source target item location jurisdiction invoice_document payment_document epoch.
        invoice_match entity source item location jurisdiction invoice_document * money target i64 * settlement_fx_route source target epoch * payment_document ->
        erp_op intercompany_netted payment_settled (payment_receipt entity target item location jurisdiction payment_document * settlement_fx_route source target epoch * invoice_match entity source item location jurisdiction invoice_document)
    | ClosePeriod :: forall entity period standard.
        payment_receipt entity brl widget_a warehouse_north tax_brazil payment_3001 * period * gaap_projection (payment_receipt entity brl widget_a warehouse_north tax_brazil payment_3001) standard string ->
        erp_op payment_settled period_closed (close_certificate entity period standard)

union rec erp_plan from to =
    | ErpStep :: forall from to.
        (exists result. erp_op from to result) -> erp_plan from to
    | ErpThen :: forall from to.
        (exists middle. erp_plan from middle * erp_plan middle to) -> erp_plan from to

inl approval_manager () : approval manager approver_alpha po_1001 =
    approval (manager "manager", approver_alpha "alpha", po_1001 "po-1001", "manager-approved")

inl approval_finance () : approval finance_director approver_beta po_1001 =
    approval (finance_director "finance-director", approver_beta "beta", po_1001 "po-1001", "finance-approved")

inl approval_compliance () : approval compliance_officer approver_gamma po_1001 =
    approval (compliance_officer "compliance-officer", approver_gamma "gamma", po_1001 "po-1001", "compliance-approved")

inl approvals () : approval_quorum po_1001 =
    ApprovalQuorum (Distinct3 (approval_manager (), approval_finance (), approval_compliance ()))

inl erp_runtime_mul_i64 (left : i64) (right : i64) : i64 =
    !!!!Mult(left, right)

inl rec settlement_fx_route_ratio forall source target epoch.
    (route : settlement_fx_route source target epoch) : i64 * i64 =
    match route with
    | SettlementFxUsdEurJuly ratio => ratio
    | SettlementFxEurBrlJuly ratio => ratio
    | SettlementFxCompose payload =>
        inl exists middle. left, right = payload
        inl left_numerator, left_denominator = settlement_fx_route_ratio left
        inl right_numerator, right_denominator = settlement_fx_route_ratio right
        erp_runtime_mul_i64 left_numerator right_numerator,
        erp_runtime_mul_i64 left_denominator right_denominator

inl assert_settlement_fx_route_runtime (numerator : i64) (denominator : i64) : () =
    inl ok_0 = !!!!EQ(numerator, 6i64)
    inl ok_1 = !!!!EQ(denominator, 1i64)
    if ok_0 && ok_1 then () else mega_runtime_fail "canonical-settlement-fx-route-mismatch"

inl rec terminal forall from to. (plan : erp_plan from to) : string =
    match plan with
    | ErpStep payload =>
        inl exists result. op = payload
        match op with
        | ReserveBudget _ => "budget-reserved"
        | CollectApprovals _ => "approvals-collected"
        | IssuePurchaseOrder _ => "purchase-order-issued"
        | ReceivePartialGoods _ => "goods-partially-received"
        | MatchInvoice _ => "invoice-three-way-matched"
        | NetIntercompany _ => "intercompany-netted"
        | SettlePayment (_, _, route, _) =>
            inl numerator, denominator = settlement_fx_route_ratio route
            inl _ = assert_settlement_fx_route_runtime numerator denominator
            "payment-settled-through-composed-typed-fx-route"
        | ClosePeriod _ => "period-closed"
    | ErpThen payload =>
        inl exists middle. _, right = payload
        terminal right

inl erp_runtime_add_i64 (left : i64) (right : i64) : i64 =
    !!!!Add(left, right)

nominal nat_zero = string
nominal nat_succ n = n * string

type nat_one = nat_succ nat_zero
type nat_two = nat_succ nat_one
type nat_three = nat_succ nat_two
type nat_four = nat_succ nat_three
type nat_five = nat_succ nat_four
type nat_six = nat_succ nat_five
type nat_seven = nat_succ nat_six
type nat_eight = nat_succ nat_seven
union rec nat_add left right total =
    | NatAddZero :: forall right. string -> nat_add nat_zero right right
    | NatAddSucc :: forall left right total. nat_add left right total * string -> nat_add (nat_succ left) right (nat_succ total)

inl add_zero_two () : nat_add nat_zero nat_two nat_two = NatAddZero "0+2=2"
inl add_one_two_three () : nat_add nat_one nat_two nat_three = NatAddSucc (add_zero_two (), "1+2=3")
union rec erp_nat_mul left right product =
    | ErpNatMulZero :: forall right. string -> erp_nat_mul nat_zero right nat_zero
    | ErpNatMulSucc :: forall left right product.
        (exists partial.
            erp_nat_mul left right partial *
            nat_add partial right product *
            string) ->
        erp_nat_mul (nat_succ left) right product

inl add_two_two_four_erp () : nat_add nat_two nat_two nat_four =
    NatAddSucc (add_one_two_three (), "2+2=4")

inl erp_mul_zero_two_zero () : erp_nat_mul nat_zero nat_two nat_zero =
    ErpNatMulZero "0*2=0"

inl erp_mul_one_two_two () : erp_nat_mul nat_one nat_two nat_two =
    ErpNatMulSucc (exists (erp_mul_zero_two_zero (), add_zero_two (), "1*2=2"))

inl erp_mul_two_two_four () : erp_nat_mul nat_two nat_two nat_four =
    ErpNatMulSucc (exists (erp_mul_one_two_two (), add_two_two_four_erp (), "2*2=4"))

nominal eur = string
inl v65_add_zero_one () : nat_add nat_zero nat_one nat_one =
    NatAddZero "0+1=1"

inl v65_add_one_one_two () : nat_add nat_one nat_one nat_two =
    NatAddSucc (v65_add_zero_one (), "1+1=2")

inl v65_add_two_one_three () : nat_add nat_two nat_one nat_three =
    NatAddSucc (v65_add_one_one_two (), "2+1=3")

inl v65_add_three_one_four () : nat_add nat_three nat_one nat_four =
    NatAddSucc (v65_add_two_one_three (), "3+1=4")

inl runtime_i64_add (left : i64) (right : i64) : i64 = $"!left + !right"

union rec runtime_money_nat amount =
    | RuntimeMoneyZero :: runtime_money_nat nat_zero
    | RuntimeMoneySucc :: forall amount.
        runtime_money_nat amount ->
        runtime_money_nat (nat_succ amount)

inl rec runtime_money_nat_to_i64 forall amount.
    (proof : runtime_money_nat amount) : i64 =
    match proof with
    | RuntimeMoneyZero => 0i64
    | RuntimeMoneySucc previous => runtime_i64_add (runtime_money_nat_to_i64 previous) 1i64

inl rec runtime_money_nat_add forall left right total.
    (sum : nat_add left right total)
    (left_value : runtime_money_nat left)
    (right_value : runtime_money_nat right) : runtime_money_nat total =
    match sum with
    | NatAddZero _ => right_value
    | NatAddSucc (previous_sum, _) =>
        match left_value with
        | RuntimeMoneySucc previous_left =>
            RuntimeMoneySucc (
                runtime_money_nat_add previous_sum previous_left right_value)

union fx_currency currency =
    | FxUsd :: fx_currency usd
    | FxEur :: fx_currency eur
    | FxBrl :: fx_currency brl

nominal fx_rate_product left right = left * right

union rec typed_fx_rate source target numerator denominator =
    | TypedFxRateDirect :: forall source target numerator denominator.
        fx_currency source *
        fx_currency target *
        runtime_money_nat numerator *
        runtime_money_nat denominator ->
        typed_fx_rate source target numerator denominator
    | TypedFxRateCompose :: forall source target left_num left_den right_num right_den.
        (exists middle.
            typed_fx_rate source middle left_num left_den *
            typed_fx_rate middle target right_num right_den) ->
        typed_fx_rate source target
            (fx_rate_product left_num right_num)
            (fx_rate_product left_den right_den)
    | TypedFxRateInverse :: forall source target numerator denominator.
        typed_fx_rate source target numerator denominator ->
        typed_fx_rate target source denominator numerator

type erp_rate_one = nat_succ nat_zero
type erp_rate_two = nat_succ erp_rate_one
type erp_rate_three = nat_succ erp_rate_two

inl erp_rate_one_proof () : runtime_money_nat erp_rate_one =
    RuntimeMoneySucc RuntimeMoneyZero

inl erp_rate_two_proof () : runtime_money_nat erp_rate_two =
    RuntimeMoneySucc (erp_rate_one_proof ())

inl erp_rate_three_proof () : runtime_money_nat erp_rate_three =
    RuntimeMoneySucc (erp_rate_two_proof ())

type erp_rate_four = nat_succ erp_rate_three
type erp_rate_five = nat_succ erp_rate_four
type erp_rate_six = nat_succ erp_rate_five

inl erp_rate_four_proof () : runtime_money_nat erp_rate_four =
    RuntimeMoneySucc (erp_rate_three_proof ())

inl erp_rate_five_proof () : runtime_money_nat erp_rate_five =
    RuntimeMoneySucc (erp_rate_four_proof ())

inl runtime_add_i64 (left : i64) (right : i64) : i64 =
    !!!!Add(left, right)

type erp_rate_seven = nat_succ erp_rate_six

inl erp_add_zero_three_three () : nat_add nat_zero erp_rate_three erp_rate_three =
    NatAddZero "0+3=3"

inl erp_add_one_three_four () : nat_add erp_rate_one erp_rate_three erp_rate_four =
    NatAddSucc (erp_add_zero_three_three (), "1+3=4")

inl erp_add_two_three_five () : nat_add erp_rate_two erp_rate_three erp_rate_five =
    NatAddSucc (erp_add_one_three_four (), "2+3=5")

inl erp_add_three_three_six () : nat_add erp_rate_three erp_rate_three erp_rate_six =
    NatAddSucc (erp_add_two_three_five (), "3+3=6")

inl erp_mul_zero_three_zero () : erp_nat_mul nat_zero erp_rate_three nat_zero =
    ErpNatMulZero "0*3=0"

inl erp_mul_one_three_three () : erp_nat_mul erp_rate_one erp_rate_three erp_rate_three =
    ErpNatMulSucc (exists (
        erp_mul_zero_three_zero (),
        erp_add_zero_three_three (),
        "1*3=3"))

inl erp_mul_two_three_six () : erp_nat_mul erp_rate_two erp_rate_three erp_rate_six =
    ErpNatMulSucc (exists (
        erp_mul_one_three_three (),
        erp_add_three_three_six (),
        "2*3=6"))

type erp_rate_eight = nat_succ erp_rate_seven
type erp_rate_nine = nat_succ erp_rate_eight

inl erp_add_four_three_seven () :
    nat_add erp_rate_four erp_rate_three erp_rate_seven =
    NatAddSucc (erp_add_three_three_six (), "4+3=7")

inl erp_add_five_three_eight () :
    nat_add erp_rate_five erp_rate_three erp_rate_eight =
    NatAddSucc (erp_add_four_three_seven (), "5+3=8")

inl erp_add_six_three_nine () :
    nat_add erp_rate_six erp_rate_three erp_rate_nine =
    NatAddSucc (erp_add_five_three_eight (), "6+3=9")

inl erp_mul_three_three_nine () :
    erp_nat_mul erp_rate_three erp_rate_three erp_rate_nine =
    ErpNatMulSucc (exists (
        erp_mul_two_three_six (),
        erp_add_six_three_nine (),
        "3*3=9"))

inl erp_add_three_two_five () :
    nat_add erp_rate_three erp_rate_two erp_rate_five =
    NatAddSucc (add_two_two_four_erp (), "3+2=5")

inl erp_add_four_two_six () :
    nat_add erp_rate_four erp_rate_two erp_rate_six =
    NatAddSucc (erp_add_three_two_five (), "4+2=6")

inl erp_mul_three_two_six () :
    erp_nat_mul erp_rate_three erp_rate_two erp_rate_six =
    ErpNatMulSucc (exists (
        erp_mul_two_two_four (),
        erp_add_four_two_six (),
        "3*2=6"))

inl erp_add_five_two_seven () :
    nat_add erp_rate_five erp_rate_two erp_rate_seven =
    NatAddSucc (erp_add_four_two_six (), "5+2=7")

inl erp_add_six_two_eight () :
    nat_add erp_rate_six erp_rate_two erp_rate_eight =
    NatAddSucc (erp_add_five_two_seven (), "6+2=8")

inl erp_mul_four_two_eight () :
    erp_nat_mul erp_rate_four erp_rate_two erp_rate_eight =
    ErpNatMulSucc (exists (
        erp_mul_three_two_six (),
        erp_add_six_two_eight (),
        "4*2=8"))

inl erp_add_eight_one_nine () :
    nat_add erp_rate_eight erp_rate_one erp_rate_nine =
    NatAddSucc (
        NatAddSucc (
            NatAddSucc (
                NatAddSucc (
                    NatAddSucc (
                        NatAddSucc (
                            NatAddSucc (
                                NatAddSucc (
                                    NatAddZero "0+1=1",
                                    "1+1=2"),
                                "2+1=3"),
                            "3+1=4"),
                        "4+1=5"),
                    "5+1=6"),
                "6+1=7"),
            "7+1=8"),
        "8+1=9")

union rec erp_nat_lt left right =
    | ErpNatLtZeroSucc :: forall right.
        string -> erp_nat_lt nat_zero (nat_succ right)
    | ErpNatLtSucc :: forall left right.
        erp_nat_lt left right * string ->
        erp_nat_lt (nat_succ left) (nat_succ right)

inl erp_one_lt_two () : erp_nat_lt erp_rate_one erp_rate_two =
    ErpNatLtSucc (
        ErpNatLtZeroSucc "0<1",
        "1<2")

union typed_fx_fractional_floor_step_equation
    source target input numerator denominator quotient remainder product scaled =
    | TypedFxFractionalFloorStepEquation ::
        forall source target input numerator denominator quotient remainder product scaled.
        typed_fx_rate source target numerator denominator *
        erp_nat_mul input numerator product *
        erp_nat_mul quotient denominator scaled *
        nat_add scaled remainder product *
        erp_nat_lt remainder denominator *
        runtime_money_nat input *
        runtime_money_nat numerator *
        runtime_money_nat denominator *
        runtime_money_nat quotient *
        runtime_money_nat remainder ->
        typed_fx_fractional_floor_step_equation
            source target input numerator denominator quotient remainder product scaled

inl typed_usd_eur_fractional_floor_equation () :
    typed_fx_fractional_floor_step_equation
        usd eur erp_rate_three erp_rate_three erp_rate_two
        erp_rate_four erp_rate_one erp_rate_nine erp_rate_eight =
    TypedFxFractionalFloorStepEquation (
        TypedFxRateDirect (
            FxUsd,
            FxEur,
            erp_rate_three_proof (),
            erp_rate_two_proof ()),
        erp_mul_three_three_nine (),
        erp_mul_four_two_eight (),
        erp_add_eight_one_nine (),
        erp_one_lt_two (),
        erp_rate_three_proof (),
        erp_rate_three_proof (),
        erp_rate_two_proof (),
        erp_rate_four_proof (),
        erp_rate_one_proof ())

inl typed_fx_fractional_floor_step_runtime
    forall source target input numerator denominator quotient remainder product scaled.
    (equation : typed_fx_fractional_floor_step_equation source target input numerator denominator quotient remainder product scaled)
    : i64 * i64 * i64 * i64 * i64 * i64 =
    match equation with
    | TypedFxFractionalFloorStepEquation (
        _, _, _, _, _, input_value, numerator_value, denominator_value,
        quotient_value, remainder_value) =>
        inl input_runtime = runtime_money_nat_to_i64 input_value
        inl numerator_runtime = runtime_money_nat_to_i64 numerator_value
        inl denominator_runtime = runtime_money_nat_to_i64 denominator_value
        inl quotient_runtime = runtime_money_nat_to_i64 quotient_value
        inl remainder_runtime = runtime_money_nat_to_i64 remainder_value
        input_runtime,
        numerator_runtime,
        denominator_runtime,
        quotient_runtime,
        remainder_runtime,
        erp_runtime_mul_i64 input_runtime numerator_runtime

inl erp_add_four_one_five () : nat_add erp_rate_four erp_rate_one erp_rate_five =
    NatAddSucc (
        v65_add_three_one_four (),
        "4+1=5")

union typed_fx_fractional_half_up_rounding_decision
    source target input numerator denominator quotient remainder product scaled rounded adjustment =
    | TypedFxFractionalHalfUpRoundingDecision ::
        forall source target input numerator denominator quotient remainder product scaled rounded adjustment.
        typed_fx_fractional_floor_step_equation
            source target input numerator denominator quotient remainder product scaled *
        nat_add remainder remainder denominator *
        nat_add quotient erp_rate_one rounded *
        runtime_money_nat rounded *
        runtime_money_nat adjustment * string ->
        typed_fx_fractional_half_up_rounding_decision
            source target input numerator denominator quotient remainder product scaled rounded adjustment

inl typed_usd_eur_fractional_half_up_rounding_decision () :
    typed_fx_fractional_half_up_rounding_decision
        usd eur erp_rate_three erp_rate_three erp_rate_two
        erp_rate_four erp_rate_one erp_rate_nine erp_rate_eight
        erp_rate_five erp_rate_one =
    TypedFxFractionalHalfUpRoundingDecision (
        typed_usd_eur_fractional_floor_equation (),
        v65_add_one_one_two (),
        erp_add_four_one_five (),
        erp_rate_five_proof (),
        erp_rate_one_proof (),
        "an-exact-half-remainder-rounds-away-from-zero-by-one-unit")

inl typed_fx_fractional_half_up_rounding_runtime
    forall source target input numerator denominator quotient remainder product scaled rounded adjustment.
    (decision :
        typed_fx_fractional_half_up_rounding_decision
            source target input numerator denominator quotient remainder product scaled rounded adjustment)
    : i64 * i64 * i64 * i64 * i64 * i64 =
    match decision with
    | TypedFxFractionalHalfUpRoundingDecision (
        equation, _, _, rounded_value, adjustment_value, _) =>
        inl _, _, denominator, quotient, remainder, _ =
            typed_fx_fractional_floor_step_runtime equation
        denominator,
        quotient,
        remainder,
        runtime_money_nat_to_i64 rounded_value,
        runtime_money_nat_to_i64 adjustment_value,
        erp_runtime_add_i64 remainder remainder

union typed_fx_fractional_half_even_rounding_decision
    source target input numerator denominator quotient remainder product scaled rounded =
    | TypedFxFractionalHalfEvenRoundingDecision ::
        forall source target input numerator denominator quotient remainder product scaled.
        typed_fx_fractional_floor_step_equation
            source target input numerator denominator quotient remainder product scaled *
        nat_add remainder remainder denominator *
        erp_nat_mul erp_rate_two erp_rate_two quotient *
        runtime_money_nat quotient * string ->
