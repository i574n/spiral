:= ^ typed_fx_determined_rounding_receipt_program_runtime
    (program : typed_fx_determined_rounding_receipt_program)
    : i64 * i64 * i64 * i64 * i64 =
    ?= program ?|
    | TypedFxDeterminedRoundingReceiptProgramDone =>
        0i64, 0i64, 0i64, 0i64, 0i64
    | TypedFxDeterminedRoundingReceiptProgramMore (head, tail, _) =>
        := cells, floor, output, mismatch =
            ?= head ?|
            | ExistentialTypedFxDeterminedRoundingReceipt payload =>
                := \? entity source target input numerator denominator quotient remainder product scaled output.
                    receipt, _ = payload
                := cell, mode, output_runtime, mismatch_runtime =
                    typed_fx_determined_rounding_receipt_runtime receipt
                cell,
                $"if !mode = 0L then 1L else 0L",
                output_runtime,
                mismatch_runtime
        := tail_cells, tail_floor, tail_ceiling,
            tail_outputs, tail_mismatches =
            typed_fx_determined_rounding_receipt_program_runtime tail
        runtime_add_i64 cells tail_cells,
        runtime_add_i64 floor tail_floor,
        runtime_add_i64 ($"if !floor = 0L then 1L else 0L") tail_ceiling,
        runtime_add_i64 output tail_outputs,
        runtime_add_i64 mismatch tail_mismatches

:= assert_typed_fx_determined_rounding_receipt_program_runtime
    (cells : i64) (floors : i64) (ceilings : i64)
    (outputs : i64) (mismatches : i64)
    : ()
    =
    := ok_0 = !!!!EQ(cells, 3i64)
    := ok_1 = !!!!EQ(floors, 1i64)
    := ok_2 = !!!!EQ(ceilings, 2i64)
    := ok_3 = !!!!EQ(outputs, 10i64)
    := ok_4 = !!!!EQ(mismatches, 0i64)
    ? ok_0 && ok_1 && ok_2 && ok_3 && ok_4
    ?> ()
    |: mega_runtime_fail "typed-FX-determined-rounding-receipt-program-runtime-mismatch"

:= typed_fx_determined_rounding_receipt_program_terminal () : string =
    := cells, floors, ceilings, outputs, mismatches =
        typed_fx_determined_rounding_receipt_program_runtime
            (typed_fx_determined_rounding_receipt_program_value ())
    := _ =
        assert_typed_fx_determined_rounding_receipt_program_runtime
            cells floors ceilings outputs mismatches
    "one-active-ERP-consumer-now-accepts-only-policy-indexed-determined-rounding-steps-and-derives-the-output-witne"
    ^^ "ss-inside-the-receipt-so-three-entity-receipts-preserve-floor-exact-ceiling-and-positive-ceiling-outputs-with-"
    ^^ "zero-consumer-step-mismatches-sealed"

