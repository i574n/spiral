        System.Text.Encoding.UTF8.GetBytes(stalePayload) in (use stream = new System.IO.FileStream(committed, \
        System.IO.FileMode.CreateNew, System.IO.FileAccess.Write, System.IO.FileShare.None, 4096, \
        System.IO.FileOptions.WriteThrough) in stream.Write(oldBytes, 0, oldBytes.Length); stream.Flush(true)); let \
        expectedDigest = System.Security.Cryptography.SHA256.HashData(oldBytes) in let tryCas prepared payload \
        expected = let current = System.IO.File.ReadAllBytes(committed) in let currentDigest = \
