:| typed_fx_hashed_statement_closed_recorded_hash_fact =
    | TypedFxHashedStatementClosedRecordedHashPrimary
    | TypedFxHashedStatementClosedRecordedHashChanged ::
        typed_fx_statement_payload_hash_not_equal
            typed_fx_statement_payload_hash_changed
            typed_fx_statement_payload_hash_primary ->
        typed_fx_hashed_statement_closed_recorded_hash_fact

:| typed_fx_hashed_statement_closed_position_fact history position =
    | TypedFxHashedStatementClosedPositionFactEmptyAtZero ::
        typed_fx_statement_expected_stream_position
            typed_fx_statement_stream_position_zero
            typed_fx_statement_stream_position_zero ->
        typed_fx_hashed_statement_closed_position_fact
            typed_fx_hashed_statement_history_empty
            typed_fx_statement_stream_position_zero
    | TypedFxHashedStatementClosedPositionFactRecordedPrimaryAtStaleZero ::
        typed_fx_statement_stream_position_not_equal
            typed_fx_statement_stream_position_zero
