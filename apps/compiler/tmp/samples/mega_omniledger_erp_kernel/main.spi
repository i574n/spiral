:! typed_fx_statement_aggregate_identity_primary = string
:! typed_fx_statement_payload_hash_primary = string
:! typed_fx_statement_payload_hash_changed = string

:| typed_fx_statement_payload_hash_not_equal left right =
    | TypedFxStatementPayloadHashPrimaryChanged ::
        string ->
        typed_fx_statement_payload_hash_not_equal
            typed_fx_statement_payload_hash_changed
