:= ^ append_typed_fx_statement_stale_writer_conflict_program
    (left : typed_fx_statement_stale_writer_conflict_program)
    (right : typed_fx_statement_stale_writer_conflict_program)
    : typed_fx_statement_stale_writer_conflict_program =
    ?= left ?|
    | TypedFxStatementStaleWriterConflictDone => right
    | TypedFxStatementStaleWriterConflictMore payload =>
        := \? command_identity. command, conflict, tail, note = payload
        TypedFxStatementStaleWriterConflictMore (\? (
            command,
            conflict,
            append_typed_fx_statement_stale_writer_conflict_program tail right,
            note))

