    inl ok_0 = !!!!EQ(direct_lookups, term_0)
    inl term_1 = !!!!Add(left_depth, right_depth)
    inl ok_1 = !!!!EQ(direct_depth, term_1)
    inl term_2 = !!!!Add(left_statements, right_statements)
    inl ok_2 = !!!!EQ(direct_statements, term_2)
    inl term_3 = !!!!Add(left_debit, right_debit)
    inl ok_3 = !!!!EQ(direct_debit, term_3)
    inl term_4 = !!!!Add(left_credit, right_credit)
    inl ok_4 = !!!!EQ(direct_credit, term_4)
    inl term_5 = !!!!Add(left_mismatch, right_mismatch)
    inl ok_5 = !!!!EQ(direct_mismatch, term_5)
    if ok_0 && ok_1 && ok_2 && ok_3 && ok_4 && ok_5 then () else mega_runtime_fail "typed-FX-hashed-statement-membership-lookup-program-append-runtime-mismatch"

