        location_value, received_amount, receipt_identity, jurisdiction_value, tax_amount, tax_identity =
        erp_match_invoice_payload_decode_fields_runtime encoded
    inl purchase_order_value : purchase_order company_a usd widget_a po_1001 =
        purchase_order (company_a entity_value, usd currency_value, widget_a item_value, po_1001 document_value, purchase_order_identity)
    inl receipt_value : receipt company_a usd widget_a warehouse_north po_1001 =
        receipt (company_a entity_value, usd currency_value, widget_a item_value, warehouse_north location_value, po_1001 document_value, received_amount, receipt_identity)
    inl tax_value : tax_witness tax_brazil usd po_1001 =
        tax_witness (tax_brazil jurisdiction_value, usd currency_value, po_1001 document_value, tax_amount, tax_identity)
    MatchInvoice (purchase_order_value, receipt_value, tax_value)

