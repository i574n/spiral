union typed_fx_determined_rounding_step
    source target input numerator denominator quotient remainder product scaled output =
    | TypedFxDeterminedFloorStep ::
        forall source target input numerator denominator quotient remainder product scaled.
        typed_fx_fractional_floor_step_equation
            source target input numerator denominator quotient remainder product scaled *
        runtime_money_nat quotient ->
        typed_fx_determined_rounding_step
            source target input numerator denominator quotient remainder product scaled quotient
    | TypedFxDeterminedCeilingStep ::
        forall source target input numerator denominator quotient remainder
            product scaled rounded.
        (exists adjustment.
            typed_fx_fractional_safe_ceiling_decision
                source target input numerator denominator quotient remainder
                product scaled rounded adjustment) ->
        typed_fx_determined_rounding_step
            source target input numerator denominator quotient remainder
            product scaled rounded

