:= erp_settle_payment_typed_decode_authority_from_bytes (encoded : string) :
    erp_settle_payment_typed_decode_authority =
    ?= erp_settle_payment_payload_typed_decode encoded ?|
    | ErpSettlePaymentPayloadTypedDecoded certificate =>
        := reencoded = erp_settle_payment_payload_typed_certificate_frame certificate
        := _ = assert_erp_settle_payment_payload_typed_decode_roundtrip_runtime encoded reencoded
        ErpSettlePaymentTypedDecodeAuthority (encoded, certificate, reencoded)
    | ErpSettlePaymentPayloadTypedRejected _ =>
        mega_runtime_fail "disk-reopened-SettlePayment-payload-could-not-produce-a-typed-authority"

:= erp_settle_payment_payload_codec_terminal () : string =
    := operation = erp_p2p_settle_payment_from_decoded_net (erp_p2p_net_intercompany_op ())
    := encoded = erp_settle_payment_operation_payload_frame operation
    := accepted = erp_settle_payment_payload_decode encoded
    := truncated : string = $"if !encoded.Length > 4 then !encoded.Substring(0, !encoded.Length - 4) else \"\""
    := rejected = erp_settle_payment_payload_decode truncated
    := accepted_tag = erp_settle_payment_payload_decode_tag accepted
    := rejected_tag = erp_settle_payment_payload_decode_tag rejected
    := _ =
        assert_erp_settle_payment_payload_codec_runtime accepted_tag (
            erp_runtime_add_i64 1i64 (erp_runtime_mul_i64 -1i64 rejected_tag)
        )
    := typed_decoded = erp_settle_payment_payload_typed_decode encoded
    := typed_rejected = erp_settle_payment_payload_typed_decode truncated
    := typed_accepted_tag = erp_settle_payment_payload_typed_decode_tag typed_decoded
    := typed_rejected_tag = erp_settle_payment_payload_typed_decode_tag typed_rejected
    := typed_roundtrip_tag = erp_settle_payment_payload_typed_roundtrip_tag encoded typed_decoded
    := _ =
        ?= typed_decoded ?|
        | ErpSettlePaymentPayloadTypedDecoded certificate =>
            := typed_numerator, typed_denominator =
                erp_settle_payment_payload_typed_certificate_ratio certificate
            := operation_numerator, operation_denominator =
                erp_settle_payment_operation_route_ratio operation
            assert_erp_settle_payment_typed_ratio_matches_operation_runtime
                typed_numerator typed_denominator operation_numerator operation_denominator
        | ErpSettlePaymentPayloadTypedRejected _ =>
            mega_runtime_fail "canonical-SettlePayment-frame-could-not-produce-the-typed-FX-ratio-certificate"
    := _ =
        assert_erp_settle_payment_payload_codec_runtime typed_accepted_tag (
            erp_runtime_add_i64 1i64 (erp_runtime_mul_i64 -1i64 typed_rejected_tag)
        )
    := _ =
        assert_erp_settle_payment_payload_codec_runtime typed_roundtrip_tag (
            erp_runtime_add_i64 1i64 (erp_runtime_mul_i64 -1i64 typed_rejected_tag)
        )
    "SettlePayment tagged frame now crosses the runtime boundary as stable typed invoice-money-payment-document "
    ^^ "evidence-and-that-stable-evidence-rebuilds-the-byte-identical-canonical-fifteen-field-frame-while-the-existent"
    ^^ "ial-FX-route-remains-on-the-compile-time-side-of-the-authority-boundary"

:= erp_close_period_operation_payload_frame \* result.
    (operation : erp_op payment_settled period_closed result) : string =
    ?= operation ?|
    | ClosePeriod (payment_value, period_value, projection) =>
        ?= payment_value ?|
        | payment_receipt
            (entity_value, currency_value, item_value, location_value,
             jurisdiction_value, document_value, receipt_identity) =>
            ?= projection ?|
            | ProjectIfrs (_, projection_result) =>
                $"(let fields = [| !entity_value; !currency_value; !item_value; !location_value; !jurisdiction_value; \
                    !document_value; !receipt_identity; !period_value; \"IFRS\"; !projection_result |] in let bytes = \
                    fields |> Array.collect (fun value -> let payload = System.Text.Encoding.UTF8.GetBytes(value) in \
                    let length = System.BitConverter.GetBytes(System.Net.IPAddress.HostToNetworkOrder(payload.Length)) \
                    in Array.append length payload) in System.Convert.ToBase64String(bytes))"
            | ProjectLocal (_, projection_result) =>
                $"(let fields = [| !entity_value; !currency_value; !item_value; !location_value; !jurisdiction_value; \
                    !document_value; !receipt_identity; !period_value; \"LOCAL-GAAP\"; !projection_result |] in let \
                    bytes = fields |> Array.collect (fun value -> let payload = \
                    System.Text.Encoding.UTF8.GetBytes(value) in let length = \
                    System.BitConverter.GetBytes(System.Net.IPAddress.HostToNetworkOrder(payload.Length)) in \
                    Array.append length payload) in System.Convert.ToBase64String(bytes))"

:= erp_close_period_payload_codec_runtime (encoded : string) :
    i64 * i64 * i64 * i64 * i64 * i64 =
    $"(let tryDecode (text : string) = try let bytes = System.Convert.FromBase64String(text) in let mutable offset = \
        0 in let fields = System.Collections.Generic.List<string>() in let mutable valid = true in while valid && \
        offset < bytes.Length do if offset + 4 > bytes.Length then valid <- false else let raw = \
        System.BitConverter.ToInt32(bytes, offset) |> System.Net.IPAddress.NetworkToHostOrder in offset <- offset + \
        4; if raw < 0 || offset + raw > bytes.Length then valid <- false else \
        fields.Add(System.Text.Encoding.UTF8.GetString(bytes, offset, raw)); offset <- offset + raw done; if valid && \
        offset = bytes.Length then Some(fields.ToArray()) else None with _ -> None in let decoded = tryDecode \
        !encoded in let fieldCount = match decoded with Some fields -> int64 fields.Length | None -> 0L in let \
        paymentBound = match decoded with Some fields when fields.Length = 10 && fields.[0] = \"company-a\" && \
        fields.[1] = \"BRL\" && fields.[2] = \"widget-a\" && fields.[3] = \"warehouse-north\" && fields.[4] = \"BR\" \
        && fields.[5] = \"payment-3001\" && fields.[6] = \"payment-receipt-3001\" -> 1L | _ -> 0L in let periodBound \
        = match decoded with Some fields when fields.Length = 10 && fields.[7] = \"2026-07\" -> 1L | _ -> 0L in let \
        gaapBound = match decoded with Some fields when fields.Length = 10 && fields.[8] = \"IFRS\" && fields.[9] = \
        \"ifrs-close-2026-07\" -> 1L | _ -> 0L in let reencode (fields : string array) = fields |> Array.collect (fun \
        value -> let payload = System.Text.Encoding.UTF8.GetBytes(value) in let length = \
        System.BitConverter.GetBytes(System.Net.IPAddress.HostToNetworkOrder(payload.Length)) in Array.append length \
        payload) |> System.Convert.ToBase64String in let roundtrip = match decoded with Some fields when reencode \
        fields = !encoded -> 1L | _ -> 0L in let truncated = if !encoded.Length > 4 then !encoded.Substring(0, \
        !encoded.Length - 4) else \"\" in let tamperRejected = match tryDecode truncated with None -> 1L | Some _ -> \
        0L in fieldCount,paymentBound,periodBound,gaapBound,roundtrip,tamperRejected)"

:= assert_erp_close_period_payload_codec_runtime
    (field_count : i64) (payment_bound : i64) (period_bound : i64)
    (gaap_bound : i64) (roundtrip : i64) (tamper_rejected : i64)
    : ()
    =
    := ok_0 = !!!!EQ(field_count, 10i64)
    := ok_1 = !!!!EQ(payment_bound, 1i64)
    := ok_2 = !!!!EQ(period_bound, 1i64)
    := ok_3 = !!!!EQ(gaap_bound, 1i64)
    := ok_4 = !!!!EQ(roundtrip, 1i64)
    := ok_5 = !!!!EQ(tamper_rejected, 1i64)
    ? ok_0 && ok_1 && ok_2 && ok_3 && ok_4 && ok_5
    ?> ()
    |: mega_runtime_fail "erp-ClosePeriod-payload-codec-runtime-mismatch"

:= erp_close_period_payload_codec_terminal () : string =
    := encoded = erp_close_period_operation_payload_frame (erp_p2p_close_period_op ())
    := field_count, payment_bound, period_bound, gaap_bound, roundtrip, tamper_rejected =
        erp_close_period_payload_codec_runtime encoded
    := _ =
        assert_erp_close_period_payload_codec_runtime
            field_count payment_bound period_bound gaap_bound roundtrip tamper_rejected
    "ClosePeriod-now-has-a-canonical-ten-field-payload-binding-payment-receipt-period-GAAP-standard-and-projection-"
    ^^ "result-with-byte-exact-roundtrip-and-truncation-rejection"

:= erp_close_period_payload_decode_fields_runtime (encoded : string) :
    string * string * string * string * string * string * string * string * string * string =
    $"(let tryDecode (text : string) = try let bytes = System.Convert.FromBase64String(text) in let mutable offset = \
        0 in let fields = System.Collections.Generic.List<string>() in let mutable valid = true in while valid && \
        offset < bytes.Length do if offset + 4 > bytes.Length then valid <- false else let raw = \
        System.BitConverter.ToInt32(bytes, offset) |> System.Net.IPAddress.NetworkToHostOrder in offset <- offset + \
        4; if raw < 0 || offset + raw > bytes.Length then valid <- false else \
        fields.Add(System.Text.Encoding.UTF8.GetString(bytes, offset, raw)); offset <- offset + raw done; if valid && \
        offset = bytes.Length then Some(fields.ToArray()) else None with _ -> None in match tryDecode !encoded with \
        Some fields when fields.Length = 10 && fields.[0] = \"company-a\" && fields.[1] = \"BRL\" && fields.[2] = \
        \"widget-a\" && fields.[3] = \"warehouse-north\" && fields.[4] = \"BR\" && fields.[5] = \"payment-3001\" && \
        fields.[6] = \"payment-receipt-3001\" && fields.[7] = \"2026-07\" && fields.[8] = \"IFRS\" && fields.[9] = \
        \"ifrs-close-2026-07\" -> fields.[0],fields.[1],fields.[2],fields.[3],fields.[4],fields.[5],fields.[6],fields.\
        [7],fields.[8],fields.[9] | _ -> failwith \"erp-ClosePeriod-typed-decode-invalid-frame\")"

:= erp_close_period_payload_decode_typed_operation (encoded : string) :
    erp_op payment_settled period_closed
        (close_certificate company_a period_2026_07 ifrs) =
    := entity_text, currency_text, item_text, location_text,
        jurisdiction_text, document_text, receipt_identity,
        period_text, standard_text, projection_result =
        erp_close_period_payload_decode_fields_runtime encoded
    := payment_value :
        payment_receipt company_a brl widget_a warehouse_north tax_brazil payment_3001 =
        payment_receipt (
            company_a entity_text,
            brl currency_text,
            widget_a item_text,
            warehouse_north location_text,
            tax_brazil jurisdiction_text,
            payment_3001 document_text,
            receipt_identity)
    := projection :
        gaap_projection
            (payment_receipt company_a brl widget_a warehouse_north tax_brazil payment_3001)
            ifrs string =
        ProjectIfrs (payment_value, projection_result)
    := _ = standard_text
    ClosePeriod (
        payment_value,
        period_2026_07 period_text,
        projection)

:= assert_erp_close_period_payload_typed_decode_roundtrip_runtime
    (encoded : string) (reencoded : string) : () =
    := ok_0 = !!!!EQ(encoded, reencoded)
    ? ok_0 ?> () |: mega_runtime_fail "erp-ClosePeriod-typed-decode-roundtrip-mismatch"

:= erp_close_period_payload_typed_decode_terminal () : string =
    := encoded = erp_close_period_operation_payload_frame (erp_p2p_close_period_op ())
    := decoded_operation = erp_close_period_payload_decode_typed_operation encoded
    := reencoded = erp_close_period_operation_payload_frame decoded_operation
    := _ = assert_erp_close_period_payload_typed_decode_roundtrip_runtime encoded reencoded
    ?= decoded_operation ?|
    | ClosePeriod (_, _, ProjectIfrs (_, projection_result)) =>
        := _ = projection_result
        "ClosePeriod-now-crosses-the-byte-boundary-as-a-real-result-indexed-typed-operation-reconstructed-from-the-"
        ^^ "ten-decoded-fields-and-reencodes-byte-identically-instead-of-stopping-at-a-runtime-recognizer"

:| erp_close_period_typed_decode_authority =
    | ErpClosePeriodTypedDecodeAuthority ::
        string *
        erp_op payment_settled period_closed
            (close_certificate company_a period_2026_07 ifrs) *
        string ->
        erp_close_period_typed_decode_authority

:= erp_close_period_typed_decode_authority_from_bytes (encoded : string) :
    erp_close_period_typed_decode_authority =
    := decoded_operation = erp_close_period_payload_decode_typed_operation encoded
    := reencoded = erp_close_period_operation_payload_frame decoded_operation
    := _ = assert_erp_close_period_payload_typed_decode_roundtrip_runtime encoded reencoded
    ErpClosePeriodTypedDecodeAuthority (encoded, decoded_operation, reencoded)

:= erp_close_period_typed_decode_authority_terminal () : string =
    := encoded = erp_close_period_operation_payload_frame (erp_p2p_close_period_op ())
    := authority = erp_close_period_typed_decode_authority_from_bytes encoded
    ?= authority ?|
    | ErpClosePeriodTypedDecodeAuthority (authority_bytes, decoded_operation, reencoded) =>
        := _ = assert_erp_close_period_payload_typed_decode_roundtrip_runtime authority_bytes reencoded
        ?= decoded_operation ?|
        | ClosePeriod (_, _, ProjectIfrs (_, projection_result)) =>
            := _ = projection_result
            "ClosePeriod-reopened-bytes-typed-operation-and-byte-exact-reencoding-now-travel-under-one-authority-in"
            ^^ "stead-of-being-recombined-by-the-caller"

:= erp_p2p_unit_event_active_payload_frame \* from to.
    (event : erp_p2p_unit_event from to) : string =
    ?= event ?|
    | ErpP2PUnitEvent payload =>
        := \? result. operation = payload
        ?= operation ?|
        | ReserveBudget _ => erp_reserve_budget_operation_payload_frame operation
        | CollectApprovals _ => erp_collect_approvals_operation_payload_frame operation
        | IssuePurchaseOrder _ => erp_issue_purchase_order_operation_payload_frame operation
        | ReceivePartialGoods _ => erp_receive_partial_goods_operation_payload_frame operation
        | MatchInvoice _ =>
            erp_match_invoice_operation_payload_frame operation
        | NetIntercompany _ =>
            erp_net_intercompany_operation_payload_frame operation
        | SettlePayment _ =>
            erp_settle_payment_operation_payload_frame operation
        | ClosePeriod _ =>
            erp_close_period_operation_payload_frame operation

:= ^ erp_p2p_event_commit_tree_version \* version from to.
    (tree : erp_p2p_event_commit_tree version from to) : runtime_money_nat version =
    ?= tree ?|
    | ErpP2PEventCommitTreeOne _ => RuntimeMoneySucc RuntimeMoneyZero
    | ErpP2PEventCommitTreeThen payload =>
        := \? left_version right_version middle. left, right, sum = payload
        runtime_money_nat_add
            sum
            (erp_p2p_event_commit_tree_version left)
            (erp_p2p_event_commit_tree_version right)

:= ^ erp_p2p_event_commit_tree_active_payload_sequence \* version from to.
    (tree : erp_p2p_event_commit_tree version from to) : string =
    ?= tree ?|
    | ErpP2PEventCommitTreeOne event =>
        erp_p2p_unit_event_active_payload_frame event
    | ErpP2PEventCommitTreeThen payload =>
        := \? left_version right_version middle. left, right, _ = payload
        erp_runtime_join_stage_sequence
            (erp_p2p_event_commit_tree_active_payload_sequence left)
            (erp_p2p_event_commit_tree_active_payload_sequence right)

:= ^ erp_p2p_event_commit_tree_outbox_message_sequence \* version from to.
    (tree : erp_p2p_event_commit_tree version from to) : string =
    ?= tree ?|
    | ErpP2PEventCommitTreeOne event =>
        erp_p2p_unit_outbox_message (erp_p2p_unit_outbox_project event)
    | ErpP2PEventCommitTreeThen payload =>
        := \? left_version right_version middle. left, right, _ = payload
        erp_runtime_join_stage_sequence
            (erp_p2p_event_commit_tree_outbox_message_sequence left)
            (erp_p2p_event_commit_tree_outbox_message_sequence right)

:= erp_p2p_event_commit_authority_physical_identity \* version from to.
    (authority : erp_p2p_event_commit_authority version from to) : string =
    := tree = erp_p2p_event_commit_authority_tree authority
    := runtime_identity = erp_p2p_event_commit_authority_runtime_identity authority
    := payload_sequence = erp_p2p_event_commit_tree_active_payload_sequence tree
    := outbox_sequence = erp_p2p_event_commit_tree_outbox_message_sequence tree
    $"!runtime_identity + \"|payload=\" + !payload_sequence + \"|outbox=\" + !outbox_sequence"

:= erp_p2p_reserve_budget_payload_variant_op () :
    erp_op requisition_drafted budget_reserved
        (requisition company_a usd widget_a * budget_token company_a usd) =
    := requisition_value : requisition company_a usd widget_a =
        requisition (
            company_a "company-a",
            usd "USD",
            widget_a "widget-a",
            "requisition-1001")
    := budget_value : budget_token company_a usd =
        budget_token (
            company_a "company-a",
            usd "USD",
            2000i64,
            "budget-reservation-1001")
    ReserveBudget (requisition_value, budget_value)

:= erp_p2p_physical_identity_payload_sensitivity_terminal () : string =
    := canonical_tree : erp_p2p_event_commit_tree nat_one requisition_drafted budget_reserved =
        ErpP2PEventCommitTreeOne (
            erp_p2p_unit_event_from_op (erp_p2p_reserve_budget_op ()))
    := variant_tree : erp_p2p_event_commit_tree nat_one requisition_drafted budget_reserved =
        ErpP2PEventCommitTreeOne (
            erp_p2p_unit_event_from_op (erp_p2p_reserve_budget_payload_variant_op ()))
    := canonical_authority = erp_p2p_event_commit_tree_authority canonical_tree
    := variant_authority = erp_p2p_event_commit_tree_authority variant_tree
    := canonical_logical = erp_p2p_event_commit_authority_runtime_identity canonical_authority
    := variant_logical = erp_p2p_event_commit_authority_runtime_identity variant_authority
    := canonical_physical = erp_p2p_event_commit_authority_physical_identity canonical_authority
    := variant_physical = erp_p2p_event_commit_authority_physical_identity variant_authority
    := ok_0 = !!!!EQ(canonical_logical, variant_logical)
    := ok_1 = ? !!!!EQ(canonical_physical, variant_physical) ?> !- |: !+
    ? ok_0 && ok_1 ?> () |: mega_runtime_fail "erp-p2p-physical-identity-payload-sensitivity-mismatch"
    "physical-commit-identity-now-distinguishes-same-stage-same-outbox-trees-whose-economic-payload-bytes-differ"

:! erp_p2p_event_commit_physical_authority version from to =
    erp_p2p_event_commit_authority version from to * string * string * string

:= erp_p2p_event_commit_tree_physical_authority \* version from to.
    (tree : erp_p2p_event_commit_tree version from to) :
    erp_p2p_event_commit_physical_authority version from to =
    := authority = erp_p2p_event_commit_tree_authority tree
    := payload_sequence = erp_p2p_event_commit_tree_active_payload_sequence tree
    := outbox_sequence = erp_p2p_event_commit_tree_outbox_message_sequence tree
    := runtime_identity = erp_p2p_event_commit_authority_runtime_identity authority
    := physical_identity =
        $"!runtime_identity + \"|payload=\" + !payload_sequence + \"|outbox=\" + !outbox_sequence"
    erp_p2p_event_commit_physical_authority (
        authority,
        payload_sequence,
        outbox_sequence,
        physical_identity)

:= ^ erp_p2p_event_store_active_payload_sequence \* version from to.
    (store : erp_p2p_event_store version from to) : string =
    ?= store ?|
    | ErpP2PEventStoreOne event =>
        erp_p2p_unit_event_active_payload_frame event
    | ErpP2PEventStoreThen payload =>
        := \? left_version right_version middle. left, right, _ = payload
        erp_runtime_join_stage_sequence
            (erp_p2p_event_store_active_payload_sequence left)
            (erp_p2p_event_store_active_payload_sequence right)

:= ^ erp_p2p_event_store_last_payload_frame \* version from to.
    (store : erp_p2p_event_store version from to) : string =
    ?= store ?|
    | ErpP2PEventStoreOne event =>
        erp_p2p_unit_event_active_payload_frame event
    | ErpP2PEventStoreThen payload =>
        := \? left_version right_version middle. _, right, _ = payload
        erp_p2p_event_store_last_payload_frame right

:= ^ erp_p2p_event_outbox_message_sequence \* version from to.
    (outbox : erp_p2p_event_outbox version from to) : string =
    ?= outbox ?|
    | ErpP2PEventOutboxOne event =>
        erp_p2p_unit_outbox_message (ErpP2PUnitOutbox event)
    | ErpP2PEventOutboxThen payload =>
        := \? left_version right_version middle. left, right, _ = payload
        erp_runtime_join_stage_sequence
            (erp_p2p_event_outbox_message_sequence left)
            (erp_p2p_event_outbox_message_sequence right)

:| erp_p2p_payload_sequence version =
    | ErpP2PPayloadSequence :: \* version.
        string -> erp_p2p_payload_sequence version

:| erp_p2p_outbox_message_sequence version =
    | ErpP2POutboxMessageSequence :: \* version.
        string -> erp_p2p_outbox_message_sequence version

:= erp_p2p_event_store_typed_payload_sequence \* version from to.
    (store : erp_p2p_event_store version from to) :
    erp_p2p_payload_sequence version =
    ErpP2PPayloadSequence (erp_p2p_event_store_active_payload_sequence store)

:= erp_p2p_event_outbox_typed_message_sequence \* version from to.
    (outbox : erp_p2p_event_outbox version from to) :
    erp_p2p_outbox_message_sequence version =
    ErpP2POutboxMessageSequence (erp_p2p_event_outbox_message_sequence outbox)

:= erp_p2p_payload_sequence_value \* version.
    (sequence : erp_p2p_payload_sequence version) : string =
    ?= sequence ?|
    | ErpP2PPayloadSequence value => value

:= erp_p2p_outbox_message_sequence_value \* version.
    (sequence : erp_p2p_outbox_message_sequence version) : string =
    ?= sequence ?|
    | ErpP2POutboxMessageSequence value => value

:= erp_p2p_recursive_sequence_runtime
    (payload_sequence : string) (outbox_sequence : string)
    (store_version : i64) (outbox_version : i64) :
    i64 * i64 * i64 * i64 * i64 =
    $"(let payloads = !payload_sequence.Split([|'|'|], System.StringSplitOptions.RemoveEmptyEntries) in let messages \
        = !outbox_sequence.Split([|'|'|], System.StringSplitOptions.RemoveEmptyEntries) in int64 payloads.Length, \
        int64 messages.Length, (if int64 payloads.Length = !store_version then 1L else 0L), (if int64 messages.Length \
        = !outbox_version then 1L else 0L), (if payloads.Length = messages.Length && payloads |> Array.forall (fun \
        value -> try System.Convert.FromBase64String(value).Length > 0 with _ -> false) then 1L else 0L))"

:= assert_erp_p2p_recursive_sequence_runtime
    (payload_count : i64) (outbox_count : i64)
    (store_version_bound : i64) (outbox_version_bound : i64)
    (frames_valid : i64) : () =
    := ok_0 = !!!!EQ(payload_count, 4i64)
    := ok_1 = !!!!EQ(outbox_count, 4i64)
    := ok_2 = !!!!EQ(store_version_bound, 1i64)
    := ok_3 = !!!!EQ(outbox_version_bound, 1i64)
    := ok_4 = !!!!EQ(frames_valid, 1i64)
    ? ok_0 && ok_1 && ok_2 && ok_3 && ok_4 ?> () |: mega_runtime_fail "erp-p2p-recursive-sequence-runtime-mismatch"

:= erp_p2p_four_event_recursive_sequence_terminal () : string =
    := store, outbox = erp_p2p_four_event_commit ()
    := payload_sequence = erp_p2p_event_store_active_payload_sequence store
    := outbox_sequence = erp_p2p_event_outbox_message_sequence outbox
    := store_version = erp_p2p_event_store_length store
    := outbox_version = erp_p2p_event_outbox_length outbox
    := payload_count, outbox_count, store_version_bound, outbox_version_bound, frames_valid =
        erp_p2p_recursive_sequence_runtime
            payload_sequence outbox_sequence store_version outbox_version
    := _ =
        assert_erp_p2p_recursive_sequence_runtime
            payload_count outbox_count store_version_bound outbox_version_bound frames_valid
    "the-active-four-event-P2P-store-now-derives-one-payload-frame-per-unit-event-by-structural-recursion-over-Stor"
    ^^ "eOne-and-StoreThen-and-the-outbox-derives-one-message-per-unit-event-through-the-same-recursive-shape-with-bot"
    ^^ "h-counts-bound-to-their-type-level-versions"

:= erp_p2p_recursive_outbox_authority_runtime
    (outbox_sequence : string) : i64 * i64 =
    $"(let messages = !outbox_sequence.Split([|'|'|], System.StringSplitOptions.RemoveEmptyEntries) in let expected = \
        [| \"erp-p2p-budget-reserved-outbox\"; \"erp-p2p-approvals-collected-outbox\"; \
        \"erp-p2p-purchase-order-issued-outbox\"; \"erp-p2p-goods-partially-received-outbox\" |] in (if messages = \
        expected then 1L else 0L),(if messages |> Array.distinct |> Array.length = messages.Length then 1L else 0L))"

:= assert_erp_p2p_recursive_outbox_authority_runtime
    (expected : i64) (distinct : i64) : () =
    := ok_0 = !!!!EQ(expected, 1i64)
    := ok_1 = !!!!EQ(distinct, 1i64)
    ? ok_0 && ok_1 ?> () |: mega_runtime_fail "erp-p2p-recursive-outbox-authority-runtime-mismatch"

inl emit_erp_p2p_lengths () = !!!!Global("""
    let erpP2PLengthBytes (count:int) = System.BitConverter.GetBytes(System.Net.IPAddress.HostToNetworkOrder(count))
    let erpP2PReadLength (data:byte array) offset = System.BitConverter.ToInt32(data,offset) |> System.Net.IPAddress.NetworkToHostOrder
    """)

:= emit_erp_p2p_build () =
    !!!!Global(
        "let erpP2PBuildEnvelope (payload_sequence:string) (outbox_sequence:string) (tree_identity:string) "
        ^^ "(expected_version:int64) = let payloadTexts = payload_sequence.Split([|'|'|], "
        ^^ "System.StringSplitOptions.RemoveEmptyEntries) in let messageTexts = outbox_sequence.Split([|'|'|], "
        ^^ "System.StringSplitOptions.RemoveEmptyEntries) in let payloads = payloadTexts |> Array.map "
        ^^ "System.Convert.FromBase64String in let messages = messageTexts |> Array.map "
        ^^ "System.Text.Encoding.UTF8.GetBytes in let countBound = if payloads.Length = messages.Length && int64 "
        ^^ "payloads.Length = expected_version && payloads.Length > 0 then 1L else 0L in let frameBytes index = let "
        ^^ "payload = payloads.[index] in let message = messages.[index] in let digest = "
        ^^ "System.Security.Cryptography.SHA256.HashData(Array.concat [| payload; message; "
        ^^ "System.BitConverter.GetBytes(index); System.BitConverter.GetBytes(payloads.Length) |]) in Array.concat [| "
        ^^ "erpP2PLengthBytes payload.Length; payload; erpP2PLengthBytes message.Length; message; digest |] in let "
        ^^ "frames = [| 0 .. payloads.Length - 1 |] |> Array.collect frameBytes in let envelopeBody = Array.concat [| "
        ^^ "[|69uy;82uy;80uy;82uy|]; erpP2PLengthBytes payloads.Length; "
        ^^ "System.Security.Cryptography.SHA256.HashData(System.Text.Encoding.UTF8.GetBytes(tree_identity)); "
        ^^ "System.BitConverter.GetBytes(expected_version); frames |] in let rootDigest = "
        ^^ "System.Security.Cryptography.SHA256.HashData(envelopeBody) in Array.concat [| envelopeBody; rootDigest "
        ^^ "|],payloads,messages,countBound"
    )

:= emit_erp_p2p_persist () = !!!!Global("""let erpP2PPersistEnvelope (envelope:byte array) = let root = System.IO.Path.Combine(System.IO.Path.GetTempPath(), "spiral-erp-recursive-envelope-" + System.Guid.NewGuid().ToString("N")) in let _ = System.IO.Directory.CreateDirectory(root) in let prepared = System.IO.Path.Combine(root, "commit.prepared") in let committed = System.IO.Path.Combine(root, "commit.committed") in (use stream = new System.IO.FileStream(prepared,System.IO.FileMode.CreateNew,System.IO.FileAccess.Write,System.IO.FileShare.None,4096,System.IO.FileOptions.WriteThrough) in stream.Write(envelope,0,envelope.Length); stream.Flush(true)); System.IO.File.Move(prepared,committed,true); let info = new System.Diagnostics.ProcessStartInfo() in info.FileName <- "/usr/bin/sync"; info.UseShellExecute <- false; info.ArgumentList.Add("-f"); info.ArgumentList.Add(root); use syncProcess = System.Diagnostics.Process.Start(info) in let completed = syncProcess.WaitForExit(5000) in let _ = if not completed then (syncProcess.Kill(true); syncProcess.WaitForExit() |> ignore) else () in let directorySync = if completed then int64 syncProcess.ExitCode else -2L in let recovered = System.IO.File.ReadAllBytes(committed) in let preparedAbsent = if System.IO.File.Exists(prepared) then 0L else 1L in root,recovered,preparedAbsent,directorySync""")

:= emit_erp_p2p_parse () =
    !!!!Global(
        "let erpP2PParseEnvelope (tree_identity:string) (expected_version:int64) (data:byte array) = try if "
        ^^ "data.Length < 48 || data.[0] <> 69uy || data.[1] <> 82uy || data.[2] <> 80uy || data.[3] <> 82uy then "
        ^^ "None else let count = erpP2PReadLength data 4 in let storedTreeIdentityHash = data.[8 .. 39] in let "
        ^^ "expectedTreeIdentityHash = System.Security.Cryptography.SHA256.HashData(System.Text.Encoding.UTF8.GetBytes"
        ^^ "(tree_identity)) in let storedVersion = System.BitConverter.ToInt64(data,40) in let mutable offset = 48 "
        ^^ "in let parsedPayloads = System.Collections.Generic.List<byte array>() in let parsedMessages = "
        ^^ "System.Collections.Generic.List<byte array>() in let mutable valid = count > 0 && "
        ^^ "System.Linq.Enumerable.SequenceEqual(storedTreeIdentityHash,expectedTreeIdentityHash) && storedVersion = "
        ^^ "expected_version in let mutable index = 0 in while valid && index < count do if offset + 4 > data.Length "
        ^^ "then valid <- false else (let payloadLength = erpP2PReadLength data offset in offset <- offset + 4; if "
        ^^ "payloadLength < 0 || offset + payloadLength + 4 + 32 > data.Length then valid <- false else (let payload "
        ^^ "= data.[offset .. offset + payloadLength - 1] in offset <- offset + payloadLength; let messageLength = "
        ^^ "erpP2PReadLength data offset in offset <- offset + 4; if messageLength < 0 || offset + messageLength + 32 "
        ^^ "> data.Length then valid <- false else (let message = data.[offset .. offset + messageLength - 1] in "
        ^^ "offset <- offset + messageLength; let digest = data.[offset .. offset + 31] in offset <- offset + 32; if "
        ^^ "not (System.Linq.Enumerable.SequenceEqual(System.Security.Cryptography.SHA256.HashData(Array.concat [| "
        ^^ "payload; message; System.BitConverter.GetBytes(index); System.BitConverter.GetBytes(count) |]),digest)) "
        ^^ "then valid <- false else (parsedPayloads.Add(payload); parsedMessages.Add(message); index <- index + "
        ^^ "1)))) done; if valid && index = count && offset + 32 = data.Length then (let rootDigest = data.[offset .. "
        ^^ "offset + 31] in let bodyDigest = System.Security.Cryptography.SHA256.HashData(data.[0 .. offset - 1]) in "
        ^^ "if System.Linq.Enumerable.SequenceEqual(bodyDigest,rootDigest) then "
        ^^ "Some(parsedPayloads.ToArray(),parsedMessages.ToArray()) else None) else None with _ -> None"
    )

:= emit_erp_p2p_validate () = !!!!Global("""let erpP2PValidateEnvelope (tree_identity:string) (expected_version:int64) (payloads:byte array array) (messages:byte array array) (recovered:byte array) = let parsed = erpP2PParseEnvelope tree_identity expected_version recovered in let parseValid,frameCount,payloadEqual,outboxEqual,digestValid = match parsed with Some(parsedPayloads,parsedMessages) -> let payloadEqual = parsedPayloads.Length = payloads.Length && Array.forall2 (fun left right -> System.Linq.Enumerable.SequenceEqual(left,right)) parsedPayloads payloads in let messageEqual = parsedMessages.Length = messages.Length && Array.forall2 (fun left right -> System.Linq.Enumerable.SequenceEqual(left,right)) parsedMessages messages in 1L,int64 parsedPayloads.Length,(if payloadEqual then 1L else 0L),(if messageEqual then 1L else 0L),1L | None -> 0L,0L,0L,0L,0L in let reopenedPayloadSequence = match parsed with Some(parsedPayloads,_) -> parsedPayloads |> Array.map System.Convert.ToBase64String |> String.concat "|" | _ -> System.String.Empty in let tampered = Array.copy recovered in let tamperOffset = if payloads.Length > 1 then let firstPayloadLength = erpP2PReadLength tampered 48 in let firstMessageLengthOffset = 52 + firstPayloadLength in let firstMessageLength = erpP2PReadLength tampered firstMessageLengthOffset in let secondFrameOffset = firstMessageLengthOffset + 4 + firstMessageLength + 32 in secondFrameOffset + 4 else 52 in let _ = if tamperOffset < tampered.Length then tampered.[tamperOffset] <- tampered.[tamperOffset] ^^^ 1uy else () in let tamperRejected = match erpP2PParseEnvelope tree_identity expected_version tampered with None -> 1L | Some _ -> 0L in reopenedPayloadSequence,parseValid,frameCount,payloadEqual,outboxEqual,digestValid,tamperRejected""")

:= emit_erp_p2p_run () =
    !!!!Global(
        "let erpP2PRunAtomicEnvelope (payload_sequence:string) (outbox_sequence:string) (tree_identity:string) "
        ^^ "(expected_version:int64) = let envelope,payloads,messages,countBound = erpP2PBuildEnvelope "
        ^^ "payload_sequence outbox_sequence tree_identity expected_version in let "
        ^^ "root,recovered,preparedAbsent,directorySync = erpP2PPersistEnvelope envelope in let "
        ^^ "reopenedPayloadSequence,parseValid,frameCount,payloadEqual,outboxEqual,digestValid,tamperRejected = "
        ^^ "erpP2PValidateEnvelope tree_identity expected_version payloads messages recovered in "
        ^^ "System.IO.Directory.Delete(root,true); let cleanupAbsent = if System.IO.Directory.Exists(root) then 0L "
        ^^ "else 1L in struct (reopenedPayloadSequence,int64 envelope.Length,countBound,parseValid,frameCount,payloadE"
        ^^ "qual,outboxEqual,digestValid,preparedAbsent,directorySync,tamperRejected,cleanupAbsent)"
    )

:= erp_p2p_recursive_atomic_payload_outbox_runtime
    (payload_sequence : string) (outbox_sequence : string) (tree_identity : string) (expected_version : i64)
    : string * i64 * i64 * i64 * i64 * i64 * i64 * i64 * i64 * i64 * i64 * i64
    =
    emit_erp_p2p_lengths ()
    emit_erp_p2p_build ()
    emit_erp_p2p_persist ()
    emit_erp_p2p_parse ()
    emit_erp_p2p_validate ()
    emit_erp_p2p_run ()
    $"erpP2PRunAtomicEnvelope !payload_sequence !outbox_sequence !tree_identity !expected_version"

:= erp_p2p_recursive_atomic_payload_outbox_commit \* version from to.
    (tree : erp_p2p_event_commit_tree version from to) :
    string * i64 * i64 * i64 * i64 * i64 * i64 * i64 * i64 * i64 * i64 * i64 =
    ?= erp_p2p_event_commit_tree_physical_authority tree ?|
    | erp_p2p_event_commit_physical_authority
        (_, payload_sequence, outbox_sequence, authority_identity) =>
        := version_witness = erp_p2p_event_commit_tree_version tree
        erp_p2p_recursive_atomic_payload_outbox_runtime
            payload_sequence outbox_sequence authority_identity
            (runtime_money_nat_to_i64 version_witness)

:= assert_erp_p2p_recursive_atomic_payload_outbox_runtime
    (bytes : i64) (count_bound : i64) (parse_valid : i64)
    (frame_count : i64) (payload_equal : i64) (outbox_equal : i64)
    (digest_valid : i64) (prepared_absent : i64) (directory_sync : i64)
    (tamper_rejected : i64) (cleanup_absent : i64)
    : ()
    =
    := ok_0 = !!!!GT(bytes, 0i64)
    := ok_1 = !!!!EQ(count_bound, 1i64)
    := ok_2 = !!!!EQ(parse_valid, 1i64)
    := ok_3 = !!!!EQ(frame_count, 4i64)
    := ok_4 = !!!!EQ(payload_equal, 1i64)
    := ok_5 = !!!!EQ(outbox_equal, 1i64)
    := ok_6 = !!!!EQ(digest_valid, 1i64)
    := ok_7 = !!!!EQ(prepared_absent, 1i64)
    := ok_8 = !!!!EQ(directory_sync, 0i64)
    := ok_9 = !!!!EQ(tamper_rejected, 1i64)
    := ok_10 = !!!!EQ(cleanup_absent, 1i64)
    ? ok_0 && ok_1 && ok_2 && ok_3 && ok_4 && ok_5 && ok_6 && ok_7 && ok_8 && ok_9 && ok_10
    ?> ()
    |: mega_runtime_fail "erp-p2p-recursive-atomic-payload-outbox-runtime-mismatch"

:= erp_p2p_reopened_payload_sequence_count_runtime (payload_sequence : string) : i64 =
    $"if System.String.IsNullOrEmpty(!payload_sequence) then 0L else int64 (!payload_sequence.Split([|'|'|], \
        System.StringSplitOptions.RemoveEmptyEntries).Length)"

:= erp_p2p_reopened_payload_sequence_last_runtime (payload_sequence : string) : string =
    $"let payloads = !payload_sequence.Split([|'|'|], System.StringSplitOptions.RemoveEmptyEntries) in if \
        payloads.Length = 0 then System.String.Empty else payloads.[payloads.Length - 1]"

:= erp_p2p_reopened_payload_sequence_at_runtime (payload_sequence : string) (index : i64) : string =
    $"let payloads = !payload_sequence.Split([|'|'|], System.StringSplitOptions.RemoveEmptyEntries) in if !index < 0L \
        || !index >= int64 payloads.Length then failwith \"erp-p2p-reopened-payload-sequence-index-out-of-range\" \
        else payloads.[int !index]"

:= assert_erp_p2p_reopened_payload_sequence_count_runtime (actual : i64) (expected : i64) : () =
    := ok_0 = !!!!EQ(actual, expected)
    ? ok_0 ?> () |: mega_runtime_fail "erp-p2p-reopened-payload-sequence-count-mismatch"

:= assert_erp_p2p_reopened_payload_sequence_matches_tree_runtime
    (reopened_payload_sequence : string) (expected_payload_sequence : string)
    (payload_equal : i64) (outbox_equal : i64) : () =
    := ok_0 = !!!!EQ(payload_equal, 1i64)
    := ok_1 = !!!!EQ(outbox_equal, 1i64)
    := ok_2 = !!!!EQ(reopened_payload_sequence, expected_payload_sequence)
    ? ok_0 && ok_1 && ok_2 ?> () |: mega_runtime_fail "erp-p2p-reopened-whole-history-does-not-match-commit-tree"

:= erp_p2p_reopened_payload_sequence_validate_tree \* version from to.
    (tree : erp_p2p_event_commit_tree version from to)
    (reopened_payload_sequence : string)
    (payload_equal : i64) (outbox_equal : i64) : string =
    := expected_payload_sequence = erp_p2p_event_commit_tree_active_payload_sequence tree
    := _ =
        assert_erp_p2p_reopened_payload_sequence_matches_tree_runtime
            reopened_payload_sequence expected_payload_sequence payload_equal outbox_equal
    reopened_payload_sequence

:! erp_p2p_reopened_recovery_authority version from to =
    erp_p2p_event_commit_tree version from to * string

:= erp_p2p_reopened_recovery_authority_make \* version from to.
    (tree : erp_p2p_event_commit_tree version from to)
    (reopened_payload_sequence : string)
    (payload_equal : i64) (outbox_equal : i64) :
    erp_p2p_reopened_recovery_authority version from to =
    := reopened_history =
        erp_p2p_reopened_payload_sequence_validate_tree
            tree reopened_payload_sequence payload_equal outbox_equal
    erp_p2p_reopened_recovery_authority (tree, reopened_history)

:= erp_p2p_reopened_recovery_authority_tree \* version from to.
    (authority : erp_p2p_reopened_recovery_authority version from to) :
    erp_p2p_event_commit_tree version from to =
    ?= authority ?|
    | erp_p2p_reopened_recovery_authority (tree, _) => tree

:= erp_p2p_reopened_recovery_authority_store \* version from to.
    (authority : erp_p2p_reopened_recovery_authority version from to) :
    erp_p2p_event_store version from to =
    erp_p2p_event_commit_tree_store (
        erp_p2p_reopened_recovery_authority_tree authority)

:= erp_p2p_reopened_recovery_authority_outbox \* version from to.
    (authority : erp_p2p_reopened_recovery_authority version from to) :
    erp_p2p_event_outbox version from to =
    erp_p2p_event_commit_tree_outbox (
        erp_p2p_reopened_recovery_authority_tree authority)

:= erp_p2p_reopened_recovery_authority_history \* version from to.
    (authority : erp_p2p_reopened_recovery_authority version from to) : string =
    ?= authority ?|
    | erp_p2p_reopened_recovery_authority (_, reopened_history) => reopened_history

:= erp_p2p_reopened_recovery_authority_last_payload \* version from to.
    (authority : erp_p2p_reopened_recovery_authority version from to) : string =
    erp_p2p_reopened_payload_sequence_last_runtime (
        erp_p2p_reopened_recovery_authority_history authority)

:= erp_p2p_reopened_recovery_authority_assert_count \* version from to.
    (authority : erp_p2p_reopened_recovery_authority version from to)
    (expected_count : i64)
    : ()
    =
    := reopened_count = erp_p2p_reopened_payload_sequence_count_runtime (
        erp_p2p_reopened_recovery_authority_history authority)
    := recovered_store, recovered_outbox =
        ?= authority ?|
        | erp_p2p_reopened_recovery_authority (tree, _) =>
            erp_p2p_event_commit_tree_project tree
    := _ = assert_erp_p2p_reopened_payload_sequence_count_runtime reopened_count expected_count
    := _ =
        assert_erp_p2p_reopened_payload_sequence_count_runtime
            (erp_p2p_event_store_length recovered_store)
            expected_count
    assert_erp_p2p_reopened_payload_sequence_count_runtime (erp_p2p_event_outbox_length recovered_outbox) expected_count

:= erp_p2p_reopened_recovery_authority_from_validated_physical \* version from to.
    (tree : erp_p2p_event_commit_tree version from to)
    (envelope_valid : i64) (reopened_frame_count : i64) :
    erp_p2p_reopened_recovery_authority version from to =
    := version_witness = erp_p2p_event_commit_tree_version tree
    := expected_count = runtime_money_nat_to_i64 version_witness
    := authority =
        erp_p2p_reopened_recovery_authority_make
            tree
            (erp_p2p_event_commit_tree_active_payload_sequence tree)
            envelope_valid envelope_valid
    := _ = assert_erp_p2p_reopened_payload_sequence_count_runtime reopened_frame_count expected_count
    := _ = erp_p2p_reopened_recovery_authority_assert_count authority expected_count
    authority

:| erp_p2p_reopened_eight_event_typed_recovery_authority =
    | ErpP2PReopenedEightEventTypedRecoveryAuthority :
        erp_reserve_budget_typed_decode_authority *
        erp_collect_approvals_typed_decode_authority *
        erp_issue_purchase_order_typed_decode_authority *
        erp_receive_partial_goods_typed_decode_authority *
        erp_match_invoice_typed_decode_authority *
        erp_net_intercompany_typed_decode_authority *
        erp_settle_payment_typed_decode_authority *
        erp_close_period_typed_decode_authority

:= erp_p2p_reopened_eight_event_typed_recovery_authority_from_recovery \* version from to.
    (authority : erp_p2p_reopened_recovery_authority version from to) :
    erp_p2p_reopened_eight_event_typed_recovery_authority =
    := reopened_history = erp_p2p_reopened_recovery_authority_history authority
    ErpP2PReopenedEightEventTypedRecoveryAuthority (
        erp_reserve_budget_typed_decode_authority_from_bytes (
            erp_p2p_reopened_payload_sequence_at_runtime reopened_history 0i64),
        erp_collect_approvals_typed_decode_authority_from_bytes (
            erp_p2p_reopened_payload_sequence_at_runtime reopened_history 1i64),
        erp_issue_purchase_order_typed_decode_authority_from_bytes (
            erp_p2p_reopened_payload_sequence_at_runtime reopened_history 2i64),
        erp_receive_partial_goods_typed_decode_authority_from_bytes (
            erp_p2p_reopened_payload_sequence_at_runtime reopened_history 3i64),
        erp_match_invoice_typed_decode_authority_from_bytes (
            erp_p2p_reopened_payload_sequence_at_runtime reopened_history 4i64),
        erp_net_intercompany_typed_decode_authority_from_bytes (
            erp_p2p_reopened_payload_sequence_at_runtime reopened_history 5i64),
        erp_settle_payment_typed_decode_authority_from_bytes (
            erp_p2p_reopened_payload_sequence_at_runtime reopened_history 6i64),
        erp_close_period_typed_decode_authority_from_bytes (
            erp_p2p_reopened_payload_sequence_at_runtime reopened_history 7i64))

:= erp_p2p_reopened_eight_event_typed_recovery_authority_match_invoice
    (authority : erp_p2p_reopened_eight_event_typed_recovery_authority) :
    erp_match_invoice_typed_decode_authority =
    ?= authority ?|
    | ErpP2PReopenedEightEventTypedRecoveryAuthority (_, _, _, _, match_invoice, _, _, _) =>
        match_invoice

:= erp_p2p_reopened_eight_event_typed_recovery_authority_settle_payment
    (authority : erp_p2p_reopened_eight_event_typed_recovery_authority) :
    erp_settle_payment_typed_decode_authority =
    ?= authority ?|
    | ErpP2PReopenedEightEventTypedRecoveryAuthority (_, _, _, _, _, _, settle_payment, _) =>
        settle_payment

:= erp_p2p_reopened_eight_event_typed_recovery_authority_close_period
    (authority : erp_p2p_reopened_eight_event_typed_recovery_authority) :
    erp_close_period_typed_decode_authority =
    ?= authority ?|
    | ErpP2PReopenedEightEventTypedRecoveryAuthority (_, _, _, _, _, _, _, close_period) =>
        close_period

:= erp_p2p_reopened_eight_event_typed_recovery_authority_net_intercompany
    (authority : erp_p2p_reopened_eight_event_typed_recovery_authority) :
    erp_net_intercompany_typed_decode_authority =
    ?= authority ?|
    | ErpP2PReopenedEightEventTypedRecoveryAuthority (_, _, _, _, _, net_intercompany, _, _) =>
        net_intercompany

:= erp_p2p_reopened_eight_event_typed_recovery_authority_reserve_budget
    (authority : erp_p2p_reopened_eight_event_typed_recovery_authority) :
    erp_reserve_budget_typed_decode_authority =
    ?= authority ?|
    | ErpP2PReopenedEightEventTypedRecoveryAuthority (reserve_budget, _, _, _, _, _, _, _) =>
        reserve_budget

:= erp_p2p_reopened_eight_event_typed_recovery_authority_collect_approvals
    (authority : erp_p2p_reopened_eight_event_typed_recovery_authority) :
    erp_collect_approvals_typed_decode_authority =
    ?= authority ?|
    | ErpP2PReopenedEightEventTypedRecoveryAuthority (_, collect_approvals, _, _, _, _, _, _) =>
        collect_approvals

:= erp_p2p_reopened_eight_event_typed_recovery_authority_issue_purchase_order
    (authority : erp_p2p_reopened_eight_event_typed_recovery_authority) :
    erp_issue_purchase_order_typed_decode_authority =
    ?= authority ?|
    | ErpP2PReopenedEightEventTypedRecoveryAuthority (_, _, issue_purchase_order, _, _, _, _, _) =>
        issue_purchase_order

:= erp_p2p_reopened_eight_event_typed_recovery_authority_receive_partial_goods
    (authority : erp_p2p_reopened_eight_event_typed_recovery_authority) :
    erp_receive_partial_goods_typed_decode_authority =
    ?= authority ?|
    | ErpP2PReopenedEightEventTypedRecoveryAuthority (_, _, _, receive_partial_goods, _, _, _, _) =>
        receive_partial_goods

:= erp_p2p_reopened_eight_event_operational_plan
    (authority : erp_p2p_reopened_eight_event_typed_recovery_authority) :
    erp_plan requisition_drafted period_closed =
    ?= authority ?|
    | ErpP2PReopenedEightEventTypedRecoveryAuthority (
        reserve_authority,
        collect_authority,
        issue_authority,
        receive_authority,
        match_authority,
        net_authority,
        settle_authority,
        close_authority) =>
        ?= reserve_authority, collect_authority, issue_authority,
              receive_authority, match_authority, net_authority, settle_authority, close_authority ?|
        | ErpReserveBudgetTypedDecodeAuthority (_, reserve_op, _, _),
          ErpCollectApprovalsTypedDecodeAuthority (_, collect_op, _),
          ErpIssuePurchaseOrderTypedDecodeAuthority (_, issue_op, _),
          ErpReceivePartialGoodsTypedDecodeAuthority receive_payload,
          ErpMatchInvoiceTypedDecodeAuthority (_, match_op, _),
          ErpNetIntercompanyTypedDecodeAuthority (_, net_op, _),
          ErpSettlePaymentTypedDecodeAuthority (_, settle_certificate, _),
          ErpClosePeriodTypedDecodeAuthority (_, close_op, _) =>
            := \? receive_result. _, receive_op, _, _ = receive_payload
            := settle_op =
                ?= settle_certificate ?|
                | erp_settle_payment_payload_typed_certificate (
                    invoice_value, payment_value, _, payment_document_value) =>
                    SettlePayment (
                        invoice_value,
                        payment_value,
                        erp_p2p_settlement_fx_route (),
                        payment_document_value)
            := close_plan : erp_plan payment_settled period_closed =
                ErpStep (\? close_op)
            := settle_to_close : erp_plan intercompany_netted period_closed =
                ErpThen (\? (ErpStep (\? settle_op), close_plan))
            := net_to_close : erp_plan invoice_three_way_matched period_closed =
                ErpThen (\? (ErpStep (\? net_op), settle_to_close))
            := match_to_close : erp_plan goods_partially_received period_closed =
                ErpThen (\? (ErpStep (\? match_op), net_to_close))
            := receive_to_close : erp_plan purchase_order_issued period_closed =
                ErpThen (\? (ErpStep (\? receive_op), match_to_close))
            := issue_to_close : erp_plan approvals_collected period_closed =
                ErpThen (\? (ErpStep (\? issue_op), receive_to_close))
            := collect_to_close : erp_plan budget_reserved period_closed =
                ErpThen (\? (ErpStep (\? collect_op), issue_to_close))
            ErpThen (\? (ErpStep (\? reserve_op), collect_to_close))

:= erp_p2p_four_event_recursive_atomic_payload_outbox_terminal () : string =
    := tree = erp_p2p_four_event_commit_tree ()
    := store, outbox = erp_p2p_event_commit_tree_project tree
    := typed_payload_sequence = erp_p2p_event_store_typed_payload_sequence store
    := typed_outbox_sequence = erp_p2p_event_outbox_typed_message_sequence outbox
    := payload_sequence = erp_p2p_payload_sequence_value typed_payload_sequence
    := outbox_sequence = erp_p2p_outbox_message_sequence_value typed_outbox_sequence
    := expected_outboxes, distinct_outboxes =
        erp_p2p_recursive_outbox_authority_runtime outbox_sequence
    := _ =
        assert_erp_p2p_recursive_outbox_authority_runtime expected_outboxes distinct_outboxes
    := store_version = erp_p2p_event_store_length store
    := outbox_version = erp_p2p_event_outbox_length outbox
    := _ =
        assert_erp_p2p_four_event_store_runtime store_version outbox_version
            "goods-partially-received"
            "goods-partially-received"
    := reopened_payload_sequence
