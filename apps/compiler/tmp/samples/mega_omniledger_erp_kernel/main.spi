        writer.HasExited && spins < 5000 do (System.Threading.Thread.Sleep(1); spins <- spins + 1) in let \
        preparedBefore = if System.IO.File.Exists(prepared) then (new System.IO.FileInfo(prepared)).Length else 0L in \
