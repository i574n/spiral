    := empty
        : typed_fx_hashed_statement_event_log typed_fx_statement_stream_position_zero
            typed_fx_hashed_statement_history_empty
        =
        TypedFxHashedStatementEventLogEmpty
    := applied =
        apply_typed_fx_hashed_statement_command_to_event_log expected_zero primary empty
    := recorded
        : typed_fx_hashed_statement_event_log typed_fx_hashed_primary_position typed_fx_hashed_primary_history
        =
        ?= applied ?|
        | TypedFxHashedStatementEventStoreApplied (_, _, _, after, _) => after
    TypedFxHashedStatementClosedHistoryEmpty (
        empty,
        "the-empty-history-state-authorizes-only-the-first-apply"),
    TypedFxHashedStatementClosedHistoryRecorded (
        recorded,
        "the-recorded-history-state-authorizes-retry-collision-or-conflict")

