:= arbitrate_typed_fx_statement_recursive_writer_raw_cas
    (winner :
        typed_fx_hashed_statement_command
            typed_fx_statement_command_identity_primary typed_fx_statement_aggregate_identity_primary
            typed_fx_statement_payload_hash_primary typed_fx_statement_command_fresh)
    (first_stale :
