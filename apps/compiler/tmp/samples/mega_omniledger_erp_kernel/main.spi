:= ^ typed_fx_hashed_statement_membership_lookup_program_runtime \* position history.
    (log : typed_fx_hashed_statement_event_log position history)
    (program : typed_fx_hashed_statement_membership_lookup_program history)
    : i64 * i64 * i64 * i64 * i64 * i64 =
    ?= program ?|
    | TypedFxHashedStatementMembershipLookupProgramOne payload =>
        := \? command_identity aggregate_identity payload_hash. proof, _ = payload
        := command = lookup_typed_fx_hashed_statement_history_by_membership log proof
        := statements, debit, credit, mismatch =
            typed_fx_hashed_statement_applied_command_summary command
        1i64,
        typed_fx_hashed_statement_history_contains_depth proof,
        statements, debit, credit, mismatch
    | TypedFxHashedStatementMembershipLookupProgramMore payload =>
        := \? command_identity aggregate_identity payload_hash. proof, tail, _ = payload
        := command = lookup_typed_fx_hashed_statement_history_by_membership log proof
        := statements, debit, credit, mismatch =
            typed_fx_hashed_statement_applied_command_summary command
        := tail_lookups, tail_depth, tail_statements, tail_debit, tail_credit, tail_mismatch =
            typed_fx_hashed_statement_membership_lookup_program_runtime log tail
        runtime_add_i64 1i64 tail_lookups,
        runtime_add_i64 (typed_fx_hashed_statement_history_contains_depth proof) tail_depth,
        runtime_add_i64 statements tail_statements,
        runtime_add_i64 debit tail_debit,
        runtime_add_i64 credit tail_credit,
        runtime_add_i64 mismatch tail_mismatch

:= assert_typed_fx_hashed_statement_membership_lookup_program_runtime
    (lookups : i64) (depth_sum : i64) (statements : i64)
    (debit : i64) (credit : i64) (mismatch : i64)
    : ()
    =
    := ok_0 = !!!!EQ(lookups, 2i64)
    := ok_1 = !!!!EQ(depth_sum, 1i64)
    := ok_2 = !!!!EQ(statements, 6i64)
    := ok_3 = !!!!EQ(debit, 20i64)
    := ok_4 = !!!!EQ(credit, 20i64)
    := ok_5 = !!!!EQ(mismatch, 0i64)
    ? ok_0 && ok_1 && ok_2 && ok_3 && ok_4 && ok_5
    ?> ()
    |: mega_runtime_fail "typed-FX-hashed-statement-membership-lookup-program-runtime-mismatch"

:= typed_fx_hashed_statement_membership_lookup_program_terminal () : string =
    := journals =
        post_typed_fx_determined_journal_program_as_signed_scaled
            (post_typed_fx_determined_rounding_receipt_program
                (typed_fx_determined_rounding_receipt_program_value ()))
    := ledgers = index_typed_fx_signed_scaled_journal_program_by_entity_currency journals
    := statements = consume_typed_fx_signed_scaled_ledger_program_with_matching_keys ledgers
    := primary
        : typed_fx_hashed_statement_command typed_fx_statement_command_identity_primary
            typed_fx_statement_aggregate_identity_primary typed_fx_statement_payload_hash_primary
            typed_fx_statement_command_fresh
        =
        typed_fx_hashed_statement_command (
            typed_fx_statement_command_identity_primary "lookup-program-primary-command",
            typed_fx_statement_aggregate_identity_primary "lookup-program-primary-aggregate",
            typed_fx_statement_payload_hash_primary "lookup-program-primary-payload",
            typed_fx_statement_command (statements, "the-primary-batch-query-owns-derived-statements"),
            "the-primary-batch-query-is-recorded-first")
    := secondary
        : typed_fx_hashed_statement_command typed_fx_statement_command_identity_secondary
            typed_fx_statement_aggregate_identity_primary typed_fx_statement_payload_hash_primary
            typed_fx_statement_command_fresh
        =
        typed_fx_hashed_statement_command (
            typed_fx_statement_command_identity_secondary "lookup-program-secondary-command",
            typed_fx_statement_aggregate_identity_primary "lookup-program-secondary-aggregate",
            typed_fx_statement_payload_hash_primary "lookup-program-secondary-payload",
            typed_fx_statement_command (statements, "the-secondary-batch-query-owns-derived-statements"),
            "the-secondary-batch-query-is-recorded-second")
    := empty
        : typed_fx_hashed_statement_event_log typed_fx_statement_stream_position_zero
            typed_fx_hashed_statement_history_empty
        =
        TypedFxHashedStatementEventLogEmpty
    := first =
        apply_typed_fx_hashed_statement_command_to_event_log
            (
                TypedFxStatementExpectedStreamPosition (
                    TypedFxStatementStreamPositionZeroValue,
                    "lookup-program-first-position"
                )
            )
            primary
            empty
    := recorded
        : typed_fx_hashed_statement_event_log typed_fx_hashed_primary_position typed_fx_hashed_primary_history
        =
        ?= first ?|
        | TypedFxHashedStatementEventStoreApplied (_, _, _, after, _) => after
    := second =
        apply_typed_fx_hashed_statement_command_to_event_log
            (
                TypedFxStatementExpectedStreamPosition (
                    TypedFxStatementStreamPositionNextValue (
                        TypedFxStatementStreamPositionZeroValue,
                        "lookup-program-second-position"
                    ),
                    "lookup-program-second-position-is-exact"
                )
            )
            secondary
            recorded
    := log : typed_fx_hashed_statement_event_log typed_fx_hashed_secondary_position typed_fx_hashed_secondary_history =
        ?= second ?|
        | TypedFxHashedStatementEventStoreApplied (_, _, _, after, _) => after
    := primary_proof
        : typed_fx_hashed_statement_history_contains typed_fx_statement_command_identity_primary
            typed_fx_statement_aggregate_identity_primary typed_fx_statement_payload_hash_primary
            typed_fx_hashed_secondary_history
        =
        TypedFxHashedStatementHistoryContainsThere (
            TypedFxHashedStatementHistoryContainsHere
                "the-primary-query-is-one-cell-below-the-head",
            "the-primary-query-crosses-the-newer-secondary-cell")
    := secondary_proof
        : typed_fx_hashed_statement_history_contains typed_fx_statement_command_identity_secondary
            typed_fx_statement_aggregate_identity_primary typed_fx_statement_payload_hash_primary
            typed_fx_hashed_secondary_history
        =
        TypedFxHashedStatementHistoryContainsHere
            "the-secondary-query-is-the-current-history-head"
    := program =
        TypedFxHashedStatementMembershipLookupProgramMore (\? (
            primary_proof,
            TypedFxHashedStatementMembershipLookupProgramOne (\? (
                secondary_proof,
                "the-secondary-query-closes-the-batch")),
            "the-primary-query-precedes-the-secondary-query"))
    := lookups, depth_sum, statement_cells, debit, credit, mismatch =
        typed_fx_hashed_statement_membership_lookup_program_runtime log program
    := _ =
        assert_typed_fx_hashed_statement_membership_lookup_program_runtime
            lookups depth_sum statement_cells debit credit mismatch
    "one-recursive-membership-lookup-program-now-runs-arbitrarily-many-typed-queries-against-the-same-history-and-e"
    ^^ "ach-cell-recovers-its-applied-command-only-through-the-cell-specific-membership-proof-so-the-active-primary-se"
    ^^ "condary-batch-closes-two-lookups-depth-sum-one-six-statements-and-balanced-totals-without-caller-supplied-comm"
    ^^ "ands-while-total-value-level-identity-search-and-physical-durability-remain-open-sealed"

:= ^ append_typed_fx_hashed_statement_membership_lookup_program \* history.
    (left : typed_fx_hashed_statement_membership_lookup_program history)
    (right : typed_fx_hashed_statement_membership_lookup_program history)
    : typed_fx_hashed_statement_membership_lookup_program history =
    ?= left ?|
    | TypedFxHashedStatementMembershipLookupProgramOne payload =>
        := \? command_identity aggregate_identity payload_hash. proof, note = payload
        TypedFxHashedStatementMembershipLookupProgramMore (\? (
            proof,
            right,
            note))
    | TypedFxHashedStatementMembershipLookupProgramMore payload =>
        := \? command_identity aggregate_identity payload_hash. proof, tail, note = payload
        TypedFxHashedStatementMembershipLookupProgramMore (\? (
            proof,
            append_typed_fx_hashed_statement_membership_lookup_program tail right,
            note))

:= assert_typed_fx_hashed_statement_membership_lookup_program_append_runtime
    (direct_lookups : i64) (direct_depth : i64) (direct_statements : i64)
    (direct_debit : i64) (direct_credit : i64) (direct_mismatch : i64)
    (left_lookups : i64) (right_lookups : i64)
    (left_depth : i64) (right_depth : i64)
    (left_statements : i64) (right_statements : i64)
    (left_debit : i64) (right_debit : i64)
    (left_credit : i64) (right_credit : i64)
    (left_mismatch : i64) (right_mismatch : i64)
    : ()
    =
    := term_0 = !!!!Add(left_lookups, right_lookups)
    := ok_0 = !!!!EQ(direct_lookups, term_0)
    := term_1 = !!!!Add(left_depth, right_depth)
    := ok_1 = !!!!EQ(direct_depth, term_1)
    := term_2 = !!!!Add(left_statements, right_statements)
    := ok_2 = !!!!EQ(direct_statements, term_2)
    := term_3 = !!!!Add(left_debit, right_debit)
    := ok_3 = !!!!EQ(direct_debit, term_3)
    := term_4 = !!!!Add(left_credit, right_credit)
    := ok_4 = !!!!EQ(direct_credit, term_4)
    := term_5 = !!!!Add(left_mismatch, right_mismatch)
    := ok_5 = !!!!EQ(direct_mismatch, term_5)
    ? ok_0 && ok_1 && ok_2 && ok_3 && ok_4 && ok_5
    ?> ()
    |: mega_runtime_fail "typed-FX-hashed-statement-membership-lookup-program-append-runtime-mismatch"

