            (typed_fx_hashed_statement_history_more
                command_identity aggregate_identity payload_hash history))
    : typed_fx_hashed_statement_history_contains
        command_identity aggregate_identity payload_hash
        (typed_fx_hashed_statement_history_more
            command_identity aggregate_identity payload_hash history) =
    ?= recorded ?|
    | TypedFxHashedStatementEventLogMore _ =>
