        erp_rate_five_proof (),
        erp_rate_one_proof ())

inl typed_fx_fractional_safe_ceiling_runtime
    forall source target input numerator denominator quotient remainder product scaled rounded adjustment.
    (decision : typed_fx_fractional_safe_ceiling_decision source target input numerator denominator quotient remainder product scaled rounded adjustment)
    : i64 * i64 * i64 * i64 * i64 =
