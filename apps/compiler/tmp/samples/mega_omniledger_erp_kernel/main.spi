inl erp_settle_payment_operation_payload_frame forall result.
    (operation : erp_op intercompany_netted payment_settled result) : string =
    match operation with
    | SettlePayment (invoice_value, payment_value, route, payment_document_value) =>
        match invoice_value with
        | invoice_match (invoice_entity, invoice_currency, invoice_item, invoice_location, invoice_jurisdiction, invoice_document, invoice_identity) =>
            match payment_value with
            | money (payment_currency, payment_scale, payment_amount) =>
                inl numerator, denominator = settlement_fx_route_ratio route
                $"(let fields = [| \"SettlePayment\"; !invoice_entity; !invoice_currency; !invoice_item; !invoice_location; !invoice_jurisdiction; !invoice_document; !invoice_identity; !payment_currency; string !payment_scale; string !payment_amount; \"2026-07\"; string !numerator; string !denominator; !payment_document_value |] in let bytes = fields |> Array.collect (fun value -> let payload = System.Text.Encoding.UTF8.GetBytes(value) in let length = System.BitConverter.GetBytes(System.Net.IPAddress.HostToNetworkOrder(payload.Length)) in Array.append length payload) in System.Convert.ToBase64String(bytes))"

