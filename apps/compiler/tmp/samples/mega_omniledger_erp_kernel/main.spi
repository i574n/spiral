    typed_fx_determined_rounding_step
        usd eur erp_rate_one erp_rate_two erp_rate_two
        erp_rate_one nat_zero erp_rate_two erp_rate_two
        erp_rate_one =
    TypedFxDeterminedCeilingStep (exists (
        typed_usd_eur_fractional_exact_safe_ceiling_decision ()))

inl typed_usd_eur_fractional_determined_positive_ceiling_step () :
    typed_fx_determined_rounding_step
        usd eur erp_rate_three erp_rate_three erp_rate_two
        erp_rate_four erp_rate_one erp_rate_nine erp_rate_eight
