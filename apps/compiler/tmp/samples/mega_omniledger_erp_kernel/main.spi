    | TypedFxStatementRecursiveWriterRawCasRejected (_, _) =>
        applied, 0i64, conflicts, stale_event_views,
        committed_events, restart_events, 0i64, 1i64

:= assert_typed_fx_statement_recursive_writer_restart_invariant_runtime
    (applied : i64) (expected_conflicts : i64)
