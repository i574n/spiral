        TypedFxSignedScaledEntityCurrencyLedgerProgramDone
    | TypedFxSignedScaledBalancedJournalProgramMore (head, tail, _) =>
        ?= head ?|
        | ExistentialTypedFxSignedScaledBalancedJournal payload =>
            := \? entity source target input numerator denominator quotient remainder product scaled output.
                journal, note = payload
            TypedFxSignedScaledEntityCurrencyLedgerProgramMore (
                ExistentialTypedFxSignedScaledEntityCurrencyLedger (\? (
                    index_typed_fx_signed_scaled_journal_by_entity_currency journal,
                    note)),
                index_typed_fx_signed_scaled_journal_program_by_entity_currency tail,
                "the-next-journal-is-indexed-without-reclassifying-its-entity-or-currency")

:= typed_fx_signed_scaled_entity_currency_ledger_runtime
    \* entity source target input numerator denominator quotient remainder product scaled output.
    (ledger :
        typed_fx_signed_scaled_entity_currency_ledger
            entity source target input numerator denominator quotient remainder product scaled output)
    : i64 * i64 * i64 * i64 * i64
    =
    ?= ledger ?|
    | typed_fx_signed_scaled_entity_currency_ledger (_, _, journal, _) =>
        := journals, scales, debit, credit, mismatch =
            typed_fx_signed_scaled_balanced_journal_runtime journal
        journals, scales, debit, credit, mismatch

:! typed_fx_entity_currency_key entity target =
    entity * typed_fx_currency_witness target

:! typed_fx_signed_scaled_entity_currency_statement
    entity source target input numerator denominator quotient remainder product scaled output =
    typed_fx_entity_currency_key entity target *
    typed_fx_signed_scaled_entity_currency_ledger
        entity source target input numerator denominator quotient remainder product scaled output * string

:= consume_typed_fx_signed_scaled_ledger_with_matching_key
    \* entity source target input numerator denominator quotient remainder product scaled output.
    (ledger :
        typed_fx_signed_scaled_entity_currency_ledger
            entity source target input numerator denominator quotient remainder product scaled output)
    : typed_fx_signed_scaled_entity_currency_statement entity source target input numerator denominator quotient
        remainder product scaled output
    =
    ?= ledger ?|
    | typed_fx_signed_scaled_entity_currency_ledger (
        entity_value, currency_value, _, _) =>
        typed_fx_signed_scaled_entity_currency_statement (
            typed_fx_entity_currency_key (entity_value, currency_value),
            ledger,
            "the-statement-consumer-key-is-derived-from-the-ledger-indices-and-cannot-be-reclassified")

:| existential_typed_fx_signed_scaled_entity_currency_statement =
    | ExistentialTypedFxSignedScaledEntityCurrencyStatement ::
        (\? entity source target input numerator denominator quotient remainder product scaled output.
            typed_fx_signed_scaled_entity_currency_statement
                entity source target input numerator denominator quotient remainder product scaled output * string) ->
        existential_typed_fx_signed_scaled_entity_currency_statement

:| ^ typed_fx_signed_scaled_entity_currency_statement_program =
    | TypedFxSignedScaledEntityCurrencyStatementProgramDone
    | TypedFxSignedScaledEntityCurrencyStatementProgramMore ::
        existential_typed_fx_signed_scaled_entity_currency_statement *
        typed_fx_signed_scaled_entity_currency_statement_program * string ->
        typed_fx_signed_scaled_entity_currency_statement_program

:= ^ consume_typed_fx_signed_scaled_ledger_program_with_matching_keys
    (program : typed_fx_signed_scaled_entity_currency_ledger_program)
    : typed_fx_signed_scaled_entity_currency_statement_program =
    ?= program ?|
    | TypedFxSignedScaledEntityCurrencyLedgerProgramDone =>
        TypedFxSignedScaledEntityCurrencyStatementProgramDone
    | TypedFxSignedScaledEntityCurrencyLedgerProgramMore (head, tail, _) =>
        ?= head ?|
        | ExistentialTypedFxSignedScaledEntityCurrencyLedger payload =>
            := \? entity source target input numerator denominator quotient remainder product scaled output.
                ledger, note = payload
            TypedFxSignedScaledEntityCurrencyStatementProgramMore (
                ExistentialTypedFxSignedScaledEntityCurrencyStatement (\? (
                    consume_typed_fx_signed_scaled_ledger_with_matching_key ledger,
                    note)),
                consume_typed_fx_signed_scaled_ledger_program_with_matching_keys tail,
                "the-next-statement-consumer-retains-the-ledger-entity-and-currency-key")

:= typed_fx_signed_scaled_entity_currency_statement_runtime
    \* entity source target input numerator denominator quotient remainder product scaled output.
    (statement :
        typed_fx_signed_scaled_entity_currency_statement
            entity source target input numerator denominator quotient remainder product scaled output)
    : i64 * i64 * i64 * i64 * i64
    =
    ?= statement ?|
    | typed_fx_signed_scaled_entity_currency_statement (_, ledger, _) =>
        typed_fx_signed_scaled_entity_currency_ledger_runtime ledger

:= ^ typed_fx_signed_scaled_entity_currency_statement_program_runtime
    (program : typed_fx_signed_scaled_entity_currency_statement_program)
    : i64 * i64 * i64 * i64 * i64 * i64 =
    ?= program ?|
    | TypedFxSignedScaledEntityCurrencyStatementProgramDone =>
        0i64, 0i64, 0i64, 0i64, 0i64, 0i64
    | TypedFxSignedScaledEntityCurrencyStatementProgramMore (head, tail, _) =>
        := statements, currencies, debit, credit, mismatch =
            ?= head ?|
            | ExistentialTypedFxSignedScaledEntityCurrencyStatement payload =>
                := \? entity source target input numerator denominator quotient remainder product scaled output.
                    statement, _ = payload
                typed_fx_signed_scaled_entity_currency_statement_runtime statement
        := tail_statements, tail_entities, tail_currencies,
            tail_debit, tail_credit, tail_mismatch =
            typed_fx_signed_scaled_entity_currency_statement_program_runtime tail
        runtime_add_i64 statements tail_statements,
        runtime_add_i64 1i64 tail_entities,
        runtime_add_i64 currencies tail_currencies,
        runtime_add_i64 debit tail_debit,
        runtime_add_i64 credit tail_credit,
        runtime_add_i64 mismatch tail_mismatch

:! typed_fx_statement_command_fresh = string
:! typed_fx_statement_command_applied = string

:! typed_fx_statement_command state =
    typed_fx_signed_scaled_entity_currency_statement_program * string

:| typed_fx_statement_command_transition before after =
    | TypedFxStatementCommandApply ::
        typed_fx_statement_command typed_fx_statement_command_fresh * string ->
        typed_fx_statement_command_transition
            typed_fx_statement_command_fresh
            typed_fx_statement_command_applied

:= apply_typed_fx_statement_command_once
    (command : typed_fx_statement_command typed_fx_statement_command_fresh)
    : typed_fx_statement_command_transition
        typed_fx_statement_command_fresh
        typed_fx_statement_command_applied =
    TypedFxStatementCommandApply (
        command,
        "the-applied-command-is-derived-from-the-fresh-command-so-source-and-target-programs-cannot-diverge")

:! typed_fx_statement_command_identity_primary = string
:! typed_fx_statement_stream_position_zero = string
:! typed_fx_statement_stream_position_next prior = prior * string

:| ^ typed_fx_statement_stream_position_value position =
    | TypedFxStatementStreamPositionZeroValue ::
        typed_fx_statement_stream_position_value
            typed_fx_statement_stream_position_zero
    | TypedFxStatementStreamPositionNextValue :: \* prior.
        typed_fx_statement_stream_position_value prior * string ->
        typed_fx_statement_stream_position_value
            (typed_fx_statement_stream_position_next prior)

:= ^ typed_fx_statement_stream_position_value_runtime \* position.
    (position : typed_fx_statement_stream_position_value position) : i64 =
    ?= position ?|
    | TypedFxStatementStreamPositionZeroValue => 0i64
    | TypedFxStatementStreamPositionNextValue (prior, _) =>
        runtime_add_i64
            (typed_fx_statement_stream_position_value_runtime prior)
            1i64

:| ^ typed_fx_statement_stream_position_serialized position =
    | TypedFxStatementStreamPositionSerializedZero ::
        typed_fx_statement_stream_position_serialized
            typed_fx_statement_stream_position_zero
    | TypedFxStatementStreamPositionSerializedNext :: \* prior.
        typed_fx_statement_stream_position_serialized prior ->
        typed_fx_statement_stream_position_serialized
            (typed_fx_statement_stream_position_next prior)

:= ^ serialize_typed_fx_statement_stream_position \* position.
    (position : typed_fx_statement_stream_position_value position)
    : typed_fx_statement_stream_position_serialized position =
    ?= position ?|
    | TypedFxStatementStreamPositionZeroValue =>
        TypedFxStatementStreamPositionSerializedZero
    | TypedFxStatementStreamPositionNextValue (prior, _) =>
        TypedFxStatementStreamPositionSerializedNext
            (serialize_typed_fx_statement_stream_position prior)

:= ^ deserialize_typed_fx_statement_stream_position \* position.
    (serialized : typed_fx_statement_stream_position_serialized position)
    : typed_fx_statement_stream_position_value position =
    ?= serialized ?|
    | TypedFxStatementStreamPositionSerializedZero =>
        TypedFxStatementStreamPositionZeroValue
    | TypedFxStatementStreamPositionSerializedNext prior =>
        TypedFxStatementStreamPositionNextValue (
            deserialize_typed_fx_statement_stream_position prior,
            "the-decoder-reconstructs-the-indexed-successor-from-the-serialized-predecessor")

:= ^ typed_fx_statement_stream_position_serialized_runtime \* position.
    (serialized : typed_fx_statement_stream_position_serialized position) : i64 =
    ?= serialized ?|
    | TypedFxStatementStreamPositionSerializedZero => 1i64
    | TypedFxStatementStreamPositionSerializedNext prior =>
        runtime_add_i64
            (typed_fx_statement_stream_position_serialized_runtime prior)
            1i64

:= assert_typed_fx_statement_stream_position_serialized_runtime
    (encoded_cells : i64) (decoded_position : i64) : () =
    := ok_0 = !!!!EQ(encoded_cells, 2i64)
    := ok_1 = !!!!EQ(decoded_position, 1i64)
    ? ok_0 && ok_1 ?> () |: mega_runtime_fail "typed-FX-statement-stream-position-serialization-runtime-mismatch"

:= typed_fx_statement_stream_position_serialization_terminal () : string =
    := position
        : typed_fx_statement_stream_position_value
            (typed_fx_statement_stream_position_next typed_fx_statement_stream_position_zero)
        =
        TypedFxStatementStreamPositionNextValue (
            TypedFxStatementStreamPositionZeroValue,
            "the-structural-successor-is-serialized-from-its-indexed-predecessor")
    := serialized =
        serialize_typed_fx_statement_stream_position position
    := encoded_cells =
        typed_fx_statement_stream_position_serialized_runtime serialized
    := decoded =
        deserialize_typed_fx_statement_stream_position serialized
    := decoded_position =
        typed_fx_statement_stream_position_value_runtime decoded
    := _ =
        assert_typed_fx_statement_stream_position_serialized_runtime
            encoded_cells decoded_position
    "the-stream-position-now-roundtrips-through-a-canonical-structural-serialization-and-an-index-preserving-decode"
    ^^ "r-so-zero-cannot-decode-as-successor-and-one-successor-reconstructs-position-one-sealed"

