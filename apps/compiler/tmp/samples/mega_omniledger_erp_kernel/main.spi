            (typed_fx_hashed_statement_identity_collision_depth tail)

inl typed_fx_hashed_statement_proven_retry_runtime forall position history.
    (result : typed_fx_hashed_statement_proven_retry_result position history)
    : i64 * i64 * i64 * i64 =
    match result with
    | TypedFxHashedStatementProvenRetryDuplicateResult decision =>
        inl _, duplicate, _, _, events, _, _, _, mismatch =
            typed_fx_hashed_statement_event_store_decision_runtime decision
        duplicate, 0i64, events, mismatch
    | TypedFxHashedStatementProvenRetryCollisionResult decision =>
        inl _, _, collision, _, events, _, _, _, mismatch =
            typed_fx_hashed_statement_event_store_decision_runtime decision
        0i64, collision, events, mismatch

inl assert_typed_fx_hashed_statement_proven_retry_runtime
    (duplicate : i64) (collision : i64)
    (duplicate_events : i64) (collision_events : i64)
    (duplicate_depth : i64) (collision_depth : i64)
    (top_membership_depth : i64) (top_collision_depth : i64)
    (mismatch : i64) : () =
    inl ok_0 = !!!!EQ(duplicate, 1i64)
    inl ok_1 = !!!!EQ(collision, 1i64)
    inl ok_2 = !!!!EQ(duplicate_events, 2i64)
    inl ok_3 = !!!!EQ(collision_events, 2i64)
    inl ok_4 = !!!!EQ(duplicate_depth, 1i64)
    inl ok_5 = !!!!EQ(collision_depth, 1i64)
    inl ok_6 = !!!!EQ(top_membership_depth, 0i64)
    inl ok_7 = !!!!EQ(top_collision_depth, 0i64)
    inl ok_8 = !!!!EQ(mismatch, 0i64)
    if ok_0 && ok_1 && ok_2 && ok_3 && ok_4 && ok_5 && ok_6 && ok_7 && ok_8 then () else mega_runtime_fail "typed-FX-hashed-statement-proven-retry-runtime-mismatch"

inl typed_fx_hashed_statement_proven_retry_terminal () : string =
    inl journals =
        post_typed_fx_determined_journal_program_as_signed_scaled
            (post_typed_fx_determined_rounding_receipt_program
                (typed_fx_determined_rounding_receipt_program_value ()))
    inl ledgers =
        index_typed_fx_signed_scaled_journal_program_by_entity_currency journals
    inl statements =
        consume_typed_fx_signed_scaled_ledger_program_with_matching_keys ledgers
    inl primary : typed_fx_hashed_statement_command typed_fx_statement_command_identity_primary typed_fx_statement_aggregate_identity_primary typed_fx_statement_payload_hash_primary typed_fx_statement_command_fresh =
        typed_fx_hashed_statement_command (
            typed_fx_statement_command_identity_primary "deep-history-primary-command",
            typed_fx_statement_aggregate_identity_primary "deep-history-primary-aggregate",
            typed_fx_statement_payload_hash_primary "deep-history-primary-payload",
            typed_fx_statement_command (statements, "the-primary-command-owns-the-derived-statements"),
            "the-primary-command-is-derived-before-history-construction")
    inl secondary : typed_fx_hashed_statement_command typed_fx_statement_command_identity_secondary typed_fx_statement_aggregate_identity_primary typed_fx_statement_payload_hash_primary typed_fx_statement_command_fresh =
        typed_fx_hashed_statement_command (
            typed_fx_statement_command_identity_secondary "deep-history-secondary-command",
            typed_fx_statement_aggregate_identity_primary "deep-history-secondary-aggregate",
            typed_fx_statement_payload_hash_primary "deep-history-secondary-payload",
            typed_fx_statement_command (statements, "the-secondary-command-owns-the-same-balanced-statements"),
            "the-secondary-command-becomes-the-newest-history-cell")
    inl empty : typed_fx_hashed_statement_event_log typed_fx_statement_stream_position_zero typed_fx_hashed_statement_history_empty =
        TypedFxHashedStatementEventLogEmpty
    inl first =
        apply_typed_fx_hashed_statement_command_to_event_log
            (TypedFxStatementExpectedStreamPosition (
                TypedFxStatementStreamPositionZeroValue,
                "the-first-command-expects-position-zero"))
            primary empty
    inl recorded : typed_fx_hashed_statement_event_log typed_fx_hashed_primary_position typed_fx_hashed_primary_history =
        match first with
        | TypedFxHashedStatementEventStoreApplied (_, _, _, after, _) => after
    inl second =
        apply_typed_fx_hashed_statement_command_to_event_log
            (TypedFxStatementExpectedStreamPosition (
                TypedFxStatementStreamPositionNextValue (
                    TypedFxStatementStreamPositionZeroValue,
                    "the-second-command-expects-position-one"),
                "the-second-append-is-authorized-by-the-exact-one-position"))
            secondary recorded
    inl two_event_log : typed_fx_hashed_statement_event_log typed_fx_hashed_secondary_position typed_fx_hashed_secondary_history =
        match second with
        | TypedFxHashedStatementEventStoreApplied (_, _, _, after, _) => after
    inl top_membership =
        typed_fx_hashed_statement_top_membership_from_recorded_log two_event_log
    inl top_collision =
        typed_fx_hashed_statement_top_collision_from_recorded_log
            two_event_log
            (TypedFxStatementPayloadHashPrimaryChanged
                "the-generic-top-collision-terminal-supplies-only-the-hash-difference")
    inl top_membership_depth =
        typed_fx_hashed_statement_history_contains_depth top_membership
    inl top_collision_depth =
        typed_fx_hashed_statement_identity_collision_depth top_collision
    inl exact_proof : typed_fx_hashed_statement_history_contains typed_fx_statement_command_identity_primary typed_fx_statement_aggregate_identity_primary typed_fx_statement_payload_hash_primary typed_fx_hashed_secondary_history =
        TypedFxHashedStatementHistoryContainsThere (
            TypedFxHashedStatementHistoryContainsHere
                "the-primary-command-is-found-in-the-tail",
            "the-search-skips-the-newer-secondary-command")
    inl collision_proof : typed_fx_hashed_statement_identity_collision typed_fx_statement_command_identity_primary typed_fx_statement_payload_hash_changed typed_fx_hashed_secondary_history =
        TypedFxHashedStatementIdentityCollisionThere (
            TypedFxHashedStatementIdentityCollisionHere (
                TypedFxStatementPayloadHashPrimaryChanged
                    "the-incoming-primary-identity-carries-a-changed-payload-hash",
                "the-primary-history-cell-proves-the-collision"),
            "the-collision-search-skips-the-newer-secondary-command")
    inl duplicate, _, duplicate_events, duplicate_mismatch =
        typed_fx_hashed_statement_proven_retry_runtime
            (decide_typed_fx_hashed_statement_proven_retry
                two_event_log
                (TypedFxHashedStatementProvenRetryExact exact_proof))
    inl _, collision, collision_events, collision_mismatch =
        typed_fx_hashed_statement_proven_retry_runtime
            (decide_typed_fx_hashed_statement_proven_retry
                two_event_log
                (TypedFxHashedStatementProvenRetryCollision collision_proof))
    inl _ =
        assert_typed_fx_hashed_statement_proven_retry_runtime
            duplicate collision duplicate_events collision_events
            (typed_fx_hashed_statement_history_contains_depth exact_proof)
            (typed_fx_hashed_statement_identity_collision_depth collision_proof)
            top_membership_depth top_collision_depth
            (runtime_add_i64 duplicate_mismatch collision_mismatch)
    "recursive-history-membership-and-collision-witnesses-now-feed-one-generic-retry-consumer-over-a-two-event-log-so-the-primary-command-is-found-one-cell-below-the-head-and-produces-duplicate-or-collision-without-repacking-the-log-while-total-search-proof-generation-physical-CAS-fsync-and-crash-durability-remain-open-sealed"

