    inl reopened_payload, bytes, parse_valid, payload_equal, outbox_equal, digest_equal, prepared_absent, directory_sync, tamper_rejected, cleanup_absent =
        erp_typed_unit_atomic_event_outbox_runtime encoded_payload outbox_message
    inl _ =
