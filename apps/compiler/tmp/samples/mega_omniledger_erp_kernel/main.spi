        assert_typed_fx_statement_physical_commit_roundtrip_runtime
            written digest_bytes recovered digest_equal
    "one-real-host-filesystem-commit-now-encodes-a-canonical-statement-payload-to-bytes-writes-it-through-an-exclus"
    ^^ "ive-FileStream-flushes-the-file-to-stable-storage-renames-the-prepared-file-atomically-within-the-same-directo"
    ^^ "ry-reopens-the-committed-bytes-and-verifies-a-32-byte-SHA256-digest-before-cleanup-while-directory-fsync-inter"
    ^^ "process-compare-and-swap-and-crash-injection-remain-open-sealed"

:= typed_fx_statement_directory_synced_interprocess_cas_runtime () :
    i64 * i64 * i64 * i64 * i64 * i64 * i64 =
