:! typed_fx_statement_durable_prepared = string
:! typed_fx_statement_durable_data_synced = string
:! typed_fx_statement_durable_marker_synced = string

:| ^ typed_fx_statement_durable_commit state =
    | TypedFxStatementDurablePreparedCommit ::
        typed_fx_statement_recursive_writer_raw_cas_schedule * string ->
        typed_fx_statement_durable_commit typed_fx_statement_durable_prepared
    | TypedFxStatementDurableDataSyncedCommit ::
        typed_fx_statement_durable_commit typed_fx_statement_durable_prepared * string ->
        typed_fx_statement_durable_commit typed_fx_statement_durable_data_synced
    | TypedFxStatementDurableMarkerSyncedCommit ::
        typed_fx_statement_durable_commit typed_fx_statement_durable_data_synced * string ->
        typed_fx_statement_durable_commit typed_fx_statement_durable_marker_synced

:| typed_fx_statement_durable_commit_transition before after =
    | TypedFxStatementDurableDataSync ::
        typed_fx_statement_durable_commit typed_fx_statement_durable_prepared *
        typed_fx_statement_durable_commit typed_fx_statement_durable_data_synced * string ->
        typed_fx_statement_durable_commit_transition
            typed_fx_statement_durable_prepared
            typed_fx_statement_durable_data_synced
    | TypedFxStatementDurableMarkerSync ::
        typed_fx_statement_durable_commit typed_fx_statement_durable_data_synced *
        typed_fx_statement_durable_commit typed_fx_statement_durable_marker_synced * string ->
        typed_fx_statement_durable_commit_transition
            typed_fx_statement_durable_data_synced
            typed_fx_statement_durable_marker_synced

:= prepare_typed_fx_statement_durable_commit
    (schedule : typed_fx_statement_recursive_writer_raw_cas_schedule)
    : typed_fx_statement_durable_commit typed_fx_statement_durable_prepared =
    TypedFxStatementDurablePreparedCommit (
        schedule,
        "the-prepared-state-carries-the-exact-recursive-writer-schedule")

:= sync_typed_fx_statement_durable_commit_data
    (commit : typed_fx_statement_durable_commit typed_fx_statement_durable_prepared)
    : typed_fx_statement_durable_commit_transition
        typed_fx_statement_durable_prepared
        typed_fx_statement_durable_data_synced =
    TypedFxStatementDurableDataSync (
        commit,
        TypedFxStatementDurableDataSyncedCommit (
            commit,
            "the-data-synced-state-structurally-contains-the-prepared-state"),
        "data-sync-is-the-only-transition-out-of-prepared")

:= sync_typed_fx_statement_durable_commit_marker
    (commit : typed_fx_statement_durable_commit typed_fx_statement_durable_data_synced)
    : typed_fx_statement_durable_commit_transition
        typed_fx_statement_durable_data_synced
        typed_fx_statement_durable_marker_synced =
    TypedFxStatementDurableMarkerSync (
        commit,
        TypedFxStatementDurableMarkerSyncedCommit (
            commit,
            "the-marker-synced-state-structurally-contains-the-data-synced-state"),
        "marker-sync-is-the-only-transition-that-authorizes-restart")

:= ^ typed_fx_statement_durable_commit_schedule \* state.
    (commit : typed_fx_statement_durable_commit state)
    : typed_fx_statement_recursive_writer_raw_cas_schedule =
    ?= commit ?|
    | TypedFxStatementDurablePreparedCommit (schedule, _) => schedule
    | TypedFxStatementDurableDataSyncedCommit (prepared, _) =>
        typed_fx_statement_durable_commit_schedule prepared
    | TypedFxStatementDurableMarkerSyncedCommit (data_synced, _) =>
        typed_fx_statement_durable_commit_schedule data_synced

:= restart_typed_fx_statement_durable_commit
    (commit : typed_fx_statement_durable_commit typed_fx_statement_durable_marker_synced)
    : i64 * i64 =
    := schedule = typed_fx_statement_durable_commit_schedule commit
    := _, _, _, _, _, _, restart_accepted, mismatch =
        typed_fx_statement_recursive_writer_restart_invariant_runtime schedule
    restart_accepted, mismatch

:= assert_typed_fx_statement_indexed_durable_commit_runtime
    (accepted : i64) (mismatch : i64) : () =
    := ok_0 = !!!!EQ(accepted, 1i64)
    := ok_1 = !!!!EQ(mismatch, 0i64)
    ? ok_0 && ok_1 ?> () |: mega_runtime_fail "typed-FX-statement-indexed-durable-commit-runtime-mismatch"

:= typed_fx_statement_indexed_durable_commit_terminal () : string =
    := prepared =
        prepare_typed_fx_statement_durable_commit
            (typed_fx_statement_recursive_writer_raw_cas_schedule_value ())
    := data_synced =
        ?= sync_typed_fx_statement_durable_commit_data prepared ?|
        | TypedFxStatementDurableDataSync (_, target, _) => target
    := marker_synced =
        ?= sync_typed_fx_statement_durable_commit_marker data_synced ?|
        | TypedFxStatementDurableMarkerSync (_, target, _) => target
    := accepted, mismatch =
        restart_typed_fx_statement_durable_commit marker_synced
    := _ =
        assert_typed_fx_statement_indexed_durable_commit_runtime accepted mismatch
    "restart-authorization-now-requires-a-marker-synced-value-that-structurally-contains-the-data-synced-and-prepar"
