inl erp_p2p_four_event_atomic_payload_outbox_runtime
    (reserve_payload : string) (reserve_outbox : string)
    (approvals_payload : string) (approvals_outbox : string)
    (purchase_payload : string) (purchase_outbox : string)
    (receipt_payload : string) (receipt_outbox : string) :
