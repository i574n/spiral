            typed_fx_statement_payload_hash_primary typed_fx_statement_command_fresh)
    (tail : typed_fx_statement_stale_writer_request_program)
    (bytes : typed_fx_statement_stream_position_raw_bytes)
    : typed_fx_statement_recursive_writer_raw_cas_schedule
    =
    := race =
        arbitrate_typed_fx_statement_two_writer_raw_cas
            winner first_stale bytes
    ?= race ?|
    | TypedFxStatementTwoWriterRawCasAppliedConflict (_, _, second, cells, _) =>
        ?= second ?|
        | TypedFxHashedStatementEventStoreVersionConflict (_, recorded, _) =>
            TypedFxStatementRecursiveWriterRawCasApplied (
                race,
