:! typed_fx_hashed_statement_command
    command_identity aggregate_identity payload_hash state =
    command_identity * aggregate_identity * payload_hash *
    typed_fx_statement_command state * string

:! typed_fx_hashed_statement_history_empty = string
:! typed_fx_hashed_statement_history_more
    command_identity aggregate_identity payload_hash prior =
    command_identity * aggregate_identity * payload_hash * prior * string

:| ^ typed_fx_hashed_statement_event_log position history =
    | TypedFxHashedStatementEventLogEmpty ::
        typed_fx_hashed_statement_event_log
            typed_fx_statement_stream_position_zero
            typed_fx_hashed_statement_history_empty
    | TypedFxHashedStatementEventLogMore ::
        \* position history command_identity aggregate_identity payload_hash.
        typed_fx_hashed_statement_command
            command_identity aggregate_identity payload_hash
            typed_fx_statement_command_applied *
        typed_fx_hashed_statement_event_log position history * string ->
        typed_fx_hashed_statement_event_log
            (typed_fx_statement_stream_position_next position)
            (typed_fx_hashed_statement_history_more
                command_identity aggregate_identity payload_hash history)

:| ^ typed_fx_hashed_statement_history_contains
    command_identity aggregate_identity payload_hash history =
    | TypedFxHashedStatementHistoryContainsHere ::
        \* command_identity aggregate_identity payload_hash prior.
        string ->
        typed_fx_hashed_statement_history_contains
            command_identity aggregate_identity payload_hash
            (typed_fx_hashed_statement_history_more
                command_identity aggregate_identity payload_hash prior)
    | TypedFxHashedStatementHistoryContainsThere ::
        \* command_identity aggregate_identity payload_hash
            other_identity other_aggregate other_hash prior.
        typed_fx_hashed_statement_history_contains
            command_identity aggregate_identity payload_hash prior * string ->
        typed_fx_hashed_statement_history_contains
            command_identity aggregate_identity payload_hash
            (typed_fx_hashed_statement_history_more
                other_identity other_aggregate other_hash prior)

:| ^ typed_fx_hashed_statement_identity_collision
    command_identity incoming_hash history =
    | TypedFxHashedStatementIdentityCollisionHere ::
        \* command_identity aggregate_identity incoming_hash existing_hash prior.
        typed_fx_statement_payload_hash_not_equal incoming_hash existing_hash * string ->
        typed_fx_hashed_statement_identity_collision
            command_identity incoming_hash
