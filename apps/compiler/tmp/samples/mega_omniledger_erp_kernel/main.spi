    := ok_1 = !!!!EQ(left_events, 2i64)
    := ok_2 = !!!!EQ(left_mismatch, 0i64)
    := ok_3 = !!!!EQ(right_conflicts, left_conflicts)
    := ok_4 = !!!!EQ(right_events, left_events)
    := ok_5 = !!!!EQ(right_mismatch, left_mismatch)
    := ok_6 = !!!!EQ(appended_conflicts, 4i64)
    := ok_7 = !!!!EQ(appended_events, 4i64)
    := ok_8 = !!!!EQ(appended_mismatch, 0i64)
