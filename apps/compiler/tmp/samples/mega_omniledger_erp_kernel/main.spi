:| erp_match_invoice_payload_decode_decision =
    | ErpMatchInvoicePayloadDecoded :: string ->
        erp_match_invoice_payload_decode_decision
    | ErpMatchInvoicePayloadRejected :: string ->
        erp_match_invoice_payload_decode_decision

:= erp_match_invoice_payload_decode
    (encoded : string)
    :
        erp_match_invoice_payload_decode_decision
    =
    := field_count, links_bound, quantity_bound, tax_bound,
        identities_bound, roundtrip, digest_bytes, tamper_rejected =
        erp_match_invoice_payload_codec_runtime encoded
    ?=
        field_count,
        links_bound,
        quantity_bound,
        tax_bound,
        identities_bound,
        roundtrip,
        digest_bytes,
        tamper_rejected
    ?|
    | 17i64, 1i64, 1i64, 1i64, 1i64, 1i64, 32i64, 1i64 =>
        ErpMatchInvoicePayloadDecoded (
            "the-decoder-validates-all-seventeen-canonical-MatchInvoice-fields-and-shared-indices-before-producing-"
            ^^ "a-typed-acceptance-witness"
        )
    | _, _, _, _, _, _, _, _ =>
        ErpMatchInvoicePayloadRejected
            "invalid-MatchInvoice-frame-does-not-produce-a-typed-operation"

:= erp_match_invoice_payload_decode_tag
    (decision : erp_match_invoice_payload_decode_decision) : i64 =
    ?= decision ?|
    | ErpMatchInvoicePayloadDecoded _ => 1i64
    | ErpMatchInvoicePayloadRejected _ => 0i64

