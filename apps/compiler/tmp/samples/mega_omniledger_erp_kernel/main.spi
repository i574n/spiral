    (store_valid : i64) (store_frames : i64)
    (outbox_valid : i64) (outbox_frames : i64)
    (store_tamper_rejected : i64) (store_prefix_frames : i64)
    (outbox_tamper_rejected : i64) (outbox_prefix_frames : i64)
    (first_position : i64) (last_position_plus_payload_bytes : i64)
    (primary_frame_aligned : i64) : () =
    inl ok_0 = !!!!EQ(store_valid, 1i64)
    inl ok_1 = !!!!EQ(store_frames, 3i64)
    inl ok_2 = !!!!EQ(outbox_valid, 1i64)
    inl ok_3 = !!!!EQ(outbox_frames, 3i64)
    inl ok_4 = !!!!EQ(store_tamper_rejected, 1i64)
    inl ok_5 = !!!!EQ(store_prefix_frames, 1i64)
    inl ok_6 = !!!!EQ(outbox_tamper_rejected, 1i64)
    inl ok_7 = !!!!EQ(outbox_prefix_frames, 1i64)
    inl ok_8 = !!!!EQ(first_position, 1i64)
    inl ok_9 = !!!!GT(last_position_plus_payload_bytes, 3i64)
    inl ok_10 = !!!!EQ(primary_frame_aligned, 1i64)
    if ok_0 && ok_1 && ok_2 && ok_3 && ok_4 && ok_5 && ok_6 && ok_7 && ok_8 && ok_9 && ok_10 then () else mega_runtime_fail "typed-FX-statement-binary-field-hash-chain-outbox-alignment-runtime-mismatch"

inl typed_fx_statement_binary_field_hash_chain_outbox_alignment_terminal () : string =
    inl journals =
        post_typed_fx_determined_journal_program_as_signed_scaled
            (post_typed_fx_determined_rounding_receipt_program
                (typed_fx_determined_rounding_receipt_program_value ()))
    inl ledgers =
        index_typed_fx_signed_scaled_journal_program_by_entity_currency journals
    inl statements =
        consume_typed_fx_signed_scaled_ledger_program_with_matching_keys ledgers
    inl primary_statements, _, _, primary_debit, primary_credit, primary_mismatch =
        typed_fx_signed_scaled_entity_currency_statement_program_runtime statements
    inl store_valid, store_frames, outbox_valid, outbox_frames,
        store_tamper_rejected, store_prefix_frames,
        outbox_tamper_rejected, outbox_prefix_frames,
        first_position, last_position_plus_payload_bytes,
        primary_frame_aligned =
        typed_fx_statement_binary_field_hash_chain_outbox_alignment_runtime
            primary_statements primary_debit primary_credit primary_mismatch
    inl _ =
        assert_typed_fx_statement_binary_field_hash_chain_outbox_alignment_runtime
            store_valid store_frames outbox_valid outbox_frames
            store_tamper_rejected store_prefix_frames
            outbox_tamper_rejected outbox_prefix_frames
            first_position last_position_plus_payload_bytes primary_frame_aligned
    "the-primary-physical-ERP-frame-now-derives-statement-count-debit-credit-and-mismatch-from-the-same-indexed-statement-program-used-by-the-typed-command-before-those-values-enter-the-length-prefixed-hash-chained-store-and-aligned-outbox-and-replay-confirms-the-first-persisted-frame-is-byte-identical-to-that-derived-projection-while-identity-fields-full-AST-serialization-arbitrary-writer-count-and-recoverable-lock-ownership-remain-open-sealed"

inl erp_p2p_reserve_budget_op () :
    erp_op requisition_drafted budget_reserved
        (requisition company_a usd widget_a * budget_token company_a usd) =
    inl requisition_value : requisition company_a usd widget_a =
        requisition (
            company_a "company-a",
            usd "USD",
            widget_a "widget-a",
            "requisition-1001")
    inl budget_value : budget_token company_a usd =
        budget_token (
            company_a "company-a",
            usd "USD",
            1000i64,
            "budget-reservation-1001")
    ReserveBudget (requisition_value, budget_value)

inl erp_p2p_reserve_budget_plan () :
    erp_plan requisition_drafted budget_reserved =
    ErpStep (exists (erp_p2p_reserve_budget_op ()))

union erp_p2p_unit_event from to =
    | ErpP2PUnitEvent :: forall from to.
        (exists result. erp_op from to result) -> erp_p2p_unit_event from to

union erp_p2p_unit_store from to =
    | ErpP2PUnitStoreOne :: forall from to.
        erp_p2p_unit_event from to -> erp_p2p_unit_store from to

union erp_p2p_unit_outbox from to =
    | ErpP2PUnitOutbox :: forall from to.
        erp_p2p_unit_event from to -> erp_p2p_unit_outbox from to

inl erp_p2p_unit_event_from_op forall from to result.
    (operation : erp_op from to result) : erp_p2p_unit_event from to =
    ErpP2PUnitEvent (exists operation)

inl erp_p2p_unit_store_append forall from to.
    (event : erp_p2p_unit_event from to) : erp_p2p_unit_store from to =
    ErpP2PUnitStoreOne event

inl erp_runtime_p2p_outbox_message (stage : string) : string =
    $"\"erp-p2p-\" + !stage + \"-outbox\""

inl erp_p2p_unit_outbox_project forall from to.
    (event : erp_p2p_unit_event from to) : erp_p2p_unit_outbox from to =
    ErpP2PUnitOutbox event

inl erp_p2p_unit_outbox_message forall from to.
    (outbox : erp_p2p_unit_outbox from to) : string =
    match outbox with
    | ErpP2PUnitOutbox event =>
        match event with
        | ErpP2PUnitEvent payload =>
            inl exists result. operation = payload
            erp_runtime_p2p_outbox_message (terminal (ErpStep (exists operation)))

inl erp_p2p_unit_commit_project forall from to.
    (event : erp_p2p_unit_event from to) :
    erp_p2p_unit_store from to * erp_p2p_unit_outbox from to =
    erp_p2p_unit_store_append event, erp_p2p_unit_outbox_project event

inl erp_p2p_unit_store_replay forall from to.
    (store : erp_p2p_unit_store from to) : erp_plan from to =
    match store with
    | ErpP2PUnitStoreOne event =>
        match event with
        | ErpP2PUnitEvent payload =>
            inl exists result. operation = payload
            ErpStep (exists operation)

inl erp_p2p_unit_outbox_replay forall from to.
    (outbox : erp_p2p_unit_outbox from to) : erp_plan from to =
    match outbox with
    | ErpP2PUnitOutbox event =>
        match event with
        | ErpP2PUnitEvent payload =>
            inl exists result. operation = payload
            ErpStep (exists operation)

inl erp_p2p_unit_event_plan forall from to.
    (event : erp_p2p_unit_event from to) : erp_plan from to =
    match event with
    | ErpP2PUnitEvent payload =>
        inl exists result. operation = payload
        ErpStep (exists operation)

union rec erp_p2p_event_store version from to =
    | ErpP2PEventStoreOne :: forall from to.
        erp_p2p_unit_event from to -> erp_p2p_event_store nat_one from to
    | ErpP2PEventStoreThen :: forall version from to.
        (exists left_version right_version middle.
            erp_p2p_event_store left_version from middle *
            erp_p2p_event_store right_version middle to *
            nat_add left_version right_version version) ->
        erp_p2p_event_store version from to

union rec erp_p2p_event_outbox version from to =
    | ErpP2PEventOutboxOne :: forall from to.
        erp_p2p_unit_event from to ->
        erp_p2p_event_outbox nat_one from to
    | ErpP2PEventOutboxThen :: forall version from to.
        (exists left_version right_version middle.
            erp_p2p_event_outbox left_version from middle *
            erp_p2p_event_outbox right_version middle to *
            nat_add left_version right_version version) ->
        erp_p2p_event_outbox version from to

union rec erp_p2p_event_commit_tree version from to =
    | ErpP2PEventCommitTreeOne :: forall from to.
        erp_p2p_unit_event from to ->
        erp_p2p_event_commit_tree nat_one from to
    | ErpP2PEventCommitTreeThen :: forall version from to.
        (exists left_version right_version middle.
            erp_p2p_event_commit_tree left_version from middle *
            erp_p2p_event_commit_tree right_version middle to *
            nat_add left_version right_version version) ->
        erp_p2p_event_commit_tree version from to

inl rec erp_p2p_event_commit_tree_identity forall version from to.
    (commit : erp_p2p_event_commit_tree version from to) : string =
    match commit with
    | ErpP2PEventCommitTreeOne event =>
        erp_p2p_unit_outbox_message (erp_p2p_unit_outbox_project event)
    | ErpP2PEventCommitTreeThen payload =>
        inl exists left_version right_version middle. left, right, _ = payload
        inl left_identity = erp_p2p_event_commit_tree_identity left
        inl right_identity = erp_p2p_event_commit_tree_identity right
        $"!left_identity + \">\" + !right_identity"

nominal erp_p2p_event_commit_authority version from to =
    erp_p2p_event_commit_tree version from to

inl erp_p2p_event_commit_tree_authority forall version from to.
    (tree : erp_p2p_event_commit_tree version from to) :
    erp_p2p_event_commit_authority version from to =
    erp_p2p_event_commit_authority tree

inl erp_p2p_event_commit_authority_tree forall version from to.
    (authority : erp_p2p_event_commit_authority version from to) :
    erp_p2p_event_commit_tree version from to =
    match authority with
    | erp_p2p_event_commit_authority tree => tree

inl erp_p2p_event_commit_authority_runtime_identity forall version from to.
    (authority : erp_p2p_event_commit_authority version from to) : string =
    match authority with
    | erp_p2p_event_commit_authority tree =>
        inl tree_identity = erp_p2p_event_commit_tree_identity tree
        $"!tree_identity + \"|aggregate=erp-p2p-aggregate:\" + !tree_identity + \"|command=erp-p2p-command:\" + !tree_identity"

inl rec erp_p2p_event_commit_tree_store forall version from to.
    (commit : erp_p2p_event_commit_tree version from to)
    : erp_p2p_event_store version from to =
    match commit with
    | ErpP2PEventCommitTreeOne event =>
        ErpP2PEventStoreOne event
    | ErpP2PEventCommitTreeThen payload =>
        inl exists left_version right_version middle. left, right, sum = payload
        ErpP2PEventStoreThen (exists (
            erp_p2p_event_commit_tree_store left,
            erp_p2p_event_commit_tree_store right,
            sum))

inl rec erp_p2p_event_commit_tree_outbox forall version from to.
    (commit : erp_p2p_event_commit_tree version from to)
    : erp_p2p_event_outbox version from to =
    match commit with
    | ErpP2PEventCommitTreeOne event =>
        ErpP2PEventOutboxOne event
    | ErpP2PEventCommitTreeThen payload =>
        inl exists left_version right_version middle. left, right, sum = payload
        ErpP2PEventOutboxThen (exists (
            erp_p2p_event_commit_tree_outbox left,
            erp_p2p_event_commit_tree_outbox right,
            sum))

inl erp_p2p_event_commit_tree_project forall version from to.
    (commit : erp_p2p_event_commit_tree version from to) :
    erp_p2p_event_store version from to *
        erp_p2p_event_outbox version from to =
    erp_p2p_event_commit_tree_store commit,
    erp_p2p_event_commit_tree_outbox commit

inl erp_p2p_event_commit_one forall from to.
    (event : erp_p2p_unit_event from to) :
    erp_p2p_event_store nat_one from to * erp_p2p_event_outbox nat_one from to =
    erp_p2p_event_commit_tree_project (ErpP2PEventCommitTreeOne event)

inl erp_p2p_event_commit_then forall from middle to.
    (left : erp_p2p_unit_event from middle)
    (right : erp_p2p_unit_event middle to) :
    erp_p2p_event_store nat_two from to * erp_p2p_event_outbox nat_two from to =
    inl left_commit = ErpP2PEventCommitTreeOne left
    inl right_commit = ErpP2PEventCommitTreeOne right
    erp_p2p_event_commit_tree_project (
        ErpP2PEventCommitTreeThen (exists (
            left_commit,
            right_commit,
            v65_add_one_one_two ())))

inl rec erp_p2p_event_store_version forall version from to.
    (store : erp_p2p_event_store version from to) : runtime_money_nat version =
    match store with
    | ErpP2PEventStoreOne _ => RuntimeMoneySucc RuntimeMoneyZero
    | ErpP2PEventStoreThen payload =>
        inl exists left_version right_version middle. left, right, sum = payload
        runtime_money_nat_add
            sum
            (erp_p2p_event_store_version left)
            (erp_p2p_event_store_version right)

inl rec erp_p2p_event_outbox_version forall version from to.
    (outbox : erp_p2p_event_outbox version from to) : runtime_money_nat version =
    match outbox with
    | ErpP2PEventOutboxOne _ => RuntimeMoneySucc RuntimeMoneyZero
    | ErpP2PEventOutboxThen payload =>
        inl exists left_version right_version middle. left, right, sum = payload
        runtime_money_nat_add
            sum
            (erp_p2p_event_outbox_version left)
            (erp_p2p_event_outbox_version right)

inl rec erp_p2p_event_store_replay forall version from to.
    (store : erp_p2p_event_store version from to) : erp_plan from to =
    match store with
    | ErpP2PEventStoreOne event =>
        erp_p2p_unit_event_plan event
    | ErpP2PEventStoreThen payload =>
        inl exists left_version right_version middle. left, right, _ = payload
        ErpThen (exists (
            erp_p2p_event_store_replay left,
            erp_p2p_event_store_replay right))

inl rec erp_p2p_event_outbox_replay forall version from to.
    (outbox : erp_p2p_event_outbox version from to) : erp_plan from to =
    match outbox with
    | ErpP2PEventOutboxOne event =>
        erp_p2p_unit_event_plan event
    | ErpP2PEventOutboxThen payload =>
        inl exists left_version right_version middle. left, right, _ = payload
        ErpThen (exists (
            erp_p2p_event_outbox_replay left,
            erp_p2p_event_outbox_replay right))

inl erp_p2p_event_store_length forall version from to.
    (store : erp_p2p_event_store version from to) : i64 =
    runtime_money_nat_to_i64 (erp_p2p_event_store_version store)

inl erp_p2p_event_outbox_length forall version from to.
    (outbox : erp_p2p_event_outbox version from to) : i64 =
    runtime_money_nat_to_i64 (erp_p2p_event_outbox_version outbox)

inl erp_p2p_collect_approvals_op () :
    erp_op budget_reserved approvals_collected (approval_quorum po_1001) =
    CollectApprovals (approvals ())

inl erp_p2p_collect_approvals_plan () :
    erp_plan budget_reserved approvals_collected =
    ErpStep (exists (erp_p2p_collect_approvals_op ()))

inl assert_erp_p2p_two_event_store_runtime
    (store_length : i64) (outbox_length : i64)
    (store_stage : string) (outbox_stage : string) : () =
    $"if !store_length <> 2L || !outbox_length <> 2L || !store_stage <> \"approvals-collected\" || !outbox_stage <> \"approvals-collected\" then failwith \"erp-p2p-two-event-store-runtime-mismatch\""

inl erp_p2p_two_event_store_terminal () : string =
    inl reserve_event =
        erp_p2p_unit_event_from_op (erp_p2p_reserve_budget_op ())
    inl approvals_event =
        erp_p2p_unit_event_from_op (erp_p2p_collect_approvals_op ())
    inl store, outbox =
        erp_p2p_event_commit_then reserve_event approvals_event
    inl store_plan = erp_p2p_event_store_replay store
    inl outbox_plan = erp_p2p_event_outbox_replay outbox
    inl store_length = erp_p2p_event_store_length store
    inl outbox_length = erp_p2p_event_outbox_length outbox
    inl store_stage = terminal store_plan
    inl outbox_stage = terminal outbox_plan
    inl _ =
        assert_erp_p2p_two_event_store_runtime
            store_length outbox_length store_stage outbox_stage
    "the-active-P2P-type-level-store-now-commits-two-endpoint-linked-events-ReserveBudget-then-CollectApprovals-and-replays-the-same-two-step-plan-from-both-store-and-outbox-without-a-one-event-capacity-limit"

inl erp_p2p_event_store_then forall left_version right_version version from middle to.
    (left : erp_p2p_event_store left_version from middle)
    (right : erp_p2p_event_store right_version middle to)
    (sum : nat_add left_version right_version version) :
    erp_p2p_event_store version from to =
    ErpP2PEventStoreThen (exists (left, right, sum))

inl erp_p2p_event_outbox_then forall left_version right_version version from middle to.
    (left : erp_p2p_event_outbox left_version from middle)
    (right : erp_p2p_event_outbox right_version middle to)
    (sum : nat_add left_version right_version version) :
    erp_p2p_event_outbox version from to =
    ErpP2PEventOutboxThen (exists (left, right, sum))

inl erp_p2p_issue_purchase_order_op_from_upstream
    (reserve_operation :
        erp_op requisition_drafted budget_reserved
            (requisition company_a usd widget_a * budget_token company_a usd))
    (approval_operation :
        erp_op budget_reserved approvals_collected (approval_quorum po_1001)) :
    erp_op approvals_collected purchase_order_issued
        (purchase_order company_a usd widget_a po_1001) =
    match reserve_operation, approval_operation with
    | ReserveBudget (_, budget_value), CollectApprovals approval_value =>
        inl quantity_value : quantity widget_a each =
            quantity (
                widget_a "widget-a",
                each "each",
                10i64)
        inl purchase_order_value : purchase_order company_a usd widget_a po_1001 =
            purchase_order (
                company_a "company-a",
                usd "USD",
                widget_a "widget-a",
                po_1001 "po-1001",
                "purchase-order-issued-1001")
        IssuePurchaseOrder (
            budget_value,
            approval_value,
            quantity_value,
            purchase_order_value)

inl erp_p2p_issue_purchase_order_op () :
    erp_op approvals_collected purchase_order_issued
        (purchase_order company_a usd widget_a po_1001) =
    erp_p2p_issue_purchase_order_op_from_upstream
        (erp_p2p_reserve_budget_op ())
        (erp_p2p_collect_approvals_op ())

inl erp_p2p_issue_purchase_order_plan () :
    erp_plan approvals_collected purchase_order_issued =
    ErpStep (exists (erp_p2p_issue_purchase_order_op ()))

inl assert_erp_p2p_three_event_store_runtime
    (store_length : i64) (outbox_length : i64)
    (store_stage : string) (outbox_stage : string) : () =
    $"if !store_length <> 3L || !outbox_length <> 3L || !store_stage <> \"purchase-order-issued\" || !outbox_stage <> \"purchase-order-issued\" then failwith \"erp-p2p-three-event-store-runtime-mismatch\""

inl erp_p2p_three_event_store_terminal () : string =
    inl reserve_event =
        erp_p2p_unit_event_from_op (erp_p2p_reserve_budget_op ())
    inl approvals_event =
        erp_p2p_unit_event_from_op (erp_p2p_collect_approvals_op ())
    inl purchase_order_event =
        erp_p2p_unit_event_from_op (erp_p2p_issue_purchase_order_op ())
    inl first_store, first_outbox =
        erp_p2p_event_commit_then reserve_event approvals_event
    inl final_store, final_outbox =
        erp_p2p_event_commit_one purchase_order_event
    inl store = erp_p2p_event_store_then first_store final_store (v65_add_two_one_three ())
    inl outbox = erp_p2p_event_outbox_then first_outbox final_outbox (v65_add_two_one_three ())
    inl store_plan = erp_p2p_event_store_replay store
    inl outbox_plan = erp_p2p_event_outbox_replay outbox
    inl store_length = erp_p2p_event_store_length store
    inl outbox_length = erp_p2p_event_outbox_length outbox
    inl store_stage = terminal store_plan
    inl outbox_stage = terminal outbox_plan
    inl _ =
        assert_erp_p2p_three_event_store_runtime
            store_length outbox_length store_stage outbox_stage
    "the-type-level-P2P-store-and-outbox-now-compose-three-endpoint-linked-events-through-a-recursive-store-concatenation-and-replay-the-same-purchase-order-issued-plan"

inl erp_p2p_receive_partial_goods_op_from_upstream
    (purchase_order_operation :
        erp_op approvals_collected purchase_order_issued
            (purchase_order company_a usd widget_a po_1001)) :
    erp_op purchase_order_issued goods_partially_received
        (receipt company_a usd widget_a warehouse_north po_1001) =
    match purchase_order_operation with
    | IssuePurchaseOrder (_, _, ordered_quantity_value, purchase_order_value) =>
        inl received_quantity_value : quantity widget_a each =
            quantity (
                widget_a "widget-a",
                each "each",
                6i64)
        inl quantity_authority : ordered_partial_quantity widget_a each =
            OrderedPartialQuantity (
                ordered_quantity_value,
                received_quantity_value)
        inl _ = validate_ordered_partial_quantity quantity_authority
        ReceivePartialGoods (
            purchase_order_value,
            quantity_authority,
            warehouse_north "warehouse-north",
            "partial-receipt-north-1001")

inl erp_p2p_receive_partial_goods_op () :
    erp_op purchase_order_issued goods_partially_received
        (receipt company_a usd widget_a warehouse_north po_1001) =
    erp_p2p_receive_partial_goods_op_from_upstream
        (erp_p2p_issue_purchase_order_op ())

inl erp_p2p_receive_partial_goods_plan () :
    erp_plan purchase_order_issued goods_partially_received =
    ErpStep (exists (erp_p2p_receive_partial_goods_op ()))

inl erp_p2p_four_event_commit_tree () :
    erp_p2p_event_commit_tree nat_four requisition_drafted goods_partially_received =
    inl reserve_event =
        erp_p2p_unit_event_from_op (erp_p2p_reserve_budget_op ())
    inl approvals_event =
        erp_p2p_unit_event_from_op (erp_p2p_collect_approvals_op ())
    inl purchase_order_event =
        erp_p2p_unit_event_from_op (erp_p2p_issue_purchase_order_op ())
    inl receipt_event =
        erp_p2p_unit_event_from_op (erp_p2p_receive_partial_goods_op ())
    inl reserve_commit = ErpP2PEventCommitTreeOne reserve_event
    inl approvals_commit = ErpP2PEventCommitTreeOne approvals_event
    inl purchase_order_commit = ErpP2PEventCommitTreeOne purchase_order_event
    inl receipt_commit = ErpP2PEventCommitTreeOne receipt_event
    inl first_two =
        ErpP2PEventCommitTreeThen (exists (
            reserve_commit,
            approvals_commit,
            v65_add_one_one_two ()))
    inl first_three =
        ErpP2PEventCommitTreeThen (exists (
            first_two,
            purchase_order_commit,
            v65_add_two_one_three ()))
    inl all_four =
        ErpP2PEventCommitTreeThen (exists (
            first_three,
            receipt_commit,
            v65_add_three_one_four ()))
    all_four

inl erp_p2p_four_event_commit () :
    erp_p2p_event_store nat_four requisition_drafted goods_partially_received *
        erp_p2p_event_outbox nat_four requisition_drafted goods_partially_received =
    erp_p2p_event_commit_tree_project (erp_p2p_four_event_commit_tree ())

inl erp_p2p_receive_partial_goods_receipt
    (operation :
        erp_op purchase_order_issued goods_partially_received
            (receipt company_a usd widget_a warehouse_north po_1001)) :
    receipt company_a usd widget_a warehouse_north po_1001 =
    match operation with
    | ReceivePartialGoods (purchase_order_value, quantity_authority, location_value, note) =>
        match purchase_order_value, validate_ordered_partial_quantity quantity_authority with
        | purchase_order (entity_value, currency_value, item_value, document_value, _),
          quantity (_, _, received_amount) =>
            receipt (
                entity_value,
                currency_value,
                item_value,
                location_value,
                document_value,
                received_amount,
                note)

inl erp_p2p_receive_partial_goods_tax_witness
    (receipt_operation :
        erp_op purchase_order_issued goods_partially_received
            (receipt company_a usd widget_a warehouse_north po_1001)) :
    tax_witness tax_brazil usd po_1001 =
    match erp_p2p_receive_partial_goods_receipt receipt_operation with
    | receipt (_, currency_value, _, _, document_value, _, _) =>
        tax_witness (
            tax_brazil "BR",
            currency_value,
            document_value,
            170i64,
            "tax-witness-br-1001-sealed-by-the-upstream-receipt-stage")

nominal erp_p2p_receive_partial_goods_tax_authority =
    erp_op purchase_order_issued goods_partially_received
        (receipt company_a usd widget_a warehouse_north po_1001) *
    tax_witness tax_brazil usd po_1001

inl erp_p2p_receive_partial_goods_tax_authority_make () :
    erp_p2p_receive_partial_goods_tax_authority =
    inl receipt_operation = erp_p2p_receive_partial_goods_op ()
    inl tax_value = erp_p2p_receive_partial_goods_tax_witness receipt_operation
    erp_p2p_receive_partial_goods_tax_authority (receipt_operation, tax_value)

inl erp_p2p_receive_partial_goods_tax_authority_project
    (authority : erp_p2p_receive_partial_goods_tax_authority) :
    erp_op purchase_order_issued goods_partially_received
        (receipt company_a usd widget_a warehouse_north po_1001) *
    tax_witness tax_brazil usd po_1001 =
    match authority with
    | erp_p2p_receive_partial_goods_tax_authority payload => payload

inl erp_p2p_match_invoice_tax_authority_project
    (authority :
        erp_p2p_receipt_tax_authority company_a usd widget_a warehouse_north tax_brazil po_1001) :
    receipt company_a usd widget_a warehouse_north po_1001 *
        tax_witness tax_brazil usd po_1001 =
    match authority with
    | erp_p2p_receipt_tax_authority payload => payload

inl erp_p2p_match_invoice_op () :
    erp_op goods_partially_received invoice_three_way_matched
        (invoice_match company_a usd widget_a warehouse_north tax_brazil po_1001) =
    inl upstream_authority = erp_p2p_receive_partial_goods_tax_authority_make ()
    inl receipt_operation, tax_value =
        erp_p2p_receive_partial_goods_tax_authority_project upstream_authority
    inl purchase_order_value : purchase_order company_a usd widget_a po_1001 =
        match receipt_operation with
        | ReceivePartialGoods (purchase_order_value, _, _, _) => purchase_order_value
    inl receipt_value = erp_p2p_receive_partial_goods_receipt receipt_operation
    MatchInvoice (purchase_order_value, receipt_value, tax_value)

inl erp_p2p_match_invoice_plan () :
    erp_plan goods_partially_received invoice_three_way_matched =
    ErpStep (exists (erp_p2p_match_invoice_op ()))

inl erp_p2p_match_invoice_result
    (operation :
        erp_op goods_partially_received invoice_three_way_matched
            (invoice_match company_a usd widget_a warehouse_north tax_brazil po_1001)) :
    invoice_match company_a usd widget_a warehouse_north tax_brazil po_1001 =
    match operation with
    | MatchInvoice (purchase_order_value, receipt_value, tax_value) =>
        match purchase_order_value, receipt_value, tax_value with
        | purchase_order (entity_value, currency_value, item_value, document_value, _),
          receipt (_, _, _, location_value, _, _, _),
          tax_witness (jurisdiction_value, _, _, _, _) =>
            invoice_match (
                entity_value,
                currency_value,
                item_value,
                location_value,
                jurisdiction_value,
                document_value,
                "invoice-match-1001")

inl erp_p2p_net_intercompany_op () :
    erp_op invoice_three_way_matched intercompany_netted
        (mirror_entry company_a company_b usd po_1001 *
            invoice_match company_a usd widget_a warehouse_north tax_brazil po_1001) =
    inl invoice_value :
        invoice_match company_a usd widget_a warehouse_north tax_brazil po_1001 =
        erp_p2p_match_invoice_result (erp_p2p_match_invoice_op ())
    inl mirrors : opposed_mirror_pair company_a company_b usd po_1001 =
        OpposedMirrorPair (
            company_a "company-a",
            company_b "company-b",
            usd "USD",
            po_1001 "po-1001",
            830i64,
            "company-a-intercompany-receivable-830",
            "company-b-intercompany-payable-minus-830")
    NetIntercompany (invoice_value, mirrors)

inl erp_p2p_net_intercompany_op_from_decoded_match_invoice
    (decoded_operation :
        erp_op goods_partially_received invoice_three_way_matched
            (invoice_match company_a usd widget_a warehouse_north tax_brazil po_1001)) :
    erp_op invoice_three_way_matched intercompany_netted
        (mirror_entry company_a company_b usd po_1001 *
            invoice_match company_a usd widget_a warehouse_north tax_brazil po_1001) =
    inl invoice_value = erp_p2p_match_invoice_result decoded_operation
    inl mirrors : opposed_mirror_pair company_a company_b usd po_1001 =
        OpposedMirrorPair (
            company_a "company-a",
            company_b "company-b",
            usd "USD",
            po_1001 "po-1001",
            830i64,
            "company-a-intercompany-receivable-830",
            "company-b-intercompany-payable-minus-830")
    NetIntercompany (invoice_value, mirrors)

inl erp_p2p_net_intercompany_mirror_runtime
    (operation :
        erp_op invoice_three_way_matched intercompany_netted
            (mirror_entry company_a company_b usd po_1001 *
                invoice_match company_a usd widget_a warehouse_north tax_brazil po_1001))
    : i64 * i64 =
    match operation with
    | NetIntercompany (_, mirrors) =>
        match opposed_mirror_pair_left mirrors, opposed_mirror_pair_right mirrors with
        | mirror_entry (_, _, _, _, left_amount, _),
          mirror_entry (_, _, _, _, right_amount, _) =>
            left_amount, right_amount

inl assert_erp_p2p_net_intercompany_runtime
    (left_amount : i64) (right_amount : i64) (stage : string) : () =
    $"if !left_amount <> 830L || !right_amount <> -830L || !left_amount + !right_amount <> 0L || !stage <> \"intercompany-netted\" then failwith \"erp-p2p-net-intercompany-runtime-mismatch\""

inl erp_p2p_net_intercompany_terminal () : string =
    inl operation = erp_p2p_net_intercompany_op ()
    inl left_amount, right_amount =
        erp_p2p_net_intercompany_mirror_runtime operation
    inl stage = terminal (ErpStep (exists operation))
    inl _ =
        assert_erp_p2p_net_intercompany_runtime
            left_amount right_amount stage
    "NetIntercompany-now-derives-both-company-mirror-entries-from-one-opposed-mirror-pair-authority-so-plus-plus-detached-mirrors-are-not-an-inhabitant-of-the-domain-operation-while-arbitrary-field-decoding-remains-open"

inl erp_net_intercompany_operation_payload_frame forall result.
    (operation : erp_op invoice_three_way_matched intercompany_netted result) : string =
    match operation with
    | NetIntercompany (invoice_value, mirrors) =>
        inl left_mirror = opposed_mirror_pair_left mirrors
        inl right_mirror = opposed_mirror_pair_right mirrors
        match invoice_value with
        | invoice_match (invoice_entity, invoice_currency, invoice_item, invoice_location, invoice_jurisdiction, invoice_document, invoice_identity) =>
            match left_mirror with
            | mirror_entry (left_entity, left_counterparty, left_currency, left_document, left_amount, left_identity) =>
                match right_mirror with
                | mirror_entry (right_entity, right_counterparty, right_currency, right_document, right_amount, right_identity) =>
                    $"(let fields = [| !invoice_entity; !invoice_currency; !invoice_item; !invoice_location; !invoice_jurisdiction; !invoice_document; !invoice_identity; !left_entity; !left_counterparty; !left_currency; !left_document; string !left_amount; !left_identity; !right_entity; !right_counterparty; !right_currency; !right_document; string !right_amount; !right_identity |] in let bytes = fields |> Array.collect (fun value -> let payload = System.Text.Encoding.UTF8.GetBytes(value) in let length = System.BitConverter.GetBytes(System.Net.IPAddress.HostToNetworkOrder(payload.Length)) in Array.append length payload) in System.Convert.ToBase64String(bytes))"

inl erp_net_intercompany_payload_frame_runtime (encoded : string) : i64 * i64 =
    $"(int64 (System.Convert.FromBase64String(!encoded).Length), int64 (System.Security.Cryptography.SHA256.HashData(System.Text.Encoding.UTF8.GetBytes(!encoded)).Length))"

inl assert_erp_net_intercompany_payload_frame_runtime (bytes : i64) (digest : i64) : () =
    inl ok_0 = !!!!GT(bytes, 0i64)
    inl ok_1 = !!!!EQ(digest, 32i64)
    if ok_0 && ok_1 then () else mega_runtime_fail "erp-NetIntercompany-payload-frame-runtime-mismatch"

inl erp_net_intercompany_payload_frame_terminal () : string =
    inl operation = erp_p2p_net_intercompany_op ()
    inl encoded = erp_net_intercompany_operation_payload_frame operation
    inl bytes, digest = erp_net_intercompany_payload_frame_runtime encoded
    inl left_amount, right_amount = erp_p2p_net_intercompany_mirror_runtime operation
    inl stage = terminal (ErpStep (exists operation))
    inl _ = assert_erp_net_intercompany_payload_frame_runtime bytes digest
    inl _ = assert_erp_p2p_net_intercompany_runtime left_amount right_amount stage
    "one-NetIntercompany-operation-authority-now-derives-the-opposed-mirror-amounts-stage-and-canonical-length-prefixed-payload-frame-in-the-same-active-terminal-before-SHA256-validation-so-the-codec-no-longer-reconstructs-a-parallel-domain-operation-while-total-decoding-and-sixth-event-persistence-remain-open"

union erp_net_intercompany_payload_decode_decision =
    | ErpNetIntercompanyPayloadDecoded :: string ->
        erp_net_intercompany_payload_decode_decision
    | ErpNetIntercompanyPayloadRejected :: string ->
        erp_net_intercompany_payload_decode_decision

inl erp_net_intercompany_payload_validate_runtime (encoded : string) : i64 =
    $"(let tryDecode (text : string) = try let bytes = System.Convert.FromBase64String(text) in let mutable offset = 0 in let fields = System.Collections.Generic.List<string>() in let mutable valid = true in while valid && offset < bytes.Length do if offset + 4 > bytes.Length then valid <- false else let raw = System.BitConverter.ToInt32(bytes, offset) |> System.Net.IPAddress.NetworkToHostOrder in offset <- offset + 4; if raw < 0 || offset + raw > bytes.Length then valid <- false else fields.Add(System.Text.Encoding.UTF8.GetString(bytes, offset, raw)); offset <- offset + raw done; if valid && offset = bytes.Length then Some(fields.ToArray()) else None with _ -> None in let expected = [| \"company-a\"; \"USD\"; \"widget-a\"; \"warehouse-north\"; \"BR\"; \"po-1001\"; \"invoice-match-1001\"; \"company-a\"; \"company-b\"; \"USD\"; \"po-1001\"; \"830\"; \"company-a-intercompany-receivable-830\"; \"company-b\"; \"company-a\"; \"USD\"; \"po-1001\"; \"-830\"; \"company-b-intercompany-payable-minus-830\" |] in match tryDecode !encoded with Some fields when fields.Length = expected.Length && Array.forall2 (=) fields expected -> (match System.Int64.TryParse(fields.[11]), System.Int64.TryParse(fields.[17]) with (true,left),(true,right) when left = 830L && right = -830L && left + right = 0L -> 1L | _ -> 0L) | _ -> 0L)"

inl erp_net_intercompany_payload_decode (encoded : string) :
    erp_net_intercompany_payload_decode_decision =
    match erp_net_intercompany_payload_validate_runtime encoded with
    | 1i64 =>
        ErpNetIntercompanyPayloadDecoded
            "the-decoder-validates-all-nineteen-canonical-NetIntercompany-fields-and-opposed-mirror-amounts-before-producing-a-typed-acceptance-witness"
    | _ =>
        ErpNetIntercompanyPayloadRejected
            "invalid-or-truncated-NetIntercompany-frame-does-not-produce-a-typed-operation"

inl erp_net_intercompany_payload_decode_invoice_fields_runtime (encoded : string) :
    string * string * string * string * string * string * string =
    $"(let tryDecode (text : string) = try let bytes = System.Convert.FromBase64String(text) in let mutable offset = 0 in let fields = System.Collections.Generic.List<string>() in let mutable valid = true in while valid && offset < bytes.Length do if offset + 4 > bytes.Length then valid <- false else let raw = System.BitConverter.ToInt32(bytes, offset) |> System.Net.IPAddress.NetworkToHostOrder in offset <- offset + 4; if raw < 0 || offset + raw > bytes.Length then valid <- false else fields.Add(System.Text.Encoding.UTF8.GetString(bytes, offset, raw)); offset <- offset + raw done; if valid && offset = bytes.Length then Some(fields.ToArray()) else None with _ -> None in match tryDecode !encoded with Some fields when fields.Length = 19 && fields.[0] = \"company-a\" && fields.[1] = \"USD\" && fields.[2] = \"widget-a\" && fields.[3] = \"warehouse-north\" && fields.[4] = \"BR\" && fields.[5] = \"po-1001\" && fields.[6].Length > 0 -> fields.[0],fields.[1],fields.[2],fields.[3],fields.[4],fields.[5],fields.[6] | _ -> failwith \"erp-NetIntercompany-typed-decode-invalid-invoice-fields\")"

inl erp_net_intercompany_payload_decode_mirror_authority_fields_runtime (encoded : string) :
    string * string * string * string * i64 * string * string =
    $"(let tryDecode (text : string) = try let bytes = System.Convert.FromBase64String(text) in let mutable offset = 0 in let fields = System.Collections.Generic.List<string>() in let mutable valid = true in while valid && offset < bytes.Length do if offset + 4 > bytes.Length then valid <- false else let raw = System.BitConverter.ToInt32(bytes, offset) |> System.Net.IPAddress.NetworkToHostOrder in offset <- offset + 4; if raw < 0 || offset + raw > bytes.Length then valid <- false else fields.Add(System.Text.Encoding.UTF8.GetString(bytes, offset, raw)); offset <- offset + raw done; if valid && offset = bytes.Length then Some(fields.ToArray()) else None with _ -> None in match tryDecode !encoded with Some fields when fields.Length = 19 && fields.[7] = \"company-a\" && fields.[8] = \"company-b\" && fields.[9] = \"USD\" && fields.[10] = \"po-1001\" && fields.[12].Length > 0 && fields.[18].Length > 0 -> (match System.Int64.TryParse(fields.[11]) with true,leftAmount when leftAmount = 830L -> fields.[7],fields.[8],fields.[9],fields.[10],leftAmount,fields.[12],fields.[18] | _ -> failwith \"erp-NetIntercompany-typed-decode-invalid-left-mirror-amount\") | _ -> failwith \"erp-NetIntercompany-typed-decode-invalid-mirror-authority-fields\")"

inl erp_net_intercompany_payload_decode_typed_operation encoded =
    match erp_net_intercompany_payload_decode encoded with
    | ErpNetIntercompanyPayloadDecoded _ =>
        inl invoice_entity, invoice_currency, invoice_item, invoice_location,
            invoice_jurisdiction, invoice_document, invoice_identity =
            erp_net_intercompany_payload_decode_invoice_fields_runtime encoded
        inl left_entity, right_entity, mirror_currency, mirror_document,
            left_amount, left_identity, right_identity =
            erp_net_intercompany_payload_decode_mirror_authority_fields_runtime encoded
        inl invoice_value :
            invoice_match company_a usd widget_a warehouse_north tax_brazil po_1001 =
            invoice_match (
                company_a invoice_entity,
                usd invoice_currency,
                widget_a invoice_item,
                warehouse_north invoice_location,
                tax_brazil invoice_jurisdiction,
                po_1001 invoice_document,
                invoice_identity)
        inl mirrors : opposed_mirror_pair company_a company_b usd po_1001 =
            OpposedMirrorPair (
                company_a left_entity,
                company_b right_entity,
                usd mirror_currency,
                po_1001 mirror_document,
                left_amount,
                left_identity,
                right_identity)
        NetIntercompany (invoice_value, mirrors)
    | ErpNetIntercompanyPayloadRejected note =>
        $"failwith (\"canonical-NetIntercompany-bytes-could-not-reconstruct-typed-operation:\" + !note)"

inl assert_erp_net_intercompany_payload_typed_decode_roundtrip_runtime
    (encoded : string) (reencoded : string) : () =
    join $"if !encoded <> !reencoded then failwith \"erp-NetIntercompany-typed-decode-roundtrip-mismatch\""

union erp_net_intercompany_typed_decode_authority =
    | ErpNetIntercompanyTypedDecodeAuthority :
        string *
        erp_op invoice_three_way_matched intercompany_netted
            (mirror_entry company_a company_b usd po_1001 *
                invoice_match company_a usd widget_a warehouse_north tax_brazil po_1001) *
        string

inl erp_net_intercompany_typed_decode_authority_from_bytes (encoded : string) :
    erp_net_intercompany_typed_decode_authority =
    inl decoded_operation = erp_net_intercompany_payload_decode_typed_operation encoded
    inl reencoded = erp_net_intercompany_operation_payload_frame decoded_operation
    inl _ = assert_erp_net_intercompany_payload_typed_decode_roundtrip_runtime encoded reencoded
    ErpNetIntercompanyTypedDecodeAuthority (encoded, decoded_operation, reencoded)

inl erp_net_intercompany_payload_decode_tag
    (decision : erp_net_intercompany_payload_decode_decision) : i64 =
    match decision with
    | ErpNetIntercompanyPayloadDecoded _ => 1i64
    | ErpNetIntercompanyPayloadRejected _ => 0i64

inl assert_erp_net_intercompany_payload_codec_runtime
    (accepted : i64) (truncated_rejected : i64) : () =
    inl ok_0 = !!!!EQ(accepted, 1i64)
    inl ok_1 = !!!!EQ(truncated_rejected, 1i64)
    if ok_0 && ok_1 then () else mega_runtime_fail "erp-NetIntercompany-payload-codec-runtime-mismatch"

inl erp_net_intercompany_payload_codec_terminal () : string =
    inl operation = erp_p2p_net_intercompany_op ()
    inl encoded = erp_net_intercompany_operation_payload_frame operation
    inl accepted = erp_net_intercompany_payload_decode encoded
    inl truncated : string =
        $"if !encoded.Length > 4 then !encoded.Substring(0, !encoded.Length - 4) else \"\""
    inl rejected = erp_net_intercompany_payload_decode truncated
    inl accepted_tag = erp_net_intercompany_payload_decode_tag accepted
    inl rejected_tag = erp_net_intercompany_payload_decode_tag rejected
    inl _ =
        assert_erp_net_intercompany_payload_codec_runtime
            accepted_tag (erp_runtime_add_i64 1i64 (erp_runtime_mul_i64 -1i64 rejected_tag))
    match accepted with
    | ErpNetIntercompanyPayloadDecoded _ =>
        inl decoded_operation = erp_net_intercompany_payload_decode_typed_operation encoded
        inl reencoded = erp_net_intercompany_operation_payload_frame decoded_operation
        inl _ : () =
            inl ok_0 = !!!!EQ(reencoded, encoded)
            if ok_0 then () else mega_runtime_fail "erp-NetIntercompany-field-derived-operation-roundtrip-mismatch"
        inl left_amount, right_amount =
            erp_p2p_net_intercompany_mirror_runtime decoded_operation
        inl _ =
            assert_erp_p2p_net_intercompany_runtime
                left_amount right_amount (terminal (ErpStep (exists decoded_operation)))
        "NetIntercompany-now-has-a-nineteen-field-canonical-frame-and-a-fail-closed-decoder-that-reconstructs-the-exact-result-indexed-operation-only-after-entity-counterparty-currency-document-and-opposed-mirror-amount-bindings-validate"
    | ErpNetIntercompanyPayloadRejected note =>
        $"failwith (\"canonical-NetIntercompany-frame-was-rejected:\" + !note)"

inl erp_net_intercompany_decoded_invoice
    (decoded_operation :
        erp_op invoice_three_way_matched intercompany_netted
            (mirror_entry company_a company_b usd po_1001 *
                invoice_match company_a usd widget_a warehouse_north tax_brazil po_1001)) :
    invoice_match company_a usd widget_a warehouse_north tax_brazil po_1001 =
    match decoded_operation with
    | NetIntercompany (invoice_value, _) => invoice_value

inl erp_p2p_settlement_fx_route () :
    settlement_fx_route usd brl period_2026_07 =
    SettlementFxCompose (exists (
        SettlementFxUsdEurJuly (2i64, 1i64),
        SettlementFxEurBrlJuly (3i64, 1i64)))

inl erp_p2p_settlement_payment () : money brl i64 =
    money (brl "BRL", 2i64, 4980i64)

inl erp_p2p_settle_payment_from_decoded_net
    (decoded_operation :
        erp_op invoice_three_way_matched intercompany_netted
            (mirror_entry company_a company_b usd po_1001 *
                invoice_match company_a usd widget_a warehouse_north tax_brazil po_1001)) :
    erp_op intercompany_netted payment_settled
        (payment_receipt company_a brl widget_a warehouse_north tax_brazil payment_3001 *
            settlement_fx_route usd brl period_2026_07 *
            invoice_match company_a usd widget_a warehouse_north tax_brazil po_1001) =
    SettlePayment (
        erp_net_intercompany_decoded_invoice decoded_operation,
        erp_p2p_settlement_payment (),
        erp_p2p_settlement_fx_route (),
        payment_3001 "payment-3001")

inl erp_p2p_settle_payment_result
    (operation :
        erp_op intercompany_netted payment_settled
            (payment_receipt company_a brl widget_a warehouse_north tax_brazil payment_3001 *
                settlement_fx_route usd brl period_2026_07 *
                invoice_match company_a usd widget_a warehouse_north tax_brazil po_1001)) :
    payment_receipt company_a brl widget_a warehouse_north tax_brazil payment_3001 =
    match operation with
    | SettlePayment (invoice_value, payment_amount, _, payment_document_value) =>
        match invoice_value with
        | invoice_match (entity_value, _, item_value, location_value, jurisdiction_value, _, _) =>
            match payment_amount with
            | money (target_currency_value, _, _) =>
                payment_receipt (
                    entity_value,
                    target_currency_value,
                    item_value,
                    location_value,
                    jurisdiction_value,
                    payment_document_value,
                    "payment-receipt-3001")

inl erp_p2p_close_period_from_decoded_net
    (decoded_operation :
        erp_op invoice_three_way_matched intercompany_netted
            (mirror_entry company_a company_b usd po_1001 *
                invoice_match company_a usd widget_a warehouse_north tax_brazil po_1001)) :
    erp_op payment_settled period_closed
        (close_certificate company_a period_2026_07 ifrs) =
    inl payment_value :
        payment_receipt company_a brl widget_a warehouse_north tax_brazil payment_3001 =
        erp_p2p_settle_payment_result (
            erp_p2p_settle_payment_from_decoded_net decoded_operation)
    inl projection :
        gaap_projection
            (payment_receipt company_a brl widget_a warehouse_north tax_brazil payment_3001)
            ifrs string =
        ProjectIfrs (payment_value, "ifrs-close-2026-07")
    ClosePeriod (
        payment_value,
        period_2026_07 "2026-07",
        projection)

inl erp_p2p_close_period_op () :
    erp_op payment_settled period_closed
        (close_certificate company_a period_2026_07 ifrs) =
    erp_p2p_close_period_from_decoded_net (erp_p2p_net_intercompany_op ())

inl assert_erp_p2p_settle_payment_from_decoded_runtime
    (numerator : i64) (denominator : i64) (stage : string) : () =
    $"if !numerator <> 6L || !denominator <> 1L || !stage <> \"payment-settled-through-composed-typed-fx-route\" then failwith \"erp-p2p-settle-payment-from-decoded-runtime-mismatch\""

inl erp_p2p_settle_payment_from_decoded_terminal () : string =
    inl encoded =
        erp_net_intercompany_operation_payload_frame (erp_p2p_net_intercompany_op ())
    match erp_net_intercompany_typed_decode_authority_from_bytes encoded with
    | ErpNetIntercompanyTypedDecodeAuthority (authority_bytes, decoded_operation, reencoded) =>
        inl _ = assert_erp_net_intercompany_payload_typed_decode_roundtrip_runtime encoded authority_bytes
        inl _ = assert_erp_net_intercompany_payload_typed_decode_roundtrip_runtime authority_bytes reencoded
        inl settlement =
            erp_p2p_settle_payment_from_decoded_net decoded_operation
        match settlement with
        | SettlePayment (_, _, route, _) =>
            inl numerator, denominator = settlement_fx_route_ratio route
