:= erp_settle_payment_payload_decode_invoice_fields_runtime (encoded : string) :
    string * string * string * string * string * string * string =
    $"(let tryDecode (text : string) = try let bytes = System.Convert.FromBase64String(text) in let mutable offset = \
        0 in let fields = System.Collections.Generic.List<string>() in let mutable valid = true in while valid && \
        offset < bytes.Length do if offset + 4 > bytes.Length then valid <- false else let raw = \
        System.BitConverter.ToInt32(bytes, offset) |> System.Net.IPAddress.NetworkToHostOrder in offset <- offset + \
        4; if raw < 0 || offset + raw > bytes.Length then valid <- false else \
        fields.Add(System.Text.Encoding.UTF8.GetString(bytes, offset, raw)); offset <- offset + raw done; if valid && \
        offset = bytes.Length then Some(fields.ToArray()) else None with _ -> None in match tryDecode !encoded with \
        Some fields when fields.Length = 15 && fields.[0] = \"SettlePayment\" && fields.[1] = \"company-a\" && \
        fields.[2] = \"USD\" && fields.[3] = \"widget-a\" && fields.[4] = \"warehouse-north\" && fields.[5] = \"BR\" \
        && fields.[6] = \"po-1001\" && fields.[7].Length > 0 -> \
        fields.[1],fields.[2],fields.[3],fields.[4],fields.[5],fields.[6],fields.[7] | _ -> failwith \
        \"erp-SettlePayment-typed-decode-invalid-invoice-fields\")"

:= erp_settle_payment_payload_decode_payment_fields_runtime (encoded : string) :
    string * i64 * i64 =
    $"(let tryDecode (text : string) = try let bytes = System.Convert.FromBase64String(text) in let mutable offset = \
        0 in let fields = System.Collections.Generic.List<string>() in let mutable valid = true in while valid && \
        offset < bytes.Length do if offset + 4 > bytes.Length then valid <- false else let raw = \
        System.BitConverter.ToInt32(bytes, offset) |> System.Net.IPAddress.NetworkToHostOrder in offset <- offset + \
        4; if raw < 0 || offset + raw > bytes.Length then valid <- false else \
        fields.Add(System.Text.Encoding.UTF8.GetString(bytes, offset, raw)); offset <- offset + raw done; if valid && \
        offset = bytes.Length then Some(fields.ToArray()) else None with _ -> None in match tryDecode !encoded with \
        Some fields when fields.Length = 15 && fields.[8] = \"BRL\" -> (match System.Int64.TryParse(fields.[9]), \
        System.Int64.TryParse(fields.[10]) with (true,scale),(true,amount) when scale = 2L && amount = 4980L -> \
        fields.[8],scale,amount | _ -> failwith \"erp-SettlePayment-typed-decode-invalid-payment-fields\") | _ -> \
        failwith \"erp-SettlePayment-typed-decode-invalid-payment-frame\")"

:= erp_settle_payment_payload_decode_route_fields_runtime (encoded : string) :
    string * i64 * i64 * string =
    $"(let tryDecode (text : string) = try let bytes = System.Convert.FromBase64String(text) in let mutable offset = \
        0 in let fields = System.Collections.Generic.List<string>() in let mutable valid = true in while valid && \
        offset < bytes.Length do if offset + 4 > bytes.Length then valid <- false else let raw = \
        System.BitConverter.ToInt32(bytes, offset) |> System.Net.IPAddress.NetworkToHostOrder in offset <- offset + \
        4; if raw < 0 || offset + raw > bytes.Length then valid <- false else \
        fields.Add(System.Text.Encoding.UTF8.GetString(bytes, offset, raw)); offset <- offset + raw done; if valid && \
        offset = bytes.Length then Some(fields.ToArray()) else None with _ -> None in match tryDecode !encoded with \
        Some fields when fields.Length = 15 && fields.[11] = \"2026-07\" && fields.[14].Length > 0 -> (match \
        System.Int64.TryParse(fields.[12]), System.Int64.TryParse(fields.[13]) with \
        (true,numerator),(true,denominator) when numerator = 6L && denominator = 1L -> \
        fields.[11],numerator,denominator,fields.[14] | _ -> failwith \
        \"erp-SettlePayment-typed-decode-invalid-route-fields\") | _ -> failwith \
        \"erp-SettlePayment-typed-decode-invalid-route-frame\")"

:= erp_settle_payment_payload_typed_decode (encoded : string) :
    erp_settle_payment_payload_typed_decode_decision =
    ?= erp_settle_payment_payload_validate_runtime encoded ?|
    | 1i64 =>
        := invoice_entity, invoice_currency, invoice_item, invoice_location,
            invoice_jurisdiction, invoice_document, invoice_identity =
            erp_settle_payment_payload_decode_invoice_fields_runtime encoded
        := payment_currency, payment_scale, payment_amount =
            erp_settle_payment_payload_decode_payment_fields_runtime encoded
        := route_period, route_numerator, route_denominator, payment_document =
            erp_settle_payment_payload_decode_route_fields_runtime encoded
        := invoice_value : invoice_match company_a usd widget_a warehouse_north tax_brazil po_1001 =
            invoice_match (
                company_a invoice_entity,
                usd invoice_currency,
                widget_a invoice_item,
                warehouse_north invoice_location,
                tax_brazil invoice_jurisdiction,
                po_1001 invoice_document,
                invoice_identity)
        := payment_value : money brl i64 =
            money (brl payment_currency, payment_scale, payment_amount)
        := route_ratio : settlement_fx_ratio_certificate usd brl period_2026_07 =
            settlement_fx_ratio_certificate (
                usd invoice_currency,
                brl payment_currency,
                period_2026_07 route_period,
                route_numerator,
                route_denominator)
        ErpSettlePaymentPayloadTypedDecoded (
            erp_settle_payment_payload_typed_certificate (
                invoice_value,
                payment_value,
                route_ratio,
                payment_3001 payment_document))
    | _ => ErpSettlePaymentPayloadTypedRejected "invalid-or-truncated-SettlePayment-frame"

:= erp_settle_payment_payload_typed_certificate_tag
    (certificate : erp_settle_payment_payload_typed_certificate)
    : i64
    =
    ?= certificate ?|
    | erp_settle_payment_payload_typed_certificate (
            invoice_value,
            payment_value,
            route_ratio,
            payment_document_value
        )
        =>
            ?= invoice_value ?|
            | invoice_match (
                    entity_value,
                    currency_value,
                    item_value,
                    location_value,
                    jurisdiction_value,
                    invoice_document_value,
                    invoice_identity
                )
                =>
                    ?= payment_value ?|
                    | money (payment_currency_value, payment_scale, payment_amount) =>
                        ?= route_ratio ?|
                        | settlement_fx_ratio_certificate (_, _, _, route_numerator, route_denominator) =>
                            ?= payment_document_value ?|
                            | payment_3001 payment_document_text =>
                                $"if !entity_value = \"company-a\" && !currency_value = \"USD\" && !item_value = \
                                    \"widget-a\" && !location_value = \"warehouse-north\" && !jurisdiction_value = \
                                    \"BR\" && !invoice_document_value = \"po-1001\" && !invoice_identity = \
                                    \"invoice-match-1001\" && !payment_currency_value = \"BRL\" && !payment_scale = \
                                    2L && !payment_amount = 4980L && !route_numerator = 6L && !route_denominator = 1L \
                                    && !payment_document_text = \"payment-3001\" then 1L else 0L"

:= erp_settle_payment_payload_typed_decode_tag
    (decision : erp_settle_payment_payload_typed_decode_decision) : i64 =
    ?= decision ?|
    | ErpSettlePaymentPayloadTypedDecoded certificate =>
        erp_settle_payment_payload_typed_certificate_tag certificate
    | ErpSettlePaymentPayloadTypedRejected _ => 0i64

:= erp_settle_payment_payload_typed_certificate_frame
    (certificate : erp_settle_payment_payload_typed_certificate)
    : string
    =
    ?= certificate ?|
    | erp_settle_payment_payload_typed_certificate (
            invoice_value,
            payment_value,
            route_ratio,
            payment_document_value
        )
        =>
            ?= invoice_value ?|
            | invoice_match (
                    invoice_entity,
                    invoice_currency,
                    invoice_item,
                    invoice_location,
                    invoice_jurisdiction,
                    invoice_document,
                    invoice_identity
                )
                =>
                    ?= payment_value ?|
                    | money (payment_currency, payment_scale, payment_amount) =>
                        ?= route_ratio ?|
                        | settlement_fx_ratio_certificate (_, _, _, route_numerator, route_denominator) =>
                            ?= payment_document_value ?|
                            | payment_3001 payment_document_text =>
                                $"(let fields = [| \"SettlePayment\"; !invoice_entity; !invoice_currency; \
                                    !invoice_item; !invoice_location; !invoice_jurisdiction; !invoice_document; \
                                    !invoice_identity; !payment_currency; string !payment_scale; string \
                                    !payment_amount; \"2026-07\"; string !route_numerator; string !route_denominator; \
                                    !payment_document_text |] in let bytes = fields |> Array.collect (fun value -> \
                                    let payload = System.Text.Encoding.UTF8.GetBytes(value) in let length = \
                                    System.BitConverter.GetBytes(System.Net.IPAddress.HostToNetworkOrder(payload.Lengt\
                                    h)) in Array.append length payload) in System.Convert.ToBase64String(bytes))"

:= erp_settle_payment_payload_typed_certificate_ratio
    (certificate : erp_settle_payment_payload_typed_certificate) : i64 * i64 =
    ?= certificate ?|
    | erp_settle_payment_payload_typed_certificate (_, _, route_ratio, _) =>
        ?= route_ratio ?|
        | settlement_fx_ratio_certificate (_, _, _, numerator, denominator) =>
