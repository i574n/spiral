            typed_fx_hashed_primary_history
            typed_fx_hashed_primary_position

union typed_fx_hashed_statement_closed_fact_input history position =
    | TypedFxHashedStatementClosedFactInput :: forall history position.
        typed_fx_hashed_statement_closed_history history position *
        typed_fx_hashed_statement_closed_fact_observation history position ->
        typed_fx_hashed_statement_closed_fact_input history position

inl decide_typed_fx_hashed_statement_closed_fact_observation forall history position.
    (history_value : typed_fx_hashed_statement_closed_history history position)
    (observation : typed_fx_hashed_statement_closed_fact_observation history position)
    : typed_fx_hashed_statement_closed_decision =
    match history_value, observation with
    | TypedFxHashedStatementClosedHistoryEmpty (empty, _),
      TypedFxHashedStatementClosedFactPosition
        (TypedFxHashedStatementClosedPositionFactEmptyAtZero expected) =>
        TypedFxHashedStatementClosedApplied (
            apply_typed_fx_hashed_statement_command_to_event_log
                expected
                (typed_fx_hashed_statement_closed_primary_command_from_facts ())
                empty)
    | TypedFxHashedStatementClosedHistoryRecorded (recorded, _),
      TypedFxHashedStatementClosedFactRecordedHashAtHead hash_fact =>
        match hash_fact with
        | TypedFxHashedStatementClosedRecordedHashPrimary =>
            inl membership =
                typed_fx_hashed_statement_top_membership_from_recorded_log recorded
            TypedFxHashedStatementClosedDuplicateExact (
                TypedFxHashedStatementEventStoreDuplicateExact (
                    membership,
                    recorded,
                    "the-recorded-hash-fact-derives-DuplicateExact-from-the-primary-membership"))
        | TypedFxHashedStatementClosedRecordedHashChanged hash_difference =>
            inl collision =
                typed_fx_hashed_statement_top_collision_from_recorded_log
                    recorded hash_difference
            TypedFxHashedStatementClosedIdentityCollision (
                TypedFxHashedStatementEventStoreIdentityCollision (
                    collision,
                    recorded,
                    "the-recorded-hash-fact-derives-IdentityCollision-from-the-indexed-hash-difference"))
    | TypedFxHashedStatementClosedHistoryRecorded (recorded, _),
      TypedFxHashedStatementClosedFactPosition
        (TypedFxHashedStatementClosedPositionFactRecordedPrimaryAtStaleZero mismatch) =>
        TypedFxHashedStatementClosedVersionConflict (
            TypedFxHashedStatementEventStoreVersionConflict (
                mismatch,
                recorded,
                "the-unified-position-fact-consumes-the-indexed-position-mismatch"))

inl decide_typed_fx_hashed_statement_closed_fact_input forall history position.
    (input : typed_fx_hashed_statement_closed_fact_input history position)
    : typed_fx_hashed_statement_closed_decision =
    match input with
    | TypedFxHashedStatementClosedFactInput (history_value, observation) =>
        decide_typed_fx_hashed_statement_closed_fact_observation
            history_value observation

union rec typed_fx_hashed_statement_closed_fact_observation_program =
    | TypedFxHashedStatementClosedFactObservationProgramDone
    | TypedFxHashedStatementClosedFactObservationProgramMore ::
        (exists history position.
            typed_fx_hashed_statement_closed_fact_input history position *
            typed_fx_hashed_statement_closed_fact_observation_program * string) ->
        typed_fx_hashed_statement_closed_fact_observation_program

inl rec typed_fx_hashed_statement_closed_fact_observation_program_runtime
    (program : typed_fx_hashed_statement_closed_fact_observation_program)
    : i64 * i64 * i64 * i64 * i64 * i64 * i64 * i64 * i64 =
    match program with
    | TypedFxHashedStatementClosedFactObservationProgramDone =>
        0i64, 0i64, 0i64, 0i64, 0i64, 0i64, 0i64, 0i64, 0i64
    | TypedFxHashedStatementClosedFactObservationProgramMore payload =>
        inl exists history position. input, tail, _ = payload
        inl a, d, i, v, e, st, db, cr, m =
            typed_fx_hashed_statement_closed_decision_runtime
                (decide_typed_fx_hashed_statement_closed_fact_input input)
        inl ta, td, ti, tv, te, tst, tdb, tcr, tm =
            typed_fx_hashed_statement_closed_fact_observation_program_runtime tail
        runtime_add_i64 a ta,
        runtime_add_i64 d td,
        runtime_add_i64 i ti,
        runtime_add_i64 v tv,
        runtime_add_i64 e te,
        runtime_add_i64 st tst,
        runtime_add_i64 db tdb,
        runtime_add_i64 cr tcr,
        runtime_add_i64 m tm

inl typed_fx_hashed_statement_closed_fact_observation_program_matrix () :
    typed_fx_hashed_statement_closed_fact_observation_program =
    inl empty_history, recorded_history =
        typed_fx_hashed_statement_closed_history_values ()
    TypedFxHashedStatementClosedFactObservationProgramMore (exists (
        TypedFxHashedStatementClosedFactInput (
            empty_history,
            TypedFxHashedStatementClosedFactPosition
                (TypedFxHashedStatementClosedPositionFactEmptyAtZero (
                    TypedFxStatementExpectedStreamPosition (
                        TypedFxStatementStreamPositionZeroValue,
                        "the-program-Apply-cell-carries-the-exact-zero-position")))),
        TypedFxHashedStatementClosedFactObservationProgramMore (exists (
            TypedFxHashedStatementClosedFactInput (
                recorded_history,
                TypedFxHashedStatementClosedFactRecordedHashAtHead (
                    TypedFxHashedStatementClosedRecordedHashPrimary)),
            TypedFxHashedStatementClosedFactObservationProgramMore (exists (
                TypedFxHashedStatementClosedFactInput (
                    recorded_history,
                    TypedFxHashedStatementClosedFactRecordedHashAtHead (
                        TypedFxHashedStatementClosedRecordedHashChanged (
                            TypedFxStatementPayloadHashPrimaryChanged
                                "the-program-recorded-hash-cell-carries-only-the-indexed-hash-difference"))),
                TypedFxHashedStatementClosedFactObservationProgramMore (exists (
                    TypedFxHashedStatementClosedFactInput (
                        recorded_history,
                        TypedFxHashedStatementClosedFactPosition
                            (TypedFxHashedStatementClosedPositionFactRecordedPrimaryAtStaleZero (
                                TypedFxStatementStreamPositionZeroNext
                                    "the-program-Conflict-cell-carries-the-stale-position-proof"))),
                    TypedFxHashedStatementClosedFactObservationProgramDone,
                    "the-final-fact-input-cell-derives-VersionConflict")),
                "the-third-fact-input-cell-derives-IdentityCollision")),
            "the-second-fact-input-cell-derives-DuplicateExact")),
        "the-first-fact-input-cell-derives-Applied"))

inl typed_fx_hashed_statement_closed_fact_observation_program_terminal () : string =
    inl a, d, i, v, e, st, db, cr, m =
        typed_fx_hashed_statement_closed_fact_observation_program_runtime
            (typed_fx_hashed_statement_closed_fact_observation_program_matrix ())
    inl _ =
        assert_typed_fx_hashed_statement_event_store_decisions_runtime
            a d i v e st db cr m
    "one-recursive-heterogeneous-fact-program-now-folds-arbitrarily-many-history-indexed-fact-cells-through-the-single-active-decision-dispatcher-so-outcome-counts-compose-without-four-parallel-terminal-calls-or-result-named-request-programs"

inl typed_fx_hashed_statement_closed_fact_input_terminal () : string =
    inl empty_history, _ =
        typed_fx_hashed_statement_closed_history_values ()
    inl input :
        typed_fx_hashed_statement_closed_fact_input
            typed_fx_hashed_statement_history_empty
            typed_fx_statement_stream_position_zero =
        TypedFxHashedStatementClosedFactInput (
            empty_history,
            TypedFxHashedStatementClosedFactPosition
                (TypedFxHashedStatementClosedPositionFactEmptyAtZero (
                    TypedFxStatementExpectedStreamPosition (
                        TypedFxStatementStreamPositionZeroValue,
                        "the-single-fact-input-carries-history-and-position-evidence-together"))))
    match decide_typed_fx_hashed_statement_closed_fact_input input with
    | TypedFxHashedStatementClosedApplied _ =>
        "one-indexed-fact-input-now-owns-the-history-and-observation-consumed-by-the-decision"

type typed_fx_hashed_secondary_position =
