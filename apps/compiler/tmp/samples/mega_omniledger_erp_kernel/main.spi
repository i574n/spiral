        false; syncInfo.ArgumentList.Add(\"-f\"); syncInfo.ArgumentList.Add(directory); use syncProcess = \
        System.Diagnostics.Process.Start(syncInfo) in syncProcess.WaitForExit(); if syncProcess.ExitCode = 0 then 1L \
        else -1L in let first = tryCas firstPrepared firstBytes expectedDigest in let stale = tryCas stalePrepared \
