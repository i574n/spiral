                typed_fx_statement_aggregate_identity_primary typed_fx_statement_payload_hash_primary
                typed_fx_statement_stream_position_zero typed_fx_hashed_primary_position typed_fx_hashed_primary_history
                typed_fx_hashed_primary_position typed_fx_hashed_primary_history
