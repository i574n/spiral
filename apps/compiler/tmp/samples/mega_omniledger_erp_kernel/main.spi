            MatchInvoice (purchase_order_value, receipt_value, tax_value)

inl erp_receive_partial_goods_disk_reopened_typed_authority_terminal () : string =
    inl encoded_payload = erp_receive_partial_goods_payload_frame (erp_p2p_receive_partial_goods_plan ())
    inl event = erp_p2p_unit_event_from_op (erp_p2p_receive_partial_goods_op ())
    inl outbox_message = erp_p2p_unit_outbox_message (erp_p2p_unit_outbox_project event)
    inl reopened_payload, bytes, parse_valid, payload_equal, outbox_equal, digest_equal, prepared_absent, directory_sync, tamper_rejected, cleanup_absent =
