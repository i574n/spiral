:= erp_p2p_four_event_store_terminal () : string =
    := store, outbox = erp_p2p_four_event_commit ()
    := store_plan = erp_p2p_event_store_replay store
    := outbox_plan = erp_p2p_event_outbox_replay outbox
    := store_length = erp_p2p_event_store_length store
    := outbox_length = erp_p2p_event_outbox_length outbox
    := store_stage = terminal store_plan
    := outbox_stage = terminal outbox_plan
    := _ =
        assert_erp_p2p_four_event_store_runtime
            store_length outbox_length store_stage outbox_stage
    "the-version-indexed-P2P-store-and-outbox-now-compose-four-endpoint-linked-events-through-goods-partially-recei"
    ^^ "ved-with-the-version-fixed-to-nat-four-by-structural-addition-proofs"

:= erp_runtime_join_stage_sequence (left : string) (right : string) : string =
    $"!left + \"|\" + !right"

:= ^ erp_p2p_event_store_stage_sequence \* version from to.
    (store : erp_p2p_event_store version from to) : string =
    ?= store ?|
    | ErpP2PEventStoreOne event =>
        terminal (erp_p2p_unit_event_plan event)
    | ErpP2PEventStoreThen payload =>
        := \? left_version right_version middle. left, right, _ = payload
        erp_runtime_join_stage_sequence
            (erp_p2p_event_store_stage_sequence left)
            (erp_p2p_event_store_stage_sequence right)

:= ^ erp_p2p_event_outbox_stage_sequence \* version from to.
    (outbox : erp_p2p_event_outbox version from to) : string =
    ?= outbox ?|
    | ErpP2PEventOutboxOne event =>
        terminal (erp_p2p_unit_event_plan event)
    | ErpP2PEventOutboxThen payload =>
        := \? left_version right_version middle. left, right, _ = payload
        erp_runtime_join_stage_sequence
            (erp_p2p_event_outbox_stage_sequence left)
            (erp_p2p_event_outbox_stage_sequence right)

:= erp_p2p_event_store_physical_roundtrip_runtime
    (store_sequence : string) (outbox_sequence : string) :
    i64 * i64 * i64 * i64 * i64 * i64 =
    $"(let directory = System.IO.Path.Combine(System.IO.Path.GetTempPath(), \"spiral-erp-p2p-sequence-\" + \
        System.Guid.NewGuid().ToString(\"N\")) in System.IO.Directory.CreateDirectory(directory) |> ignore; let \
        storePath = System.IO.Path.Combine(directory, \"events.bin\") in let outboxPath = \
        System.IO.Path.Combine(directory, \"outbox.bin\") in let storeBytes = \
        System.Text.Encoding.UTF8.GetBytes(!store_sequence) in let outboxBytes = \
        System.Text.Encoding.UTF8.GetBytes(!outbox_sequence) in let storeDigest = \
        System.Security.Cryptography.SHA256.HashData(storeBytes) in let outboxDigest = \
        System.Security.Cryptography.SHA256.HashData(outboxBytes) in (use stream = new \
        System.IO.FileStream(storePath,System.IO.FileMode.CreateNew,System.IO.FileAccess.Write,System.IO.FileShare.Non\
        e,4096,System.IO.FileOptions.WriteThrough) in stream.Write(storeBytes,0,storeBytes.Length); \
        stream.Flush(true)); (use stream = new System.IO.FileStream(outboxPath,System.IO.FileMode.CreateNew,System.IO.\
        FileAccess.Write,System.IO.FileShare.None,4096,System.IO.FileOptions.WriteThrough) in \
        stream.Write(outboxBytes,0,outboxBytes.Length); stream.Flush(true)); let recoveredStore = \
        System.IO.File.ReadAllBytes(storePath) in let recoveredOutbox = System.IO.File.ReadAllBytes(outboxPath) in \
        let storeEqual = if System.Linq.Enumerable.SequenceEqual(storeBytes,recoveredStore) then 1L else 0L in let \
        outboxEqual = if System.Linq.Enumerable.SequenceEqual(outboxBytes,recoveredOutbox) then 1L else 0L in let \
        digestEqual = if System.Linq.Enumerable.SequenceEqual(storeDigest,outboxDigest) then 1L else 0L in let \
        tampered = Array.copy recoveredStore in let _ = if tampered.Length > 0 then tampered.[tampered.Length-1] <- \
        tampered.[tampered.Length-1] ^^^ 1uy else () in let tamperRejected = if \
        System.Linq.Enumerable.SequenceEqual(System.Security.Cryptography.SHA256.HashData(tampered),storeDigest) then \
        0L else 1L in System.IO.Directory.Delete(directory,true); int64 storeBytes.Length, int64 outboxBytes.Length, \
        storeEqual, outboxEqual, digestEqual, tamperRejected)"

:= assert_erp_p2p_event_store_physical_roundtrip_runtime
    (store_bytes : i64) (outbox_bytes : i64)
    (store_equal : i64) (outbox_equal : i64)
    (digest_equal : i64) (tamper_rejected : i64)
    : ()
    =
    := ok_0 = !!!!GT(store_bytes, 0i64)
    := ok_1 = !!!!EQ(outbox_bytes, store_bytes)
    := ok_2 = !!!!EQ(store_equal, 1i64)
    := ok_3 = !!!!EQ(outbox_equal, 1i64)
    := ok_4 = !!!!EQ(digest_equal, 1i64)
    := ok_5 = !!!!EQ(tamper_rejected, 1i64)
    ? ok_0 && ok_1 && ok_2 && ok_3 && ok_4 && ok_5
    ?> ()
    |: mega_runtime_fail "erp-p2p-event-store-physical-roundtrip-runtime-mismatch"

:= erp_p2p_three_event_physical_roundtrip_terminal () : string =
    := reserve_event =
        erp_p2p_unit_event_from_op (erp_p2p_reserve_budget_op ())
    := approvals_event =
        erp_p2p_unit_event_from_op (erp_p2p_collect_approvals_op ())
    := purchase_order_event =
        erp_p2p_unit_event_from_op (erp_p2p_issue_purchase_order_op ())
    := first_store, first_outbox =
        erp_p2p_event_commit_then reserve_event approvals_event
    := final_store, final_outbox =
        erp_p2p_event_commit_one purchase_order_event
    := store = erp_p2p_event_store_then first_store final_store (v65_add_two_one_three ())
    := outbox = erp_p2p_event_outbox_then first_outbox final_outbox (v65_add_two_one_three ())
    := store_sequence = erp_p2p_event_store_stage_sequence store
    := outbox_sequence = erp_p2p_event_outbox_stage_sequence outbox
    := store_bytes, outbox_bytes, store_equal, outbox_equal, digest_equal, tamper_rejected =
        erp_p2p_event_store_physical_roundtrip_runtime
            store_sequence outbox_sequence
    := _ =
        assert_erp_p2p_event_store_physical_roundtrip_runtime
            store_bytes outbox_bytes store_equal outbox_equal digest_equal tamper_rejected
    "the-three-endpoint-linked-P2P-events-now-derive-one-ordered-stage-sequence-from-the-type-level-store-and-the-s"
    ^^ "ame-sequence-from-the-outbox-before-WriteThrough-Flush-true-SHA256-byte-roundtrip-and-tamper-rejection"

:= erp_p2p_four_event_physical_roundtrip_terminal () : string =
    := store, outbox = erp_p2p_four_event_commit ()
    := store_sequence = erp_p2p_event_store_stage_sequence store
    := outbox_sequence = erp_p2p_event_outbox_stage_sequence outbox
    := store_bytes, outbox_bytes, store_equal, outbox_equal, digest_equal, tamper_rejected =
        erp_p2p_event_store_physical_roundtrip_runtime
            store_sequence outbox_sequence
    := _ =
        assert_erp_p2p_event_store_physical_roundtrip_runtime
            store_bytes outbox_bytes store_equal outbox_equal digest_equal tamper_rejected
    "the-four-version-indexed-P2P-events-now-drive-the-physical-store-and-outbox-roundtrip-through-goods-partially-"
    ^^ "received-with-byte-tampering-rejected"

:= erp_reserve_budget_operation_payload_frame \* result.
    (operation : erp_op requisition_drafted budget_reserved result) : string =
    ?= operation ?|
    | ReserveBudget (requisition_value, budget_value) =>
        ?= requisition_value ?|
        | requisition (requisition_entity, requisition_currency, requisition_item, requisition_identity) =>
            ?= budget_value ?|
            | budget_token (budget_entity, budget_currency, budget_amount, budget_identity) =>
                $"(let fields = [| !requisition_entity; !requisition_currency; !requisition_item; \
                    !requisition_identity; !budget_entity; !budget_currency; string !budget_amount; !budget_identity \
                    |] in let bytes = fields |> Array.collect (fun value -> let payload = \
                    System.Text.Encoding.UTF8.GetBytes(value) in let length = \
                    System.BitConverter.GetBytes(System.Net.IPAddress.HostToNetworkOrder(payload.Length)) in \
                    Array.append length payload) in System.Convert.ToBase64String(bytes))"

:= erp_reserve_budget_payload_frame
    (plan : erp_plan requisition_drafted budget_reserved) : string =
    ?= plan ?|
    | ErpStep payload =>
        := \? result. operation = payload
        erp_reserve_budget_operation_payload_frame operation

:= erp_reserve_budget_payload_codec_runtime (encoded : string) :
    i64 * i64 * i64 * i64 * i64 * i64 * i64 * i64 * i64 =
    $"(let tryDecode (text : string) = try let bytes = System.Convert.FromBase64String(text) in let mutable offset = \
        0 in let fields = System.Collections.Generic.List<string>() in let mutable valid = true in while valid && \
        offset < bytes.Length do if offset + 4 > bytes.Length then valid <- false else let raw = \
        System.BitConverter.ToInt32(bytes, offset) |> System.Net.IPAddress.NetworkToHostOrder in offset <- offset + \
        4; if raw < 0 || offset + raw > bytes.Length then valid <- false else \
        fields.Add(System.Text.Encoding.UTF8.GetString(bytes, offset, raw)); offset <- offset + raw done; if valid && \
        offset = bytes.Length then Some(fields.ToArray()) else None with _ -> None in let decoded = tryDecode \
        !encoded in let fieldCount = match decoded with Some fields -> int64 fields.Length | None -> 0L in let \
        indexBound = match decoded with Some fields when fields.Length = 8 -> 1L | _ -> 0L in let sharedEntity = \
        match decoded with Some fields when fields.Length = 8 && fields.[0] = fields.[4] -> 1L | _ -> 0L in let \
        sharedCurrency = match decoded with Some fields when fields.Length = 8 && fields.[1] = fields.[5] -> 1L | _ \
        -> 0L in let amountBound = match decoded with Some fields when fields.Length = 8 -> (match \
        System.Int64.TryParse(fields.[6]) with true,value when value > 0L -> 1L | _ -> 0L) | _ -> 0L in let \
        identityBound = match decoded with Some fields when fields.Length = 8 && fields.[3].Length > 0 && \
        fields.[7].Length > 0 && fields.[3] <> fields.[7] -> 1L | _ -> 0L in let reencode (fields : string array) = \
        fields |> Array.collect (fun value -> let payload = System.Text.Encoding.UTF8.GetBytes(value) in let length = \
        System.BitConverter.GetBytes(System.Net.IPAddress.HostToNetworkOrder(payload.Length)) in Array.append length \
        payload) |> System.Convert.ToBase64String in let roundtrip = match decoded with Some fields when reencode \
        fields = !encoded -> 1L | _ -> 0L in let digestBytes = System.Security.Cryptography.SHA256.HashData(System.Tex\
        t.Encoding.UTF8.GetBytes(!encoded)).Length |> int64 in let truncated = if !encoded.Length > 4 then \
        !encoded.Substring(0, !encoded.Length - 4) else \"\" in let tamperRejected = match tryDecode truncated with \
        None -> 1L | Some _ -> 0L in fieldCount,indexBound,sharedEntity,sharedCurrency,amountBound,identityBound,round\
        trip,digestBytes,tamperRejected)"

:= assert_erp_reserve_budget_payload_codec_runtime
    (field_count : i64) (index_bound : i64) (shared_entity : i64)
    (shared_currency : i64) (amount_bound : i64) (identity_bound : i64) (roundtrip : i64)
    (digest_bytes : i64) (tamper_rejected : i64)
    : ()
    =
    := ok_0 = !!!!EQ(field_count, 8i64)
    := ok_1 = !!!!EQ(index_bound, 1i64)
    := ok_2 = !!!!EQ(shared_entity, 1i64)
    := ok_3 = !!!!EQ(shared_currency, 1i64)
    := ok_4 = !!!!EQ(amount_bound, 1i64)
    := ok_5 = !!!!EQ(identity_bound, 1i64)
    := ok_6 = !!!!EQ(roundtrip, 1i64)
    := ok_7 = !!!!EQ(digest_bytes, 32i64)
    := ok_8 = !!!!EQ(tamper_rejected, 1i64)
    ? ok_0 && ok_1 && ok_2 && ok_3 && ok_4 && ok_5 && ok_6 && ok_7 && ok_8
    ?> ()
    |: mega_runtime_fail "erp-reserve-budget-payload-codec-runtime-mismatch"

:= erp_reserve_budget_payload_codec_terminal () : string =
    := encoded = erp_reserve_budget_payload_frame (erp_p2p_reserve_budget_plan ())
    := field_count
        , index_bound, shared_entity, shared_currency, amount_bound, identity_bound, roundtrip, digest_bytes,
        tamper_rejected
        =
        erp_reserve_budget_payload_codec_runtime encoded
    := _ =
        assert_erp_reserve_budget_payload_codec_runtime
            field_count
            index_bound
            shared_entity
            shared_currency
            amount_bound
            identity_bound
            roundtrip
            digest_bytes
            tamper_rejected
    "the-ReserveBudget-operation-now-derives-eight-canonical-payload-fields-directly-from-the-typed-requisition-and"
    ^^ "-budget-token-serializes-them-as-binary-length-prefixed-UTF8-inside-base64-decodes-all-fields-rechecks-shared-"
    ^^ "entity-and-currency-reencodes-byte-exact-recomputes-SHA256-and-rejects-truncation-while-the-next-operation-fam"
    ^^ "ilies-remain-open-sealed"

:= erp_reserve_budget_payload_decode_fields_runtime (encoded : string) :
    string * string * string * string * string * string * i64 * string =
    $"(let tryDecode (text : string) = try let bytes = System.Convert.FromBase64String(text) in let mutable offset = \
        0 in let fields = System.Collections.Generic.List<string>() in let mutable valid = true in while valid && \
        offset < bytes.Length do if offset + 4 > bytes.Length then valid <- false else let raw = \
        System.BitConverter.ToInt32(bytes, offset) |> System.Net.IPAddress.NetworkToHostOrder in offset <- offset + \
        4; if raw < 0 || offset + raw > bytes.Length then valid <- false else \
        fields.Add(System.Text.Encoding.UTF8.GetString(bytes, offset, raw)); offset <- offset + raw done; if valid && \
        offset = bytes.Length then Some(fields.ToArray()) else None with _ -> None in match tryDecode !encoded with \
        Some fields when fields.Length = 8 && fields.[0] = \"company-a\" && fields.[1] = \"USD\" && fields.[2] = \
        \"widget-a\" && fields.[4] = fields.[0] && fields.[5] = fields.[1] && fields.[3].Length > 0 && \
        fields.[7].Length > 0 && fields.[3] <> fields.[7] -> (match System.Int64.TryParse(fields.[6]) with \
        true,amount when amount > 0L -> fields.[0],fields.[1],fields.[2],fields.[3],fields.[4],fields.[5],amount,field\
        s.[7] | _ -> failwith \"erp-ReserveBudget-typed-decode-invalid-amount\") | _ -> failwith \
        \"erp-ReserveBudget-typed-decode-invalid-frame\")"

:= erp_reserve_budget_payload_decode_typed_operation (encoded : string) :
    erp_op requisition_drafted budget_reserved
        (requisition company_a usd widget_a * budget_token company_a usd) =
    := requisition_entity, requisition_currency, requisition_item, requisition_identity,
        budget_entity, budget_currency, budget_amount, budget_identity =
        erp_reserve_budget_payload_decode_fields_runtime encoded
    ReserveBudget (
        requisition (
            company_a requisition_entity,
            usd requisition_currency,
            widget_a requisition_item,
            requisition_identity),
        budget_token (
            company_a budget_entity,
            usd budget_currency,
            budget_amount,
            budget_identity))

:= assert_erp_reserve_budget_payload_typed_decode_roundtrip_runtime
    (encoded : string) (reencoded : string) : () =
    := ok_0 = !!!!EQ(encoded, reencoded)
    ? ok_0 ?> () |: mega_runtime_fail "erp-ReserveBudget-typed-decode-roundtrip-mismatch"

:| erp_reserve_budget_typed_decode_authority =
    | ErpReserveBudgetTypedDecodeAuthority ::
        string *
        erp_op requisition_drafted budget_reserved
            (requisition company_a usd widget_a * budget_token company_a usd) *
        erp_p2p_unit_event requisition_drafted budget_reserved *
        string ->
        erp_reserve_budget_typed_decode_authority

:= erp_reserve_budget_typed_decode_authority_from_bytes (encoded : string) :
    erp_reserve_budget_typed_decode_authority =
    := decoded_operation = erp_reserve_budget_payload_decode_typed_operation encoded
    := event = erp_p2p_unit_event_from_op decoded_operation
    := reencoded = erp_reserve_budget_operation_payload_frame decoded_operation
    := _ = assert_erp_reserve_budget_payload_typed_decode_roundtrip_runtime encoded reencoded
    ErpReserveBudgetTypedDecodeAuthority (encoded, decoded_operation, event, reencoded)

:| erp_reserve_budget_typed_commit_authority =
    | ErpReserveBudgetTypedCommitAuthority ::
        erp_reserve_budget_typed_decode_authority *
        erp_p2p_unit_store requisition_drafted budget_reserved *
        erp_p2p_unit_outbox requisition_drafted budget_reserved ->
        erp_reserve_budget_typed_commit_authority

:= erp_reserve_budget_typed_commit_authority_from_bytes (encoded : string) :
    erp_reserve_budget_typed_commit_authority =
    := decode_authority = erp_reserve_budget_typed_decode_authority_from_bytes encoded
    ?= decode_authority ?|
    | ErpReserveBudgetTypedDecodeAuthority (_, _, event, _) =>
        := store, outbox = erp_p2p_unit_commit_project event
        ErpReserveBudgetTypedCommitAuthority (decode_authority, store, outbox)

:= erp_reserve_budget_payload_typed_decode_terminal () : string =
    := encoded = erp_reserve_budget_payload_frame (erp_p2p_reserve_budget_plan ())
    := commit_authority = erp_reserve_budget_typed_commit_authority_from_bytes encoded
    ?= commit_authority ?|
    | ErpReserveBudgetTypedCommitAuthority (decode_authority, store, outbox) =>
        ?= decode_authority ?|
        | ErpReserveBudgetTypedDecodeAuthority (authority_bytes, decoded_operation, event, reencoded) =>
            := _ = assert_erp_reserve_budget_payload_typed_decode_roundtrip_runtime authority_bytes reencoded
            := _ = erp_p2p_unit_store_replay store
            := _ = erp_p2p_unit_outbox_replay outbox
            ?= decoded_operation, event ?|
            | ReserveBudget _, ErpP2PUnitEvent _ =>
                "reopened-ReserveBudget-bytes-now-carry-one-decoded-operation-event-commit-authority-so-store-and-o"
                ^^ "utbox-cannot-be-projected-from-a-different-event-after-decoding"

:= erp_typed_unit_atomic_event_outbox_runtime
    (encoded_payload : string) (outbox_message : string) :
    string * i64 * i64 * i64 * i64 * i64 * i64 * i64 * i64 * i64 =
    $"(let root = System.IO.Path.Combine(System.IO.Path.GetTempPath(), \"spiral-erp-reserve-envelope-\" + \
        System.Guid.NewGuid().ToString(\"N\")) in let _ = System.IO.Directory.CreateDirectory(root) in let prepared = \
        System.IO.Path.Combine(root, \"commit.prepared\") in let committed = System.IO.Path.Combine(root, \
        \"commit.committed\") in let payloadBytes = System.Convert.FromBase64String(!encoded_payload) in let \
        outboxBytes = System.Text.Encoding.UTF8.GetBytes(!outbox_message) in let payloadDigest = \
        System.Security.Cryptography.SHA256.HashData(payloadBytes) in let lengthBytes (count : int) = \
        System.BitConverter.GetBytes(System.Net.IPAddress.HostToNetworkOrder(count)) in let envelope = Array.concat \
        [| [| 69uy; 82uy; 80uy; 49uy |]; lengthBytes payloadBytes.Length; payloadBytes; lengthBytes \
        outboxBytes.Length; outboxBytes; payloadDigest |] in (use stream = new System.IO.FileStream(prepared, \
        System.IO.FileMode.CreateNew, System.IO.FileAccess.Write, System.IO.FileShare.None, 4096, \
        System.IO.FileOptions.WriteThrough) in stream.Write(envelope, 0, envelope.Length); stream.Flush(true)); \
        System.IO.File.Move(prepared, committed, true); let info = new System.Diagnostics.ProcessStartInfo() in \
        info.FileName <- \"/usr/bin/sync\"; info.UseShellExecute <- false; info.ArgumentList.Add(\"-f\"); \
        info.ArgumentList.Add(root); use syncProcess = System.Diagnostics.Process.Start(info) in let completed = \
        syncProcess.WaitForExit(5000) in let _ = if not completed then (syncProcess.Kill(true); \
        syncProcess.WaitForExit() |> ignore) else () in let directorySync = if completed then int64 \
        syncProcess.ExitCode else -2L in let recovered = System.IO.File.ReadAllBytes(committed) in let preparedAbsent \
        = if System.IO.File.Exists(prepared) then 0L else 1L in let readLength offset = \
        System.BitConverter.ToInt32(recovered, offset) |> System.Net.IPAddress.NetworkToHostOrder in let parsed = try \
        let payloadLength = readLength 4 in let payloadStart = 8 in let outboxLengthOffset = payloadStart + \
        payloadLength in let outboxLength = readLength outboxLengthOffset in let outboxStart = outboxLengthOffset + 4 \
        in let digestStart = outboxStart + outboxLength in if recovered.Length >= 44 && recovered.[0] = 69uy && \
        recovered.[1] = 82uy && recovered.[2] = 80uy && recovered.[3] = 49uy && payloadLength >= 0 && outboxLength >= \
        0 && digestStart + 32 = recovered.Length then let decodedPayload = recovered.[payloadStart .. \
        outboxLengthOffset - 1] in let decodedOutbox = recovered.[outboxStart .. digestStart - 1] in let storedDigest \
        = recovered.[digestStart .. digestStart + 31] in Some(decodedPayload, decodedOutbox, storedDigest) else None \
        with _ -> None in let parseValid,payloadEqual,outboxEqual,digestEqual,tamperRejected = match parsed with | \
        Some(decodedPayload, decodedOutbox, storedDigest) -> let tamperedPayload = Array.copy decodedPayload in let _ \
        = if tamperedPayload.Length > 0 then tamperedPayload.[0] <- tamperedPayload.[0] ^^^ 1uy else () in 1L, (if \
        System.Linq.Enumerable.SequenceEqual(payloadBytes, decodedPayload) then 1L else 0L), (if \
        System.Linq.Enumerable.SequenceEqual(outboxBytes, decodedOutbox) then 1L else 0L), (if \
        System.Linq.Enumerable.SequenceEqual(System.Security.Cryptography.SHA256.HashData(decodedPayload), \
        storedDigest) then 1L else 0L), (if System.Linq.Enumerable.SequenceEqual(System.Security.Cryptography.SHA256.H\
        ashData(tamperedPayload), storedDigest) then 0L else 1L) | None -> 0L,0L,0L,0L,0L in let reopenedPayload = \
        match parsed with | Some(decodedPayload, _, _) -> System.Convert.ToBase64String(decodedPayload) | None -> \
        System.String.Empty in System.IO.Directory.Delete(root, true); let cleanupAbsent = if \
        System.IO.Directory.Exists(root) then 0L else 1L in reopenedPayload,int64 \
        envelope.Length,parseValid,payloadEqual,outboxEqual,digestEqual,preparedAbsent,directorySync,tamperRejected,cl\
        eanupAbsent)"

:= assert_erp_typed_unit_atomic_event_outbox_runtime
    (bytes : i64) (parse_valid : i64) (payload_equal : i64)
    (outbox_equal : i64) (digest_equal : i64) (prepared_absent : i64)
    (directory_sync : i64) (tamper_rejected : i64) (cleanup_absent : i64)
    : ()
    =
    := ok_0 = !!!!GT(bytes, 0i64)
    := ok_1 = !!!!EQ(parse_valid, 1i64)
    := ok_2 = !!!!EQ(payload_equal, 1i64)
    := ok_3 = !!!!EQ(outbox_equal, 1i64)
    := ok_4 = !!!!EQ(digest_equal, 1i64)
    := ok_5 = !!!!EQ(prepared_absent, 1i64)
    := ok_6 = !!!!EQ(directory_sync, 0i64)
    := ok_7 = !!!!EQ(tamper_rejected, 1i64)
    := ok_8 = !!!!EQ(cleanup_absent, 1i64)
    ? ok_0 && ok_1 && ok_2 && ok_3 && ok_4 && ok_5 && ok_6 && ok_7 && ok_8
    ?> ()
    |: mega_runtime_fail "erp-reserve-budget-atomic-event-outbox-runtime-mismatch"

:= erp_net_intercompany_disk_reopened_typed_operation_terminal () : string =
    := encoded_payload = erp_net_intercompany_operation_payload_frame (erp_p2p_net_intercompany_op ())
    := event = erp_p2p_unit_event_from_op (erp_p2p_net_intercompany_op ())
