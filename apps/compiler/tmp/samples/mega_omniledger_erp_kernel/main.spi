                    | tax_witness (tax_jurisdiction, tax_currency, tax_document, tax_amount, tax_identity) =>
                        $"(let fields = [| !order_entity; !order_currency; !order_item; !order_document; \
                            !order_identity; !receipt_entity; !receipt_currency; !receipt_item; !receipt_location; \
                            !receipt_document; string !receipt_quantity; !receipt_identity; !tax_jurisdiction; \
                            !tax_currency; !tax_document; string !tax_amount; !tax_identity |] in let bytes = fields \
                            |> Array.collect (fun value -> let payload = System.Text.Encoding.UTF8.GetBytes(value) in \
                            let length = System.BitConverter.GetBytes(System.Net.IPAddress.HostToNetworkOrder(payload.\
                            Length)) in Array.append length payload) in System.Convert.ToBase64String(bytes))"

