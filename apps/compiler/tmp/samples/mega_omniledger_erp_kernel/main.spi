            := count, _, _, debit, credit, mismatch =
                typed_fx_signed_scaled_entity_currency_statement_program_runtime program
            count, debit, credit, mismatch
    typed_fx_hashed_statement_history_contains_depth proof,
    statements, debit, credit, mismatch

