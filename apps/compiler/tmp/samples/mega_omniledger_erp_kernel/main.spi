        typed_fx_statement_aggregate_identity_primary
        typed_fx_statement_payload_hash_primary
        typed_fx_hashed_primary_history

:| typed_fx_hashed_statement_proven_retry_request history =
    | TypedFxHashedStatementProvenRetryExact :: \* history.
        typed_fx_hashed_statement_history_contains
            typed_fx_statement_command_identity_primary
            typed_fx_statement_aggregate_identity_primary
            typed_fx_statement_payload_hash_primary
            history ->
        typed_fx_hashed_statement_proven_retry_request history
    | TypedFxHashedStatementProvenRetryCollision :: \* history.
        typed_fx_hashed_statement_identity_collision
            typed_fx_statement_command_identity_primary
            typed_fx_statement_payload_hash_changed
            history ->
        typed_fx_hashed_statement_proven_retry_request history

:| typed_fx_hashed_statement_proven_retry_result position history =
    | TypedFxHashedStatementProvenRetryDuplicateResult :: \* position history.
        typed_fx_hashed_statement_event_store_decision
            typed_fx_statement_command_identity_primary
            typed_fx_statement_aggregate_identity_primary
            typed_fx_statement_payload_hash_primary
            position position history position history ->
        typed_fx_hashed_statement_proven_retry_result position history
    | TypedFxHashedStatementProvenRetryCollisionResult :: \* position history.
        typed_fx_hashed_statement_event_store_decision
            typed_fx_statement_command_identity_primary
            typed_fx_statement_aggregate_identity_primary
            typed_fx_statement_payload_hash_changed
            position position history position history ->
        typed_fx_hashed_statement_proven_retry_result position history

:= decide_typed_fx_hashed_statement_proven_retry \* position history.
    (log : typed_fx_hashed_statement_event_log position history)
    (request : typed_fx_hashed_statement_proven_retry_request history)
    : typed_fx_hashed_statement_proven_retry_result position history =
    ?= request ?|
    | TypedFxHashedStatementProvenRetryExact proof =>
        TypedFxHashedStatementProvenRetryDuplicateResult (
            TypedFxHashedStatementEventStoreDuplicateExact (
                proof,
                log,
                "a-recursive-history-membership-proof-authorizes-an-exact-retry-at-any-depth"))
    | TypedFxHashedStatementProvenRetryCollision proof =>
        TypedFxHashedStatementProvenRetryCollisionResult (
            TypedFxHashedStatementEventStoreIdentityCollision (
                proof,
                log,
                "a-recursive-history-collision-proof-authorizes-a-collision-at-any-depth"))

:= ^ typed_fx_hashed_statement_history_contains_depth
    \* command_identity aggregate_identity payload_hash history.
    (proof : typed_fx_hashed_statement_history_contains command_identity aggregate_identity payload_hash history)
    : i64
    =
    ?= proof ?|
    | TypedFxHashedStatementHistoryContainsHere _ => 0i64
    | TypedFxHashedStatementHistoryContainsThere (tail, _) =>
        runtime_add_i64 1i64
            (typed_fx_hashed_statement_history_contains_depth tail)

:= ^ typed_fx_hashed_statement_identity_collision_depth
    \* command_identity incoming_hash history.
    (proof : typed_fx_hashed_statement_identity_collision command_identity incoming_hash history) : i64 =
    ?= proof ?|
    | TypedFxHashedStatementIdentityCollisionHere _ => 0i64
    | TypedFxHashedStatementIdentityCollisionThere (tail, _) =>
        runtime_add_i64 1i64
            (typed_fx_hashed_statement_identity_collision_depth tail)

:= typed_fx_hashed_statement_proven_retry_runtime \* position history.
    (result : typed_fx_hashed_statement_proven_retry_result position history)
    : i64 * i64 * i64 * i64 =
    ?= result ?|
    | TypedFxHashedStatementProvenRetryDuplicateResult decision =>
        := _, duplicate, _, _, events, _, _, _, mismatch =
            typed_fx_hashed_statement_event_store_decision_runtime decision
        duplicate, 0i64, events, mismatch
    | TypedFxHashedStatementProvenRetryCollisionResult decision =>
        := _, _, collision, _, events, _, _, _, mismatch =
            typed_fx_hashed_statement_event_store_decision_runtime decision
        0i64, collision, events, mismatch

:= assert_typed_fx_hashed_statement_proven_retry_runtime
    (duplicate : i64) (collision : i64)
    (duplicate_events : i64) (collision_events : i64)
    (duplicate_depth : i64) (collision_depth : i64)
    (top_membership_depth : i64) (top_collision_depth : i64)
    (mismatch : i64)
    : ()
    =
    := ok_0 = !!!!EQ(duplicate, 1i64)
    := ok_1 = !!!!EQ(collision, 1i64)
    := ok_2 = !!!!EQ(duplicate_events, 2i64)
    := ok_3 = !!!!EQ(collision_events, 2i64)
    := ok_4 = !!!!EQ(duplicate_depth, 1i64)
    := ok_5 = !!!!EQ(collision_depth, 1i64)
    := ok_6 = !!!!EQ(top_membership_depth, 0i64)
    := ok_7 = !!!!EQ(top_collision_depth, 0i64)
    := ok_8 = !!!!EQ(mismatch, 0i64)
    ? ok_0 && ok_1 && ok_2 && ok_3 && ok_4 && ok_5 && ok_6 && ok_7 && ok_8
    ?> ()
    |: mega_runtime_fail "typed-FX-hashed-statement-proven-retry-runtime-mismatch"

:= typed_fx_hashed_statement_proven_retry_terminal () : string =
    := journals =
        post_typed_fx_determined_journal_program_as_signed_scaled
            (post_typed_fx_determined_rounding_receipt_program
                (typed_fx_determined_rounding_receipt_program_value ()))
    := ledgers =
        index_typed_fx_signed_scaled_journal_program_by_entity_currency journals
    := statements =
        consume_typed_fx_signed_scaled_ledger_program_with_matching_keys ledgers
    := primary
        : typed_fx_hashed_statement_command typed_fx_statement_command_identity_primary
            typed_fx_statement_aggregate_identity_primary typed_fx_statement_payload_hash_primary
            typed_fx_statement_command_fresh
        =
        typed_fx_hashed_statement_command (
            typed_fx_statement_command_identity_primary "deep-history-primary-command",
            typed_fx_statement_aggregate_identity_primary "deep-history-primary-aggregate",
            typed_fx_statement_payload_hash_primary "deep-history-primary-payload",
            typed_fx_statement_command (statements, "the-primary-command-owns-the-derived-statements"),
            "the-primary-command-is-derived-before-history-construction")
    := secondary
        : typed_fx_hashed_statement_command typed_fx_statement_command_identity_secondary
            typed_fx_statement_aggregate_identity_primary typed_fx_statement_payload_hash_primary
            typed_fx_statement_command_fresh
        =
        typed_fx_hashed_statement_command (
            typed_fx_statement_command_identity_secondary "deep-history-secondary-command",
            typed_fx_statement_aggregate_identity_primary "deep-history-secondary-aggregate",
            typed_fx_statement_payload_hash_primary "deep-history-secondary-payload",
            typed_fx_statement_command (statements, "the-secondary-command-owns-the-same-balanced-statements"),
            "the-secondary-command-becomes-the-newest-history-cell")
    := empty
        : typed_fx_hashed_statement_event_log typed_fx_statement_stream_position_zero
            typed_fx_hashed_statement_history_empty
        =
        TypedFxHashedStatementEventLogEmpty
    := first =
        apply_typed_fx_hashed_statement_command_to_event_log
            (TypedFxStatementExpectedStreamPosition (
                TypedFxStatementStreamPositionZeroValue,
                "the-first-command-expects-position-zero"))
            primary empty
    := recorded
        : typed_fx_hashed_statement_event_log typed_fx_hashed_primary_position typed_fx_hashed_primary_history
        =
        ?= first ?|
        | TypedFxHashedStatementEventStoreApplied (_, _, _, after, _) => after
    := second =
        apply_typed_fx_hashed_statement_command_to_event_log
            (TypedFxStatementExpectedStreamPosition (
                TypedFxStatementStreamPositionNextValue (
                    TypedFxStatementStreamPositionZeroValue,
                    "the-second-command-expects-position-one"),
                "the-second-append-is-authorized-by-the-exact-one-position"))
            secondary recorded
    := two_event_log
        : typed_fx_hashed_statement_event_log typed_fx_hashed_secondary_position typed_fx_hashed_secondary_history
        =
        ?= second ?|
        | TypedFxHashedStatementEventStoreApplied (_, _, _, after, _) => after
    := top_membership =
        typed_fx_hashed_statement_top_membership_from_recorded_log two_event_log
    := top_collision =
        typed_fx_hashed_statement_top_collision_from_recorded_log
            two_event_log
            (TypedFxStatementPayloadHashPrimaryChanged
                "the-generic-top-collision-terminal-supplies-only-the-hash-difference")
    := top_membership_depth =
        typed_fx_hashed_statement_history_contains_depth top_membership
    := top_collision_depth =
        typed_fx_hashed_statement_identity_collision_depth top_collision
    := exact_proof
        : typed_fx_hashed_statement_history_contains typed_fx_statement_command_identity_primary
            typed_fx_statement_aggregate_identity_primary typed_fx_statement_payload_hash_primary
            typed_fx_hashed_secondary_history
        =
        TypedFxHashedStatementHistoryContainsThere (
            TypedFxHashedStatementHistoryContainsHere
                "the-primary-command-is-found-in-the-tail",
            "the-search-skips-the-newer-secondary-command")
    := collision_proof
        : typed_fx_hashed_statement_identity_collision typed_fx_statement_command_identity_primary
            typed_fx_statement_payload_hash_changed typed_fx_hashed_secondary_history
        =
        TypedFxHashedStatementIdentityCollisionThere (
            TypedFxHashedStatementIdentityCollisionHere (
                TypedFxStatementPayloadHashPrimaryChanged
                    "the-incoming-primary-identity-carries-a-changed-payload-hash",
                "the-primary-history-cell-proves-the-collision"),
            "the-collision-search-skips-the-newer-secondary-command")
    := duplicate, _, duplicate_events, duplicate_mismatch =
        typed_fx_hashed_statement_proven_retry_runtime
            (decide_typed_fx_hashed_statement_proven_retry
                two_event_log
                (TypedFxHashedStatementProvenRetryExact exact_proof))
    := _, collision, collision_events, collision_mismatch =
        typed_fx_hashed_statement_proven_retry_runtime
            (decide_typed_fx_hashed_statement_proven_retry
                two_event_log
                (TypedFxHashedStatementProvenRetryCollision collision_proof))
    := _ =
        assert_typed_fx_hashed_statement_proven_retry_runtime
            duplicate collision duplicate_events collision_events
            (typed_fx_hashed_statement_history_contains_depth exact_proof)
            (typed_fx_hashed_statement_identity_collision_depth collision_proof)
            top_membership_depth top_collision_depth
            (runtime_add_i64 duplicate_mismatch collision_mismatch)
    "recursive-history-membership-and-collision-witnesses-now-feed-one-generic-retry-consumer-over-a-two-event-log-"
    ^^ "so-the-primary-command-is-found-one-cell-below-the-head-and-produces-duplicate-or-collision-without-repacking-"
    ^^ "the-log-while-total-search-proof-generation-physical-CAS-fsync-and-crash-durability-remain-open-sealed"

:| ^ typed_fx_hashed_statement_history_enumeration history =
    | TypedFxHashedStatementHistoryEnumerationEmpty ::
        typed_fx_hashed_statement_history_enumeration
            typed_fx_hashed_statement_history_empty
    | TypedFxHashedStatementHistoryEnumerationMore ::
        \* command_identity aggregate_identity payload_hash prior.
        typed_fx_hashed_statement_history_contains
            command_identity aggregate_identity payload_hash
            (typed_fx_hashed_statement_history_more
                command_identity aggregate_identity payload_hash prior) *
        typed_fx_hashed_statement_history_enumeration prior * string ->
        typed_fx_hashed_statement_history_enumeration
            (typed_fx_hashed_statement_history_more
                command_identity aggregate_identity payload_hash prior)

:= ^ enumerate_typed_fx_hashed_statement_history
    \* position history.
    (log : typed_fx_hashed_statement_event_log position history)
    : typed_fx_hashed_statement_history_enumeration history =
    ?= log ?|
    | TypedFxHashedStatementEventLogEmpty =>
        TypedFxHashedStatementHistoryEnumerationEmpty
    | TypedFxHashedStatementEventLogMore (_, tail, _) =>
        TypedFxHashedStatementHistoryEnumerationMore (
            TypedFxHashedStatementHistoryContainsHere
                "the-current-event-is-enumerated-at-depth-zero",
            enumerate_typed_fx_hashed_statement_history tail,
            "the-tail-is-enumerated-recursively-with-every-depth-shifted-by-one")

:= ^ typed_fx_hashed_statement_history_enumeration_runtime
    \* history.
    (enumeration : typed_fx_hashed_statement_history_enumeration history)
    : i64 * i64 =
    ?= enumeration ?|
    | TypedFxHashedStatementHistoryEnumerationEmpty => 0i64, 0i64
    | TypedFxHashedStatementHistoryEnumerationMore (_, tail, _) =>
        := tail_cells, tail_depth_sum =
            typed_fx_hashed_statement_history_enumeration_runtime tail
        runtime_add_i64 1i64 tail_cells,
        runtime_add_i64 tail_depth_sum tail_cells

:= assert_typed_fx_hashed_statement_history_enumeration_runtime
    (proof_cells : i64) (depth_sum : i64)
    (events : i64) (statements : i64)
    (debit : i64) (credit : i64) (mismatch : i64)
    : ()
    =
    := ok_0 = !!!!EQ(proof_cells, 2i64)
    := ok_1 = !!!!EQ(depth_sum, 1i64)
    := ok_2 = !!!!EQ(events, 2i64)
    := ok_3 = !!!!EQ(statements, 6i64)
    := ok_4 = !!!!EQ(debit, 20i64)
    := ok_5 = !!!!EQ(credit, 20i64)
    := ok_6 = !!!!EQ(mismatch, 0i64)
    ? ok_0 && ok_1 && ok_2 && ok_3 && ok_4 && ok_5 && ok_6
    ?> ()
    |: mega_runtime_fail "typed-FX-hashed-statement-history-enumeration-runtime-mismatch"

:= typed_fx_hashed_statement_history_enumeration_terminal () : string =
    := journals =
        post_typed_fx_determined_journal_program_as_signed_scaled
            (post_typed_fx_determined_rounding_receipt_program
                (typed_fx_determined_rounding_receipt_program_value ()))
