inl rec validate_typed_fx_statement_expected_position_raw_bytes
    forall position.
    (expected : typed_fx_statement_expected_stream_position position position)
    (bytes : typed_fx_statement_stream_position_raw_bytes)
    : typed_fx_statement_expected_position_raw_decision position =
    match expected with
    | TypedFxStatementExpectedStreamPosition (position, _) =>
        match position, bytes with
        | TypedFxStatementStreamPositionZeroValue,
          TypedFxStatementStreamPositionRawBytesMore (
              TypedFxStatementStreamPositionRawZero,
              TypedFxStatementStreamPositionRawBytesDone, _) =>
            TypedFxStatementExpectedPositionRawAccepted (
                expected,
                1i64,
                "the-hostile-byte-stream-matches-the-indexed-zero-expectation")
        | TypedFxStatementStreamPositionZeroValue, _ =>
            TypedFxStatementExpectedPositionRawRejected (
                typed_fx_statement_stream_position_raw_bytes_count bytes,
                "noncanonical-bytes-cannot-authorize-the-indexed-zero-expectation")
        | TypedFxStatementStreamPositionNextValue (prior, _),
          TypedFxStatementStreamPositionRawBytesMore (
              TypedFxStatementStreamPositionRawNext, tail, _) =>
            inl prior_expected =
                TypedFxStatementExpectedStreamPosition (
                    prior,
                    "the-successor-expectation-recurses-on-its-indexed-predecessor")
            match validate_typed_fx_statement_expected_position_raw_bytes
                    prior_expected tail with
            | TypedFxStatementExpectedPositionRawAccepted (_, cells, _) =>
                TypedFxStatementExpectedPositionRawAccepted (
                    expected,
                    runtime_add_i64 1i64 cells,
                    "every-successor-byte-matches-one-successor-in-the-expected-position-index")
            | TypedFxStatementExpectedPositionRawRejected (cells, note) =>
                TypedFxStatementExpectedPositionRawRejected (
                    runtime_add_i64 1i64 cells,
                    note)
        | TypedFxStatementStreamPositionNextValue _, _ =>
            TypedFxStatementExpectedPositionRawRejected (
                typed_fx_statement_stream_position_raw_bytes_count bytes,
                "the-hostile-byte-stream-does-not-match-the-indexed-successor-expectation")

inl typed_fx_statement_expected_position_raw_decision_runtime
    forall position.
    (decision : typed_fx_statement_expected_position_raw_decision position)
    : i64 * i64 * i64 * i64 =
    match decision with
    | TypedFxStatementExpectedPositionRawAccepted (
        TypedFxStatementExpectedStreamPosition (position, _), cells, _) =>
        1i64, 0i64,
        typed_fx_statement_stream_position_value_runtime position,
        cells
    | TypedFxStatementExpectedPositionRawRejected (cells, _) =>
        0i64, 1i64, 0i64, cells

