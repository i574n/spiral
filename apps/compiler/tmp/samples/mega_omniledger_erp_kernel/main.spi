                inl operation_numerator, operation_denominator =
                    erp_settle_payment_operation_route_ratio settlement_operation
                assert_erp_settle_payment_typed_ratio_matches_operation_runtime
                    typed_numerator typed_denominator operation_numerator operation_denominator
        inl _ =
            assert_erp_p2p_seven_event_recursive_atomic_payload_outbox_runtime
                bytes count_bound parse_valid frame_count payload_equal outbox_equal
                digest_valid prepared_absent directory_sync tamper_rejected cleanup_absent
        "the-full-seven-event-store-and-outbox-now-enter-the-existing-arbitrary-length-physical-envelope-and-the-last-store-frame-is-structurally-derived-from-the-version-seven-store-decoded-into-stable-typed-SettlePayment-evidence-and-rebuilt-byte-identically-before-the-envelope-is-written-renamed-reopened-digest-checked-and-tamper-rejected"

