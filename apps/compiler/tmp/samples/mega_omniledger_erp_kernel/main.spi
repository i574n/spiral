        inl exists result. authority_bytes, decoded_operation, quantity_authority, reencoded = payload
        inl _ = validate_ordered_partial_quantity quantity_authority
        inl _ =
            assert_erp_receive_partial_goods_payload_typed_decode_roundtrip_runtime
                reopened_payload authority_bytes
        inl _ =
            assert_erp_receive_partial_goods_payload_typed_decode_roundtrip_runtime
                reopened_payload reencoded
        inl persisted_tax_authority =
            erp_p2p_reopened_receive_partial_goods_tax_authority_from_bytes reopened_payload
        inl sealed_tax_authority_bytes =
            erp_p2p_reopened_receive_partial_goods_tax_authority_bytes persisted_tax_authority
        inl _ =
            assert_erp_receive_partial_goods_payload_typed_decode_roundtrip_runtime
                reopened_payload sealed_tax_authority_bytes
        inl match_invoice_operation =
            erp_p2p_match_invoice_op_from_reopened_receive_partial_goods_tax_authority persisted_tax_authority
        match decoded_operation, match_invoice_operation with
        | ReceivePartialGoods _, MatchInvoice _ =>
            "the-physically-reopened-ReceivePartialGoods-bytes-now-reconstruct-the-result-indexed-operation-derive-the-tax-authority-from-that-decoded-operation-and-feed-the-same-byte-origin-authority-directly-into-MatchInvoice"

inl erp_match_invoice_operation_payload_frame forall result.
    (operation : erp_op goods_partially_received invoice_three_way_matched result) : string =
    match operation with
    | MatchInvoice (purchase_order_value, receipt_value, tax_value) =>
        match purchase_order_value with
        | purchase_order (order_entity, order_currency, order_item, order_document, order_identity) =>
            match receipt_value with
            | receipt (receipt_entity, receipt_currency, receipt_item, receipt_location, receipt_document, receipt_quantity, receipt_identity) =>
                match tax_value with
                | tax_witness (tax_jurisdiction, tax_currency, tax_document, tax_amount, tax_identity) =>
                    $"(let fields = [| !order_entity; !order_currency; !order_item; !order_document; !order_identity; !receipt_entity; !receipt_currency; !receipt_item; !receipt_location; !receipt_document; string !receipt_quantity; !receipt_identity; !tax_jurisdiction; !tax_currency; !tax_document; string !tax_amount; !tax_identity |] in let bytes = fields |> Array.collect (fun value -> let payload = System.Text.Encoding.UTF8.GetBytes(value) in let length = System.BitConverter.GetBytes(System.Net.IPAddress.HostToNetworkOrder(payload.Length)) in Array.append length payload) in System.Convert.ToBase64String(bytes))"

inl erp_match_invoice_payload_frame
