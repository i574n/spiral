                command_identity aggregate_identity existing_hash prior)
    | TypedFxHashedStatementIdentityCollisionThere ::
        \* command_identity incoming_hash
            other_identity other_aggregate other_hash prior.
        typed_fx_hashed_statement_identity_collision
            command_identity incoming_hash prior * string ->
        typed_fx_hashed_statement_identity_collision
            command_identity incoming_hash
            (typed_fx_hashed_statement_history_more
                other_identity other_aggregate other_hash prior)

:| typed_fx_hashed_statement_event_store_decision
    command_identity aggregate_identity payload_hash
    expected actual history after_position after_history =
    | TypedFxHashedStatementEventStoreApplied ::
        \* command_identity aggregate_identity payload_hash position history.
        typed_fx_statement_expected_stream_position position position *
        typed_fx_hashed_statement_command
            command_identity aggregate_identity payload_hash
            typed_fx_statement_command_applied *
        typed_fx_hashed_statement_event_log position history *
        typed_fx_hashed_statement_event_log
            (typed_fx_statement_stream_position_next position)
            (typed_fx_hashed_statement_history_more
                command_identity aggregate_identity payload_hash history) * string ->
        typed_fx_hashed_statement_event_store_decision
            command_identity aggregate_identity payload_hash
            position position history
            (typed_fx_statement_stream_position_next position)
            (typed_fx_hashed_statement_history_more
                command_identity aggregate_identity payload_hash history)
    | TypedFxHashedStatementEventStoreDuplicateExact ::
        \* command_identity aggregate_identity payload_hash expected actual history.
        typed_fx_hashed_statement_history_contains
            command_identity aggregate_identity payload_hash history *
        typed_fx_hashed_statement_event_log actual history * string ->
        typed_fx_hashed_statement_event_store_decision
            command_identity aggregate_identity payload_hash
            expected actual history actual history
    | TypedFxHashedStatementEventStoreIdentityCollision ::
        \* command_identity aggregate_identity payload_hash expected actual history.
        typed_fx_hashed_statement_identity_collision
            command_identity payload_hash history *
        typed_fx_hashed_statement_event_log actual history * string ->
        typed_fx_hashed_statement_event_store_decision
            command_identity aggregate_identity payload_hash
            expected actual history actual history
    | TypedFxHashedStatementEventStoreVersionConflict ::
        \* command_identity aggregate_identity payload_hash expected actual history.
        typed_fx_statement_stream_position_not_equal expected actual *
        typed_fx_hashed_statement_event_log actual history * string ->
        typed_fx_hashed_statement_event_store_decision
            command_identity aggregate_identity payload_hash
            expected actual history actual history

:= apply_typed_fx_hashed_statement_command_to_event_log
    \* command_identity aggregate_identity payload_hash position history.
    (expected : typed_fx_statement_expected_stream_position position position)
    (command :
        typed_fx_hashed_statement_command
            command_identity aggregate_identity payload_hash typed_fx_statement_command_fresh)
    (log : typed_fx_hashed_statement_event_log position history)
    : typed_fx_hashed_statement_event_store_decision
        command_identity aggregate_identity payload_hash
        position position history
        (typed_fx_statement_stream_position_next position)
        (
            typed_fx_hashed_statement_history_more
                command_identity aggregate_identity payload_hash history
        )
    =
    ?= command ?|
    | typed_fx_hashed_statement_command (
        identity, aggregate, payload_hash_value, fresh, note) =>
        ?= apply_typed_fx_statement_command_once fresh ?|
        | TypedFxStatementCommandApply (
            typed_fx_statement_command (statements, _), _) =>
            := applied =
                typed_fx_statement_command (
                    statements,
                    "the-consumer-derives-the-applied-command-from-the-transition-source")
            := persisted =
                typed_fx_hashed_statement_command (
                    identity, aggregate, payload_hash_value, applied, note)
            TypedFxHashedStatementEventStoreApplied (
                expected,
                persisted,
                log,
                TypedFxHashedStatementEventLogMore (
                    persisted,
                    log,
                    "the-hashed-command-is-appended-with-identity-aggregate-and-payload-hash"),
                "matching-version-and-fresh-command-produce-an-applied-hashed-event")

:= ^ typed_fx_hashed_statement_event_log_runtime \* position history.
    (log : typed_fx_hashed_statement_event_log position history)
    : i64 * i64 * i64 * i64 * i64 =
    ?= log ?|
    | TypedFxHashedStatementEventLogEmpty =>
        0i64, 0i64, 0i64, 0i64, 0i64
    | TypedFxHashedStatementEventLogMore (
        typed_fx_hashed_statement_command (_, _, _, applied, _), tail, _) =>
        := tail_events, tail_statements, tail_debit, tail_credit, tail_mismatch =
            typed_fx_hashed_statement_event_log_runtime tail
        := statements, _, _, debit, credit, mismatch =
            ?= applied ?|
            | typed_fx_statement_command (program, _) =>
                typed_fx_signed_scaled_entity_currency_statement_program_runtime program
        runtime_add_i64 1i64 tail_events,
        runtime_add_i64 statements tail_statements,
        runtime_add_i64 debit tail_debit,
        runtime_add_i64 credit tail_credit,
        runtime_add_i64 mismatch tail_mismatch

:= typed_fx_hashed_statement_event_store_decision_runtime
    \* command_identity aggregate_identity payload_hash
    expected actual history after_position after_history.
    (decision :
        typed_fx_hashed_statement_event_store_decision
            command_identity aggregate_identity payload_hash expected actual history after_position after_history)
    : i64 * i64 * i64 * i64 * i64 * i64 * i64 * i64 * i64
    =
    ?= decision ?|
    | TypedFxHashedStatementEventStoreApplied (_, _, _, after, _) =>
        := events, statements, debit, credit, mismatch =
            typed_fx_hashed_statement_event_log_runtime after
        1i64, 0i64, 0i64, 0i64, events, statements, debit, credit, mismatch
    | TypedFxHashedStatementEventStoreDuplicateExact (_, log, _) =>
        := events, statements, debit, credit, mismatch =
            typed_fx_hashed_statement_event_log_runtime log
        0i64, 1i64, 0i64, 0i64, events, statements, debit, credit, mismatch
    | TypedFxHashedStatementEventStoreIdentityCollision (_, log, _) =>
        := events, statements, debit, credit, mismatch =
            typed_fx_hashed_statement_event_log_runtime log
        0i64, 0i64, 1i64, 0i64, events, statements, debit, credit, mismatch
    | TypedFxHashedStatementEventStoreVersionConflict (_, log, _) =>
        := events, statements, debit, credit, mismatch =
            typed_fx_hashed_statement_event_log_runtime log
        0i64, 0i64, 0i64, 1i64, events, statements, debit, credit, mismatch

:= assert_typed_fx_hashed_statement_event_store_decisions_runtime
    (applied : i64) (duplicate : i64) (collision : i64) (conflict : i64)
    (events : i64) (statements : i64) (debit : i64)
    (credit : i64) (mismatch : i64)
    : ()
    =
    := ok_0 = !!!!EQ(applied, 1i64)
    := ok_1 = !!!!EQ(duplicate, 1i64)
    := ok_2 = !!!!EQ(collision, 1i64)
    := ok_3 = !!!!EQ(conflict, 1i64)
    := ok_4 = !!!!EQ(events, 4i64)
    := ok_5 = !!!!EQ(statements, 12i64)
    := ok_6 = !!!!EQ(debit, 40i64)
    := ok_7 = !!!!EQ(credit, 40i64)
    := ok_8 = !!!!EQ(mismatch, 0i64)
    ? ok_0 && ok_1 && ok_2 && ok_3 && ok_4 && ok_5 && ok_6 && ok_7 && ok_8
    ?> ()
    |: mega_runtime_fail "typed-FX-hashed-statement-event-store-decision-runtime-mismatch"

:== typed_fx_hashed_primary_position =
    typed_fx_statement_stream_position_next typed_fx_statement_stream_position_zero

:== typed_fx_hashed_primary_history =
    typed_fx_hashed_statement_history_more
        typed_fx_statement_command_identity_primary
        typed_fx_statement_aggregate_identity_primary
        typed_fx_statement_payload_hash_primary
        typed_fx_hashed_statement_history_empty

:! typed_fx_hashed_statement_checksummed_frame
    command_identity aggregate_identity payload_hash =
    (typed_fx_hashed_statement_command
        command_identity aggregate_identity payload_hash
        typed_fx_statement_command_applied) * i64 * string

:= typed_fx_hashed_statement_command_checksum
    \* command_identity aggregate_identity payload_hash.
    (command :
        typed_fx_hashed_statement_command
            command_identity aggregate_identity payload_hash typed_fx_statement_command_applied)
    : i64
    =
    ?= command ?|
    | typed_fx_hashed_statement_command (_, _, _, applied, _) =>
        ?= applied ?|
        | typed_fx_statement_command (program, _) =>
            := statements, _, _, debit, credit, mismatch =
                typed_fx_signed_scaled_entity_currency_statement_program_runtime program
            runtime_add_i64 statements
                (runtime_add_i64 debit
                    (runtime_add_i64 credit mismatch))

:= seal_typed_fx_hashed_statement_checksummed_frame
    \* command_identity aggregate_identity payload_hash.
    (command :
        typed_fx_hashed_statement_command
            command_identity aggregate_identity payload_hash typed_fx_statement_command_applied)
    : typed_fx_hashed_statement_checksummed_frame command_identity aggregate_identity payload_hash
    =
    typed_fx_hashed_statement_checksummed_frame (
        command,
        typed_fx_hashed_statement_command_checksum command,
        "the-frame-checksum-is-derived-from-the-applied-statement-program")


:| ^ typed_fx_hashed_statement_checksummed_persisted_log position history =
    | TypedFxHashedStatementChecksummedPersistedLogEmpty ::
        typed_fx_hashed_statement_checksummed_persisted_log
            typed_fx_statement_stream_position_zero
            typed_fx_hashed_statement_history_empty
    | TypedFxHashedStatementChecksummedPersistedLogMore :: \*
        position history command_identity aggregate_identity payload_hash.
        typed_fx_hashed_statement_checksummed_frame
            command_identity aggregate_identity payload_hash *
        typed_fx_hashed_statement_checksummed_persisted_log position history * string ->
        typed_fx_hashed_statement_checksummed_persisted_log
            (typed_fx_statement_stream_position_next position)
            (typed_fx_hashed_statement_history_more
                command_identity aggregate_identity payload_hash history)

:= ^ persist_typed_fx_hashed_statement_event_log_with_checksums
    \* position history.
    (log : typed_fx_hashed_statement_event_log position history)
    : typed_fx_hashed_statement_checksummed_persisted_log position history =
    ?= log ?|
    | TypedFxHashedStatementEventLogEmpty =>
        TypedFxHashedStatementChecksummedPersistedLogEmpty
    | TypedFxHashedStatementEventLogMore (command, tail, note) =>
        TypedFxHashedStatementChecksummedPersistedLogMore (
            seal_typed_fx_hashed_statement_checksummed_frame command,
            persist_typed_fx_hashed_statement_event_log_with_checksums tail,
            note)


:= ^ typed_fx_hashed_statement_checksummed_persisted_log_runtime
    \* position history.
    (persisted : typed_fx_hashed_statement_checksummed_persisted_log position history)
    : i64 * i64 =
    ?= persisted ?|
    | TypedFxHashedStatementChecksummedPersistedLogEmpty => 0i64, 0i64
    | TypedFxHashedStatementChecksummedPersistedLogMore (
        typed_fx_hashed_statement_checksummed_frame (_, checksum, _), tail, _) =>
        := frames, checksum_sum =
            typed_fx_hashed_statement_checksummed_persisted_log_runtime tail
        runtime_add_i64 1i64 frames,
        runtime_add_i64 checksum checksum_sum

:= typed_fx_hashed_statement_checksummed_frame_audit_runtime
    \* command_identity aggregate_identity payload_hash.
    (frame : typed_fx_hashed_statement_checksummed_frame command_identity aggregate_identity payload_hash)
    : i64 * i64 =
    ?= frame ?|
    | typed_fx_hashed_statement_checksummed_frame (command, stored_checksum, _) =>
        stored_checksum,
        typed_fx_hashed_statement_command_checksum command

:| typed_fx_hashed_statement_checksum_validation =
    | TypedFxHashedStatementChecksumValidationAccepted ::
        i64 * i64 * i64 * i64 * i64 * string ->
        typed_fx_hashed_statement_checksum_validation
    | TypedFxHashedStatementChecksumValidationRejected ::
        i64 * i64 * string ->
        typed_fx_hashed_statement_checksum_validation

:= ^ validate_typed_fx_hashed_statement_checksummed_persisted_log
    \* position history.
    (persisted : typed_fx_hashed_statement_checksummed_persisted_log position history)
    : typed_fx_hashed_statement_checksum_validation
    =
    ?= persisted ?|
    | TypedFxHashedStatementChecksummedPersistedLogEmpty =>
        TypedFxHashedStatementChecksumValidationAccepted (
            0i64, 0i64, 0i64, 0i64, 0i64,
            "the-empty-checksummed-log-validates-to-empty-restart-metrics")
    | TypedFxHashedStatementChecksummedPersistedLogMore (frame, tail, _) =>
        ?= validate_typed_fx_hashed_statement_checksummed_persisted_log tail ?|
        | TypedFxHashedStatementChecksumValidationRejected (
                stored_checksum,
                actual_checksum,
                reason
            )
            =>
                TypedFxHashedStatementChecksumValidationRejected (
                    stored_checksum,
                    actual_checksum,
                    reason)
        | TypedFxHashedStatementChecksumValidationAccepted (
                tail_events,
                tail_statements,
                tail_debit,
                tail_credit,
                tail_mismatch,
                _
            )
            =>
                ?= frame ?|
                | typed_fx_hashed_statement_checksummed_frame (
                        command,
                        stored_checksum,
                        _
                    )
                    =>
                        := actual_checksum =
                            typed_fx_hashed_statement_command_checksum command
                        := checksum_matches : bool =
                            !!!!EQ(stored_checksum, actual_checksum)
                        ? checksum_matches
                        ?>
                            ?= command ?|
                            | typed_fx_hashed_statement_command (_, _, _, applied, _) =>
                                := statements, _, _, debit, credit, mismatch =
                                    ?= applied ?|
                                    | typed_fx_statement_command (program, _) =>
                                        typed_fx_signed_scaled_entity_currency_statement_program_runtime program
                                TypedFxHashedStatementChecksumValidationAccepted (
                                    runtime_add_i64 1i64 tail_events,
                                    runtime_add_i64 statements tail_statements,
                                    runtime_add_i64 debit tail_debit,
                                    runtime_add_i64 credit tail_credit,
                                    runtime_add_i64 mismatch tail_mismatch,
                                    "validated-restart-metrics-are-derived-only-after-the-current-frame-and-the-ent"
                                    ^^ "ire-tail-pass-checksum-validation"
                                )
                        |:
                            TypedFxHashedStatementChecksumValidationRejected (
                                stored_checksum,
                                actual_checksum,
                                "checksum-mismatch-blocks-the-frame-before-it-contributes-any-restart-metric")

:= typed_fx_hashed_statement_checksum_validation_runtime
    (decision : typed_fx_hashed_statement_checksum_validation)
    : i64 * i64 =
    ?= decision ?|
    | TypedFxHashedStatementChecksumValidationAccepted _ => 1i64, 0i64
    | TypedFxHashedStatementChecksumValidationRejected _ => 0i64, 1i64

:= assert_typed_fx_hashed_statement_checksum_validation_runtime
    (accepted : i64) (rejected : i64) : () =
    := ok_0 = !!!!EQ(accepted, 1i64)
    := ok_1 = !!!!EQ(rejected, 1i64)
    ? ok_0 && ok_1 ?> () |: mega_runtime_fail "typed-FX-hashed-statement-checksum-validation-runtime-mismatch"

:= restart_typed_fx_hashed_statement_event_log_validated_runtime
    \* position history.
    (persisted : typed_fx_hashed_statement_checksummed_persisted_log position history)
    : i64 * i64 * i64 * i64 * i64 * i64 * i64 * i64 * i64 =
    ?= validate_typed_fx_hashed_statement_checksummed_persisted_log persisted ?|
    | TypedFxHashedStatementChecksumValidationRejected (
        stored_checksum, actual_checksum, _) =>
        0i64, 1i64, stored_checksum, actual_checksum,
        0i64, 0i64, 0i64, 0i64, 0i64
    | TypedFxHashedStatementChecksumValidationAccepted (
        events, statements, debit, credit, mismatch, _) =>
        1i64, 0i64, 0i64, 0i64,
        events, statements, debit, credit, mismatch

:= assert_restart_typed_fx_hashed_statement_event_log_validated_runtime
    (valid_accepted : i64) (corrupt_rejected : i64)
    (corrupt_stored : i64) (corrupt_actual : i64)
    (events : i64) (statements : i64)
    (debit : i64) (credit : i64) (mismatch : i64)
    : ()
    =
    := ok_0 = !!!!EQ(valid_accepted, 1i64)
    := ok_1 = !!!!EQ(corrupt_rejected, 1i64)
    := ok_2 = !!!!EQ(corrupt_stored, 999i64)
    := ok_3 = !!!!EQ(corrupt_actual, 23i64)
    := ok_4 = !!!!EQ(events, 1i64)
    := ok_5 = !!!!EQ(statements, 3i64)
    := ok_6 = !!!!EQ(debit, 10i64)
    := ok_7 = !!!!EQ(credit, 10i64)
    := ok_8 = !!!!EQ(mismatch, 0i64)
    ? ok_0 && ok_1 && ok_2 && ok_3 && ok_4 && ok_5 && ok_6 && ok_7 && ok_8
    ?> ()
    |: mega_runtime_fail "typed-FX-hashed-statement-validated-restart-runtime-mismatch"

:= assert_typed_fx_hashed_statement_checksummed_restart_runtime
    (frames : i64) (checksum_sum : i64)
    (stored_checksum : i64) (actual_checksum : i64)
    (corrupted_stored_checksum : i64) (corrupted_actual_checksum : i64)
    (events_before : i64) (events_after : i64)
    (statements_before : i64) (statements_after : i64)
    (debit_before : i64) (debit_after : i64)
    (credit_before : i64) (credit_after : i64)
    (mismatch_before : i64) (mismatch_after : i64)
    : ()
    =
    := ok_0 = !!!!EQ(frames, 1i64)
    := ok_1 = !!!!EQ(checksum_sum, 23i64)
    := ok_2 = !!!!EQ(stored_checksum, 23i64)
    := ok_3 = !!!!EQ(actual_checksum, 23i64)
    := ok_4 = !!!!EQ(corrupted_stored_checksum, 999i64)
    := ok_5 = !!!!EQ(corrupted_actual_checksum, 23i64)
    := ok_6 = !!!!EQ(events_before, 1i64)
    := ok_7 = !!!!EQ(events_after, 1i64)
    := ok_8 = !!!!EQ(statements_before, 3i64)
    := ok_9 = !!!!EQ(statements_after, 3i64)
    := ok_10 = !!!!EQ(debit_before, 10i64)
    := ok_11 = !!!!EQ(debit_after, 10i64)
    := ok_12 = !!!!EQ(credit_before, 10i64)
    := ok_13 = !!!!EQ(credit_after, 10i64)
    := ok_14 = !!!!EQ(mismatch_before, 0i64)
    := ok_15 = !!!!EQ(mismatch_after, 0i64)
    ?
        ok_0
        && ok_1
        && ok_2
        && ok_3
        && ok_4
        && ok_5
        && ok_6
        && ok_7
        && ok_8
        && ok_9
        && ok_10
        && ok_11
        && ok_12
        && ok_13
        && ok_14
        && ok_15
    ?> ()
    |: mega_runtime_fail "typed-FX-hashed-statement-checksummed-restart-runtime-mismatch"

:= typed_fx_hashed_statement_checksummed_restart_terminal () : string =
    := journals =
        post_typed_fx_determined_journal_program_as_signed_scaled
            (post_typed_fx_determined_rounding_receipt_program
                (typed_fx_determined_rounding_receipt_program_value ()))
    := ledgers =
        index_typed_fx_signed_scaled_journal_program_by_entity_currency journals
    := statements =
        consume_typed_fx_signed_scaled_ledger_program_with_matching_keys ledgers
    := primary
        : typed_fx_hashed_statement_command typed_fx_statement_command_identity_primary
            typed_fx_statement_aggregate_identity_primary typed_fx_statement_payload_hash_primary
            typed_fx_statement_command_fresh
        =
        typed_fx_hashed_statement_command (
            typed_fx_statement_command_identity_primary "primary-statement-command",
            typed_fx_statement_aggregate_identity_primary "primary-ledger-aggregate",
            typed_fx_statement_payload_hash_primary "payload-hash-primary",
            typed_fx_statement_command (
                statements,
                "the-primary-command-is-materialized-before-checksummed-persistence"),
            "identity-aggregate-and-payload-hash-remain-indexed-across-checksummed-persistence")
    := expected_zero
        : typed_fx_statement_expected_stream_position typed_fx_statement_stream_position_zero
            typed_fx_statement_stream_position_zero
        =
        TypedFxStatementExpectedStreamPosition (
            TypedFxStatementStreamPositionZeroValue,
            "the-checksummed-writer-expects-position-zero")
    := empty
        : typed_fx_hashed_statement_event_log typed_fx_statement_stream_position_zero
            typed_fx_hashed_statement_history_empty
        =
        TypedFxHashedStatementEventLogEmpty
    := applied =
        apply_typed_fx_hashed_statement_command_to_event_log
            expected_zero primary empty
    ?= applied ?|
    | TypedFxHashedStatementEventStoreApplied (_, _, _, recorded, _) =>
        := persisted =
            persist_typed_fx_hashed_statement_event_log_with_checksums recorded
        := validated =
            validate_typed_fx_hashed_statement_checksummed_persisted_log persisted
        := frames, checksum_sum =
            typed_fx_hashed_statement_checksummed_persisted_log_runtime persisted
        := stored_checksum, actual_checksum,
            corrupted_stored_checksum, corrupted_actual_checksum =
            ?= persisted ?|
            | TypedFxHashedStatementChecksummedPersistedLogMore (frame, _, _) =>
                := stored_checksum, actual_checksum =
                    typed_fx_hashed_statement_checksummed_frame_audit_runtime frame
                ?= frame ?|
                | typed_fx_hashed_statement_checksummed_frame (command, _, note) =>
                    := corrupted =
                        typed_fx_hashed_statement_checksummed_frame (
                            command,
                            999i64,
                            note)
                    := corrupted_stored_checksum, corrupted_actual_checksum =
                        typed_fx_hashed_statement_checksummed_frame_audit_runtime corrupted
                    stored_checksum, actual_checksum,
                    corrupted_stored_checksum, corrupted_actual_checksum
        := corrupted_persisted =
            ?= persisted ?|
            | TypedFxHashedStatementChecksummedPersistedLogMore (frame, tail, note) =>
                ?= frame ?|
                | typed_fx_hashed_statement_checksummed_frame (command, _, frame_note) =>
                    TypedFxHashedStatementChecksummedPersistedLogMore (
                        typed_fx_hashed_statement_checksummed_frame (
                            command,
                            999i64,
                            frame_note),
                        tail,
                        note)
        := corrupted_validation =
            validate_typed_fx_hashed_statement_checksummed_persisted_log
                corrupted_persisted
        := valid_accepted, valid_rejected =
            typed_fx_hashed_statement_checksum_validation_runtime validated
        := corrupt_accepted, corrupt_rejected =
            typed_fx_hashed_statement_checksum_validation_runtime corrupted_validation
        := _ =
            assert_typed_fx_hashed_statement_checksum_validation_runtime
                valid_accepted corrupt_rejected
        := _ = valid_rejected
        := _ = corrupt_accepted
        := valid_restart_accepted, valid_restart_rejected,
            _, _, valid_restart_events, valid_restart_statements,
            valid_restart_debit, valid_restart_credit,
            valid_restart_mismatch =
            restart_typed_fx_hashed_statement_event_log_validated_runtime persisted
        := corrupt_restart_accepted, corrupt_restart_rejected,
            corrupt_restart_stored, corrupt_restart_actual,
            _, _, _, _, _ =
            restart_typed_fx_hashed_statement_event_log_validated_runtime
                corrupted_persisted
        := _ =
            assert_restart_typed_fx_hashed_statement_event_log_validated_runtime
                valid_restart_accepted corrupt_restart_rejected
                corrupt_restart_stored corrupt_restart_actual
                valid_restart_events valid_restart_statements
                valid_restart_debit valid_restart_credit
                valid_restart_mismatch
        := _ = valid_restart_rejected
        := _ = corrupt_restart_accepted
        := events_before, statements_before, debit_before,
            credit_before, mismatch_before =
            typed_fx_hashed_statement_event_log_runtime recorded
        := events_after = valid_restart_events
        := statements_after = valid_restart_statements
        := debit_after = valid_restart_debit
        := credit_after = valid_restart_credit
        := mismatch_after = valid_restart_mismatch
        := _ =
            assert_typed_fx_hashed_statement_checksummed_restart_runtime
                frames checksum_sum stored_checksum actual_checksum
                corrupted_stored_checksum corrupted_actual_checksum
                events_before events_after statements_before statements_after
                debit_before debit_after credit_before credit_after
                mismatch_before mismatch_after
        "persisted-frames-now-carry-a-deterministic-checksum-derived-from-the-indexed-applied-statement-program-and"
        ^^ "-the-only-restart-runtime-recomputes-the-entire-chain-before-returning-derived-metrics-while-a-forged-nine"
        ^^ "-hundred-ninety-nine-frame-is-rejected-and-the-unchecked-unseal-and-restart-helpers-have-been-physically-r"
        ^^ "etired-with-byte-encoding-fsync-and-atomic-CAS-still-open-sealed"

:| typed_usd_eur_determined_tie_rounding output =
    | TypedUsdEurDeterminedHalfUpTie :: \* output.
        typed_fx_fractional_half_up_rounding_decision
            usd eur erp_rate_three erp_rate_three erp_rate_two
            erp_rate_four erp_rate_one erp_rate_nine erp_rate_eight
            output erp_rate_one ->
        typed_usd_eur_determined_tie_rounding output
    | TypedUsdEurDeterminedHalfEvenTie :: \* output.
        typed_fx_fractional_half_even_rounding_decision
            usd eur erp_rate_three erp_rate_three erp_rate_two
            erp_rate_four erp_rate_one erp_rate_nine erp_rate_eight
            output ->
        typed_usd_eur_determined_tie_rounding output

:= typed_usd_eur_determined_tie_rounding_runtime \* output.
    (decision : typed_usd_eur_determined_tie_rounding output)
    : i64 * i64 * i64 * i64 =
    ?= decision ?|
    | TypedUsdEurDeterminedHalfUpTie half_up =>
        := denominator, quotient, remainder, rounded, adjustment, doubled =
            typed_fx_fractional_half_up_rounding_runtime half_up
        0i64, rounded, adjustment,
        erp_runtime_add_i64 denominator doubled
    | TypedUsdEurDeterminedHalfEvenTie half_even =>
        := denominator, quotient, remainder, rounded, doubled =
            typed_fx_fractional_half_even_rounding_runtime half_even
        1i64, rounded, 0i64,
        erp_runtime_add_i64 denominator doubled

:= assert_typed_usd_eur_determined_tie_rounding_runtime
    (modes : i64) (rounded : i64) (adjustments : i64) (tie_checks : i64)
    : ()
    =
    := ok_0 = !!!!EQ(modes, 1i64)
    := ok_1 = !!!!EQ(rounded, 9i64)
    := ok_2 = !!!!EQ(adjustments, 1i64)
    := ok_3 = !!!!EQ(tie_checks, 8i64)
    ? ok_0 && ok_1 && ok_2 && ok_3
    ?> ()
    |: mega_runtime_fail "typed-usd-eur-determined-tie-rounding-runtime-mismatch"

:= typed_usd_eur_determined_tie_rounding_terminal () : string =
    := half_up : typed_usd_eur_determined_tie_rounding erp_rate_five =
        TypedUsdEurDeterminedHalfUpTie
            (typed_usd_eur_fractional_half_up_rounding_decision ())
    := half_even : typed_usd_eur_determined_tie_rounding erp_rate_four =
        TypedUsdEurDeterminedHalfEvenTie
            (typed_usd_eur_fractional_half_even_rounding_decision ())
    := hum, hur, hua, hut =
        typed_usd_eur_determined_tie_rounding_runtime half_up
    := hem, her, hea, het =
        typed_usd_eur_determined_tie_rounding_runtime half_even
    := _ =
        assert_typed_usd_eur_determined_tie_rounding_runtime
            (erp_runtime_add_i64 hum hem)
            (erp_runtime_add_i64 hur her)
            (erp_runtime_add_i64 hua hea)
            (erp_runtime_add_i64 hut het)
    "half-up-and-half-even-now-share-one-output-indexed-tie-rounding-family-so-the-policy-constructor-determines-fi"
    ^^ "ve-or-four-from-the-same-nine-over-two-equation-and-an-arbitrary-i64-result-cannot-enter-the-active-tie-surfac"
    ^^ "e-sealed"

:| typed_fx_statement_stream_position_raw_byte =
    | TypedFxStatementStreamPositionRawZero
    | TypedFxStatementStreamPositionRawNext
    | TypedFxStatementStreamPositionRawCorrupt

:| ^ typed_fx_statement_stream_position_raw_bytes =
    | TypedFxStatementStreamPositionRawBytesDone
    | TypedFxStatementStreamPositionRawBytesMore ::
        typed_fx_statement_stream_position_raw_byte *
        typed_fx_statement_stream_position_raw_bytes * string ->
        typed_fx_statement_stream_position_raw_bytes

:| typed_fx_statement_stream_position_raw_decode_decision =
    | TypedFxStatementStreamPositionRawDecoded ::
        (\? position.
            typed_fx_statement_stream_position_value position * i64 * string) ->
        typed_fx_statement_stream_position_raw_decode_decision
    | TypedFxStatementStreamPositionRawRejected ::
        i64 * string ->
        typed_fx_statement_stream_position_raw_decode_decision

:= ^ encode_typed_fx_statement_stream_position_raw_bytes \* position.
    (position : typed_fx_statement_stream_position_value position)
    : typed_fx_statement_stream_position_raw_bytes =
    ?= position ?|
    | TypedFxStatementStreamPositionZeroValue =>
        TypedFxStatementStreamPositionRawBytesMore (
            TypedFxStatementStreamPositionRawZero,
            TypedFxStatementStreamPositionRawBytesDone,
            "zero-is-the-terminal-position-byte")
    | TypedFxStatementStreamPositionNextValue (prior, _) =>
        TypedFxStatementStreamPositionRawBytesMore (
            TypedFxStatementStreamPositionRawNext,
            encode_typed_fx_statement_stream_position_raw_bytes prior,
            "next-prefixes-the-canonical-byte-encoding-of-its-predecessor")

:= ^ typed_fx_statement_stream_position_raw_bytes_count
    (bytes : typed_fx_statement_stream_position_raw_bytes) : i64 =
    ?= bytes ?|
    | TypedFxStatementStreamPositionRawBytesDone => 0i64
    | TypedFxStatementStreamPositionRawBytesMore (_, tail, _) =>
        runtime_add_i64 1i64
            (typed_fx_statement_stream_position_raw_bytes_count tail)

:= typed_fx_statement_expected_position_from_decoded \* position.
    (position_value : typed_fx_statement_stream_position_value position)
    : typed_fx_statement_expected_stream_position position position =
    TypedFxStatementExpectedStreamPosition (
        position_value,
        "a-successful-hostile-byte-decode-can-immediately-reify-the-exact-same-position-index-as-an-append-expectation")

:= ^ decode_typed_fx_statement_stream_position_raw_bytes
    (bytes : typed_fx_statement_stream_position_raw_bytes)
    : typed_fx_statement_stream_position_raw_decode_decision
    =
    ?= bytes ?|
    | TypedFxStatementStreamPositionRawBytesDone =>
        TypedFxStatementStreamPositionRawRejected (
            0i64,
            "an-empty-byte-stream-is-a-truncated-position")
    | TypedFxStatementStreamPositionRawBytesMore (
            TypedFxStatementStreamPositionRawZero,
            tail,
            _
        )
        =>
            ?= tail ?|
            | TypedFxStatementStreamPositionRawBytesDone =>
                := position_value = TypedFxStatementStreamPositionZeroValue
                := _ = typed_fx_statement_expected_position_from_decoded position_value
                TypedFxStatementStreamPositionRawDecoded (
                    \? (
                        position_value,
                        1i64,
                        "one-zero-byte-decodes-to-the-indexed-zero-position-and-reifies-the-exact-append-expectatio"
                        ^^ "n-before-packing"
                    )
                )
            | TypedFxStatementStreamPositionRawBytesMore _ =>
                TypedFxStatementStreamPositionRawRejected (
                    typed_fx_statement_stream_position_raw_bytes_count bytes,
                    "bytes-after-zero-are-rejected-as-trailing-position-data")
    | TypedFxStatementStreamPositionRawBytesMore (
            TypedFxStatementStreamPositionRawNext,
            tail,
            _
        )
        =>
            ?= decode_typed_fx_statement_stream_position_raw_bytes tail ?|
            | TypedFxStatementStreamPositionRawDecoded payload =>
                := \? prior. prior_value, cells, _ = payload
                := position_value =
                    TypedFxStatementStreamPositionNextValue (
                        prior_value,
                        "the-decoder-reconstructs-one-indexed-successor")
                := _ = typed_fx_statement_expected_position_from_decoded position_value
                TypedFxStatementStreamPositionRawDecoded (
                    \? (
                        position_value,
                        runtime_add_i64 1i64 cells,
                        "a-next-byte-is-accepted-only-when-its-tail-decodes-completely-and-the-reconstructed-succes"
                        ^^ "sor-reifies-its-exact-append-expectation"
                    )
                )
            | TypedFxStatementStreamPositionRawRejected (cells, note) =>
                TypedFxStatementStreamPositionRawRejected (
                    runtime_add_i64 1i64 cells,
                    note)
    | TypedFxStatementStreamPositionRawBytesMore (
            TypedFxStatementStreamPositionRawCorrupt,
            _,
            _
        )
        =>
            TypedFxStatementStreamPositionRawRejected (
                typed_fx_statement_stream_position_raw_bytes_count bytes,
                "an-unknown-position-byte-is-rejected-before-restart")

:= typed_fx_statement_stream_position_raw_decode_runtime
    (decision : typed_fx_statement_stream_position_raw_decode_decision)
    : i64 * i64 * i64 * i64 =
    ?= decision ?|
    | TypedFxStatementStreamPositionRawDecoded payload =>
        := \? position. value, cells, _ = payload
        1i64, 0i64,
        typed_fx_statement_stream_position_value_runtime value,
        cells
    | TypedFxStatementStreamPositionRawRejected (cells, _) =>
        0i64, 1i64, 0i64, cells

:= assert_typed_fx_statement_stream_position_raw_decode_runtime
    (accepted : i64) (rejected : i64)
    (position : i64) (accepted_cells : i64)
    (rejected_cells : i64)
    : ()
    =
    := ok_0 = !!!!EQ(accepted, 1i64)
    := ok_1 = !!!!EQ(rejected, 3i64)
    := ok_2 = !!!!EQ(position, 1i64)
    := ok_3 = !!!!EQ(accepted_cells, 2i64)
    := ok_4 = !!!!EQ(rejected_cells, 4i64)
    ? ok_0 && ok_1 && ok_2 && ok_3 && ok_4
    ?> ()
    |: mega_runtime_fail "typed-FX-statement-stream-position-raw-decode-runtime-mismatch"

:= typed_fx_statement_stream_position_raw_decode_terminal () : string =
    := position
        : typed_fx_statement_stream_position_value
            (typed_fx_statement_stream_position_next typed_fx_statement_stream_position_zero)
        =
        TypedFxStatementStreamPositionNextValue (
            TypedFxStatementStreamPositionZeroValue,
            "position-one-is-the-canonical-hostile-byte-roundtrip-fixture")
    := valid =
        decode_typed_fx_statement_stream_position_raw_bytes
            (encode_typed_fx_statement_stream_position_raw_bytes position)
    := truncated =
        decode_typed_fx_statement_stream_position_raw_bytes
            (TypedFxStatementStreamPositionRawBytesMore (
                TypedFxStatementStreamPositionRawNext,
                TypedFxStatementStreamPositionRawBytesDone,
                "a-next-byte-without-a-terminal-zero-is-truncated"))
    := corrupt =
        decode_typed_fx_statement_stream_position_raw_bytes
            (TypedFxStatementStreamPositionRawBytesMore (
                TypedFxStatementStreamPositionRawCorrupt,
                TypedFxStatementStreamPositionRawBytesDone,
                "an-unknown-byte-is-corrupt"))
    := trailing =
        decode_typed_fx_statement_stream_position_raw_bytes
            (TypedFxStatementStreamPositionRawBytesMore (
                TypedFxStatementStreamPositionRawZero,
                TypedFxStatementStreamPositionRawBytesMore (
                    TypedFxStatementStreamPositionRawZero,
                    TypedFxStatementStreamPositionRawBytesDone,
                    "the-second-zero-is-trailing-data"),
                "the-first-zero-must-end-the-stream"))
    := va, vr, vp, vc =
        typed_fx_statement_stream_position_raw_decode_runtime valid
    := ta, tr, tp, tc =
        typed_fx_statement_stream_position_raw_decode_runtime truncated
    := ca, cr, cp, cc =
        typed_fx_statement_stream_position_raw_decode_runtime corrupt
    := xa, xr, xp, xc =
        typed_fx_statement_stream_position_raw_decode_runtime trailing
    := _ = ta
    := _ = tp
    := _ = ca
    := _ = cp
    := _ = xa
    := _ = xp
    := _ = vr
    := _ =
        assert_typed_fx_statement_stream_position_raw_decode_runtime
            va
            (runtime_add_i64 tr (runtime_add_i64 cr xr))
            vp vc
            (runtime_add_i64 tc (runtime_add_i64 cc xc))
    "stream-positions-now-cross-an-explicit-hostile-byte-boundary-whose-total-decoder-accepts-the-canonical-next-ze"
    ^^ "ro-encoding-and-rejects-truncation-unknown-tags-and-trailing-data-before-any-log-restart-while-fsync-and-atomi"
    ^^ "c-CAS-remain-open-sealed"

:| typed_fx_statement_expected_position_raw_decision position =
    | TypedFxStatementExpectedPositionRawAccepted :: \* position.
        typed_fx_statement_expected_stream_position position position *
        i64 * string ->
        typed_fx_statement_expected_position_raw_decision position
    | TypedFxStatementExpectedPositionRawRejected :: \* position.
        i64 * string ->
        typed_fx_statement_expected_position_raw_decision position

:= ^ validate_typed_fx_statement_expected_position_raw_bytes
    \* position.
    (expected : typed_fx_statement_expected_stream_position position position)
    (bytes : typed_fx_statement_stream_position_raw_bytes)
    : typed_fx_statement_expected_position_raw_decision position =
    ?= expected ?|
    | TypedFxStatementExpectedStreamPosition (position, _) =>
        ?= position, bytes ?|
        | TypedFxStatementStreamPositionZeroValue,
          TypedFxStatementStreamPositionRawBytesMore (
              TypedFxStatementStreamPositionRawZero,
              TypedFxStatementStreamPositionRawBytesDone, _) =>
            TypedFxStatementExpectedPositionRawAccepted (
                expected,
                1i64,
                "the-hostile-byte-stream-matches-the-indexed-zero-expectation")
        | TypedFxStatementStreamPositionZeroValue, _ =>
            TypedFxStatementExpectedPositionRawRejected (
                typed_fx_statement_stream_position_raw_bytes_count bytes,
                "noncanonical-bytes-cannot-authorize-the-indexed-zero-expectation")
        | TypedFxStatementStreamPositionNextValue (prior, _),
          TypedFxStatementStreamPositionRawBytesMore (
              TypedFxStatementStreamPositionRawNext, tail, _) =>
            := prior_expected =
                TypedFxStatementExpectedStreamPosition (
                    prior,
                    "the-successor-expectation-recurses-on-its-indexed-predecessor")
            ?= validate_typed_fx_statement_expected_position_raw_bytes
                    prior_expected tail ?|
            | TypedFxStatementExpectedPositionRawAccepted (_, cells, _) =>
                TypedFxStatementExpectedPositionRawAccepted (
                    expected,
                    runtime_add_i64 1i64 cells,
                    "every-successor-byte-matches-one-successor-in-the-expected-position-index")
            | TypedFxStatementExpectedPositionRawRejected (cells, note) =>
                TypedFxStatementExpectedPositionRawRejected (
                    runtime_add_i64 1i64 cells,
                    note)
        | TypedFxStatementStreamPositionNextValue _, _ =>
            TypedFxStatementExpectedPositionRawRejected (
                typed_fx_statement_stream_position_raw_bytes_count bytes,
                "the-hostile-byte-stream-does-not-match-the-indexed-successor-expectation")

:= typed_fx_statement_expected_position_raw_decision_runtime
    \* position.
    (decision : typed_fx_statement_expected_position_raw_decision position)
    : i64 * i64 * i64 * i64 =
    ?= decision ?|
    | TypedFxStatementExpectedPositionRawAccepted (
        TypedFxStatementExpectedStreamPosition (position, _), cells, _) =>
        1i64, 0i64,
        typed_fx_statement_stream_position_value_runtime position,
        cells
    | TypedFxStatementExpectedPositionRawRejected (cells, _) =>
        0i64, 1i64, 0i64, cells

:= assert_typed_fx_statement_expected_position_raw_decision_runtime
    (accepted : i64) (rejected : i64)
    (expected_position : i64) (accepted_cells : i64)
    (rejected_cells : i64)
    : ()
    =
    := ok_0 = !!!!EQ(accepted, 1i64)
    := ok_1 = !!!!EQ(rejected, 2i64)
    := ok_2 = !!!!EQ(expected_position, 0i64)
    := ok_3 = !!!!EQ(accepted_cells, 1i64)
    := ok_4 = !!!!EQ(rejected_cells, 3i64)
    ? ok_0 && ok_1 && ok_2 && ok_3 && ok_4
    ?> ()
    |: mega_runtime_fail "typed-FX-statement-expected-position-raw-decision-runtime-mismatch"

:= typed_fx_statement_expected_position_raw_decision_terminal () : string =
    := expected
        : typed_fx_statement_expected_stream_position typed_fx_statement_stream_position_zero
            typed_fx_statement_stream_position_zero
        =
        TypedFxStatementExpectedStreamPosition (
            TypedFxStatementStreamPositionZeroValue,
            "the-writer-expects-the-zero-position-before-the-first-append")
    := valid =
        validate_typed_fx_statement_expected_position_raw_bytes
            expected
            (TypedFxStatementStreamPositionRawBytesMore (
                TypedFxStatementStreamPositionRawZero,
                TypedFxStatementStreamPositionRawBytesDone,
                "the-canonical-zero-position-byte"))
    := stale =
        validate_typed_fx_statement_expected_position_raw_bytes
            expected
            (TypedFxStatementStreamPositionRawBytesMore (
                TypedFxStatementStreamPositionRawNext,
                TypedFxStatementStreamPositionRawBytesMore (
                    TypedFxStatementStreamPositionRawZero,
                    TypedFxStatementStreamPositionRawBytesDone,
                    "the-stale-writer-supplied-position-one"),
                "the-stale-byte-stream-does-not-match-position-zero"))
    := corrupt =
        validate_typed_fx_statement_expected_position_raw_bytes
            expected
            (TypedFxStatementStreamPositionRawBytesMore (
                TypedFxStatementStreamPositionRawCorrupt,
                TypedFxStatementStreamPositionRawBytesDone,
                "the-corrupt-tag-cannot-authorize-an-append"))
    := va, vr, vp, vc =
        typed_fx_statement_expected_position_raw_decision_runtime valid
    := sa, sr, sp, sc =
        typed_fx_statement_expected_position_raw_decision_runtime stale
    := ca, cr, cp, cc =
        typed_fx_statement_expected_position_raw_decision_runtime corrupt
    := _ = vr
    := _ = sa
    := _ = sp
    := _ = ca
    := _ = cp
    := _ =
        assert_typed_fx_statement_expected_position_raw_decision_runtime
            va
            (runtime_add_i64 sr cr)
            vp vc
            (runtime_add_i64 sc cc)
    "expected-version-validation-now-recurses-simultaneously-over-the-indexed-position-and-hostile-bytes-so-only-th"
    ^^ "e-canonical-byte-shape-can-recover-the-exact-witness-required-by-append-while-stale-and-corrupt-streams-are-re"
    ^^ "jected-before-store-mutation-sealed"

:| typed_fx_statement_expected_raw_append_decision
    command_identity aggregate_identity payload_hash position history =
    | TypedFxStatementExpectedRawAppendApplied ::
        \* command_identity aggregate_identity payload_hash position history.
        (\? after_position after_history.
            typed_fx_hashed_statement_event_store_decision
                command_identity aggregate_identity payload_hash
                position position history after_position after_history *
            i64 * string) ->
        typed_fx_statement_expected_raw_append_decision
            command_identity aggregate_identity payload_hash position history
    | TypedFxStatementExpectedRawAppendRejected ::
        \* command_identity aggregate_identity payload_hash position history.
        i64 * string ->
        typed_fx_statement_expected_raw_append_decision
            command_identity aggregate_identity payload_hash position history

:= apply_typed_fx_hashed_statement_command_from_expected_raw_bytes
    \* command_identity aggregate_identity payload_hash position history.
    (expected : typed_fx_statement_expected_stream_position position position)
    (bytes : typed_fx_statement_stream_position_raw_bytes)
    (command :
        typed_fx_hashed_statement_command
            command_identity aggregate_identity payload_hash typed_fx_statement_command_fresh)
    (log : typed_fx_hashed_statement_event_log position history)
    : typed_fx_statement_expected_raw_append_decision
        command_identity aggregate_identity payload_hash position history
    =
    ?= validate_typed_fx_statement_expected_position_raw_bytes expected bytes ?|
    | TypedFxStatementExpectedPositionRawAccepted (validated_expected, cells, _) =>
        TypedFxStatementExpectedRawAppendApplied (\? (
            apply_typed_fx_hashed_statement_command_to_event_log
                validated_expected command log,
            cells,
            "only-the-exact-indexed-byte-witness-is-allowed-to-reach-the-append"))
    | TypedFxStatementExpectedPositionRawRejected (cells, note) =>
        TypedFxStatementExpectedRawAppendRejected (
            cells,
            note)

:= typed_fx_statement_expected_raw_append_decision_runtime
    \* command_identity aggregate_identity payload_hash position history.
    (decision :
        typed_fx_statement_expected_raw_append_decision
            command_identity aggregate_identity payload_hash position history)
    : i64 * i64 * i64 * i64 * i64 * i64 * i64 * i64
    =
    ?= decision ?|
    | TypedFxStatementExpectedRawAppendApplied payload =>
        := \? after_position after_history. append, cells, _ = payload
        := applied, _, _, _, events, statements, debit, credit, mismatch =
            typed_fx_hashed_statement_event_store_decision_runtime append
        applied, 0i64, events, statements, debit, credit, mismatch, cells
    | TypedFxStatementExpectedRawAppendRejected (cells, _) =>
        0i64, 1i64, 0i64, 0i64, 0i64, 0i64, 0i64, cells

:= assert_typed_fx_statement_expected_raw_append_runtime
    (applied : i64) (rejected : i64) (events : i64)
    (statements : i64) (debit : i64) (credit : i64)
    (mismatch : i64) (accepted_cells : i64) (rejected_cells : i64)
    : ()
    =
    := ok_0 = !!!!EQ(applied, 1i64)
    := ok_1 = !!!!EQ(rejected, 1i64)
    := ok_2 = !!!!EQ(events, 1i64)
    := ok_3 = !!!!EQ(statements, 3i64)
    := ok_4 = !!!!EQ(debit, 10i64)
    := ok_5 = !!!!EQ(credit, 10i64)
    := ok_6 = !!!!EQ(mismatch, 0i64)
    := ok_7 = !!!!EQ(accepted_cells, 1i64)
    := ok_8 = !!!!EQ(rejected_cells, 2i64)
    ? ok_0 && ok_1 && ok_2 && ok_3 && ok_4 && ok_5 && ok_6 && ok_7 && ok_8
    ?> ()
    |: mega_runtime_fail "typed-FX-statement-expected-raw-append-runtime-mismatch"

:= typed_fx_statement_expected_raw_append_terminal () : string =
    := journals =
        post_typed_fx_determined_journal_program_as_signed_scaled
            (post_typed_fx_determined_rounding_receipt_program
                (typed_fx_determined_rounding_receipt_program_value ()))
    := ledgers =
        index_typed_fx_signed_scaled_journal_program_by_entity_currency journals
    := statements =
        consume_typed_fx_signed_scaled_ledger_program_with_matching_keys ledgers
    := command
        : typed_fx_hashed_statement_command typed_fx_statement_command_identity_primary
            typed_fx_statement_aggregate_identity_primary typed_fx_statement_payload_hash_primary
            typed_fx_statement_command_fresh
        =
        typed_fx_hashed_statement_command (
            typed_fx_statement_command_identity_primary "raw-authorized-primary-command",
            typed_fx_statement_aggregate_identity_primary "raw-authorized-primary-aggregate",
            typed_fx_statement_payload_hash_primary "raw-authorized-primary-payload",
            typed_fx_statement_command (
                statements,
                "the-fresh-command-carries-the-indexed-balanced-statement-program"),
            "the-command-is-not-applied-until-hostile-bytes-recover-the-exact-position-witness")
    := expected
        : typed_fx_statement_expected_stream_position typed_fx_statement_stream_position_zero
            typed_fx_statement_stream_position_zero
        =
        TypedFxStatementExpectedStreamPosition (
            TypedFxStatementStreamPositionZeroValue,
            "the-first-writer-expects-position-zero")
    := empty
        : typed_fx_hashed_statement_event_log typed_fx_statement_stream_position_zero
            typed_fx_hashed_statement_history_empty
        =
        TypedFxHashedStatementEventLogEmpty
    := accepted =
        apply_typed_fx_hashed_statement_command_from_expected_raw_bytes
            expected
            (TypedFxStatementStreamPositionRawBytesMore (
                TypedFxStatementStreamPositionRawZero,
                TypedFxStatementStreamPositionRawBytesDone,
                "the-canonical-zero-byte-authorizes-the-first-append"))
            command empty
    := stale =
        apply_typed_fx_hashed_statement_command_from_expected_raw_bytes
            expected
            (TypedFxStatementStreamPositionRawBytesMore (
                TypedFxStatementStreamPositionRawNext,
                TypedFxStatementStreamPositionRawBytesMore (
                    TypedFxStatementStreamPositionRawZero,
                    TypedFxStatementStreamPositionRawBytesDone,
                    "the-stale-writer-supplied-position-one"),
                "position-one-cannot-authorize-an-append-at-zero"))
            command empty
    := aa, ar, ae, ast, adb, acr, am, acells =
        typed_fx_statement_expected_raw_append_decision_runtime accepted
    := sa, sr, se, sst, sdb, scr, sm, scells =
        typed_fx_statement_expected_raw_append_decision_runtime stale
    := _ = sa
    := _ = se
    := _ = sst
    := _ = sdb
    := _ = scr
    := _ = sm
    := _ = ar
    := _ =
        assert_typed_fx_statement_expected_raw_append_runtime
            aa sr ae ast adb acr am acells scells
    "hostile-position-bytes-now-sit-directly-in-front-of-the-event-store-append-so-only-the-canonical-byte-stream-r"
    ^^ "ecovers-the-exact-indexed-witness-and-produces-one-balanced-event-while-the-stale-stream-returns-before-any-mu"
    ^^ "tation-though-durable-fsync-and-atomic-multiwriter-CAS-remain-open-sealed"

:| typed_fx_statement_two_writer_raw_cas_race =
    | TypedFxStatementTwoWriterRawCasAppliedConflict ::
        typed_fx_statement_expected_raw_append_decision
            typed_fx_statement_command_identity_primary
            typed_fx_statement_aggregate_identity_primary
            typed_fx_statement_payload_hash_primary
            typed_fx_statement_stream_position_zero
            typed_fx_hashed_statement_history_empty *
        typed_fx_hashed_statement_command
            typed_fx_statement_command_identity_secondary
            typed_fx_statement_aggregate_identity_primary
            typed_fx_statement_payload_hash_primary
            typed_fx_statement_command_fresh *
        typed_fx_hashed_statement_event_store_decision
            typed_fx_statement_command_identity_secondary
            typed_fx_statement_aggregate_identity_primary
            typed_fx_statement_payload_hash_primary
            typed_fx_statement_stream_position_zero
            typed_fx_hashed_primary_position
            typed_fx_hashed_primary_history
            typed_fx_hashed_primary_position
            typed_fx_hashed_primary_history * i64 * string ->
        typed_fx_statement_two_writer_raw_cas_race
    | TypedFxStatementTwoWriterRawCasRejected ::
        i64 * string -> typed_fx_statement_two_writer_raw_cas_race

:= arbitrate_typed_fx_statement_two_writer_raw_cas
    (winner :
        typed_fx_hashed_statement_command
            typed_fx_statement_command_identity_primary typed_fx_statement_aggregate_identity_primary
            typed_fx_statement_payload_hash_primary typed_fx_statement_command_fresh)
    (loser :
        typed_fx_hashed_statement_command
            typed_fx_statement_command_identity_secondary typed_fx_statement_aggregate_identity_primary
            typed_fx_statement_payload_hash_primary typed_fx_statement_command_fresh)
    (bytes : typed_fx_statement_stream_position_raw_bytes)
    : typed_fx_statement_two_writer_raw_cas_race
    =
    := expected
        : typed_fx_statement_expected_stream_position typed_fx_statement_stream_position_zero
            typed_fx_statement_stream_position_zero
        =
        TypedFxStatementExpectedStreamPosition (
            TypedFxStatementStreamPositionZeroValue,
            "both-writers-read-the-same-zero-position-before-arbitration")
    := empty
        : typed_fx_hashed_statement_event_log typed_fx_statement_stream_position_zero
            typed_fx_hashed_statement_history_empty
        =
        TypedFxHashedStatementEventLogEmpty
    := first =
        apply_typed_fx_hashed_statement_command_from_expected_raw_bytes
            expected bytes winner empty
    ?= first ?|
    | TypedFxStatementExpectedRawAppendApplied payload =>
        := \? after_position after_history. append, cells, _ = payload
        ?= append ?|
        | TypedFxHashedStatementEventStoreApplied (_, _, _, recorded, _) =>
            := second
                : typed_fx_hashed_statement_event_store_decision typed_fx_statement_command_identity_secondary
                    typed_fx_statement_aggregate_identity_primary typed_fx_statement_payload_hash_primary
                    typed_fx_statement_stream_position_zero typed_fx_hashed_primary_position
                    typed_fx_hashed_primary_history typed_fx_hashed_primary_position typed_fx_hashed_primary_history
                =
                TypedFxHashedStatementEventStoreVersionConflict (
                    TypedFxStatementStreamPositionZeroNext
                        "the-losing-writer-still-expects-zero-after-the-winning-append-advanced-the-stream",
                    recorded,
                    "one-winner-and-one-version-conflict-model-the-CAS-arbitration-boundary")
            := _ = loser
            TypedFxStatementTwoWriterRawCasAppliedConflict (
                first,
                loser,
                second,
                cells,
                "the-first-exact-byte-authorized-writer-applies-and-the-second-same-version-writer-conflicts-withou"
                ^^ "t-a-second-event"
            )
    | TypedFxStatementExpectedRawAppendRejected (cells, note) =>
        TypedFxStatementTwoWriterRawCasRejected (cells, note)

:= typed_fx_statement_two_writer_raw_cas_runtime
    (race : typed_fx_statement_two_writer_raw_cas_race)
    : i64 * i64 * i64 * i64 * i64 * i64 =
    ?= race ?|
    | TypedFxStatementTwoWriterRawCasAppliedConflict (first, _, second, cells, _) =>
        := applied, _, first_events, _, _, _, first_mismatch, _ =
            typed_fx_statement_expected_raw_append_decision_runtime first
        := _, _, _, conflict, second_events, _, _, _, second_mismatch =
            typed_fx_hashed_statement_event_store_decision_runtime second
        applied,
        conflict,
        first_events,
        second_events,
        runtime_add_i64 first_mismatch second_mismatch,
        cells
    | TypedFxStatementTwoWriterRawCasRejected (cells, _) =>
        0i64, 0i64, 0i64, 0i64, 0i64, cells

:= assert_typed_fx_statement_two_writer_raw_cas_runtime
    (applied : i64) (conflict : i64)
    (winner_events : i64) (loser_events : i64)
    (mismatch : i64) (cells : i64)
    : ()
    =
    := ok_0 = !!!!EQ(applied, 1i64)
    := ok_1 = !!!!EQ(conflict, 1i64)
    := ok_2 = !!!!EQ(winner_events, 1i64)
    := ok_3 = !!!!EQ(loser_events, 1i64)
    := ok_4 = !!!!EQ(mismatch, 0i64)
    := ok_5 = !!!!EQ(cells, 1i64)
    ? ok_0 && ok_1 && ok_2 && ok_3 && ok_4 && ok_5
    ?> ()
    |: mega_runtime_fail "typed-FX-statement-two-writer-raw-CAS-runtime-mismatch"

:= typed_fx_statement_two_writer_raw_cas_terminal () : string =
    := journals =
        post_typed_fx_determined_journal_program_as_signed_scaled
            (post_typed_fx_determined_rounding_receipt_program
                (typed_fx_determined_rounding_receipt_program_value ()))
    := ledgers =
        index_typed_fx_signed_scaled_journal_program_by_entity_currency journals
    := statements =
        consume_typed_fx_signed_scaled_ledger_program_with_matching_keys ledgers
    := winner
        : typed_fx_hashed_statement_command typed_fx_statement_command_identity_primary
            typed_fx_statement_aggregate_identity_primary typed_fx_statement_payload_hash_primary
            typed_fx_statement_command_fresh
        =
        typed_fx_hashed_statement_command (
            typed_fx_statement_command_identity_primary "CAS-winner-command",
            typed_fx_statement_aggregate_identity_primary "CAS-primary-aggregate",
            typed_fx_statement_payload_hash_primary "CAS-primary-payload",
            typed_fx_statement_command (
                statements,
                "the-winning-command-carries-the-balanced-statement-program"),
            "the-winning-writer-presents-the-canonical-zero-position-bytes")
    := loser
        : typed_fx_hashed_statement_command typed_fx_statement_command_identity_secondary
            typed_fx_statement_aggregate_identity_primary typed_fx_statement_payload_hash_primary
            typed_fx_statement_command_fresh
        =
        typed_fx_hashed_statement_command (
            typed_fx_statement_command_identity_secondary "CAS-loser-command",
            typed_fx_statement_aggregate_identity_primary "CAS-primary-aggregate",
            typed_fx_statement_payload_hash_primary "CAS-primary-payload",
            typed_fx_statement_command (
                statements,
                "the-losing-command-is-also-fresh-but-read-the-same-old-version"),
            "freshness-does-not-override-the-advanced-stream-position")
    := race =
        arbitrate_typed_fx_statement_two_writer_raw_cas
            winner
            loser
            (TypedFxStatementStreamPositionRawBytesMore (
                TypedFxStatementStreamPositionRawZero,
                TypedFxStatementStreamPositionRawBytesDone,
                "the-shared-zero-position-byte-is-validated-once-before-the-winning-append"))
    := applied, conflict, winner_events, loser_events, mismatch, cells =
        typed_fx_statement_two_writer_raw_cas_runtime race
    := _ =
        assert_typed_fx_statement_two_writer_raw_cas_runtime
            applied conflict winner_events loser_events mismatch cells
    "two-fresh-writers-that-read-the-same-canonical-zero-position-now-enter-one-indexed-arbitration-relation-where-"
    ^^ "exact-bytes-authorize-only-the-first-append-and-the-second-writer-receives-a-version-conflict-over-the-one-eve"
    ^^ "nt-history-so-the-type-level-model-has-exactly-one-winner-although-physical-atomic-CAS-fsync-and-crash-durabil"
    ^^ "ity-remain-open-sealed"

:! typed_fx_statement_command_identity_tertiary = string

:| typed_fx_statement_three_writer_raw_cas_schedule =
    | TypedFxStatementThreeWriterRawCasAppliedConflictConflict ::
        typed_fx_statement_two_writer_raw_cas_race *
        typed_fx_hashed_statement_command
            typed_fx_statement_command_identity_tertiary
            typed_fx_statement_aggregate_identity_primary
            typed_fx_statement_payload_hash_primary
            typed_fx_statement_command_fresh *
        typed_fx_hashed_statement_event_store_decision
            typed_fx_statement_command_identity_tertiary
            typed_fx_statement_aggregate_identity_primary
            typed_fx_statement_payload_hash_primary
            typed_fx_statement_stream_position_zero
            typed_fx_hashed_primary_position
            typed_fx_hashed_primary_history
            typed_fx_hashed_primary_position
            typed_fx_hashed_primary_history * i64 * string ->
        typed_fx_statement_three_writer_raw_cas_schedule
    | TypedFxStatementThreeWriterRawCasRejected ::
        i64 * string -> typed_fx_statement_three_writer_raw_cas_schedule

:= arbitrate_typed_fx_statement_three_writer_raw_cas
    (winner :
        typed_fx_hashed_statement_command
            typed_fx_statement_command_identity_primary typed_fx_statement_aggregate_identity_primary
            typed_fx_statement_payload_hash_primary typed_fx_statement_command_fresh)
    (loser :
        typed_fx_hashed_statement_command
            typed_fx_statement_command_identity_secondary typed_fx_statement_aggregate_identity_primary
            typed_fx_statement_payload_hash_primary typed_fx_statement_command_fresh)
    (third :
