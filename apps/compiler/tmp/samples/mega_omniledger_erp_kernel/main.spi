inl erp_runtime_join_stage_sequence (left : string) (right : string) : string =
    $"!left + \"|\" + !right"

inl rec erp_p2p_event_store_stage_sequence forall version from to.
    (store : erp_p2p_event_store version from to) : string =
    match store with
    | ErpP2PEventStoreOne event =>
        terminal (erp_p2p_unit_event_plan event)
    | ErpP2PEventStoreThen payload =>
        inl exists left_version right_version middle. left, right, _ = payload
        erp_runtime_join_stage_sequence
            (erp_p2p_event_store_stage_sequence left)
            (erp_p2p_event_store_stage_sequence right)

inl rec erp_p2p_event_outbox_stage_sequence forall version from to.
    (outbox : erp_p2p_event_outbox version from to) : string =
    match outbox with
    | ErpP2PEventOutboxOne event =>
        terminal (erp_p2p_unit_event_plan event)
    | ErpP2PEventOutboxThen payload =>
        inl exists left_version right_version middle. left, right, _ = payload
        erp_runtime_join_stage_sequence
            (erp_p2p_event_outbox_stage_sequence left)
            (erp_p2p_event_outbox_stage_sequence right)

inl erp_p2p_event_store_physical_roundtrip_runtime
    (store_sequence : string) (outbox_sequence : string) :
    i64 * i64 * i64 * i64 * i64 * i64 =
    $"(let directory = System.IO.Path.Combine(System.IO.Path.GetTempPath(), \"spiral-erp-p2p-sequence-\" + System.Guid.NewGuid().ToString(\"N\")) in System.IO.Directory.CreateDirectory(directory) |> ignore; let storePath = System.IO.Path.Combine(directory, \"events.bin\") in let outboxPath = System.IO.Path.Combine(directory, \"outbox.bin\") in let storeBytes = System.Text.Encoding.UTF8.GetBytes(!store_sequence) in let outboxBytes = System.Text.Encoding.UTF8.GetBytes(!outbox_sequence) in let storeDigest = System.Security.Cryptography.SHA256.HashData(storeBytes) in let outboxDigest = System.Security.Cryptography.SHA256.HashData(outboxBytes) in (use stream = new System.IO.FileStream(storePath,System.IO.FileMode.CreateNew,System.IO.FileAccess.Write,System.IO.FileShare.None,4096,System.IO.FileOptions.WriteThrough) in stream.Write(storeBytes,0,storeBytes.Length); stream.Flush(true)); (use stream = new System.IO.FileStream(outboxPath,System.IO.FileMode.CreateNew,System.IO.FileAccess.Write,System.IO.FileShare.None,4096,System.IO.FileOptions.WriteThrough) in stream.Write(outboxBytes,0,outboxBytes.Length); stream.Flush(true)); let recoveredStore = System.IO.File.ReadAllBytes(storePath) in let recoveredOutbox = System.IO.File.ReadAllBytes(outboxPath) in let storeEqual = if System.Linq.Enumerable.SequenceEqual(storeBytes,recoveredStore) then 1L else 0L in let outboxEqual = if System.Linq.Enumerable.SequenceEqual(outboxBytes,recoveredOutbox) then 1L else 0L in let digestEqual = if System.Linq.Enumerable.SequenceEqual(storeDigest,outboxDigest) then 1L else 0L in let tampered = Array.copy recoveredStore in let _ = if tampered.Length > 0 then tampered.[tampered.Length-1] <- tampered.[tampered.Length-1] ^^^ 1uy else () in let tamperRejected = if System.Linq.Enumerable.SequenceEqual(System.Security.Cryptography.SHA256.HashData(tampered),storeDigest) then 0L else 1L in System.IO.Directory.Delete(directory,true); int64 storeBytes.Length, int64 outboxBytes.Length, storeEqual, outboxEqual, digestEqual, tamperRejected)"

inl assert_erp_p2p_event_store_physical_roundtrip_runtime
    (store_bytes : i64) (outbox_bytes : i64)
    (store_equal : i64) (outbox_equal : i64)
    (digest_equal : i64) (tamper_rejected : i64) : () =
    inl ok_0 = !!!!GT(store_bytes, 0i64)
    inl ok_1 = !!!!EQ(outbox_bytes, store_bytes)
    inl ok_2 = !!!!EQ(store_equal, 1i64)
    inl ok_3 = !!!!EQ(outbox_equal, 1i64)
    inl ok_4 = !!!!EQ(digest_equal, 1i64)
    inl ok_5 = !!!!EQ(tamper_rejected, 1i64)
    if ok_0 && ok_1 && ok_2 && ok_3 && ok_4 && ok_5 then () else mega_runtime_fail "erp-p2p-event-store-physical-roundtrip-runtime-mismatch"

inl erp_p2p_three_event_physical_roundtrip_terminal () : string =
    inl reserve_event =
        erp_p2p_unit_event_from_op (erp_p2p_reserve_budget_op ())
    inl approvals_event =
        erp_p2p_unit_event_from_op (erp_p2p_collect_approvals_op ())
    inl purchase_order_event =
        erp_p2p_unit_event_from_op (erp_p2p_issue_purchase_order_op ())
    inl first_store, first_outbox =
        erp_p2p_event_commit_then reserve_event approvals_event
    inl final_store, final_outbox =
        erp_p2p_event_commit_one purchase_order_event
    inl store = erp_p2p_event_store_then first_store final_store (v65_add_two_one_three ())
    inl outbox = erp_p2p_event_outbox_then first_outbox final_outbox (v65_add_two_one_three ())
    inl store_sequence = erp_p2p_event_store_stage_sequence store
    inl outbox_sequence = erp_p2p_event_outbox_stage_sequence outbox
    inl store_bytes, outbox_bytes, store_equal, outbox_equal, digest_equal, tamper_rejected =
        erp_p2p_event_store_physical_roundtrip_runtime
            store_sequence outbox_sequence
    inl _ =
        assert_erp_p2p_event_store_physical_roundtrip_runtime
            store_bytes outbox_bytes store_equal outbox_equal digest_equal tamper_rejected
    "the-three-endpoint-linked-P2P-events-now-derive-one-ordered-stage-sequence-from-the-type-level-store-and-the-same-sequence-from-the-outbox-before-WriteThrough-Flush-true-SHA256-byte-roundtrip-and-tamper-rejection"

inl erp_p2p_four_event_physical_roundtrip_terminal () : string =
    inl store, outbox = erp_p2p_four_event_commit ()
    inl store_sequence = erp_p2p_event_store_stage_sequence store
    inl outbox_sequence = erp_p2p_event_outbox_stage_sequence outbox
    inl store_bytes, outbox_bytes, store_equal, outbox_equal, digest_equal, tamper_rejected =
        erp_p2p_event_store_physical_roundtrip_runtime
            store_sequence outbox_sequence
    inl _ =
        assert_erp_p2p_event_store_physical_roundtrip_runtime
            store_bytes outbox_bytes store_equal outbox_equal digest_equal tamper_rejected
    "the-four-version-indexed-P2P-events-now-drive-the-physical-store-and-outbox-roundtrip-through-goods-partially-received-with-byte-tampering-rejected"

inl erp_reserve_budget_operation_payload_frame forall result.
    (operation : erp_op requisition_drafted budget_reserved result) : string =
    match operation with
    | ReserveBudget (requisition_value, budget_value) =>
        match requisition_value with
        | requisition (requisition_entity, requisition_currency, requisition_item, requisition_identity) =>
            match budget_value with
            | budget_token (budget_entity, budget_currency, budget_amount, budget_identity) =>
                $"(let fields = [| !requisition_entity; !requisition_currency; !requisition_item; !requisition_identity; !budget_entity; !budget_currency; string !budget_amount; !budget_identity |] in let bytes = fields |> Array.collect (fun value -> let payload = System.Text.Encoding.UTF8.GetBytes(value) in let length = System.BitConverter.GetBytes(System.Net.IPAddress.HostToNetworkOrder(payload.Length)) in Array.append length payload) in System.Convert.ToBase64String(bytes))"

inl erp_reserve_budget_payload_frame
    (plan : erp_plan requisition_drafted budget_reserved) : string =
    match plan with
    | ErpStep payload =>
        inl exists result. operation = payload
        erp_reserve_budget_operation_payload_frame operation

inl erp_reserve_budget_payload_codec_runtime (encoded : string) :
    i64 * i64 * i64 * i64 * i64 * i64 * i64 * i64 * i64 =
    $"(let tryDecode (text : string) = try let bytes = System.Convert.FromBase64String(text) in let mutable offset = 0 in let fields = System.Collections.Generic.List<string>() in let mutable valid = true in while valid && offset < bytes.Length do if offset + 4 > bytes.Length then valid <- false else let raw = System.BitConverter.ToInt32(bytes, offset) |> System.Net.IPAddress.NetworkToHostOrder in offset <- offset + 4; if raw < 0 || offset + raw > bytes.Length then valid <- false else fields.Add(System.Text.Encoding.UTF8.GetString(bytes, offset, raw)); offset <- offset + raw done; if valid && offset = bytes.Length then Some(fields.ToArray()) else None with _ -> None in let decoded = tryDecode !encoded in let fieldCount = match decoded with Some fields -> int64 fields.Length | None -> 0L in let indexBound = match decoded with Some fields when fields.Length = 8 -> 1L | _ -> 0L in let sharedEntity = match decoded with Some fields when fields.Length = 8 && fields.[0] = fields.[4] -> 1L | _ -> 0L in let sharedCurrency = match decoded with Some fields when fields.Length = 8 && fields.[1] = fields.[5] -> 1L | _ -> 0L in let amountBound = match decoded with Some fields when fields.Length = 8 -> (match System.Int64.TryParse(fields.[6]) with true,value when value > 0L -> 1L | _ -> 0L) | _ -> 0L in let identityBound = match decoded with Some fields when fields.Length = 8 && fields.[3].Length > 0 && fields.[7].Length > 0 && fields.[3] <> fields.[7] -> 1L | _ -> 0L in let reencode (fields : string array) = fields |> Array.collect (fun value -> let payload = System.Text.Encoding.UTF8.GetBytes(value) in let length = System.BitConverter.GetBytes(System.Net.IPAddress.HostToNetworkOrder(payload.Length)) in Array.append length payload) |> System.Convert.ToBase64String in let roundtrip = match decoded with Some fields when reencode fields = !encoded -> 1L | _ -> 0L in let digestBytes = System.Security.Cryptography.SHA256.HashData(System.Text.Encoding.UTF8.GetBytes(!encoded)).Length |> int64 in let truncated = if !encoded.Length > 4 then !encoded.Substring(0, !encoded.Length - 4) else \"\" in let tamperRejected = match tryDecode truncated with None -> 1L | Some _ -> 0L in fieldCount,indexBound,sharedEntity,sharedCurrency,amountBound,identityBound,roundtrip,digestBytes,tamperRejected)"

inl assert_erp_reserve_budget_payload_codec_runtime
    (field_count : i64) (index_bound : i64) (shared_entity : i64)
    (shared_currency : i64) (amount_bound : i64) (identity_bound : i64) (roundtrip : i64)
    (digest_bytes : i64) (tamper_rejected : i64) : () =
    inl ok_0 = !!!!EQ(field_count, 8i64)
    inl ok_1 = !!!!EQ(index_bound, 1i64)
    inl ok_2 = !!!!EQ(shared_entity, 1i64)
    inl ok_3 = !!!!EQ(shared_currency, 1i64)
    inl ok_4 = !!!!EQ(amount_bound, 1i64)
    inl ok_5 = !!!!EQ(identity_bound, 1i64)
    inl ok_6 = !!!!EQ(roundtrip, 1i64)
    inl ok_7 = !!!!EQ(digest_bytes, 32i64)
    inl ok_8 = !!!!EQ(tamper_rejected, 1i64)
