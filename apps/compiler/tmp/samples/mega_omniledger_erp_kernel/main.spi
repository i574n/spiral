        = System.Text.Encoding.UTF8.GetBytes(\"history=version2|command=second|debit=37|credit=37\") in let \
        writePrepared path bytes = (use stream = new System.IO.FileStream(path, System.IO.FileMode.CreateNew, \
        System.IO.FileAccess.Write, System.IO.FileShare.None, 4096, System.IO.FileOptions.WriteThrough) in \
        stream.Write(bytes, 0, bytes.Length); stream.Flush(true)) in writePrepared firstPrepared firstBytes; \
        writePrepared secondPrepared secondBytes; let startContender () = let info = new \
