inl erp_match_invoice_payload_codec_terminal () : string =
    inl encoded = erp_match_invoice_payload_frame (erp_p2p_match_invoice_plan ())
    inl decoded = erp_match_invoice_payload_decode encoded
    inl truncated : string =
        $"if !encoded.Length > 4 then !encoded.Substring(0, !encoded.Length - 4) else \"\""
    inl rejected = erp_match_invoice_payload_decode truncated
    inl accepted_tag = erp_match_invoice_payload_decode_tag decoded
    inl rejected_tag = erp_match_invoice_payload_decode_tag rejected
