        typed_usd_eur_fractional_positive_safe_ceiling_decision ()))

inl typed_fx_determined_rounding_step_runtime
    forall source target input numerator denominator quotient remainder product scaled output.
    (step : typed_fx_determined_rounding_step source target input numerator denominator quotient remainder product scaled output)
    : i64 * i64 * i64 * i64 * i64 =
    match step with
    | TypedFxDeterminedFloorStep (equation, output_value) =>
        inl _, _, _, quotient_runtime, remainder_runtime, _ =
            typed_fx_fractional_floor_step_runtime equation
        0i64,
        quotient_runtime,
        remainder_runtime,
        runtime_money_nat_to_i64 output_value,
        0i64
    | TypedFxDeterminedCeilingStep payload =>
        inl exists adjustment. decision = payload
        inl positive, rounded, adjustment_runtime, quotient_runtime, remainder_runtime =
            typed_fx_fractional_safe_ceiling_runtime decision
        1i64,
        quotient_runtime,
        remainder_runtime,
        rounded,
        adjustment_runtime

inl typed_fx_determined_rounding_step_output
    forall source target input numerator denominator quotient remainder product scaled output.
    (step : typed_fx_determined_rounding_step source target input numerator denominator quotient remainder product scaled output)
    : runtime_money_nat output =
    match step with
    | TypedFxDeterminedFloorStep (_, output_value) =>
        output_value
    | TypedFxDeterminedCeilingStep payload =>
        inl exists adjustment. decision = payload
        match decision with
        | TypedFxFractionalSafeCeilingExact (_, rounded_value) =>
            rounded_value
        | TypedFxFractionalSafeCeilingPositive (_, _, _, rounded_value, _) =>
            rounded_value

nominal typed_fx_determined_rounding_receipt
    entity source target input numerator denominator quotient remainder product scaled output =
    entity *
    typed_fx_determined_rounding_step
        source target input numerator denominator quotient remainder product scaled output *
    runtime_money_nat output * string

inl consume_typed_fx_determined_rounding_step
    forall entity source target input numerator denominator quotient remainder product scaled output.
    (entity_value : entity)
    (step : typed_fx_determined_rounding_step source target input numerator denominator quotient remainder product scaled output)
    : typed_fx_determined_rounding_receipt entity source target input numerator denominator quotient remainder product scaled output =
    typed_fx_determined_rounding_receipt (
        entity_value,
        step,
        typed_fx_determined_rounding_step_output step,
        "the-consumer-receipt-derives-its-output-witness-from-the-policy-indexed-step")

union existential_typed_fx_determined_rounding_receipt =
    | ExistentialTypedFxDeterminedRoundingReceipt ::
        (exists entity source target input numerator denominator quotient remainder product scaled output.
            typed_fx_determined_rounding_receipt
                entity source target input numerator denominator quotient remainder product scaled output * string) ->
        existential_typed_fx_determined_rounding_receipt

union rec typed_fx_determined_rounding_receipt_program =
    | TypedFxDeterminedRoundingReceiptProgramDone
    | TypedFxDeterminedRoundingReceiptProgramMore ::
        existential_typed_fx_determined_rounding_receipt *
        typed_fx_determined_rounding_receipt_program * string ->
        typed_fx_determined_rounding_receipt_program

inl typed_fx_determined_rounding_receipt_program_value () :
    typed_fx_determined_rounding_receipt_program =
    TypedFxDeterminedRoundingReceiptProgramMore (
        ExistentialTypedFxDeterminedRoundingReceipt (exists (
            consume_typed_fx_determined_rounding_step
                (company_a "company-a")
                (typed_usd_eur_fractional_determined_floor_step ()),
            "company-a-consumes-the-determined-floor-step")),
        TypedFxDeterminedRoundingReceiptProgramMore (
            ExistentialTypedFxDeterminedRoundingReceipt (exists (
                consume_typed_fx_determined_rounding_step
                    (company_b "company-b")
                    (typed_usd_eur_fractional_determined_exact_ceiling_step ()),
                "company-b-consumes-the-determined-exact-ceiling-step")),
            TypedFxDeterminedRoundingReceiptProgramMore (
                ExistentialTypedFxDeterminedRoundingReceipt (exists (
                    consume_typed_fx_determined_rounding_step
                        (company_c "company-c")
                        (typed_usd_eur_fractional_determined_positive_ceiling_step ()),
                    "company-c-consumes-the-determined-positive-ceiling-step")),
                TypedFxDeterminedRoundingReceiptProgramDone,
                "company-c-closes-the-receipt-program"),
            "company-b-preserves-exact-ceiling-output"),
        "company-a-opens-the-receipt-program")

inl typed_fx_determined_rounding_receipt_runtime
    forall entity source target input numerator denominator quotient remainder product scaled output.
    (receipt : typed_fx_determined_rounding_receipt entity source target input numerator denominator quotient remainder product scaled output)
    : i64 * i64 * i64 * i64 =
    match receipt with
    | typed_fx_determined_rounding_receipt (_, step, output_value, _) =>
        inl mode, _, _, step_output, _ =
            typed_fx_determined_rounding_step_runtime step
        inl receipt_output = runtime_money_nat_to_i64 output_value
        1i64,
        mode,
        receipt_output,
        (if !!!!EQ(step_output, receipt_output) then 0i64 else 1i64)

inl rec typed_fx_determined_rounding_receipt_program_runtime
    (program : typed_fx_determined_rounding_receipt_program)
    : i64 * i64 * i64 * i64 * i64 =
    match program with
    | TypedFxDeterminedRoundingReceiptProgramDone =>
        0i64, 0i64, 0i64, 0i64, 0i64
    | TypedFxDeterminedRoundingReceiptProgramMore (head, tail, _) =>
        inl cells, floor, output, mismatch =
            match head with
            | ExistentialTypedFxDeterminedRoundingReceipt payload =>
                inl exists entity source target input numerator denominator quotient remainder product scaled output.
                    receipt, _ = payload
                inl cell, mode, output_runtime, mismatch_runtime =
                    typed_fx_determined_rounding_receipt_runtime receipt
                cell,
                $"if !mode = 0L then 1L else 0L",
                output_runtime,
                mismatch_runtime
        inl tail_cells, tail_floor, tail_ceiling,
            tail_outputs, tail_mismatches =
            typed_fx_determined_rounding_receipt_program_runtime tail
        runtime_add_i64 cells tail_cells,
        runtime_add_i64 floor tail_floor,
        runtime_add_i64 ($"if !floor = 0L then 1L else 0L") tail_ceiling,
        runtime_add_i64 output tail_outputs,
        runtime_add_i64 mismatch tail_mismatches

inl assert_typed_fx_determined_rounding_receipt_program_runtime
    (cells : i64) (floors : i64) (ceilings : i64)
    (outputs : i64) (mismatches : i64) : () =
    inl ok_0 = !!!!EQ(cells, 3i64)
    inl ok_1 = !!!!EQ(floors, 1i64)
    inl ok_2 = !!!!EQ(ceilings, 2i64)
    inl ok_3 = !!!!EQ(outputs, 10i64)
    inl ok_4 = !!!!EQ(mismatches, 0i64)
    if ok_0 && ok_1 && ok_2 && ok_3 && ok_4 then () else mega_runtime_fail "typed-FX-determined-rounding-receipt-program-runtime-mismatch"

inl typed_fx_determined_rounding_receipt_program_terminal () : string =
    inl cells, floors, ceilings, outputs, mismatches =
        typed_fx_determined_rounding_receipt_program_runtime
            (typed_fx_determined_rounding_receipt_program_value ())
    inl _ =
        assert_typed_fx_determined_rounding_receipt_program_runtime
            cells floors ceilings outputs mismatches
    "one-active-ERP-consumer-now-accepts-only-policy-indexed-determined-rounding-steps-and-derives-the-output-witness-inside-the-receipt-so-three-entity-receipts-preserve-floor-exact-ceiling-and-positive-ceiling-outputs-with-zero-consumer-step-mismatches-sealed"

