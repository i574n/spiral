inl typed_fx_hashed_statement_checksummed_frame_audit_runtime
    forall command_identity aggregate_identity payload_hash.
    (frame : typed_fx_hashed_statement_checksummed_frame command_identity aggregate_identity payload_hash)
    : i64 * i64 =
    match frame with
    | typed_fx_hashed_statement_checksummed_frame (command, stored_checksum, _) =>
        stored_checksum,
        typed_fx_hashed_statement_command_checksum command

union typed_fx_hashed_statement_checksum_validation =
    | TypedFxHashedStatementChecksumValidationAccepted ::
        i64 * i64 * i64 * i64 * i64 * string ->
        typed_fx_hashed_statement_checksum_validation
    | TypedFxHashedStatementChecksumValidationRejected ::
        i64 * i64 * string ->
        typed_fx_hashed_statement_checksum_validation

inl rec validate_typed_fx_hashed_statement_checksummed_persisted_log
    forall position history.
    (persisted : typed_fx_hashed_statement_checksummed_persisted_log position history)
    : typed_fx_hashed_statement_checksum_validation =
    match persisted with
    | TypedFxHashedStatementChecksummedPersistedLogEmpty =>
        TypedFxHashedStatementChecksumValidationAccepted (
            0i64, 0i64, 0i64, 0i64, 0i64,
            "the-empty-checksummed-log-validates-to-empty-restart-metrics")
    | TypedFxHashedStatementChecksummedPersistedLogMore (frame, tail, _) =>
        match validate_typed_fx_hashed_statement_checksummed_persisted_log tail with
        | TypedFxHashedStatementChecksumValidationRejected (
            stored_checksum, actual_checksum, reason) =>
            TypedFxHashedStatementChecksumValidationRejected (
                stored_checksum,
                actual_checksum,
                reason)
        | TypedFxHashedStatementChecksumValidationAccepted (
            tail_events, tail_statements, tail_debit,
            tail_credit, tail_mismatch, _) =>
            match frame with
            | typed_fx_hashed_statement_checksummed_frame (
                command, stored_checksum, _) =>
                inl actual_checksum =
                    typed_fx_hashed_statement_command_checksum command
                inl checksum_matches : bool =
                    !!!!EQ(stored_checksum, actual_checksum)
                if checksum_matches then
                    match command with
                    | typed_fx_hashed_statement_command (_, _, _, applied, _) =>
                        inl statements, _, _, debit, credit, mismatch =
                            match applied with
                            | typed_fx_statement_command (program, _) =>
                                typed_fx_signed_scaled_entity_currency_statement_program_runtime program
                        TypedFxHashedStatementChecksumValidationAccepted (
                            runtime_add_i64 1i64 tail_events,
                            runtime_add_i64 statements tail_statements,
                            runtime_add_i64 debit tail_debit,
                            runtime_add_i64 credit tail_credit,
                            runtime_add_i64 mismatch tail_mismatch,
                            "validated-restart-metrics-are-derived-only-after-the-current-frame-and-the-entire-tail-pass-checksum-validation")
                else
                    TypedFxHashedStatementChecksumValidationRejected (
                        stored_checksum,
                        actual_checksum,
                        "checksum-mismatch-blocks-the-frame-before-it-contributes-any-restart-metric")

inl typed_fx_hashed_statement_checksum_validation_runtime
    (decision : typed_fx_hashed_statement_checksum_validation)
    : i64 * i64 =
    match decision with
    | TypedFxHashedStatementChecksumValidationAccepted _ => 1i64, 0i64
    | TypedFxHashedStatementChecksumValidationRejected _ => 0i64, 1i64

inl assert_typed_fx_hashed_statement_checksum_validation_runtime
    (accepted : i64) (rejected : i64) : () =
    inl ok_0 = !!!!EQ(accepted, 1i64)
    inl ok_1 = !!!!EQ(rejected, 1i64)
    if ok_0 && ok_1 then () else mega_runtime_fail "typed-FX-hashed-statement-checksum-validation-runtime-mismatch"

inl restart_typed_fx_hashed_statement_event_log_validated_runtime
    forall position history.
    (persisted : typed_fx_hashed_statement_checksummed_persisted_log position history)
    : i64 * i64 * i64 * i64 * i64 * i64 * i64 * i64 * i64 =
    match validate_typed_fx_hashed_statement_checksummed_persisted_log persisted with
    | TypedFxHashedStatementChecksumValidationRejected (
        stored_checksum, actual_checksum, _) =>
        0i64, 1i64, stored_checksum, actual_checksum,
        0i64, 0i64, 0i64, 0i64, 0i64
    | TypedFxHashedStatementChecksumValidationAccepted (
        events, statements, debit, credit, mismatch, _) =>
        1i64, 0i64, 0i64, 0i64,
        events, statements, debit, credit, mismatch

inl assert_restart_typed_fx_hashed_statement_event_log_validated_runtime
    (valid_accepted : i64) (corrupt_rejected : i64)
    (corrupt_stored : i64) (corrupt_actual : i64)
    (events : i64) (statements : i64)
    (debit : i64) (credit : i64) (mismatch : i64) : () =
    inl ok_0 = !!!!EQ(valid_accepted, 1i64)
    inl ok_1 = !!!!EQ(corrupt_rejected, 1i64)
    inl ok_2 = !!!!EQ(corrupt_stored, 999i64)
    inl ok_3 = !!!!EQ(corrupt_actual, 23i64)
    inl ok_4 = !!!!EQ(events, 1i64)
    inl ok_5 = !!!!EQ(statements, 3i64)
    inl ok_6 = !!!!EQ(debit, 10i64)
    inl ok_7 = !!!!EQ(credit, 10i64)
    inl ok_8 = !!!!EQ(mismatch, 0i64)
    if ok_0 && ok_1 && ok_2 && ok_3 && ok_4 && ok_5 && ok_6 && ok_7 && ok_8 then () else mega_runtime_fail "typed-FX-hashed-statement-validated-restart-runtime-mismatch"

inl assert_typed_fx_hashed_statement_checksummed_restart_runtime
    (frames : i64) (checksum_sum : i64)
    (stored_checksum : i64) (actual_checksum : i64)
    (corrupted_stored_checksum : i64) (corrupted_actual_checksum : i64)
    (events_before : i64) (events_after : i64)
    (statements_before : i64) (statements_after : i64)
    (debit_before : i64) (debit_after : i64)
    (credit_before : i64) (credit_after : i64)
    (mismatch_before : i64) (mismatch_after : i64) : () =
    inl ok_0 = !!!!EQ(frames, 1i64)
    inl ok_1 = !!!!EQ(checksum_sum, 23i64)
    inl ok_2 = !!!!EQ(stored_checksum, 23i64)
    inl ok_3 = !!!!EQ(actual_checksum, 23i64)
    inl ok_4 = !!!!EQ(corrupted_stored_checksum, 999i64)
    inl ok_5 = !!!!EQ(corrupted_actual_checksum, 23i64)
    inl ok_6 = !!!!EQ(events_before, 1i64)
    inl ok_7 = !!!!EQ(events_after, 1i64)
    inl ok_8 = !!!!EQ(statements_before, 3i64)
    inl ok_9 = !!!!EQ(statements_after, 3i64)
    inl ok_10 = !!!!EQ(debit_before, 10i64)
    inl ok_11 = !!!!EQ(debit_after, 10i64)
    inl ok_12 = !!!!EQ(credit_before, 10i64)
    inl ok_13 = !!!!EQ(credit_after, 10i64)
    inl ok_14 = !!!!EQ(mismatch_before, 0i64)
    inl ok_15 = !!!!EQ(mismatch_after, 0i64)
    if ok_0 && ok_1 && ok_2 && ok_3 && ok_4 && ok_5 && ok_6 && ok_7 && ok_8 && ok_9 && ok_10 && ok_11 && ok_12 && ok_13 && ok_14 && ok_15 then () else mega_runtime_fail "typed-FX-hashed-statement-checksummed-restart-runtime-mismatch"

inl typed_fx_hashed_statement_checksummed_restart_terminal () : string =
    inl journals =
        post_typed_fx_determined_journal_program_as_signed_scaled
            (post_typed_fx_determined_rounding_receipt_program
                (typed_fx_determined_rounding_receipt_program_value ()))
    inl ledgers =
        index_typed_fx_signed_scaled_journal_program_by_entity_currency journals
    inl statements =
        consume_typed_fx_signed_scaled_ledger_program_with_matching_keys ledgers
    inl primary : typed_fx_hashed_statement_command typed_fx_statement_command_identity_primary typed_fx_statement_aggregate_identity_primary typed_fx_statement_payload_hash_primary typed_fx_statement_command_fresh =
        typed_fx_hashed_statement_command (
            typed_fx_statement_command_identity_primary "primary-statement-command",
            typed_fx_statement_aggregate_identity_primary "primary-ledger-aggregate",
            typed_fx_statement_payload_hash_primary "payload-hash-primary",
            typed_fx_statement_command (
                statements,
                "the-primary-command-is-materialized-before-checksummed-persistence"),
            "identity-aggregate-and-payload-hash-remain-indexed-across-checksummed-persistence")
    inl expected_zero : typed_fx_statement_expected_stream_position typed_fx_statement_stream_position_zero typed_fx_statement_stream_position_zero =
        TypedFxStatementExpectedStreamPosition (
            TypedFxStatementStreamPositionZeroValue,
            "the-checksummed-writer-expects-position-zero")
    inl empty : typed_fx_hashed_statement_event_log typed_fx_statement_stream_position_zero typed_fx_hashed_statement_history_empty =
        TypedFxHashedStatementEventLogEmpty
    inl applied =
        apply_typed_fx_hashed_statement_command_to_event_log
            expected_zero primary empty
    match applied with
    | TypedFxHashedStatementEventStoreApplied (_, _, _, recorded, _) =>
        inl persisted =
            persist_typed_fx_hashed_statement_event_log_with_checksums recorded
        inl validated =
            validate_typed_fx_hashed_statement_checksummed_persisted_log persisted
        inl frames, checksum_sum =
            typed_fx_hashed_statement_checksummed_persisted_log_runtime persisted
        inl stored_checksum, actual_checksum,
            corrupted_stored_checksum, corrupted_actual_checksum =
            match persisted with
            | TypedFxHashedStatementChecksummedPersistedLogMore (frame, _, _) =>
                inl stored_checksum, actual_checksum =
                    typed_fx_hashed_statement_checksummed_frame_audit_runtime frame
                match frame with
                | typed_fx_hashed_statement_checksummed_frame (command, _, note) =>
                    inl corrupted =
                        typed_fx_hashed_statement_checksummed_frame (
                            command,
                            999i64,
                            note)
                    inl corrupted_stored_checksum, corrupted_actual_checksum =
                        typed_fx_hashed_statement_checksummed_frame_audit_runtime corrupted
                    stored_checksum, actual_checksum,
                    corrupted_stored_checksum, corrupted_actual_checksum
        inl corrupted_persisted =
            match persisted with
            | TypedFxHashedStatementChecksummedPersistedLogMore (frame, tail, note) =>
                match frame with
                | typed_fx_hashed_statement_checksummed_frame (command, _, frame_note) =>
                    TypedFxHashedStatementChecksummedPersistedLogMore (
                        typed_fx_hashed_statement_checksummed_frame (
                            command,
                            999i64,
                            frame_note),
                        tail,
                        note)
        inl corrupted_validation =
            validate_typed_fx_hashed_statement_checksummed_persisted_log
                corrupted_persisted
        inl valid_accepted, valid_rejected =
            typed_fx_hashed_statement_checksum_validation_runtime validated
        inl corrupt_accepted, corrupt_rejected =
            typed_fx_hashed_statement_checksum_validation_runtime corrupted_validation
        inl _ =
            assert_typed_fx_hashed_statement_checksum_validation_runtime
                valid_accepted corrupt_rejected
        inl _ = valid_rejected
        inl _ = corrupt_accepted
        inl valid_restart_accepted, valid_restart_rejected,
            _, _, valid_restart_events, valid_restart_statements,
            valid_restart_debit, valid_restart_credit,
            valid_restart_mismatch =
            restart_typed_fx_hashed_statement_event_log_validated_runtime persisted
        inl corrupt_restart_accepted, corrupt_restart_rejected,
            corrupt_restart_stored, corrupt_restart_actual,
            _, _, _, _, _ =
            restart_typed_fx_hashed_statement_event_log_validated_runtime
                corrupted_persisted
        inl _ =
            assert_restart_typed_fx_hashed_statement_event_log_validated_runtime
                valid_restart_accepted corrupt_restart_rejected
                corrupt_restart_stored corrupt_restart_actual
                valid_restart_events valid_restart_statements
                valid_restart_debit valid_restart_credit
                valid_restart_mismatch
        inl _ = valid_restart_rejected
        inl _ = corrupt_restart_accepted
        inl events_before, statements_before, debit_before,
            credit_before, mismatch_before =
            typed_fx_hashed_statement_event_log_runtime recorded
        inl events_after = valid_restart_events
        inl statements_after = valid_restart_statements
        inl debit_after = valid_restart_debit
        inl credit_after = valid_restart_credit
        inl mismatch_after = valid_restart_mismatch
        inl _ =
            assert_typed_fx_hashed_statement_checksummed_restart_runtime
                frames checksum_sum stored_checksum actual_checksum
                corrupted_stored_checksum corrupted_actual_checksum
                events_before events_after statements_before statements_after
                debit_before debit_after credit_before credit_after
                mismatch_before mismatch_after
        "persisted-frames-now-carry-a-deterministic-checksum-derived-from-the-indexed-applied-statement-program-and-the-only-restart-runtime-recomputes-the-entire-chain-before-returning-derived-metrics-while-a-forged-nine-hundred-ninety-nine-frame-is-rejected-and-the-unchecked-unseal-and-restart-helpers-have-been-physically-retired-with-byte-encoding-fsync-and-atomic-CAS-still-open-sealed"

union typed_usd_eur_determined_tie_rounding output =
    | TypedUsdEurDeterminedHalfUpTie :: forall output.
        typed_fx_fractional_half_up_rounding_decision
            usd eur erp_rate_three erp_rate_three erp_rate_two
            erp_rate_four erp_rate_one erp_rate_nine erp_rate_eight
            output erp_rate_one ->
        typed_usd_eur_determined_tie_rounding output
    | TypedUsdEurDeterminedHalfEvenTie :: forall output.
        typed_fx_fractional_half_even_rounding_decision
            usd eur erp_rate_three erp_rate_three erp_rate_two
            erp_rate_four erp_rate_one erp_rate_nine erp_rate_eight
            output ->
        typed_usd_eur_determined_tie_rounding output

inl typed_usd_eur_determined_tie_rounding_runtime forall output.
    (decision : typed_usd_eur_determined_tie_rounding output)
    : i64 * i64 * i64 * i64 =
    match decision with
    | TypedUsdEurDeterminedHalfUpTie half_up =>
        inl denominator, quotient, remainder, rounded, adjustment, doubled =
            typed_fx_fractional_half_up_rounding_runtime half_up
        0i64, rounded, adjustment,
        erp_runtime_add_i64 denominator doubled
    | TypedUsdEurDeterminedHalfEvenTie half_even =>
        inl denominator, quotient, remainder, rounded, doubled =
            typed_fx_fractional_half_even_rounding_runtime half_even
        1i64, rounded, 0i64,
        erp_runtime_add_i64 denominator doubled

inl assert_typed_usd_eur_determined_tie_rounding_runtime
    (modes : i64) (rounded : i64) (adjustments : i64) (tie_checks : i64) : () =
    inl ok_0 = !!!!EQ(modes, 1i64)
    inl ok_1 = !!!!EQ(rounded, 9i64)
    inl ok_2 = !!!!EQ(adjustments, 1i64)
    inl ok_3 = !!!!EQ(tie_checks, 8i64)
    if ok_0 && ok_1 && ok_2 && ok_3 then () else mega_runtime_fail "typed-usd-eur-determined-tie-rounding-runtime-mismatch"

inl typed_usd_eur_determined_tie_rounding_terminal () : string =
    inl half_up : typed_usd_eur_determined_tie_rounding erp_rate_five =
        TypedUsdEurDeterminedHalfUpTie
            (typed_usd_eur_fractional_half_up_rounding_decision ())
    inl half_even : typed_usd_eur_determined_tie_rounding erp_rate_four =
        TypedUsdEurDeterminedHalfEvenTie
            (typed_usd_eur_fractional_half_even_rounding_decision ())
    inl hum, hur, hua, hut =
        typed_usd_eur_determined_tie_rounding_runtime half_up
    inl hem, her, hea, het =
        typed_usd_eur_determined_tie_rounding_runtime half_even
    inl _ =
        assert_typed_usd_eur_determined_tie_rounding_runtime
            (erp_runtime_add_i64 hum hem)
            (erp_runtime_add_i64 hur her)
            (erp_runtime_add_i64 hua hea)
            (erp_runtime_add_i64 hut het)
    "half-up-and-half-even-now-share-one-output-indexed-tie-rounding-family-so-the-policy-constructor-determines-five-or-four-from-the-same-nine-over-two-equation-and-an-arbitrary-i64-result-cannot-enter-the-active-tie-surface-sealed"

union typed_fx_statement_stream_position_raw_byte =
    | TypedFxStatementStreamPositionRawZero
    | TypedFxStatementStreamPositionRawNext
    | TypedFxStatementStreamPositionRawCorrupt

union rec typed_fx_statement_stream_position_raw_bytes =
    | TypedFxStatementStreamPositionRawBytesDone
    | TypedFxStatementStreamPositionRawBytesMore ::
        typed_fx_statement_stream_position_raw_byte *
        typed_fx_statement_stream_position_raw_bytes * string ->
        typed_fx_statement_stream_position_raw_bytes

union typed_fx_statement_stream_position_raw_decode_decision =
    | TypedFxStatementStreamPositionRawDecoded ::
        (exists position.
            typed_fx_statement_stream_position_value position * i64 * string) ->
        typed_fx_statement_stream_position_raw_decode_decision
    | TypedFxStatementStreamPositionRawRejected ::
        i64 * string ->
        typed_fx_statement_stream_position_raw_decode_decision

inl rec encode_typed_fx_statement_stream_position_raw_bytes forall position.
    (position : typed_fx_statement_stream_position_value position)
    : typed_fx_statement_stream_position_raw_bytes =
    match position with
    | TypedFxStatementStreamPositionZeroValue =>
        TypedFxStatementStreamPositionRawBytesMore (
            TypedFxStatementStreamPositionRawZero,
            TypedFxStatementStreamPositionRawBytesDone,
            "zero-is-the-terminal-position-byte")
    | TypedFxStatementStreamPositionNextValue (prior, _) =>
        TypedFxStatementStreamPositionRawBytesMore (
            TypedFxStatementStreamPositionRawNext,
            encode_typed_fx_statement_stream_position_raw_bytes prior,
            "next-prefixes-the-canonical-byte-encoding-of-its-predecessor")

inl rec typed_fx_statement_stream_position_raw_bytes_count
    (bytes : typed_fx_statement_stream_position_raw_bytes) : i64 =
    match bytes with
    | TypedFxStatementStreamPositionRawBytesDone => 0i64
    | TypedFxStatementStreamPositionRawBytesMore (_, tail, _) =>
        runtime_add_i64 1i64
            (typed_fx_statement_stream_position_raw_bytes_count tail)

inl typed_fx_statement_expected_position_from_decoded forall position.
    (position_value : typed_fx_statement_stream_position_value position)
    : typed_fx_statement_expected_stream_position position position =
    TypedFxStatementExpectedStreamPosition (
        position_value,
        "a-successful-hostile-byte-decode-can-immediately-reify-the-exact-same-position-index-as-an-append-expectation")

inl rec decode_typed_fx_statement_stream_position_raw_bytes
    (bytes : typed_fx_statement_stream_position_raw_bytes)
    : typed_fx_statement_stream_position_raw_decode_decision =
    match bytes with
    | TypedFxStatementStreamPositionRawBytesDone =>
        TypedFxStatementStreamPositionRawRejected (
            0i64,
            "an-empty-byte-stream-is-a-truncated-position")
    | TypedFxStatementStreamPositionRawBytesMore (
        TypedFxStatementStreamPositionRawZero, tail, _) =>
        match tail with
        | TypedFxStatementStreamPositionRawBytesDone =>
            inl position_value = TypedFxStatementStreamPositionZeroValue
            inl _ = typed_fx_statement_expected_position_from_decoded position_value
            TypedFxStatementStreamPositionRawDecoded (exists (
                position_value,
                1i64,
                "one-zero-byte-decodes-to-the-indexed-zero-position-and-reifies-the-exact-append-expectation-before-packing"))
        | TypedFxStatementStreamPositionRawBytesMore _ =>
            TypedFxStatementStreamPositionRawRejected (
                typed_fx_statement_stream_position_raw_bytes_count bytes,
                "bytes-after-zero-are-rejected-as-trailing-position-data")
    | TypedFxStatementStreamPositionRawBytesMore (
        TypedFxStatementStreamPositionRawNext, tail, _) =>
        match decode_typed_fx_statement_stream_position_raw_bytes tail with
        | TypedFxStatementStreamPositionRawDecoded payload =>
            inl exists prior. prior_value, cells, _ = payload
            inl position_value =
                TypedFxStatementStreamPositionNextValue (
                    prior_value,
                    "the-decoder-reconstructs-one-indexed-successor")
            inl _ = typed_fx_statement_expected_position_from_decoded position_value
            TypedFxStatementStreamPositionRawDecoded (exists (
                position_value,
                runtime_add_i64 1i64 cells,
                "a-next-byte-is-accepted-only-when-its-tail-decodes-completely-and-the-reconstructed-successor-reifies-its-exact-append-expectation"))
        | TypedFxStatementStreamPositionRawRejected (cells, note) =>
            TypedFxStatementStreamPositionRawRejected (
                runtime_add_i64 1i64 cells,
                note)
    | TypedFxStatementStreamPositionRawBytesMore (
        TypedFxStatementStreamPositionRawCorrupt, _, _) =>
        TypedFxStatementStreamPositionRawRejected (
            typed_fx_statement_stream_position_raw_bytes_count bytes,
            "an-unknown-position-byte-is-rejected-before-restart")

inl typed_fx_statement_stream_position_raw_decode_runtime
    (decision : typed_fx_statement_stream_position_raw_decode_decision)
    : i64 * i64 * i64 * i64 =
    match decision with
    | TypedFxStatementStreamPositionRawDecoded payload =>
        inl exists position. value, cells, _ = payload
        1i64, 0i64,
        typed_fx_statement_stream_position_value_runtime value,
        cells
    | TypedFxStatementStreamPositionRawRejected (cells, _) =>
        0i64, 1i64, 0i64, cells

inl assert_typed_fx_statement_stream_position_raw_decode_runtime
    (accepted : i64) (rejected : i64)
    (position : i64) (accepted_cells : i64)
    (rejected_cells : i64) : () =
    inl ok_0 = !!!!EQ(accepted, 1i64)
    inl ok_1 = !!!!EQ(rejected, 3i64)
    inl ok_2 = !!!!EQ(position, 1i64)
    inl ok_3 = !!!!EQ(accepted_cells, 2i64)
    inl ok_4 = !!!!EQ(rejected_cells, 4i64)
    if ok_0 && ok_1 && ok_2 && ok_3 && ok_4 then () else mega_runtime_fail "typed-FX-statement-stream-position-raw-decode-runtime-mismatch"

inl typed_fx_statement_stream_position_raw_decode_terminal () : string =
    inl position : typed_fx_statement_stream_position_value (typed_fx_statement_stream_position_next typed_fx_statement_stream_position_zero) =
        TypedFxStatementStreamPositionNextValue (
            TypedFxStatementStreamPositionZeroValue,
            "position-one-is-the-canonical-hostile-byte-roundtrip-fixture")
    inl valid =
        decode_typed_fx_statement_stream_position_raw_bytes
            (encode_typed_fx_statement_stream_position_raw_bytes position)
    inl truncated =
        decode_typed_fx_statement_stream_position_raw_bytes
            (TypedFxStatementStreamPositionRawBytesMore (
                TypedFxStatementStreamPositionRawNext,
                TypedFxStatementStreamPositionRawBytesDone,
                "a-next-byte-without-a-terminal-zero-is-truncated"))
    inl corrupt =
        decode_typed_fx_statement_stream_position_raw_bytes
            (TypedFxStatementStreamPositionRawBytesMore (
                TypedFxStatementStreamPositionRawCorrupt,
                TypedFxStatementStreamPositionRawBytesDone,
                "an-unknown-byte-is-corrupt"))
    inl trailing =
        decode_typed_fx_statement_stream_position_raw_bytes
            (TypedFxStatementStreamPositionRawBytesMore (
                TypedFxStatementStreamPositionRawZero,
                TypedFxStatementStreamPositionRawBytesMore (
                    TypedFxStatementStreamPositionRawZero,
                    TypedFxStatementStreamPositionRawBytesDone,
                    "the-second-zero-is-trailing-data"),
                "the-first-zero-must-end-the-stream"))
    inl va, vr, vp, vc =
        typed_fx_statement_stream_position_raw_decode_runtime valid
    inl ta, tr, tp, tc =
        typed_fx_statement_stream_position_raw_decode_runtime truncated
    inl ca, cr, cp, cc =
        typed_fx_statement_stream_position_raw_decode_runtime corrupt
    inl xa, xr, xp, xc =
        typed_fx_statement_stream_position_raw_decode_runtime trailing
    inl _ = ta
    inl _ = tp
    inl _ = ca
    inl _ = cp
    inl _ = xa
    inl _ = xp
    inl _ = vr
    inl _ =
        assert_typed_fx_statement_stream_position_raw_decode_runtime
            va
