inl rec append_typed_fx_hashed_statement_membership_lookup_program forall history.
    (left : typed_fx_hashed_statement_membership_lookup_program history)
    (right : typed_fx_hashed_statement_membership_lookup_program history)
    : typed_fx_hashed_statement_membership_lookup_program history =
    match left with
    | TypedFxHashedStatementMembershipLookupProgramOne payload =>
        inl exists command_identity aggregate_identity payload_hash. proof, note = payload
        TypedFxHashedStatementMembershipLookupProgramMore (exists (
            proof,
            right,
            note))
    | TypedFxHashedStatementMembershipLookupProgramMore payload =>
        inl exists command_identity aggregate_identity payload_hash. proof, tail, note = payload
        TypedFxHashedStatementMembershipLookupProgramMore (exists (
            proof,
            append_typed_fx_hashed_statement_membership_lookup_program tail right,
            note))

