:= typed_fx_statement_length_prefixed_hash_chain_outbox_runtime () :
    i64 * i64 * i64 * i64 * i64 * i64 * i64 * i64 =
    $"(let directory = System.IO.Path.Combine(System.IO.Path.GetTempPath(), \"spiral-erp-chain-\" + \
        System.Guid.NewGuid().ToString(\"N\")) in System.IO.Directory.CreateDirectory(directory) |> ignore; let store \
        = System.IO.Path.Combine(directory, \"events.bin\") in let outbox = System.IO.Path.Combine(directory, \
        \"outbox.bin\") in let payloads = [|\"identity=primary|aggregate=ledger|position=1|debit=10|credit=10\"; \
        \"identity=secondary|aggregate=ledger|position=2|debit=7|credit=7\"; \
        \"identity=tertiary|aggregate=ledger|position=3|debit=3|credit=3\"|] in let mutable previous = \
        Array.zeroCreate<byte> 32 in (use stream = new System.IO.FileStream(store, System.IO.FileMode.CreateNew, \
        System.IO.FileAccess.Write, System.IO.FileShare.None, 4096, System.IO.FileOptions.WriteThrough) in use out = \
        new System.IO.FileStream(outbox, System.IO.FileMode.CreateNew, System.IO.FileAccess.Write, \
        System.IO.FileShare.None, 4096, System.IO.FileOptions.WriteThrough) in for payload in payloads do let bytes = \
        System.Text.Encoding.UTF8.GetBytes(payload) in let digestInput = Array.append previous bytes in let digest = \
        System.Security.Cryptography.SHA256.HashData(digestInput) in let length = \
        System.BitConverter.GetBytes(bytes.Length) in stream.Write(length,0,length.Length); \
        stream.Write(previous,0,previous.Length); stream.Write(bytes,0,bytes.Length); \
        stream.Write(digest,0,digest.Length); let outLength = System.BitConverter.GetBytes(digest.Length + \
        bytes.Length) in out.Write(outLength,0,outLength.Length); out.Write(digest,0,digest.Length); \
        out.Write(bytes,0,bytes.Length); previous <- digest; stream.Flush(true); out.Flush(true)); let replay (path : \
        string) = let data = System.IO.File.ReadAllBytes(path) in let rec loop (offset : int) (expected : byte array) \
        (frames : int64) (payloadBytes : int64) = if offset = data.Length then 1L, frames, payloadBytes, int64 \
        expected.Length elif offset + 4 > data.Length then 0L, frames, payloadBytes, int64 expected.Length else let \
        length = System.BitConverter.ToInt32(data,offset) in let payloadOffset = offset + 4 + 32 in let digestOffset \
        = payloadOffset + length in let nextOffset = digestOffset + 32 in if length < 0 || nextOffset > data.Length \
        then 0L, frames, payloadBytes, int64 expected.Length else let prior = data.[offset+4..offset+35] in let \
        payload = data.[payloadOffset..digestOffset-1] in let digest = data.[digestOffset..nextOffset-1] in let \
        computed = System.Security.Cryptography.SHA256.HashData(Array.append prior payload) in if not \
        (System.Linq.Enumerable.SequenceEqual(prior,expected)) || not \
        (System.Linq.Enumerable.SequenceEqual(digest,computed)) then 0L, frames, payloadBytes, int64 expected.Length \
        else loop nextOffset digest (frames + 1L) (payloadBytes + int64 payload.Length) in loop 0 \
        (Array.zeroCreate<byte> 32) 0L 0L in let valid, frames, payloadBytes, digestBytes = replay store in let \
        outboxBytes = System.IO.File.ReadAllBytes(outbox).Length |> int64 in let tampered = \
        System.IO.File.ReadAllBytes(store) in let firstLength = System.BitConverter.ToInt32(tampered,0) in let \
        secondPayloadOffset = 4 + 32 + firstLength + 32 + 4 + 32 in tampered.[secondPayloadOffset] <- \
        tampered.[secondPayloadOffset] ^^^ 1uy; let corrupt = System.IO.Path.Combine(directory, \
        \"events.corrupt.bin\") in System.IO.File.WriteAllBytes(corrupt,tampered); let corruptValid, corruptFrames, \
        _, _ = replay corrupt in System.IO.File.Delete(store); System.IO.File.Delete(outbox); \
        System.IO.File.Delete(corrupt); System.IO.Directory.Delete(directory); (valid, frames, payloadBytes, \
        digestBytes, outboxBytes, (if corruptValid = 0L then 1L else 0L), corruptFrames, int64 payloads.Length))"

:= assert_typed_fx_statement_length_prefixed_hash_chain_outbox_runtime
    (valid : i64) (frames : i64) (payload_bytes : i64) (digest_bytes : i64)
    (outbox_bytes : i64) (tamper_rejected : i64) (corrupt_prefix_frames : i64)
    (expected_frames : i64)
    : ()
    =
    := ok_0 = !!!!EQ(valid, 1i64)
    := ok_1 = !!!!EQ(frames, 3i64)
    := ok_2 = !!!!GT(payload_bytes, 0i64)
    := ok_3 = !!!!EQ(digest_bytes, 32i64)
    := ok_4 = !!!!GT(outbox_bytes, payload_bytes)
    := ok_5 = !!!!EQ(tamper_rejected, 1i64)
    := ok_6 = !!!!EQ(corrupt_prefix_frames, 1i64)
    := ok_7 = !!!!EQ(expected_frames, 3i64)
    ? ok_0 && ok_1 && ok_2 && ok_3 && ok_4 && ok_5 && ok_6 && ok_7
    ?> ()
    |: mega_runtime_fail "typed-FX-statement-length-prefixed-hash-chain-outbox-runtime-mismatch"

:= typed_fx_statement_length_prefixed_hash_chain_outbox_terminal () : string =
    := valid, frames, payload_bytes, digest_bytes,
        outbox_bytes, tamper_rejected, corrupt_prefix_frames, expected_frames =
        typed_fx_statement_length_prefixed_hash_chain_outbox_runtime ()
    := _ =
        assert_typed_fx_statement_length_prefixed_hash_chain_outbox_runtime
            valid frames payload_bytes digest_bytes outbox_bytes
            tamper_rejected corrupt_prefix_frames expected_frames
    "a-three-frame-physical-event-store-now-uses-binary-length-prefixes-a-previous-digest-link-and-a-current-SHA256"
    ^^ "-per-frame-while-a-separate-flushed-outbox-records-the-same-digest-plus-payload-and-replay-rejects-a-bit-flip-"
    ^^ "in-the-second-frame-after-preserving-only-the-valid-prefix-so-delimiter-ambiguity-independent-frame-hashes-and"
    ^^ "-unverified-outbox-drift-are-closed-for-this-executable-corridor-while-typed-AST-serialization-and-arbitrary-m"
    ^^ "ultiprocess-writers-remain-open-sealed"

:= typed_fx_statement_binary_field_hash_chain_outbox_alignment_runtime
    (primary_statements : i64) (primary_debit : i64)
    (primary_credit : i64) (primary_mismatch : i64) :
    i64 * i64 * i64 * i64 * i64 * i64 * i64 * i64 * i64 * i64 * i64 =
    $"(let directory = System.IO.Path.Combine(System.IO.Path.GetTempPath(), \"spiral-erp-aligned-\" + \
        System.Guid.NewGuid().ToString(\"N\")) in System.IO.Directory.CreateDirectory(directory) |> ignore; let store \
        = System.IO.Path.Combine(directory, \"events.bin\") in let outbox = System.IO.Path.Combine(directory, \
        \"outbox.bin\") in let encodeFrame (position : int64) (identity : string) (aggregate : string) (payloadHash : \
        string) (payload : string) = let buffer = new System.IO.MemoryStream() in let writeString (value : string) = \
        let bytes = System.Text.Encoding.UTF8.GetBytes(value) in let length = \
        System.BitConverter.GetBytes(bytes.Length) in buffer.Write(length,0,length.Length); \
        buffer.Write(bytes,0,bytes.Length) in let positionBytes = System.BitConverter.GetBytes(position) in \
        buffer.Write(positionBytes,0,positionBytes.Length); writeString identity; writeString aggregate; writeString \
        payloadHash; writeString payload; buffer.ToArray() in let primaryPayload = \
        System.String.Format(\"statements={0};debit={1};credit={2};mismatch={3}\", !primary_statements, \
        !primary_debit, !primary_credit, !primary_mismatch) in let payloads = \
        [|(1L,\"command-primary\",\"ledger-main\",\"hash-primary\",primaryPayload); \
        (2L,\"command-secondary\",\"ledger-main\",\"hash-secondary\",\"debit=7;credit=7\"); \
        (3L,\"command-tertiary\",\"ledger-main\",\"hash-tertiary\",\"debit=3;credit=3\")|] in let mutable previous = \
        Array.zeroCreate<byte> 32 in (use eventStream = new System.IO.FileStream(store,System.IO.FileMode.CreateNew,Sy\
        stem.IO.FileAccess.Write,System.IO.FileShare.None,4096,System.IO.FileOptions.WriteThrough) in use \
        outboxStream = new System.IO.FileStream(outbox,System.IO.FileMode.CreateNew,System.IO.FileAccess.Write,System.\
        IO.FileShare.None,4096,System.IO.FileOptions.WriteThrough) in for \
        (position,identity,aggregate,payloadHash,payload) in payloads do let framePayload = encodeFrame position \
        identity aggregate payloadHash payload in let digest = System.Security.Cryptography.SHA256.HashData(Array.appe\
        nd previous framePayload) in let frameLength = System.BitConverter.GetBytes(framePayload.Length) in \
        eventStream.Write(frameLength,0,frameLength.Length); eventStream.Write(previous,0,previous.Length); \
        eventStream.Write(framePayload,0,framePayload.Length); eventStream.Write(digest,0,digest.Length); let \
        outboxPayload = Array.concat [|System.BitConverter.GetBytes(position); digest; framePayload|] in let \
        outboxLength = System.BitConverter.GetBytes(outboxPayload.Length) in \
        outboxStream.Write(outboxLength,0,outboxLength.Length); \
        outboxStream.Write(outboxPayload,0,outboxPayload.Length); previous <- digest; eventStream.Flush(true); \
        outboxStream.Flush(true)); let replayStore (data : byte array) = let rec loop offset expectedPosition \
        expectedPrevious acc = if offset = data.Length then 1L, List.rev acc |> List.toArray elif offset + 4 > \
        data.Length then 0L, List.rev acc |> List.toArray else let payloadLength = \
        System.BitConverter.ToInt32(data,offset) in let priorOffset = offset + 4 in let payloadOffset = priorOffset + \
        32 in let digestOffset = payloadOffset + payloadLength in let nextOffset = digestOffset + 32 in if \
        payloadLength < 8 || nextOffset > data.Length then 0L, List.rev acc |> List.toArray else let prior = \
        data.[priorOffset..payloadOffset-1] in let framePayload = data.[payloadOffset..digestOffset-1] in let digest \
        = data.[digestOffset..nextOffset-1] in let position = System.BitConverter.ToInt64(framePayload,0) in let \
        computed = System.Security.Cryptography.SHA256.HashData(Array.append prior framePayload) in if position <> \
        expectedPosition || not (System.Linq.Enumerable.SequenceEqual(prior,expectedPrevious)) || not \
        (System.Linq.Enumerable.SequenceEqual(digest,computed)) then 0L, List.rev acc |> List.toArray else loop \
        nextOffset (expectedPosition + 1L) digest ((position,digest,framePayload)::acc) in loop 0 1L \
        (Array.zeroCreate<byte> 32) [] in let replayOutbox (data : byte array) (expected : (int64 * byte array * byte \
        array) array) = let rec loop offset index = if offset = data.Length then (if index = expected.Length then 1L \
        else 0L), int64 index elif offset + 4 > data.Length || index >= expected.Length then 0L, int64 index else let \
        recordLength = System.BitConverter.ToInt32(data,offset) in let recordOffset = offset + 4 in let nextOffset = \
        recordOffset + recordLength in if recordLength < 40 || nextOffset > data.Length then 0L, int64 index else let \
        position = System.BitConverter.ToInt64(data,recordOffset) in let digest = \
        data.[recordOffset+8..recordOffset+39] in let framePayload = data.[recordOffset+40..nextOffset-1] in let \
        expectedPosition, expectedDigest, expectedPayload = expected.[index] in if position <> expectedPosition || \
        not (System.Linq.Enumerable.SequenceEqual(digest,expectedDigest)) || not \
        (System.Linq.Enumerable.SequenceEqual(framePayload,expectedPayload)) then 0L, int64 index else loop \
        nextOffset (index+1) in loop 0 0 in let storeBytes = System.IO.File.ReadAllBytes(store) in let storeValid, \
        frames = replayStore storeBytes in let outboxBytes = System.IO.File.ReadAllBytes(outbox) in let outboxValid, \
        outboxFrames = replayOutbox outboxBytes frames in let tamperedStore = Array.copy storeBytes in let \
        firstLength = System.BitConverter.ToInt32(tamperedStore,0) in let secondPayloadOffset = 4 + 32 + firstLength \
        + 32 + 4 + 32 in tamperedStore.[secondPayloadOffset+8] <- tamperedStore.[secondPayloadOffset+8] ^^^ 1uy; let \
        tamperedStoreValid, tamperedPrefix = replayStore tamperedStore in let tamperedOutbox = Array.copy outboxBytes \
        in let firstOutboxLength = System.BitConverter.ToInt32(tamperedOutbox,0) in let secondDigestOffset = 4 + \
        firstOutboxLength + 4 + 8 in tamperedOutbox.[secondDigestOffset] <- tamperedOutbox.[secondDigestOffset] ^^^ \
        1uy; let tamperedOutboxValid, tamperedOutboxPrefix = replayOutbox tamperedOutbox frames in let firstPosition \
        = if frames.Length = 0 then 0L else let position,_,_ = frames.[0] in position in let lastPosition = if \
        frames.Length = 0 then 0L else let position,_,_ = frames.[frames.Length-1] in position in let \
        totalPayloadBytes = frames |> Array.sumBy (fun (_,_,payload) -> int64 payload.Length) in let \
        primaryFrameAligned = if frames.Length = 0 then 0L else let _,_,firstPayload = frames.[0] in if \
        System.Linq.Enumerable.SequenceEqual(firstPayload, encodeFrame 1L \"command-primary\" \"ledger-main\" \
        \"hash-primary\" primaryPayload) then 1L else 0L in System.IO.Directory.Delete(directory,true); storeValid, \
        int64 frames.Length, outboxValid, outboxFrames, (if tamperedStoreValid = 0L then 1L else 0L), tamperedPrefix \
        |> Array.length |> int64, (if tamperedOutboxValid = 0L then 1L else 0L), tamperedOutboxPrefix, firstPosition, \
        lastPosition + totalPayloadBytes, primaryFrameAligned)"

:= assert_typed_fx_statement_binary_field_hash_chain_outbox_alignment_runtime
    (store_valid : i64) (store_frames : i64)
    (outbox_valid : i64) (outbox_frames : i64)
    (store_tamper_rejected : i64) (store_prefix_frames : i64)
    (outbox_tamper_rejected : i64) (outbox_prefix_frames : i64)
    (first_position : i64) (last_position_plus_payload_bytes : i64)
    (primary_frame_aligned : i64)
    : ()
    =
    := ok_0 = !!!!EQ(store_valid, 1i64)
    := ok_1 = !!!!EQ(store_frames, 3i64)
    := ok_2 = !!!!EQ(outbox_valid, 1i64)
    := ok_3 = !!!!EQ(outbox_frames, 3i64)
    := ok_4 = !!!!EQ(store_tamper_rejected, 1i64)
    := ok_5 = !!!!EQ(store_prefix_frames, 1i64)
    := ok_6 = !!!!EQ(outbox_tamper_rejected, 1i64)
    := ok_7 = !!!!EQ(outbox_prefix_frames, 1i64)
    := ok_8 = !!!!EQ(first_position, 1i64)
    := ok_9 = !!!!GT(last_position_plus_payload_bytes, 3i64)
    := ok_10 = !!!!EQ(primary_frame_aligned, 1i64)
    ? ok_0 && ok_1 && ok_2 && ok_3 && ok_4 && ok_5 && ok_6 && ok_7 && ok_8 && ok_9 && ok_10
    ?> ()
    |: mega_runtime_fail "typed-FX-statement-binary-field-hash-chain-outbox-alignment-runtime-mismatch"

:= typed_fx_statement_binary_field_hash_chain_outbox_alignment_terminal () : string =
    := journals =
        post_typed_fx_determined_journal_program_as_signed_scaled
            (post_typed_fx_determined_rounding_receipt_program
                (typed_fx_determined_rounding_receipt_program_value ()))
    := ledgers =
        index_typed_fx_signed_scaled_journal_program_by_entity_currency journals
    := statements =
        consume_typed_fx_signed_scaled_ledger_program_with_matching_keys ledgers
    := primary_statements, _, _, primary_debit, primary_credit, primary_mismatch =
        typed_fx_signed_scaled_entity_currency_statement_program_runtime statements
    := store_valid, store_frames, outbox_valid, outbox_frames,
        store_tamper_rejected, store_prefix_frames,
        outbox_tamper_rejected, outbox_prefix_frames,
        first_position, last_position_plus_payload_bytes,
        primary_frame_aligned =
        typed_fx_statement_binary_field_hash_chain_outbox_alignment_runtime
            primary_statements primary_debit primary_credit primary_mismatch
    := _ =
        assert_typed_fx_statement_binary_field_hash_chain_outbox_alignment_runtime
            store_valid store_frames outbox_valid outbox_frames
            store_tamper_rejected store_prefix_frames
            outbox_tamper_rejected outbox_prefix_frames
            first_position last_position_plus_payload_bytes primary_frame_aligned
    "the-primary-physical-ERP-frame-now-derives-statement-count-debit-credit-and-mismatch-from-the-same-indexed-sta"
    ^^ "tement-program-used-by-the-typed-command-before-those-values-enter-the-length-prefixed-hash-chained-store-and-"
    ^^ "aligned-outbox-and-replay-confirms-the-first-persisted-frame-is-byte-identical-to-that-derived-projection-whil"
    ^^ "e-identity-fields-full-AST-serialization-arbitrary-writer-count-and-recoverable-lock-ownership-remain-open-sea"
    ^^ "led"

:= erp_p2p_reserve_budget_op () :
    erp_op requisition_drafted budget_reserved
        (requisition company_a usd widget_a * budget_token company_a usd) =
    := requisition_value : requisition company_a usd widget_a =
        requisition (
            company_a "company-a",
            usd "USD",
            widget_a "widget-a",
            "requisition-1001")
    := budget_value : budget_token company_a usd =
        budget_token (
            company_a "company-a",
            usd "USD",
            1000i64,
            "budget-reservation-1001")
    ReserveBudget (requisition_value, budget_value)

:= erp_p2p_reserve_budget_plan () :
    erp_plan requisition_drafted budget_reserved =
    ErpStep (\? (erp_p2p_reserve_budget_op ()))

:| erp_p2p_unit_event from to =
    | ErpP2PUnitEvent :: \* from to.
        (\? result. erp_op from to result) -> erp_p2p_unit_event from to

:| erp_p2p_unit_store from to =
    | ErpP2PUnitStoreOne :: \* from to.
        erp_p2p_unit_event from to -> erp_p2p_unit_store from to

:| erp_p2p_unit_outbox from to =
    | ErpP2PUnitOutbox :: \* from to.
        erp_p2p_unit_event from to -> erp_p2p_unit_outbox from to

:= erp_p2p_unit_event_from_op \* from to result.
    (operation : erp_op from to result) : erp_p2p_unit_event from to =
    ErpP2PUnitEvent (\? operation)

:= erp_p2p_unit_store_append \* from to.
    (event : erp_p2p_unit_event from to) : erp_p2p_unit_store from to =
    ErpP2PUnitStoreOne event

:= erp_runtime_p2p_outbox_message (stage : string) : string =
    $"\"erp-p2p-\" + !stage + \"-outbox\""

:= erp_p2p_unit_outbox_project \* from to.
    (event : erp_p2p_unit_event from to) : erp_p2p_unit_outbox from to =
    ErpP2PUnitOutbox event

:= erp_p2p_unit_outbox_message \* from to.
    (outbox : erp_p2p_unit_outbox from to) : string =
    ?= outbox ?|
    | ErpP2PUnitOutbox event =>
        ?= event ?|
        | ErpP2PUnitEvent payload =>
            := \? result. operation = payload
            erp_runtime_p2p_outbox_message (terminal (ErpStep (\? operation)))

:= erp_p2p_unit_commit_project \* from to.
    (event : erp_p2p_unit_event from to) :
    erp_p2p_unit_store from to * erp_p2p_unit_outbox from to =
    erp_p2p_unit_store_append event, erp_p2p_unit_outbox_project event

:= erp_p2p_unit_store_replay \* from to.
    (store : erp_p2p_unit_store from to) : erp_plan from to =
    ?= store ?|
    | ErpP2PUnitStoreOne event =>
        ?= event ?|
        | ErpP2PUnitEvent payload =>
            := \? result. operation = payload
            ErpStep (\? operation)

:= erp_p2p_unit_outbox_replay \* from to.
    (outbox : erp_p2p_unit_outbox from to) : erp_plan from to =
    ?= outbox ?|
    | ErpP2PUnitOutbox event =>
        ?= event ?|
        | ErpP2PUnitEvent payload =>
            := \? result. operation = payload
            ErpStep (\? operation)

:= erp_p2p_unit_event_plan \* from to.
    (event : erp_p2p_unit_event from to) : erp_plan from to =
    ?= event ?|
    | ErpP2PUnitEvent payload =>
        := \? result. operation = payload
        ErpStep (\? operation)

:| ^ erp_p2p_event_store version from to =
    | ErpP2PEventStoreOne :: \* from to.
        erp_p2p_unit_event from to -> erp_p2p_event_store nat_one from to
    | ErpP2PEventStoreThen :: \* version from to.
        (\? left_version right_version middle.
            erp_p2p_event_store left_version from middle *
            erp_p2p_event_store right_version middle to *
            nat_add left_version right_version version) ->
        erp_p2p_event_store version from to

:| ^ erp_p2p_event_outbox version from to =
    | ErpP2PEventOutboxOne :: \* from to.
        erp_p2p_unit_event from to ->
        erp_p2p_event_outbox nat_one from to
    | ErpP2PEventOutboxThen :: \* version from to.
        (\? left_version right_version middle.
            erp_p2p_event_outbox left_version from middle *
            erp_p2p_event_outbox right_version middle to *
            nat_add left_version right_version version) ->
        erp_p2p_event_outbox version from to

:| ^ erp_p2p_event_commit_tree version from to =
    | ErpP2PEventCommitTreeOne :: \* from to.
        erp_p2p_unit_event from to ->
        erp_p2p_event_commit_tree nat_one from to
    | ErpP2PEventCommitTreeThen :: \* version from to.
        (\? left_version right_version middle.
            erp_p2p_event_commit_tree left_version from middle *
            erp_p2p_event_commit_tree right_version middle to *
            nat_add left_version right_version version) ->
        erp_p2p_event_commit_tree version from to

:= ^ erp_p2p_event_commit_tree_identity \* version from to.
    (commit : erp_p2p_event_commit_tree version from to) : string =
    ?= commit ?|
    | ErpP2PEventCommitTreeOne event =>
        erp_p2p_unit_outbox_message (erp_p2p_unit_outbox_project event)
    | ErpP2PEventCommitTreeThen payload =>
        := \? left_version right_version middle. left, right, _ = payload
        := left_identity = erp_p2p_event_commit_tree_identity left
        := right_identity = erp_p2p_event_commit_tree_identity right
        $"!left_identity + \">\" + !right_identity"

:! erp_p2p_event_commit_authority version from to =
    erp_p2p_event_commit_tree version from to

:= erp_p2p_event_commit_tree_authority \* version from to.
    (tree : erp_p2p_event_commit_tree version from to) :
    erp_p2p_event_commit_authority version from to =
    erp_p2p_event_commit_authority tree

:= erp_p2p_event_commit_authority_tree \* version from to.
    (authority : erp_p2p_event_commit_authority version from to) :
    erp_p2p_event_commit_tree version from to =
    ?= authority ?|
    | erp_p2p_event_commit_authority tree => tree

:= erp_p2p_event_commit_authority_runtime_identity \* version from to.
    (authority : erp_p2p_event_commit_authority version from to) : string =
    ?= authority ?|
    | erp_p2p_event_commit_authority tree =>
        := tree_identity = erp_p2p_event_commit_tree_identity tree
        $"!tree_identity + \"|aggregate=erp-p2p-aggregate:\" + !tree_identity + \"|command=erp-p2p-command:\" + \
            !tree_identity"

:= ^ erp_p2p_event_commit_tree_store \* version from to.
    (commit : erp_p2p_event_commit_tree version from to)
    : erp_p2p_event_store version from to =
    ?= commit ?|
    | ErpP2PEventCommitTreeOne event =>
        ErpP2PEventStoreOne event
    | ErpP2PEventCommitTreeThen payload =>
        := \? left_version right_version middle. left, right, sum = payload
        ErpP2PEventStoreThen (\? (
            erp_p2p_event_commit_tree_store left,
            erp_p2p_event_commit_tree_store right,
            sum))

:= ^ erp_p2p_event_commit_tree_outbox \* version from to.
    (commit : erp_p2p_event_commit_tree version from to)
    : erp_p2p_event_outbox version from to =
    ?= commit ?|
    | ErpP2PEventCommitTreeOne event =>
        ErpP2PEventOutboxOne event
    | ErpP2PEventCommitTreeThen payload =>
        := \? left_version right_version middle. left, right, sum = payload
        ErpP2PEventOutboxThen (\? (
            erp_p2p_event_commit_tree_outbox left,
            erp_p2p_event_commit_tree_outbox right,
            sum))

:= erp_p2p_event_commit_tree_project \* version from to.
    (commit : erp_p2p_event_commit_tree version from to) :
    erp_p2p_event_store version from to *
        erp_p2p_event_outbox version from to =
    erp_p2p_event_commit_tree_store commit,
    erp_p2p_event_commit_tree_outbox commit

:= erp_p2p_event_commit_one \* from to.
    (event : erp_p2p_unit_event from to) :
    erp_p2p_event_store nat_one from to * erp_p2p_event_outbox nat_one from to =
    erp_p2p_event_commit_tree_project (ErpP2PEventCommitTreeOne event)

:= erp_p2p_event_commit_then \* from middle to.
    (left : erp_p2p_unit_event from middle)
    (right : erp_p2p_unit_event middle to) :
    erp_p2p_event_store nat_two from to * erp_p2p_event_outbox nat_two from to =
    := left_commit = ErpP2PEventCommitTreeOne left
    := right_commit = ErpP2PEventCommitTreeOne right
    erp_p2p_event_commit_tree_project (
        ErpP2PEventCommitTreeThen (\? (
            left_commit,
            right_commit,
            v65_add_one_one_two ())))

:= ^ erp_p2p_event_store_version \* version from to.
    (store : erp_p2p_event_store version from to) : runtime_money_nat version =
    ?= store ?|
    | ErpP2PEventStoreOne _ => RuntimeMoneySucc RuntimeMoneyZero
    | ErpP2PEventStoreThen payload =>
        := \? left_version right_version middle. left, right, sum = payload
        runtime_money_nat_add
            sum
            (erp_p2p_event_store_version left)
            (erp_p2p_event_store_version right)

:= ^ erp_p2p_event_outbox_version \* version from to.
    (outbox : erp_p2p_event_outbox version from to) : runtime_money_nat version =
    ?= outbox ?|
    | ErpP2PEventOutboxOne _ => RuntimeMoneySucc RuntimeMoneyZero
    | ErpP2PEventOutboxThen payload =>
        := \? left_version right_version middle. left, right, sum = payload
        runtime_money_nat_add
            sum
            (erp_p2p_event_outbox_version left)
            (erp_p2p_event_outbox_version right)

:= ^ erp_p2p_event_store_replay \* version from to.
    (store : erp_p2p_event_store version from to) : erp_plan from to =
    ?= store ?|
    | ErpP2PEventStoreOne event =>
        erp_p2p_unit_event_plan event
    | ErpP2PEventStoreThen payload =>
        := \? left_version right_version middle. left, right, _ = payload
        ErpThen (\? (
            erp_p2p_event_store_replay left,
            erp_p2p_event_store_replay right))

:= ^ erp_p2p_event_outbox_replay \* version from to.
    (outbox : erp_p2p_event_outbox version from to) : erp_plan from to =
    ?= outbox ?|
    | ErpP2PEventOutboxOne event =>
        erp_p2p_unit_event_plan event
    | ErpP2PEventOutboxThen payload =>
        := \? left_version right_version middle. left, right, _ = payload
        ErpThen (\? (
            erp_p2p_event_outbox_replay left,
            erp_p2p_event_outbox_replay right))

:= erp_p2p_event_store_length \* version from to.
    (store : erp_p2p_event_store version from to) : i64 =
    runtime_money_nat_to_i64 (erp_p2p_event_store_version store)

:= erp_p2p_event_outbox_length \* version from to.
    (outbox : erp_p2p_event_outbox version from to) : i64 =
    runtime_money_nat_to_i64 (erp_p2p_event_outbox_version outbox)

:= erp_p2p_collect_approvals_op () :
    erp_op budget_reserved approvals_collected (approval_quorum po_1001) =
    CollectApprovals (approvals ())

:= erp_p2p_collect_approvals_plan () :
    erp_plan budget_reserved approvals_collected =
    ErpStep (\? (erp_p2p_collect_approvals_op ()))

:= assert_erp_p2p_two_event_store_runtime
    (store_length : i64) (outbox_length : i64)
    (store_stage : string) (outbox_stage : string) : () =
    $"if !store_length <> 2L || !outbox_length <> 2L || !store_stage <> \"approvals-collected\" || !outbox_stage <> \
        \"approvals-collected\" then failwith \"erp-p2p-two-event-store-runtime-mismatch\""

:= erp_p2p_two_event_store_terminal () : string =
    := reserve_event =
        erp_p2p_unit_event_from_op (erp_p2p_reserve_budget_op ())
    := approvals_event =
        erp_p2p_unit_event_from_op (erp_p2p_collect_approvals_op ())
    := store, outbox =
        erp_p2p_event_commit_then reserve_event approvals_event
    := store_plan = erp_p2p_event_store_replay store
    := outbox_plan = erp_p2p_event_outbox_replay outbox
    := store_length = erp_p2p_event_store_length store
    := outbox_length = erp_p2p_event_outbox_length outbox
    := store_stage = terminal store_plan
    := outbox_stage = terminal outbox_plan
    := _ =
        assert_erp_p2p_two_event_store_runtime
            store_length outbox_length store_stage outbox_stage
    "the-active-P2P-type-level-store-now-commits-two-endpoint-linked-events-ReserveBudget-then-CollectApprovals-and"
    ^^ "-replays-the-same-two-step-plan-from-both-store-and-outbox-without-a-one-event-capacity-limit"

:= erp_p2p_event_store_then \* left_version right_version version from middle to.
    (left : erp_p2p_event_store left_version from middle)
    (right : erp_p2p_event_store right_version middle to)
    (sum : nat_add left_version right_version version) :
    erp_p2p_event_store version from to =
    ErpP2PEventStoreThen (\? (left, right, sum))

:= erp_p2p_event_outbox_then \* left_version right_version version from middle to.
    (left : erp_p2p_event_outbox left_version from middle)
    (right : erp_p2p_event_outbox right_version middle to)
    (sum : nat_add left_version right_version version) :
    erp_p2p_event_outbox version from to =
    ErpP2PEventOutboxThen (\? (left, right, sum))

:= erp_p2p_issue_purchase_order_op_from_upstream
    (reserve_operation :
        erp_op requisition_drafted budget_reserved
            (requisition company_a usd widget_a * budget_token company_a usd))
    (approval_operation :
        erp_op budget_reserved approvals_collected (approval_quorum po_1001)) :
    erp_op approvals_collected purchase_order_issued
        (purchase_order company_a usd widget_a po_1001) =
    ?= reserve_operation, approval_operation ?|
    | ReserveBudget (_, budget_value), CollectApprovals approval_value =>
        := quantity_value : quantity widget_a each =
            quantity (
                widget_a "widget-a",
                each "each",
                10i64)
        := purchase_order_value : purchase_order company_a usd widget_a po_1001 =
            purchase_order (
                company_a "company-a",
                usd "USD",
                widget_a "widget-a",
                po_1001 "po-1001",
                "purchase-order-issued-1001")
        IssuePurchaseOrder (
            budget_value,
            approval_value,
            quantity_value,
            purchase_order_value)

:= erp_p2p_issue_purchase_order_op () :
    erp_op approvals_collected purchase_order_issued
        (purchase_order company_a usd widget_a po_1001) =
    erp_p2p_issue_purchase_order_op_from_upstream
        (erp_p2p_reserve_budget_op ())
        (erp_p2p_collect_approvals_op ())

:= erp_p2p_issue_purchase_order_plan () :
    erp_plan approvals_collected purchase_order_issued =
    ErpStep (\? (erp_p2p_issue_purchase_order_op ()))

:= assert_erp_p2p_three_event_store_runtime
    (store_length : i64) (outbox_length : i64)
    (store_stage : string) (outbox_stage : string) : () =
    $"if !store_length <> 3L || !outbox_length <> 3L || !store_stage <> \"purchase-order-issued\" || !outbox_stage <> \
        \"purchase-order-issued\" then failwith \"erp-p2p-three-event-store-runtime-mismatch\""

:= erp_p2p_three_event_store_terminal () : string =
    := reserve_event =
        erp_p2p_unit_event_from_op (erp_p2p_reserve_budget_op ())
    := approvals_event =
        erp_p2p_unit_event_from_op (erp_p2p_collect_approvals_op ())
    := purchase_order_event =
        erp_p2p_unit_event_from_op (erp_p2p_issue_purchase_order_op ())
    := first_store, first_outbox =
        erp_p2p_event_commit_then reserve_event approvals_event
    := final_store, final_outbox =
        erp_p2p_event_commit_one purchase_order_event
    := store = erp_p2p_event_store_then first_store final_store (v65_add_two_one_three ())
    := outbox = erp_p2p_event_outbox_then first_outbox final_outbox (v65_add_two_one_three ())
    := store_plan = erp_p2p_event_store_replay store
    := outbox_plan = erp_p2p_event_outbox_replay outbox
    := store_length = erp_p2p_event_store_length store
    := outbox_length = erp_p2p_event_outbox_length outbox
    := store_stage = terminal store_plan
    := outbox_stage = terminal outbox_plan
    := _ =
        assert_erp_p2p_three_event_store_runtime
            store_length outbox_length store_stage outbox_stage
    "the-type-level-P2P-store-and-outbox-now-compose-three-endpoint-linked-events-through-a-recursive-store-concate"
    ^^ "nation-and-replay-the-same-purchase-order-issued-plan"

:= erp_p2p_receive_partial_goods_op_from_upstream
    (purchase_order_operation :
        erp_op approvals_collected purchase_order_issued
            (purchase_order company_a usd widget_a po_1001)) :
    erp_op purchase_order_issued goods_partially_received
        (receipt company_a usd widget_a warehouse_north po_1001) =
    ?= purchase_order_operation ?|
    | IssuePurchaseOrder (_, _, ordered_quantity_value, purchase_order_value) =>
        := received_quantity_value : quantity widget_a each =
            quantity (
                widget_a "widget-a",
                each "each",
                6i64)
        := quantity_authority : ordered_partial_quantity widget_a each =
            OrderedPartialQuantity (
                ordered_quantity_value,
                received_quantity_value)
        := _ = validate_ordered_partial_quantity quantity_authority
        ReceivePartialGoods (
            purchase_order_value,
            quantity_authority,
            warehouse_north "warehouse-north",
            "partial-receipt-north-1001")

:= erp_p2p_receive_partial_goods_op () :
    erp_op purchase_order_issued goods_partially_received
        (receipt company_a usd widget_a warehouse_north po_1001) =
    erp_p2p_receive_partial_goods_op_from_upstream
        (erp_p2p_issue_purchase_order_op ())

:= erp_p2p_receive_partial_goods_plan () :
    erp_plan purchase_order_issued goods_partially_received =
    ErpStep (\? (erp_p2p_receive_partial_goods_op ()))

:= erp_p2p_four_event_commit_tree () :
    erp_p2p_event_commit_tree nat_four requisition_drafted goods_partially_received =
    := reserve_event =
        erp_p2p_unit_event_from_op (erp_p2p_reserve_budget_op ())
    := approvals_event =
        erp_p2p_unit_event_from_op (erp_p2p_collect_approvals_op ())
    := purchase_order_event =
        erp_p2p_unit_event_from_op (erp_p2p_issue_purchase_order_op ())
    := receipt_event =
        erp_p2p_unit_event_from_op (erp_p2p_receive_partial_goods_op ())
    := reserve_commit = ErpP2PEventCommitTreeOne reserve_event
    := approvals_commit = ErpP2PEventCommitTreeOne approvals_event
    := purchase_order_commit = ErpP2PEventCommitTreeOne purchase_order_event
    := receipt_commit = ErpP2PEventCommitTreeOne receipt_event
    := first_two =
        ErpP2PEventCommitTreeThen (\? (
            reserve_commit,
            approvals_commit,
            v65_add_one_one_two ()))
    := first_three =
        ErpP2PEventCommitTreeThen (\? (
            first_two,
            purchase_order_commit,
            v65_add_two_one_three ()))
    := all_four =
        ErpP2PEventCommitTreeThen (\? (
            first_three,
            receipt_commit,
            v65_add_three_one_four ()))
    all_four

:= erp_p2p_four_event_commit () :
    erp_p2p_event_store nat_four requisition_drafted goods_partially_received *
        erp_p2p_event_outbox nat_four requisition_drafted goods_partially_received =
    erp_p2p_event_commit_tree_project (erp_p2p_four_event_commit_tree ())

:= erp_p2p_receive_partial_goods_receipt
    (operation :
        erp_op purchase_order_issued goods_partially_received
            (receipt company_a usd widget_a warehouse_north po_1001)) :
    receipt company_a usd widget_a warehouse_north po_1001 =
    ?= operation ?|
    | ReceivePartialGoods (purchase_order_value, quantity_authority, location_value, note) =>
        ?= purchase_order_value, validate_ordered_partial_quantity quantity_authority ?|
        | purchase_order (entity_value, currency_value, item_value, document_value, _),
          quantity (_, _, received_amount) =>
            receipt (
                entity_value,
                currency_value,
                item_value,
                location_value,
                document_value,
                received_amount,
                note)

:= erp_p2p_receive_partial_goods_tax_witness
    (receipt_operation :
        erp_op purchase_order_issued goods_partially_received
            (receipt company_a usd widget_a warehouse_north po_1001)) :
    tax_witness tax_brazil usd po_1001 =
    ?= erp_p2p_receive_partial_goods_receipt receipt_operation ?|
    | receipt (_, currency_value, _, _, document_value, _, _) =>
        tax_witness (
            tax_brazil "BR",
            currency_value,
            document_value,
            170i64,
            "tax-witness-br-1001-sealed-by-the-upstream-receipt-stage")

:! erp_p2p_receive_partial_goods_tax_authority =
    erp_op purchase_order_issued goods_partially_received
        (receipt company_a usd widget_a warehouse_north po_1001) *
    tax_witness tax_brazil usd po_1001

:= erp_p2p_receive_partial_goods_tax_authority_make () :
    erp_p2p_receive_partial_goods_tax_authority =
    := receipt_operation = erp_p2p_receive_partial_goods_op ()
    := tax_value = erp_p2p_receive_partial_goods_tax_witness receipt_operation
    erp_p2p_receive_partial_goods_tax_authority (receipt_operation, tax_value)

:= erp_p2p_receive_partial_goods_tax_authority_project
    (authority : erp_p2p_receive_partial_goods_tax_authority) :
    erp_op purchase_order_issued goods_partially_received
        (receipt company_a usd widget_a warehouse_north po_1001) *
    tax_witness tax_brazil usd po_1001 =
    ?= authority ?|
    | erp_p2p_receive_partial_goods_tax_authority payload => payload

:= erp_p2p_match_invoice_tax_authority_project
    (authority :
        erp_p2p_receipt_tax_authority company_a usd widget_a warehouse_north tax_brazil po_1001) :
    receipt company_a usd widget_a warehouse_north po_1001 *
        tax_witness tax_brazil usd po_1001 =
    ?= authority ?|
    | erp_p2p_receipt_tax_authority payload => payload

:= erp_p2p_match_invoice_op () :
    erp_op goods_partially_received invoice_three_way_matched
        (invoice_match company_a usd widget_a warehouse_north tax_brazil po_1001) =
    := upstream_authority = erp_p2p_receive_partial_goods_tax_authority_make ()
    := receipt_operation, tax_value =
        erp_p2p_receive_partial_goods_tax_authority_project upstream_authority
    := purchase_order_value : purchase_order company_a usd widget_a po_1001 =
        ?= receipt_operation ?|
        | ReceivePartialGoods (purchase_order_value, _, _, _) => purchase_order_value
    := receipt_value = erp_p2p_receive_partial_goods_receipt receipt_operation
    MatchInvoice (purchase_order_value, receipt_value, tax_value)

:= erp_p2p_match_invoice_plan () :
    erp_plan goods_partially_received invoice_three_way_matched =
    ErpStep (\? (erp_p2p_match_invoice_op ()))

:= erp_p2p_match_invoice_result
    (operation :
        erp_op goods_partially_received invoice_three_way_matched
            (invoice_match company_a usd widget_a warehouse_north tax_brazil po_1001)) :
    invoice_match company_a usd widget_a warehouse_north tax_brazil po_1001 =
    ?= operation ?|
    | MatchInvoice (purchase_order_value, receipt_value, tax_value) =>
        ?= purchase_order_value, receipt_value, tax_value ?|
        | purchase_order (entity_value, currency_value, item_value, document_value, _),
          receipt (_, _, _, location_value, _, _, _),
          tax_witness (jurisdiction_value, _, _, _, _) =>
            invoice_match (
                entity_value,
                currency_value,
                item_value,
                location_value,
                jurisdiction_value,
                document_value,
                "invoice-match-1001")

:= erp_p2p_net_intercompany_op () :
    erp_op invoice_three_way_matched intercompany_netted
        (mirror_entry company_a company_b usd po_1001 *
            invoice_match company_a usd widget_a warehouse_north tax_brazil po_1001) =
    := invoice_value :
        invoice_match company_a usd widget_a warehouse_north tax_brazil po_1001 =
        erp_p2p_match_invoice_result (erp_p2p_match_invoice_op ())
    := mirrors : opposed_mirror_pair company_a company_b usd po_1001 =
        OpposedMirrorPair (
            company_a "company-a",
            company_b "company-b",
            usd "USD",
            po_1001 "po-1001",
            830i64,
            "company-a-intercompany-receivable-830",
            "company-b-intercompany-payable-minus-830")
    NetIntercompany (invoice_value, mirrors)

:= erp_p2p_net_intercompany_op_from_decoded_match_invoice
    (decoded_operation :
        erp_op goods_partially_received invoice_three_way_matched
            (invoice_match company_a usd widget_a warehouse_north tax_brazil po_1001)) :
    erp_op invoice_three_way_matched intercompany_netted
        (mirror_entry company_a company_b usd po_1001 *
            invoice_match company_a usd widget_a warehouse_north tax_brazil po_1001) =
    := invoice_value = erp_p2p_match_invoice_result decoded_operation
    := mirrors : opposed_mirror_pair company_a company_b usd po_1001 =
        OpposedMirrorPair (
            company_a "company-a",
            company_b "company-b",
            usd "USD",
            po_1001 "po-1001",
            830i64,
            "company-a-intercompany-receivable-830",
            "company-b-intercompany-payable-minus-830")
    NetIntercompany (invoice_value, mirrors)

:= erp_p2p_net_intercompany_mirror_runtime
    (operation :
        erp_op invoice_three_way_matched intercompany_netted
            (mirror_entry company_a company_b usd po_1001 *
                invoice_match company_a usd widget_a warehouse_north tax_brazil po_1001))
    : i64 * i64 =
    ?= operation ?|
    | NetIntercompany (_, mirrors) =>
        ?= opposed_mirror_pair_left mirrors, opposed_mirror_pair_right mirrors ?|
        | mirror_entry (_, _, _, _, left_amount, _),
          mirror_entry (_, _, _, _, right_amount, _) =>
            left_amount, right_amount

:= assert_erp_p2p_net_intercompany_runtime
    (left_amount : i64) (right_amount : i64) (stage : string) : () =
    $"if !left_amount <> 830L || !right_amount <> -830L || !left_amount + !right_amount <> 0L || !stage <> \
        \"intercompany-netted\" then failwith \"erp-p2p-net-intercompany-runtime-mismatch\""

:= erp_p2p_net_intercompany_terminal () : string =
    := operation = erp_p2p_net_intercompany_op ()
    := left_amount, right_amount =
        erp_p2p_net_intercompany_mirror_runtime operation
    := stage = terminal (ErpStep (\? operation))
    := _ =
        assert_erp_p2p_net_intercompany_runtime
            left_amount right_amount stage
    "NetIntercompany-now-derives-both-company-mirror-entries-from-one-opposed-mirror-pair-authority-so-plus-plus-de"
    ^^ "tached-mirrors-are-not-an-inhabitant-of-the-domain-operation-while-arbitrary-field-decoding-remains-open"

:= erp_net_intercompany_operation_payload_frame \* result.
    (operation : erp_op invoice_three_way_matched intercompany_netted result)
    : string
    =
    ?= operation ?|
    | NetIntercompany (invoice_value, mirrors) =>
        := left_mirror = opposed_mirror_pair_left mirrors
        := right_mirror = opposed_mirror_pair_right mirrors
        ?= invoice_value ?|
        | invoice_match (
                invoice_entity,
                invoice_currency,
                invoice_item,
                invoice_location,
                invoice_jurisdiction,
                invoice_document,
                invoice_identity
            )
            =>
                ?= left_mirror ?|
                | mirror_entry (
                        left_entity,
                        left_counterparty,
                        left_currency,
                        left_document,
                        left_amount,
                        left_identity
                    )
                    =>
                        ?= right_mirror ?|
                        | mirror_entry (
                                right_entity,
                                right_counterparty,
                                right_currency,
                                right_document,
                                right_amount,
                                right_identity
                            )
                            =>
                                $"(let fields = [| !invoice_entity; !invoice_currency; !invoice_item; \
                                    !invoice_location; !invoice_jurisdiction; !invoice_document; !invoice_identity; \
                                    !left_entity; !left_counterparty; !left_currency; !left_document; string \
                                    !left_amount; !left_identity; !right_entity; !right_counterparty; \
                                    !right_currency; !right_document; string !right_amount; !right_identity |] in let \
                                    bytes = fields |> Array.collect (fun value -> let payload = \
                                    System.Text.Encoding.UTF8.GetBytes(value) in let length = \
                                    System.BitConverter.GetBytes(System.Net.IPAddress.HostToNetworkOrder(payload.Lengt\
                                    h)) in Array.append length payload) in System.Convert.ToBase64String(bytes))"

:= erp_net_intercompany_payload_frame_runtime (encoded : string) : i64 * i64 =
    $"(int64 (System.Convert.FromBase64String(!encoded).Length), int64 \
        (System.Security.Cryptography.SHA256.HashData(System.Text.Encoding.UTF8.GetBytes(!encoded)).Length))"

:= assert_erp_net_intercompany_payload_frame_runtime (bytes : i64) (digest : i64) : () =
    := ok_0 = !!!!GT(bytes, 0i64)
    := ok_1 = !!!!EQ(digest, 32i64)
    ? ok_0 && ok_1 ?> () |: mega_runtime_fail "erp-NetIntercompany-payload-frame-runtime-mismatch"

:= erp_net_intercompany_payload_frame_terminal () : string =
    := operation = erp_p2p_net_intercompany_op ()
    := encoded = erp_net_intercompany_operation_payload_frame operation
    := bytes, digest = erp_net_intercompany_payload_frame_runtime encoded
    := left_amount, right_amount = erp_p2p_net_intercompany_mirror_runtime operation
    := stage = terminal (ErpStep (\? operation))
    := _ = assert_erp_net_intercompany_payload_frame_runtime bytes digest
    := _ = assert_erp_p2p_net_intercompany_runtime left_amount right_amount stage
    "one-NetIntercompany-operation-authority-now-derives-the-opposed-mirror-amounts-stage-and-canonical-length-pref"
    ^^ "ixed-payload-frame-in-the-same-active-terminal-before-SHA256-validation-so-the-codec-no-longer-reconstructs-a-"
    ^^ "parallel-domain-operation-while-total-decoding-and-sixth-event-persistence-remain-open"

:| erp_net_intercompany_payload_decode_decision =
    | ErpNetIntercompanyPayloadDecoded :: string ->
        erp_net_intercompany_payload_decode_decision
    | ErpNetIntercompanyPayloadRejected :: string ->
        erp_net_intercompany_payload_decode_decision

:= erp_net_intercompany_payload_validate_runtime (encoded : string) : i64 =
    $"(let tryDecode (text : string) = try let bytes = System.Convert.FromBase64String(text) in let mutable offset = \
        0 in let fields = System.Collections.Generic.List<string>() in let mutable valid = true in while valid && \
        offset < bytes.Length do if offset + 4 > bytes.Length then valid <- false else let raw = \
        System.BitConverter.ToInt32(bytes, offset) |> System.Net.IPAddress.NetworkToHostOrder in offset <- offset + \
        4; if raw < 0 || offset + raw > bytes.Length then valid <- false else \
        fields.Add(System.Text.Encoding.UTF8.GetString(bytes, offset, raw)); offset <- offset + raw done; if valid && \
        offset = bytes.Length then Some(fields.ToArray()) else None with _ -> None in let expected = [| \
        \"company-a\"; \"USD\"; \"widget-a\"; \"warehouse-north\"; \"BR\"; \"po-1001\"; \"invoice-match-1001\"; \
        \"company-a\"; \"company-b\"; \"USD\"; \"po-1001\"; \"830\"; \"company-a-intercompany-receivable-830\"; \
        \"company-b\"; \"company-a\"; \"USD\"; \"po-1001\"; \"-830\"; \"company-b-intercompany-payable-minus-830\" |] \
        in match tryDecode !encoded with Some fields when fields.Length = expected.Length && Array.forall2 (=) fields \
        expected -> (match System.Int64.TryParse(fields.[11]), System.Int64.TryParse(fields.[17]) with \
        (true,left),(true,right) when left = 830L && right = -830L && left + right = 0L -> 1L | _ -> 0L) | _ -> 0L)"

:= erp_net_intercompany_payload_decode
    (encoded : string)
    :
        erp_net_intercompany_payload_decode_decision
    =
    ?= erp_net_intercompany_payload_validate_runtime encoded ?|
    | 1i64 =>
        ErpNetIntercompanyPayloadDecoded (
            "the-decoder-validates-all-nineteen-canonical-NetIntercompany-fields-and-opposed-mirror-amounts-before-"
            ^^ "producing-a-typed-acceptance-witness"
        )
    | _ =>
        ErpNetIntercompanyPayloadRejected
            "invalid-or-truncated-NetIntercompany-frame-does-not-produce-a-typed-operation"

:= erp_net_intercompany_payload_decode_invoice_fields_runtime (encoded : string) :
    string * string * string * string * string * string * string =
    $"(let tryDecode (text : string) = try let bytes = System.Convert.FromBase64String(text) in let mutable offset = \
        0 in let fields = System.Collections.Generic.List<string>() in let mutable valid = true in while valid && \
        offset < bytes.Length do if offset + 4 > bytes.Length then valid <- false else let raw = \
        System.BitConverter.ToInt32(bytes, offset) |> System.Net.IPAddress.NetworkToHostOrder in offset <- offset + \
        4; if raw < 0 || offset + raw > bytes.Length then valid <- false else \
        fields.Add(System.Text.Encoding.UTF8.GetString(bytes, offset, raw)); offset <- offset + raw done; if valid && \
        offset = bytes.Length then Some(fields.ToArray()) else None with _ -> None in match tryDecode !encoded with \
        Some fields when fields.Length = 19 && fields.[0] = \"company-a\" && fields.[1] = \"USD\" && fields.[2] = \
        \"widget-a\" && fields.[3] = \"warehouse-north\" && fields.[4] = \"BR\" && fields.[5] = \"po-1001\" && \
        fields.[6].Length > 0 -> fields.[0],fields.[1],fields.[2],fields.[3],fields.[4],fields.[5],fields.[6] | _ -> \
        failwith \"erp-NetIntercompany-typed-decode-invalid-invoice-fields\")"

:= erp_net_intercompany_payload_decode_mirror_authority_fields_runtime (encoded : string) :
    string * string * string * string * i64 * string * string =
    $"(let tryDecode (text : string) = try let bytes = System.Convert.FromBase64String(text) in let mutable offset = \
        0 in let fields = System.Collections.Generic.List<string>() in let mutable valid = true in while valid && \
        offset < bytes.Length do if offset + 4 > bytes.Length then valid <- false else let raw = \
        System.BitConverter.ToInt32(bytes, offset) |> System.Net.IPAddress.NetworkToHostOrder in offset <- offset + \
        4; if raw < 0 || offset + raw > bytes.Length then valid <- false else \
        fields.Add(System.Text.Encoding.UTF8.GetString(bytes, offset, raw)); offset <- offset + raw done; if valid && \
        offset = bytes.Length then Some(fields.ToArray()) else None with _ -> None in match tryDecode !encoded with \
        Some fields when fields.Length = 19 && fields.[7] = \"company-a\" && fields.[8] = \"company-b\" && fields.[9] \
        = \"USD\" && fields.[10] = \"po-1001\" && fields.[12].Length > 0 && fields.[18].Length > 0 -> (match \
        System.Int64.TryParse(fields.[11]) with true,leftAmount when leftAmount = 830L -> \
        fields.[7],fields.[8],fields.[9],fields.[10],leftAmount,fields.[12],fields.[18] | _ -> failwith \
        \"erp-NetIntercompany-typed-decode-invalid-left-mirror-amount\") | _ -> failwith \
        \"erp-NetIntercompany-typed-decode-invalid-mirror-authority-fields\")"

:= erp_net_intercompany_payload_decode_typed_operation encoded =
    ?= erp_net_intercompany_payload_decode encoded ?|
    | ErpNetIntercompanyPayloadDecoded _ =>
        := invoice_entity, invoice_currency, invoice_item, invoice_location,
            invoice_jurisdiction, invoice_document, invoice_identity =
            erp_net_intercompany_payload_decode_invoice_fields_runtime encoded
        := left_entity, right_entity, mirror_currency, mirror_document,
            left_amount, left_identity, right_identity =
            erp_net_intercompany_payload_decode_mirror_authority_fields_runtime encoded
        := invoice_value :
            invoice_match company_a usd widget_a warehouse_north tax_brazil po_1001 =
            invoice_match (
                company_a invoice_entity,
                usd invoice_currency,
                widget_a invoice_item,
                warehouse_north invoice_location,
                tax_brazil invoice_jurisdiction,
                po_1001 invoice_document,
                invoice_identity)
        := mirrors : opposed_mirror_pair company_a company_b usd po_1001 =
            OpposedMirrorPair (
                company_a left_entity,
                company_b right_entity,
                usd mirror_currency,
                po_1001 mirror_document,
                left_amount,
                left_identity,
                right_identity)
        NetIntercompany (invoice_value, mirrors)
    | ErpNetIntercompanyPayloadRejected note =>
        $"failwith (\"canonical-NetIntercompany-bytes-could-not-reconstruct-typed-operation:\" + !note)"

:= assert_erp_net_intercompany_payload_typed_decode_roundtrip_runtime
    (encoded : string) (reencoded : string) : () =
    ~~ $"if !encoded <> !reencoded then failwith \"erp-NetIntercompany-typed-decode-roundtrip-mismatch\""

:| erp_net_intercompany_typed_decode_authority =
    | ErpNetIntercompanyTypedDecodeAuthority :
        string *
        erp_op invoice_three_way_matched intercompany_netted
            (mirror_entry company_a company_b usd po_1001 *
                invoice_match company_a usd widget_a warehouse_north tax_brazil po_1001) *
        string

:= erp_net_intercompany_typed_decode_authority_from_bytes (encoded : string) :
    erp_net_intercompany_typed_decode_authority =
    := decoded_operation = erp_net_intercompany_payload_decode_typed_operation encoded
    := reencoded = erp_net_intercompany_operation_payload_frame decoded_operation
    := _ = assert_erp_net_intercompany_payload_typed_decode_roundtrip_runtime encoded reencoded
    ErpNetIntercompanyTypedDecodeAuthority (encoded, decoded_operation, reencoded)

:= erp_net_intercompany_payload_decode_tag
    (decision : erp_net_intercompany_payload_decode_decision) : i64 =
    ?= decision ?|
    | ErpNetIntercompanyPayloadDecoded _ => 1i64
    | ErpNetIntercompanyPayloadRejected _ => 0i64

:= assert_erp_net_intercompany_payload_codec_runtime
    (accepted : i64) (truncated_rejected : i64) : () =
    := ok_0 = !!!!EQ(accepted, 1i64)
    := ok_1 = !!!!EQ(truncated_rejected, 1i64)
    ? ok_0 && ok_1 ?> () |: mega_runtime_fail "erp-NetIntercompany-payload-codec-runtime-mismatch"

:= erp_net_intercompany_payload_codec_terminal () : string =
    := operation = erp_p2p_net_intercompany_op ()
    := encoded = erp_net_intercompany_operation_payload_frame operation
    := accepted = erp_net_intercompany_payload_decode encoded
    := truncated : string =
        $"if !encoded.Length > 4 then !encoded.Substring(0, !encoded.Length - 4) else \"\""
    := rejected = erp_net_intercompany_payload_decode truncated
    := accepted_tag = erp_net_intercompany_payload_decode_tag accepted
    := rejected_tag = erp_net_intercompany_payload_decode_tag rejected
    := _ =
        assert_erp_net_intercompany_payload_codec_runtime
            accepted_tag (erp_runtime_add_i64 1i64 (erp_runtime_mul_i64 -1i64 rejected_tag))
    ?= accepted ?|
    | ErpNetIntercompanyPayloadDecoded _ =>
        := decoded_operation = erp_net_intercompany_payload_decode_typed_operation encoded
        := reencoded = erp_net_intercompany_operation_payload_frame decoded_operation
        := _ : () =
            := ok_0 = !!!!EQ(reencoded, encoded)
            ? ok_0 ?> () |: mega_runtime_fail "erp-NetIntercompany-field-derived-operation-roundtrip-mismatch"
        := left_amount, right_amount =
            erp_p2p_net_intercompany_mirror_runtime decoded_operation
        := _ =
            assert_erp_p2p_net_intercompany_runtime
                left_amount right_amount (terminal (ErpStep (\? decoded_operation)))
        "NetIntercompany-now-has-a-nineteen-field-canonical-frame-and-a-fail-closed-decoder-that-reconstructs-the-e"
        ^^ "xact-result-indexed-operation-only-after-entity-counterparty-currency-document-and-opposed-mirror-amount-b"
        ^^ "indings-validate"
    | ErpNetIntercompanyPayloadRejected note =>
        $"failwith (\"canonical-NetIntercompany-frame-was-rejected:\" + !note)"

:= erp_net_intercompany_decoded_invoice
    (decoded_operation :
        erp_op invoice_three_way_matched intercompany_netted
            (mirror_entry company_a company_b usd po_1001 *
                invoice_match company_a usd widget_a warehouse_north tax_brazil po_1001)) :
    invoice_match company_a usd widget_a warehouse_north tax_brazil po_1001 =
    ?= decoded_operation ?|
    | NetIntercompany (invoice_value, _) => invoice_value

:= erp_p2p_settlement_fx_route () :
    settlement_fx_route usd brl period_2026_07 =
    SettlementFxCompose (\? (
        SettlementFxUsdEurJuly (2i64, 1i64),
        SettlementFxEurBrlJuly (3i64, 1i64)))

:= erp_p2p_settlement_payment () : money brl i64 =
    money (brl "BRL", 2i64, 4980i64)

:= erp_p2p_settle_payment_from_decoded_net
    (decoded_operation :
        erp_op invoice_three_way_matched intercompany_netted
            (mirror_entry company_a company_b usd po_1001 *
                invoice_match company_a usd widget_a warehouse_north tax_brazil po_1001)) :
    erp_op intercompany_netted payment_settled
        (payment_receipt company_a brl widget_a warehouse_north tax_brazil payment_3001 *
            settlement_fx_route usd brl period_2026_07 *
            invoice_match company_a usd widget_a warehouse_north tax_brazil po_1001) =
    SettlePayment (
        erp_net_intercompany_decoded_invoice decoded_operation,
        erp_p2p_settlement_payment (),
        erp_p2p_settlement_fx_route (),
        payment_3001 "payment-3001")

:= erp_p2p_settle_payment_result
    (operation :
        erp_op intercompany_netted payment_settled
            (payment_receipt company_a brl widget_a warehouse_north tax_brazil payment_3001 *
                settlement_fx_route usd brl period_2026_07 *
                invoice_match company_a usd widget_a warehouse_north tax_brazil po_1001)) :
    payment_receipt company_a brl widget_a warehouse_north tax_brazil payment_3001 =
    ?= operation ?|
    | SettlePayment (invoice_value, payment_amount, _, payment_document_value) =>
        ?= invoice_value ?|
        | invoice_match (entity_value, _, item_value, location_value, jurisdiction_value, _, _) =>
            ?= payment_amount ?|
            | money (target_currency_value, _, _) =>
                payment_receipt (
                    entity_value,
                    target_currency_value,
                    item_value,
                    location_value,
                    jurisdiction_value,
                    payment_document_value,
                    "payment-receipt-3001")

:= erp_p2p_close_period_from_decoded_net
    (decoded_operation :
        erp_op invoice_three_way_matched intercompany_netted
            (mirror_entry company_a company_b usd po_1001 *
                invoice_match company_a usd widget_a warehouse_north tax_brazil po_1001)) :
    erp_op payment_settled period_closed
        (close_certificate company_a period_2026_07 ifrs) =
    := payment_value :
        payment_receipt company_a brl widget_a warehouse_north tax_brazil payment_3001 =
        erp_p2p_settle_payment_result (
            erp_p2p_settle_payment_from_decoded_net decoded_operation)
    := projection :
        gaap_projection
            (payment_receipt company_a brl widget_a warehouse_north tax_brazil payment_3001)
            ifrs string =
        ProjectIfrs (payment_value, "ifrs-close-2026-07")
    ClosePeriod (
        payment_value,
        period_2026_07 "2026-07",
        projection)

:= erp_p2p_close_period_op () :
    erp_op payment_settled period_closed
        (close_certificate company_a period_2026_07 ifrs) =
    erp_p2p_close_period_from_decoded_net (erp_p2p_net_intercompany_op ())

:= assert_erp_p2p_settle_payment_from_decoded_runtime
    (numerator : i64) (denominator : i64) (stage : string) : () =
    $"if !numerator <> 6L || !denominator <> 1L || !stage <> \"payment-settled-through-composed-typed-fx-route\" then \
        failwith \"erp-p2p-settle-payment-from-decoded-runtime-mismatch\""

:= erp_p2p_settle_payment_from_decoded_terminal () : string =
    := encoded =
        erp_net_intercompany_operation_payload_frame (erp_p2p_net_intercompany_op ())
    ?= erp_net_intercompany_typed_decode_authority_from_bytes encoded ?|
    | ErpNetIntercompanyTypedDecodeAuthority (authority_bytes, decoded_operation, reencoded) =>
        := _ = assert_erp_net_intercompany_payload_typed_decode_roundtrip_runtime encoded authority_bytes
        := _ = assert_erp_net_intercompany_payload_typed_decode_roundtrip_runtime authority_bytes reencoded
        := settlement =
            erp_p2p_settle_payment_from_decoded_net decoded_operation
        ?= settlement ?|
        | SettlePayment (_, _, route, _) =>
            := numerator, denominator = settlement_fx_route_ratio route
            := stage = terminal (ErpStep (\? settlement))
            := _ =
                assert_erp_p2p_settle_payment_from_decoded_runtime
                    numerator denominator stage
            "the-sealed-NetIntercompany-bytes-operation-reencode-authority-now-feeds-SettlePayment-directly-through"
            ^^ "-the-composed-USD-EUR-BRL-route-without-a-second-decoder-or-a-synthetic-operation-rebuild"

