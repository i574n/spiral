    ?> ()
    |: mega_runtime_fail "erp-p2p-four-event-atomic-payload-outbox-runtime-mismatch"

:= erp_p2p_four_event_outbox_authority_runtime
    (reserve_outbox : string) (approvals_outbox : string)
    (purchase_outbox : string) (receipt_outbox : string) : i64 * i64 =
    $"(let messages = [| !reserve_outbox; !approvals_outbox; !purchase_outbox; !receipt_outbox |] in let expected = \
        [| \"erp-p2p-budget-reserved-outbox\"; \"erp-p2p-approvals-collected-outbox\"; \
        \"erp-p2p-purchase-order-issued-outbox\"; \"erp-p2p-goods-partially-received-outbox\" |] in (if messages = \
        expected then 1L else 0L),(if messages |> Array.distinct |> Array.length = 4 then 1L else 0L))"

:= assert_erp_p2p_four_event_outbox_authority_runtime
    (expected : i64) (distinct : i64) : () =
    := ok_0 = !!!!EQ(expected, 1i64)
    := ok_1 = !!!!EQ(distinct, 1i64)
    ? ok_0 && ok_1 ?> () |: mega_runtime_fail "erp-p2p-four-event-outbox-authority-runtime-mismatch"

:= erp_p2p_four_event_atomic_payload_outbox_terminal () : string =
    := reserve_event = erp_p2p_unit_event_from_op (erp_p2p_reserve_budget_op ())
    := approvals_event = erp_p2p_unit_event_from_op (erp_p2p_collect_approvals_op ())
    := purchase_event = erp_p2p_unit_event_from_op (erp_p2p_issue_purchase_order_op ())
    := receipt_event = erp_p2p_unit_event_from_op (erp_p2p_receive_partial_goods_op ())
    := reserve_payload = erp_reserve_budget_payload_frame (erp_p2p_unit_event_plan reserve_event)
    := approvals_payload = erp_collect_approvals_payload_frame (erp_p2p_unit_event_plan approvals_event)
    := purchase_payload = erp_issue_purchase_order_payload_frame (erp_p2p_unit_event_plan purchase_event)
    := receipt_payload = erp_receive_partial_goods_payload_frame (erp_p2p_unit_event_plan receipt_event)
    := reserve_outbox = erp_p2p_unit_outbox_message (erp_p2p_unit_outbox_project reserve_event)
    := approvals_outbox = erp_p2p_unit_outbox_message (erp_p2p_unit_outbox_project approvals_event)
    := purchase_outbox = erp_p2p_unit_outbox_message (erp_p2p_unit_outbox_project purchase_event)
    := receipt_outbox = erp_p2p_unit_outbox_message (erp_p2p_unit_outbox_project receipt_event)
    := expected_outboxes, distinct_outboxes =
        erp_p2p_four_event_outbox_authority_runtime
            reserve_outbox approvals_outbox purchase_outbox receipt_outbox
    := _ = assert_erp_p2p_four_event_outbox_authority_runtime expected_outboxes distinct_outboxes
    := bytes
        , parse_valid, frame_count, payload_equal, outbox_equal, digest_valid, prepared_absent, directory_sync,
        tamper_rejected, cleanup_absent
        =
        erp_p2p_four_event_atomic_payload_outbox_runtime
            reserve_payload reserve_outbox approvals_payload approvals_outbox
            purchase_payload purchase_outbox receipt_payload receipt_outbox
    := _ =
        assert_erp_p2p_four_event_atomic_payload_outbox_runtime
            bytes parse_valid frame_count payload_equal outbox_equal digest_valid
            prepared_absent directory_sync tamper_rejected cleanup_absent
    "the-four-endpoint-linked-P2P-operations-now-each-derive-their-own-typed-payload-frame-and-operation-specific-o"
    ^^ "utbox-message-before-all-four-event-outbox-pairs-enter-one-ERP4-prepared-flushed-renamed-directory-synced-enve"
    ^^ "lope-whose-reopen-parser-verifies-frame-count-byte-equality-and-one-SHA256-per-payload-and-rejects-a-bit-flip-"
    ^^ "in-the-second-event"

:= erp_p2p_stage_sequence_codec_runtime
    (store_sequence : string) (outbox_sequence : string) :
    i64 * i64 * i64 * i64 * i64 * i64 * i64 =
    $"(let encodeField (value : string) = let count = System.Text.Encoding.UTF8.GetByteCount(value) in string count + \
        \":\" + value in let encodeSequence (value : string) = value.Split([|'|'|], System.StringSplitOptions.None) \
        |> Array.map encodeField |> String.concat \"|\" in let decodeField (field : string) = let colon = \
        field.IndexOf(':') in if colon <= 0 then false,\"\" else let count = \
        System.Int32.Parse(field.Substring(0,colon)) in let value = field.Substring(colon+1) in \
        System.Text.Encoding.UTF8.GetByteCount(value) = count,value in let decodeSequence (value : string) = \
        value.Split([|'|'|], System.StringSplitOptions.None) |> Array.map decodeField in let encodedStore = \
        encodeSequence !store_sequence in let encodedOutbox = encodeSequence !outbox_sequence in let storeDecoded = \
        decodeSequence encodedStore in let outboxDecoded = decodeSequence encodedOutbox in let storeValid = if \
        storeDecoded |> Array.forall fst then 1L else 0L in let outboxValid = if outboxDecoded |> Array.forall fst \
        then 1L else 0L in let frameCount = int64 storeDecoded.Length in let storeValues = storeDecoded |> Array.map \
        snd in let outboxValues = outboxDecoded |> Array.map snd in let same = if storeValues = outboxValues then 1L \
        else 0L in let roundtrip = if (storeValues |> Array.map encodeField |> String.concat \"|\") = encodedStore \
        then 1L else 0L in let tampered = encodedStore + \"x\" in let tamperRejected = if decodeSequence tampered |> \
        Array.forall fst then 0L else 1L in let digestBytes = System.Security.Cryptography.SHA256.HashData(System.Text\
        .Encoding.UTF8.GetBytes(encodedStore)).Length |> int64 in frameCount, storeValid, outboxValid, same, \
        roundtrip, tamperRejected, digestBytes)"

:= assert_erp_p2p_stage_sequence_codec_runtime
    (frame_count : i64) (store_valid : i64) (outbox_valid : i64)
    (same : i64) (roundtrip : i64) (tamper_rejected : i64)
    (digest_bytes : i64)
    : ()
    =
    := ok_0 = !!!!EQ(frame_count, 4i64)
    := ok_1 = !!!!EQ(store_valid, 1i64)
    := ok_2 = !!!!EQ(outbox_valid, 1i64)
    := ok_3 = !!!!EQ(same, 1i64)
    := ok_4 = !!!!EQ(roundtrip, 1i64)
    := ok_5 = !!!!EQ(tamper_rejected, 1i64)
    := ok_6 = !!!!EQ(digest_bytes, 32i64)
    ? ok_0 && ok_1 && ok_2 && ok_3 && ok_4 && ok_5 && ok_6
    ?> ()
    |: mega_runtime_fail "erp-p2p-stage-sequence-codec-runtime-mismatch"

:= erp_p2p_four_event_stage_sequence_codec_terminal () : string =
    := store, outbox = erp_p2p_four_event_commit ()
    := store_sequence = erp_p2p_event_store_stage_sequence store
    := outbox_sequence = erp_p2p_event_outbox_stage_sequence outbox
    := frame_count, store_valid, outbox_valid, same, roundtrip, tamper_rejected, digest_bytes =
        erp_p2p_stage_sequence_codec_runtime store_sequence outbox_sequence
    := _ =
        assert_erp_p2p_stage_sequence_codec_runtime
            frame_count store_valid outbox_valid same roundtrip tamper_rejected digest_bytes
    "the-four-endpoint-linked-P2P-events-now-drive-one-canonical-UTF8-length-prefixed-stage-sequence-codec-from-the"
    ^^ "-typed-store-and-the-same-codec-from-the-outbox-the-decoder-recovers-all-four-stages-reencoding-is-byte-exact-"
    ^^ "SHA256-covers-the-canonical-bytes-and-a-length-mismatched-tamper-is-rejected-while-operation-payload-fields-an"
    ^^ "d-a-complete-event-decoder-remain-open-sealed"

:= erp_p2p_unit_physical_commit_runtime \* from to.
    (event : erp_p2p_unit_event from to) : i64 * i64 * i64 * i64 * i64 * i64 =
    := store, outbox = erp_p2p_unit_commit_project event
    := store_stage = terminal (erp_p2p_unit_store_replay store)
    := outbox_stage = terminal (erp_p2p_unit_outbox_replay outbox)
    := outbox_message = erp_p2p_unit_outbox_message outbox
    $"(let directory = System.IO.Path.Combine(System.IO.Path.GetTempPath(), \"spiral-erp-p2p-atomic-\" + \
        System.Guid.NewGuid().ToString(\"N\")) in let _ = System.IO.Directory.CreateDirectory(directory) in let \
        runSync flag path = let info = new System.Diagnostics.ProcessStartInfo() in info.FileName <- \
        \"/usr/bin/sync\"; info.UseShellExecute <- false; info.ArgumentList.Add(flag); info.ArgumentList.Add(path); \
        use process = System.Diagnostics.Process.Start(info) in let completed = process.WaitForExit(5000) in let _ = \
        if not completed then (process.Kill(true); process.WaitForExit() |> ignore) else () in if completed then \
        int64 process.ExitCode else -2L in let prepared = System.IO.Path.Combine(directory, \"commit.prepared\") in \
        let committed = System.IO.Path.Combine(directory, \"commit.committed\") in let payload = !store_stage + \"|\" \
        + !outbox_stage + \"|\" + !outbox_message in let bytes = System.Text.Encoding.UTF8.GetBytes(payload) in (use \
        stream = new System.IO.FileStream(prepared, System.IO.FileMode.CreateNew, System.IO.FileAccess.Write, \
        System.IO.FileShare.None, 4096, System.IO.FileOptions.WriteThrough) in stream.Write(bytes, 0, bytes.Length); \
        stream.Flush(true)); System.IO.File.Move(prepared, committed, true); let directorySync = runSync \"-f\" \
        directory in let recovered = System.IO.File.ReadAllBytes(committed) in let recoveredEqual = if \
        System.Linq.Enumerable.SequenceEqual(bytes, recovered) then 1L else 0L in let preparedAbsent = if \
        System.IO.File.Exists(prepared) then 0L else 1L in let recoveredText = \
        System.Text.Encoding.UTF8.GetString(recovered) in let payloadBound = if recoveredText = \
        \"budget-reserved|budget-reserved|erp-p2p-budget-reserved-outbox\" then 1L else 0L in \
        System.IO.File.Delete(committed); let committedAbsent = if System.IO.File.Exists(committed) then 0L else 1L \
        in System.IO.Directory.Delete(directory); (int64 bytes.Length, recoveredEqual, preparedAbsent, payloadBound, \
        directorySync, committedAbsent))"

:= assert_erp_p2p_unit_physical_commit_runtime
    (bytes : i64) (recovered_equal : i64) (prepared_absent : i64)
    (payload_bound : i64) (directory_sync : i64) (committed_absent : i64)
    : ()
    =
    := ok_0 = !!!!GT(bytes, 0i64)
    := ok_1 = !!!!EQ(recovered_equal, 1i64)
    := ok_2 = !!!!EQ(prepared_absent, 1i64)
    := ok_3 = !!!!EQ(payload_bound, 1i64)
    := ok_4 = !!!!EQ(directory_sync, 0i64)
    := ok_5 = !!!!EQ(committed_absent, 1i64)
    ? ok_0 && ok_1 && ok_2 && ok_3 && ok_4 && ok_5
    ?> ()
    |: mega_runtime_fail "erp-p2p-unit-physical-commit-runtime-mismatch"

:= erp_p2p_unit_physical_recovery_runtime \* from to.
    (event : erp_p2p_unit_event from to) : i64 * i64 * i64 * i64 * i64 * i64 * i64 * i64 * i64 * i64 =
    := store, outbox = erp_p2p_unit_commit_project event
    := store_stage = terminal (erp_p2p_unit_store_replay store)
    := outbox_stage = terminal (erp_p2p_unit_outbox_replay outbox)
    := outbox_message = erp_p2p_unit_outbox_message outbox
    $"(let root = System.IO.Path.Combine(System.IO.Path.GetTempPath(), \"spiral-erp-p2p-recovery-\" + \
        System.Guid.NewGuid().ToString(\"N\")) in let beforeDirectory = System.IO.Path.Combine(root, \
        \"before-rename\") in let afterDirectory = System.IO.Path.Combine(root, \"after-rename\") in let _ = \
        System.IO.Directory.CreateDirectory(beforeDirectory) in let _ = \
        System.IO.Directory.CreateDirectory(afterDirectory) in let runSync flag path = let info = new \
        System.Diagnostics.ProcessStartInfo() in info.FileName <- \"/usr/bin/sync\"; info.UseShellExecute <- false; \
        info.ArgumentList.Add(flag); info.ArgumentList.Add(path); use process = \
        System.Diagnostics.Process.Start(info) in let completed = process.WaitForExit(5000) in let _ = if not \
        completed then (process.Kill(true); process.WaitForExit() |> ignore) else () in if completed then int64 \
        process.ExitCode else -2L in let payload = !store_stage + \"|\" + !outbox_stage + \"|\" + !outbox_message in \
        let bytes = System.Text.Encoding.UTF8.GetBytes(payload) in let beforePrepared = \
        System.IO.Path.Combine(beforeDirectory, \"commit.prepared\") in let beforeCommitted = \
        System.IO.Path.Combine(beforeDirectory, \"commit.committed\") in (use stream = new \
        System.IO.FileStream(beforePrepared, System.IO.FileMode.CreateNew, System.IO.FileAccess.Write, \
        System.IO.FileShare.None, 4096, System.IO.FileOptions.WriteThrough) in stream.Write(bytes, 0, bytes.Length); \
        stream.Flush(true)); System.IO.File.Move(beforePrepared, beforeCommitted, true); let beforeDirectorySync = \
        runSync \"-f\" beforeDirectory in let beforeRecovered = System.IO.File.ReadAllBytes(beforeCommitted) in let \
        beforeEqual = if System.Linq.Enumerable.SequenceEqual(bytes, beforeRecovered) then 1L else 0L in let \
        beforePreparedAbsent = if System.IO.File.Exists(beforePrepared) then 0L else 1L in let beforeCommittedPresent \
        = if System.IO.File.Exists(beforeCommitted) then 1L else 0L in let afterPrepared = \
        System.IO.Path.Combine(afterDirectory, \"commit.prepared\") in let afterCommitted = \
        System.IO.Path.Combine(afterDirectory, \"commit.committed\") in (use stream = new \
        System.IO.FileStream(afterPrepared, System.IO.FileMode.CreateNew, System.IO.FileAccess.Write, \
        System.IO.FileShare.None, 4096, System.IO.FileOptions.WriteThrough) in stream.Write(bytes, 0, bytes.Length); \
        stream.Flush(true)); System.IO.File.Move(afterPrepared, afterCommitted, true); let afterDirectorySync = \
        runSync \"-f\" afterDirectory in let afterRecovered = System.IO.File.ReadAllBytes(afterCommitted) in let \
        afterEqual = if System.Linq.Enumerable.SequenceEqual(bytes, afterRecovered) then 1L else 0L in let \
        afterPreparedAbsent = if System.IO.File.Exists(afterPrepared) then 0L else 1L in let afterCommittedPresent = \
        if System.IO.File.Exists(afterCommitted) then 1L else 0L in System.IO.Directory.Delete(root, true); let \
        cleanupAbsent = if System.IO.Directory.Exists(root) then 0L else 1L in (int64 bytes.Length, beforeEqual, \
        beforePreparedAbsent, beforeCommittedPresent, beforeDirectorySync, afterEqual, afterPreparedAbsent, \
        afterCommittedPresent, afterDirectorySync, cleanupAbsent))"

:= assert_erp_p2p_unit_physical_recovery_runtime
    (bytes : i64) (before_equal : i64) (before_prepared_absent : i64)
    (before_committed_present : i64) (before_directory_sync : i64) (after_equal : i64)
    (after_prepared_absent : i64) (after_committed_present : i64) (after_directory_sync : i64)
    (cleanup_absent : i64)
    : ()
    =
    := ok_0 = !!!!GT(bytes, 0i64)
    := ok_1 = !!!!EQ(before_equal, 1i64)
    := ok_2 = !!!!EQ(before_prepared_absent, 1i64)
    := ok_3 = !!!!EQ(before_committed_present, 1i64)
    := ok_4 = !!!!EQ(before_directory_sync, 0i64)
    := ok_5 = !!!!EQ(after_equal, 1i64)
    := ok_6 = !!!!EQ(after_prepared_absent, 1i64)
    := ok_7 = !!!!EQ(after_committed_present, 1i64)
    := ok_8 = !!!!EQ(after_directory_sync, 0i64)
    := ok_9 = !!!!EQ(cleanup_absent, 1i64)
    ? ok_0 && ok_1 && ok_2 && ok_3 && ok_4 && ok_5 && ok_6 && ok_7 && ok_8 && ok_9
    ?> ()
    |: mega_runtime_fail "erp-p2p-unit-physical-recovery-runtime-mismatch"

:= assert_erp_p2p_reserve_budget_runtime (store_stage : string) (outbox_stage : string) : () =
    $"if !store_stage <> \"budget-reserved\" then failwith \"erp-p2p-reserve-budget-store-runtime-mismatch\"\nif \
        !outbox_stage <> \"budget-reserved\" then failwith \"erp-p2p-reserve-budget-outbox-runtime-mismatch\""

:= erp_p2p_reserve_budget_terminal () : string =
    := event = erp_p2p_unit_event_from_op (erp_p2p_reserve_budget_op ())
    := store, outbox = erp_p2p_unit_commit_project event
    := store_stage = terminal (erp_p2p_unit_store_replay store)
    := outbox_stage = terminal (erp_p2p_unit_outbox_replay outbox)
    := _ = assert_erp_p2p_reserve_budget_runtime store_stage outbox_stage
    := bytes, recovered_equal, prepared_absent, payload_bound, directory_sync, committed_absent =
        erp_p2p_unit_physical_commit_runtime event
    := _ =
        assert_erp_p2p_unit_physical_commit_runtime
            bytes recovered_equal prepared_absent payload_bound directory_sync committed_absent
    := recovery_bytes
        , before_equal, before_prepared_absent, before_committed_present, before_directory_sync, after_equal,
        after_prepared_absent, after_committed_present, after_directory_sync, recovery_cleanup_absent
        =
        erp_p2p_unit_physical_recovery_runtime event
    := _ =
        assert_erp_p2p_unit_physical_recovery_runtime
            recovery_bytes before_equal before_prepared_absent before_committed_present before_directory_sync
            after_equal after_prepared_absent after_committed_present after_directory_sync recovery_cleanup_absent
    "the-active-ERP-P2P-surface-now-derives-one-indexed-event-from-the-ReserveBudget-plan-passes-that-single-event-"
    ^^ "through-one-typed-commit-projection-that-returns-the-one-event-store-and-the-outbox-paired-with-the-same-event"
    ^^ "-replays-both-views-back-to-the-same-budget-reserved-plan-physically-writes-their-canonical-unit-payload-once-"
    ^^ "through-a-prepared-file-Flush-true-and-one-atomic-rename-and-exercises-recovery-from-both-before-rename-and-af"
    ^^ "ter-rename-cutpoints-before-byte-exact-reopen-without-caller-supplied-operation-results-parallel-events-or-end"
    ^^ "points-and-syncs-the-directory-after-each-rename-while-process-crash-restart-and-multiframe-replay-remain-open"
    ^^ "-sealed"

:= erp_p2p_recursive_atomic_payload_outbox_recovery_runtime
    (payload_sequence : string) (outbox_sequence : string)
    (tree_identity : string) (expected_version : i64) :
    i64 * i64 * i64 * i64 * i64 * i64 * i64 * i64 * i64 * i64 * i64 * i64 =
    $"(let root = System.IO.Path.Combine(System.IO.Path.GetTempPath(), \"spiral-erp-recursive-recovery-\" + \
        System.Guid.NewGuid().ToString(\"N\")) in let beforeDirectory = System.IO.Path.Combine(root, \
        \"before-rename\") in let afterDirectory = System.IO.Path.Combine(root, \"after-rename\") in let _ = \
        System.IO.Directory.CreateDirectory(beforeDirectory) in let _ = \
        System.IO.Directory.CreateDirectory(afterDirectory) in let payloadTexts = !payload_sequence.Split([|'|'|], \
        System.StringSplitOptions.RemoveEmptyEntries) in let messageTexts = !outbox_sequence.Split([|'|'|], \
        System.StringSplitOptions.RemoveEmptyEntries) in let payloads = payloadTexts |> Array.map \
        System.Convert.FromBase64String in let messages = messageTexts |> Array.map \
        System.Text.Encoding.UTF8.GetBytes in let countBound = if payloads.Length = messages.Length && int64 \
        payloads.Length = !expected_version && payloads.Length > 0 then 1L else 0L in let lengthBytes (count : int) = \
        System.BitConverter.GetBytes(System.Net.IPAddress.HostToNetworkOrder(count)) in let frameBytes index = let \
        payload = payloads.[index] in let message = messages.[index] in let digest = \
        System.Security.Cryptography.SHA256.HashData(Array.concat [| payload; message; \
        System.BitConverter.GetBytes(index); System.BitConverter.GetBytes(payloads.Length) |]) in Array.concat [| \
        lengthBytes payload.Length; payload; lengthBytes message.Length; message; digest |] in let frames = [|0 .. \
        payloads.Length - 1|] |> Array.collect frameBytes in let envelopeBody = Array.concat [| \
        [|69uy;82uy;80uy;82uy|]; lengthBytes payloads.Length; System.Security.Cryptography.SHA256.HashData(System.Text\
        .Encoding.UTF8.GetBytes(!tree_identity)); System.BitConverter.GetBytes(!expected_version); frames |] in let \
        rootDigest = System.Security.Cryptography.SHA256.HashData(envelopeBody) in let envelope = Array.concat [| \
        envelopeBody; rootDigest |] in let oldBytes = System.Text.Encoding.UTF8.GetBytes(\"previous-committed-envelope\
        \") in let writeDurable path bytes = use stream = new System.IO.FileStream(path,System.IO.FileMode.CreateNew,S\
        ystem.IO.FileAccess.Write,System.IO.FileShare.None,4096,System.IO.FileOptions.WriteThrough) in \
        stream.Write(bytes,0,bytes.Length); stream.Flush(true) in let runSync path = let info = new \
        System.Diagnostics.ProcessStartInfo() in info.FileName <- \"/usr/bin/sync\"; info.UseShellExecute <- false; \
        info.ArgumentList.Add(\"-f\"); info.ArgumentList.Add(path); use process = \
        System.Diagnostics.Process.Start(info) in let completed = process.WaitForExit(5000) in let _ = if not \
        completed then (process.Kill(true); process.WaitForExit() |> ignore) else () in if completed then int64 \
        process.ExitCode else -2L in let validateEnvelope (data : byte array) = try let readLength offset = \
        System.BitConverter.ToInt32(data,offset) |> System.Net.IPAddress.NetworkToHostOrder in if data.Length < 80 || \
        data.[0] <> 69uy || data.[1] <> 82uy || data.[2] <> 80uy || data.[3] <> 82uy then false else let count = \
        readLength 4 in let storedTreeIdentityHash = data.[8 .. 39] in let expectedTreeIdentityHash = \
        System.Security.Cryptography.SHA256.HashData(System.Text.Encoding.UTF8.GetBytes(!tree_identity)) in let \
        storedVersion = System.BitConverter.ToInt64(data,40) in let mutable offset = 48 in let mutable index = 0 in \
        let mutable valid = count > 0 && System.Linq.Enumerable.SequenceEqual(storedTreeIdentityHash,expectedTreeIdent\
        ityHash) && storedVersion = !expected_version in while valid && index < count do if offset + 4 > data.Length \
        then valid <- false else let payloadLength = readLength offset in offset <- offset + 4; if payloadLength < 0 \
        || offset + payloadLength + 4 + 32 > data.Length then valid <- false else let payload = data.[offset .. \
        offset + payloadLength - 1] in offset <- offset + payloadLength; let messageLength = readLength offset in \
        offset <- offset + 4; if messageLength < 0 || offset + messageLength + 32 > data.Length then valid <- false \
        else let message = data.[offset .. offset + messageLength - 1] in offset <- offset + messageLength; let \
        digest = data.[offset .. offset + 31] in offset <- offset + 32; if not \
        (System.Linq.Enumerable.SequenceEqual(System.Security.Cryptography.SHA256.HashData(Array.concat [| payload; \
        message; System.BitConverter.GetBytes(index); System.BitConverter.GetBytes(count) |]),digest)) then valid <- \
        false else index <- index + 1 done; if valid && index = count && offset + 32 = data.Length then let \
        rootDigest = data.[offset .. offset + 31] in let bodyDigest = \
        System.Security.Cryptography.SHA256.HashData(data.[0 .. offset - 1]) in \
        System.Linq.Enumerable.SequenceEqual(bodyDigest,rootDigest) else false with _ -> false in let \
        reopenedFramesMatchExpected (data : byte array) = try let readLength offset = \
        System.BitConverter.ToInt32(data,offset) |> System.Net.IPAddress.NetworkToHostOrder in let count = readLength \
        4 in let mutable offset = 48 in let mutable index = 0 in let mutable valid = count = payloads.Length in while \
        valid && index < count do if offset + 4 > data.Length then valid <- false else let payloadLength = readLength \
        offset in offset <- offset + 4; if payloadLength < 0 || offset + payloadLength + 4 + 32 > data.Length then \
        valid <- false else let payload = data.[offset .. offset + payloadLength - 1] in offset <- offset + \
        payloadLength; let messageLength = readLength offset in offset <- offset + 4; if messageLength < 0 || offset \
        + messageLength + 32 > data.Length then valid <- false else let message = data.[offset .. offset + \
        messageLength - 1] in offset <- offset + messageLength; if not \
        (System.Linq.Enumerable.SequenceEqual(payload,payloads.[index])) || not \
        (System.Linq.Enumerable.SequenceEqual(message,messages.[index])) then valid <- false else (offset <- offset + \
        32; index <- index + 1) done; valid && index = count && offset + 32 = data.Length with _ -> false in let \
        beforePrepared = System.IO.Path.Combine(beforeDirectory,\"commit.prepared\") in let beforeCommitted = \
        System.IO.Path.Combine(beforeDirectory,\"commit.committed\") in writeDurable beforeCommitted oldBytes; \
        writeDurable beforePrepared envelope; let beforePreparedPresent = if System.IO.File.Exists(beforePrepared) \
        then 1L else 0L in let beforeOldPreserved = if System.Linq.Enumerable.SequenceEqual(System.IO.File.ReadAllByte\
        s(beforeCommitted),oldBytes) then 1L else 0L in System.IO.File.Delete(beforePrepared); let \
        beforePreparedRemoved = if System.IO.File.Exists(beforePrepared) then 0L else 1L in let beforeSync = runSync \
        beforeDirectory in let afterPrepared = System.IO.Path.Combine(afterDirectory,\"commit.prepared\") in let \
        afterCommitted = System.IO.Path.Combine(afterDirectory,\"commit.committed\") in writeDurable afterCommitted \
        oldBytes; writeDurable afterPrepared envelope; System.IO.File.Move(afterPrepared,afterCommitted,true); let \
        afterSync = runSync afterDirectory in let afterRecovered = System.IO.File.ReadAllBytes(afterCommitted) in let \
        afterPreparedAbsent = if System.IO.File.Exists(afterPrepared) then 0L else 1L in let afterNewRecovered = if \
        System.Linq.Enumerable.SequenceEqual(afterRecovered,envelope) then 1L else 0L in let afterEnvelopeValid = if \
        validateEnvelope afterRecovered then 1L else 0L in let afterFramesBound = if afterEnvelopeValid = 1L && \
        reopenedFramesMatchExpected afterRecovered then 1L else 0L in let afterFrameCount = if afterEnvelopeValid = \
        1L then int64 payloads.Length else 0L in System.IO.Directory.Delete(root,true); let cleanupAbsent = if \
        System.IO.Directory.Exists(root) then 0L else 1L in afterFramesBound,countBound,beforePreparedPresent,beforeOl\
        dPreserved,beforePreparedRemoved,beforeSync,afterPreparedAbsent,afterNewRecovered,afterEnvelopeValid,afterFram\
        eCount,afterSync,cleanupAbsent)"

:= erp_p2p_recursive_atomic_payload_outbox_recovery \* version from to.
    (tree : erp_p2p_event_commit_tree version from to) :
    i64 * i64 * i64 * i64 * i64 * i64 * i64 * i64 * i64 * i64 * i64 * i64 =
    ?= erp_p2p_event_commit_tree_physical_authority tree ?|
    | erp_p2p_event_commit_physical_authority
        (_, payload_sequence, outbox_sequence, authority_identity) =>
        := version_witness = erp_p2p_event_commit_tree_version tree
        erp_p2p_recursive_atomic_payload_outbox_recovery_runtime
            payload_sequence outbox_sequence authority_identity
            (runtime_money_nat_to_i64 version_witness)

:= assert_erp_p2p_recursive_atomic_payload_outbox_recovery_runtime
    (expected_version : i64)
    (reopened_frame_bound : i64) (count_bound : i64) (before_prepared_present : i64)
    (before_old_preserved : i64) (before_prepared_removed : i64)
    (before_sync : i64) (after_prepared_absent : i64)
    (after_new_recovered : i64) (after_envelope_valid : i64)
    (after_frame_count : i64) (after_sync : i64) (cleanup_absent : i64)
    : ()
    =
    := ok_0 = !!!!EQ(reopened_frame_bound, 1i64)
    := ok_1 = !!!!EQ(count_bound, 1i64)
    := ok_2 = !!!!EQ(before_prepared_present, 1i64)
    := ok_3 = !!!!EQ(before_old_preserved, 1i64)
    := ok_4 = !!!!EQ(before_prepared_removed, 1i64)
    := ok_5 = !!!!EQ(before_sync, 0i64)
    := ok_6 = !!!!EQ(after_prepared_absent, 1i64)
    := ok_7 = !!!!EQ(after_new_recovered, 1i64)
    := ok_8 = !!!!EQ(after_envelope_valid, 1i64)
    := ok_9 = !!!!EQ(after_frame_count, expected_version)
    := ok_10 = !!!!EQ(after_sync, 0i64)
    := ok_11 = !!!!EQ(cleanup_absent, 1i64)
    ? ok_0 && ok_1 && ok_2 && ok_3 && ok_4 && ok_5 && ok_6 && ok_7 && ok_8 && ok_9 && ok_10 && ok_11
    ?> ()
    |: mega_runtime_fail "erp-p2p-recursive-atomic-payload-outbox-recovery-runtime-mismatch"

:! erp_p2p_recursive_recovery_receipt version from to =
    runtime_money_nat version * erp_p2p_reopened_recovery_authority version from to * string

:= erp_p2p_recursive_recovery_receipt_from_physical \* version from to.
    (tree : erp_p2p_event_commit_tree version from to)
    :
        erp_p2p_recursive_recovery_receipt version from to
    =
    := version_witness = erp_p2p_event_commit_tree_version tree
    := expected_version = runtime_money_nat_to_i64 version_witness
    := reopened_frame_bound
        , count_bound, before_prepared_present, before_old_preserved, before_prepared_removed, before_sync,
        after_prepared_absent, after_new_recovered, after_envelope_valid, after_frame_count, after_sync, cleanup_absent
        =
        erp_p2p_recursive_atomic_payload_outbox_recovery tree
    := _ =
        assert_erp_p2p_recursive_atomic_payload_outbox_recovery_runtime
            expected_version
            reopened_frame_bound count_bound before_prepared_present before_old_preserved
            before_prepared_removed before_sync after_prepared_absent
            after_new_recovered after_envelope_valid after_frame_count after_sync cleanup_absent
    := recovery_authority =
        erp_p2p_reopened_recovery_authority_from_validated_physical
            tree after_envelope_valid after_frame_count
    erp_p2p_recursive_recovery_receipt
        (version_witness, recovery_authority, "reopened-bytes-validated-and-recovery-authority-promoted")

:= erp_p2p_four_event_recursive_recovery_receipt_from_physical
    ()
    :
        erp_p2p_recursive_recovery_receipt nat_four requisition_drafted goods_partially_received
    =
    := expected_tree = erp_p2p_four_event_commit_tree ()
    := expected_version_witness = erp_p2p_event_commit_tree_version expected_tree
    := expected_version = runtime_money_nat_to_i64 expected_version_witness
    := reopened_frame_bound
        , count_bound, before_prepared_present, before_old_preserved, before_prepared_removed, before_sync,
        after_prepared_absent, after_new_recovered, after_envelope_valid, after_frame_count, after_sync, cleanup_absent
        =
        erp_p2p_recursive_atomic_payload_outbox_recovery expected_tree
    := _ =
        assert_erp_p2p_recursive_atomic_payload_outbox_recovery_runtime
            expected_version
            reopened_frame_bound count_bound before_prepared_present before_old_preserved
            before_prepared_removed before_sync after_prepared_absent
            after_new_recovered after_envelope_valid after_frame_count after_sync cleanup_absent
    := _ = assert_erp_p2p_four_event_validated_reopened_frame_count after_frame_count
    := reopened_tree = erp_p2p_four_event_commit_tree ()
    := reopened_version_witness = erp_p2p_event_commit_tree_version reopened_tree
    := recovery_authority =
        erp_p2p_reopened_recovery_authority_from_validated_physical
            reopened_tree after_envelope_valid after_frame_count
    erp_p2p_recursive_recovery_receipt (
        reopened_version_witness,
        recovery_authority,
        "reopened-four-event-bytes-validated-before-canonical-recovery-authority-reconstruction"
    )

:= erp_p2p_recursive_recovery_receipt_version \* version from to.
    (receipt : erp_p2p_recursive_recovery_receipt version from to) :
    runtime_money_nat version =
    ?= receipt ?|
    | erp_p2p_recursive_recovery_receipt (version_witness, _, _) => version_witness

:= erp_p2p_recursive_recovery_receipt_authority \* version from to.
    (receipt : erp_p2p_recursive_recovery_receipt version from to) :
    erp_p2p_reopened_recovery_authority version from to =
    ?= receipt ?|
    | erp_p2p_recursive_recovery_receipt (_, authority, _) => authority

:= erp_p2p_recursive_recovery_receipt_reopened_frame_count \* version from to.
    (receipt : erp_p2p_recursive_recovery_receipt version from to) : i64 =
    := authority = erp_p2p_recursive_recovery_receipt_authority receipt
    erp_p2p_reopened_payload_sequence_count_runtime (
        erp_p2p_reopened_recovery_authority_history authority)

:= erp_p2p_recursive_recovery_receipt_note \* version from to.
    (receipt : erp_p2p_recursive_recovery_receipt version from to) : string =
    ?= receipt ?|
    | erp_p2p_recursive_recovery_receipt (_, _, note) => note

:= erp_p2p_four_event_recursive_atomic_payload_outbox_recovery_terminal () : string =
    := receipt = erp_p2p_four_event_recursive_recovery_receipt_from_physical ()
    := version_witness = erp_p2p_recursive_recovery_receipt_version receipt
    := recovered_version = runtime_money_nat_to_i64 version_witness
    := reopened_authority = erp_p2p_recursive_recovery_receipt_authority receipt
    := reopened_frame_count = erp_p2p_recursive_recovery_receipt_reopened_frame_count receipt
    := _ = assert_erp_p2p_four_event_validated_reopened_frame_count reopened_frame_count
    := reopened_tree = erp_p2p_reopened_recovery_authority_tree reopened_authority
    := reopened_authority_identity =
        erp_p2p_event_commit_authority_physical_identity (
            erp_p2p_event_commit_tree_authority reopened_tree)
    := note = erp_p2p_recursive_recovery_receipt_note receipt
    $"(if !recovered_version <> 4L || !reopened_frame_count <> !recovered_version || not \
        (!reopened_authority_identity.Contains(\"erp-p2p-aggregate:\")) || !note <> \
        \"reopened-four-event-bytes-validated-before-canonical-recovery-authority-reconstruction\" then failwith \
        \"erp-p2p-recursive-recovery-receipt-mismatch\")"
    "the-physical-recovery-receipt-now-carries-one-version-indexed-recovery-authority-whose-history-store-outbox-an"
    ^^ "d-counts-are-derived-from-the-same-validated-tree-after-the-reopened-envelope-validates-while-field-complete-b"
    ^^ "yte-only-tree-reconstruction-remains-open"

:= erp_p2p_recursive_external_crash_recovery_runtime
    (payload_sequence : string) (outbox_sequence : string)
    (tree_identity : string) (expected_version : i64) :
    i64 * i64 * i64 * i64 * i64 * i64 * i64 * i64 * i64 * i64 * i64 * i64 * i64 * i64 =
    $"(let root = System.IO.Path.Combine(System.IO.Path.GetTempPath(), \"spiral-erp-external-recovery-\" + \
        System.Guid.NewGuid().ToString(\"N\")) in let beforeDirectory = System.IO.Path.Combine(root, \
        \"before-rename\") in let afterDirectory = System.IO.Path.Combine(root, \"after-rename\") in let _ = \
        System.IO.Directory.CreateDirectory(beforeDirectory) in let _ = \
        System.IO.Directory.CreateDirectory(afterDirectory) in let payloadTexts = !payload_sequence.Split([|'|'|], \
        System.StringSplitOptions.RemoveEmptyEntries) in let messageTexts = !outbox_sequence.Split([|'|'|], \
        System.StringSplitOptions.RemoveEmptyEntries) in let payloads = payloadTexts |> Array.map \
        System.Convert.FromBase64String in let messages = messageTexts |> Array.map \
        System.Text.Encoding.UTF8.GetBytes in let countBound = if payloads.Length = messages.Length && int64 \
        payloads.Length = !expected_version && payloads.Length > 0 then 1L else 0L in let lengthBytes (count : int) = \
        System.BitConverter.GetBytes(System.Net.IPAddress.HostToNetworkOrder(count)) in let frameBytes index = let \
        payload = payloads.[index] in let message = messages.[index] in let digest = \
        System.Security.Cryptography.SHA256.HashData(Array.concat [| payload; message; \
        System.BitConverter.GetBytes(index); System.BitConverter.GetBytes(payloads.Length) |]) in Array.concat [| \
        lengthBytes payload.Length; payload; lengthBytes message.Length; message; digest |] in let frames = [|0 .. \
        payloads.Length - 1|] |> Array.collect frameBytes in let envelopeBody = Array.concat [| \
        [|69uy;82uy;80uy;82uy|]; lengthBytes payloads.Length; System.Security.Cryptography.SHA256.HashData(System.Text\
        .Encoding.UTF8.GetBytes(!tree_identity)); System.BitConverter.GetBytes(!expected_version); frames |] in let \
        rootDigest = System.Security.Cryptography.SHA256.HashData(envelopeBody) in let envelope = Array.concat [| \
        envelopeBody; rootDigest |] in let oldBytes = System.Text.Encoding.UTF8.GetBytes(\"previous-external-committed\
        -envelope\") in let writeDurable path bytes = use stream = new \
        System.IO.FileStream(path,System.IO.FileMode.CreateNew,System.IO.FileAccess.Write,System.IO.FileShare.None,409\
        6,System.IO.FileOptions.WriteThrough) in stream.Write(bytes,0,bytes.Length); stream.Flush(true) in let \
        runSync path = let info = new System.Diagnostics.ProcessStartInfo() in info.FileName <- \"/usr/bin/sync\"; \
        info.UseShellExecute <- false; info.ArgumentList.Add(\"-f\"); info.ArgumentList.Add(path); use process = \
        System.Diagnostics.Process.Start(info) in let completed = process.WaitForExit(5000) in let _ = if not \
        completed then (process.Kill(true); process.WaitForExit() |> ignore) else () in if completed then int64 \
        process.ExitCode else -2L in let validateEnvelope (data : byte array) = try let readLength offset = \
        System.BitConverter.ToInt32(data,offset) |> System.Net.IPAddress.NetworkToHostOrder in if data.Length < 80 || \
        data.[0] <> 69uy || data.[1] <> 82uy || data.[2] <> 80uy || data.[3] <> 82uy then false else let count = \
        readLength 4 in let storedTreeIdentityHash = data.[8 .. 39] in let expectedTreeIdentityHash = \
        System.Security.Cryptography.SHA256.HashData(System.Text.Encoding.UTF8.GetBytes(!tree_identity)) in let \
        storedVersion = System.BitConverter.ToInt64(data,40) in let mutable offset = 48 in let mutable index = 0 in \
        let mutable valid = count > 0 && System.Linq.Enumerable.SequenceEqual(storedTreeIdentityHash,expectedTreeIdent\
        ityHash) && storedVersion = !expected_version in while valid && index < count do if offset + 4 > data.Length \
        then valid <- false else let payloadLength = readLength offset in offset <- offset + 4; if payloadLength < 0 \
        || offset + payloadLength + 4 + 32 > data.Length then valid <- false else let payload = data.[offset .. \
        offset + payloadLength - 1] in offset <- offset + payloadLength; let messageLength = readLength offset in \
        offset <- offset + 4; if messageLength < 0 || offset + messageLength + 32 > data.Length then valid <- false \
        else let message = data.[offset .. offset + messageLength - 1] in offset <- offset + messageLength; let \
        digest = data.[offset .. offset + 31] in offset <- offset + 32; if not \
        (System.Linq.Enumerable.SequenceEqual(System.Security.Cryptography.SHA256.HashData(Array.concat [| payload; \
        message; System.BitConverter.GetBytes(index); System.BitConverter.GetBytes(count) |]),digest)) then valid <- \
        false else index <- index + 1 done; if valid && index = count && offset + 32 = data.Length then let \
        rootDigest = data.[offset .. offset + 31] in let bodyDigest = \
        System.Security.Cryptography.SHA256.HashData(data.[0 .. offset - 1]) in \
        System.Linq.Enumerable.SequenceEqual(bodyDigest,rootDigest) else false with _ -> false in let startChild \
        script (arguments : string array) = let info = new System.Diagnostics.ProcessStartInfo() in info.FileName <- \
        \"/bin/sh\"; info.UseShellExecute <- false; info.ArgumentList.Add(\"-c\"); info.ArgumentList.Add(script); \
        info.ArgumentList.Add(\"erp-child\"); arguments |> Array.iter (fun value -> info.ArgumentList.Add(value)); \
        System.Diagnostics.Process.Start(info) in let waitMarker path = let mutable attempts = 0 in while attempts < \
        200 && not (System.IO.File.Exists(path)) do System.Threading.Thread.Sleep(25); attempts <- attempts + 1 done; \
        System.IO.File.Exists(path) in let stopChild (process : System.Diagnostics.Process) = if process.HasExited \
        then 0L else (process.Kill(true); process.WaitForExit(); 1L) in let beforeSource = \
        System.IO.Path.Combine(beforeDirectory,\"source.envelope\") in let beforePrepared = \
        System.IO.Path.Combine(beforeDirectory,\"commit.prepared\") in let beforeCommitted = \
        System.IO.Path.Combine(beforeDirectory,\"commit.committed\") in let beforeMarker = \
        System.IO.Path.Combine(beforeDirectory,\"child.ready\") in writeDurable beforeSource envelope; writeDurable \
        beforeCommitted oldBytes; let beforeScript = \"/bin/cp \\\"$1\\\" \\\"$2\\\"; /usr/bin/sync -f \\\"$2\\\"; \
        /usr/bin/touch \\\"$3\\\"; /usr/bin/sleep 30\" in use beforeChild = startChild beforeScript \
        [|beforeSource;beforePrepared;beforeMarker|] in let beforeReady = if waitMarker beforeMarker then 1L else 0L \
        in let beforeKilled = if beforeReady = 1L then stopChild beforeChild else 0L in let beforeOldPreserved = if \
        System.Linq.Enumerable.SequenceEqual(System.IO.File.ReadAllBytes(beforeCommitted),oldBytes) then 1L else 0L \
        in let _ = if System.IO.File.Exists(beforePrepared) then System.IO.File.Delete(beforePrepared) else () in let \
        _ = if System.IO.File.Exists(beforeMarker) then System.IO.File.Delete(beforeMarker) else () in let \
        beforePreparedRemoved = if System.IO.File.Exists(beforePrepared) then 0L else 1L in let beforeSync = runSync \
        beforeDirectory in let afterSource = System.IO.Path.Combine(afterDirectory,\"source.envelope\") in let \
        afterPrepared = System.IO.Path.Combine(afterDirectory,\"commit.prepared\") in let afterCommitted = \
        System.IO.Path.Combine(afterDirectory,\"commit.committed\") in let afterMarker = \
        System.IO.Path.Combine(afterDirectory,\"child.ready\") in writeDurable afterSource envelope; writeDurable \
        afterCommitted oldBytes; let afterScript = \"/bin/cp \\\"$1\\\" \\\"$2\\\"; /usr/bin/sync -f \\\"$2\\\"; \
        /bin/mv -f \\\"$2\\\" \\\"$3\\\"; /usr/bin/sync -f \\\"$4\\\"; /usr/bin/touch \\\"$5\\\"; /usr/bin/sleep 30\" \
        in use afterChild = startChild afterScript [|afterSource;afterPrepared;afterCommitted;afterDirectory;afterMark\
        er|] in let afterReady = if waitMarker afterMarker then 1L else 0L in let afterKilled = if afterReady = 1L \
        then stopChild afterChild else 0L in let afterRecovered = System.IO.File.ReadAllBytes(afterCommitted) in let \
        afterNewRecovered = if System.Linq.Enumerable.SequenceEqual(afterRecovered,envelope) then 1L else 0L in let \
        afterEnvelopeValid = if validateEnvelope afterRecovered then 1L else 0L in let afterFrameCount = if \
        afterEnvelopeValid = 1L then int64 payloads.Length else 0L in let afterSync = runSync afterDirectory in \
        System.IO.Directory.Delete(root,true); let cleanupAbsent = if System.IO.Directory.Exists(root) then 0L else \
        1L in int64 envelope.Length,countBound,beforeReady,beforeKilled,beforeOldPreserved,beforePreparedRemoved,befor\
        eSync,afterReady,afterKilled,afterNewRecovered,afterEnvelopeValid,afterFrameCount,afterSync,cleanupAbsent)"

:= erp_p2p_recursive_external_crash_recovery \* version from to.
    (tree : erp_p2p_event_commit_tree version from to) :
    i64 * i64 * i64 * i64 * i64 * i64 * i64 * i64 * i64 * i64 * i64 * i64 * i64 * i64 =
    ?= erp_p2p_event_commit_tree_physical_authority tree ?|
    | erp_p2p_event_commit_physical_authority
        (_, payload_sequence, outbox_sequence, authority_identity) =>
        := version_witness = erp_p2p_event_commit_tree_version tree
        erp_p2p_recursive_external_crash_recovery_runtime
            payload_sequence outbox_sequence authority_identity (runtime_money_nat_to_i64 version_witness)

:= assert_erp_p2p_recursive_external_crash_recovery_runtime
    (bytes : i64) (count_bound : i64) (before_ready : i64)
    (before_killed : i64) (before_old_preserved : i64)
    (before_prepared_removed : i64) (before_sync : i64)
    (after_ready : i64) (after_killed : i64)
    (after_new_recovered : i64) (after_envelope_valid : i64)
    (after_frame_count : i64) (after_sync : i64) (cleanup_absent : i64)
    : ()
    =
    := ok_0 = !!!!GT(bytes, 0i64)
    := ok_1 = !!!!EQ(count_bound, 1i64)
    := ok_2 = !!!!EQ(before_ready, 1i64)
    := ok_3 = !!!!EQ(before_killed, 1i64)
    := ok_4 = !!!!EQ(before_old_preserved, 1i64)
    := ok_5 = !!!!EQ(before_prepared_removed, 1i64)
    := ok_6 = !!!!EQ(before_sync, 0i64)
    := ok_7 = !!!!EQ(after_ready, 1i64)
    := ok_8 = !!!!EQ(after_killed, 1i64)
    := ok_9 = !!!!EQ(after_new_recovered, 1i64)
    := ok_10 = !!!!EQ(after_envelope_valid, 1i64)
    := ok_11 = !!!!EQ(after_frame_count, 4i64)
    := ok_12 = !!!!EQ(after_sync, 0i64)
    := ok_13 = !!!!EQ(cleanup_absent, 1i64)
    ? ok_0 && ok_1 && ok_2 && ok_3 && ok_4 && ok_5 && ok_6 && ok_7 && ok_8 && ok_9 && ok_10 && ok_11 && ok_12 && ok_13
    ?> ()
    |: mega_runtime_fail "erp-p2p-recursive-external-crash-recovery-runtime-mismatch"

:! erp_p2p_external_crash_recovery_receipt version from to =
    runtime_money_nat version *
    erp_p2p_event_commit_authority version from to *
    i64 * string

:= erp_p2p_external_crash_recovery_receipt_from_physical \* version from to.
    (tree : erp_p2p_event_commit_tree version from to)
    :
        erp_p2p_external_crash_recovery_receipt version from to
    =
    := version_witness = erp_p2p_event_commit_tree_version tree
    := bytes
        , count_bound, before_ready, before_killed, before_old_preserved, before_prepared_removed, before_sync,
        after_ready, after_killed, after_new_recovered, after_envelope_valid, after_frame_count, after_sync,
        cleanup_absent
        =
        erp_p2p_recursive_external_crash_recovery tree
    := _ =
        assert_erp_p2p_recursive_external_crash_recovery_runtime
            bytes count_bound before_ready before_killed before_old_preserved
            before_prepared_removed before_sync after_ready after_killed
            after_new_recovered after_envelope_valid after_frame_count after_sync cleanup_absent
    := authority = erp_p2p_event_commit_tree_authority tree
    erp_p2p_external_crash_recovery_receipt (
        version_witness,
        authority,
        after_frame_count,
        "external-crash-reopened-bytes-validated-and-typed-authority-promoted"
    )

:= erp_p2p_external_crash_recovery_receipt_validate \* version from to.
    (receipt : erp_p2p_external_crash_recovery_receipt version from to) :
    runtime_money_nat version * erp_p2p_event_commit_authority version from to =
    ?= receipt ?|
    | erp_p2p_external_crash_recovery_receipt (version_witness, authority, reopened_frame_count, note) =>
        := recovered_version = runtime_money_nat_to_i64 version_witness
        := authority_identity = erp_p2p_event_commit_authority_physical_identity authority
        := _ : () =
            $"(if !reopened_frame_count <> !recovered_version || not \
                (!authority_identity.Contains(\"erp-p2p-aggregate:\")) || !note <> \
                \"external-crash-reopened-bytes-validated-and-typed-authority-promoted\" then failwith \
                \"erp-p2p-external-crash-recovery-receipt-mismatch\")"
        version_witness, authority

:= erp_p2p_four_event_recursive_external_crash_recovery_terminal () : string =
    := tree = erp_p2p_four_event_commit_tree ()
    := receipt = erp_p2p_external_crash_recovery_receipt_from_physical tree
    := version_witness, authority = erp_p2p_external_crash_recovery_receipt_validate receipt
    := recovered_version = runtime_money_nat_to_i64 version_witness
    := _ = erp_p2p_event_commit_authority_physical_identity authority
    $"(if !recovered_version <> 4L then failwith \"erp-p2p-external-crash-recovery-version-mismatch\")"
    "the-external-crash-recovery-receipt-now-carries-and-consumes-the-version-and-endpoint-indexed-commit-authority"
    ^^ "-produced-only-after-the-reopened-envelope-validates-while-field-complete-byte-only-tree-reconstruction-remain"
    ^^ "s-open"

:= erp_p2p_recursive_wal_recovery_runtime
    (payload_sequence : string) (outbox_sequence : string)
    (tree_identity : string) (expected_version : i64) :
    i64 * i64 * i64 * i64 * i64 * i64 * i64 * i64 * i64 * i64 * i64 * i64 * i64 * i64 * i64 * i64 =
    $"(let root = System.IO.Path.Combine(System.IO.Path.GetTempPath(), \"spiral-erp-wal-recovery-\" + \
        System.Guid.NewGuid().ToString(\"N\")) in let preparedDirectory = System.IO.Path.Combine(root, \
        \"prepared-phase\") in let committedDirectory = System.IO.Path.Combine(root, \"committed-phase\") in let _ = \
        System.IO.Directory.CreateDirectory(preparedDirectory) in let _ = \
        System.IO.Directory.CreateDirectory(committedDirectory) in let payloadTexts = \
        !payload_sequence.Split([|'|'|], System.StringSplitOptions.RemoveEmptyEntries) in let messageTexts = \
        !outbox_sequence.Split([|'|'|], System.StringSplitOptions.RemoveEmptyEntries) in let payloads = payloadTexts \
        |> Array.map System.Convert.FromBase64String in let messages = messageTexts |> Array.map \
        System.Text.Encoding.UTF8.GetBytes in let countBound = if payloads.Length = messages.Length && int64 \
        payloads.Length = !expected_version && payloads.Length > 0 then 1L else 0L in let lengthBytes (count : int) = \
        System.BitConverter.GetBytes(System.Net.IPAddress.HostToNetworkOrder(count)) in let frameBytes index = let \
        payload = payloads.[index] in let message = messages.[index] in let digest = \
        System.Security.Cryptography.SHA256.HashData(Array.concat [| payload; message; \
        System.BitConverter.GetBytes(index); System.BitConverter.GetBytes(payloads.Length) |]) in Array.concat [| \
        lengthBytes payload.Length; payload; lengthBytes message.Length; message; digest |] in let frames = [|0 .. \
        payloads.Length - 1|] |> Array.collect frameBytes in let envelopeBody = Array.concat [| \
        [|69uy;82uy;80uy;82uy|]; lengthBytes payloads.Length; System.Security.Cryptography.SHA256.HashData(System.Text\
        .Encoding.UTF8.GetBytes(!tree_identity)); System.BitConverter.GetBytes(!expected_version); frames |] in let \
        rootDigest = System.Security.Cryptography.SHA256.HashData(envelopeBody) in let envelope = Array.concat [| \
        envelopeBody; rootDigest |] in let envelopeDigest = System.Convert.ToHexString(System.Security.Cryptography.SH\
        A256.HashData(envelope)) in let oldBytes = System.Text.Encoding.UTF8.GetBytes(\"previous-wal-committed-envelop\
        e\") in let writeDurable path bytes = use stream = new System.IO.FileStream(path,System.IO.FileMode.Create,Sys\
        tem.IO.FileAccess.Write,System.IO.FileShare.None,4096,System.IO.FileOptions.WriteThrough) in \
        stream.Write(bytes,0,bytes.Length); stream.Flush(true) in let writeText path (text : string) = writeDurable \
        path (System.Text.Encoding.UTF8.GetBytes(text)) in let runSync path = let info = new \
        System.Diagnostics.ProcessStartInfo() in info.FileName <- \"/usr/bin/sync\"; info.UseShellExecute <- false; \
        info.ArgumentList.Add(\"-f\"); info.ArgumentList.Add(path); use process = \
        System.Diagnostics.Process.Start(info) in let completed = process.WaitForExit(5000) in let _ = if not \
        completed then (process.Kill(true); process.WaitForExit() |> ignore) else () in if completed then int64 \
        process.ExitCode else -2L in let validateEnvelope (data : byte array) = try let readLength offset = \
        System.BitConverter.ToInt32(data,offset) |> System.Net.IPAddress.NetworkToHostOrder in if data.Length < 80 || \
        data.[0] <> 69uy || data.[1] <> 82uy || data.[2] <> 80uy || data.[3] <> 82uy then false else let count = \
        readLength 4 in let storedTreeIdentityHash = data.[8 .. 39] in let expectedTreeIdentityHash = \
        System.Security.Cryptography.SHA256.HashData(System.Text.Encoding.UTF8.GetBytes(!tree_identity)) in let \
        storedVersion = System.BitConverter.ToInt64(data,40) in let mutable offset = 48 in let mutable index = 0 in \
        let mutable valid = count > 0 && System.Linq.Enumerable.SequenceEqual(storedTreeIdentityHash,expectedTreeIdent\
        ityHash) && storedVersion = !expected_version in while valid && index < count do if offset + 4 > data.Length \
        then valid <- false else let payloadLength = readLength offset in offset <- offset + 4; if payloadLength < 0 \
        || offset + payloadLength + 4 + 32 > data.Length then valid <- false else let payload = data.[offset .. \
        offset + payloadLength - 1] in offset <- offset + payloadLength; let messageLength = readLength offset in \
        offset <- offset + 4; if messageLength < 0 || offset + messageLength + 32 > data.Length then valid <- false \
        else let message = data.[offset .. offset + messageLength - 1] in offset <- offset + messageLength; let \
        digest = data.[offset .. offset + 31] in offset <- offset + 32; if not \
        (System.Linq.Enumerable.SequenceEqual(System.Security.Cryptography.SHA256.HashData(Array.concat [| payload; \
        message; System.BitConverter.GetBytes(index); System.BitConverter.GetBytes(count) |]),digest)) then valid <- \
        false else index <- index + 1 done; if valid && index = count && offset + 32 = data.Length then let \
        rootDigest = data.[offset .. offset + 31] in let bodyDigest = \
        System.Security.Cryptography.SHA256.HashData(data.[0 .. offset - 1]) in \
        System.Linq.Enumerable.SequenceEqual(bodyDigest,rootDigest) else false with _ -> false in let preparedWal = \
        System.IO.Path.Combine(preparedDirectory,\"commit.wal\") in let preparedCandidate = \
        System.IO.Path.Combine(preparedDirectory,\"commit.prepared\") in let preparedCommitted = \
        System.IO.Path.Combine(preparedDirectory,\"commit.committed\") in writeDurable preparedCommitted oldBytes; \
        writeText preparedWal (\"PREPARED:\" + envelopeDigest); writeDurable preparedCandidate envelope; let \
        preparedSync = runSync preparedDirectory in let preparedWalText = System.IO.File.ReadAllText(preparedWal) in \
        let preparedWalSeen = if preparedWalText.StartsWith(\"PREPARED:\") then 1L else 0L in let preparedDigestBound \
        = if preparedWalText = \"PREPARED:\" + envelopeDigest then 1L else 0L in let _ = if \
        System.IO.File.Exists(preparedCandidate) then System.IO.File.Delete(preparedCandidate) else () in let _ = if \
        System.IO.File.Exists(preparedWal) then System.IO.File.Delete(preparedWal) else () in let \
        preparedRecoverySync = runSync preparedDirectory in let preparedCandidateRemoved = if \
        System.IO.File.Exists(preparedCandidate) then 0L else 1L in let preparedOldPreserved = if \
        System.Linq.Enumerable.SequenceEqual(System.IO.File.ReadAllBytes(preparedCommitted),oldBytes) then 1L else 0L \
        in let preparedWalCleared = if System.IO.File.Exists(preparedWal) then 0L else 1L in let committedWal = \
        System.IO.Path.Combine(committedDirectory,\"commit.wal\") in let committedCandidate = \
        System.IO.Path.Combine(committedDirectory,\"commit.prepared\") in let committedPath = \
        System.IO.Path.Combine(committedDirectory,\"commit.committed\") in writeDurable committedPath oldBytes; \
        writeText committedWal (\"PREPARED:\" + envelopeDigest); writeDurable committedCandidate envelope; \
        System.IO.File.Move(committedCandidate,committedPath,true); writeText committedWal (\"COMMITTED:\" + \
        envelopeDigest); let committedSync = runSync committedDirectory in let committedWalText = \
        System.IO.File.ReadAllText(committedWal) in let committedWalSeen = if \
        committedWalText.StartsWith(\"COMMITTED:\") then 1L else 0L in let committedDigestBound = if committedWalText \
        = \"COMMITTED:\" + envelopeDigest then 1L else 0L in let committedRecovered = \
        System.IO.File.ReadAllBytes(committedPath) in let committedNewRecovered = if \
        System.Linq.Enumerable.SequenceEqual(committedRecovered,envelope) then 1L else 0L in let \
        committedEnvelopeValid = if validateEnvelope committedRecovered then 1L else 0L in let frameCount = if \
        committedEnvelopeValid = 1L then int64 payloads.Length else 0L in let _ = if \
        System.IO.File.Exists(committedWal) then System.IO.File.Delete(committedWal) else () in let \
        committedRecoverySync = runSync committedDirectory in let committedWalCleared = if \
        System.IO.File.Exists(committedWal) then 0L else 1L in System.IO.Directory.Delete(root,true); let \
        cleanupAbsent = if System.IO.Directory.Exists(root) then 0L else 1L in int64 \
        envelope.Length,countBound,preparedWalSeen,preparedDigestBound,preparedCandidateRemoved,preparedOldPreserved,p\
        reparedWalCleared,preparedSync,preparedRecoverySync,committedWalSeen,committedDigestBound,committedNewRecovere\
        d,committedEnvelopeValid,frameCount,committedWalCleared,cleanupAbsent)"

:= erp_p2p_recursive_wal_recovery \* version from to.
    (tree : erp_p2p_event_commit_tree version from to) :
    i64 * i64 * i64 * i64 * i64 * i64 * i64 * i64 * i64 * i64 * i64 * i64 * i64 * i64 * i64 * i64 =
    ?= erp_p2p_event_commit_tree_physical_authority tree ?|
    | erp_p2p_event_commit_physical_authority
        (_, payload_sequence, outbox_sequence, authority_identity) =>
        := version_witness = erp_p2p_event_commit_tree_version tree
        erp_p2p_recursive_wal_recovery_runtime
            payload_sequence outbox_sequence authority_identity (runtime_money_nat_to_i64 version_witness)

:= assert_erp_p2p_recursive_wal_recovery_runtime
    (bytes : i64) (count_bound : i64) (prepared_wal_seen : i64)
    (prepared_digest_bound : i64) (prepared_candidate_removed : i64)
    (prepared_old_preserved : i64) (prepared_wal_cleared : i64)
    (prepared_sync : i64) (prepared_recovery_sync : i64)
    (committed_wal_seen : i64) (committed_digest_bound : i64)
    (committed_new_recovered : i64) (committed_envelope_valid : i64)
    (frame_count : i64) (committed_wal_cleared : i64) (cleanup_absent : i64)
    : ()
    =
    := ok_0 = !!!!GT(bytes, 0i64)
    := ok_1 = !!!!EQ(count_bound, 1i64)
    := ok_2 = !!!!EQ(prepared_wal_seen, 1i64)
    := ok_3 = !!!!EQ(prepared_digest_bound, 1i64)
    := ok_4 = !!!!EQ(prepared_candidate_removed, 1i64)
    := ok_5 = !!!!EQ(prepared_old_preserved, 1i64)
    := ok_6 = !!!!EQ(prepared_wal_cleared, 1i64)
    := ok_7 = !!!!EQ(prepared_sync, 0i64)
    := ok_8 = !!!!EQ(prepared_recovery_sync, 0i64)
    := ok_9 = !!!!EQ(committed_wal_seen, 1i64)
    := ok_10 = !!!!EQ(committed_digest_bound, 1i64)
    := ok_11 = !!!!EQ(committed_new_recovered, 1i64)
    := ok_12 = !!!!EQ(committed_envelope_valid, 1i64)
    := ok_13 = !!!!EQ(frame_count, 4i64)
    := ok_14 = !!!!EQ(committed_wal_cleared, 1i64)
    := ok_15 = !!!!EQ(cleanup_absent, 1i64)
    ?
        ok_0
        && ok_1
        && ok_2
        && ok_3
        && ok_4
        && ok_5
        && ok_6
        && ok_7
        && ok_8
        && ok_9
        && ok_10
        && ok_11
        && ok_12
        && ok_13
        && ok_14
        && ok_15
    ?> ()
    |: mega_runtime_fail "erp-p2p-recursive-wal-recovery-runtime-mismatch"

:! erp_p2p_recursive_wal_recovery_receipt version from to =
    runtime_money_nat version *
    erp_p2p_event_commit_authority version from to *
    i64 * string

:= erp_p2p_recursive_wal_recovery_receipt_from_physical \* version from to.
    (tree : erp_p2p_event_commit_tree version from to)
    :
        erp_p2p_recursive_wal_recovery_receipt version from to
    =
    := version_witness = erp_p2p_event_commit_tree_version tree
    := bytes
        , count_bound, prepared_wal_seen, prepared_digest_bound, prepared_candidate_removed, prepared_old_preserved,
        prepared_wal_cleared, prepared_sync, prepared_recovery_sync, committed_wal_seen, committed_digest_bound,
        committed_new_recovered, committed_envelope_valid, frame_count, committed_wal_cleared, cleanup_absent
        =
        erp_p2p_recursive_wal_recovery tree
    := _ =
        assert_erp_p2p_recursive_wal_recovery_runtime
            bytes count_bound prepared_wal_seen prepared_digest_bound
            prepared_candidate_removed prepared_old_preserved prepared_wal_cleared
            prepared_sync prepared_recovery_sync committed_wal_seen committed_digest_bound
            committed_new_recovered committed_envelope_valid frame_count committed_wal_cleared cleanup_absent
    := authority = erp_p2p_event_commit_tree_authority tree
    erp_p2p_recursive_wal_recovery_receipt
        (version_witness, authority, frame_count, "wal-reopened-bytes-validated-and-typed-authority-promoted")

:= erp_p2p_recursive_wal_recovery_receipt_validate \* version from to.
    (receipt : erp_p2p_recursive_wal_recovery_receipt version from to) :
    runtime_money_nat version * erp_p2p_event_commit_authority version from to =
    ?= receipt ?|
    | erp_p2p_recursive_wal_recovery_receipt (version_witness, authority, reopened_frame_count, note) =>
        := recovered_version = runtime_money_nat_to_i64 version_witness
        := authority_identity = erp_p2p_event_commit_authority_physical_identity authority
        := _ : () =
            $"(if !reopened_frame_count <> !recovered_version || not \
                (!authority_identity.Contains(\"erp-p2p-aggregate:\")) || !note <> \
                \"wal-reopened-bytes-validated-and-typed-authority-promoted\" then failwith \
                \"erp-p2p-recursive-wal-recovery-receipt-mismatch\")"
        version_witness, authority

:= erp_p2p_four_event_recursive_wal_recovery_terminal () : string =
    := tree = erp_p2p_four_event_commit_tree ()
    := receipt = erp_p2p_recursive_wal_recovery_receipt_from_physical tree
    := version_witness, authority = erp_p2p_recursive_wal_recovery_receipt_validate receipt
    := recovered_version = runtime_money_nat_to_i64 version_witness
    := _ = erp_p2p_event_commit_authority_physical_identity authority
    $"(if !recovered_version <> 4L then failwith \"erp-p2p-recursive-wal-recovery-version-mismatch\")"
    "the-WAL-recovery-receipt-now-routes-generic-count-authority-and-provenance-validation-through-one-reusable-val"
    ^^ "idator-while-the-four-event-terminal-checks-only-its-specific-version-and-field-complete-byte-only-tree-recons"
    ^^ "truction-remains-open"

:= erp_p2p_recoverable_fenced_lock_runtime () :
    i64 * i64 * i64 * i64 * i64 * i64 * i64 * i64 * i64 * i64 * string =
    $"(let root = System.IO.Path.Combine(System.IO.Path.GetTempPath(), \"spiral-erp-fenced-lock-\" + \
        System.Guid.NewGuid().ToString(\"N\")) in let _ = System.IO.Directory.CreateDirectory(root) in let lockPath = \
        System.IO.Path.Combine(root,\"writer.lock\") in let takeoverPath = \
        System.IO.Path.Combine(root,\"writer.takeover\") in let markerPath = \
        System.IO.Path.Combine(root,\"owner-a.ready\") in let commitPath = \
        System.IO.Path.Combine(root,\"commit.owner-b\") in let ownerA = \"owner-a\" in let ownerB = \"owner-b\" in \
        let ownerC = \"owner-c\" in let ownerD = \"owner-d\" in let now () = \
        System.DateTimeOffset.UtcNow.ToUnixTimeMilliseconds() in let leaseExpiry = now() + 250L in let ownerARecord = \
        System.String.Join(\"|\",[|ownerA;\"1\";string leaseExpiry|]) in let writeDurable path (bytes : byte array) = \
        use stream = new System.IO.FileStream(path,System.IO.FileMode.Create,System.IO.FileAccess.Write,System.IO.File\
        Share.None,4096,System.IO.FileOptions.WriteThrough) in stream.Write(bytes,0,bytes.Length); stream.Flush(true) \
        in let runSync path = let info = new System.Diagnostics.ProcessStartInfo() in info.FileName <- \
        \"/usr/bin/sync\"; info.UseShellExecute <- false; info.ArgumentList.Add(\"-f\"); info.ArgumentList.Add(path); \
        use process = System.Diagnostics.Process.Start(info) in let completed = process.WaitForExit(5000) in let _ = \
        if not completed then (process.Kill(true); process.WaitForExit() |> ignore) else () in if completed then \
        int64 process.ExitCode else -2L in let script = \"printf '%s' \\\"$1\\\" > \\\"$2\\\"; /usr/bin/sync -f \
        \\\"$2\\\"; /usr/bin/touch \\\"$3\\\"; /usr/bin/sleep 30\" in let info = new \
        System.Diagnostics.ProcessStartInfo() in info.FileName <- \"/bin/sh\"; info.UseShellExecute <- false; \
        info.ArgumentList.Add(\"-c\"); info.ArgumentList.Add(script); info.ArgumentList.Add(\"erp-owner-a\"); \
        info.ArgumentList.Add(ownerARecord); info.ArgumentList.Add(lockPath); info.ArgumentList.Add(markerPath); use \
        child = System.Diagnostics.Process.Start(info) in let mutable attempts = 0 in while attempts < 200 && not \
        (System.IO.File.Exists(markerPath)) do System.Threading.Thread.Sleep(25); attempts <- attempts + 1 done; let \
        childReady = if System.IO.File.Exists(markerPath) then 1L else 0L in let ownerKilled = if childReady = 1L && \
        not child.HasExited then (child.Kill(true); child.WaitForExit(); 1L) else 0L in while now() <= leaseExpiry do \
        System.Threading.Thread.Sleep(10) done; let currentParts = System.IO.File.ReadAllText(lockPath).Split('|') in \
        let currentFence = System.Int64.Parse(currentParts.[1]) in let currentExpiry = \
        System.Int64.Parse(currentParts.[2]) in let leaseExpired = if now() > currentExpiry then 1L else 0L in let \
        nextFence = currentFence + 1L in let ownerBRecord = System.String.Join(\"|\",[|ownerB;string nextFence;string \
        (now() + 5000L)|]) in writeDurable takeoverPath (System.Text.Encoding.UTF8.GetBytes(ownerBRecord)); \
        System.IO.File.Move(takeoverPath,lockPath,true); let directorySync = runSync root in let installedParts = \
        System.IO.File.ReadAllText(lockPath).Split('|') in let installedFence = \
        System.Int64.Parse(installedParts.[1]) in let fenceAdvanced = if installedFence = 2L && installedFence > \
        currentFence then 1L else 0L in let staleRejected = if installedParts.[0] <> ownerA || installedFence <> 1L \
        then 1L else 0L in let newAccepted = if installedParts.[0] = ownerB && installedFence = 2L then (writeDurable \
        commitPath (System.Text.Encoding.UTF8.GetBytes(\"owner-b-fence-2-commit\")); 1L) else 0L in let \
        ownerBInstalled = if installedParts.[0] = ownerB then 1L else 0L in let committedFenceTwo = if newAccepted = \
        1L && System.IO.File.ReadAllText(commitPath) = \"owner-b-fence-2-commit\" then 1L else 0L in let ownerCFence \
        = installedFence + 1L in let ownerCRecord = System.String.Join(\"|\",[|ownerC;string ownerCFence;string \
        (now() + 5000L)|]) in writeDurable takeoverPath (System.Text.Encoding.UTF8.GetBytes(ownerCRecord)); \
        System.IO.File.Move(takeoverPath,lockPath,true); let ownerCDirectorySync = runSync root in let ownerCParts = \
        System.IO.File.ReadAllText(lockPath).Split('|') in let ownerCFenceInstalled = \
        System.Int64.Parse(ownerCParts.[1]) in let ownerDFence = ownerCFenceInstalled + 1L in let ownerDRecord = \
        System.String.Join(\"|\",[|ownerD;string ownerDFence;string (now() + 5000L)|]) in writeDurable takeoverPath \
        (System.Text.Encoding.UTF8.GetBytes(ownerDRecord)); System.IO.File.Move(takeoverPath,lockPath,true); let \
        ownerDDirectorySync = runSync root in let finalParts = System.IO.File.ReadAllText(lockPath).Split('|') in let \
        finalFence = System.Int64.Parse(finalParts.[1]) in System.IO.Directory.Delete(root,true); let cleanupAbsent = \
        if System.IO.Directory.Exists(root) then 0L else 1L in childReady,ownerKilled,leaseExpired,fenceAdvanced,stale\
        Rejected,newAccepted,ownerBInstalled,committedFenceTwo,(if directorySync = 0L && ownerCDirectorySync = 0L && \
        ownerDDirectorySync = 0L && cleanupAbsent = 1L then 1L else \
        0L),finalFence,System.String.Join(\"|\",[|currentParts.[0];installedParts.[0];ownerCParts.[0];finalParts.[0]|]\
        ))"

:= assert_erp_p2p_recoverable_fenced_lock_runtime
    (child_ready : i64) (owner_killed : i64) (lease_expired : i64)
    (fence_advanced : i64) (stale_rejected : i64) (new_accepted : i64)
    (owner_b_installed : i64) (committed_fence_two : i64) (cleanup_synced : i64)
    : ()
    =
    := ok_0 = !!!!EQ(child_ready, 1i64)
    := ok_1 = !!!!EQ(owner_killed, 1i64)
    := ok_2 = !!!!EQ(lease_expired, 1i64)
    := ok_3 = !!!!EQ(fence_advanced, 1i64)
    := ok_4 = !!!!EQ(stale_rejected, 1i64)
    := ok_5 = !!!!EQ(new_accepted, 1i64)
    := ok_6 = !!!!EQ(owner_b_installed, 1i64)
    := ok_7 = !!!!EQ(committed_fence_two, 1i64)
    := ok_8 = !!!!EQ(cleanup_synced, 1i64)
    ? ok_0 && ok_1 && ok_2 && ok_3 && ok_4 && ok_5 && ok_6 && ok_7 && ok_8
    ?> ()
    |: mega_runtime_fail "erp-p2p-recoverable-fenced-lock-runtime-mismatch"

:= erp_p2p_physical_owner_sequence_count (physical_owner_sequence : string) : i64 =
    $"(let parts = !physical_owner_sequence.Split([|'|'|], System.StringSplitOptions.RemoveEmptyEntries) in int64 \
        parts.Length)"

:= erp_p2p_physical_owner_sequence_at (physical_owner_sequence : string) (index : i64) : string =
    $"(let parts = !physical_owner_sequence.Split([|'|'|], System.StringSplitOptions.RemoveEmptyEntries) in let i = \
        int !index in if i < 0 || i >= parts.Length then failwith \
        \"erp-p2p-physical-owner-sequence-index-out-of-range\" else parts.[i])"

:= assert_erp_p2p_physical_owner_sequence_cardinality (physical_owner_count : i64) (physical_fence : i64) : () =
    := ok_0 = !!!!EQ(physical_owner_count, physical_fence)
    ? ok_0 ?> () |: mega_runtime_fail "erp-p2p-physical-owner-sequence-cardinality-fence-mismatch"

:! erp_p2p_fence_owner fence = string

:! erp_p2p_recoverable_fenced_lock_receipt fence version from to =
    erp_p2p_fence_owner fence *
    erp_p2p_event_store version from to *
    erp_p2p_event_outbox version from to *
    string

:! erp_p2p_validated_recoverable_fenced_lock_authority fence version from to =
    erp_p2p_fence_owner fence *
    erp_p2p_event_store version from to *
    erp_p2p_event_outbox version from to

:= erp_p2p_validated_recoverable_fenced_lock_authority_make \* fence version from to.
    (receipt : erp_p2p_recoverable_fenced_lock_receipt fence version from to) :
    erp_p2p_validated_recoverable_fenced_lock_authority fence version from to =
    ?= receipt ?|
    | erp_p2p_recoverable_fenced_lock_receipt (owner, store, outbox, note) =>
        := store_version = erp_p2p_event_store_length store
        := outbox_version = erp_p2p_event_outbox_length outbox
        := _ : () =
            $"(if !store_version <> !outbox_version || !note <> \"physical-owner-store-outbox-bound-after-fenced-takeo\
                ver\" then failwith \"erp-p2p-recoverable-fenced-lock-receipt-validation-mismatch\")"
        erp_p2p_validated_recoverable_fenced_lock_authority (owner, store, outbox)

:| ^ erp_p2p_fence_history fence =
    | ErpP2PFenceGenesis ::
        string * runtime_money_nat nat_one ->
        erp_p2p_fence_history nat_one
    | ErpP2PFenceTakeover :: \* fence.
        erp_p2p_fence_history fence *
        string *
        runtime_money_nat (nat_succ fence) ->
        erp_p2p_fence_history (nat_succ fence)

:= ^ erp_p2p_fence_history_value \* fence.
    (history : erp_p2p_fence_history fence) : runtime_money_nat fence =
    ?= history ?|
    | ErpP2PFenceGenesis (_, value) => value
    | ErpP2PFenceTakeover (_, _, value) => value

:= ^ erp_p2p_fence_history_owner \* fence.
    (history : erp_p2p_fence_history fence) : string =
    ?= history ?|
    | ErpP2PFenceGenesis (owner, _) => owner
    | ErpP2PFenceTakeover (_, owner, _) => owner

:! erp_p2p_recoverable_fenced_lock_physical_observation =
    i64 * i64 * i64 * i64 * i64 * i64 * i64 * i64 * i64 * i64 * string

:= erp_p2p_fence_history_takeover \* fence.
    (history : erp_p2p_fence_history fence)
    (owner : string) : erp_p2p_fence_history (nat_succ fence) =
    ErpP2PFenceTakeover
        (history, owner, RuntimeMoneySucc (erp_p2p_fence_history_value history))

:| ^ erp_p2p_fence_takeover_program from to =
    | ErpP2PFenceTakeoverProgramOne :: \* fence.
        string ->
        erp_p2p_fence_takeover_program fence (nat_succ fence)
    | ErpP2PFenceTakeoverProgramThen :: \* from to.
        (\? middle.
            erp_p2p_fence_takeover_program from middle *
            erp_p2p_fence_takeover_program middle to) ->
        erp_p2p_fence_takeover_program from to

:= ^ erp_p2p_apply_fence_takeover_program \* from to.
    (history : erp_p2p_fence_history from)
    (program : erp_p2p_fence_takeover_program from to) :
    erp_p2p_fence_history to =
    ?= program ?|
    | ErpP2PFenceTakeoverProgramOne owner =>
        erp_p2p_fence_history_takeover history owner
    | ErpP2PFenceTakeoverProgramThen payload =>
        := \? middle. left, right = payload
        erp_p2p_apply_fence_takeover_program
            (erp_p2p_apply_fence_takeover_program history left)
            right

:| erp_p2p_persisted_fence_restart_receipt before after =
    | ErpP2PPersistedFenceRestart :: \* before.
        erp_p2p_fence_history before *
        erp_p2p_fence_history (nat_succ before) *
        string ->
        erp_p2p_persisted_fence_restart_receipt before (nat_succ before)

:= erp_p2p_persisted_fence_restart_from_history \* fence.
    (history : erp_p2p_fence_history fence)
    (next_owner : string) :
    erp_p2p_persisted_fence_restart_receipt fence (nat_succ fence) =
    := next_history = erp_p2p_fence_history_takeover history next_owner
    ErpP2PPersistedFenceRestart
        (history, next_history, "persisted-fence-reopened-and-successor-derived")

:| ^ erp_p2p_stale_fence stale current =
    | ErpP2PStaleImmediate :: \* fence.
        erp_p2p_stale_fence fence (nat_succ fence)
    | ErpP2PStaleLift :: \* stale current.
        erp_p2p_stale_fence stale current ->
        erp_p2p_stale_fence stale (nat_succ current)

:= ^ erp_p2p_stale_fence_distance \* stale current.
    (proof : erp_p2p_stale_fence stale current) : i64 =
    ?= proof ?|
    | ErpP2PStaleImmediate => 1i64
    | ErpP2PStaleLift previous => runtime_i64_add (erp_p2p_stale_fence_distance previous) 1i64

:= ^ erp_p2p_lift_stale_fence_through_takeover_program \* stale from to.
    (proof : erp_p2p_stale_fence stale from)
    (program : erp_p2p_fence_takeover_program from to) :
    erp_p2p_stale_fence stale to =
    ?= program ?|
    | ErpP2PFenceTakeoverProgramOne _ =>
        ErpP2PStaleLift proof
    | ErpP2PFenceTakeoverProgramThen payload =>
        := \? middle. left, right = payload
        erp_p2p_lift_stale_fence_through_takeover_program
            (erp_p2p_lift_stale_fence_through_takeover_program proof left)
            right

:= ^ erp_p2p_takeover_program_initial_stale \* from to.
    (program : erp_p2p_fence_takeover_program from to) :
    erp_p2p_stale_fence from to =
    ?= program ?|
    | ErpP2PFenceTakeoverProgramOne _ =>
        ErpP2PStaleImmediate
    | ErpP2PFenceTakeoverProgramThen payload =>
        := \? middle. left, right = payload
        erp_p2p_lift_stale_fence_through_takeover_program
            (erp_p2p_takeover_program_initial_stale left)
            right

:| erp_p2p_fence_takeover_execution from to =
    | ErpP2PFenceTakeoverExecution :: \* from to.
        erp_p2p_fence_history to *
        erp_p2p_stale_fence from to ->
        erp_p2p_fence_takeover_execution from to

:= erp_p2p_execute_fence_takeover_program \* from to.
    (history : erp_p2p_fence_history from)
    (program : erp_p2p_fence_takeover_program from to) :
    erp_p2p_fence_takeover_execution from to =
    ErpP2PFenceTakeoverExecution
        (erp_p2p_apply_fence_takeover_program history program,
            erp_p2p_takeover_program_initial_stale program)

:= ^ erp_p2p_fence_takeover_program_owner_sequence \* from to.
    (program : erp_p2p_fence_takeover_program from to) : string =
    ?= program ?|
    | ErpP2PFenceTakeoverProgramOne owner => owner
    | ErpP2PFenceTakeoverProgramThen payload =>
        := \? middle. left, right = payload
        := left_owners = erp_p2p_fence_takeover_program_owner_sequence left
        := right_owners = erp_p2p_fence_takeover_program_owner_sequence right
        $"(!left_owners + \"|\" + !right_owners)"

:= erp_p2p_cross_process_takeover_program_runtime
    (initial_owner : string) (initial_fence : i64)
    (owner_sequence : string)
    (expected_owner : string) (expected_fence : i64) :
    i64 * i64 * i64 * i64 * i64 * i64 * i64 * i64 =
    $"(let root = System.IO.Path.Combine(System.IO.Path.GetTempPath(), \"spiral-erp-cross-process-program-\" + \
        System.Guid.NewGuid().ToString(\"N\")) in let _ = System.IO.Directory.CreateDirectory(root) in let statePath \
        = System.IO.Path.Combine(root, \"fence.state\") in let writeDurable path (text : string) = let bytes = \
        System.Text.Encoding.UTF8.GetBytes(text) in use stream = new \
        System.IO.FileStream(path,System.IO.FileMode.Create,System.IO.FileAccess.Write,System.IO.FileShare.None,4096,S\
        ystem.IO.FileOptions.WriteThrough) in stream.Write(bytes,0,bytes.Length); stream.Flush(true) in writeDurable \
        statePath (System.String.Join(\"|\",[|!initial_owner;string !initial_fence|])); let owners = \
        !owner_sequence.Split([|'|'|], System.StringSplitOptions.RemoveEmptyEntries) in let runOwner (completedCount, \
        allChildren) (owner : string) = let info = new System.Diagnostics.ProcessStartInfo() in info.FileName <- \
        \"/bin/sh\"; info.UseShellExecute <- false; info.ArgumentList.Add(\"-c\"); info.ArgumentList.Add(\"IFS='|' \
        read -r old_owner old_fence < $1; next_fence=$(/usr/bin/expr $old_fence + 1); tmp=$1.next; printf '%s|%s' $2 \
        $next_fence > $tmp; /usr/bin/sync -f $tmp; /bin/mv $tmp $1; /usr/bin/sync -f $1\"); \
        info.ArgumentList.Add(\"erp-fence-program\"); info.ArgumentList.Add(statePath); info.ArgumentList.Add(owner); \
        use child = System.Diagnostics.Process.Start(info) in let completed = child.WaitForExit(5000) in let _ = if \
        not completed then (child.Kill(true); child.WaitForExit() |> ignore) else () in let passed = if completed && \
        child.ExitCode = 0 then 1L else 0L in completedCount + passed, (if passed = 1L && allChildren = 1L then 1L \
        else 0L) in let completedCount, allChildren = owners |> Array.fold runOwner (0L,1L) in let stateParts = if \
        System.IO.File.Exists(statePath) then System.IO.File.ReadAllText(statePath).Split('|') else [||] in let \
        finalOwnerMatch = if stateParts.Length = 2 && stateParts.[0] = !expected_owner then 1L else 0L in let \
        finalFenceValue = if stateParts.Length = 2 then System.Int64.Parse(stateParts.[1]) else 0L in let \
        finalFenceMatch = if finalFenceValue = !expected_fence then 1L else 0L in let expectedSteps = !expected_fence \
        - !initial_fence in let processCountBound = if int64 owners.Length = expectedSteps && completedCount = \
        expectedSteps then 1L else 0L in let staleRejected = if !initial_fence < finalFenceValue then 1L else 0L in \
        let currentAccepted = if finalFenceValue = !expected_fence then 1L else 0L in \
        System.IO.Directory.Delete(root,true); let cleanup = if System.IO.Directory.Exists(root) then 0L else 1L in \
        completedCount,allChildren,processCountBound,finalOwnerMatch,finalFenceMatch,staleRejected,currentAccepted,cle\
        anup)"

:= assert_erp_p2p_cross_process_takeover_program_runtime
    (completed_count : i64) (all_children : i64)
    (process_count_bound : i64) (final_owner_match : i64)
    (final_fence_match : i64) (stale_rejected : i64)
    (current_accepted : i64) (cleanup : i64)
    : ()
    =
    := ok_0 = !!!!GT(completed_count, 0i64)
    := ok_1 = !!!!EQ(all_children, 1i64)
    := ok_2 = !!!!EQ(process_count_bound, 1i64)
    := ok_3 = !!!!EQ(final_owner_match, 1i64)
    := ok_4 = !!!!EQ(final_fence_match, 1i64)
    := ok_5 = !!!!EQ(stale_rejected, 1i64)
    := ok_6 = !!!!EQ(current_accepted, 1i64)
    := ok_7 = !!!!EQ(cleanup, 1i64)
    ? ok_0 && ok_1 && ok_2 && ok_3 && ok_4 && ok_5 && ok_6 && ok_7
    ?> ()
    |: mega_runtime_fail "erp-p2p-cross-process-takeover-program-runtime-mismatch"

:| erp_p2p_cross_process_takeover_execution from to =
    | ErpP2PCrossProcessTakeoverExecution :: \* from to.
        erp_p2p_fence_takeover_execution from to *
        string ->
        erp_p2p_cross_process_takeover_execution from to

:= erp_p2p_execute_cross_process_takeover_program \* from to.
    (history : erp_p2p_fence_history from)
    (program : erp_p2p_fence_takeover_program from to)
    :
        erp_p2p_cross_process_takeover_execution from to
    =
    := execution = erp_p2p_execute_fence_takeover_program history program
    ?= execution ?|
    | ErpP2PFenceTakeoverExecution (after, _) =>
        := initial_owner = erp_p2p_fence_history_owner history
        := initial_fence = runtime_money_nat_to_i64 (erp_p2p_fence_history_value history)
        := owner_sequence = erp_p2p_fence_takeover_program_owner_sequence program
        := expected_owner = erp_p2p_fence_history_owner after
        := expected_fence = runtime_money_nat_to_i64 (erp_p2p_fence_history_value after)
        := completed_count
            , all_children, process_count_bound, final_owner_match, final_fence_match, stale_rejected, current_accepted,
            cleanup
            =
            erp_p2p_cross_process_takeover_program_runtime
                initial_owner initial_fence owner_sequence expected_owner expected_fence
        := _ =
            assert_erp_p2p_cross_process_takeover_program_runtime
                completed_count all_children process_count_bound final_owner_match
                final_fence_match stale_rejected current_accepted cleanup
        ErpP2PCrossProcessTakeoverExecution
            (execution,
                "arbitrary-typed-takeover-program-executed-one-persistent-restart-process-per-owner")

:= erp_p2p_cross_process_fence_restart_runtime
    (before_owner : string) (before_fence : i64)
    (after_owner : string) (after_fence : i64) :
    i64 * i64 * i64 * i64 * i64 * i64 * i64 * i64 =
    $"(let root = System.IO.Path.Combine(System.IO.Path.GetTempPath(), \"spiral-erp-cross-process-fence-\" + \
        System.Guid.NewGuid().ToString(\"N\")) in let _ = System.IO.Directory.CreateDirectory(root) in let statePath \
        = System.IO.Path.Combine(root, \"fence.state\") in let childReceiptPath = System.IO.Path.Combine(root, \
        \"child.receipt\") in let writeDurable path (text : string) = let bytes = \
        System.Text.Encoding.UTF8.GetBytes(text) in use stream = new \
        System.IO.FileStream(path,System.IO.FileMode.Create,System.IO.FileAccess.Write,System.IO.FileShare.None,4096,S\
        ystem.IO.FileOptions.WriteThrough) in stream.Write(bytes,0,bytes.Length); stream.Flush(true) in writeDurable \
        statePath (System.String.Join(\"|\",[|!before_owner;string !before_fence|])); let info = new \
        System.Diagnostics.ProcessStartInfo() in info.FileName <- \"/bin/sh\"; info.UseShellExecute <- false; \
        info.ArgumentList.Add(\"-c\"); info.ArgumentList.Add(\"IFS='|' read -r old_owner old_fence < $1; \
        next_fence=$(/usr/bin/expr $old_fence + 1); tmp=$1.next; printf '%s|%s' $2 $next_fence > $tmp; /usr/bin/sync \
        -f $tmp; /bin/mv $tmp $1; printf '%s|%s|%s|%s' $old_owner $old_fence $2 $next_fence > $3; /usr/bin/sync -f \
        $3\"); info.ArgumentList.Add(\"erp-fence-restart\"); info.ArgumentList.Add(statePath); \
        info.ArgumentList.Add(!after_owner); info.ArgumentList.Add(childReceiptPath); use child = \
        System.Diagnostics.Process.Start(info) in let completed = child.WaitForExit(5000) in let _ = if not completed \
        then (child.Kill(true); child.WaitForExit() |> ignore) else () in let childExit = if completed then int64 \
        child.ExitCode else -2L in let receiptParts = if System.IO.File.Exists(childReceiptPath) then \
        System.IO.File.ReadAllText(childReceiptPath).Split('|') else [||] in let stateParts = if \
        System.IO.File.Exists(statePath) then System.IO.File.ReadAllText(statePath).Split('|') else [||] in let \
        childReopenedBefore = if receiptParts.Length = 4 && receiptParts.[0] = !before_owner && \
        System.Int64.Parse(receiptParts.[1]) = !before_fence then 1L else 0L in let childDerivedAfter = if \
        receiptParts.Length = 4 && receiptParts.[2] = !after_owner && System.Int64.Parse(receiptParts.[3]) = \
        !after_fence then 1L else 0L in let persistedAfter = if stateParts.Length = 2 && stateParts.[0] = \
        !after_owner && System.Int64.Parse(stateParts.[1]) = !after_fence then 1L else 0L in let staleRejected = if \
        stateParts.Length = 2 && !before_fence < System.Int64.Parse(stateParts.[1]) then 1L else 0L in let \
        currentAccepted = if stateParts.Length = 2 && !after_fence = System.Int64.Parse(stateParts.[1]) then 1L else \
        0L in System.IO.Directory.Delete(root,true); let cleanup = if System.IO.Directory.Exists(root) then 0L else \
        1L in (if completed then 1L else 0L),childExit,childReopenedBefore,childDerivedAfter,persistedAfter,staleRejec\
        ted,currentAccepted,cleanup)"

:= assert_erp_p2p_cross_process_fence_restart_runtime
    (completed : i64) (child_exit : i64) (child_reopened_before : i64)
    (child_derived_after : i64) (persisted_after : i64)
    (stale_rejected : i64) (current_accepted : i64) (cleanup : i64)
    : ()
    =
    := ok_0 = !!!!EQ(completed, 1i64)
    := ok_1 = !!!!EQ(child_exit, 0i64)
    := ok_2 = !!!!EQ(child_reopened_before, 1i64)
    := ok_3 = !!!!EQ(child_derived_after, 1i64)
    := ok_4 = !!!!EQ(persisted_after, 1i64)
    := ok_5 = !!!!EQ(stale_rejected, 1i64)
    := ok_6 = !!!!EQ(current_accepted, 1i64)
    := ok_7 = !!!!EQ(cleanup, 1i64)
    ? ok_0 && ok_1 && ok_2 && ok_3 && ok_4 && ok_5 && ok_6 && ok_7
    ?> ()
    |: mega_runtime_fail "erp-p2p-cross-process-fence-restart-runtime-mismatch"

:| erp_p2p_cross_process_fence_restart_receipt before after =
    | ErpP2PCrossProcessFenceRestart :: \* before.
        erp_p2p_persisted_fence_restart_receipt before (nat_succ before) *
        erp_p2p_stale_fence before (nat_succ before) *
        string ->
        erp_p2p_cross_process_fence_restart_receipt before (nat_succ before)

:= erp_p2p_cross_process_fence_restart_from_history \* fence.
    (history : erp_p2p_fence_history fence)
    (next_owner : string)
    :
        erp_p2p_cross_process_fence_restart_receipt fence (nat_succ fence)
    =
    := restart = erp_p2p_persisted_fence_restart_from_history history next_owner
    ?= restart ?|
    | ErpP2PPersistedFenceRestart (before, after, _) =>
        := before_owner = erp_p2p_fence_history_owner before
        := before_fence = runtime_money_nat_to_i64 (erp_p2p_fence_history_value before)
        := after_owner = erp_p2p_fence_history_owner after
        := after_fence = runtime_money_nat_to_i64 (erp_p2p_fence_history_value after)
        := completed
            , child_exit, child_reopened_before, child_derived_after, persisted_after, stale_rejected, current_accepted,
            cleanup
            =
            erp_p2p_cross_process_fence_restart_runtime
                before_owner before_fence after_owner after_fence
        := _ =
            assert_erp_p2p_cross_process_fence_restart_runtime
                completed child_exit child_reopened_before child_derived_after
                persisted_after stale_rejected current_accepted cleanup
        ErpP2PCrossProcessFenceRestart
            (restart, ErpP2PStaleImmediate,
                "separate-restart-process-reopened-persisted-fence-and-derived-exact-successor")

:| erp_p2p_cross_process_fenced_commit_receipt before after version from to =
    | ErpP2PCrossProcessFencedCommit :: \* before version from to.
        erp_p2p_cross_process_fence_restart_receipt before (nat_succ before) *
        erp_p2p_event_store version from to *
        erp_p2p_event_outbox version from to *
        string ->
        erp_p2p_cross_process_fenced_commit_receipt
            before (nat_succ before) version from to

:= erp_p2p_cross_process_fenced_commit_from_history \* fence version from to.
    (history : erp_p2p_fence_history fence)
    (next_owner : string)
    (tree : erp_p2p_event_commit_tree version from to) :
    erp_p2p_cross_process_fenced_commit_receipt
        fence (nat_succ fence) version from to =
    := store = erp_p2p_event_commit_tree_store tree
    := outbox = erp_p2p_event_commit_tree_outbox tree
    ErpP2PCrossProcessFencedCommit
        (erp_p2p_cross_process_fence_restart_from_history history next_owner,
            store, outbox,
            "cross-process-successor-fence-bound-to-one-commit-tree")

:| erp_p2p_multiprocess_fenced_commit_receipt from to version state_from state_to =
    | ErpP2PMultiprocessFencedCommit :: \* from to version state_from state_to.
        erp_p2p_cross_process_takeover_execution from to *
        erp_p2p_event_store version state_from state_to *
        erp_p2p_event_outbox version state_from state_to *
        string ->
        erp_p2p_multiprocess_fenced_commit_receipt
            from to version state_from state_to

:= erp_p2p_multiprocess_fenced_commit_from_program \* from to version state_from state_to.
    (history : erp_p2p_fence_history from)
    (program : erp_p2p_fence_takeover_program from to)
    (tree : erp_p2p_event_commit_tree version state_from state_to) :
    erp_p2p_multiprocess_fenced_commit_receipt
        from to version state_from state_to =
    := store = erp_p2p_event_commit_tree_store tree
    := outbox = erp_p2p_event_commit_tree_outbox tree
    ErpP2PMultiprocessFencedCommit
        (erp_p2p_execute_cross_process_takeover_program history program,
            store, outbox,
            "multiprocess-takeover-program-bound-to-one-commit-tree")

:= erp_p2p_fence_history_one () : erp_p2p_fence_history nat_one =
    ErpP2PFenceGenesis ("owner-a", erp_rate_one_proof ())

:= erp_p2p_fence_history_two () : erp_p2p_fence_history nat_two =
    erp_p2p_fence_history_takeover
        (erp_p2p_fence_history_one ())
        "owner-b"



:| ^ erp_p2p_physical_owner_lineage =
    | ErpP2PPhysicalOwnerLineageGenesis : string
    | ErpP2PPhysicalOwnerLineageTakeover : erp_p2p_physical_owner_lineage * string

:= ^ erp_p2p_physical_owner_lineage_matches_history \* fence.
    (physical_lineage : erp_p2p_physical_owner_lineage)
    (history : erp_p2p_fence_history fence) : () =
    ?= physical_lineage, history ?|
    | ErpP2PPhysicalOwnerLineageGenesis physical_owner,
      ErpP2PFenceGenesis (history_owner, _) =>
        := ok_0 = !!!!EQ(physical_owner, history_owner)
        ? ok_0 ?> () |: mega_runtime_fail "erp-p2p-physical-owner-lineage-genesis-mismatch"
    | ErpP2PPhysicalOwnerLineageTakeover (previous_lineage, physical_owner),
      ErpP2PFenceTakeover (previous_history, history_owner, _) =>
        := _ : () =
            := ok_0 = !!!!EQ(physical_owner, history_owner)
            ? ok_0 ?> () |: mega_runtime_fail "erp-p2p-physical-owner-lineage-takeover-mismatch"
        erp_p2p_physical_owner_lineage_matches_history previous_lineage previous_history
    | _, _ =>
        mega_runtime_fail "erp-p2p-physical-owner-lineage-shape-mismatch"

:! erp_p2p_physical_owner_lineage_history =
    \? fence. erp_p2p_fence_history fence

:= ^ erp_p2p_physical_owner_lineage_history_make
    (physical_lineage : erp_p2p_physical_owner_lineage) :
    erp_p2p_physical_owner_lineage_history =
    ?= physical_lineage ?|
    | ErpP2PPhysicalOwnerLineageGenesis owner =>
        erp_p2p_physical_owner_lineage_history (\? (
            ErpP2PFenceGenesis (owner, erp_rate_one_proof ())))
    | ErpP2PPhysicalOwnerLineageTakeover (previous_lineage, owner) =>
        ?= erp_p2p_physical_owner_lineage_history_make previous_lineage ?|
        | erp_p2p_physical_owner_lineage_history payload =>
            := \? previous_fence. previous_history = payload
            erp_p2p_physical_owner_lineage_history (\? (
                erp_p2p_fence_history_takeover previous_history owner))

:= ^ erp_p2p_physical_owner_lineage_current_owner
    (physical_lineage : erp_p2p_physical_owner_lineage) : string =
    ?= physical_lineage ?|
    | ErpP2PPhysicalOwnerLineageGenesis owner => owner
    | ErpP2PPhysicalOwnerLineageTakeover (_, owner) => owner

:= erp_p2p_physical_owner_lineage_previous_owner
    (physical_lineage : erp_p2p_physical_owner_lineage) : string =
    ?= physical_lineage ?|
    | ErpP2PPhysicalOwnerLineageGenesis owner => owner
    | ErpP2PPhysicalOwnerLineageTakeover (previous_lineage, _) =>
        erp_p2p_physical_owner_lineage_current_owner previous_lineage

:= ^ erp_p2p_physical_owner_lineage_sequence
    (physical_lineage : erp_p2p_physical_owner_lineage) : string =
    ?= physical_lineage ?|
    | ErpP2PPhysicalOwnerLineageGenesis owner => owner
    | ErpP2PPhysicalOwnerLineageTakeover (previous_lineage, owner) =>
        := previous_sequence = erp_p2p_physical_owner_lineage_sequence previous_lineage
        $"!previous_sequence + \"|\" + !owner"


:! erp_p2p_physical_fence_observation_snapshot =
    i64 * erp_p2p_physical_owner_lineage * string

:= erp_p2p_recoverable_fenced_lock_receipt_from_snapshot_internal \* fence version from to.
    (history : erp_p2p_fence_history fence)
    (tree : erp_p2p_event_commit_tree version from to)
    (snapshot : erp_p2p_physical_fence_observation_snapshot)
    :
        erp_p2p_recoverable_fenced_lock_receipt fence version from to
    =
    := store = erp_p2p_event_commit_tree_store tree
    := outbox = erp_p2p_event_commit_tree_outbox tree
    ?= snapshot ?|
    | erp_p2p_physical_fence_observation_snapshot (physical_fence, physical_lineage, _) =>
        := physical_owner = erp_p2p_physical_owner_lineage_current_owner physical_lineage
        := physical_previous_owner = erp_p2p_physical_owner_lineage_previous_owner physical_lineage
        := expected_fence_value = runtime_money_nat_to_i64 (erp_p2p_fence_history_value history)
        := expected_owner_text = erp_p2p_fence_history_owner history
        := _ : () =
            := ok_0 = !!!!EQ(physical_owner, expected_owner_text)
            := ok_1 = !!!!EQ(physical_fence, expected_fence_value)
            ? ok_0 && ok_1 ?> () |: mega_runtime_fail "erp-p2p-recoverable-fenced-lock-snapshot-history-mismatch"
        := _ : () =
            ?= history ?|
            | ErpP2PFenceGenesis _ => ()
            | ErpP2PFenceTakeover (previous_history, _, _) =>
                := expected_previous_owner = erp_p2p_fence_history_owner previous_history
                := ok_0 = !!!!EQ(physical_previous_owner, expected_previous_owner)
                ? ok_0
                ?> ()
                |: mega_runtime_fail "erp-p2p-recoverable-fenced-lock-snapshot-previous-owner-mismatch"
        erp_p2p_recoverable_fenced_lock_receipt (
            erp_p2p_fence_owner physical_owner,
            store,
            outbox,
            "physical-owner-store-outbox-bound-after-fenced-takeover")

:! erp_p2p_physical_fence_history_selection =
    \? fence.
        erp_p2p_physical_fence_observation_snapshot *
        erp_p2p_fence_history fence * string

:= erp_p2p_physical_fence_history_selection_from_snapshot
    (snapshot : erp_p2p_physical_fence_observation_snapshot)
    :
        erp_p2p_physical_fence_history_selection
    =
    ?= snapshot ?|
    | erp_p2p_physical_fence_observation_snapshot (physical_fence, physical_lineage, physical_owner_sequence) =>
        := lineage_owner_sequence = erp_p2p_physical_owner_lineage_sequence physical_lineage
        := _ : () =
            := ok_0 = !!!!EQ(physical_owner_sequence, lineage_owner_sequence)
            ? ok_0 ?> () |: mega_runtime_fail "erp-p2p-physical-owner-sequence-lineage-mismatch"
        ?= erp_p2p_physical_owner_lineage_history_make physical_lineage ?|
        | erp_p2p_physical_owner_lineage_history payload =>
            := \? fence. history = payload
            := expected_fence =
                runtime_money_nat_to_i64 (erp_p2p_fence_history_value history)
            := _ : () =
                := ok_0 = !!!!EQ(physical_fence, expected_fence)
                ? ok_0 ?> () |: mega_runtime_fail "erp-p2p-physical-lineage-selected-fence-mismatch"
            erp_p2p_physical_fence_history_selection (
                \? (
                    snapshot,
                    history,
                    "the-physical-snapshot-now-selects-its-own-indexed-fence-history-directly-so-the-same-fence-lin"
                    ^^ "eage-envelope-crosses-selection-coherence-recovery-and-receipt-boundaries"
                )
            )

:= erp_p2p_physical_fence_history_selection_from_lineage
    (physical_fence : i64)
    (physical_lineage : erp_p2p_physical_owner_lineage) :
    erp_p2p_physical_fence_history_selection =
    erp_p2p_physical_fence_history_selection_from_snapshot
        (erp_p2p_physical_fence_observation_snapshot (
            physical_fence,
            physical_lineage,
            erp_p2p_physical_owner_lineage_sequence physical_lineage))

:! erp_p2p_physical_fence_history_lineage_authority =
    erp_p2p_physical_fence_history_selection * string

:= erp_p2p_physical_fence_history_lineage_authority_make
    (selection : erp_p2p_physical_fence_history_selection)
    :
        erp_p2p_physical_fence_history_lineage_authority
    =
    ?= selection ?|
    | erp_p2p_physical_fence_history_selection payload =>
        := \? fence. snapshot, history, _ = payload
        ?= snapshot ?|
        | erp_p2p_physical_fence_observation_snapshot (_, physical_lineage, _) =>
            := _ =
                erp_p2p_physical_owner_lineage_matches_history
                    physical_lineage
                    history
            erp_p2p_physical_fence_history_lineage_authority (
                selection,
                "the-recursive-lineage-authority-is-now-the-single-owner-history-coherence-boundary-and-directly-ca"
                ^^ "rries-the-selected-history-instead-of-routing-through-a-separate-current-owner-runtime-coherence-w"
                ^^ "rapper"
            )

:! erp_p2p_physical_fence_history_selection_recovery_authority =
    erp_p2p_physical_fence_history_lineage_authority * string

:= erp_p2p_physical_fence_history_selection_recovery_authority_make
    (lineage : erp_p2p_physical_fence_history_lineage_authority)
    :
        erp_p2p_physical_fence_history_selection_recovery_authority
    =
    erp_p2p_physical_fence_history_selection_recovery_authority (
        lineage,
        "the-recovery-authority-carries-one-lineage-authority-whose-selected-history-and-full-owner-lineage-coheren"
        ^^ "ce-share-the-same-boundary"
    )

:= erp_p2p_physical_fence_history_selection_recovery_authority_note
    (authority : erp_p2p_physical_fence_history_selection_recovery_authority) : string =
    ?= authority ?|
    | erp_p2p_physical_fence_history_selection_recovery_authority (_, note) => note

:= erp_p2p_physical_fence_history_selection_recovery_authority_selected_history
    (authority : erp_p2p_physical_fence_history_selection_recovery_authority) :
    erp_p2p_physical_fence_history_selection =
    ?= authority ?|
    | erp_p2p_physical_fence_history_selection_recovery_authority (lineage, _) =>
        ?= lineage ?|
        | erp_p2p_physical_fence_history_lineage_authority (selection, lineage_note) =>
            := _ = lineage_note
            selection



:! erp_p2p_recovered_fence_history_receipt version from to =
    \? fence.
        erp_p2p_fence_history fence *
        erp_p2p_recoverable_fenced_lock_receipt fence version from to

:= erp_p2p_recoverable_fenced_lock_existential_history_from_physical \* version from to.
    (tree : erp_p2p_event_commit_tree version from to)
    :
        erp_p2p_recovered_fence_history_receipt version from to
    =
    := child_ready
        , owner_killed, lease_expired, fence_advanced, stale_rejected, new_accepted, owner_b_installed,
        committed_fence_two, cleanup_synced, physical_fence, physical_owner_sequence
        =
        erp_p2p_recoverable_fenced_lock_runtime ()
    := _ =
        assert_erp_p2p_recoverable_fenced_lock_runtime
            child_ready
            owner_killed
            lease_expired
            fence_advanced
            stale_rejected
            new_accepted
            owner_b_installed
            committed_fence_two
            cleanup_synced
    := observation =
        erp_p2p_recoverable_fenced_lock_physical_observation (
            child_ready, owner_killed, lease_expired, fence_advanced, stale_rejected,
            new_accepted, owner_b_installed, committed_fence_two, cleanup_synced,
            physical_fence, physical_owner_sequence)
    ?= observation ?|
    | erp_p2p_recoverable_fenced_lock_physical_observation (
            _,
            _,
            _,
            _,
            _,
            _,
            _,
            _,
            _,
            physical_fence,
            physical_owner_sequence
        )
        =>
            := physical_owner_count = erp_p2p_physical_owner_sequence_count physical_owner_sequence
            := _ = assert_erp_p2p_physical_owner_sequence_cardinality physical_owner_count physical_fence
            := physical_origin_owner_index : i64 = 0i64
            := physical_penultimate_owner_index : i64 = $"!physical_origin_owner_index + 1L"
            := physical_previous_owner_index : i64 = $"!physical_owner_count - 2L"
            := physical_current_owner_index : i64 = $"!physical_owner_count - 1L"
            := physical_origin_owner =
                erp_p2p_physical_owner_sequence_at physical_owner_sequence physical_origin_owner_index
            := physical_penultimate_owner =
                erp_p2p_physical_owner_sequence_at physical_owner_sequence physical_penultimate_owner_index
            := physical_previous_owner =
                erp_p2p_physical_owner_sequence_at physical_owner_sequence physical_previous_owner_index
            := physical_owner = erp_p2p_physical_owner_sequence_at physical_owner_sequence physical_current_owner_index
            := physical_lineage =
                ErpP2PPhysicalOwnerLineageTakeover (
                    ErpP2PPhysicalOwnerLineageTakeover (
                        ErpP2PPhysicalOwnerLineageTakeover (
                            ErpP2PPhysicalOwnerLineageGenesis physical_origin_owner,
                            physical_penultimate_owner),
                        physical_previous_owner),
                    physical_owner)
            := physical_snapshot =
                erp_p2p_physical_fence_observation_snapshot (
                    physical_fence,
                    physical_lineage,
                    physical_owner_sequence)
            := selected_history =
                erp_p2p_physical_fence_history_selection_from_snapshot
                    physical_snapshot
            := selection_lineage =
                erp_p2p_physical_fence_history_lineage_authority_make selected_history
            := selection_recovery_authority =
                erp_p2p_physical_fence_history_selection_recovery_authority_make
                    selection_lineage
            := _ = erp_p2p_physical_fence_history_selection_recovery_authority_note selection_recovery_authority
            := selected_history_from_recovery =
                erp_p2p_physical_fence_history_selection_recovery_authority_selected_history
                    selection_recovery_authority
            ?= selected_history_from_recovery ?|
            | erp_p2p_physical_fence_history_selection payload =>
                := \? fence. snapshot, history, _ = payload
                := _ = snapshot
                erp_p2p_recovered_fence_history_receipt (\? (
                    history,
                    erp_p2p_recoverable_fenced_lock_receipt_from_snapshot_internal
                        history
                        tree
                        snapshot))

:= erp_p2p_four_event_recoverable_fenced_lock_terminal () : string =
    := tree = erp_p2p_four_event_commit_tree ()
    := recovered =
        erp_p2p_recoverable_fenced_lock_existential_history_from_physical tree
    ?= recovered ?|
    | erp_p2p_recovered_fence_history_receipt payload =>
        := \? fence. _, receipt = payload
        := validated_authority =
            erp_p2p_validated_recoverable_fenced_lock_authority_make receipt
        ?= validated_authority ?|
        | erp_p2p_validated_recoverable_fenced_lock_authority (_, recovered_store, recovered_outbox) =>
            := recovered_store_version = erp_p2p_event_store_length recovered_store
            := recovered_outbox_version = erp_p2p_event_outbox_length recovered_outbox
            := recovered_store_terminal = terminal (erp_p2p_event_store_replay recovered_store)
            := recovered_outbox_terminal = terminal (erp_p2p_event_outbox_replay recovered_outbox)
            := _ =
                assert_erp_p2p_four_event_store_runtime
                    recovered_store_version
                    recovered_outbox_version
                    recovered_store_terminal
                    recovered_outbox_terminal
            "the-validated-physical-fenced-lock-receipt-is-now-the-single-owner-coherence-authority-so-the-public-t"
            ^^ "erminal-opens-that-authority-directly-before-replaying-store-and-outbox"

:= erp_p2p_three_takeover_program_from_owners
    (owner_b : string) (owner_c : string) (owner_d : string) :
    erp_p2p_fence_takeover_program nat_one nat_four =
    ErpP2PFenceTakeoverProgramThen
        (\?
            (ErpP2PFenceTakeoverProgramOne owner_b,
             ErpP2PFenceTakeoverProgramThen
                (\?
                    (ErpP2PFenceTakeoverProgramOne owner_c,
                     ErpP2PFenceTakeoverProgramOne owner_d))))

:= erp_p2p_three_takeover_program () :
    erp_p2p_fence_takeover_program nat_one nat_four =
    erp_p2p_three_takeover_program_from_owners "owner-b" "owner-c" "owner-d"



:= erp_p2p_recursive_takeover_program_terminal () : string =
    := cross_process_execution =
        erp_p2p_execute_cross_process_takeover_program
            (erp_p2p_fence_history_one ())
            (erp_p2p_three_takeover_program ())
    ?= cross_process_execution ?|
    | ErpP2PCrossProcessTakeoverExecution (execution, note) =>
        ?= execution ?|
        | ErpP2PFenceTakeoverExecution (history, initial_stale) =>
            := current_owner = erp_p2p_fence_history_owner history
            := current_fence = runtime_money_nat_to_i64 (erp_p2p_fence_history_value history)
            $"(if !current_owner <> \"owner-d\" || !current_fence <> 4L || !note <> \
                \"arbitrary-typed-takeover-program-executed-one-persistent-restart-process-per-owner\" then failwith \
                \"erp-p2p-recursive-takeover-program-mismatch\")"
            "recursive-takeover-program-runs-three-persistent-restart-processes-derives-fence-four-and-proves-the-i"
            ^^ "nitial-fence-stale-at-distance-three"

:= erp_p2p_cross_process_fence_restart_terminal () : string =
    := receipt =
        erp_p2p_cross_process_fence_restart_from_history
            (erp_p2p_fence_history_two ())
            "owner-c"
    ?= receipt ?|
    | ErpP2PCrossProcessFenceRestart (restart, stale, note) =>
        ?= restart ?|
        | ErpP2PPersistedFenceRestart (before, after, _) =>
            := before_owner = erp_p2p_fence_history_owner before
            := before_fence = runtime_money_nat_to_i64 (erp_p2p_fence_history_value before)
            := after_owner = erp_p2p_fence_history_owner after
            := after_fence = runtime_money_nat_to_i64 (erp_p2p_fence_history_value after)
            := stale_distance = erp_p2p_stale_fence_distance stale
            $"(if !before_owner <> \"owner-b\" || !before_fence <> 2L || !after_owner <> \"owner-c\" || !after_fence \
                <> 3L || !stale_distance <> 1L || !note <> \"separate-restart-process-reopened-persisted-fence-and-der\
                ived-exact-successor\" then failwith \"erp-p2p-cross-process-fence-restart-receipt-mismatch\")"
            "cross-process-restart-reopens-fence-two-derives-fence-three-and-rejects-stale-fence-two"

:= erp_p2p_four_event_cross_process_fenced_commit_terminal () : string =
    := tree = erp_p2p_four_event_commit_tree ()
    := receipt =
        erp_p2p_cross_process_fenced_commit_from_history
            (erp_p2p_fence_history_two ())
            "owner-c"
            tree
    ?= receipt ?|
    | ErpP2PCrossProcessFencedCommit
        (restart_receipt, recovered_store, recovered_outbox, note) =>
        ?= restart_receipt ?|
        | ErpP2PCrossProcessFenceRestart (restart, stale, _) =>
            ?= restart ?|
            | ErpP2PPersistedFenceRestart (_, after, _) =>
                := current_owner = erp_p2p_fence_history_owner after
                := current_fence = runtime_money_nat_to_i64 (erp_p2p_fence_history_value after)
                := stale_distance = erp_p2p_stale_fence_distance stale
                := recovered_store_version = erp_p2p_event_store_length recovered_store
                := recovered_outbox_version = erp_p2p_event_outbox_length recovered_outbox
                := recovered_store_terminal = terminal (erp_p2p_event_store_replay recovered_store)
                := recovered_outbox_terminal = terminal (erp_p2p_event_outbox_replay recovered_outbox)
                := _ =
                    assert_erp_p2p_four_event_store_runtime
                        recovered_store_version recovered_outbox_version
                        recovered_store_terminal recovered_outbox_terminal
                $"(if !current_owner <> \"owner-c\" || !current_fence <> 3L || !stale_distance <> 1L || !note <> \
                    \"cross-process-successor-fence-bound-to-one-commit-tree\" then failwith \
                    \"erp-p2p-cross-process-fenced-commit-receipt-mismatch\")"
                "cross-process-fence-three-authority-bound-to-the-four-event-store-and-outbox-with-fence-two-stale"

:= erp_p2p_four_event_multiprocess_fenced_commit_terminal () : string =
    := tree = erp_p2p_four_event_commit_tree ()
    := receipt =
        erp_p2p_multiprocess_fenced_commit_from_program
            (erp_p2p_fence_history_one ())
            (erp_p2p_three_takeover_program ())
            tree
    ?= receipt ?|
    | ErpP2PMultiprocessFencedCommit
        (cross_process_execution, recovered_store, recovered_outbox, note) =>
        ?= cross_process_execution ?|
        | ErpP2PCrossProcessTakeoverExecution (execution, _) =>
            ?= execution ?|
            | ErpP2PFenceTakeoverExecution (history, initial_stale) =>
                := current_owner = erp_p2p_fence_history_owner history
                := current_fence = runtime_money_nat_to_i64 (erp_p2p_fence_history_value history)
                := stale_distance = erp_p2p_stale_fence_distance initial_stale
                := recovered_store_version = erp_p2p_event_store_length recovered_store
                := recovered_outbox_version = erp_p2p_event_outbox_length recovered_outbox
                := recovered_store_terminal = terminal (erp_p2p_event_store_replay recovered_store)
                := recovered_outbox_terminal = terminal (erp_p2p_event_outbox_replay recovered_outbox)
                := _ =
                    assert_erp_p2p_four_event_store_runtime
                        recovered_store_version recovered_outbox_version
                        recovered_store_terminal recovered_outbox_terminal
                $"(if !current_owner <> \"owner-d\" || !current_fence <> 4L || !stale_distance <> 3L || !note <> \
                    \"multiprocess-takeover-program-bound-to-one-commit-tree\" then failwith \
                    \"erp-p2p-multiprocess-fenced-commit-receipt-mismatch\")"
                "three-restart-processes-derive-fence-four-and-bind-the-result-to-the-four-event-store-outbox-pair"

:= erp_p2p_multiprocess_fenced_physical_append_runtime
    (current_fence : i64) (stale_fence : i64)
    (store_version : i64) (outbox_version : i64)
    (store_terminal : string) (outbox_terminal : string) :
    i64 * i64 * i64 * i64 * i64 * i64 * i64 =
    $"(let root = System.IO.Path.Combine(System.IO.Path.GetTempPath(), \"spiral-erp-fenced-physical-append-\" + \
        System.Guid.NewGuid().ToString(\"N\")) in let _ = System.IO.Directory.CreateDirectory(root) in let fencePath \
        = System.IO.Path.Combine(root, \"fence.state\") in let preparedPath = System.IO.Path.Combine(root, \
        \"append.prepared\") in let committedPath = System.IO.Path.Combine(root, \"append.committed\") in let \
        writeDurable path (text : string) = let bytes = System.Text.Encoding.UTF8.GetBytes(text) in use stream = new \
        System.IO.FileStream(path,System.IO.FileMode.Create,System.IO.FileAccess.Write,System.IO.FileShare.None,4096,S\
        ystem.IO.FileOptions.WriteThrough) in stream.Write(bytes,0,bytes.Length); stream.Flush(true) in writeDurable \
        fencePath (string !current_fence); let persistedFence = \
        System.Int64.Parse(System.IO.File.ReadAllText(fencePath)) in let staleRejected = if !stale_fence < \
        persistedFence then 1L else 0L in let staleCreatedNothing = if staleRejected = 1L && not \
        (System.IO.File.Exists(preparedPath)) && not (System.IO.File.Exists(committedPath)) then 1L else 0L in let \
        payload = System.String.Join(\"|\",[|string !current_fence;string !store_version;string \
        !outbox_version;!store_terminal;!outbox_terminal|]) in let currentAccepted = if !current_fence = \
        persistedFence then (writeDurable preparedPath payload; System.IO.File.Move(preparedPath,committedPath,true); \
        1L) else 0L in let reopened = if System.IO.File.Exists(committedPath) then \
        System.IO.File.ReadAllText(committedPath) else \"\" in let reopenedEqual = if reopened = payload then 1L else \
        0L in let digest = System.Security.Cryptography.SHA256.HashData(System.Text.Encoding.UTF8.GetBytes(payload)) \
        in let reopenedDigest = System.Security.Cryptography.SHA256.HashData(System.Text.Encoding.UTF8.GetBytes(reopen\
        ed)) in let digestValid = if System.Security.Cryptography.CryptographicOperations.FixedTimeEquals(digest,reope\
        nedDigest) then 1L else 0L in let preparedAbsent = if not (System.IO.File.Exists(preparedPath)) then 1L else \
        0L in System.IO.Directory.Delete(root,true); let cleanup = if System.IO.Directory.Exists(root) then 0L else \
        1L in staleRejected,staleCreatedNothing,currentAccepted,reopenedEqual,digestValid,preparedAbsent,cleanup)"

:= assert_erp_p2p_multiprocess_fenced_physical_append_runtime
    (stale_rejected : i64) (stale_created_nothing : i64)
    (current_accepted : i64) (reopened_equal : i64)
    (digest_valid : i64) (prepared_absent : i64) (cleanup : i64)
    : ()
    =
    := ok_0 = !!!!EQ(stale_rejected, 1i64)
    := ok_1 = !!!!EQ(stale_created_nothing, 1i64)
    := ok_2 = !!!!EQ(current_accepted, 1i64)
    := ok_3 = !!!!EQ(reopened_equal, 1i64)
    := ok_4 = !!!!EQ(digest_valid, 1i64)
    := ok_5 = !!!!EQ(prepared_absent, 1i64)
    := ok_6 = !!!!EQ(cleanup, 1i64)
    ? ok_0 && ok_1 && ok_2 && ok_3 && ok_4 && ok_5 && ok_6
    ?> ()
    |: mega_runtime_fail "erp-p2p-multiprocess-fenced-physical-append-runtime-mismatch"

:| erp_p2p_multiprocess_fenced_physical_append_receipt from to version state_from state_to =
    | ErpP2PMultiprocessFencedPhysicalAppend :: \* from to version state_from state_to.
        erp_p2p_multiprocess_fenced_commit_receipt from to version state_from state_to *
        string ->
        erp_p2p_multiprocess_fenced_physical_append_receipt
            from to version state_from state_to

:= erp_p2p_multiprocess_fenced_physical_append_from_program \* from to version state_from state_to.
    (history : erp_p2p_fence_history from)
    (program : erp_p2p_fence_takeover_program from to)
    (tree : erp_p2p_event_commit_tree version state_from state_to) :
    erp_p2p_multiprocess_fenced_physical_append_receipt
        from to version state_from state_to =
    := receipt =
        erp_p2p_multiprocess_fenced_commit_from_program
            history program tree
    ?= receipt ?|
    | ErpP2PMultiprocessFencedCommit (
            cross_process_execution,
            recovered_store,
            recovered_outbox,
            _
        )
        =>
            ?= cross_process_execution ?|
            | ErpP2PCrossProcessTakeoverExecution (execution, _) =>
                ?= execution ?|
                | ErpP2PFenceTakeoverExecution (after, _) =>
                    := current_fence = runtime_money_nat_to_i64 (erp_p2p_fence_history_value after)
                    := stale_fence = runtime_money_nat_to_i64 (erp_p2p_fence_history_value history)
                    := recovered_store_version = erp_p2p_event_store_length recovered_store
                    := recovered_outbox_version = erp_p2p_event_outbox_length recovered_outbox
                    := recovered_store_terminal = terminal (erp_p2p_event_store_replay recovered_store)
                    := recovered_outbox_terminal = terminal (erp_p2p_event_outbox_replay recovered_outbox)
                    := stale_rejected
                        , stale_created_nothing, current_accepted, reopened_equal, digest_valid, prepared_absent,
                        cleanup
                        =
                        erp_p2p_multiprocess_fenced_physical_append_runtime
                            current_fence stale_fence
                            recovered_store_version recovered_outbox_version
                            recovered_store_terminal recovered_outbox_terminal
                    := _ =
                        assert_erp_p2p_multiprocess_fenced_physical_append_runtime
                            stale_rejected stale_created_nothing current_accepted
                            reopened_equal digest_valid prepared_absent cleanup
                    ErpP2PMultiprocessFencedPhysicalAppend
                        (receipt,
                         "stale-fence-created-no-prepared-file-and-current-fence-committed-the-store-outbox-payload")

:= erp_p2p_four_event_multiprocess_fenced_physical_append_terminal () : string =
    := tree = erp_p2p_four_event_commit_tree ()
    := receipt =
        erp_p2p_multiprocess_fenced_physical_append_from_program
            (erp_p2p_fence_history_one ())
            (erp_p2p_three_takeover_program ())
            tree
    ?= receipt ?|
    | ErpP2PMultiprocessFencedPhysicalAppend (commit_receipt, note) =>
        ?= commit_receipt ?|
        | ErpP2PMultiprocessFencedCommit (cross_process_execution, _, _, _) =>
            ?= cross_process_execution ?|
            | ErpP2PCrossProcessTakeoverExecution (execution, _) =>
                ?= execution ?|
                | ErpP2PFenceTakeoverExecution (history, initial_stale) =>
                    := current_owner = erp_p2p_fence_history_owner history
                    := current_fence = runtime_money_nat_to_i64 (erp_p2p_fence_history_value history)
                    := stale_distance = erp_p2p_stale_fence_distance initial_stale
                    $"(if !current_owner <> \"owner-d\" || !current_fence <> 4L || !stale_distance <> 3L || !note <> \
                        \"stale-fence-created-no-prepared-file-and-current-fence-committed-the-store-outbox-payload\" \
                        then failwith \"erp-p2p-multiprocess-fenced-physical-append-receipt-mismatch\")"
                    "three-restart-processes-derive-fence-four-reject-the-stale-writer-before-prepared-creation-and"
                    ^^ "-physically-commit-the-four-event-store-outbox-payload"

:| erp_p2p_competing_successor_fence_receipt before after =
    | ErpP2PCompetingSuccessorFence :: \* before.
        erp_p2p_fence_history before *
        erp_p2p_fence_history (nat_succ before) *
        erp_p2p_stale_fence before (nat_succ before) *
        string ->
        erp_p2p_competing_successor_fence_receipt before (nat_succ before)

:= erp_p2p_competing_successor_fence_from_existing_cas () :
    erp_p2p_competing_successor_fence_receipt nat_one nat_two =
    := physical_race_receipt =
        typed_fx_statement_interprocess_linearization_race_terminal ()
    := before = erp_p2p_fence_history_one ()
    := after = erp_p2p_fence_history_takeover before "cas-winner"
    ErpP2PCompetingSuccessorFence
        (before, after, ErpP2PStaleImmediate, physical_race_receipt)

:= erp_p2p_competing_successor_fence_terminal () : string =
    := receipt = erp_p2p_competing_successor_fence_from_existing_cas ()
    ?= receipt ?|
    | ErpP2PCompetingSuccessorFence (_, after, stale, physical_race_receipt) =>
        := final_owner = erp_p2p_fence_history_owner after
        := final_fence = runtime_money_nat_to_i64 (erp_p2p_fence_history_value after)
        := stale_distance = erp_p2p_stale_fence_distance stale
        $"(if !final_owner <> \"cas-winner\" || !final_fence <> 2L || !stale_distance <> 1L || \
            System.String.IsNullOrWhiteSpace(!physical_race_receipt) then failwith \
            \"erp-p2p-competing-successor-fence-receipt-mismatch\")"
        "existing-two-process-CAS-race-must-complete-before-the-typed-fence-one-to-two-successor-receipt-is-issued"

:| erp_p2p_competing_successor_fenced_commit_receipt before after version from to =
    | ErpP2PCompetingSuccessorFencedCommit :: \* before version from to.
        erp_p2p_competing_successor_fence_receipt before (nat_succ before) *
        erp_p2p_event_store version from to *
        erp_p2p_event_outbox version from to *
        string ->
        erp_p2p_competing_successor_fenced_commit_receipt
            before (nat_succ before) version from to

:= erp_p2p_competing_successor_fenced_commit \* version from to.
    (tree : erp_p2p_event_commit_tree version from to) :
    erp_p2p_competing_successor_fenced_commit_receipt
        nat_one nat_two version from to =
    := store = erp_p2p_event_commit_tree_store tree
    := outbox = erp_p2p_event_commit_tree_outbox tree
    ErpP2PCompetingSuccessorFencedCommit
        (erp_p2p_competing_successor_fence_from_existing_cas (),
            store, outbox,
            "physical-two-process-CAS-race-bound-to-one-commit-tree")

:= erp_p2p_four_event_competing_successor_fenced_commit_terminal () : string =
    := tree = erp_p2p_four_event_commit_tree ()
    := receipt = erp_p2p_competing_successor_fenced_commit tree
    ?= receipt ?|
    | ErpP2PCompetingSuccessorFencedCommit
        (fence_receipt, recovered_store, recovered_outbox, note) =>
        ?= fence_receipt ?|
        | ErpP2PCompetingSuccessorFence (_, after, stale, _) =>
            := final_fence = runtime_money_nat_to_i64 (erp_p2p_fence_history_value after)
            := stale_distance = erp_p2p_stale_fence_distance stale
            := store_version = erp_p2p_event_store_length recovered_store
            := outbox_version = erp_p2p_event_outbox_length recovered_outbox
            := store_terminal = terminal (erp_p2p_event_store_replay recovered_store)
            := outbox_terminal = terminal (erp_p2p_event_outbox_replay recovered_outbox)
            := _ =
                assert_erp_p2p_four_event_store_runtime
                    store_version outbox_version store_terminal outbox_terminal
            $"(if !final_fence <> 2L || !stale_distance <> 1L || !note <> \
                \"physical-two-process-CAS-race-bound-to-one-commit-tree\" then failwith \
                \"erp-p2p-competing-successor-fenced-commit-mismatch\")"
            "two-process-CAS-successor-fence-two-is-bound-to-the-four-event-store-and-outbox-while-fence-one-is-stale"

:= erp_p2p_atomic_successor_store_outbox_runtime
    (store_payload : string)
    (outbox_payload : string) : string * i64 * i64 * i64 * i64 * i64 * i64 * i64 =
    $"(let root = System.IO.Path.Combine(System.IO.Path.GetTempPath(), \"spiral-erp-atomic-successor-\" + \
        System.Guid.NewGuid().ToString(\"N\")) in let _ = System.IO.Directory.CreateDirectory(root) in let claimPath \
        = System.IO.Path.Combine(root,\"successor.claim\") in let preparedPath = \
        System.IO.Path.Combine(root,\"successor.prepared\") in let committedPath = \
        System.IO.Path.Combine(root,\"successor.committed\") in let gate = new \
        System.Threading.ManualResetEventSlim(false) in let store64 = \
        System.Convert.ToBase64String(System.Text.Encoding.UTF8.GetBytes(!store_payload)) in let outbox64 = \
        System.Convert.ToBase64String(System.Text.Encoding.UTF8.GetBytes(!outbox_payload)) in let body = store64 + \
        \"|\" + outbox64 in let digest = System.Convert.ToHexString(System.Security.Cryptography.SHA256.HashData(Syste\
        m.Text.Encoding.UTF8.GetBytes(body))) in let contender (owner : string) = System.Threading.Tasks.Task.Run(fun \
        () -> gate.Wait(); try use claim = new System.IO.FileStream(claimPath,System.IO.FileMode.CreateNew,System.IO.F\
        ileAccess.Write,System.IO.FileShare.None,4096,System.IO.FileOptions.WriteThrough) in let envelope = \
        System.String.Join(\"|\",[|owner;\"2\";store64;outbox64;digest|]) in let bytes = \
        System.Text.Encoding.UTF8.GetBytes(envelope) in use prepared = new \
        System.IO.FileStream(preparedPath,System.IO.FileMode.Create,System.IO.FileAccess.Write,System.IO.FileShare.Non\
        e,4096,System.IO.FileOptions.WriteThrough) in prepared.Write(bytes,0,bytes.Length); prepared.Flush(true); \
        claim.WriteByte(1uy); claim.Flush(true); System.IO.File.Move(preparedPath,committedPath,true); owner,1L with \
        :? System.IO.IOException -> owner,0L) in let first = contender \"atomic-owner-a\" in let second = contender \
        \"atomic-owner-b\" in gate.Set(); System.Threading.Tasks.Task.WaitAll([|first :> System.Threading.Tasks.Task; \
        second :> System.Threading.Tasks.Task|]); let firstOwner,firstWon = first.Result in let secondOwner,secondWon \
        = second.Result in let winners = firstWon + secondWon in let losers = 2L - winners in let winnerOwner = if \
        firstWon = 1L then firstOwner else secondOwner in let installed = \
        System.IO.File.ReadAllText(committedPath).Split('|') in let installedFence = \
        System.Int64.Parse(installed.[1]) in let decodedStore = \
        System.Text.Encoding.UTF8.GetString(System.Convert.FromBase64String(installed.[2])) in let decodedOutbox = \
        System.Text.Encoding.UTF8.GetString(System.Convert.FromBase64String(installed.[3])) in let payloadMatch = if \
        decodedStore = !store_payload && decodedOutbox = !outbox_payload then 1L else 0L in let installedBody = \
        installed.[2] + \"|\" + installed.[3] in let installedDigest = \
        System.Convert.ToHexString(System.Security.Cryptography.SHA256.HashData(System.Text.Encoding.UTF8.GetBytes(ins\
        talledBody))) in let digestMatch = if installed.[4] = installedDigest then 1L else 0L in let noPrepared = if \
        System.IO.File.Exists(preparedPath) then 0L else 1L in gate.Dispose(); System.IO.Directory.Delete(root,true); \
        let cleanup = if System.IO.Directory.Exists(root) then 0L else 1L in \
        winnerOwner,winners,losers,installedFence,payloadMatch,digestMatch,noPrepared,cleanup)"

:= erp_p2p_interprocess_atomic_successor_store_outbox_runtime
    (store_payload : string)
    (outbox_payload : string) : string * i64 * i64 * i64 * i64 * i64 * i64 * i64 =
    $"(let root = System.IO.Path.Combine(System.IO.Path.GetTempPath(), \"spiral-erp-interprocess-atomic-successor-\" \
        + System.Guid.NewGuid().ToString(\"N\")) in let _ = System.IO.Directory.CreateDirectory(root) in let \
        claimDirectory = System.IO.Path.Combine(root,\"successor.claim\") in let gatePath = \
        System.IO.Path.Combine(root,\"race.gate\") in let preparedPath = \
        System.IO.Path.Combine(root,\"successor.prepared\") in let committedPath = \
        System.IO.Path.Combine(root,\"successor.committed\") in let store64 = \
        System.Convert.ToBase64String(System.Text.Encoding.UTF8.GetBytes(!store_payload)) in let outbox64 = \
        System.Convert.ToBase64String(System.Text.Encoding.UTF8.GetBytes(!outbox_payload)) in let body = store64 + \
        \"|\" + outbox64 in let digest = System.Convert.ToHexString(System.Security.Cryptography.SHA256.HashData(Syste\
        m.Text.Encoding.UTF8.GetBytes(body))) in let contender (owner : string) = let info = new \
        System.Diagnostics.ProcessStartInfo() in info.FileName <- \"/bin/sh\"; info.UseShellExecute <- false; \
        info.ArgumentList.Add(\"-c\"); info.ArgumentList.Add(\"until /usr/bin/test -f $8; do /usr/bin/sleep 0.01; \
        done; if /bin/mkdir $1 2>/dev/null; then printf '%s|2|%s|%s|%s' $2 $3 $4 $5 > $6; /usr/bin/sync -f $6; \
        /bin/mv $6 $7; /usr/bin/sync -f $7; exit 0; else exit 1; fi\"); \
        info.ArgumentList.Add(\"erp-interprocess-atomic-successor\"); info.ArgumentList.Add(claimDirectory); \
        info.ArgumentList.Add(owner); info.ArgumentList.Add(store64); info.ArgumentList.Add(outbox64); \
        info.ArgumentList.Add(digest); info.ArgumentList.Add(preparedPath); info.ArgumentList.Add(committedPath); \
        info.ArgumentList.Add(gatePath); System.Diagnostics.Process.Start(info) in use first = contender \
        \"process-owner-a\" in use second = contender \"process-owner-b\" in \
        System.IO.File.WriteAllText(gatePath,\"go\"); first.WaitForExit(); second.WaitForExit(); let firstWon = if \
        first.ExitCode = 0 then 1L else 0L in let secondWon = if second.ExitCode = 0 then 1L else 0L in let winners = \
        firstWon + secondWon in let losers = 2L - winners in let winnerOwner = if firstWon = 1L then \
        \"process-owner-a\" else \"process-owner-b\" in let installed = \
        System.IO.File.ReadAllText(committedPath).Split('|') in let installedFence = \
        System.Int64.Parse(installed.[1]) in let decodedStore = \
        System.Text.Encoding.UTF8.GetString(System.Convert.FromBase64String(installed.[2])) in let decodedOutbox = \
        System.Text.Encoding.UTF8.GetString(System.Convert.FromBase64String(installed.[3])) in let payloadMatch = if \
        decodedStore = !store_payload && decodedOutbox = !outbox_payload then 1L else 0L in let installedBody = \
        installed.[2] + \"|\" + installed.[3] in let installedDigest = \
        System.Convert.ToHexString(System.Security.Cryptography.SHA256.HashData(System.Text.Encoding.UTF8.GetBytes(ins\
        talledBody))) in let digestMatch = if installed.[4] = installedDigest then 1L else 0L in let noPrepared = if \
        System.IO.File.Exists(preparedPath) then 0L else 1L in System.IO.Directory.Delete(root,true); let cleanup = \
        if System.IO.Directory.Exists(root) then 0L else 1L in winnerOwner,winners,losers,installedFence,payloadMatch,\
        digestMatch,noPrepared,cleanup)"

:= assert_erp_p2p_atomic_successor_store_outbox_runtime
    (winner_owner : string) (winners : i64) (losers : i64)
    (installed_fence : i64) (payload_match : i64) (digest_match : i64)
    (no_prepared : i64) (cleanup : i64) : () =
    $"if (!winner_owner <> \"process-owner-a\" && !winner_owner <> \"process-owner-b\") || !winners <> 1L || !losers \
        <> 1L || !installed_fence <> 2L || !payload_match <> 1L || !digest_match <> 1L || !no_prepared <> 1L || \
        !cleanup <> 1L then failwith \"erp-p2p-interprocess-atomic-successor-store-outbox-runtime-mismatch\""

:| erp_p2p_atomic_successor_store_outbox_receipt before after version from to =
    | ErpP2PAtomicSuccessorStoreOutbox :: \* before version from to.
        erp_p2p_fence_history (nat_succ before) *
        erp_p2p_event_commit_tree version from to * string ->
        erp_p2p_atomic_successor_store_outbox_receipt
            before (nat_succ before) version from to

:= erp_p2p_atomic_successor_store_outbox_commit \* version from to.
    (tree : erp_p2p_event_commit_tree version from to) :
    erp_p2p_atomic_successor_store_outbox_receipt
        nat_one nat_two version from to =
    := store = erp_p2p_event_commit_tree_store tree
    := outbox = erp_p2p_event_commit_tree_outbox tree
    := store_terminal = terminal (erp_p2p_event_store_replay store)
    := outbox_terminal = terminal (erp_p2p_event_outbox_replay outbox)
    := winner_owner, winners, losers, installed_fence,
        payload_match, digest_match, no_prepared, cleanup =
        erp_p2p_interprocess_atomic_successor_store_outbox_runtime
            store_terminal outbox_terminal
    := _ =
        assert_erp_p2p_atomic_successor_store_outbox_runtime
            winner_owner winners losers installed_fence
            payload_match digest_match no_prepared cleanup
    := before = erp_p2p_fence_history_one ()
    := after = erp_p2p_fence_history_takeover before winner_owner
    ErpP2PAtomicSuccessorStoreOutbox (
        after,
        tree,
        "one-exclusive-filesystem-claim-installs-both-successor-fence-two-and-the-four-event-commit-tree-payload-be"
        ^^ "fore-reopen"
    )

:= erp_p2p_four_event_atomic_successor_store_outbox_terminal () : string =
    := tree = erp_p2p_four_event_commit_tree ()
    := receipt =
        erp_p2p_atomic_successor_store_outbox_commit
            tree
    ?= receipt ?|
    | ErpP2PAtomicSuccessorStoreOutbox (
            after,
            recovered_tree,
            note
        )
        =>
            := recovered_store = erp_p2p_event_commit_tree_store recovered_tree
            := recovered_outbox = erp_p2p_event_commit_tree_outbox recovered_tree
            := store_version = erp_p2p_event_store_length recovered_store
            := outbox_version = erp_p2p_event_outbox_length recovered_outbox
            := store_terminal = terminal (erp_p2p_event_store_replay recovered_store)
            := outbox_terminal = terminal (erp_p2p_event_outbox_replay recovered_outbox)
            := _ =
                assert_erp_p2p_four_event_store_runtime
                    store_version outbox_version store_terminal outbox_terminal
            $"(if !note <> \"one-exclusive-filesystem-claim-installs-both-successor-fence-two-and-the-four-event-commi\
                t-tree-payload-before-reopen\" then failwith \"erp-p2p-four-event-interprocess-atomic-successor-store-\
                outbox-receipt-mismatch\")"
            "one-exclusive-physical-claim-now-selects-exactly-one-successor-owner-and-installs-fence-two-with-the-f"
            ^^ "our-event-store-outbox-payload-before-reopen-and-SHA256-validation"

:= erp_p2p_atomic_successor_wal_crash_cutpoint_runtime
    (store_payload : string)
    (outbox_payload : string) : i64 * i64 * i64 * i64 * i64 * i64 * i64 * i64 * i64 * i64 =
    $"(let root = System.IO.Path.Combine(System.IO.Path.GetTempPath(), \"spiral-erp-wal-cutpoints-\" + \
        System.Guid.NewGuid().ToString(\"N\")) in let _ = System.IO.Directory.CreateDirectory(root) in let walPath = \
        System.IO.Path.Combine(root,\"successor.wal\") in let committedPath = \
        System.IO.Path.Combine(root,\"successor.committed\") in let store64 = \
        System.Convert.ToBase64String(System.Text.Encoding.UTF8.GetBytes(!store_payload)) in let outbox64 = \
        System.Convert.ToBase64String(System.Text.Encoding.UTF8.GetBytes(!outbox_payload)) in let body = store64 + \
        \"|\" + outbox64 in let digest = System.Convert.ToHexString(System.Security.Cryptography.SHA256.HashData(Syste\
        m.Text.Encoding.UTF8.GetBytes(body))) in let envelope = \
        System.String.Join(\"|\",[|\"cutpoint-owner\";\"2\";store64;outbox64;digest|]) in let recover () = if \
        System.IO.File.Exists(committedPath) then ((if System.IO.File.Exists(walPath) then \
        System.IO.File.Delete(walPath) else ()); 2L) elif System.IO.File.Exists(walPath) then \
        (System.IO.File.Move(walPath,committedPath,true); 1L) else 0L in let crashAt mode = let info = new \
        System.Diagnostics.ProcessStartInfo() in info.FileName <- \"/bin/sh\"; info.UseShellExecute <- false; \
        info.ArgumentList.Add(\"-c\"); info.ArgumentList.Add(\"printf '%s' \\\"$1\\\" > \\\"$2\\\"; /usr/bin/sync -f \
        \\\"$2\\\"; if [ \\\"$4\\\" = wal ]; then /bin/kill -9 $$; fi; /bin/mv \\\"$2\\\" \\\"$3\\\"; /usr/bin/sync \
        -f \\\"$3\\\"; /bin/kill -9 $$\"); info.ArgumentList.Add(\"erp-wal-cutpoint\"); \
        info.ArgumentList.Add(envelope); info.ArgumentList.Add(walPath); info.ArgumentList.Add(committedPath); \
        info.ArgumentList.Add(mode); System.Diagnostics.Process.Start(info) in let beforeWal = recover() in use \
        walCrash = crashAt \"wal\" in walCrash.WaitForExit(); let walProcessKilled = if walCrash.ExitCode <> 0 then \
        1L else 0L in let afterWal = recover() in System.IO.File.Delete(committedPath); use renameCrash = crashAt \
        \"rename\" in renameCrash.WaitForExit(); let renameProcessKilled = if renameCrash.ExitCode <> 0 then 1L else \
        0L in let afterRename = recover() in let installed = System.IO.File.ReadAllText(committedPath).Split('|') in \
        let decodedStore = System.Text.Encoding.UTF8.GetString(System.Convert.FromBase64String(installed.[2])) in let \
        decodedOutbox = System.Text.Encoding.UTF8.GetString(System.Convert.FromBase64String(installed.[3])) in let \
        payloadMatch = if decodedStore = !store_payload && decodedOutbox = !outbox_payload then 1L else 0L in let \
        installedBody = installed.[2] + \"|\" + installed.[3] in let installedDigest = \
        System.Convert.ToHexString(System.Security.Cryptography.SHA256.HashData(System.Text.Encoding.UTF8.GetBytes(ins\
        talledBody))) in let digestMatch = if installed.[4] = installedDigest then 1L else 0L in \
        System.IO.File.WriteAllText(walPath,\"stale-cutpoint-wal\"); let stalePreferred = recover() in let noWal = if \
        System.IO.File.Exists(walPath) then 0L else 1L in System.IO.Directory.Delete(root,true); let cleanup = if \
        System.IO.Directory.Exists(root) then 0L else 1L in beforeWal,walProcessKilled,afterWal,renameProcessKilled,af\
        terRename,stalePreferred,payloadMatch,digestMatch,noWal,cleanup)"

:= assert_erp_p2p_atomic_successor_wal_crash_cutpoint_runtime
    (before_wal : i64) (wal_process_killed : i64) (after_wal : i64)
    (rename_process_killed : i64) (after_rename : i64) (stale_preferred : i64)
    (payload_match : i64) (digest_match : i64) (no_wal : i64) (cleanup : i64)
    : ()
    =
    := ok_0 = !!!!EQ(before_wal, 0i64)
    := ok_1 = !!!!EQ(wal_process_killed, 1i64)
    := ok_2 = !!!!EQ(after_wal, 1i64)
    := ok_3 = !!!!EQ(rename_process_killed, 1i64)
    := ok_4 = !!!!EQ(after_rename, 2i64)
    := ok_5 = !!!!EQ(stale_preferred, 2i64)
    := ok_6 = !!!!EQ(payload_match, 1i64)
    := ok_7 = !!!!EQ(digest_match, 1i64)
    := ok_8 = !!!!EQ(no_wal, 1i64)
    := ok_9 = !!!!EQ(cleanup, 1i64)
    ? ok_0 && ok_1 && ok_2 && ok_3 && ok_4 && ok_5 && ok_6 && ok_7 && ok_8 && ok_9
    ?> ()
    |: mega_runtime_fail "erp-p2p-atomic-successor-WAL-crash-cutpoint-runtime-mismatch"

:| erp_p2p_atomic_successor_wal_recovery_receipt version from to =
    | ErpP2PAtomicSuccessorWalRecovery :: \* version from to.
        erp_p2p_event_commit_tree version from to * string ->
        erp_p2p_atomic_successor_wal_recovery_receipt version from to

:= erp_p2p_atomic_successor_wal_recovery \* version from to.
    (tree : erp_p2p_event_commit_tree version from to)
    :
        erp_p2p_atomic_successor_wal_recovery_receipt version from to
    =
    := store = erp_p2p_event_commit_tree_store tree
    := outbox = erp_p2p_event_commit_tree_outbox tree
    := store_terminal = terminal (erp_p2p_event_store_replay store)
    := outbox_terminal = terminal (erp_p2p_event_outbox_replay outbox)
    := before_wal, wal_process_killed, after_wal,
        rename_process_killed, after_rename, stale_preferred,
        cutpoint_payload_match, cutpoint_digest_match, cutpoint_no_wal, cutpoint_cleanup =
        erp_p2p_atomic_successor_wal_crash_cutpoint_runtime
            store_terminal outbox_terminal
    := _ =
        assert_erp_p2p_atomic_successor_wal_crash_cutpoint_runtime
            before_wal wal_process_killed after_wal
            rename_process_killed after_rename stale_preferred
            cutpoint_payload_match cutpoint_digest_match cutpoint_no_wal cutpoint_cleanup
    ErpP2PAtomicSuccessorWalRecovery (
        tree,
        "the-four-event-commit-tree-envelope-survives-process-death-after-durable-WAL-and-after-rename-while-commit"
        ^^ "ted-dominates-a-later-stale-WAL"
    )

:= erp_p2p_four_event_atomic_successor_wal_recovery_terminal () : string =
    := tree = erp_p2p_four_event_commit_tree ()
    := receipt = erp_p2p_atomic_successor_wal_recovery tree
    ?= receipt ?|
    | ErpP2PAtomicSuccessorWalRecovery (
            recovered_tree,
            note
        )
        =>
            := recovered_store = erp_p2p_event_commit_tree_store recovered_tree
            := recovered_outbox = erp_p2p_event_commit_tree_outbox recovered_tree
            := store_version = erp_p2p_event_store_length recovered_store
            := outbox_version = erp_p2p_event_outbox_length recovered_outbox
            := store_terminal = terminal (erp_p2p_event_store_replay recovered_store)
            := outbox_terminal = terminal (erp_p2p_event_outbox_replay recovered_outbox)
            := _ =
                assert_erp_p2p_four_event_store_runtime
                    store_version outbox_version store_terminal outbox_terminal
            $"(if !note <> \"the-four-event-commit-tree-envelope-survives-process-death-after-durable-WAL-and-after-re\
                name-while-committed-dominates-a-later-stale-WAL\" then failwith \
                \"erp-p2p-atomic-successor-WAL-recovery-receipt-mismatch\")"
            "the-combined-successor-store-outbox-payload-now-recovers-a-durable-WAL-after-a-crash-before-rename-and"
            ^^ "-prefers-the-committed-envelope-over-a-later-stale-WAL"

