    | TypedFxHashedStatementEventLogMore (command, _, _), TypedFxHashedStatementHistoryContainsHere _ => command
    | TypedFxHashedStatementEventLogMore (_, tail, _), TypedFxHashedStatementHistoryContainsThere (prior, _) =>
