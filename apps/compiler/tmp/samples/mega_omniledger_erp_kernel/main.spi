    (expected_position : i64) (accepted_cells : i64)
    (rejected_cells : i64) : () =
    inl ok_0 = !!!!EQ(accepted, 1i64)
    inl ok_1 = !!!!EQ(rejected, 2i64)
    inl ok_2 = !!!!EQ(expected_position, 0i64)
    inl ok_3 = !!!!EQ(accepted_cells, 1i64)
