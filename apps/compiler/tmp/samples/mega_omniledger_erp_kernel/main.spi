inl erp_match_invoice_disk_reopened_typed_operation_terminal () : string =
    inl encoded_payload = erp_match_invoice_payload_frame (erp_p2p_match_invoice_plan ())
    inl event = erp_p2p_unit_event_from_op (erp_p2p_match_invoice_op ())
