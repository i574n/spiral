:| erp_match_invoice_typed_decode_authority =
    | ErpMatchInvoiceTypedDecodeAuthority :
        string *
        erp_op goods_partially_received invoice_three_way_matched
            (invoice_match company_a usd widget_a warehouse_north tax_brazil po_1001) *
        string

:= erp_match_invoice_typed_decode_authority_from_bytes (encoded : string) :
    erp_match_invoice_typed_decode_authority =
    := decoded_operation = erp_match_invoice_payload_decode_typed_operation encoded
    := reencoded = erp_match_invoice_operation_payload_frame decoded_operation
    := _ = assert_erp_match_invoice_payload_typed_decode_roundtrip_runtime encoded reencoded
    ErpMatchInvoiceTypedDecodeAuthority (encoded, decoded_operation, reencoded)

:= erp_match_invoice_disk_reopened_typed_operation_terminal () : string =
    := encoded_payload = erp_match_invoice_payload_frame (erp_p2p_match_invoice_plan ())
    := event = erp_p2p_unit_event_from_op (erp_p2p_match_invoice_op ())
    := outbox_message = erp_p2p_unit_outbox_message (erp_p2p_unit_outbox_project event)
    := reopened_payload
        , bytes, parse_valid, payload_equal, outbox_equal, digest_equal, prepared_absent, directory_sync,
        tamper_rejected, cleanup_absent
        =
        erp_typed_unit_atomic_event_outbox_runtime encoded_payload outbox_message
    := _ =
        assert_erp_typed_unit_atomic_event_outbox_runtime
            bytes
            parse_valid
            payload_equal
            outbox_equal
            digest_equal
            prepared_absent
            directory_sync
            tamper_rejected
            cleanup_absent
    := authority = erp_match_invoice_typed_decode_authority_from_bytes reopened_payload
    ?= authority ?|
    | ErpMatchInvoiceTypedDecodeAuthority (authority_bytes, decoded_operation, reencoded) =>
        := _ = assert_erp_match_invoice_payload_typed_decode_roundtrip_runtime reopened_payload authority_bytes
        := _ = assert_erp_match_invoice_payload_typed_decode_roundtrip_runtime authority_bytes reencoded
        := net_operation = erp_p2p_net_intercompany_op_from_decoded_match_invoice decoded_operation
        := settlement_operation = erp_p2p_settle_payment_from_decoded_net net_operation
        ?= decoded_operation, net_operation, settlement_operation ?|
        | MatchInvoice _, NetIntercompany _, SettlePayment _ =>
            "the-disk-reopened-MatchInvoice-operation-now-flows-directly-into-NetIntercompany-and-SettlePayment-wit"
            ^^ "hout-recreating-a-parallel-invoice-operation"

:= erp_match_invoice_payload_codec_terminal () : string =
    := encoded = erp_match_invoice_payload_frame (erp_p2p_match_invoice_plan ())
    := decoded = erp_match_invoice_payload_decode encoded
    := truncated : string =
        $"if !encoded.Length > 4 then !encoded.Substring(0, !encoded.Length - 4) else \"\""
    := rejected = erp_match_invoice_payload_decode truncated
    := accepted_tag = erp_match_invoice_payload_decode_tag decoded
    := rejected_tag = erp_match_invoice_payload_decode_tag rejected
    := _ =
        assert_erp_match_invoice_payload_codec_runtime
            accepted_tag (erp_runtime_add_i64 1i64 (erp_runtime_mul_i64 -1i64 rejected_tag))
    "MatchInvoice-now-has-a-seventeen-field-canonical-frame-and-a-fail-closed-decoder-that-reconstructs-the-exact-t"
    ^^ "yped-operation-only-after-PO-receipt-tax-identity-currency-item-document-location-quantity-and-tax-bindings-va"
    ^^ "lidate"

:= erp_settle_payment_operation_payload_frame \* result.
    (operation : erp_op intercompany_netted payment_settled result)
    : string
    =
    ?= operation ?|
    | SettlePayment (invoice_value, payment_value, route, payment_document_value) =>
        ?= invoice_value ?|
        | invoice_match (
                invoice_entity,
                invoice_currency,
                invoice_item,
                invoice_location,
                invoice_jurisdiction,
                invoice_document,
                invoice_identity
            )
            =>
                ?= payment_value ?|
                | money (payment_currency, payment_scale, payment_amount) =>
                    := numerator, denominator = settlement_fx_route_ratio route
                    $"(let fields = [| \"SettlePayment\"; !invoice_entity; !invoice_currency; !invoice_item; \
                        !invoice_location; !invoice_jurisdiction; !invoice_document; !invoice_identity; \
                        !payment_currency; string !payment_scale; string !payment_amount; \"2026-07\"; string \
                        !numerator; string !denominator; !payment_document_value |] in let bytes = fields |> \
                        Array.collect (fun value -> let payload = System.Text.Encoding.UTF8.GetBytes(value) in let \
                        length = System.BitConverter.GetBytes(System.Net.IPAddress.HostToNetworkOrder(payload.Length)) \
                        in Array.append length payload) in System.Convert.ToBase64String(bytes))"

:| erp_settle_payment_payload_decode_decision =
    | ErpSettlePaymentPayloadDecoded :: string -> erp_settle_payment_payload_decode_decision
    | ErpSettlePaymentPayloadRejected :: string -> erp_settle_payment_payload_decode_decision

:= erp_settle_payment_payload_validate_runtime (encoded : string) : i64 =
    $"(let tryDecode (text : string) = try let bytes = System.Convert.FromBase64String(text) in let mutable offset = \
        0 in let fields = System.Collections.Generic.List<string>() in let mutable valid = true in while valid && \
        offset < bytes.Length do if offset + 4 > bytes.Length then valid <- false else let raw = \
        System.BitConverter.ToInt32(bytes, offset) |> System.Net.IPAddress.NetworkToHostOrder in offset <- offset + \
        4; if raw < 0 || offset + raw > bytes.Length then valid <- false else \
        fields.Add(System.Text.Encoding.UTF8.GetString(bytes, offset, raw)); offset <- offset + raw done; if valid && \
        offset = bytes.Length then Some(fields.ToArray()) else None with _ -> None in let expected = [| \
        \"SettlePayment\"; \"company-a\"; \"USD\"; \"widget-a\"; \"warehouse-north\"; \"BR\"; \"po-1001\"; \
        \"invoice-match-1001\"; \"BRL\"; \"2\"; \"4980\"; \"2026-07\"; \"6\"; \"1\"; \"payment-3001\" |] in match \
        tryDecode !encoded with Some fields when fields.Length = expected.Length && Array.forall2 (=) fields expected \
        -> (match System.Int64.TryParse(fields.[9]), System.Int64.TryParse(fields.[10]), \
        System.Int64.TryParse(fields.[12]), System.Int64.TryParse(fields.[13]) with \
        (true,scale),(true,amount),(true,numerator),(true,denominator) when scale = 2L && amount = 4980L && numerator \
        = 6L && denominator = 1L -> 1L | _ -> 0L) | _ -> 0L)"

:= erp_settle_payment_payload_decode (encoded : string) : erp_settle_payment_payload_decode_decision =
    ?= erp_settle_payment_payload_validate_runtime encoded ?|
    | 1i64 => ErpSettlePaymentPayloadDecoded "canonical-SettlePayment-frame-validated"
    | _ => ErpSettlePaymentPayloadRejected "invalid-or-truncated-SettlePayment-frame"

:= erp_settle_payment_payload_decode_tag
    (decision : erp_settle_payment_payload_decode_decision) : i64 =
    ?= decision ?|
    | ErpSettlePaymentPayloadDecoded _ => 1i64
    | ErpSettlePaymentPayloadRejected _ => 0i64

:= assert_erp_settle_payment_payload_codec_runtime
    (accepted : i64) (truncated_rejected : i64) : () =
    := ok_0 = !!!!EQ(accepted, 1i64)
    := ok_1 = !!!!EQ(truncated_rejected, 1i64)
    ? ok_0 && ok_1 ?> () |: mega_runtime_fail "erp-SettlePayment-payload-codec-runtime-mismatch"

:! erp_settle_payment_payload_typed_certificate =
    invoice_match company_a usd widget_a warehouse_north tax_brazil po_1001 *
    money brl i64 *
    settlement_fx_ratio_certificate usd brl period_2026_07 *
    payment_3001

:| erp_settle_payment_payload_typed_decode_decision =
    | ErpSettlePaymentPayloadTypedDecoded ::
