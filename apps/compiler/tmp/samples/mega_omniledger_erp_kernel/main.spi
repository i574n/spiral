:| ^ typed_fx_hashed_statement_history_index command_identity aggregate_identity payload_hash history =
    | TypedFxHashedStatementHistoryIndexHere :: \* command_identity aggregate_identity payload_hash prior.
        string ->
        typed_fx_hashed_statement_history_index
            command_identity aggregate_identity payload_hash
            (typed_fx_hashed_statement_history_more command_identity aggregate_identity payload_hash prior)
    | TypedFxHashedStatementHistoryIndexThere :: \* command_identity aggregate_identity payload_hash other_identity
        other_aggregate other_hash prior.
        typed_fx_hashed_statement_history_index command_identity aggregate_identity payload_hash prior * string ->
        typed_fx_hashed_statement_history_index
            command_identity aggregate_identity payload_hash
            (typed_fx_hashed_statement_history_more other_identity other_aggregate other_hash prior)

:= ^ lookup_typed_fx_hashed_statement_history \* position command_identity aggregate_identity payload_hash
    history.
    (log : typed_fx_hashed_statement_event_log position history)
    (index : typed_fx_hashed_statement_history_index command_identity aggregate_identity payload_hash history)
    : typed_fx_hashed_statement_history_contains command_identity aggregate_identity payload_hash history *
    typed_fx_hashed_statement_command
        command_identity aggregate_identity payload_hash typed_fx_statement_command_applied
    =
    ?= log, index ?|
    | TypedFxHashedStatementEventLogMore (command, _, _), TypedFxHashedStatementHistoryIndexHere _ =>
        TypedFxHashedStatementHistoryContainsHere
            "the-directed-index-resolves-the-current-history-cell",
        command
    | TypedFxHashedStatementEventLogMore (_, tail, _), TypedFxHashedStatementHistoryIndexThere (prior_index, _) =>
        := proof, command = lookup_typed_fx_hashed_statement_history tail prior_index
        TypedFxHashedStatementHistoryContainsThere (
            proof,
            "the-directed-index-shifts-the-derived-membership-through-one-newer-cell"),
        command

:= ^ lookup_typed_fx_hashed_statement_history_by_membership \* position command_identity aggregate_identity
    payload_hash history.
    (log : typed_fx_hashed_statement_event_log position history)
    (proof : typed_fx_hashed_statement_history_contains command_identity aggregate_identity payload_hash history)
    : typed_fx_hashed_statement_command command_identity aggregate_identity payload_hash
        typed_fx_statement_command_applied
    =
    ?= log, proof ?|
    | TypedFxHashedStatementEventLogMore (command, _, _), TypedFxHashedStatementHistoryContainsHere _ => command
    | TypedFxHashedStatementEventLogMore (_, tail, _), TypedFxHashedStatementHistoryContainsThere (prior, _) =>
        lookup_typed_fx_hashed_statement_history_by_membership tail prior

:= typed_fx_hashed_statement_history_index_lookup_runtime \* position command_identity aggregate_identity
    payload_hash history.
    (log : typed_fx_hashed_statement_event_log position history)
    (index : typed_fx_hashed_statement_history_index command_identity aggregate_identity payload_hash history)
    : i64 * i64 * i64 * i64 * i64
    =
    := proof, _ = lookup_typed_fx_hashed_statement_history log index
    := command = lookup_typed_fx_hashed_statement_history_by_membership log proof
    := statements, debit, credit, mismatch =
        ?= command ?|
