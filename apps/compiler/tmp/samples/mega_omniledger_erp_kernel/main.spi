    | TypedFxHashedStatementHistoryIndexHere :: forall command_identity aggregate_identity payload_hash prior.
        string -> typed_fx_hashed_statement_history_index command_identity aggregate_identity payload_hash (typed_fx_hashed_statement_history_more command_identity aggregate_identity payload_hash prior)
    | TypedFxHashedStatementHistoryIndexThere :: forall command_identity aggregate_identity payload_hash other_identity other_aggregate other_hash prior.
        typed_fx_hashed_statement_history_index command_identity aggregate_identity payload_hash prior * string -> typed_fx_hashed_statement_history_index command_identity aggregate_identity payload_hash (typed_fx_hashed_statement_history_more other_identity other_aggregate other_hash prior)

inl rec lookup_typed_fx_hashed_statement_history forall position command_identity aggregate_identity payload_hash history.
