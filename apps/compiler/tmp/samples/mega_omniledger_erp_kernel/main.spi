            "the-top-membership-is-derived-from-the-indexed-recorded-log-head"

:= typed_fx_hashed_statement_top_collision_from_recorded_log
    \* position history command_identity aggregate_identity incoming_hash existing_hash.
    (recorded :
        typed_fx_hashed_statement_event_log
            (typed_fx_statement_stream_position_next position)
            (typed_fx_hashed_statement_history_more
                command_identity aggregate_identity existing_hash history))
    (difference : typed_fx_statement_payload_hash_not_equal incoming_hash existing_hash)
    : typed_fx_hashed_statement_identity_collision
        command_identity incoming_hash
        (typed_fx_hashed_statement_history_more
            command_identity aggregate_identity existing_hash history) =
    ?= recorded ?|
    | TypedFxHashedStatementEventLogMore _ =>
        TypedFxHashedStatementIdentityCollisionHere (
            difference,
