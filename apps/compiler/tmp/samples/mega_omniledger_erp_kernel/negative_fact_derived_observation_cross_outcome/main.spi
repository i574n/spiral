open main

inl impossible_fact_derived_observation_cross_outcome () : typed_fx_hashed_statement_closed_decision =
    inl _, recorded_history = typed_fx_hashed_statement_closed_history_values ()
    match recorded_history with
    | TypedFxHashedStatementClosedHistoryRecorded (recorded, _) =>
        inl collision =
            typed_fx_hashed_statement_top_collision_from_recorded_log
                recorded
                (TypedFxStatementPayloadHashPrimaryChanged "the-negative-collision-proof-cannot-inhabit-the-duplicate-observation")
        TypedFxHashedStatementClosedDuplicateExact (
            TypedFxHashedStatementEventStoreIdentityCollision (
                collision,
                recorded,
                "the-negative-collision-proof-is-indexed-by-the-recorded-primary-history"))

inl main () =
    impossible_fact_derived_observation_cross_outcome ()
