:< main

:= impossible_four_owner_lineage_cannot_force_nat_two () : erp_p2p_fence_history nat_two =
    := physical_lineage =
        ErpP2PPhysicalOwnerLineageTakeover (
            ErpP2PPhysicalOwnerLineageTakeover (
                ErpP2PPhysicalOwnerLineageTakeover (ErpP2PPhysicalOwnerLineageGenesis "owner-a", "owner-b"),
                "owner-c"
            ),
            "owner-d"
        )
    ?= erp_p2p_physical_owner_lineage_history_make physical_lineage ?|
    | erp_p2p_physical_owner_lineage_history payload =>
        := \? fence. history = payload
        history

:= main () =
    impossible_four_owner_lineage_cannot_force_nat_two ()
