open main

inl impossible_four_owner_lineage_cannot_force_nat_two () : erp_p2p_fence_history nat_two =
    inl physical_lineage =
        ErpP2PPhysicalOwnerLineageTakeover (ErpP2PPhysicalOwnerLineageTakeover (ErpP2PPhysicalOwnerLineageTakeover (ErpP2PPhysicalOwnerLineageGenesis "owner-a", "owner-b"), "owner-c"), "owner-d")
    match erp_p2p_physical_owner_lineage_history_make physical_lineage with
    | erp_p2p_physical_owner_lineage_history payload =>
        inl exists fence. history = payload
        history

inl main () =
    impossible_four_owner_lineage_cannot_force_nat_two ()
