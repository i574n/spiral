inl impossible_erp_p2p_outbox_detached_message () :
    erp_p2p_event_outbox nat_one requisition_drafted budget_reserved =
    inl event = erp_p2p_unit_event_from_plan (erp_p2p_reserve_budget_plan ())
    ErpP2PEventOutboxOne (event, "forged-outbox-message")

inl main () =
    impossible_erp_p2p_outbox_detached_message ()
