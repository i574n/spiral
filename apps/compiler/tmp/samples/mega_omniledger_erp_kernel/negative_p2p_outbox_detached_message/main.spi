// an event outbox entry carries only its event; a detached forged message cannot be attached (lane H 2026-10-06 rewrite; erp_p2p_unit_event_from_plan -> _from_op)
open main

inl impossible_erp_p2p_outbox_detached_message () : erp_p2p_event_outbox nat_one requisition_drafted budget_reserved =
    inl event = erp_p2p_unit_event_from_op (erp_p2p_reserve_budget_op ())
    ErpP2PEventOutboxOne (event, "forged-outbox-message")

inl main () =
    impossible_erp_p2p_outbox_detached_message ()
