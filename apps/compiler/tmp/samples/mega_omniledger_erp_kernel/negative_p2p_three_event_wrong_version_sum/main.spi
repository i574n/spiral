// a two+one store chain cannot use the 1+1=2 version proof (lane H 2026-10-06 rewrite; erp_p2p_unit_event_from_plan -> _from_op)
open main

inl impossible_erp_p2p_three_event_wrong_version_sum () : erp_p2p_event_store nat_three requisition_drafted purchase_order_issued =
    inl reserve_event = erp_p2p_unit_event_from_op (erp_p2p_reserve_budget_op ())
    inl approvals_event = erp_p2p_unit_event_from_op (erp_p2p_collect_approvals_op ())
    inl purchase_order_event = erp_p2p_unit_event_from_op (erp_p2p_issue_purchase_order_op ())
    inl first_store, _ = erp_p2p_event_commit_then reserve_event approvals_event
    inl final_store, _ = erp_p2p_event_commit_one purchase_order_event
    erp_p2p_event_store_then first_store final_store (v65_add_one_one_two ())

inl main () =
    impossible_erp_p2p_three_event_wrong_version_sum ()
