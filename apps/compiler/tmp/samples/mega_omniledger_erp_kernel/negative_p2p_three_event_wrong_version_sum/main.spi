:< main

:= impossible_erp_p2p_three_event_wrong_version_sum
    ()
    : erp_p2p_event_store nat_three requisition_drafted purchase_order_issued
    =
    := reserve_event = erp_p2p_unit_event_from_op (erp_p2p_reserve_budget_op ())
    := approvals_event = erp_p2p_unit_event_from_op (erp_p2p_collect_approvals_op ())
    := purchase_order_event = erp_p2p_unit_event_from_op (erp_p2p_issue_purchase_order_op ())
    := first_store, _ = erp_p2p_event_commit_then reserve_event approvals_event
    := final_store, _ = erp_p2p_event_commit_one purchase_order_event
    erp_p2p_event_store_then first_store final_store (v65_add_one_one_two ())

:= main () =
    impossible_erp_p2p_three_event_wrong_version_sum ()
