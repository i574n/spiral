inl impossible_erp_p2p_two_event_wrong_final_stage () :
    erp_p2p_event_store nat_two requisition_drafted budget_reserved *
        erp_p2p_event_outbox nat_two requisition_drafted budget_reserved =
    inl reserve_event =
        erp_p2p_unit_event_from_plan (erp_p2p_reserve_budget_plan ())
    inl approvals_event =
        erp_p2p_unit_event_from_plan (erp_p2p_collect_approvals_plan ())
    erp_p2p_event_commit_then reserve_event approvals_event

inl main () =
    impossible_erp_p2p_two_event_wrong_final_stage ()
