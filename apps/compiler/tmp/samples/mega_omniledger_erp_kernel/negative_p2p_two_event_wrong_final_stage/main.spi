// a reserve+approvals commit cannot end at budget_reserved (lane H 2026-10-06 rewrite; erp_p2p_unit_event_from_plan -> _from_op)
open main

inl impossible_erp_p2p_two_event_wrong_final_stage () : erp_p2p_event_store nat_two requisition_drafted budget_reserved * erp_p2p_event_outbox nat_two requisition_drafted budget_reserved =
    inl reserve_event = erp_p2p_unit_event_from_op (erp_p2p_reserve_budget_op ())
    inl approvals_event = erp_p2p_unit_event_from_op (erp_p2p_collect_approvals_op ())
    erp_p2p_event_commit_then reserve_event approvals_event

inl main () =
    impossible_erp_p2p_two_event_wrong_final_stage ()
