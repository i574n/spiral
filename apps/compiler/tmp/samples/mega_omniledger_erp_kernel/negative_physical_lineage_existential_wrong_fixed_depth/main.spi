// the history made from a four-owner physical lineage is existential and cannot be forced to a fixed depth (lane H 2026-10-06 rewrite; retired erp_p2p_physical_owner_lineage_apply_takeover_program -> lineage constructors)
open main

inl impossible_physical_lineage_existential_wrong_fixed_depth () : erp_p2p_fence_history nat_three =
    inl physical_lineage =
        ErpP2PPhysicalOwnerLineageTakeover (ErpP2PPhysicalOwnerLineageTakeover (ErpP2PPhysicalOwnerLineageTakeover (ErpP2PPhysicalOwnerLineageGenesis "owner-a", "owner-b"), "owner-c"), "owner-d")
    match erp_p2p_physical_owner_lineage_history_make physical_lineage with
    | erp_p2p_physical_owner_lineage_history payload =>
        inl exists fence. history = payload
        history

inl main () =
    impossible_physical_lineage_existential_wrong_fixed_depth ()
