:< main

:= impossible_recursive_payload_outbox_version_mismatch () =
    := four_store, _ = erp_p2p_four_event_commit ()
    := reserve_event = erp_p2p_unit_event_from_op (erp_p2p_reserve_budget_op ())
    := approvals_event = erp_p2p_unit_event_from_op (erp_p2p_collect_approvals_op ())
    := purchase_event = erp_p2p_unit_event_from_op (erp_p2p_issue_purchase_order_op ())
    := _, first_outbox = erp_p2p_event_commit_then reserve_event approvals_event
    := _, third_outbox = erp_p2p_event_commit_one purchase_event
    := three_outbox =
        erp_p2p_event_outbox_then first_outbox third_outbox (v65_add_two_one_three ())
    erp_p2p_recursive_atomic_payload_outbox_commit four_store three_outbox

:= main () =
    impossible_recursive_payload_outbox_version_mismatch ()
