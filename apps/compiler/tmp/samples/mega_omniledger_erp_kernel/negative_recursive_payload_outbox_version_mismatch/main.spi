open main

inl impossible_recursive_payload_outbox_version_mismatch () =
    inl four_store, _ = erp_p2p_four_event_commit ()
    inl reserve_event = erp_p2p_unit_event_from_plan (erp_p2p_reserve_budget_plan ())
    inl approvals_event = erp_p2p_unit_event_from_plan (erp_p2p_collect_approvals_plan ())
    inl purchase_event = erp_p2p_unit_event_from_plan (erp_p2p_issue_purchase_order_plan ())
    inl _, first_outbox = erp_p2p_event_commit_then reserve_event approvals_event
    inl _, third_outbox = erp_p2p_event_commit_one purchase_event
    inl three_outbox =
        erp_p2p_event_outbox_then first_outbox third_outbox (v65_add_two_one_three ())
    erp_p2p_recursive_atomic_payload_outbox_commit four_store three_outbox

inl main () =
    impossible_recursive_payload_outbox_version_mismatch ()
