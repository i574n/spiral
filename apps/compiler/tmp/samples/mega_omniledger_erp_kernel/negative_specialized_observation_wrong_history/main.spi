// the empty-at-zero position fact cannot decide the recorded history (lane H 2026-10-06 rewrite; retired decide_..._empty_primary_at_zero -> decide_typed_fx_hashed_statement_closed_fact_observation)
open main

inl impossible_specialized_observation_wrong_history () =
    inl empty_history, recorded_history = typed_fx_hashed_statement_closed_history_values ()
    decide_typed_fx_hashed_statement_closed_fact_observation
        recorded_history
        (TypedFxHashedStatementClosedFactPosition
            (TypedFxHashedStatementClosedPositionFactEmptyAtZero (
                TypedFxStatementExpectedStreamPosition (
                    TypedFxStatementStreamPositionZeroValue,
                    "the-empty-at-zero-observation-cannot-decide-the-recorded-history"))))

inl main () =
    impossible_specialized_observation_wrong_history ()
