// a fence-two history cannot stand for fence three in a multiprocess fenced commit receipt (lane H 2026-10-06 rewrite; retired erp_p2p_three_owner_fenced_lock_receipt -> ErpP2PMultiprocessFencedCommit)
open main

inl impossible_three_owner_fenced_lock_receipt_fence_mismatch () : erp_p2p_multiprocess_fenced_commit_receipt nat_one nat_three nat_four requisition_drafted goods_partially_received =
    inl store, outbox = erp_p2p_four_event_commit ()
    inl stale_one_three : erp_p2p_stale_fence nat_one nat_three = ErpP2PStaleLift ErpP2PStaleImmediate
    inl takeover : erp_p2p_fence_takeover_execution nat_one nat_three =
        ErpP2PFenceTakeoverExecution (erp_p2p_fence_history_two (), stale_one_three)
    inl execution = ErpP2PCrossProcessTakeoverExecution (takeover, "forged-fence-two-as-fence-three")
    ErpP2PMultiprocessFencedCommit
        (execution, store, outbox, "forged-fence-two-as-fence-three")

inl main () =
    impossible_three_owner_fenced_lock_receipt_fence_mismatch ()
