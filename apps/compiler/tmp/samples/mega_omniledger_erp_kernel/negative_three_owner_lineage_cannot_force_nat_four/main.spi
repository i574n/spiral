// the history made from a three-owner physical lineage is existential and cannot be forced to fence four (lane H 2026-10-06 rewrite; retired erp_p2p_physical_owner_lineage_from_takeover_program -> lineage constructors)
open main

inl impossible_three_owner_lineage_cannot_force_nat_four () : erp_p2p_fence_history nat_four =
    inl physical_lineage =
        ErpP2PPhysicalOwnerLineageTakeover (ErpP2PPhysicalOwnerLineageTakeover (ErpP2PPhysicalOwnerLineageGenesis "owner-a", "owner-b"), "owner-c")
    match erp_p2p_physical_owner_lineage_history_make physical_lineage with
    | erp_p2p_physical_owner_lineage_history payload =>
        inl exists fence. history = payload
        history

inl main () =
    impossible_three_owner_lineage_cannot_force_nat_four ()
