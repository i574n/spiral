inl rec exact_linear_indexed_small_step_source
    forall context source_usage target_usage ty.
    (step : exact_linear_indexed_small_step context source_usage target_usage ty)
    : exact_linear_indexed_term context source_usage ty =
    match step with
    | ExactLinearIndexedConditionalTrueStep payload =>
        inl exists guard_usage.
            guard_unused, then_branch, else_branch, source_merge, note = payload
        ExactLinearIndexedConditional (exists (
            ExactLinearIndexedBoolTrue (
                guard_unused,
                "the-True-small-step-source-reconstructs-the-Bool-guard-from-the-same-all-unused-proof"),
            then_branch,
            else_branch,
            source_merge,
            note))
    | ExactLinearIndexedConditionalFalseStep payload =>
        inl exists guard_usage.
            guard_unused, then_branch, else_branch, source_merge, note = payload
        ExactLinearIndexedConditional (exists (
            ExactLinearIndexedBoolFalse (
                guard_unused,
                "the-False-small-step-source-reconstructs-the-Bool-guard-from-the-same-all-unused-proof"),
            then_branch,
            else_branch,
            source_merge,
            note))
    | ExactLinearIndexedConditionalGuardStep payload =>
        inl exists guard_source_usage guard_target_usage branch_usage.
            guard_step, then_branch, else_branch, source_merge, _, note = payload
        ExactLinearIndexedConditional (exists (
            exact_linear_indexed_small_step_source guard_step,
            then_branch,
            else_branch,
            source_merge,
            note))

inl rec exact_linear_indexed_small_step_target
    forall context source_usage target_usage ty.
    (step : exact_linear_indexed_small_step context source_usage target_usage ty)
    : exact_linear_indexed_term context target_usage ty =
    match step with
    | ExactLinearIndexedConditionalTrueStep payload =>
        inl exists guard_usage.
            _, then_branch, _, _, _ = payload
        then_branch
    | ExactLinearIndexedConditionalFalseStep payload =>
        inl exists guard_usage.
            _, _, else_branch, _, _ = payload
        else_branch
    | ExactLinearIndexedConditionalGuardStep payload =>
        inl exists guard_source_usage guard_target_usage branch_usage.
            guard_step, then_branch, else_branch, _, target_merge, note = payload
        ExactLinearIndexedConditional (exists (
            exact_linear_indexed_small_step_target guard_step,
            then_branch,
            else_branch,
            target_merge,
            note))

