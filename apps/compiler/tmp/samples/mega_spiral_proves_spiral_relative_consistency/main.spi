inl rec exact_linear_indexed_bool_negation forall context usage ty.
    (term : exact_linear_indexed_term context usage ty)
    : exact_linear_indexed_term context usage ty =
    match term with
    | ExactLinearIndexedVariable payload => ExactLinearIndexedVariable payload
    | ExactLinearIndexedUnit payload => ExactLinearIndexedUnit payload
