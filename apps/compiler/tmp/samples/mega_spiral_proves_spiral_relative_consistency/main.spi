:! meta_zero = string
:! meta_succ n = n * string
:= reflected_runtime_add_i64 (left : i64) (right : i64) : i64 =
    !!!!Add(left, right)

:= reflected_runtime_mul_i64 (left : i64) (right : i64) : i64 =
    !!!!Mult(left, right)

:= reflected_runtime_fail \* t. (message : string) : t = !!!!FailWith(`t, message)

:| ^ meta_add left right total =
    | MetaAddZero :: \* right.
        string -> meta_add meta_zero right right
    | MetaAddSucc :: \* left right total.
        meta_add left right total * string ->
        meta_add (meta_succ left) right (meta_succ total)

:== exact_linear_zero = meta_zero
:== exact_linear_one = meta_succ meta_zero
:== exact_linear_add left right total = meta_add left right total

:! exact_linear_unit_type = string
:! exact_linear_bool_type = string
:! exact_linear_false_type = string
:! exact_linear_tensor_type left right = left * right
:! exact_linear_arrow_type domain codomain = domain * codomain

:| ^ exact_linear_type_witness ty =
    | ExactLinearTypeWitnessUnit :: string ->
        exact_linear_type_witness exact_linear_unit_type
    | ExactLinearTypeWitnessBool :: string ->
        exact_linear_type_witness exact_linear_bool_type
    | ExactLinearTypeWitnessFalse :: string ->
        exact_linear_type_witness exact_linear_false_type
    | ExactLinearTypeWitnessTensor :: \* left right.
        exact_linear_type_witness left *
        exact_linear_type_witness right * string ->
        exact_linear_type_witness (exact_linear_tensor_type left right)
    | ExactLinearTypeWitnessArrow :: \* domain codomain.
        exact_linear_type_witness domain *
        exact_linear_type_witness codomain * string ->
        exact_linear_type_witness (exact_linear_arrow_type domain codomain)

