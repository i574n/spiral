            tail left_slot left_domain * string ->
        exact_linear_free_context_membership_distinct
            (exact_linear_free_context_extend tail right_domain)
            (meta_succ left_slot) left_domain
            exact_linear_zero right_domain
    | ExactLinearFreeContextMembershipDistinctThereThere ::
        \* tail head left_slot left_domain right_slot right_domain.
        exact_linear_free_context_membership_distinct
