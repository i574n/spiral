        ExactLinearUsageVectorUnused (
            exact_linear_single_use_vector tail_shape tail_membership,
            "membership-there-keeps-the-newest-binder-unused-and-recurses")

inl rec exact_linear_usage_vector_runtime forall context.
    (usage : exact_linear_usage_vector context)
    : i64 * i64 * i64 =
    match usage with
    | ExactLinearUsageVectorEmpty =>
        0i64, 0i64, 0i64
    | ExactLinearUsageVectorUnused (tail, _) =>
        inl length, used, bitmap = exact_linear_usage_vector_runtime tail
        reflected_runtime_add_i64 1i64 length,
        used,
        reflected_runtime_mul_i64 2i64 bitmap
    | ExactLinearUsageVectorUsed (tail, _) =>
        inl length, used, bitmap = exact_linear_usage_vector_runtime tail
        reflected_runtime_add_i64 1i64 length,
        reflected_runtime_add_i64 1i64 used,
        reflected_runtime_add_i64 1i64
            (reflected_runtime_mul_i64 2i64 bitmap)

