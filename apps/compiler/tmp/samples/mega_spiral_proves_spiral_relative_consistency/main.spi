:| exact_linear_indexed_bool_literal_replacement =
    | ExactLinearIndexedBoolLiteralKeepTrue :: string ->
        exact_linear_indexed_bool_literal_replacement
    | ExactLinearIndexedBoolLiteralReplaceWithFalse :: string ->
        exact_linear_indexed_bool_literal_replacement

:= ^ exact_linear_indexed_replace_bool_true \* context usage ty.
    (replacement : exact_linear_indexed_bool_literal_replacement)
    (term : exact_linear_indexed_term context usage ty)
    : exact_linear_indexed_term context usage ty =
    ?= term ?|
    | ExactLinearIndexedVariable payload =>
        ExactLinearIndexedVariable payload
    | ExactLinearIndexedUnit payload =>
        ExactLinearIndexedUnit payload
    | ExactLinearIndexedBoolTrue (unused, note) =>
        ?= replacement ?|
        | ExactLinearIndexedBoolLiteralKeepTrue _ =>
            ExactLinearIndexedBoolTrue (unused, note)
        | ExactLinearIndexedBoolLiteralReplaceWithFalse _ =>
            ExactLinearIndexedBoolFalse (
                unused,
                "the-total-Bool-literal-replacement-preserves-the-exact-all-unused-index")
    | ExactLinearIndexedBoolFalse payload =>
        ExactLinearIndexedBoolFalse payload
    | ExactLinearIndexedTensor payload =>
        := \? left right. left_term, right_term, merge, note = payload
        ExactLinearIndexedTensor (\? (
            exact_linear_indexed_replace_bool_true replacement left_term,
            exact_linear_indexed_replace_bool_true replacement right_term,
            merge,
            note))
    | ExactLinearIndexedApplication payload =>
        := \? domain function_usage argument_usage.
            function_term, argument_term, merge, note = payload
        ExactLinearIndexedApplication (\? (
            exact_linear_indexed_replace_bool_true replacement function_term,
            exact_linear_indexed_replace_bool_true replacement argument_term,
            merge,
            note))
    | ExactLinearIndexedLambda (body, note) =>
        ExactLinearIndexedLambda (
            exact_linear_indexed_replace_bool_true replacement body,
            note)
    | ExactLinearIndexedConditional payload =>
        := \? guard_usage branch_usage.
            guard_term, true_branch, false_branch, merge, note = payload
        ExactLinearIndexedConditional (\? (
            exact_linear_indexed_replace_bool_true replacement guard_term,
            exact_linear_indexed_replace_bool_true replacement true_branch,
            exact_linear_indexed_replace_bool_true replacement false_branch,
            merge,
            note))

:= ^ exact_linear_indexed_bool_literal_profile \* context usage ty.
    (term : exact_linear_indexed_term context usage ty) : i64 * i64 =
    ?= term ?|
    | ExactLinearIndexedVariable _ => 0i64, 0i64
    | ExactLinearIndexedUnit _ => 0i64, 0i64
    | ExactLinearIndexedBoolTrue _ => 1i64, 0i64
    | ExactLinearIndexedBoolFalse _ => 0i64, 1i64
    | ExactLinearIndexedTensor payload =>
        := \? left right. left_term, right_term, _, _ = payload
        := left_true, left_false =
            exact_linear_indexed_bool_literal_profile left_term
        := right_true, right_false =
            exact_linear_indexed_bool_literal_profile right_term
        reflected_runtime_add_i64 left_true right_true,
        reflected_runtime_add_i64 left_false right_false
    | ExactLinearIndexedApplication payload =>
        := \? domain function_usage argument_usage.
            function_term, argument_term, _, _ = payload
        := function_true, function_false =
            exact_linear_indexed_bool_literal_profile function_term
        := argument_true, argument_false =
            exact_linear_indexed_bool_literal_profile argument_term
        reflected_runtime_add_i64 function_true argument_true,
        reflected_runtime_add_i64 function_false argument_false
    | ExactLinearIndexedLambda (body, _) =>
        exact_linear_indexed_bool_literal_profile body
    | ExactLinearIndexedConditional payload =>
        := \? guard_usage branch_usage.
            guard_term, true_branch, false_branch, _, _ = payload
        := guard_true, guard_false =
            exact_linear_indexed_bool_literal_profile guard_term
        := true_true, true_false =
            exact_linear_indexed_bool_literal_profile true_branch
        := false_true, false_false =
            exact_linear_indexed_bool_literal_profile false_branch
        reflected_runtime_add_i64 guard_true
            (reflected_runtime_add_i64 true_true false_true),
        reflected_runtime_add_i64 guard_false
            (reflected_runtime_add_i64 true_false false_false)

