:= ^ exact_linear_indexed_term_structural_size \* context usage ty.
    (term : exact_linear_indexed_term context usage ty) : i64 =
    ?= term ?|
    | ExactLinearIndexedVariable _ => 1i64
    | ExactLinearIndexedUnit _ => 1i64
    | ExactLinearIndexedBoolTrue _ => 1i64
    | ExactLinearIndexedBoolFalse _ => 1i64
    | ExactLinearIndexedTensor payload =>
        := \? left right. left_term, right_term, _, _ = payload
        reflected_runtime_add_i64 1i64
            (reflected_runtime_add_i64
                (exact_linear_indexed_term_structural_size left_term)
                (exact_linear_indexed_term_structural_size right_term))
    | ExactLinearIndexedApplication payload =>
        := \? domain function_usage argument_usage.
            function_term, argument_term, _, _ = payload
        reflected_runtime_add_i64 1i64
            (reflected_runtime_add_i64
                (exact_linear_indexed_term_structural_size function_term)
                (exact_linear_indexed_term_structural_size argument_term))
    | ExactLinearIndexedLambda (body, _) =>
        reflected_runtime_add_i64 1i64
            (exact_linear_indexed_term_structural_size body)
    | ExactLinearIndexedConditional _ => 1i64

:= exact_linear_indexed_tensor_lambda_for \* ty. () :
    exact_linear_indexed_term
        exact_linear_free_context_empty
        exact_linear_indexed_usage_empty
        (exact_linear_arrow_type
            ty
            (exact_linear_tensor_type ty exact_linear_unit_type)) =
    := variable :
        exact_linear_indexed_term
            (exact_linear_free_context_extend
                exact_linear_free_context_empty ty)
            (exact_linear_indexed_usage_used
                exact_linear_indexed_usage_empty)
            ty =
        ExactLinearIndexedVariable (\? (
            ExactLinearFreeContextMembershipHere
                "the-substitution-body-variable-is-the-newest-bound-cell",
            ExactLinearIndexedSingleUseHere (
                ExactLinearIndexedAllUnusedEmpty
                    "the-substitution-body-variable-has-an-empty-unused-tail",
                "the-substitution-body-consumes-the-bound-cell-exactly-once"),
            "membership-and-single-use-share-the-hidden-domain-type"))
    := unit_tail :
        exact_linear_indexed_term
            (exact_linear_free_context_extend
                exact_linear_free_context_empty ty)
            (exact_linear_indexed_usage_unused
                exact_linear_indexed_usage_empty)
            exact_linear_unit_type =
        ExactLinearIndexedUnit (
            ExactLinearIndexedAllUnusedExtend (
                ExactLinearIndexedAllUnusedEmpty
                    "the-substitution-unit-tail-starts-from-empty",
                "the-bound-domain-cell-is-unused-by-the-constant-Unit-tail"),
            "the-constant-Unit-tail-does-not-consume-the-bound-variable")
    := body :
        exact_linear_indexed_term
            (exact_linear_free_context_extend
                exact_linear_free_context_empty ty)
            (exact_linear_indexed_usage_used
                exact_linear_indexed_usage_empty)
            (exact_linear_tensor_type ty exact_linear_unit_type) =
        ExactLinearIndexedTensor (\? (
            variable,
            unit_tail,
            ExactLinearIndexedUsageMergeUsedUnused (
                ExactLinearIndexedUsageMergeEmpty
                    "the-substitution-body-merge-starts-at-empty",
                "only-the-left-tensor-child-consumes-the-bound-domain-cell"),
            "the-lambda-body-pairs-the-bound-value-with-a-constant-Unit"))
    ExactLinearIndexedLambda (
        body,
        "the-lambda-removes-the-single-used-domain-head-from-the-body-usage")

:= exact_linear_indexed_tensor_beta_source \* ty.
    (argument : exact_linear_indexed_term exact_linear_free_context_empty exact_linear_indexed_usage_empty ty)
