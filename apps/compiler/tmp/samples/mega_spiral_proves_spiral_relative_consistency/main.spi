union rec exact_linear_all_membership_spine context =
    | ExactLinearAllMembershipSpineDone ::
        exact_linear_all_membership_spine exact_linear_free_context_empty
    | ExactLinearAllMembershipSpineMore :: forall tail domain.
        exact_linear_all_membership_spine tail *
        exact_linear_free_context_membership
            (exact_linear_free_context_extend tail domain)
            exact_linear_zero domain * string ->
        exact_linear_all_membership_spine
            (exact_linear_free_context_extend tail domain)

inl rec derive_exact_linear_all_membership_spine forall context.
    (shape : exact_linear_free_context_shape context)
    : exact_linear_all_membership_spine context =
    match shape with
    | ExactLinearFreeContextShapeEmpty =>
        ExactLinearAllMembershipSpineDone
    | ExactLinearFreeContextShapeExtend (tail, _) =>
        ExactLinearAllMembershipSpineMore (
            derive_exact_linear_all_membership_spine tail,
            ExactLinearFreeContextMembershipHere
                "the-newest-context-cell-is-covered-exactly-once-by-membership-here",
            "the-all-membership-spine-recurses-over-the-tail-before-covering-the-newest-cell")

inl rec exact_linear_all_membership_spine_runtime forall context.
    (spine : exact_linear_all_membership_spine context) : i64 * i64 =
    match spine with
    | ExactLinearAllMembershipSpineDone => 0i64, 0i64
    | ExactLinearAllMembershipSpineMore (tail, membership, _) =>
        inl cells, slot_sum = exact_linear_all_membership_spine_runtime tail
        reflected_runtime_add_i64 1i64 cells,
        reflected_runtime_add_i64
            (exact_linear_free_context_membership_slot membership)
            slot_sum

inl assert_exact_linear_all_membership_spine_runtime
    (cells : i64) (local_slot_sum : i64) : () =
    $"if !cells <> 3L || !local_slot_sum <> 0L then failwith \"exact-linear-all-membership-spine-runtime-mismatch\""

inl exact_linear_all_membership_spine_terminal () : string =
    inl shape : exact_linear_free_context_shape exact_linear_unit_bool_unit_context =
        ExactLinearFreeContextShapeExtend (
            ExactLinearFreeContextShapeExtend (
                ExactLinearFreeContextShapeExtend (
                    ExactLinearFreeContextShapeEmpty,
                    "the-oldest-context-cell-is-Unit"),
                "the-middle-context-cell-is-Bool"),
            "the-newest-context-cell-is-Unit")
    inl cells, local_slot_sum =
        exact_linear_all_membership_spine_runtime
            (derive_exact_linear_all_membership_spine shape)
    inl _ =
        assert_exact_linear_all_membership_spine_runtime
            cells local_slot_sum
    "every-cell-of-an-arbitrary-structural-context-now-has-one-recursively-derived-membership-witness-in-an-indexed-spine-so-the-three-cell-Unit-Bool-Unit-context-covers-all-three-cells-without-caller-supplied-slots-sealed"

inl rec exact_linear_single_use_vector
    forall context slot domain.
    (shape : exact_linear_free_context_shape context)
    (membership : exact_linear_free_context_membership context slot domain)
    : exact_linear_usage_vector context =
