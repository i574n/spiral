            (exact_linear_arrow_type domain
                (exact_linear_tensor_type domain domain))

:= exact_linear_context_indexed_term_runtime \* context slot ty.
    (term : exact_linear_context_indexed_term context slot ty)
    : i64 * i64 * i64 * i64 * i64 * i64 =
