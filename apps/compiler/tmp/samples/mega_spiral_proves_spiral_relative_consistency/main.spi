:| ^ exact_linear_indexed_value context usage ty =
    | ExactLinearIndexedValueUnit :: \* context usage.
        exact_linear_indexed_all_unused context usage * string ->
        exact_linear_indexed_value context usage exact_linear_unit_type
    | ExactLinearIndexedValueBoolTrue :: \* context usage.
        exact_linear_indexed_all_unused context usage * string ->
        exact_linear_indexed_value context usage exact_linear_bool_type
    | ExactLinearIndexedValueBoolFalse :: \* context usage.
        exact_linear_indexed_all_unused context usage * string ->
        exact_linear_indexed_value context usage exact_linear_bool_type
    | ExactLinearIndexedValueTensor :: \* context total left_type right_type.
        (\? left_usage right_usage.
            exact_linear_indexed_value context left_usage left_type *
            exact_linear_indexed_value context right_usage right_type *
            exact_linear_indexed_usage_merge
                context left_usage right_usage total * string) ->
        exact_linear_indexed_value context total
            (exact_linear_tensor_type left_type right_type)
    | ExactLinearIndexedValueLambda :: \* context outer_usage domain codomain.
        exact_linear_indexed_term
            (exact_linear_free_context_extend context domain)
            (exact_linear_indexed_usage_used outer_usage)
            codomain * string ->
        exact_linear_indexed_value context outer_usage
            (exact_linear_arrow_type domain codomain)

:= ^ exact_linear_indexed_value_term \* context usage ty.
