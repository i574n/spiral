                context guard_usage branch_usage source_usage * string) ->
        exact_linear_indexed_small_step context source_usage branch_usage ty
    | ExactLinearIndexedConditionalFalseStep :: \* context source_usage branch_usage ty.
        (\? guard_usage.
            exact_linear_indexed_all_unused context guard_usage *
            exact_linear_indexed_term context branch_usage ty *
            exact_linear_indexed_term context branch_usage ty *
            exact_linear_indexed_usage_merge
                context guard_usage branch_usage source_usage * string) ->
        exact_linear_indexed_small_step context source_usage branch_usage ty
    | ExactLinearIndexedConditionalGuardStep :: \* context source_usage target_usage ty.
        (\? guard_source_usage guard_target_usage branch_usage.
            exact_linear_indexed_small_step
                context guard_source_usage guard_target_usage exact_linear_bool_type *
            exact_linear_indexed_term context branch_usage ty *
            exact_linear_indexed_term context branch_usage ty *
            exact_linear_indexed_usage_merge
                context guard_source_usage branch_usage source_usage *
            exact_linear_indexed_usage_merge
                context guard_target_usage branch_usage target_usage * string) ->
        exact_linear_indexed_small_step context source_usage target_usage ty

:= ^ exact_linear_indexed_small_step_source
    \* context source_usage target_usage ty.
    (step : exact_linear_indexed_small_step context source_usage target_usage ty)
    : exact_linear_indexed_term context source_usage ty =
    ?= step ?|
    | ExactLinearIndexedConditionalTrueStep payload =>
        := \? guard_usage.
            guard_unused, then_branch, else_branch, source_merge, note = payload
        ExactLinearIndexedConditional (\? (
            ExactLinearIndexedBoolTrue (
                guard_unused,
                "the-True-small-step-source-reconstructs-the-Bool-guard-from-the-same-all-unused-proof"),
            then_branch,
            else_branch,
            source_merge,
            note))
    | ExactLinearIndexedConditionalFalseStep payload =>
        := \? guard_usage.
            guard_unused, then_branch, else_branch, source_merge, note = payload
        ExactLinearIndexedConditional (\? (
            ExactLinearIndexedBoolFalse (
                guard_unused,
                "the-False-small-step-source-reconstructs-the-Bool-guard-from-the-same-all-unused-proof"),
            then_branch,
            else_branch,
            source_merge,
            note))
    | ExactLinearIndexedConditionalGuardStep payload =>
        := \? guard_source_usage guard_target_usage branch_usage.
            guard_step, then_branch, else_branch, source_merge, _, note = payload
        ExactLinearIndexedConditional (\? (
            exact_linear_indexed_small_step_source guard_step,
            then_branch,
            else_branch,
            source_merge,
            note))

:= ^ exact_linear_indexed_small_step_target
    \* context source_usage target_usage ty.
    (step : exact_linear_indexed_small_step context source_usage target_usage ty)
    : exact_linear_indexed_term context target_usage ty =
    ?= step ?|
    | ExactLinearIndexedConditionalTrueStep payload =>
        := \? guard_usage.
            _, then_branch, _, _, _ = payload
        then_branch
    | ExactLinearIndexedConditionalFalseStep payload =>
        := \? guard_usage.
            _, _, else_branch, _, _ = payload
        else_branch
    | ExactLinearIndexedConditionalGuardStep payload =>
        := \? guard_source_usage guard_target_usage branch_usage.
            guard_step, then_branch, else_branch, _, target_merge, note = payload
        ExactLinearIndexedConditional (\? (
            exact_linear_indexed_small_step_target guard_step,
            then_branch,
            else_branch,
            target_merge,
            note))

