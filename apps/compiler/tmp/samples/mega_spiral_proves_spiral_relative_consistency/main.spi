        exact_linear_indexed_term_structural_size identity,
        exact_linear_indexed_term_structural_size identity_target,
        exact_linear_indexed_term_outer_tag identity,
        exact_linear_indexed_term_outer_tag identity_target,
        exact_linear_indexed_term_structural_size tensor,
        exact_linear_indexed_term_structural_size tensor_target

