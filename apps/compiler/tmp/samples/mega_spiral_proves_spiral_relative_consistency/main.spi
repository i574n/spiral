inl exact_linear_add_zero_right forall right. () :
    exact_linear_add exact_linear_zero right right =
    MetaAddZero "zero-plus-right-preserves-the-exact-usage-index"


nominal exact_linear_free_context_empty = string
nominal exact_linear_free_context_extend tail domain = tail * domain

union rec exact_linear_free_context_membership context slot domain =
    | ExactLinearFreeContextMembershipHere :: forall tail domain.
        string ->
        exact_linear_free_context_membership
            (exact_linear_free_context_extend tail domain)
            exact_linear_zero domain
    | ExactLinearFreeContextMembershipThere :: forall tail head slot domain.
        exact_linear_free_context_membership tail slot domain * string ->
        exact_linear_free_context_membership
            (exact_linear_free_context_extend tail head)
            (meta_succ slot) domain

inl rec exact_linear_free_context_membership_slot
    forall context slot domain.
    (membership : exact_linear_free_context_membership context slot domain)
    : i64 =
    match membership with
    | ExactLinearFreeContextMembershipHere _ => 0i64
    | ExactLinearFreeContextMembershipThere (tail, _) =>
        reflected_runtime_add_i64 1i64
            (exact_linear_free_context_membership_slot tail)

type exact_linear_unit_bool_context =
    exact_linear_free_context_extend
        (exact_linear_free_context_extend
            exact_linear_free_context_empty exact_linear_bool_type)
        exact_linear_unit_type

