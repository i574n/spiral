union rec exact_linear_free_context_membership_distinct
    context left_slot left_domain right_slot right_domain =
    | ExactLinearFreeContextMembershipDistinctHereThere ::
        forall tail left_domain right_slot right_domain.
        exact_linear_free_context_membership
            tail right_slot right_domain * string ->
        exact_linear_free_context_membership_distinct
            (exact_linear_free_context_extend tail left_domain)
            exact_linear_zero left_domain
            (meta_succ right_slot) right_domain
    | ExactLinearFreeContextMembershipDistinctThereHere ::
        forall tail right_domain left_slot left_domain.
        exact_linear_free_context_membership
            tail left_slot left_domain * string ->
        exact_linear_free_context_membership_distinct
            (exact_linear_free_context_extend tail right_domain)
            (meta_succ left_slot) left_domain
            exact_linear_zero right_domain
    | ExactLinearFreeContextMembershipDistinctThereThere ::
        forall tail head left_slot left_domain right_slot right_domain.
        exact_linear_free_context_membership_distinct
            tail left_slot left_domain right_slot right_domain * string ->
        exact_linear_free_context_membership_distinct
            (exact_linear_free_context_extend tail head)
            (meta_succ left_slot) left_domain
            (meta_succ right_slot) right_domain

