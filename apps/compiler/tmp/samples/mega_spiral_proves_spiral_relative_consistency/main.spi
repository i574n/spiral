inl rec exact_linear_indexed_identity_substitution forall context usage ty.
    (term : exact_linear_indexed_term context usage ty)
    : exact_linear_indexed_term context usage ty =
    match term with
    | ExactLinearIndexedVariable payload =>
        ExactLinearIndexedVariable payload
    | ExactLinearIndexedUnit payload =>
        ExactLinearIndexedUnit payload
    | ExactLinearIndexedBoolTrue payload =>
        ExactLinearIndexedBoolTrue payload
    | ExactLinearIndexedBoolFalse payload =>
        ExactLinearIndexedBoolFalse payload
    | ExactLinearIndexedTensor payload =>
        inl exists left right. left_term, right_term, merge, note = payload
        ExactLinearIndexedTensor (exists (
            exact_linear_indexed_identity_substitution left_term,
            exact_linear_indexed_identity_substitution right_term,
            merge,
            note))
    | ExactLinearIndexedApplication payload =>
        inl exists domain function_usage argument_usage.
            function_term, argument_term, merge, note = payload
        ExactLinearIndexedApplication (exists (
            exact_linear_indexed_identity_substitution function_term,
            exact_linear_indexed_identity_substitution argument_term,
            merge,
            note))
    | ExactLinearIndexedLambda (body, note) =>
        ExactLinearIndexedLambda (
            exact_linear_indexed_identity_substitution body,
            note)
    | ExactLinearIndexedConditional payload =>
        inl exists guard_usage branch_usage.
            guard_term, true_branch, false_branch, merge, note = payload
        ExactLinearIndexedConditional (exists (
            exact_linear_indexed_identity_substitution guard_term,
            exact_linear_indexed_identity_substitution true_branch,
            exact_linear_indexed_identity_substitution false_branch,
            merge,
            note))

