    | ExactLinearContextIndexedFree (shape, membership, _) =>
        := length, used, bitmap =
            exact_linear_usage_vector_runtime
                (exact_linear_single_use_vector shape membership)
        0i64,
        exact_linear_free_context_membership_slot membership,
        length, used, bitmap,
        1i64
    | ExactLinearContextIndexedLambda (shape, membership, _) =>
        := length, used, bitmap =
            exact_linear_usage_vector_runtime
                (exact_linear_single_use_vector shape membership)
        1i64,
        exact_linear_free_context_membership_slot membership,
        length, used, bitmap,
        1i64

:= exact_linear_context_indexed_lambda_from_membership
    \* context slot domain.
    (shape : exact_linear_free_context_shape context)
    (membership : exact_linear_free_context_membership context slot domain)
    : exact_linear_context_indexed_term context slot (
        exact_linear_arrow_type domain
            (exact_linear_tensor_type domain domain)
    )
    =
    ExactLinearContextIndexedLambda (
        shape,
        membership,
        "the-canonical-context-indexed-lambda-is-constructed-directly-from-the-membership-that-determines-its-use-v"
        ^^ "ector"
    )

:= exact_linear_context_indexed_lambda_runtime
    \* context slot domain.
    (shape : exact_linear_free_context_shape context)
    (membership : exact_linear_free_context_membership context slot domain)
    : i64 * i64 * i64 * i64 * i64 =
    := lambda =
        exact_linear_context_indexed_lambda_from_membership shape membership
    := tag, lambda_slot, length, used, bitmap, resources =
        exact_linear_context_indexed_term_runtime lambda
    tag, lambda_slot, length, used,
    reflected_runtime_add_i64 bitmap resources

:= assert_exact_linear_context_indexed_lambda_runtime
    (tags : i64) (slots : i64) (lengths : i64)
    (used : i64) (bitmap_resources : i64)
    : ()
    =
    := ok_0 = !!!!EQ(tags, 2i64)
    := ok_1 = !!!!EQ(slots, 1i64)
    := ok_2 = !!!!EQ(lengths, 4i64)
    := ok_3 = !!!!EQ(used, 2i64)
    := ok_4 = !!!!EQ(bitmap_resources, 5i64)
    ? ok_0 && ok_1 && ok_2 && ok_3 && ok_4
    ?> ()
    |: reflected_runtime_fail "exact-linear-context-indexed-lambda-runtime-mismatch"

:= exact_linear_context_indexed_lambda_terminal () : string =
    := shape = exact_linear_unit_bool_context_shape ()
    := ut, us, ul, uu, ub =
        exact_linear_context_indexed_lambda_runtime
            shape
            (exact_linear_unit_bool_context_unit_membership ())
    := bt, bs, bl, bu, bb =
        exact_linear_context_indexed_lambda_runtime
            shape
            (exact_linear_unit_bool_context_bool_membership ())
    := _ =
        assert_exact_linear_context_indexed_lambda_runtime
            (reflected_runtime_add_i64 ut bt)
            (reflected_runtime_add_i64 us bs)
            (reflected_runtime_add_i64 ul bl)
            (reflected_runtime_add_i64 uu bu)
            (reflected_runtime_add_i64 ub bb)
    "the-contextual-wrapper-has-been-physically-retired-and-Unit-and-Bool-lambdas-now-enter-the-canonical-context-s"
    ^^ "lot-and-type-indexed-constructor-directly-from-their-memberships-preserving-two-lambda-tags-four-context-cells"
    ^^ "-two-uses-and-distinct-slots-sealed"

