    : exact_linear_indexed_term context usage ty =
    ?= value ?|
    | ExactLinearIndexedValueUnit payload =>
        ExactLinearIndexedUnit payload
    | ExactLinearIndexedValueBoolTrue payload =>
        ExactLinearIndexedBoolTrue payload
    | ExactLinearIndexedValueBoolFalse payload =>
        ExactLinearIndexedBoolFalse payload
    | ExactLinearIndexedValueTensor payload =>
        := \? left_usage right_usage.
            left_value, right_value, merge, note = payload
        ExactLinearIndexedTensor (\? (
            exact_linear_indexed_value_term left_value,
            exact_linear_indexed_value_term right_value,
            merge,
            note))
    | ExactLinearIndexedValueLambda payload =>
        ExactLinearIndexedLambda payload

