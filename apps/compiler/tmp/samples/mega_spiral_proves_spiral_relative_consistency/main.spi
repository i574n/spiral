inl rec exact_linear_indexed_term_structural_size forall context usage ty.
    (term : exact_linear_indexed_term context usage ty) : i64 =
    match term with
    | ExactLinearIndexedVariable _ => 1i64
    | ExactLinearIndexedUnit _ => 1i64
    | ExactLinearIndexedBoolTrue _ => 1i64
    | ExactLinearIndexedBoolFalse _ => 1i64
    | ExactLinearIndexedTensor payload =>
        inl exists left right. left_term, right_term, _, _ = payload
        reflected_runtime_add_i64 1i64
            (reflected_runtime_add_i64
                (exact_linear_indexed_term_structural_size left_term)
                (exact_linear_indexed_term_structural_size right_term))
    | ExactLinearIndexedApplication payload =>
        inl exists domain function_usage argument_usage.
            function_term, argument_term, _, _ = payload
        reflected_runtime_add_i64 1i64
            (reflected_runtime_add_i64
                (exact_linear_indexed_term_structural_size function_term)
                (exact_linear_indexed_term_structural_size argument_term))
    | ExactLinearIndexedLambda (body, _) =>
        reflected_runtime_add_i64 1i64
            (exact_linear_indexed_term_structural_size body)
    | ExactLinearIndexedConditional _ => 1i64

