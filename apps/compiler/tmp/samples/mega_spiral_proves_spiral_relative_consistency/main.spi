nominal meta_zero = string
nominal meta_succ n = n * string
inl reflected_runtime_add_i64 (left : i64) (right : i64) : i64 =
    $"!left + !right"

inl reflected_runtime_mul_i64 (left : i64) (right : i64) : i64 =
    $"!left * !right"

union rec meta_add left right total =
    | MetaAddZero :: forall right.
        string -> meta_add meta_zero right right
    | MetaAddSucc :: forall left right total.
        meta_add left right total * string ->
        meta_add (meta_succ left) right (meta_succ total)

type exact_linear_zero = meta_zero
type exact_linear_one = meta_succ meta_zero
type exact_linear_add left right total = meta_add left right total

nominal exact_linear_unit_type = string
nominal exact_linear_bool_type = string
nominal exact_linear_false_type = string
nominal exact_linear_tensor_type left right = left * right
nominal exact_linear_arrow_type domain codomain = domain * codomain

union rec exact_linear_type_witness ty =
    | ExactLinearTypeWitnessUnit :: string ->
        exact_linear_type_witness exact_linear_unit_type
    | ExactLinearTypeWitnessBool :: string ->
        exact_linear_type_witness exact_linear_bool_type
    | ExactLinearTypeWitnessFalse :: string ->
        exact_linear_type_witness exact_linear_false_type
    | ExactLinearTypeWitnessTensor :: forall left right.
        exact_linear_type_witness left *
        exact_linear_type_witness right * string ->
        exact_linear_type_witness (exact_linear_tensor_type left right)
    | ExactLinearTypeWitnessArrow :: forall domain codomain.
        exact_linear_type_witness domain *
        exact_linear_type_witness codomain * string ->
        exact_linear_type_witness (exact_linear_arrow_type domain codomain)

