:= ^ derive_exact_linear_all_membership_spine \* context.
    (shape : exact_linear_free_context_shape context)
    : exact_linear_all_membership_spine context =
    ?= shape ?|
    | ExactLinearFreeContextShapeEmpty =>
        ExactLinearAllMembershipSpineDone
    | ExactLinearFreeContextShapeExtend (tail, _) =>
        ExactLinearAllMembershipSpineMore (
            derive_exact_linear_all_membership_spine tail,
            ExactLinearFreeContextMembershipHere
                "the-newest-context-cell-is-covered-exactly-once-by-membership-here",
            "the-all-membership-spine-recurses-over-the-tail-before-covering-the-newest-cell")

:= ^ exact_linear_all_membership_spine_runtime \* context.
    (spine : exact_linear_all_membership_spine context) : i64 * i64 =
    ?= spine ?|
    | ExactLinearAllMembershipSpineDone => 0i64, 0i64
    | ExactLinearAllMembershipSpineMore (tail, membership, _) =>
        := cells, slot_sum = exact_linear_all_membership_spine_runtime tail
        reflected_runtime_add_i64 1i64 cells,
        reflected_runtime_add_i64
            (exact_linear_free_context_membership_slot membership)
            slot_sum

:= assert_exact_linear_all_membership_spine_runtime
    (cells : i64) (local_slot_sum : i64) : () =
    := ok_0 = !!!!EQ(cells, 3i64)
    := ok_1 = !!!!EQ(local_slot_sum, 0i64)
    ? ok_0 && ok_1 ?> () |: reflected_runtime_fail "exact-linear-all-membership-spine-runtime-mismatch"

:= exact_linear_all_membership_spine_terminal () : string =
    := shape : exact_linear_free_context_shape exact_linear_unit_bool_unit_context =
        ExactLinearFreeContextShapeExtend (
            ExactLinearFreeContextShapeExtend (
                ExactLinearFreeContextShapeExtend (
                    ExactLinearFreeContextShapeEmpty,
                    "the-oldest-context-cell-is-Unit"),
                "the-middle-context-cell-is-Bool"),
            "the-newest-context-cell-is-Unit")
    := cells, local_slot_sum =
        exact_linear_all_membership_spine_runtime
            (derive_exact_linear_all_membership_spine shape)
    := _ =
        assert_exact_linear_all_membership_spine_runtime
            cells local_slot_sum
    "every-cell-of-an-arbitrary-structural-context-now-has-one-recursively-derived-membership-witness-in-an-indexed"
    ^^ "-spine-so-the-three-cell-Unit-Bool-Unit-context-covers-all-three-cells-without-caller-supplied-slots-sealed"

