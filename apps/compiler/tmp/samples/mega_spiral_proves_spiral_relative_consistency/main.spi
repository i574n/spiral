:! exact_linear_free_context_empty = string
:! exact_linear_free_context_extend tail domain = tail * domain

:| ^ exact_linear_free_context_membership context slot domain =
    | ExactLinearFreeContextMembershipHere :: \* tail domain.
        string ->
        exact_linear_free_context_membership
            (exact_linear_free_context_extend tail domain)
