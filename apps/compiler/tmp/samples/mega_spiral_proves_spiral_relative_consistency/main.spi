:! exact_linear_disjoint_usage_bundle context =
    exact_linear_usage_vector context *
    exact_linear_usage_vector context *
    exact_linear_usage_vector context * string

:= ^ derive_exact_linear_disjoint_usage_bundle
    \* context left_slot left_domain right_slot right_domain.
    (shape : exact_linear_free_context_shape context)
    (distinct : exact_linear_free_context_membership_distinct context left_slot left_domain right_slot right_domain)
    : exact_linear_disjoint_usage_bundle context =
    ?= shape, distinct ?|
    | ExactLinearFreeContextShapeExtend (tail_shape, _),
      ExactLinearFreeContextMembershipDistinctHereThere (right_membership, _) =>
        := right_tail =
            exact_linear_single_use_vector tail_shape right_membership
        exact_linear_disjoint_usage_bundle (
            ExactLinearUsageVectorUsed (
                exact_linear_all_unused_usage_vector tail_shape,
                "the-left-here-membership-uses-the-newest-binder"),
            ExactLinearUsageVectorUnused (
                right_tail,
                "the-right-there-membership-leaves-the-newest-binder-unused"),
            ExactLinearUsageVectorUsed (
                right_tail,
                "the-merged-vector-uses-the-newest-binder-and-preserves-the-right-tail"),
            "here-there-merges-without-a-both-used-case")
    | ExactLinearFreeContextShapeExtend (tail_shape, _),
      ExactLinearFreeContextMembershipDistinctThereHere (left_membership, _) =>
        := left_tail =
            exact_linear_single_use_vector tail_shape left_membership
        exact_linear_disjoint_usage_bundle (
            ExactLinearUsageVectorUnused (
                left_tail,
                "the-left-there-membership-leaves-the-newest-binder-unused"),
            ExactLinearUsageVectorUsed (
                exact_linear_all_unused_usage_vector tail_shape,
                "the-right-here-membership-uses-the-newest-binder"),
            ExactLinearUsageVectorUsed (
                left_tail,
                "the-merged-vector-uses-the-newest-binder-and-preserves-the-left-tail"),
            "there-here-merges-without-a-both-used-case")
    | ExactLinearFreeContextShapeExtend (tail_shape, _),
      ExactLinearFreeContextMembershipDistinctThereThere (tail_distinct, _) =>
        ?= derive_exact_linear_disjoint_usage_bundle tail_shape tail_distinct ?|
        | exact_linear_disjoint_usage_bundle (left_tail, right_tail, merged_tail, _) =>
            exact_linear_disjoint_usage_bundle (
                ExactLinearUsageVectorUnused (
                    left_tail,
                    "both-memberships-cross-the-newest-unused-binder"),
                ExactLinearUsageVectorUnused (
                    right_tail,
                    "both-memberships-cross-the-newest-unused-binder"),
                ExactLinearUsageVectorUnused (
                    merged_tail,
                    "the-merge-crosses-the-newest-unused-binder"),
                "there-there-recurses-structurally")

:= exact_linear_disjoint_usage_bundle_runtime \* context.
    (bundle : exact_linear_disjoint_usage_bundle context)
    : i64 * i64 * i64 * i64 * i64 * i64 * i64 =
    ?= bundle ?|
    | exact_linear_disjoint_usage_bundle (left, right, merged, _) =>
        := _, left_used, left_bitmap = exact_linear_usage_vector_runtime left
        := _, right_used, right_bitmap = exact_linear_usage_vector_runtime right
        := length, merged_used, merged_bitmap = exact_linear_usage_vector_runtime merged
        left_used, right_used, merged_used,
        left_bitmap, right_bitmap, merged_bitmap, length

