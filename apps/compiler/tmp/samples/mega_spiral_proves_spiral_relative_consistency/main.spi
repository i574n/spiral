    =
    := ok_0 = !!!!EQ(identity_open_size, 1i64)
    := ok_1 = !!!!EQ(identity_source_size, 4i64)
    := ok_2 = !!!!EQ(identity_target_size, 1i64)
    := ok_3 = !!!!EQ(left_open_size, 3i64)
    := ok_4 = !!!!EQ(left_source_size, 6i64)
    := ok_5 = !!!!EQ(left_target_size, 3i64)
    := ok_6 = !!!!EQ(right_open_size, 3i64)
    := ok_7 = !!!!EQ(right_source_size, 6i64)
    := ok_8 = !!!!EQ(right_target_size, 3i64)
    := ok_9 = !!!!EQ(deep_open_size, 7i64)
    := ok_10 = !!!!EQ(deep_source_size, 10i64)
    := ok_11 = !!!!EQ(deep_target_size, 7i64)
    ? ok_0 && ok_1 && ok_2 && ok_3 && ok_4 && ok_5 && ok_6 && ok_7 && ok_8 && ok_9 && ok_10 && ok_11
    ?> ()
    |: reflected_runtime_fail "exact-linear-indexed-closed-recursive-beta-materialization-runtime-mismatch"

