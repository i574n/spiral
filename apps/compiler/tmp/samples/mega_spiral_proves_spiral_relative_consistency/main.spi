inl rec exact_linear_indexed_reduction_application_argument_depth
    forall context source_usage target_usage ty.
    (reduction : exact_linear_indexed_reduction context source_usage target_usage ty) : i64 =
    match reduction with
    | ExactLinearIndexedReductionClosedApplicationArgument payload =>
        inl exists domain. _, child_reduction, _ = payload
        reflected_runtime_add_i64 1i64
            (exact_linear_indexed_reduction_application_argument_depth child_reduction)
    | _ => 0i64

union rec exact_linear_indexed_closed_application_argument_trace ty =
    | ExactLinearIndexedClosedApplicationArgumentTraceBase :: forall ty.
        exact_linear_indexed_reduction
            exact_linear_free_context_empty
            exact_linear_indexed_usage_empty
            exact_linear_indexed_usage_empty
            ty ->
        exact_linear_indexed_closed_application_argument_trace ty
    | ExactLinearIndexedClosedApplicationArgumentTraceMore :: forall codomain.
        (exists domain.
            exact_linear_indexed_term
                exact_linear_free_context_empty
                exact_linear_indexed_usage_empty
                (exact_linear_arrow_type domain codomain) *
            exact_linear_indexed_closed_application_argument_trace domain *
            string) ->
        exact_linear_indexed_closed_application_argument_trace codomain

inl rec exact_linear_indexed_closed_application_argument_trace_reduction forall ty.
    (trace : exact_linear_indexed_closed_application_argument_trace ty) :
    exact_linear_indexed_reduction
        exact_linear_free_context_empty
        exact_linear_indexed_usage_empty
        exact_linear_indexed_usage_empty
        ty =
    match trace with
    | ExactLinearIndexedClosedApplicationArgumentTraceBase reduction => reduction
    | ExactLinearIndexedClosedApplicationArgumentTraceMore payload =>
        inl exists domain. function_term, inner_trace, note = payload
        ExactLinearIndexedReductionClosedApplicationArgument (exists (
            function_term,
            exact_linear_indexed_closed_application_argument_trace_reduction inner_trace,
            note))

inl rec exact_linear_indexed_closed_application_argument_trace_depth forall ty.
    (trace : exact_linear_indexed_closed_application_argument_trace ty) : i64 =
    match trace with
    | ExactLinearIndexedClosedApplicationArgumentTraceBase _ => 0i64
    | ExactLinearIndexedClosedApplicationArgumentTraceMore payload =>
        inl exists domain. _, inner_trace, _ = payload
        reflected_runtime_add_i64 1i64
            (exact_linear_indexed_closed_application_argument_trace_depth inner_trace)

inl rec exact_linear_indexed_reduction_source forall context source_usage target_usage ty.
    (proof : exact_linear_indexed_reduction context source_usage target_usage ty)
    : exact_linear_indexed_term context source_usage ty =
    match proof with
    | ExactLinearIndexedReductionConditional conditional_step =>
        exact_linear_indexed_small_step_source conditional_step
    | ExactLinearIndexedReductionClosedAtomic atomic_reduction =>
        exact_linear_indexed_closed_atomic_reduction_source atomic_reduction
    | ExactLinearIndexedReductionClosedTensorLeft (left_reduction, right_term, note) =>
        ExactLinearIndexedTensor (exists (
            exact_linear_indexed_reduction_source left_reduction,
            right_term,
            ExactLinearIndexedUsageMergeEmpty
                "the-general-Tensor-left-source-merge-is-empty",
            note))
    | ExactLinearIndexedReductionClosedTensorRight (left_term, right_reduction, note) =>
        ExactLinearIndexedTensor (exists (
            left_term,
            exact_linear_indexed_reduction_source right_reduction,
            ExactLinearIndexedUsageMergeEmpty
                "the-general-Tensor-right-source-merge-is-empty",
            note))
    | ExactLinearIndexedReductionClosedApplicationFunction payload =>
        inl exists domain.
            function_relation, argument_term, note = payload
        ExactLinearIndexedApplication (exists (
            exact_linear_indexed_reduction_source function_relation,
            argument_term,
            ExactLinearIndexedUsageMergeEmpty
                "the-specialized-Application-function-source-merge-is-empty",
            note))
    | ExactLinearIndexedReductionClosedApplicationArgument payload =>
        inl exists domain.
            function_term, argument_relation, note = payload
        ExactLinearIndexedApplication (exists (
            function_term,
            exact_linear_indexed_reduction_source argument_relation,
            ExactLinearIndexedUsageMergeEmpty
                "the-specialized-Application-argument-source-merge-is-empty",
            note))
    | ExactLinearIndexedReductionClosedRecursiveBeta payload =>
        inl exists domain. derivation, _ = payload
        exact_linear_indexed_closed_recursive_beta_derivation_source derivation
    | ExactLinearIndexedReductionBeta beta_step =>
        exact_linear_indexed_beta_step_source beta_step
    | ExactLinearIndexedReductionOpenIdentityBeta beta_step =>
        exact_linear_indexed_open_identity_beta_step_source beta_step
    | ExactLinearIndexedReductionOpenTensorBeta beta_step =>
        exact_linear_indexed_open_tensor_beta_step_source beta_step
    | ExactLinearIndexedReductionOpenApplicationBeta beta_step =>
        exact_linear_indexed_open_application_beta_step_source beta_step
    | ExactLinearIndexedReductionOpenLambdaBeta beta_step =>
        exact_linear_indexed_open_lambda_beta_step_source beta_step
    | ExactLinearIndexedReductionOpenConditionalBeta beta_step =>
        exact_linear_indexed_open_conditional_beta_step_source beta_step

