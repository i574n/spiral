:| ^ exact_linear_indexed_single_use context slot domain usage =
    | ExactLinearIndexedSingleUseHere :: \* tail tail_usage domain.
        exact_linear_indexed_all_unused tail tail_usage * string ->
        exact_linear_indexed_single_use
