union rec exact_linear_free_context_shape context =
    | ExactLinearFreeContextShapeEmpty ::
        exact_linear_free_context_shape exact_linear_free_context_empty
    | ExactLinearFreeContextShapeExtend :: forall tail domain.
        exact_linear_free_context_shape tail * string ->
        exact_linear_free_context_shape
            (exact_linear_free_context_extend tail domain)

union rec exact_linear_usage_vector context =
    | ExactLinearUsageVectorEmpty ::
        exact_linear_usage_vector exact_linear_free_context_empty
    | ExactLinearUsageVectorUnused :: forall tail domain.
        exact_linear_usage_vector tail * string ->
        exact_linear_usage_vector
            (exact_linear_free_context_extend tail domain)
    | ExactLinearUsageVectorUsed :: forall tail domain.
        exact_linear_usage_vector tail * string ->
        exact_linear_usage_vector
            (exact_linear_free_context_extend tail domain)

inl rec exact_linear_all_unused_usage_vector forall context.
    (shape : exact_linear_free_context_shape context)
    : exact_linear_usage_vector context =
    match shape with
    | ExactLinearFreeContextShapeEmpty =>
        ExactLinearUsageVectorEmpty
    | ExactLinearFreeContextShapeExtend (tail, _) =>
        ExactLinearUsageVectorUnused (
            exact_linear_all_unused_usage_vector tail,
            "the-newest-context-entry-is-unused")

inl rec exact_linear_all_used_usage_vector forall context.
    (shape : exact_linear_free_context_shape context)
    : exact_linear_usage_vector context =
    match shape with
    | ExactLinearFreeContextShapeEmpty =>
