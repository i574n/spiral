:| exact_linear_context_indexed_term context slot ty =
    | ExactLinearContextIndexedFree :: \* context slot domain.
        exact_linear_free_context_shape context *
        exact_linear_free_context_membership context slot domain * string ->
        exact_linear_context_indexed_term context slot domain
    | ExactLinearContextIndexedLambda :: \* context slot domain.
        exact_linear_free_context_shape context *
        exact_linear_free_context_membership context slot domain * string ->
