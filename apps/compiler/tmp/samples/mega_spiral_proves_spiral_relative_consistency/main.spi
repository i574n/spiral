    | ExactLinearFreeContextMembershipThere :: \* tail head slot domain.
        exact_linear_free_context_membership tail slot domain * string ->
        exact_linear_free_context_membership
            (exact_linear_free_context_extend tail head)
            (meta_succ slot) domain

:= ^ exact_linear_free_context_membership_slot
    \* context slot domain.
    (membership : exact_linear_free_context_membership context slot domain)
    : i64 =
    ?= membership ?|
    | ExactLinearFreeContextMembershipHere _ => 0i64
    | ExactLinearFreeContextMembershipThere (tail, _) =>
        reflected_runtime_add_i64 1i64
            (exact_linear_free_context_membership_slot tail)

