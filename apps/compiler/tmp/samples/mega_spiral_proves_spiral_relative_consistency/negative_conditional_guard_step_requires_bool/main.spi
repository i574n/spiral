open main

inl impossible_conditional_guard_step_requires_bool (guard_step : exact_linear_indexed_small_step exact_linear_free_context_empty exact_linear_indexed_usage_empty exact_linear_indexed_usage_empty exact_linear_unit_type) : exact_linear_indexed_small_step exact_linear_free_context_empty exact_linear_indexed_usage_empty exact_linear_indexed_usage_empty exact_linear_unit_type =
    ExactLinearIndexedConditionalGuardStep (exists (
        guard_step,
        ExactLinearIndexedUnit (
            exact_linear_indexed_empty_usage (),
            "the-invalid-contextual-step-then-branch-is-Unit"),
        ExactLinearIndexedUnit (
            exact_linear_indexed_empty_usage (),
            "the-invalid-contextual-step-else-branch-is-Unit"),
        ExactLinearIndexedUsageMergeEmpty
            "the-invalid-contextual-step-source-merge-is-empty",
        ExactLinearIndexedUsageMergeEmpty
            "the-invalid-contextual-step-target-merge-is-empty",
        "a-Unit-step-cannot-be-used-as-the-Bool-guard-step"))

inl main () =
    impossible_conditional_guard_step_requires_bool
        (exact_linear_indexed_conditional_true_unit_step ())
