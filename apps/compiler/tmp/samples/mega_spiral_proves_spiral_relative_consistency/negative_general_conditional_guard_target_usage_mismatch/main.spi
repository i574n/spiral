inl impossible_general_conditional_guard_target_usage_mismatch
    (guard_reduction : exact_linear_indexed_reduction
        exact_linear_free_context_empty
        exact_linear_indexed_usage_empty
        exact_linear_indexed_usage_empty
        exact_linear_bool_type)
    (branch : exact_linear_indexed_term
        exact_linear_free_context_empty
        exact_linear_indexed_usage_empty
        exact_linear_unit_type)
    : exact_linear_indexed_reduction
        exact_linear_free_context_empty
        exact_linear_indexed_usage_empty
        (exact_linear_indexed_usage_used exact_linear_indexed_usage_empty)
        exact_linear_unit_type =
    ExactLinearIndexedReductionConditionalGuard (
        guard_reduction,
        branch,
        branch,
        ExactLinearIndexedUsageMergeEmpty
            "the-source-merge-is-correctly-empty",
        ExactLinearIndexedUsageMergeEmpty
            "this-empty-target-merge-must-not-inhabit-a-used-target-index",
        "the-general-Conditional-guard-congruence-must-preserve-the-exact-target-usage")

inl main () =
    inl empty_usage = exact_linear_indexed_empty_usage ()
    inl guard_step : exact_linear_indexed_small_step
        exact_linear_free_context_empty
        exact_linear_indexed_usage_empty
        exact_linear_indexed_usage_empty
        exact_linear_bool_type =
        ExactLinearIndexedConditionalTrueStep (exists (
            empty_usage,
            ExactLinearIndexedBoolFalse (
                empty_usage,
                "the-negative-guard-then-branch-is-closed"),
            ExactLinearIndexedBoolTrue (
                empty_usage,
                "the-negative-guard-else-branch-is-closed"),
            ExactLinearIndexedUsageMergeEmpty
                "the-negative-guard-source-is-closed",
            "the-inner-guard-step-is-well-typed"))
    inl guard_reduction = ExactLinearIndexedReductionConditional guard_step
    inl branch = ExactLinearIndexedUnit (
        empty_usage,
        "the-negative-outer-branch-is-closed")
    impossible_general_conditional_guard_target_usage_mismatch
        guard_reduction branch
