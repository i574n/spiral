open main

inl impossible_open_application_beta_target_type_mismatch
    (step : exact_linear_indexed_open_application_beta_step exact_linear_unit_type)
    : exact_linear_indexed_term
        (exact_linear_free_context_extend
            exact_linear_free_context_empty exact_linear_unit_type)
        (exact_linear_indexed_usage_used exact_linear_indexed_usage_empty)
        exact_linear_bool_type =
    exact_linear_indexed_open_application_beta_step_target step

inl main () =
    impossible_open_application_beta_target_type_mismatch
        (exact_linear_indexed_open_application_beta_step_witness ())
