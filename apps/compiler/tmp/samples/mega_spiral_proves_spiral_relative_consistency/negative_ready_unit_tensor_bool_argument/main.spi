// Ready beta keeps the function domain and the argument type aligned: the Unit TensorTail Lambda cannot take a Bool argument (ExactLinearIndexedClosedReadyBetaUnitTensor is retired; its successor is the polymorphic ExactLinearIndexedClosedReadyBetaTensorTail).
open main

inl impossible_ready_unit_tensor_accepts_bool_argument () =
    inl function_source : exact_linear_indexed_closed_value_source (exact_linear_indexed_closed_source_lambda exact_linear_unit_type (exact_linear_tensor_type exact_linear_unit_type exact_linear_unit_type)) (exact_linear_arrow_type exact_linear_unit_type (exact_linear_tensor_type exact_linear_unit_type exact_linear_unit_type)) =
        ExactLinearIndexedClosedValueSourceLambda (
            exact_linear_indexed_closed_lambda_value_source (
                exact_linear_indexed_closed_tensor_tail_lambda_value,
                "the-unit-TensorTail-Lambda-is-a-closed-value"))
    inl argument = ExactLinearIndexedClosedValueSourceBoolTrue "the-Bool-argument-is-a-closed-value-but-has-the-wrong-domain-for-this-Ready-beta"
    ExactLinearIndexedClosedReadyBetaTensorTail (
        function_source,
        argument,
        "this-construction-must-be-rejected-because-Ready-beta-keeps-the-function-domain-and-argument-type-aligned")

inl main () =
    impossible_ready_unit_tensor_accepts_bool_argument ()
