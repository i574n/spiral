open main

// Type applications on one line: the parser drops a definition whose annotation continues on the next line, without a
// diagnostic (FOR-D, samples/multiline_type_application_dropped), and this negative then compiled vacuously.
inl impossible_recursive_beta_application_identity_cannot_change_result
    (derivation : exact_linear_indexed_closed_recursive_beta_derivation exact_linear_bool_type (exact_linear_tensor_type exact_linear_bool_type exact_linear_unit_type))
    : exact_linear_indexed_closed_recursive_beta_derivation exact_linear_bool_type exact_linear_unit_type =
    ExactLinearIndexedClosedRecursiveBetaDerivationApplicationIdentity (
        derivation,
        "ApplicationIdentity-must-preserve-the-recursive-beta-result-type")

inl main () = ()