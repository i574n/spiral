// A TensorLeftUnit wrapper changes the derivation's result to Tensor Bool Unit: it cannot hide behind a Bool result index (successor of the retired ExactLinearIndexedClosedRecursiveBetaRelation).
open main

inl impossible_recursive_beta_result_mismatch () : exact_linear_indexed_closed_recursive_beta_derivation exact_linear_bool_type exact_linear_bool_type =
    ExactLinearIndexedClosedRecursiveBetaDerivationTensorLeftUnit (
        ExactLinearIndexedClosedRecursiveBetaDerivationBound (
            ExactLinearIndexedBoolTrue (
                ExactLinearIndexedAllUnusedEmpty
                    "the-negative-Bool-argument-is-closed",
                "the-negative-argument-matches-the-body-domain"),
            "the-negative-inner-body-binds-Bool"),
        "the-negative-tries-to-hide-a-Tensor-result-behind-a-Bool-index")

inl main () = impossible_recursive_beta_result_mismatch ()
