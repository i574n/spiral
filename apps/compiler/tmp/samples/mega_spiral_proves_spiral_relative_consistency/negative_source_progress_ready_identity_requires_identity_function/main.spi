// The Ready identity witness is indexed by the canonical identity application: it cannot be indexed as the application of a non-identity (Unit-to-Tensor) Lambda (the function-taking ExactLinearIndexedClosedSourceProgressApplicationReadyIdentity is retired; its successor ExactLinearIndexedClosedReadyBetaIdentity has no function slot, so the misuse moves to the source index).
open main

inl impossible_source_progress_ready_identity_requires_identity_function () : exact_linear_indexed_closed_ready_beta_or_neutral (exact_linear_indexed_closed_source_application_ready_unit_tensor exact_linear_indexed_closed_source_unit) exact_linear_unit_type =
    inl argument_source :
        exact_linear_indexed_closed_value_source
            exact_linear_indexed_closed_source_unit
            exact_linear_unit_type =
        ExactLinearIndexedClosedValueSourceUnit
            "the-Unit-argument-has-the-domain-needed-by-the-nonidentity-Lambda"
    ExactLinearIndexedClosedReadyBetaIdentity (
        argument_source,
        "this-must-be-rejected-because-the-Ready-identity-witness-is-indexed-by-the-canonical-identity-Lambda-not-an-arbitrary-closed-Lambda")

inl main () =
    impossible_source_progress_ready_identity_requires_identity_function ()
