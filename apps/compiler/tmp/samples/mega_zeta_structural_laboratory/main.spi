        | PositivePositionalOrderDecisionEqual equal =>
            CertifiedIntervalPositivePositionalPrimeMultiplicityRunAgreementMatched (
                CertifiedIntervalPositivePositionalPrimeMultiplicityRunAgreementLast (
                    left_cell,
                    right_cell,
                    equal))
        | PositivePositionalOrderDecisionLess less =>
            CertifiedIntervalPositivePositionalPrimeMultiplicityRunAgreementMismatch (
                CertifiedIntervalPositivePositionalPrimeMultiplicityRunMismatchHeadLess less)
        | PositivePositionalOrderDecisionGreater greater =>
            CertifiedIntervalPositivePositionalPrimeMultiplicityRunAgreementMismatch (
                CertifiedIntervalPositivePositionalPrimeMultiplicityRunMismatchHeadGreater greater)
    | CertifiedIntervalPositivePositionalPrimeMultiplicityRunMore left_payload,
      CertifiedIntervalPositivePositionalPrimeMultiplicityRunMore right_payload =>
        inl exists left_next. left_cell, left_equal, left_tail = left_payload
        inl exists right_next. right_cell, right_equal, right_tail = right_payload
        inl left_value =
            certified_interval_positive_positional_indexed_prime_cell_value left_cell
        inl right_value =
            certified_interval_positive_positional_indexed_prime_cell_value right_cell
        match synthesize_positive_positional_order left_value right_value with
        | PositivePositionalOrderDecisionEqual equal =>
            match decide_certified_interval_positive_positional_prime_multiplicity_run_agreement
                    left_tail right_tail with
            | CertifiedIntervalPositivePositionalPrimeMultiplicityRunAgreementMatched tail =>
                CertifiedIntervalPositivePositionalPrimeMultiplicityRunAgreementMatched (
                    CertifiedIntervalPositivePositionalPrimeMultiplicityRunAgreementMore (exists (
                        left_cell,
                        left_equal,
                        right_cell,
                        right_equal,
                        equal,
                        tail)))
            | CertifiedIntervalPositivePositionalPrimeMultiplicityRunAgreementMismatch tail_mismatch =>
                CertifiedIntervalPositivePositionalPrimeMultiplicityRunAgreementMismatch (
                    CertifiedIntervalPositivePositionalPrimeMultiplicityRunMismatchTail (exists (
                        left_cell,
                        left_equal,
                        left_tail,
                        right_cell,
                        right_equal,
                        right_tail,
                        equal,
                        tail_mismatch)))
        | PositivePositionalOrderDecisionLess less =>
            CertifiedIntervalPositivePositionalPrimeMultiplicityRunAgreementMismatch (
                CertifiedIntervalPositivePositionalPrimeMultiplicityRunMismatchHeadLess less)
        | PositivePositionalOrderDecisionGreater greater =>
            CertifiedIntervalPositivePositionalPrimeMultiplicityRunAgreementMismatch (
