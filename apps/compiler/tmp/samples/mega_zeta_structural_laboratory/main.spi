:= ^ positive_positional_equal_reflexive \* natural.
    (value : positive_positional_nat natural)
    : positive_positional_equal natural natural =
    ?= value ?|
    | PositivePositionalOne => PositivePositionalEqualOne
    | PositivePositionalZeroBit tail =>
        PositivePositionalEqualZeroBit
            (positive_positional_equal_reflexive tail)
    | PositivePositionalOneBit tail =>
        PositivePositionalEqualOneBit
            (positive_positional_equal_reflexive tail)

:= ^ positive_positional_predecessor_unique \* input left right.
    (left_predecessor : positive_positional_predecessor input left)
    (right_predecessor : positive_positional_predecessor input right)
    : positive_positional_equal left right =
    ?= left_predecessor, right_predecessor ?|
    | PositivePositionalPredecessorTwo,
      PositivePositionalPredecessorTwo =>
        PositivePositionalEqualOne
    | PositivePositionalPredecessorZeroBitHigher left_tail,
      PositivePositionalPredecessorZeroBitHigher right_tail =>
        PositivePositionalEqualOneBit (
            positive_positional_predecessor_unique left_tail right_tail)
    | PositivePositionalPredecessorOneBit input_value,
      PositivePositionalPredecessorOneBit _ =>
        PositivePositionalEqualZeroBit (
            positive_positional_equal_reflexive input_value)

:= positive_positional_predecessor_unique_terminal () : string =
    := explicit = positional_six_predecessor_five ()
    ?= synthesize_positive_positional_predecessor (positive_positional_six_value ()) ?|
    | PositivePositionalPredecessorResultSome payload =>
        := \? synthesized_output. _, synthesized = payload
        := _ = positive_positional_predecessor_unique explicit synthesized
        "the-structural-predecessor-of-one-positive-positional-parent-is-unique-so-the-explicit-six-to-five-proof-a"
        ^^ "nd-the-independently-synthesized-six-predecessor-must-index-the-same-child"

:= ^ positive_positional_predecessor_implies_less \* input output.
    (predecessor : positive_positional_predecessor input output)
    : positive_positional_less output input =
    ?= predecessor ?|
    | PositivePositionalPredecessorTwo =>
        PositivePositionalLessOneZeroBit PositivePositionalOne
    | PositivePositionalPredecessorZeroBitHigher tail =>
        PositivePositionalLessHigherOneZero
            (positive_positional_predecessor_implies_less tail)
    | PositivePositionalPredecessorOneBit tail =>
        PositivePositionalLessSameTailZeroOne
            (positive_positional_equal_reflexive tail)


:= positive_positional_predecessor_less_runtime \* input output.
    (input_value : positive_positional_nat input)
    (output_value : positive_positional_nat output)
    (_ : positive_positional_less output input) : i64 * i64 =
    positive_positional_nat_to_i64 input_value,
    positive_positional_nat_to_i64 output_value

:= assert_positive_positional_predecessor_less_runtime
    (input : i64) (output : i64) : () =
    := ok_0 = !!!!EQ(input, 12i64)
    := ok_1 = !!!!EQ(output, 11i64)
    := ok_2 = !!!!LT(output, input)
    ? ok_0 && ok_1 && ok_2 ?> () |: mega_runtime_fail "positive-positional-predecessor-less-runtime-mismatch"

:= positive_positional_predecessor_less_terminal () : string =
    ?=
        synthesize_positive_positional_predecessor (
            positive_positional_twelve_value ()
        )
    ?|
    | PositivePositionalPredecessorResultSome payload =>
        := \? output. output_value, predecessor = payload
        := input_runtime, output_runtime =
            positive_positional_predecessor_less_runtime
                (positive_positional_twelve_value ())
                output_value
                (positive_positional_predecessor_implies_less predecessor)
        := _ =
            assert_positive_positional_predecessor_less_runtime
                input_runtime output_runtime
        "every-structural-positive-positional-predecessor-witness-now-generically-derives-a-strict-order-proof-by-r"
        ^^ "ecursion-so-the-twelve-to-eleven-step-is-certified-as-eleven-less-than-twelve-without-running-a-separate-o"
        ^^ "rder-decision-which-removes-one-proof-gap-needed-by-accessibility-driven-factorization-while-transitive-ca"
        ^^ "ndidate-membership-quotient-descent-and-arbitrary-tree-uniqueness-remain-open-sealed"

:| ^ positive_positional_predecessor_accessibility natural =
    | PositivePositionalPredecessorAccessibilityOne ::
        string -> positive_positional_predecessor_accessibility positional_one
    | PositivePositionalPredecessorAccessibilityStep :: \* input.
        (\? predecessor.
            positive_positional_predecessor input predecessor *
            positive_positional_predecessor_accessibility predecessor * string) ->
        positive_positional_predecessor_accessibility input

:= ^ derive_positive_positional_predecessor_accessibility \* input.
    (value : positive_positional_nat input)
    : positive_positional_predecessor_accessibility input =
    ?= synthesize_positive_positional_predecessor value ?|
    | PositivePositionalPredecessorResultOne =>
        PositivePositionalPredecessorAccessibilityOne
            "one-closes-the-total-positive-predecessor-accessibility-chain"
    | PositivePositionalPredecessorResultSome payload =>
        := \? predecessor. _, predecessor_proof = payload
        := predecessor_value =
            positive_positional_predecessor_output_value predecessor_proof
        PositivePositionalPredecessorAccessibilityStep (\? (
            predecessor_proof,
            derive_positive_positional_predecessor_accessibility predecessor_value,
            "every-nonunit-positive-value-derives-its-smaller-predecessor-and-recursive-accessibility"))

:= ^ positive_positional_predecessor_accessibility_runtime \* natural.
    (value : positive_positional_nat natural)
    (accessibility : positive_positional_predecessor_accessibility natural)
    : i64 * i64 * i64 =
    ?= accessibility ?|
    | PositivePositionalPredecessorAccessibilityOne _ =>
        positive_positional_nat_to_i64 value, 1i64, 0i64
    | PositivePositionalPredecessorAccessibilityStep payload =>
        := \? predecessor.
            predecessor_proof, tail, _ = payload
        := predecessor_value =
            positive_positional_predecessor_output_value predecessor_proof
        := _, tail_nodes, tail_edges =
            positive_positional_predecessor_accessibility_runtime
                predecessor_value tail
        positive_positional_nat_to_i64 value,
