nominal certified_interval_positive_positional_first_run_multiplicity_shape_last head = head
nominal certified_interval_positive_positional_first_run_multiplicity_shape_more head = head

union certified_interval_positive_positional_first_run_multiplicity_indexed_profile head shape =
    | CertifiedIntervalPositivePositionalFirstRunMultiplicityIndexedProfileLast :: forall head.
        certified_interval_positive_positional_indexed_prime_cell head ->
        certified_interval_positive_positional_first_run_multiplicity_indexed_profile
            head (certified_interval_positive_positional_first_run_multiplicity_shape_last head)
    | CertifiedIntervalPositivePositionalFirstRunMultiplicityIndexedProfileMore :: forall head.
        (exists next.
            certified_interval_positive_positional_indexed_prime_cell head *
            positive_positional_equal head next *
            certified_interval_positive_positional_prime_multiplicity_run_from next) ->
        certified_interval_positive_positional_first_run_multiplicity_indexed_profile
            head (certified_interval_positive_positional_first_run_multiplicity_shape_more head)

union certified_interval_positive_positional_any_first_run_multiplicity_indexed_profile head =
    | CertifiedIntervalPositivePositionalAnyFirstRunMultiplicityIndexedProfile :: forall head.
        (exists shape.
            certified_interval_positive_positional_first_run_multiplicity_indexed_profile head shape) ->
        certified_interval_positive_positional_any_first_run_multiplicity_indexed_profile head

inl index_certified_interval_positive_positional_first_run_multiplicity forall head.
    (run : certified_interval_positive_positional_prime_multiplicity_run_from head)
    : certified_interval_positive_positional_any_first_run_multiplicity_indexed_profile head =
    match run with
    | CertifiedIntervalPositivePositionalPrimeMultiplicityRunLast cell =>
        CertifiedIntervalPositivePositionalAnyFirstRunMultiplicityIndexedProfile (exists (
            CertifiedIntervalPositivePositionalFirstRunMultiplicityIndexedProfileLast cell))
    | CertifiedIntervalPositivePositionalPrimeMultiplicityRunMore payload =>
