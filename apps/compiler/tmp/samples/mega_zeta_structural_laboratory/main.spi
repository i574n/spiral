inl certified_interval_positive_positional_factor_membership_accessibility_runtime
    forall candidate start length.
    (start_value : positive_positional_nat start)
    (membership :
        certified_interval_positive_positional_factor_membership
            candidate start length)
    : i64 * i64 * i64 * i64 * i64 * i64 * i64 * i64 =
    inl legacy_accessibility_authority =
        derive_certified_interval_positive_positional_membership_accessibility_authority
            membership
    inl candidate_value, accessibility =
        certified_interval_positive_positional_membership_accessibility_authority_inputs
            legacy_accessibility_authority
    inl membership_path =
        certified_interval_positive_positional_factor_membership_to_transitive_path
