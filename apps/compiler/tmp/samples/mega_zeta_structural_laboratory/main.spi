inl assert_positive_positional_generic_flattened_quotient_chain_runtime
    (middle : i64) (staged_quotient : i64) (flattened_quotient : i64)
    (middle_nodes : i64) (middle_edges : i64)
    (staged_nodes : i64) (staged_edges : i64)
    (flattened_nodes : i64) (flattened_edges : i64)
    (quotients_definitionally_shared : i64) : () =
    inl ok_0 = !!!!EQ(middle, 4i64)
    inl ok_1 = !!!!EQ(staged_quotient, 1i64)
    inl ok_2 = !!!!EQ(flattened_quotient, 1i64)
    inl ok_3 = !!!!EQ(middle_nodes, 4i64)
    inl ok_4 = !!!!EQ(middle_edges, 3i64)
    inl ok_5 = !!!!EQ(staged_nodes, 1i64)
    inl ok_6 = !!!!EQ(staged_edges, 0i64)
    inl ok_7 = !!!!EQ(flattened_nodes, 1i64)
    inl ok_8 = !!!!EQ(flattened_edges, 0i64)
    inl ok_9 = !!!!EQ(quotients_definitionally_shared, 1i64)
    if ok_0 && ok_1 && ok_2 && ok_3 && ok_4 && ok_5 && ok_6 && ok_7 && ok_8 && ok_9 then () else mega_runtime_fail "positive-positional-generic-flattened-quotient-chain-runtime-mismatch"

inl positive_positional_generic_flattened_quotient_chain_terminal () : string =
    inl middle, staged_quotient, flattened_quotient,
        middle_nodes, middle_edges, staged_nodes,
        staged_edges, flattened_nodes, flattened_edges,
        quotients_definitionally_shared =
        positive_positional_generic_flattened_quotient_chain_runtime ()
    inl _ =
        assert_positive_positional_generic_flattened_quotient_chain_runtime
            middle staged_quotient flattened_quotient
            middle_nodes middle_edges staged_nodes staged_edges
            flattened_nodes flattened_edges
            quotients_definitionally_shared
    "the-indexed-two-stage-runtime-now-binds-only-the-fourteen-divided-by-three-and-four-divided-by-three-certificates-then-computes-the-direct-fourteen-divided-by-nine-certificate-through-the-flattening-function-before-packaging-the-shared-middle-and-final-quotient-so-the-composite-proof-is-no-longer-entered-as-an-independent-runtime-value-while-a-fully-generic-composition-proof-transitive-candidate-descent-and-tree-uniqueness-remain-open-sealed"

union rec positive_positional_transitive_predecessor_path input output =
    | PositivePositionalTransitivePredecessorPathDone :: forall natural.
        positive_positional_nat natural ->
        positive_positional_transitive_predecessor_path natural natural
    | PositivePositionalTransitivePredecessorPathStep :: forall input output.
        (exists middle.
            positive_positional_nat middle *
            positive_positional_predecessor input middle *
            positive_positional_less middle input *
            positive_positional_transitive_predecessor_path middle output) ->
        positive_positional_transitive_predecessor_path input output

inl rec certified_interval_positive_positional_factor_membership_to_transitive_path
    forall candidate start length.
    (membership :
        certified_interval_positive_positional_factor_membership
            candidate start length)
    : positive_positional_transitive_predecessor_path start candidate =
    match membership with
    | CertifiedIntervalPositivePositionalFactorMembershipHere
        (candidate_value, _, predecessor, _) =>
        PositivePositionalTransitivePredecessorPathStep (exists (
            candidate_value,
            predecessor,
            positive_positional_predecessor_implies_less predecessor,
            PositivePositionalTransitivePredecessorPathDone candidate_value))
    | CertifiedIntervalPositivePositionalFactorMembershipThere payload =>
        inl exists head.
            _, head_value, _, predecessor, tail_membership, _ = payload
        PositivePositionalTransitivePredecessorPathStep (exists (
            head_value,
            predecessor,
            positive_positional_predecessor_implies_less predecessor,
            certified_interval_positive_positional_factor_membership_to_transitive_path
                tail_membership))

union positive_positional_strict_predecessor_path input output =
    | PositivePositionalStrictPredecessorPathOne :: forall input output.
        positive_positional_nat output *
        positive_positional_predecessor input output *
        positive_positional_less output input ->
        positive_positional_strict_predecessor_path input output
    | PositivePositionalStrictPredecessorPathMore :: forall input output.
        (exists middle.
            positive_positional_nat middle *
            positive_positional_predecessor input middle *
            positive_positional_less middle input *
            positive_positional_transitive_predecessor_path middle output) ->
        positive_positional_strict_predecessor_path input output

inl rec certified_interval_positive_positional_factor_membership_to_strict_path
    forall candidate start length.
    (membership : certified_interval_positive_positional_factor_membership candidate start length)
    : positive_positional_strict_predecessor_path start candidate =
    match membership with
    | CertifiedIntervalPositivePositionalFactorMembershipHere
        (candidate_value, _, predecessor, _) =>
        PositivePositionalStrictPredecessorPathOne (
            candidate_value,
            predecessor,
            positive_positional_predecessor_implies_less predecessor)
    | CertifiedIntervalPositivePositionalFactorMembershipThere payload =>
        inl exists head.
            _, head_value, _, predecessor, tail_membership, _ = payload
        PositivePositionalStrictPredecessorPathMore (exists (
            head_value,
            predecessor,
            positive_positional_predecessor_implies_less predecessor,
            certified_interval_positive_positional_factor_membership_to_transitive_path
                tail_membership))

inl positive_positional_strict_predecessor_path_to_transitive_path forall input output.
    (path : positive_positional_strict_predecessor_path input output)
    : positive_positional_transitive_predecessor_path input output =
    match path with
    | PositivePositionalStrictPredecessorPathOne
        (output_value, predecessor, strict_less) =>
        PositivePositionalTransitivePredecessorPathStep (exists (
            output_value,
            predecessor,
            strict_less,
            PositivePositionalTransitivePredecessorPathDone output_value))
    | PositivePositionalStrictPredecessorPathMore payload =>
        inl exists middle. middle_value, predecessor, strict_less, tail = payload
        PositivePositionalTransitivePredecessorPathStep (exists (
            middle_value,
            predecessor,
            strict_less,
            tail))

inl rec positive_positional_transitive_predecessor_path_output_value forall input output.
    (path : positive_positional_transitive_predecessor_path input output)
    : positive_positional_nat output =
    match path with
    | PositivePositionalTransitivePredecessorPathDone output_value =>
        output_value
    | PositivePositionalTransitivePredecessorPathStep payload =>
        inl exists middle. _, _, _, tail = payload
        positive_positional_transitive_predecessor_path_output_value tail

inl positive_positional_transitive_predecessor_path_output_accessibility forall input output.
    (path : positive_positional_transitive_predecessor_path input output)
    : positive_positional_predecessor_accessibility output =
    derive_positive_positional_predecessor_accessibility
        (positive_positional_transitive_predecessor_path_output_value path)

inl rec positive_positional_accessibility_to_transitive_path forall natural.
    (value : positive_positional_nat natural)
    (accessibility : positive_positional_predecessor_accessibility natural)
    : positive_positional_transitive_predecessor_path natural positional_one =
    match accessibility with
    | PositivePositionalPredecessorAccessibilityOne _ =>
        PositivePositionalTransitivePredecessorPathDone PositivePositionalOne
    | PositivePositionalPredecessorAccessibilityStep payload =>
        inl exists predecessor.
            predecessor_proof, tail, _ = payload
        inl predecessor_value =
            positive_positional_predecessor_output_value predecessor_proof
        inl predecessor_less =
            positive_positional_predecessor_implies_less predecessor_proof
        PositivePositionalTransitivePredecessorPathStep (exists (
            predecessor_value,
            predecessor_proof,
            predecessor_less,
            positive_positional_accessibility_to_transitive_path
                predecessor_value tail))

union certified_interval_positive_positional_membership_recursion_authority candidate start length =
    | CertifiedIntervalPositivePositionalMembershipRecursionAuthority :: forall candidate start length.
        certified_interval_positive_positional_factor_membership candidate start length *
        positive_positional_transitive_predecessor_path start candidate *
        positive_positional_nat candidate *
        positive_positional_parent_derived_child_accessibility candidate * string ->
        certified_interval_positive_positional_membership_recursion_authority candidate start length

inl derive_certified_interval_positive_positional_membership_recursion_authority forall candidate start length.
    (membership : certified_interval_positive_positional_factor_membership candidate start length)
    : certified_interval_positive_positional_membership_recursion_authority candidate start length =
    inl parent_derived_accessibility =
        derive_certified_interval_positive_positional_factor_membership_parent_accessibility membership
    inl candidate_value =
        certified_interval_positive_positional_factor_membership_candidate_value membership
    CertifiedIntervalPositivePositionalMembershipRecursionAuthority (
        membership,
        certified_interval_positive_positional_factor_membership_to_transitive_path membership,
        candidate_value,
        parent_derived_accessibility,
        "one-membership-proof-derives-path-and-parent-derived-accessibility-without-rebuilding-literal-child-accessibility")

inl certified_interval_positive_positional_membership_recursion_authority_path forall candidate start length.
    (authority : certified_interval_positive_positional_membership_recursion_authority candidate start length)
    : positive_positional_transitive_predecessor_path start candidate =
    match authority with
    | CertifiedIntervalPositivePositionalMembershipRecursionAuthority
        (_, path, _, _, _) =>
        path

inl certified_interval_positive_positional_membership_recursion_authority_value forall candidate start length.
    (authority : certified_interval_positive_positional_membership_recursion_authority candidate start length)
    : positive_positional_nat candidate =
    match authority with
    | CertifiedIntervalPositivePositionalMembershipRecursionAuthority
        (_, _, candidate_value, _, _) =>
        candidate_value

inl certified_interval_positive_positional_membership_recursion_authority_parent_derived_accessibility forall candidate start length.
    (authority : certified_interval_positive_positional_membership_recursion_authority candidate start length)
    : positive_positional_parent_derived_child_accessibility candidate =
    match authority with
    | CertifiedIntervalPositivePositionalMembershipRecursionAuthority
        (_, _, _, parent_derived_accessibility, _) =>
        parent_derived_accessibility

inl rec positive_positional_transitive_predecessor_path_runtime forall input output.
    (input_value : positive_positional_nat input)
    (output_value : positive_positional_nat output)
    (path : positive_positional_transitive_predecessor_path input output)
    : i64 * i64 * i64 * i64 =
    match path with
    | PositivePositionalTransitivePredecessorPathDone _ =>
        positive_positional_nat_to_i64 input_value,
        positive_positional_nat_to_i64 output_value,
        1i64, 0i64
    | PositivePositionalTransitivePredecessorPathStep payload =>
        inl exists middle. middle_value, _, _, tail = payload
        inl _, final_value, tail_nodes, tail_edges =
            positive_positional_transitive_predecessor_path_runtime
                middle_value output_value tail
        positive_positional_nat_to_i64 input_value,
        final_value,
        zeta_runtime_add_closure_i64 1i64 tail_nodes,
        zeta_runtime_add_closure_i64 1i64 tail_edges

inl certified_interval_positive_positional_membership_recursion_authority_terminal () : string =
    match classify_certified_interval_positive_positional_sealed_factor
            (positive_positional_twelve_value ()) with
    | CertifiedIntervalPositivePositionalSealedCompositeClass payload =>
        inl exists length divisor quotient.
            _, _, _, membership, _, _ = payload
        inl authority =
            derive_certified_interval_positive_positional_membership_recursion_authority membership
        inl parent_derived_accessibility =
            certified_interval_positive_positional_membership_recursion_authority_parent_derived_accessibility authority
        inl parent_derived_note =
            match parent_derived_accessibility with
            | PositivePositionalParentDerivedChildAccessibility parent_payload =>
                inl exists parent synthesized_child.
                    parent_accessibility, synthesized_predecessor, _, synthesized_accessibility = parent_payload
                inl parent_value =
                    positive_positional_predecessor_accessibility_root_value parent_accessibility
                inl synthesized_value =
                    positive_positional_predecessor_accessibility_root_value synthesized_accessibility
                inl _, _, _ =
                    positive_positional_predecessor_accessibility_runtime
                        parent_value parent_accessibility
                inl _, _, _ =
                    positive_positional_predecessor_accessibility_runtime
                        synthesized_value synthesized_accessibility
                match synthesized_predecessor with
                | PositivePositionalPredecessorTwo =>
                    "the-active-membership-recursion-now-opens-a-parent-derived-accessibility-payload-that-contains-the-parent-chain-the-exact-predecessor-edge-the-child-equality-and-the-child-subaccessibility-without-a-global-child-builder-or-diagnostic-string"
                | _ =>
                    "the-active-membership-recursion-consumed-a-parent-derived-predecessor-edge-and-child-subaccessibility"
        inl candidate_value =
            certified_interval_positive_positional_membership_recursion_authority_value authority
        inl path =
            certified_interval_positive_positional_membership_recursion_authority_path authority
        inl _, _, _, _ =
            positive_positional_transitive_predecessor_path_runtime
                (positive_positional_twelve_value ()) candidate_value path
        parent_derived_note
    | _ =>
        "the-membership-recursion-authority-regression-input-was-unexpectedly-not-composite"

inl assert_positive_positional_transitive_predecessor_path_runtime
    (input : i64) (output : i64) (nodes : i64) (edges : i64) : () =
    inl ok_0 = !!!!EQ(input, 12i64)
    inl ok_1 = !!!!EQ(output, 1i64)
    inl ok_2 = !!!!EQ(nodes, 12i64)
    inl ok_3 = !!!!EQ(edges, 11i64)
    if ok_0 && ok_1 && ok_2 && ok_3 then () else mega_runtime_fail "positive-positional-transitive-predecessor-path-runtime-mismatch"

inl positive_positional_transitive_predecessor_path_terminal () : string =
    inl root = positive_positional_twelve_value ()
    inl accessibility =
        derive_positive_positional_predecessor_accessibility root
    inl path =
        positive_positional_accessibility_to_transitive_path
            root accessibility
    inl input, output, nodes, edges =
        positive_positional_transitive_predecessor_path_runtime
            root PositivePositionalOne path
    inl _ =
        assert_positive_positional_transitive_predecessor_path_runtime
            input output nodes edges
    "the-total-predecessor-accessibility-witness-now-materializes-an-indexed-transitive-path-from-the-original-positive-input-to-one-where-every-recursive-edge-carries-both-the-exact-predecessor-and-its-derived-strict-order-proof-so-twelve-to-one-is-one-composable-eleven-edge-descent-object-rather-than-eleven-unrelated-local-facts-while-arbitrary-factorization-tree-uniqueness-remains-open-sealed"


inl rec positive_positional_transitive_predecessor_path_append forall input bridge output.
    (left : positive_positional_transitive_predecessor_path input bridge)
    (right : positive_positional_transitive_predecessor_path bridge output)
    : positive_positional_transitive_predecessor_path input output =
    match left with
    | PositivePositionalTransitivePredecessorPathDone _ => right
    | PositivePositionalTransitivePredecessorPathStep payload =>
        inl exists next. next_value, predecessor, strict_less, tail = payload
        PositivePositionalTransitivePredecessorPathStep (exists (
            next_value,
            predecessor,
            strict_less,
            positive_positional_transitive_predecessor_path_append tail right))

inl positive_positional_nonidentity_three_segment_path_associativity_runtime () :
    i64 * i64 * i64 * i64 * i64 * i64 * i64 * i64 =
    inl four = positive_positional_four_value ()
    inl three = positive_positional_three_value ()
    inl two = positive_positional_two_value ()
    inl one = PositivePositionalOne
    inl four_to_three =
        PositivePositionalPredecessorZeroBitHigher
            PositivePositionalPredecessorTwo
    inl three_to_two =
        PositivePositionalPredecessorOneBit PositivePositionalOne
    inl two_to_one = PositivePositionalPredecessorTwo
    inl first =
        PositivePositionalTransitivePredecessorPathStep (exists (
            three,
            four_to_three,
            positive_positional_predecessor_implies_less four_to_three,
            PositivePositionalTransitivePredecessorPathDone three))
    inl second =
        PositivePositionalTransitivePredecessorPathStep (exists (
            two,
            three_to_two,
            positive_positional_predecessor_implies_less three_to_two,
            PositivePositionalTransitivePredecessorPathDone two))
    inl third =
        PositivePositionalTransitivePredecessorPathStep (exists (
            one,
            two_to_one,
            positive_positional_predecessor_implies_less two_to_one,
            PositivePositionalTransitivePredecessorPathDone one))
    inl left_associated =
        positive_positional_transitive_predecessor_path_append
            (positive_positional_transitive_predecessor_path_append
                first second)
            third
    inl right_associated =
        positive_positional_transitive_predecessor_path_append
            first
            (positive_positional_transitive_predecessor_path_append
                second third)
    inl li, lo, ln, le =
        positive_positional_transitive_predecessor_path_runtime
            four one left_associated
    inl ri, ro, rn, re =
        positive_positional_transitive_predecessor_path_runtime
            four one right_associated
    li, lo, ln, le, ri, ro, rn, re

