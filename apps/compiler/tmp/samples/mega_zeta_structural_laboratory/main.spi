            certified_interval_positive_positional_prime_multiplicity_run_from left *
            certified_interval_positive_positional_prime_multiplicity_run_from right *
            positive_positional_less right right_next *
            certified_interval_positive_positional_prime_multiplicity_normal_form_from right_next) ->
        certified_interval_positive_positional_group_indexed_profile_pair_case left right
    | CertifiedIntervalPositivePositionalGroupIndexedProfilePairCaseLeftMoreRightLast :: \* left right.
        (\? left_next.
            certified_interval_positive_positional_prime_multiplicity_run_from left *
            positive_positional_less left left_next *
            certified_interval_positive_positional_prime_multiplicity_normal_form_from left_next *
            certified_interval_positive_positional_prime_multiplicity_run_from right) ->
        certified_interval_positive_positional_group_indexed_profile_pair_case left right
    | CertifiedIntervalPositivePositionalGroupIndexedProfilePairCaseBothMore :: \* left right.
        (\? left_next right_next.
            certified_interval_positive_positional_prime_multiplicity_run_from left *
            positive_positional_less left left_next *
            certified_interval_positive_positional_prime_multiplicity_normal_form_from left_next *
            certified_interval_positive_positional_prime_multiplicity_run_from right *
            positive_positional_less right right_next *
            certified_interval_positive_positional_prime_multiplicity_normal_form_from right_next) ->
        certified_interval_positive_positional_group_indexed_profile_pair_case left right

:= certified_interval_positive_positional_group_indexed_profile_pair_case_from_normals \* left right.
    (left_normal : certified_interval_positive_positional_prime_multiplicity_normal_form_from left)
    (right_normal : certified_interval_positive_positional_prime_multiplicity_normal_form_from right)
    : certified_interval_positive_positional_group_indexed_profile_pair_case left right =
    ?= left_normal, right_normal ?|
    | CertifiedIntervalPositivePositionalPrimeMultiplicityNormalFormLast left_run,
      CertifiedIntervalPositivePositionalPrimeMultiplicityNormalFormLast right_run =>
        CertifiedIntervalPositivePositionalGroupIndexedProfilePairCaseBothLast (
            left_run,
            right_run)
    | CertifiedIntervalPositivePositionalPrimeMultiplicityNormalFormLast left_run,
      CertifiedIntervalPositivePositionalPrimeMultiplicityNormalFormMore right_payload =>
        := \? right_next. right_run, right_less, right_rest = right_payload
        CertifiedIntervalPositivePositionalGroupIndexedProfilePairCaseLeftLastRightMore (\? (
            left_run,
            right_run,
            right_less,
            right_rest))
    | CertifiedIntervalPositivePositionalPrimeMultiplicityNormalFormMore left_payload,
      CertifiedIntervalPositivePositionalPrimeMultiplicityNormalFormLast right_run =>
        := \? left_next. left_run, left_less, left_rest = left_payload
        CertifiedIntervalPositivePositionalGroupIndexedProfilePairCaseLeftMoreRightLast (\? (
            left_run,
            left_less,
            left_rest,
            right_run))
    | CertifiedIntervalPositivePositionalPrimeMultiplicityNormalFormMore left_payload,
      CertifiedIntervalPositivePositionalPrimeMultiplicityNormalFormMore right_payload =>
        := \? left_next. left_run, left_less, left_rest = left_payload
        := \? right_next. right_run, right_less, right_rest = right_payload
        CertifiedIntervalPositivePositionalGroupIndexedProfilePairCaseBothMore (\? (
            left_run,
            left_less,
            left_rest,
            right_run,
            right_less,
            right_rest))

:| certified_interval_positive_positional_prime_multiplicity_run_pair_shape left right =
    | CertifiedIntervalPositivePositionalPrimeMultiplicityRunPairShapeBothLast :: \* left right.
        certified_interval_positive_positional_indexed_prime_cell left *
        certified_interval_positive_positional_indexed_prime_cell right ->
        certified_interval_positive_positional_prime_multiplicity_run_pair_shape left right
    | CertifiedIntervalPositivePositionalPrimeMultiplicityRunPairShapeLeftLastRightMore :: \* left right.
        (\? right_next.
