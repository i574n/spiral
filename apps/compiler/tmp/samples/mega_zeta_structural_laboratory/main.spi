        CertifiedIntervalPositivePositionalPrimeMultiplicityRunPairShapeLeftMoreRightLast (\? (
            left_cell,
            left_equal,
            left_tail,
            right_cell))
    | CertifiedIntervalPositivePositionalPrimeMultiplicityRunMore left_payload,
      CertifiedIntervalPositivePositionalPrimeMultiplicityRunMore right_payload =>
        := \? left_next. left_cell, left_equal, left_tail = left_payload
        := \? right_next. right_cell, right_equal, right_tail = right_payload
        CertifiedIntervalPositivePositionalPrimeMultiplicityRunPairShapeBothMore (\? (
            left_cell,
            left_equal,
            left_tail,
            right_cell,
            right_equal,
            right_tail))

:= certified_interval_positive_positional_same_root_factorization_pair_normalization_runtime \* natural.
    (pair : certified_interval_positive_positional_same_root_factorization_pair natural)
    : i64 * i64 * i64 * i64 * i64 * i64 * i64 * i64 * i64 * i64 * i64 * i64 * i64 * i64 =
    := authority =
        certified_interval_positive_positional_same_root_factorization_pair_canonical_profiles pair
    := left_product_indexed =
        certified_interval_positive_positional_product_indexed_normal_form_from_rooted (
            certified_interval_positive_positional_same_root_canonical_profile_pair_left_profile authority)
    := right_product_indexed =
        certified_interval_positive_positional_product_indexed_normal_form_from_rooted (
            certified_interval_positive_positional_same_root_canonical_profile_pair_right_profile authority)
    := left_normal =
        certified_interval_positive_positional_product_indexed_normal_form_project left_product_indexed
    := right_normal =
        certified_interval_positive_positional_product_indexed_normal_form_project right_product_indexed
    := lg, lc, lp, lf, ll, lm, lx =
        certified_interval_positive_positional_prime_multiplicity_normal_form_runtime left_normal
    := rg, rc, rp, rf, rl, rm, rx =
        certified_interval_positive_positional_prime_multiplicity_normal_form_runtime right_normal
    lg, lc, lp, lf, ll, lm, lx, rg, rc, rp, rf, rl, rm, rx

:= assert_certified_interval_positive_positional_six_distinct_tree_normalization_runtime
    (left_divisor : i64) (left_quotient : i64)
    (right_divisor : i64) (right_quotient : i64)
    (left_groups : i64) (left_cells : i64) (left_product : i64)
    (left_first : i64) (left_last : i64) (left_max : i64) (left_mismatch : i64)
    (right_groups : i64) (right_cells : i64) (right_product : i64)
    (right_first : i64) (right_last : i64) (right_max : i64) (right_mismatch : i64)
    : ()
    =
    := same (a : i64) (b : i64) : bool = !!!!EQ(a, b)
    ? same left_divisor 3i64 && same left_quotient 2i64 && same right_divisor 2i64 && same right_quotient 3i64 ?> ()
    |: mega_runtime_fail "same-root-six-factorization-shapes-are-not-distinct"
    ?
        same left_groups right_groups
        && same left_cells right_cells
        && same left_product right_product
        && same left_first right_first
        && same left_last right_last
        && same left_max right_max
        && same left_mismatch right_mismatch
    ?> ()
    |: mega_runtime_fail "same-root-six-canonical-normalization-disagrees"
    ?
        same left_groups 2i64
        && same left_cells 2i64
        && same left_product 6i64
        && same left_first 2i64
        && same left_last 3i64
        && same left_max 1i64
        && same left_mismatch 0i64
    ?> ()
    |: mega_runtime_fail "same-root-six-canonical-normalization-unexpected"

:= certified_interval_positive_positional_six_structural_profile_agreement_terminal () : string =
    := six_value = positive_positional_six_value ()
    := search_tree =
        certified_interval_positive_positional_accessible_child_completion
            six_value (derive_positive_positional_predecessor_accessibility six_value)
    := alternate_tree = alternate_six_complete_factorization_tree ()
    := pair :
        certified_interval_positive_positional_same_root_factorization_pair
            (positional_zero_bit (positional_one_bit positional_one)) =
        CertifiedIntervalPositivePositionalSameRootFactorizationPair (
            search_tree,
            alternate_tree)
    := authority =
        certified_interval_positive_positional_same_root_factorization_pair_canonical_profiles pair
    := typed_profile_decision =
        certified_interval_positive_positional_same_root_canonical_profile_pair_agreement_typed authority
    := typed_profile_symmetric =
        certified_interval_positive_positional_same_root_canonical_profile_agreement_decision_symmetry
            typed_profile_decision
    := _ =
        ?= typed_profile_symmetric ?|
        | CertifiedIntervalPositivePositionalSameRootCanonicalProfileAgreementMatched _ =>
            "same-root-six-typed-profile-decision-symmetry-now-swaps-the-shared-root-authority-and-the-structural-w"
            ^^ "itness-together"
        | CertifiedIntervalPositivePositionalSameRootCanonicalProfileAgreementMismatch _ =>
            mega_runtime_fail "same-root-six-typed-profile-decision-symmetry-unexpected-mismatch"
    := profile_decision =
        certified_interval_positive_positional_same_root_canonical_profile_pair_agreement authority
    := symmetric_profile_decision =
        certified_interval_positive_positional_prime_multiplicity_normal_form_agreement_decision_symmetry
            profile_decision
    := _ =
        ?= symmetric_profile_decision ?|
        | CertifiedIntervalPositivePositionalPrimeMultiplicityNormalFormAgreementMatched _ =>
            "same-root-six-profile-agreement-decision-symmetry-preserves-the-matched-witness"
        | CertifiedIntervalPositivePositionalPrimeMultiplicityNormalFormAgreementMismatch _ =>
            mega_runtime_fail "same-root-six-profile-agreement-decision-symmetry-unexpected-mismatch"
    := left_product_indexed =
        certified_interval_positive_positional_product_indexed_normal_form_from_rooted (
            certified_interval_positive_positional_same_root_canonical_profile_pair_left_profile authority)
    := right_product_indexed =
        certified_interval_positive_positional_product_indexed_normal_form_from_rooted (
            certified_interval_positive_positional_same_root_canonical_profile_pair_right_profile authority)
    := left_normal =
        certified_interval_positive_positional_product_indexed_normal_form_project left_product_indexed
    := right_normal =
        certified_interval_positive_positional_product_indexed_normal_form_project right_product_indexed
    ?= left_normal, right_normal, typed_profile_decision ?|
    | CertifiedIntervalPositivePositionalPrimeMultiplicityNormalFormSome left_payload,
        CertifiedIntervalPositivePositionalPrimeMultiplicityNormalFormSome right_payload,
        CertifiedIntervalPositivePositionalSameRootCanonicalProfileAgreementMatched matched_agreement
        =>
            := \? left_head. left_grouped = left_payload
            := \? right_head. right_grouped = right_payload
            := _ =
                certified_interval_positive_positional_prime_multiplicity_normal_form_agreement_symmetry_any
                    matched_agreement
            := _ =
                certified_interval_positive_positional_prime_multiplicity_normal_form_agreement_reflexive left_grouped
            := _ =
                certified_interval_positive_positional_prime_multiplicity_normal_form_agreement_reflexive right_grouped
            := left_multiplicity =
                index_certified_interval_positive_positional_normal_form_first_run_multiplicity left_grouped
            := right_multiplicity =
                index_certified_interval_positive_positional_normal_form_first_run_multiplicity right_grouped
            ?= left_multiplicity, right_multiplicity ?|
            | CertifiedIntervalPositivePositionalAnyFirstRunMultiplicityIndexedProfile left_multiplicity_payload,
                CertifiedIntervalPositivePositionalAnyFirstRunMultiplicityIndexedProfile right_multiplicity_payload
                =>
                    := \? left_multiplicity_shape. left_multiplicity_profile = left_multiplicity_payload
                    := \? right_multiplicity_shape. right_multiplicity_profile = right_multiplicity_payload
                    := _ =
                        assert_certified_interval_positive_positional_same_root_first_run_multiplicity_shape_runtime
                            (
                                certified_interval_positive_positional_first_run_multiplicity_shape_runtime
                                    left_multiplicity_profile
                            )
                            (
                                certified_interval_positive_positional_first_run_multiplicity_shape_runtime
                                    right_multiplicity_profile
                            )
                    "the-two-independent-six-factorizations-now-keep-both-canonical-outer-shapes-as-existentials-un"
                    ^^ "der-one-shared-root-authority-and-both-canonical-first-prime-runs-project-structural-multiplic"
                    ^^ "ity-shapes-that-are-single-cell-for-two-before-producing-the-recursive-prime-cell-run-and-grou"
                    ^^ "p-agreement-witness-so-the-next-uniqueness-cut-can-index-multiplicity-before-the-tail"
    | _, _, CertifiedIntervalPositivePositionalSameRootCanonicalProfileAgreementMismatch _ =>
        mega_runtime_fail "same-root-six-structural-profile-agreement-mismatch"
    | _, _, _ =>
        mega_runtime_fail "same-root-six-canonical-profiles-were-unexpectedly-empty"

:= certified_interval_positive_positional_six_distinct_tree_normalization_terminal () : string =
    := six_value = positive_positional_six_value ()
    := search_tree =
        certified_interval_positive_positional_accessible_child_completion
            six_value (derive_positive_positional_predecessor_accessibility six_value)
    := alternate_tree = alternate_six_complete_factorization_tree ()
    := pair :
        certified_interval_positive_positional_same_root_factorization_pair
            (positional_zero_bit (positional_one_bit positional_one)) =
        CertifiedIntervalPositivePositionalSameRootFactorizationPair (
            search_tree,
            alternate_tree)
    := search_divisor, search_quotient =
        certified_interval_positive_positional_complete_tree_split_runtime search_tree
    := alternate_divisor, alternate_quotient =
        certified_interval_positive_positional_complete_tree_split_runtime alternate_tree
    := sg, sc, sp, sf, sl, sm, sx, ag, ac, ap, af, al, am, ax =
        certified_interval_positive_positional_same_root_factorization_pair_normalization_runtime pair
    := _ =
        assert_certified_interval_positive_positional_six_distinct_tree_normalization_runtime
            search_divisor search_quotient alternate_divisor alternate_quotient
            sg sc sp sf sl sm sx ag ac ap af al am ax
    := _ = pair
    "two-genuinely-distinct-complete-factorization-trees-of-six-now-share-the-same-root-index-and-canonicalize-to-t"
    ^^ "he-same-two-times-three-structural-multiplicity-profile-at-runtime-with-arbitrary-tree-uniqueness-still-open"

:= certified_interval_positive_positional_indexed_prime_cell_two () :
    certified_interval_positive_positional_indexed_prime_cell
        (positional_zero_bit positional_one) =
    CertifiedIntervalPositivePositionalIndexedPrimeCell (\? (
        positive_positional_two_value (),
        PositivePositionalFactorCandidateNonunitZeroBit PositivePositionalOne,
        CertifiedIntervalPositivePositionalAllRejectedTwo
            "two-has-no-nonunit-factor-below-it",
        "FactorNF-run-two-carries-the-same-typed-primality-certificate-used-by-the-canonical-prime-sequence"))

:= certified_interval_positive_positional_three_nonfactor_two () :
    positive_positional_nonfactor_certificate
        (positional_one_bit positional_one)
        (positional_zero_bit positional_one) =
    ?= decide_positive_positional_exact_factor
            (positive_positional_three_value ())
            (positive_positional_two_value ()) ?|
    | PositivePositionalExactFactorRejected rejection_payload =>
        PositivePositionalNonfactorCertificate rejection_payload

:= certified_interval_positive_positional_all_rejected_three () :
    certified_interval_positive_positional_all_rejected
        (positional_one_bit positional_one)
        (positional_one_bit positional_one)
        (z_nat_succ z_nat_zero) =
    CertifiedIntervalPositivePositionalAllRejectedMore (\? (
        positive_positional_two_value (),
        PositivePositionalFactorCandidateNonunitZeroBit PositivePositionalOne,
        positional_three_predecessor_two (),
        certified_interval_positive_positional_three_nonfactor_two (),
        CertifiedIntervalPositivePositionalAllRejectedTwo
            "three-candidate-two-is-the-final-rejected-cell",
        "three-is-prime-because-the-complete-certified-candidate-interval-rejects-two"))

:= certified_interval_positive_positional_indexed_prime_cell_three () :
    certified_interval_positive_positional_indexed_prime_cell
        (positional_one_bit positional_one) =
    CertifiedIntervalPositivePositionalIndexedPrimeCell (\? (
        positive_positional_three_value (),
        PositivePositionalFactorCandidateNonunitOneBit PositivePositionalOne,
        certified_interval_positive_positional_all_rejected_three (),
        "FactorNF-run-three-carries-a-complete-typed-primality-certificate-rather-than-only-nonunit-evidence"))

:| ^ certified_interval_positive_positional_product_multiplicity_run factor count product =
    | CertifiedIntervalPositivePositionalProductMultiplicityRunLast :: \* factor.
        certified_interval_positive_positional_indexed_prime_cell factor ->
        certified_interval_positive_positional_product_multiplicity_run
            factor (z_nat_succ z_nat_zero) factor
    | CertifiedIntervalPositivePositionalProductMultiplicityRunMore :: \* factor previous_count product.
        (\? previous_product.
            certified_interval_positive_positional_product_multiplicity_run
                factor previous_count previous_product *
            positive_positional_multiply factor previous_product product) ->
        certified_interval_positive_positional_product_multiplicity_run
            factor (z_nat_succ previous_count) product

:= ^ certified_interval_positive_positional_product_multiplicity_run_prime \* factor count product.
    (run : certified_interval_positive_positional_product_multiplicity_run factor count product) :
    certified_interval_positive_positional_indexed_prime_cell factor =
    ?= run ?|
    | CertifiedIntervalPositivePositionalProductMultiplicityRunLast prime_cell =>
        prime_cell
    | CertifiedIntervalPositivePositionalProductMultiplicityRunMore payload =>
        := \? previous_product. previous_run, _ = payload
        certified_interval_positive_positional_product_multiplicity_run_prime previous_run

:= ^ certified_interval_positive_positional_product_multiplicity_run_product_value \* factor count product.
    (run : certified_interval_positive_positional_product_multiplicity_run factor count product) :
    positive_positional_nat product =
    ?= run ?|
    | CertifiedIntervalPositivePositionalProductMultiplicityRunLast prime_cell =>
        certified_interval_positive_positional_indexed_prime_cell_value prime_cell
    | CertifiedIntervalPositivePositionalProductMultiplicityRunMore payload =>
        := \? previous_product. _, multiplication = payload
        positive_positional_multiply_result_value multiplication

:! certified_arithmetic_prime_power factor count product =
    certified_interval_positive_positional_indexed_prime_cell factor *
    certified_interval_positive_positional_product_multiplicity_run factor count product

:= certified_arithmetic_prime_power_from_run \* factor count product.
    (run : certified_interval_positive_positional_product_multiplicity_run factor count product) :
    certified_arithmetic_prime_power factor count product =
    certified_arithmetic_prime_power (
        certified_interval_positive_positional_product_multiplicity_run_prime run,
        run)

:= certified_arithmetic_prime_power_base_value \* factor count product.
    (power : certified_arithmetic_prime_power factor count product) : positive_positional_nat factor =
    ?= power ?|
    | certified_arithmetic_prime_power (prime_cell, _) =>
        certified_interval_positive_positional_indexed_prime_cell_value prime_cell

:= certified_arithmetic_prime_power_run \* factor count product.
    (power : certified_arithmetic_prime_power factor count product) :
    certified_interval_positive_positional_product_multiplicity_run factor count product =
    ?= power ?|
    | certified_arithmetic_prime_power (_, run) => run

:= certified_arithmetic_prime_power_product_value \* factor count product.
    (power : certified_arithmetic_prime_power factor count product) : positive_positional_nat product =
    certified_interval_positive_positional_product_multiplicity_run_product_value (
        certified_arithmetic_prime_power_run power)

:! certified_arithmetic_prime_power_structural_factor_witness factor count product =
    \? quotient.
        positive_positional_nat quotient *
        positive_positional_multiply factor quotient product

:= certified_arithmetic_prime_power_structural_factor_witness_make \* factor count product.
    (power : certified_arithmetic_prime_power factor count product) :
    certified_arithmetic_prime_power_structural_factor_witness factor count product =
    ?= certified_arithmetic_prime_power_run power ?|
    | CertifiedIntervalPositivePositionalProductMultiplicityRunLast prime_cell =>
        := factor_value =
            certified_interval_positive_positional_indexed_prime_cell_value prime_cell
        certified_arithmetic_prime_power_structural_factor_witness (\? (
            PositivePositionalOne,
            PositivePositionalMultiplyOne factor_value))
    | CertifiedIntervalPositivePositionalProductMultiplicityRunMore payload =>
        := \? previous_product. previous_run, multiplication = payload
        certified_arithmetic_prime_power_structural_factor_witness (\? (
            certified_interval_positive_positional_product_multiplicity_run_product_value previous_run,
            multiplication))

:| ^ certified_arithmetic_positive_exponent count =
    | CertifiedArithmeticPositiveExponentOne ::
        certified_arithmetic_positive_exponent (z_nat_succ z_nat_zero)
    | CertifiedArithmeticPositiveExponentMore :: \* previous.
        certified_arithmetic_positive_exponent previous ->
        certified_arithmetic_positive_exponent (z_nat_succ previous)



:| ^ certified_arithmetic_positive_exponent_equal left right =
    | CertifiedArithmeticPositiveExponentEqualOne ::
        certified_arithmetic_positive_exponent_equal
            (z_nat_succ z_nat_zero)
            (z_nat_succ z_nat_zero)
    | CertifiedArithmeticPositiveExponentEqualMore :: \* left_previous right_previous.
        certified_arithmetic_positive_exponent_equal left_previous right_previous ->
        certified_arithmetic_positive_exponent_equal
            (z_nat_succ left_previous)
            (z_nat_succ right_previous)

:= ^ certified_arithmetic_positive_exponent_equal_make \* left right.
    (left : certified_arithmetic_positive_exponent left)
    (right : certified_arithmetic_positive_exponent right) :
    certified_arithmetic_positive_exponent_equal left right =
    ?= left, right ?|
    | CertifiedArithmeticPositiveExponentOne, CertifiedArithmeticPositiveExponentOne =>
        CertifiedArithmeticPositiveExponentEqualOne
    | CertifiedArithmeticPositiveExponentMore left_previous,
      CertifiedArithmeticPositiveExponentMore right_previous =>
        CertifiedArithmeticPositiveExponentEqualMore (
            certified_arithmetic_positive_exponent_equal_make
                left_previous right_previous)
    | CertifiedArithmeticPositiveExponentOne,
      CertifiedArithmeticPositiveExponentMore _ =>
        mega_runtime_fail "zeta-positive-exponent-structural-equality-left-shorter"
    | CertifiedArithmeticPositiveExponentMore _,
      CertifiedArithmeticPositiveExponentOne =>
        mega_runtime_fail "zeta-positive-exponent-structural-equality-right-shorter"

:= ^ certified_arithmetic_prime_power_exponent \* factor count product.
    (power : certified_arithmetic_prime_power factor count product) :
    certified_arithmetic_positive_exponent count =
    ?= certified_arithmetic_prime_power_run power ?|
    | CertifiedIntervalPositivePositionalProductMultiplicityRunLast _ =>
        CertifiedArithmeticPositiveExponentOne
    | CertifiedIntervalPositivePositionalProductMultiplicityRunMore payload =>
        := \? previous_product. previous_run, _ = payload
        CertifiedArithmeticPositiveExponentMore (
            certified_arithmetic_prime_power_exponent (
                certified_arithmetic_prime_power_from_run previous_run))

:| certified_interval_positive_positional_product_multiplicity_normal_form root =
    | CertifiedIntervalPositivePositionalProductMultiplicityNormalForm :: \* root.
        (\? left_factor left_count left_product right_factor right_count right_product.
            certified_interval_positive_positional_product_multiplicity_run
