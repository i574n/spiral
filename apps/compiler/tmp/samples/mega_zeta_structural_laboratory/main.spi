inl classify_certified_interval_positive_positional_sealed_factor
    forall natural.
    (natural_value : positive_positional_nat natural)
    : certified_interval_positive_positional_sealed_factor_class natural =
    match natural_value with
    | PositivePositionalOne =>
        CertifiedIntervalPositivePositionalSealedUnit
    | PositivePositionalZeroBit tail =>
        inl concrete = PositivePositionalZeroBit tail
        match synthesize_certified_positive_positional_candidate_interval concrete with
        | SynthesizedCertifiedPositivePositionalCandidateInterval interval_payload =>
            inl exists length. interval, _ = interval_payload
            match search_certified_interval_positive_positional_factor concrete interval with
            | CertifiedIntervalPositivePositionalSealedPrime (rejected, note) =>
                CertifiedIntervalPositivePositionalSealedPrimeClass (exists (
                    concrete,
                    PositivePositionalFactorCandidateNonunitZeroBit tail,
                    rejected,
                    note))
            | CertifiedIntervalPositivePositionalSealedComposite composite_payload =>
                inl exists found_divisor found_quotient.
                    divisor_value, quotient_value, membership, division, note =
                        composite_payload
                CertifiedIntervalPositivePositionalSealedCompositeClass (exists (
                    concrete,
                    divisor_value,
                    quotient_value,
                    membership,
                    division,
                    note))
    | PositivePositionalOneBit tail =>
        inl concrete = PositivePositionalOneBit tail
        match synthesize_certified_positive_positional_candidate_interval concrete with
        | SynthesizedCertifiedPositivePositionalCandidateInterval interval_payload =>
            inl exists length. interval, _ = interval_payload
            match search_certified_interval_positive_positional_factor concrete interval with
            | CertifiedIntervalPositivePositionalSealedPrime (rejected, note) =>
                CertifiedIntervalPositivePositionalSealedPrimeClass (exists (
                    concrete,
                    PositivePositionalFactorCandidateNonunitOneBit tail,
                    rejected,
                    note))
            | CertifiedIntervalPositivePositionalSealedComposite composite_payload =>
                inl exists found_divisor found_quotient.
                    divisor_value, quotient_value, membership, division, note =
                        composite_payload
                CertifiedIntervalPositivePositionalSealedCompositeClass (exists (
                    concrete,
                    divisor_value,
                    quotient_value,
                    membership,
                    division,
                    note))

