inl rec certified_interval_positive_positional_complete_prime_sequence_runtime
    (sequence : certified_interval_positive_positional_complete_prime_sequence)
    : i64 * i64 * i64 * i64 =
    match sequence with
    | CertifiedIntervalPositivePositionalCompletePrimeSequenceDone =>
        0i64, 1i64, 0i64, 0i64
    | CertifiedIntervalPositivePositionalCompletePrimeSequenceMore (head, tail) =>
        inl value =
            certified_interval_positive_positional_complete_prime_sequence_cell_runtime head
        inl tail_count, tail_product, tail_first, tail_order_mismatches =
            certified_interval_positive_positional_complete_prime_sequence_runtime tail
        inl local_order_mismatch : i64 =
            inl test_0 = !!!!EQ(tail_count, 0i64)
            inl test_1 = !!!!LTE(value, tail_first)
            inl test_any = if test_0 then true elif test_1 then true else false
            if test_any then 0i64 else 1i64
        zeta_runtime_add_closure_i64 1i64 tail_count,
        zeta_runtime_mul_i64 value tail_product,
