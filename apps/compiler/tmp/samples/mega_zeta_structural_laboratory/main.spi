inl rec certified_interval_positive_positional_ordered_prime_sequence_insert_after forall head inserted.
    (head_to_inserted : certified_interval_positive_positional_prime_less_or_equal head inserted)
    (inserted_cell : certified_interval_positive_positional_indexed_prime_cell inserted)
    (sequence : certified_interval_positive_positional_ordered_prime_sequence_from head)
    : certified_interval_positive_positional_ordered_prime_sequence_from head =
    match sequence with
    | CertifiedIntervalPositivePositionalOrderedPrimeSequenceLast head_cell =>
        CertifiedIntervalPositivePositionalOrderedPrimeSequenceMore (exists (
            head_cell,
            head_to_inserted,
            CertifiedIntervalPositivePositionalOrderedPrimeSequenceLast inserted_cell))
    | CertifiedIntervalPositivePositionalOrderedPrimeSequenceMore payload =>
        inl exists next. head_cell, head_to_next, tail = payload
        inl inserted_value =
            certified_interval_positive_positional_indexed_prime_cell_value inserted_cell
        inl next_value =
            certified_interval_positive_positional_ordered_prime_sequence_head_value tail
        match synthesize_positive_positional_order inserted_value next_value with
        | PositivePositionalOrderDecisionLess less =>
