inl certified_interval_positive_positional_ordered_prime_sequence_insert forall inserted.
    (inserted_cell : certified_interval_positive_positional_indexed_prime_cell inserted)
    (sequence : certified_interval_positive_positional_ordered_prime_sequence)
    : certified_interval_positive_positional_ordered_prime_sequence =
    match sequence with
    | CertifiedIntervalPositivePositionalOrderedPrimeSequenceDone =>
        CertifiedIntervalPositivePositionalOrderedPrimeSequenceSome (exists (
            CertifiedIntervalPositivePositionalOrderedPrimeSequenceLast inserted_cell))
    | CertifiedIntervalPositivePositionalOrderedPrimeSequenceSome payload =>
        inl exists head. ordered = payload
        inl inserted_value =
            certified_interval_positive_positional_indexed_prime_cell_value inserted_cell
        inl head_value =
            certified_interval_positive_positional_ordered_prime_sequence_head_value ordered
        match synthesize_positive_positional_order inserted_value head_value with
        | PositivePositionalOrderDecisionLess less =>
            CertifiedIntervalPositivePositionalOrderedPrimeSequenceSome (exists (
                CertifiedIntervalPositivePositionalOrderedPrimeSequenceMore (exists (
                    inserted_cell,
                    CertifiedIntervalPositivePositionalPrimeLessOrEqualLess less,
                    ordered))))
        | PositivePositionalOrderDecisionEqual equal =>
            CertifiedIntervalPositivePositionalOrderedPrimeSequenceSome (exists (
                CertifiedIntervalPositivePositionalOrderedPrimeSequenceMore (exists (
                    inserted_cell,
                    CertifiedIntervalPositivePositionalPrimeLessOrEqualEqual equal,
                    ordered))))
        | PositivePositionalOrderDecisionGreater greater =>
            CertifiedIntervalPositivePositionalOrderedPrimeSequenceSome (exists (
                certified_interval_positive_positional_ordered_prime_sequence_insert_after
                    (CertifiedIntervalPositivePositionalPrimeLessOrEqualLess greater)
                    inserted_cell
                    ordered))

inl rec canonicalize_certified_interval_positive_positional_complete_prime_sequence
    (sequence : certified_interval_positive_positional_complete_prime_sequence)
    : certified_interval_positive_positional_ordered_prime_sequence =
    match sequence with
    | CertifiedIntervalPositivePositionalCompletePrimeSequenceDone =>
        CertifiedIntervalPositivePositionalOrderedPrimeSequenceDone
    | CertifiedIntervalPositivePositionalCompletePrimeSequenceMore (head, tail) =>
        inl sorted_tail =
            canonicalize_certified_interval_positive_positional_complete_prime_sequence tail
