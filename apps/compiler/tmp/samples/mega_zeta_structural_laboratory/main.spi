            membership_path candidate_path
    inl _, _, membership_nodes, membership_edges =
        positive_positional_transitive_predecessor_path_runtime
            start_value candidate_value membership_path
    inl _, accessibility_nodes, accessibility_edges =
        positive_positional_predecessor_accessibility_runtime
            candidate_value accessibility
    inl _, _, joined_nodes, joined_edges =
        positive_positional_transitive_predecessor_path_runtime
            start_value PositivePositionalOne joined_path
    positive_positional_nat_to_i64 start_value,
    positive_positional_nat_to_i64 candidate_value,
    membership_nodes,
    membership_edges,
    accessibility_nodes,
    accessibility_edges,
    joined_nodes,
    joined_edges

