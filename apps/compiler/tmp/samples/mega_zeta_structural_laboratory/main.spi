    match certified_arithmetic_prime_power_run power with
    | CertifiedIntervalPositivePositionalProductMultiplicityRunLast _ =>
        CertifiedArithmeticPositiveExponentOne
    | CertifiedIntervalPositivePositionalProductMultiplicityRunMore payload =>
        inl exists previous_product. previous_run, _ = payload
        CertifiedArithmeticPositiveExponentMore (
            certified_arithmetic_prime_power_exponent (
                certified_arithmetic_prime_power_from_run previous_run))

union certified_interval_positive_positional_product_multiplicity_normal_form root =
    | CertifiedIntervalPositivePositionalProductMultiplicityNormalForm :: forall root.
        (exists left_factor left_count left_product right_factor right_count right_product.
