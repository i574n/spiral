union rec certified_interval_positive_positional_product_multiplicity_run factor count product =
    | CertifiedIntervalPositivePositionalProductMultiplicityRunLast :: forall factor.
        certified_interval_positive_positional_indexed_prime_cell factor ->
        certified_interval_positive_positional_product_multiplicity_run
            factor (z_nat_succ z_nat_zero) factor
    | CertifiedIntervalPositivePositionalProductMultiplicityRunMore :: forall factor previous_count product.
        (exists previous_product.
            certified_interval_positive_positional_product_multiplicity_run
                factor previous_count previous_product *
            positive_positional_multiply factor previous_product product) ->
        certified_interval_positive_positional_product_multiplicity_run
            factor (z_nat_succ previous_count) product

inl rec certified_interval_positive_positional_product_multiplicity_run_prime forall factor count product.
    (run : certified_interval_positive_positional_product_multiplicity_run factor count product) :
    certified_interval_positive_positional_indexed_prime_cell factor =
