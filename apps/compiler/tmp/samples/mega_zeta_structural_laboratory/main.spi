    | PositivePositionalMultiplyOne _ =>
        PositivePositionalOne
    | PositivePositionalMultiplyZeroBit tail =>
        PositivePositionalZeroBit (positive_positional_multiply_right_value tail)
    | PositivePositionalMultiplyOneBit payload =>
        := \? product. multiplication, _ = payload
        PositivePositionalOneBit (positive_positional_multiply_right_value multiplication)

