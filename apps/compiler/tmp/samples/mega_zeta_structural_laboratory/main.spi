inl rec positive_positional_successor_output_value forall input output.
    (successor : positive_positional_successor input output)
    : positive_positional_nat output =
    match successor with
    | PositivePositionalSuccessorOne =>
        PositivePositionalZeroBit PositivePositionalOne
    | PositivePositionalSuccessorZeroBit tail =>
        PositivePositionalOneBit tail
    | PositivePositionalSuccessorOneBit tail =>
        PositivePositionalZeroBit (
            positive_positional_successor_output_value tail)

inl nonnegative_positional_successor_output_value forall input output.
    (successor : nonnegative_positional_successor input output)
    : nonnegative_positional_nat output =
    match successor with
    | NonnegativePositionalSuccessorZero =>
        NonnegativePositionalPositive PositivePositionalOne
    | NonnegativePositionalSuccessorPositive positive =>
        NonnegativePositionalPositive (
            positive_positional_successor_output_value positive)

inl value_synthesized_structural_division_quotient_value
    forall dividend divisor quotient remainder.
    (division :
        value_synthesized_structural_division
            dividend divisor quotient remainder)
    : nonnegative_positional_nat quotient =
    match division with
    | ValueSynthesizedStructuralDivisionLess _ =>
        NonnegativePositionalZero
    | ValueSynthesizedStructuralDivisionEqual _ =>
        NonnegativePositionalPositive PositivePositionalOne
    | ValueSynthesizedStructuralDivisionStep payload =>
        inl exists reduced previous_quotient.
            _, _, _, _, successor = payload
        nonnegative_positional_successor_output_value successor

