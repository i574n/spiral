            positive_positional_equal left left_next *
            certified_interval_positive_positional_prime_multiplicity_run_from left_next *
            certified_interval_positive_positional_indexed_prime_cell right *
            positive_positional_equal right right_next *
            certified_interval_positive_positional_prime_multiplicity_run_from right_next) ->
        certified_interval_positive_positional_prime_multiplicity_run_pair_shape left right

:= certified_interval_positive_positional_prime_multiplicity_run_pair_shape_from_runs \* left right.
    (left_run : certified_interval_positive_positional_prime_multiplicity_run_from left)
    (right_run : certified_interval_positive_positional_prime_multiplicity_run_from right)
    : certified_interval_positive_positional_prime_multiplicity_run_pair_shape left right =
    ?= left_run, right_run ?|
    | CertifiedIntervalPositivePositionalPrimeMultiplicityRunLast left_cell,
      CertifiedIntervalPositivePositionalPrimeMultiplicityRunLast right_cell =>
        CertifiedIntervalPositivePositionalPrimeMultiplicityRunPairShapeBothLast (
            left_cell,
            right_cell)
    | CertifiedIntervalPositivePositionalPrimeMultiplicityRunLast left_cell,
      CertifiedIntervalPositivePositionalPrimeMultiplicityRunMore right_payload =>
        := \? right_next. right_cell, right_equal, right_tail = right_payload
        CertifiedIntervalPositivePositionalPrimeMultiplicityRunPairShapeLeftLastRightMore (\? (
            left_cell,
            right_cell,
            right_equal,
            right_tail))
    | CertifiedIntervalPositivePositionalPrimeMultiplicityRunMore left_payload,
      CertifiedIntervalPositivePositionalPrimeMultiplicityRunLast right_cell =>
