inl rec positive_positional_multiply_left_value forall left right result.
    (proof : positive_positional_multiply left right result)
    : positive_positional_nat left =
    match proof with
    | PositivePositionalMultiplyOne left_value => left_value
    | PositivePositionalMultiplyZeroBit tail =>
        positive_positional_multiply_left_value tail
    | PositivePositionalMultiplyOneBit payload =>
        inl exists product. tail, _ = payload
        positive_positional_multiply_left_value tail

inl rec positive_positional_multiply_right_value forall left right result.
    (proof : positive_positional_multiply left right result)
    : positive_positional_nat right =
    match proof with
    | PositivePositionalMultiplyOne _ =>
        PositivePositionalOne
    | PositivePositionalMultiplyZeroBit tail =>
        PositivePositionalZeroBit (positive_positional_multiply_right_value tail)
    | PositivePositionalMultiplyOneBit payload =>
        inl exists product. multiplication, _ = payload
        PositivePositionalOneBit (positive_positional_multiply_right_value multiplication)

