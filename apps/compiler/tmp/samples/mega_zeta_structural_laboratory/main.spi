            right_input right_output right_nodes right_edges
    "path-append-associativity-now-runs-over-three-genuinely-nonempty-indexed-predecessor-segments-four-to-three-three-to-two-and-two-to-one-each-derived-from-its-own-predecessor-and-strict-order-proof-so-both-parenthesizations-preserve-four-nodes-and-three-certified-edges-without-endpoint-identity-placeholders-while-factorization-specific-quotient-composition-and-arbitrary-tree-uniqueness-remain-open-sealed"

inl positive_positional_transitive_predecessor_path_append_measure_runtime () :
    i64 * i64 * i64 * i64 * i64 * i64 =
    inl four = positive_positional_four_value ()
    inl three = positive_positional_three_value ()
    inl two = positive_positional_two_value ()
    inl one = PositivePositionalOne
    inl four_to_three = PositivePositionalPredecessorZeroBitHigher PositivePositionalPredecessorTwo
    inl three_to_two = PositivePositionalPredecessorOneBit PositivePositionalOne
    inl two_to_one = PositivePositionalPredecessorTwo
    inl left =
        PositivePositionalTransitivePredecessorPathStep (exists (
            three,
            four_to_three,
            positive_positional_predecessor_implies_less four_to_three,
            PositivePositionalTransitivePredecessorPathDone three))
    inl middle =
        PositivePositionalTransitivePredecessorPathStep (exists (
            two,
            three_to_two,
            positive_positional_predecessor_implies_less three_to_two,
            PositivePositionalTransitivePredecessorPathDone two))
    inl last =
        PositivePositionalTransitivePredecessorPathStep (exists (
            one,
            two_to_one,
            positive_positional_predecessor_implies_less two_to_one,
            PositivePositionalTransitivePredecessorPathDone one))
    inl right = positive_positional_transitive_predecessor_path_append middle last
    inl joined = positive_positional_transitive_predecessor_path_append left right
    inl _, _, left_nodes, left_edges =
        positive_positional_transitive_predecessor_path_runtime four three left
    inl _, _, right_nodes, right_edges =
        positive_positional_transitive_predecessor_path_runtime three one right
    inl input, output, joined_nodes, joined_edges =
        positive_positional_transitive_predecessor_path_runtime four one joined
    input, output, joined_nodes, joined_edges,
    zeta_runtime_sub_i64
        (zeta_runtime_add_closure_i64 left_nodes right_nodes) 1i64,
    zeta_runtime_add_closure_i64 left_edges right_edges

