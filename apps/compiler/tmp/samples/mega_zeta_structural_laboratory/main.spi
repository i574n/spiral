:= ^ positive_positional_equal_left_value \* left right.
    (proof : positive_positional_equal left right)
    : positive_positional_nat left =
    ?= proof ?|
    | PositivePositionalEqualOne => PositivePositionalOne
    | PositivePositionalEqualZeroBit tail =>
        PositivePositionalZeroBit
            (positive_positional_equal_left_value tail)
    | PositivePositionalEqualOneBit tail =>
        PositivePositionalOneBit
            (positive_positional_equal_left_value tail)

:= ^ positive_positional_less_left_value \* left right.
    (proof : positive_positional_less left right)
    : positive_positional_nat left =
    ?= proof ?|
    | PositivePositionalLessOneZeroBit _ => PositivePositionalOne
    | PositivePositionalLessOneOneBit _ => PositivePositionalOne
    | PositivePositionalLessHigherZeroZero tail =>
        PositivePositionalZeroBit
            (positive_positional_less_left_value tail)
    | PositivePositionalLessHigherZeroOne tail =>
        PositivePositionalZeroBit
            (positive_positional_less_left_value tail)
    | PositivePositionalLessHigherOneZero tail =>
        PositivePositionalOneBit
            (positive_positional_less_left_value tail)
    | PositivePositionalLessHigherOneOne tail =>
        PositivePositionalOneBit
            (positive_positional_less_left_value tail)
    | PositivePositionalLessSameTailZeroOne equal_tail =>
        PositivePositionalZeroBit
            (positive_positional_equal_left_value equal_tail)

