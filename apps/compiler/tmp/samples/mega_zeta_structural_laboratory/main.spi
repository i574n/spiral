:| ^ positive_positional_transitive_predecessor_path input output =
    | PositivePositionalTransitivePredecessorPathDone :: \* natural.
        positive_positional_nat natural ->
        positive_positional_transitive_predecessor_path natural natural
    | PositivePositionalTransitivePredecessorPathStep :: \* input output.
        (\? middle.
            positive_positional_nat middle *
            positive_positional_predecessor input middle *
            positive_positional_less middle input *
            positive_positional_transitive_predecessor_path middle output) ->
        positive_positional_transitive_predecessor_path input output

:= ^ certified_interval_positive_positional_factor_membership_to_transitive_path
    \* candidate start length.
    (membership :
        certified_interval_positive_positional_factor_membership
            candidate start length)
    : positive_positional_transitive_predecessor_path start candidate =
    ?= membership ?|
    | CertifiedIntervalPositivePositionalFactorMembershipHere
        (candidate_value, _, predecessor, _) =>
        PositivePositionalTransitivePredecessorPathStep (\? (
            candidate_value,
            predecessor,
            positive_positional_predecessor_implies_less predecessor,
            PositivePositionalTransitivePredecessorPathDone candidate_value))
    | CertifiedIntervalPositivePositionalFactorMembershipThere payload =>
        := \? head.
            _, head_value, _, predecessor, tail_membership, _ = payload
        PositivePositionalTransitivePredecessorPathStep (\? (
            head_value,
            predecessor,
            positive_positional_predecessor_implies_less predecessor,
            certified_interval_positive_positional_factor_membership_to_transitive_path
                tail_membership))

:| positive_positional_strict_predecessor_path input output =
    | PositivePositionalStrictPredecessorPathOne :: \* input output.
        positive_positional_nat output *
        positive_positional_predecessor input output *
        positive_positional_less output input ->
        positive_positional_strict_predecessor_path input output
    | PositivePositionalStrictPredecessorPathMore :: \* input output.
        (\? middle.
            positive_positional_nat middle *
            positive_positional_predecessor input middle *
            positive_positional_less middle input *
            positive_positional_transitive_predecessor_path middle output) ->
        positive_positional_strict_predecessor_path input output

:= ^ certified_interval_positive_positional_factor_membership_to_strict_path
    \* candidate start length.
    (membership : certified_interval_positive_positional_factor_membership candidate start length)
    : positive_positional_strict_predecessor_path start candidate =
    ?= membership ?|
    | CertifiedIntervalPositivePositionalFactorMembershipHere
        (candidate_value, _, predecessor, _) =>
        PositivePositionalStrictPredecessorPathOne (
            candidate_value,
            predecessor,
            positive_positional_predecessor_implies_less predecessor)
    | CertifiedIntervalPositivePositionalFactorMembershipThere payload =>
        := \? head.
            _, head_value, _, predecessor, tail_membership, _ = payload
        PositivePositionalStrictPredecessorPathMore (\? (
            head_value,
            predecessor,
            positive_positional_predecessor_implies_less predecessor,
            certified_interval_positive_positional_factor_membership_to_transitive_path
                tail_membership))

:= positive_positional_strict_predecessor_path_to_transitive_path \* input output.
    (path : positive_positional_strict_predecessor_path input output)
    : positive_positional_transitive_predecessor_path input output =
    ?= path ?|
    | PositivePositionalStrictPredecessorPathOne
        (output_value, predecessor, strict_less) =>
        PositivePositionalTransitivePredecessorPathStep (\? (
            output_value,
            predecessor,
            strict_less,
            PositivePositionalTransitivePredecessorPathDone output_value))
    | PositivePositionalStrictPredecessorPathMore payload =>
        := \? middle. middle_value, predecessor, strict_less, tail = payload
        PositivePositionalTransitivePredecessorPathStep (\? (
            middle_value,
            predecessor,
            strict_less,
            tail))

:= ^ positive_positional_transitive_predecessor_path_output_value \* input output.
    (path : positive_positional_transitive_predecessor_path input output)
    : positive_positional_nat output =
    ?= path ?|
    | PositivePositionalTransitivePredecessorPathDone output_value =>
        output_value
    | PositivePositionalTransitivePredecessorPathStep payload =>
        := \? middle. _, _, _, tail = payload
        positive_positional_transitive_predecessor_path_output_value tail

:= positive_positional_transitive_predecessor_path_output_accessibility \* input output.
    (path : positive_positional_transitive_predecessor_path input output)
    : positive_positional_predecessor_accessibility output =
    derive_positive_positional_predecessor_accessibility
        (positive_positional_transitive_predecessor_path_output_value path)

:= ^ positive_positional_accessibility_to_transitive_path \* natural.
    (value : positive_positional_nat natural)
    (accessibility : positive_positional_predecessor_accessibility natural)
    : positive_positional_transitive_predecessor_path natural positional_one =
    ?= accessibility ?|
    | PositivePositionalPredecessorAccessibilityOne _ =>
        PositivePositionalTransitivePredecessorPathDone PositivePositionalOne
    | PositivePositionalPredecessorAccessibilityStep payload =>
        := \? predecessor.
            predecessor_proof, tail, _ = payload
        := predecessor_value =
            positive_positional_predecessor_output_value predecessor_proof
        := predecessor_less =
            positive_positional_predecessor_implies_less predecessor_proof
        PositivePositionalTransitivePredecessorPathStep (\? (
            predecessor_value,
            predecessor_proof,
            predecessor_less,
            positive_positional_accessibility_to_transitive_path
                predecessor_value tail))

