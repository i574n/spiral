// Run-time checks are core-free ops (F# macros until 2026-10-06, so only the F# backend could run them); a failed check
// stops the program with its message on every backend.
inl mega_runtime_fail forall t. (message : string) : t = !!!!FailWith(`t, message)

nominal interval lower upper = lower * upper * string
nominal z_nat_zero = string
nominal z_nat_succ n = n * string

inl zeta_runtime_i64_add (left : i64) (right : i64) : i64 = !!!!Add(left, right)

inl zeta_runtime_mul_i64 (left : i64) (right : i64) : i64 =
    !!!!Mult(left, right)

nominal positional_one = ()
nominal positional_zero_bit tail = tail
nominal positional_one_bit tail = tail

union rec positive_positional_nat bits =
    | PositivePositionalOne :: positive_positional_nat positional_one
    | PositivePositionalZeroBit :: forall tail.
        positive_positional_nat tail ->
        positive_positional_nat (positional_zero_bit tail)
    | PositivePositionalOneBit :: forall tail.
        positive_positional_nat tail ->
        positive_positional_nat (positional_one_bit tail)

inl rec positive_positional_nat_to_i64 forall bits.
    (value : positive_positional_nat bits) : i64 =
    match value with
    | PositivePositionalOne => 1i64
    | PositivePositionalZeroBit tail =>
        zeta_runtime_mul_i64 2i64 (positive_positional_nat_to_i64 tail)
    | PositivePositionalOneBit tail =>
        zeta_runtime_i64_add 1i64 (zeta_runtime_mul_i64 2i64 (positive_positional_nat_to_i64 tail))

union rec positive_positional_successor input output =
    | PositivePositionalSuccessorOne ::
        positive_positional_successor positional_one (positional_zero_bit positional_one)
    | PositivePositionalSuccessorZeroBit :: forall tail.
        positive_positional_nat tail ->
        positive_positional_successor (positional_zero_bit tail) (positional_one_bit tail)
    | PositivePositionalSuccessorOneBit :: forall tail next.
        positive_positional_successor tail next ->
        positive_positional_successor (positional_one_bit tail) (positional_zero_bit next)

inl positional_fourteen () :
    positive_positional_nat (positional_zero_bit (positional_one_bit (positional_one_bit positional_one))) =
    PositivePositionalZeroBit (
        PositivePositionalOneBit (
            PositivePositionalOneBit PositivePositionalOne))

union rec positive_positional_add left right result =
    | PositivePositionalAddOneOne ::
        positive_positional_add positional_one positional_one (positional_zero_bit positional_one)
    | PositivePositionalAddOneZeroBit :: forall right.
        positive_positional_nat right ->
        positive_positional_add positional_one (positional_zero_bit right) (positional_one_bit right)
    | PositivePositionalAddZeroBitOne :: forall left.
        positive_positional_nat left ->
        positive_positional_add (positional_zero_bit left) positional_one (positional_one_bit left)
    | PositivePositionalAddOneOneBit :: forall right next.
        positive_positional_successor right next ->
        positive_positional_add positional_one (positional_one_bit right) (positional_zero_bit next)
    | PositivePositionalAddOneBitOne :: forall left next.
        positive_positional_successor left next ->
        positive_positional_add (positional_one_bit left) positional_one (positional_zero_bit next)
    | PositivePositionalAddZeroZero :: forall left right sum.
        positive_positional_add left right sum ->
        positive_positional_add (positional_zero_bit left) (positional_zero_bit right) (positional_zero_bit sum)
    | PositivePositionalAddZeroOne :: forall left right sum.
        positive_positional_add left right sum ->
        positive_positional_add (positional_zero_bit left) (positional_one_bit right) (positional_one_bit sum)
    | PositivePositionalAddOneZero :: forall left right sum.
        positive_positional_add left right sum ->
        positive_positional_add (positional_one_bit left) (positional_zero_bit right) (positional_one_bit sum)
    | PositivePositionalAddOneOneBits :: forall left right next.
        (exists sum.
            positive_positional_add left right sum *
            positive_positional_successor sum next) ->
        positive_positional_add (positional_one_bit left) (positional_one_bit right) (positional_zero_bit next)

union rec positive_positional_multiply left right result =
    | PositivePositionalMultiplyOne :: forall left.
        positive_positional_nat left ->
        positive_positional_multiply left positional_one left
    | PositivePositionalMultiplyZeroBit :: forall left right product.
        positive_positional_multiply left right product ->
        positive_positional_multiply left
            (positional_zero_bit right)
            (positional_zero_bit product)
    | PositivePositionalMultiplyOneBit :: forall left right result.
        (exists product.
            positive_positional_multiply left right product *
            positive_positional_add (positional_zero_bit product) left result) ->
        positive_positional_multiply left
            (positional_one_bit right)
            result

inl rec positive_positional_successor_output_value forall input output.
    (proof : positive_positional_successor input output) : positive_positional_nat output =
    match proof with
    | PositivePositionalSuccessorOne =>
        PositivePositionalZeroBit PositivePositionalOne
    | PositivePositionalSuccessorZeroBit tail =>
        PositivePositionalOneBit tail
    | PositivePositionalSuccessorOneBit tail_proof =>
        PositivePositionalZeroBit (positive_positional_successor_output_value tail_proof)

inl rec positive_positional_add_result_value forall left right result.
    (proof : positive_positional_add left right result) : positive_positional_nat result =
    match proof with
    | PositivePositionalAddOneOne =>
        PositivePositionalZeroBit PositivePositionalOne
    | PositivePositionalAddOneZeroBit right_value =>
        PositivePositionalOneBit right_value
    | PositivePositionalAddZeroBitOne left_value =>
        PositivePositionalOneBit left_value
    | PositivePositionalAddOneOneBit successor_proof =>
        PositivePositionalZeroBit (positive_positional_successor_output_value successor_proof)
    | PositivePositionalAddOneBitOne successor_proof =>
        PositivePositionalZeroBit (positive_positional_successor_output_value successor_proof)
    | PositivePositionalAddZeroZero inner =>
        PositivePositionalZeroBit (positive_positional_add_result_value inner)
    | PositivePositionalAddZeroOne inner =>
        PositivePositionalOneBit (positive_positional_add_result_value inner)
    | PositivePositionalAddOneZero inner =>
        PositivePositionalOneBit (positive_positional_add_result_value inner)
    | PositivePositionalAddOneOneBits payload =>
        inl exists sum. _, successor_proof = payload
        PositivePositionalZeroBit (positive_positional_successor_output_value successor_proof)

inl rec positive_positional_multiply_result_value forall left right result.
    (proof : positive_positional_multiply left right result) : positive_positional_nat result =
    match proof with
    | PositivePositionalMultiplyOne left_value => left_value
    | PositivePositionalMultiplyZeroBit inner =>
        PositivePositionalZeroBit (positive_positional_multiply_result_value inner)
    | PositivePositionalMultiplyOneBit payload =>
        inl exists product. _, add_proof = payload
        positive_positional_add_result_value add_proof

inl positive_positional_three_value () :
    positive_positional_nat (positional_one_bit positional_one) =
    PositivePositionalOneBit PositivePositionalOne

union rec positive_positional_equal left right =
    | PositivePositionalEqualOne ::
        positive_positional_equal positional_one positional_one
    | PositivePositionalEqualZeroBit :: forall left right.
        positive_positional_equal left right ->
        positive_positional_equal
            (positional_zero_bit left)
            (positional_zero_bit right)
    | PositivePositionalEqualOneBit :: forall left right.
        positive_positional_equal left right ->
        positive_positional_equal
            (positional_one_bit left)
            (positional_one_bit right)

inl rec positive_positional_equal_consume forall left right.
    (proof : positive_positional_equal left right) : () =
    match proof with
    | PositivePositionalEqualOne => ()
    | PositivePositionalEqualZeroBit inner =>
        positive_positional_equal_consume inner
    | PositivePositionalEqualOneBit inner =>
        positive_positional_equal_consume inner

union rec positive_positional_less left right =
    | PositivePositionalLessOneZeroBit :: forall right.
        positive_positional_nat right ->
        positive_positional_less positional_one (positional_zero_bit right)
    | PositivePositionalLessOneOneBit :: forall right.
        positive_positional_nat right ->
        positive_positional_less positional_one (positional_one_bit right)
    | PositivePositionalLessHigherZeroZero :: forall left right.
        positive_positional_less left right ->
        positive_positional_less
            (positional_zero_bit left)
            (positional_zero_bit right)
    | PositivePositionalLessHigherZeroOne :: forall left right.
        positive_positional_less left right ->
        positive_positional_less
            (positional_zero_bit left)
            (positional_one_bit right)
    | PositivePositionalLessHigherOneZero :: forall left right.
        positive_positional_less left right ->
        positive_positional_less
            (positional_one_bit left)
            (positional_zero_bit right)
    | PositivePositionalLessHigherOneOne :: forall left right.
        positive_positional_less left right ->
        positive_positional_less
            (positional_one_bit left)
            (positional_one_bit right)
    | PositivePositionalLessSameTailZeroOne :: forall left right.
        positive_positional_equal left right ->
        positive_positional_less
            (positional_zero_bit left)
            (positional_one_bit right)

inl positional_three_equal () :
    positive_positional_equal
        (positional_one_bit positional_one)
        (positional_one_bit positional_one) =
    PositivePositionalEqualOneBit PositivePositionalEqualOne

inl positional_six_less_seven () :
    positive_positional_less
        (positional_zero_bit (positional_one_bit positional_one))
        (positional_one_bit (positional_one_bit positional_one)) =
    PositivePositionalLessSameTailZeroOne (positional_three_equal ())

inl positional_thirteen_less_fourteen () :
    positive_positional_less
        (positional_one_bit (positional_zero_bit (positional_one_bit positional_one)))
        (positional_zero_bit (positional_one_bit (positional_one_bit positional_one))) =
    PositivePositionalLessHigherOneZero (positional_six_less_seven ())

union positive_positional_euclidean_division dividend divisor quotient remainder =
    | PositivePositionalEuclideanDivision :: forall dividend divisor quotient remainder.
        (exists product.
            positive_positional_multiply quotient divisor product *
            positive_positional_add product remainder dividend *
            positive_positional_less remainder divisor) ->
        positive_positional_euclidean_division dividend divisor quotient remainder

inl positive_positional_two_value () :
    positive_positional_nat (positional_zero_bit positional_one) =
    PositivePositionalZeroBit PositivePositionalOne

inl positive_positional_four_value () :
    positive_positional_nat (positional_zero_bit (positional_zero_bit positional_one)) =
    PositivePositionalZeroBit (PositivePositionalZeroBit PositivePositionalOne)

inl positive_positional_twelve_value () :
    positive_positional_nat
        (positional_zero_bit (positional_zero_bit (positional_one_bit positional_one))) =
    PositivePositionalZeroBit (
        PositivePositionalZeroBit (
            PositivePositionalOneBit PositivePositionalOne))

inl positive_positional_five_value () :
    positive_positional_nat (positional_one_bit (positional_zero_bit positional_one)) =
    PositivePositionalOneBit (positive_positional_two_value ())

inl positive_positional_six_value () :
    positive_positional_nat (positional_zero_bit (positional_one_bit positional_one)) =
    PositivePositionalZeroBit (positive_positional_three_value ())


inl positional_four_times_one () :
    positive_positional_multiply
        (positional_zero_bit (positional_zero_bit positional_one))
        positional_one
        (positional_zero_bit (positional_zero_bit positional_one)) =
    PositivePositionalMultiplyOne (positive_positional_four_value ())

inl positional_eight_plus_four () :
    positive_positional_add
        (positional_zero_bit (positional_zero_bit (positional_zero_bit positional_one)))
        (positional_zero_bit (positional_zero_bit positional_one))
        (positional_zero_bit (positional_zero_bit (positional_one_bit positional_one))) =
    PositivePositionalAddZeroZero (
        PositivePositionalAddZeroZero (
            PositivePositionalAddZeroBitOne PositivePositionalOne))

inl positional_four_times_three () :
    positive_positional_multiply
        (positional_zero_bit (positional_zero_bit positional_one))
        (positional_one_bit positional_one)
        (positional_zero_bit (positional_zero_bit (positional_one_bit positional_one))) =
    PositivePositionalMultiplyOneBit (exists (
        positional_four_times_one (),
        positional_eight_plus_four ()))

inl positional_twelve_plus_two () :
    positive_positional_add
        (positional_zero_bit (positional_zero_bit (positional_one_bit positional_one)))
        (positional_zero_bit positional_one)
        (positional_zero_bit (positional_one_bit (positional_one_bit positional_one))) =
    PositivePositionalAddZeroZero (
        PositivePositionalAddZeroBitOne (
            PositivePositionalOneBit PositivePositionalOne))

inl positional_two_less_three () :
    positive_positional_less
        (positional_zero_bit positional_one)
        (positional_one_bit positional_one) =
    PositivePositionalLessSameTailZeroOne PositivePositionalEqualOne

inl positional_fourteen_div_three () :
    positive_positional_euclidean_division
        (positional_zero_bit (positional_one_bit (positional_one_bit positional_one)))
        (positional_one_bit positional_one)
        (positional_zero_bit (positional_zero_bit positional_one))
        (positional_zero_bit positional_one) =
    PositivePositionalEuclideanDivision (exists (
        positional_four_times_three (),
        positional_twelve_plus_two (),
        positional_two_less_three ()))

nominal positional_zero = ()

union nonnegative_positional_nat bits =
    | NonnegativePositionalZero :: nonnegative_positional_nat positional_zero
    | NonnegativePositionalPositive :: forall bits.
        positive_positional_nat bits ->
        nonnegative_positional_nat bits

inl positive_positional_seven_value () :
    positive_positional_nat (positional_one_bit (positional_one_bit positional_one)) =
    PositivePositionalOneBit (positive_positional_three_value ())

inl zeta_runtime_sub_i64 (left : i64) (right : i64) : i64 = !!!!Sub(left, right)

inl zeta_runtime_add_closure_i64 (left : i64) (right : i64) : i64 = !!!!Add(left, right)

union nonnegative_positional_successor input output =
    | NonnegativePositionalSuccessorZero ::
        nonnegative_positional_successor positional_zero positional_one
    | NonnegativePositionalSuccessorPositive :: forall input output.
        positive_positional_successor input output ->
        nonnegative_positional_successor input output

union positive_positional_successor_synthesis input =
    | PositivePositionalSuccessorSynthesis :: forall input.
        (exists output.
            positive_positional_nat output *
            positive_positional_successor input output) ->
        positive_positional_successor_synthesis input

inl rec synthesize_positive_positional_successor forall input.
    (value : positive_positional_nat input)
    : positive_positional_successor_synthesis input =
    match value with
    | PositivePositionalOne =>
        PositivePositionalSuccessorSynthesis (exists (
            PositivePositionalZeroBit PositivePositionalOne,
            PositivePositionalSuccessorOne))
    | PositivePositionalZeroBit tail =>
        PositivePositionalSuccessorSynthesis (exists (
            PositivePositionalOneBit tail,
            PositivePositionalSuccessorZeroBit tail))
    | PositivePositionalOneBit tail =>
        match synthesize_positive_positional_successor tail with
        | PositivePositionalSuccessorSynthesis payload =>
            inl exists output. output_value, successor = payload
            PositivePositionalSuccessorSynthesis (exists (
                PositivePositionalZeroBit output_value,
                PositivePositionalSuccessorOneBit successor))

union nonnegative_positional_successor_synthesis input =
    | NonnegativePositionalSuccessorSynthesis :: forall input.
        (exists output.
            nonnegative_positional_nat output *
            nonnegative_positional_successor input output) ->
        nonnegative_positional_successor_synthesis input

inl synthesize_nonnegative_positional_successor forall input.
    (value : nonnegative_positional_nat input)
    : nonnegative_positional_successor_synthesis input =
    match value with
    | NonnegativePositionalZero =>
        NonnegativePositionalSuccessorSynthesis (exists (
            NonnegativePositionalPositive PositivePositionalOne,
            NonnegativePositionalSuccessorZero))
    | NonnegativePositionalPositive positive =>
        match synthesize_positive_positional_successor positive with
        | PositivePositionalSuccessorSynthesis payload =>
            inl exists output. output_value, successor = payload
            NonnegativePositionalSuccessorSynthesis (exists (
                NonnegativePositionalPositive output_value,
                NonnegativePositionalSuccessorPositive successor))

union positive_positional_order_decision left right =
    | PositivePositionalOrderDecisionLess :: forall left right.
        positive_positional_less left right ->
        positive_positional_order_decision left right
    | PositivePositionalOrderDecisionEqual :: forall left right.
        positive_positional_equal left right ->
        positive_positional_order_decision left right
    | PositivePositionalOrderDecisionGreater :: forall left right.
        positive_positional_less right left ->
        positive_positional_order_decision left right

inl rec positive_positional_equal_symmetry forall left right.
    (equal : positive_positional_equal left right)
    : positive_positional_equal right left =
    match equal with
    | PositivePositionalEqualOne => PositivePositionalEqualOne
    | PositivePositionalEqualZeroBit tail =>
        PositivePositionalEqualZeroBit (
            positive_positional_equal_symmetry tail)
    | PositivePositionalEqualOneBit tail =>
        PositivePositionalEqualOneBit (
            positive_positional_equal_symmetry tail)

inl rec synthesize_positive_positional_order forall left right.
    (left_value : positive_positional_nat left)
    (right_value : positive_positional_nat right)
    : positive_positional_order_decision left right =
    match left_value with
    | PositivePositionalOne =>
        match right_value with
        | PositivePositionalOne =>
            PositivePositionalOrderDecisionEqual PositivePositionalEqualOne
        | PositivePositionalZeroBit right_tail =>
            PositivePositionalOrderDecisionLess (
                PositivePositionalLessOneZeroBit right_tail)
        | PositivePositionalOneBit right_tail =>
            PositivePositionalOrderDecisionLess (
                PositivePositionalLessOneOneBit right_tail)
    | PositivePositionalZeroBit left_tail =>
        match right_value with
        | PositivePositionalOne =>
            PositivePositionalOrderDecisionGreater (
                PositivePositionalLessOneZeroBit left_tail)
        | PositivePositionalZeroBit right_tail =>
            match synthesize_positive_positional_order left_tail right_tail with
            | PositivePositionalOrderDecisionLess less =>
                PositivePositionalOrderDecisionLess (
                    PositivePositionalLessHigherZeroZero less)
            | PositivePositionalOrderDecisionEqual equal =>
                PositivePositionalOrderDecisionEqual (
                    PositivePositionalEqualZeroBit equal)
            | PositivePositionalOrderDecisionGreater greater =>
                PositivePositionalOrderDecisionGreater (
                    PositivePositionalLessHigherZeroZero greater)
        | PositivePositionalOneBit right_tail =>
            match synthesize_positive_positional_order left_tail right_tail with
            | PositivePositionalOrderDecisionLess less =>
                PositivePositionalOrderDecisionLess (
                    PositivePositionalLessHigherZeroOne less)
            | PositivePositionalOrderDecisionEqual equal =>
                PositivePositionalOrderDecisionLess (
                    PositivePositionalLessSameTailZeroOne equal)
            | PositivePositionalOrderDecisionGreater greater =>
                PositivePositionalOrderDecisionGreater (
                    PositivePositionalLessHigherOneZero greater)
    | PositivePositionalOneBit left_tail =>
        match right_value with
        | PositivePositionalOne =>
            PositivePositionalOrderDecisionGreater (
                PositivePositionalLessOneOneBit left_tail)
        | PositivePositionalZeroBit right_tail =>
            match synthesize_positive_positional_order left_tail right_tail with
            | PositivePositionalOrderDecisionLess less =>
                PositivePositionalOrderDecisionLess (
                    PositivePositionalLessHigherOneZero less)
            | PositivePositionalOrderDecisionEqual equal =>
                PositivePositionalOrderDecisionGreater (
                    PositivePositionalLessSameTailZeroOne (
                        positive_positional_equal_symmetry equal))
            | PositivePositionalOrderDecisionGreater greater =>
                PositivePositionalOrderDecisionGreater (
                    PositivePositionalLessHigherZeroOne greater)
        | PositivePositionalOneBit right_tail =>
            match synthesize_positive_positional_order left_tail right_tail with
            | PositivePositionalOrderDecisionLess less =>
                PositivePositionalOrderDecisionLess (
                    PositivePositionalLessHigherOneOne less)
            | PositivePositionalOrderDecisionEqual equal =>
                PositivePositionalOrderDecisionEqual (
                    PositivePositionalEqualOneBit equal)
            | PositivePositionalOrderDecisionGreater greater =>
                PositivePositionalOrderDecisionGreater (
                    PositivePositionalLessHigherOneOne greater)


union rec positive_positional_predecessor input output =
    | PositivePositionalPredecessorTwo ::
        positive_positional_predecessor
            (positional_zero_bit positional_one)
            positional_one
    | PositivePositionalPredecessorZeroBitHigher :: forall input output.
        positive_positional_predecessor input output ->
        positive_positional_predecessor
            (positional_zero_bit input)
            (positional_one_bit output)
    | PositivePositionalPredecessorOneBit :: forall input.
        positive_positional_nat input ->
        positive_positional_predecessor
            (positional_one_bit input)
            (positional_zero_bit input)

inl rec positive_positional_predecessor_output_value forall input output.
    (predecessor : positive_positional_predecessor input output)
    : positive_positional_nat output =
    match predecessor with
    | PositivePositionalPredecessorTwo =>
        PositivePositionalOne
    | PositivePositionalPredecessorZeroBitHigher tail =>
        PositivePositionalOneBit (
            positive_positional_predecessor_output_value tail)
    | PositivePositionalPredecessorOneBit input_value =>
        PositivePositionalZeroBit input_value

inl rec positive_positional_predecessor_input_value forall input output.
    (predecessor : positive_positional_predecessor input output)
    : positive_positional_nat input =
    match predecessor with
    | PositivePositionalPredecessorTwo =>
        PositivePositionalZeroBit PositivePositionalOne
    | PositivePositionalPredecessorZeroBitHigher tail =>
        PositivePositionalZeroBit (
            positive_positional_predecessor_input_value tail)
    | PositivePositionalPredecessorOneBit input_value =>
        PositivePositionalOneBit input_value

union positive_positional_predecessor_result input =
    | PositivePositionalPredecessorResultOne ::
        positive_positional_predecessor_result positional_one
    | PositivePositionalPredecessorResultSome :: forall input.
        (exists output.
            positive_positional_nat output *
            positive_positional_predecessor input output) ->
        positive_positional_predecessor_result input

inl rec synthesize_positive_positional_predecessor forall input.
    (value : positive_positional_nat input)
    : positive_positional_predecessor_result input =
    match value with
    | PositivePositionalOne =>
        PositivePositionalPredecessorResultOne
    | PositivePositionalZeroBit tail =>
        match tail with
        | PositivePositionalOne =>
            PositivePositionalPredecessorResultSome (exists (
                PositivePositionalOne,
                PositivePositionalPredecessorTwo))
        | PositivePositionalZeroBit _ =>
            match synthesize_positive_positional_predecessor tail with
            | PositivePositionalPredecessorResultSome payload =>
                inl exists output. output_value, predecessor = payload
                PositivePositionalPredecessorResultSome (exists (
                    PositivePositionalOneBit output_value,
                    PositivePositionalPredecessorZeroBitHigher predecessor))
        | PositivePositionalOneBit _ =>
            match synthesize_positive_positional_predecessor tail with
            | PositivePositionalPredecessorResultSome payload =>
                inl exists output. output_value, predecessor = payload
                PositivePositionalPredecessorResultSome (exists (
                    PositivePositionalOneBit output_value,
                    PositivePositionalPredecessorZeroBitHigher predecessor))
    | PositivePositionalOneBit tail =>
        PositivePositionalPredecessorResultSome (exists (
            PositivePositionalZeroBit tail,
            PositivePositionalPredecessorOneBit tail))

inl positional_three_predecessor_two () :
    positive_positional_predecessor
        (positional_one_bit positional_one)
        (positional_zero_bit positional_one) =
    PositivePositionalPredecessorOneBit PositivePositionalOne

inl positional_four_predecessor_three () :
    positive_positional_predecessor
        (positional_zero_bit (positional_zero_bit positional_one))
        (positional_one_bit positional_one) =
    PositivePositionalPredecessorZeroBitHigher PositivePositionalPredecessorTwo

inl positional_five_predecessor_four () :
    positive_positional_predecessor
        (positional_one_bit (positional_zero_bit positional_one))
        (positional_zero_bit (positional_zero_bit positional_one)) =
    PositivePositionalPredecessorOneBit (positive_positional_two_value ())

inl positional_six_predecessor_five () :
    positive_positional_predecessor
        (positional_zero_bit (positional_one_bit positional_one))
        (positional_one_bit (positional_zero_bit positional_one)) =
    PositivePositionalPredecessorZeroBitHigher (positional_three_predecessor_two ())

union rec synthesized_positive_positional_subtract minuend subtrahend difference =
    | SynthesizedPositiveSubtractOneFromTwo ::
        synthesized_positive_positional_subtract
            (positional_zero_bit positional_one)
            positional_one
            positional_one
    | SynthesizedPositiveSubtractOneFromEvenHigher :: forall tail predecessor.
        positive_positional_predecessor tail predecessor ->
        synthesized_positive_positional_subtract
            (positional_zero_bit tail)
            positional_one
            (positional_one_bit predecessor)
    | SynthesizedPositiveSubtractOneFromOdd :: forall tail.
        positive_positional_nat tail ->
        synthesized_positive_positional_subtract
            (positional_one_bit tail)
            positional_one
            (positional_zero_bit tail)
    | SynthesizedPositiveSubtractEvenEven :: forall minuend subtrahend difference.
        synthesized_positive_positional_subtract minuend subtrahend difference ->
        synthesized_positive_positional_subtract
            (positional_zero_bit minuend)
            (positional_zero_bit subtrahend)
            (positional_zero_bit difference)
    | SynthesizedPositiveSubtractOddOdd :: forall minuend subtrahend difference.
        synthesized_positive_positional_subtract minuend subtrahend difference ->
        synthesized_positive_positional_subtract
            (positional_one_bit minuend)
            (positional_one_bit subtrahend)
            (positional_zero_bit difference)
    | SynthesizedPositiveSubtractOddEvenEqual :: forall left right.
        positive_positional_equal left right ->
        synthesized_positive_positional_subtract
            (positional_one_bit right)
            (positional_zero_bit left)
            positional_one
    | SynthesizedPositiveSubtractOddEvenGreater :: forall minuend subtrahend difference.
        synthesized_positive_positional_subtract minuend subtrahend difference ->
        synthesized_positive_positional_subtract
            (positional_one_bit minuend)
            (positional_zero_bit subtrahend)
            (positional_one_bit difference)
    | SynthesizedPositiveSubtractEvenOddUnit :: forall minuend subtrahend.
        synthesized_positive_positional_subtract
            minuend subtrahend positional_one ->
        synthesized_positive_positional_subtract
            (positional_zero_bit minuend)
            (positional_one_bit subtrahend)
            positional_one
    | SynthesizedPositiveSubtractEvenOddHigher :: forall minuend subtrahend predecessor.
        (exists difference.
            synthesized_positive_positional_subtract
                minuend subtrahend difference *
            positive_positional_predecessor difference predecessor) ->
        synthesized_positive_positional_subtract
            (positional_zero_bit minuend)
            (positional_one_bit subtrahend)
            (positional_one_bit predecessor)

union synthesized_positive_positional_subtraction minuend subtrahend =
    | SynthesizedPositivePositionalSubtraction :: forall minuend subtrahend.
        (exists difference.
            positive_positional_nat difference *
            synthesized_positive_positional_subtract
                minuend subtrahend difference) ->
        synthesized_positive_positional_subtraction minuend subtrahend

inl rec synthesize_positive_positional_subtraction forall minuend subtrahend.
    (greater : positive_positional_less subtrahend minuend)
    : synthesized_positive_positional_subtraction minuend subtrahend =
    match greater with
    | PositivePositionalLessOneZeroBit right =>
        match right with
        | PositivePositionalOne =>
            SynthesizedPositivePositionalSubtraction (exists (
                PositivePositionalOne,
                SynthesizedPositiveSubtractOneFromTwo))
        | PositivePositionalZeroBit _ =>
            match synthesize_positive_positional_predecessor right with
            | PositivePositionalPredecessorResultSome payload =>
                inl exists predecessor.
                    predecessor_value, predecessor_proof = payload
                SynthesizedPositivePositionalSubtraction (exists (
                    PositivePositionalOneBit predecessor_value,
                    SynthesizedPositiveSubtractOneFromEvenHigher
                        predecessor_proof))
        | PositivePositionalOneBit _ =>
            match synthesize_positive_positional_predecessor right with
            | PositivePositionalPredecessorResultSome payload =>
                inl exists predecessor.
                    predecessor_value, predecessor_proof = payload
                SynthesizedPositivePositionalSubtraction (exists (
                    PositivePositionalOneBit predecessor_value,
                    SynthesizedPositiveSubtractOneFromEvenHigher
                        predecessor_proof))
    | PositivePositionalLessOneOneBit right =>
        SynthesizedPositivePositionalSubtraction (exists (
            PositivePositionalZeroBit right,
            SynthesizedPositiveSubtractOneFromOdd right))
    | PositivePositionalLessHigherZeroZero tail_less =>
        match synthesize_positive_positional_subtraction tail_less with
        | SynthesizedPositivePositionalSubtraction payload =>
            inl exists difference. difference_value, subtraction = payload
            SynthesizedPositivePositionalSubtraction (exists (
                PositivePositionalZeroBit difference_value,
                SynthesizedPositiveSubtractEvenEven subtraction))
    | PositivePositionalLessHigherZeroOne tail_less =>
        match synthesize_positive_positional_subtraction tail_less with
        | SynthesizedPositivePositionalSubtraction payload =>
            inl exists difference. difference_value, subtraction = payload
            SynthesizedPositivePositionalSubtraction (exists (
                PositivePositionalOneBit difference_value,
                SynthesizedPositiveSubtractOddEvenGreater subtraction))
    | PositivePositionalLessHigherOneZero tail_less =>
        match synthesize_positive_positional_subtraction tail_less with
        | SynthesizedPositivePositionalSubtraction payload =>
            inl exists difference. difference_value, subtraction = payload
            match difference_value with
            | PositivePositionalOne =>
                SynthesizedPositivePositionalSubtraction (exists (
                    PositivePositionalOne,
                    SynthesizedPositiveSubtractEvenOddUnit subtraction))
            | PositivePositionalZeroBit _ =>
                match synthesize_positive_positional_predecessor difference_value with
                | PositivePositionalPredecessorResultSome predecessor_payload =>
                    inl exists predecessor.
                        predecessor_value, predecessor_proof = predecessor_payload
                    SynthesizedPositivePositionalSubtraction (exists (
                        PositivePositionalOneBit predecessor_value,
                        SynthesizedPositiveSubtractEvenOddHigher (exists (
                            subtraction,
                            predecessor_proof))))
            | PositivePositionalOneBit _ =>
                match synthesize_positive_positional_predecessor difference_value with
                | PositivePositionalPredecessorResultSome predecessor_payload =>
                    inl exists predecessor.
                        predecessor_value, predecessor_proof = predecessor_payload
                    SynthesizedPositivePositionalSubtraction (exists (
                        PositivePositionalOneBit predecessor_value,
                        SynthesizedPositiveSubtractEvenOddHigher (exists (
                            subtraction,
                            predecessor_proof))))
    | PositivePositionalLessHigherOneOne tail_less =>
        match synthesize_positive_positional_subtraction tail_less with
        | SynthesizedPositivePositionalSubtraction payload =>
            inl exists difference. difference_value, subtraction = payload
            SynthesizedPositivePositionalSubtraction (exists (
                PositivePositionalZeroBit difference_value,
                SynthesizedPositiveSubtractOddOdd subtraction))
    | PositivePositionalLessSameTailZeroOne equal =>
        SynthesizedPositivePositionalSubtraction (exists (
            PositivePositionalOne,
            SynthesizedPositiveSubtractOddEvenEqual equal))

union positive_division_strict_descent dividend divisor reduced =
    | PositiveDivisionStrictDescent :: forall dividend divisor reduced.
        synthesized_positive_positional_subtract dividend divisor reduced * string ->
        positive_division_strict_descent dividend divisor reduced

union rec value_synthesized_structural_division dividend divisor quotient remainder =
    | ValueSynthesizedStructuralDivisionLess :: forall dividend divisor.
        positive_positional_less dividend divisor ->
        value_synthesized_structural_division
            dividend divisor positional_zero dividend
    | ValueSynthesizedStructuralDivisionEqual :: forall dividend divisor.
        positive_positional_equal dividend divisor ->
        value_synthesized_structural_division
            dividend divisor positional_one positional_zero
    | ValueSynthesizedStructuralDivisionStep :: forall dividend divisor next_quotient remainder.
        (exists reduced quotient.
            positive_positional_nat reduced *
            positive_division_strict_descent dividend divisor reduced *
            synthesized_positive_positional_subtract dividend divisor reduced *
            value_synthesized_structural_division
                reduced divisor quotient remainder *
            nonnegative_positional_successor quotient next_quotient) ->
        value_synthesized_structural_division
            dividend divisor next_quotient remainder

inl alternate_four_div_two () :
    value_synthesized_structural_division
        (positional_zero_bit (positional_zero_bit positional_one))
        (positional_zero_bit positional_one)
        (positional_zero_bit positional_one)
        positional_zero =
    inl subtraction =
        SynthesizedPositiveSubtractEvenEven SynthesizedPositiveSubtractOneFromTwo
    ValueSynthesizedStructuralDivisionStep (exists (
        positive_positional_two_value (),
        PositiveDivisionStrictDescent (
            subtraction,
            "four-minus-two-is-the-strict-reduced-dividend"),
        subtraction,
        ValueSynthesizedStructuralDivisionEqual (
            PositivePositionalEqualZeroBit PositivePositionalEqualOne),
        NonnegativePositionalSuccessorPositive PositivePositionalSuccessorOne))

inl alternate_six_div_two () :
    value_synthesized_structural_division
        (positional_zero_bit (positional_one_bit positional_one))
        (positional_zero_bit positional_one)
        (positional_one_bit positional_one)
        positional_zero =
    inl subtraction =
        SynthesizedPositiveSubtractEvenEven (
            SynthesizedPositiveSubtractOneFromOdd PositivePositionalOne)
    ValueSynthesizedStructuralDivisionStep (exists (
        positive_positional_four_value (),
        PositiveDivisionStrictDescent (
            subtraction,
            "six-minus-two-is-the-strict-reduced-dividend"),
        subtraction,
        alternate_four_div_two (),
        NonnegativePositionalSuccessorPositive (
            PositivePositionalSuccessorZeroBit PositivePositionalOne)))

union value_synthesized_division_materialized dividend divisor =
    | ValueSynthesizedDivisionMaterialized :: forall dividend divisor.
        (exists quotient remainder.
            nonnegative_positional_nat quotient *
            nonnegative_positional_nat remainder *
            value_synthesized_structural_division
                dividend divisor quotient remainder * string) ->
        value_synthesized_division_materialized dividend divisor

inl rec synthesize_positive_division_from_values forall dividend divisor.
    (dividend_value : positive_positional_nat dividend)
    (divisor_value : positive_positional_nat divisor)
    : value_synthesized_division_materialized dividend divisor =
    match synthesize_positive_positional_order dividend_value divisor_value with
    | PositivePositionalOrderDecisionLess less =>
        ValueSynthesizedDivisionMaterialized (exists (
            NonnegativePositionalZero,
            NonnegativePositionalPositive dividend_value,
            ValueSynthesizedStructuralDivisionLess less,
            "order-and-remainder-are-derived-from-the-two-input-values"))
    | PositivePositionalOrderDecisionEqual equal =>
        ValueSynthesizedDivisionMaterialized (exists (
            NonnegativePositionalPositive PositivePositionalOne,
            NonnegativePositionalZero,
            ValueSynthesizedStructuralDivisionEqual equal,
            "equality-derives-one-and-zero-without-a-search-input"))
    | PositivePositionalOrderDecisionGreater greater =>
        match synthesize_positive_positional_subtraction greater with
        | SynthesizedPositivePositionalSubtraction subtraction_payload =>
            inl exists reduced. reduced_value, subtraction = subtraction_payload
            match synthesize_positive_division_from_values reduced_value divisor_value with
            | ValueSynthesizedDivisionMaterialized materialized_payload =>
                inl exists quotient remainder.
                    quotient_value, remainder_value, proof, _ = materialized_payload
                inl descent =
                    PositiveDivisionStrictDescent (
                        subtraction,
                        "subtracting-a-positive-divisor-produces-the-next-structural-measure")
                match synthesize_nonnegative_positional_successor quotient_value with
                | NonnegativePositionalSuccessorSynthesis successor_payload =>
                    inl exists next_quotient.
                        next_quotient_value, successor = successor_payload
                    ValueSynthesizedDivisionMaterialized (exists (
                        next_quotient_value,
                        remainder_value,
                        ValueSynthesizedStructuralDivisionStep (exists (
                            reduced_value,
                            descent,
                            subtraction,
                            proof,
                            successor)),
                        "the-evaluator-derives-a-strict-descent-witness-before-recursing"))

union positive_positional_exact_factor_decision dividend divisor =
    | PositivePositionalExactFactorFound :: forall dividend divisor.
        (exists quotient.
            positive_positional_nat quotient *
            value_synthesized_structural_division
                dividend divisor quotient positional_zero * string) ->
        positive_positional_exact_factor_decision dividend divisor
    | PositivePositionalExactFactorRejected :: forall dividend divisor.
        (exists quotient remainder.
            nonnegative_positional_nat quotient *
            positive_positional_nat remainder *
            value_synthesized_structural_division
                dividend divisor quotient remainder * string) ->
        positive_positional_exact_factor_decision dividend divisor

inl decide_positive_positional_exact_factor forall dividend divisor.
    (dividend_value : positive_positional_nat dividend)
    (divisor_value : positive_positional_nat divisor)
    : positive_positional_exact_factor_decision dividend divisor =
    match synthesize_positive_division_from_values dividend_value divisor_value with
    | ValueSynthesizedDivisionMaterialized materialized_payload =>
        inl exists quotient remainder.
            quotient_value, remainder_value, proof, _ = materialized_payload
        match quotient_value, remainder_value with
        | NonnegativePositionalPositive quotient_positive,
          NonnegativePositionalZero =>
            PositivePositionalExactFactorFound (exists (
                quotient_positive,
                proof,
                "the-positive-divisor-has-zero-remainder-and-produces-a-positive-quotient"))
        | _, NonnegativePositionalPositive remainder_positive =>
            PositivePositionalExactFactorRejected (exists (
                quotient_value,
                remainder_positive,
                proof,
                "the-positive-divisor-is-rejected-because-division-synthesizes-a-positive-remainder"))

union positive_positional_factor_candidate_nonunit natural =
    | PositivePositionalFactorCandidateNonunitZeroBit :: forall tail.
        positive_positional_nat tail ->
        positive_positional_factor_candidate_nonunit (positional_zero_bit tail)
    | PositivePositionalFactorCandidateNonunitOneBit :: forall tail.
        positive_positional_nat tail ->
        positive_positional_factor_candidate_nonunit (positional_one_bit tail)

inl positive_positional_eighteen_value () =
    PositivePositionalZeroBit (
        PositivePositionalOneBit (
            PositivePositionalZeroBit (
                PositivePositionalZeroBit PositivePositionalOne)))

union positive_positional_nonfactor_certificate dividend divisor =
    | PositivePositionalNonfactorCertificate :: forall dividend divisor.
        (exists quotient remainder.
            nonnegative_positional_nat quotient *
            positive_positional_nat remainder *
            value_synthesized_structural_division
                dividend divisor quotient remainder * string) ->
        positive_positional_nonfactor_certificate dividend divisor

union rec certified_positive_positional_candidate_interval start length =
    | CertifiedPositivePositionalCandidateIntervalOne :: string ->
        certified_positive_positional_candidate_interval positional_one z_nat_zero
    | CertifiedPositivePositionalCandidateIntervalTwo :: string ->
        certified_positive_positional_candidate_interval
            (positional_zero_bit positional_one) z_nat_zero
    | CertifiedPositivePositionalCandidateIntervalMore :: forall start previous.
        (exists candidate.
            positive_positional_nat candidate *
            positive_positional_factor_candidate_nonunit candidate *
            positive_positional_predecessor start candidate *
            certified_positive_positional_candidate_interval candidate previous *
            string) ->
        certified_positive_positional_candidate_interval start (z_nat_succ previous)

union synthesized_certified_positive_positional_candidate_interval start =
    | SynthesizedCertifiedPositivePositionalCandidateInterval :: forall start.
        (exists length.
            certified_positive_positional_candidate_interval start length * string) ->
        synthesized_certified_positive_positional_candidate_interval start

inl rec synthesize_certified_positive_positional_candidate_interval forall start.
    (start_value : positive_positional_nat start)
    : synthesized_certified_positive_positional_candidate_interval start =
    match start_value with
    | PositivePositionalOne =>
        SynthesizedCertifiedPositivePositionalCandidateInterval (exists (
            CertifiedPositivePositionalCandidateIntervalOne
                "one-has-no-nontrivial-factor-candidate-interval",
            "the-certified-interval-terminates-at-unit"))
    | PositivePositionalZeroBit tail =>
        match tail with
        | PositivePositionalOne =>
            SynthesizedCertifiedPositivePositionalCandidateInterval (exists (
                CertifiedPositivePositionalCandidateIntervalTwo
                    "two-excludes-one-and-itself-from-the-nontrivial-candidate-interval",
                "the-certified-interval-for-two-is-empty"))
        | PositivePositionalZeroBit _ =>
            match synthesize_positive_positional_predecessor tail with
            | PositivePositionalPredecessorResultSome payload =>
                inl exists predecessor. predecessor_value, predecessor_proof = payload
                inl candidate_value = PositivePositionalOneBit predecessor_value
                match synthesize_certified_positive_positional_candidate_interval candidate_value with
                | SynthesizedCertifiedPositivePositionalCandidateInterval tail_payload =>
                    inl exists previous. certified_tail, _ = tail_payload
                    SynthesizedCertifiedPositivePositionalCandidateInterval (exists (
                        CertifiedPositivePositionalCandidateIntervalMore (exists (
                            candidate_value,
                            PositivePositionalFactorCandidateNonunitOneBit predecessor_value,
                            PositivePositionalPredecessorZeroBitHigher predecessor_proof,
                            certified_tail,
                            "the-even-start-contributes-its-exact-predecessor-before-recursing")),
                        "the-candidate-interval-preserves-a-predecessor-proof-at-every-cell"))
        | PositivePositionalOneBit _ =>
            match synthesize_positive_positional_predecessor tail with
            | PositivePositionalPredecessorResultSome payload =>
                inl exists predecessor. predecessor_value, predecessor_proof = payload
                inl candidate_value = PositivePositionalOneBit predecessor_value
                match synthesize_certified_positive_positional_candidate_interval candidate_value with
                | SynthesizedCertifiedPositivePositionalCandidateInterval tail_payload =>
                    inl exists previous. certified_tail, _ = tail_payload
                    SynthesizedCertifiedPositivePositionalCandidateInterval (exists (
                        CertifiedPositivePositionalCandidateIntervalMore (exists (
                            candidate_value,
                            PositivePositionalFactorCandidateNonunitOneBit predecessor_value,
                            PositivePositionalPredecessorZeroBitHigher predecessor_proof,
                            certified_tail,
                            "the-even-start-contributes-its-exact-predecessor-before-recursing")),
                        "the-candidate-interval-preserves-a-predecessor-proof-at-every-cell"))
    | PositivePositionalOneBit tail =>
        inl candidate_value = PositivePositionalZeroBit tail
        match synthesize_certified_positive_positional_candidate_interval candidate_value with
        | SynthesizedCertifiedPositivePositionalCandidateInterval tail_payload =>
            inl exists previous. certified_tail, _ = tail_payload
            SynthesizedCertifiedPositivePositionalCandidateInterval (exists (
                CertifiedPositivePositionalCandidateIntervalMore (exists (
                    candidate_value,
                    PositivePositionalFactorCandidateNonunitZeroBit tail,
                    PositivePositionalPredecessorOneBit tail,
                    certified_tail,
                    "the-odd-start-contributes-its-exact-even-predecessor-before-recursing")),
                "the-candidate-interval-preserves-a-predecessor-proof-at-every-cell"))

union rec certified_interval_positive_positional_factor_membership candidate start length =
    | CertifiedIntervalPositivePositionalFactorMembershipHere :: forall candidate start previous.
        positive_positional_nat candidate *
        positive_positional_factor_candidate_nonunit candidate *
        positive_positional_predecessor start candidate * string ->
        certified_interval_positive_positional_factor_membership
            candidate start (z_nat_succ previous)
    | CertifiedIntervalPositivePositionalFactorMembershipThere :: forall candidate start previous.
        (exists head.
            positive_positional_nat candidate *
            positive_positional_nat head *
            positive_positional_factor_candidate_nonunit head *
            positive_positional_predecessor start head *
            certified_interval_positive_positional_factor_membership
                candidate head previous * string) ->
        certified_interval_positive_positional_factor_membership
            candidate start (z_nat_succ previous)

inl alternate_two_in_three_membership () :
    certified_interval_positive_positional_factor_membership
        (positional_zero_bit positional_one)
        (positional_one_bit positional_one)
        (z_nat_succ z_nat_zero) =
    CertifiedIntervalPositivePositionalFactorMembershipHere (
        positive_positional_two_value (),
        PositivePositionalFactorCandidateNonunitZeroBit PositivePositionalOne,
        positional_three_predecessor_two (),
        "two-is-the-alternate-final-membership-cell")

inl alternate_two_in_four_membership () :
    certified_interval_positive_positional_factor_membership
        (positional_zero_bit positional_one)
        (positional_zero_bit (positional_zero_bit positional_one))
        (z_nat_succ (z_nat_succ z_nat_zero)) =
    CertifiedIntervalPositivePositionalFactorMembershipThere (exists (
        positive_positional_two_value (),
        positive_positional_three_value (),
        PositivePositionalFactorCandidateNonunitOneBit PositivePositionalOne,
        positional_four_predecessor_three (),
        alternate_two_in_three_membership (),
        "the-alternate-membership-passes-through-three"))

inl alternate_two_in_five_membership () :
    certified_interval_positive_positional_factor_membership
        (positional_zero_bit positional_one)
        (positional_one_bit (positional_zero_bit positional_one))
        (z_nat_succ (z_nat_succ (z_nat_succ z_nat_zero))) =
    CertifiedIntervalPositivePositionalFactorMembershipThere (exists (
        positive_positional_two_value (),
        positive_positional_four_value (),
        PositivePositionalFactorCandidateNonunitZeroBit (positive_positional_two_value ()),
        positional_five_predecessor_four (),
        alternate_two_in_four_membership (),
        "the-alternate-membership-passes-through-four"))

inl alternate_two_in_six_membership () :
    certified_interval_positive_positional_factor_membership
        (positional_zero_bit positional_one)
        (positional_zero_bit (positional_one_bit positional_one))
        (z_nat_succ (z_nat_succ (z_nat_succ (z_nat_succ z_nat_zero)))) =
    CertifiedIntervalPositivePositionalFactorMembershipThere (exists (
        positive_positional_two_value (),
        positive_positional_five_value (),
        PositivePositionalFactorCandidateNonunitOneBit (positive_positional_two_value ()),
        positional_six_predecessor_five (),
        alternate_two_in_five_membership (),
        "the-alternate-membership-passes-through-five"))

union rec certified_interval_positive_positional_all_rejected dividend start length =
    | CertifiedIntervalPositivePositionalAllRejectedOne :: forall dividend.
        string ->
        certified_interval_positive_positional_all_rejected
            dividend positional_one z_nat_zero
    | CertifiedIntervalPositivePositionalAllRejectedTwo :: forall dividend.
        string ->
        certified_interval_positive_positional_all_rejected
            dividend (positional_zero_bit positional_one) z_nat_zero
    | CertifiedIntervalPositivePositionalAllRejectedMore :: forall dividend start previous.
        (exists candidate.
            positive_positional_nat candidate *
            positive_positional_factor_candidate_nonunit candidate *
            positive_positional_predecessor start candidate *
            positive_positional_nonfactor_certificate dividend candidate *
            certified_interval_positive_positional_all_rejected
                dividend candidate previous * string) ->
        certified_interval_positive_positional_all_rejected
            dividend start (z_nat_succ previous)

union certified_interval_positive_positional_sealed_search natural start length =
    | CertifiedIntervalPositivePositionalSealedPrime :: forall natural start length.
        certified_interval_positive_positional_all_rejected natural start length * string ->
        certified_interval_positive_positional_sealed_search natural start length
    | CertifiedIntervalPositivePositionalSealedComposite :: forall natural start length.
        (exists divisor quotient.
            positive_positional_nat divisor *
            positive_positional_nat quotient *
            certified_interval_positive_positional_factor_membership
                divisor start length *
            value_synthesized_structural_division
                natural divisor quotient positional_zero * string) ->
        certified_interval_positive_positional_sealed_search natural start length

inl rec search_certified_interval_positive_positional_factor
    forall natural start length.
    (natural_value : positive_positional_nat natural)
    (interval : certified_positive_positional_candidate_interval start length)
    : certified_interval_positive_positional_sealed_search natural start length =
    match interval with
    | CertifiedPositivePositionalCandidateIntervalOne note =>
        CertifiedIntervalPositivePositionalSealedPrime (
            CertifiedIntervalPositivePositionalAllRejectedOne note,
            "the-complete-interval-terminates-at-one")
    | CertifiedPositivePositionalCandidateIntervalTwo note =>
        CertifiedIntervalPositivePositionalSealedPrime (
            CertifiedIntervalPositivePositionalAllRejectedTwo note,
            "the-complete-interval-terminates-at-two")
    | CertifiedPositivePositionalCandidateIntervalMore payload =>
        inl exists candidate.
            candidate_value, candidate_nonunit, predecessor, tail, note = payload
        match decide_positive_positional_exact_factor
                natural_value candidate_value with
        | PositivePositionalExactFactorFound factor_payload =>
            inl exists quotient. quotient_value, division, factor_note = factor_payload
            CertifiedIntervalPositivePositionalSealedComposite (exists (
                candidate_value,
                quotient_value,
                CertifiedIntervalPositivePositionalFactorMembershipHere (
                    candidate_value,
                    candidate_nonunit,
                    predecessor,
                    "the-found-factor-is-the-current-certified-interval-cell"),
                division,
                factor_note))
        | PositivePositionalExactFactorRejected rejection_payload =>
            inl exists rejected_quotient rejected_remainder.
                _, _, _, rejection_note = rejection_payload
            match search_certified_interval_positive_positional_factor
                    natural_value tail with
            | CertifiedIntervalPositivePositionalSealedPrime (rejected_tail, prime_note) =>
                CertifiedIntervalPositivePositionalSealedPrime (
                    CertifiedIntervalPositivePositionalAllRejectedMore (exists (
                        candidate_value,
                        candidate_nonunit,
                        predecessor,
                        PositivePositionalNonfactorCertificate rejection_payload,
                        rejected_tail,
                        note)),
                    prime_note)
            | CertifiedIntervalPositivePositionalSealedComposite composite_payload =>
                inl exists found_divisor found_quotient.
                    divisor_value, quotient_value, membership, division, composite_note =
                        composite_payload
                CertifiedIntervalPositivePositionalSealedComposite (exists (
                    divisor_value,
                    quotient_value,
                    CertifiedIntervalPositivePositionalFactorMembershipThere (exists (
                        divisor_value,
                        candidate_value,
                        candidate_nonunit,
                        predecessor,
                        membership,
                        "the-factor-occurs-in-the-certified-tail-after-this-rejected-cell")),
                    division,
                    composite_note))

union certified_interval_positive_positional_sealed_factor_class natural =
    | CertifiedIntervalPositivePositionalSealedUnit ::
        certified_interval_positive_positional_sealed_factor_class positional_one
    | CertifiedIntervalPositivePositionalSealedPrimeClass :: forall natural.
        (exists length.
            positive_positional_nat natural *
            positive_positional_factor_candidate_nonunit natural *
            certified_interval_positive_positional_all_rejected
                natural natural length * string) ->
        certified_interval_positive_positional_sealed_factor_class natural
    | CertifiedIntervalPositivePositionalSealedCompositeClass :: forall natural.
        (exists length divisor quotient.
            positive_positional_nat natural *
            positive_positional_nat divisor *
            positive_positional_nat quotient *
            certified_interval_positive_positional_factor_membership
                divisor natural length *
            value_synthesized_structural_division
                natural divisor quotient positional_zero * string) ->
        certified_interval_positive_positional_sealed_factor_class natural

union certified_interval_positive_positional_sealed_composite_witness natural =
    | CertifiedIntervalPositivePositionalSealedCompositeWitness :: forall natural.
        (exists length divisor quotient.
            positive_positional_nat natural *
            positive_positional_nat divisor *
            positive_positional_nat quotient *
            certified_interval_positive_positional_factor_membership
                divisor natural length *
            value_synthesized_structural_division
                natural divisor quotient positional_zero * string) ->
        certified_interval_positive_positional_sealed_composite_witness natural

union certified_interval_positive_positional_sealed_composite_children natural divisor quotient =
    | CertifiedIntervalPositivePositionalSealedCompositeChildren :: forall natural divisor quotient.
        (exists length.
            positive_positional_nat natural *
            positive_positional_nat divisor *
            positive_positional_nat quotient *
            certified_interval_positive_positional_factor_membership
                divisor natural length *
            value_synthesized_structural_division
                natural divisor quotient positional_zero * string) ->
        certified_interval_positive_positional_sealed_composite_children natural divisor quotient

inl certified_interval_positive_positional_sealed_composite_children_from_witness forall natural.
    (witness : certified_interval_positive_positional_sealed_composite_witness natural)
    : (exists divisor quotient.
        certified_interval_positive_positional_sealed_composite_children natural divisor quotient) =
    match witness with
    | CertifiedIntervalPositivePositionalSealedCompositeWitness payload =>
