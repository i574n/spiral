            right_less,
            right_rest))
    | CertifiedIntervalPositivePositionalPrimeMultiplicityNormalFormMore left_payload,
      CertifiedIntervalPositivePositionalPrimeMultiplicityNormalFormLast right_run =>
        inl exists left_next. left_run, left_less, left_rest = left_payload
        CertifiedIntervalPositivePositionalGroupIndexedProfilePairCaseLeftMoreRightLast (exists (
