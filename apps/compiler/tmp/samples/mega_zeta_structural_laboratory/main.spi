inl rec positive_positional_equal_transitive forall left middle right.
    (left_middle : positive_positional_equal left middle)
    (middle_right : positive_positional_equal middle right)
    : positive_positional_equal left right =
    match left_middle, middle_right with
    | PositivePositionalEqualOne, PositivePositionalEqualOne =>
        PositivePositionalEqualOne
    | PositivePositionalEqualZeroBit left_tail, PositivePositionalEqualZeroBit right_tail =>
        PositivePositionalEqualZeroBit (
            positive_positional_equal_transitive left_tail right_tail)
    | PositivePositionalEqualOneBit left_tail, PositivePositionalEqualOneBit right_tail =>
        PositivePositionalEqualOneBit (
            positive_positional_equal_transitive left_tail right_tail)

inl rec positive_positional_less_rewrite_left forall left middle right.
    (left_middle : positive_positional_equal left middle)
    (middle_right : positive_positional_less middle right)
    : positive_positional_less left right =
    match left_middle with
    | PositivePositionalEqualOne => middle_right
    | PositivePositionalEqualZeroBit equal_tail =>
        match middle_right with
        | PositivePositionalLessHigherZeroZero less_tail =>
            PositivePositionalLessHigherZeroZero (
                positive_positional_less_rewrite_left equal_tail less_tail)
        | PositivePositionalLessHigherZeroOne less_tail =>
            PositivePositionalLessHigherZeroOne (
                positive_positional_less_rewrite_left equal_tail less_tail)
        | PositivePositionalLessSameTailZeroOne equal_tail_right =>
            PositivePositionalLessSameTailZeroOne (
                positive_positional_equal_transitive equal_tail equal_tail_right)
    | PositivePositionalEqualOneBit equal_tail =>
        match middle_right with
        | PositivePositionalLessHigherOneZero less_tail =>
            PositivePositionalLessHigherOneZero (
                positive_positional_less_rewrite_left equal_tail less_tail)
        | PositivePositionalLessHigherOneOne less_tail =>
            PositivePositionalLessHigherOneOne (
                positive_positional_less_rewrite_left equal_tail less_tail)

