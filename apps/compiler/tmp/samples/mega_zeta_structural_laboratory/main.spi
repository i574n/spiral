:= ^ search_certified_interval_positive_positional_factor
    \* natural start length.
    (natural_value : positive_positional_nat natural)
    (interval : certified_positive_positional_candidate_interval start length)
    : certified_interval_positive_positional_sealed_search natural start length =
    ?= interval ?|
    | CertifiedPositivePositionalCandidateIntervalOne note =>
        CertifiedIntervalPositivePositionalSealedPrime (
            CertifiedIntervalPositivePositionalAllRejectedOne note,
            "the-complete-interval-terminates-at-one")
    | CertifiedPositivePositionalCandidateIntervalTwo note =>
        CertifiedIntervalPositivePositionalSealedPrime (
            CertifiedIntervalPositivePositionalAllRejectedTwo note,
            "the-complete-interval-terminates-at-two")
    | CertifiedPositivePositionalCandidateIntervalMore payload =>
        := \? candidate.
            candidate_value, candidate_nonunit, predecessor, tail, note = payload
        ?= decide_positive_positional_exact_factor
