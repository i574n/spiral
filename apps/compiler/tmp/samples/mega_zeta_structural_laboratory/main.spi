            | CertifiedIntervalPositivePositionalSealedPrime (rejected_tail, prime_note) =>
                CertifiedIntervalPositivePositionalSealedPrime (
                    CertifiedIntervalPositivePositionalAllRejectedMore (\? (
                        candidate_value,
                        candidate_nonunit,
                        predecessor,
                        PositivePositionalNonfactorCertificate rejection_payload,
                        rejected_tail,
                        note)),
                    prime_note)
            | CertifiedIntervalPositivePositionalSealedComposite composite_payload =>
                := \? found_divisor found_quotient.
                    divisor_value, quotient_value, membership, division, composite_note =
                        composite_payload
                CertifiedIntervalPositivePositionalSealedComposite (\? (
                    divisor_value,
                    quotient_value,
                    CertifiedIntervalPositivePositionalFactorMembershipThere (\? (
                        divisor_value,
                        candidate_value,
                        candidate_nonunit,
                        predecessor,
                        membership,
                        "the-factor-occurs-in-the-certified-tail-after-this-rejected-cell")),
                    division,
                    composite_note))

