// A predecessor step for three cannot carry the two-to-one predecessor proof (the step payload no longer has value/less slots; the forged proof is the remaining misuse).
open main

inl impossible_accessible_child_step_prime_predecessor_mismatch () =
    inl three_value = positive_positional_three_value ()
    certified_interval_positive_positional_accessible_child_completion
        three_value
        (PositivePositionalPredecessorAccessibilityStep (exists (
            PositivePositionalPredecessorTwo,
            PositivePositionalPredecessorAccessibilityOne
                "forged-one-tail-accessibility",
            "forged-two-to-one-step-for-general-prime-three")))

inl main () =
    impossible_accessible_child_step_prime_predecessor_mismatch ()
