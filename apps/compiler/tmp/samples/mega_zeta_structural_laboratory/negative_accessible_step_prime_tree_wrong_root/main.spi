:< main

:= impossible_accessible_step_prime_tree_wrong_root () :
    certified_interval_positive_positional_complete_factorization_tree
        (positional_zero_bit (positional_zero_bit positional_one)) =
    := three_value = positive_positional_three_value ()
    ?=
        classify_certified_interval_positive_positional_sealed_factor three_value,
        derive_positive_positional_predecessor_accessibility three_value
    ?|
    | CertifiedIntervalPositivePositionalSealedPrimeClass prime_payload,
        PositivePositionalPredecessorAccessibilityStep step_payload
        =>
            := \? length. prime_material, prime_nonunit, rejected, prime_note = prime_payload
            := \? predecessor. predecessor_proof, predecessor_accessibility, step_note = step_payload
            certified_interval_positive_positional_accessible_step_prime_complete_tree
                (CertifiedIntervalPositivePositionalAccessibleStepPrimeDerivation (\? (
                    prime_material,
                    prime_nonunit,
                    rejected,
                    predecessor_proof,
                    positive_positional_predecessor_implies_less predecessor_proof,
                    predecessor_accessibility,
                    prime_note,
                    step_note)))
    | _, _ =>
        $"mega_runtime_fail \"three-was-unexpectedly-not-a-Step-certified-prime\""

:= main () =
    impossible_accessible_step_prime_tree_wrong_root ()
