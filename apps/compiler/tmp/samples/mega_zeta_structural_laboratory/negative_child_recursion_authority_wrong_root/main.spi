// A child recursion authority rooted at three cannot be typed as rooted at four (the descent is now derived directly; the RecursiveDescentProven decision wrapper is retired).
open main

inl impossible_child_recursion_authority_wrong_root () :
    certified_interval_positive_positional_child_recursion_authority
        (positional_zero_bit positional_one)
        (positional_zero_bit (positional_zero_bit positional_one))
        (z_nat_succ z_nat_zero) =
    inl membership :
        certified_interval_positive_positional_factor_membership
            (positional_zero_bit positional_one)
            (positional_one_bit positional_one)
            (z_nat_succ z_nat_zero) =
        CertifiedIntervalPositivePositionalFactorMembershipHere (
            positive_positional_two_value (),
            PositivePositionalFactorCandidateNonunitZeroBit PositivePositionalOne,
            PositivePositionalPredecessorOneBit PositivePositionalOne,
            "the-child-authority-membership-is-rooted-at-three-not-four")
    inl descent = derive_certified_interval_positive_positional_membership_recursive_descent (positive_positional_three_value ()) membership
    derive_certified_interval_positive_positional_child_recursion_authority
        membership
        descent
        (derive_positive_positional_predecessor_accessibility
            (positive_positional_three_value ()))

inl main () =
    impossible_child_recursion_authority_wrong_root ()
