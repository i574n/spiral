inl impossible_composite_recursion_authority_wrong_root () :
    (exists length divisor quotient.
        certified_interval_positive_positional_composite_recursion_authority
            (positional_zero_bit (positional_zero_bit positional_one))
            length divisor quotient) =
    match classify_certified_interval_positive_positional_sealed_factor
            (positive_positional_twelve_value ()) with
    | CertifiedIntervalPositivePositionalSealedCompositeClass payload =>
        inl exists length divisor quotient.
            root_value, _, quotient_value, membership, division, _ = payload
        match
            derive_certified_interval_positive_positional_membership_recursive_descent
                root_value membership,
            derive_certified_interval_positive_positional_recursive_descent
                root_value quotient_value
        with
        | CertifiedIntervalPositivePositionalRecursiveDescentProven divisor_descent,
          CertifiedIntervalPositivePositionalRecursiveDescentProven quotient_descent =>
            exists (
                length,
                divisor,
                quotient,
                CertifiedIntervalPositivePositionalCompositeRecursionAuthority (
                    membership,
                    division,
                    quotient_value,
                    divisor_descent,
                    quotient_descent,
                    "the-composite-authority-is-rooted-at-twelve-not-four"))

inl main () =
    impossible_composite_recursion_authority_wrong_root ()
