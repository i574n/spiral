open main

// tests: the singleton prime power of a Mixed obstruction is rooted at the obstruction's root, not at one (replaces the retired mixed_second_prime_* / *_root_authority_make types by the current mixed_linked_prime_power_divisibility)
inl impossible_mixed_singleton_prime_power_wrong_root forall root. (mixed : certified_arithmetic_rooted_ordered_prime_power_nf_uniqueness_mixed_obstruction root) : exists factor count. certified_arithmetic_prime_power factor count positional_one * string =
    match certified_arithmetic_rooted_ordered_prime_power_nf_uniqueness_mixed_linked_prime_power_divisibility_make mixed with
    | certified_arithmetic_rooted_ordered_prime_power_nf_uniqueness_mixed_linked_prime_power_divisibility packed =>
        inl exists singleton_factor singleton_count second_factor second_count second_product. singleton_power, _, _, _, _, _, note = packed
        exists (singleton_power, note)

inl main () = ()