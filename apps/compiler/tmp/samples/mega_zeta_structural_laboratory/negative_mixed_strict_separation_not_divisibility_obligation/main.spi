open main

// tests: the strict second-prime separation is not the root divisibility decision, even though the linked Mixed authority carries both (replaces the retired mixed_second_prime_* / *_root_authority_make types by the current mixed_linked_prime_power_divisibility)
inl impossible_mixed_strict_separation_not_divisibility_obligation forall root. (authority : certified_arithmetic_rooted_ordered_prime_power_nf_uniqueness_mixed_linked_prime_power_divisibility root) : () =
    match authority with
    | certified_arithmetic_rooted_ordered_prime_power_nf_uniqueness_mixed_linked_prime_power_divisibility packed =>
        inl exists singleton_factor singleton_count second_factor second_count second_product. _, _, strict, _, _, divisibility, _ = packed
        inl obligation : positive_positional_exact_factor_decision root second_factor = strict
        ()

inl main () = ()