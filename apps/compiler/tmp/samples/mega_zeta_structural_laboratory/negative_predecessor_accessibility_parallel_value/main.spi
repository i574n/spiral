:< main

:= impossible_predecessor_accessibility_parallel_value () :
    positive_positional_predecessor_accessibility
        (positional_zero_bit positional_one) =
    PositivePositionalPredecessorAccessibilityStep (\? (
        PositivePositionalOne,
        PositivePositionalPredecessorTwo,
        PositivePositionalLessOneZeroBit PositivePositionalOne,
        PositivePositionalPredecessorAccessibilityOne
            "one-closes-the-forged-chain",
