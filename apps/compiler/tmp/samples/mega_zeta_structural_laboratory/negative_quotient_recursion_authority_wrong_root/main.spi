inl impossible_quotient_recursion_authority_wrong_root () :
    (exists divisor quotient.
        certified_interval_positive_positional_quotient_recursion_authority
            (positional_zero_bit (positional_zero_bit positional_one))
            divisor quotient) =
    match classify_certified_interval_positive_positional_sealed_factor
            (positive_positional_twelve_value ()) with
    | CertifiedIntervalPositivePositionalSealedCompositeClass payload =>
        inl exists length divisor quotient.
            root_value, _, quotient_value, _, division, _ = payload
        match derive_certified_interval_positive_positional_recursive_descent
                root_value quotient_value with
        | CertifiedIntervalPositivePositionalRecursiveDescentProven quotient_descent =>
            exists (
                divisor,
                quotient,
                CertifiedIntervalPositivePositionalQuotientRecursionAuthority (
                    division,
                    quotient_value,
                    quotient_descent,
                    derive_positive_positional_predecessor_accessibility root_value,
                    derive_positive_positional_predecessor_accessibility quotient_value,
                    "the-authority-is-rooted-at-twelve-not-four"))

inl main () =
    impossible_quotient_recursion_authority_wrong_root ()
