:= make (n : i32) : i32 -> i32 -> i32 =
    := g (y : i32) : i32 -> i32 =
        := h (x : i32) : i32 =
            ? n =. 0i32 ?> 0i32 |: x +. n
        h
    g

:= main () : i32 =
    := ~n = 7i32
    := mid = ~~ make n
    := ~c = mid
    := inner = c 0i32
    := ~e = inner
    ? e 0i32 =. 7i32 ?> 0i32 |: 1i32
