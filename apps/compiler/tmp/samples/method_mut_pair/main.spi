:= pick (n : i32) (word : string) : mut { value : i32 * string } =
    := pair = n, word
    !!!!LayoutToHeapMutable({ value = pair })

:= main () : i32 =
    := ~n = 3i32
    := ~word = "no"
    := box : mut { value : i32 * string } = ~~ pick n word
    := ~m = 7i32
    := ~next = "hi"
    := replaced = m, next
    box <- { value = replaced }
    := opened = !!!!LayoutIndex(box)
    := ~(left, right) = opened::value
    ? left =. 7i32 && !!!!EQ(right, "hi") ?> 0i32 |: 1i32
