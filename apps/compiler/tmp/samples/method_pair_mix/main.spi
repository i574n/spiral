inl pick (n : i32) (word : string) : i32 * string =
    if n =. 0i32 then
        0i32, "no"
    else
        n, word

inl main () : i32 =
    inl ~n = 7i32
    inl ~word = "hi"
    inl pair = join pick n word
    inl ~(left, right) = pair
    if left =. 7i32 && !!!!EQ(right, "hi") then 0i32 else 1i32
