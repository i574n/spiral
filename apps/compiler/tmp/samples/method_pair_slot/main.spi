:| slot =
    | None
    | Some : i32

:= pick (n : i32) : slot * i32 =
    ? n =. 0i32 ?>
        None, 0i32
    |:
        Some n, n

:= main () : i32 =
    := ~n = 7i32
    := pair = ~~ pick n
    := ~(left, right) = pair
    ?= left ?|
    | Some value => ? value =. 7i32 && right =. 7i32 ?> 0i32 |: 1i32
    | None => 1i32
