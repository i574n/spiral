:| slot =
    | None
    | Some : i32

:= pick (n : i32) (cell : heap { value : i32 }) : slot * heap { value : i32 } =
    Some n, cell

:= main () : i32 =
    := ~n = 3i32
    := ~m = 4i32
    := cell = !!!!LayoutToHeap({ value = m })
    := pair = ~~ pick n cell
    := ~(left, right) = pair
    ?= left ?|
    | Some value =>
        := obj = !!!!LayoutIndex(right)
        ? value +. obj::value =. 7i32 ?> 0i32 |: 1i32
    | None => 1i32
