inl pick (left : string) (right : string) : string * string =
    if !!!!EQ(left, "") then
        "no", "nay"
    else
        left, right

inl main () : i32 =
    inl ~a = "hi"
    inl ~b = "yo"
    inl pair = join pick a b
    inl ~(left, right) = pair
    if !!!!EQ(left, "hi") && !!!!EQ(right, "yo") then 0i32 else 1i32
