inl main () : i32 =
    inl ~n = 1i32
    inl ~word = "no"
    inl left_pair = n, word
    inl left_heap = !!!!LayoutToHeap({ value = left_pair })
    inl ~m = 2i32
    inl ~other = "zz"
    inl right_pair = m, other
    inl right_heap = !!!!LayoutToHeap({ value = right_pair })
    inl slot : mut { value : heap { value : i32 * string } * heap { value : i32 * string } } =
        !!!!LayoutToHeapMutable({ value = left_heap, right_heap })
    inl ~a0 = 7i32
    inl ~b0 = "hi"
    inl next_left_pair = a0, b0
    inl next_left = !!!!LayoutToHeap({ value = next_left_pair })
    inl ~c0 = 4i32
    inl ~d0 = "yo"
    inl next_right_pair = c0, d0
    inl next_right = !!!!LayoutToHeap({ value = next_right_pair })
    inl replaced = next_left, next_right
    slot <- { value = replaced }
    inl opened = !!!!LayoutIndex(slot)
    inl ~(left, right) = opened.value
    inl left_opened = !!!!LayoutIndex(left)
    inl ~(a, b) = left_opened.value
    inl right_opened = !!!!LayoutIndex(right)
    inl ~(c, d) = right_opened.value
    if a =. 7i32 && !!!!EQ(b, "hi") && c =. 4i32 && !!!!EQ(d, "yo") then 0i32 else 1i32
