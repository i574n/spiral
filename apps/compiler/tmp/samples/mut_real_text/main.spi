:= main () : i32 =
    := ~x = 1.5f64
    := ~word = "no"
    := pair = x, word
    := box : mut { value : f64 * string } = !!!!LayoutToHeapMutable({ value = pair })
    := ~y = 2.5f64
    := ~next = "hi"
    := replaced = y, next
    box <- { value = replaced }
    := opened = !!!!LayoutIndex(box)
    := ~(left, right) = opened::value
    ? !!!!EQ(left, 2.5f64) && !!!!EQ(right, "hi") ?> 0i32 |: 1i32
