inl main () : i32 =
    inl ~x = 1.5f64
    inl ~word = "no"
    inl pair = x, word
    inl box : mut {value : f64 * string} = !!!!LayoutToHeapMutable({value = pair})
    inl ~y = 2.5f64
    inl ~next = "hi"
    inl replaced = y, next
    box <- {value = replaced}
    inl opened = !!!!LayoutIndex(box)
    inl ~(left, right) = opened.value
    if !!!!EQ(left, 2.5f64) && !!!!EQ(right, "hi") then 0i32 else 1i32
