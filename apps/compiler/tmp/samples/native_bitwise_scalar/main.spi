:= main () : i32 =
    := ~a = 43i32
    := ~b = 15i32
    := ~shift = 2i32
    := ~left_shift = 5i32
    := and_value = !!!!BitwiseAnd(a, b)
    := or_value = !!!!BitwiseOr(a, b)
    := xor_value = !!!!BitwiseXor(a, b)
    := complement_value = !!!!BitwiseComplement(a)
    := complement_byte = !!!!BitwiseAnd(complement_value, 255i32)
    := left_value = !!!!ShiftLeft(1i32, left_shift)
    := right_value = !!!!ShiftRight(168i32, shift)
    right_value
    +. (and_value -. 11i32)
    +. (or_value -. 47i32)
    +. (xor_value -. 36i32)
    +. (complement_byte -. 212i32)
    +. (left_value -. 32i32)
