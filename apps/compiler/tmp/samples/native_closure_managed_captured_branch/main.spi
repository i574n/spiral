:= main () : i32 =
    := ~left_name = "abc"
    := ~right_name = "wxyz"
    := left = (\ z => sm::length left_name +. z) : i32 -> i32
    := right = (\ z => sm::length right_name +. z -. 1i32) : i32 -> i32
    := ~flag = !+
    := ~selected_closure_42_either_way = ? flag ?> left |: right
    ~~ selected_closure_42_either_way 39i32
