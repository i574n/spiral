:= main () : i32 =
    := ~left_name = "abc"
    := ~right_name = "wxyz"
    := ~left_bias = 2i32
    := ~right_bias = 2i32
    := left = (\ z => ? z > 0i32 ?> sm::length left_name +. left_bias +. z |: 0i32) : i32 -> i32
    := right = (\ z => ? z > 0i32 ?> sm::length right_name +. right_bias +. z -. 1i32 |: -1i32) : i32 -> i32
    := ~flag = !+
    := ~selected = ? flag ?> left |: right
    ~~ selected 37i32
