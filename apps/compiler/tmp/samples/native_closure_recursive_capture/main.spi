:| ^ int_tree =
    | Leaf
    | Node : i32 * int_tree * int_tree

:~ ^ sum tree : i32 =
    ?= tree ?|
    | Leaf => 0i32
    | Node (value, left, right) => value +. (sum left +. sum right)

:= main () : i32 =
    := ~leaf = Leaf
    := ~branch = Node (2i32, leaf, leaf)
    := f (z : i32) : i32 = sum branch +. z
    := ~g = f
    g 19i32 +. g 19i32
