nominal rotation =
    {
        a : f64
        b : f64
        c : f64
    }

nominal cube =
    {
        cube_width : f64
        horizontal_offset : f64
        marker : i32
    }

union projected =
    | Hidden
    | Visible : f64 * f64 * f64

inl get_width () = 160i32
inl get_height () = 44i32
inl get_distance_from_cam () = 100f64
inl get_k1 () = 40f64

inl while' (cond : () -> bool) (body : () -> ()) : () =
    !!!!While((join cond()),(body()))

inl set' forall t. (a : t) ~(b : t) : () =
    !!!!BackendSwitch({ Fsharp = fun () => $"!a <- !b" : (); C = fun () => $"!a = !b" : (); Rust = fun () => $"!a = !b" : (); Delphi = fun () => $"!a := !b" : () })

inl sin64 (x : f64) : f64 = !!!!Sin(x)
inl cos64 (x : f64) : f64 = !!!!Cos(x)
inl to_i32 (x : f64) : i32 = !!!!Conv(`i32, x)

inl calculate_x (i : f64) (j : f64) (k : f64) (rotation rot) : f64 =
    inl a, b, c = rot.a, rot.b, rot.c
    j *. sin64 a *. sin64 b *. cos64 c -. k *. cos64 a *. sin64 b *. cos64 c +.
    j *. cos64 a *. sin64 c +. k *. sin64 a *. sin64 c +. i *. cos64 b *. cos64 c

inl calculate_y (i : f64) (j : f64) (k : f64) (rotation rot) : f64 =
    inl a, b, c = rot.a, rot.b, rot.c
    j *. cos64 a *. cos64 c +. k *. sin64 a *. cos64 c -.
    j *. sin64 a *. sin64 b *. sin64 c +. k *. cos64 a *. sin64 b *. sin64 c -.
    i *. cos64 b *. sin64 c

inl calculate_z (i : f64) (j : f64) (k : f64) (rotation rot) : f64 =
    inl a, b = rot.a, rot.b
    k *. cos64 a *. cos64 b -. j *. sin64 a *. cos64 b +. i *. sin64 b

inl calculate_for_surface cube_x cube_y cube_z rot horizontal_offset =
    inl x = calculate_x cube_x cube_y cube_z rot
    inl y = calculate_y cube_x cube_y cube_z rot
    inl z = calculate_z cube_x cube_y cube_z rot +. get_distance_from_cam ()
    inl ooz = 1f64 /. z
    inl xp = 80f64 +. horizontal_offset +. get_k1 () *. ooz *. x *. 2f64
    inl yp = 22f64 +. get_k1 () *. ooz *. y
    if xp >= 0f64 && xp < 160f64 && yp >= 0f64 && yp < 44f64
    then Visible (xp, yp, ooz)
    else Hidden

inl make_frame (size : i32) : array i32 =
    inl ~frame : array i32 = create size
    inl ~i = 0i32
    while' (fun () => i < size) fun () =>
        set frame i 46i32
        set' i (i +. 1i32)
    frame

inl draw_cube (frame : array i32) rot (cube value) : i32 =
    inl cw = value.cube_width
    match calculate_for_surface cw cw (0f64 -. cw) rot value.horizontal_offset with
    | Visible (xp, yp, depth) when xp >= 0f64 && yp >= 0f64 && depth > 0f64 =>
        inl ix = to_i32 xp
        inl iy = to_i32 yp
        inl idx = ix +. iy *. get_width ()
        set frame idx value.marker
        idx
    | _ => 0i32

inl frame_cell_text (value : i32) : string =
    if value =. 35i32 then "#"
    elif value =. 43i32 then "+"
    elif value =. 64i32 then "@"
    else "."

let rec frame_text_loop (frame : array i32) (width : i32) (size : i32) (i : i32) (text : string) : string =
    if i =. size then text
    else
        inl text = sm.concat text (frame_cell_text (index frame i))
        inl next = i +. 1i32
        if i %. width =. width -. 1i32 && next < size
        then frame_text_loop frame width size next (sm.concat text "\n")
        else frame_text_loop frame width size next text

inl frame_text (frame : array i32) : string =
    inl width = get_width ()
    frame_text_loop frame width (width *. get_height ()) 0i32 ""

inl main () : i32 =
    inl rot = rotation { a = 0f64; b = 0f64; c = 0f64 }
    inl frame_size = get_width () *. get_height ()
    inl ~frame = join make_frame frame_size
    inl draw = (fun value => draw_cube frame rot value) : cube -> i32
    inl i0 = join draw (cube { cube_width = 20f64; horizontal_offset = 0f64 -. 40f64; marker = 35i32 })
    inl i1 = join draw (cube { cube_width = 10f64; horizontal_offset = 10f64; marker = 64i32 })
    inl i2 = join draw (cube { cube_width = 5f64; horizontal_offset = 40f64; marker = 43i32 })
    inl p0 = index frame 0i32
    inl p1 = index frame 5180i32
    inl p2 = index frame 4258i32
    inl p3 = index frame 3964i32
    inl text = frame_text frame
    inl text_length = sm.length text : i32
    inl checksum = sm.utf8_fold (fun state scalar => state +. scalar) 0i32 text
    inl t0 = sm.utf8_scalar_at_byte_offset text 0i32
    inl t1 = sm.utf8_scalar_at_byte_offset text 160i32
    inl t2 = sm.utf8_scalar_at_byte_offset text 3988i32
    inl t3 = sm.utf8_scalar_at_byte_offset text 4284i32
    inl t4 = sm.utf8_scalar_at_byte_offset text 5212i32
    inl t5 = sm.utf8_scalar_at_byte_offset text 7082i32
    if i0 =. 5180i32 && i1 =. 4258i32 && i2 =. 3964i32 && p0 =. 46i32 && p1 =. 35i32 && p2 =. 64i32 && p3 =. 43i32 && text_length =. 7083i32 && checksum =. 324274i32 && t0 =. 46i32 && t1 =. 10i32 && t2 =. 43i32 && t3 =. 64i32 && t4 =. 35i32 && t5 =. 46i32
    then 42i32
    else 1i32
