:! rotation =
    {
        a : f64
        b : f64
        c : f64
    }

:! cube =
    {
        cube_width : f64
        horizontal_offset : f64
        marker : i32
    }

:| projected =
    | Hidden
    | Visible : f64 * f64 * f64

:= get_width () = 160i32
:= get_height () = 44i32
:= get_distance_from_cam () = 100f64
:= get_k1 () = 40f64

:= while' (cond : () -> bool) (body : () -> ()) : () =
    !!!!While((~~ cond ()), (body ()))

:= set' \* t. (a : t) ~(b : t) : () =
    !!!!BackendSwitch({
        Fsharp = \ () => $"!a <- !b" : ()
        C = \ () => $"!a = !b" : ()
        Zig = \ () => $"!a = !b" : ()
        Lean = \ () => $"!a := !b" : ()
        Rust = \ () => $"!a = !b" : ()
        Delphi = \ () => $"!a := !b" : ()
    })

:= sin64 (x : f64) : f64 = !!!!Sin(x)
:= cos64 (x : f64) : f64 = !!!!Cos(x)
:= to_i32 (x : f64) : i32 = !!!!Conv(`i32, x)

:= calculate_x (i : f64) (j : f64) (k : f64) (rotation rot) : f64 =
    := a, b, c = rot::a, rot::b, rot::c
    j *. sin64 a *. sin64 b *. cos64 c -. k *. cos64 a *. sin64 b *. cos64 c +.
    j *. cos64 a *. sin64 c +. k *. sin64 a *. sin64 c +. i *. cos64 b *. cos64 c

:= calculate_y (i : f64) (j : f64) (k : f64) (rotation rot) : f64 =
    := a, b, c = rot::a, rot::b, rot::c
    j *. cos64 a *. cos64 c +. k *. sin64 a *. cos64 c -.
    j *. sin64 a *. sin64 b *. sin64 c +. k *. cos64 a *. sin64 b *. sin64 c -.
    i *. cos64 b *. sin64 c

:= calculate_z (i : f64) (j : f64) (k : f64) (rotation rot) : f64 =
    := a, b = rot::a, rot::b
    k *. cos64 a *. cos64 b -. j *. sin64 a *. cos64 b +. i *. sin64 b

:= calculate_for_surface cube_x cube_y cube_z rot horizontal_offset =
    := x = calculate_x cube_x cube_y cube_z rot
    := y = calculate_y cube_x cube_y cube_z rot
    := z = calculate_z cube_x cube_y cube_z rot +. get_distance_from_cam ()
    := ooz = 1f64 /. z
    := xp = 80f64 +. horizontal_offset +. get_k1 () *. ooz *. x *. 2f64
    := yp = 22f64 +. get_k1 () *. ooz *. y
    ? xp >= 0f64 && xp < 160f64 && yp >= 0f64 && yp < 44f64
    ?> Visible (xp, yp, ooz)
    |: Hidden

:= clear_frame (frame : array i32) (size : i32) : () =
    := ~i = 0i32
    while' (\ () => i < size) \ () =>
        set frame i 46i32
        set' i (i +. 1i32)

:= draw_cube (frame : array i32) rot (cube value) : i32 =
    := cw = value::cube_width
    ?= calculate_for_surface cw cw (0f64 -. cw) rot value::horizontal_offset ?|
    | Visible (xp, yp, depth) ?& xp >= 0f64 && yp >= 0f64 && depth > 0f64 =>
        := ix = to_i32 xp
        := iy = to_i32 yp
        := idx = ix +. iy *. get_width ()
        set frame idx value::marker
        idx
    | _ => 0i32

:= frame_cell_text (value : i32) : string =
    ? value =. 35i32 ?> "#"
    |? value =. 43i32 ?> "+"
    |? value =. 64i32 ?> "@"
    |: "."

:~ ^ frame_text_loop (frame : array i32) (width : i32) (size : i32) (i : i32) (text : string) : string =
    ? i =. size ?> text
    |:
        := text = sm::concat text (frame_cell_text (index frame i))
        := next = i +. 1i32
        ? i %. width =. width -. 1i32 && next < size
        ?> frame_text_loop frame width size next (sm::concat text "\n")
        |: frame_text_loop frame width size next text

:= frame_text (frame : array i32) : string =
    := width = get_width ()
    frame_text_loop frame width (width *. get_height ()) 0i32 ""

:= terminal_prefix () : string = "[H"
:= terminal_write (text : string) : () = !!!!Printf("%s", text)

:= render_frame_checksum (frame : array i32) rot : i32 =
    := frame_size = get_width () *. get_height ()
    clear_frame frame frame_size
    := draw = (\ value => draw_cube frame rot value) : cube -> i32
    := i0 = ~~ draw (cube { cube_width = 20f64; horizontal_offset = 0f64 -. 40f64; marker = 35i32 })
    := i1 = ~~ draw (cube { cube_width = 10f64; horizontal_offset = 10f64; marker = 64i32 })
    := i2 = ~~ draw (cube { cube_width = 5f64; horizontal_offset = 40f64; marker = 43i32 })
    := text = frame_text frame
    := text_length = sm::length text : i32
    := text_checksum = sm::utf8_fold (\ state scalar => state +. scalar) 0i32 text
    := output = sm::concat (terminal_prefix ()) text
    terminal_write output
    := spatial_checksum = i0 +. i1 *. 3i32 +. i2 *. 7i32
    ? text_length =. 7083i32 && text_checksum =. 324274i32
    ?> spatial_checksum
    |: 0i32

:= rotation_for_step step =
    ? step =. 0i32 ?> rotation { a = 0f64; b = 0f64; c = 0f64 }
    |? step =. 1i32 ?> rotation { a = 0.1f64; b = 0.05f64; c = 0.02f64 }
    |: rotation { a = 0.2f64; b = 0.1f64; c = 0.04f64 }

:= main () : i32 =
    := frame_size = get_width () *. get_height ()
    := ~frame : array i32 = create frame_size
    := ~checksums : array i32 = create 3i32
    := ~step = 0i32
    while' (\ () => step < 3i32) \ () =>
        set checksums step (render_frame_checksum frame (rotation_for_step step))
        set' step (step +. 1i32)
    := c0 = index checksums 0i32
    := c1 = index checksums 1i32
    := c2 = index checksums 2i32
    ? c0 =. 45702i32 && c1 =. 43786i32 && c2 =. 43631i32
    ?> 42i32
    |: 1i32
