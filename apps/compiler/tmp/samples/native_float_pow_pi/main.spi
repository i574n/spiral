:= pow32 (x : f32) (y : f32) : f32 = !!!!Pow(x, y)
:= pow64 (x : f64) (y : f64) : f64 = !!!!Pow(x, y)

:= main () : i32 =
    := ~two32 = 2f32
    := ~three32 = 3f32
    := ~two64 = 2f64
    := ~three64 = 3f64
    := ~pi32 : f32 = !!!!Pi(`f32)
    := ~pi64 : f64 = !!!!Pi(`f64)
    ? pow32 two32 three32 =. 8f32
        && pow64 two64 three64 =. 8f64
        && pi32 > 3f32 && pi32 < 4f32
        && pi64 > 3f64 && pi64 < 4f64
    ?> 0i32
    |: 1i32
