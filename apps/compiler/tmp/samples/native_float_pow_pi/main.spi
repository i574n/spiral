inl pow32 (x : f32) (y : f32) : f32 = !!!!Pow(x,y)
inl pow64 (x : f64) (y : f64) : f64 = !!!!Pow(x,y)

inl main () : i32 =
    inl ~two32 = 2f32
    inl ~three32 = 3f32
    inl ~two64 = 2f64
    inl ~three64 = 3f64
    inl ~pi32 : f32 = !!!!Pi(`f32)
    inl ~pi64 : f64 = !!!!Pi(`f64)
    if pow32 two32 three32 =. 8f32
        && pow64 two64 three64 =. 8f64
        && pi32 > 3f32 && pi32 < 4f32
        && pi64 > 3f64 && pi64 < 4f64
    then 0i32
    else 1i32
