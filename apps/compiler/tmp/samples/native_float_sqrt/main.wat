(module
  (import "wasi_snapshot_preview1" "proc_exit" (func $proc_exit (param i32)))
  (memory (export "memory") 2)
  (global $hp (mut i32) (i32.const 72))
  (func $spiralMain (result i32)
    (local $v0 f32)
    (local $v1 f64)
    (local $v2 f32)
    (local $v3 f64)
    (local $v4 i32)
    (local $v6 i32)
    (local $v5 i32)
    (local.set $v0 (f32.const 144))
    (local.set $v1 (f64.const 81))
    (local.set $v2 (f32.sqrt (local.get $v0)))
    (local.set $v3 (f64.sqrt (local.get $v1)))
    (local.set $v4 (f32.eq (local.get $v2) (f32.const 12)))
    (if (local.get $v4)
        (then
            (local.set $v5 (f64.eq (local.get $v3) (f64.const 9)))
            (local.set $v6 (local.get $v5))
        )
        (else
            (local.set $v6 (i32.const 0))
        ))
    (if (local.get $v6)
        (then
            (return (i32.const 0))
        )
        (else
            (return (i32.const 1))
        ))
    (unreachable)
  )
  (func $_start (export "_start")
    (call $proc_exit (call $spiralMain)))
)
