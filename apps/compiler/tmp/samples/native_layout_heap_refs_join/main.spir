inl main () =
    inl a = !!!!LayoutToHeapRefs({q=11i32; w=13i32})
    if !!!!LessThan(a.q,20i32) then
        if !!!!Equal(a.w,13i32) then
            a.q <- 19i32
        else
            a.q <- 29i32
    else
        a.q <- 31i32
    inl b = !!!!LayoutIndex(a)
    b.w <- 23i32
    !!!!Add(a.q,b.w)
