inl main () =
    inl a = !!!!LayoutToStackRefs({items=!!!!Array(1i32,2i32); q=5i32; w=6i32})
    inl b = !!!!LayoutIndex(a)
    if !!!!Equal(a.q,5i32) then
        a.items <- !!!!Array(7i32,8i32)
        !!!!ArrayResize(b.items,3i32,9i32)
    else
        a.items <- !!!!Array(10i32)
        !!!!ArrayResize(b.items,2i32,11i32)
    !!!!ArraySet(a.items,1i32,12i32)
    a.q <- !!!!ArrayLength(b.items)
    a.w <- !!!!ArrayIndex(b.items,2i32)
    !!!!Add(a.q,a.w)
