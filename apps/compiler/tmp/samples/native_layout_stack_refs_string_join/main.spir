inl main () =
    inl a = !!!!LayoutToStackRefs({name="alpha"; q=5i32; w=6i32})
    if !!!!Equal(a.name,"alpha") then
        a.name <- "beta"
        a.q <- 7i32
    else
        a.name <- "wrong"
        a.q <- 9i32
    inl b = !!!!LayoutIndex(a)
    if !!!!Equal(b.name,"beta") then
        b.w <- 8i32
    else
        b.w <- 11i32
    !!!!Add(a.q,b.w)
