union rec phase =
    | Empty
    | Step : i32 * phase

inl reserve ~(xs : array i32) ~(requested_capacity : i32) : () =
    $'DynamicArrayReserve0(!xs,!requested_capacity)'

inl rec keep ~n first second third (xs : array i32) : i32 =
    if n =. 0i32 then
        match first with
        | Step (x, _) => if x =. 7i32 then index xs 0i32 else 99i32
        | Empty => 98i32
    else join keep (n -. 1i32) second third first xs

inl main () : i32 =
    inl empty = Empty
    inl first = Step (7i32, empty)
    inl second = Step (11i32, empty)
    inl third = Step (13i32, empty)
    inl ~size = 1i32
    inl ~xs : array i32 = create size
    set xs 0i32 7i32
    join reserve xs 4i32
    inl alias = xs
    inl result = join keep 1000002i32 first second third xs
    set xs 0i32 17i32
    if result =. 7i32 then
        if index alias 0i32 =. 17i32 then 0i32 else 2i32
    else 1i32
