:= ^ keep ~n (left : array i32) (right : array i32) : array i32 =
    ? n =. 0i32 ?> left
    |: ~~ keep (n -. 1i32) right left

:= main () : i32 =
    := ~size = 1i32
    := ~left : array i32 = create size
    := ~right : array i32 = create size
    set left 0i32 7i32
    set right 0i32 11i32
    := alias = left
    := result = ~~ keep 1000000i32 left right
    set result 0i32 13i32
    ? index alias 0i32 =. 13i32 ?>
        ? index right 0i32 =. 11i32 ?> 0i32 |: 2i32
    |: 1i32
