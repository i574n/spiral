open support

inl main () : i32 =
    inl ~derive =
        (fun seed =>
            if seed =. 0i32 then Empty
            else
                inl values : array i32 = create 2i32
                set values 0i32 seed
                set values 1i32 (seed +. 1i32)
                Values values
        ) : i32 -> payload
    score (join derive 0i32) +. score (join derive 4i32) +. 28i32
