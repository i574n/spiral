import "primitives/core.futil";
import "primitives/binary_operators.futil";
import "primitives/memories/comb.futil";
component sp_method0(in0: 32, in1: 32, in2: 32) -> (out: 32) {
  cells {
    spiral_tick = std_reg(1);
    spiral_ret = std_reg(32);
    v0 = std_reg(32);
    v1 = std_reg(32);
    v2 = std_reg(32);
    v3 = std_reg(32);
    op2 = std_mult_pipe(32);
    v4 = std_reg(32);
    op4 = std_add(32);
    v5 = std_reg(32);
    op6 = std_sub(32);
  }
  wires {
    group g1 {
      v0.in = in0;
      v0.write_en = 1'd1;
      v1.in = in1;
      v1.write_en = 1'd1;
      v2.in = in2;
      v2.write_en = 1'd1;
      g1[done] = v0.done & v1.done & v2.done ? 1'd1;
    }
    group g3 {
      op2.left = v0.out;
      op2.right = v1.out;
      op2.go = !op2.done ? 1'd1;
      v3.in = op2.out;
      v3.write_en = op2.done;
      g3[done] = v3.done;
    }
    group g5 {
      op4.left = v3.out;
      op4.right = v2.out;
      v4.in = op4.out;
      v4.write_en = 1'd1;
      g5[done] = v4.done;
    }
    group g7 {
      op6.left = v4.out;
      op6.right = 32'd42;
      v5.in = op6.out;
      v5.write_en = 1'd1;
      g7[done] = v5.done;
    }
    group g8 {
      spiral_ret.in = v5.out;
      spiral_ret.write_en = 1'd1;
      g8[done] = spiral_ret.done;
    }
    out = spiral_ret.out;
  }
  control {
    seq {
      g1;
      g3;
      g5;
      g7;
      g8;
    }
  }
}
component spiral_main() -> (out: 32) {
  cells {
    spiral_tick = std_reg(1);
    spiral_ret = std_reg(32);
    v0 = std_reg(32);
    v1 = std_reg(32);
    v2 = std_reg(32);
    c4 = sp_method0();
  }
  wires {
    group g1 {
      v0.in = 32'd5;
      v0.write_en = 1'd1;
      g1[done] = v0.done;
    }
    group g2 {
      v1.in = 32'd8;
      v1.write_en = 1'd1;
      g2[done] = v1.done;
    }
    group g3 {
      v2.in = 32'd2;
      v2.write_en = 1'd1;
      g3[done] = v2.done;
    }
    group g5 {
      spiral_ret.in = c4.out;
      spiral_ret.write_en = 1'd1;
      g5[done] = spiral_ret.done;
    }
    out = spiral_ret.out;
  }
  control {
    seq {
      g1;
      g2;
      g3;
      invoke c4(in0 = v0.out, in1 = v1.out, in2 = v2.out)();
      g5;
    }
  }
}
component main() -> () {
  cells {
    @external spiral_io = comb_mem_d1(32, 1, 1);
    entry = spiral_main();
  }
  wires {
    group spiral_store {
      spiral_io.addr0 = 1'd0;
      spiral_io.write_en = 1'd1;
      spiral_io.write_data = entry.out;
      spiral_store[done] = spiral_io.done;
    }
  }
  control {
    seq {
      invoke entry()();
      spiral_store;
    }
  }
}
