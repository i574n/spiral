:! state =
    {
        position : i32
        velocity : i32
    }

:! delta =
    {
        position : i32
        velocity : i32
    }

:? shift s : \* ds. ds -> s -> s

:+ shift state = \ ds (state s) =>
    := dposition, dvelocity =
        ~>
            ?= ds ?|
            | delta d => d::position, d::velocity
            | state d => d::position, d::velocity
    state {
        position = s::position +. dposition
        velocity = s::velocity +. dvelocity
    }

:= advance \* s {shift} ds. (derive : s -> ds) (current : s) : s =
    shift (~~ derive current) current

:= main () : i32 =
    := initial = state { position = 10i32; velocity = 20i32 }
    := ~bias = 1i32
    := ~derive =
        (\ (state s) =>
            delta {
                position = s::position -. 8i32 +. bias
                velocity = s::velocity -. 18i32
            }
        ) : state -> delta
    := (state next) = advance derive initial
    next::position +. next::velocity +. 7i32
