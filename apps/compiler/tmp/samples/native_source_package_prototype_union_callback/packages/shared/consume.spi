:< model::state

:? score s : s -> i32

:+ score outcome_t = \ result =>
    ?= result ?|
    | Idle => 3i32
    | Hit value => value
    | Flag value => ? value ?> 11i32 |: 5i32

:= evaluate \* a {score}. (derive : i32 -> a) (seed : i32) : i32 =
    score (~~ derive seed)

:= run () : i32 =
    := ~selector = 2i32
    := ~derive = (\ seed => Flag (seed = selector)) : i32 -> outcome_t
    evaluate derive selector + 31i32
