:< model::state

:? score s : s -> i32

:+ score outcome_t = \ result =>
    ?= result ?|
    | Idle => 3i32
    | Text _ => 11i32

:= evaluate \* a {score}. (derive : i32 -> a) (seed : i32) : i32 =
    score (~~ derive seed)

:= run () : i32 =
    := ~derive = (\ (_ : i32) => Text "managed") : i32 -> outcome_t
    evaluate derive 2i32 + 31i32
