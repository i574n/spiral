:< model::state

:? score s : s -> i32

:+ score outcome_t = \ result =>
    ?= result ?|
    | Idle => 3i32
    | Text _ => 5i32
    | Note _ => 6i32

:= evaluate \* a {score}. (derive : i32 -> a) (seed : i32) : i32 =
    score (~~ derive seed)

:= run () : i32 =
    := ~derive = (\ seed => ? seed = 1i32 ?> Text "alpha" |: Note "beta") : i32 -> outcome_t
    evaluate derive 1i32 + evaluate derive 2i32 + 31i32
