    v5 = (v4 + v2);
    int32_t v6 = 0;
    v6 = (v5 + v3);
    int32_t v7 = 0;
    v7 = (v6 - 10);
    return v7;
}
static int32_t spiral_main(void) {
    int32_t v0 = 0;
    v0 = 1;
    int32_t v1 = 0;
    int32_t v2 = 0;
    int32_t v3 = 0;
    int32_t v4 = 0;
    SpiralTuple0 spiral_tuple154 = sp_method0(v0);
    v1 = spiral_tuple154.v0;
    v2 = spiral_tuple154.v1;
    v3 = spiral_tuple154.v2;
    v4 = spiral_tuple154.v3;
    return sp_method1(v1, v2, v3, v4);
}
int main(void) {
