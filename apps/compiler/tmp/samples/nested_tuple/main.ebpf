}
static int32_t sp_method1(int32_t p0, int32_t p1, int32_t p2, int32_t p3) {
    int32_t v0 = p0;
    int32_t v1 = p1;
    int32_t v2 = p2;
    int32_t v3 = p3;
    int32_t v4 = 0;
