// An inbuilt op's argument may be an application (`!!!!EQ(s, g A)`); it used to parse a single atom, so the definition
// failed to parse and was dropped without a diagnostic (callers saw "Unbound variable"; lane C, eoie model.spi).
// The exit code is the verdict: 0.
union k = A | B
inl g = function A => 1i32 | B => 2i32
let f (s : i32) : i32 = if !!!!EQ(s, g A) then 0i32 else 1i32
inl main () : i32 =
    inl ~s = 1i32
    f s