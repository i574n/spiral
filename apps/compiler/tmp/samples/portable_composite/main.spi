inl make_state ~x = {left = x; right = x +. 2i32; active = x > 0i32}

inl score_state ~{left right active} : i32 =
    if active then left +. right -. 4i32 else 1i32

inl classify ~x = x >= 3.5f32, x, 7i32

inl score_tuple ~(ok, value, bias) : i32 =
    if ok then if value >= 3.5f32 then bias -. 7i32 else 1i32 else 2i32

inl same ~x ~y = x =. y

inl valid_unsigned ~(x : u32) = (x +. 5u32) %. 4u32 =. 0u32

inl arithmetic ~x ~y = (x *. y +. 5i32) /. 3i32

inl stage_arithmetic ~score : i32 =
    inl ~x = 4i32
    inl ~y = 4i32
    inl arithmetic_score = join arithmetic x y
    score +. arithmetic_score -. 7i32

inl stage_unsigned ~score : i32 =
    inl ~x = 7u32
    if join valid_unsigned x then join stage_arithmetic score else 1i32

inl stage_text ~score : i32 =
    inl ~x = "spiral"
    inl ~y = "spiral"
    if join same x y then join stage_unsigned score else 1i32

inl stage_float ~score : i32 =
    inl ~x = 4.0f32
    inl state = join classify x
    inl tuple_score = join score_tuple state
    inl ~next_score = score +. tuple_score
    join stage_text next_score

inl stage_record ~score : i32 =
    inl ~x = 1i32
    inl state = join make_state x
    inl record_score = join score_state state
    inl ~next_score = score +. record_score
    join stage_float next_score

inl main () : i32 =
    inl ~score = 0i32
    join stage_record score
