:= make_state ~x = { left = x; right = x +. 2i32; active = x > 0i32 }

:= score_state ~{ left right active } : i32 =
    ? active ?> left +. right -. 4i32 |: 1i32

:= classify ~x = x >= 3.5f32, x, 7i32

:= score_tuple ~(ok, value, bias) : i32 =
    ? ok ?> ? value >= 3.5f32 ?> bias -. 7i32 |: 1i32 |: 2i32

:= same ~x ~y = x =. y

:= valid_unsigned ~(x : u32) = (x +. 5u32) %. 4u32 =. 0u32

:= arithmetic ~x ~y = (x *. y +. 5i32) /. 3i32

:= stage_arithmetic ~score : i32 =
    := ~x = 4i32
    := ~y = 4i32
    := arithmetic_score = ~~ arithmetic x y
    score +. arithmetic_score -. 7i32

:= stage_unsigned ~score : i32 =
    := ~x = 7u32
    ? ~~ valid_unsigned x ?> ~~ stage_arithmetic score |: 1i32

:= stage_text ~score : i32 =
    := ~x = "spiral"
    := ~y = "spiral"
    ? ~~ same x y ?> ~~ stage_unsigned score |: 1i32

:= stage_float ~score : i32 =
    := ~x = 4.0f32
    := state = ~~ classify x
    := tuple_score = ~~ score_tuple state
    := ~next_score = score +. tuple_score
    ~~ stage_text next_score

:= stage_record ~score : i32 =
    := ~x = 1i32
    := state = ~~ make_state x
    := record_score = ~~ score_state state
    := ~next_score = score +. record_score
    ~~ stage_float next_score

:= main () : i32 =
    := ~score = 0i32
    ~~ stage_record score
