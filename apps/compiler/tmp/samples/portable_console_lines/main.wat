(module
  (import "wasi_snapshot_preview1" "fd_write" (func $fd_write (param i32 i32 i32 i32) (result i32)))
  (import "wasi_snapshot_preview1" "proc_exit" (func $proc_exit (param i32)))
  (data (i32.const 48) "\04\00\00\00true")
  (data (i32.const 56) "\05\00\00\00false")
  (data (i32.const 64) "\01\00\00\00-")
  (func $write (param $fd i32) (param $ptr i32) (param $len i32)
    (i32.store (i32.const 0) (local.get $ptr))
    (i32.store (i32.const 4) (local.get $len))
    (drop (call $fd_write (local.get $fd) (i32.const 0) (i32.const 1) (i32.const 8))))
  (func $print_str (param $s i32)
    (call $write (i32.const 1) (i32.add (local.get $s) (i32.const 4)) (i32.load (local.get $s))))
  (func $print_newline
    (i32.store8 (i32.const 12) (i32.const 10))
    (call $write (i32.const 1) (i32.const 12) (i32.const 1)))
  (func $print_u64 (param $x i64) (local $p i32)
    (local.set $p (i32.const 48))
    (loop $digit
      (local.set $p (i32.sub (local.get $p) (i32.const 1)))
      (i32.store8 (local.get $p) (i32.add (i32.const 48) (i32.wrap_i64 (i64.rem_u (local.get $x) (i64.const 10)))))
      (local.set $x (i64.div_u (local.get $x) (i64.const 10)))
      (br_if $digit (i64.ne (local.get $x) (i64.const 0))))
    (call $write (i32.const 1) (local.get $p) (i32.sub (i32.const 48) (local.get $p))))
  (func $print_i64 (param $x i64)
    (if (i64.lt_s (local.get $x) (i64.const 0))
      (then
        (i32.store8 (i32.const 12) (i32.const 45))
        (call $write (i32.const 1) (i32.const 12) (i32.const 1))
        (call $print_u64 (i64.sub (i64.const 0) (local.get $x))))
      (else (call $print_u64 (local.get $x)))))
  (memory (export "memory") 2)
  (global $hp (mut i32) (i32.const 112))
  (func $spiralMain (result i32)
    (local $v17 i32)
    (local $v18 i32)
    (local $v34 i32)
    (local $v47 i32)
    (local $v61 i32)
    (local $v62 i64)
    (local.set $v17 (i32.const 72))
    (call $print_str (local.get $v17))
    (call $print_newline)
    (local.set $v18 (i32.const 42))
    (call $print_i64 (i64.extend_i32_s (local.get $v18)))
    (call $print_newline)
    (local.set $v34 (i32.const 88))
    (call $print_str (local.get $v34))
    (local.set $v47 (i32.const 96))
    (call $print_str (local.get $v47))
    (local.set $v61 (i32.const 104))
    (call $print_str (local.get $v61))
    (call $print_newline)
    (local.set $v62 (i64.const -7))
    (call $print_i64 (local.get $v62))
    (call $print_newline)
    (return (i32.const 0))
    (unreachable)
  )
  (data (i32.const 72) "\05\00\00\00hello")
  (data (i32.const 88) "\01\00\00\00a")
  (data (i32.const 96) "\01\00\00\00b")
  (data (i32.const 104) "\00\00\00\00")
  (func $_start (export "_start")
    (call $proc_exit (call $spiralMain)))
)
