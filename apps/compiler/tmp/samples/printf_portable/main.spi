// The portable `!!!!Printf(format, args..)` (lane W): `%s` takes a string, `%d` an integer of any width, `%%` writes a
// percent sign, and the rest of the format is text, braces, quotes and escapes included. Every backend prints the same
// bytes (C is the oracle); C used to pass every argument as a string (`60l->ptr` for a `%d`), Rust, Delphi, Zig and
// TypeScript took only `"%s"` with one argument, and F#, Python, Lua and Gleam had no Printf at all.
inl main () : i32 =
    inl ~frames = 60i32
    inl ~big = -9000000000i64
    inl ~byte = 200u8
    inl ~name = "cube"
    !!!!Printf("%s: %d frames, checksum %d\n", name, frames, 970392i32)
    !!!!Printf("big %d, small %d, byte %d\n", big, -5i32, byte)
    !!!!Printf("100%% {braces} \"quoted\" \\ tab\tend\n")
    !!!!Printf("%s\n", "literal")
    !!!!Printf("%s", name)
    !!!!Printf("\n")
    0i32