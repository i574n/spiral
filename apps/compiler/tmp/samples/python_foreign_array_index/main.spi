:= main () : i32 =
    := ~pairs : array (i32 * i32) = $'static_array(1)'
    set pairs 0i32 (20i32, 22i32)
    := left, right = index pairs 0i32
    := ~plain : array i32 = $'dynamic_array(1)'
    set plain 0i32 7i32
    := ~native : array i32 = create 1i32
    set native 0i32 9i32
    := scalar = index native 0i32
    := scalar_is_native : bool = $'type(!scalar) is int'
    := ~objects : array (i32 * i32) = $'cp.empty(1,dtype=object)'
    set objects 0i32 (3i32, 4i32)
    := a, b = index objects 0i32
    := pair_sum = !!!!Add(left, right)
    := object_sum = !!!!Add(a, b)
    := plain_value = index plain 0i32
    ? !!!!EQ(pair_sum, 42i32) ?>
        ? !!!!EQ(plain_value, 7i32) ?>
            ? !!!!EQ(scalar, 9i32) ?>
                ? scalar_is_native ?>
                    ? !!!!EQ(object_sum, 7i32) ?> 0i32 |: 5i32
                |: 4i32
            |: 3i32
        |: 2i32
    |: 1i32
