        if (v2) {
            int32_t v3 = 0;
            v3 = (v0 - 1);
            int32_t v4 = 0;
            v4 = (v1 + 1);
            int32_t t368_3 = v3;
            int32_t t402_4 = v4;
            v0 = t368_3;
            v1 = t402_4;
            continue;
        } else {
            return v1;
        }
    }
    return 0;
}
static int32_t spiral_main(void) {
    int32_t v0 = 0;
