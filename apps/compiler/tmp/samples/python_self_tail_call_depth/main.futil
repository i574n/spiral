import "primitives/core.futil";
import "primitives/binary_operators.futil";
import "primitives/memories/comb.futil";
component sp_count_down_0(in0: 32, in1: 32) -> (out: 32) {
  cells {
    spiral_tick = std_reg(1);
    spiral_ret = std_reg(32);
    v0 = std_reg(32);
    v1 = std_reg(32);
    spiral_go = std_reg(1);
    v2 = std_reg(1);
    op3 = std_slt(32);
    b5 = std_reg(1);
    v3 = std_reg(32);
    op7 = std_sub(32);
    v4 = std_reg(32);
    op9 = std_add(32);
    t11 = std_reg(32);
    t13 = std_reg(32);
  }
  wires {
    group g1 {
      v0.in = in0;
      v0.write_en = 1'd1;
      v1.in = in1;
      v1.write_en = 1'd1;
      g1[done] = v0.done & v1.done ? 1'd1;
    }
    group g2 {
      spiral_go.in = 1'd1;
      spiral_go.write_en = 1'd1;
      g2[done] = spiral_go.done;
    }
    group g4 {
      op3.left = 32'd0;
      op3.right = v0.out;
      v2.in = op3.out;
      v2.write_en = 1'd1;
      g4[done] = v2.done;
    }
    group g6 {
      b5.in = v2.out;
      b5.write_en = 1'd1;
      g6[done] = b5.done;
    }
    group g8 {
      op7.left = v0.out;
      op7.right = 32'd1;
      v3.in = op7.out;
      v3.write_en = 1'd1;
      g8[done] = v3.done;
    }
    group g10 {
      op9.left = v1.out;
      op9.right = 32'd1;
      v4.in = op9.out;
      v4.write_en = 1'd1;
      g10[done] = v4.done;
    }
    group g12 {
      t11.in = v3.out;
      t11.write_en = 1'd1;
      g12[done] = t11.done;
    }
    group g14 {
      t13.in = v4.out;
      t13.write_en = 1'd1;
      g14[done] = t13.done;
    }
    group g15 {
      v0.in = t11.out;
      v0.write_en = 1'd1;
      g15[done] = v0.done;
    }
    group g16 {
      v1.in = t13.out;
      v1.write_en = 1'd1;
      g16[done] = v1.done;
    }
    group g17 {
      spiral_ret.in = v1.out;
      spiral_ret.write_en = 1'd1;
      g17[done] = spiral_ret.done;
    }
    group g18 {
      spiral_go.in = 1'd0;
      spiral_go.write_en = 1'd1;
      g18[done] = spiral_go.done;
    }
    out = spiral_ret.out;
  }
  control {
    seq {
      g1;
      g2;
      while spiral_go.out {
        seq {
          g4;
          g6;
          if b5.out {
            seq {
              g8;
              g10;
              g12;
              g14;
              g15;
              g16;
            }
          } else {
            seq {
              g17;
              g18;
            }
          };
        }
      };
    }
  }
}
component spiral_main() -> (out: 32) {
  cells {
    spiral_tick = std_reg(1);
    spiral_ret = std_reg(32);
    v0 = std_reg(32);
    v1 = std_reg(32);
    v2 = std_reg(32);
    c3 = sp_count_down_0();
    v3 = std_reg(1);
    op5 = std_eq(32);
    b7 = std_reg(1);
  }
  wires {
    group g1 {
      v0.in = 32'd5000;
      v0.write_en = 1'd1;
      g1[done] = v0.done;
    }
    group g2 {
      v1.in = 32'd0;
      v1.write_en = 1'd1;
      g2[done] = v1.done;
    }
    group g4 {
      v2.in = c3.out;
      v2.write_en = 1'd1;
      g4[done] = v2.done;
    }
    group g6 {
      op5.left = v2.out;
      op5.right = 32'd5000;
      v3.in = op5.out;
      v3.write_en = 1'd1;
      g6[done] = v3.done;
    }
    group g8 {
      b7.in = v3.out;
      b7.write_en = 1'd1;
      g8[done] = b7.done;
    }
    group g9 {
      spiral_ret.in = 32'd0;
      spiral_ret.write_en = 1'd1;
      g9[done] = spiral_ret.done;
    }
    group g10 {
      spiral_ret.in = 32'd1;
      spiral_ret.write_en = 1'd1;
      g10[done] = spiral_ret.done;
    }
    out = spiral_ret.out;
  }
  control {
    seq {
      g1;
      g2;
      invoke c3(in0 = v0.out, in1 = v1.out)();
      g4;
      g6;
      g8;
      if b7.out {
        seq {
          g9;
        }
      } else {
        seq {
          g10;
        }
      };
    }
  }
}
component main() -> () {
  cells {
    @external spiral_io = comb_mem_d1(32, 1, 1);
    entry = spiral_main();
  }
  wires {
    group spiral_store {
      spiral_io.addr0 = 1'd0;
      spiral_io.write_en = 1'd1;
      spiral_io.write_data = entry.out;
      spiral_store[done] = spiral_io.done;
    }
  }
  control {
    seq {
      invoke entry()();
      spiral_store;
    }
  }
}
