// FOR-D repro (lane G, 2026-10-06): the Python backend emits a self tail call as a real recursive call (`return
// method0(v0, v1)`), so a loop of more than ~1,000 iterations dies with RecursionError; the C, C++, Rust, Delphi, F# and
// TypeScript backends loop (mega_brzozowski_derivatives/runtime_bench: an 8,192-slot array fill, fine everywhere else).
// Expected on every backend: exit 0. The harness row is C (the oracle); the Python run is by hand:
// probe.ps1 python_self_tail_call_depth -Mode single-flight -Backend Python; SPIRAL_CUDA=0 python main.py. Not blessed.
let rec count_down (n : i32) (acc : i32) : i32 =
    if !!!!LT(0i32, n) then
        inl n' = !!!!Sub(n, 1i32)
        inl acc' = !!!!Add(acc, 1i32)
        count_down n' acc'
    else acc

inl main () : i32 =
    inl ~n = 5000i32
    inl total = count_down n 0i32
    if !!!!EQ(total, 5000i32) then 0i32 else 1i32
