type point = { x : i32; y : i32 }

nominal tagged = { x : i32; y : i32 }

inl moved r : point = { r with x = 3i32 }

inl tagged_moved r : tagged = { r with x = 3i32 }

inl main () : i32 =
    inl p = moved { x = 0i32; y = 4i32 }
    inl q = tagged_moved (tagged { x = 0i32; y = 4i32 })
    match q with
    | tagged { x y } => p.x +. p.y +. x +. y -. 14i32
