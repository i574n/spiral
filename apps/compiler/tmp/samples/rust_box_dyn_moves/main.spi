:! box t = $'Box<`t>'
:! dynfn = $'dyn Fn() -> i32'

:= rust_box_dyn_moved_into_join (k : i32) : i32 =
    := f : box dynfn = $'Box::new(move || !k * 3) as Box<dyn Fn() -> i32>'
    := r = ~~ $'(!f)()' : i32
    r + 1

:= main () : i32 =
    := ~k = 7i32
    !!!!BackendSwitch({
        C = \ () => 22i32 : i32
        Rust = \ () => rust_box_dyn_moved_into_join k : i32
        Bend = \ () => 22i32 : i32
    })
