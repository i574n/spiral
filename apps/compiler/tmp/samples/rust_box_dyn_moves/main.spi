nominal box t = $'Box<`t>'
nominal dynfn = $'dyn Fn() -> i32'

inl rust_box_dyn_moved_into_join (k : i32) : i32 =
    inl f : box dynfn = $'Box::new(move || !k * 3) as Box<dyn Fn() -> i32>'
    inl r = join $'(!f)()' : i32
    r + 1

inl main () : i32 =
    inl ~k = 7i32
    !!!!BackendSwitch({ C = fun () => 22i32 : i32; Rust = fun () => rust_box_dyn_moved_into_join k : i32; Bend = fun () => 22i32 : i32 })