(module
  (import "wasi_snapshot_preview1" "proc_exit" (func $proc_exit (param i32)))
  (memory (export "memory") 2)
  (global $hp (mut i32) (i32.const 72))
  (func $spiralMain (result i32)
    (local $v0 i32)
    (local $v1 i32)
    (local $v2 i32)
    (local $v3 i32)
    (local.set $v0 (i32.const 20))
    (local.set $v1 (i32.const 2))
    (local.set $v2 (i32.mul (local.get $v0) (local.get $v1)))
    (local.set $v3 (i32.add (local.get $v2) (i32.const 3)))
    (return (local.get $v3))
    (unreachable)
  )
  (func $_start (export "_start")
