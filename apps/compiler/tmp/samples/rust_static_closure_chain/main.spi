union rec stream =
    | Cons : u64 * (() -> stream)
    | Nil

inl rec build (n : u64) : stream =
    if n = 0 then Nil else Cons (n, fun () => build (n - 1))

inl native () : i32 =
    inl static_closure_count = 80u64
    inl ~s = build static_closure_count
    inl ~acc = 0u64
    let rec loop (s : stream) (acc : u64) : u64 =
        match s with
        | Cons (x, next) => loop (next ()) (acc + x)
        | Nil => acc
    inl r = loop s acc % 200
    !!!!Conv(`i32, r)

inl main () : i32 = native ()
