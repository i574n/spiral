:! boxed = $'Box<dyn Fn() -> i32>'

:| stack_u =
    | SBoxed : boxed
    | SEmpty

:| ^ heap_u =
    | HBoxed : boxed
    | HEmpty

:= native (k : i32) (flag : bool) : i32 =
    := f : boxed = $'Box::new(move || !k * 6) as Box<dyn Fn() -> i32>'
    := s = ? flag ?> SBoxed f |: SEmpty
    := r1 = ?= s ?| SBoxed f => $'(!f)()' : i32 | SEmpty => 0i32
    := g : boxed = $'Box::new(|| 7i32) as Box<dyn Fn() -> i32>'
    := h = ? flag ?> HBoxed g |: HEmpty
    := r2 = ?= h ?| HBoxed g => $'(!g)()' : i32 | HEmpty => 0i32
    r1 +. r2

:= main () : i32 =
    := ~k = 7i32
    := ~flag = !+
    !!!!BackendSwitch({ C = \ () => 49i32 : i32; Rust = \ () => native k flag : i32; Bend = \ () => 49i32 : i32 })
