:= main () : i32 =
    := ~a = 100i8
    := s8 = a +. a
    := ~b = 200u8
    := ~c = 100u8
    := u8s = b +. c
    := ~n8 = 0i8 -. 8i8
    := sh8 = !!!!ShiftRight(n8, 1i32)
    := ush = !!!!ShiftRight(b, 1i32)
    := ~p = 20000i16
    := s16 = p +. p
    := ~q = 40000u16
    := u16s = q +. q
    := ~n = 7i32
    := from8 = !!!!Conv(`i8, n)
    := ~z = 9i8
    := as_i = !!!!Conv(`i32, z)
    ?
        s8 =. (0i8 -. 56i8)
        && u8s =. 44u8
        && sh8 =. (0i8 -. 4i8)
        && ush =. 100u8
        && s16 =. (0i16 -. 25536i16)
        && u16s =. 14464u16
        && from8 =. 7i8
        && as_i =. 9i32
    ?> 0i32
    |: 1i32
