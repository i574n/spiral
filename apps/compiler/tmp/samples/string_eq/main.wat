    (local.set $v4 (i32.const 96))
    (local.set $v5 (i32.const 104))
    (local.set $v6 (call $str_slice (local.get $v3) (i32.const 1) (i32.const 0)))
    (local.set $v7 (call $str_eq (local.get $v2) (local.get $v3)))
    (if (local.get $v7)
        (then
            (local.set $v8 (i32.eqz (call $str_eq (local.get $v2) (local.get $v4))))
            (local.set $v9 (local.get $v8))
        )
        (else
            (local.set $v9 (i32.const 0))
        ))
    (if (local.get $v9)
        (then
            (local.set $v10 (i32.eqz (call $str_eq (local.get $v0) (local.get $v3))))
            (local.set $v11 (local.get $v10))
        )
        (else
            (local.set $v11 (i32.const 0))
        ))
    (if (local.get $v11)
        (then
