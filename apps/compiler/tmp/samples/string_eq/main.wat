            (local.set $v13 (local.get $v12))
        )
        (else
            (local.set $v13 (i32.const 0))
        ))
    (if (local.get $v13)
        (then
            (local.set $v14 (i32.eqz (call $str_eq (local.get $v5) (local.get $v0))))
            (local.set $v15 (local.get $v14))
        )
        (else
            (local.set $v15 (i32.const 0))
        ))
    (if (local.get $v15)
        (then
            (return (i32.const 0))
        )
        (else
            (return (i32.const 1))
        ))
    (unreachable)
  )
  (data (i32.const 72) "\02\00\00\00\c3\a9")
  (data (i32.const 80) "\01\00\00\00x")
  (data (i32.const 88) "\03\00\00\00\c3\a9x")
  (data (i32.const 96) "\03\00\00\00\c3\a9y")
  (data (i32.const 104) "\00\00\00\00")
  (func $_start (export "_start")
