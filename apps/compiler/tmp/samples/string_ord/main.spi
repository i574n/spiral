:= main () : i32 =
    := ~a = "a"
    := ~a2 = "a"
    := ~b = "b"
    := ~e = "é"
    := ~ex = "éx"
    := ~empty = ""
    ? !!!!LT(a, a2)
    ?> 1i32
    |:
        ?
            !!!!LT(a, b)
            && !!!!LT(b, e)
            && !!!!LT(e, ex)
            && !!!!LT(empty, a)
            && !!!!LTE(a, a2)
            && !!!!GTE(a2, a)
            && !!!!GT(ex, e)
            && !!!!GTE(b, a)
        ?> 0i32
        |: 1i32
