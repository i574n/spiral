:| phase =
    | Cold
    | Warm
    | Hot
    | Done

:~ score x : i32 =
    ?= x ?|
    | Cold => 1i32
    | Warm => 2i32
    | Hot => 3i32
    | Done => 4i32

:= main () =
    := ~selector = 3i32
    := value =
        ? selector =. 0i32 ?> Cold
        |? selector =. 1i32 ?> Warm
        |? selector =. 2i32 ?> Hot
        |: Done
    score value -. 4i32
