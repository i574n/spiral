:| payload =
    | Empty
    | Values : array i32

:~ score x : i32 =
    ?= x ?|
    | Empty => 0i32
    | Values values => length values +. index values 0i32 +. index values 1i32

:= main () : i32 =
    := ~n = 2i32
    := ~values : array i32 = create n
    set values 0i32 4i32
    set values 1i32 5i32
    := wrapped = Values values
    score wrapped -. 11i32
