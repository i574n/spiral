nominal i32_array = array_base i32

inl create (n : i32) : i32_array = i32_array !!!!ArrayCreate(`i32, n)
inl get (array : i32_array) (i : i32) : i32 =
    match array with
    | i32_array values => !!!!ArrayIndex(values, i)
inl set (array : i32_array) (i : i32) (value : i32) : () =
    match array with
    | i32_array values => !!!!ArrayIndexSet(values, i, value)

union slot =
    | Missing
    | Held : i32_array

inl main () : i32 =
    inl ~n = 2i32
    inl a = create n
    inl ~x = 7i32
    set a 0i32 x
    inl ~flag = true
    inl box = if flag then Held a else Missing
    match box with
    | Held values => if get values 0i32 =. 7i32 then 0i32 else 1i32
    | Missing => 1i32
