:| answer =
    | No : bool
    | Yes : i32

:~ score x : i32 =
    ?= x ?|
    | No value => ? value ?> 1i32 |: 2i32
    | Yes value => value

:= main () : i32 =
    := ~flag = !+
    := yes = ? flag ?> Yes 7i32 |: No !-
    := no = ? flag ?> No !+ |: Yes 1i32
    ? score yes =. 7i32 && score no =. 1i32 ?> 0i32 |: 1i32
