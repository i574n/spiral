union slot =
    | Missing
    | Call : (i32 -> i32)

inl main () : i32 =
    inl ~n = 3i32
    inl f (z : i32) : i32 = z +. n
    inl ~g = f
    inl ~flag = true
    inl box = if flag then Call g else Missing
    match box with
    | Call call => if call 4i32 =. 7i32 then 0i32 else 1i32
    | Missing => 1i32
