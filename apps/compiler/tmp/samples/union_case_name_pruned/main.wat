    (local.set $v4 (i32.const 96))
    (local.set $v5 (i32.const 112))
    (local.set $t6 (call $alloc (i32.const 32)))
    (i32.store (local.get $t6) (i32.const 3))
    (i32.store offset=8 (i32.add (local.get $t6) (i32.mul (i32.const 0) (i32.const 8))) (local.get $v3))
    (i32.store offset=8 (i32.add (local.get $t6) (i32.mul (i32.const 1) (i32.const 8))) (local.get $v4))
    (i32.store offset=8 (i32.add (local.get $t6) (i32.mul (i32.const 2) (i32.const 8))) (local.get $v5))
    (local.set $v6 (local.get $t6))
    (local.set $v7 (select (i32.const 1) (i32.const 2) (i32.eq (i32.load (local.get $v0)) (i32.const 0))))
    (local.set $v8 (i32.load offset=8 (i32.add (local.get $v6) (i32.mul (local.get $v7) (i32.const 8)))))
    (local.set $v9 (call $str_eq (local.get $v8) (i32.const 96)))
    (if (local.get $v9)
