            (i32.store (local.get $t12) (i32.const 3))
            (i32.store offset=8 (i32.add (local.get $t12) (i32.mul (i32.const 0) (i32.const 8))) (local.get $v3))
            (i32.store offset=8 (i32.add (local.get $t12) (i32.mul (i32.const 1) (i32.const 8))) (local.get $v4))
            (i32.store offset=8 (i32.add (local.get $t12) (i32.mul (i32.const 2) (i32.const 8))) (local.get $v5))
            (local.set $v10 (local.get $t12))
