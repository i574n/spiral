union slot =
    | None
    | Held : (heap {value : i32}) * i32

let score x : i32 =
    match x with
    | None => 1i32
    | Held (cell, n) =>
        inl obj = !!!!LayoutIndex(cell)
        if obj.value +. n =. 7i32 then 0i32 else 1i32

inl main () : i32 =
    inl ~a = 3i32
    inl ~b = 4i32
    inl cell = !!!!LayoutToHeap({value = a})
    inl ~flag = true
    inl held = if flag then Held (cell, b) else None
    score held
