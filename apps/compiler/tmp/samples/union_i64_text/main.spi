union slot =
    | None
    | Both : i64 * string

let score x : i32 =
    match x with
    | None => 1i32
    | Both (n, word) =>
        if n =. 5000000000i64 && !!!!EQ(word, "hi") then 0i32 else 1i32

inl main () : i32 =
    inl ~n = 5000000000i64
    inl ~word = "hi"
    inl ~flag = true
    inl held = if flag then Both (n, word) else None
    score held
