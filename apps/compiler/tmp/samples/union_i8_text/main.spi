:| slot =
    | None
    | Both : i8 * string

:~ score x : i32 =
    ?= x ?|
    | None => 1i32
    | Both (n, word) =>
        ? n =. 100i8 && !!!!EQ(word, "hi") ?> 0i32 |: 1i32

:= main () : i32 =
    := ~n = 100i8
    := ~word = "hi"
    := ~flag = !+
    := held = ? flag ?> Both (n, word) |: None
    score held
