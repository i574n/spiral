:| num =
    | Real : f64
    | Whole : i32

:~ twice x : i32 =
    := scaled = x *. 2.0f64
    !!!!Conv(`i32, scaled)

:~ score x : i32 =
    ?= x ?|
    | Real value => twice value
    | Whole value => value

:= main () : i32 =
    := ~flag = !+
    := ~x = 1.5f64
    := wide = ? flag ?> Real x |: Whole 1i32
    := whole = ? flag ?> Whole 5i32 |: Real x
    ? score wide =. 3i32 && score whole =. 5i32 ?> 0i32 |: 1i32
