union slot =
    | None
    | Both : string * string

let score x : i32 =
    match x with
    | None => 1i32
    | Both (left, right) =>
        if !!!!EQ(left, "hi") && !!!!EQ(right, "yo") then 0i32 else 1i32

inl main () : i32 =
    inl ~left_word = "hi"
    inl ~right_word = "yo"
    inl ~flag = true
    inl held = if flag then Both (left_word, right_word) else None
    score held
