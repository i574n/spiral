:| triple =
    | One : i32
    | All : i32 * string * bool

:~ score x : i32 =
    ?= x ?|
    | One value => value
    | All (n, word, flag) =>
        ? n =. 7i32 && !!!!EQ(word, "hi") && flag ?> 0i32 |: 1i32

:= main () : i32 =
    := ~flag = !+
    := ~n = 7i32
    := ~word = "hi"
    := ~on = !+
    := held = ? flag ?> All (n, word, on) |: One 1i32
    score held
