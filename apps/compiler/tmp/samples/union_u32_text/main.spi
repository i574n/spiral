union slot =
    | None
    | Both : u32 * string

let score x : i32 =
    match x with
    | None => 1i32
    | Both (n, word) =>
        if n =. 4000000000u32 && !!!!EQ(word, "hi") then 0i32 else 1i32

inl main () : i32 =
    inl ~n = 4000000000u32
    inl ~word = "hi"
    inl ~flag = true
    inl held = if flag then Both (n, word) else None
    score held
