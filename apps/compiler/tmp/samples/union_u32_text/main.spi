:| slot =
    | None
    | Both : u32 * string

:~ score x : i32 =
    ?= x ?|
    | None => 1i32
    | Both (n, word) =>
        ? n =. 4000000000u32 && !!!!EQ(word, "hi") ?> 0i32 |: 1i32

:= main () : i32 =
    := ~n = 4000000000u32
    := ~word = "hi"
    := ~flag = !+
    := held = ? flag ?> Both (n, word) |: None
    score held
