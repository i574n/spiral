:| shape = Circle : i32 | Rect : i32 * i32 | Empty

:= area s =
    ?= s ?|
    | Circle r => 3i32 * r * r
    | Rect (w, h) => w * h
    | Empty => 0

:= main () =
    :~ a = dyn (Circle 2i32)
    :~ b = dyn (Rect (3i32, 4i32))
    :~ c = dyn Empty
    :~ same = ? a = dyn (Circle 2i32) ?> 100i32 |: 0
    area a + area b + area c + same
