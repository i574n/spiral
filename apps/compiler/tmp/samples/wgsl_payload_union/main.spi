union shape = Circle : i32 | Rect : i32 * i32 | Empty

inl area s =
    match s with
    | Circle r => 3i32 * r * r
    | Rect(w, h) => w * h
    | Empty => 0

inl main () =
    let a = dyn (Circle 2i32)
    let b = dyn (Rect(3i32, 4i32))
    let c = dyn Empty
    let same = if a = dyn (Circle 2i32) then 100i32 else 0
    area a + area b + area c + same
