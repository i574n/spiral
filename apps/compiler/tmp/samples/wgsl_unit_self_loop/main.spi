:= main () : i32 =
    := ~count = 6i32
    := cells : array_base i32 = !!!!ArrayCreate(`i32, 6i32)
    :~ ^ fill (i : i32) : () =
        ? !!!!LT(i, count) ?>
            !!!!ArrayIndexSet(cells, i, i)
            fill !!!!Add(i, 1i32)
    fill 0i32
    := last : i32 = !!!!ArrayIndex(cells, 5i32)
    !!!!Add(last, 2i32)
