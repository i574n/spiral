:= while' (cond : () -> bool) (body : () -> ()) : () =
    !!!!While((~~ cond ()), (body ()))

:= set' \* t. (a : t) ~(b : t) : () =
    !!!!BackendSwitch({
        Fsharp = \ () => $"!a <- !b" : ()
        C = \ () => $"!a = !b" : ()
        Zig = \ () => $"!a = !b" : ()
        Lean = \ () => $"!a := !b" : ()
        Rust = \ () => $"!a = !b" : ()
        Delphi = \ () => $"!a := !b" : ()
        Wgsl = \ () => $"!a = !b" : ()
        Kotlin = \ () => $"!a = !b" : ()
        Swift = \ () => $"!a = !b" : ()
        OpenQasm = \ () => $"!a = !b" : ()
        Ebpf = \ () => $"!a = !b" : ()
    })

:= break' () : () = $"break"
:= continue' () : () = $"continue"

:= main () : i32 =
    := ~i = 0i32
    := ~acc = 0i32
    while' (\ () => !+) \ () =>
        set' i (i +. 1i32)
        ? i < 3i32 ?>
            continue' ()
        |? i >= 6i32 ?>
            break' ()
        |:
            set' acc (acc +. i)
    acc -. 12i32
