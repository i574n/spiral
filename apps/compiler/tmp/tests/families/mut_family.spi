:| mut_heap_union_heap_union_heap_pair_heaps_slot =
    | MutHeapUnionHeapUnionHeapPairHeapsNone
    | MutHeapUnionHeapUnionHeapPairHeapsHeld :
        (heap { value : (heap { value : heap { value : i32 * string } * heap { value : i32 * string } }) * i32 })

:| mut_heap_union_heap_union_heap_pair_heaps_wrap =
    | MutHeapUnionHeapUnionHeapPairHeapsAbsent
    | MutHeapUnionHeapUnionHeapPairHeapsBox : (heap { value : mut_heap_union_heap_union_heap_pair_heaps_slot })

:~ mut_heap_union_heap_union_heap_pair_heaps_score x : i32 =
    ?= x ?|
    | MutHeapUnionHeapUnionHeapPairHeapsAbsent => 1i32
    | MutHeapUnionHeapUnionHeapPairHeapsBox box =>
        := opened = !!!!LayoutIndex(box)
        ?= opened.value ?|
        | MutHeapUnionHeapUnionHeapPairHeapsNone => 1i32
        | MutHeapUnionHeapUnionHeapPairHeapsHeld inner =>
            := inner_opened = !!!!LayoutIndex(inner)
            := ~(inner_held, flag) = inner_opened.value
            := deep_opened = !!!!LayoutIndex(inner_held)
            := ~(left, right) = deep_opened.value
            := left_opened = !!!!LayoutIndex(left)
            := ~(a, b) = left_opened.value
            := right_opened = !!!!LayoutIndex(right)
            := ~(c, d) = right_opened.value
            ? a =. 7i32 && !!!!EQ(b, "hi") && c =. 4i32 && !!!!EQ(d, "yo") && flag =. 2i32 ?> 0i32 |: 1i32

