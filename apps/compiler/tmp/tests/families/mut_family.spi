///> zig
test mut_heap_heap_heap_returns_zero =
    := program () : i32 =
        := ~n = 3i32
        := ~word = "no"
        := inner_pair = n, word
        := inner = !!!!LayoutToHeap({ value = inner_pair })
        := ~extra = 1i32
        := mid_pair = inner, extra
        := mid = !!!!LayoutToHeap({ value = mid_pair })
        := ~mark = 2i32
        := outer_pair = mid, mark
        := outer = !!!!LayoutToHeap({ value = outer_pair })
        := slot : mut { value : heap { value : (heap { value : (heap { value : i32 * string }) * i32 }) * i32 } } =
            !!!!LayoutToHeapMutable({ value = outer })
        := ~m = 7i32
        := ~next = "hi"
        := next_pair = m, next
        := next_inner = !!!!LayoutToHeap({ value = next_pair })
        := ~count = 4i32
        := next_mid_pair = next_inner, count
        := next_mid = !!!!LayoutToHeap({ value = next_mid_pair })
        := ~flag = 5i32
        := next_outer_pair = next_mid, flag
        := next_outer = !!!!LayoutToHeap({ value = next_outer_pair })
        slot <- { value = next_outer }
        := opened = !!!!LayoutIndex(slot)
        := held = opened.value
        := outer_opened = !!!!LayoutIndex(held)
        := ~(mid_held, seen) = outer_opened.value
        := mid_opened = !!!!LayoutIndex(mid_held)
        := ~(inner_held, count_seen) = mid_opened.value
        := inner_opened = !!!!LayoutIndex(inner_held)
        := ~(left, right) = inner_opened.value
        ? left =. 7i32 && !!!!EQ(right, "hi") && count_seen =. 4i32 && seen =. 5i32 ?> 0i32 |: 1i32
    ? program () <> 0i32 ?> failwith "mut_heap_heap_heap"

///> c
///> zig
test mut_heap_heap_pair_returns_zero =
    := program () : i32 =
        := ~n = 1i32
        := ~word = "no"
        := left_pair = n, word
        := left_heap = !!!!LayoutToHeap({ value = left_pair })
        := ~m = 2i32
        := ~other = "zz"
        := right_pair = m, other
        := right_heap = !!!!LayoutToHeap({ value = right_pair })
        := pair = left_heap, right_heap
        := inner = !!!!LayoutToHeap({ value = pair })
        := ~mark = 3i32
        := outer_pair = inner, mark
        := outer = !!!!LayoutToHeap({ value = outer_pair })
        := slot
            : mut
                {
                    value :
                        heap
                            {
                                value :
                                    (heap { value : heap { value : i32 * string } * heap { value : i32 * string } }) *
                                    i32
                            }
                }
            =
            !!!!LayoutToHeapMutable({ value = outer })
        := ~a0 = 7i32
        := ~b0 = "hi"
        := next_left_pair = a0, b0
        := next_left = !!!!LayoutToHeap({ value = next_left_pair })
        := ~c0 = 4i32
        := ~d0 = "yo"
        := next_right_pair = c0, d0
        := next_right = !!!!LayoutToHeap({ value = next_right_pair })
        := next_pair = next_left, next_right
        := next_inner = !!!!LayoutToHeap({ value = next_pair })
        := ~flag = 2i32
        := next_outer_pair = next_inner, flag
        := next_outer = !!!!LayoutToHeap({ value = next_outer_pair })
        slot <- { value = next_outer }
        := opened = !!!!LayoutIndex(slot)
        := held = opened.value
        := outer_opened = !!!!LayoutIndex(held)
        := ~(inner_held, seen) = outer_opened.value
        := inner_opened = !!!!LayoutIndex(inner_held)
        := ~(left, right) = inner_opened.value
        := left_opened = !!!!LayoutIndex(left)
        := ~(p, q) = left_opened.value
        := right_opened = !!!!LayoutIndex(right)
        := ~(r, s) = right_opened.value
        ? p =. 7i32 && !!!!EQ(q, "hi") && r =. 4i32 && !!!!EQ(s, "yo") && seen =. 2i32 ?> 0i32 |: 1i32
    ? program () <> 0i32 ?> failwith "mut_heap_heap_pair"

:| mut_heap_union_heap_pair_heaps_slot =
    | MutHeapUnionHeapPairHeapsNone
    | MutHeapUnionHeapPairHeapsHeld :
        (heap { value : (heap { value : heap { value : i32 * string } * heap { value : i32 * string } }) * i32 })

:~ mut_heap_union_heap_pair_heaps_score x : i32 =
    ?= x ?|
    | MutHeapUnionHeapPairHeapsNone => 1i32
    | MutHeapUnionHeapPairHeapsHeld box =>
        := opened = !!!!LayoutIndex(box)
        := ~(inner_held, flag) = opened.value
        := inner_opened = !!!!LayoutIndex(inner_held)
        := ~(left, right) = inner_opened.value
        := left_opened = !!!!LayoutIndex(left)
        := ~(a, b) = left_opened.value
        := right_opened = !!!!LayoutIndex(right)
        := ~(c, d) = right_opened.value
        ? a =. 7i32 && !!!!EQ(b, "hi") && c =. 4i32 && !!!!EQ(d, "yo") && flag =. 2i32 ?> 0i32 |: 1i32

