test mut_heap_union3_both_heap_union_heap_union_heap_pair_heaps_returns_zero =
    := program () : i32 =
        := ~n = 7i32
        := ~word = "hi"
        := left_pair = n, word
        := left_heap = !!!!LayoutToHeap({ value = left_pair })
        := ~m = 4i32
        := ~other = "yo"
        := right_pair = m, other
        := right_heap = !!!!LayoutToHeap({ value = right_pair })
        := pair = left_heap, right_heap
        := inner = !!!!LayoutToHeap({ value = pair })
        := ~mark = 2i32
        := outer_pair = inner, mark
        := outer = !!!!LayoutToHeap({ value = outer_pair })
        := ~on = !+
        := held =
            ? on
            ?> MutHeapUnion3BothHeapUnionHeapUnionHeapPairHeapsHeld outer
            |: MutHeapUnion3BothHeapUnionHeapUnionHeapPairHeapsNone
        := box = !!!!LayoutToHeap({ value = held })
        := ~use_box = !+
        := wrapped =
            ? use_box
            ?> MutHeapUnion3BothHeapUnionHeapUnionHeapPairHeapsBox box
            |: MutHeapUnion3BothHeapUnionHeapUnionHeapPairHeapsMark 1i32
        := ~tag = 3i32
        := marked = MutHeapUnion3BothHeapUnionHeapUnionHeapPairHeapsMark tag
        := cover_box = !!!!LayoutToHeap({ value = wrapped })
        := cover_mark = !!!!LayoutToHeap({ value = marked })
        := cell : mut { value : heap { value : mut_heap_union3_both_heap_union_heap_union_heap_pair_heaps_wrap } } =
            !!!!LayoutToHeapMutable({ value = cover_box })
        := before = !!!!LayoutIndex(cell)
        := before_heap = before.value
        := before_opened = !!!!LayoutIndex(before_heap)
        := before_score = mut_heap_union3_both_heap_union_heap_union_heap_pair_heaps_score before_opened.value
        cell <- { value = cover_mark }
        := after = !!!!LayoutIndex(cell)
        := after_heap = after.value
        := after_opened = !!!!LayoutIndex(after_heap)
        := after_score = mut_heap_union3_both_heap_union_heap_union_heap_pair_heaps_score after_opened.value
        ? before_score =. 0i32 && after_score =. 1i32 ?> 0i32 |: 1i32
    ? program () <> 0i32 ?> failwith "mut_heap_union3_both_heap_union_heap_union_heap_pair_heaps"

