let scalar () : i32 = 7i32
inl (~!\) forall t u. ((args : t), (code : string)) : u =
    $'Fable.Core.RustInterop.emitRustExpr !args !code '
let opaque (~value : string) : u64 =
    !\(value, $'"$0.len() as u64"')
let unused (value : string) : string = "ignored"
let choose (first : i32) (second : i32) : i32 =
    if !!!!LT(first,second) then first else second
let echo (value : string) : string = value
let size (value : string) : u64 = !!!!StringLength(`u64,value)
let five (value : string) : string * string * string * string * string =
    value, "second", "", "fourth", "fifth"
let ordered (first : string) (second : string) (third : string) (fourth : string) (fifth : string) : u64 =
    if !!!!NEQ(!!!!StringLength(`u64,first),1u64) then 1u64
    elif !!!!NEQ(!!!!StringLength(`u64,second),2u64) then 2u64
    elif !!!!NEQ(!!!!StringLength(`u64,third),3u64) then 3u64
    elif !!!!NEQ(!!!!StringLength(`u64,fourth),4u64) then 4u64
    elif !!!!NEQ(!!!!StringLength(`u64,fifth),5u64) then 5u64
    else 18446744073709551615u64

inl main () : i32 =
    inl _ = scalar ()
    inl _ = opaque "retained"
    inl _ = unused "retained"
    inl _ = choose 1i32 2i32
    inl _ = echo "retained"
    inl _ = size "retained"
    inl _ = five "retained"
    inl _ = ordered "a" "bb" "ccc" "dddd" "eeeee"
    $"RustExportI32(\"export_scalar\",\"scalar\")" : ()
    $"RustExportU64Unary(\"export_opaque\",\"opaque\")" : ()
    $"RustExportI32Binary(\"export_choose\",\"choose\")" : ()
    $"RustExportStringUnary(\"export_echo\",\"echo\")" : ()
    $"RustExportU64Unary(\"export_size\",\"size\")" : ()
    $"RustExportStringTuple5Unary(\"export_five\",\"five\")" : ()
    $"RustExportU64String5(\"export_ordered\",\"ordered\")" : ()
    $"RustLibrary()" : ()
    0i32
