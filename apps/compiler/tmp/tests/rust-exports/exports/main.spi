:~ scalar () : i32 = 7i32
:~ opaque (~value : string) : u64 = $"!value.len() as u64" : u64
:~ unused (value : string) : string = "ignored"
:~ choose (first : i32) (second : i32) : i32 =
    ? !!!!LT(first, second) ?> first |: second
:~ echo (value : string) : string = value
:~ size (value : string) : u64 = !!!!StringLength(`u64, value)
:~ five (value : string) : string * string * string * string * string =
    value, "second", "", "fourth", "fifth"
:~ ordered (first : string) (second : string) (third : string) (fourth : string) (fifth : string) : u64 =
    ? !!!!NEQ(!!!!StringLength(`u64, first), 1u64) ?> 1u64
    |? !!!!NEQ(!!!!StringLength(`u64, second), 2u64) ?> 2u64
    |? !!!!NEQ(!!!!StringLength(`u64, third), 3u64) ?> 3u64
    |? !!!!NEQ(!!!!StringLength(`u64, fourth), 4u64) ?> 4u64
    |? !!!!NEQ(!!!!StringLength(`u64, fifth), 5u64) ?> 5u64
    |: 18446744073709551615u64

:= export \* t. (name : string) (f : t) : () = !!!!Export(name, f)

:= main () : i32 =
    export "export_scalar" ((\ () => scalar ()) : () -> i32)
    export "export_opaque" ((\ value => opaque value) : string -> u64)
    export "export_choose" ((\ (first, second) => choose first second) : i32 * i32 -> i32)
    export "export_echo" ((\ value => echo value) : string -> string)
    export "export_size" ((\ value => size value) : string -> u64)
    export "export_five" ((\ value => five value) : string -> string * string * string * string * string)
    export
        "export_ordered"
        ((\ (a, b, c, d, e) => ordered a b c d e) : string * string * string * string * string -> u64)
    0i32
