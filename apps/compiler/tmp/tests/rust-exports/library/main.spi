:~ admitted (value : i32) (reserved : i32) : i32 =
    ? !!!!NEQ(reserved, 0i32) ?> 0i32
    |? !!!!LT(value, 0i32) ?> 0i32
    |? !!!!LT(4095i32, value) ?> 0i32
    |: 1i32

:= main () : i32 =
    !!!!Export("export_admitted", ((\ (value, reserved) => admitted value reserved) : i32 * i32 -> i32))
    0i32
