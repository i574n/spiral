nominal agile_progress = i32

union agile_status =
    | AgilePlanned
    | AgileActive
    | AgileBlocked
    | AgilePaused
    | AgileDone

inl i32_eq a b : bool = $"!a == !b"
inl i32_le a b : bool = $"!a <= !b"
inl i32_nonnegative value : bool = $"0 <= !value"

inl agile_status_code status : i32 =
    match status with
    | AgilePlanned => 0i32
    | AgileActive => 1i32
    | AgileBlocked => 2i32
    | AgilePaused => 3i32
    | AgileDone => 4i32

inl agile_status_code_valid code : bool =
    if i32_eq code 0i32 then true
    elif i32_eq code 1i32 then true
    elif i32_eq code 2i32 then true
    elif i32_eq code 3i32 then true
    elif i32_eq code 4i32 then true
    else false

inl agile_progress_valid value : bool =
    if i32_nonnegative value then i32_le value 100i32 else false

let agile_set_decision (progress : i32) (status_code : i32) : i32 =
    if agile_progress_valid progress then
        if agile_status_code_valid status_code then 1i32 else 0i32
    else 0i32

let agile_task_shape_decision (field_count : i32) : i32 =
    if i32_eq field_count 11i32 then 1i32 else 0i32

let agile_task_identity_decision (field_count : i32) (id_equal : i32) : i32 =
    if i32_eq (agile_task_shape_decision field_count) 1i32 then
        if i32_eq id_equal 1i32 then 1i32 else 0i32
    else 0i32

let agile_receipt_content_decision (bytes_equal : i32) (fingerprint_equal : i32) : i32 =
    if i32_eq bytes_equal 1i32 then
        if i32_eq fingerprint_equal 1i32 then 1i32 else 0i32
    else 0i32

let agile_receipt_snapshot_decision (snapshot_equal : i32) (reserved : i32) : i32 =
    if i32_eq reserved 0i32 then
        if i32_eq snapshot_equal 1i32 then 1i32 else 0i32
    else 0i32

let agile_receipt_build_current_decision (content_current : i32) (build_fingerprint_equal : i32) : i32 =
    if i32_eq content_current 1i32 then
        if i32_eq build_fingerprint_equal 1i32 then 1i32 else 0i32
    else 0i32

inl agile_tuple_space (value : char) : bool =
    if (=.) value ' ' then true else (=.) value (char_tab ())

let rec agile_tuple_trim_right (text : string) (near_to : i32) : i32 =
    if (=.) near_to 0i32 then 0i32
    else
        inl before = (-.) near_to 1i32
        if agile_tuple_space (sm.index text before) then agile_tuple_trim_right text before else near_to

inl agile_tuple_trim (text : string) : string =
    inl from = skip_spaces text 0i32
    inl near_to = agile_tuple_trim_right text (sm.length text : i32)
    if (<) near_to from then codec_empty () else slice_exclusive text from near_to

let rec agile_tuple_parse_loop (input : string) (at : i32) (input_len : i32) (field_from : i32) (quoted : bool) (escaped : bool) (out : string) : string =
    if (=.) at input_len then
        if quoted then codec_empty ()
        elif escaped then codec_empty ()
        else
            inl field = agile_tuple_trim (slice_exclusive input field_from input_len)
            sm.concat out (sm.concat field "\n")
    else
        inl current_char = sm.index input at
        if quoted then
            if escaped then
                agile_tuple_parse_loop input ((+.) at 1i32) input_len field_from true false out
            elif (=.) current_char (char_backslash ()) then
                agile_tuple_parse_loop input ((+.) at 1i32) input_len field_from true true out
            elif (=.) current_char (char_quote ()) then
                agile_tuple_parse_loop input ((+.) at 1i32) input_len field_from false false out
            else
                agile_tuple_parse_loop input ((+.) at 1i32) input_len field_from true false out
        elif (=.) current_char (char_quote ()) then
            agile_tuple_parse_loop input ((+.) at 1i32) input_len field_from true false out
        elif (=.) current_char ',' then
            inl field = agile_tuple_trim (slice_exclusive input field_from at)
            agile_tuple_parse_loop input ((+.) at 1i32) input_len ((+.) at 1i32) false false (sm.concat out (sm.concat field "\n"))
        else
            agile_tuple_parse_loop input ((+.) at 1i32) input_len field_from false false out

let agile_tuple_parse (input : string) : string =
    agile_tuple_parse_loop input 0i32 (sm.length input : i32) 0i32 false false ""

inl agile_build_prefix (input : string) : bool =
    starts_with input "build:"

let agile_u64_decimal_normalize (input : string) : string =
    codec_u64_decimal_normalize (agile_tuple_trim input)

let agile_u64_decimal_value (input : string) : u64 =
    codec_u64_decimal_value (agile_u64_decimal_normalize input)

let agile_u64_literal_normalize (input : string) : string =
    inl input = agile_tuple_trim input
    inl input_len = sm.length input : i32
    if (<) input_len 4i32 then codec_empty ()
    else
        inl suffix_from = (-.) input_len 3i32
        if (=.) (sm.index input suffix_from) 'u' then
            if (=.) (sm.index input ((+.) suffix_from 1i32)) '6' then
                if (=.) (sm.index input ((+.) suffix_from 2i32)) '4' then
                    codec_u64_decimal_normalize (slice_exclusive input 0i32 suffix_from)
                else codec_empty ()
            else codec_empty ()
        else codec_empty ()

let agile_u64_literal_value (input : string) : u64 =
    codec_u64_decimal_value (agile_u64_literal_normalize input)

let agile_attestation_normalize (input : string) : string =
    inl input_len = sm.length input : i32
    if (=.) input "runtime" then "runtime"
    elif agile_build_prefix input then
        inl digits = codec_u64_decimal_normalize (slice_exclusive input 6i32 input_len)
        if (=.) digits "" then codec_empty () else sm.concat "build:" digits
    else codec_empty ()

let agile_attestation_value (input : string) : u64 =
    inl normalized = agile_attestation_normalize input
    inl normalized_len = sm.length normalized : i32
    if (=.) normalized "runtime" then 0u64
    elif agile_build_prefix normalized then
        codec_u64_decimal_value (slice_exclusive normalized 6i32 normalized_len)
    else 0u64
