inl rust_global (x : string) : () = real typecase `(!!!!LitToTypeLit(x)) with ~x => $"RustGlobal(@x)" : ()
inl rust_library () : () = $"RustLibrary()" : ()

inl main () : i32 =
    rust_global "#![allow(clippy::needless_late_init)]"
    inl _ = deflate_extract_plan ()
    inl _ = archive_preflight_binding 1i32 1i32
    inl _ = archive_entry_binding 1i32 1i32
    inl _ = archive_tar_symlink_binding 1i32 1i32
    inl _ = archive_tar_hardlink_binding 1i32 1i32
    inl _ = archive_tar_long_link_binding 1i32 1i32
    inl _ = archive_tar_pax_path_binding 1i32 1i32
    inl _ = archive_compression_binding 1i32 1i32
    inl _ = archive_budget_binding 1024i32 512i32
    inl _ = archive_complete_binding 2i32 2i32
    inl _ = archive_tree_binding 1i32 1i32
    inl _ = archive_format_code TarXzArchive
    inl _ = archive_format_binding 3i32 1i32
    inl _ = archive_fault_code NoArchiveFault
    inl _ = archive_fault_binding 1i32 1i32
    archive_terminal.emit_runtime ()
    $"RustExportI32Binary(\"eoie_archive_preflight_binding\",\"archive_preflight_binding\")" : ()
    $"RustExportI32Binary(\"eoie_archive_entry_binding\",\"archive_entry_binding\")" : ()
    $"RustExportI32Binary(\"eoie_archive_tar_symlink_binding\",\"archive_tar_symlink_binding\")" : ()
    $"RustExportI32Binary(\"eoie_archive_tar_hardlink_binding\",\"archive_tar_hardlink_binding\")" : ()
    $"RustExportI32Binary(\"eoie_archive_tar_long_link_binding\",\"archive_tar_long_link_binding\")" : ()
    $"RustExportI32Binary(\"eoie_archive_tar_pax_path_binding\",\"archive_tar_pax_path_binding\")" : ()
    $"RustExportI32Binary(\"eoie_archive_compression_binding\",\"archive_compression_binding\")" : ()
    $"RustExportI32Binary(\"eoie_archive_budget_binding\",\"archive_budget_binding\")" : ()
    $"RustExportI32Binary(\"eoie_archive_complete_binding\",\"archive_complete_binding\")" : ()
    $"RustExportI32Binary(\"eoie_archive_tree_binding\",\"archive_tree_binding\")" : ()
    $"RustExportI32Binary(\"eoie_archive_format_binding\",\"archive_format_binding\")" : ()
    $"RustExportI32Binary(\"eoie_archive_fault_binding\",\"archive_fault_binding\")" : ()
    rust_library ()
    0i32
