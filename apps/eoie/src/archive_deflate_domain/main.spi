inl rust_global (x : string) : () = !!!!Global(x)

inl main () : i32 =
    rust_global "#![allow(clippy::needless_late_init)]"
    inl _ = deflate_extract_plan ()
    inl _ = archive_preflight_binding 1i32 1i32
    inl _ = archive_entry_binding 1i32 1i32
    inl _ = archive_tar_symlink_binding 1i32 1i32
    inl _ = archive_tar_hardlink_binding 1i32 1i32
    inl _ = archive_tar_long_link_binding 1i32 1i32
    inl _ = archive_tar_pax_path_binding 1i32 1i32
    inl _ = archive_compression_binding 1i32 1i32
    inl _ = archive_budget_binding 1024i32 512i32
    inl _ = archive_complete_binding 2i32 2i32
    inl _ = archive_tree_binding 1i32 1i32
    inl _ = archive_format_code TarXzArchive
    inl _ = archive_format_binding 3i32 1i32
    inl _ = archive_fault_code NoArchiveFault
    inl _ = archive_fault_binding 1i32 1i32
    archive_terminal.emit_runtime ()
    !!!!Export("eoie_archive_preflight_binding", ((fun (first, second) => archive_preflight_binding first second) : i32 * i32 -> i32))
    !!!!Export("eoie_archive_entry_binding", ((fun (first, second) => archive_entry_binding first second) : i32 * i32 -> i32))
    !!!!Export("eoie_archive_tar_symlink_binding", ((fun (first, second) => archive_tar_symlink_binding first second) : i32 * i32 -> i32))
    !!!!Export("eoie_archive_tar_hardlink_binding", ((fun (first, second) => archive_tar_hardlink_binding first second) : i32 * i32 -> i32))
    !!!!Export("eoie_archive_tar_long_link_binding", ((fun (first, second) => archive_tar_long_link_binding first second) : i32 * i32 -> i32))
    !!!!Export("eoie_archive_tar_pax_path_binding", ((fun (first, second) => archive_tar_pax_path_binding first second) : i32 * i32 -> i32))
    !!!!Export("eoie_archive_compression_binding", ((fun (first, second) => archive_compression_binding first second) : i32 * i32 -> i32))
    !!!!Export("eoie_archive_budget_binding", ((fun (first, second) => archive_budget_binding first second) : i32 * i32 -> i32))
    !!!!Export("eoie_archive_complete_binding", ((fun (first, second) => archive_complete_binding first second) : i32 * i32 -> i32))
    !!!!Export("eoie_archive_tree_binding", ((fun (first, second) => archive_tree_binding first second) : i32 * i32 -> i32))
    !!!!Export("eoie_archive_format_binding", ((fun (first, second) => archive_format_binding first second) : i32 * i32 -> i32))
    !!!!Export("eoie_archive_fault_binding", ((fun (first, second) => archive_fault_binding first second) : i32 * i32 -> i32))
    0i32
