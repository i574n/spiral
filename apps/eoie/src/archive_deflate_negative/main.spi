inl rust_global (x : string) : () = !!!!Global(x)

union archive_negative_fixture =
    | MissingArchive
    | ExistingDestination
    | UnsafeEntry
    | UnsupportedCompression
    | BudgetExceeded
    | CountMismatch
    | UnsafeTree

inl main () : i32 =
    rust_global "#![allow(clippy::needless_late_init)]"
    inl _ = archive_deflate_domain.deflate_extract_plan ()
    inl missing_archive = archive_deflate_domain.archive_preflight_binding 0i32 1i32
    inl existing_destination = archive_deflate_domain.archive_preflight_binding 1i32 0i32
    inl unsafe_entry = archive_deflate_domain.archive_entry_binding 0i32 1i32
    inl escaping_tar_symlink = archive_deflate_domain.archive_tar_symlink_binding 0i32 1i32
    inl payload_tar_symlink = archive_deflate_domain.archive_tar_symlink_binding 1i32 0i32
    inl missing_tar_hardlink = archive_deflate_domain.archive_tar_hardlink_binding 0i32 1i32
    inl payload_tar_hardlink = archive_deflate_domain.archive_tar_hardlink_binding 1i32 0i32
    inl oversized_tar_long_link = archive_deflate_domain.archive_tar_long_link_binding 0i32 1i32
    inl non_utf8_tar_long_link = archive_deflate_domain.archive_tar_long_link_binding 1i32 0i32
    inl unsafe_tar_pax_path = archive_deflate_domain.archive_tar_pax_path_binding 0i32 1i32
    inl unsupported_tar_pax_record = archive_deflate_domain.archive_tar_pax_path_binding 1i32 0i32
    inl unsupported_compression = archive_deflate_domain.archive_compression_binding 1i32 0i32
    inl budget_exceeded = archive_deflate_domain.archive_budget_binding 5i32 10i32
    inl count_mismatch = archive_deflate_domain.archive_complete_binding 2i32 1i32
    inl unsafe_tree = archive_deflate_domain.archive_tree_binding 1i32 0i32
    inl unsupported_format = archive_deflate_domain.archive_format_binding 5i32 1i32
    inl missing_tool = archive_deflate_domain.archive_format_binding 3i32 0i32
    if !!!!LT(0i32,missing_archive) then 1i32
    elif !!!!LT(0i32,existing_destination) then 1i32
    elif !!!!LT(0i32,unsafe_entry) then 1i32
    elif !!!!LT(0i32,escaping_tar_symlink) then 1i32
    elif !!!!LT(0i32,payload_tar_symlink) then 1i32
    elif !!!!LT(0i32,missing_tar_hardlink) then 1i32
    elif !!!!LT(0i32,payload_tar_hardlink) then 1i32
    elif !!!!LT(0i32,oversized_tar_long_link) then 1i32
    elif !!!!LT(0i32,non_utf8_tar_long_link) then 1i32
    elif !!!!LT(0i32,unsafe_tar_pax_path) then 1i32
    elif !!!!LT(0i32,unsupported_tar_pax_record) then 1i32
    elif !!!!LT(0i32,unsupported_compression) then 1i32
    elif !!!!LT(0i32,budget_exceeded) then 1i32
    elif !!!!LT(0i32,count_mismatch) then 1i32
    elif !!!!LT(0i32,unsafe_tree) then 1i32
    elif !!!!LT(0i32,unsupported_format) then 1i32
    elif !!!!LT(0i32,missing_tool) then 1i32
    else 0i32
