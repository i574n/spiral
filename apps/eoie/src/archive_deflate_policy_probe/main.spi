inl rust_global (x : string) : () = real
    typecase `(!!!!LitToTypeLit(x)) with ~x =>
    $"RustGlobal(@x)" : ()

inl main () : i32 =
    rust_global "#![allow(clippy::needless_late_init)]"
    inl _ = archive_deflate_domain.deflate_extract_plan ()
    inl preflight = archive_deflate_domain.archive_preflight_binding 1i32 1i32
    inl entry = archive_deflate_domain.archive_entry_binding 1i32 1i32
    inl tar_symlink = archive_deflate_domain.archive_tar_symlink_binding 1i32 1i32
    inl tar_hardlink = archive_deflate_domain.archive_tar_hardlink_binding 1i32 1i32
    inl tar_long_link = archive_deflate_domain.archive_tar_long_link_binding 1i32 1i32
    inl tar_pax_path = archive_deflate_domain.archive_tar_pax_path_binding 1i32 1i32
    inl compression = archive_deflate_domain.archive_compression_binding entry 1i32
    inl budget = archive_deflate_domain.archive_budget_binding 4096i32 2048i32
    inl complete = archive_deflate_domain.archive_complete_binding 2i32 2i32
    inl tree = archive_deflate_domain.archive_tree_binding complete 1i32
    inl format = archive_deflate_domain.archive_format_binding (archive_deflate_domain.archive_format_code archive_deflate_domain.TarXzArchive) 1i32
    if !!!!LT(preflight,1i32) then 1i32
    elif !!!!LT(tar_symlink,1i32) then 1i32
    elif !!!!LT(tar_hardlink,1i32) then 1i32
    elif !!!!LT(tar_long_link,1i32) then 1i32
    elif !!!!LT(tar_pax_path,1i32) then 1i32
    elif !!!!LT(compression,1i32) then 1i32
    elif !!!!LT(budget,1i32) then 1i32
    elif !!!!LT(tree,1i32) then 1i32
    elif !!!!LT(format,1i32) then 1i32
    else 0i32
