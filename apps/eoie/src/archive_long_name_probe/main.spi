open rust_std_env.model
open rust_std_process.model
open rust_std_fs.model
open rust_std_fs.rooted_effects

nominal probe_start = ()
nominal probe_source_ready = ()
nominal probe_archive_ready = ()
nominal probe_extracted = ()
nominal probe_verified = ()

union archive_long_name_probe from to =
    | PrepareSource :: archive_long_name_probe probe_start probe_source_ready
    | BuildGnuTar :: archive_long_name_probe probe_source_ready probe_archive_ready
    | ExtractWithEoie :: archive_long_name_probe probe_archive_ready probe_extracted
    | VerifyPayload :: archive_long_name_probe probe_extracted probe_verified

inl main () : i32 =
    inl eoie = argument_owned 0i32
    inl base = "/mnt/data/eoie-archive-long-name-probe"
    inl source = "/mnt/data/eoie-archive-long-name-probe/source"
    inl archive = "/mnt/data/eoie-archive-long-name-probe/fixture.tar"
    inl extracted = "/mnt/data/eoie-archive-long-name-probe/extracted"
    inl long_path = "/mnt/data/eoie-archive-long-name-probe/source/aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.txt"
    inl extracted_long_path = "/mnt/data/eoie-archive-long-name-probe/extracted/aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.txt"
    inl _ = cleanup_tree base
    inl _ : archive_long_name_probe probe_start probe_source_ready = PrepareSource
    if create_dir source && write_text long_path "ok" then
        inl _ : archive_long_name_probe probe_source_ready probe_archive_ready = BuildGnuTar
        inl tar_code = status_code5 "/bin/tar" "--format=gnu" "-cf" archive "--directory=/mnt/data/eoie-archive-long-name-probe/source" "."
        if !!!!EQ(tar_code,0i32) then
            inl _ : archive_long_name_probe probe_archive_ready probe_extracted = ExtractWithEoie
            inl extract_code = status_code4 eoie "proxy" "archive-extract" archive extracted
            if !!!!EQ(extract_code,0i32) then
                inl _ : archive_long_name_probe probe_extracted probe_verified = VerifyPayload
                inl verified = text_equals "ok" extracted_long_path
                inl _ = cleanup_tree base
                if verified then 0i32 else 31i32
            else 21i32
        else 11i32
    else 1i32
