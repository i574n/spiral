inl main () : i32 =
    inl _ = authority_state_binding 28i32 0i32
    inl _ = authority_live_mask_binding 3i32 0i32
    inl _ = authority_declared_mask_binding 0i32 0i32
    inl _ = authority_blocker_bit_binding 4i32 0i32
    inl _ = authority_blocker_labels "v1"
    !!!!Export("eoie_authority_state", ((fun (first, second) => authority_state_binding first second) : i32 * i32 -> i32))
    !!!!Export("eoie_authority_declared_mask", ((fun (first, second) => authority_declared_mask_binding first second) : i32 * i32 -> i32))
    !!!!Export("eoie_authority_live_mask", ((fun (first, second) => authority_live_mask_binding first second) : i32 * i32 -> i32))
    !!!!Export("eoie_authority_blocker_bit", ((fun (first, second) => authority_blocker_bit_binding first second) : i32 * i32 -> i32))
    !!!!Export("eoie_authority_blocker_labels", ((fun value => authority_blocker_labels value) : string -> string * string * string * string * string))
    0i32
