nominal binary_install_raw = ()
nominal binary_install_inspected = ()
nominal binary_install_staged = ()
nominal binary_install_verified = ()
nominal binary_install_promoted = ()
nominal binary_install_recorded = ()

union binary_install_policy =
    | RejectUnsafeInstallPath
    | RejectStaleInstallSource
    | RejectStaleInstallDestination
    | RejectStaleInstallProvenance
    | RejectNonExecutableMode
    | RejectPreviewMutation
    | RejectRunningExecutableDestination
    | AuthorizeStagedPromotion
    | RollbackFailedPromotion
    | RecordTypedProvenance

union binary_install_op from to =
    | InspectBinaryInstall :: binary_install_op binary_install_raw binary_install_inspected
    | StageBinaryPayload :: binary_install_op binary_install_inspected binary_install_staged
    | VerifyBinaryStage :: binary_install_op binary_install_staged binary_install_verified
    | PromoteBinaryStage :: binary_install_op binary_install_verified binary_install_promoted
    | PersistBinaryProvenance :: binary_install_op binary_install_promoted binary_install_recorded

union rec binary_install_plan from to =
    | BinaryInstallStep :: forall from to. binary_install_op from to -> binary_install_plan from to
    | BinaryInstallThen :: forall from to. (exists middle. binary_install_plan from middle * binary_install_plan middle to) -> binary_install_plan from to

inl binary_install_public_plan () : binary_install_plan binary_install_raw binary_install_recorded =
    BinaryInstallThen (exists (
        BinaryInstallStep InspectBinaryInstall,
        BinaryInstallThen (exists (
            BinaryInstallStep StageBinaryPayload,
            BinaryInstallThen (exists (
                BinaryInstallStep VerifyBinaryStage,
                BinaryInstallThen (exists (
                    BinaryInstallStep PromoteBinaryStage,
                    BinaryInstallStep PersistBinaryProvenance
                ))
            ))
        ))
    ))
