open binary_install_contract.bindings

inl main () : i32 =
    match binary_install_shape_binding 0i32 1i32 with
    | 0 =>
        match binary_install_shape_binding 1i32 0i32 with
        | 0 =>
            match binary_install_source_binding 0i32 3i32 with
            | 0 =>
                match binary_install_source_binding 1i32 2i32 with
                | 0 =>
                    match binary_install_freshness_binding 0i32 1i32 with
                    | 0 =>
                        match binary_install_running_destination_binding 1i32 1i32 with
                        | 0 =>
                            match binary_install_permission_binding 1i32 0i32 with
                            | 0 =>
                                match binary_install_mode_binding 0i32 1i32 with
                                | 0 =>
                                    match binary_install_mode_binding 1i32 3i32 with
                                    | 0 =>
                                        match binary_install_commit_binding 1i32 3i32 with
                                        | 0 => 0i32
                                        | _ => 10i32
                                    | _ => 9i32
                                | _ => 8i32
                            | _ => 7i32
                        | _ => 6i32
                    | _ => 5i32
                | _ => 4i32
            | _ => 3i32
        | _ => 2i32
    | _ => 1i32
