nominal filesystem_evidence = bool
nominal process_evidence = bool
nominal toolchain_evidence = bool
nominal bootstrap_contract = filesystem_evidence * process_evidence * toolchain_evidence

inl build_plan
    (filesystem_ok : bool)
    (process_ok : bool)
    (toolchain_ok : bool)
    : bootstrap_contract =
    bootstrap_contract (
        filesystem_evidence filesystem_ok,
        process_evidence process_ok,
        toolchain_evidence toolchain_ok)

inl terminal
    (bootstrap_contract (
        filesystem_evidence filesystem_ok,
        process_evidence process_ok,
        toolchain_evidence toolchain_ok))
    : bool =
    filesystem_ok && process_ok && toolchain_ok

inl policy_plan filesystem_ok process_ok toolchain_ok =
    build_plan filesystem_ok process_ok toolchain_ok

inl agile_plan filesystem_ok process_ok toolchain_ok =
    build_plan filesystem_ok process_ok toolchain_ok

nominal bootstrap_seed_bundle_only = ()
nominal bootstrap_seed_flat_extracted = ()
nominal bootstrap_seed_candidate_verified = ()
nominal bootstrap_seed_installed = ()
nominal bootstrap_seed_canonical_verified = ()

union bootstrap_seed_op from to =
    | BootstrapExtractFlat :: bootstrap_seed_op bootstrap_seed_bundle_only bootstrap_seed_flat_extracted
    | BootstrapVerifyCandidate :: bootstrap_seed_op bootstrap_seed_flat_extracted bootstrap_seed_candidate_verified
    | BootstrapInstallCandidate :: bootstrap_seed_op bootstrap_seed_candidate_verified bootstrap_seed_installed
    | BootstrapVerifyCanonical :: bootstrap_seed_op bootstrap_seed_installed bootstrap_seed_canonical_verified

union rec bootstrap_seed_plan from to =
    | BootstrapSeedStep :: forall from to. bootstrap_seed_op from to -> bootstrap_seed_plan from to
    | BootstrapSeedThen :: forall from to. (exists middle. bootstrap_seed_plan from middle * bootstrap_seed_plan middle to) -> bootstrap_seed_plan from to

inl bootstrap_seed_complete_plan () : bootstrap_seed_plan bootstrap_seed_bundle_only bootstrap_seed_canonical_verified =
    BootstrapSeedThen (exists (
        BootstrapSeedStep BootstrapExtractFlat,
        BootstrapSeedThen (exists (
            BootstrapSeedStep BootstrapVerifyCandidate,
            BootstrapSeedThen (exists (
                BootstrapSeedStep BootstrapInstallCandidate,
                BootstrapSeedStep BootstrapVerifyCanonical
            ))
        ))
    ))

union bootstrap_seed_route =
    | BootstrapUnzipSeed
    | BootstrapFallbackBinarySeed
    | BootstrapPreexistingCandidateSeed

inl bootstrap_seed_route_code = function
    | BootstrapUnzipSeed => 0i32
    | BootstrapFallbackBinarySeed => 1i32
    | BootstrapPreexistingCandidateSeed => 2i32

let bootstrap_seed_preflight_binding (bundle_only : i32) (fallback_present : i32) (candidate_present : i32) (route : i32) : i32 =
    if !!!!LT(bundle_only,1i32) then 0i32
    elif !!!!LT(1i32,bundle_only) then 0i32
    elif !!!!LT(fallback_present,0i32) then 0i32
    elif !!!!LT(0i32,fallback_present) then 0i32
    elif !!!!LT(candidate_present,0i32) then 0i32
    elif !!!!LT(0i32,candidate_present) then 0i32
    elif !!!!LT(route,0i32) then 0i32
    elif !!!!LT(0i32,route) then 0i32
    else 1i32

let bootstrap_seed_extract_binding (flat_root : i32) (public_binary : i32) (bundle_check : i32) : i32 =
    if !!!!LT(flat_root,1i32) then 0i32
    elif !!!!LT(1i32,flat_root) then 0i32
    elif !!!!LT(public_binary,1i32) then 0i32
    elif !!!!LT(1i32,public_binary) then 0i32
    elif !!!!LT(bundle_check,1i32) then 0i32
    elif !!!!LT(1i32,bundle_check) then 0i32
    else 1i32

let bootstrap_seed_install_binding (candidate_status : i32) (install_self : i32) (canonical_status : i32) : i32 =
    if !!!!LT(candidate_status,1i32) then 0i32
    elif !!!!LT(1i32,candidate_status) then 0i32
    elif !!!!LT(install_self,1i32) then 0i32
    elif !!!!LT(1i32,install_self) then 0i32
    elif !!!!LT(canonical_status,1i32) then 0i32
    elif !!!!LT(1i32,canonical_status) then 0i32
    else 1i32

let bootstrap_seed_rollback_binding (fault_observed : i32) (hash_restored : i32) (canonical_status : i32) : i32 =
    if !!!!LT(fault_observed,1i32) then 0i32
    elif !!!!LT(1i32,fault_observed) then 0i32
    elif !!!!LT(hash_restored,1i32) then 0i32
    elif !!!!LT(1i32,hash_restored) then 0i32
    elif !!!!LT(canonical_status,1i32) then 0i32
    elif !!!!LT(1i32,canonical_status) then 0i32
    else 1i32
