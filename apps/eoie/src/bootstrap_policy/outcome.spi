nominal process_idle_state = ()
nominal process_running_state = ()
nominal process_complete_state = ()
nominal process_timeout_state = ()
nominal process_rejected_state = ()
nominal process_terminated_state = ()
nominal process_stream_captured_state = ()

nominal process_exit_code = i32
nominal process_elapsed_ms = u64
nominal process_timeout_ms = u64
nominal process_stream_word = u64

union bounded_process_event from to =
    | ProcessSpawned :: bounded_process_event process_idle_state process_running_state
    | ProcessSucceeded :: process_elapsed_ms -> bounded_process_event process_running_state process_complete_state
    | ProcessExited :: process_exit_code * process_elapsed_ms -> bounded_process_event process_running_state process_complete_state
    | ProcessTimedOut :: process_timeout_ms * process_elapsed_ms -> bounded_process_event process_running_state process_timeout_state
    | ProcessSpawnRejected :: bounded_process_event process_idle_state process_rejected_state
    | ProcessTerminated :: process_elapsed_ms -> bounded_process_event process_running_state process_terminated_state
    | ProcessStreamsCaptured :: process_stream_word -> bounded_process_event process_running_state process_stream_captured_state

nominal bounded_process_receipt from to = bounded_process_event from to

inl i32_eq (~a : i32) (~b : i32) : bool = $"!a == !b"
inl u64_eq (~a : u64) (~b : u64) : bool = $"!a == !b"
inl u64_gte (~a : u64) (~b : u64) : bool = $"!a >= !b"
inl u64_lte (~a : u64) (~b : u64) : bool = $"!a <= !b"
inl all2 a b = if a then b else false
inl all3 a b c = if a then if b then c else false else false
inl all4 a b c d = if a then if b then if c then d else false else false else false
inl all5 a b c d e = if a then if b then if c then if d then e else false else false else false else false

inl stream_receipt ~word : bounded_process_receipt process_running_state process_stream_captured_state =
    bounded_process_receipt (ProcessStreamsCaptured (process_stream_word word))

inl stream_word (bounded_process_receipt event : bounded_process_receipt process_running_state process_stream_captured_state) : u64 =
    match event with
    | ProcessStreamsCaptured (process_stream_word word) => word

inl stream_word_exit_code (~word : u64) : u64 =
    $"!word & 255u64"

inl stream_exit_code receipt : u64 =
    inl word = stream_word receipt
    stream_word_exit_code word

inl stream_stdout_len receipt : u64 =
    inl ~word = stream_word receipt
    $"(!word >> 8) & 65535u64"

inl stream_stderr_len receipt : u64 =
    inl ~word = stream_word receipt
    $"(!word >> 24) & 65535u64"

inl stdout_capture_ok receipt : bool =
    all3
        (u64_eq (stream_exit_code receipt) 0u64)
        (u64_eq (stream_stdout_len receipt) 8u64)
        (u64_eq (stream_stderr_len receipt) 0u64)

inl stderr_capture_ok receipt : bool =
    all3
        (u64_eq (stream_exit_code receipt) 2u64)
        (u64_eq (stream_stdout_len receipt) 0u64)
        (u64_gte (stream_stderr_len receipt) 1u64)

inl spawned_receipt () : bounded_process_receipt process_idle_state process_running_state =
    bounded_process_receipt ProcessSpawned

inl success_receipt elapsed : bounded_process_receipt process_running_state process_complete_state =
    bounded_process_receipt (ProcessSucceeded (process_elapsed_ms elapsed))

inl exit_receipt code elapsed : bounded_process_receipt process_running_state process_complete_state =
    bounded_process_receipt (ProcessExited (process_exit_code code, process_elapsed_ms elapsed))

inl timeout_receipt budget elapsed : bounded_process_receipt process_running_state process_timeout_state =
    bounded_process_receipt (ProcessTimedOut (process_timeout_ms budget, process_elapsed_ms elapsed))

inl rejected_receipt () : bounded_process_receipt process_idle_state process_rejected_state =
    bounded_process_receipt ProcessSpawnRejected

inl terminated_receipt elapsed : bounded_process_receipt process_running_state process_terminated_state =
    bounded_process_receipt (ProcessTerminated (process_elapsed_ms elapsed))

inl receipt_code forall from to. (bounded_process_receipt event : bounded_process_receipt from to) : i32 =
    match event with
    | ProcessSpawned => 10i32
    | ProcessSucceeded _ => 0i32
    | ProcessExited (process_exit_code code, _) => code
    | ProcessTimedOut _ => 124i32
    | ProcessSpawnRejected => 127i32
    | ProcessTerminated _ => 137i32
    | ProcessStreamsCaptured (process_stream_word word) =>
        inl code = stream_word_exit_code word
        if u64_eq code 0u64 then 0i32
        elif u64_eq code 2u64 then 2i32
        else 127i32

inl receipt_elapsed forall from to. (bounded_process_receipt event : bounded_process_receipt from to) : u64 =
    match event with
    | ProcessSpawned => 0u64
    | ProcessSucceeded (process_elapsed_ms elapsed) => elapsed
    | ProcessExited (_, process_elapsed_ms elapsed) => elapsed
    | ProcessTimedOut (_, process_elapsed_ms elapsed) => elapsed
    | ProcessSpawnRejected => 0u64
    | ProcessTerminated (process_elapsed_ms elapsed) => elapsed
    | ProcessStreamsCaptured _ => 0u64

inl receipt_within_budget forall from to. (bounded_process_receipt event : bounded_process_receipt from to) : bool =
    match event with
    | ProcessTimedOut (process_timeout_ms budget, process_elapsed_ms elapsed) => u64_gte elapsed budget
    | ProcessSucceeded _ => true
    | ProcessExited _ => true
    | ProcessSpawned => true
    | ProcessSpawnRejected => true
    | ProcessTerminated _ => true
    | ProcessStreamsCaptured _ => true

inl success_probe_result () : i32 =
    inl started = spawned_receipt ()
    inl completed = success_receipt 8u64
    if all4
        (i32_eq (receipt_code started) 10i32)
        (i32_eq (receipt_code completed) 0i32)
        (u64_eq (receipt_elapsed completed) 8u64)
        (receipt_within_budget completed)
    then 0i32
    else 61i32

inl failure_probe_result () : i32 =
    inl exited = exit_receipt 7i32 12u64
    inl timed_out = timeout_receipt 10u64 11u64
    inl rejected = rejected_receipt ()
    if all5
        (i32_eq (receipt_code exited) 7i32)
        (u64_eq (receipt_elapsed exited) 12u64)
        (i32_eq (receipt_code timed_out) 124i32)
        (receipt_within_budget timed_out)
        (i32_eq (receipt_code rejected) 127i32)
    then 0i32
    else 62i32

inl termination_probe_result () : i32 =
    inl terminated = terminated_receipt 4u64
    if all3
        (i32_eq (receipt_code terminated) 137i32)
        (u64_eq (receipt_elapsed terminated) 4u64)
        (receipt_within_budget terminated)
    then 0i32
    else 63i32

inl success_probe_ok () : bool = i32_eq (success_probe_result ()) 0i32
inl failure_probe_ok () : bool = i32_eq (failure_probe_result ()) 0i32
inl termination_probe_ok () : bool = i32_eq (termination_probe_result ()) 0i32
