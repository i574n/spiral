inl direct_status_code (~program : string) : i32 =
    rust_std_process.model.status_code0 program

inl spawn_rejected_code (~program : string) : i32 =
    rust_std_process.model.spawn_rejected_code0 program

inl captured_output_word (~program : string) (~argument : string) : u64 =
    rust_std_process.model.captured_output_word1 program argument

inl wall_clock_millis () : u64 = rust_std_process.model.wall_clock_millis ()
inl elapsed_millis (~started : u64) : u64 = rust_std_process.model.elapsed_millis started

inl timed_status_code0 (~program : string) : i32 * u64 =
    inl started = wall_clock_millis ()
    inl code = rust_std_process.model.status_code0 program
    code, elapsed_millis started

inl timed_status_code5 (~program : string) (~argument0 : string) (~argument1 : string) (~argument2 : string) (~argument3 : string) (~argument4 : string) : i32 * u64 =
    inl started = wall_clock_millis ()
    inl code = rust_std_process.model.status_code5 program argument0 argument1 argument2 argument3 argument4
    code, elapsed_millis started

inl direct_termination_physical_probe () : i32 * u64 =
    inl started = wall_clock_millis ()
    inl lifecycle_code = rust_std_process.model.kill_wait_code1 "/bin/sleep" "5"
    lifecycle_code, elapsed_millis started

inl success_physical_probe () : i32 = direct_status_code "/bin/true"
inl failure_physical_probe () : i32 = direct_status_code "/bin/false"
inl rejection_physical_probe () : i32 = spawn_rejected_code "/definitely-missing-eoie-executable"
inl stdout_capture_physical_probe () : u64 = captured_output_word "/usr/bin/printf" "eoie-out"
inl stderr_capture_physical_probe () : u64 = captured_output_word "/usr/bin/ls" "/definitely-missing-eoie-stream-path"
inl timed_success_physical_probe () : i32 * u64 = timed_status_code0 "/bin/true"
inl timeout_physical_probe () : i32 * u64 =
    timed_status_code5 "/usr/bin/timeout" "--signal=TERM" "--kill-after=1s" "1s" "/bin/sleep" "2"
