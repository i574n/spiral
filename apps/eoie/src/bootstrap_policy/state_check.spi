open outcome

nominal check_not_started = ()
nominal check_after_open = ()
nominal check_after_shard_0 = ()
nominal check_after_shard_1 = ()
nominal check_after_shard_2 = ()
nominal check_after_shard_3 = ()
nominal check_closed = ()

union check_op from to result =
    | OpenCheck :: i32 -> check_op check_not_started check_after_open i32
    | CompleteShard0 :: i32 -> check_op check_after_open check_after_shard_0 i32
    | CompleteShard1 :: i32 -> check_op check_after_shard_0 check_after_shard_1 i32
    | CompleteShard2 :: i32 -> check_op check_after_shard_1 check_after_shard_2 i32
    | CompleteShard3 :: i32 -> check_op check_after_shard_2 check_after_shard_3 i32
    | CloseCheck :: i32 -> check_op check_after_shard_3 check_closed i32

union rec check_plan from to =
    | CheckStep :: forall from to. (exists result. check_op from to result * result) -> check_plan from to
    | CheckThen :: forall from to. (exists middle. check_plan from middle * check_plan middle to) -> check_plan from to

inl open_step () : check_plan check_not_started check_after_open =
    CheckStep (exists (OpenCheck 4i32, 4i32))

inl shard0_step () : check_plan check_after_open check_after_shard_0 =
    CheckStep (exists (CompleteShard0 0i32, 0i32))

inl shard1_step () : check_plan check_after_shard_0 check_after_shard_1 =
    CheckStep (exists (CompleteShard1 1i32, 1i32))

inl shard2_step () : check_plan check_after_shard_1 check_after_shard_2 =
    CheckStep (exists (CompleteShard2 2i32, 2i32))

inl shard3_step () : check_plan check_after_shard_2 check_after_shard_3 =
    CheckStep (exists (CompleteShard3 3i32, 3i32))

inl close_step () : check_plan check_after_shard_3 check_closed =
    CheckStep (exists (CloseCheck 4i32, 0i32))

inl full_plan () : check_plan check_not_started check_closed =
    CheckThen (
        exists (
            open_step (),
            CheckThen (
                exists (
                    shard0_step (),
                    CheckThen (
                        exists (
                            shard1_step (),
                            CheckThen (
                                exists (
                                    shard2_step (),
                                    CheckThen (exists (shard3_step (), close_step ()))
                                )
                            )
                        )
                    )
                )
            )
        )
    )

inl resumed_plan () : check_plan check_after_shard_1 check_closed =
    CheckThen (
        exists (
            shard2_step (),
            CheckThen (exists (shard3_step (), close_step ()))
        )
    )

inl rec terminal forall from to. (plan : check_plan from to) : i32 =
    match plan with
    | CheckStep payload =>
        inl exists result. op, value = payload
        match op with
        | OpenCheck _ => value
        | CompleteShard0 _ => value
        | CompleteShard1 _ => value
        | CompleteShard2 _ => value
        | CompleteShard3 _ => value
        | CloseCheck _ => value
    | CheckThen payload =>
        inl exists middle. _, right = payload
        terminal right

inl full_probe_ok () : bool = i32_eq (terminal (full_plan ())) 0i32
inl resume_probe_ok () : bool = i32_eq (terminal (resumed_plan ())) 0i32
