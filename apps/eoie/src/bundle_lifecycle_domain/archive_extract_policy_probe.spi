inl rust_global (x : string) : () = real
    typecase `(!!!!LitToTypeLit(x)) with ~x =>
    $"RustGlobal(@x)" : ()

inl invalid_binary (value : i32) : bool =
    if !!!!LT(value,1i32) then true
    elif !!!!LT(1i32,value) then true
    else false

inl main () : i32 =
    rust_global "#![allow(clippy::needless_return, clippy::needless_late_init)]"
    inl _ = native_extract_plan ()
    if invalid_binary (archive_extract_preflight_binding 0i32 1i32) then 1i32
    elif invalid_binary (archive_extract_process_binding 1i32 1i32) then 1i32
    elif invalid_binary (archive_extract_complete_binding 7i32 7i32) then 1i32
    elif invalid_binary (archive_extract_receipt_binding 1i32 1i32) then 1i32
    else 0i32
