inl rust_global (x : string) : () = !!!!Global(x)


let bundle_output_preflight_binding (outside_root : i32) (output_absent : i32) : i32 =
    bundle_output_contract.model.preflight_binding outside_root output_absent

let bundle_output_complete_binding (outside_root : i32) (output_file : i32) : i32 =
    bundle_output_contract.model.complete_binding outside_root output_file

let bundle_verify_preflight_binding (archive_file : i32) (bytes_positive : i32) : i32 =
    bundle_verify_contract.model.preflight_binding archive_file bytes_positive

let bundle_verify_complete_binding (entries_positive : i32) (size_ok : i32) : i32 =
    bundle_verify_contract.model.complete_binding entries_positive size_ok

inl main () : i32 =
    rust_global "#![allow(clippy::needless_late_init)]"
    inl _ = lifecycle_plan ()
    inl _ = bundle_root_binding 4i32 4i32
    inl _ = coverage_checkpoint_binding 0i32 0i32
    inl _ = coverage_checkpoint_binding 1i32 2i32
    inl _ = bundle_entry_binding 1i32 1i32
    inl _ = bundle_size_binding 30000000i32 1i32
    inl _ = bundle_extract_binding 1i32 1i32
    inl _ = bundle_payload_count_binding 2i32 1i32
    inl _ = bundle_rehydration_binding 1i32 1i32
    inl _ = bundle_complete_binding 1i32 1i32
    inl _ = rehydrate_plan ()
    inl _ = bundle_rehydrate_preflight_binding 1i32 1i32
    inl _ = bundle_rehydrate_extract_binding 1i32 1i32
    inl _ = bundle_rehydrate_validate_binding 1i32 1i32
    inl _ = bundle_rehydrate_receipt_binding 1i32 1i32
    inl _ = native_extract_plan ()
    inl _ = archive_extract_preflight_binding 0i32 1i32
    inl _ = archive_extract_process_binding 1i32 1i32
    inl _ = archive_extract_complete_binding 1i32 1i32
    inl _ = archive_extract_receipt_binding 1i32 1i32
    inl _ = bundle_output_contract.model.policy_plan ()
    inl _ = bundle_output_preflight_binding 1i32 1i32
    inl _ = bundle_output_complete_binding 1i32 1i32
    inl _ = bundle_verify_contract.model.verify_policy_plan ()
    inl _ = bundle_verify_preflight_binding 1i32 1i32
    inl _ = bundle_verify_complete_binding 1i32 1i32
    !!!!Export("eoie_bundle_root_binding", ((fun (first, second) => bundle_root_binding first second) : i32 * i32 -> i32))
    !!!!Export("eoie_bundle_coverage_checkpoint_binding", ((fun (first, second) => coverage_checkpoint_binding first second) : i32 * i32 -> i32))
    !!!!Export("eoie_bundle_entry_binding", ((fun (first, second) => bundle_entry_binding first second) : i32 * i32 -> i32))
    !!!!Export("eoie_bundle_size_binding", ((fun (first, second) => bundle_size_binding first second) : i32 * i32 -> i32))
    !!!!Export("eoie_bundle_extract_binding", ((fun (first, second) => bundle_extract_binding first second) : i32 * i32 -> i32))
    !!!!Export("eoie_bundle_payload_count_binding", ((fun (first, second) => bundle_payload_count_binding first second) : i32 * i32 -> i32))
    !!!!Export("eoie_bundle_rehydration_binding", ((fun (first, second) => bundle_rehydration_binding first second) : i32 * i32 -> i32))
    !!!!Export("eoie_bundle_complete_binding", ((fun (first, second) => bundle_complete_binding first second) : i32 * i32 -> i32))
    !!!!Export("eoie_bundle_rehydrate_preflight_binding", ((fun (first, second) => bundle_rehydrate_preflight_binding first second) : i32 * i32 -> i32))
    !!!!Export("eoie_bundle_rehydrate_extract_binding", ((fun (first, second) => bundle_rehydrate_extract_binding first second) : i32 * i32 -> i32))
    !!!!Export("eoie_bundle_rehydrate_validate_binding", ((fun (first, second) => bundle_rehydrate_validate_binding first second) : i32 * i32 -> i32))
    !!!!Export("eoie_bundle_rehydrate_receipt_binding", ((fun (first, second) => bundle_rehydrate_receipt_binding first second) : i32 * i32 -> i32))
    !!!!Export("eoie_archive_extract_preflight_binding", ((fun (first, second) => archive_extract_preflight_binding first second) : i32 * i32 -> i32))
    !!!!Export("eoie_archive_extract_process_binding", ((fun (first, second) => archive_extract_process_binding first second) : i32 * i32 -> i32))
    !!!!Export("eoie_archive_extract_complete_binding", ((fun (first, second) => archive_extract_complete_binding first second) : i32 * i32 -> i32))
    !!!!Export("eoie_archive_extract_receipt_binding", ((fun (first, second) => archive_extract_receipt_binding first second) : i32 * i32 -> i32))
    !!!!Export("eoie_bundle_output_preflight_binding", ((fun (first, second) => bundle_output_preflight_binding first second) : i32 * i32 -> i32))
    !!!!Export("eoie_bundle_output_complete_binding", ((fun (first, second) => bundle_output_complete_binding first second) : i32 * i32 -> i32))
    !!!!Export("eoie_bundle_verify_preflight_binding", ((fun (first, second) => bundle_verify_preflight_binding first second) : i32 * i32 -> i32))
    !!!!Export("eoie_bundle_verify_complete_binding", ((fun (first, second) => bundle_verify_complete_binding first second) : i32 * i32 -> i32))
    0i32
