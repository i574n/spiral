inl eq_i32 (a : i32) (b : i32) : bool = !!!!EQ(a,b)

inl positive_ok () : bool =
    eq_i32 (bundle_lifecycle_domain.bundle_root_binding 3i32 3i32) 1i32 &&
    eq_i32 (bundle_lifecycle_domain.bundle_entry_binding 17i32 17i32) 1i32 &&
    eq_i32 (bundle_lifecycle_domain.bundle_size_binding 30000000i32 11000000i32) 1i32 &&
    eq_i32 (bundle_lifecycle_domain.bundle_extract_binding 17i32 17i32) 1i32 &&
    eq_i32 (bundle_lifecycle_domain.bundle_payload_count_binding 18i32 1i32) 17i32 &&
    eq_i32 (bundle_lifecycle_domain.bundle_payload_count_binding 17i32 0i32) 17i32 &&
    eq_i32 (bundle_lifecycle_domain.bundle_rehydration_binding 1i32 1i32) 1i32 &&
    eq_i32 (bundle_lifecycle_domain.bundle_complete_binding 1i32 1i32) 1i32 &&
    eq_i32 (bundle_lifecycle_domain.bundle_rehydrate_preflight_binding 1i32 1i32) 1i32 &&
    eq_i32 (bundle_lifecycle_domain.bundle_rehydrate_extract_binding 1i32 1i32) 1i32 &&
    eq_i32 (bundle_lifecycle_domain.bundle_rehydrate_validate_binding 1i32 1i32) 1i32 &&
    eq_i32 (bundle_lifecycle_domain.bundle_rehydrate_receipt_binding 1i32 1i32) 1i32 &&
    eq_i32 (bundle_lifecycle_domain.archive_extract_preflight_binding 0i32 1i32) 1i32 &&
    eq_i32 (bundle_lifecycle_domain.archive_extract_process_binding 1i32 1i32) 1i32 &&
    eq_i32 (bundle_lifecycle_domain.archive_extract_complete_binding 17i32 17i32) 1i32 &&
    eq_i32 (bundle_lifecycle_domain.archive_extract_receipt_binding 1i32 1i32) 1i32

inl negative_ok () : bool =
    eq_i32 (bundle_lifecycle_domain.bundle_root_binding 3i32 1i32) 0i32 &&
    eq_i32 (bundle_lifecycle_domain.bundle_entry_binding 17i32 16i32) 0i32 &&
    eq_i32 (bundle_lifecycle_domain.bundle_size_binding 30000000i32 30000001i32) 0i32 &&
    eq_i32 (bundle_lifecycle_domain.bundle_extract_binding 17i32 18i32) 0i32 &&
    eq_i32 (bundle_lifecycle_domain.bundle_payload_count_binding 0i32 0i32) 0i32 &&
    eq_i32 (bundle_lifecycle_domain.bundle_payload_count_binding 3i32 4i32) 0i32 &&
    eq_i32 (bundle_lifecycle_domain.bundle_rehydration_binding 1i32 0i32) 0i32 &&
    eq_i32 (bundle_lifecycle_domain.bundle_complete_binding 0i32 1i32) 0i32 &&
    eq_i32 (bundle_lifecycle_domain.bundle_rehydrate_preflight_binding 1i32 0i32) 0i32 &&
    eq_i32 (bundle_lifecycle_domain.bundle_rehydrate_extract_binding 0i32 1i32) 0i32 &&
    eq_i32 (bundle_lifecycle_domain.bundle_rehydrate_validate_binding 1i32 0i32) 0i32 &&
    eq_i32 (bundle_lifecycle_domain.bundle_rehydrate_receipt_binding 1i32 0i32) 0i32 &&
    eq_i32 (bundle_lifecycle_domain.archive_extract_preflight_binding 1i32 1i32) 0i32 &&
    eq_i32 (bundle_lifecycle_domain.archive_extract_preflight_binding 0i32 0i32) 0i32 &&
    eq_i32 (bundle_lifecycle_domain.archive_extract_process_binding 1i32 0i32) 0i32 &&
    eq_i32 (bundle_lifecycle_domain.archive_extract_complete_binding 17i32 16i32) 0i32 &&
    eq_i32 (bundle_lifecycle_domain.archive_extract_receipt_binding 1i32 0i32) 0i32

inl main () : i32 = if positive_ok () && negative_ok () then 0i32 else 1i32
