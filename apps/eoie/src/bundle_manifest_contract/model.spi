nominal manifest_idle = ()
nominal manifest_collected = ()
nominal archive_written = ()
nominal manifest_verified = ()

union manifest_policy =
    | LexicographicUtf8
    | RejectUnsafeRelativePath
    | RejectDuplicateEntry
    | RejectNestedZip
    | FixedDosEpoch
    | PreserveExecutableMode

union manifest_op from to =
    | CollectDeterministicManifest :: manifest_op manifest_idle manifest_collected
    | WriteDeterministicStoreArchive :: manifest_op manifest_collected archive_written
    | VerifyExactManifestParity :: manifest_op archive_written manifest_verified

union rec manifest_plan from to =
    | ManifestStep :: forall from to. manifest_op from to -> manifest_plan from to
    | ManifestThen :: forall from to. (exists middle. manifest_plan from middle * manifest_plan middle to) -> manifest_plan from to

inl deterministic_plan () : manifest_plan manifest_idle manifest_verified =
    ManifestThen (exists (
        ManifestStep CollectDeterministicManifest,
        ManifestThen (exists (
            ManifestStep WriteDeterministicStoreArchive,
            ManifestStep VerifyExactManifestParity
        ))
    ))

let manifest_parity_binding (entry_count_equal : i32) (fingerprint_equal : i32) : i32 =
    if !!!!LT(entry_count_equal,1i32) then 0i32
    elif !!!!LT(1i32,entry_count_equal) then 0i32
    elif !!!!LT(fingerprint_equal,1i32) then 0i32
    elif !!!!LT(1i32,fingerprint_equal) then 0i32
    else 1i32

let manifest_executable_mode_binding (root_eoie_seen : i32) (root_eoie_executable : i32) : i32 =
    if !!!!LT(root_eoie_seen,1i32) then 1i32
    elif !!!!LT(1i32,root_eoie_seen) then 0i32
    elif !!!!LT(root_eoie_executable,1i32) then 0i32
    elif !!!!LT(1i32,root_eoie_executable) then 0i32
    else 1i32

inl executable_mode_passed (value : i32) : bool =
    if !!!!LT(value,1i32) then false
    elif !!!!LT(1i32,value) then false
    else true

inl parity_passed (value : i32) : bool =
    if !!!!LT(value,1i32) then false
    elif !!!!LT(1i32,value) then false
    else true