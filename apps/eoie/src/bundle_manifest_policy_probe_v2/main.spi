open bundle_manifest_contract.model

inl main () : i32 =
    inl _ = deterministic_plan ()
    if parity_passed (manifest_parity_binding 1i32 1i32)
        && executable_mode_passed (manifest_executable_mode_binding 1i32 1i32)
        && executable_mode_passed (manifest_executable_mode_binding 0i32 0i32)
    then 0i32 else 1i32