
inl create_dir (path : string) : bool =
    $'std::fs::create_dir_all(&*!path).is_ok()' : bool

inl cleanup_tree (path : string) : bool =
    $'std::fs::remove_dir_all(&*!path).is_ok() || \!std::path::Path::new(&*!path).exists()' : bool

inl remove_file (path : string) : bool =
    $'std::fs::remove_file(&*!path).is_ok() || \!std::path::Path::new(&*!path).exists()' : bool

inl write_text (path : string) (text : string) : bool =
    $'std::fs::write(&*!path, &*!text).is_ok()' : bool

inl file_exists (path : string) : bool =
    $'std::path::Path::new(&*!path).is_file()' : bool

inl path_missing (path : string) : bool =
    $'\!std::path::Path::new(&*!path).exists()' : bool

inl output_outside_root (root : string) (candidate : string) : bool =
    $'\!std::path::Path::new(&*!candidate).starts_with(std::path::Path::new(&*!root))' : bool

nominal policy_owner = string
nominal agile_owner = string
nominal output_pending owner = owner
nominal output_root_ready owner = owner
nominal output_preflight_accepted owner = owner
nominal output_archive_created owner = owner
nominal output_archive_verified owner = owner
nominal output_cleaned owner = owner

union bundle_output_transition from to =
    | PrepareOutputRoot :: forall owner. string -> bundle_output_transition (output_pending owner) (output_root_ready owner)
    | ValidateOutputOutsideRoot :: forall owner. string -> bundle_output_transition (output_root_ready owner) (output_preflight_accepted owner)
    | MaterializeOutputArchive :: forall owner. string -> bundle_output_transition (output_preflight_accepted owner) (output_archive_created owner)
    | VerifyOutputArchive :: forall owner. string -> bundle_output_transition (output_archive_created owner) (output_archive_verified owner)
    | CleanupOutputFixture :: forall owner. string -> bundle_output_transition (output_archive_verified owner) (output_cleaned owner)

union rec bundle_output_plan from to =
    | BundleOutputStep :: forall from to. bundle_output_transition from to -> bundle_output_plan from to
    | BundleOutputThen :: forall from to. (exists middle. bundle_output_plan from middle * bundle_output_plan middle to) -> bundle_output_plan from to

union bundle_output_outcome =
    | BundleOutputAccepted : string
    | BundleOutputRejected : string
    | BundleOutputFailed : string

let preflight_binding (outside_root : i32) (output_absent : i32) : i32 =
    if !!!!LT(outside_root,1i32) then 0i32
    elif !!!!LT(1i32,outside_root) then 0i32
    elif !!!!LT(output_absent,1i32) then 0i32
    elif !!!!LT(1i32,output_absent) then 0i32
    else 1i32

let complete_binding (outside_root : i32) (output_file : i32) : i32 =
    preflight_binding outside_root output_file

inl binding_passed (value : i32) : bool =
    if !!!!LT(value,1i32) then false
    elif !!!!LT(1i32,value) then false
    else true

inl prepare_step forall owner. () : bundle_output_plan (output_pending owner) (output_root_ready owner) =
    BundleOutputStep (PrepareOutputRoot "prepare-output-root")

inl preflight_step forall owner. () : bundle_output_plan (output_root_ready owner) (output_preflight_accepted owner) =
    BundleOutputStep (ValidateOutputOutsideRoot "validate-output-outside-root")

inl materialize_step forall owner. () : bundle_output_plan (output_preflight_accepted owner) (output_archive_created owner) =
    BundleOutputStep (MaterializeOutputArchive "materialize-output-archive")

inl verify_step forall owner. () : bundle_output_plan (output_archive_created owner) (output_archive_verified owner) =
    BundleOutputStep (VerifyOutputArchive "verify-output-archive")

inl cleanup_step forall owner. () : bundle_output_plan (output_archive_verified owner) (output_cleaned owner) =
    BundleOutputStep (CleanupOutputFixture "cleanup-output-fixture")

inl full_plan forall owner. () : bundle_output_plan (output_pending owner) (output_cleaned owner) =
    BundleOutputThen (exists (
        prepare_step (),
        BundleOutputThen (exists (
            preflight_step (),
            BundleOutputThen (exists (
                materialize_step (),
                BundleOutputThen (exists (
                    verify_step (),
                    cleanup_step ()
                ))
            ))
        ))
    ))

inl policy_plan () : bundle_output_plan (output_pending policy_owner) (output_cleaned policy_owner) = full_plan ()
inl agile_plan () : bundle_output_plan (output_pending agile_owner) (output_cleaned agile_owner) = full_plan ()

inl cleanup_path (path : string) : bool =
    if cleanup_tree path then path_missing path
    elif remove_file path then path_missing path
    else false

inl cleanup_pair (root : string) (candidate : string) : bool =
    if cleanup_path candidate then cleanup_path root else false

inl policy_output (root : string) (candidate : string) : bundle_output_outcome =
    inl _ = policy_plan ()
    if cleanup_pair root candidate then
        if create_dir root then
            inl outside = output_outside_root root candidate
            inl absent = path_missing candidate
            if binding_passed (preflight_binding (if outside then 1i32 else 0i32) (if absent then 1i32 else 0i32)) then
                if write_text candidate "bundle-output-placeholder" then
                    inl output_file = file_exists candidate
                    if binding_passed (complete_binding (if outside then 1i32 else 0i32) (if output_file then 1i32 else 0i32)) then
                        if cleanup_pair root candidate
                        then BundleOutputAccepted "bundle-output-outside-root-accepted"
                        else BundleOutputFailed "bundle-output-cleanup-failed"
                    else
                        if cleanup_pair root candidate
                        then BundleOutputRejected "bundle-output-completion-rejected"
                        else BundleOutputFailed "bundle-output-completion-cleanup-failed"
                else BundleOutputFailed "bundle-output-materialization-failed"
            else
                if cleanup_pair root candidate
                then BundleOutputRejected "bundle-output-preflight-rejected"
                else BundleOutputFailed "bundle-output-preflight-cleanup-failed"
        else BundleOutputFailed "bundle-output-root-create-failed"
    else BundleOutputFailed "bundle-output-ensure-clean-failed"

inl agile_rejection (root : string) (candidate : string) : bundle_output_outcome =
    inl _ = agile_plan ()
    if cleanup_pair root candidate then
        if create_dir root then
            inl outside = output_outside_root root candidate
            inl absent = path_missing candidate
            if binding_passed (preflight_binding (if outside then 1i32 else 0i32) (if absent then 1i32 else 0i32)) then
                if cleanup_pair root candidate
                then BundleOutputFailed "bundle-output-inside-root-was-accepted"
                else BundleOutputFailed "bundle-output-negative-cleanup-failed"
            else
                if cleanup_pair root candidate
                then BundleOutputRejected "bundle-output-inside-root-rejected"
                else BundleOutputFailed "bundle-output-rejection-cleanup-failed"
        else BundleOutputFailed "bundle-output-negative-root-create-failed"
    else BundleOutputFailed "bundle-output-negative-ensure-clean-failed"
