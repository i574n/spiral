inl rust_global (x : string) : () = !!!!Global(x)

inl emit_runtime () : () =
    rust_global "use eoie_proxy_search::inspection_file_sha256 as external_payload_sha256;\nuse eoie_rust_std_fs::{atomic_write as external_payload_atomic_write, safe_relative_path as external_payload_safe_relative};\nuse std::{fs,path::{Path,PathBuf}};\n\n#[derive(Clone)]\nstruct ExternalPayloadReceipt { payload:String, cache:String, sha256:String, bytes:u64 }\nfn external_payload_arg<'a>(a:&'a[String],i:usize,n:&str)->Result<&'a str,String>{a.get(i).map(String::as_str).ok_or_else(||format!(\"missing argument: {n}\"))}\nfn external_payload_separated(a:&Path,b:&Path,c:&Path)->bool{a!=b&&a!=c&&b!=c}\nfn external_payload_regular(p:&Path)->Result<u64,String>{let m=fs::symlink_metadata(p).map_err(|e|format!(\"metadata {}: {e}\",p.display()))?;if m.file_type().is_symlink()||!m.is_file(){return Err(format!(\"external payload must be a regular file: {}\",p.display()))}Ok(m.len())}\nfn external_payload_hash(p:&Path)->Result<String,String>{external_payload_sha256(p)}\nfn external_payload_parse(p:&Path)->Result<ExternalPayloadReceipt,String>{let t=fs::read_to_string(p).map_err(|e|format!(\"read receipt {}: {e}\",p.display()))?;if t.len()>16*1024{return Err(\"external payload receipt exceeds 16 KiB\".to_owned())}let mut payload=None;let mut cache=None;let mut sha=None;let mut bytes=None;for l in t.lines(){if let Some(v)=l.strip_prefix(\"payload=\"){payload=Some(v.to_owned())}else if let Some(v)=l.strip_prefix(\"cache=\"){cache=Some(v.to_owned())}else if let Some(v)=l.strip_prefix(\"sha256=\"){sha=Some(v.to_owned())}else if let Some(v)=l.strip_prefix(\"bytes=\"){bytes=Some(v.parse::<u64>().map_err(|_|\"invalid external payload bytes\".to_owned())?)}}Ok(ExternalPayloadReceipt{payload:payload.ok_or_else(||\"receipt missing payload\".to_owned())?,cache:cache.ok_or_else(||\"receipt missing cache\".to_owned())?,sha256:sha.ok_or_else(||\"receipt missing sha256\".to_owned())?,bytes:bytes.ok_or_else(||\"receipt missing bytes\".to_owned())?})}\nfn external_payload_identity(r:&ExternalPayloadReceipt,payload:&Path,cache:&Path)->Result<(),String>{let payload_text=payload.to_string_lossy();let cache_text=cache.to_string_lossy();let same=(r.payload==payload_text||payload.ends_with(Path::new(&r.payload)))&&(r.cache==cache_text||cache.ends_with(Path::new(&r.cache)));let shape=r.sha256.len()==64&&r.sha256.bytes().all(|b|b.is_ascii_hexdigit());if eoie_external_payload_public_mask_binding(0,i32::from(same)+2*i32::from(r.bytes>0)+4*i32::from(shape))!=1{return Err(\"typed external payload identity rejected\".to_owned())}Ok(())}\nfn external_payload_matches(p:&Path,r:&ExternalPayloadReceipt)->Result<bool,String>{if !p.is_file(){return Ok(false)}Ok(external_payload_regular(p)?==r.bytes&&external_payload_hash(p)?==r.sha256)}\nfn external_payload_copy_verified(src:&Path,dst:&Path,r:&ExternalPayloadReceipt)->Result<(),String>{if dst.exists(){return Err(format!(\"external payload stage exists: {}\",dst.display()))}if let Some(parent)=dst.parent(){fs::create_dir_all(parent).map_err(|e|format!(\"create {}: {e}\",parent.display()))?}fs::copy(src,dst).map_err(|e|format!(\"copy {} -> {}: {e}\",src.display(),dst.display()))?;let ok=external_payload_matches(dst,r)?;if eoie_external_payload_public_mask_binding(0,1+2+4*i32::from(ok))!=1{let _=fs::remove_file(dst);return Err(\"typed external payload stage verification rejected\".to_owned())}Ok(())}\nfn external_payload_paths(a:&[String])->Result<(&Path,PathBuf,PathBuf,PathBuf),String>{let root=Path::new(external_payload_arg(a,2,\"root\")?);if !root.is_dir(){return Err(format!(\"external payload root is not a directory: {}\",root.display()))}let pr=external_payload_safe_relative(external_payload_arg(a,3,\"payload-relative\")?)?;let cr=external_payload_safe_relative(external_payload_arg(a,4,\"cache-relative\")?)?;let rr=external_payload_safe_relative(external_payload_arg(a,5,\"receipt-relative\")?)?;let p=root.join(pr);let c=root.join(cr);let r=root.join(rr);if eoie_external_payload_public_mask_binding(1,1+2+4+8*i32::from(external_payload_separated(&p,&c,&r)))!=1{return Err(\"typed external payload scope rejected\".to_owned())}Ok((root,p,c,r))}\nfn external_payload_register(a:&[String])->Result<(),String>{if a.len()!=6{return Err(\"external-payload register expects root payload-relative cache-relative receipt-relative\".to_owned())}let(root,p,c,rp)=external_payload_paths(a)?;let bytes=external_payload_regular(&p)?;if bytes==0{return Err(\"external payload must be non-empty\".to_owned())}let sha=external_payload_hash(&p)?;let payload=p.strip_prefix(root).map_err(|e|e.to_string())?.to_string_lossy();let cache=c.strip_prefix(root).map_err(|e|e.to_string())?.to_string_lossy();let body=format!(\"schema=1\\npayload={}\\ncache={}\\nsha256={}\\nbytes={}\\n\",payload,cache,sha,bytes);external_payload_atomic_write(&rp,body.as_bytes())?;let parsed=external_payload_parse(&rp)?;external_payload_identity(&parsed,&p,&c)?;println!(\"eoie proxy external-payload register ok payload={} cache={} bytes={} sha256={} receipt={}\",p.display(),c.display(),bytes,sha,rp.display());Ok(())}\nfn external_payload_hydrate(a:&[String])->Result<(),String>{if a.len()!=6{return Err(\"external-payload hydrate expects root payload-relative cache-relative receipt-relative\".to_owned())}let(_,p,c,rp)=external_payload_paths(a)?;let r=external_payload_parse(&rp)?;external_payload_identity(&r,&p,&c)?;if p.exists(){if external_payload_matches(&p,&r)?{println!(\"eoie proxy external-payload hydrate ok status=already-inline payload={} cache={}\",p.display(),c.display());return Ok(())}return Err(\"inline external payload exists with wrong identity\".to_owned())}if !external_payload_matches(&c,&r)?{return Err(\"external payload cache is missing or hash-mismatched\".to_owned())}let parent=p.parent().ok_or_else(||\"payload has no parent\".to_owned())?;let stage=parent.join(format!(\".eoie-external-payload-stage-{}\",std::process::id()));external_payload_copy_verified(&c,&stage,&r)?;if std::env::var(\"EOIE_EXTERNAL_PAYLOAD_FAULT\").ok().as_deref()==Some(\"after-stage\"){let _=fs::remove_file(&stage);return Err(\"injected external payload failure after stage\".to_owned())}fs::rename(&stage,&p).map_err(|e|format!(\"promote external payload: {e}\"))?;if std::env::var(\"EOIE_EXTERNAL_PAYLOAD_FAULT\").ok().as_deref()==Some(\"after-payload-promotion\"){let _=fs::remove_file(&p);return Err(\"injected external payload failure after payload promotion\".to_owned())}let ok=external_payload_matches(&p,&r)?;if eoie_external_payload_public_mask_binding(0,i32::from(ok)+2+4*i32::from(!stage.exists()))!=1{let _=fs::remove_file(&p);return Err(\"typed external payload hydrate completion rejected\".to_owned())}println!(\"eoie proxy external-payload hydrate ok status=promoted payload={} cache={} sha256={}\",p.display(),c.display(),r.sha256);Ok(())}\nfn external_payload_dehydrate(a:&[String])->Result<(),String>{if a.len()!=6{return Err(\"external-payload dehydrate expects root payload-relative cache-relative receipt-relative\".to_owned())}let(_,p,c,rp)=external_payload_paths(a)?;let r=external_payload_parse(&rp)?;external_payload_identity(&r,&p,&c)?;if !p.exists(){if external_payload_matches(&c,&r)?{println!(\"eoie proxy external-payload dehydrate ok status=already-external payload={} cache={}\",p.display(),c.display());return Ok(())}return Err(\"external payload is absent and cache is not verified\".to_owned())}if !external_payload_matches(&p,&r)?{return Err(\"inline external payload hash mismatch; refusing dehydration\".to_owned())}let mut created=false;if c.exists(){if !external_payload_matches(&c,&r)?{return Err(\"existing external payload cache hash mismatch\".to_owned())}}else{let parent=c.parent().ok_or_else(||\"cache has no parent\".to_owned())?;let stage=parent.join(format!(\".eoie-external-cache-stage-{}\",std::process::id()));external_payload_copy_verified(&p,&stage,&r)?;fs::rename(&stage,&c).map_err(|e|format!(\"promote external cache: {e}\"))?;created=true}if std::env::var(\"EOIE_EXTERNAL_PAYLOAD_FAULT\").ok().as_deref()==Some(\"after-cache-promotion\"){if created{let _=fs::remove_file(&c);}return Err(\"injected external payload failure after cache promotion\".to_owned())}fs::remove_file(&p).map_err(|e|format!(\"remove inline external payload: {e}\"))?;if std::env::var(\"EOIE_EXTERNAL_PAYLOAD_FAULT\").ok().as_deref()==Some(\"after-payload-removal\"){let _=fs::copy(&c,&p);if !external_payload_matches(&p,&r)?{return Err(\"external payload rollback after removal failed\".to_owned())}return Err(\"injected external payload failure after payload removal\".to_owned())}let cache_ok=external_payload_matches(&c,&r)?;if eoie_external_payload_public_mask_binding(0,1+2*i32::from(cache_ok)+4*i32::from(!p.exists()))!=1{return Err(\"typed external payload dehydrate completion rejected\".to_owned())}println!(\"eoie proxy external-payload dehydrate ok status={} payload={} cache={} sha256={}\",if created{\"externalized\"}else{\"reused-cache\"},p.display(),c.display(),r.sha256);Ok(())}\npub fn external_payload_run(a:&[String])->Result<(),String>{match a.get(1).map(String::as_str){Some(\"register\")=>external_payload_register(a),Some(\"hydrate\")=>external_payload_hydrate(a),Some(\"dehydrate\")=>external_payload_dehydrate(a),_=>Err(\"external-payload expects register, hydrate or dehydrate\".to_owned())}}\n"
