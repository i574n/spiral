inl rust_global (x : string) : () = real
    typecase `(!!!!LitToTypeLit(x)) with ~x =>
    $"RustGlobal(@x)" : ()

union retention_negative_fixture =
    | WrongKeepWindow
    | CurrentIsNotLatest
    | DryRunMismatch
    | ApplyWithoutDryRun
    | RemainingCountMismatch

inl main () : i32 =
    rust_global "#![allow(clippy::needless_return, clippy::needless_late_init)]"
    inl _ = current_plus_two_plan ()
    inl wrong_window = retention_window_binding 5i32 2i32
    inl stale_current = retention_current_binding 0i32 1i32
    inl dry_run_mismatch = retention_dry_run_binding 2i32 1i32
    inl unverified_apply = retention_apply_binding 0i32 1i32
    inl remaining_mismatch = retention_complete_binding 3i32 2i32
    if !!!!LT(wrong_window,0i32) then
        if !!!!LT(0i32,stale_current) then 1i32
        elif !!!!LT(0i32,dry_run_mismatch) then 1i32
        elif !!!!LT(0i32,unverified_apply) then 1i32
        elif !!!!LT(0i32,remaining_mismatch) then 1i32
        else 0i32
    else 1i32
