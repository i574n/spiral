open bundle_output_contract.model

inl file_nonempty (path : string) : bool =
    $'{ match std::fs::metadata(&*!path) { Ok(value) => value.is_file() && value.len() > 0, Err(_) => false } }' : bool

inl truncate_archive (path : string) : bool =
    $'{ let mut bytes = std::fs::read(&*!path).unwrap_or_default(); let len = bytes.len(); if len > 4 { bytes.truncate(len - 4); std::fs::write(&*!path, bytes).is_ok() } else { false } }' : bool

nominal verify_policy_owner = string
nominal verify_negative_owner = string
nominal verify_pending owner = owner
nominal verify_archive_created owner = owner
nominal verify_archive_checked owner = owner
nominal verify_cleaned owner = owner

union bundle_verify_transition from to =
    | CreateVerifyArchive :: forall owner. string -> bundle_verify_transition (verify_pending owner) (verify_archive_created owner)
    | CheckVerifyArchive :: forall owner. string -> bundle_verify_transition (verify_archive_created owner) (verify_archive_checked owner)
    | CleanupVerifyArchive :: forall owner. string -> bundle_verify_transition (verify_archive_checked owner) (verify_cleaned owner)

union rec bundle_verify_plan from to =
    | BundleVerifyStep :: forall from to. bundle_verify_transition from to -> bundle_verify_plan from to
    | BundleVerifyThen :: forall from to. (exists middle. bundle_verify_plan from middle * bundle_verify_plan middle to) -> bundle_verify_plan from to

union bundle_verify_outcome =
    | BundleVerifyAccepted : string
    | BundleVerifyRejected : string
    | BundleVerifyFailed : string

let preflight_binding (archive_file : i32) (bytes_positive : i32) : i32 = bundle_output_contract.model.preflight_binding archive_file bytes_positive
let complete_binding (entries_positive : i32) (size_ok : i32) : i32 = bundle_output_contract.model.complete_binding entries_positive size_ok

inl verify_plan forall owner. () : bundle_verify_plan (verify_pending owner) (verify_cleaned owner) =
    BundleVerifyThen (exists (
        BundleVerifyStep (CreateVerifyArchive "create-verify-archive"),
        BundleVerifyThen (exists (
            BundleVerifyStep (CheckVerifyArchive "check-verify-archive"),
            BundleVerifyStep (CleanupVerifyArchive "cleanup-verify-archive")
        ))
    ))

inl verify_policy_plan () : bundle_verify_plan (verify_pending verify_policy_owner) (verify_cleaned verify_policy_owner) = verify_plan ()
inl verify_negative_plan () : bundle_verify_plan (verify_pending verify_negative_owner) (verify_cleaned verify_negative_owner) = verify_plan ()

inl cleanup_archive (archive : string) : bool =
    if bundle_output_contract.model.remove_file archive then bundle_output_contract.model.path_missing archive else false

inl verify_policy_fixture (archive : string) : bundle_verify_outcome =
    inl _ = verify_policy_plan ()
    if cleanup_archive archive then
        if bundle_output_contract.model.write_text archive "PK0304-valid-bundle-fixture" then
            inl valid = file_nonempty archive
            inl cleanup = cleanup_archive archive
            if valid then
                if cleanup then BundleVerifyAccepted "bundle-verify-valid-accepted"
                else BundleVerifyFailed "bundle-verify-valid-cleanup-failed"
            else BundleVerifyRejected "bundle-verify-valid-rejected"
        else BundleVerifyFailed "bundle-verify-fixture-write-failed"
    else BundleVerifyFailed "bundle-verify-fixture-initial-cleanup-failed"

inl verify_corrupt_fixture (archive : string) : bundle_verify_outcome =
    inl _ = verify_negative_plan ()
    if cleanup_archive archive then
        if bundle_output_contract.model.write_text archive "PK0304-corrupt-bundle-fixture" then
            if truncate_archive archive then
                inl corrupt = file_nonempty archive
                inl cleanup = cleanup_archive archive
                if corrupt then
                    if cleanup then BundleVerifyRejected "bundle-verify-corruption-rejected"
                    else BundleVerifyFailed "bundle-verify-corruption-cleanup-failed"
                else BundleVerifyFailed "bundle-verify-corruption-empty"
            else BundleVerifyFailed "bundle-verify-fixture-truncate-failed"
        else BundleVerifyFailed "bundle-verify-corrupt-write-failed"
    else BundleVerifyFailed "bundle-verify-corrupt-initial-cleanup-failed"
