inl main () : i32 =
    emit_plan_ir_transport ()
    inl _ = plan_schema_tag "schema"
    inl _ = plan_descriptor_by_index "0"
    inl _ = plan_manifest_header_projection "EOIE-PLAN-IR\t1"
    inl _ = plan_manifest_header_projection "EOIE-PLAN-IR\t2"
    inl _ = plan_manifest_row_hex_tuple "op\t01\t02\t03\t04\t05"
    inl _ = plan_manifest_row_hex_tuple "op\t01\t02\t03\t04\t05\t06"
    inl _ = plan_manifest_projection_witness ()
    inl _ = plan_provider_count ()
    inl _ = plan_stage_witness ()
    inl _ = plan_index_valid "0"
    inl _ = plan_decode_code "create" "state/example.spi" "-" "typed-payload" "write"
    $"RustExportStringUnary(\"eoie_plan_ir_schema\",\"plan_schema_tag\")" : ()
    $"RustExportStringTuple5Unary(\"eoie_plan_ir_descriptor\",\"plan_descriptor_by_index\")" : ()
    $"RustExportStringUnary(\"eoie_plan_ir_header_projection\",\"plan_manifest_header_projection\")" : ()
    $"RustExportStringTuple5Unary(\"eoie_plan_ir_row_hex_tuple\",\"plan_manifest_row_hex_tuple\")" : ()
    $"RustExportI32(\"eoie_plan_ir_projection_witness\",\"plan_manifest_projection_witness\")" : ()
    $"RustExportI32(\"eoie_plan_ir_count\",\"plan_provider_count\")" : ()
    $"RustExportI32(\"eoie_plan_ir_stage_witness\",\"plan_stage_witness\")" : ()
    $"RustExportU64Unary(\"eoie_plan_ir_index_valid\",\"plan_index_valid\")" : ()
    $"RustExportU64String5(\"eoie_plan_ir_decode_code\",\"plan_decode_code\")" : ()
    $"RustLibrary()" : ()
    0i32
