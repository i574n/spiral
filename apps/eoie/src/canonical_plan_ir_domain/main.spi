inl main () : i32 =
    emit_plan_ir_transport ()
    inl _ = plan_schema_tag "schema"
    inl _ = plan_descriptor_by_index "0"
    inl _ = plan_manifest_header_projection "EOIE-PLAN-IR\t1"
    inl _ = plan_manifest_header_projection "EOIE-PLAN-IR\t2"
    inl _ = plan_manifest_row_hex_tuple "op\t01\t02\t03\t04\t05"
    inl _ = plan_manifest_row_hex_tuple "op\t01\t02\t03\t04\t05\t06"
    inl _ = plan_manifest_projection_witness ()
    inl _ = plan_provider_count ()
    inl _ = plan_stage_witness ()
    inl _ = plan_index_valid "0"
    inl _ = plan_decode_code "create" "state/example.spi" "-" "typed-payload" "write"
    !!!!Export("eoie_plan_ir_schema", ((fun value => plan_schema_tag value) : string -> string))
    !!!!Export("eoie_plan_ir_descriptor", ((fun value => plan_descriptor_by_index value) : string -> string * string * string * string * string))
    !!!!Export("eoie_plan_ir_header_projection", ((fun value => plan_manifest_header_projection value) : string -> string))
    !!!!Export("eoie_plan_ir_row_hex_tuple", ((fun value => plan_manifest_row_hex_tuple value) : string -> string * string * string * string * string))
    !!!!Export("eoie_plan_ir_projection_witness", ((fun () => plan_manifest_projection_witness ()) : () -> i32))
    !!!!Export("eoie_plan_ir_count", ((fun () => plan_provider_count ()) : () -> i32))
    !!!!Export("eoie_plan_ir_stage_witness", ((fun () => plan_stage_witness ()) : () -> i32))
    !!!!Export("eoie_plan_ir_index_valid", ((fun value => plan_index_valid value) : string -> u64))
    !!!!Export("eoie_plan_ir_decode_code", ((fun (a, b, c, d, e) => plan_decode_code a b c d e) : string * string * string * string * string -> u64))
    0i32
