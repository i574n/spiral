inl plan_op0 () : plan_op = CreateFile ("state/example.spi", "typed-payload")
inl plan_op1 () : plan_op = ReplaceFile ("src/example.spi", "expected", "replacement")
inl plan_op2 () : plan_op = PatchExact ("src/example.spi", "old", "new")
inl plan_op3 () : plan_op = MakeDir "src/generated"
inl plan_op4 () : plan_op = ToolchainAction "cargo-check"
inl plan_op5 () : plan_op = CopyFile ("src/source.spi", "expected-sha", "src/copied.spi")
inl plan_op6 () : plan_op = Chmod ("src/tool", "0755", "0644")
inl plan_op7 () : plan_op = Symlink ("src/current", "src/target")

let plan_schema_tag (~input : string) : string =
    if rust_std_string.model.equals input "schema" then "canonical-plan-ir" else "invalid"

let plan_descriptor_by_index (~input : string) : string * string * string * string * string =
    if rust_std_string.model.equals input "0" then op_descriptor (plan_op0 ())
    elif rust_std_string.model.equals input "1" then op_descriptor (plan_op1 ())
    elif rust_std_string.model.equals input "2" then op_descriptor (plan_op2 ())
    elif rust_std_string.model.equals input "3" then op_descriptor (plan_op3 ())
    elif rust_std_string.model.equals input "4" then op_descriptor (plan_op4 ())
    elif rust_std_string.model.equals input "5" then op_descriptor (plan_op5 ())
    elif rust_std_string.model.equals input "6" then op_descriptor (plan_op6 ())
    elif rust_std_string.model.equals input "7" then op_descriptor (plan_op7 ())
    else "invalid", "", "", "", "invalid"

let plan_manifest_header_projection (~input : string) : string =
    if rust_std_string.model.equals input "EOIE-PLAN-IR\t1" then "1" else codec_empty ()

let plan_manifest_row_hex_tuple (~input : string) : string * string * string * string * string =
    inl text_len = sm.length input : i32
    inl tab = char_tab ()
    inl first = find_char input 0i32 tab
    if (=.) first text_len then codec_empty (), codec_empty (), codec_empty (), codec_empty (), codec_empty ()
    else
        inl second = find_char input ((+.) first 1i32) tab
        if (=.) second text_len then codec_empty (), codec_empty (), codec_empty (), codec_empty (), codec_empty ()
        else
            inl third = find_char input ((+.) second 1i32) tab
            if (=.) third text_len then codec_empty (), codec_empty (), codec_empty (), codec_empty (), codec_empty ()
            else
                inl fourth = find_char input ((+.) third 1i32) tab
                if (=.) fourth text_len then codec_empty (), codec_empty (), codec_empty (), codec_empty (), codec_empty ()
                else
                    inl fifth = find_char input ((+.) fourth 1i32) tab
                    if (=.) fifth text_len then codec_empty (), codec_empty (), codec_empty (), codec_empty (), codec_empty ()
                    else
                        inl extra = find_char input ((+.) fifth 1i32) tab
                        inl marker = slice_exclusive input 0i32 first
                        if (<) extra text_len then
                            codec_empty (), codec_empty (), codec_empty (), codec_empty (), codec_empty ()
                        elif rust_std_string.model.equals marker "op" then
                            slice_exclusive input ((+.) first 1i32) second,
                            slice_exclusive input ((+.) second 1i32) third,
                            slice_exclusive input ((+.) third 1i32) fourth,
                            slice_exclusive input ((+.) fourth 1i32) fifth,
                            slice_exclusive input ((+.) fifth 1i32) text_len
                        else
                            codec_empty (), codec_empty (), codec_empty (), codec_empty (), codec_empty ()

let plan_manifest_projection_witness () : i32 =
    inl header = plan_manifest_header_projection "EOIE-PLAN-IR\t1"
    if rust_std_string.model.equals header "1" then
        inl invalid_header = plan_manifest_header_projection "EOIE-PLAN-IR\t2"
        if rust_std_string.model.equals invalid_header "" then
            inl op_hex, target_hex, expected_hex, payload_hex, effect_hex = plan_manifest_row_hex_tuple "op\t01\t02\t03\t04\t05"
            if rust_std_string.model.equals op_hex "01" then
                if rust_std_string.model.equals target_hex "02" then
                    if rust_std_string.model.equals expected_hex "03" then
                        if rust_std_string.model.equals payload_hex "04" then
                            if rust_std_string.model.equals effect_hex "05" then
                                inl invalid_op, invalid_target, invalid_expected, invalid_payload, invalid_effect = plan_manifest_row_hex_tuple "op\t01\t02\t03\t04\t05\t06"
                                if rust_std_string.model.equals invalid_op "" then
                                    if rust_std_string.model.equals invalid_target "" then
                                        if rust_std_string.model.equals invalid_expected "" then
                                            if rust_std_string.model.equals invalid_payload "" then
                                                if rust_std_string.model.equals invalid_effect "" then 1i32 else 0i32
                                            else 0i32
                                        else 0i32
                                    else 0i32
                                else 0i32
                            else 0i32
                        else 0i32
                    else 0i32
                else 0i32
            else 0i32
        else 0i32
    else 0i32

let plan_provider_count () : i32 = 8i32

let plan_stage_witness () : i32 =
    inl _ : plan_stage plan_raw plan_canonical = Canonicalize
    inl _ : plan_stage plan_canonical plan_consumed = Consume
    1i32

let plan_index_valid (~input : string) : u64 =
    if rust_std_string.model.pipe_member "0|1|2|3|4|5|6|7" input then 1u64 else 0u64

let plan_decode_code (~op : string) (~target : string) (~expected : string) (~payload : string) (~effect : string) : u64 =
    if rust_std_string.model.equals op "create" && rust_std_string.model.equals effect "write" then
        if rust_std_string.model.pipe_member "|-" target then 8u64
        elif rust_std_string.model.equals expected "-" then 0u64
        else 8u64
    elif rust_std_string.model.equals op "replace" && rust_std_string.model.equals effect "write" then
        if rust_std_string.model.pipe_member "|-" target then 8u64
        elif rust_std_string.model.pipe_member "|-" expected then 8u64
        else 1u64
    elif rust_std_string.model.equals op "patch-exact" && rust_std_string.model.equals effect "write" then
        if rust_std_string.model.pipe_member "|-" target then 8u64 else 2u64
    elif rust_std_string.model.equals op "mkdir" && rust_std_string.model.equals effect "write" then
        if rust_std_string.model.pipe_member "|-" target then 8u64
        elif rust_std_string.model.equals expected "-" && rust_std_string.model.equals payload "-" then 3u64
        else 8u64
    elif rust_std_string.model.equals op "toolchain" && rust_std_string.model.equals effect "toolchain" then
        if rust_std_string.model.pipe_member "|-" target then 8u64
        elif rust_std_string.model.equals expected "-" && rust_std_string.model.equals payload "-" then 4u64
        else 8u64
    elif rust_std_string.model.equals op "copy" && rust_std_string.model.equals effect "write" then
        if rust_std_string.model.pipe_member "|-" target then 8u64
        elif rust_std_string.model.pipe_member "|-" expected then 8u64
        elif rust_std_string.model.pipe_member "|-" payload then 8u64
        else 5u64
    elif rust_std_string.model.equals op "chmod" && rust_std_string.model.equals effect "write" then
        if rust_std_string.model.pipe_member "|-" target then 8u64
        elif rust_std_string.model.pipe_member "|-" expected then 8u64
        elif rust_std_string.model.pipe_member "|-" payload then 8u64
        else 6u64
    elif rust_std_string.model.equals op "symlink" && rust_std_string.model.equals effect "write" then
        if rust_std_string.model.pipe_member "|-" target then 8u64
        elif rust_std_string.model.equals expected "-" then
            if rust_std_string.model.pipe_member "|-" payload then 8u64 else 7u64
        else 8u64
    else 8u64
