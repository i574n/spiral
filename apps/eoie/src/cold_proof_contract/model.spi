nominal cold_proof_raw = ()
nominal cold_proof_inspected = ()
nominal cold_proof_verified = ()
nominal cold_proof_closed = ()

union cold_proof_gate =
    | CensusGate
    | MigrationGate
    | WorkspaceGate
    | StateCoreGate
    | BinaryGate

union cold_proof_policy =
    | RejectColdProofHeader
    | RejectColdProofGateShape
    | RejectColdProofStaleEvidence
    | RejectColdProofCensusDrift
    | RejectColdProofReplayGap
    | AuthorizeColdProofClosure

union cold_proof_op from to =
    | InspectColdProof :: cold_proof_op cold_proof_raw cold_proof_inspected
    | VerifyColdProof :: cold_proof_op cold_proof_inspected cold_proof_verified
    | CloseColdProof :: cold_proof_op cold_proof_verified cold_proof_closed

union rec cold_proof_plan from to =
    | ColdProofStep :: forall from to. cold_proof_op from to -> cold_proof_plan from to
    | ColdProofThen :: forall from to. (exists middle. cold_proof_plan from middle * cold_proof_plan middle to) -> cold_proof_plan from to

inl cold_proof_public_plan () : cold_proof_plan cold_proof_raw cold_proof_closed =
    ColdProofThen (exists (
        ColdProofStep InspectColdProof,
        ColdProofThen (exists (
            ColdProofStep VerifyColdProof,
            ColdProofStep CloseColdProof
        ))
    ))
