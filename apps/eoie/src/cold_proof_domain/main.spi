open cold_proof_bindings.bindings
open cold_rebuild_contract.bindings

inl main () : i32 =
    inl _ = cold_proof_equal_binding 1i32 1i32
    inl _ = cold_rebuild_expected_shards_binding 90i32 2i32
    emit_runtime ()
    emit_cold_rebuild_runtime ()
    !!!!Export("eoie_cold_proof_equal_binding", ((fun (first, second) => cold_proof_equal_binding first second) : i32 * i32 -> i32))
    !!!!Export("eoie_cold_rebuild_expected_shards", ((fun (first, second) => cold_rebuild_expected_shards_binding first second) : i32 * i32 -> i32))
    0i32
