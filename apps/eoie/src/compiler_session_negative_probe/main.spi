open compiler_session_contract.model

inl main () : i32 =
    inl bad_lane = lane_binding 8i32 8i32
    inl bad_open = revision_binding 1i32 0i32 0i32
    inl bad_change = revision_binding 1i32 1i32 2i32
    inl bad_cache = cache_binding 2i32 1i32
    inl bad_request = request_binding 5i32
    inl bad_shutdown = shutdown_binding 1i32
    if !!!!EQ(bad_lane,0i32) then
        if !!!!EQ(bad_open,0i32) then
            if !!!!EQ(bad_change,0i32) then
                if !!!!EQ(bad_cache,0i32) then
                    if !!!!EQ(bad_request,0i32) then
                        if !!!!EQ(bad_shutdown,0i32) then 0i32 else 6i32
                    else 5i32
                else 4i32
            else 3i32
        else 2i32
    else 1i32
