// EOIE executable contracts. Each transition is exercised through the public process boundary.
open public_contract_types.types

union contract_op from to result =
    | IdentifySurface :: contract_subject -> contract_op contract_cold contract_identified string
    | MutateTransactionally :: contract_subject -> contract_op contract_identified contract_mutated string
    | CloseFlatBundle :: contract_subject -> contract_op contract_mutated contract_bundled string
    | ProveCoveragePrune :: contract_subject -> contract_op contract_bundled contract_evidenced string
    | CloseContracts :: contract_subject -> contract_op contract_evidenced contract_closed string

nominal process_contract from to result = contract_op from to result
prototype interpret interpreter from to result : interpreter from to result -> string

instance interpret process_contract = fun (process_contract op) =>
    match op with
    | IdentifySurface _ => "contract-public-surface"
    | MutateTransactionally _ => "contract-typed-mutation"
    | CloseFlatBundle _ => "contract-flat-bundle"
    | ProveCoveragePrune _ => "contract-coverage-prune"
    | CloseContracts _ => "contract-closed"

union rec contract_plan from to =
    | ContractStep :: forall from to. (exists result. contract_op from to result * result) -> contract_plan from to
    | ContractThen :: forall from to. (exists middle. contract_plan from middle * contract_plan middle to) -> contract_plan from to

inl release_contract () : contract_plan contract_cold contract_closed =
    ContractThen (exists (
        ContractStep (exists (IdentifySurface PublicSurface, "identified")),
        ContractThen (exists (
            ContractStep (exists (MutateTransactionally TypedMutation, "mutated")),
            ContractThen (exists (
                ContractStep (exists (CloseFlatBundle FlatBundle, "bundled")),
                ContractThen (exists (
                    ContractStep (exists (ProveCoveragePrune CoveragePruning, "evidenced")),
                    ContractStep (exists (CloseContracts RootedFilesystem, "closed"))))))))))

inl emit_main () : i32 =
    rust_library ()
    emit_contract_harness ()
    rust_global "include!(concat!(env!(\"CARGO_MANIFEST_DIR\"), \"/native_tools.rs\"));"
    0i32
