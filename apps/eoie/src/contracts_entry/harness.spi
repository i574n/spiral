    rust_global "    let root = bundle_fixture();\n    let archive = root.with_extension(\"zip\");\n    let root_text = root.to_str().expect(\"root text\");\n    let archive_text = archive.to_str().expect(\"archive text\");\n    run_ok(&[\"bundle\", \"check\", root_text]);"
