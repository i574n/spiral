    rust_global "#[test]"
    rust_global "#[ignore = \"requires a Spiral facade with --check/--plan-ir; run build.ps1 -Test -CompilerContracts\"]\nfn coverage_pruning_requires_two_zero_hit_profiles_and_rolls_back() {"
    rust_global "    let root = temporary(\"coverage\");\n    fs::create_dir_all(root.join(\"state\")).expect(\"state\");\n    write(&root.join(\"state/package.spiproj\"), \"modules:\\n    prune_receipts\\n\");\n    write(&root.join(\"state/prune_receipts.spi\"), \"union prune_receipt = | PruneReceipt :: string * string * string * string -> prune_receipt\\ninl main () : i32 = 0i32\\n\");\n    let source = root.join(\"candidate.rs\");\n    write(&source, \"candidate\\n\");\n    let lcov = format!(\"SF:{}\\nDA:1,0\\nend_of_record\\n\", source.display());\n    let test = root.join(\"test.lcov\");\n    let smoke = root.join(\"smoke.lcov\");\n    write(&test, &lcov);\n    write(&smoke, &lcov);\n    let root_text = root.to_str().expect(\"root text\");\n    let test_text = test.to_str().expect(\"test text\");\n    let smoke_text = smoke.to_str().expect(\"smoke text\");\n    assert!(!run(&[\"proxy\", \"prune-uncovered\", root_text, \"candidate.rs\", test_text, smoke_text, \"--\", native_test_tool(\"false\")]).status.success());\n    assert!(source.exists());\n    run_ok(&[\"proxy\", \"prune-uncovered\", root_text, \"candidate.rs\", test_text, smoke_text, \"--\", native_test_tool(\"true\")]);\n    assert!(!source.exists());\n    fs::remove_dir_all(root).expect(\"cleanup\");\n}"

    rust_global "#[test]\nfn public_rejections_and_bundle_drift_fail_closed() {\n    let root = bundle_fixture(); let root_text = root.to_str().expect(\"root text\");\n    write(&root.join(\"drift.txt\"), \"drift\"); assert!(!run(&[\"bundle\", \"check\", root_text]).status.success()); fs::remove_file(root.join(\"drift.txt\")).expect(\"remove drift\");\n    let cases: &[&[&str]] = &[&[\"status\", \"extra\"], &[\"unknown\"], &[\"patch\"], &[\"agile\"], &[\"bundle\"], &[\"proxy\"], &[\"proxy\", \"fs-read\"], &[\"proxy\", \"fs-slice\", \"/tmp\", \"x\", \"bad\", \"1\"]];\n    for args in cases { assert!(!run(args).status.success(), \"unexpected success: {args:?}\"); }\n    fs::remove_dir_all(root).expect(\"cleanup\");\n}"

    rust_global "#[test]\nfn proxy_surface_and_coverage_assessment_are_complete() {\n    let root = temporary(\"proxy-complete\");\n    fs::create_dir_all(&root).expect(\"root\");\n    let root_text = root.to_str().expect(\"root text\");\n    run_ok(&[\"proxy\", \"fs-write\", root_text, \"a/value.txt\", \"alpha\\nbeta\\n\"]);\n    run_ok(&[\"proxy\", \"fs-list\", root_text, \"a\"]);\n    run_ok(&[\"proxy\", \"fs-read\", root_text, \"a/value.txt\", \"64\"]);\n    run_ok(&[\"proxy\", \"fs-slice\", root_text, \"a/value.txt\", \"1\", \"2\"]);\n    run_ok(&[\"proxy\", \"fs-search\", root_text, \"a\", \"beta\"]);\n    run_ok(&[\"proxy\", \"fs-copy\", root_text, \"a/value.txt\", \"a/copy.txt\"]);\n    run_ok(&[\"proxy\", \"hash\", root.join(\"a/copy.txt\").to_str().expect(\"copy\")]);\n    run_ok(&[\"proxy\", \"fs-remove\", root_text, \"a/copy.txt\"]);\n    assert!(!run(&[\"proxy\", \"fs-remove-tree\", root_text, \".\"]).status.success());\n    let named_run = run_ok(&[\"proxy\", \"run\", \"--cwd\", root_text, \"--program\", native_test_tool(\"printenv\"), \"--env\", \"EOIE_RUN_PROBE=green\", \"--env\", \"SECRET_TOKEN=hidden\", \"--\", \"EOIE_RUN_PROBE\"]); assert!(named_run.contains(\"green\") && named_run.contains(\"mode=named\") && named_run.contains(\"process-exit receipt\") && named_run.contains(\"wrapper_status=passed\") && named_run.contains(\"child_exit=0\") && named_run.contains(\"stderr_digest=fnv1a64:\") && named_run.contains(\"retryability=not_retryable\") && named_run.contains(\"env_names=EOIE_RUN_PROBE\") && !named_run.contains(\"SECRET_TOKEN\")); let run_help = run_ok(&[\"help\", \"proxy\", \"run\"]); assert!(run_help.contains(\"--cwd\") && run_help.contains(\"--program\") && run_help.contains(\"--env\"));\n    let misuse = run(&[\"proxy\", \"run\", root_text, native_test_tool(\"true\")]); let misuse_err = String::from_utf8_lossy(&misuse.stderr); assert!(!misuse.status.success() && misuse_err.contains(\"unexpected proxy run argument\") && misuse_err.contains(\"--cwd\")); let timeout_run = run(&[\"proxy\", \"run\", \"--cwd\", root_text, \"--program\", native_test_tool(\"sleep\"), \"--timeout-ms\", \"10\", \"--\", \"1\"]); let timeout_stdout = String::from_utf8_lossy(&timeout_run.stdout); assert!(!timeout_run.status.success() && timeout_stdout.contains(\"wrapper_status=timed_out\") && timeout_stdout.contains(\"timeout=1\") && timeout_stdout.contains(\"retryability=retryable\")); let rejected_run = run(&[\"proxy\", \"run\", \"--cwd\", root_text, \"--program\", \"/definitely/missing/eoie-command\", \"--timeout-ms\", \"1000\"]); let rejected_stdout = String::from_utf8_lossy(&rejected_run.stdout); assert!(!rejected_run.status.success() && rejected_stdout.contains(\"wrapper_status=rejected\") && rejected_stdout.contains(\"retryability=retryable\"));\n    run_ok(&[\"proxy\", \"spiral-session-shutdown\", native_test_tool(\"true\"), \"1000\"]);\n    write(&root.join(\"src/target/debug/artifact\"), \"cache\");\n    run_ok(&[\"proxy\", \"prune-build-cache\", root_text, \"src/target\"]);\n    let source = root.join(\"candidate.rs\");\n    write(&source, \"one\\ntwo\\n\");\n    let test = root.join(\"test.lcov\");\n    let smoke = root.join(\"smoke.lcov\");\n    write(&test, &format!(\"SF:{}\\nDA:1,1\\nDA:2,0\\nend_of_record\\n\", source.display()));\n    write(&smoke, &format!(\"SF:{}\\nDA:1,0\\nDA:2,1\\nend_of_record\\n\", source.display()));\n    run_ok(&[\"proxy\", \"coverage-assess\", test.to_str().expect(\"test\"), smoke.to_str().expect(\"smoke\"), \"500\", \"500\", \"1000\"]);\n    assert!(!run(&[\"proxy\", \"coverage-assess\", test.to_str().expect(\"test\"), smoke.to_str().expect(\"smoke\"), \"501\", \"500\", \"1000\"]).status.success());\n    assert!(!run(&[\"proxy\", \"prune-uncovered\", root_text, \"candidate.rs\", test.to_str().expect(\"test\"), smoke.to_str().expect(\"smoke\"), \"--\", native_test_tool(\"true\")]).status.success());\n    fs::remove_dir_all(root).expect(\"cleanup\");\n}"



    rust_global "#[test]\nfn family_contract_semantic_drift_is_rejected() {\n    let root = bundle_fixture();\n    let root_text = root.to_str().expect(\"root text\");\n    let catalog_path = root.join(\"state/legacy_catalog.spi\");\n    let original_hash = run_ok(&[\"proxy\", \"hash\", root_text, \"state/legacy_catalog.spi\"]).trim().to_owned();\n    let catalog = fs::read_to_string(&catalog_path).expect(\"family catalog\").replacen(\"CapabilityFamily (\\\"family-0\\\"\", \"CapabilityFamily (\\\"family-x\\\"\", 1); write(&catalog_path, &catalog);\n    let changed_hash = run_ok(&[\"proxy\", \"hash\", root_text, \"state/legacy_catalog.spi\"]).trim().to_owned();\n    for relative in [\"state/differential_catalog.spi\", \"state/family_contracts.spi\"] { let path = root.join(relative); let text = fs::read_to_string(&path).expect(\"catalog receipt\").replace(&original_hash, &changed_hash); write(&path, &text); }\n    let output = run(&[\"bundle\", \"check\", root_text]);\n    assert!(!output.status.success() && String::from_utf8_lossy(&output.stderr).contains(\"family contract catalog mismatch\"));\n    fs::remove_dir_all(root).expect(\"cleanup\");\n}"

    rust_global "#[test]\nfn typed_handoff_is_readable_and_versionless() {\n    let surface = run_ok(&[\"status\"]); assert!(surface.contains(\"spiral_first=true\") && !surface.contains(\"alpha=\") && run_ok(&[\"help\"]).contains(\"usage: eoie\") && !run(&[\"unknown\"]).status.success());\n    let root = temporary(\"handoff\");\n    fs::create_dir_all(root.join(\"state\")).expect(\"state\");\n    write(&root.join(\"state/handoff.spi\"), \"union handoff_section = | HandoffSection :: string * string -> handoff_section\\ninl a () : handoff_section = HandoffSection (\\\"Identity\\\", \\\"Spiral-first embodiment\\\")\\ninl b () : handoff_section = HandoffSection (\\\"Proven\\\", \\\"Transactional patch and flat bundles\\\")\\ninl c () : handoff_section = HandoffSection (\\\"Risks\\\", \\\"Verification and catalog depth\\\")\\ninl d () : handoff_section = HandoffSection (\\\"Resume\\\", \\\"Acquire lease and check state\\\")\\ninl main () : i32 = 0i32\\n\");\n    write(&root.join(\"state/ratings.spi\"), \"inl active_codebase_readiness () : u32 = 477u32\\ninl subjective_phase_ceiling () : u32 = 620u32\\ninl active_coverage_attainment () : u32 = 804u32\\ninl phase_runtime_drift () : phase_dimension = PhaseDimension (x, 510u32, 12u32)\\ninl phase_parallel_readiness () : phase_dimension = PhaseDimension (x, 550u32, 8u32)\\ninl phase_plan_ir () : phase_dimension = PhaseDimension (x, 750u32, 10u32)\\ninl migration () = Rating (MigrationCompleteness, 987u32, 0i32)\\n\");\n    write(&root.join(\"state/authority_census.spi\"), \"inl current_authority_census () : authority_census = AuthorityCensus (446u32, 90u32, 1973u32, 19068u32, 27437u32, 81u32, 239u32, 158u32, 996u32, 957u32)\\n\");\n    write(&root.join(\"state/agile.spi\"), \"inl task () = Task (\\\"LIVE\\\", \\\"Current work\\\", TaskKind, P0, D4, 50u32, Active, \\\"\\\", \\\"handoff\\\", \\\"current\\\", \\\"current\\\")\\n\");\n    let output = run_ok(&[\"agile\", \"handoff\", root.to_str().expect(\"root\")]);\n    assert!(output.contains(\"# EOIE handoff\"));\n    assert!(output.contains(\"## Identity\") && output.contains(\"## Resume\"));\n    assert!(output.contains(\"## Live state\") && output.contains(\"active_readiness=477/1000\") && output.contains(\"rust_global_sites=1973\"));\n    assert!(output.contains(\"## Active work\") && output.contains(\"P0 Active 50% LIVE\"));\n    assert!(!output.contains(\"alpha=\"));\n    fs::remove_dir_all(root).expect(\"cleanup\");\n}"

    rust_global "#[test]"
    rust_global "#[ignore = \"requires a Spiral facade with --check/--plan-ir; run build.ps1 -Test -CompilerContracts\"]\nfn patch_and_agile_failures_preserve_authority() {"
    rust_global "    let root = temporary(\"mutation-failure\");\n    fs::create_dir_all(root.join(\"state\")).expect(\"state\");\n    write(&root.join(\"value.txt\"), \"old\");\n    write(&root.join(\"state/package.spiproj\"), \"modules:\\n    plan\\n    agile\\n    prompt\\n\");\n    write(&root.join(\"state/plan.spi\"), \"inl main () : i32 =\\n    $\\\"RustPlanOp(\\\\\\\"patch-exact\\\\\\\",\\\\\\\"value.txt\\\\\\\",\\\\\\\"absent\\\\\\\",\\\\\\\"new\\\\\\\",\\\\\\\"write\\\\\\\")\\\" : ()\\n    0i32\\n\");\n    write(&root.join(\"state/agile.spi\"), \"union task_kind = | Epic :: task_kind\\nunion priority = | P0 :: priority\\nunion difficulty = | D1 :: difficulty\\nunion task_status = | Planned :: task_status | Active :: task_status\\nunion agile_item = | Task :: string * string * task_kind * priority * difficulty * u32 * task_status * string * string * string * string -> agile_item\\ninl task () : agile_item = Task (\\\"ID\\\", \\\"title\\\", Epic, P0, D1, 0u32, Planned, \\\"\\\", \\\"tag\\\", \\\"bootstrap\\\", \\\"bootstrap\\\")\\ninl main () : i32 = 0i32\\n\");"
    rust_global "    write(&root.join(\"state/prompt.spi\"), \"union lease_status = | LeaseActive :: lease_status | LeaseClosed :: lease_status\\nunion prompt_lease = | PromptLease :: string * string * u64 * u64 * u64 * u64 * lease_status -> prompt_lease\\ninl current () : prompt_lease = PromptLease (\\\"fixture\\\", \\\"typed fixture prompt\\\", 3000000u64, 600000u64, 1000u64, 3601000u64, LeaseActive)\\ninl main () : i32 = 0i32\\n\");\n    run_ok(&[\"agile\", \"begin\", root.to_str().expect(\"root\"), \"fresh mutation fixture lease\"]);"
    rust_global "    let root_text = root.to_str().expect(\"root text\");\n    let plan = root.join(\"state/plan.spi\");\n    assert!(!run(&[\"patch\", \"apply\", root_text, plan.to_str().expect(\"plan\")]).status.success());\n    assert_eq!(fs::read_to_string(root.join(\"value.txt\")).expect(\"value\"), \"old\");\n    write(&plan, \"inl main () : i32 = 0i32\\n\");\n    assert!(!run(&[\"patch\", \"apply\", root_text, plan.to_str().expect(\"plan\")]).status.success());\n    write(&plan, \"inl main () : i32 =\\n    $\\\"RustPlanOp(\\\\\\\"patch-exact\\\\\\\",\\\\\\\"../escape.txt\\\\\\\",\\\\\\\"old\\\\\\\",\\\\\\\"new\\\\\\\",\\\\\\\"write\\\\\\\")\\\" : ()\\n    0i32\\n\");\n    assert!(!run(&[\"patch\", \"apply\", root_text, plan.to_str().expect(\"plan\")]).status.success());\n    assert!(!root.parent().expect(\"parent\").join(\"escape.txt\").exists());\n    run_ok(&[\"agile\", \"list\", root_text]);\n    run_ok(&[\"agile\", \"check\", root_text]);\n    assert!(!run(&[\"agile\", \"set\", root_text, \"MISSING\", \"1\", \"Active\"]).status.success());\n    assert!(!run(&[\"agile\", \"set\", root_text, \"ID\", \"101\", \"Active\"]).status.success());\n    assert!(!run(&[\"agile\", \"set\", root_text, \"ID\", \"12x\", \"Active\"]).status.success());\n    assert!(!run(&[\"agile\", \"set\", root_text, \"ID\", \"1\", \"active\"]).status.success());\n    assert!(!run(&[\"agile\", \"set\", root_text, \"ID\", \"1\", \"Invalid\"]).status.success());\n    assert!(!run(&[\"agile\", \"begin\", root_text, \"too short\"]).status.success());\n    assert!(!run(&[\"agile\", \"begin\", root_text, \"one two three four five six seven eight\"]).status.success());\n    fs::remove_dir_all(root).expect(\"cleanup\");\n}"
