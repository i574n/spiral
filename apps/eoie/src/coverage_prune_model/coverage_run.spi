inl rust_global (x : string) : () = real typecase `(!!!!LitToTypeLit(x)) with ~x => $"RustGlobal(@x)" : ()

inl emit_coverage_run () : () =
    rust_global "fn coverage_run_test_args(scope: &str, jobs: &str) -> Result<Vec<String>, String> {"
    rust_global "    let mut args = vec![\"test\".to_owned(), \"--offline\".to_owned(), \"--locked\".to_owned(), \"--release\".to_owned()];"
    rust_global "    match scope {"
    rust_global "        \"public\" => args.extend([\"-p\", \"eoie-contracts\", \"--lib\"].into_iter().map(str::to_owned)),"
    rust_global "        \"workspace\" => args.extend([\"--workspace\", \"--lib\", \"--bins\", \"--tests\"].into_iter().map(str::to_owned)),"
    rust_global "        value if value.starts_with(\"owner:\") => { let package = &value[6..]; if package.is_empty() || !package.chars().all(|ch| ch.is_ascii_alphanumeric() || ch == '-' || ch == '_') { return Err(\"coverage owner scope is invalid\".to_owned()); } args.extend([\"-p\".to_owned(), package.to_owned(), \"--all-targets\".to_owned()]); },"
    rust_global "        _ => return Err(\"coverage scope must be public workspace smoke or owner:<package>\".to_owned()),"
    rust_global "    } // coverage_run_test_args match"
    rust_global "    args.extend([\"--jobs\".to_owned(), jobs.to_owned()]);"
    rust_global "    Ok(args)"
    rust_global "} // coverage_run_test_args"
    rust_global ""
    rust_global "fn coverage_clear_profraw(path: &Path) -> Result<usize, String> {"
    rust_global "    fs::create_dir_all(path).map_err(|error| format!(\"create {}: {error}\", path.display()))?;"
    rust_global "    let mut removed = 0usize;"
    rust_global "    for entry in fs::read_dir(path).map_err(|error| format!(\"read {}: {error}\", path.display()))? {"
    rust_global "        let child = entry.map_err(|error| error.to_string())?.path();"
    rust_global "        if child.is_file() && child.extension().and_then(|value| value.to_str()) == Some(\"profraw\") {"
    rust_global "            fs::remove_file(&child).map_err(|error| format!(\"remove {}: {error}\", child.display()))?;"
    rust_global "            removed += 1;"
    rust_global "        } // coverage_clear_profraw if"
    rust_global "    } // coverage_clear_profraw loop"
    rust_global "    Ok(removed)"
    rust_global "} // coverage_clear_profraw"
    rust_global ""
    rust_global "fn coverage_profile_count(path: &Path) -> Result<usize, String> {"
    rust_global "    Ok(fs::read_dir(path).map_err(|error| format!(\"read {}: {error}\", path.display()))?.filter_map(Result::ok).filter(|entry| entry.path().extension().and_then(|value| value.to_str()) == Some(\"profraw\")).count())"
    rust_global "} // coverage_profile_count"
    rust_global ""
    rust_global "struct CoverageRunContext<'a> { cargo: &'a Path, source: &'a Path, target: &'a Path, profile_pattern: &'a str, compiler: &'a Path, binary: &'a Path, jobs: &'a str, timeout_ms: u64 }"
    rust_global ""
    rust_global "fn coverage_run_phase(context: &CoverageRunContext<'_>, command_args: &[String], phase: &str) -> Result<(), String> {"
    rust_global "    let started = std::time::Instant::now();"
    rust_global "    let mut command = Command::new(context.cargo);"
    rust_global "    command.current_dir(context.source).args(command_args).env(\"CARGO_TARGET_DIR\", context.target).env(\"CARGO_INCREMENTAL\", \"1\").env(\"RUSTFLAGS\", \"-C instrument-coverage\").env(\"LLVM_PROFILE_FILE\", context.profile_pattern).env(\"EOIE_SPIRAL_COMPILE\", context.compiler).env(\"EOIE_BIN_UNDER_TEST\", context.binary).env(\"RAYON_NUM_THREADS\", context.jobs);"
    rust_global "    let _observation = coverage_run_bounded_streaming_checked(&mut command, context.timeout_ms, phase, None)?;"

    rust_global "    println!(\"eoie coverage phase={phase} status=passed elapsed_ms={}\", started.elapsed().as_millis());"
    rust_global "    Ok(()) // coverage_run_phase"
    rust_global "} // coverage_run_phase"
    rust_global ""
    rust_global "pub fn coverage_run(args: &[String]) -> Result<(), String> {"
    rust_global "    if args.len() != 8 { return Err(\"coverage-run expects root cargo compiler target-dir profraw-dir public|workspace|smoke|owner:<package> timeout-ms\".to_owned()); }"
    rust_global "    let root = Path::new(coverage_arg(args, 1, \"root\")?);"
    rust_global "    let source = root.join(\"src\");"
    rust_global "    let cargo = Path::new(coverage_arg(args, 2, \"cargo\")?);"
    rust_global "    let compiler = Path::new(coverage_arg(args, 3, \"compiler\")?);"
    rust_global "    let target = Path::new(coverage_arg(args, 4, \"target-dir\")?);"
    rust_global "    let profraw = Path::new(coverage_arg(args, 5, \"profraw-dir\")?);"
    rust_global "    let scope = coverage_arg(args, 6, \"scope\")?;"
    rust_global "    let timeout_ms = coverage_arg(args, 7, \"timeout-ms\")?.parse::<u64>().map_err(|_| \"coverage timeout must be a positive integer\".to_owned())?;"
    rust_global "    if timeout_ms == 0 { return Err(\"coverage timeout must be positive\".to_owned()); }"
    rust_global "    if !source.join(\"Cargo.toml\").is_file() { return Err(format!(\"coverage root has no src/Cargo.toml: {}\", root.display())); }"
    rust_global "    if !cargo.is_file() || !compiler.is_file() { return Err(\"coverage cargo and compiler must be files\".to_owned()); }"
    rust_global "    fs::create_dir_all(target).map_err(|error| format!(\"create {}: {error}\", target.display()))?;"
    rust_global "    let jobs = env::var(\"EOIE_COVERAGE_JOBS\").unwrap_or_else(|_| \"56\".to_owned());"
    rust_global "    let profile_pattern = profraw.join(\"%p-%m.profraw\").to_string_lossy().into_owned();"
    rust_global "    let binary = target.join(\"release\").join(if cfg!(windows) { \"eoie.exe\" } else { \"eoie\" });"
    rust_global "    let smoke_child = env::var(\"EOIE_COVERAGE_SMOKE_CHILD\").ok().as_deref() == Some(\"1\");"
    rust_global "    if smoke_child {"
    rust_global "        if scope != \"smoke\" { return Err(\"coverage smoke child requires smoke scope\".to_owned()); }"
    rust_global "        if !binary.is_file() { return Err(format!(\"instrumented EOIE binary missing: {}\", binary.display())); }"
    rust_global "        let smoke_context = CoverageSmokeContext { root, cargo, compiler, binary: &binary, target, profile_pattern: &profile_pattern, timeout_ms };"
    rust_global "        coverage_smoke_run(&smoke_context)?;"
    rust_global "        println!(\"eoie coverage smoke child ok target={}\", target.display());"
    rust_global "        return Ok(());"
    rust_global "    }"
    rust_global "    let removed = coverage_clear_profraw(profraw)?;"
    rust_global "    let build = [\"build\", \"--offline\", \"--locked\", \"--release\", \"-p\", \"eoie-cli\", \"--bin\", \"eoie\", \"--jobs\", jobs.as_str()].into_iter().map(str::to_owned).collect::<Vec<_>>();"
    rust_global "    let context = CoverageRunContext { cargo, source: &source, target, profile_pattern: &profile_pattern, compiler, binary: &binary, jobs: &jobs, timeout_ms };"
    rust_global "    coverage_run_phase(&context, &build, \"build-binary\")?;"
    rust_global "    if !binary.is_file() { return Err(format!(\"instrumented EOIE binary missing: {}\", binary.display())); }"
    rust_global "    if scope == \"smoke\" {"
    rust_global "        let mut command = Command::new(&binary);"
    rust_global "        command.current_dir(root).arg(\"proxy\").args(args).env(\"EOIE_COVERAGE_SMOKE_CHILD\", \"1\").env(\"LLVM_PROFILE_FILE\", &profile_pattern).env(\"EOIE_SPIRAL_COMPILE\", compiler).env(\"EOIE_BIN_UNDER_TEST\", &binary).env(\"CARGO_TARGET_DIR\", target).env(\"RAYON_NUM_THREADS\", &jobs);"
    rust_global "        let _observation = coverage_run_bounded_streaming_checked(&mut command, timeout_ms, \"smoke-reentry\", None)?;"
    rust_global "    } else {"
    rust_global "        let tests = coverage_run_test_args(scope, &jobs)?;"
    rust_global "        coverage_run_phase(&context, &tests, \"contracts\")?;"
    rust_global "    } // coverage_run smoke branch"
    rust_global "    let profiles = coverage_profile_count(profraw)?;"
    rust_global "    if profiles == 0 { return Err(\"coverage run produced no profraw files\".to_owned()); }"
    rust_global "    println!(\"eoie proxy coverage-run ok scope={scope} profiles={profiles} cleared={removed} target={}\", target.display());"
    rust_global "    Ok(()) // coverage_run"
    rust_global "} // coverage_run"
    rust_global ""
    rust_global "mod coverage_run_tests {"
    rust_global "    #[test] fn coverage_scope_builds_bounded_test_surfaces() {"
    rust_global "        let public = super::coverage_run_test_args(\"public\", \"56\").expect(\"public\");"
    rust_global "        assert!(public.iter().any(|arg| arg == \"eoie-contracts\"));"
    rust_global "        let workspace = super::coverage_run_test_args(\"workspace\", \"56\").expect(\"workspace\");"
    rust_global "        assert!(workspace.iter().any(|arg| arg == \"--workspace\"));"
    rust_global "        let owner = super::coverage_run_test_args(\"owner:eoie-patch-transaction-contracts\", \"56\").expect(\"owner\");"
    rust_global "        assert!(owner.windows(2).any(|pair| pair == [\"-p\", \"eoie-patch-transaction-contracts\"]));"
    rust_global "        assert!(super::coverage_run_test_args(\"owner:../bad\", \"56\").is_err());"
    rust_global "        assert!(super::coverage_run_test_args(\"unknown\", \"56\").is_err());"
    rust_global "    } // coverage_scope_builds_bounded_test_surfaces"
    rust_global "} // coverage_run_tests"