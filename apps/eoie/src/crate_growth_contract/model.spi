nominal topology_raw = ()
nominal topology_partitioned = ()
nominal cargo_growth_checked = ()
nominal cargo_growth_authorized = ()

union package_authority =
    | CargoOwned
    | SpiralOnlyOwned
    | OwnershipOnly

union cargo_growth_exception =
    | NoCargoGrowthException
    | JustifiedCargoGrowth :: string * string -> cargo_growth_exception

union owner_growth_disposition =
    | OwnerShrinkOrEqual
    | OwnerGrowthCompensated :: string * string -> owner_growth_disposition
    | OwnerGrowthRejected

union cargo_growth_op from to =
    | PartitionSourcePackages :: cargo_growth_op topology_raw topology_partitioned
    | CheckCargoGrowth :: cargo_growth_op topology_partitioned cargo_growth_checked
    | AuthorizeCargoGrowth :: cargo_growth_op cargo_growth_checked cargo_growth_authorized

union rec cargo_growth_plan from to =
    | CargoGrowthStep :: forall from to. cargo_growth_op from to -> cargo_growth_plan from to
    | CargoGrowthThen :: forall from to. (exists middle. cargo_growth_plan from middle * cargo_growth_plan middle to) -> cargo_growth_plan from to

inl baseline_cargo_crates () : u32 = 74u32

inl current_plan () : cargo_growth_plan topology_raw cargo_growth_authorized =
    CargoGrowthThen (exists (
        CargoGrowthStep PartitionSourcePackages,
        CargoGrowthThen (exists (
            CargoGrowthStep CheckCargoGrowth,
            CargoGrowthStep AuthorizeCargoGrowth
        ))
    ))
