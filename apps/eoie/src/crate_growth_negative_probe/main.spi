open crate_growth_contract.bindings

inl main () : i32 =
    inl unauthorized_crate = crate_growth_default_binding 75i32 0i32
    inl incomplete_exception = crate_growth_exception_binding 0i32 1i32
    inl complete_exception = crate_growth_exception_binding 1i32 1i32
    inl authorized_crate = crate_growth_default_binding 75i32 complete_exception
    inl silent_owner_growth = crate_growth_unit_binding 81i32 88i32
    inl undercompensated = owner_growth_compensation_binding 7i32 6i32
    match unauthorized_crate with
    | 0 =>
        match incomplete_exception with
        | 0 =>
            match authorized_crate with
            | 1 =>
                match silent_owner_growth with
                | 0 =>
                    match undercompensated with
                    | 0 => 0i32
                    | _ => 5i32
                | _ => 4i32
            | _ => 3i32
        | _ => 2i32
    | _ => 1i32
