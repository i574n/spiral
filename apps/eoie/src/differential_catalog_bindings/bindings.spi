let differential_catalog_equal_binding (expected : i32) (observed : i32) : i32 =
    if !!!!EQ(expected,observed) then 1i32 else 0i32

inl differential_catalog_shape_binding (gate_mask : i32) (gate_count : i32) : i32 =
    if !!!!EQ(gate_mask,15i32) then
        if !!!!EQ(gate_count,4i32) then 1i32 else 0i32
    else 0i32

inl differential_catalog_settlement_binding (scenarios : i32) (receipts : i32) (evidence_flags : i32) : i32 =
    if !!!!EQ(scenarios,10i32) then
        if !!!!EQ(receipts,9i32) then
            if !!!!EQ(evidence_flags,31i32) then 1i32 else 0i32
        else 0i32
    else 0i32

inl differential_catalog_legacy_binding (cataloged : i32) (decided : i32) (complete : i32) : i32 =
    if !!!!EQ(cataloged,36i32) then
        if !!!!EQ(decided,36i32) then
            if !!!!EQ(complete,1i32) then 1i32 else 0i32
        else 0i32
    else 0i32
