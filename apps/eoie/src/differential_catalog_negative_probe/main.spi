open differential_catalog_bindings.bindings
open differential_catalog_contract.model

inl main () : i32 =
    inl _ = differential_catalog_public_plan ()
    inl good_settlement = differential_catalog_settlement_binding 10i32 9i32 31i32
    inl good_catalog = differential_catalog_legacy_binding 36i32 36i32 1i32
    inl good_shape = differential_catalog_shape_binding 15i32 4i32
    inl bad_settlement = differential_catalog_settlement_binding 10i32 8i32 31i32
    inl bad_catalog = differential_catalog_legacy_binding 36i32 35i32 1i32
    inl bad_shape = differential_catalog_shape_binding 7i32 3i32
    if !!!!EQ(good_settlement,1i32) && !!!!EQ(good_catalog,1i32) && !!!!EQ(good_shape,1i32) then
        if !!!!EQ(bad_settlement,0i32) && !!!!EQ(bad_catalog,0i32) && !!!!EQ(bad_shape,0i32) then 0i32 else 1i32
    else 1i32
