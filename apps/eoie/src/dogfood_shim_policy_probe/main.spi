open dogfood_shim_contract.model

inl main () : i32 =
    match shim_decision_packed_binding 0i32 1i32 with
    | 0 =>
        match shim_decision_packed_binding 1i32 7i32 with
        | 0 =>
            match shim_decision_packed_binding 0i32 6i32 with
            | 1 =>
                match shim_decision_packed_binding 2i32 1i32 with
                | 2 =>
                    match shim_install_packed_binding 9i32 0i32 with
                    | 1 =>
                        match shim_uninstall_binding 1i32 4i32 with
                        | 1 => 0i32
                        | _ => 6i32
                    | _ => 5i32
                | _ => 4i32
            | _ => 3i32
        | _ => 2i32
    | _ => 1i32
