nominal requested = ()
nominal paused = ()
nominal compiled = ()
nominal e2e_proven = ()
nominal bundled = ()

nominal spiral_candidate = ()
nominal primary_fallback = ()
nominal secondary_fallback = ()

union binary_authority authority =
    | SpiralCandidate :: binary_authority spiral_candidate
    | StablePrimary :: binary_authority primary_fallback
    | StableSecondary :: binary_authority secondary_fallback

union bootstrap_op from to result =
    | PauseWork :: string -> bootstrap_op requested paused string
    | ExecuteCandidate :: binary_authority spiral_candidate * string -> bootstrap_op paused compiled string
    | SelfPatchCandidate :: binary_authority spiral_candidate * string -> bootstrap_op paused compiled string
    | PatchWithPrimaryFallback :: binary_authority primary_fallback * string -> bootstrap_op paused compiled string
    | PatchWithSecondaryFallback :: binary_authority secondary_fallback * string -> bootstrap_op paused compiled string
    | ProveE2E :: string -> bootstrap_op compiled e2e_proven string
    | BundleCandidate :: string -> bootstrap_op e2e_proven bundled string

union rec bootstrap_plan from to =
    | BootstrapStep :: forall from to. (exists result. bootstrap_op from to result * result) -> bootstrap_plan from to
    | BootstrapThen :: forall from to. (exists middle. bootstrap_plan from middle * bootstrap_plan middle to) -> bootstrap_plan from to

inl pause_step () : bootstrap_plan requested paused = BootstrapStep (exists (PauseWork "stash-before-capability-gap", "paused"))
inl candidate_step () : bootstrap_plan paused compiled = BootstrapStep (exists (ExecuteCandidate (SpiralCandidate, "candidate-capable"), "compiled"))
inl self_patch_step () : bootstrap_plan paused compiled = BootstrapStep (exists (SelfPatchCandidate (SpiralCandidate, "candidate-heals-itself"), "compiled"))
inl primary_fallback_step () : bootstrap_plan paused compiled = BootstrapStep (exists (PatchWithPrimaryFallback (StablePrimary, "primary-stable-fallback"), "compiled"))
inl secondary_fallback_step () : bootstrap_plan paused compiled = BootstrapStep (exists (PatchWithSecondaryFallback (StableSecondary, "secondary-stable-fallback"), "compiled"))
inl prove_step () : bootstrap_plan compiled e2e_proven = BootstrapStep (exists (ProveE2E "cold-tests-before-dogfood", "proven"))
inl bundle_step () : bootstrap_plan e2e_proven bundled = BootstrapStep (exists (BundleCandidate "flat-root-bundle", "bundled"))

inl route_plan (route : bootstrap_plan paused compiled) : bootstrap_plan requested bundled =
    inl pause = pause_step ()
    inl prove = prove_step ()
    inl bundle = bundle_step ()
    BootstrapThen (exists (pause, BootstrapThen (exists (route, BootstrapThen (exists (prove, bundle))))))

inl candidate_plan () : bootstrap_plan requested bundled = route_plan (candidate_step ())
inl self_patch_plan () : bootstrap_plan requested bundled = route_plan (self_patch_step ())
inl primary_fallback_plan () : bootstrap_plan requested bundled = route_plan (primary_fallback_step ())
inl secondary_fallback_plan () : bootstrap_plan requested bundled = route_plan (secondary_fallback_step ())

inl rec terminal forall from to. (plan : bootstrap_plan from to) : i32 =
    match plan with
    | BootstrapStep payload =>
        inl exists result. op, _ = payload
        match op with
        | PauseWork _ => 6i32
        | ExecuteCandidate _ => 2i32
        | SelfPatchCandidate _ => 3i32
        | PatchWithPrimaryFallback _ => 4i32
        | PatchWithSecondaryFallback _ => 5i32
        | ProveE2E _ => 1i32
        | BundleCandidate _ => 0i32
    | BootstrapThen payload =>
        inl exists middle. _, right = payload
        terminal right

inl bootstrap_probe_result () : i32 = terminal (candidate_plan ())
inl policy_probe_result () : i32 = terminal (self_patch_plan ())
inl primary_fallback_probe_result () : i32 = terminal (primary_fallback_plan ())
inl secondary_fallback_probe_result () : i32 = terminal (secondary_fallback_plan ())
