inl emit_archive_fault_contracts () =
    rust_global "#[cfg(unix)]\nfn archive_snapshot(root: &Path) -> Vec<(String, u32, Vec<u8>)> {\n    use std::os::unix::fs::PermissionsExt as _;\n    fn walk(root: &Path, path: &Path, output: &mut Vec<(String, u32, Vec<u8>)>) {\n        let mut entries = fs::read_dir(path)\n            .expect(\"snapshot read\")\n            .map(|entry| entry.expect(\"snapshot entry\"))\n            .collect::<Vec<_>>();\n        entries.sort_by_key(|entry| entry.file_name());\n        for entry in entries {\n            let child = entry.path();\n            let metadata = fs::symlink_metadata(&child).expect(\"snapshot metadata\");\n            let relative = child\n                .strip_prefix(root)\n                .expect(\"snapshot relative\")\n                .to_string_lossy()\n                .replace('\\\\', \"/\");\n            let mode = metadata.permissions().mode();\n            if metadata.is_dir() && !metadata.file_type().is_symlink() {\n                output.push((format!(\"{relative}/\"), mode, Vec::new()));\n                walk(root, &child, output);\n            } else if metadata.file_type().is_symlink() {\n                output.push((\n                    relative,\n                    mode,\n                    fs::read_link(&child)\n                        .expect(\"snapshot link\")\n                        .to_string_lossy()\n                        .as_bytes()\n                        .to_vec(),\n                ));\n            } else {\n                output.push((relative, mode, fs::read(&child).expect(\"snapshot file\")));\n            }\n        }\n    }\n    let mut output = Vec::new();\n    walk(root, root, &mut output);\n    output\n}\n\n#[cfg(unix)]\nfn run_archive_fault(archive: &Path, destination: &Path, fault: &str) -> Output {\n    Command::new(eoie_binary()).current_dir(env::temp_dir())\n        .args([\n            \"proxy\",\n            \"zip-extract\",\n            archive.to_str().expect(\"archive\"),\n            destination.to_str().expect(\"destination\"),\n        ])\n        .env(\"EOIE_ARCHIVE_FAULT\", fault)\n        .env(\"EOIE_ARCHIVE_MAX_BYTES\", \"4096\")\n        .output()\n        .expect(\"run archive fault\")\n}\n\n#[cfg(unix)]\n#[test]\nfn zip_extract_faults_restore_parent_bytes_before_commit() {\n    let root = temporary(\"zip-faults\");\n    let source = root.join(\"source\");\n    fs::create_dir_all(source.join(\"nested\")).expect(\"source\");\n    write(&source.join(\"first.txt\"), \"first-payload\");\n    write(&source.join(\"nested/second.txt\"), \"second-payload\");\n    write(&root.join(\"sentinel.txt\"), \"outside-stage-must-not-change\");\n    let archive = root.join(\"input.zip\");\n    let zip_status = Command::new(\"zip\")\n        .current_dir(&source)\n        .arg(\"-q\")\n        .arg(&archive)\n        .arg(\"first.txt\")\n        .arg(\"nested/second.txt\")\n        .status()\n        .expect(\"create zip\");\n    assert!(zip_status.success());\n    let before = archive_snapshot(&root);\n    for fault in [\"after-first-payload\", \"before-commit\"] {\n        let destination = root.join(format!(\"out-{fault}\"));\n        let output = run_archive_fault(&archive, &destination, fault);\n        assert!(!output.status.success(), \"fault {fault} unexpectedly passed\");\n        let stderr = String::from_utf8_lossy(&output.stderr);\n        assert!(stderr.contains(\"archive extraction rolled back\"), \"{stderr}\");\n        assert!(stderr.contains(fault), \"{stderr}\");\n        assert!(!destination.exists(), \"fault destination survived: {}\", destination.display());\n        assert_eq!(archive_snapshot(&root), before, \"fault {fault} changed parent bytes or modes\");\n        assert!(\n            fs::read_dir(&root)\n                .expect(\"root entries\")\n                .all(|entry| !entry.expect(\"entry\").file_name().to_string_lossy().contains(\".eoie-extract-\")),\n            \"fault {fault} left extraction staging\"\n        );\n    }\n    let destination = root.join(\"out-success\");\n    let output = Command::new(eoie_binary()).current_dir(env::temp_dir())\n        .args([\n            \"proxy\",\n            \"zip-extract\",\n            archive.to_str().expect(\"archive\"),\n            destination.to_str().expect(\"destination\"),\n        ])\n        .env_remove(\"EOIE_ARCHIVE_FAULT\")\n        .env(\"EOIE_ARCHIVE_MAX_BYTES\", \"4096\")\n        .output()\n        .expect(\"run successful extraction\");\n    assert!(output.status.success(), \"{}\", String::from_utf8_lossy(&output.stderr));\n    assert_eq!(fs::read_to_string(destination.join(\"first.txt\")).expect(\"first\"), \"first-payload\");\n    assert_eq!(\n        fs::read_to_string(destination.join(\"nested/second.txt\")).expect(\"second\"),\n        \"second-payload\"\n    );\n    fs::remove_dir_all(root).expect(\"cleanup faults\");\n}\n"