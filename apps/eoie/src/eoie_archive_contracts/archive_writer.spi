// ZIP writer and reader contract emitted from Spiral.
inl emit_archive_writer_contract () =
    rust_global "\n#[test]\nfn zip_writer_deflate_stored_and_directory_roundtrip() {"
    rust_global "    use std::io::{Read, Write};"
    rust_global "    let root = temporary(\"zip-writer\");\n    fs::create_dir_all(&root).expect(\"root\");\n    let archive_path = root.join(\"writer.zip\");\n    let file = fs::File::create(&archive_path).expect(\"create zip\");\n    let mut writer = zip::ZipWriter::new(file);\n    let deflated = zip::write::FileOptions::default().compression_method(zip::CompressionMethod::Deflated).unix_permissions(0o644);\n    let stored = zip::write::FileOptions::default().compression_method(zip::CompressionMethod::Stored).unix_permissions(0o600);\n    writer.add_directory(\"nested/\", deflated).expect(\"directory\");\n    writer.start_file(\"nested/alpha.txt\", deflated).expect(\"alpha\");\n    writer.write_all(&vec![b'a'; 32768]).expect(\"alpha payload\");\n    writer.start_file(\"beta.bin\", stored).expect(\"beta\");\n    writer.write_all(&[0, 1, 2, 3, 4, 5, 255]).expect(\"beta payload\");\n    let mut file = writer.finish().expect(\"finish zip\");\n    file.sync_all().expect(\"sync zip\");\n    drop(file);\n    let mut archive = zip::ZipArchive::new(fs::File::open(&archive_path).expect(\"open zip\")).expect(\"read zip\");\n    assert_eq!(archive.len(), 3);\n    assert!(archive.by_name(\"nested/\").expect(\"directory entry\").is_dir());\n    let mut alpha = Vec::new(); archive.by_name(\"nested/alpha.txt\").expect(\"alpha entry\").read_to_end(&mut alpha).expect(\"read alpha\");\n    assert_eq!(alpha, vec![b'a'; 32768]);\n    let mut beta = Vec::new(); archive.by_name(\"beta.bin\").expect(\"beta entry\").read_to_end(&mut beta).expect(\"read beta\");\n    assert_eq!(beta, vec![0, 1, 2, 3, 4, 5, 255]);\n    fs::remove_dir_all(root).expect(\"cleanup writer\");\n}"
