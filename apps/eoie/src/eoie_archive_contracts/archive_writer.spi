// ZIP writer and reader contract emitted from Spiral.
inl emit_archive_writer_contract () =
    rust_global ""
    rust_global "#[test]"
    rust_global "fn zip_writer_deflate_stored_and_directory_roundtrip() {"
    rust_global "    use std::io::{Read, Write};"
    rust_global "    let root = temporary(\"zip-writer\");"
    rust_global "    fs::create_dir_all(&root).expect(\"root\");"
    rust_global "    let archive_path = root.join(\"writer.zip\");"
    rust_global "    let file = fs::File::create(&archive_path).expect(\"create zip\");"
    rust_global "    let mut writer = zip::ZipWriter::new(file);"
    rust_global "    let deflated = zip::write::FileOptions::default().compression_method(zip::CompressionMethod::Deflated).unix_permissions(0o644);"
    rust_global "    let stored = zip::write::FileOptions::default().compression_method(zip::CompressionMethod::Stored).unix_permissions(0o600);"
    rust_global "    writer.add_directory(\"nested/\", deflated).expect(\"directory\");"
    rust_global "    writer.start_file(\"nested/alpha.txt\", deflated).expect(\"alpha\");"
    rust_global "    writer.write_all(&vec![b'a'; 32768]).expect(\"alpha payload\");"
    rust_global "    writer.start_file(\"beta.bin\", stored).expect(\"beta\");"
    rust_global "    writer.write_all(&[0, 1, 2, 3, 4, 5, 255]).expect(\"beta payload\");"
    rust_global "    let mut file = writer.finish().expect(\"finish zip\");"
    rust_global "    file.sync_all().expect(\"sync zip\");"
    rust_global "    drop(file);"
    rust_global "    let mut archive = zip::ZipArchive::new(fs::File::open(&archive_path).expect(\"open zip\")).expect(\"read zip\");"
    rust_global "    assert_eq!(archive.len(), 3);"
    rust_global "    assert!(archive.by_name(\"nested/\").expect(\"directory entry\").is_dir());"
    rust_global "    let mut alpha = Vec::new(); archive.by_name(\"nested/alpha.txt\").expect(\"alpha entry\").read_to_end(&mut alpha).expect(\"read alpha\");"
    rust_global "    assert_eq!(alpha, vec![b'a'; 32768]);"
    rust_global "    let mut beta = Vec::new(); archive.by_name(\"beta.bin\").expect(\"beta entry\").read_to_end(&mut beta).expect(\"read beta\");"
    rust_global "    assert_eq!(beta, vec![0, 1, 2, 3, 4, 5, 255]);"
    rust_global "    fs::remove_dir_all(root).expect(\"cleanup writer\");"
    rust_global "}"
