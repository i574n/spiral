// Minimal archive-contract harness emitted from Spiral.
inl rust_global (x : string) : () = real
    typecase `(!!!!LitToTypeLit(x)) with ~x =>
    $"RustGlobal(@x)" : ()
inl rust_library () : () = $"RustLibrary()" : ()

inl emit_archive_contract_harness () =
    rust_global "#![cfg(test)]\nuse std::env;\nuse std::fs;\nuse std::path::{Path, PathBuf};\nuse std::process::{Command, Output};\nuse std::time::{SystemTime, UNIX_EPOCH};\n\nfn eoie_binary() -> PathBuf {\n    if let Ok(path) = env::var(\"EOIE_BIN_UNDER_TEST\") { return PathBuf::from(path); }\n    let current = env::current_exe().expect(\"current test executable\");\n    let debug = current.parent().and_then(Path::parent).expect(\"target profile directory\");\n    let candidate = debug.join(if cfg!(windows) { \"eoie.exe\" } else { \"eoie\" });\n    assert!(candidate.is_file(), \"EOIE binary not found at {}\", candidate.display());\n    candidate\n}\n\nfn run(args: &[&str]) -> Output {\n    Command::new(eoie_binary()).current_dir(env::temp_dir()).current_dir(env::temp_dir()).current_dir(env::temp_dir()).args(args).output().expect(\"run EOIE\")\n}\n\nfn run_ok(args: &[&str]) -> String {\n    let output = run(args);\n    assert!(output.status.success(), \"EOIE failed: {}\", String::from_utf8_lossy(&output.stderr));\n    String::from_utf8(output.stdout).expect(\"utf8 stdout\")\n}\n\nfn temporary(label: &str) -> PathBuf {\n    let stamp = SystemTime::now().duration_since(UNIX_EPOCH).expect(\"clock\").as_nanos();\n    env::temp_dir().join(format!(\"eoie-contract-{label}-{}-{stamp}\", std::process::id()))\n}\n\nfn write(path: &Path, text: &str) {\n    fs::create_dir_all(path.parent().expect(\"parent\")).expect(\"create parent\");\n    fs::write(path, text).expect(\"write fixture\");\n}"
