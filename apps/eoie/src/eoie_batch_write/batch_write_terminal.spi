inl rust_global (x : string) : () = real typecase `(!!!!LitToTypeLit(x)) with ~x => $"RustGlobal(@x)" : ()

inl emit_batch_write_runtime () : () =
    rust_global "#[derive(Clone)]\nenum BatchWriteExpectation { Create, Replace(String) }\n\n#[derive(Clone)]\nstruct BatchWriteItem { relative: String, payload: String, expectation: BatchWriteExpectation }\n\nuse eoie_rust_std_fs::{read_regular_limited, read_regular_text_limited, rooted_canonical_directory, rooted_entry_exists, rooted_remove_regular};\n\nfn remove_regular_if_present(path: &std::path::Path) -> Result<(), String> {\n    if rooted_entry_exists(path)? { rooted_remove_regular(path)?; }\n    Ok(())\n}\n\nfn batch_write_compiled_manifest(plan: &std::path::Path) -> Result<String, String> {\n    // Canonical providers are mandatory; compile every plan to Plan IR.\n    let Some(compiler) = eoie_process::resolve_spiral_compiler(None)? else { return Err(\"compiled batch-write provider requires a Spiral compiler\".to_owned()); };\n    let output = plan.with_extension(format!(\"eoie-plan-ir-{}.ir\", std::process::id()));\n    let status = eoie_process::compile_spiral_plan_ir(compiler.path.to_string_lossy().as_ref(), plan, &output, 30000)?;\n    let manifest_result = if status.success() { read_regular_text_limited(&output, 2 * 1024 * 1024) } else { Err(format!(\"Spiral Plan IR compilation failed for {}\", plan.display())) };\n    let _ = remove_regular_if_present(&output);\n    let _ = remove_regular_if_present(&std::path::PathBuf::from(format!(\"{}.spiral-entry\", output.display())));\n    let _ = remove_regular_if_present(&plan.with_extension(\"c\"));\n    let manifest = manifest_result?;\n    canonical_plan_ir_domain::parse_plan_ir_manifest(&manifest)?;\n    Ok(manifest)\n}\n\nfn batch_write_parse(manifest: &str) -> Result<Vec<BatchWriteItem>, String> {\n    {\n        let rows = canonical_plan_ir_domain::parse_plan_ir_manifest(manifest)?;\n        let mut items = Vec::with_capacity(rows.len());\n        for row in rows {\n            let code = canonical_plan_ir_domain::eoie_plan_ir_decode_code(&row.op, &row.target, &row.expected, &row.payload, &row.effect);\n            let item = match code {\n                0 => BatchWriteItem { relative: row.target, payload: row.payload, expectation: BatchWriteExpectation::Create },\n                1 => BatchWriteItem { relative: row.target, payload: row.payload, expectation: BatchWriteExpectation::Replace(row.expected) },\n                _ => return Err(\"compiled Plan IR contains a non-batch-write operation\".to_owned()),\n            };\n            items.push(item);\n        }\n        return Ok(items);\n    }\n}\n\nfn batch_write_rollback(targets: &[std::path::PathBuf], originals: &[Option<Vec<u8>>], staged: &[std::path::PathBuf], promoted: usize) -> Result<(), String> {\n    let mut restored = 0usize;\n    let mut failures = Vec::new();\n    for temporary in staged.iter().skip(promoted) {\n        match eoie_rust_std_fs::discard_stage(temporary) { Ok(()) => restored += 1, Err(error) => failures.push(error) }\n    }\n    for index in (0..promoted).rev() {\n        let target = &targets[index];\n        let result = match &originals[index] {\n            Some(bytes) => eoie_rust_std_fs::atomic_write(target, bytes),\n            None => {\n                if rooted_entry_exists(target)? { rooted_remove_regular(target) } else { Ok(()) }\n            },\n        };\n        match result { Ok(()) => restored += 1, Err(error) => failures.push(error) }\n    }\n    let typed = eoie_patch_driver_batch_write_rollback_binding(targets.len() as i32, restored as i32);\n    if typed != 1 || !failures.is_empty() {\n        return Err(format!(\"batch rollback incomplete restored={restored}/{} failures={}\", targets.len(), failures.join(\" | \")));\n    }\n    Ok(())\n}\n\npub fn filesystem_batch_write_run(args: &[String]) -> Result<(), String> {\n    if args.len() != 4 { return Err(\"fs-batch-write expects preview|apply root plan.spi\".to_owned()); }\n    let mode = args.get(1).map(String::as_str).unwrap_or(\"\");\n    if mode != \"preview\" && mode != \"apply\" { return Err(\"fs-batch-write mode must be preview or apply\".to_owned()); }\n    let root_input = std::path::Path::new(args.get(2).ok_or_else(|| \"missing root\".to_owned())?);\n    let root = rooted_canonical_directory(root_input)?;\n    let plan = std::path::Path::new(args.get(3).ok_or_else(|| \"missing plan.spi\".to_owned())?);\n    if !plan.is_absolute() || plan.extension().and_then(|value| value.to_str()) != Some(\"spi\") {\n        return Err(\"fs-batch-write plan must be an absolute regular .spi file\".to_owned());\n    }\n    let manifest = batch_write_compiled_manifest(plan)?;\n    let items = batch_write_parse(&manifest)?;\n    let mut seen = std::collections::BTreeSet::new();\n    let mut targets = Vec::with_capacity(items.len());\n    let mut originals = Vec::with_capacity(items.len());\n    for item in &items {\n        let relative = eoie_patch_control_domain::patch_safe_relative(&item.relative)?;\n        if !seen.insert(relative.clone()) { return Err(format!(\"duplicate batch target: {}\", item.relative)); }\n        let target = root.join(relative);\n        let original = match &item.expectation {\n            BatchWriteExpectation::Create => {\n                if rooted_entry_exists(&target)? { return Err(format!(\"stale create target exists: {}\", target.display())); }\n                if eoie_patch_driver_batch_write_freshness_binding(0, 1) != 1 { return Err(\"typed create freshness rejected\".to_owned()); }\n                None\n            }\n            BatchWriteExpectation::Replace(expected) => {\n                let original = read_regular_limited(&target, usize::MAX)?;\n                let observed = eoie_proxy_search::inspection_sha256(original.clone());\n                if &observed != expected { return Err(format!(\"stale replace target expected={expected} observed={observed} path={}\", target.display())); }\n                if eoie_patch_driver_batch_write_freshness_binding(1, 1) != 1 { return Err(\"typed replace freshness rejected\".to_owned()); }\n                Some(original)\n            }\n        };\n        targets.push(target);\n        originals.push(original);\n    }\n    if eoie_patch_driver_batch_write_shape_binding(items.len() as i32, 0) != 1 { return Err(\"typed batch shape rejected\".to_owned()); }\n    if mode == \"preview\" {\n        println!(\"eoie proxy fs-batch-write preview ok rows={} mutation=false\", items.len());\n        for (item, target) in items.iter().zip(&targets) {\n            println!(\"path={} bytes={} sha256={}\", target.display(), item.payload.len(), eoie_proxy_search::inspection_sha256(item.payload.as_bytes().to_vec()));\n        }\n        return Ok(());\n    }\n    let mut staged = Vec::with_capacity(items.len());\n    for (index, (item, target)) in items.iter().zip(&targets).enumerate() {\n        let temporary = match &item.expectation {\n            BatchWriteExpectation::Create => eoie_rust_std_fs::stage_new_text(target, &item.payload),\n            BatchWriteExpectation::Replace(_) => eoie_rust_std_fs::stage_text(target, &item.payload),\n        };\n        match temporary {\n            Ok(path) => staged.push(path),\n            Err(error) => {\n                for path in &staged { let _ = eoie_rust_std_fs::discard_stage(path); }\n                return Err(format!(\"stage batch row {index}: {error}\"));\n            }\n        }\n    }\n    if eoie_patch_driver_batch_write_stage_binding(items.len() as i32, staged.len() as i32) != 1 {\n        for path in &staged { let _ = eoie_rust_std_fs::discard_stage(path); }\n        return Err(\"typed batch stage rejected\".to_owned());\n    }\n    let mut promoted = 0usize;\n    for (temporary, target) in staged.iter().zip(&targets) {\n        if let Err(error) = eoie_rust_std_fs::promote_stage(temporary, target) {\n            let rollback = batch_write_rollback(&targets, &originals, &staged, promoted);\n            return Err(format!(\"batch promotion failed: {error}; rollback={rollback:?}\"));\n        }\n        promoted += 1;\n    }\n    let mut verified = 0usize;\n    for (item, target) in items.iter().zip(&targets) {\n        match read_regular_limited(target, usize::MAX) {\n            Ok(bytes) if bytes == item.payload.as_bytes() => verified += 1,\n            other => {\n                let rollback = batch_write_rollback(&targets, &originals, &staged, promoted);\n                return Err(format!(\"batch verification failed path={} observed={other:?}; rollback={rollback:?}\", target.display()));\n            }\n        }\n    }\n    if eoie_patch_driver_batch_write_verify_binding(items.len() as i32, verified as i32) != 1 {\n        let rollback = batch_write_rollback(&targets, &originals, &staged, promoted);\n        return Err(format!(\"typed batch verification rejected; rollback={rollback:?}\"));\n    }\n    for target in &targets {\n        if target.extension().and_then(|value| value.to_str()) == Some(\"spi\") {\n            let source = read_regular_text_limited(target, usize::MAX)?;\n            if source.lines().any(|line| line.trim_start().starts_with(\"inl main\")) && let Err(error) = eoie_patch_driver_domain::source_authoring_typecheck(target) {\n                let rollback = batch_write_rollback(&targets, &originals, &staged, promoted);\n                return Err(format!(\"batch Spiral typecheck failed: {error}; rollback={rollback:?}\"));\n            }\n        }\n    }\n    println!(\"eoie proxy fs-batch-write apply ok rows={} verified={} mutation=true\", items.len(), verified);\n    Ok(())\n}\n"
