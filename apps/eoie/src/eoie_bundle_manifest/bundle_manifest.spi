inl rust_global (x : string) : () = real typecase `(!!!!LitToTypeLit(x)) with ~x => $"RustGlobal(@x)" : ()

open bundle_manifest_contract.model

inl emit_runtime () : () =
    rust_global "use std::collections::BTreeSet;\nuse std::fs::{self, File, OpenOptions};\nuse std::io::{Seek, Write};\nuse std::path::{Component, Path, PathBuf};\nuse std::time::{SystemTime, UNIX_EPOCH};\nuse zip::write::FileOptions;\nuse zip::{CompressionMethod, DateTime, ZipArchive, ZipWriter};\n#[cfg(unix)]\nuse std::os::unix::fs::PermissionsExt;\n\n#[derive(Clone, Debug, Eq, PartialEq)]\npub struct BundleManifest {\n    entries: Vec<String>,\n}\n\nimpl BundleManifest {\n    #[must_use]\n    pub fn entries(&self) -> &[String] { &self.entries }\n\n    #[must_use]\n    pub fn len(&self) -> usize { self.entries.len() }\n\n    #[must_use]\n    pub fn is_empty(&self) -> bool { self.entries.is_empty() }\n}\n\nfn normalized_relative(path: &Path) -> Result<String, String> {\n    let mut parts = Vec::new();\n    for component in path.components() {\n        match component {\n            Component::Normal(value) => {\n                #[cfg(windows)] eoie_rust_std_fs_mutation::windows_validate_component(value)?;\n                let value = value.to_str().ok_or_else(|| format!(\"non-UTF8 bundle entry: {}\", path.display()))?;\n                if value.is_empty() || value.contains('\\\\') {\n                    return Err(format!(\"unsafe bundle entry component: {}\", path.display()));\n                }\n                parts.push(value);\n            }\n            _ => return Err(format!(\"unsafe bundle entry: {}\", path.display())),\n        }\n    }\n    if parts.is_empty() {\n        return Err(\"empty bundle entry\".to_owned());\n    }\n    let normalized = parts.join(\"/\");\n    if Path::new(&normalized)\n        .extension()\n        .and_then(|value| value.to_str())\n        .is_some_and(|value| value.eq_ignore_ascii_case(\"zip\"))\n        && !normalized.starts_with(\"src/vendor/\")\n    {\n        return Err(format!(\"nested zip excluded by bundle policy: {normalized}\"));\n    }\n    Ok(normalized)\n}\n\nfn canonical_manifest(entries: Vec<String>) -> Result<BundleManifest, String> {\n    if entries.is_empty() {\n        return Err(\"bundle manifest is empty\".to_owned());\n    }\n    let mut unique = BTreeSet::new();\n    for entry in entries {\n        let normalized = normalized_relative(Path::new(&entry))?;\n        if normalized != entry {\n            return Err(format!(\"bundle entry is not normalized: {entry}\"));\n        }\n        if !unique.insert(entry.clone()) {\n            return Err(format!(\"duplicate bundle entry: {entry}\"));\n        }\n    }\n    Ok(BundleManifest { entries: unique.into_iter().collect() })\n}\n\nfn collect_walk(root: &Path, path: &Path, entries: &mut Vec<String>) -> Result<(), String> {\n    for entry in fs::read_dir(path).map_err(|error| format!(\"read {}: {error}\", path.display()))? {\n        let entry = entry.map_err(|error| error.to_string())?;\n        let child = entry.path();\n        let metadata = fs::symlink_metadata(&child).map_err(|error| error.to_string())?;\n        if metadata.file_type().is_symlink() {\n            return Err(format!(\"bundle contains symlink: {}\", child.display()));\n        }\n        if metadata.is_dir() {\n            collect_walk(root, &child, entries)?;\n        } else if metadata.is_file() {\n            let relative = child.strip_prefix(root).map_err(|error| error.to_string())?;\n            entries.push(normalized_relative(relative)?);\n        } else {\n            return Err(format!(\"bundle contains special entry: {}\", child.display()));\n        }\n    }\n    Ok(())\n}\n\npub fn collect_bundle_manifest(root: &Path) -> Result<BundleManifest, String> {\n    if !root.is_dir() {\n        return Err(format!(\"bundle root is not a directory: {}\", root.display()));\n    }\n    let mut entries = Vec::new();\n    collect_walk(root, root, &mut entries)?;\n    canonical_manifest(entries)\n}\n\npub fn manifest_from_archive_entries(entries: &[String]) -> Result<BundleManifest, String> {\n    let canonical = canonical_manifest(entries.to_vec())?;\n    if canonical.entries != entries {\n        return Err(\"archive manifest is not in canonical lexicographic order\".to_owned());\n    }\n    Ok(canonical)\n}\n\npub fn zip_entries(archive: &Path) -> Result<Vec<String>, String> {\n    if !fs::symlink_metadata(archive).map_err(|error| format!(\"stat {}: {error}\", archive.display()))?.file_type().is_file() {\n        return Err(format!(\"archive path is not a regular file: {}\", archive.display()));\n    }\n    let file = fs::File::open(archive).map_err(|error| format!(\"open {}: {error}\", archive.display()))?;\n    let mut zip = ZipArchive::new(file).map_err(|error| format!(\"open zip {}: {error}\", archive.display()))?;\n    let mut entries = Vec::with_capacity(zip.len());\n    let mut root_eoie_seen = false;\n    let mut root_eoie_exec = false;\n    for index in 0..zip.len() {\n        let mut entry = zip.by_index(index).map_err(|error| format!(\"read zip entry {index}: {error}\"))?;\n        if entry.enclosed_name().is_none() { return Err(format!(\"unsafe zip entry: {}\", entry.name())); }\n        if !matches!(entry.compression(), CompressionMethod::Stored | CompressionMethod::Deflated) { return Err(format!(\"unsupported zip compression at {index}: {:?}\", entry.compression())); }\n        let mode = entry.unix_mode().unwrap_or(if entry.is_dir() { 0o040755 } else { 0o100644 });\n        if mode & 0o170000 == 0o120000 { return Err(format!(\"zip symlink is forbidden: {}\", entry.name())); }\n        let name = entry.name().to_owned();\n        if name == \"eoie\" { root_eoie_seen = true; root_eoie_exec = (mode & 0o111) != 0; }\n        std::io::copy(&mut entry, &mut std::io::sink()).map_err(|error| format!(\"verify zip payload {name}: {error}\"))?;\n        entries.push(name);\n    }\n    if root_eoie_seen && eoie_bundle_manifest_executable_mode_binding(1, i32::from(root_eoie_exec)) != 1 {\n        return Err(\"root eoie entry is not executable\".to_owned());\n    }\n    Ok(entries)\n}\n\npub fn verify_generic_flat_zip(archive: &Path, max_bytes: u64) -> Result<(usize, u64), String> {\n    if max_bytes == 0 { return Err(\"flat archive limit must be positive\".to_owned()); }\n    let metadata = fs::metadata(archive).map_err(|error| error.to_string())?;\n    if !metadata.is_file() { return Err(\"flat archive is not a regular file\".to_owned()); }\n    let bytes = metadata.len();\n    if bytes == 0 { return Err(\"flat archive is empty\".to_owned()); }\n    if bytes > max_bytes { return Err(format!(\"flat archive size rejected: bytes={bytes} limit={max_bytes}\")); }\n    Ok((manifest_from_archive_entries(&zip_entries(archive)?)?.len(), bytes))\n}\n\npub fn verify_manifest_parity(expected: &BundleManifest, observed: &BundleManifest) -> Result<(), String> {\n    if expected.entries.len() != observed.entries.len() {\n        return Err(format!(\"bundle manifest count mismatch: expected={} observed={}\", expected.entries.len(), observed.entries.len()));\n    }\n    for (index, (left, right)) in expected.entries.iter().zip(&observed.entries).enumerate() {\n        if left != right {\n            return Err(format!(\"bundle manifest mismatch at {index}: expected={left} observed={right}\"));\n        }\n    }\n    Ok(())\n}\n\npub fn verify_archive_parity(archive: &Path, expected: &BundleManifest) -> Result<(), String> {\n    verify_manifest_parity(expected, &manifest_from_archive_entries(&zip_entries(archive)?)?)\n}\n\n#[must_use]\npub fn manifest_fingerprint(manifest: &BundleManifest) -> u64 {\n    let mut hash = 0xcbf29ce484222325u64;\n    for entry in &manifest.entries {\n        for byte in entry.as_bytes().iter().copied().chain(std::iter::once(b'\\n')) {\n            hash ^= u64::from(byte);\n            hash = hash.wrapping_mul(0x100000001b3);\n        }\n    }\n    hash\n}\n\nfn write_u16(writer: &mut File, value: u16) -> Result<(), String> {\n    writer.write_all(&value.to_le_bytes()).map_err(|error| error.to_string())\n}\n\nfn write_u32(writer: &mut File, value: u32) -> Result<(), String> {\n    writer.write_all(&value.to_le_bytes()).map_err(|error| error.to_string())\n}\n\npub fn bundle_crc32(data: &[u8]) -> u32 {\n    let mut crc = 0xffff_ffffu32;\n    for byte in data {\n        crc ^= u32::from(*byte);\n        for _ in 0..8 {\n            let mask = 0u32.wrapping_sub(crc & 1);\n            crc = (crc >> 1) ^ (0xedb8_8320 & mask);\n        }\n    }\n    !crc\n}\n\n#[cfg(unix)]\nfn external_attributes(metadata: &fs::Metadata, _path: &Path) -> u32 {\n    let permissions = metadata.permissions().mode() & 0o7777;\n    (0o100000u32 | permissions) << 16\n}\n\n#[cfg(not(unix))]\nfn external_attributes(metadata: &fs::Metadata, path: &Path) -> u32 {\n    // Windows has no executable permission bit. Preserve runnable bundle entries\n    // in the ZIP's Unix metadata so archives remain usable when moved to Linux.\n    let executable = path.file_name().and_then(|v| v.to_str()) == Some(\"eoie\")\n        || path.extension().and_then(|v| v.to_str()).is_some_and(|v| [\"exe\", \"sh\", \"cmd\", \"bat\", \"ps1\"].iter().any(|ext| v.eq_ignore_ascii_case(ext)));\n    let mode = eoie_bundle_portable_mode_binding(i32::from(executable), i32::from(metadata.permissions().readonly())) as u32;\n    (0o100000u32 | mode) << 16\n}\n\nstruct CentralEntry {\n    name: String,\n    crc: u32,\n    size: u32,\n    offset: u32,\n    external_attributes: u32,\n}\n\nfn stage_path(output: &Path) -> PathBuf {\n    let stamp = SystemTime::now().duration_since(UNIX_EPOCH).map(|value| value.as_nanos()).unwrap_or(0);\n    let mut value = output.as_os_str().to_os_string();\n    value.push(format!(\".eoie-stage-{}-{stamp}\", std::process::id()));\n    PathBuf::from(value)\n}\n\npub fn write_deterministic_store_zip(root: &Path, output: &Path, manifest: &BundleManifest) -> Result<(), String> {\n    if manifest.is_empty() {\n        return Err(\"cannot write an empty bundle manifest\".to_owned());\n    }\n    if manifest.len() > usize::from(u16::MAX) {\n        return Err(format!(\"too many bundle entries: {}\", manifest.len()));\n    }\n    if output.starts_with(root) {\n        return Err(\"zip output must be outside bundle root\".to_owned());\n    }\n    if let Some(parent) = output.parent() {\n        fs::create_dir_all(parent).map_err(|error| error.to_string())?;\n    }\n    let stage = stage_path(output);\n    let result = (|| -> Result<(), String> {\n        let mut writer = OpenOptions::new().write(true).create_new(true).open(&stage).map_err(|error| format!(\"create exclusive stage {}: {error}\", stage.display()))?;\n        let mut central = Vec::with_capacity(manifest.len());\n        for name in manifest.entries() {\n            let path = root.join(name);\n            let metadata = fs::symlink_metadata(&path).map_err(|error| format!(\"stat {}: {error}\", path.display()))?;\n            if metadata.file_type().is_symlink() || !metadata.is_file() {\n                return Err(format!(\"manifest entry is not a regular file: {}\", path.display()));\n            }\n            let data = fs::read(&path).map_err(|error| format!(\"read {}: {error}\", path.display()))?;\n            let size = u32::try_from(data.len()).map_err(|_| format!(\"bundle entry exceeds ZIP32: {name}\"))?;\n            let name_bytes = name.as_bytes();\n            let name_len = u16::try_from(name_bytes.len()).map_err(|_| format!(\"bundle entry name is too long: {name}\"))?;\n            let offset = u32::try_from(writer.stream_position().map_err(|error| error.to_string())?)\n                .map_err(|_| \"bundle local header offset exceeds ZIP32\".to_owned())?;\n            let crc = bundle_crc32(&data);\n            write_u32(&mut writer, 0x0403_4b50)?;\n            write_u16(&mut writer, 20)?;\n            write_u16(&mut writer, 0)?;\n            write_u16(&mut writer, 0)?;\n            write_u16(&mut writer, 0)?;\n            write_u16(&mut writer, 33)?;\n            write_u32(&mut writer, crc)?;\n            write_u32(&mut writer, size)?;\n            write_u32(&mut writer, size)?;\n            write_u16(&mut writer, name_len)?;\n            write_u16(&mut writer, 0)?;\n            writer.write_all(name_bytes).map_err(|error| error.to_string())?;\n            writer.write_all(&data).map_err(|error| error.to_string())?;\n            central.push(CentralEntry {\n                name: name.clone(),\n                crc,\n                size,\n                offset,\n                external_attributes: external_attributes(&metadata, &path),\n            });\n        }\n        let central_offset = u32::try_from(writer.stream_position().map_err(|error| error.to_string())?)\n            .map_err(|_| \"bundle central directory offset exceeds ZIP32\".to_owned())?;\n        for entry in &central {\n            let name_bytes = entry.name.as_bytes();\n            let name_len = u16::try_from(name_bytes.len()).map_err(|_| format!(\"bundle entry name is too long: {}\", entry.name))?;\n            write_u32(&mut writer, 0x0201_4b50)?;\n            write_u16(&mut writer, 0x0314)?;\n            write_u16(&mut writer, 20)?;\n            write_u16(&mut writer, 0)?;\n            write_u16(&mut writer, 0)?;\n            write_u16(&mut writer, 0)?;\n            write_u16(&mut writer, 33)?;\n            write_u32(&mut writer, entry.crc)?;\n            write_u32(&mut writer, entry.size)?;\n            write_u32(&mut writer, entry.size)?;\n            write_u16(&mut writer, name_len)?;\n            write_u16(&mut writer, 0)?;\n            write_u16(&mut writer, 0)?;\n            write_u16(&mut writer, 0)?;\n            write_u16(&mut writer, 0)?;\n            write_u32(&mut writer, entry.external_attributes)?;\n            write_u32(&mut writer, entry.offset)?;\n            writer.write_all(name_bytes).map_err(|error| error.to_string())?;\n        }\n        let end = u32::try_from(writer.stream_position().map_err(|error| error.to_string())?)\n            .map_err(|_| \"bundle archive exceeds ZIP32\".to_owned())?;\n        let central_size = end.checked_sub(central_offset).ok_or_else(|| \"invalid central directory range\".to_owned())?;\n        let entries = u16::try_from(central.len()).map_err(|_| \"too many central directory entries\".to_owned())?;\n        write_u32(&mut writer, 0x0605_4b50)?;\n        write_u16(&mut writer, 0)?;\n        write_u16(&mut writer, 0)?;\n        write_u16(&mut writer, entries)?;\n        write_u16(&mut writer, entries)?;\n        write_u32(&mut writer, central_size)?;\n        write_u32(&mut writer, central_offset)?;\n        write_u16(&mut writer, 0)?;\n        writer.sync_all().map_err(|error| error.to_string())?;\n        if output.exists() {\n            fs::remove_file(output).map_err(|error| error.to_string())?;\n        }\n        fs::rename(&stage, output).map_err(|error| error.to_string())?;\n        Ok(())\n    })();\n    if result.is_err() {\n        let _ = fs::remove_file(&stage);\n    }\n    result\n}\n\npub fn write_deterministic_deflate_zip(root: &Path, output: &Path, manifest: &BundleManifest) -> Result<(), String> {\n    if manifest.is_empty() { return Err(\"cannot write an empty bundle manifest\".to_owned()); }\n    if manifest.len() > usize::from(u16::MAX) { return Err(format!(\"too many bundle entries: {}\", manifest.len())); }\n    if output.starts_with(root) { return Err(\"zip output must be outside bundle root\".to_owned()); }\n    if let Some(parent) = output.parent() { fs::create_dir_all(parent).map_err(|error| error.to_string())?; }\n    let stage = stage_path(output);\n    let result = (|| -> Result<(), String> {\n        let file = OpenOptions::new().write(true).create_new(true).open(&stage).map_err(|error| format!(\"create exclusive stage {}: {error}\", stage.display()))?;\n        let mut writer = ZipWriter::new(file);\n        let timestamp = DateTime::default();\n        for name in manifest.entries() {\n            let path = root.join(name);\n            let metadata = fs::symlink_metadata(&path).map_err(|error| format!(\"stat {}: {error}\", path.display()))?;\n            if metadata.file_type().is_symlink() || !metadata.is_file() { return Err(format!(\"manifest entry is not a regular file: {}\", path.display())); }\n            #[cfg(unix)]\n            let permissions = metadata.permissions().mode() & 0o7777;\n            #[cfg(not(unix))]\n            let permissions = (external_attributes(&metadata, &path) >> 16) & 0o7777;\n            let options = FileOptions::default()\n                .compression_method(CompressionMethod::Deflated)\n                .compression_level(Some(9))\n                .last_modified_time(timestamp)\n                .unix_permissions(permissions);\n            writer.start_file(name, options).map_err(|error| format!(\"start deflate entry {name}: {error}\"))?;\n            let mut source = File::open(&path).map_err(|error| format!(\"open {}: {error}\", path.display()))?;\n            std::io::copy(&mut source, &mut writer).map_err(|error| format!(\"deflate {}: {error}\", path.display()))?;\n        }\n        let file = writer.finish().map_err(|error| format!(\"finish deflate zip: {error}\"))?;\n        file.sync_all().map_err(|error| error.to_string())?;\n        fs::rename(&stage, output).map_err(|error| error.to_string())?;\n        Ok(())\n    })();\n    if result.is_err() { let _ = fs::remove_file(&stage); }\n    result\n}\n\n"

inl emit_archive_extract_runtime () : () =
    rust_global "use eoie_archive_tar_runtime::{archive_format, tar_checksum, tar_octal, tar_path, tar_pax_path, tar_text};\nuse eoie_rust_std_fs_mutation::{rooted_create_directory_within, rooted_create_regular_within, rooted_ensure_directory, rooted_promote_directory_within, rooted_remove_tree_within};\nuse std::io::Read;\nuse std::process::Command;\n\nfn extract_tar_stream<R: Read>(reader: &mut R, stage: &Path, limit: u64, fault: i32) -> Result<(usize, usize, u64), String> {\n    let mut entries = 0usize;\n    let mut payloads = 0usize;\n    let mut bytes = 0u64;\n    let mut seen = BTreeSet::<PathBuf>::new();\n    let mut pending_long_name: Option<PathBuf> = None;\n    let mut pending_long_link: Option<PathBuf> = None;\n    let mut pending_pax_path: Option<PathBuf> = None;\n    loop {\n        let mut header = [0u8; 512];\n        reader.read_exact(&mut header).map_err(|error| format!(\"read tar header: {error}\"))?;\n        if header.iter().all(|byte| *byte == 0) { break; }\n        tar_checksum(&header)?;\n        let size = tar_octal(&header[124..136], \"size\")?;\n        let mode = tar_octal(&header[100..108], \"mode\")? as u32 & 0o777;\n        if header[156] == b'5' {\n            let raw_name = tar_text(&header[0..100], \"name\")?;\n            if (raw_name == \".\" || raw_name == \"./\") && size == 0 { entries += 1; continue; }\n        }\n        if header[156] == b'L' {\n            if size == 0 || size > 65536 { return Err(format!(\"GNU tar long name size rejected: {size}\")); }\n            let mut long_name = vec![0u8; size as usize];\n            reader.read_exact(&mut long_name).map_err(|error| format!(\"read GNU tar long name: {error}\"))?;\n            while long_name.last().is_some_and(|byte| *byte == 0 || *byte == 10) { long_name.pop(); }\n            let text = std::str::from_utf8(&long_name).map_err(|_| \"non-UTF8 GNU tar long name\".to_owned())?;\n            let normalized = text.strip_prefix(\"./\").unwrap_or(text);\n            let path = PathBuf::from(normalized);\n            if path.as_os_str().is_empty() || path.is_absolute() || !path.components().all(|component| matches!(component, Component::Normal(_))) { return Err(format!(\"unsafe GNU tar long name: {text}\")); }\n            pending_long_name = Some(path);\n            let padding = (512 - (size % 512)) % 512;\n            if padding != 0 {\n                let skipped = std::io::copy(&mut reader.by_ref().take(padding), &mut std::io::sink()).map_err(|error| format!(\"skip GNU tar long name padding: {error}\"))?;\n                if skipped != padding { return Err(\"GNU tar long name padding truncated\".to_owned()); }\n            }\n            entries += 1;\n            continue;\n        }\n        if header[156] == b'K' {\n            if size == 0 || size > 65536 { return Err(format!(\"GNU tar long link size rejected: {size}\")); }\n            bytes = bytes.checked_add(size).ok_or_else(|| \"archive size overflow\".to_owned())?;\n            if bytes > limit { return Err(format!(\"archive budget exceeded observed={bytes} limit={limit}\")); }\n            let mut long_link = vec![0u8; size as usize];\n            reader.read_exact(&mut long_link).map_err(|error| format!(\"read GNU tar long link: {error}\"))?;\n            while long_link.last().is_some_and(|byte| *byte == 0 || *byte == 10) { long_link.pop(); }\n            let target_text = std::str::from_utf8(&long_link).map_err(|_| \"non-UTF8 GNU tar long link\".to_owned())?;\n            if archive_deflate_domain::eoie_archive_tar_long_link_binding(1, 1) != 1 { return Err(\"typed GNU tar long link rejected\".to_owned()); }\n            pending_long_link = Some(PathBuf::from(target_text));\n            let padding = (512 - (size % 512)) % 512;\n            if padding != 0 {\n                let skipped = std::io::copy(&mut reader.by_ref().take(padding), &mut std::io::sink()).map_err(|error| format!(\"skip GNU tar long link padding: {error}\"))?;\n                if skipped != padding { return Err(\"GNU tar long link padding truncated\".to_owned()); }\n            }\n            entries += 1;\n            continue;\n        }\n        if header[156] == b'x' {\n            if size == 0 || size > 65536 { return Err(format!(\"PAX extended header size rejected: {size}\")); }\n            let mut payload = vec![0u8; size as usize];\n            reader.read_exact(&mut payload).map_err(|error| format!(\"read PAX extended header: {error}\"))?;\n            pending_pax_path = Some(tar_pax_path(&payload)?);\n            let padding = (512 - (size % 512)) % 512;\n            if padding != 0 {\n                let skipped = std::io::copy(&mut reader.by_ref().take(padding), &mut std::io::sink()).map_err(|error| format!(\"skip PAX padding: {error}\"))?;\n                if skipped != padding { return Err(\"PAX padding truncated\".to_owned()); }\n            }\n            entries += 1;\n            continue;\n        }\n        let relative = match (pending_pax_path.take(), pending_long_name.take()) {\n            (Some(path), None) | (None, Some(path)) => path,\n            (None, None) => tar_path(&header)?,\n            (Some(_), Some(_)) => return Err(\"conflicting PAX path and GNU long name\".to_owned()),\n        };\n        if pending_long_link.is_some() && header[156] != b'2' { return Err(format!(\"GNU tar long link target not followed by symlink: {}\", relative.display())); }\n        if !seen.insert(relative.clone()) { return Err(format!(\"duplicate tar entry: {}\", relative.display())); }\n        let output = stage.join(&relative);\n        match header[156] {\n            0 | b'0' => {\n                bytes = bytes.checked_add(size).ok_or_else(|| \"archive size overflow\".to_owned())?;\n                if bytes > limit { return Err(format!(\"archive budget exceeded observed={bytes} limit={limit}\")); }\n                if let Some(parent) = output.parent() { rooted_ensure_directory(parent)?; }\n                let mut file = rooted_create_regular_within(stage, &output, mode)?;\n                let copied = std::io::copy(&mut reader.by_ref().take(size), &mut file).map_err(|error| format!(\"extract {}: {error}\", relative.display()))?;\n                if copied != size { return Err(format!(\"tar entry truncated path={} expected={size} copied={copied}\", relative.display())); }\n                file.sync_all().map_err(|error| format!(\"sync {}: {error}\", output.display()))?;\n                payloads += 1;\n                if archive_deflate_domain::eoie_archive_fault_binding(fault, 1) == 1 { return Err(\"injected archive fault after-first-payload\".to_owned()); }\n            }\n            b'5' => {\n                if size != 0 { return Err(format!(\"tar directory has payload: {}\", relative.display())); }\n                rooted_ensure_directory(&output)?;\n                #[cfg(unix)] fs::set_permissions(&output, fs::Permissions::from_mode(mode)).map_err(|error| format!(\"permissions {}: {error}\", output.display()))?;\n            }\n            b'1' => {\n                let target_text = tar_text(&header[157..257], \"linkname\")?;\n                let normalized = target_text.strip_prefix(\"./\").unwrap_or(&target_text);\n                let target = PathBuf::from(normalized);\n                archive_deflate_domain::archive_create_confined_hardlink(&target, &output, stage, size)?;\n                payloads += 1;\n                if archive_deflate_domain::eoie_archive_fault_binding(fault, 1) == 1 { return Err(\"injected archive fault after-first-payload\".to_owned()); }\n            }\n            b'2' => {\n                let header_target_text = tar_text(&header[157..257], \"linkname\")?;\n                let target = match pending_long_link.take() {\n                    Some(target) => target,\n                    None => {\n                        bytes = bytes.checked_add(header_target_text.len() as u64).ok_or_else(|| \"archive size overflow\".to_owned())?;\n                        if bytes > limit { return Err(format!(\"archive budget exceeded observed={bytes} limit={limit}\")); }\n                        PathBuf::from(&header_target_text)\n                    }\n                };\n                if let Some(parent) = output.parent() { rooted_ensure_directory(parent)?; }\n                archive_deflate_domain::archive_create_confined_symlink(&relative, &target, &output, stage, size)?;\n                payloads += 1;\n                if archive_deflate_domain::eoie_archive_fault_binding(fault, 1) == 1 { return Err(\"injected archive fault after-first-payload\".to_owned()); }\n            }\n            kind => return Err(format!(\"unsupported tar entry type={kind} path={}\", relative.display())),\n        }\n        let padding = (512 - (size % 512)) % 512;\n        if padding != 0 {\n            let skipped = std::io::copy(&mut reader.by_ref().take(padding), &mut std::io::sink()).map_err(|error| format!(\"skip tar padding: {error}\"))?;\n            if skipped != padding { return Err(\"tar padding truncated\".to_owned()); }\n        }\n        entries += 1;\n    }\n    Ok((entries, payloads, bytes))\n}\n\nfn extract_compressed_tar(program: &str, archive: &Path, stage: &Path, limit: u64, fault: i32) -> Result<(usize, usize, u64), String> {\n    let mut command = Command::new(program);\n    command.arg(\"-dc\").arg(archive);\n    let label = format!(\"archive-decompress-{program}\");\n    let (receipt, observation) = eoie_process_observation::run_bounded_stdout_receipted(&mut command, 120000, &label, |stdout| extract_tar_stream(stdout, stage, limit, fault))?;\n    if observation.timed_out { return Err(format!(\"{program} decompression timed out\")); }\n    if observation.status.success() { Ok(receipt) } else { Err(format!(\"{program} decompression failed: {}\", String::from_utf8_lossy(&observation.stderr))) }\n}\n\npub fn archive_extract_generic_run(args: &[String]) -> Result<(), String> {\n    if args.len() != 3 { return Err(\"archive-extract expects archive destination\".to_owned()); }\n    let archive = Path::new(&args[1]);\n    let destination = Path::new(&args[2]);\n    let limit = std::env::var(\"EOIE_ARCHIVE_MAX_BYTES\").ok().and_then(|value| value.parse::<u64>().ok()).unwrap_or(256 * 1024 * 1024);\n    let regular = i32::from(archive.is_file());\n    let absent = i32::from(!destination.exists());\n    if archive_deflate_domain::eoie_archive_preflight_binding(regular, absent) != 1 { return Err(format!(\"archive preflight rejected archive={} destination={}\", archive.display(), destination.display())); }\n    if limit == 0 || limit > i32::MAX as u64 { return Err(\"archive limit must be between 1 and i32::MAX\".to_owned()); }\n    let (format_code, format_name) = archive_format(archive)?;\n    if format_code == 0 {\n        let (entries, payloads, bytes) = archive_deflate_domain::archive_extract_with_limit(archive, destination, limit)?;\n        println!(\"eoie proxy archive-extract ok entries_total={entries} payloads={payloads} bytes={bytes} format=zip receipt=typed-generic\");\n        return Ok(());\n    }\n    if archive_deflate_domain::eoie_archive_format_binding(format_code, 1) != 1 { return Err(format!(\"typed archive format rejected code={format_code}\")); }\n    let parent = destination.parent().ok_or_else(|| format!(\"destination has no parent: {}\", destination.display()))?;\n    rooted_ensure_directory(parent)?;\n    let name = destination.file_name().and_then(|value| value.to_str()).unwrap_or(\"archive\");\n    let stage = parent.join(format!(\".{name}.eoie-tar-extract-{}\", std::process::id()));\n    if stage.exists() { return Err(format!(\"staging path already exists: {}\", stage.display())); }\n    rooted_create_directory_within(parent, &stage)?;\n    let fault = match std::env::var(\"EOIE_ARCHIVE_FAULT\").ok().as_deref() { None | Some(\"\") | Some(\"none\") => 0, Some(\"after-first-payload\") => 1, Some(\"before-commit\") => 2, Some(value) => return Err(format!(\"unknown EOIE_ARCHIVE_FAULT: {value}\")) };\n    let result = (|| {\n        let receipt = match format_code {\n            1 => { let mut file = File::open(archive).map_err(|error| format!(\"open {}: {error}\", archive.display()))?; extract_tar_stream(&mut file, &stage, limit, fault) },\n            2 => extract_compressed_tar(\"gzip\", archive, &stage, limit, fault),\n            3 => extract_compressed_tar(\"xz\", archive, &stage, limit, fault),\n            4 => extract_compressed_tar(\"bzip2\", archive, &stage, limit, fault),\n            _ => Err(format!(\"unsupported non-ZIP format code={format_code}\")),\n        }?;\n        let mut tree_files = 0usize;\n        let mut stack = vec![stage.clone()];\n        while let Some(directory) = stack.pop() {\n            for entry in fs::read_dir(&directory).map_err(|error| format!(\"read {}: {error}\", directory.display()))? {\n                let path = entry.map_err(|error| error.to_string())?.path();\n                let metadata = fs::symlink_metadata(&path).map_err(|error| error.to_string())?;\n                if metadata.file_type().is_symlink() {\n                    let relative = path.strip_prefix(&stage).map_err(|error| format!(\"relative symlink {}: {error}\", path.display()))?;\n                    let target = fs::read_link(&path).map_err(|error| format!(\"read symlink {}: {error}\", path.display()))?;\n                    if !archive_deflate_domain::archive_link_target_confined(relative, &target) { return Err(format!(\"tar symlink escapes root: {} -> {}\", relative.display(), target.display())); }\n                    tree_files += 1;\n                } else if metadata.is_dir() { stack.push(path); } else if metadata.is_file() { tree_files += 1; } else { return Err(format!(\"tar extraction produced special entry: {}\", path.display())); }\n            }\n        }\n        if archive_deflate_domain::eoie_archive_complete_binding(receipt.1 as i32, tree_files as i32) != 1 || archive_deflate_domain::eoie_archive_tree_binding(1, 1) != 1 { return Err(format!(\"typed archive completion rejected payloads={} tree_files={tree_files}\", receipt.1)); }\n        if archive_deflate_domain::eoie_archive_budget_binding(limit as i32, receipt.2 as i32) != 1 { return Err(\"typed archive budget rejected\".to_owned()); }\n        if archive_deflate_domain::eoie_archive_fault_binding(fault, 2) == 1 { return Err(\"injected archive fault before-commit\".to_owned()); }\n        Ok(receipt)\n    })();\n    match result {\n        Ok((entries, payloads, bytes)) => { rooted_promote_directory_within(parent, &stage, destination)?; println!(\"eoie proxy archive-extract ok entries_total={entries} payloads={payloads} bytes={bytes} format={format_name} receipt=typed-generic\"); Ok(()) },\n        Err(error) => match rooted_remove_tree_within(parent, &stage) { Ok(_) => Err(format!(\"archive extraction rolled back: {error}\")), Err(rollback) => Err(format!(\"archive extraction failed: {error}; rollback failed: {rollback}\")) },\n    }\n}\n"

inl emit_long_name_tests () : () = ()

// Unix archive permissions synthesized from Windows attributes.
let bundle_portable_mode_binding (executable : i32) (readonly : i32) : i32 =
    if !!!!EQ(executable,1i32) then
        if !!!!EQ(readonly,1i32) then 365i32 else 493i32
    else
        if !!!!EQ(readonly,1i32) then 292i32 else 420i32

inl main () : i32 =
    inl _ = deterministic_plan ()
    inl _ = manifest_parity_binding 1i32 1i32
    inl _ = manifest_executable_mode_binding 1i32 1i32
    $"RustExportI32Binary(\"eoie_bundle_manifest_parity_binding\",\"manifest_parity_binding\")" : ()
    $"RustExportI32Binary(\"eoie_bundle_manifest_executable_mode_binding\",\"manifest_executable_mode_binding\")" : ()
    inl _ = bundle_portable_mode_binding 1i32 0i32
    $"RustExportI32Binary(\"eoie_bundle_portable_mode_binding\",\"bundle_portable_mode_binding\")" : ()
    emit_runtime ()
    emit_archive_extract_runtime ()
    emit_long_name_tests ()
    $"RustLibrary()" : ()
    0i32
