inl rust_global (x : string) : () = real
    typecase `(!!!!LitToTypeLit(x)) with ~x =>
    $"RustGlobal(@x)" : ()

inl main () : i32 =
    rust_global "#![allow(clippy::needless_return, clippy::needless_late_init)]"
    rust_global "use eoie_bundle_retention::{apply_retention_with_fault, plan_retention, RetentionFault};"
    rust_global "use std::collections::BTreeMap;"
    rust_global "use std::fs;"
    rust_global "use std::path::{Path, PathBuf};"
    rust_global "use std::time::{SystemTime, UNIX_EPOCH};"
    rust_global "fn retention_negative_root() -> PathBuf { let stamp = SystemTime::now().duration_since(UNIX_EPOCH).expect(\"clock\").as_nanos(); std::env::temp_dir().join(format!(\"eoie-retention-negative-{}-{stamp}\", std::process::id())) }"
    rust_global "fn retention_bundle_name(index: usize) -> String { format!(\"bundle_eoie_alpha{index}.zip\") }"
    rust_global "fn retention_prepare(root: &Path) { fs::create_dir_all(root.join(\"state\")).expect(\"state\"); fs::write(root.join(\"state/package.spiproj\"), \"modules:\\n    retention_receipt\\n\").expect(\"package\"); for index in 1usize..=5 { fs::write(root.join(retention_bundle_name(index)), format!(\"payload-{index}\")).expect(\"bundle\"); } }"
    rust_global "fn retention_bytes(root: &Path) -> BTreeMap<String, Vec<u8>> { let mut out = BTreeMap::new(); for index in 1usize..=5 { let name = retention_bundle_name(index); out.insert(name.clone(), fs::read(root.join(name)).expect(\"read bundle\")); } out }"
    rust_global "fn retention_stage_exists(root: &Path) -> bool { fs::read_dir(root).expect(\"read root\").filter_map(Result::ok).any(|entry| entry.file_name().to_string_lossy().starts_with(\".eoie-retention-stage-\")) }"
    rust_global "fn physical_negative() -> i32 { let root = retention_negative_root(); retention_prepare(&root); let receipt = root.join(\"state/retention_receipt.spi\"); let stale = retention_bundle_name(4); assert!(plan_retention(&root, &stale, &receipt).is_err()); let current = retention_bundle_name(5); let plan = plan_retention(&root, &current, &receipt).expect(\"plan\"); assert_eq!(plan.delete_count, 2); assert!(apply_retention_with_fault(&root, &current, &receipt, \"wrong\", RetentionFault::None).is_err()); let before = retention_bytes(&root); let error = apply_retention_with_fault(&root, &current, &receipt, &plan.fingerprint, RetentionFault::AfterFirstDelete).expect_err(\"first-delete fault\"); assert!(error.contains(\"rollback\")); assert_eq!(retention_bytes(&root), before); assert!(!retention_stage_exists(&root)); let plan = plan_retention(&root, &current, &receipt).expect(\"replan\"); let error = apply_retention_with_fault(&root, &current, &receipt, &plan.fingerprint, RetentionFault::AfterAllDeletes).expect_err(\"all-delete fault\"); assert!(error.contains(\"rollback\")); assert_eq!(retention_bytes(&root), before); assert!(!retention_stage_exists(&root)); fs::remove_dir_all(root).expect(\"cleanup\"); 0 }"
    $"physical_negative()" : i32
