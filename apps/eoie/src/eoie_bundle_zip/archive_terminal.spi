inl rust_global (x : string) : () = real typecase `(!!!!LitToTypeLit(x)) with ~x => $"RustGlobal(@x)" : ()
inl emit_runtime () : () =
    rust_global "fn workspace_members_from_manifest(source: &str) -> Result<BTreeSet<String>, String> {\n    let parsed = eoie_bundle_workspace_members_parse(source);\n    if parsed.is_empty() { return Err(\"workspace members mapping missing, malformed, empty, or duplicate\".to_owned()); }\n    Ok(parsed.lines().map(str::to_owned).collect())\n}\n\n"
    rust_global (sm.concat "use owner_growth_runtime::{owner_growth_seed, owner_growth_author, owner_growth_all_owner_check};\nuse archive_deflate_domain::archive_extract_with_limit;\nuse bundle_lifecycle_domain::{eoie_archive_extract_complete_binding, eoie_archive_extract_preflight_binding, eoie_archive_extract_process_binding, eoie_archive_extract_receipt_binding, eoie_bundle_complete_binding, eoie_bundle_coverage_checkpoint_binding, eoie_bundle_entry_binding, eoie_bundle_output_complete_binding, eoie_bundle_output_preflight_binding, eoie_bundle_verify_complete_binding, eoie_bundle_verify_preflight_binding, eoie_bundle_payload_count_binding, eoie_bundle_rehydrate_preflight_binding, eoie_bundle_rehydrate_extract_binding, eoie_bundle_rehydrate_validate_binding, eoie_bundle_rehydrate_receipt_binding, eoie_bundle_root_binding, eoie_bundle_size_binding};\nuse eoie_proxy_search::inspection_file_sha256;\nuse evidence_currentness_domain::check_evidence_tree;\nuse rating_guard_runtime::active_rating_receipt_check;\nuse eoie_release_hygiene::{prune_compiler_sidecars, prune_release_transients, validate_runtime_filenames};\nuse eoie_bundle_manifest::{collect_bundle_manifest, eoie_bundle_manifest_parity_binding, manifest_fingerprint, manifest_from_archive_entries, verify_archive_parity, verify_generic_flat_zip, verify_manifest_parity, zip_entries, write_deterministic_deflate_zip};\nuse eoie_rust_std_fs::{read_regular_text_limited, rooted_canonical_directory, rooted_list_names, rooted_open_regular_read, rooted_regular_size, rooted_entry_exists};\nuse eoie_rust_std_fs_mutation::{rooted_remove_regular, rooted_remove_tree_within};\nuse state_receipt_codec_core::{eoie_state_receipt_coverage_checkpoint_kind, eoie_state_receipt_coverage_checkpoint_sha, eoie_state_receipt_u64_decimal_valid, eoie_state_receipt_u64_decimal_value};\nuse state_recovered_topology_codec::{eoie_bundle_profile_signature_binding, eoie_bundle_rehydrate_structure_binding, eoie_state_receipt_recovered_fixture_paths, eoie_state_receipt_recovered_fixture_record_count_or_max, eoie_state_receipt_recovered_topology_count_or_max};\nuse std::collections::BTreeSet;\nuse std::env;\n\nuse std::path::Path;\n\n#[derive(Default)]\nstruct BundleReport { errors: Vec<String>, crate_lines: Vec<(String, usize)>, public_bins: usize, state_files: usize, source_packages: usize, cargo_crates: usize, spiral_only_packages: usize }\n\nfn arg<'a>(args: &'a [String], index: usize, name: &str) -> Result<&'a str, String> { args.get(index).map(String::as_str).ok_or_else(|| format!(\"missing argument: {name}\")) }\nfn parsed_max_bytes(value: &str) -> Result<u64, String> { if eoie_state_receipt_u64_decimal_valid(value) != 1 { return Err(\"max-bytes must be an unsigned integer\".to_owned()); } Ok(eoie_state_receipt_u64_decimal_value(value)) }\n\nfn rollback_rehydrate_destination(destination: &Path) -> Result<(), String> {\n    if !rooted_entry_exists(destination)? { return Ok(()); }\n    let parent = destination.parent().ok_or_else(|| format!(\"rehydration destination has no parent: {}\", destination.display()))?;\n    rooted_remove_tree_within(parent, destination).map(|_| ())\n}\n\nfn remove_bundle_output(output: &Path) -> Result<(), String> {\n    if !rooted_entry_exists(output)? { return Ok(()); }\n    rooted_remove_regular(output)\n}\n\nfn walk_crate(path: &Path, lines: &mut usize, report: &mut BundleReport) -> Result<(), String> {\n    for name in rooted_list_names(path)? {\n        let child = path.join(&name);\n        if rooted_list_names(&child).is_ok() {\n            if name == BUNDLE_ROOT_ENTRIES[2] { report.errors.push(format!(\"nested src is forbidden: {}\", child.display())); }\n            walk_crate(&child, lines, report)?;\n        } else {\n            let source = read_regular_text_limited(&child, usize::MAX)?;\n            if name == BUNDLE_CRATE_FORBIDDEN_FILE { report.errors.push(format!(\"lib.rs is forbidden: {}\", child.display())); }\n            let source_file = child.extension().and_then(|value| value.to_str()).is_some_and(|extension| BUNDLE_SOURCE_EXTENSIONS.contains(&extension));\n            if !source_file && !BUNDLE_CRATE_ALLOWED_FILES.contains(&name.as_str()) { report.errors.push(format!(\"unexpected crate file: {}\", child.display())); }\n            if source_file { *lines += source.lines().count(); }\n        }\n    }\n    Ok(())\n}\n\n" (sm.concat (bundle_policy_domain.policy.bundle_profile_runtime_rust ()) "fn check_generic_bundle(root: &Path) -> Result<BundleReport, String> {\n    let mut report = BundleReport::default();\n    if rooted_list_names(root).is_err() {\n        report.errors.push(format!(\"generic bundle root is not a directory: {}\", root.display()));\n        return Ok(report);\n    }\n    let manifest = collect_bundle_manifest(root)?;\n    if manifest.is_empty() { report.errors.push(\"generic bundle root is empty\".to_owned()); }\n    Ok(report)\n}\n\nfn check_bundle(root: &Path) -> Result<BundleReport, String> {\n    let mut report = BundleReport::default();\n    if let Err(error) = owner_growth_all_owner_check(root) { report.errors.push(error); }\n    if let Err(error) = active_rating_receipt_check(root) { report.errors.push(error); }\n    if let Err(error) = validate_runtime_filenames(root) { report.errors.push(error); }\n    let roots: BTreeSet<String> = rooted_list_names(root)?.into_iter().collect();\n    let expected: BTreeSet<String> = BUNDLE_ROOT_ENTRIES.into_iter().map(str::to_owned).collect();\n    for unexpected in roots.difference(&expected) { report.errors.push(format!(\"unexpected bundle root entry: {unexpected}\")); }\n    for missing in expected.difference(&roots) { report.errors.push(format!(\"missing bundle root entry: {missing}\")); }\n    if eoie_bundle_root_binding(i32::try_from(BUNDLE_ROOT_ENTRIES.len()).unwrap_or(i32::MAX), i32::try_from(roots.len()).unwrap_or(i32::MAX)) != 1 { report.errors.push(format!(\"typed bundle root mismatch: observed {}\", roots.len())); }\n    let state = root.join(BUNDLE_ROOT_ENTRIES[3]);\n    let evidence = root.join(BUNDLE_ROOT_ENTRIES[1]);\n    if rooted_list_names(&evidence).is_err() {\n        report.errors.push(\"missing evidence root\".to_owned());\n    } else {\n        if let Err(error) = check_evidence_tree(root) { report.errors.push(format!(\"evidence currentness: {error}\")); }\n        if let Err(error) = semantic_evidence_domain::verify_closeout_registry(root, semantic_evidence_domain::observed_migration_from_state(root)?) { report.errors.push(format!(\"semantic closeout: {error}\")); }\n        if let Err(error) = cold_proof_domain::verify_formal_authority(root) { report.errors.push(format!(\"ColdProofV4: {error}\")); }\n        for name in rooted_list_names(&evidence)? {\n            let path = evidence.join(name);\n            if rooted_list_names(&path).is_err() { report.errors.push(format!(\"unexpected evidence entry: {}\", path.display())); }\n        }\n        let coverage_dir = evidence.join(BUNDLE_EVIDENCE_PATHS[0]);\n        if rooted_list_names(&coverage_dir).is_err() {\n            report.errors.push(\"missing evidence/coverage directory\".to_owned());\n        } else {\n            for name in rooted_list_names(&coverage_dir)? {\n                let path = coverage_dir.join(name);\n                if read_regular_text_limited(&path, usize::MAX).is_err() { report.errors.push(format!(\"unexpected coverage evidence entry: {}\", path.display())); }\n            }\n        }\n        let coverage_source = read_regular_text_limited(&state.join(BUNDLE_STATE_WITNESS_FILES[0]), usize::MAX)?;\n        let checkpoint_kind = eoie_state_receipt_coverage_checkpoint_kind(&coverage_source);\n        if checkpoint_kind == 0 { report.errors.push(\"coverage checkpoint state is absent\".to_owned()); }\n        let declared_durable = i32::from(checkpoint_kind == 2);\n        let checkpoint = coverage_dir.join(BUNDLE_EVIDENCE_PATHS[1]);\n        let mut evidence_code = 0i32;\n        if rooted_open_regular_read(&checkpoint).is_ok() {\n            evidence_code = 1;\n            if checkpoint_kind == 2 {\n                let expected_sha = eoie_state_receipt_coverage_checkpoint_sha(&coverage_source);\n                if expected_sha.is_empty() {\n                    report.errors.push(\"coverage durable checkpoint sha is missing\".to_owned());\n                } else {\n                    match inspection_file_sha256(&checkpoint) {\n                        Ok(observed_sha) if observed_sha == expected_sha.as_ref() => evidence_code = 2,\n                        Ok(observed_sha) => report.errors.push(format!(\"coverage checkpoint sha mismatch: expected={expected_sha} observed={observed_sha}\")),\n                        Err(error) => report.errors.push(format!(\"coverage checkpoint hash failed: {error}\")),\n                    }\n                }\n            }\n        }\n        if eoie_bundle_coverage_checkpoint_binding(declared_durable, evidence_code) != 1 {\n            report.errors.push(format!(\"coverage checkpoint durability rejected: declared_durable={declared_durable} evidence_code={evidence_code}\"));\n        }\n    }\n    if let Ok(state_names) = rooted_list_names(&state) {\n        report.state_files = state_names.len();\n        for required in BUNDLE_STATE_REQUIRED_FILES { if !state_names.iter().any(|name| name == required) { report.errors.push(format!(\"missing state/{required}\")); } } let fixture_path = state.join(BUNDLE_STATE_WITNESS_FILES[1]); if state_names.iter().any(|name| name == BUNDLE_STATE_WITNESS_FILES[1]) || state_names.iter().any(|name| name == BUNDLE_STATE_WITNESS_FILES[2]) { if !state_names.iter().any(|name| name == BUNDLE_STATE_WITNESS_FILES[1]) || !state_names.iter().any(|name| name == BUNDLE_STATE_WITNESS_FILES[2]) { report.errors.push(\"recovered capability fixture ledger and dogfood gate must coexist\".to_owned()); } else { let ledger = read_regular_text_limited(&fixture_path, usize::MAX)?; let fixture_count = eoie_state_receipt_recovered_fixture_record_count_or_max(&ledger); if fixture_count == u64::MAX { report.errors.push(\"invalid settled fixture ledger\".to_owned()); } else { let fixture_paths = eoie_state_receipt_recovered_fixture_paths(&ledger); for relative in fixture_paths.lines() { let path = root.join(relative); if !rooted_open_regular_read(&path).is_ok() { report.errors.push(format!(\"missing settled fixture evidence: {}\", path.display())); } } let declared_count = eoie_state_receipt_recovered_topology_count_or_max(&ledger); let dogfood = read_regular_text_limited(&state.join(BUNDLE_STATE_WITNESS_FILES[2]), usize::MAX)?; let settled_count = eoie_state_receipt_recovered_topology_count_or_max(&dogfood); if fixture_count != declared_count || declared_count != settled_count { report.errors.push(format!(\"recovered capability fixture mismatch: records={fixture_count} declared={declared_count} dogfood={settled_count}\")); } } } }\n        for name in state_names {\n            let path = state.join(&name);\n            if rooted_list_names(&path).is_ok() || (name != BUNDLE_STATE_REQUIRED_FILES[0] && path.extension().and_then(|value| value.to_str()) != Some(BUNDLE_SOURCE_EXTENSIONS[1])) { report.errors.push(format!(\"state must be flat Spiral: {}\", path.display())); }\n            else { let _ = read_regular_text_limited(&path, usize::MAX)?; }\n        }\n    }\n    let src = root.join(BUNDLE_ROOT_ENTRIES[2]);\n    if let Ok(src_names) = rooted_list_names(&src) {\n        let mut physical_cargo_members = BTreeSet::new();\n        for required in BUNDLE_SOURCE_REQUIRED_FILES { if !src_names.iter().any(|name| name == required) { report.errors.push(format!(\"missing src/{required}\")); } }\n        for source_name in src_names {\n            let path = src.join(&source_name);\n            if rooted_list_names(&path).is_err() {\n                let _ = read_regular_text_limited(&path, usize::MAX)?;\n                if !BUNDLE_SOURCE_ROOT_FILES.contains(&source_name.as_str()) { report.errors.push(format!(\"source root file is forbidden: {}\", path.display())); }\n                continue;\n            }\n            if source_name == BUNDLE_SOURCE_SPECIAL_DIRECTORIES[0] { if read_regular_text_limited(&path.join(BUNDLE_CARGO_CONFIG_FILE), usize::MAX).is_err() { report.errors.push(\"missing or invalid src/.cargo/config.toml\".to_owned()); } continue; }\n            if source_name == BUNDLE_SOURCE_SPECIAL_DIRECTORIES[1] {\n                for vendor_name in rooted_list_names(&path)? {\n                    let vendor_path = path.join(&vendor_name);\n                    let Ok(vendor_names) = rooted_list_names(&vendor_path) else { report.errors.push(format!(\"invalid vendor entry: {}\", vendor_path.display())); continue; };\n                    let cargo = vendor_path.join(BUNDLE_SOURCE_REQUIRED_FILES[0]);\n                    let checksum = vendor_path.join(BUNDLE_VENDOR_CHECKSUM_FILE);\n                    if !vendor_names.iter().any(|name| name == BUNDLE_SOURCE_REQUIRED_FILES[0]) || !vendor_names.iter().any(|name| name == BUNDLE_VENDOR_CHECKSUM_FILE) || read_regular_text_limited(&cargo, usize::MAX).is_err() || read_regular_text_limited(&checksum, usize::MAX).is_err() { report.errors.push(format!(\"incomplete vendored crate: {}\", vendor_path.display())); }\n                }\n                continue;\n            }\n            let package_names = rooted_list_names(&path)?;\n            let package_file = path.join(BUNDLE_SOURCE_REQUIRED_FILES[1]);\n            let cargo_file = path.join(BUNDLE_SOURCE_REQUIRED_FILES[0]);\n            report.source_packages += 1;\n            if !package_names.iter().any(|name| name == BUNDLE_SOURCE_REQUIRED_FILES[1]) || read_regular_text_limited(&package_file, usize::MAX).is_err() { report.errors.push(format!(\"missing or invalid {}/package.spiproj\", path.display())); }\n            if package_names.iter().any(|name| name == BUNDLE_SOURCE_REQUIRED_FILES[0]) {\n                physical_cargo_members.insert(source_name.clone());\n                report.cargo_crates += 1;\n                report.public_bins += read_regular_text_limited(&cargo_file, usize::MAX)?.match_indices(\"[[bin]]\").count();\n            } else {\n                report.spiral_only_packages += 1;\n                let has_rust = package_names.iter().any(|name| Path::new(name).extension().and_then(|value| value.to_str()) == Some(BUNDLE_SOURCE_EXTENSIONS[0]));\n                if has_rust { report.errors.push(format!(\"Spiral-only package contains Rust source: {}\", path.display())); }\n            }\n            let mut lines = 0usize;\n            walk_crate(&path, &mut lines, &mut report)?;\n            let name = path.file_name().and_then(|value| value.to_str()).unwrap_or(\"crate\").to_owned();\n            report.crate_lines.push((name.clone(), lines));\n            if lines > BUNDLE_CRATE_LINE_LIMIT { report.errors.push(format!(\"crate line budget exceeded: {name} has {lines}\")); }\n        }\n        let workspace_manifest = read_regular_text_limited(&src.join(BUNDLE_SOURCE_REQUIRED_FILES[0]), usize::MAX)?;\n        match workspace_members_from_manifest(&workspace_manifest) {\n            Ok(workspace_members) => {\n                let bijective = i32::from(workspace_members == physical_cargo_members);\n                if eoie_bundle_manifest_mapping_binding(1, bijective) != 1 {\n                    let missing = workspace_members.difference(&physical_cargo_members).cloned().collect::<Vec<_>>();\n                    let undeclared = physical_cargo_members.difference(&workspace_members).cloned().collect::<Vec<_>>();\n                    report.errors.push(format!(\"workspace member mapping mismatch: missing_physical={missing:?} undeclared_physical={undeclared:?}\"));\n                }\n            }\n            Err(error) => {\n                let _ = eoie_bundle_manifest_mapping_binding(0, 0);\n                report.errors.push(format!(\"workspace member mapping: {error}\"));\n            }\n        }\n    }\n    if report.public_bins != BUNDLE_PUBLIC_BINARY_COUNT { report.errors.push(format!(\"expected {BUNDLE_PUBLIC_BINARY_COUNT} public binary, found {}\", report.public_bins)); }\n    if !rooted_open_regular_read(&root.join(BUNDLE_ROOT_ENTRIES[0])).is_ok() { report.errors.push(\"root eoie binary is missing\".to_owned()); }\n    Ok(report)\n}\n\nfn print_report(report: &BundleReport) { for (name, lines) in &report.crate_lines { println!(\"crate {name} lines={lines}\"); } println!(\"state files={} count_policy=unbounded\", report.state_files); for error in &report.errors { eprintln!(\"bundle error: {error}\"); } }\n\nfn verify_flat_zip(archive: &Path) -> Result<usize, String> {\n    let entries = zip_entries(archive)?;\n    let manifest = manifest_from_archive_entries(&entries)?;\n    let binary_evidence_mask = i32::from(entries.iter().any(|entry| entry == BUNDLE_ROOT_ENTRIES[0])) | (i32::from(entries.iter().any(|entry| entry.starts_with(BUNDLE_ARCHIVE_DIRECTORY_ROOTS[0]))) << 1); let source_state_mask = i32::from(entries.iter().any(|entry| entry.starts_with(BUNDLE_ARCHIVE_DIRECTORY_ROOTS[1]))) | (i32::from(entries.iter().any(|entry| entry.starts_with(BUNDLE_ARCHIVE_DIRECTORY_ROOTS[2]))) << 1); if eoie_bundle_archive_root_shape_binding(binary_evidence_mask, source_state_mask) != 1 { return Err(\"zip is wrapped or missing required eoie/evidence/src/state roots\".to_owned()); }\n    Ok(usize::try_from(eoie_bundle_payload_count_binding(i32::try_from(manifest.len()).unwrap_or(i32::MAX), 0)).unwrap_or(0))\n}\n\nfn flat_verification_receipt(count: usize, bytes: u64, max_bytes: u64) -> Result<(), String> {\n    let size_valid = eoie_flat_bundle_size_binding(i32::from(max_bytes > 0), i32::from(bytes <= max_bytes));\n    let manifest_valid = eoie_flat_bundle_manifest_binding(i32::from(count > 0), 1);\n    if size_valid != 1 { return Err(format!(\"flat archive size rejected: bytes={bytes} limit={max_bytes}\")); }\n    if manifest_valid != 1 { return Err(\"flat archive manifest rejected\".to_owned()); }\n    if eoie_flat_bundle_complete_binding(manifest_valid, size_valid) != 1 { return Err(\"flat archive completion rejected\".to_owned()); }\n    Ok(())\n}\n\nfn extract_flat_archive(archive: &Path, destination: &Path) -> Result<usize, String> {\n    Ok(archive_extract_with_limit(archive, destination, BUNDLE_EXTRACT_MAX_BYTES)?.1)\n}\n\nfn dispatch(args: &[String]) -> Result<(), String> {\n    match arg(args, 0, \"subcommand\")? {\n        \"growth-baseline\" => {\n            let predecessor = Path::new(arg(args, 1, \"predecessor.zip\")?); let previous = Path::new(arg(args, 2, \"previous-root\")?); let root = Path::new(arg(args, 3, \"root\")?); owner_growth_seed(predecessor, previous, root)\n        }\n        \"growth-receipt\" => {\n            let root = Path::new(arg(args, 1, \"root\")?); let reason = arg(args, 2, \"reason\")?; let reference = arg(args, 3, \"reference\")?; owner_growth_author(root, reason, reference)\n        }\n        \"check\" => {\n            let root = Path::new(arg(args, 1, \"root\")?);\n            let profile = resolve_bundle_profile(args.get(2).map(String::as_str), root)?;\n            let before = collect_bundle_manifest(root)?;\n            let report = if profile == 2 { check_bundle(root)? } else { check_generic_bundle(root)? };\n            let after = collect_bundle_manifest(root)?;\n            let count_equal = i32::from(before.len() == after.len());\n            let fingerprint_equal = i32::from(manifest_fingerprint(&before) == manifest_fingerprint(&after));\n            if eoie_bundle_manifest_parity_binding(count_equal, fingerprint_equal) != 1 { return Err(\"bundle check manifest parity rejected\".to_owned()); }\n            verify_manifest_parity(&before, &after)?;\n            print_report(&report);\n            if !report.errors.is_empty() { return Err(format!(\"bundle contract failed with {} errors\", report.errors.len())); }\n            println!(\"eoie bundle check ok profile={} public_binaries={} manifest_fingerprint={:016x}\", if profile == 2 { \"eoie\" } else { \"generic\" }, report.public_bins, manifest_fingerprint(&after));\n            Ok(())\n        }\n        \"create\" => {\n            let root = rooted_canonical_directory(Path::new(arg(args, 1, \"root\")?))?;\n            let output_arg = Path::new(arg(args, 2, \"output.zip\")?);\n            let output = if output_arg.is_absolute() { output_arg.to_path_buf() } else { env::current_dir().map_err(|error| error.to_string())?.join(output_arg) };\n            let profile = resolve_bundle_profile(args.get(3).map(String::as_str), &root)?;\n            if profile == 2 {\n                let hygiene_args = vec![\"prune-compiler-sidecars\".to_owned(), root.display().to_string()];\n                prune_compiler_sidecars(&hygiene_args)?;\n                let transient_args = vec![\"prune-release-transients\".to_owned(), root.display().to_string()];\n                prune_release_transients(&transient_args)?;\n            }\n            let report = if profile == 2 { check_bundle(&root)? } else { check_generic_bundle(&root)? };\n            print_report(&report);\n            if !report.errors.is_empty() { return Err(\"bundle contract failed\".to_owned()); }\n            if eoie_bundle_output_preflight_binding(i32::from(!output.starts_with(&root)), i32::from(!rooted_entry_exists(&output)? || rooted_open_regular_read(&output).is_ok())) != 1 { return Err(\"zip output must be outside bundle root\".to_owned()); }\n            remove_bundle_output(&output)?;\n            let manifest = collect_bundle_manifest(&root)?;\n            write_deterministic_deflate_zip(&root, &output, &manifest)?; let output_bytes = rooted_regular_size(&output)?; if eoie_bundle_output_complete_binding(i32::from(!output.starts_with(&root)), i32::from(output_bytes > 0)) != 1 { remove_bundle_output(&output)?; return Err(output.display().to_string()); }\n            let count = if profile == 2 { verify_flat_zip(&output)? } else { verify_generic_flat_zip(&output, BUNDLE_ARCHIVE_MAX_BYTES)?.0 };\n            verify_archive_parity(&output, &manifest)?;\n            let expected_entries = i32::try_from(manifest.len()).unwrap_or(i32::MAX);\n            let observed_entries = i32::try_from(count).unwrap_or(i32::MAX);\n            if eoie_bundle_entry_binding(expected_entries, observed_entries) != 1 { return Err(format!(\"typed archive entry mismatch: collected={} archive={count}\", manifest.len())); }\n            let bytes = output_bytes;\n            if eoie_bundle_size_binding(BUNDLE_ARCHIVE_MAX_BYTES as i32, i32::try_from(bytes).unwrap_or(i32::MAX)) != 1 { remove_bundle_output(&output)?; return Err(format!(\"bundle exceeds typed size limit: {bytes}\")); }\n            let fingerprint = manifest_fingerprint(&manifest);\n            println!(\"eoie bundle create ok profile={} entries={count} bytes={bytes} manifest_fingerprint={fingerprint:016x} output={}\", if profile == 2 { \"eoie\" } else { \"generic\" }, output.display());\n            Ok(())\n        }\n        \"create-flat\" => {\n            let root = rooted_canonical_directory(Path::new(arg(args, 1, \"root\")?))?;\n            let output_arg = Path::new(arg(args, 2, \"output.zip\")?);\n            let output = if output_arg.is_absolute() { output_arg.to_path_buf() } else { env::current_dir().map_err(|error| error.to_string())?.join(output_arg) };\n            let max_bytes = parsed_max_bytes(arg(args, 3, \"max-bytes\")?)?;\n            if eoie_flat_bundle_preflight_binding(i32::from(rooted_list_names(&root).is_ok()), i32::from(!output.starts_with(&root))) != 1 {\n                return Err(\"flat bundle preflight rejected\".to_owned());\n            }\n            remove_bundle_output(&output)?;\n            let manifest = collect_bundle_manifest(&root)?;\n            if eoie_flat_bundle_manifest_binding(i32::from(!manifest.is_empty()), 1) != 1 {\n                return Err(\"flat bundle manifest rejected\".to_owned());\n            }\n            let result = (|| -> Result<(usize, u64), String> {\n                if eoie_flat_bundle_compression_binding(1, 1) != 1 { return Err(\"flat bundle compression policy rejected\".to_owned()); }\n                write_deterministic_deflate_zip(&root, &output, &manifest)?;\n                let (count, bytes) = verify_generic_flat_zip(&output, max_bytes)?;\n                flat_verification_receipt(count, bytes, max_bytes)?;\n                verify_archive_parity(&output, &manifest)?;\n                Ok((count, bytes))\n            })();\n            let (count, bytes) = match result {\n                Ok(value) => value,\n                Err(error) => { remove_bundle_output(&output)?; return Err(error); }\n            };\n            println!(\"eoie bundle create-flat ok entries={count} bytes={bytes} manifest_fingerprint={:016x} output={}\", manifest_fingerprint(&manifest), output.display());\n            Ok(())\n        }\n        \"verify-flat\" => {\n            let archive = Path::new(arg(args, 1, \"archive.zip\")?);\n            let max_bytes = parsed_max_bytes(arg(args, 2, \"max-bytes\")?)?;\n            let (count, bytes) = verify_generic_flat_zip(archive, max_bytes)?;\n            flat_verification_receipt(count, bytes, max_bytes)?;\n            println!(\"eoie bundle verify-flat ok entries={count} bytes={bytes} limit={max_bytes}\");\n            Ok(())\n        }\n        \"verify\" => {\n            let archive = Path::new(arg(args, 1, \"archive.zip\")?);\n            let bytes = rooted_regular_size(archive)?;\n            if eoie_bundle_verify_preflight_binding(1, i32::from(bytes > 0)) != 1 { return Err(\"bundle verify preflight rejected\".to_owned()); }\n            let profile = resolve_bundle_archive_profile(args.get(2).map(String::as_str), archive)?;\n            let count = if profile == 2 { verify_flat_zip(archive)? } else { verify_generic_flat_zip(archive, BUNDLE_ARCHIVE_MAX_BYTES)?.0 };\n            let size_ok = eoie_bundle_size_binding(BUNDLE_ARCHIVE_MAX_BYTES as i32, i32::try_from(bytes).unwrap_or(i32::MAX));\n            if size_ok != 1 { return Err(format!(\"bundle exceeds typed size limit: {bytes}\")); }\n            if eoie_bundle_verify_complete_binding(i32::from(count > 0), size_ok) != 1 { return Err(\"bundle verify completion rejected\".to_owned()); }\n            println!(\"eoie bundle verify ok profile={} entries={count} bytes={bytes}\", if profile == 2 { \"eoie\" } else { \"generic\" });\n            Ok(())\n        }\n        \"rehydrate\" => {\n            let archive = Path::new(arg(args, 1, \"archive.zip\")?);\n            let destination = Path::new(arg(args, 2, \"destination\")?);\n            let destination_absent = i32::from(!rooted_entry_exists(destination)?);\n            let verified_entries = verify_generic_flat_zip(archive, BUNDLE_ARCHIVE_MAX_BYTES)?.0;\n            let preflight_ok = eoie_bundle_rehydrate_preflight_binding(i32::from(verified_entries > 0), destination_absent);\n            let archive_preflight_ok = eoie_archive_extract_preflight_binding(i32::from(destination_absent == 0), i32::from(verified_entries > 0));\n            if preflight_ok != 1 || archive_preflight_ok != 1 { return Err(\"typed rehydration preflight rejected\".to_owned()); }\n            let extracted_entries = extract_flat_archive(archive, destination)?;\n            let archive_complete_ok = eoie_archive_extract_complete_binding(i32::try_from(verified_entries).unwrap_or(i32::MAX), i32::try_from(extracted_entries).unwrap_or(i32::MAX));\n            let archive_process_ok = eoie_archive_extract_process_binding(1, i32::from(rooted_list_names(destination).is_ok()));\n            let archive_receipt_ok = eoie_archive_extract_receipt_binding(archive_preflight_ok, eoie_bundle_complete_binding(archive_process_ok, archive_complete_ok));\n            let extract_ok = eoie_bundle_rehydrate_extract_binding(i32::from(archive_complete_ok == 1), i32::from(rooted_list_names(destination).is_ok()));\n            if extract_ok != 1 || archive_receipt_ok != 1 { rollback_rehydrate_destination(destination)?; return Err(\"typed rehydration extraction rejected\".to_owned()); }\n            let profile = resolve_bundle_profile(args.get(3).map(String::as_str), destination)?;\n            let report = if profile == 2 { check_bundle(destination)? } else { check_generic_bundle(destination)? };\n            print_report(&report);\n            let structure_mask = i32::from(bundle_profile_signature(destination) == 1) | (i32::from(rooted_open_regular_read(&destination.join(BUNDLE_EOIE_AGILE_PATH)).is_ok()) << 1) | (i32::from(!collect_bundle_manifest(destination)?.is_empty()) << 2);\n            let structure_ok = eoie_bundle_rehydrate_structure_binding(profile, structure_mask) == 1;\n            let validate_ok = eoie_bundle_rehydrate_validate_binding(i32::from(report.errors.is_empty()), i32::from(structure_ok));\n            if validate_ok != 1 { rollback_rehydrate_destination(destination)?; return Err(format!(\"rehydrated {} bundle validation rejected\", if profile == 2 { \"eoie\" } else { \"generic\" })); }\n            let preflight_extract_ok = eoie_bundle_complete_binding(preflight_ok, extract_ok);\n            if eoie_bundle_rehydrate_receipt_binding(preflight_extract_ok, validate_ok) != 1 { rollback_rehydrate_destination(destination)?; return Err(\"typed rehydration receipt incomplete\".to_owned()); }\n            println!(\"eoie bundle rehydrate ok profile={} entries={extracted_entries} destination={} receipt=typed\", if profile == 2 { \"eoie\" } else { \"generic\" }, destination.display());\n            Ok(())\n        }\n        _ => Err(\"bundle supports growth-baseline, growth-receipt, check, create, create-flat, verify, verify-flat, rehydrate\".to_owned()),\n    }\n}\n\n#[must_use]\npub fn bundle_run() -> i32 {\n    let args = env::args().skip(2).collect::<Vec<_>>();\n    if let Err(error) = dispatch(&args) { eprintln!(\"eoie error: {error}\"); 2 } else { 0 }\n}\n\n"))
