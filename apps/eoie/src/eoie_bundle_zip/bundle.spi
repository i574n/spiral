nominal bundle_idle = ()
nominal bundle_hygiene_pruned = ()
nominal bundle_root_validated = ()
nominal bundle_files_collected = ()
nominal bundle_archive_created = ()
nominal bundle_archive_verified = ()
nominal bundle_archive_extracted = ()
nominal bundle_archive_links_validated = ()

union bundle_profile =
    | AutoBundleProfile
    | GenericBundleProfile
    | EoieBundleProfile

inl bundle_profile_model () : bundle_profile = AutoBundleProfile

let bundle_profile_resolve_binding (requested : i32) (eoie_signature : i32) : i32 =
    if !!!!EQ(requested,0i32) then
        if !!!!EQ(eoie_signature,1i32) then 2i32 else 1i32
    elif !!!!EQ(requested,1i32) then 1i32
    elif !!!!EQ(requested,2i32) then 2i32
    else -1i32

union bundle_op from to =
    | PruneCompilerSidecars :: bundle_op bundle_idle bundle_hygiene_pruned
    | ValidatePrunedBundleRoot :: bundle_op bundle_hygiene_pruned bundle_root_validated
    | ValidateBundleRoot :: bundle_op bundle_idle bundle_root_validated
    | CollectBundleFiles :: bundle_op bundle_root_validated bundle_files_collected
    | CreateFlatArchive :: bundle_op bundle_files_collected bundle_archive_created
    | VerifyFlatArchive :: bundle_op bundle_archive_created bundle_archive_verified
    | ExtractFlatArchive :: bundle_op bundle_archive_verified bundle_archive_extracted
    | ValidateConfinedArchiveLinks :: bundle_op bundle_archive_extracted bundle_archive_links_validated

union rec bundle_plan from to =
    | BundleStep :: forall from to. bundle_op from to -> bundle_plan from to
    | BundleThen :: forall from to. (exists middle. bundle_plan from middle * bundle_plan middle to) -> bundle_plan from to

inl check_plan () : bundle_plan bundle_idle bundle_root_validated = BundleStep ValidateBundleRoot

inl create_plan () : bundle_plan bundle_idle bundle_archive_verified =
    BundleThen (exists (
        BundleStep PruneCompilerSidecars,
        BundleThen (exists (
            BundleStep ValidatePrunedBundleRoot,
            BundleThen (exists (
                BundleStep CollectBundleFiles,
                BundleThen (exists (
                    BundleStep CreateFlatArchive,
                    BundleStep VerifyFlatArchive
                ))
            ))
        ))
    ))

inl extract_plan () : bundle_plan bundle_archive_created bundle_archive_links_validated =
    BundleThen (exists (
        BundleStep VerifyFlatArchive,
        BundleThen (exists (
            BundleStep ExtractFlatArchive,
            BundleStep ValidateConfinedArchiveLinks
        ))
    ))

let flat_preflight_binding (root_directory : i32) (output_outside_root : i32) : i32 =
    flat_bundle_contract.model.preflight_binding root_directory output_outside_root

let flat_manifest_binding (entries_positive : i32) (canonical_order : i32) : i32 =
    flat_bundle_contract.model.manifest_binding entries_positive canonical_order

let flat_size_binding (limit_positive : i32) (within_limit : i32) : i32 =
    flat_bundle_contract.model.size_binding limit_positive within_limit

let flat_compression_binding (deterministic : i32) (method_code : i32) : i32 =
    flat_bundle_contract.model.compression_binding deterministic method_code

let flat_complete_binding (manifest_valid : i32) (size_valid : i32) : i32 =
    flat_bundle_contract.model.complete_binding manifest_valid size_valid

let bundle_manifest_authority_binding (manifest_parsed : i32) (members_bijective : i32) : i32 =
    bundle_policy_domain.policy.bundle_manifest_mapping_binding manifest_parsed members_bijective

let bundle_archive_root_shape_binding (binary_evidence_mask : i32) (source_state_mask : i32) : i32 =
    if !!!!EQ(binary_evidence_mask,3i32) && !!!!EQ(source_state_mask,3i32) then 1i32 else 0i32

let rec bundle_workspace_members_loop
    (body : string) (at : i32) (body_len : i32) (seen : string) (out : string) : string =
    if (=.) at body_len then out
    else
        inl quote_at = find_char body at '"'
        if (=.) quote_at body_len then out
        else
            inl value_from = (+.) quote_at 1i32
            inl value_near_to = find_char body value_from '"'
            if (=.) value_near_to body_len then codec_empty ()
            else
                inl member = slice_exclusive body value_from value_near_to
                if (=.) member "" then codec_empty ()
                else
                    inl marker = sm.concat "\n" (sm.concat member "\n")
                    inl seen_len = sm.length seen : i32
                    if (<) (find_text seen 0i32 marker) seen_len then codec_empty ()
                    else
                        bundle_workspace_members_loop
                            body
                            ((+.) value_near_to 1i32)
                            body_len
                            (sm.concat seen (sm.concat member "\n"))
                            (sm.concat out (sm.concat member "\n"))

let bundle_workspace_members_parse (source : string) : string =
    inl source_len = sm.length source : i32
    inl members_at = find_text source 0i32 "members"
    if (=.) members_at source_len then codec_empty ()
    else
        inl open_at = find_char source members_at '['
        if (=.) open_at source_len then codec_empty ()
        else
            inl body_from = (+.) open_at 1i32
            inl body_near_to = find_char source body_from ']'
            if (=.) body_near_to source_len then codec_empty ()
            else
                inl body = slice_exclusive source body_from body_near_to
                bundle_workspace_members_loop body 0i32 (sm.length body : i32) "\n" ""

inl main () : i32 =
    inl _ = filesystem_directory_contract.model.policy_plan ()
    inl _ = bundle_output_contract.model.policy_plan ()
    inl _ = bundle_verify_contract.model.verify_policy_plan ()
    inl _ = crate_growth_contract.model.current_plan ()
    inl _ = flat_bundle_contract.model.policy_plan ()
    inl _ = flat_preflight_binding 1i32 1i32
    inl _ = flat_manifest_binding 1i32 1i32
    inl _ = flat_size_binding 1i32 1i32
    inl _ = flat_compression_binding 1i32 1i32
    inl _ = flat_complete_binding 1i32 1i32
    inl _ = bundle_profile_resolve_binding 0i32 0i32
    inl _ = bundle_profile_resolve_binding 0i32 1i32
    inl _ = bundle_profile_resolve_binding 1i32 1i32
    inl _ = bundle_profile_resolve_binding 2i32 0i32
    inl _ = bundle_policy_domain.policy.bundle_manifest_authority_plan ()
    inl _ = bundle_manifest_authority_binding 1i32 1i32
    inl _ = bundle_manifest_authority_binding 1i32 0i32
    inl _ = bundle_archive_root_shape_binding 3i32 3i32
    inl _ = bundle_archive_root_shape_binding 3i32 1i32
    inl _ = bundle_workspace_members_parse "members=[\"a\"]"


    archive_terminal.emit_runtime ()
    $"RustExportI32Binary(\"eoie_flat_bundle_preflight_binding\",\"flat_preflight_binding\")" : ()
    $"RustExportI32Binary(\"eoie_flat_bundle_manifest_binding\",\"flat_manifest_binding\")" : ()
    $"RustExportI32Binary(\"eoie_flat_bundle_size_binding\",\"flat_size_binding\")" : ()
    $"RustExportI32Binary(\"eoie_flat_bundle_compression_binding\",\"flat_compression_binding\")" : ()
    $"RustExportI32Binary(\"eoie_flat_bundle_complete_binding\",\"flat_complete_binding\")" : ()
    $"RustExportI32Binary(\"eoie_bundle_profile_resolve_binding\",\"bundle_profile_resolve_binding\")" : ()
    $"RustExportI32Binary(\"eoie_bundle_manifest_mapping_binding\",\"bundle_manifest_authority_binding\")" : ()
    $"RustExportI32Binary(\"eoie_bundle_archive_root_shape_binding\",\"bundle_archive_root_shape_binding\")" : ()
    $"RustExportStringUnary(\"eoie_bundle_workspace_members_parse\",\"bundle_workspace_members_parse\")" : ()
    $"RustLibrary()" : ()
    0i32
