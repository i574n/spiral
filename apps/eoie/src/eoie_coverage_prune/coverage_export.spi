inl rust_global (x : string) : () = real typecase `(!!!!LitToTypeLit(x)) with ~x => $"RustGlobal(@x)" : ()

inl emit_coverage_export () : () =
    rust_global "fn coverage_profraw_files(path: &Path) -> Result<Vec<PathBuf>, String> {"
    rust_global "    let metadata = fs::symlink_metadata(path).map_err(|error| format!(\"metadata {}: {error}\", path.display()))?;"
    rust_global "    if metadata.file_type().is_symlink() || !metadata.is_dir() { return Err(\"coverage profraw path must be a real directory\".to_owned()); }"
    rust_global "    let mut profiles = fs::read_dir(path).map_err(|error| error.to_string())?.try_fold(Vec::new(), |mut profiles, entry| -> Result<Vec<PathBuf>, String> { let child = entry.map_err(|error| error.to_string())?.path(); let child_metadata = fs::symlink_metadata(&child).map_err(|error| error.to_string())?; if child_metadata.file_type().is_symlink() { return Err(format!(\"coverage profile cannot be a symlink: {}\", child.display())); } if child_metadata.is_file() && child.extension().and_then(|value| value.to_str()) == Some(\"profraw\") { profiles.push(child); } Ok(profiles) })?;"
    rust_global "    profiles.sort();"
    rust_global "    if profiles.is_empty() { return Err(\"coverage export found no profraw profiles\".to_owned()); }"
    rust_global "    Ok(profiles)"
    rust_global "} // coverage_profraw_files"
    rust_global ""
    rust_global "fn coverage_export_command(grcov: &Path, profraw: &Path, binary_path: &Path, llvm_path: &Path, source: &Path, output: &Path) -> Command {"
    rust_global "    let mut command = Command::new(grcov);"
    rust_global "    command.arg(profraw).arg(\"-s\").arg(source).arg(\"-b\").arg(binary_path).arg(\"--llvm-path\").arg(llvm_path).args([\"-t\", \"lcov\", \"-o\"]).arg(output).args([\"--llvm\", \"--ignore-not-existing\", \"--ignore\", \"*/vendor/*\", \"--ignore\", \"vendor/*\", \"--ignore\", \"*/rustc/*\", \"--ignore\", \"rustc/*\"]);"
    rust_global "    command"
    rust_global "} // coverage_export_command"
    rust_global ""
    rust_global "pub fn coverage_export(args: &[String]) -> Result<(), String> {"
    rust_global "    if args.len() != 8 { return Err(\"coverage-export expects profraw-dir binary-path grcov llvm-bin-dir source-root output-lcov timeout-ms\".to_owned()); }"
    rust_global "    let profraw = Path::new(coverage_arg(args, 1, \"profraw-dir\")?);"
    rust_global "    let binary_path = Path::new(coverage_arg(args, 2, \"binary-path\")?);"
    rust_global "    let grcov = Path::new(coverage_arg(args, 3, \"grcov\")?);"
    rust_global "    let llvm_path = Path::new(coverage_arg(args, 4, \"llvm-bin-dir\")?);"
    rust_global "    let source = Path::new(coverage_arg(args, 5, \"source-root\")?);"
    rust_global "    let output = Path::new(coverage_arg(args, 6, \"output-lcov\")?);"
    rust_global "    let timeout_ms = coverage_arg(args, 7, \"timeout-ms\")?.parse::<u64>().map_err(|_| \"coverage export timeout must be a positive integer\".to_owned())?;"
    rust_global "    if timeout_ms == 0 { return Err(\"coverage export timeout must be positive\".to_owned()); }"
    rust_global "    let profiles = coverage_profraw_files(profraw)?;"
    rust_global "    for (label, path, directory) in [(\"binary path\", binary_path, false), (\"llvm path\", llvm_path, true), (\"source root\", source, true), (\"grcov\", grcov, false)] {"
    rust_global "        let metadata = fs::symlink_metadata(path).map_err(|error| format!(\"metadata {}: {error}\", path.display()))?;"
    rust_global "        if metadata.file_type().is_symlink() || (directory && !metadata.is_dir()) || (!directory && !metadata.is_file()) { return Err(format!(\"coverage export {label} has invalid type: {}\", path.display())); }"
    rust_global "    } // coverage_export metadata loop"
    rust_global "    if let Some(parent) = output.parent() { fs::create_dir_all(parent).map_err(|error| format!(\"create {}: {error}\", parent.display()))?; }"
    rust_global "    if output.exists() { let metadata = fs::symlink_metadata(output).map_err(|error| error.to_string())?; if metadata.file_type().is_symlink() || !metadata.is_file() { return Err(\"coverage output must be a regular file path\".to_owned()); } fs::remove_file(output).map_err(|error| error.to_string())?; }"
    rust_global "    let mut command = coverage_export_command(grcov, profraw, binary_path, llvm_path, source, output);"
    rust_global "    let _observation = coverage_run_bounded_streaming_checked(&mut command, timeout_ms, \"coverage-export\", None)?;"

    rust_global "    let output_metadata = fs::metadata(output).map_err(|error| format!(\"coverage output missing: {error}\"))?;"
    rust_global "    if !output_metadata.is_file() || output_metadata.len() == 0 { return Err(\"coverage export produced an empty LCOV file\".to_owned()); }"
    rust_global "    let lines = coverage_lcov_lines(output)?;"
    rust_global "    let ratio = coverage_ratio(&lines);"
    rust_global "    let hash = inspection_file_sha256(output)?;"
    rust_global "    let receipt = PathBuf::from(format!(\"{}.receipt\", output.display()));"
    rust_global "    let newline = char::from(10).to_string();"
    rust_global "    let receipt_text = [\"route=grcov-lcov\".to_owned(), format!(\"profiles={}\", profiles.len()), format!(\"lines={}\", lines.len()), format!(\"covered_permille={ratio}\"), format!(\"sha256={hash}\")].join(&newline) + &newline;"
    rust_global "    coverage_atomic_write(&receipt, receipt_text.as_bytes())?;"
    rust_global "    println!(\"eoie proxy coverage-export ok profiles={} lines={} covered={ratio}/1000 sha256={hash}\", profiles.len(), lines.len());"
    rust_global "    Ok(())"
    rust_global "} // coverage_export"
    rust_global ""
    rust_global "mod coverage_export_tests {"
    rust_global "    #[test] fn coverage_export_requires_profiles() { let root = std::env::temp_dir().join(format!(\"eoie-coverage-export-{}\", std::process::id())); let _ = std::fs::remove_dir_all(&root); std::fs::create_dir_all(&root).expect(\"root\"); assert!(super::coverage_profraw_files(&root).is_err()); std::fs::write(root.join(\"b.profraw\"), b\"b\").expect(\"b\"); std::fs::write(root.join(\"a.profraw\"), b\"a\").expect(\"a\"); let profiles = super::coverage_profraw_files(&root).expect(\"profiles\"); assert!(profiles[0].ends_with(\"a.profraw\")); assert!(profiles[1].ends_with(\"b.profraw\")); std::fs::remove_dir_all(root).expect(\"cleanup\"); }"
    rust_global "} // coverage_export_tests"