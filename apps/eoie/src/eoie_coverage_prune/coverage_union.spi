inl rust_global (x : string) : () = real typecase `(!!!!LitToTypeLit(x)) with ~x => $"RustGlobal(@x)" : ()

inl emit_coverage_union () : () =
    rust_global "fn coverage_union_records(path: &Path) -> Result<BTreeMap<String, BTreeMap<u32, u64>>, String> {"
    rust_global "    let metadata = fs::symlink_metadata(path).map_err(|error| format!(\"metadata {}: {error}\", path.display()))?;"
    rust_global "    if metadata.file_type().is_symlink() || !metadata.is_file() { return Err(format!(\"coverage union input must be a regular file: {}\", path.display())); }"
    rust_global "    let text = fs::read_to_string(path).map_err(|error| format!(\"read {}: {error}\", path.display()))?;"
    rust_global "    let mut active = String::new();"
    rust_global "    let mut records: BTreeMap<String, BTreeMap<u32, u64>> = BTreeMap::new();"
    rust_global "    for raw in text.lines() {"
    rust_global "        if let Some(source) = raw.strip_prefix(\"SF:\") { active = source.replace('\\\\', \"/\"); if active.is_empty() { return Err(\"coverage union found an empty SF record\".to_owned()); } }"
    rust_global "        else if let Some(value) = raw.strip_prefix(\"DA:\") {"
    rust_global "            if active.is_empty() { return Err(format!(\"coverage union found DA before SF in {}\", path.display())); }"
    rust_global "            let mut parts = value.split(',');"
    rust_global "            let line = parts.next().and_then(|part| part.parse::<u32>().ok()).filter(|line| *line > 0).ok_or_else(|| format!(\"coverage union found invalid DA line in {}\", path.display()))?;"
    rust_global "            let hits = parts.next().and_then(|part| part.parse::<u64>().ok()).ok_or_else(|| format!(\"coverage union found invalid DA hits in {}\", path.display()))?;"
    rust_global "            records.entry(active.clone()).or_default().entry(line).and_modify(|seen| *seen = (*seen).max(hits)).or_insert(hits);"
    rust_global "        } else if raw == \"end_of_record\" { active.clear(); }"
    rust_global "    }"
    rust_global "    if records.is_empty() { return Err(format!(\"coverage union input has no line records: {}\", path.display())); }"
    rust_global "    Ok(records)"
    rust_global "} // coverage_union_records"
    rust_global ""
    rust_global "fn coverage_union_merge(target: &mut BTreeMap<String, BTreeMap<u32, u64>>, source: BTreeMap<String, BTreeMap<u32, u64>>) {"
    rust_global "    for (file, lines) in source { let target_lines = target.entry(file).or_default(); for (line, hits) in lines { target_lines.entry(line).and_modify(|seen| *seen = (*seen).max(hits)).or_insert(hits); } }"
    rust_global "} // coverage_union_merge"
    rust_global ""
    rust_global "fn coverage_union_payload(records: &BTreeMap<String, BTreeMap<u32, u64>>) -> String {"
    rust_global "    let mut payload = String::new();"
    rust_global "    for (source, lines) in records { payload.push_str(\"SF:\"); payload.push_str(source); payload.push(char::from(10)); for (line, hits) in lines { payload.push_str(&format!(\"DA:{line},{hits}\\n\")); } payload.push_str(\"end_of_record\\n\"); }"
    rust_global "    payload"
    rust_global "} // coverage_union_payload"
    rust_global ""
    rust_global "pub fn coverage_union(args: &[String]) -> Result<(), String> {"
    rust_global "    if args.len() < 4 { return Err(\"coverage-union expects output-lcov and at least two input LCOV files\".to_owned()); }"
    rust_global "    let output = Path::new(coverage_arg(args, 1, \"output-lcov\")?);"
    rust_global "    let mut records: BTreeMap<String, BTreeMap<u32, u64>> = BTreeMap::new();"
    rust_global "    for input in &args[2..] { let path = Path::new(input); if path == output { return Err(\"coverage union output cannot also be an input\".to_owned()); } coverage_union_merge(&mut records, coverage_union_records(path)?); }"
    rust_global "    if output.exists() { let metadata = fs::symlink_metadata(output).map_err(|error| error.to_string())?; if metadata.file_type().is_symlink() || !metadata.is_file() { return Err(\"coverage union output must be a regular file path\".to_owned()); } }"
    rust_global "    let payload = coverage_union_payload(&records);"
    rust_global "    coverage_atomic_write(output, payload.as_bytes())?;"
    rust_global "    let flat = coverage_lcov_lines(output)?;"
    rust_global "    let ratio = coverage_ratio(&flat);"
    rust_global "    let hash = inspection_file_sha256(output)?;"
    rust_global "    let receipt = PathBuf::from(format!(\"{}.receipt\", output.display()));"
    rust_global "    let receipt_text = format!(\"route=lcov-union\\ninputs={}\\nlines={}\\ncovered_permille={ratio}\\nsha256={hash}\\n\", args.len() - 2, flat.len());"
    rust_global "    coverage_atomic_write(&receipt, receipt_text.as_bytes())?;"
    rust_global "    println!(\"eoie proxy coverage-union ok inputs={} lines={} covered={ratio}/1000 sha256={hash}\", args.len() - 2, flat.len());"
    rust_global "    Ok(())"
    rust_global "} // coverage_union"
    rust_global ""
    rust_global "mod coverage_union_tests {"
    rust_global "    #[test] fn coverage_union_merges_max_hits_and_writes_receipt() { let root = std::env::temp_dir().join(format!(\"eoie-coverage-union-{}\", std::process::id())); let _ = std::fs::remove_dir_all(&root); std::fs::create_dir_all(&root).expect(\"root\"); let first = root.join(\"first.lcov\"); let second = root.join(\"second.lcov\"); let output = root.join(\"union.lcov\"); std::fs::write(&first, b\"SF:src/a.rs\\nDA:1,1\\nDA:2,0\\nend_of_record\\n\").expect(\"first\"); std::fs::write(&second, b\"SF:src/a.rs\\nDA:1,3\\nDA:2,1\\nend_of_record\\n\").expect(\"second\"); let args = vec![\"coverage-union\".to_owned(), output.to_string_lossy().into_owned(), first.to_string_lossy().into_owned(), second.to_string_lossy().into_owned()]; super::coverage_union(&args).expect(\"union\"); let text = std::fs::read_to_string(&output).expect(\"output\"); assert!(text.contains(\"DA:1,3\")); assert!(text.contains(\"DA:2,1\")); let receipt = std::fs::read_to_string(format!(\"{}.receipt\", output.display())).expect(\"receipt\"); assert!(receipt.contains(\"inputs=2\")); std::fs::remove_dir_all(root).expect(\"cleanup\"); }"
    rust_global "} // coverage_union_tests"
