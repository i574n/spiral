inl rust_global (x : string) : () = real typecase `(!!!!LitToTypeLit(x)) with ~x => $"RustGlobal(@x)" : ()

inl emit_runtime () : () =
    rust_global "use eoie_rust_std_fs::atomic_write as binary_install_atomic_write;\nuse eoie_rust_std_fs::{portable_mode, portable_set_mode, portable_mode_matches};\nuse std::path::PathBuf;\n#[derive(Clone)] struct BinaryInstallOriginal{bytes:Vec<u8>,mode:u32}\n\nfn binary_install_arg<'a>(a:&'a[String],i:usize,n:&str)->Result<&'a str,String>{a.get(i).map(String::as_str).ok_or_else(||format!(\"missing argument: {n}\"))}\nfn binary_install_safe_text(v:&str)->bool{!v.is_empty()&&v.bytes().all(|b|b.is_ascii_alphanumeric()||matches!(b,b'.'|b'_'|b'-'|b'/'))}\nfn binary_install_rooted(root:&Path,value:&str)->Result<PathBuf,String>{if!binary_install_safe_text(value){return Err(format!(\"unsafe relative path: {value}\"))}let relative=Path::new(value);if relative.is_absolute()||relative.components().any(|c|!matches!(c,std::path::Component::Normal(_))){return Err(format!(\"unsafe relative path: {value}\"))}Ok(root.join(relative))}\nfn binary_install_hash_text(v:&str)->bool{v.len()==64&&v.bytes().all(|b|b.is_ascii_hexdigit())}\n\nfn binary_install_existing(path:&Path,expected:&str)->Result<Option<BinaryInstallOriginal>,String>{if expected==\"missing\"{if path.exists(){return Err(format!(\"stale path expected missing: {}\",path.display()))}\nif eoie_handoff_binary_install_freshness_binding(0,0)!=1{return Err(\"typed missing witness rejected\".to_owned())}return Ok(None)}\nif!binary_install_hash_text(expected){return Err(\"expected fingerprint must be lowercase or uppercase SHA-256\".to_owned())}let metadata=fs::symlink_metadata(path).map_err(|e|format!(\"stale metadata {}: {e}\",path.display()))?;if!metadata.is_file()||metadata.file_type().is_symlink(){return Err(format!(\"regular non-symlink file required: {}\",path.display()))}let observed=eoie_proxy_search::inspection_file_sha256(path)?;if observed!=expected{return Err(format!(\"stale fingerprint expected={expected} observed={observed}\"))}\nif eoie_handoff_binary_install_freshness_binding(1,1)!=1{return Err(\"typed present witness rejected\".to_owned())}Ok(Some(BinaryInstallOriginal{bytes:fs::read(path).map_err(|e|format!(\"read {}: {e}\",path.display()))?,mode:portable_mode(&metadata.permissions())&0o777}))}\nfn binary_install_restore(path:&Path,original:Option<&BinaryInstallOriginal>)->Result<(),String>{match original{Some(value)=>{binary_install_atomic_write(path,&value.bytes)?;portable_set_mode(path,value.mode).map_err(|e|format!(\"restore mode {}: {e}\",path.display()))},None=>match fs::remove_file(path){Ok(())=>Ok(()),Err(e)if e.kind()==std::io::ErrorKind::NotFound=>Ok(()),Err(e)=>Err(format!(\"remove {}: {e}\",path.display()))}}}\n\nfn binary_install_mode(raw:&str)->Result<u32,String>{let text=raw.strip_prefix(\"0o\").unwrap_or(raw);if text.len()!=3||!text.bytes().all(|b|matches!(b,b'0'..=b'7')){return Err(\"mode must be three octal digits\".to_owned())}let mode=u32::from_str_radix(text,8).map_err(|_|\"invalid octal mode\".to_owned())?;let valid=i32::from(mode<=0o777);let executable=i32::from(mode&0o111!=0);if eoie_handoff_binary_install_permission_binding(valid,executable)!=1{return Err(\"binary mode must include an executable bit\".to_owned())}Ok(mode)}\nfn binary_install_receipt(source:&str,source_tag:&str,hash:&str,destination:&str,destination_tag:&str,mode:u32)->String{format!(\"union binary_install_source = BinaryInstallSource : string * string * string\\nunion binary_install_target = BinaryInstallTarget : string * string * string * i32\\nunion binary_install_provenance = BinaryInstallProvenance : binary_install_source * binary_install_target\\ninl current_binary_install_provenance () : binary_install_provenance =\\n    BinaryInstallProvenance (BinaryInstallSource (\\\"{source}\\\", \\\"{source_tag}\\\", \\\"{hash}\\\"), BinaryInstallTarget (\\\"{destination}\\\", \\\"{destination_tag}\\\", \\\"{hash}\\\", {mode}i32))\\ninl main () : i32 = 0i32\\n\")}\n\nfn binary_install_injected(phase:&str)->Result<(),String>{if env::var(\"EOIE_BINARY_INSTALL_FAIL_AFTER\").ok().as_deref()==Some(phase){Err(format!(\"injected binary install failure after {phase}\"))}else{Ok(())}}\n\npub fn binary_install_run(args:&[String])->Result<(),String>{if args.len()!=10{return Err(\"binary-install expects preview|apply root source-relative destination-relative provenance-relative expected-source-sha256 expected-destination|missing expected-provenance|missing mode-octal\".to_owned())}let action=binary_install_arg(args,1,\"preview|apply\")?;let action_code=match action{\"preview\"=>0,\"apply\"=>1,_=>return Err(\"binary-install mode must be preview or apply\".to_owned())};let root=Path::new(binary_install_arg(args,2,\"root\")?);if!root.is_dir(){return Err(format!(\"invalid root: {}\",root.display()))}let source_relative=binary_install_arg(args,3,\"source-relative\")?;let destination_relative=binary_install_arg(args,4,\"destination-relative\")?;let provenance_relative=binary_install_arg(args,5,\"provenance-relative\")?;let source=binary_install_rooted(root,source_relative)?;let destination=binary_install_rooted(root,destination_relative)?;let provenance=binary_install_rooted(root,provenance_relative)?;let distinct=source!=destination&&source!=provenance&&destination!=provenance;if eoie_handoff_binary_install_shape_binding(1,i32::from(distinct))!=1{return Err(\"typed install path shape rejected\".to_owned())}let expected_source=binary_install_arg(args,6,\"expected-source-sha256\")?;if!binary_install_hash_text(expected_source){return Err(\"source fingerprint must be SHA-256\".to_owned())}let source_meta=fs::symlink_metadata(&source).map_err(|e|format!(\"source metadata {}: {e}\",source.display()))?;let regular=source_meta.is_file()&&!source_meta.file_type().is_symlink();let source_bytes=fs::read(&source).map_err(|e|format!(\"read source {}: {e}\",source.display()))?;let source_hash=eoie_proxy_search::inspection_sha256(source_bytes.clone());let source_state=i32::from(regular)+2*i32::from(!source_bytes.is_empty());if eoie_handoff_binary_install_source_binding(i32::from(source_hash==expected_source),source_state)!=1{return Err(format!(\"source rejected expected={expected_source} observed={source_hash}\"))}let current_exe=env::current_exe().ok().and_then(|path|fs::canonicalize(path).ok());let same_as_current=current_exe.as_ref().and_then(|current|fs::canonicalize(&destination).ok().map(|observed|observed==*current)).unwrap_or(false);if eoie_handoff_binary_install_running_destination_binding(i32::from(same_as_current),1)!=1{return Err(format!(\"running executable destination rejected: {}\",destination.display()))}let destination_original=binary_install_existing(&destination,binary_install_arg(args,7,\"expected-destination|missing\")?)?;let provenance_original=binary_install_existing(&provenance,binary_install_arg(args,8,\"expected-provenance|missing\")?)?;let mode=binary_install_mode(binary_install_arg(args,9,\"mode-octal\")?)?;let source_tag=eoie_proxy_search::mnemonic_path_tag(source_relative)?;let destination_tag=eoie_proxy_search::mnemonic_path_tag(destination_relative)?;let receipt=binary_install_receipt(source_relative,&source_tag,&source_hash,destination_relative,&destination_tag,mode);let receipt_hash=eoie_proxy_search::inspection_sha256(receipt.as_bytes().to_vec());if action_code==0{if eoie_handoff_binary_install_mode_binding(0,0)!=1{return Err(\"typed preview rejected\".to_owned())}println!(\"eoie proxy binary-install preview ok source={} destination={} source_tag={} destination_tag={} sha256={} mode={:03o} provenance_sha256={} mutation=false\",source.display(),destination.display(),source_tag,destination_tag,source_hash,mode,receipt_hash);return Ok(())}\nif eoie_handoff_binary_install_mode_binding(1,7)!=1{return Err(\"typed apply rejected\".to_owned())}let parent=destination.parent().ok_or_else(||\"destination parent missing\".to_owned())?;fs::create_dir_all(parent).map_err(|e|format!(\"mkdir {}: {e}\",parent.display()))?;if let Some(parent)=provenance.parent(){fs::create_dir_all(parent).map_err(|e|format!(\"mkdir {}: {e}\",parent.display()))?}let stage=parent.join(format!(\".eoie-binary-stage-{}\",std::process::id()));let _=fs::remove_file(&stage);binary_install_atomic_write(&stage,&source_bytes)?;portable_set_mode(&stage,mode).map_err(|e|format!(\"stage mode: {e}\"))?;let stage_hash=eoie_proxy_search::inspection_file_sha256(&stage)?;let stage_mode=portable_mode(&fs::metadata(&stage).map_err(|e|format!(\"stage metadata: {e}\"))?.permissions())&0o777;if stage_hash!=source_hash||!portable_mode_matches(stage_mode,mode){let _=fs::remove_file(&stage);return Err(\"staged binary verification failed\".to_owned())}binary_install_injected(\"stage\").inspect_err(|_|{let _=fs::remove_file(&stage);})?;fs::rename(&stage,&destination).map_err(|e|format!(\"promote {}: {e}\",destination.display()))?;if let Err(error)=binary_install_injected(\"promote\"){let _=binary_install_restore(&destination,destination_original.as_ref());return Err(error)}\nif let Err(error)=binary_install_atomic_write(&provenance,receipt.as_bytes()){let _=binary_install_restore(&destination,destination_original.as_ref());return Err(error)}let verification=binary_install_injected(\"provenance\").and_then(|_|fs::read(&provenance).map_err(|e|format!(\"readback provenance {}: {e}\",provenance.display()))).and_then(|observed|if observed==receipt.as_bytes(){Ok(())}else{Err(\"binary provenance runtime readback mismatch\".to_owned())});if let Err(error)=verification{let _=binary_install_restore(&destination,destination_original.as_ref());let _=binary_install_restore(&provenance,provenance_original.as_ref());return Err(format!(\"binary install rolled back: {error}\"))}let installed_hash=eoie_proxy_search::inspection_file_sha256(&destination)?;let installed_mode=portable_mode(&fs::metadata(&destination).map_err(|e|format!(\"destination metadata: {e}\"))?.permissions())&0o777;let provenance_hash=eoie_proxy_search::inspection_file_sha256(&provenance)?;let evidence=i32::from(portable_mode_matches(installed_mode,mode))+2*i32::from(provenance_hash==receipt_hash)+4;if eoie_handoff_binary_install_commit_binding(i32::from(installed_hash==source_hash),evidence)!=1{let _=binary_install_restore(&destination,destination_original.as_ref());let _=binary_install_restore(&provenance,provenance_original.as_ref());return Err(\"typed install commit rejected and rolled back\".to_owned())}println!(\"eoie proxy binary-install apply ok source={} destination={} source_tag={} destination_tag={} sha256={} mode={:03o} provenance={} provenance_sha256={} mutation=true\",source.display(),destination.display(),source_tag,destination_tag,source_hash,mode,provenance.display(),provenance_hash);Ok(())}\n"
