inl rust_global (x : string) : () = !!!!Global(x)

inl emit_runtime () : () =
    rust_global "fn release_closeout_gate(name:&str)->Option<(i32,&'static str)>{match name{\"state\"=>Some((1,\"CloseoutState\")),\"workspace\"=>Some((2,\"CloseoutWorkspace\")),\"contracts\"=>Some((4,\"CloseoutContracts\")),\"bundle\"=>Some((8,\"CloseoutBundle\")),\"cold\"=>Some((16,\"CloseoutColdReplay\")),\"migration\"=>Some((32,\"CloseoutMigration\")),_=>None}}\nfn release_closeout_observed_migration(root:&Path)->Result<i32,String>{semantic_evidence_domain::observed_migration_from_state(root)}\n"
    rust_global "fn release_closeout_body(migration:i32,gates:&[(String,String,String,String)],registry_hash:&str)->String{let mut body=String::from(\"union release_closeout_gate_evidence =\\n    | CloseoutState : string * string\\n    | CloseoutWorkspace : string * string\\n    | CloseoutContracts : string * string\\n    | CloseoutBundle : string * string\\n    | CloseoutColdReplay : string * string\\n    | CloseoutMigration : string * string\\n\\n\");body.push_str(&format!(\"inl expected_migration () : u32 = {migration}u32\\n\"));for(name,constructor,path,hash)in gates{body.push_str(&format!(\"inl {name}_gate () : release_closeout_gate_evidence = {constructor} (\\\"{path}\\\", \\\"{hash}\\\")\\n\"));}body.push_str(&format!(\"inl closeout_registry_schema () : u32 = 2u32\\ninl registry_v2_status () : string = \\\"semantic-dereferenced\\\"\\ninl registry_sha256 () : string = \\\"{registry_hash}\\\"\\ninl closeout_sealed () : bool = true\\ninl main () : i32 = 0i32\\n\"));body}\nfn release_closeout_fault()->bool{env::var(\"EOIE_RELEASE_CLOSEOUT_FAULT\").ok().as_deref()==Some(\"after-write\")}\n"
    rust_global "pub fn release_closeout_run(args:&[String])->Result<(),String>{if args.len()!=12{return Err(\"release-closeout expects preview|apply root receipt-relative expected-migration expected-receipt|missing and six name|relative|sha256 gates\".to_owned())}let action=binary_install_arg(args,1,\"preview|apply\")?;let mode=match action{\"preview\"=>0,\"apply\"=>1,_=>return Err(\"release-closeout mode must be preview or apply\".to_owned())};let root=Path::new(binary_install_arg(args,2,\"root\")?);if!root.is_dir(){return Err(format!(\"invalid root: {}\",root.display()))}let receipt=binary_install_rooted(root,binary_install_arg(args,3,\"receipt-relative\")?)?;if receipt.extension().and_then(|v|v.to_str())!=Some(\"spi\"){return Err(\"closeout receipt must end in .spi\".to_owned())}let expected=binary_install_arg(args,4,\"expected-migration\")?.parse::<i32>().map_err(|_|\"expected-migration must be an integer\".to_owned())?;let observed=release_closeout_observed_migration(root)?;if eoie_handoff_release_closeout_migration_binding(expected,observed)!=1{return Err(format!(\"migration mismatch expected={expected} observed={observed}\"))}let original=binary_install_existing(&receipt,binary_install_arg(args,5,\"expected-receipt|missing\")?)?;let evidence_path=root.join(\"state/evidence.spi\");let evidence_original=fs::read(&evidence_path).map_err(|e|format!(\"read {}: {e}\",evidence_path.display()))?;let census_path=root.join(\"state/authority_census.spi\");let census_original=fs::read(&census_path).map_err(|e|format!(\"read {}: {e}\",census_path.display()))?;let cold_proof_path=root.join(\"state/cold_proof.spi\");let cold_proof_original=fs::read(&cold_proof_path).map_err(|e|format!(\"read {}: {e}\",cold_proof_path.display()))?;let mut mask=0i32;let mut names=BTreeSet::new();let mut paths=BTreeSet::new();let mut gates=Vec::new();for raw in &args[6..]{let fields=raw.splitn(3,'|').collect::<Vec<_>>();if fields.len()!=3{return Err(format!(\"invalid gate spec: {raw}\"))}let name=fields[0];let relative=fields[1];let expected_hash=fields[2];let(bit,constructor)=release_closeout_gate(name).ok_or_else(||format!(\"unknown closeout gate: {name}\"))?;let unique=names.insert(name.to_owned())&&paths.insert(relative.to_owned());let path=binary_install_rooted(root,relative)?;let metadata=fs::symlink_metadata(&path).map_err(|e|format!(\"gate metadata {}: {e}\",path.display()))?;let regular=metadata.is_file()&&!metadata.file_type().is_symlink();if!binary_install_hash_text(expected_hash){return Err(format!(\"gate hash must be SHA-256: {name}\"))}let observed_hash=if regular{eoie_proxy_search::inspection_file_sha256(&path)?}else{String::new()};let evidence_mask=i32::from(regular)+2*i32::from(observed_hash==expected_hash)+4*i32::from(unique);if eoie_handoff_release_closeout_evidence_binding(evidence_mask,7)!=1{return Err(format!(\"closeout gate rejected name={name} path={} expected={expected_hash} observed={observed_hash}\",path.display()))}mask|=bit;gates.push((name.to_owned(),constructor.to_owned(),relative.to_owned(),observed_hash));}gates.sort_by(|a,b|a.0.cmp(&b.0));if eoie_handoff_release_closeout_shape_binding(mask,gates.len() as i32)!=1{return Err(format!(\"closeout registry incomplete mask={mask} count={}\",gates.len()))}let canonical=gates.iter().map(|(n,_,p,h)|format!(\"{n}|{p}|{h}\\n\")).collect::<String>();let registry_hash=eoie_proxy_search::inspection_sha256(canonical.into_bytes());let body=release_closeout_body(observed,&gates,&registry_hash);let receipt_hash=eoie_proxy_search::inspection_sha256(body.as_bytes().to_vec());if mode==0{if eoie_handoff_release_closeout_mode_binding(0,0)!=1{return Err(\"typed closeout preview rejected\".to_owned())}println!(\"eoie proxy release-closeout preview ok migration={observed} gates=6 registry_sha256={registry_hash} receipt_sha256={receipt_hash} mutation=false\");return Ok(())}\nif eoie_handoff_release_closeout_mode_binding(1,3)!=1{return Err(\"typed closeout apply rejected\".to_owned())}\nif let Some(parent)=receipt.parent(){fs::create_dir_all(parent).map_err(|e|format!(\"create {}: {e}\",parent.display()))?}binary_install_atomic_write(&receipt,body.as_bytes())?;let verification=if release_closeout_fault(){Err(\"injected release closeout fault after-write\".to_owned())}else{fs::read(&receipt).map_err(|e|format!(\"readback closeout {}: {e}\",receipt.display())).and_then(|observed|if observed==body.as_bytes(){Ok(())}else{Err(\"release closeout runtime readback mismatch\".to_owned())})};if let Err(error)=verification{let _=binary_install_restore(&receipt,original.as_ref());return Err(format!(\"release closeout rolled back: {error}\"))}let installed=fs::read(&receipt).map_err(|e|format!(\"read {}: {e}\",receipt.display()))?;let registry_ok=i32::from(installed.windows(registry_hash.len()).any(|window|window==registry_hash.as_bytes()));let commit_mask=i32::from(installed==body.as_bytes())+2+4*registry_ok;if eoie_handoff_release_closeout_commit_binding(commit_mask,7)!=1{let _=binary_install_restore(&receipt,original.as_ref());return Err(\"typed release closeout completion rejected rollback=restored\".to_owned())}let proof_refresh=eoie_source_topology::refresh_authority_census(root).and_then(|_|cold_proof_domain::refresh_cold_proof_census_gate(root));if let Err(error)=proof_refresh{let _=binary_install_restore(&receipt,original.as_ref());let _=binary_install_atomic_write(&census_path,&census_original);let _=binary_install_atomic_write(&cold_proof_path,&cold_proof_original);let _=binary_install_atomic_write(&evidence_path,&evidence_original);return Err(format!(\"release closeout proof refresh failed rollback=restored: {error}\"))}let refreshed_cold_hash=match eoie_proxy_search::inspection_file_sha256(&cold_proof_path){Ok(hash)=>hash,Err(error)=>{let _=binary_install_restore(&receipt,original.as_ref());let _=binary_install_atomic_write(&census_path,&census_original);let _=binary_install_atomic_write(&cold_proof_path,&cold_proof_original);let _=binary_install_atomic_write(&evidence_path,&evidence_original);return Err(format!(\"release closeout attested cold-proof hash failed rollback=restored: {error}\"))}};let mut attested_gates=gates.clone();for gate in &mut attested_gates{if gate.0==\"contracts\"{gate.3=refreshed_cold_hash.clone();}}let attested_canonical=attested_gates.iter().map(|(n,_,p,h)|format!(\"{n}|{p}|{h}\\n\")).collect::<String>();let attested_registry_hash=eoie_proxy_search::inspection_sha256(attested_canonical.into_bytes());let attested_body=release_closeout_body(observed,&attested_gates,&attested_registry_hash);if let Err(error)=binary_install_atomic_write(&receipt,attested_body.as_bytes()){let _=binary_install_restore(&receipt,original.as_ref());let _=binary_install_atomic_write(&census_path,&census_original);let _=binary_install_atomic_write(&cold_proof_path,&cold_proof_original);let _=binary_install_atomic_write(&evidence_path,&evidence_original);return Err(format!(\"release closeout attested reseal failed rollback=restored: {error}\"))}let installed=match fs::read(&receipt){Ok(value)=>value,Err(error)=>{let _=binary_install_restore(&receipt,original.as_ref());let _=binary_install_atomic_write(&census_path,&census_original);let _=binary_install_atomic_write(&cold_proof_path,&cold_proof_original);let _=binary_install_atomic_write(&evidence_path,&evidence_original);return Err(format!(\"release closeout attested readback failed rollback=restored: {error}\"))}};let installed_hash=eoie_proxy_search::inspection_sha256(installed.clone());let registry_ok=i32::from(installed.windows(attested_registry_hash.len()).any(|window|window==attested_registry_hash.as_bytes()));let commit_mask=i32::from(installed==attested_body.as_bytes())+2+4*registry_ok;if eoie_handoff_release_closeout_commit_binding(commit_mask,7)!=1{let _=binary_install_restore(&receipt,original.as_ref());let _=binary_install_atomic_write(&census_path,&census_original);let _=binary_install_atomic_write(&cold_proof_path,&cold_proof_original);let _=binary_install_atomic_write(&evidence_path,&evidence_original);return Err(\"typed attested release closeout completion rejected rollback=restored\".to_owned())}let refresh_mask=match evidence_currentness_domain::refresh_release_closeout_evidence(root,&installed_hash,installed.len() as u64){Ok(mask)=>mask,Err(error)=>{let _=binary_install_restore(&receipt,original.as_ref());let _=binary_install_atomic_write(&census_path,&census_original);let _=binary_install_atomic_write(&cold_proof_path,&cold_proof_original);let _=binary_install_atomic_write(&evidence_path,&evidence_original);return Err(format!(\"release closeout evidence refresh failed rollback=restored: {error}\"))}};if eoie_handoff_release_closeout_refresh_binding(refresh_mask,127)!=1{let _=binary_install_restore(&receipt,original.as_ref());let _=binary_install_atomic_write(&census_path,&census_original);let _=binary_install_atomic_write(&cold_proof_path,&cold_proof_original);let _=binary_install_atomic_write(&evidence_path,&evidence_original);return Err(format!(\"typed release closeout evidence refresh rejected mask={refresh_mask} rollback=restored\"))}println!(\"eoie proxy release-closeout apply ok receipt={} migration={observed} gates=6 registry_sha256={attested_registry_hash} receipt_sha256={installed_hash} evidence_refresh=true mutation=true\",receipt.display());Ok(())}\n"
