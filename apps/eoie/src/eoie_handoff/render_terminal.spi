inl rust_global (x : string) : () = real typecase `(!!!!LitToTypeLit(x)) with ~x => $"RustGlobal(@x)" : ()

inl emit_runtime () : () =
    rust_global "use std::collections::BTreeSet;"
    rust_global "use std::env;"
    rust_global "use std::fs;"
    rust_global "use std::path::Path;"
    rust_global ""
    rust_global "#[must_use]"
    rust_global "pub fn handoff_render() -> i32 {"
    rust_global "    match handoff_impl() {"
    rust_global "        Ok(()) => 0,"
    rust_global "        Err(error) => { eprintln!(\"eoie error: {error}\"); 2 }"
    rust_global "    }"
    rust_global "}"
    rust_global ""
    rust_global "fn handoff_args() -> Vec<String> { env::args().skip(2).collect() }"
    rust_global ""
    rust_global "fn state_text(root: &Path, relative: &str) -> Result<Option<String>, String> {"
    rust_global "    let path = root.join(relative);"
    rust_global "    match fs::read_to_string(&path) {"
    rust_global "        Ok(source) => Ok(Some(source)),"
    rust_global "        Err(error) if error.kind() == std::io::ErrorKind::NotFound => Ok(None),"
    rust_global "        Err(error) => Err(format!(\"read {}: {error}\", path.display())),"
    rust_global "    }"
    rust_global "}"
    rust_global ""
    rust_global "fn required_projection(label: &str, value: std::rc::Rc<str>) -> Result<String, String> {"
    rust_global "    if value.is_empty() { Err(format!(\"{label} projection rejected typed state\")) } else { Ok(value.to_string()) }"
    rust_global "}"
    rust_global ""
    rust_global "fn live_state_lines(root: &Path) -> Result<Vec<String>, String> {"
    rust_global "    let Some(ratings) = state_text(root, \"state/ratings.spi\")? else { return Ok(Vec::new()); };"
    rust_global "    let Some(census) = state_text(root, \"state/authority_census.spi\")? else { return Ok(Vec::new()); };"
    rust_global "    let ratings_line = required_projection(\"ratings\", handoff_state_projection_domain::eoie_handoff_ratings_projection(&ratings))?;"
    rust_global "    let census_line = required_projection(\"authority census\", handoff_state_projection_domain::eoie_handoff_census_projection(&census))?;"
    rust_global "    let authority_mask = authority_state_domain::eoie_authority_declared_mask(0, 0);"
    rust_global "    let authority_code = authority_state_domain::eoie_authority_state(authority_mask, 0);"
    rust_global "    if authority_mask < 0 || authority_code < 0 { return Err(\"compiled authority projection rejected\".to_owned()); }"
    rust_global "    let authority = if authority_code == 1 { \"exclusive\" } else { \"blocked\" };"
    rust_global "    let mut lines = vec![ratings_line, format!(\"authority={authority} blocker_mask={authority_mask} {census_line}\")];"
    rust_global "    if let Some(toolchain) = state_text(root, \"state/toolchain_identity.spi\")? {"
    rust_global "        lines.push(required_projection(\"toolchain\", handoff_evidence_projection_domain::eoie_handoff_toolchain_projection(&toolchain))?);"
    rust_global "    }"
    rust_global "    if let Some(cold) = state_text(root, \"state/cold_proof.spi\")? {"
    rust_global "        lines.push(required_projection(\"cold proof\", handoff_evidence_projection_domain::eoie_handoff_cold_projection(&cold))?);"
    rust_global "    }"
    rust_global "    Ok(lines)"
    rust_global "}"
    rust_global ""
    rust_global "fn active_work_lines(root: &Path) -> Result<Vec<String>, String> {"
    rust_global "    let Some(agile) = state_text(root, \"state/agile.spi\")? else { return Ok(Vec::new()); };"
    rust_global "    let raw = required_projection(\"active work\", handoff_active_work_projection_domain::eoie_handoff_active_work_projection(&agile))?;"
    rust_global "    let payload = if raw == \"ok\" { \"\" } else { raw.strip_prefix(\"ok\\n\").ok_or_else(|| \"active work projection returned invalid envelope\".to_owned())? };"
    rust_global "    let mut items = payload.lines().filter(|line| !line.is_empty()).map(str::to_owned).collect::<Vec<_>>();"
    rust_global "    items.sort();"
    rust_global "    Ok(items)"
    rust_global "}"
    rust_global ""
    rust_global "fn handoff_impl_with_args(args: &[String]) -> Result<(), String> {"
    rust_global "    if args.len() != 2 || args.first().map(String::as_str) != Some(\"handoff\") {"
    rust_global "        return Err(\"agile handoff expects handoff <root>\".to_owned());"
    rust_global "    }"
    rust_global "    let root = Path::new(&args[1]);"
    rust_global "    let Some(handoff_state) = state_text(root, \"state/handoff.spi\")? else { return Err(\"state/handoff.spi is missing\".to_owned()); };"
    rust_global "    let sections = required_projection(\"handoff sections\", handoff_sections_projection_domain::eoie_handoff_sections_projection(&handoff_state))?;"
    rust_global "    let section_markdown = sections.strip_prefix(\"ok\").ok_or_else(|| \"handoff sections projection returned invalid envelope\".to_owned())?;"
    rust_global "    println!(\"# EOIE handoff\");"
    rust_global "    let live = live_state_lines(root)?;"
    rust_global "    if !live.is_empty() {"
    rust_global "        println!(\"\\n## Live state\");"
    rust_global "        for line in live { println!(\"\\n{line}\"); }"
    rust_global "    }"
    rust_global "    println!(\"{section_markdown}\");"
    rust_global "    let work = active_work_lines(root)?;"
    rust_global "    if !work.is_empty() {"
    rust_global "        println!(\"\\n## Active work\");"
    rust_global "        for item in work { println!(\"\\n- {item}\"); }"
    rust_global "    }"
    rust_global "    Ok(())"
    rust_global "}"
    rust_global ""
    rust_global ""
    rust_global "fn handoff_impl() -> Result<(), String> {\n    let args = handoff_args();\n    handoff_impl_with_args(&args)\n}\n\n#[must_use]\npub fn handoff_render_owned(root: &str) -> i32 {\n    let args = vec![\"handoff\".to_owned(), root.to_owned()];\n    match handoff_impl_with_args(&args) {\n        Ok(()) => 0,\n        Err(error) => { eprintln!(\"eoie error: {error}\"); 2 }\n    }\n}\n"
