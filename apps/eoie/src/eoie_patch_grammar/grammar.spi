open patch_domain.context

inl rust_global (x : string) : () = !!!!Global(x)

inl main () : i32 =
    rust_global "#![allow(dead_code)]"
    inl source = "inl p () = PatchExact (\"a.txt\", \"old\", \"new\")\n"
    match parse_patch source 11i32 (source_len source) with
    | ParsedPatch next_index => next_index
    | InvalidPatch => -1i32
