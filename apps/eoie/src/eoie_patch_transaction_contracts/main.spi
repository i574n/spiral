inl rust_global (x : string) : () = !!!!Global(x)

inl emit_tests () : () = rust_global "use eoie_patch_compat_driver::test_support::{apply, apply_fault, bounded_read, plan, gated, gated_with_corruption, promotion_receipt_roundtrip, rehearse, restoration_receipt_paths, staged_write_mismatch, temporary};\nuse std::fs;\n\nfn prepared(label: &str) -> std::path::PathBuf {\n    let root = temporary(label);\n    fs::create_dir_all(&root).expect(\"root\");\n    root\n}\n\nfn no_stage(root: &std::path::Path) {\n    for entry in fs::read_dir(root).expect(\"list root\") {\n        let name = entry.expect(\"entry\").file_name().to_string_lossy().into_owned();\n        assert!(!name.contains(\".eoie-patch-\"), \"residual stage: {name}\");\n    }\n}\n\n#[test]\nfn witness_divergence_is_rejected_before_mutation() {\n    let root = prepared(\"witness\");\n    fs::write(root.join(\"value.txt\"), \"old\").expect(\"value\");\n    let error = apply(&root, &plan(\"value.txt\", \"old\", \"new\"), 2).expect_err(\"mismatch\");\n    assert!(error.contains(\"witness mismatch\"));\n    assert_eq!(fs::read_to_string(root.join(\"value.txt\")).expect(\"read\"), \"old\");\n    fs::remove_dir_all(root).expect(\"cleanup\");\n}\n\n#[test]\nfn empty_from_is_rejected_without_change() {\n    let root = prepared(\"empty\");\n    fs::write(root.join(\"value.txt\"), \"old\").expect(\"value\");\n    let error = apply(&root, &plan(\"value.txt\", \"\", \"new\"), 1).expect_err(\"empty\");\n    assert!(error.contains(\"precondition failed\"));\n    assert_eq!(fs::read_to_string(root.join(\"value.txt\")).expect(\"read\"), \"old\");\n    fs::remove_dir_all(root).expect(\"cleanup\");\n}\n\n#[test]\nfn repeated_matches_are_rejected() {\n    let root = prepared(\"repeated\");\n    fs::write(root.join(\"value.txt\"), \"xxx\").expect(\"value\");\n    let error = apply(&root, &plan(\"value.txt\", \"x\", \"y\"), 1).expect_err(\"repeated\");\n    assert!(error.contains(\"3 matches\"));\n    assert_eq!(fs::read_to_string(root.join(\"value.txt\")).expect(\"read\"), \"xxx\");\n    fs::remove_dir_all(root).expect(\"cleanup\");\n}\n\n#[test]\nfn overlapping_matches_are_rejected() {\n    let root = prepared(\"overlap\");\n    fs::write(root.join(\"value.txt\"), \"aaa\").expect(\"value\");\n    let error = apply(&root, &plan(\"value.txt\", \"aa\", \"b\"), 1).expect_err(\"overlap\");\n    assert!(error.contains(\"2 matches\"));\n    assert_eq!(fs::read_to_string(root.join(\"value.txt\")).expect(\"read\"), \"aaa\");\n    fs::remove_dir_all(root).expect(\"cleanup\");\n}\n\n#[test]\nfn late_guard_failure_preserves_all_files() {\n    let root = prepared(\"late\");\n    fs::write(root.join(\"a.txt\"), \"one\").expect(\"a\");\n    fs::write(root.join(\"b.txt\"), \"xx\").expect(\"b\");\n    let source = format!(\"{}{}\", plan(\"a.txt\", \"one\", \"changed\"), plan(\"b.txt\", \"x\", \"y\"));\n    let error = apply(&root, &source, 2).expect_err(\"late\");\n    assert!(error.contains(\"2 matches\"));\n    assert_eq!(fs::read_to_string(root.join(\"a.txt\")).expect(\"a\"), \"one\");\n    assert_eq!(fs::read_to_string(root.join(\"b.txt\")).expect(\"b\"), \"xx\");\n    fs::remove_dir_all(root).expect(\"cleanup\");\n}\n\n#[test]\nfn parent_escape_is_rejected() {\n    let root = prepared(\"escape\");\n    let error = apply(&root, &plan(\"../escape.txt\", \"old\", \"new\"), 1).expect_err(\"escape\");\n    assert!(error.contains(\"unsafe relative path\"));\n    assert!(!root.parent().expect(\"parent\").join(\"escape.txt\").exists());\n    fs::remove_dir_all(root).expect(\"cleanup\");\n}\n\n#[test]\nfn bounded_original_read_rejects_oversized_content() {\n    let root = prepared(\"bounded\");\n    let path = root.join(\"value.txt\");\n    fs::write(&path, \"four\").expect(\"value\");\n    assert!(bounded_read(&path, 3).expect_err(\"oversized\").contains(\"typed capture limit\"));\n    assert_eq!(bounded_read(&path, 4).expect(\"read\"), \"four\");\n    fs::remove_dir_all(root).expect(\"cleanup\");\n}\n\n#[test]\nfn typed_temporary_write_receipt_blocks_mismatch_before_promotion() {\n    let root = prepared(\"staged\");\n    let error = staged_write_mismatch(&root).expect(\"scenario\");\n    assert!(error.contains(\"typed temporary write receipt mismatch\"));\n    assert_eq!(fs::read_to_string(root.join(\"value.txt\")).expect(\"read\"), \"old\");\n    fs::remove_dir_all(root).expect(\"cleanup\");\n}\n\n#[test]\nfn typed_promotion_receipt_binds_stage_slot_and_target() {\n    let root = prepared(\"promotion\");\n    promotion_receipt_roundtrip(&root).expect(\"scenario\");\n    assert_eq!(fs::read_to_string(root.join(\"target.txt\")).expect(\"target\"), \"new\");\n    assert_eq!(fs::read_to_string(root.join(\"other.txt\")).expect(\"other\"), \"other\");\n    fs::remove_dir_all(root).expect(\"cleanup\");\n}\n\n#[test]\nfn restoration_receipt_binds_selected_paths() {\n    let root = prepared(\"restoration\");\n    let target = root.join(\"value.txt\");\n    assert_eq!(restoration_receipt_paths(&root).expect(\"restore\"), vec![target.clone()]);\n    assert_eq!(fs::read_to_string(target).expect(\"read\"), \"old\");\n    fs::remove_dir_all(root).expect(\"cleanup\");\n}\n\n#[test]\nfn injected_between_promotions_reports_successful_rollback() {\n    let root = prepared(\"between\");\n    fs::write(root.join(\"a.txt\"), \"one\").expect(\"a\");\n    fs::write(root.join(\"b.txt\"), \"two\").expect(\"b\");\n    let source = format!(\"{}{}\", plan(\"a.txt\", \"one\", \"changed-a\"), plan(\"b.txt\", \"two\", \"changed-b\"));\n    let error = apply_fault(&root, &source, 2, 1).expect_err(\"fault\");\n    assert!(error.contains(\"rollback=restored\"));\n    assert!(error.contains(\"failed_paths=[]\"));\n    assert_eq!(fs::read_to_string(root.join(\"a.txt\")).expect(\"a\"), \"one\");\n    no_stage(&root);\n    fs::remove_dir_all(root).expect(\"cleanup\");\n}\n\n#[test]\nfn injected_restoration_failure_reports_unrestored_path() {\n    let root = prepared(\"rollback-failure\");\n    fs::write(root.join(\"a.txt\"), \"one\").expect(\"a\");\n    fs::write(root.join(\"b.txt\"), \"two\").expect(\"b\");\n    let source = format!(\"{}{}\", plan(\"a.txt\", \"one\", \"changed-a\"), plan(\"b.txt\", \"two\", \"changed-b\"));\n    let error = apply_fault(&root, &source, 2, 2).expect_err(\"fault\");\n    assert!(error.contains(\"rollback=failed\"));\n    assert!(error.contains(&root.join(\"a.txt\").display().to_string()));\n    assert!(root.join(\"a.txt\").is_dir());\n    no_stage(&root);\n    fs::remove_dir_all(root).expect(\"cleanup\");\n}\n\n#[test]\nfn mixed_restoration_receipt_continues_after_path_failure() {\n    let root = prepared(\"rollback-best-effort\");\n    let a = root.join(\"a.txt\");\n    let b = root.join(\"b.txt\");\n    fs::write(&a, \"one\").expect(\"a\");\n    fs::write(&b, \"two\").expect(\"b\");\n    let source = format!(\"{}{}\", plan(\"a.txt\", \"one\", \"changed-a\"), plan(\"b.txt\", \"two\", \"changed-b\"));\n    let error = gated_with_corruption(&root, &source, 2, \"b.txt\").expect_err(\"fault\");\n    assert!(error.contains(\"rollback=failed\"));\n    assert!(error.contains(&format!(\"restored_paths=[{}]\", a.display())));\n    assert!(error.contains(&format!(\"failed_paths=[{}]\", b.display())));\n    assert!(error.contains(&format!(\"{}=>\", b.display())));\n    assert_eq!(fs::read_to_string(&a).expect(\"a restored\"), \"one\");\n    assert!(b.is_dir());\n    no_stage(&root);\n    fs::remove_dir_all(root).expect(\"cleanup\");\n}\n\n#[test]\nfn successful_rehearsal_restores_every_file_and_leaves_no_stage() {\n    let root = prepared(\"rehearse\");\n    fs::write(root.join(\"a.txt\"), \"one\").expect(\"a\");\n    fs::write(root.join(\"b.txt\"), \"two\").expect(\"b\");\n    let source = format!(\"{}{}\", plan(\"a.txt\", \"one\", \"changed-a\"), plan(\"b.txt\", \"two\", \"changed-b\"));\n    rehearse(&root, &source, 2).expect(\"rehearse\");\n    assert_eq!(fs::read_to_string(root.join(\"a.txt\")).expect(\"a\"), \"one\");\n    assert_eq!(fs::read_to_string(root.join(\"b.txt\")).expect(\"b\"), \"two\");\n    no_stage(&root);\n    fs::remove_dir_all(root).expect(\"cleanup\");\n}\n"

inl main () : i32 =
    emit_tests ()
    rollback_differential.emit_tests ()
    0i32
