inl rust_global (x : string) : () = !!!!Global(x)

inl emit_tests () : () =
    rust_global "\nfn rollback_contract_fnv1a(bytes: &[u8]) -> u64 { bytes.iter().fold(0xcbf29ce484222325u64, |hash, byte| (hash ^ u64::from(*byte)).wrapping_mul(0x100000001b3)) }\n\n#[test]\nfn partial_rollback_matches_restored_oracle_and_receipt() {\n    let root = prepared(\"rollback-differential\");\n    let a = root.join(\"a.txt\");\n    let b = root.join(\"b.txt\");\n    let oracle = root.join(\"oracle-a.txt\");\n    fs::write(&a, \"one\").expect(\"a\");\n    fs::write(&b, \"two\").expect(\"b\");\n    fs::write(&oracle, \"one\").expect(\"oracle\");\n    let source = format!(\"{}{}\", plan(\"a.txt\", \"one\", \"changed-a\"), plan(\"b.txt\", \"two\", \"changed-b\"));\n    let error = gated_with_corruption(&root, &source, 2, \"b.txt\").expect_err(\"fault\");\n    assert!(error.contains(\"rollback=failed\"));\n    let oracle_bytes = fs::read(&oracle).expect(\"oracle bytes\");\n    let restored_bytes = fs::read(&a).expect(\"restored bytes\");\n    assert_eq!(restored_bytes, oracle_bytes);\n    assert!(b.is_dir());\n    let hash = rollback_contract_fnv1a(&oracle_bytes);\n    let receipt = format!(\"route=partial-rollback-byte-exact\\nfnv1a={hash:016x}\\nbytes={}\\nrestored=1\\nfailed=1\\n\", oracle_bytes.len());\n    fs::write(root.join(\"partial-rollback.receipt\"), &receipt).expect(\"receipt\");\n    assert!(receipt.contains(\"bytes=3\"));\n    no_stage(&root);\n    fs::remove_dir_all(root).expect(\"cleanup\");\n} // partial_rollback_matches_restored_oracle_and_receipt\n\n#[test]\nfn three_promotion_rollback_restores_two_and_records_one_failure() {\n    let root = prepared(\"rollback-three-promotions\");\n    let a = root.join(\"a.txt\"); let b = root.join(\"b.txt\"); let c = root.join(\"c.txt\");\n    let oracle_a = root.join(\"oracle-a.txt\"); let oracle_b = root.join(\"oracle-b.txt\");\n    fs::write(&a, \"one\").expect(\"a\"); fs::write(&b, \"two\").expect(\"b\"); fs::write(&c, \"three\").expect(\"c\");\n    fs::write(&oracle_a, \"one\").expect(\"oracle a\"); fs::write(&oracle_b, \"two\").expect(\"oracle b\");\n    let source = format!(\"{}{}{}\", plan(\"a.txt\", \"one\", \"changed-a\"), plan(\"b.txt\", \"two\", \"changed-b\"), plan(\"c.txt\", \"three\", \"changed-c\"));\n    let error = gated_with_corruption(&root, &source, 3, \"c.txt\").expect_err(\"fault\");\n    assert!(error.contains(\"rollback=failed\"));\n    let a_bytes = fs::read(&a).expect(\"a restored\"); let b_bytes = fs::read(&b).expect(\"b restored\");\n    assert_eq!(a_bytes, fs::read(&oracle_a).expect(\"oracle a bytes\")); assert_eq!(b_bytes, fs::read(&oracle_b).expect(\"oracle b bytes\")); assert!(c.is_dir());\n    let mut restored = a_bytes.clone(); restored.extend_from_slice(&b_bytes); let hash = rollback_contract_fnv1a(&restored);\n    let receipt = format!(\"route=three-promotion-partial-rollback-byte-exact\\nfnv1a={hash:016x}\\nbytes={}\\nrestored=2\\nfailed=1\\n\", restored.len());\n    fs::write(root.join(\"three-promotion-rollback.receipt\"), &receipt).expect(\"receipt\");\n    assert!(receipt.contains(\"restored=2\")); assert!(receipt.contains(\"failed=1\"));\n    no_stage(&root); fs::remove_dir_all(root).expect(\"cleanup\");\n} // three_promotion_rollback_restores_two_and_records_one_failure\n\n#[test]\nfn postgate_failure_after_all_promotions_restores_every_file() {\n    let root = prepared(\"postgate-after-promotions\");\n    let a = root.join(\"a.txt\"); let b = root.join(\"b.txt\");\n    fs::write(&a, \"one\").expect(\"a\"); fs::write(&b, \"two\").expect(\"b\");\n    let source = format!(\"{}{}\", plan(\"a.txt\", \"one\", \"changed-a\"), plan(\"b.txt\", \"two\", \"changed-b\"));\n    let error = gated(&root, &source, 2, false).expect_err(\"postgate fault\");\n    assert!(error.contains(\"patch executable postgate rejected\"));\n    assert!(error.contains(\"rollback=restored\"));\n    assert_eq!(fs::read_to_string(&a).expect(\"a restored\"), \"one\");\n    assert_eq!(fs::read_to_string(&b).expect(\"b restored\"), \"two\");\n    no_stage(&root); fs::remove_dir_all(root).expect(\"cleanup\");\n} // postgate_failure_after_all_promotions_restores_every_file\n\n#[test]\nfn executable_gate_success_commits_every_file() {\n    let root = prepared(\"executable-gate-success\");\n    let a = root.join(\"a.txt\"); let b = root.join(\"b.txt\");\n    fs::write(&a, \"one\").expect(\"a\"); fs::write(&b, \"two\").expect(\"b\");\n    let source = format!(\"{}{}\", plan(\"a.txt\", \"one\", \"changed-a\"), plan(\"b.txt\", \"two\", \"changed-b\"));\n    gated(&root, &source, 2, true).expect(\"gate pass\");\n    assert_eq!(fs::read_to_string(&a).expect(\"a committed\"), \"changed-a\");\n    assert_eq!(fs::read_to_string(&b).expect(\"b committed\"), \"changed-b\");\n    no_stage(&root); fs::remove_dir_all(root).expect(\"cleanup\");\n} // executable_gate_success_commits_every_file\n\n#[test]\nfn executable_gate_failure_restores_every_file() {\n    let root = prepared(\"executable-gate-failure\");\n    let a = root.join(\"a.txt\"); let b = root.join(\"b.txt\");\n    fs::write(&a, \"one\").expect(\"a\"); fs::write(&b, \"two\").expect(\"b\");\n    let source = format!(\"{}{}\", plan(\"a.txt\", \"one\", \"changed-a\"), plan(\"b.txt\", \"two\", \"changed-b\"));\n    let error = gated(&root, &source, 2, false).expect_err(\"gate reject\");\n    assert!(error.contains(\"patch executable postgate rejected\"));\n    assert!(error.contains(\"rollback=restored\"));\n    assert_eq!(fs::read_to_string(&a).expect(\"a restored\"), \"one\");\n    assert_eq!(fs::read_to_string(&b).expect(\"b restored\"), \"two\");\n    no_stage(&root); fs::remove_dir_all(root).expect(\"cleanup\");\n} // executable_gate_failure_restores_every_file"
