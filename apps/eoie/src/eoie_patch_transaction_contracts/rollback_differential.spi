inl rust_global (x : string) : () = real typecase `(!!!!LitToTypeLit(x)) with ~x => $"RustGlobal(@x)" : ()

inl emit_tests () : () =
    rust_global ""
    rust_global "fn rollback_contract_fnv1a(bytes: &[u8]) -> u64 { bytes.iter().fold(0xcbf29ce484222325u64, |hash, byte| (hash ^ u64::from(*byte)).wrapping_mul(0x100000001b3)) }"
    rust_global ""
    rust_global "#[test]"
    rust_global "fn partial_rollback_matches_restored_oracle_and_receipt() {"
    rust_global "    let root = prepared(\"rollback-differential\");"
    rust_global "    let a = root.join(\"a.txt\");"
    rust_global "    let b = root.join(\"b.txt\");"
    rust_global "    let oracle = root.join(\"oracle-a.txt\");"
    rust_global "    fs::write(&a, \"one\").expect(\"a\");"
    rust_global "    fs::write(&b, \"two\").expect(\"b\");"
    rust_global "    fs::write(&oracle, \"one\").expect(\"oracle\");"
    rust_global "    let source = format!(\"{}{}\", plan(\"a.txt\", \"one\", \"changed-a\"), plan(\"b.txt\", \"two\", \"changed-b\"));"
    rust_global "    let error = gated_with_corruption(&root, &source, 2, \"b.txt\").expect_err(\"fault\");"
    rust_global "    assert!(error.contains(\"rollback=failed\"));"
    rust_global "    let oracle_bytes = fs::read(&oracle).expect(\"oracle bytes\");"
    rust_global "    let restored_bytes = fs::read(&a).expect(\"restored bytes\");"
    rust_global "    assert_eq!(restored_bytes, oracle_bytes);"
    rust_global "    assert!(b.is_dir());"
    rust_global "    let hash = rollback_contract_fnv1a(&oracle_bytes);"
    rust_global "    let receipt = format!(\"route=partial-rollback-byte-exact\\nfnv1a={hash:016x}\\nbytes={}\\nrestored=1\\nfailed=1\\n\", oracle_bytes.len());"
    rust_global "    fs::write(root.join(\"partial-rollback.receipt\"), &receipt).expect(\"receipt\");"
    rust_global "    assert!(receipt.contains(\"bytes=3\"));"
    rust_global "    no_stage(&root);"
    rust_global "    fs::remove_dir_all(root).expect(\"cleanup\");"
    rust_global "} // partial_rollback_matches_restored_oracle_and_receipt"
    rust_global ""
    rust_global "#[test]"
    rust_global "fn three_promotion_rollback_restores_two_and_records_one_failure() {"
    rust_global "    let root = prepared(\"rollback-three-promotions\");"
    rust_global "    let a = root.join(\"a.txt\"); let b = root.join(\"b.txt\"); let c = root.join(\"c.txt\");"
    rust_global "    let oracle_a = root.join(\"oracle-a.txt\"); let oracle_b = root.join(\"oracle-b.txt\");"
    rust_global "    fs::write(&a, \"one\").expect(\"a\"); fs::write(&b, \"two\").expect(\"b\"); fs::write(&c, \"three\").expect(\"c\");"
    rust_global "    fs::write(&oracle_a, \"one\").expect(\"oracle a\"); fs::write(&oracle_b, \"two\").expect(\"oracle b\");"
    rust_global "    let source = format!(\"{}{}{}\", plan(\"a.txt\", \"one\", \"changed-a\"), plan(\"b.txt\", \"two\", \"changed-b\"), plan(\"c.txt\", \"three\", \"changed-c\"));"
    rust_global "    let error = gated_with_corruption(&root, &source, 3, \"c.txt\").expect_err(\"fault\");"
    rust_global "    assert!(error.contains(\"rollback=failed\"));"
    rust_global "    let a_bytes = fs::read(&a).expect(\"a restored\"); let b_bytes = fs::read(&b).expect(\"b restored\");"
    rust_global "    assert_eq!(a_bytes, fs::read(&oracle_a).expect(\"oracle a bytes\")); assert_eq!(b_bytes, fs::read(&oracle_b).expect(\"oracle b bytes\")); assert!(c.is_dir());"
    rust_global "    let mut restored = a_bytes.clone(); restored.extend_from_slice(&b_bytes); let hash = rollback_contract_fnv1a(&restored);"
    rust_global "    let receipt = format!(\"route=three-promotion-partial-rollback-byte-exact\\nfnv1a={hash:016x}\\nbytes={}\\nrestored=2\\nfailed=1\\n\", restored.len());"
    rust_global "    fs::write(root.join(\"three-promotion-rollback.receipt\"), &receipt).expect(\"receipt\");"
    rust_global "    assert!(receipt.contains(\"restored=2\")); assert!(receipt.contains(\"failed=1\"));"
    rust_global "    no_stage(&root); fs::remove_dir_all(root).expect(\"cleanup\");"
    rust_global "} // three_promotion_rollback_restores_two_and_records_one_failure"
    rust_global ""
    rust_global "#[test]"
    rust_global "fn postgate_failure_after_all_promotions_restores_every_file() {"
    rust_global "    let root = prepared(\"postgate-after-promotions\");"
    rust_global "    let a = root.join(\"a.txt\"); let b = root.join(\"b.txt\");"
    rust_global "    fs::write(&a, \"one\").expect(\"a\"); fs::write(&b, \"two\").expect(\"b\");"
    rust_global "    let source = format!(\"{}{}\", plan(\"a.txt\", \"one\", \"changed-a\"), plan(\"b.txt\", \"two\", \"changed-b\"));"
    rust_global "    let error = gated(&root, &source, 2, false).expect_err(\"postgate fault\");"
    rust_global "    assert!(error.contains(\"patch executable postgate rejected\"));"
    rust_global "    assert!(error.contains(\"rollback=restored\"));"
    rust_global "    assert_eq!(fs::read_to_string(&a).expect(\"a restored\"), \"one\");"
    rust_global "    assert_eq!(fs::read_to_string(&b).expect(\"b restored\"), \"two\");"
    rust_global "    no_stage(&root); fs::remove_dir_all(root).expect(\"cleanup\");"
    rust_global "} // postgate_failure_after_all_promotions_restores_every_file"
    rust_global ""
    rust_global "#[test]"
    rust_global "fn executable_gate_success_commits_every_file() {"
    rust_global "    let root = prepared(\"executable-gate-success\");"
    rust_global "    let a = root.join(\"a.txt\"); let b = root.join(\"b.txt\");"
    rust_global "    fs::write(&a, \"one\").expect(\"a\"); fs::write(&b, \"two\").expect(\"b\");"
    rust_global "    let source = format!(\"{}{}\", plan(\"a.txt\", \"one\", \"changed-a\"), plan(\"b.txt\", \"two\", \"changed-b\"));"
    rust_global "    gated(&root, &source, 2, true).expect(\"gate pass\");"
    rust_global "    assert_eq!(fs::read_to_string(&a).expect(\"a committed\"), \"changed-a\");"
    rust_global "    assert_eq!(fs::read_to_string(&b).expect(\"b committed\"), \"changed-b\");"
    rust_global "    no_stage(&root); fs::remove_dir_all(root).expect(\"cleanup\");"
    rust_global "} // executable_gate_success_commits_every_file"
    rust_global ""
    rust_global "#[test]"
    rust_global "fn executable_gate_failure_restores_every_file() {"
    rust_global "    let root = prepared(\"executable-gate-failure\");"
    rust_global "    let a = root.join(\"a.txt\"); let b = root.join(\"b.txt\");"
    rust_global "    fs::write(&a, \"one\").expect(\"a\"); fs::write(&b, \"two\").expect(\"b\");"
    rust_global "    let source = format!(\"{}{}\", plan(\"a.txt\", \"one\", \"changed-a\"), plan(\"b.txt\", \"two\", \"changed-b\"));"
    rust_global "    let error = gated(&root, &source, 2, false).expect_err(\"gate reject\");"
    rust_global "    assert!(error.contains(\"patch executable postgate rejected\"));"
    rust_global "    assert!(error.contains(\"rollback=restored\"));"
    rust_global "    assert_eq!(fs::read_to_string(&a).expect(\"a restored\"), \"one\");"
    rust_global "    assert_eq!(fs::read_to_string(&b).expect(\"b restored\"), \"two\");"
    rust_global "    no_stage(&root); fs::remove_dir_all(root).expect(\"cleanup\");"
    rust_global "} // executable_gate_failure_restores_every_file"
