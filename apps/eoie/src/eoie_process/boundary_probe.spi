inl (~!\) forall t u. ((args : t), (code : string)) : u =
    $'Fable.Core.RustInterop.emitRustExpr !args !code '

nominal boundary_start = ()
nominal boundary_zero_timeout = ()
nominal boundary_callback = ()
nominal boundary_reap = ()
nominal boundary_budget = ()
nominal boundary_session = ()
nominal boundary_done = ()

union process_boundary_probe from to =
    | ProveZeroTimeout :: process_boundary_probe boundary_start boundary_zero_timeout
    | ProveCallbackFailure :: process_boundary_probe boundary_zero_timeout boundary_callback
    | ProveTimeoutReap :: process_boundary_probe boundary_callback boundary_reap
    | ProveCompilerBudget :: process_boundary_probe boundary_reap boundary_budget
    | ProveSessionScope :: process_boundary_probe boundary_budget boundary_session
    | FinishBoundaryProbe :: process_boundary_probe boundary_session boundary_done

inl streaming_zero_timeout_rejected (~timeout_ms : u64) : i32 =
    !\(timeout_ms, $'"{ let mut command = std::process::Command::new(\"/bin/true\"); if run_bounded_streaming(&mut command, $0, None, |_, _| Ok(())).is_err() { 1i32 } else { 0i32 } }"')

inl streaming_callback_failure_propagated (~timeout_ms : u64) : i32 =
    !\(timeout_ms, $'"{ let mut command = std::process::Command::new(\"/bin/sh\"); command.args([\"-c\", \"printf chunk; sleep 1\"]); if run_bounded_streaming(&mut command, $0, None, |_, _| Err(\"callback rejected chunk\".to_owned())).is_err() { 1i32 } else { 0i32 } }"')

inl bounded_timeout_reaped (~timeout_ms : u64) : i32 =
    !\(timeout_ms, $'"{ let mut command = std::process::Command::new(\"/bin/sleep\"); command.arg(\"1\"); if run_bounded(&mut command, $0).is_err() { 1i32 } else { 0i32 } }"')

inl compiler_budget_outcome (~segmented_timeout_ms : u64) (~timeout_ms : u64) : i32 =
    !\((segmented_timeout_ms, timeout_ms), $'"{ match compile_spiral(\"/bin/true\", std::path::Path::new(\"input.spi\"), std::path::Path::new(\"output.rs\"), \"Rust\", $0, $1) { Err(_) => 1i32, Ok(status) if status.success() => 2i32, Ok(_) => 3i32 } }"')

inl session_scope_match (~scope : string) (~executable : string) (~mode : string) (~socket : string) : i32 =
    !\((scope, executable, mode, socket), $'"{ let executable = std::path::Path::new(&*$1); let field_count = 3i32; let server_flag = i32::from(&*$2 == \"--server\"); let runner_flag = i32::from(executable.file_name().and_then(|value| value.to_str()) == Some(\"SpiralHelloRunner\")); let scope_flag = i32::from(executable.starts_with(std::path::Path::new(&*$0))); let packed_flags = server_flag | (runner_flag << 1) | (scope_flag << 2); let _ = &$3; eoie_process_session_match_binding(field_count, packed_flags) }"')

let timeout_policy_export (positive_flag : i32) (reserved : i32) : i32 =
    process.process_timeout_valid_export positive_flag reserved

let compiler_budget_policy_export (segmented_positive : i32) (timeout_positive : i32) : i32 =
    process.process_compiler_budget_valid_export segmented_positive timeout_positive

let session_policy_export (field_count : i32) (packed_flags : i32) : i32 =
    process.process_session_match_export field_count packed_flags

inl main () : i32 =
    process.rust_global "use eoie_process::{compile_spiral, eoie_process_session_match_binding, run_bounded, run_bounded_streaming};"
    inl policy_zero = timeout_policy_export 0i32 0i32
    inl policy_positive = timeout_policy_export 1i32 0i32
    inl policy_budget_zero = compiler_budget_policy_export 0i32 1i32
    inl policy_budget_positive = compiler_budget_policy_export 1i32 1i32
    inl policy_session = session_policy_export 3i32 7i32
    if !!!!NEQ(policy_zero,0i32) then 10i32
    elif !!!!NEQ(policy_positive,1i32) then 11i32
    elif !!!!NEQ(policy_budget_zero,0i32) then 12i32
    elif !!!!NEQ(policy_budget_positive,1i32) then 13i32
    elif !!!!NEQ(policy_session,1i32) then 14i32
    else
        inl _ : process_boundary_probe boundary_start boundary_zero_timeout = ProveZeroTimeout
        inl zero_timeout = streaming_zero_timeout_rejected 0u64
        if !!!!NEQ(zero_timeout,1i32) then 21i32
        else
            inl _ : process_boundary_probe boundary_zero_timeout boundary_callback = ProveCallbackFailure
            inl callback = streaming_callback_failure_propagated 5000u64
            if !!!!NEQ(callback,1i32) then 22i32
            else
                inl _ : process_boundary_probe boundary_callback boundary_reap = ProveTimeoutReap
                inl reaped = bounded_timeout_reaped 10u64
                if !!!!NEQ(reaped,1i32) then 23i32
                else
                    inl _ : process_boundary_probe boundary_reap boundary_budget = ProveCompilerBudget
                    inl rejected_budget = compiler_budget_outcome 0u64 1u64
                    inl accepted_budget = compiler_budget_outcome 1u64 1u64
                    if !!!!NEQ(rejected_budget,1i32) then 24i32
                    elif !!!!NEQ(accepted_budget,2i32) then 25i32
                    else
                        inl _ : process_boundary_probe boundary_budget boundary_session = ProveSessionScope
                        inl matching_scope = session_scope_match "/opt/spiral" "/opt/spiral/compiler-session/lib/SpiralHelloRunner" "--server" "/tmp/lane.sock"
                        inl other_scope = session_scope_match "/other" "/opt/spiral/compiler-session/lib/SpiralHelloRunner" "--server" "/tmp/lane.sock"
                        if !!!!NEQ(matching_scope,1i32) then 26i32
                        elif !!!!NEQ(other_scope,0i32) then 27i32
                        else
                            inl _ : process_boundary_probe boundary_session boundary_done = FinishBoundaryProbe
                            0i32