inl rust_global (x : string) : () = !!!!Global(x)

nominal process_idle = ()
nominal process_running = ()
nominal process_done = ()

union process_status =
    | ProcessStatusPassed :: i32 -> process_status
    | ProcessStatusFailed :: i32 -> process_status
    | ProcessStatusTimedOut :: process_status

union process_termination =
    | ProcessExited :: i32 -> process_termination
    | ProcessSignaled :: i32 -> process_termination
    | ProcessDeadlineExceeded :: process_termination
    | ProcessTerminationUnknown :: process_termination

union process_duration =
    | ElapsedMilliseconds :: u64 -> process_duration

union process_stream =
    | ProcessStdout :: string -> process_stream
    | ProcessStderr :: string -> process_stream

union process_observation =
    | ProcessObservation :: process_status * process_termination * process_duration * process_stream * process_stream -> process_observation

union process_plan from to =
    | ProcessLaunch :: string * u64 -> process_plan process_idle process_running
    | ProcessObserve :: process_observation -> process_plan process_running process_done

inl smoke_plan () : process_plan process_idle process_running =
    ProcessLaunch ("process-observation-smoke", 1u64)

inl smoke_observation () : process_observation =
    ProcessObservation (
        ProcessStatusPassed 0i32,
        ProcessExited 0i32,
        ElapsedMilliseconds 1u64,
        ProcessStdout "",
        ProcessStderr ""
    )

inl emit_runtime () : () =
    rust_global "use eoie_process::ProcessTermination;\nuse std::io::Write as _;\n\n#[derive(Debug)]\npub struct ProcessObservation {\n    pub status: std::process::ExitStatus,\n    pub termination: ProcessTermination,\n    pub elapsed_ms: u64,\n    pub stdout: Vec<u8>,\n    pub stderr: Vec<u8>,\n}\n\npub fn run_bounded_observed(\n    command: &mut std::process::Command,\n    timeout_ms: u64,\n) -> Result<ProcessObservation, String> {\n    let started = std::time::Instant::now();\n    let capture = eoie_process::run_bounded_capture_with_input(command, timeout_ms, None)?;\n    let elapsed_ms = u64::try_from(started.elapsed().as_millis()).unwrap_or(u64::MAX);\n    Ok(ProcessObservation {\n        status: capture.status,\n        termination: capture.termination,\n        elapsed_ms,\n        stdout: capture.stdout,\n        stderr: capture.stderr,\n    })\n}\n\nfn replay_captured_output(observation: &ProcessObservation) -> Result<(), String> {\n    std::io::stdout()\n        .write_all(&observation.stdout)\n        .map_err(|error| format!(\"replay stdout: {error}\"))?;\n    std::io::stderr()\n        .write_all(&observation.stderr)\n        .map_err(|error| format!(\"replay stderr: {error}\"))?;\n    Ok(())\n}\n\nfn process_output_preview(bytes: &[u8]) -> String {\n    let preview = String::from_utf8_lossy(bytes)\n        .trim()\n        .chars()\n        .take(240)\n        .collect::<String>();\n    if preview.is_empty() { \"<empty>\".to_owned() } else { preview }\n}\n\npub fn run_bounded_checked(\n    command: &mut std::process::Command,\n    timeout_ms: u64,\n    label: &str,\n) -> Result<ProcessObservation, String> {\n    let started = std::time::Instant::now();\n    let observation = match run_bounded_observed(command, timeout_ms) {\n        Ok(observation) => observation,\n        Err(error) => {\n            let elapsed_ms = u64::try_from(started.elapsed().as_millis()).unwrap_or(u64::MAX);\n            emit_process_error_receipt(command, label, elapsed_ms, &error);\n            return Err(error);\n        }\n    };\n    emit_process_exit_receipt(command, label, &observation);\n    replay_captured_output(&observation)?;\n    if observation.termination == ProcessTermination::TimedOut {\n        return Err(format!(\"{label} timed out after {timeout_ms} ms; stderr={}\", process_output_preview(&observation.stderr)));\n    }\n    if !observation.status.success() {\n        return Err(format!(\"{label} failed: {} termination={:?} stderr={}\", observation.status, observation.termination, process_output_preview(&observation.stderr)));\n    }\n    println!(\n        \"eoie process plan={label} status=passed termination={:?} elapsed_ms={} stdout_bytes={} stderr_bytes={}\",\n        observation.termination,\n        observation.elapsed_ms,\n        observation.stdout.len(),\n        observation.stderr.len()\n    );\n    Ok(observation)\n}"

inl main () : i32 =
    emit_runtime ()
    streaming_observation.emit_runtime ()
    streaming_observation.emit_policy_exports ()
    stdout_observation.emit_runtime ()
    stdout_observation_tests.emit_runtime ()
    detached_observation.emit_runtime ()
    inl _ = smoke_plan ()
    inl _ = smoke_observation ()
    0i32
