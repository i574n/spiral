nominal stdout_process_idle = ()
nominal stdout_process_running = ()
nominal stdout_process_done = ()

union stdout_process_plan from to =
    | StdoutProcessLaunch :: string * u64 -> stdout_process_plan stdout_process_idle stdout_process_running
    | StdoutProcessConsume :: stdout_process_plan stdout_process_running stdout_process_done

inl smoke_stdout_plan () : stdout_process_plan stdout_process_idle stdout_process_running =
    StdoutProcessLaunch ("stdout-observation-smoke", 5000u64)

inl rust_global (x : string) : () = !!!!Global(x)

inl emit_runtime () : () =
    rust_global "#[derive(Debug)]\npub struct ProcessStdoutObservation {\n    pub status: std::process::ExitStatus,\n    pub termination: ProcessTermination,\n    pub elapsed_ms: u64,\n    pub stdout_bytes: u64,\n    pub stdout_digest: String,\n    pub timed_out: bool,\n    pub stderr: Vec<u8>,\n}\n\npub struct ProcessDigestReader<R> {\n    inner: R,\n    bytes: u64,\n    hash: u64,\n}\n\nimpl<R: std::io::Read> ProcessDigestReader<R> {\n    fn new(inner: R) -> Self { Self { inner, bytes: 0, hash: 0xcbf29ce484222325 } }\n    fn digest(&self) -> String { format!(\"fnv1a64:{:016x}\", self.hash) }\n}\n\nimpl<R: std::io::Read> std::io::Read for ProcessDigestReader<R> {\n    fn read(&mut self, buffer: &mut [u8]) -> std::io::Result<usize> {\n        let count = self.inner.read(buffer)?;\n        self.bytes = self.bytes.saturating_add(count as u64);\n        for byte in &buffer[..count] {\n            self.hash = (self.hash ^ u64::from(*byte)).wrapping_mul(0x100000001b3);\n        }\n        Ok(count)\n    }\n}\n\nfn process_stdout_termination(status: &std::process::ExitStatus, timed_out: bool) -> ProcessTermination {\n    if timed_out { return ProcessTermination::TimedOut; }\n    #[cfg(unix)] {\n        use std::os::unix::process::ExitStatusExt;\n        if let Some(signal) = status.signal() { return ProcessTermination::Signaled(signal); }\n    }\n    ProcessTermination::Exited(status.code().unwrap_or(-1))\n}\n\n#[cfg(unix)]\nunsafe extern \"C\" { fn kill(pid: i32, signal: i32) -> i32; }\n\n#[cfg(unix)]\nfn process_stdout_kill_tree(pid: u32) {\n    #[cfg(unix)] {\n        if let Ok(pid) = i32::try_from(pid) {\n            let _ = unsafe { kill(-pid, 9) };\n            let _ = unsafe { kill(pid, 9) };\n        }\n    }\n}\n\nfn process_stdout_stderr_reader(mut stderr: std::process::ChildStderr) -> std::thread::JoinHandle<Result<Vec<u8>, String>> {\n    std::thread::spawn(move || {\n        let mut captured = Vec::new();\n        let mut buffer = [0u8; 8192];\n        loop {\n            let count = std::io::Read::read(&mut stderr, &mut buffer).map_err(|error| format!(\"read process stderr: {error}\"))?;\n            if count == 0 { break; }\n            if captured.len() < 262144 {\n                let keep = (262144usize - captured.len()).min(count);\n                captured.extend_from_slice(&buffer[..keep]);\n            }\n        }\n        Ok(captured)\n    })\n}\n\nfn emit_process_stdout_exit_receipt(command: &std::process::Command, label: &str, observation: &ProcessStdoutObservation) {\n    let outcome = if observation.termination == ProcessTermination::TimedOut { 3 }\n        else { match observation.termination { ProcessTermination::Signaled(_) => 2, _ if observation.status.success() => 0, _ => 1 } };\n    let wrapper_status = eoie_process_receipt_policy_binding(outcome, 0);\n    let retryability = eoie_process_receipt_policy_binding(outcome, 1);\n    let child_exit = observation.status.code().map_or_else(|| \"none\".to_owned(), |code| code.to_string());\n    let signal = match observation.termination { ProcessTermination::Signaled(signal) => signal.to_string(), _ => \"none\".to_owned() };\n    let timeout = i32::from(observation.termination == ProcessTermination::TimedOut);\n    let (cwd, program, env_names) = process_receipt_command_fields(command);\n    println!(\"eoie process-exit receipt label={label} wrapper_status={} child_exit={} signal={} timeout={} stderr_digest={} retryability={} cwd={:?} program={:?} env_names={} elapsed_ms={} stdout_bytes={} stderr_bytes={} stdout_digest={} stdout_mode=consumed\", process_receipt_status_name(wrapper_status), child_exit, signal, timeout, process_receipt_digest(&observation.stderr), process_receipt_retry_name(retryability), cwd, program, env_names, observation.elapsed_ms, observation.stdout_bytes, observation.stderr.len(), observation.stdout_digest);\n}\n\npub fn run_bounded_stdout_receipted<T, F>(\n    command: &mut std::process::Command,\n    timeout_ms: u64,\n    label: &str,\n    consume: F,\n) -> Result<(T, ProcessStdoutObservation), String>\nwhere\n    F: FnOnce(&mut ProcessDigestReader<std::process::ChildStdout>) -> Result<T, String>,\n{\n    if timeout_ms == 0 { return Err(\"stdout consumer timeout must be positive\".to_owned()); }\n    #[cfg(unix)] {\n        use std::os::unix::process::CommandExt;\n        command.process_group(0);\n    }\n    command.stdin(std::process::Stdio::null()).stdout(std::process::Stdio::piped()).stderr(std::process::Stdio::piped());\n    let started = std::time::Instant::now();\n    #[cfg(windows)] let (mut child, windows_job) = eoie_process::WindowsJob::spawn(command)?;\n    #[cfg(windows)] let windows_job = std::sync::Arc::new(windows_job);\n    #[cfg(not(windows))] let mut child = match command.spawn() {\n        Ok(child) => child,\n        Err(error) => {\n            let text = format!(\"spawn process: {error}\");\n            emit_process_error_receipt(command, label, 0, &text);\n            return Err(text);\n        }\n    };\n    #[cfg(unix)] let pid = child.id();\n    let stdout = child.stdout.take().ok_or_else(|| \"process stdout was not piped\".to_owned())?;\n    let stderr = child.stderr.take().ok_or_else(|| \"process stderr was not piped\".to_owned())?;\n    let stderr_reader = process_stdout_stderr_reader(stderr);\n    let timed_out = std::sync::Arc::new(std::sync::atomic::AtomicBool::new(false));\n    let timed_out_watch = timed_out.clone();\n    let (done_tx, done_rx) = std::sync::mpsc::channel::<()>();\n    #[cfg(windows)] let watchdog_job = windows_job.clone();\n    let watchdog = std::thread::spawn(move || {\n        if done_rx.recv_timeout(std::time::Duration::from_millis(timeout_ms)).is_err() {\n            timed_out_watch.store(true, std::sync::atomic::Ordering::SeqCst);\n            #[cfg(unix)] process_stdout_kill_tree(pid);\n            #[cfg(windows)] watchdog_job.terminate();\n        }\n    });\n    let mut reader = ProcessDigestReader::new(stdout);\n    let consumed = consume(&mut reader);\n    let stdout_bytes = reader.bytes;\n    let stdout_digest = reader.digest();\n    drop(reader);\n    if consumed.is_err() {\n        #[cfg(unix)] process_stdout_kill_tree(pid);\n        #[cfg(windows)] windows_job.terminate();\n    }\n    let status = child.wait().map_err(|error| format!(\"wait process: {error}\"))?;\n    #[cfg(windows)] windows_job.terminate();\n    let _ = done_tx.send(());\n    let _ = watchdog.join();\n    let stderr = stderr_reader.join().map_err(|_| \"stderr reader panicked\".to_owned())??;\n    let elapsed_ms = u64::try_from(started.elapsed().as_millis()).unwrap_or(u64::MAX);\n    let observation = ProcessStdoutObservation {\n        termination: process_stdout_termination(&status, timed_out.load(std::sync::atomic::Ordering::SeqCst)),\n        status,\n        elapsed_ms,\n        stdout_bytes,\n        stdout_digest,\n        timed_out: timed_out.load(std::sync::atomic::Ordering::SeqCst),\n        stderr,\n    };\n    emit_process_stdout_exit_receipt(command, label, &observation);\n    match consumed { Ok(value) => Ok((value, observation)), Err(error) => Err(error) }\n}\n"

inl main () : i32 =
    inl _ = smoke_stdout_plan ()
    0i32