inl rust_global (x : string) : () = !!!!Global(x)

inl emit_runtime () : () =
    rust_global "#[cfg(test)]\nmod stdout_observation_tests {\n    use super::*;\n    use std::io::Read as _;\n\n    #[test]\n    fn receipted_stdout_consumer_preserves_payload_summary() {\n        let mut command = std::process::Command::new(\"sh\");\n        command.arg(\"-c\").arg(\"printf abc\");\n        let (text, observation) = run_bounded_stdout_receipted(&mut command, 5000, \"stdout-consumer-test\", |reader| {\n            let mut text = String::new();\n            reader.read_to_string(&mut text).map_err(|error| error.to_string())?;\n            Ok(text)\n        }).expect(\"stdout consumer\");\n        assert_eq!(text, \"abc\");\n        assert!(observation.status.success());\n        assert!(!observation.timed_out);\n        assert_eq!(observation.stdout_bytes, 3);\n        assert_eq!(observation.stdout_digest, \"fnv1a64:e71fa2190541574b\");\n    }\n\n    #[test]\n    fn receipted_stdout_consumer_times_out_producer() {\n        let mut command = std::process::Command::new(\"sh\");\n        command.arg(\"-c\").arg(\"sleep 1; printf late\");\n        let (_, observation) = run_bounded_stdout_receipted(&mut command, 30, \"stdout-timeout-test\", |reader| {\n            let mut bytes = Vec::new();\n            reader.read_to_end(&mut bytes).map_err(|error| error.to_string())?;\n            Ok(bytes)\n        }).expect(\"timeout observation\");\n        assert!(observation.timed_out);\n    }\n}\n"

inl main () : i32 = 0i32
