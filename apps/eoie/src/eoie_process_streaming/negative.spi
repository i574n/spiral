open streaming

union streaming_negative_fixture =
    | ZeroTimeoutFixture
    | SpawnRejectedFixture
    | CallbackRejectedFixture
    | ClosedInputFixture

inl rust_global (x : string) : () = real
    typecase `(!!!!LitToTypeLit(x)) with ~x =>
    $"RustGlobal(@x)" : ()

inl fixtures_are_closed () =
    match ZeroTimeoutFixture, SpawnRejectedFixture, CallbackRejectedFixture, ClosedInputFixture with
    | ZeroTimeoutFixture, SpawnRejectedFixture, CallbackRejectedFixture, ClosedInputFixture => true

inl zero_timeout_plan () = StreamingLaunch (ProcessNoInput, 0u64)

inl main () : i32 =
    rust_global "#![allow(clippy::needless_return)]"
    inl _ = zero_timeout_plan ()
    inl _ = fixtures_are_closed ()
    inl zero_limit = streaming_policy_export 2i32 0i32
    inl over_limit = streaming_policy_export 2i32 67108865i32
    inl non_unix = streaming_policy_export 0i32 0i32
    if !!!!EQ(zero_limit,-1i32) then
        if !!!!EQ(over_limit,-1i32) then
            if !!!!EQ(non_unix,0i32) then 0i32 else -1i32
        else -1i32
    else -1i32
