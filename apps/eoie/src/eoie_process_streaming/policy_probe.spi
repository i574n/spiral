open streaming

inl rust_global (x : string) : () = real
    typecase `(!!!!LitToTypeLit(x)) with ~x =>
    $"RustGlobal(@x)" : ()

inl main () : i32 =
    rust_global "#![allow(clippy::needless_return)]"
    inl _ = smoke_plan ()
    inl default_limit = streaming_policy_export 1i32 0i32
    inl ceiling_limit = streaming_policy_export 2i32 67108864i32
    inl tree_allowed = streaming_policy_export 0i32 1i32
    if !!!!EQ(default_limit,16777216i32) then
        if !!!!EQ(ceiling_limit,67108864i32) then
            if !!!!EQ(tree_allowed,1i32) then
                match ProcessStdoutStream, ProcessStderrStream with
                | ProcessStdoutStream, ProcessStderrStream => 0i32
            else -1i32
        else -1i32
    else -1i32
