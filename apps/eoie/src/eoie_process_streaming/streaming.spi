nominal streaming_idle = ()
nominal streaming_running = ()
nominal streaming_done = ()

union process_input =
    | ProcessNoInput
    | ProcessInputText :: string -> process_input

union process_stream_kind =
    | ProcessStdoutStream
    | ProcessStderrStream

union streaming_plan from to =
    | StreamingLaunch :: process_input * u64 -> streaming_plan streaming_idle streaming_running
    | StreamingObserve :: process_stream_kind -> streaming_plan streaming_running streaming_done

inl smoke_plan () : streaming_plan streaming_idle streaming_running =
    StreamingLaunch (ProcessInputText "streaming-smoke", 5000u64)

let streaming_policy_export (policy_code : i32) (value : i32) : i32 =
    if !!!!EQ(policy_code,0i32) then value
    elif !!!!EQ(policy_code,1i32) then 16777216i32
    elif !!!!EQ(policy_code,2i32) then
        if !!!!LT(value,1i32) then -1i32
        elif !!!!LT(67108864i32,value) then -1i32
        else value
    else -1i32

inl rust_global (x : string) : () = real
    typecase `(!!!!LitToTypeLit(x)) with ~x =>
    $"RustGlobal(@x)" : ()
inl rust_library () : () = $"RustLibrary()" : ()

inl emit_runtime () : () =
    rust_global "#[cfg(windows)] mod windows;\n#[cfg(windows)] pub use windows::WindowsJob;\n#[derive(Clone, Debug, Eq, PartialEq)]\npub enum ProcessTermination {\n    Exited(i32),\n    Signaled(i32),\n    TimedOut,\n    Unknown,\n}\n\n#[derive(Debug)]\npub struct ProcessCapture {\n    pub status: std::process::ExitStatus,\n    pub termination: ProcessTermination,\n    pub stdout: Vec<u8>,\n    pub stderr: Vec<u8>,\n}\n\nfn classify_process_termination(status: &std::process::ExitStatus) -> ProcessTermination {\n    if let Some(code) = status.code() { return ProcessTermination::Exited(code); }\n    #[cfg(unix)] { use std::os::unix::process::ExitStatusExt as _; if let Some(signal) = status.signal() { return ProcessTermination::Signaled(signal); } }\n    ProcessTermination::Unknown\n}\n\n#[derive(Clone, Copy, Debug, Eq, PartialEq)]\npub enum ProcessStreamKind {\n    Stdout,\n    Stderr,\n}\n\nfn process_output_max_bytes() -> Result<usize, String> {\n    let (policy_code, requested) = match std::env::var(\"EOIE_PROCESS_OUTPUT_MAX_BYTES\").ok().as_deref() { Some(text) => (2, text.parse::<i32>().map_err(|_| \"EOIE_PROCESS_OUTPUT_MAX_BYTES must be an integer\".to_owned())?), None => (1, 0) };\n    let resolved = eoie_process_streaming_policy_binding(policy_code, requested);\n    if resolved < 1 { return Err(format!(\"EOIE_PROCESS_OUTPUT_MAX_BYTES rejected by Spiral policy: {requested}\")); }\n    usize::try_from(resolved).map_err(|_| \"resolved process output limit does not fit usize\".to_owned())\n}\n\nfn spawn_process_chunk_reader<T>(\n    mut stream: T,\n    kind: ProcessStreamKind,\n    sender: std::sync::mpsc::Sender<(ProcessStreamKind, Vec<u8>)>,\n) -> std::thread::JoinHandle<Result<(), String>>\nwhere\n    T: std::io::Read + Send + 'static,\n{\n    std::thread::spawn(move || {\n        let mut buffer = [0u8; 8192];\n        loop {\n            let count = stream\n                .read(&mut buffer)\n                .map_err(|error| format!(\"read process stream: {error}\"))?;\n            if count == 0 {\n                break;\n            }\n            sender\n                .send((kind, buffer[..count].to_vec()))\n                .map_err(|_| \"process stream receiver was dropped\".to_owned())?;\n        }\n        Ok(())\n    })\n}\n\nfn spawn_process_input_writer(\n    mut stdin: std::process::ChildStdin,\n    bytes: Vec<u8>,\n) -> std::thread::JoinHandle<Result<(), String>> {\n    std::thread::spawn(move || {\n        match std::io::Write::write_all(&mut stdin, &bytes) {\n            Err(error) if error.kind() != std::io::ErrorKind::BrokenPipe => {\n                return Err(format!(\"write process stdin: {error}\"));\n            }\n            _ => {}\n        }\n        std::io::Write::flush(&mut stdin)\n            .or_else(|error| {\n                if error.kind() == std::io::ErrorKind::BrokenPipe {\n                    Ok(())\n                } else {\n                    Err(error)\n                }\n            })\n            .map_err(|error| format!(\"flush process stdin: {error}\"))\n    })\n}\n\nfn join_process_chunk_reader(reader: std::thread::JoinHandle<Result<(), String>>, stream: &str) -> Result<(), String> {\n    reader.join().map_err(|_| format!(\"{stream} chunk reader panicked\"))?\n}\n\nfn join_process_input_writer(writer: std::thread::JoinHandle<Result<(), String>>) -> Result<(), String> {\n    writer.join().map_err(|_| \"stdin writer panicked\".to_owned())?\n}\n\nfn append_process_chunk<F>(\n    kind: ProcessStreamKind,\n    bytes: Vec<u8>,\n    stdout: &mut Vec<u8>,\n    stderr: &mut Vec<u8>,\n    limit: usize,\n    on_chunk: &mut F,\n) -> Result<(), String>\nwhere\n    F: FnMut(ProcessStreamKind, &[u8]) -> Result<(), String>,\n{\n    let current = match kind {\n        ProcessStreamKind::Stdout => stdout.len(),\n        ProcessStreamKind::Stderr => stderr.len(),\n    };\n    let projected = current.checked_add(bytes.len()).ok_or_else(|| \"process output size overflow\".to_owned())?;\n    if projected > limit {\n        return Err(format!(\"process output limit exceeded stream={kind:?} projected={projected} limit={limit}\"));\n    }\n    on_chunk(kind, &bytes)?;\n    match kind {\n        ProcessStreamKind::Stdout => stdout.extend_from_slice(&bytes),\n        ProcessStreamKind::Stderr => stderr.extend_from_slice(&bytes),\n    }\n    Ok(())\n}\n\nfn drain_process_chunks<F>(\n    receiver: &std::sync::mpsc::Receiver<(ProcessStreamKind, Vec<u8>)>,\n    stdout: &mut Vec<u8>,\n    stderr: &mut Vec<u8>,\n    limit: usize,\n    on_chunk: &mut F,\n) -> Result<(), String>\nwhere\n    F: FnMut(ProcessStreamKind, &[u8]) -> Result<(), String>,\n{\n    while let Ok((kind, bytes)) = receiver.try_recv() {\n        append_process_chunk(kind, bytes, stdout, stderr, limit, on_chunk)?;\n    }\n    Ok(())\n}\n\n#[cfg(unix)]\nunsafe extern \"C\" {\n    fn kill(pid: i32, signal: i32) -> i32;\n}\n\n#[cfg(unix)]\nfn signal_process_tree(pid: i32, signal: i32) -> Result<(), String> {\n    let group = unsafe { kill(-pid, signal) }; let direct = unsafe { kill(pid, signal) };\n    if group != 0 && direct != 0 { let error = std::io::Error::last_os_error(); if error.raw_os_error() != Some(3) { return Err(format!(\"signal process tree {pid}: {error}\")); } }\n    Ok(())\n}\n\nfn terminate_bounded_process(child: &mut std::process::Child) -> Result<std::process::ExitStatus, String> {\n    #[cfg(unix)]\n    {\n        let pid = i32::try_from(child.id()).map_err(|_| \"process id does not fit i32\".to_owned())?;\n        signal_process_tree(pid, 9)?;\n    }\n    #[cfg(not(unix))]\n    {\n        child.kill().map_err(|error| format!(\"kill process: {error}\"))?;\n    }\n    child.wait().map_err(|error| format!(\"reap process: {error}\"))\n}\n\npub fn bounded_process_tree_capability() -> &'static str {\n    #[cfg(unix)] { return \"process-group-tree-signal\"; }\n    #[cfg(windows)] { return \"windows-job-object-tree\"; }\n    #[cfg(not(any(unix, windows)))] { \"direct-child-only\" }\n}\n\npub fn run_bounded_streaming<F>(\n    command: &mut std::process::Command,\n    timeout_ms: u64,\n    input: Option<&[u8]>,\n    mut on_chunk: F,\n) -> Result<ProcessCapture, String>\nwhere\n    F: FnMut(ProcessStreamKind, &[u8]) -> Result<(), String>,\n{\n    if eoie_process_streaming_policy_binding(0, i32::from(timeout_ms > 0)) != 1 {\n        return Err(\"timeout must be positive\".to_owned());\n    }\n    let unix_flag = {\n        #[cfg(any(unix, windows))] { 1i32 }\n        #[cfg(not(any(unix, windows)))] { 0i32 }\n    };\n    if eoie_process_streaming_policy_binding(0, unix_flag) != 1 {\n        return Err(format!(\"bounded process tree supervision unavailable: {}\", bounded_process_tree_capability()));\n    }\n    let output_limit = process_output_max_bytes()?;\n    #[cfg(unix)]\n    {\n        use std::os::unix::process::CommandExt;\n        command.process_group(0);\n    }\n    command\n        .stdout(std::process::Stdio::piped())\n        .stderr(std::process::Stdio::piped());\n    if input.is_some() {\n        command.stdin(std::process::Stdio::piped());\n    } else {\n        command.stdin(std::process::Stdio::null());\n    }\n    #[cfg(windows)] let (mut child, windows_job) = WindowsJob::spawn(command)?;\n    #[cfg(not(windows))] let mut child = command.spawn().map_err(|error| format!(\"spawn process: {error}\"))?;\n    let stdout = child\n        .stdout\n        .take()\n        .ok_or_else(|| \"process stdout was not piped\".to_owned())?;\n    let stderr = child\n        .stderr\n        .take()\n        .ok_or_else(|| \"process stderr was not piped\".to_owned())?;\n    let (sender, receiver) = std::sync::mpsc::channel();\n    let stdout_reader = spawn_process_chunk_reader(stdout, ProcessStreamKind::Stdout, sender.clone());\n    let stderr_reader = spawn_process_chunk_reader(stderr, ProcessStreamKind::Stderr, sender.clone());\n    drop(sender);\n    let stdin_writer = input\n        .map(|bytes| {\n            let stdin = child\n                .stdin\n                .take()\n                .ok_or_else(|| \"process stdin was not piped\".to_owned())?;\n            Ok::<_, String>(spawn_process_input_writer(stdin, bytes.to_vec()))\n        })\n        .transpose()?;\n    let deadline = std::time::Instant::now() + std::time::Duration::from_millis(timeout_ms);\n    let mut stdout_bytes = Vec::new();\n    let mut stderr_bytes = Vec::new();\n    let (status, timed_out) = loop {\n        if let Err(error) = drain_process_chunks(\n            &receiver,\n            &mut stdout_bytes,\n            &mut stderr_bytes,\n            output_limit,\n            &mut on_chunk,\n        ) {\n            #[cfg(windows)] windows_job.terminate();\n            let _ = terminate_bounded_process(&mut child);\n            return Err(error);\n        }\n        if let Some(status) = child\n            .try_wait()\n            .map_err(|error| format!(\"wait process: {error}\"))?\n        {\n            break (status, false);\n        }\n        if std::time::Instant::now() >= deadline {\n            #[cfg(windows)] windows_job.terminate();\n            let status = terminate_bounded_process(&mut child)?;\n            break (status, true);\n        }\n        match receiver.recv_timeout(std::time::Duration::from_millis(10)) {\n            Ok((kind, bytes)) => {\n                if let Err(error) = append_process_chunk(\n                    kind,\n                    bytes,\n                    &mut stdout_bytes,\n                    &mut stderr_bytes,\n                    output_limit,\n                    &mut on_chunk,\n                ) {\n                    #[cfg(windows)] windows_job.terminate();\n            let _ = terminate_bounded_process(&mut child);\n                    return Err(error);\n                }\n            }\n            Err(std::sync::mpsc::RecvTimeoutError::Timeout) => {}\n            Err(std::sync::mpsc::RecvTimeoutError::Disconnected) => {\n                std::thread::sleep(std::time::Duration::from_millis(1));\n            }\n        }\n    };\n    // Close descendant pipe handles even when the immediate child exited first.\n    #[cfg(windows)] windows_job.terminate();\n    if let Some(writer) = stdin_writer {\n        join_process_input_writer(writer)?;\n    }\n    join_process_chunk_reader(stdout_reader, \"stdout\")?;\n    join_process_chunk_reader(stderr_reader, \"stderr\")?;\n    drain_process_chunks(\n        &receiver,\n        &mut stdout_bytes,\n        &mut stderr_bytes,\n        output_limit,\n        &mut on_chunk,\n    )?;\n    let termination = if timed_out {\n        ProcessTermination::TimedOut\n    } else {\n        classify_process_termination(&status)\n    };\n    Ok(ProcessCapture {\n        status,\n        termination,\n        stdout: stdout_bytes,\n        stderr: stderr_bytes,\n    })\n}\n\npub fn run_bounded_capture_with_input(\n    command: &mut std::process::Command,\n    timeout_ms: u64,\n    input: Option<&[u8]>,\n) -> Result<ProcessCapture, String> {\n    run_bounded_streaming(command, timeout_ms, input, |_, _| Ok(()))\n}\n"

inl main () : i32 =
    emit_runtime ()
    inl _ = smoke_plan ()
    inl _ = streaming_policy_export 0i32 1i32
    inl _ = streaming_policy_export 1i32 0i32
    inl _ = streaming_policy_export 2i32 67108864i32
    inl _ = streaming_policy_export 0i32 1i32
    $"RustExportI32Binary(\"eoie_process_streaming_policy_binding\",\"streaming_policy_export\")" : ()
    rust_library ()
    0i32
