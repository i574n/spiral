open rust_std_env.model

inl primary (~a : i32) (~b : i32) : i32 =
    $'eoie_release_hygiene::eoie_hygiene_primary_binding(!a, !b)' : i32

inl secondary (~a : i32) (~b : i32) : i32 =
    $'eoie_release_hygiene::eoie_hygiene_secondary_binding(!a, !b)' : i32

inl root_file (~a : i32) (~b : i32) : i32 =
    $'eoie_release_hygiene::eoie_hygiene_root_file_binding(!a, !b)' : i32

inl root_aux (~a : i32) (~b : i32) : i32 =
    $'eoie_release_hygiene::eoie_hygiene_root_aux_binding(!a, !b)' : i32

inl root_directory (~a : i32) (~b : i32) : i32 =
    $'eoie_release_hygiene::eoie_hygiene_root_directory_binding(!a, !b)' : i32

inl classify (~name : string) : u64 =
    $'eoie_release_hygiene::eoie_hygiene_name_classification(&!name)' : u64

inl main () : i32 =
    inl spiral_entry = primary 1i32 0i32
    inl typecheck_rs = primary 0i32 1i32
    inl primary_keep = primary 0i32 0i32
    inl typecheck_tmp = secondary 1i32 0i32
    inl c_sidecar = secondary 0i32 1i32
    inl secondary_keep = secondary 0i32 0i32
    inl root_receipt = root_file 1i32 0i32
    inl root_candidate = root_file 0i32 1i32
    inl root_file_keep = root_file 0i32 0i32
    inl root_probe = root_aux 1i32 0i32
    inl root_cold = root_aux 0i32 1i32
    inl root_aux_keep = root_aux 0i32 0i32
    inl root_directory_cold = root_directory 1i32 0i32
    inl root_directory_cargo = root_directory 0i32 1i32
    inl root_directory_keep = root_directory 0i32 0i32
    inl class_spiral_entry = classify ".spiral-entry"
    inl class_typecheck = classify ".eoie-typecheck-9.rs"
    inl class_typecheck_tmp = classify ".eoie-typecheck-9.rs.eoie-1.tmp"
    inl class_receipt = classify "x.receipt"
    inl class_candidate = classify ".release-eoie-candidate-1"
    inl class_probe = classify "probe42.rs"
    inl class_cold = classify ".cold-rebuild-a"
    inl class_cargo = classify ".cargo"
    inl class_keep = classify "keep.txt"
    if !!!!LT(spiral_entry,1i32) then 1i32
    elif !!!!LT(typecheck_rs,1i32) then 1i32
    elif !!!!LT(0i32,primary_keep) then 1i32
    elif !!!!LT(typecheck_tmp,1i32) then 1i32
    elif !!!!LT(c_sidecar,1i32) then 1i32
    elif !!!!LT(0i32,secondary_keep) then 1i32
    elif !!!!LT(root_receipt,1i32) then 1i32
    elif !!!!LT(root_candidate,1i32) then 1i32
    elif !!!!LT(0i32,root_file_keep) then 1i32
    elif !!!!LT(root_probe,1i32) then 1i32
    elif !!!!LT(root_cold,1i32) then 1i32
    elif !!!!LT(0i32,root_aux_keep) then 1i32
    elif !!!!LT(root_directory_cold,1i32) then 1i32
    elif !!!!LT(root_directory_cargo,1i32) then 1i32
    elif !!!!LT(0i32,root_directory_keep) then 1i32
    elif !!!!NEQ(class_spiral_entry,1u64) then 1i32
    elif !!!!NEQ(class_typecheck,1u64) then 1i32
    elif !!!!NEQ(class_typecheck_tmp,1u64) then 1i32
    elif !!!!NEQ(class_receipt,2u64) then 1i32
    elif !!!!NEQ(class_candidate,2u64) then 1i32
    elif !!!!NEQ(class_probe,2u64) then 1i32
    elif !!!!NEQ(class_cold,3u64) then 1i32
    elif !!!!NEQ(class_cargo,3u64) then 1i32
    elif !!!!NEQ(class_keep,0u64) then 1i32
    else 0i32
