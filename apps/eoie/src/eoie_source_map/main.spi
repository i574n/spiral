open model

inl rust_global (x : string) : () = !!!!Global(x)

inl main () : i32 =
    inl _ = source_map_public_plan ()
    inl _ = source_map_files_binding 1i32 1i32
    inl _ = source_map_edges_binding 1i32 0i32
    inl _ = source_diff_record_binding 0i32 1i32
    inl _ = source_rebuild_count_binding 1i32 1i32
    !!!!Export("eoie_source_map_files_binding", ((fun (first, second) => source_map_files_binding first second) : i32 * i32 -> i32))
    !!!!Export("eoie_source_map_edges_binding", ((fun (first, second) => source_map_edges_binding first second) : i32 * i32 -> i32))
    !!!!Export("eoie_source_diff_record_binding", ((fun (first, second) => source_diff_record_binding first second) : i32 * i32 -> i32))
    !!!!Export("eoie_source_rebuild_count_binding", ((fun (first, second) => source_rebuild_count_binding first second) : i32 * i32 -> i32))
    rust_global "use eoie_proxy_search::mnemonic_path_tag;\nuse std::collections::{BTreeMap, BTreeSet};\n"
    rust_global "#[cfg(test)]\nfn topology_test_temporary(label: &str) -> std::path::PathBuf { std::env::temp_dir().join(format!(\"eoie-source-map-{}-{}\", label, std::process::id())) }\n"
    terminal.emit_runtime_map ()
    0i32
