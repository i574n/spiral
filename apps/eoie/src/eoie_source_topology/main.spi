open model

inl main () : i32 =
    inl _ = topology_public_plan ()
    inl _ = topology_limit_binding 1000i32 1000i32
    inl _ = topology_package_only_binding 1i32 1i32
    inl _ = source_surface_binding 0i32 1i32
    $"RustExportI32Binary(\"eoie_source_topology_limit_binding\",\"topology_limit_binding\")" : ()
    $"RustExportI32Binary(\"eoie_source_topology_package_only_binding\",\"topology_package_only_binding\")" : ()
    $"RustExportI32Binary(\"eoie_source_surface_binding\",\"source_surface_binding\")" : ()
    terminal.emit_runtime_topology ()
    $"RustLibrary()" : ()
    0i32
