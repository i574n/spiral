inl main () : i32 =
    inl _ = model.topology_public_plan ()
    inl _ = model.source_map_public_plan ()
    inl limits = model.topology_limit_binding 1000i32 1000i32
    inl classes = model.topology_package_only_binding 22i32 22i32
    inl own_surface = model.source_surface_binding 0i32 0i32
    inl generated_surface = model.source_surface_binding 0i32 1i32
    inl vendor_surface = model.source_surface_binding 1i32 1i32
    inl mapped_files = model.source_map_files_binding 4i32 2i32
    inl mapped_edges = model.source_map_edges_binding 1i32 3i32
    inl diffed = model.source_diff_record_binding 3i32 10i32
    if !!!!LT(limits,1i32) then 1i32
    elif !!!!LT(classes,1i32) then 1i32
    elif !!!!NEQ(own_surface,0i32) then 1i32
    elif !!!!NEQ(generated_surface,1i32) then 1i32
    elif !!!!NEQ(vendor_surface,2i32) then 1i32
    elif !!!!LT(mapped_files,1i32) then 1i32
    elif !!!!LT(mapped_edges,1i32) then 1i32
    elif !!!!LT(diffed,1i32) then 1i32
    else 0i32
