nominal topology_idle = ()
nominal topology_counted = ()
nominal topology_validated = ()
nominal source_map_idle = ()
nominal source_map_collected = ()
nominal source_map_compared = ()

union topology_policy =
    | TotalSourceGrowthUnbounded
    | RustFileLimitOneThousand
    | CargoCrateLimitOneThousand
    | DistinguishCargoCratesFromSpiralPackages
    | ShrinkageEvidenceAdvisory

union source_surface =
    | OwnSource
    | GeneratedSource
    | VendorSource

union source_map_policy =
    | MapPackageOwnership
    | MapCargoRuntimeBoundary
    | MapSpiralMainEntryPoints
    | MapGeneratedRustResiduals
    | MapPackageImports
    | CompareStableFingerprints
    | BuildColdResidualMatrix

union topology_op from to =
    | CountCargoCratesAndSpiralPackages :: topology_op topology_idle topology_counted
    | ValidatePerOwnerLimits :: topology_op topology_counted topology_validated

union source_map_op from to =
    | CollectOwnedPackages :: source_map_op source_map_idle source_map_collected
    | ComparePackageFingerprints :: source_map_op source_map_collected source_map_compared

union rec topology_plan from to =
    | TopologyStep :: forall from to. topology_op from to -> topology_plan from to
    | TopologyThen :: forall from to. (exists middle. topology_plan from middle * topology_plan middle to) -> topology_plan from to

union rec source_map_plan from to =
    | SourceMapStep :: forall from to. source_map_op from to -> source_map_plan from to
    | SourceMapThen :: forall from to. (exists middle. source_map_plan from middle * source_map_plan middle to) -> source_map_plan from to

inl topology_public_plan () : topology_plan topology_idle topology_validated =
    TopologyThen (exists (
        TopologyStep CountCargoCratesAndSpiralPackages,
        TopologyStep ValidatePerOwnerLimits
    ))

inl source_map_public_plan () : source_map_plan source_map_idle source_map_compared =
    SourceMapThen (exists (
        SourceMapStep CollectOwnedPackages,
        SourceMapStep ComparePackageFingerprints
    ))

let topology_limit_binding (rust_file_max : i32) (cargo_crate_max : i32) : i32 =
    if !!!!LT(1000i32,rust_file_max) then 0i32
    elif !!!!LT(1000i32,cargo_crate_max) then 0i32
    else 1i32

let topology_package_only_binding (expected_package_only : i32) (observed_package_only : i32) : i32 =
    if !!!!LT(expected_package_only,0i32) then 0i32
    elif !!!!LT(observed_package_only,0i32) then 0i32
    elif !!!!LT(expected_package_only,observed_package_only) then 0i32
    elif !!!!LT(observed_package_only,expected_package_only) then 0i32
    else 1i32

let source_surface_binding (vendor : i32) (generated : i32) : i32 =
    if !!!!LT(vendor,0i32) then -1i32
    elif !!!!LT(1i32,vendor) then -1i32
    elif !!!!LT(generated,0i32) then -1i32
    elif !!!!LT(1i32,generated) then -1i32
    elif !!!!EQ(vendor,1i32) then 2i32
    elif !!!!EQ(generated,1i32) then 1i32
    else 0i32

let source_map_files_binding (spi_files : i32) (main_files : i32) : i32 =
    if !!!!LT(spi_files,0i32) then 0i32
    elif !!!!LT(main_files,0i32) then 0i32
    elif !!!!LT(spi_files,main_files) then 0i32
    else 1i32

let source_map_edges_binding (rust_files : i32) (imports : i32) : i32 =
    if !!!!LT(rust_files,0i32) then 0i32
    elif !!!!LT(imports,0i32) then 0i32
    else 1i32

let source_diff_record_binding (changed : i32) (total : i32) : i32 =
    if !!!!LT(changed,0i32) then 0i32
    elif !!!!LT(total,0i32) then 0i32
    elif !!!!LT(total,changed) then 0i32
    else 1i32

let source_rebuild_count_binding (expected : i32) (observed : i32) : i32 =
    if !!!!LT(expected,0i32) then 0i32
    elif !!!!LT(observed,0i32) then 0i32
    elif !!!!LT(expected,observed) then 0i32
    elif !!!!LT(observed,expected) then 0i32
    else 1i32
