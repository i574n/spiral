inl rust_global (x : string) : () = !!!!Global(x)

inl emit_types () : () = rust_global "use std::fs;\nuse std::path::{Path, PathBuf};\n\n#[derive(Default, Debug, Eq, PartialEq)]\nstruct SourceTopology {\n    spiral_lines: usize,\n    rust_lines: usize,\n    spiral_source_files: usize,\n    rust_source_files: usize,\n    rust_global_sites: usize,\n    rust_max_lines: usize,\n    rust_max_file: String,\n    cargo_crates: usize,\n    spiral_packages: usize,\n    package_only: usize,\n    crate_max_lines: usize,\n    crate_max: String,\n}\n\n#[derive(Default, Debug, Eq, PartialEq)]\nstruct GenericSurfaceStats {\n    own_spiral_lines: usize,\n    own_rust_lines: usize,\n    generated_rust_lines: usize,\n    vendor_spiral_lines: usize,\n    vendor_rust_lines: usize,\n    own_spiral_files: usize,\n    own_rust_files: usize,\n    generated_rust_files: usize,\n    vendor_spiral_files: usize,\n    vendor_rust_files: usize,\n    vendor_cargo_crates: usize,\n    vendor_spiral_packages: usize,\n}\n\nfn topology_arg<'a>(args: &'a [String], index: usize, name: &str) -> Result<&'a str, String> {\n    args.get(index).map(String::as_str).ok_or_else(|| format!(\"missing argument: {name}\"))\n}\n\nfn topology_skip(path: &Path) -> bool {\n    matches!(path.file_name().and_then(|value| value.to_str()), Some(\"vendor\" | \"target\" | \".git\"))\n}\n\nfn topology_entries(path: &Path) -> Result<Vec<PathBuf>, String> {\n    let mut entries = fs::read_dir(path)\n        .map_err(|error| format!(\"read {}: {error}\", path.display()))?\n        .map(|entry| entry.map(|value| value.path()).map_err(|error| error.to_string()))\n        .collect::<Result<Vec<_>, _>>()?;\n    entries.sort();\n    Ok(entries)\n}\n\nfn topology_lines(path: &Path) -> Result<usize, String> {\n    let bytes = fs::read(path).map_err(|error| format!(\"read {}: {error}\", path.display()))?;\n    if bytes.is_empty() { return Ok(0); }\n    Ok(bytes.iter().filter(|byte| **byte == b'\\n').count() + usize::from(!bytes.ends_with(b\"\\n\")))\n}\n\nfn topology_relative(root: &Path, path: &Path) -> String {\n    path.strip_prefix(root).unwrap_or(path).to_string_lossy().replace('\\\\', \"/\")\n}\n"

inl emit_scan () : () = rust_global "fn topology_generic_ignore(path: &Path) -> bool {\n    match path.file_name().and_then(|value| value.to_str()) {\n        Some(\".git\") => true,\n        Some(\"target\") => path.join(\"CACHEDIR.TAG\").is_file(),\n        _ => false,\n    }\n}\n\nfn topology_generic_vendor_dir(path: &Path) -> bool {\n    path.file_name().and_then(|value| value.to_str()) == Some(\"vendor\")\n}\n\nfn topology_generated_rust(path: &Path) -> Result<bool, String> {\n    let bytes = fs::read(path).map_err(|error| format!(\"read {}: {error}\", path.display()))?;\n    let marker = b\"Generated by Spiral portable Rust backend.\";\n    Ok(bytes.windows(marker.len()).any(|window| window == marker))\n}\n\nfn topology_generic_crate_lines(path: &Path) -> Result<usize, String> {\n    let metadata = fs::symlink_metadata(path).map_err(|error| format!(\"metadata {}: {error}\", path.display()))?;\n    if metadata.file_type().is_symlink() { return Err(format!(\"source-stats rejects symlink: {}\", path.display())); }\n    if metadata.is_dir() {\n        if topology_generic_ignore(path) || topology_generic_vendor_dir(path) { return Ok(0); }\n        let mut total = 0usize;\n        for child in topology_entries(path)? { total += topology_generic_crate_lines(&child)?; }\n        return Ok(total);\n    }\n    if metadata.is_file() && matches!(path.extension().and_then(|value| value.to_str()), Some(\"rs\" | \"spi\" | \"spir\")) { topology_lines(path) } else { Ok(0) }\n}\n\nfn topology_generic_walk(root: &Path, path: &Path, inherited_vendor: bool, stats: &mut SourceTopology, surfaces: &mut GenericSurfaceStats) -> Result<(), String> {\n    let metadata = fs::symlink_metadata(path).map_err(|error| format!(\"metadata {}: {error}\", path.display()))?;\n    if metadata.file_type().is_symlink() { return Err(format!(\"source-stats rejects symlink: {}\", path.display())); }\n    let vendor = inherited_vendor || (path != root && topology_generic_vendor_dir(path));\n    if metadata.is_dir() {\n        if path != root && topology_generic_ignore(path) { return Ok(()); }\n        for child in topology_entries(path)? { topology_generic_walk(root, &child, vendor, stats, surfaces)?; }\n        return Ok(());\n    }\n    if !metadata.is_file() { return Ok(()); }\n    let lines = topology_lines(path)?;\n    match path.extension().and_then(|value| value.to_str()) {\n        Some(\"spi\") | Some(\"spir\") => {\n            let class = eoie_source_surface_binding(i32::from(vendor), 0);\n            if class == 2 { surfaces.vendor_spiral_lines += lines; surfaces.vendor_spiral_files += 1; }\n            else if class == 0 {\n                surfaces.own_spiral_lines += lines; surfaces.own_spiral_files += 1;\n                stats.spiral_lines += lines; stats.spiral_source_files += 1;\n                let text = fs::read_to_string(path).map_err(|error| format!(\"read {}: {error}\", path.display()))?;\n                stats.rust_global_sites += text.matches(\"rust_global \\\"\").count();\n            } else { return Err(\"Spiral source received invalid generated classification\".to_owned()); }\n        }\n        Some(\"rs\") => {\n            let generated = topology_generated_rust(path)?;\n            let class = eoie_source_surface_binding(i32::from(vendor), i32::from(generated));\n            if class == 2 { surfaces.vendor_rust_lines += lines; surfaces.vendor_rust_files += 1; }\n            else {\n                if class == 1 { surfaces.generated_rust_lines += lines; surfaces.generated_rust_files += 1; }\n                else if class == 0 { surfaces.own_rust_lines += lines; surfaces.own_rust_files += 1; }\n                else { return Err(\"Rust source received invalid surface classification\".to_owned()); }\n                stats.rust_lines += lines; stats.rust_source_files += 1;\n                let relative = topology_relative(root, path);\n                if lines > stats.rust_max_lines || (lines == stats.rust_max_lines && relative < stats.rust_max_file) { stats.rust_max_lines = lines; stats.rust_max_file = relative; }\n            }\n        }\n        _ => {}\n    }\n    Ok(())\n}\n\nfn topology_walk(root: &Path, path: &Path, stats: &mut SourceTopology) -> Result<(), String> {\n    let metadata = fs::symlink_metadata(path).map_err(|error| format!(\"metadata {}: {error}\", path.display()))?;\n    if metadata.file_type().is_symlink() { return Err(format!(\"source-topology rejects symlink: {}\", path.display())); }\n    if metadata.is_dir() {\n        if path != root && topology_skip(path) { return Ok(()); }\n        for child in topology_entries(path)? { topology_walk(root, &child, stats)?; }\n        return Ok(());\n    }\n    if !metadata.is_file() { return Ok(()); }\n    let lines = topology_lines(path)?;\n    match path.extension().and_then(|value| value.to_str()) {\n        Some(\"spi\") | Some(\"spir\") => {\n            stats.spiral_lines += lines;\n            stats.spiral_source_files += 1;\n            let text = fs::read_to_string(path).map_err(|error| format!(\"read {}: {error}\", path.display()))?;\n            stats.rust_global_sites += text.matches(\"rust_global \\\"\").count();\n        }\n        Some(\"rs\") => {\n            stats.rust_lines += lines;\n            stats.rust_source_files += 1;\n            let relative = topology_relative(root, path);\n            if lines > stats.rust_max_lines || (lines == stats.rust_max_lines && relative < stats.rust_max_file) {\n                stats.rust_max_lines = lines;\n                stats.rust_max_file = relative;\n            }\n        }\n        _ => {}\n    }\n    Ok(())\n}\n\nfn topology_crate_lines(path: &Path) -> Result<usize, String> {\n    let metadata = fs::symlink_metadata(path).map_err(|error| format!(\"metadata {}: {error}\", path.display()))?;\n    if metadata.file_type().is_symlink() { return Err(format!(\"source-topology rejects symlink: {}\", path.display())); }\n    if metadata.is_dir() {\n        if topology_skip(path) { return Ok(0); }\n        let mut total = 0usize;\n        for child in topology_entries(path)? { total += topology_crate_lines(&child)?; }\n        return Ok(total);\n    }\n    if metadata.is_file() && matches!(path.extension().and_then(|value| value.to_str()), Some(\"rs\" | \"spi\" | \"spir\")) { topology_lines(path) } else { Ok(0) }\n}\n\nfn topology_generic_packages(root: &Path, path: &Path, inherited_vendor: bool, stats: &mut SourceTopology, surfaces: &mut GenericSurfaceStats) -> Result<(), String> {\n    let metadata = fs::symlink_metadata(path).map_err(|error| format!(\"metadata {}: {error}\", path.display()))?;\n    if metadata.file_type().is_symlink() { return Err(format!(\"source-stats rejects symlink: {}\", path.display())); }\n    if !metadata.is_dir() { return Ok(()); }\n    if path != root && topology_generic_ignore(path) { return Ok(()); }\n    let vendor = inherited_vendor || (path != root && topology_generic_vendor_dir(path));\n    let cargo_manifest = path.join(\"Cargo.toml\");\n    let cargo = if cargo_manifest.is_file() { fs::read_to_string(&cargo_manifest).map_err(|error| format!(\"read {}: {error}\", cargo_manifest.display()))?.lines().any(|line| line.trim() == \"[package]\") } else { false };\n    let spiral = path.join(\"package.spiproj\").is_file();\n    if vendor {\n        if spiral { surfaces.vendor_spiral_packages += 1; }\n        if cargo { surfaces.vendor_cargo_crates += 1; }\n    } else {\n        if spiral { stats.spiral_packages += 1; }\n        if cargo {\n            stats.cargo_crates += 1;\n            let lines = topology_generic_crate_lines(path)?;\n            let name = topology_relative(root, path);\n            if lines > stats.crate_max_lines || (lines == stats.crate_max_lines && name < stats.crate_max) { stats.crate_max_lines = lines; stats.crate_max = name; }\n        } else if spiral {\n            stats.package_only += 1;\n        }\n    }\n    for child in topology_entries(path)? { if child.is_dir() { topology_generic_packages(root, &child, vendor, stats, surfaces)?; } }\n    Ok(())\n}\n\nfn topology_collect_generic(root: &Path) -> Result<(SourceTopology, GenericSurfaceStats), String> {\n    if !root.is_dir() { return Err(format!(\"source-stats root is not a directory: {}\", root.display())); }\n    let mut stats = SourceTopology::default();\n    let mut surfaces = GenericSurfaceStats::default();\n    topology_generic_walk(root, root, false, &mut stats, &mut surfaces)?;\n    topology_generic_packages(root, root, false, &mut stats, &mut surfaces)?;\n    Ok((stats, surfaces))\n}\n\npub fn source_topology_counts(root: &Path) -> Result<[usize;10], String> {\n    let stats = topology_collect(root)?;\n    Ok([stats.spiral_source_files, stats.rust_source_files, stats.rust_global_sites, stats.spiral_lines, stats.rust_lines, stats.cargo_crates, stats.spiral_packages, stats.package_only, stats.crate_max_lines, stats.rust_max_lines])\n}\n\nfn topology_collect(root: &Path) -> Result<SourceTopology, String> {\n    if !root.is_dir() { return Err(format!(\"source-topology root is not a directory: {}\", root.display())); }\n    let mut stats = SourceTopology::default();\n    topology_walk(root, root, &mut stats)?;\n    let source_root = root.join(\"src\");\n    if source_root.is_dir() {\n        for package_root in topology_entries(&source_root)? {\n            if !package_root.is_dir() || topology_skip(&package_root) { continue; }\n            let cargo = package_root.join(\"Cargo.toml\").is_file();\n            let spiral = package_root.join(\"package.spiproj\").is_file();\n            if spiral { stats.spiral_packages += 1; }\n            if cargo {\n                stats.cargo_crates += 1;\n                let lines = topology_crate_lines(&package_root)?;\n                let name = package_root.file_name().and_then(|value| value.to_str()).unwrap_or_default().to_owned();\n                if lines > stats.crate_max_lines || (lines == stats.crate_max_lines && name < stats.crate_max) {\n                    stats.crate_max_lines = lines;\n                    stats.crate_max = name;\n                }\n            } else if spiral {\n                stats.package_only += 1;\n            }\n        }\n    }\n    Ok(stats)\n}\n"

inl emit_run () : () = rust_global "fn topology_census_text(stats: &SourceTopology) -> String {\n    format!(\"union authority_census =\\n    | AuthorityCensus :: u32 * u32 * u32 * u32 * u32 * u32 * u32 * u32 * u32 * u32 -> authority_census\\n\\ninl current_authority_census () : authority_census =\\n    AuthorityCensus ({}u32, {}u32, {}u32, {}u32, {}u32, {}u32, {}u32, {}u32, {}u32, {}u32)\\n\\ninl census_authority () : string = \\\"source-topology\\\"\\ninl main () : i32 = 0i32\\n\", stats.spiral_source_files, stats.rust_source_files, stats.rust_global_sites, stats.spiral_lines, stats.rust_lines, stats.cargo_crates, stats.spiral_packages, stats.package_only, stats.crate_max_lines, stats.rust_max_lines)\n}\n\nfn topology_write_census(root: &Path, relative: &str, stats: &SourceTopology) -> Result<(), String> {\n    if relative != \"state/authority_census.spi\" { return Err(\"source-topology census output must be state/authority_census.spi\".to_owned()); }\n    let path = root.join(relative);\n    let parent = path.parent().ok_or_else(|| \"authority census parent missing\".to_owned())?;\n    fs::create_dir_all(parent).map_err(|error| format!(\"create {}: {error}\", parent.display()))?;\n    let stage = parent.join(format!(\".authority-census-{}\", std::process::id()));\n    let body = topology_census_text(stats);\n    fs::write(&stage, body.as_bytes()).map_err(|error| format!(\"write {}: {error}\", stage.display()))?;\n    fs::rename(&stage, &path).map_err(|error| format!(\"commit {}: {error}\", path.display()))?;\n    Ok(())\n}\n\npub fn refresh_authority_census(root: &Path) -> Result<(), String> {\n    let args = vec![\"source-topology\".to_owned(), root.to_string_lossy().into_owned(), \"state/authority_census.spi\".to_owned()];\n    source_topology_run(&args)\n}\n\npub fn source_stats_run(args: &[String]) -> Result<(), String> {\n    if args.len() != 2 { return Err(\"source-stats expects root\".to_owned()); }\n    let root = Path::new(topology_arg(args, 1, \"root\")?);\n    let (stats, surfaces) = topology_collect_generic(root)?;\n    let limits = eoie_source_topology_limit_binding(stats.rust_max_lines as i32, stats.crate_max_lines as i32);\n    let own_lines = surfaces.own_spiral_lines + surfaces.own_rust_lines;\n    let product_lines = own_lines + surfaces.generated_rust_lines;\n    let vendor_lines = surfaces.vendor_spiral_lines + surfaces.vendor_rust_lines;\n    println!(\"eoie proxy source-stats ok root={} scope=classified-source package_discovery=recursive classification_policy=vendor-segment+spiral-generated-marker build_target_policy=cachedir-tag\", root.display());\n    println!(\"own_lines={} generated_lines={} vendor_lines={} product_lines={} all_source_lines={} total_growth_policy=report-only\", own_lines, surfaces.generated_rust_lines, vendor_lines, product_lines, product_lines + vendor_lines);\n    println!(\"own_spiral_lines={} own_rust_lines={} generated_rust_lines={} vendor_spiral_lines={} vendor_rust_lines={}\", surfaces.own_spiral_lines, surfaces.own_rust_lines, surfaces.generated_rust_lines, surfaces.vendor_spiral_lines, surfaces.vendor_rust_lines);\n    println!(\"own_spiral_files={} own_rust_files={} generated_rust_files={} vendor_spiral_files={} vendor_rust_files={} rust_global_site_count={} census_authority=source-stats\", surfaces.own_spiral_files, surfaces.own_rust_files, surfaces.generated_rust_files, surfaces.vendor_spiral_files, surfaces.vendor_rust_files, stats.rust_global_sites);\n    println!(\"cargo_crate_count={} vendor_cargo_crate_count={} cargo_crate_max_lines={} cargo_crate_max={} density_gate_observed={}\", stats.cargo_crates, surfaces.vendor_cargo_crates, stats.crate_max_lines, stats.crate_max, if limits == 1 { \"within-eoie-limit\" } else { \"above-eoie-limit\" });\n    println!(\"spiral_package_count={} vendor_spiral_package_count={} package_only_spiral_count={} package_classification=recursive-generic rust_max_file_lines={} rust_max_file={}\", stats.spiral_packages, surfaces.vendor_spiral_packages, stats.package_only, stats.rust_max_lines, stats.rust_max_file);\n    Ok(())\n}\n\npub fn source_topology_run(args: &[String]) -> Result<(), String> {\n    if args.len() != 2 && args.len() != 3 { return Err(\"source-topology expects root [state/authority_census.spi]\".to_owned()); }\n    let root = Path::new(topology_arg(args, 1, \"root\")?);\n    let stats = topology_collect(root)?;\n    let limits = eoie_source_topology_limit_binding(stats.rust_max_lines as i32, stats.crate_max_lines as i32);\n    let expected_package_only = stats.spiral_packages.saturating_sub(stats.cargo_crates);\n    let classified = eoie_source_topology_package_only_binding(expected_package_only as i32, stats.package_only as i32);\n    if limits != 1 { return Err(format!(\"source topology limit exceeded: rust_file_max={} rust_file={} cargo_crate_max={} cargo_crate={} limit=1000\", stats.rust_max_lines, stats.rust_max_file, stats.crate_max_lines, stats.crate_max)); }\n    if classified != 1 { return Err(format!(\"source topology classification mismatch: cargo_crates={} spiral_packages={} package_only={}\", stats.cargo_crates, stats.spiral_packages, stats.package_only)); }\n    if args.len() == 3 {\n        topology_write_census(root, topology_arg(args, 2, \"census-relative\")?, &stats)?;\n        println!(\"census_written=true path={}\", root.join(topology_arg(args, 2, \"census-relative\")?).display());\n    }\n    println!(\"eoie proxy source-topology ok root={}\", root.display());\n    println!(\"spiral_lines={} rust_lines={} combined_lines={} total_growth_policy=unbounded\", stats.spiral_lines, stats.rust_lines, stats.spiral_lines + stats.rust_lines);\n    println!(\"spiral_source_file_count={} rust_source_file_count={} rust_global_site_count={} census_authority=source-topology\", stats.spiral_source_files, stats.rust_source_files, stats.rust_global_sites);\n    println!(\"cargo_crate_count={} cargo_crate_count_policy=unbounded cargo_crate_max_lines={} cargo_crate_max={} cargo_crate_loc_limit=1000\", stats.cargo_crates, stats.crate_max_lines, stats.crate_max);\n    println!(\"spiral_package_count={} spiral_package_count_policy=unbounded package_only_spiral_count={} rust_max_file_lines={} rust_max_file={} rust_file_loc_limit=1000\", stats.spiral_packages, stats.package_only, stats.rust_max_lines, stats.rust_max_file);\n    println!(\"topology_limits_ok=true owner_growth_policy=report-only pruning_policy=consumer-proof\");\n    Ok(())\n}\n\n#[cfg(test)]\nuse std::sync::atomic::{AtomicU64, Ordering};\n#[cfg(test)]\nstatic TOPOLOGY_TEST_NEXT: AtomicU64 = AtomicU64::new(0);\n#[cfg(test)]\nfn topology_test_temporary(label: &str) -> PathBuf { std::env::temp_dir().join(format!(\"eoie-source-topology-{label}-{}-{}\", std::process::id(), TOPOLOGY_TEST_NEXT.fetch_add(1, Ordering::Relaxed))) }\n#[cfg(test)]\n#[test]\nfn distinguishes_cargo_crates_from_package_only_spiral() {\n    let root = topology_test_temporary(\"counts\");\n    fs::create_dir_all(root.join(\"src/cargo\")).expect(\"cargo\");\n    fs::create_dir_all(root.join(\"src/package-only\")).expect(\"package-only\");\n    fs::write(root.join(\"src/cargo/Cargo.toml\"), b\"[package]\\nname='cargo'\\n\").expect(\"cargo toml\");\n    fs::write(root.join(\"src/cargo/package.spiproj\"), b\"modules:\\n    main\\n\").expect(\"cargo spiproj\");\n    fs::write(root.join(\"src/cargo/main.rs\"), b\"fn main() {}\\n\").expect(\"cargo rs\");\n    fs::write(root.join(\"src/package-only/package.spiproj\"), b\"modules:\\n    model\\n\").expect(\"package spiproj\");\n    fs::write(root.join(\"src/package-only/model.spi\"), b\"inl value () : i32 = 1i32\\n\").expect(\"package spi\");\n    let stats = topology_collect(&root).expect(\"stats\");\n    assert_eq!(stats.cargo_crates, 1);\n    assert_eq!(stats.spiral_packages, 2);\n    assert_eq!(stats.package_only, 1);\n    assert_eq!(stats.spiral_source_files, 1);\n    assert_eq!(stats.rust_source_files, 1);\n    assert_eq!(stats.rust_global_sites, 0);\n    fs::remove_dir_all(root).expect(\"cleanup\");\n}\n"

inl emit_map () : () = rust_global "#[derive(Clone, Debug, Eq, PartialEq)]\nstruct SourcePackageMap {\n    path: String,\n    cargo: bool,\n    spi_files: usize,\n    rust_files: usize,\n    rust_lines: usize,\n    main_files: usize,\n    imports: usize,\n    source_lines: usize,\n    fingerprint: u64,\n}\n\n#[derive(Default, Debug, Eq, PartialEq)]\nstruct SourceDiffCounts { added: usize, removed: usize, changed: usize, unchanged: usize }\n\nfn source_map_hash(mut hash: u64, bytes: &[u8]) -> u64 {\n    for byte in bytes { hash ^= u64::from(*byte); hash = hash.wrapping_mul(1099511628211); }\n    hash\n}\n\nfn source_map_package_roots(path: &Path, roots: &mut Vec<PathBuf>) -> Result<(), String> {\n    if topology_skip(path) { return Ok(()); }\n    if path.join(\"package.spiproj\").is_file() { roots.push(path.to_path_buf()); }\n    for child in topology_entries(path)? {\n        if child.is_dir() { source_map_package_roots(&child, roots)?; }\n    }\n    Ok(())\n}\n\nfn source_map_owned_files(owner: &Path, path: &Path, files: &mut Vec<PathBuf>) -> Result<(), String> {\n    if path != owner && path.join(\"package.spiproj\").is_file() { return Ok(()); }\n    for child in topology_entries(path)? {\n        let metadata = fs::symlink_metadata(&child).map_err(|error| format!(\"metadata {}: {error}\", child.display()))?;\n        if metadata.file_type().is_symlink() { return Err(format!(\"spi-map rejects symlink: {}\", child.display())); }\n        if metadata.is_dir() {\n            if !topology_skip(&child) { source_map_owned_files(owner, &child, files)?; }\n        } else if metadata.is_file() && matches!(child.file_name().and_then(|value| value.to_str()), Some(\"Cargo.toml\" | \"package.spiproj\")) || metadata.is_file() && matches!(child.extension().and_then(|value| value.to_str()), Some(\"spi\" | \"rs\")) {\n            files.push(child);\n        }\n    }\n    Ok(())\n}\n\nfn source_map_import_count(path: &Path) -> Result<usize, String> {\n    let text = fs::read_to_string(path).map_err(|error| format!(\"read {}: {error}\", path.display()))?;\n    let mut active = false;\n    let mut count = 0usize;\n    for line in text.lines() {\n        let trimmed = line.trim();\n        if trimmed == \"packages:\" { active = true; continue; }\n        if active && !line.starts_with(' ') && !line.starts_with('\\t') && !trimmed.is_empty() { active = false; }\n        if active && !trimmed.is_empty() && !trimmed.starts_with(\"//\") { count += 1; }\n    }\n    Ok(count)\n}\n\nfn source_map_is_cargo_crate(owner: &Path) -> Result<bool, String> {\n    let manifest = owner.join(\"Cargo.toml\");\n    if !manifest.is_file() { return Ok(false); }\n    let text = fs::read_to_string(&manifest).map_err(|error| format!(\"read {}: {error}\", manifest.display()))?;\n    Ok(text.lines().any(|line| line.trim() == \"[package]\"))\n}\n\nfn source_map_package(root: &Path, owner: &Path) -> Result<SourcePackageMap, String> {\n    let mut files = Vec::new();\n    source_map_owned_files(owner, owner, &mut files)?;\n    files.sort();\n    let mut record = SourcePackageMap {\n        path: { let relative = topology_relative(&root.join(\"src\"), owner); if relative.is_empty() { \".\".to_owned() } else { relative } },\n        cargo: source_map_is_cargo_crate(owner)?,\n        spi_files: 0, rust_files: 0, rust_lines: 0, main_files: 0, imports: 0, source_lines: 0,\n        fingerprint: 14695981039346656037,\n    };\n    record.imports = source_map_import_count(&owner.join(\"package.spiproj\"))?;\n    for file in files {\n        let relative = topology_relative(owner, &file);\n        let bytes = fs::read(&file).map_err(|error| format!(\"read {}: {error}\", file.display()))?;\n        record.fingerprint = source_map_hash(record.fingerprint, relative.as_bytes());\n        record.fingerprint = source_map_hash(record.fingerprint, &[0]);\n        record.fingerprint = source_map_hash(record.fingerprint, &bytes);\n        match file.extension().and_then(|value| value.to_str()) {\n            Some(\"spi\") => {\n                record.spi_files += 1;\n                record.source_lines += topology_lines(&file)?;\n                if String::from_utf8_lossy(&bytes).contains(\"inl main\") { record.main_files += 1; }\n            }\n            Some(\"rs\") => { let lines = topology_lines(&file)?; record.rust_files += 1; record.rust_lines += lines; record.source_lines += lines; }\n            _ => {}\n        }\n    }\n    if eoie_source_map_files_binding(record.spi_files as i32, record.main_files as i32) != 1 {\n        return Err(format!(\"invalid source-map file record: {}\", record.path));\n    }\n    if eoie_source_map_edges_binding(record.rust_files as i32, record.imports as i32) != 1 {\n        return Err(format!(\"invalid source-map edge record: {}\", record.path));\n    }\n    Ok(record)\n}\n\nfn source_map_collect(root: &Path) -> Result<BTreeMap<String, SourcePackageMap>, String> {\n    let src = root.join(\"src\");\n    if !src.is_dir() { return Err(format!(\"spi-map root has no src directory: {}\", root.display())); }\n    let mut roots = Vec::new();\n    source_map_package_roots(&src, &mut roots)?;\n    roots.sort();\n    roots.dedup();\n    let mut map = BTreeMap::new();\n    for owner in roots {\n        let record = source_map_package(root, &owner)?;\n        if map.insert(record.path.clone(), record).is_some() { return Err(\"duplicate source package path\".to_owned()); }\n    }\n    Ok(map)\n}\n\npub fn source_owner_rust_lines(root: &Path) -> Result<BTreeMap<String,u32>, String> {\n    let map = source_map_collect(root)?;\n    Ok(map.into_values().filter(|record| record.cargo && !record.path.contains('/')).map(|record| (record.path, u32::try_from(record.rust_lines).unwrap_or(u32::MAX))).collect())\n}\n\nfn source_map_diff_counts(left: &BTreeMap<String, SourcePackageMap>, right: &BTreeMap<String, SourcePackageMap>, emit: bool) -> SourceDiffCounts {\n    let keys = left.keys().chain(right.keys()).cloned().collect::<BTreeSet<_>>();\n    let mut counts = SourceDiffCounts::default();\n    for key in keys {\n        match (left.get(&key), right.get(&key)) {\n            (None, Some(after)) => { counts.added += 1; if emit { println!(\"source-diff change=added path={} fingerprint={:016x}\", key, after.fingerprint); } }\n            (Some(before), None) => { counts.removed += 1; if emit { println!(\"source-diff change=removed path={} fingerprint={:016x}\", key, before.fingerprint); } }\n            (Some(before), Some(after)) if before != after => { counts.changed += 1; if emit { println!(\"source-diff change=changed path={} before={:016x} after={:016x}\", key, before.fingerprint, after.fingerprint); } }\n            (Some(_), Some(_)) => counts.unchanged += 1,\n            (None, None) => {}\n        }\n    }\n    counts\n}\n\npub fn source_map_run(args: &[String]) -> Result<(), String> {\n    let root = Path::new(topology_arg(args, 1, \"root\")?);\n    if args.len() != 2 { return Err(\"spi-map expects root\".to_owned()); }\n    let map = source_map_collect(root)?;\n    let mut cargo = 0usize;\n    let mut mains = 0usize;\n    let mut residuals = 0usize;\n    let mut imports = 0usize;\n    let mut tag_owners = BTreeMap::<String, String>::new();\n    for record in map.values() {\n        let tag = mnemonic_path_tag(&record.path)?;\n        if let Some(previous) = tag_owners.insert(tag.clone(), record.path.clone()) {\n            let collision_allowed = eoie_proxy_search::eoie_proxy_search_proxy_path_tag_collision_binding(1, i32::from(previous == record.path));\n            if collision_allowed != 1 { return Err(format!(\"path-tag collision tag={} first={} second={}\", tag, previous, record.path)); }\n        }\n        println!(\"source-tag path={} tag={}\", record.path, tag);\n        cargo += usize::from(record.cargo); mains += record.main_files; residuals += record.rust_files; imports += record.imports;\n        println!(\"source-package path={} cargo={} spi_files={} rust_files={} main_files={} imports={} source_lines={} fingerprint={:016x}\", record.path, record.cargo, record.spi_files, record.rust_files, record.main_files, record.imports, record.source_lines, record.fingerprint);\n    }\n    println!(\"eoie proxy spi-map ok root={} packages={} cargo_crates={} package_only={} mains={} rust_residuals={} imports={}\", root.display(), map.len(), cargo, map.len().saturating_sub(cargo), mains, residuals, imports);\n    Ok(())\n}\n\npub fn source_diff_run(args: &[String]) -> Result<(), String> {\n    if args.len() != 3 { return Err(\"spi-diff expects left-root right-root\".to_owned()); }\n    let left_root = Path::new(topology_arg(args, 1, \"left-root\")?);\n    let right_root = Path::new(topology_arg(args, 2, \"right-root\")?);\n    let left = source_map_collect(left_root)?;\n    let right = source_map_collect(right_root)?;\n    let counts = source_map_diff_counts(&left, &right, true);\n    let total = counts.added + counts.removed + counts.changed + counts.unchanged;\n    let changed = counts.added + counts.removed + counts.changed;\n    if eoie_source_diff_record_binding(changed as i32, total as i32) != 1 { return Err(\"invalid source diff counts\".to_owned()); }\n    println!(\"eoie proxy spi-diff ok left={} right={} added={} removed={} changed={} unchanged={} total={}\", left_root.display(), right_root.display(), counts.added, counts.removed, counts.changed, counts.unchanged, total);\n    Ok(())\n}\n\n#[cfg(test)]\n#[test]\nfn source_map_and_diff_are_stable() {\n    let left = topology_test_temporary(\"map-left\");\n    let right = topology_test_temporary(\"map-right\");\n    for root in [&left, &right] {\n        fs::create_dir_all(root.join(\"src/a\")).expect(\"create a\");\n        fs::write(root.join(\"src/a/package.spiproj\"), b\"modules:\\n    model\\n\").expect(\"spiproj\");\n    }\n    fs::write(left.join(\"src/a/model.spi\"), b\"inl value () : i32 = 1i32\\n\").expect(\"left model\");\n    fs::write(right.join(\"src/a/model.spi\"), b\"inl value () : i32 = 2i32\\n\").expect(\"right model\");\n    fs::create_dir_all(right.join(\"src/b\")).expect(\"create b\");\n    fs::write(right.join(\"src/b/package.spiproj\"), b\"modules:\\n    main\\n\").expect(\"b spiproj\");\n    fs::write(right.join(\"src/b/main.spi\"), b\"inl main () : i32 = 0i32\\n\").expect(\"b main\");\n    let left_map = source_map_collect(&left).expect(\"left map\");\n    let right_map = source_map_collect(&right).expect(\"right map\");\n    assert_eq!(left_map.len(), 1);\n    assert_eq!(right_map.len(), 2);\n    let counts = source_map_diff_counts(&left_map, &right_map, false);\n    assert_eq!(counts, SourceDiffCounts { added: 1, removed: 0, changed: 1, unchanged: 0 });\n    fs::remove_dir_all(left).expect(\"left cleanup\");\n    fs::remove_dir_all(right).expect(\"right cleanup\");\n}\n"

inl emit_residual_owner () : () = rust_global "pub fn source_generated_residual(root: &Path, path: &Path) -> Result<bool, String> {\n    if path.extension().and_then(|value| value.to_str()) != Some(\"rs\") { return Ok(false); }\n    let source_root = root.join(\"src\");\n    if !path.starts_with(&source_root) { return Ok(false); }\n    let Some(mut cursor) = path.parent() else { return Ok(false); };\n    loop {\n        if cursor.join(\"package.spiproj\").is_file() {\n            for child in topology_entries(cursor)? {\n                if child.is_file() && child.extension().and_then(|value| value.to_str()) == Some(\"spi\") { return Ok(true); }\n            }\n            return Ok(false);\n        }\n        if cursor == source_root { break; }\n        let Some(parent) = cursor.parent() else { break; };\n        if !parent.starts_with(&source_root) { break; }\n        cursor = parent;\n    }\n    Ok(false)\n}\n"

inl emit_cold_matrix () : () = rust_global "pub fn source_rebuild_pairs(root: &Path) -> Result<Vec<(PathBuf,PathBuf)>, String> {\n    let src = root.join(\"src\");\n    let mut roots = Vec::new();\n    source_map_package_roots(&src, &mut roots)?;\n    roots.sort(); roots.dedup();\n    let mut pairs = Vec::new();\n    let expected = source_map_collect(root)?.values().map(|record| record.rust_files).sum::<usize>();\n    for owner in roots {\n        if !source_map_is_cargo_crate(&owner)? { continue; }\n        let manifest = fs::read_to_string(owner.join(\"Cargo.toml\")).map_err(|e| format!(\"read Cargo manifest {}: {e}\", owner.display()))?;\n        let mut outputs = BTreeSet::new();\n        let mut lib_output = None;\n        let mut in_lib = false;\n        for line in manifest.lines() {\n            let t = line.trim();\n            if t.starts_with('[') { in_lib = t == \"[lib]\"; }\n            if let Some(rest) = t.strip_prefix(\"path = \\\"\") && let Some(value) = rest.strip_suffix('\\\"') && value.ends_with(\".rs\") { let path = owner.join(value); if in_lib { lib_output = Some(path.clone()); } outputs.insert(path); }\n        }\n        for output in &outputs {\n            let mut input = output.clone(); input.set_extension(\"spi\");\n            if input.is_file() { let text = fs::read_to_string(&input).map_err(|e| format!(\"read {}: {e}\", input.display()))?; if !text.lines().any(|line| line.trim_start().starts_with(\"inl main \")) { input = PathBuf::new(); } }\n            if !input.is_file() {\n                let mut source_owner = output.parent().ok_or_else(|| format!(\"cold rebuild output has no parent: {}\", output.display()))?.to_path_buf();\n                while source_owner != src && !source_owner.join(\"package.spiproj\").is_file() { source_owner = source_owner.parent().ok_or_else(|| format!(\"cold rebuild source owner missing: {}\", output.display()))?.to_path_buf(); }\n                if !source_owner.join(\"package.spiproj\").is_file() { return Err(format!(\"cold rebuild package owner missing output={}\", output.display())); }\n                let canonical_main = source_owner.join(\"main.spi\");\n                if canonical_main.is_file() && outputs.len() == 1 && output.file_stem().and_then(|v| v.to_str()) == source_owner.file_name().and_then(|v| v.to_str()) { input = canonical_main; }\n                else {\n                    let mut owned_source = Vec::new(); source_map_owned_files(&source_owner, &source_owner, &mut owned_source)?;\n                    let mut fallback_mains = Vec::new();\n                    for file in owned_source {\n                        if file.extension().and_then(|v| v.to_str()) != Some(\"spi\") { continue; }\n                        let text = fs::read_to_string(&file).map_err(|e| format!(\"read {}: {e}\", file.display()))?;\n                        if !text.lines().any(|line| line.trim_start().starts_with(\"inl main \")) { continue; }\n                        let mut natural = file.clone(); natural.set_extension(\"rs\");\n                        if !outputs.contains(&natural) { fallback_mains.push(file); }\n                    }\n                    fallback_mains.sort(); fallback_mains.dedup();\n                    if fallback_mains.len() == 1 { input = fallback_mains[0].clone(); }\n                    else {\n                        let output_stem = output.file_stem().and_then(|v| v.to_str()).ok_or_else(|| format!(\"cold rebuild output stem missing: {}\", output.display()))?;\n                        let owner_stem = source_owner.file_name().and_then(|v| v.to_str()).unwrap_or_default();\n                        let output_role = if output_stem == owner_stem { \"\" } else if let Some(rest) = output_stem.strip_prefix(&format!(\"{owner_stem}_\")) { rest } else { output_stem };\n                        let normalize_role = |stem: &str| { let mut value = stem.to_owned(); if value == \"main\" { value.clear(); } for suffix in [\"_main\", \"_probe\"] { if let Some(base) = value.strip_suffix(suffix) { value = base.to_owned(); } } value };\n                        let wanted = normalize_role(output_role);\n                        let role_matches = fallback_mains.iter().filter(|file| file.file_stem().and_then(|v| v.to_str()).map(normalize_role).as_deref() == Some(wanted.as_str())).cloned().collect::<Vec<_>>();\n                        if role_matches.len() == 1 { input = role_matches[0].clone(); }\n                        else if role_matches.is_empty() && lib_output.as_ref() == Some(output) && canonical_main.is_file() { input = canonical_main; }\n                        else { return Err(format!(\"cold rebuild source ambiguous output={} role={} fallback_mains={} role_matches={}\", output.display(), wanted, fallback_mains.len(), role_matches.len())); }\n                    }\n                }\n            }\n            pairs.push((input, output.clone()));\n        }\n    }\n    pairs.sort_by(|a,b| a.1.cmp(&b.1));\n    if eoie_source_rebuild_count_binding(expected as i32, pairs.len() as i32) != 1 { return Err(format!(\"cold rebuild count mismatch expected={expected} observed={}\", pairs.len())); }\n    Ok(pairs)\n}\n"

inl emit_runtime_topology () : () =
    emit_types ()
    emit_scan ()
    emit_run ()

inl emit_runtime_map () : () =
    emit_types ()
    emit_map ()
    emit_residual_owner ()
    emit_cold_matrix ()

inl emit_runtime () : () =
    emit_runtime_topology ()
    emit_map ()
    emit_residual_owner ()
    emit_cold_matrix ()
