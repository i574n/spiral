open toolchain_command_domain.model

union toolchain_cwd =
    | RequestedCargoRoot
    | NestedCargoRoot

inl toolchain_cwd_code = function
    | RequestedCargoRoot => 0i32
    | NestedCargoRoot => 1i32

let toolchain_cwd_binding (action : i32) (manifest_code : i32) : i32 =
    if !!!!LT(manifest_code,0i32) || !!!!LT(3i32,manifest_code) then -1i32
    elif !!!!EQ(action,7i32) || !!!!EQ(manifest_code,1i32) || !!!!EQ(manifest_code,3i32) then toolchain_cwd_code RequestedCargoRoot
    elif !!!!EQ(manifest_code,2i32) then toolchain_cwd_code NestedCargoRoot
    else -1i32

inl toolchain_u64_decimal_normalize (input : string) : string =
    inl input_len = sm.length input : i32
    if starts_with input "+" then
        if (=.) input_len 1i32 then codec_empty ()
        else codec_u64_decimal_normalize (slice_exclusive input 1i32 input_len)
    else codec_u64_decimal_normalize input

let toolchain_u64_decimal_value (input : string) : u64 =
    codec_u64_decimal_value (toolchain_u64_decimal_normalize input)

let toolchain_u64_decimal_valid (input : string) : u64 =
    inl normalized = toolchain_u64_decimal_normalize input
    if (=.) normalized "" then 0u64 else 1u64

let toolchain_u32_decimal_valid (input : string) : u64 =
    inl normalized = toolchain_u64_decimal_normalize input
    if (=.) normalized "" then 0u64
    else
        inl value = codec_u64_decimal_value normalized
        if (<=) value 4294967295u64 then 1u64 else 0u64

let toolchain_i32_decimal_code (input : string) : u64 =
    inl input_len = sm.length input : i32
    inl negative = starts_with input "-"
    inl positive = starts_with input "+"
    inl body =
        if negative || positive then
            if (=.) input_len 1i32 then codec_empty ()
            else slice_exclusive input 1i32 input_len
        else input
    inl normalized = codec_u64_decimal_normalize body
    if (=.) normalized "" then 0u64
    else
        inl magnitude = codec_u64_decimal_value normalized
        if negative then
            if (<=) magnitude 2147483648u64 then (+.) 2147483649u64 magnitude else 0u64
        elif (<=) magnitude 2147483647u64 then (+.) 1u64 magnitude
        else 0u64

inl main () : i32 =
    toolchain_terminal.rust_global "#![allow(clippy::items_after_test_module, clippy::possible_missing_else)]"
    toolchain_terminal.emit_runtime ()
    inl _ = toolchain_u64_decimal_valid "42", toolchain_u64_decimal_value "42", toolchain_u32_decimal_valid "42", toolchain_i32_decimal_code "-1"

    $"RustExportI32Binary(\"eoie_toolchain_cwd\",\"toolchain_cwd_binding\")" : ()
    $"RustExportU64Unary(\"eoie_toolchain_u64_decimal_valid\",\"toolchain_u64_decimal_valid\")" : ()
    $"RustExportU64Unary(\"eoie_toolchain_u64_decimal_value\",\"toolchain_u64_decimal_value\")" : ()
    $"RustExportU64Unary(\"eoie_toolchain_u32_decimal_valid\",\"toolchain_u32_decimal_valid\")" : ()
    $"RustExportU64Unary(\"eoie_toolchain_i32_decimal_code\",\"toolchain_i32_decimal_code\")" : ()
    $"RustLibrary()" : ()

    inl _ = toolchain_cwd_binding 0i32 0i32
    0i32
