inl rust_global (x : string) : () = !!!!Global(x)

inl emit_runtime_core () : () = rust_global "use eoie_process::ProcessTermination;\nuse eoie_process_observation::{run_bounded_streaming_checked, run_bounded_streaming_receipted_observed, ProcessObservation};\nuse process_batch_plan_domain::{eoie_batch_plan_accept, eoie_batch_plan_advance};\nuse toolchain_command_domain::{eoie_toolchain_environment_entry as EE,eoie_toolchain_environment_entry_count as EC,eoie_toolchain_execution_plan as EP,eoie_toolchain_resume_profile as RP,eoie_toolchain_resume_retry as RR};\nuse command_spec_domain::eoie_toolchain_action_name_code as AN;\nuse toolchain_runtime_policy_domain::{eoie_toolchain_execution_gate as EG,eoie_toolchain_observed_outcome as OO,eoie_toolchain_receipt_catalog as Catalog};\nuse toolchain_argument_domain::{eoie_toolchain_argument_count as AC,eoie_toolchain_argument_token_chunk as TC,eoie_toolchain_argument_token_low as TL};\nuse toolchain_argument_tail_domain::eoie_toolchain_argument_token_high as TH;\nuse std::{env,fs,path::{Path,PathBuf},process::Command};\n#[derive(Clone,Debug,Eq,PartialEq)]\nstruct ToolchainReceipt{action:i32,checkpoint:i32,outcome:i32,status:i32,elapsed_ms:u64,attempt:u32,command_hash:u64,toolchain_hash:u64,target_hash:u64,profile:i32}\nfn req<'a>(a:&'a[String],i:usize,n:&str)->Result<&'a str,String>{a.get(i).map(String::as_str).ok_or_else(||format!(\"missing {n}\"))}\nfn prog(t:&Path,k:i32)->Result<PathBuf,String>{let label=receipt_label(\"program\",k)?;if label==\"self\"{return Ok(t.to_path_buf())}let p=t.parent().ok_or_else(||format!(\"no parent: {}\",t.display()))?.join(if cfg!(windows) { format!(\"{label}.exe\") } else { label });p.is_file().then_some(p.clone()).ok_or_else(||format!(\"missing tool: {}\",p.display()))}\nfn word(c:i32)->Result<String,String>{let mut s=String::new();for i in 0..3{let mut x=TC(c,i);if x<0{return Err(format!(\"unknown token: {c}\"))}for _ in 0..6{let n=x&31;x>>=5;match n{0..=25=>s.push((b'a'+n as u8)as char),26=>s.push('-'),27=>s.push('D'),31=>return Ok(s),_=>return Err(format!(\"bad token symbol: {n}\"))}}}Err(format!(\"unterminated token: {c}\"))}\nfn args(c:&mut Command,a:i32)->Result<(),String>{let n=AC(a,0);if n<0{return Err(format!(\"bad argument count: {a}\"))}for p in 0..n{let l=TL(a,p);let x=if l>=0{l}else{TH(a,p)};if x<0{return Err(format!(\"bad argument: {a}/{p}\"))}c.arg(word(x)?);}Ok(())}\nfn envs(c:&mut Command,t:&Path,a:i32)->Result<(),String>{let n=EC(a,0);if n<0{return Err(format!(\"bad environment: {a}\"))}for i in 0..n{let e=EE(a,i);if e<0{return Err(format!(\"bad environment entry: {a}/{i}\"))}let k=receipt_label(\"env-key\",e&15)?;let k=k.as_str();let m=e>>4;let mode=receipt_label(\"env-mode\",m)?;match mode.as_str(){\"remove\"=>{c.env_remove(k);},\"tool\"=>{c.env(k,t);},\"never\"=>{c.env(k,\"never\");},\"sibling-rustc\"|\"sibling-rustdoc\"=>{if let Some(d)=t.parent(){let sibling=mode.strip_prefix(\"sibling-\").unwrap_or_default();let p=d.join(if cfg!(windows) { format!(\"{sibling}.exe\") } else { sibling.to_owned() });if p.is_file(){c.env(k,p);}}},\"require-current\"=>{c.env(k,env::var_os(k).ok_or_else(||format!(\"{k} required\"))?);},\"inherit-current\"=>{if let Some(v)=env::var_os(k){c.env(k,v);}},_=>return Err(format!(\"bad environment mode: {mode}\"))}}Ok(())}\nfn catalog_value(key:&str)->Result<String,String>{let prefix=format!(\"{key}=\");let catalog=Catalog(\"v1\");catalog.as_ref().lines().find_map(|line|line.strip_prefix(&prefix)).map(str::to_owned).ok_or_else(||format!(\"unknown toolchain catalog key: {key}\"))}\nfn receipt_label(kind:&str,x:i32)->Result<String,String>{catalog_value(&format!(\"{kind}:{x}\"))}\nfn outcome_ctor(r:&ToolchainReceipt)->Result<String,String>{let base=receipt_label(\"outcome\",r.outcome)?;let payload=receipt_label(\"outcome-payload\",r.outcome)?;match payload.as_str(){\"none\"=>Ok(base),\"status\"=>Ok(format!(\"{base} {}i32\",r.status)),\"elapsed\"=>Ok(format!(\"{base} {}u64\",r.elapsed_ms)),_=>Err(format!(\"unknown outcome payload: {payload}\"))}}\nfn receipt_text(r:&ToolchainReceipt)->Result<String,String>{let marker=catalog_value(\"receipt-marker\")?;Ok(format!(\"open core\\n{marker}{}|{}|{}|{}|{}|{}|{}|{}|{}|{}\\ninl current_toolchain_process_receipt () : toolchain_process_receipt =\\n    ToolchainProcessReceipt ({}, {}, {}, {}u64, {}u32, ToolchainProcessIdentity ({}u64, {}u64, {}u64, {}))\\ninl main () : i32 = 0i32\\n\",receipt_label(\"action-name\",r.action)?,r.checkpoint,r.outcome,r.status,r.elapsed_ms,r.attempt,r.command_hash,r.toolchain_hash,r.target_hash,r.profile,receipt_label(\"action-ctor\",r.action)?,receipt_label(\"checkpoint\",r.checkpoint)?,outcome_ctor(r)?,r.elapsed_ms,r.attempt,r.command_hash,r.toolchain_hash,r.target_hash,receipt_label(\"profile\",r.profile)?))}\nfn parsed_u64(text:&str,error:&str)->Result<u64,String>{if eoie_toolchain_u64_decimal_valid(text)!=1{return Err(error.to_owned())}Ok(eoie_toolchain_u64_decimal_value(text))}\nfn parsed_u32(text:&str,error:&str)->Result<u32,String>{if eoie_toolchain_u32_decimal_valid(text)!=1{return Err(error.to_owned())}Ok(eoie_toolchain_u64_decimal_value(text) as u32)}\nfn parsed_i32(text:&str,error:&str)->Result<i32,String>{let code=eoie_toolchain_i32_decimal_code(text);if code==0{return Err(error.to_owned())}if code<=2147483648{return Ok((code-1)as i32)}let magnitude=code-2147483649;Ok(-(magnitude as i64)as i32)}\nfn parse_receipt(text:&str)->Result<ToolchainReceipt,String>{let marker=catalog_value(\"receipt-marker\")?;let line=text.lines().find_map(|line|line.strip_prefix(&marker)).ok_or_else(||\"toolchain receipt marker missing\".to_owned())?;let p=line.split('|').collect::<Vec<_>>();if p.len()!=10{return Err(\"toolchain receipt marker arity mismatch\".to_owned())}Ok(ToolchainReceipt{action:{let code=AN(p[0]);if code<=7{code as i32}else{return Err(format!(\"unknown receipt action: {}\",p[0]))}},checkpoint:parsed_i32(p[1],\"invalid checkpoint\")?,outcome:parsed_i32(p[2],\"invalid outcome\")?,status:parsed_i32(p[3],\"invalid status\")?,elapsed_ms:parsed_u64(p[4],\"invalid elapsed\")?,attempt:parsed_u32(p[5],\"invalid attempt\")?,command_hash:parsed_u64(p[6],\"invalid command hash\")?,toolchain_hash:parsed_u64(p[7],\"invalid toolchain hash\")?,target_hash:parsed_u64(p[8],\"invalid target hash\")?,profile:parsed_i32(p[9],\"invalid profile\")?})}\nfn bundle_root(root:&Path)->Option<PathBuf>{let marker=catalog_value(\"bundle-state-marker\").ok()?;if root.join(&marker).is_file(){Some(root.to_path_buf())}else{root.parent().filter(|p|p.join(&marker).is_file()).map(Path::to_path_buf)}}\nfn fnv_mix(hash:&mut u64,bytes:&[u8]){for byte in bytes{*hash^=u64::from(*byte);*hash=hash.wrapping_mul(1099511628211)}}\nfn identity_visit(root:&Path,path:&Path,hash:&mut u64)->Result<(),String>{let metadata=fs::symlink_metadata(path).map_err(|e|format!(\"metadata {}: {e}\",path.display()))?;if metadata.file_type().is_symlink(){return Ok(())}if metadata.is_dir(){if path!=root{let name=path.file_name().and_then(|v|v.to_str()).unwrap_or_default();if catalog_value(\"identity-exclude-dirs\")?.split(',').any(|item|item==name){return Ok(())}}let mut entries=fs::read_dir(path).map_err(|e|format!(\"read {}: {e}\",path.display()))?.map(|e|e.map(|e|e.path()).map_err(|e|e.to_string())).collect::<Result<Vec<_>,_>>()?;entries.sort();for entry in entries{identity_visit(root,&entry,hash)?;}return Ok(())}if metadata.is_file(){let name=path.file_name().and_then(|v|v.to_str()).unwrap_or_default();let ext=path.extension().and_then(|v|v.to_str()).unwrap_or_default();if catalog_value(\"identity-file-names\")?.split(',').any(|item|item==name)||catalog_value(\"identity-exts\")?.split(',').any(|item|item==ext){let relative=path.strip_prefix(root).map_err(|e|e.to_string())?.to_string_lossy().replace('\\\\',\"/\");fnv_mix(hash,relative.as_bytes());fnv_mix(hash,&fs::read(path).map_err(|e|format!(\"read {}: {e}\",path.display()))?);}}Ok(())}\nfn hash_file_if(root:&Path,path:&Path,hash:&mut u64)->Result<(),String>{if path.is_file(){let relative=path.strip_prefix(root).map_err(|e|e.to_string())?.to_string_lossy().replace('\\\\',\"/\");fnv_mix(hash,relative.as_bytes());fnv_mix(hash,&fs::read(path).map_err(|e|format!(\"read {}: {e}\",path.display()))?);}Ok(())}\nfn toolchain_identity(root:&Path,tool:&Path,action:i32)->Result<(u64,u64,u64,i32),String>{let profile=RP(action,0);if profile<0{return Err(format!(\"bad resume profile: {action}\"))}let mut command_hash=14695981039346656037u64;fnv_mix(&mut command_hash,receipt_label(\"action-name\",action)?.as_bytes());fnv_mix(&mut command_hash,&profile.to_le_bytes());for index in 0..8{let key=receipt_label(\"env-key\",index)?;if let Some(value)=env::var_os(&key){fnv_mix(&mut command_hash,key.as_bytes());fnv_mix(&mut command_hash,value.to_string_lossy().as_bytes());}}let root_marker=catalog_value(\"identity-root-marker\")?;let root_fallback=catalog_value(\"identity-root-fallback\")?;let source_root=if root.join(&root_marker).is_file(){root.to_path_buf()}else{root.join(root_fallback)};if source_root.is_dir(){identity_visit(&source_root,&source_root,&mut command_hash)?;}for relative in catalog_value(\"identity-hash-files\")?.split(','){hash_file_if(&source_root,&source_root.join(relative),&mut command_hash)?;}let mut toolchain_hash=14695981039346656037u64;fnv_mix(&mut toolchain_hash,tool.to_string_lossy().as_bytes());let metadata=fs::metadata(tool).map_err(|e|format!(\"metadata {}: {e}\",tool.display()))?;fnv_mix(&mut toolchain_hash,&metadata.len().to_le_bytes());fnv_mix(&mut toolchain_hash,format!(\"{:?}\",metadata.modified().ok()).as_bytes());let target_key=receipt_label(\"env-key\",8)?;let target_fallback=catalog_value(\"identity-target-fallback\")?;let target=env::var_os(&target_key).map(PathBuf::from).unwrap_or_else(||root.join(target_fallback));let mut target_hash=14695981039346656037u64;fnv_mix(&mut target_hash,target.to_string_lossy().as_bytes());Ok((command_hash,toolchain_hash,target_hash,profile))}\nfn atomic_write(path:&Path,bytes:&[u8])->Result<(),String>{let parent=path.parent().ok_or_else(||format!(\"no parent: {}\",path.display()))?;fs::create_dir_all(parent).map_err(|e|format!(\"create {}: {e}\",parent.display()))?;let prefix=catalog_value(\"receipt-stage-prefix\")?;let stage=parent.join(format!(\"{prefix}{}\",std::process::id()));fs::write(&stage,bytes).map_err(|e|format!(\"write {}: {e}\",stage.display()))?;fs::rename(&stage,path).map_err(|e|format!(\"commit {}: {e}\",path.display()))}\nfn persist_receipt(path:&Path,r:&ToolchainReceipt)->Result<(),String>{let previous=fs::read(path).ok();let expected=receipt_text(r)?;atomic_write(path,expected.as_bytes())?;let verified=load_receipt(path).and_then(|observed|observed.ok_or_else(||\"toolchain receipt disappeared after write\".to_owned())).and_then(|observed|if observed==*r{Ok(())}else{Err(\"toolchain receipt runtime readback mismatch\".to_owned())});if let Err(error)=verified{match previous{Some(bytes)=>{let _=atomic_write(path,&bytes);},None=>{let _=fs::remove_file(path);}}return Err(error)}Ok(())}\nfn load_receipt(path:&Path)->Result<Option<ToolchainReceipt>,String>{match fs::read_to_string(path){Ok(text)=>parse_receipt(&text).map(Some),Err(error)if error.kind()==std::io::ErrorKind::NotFound=>Ok(None),Err(error)=>Err(format!(\"read {}: {error}\",path.display()))}}\nfn transition(path:&Path,r:&mut ToolchainReceipt,event:i32,outcome:i32,status:i32,elapsed_ms:u64)->Result<(),String>{if eoie_batch_plan_accept(r.checkpoint,event)!=1{return Err(format!(\"batch plan rejected checkpoint={} event={event}\",r.checkpoint))}let next=eoie_batch_plan_advance(r.checkpoint,event);if next<0{return Err(\"batch plan advance failed\".to_owned())}r.checkpoint=next;r.outcome=outcome;r.status=status;r.elapsed_ms=elapsed_ms;persist_receipt(path,r)}\nfn injected(phase:&str)->Result<(),String>{if env::var(\"EOIE_TOOLCHAIN_FAIL_AFTER\").ok().as_deref()==Some(phase){Err(format!(\"injected toolchain failure after {phase}\"))}else{Ok(())}}\n"

inl emit_runtime_run () : () = rust_global "fn finish_toolchain(label:&str,root:&Path,r:&ToolchainReceipt,resumed:bool,executed:bool)->Result<(),String>{match r.outcome{1=>{println!(\"eoie proxy toolchain ok plan={label} root={} checkpoint={} elapsed_ms={} resumed={resumed} executed={executed} receipt=state/toolchain_process_receipt.spi\",root.display(),r.checkpoint,r.elapsed_ms);Ok(())},2=>Err(format!(\"{label} failed status={} resumed={resumed} executed={executed}\",r.status)),3=>Err(format!(\"{label} timed out after {} ms resumed={resumed} executed={executed}\",r.elapsed_ms)),_=>Err(\"toolchain receipt is incomplete\".to_owned())}}\nfn classify(observation:&ProcessObservation)->Result<(i32,i32,u64),String>{let timed_out=i32::from(observation.termination==ProcessTermination::TimedOut);let success=i32::from(observation.status.success());let outcome=OO(timed_out,success);if outcome<0{return Err(format!(\"Spiral outcome policy rejected timed_out={timed_out} success={success}\"))}let status=if timed_out==1{-1}else{observation.status.code().unwrap_or(-1)};Ok((outcome,status,observation.elapsed_ms))}\nfn resumable_toolchain(root:&Path,tool:&Path,action:i32,label:&str,timeout_ms:u64,command:&mut Command)->Result<(),String>{let Some(bundle)=bundle_root(root)else{let observation=run_bounded_streaming_checked(command,timeout_ms,label,None)?;println!(\"eoie proxy toolchain ok action={} root={} elapsed_ms={} receipts=unavailable\",receipt_label(\"action-name\",action)?,root.display(),observation.elapsed_ms);return Ok(())};let(command_hash,toolchain_hash,target_hash,profile)=toolchain_identity(root,tool,action)?;let receipt_path=catalog_value(\"receipt-path\")?;let path=bundle.join(receipt_path);let existing=load_receipt(&path)?;let mut receipt=existing.filter(|r|r.action==action&&r.command_hash==command_hash&&r.toolchain_hash==toolchain_hash&&r.target_hash==target_hash&&r.profile==profile).unwrap_or(ToolchainReceipt{action,checkpoint:0,outcome:0,status:0,elapsed_ms:0,attempt:0,command_hash,toolchain_hash,target_hash,profile});let resumed=receipt.checkpoint>0;if receipt.checkpoint==5{return finish_toolchain(label,root,&receipt,true,false)}if RR(receipt.checkpoint,receipt.outcome)==1{receipt.checkpoint=1;receipt.outcome=0;receipt.status=0;receipt.attempt=receipt.attempt.saturating_add(1);persist_receipt(&path,&receipt)?;injected(\"retry\")?;}else if receipt.checkpoint==4{return Err(\"non-retryable toolchain timeout receipt\".to_owned())}if receipt.checkpoint==0{receipt.attempt=1;let elapsed=receipt.elapsed_ms;transition(&path,&mut receipt,0,0,0,elapsed)?;injected(\"spawn\")?;}let mut executed=false;if EG(receipt.checkpoint,0)==1{let observation=run_bounded_streaming_receipted_observed(command,timeout_ms,label,None)?;let(outcome,status,elapsed)=classify(&observation)?;let total=receipt.elapsed_ms.saturating_add(elapsed);transition(&path,&mut receipt,1,outcome,status,total)?;executed=true;injected(\"run\")?;}if receipt.checkpoint==2{let(outcome,status,elapsed)=(receipt.outcome,receipt.status,receipt.elapsed_ms);if outcome==3{transition(&path,&mut receipt,3,outcome,status,elapsed)?;injected(\"timeout\")?;return finish_toolchain(label,root,&receipt,resumed,executed)}transition(&path,&mut receipt,2,outcome,status,elapsed)?;injected(\"link\")?;}if receipt.checkpoint==3{let(outcome,status,elapsed)=(receipt.outcome,receipt.status,receipt.elapsed_ms);transition(&path,&mut receipt,4,outcome,status,elapsed)?;}finish_toolchain(label,root,&receipt,resumed,executed)}\npub fn toolchain_run(a:&[String])->Result<(),String>{if a.len()!=5{return Err(\"toolchain expects root tool action timeout-ms\".to_owned())}let root=Path::new(req(a,1,\"root\")?);if!root.is_dir(){return Err(format!(\"invalid root: {}\",root.display()))}let tool=Path::new(req(a,2,\"tool\")?);if!tool.is_file(){return Err(format!(\"invalid tool: {}\",tool.display()))}let raw=req(a,3,\"action\")?;if canonical_plan_ir_domain::eoie_plan_ir_decode_code(\"toolchain\",raw,\"-\",\"-\",\"toolchain\")!=4{return Err(\"canonical Plan IR toolchain decode mismatch\".to_owned())}let text=raw.to_owned();let action_code=AN(raw);if action_code>7{return Err(format!(\"unknown toolchain action: {text}\"))}let x=action_code as i32;let ms=parsed_u64(req(a,4,\"timeout-ms\")?,\"timeout-ms must be integer\")?;if ms==0{return Err(\"timeout-ms must be positive\".to_owned())}let p=EP(x,0);if p<0{return Err(format!(\"bad execution plan: {x}\"))}let pk=p%4;let tk=(p/16)%2;let sk=(p/32)%2;if tk!=0||sk!=0{return Err(\"unsupported execution policy\".to_owned())}let mut c=Command::new(prog(tool,pk)?);args(&mut c,x)?;envs(&mut c,tool,x)?;let root_manifest=i32::from(root.join(\"Cargo.toml\").is_file());let nested_manifest=i32::from(root.join(\"src/Cargo.toml\").is_file());let manifest_code=root_manifest|(nested_manifest<<1);let cwd_code=eoie_toolchain_cwd(x,manifest_code);let cwd=match cwd_code{0=>root.to_path_buf(),1=>root.join(\"src\"),_=>return Err(format!(\"toolchain cargo workspace missing under {}\",root.display()))};c.current_dir(&cwd);let label=format!(\"toolchain-{text}\");resumable_toolchain(root,tool,x,&label,ms,&mut c)}\n#[cfg(test)]\nmod resumable_tests{use super::*;#[test]fn receipt_marker_roundtrips(){let receipt=ToolchainReceipt{action:2,checkpoint:3,outcome:1,status:0,elapsed_ms:7,attempt:2,command_hash:11,toolchain_hash:12,target_hash:13,profile:1};assert_eq!(parse_receipt(&receipt_text(&receipt).expect(\"render\")).expect(\"parse\"),receipt);}#[test]fn typed_numeric_parser_preserves_bounds(){assert_eq!(parsed_u64(\"0\",\"x\").expect(\"zero\"),0);assert_eq!(parsed_u64(\"+42\",\"x\").expect(\"plus\"),42);assert!(parsed_u64(\"-1\",\"x\").is_err());assert!(parsed_u64(\"18446744073709551616\",\"x\").is_err());assert_eq!(parsed_u32(\"4294967295\",\"x\").expect(\"u32 max\"),u32::MAX);assert!(parsed_u32(\"4294967296\",\"x\").is_err());assert_eq!(parsed_i32(\"-2147483648\",\"x\").expect(\"i32 min\"),i32::MIN);assert_eq!(parsed_i32(\"+2147483647\",\"x\").expect(\"i32 max\"),i32::MAX);assert!(parsed_i32(\"2147483648\",\"x\").is_err());assert!(parsed_i32(\"-2147483649\",\"x\").is_err());}#[test]fn run_checkpoint_is_not_executed_twice(){assert_eq!(EG(1,0),1);assert_eq!(EG(2,0),0);assert_eq!(EG(3,0),0);assert_eq!(EG(4,0),0);assert_eq!(EG(5,0),0);}#[test]fn shared_batch_plan_controls_phases(){assert_eq!(eoie_batch_plan_advance(0,0),1);assert_eq!(eoie_batch_plan_advance(1,1),2);assert_eq!(eoie_batch_plan_advance(2,2),3);assert_eq!(eoie_batch_plan_advance(3,4),5);assert_eq!(eoie_batch_plan_advance(0,2),-1);}#[test]fn resume_policy_is_spiral_owned(){assert_eq!(RR(4,3),1);assert_eq!(RR(4,1),0);}#[test]fn release_argument_is_compiled(){assert_eq!(word(13).expect(\"release token\"),\"--release\");}}\n"

inl emit_portable_runtime () : () = rust_global "use eoie_proxy_search::inspection_file_sha256 as portable_sha256;\nfn portable_quoted(line:&str)->Vec<String>{line.split('\\\"').skip(1).step_by(2).map(str::to_owned).collect()}\nfn portable_u64(line:&str)->Result<u64,String>{let marker=line.find(\"u64\").ok_or_else(||\"portable identity bytes missing\".to_owned())?;let prefix=&line[..marker];let digits=prefix.chars().rev().skip_while(|c|c.is_whitespace()).take_while(|c|c.is_ascii_digit()).collect::<String>();if digits.is_empty(){return Err(\"portable identity bytes missing\".to_owned())}parsed_u64(&digits.chars().rev().collect::<String>(),\"portable identity bytes invalid\")}\nfn portable_evidence(source:&str,name:&str)->Result<(String,u64),String>{let needle=format!(\"EvidenceRef (\\\"{name}\\\"\");let line=source.lines().find(|line|line.contains(&needle)).ok_or_else(||format!(\"portable tool identity missing: {name}\"))?;let fields=portable_quoted(line);if fields.len()<2{return Err(format!(\"portable tool identity malformed: {name}\"))}Ok((fields[1].to_ascii_lowercase(),portable_u64(line)?))}\nfn portable_payload(source:&str,ctor:&str)->Result<(String,String,u64),String>{let needle=format!(\"PortablePayload ({ctor},\");let line=source.lines().find(|line|line.contains(&needle)).ok_or_else(||format!(\"portable payload identity missing: {ctor}\"))?;let fields=portable_quoted(line);if fields.len()!=2{return Err(format!(\"portable payload identity malformed: {ctor}\"))}Ok((fields[0].clone(),fields[1].to_ascii_lowercase(),portable_u64(line)?))}\nfn portable_dotnet(source:&str)->Result<(String,u64),String>{let line=source.lines().find(|line|line.contains(\"inl dotnet_host_gate ()\")).ok_or_else(||\"portable dotnet host gate missing\".to_owned())?;let fields=portable_quoted(line);if fields.len()!=1{return Err(\"portable dotnet host gate malformed\".to_owned())}Ok((fields[0].to_ascii_lowercase(),portable_u64(line)?))}\nfn portable_match(path:&Path,sha:&str,bytes:u64)->Result<i32,String>{let metadata=match fs::symlink_metadata(path){Ok(value)=>value,Err(error)if error.kind()==std::io::ErrorKind::NotFound=>return Ok(0),Err(error)=>return Err(format!(\"metadata {}: {error}\",path.display()))};if metadata.file_type().is_symlink()||!metadata.is_file(){return Ok(0)}if metadata.len()!=bytes{return Ok(1)}Ok(if portable_sha256(path)?==sha{2}else{1})}\nfn portable_check(path:&Path,sha:&str,bytes:u64,missing:&mut Vec<String>,mismatch:&mut Vec<String>)->Result<(),String>{match portable_match(path,sha,bytes)?{0=>missing.push(path.display().to_string()),1=>mismatch.push(path.display().to_string()),2=>{},_=>return Err(\"portable identity classifier escaped range\".to_owned())}Ok(())}\npub fn portable_toolchain_run(a:&[String])->Result<(),String>{if a.len()!=6{return Err(\"portable-toolchain expects bundle-root payload-root rust-root spiral-root dotnet-root\".to_owned())}let bundle=Path::new(req(a,1,\"bundle-root\")?);let payload_root=Path::new(req(a,2,\"payload-root\")?);let rust_root=Path::new(req(a,3,\"rust-root\")?);let spiral_root=Path::new(req(a,4,\"spiral-root\")?);let dotnet_root=Path::new(req(a,5,\"dotnet-root\")?);if!bundle.is_dir(){return Err(format!(\"portable bundle root missing: {}\",bundle.display()))}let identity=fs::read_to_string(bundle.join(\"state/toolchain_identity.spi\")).map_err(|e|format!(\"portable toolchain identity: {e}\"))?;let receipt=fs::read_to_string(bundle.join(\"state/portable_toolchain.spi\")).map_err(|e|format!(\"portable toolchain receipt: {e}\"))?;let mut missing=Vec::new();let mut mismatch=Vec::new();for ctor in[\"PortableRustPayload\",\"PortableSpiralPayload\",\"PortableDotnetPayload\"]{let(name,sha,bytes)=portable_payload(&receipt,ctor)?;portable_check(&payload_root.join(name),&sha,bytes,&mut missing,&mut mismatch)?;}for(name,path)in[(\"rustc\",rust_root.join(\"bin/rustc\")),(\"cargo\",rust_root.join(\"bin/cargo\")),(\"rustdoc\",rust_root.join(\"bin/rustdoc\")),(\"rustfmt\",rust_root.join(\"bin/rustfmt\")),(\"spiral-compile\",spiral_root.join(\"bin/spiral-compile\")),(\"SpiralCompilerFacadeCli.dll\",spiral_root.join(\"source/facade/bin/linux/amd64/Release/net11.0/SpiralCompilerFacadeCli.dll\"))]{let(sha,bytes)=portable_evidence(&identity,name)?;portable_check(&path,&sha,bytes,&mut missing,&mut mismatch)?;}let(dotnet_sha,dotnet_bytes)=portable_dotnet(&receipt)?;portable_check(&dotnet_root.join(\"dotnet\"),&dotnet_sha,dotnet_bytes,&mut missing,&mut mismatch)?;if!missing.is_empty(){return Err(format!(\"portable toolchain status=missing paths={missing:?}\"))}if!mismatch.is_empty(){return Err(format!(\"portable toolchain status=mismatch paths={mismatch:?}\"))}println!(\"eoie proxy portable-toolchain ok status=ready payloads=3 tools=7 roots=2 bundle={}\",bundle.display());Ok(())}"

inl emit_portable_tests () : () = rust_global "#[cfg(test)]\nmod portable_toolchain_tests{use super::*;\nfn write(path:&Path,bytes:&[u8]){if let Some(parent)=path.parent(){fs::create_dir_all(parent).expect(\"mkdir\");}fs::write(path,bytes).expect(\"write\");}\nfn identity_line(name:&str,path:&Path)->String{format!(\"inl x () = EvidenceRef (\\\"{}\\\", \\\"{}\\\", {}u64, BinaryMedia, ExternalRequired)\\n\",name,portable_sha256(path).expect(\"sha\"),fs::metadata(path).expect(\"meta\").len())}\n#[test]fn portable_resolver_distinguishes_ready_missing_and_mismatch(){let root=env::temp_dir().join(format!(\"eoie-portable-toolchain-{}\",std::process::id()));let _=fs::remove_dir_all(&root);let bundle=root.join(\"bundle\");let payload=root.join(\"payload\");let rust=root.join(\"rust\");let spiral=root.join(\"spiral\");let dotnet=root.join(\"dotnet\");for(name,body)in[(\"rust-nightly-x86_64-unknown-linux-gnu.tar.xz\",b\"rust-payload\".as_slice()),(\"bundle_spiral-bin_v200_eoie.zip\",b\"spiral-payload\".as_slice()),(\"dotnet-sdk-linux-x64.tar.gz\",b\"dotnet-payload\".as_slice())]{write(&payload.join(name),body);}for name in[\"rustc\",\"cargo\",\"rustdoc\",\"rustfmt\"]{write(&rust.join(\"bin\").join(name),name.as_bytes());}write(&spiral.join(\"bin/spiral-compile\"),b\"spiral-entry\");write(&spiral.join(\"source/facade/bin/linux/amd64/Release/net11.0/SpiralCompilerFacadeCli.dll\"),b\"spiral-facade\");write(&dotnet.join(\"dotnet\"),b\"dotnet-host\");let mut identity=String::new();for(name,path)in[(\"rustc\",rust.join(\"bin/rustc\")),(\"cargo\",rust.join(\"bin/cargo\")),(\"rustdoc\",rust.join(\"bin/rustdoc\")),(\"rustfmt\",rust.join(\"bin/rustfmt\")),(\"spiral-compile\",spiral.join(\"bin/spiral-compile\")),(\"SpiralCompilerFacadeCli.dll\",spiral.join(\"source/facade/bin/linux/amd64/Release/net11.0/SpiralCompilerFacadeCli.dll\"))]{identity.push_str(&identity_line(name,&path));}write(&bundle.join(\"state/toolchain_identity.spi\"),identity.as_bytes());let mut receipt=String::new();for(ctor,name)in[(\"PortableRustPayload\",\"rust-nightly-x86_64-unknown-linux-gnu.tar.xz\"),(\"PortableSpiralPayload\",\"bundle_spiral-bin_v200_eoie.zip\"),(\"PortableDotnetPayload\",\"dotnet-sdk-linux-x64.tar.gz\")]{let path=payload.join(name);receipt.push_str(&format!(\"inl p () = PortablePayload ({ctor}, \\\"{name}\\\", \\\"{}\\\", {}u64)\\n\",portable_sha256(&path).expect(\"sha\"),fs::metadata(&path).expect(\"meta\").len()));}let host=dotnet.join(\"dotnet\");receipt.push_str(&format!(\"inl dotnet_host_gate () = \\\"{}\\\", {}u64\\n\",portable_sha256(&host).expect(\"sha\"),fs::metadata(&host).expect(\"meta\").len()));write(&bundle.join(\"state/portable_toolchain.spi\"),receipt.as_bytes());let args=vec![\"portable-toolchain\".to_owned(),bundle.to_string_lossy().into_owned(),payload.to_string_lossy().into_owned(),rust.to_string_lossy().into_owned(),spiral.to_string_lossy().into_owned(),dotnet.to_string_lossy().into_owned()];portable_toolchain_run(&args).expect(\"ready\");write(&host,b\"wrong-dotnet\");assert!(portable_toolchain_run(&args).expect_err(\"mismatch\").contains(\"status=mismatch\"));write(&host,b\"dotnet-host\");fs::remove_file(payload.join(\"rust-nightly-x86_64-unknown-linux-gnu.tar.xz\")).expect(\"remove\");assert!(portable_toolchain_run(&args).expect_err(\"missing\").contains(\"status=missing\"));let _=fs::remove_dir_all(&root);}\n}\n"

inl emit_runtime () : () =
    emit_runtime_core ()
    emit_runtime_run ()
    emit_portable_runtime ()
