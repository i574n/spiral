nominal external_payload_empty = ()
nominal external_payload_identified = ()
nominal external_payload_cache_selected = ()
nominal external_payload_staged = ()
nominal external_payload_verified = ()
nominal external_payload_promoted = ()

union external_payload_op from to =
    | IdentifyExternalPayload :: external_payload_op external_payload_empty external_payload_identified
    | SelectExternalPayloadCache :: external_payload_op external_payload_identified external_payload_cache_selected
    | StageExternalPayload :: external_payload_op external_payload_cache_selected external_payload_staged
    | VerifyExternalPayloadStage :: external_payload_op external_payload_staged external_payload_verified
    | PromoteExternalPayload :: external_payload_op external_payload_verified external_payload_promoted

union rec external_payload_plan from to =
    | ExternalPayloadStep :: forall from to. external_payload_op from to -> external_payload_plan from to
    | ExternalPayloadThen :: forall from to. (exists middle. external_payload_plan from middle * external_payload_plan middle to) -> external_payload_plan from to

inl external_payload_hydrate_plan () : external_payload_plan external_payload_empty external_payload_promoted =
    ExternalPayloadThen (exists (
        ExternalPayloadStep IdentifyExternalPayload,
        ExternalPayloadThen (exists (
            ExternalPayloadStep SelectExternalPayloadCache,
            ExternalPayloadThen (exists (
                ExternalPayloadStep StageExternalPayload,
                ExternalPayloadThen (exists (
                    ExternalPayloadStep VerifyExternalPayloadStage,
                    ExternalPayloadStep PromoteExternalPayload
                ))
            ))
        ))
    ))

let external_payload_scope_binding (payload_safe : i32) (cache_safe : i32) (receipt_safe : i32) (paths_separated : i32) : i32 =
    if !!!!LT(payload_safe,1i32) then 0i32
    elif !!!!LT(1i32,payload_safe) then 0i32
    elif !!!!LT(cache_safe,1i32) then 0i32
    elif !!!!LT(1i32,cache_safe) then 0i32
    elif !!!!LT(receipt_safe,1i32) then 0i32
    elif !!!!LT(1i32,receipt_safe) then 0i32
    elif !!!!LT(paths_separated,1i32) then 0i32
    elif !!!!LT(1i32,paths_separated) then 0i32
    else 1i32

let external_payload_identity_binding (receipt_match : i32) (expected_bytes_positive : i32) (hash_shape_ok : i32) : i32 =
    if !!!!LT(receipt_match,1i32) then 0i32
    elif !!!!LT(1i32,receipt_match) then 0i32
    elif !!!!LT(expected_bytes_positive,1i32) then 0i32
    elif !!!!LT(1i32,expected_bytes_positive) then 0i32
    elif !!!!LT(hash_shape_ok,1i32) then 0i32
    elif !!!!LT(1i32,hash_shape_ok) then 0i32
    else 1i32

let external_payload_hydrate_binding (payload_present : i32) (cache_present : i32) (payload_match : i32) (cache_match : i32) : i32 =
    if !!!!LT(payload_present,0i32) then 0i32
    elif !!!!LT(1i32,payload_present) then 0i32
    elif !!!!LT(cache_present,0i32) then 0i32
    elif !!!!LT(1i32,cache_present) then 0i32
    elif !!!!LT(payload_match,0i32) then 0i32
    elif !!!!LT(1i32,payload_match) then 0i32
    elif !!!!LT(cache_match,0i32) then 0i32
    elif !!!!LT(1i32,cache_match) then 0i32
    elif !!!!LT(payload_present,1i32) then
        if !!!!LT(cache_present,1i32) then 0i32 else cache_match
    else payload_match

let external_payload_dehydrate_binding (payload_present : i32) (payload_match : i32) (cache_present : i32) (cache_match : i32) : i32 =
    if !!!!LT(payload_present,0i32) then 0i32
    elif !!!!LT(1i32,payload_present) then 0i32
    elif !!!!LT(payload_match,0i32) then 0i32
    elif !!!!LT(1i32,payload_match) then 0i32
    elif !!!!LT(cache_present,0i32) then 0i32
    elif !!!!LT(1i32,cache_present) then 0i32
    elif !!!!LT(cache_match,0i32) then 0i32
    elif !!!!LT(1i32,cache_match) then 0i32
    elif !!!!LT(payload_present,1i32) then 1i32
    elif !!!!LT(payload_match,1i32) then 0i32
    elif !!!!LT(cache_present,1i32) then 1i32
    else cache_match

let external_payload_stage_binding (cache_match : i32) (stage_absent : i32) (stage_match : i32) : i32 =
    if !!!!LT(cache_match,1i32) then 0i32
    elif !!!!LT(1i32,cache_match) then 0i32
    elif !!!!LT(stage_absent,1i32) then 0i32
    elif !!!!LT(1i32,stage_absent) then 0i32
    elif !!!!LT(stage_match,1i32) then 0i32
    elif !!!!LT(1i32,stage_match) then 0i32
    else 1i32

let external_payload_completion_binding (expected_match : i32) (other_copy_verified : i32) (cleanup_ok : i32) : i32 =
    if !!!!LT(expected_match,1i32) then 0i32
    elif !!!!LT(1i32,expected_match) then 0i32
    elif !!!!LT(other_copy_verified,1i32) then 0i32
    elif !!!!LT(1i32,other_copy_verified) then 0i32
    elif !!!!LT(cleanup_ok,1i32) then 0i32
    elif !!!!LT(1i32,cleanup_ok) then 0i32
    else 1i32

let external_payload_scope_mask_binding (mask : i32) (witness : i32) : i32 =
    if !!!!LT(mask,15i32) then 0i32 elif !!!!LT(15i32,mask) then 0i32 elif !!!!LT(witness,0i32) then 0i32 elif !!!!LT(0i32,witness) then 0i32 else 1i32

let external_payload_identity_mask_binding (mask : i32) (witness : i32) : i32 =
    if !!!!LT(mask,7i32) then 0i32 elif !!!!LT(7i32,mask) then 0i32 elif !!!!LT(witness,0i32) then 0i32 elif !!!!LT(0i32,witness) then 0i32 else 1i32

let external_payload_stage_mask_binding (mask : i32) (witness : i32) : i32 =
    if !!!!LT(mask,7i32) then 0i32 elif !!!!LT(7i32,mask) then 0i32 elif !!!!LT(witness,0i32) then 0i32 elif !!!!LT(0i32,witness) then 0i32 else 1i32

let external_payload_completion_mask_binding (mask : i32) (witness : i32) : i32 =
    if !!!!LT(mask,7i32) then 0i32 elif !!!!LT(7i32,mask) then 0i32 elif !!!!LT(witness,0i32) then 0i32 elif !!!!LT(0i32,witness) then 0i32 else 1i32
