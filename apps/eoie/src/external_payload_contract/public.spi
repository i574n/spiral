let external_payload_public_mask_binding (scope : i32) (mask : i32) : i32 =
    if !!!!LT(scope,0i32) then 0i32
    elif !!!!LT(1i32,scope) then 0i32
    elif !!!!LT(scope,1i32) then
        if !!!!LT(mask,7i32) then 0i32 elif !!!!LT(7i32,mask) then 0i32 else 1i32
    else
        if !!!!LT(mask,15i32) then 0i32 elif !!!!LT(15i32,mask) then 0i32 else 1i32
