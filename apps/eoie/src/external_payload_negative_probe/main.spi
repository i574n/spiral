open external_payload_contract.model

inl main () : i32 =
    match external_payload_scope_binding 1i32 1i32 1i32 0i32 with
    | 0 =>
        match external_payload_identity_binding 0i32 1i32 1i32 with
        | 0 =>
            match external_payload_hydrate_binding 0i32 0i32 0i32 0i32 with
            | 0 =>
                match external_payload_hydrate_binding 1i32 1i32 0i32 1i32 with
                | 0 =>
                    match external_payload_dehydrate_binding 1i32 0i32 1i32 1i32 with
                    | 0 =>
                        match external_payload_stage_binding 1i32 1i32 0i32 with
                        | 0 =>
                            match external_payload_completion_binding 1i32 1i32 0i32 with
                            | 0 => 0i32
                            | _ => 7i32
                        | _ => 6i32
                    | _ => 5i32
                | _ => 4i32
            | _ => 3i32
        | _ => 2i32
    | _ => 1i32
