open external_payload_contract.model

inl main () : i32 =
    inl _ = external_payload_hydrate_plan ()
    match external_payload_scope_binding 1i32 1i32 1i32 1i32 with
    | 1 =>
        match external_payload_identity_binding 1i32 1i32 1i32 with
        | 1 =>
            match external_payload_hydrate_binding 0i32 1i32 0i32 1i32 with
            | 1 =>
                match external_payload_stage_binding 1i32 1i32 1i32 with
                | 1 =>
                    match external_payload_dehydrate_binding 1i32 1i32 1i32 1i32 with
                    | 1 =>
                        match external_payload_completion_binding 1i32 1i32 1i32 with
                        | 1 => 0i32
                        | _ => 6i32
                    | _ => 5i32
                | _ => 4i32
            | _ => 3i32
        | _ => 2i32
    | _ => 1i32
