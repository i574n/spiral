open family_contract_bindings.bindings
open family_contract_contract.model

inl main () : i32 =
    inl _ = family_contract_public_plan ()
    inl good_catalog = family_contract_catalog_binding 36i32 36i32 36i32 36i32
    inl good_set = family_contract_set_binding 36i32 0i32
    inl good_shape = family_contract_shape_binding 15i32 4i32
    inl bad_catalog = family_contract_catalog_binding 36i32 35i32 36i32 35i32
    inl bad_set = family_contract_set_binding 35i32 1i32
    inl bad_shape = family_contract_shape_binding 7i32 3i32
    if !!!!EQ(good_catalog,1i32) && !!!!EQ(good_set,1i32) && !!!!EQ(good_shape,1i32) then
        if !!!!EQ(bad_catalog,0i32) && !!!!EQ(bad_set,0i32) && !!!!EQ(bad_shape,0i32) then 0i32 else 1i32
    else 1i32
