nominal fs_action_raw = ()
nominal fs_action_validated = ()
nominal fs_action_applied = ()
nominal fs_action_verified = ()
nominal fs_action_committed = ()
nominal fs_action_rolled_back = ()

union fs_action_kind =
    | MkdirKind
    | CopyKind
    | ChmodKind
    | SymlinkKind

union fs_action_operation =
    | BatchMkdir : string
    | BatchCopy : string * string * string
    | BatchChmod : string * string * string
    | BatchSymlink : string * string

union fs_action_transition from to =
    | ValidateActions :: fs_action_transition fs_action_raw fs_action_validated
    | ApplyActions :: fs_action_transition fs_action_validated fs_action_applied
    | VerifyActions :: fs_action_transition fs_action_applied fs_action_verified
    | CommitActions :: fs_action_transition fs_action_verified fs_action_committed

union rec fs_action_plan from to =
    | FsActionStep :: forall from to. fs_action_transition from to -> fs_action_plan from to
    | FsActionThen :: forall from to. (exists middle. fs_action_plan from middle * fs_action_plan middle to) -> fs_action_plan from to

inl public_plan () : fs_action_plan fs_action_raw fs_action_committed =
    FsActionThen (exists (
        FsActionStep ValidateActions,
        FsActionThen (exists (
            FsActionStep ApplyActions,
            FsActionThen (exists (
                FsActionStep VerifyActions,
                FsActionStep CommitActions
            ))
        ))
    ))
