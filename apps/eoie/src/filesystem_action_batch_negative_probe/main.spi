open filesystem_action_batch_contract.bindings

inl main () : i32 =
    match fs_action_shape_binding 0i32 0i32 with
    | 0 =>
        match fs_action_freshness_binding 4i32 1i32 with
        | 0 =>
            match fs_action_apply_binding 4i32 3i32 with
            | 0 =>
                match fs_action_verify_binding 4i32 5i32 with
                | 0 =>
                    match fs_action_rollback_binding 4i32 3i32 with
                    | 0 => 0i32
                    | _ => 1i32
                | _ => 1i32
            | _ => 1i32
        | _ => 1i32
    | _ => 1i32
