open filesystem_action_batch_contract.model
open filesystem_action_batch_contract.bindings

inl main () : i32 =
    inl _ = public_plan ()
    inl _ : fs_action_operation = BatchMkdir "dir"
    inl _ : fs_action_operation = BatchCopy ("source", "sha", "target")
    inl _ : fs_action_operation = BatchChmod ("target", "0644", "0755")
    inl _ : fs_action_operation = BatchSymlink ("link", "target")
    match fs_action_shape_binding 4i32 0i32 with
    | 1 =>
        match fs_action_freshness_binding 3i32 1i32 with
        | 1 =>
            match fs_action_apply_binding 4i32 4i32 with
            | 1 =>
                match fs_action_verify_binding 4i32 4i32 with
                | 1 =>
                    match fs_action_rollback_binding 4i32 4i32 with
                    | 1 => 0i32
                    | _ => 1i32
                | _ => 1i32
            | _ => 1i32
        | _ => 1i32
    | _ => 1i32
