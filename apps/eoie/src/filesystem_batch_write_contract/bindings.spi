open model

let batch_write_shape_binding (row_count : i32) (problem_count : i32) : i32 =
    if !!!!LT(row_count,1i32) then 0i32
    elif !!!!LT(problem_count,0i32) then 0i32
    elif !!!!LT(0i32,problem_count) then 0i32
    else 1i32

let batch_write_freshness_binding (kind_code : i32) (expected_ok : i32) : i32 =
    if !!!!LT(kind_code,0i32) then 0i32
    elif !!!!LT(1i32,kind_code) then 0i32
    elif !!!!LT(expected_ok,1i32) then 0i32
    else 1i32

let batch_write_stage_binding (row_count : i32) (staged_count : i32) : i32 =
    if !!!!LT(row_count,1i32) then 0i32
    elif !!!!LT(staged_count,row_count) then 0i32
    elif !!!!LT(row_count,staged_count) then 0i32
    else 1i32

let batch_write_verify_binding (row_count : i32) (verified_count : i32) : i32 =
    if !!!!LT(row_count,1i32) then 0i32
    elif !!!!LT(verified_count,row_count) then 0i32
    elif !!!!LT(row_count,verified_count) then 0i32
    else 1i32

let batch_write_rollback_binding (row_count : i32) (restored_count : i32) : i32 =
    if !!!!LT(row_count,1i32) then 0i32
    elif !!!!LT(restored_count,row_count) then 0i32
    elif !!!!LT(row_count,restored_count) then 0i32
    else 1i32
