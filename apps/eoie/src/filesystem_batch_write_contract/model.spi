nominal batch_write_raw = ()
nominal batch_write_validated = ()
nominal batch_write_staged = ()
nominal batch_write_verified = ()
nominal batch_write_committed = ()
nominal batch_write_rolled_back = ()

union batch_write_kind =
    | CreateKind
    | ReplaceKind

union batch_write_operation =
    | BatchCreate : string * string
    | BatchReplace : string * string * string

union batch_write_transition from to =
    | ValidateBatch :: batch_write_transition batch_write_raw batch_write_validated
    | StageBatch :: batch_write_transition batch_write_validated batch_write_staged
    | VerifyBatch :: batch_write_transition batch_write_staged batch_write_verified
    | CommitBatch :: batch_write_transition batch_write_verified batch_write_committed

union rec batch_write_plan from to =
    | BatchWriteStep :: forall from to. batch_write_transition from to -> batch_write_plan from to
    | BatchWriteThen :: forall from to. (exists middle. batch_write_plan from middle * batch_write_plan middle to) -> batch_write_plan from to

inl public_plan () : batch_write_plan batch_write_raw batch_write_committed =
    BatchWriteThen (exists (
        BatchWriteStep ValidateBatch,
        BatchWriteThen (exists (
            BatchWriteStep StageBatch,
            BatchWriteThen (exists (
                BatchWriteStep VerifyBatch,
                BatchWriteStep CommitBatch
            ))
        ))
    ))
