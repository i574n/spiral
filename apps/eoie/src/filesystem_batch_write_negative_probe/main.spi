open filesystem_batch_write_contract.bindings

inl main () : i32 =
    match batch_write_shape_binding 0i32 0i32 with
    | 0 =>
        match batch_write_shape_binding 2i32 1i32 with
        | 0 =>
            match batch_write_freshness_binding 1i32 0i32 with
            | 0 =>
                match batch_write_stage_binding 2i32 1i32 with
                | 0 =>
                    match batch_write_verify_binding 2i32 1i32 with
                    | 0 =>
                        match batch_write_rollback_binding 2i32 1i32 with
                        | 0 => 0i32
                        | _ => 1i32
                    | _ => 1i32
                | _ => 1i32
            | _ => 1i32
        | _ => 1i32
    | _ => 1i32
