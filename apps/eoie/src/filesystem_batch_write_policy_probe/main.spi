open filesystem_batch_write_contract.model
open filesystem_batch_write_contract.bindings

inl main () : i32 =
    inl _ = public_plan ()
    match batch_write_shape_binding 2i32 0i32 with
    | 1 =>
        match batch_write_freshness_binding 0i32 1i32 with
        | 1 =>
            match batch_write_freshness_binding 1i32 1i32 with
            | 1 =>
                match batch_write_stage_binding 2i32 2i32 with
                | 1 =>
                    match batch_write_verify_binding 2i32 2i32 with
                    | 1 =>
                        match batch_write_rollback_binding 2i32 2i32 with
                        | 1 => 0i32
                        | _ => 1i32
                    | _ => 1i32
                | _ => 1i32
            | _ => 1i32
        | _ => 1i32
    | _ => 1i32
