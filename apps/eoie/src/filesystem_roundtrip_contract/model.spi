open rust_std_fs.model

nominal policy_owner = string
nominal agile_owner = string
nominal roundtrip_pending owner = owner * string * string * string
nominal roundtrip_absent owner = owner * string * string * string
nominal roundtrip_written owner = owner * string * string * string
nominal roundtrip_verified owner = owner * string * string
nominal roundtrip_cleaned owner = owner * string

union file_roundtrip_transition from to =
    | EnsureAbsent :: forall owner. string -> file_roundtrip_transition (roundtrip_pending owner) (roundtrip_absent owner)
    | WriteActual :: forall owner. string -> file_roundtrip_transition (roundtrip_absent owner) (roundtrip_written owner)
    | VerifyExpected :: forall owner. string -> file_roundtrip_transition (roundtrip_written owner) (roundtrip_verified owner)
    | CleanupExact :: forall owner. string -> file_roundtrip_transition (roundtrip_verified owner) (roundtrip_cleaned owner)

union rec file_roundtrip_plan from to =
    | FileRoundtripStep :: forall from to. file_roundtrip_transition from to -> file_roundtrip_plan from to
    | FileRoundtripThen :: forall from to. (exists middle. file_roundtrip_plan from middle * file_roundtrip_plan middle to) -> file_roundtrip_plan from to

union roundtrip_outcome =
    | RoundtripAccepted : string
    | RoundtripRejected : string
    | RoundtripCleanupFailed : string

inl ensure_absent_step forall owner. () : file_roundtrip_plan (roundtrip_pending owner) (roundtrip_absent owner) =
    FileRoundtripStep (EnsureAbsent "ensure-absent")

inl write_actual_step forall owner. () : file_roundtrip_plan (roundtrip_absent owner) (roundtrip_written owner) =
    FileRoundtripStep (WriteActual "write-actual")

inl verify_expected_step forall owner. () : file_roundtrip_plan (roundtrip_written owner) (roundtrip_verified owner) =
    FileRoundtripStep (VerifyExpected "verify-expected")

inl cleanup_exact_step forall owner. () : file_roundtrip_plan (roundtrip_verified owner) (roundtrip_cleaned owner) =
    FileRoundtripStep (CleanupExact "cleanup-exact")

inl full_plan forall owner. () : file_roundtrip_plan (roundtrip_pending owner) (roundtrip_cleaned owner) =
    FileRoundtripThen (
        exists (
            ensure_absent_step (),
            FileRoundtripThen (
                exists (
                    write_actual_step (),
                    FileRoundtripThen (
                        exists (
                            verify_expected_step (),
                            cleanup_exact_step ()))))))

inl policy_plan () : file_roundtrip_plan (roundtrip_pending policy_owner) (roundtrip_cleaned policy_owner) = full_plan ()
inl agile_plan () : file_roundtrip_plan (roundtrip_pending agile_owner) (roundtrip_cleaned agile_owner) = full_plan ()

inl run (path : string) (expected : string) (actual : string) : roundtrip_outcome =
    if remove_file path && file_missing path then
        if write_text path actual then
            if file_exists path && text_equals expected path then
                if remove_file path && file_missing path
                then RoundtripAccepted "exact-roundtrip-accepted"
                else RoundtripCleanupFailed "accepted-cleanup-failed"
            else
                if remove_file path && file_missing path
                then RoundtripRejected "exact-readback-mismatch"
                else RoundtripCleanupFailed "rejection-cleanup-failed"
        else RoundtripCleanupFailed "write-actual-failed"
    else RoundtripCleanupFailed "ensure-absent-failed"

inl policy_roundtrip (path : string) (text : string) : roundtrip_outcome =
    inl _ = policy_plan ()
    run path text text

inl agile_rejection (path : string) (expected : string) (actual : string) : roundtrip_outcome =
    inl _ = agile_plan ()
    run path expected actual

inl accepted (outcome : roundtrip_outcome) : bool =
    match outcome with
    | RoundtripAccepted _ => true
    | RoundtripRejected _ => false
    | RoundtripCleanupFailed _ => false

inl rejected (outcome : roundtrip_outcome) : bool =
    match outcome with
    | RoundtripAccepted _ => false
    | RoundtripRejected _ => true
    | RoundtripCleanupFailed _ => false
