open flat_bundle_contract.model

inl one_is (value : i32) : bool =
    if !!!!LT(value,1i32) then false
    elif !!!!LT(1i32,value) then false
    else true

inl main () : i32 =
    inl _ = policy_plan ()
    if one_is (preflight_binding 1i32 1i32) then
        if one_is (manifest_binding 1i32 1i32) then
            if one_is (size_binding 1i32 1i32) then
                if one_is (compression_binding 1i32 1i32) then
                    if one_is (complete_binding 1i32 1i32) then 0i32 else 5i32
                else 4i32
            else 3i32
        else 2i32
    else 1i32
