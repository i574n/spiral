inl main () : i32 =
    inl toolchain_ok = (=.) (handoff_toolchain_projection (fixture_toolchain ())) "spiral_compiler=spiral-compile sha256=abcdef bytes=67952"
    inl cold_ok = (=.) (handoff_cold_projection (fixture_cold ())) "cold_proof=closed replay_flags=15 binary_sha256=deadbeef"
    !!!!Export("eoie_handoff_toolchain_projection", ((fun value => handoff_toolchain_projection value) : string -> string))
    !!!!Export("eoie_handoff_cold_projection", ((fun value => handoff_cold_projection value) : string -> string))
    if toolchain_ok then if cold_ok then 0i32 else 2i32 else 1i32
