let rec projection_find_digit_loop (text : string) (at : i32) (text_len : i32) : i32 =
    if (=.) at text_len then text_len
    else
        inl digit = codec_decimal_digit_value (sm.index text at)
        if (<) digit 10u64 then at
        else projection_find_digit_loop text ((+.) at 1i32) text_len

inl projection_line (source : string) (marker : string) : string =
    inl source_len = sm.length source : i32
    inl marker_at = find_text source 0i32 marker
    if (=.) marker_at source_len then codec_empty ()
    else
        inl line_near_to = find_char source marker_at (char_newline ())
        slice_exclusive source marker_at line_near_to

inl projection_u32 (source : string) (marker : string) : string =
    inl line = projection_line source marker
    inl line_len = sm.length line : i32
    if (=.) line_len 0i32 then codec_empty ()
    else
        inl equals_at = find_char line 0i32 '='
        if (=.) equals_at line_len then codec_empty ()
        else
            inl digit_from = projection_find_digit_loop line ((+.) equals_at 1i32) line_len
            if (=.) digit_from line_len then codec_empty ()
            else
                inl digit_near_to = find_text line digit_from "u32"
                if (=.) digit_near_to line_len then codec_empty ()
                else codec_u64_decimal_normalize (slice_exclusive line digit_from digit_near_to)

inl projection_two_quoted (line : string) : string * string * i32 * bool =
    inl line_len = sm.length line : i32
    inl first_at = find_char line 0i32 (char_quote ())
    if (=.) first_at line_len then codec_empty (), codec_empty (), line_len, false
    else
        inl first, after_first, first_ok = parse_quoted line first_at
        if (=.) first_ok false then codec_empty (), codec_empty (), line_len, false
        else
            inl second_at = find_char line after_first (char_quote ())
            if (=.) second_at line_len then codec_empty (), codec_empty (), line_len, false
            else
                inl second, after_second, second_ok = parse_quoted line second_at
                first, second, after_second, second_ok

let handoff_toolchain_projection (source : string) : string =
    inl line = projection_line source "SpiralCompilerEntrypoint, EvidenceRef ("
    inl line_len = sm.length line : i32
    if (=.) line_len 0i32 then codec_empty ()
    else
        inl name, hash, after_hash, fields_ok = projection_two_quoted line
        if (=.) fields_ok false then codec_empty ()
        else
            inl digit_from = projection_find_digit_loop line after_hash line_len
            if (=.) digit_from line_len then codec_empty ()
            else
                inl digit_near_to = find_text line digit_from "u64"
                if (=.) digit_near_to line_len then codec_empty ()
                else
                    inl bytes = codec_u64_decimal_normalize (slice_exclusive line digit_from digit_near_to)
                    if (=.) bytes "" then codec_empty ()
                    else sm.concat "spiral_compiler=" (sm.concat name (sm.concat " sha256=" (sm.concat hash (sm.concat " bytes=" bytes))))

let handoff_cold_projection (source : string) : string =
    inl source_len = sm.length source : i32
    inl closed_at = find_text source 0i32 "ColdReceiptClosed"
    inl pending_at = find_text source 0i32 "ColdReceiptPending"
    inl status = if (<) closed_at source_len then "closed" elif (<) pending_at source_len then "pending" else "other"
    inl flags = projection_u32 source "inl current_cold_replay_flags"
    inl binary_line = projection_line source "inl binary_gate"
    inl binary_line_len = sm.length binary_line : i32
    inl binary_name, binary_hash, after_hash, binary_ok = projection_two_quoted binary_line
    if (=.) flags "" then codec_empty ()
    elif (=.) binary_ok false then codec_empty ()
    elif (<) binary_line_len after_hash then codec_empty ()
    elif (=.) binary_name "eoie" then
        if (=.) binary_hash "" then codec_empty ()
        else sm.concat "cold_proof=" (sm.concat status (sm.concat " replay_flags=" (sm.concat flags (sm.concat " binary_sha256=" binary_hash))))
    else codec_empty ()

inl fixture_toolchain () : string =
    "inl compiler_entry () = ToolIdentity (SpiralCompilerEntrypoint, EvidenceRef (\"spiral-compile\", \"abcdef\", 67952u64, Required))\n"

inl fixture_cold () : string =
    "inl current_cold_proof_status () : cold_receipt_status = ColdReceiptClosed\ninl current_cold_replay_flags () : u32 = 15u32\ninl binary_gate () = EvidenceRef (\"eoie\", \"deadbeef\")\n"
