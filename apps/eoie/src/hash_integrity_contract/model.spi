nominal integrity_raw = ()
nominal integrity_file_verified = ()
nominal integrity_tree_verified = ()
nominal integrity_shadow_verified = ()
nominal integrity_settled = ()

nominal hash_equal = ()
nominal hash_changed = ()
nominal hash_rejected = ()

union hash_relation relation =
    | HashEqual :: hash_relation hash_equal
    | HashChanged :: hash_relation hash_changed
    | HashRejected :: hash_relation hash_rejected

union integrity_op from to =
    | VerifyFileHash :: integrity_op integrity_raw integrity_file_verified
    | VerifyTreeParity :: hash_relation hash_equal -> integrity_op integrity_file_verified integrity_tree_verified
    | VerifyShadowDeletion :: hash_relation hash_changed -> integrity_op integrity_tree_verified integrity_shadow_verified
    | VerifySymlinkRejection :: hash_relation hash_rejected -> integrity_op integrity_shadow_verified integrity_settled

union rec integrity_plan from to =
    | IntegrityStep :: forall from to. integrity_op from to -> integrity_plan from to
    | IntegrityThen :: forall from to. (exists middle. integrity_plan from middle * integrity_plan middle to) -> integrity_plan from to

inl public_integrity_plan () : integrity_plan integrity_raw integrity_settled =
    IntegrityThen (exists (
        IntegrityStep VerifyFileHash,
        IntegrityThen (exists (
            IntegrityStep (VerifyTreeParity HashEqual),
            IntegrityThen (exists (
                IntegrityStep (VerifyShadowDeletion HashChanged),
                IntegrityStep (VerifySymlinkRejection HashRejected)
            ))
        ))
    ))

let file_hash_binding (regular_file : i32) (symlink : i32) (known_vector_match : i32) : i32 =
    if !!!!LT(regular_file,1i32) then 0i32
    elif !!!!LT(1i32,regular_file) then 0i32
    elif !!!!LT(symlink,0i32) then 0i32
    elif !!!!LT(0i32,symlink) then 0i32
    elif !!!!LT(known_vector_match,1i32) then 0i32
    elif !!!!LT(1i32,known_vector_match) then 0i32
    else 1i32

let tree_request_binding (root_valid : i32) (relative_segments : i32) : i32 =
    if !!!!EQ(root_valid,1i32) then
        if !!!!LT(relative_segments,1i32) then 0i32 else 1i32
    else 0i32

let tree_parity_binding (source_entries : i32) (copy_entries : i32) (hash_equal : i32) : i32 =
    if !!!!LT(source_entries,1i32) then 0i32
    elif !!!!LT(copy_entries,1i32) then 0i32
    elif !!!!EQ(source_entries,copy_entries) then
        if !!!!EQ(hash_equal,1i32) then 1i32 else 0i32
    else 0i32

let shadow_deletion_binding (before_entries : i32) (after_entries : i32) (hash_changed : i32) : i32 =
    if !!!!LT(after_entries,0i32) then 0i32
    elif !!!!LT(after_entries,before_entries) then
        if !!!!EQ(hash_changed,1i32) then 1i32 else 0i32
    else 0i32

let symlink_rejection_binding (symlink_present : i32) (hash_rejected : i32) : i32 =
    if !!!!EQ(symlink_present,1i32) then
        if !!!!EQ(hash_rejected,1i32) then 1i32 else 0i32
    else 0i32

let integrity_settlement_binding (file_ok : i32) (tree_ok : i32) (shadow_ok : i32) (symlink_ok : i32) : i32 =
    inl gate0 = !!!!Mult(file_ok,tree_ok)
    inl gate1 = !!!!Mult(gate0,shadow_ok)
    !!!!Mult(gate1,symlink_ok)
