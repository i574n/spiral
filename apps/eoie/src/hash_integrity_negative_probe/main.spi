open hash_integrity_contract.model

inl main () : i32 =
    inl bad_file = file_hash_binding 1i32 1i32 1i32
    inl bad_tree = tree_parity_binding 2i32 1i32 1i32
    inl bad_shadow_same_hash = shadow_deletion_binding 2i32 1i32 0i32
    inl bad_shadow_no_deletion = shadow_deletion_binding 2i32 2i32 1i32
    inl bad_symlink_accepted = symlink_rejection_binding 1i32 0i32
    if !!!!EQ(bad_file,0i32) then
        if !!!!EQ(bad_tree,0i32) then
            if !!!!EQ(bad_shadow_same_hash,0i32) then
                if !!!!EQ(bad_shadow_no_deletion,0i32) then
                    if !!!!EQ(bad_symlink_accepted,0i32) then 0i32 else 5i32
                else 4i32
            else 3i32
        else 2i32
    else 1i32
