open hash_integrity_contract.model

inl main () : i32 =
    inl plan = public_integrity_plan ()
    inl _ = plan
    inl file_ok = file_hash_binding 1i32 0i32 1i32
    inl tree_ok = tree_parity_binding 2i32 2i32 1i32
    inl shadow_ok = shadow_deletion_binding 2i32 1i32 1i32
    inl symlink_ok = symlink_rejection_binding 1i32 1i32
    match integrity_settlement_binding file_ok tree_ok shadow_ok symlink_ok with
    | 1 => 0i32
    | _ => 1i32
