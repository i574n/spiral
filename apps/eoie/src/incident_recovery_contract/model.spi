nominal incident_recovery_empty = ()
nominal incident_recovery_validated = ()
nominal incident_recovery_snapshot_captured = ()
nominal incident_recovery_snapshot_verified = ()
nominal incident_recovery_incident_declared = ()
nominal incident_recovery_restore_staged = ()
nominal incident_recovery_promoted = ()
nominal incident_recovery_verified = ()

union incident_recovery_op from to =
    | ValidateIncidentRecovery :: incident_recovery_op incident_recovery_empty incident_recovery_validated
    | CaptureIncidentSnapshot :: incident_recovery_op incident_recovery_validated incident_recovery_snapshot_captured
    | VerifyIncidentSnapshot :: incident_recovery_op incident_recovery_snapshot_captured incident_recovery_snapshot_verified
    | DeclareDestructiveIncident :: incident_recovery_op incident_recovery_snapshot_verified incident_recovery_incident_declared
    | StageIncidentRestore :: incident_recovery_op incident_recovery_incident_declared incident_recovery_restore_staged
    | PromoteIncidentRestore :: incident_recovery_op incident_recovery_restore_staged incident_recovery_promoted
    | VerifyIncidentRestore :: incident_recovery_op incident_recovery_promoted incident_recovery_verified

union rec incident_recovery_plan from to =
    | IncidentRecoveryStep :: forall from to. incident_recovery_op from to -> incident_recovery_plan from to
    | IncidentRecoveryThen :: forall from to. (exists middle. incident_recovery_plan from middle * incident_recovery_plan middle to) -> incident_recovery_plan from to

inl incident_recovery_complete_plan () : incident_recovery_plan incident_recovery_empty incident_recovery_verified =
    IncidentRecoveryThen (exists (
        IncidentRecoveryStep ValidateIncidentRecovery,
        IncidentRecoveryThen (exists (
            IncidentRecoveryStep CaptureIncidentSnapshot,
            IncidentRecoveryThen (exists (
                IncidentRecoveryStep VerifyIncidentSnapshot,
                IncidentRecoveryThen (exists (
                    IncidentRecoveryStep DeclareDestructiveIncident,
                    IncidentRecoveryThen (exists (
                        IncidentRecoveryStep StageIncidentRestore,
                        IncidentRecoveryThen (exists (
                            IncidentRecoveryStep PromoteIncidentRestore,
                            IncidentRecoveryStep VerifyIncidentRestore
                        ))
                    ))
                ))
            ))
        ))
    ))

union incident_recovery_target =
    | TargetAbsent
    | TargetDirectory

union incident_recovery_fault =
    | NoIncidentRecoveryFault
    | FaultAfterQuarantine
    | FaultAfterPromotion

inl incident_recovery_target_code = function
    | TargetAbsent => 0i32
    | TargetDirectory => 1i32

inl incident_recovery_fault_code = function
    | NoIncidentRecoveryFault => 0i32
    | FaultAfterQuarantine => 1i32
    | FaultAfterPromotion => 2i32

let incident_recovery_scope_binding (root_safe : i32) (source_safe : i32) (snapshot_safe : i32) (receipt_safe : i32) : i32 =
    if !!!!LT(root_safe,1i32) then 0i32
    elif !!!!LT(1i32,root_safe) then 0i32
    elif !!!!LT(source_safe,1i32) then 0i32
    elif !!!!LT(1i32,source_safe) then 0i32
    elif !!!!LT(snapshot_safe,1i32) then 0i32
    elif !!!!LT(1i32,snapshot_safe) then 0i32
    elif !!!!LT(receipt_safe,1i32) then 0i32
    elif !!!!LT(1i32,receipt_safe) then 0i32
    else 1i32

let incident_recovery_leaf_binding (same_leaf : i32) (paths_separated : i32) : i32 =
    if !!!!LT(same_leaf,1i32) then 0i32
    elif !!!!LT(1i32,same_leaf) then 0i32
    elif !!!!LT(paths_separated,1i32) then 0i32
    elif !!!!LT(1i32,paths_separated) then 0i32
    else 1i32

let incident_recovery_snapshot_binding (source_directory : i32) (snapshot_absent : i32) (copy_complete : i32) (hash_parity : i32) : i32 =
    if !!!!LT(source_directory,1i32) then 0i32
    elif !!!!LT(1i32,source_directory) then 0i32
    elif !!!!LT(snapshot_absent,1i32) then 0i32
    elif !!!!LT(1i32,snapshot_absent) then 0i32
    elif !!!!LT(copy_complete,1i32) then 0i32
    elif !!!!LT(1i32,copy_complete) then 0i32
    elif !!!!LT(hash_parity,1i32) then 0i32
    elif !!!!LT(1i32,hash_parity) then 0i32
    else 1i32

let incident_recovery_restore_binding (snapshot_directory : i32) (target_kind : i32) (stage_absent : i32) (receipt_match : i32) : i32 =
    if !!!!LT(snapshot_directory,1i32) then 0i32
    elif !!!!LT(1i32,snapshot_directory) then 0i32
    elif !!!!LT(target_kind,0i32) then 0i32
    elif !!!!LT(1i32,target_kind) then 0i32
    elif !!!!LT(stage_absent,1i32) then 0i32
    elif !!!!LT(1i32,stage_absent) then 0i32
    elif !!!!LT(receipt_match,1i32) then 0i32
    elif !!!!LT(1i32,receipt_match) then 0i32
    else 1i32

let incident_recovery_fault_binding (configured : i32) (observed : i32) : i32 =
    if !!!!LT(configured,1i32) then 0i32
    elif !!!!LT(2i32,configured) then 0i32
    elif !!!!LT(configured,observed) then 0i32
    elif !!!!LT(observed,configured) then 0i32
    else 1i32

let incident_recovery_rollback_binding (original_present : i32) (rollback_restored : i32) (original_hash_match : i32) : i32 =
    if !!!!LT(original_present,0i32) then 0i32
    elif !!!!LT(1i32,original_present) then 0i32
    elif !!!!LT(rollback_restored,1i32) then 0i32
    elif !!!!LT(1i32,rollback_restored) then 0i32
    elif !!!!LT(original_hash_match,1i32) then 0i32
    elif !!!!LT(1i32,original_hash_match) then 0i32
    else 1i32

let incident_recovery_completion_binding (snapshot_hash_match : i32) (stage_hash_match : i32) (final_hash_match : i32) : i32 =
    if !!!!LT(snapshot_hash_match,1i32) then 0i32
    elif !!!!LT(1i32,snapshot_hash_match) then 0i32
    elif !!!!LT(stage_hash_match,1i32) then 0i32
    elif !!!!LT(1i32,stage_hash_match) then 0i32
    elif !!!!LT(final_hash_match,1i32) then 0i32
    elif !!!!LT(1i32,final_hash_match) then 0i32
    else 1i32

let incident_recovery_scope_mask_binding (mask : i32) (witness : i32) : i32 =
    if !!!!LT(mask,15i32) then 0i32 elif !!!!LT(15i32,mask) then 0i32 elif !!!!LT(witness,0i32) then 0i32 elif !!!!LT(0i32,witness) then 0i32 else 1i32

let incident_recovery_snapshot_mask_binding (mask : i32) (witness : i32) : i32 =
    if !!!!LT(mask,15i32) then 0i32 elif !!!!LT(15i32,mask) then 0i32 elif !!!!LT(witness,0i32) then 0i32 elif !!!!LT(0i32,witness) then 0i32 else 1i32

let incident_recovery_restore_mask_binding (mask : i32) (witness : i32) : i32 =
    if !!!!LT(mask,7i32) then 0i32
    elif !!!!LT(7i32,mask) then
        if !!!!LT(mask,15i32) then 0i32
        elif !!!!LT(15i32,mask) then 0i32
        elif !!!!LT(witness,0i32) then 0i32
        elif !!!!LT(0i32,witness) then 0i32
        else 1i32
    elif !!!!LT(witness,0i32) then 0i32
    elif !!!!LT(0i32,witness) then 0i32
    else 1i32

let incident_recovery_rollback_mask_binding (mask : i32) (witness : i32) : i32 =
    if !!!!LT(mask,6i32) then 0i32 elif !!!!LT(7i32,mask) then 0i32 elif !!!!LT(witness,0i32) then 0i32 elif !!!!LT(0i32,witness) then 0i32 else 1i32

let incident_recovery_completion_mask_binding (mask : i32) (witness : i32) : i32 =
    if !!!!LT(mask,7i32) then 0i32 elif !!!!LT(7i32,mask) then 0i32 elif !!!!LT(witness,0i32) then 0i32 elif !!!!LT(0i32,witness) then 0i32 else 1i32
