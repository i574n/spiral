nominal self_install_idle = ()
nominal self_install_validated = ()
nominal self_install_staged = ()
nominal self_install_binary_committed = ()
nominal self_install_link_preserved = ()
nominal self_install_link_committed = ()
nominal self_install_complete = ()

union self_install_link_state =
    | LinkAbsent
    | LinkSymlink
    | LinkRegularFile
    | LinkDirectory

union self_install_fault =
    | NoSelfInstallFault
    | FailAfterBinaryCommit
    | FailBeforeLinkCommit
    | FailAfterLinkCommit

union self_install_op from to =
    | ValidateSelfInstall :: self_install_op self_install_idle self_install_validated
    | StageSelfInstall :: self_install_op self_install_validated self_install_staged
    | CommitSelfInstallBinary :: self_install_op self_install_staged self_install_binary_committed
    | PreserveSelfInstallLink :: self_install_op self_install_binary_committed self_install_link_preserved
    | CommitSelfInstallLink :: self_install_op self_install_link_preserved self_install_link_committed
    | CompleteSelfInstall :: self_install_op self_install_link_committed self_install_complete

union rec self_install_plan from to =
    | SelfInstallStep :: forall from to. self_install_op from to -> self_install_plan from to
    | SelfInstallThen :: forall from to. (exists middle. self_install_plan from middle * self_install_plan middle to) -> self_install_plan from to

inl self_install_complete_plan () : self_install_plan self_install_idle self_install_complete =
    SelfInstallThen (exists (
        SelfInstallStep ValidateSelfInstall,
        SelfInstallThen (exists (
            SelfInstallStep StageSelfInstall,
            SelfInstallThen (exists (
                SelfInstallStep CommitSelfInstallBinary,
                SelfInstallThen (exists (
                    SelfInstallStep PreserveSelfInstallLink,
                    SelfInstallThen (exists (
                        SelfInstallStep CommitSelfInstallLink,
                        SelfInstallStep CompleteSelfInstall
                    ))
                ))
            ))
        ))
    ))

inl self_install_link_state_code = function
    | LinkAbsent => 0i32
    | LinkSymlink => 1i32
    | LinkRegularFile => 2i32
    | LinkDirectory => 3i32

inl self_install_fault_code = function
    | NoSelfInstallFault => 0i32
    | FailAfterBinaryCommit => 1i32
    | FailBeforeLinkCommit => 2i32
    | FailAfterLinkCommit => 3i32

let self_install_preflight_binding (source_regular : i32) (source_executable : i32) : i32 =
    if !!!!LT(source_regular,1i32) then 0i32
    elif !!!!LT(1i32,source_regular) then 0i32
    elif !!!!LT(source_executable,1i32) then 0i32
    elif !!!!LT(1i32,source_executable) then 0i32
    else 1i32

let self_install_target_binding (destination_safe : i32) (link_state_code : i32) : i32 =
    if !!!!LT(destination_safe,1i32) then 0i32
    elif !!!!LT(1i32,destination_safe) then 0i32
    elif !!!!LT(link_state_code,0i32) then 0i32
    elif !!!!LT(3i32,link_state_code) then 0i32
    elif !!!!EQ(link_state_code,3i32) then 0i32
    else 1i32

let self_install_fault_binding (configured : i32) (observed : i32) : i32 =
    if !!!!LT(configured,1i32) then 0i32
    elif !!!!LT(3i32,configured) then 0i32
    elif !!!!LT(observed,1i32) then 0i32
    elif !!!!LT(3i32,observed) then 0i32
    elif !!!!LT(configured,observed) then 0i32
    elif !!!!LT(observed,configured) then 0i32
    else 1i32

let self_install_complete_binding (binary_matches : i32) (link_matches : i32) : i32 =
    if !!!!LT(binary_matches,1i32) then 0i32
    elif !!!!LT(1i32,binary_matches) then 0i32
    elif !!!!LT(link_matches,1i32) then 0i32
    elif !!!!LT(1i32,link_matches) then 0i32
    else 1i32
