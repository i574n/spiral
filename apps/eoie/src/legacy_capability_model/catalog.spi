nominal legacy_idle = ()
nominal legacy_cataloged = ()
nominal legacy_prioritized = ()
nominal legacy_absorbing = ()
nominal legacy_proven = ()

union legacy_origin =
    | Eoie834
    | Eoie9252

union legacy_family =
    | PatchBatching
    | FilesystemMutation
    | ProcessExecution
    | ArchiveBundling
    | AgileState
    | ReleaseVerification
    | Rehydration
    | Toolchain
    | CoveragePruning
    | PlanningGovernance

union absorption_disposition =
    | Native
    | Equivalent
    | Pending
    | Quarantined

union legacy_capability =
    | FindSliceReplace
    | PatchMatrix
    | CommandCapture
    | CopyTree
    | SliceText
    | SearchText
    | NativeSha256
    | CopyFilePreserveMode
    | ArchiveExtract
    | ArchiveExtractDeflate
    | TarExtract
    | CargoGates
    | BatchPlan
    | BundleTree
    | BundleVerify
    | Rehydrate
    | ChmodFile
    | SymlinkSet
    | SnapshotPrune
    | CoverageGate
    | WorkspaceState
    | ReleaseCloseout

union legacy_absorption_op from to result =
    | CatalogLegacy :: legacy_origin -> legacy_absorption_op legacy_idle legacy_cataloged i32
    | PrioritizeFamily :: legacy_family -> legacy_absorption_op legacy_cataloged legacy_prioritized i32
    | AbsorbCapability :: legacy_capability * absorption_disposition -> legacy_absorption_op legacy_prioritized legacy_absorbing i32
    | ProveCapability :: legacy_capability -> legacy_absorption_op legacy_absorbing legacy_proven i32

union rec legacy_absorption_plan from to =
    | LegacyStep :: forall from to. (exists result. legacy_absorption_op from to result * result) -> legacy_absorption_plan from to
    | LegacyThen :: forall from to. (exists middle. legacy_absorption_plan from middle * legacy_absorption_plan middle to) -> legacy_absorption_plan from to

inl foundation_plan () : legacy_absorption_plan legacy_idle legacy_proven =
    LegacyThen (exists (
        LegacyStep (exists (CatalogLegacy Eoie834, 1i32)),
        LegacyThen (exists (
            LegacyStep (exists (PrioritizeFamily FilesystemMutation, 2i32)),
            LegacyThen (exists (
                LegacyStep (exists (AbsorbCapability (CopyTree, Native), 3i32)),
                LegacyStep (exists (ProveCapability CopyTree, 4i32))
            ))
        ))
    ))

inl legacy_origin_code = function
    | Eoie834 => 834i32
    | Eoie9252 => 9252i32

inl legacy_family_code = function
    | PatchBatching => 0i32
    | FilesystemMutation => 1i32
    | ProcessExecution => 2i32
    | ArchiveBundling => 3i32
    | AgileState => 4i32
    | ReleaseVerification => 5i32
    | Rehydration => 6i32
    | Toolchain => 7i32
    | CoveragePruning => 8i32
    | PlanningGovernance => 9i32

inl legacy_disposition_code = function
    | Native => 3i32
    | Equivalent => 2i32
    | Pending => 1i32
    | Quarantined => 0i32

let legacy_surface_status_binding (family_code : i32) (status_code : i32) : i32 =
    if !!!!LT(family_code,0i32) then 0i32
    elif !!!!LT(9i32,family_code) then 0i32
    elif !!!!EQ(family_code,9i32) then
        if !!!!EQ(status_code,0i32) then 1i32 else 0i32
    else
        if !!!!EQ(status_code,2i32) then 1i32 else 0i32

let legacy_surface_summary_binding (equivalent_families : i32) (fallback_required : i32) : i32 =
    if !!!!EQ(equivalent_families,9i32) then
        if !!!!EQ(fallback_required,0i32) then 1i32 else 0i32
    else 0i32

inl legacy_surface_model_witness () : i32 =
    inl _ = legacy_surface_status_binding (legacy_family_code PatchBatching) (legacy_disposition_code Equivalent)
    inl _ = legacy_surface_status_binding (legacy_family_code FilesystemMutation) (legacy_disposition_code Equivalent)
    inl _ = legacy_surface_status_binding (legacy_family_code ProcessExecution) (legacy_disposition_code Equivalent)
    inl _ = legacy_surface_status_binding (legacy_family_code ArchiveBundling) (legacy_disposition_code Equivalent)
    inl _ = legacy_surface_status_binding (legacy_family_code AgileState) (legacy_disposition_code Equivalent)
    inl _ = legacy_surface_status_binding (legacy_family_code ReleaseVerification) (legacy_disposition_code Equivalent)
    inl _ = legacy_surface_status_binding (legacy_family_code Rehydration) (legacy_disposition_code Equivalent)
    inl _ = legacy_surface_status_binding (legacy_family_code Toolchain) (legacy_disposition_code Equivalent)
    inl _ = legacy_surface_status_binding (legacy_family_code CoveragePruning) (legacy_disposition_code Equivalent)
    inl _ = legacy_surface_status_binding (legacy_family_code PlanningGovernance) (legacy_disposition_code Quarantined)
    legacy_surface_summary_binding 9i32 0i32
