open rust_std_env.model

inl preflight (~a : i32) (~b : i32) : i32 =
    !\((a,b), $'"legacy_capability_domain::eoie_restart_baton_preflight_binding($0, $1)"')

inl migration (~a : i32) (~b : i32) : i32 =
    !\((a,b), $'"legacy_capability_domain::eoie_restart_baton_migration_binding($0, $1)"')

inl fault (~a : i32) (~b : i32) : i32 =
    !\((a,b), $'"legacy_capability_domain::eoie_restart_baton_fault_binding($0, $1)"')

inl complete (~a : i32) (~b : i32) : i32 =
    !\((a,b), $'"legacy_capability_domain::eoie_restart_baton_complete_binding($0, $1)"')

inl main () : i32 =
    inl prepared = preflight 1i32 1i32
    inl exact = migration 290i32 290i32
    inl mismatch = migration 290i32 275i32
    inl second_fault = fault 2i32 2i32
    inl completed = complete 1i32 1i32
    if !!!!LT(prepared,1i32) then 1i32
    elif !!!!LT(exact,1i32) then 2i32
    elif !!!!LT(0i32,mismatch) then 3i32
    elif !!!!LT(second_fault,1i32) then 4i32
    elif !!!!LT(completed,1i32) then 5i32
    else 0i32