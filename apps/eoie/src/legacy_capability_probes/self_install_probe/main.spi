open rust_std_env.model

inl preflight (~a : i32) (~b : i32) : i32 =
    !\((a,b), $'"legacy_capability_domain::eoie_self_install_preflight_binding($0, $1)"')

inl target (~a : i32) (~b : i32) : i32 =
    !\((a,b), $'"legacy_capability_domain::eoie_self_install_target_binding($0, $1)"')

inl fault (~a : i32) (~b : i32) : i32 =
    !\((a,b), $'"legacy_capability_domain::eoie_self_install_fault_binding($0, $1)"')

inl complete (~a : i32) (~b : i32) : i32 =
    !\((a,b), $'"legacy_capability_domain::eoie_self_install_complete_binding($0, $1)"')

inl main () : i32 =
    inl invalid_source = preflight 0i32 1i32
    inl absent_link = target 1i32 0i32
    inl symlink_link = target 1i32 1i32
    inl regular_link = target 1i32 2i32
    inl directory_link = target 1i32 3i32
    inl third_fault = fault 3i32 3i32
    inl completed = complete 1i32 1i32
    if !!!!LT(0i32,invalid_source) then 1i32
    elif !!!!LT(absent_link,1i32) then 1i32
    elif !!!!LT(symlink_link,1i32) then 1i32
    elif !!!!LT(regular_link,1i32) then 1i32
    elif !!!!LT(0i32,directory_link) then 1i32
    elif !!!!LT(third_fault,1i32) then 1i32
    elif !!!!LT(completed,1i32) then 1i32
    else 0i32
