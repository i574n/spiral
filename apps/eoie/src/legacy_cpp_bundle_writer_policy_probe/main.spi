open legacy_cpp_bundle_writer_contract.model

inl one_is (value : i32) : bool =
    if !!!!LT(value,1i32) then false
    elif !!!!LT(1i32,value) then false
    else true

inl main () : i32 =
    inl _ = policy_plan ()
    inl source_ok = source_comparison_binding 1i32 1i32
    inl order_ok = ordering_binding 1i32 1i32
    inl count_ok = count_binding 1i32 1i32
    inl nested_ok = nested_policy_binding (nested_zip_policy_code LegacyExcludeNested) (nested_zip_policy_code CurrentRejectNested)
    inl epoch_ok = epoch_binding 1i32 1i32
    inl deterministic_ok = determinism_binding 1i32 1i32
    if one_is (complete_binding source_ok order_ok count_ok nested_ok epoch_ok deterministic_ok) then 0i32 else 1i32
