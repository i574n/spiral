inl rust_global (x : string) : () = !!!!Global(x)
inl emit_runtime () : () = rust_global "use eoie_process::shutdown_spiral_sessions as eoie_shutdown_spiral_sessions;\nuse eoie_process_observation::run_bounded_streaming_checked as eoie_run_bounded_streaming_checked;\nuse eoie_toolchain_proxy::toolchain_run as eoie_toolchain_run_family;\nuse eoie_source_map::{source_diff_run as eoie_source_diff_run_family, source_map_run as eoie_source_map_run_family};\nuse eoie_source_topology::{source_stats_run as eoie_source_stats_run_family, source_topology_run as eoie_source_topology_run_family};\nuse eoie_cold_rebuild_matrix::cold_rebuild_matrix_run as eoie_cold_rebuild_matrix_run_family;\nuse eoie_ingest_frontier::{frontier_map_run as eoie_frontier_map_run_family, ingest_extracted_run as eoie_ingest_extracted_run_family, ingest_map_run as eoie_ingest_map_run_family, ingest_targets_derive_run as eoie_ingest_targets_derive_run_family, ingest_targets_run as eoie_ingest_targets_run_family, ingest_trim_run as eoie_ingest_trim_run_family};\nuse eoie_coverage_prune::{coverage_assess as eoie_coverage_assess_family, coverage_run as eoie_coverage_run_family, prune_uncovered as eoie_prune_uncovered_family};\nuse eoie_bundle_zip::bundle_run as eoie_bundle_family;\nuse std::env;\nuse std::fs;\nuse std::io::{self};\nuse eoie_patch_control_domain::{patch_rooted as eoie_rooted, patch_safe_relative as eoie_safe_relative};\nuse eoie_rust_std_fs::{atomic_write as eoie_atomic_write, rooted_list_names as eoie_list_names, rooted_read_limited as eoie_read_limited, rooted_unlink_nondirectory as eoie_remove_leaf_nofollow, rooted_remove_tree_within as eoie_remove_tree_within};\nuse std::path::Path;\nuse std::process::Command;\n\n#[must_use]\npub fn eoie_bundle_run() -> i32 {\n    eoie_bundle_family()\n}\n#[must_use]\npub fn eoie_proxy_run() -> i32 { let args = env::args().skip(2).collect::<Vec<_>>(); if let Err(error) = eoie_proxy(&args) { let operation = args.first().map(String::as_str).unwrap_or(\"\"); let usage = eoie_legacy_operations_proxy_usage(operation); if usage.is_empty() { eprintln!(\"eoie error: {error}\\nintent: proxy capability\\nusage: eoie proxy <capability> ...\\nvalid: see eoie help proxy\\ncorrected: eoie help proxy\"); } else { eprintln!(\"eoie error: {error}\\nintent: proxy capability\\nusage: eoie {usage}\\nvalid: {usage}\\ncorrected: eoie {usage}\"); } 2 } else { 0 } }\n\nfn eoie_arg<'a>(args: &'a [String], index: usize, name: &str) -> Result<&'a str, String> {\n    args.get(index)\n        .map(String::as_str)\n        .ok_or_else(|| format!(\"missing argument: {name}\"))\n}\n\n// legacy typecheck shadow retired\n\n\nfn eoie_proxy(args: &[String]) -> Result<(), String> {\n    let subcommand = eoie_arg(args, 0, \"subcommand\")?;\n    match subcommand {\n        \"fs-list\" => {\n            let root = Path::new(eoie_arg(args, 1, \"root\")?);\n            let relative = args.get(2).map(String::as_str).unwrap_or(\".\");\n            let path = if relative == \".\" {\n                root.to_path_buf()\n            } else {\n                eoie_rooted(root, relative)?\n            };\n            let names = eoie_list_names(&path)?;\n            for name in names {\n                println!(\"{name}\");\n            }\n            Ok(())\n        }\n        \"fs-read\" => {\n            let root = Path::new(eoie_arg(args, 1, \"root\")?);\n            let path = eoie_rooted(root, eoie_arg(args, 2, \"relative\")?)?;\n            let limit: usize = args\n                .get(3)\n                .map(|value| value.parse())\n                .transpose()\n                .map_err(|_| \"invalid byte limit\".to_owned())?\n                .unwrap_or(usize::MAX);\n            let shown = eoie_read_limited(&path, limit)?;\n            io::Write::write_all(&mut io::stdout(), &shown).map_err(|error| error.to_string())?;\n            Ok(())\n        }\n        \"fs-write\" => {             let root = Path::new(eoie_arg(args, 1, \"root\")?);             let path = eoie_rooted(root, eoie_arg(args, 2, \"relative\")?)?;             let usage = \"usage: eoie proxy fs-write <root> <relative> [--replace-existing] [--expect-hash <sha256>] [--expect-nonempty] [--] <text>; creating a missing file needs no replace flag\";             if args.len() < 4 { return Err(format!(\"fs-write requires an explicit payload argument; {usage}\")); }             let mut replace_existing = false;             let mut expect_hash: Option<&str> = None;             let mut expect_nonempty = false;             let mut payload_start = 3usize;             if args.get(3).is_some_and(|value| eoie_legacy_operations_proxy_write_token_code(value) < 4) {                 let mut index = 3usize;                 let mut separator_seen = false;                 while index < args.len() {                     match eoie_legacy_operations_proxy_write_token_code(args[index].as_str()) {                         0 => { replace_existing = true; index += 1; }                         1 => { index += 1; expect_hash = Some(eoie_arg(args, index, \"sha256\")?); index += 1; }                         2 => { expect_nonempty = true; index += 1; }                         3 => { payload_start = index + 1; separator_seen = true; break; }                         _ => return Err(format!(\"unexpected fs-write option: {}; {usage}\", args[index])),                     }                 }                 if !separator_seen { return Err(format!(\"guarded fs-write requires -- before the payload; {usage}\")); }             }             let text = args[payload_start..].join(\" \");             let existed = path.exists();             let original = if existed { Some(fs::read(&path).map_err(|error| format!(\"read {} before replace: {error}\", path.display()))?) } else { None };             if existed {                 if !replace_existing { return Err(format!(\"fs-write refuses to overwrite existing file without --replace-existing: {}; {usage}\", path.display())); }\n                if expect_nonempty && original.as_ref().is_some_and(Vec::is_empty) { return Err(format!(\"fs-write --expect-nonempty rejected empty target: {}\", path.display())); }\n                if let Some(expected) = expect_hash {                     let observed = eoie_proxy_search::inspection_file_sha256(&path)?;                     if observed != expected { return Err(format!(\"fs-write expected hash mismatch path={} expected={} observed={}\", path.display(), expected, observed)); }                 }             } else if replace_existing || expect_hash.is_some() || expect_nonempty {                 return Err(format!(\"fs-write replacement preconditions require an existing file: {}; {usage}\", path.display()));             }             eoie_atomic_write(&path, text.as_bytes())?;             let observed = fs::read(&path).map_err(|error| format!(\"readback {}: {error}\", path.display()))?;             if observed != text.as_bytes() {                 if let Some(original) = original.as_ref() { let _ = eoie_atomic_write(&path, original); } else { let _ = eoie_remove_leaf_nofollow(&path); }                 return Err(\"fs-write readback mismatch; prior state restored\".to_owned());             }             println!(\"eoie proxy fs-write ok mode={} path={} bytes={} replace_existing={} expect_hash={} expect_nonempty={}\", if existed {\"replace\"} else {\"create\"}, path.display(), text.len(), i32::from(replace_existing), i32::from(expect_hash.is_some()), i32::from(expect_nonempty));             Ok(()) }\n        \"text-replace\" => {\n            if args.len() != 6 {\n                return Err(\"text-replace expects mode, root, relative, old, new\".to_owned());\n            }\n            let mode = eoie_arg(args, 1, \"check|apply\")?;\n            let root = Path::new(eoie_arg(args, 2, \"root\")?);\n            let path = eoie_rooted(root, eoie_arg(args, 3, \"relative\")?)?;\n            let old = eoie_arg(args, 4, \"old\")?;\n            let new = eoie_arg(args, 5, \"new\")?;\n            let regular_and_nonempty = if path.is_file() && !old.is_empty() { 1 } else { 0 };\n            let distinct_payloads = if old != new { 1 } else { 0 };\n            if eoie_legacy_operations_proxy_exact_replace_preflight_binding(regular_and_nonempty, distinct_payloads) != 1 {\n                return Err(\"text-replace preflight rejected target or payloads\".to_owned());\n            }\n            let original = fs::read_to_string(&path)\n                .map_err(|error| format!(\"read {}: {error}\", path.display()))?;\n            let matches = original.match_indices(old).count();\n            let mode_valid = if mode == \"check\" || mode == \"apply\" { 1 } else { 0 };\n            if eoie_legacy_operations_proxy_exact_replace_authorize_binding(matches as i32, mode_valid) != 1 {\n                return Err(format!(\"text-replace requires one match and a valid mode, observed matches={matches} mode={mode}\"));\n            }\n            let updated = original.replacen(old, new, 1);\n            match mode {\n                \"check\" => {\n                    let candidate_exact = if updated != original { 1 } else { 0 };\n                    if eoie_legacy_operations_proxy_exact_replace_verify_binding(candidate_exact, 1) != 1 {\n                        return Err(\"text-replace check verification rejected candidate\".to_owned());\n                    }\n                    println!(\"eoie proxy text-replace ok mode=check path={} matches=1 bytes_before={} bytes_after={}\", path.display(), original.len(), updated.len());\n                    Ok(())\n                }\n                \"apply\" => {\n                    eoie_atomic_write(&path, updated.as_bytes())?;\n                    let observed = fs::read_to_string(&path)\n                        .map_err(|error| format!(\"readback {}: {error}\", path.display()))?;\n                    if observed != updated {\n                        let _ = eoie_atomic_write(&path, original.as_bytes());\n                        return Err(\"text-replace readback mismatch; original restored\".to_owned());\n                    }\n                    if eoie_legacy_operations_proxy_exact_replace_verify_binding(1, 1) != 1 {\n                        let _ = eoie_atomic_write(&path, original.as_bytes());\n                        return Err(\"text-replace policy verification rejected commit; original restored\".to_owned());\n                    }\n                    println!(\"eoie proxy text-replace ok mode=apply path={} matches=1 bytes_before={} bytes_after={}\", path.display(), original.len(), updated.len());\n                    Ok(())\n                }\n                _ => Err(\"text-replace mode must be check or apply\".to_owned()),\n            }\n        }\n        \"fs-remove\" => {\n            let root = Path::new(eoie_arg(args, 1, \"root\")?);\n            let path = eoie_rooted(root, eoie_arg(args, 2, \"relative\")?)?;\n            eoie_remove_leaf_nofollow(&path)?;\n            Ok(())\n        }\n        \"fs-remove-tree\" => {\n            let root = Path::new(eoie_arg(args, 1, \"root\")?);\n            let relative = eoie_arg(args, 2, \"relative\")?;\n            let missing_ok = args.get(3).map(String::as_str) == Some(\"--missing-ok\");\n            if args.len() > 4 || (args.len() == 4 && !missing_ok) { return Err(\"fs-remove-tree expects root relative [--missing-ok]\".to_owned()); }\n            if missing_ok { let safe = eoie_safe_relative(relative)?; let candidate = root.join(&safe); if !candidate.exists() { println!(\"eoie proxy fs-remove-tree ok removed=0 missing_ok=1\"); return Ok(()); } }\n            let path = eoie_rooted(root, relative)?;\n            let count = eoie_remove_tree_within(root, &path)?;\n            println!(\"eoie proxy fs-remove-tree ok removed={count} missing_ok={}\", i32::from(missing_ok));\n            Ok(())\n        }\n        \"run\" => {             let usage = \"usage: eoie proxy run --cwd <directory> --program <program> [--timeout-ms <ms>] [--env KEY=VALUE]... [--unset KEY]... [-- <args...>]\";             if args.len() < 2 { return Err(format!(\"proxy run requires a working directory and program; {usage}\")); }                              let mut timeout_ms = 300000u64;                 let mut cwd: Option<&str> = None;                 let mut program: Option<&str> = None;                 let mut env_pairs: Vec<(String, String)> = Vec::new();                 let mut unset_keys: Vec<String> = Vec::new();                 let mut child_args: Vec<String> = Vec::new();                 let mut tail = false;                 let mut index = 1usize;                 while index < args.len() {                     if tail { child_args.push(args[index].clone()); index += 1; continue; }                     match eoie_legacy_operations_proxy_run_token_code(args[index].as_str()) {                         0 => {                             index += 1;                             timeout_ms = eoie_arg(args, index, \"timeout-ms\")?.parse::<u64>().map_err(|_| format!(\"proxy run --timeout-ms must be an integer; {usage}\"))?;                             index += 1;                         }                         1 => { index += 1; cwd = Some(eoie_arg(args, index, \"cwd\")?); index += 1; }                         2 => { index += 1; program = Some(eoie_arg(args, index, \"program\")?); index += 1; }                         3 => {                             index += 1;                             let cell = eoie_arg(args, index, \"KEY=VALUE\")?;                             let (key, value) = cell.split_once('=').ok_or_else(|| format!(\"proxy run --env expects KEY=VALUE, got {cell}; {usage}\"))?;                             if key.is_empty() { return Err(format!(\"proxy run --env key cannot be empty; {usage}\")); }                             env_pairs.push((key.to_owned(), value.to_owned()));                             index += 1;                         }                         4 => {                             index += 1;                             let key = eoie_arg(args, index, \"KEY\")?;                             if key.is_empty() || key.contains('=') { return Err(format!(\"proxy run --unset expects an environment key, got {key}; {usage}\")); }                             unset_keys.push(key.to_owned());                             index += 1;                         }                         5 => { tail = true; index += 1; }                         _ => return Err(format!(\"unexpected proxy run argument: {}; {usage}\", args[index])),                     }                 }                 let cwd = cwd.ok_or_else(|| format!(\"proxy run named mode requires --cwd; {usage}\"))?;                 let program = program.ok_or_else(|| format!(\"proxy run named mode requires --program; {usage}\"))?;                 let root = Path::new(cwd);                 if !root.is_dir() { return Err(format!(\"proxy run --cwd is not a directory: {}; {usage}\", root.display())); }                 let mut command = Command::new(program);                 command.current_dir(root).args(&child_args);                 for (key, value) in &env_pairs { command.env(key, value); }                 for key in &unset_keys { command.env_remove(key); }                 let observation = eoie_run_bounded_streaming_checked(&mut command, timeout_ms, \"proxy-run\", None)?;                 println!(\"eoie proxy run ok mode=named cwd={} program={} timeout_ms={timeout_ms} elapsed_ms={} env_set={} env_unset={}\", root.display(), program, observation.elapsed_ms, env_pairs.len(), unset_keys.len());                 Ok(())\n        }\n        \"spiral-session-shutdown\" => {\n            let compiler = eoie_arg(args, 1, \"compiler\")?;\n            let timeout_ms = args\n                .get(2)\n                .map(|value| value.parse::<u64>())\n                .transpose()\n                .map_err(|_| \"invalid timeout-ms\".to_owned())?\n                .unwrap_or(30000);\n            let status = eoie_shutdown_spiral_sessions(compiler, timeout_ms)?;\n            if !status.success() {\n                return Err(\"Spiral session shutdown failed\".to_owned());\n            }\n            println!(\"eoie proxy spiral-session-shutdown ok timeout_ms={timeout_ms}\");\n            Ok(())\n        }\n        \"prune-build-cache\" => {\n            let root = Path::new(eoie_arg(args, 1, \"root\")?);\n            let relative = eoie_safe_relative(eoie_arg(args, 2, \"relative-target\")?)?;\n            if relative.file_name().and_then(|value| value.to_str()) != Some(\"target\") {\n                return Err(\"build cache path must end in target\".to_owned());\n            }\n            let target = root.join(&relative);\n            if !target.exists() {\n                println!(\"eoie proxy prune-build-cache ok removed=0\");\n                return Ok(());\n            }\n            let canonical_root = fs::canonicalize(root).map_err(|error| error.to_string())?;\n            let metadata = fs::symlink_metadata(&target).map_err(|error| error.to_string())?;\n            if metadata.file_type().is_symlink() {\n                return Err(\"target cannot be a symlink\".to_owned());\n            }\n            let canonical_target = fs::canonicalize(&target).map_err(|error| error.to_string())?;\n            if canonical_target == canonical_root || !canonical_target.starts_with(&canonical_root)\n            {\n                return Err(\"target escapes root\".to_owned());\n            }\n            let count = eoie_remove_tree_within(root, &target)?;\n            println!(\"eoie proxy prune-build-cache ok removed={count}\");\n            Ok(())\n        }\n        \"differential-compare\" => eoie_differential_compare(args),\n        \"coverage-assess\" => eoie_coverage_assess_family(args),\n        \"coverage-run\" => eoie_coverage_run_family(args),\n        \"toolchain\" => eoie_toolchain_run_family(args),\n        \"source-stats\" => eoie_source_stats_run_family(args),\n        \"source-topology\" => eoie_source_topology_run_family(args),\n        \"ingest-map\" => eoie_ingest_map_run_family(args),\n        \"ingest-trim-check\" => eoie_ingest_trim_run_family(args),\n        \"ingest-extracted-manifest\" => eoie_ingest_extracted_run_family(args),\n        \"ingest-targets\" => eoie_ingest_targets_run_family(args),\n        \"ingest-targets-derive\" => eoie_ingest_targets_derive_run_family(args),\n        \"frontier-map\" => eoie_frontier_map_run_family(args),\n        \"spi-map\" | \"source-map\" => eoie_source_map_run_family(args),\n        \"cold-rebuild-matrix\" => eoie_cold_rebuild_matrix_run_family(args),\n        \"spi-diff\" | \"source-diff\" => eoie_source_diff_run_family(args),\n        \"prune-uncovered\" => eoie_prune_uncovered_family(args),\n        _ => Err(\"unknown proxy operation\".to_owned()),\n    }\n}\n\nfn eoie_normalized_text(path: &Path) -> Result<String, String> {\n    let source =\n        fs::read_to_string(path).map_err(|error| format!(\"read {}: {error}\", path.display()))?;\n    Ok(source\n        .replace(\"\\r\\n\", \"\\n\")\n        .lines()\n        .map(str::trim_end)\n        .collect::<Vec<_>>()\n        .join(\"\\n\"))\n}\n\nfn eoie_fnv1a(text: &str) -> u64 {\n    text.as_bytes()\n        .iter()\n        .fold(0xcbf29ce484222325u64, |hash, byte| {\n            (hash ^ u64::from(*byte)).wrapping_mul(0x100000001b3)\n        })\n}\n\nfn eoie_differential_compare(args: &[String]) -> Result<(), String> {\n    let root = Path::new(eoie_arg(args, 1, \"root\")?);\n    let oracle = eoie_rooted(root, eoie_arg(args, 2, \"oracle-relative\")?)?;\n    let direct = eoie_rooted(root, eoie_arg(args, 3, \"direct-relative\")?)?;\n    let receipt = eoie_rooted(root, eoie_arg(args, 4, \"receipt-relative\")?)?;\n    if args.len() != 5 {\n        return Err(\"differential-compare expects root, oracle, direct, receipt\".to_owned());\n    }\n    let oracle_text = eoie_normalized_text(&oracle)?;\n    let direct_text = eoie_normalized_text(&direct)?;\n    if oracle_text != direct_text {\n        let mismatch = oracle_text\n            .bytes()\n            .zip(direct_text.bytes())\n            .position(|(a, b)| a != b)\n            .unwrap_or(oracle_text.len().min(direct_text.len()));\n        return Err(format!(\n            \"differential mismatch at normalized byte {mismatch}\"\n        ));\n    }\n    let hash = eoie_fnv1a(&oracle_text);\n    eoie_atomic_write(\n        &receipt,\n        format!(\n            \"route=normalized-text\\nfnv1a={hash:016x}\\nbytes={}\\n\",\n            oracle_text.len()\n        )\n        .as_bytes(),\n    )?;\n    println!(\n        \"eoie proxy differential-compare ok fnv1a={hash:016x} bytes={}\",\n        oracle_text.len()\n    );\n    Ok(())\n}\n\n\n"
