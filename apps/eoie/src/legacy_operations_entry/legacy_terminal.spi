inl rust_global (x : string) : () = real typecase `(!!!!LitToTypeLit(x)) with ~x => $"RustGlobal(@x)" : ()
inl emit_runtime () : () = rust_global "use eoie_process::shutdown_spiral_sessions as eoie_shutdown_spiral_sessions;\nuse eoie_process_observation::run_bounded_streaming_checked as eoie_run_bounded_streaming_checked;\nuse eoie_toolchain_proxy::toolchain_run as eoie_toolchain_run_family;\nuse eoie_source_map::{source_diff_run as eoie_source_diff_run_family, source_map_run as eoie_source_map_run_family};\nuse eoie_source_topology::{source_stats_run as eoie_source_stats_run_family, source_topology_run as eoie_source_topology_run_family};\nuse eoie_cold_rebuild_matrix::cold_rebuild_matrix_run as eoie_cold_rebuild_matrix_run_family;\nuse eoie_ingest_frontier::{frontier_map_run as eoie_frontier_map_run_family, ingest_extracted_run as eoie_ingest_extracted_run_family, ingest_map_run as eoie_ingest_map_run_family, ingest_targets_derive_run as eoie_ingest_targets_derive_run_family, ingest_targets_run as eoie_ingest_targets_run_family, ingest_trim_run as eoie_ingest_trim_run_family};\nuse eoie_coverage_prune::{coverage_assess as eoie_coverage_assess_family, coverage_run as eoie_coverage_run_family, prune_uncovered as eoie_prune_uncovered_family};\nuse eoie_bundle_zip::bundle_run as eoie_bundle_family;\nuse std::env;\nuse std::fs;\nuse std::io::{self};\nuse eoie_patch_control_domain::{patch_rooted as eoie_rooted, patch_safe_relative as eoie_safe_relative};\nuse eoie_rust_std_fs::{atomic_write as eoie_atomic_write, rooted_list_names as eoie_list_names, rooted_read_limited as eoie_read_limited, rooted_unlink_nondirectory as eoie_remove_leaf_nofollow, rooted_remove_tree_within as eoie_remove_tree_within};\nuse std::path::Path;\nuse std::process::Command;\n\n#[must_use]\npub fn eoie_bundle_run() -> i32 {\n    eoie_bundle_family()\n}\n#[must_use]\npub fn eoie_proxy_run() -> i32 { let args = env::args().skip(2).collect::<Vec<_>>(); if let Err(error) = eoie_proxy(&args) { let operation = args.first().map(String::as_str).unwrap_or(\"\"); let usage = eoie_legacy_operations_proxy_usage(operation); if usage.is_empty() { eprintln!(\"eoie error: {error}\\nintent: proxy capability\\nusage: eoie proxy <capability> ...\\nvalid: see eoie help proxy\\ncorrected: eoie help proxy\"); } else { eprintln!(\"eoie error: {error}\\nintent: proxy capability\\nusage: eoie {usage}\\nvalid: {usage}\\ncorrected: eoie {usage}\"); } 2 } else { 0 } }\n\nfn eoie_arg<'a>(args: &'a [String], index: usize, name: &str) -> Result<&'a str, String> {\n    args.get(index)\n        .map(String::as_str)\n        .ok_or_else(|| format!(\"missing argument: {name}\"))\n}\n\n// legacy typecheck shadow retired\n\n// SPIRAL_PRUNE_BEGIN:bundle-zip-shadow\n#[derive(Default)]\nstruct EoieBundleReport {\n    errors: Vec<String>,\n    crate_lines: Vec<(String, usize)>,\n    public_bins: usize,\n}\n\nfn eoie_walk_crate(\n    path: &Path,\n    lines: &mut usize,\n    report: &mut EoieBundleReport,\n) -> Result<(), String> {\n    for entry in fs::read_dir(path).map_err(|error| format!(\"read {}: {error}\", path.display()))? {\n        let entry = entry.map_err(|error| error.to_string())?;\n        let child = entry.path();\n        let metadata = fs::symlink_metadata(&child).map_err(|error| error.to_string())?;\n        if metadata.file_type().is_symlink() {\n            report\n                .errors\n                .push(format!(\"symlink is forbidden: {}\", child.display()));\n        } else if metadata.is_dir() {\n            if entry.file_name() == \"src\" {\n                report\n                    .errors\n                    .push(format!(\"nested src is forbidden: {}\", child.display()));\n            }\n            eoie_walk_crate(&child, lines, report)?;\n        } else if metadata.is_file() {\n            let name = entry.file_name();\n            let name = name.to_string_lossy();\n            if name == \"lib.rs\" {\n                report\n                    .errors\n                    .push(format!(\"lib.rs is forbidden: {}\", child.display()));\n            }\n            let source_file = matches!(\n                child.extension().and_then(|value| value.to_str()),\n                Some(\"rs\" | \"spi\")\n            );\n            if !source_file && !matches!(name.as_ref(), \"Cargo.toml\" | \"package.spiproj\") {\n                report\n                    .errors\n                    .push(format!(\"unexpected crate file: {}\", child.display()));\n            }\n            if source_file {\n                *lines += fs::read_to_string(&child)\n                    .map_err(|error| error.to_string())?\n                    .lines()\n                    .count();\n            }\n        }\n    }\n    Ok(())\n}\n\nfn eoie_check_bundle(root: &Path) -> Result<EoieBundleReport, String> {\n    let mut report = EoieBundleReport::default();\n    let mut roots = BTreeSet::new();\n    for entry in\n        fs::read_dir(root).map_err(|error| format!(\"read root {}: {error}\", root.display()))?\n    {\n        let entry = entry.map_err(|error| error.to_string())?;\n        roots.insert(entry.file_name().to_string_lossy().into_owned());\n    }\n    let expected: BTreeSet<String> = [\"eoie\", \"src\", \"state\"]\n        .into_iter()\n        .map(str::to_owned)\n        .collect();\n    for unexpected in roots.difference(&expected) {\n        report\n            .errors\n            .push(format!(\"unexpected bundle root entry: {unexpected}\"));\n    }\n    for missing in expected.difference(&roots) {\n        report\n            .errors\n            .push(format!(\"missing bundle root entry: {missing}\"));\n    }\n    let state = root.join(\"state\");\n    if state.is_dir() {\n        for required in [\"package.spiproj\", \"core.spi\", \"agile.spi\"] {\n            if !state.join(required).is_file() {\n                report.errors.push(format!(\"missing state/{required}\"));\n            }\n        }\n        for entry in fs::read_dir(&state).map_err(|error| error.to_string())? {\n            let path = entry.map_err(|error| error.to_string())?.path();\n            if path.is_dir()\n                || (path.file_name().and_then(|value| value.to_str()) != Some(\"package.spiproj\")\n                    && path.extension().and_then(|value| value.to_str()) != Some(\"spi\"))\n            {\n                report\n                    .errors\n                    .push(format!(\"state must be flat Spiral: {}\", path.display()));\n            }\n        }\n    }\n    let src = root.join(\"src\");\n    if src.is_dir() {\n        for required in [\"Cargo.toml\", \"package.spiproj\"] {\n            if !src.join(required).is_file() {\n                report.errors.push(format!(\"missing src/{required}\"));\n            }\n        }\n        for entry in fs::read_dir(&src).map_err(|error| error.to_string())? {\n            let entry = entry.map_err(|error| error.to_string())?;\n            let path = entry.path();\n            if path.is_file() {\n                let name = entry.file_name().to_string_lossy().into_owned();\n                if !matches!(\n                    name.as_str(),\n                    \"Cargo.toml\" | \"Cargo.lock\" | \"package.spiproj\" | \"rustfmt.toml\"\n                ) {\n                    report\n                        .errors\n                        .push(format!(\"source root file is forbidden: {}\", path.display()));\n                }\n                continue;\n            }\n            if !path.is_dir() {\n                report.errors.push(format!(\n                    \"special source entry is forbidden: {}\",\n                    path.display()\n                ));\n                continue;\n            }\n            let source_name = entry.file_name().to_string_lossy().into_owned();\n            if source_name == \".cargo\" {\n                if !path.join(\"config.toml\").is_file() {\n                    report\n                        .errors\n                        .push(\"missing src/.cargo/config.toml\".to_owned());\n                }\n                continue;\n            }\n            if source_name == \"vendor\" {\n                for vendor_entry in fs::read_dir(&path).map_err(|error| error.to_string())? {\n                    let vendor_entry = vendor_entry.map_err(|error| error.to_string())?;\n                    let vendor_path = vendor_entry.path();\n                    let metadata =\n                        fs::symlink_metadata(&vendor_path).map_err(|error| error.to_string())?;\n                    if metadata.file_type().is_symlink() || !metadata.is_dir() {\n                        report\n                            .errors\n                            .push(format!(\"invalid vendor entry: {}\", vendor_path.display()));\n                    } else if !vendor_path.join(\"Cargo.toml\").is_file()\n                        || !vendor_path.join(\".cargo-checksum.json\").is_file()\n                    {\n                        report.errors.push(format!(\n                            \"incomplete vendored crate: {}\",\n                            vendor_path.display()\n                        ));\n                    }\n                }\n                continue;\n            }\n            for required in [\"Cargo.toml\", \"package.spiproj\"] {\n                if !path.join(required).is_file() {\n                    report\n                        .errors\n                        .push(format!(\"missing {}/{}\", path.display(), required));\n                }\n            }\n            let cargo = fs::read_to_string(path.join(\"Cargo.toml\")).unwrap_or_default();\n            report.public_bins += cargo.match_indices(\"[[bin]]\").count();\n            let mut lines = 0usize;\n            eoie_walk_crate(&path, &mut lines, &mut report)?;\n            let name = path\n                .file_name()\n                .and_then(|value| value.to_str())\n                .unwrap_or(\"crate\")\n                .to_owned();\n            report.crate_lines.push((name.clone(), lines));\n            if lines > 1000 {\n                report\n                    .errors\n                    .push(format!(\"crate line budget exceeded: {name} has {lines}\"));\n            }\n        }\n    }\n    if report.public_bins != 1 {\n        report.errors.push(format!(\n            \"exactly one public binary required, found {}\",\n            report.public_bins\n        ));\n    }\n    let binary = root.join(\"eoie\");\n    if !binary.is_file() {\n        report.errors.push(\"root eoie binary is missing\".to_owned());\n    }\n    Ok(report)\n}\n\nfn eoie_print_bundle_report(report: &EoieBundleReport) {\n    for (name, lines) in &report.crate_lines {\n        println!(\"crate {name} lines={lines}\");\n    }\n    for error in &report.errors {\n        eprintln!(\"bundle error: {error}\");\n    }\n}\n\nfn eoie_collect_files(root: &Path, path: &Path, files: &mut Vec<PathBuf>) -> Result<(), String> {\n    for entry in fs::read_dir(path).map_err(|error| format!(\"read {}: {error}\", path.display()))? {\n        let entry = entry.map_err(|error| error.to_string())?;\n        let child = entry.path();\n        let metadata = fs::symlink_metadata(&child).map_err(|error| error.to_string())?;\n        if metadata.file_type().is_symlink() {\n            return Err(format!(\"bundle contains symlink: {}\", child.display()));\n        }\n        if metadata.is_dir() {\n            eoie_collect_files(root, &child, files)?;\n        } else if metadata.is_file() {\n            files.push(\n                child\n                    .strip_prefix(root)\n                    .map_err(|error| error.to_string())?\n                    .to_path_buf(),\n            );\n        } else {\n            return Err(format!(\n                \"bundle contains special entry: {}\",\n                child.display()\n            ));\n        }\n    }\n    Ok(())\n}\n\nfn eoie_zip_entries(archive: &Path) -> Result<Vec<String>, String> {\n    let output = Command::new(\"unzip\")\n        .arg(\"-Z1\")\n        .arg(archive)\n        .output()\n        .map_err(|error| format!(\"spawn unzip: {error}\"))?;\n    if !output.status.success() {\n        return Err(\"zip listing failed\".to_owned());\n    }\n    String::from_utf8(output.stdout)\n        .map(|text| text.lines().map(str::to_owned).collect())\n        .map_err(|error| error.to_string())\n}\n\nfn eoie_safe_archive_entry(value: &str) -> bool {\n    !value.is_empty()\n        && Path::new(value)\n            .components()\n            .all(|component| matches!(component, Component::Normal(_)))\n}\n\nfn eoie_verify_flat_zip(archive: &Path) -> Result<usize, String> {\n    let entries = eoie_zip_entries(archive)?;\n    if entries.is_empty() {\n        return Err(\"zip is empty\".to_owned());\n    }\n    let mut unique = BTreeSet::new();\n    for entry in &entries {\n        if entry.ends_with('/') || !eoie_safe_archive_entry(entry) || !unique.insert(entry.clone())\n        {\n            return Err(format!(\"unsafe or duplicate zip entry: {entry}\"));\n        }\n    }\n    if !entries.iter().any(|entry| entry == \"eoie\")\n        || !entries.iter().any(|entry| entry.starts_with(\"src/\"))\n        || !entries.iter().any(|entry| entry.starts_with(\"state/\"))\n    {\n        return Err(\"zip is wrapped or missing eoie/src/state roots\".to_owned());\n    }\n    Ok(entries.len())\n}\n\nfn eoie_bundle(args: &[String]) -> Result<(), String> {\n    match eoie_arg(args, 0, \"subcommand\")? {\n        \"check\" => {\n            let root = Path::new(eoie_arg(args, 1, \"root\")?);\n            let report = eoie_check_bundle(root)?;\n            eoie_print_bundle_report(&report);\n            if !report.errors.is_empty() {\n                return Err(format!(\n                    \"bundle contract failed with {} errors\",\n                    report.errors.len()\n                ));\n            }\n            println!(\"eoie bundle check ok public_binaries=1\");\n            Ok(())\n        }\n        \"create\" => {\n            let root =\n                fs::canonicalize(eoie_arg(args, 1, \"root\")?).map_err(|error| error.to_string())?;\n            let output_arg = Path::new(eoie_arg(args, 2, \"output.zip\")?);\n            let output = if output_arg.is_absolute() {\n                output_arg.to_path_buf()\n            } else {\n                env::current_dir()\n                    .map_err(|error| error.to_string())?\n                    .join(output_arg)\n            };\n            let report = eoie_check_bundle(&root)?;\n            eoie_print_bundle_report(&report);\n            if !report.errors.is_empty() {\n                return Err(\"bundle contract failed\".to_owned());\n            }\n            if output.starts_with(&root) {\n                return Err(\"zip output must be outside bundle root\".to_owned());\n            }\n            if output.exists() {\n                fs::remove_file(&output).map_err(|error| error.to_string())?;\n            }\n            let mut files = Vec::new();\n            eoie_collect_files(&root, &root, &mut files)?;\n            files.sort();\n            let status = Command::new(\"zip\")\n                .current_dir(&root)\n                .arg(\"-0\")\n                .arg(\"-X\")\n                .arg(\"-q\")\n                .arg(&output)\n                .args(&files)\n                .status()\n                .map_err(|error| format!(\"spawn zip: {error}\"))?;\n            if !status.success() {\n                return Err(\"zip creation failed\".to_owned());\n            }\n            let count = eoie_verify_flat_zip(&output)?;\n            println!(\n                \"eoie bundle create ok entries={count} output={}\",\n                output.display()\n            );\n            Ok(())\n        }\n        \"verify\" => {\n            let archive = Path::new(eoie_arg(args, 1, \"archive.zip\")?);\n            let count = eoie_verify_flat_zip(archive)?;\n            println!(\"eoie bundle verify ok entries={count}\");\n            Ok(())\n        }\n        _ => Err(\"bundle supports check, create, verify\".to_owned()),\n    }\n}\n\n// SPIRAL_PRUNE_END:bundle-zip-shadow\n\nfn eoie_proxy(args: &[String]) -> Result<(), String> {\n    let subcommand = eoie_arg(args, 0, \"subcommand\")?;\n    match subcommand {\n        \"fs-list\" => {\n            let root = Path::new(eoie_arg(args, 1, \"root\")?);\n            let relative = args.get(2).map(String::as_str).unwrap_or(\".\");\n            let path = if relative == \".\" {\n                root.to_path_buf()\n            } else {\n                eoie_rooted(root, relative)?\n            };\n            let names = eoie_list_names(&path)?;\n            for name in names {\n                println!(\"{name}\");\n            }\n            Ok(())\n        }\n        \"fs-read\" => {\n            let root = Path::new(eoie_arg(args, 1, \"root\")?);\n            let path = eoie_rooted(root, eoie_arg(args, 2, \"relative\")?)?;\n            let limit: usize = args\n                .get(3)\n                .map(|value| value.parse())\n                .transpose()\n                .map_err(|_| \"invalid byte limit\".to_owned())?\n                .unwrap_or(usize::MAX);\n            let shown = eoie_read_limited(&path, limit)?;\n            io::Write::write_all(&mut io::stdout(), &shown).map_err(|error| error.to_string())?;\n            Ok(())\n        }\n        \"fs-write\" => {             let root = Path::new(eoie_arg(args, 1, \"root\")?);             let path = eoie_rooted(root, eoie_arg(args, 2, \"relative\")?)?;             let usage = \"usage: eoie proxy fs-write <root> <relative> [--replace-existing] [--expect-hash <sha256>] [--expect-nonempty] [--] <text>; creating a missing file needs no replace flag\";             if args.len() < 4 { return Err(format!(\"fs-write requires an explicit payload argument; {usage}\")); }             let mut replace_existing = false;             let mut expect_hash: Option<&str> = None;             let mut expect_nonempty = false;             let mut payload_start = 3usize;             if args.get(3).is_some_and(|value| eoie_legacy_operations_proxy_write_token_code(value) < 4) {                 let mut index = 3usize;                 let mut separator_seen = false;                 while index < args.len() {                     match eoie_legacy_operations_proxy_write_token_code(args[index].as_str()) {                         0 => { replace_existing = true; index += 1; }                         1 => { index += 1; expect_hash = Some(eoie_arg(args, index, \"sha256\")?); index += 1; }                         2 => { expect_nonempty = true; index += 1; }                         3 => { payload_start = index + 1; separator_seen = true; break; }                         _ => return Err(format!(\"unexpected fs-write option: {}; {usage}\", args[index])),                     }                 }                 if !separator_seen { return Err(format!(\"guarded fs-write requires -- before the payload; {usage}\")); }             }             let text = args[payload_start..].join(\" \");             let existed = path.exists();             let original = if existed { Some(fs::read(&path).map_err(|error| format!(\"read {} before replace: {error}\", path.display()))?) } else { None };             if existed {                 if !replace_existing { return Err(format!(\"fs-write refuses to overwrite existing file without --replace-existing: {}; {usage}\", path.display())); }\n                if expect_nonempty && original.as_ref().is_some_and(Vec::is_empty) { return Err(format!(\"fs-write --expect-nonempty rejected empty target: {}\", path.display())); }\n                if let Some(expected) = expect_hash {                     let observed = eoie_proxy_search::inspection_file_sha256(&path)?;                     if observed != expected { return Err(format!(\"fs-write expected hash mismatch path={} expected={} observed={}\", path.display(), expected, observed)); }                 }             } else if replace_existing || expect_hash.is_some() || expect_nonempty {                 return Err(format!(\"fs-write replacement preconditions require an existing file: {}; {usage}\", path.display()));             }             eoie_atomic_write(&path, text.as_bytes())?;             let observed = fs::read(&path).map_err(|error| format!(\"readback {}: {error}\", path.display()))?;             if observed != text.as_bytes() {                 if let Some(original) = original.as_ref() { let _ = eoie_atomic_write(&path, original); } else { let _ = eoie_remove_leaf_nofollow(&path); }                 return Err(\"fs-write readback mismatch; prior state restored\".to_owned());             }             println!(\"eoie proxy fs-write ok mode={} path={} bytes={} replace_existing={} expect_hash={} expect_nonempty={}\", if existed {\"replace\"} else {\"create\"}, path.display(), text.len(), i32::from(replace_existing), i32::from(expect_hash.is_some()), i32::from(expect_nonempty));             Ok(()) }\n        \"text-replace\" => {\n            if args.len() != 6 {\n                return Err(\"text-replace expects mode, root, relative, old, new\".to_owned());\n            }\n            let mode = eoie_arg(args, 1, \"check|apply\")?;\n            let root = Path::new(eoie_arg(args, 2, \"root\")?);\n            let path = eoie_rooted(root, eoie_arg(args, 3, \"relative\")?)?;\n            let old = eoie_arg(args, 4, \"old\")?;\n            let new = eoie_arg(args, 5, \"new\")?;\n            let regular_and_nonempty = if path.is_file() && !old.is_empty() { 1 } else { 0 };\n            let distinct_payloads = if old != new { 1 } else { 0 };\n            if eoie_legacy_operations_proxy_exact_replace_preflight_binding(regular_and_nonempty, distinct_payloads) != 1 {\n                return Err(\"text-replace preflight rejected target or payloads\".to_owned());\n            }\n            let original = fs::read_to_string(&path)\n                .map_err(|error| format!(\"read {}: {error}\", path.display()))?;\n            let matches = original.match_indices(old).count();\n            let mode_valid = if mode == \"check\" || mode == \"apply\" { 1 } else { 0 };\n            if eoie_legacy_operations_proxy_exact_replace_authorize_binding(matches as i32, mode_valid) != 1 {\n                return Err(format!(\"text-replace requires one match and a valid mode, observed matches={matches} mode={mode}\"));\n            }\n            let updated = original.replacen(old, new, 1);\n            match mode {\n                \"check\" => {\n                    let candidate_exact = if updated != original { 1 } else { 0 };\n                    if eoie_legacy_operations_proxy_exact_replace_verify_binding(candidate_exact, 1) != 1 {\n                        return Err(\"text-replace check verification rejected candidate\".to_owned());\n                    }\n                    println!(\"eoie proxy text-replace ok mode=check path={} matches=1 bytes_before={} bytes_after={}\", path.display(), original.len(), updated.len());\n                    Ok(())\n                }\n                \"apply\" => {\n                    eoie_atomic_write(&path, updated.as_bytes())?;\n                    let observed = fs::read_to_string(&path)\n                        .map_err(|error| format!(\"readback {}: {error}\", path.display()))?;\n                    if observed != updated {\n                        let _ = eoie_atomic_write(&path, original.as_bytes());\n                        return Err(\"text-replace readback mismatch; original restored\".to_owned());\n                    }\n                    if eoie_legacy_operations_proxy_exact_replace_verify_binding(1, 1) != 1 {\n                        let _ = eoie_atomic_write(&path, original.as_bytes());\n                        return Err(\"text-replace policy verification rejected commit; original restored\".to_owned());\n                    }\n                    println!(\"eoie proxy text-replace ok mode=apply path={} matches=1 bytes_before={} bytes_after={}\", path.display(), original.len(), updated.len());\n                    Ok(())\n                }\n                _ => Err(\"text-replace mode must be check or apply\".to_owned()),\n            }\n        }\n        \"fs-remove\" => {\n            let root = Path::new(eoie_arg(args, 1, \"root\")?);\n            let path = eoie_rooted(root, eoie_arg(args, 2, \"relative\")?)?;\n            eoie_remove_leaf_nofollow(&path)?;\n            Ok(())\n        }\n        \"fs-remove-tree\" => {\n            let root = Path::new(eoie_arg(args, 1, \"root\")?);\n            let relative = eoie_arg(args, 2, \"relative\")?;\n            let missing_ok = args.get(3).map(String::as_str) == Some(\"--missing-ok\");\n            if args.len() > 4 || (args.len() == 4 && !missing_ok) { return Err(\"fs-remove-tree expects root relative [--missing-ok]\".to_owned()); }\n            if missing_ok { let safe = eoie_safe_relative(relative)?; let candidate = root.join(&safe); if !candidate.exists() { println!(\"eoie proxy fs-remove-tree ok removed=0 missing_ok=1\"); return Ok(()); } }\n            let path = eoie_rooted(root, relative)?;\n            let count = eoie_remove_tree_within(root, &path)?;\n            println!(\"eoie proxy fs-remove-tree ok removed={count} missing_ok={}\", i32::from(missing_ok));\n            Ok(())\n        }\n        \"run\" => {             let usage = \"usage: eoie proxy run --cwd <directory> --program <program> [--timeout-ms <ms>] [--env KEY=VALUE]... [--unset KEY]... [-- <args...>]\";             if args.len() < 2 { return Err(format!(\"proxy run requires a working directory and program; {usage}\")); }                              let mut timeout_ms = 300000u64;                 let mut cwd: Option<&str> = None;                 let mut program: Option<&str> = None;                 let mut env_pairs: Vec<(String, String)> = Vec::new();                 let mut unset_keys: Vec<String> = Vec::new();                 let mut child_args: Vec<String> = Vec::new();                 let mut tail = false;                 let mut index = 1usize;                 while index < args.len() {                     if tail { child_args.push(args[index].clone()); index += 1; continue; }                     match eoie_legacy_operations_proxy_run_token_code(args[index].as_str()) {                         0 => {                             index += 1;                             timeout_ms = eoie_arg(args, index, \"timeout-ms\")?.parse::<u64>().map_err(|_| format!(\"proxy run --timeout-ms must be an integer; {usage}\"))?;                             index += 1;                         }                         1 => { index += 1; cwd = Some(eoie_arg(args, index, \"cwd\")?); index += 1; }                         2 => { index += 1; program = Some(eoie_arg(args, index, \"program\")?); index += 1; }                         3 => {                             index += 1;                             let cell = eoie_arg(args, index, \"KEY=VALUE\")?;                             let (key, value) = cell.split_once('=').ok_or_else(|| format!(\"proxy run --env expects KEY=VALUE, got {cell}; {usage}\"))?;                             if key.is_empty() { return Err(format!(\"proxy run --env key cannot be empty; {usage}\")); }                             env_pairs.push((key.to_owned(), value.to_owned()));                             index += 1;                         }                         4 => {                             index += 1;                             let key = eoie_arg(args, index, \"KEY\")?;                             if key.is_empty() || key.contains('=') { return Err(format!(\"proxy run --unset expects an environment key, got {key}; {usage}\")); }                             unset_keys.push(key.to_owned());                             index += 1;                         }                         5 => { tail = true; index += 1; }                         _ => return Err(format!(\"unexpected proxy run argument: {}; {usage}\", args[index])),                     }                 }                 let cwd = cwd.ok_or_else(|| format!(\"proxy run named mode requires --cwd; {usage}\"))?;                 let program = program.ok_or_else(|| format!(\"proxy run named mode requires --program; {usage}\"))?;                 let root = Path::new(cwd);                 if !root.is_dir() { return Err(format!(\"proxy run --cwd is not a directory: {}; {usage}\", root.display())); }                 let mut command = Command::new(program);                 command.current_dir(root).args(&child_args);                 for (key, value) in &env_pairs { command.env(key, value); }                 for key in &unset_keys { command.env_remove(key); }                 let observation = eoie_run_bounded_streaming_checked(&mut command, timeout_ms, \"proxy-run\", None)?;                 println!(\"eoie proxy run ok mode=named cwd={} program={} timeout_ms={timeout_ms} elapsed_ms={} env_set={} env_unset={}\", root.display(), program, observation.elapsed_ms, env_pairs.len(), unset_keys.len());                 Ok(())\n        }\n        \"spiral-session-shutdown\" => {\n            let compiler = eoie_arg(args, 1, \"compiler\")?;\n            let timeout_ms = args\n                .get(2)\n                .map(|value| value.parse::<u64>())\n                .transpose()\n                .map_err(|_| \"invalid timeout-ms\".to_owned())?\n                .unwrap_or(30000);\n            let status = eoie_shutdown_spiral_sessions(compiler, timeout_ms)?;\n            if !status.success() {\n                return Err(\"Spiral session shutdown failed\".to_owned());\n            }\n            println!(\"eoie proxy spiral-session-shutdown ok timeout_ms={timeout_ms}\");\n            Ok(())\n        }\n        // SPIRAL_PRUNE_BEGIN:zip-extract-shadow\n        \"zip-extract-shadow\" => {\n            let archive = Path::new(eoie_arg(args, 1, \"archive.zip\")?);\n            let destination = Path::new(eoie_arg(args, 2, \"destination\")?);\n            let entries = eoie_zip_entries(archive)?;\n            if entries.is_empty()\n                || entries\n                    .iter()\n                    .any(|entry| !eoie_safe_archive_entry(entry.trim_end_matches('/')))\n            {\n                return Err(\"unsafe or empty zip\".to_owned());\n            }\n            fs::create_dir_all(destination).map_err(|error| error.to_string())?;\n            let status = Command::new(\"unzip\")\n                .arg(\"-q\")\n                .arg(archive)\n                .arg(\"-d\")\n                .arg(destination)\n                .status()\n                .map_err(|error| error.to_string())?;\n            if !status.success() {\n                return Err(\"zip extraction failed\".to_owned());\n            }\n            eoie_reject_links(destination)?;\n            println!(\"eoie proxy zip-extract ok entries={}\", entries.len());\n            Ok(())\n        }\n        // SPIRAL_PRUNE_END:zip-extract-shadow\n        \"prune-build-cache\" => {\n            let root = Path::new(eoie_arg(args, 1, \"root\")?);\n            let relative = eoie_safe_relative(eoie_arg(args, 2, \"relative-target\")?)?;\n            if relative.file_name().and_then(|value| value.to_str()) != Some(\"target\") {\n                return Err(\"build cache path must end in target\".to_owned());\n            }\n            let target = root.join(&relative);\n            if !target.exists() {\n                println!(\"eoie proxy prune-build-cache ok removed=0\");\n                return Ok(());\n            }\n            let canonical_root = fs::canonicalize(root).map_err(|error| error.to_string())?;\n            let metadata = fs::symlink_metadata(&target).map_err(|error| error.to_string())?;\n            if metadata.file_type().is_symlink() {\n                return Err(\"target cannot be a symlink\".to_owned());\n            }\n            let canonical_target = fs::canonicalize(&target).map_err(|error| error.to_string())?;\n            if canonical_target == canonical_root || !canonical_target.starts_with(&canonical_root)\n            {\n                return Err(\"target escapes root\".to_owned());\n            }\n            let count = eoie_remove_tree_within(root, &target)?;\n            println!(\"eoie proxy prune-build-cache ok removed={count}\");\n            Ok(())\n        }\n        \"differential-compare\" => eoie_differential_compare(args),\n        \"coverage-assess\" => eoie_coverage_assess_family(args),\n        \"coverage-run\" => eoie_coverage_run_family(args),\n        \"toolchain\" => eoie_toolchain_run_family(args),\n        \"source-stats\" => eoie_source_stats_run_family(args),\n        \"source-topology\" => eoie_source_topology_run_family(args),\n        \"ingest-map\" => eoie_ingest_map_run_family(args),\n        \"ingest-trim-check\" => eoie_ingest_trim_run_family(args),\n        \"ingest-extracted-manifest\" => eoie_ingest_extracted_run_family(args),\n        \"ingest-targets\" => eoie_ingest_targets_run_family(args),\n        \"ingest-targets-derive\" => eoie_ingest_targets_derive_run_family(args),\n        \"frontier-map\" => eoie_frontier_map_run_family(args),\n        \"spi-map\" | \"source-map\" => eoie_source_map_run_family(args),\n        \"cold-rebuild-matrix\" => eoie_cold_rebuild_matrix_run_family(args),\n        \"spi-diff\" | \"source-diff\" => eoie_source_diff_run_family(args),\n        \"prune-uncovered\" => eoie_prune_uncovered_family(args),\n        _ => Err(\"unknown proxy operation\".to_owned()),\n    }\n}\n\nfn eoie_normalized_text(path: &Path) -> Result<String, String> {\n    let source =\n        fs::read_to_string(path).map_err(|error| format!(\"read {}: {error}\", path.display()))?;\n    Ok(source\n        .replace(\"\\r\\n\", \"\\n\")\n        .lines()\n        .map(str::trim_end)\n        .collect::<Vec<_>>()\n        .join(\"\\n\"))\n}\n\nfn eoie_fnv1a(text: &str) -> u64 {\n    text.as_bytes()\n        .iter()\n        .fold(0xcbf29ce484222325u64, |hash, byte| {\n            (hash ^ u64::from(*byte)).wrapping_mul(0x100000001b3)\n        })\n}\n\nfn eoie_differential_compare(args: &[String]) -> Result<(), String> {\n    let root = Path::new(eoie_arg(args, 1, \"root\")?);\n    let oracle = eoie_rooted(root, eoie_arg(args, 2, \"oracle-relative\")?)?;\n    let direct = eoie_rooted(root, eoie_arg(args, 3, \"direct-relative\")?)?;\n    let receipt = eoie_rooted(root, eoie_arg(args, 4, \"receipt-relative\")?)?;\n    if args.len() != 5 {\n        return Err(\"differential-compare expects root, oracle, direct, receipt\".to_owned());\n    }\n    let oracle_text = eoie_normalized_text(&oracle)?;\n    let direct_text = eoie_normalized_text(&direct)?;\n    if oracle_text != direct_text {\n        let mismatch = oracle_text\n            .bytes()\n            .zip(direct_text.bytes())\n            .position(|(a, b)| a != b)\n            .unwrap_or(oracle_text.len().min(direct_text.len()));\n        return Err(format!(\n            \"differential mismatch at normalized byte {mismatch}\"\n        ));\n    }\n    let hash = eoie_fnv1a(&oracle_text);\n    eoie_atomic_write(\n        &receipt,\n        format!(\n            \"route=normalized-text\\nfnv1a={hash:016x}\\nbytes={}\\n\",\n            oracle_text.len()\n        )\n        .as_bytes(),\n    )?;\n    println!(\n        \"eoie proxy differential-compare ok fnv1a={hash:016x} bytes={}\",\n        oracle_text.len()\n    );\n    Ok(())\n}\n\n// SPIRAL_PRUNE_BEGIN:zip-helper-shadow\nfn eoie_reject_links(path: &Path) -> Result<(), String> {\n    for entry in fs::read_dir(path).map_err(|error| error.to_string())? {\n        let child = entry.map_err(|error| error.to_string())?.path();\n        let metadata = fs::symlink_metadata(&child).map_err(|error| error.to_string())?;\n        if metadata.file_type().is_symlink() {\n            return Err(format!(\n                \"extracted zip contains symlink: {}\",\n                child.display()\n            ));\n        }\n        if metadata.is_dir() {\n            eoie_reject_links(&child)?;\n        }\n    }\n    Ok(())\n}\n\n// SPIRAL_PRUNE_END:zip-helper-shadow\n\n// SPIRAL_PRUNE_BEGIN:coverage-shadow\nfn eoie_lcov_state(lcov: &Path, source: &Path) -> Result<Option<bool>, String> {\n    let text =\n        fs::read_to_string(lcov).map_err(|error| format!(\"read {}: {error}\", lcov.display()))?;\n    let canonical = fs::canonicalize(source).unwrap_or_else(|_| source.to_path_buf());\n    let canonical_text = canonical.to_string_lossy().replace('\\\\', \"/\");\n    let mut active = false;\n    let mut found = false;\n    let mut covered = false;\n    for line in text.lines() {\n        if let Some(value) = line.strip_prefix(\"SF:\") {\n            let normalized = value.replace('\\\\', \"/\");\n            active = normalized == canonical_text\n                || canonical_text.ends_with(&normalized)\n                || normalized.ends_with(&canonical_text);\n            found |= active;\n        } else if active {\n            if let Some(value) = line.strip_prefix(\"DA:\") {\n                let hits = value\n                    .split(',')\n                    .nth(1)\n                    .and_then(|part| part.parse::<u64>().ok())\n                    .unwrap_or(0);\n                covered |= hits > 0;\n            } else if line == \"end_of_record\" {\n                active = false;\n            }\n        }\n    }\n    Ok(if found { Some(covered) } else { None })\n}\n\nfn eoie_escape_spi(value: &str) -> String {\n    value\n        .replace('\\\\', \"\\\\\\\\\")\n        .replace('\"', \"\\\\\\\"\")\n        .replace('\\n', \"\\\\n\")\n        .replace('\\r', \"\\\\r\")\n}\n\nfn eoie_lcov_lines(path: &Path) -> Result<BTreeMap<String, u64>, String> {\n    let text =\n        fs::read_to_string(path).map_err(|error| format!(\"read {}: {error}\", path.display()))?;\n    let mut file = String::new();\n    let mut lines: BTreeMap<String, u64> = BTreeMap::new();\n    for line in text.lines() {\n        if let Some(value) = line.strip_prefix(\"SF:\") {\n            let normalized = value.replace('\\\\', \"/\");\n            file = normalized\n                .rsplit_once(\"/src/\")\n                .map_or_else(|| normalized.clone(), |(_, tail)| tail.to_owned());\n        } else if let Some(value) = line.strip_prefix(\"DA:\") {\n            let mut parts = value.split(',');\n            let number = parts.next().unwrap_or(\"0\");\n            let hits = parts\n                .next()\n                .and_then(|part| part.parse::<u64>().ok())\n                .unwrap_or(0);\n            let key = format!(\"{file}:{number}\");\n            lines\n                .entry(key)\n                .and_modify(|seen| *seen = (*seen).max(hits))\n                .or_insert(hits);\n        }\n    }\n    Ok(lines)\n}\n\nfn eoie_coverage_ratio(lines: &BTreeMap<String, u64>) -> u32 {\n    if lines.is_empty() {\n        0\n    } else {\n        (lines.values().filter(|hits| **hits > 0).count() * 1000 / lines.len()) as u32\n    }\n}\n\npub fn eoie_coverage_assess(args: &[String]) -> Result<(), String> {\n    let test = eoie_lcov_lines(Path::new(eoie_arg(args, 1, \"test.lcov\")?))?;\n    let smoke = eoie_lcov_lines(Path::new(eoie_arg(args, 2, \"smoke.lcov\")?))?;\n    let test_floor = eoie_arg(args, 3, \"test-floor\")?\n        .parse::<u32>()\n        .map_err(|_| \"coverage floors must be permille integers\".to_owned())?;\n    let smoke_floor = eoie_arg(args, 4, \"smoke-floor\")?\n        .parse::<u32>()\n        .map_err(|_| \"coverage floors must be permille integers\".to_owned())?;\n    let combined_floor = eoie_arg(args, 5, \"combined-floor\")?\n        .parse::<u32>()\n        .map_err(|_| \"coverage floors must be permille integers\".to_owned())?;\n    let mut combined = test.clone();\n    for (key, hits) in &smoke {\n        combined\n            .entry(key.clone())\n            .and_modify(|seen| *seen = (*seen).max(*hits))\n            .or_insert(*hits);\n    }\n    let test_ratio = eoie_coverage_ratio(&test);\n    let smoke_ratio = eoie_coverage_ratio(&smoke);\n    let combined_ratio = eoie_coverage_ratio(&combined);\n    println!(\n        \"eoie coverage assess test={test_ratio}/1000 smoke={smoke_ratio}/1000 combined={combined_ratio}/1000 lines={}\",\n        combined.len()\n    );\n    if test_ratio < test_floor || smoke_ratio < smoke_floor || combined_ratio < combined_floor {\n        return Err(format!(\n            \"coverage floor failed test={test_ratio}/{test_floor} smoke={smoke_ratio}/{smoke_floor} combined={combined_ratio}/{combined_floor}\"\n        ));\n    }\n    Ok(())\n}\n\npub fn eoie_prune_uncovered(args: &[String]) -> Result<(), String> {\n    let root = Path::new(eoie_arg(args, 1, \"root\")?);\n    let relative = eoie_arg(args, 2, \"relative\")?;\n    let test_lcov = Path::new(eoie_arg(args, 3, \"test.lcov\")?);\n    let smoke_lcov = Path::new(eoie_arg(args, 4, \"smoke.lcov\")?);\n    let separator = args\n        .iter()\n        .position(|value| value == \"--\")\n        .ok_or_else(|| \"prune-uncovered requires -- command args\".to_owned())?;\n    if separator < 5 || separator + 1 >= args.len() {\n        return Err(\"prune-uncovered requires a validation command\".to_owned());\n    }\n    let source = eoie_rooted(root, relative)?;\n    let test_state = eoie_lcov_state(test_lcov, &source)?;\n    let smoke_state = eoie_lcov_state(smoke_lcov, &source)?;\n    if test_state != Some(false) || smoke_state != Some(false) {\n        return Err(format!(\n            \"prune refused: coverage evidence must exist and be zero in both profiles, test={test_state:?} smoke={smoke_state:?}\"\n        ));\n    }\n    let hash = inspection_file_sha256(&source)?;\n    let backup = source.with_extension(format!(\"eoie-prune-{}\", std::process::id()));\n    fs::rename(&source, &backup).map_err(|error| format!(\"stage prune: {error}\"))?;\n    let program = &args[separator + 1];\n    let status = Command::new(program)\n        .current_dir(root)\n        .args(&args[separator + 2..])\n        .status()\n        .map_err(|error| format!(\"spawn validation: {error}\"));\n    if !status.as_ref().is_ok_and(std::process::ExitStatus::success) {\n        let _ = fs::rename(&backup, &source);\n        return Err(format!(\n            \"prune validation failed and was rolled back: {status:?}\"\n        ));\n    }\n    let receipt = root.join(\"state/prune_receipts.spi\");\n    let original_receipts = fs::read_to_string(&receipt)\n        .map_err(|error| format!(\"read {}: {error}\", receipt.display()))?;\n    let marker = \"inl main () : i32 = 0i32\";\n    if !original_receipts.contains(marker) {\n        let _ = fs::rename(&backup, &source);\n        return Err(\"prune receipt ledger has no main marker\".to_owned());\n    }\n    let command_text = args[separator + 1..].join(\" \");\n    let bundle_id = env::var(\"EOIE_BUNDLE_ID\").unwrap_or_else(|_| \"external\".to_owned());\n    let entry = format!(\n        \"inl receipt_{} () : prune_receipt = PruneReceipt (\\\"{}\\\", \\\"{}\\\", \\\"{}\\\", \\\"{}\\\")\\n\",\n        std::process::id(),\n        eoie_escape_spi(relative),\n        eoie_escape_spi(&hash),\n        eoie_escape_spi(&command_text),\n        eoie_escape_spi(&bundle_id)\n    );\n    let updated = original_receipts.replacen(marker, &format!(\"{entry}{marker}\"), 1);\n    if let Err(error) = eoie_atomic_write(&receipt, updated.as_bytes()) {\n        let _ = fs::rename(&backup, &source);\n        return Err(format!(\"write prune receipt: {error}\"));\n    }\n    if let Err(error) = eoie_typecheck(&receipt) {\n        let _ = eoie_atomic_write(&receipt, original_receipts.as_bytes());\n        let _ = fs::rename(&backup, &source);\n        return Err(format!(\n            \"prune receipt failed and deletion was rolled back: {error}\"\n        ));\n    }\n    if let Err(error) = fs::remove_file(&backup) {\n        let _ = eoie_atomic_write(&receipt, original_receipts.as_bytes());\n        let _ = fs::rename(&backup, &source);\n        return Err(format!(\"commit prune: {error}\"));\n    }\n    println!(\"eoie proxy prune-uncovered ok relative={relative} sha256={hash}\");\n    Ok(())\n}\n// SPIRAL_PRUNE_END:coverage-shadow\n"
