nominal multi_patch_raw = ()
nominal multi_patch_indexed = ()
nominal multi_patch_ordered = ()
nominal multi_patch_fresh = ()
nominal multi_patch_authorized = ()
nominal multi_patch_committed = ()

union multi_patch_policy =
    | RejectEmptyBatch
    | RejectSingleFileBatch
    | RejectDuplicateTarget
    | RejectOrderInversion
    | RejectStaleWitness
    | RejectAmbiguousMode
    | RejectPartialRollback
    | AuthorizeMultiFileApply
    | AuthorizeMultiFileCheck

union multi_patch_op from to =
    | IndexPatchBatch :: multi_patch_op multi_patch_raw multi_patch_indexed
    | OrderPatchBatch :: multi_patch_op multi_patch_indexed multi_patch_ordered
    | VerifyPatchFreshness :: multi_patch_op multi_patch_ordered multi_patch_fresh
    | AuthorizePatchBatch :: multi_patch_op multi_patch_fresh multi_patch_authorized
    | CommitPatchBatch :: multi_patch_op multi_patch_authorized multi_patch_committed

union rec multi_patch_plan from to =
    | MultiPatchStep :: forall from to. multi_patch_op from to -> multi_patch_plan from to
    | MultiPatchThen :: forall from to. (exists middle. multi_patch_plan from middle * multi_patch_plan middle to) -> multi_patch_plan from to

inl multi_patch_public_plan () : multi_patch_plan multi_patch_raw multi_patch_committed =
    MultiPatchThen (exists (
        MultiPatchStep IndexPatchBatch,
        MultiPatchThen (exists (
            MultiPatchStep OrderPatchBatch,
            MultiPatchThen (exists (
                MultiPatchStep VerifyPatchFreshness,
                MultiPatchThen (exists (
                    MultiPatchStep AuthorizePatchBatch,
                    MultiPatchStep CommitPatchBatch
                ))
            ))
        ))
    ))

let multi_patch_shape_binding (files : i32) (places : i32) (operations : i32) : i32 =
    if !!!!LT(files,2i32) then 0i32
    elif !!!!LT(places,files) then 0i32
    elif !!!!LT(operations,places) then 0i32
    else 1i32

let multi_patch_topology_binding (collisions : i32) (inversions : i32) : i32 =
    if !!!!LT(collisions,0i32) then 0i32
    elif !!!!LT(inversions,0i32) then 0i32
    elif !!!!LT(0i32,collisions) then 0i32
    elif !!!!LT(0i32,inversions) then 0i32
    else 1i32

let multi_patch_freshness_binding (expected : i32) (observed : i32) : i32 =
    if !!!!LT(expected,1i32) then 0i32
    elif !!!!LT(observed,1i32) then 0i32
    elif !!!!LT(expected,observed) then 0i32
    elif !!!!LT(observed,expected) then 0i32
    else 1i32

let multi_patch_mode_binding (apply_mode : i32) (check_mode : i32) : i32 =
    if !!!!LT(apply_mode,0i32) then 0i32
    elif !!!!LT(check_mode,0i32) then 0i32
    elif !!!!LT(1i32,apply_mode) then 0i32
    elif !!!!LT(1i32,check_mode) then 0i32
    elif !!!!LT(apply_mode,1i32) then
        if !!!!LT(check_mode,1i32) then 0i32 else 1i32
    else
        if !!!!LT(check_mode,1i32) then 1i32 else 0i32

let multi_patch_rollback_binding (touched : i32) (restored : i32) : i32 =
    if !!!!LT(touched,2i32) then 0i32
    elif !!!!LT(restored,2i32) then 0i32
    elif !!!!LT(touched,restored) then 0i32
    elif !!!!LT(restored,touched) then 0i32
    else 1i32

let multi_patch_commit_binding (authorized : i32) (operations : i32) : i32 =
    if !!!!LT(authorized,1i32) then 0i32
    elif !!!!LT(1i32,authorized) then 0i32
    elif !!!!LT(operations,2i32) then 0i32
    else operations
