nominal parallel_search_raw = ()
nominal parallel_search_rooted = ()
nominal parallel_search_scanned = ()
nominal parallel_search_sorted = ()
nominal parallel_search_reported = ()

union parallel_search_policy =
    | RejectUnsafeRoot
    | RejectEmptyNeedle
    | EnforcePositiveLimit
    | UseRayonWorkers
    | CompareSerialAndParallel
    | SortDeterministically
    | TagRelativePaths
    | MaterializeConsumerOutput

union parallel_search_op from to =
    | ValidateParallelSearch :: parallel_search_op parallel_search_raw parallel_search_rooted
    | ScanParallelSearch :: parallel_search_op parallel_search_rooted parallel_search_scanned
    | SortParallelSearch :: parallel_search_op parallel_search_scanned parallel_search_sorted
    | ReportParallelSearch :: parallel_search_op parallel_search_sorted parallel_search_reported

union rec parallel_search_plan from to =
    | ParallelSearchStep :: forall from to. parallel_search_op from to -> parallel_search_plan from to
    | ParallelSearchThen :: forall from to. (exists middle. parallel_search_plan from middle * parallel_search_plan middle to) -> parallel_search_plan from to

inl parallel_search_public_plan () : parallel_search_plan parallel_search_raw parallel_search_reported =
    ParallelSearchThen (exists (
        ParallelSearchStep ValidateParallelSearch,
        ParallelSearchThen (exists (
            ParallelSearchStep ScanParallelSearch,
            ParallelSearchThen (exists (
                ParallelSearchStep SortParallelSearch,
                ParallelSearchStep ReportParallelSearch
            ))
        ))
    ))

let parallel_search_request_binding (flags : i32) (limit : i32) : i32 =
    if !!!!LT(flags,0i32) then 0i32
    elif !!!!LT(0i32,flags) then 0i32
    elif !!!!LT(limit,1i32) then 0i32
    else 1i32

let parallel_search_worker_binding (workers : i32) (available : i32) : i32 =
    if !!!!LT(workers,1i32) then 0i32
    elif !!!!LT(available,workers) then 0i32
    else 1i32

let parallel_search_parity_binding (serial_count : i32) (parallel_count : i32) : i32 =
    if !!!!LT(serial_count,0i32) then 0i32
    elif !!!!LT(parallel_count,0i32) then 0i32
    elif !!!!EQ(serial_count,parallel_count) then 1i32
    else 0i32

let parallel_manifest_order_binding (is_sorted : i32) (is_unique : i32) : i32 =
    if !!!!LT(is_sorted,1i32) then 0i32
    elif !!!!LT(is_unique,1i32) then 0i32
    else 1i32

let parallel_manifest_parity_binding (serial_fingerprint : i32) (parallel_fingerprint : i32) : i32 =
    if !!!!EQ(serial_fingerprint,parallel_fingerprint) then 1i32
    else 0i32

let parallel_consumer_mode_binding (mode : i32) (output_segments : i32) : i32 =
    if !!!!LT(mode,0i32) then 0i32
    elif !!!!LT(1i32,mode) then 0i32
    elif !!!!LT(output_segments,1i32) then 0i32
    else 1i32

let parallel_consumer_output_binding (expected_fingerprint : i32) (output_fingerprint : i32) : i32 =
    if !!!!EQ(expected_fingerprint,output_fingerprint) then 1i32 else 0i32
