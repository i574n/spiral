open model

let proxy_parallel_search_request_binding (flags : i32) (limit : i32) : i32 =
    parallel_search_request_binding flags limit

let proxy_parallel_search_worker_binding (workers : i32) (available : i32) : i32 =
    parallel_search_worker_binding workers available

let proxy_parallel_search_parity_binding (serial_count : i32) (parallel_count : i32) : i32 =
    parallel_search_parity_binding serial_count parallel_count

let proxy_parallel_manifest_order_binding (is_sorted : i32) (is_unique : i32) : i32 =
    parallel_manifest_order_binding is_sorted is_unique

let proxy_parallel_manifest_parity_binding (serial_fingerprint : i32) (parallel_fingerprint : i32) : i32 =
    parallel_manifest_parity_binding serial_fingerprint parallel_fingerprint

let proxy_parallel_consumer_mode_binding (mode : i32) (output_segments : i32) : i32 =
    parallel_consumer_mode_binding mode output_segments

let proxy_parallel_consumer_output_binding (expected_fingerprint : i32) (output_fingerprint : i32) : i32 =
    parallel_consumer_output_binding expected_fingerprint output_fingerprint

let proxy_hash_tree_request_binding (root_valid : i32) (relative_segments : i32) : i32 =
    hash_integrity_contract.model.tree_request_binding root_valid relative_segments
