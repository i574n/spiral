open parallel_search_contract.model

inl main () : i32 =
    match parallel_search_request_binding 1i32 0i32 with
    | 0 =>
        match parallel_search_worker_binding 57i32 56i32 with
        | 0 =>
            match parallel_search_parity_binding 8i32 9i32 with
            | 0 =>
                match parallel_manifest_order_binding 1i32 0i32 with
                | 0 =>
                    match parallel_manifest_parity_binding 7i32 8i32 with
                    | 0 =>
                        match parallel_consumer_mode_binding 2i32 0i32 with
                        | 0 =>
                            match parallel_consumer_output_binding 1i32 2i32 with
                            | 0 => 0i32
                            | _ => 7i32
                        | _ => 6i32
                    | _ => 5i32
                | _ => 4i32
            | _ => 3i32
        | _ => 2i32
    | _ => 1i32
