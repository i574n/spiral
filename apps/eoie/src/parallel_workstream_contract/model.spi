nominal workstream_draft = ()
nominal workstream_validated = ()
nominal workstream_executed = ()
nominal workstream_receipted = ()

nominal merge_unchecked = ()
nominal merge_validated = ()
nominal merge_committed = ()

nominal owner_search = ()
nominal owner_agile = ()
nominal owner_handoff = ()
nominal owner_nil = ()
nominal owner_cons head tail = ()

union owner_distinct left right =
    | SearchDistinctAgile :: owner_distinct owner_search owner_agile
    | SearchDistinctHandoff :: owner_distinct owner_search owner_handoff
    | AgileDistinctSearch :: owner_distinct owner_agile owner_search
    | AgileDistinctHandoff :: owner_distinct owner_agile owner_handoff
    | HandoffDistinctSearch :: owner_distinct owner_handoff owner_search
    | HandoffDistinctAgile :: owner_distinct owner_handoff owner_agile

union rec owner_absent owner owners =
    | OwnerAbsentNil :: forall owner. owner_absent owner owner_nil
    | OwnerAbsentCons :: forall owner head tail. owner_distinct owner head * owner_absent owner tail -> owner_absent owner (owner_cons head tail)

union workstream_outcome =
    | WorkstreamPassed
    | WorkstreamFailed
    | WorkstreamCancelled

nominal workstream_coordinator_running = ()
nominal workstream_coordinator_failed = ()
nominal workstream_sibling_running = ()
nominal workstream_sibling_staged = ()
nominal workstream_sibling_promoted = ()
nominal workstream_sibling_cancelled = ()

union workstream_coordinator_op from to =
    | ObserveSiblingFailure :: workstream_coordinator_op workstream_coordinator_running workstream_coordinator_failed

union workstream_sibling_op coordinator owner from to =
    | StageSiblingOutput :: forall coordinator owner. workstream_sibling_op coordinator owner workstream_sibling_running workstream_sibling_staged
    | PromoteSiblingOutput :: forall owner. workstream_sibling_op workstream_coordinator_running owner workstream_sibling_staged workstream_sibling_promoted
    | CancelSiblingOutput :: forall owner. workstream_sibling_op workstream_coordinator_failed owner workstream_sibling_staged workstream_sibling_cancelled

union workstream_cancellation_plan owner =
    | CancelAfterFailure :: forall owner. workstream_sibling_op workstream_coordinator_running owner workstream_sibling_running workstream_sibling_staged * workstream_coordinator_op workstream_coordinator_running workstream_coordinator_failed * workstream_sibling_op workstream_coordinator_failed owner workstream_sibling_staged workstream_sibling_cancelled -> workstream_cancellation_plan owner

union workstream_receipt baseline owner =
    | WorkstreamReceipt :: forall baseline owner. u64 * u64 * u32 * workstream_outcome -> workstream_receipt baseline owner

union rec workstream_batch baseline owners =
    | WorkstreamNil :: forall baseline. workstream_batch baseline owner_nil
    | WorkstreamCons :: forall baseline owner tail. owner_absent owner tail * workstream_receipt baseline owner * workstream_batch baseline tail -> workstream_batch baseline (owner_cons owner tail)

union workstream_op baseline owner from to =
    | ValidateOwnerWorkstream :: forall baseline owner. workstream_op baseline owner workstream_draft workstream_validated
    | ExecuteOwnerWorkstream :: forall baseline owner. workstream_op baseline owner workstream_validated workstream_executed
    | CommitOwnerReceipt :: forall baseline owner. workstream_op baseline owner workstream_executed workstream_receipted

union rec workstream_plan baseline owner from to =
    | WorkstreamStep :: forall baseline owner from to. workstream_op baseline owner from to -> workstream_plan baseline owner from to
    | WorkstreamThen :: forall baseline owner from to. (exists middle. workstream_plan baseline owner from middle * workstream_plan baseline owner middle to) -> workstream_plan baseline owner from to

union merge_op baseline owners from to =
    | ValidateWorkstreamBatch :: forall baseline owners. workstream_batch baseline owners -> merge_op baseline owners merge_unchecked merge_validated
    | CommitWorkstreamBatch :: forall baseline owners. workstream_batch baseline owners -> merge_op baseline owners merge_validated merge_committed

union rec merge_plan baseline owners from to =
    | MergeStep :: forall baseline owners from to. merge_op baseline owners from to -> merge_plan baseline owners from to
    | MergeThen :: forall baseline owners from to. (exists middle. merge_plan baseline owners from middle * merge_plan baseline owners middle to) -> merge_plan baseline owners from to

let workstream_receipt_binding (baseline_match : i32) (owner_scope_match : i32) (exit_status : i32) (elapsed_ms : i32) : i32 =
    if !!!!LT(baseline_match,1i32) then 0i32
    elif !!!!LT(1i32,baseline_match) then 0i32
    elif !!!!LT(owner_scope_match,1i32) then 0i32
    elif !!!!LT(1i32,owner_scope_match) then 0i32
    elif !!!!LT(exit_status,0i32) then 0i32
    elif !!!!LT(elapsed_ms,0i32) then 0i32
    else 1i32

let workstream_parallel_binding (requested_workers : i32) (available_workers : i32) (started : i32) (completed : i32) : i32 =
    if !!!!LT(requested_workers,2i32) then 0i32
    elif !!!!LT(available_workers,requested_workers) then 0i32
    elif !!!!LT(started,1i32) then 0i32
    elif !!!!LT(completed,0i32) then 0i32
    elif !!!!LT(started,completed) then 0i32
    else 1i32

let workstream_concurrency_binding (owners : i32) (outer_ms : i32) (sum_owner_ms : i32) (max_owner_ms : i32) : i32 =
    if !!!!LT(owners,2i32) then 0i32
    elif !!!!LT(outer_ms,max_owner_ms) then 0i32
    elif !!!!LT(sum_owner_ms,outer_ms) then 0i32
    elif !!!!EQ(sum_owner_ms,outer_ms) then 0i32
    else 1i32

let workstream_completion_binding (expected : i32) (started : i32) (passed : i32) (failed : i32) (cancelled : i32) (receipts : i32) : i32 =
    inl partial = !!!!Add(passed,failed)
    inl total = !!!!Add(partial,cancelled)
    if !!!!LT(expected,1i32) then 0i32
    elif !!!!LT(started,0i32) then 0i32
    elif !!!!LT(passed,0i32) then 0i32
    elif !!!!LT(failed,0i32) then 0i32
    elif !!!!LT(cancelled,0i32) then 0i32
    elif !!!!LT(receipts,0i32) then 0i32
    elif !!!!LT(started,expected) then 0i32
    elif !!!!LT(expected,started) then 0i32
    elif !!!!LT(receipts,expected) then 0i32
    elif !!!!LT(expected,receipts) then 0i32
    elif !!!!EQ(total,expected) then 1i32
    else 0i32

let workstream_merge_binding (receipts : i32) (expected : i32) (baseline_match : i32) (owners_unique : i32) (outputs_verified : i32) : i32 =
    if !!!!LT(receipts,1i32) then 0i32
    elif !!!!LT(receipts,expected) then 0i32
    elif !!!!LT(expected,receipts) then 0i32
    elif !!!!LT(baseline_match,1i32) then 0i32
    elif !!!!LT(1i32,baseline_match) then 0i32
    elif !!!!LT(owners_unique,1i32) then 0i32
    elif !!!!LT(1i32,owners_unique) then 0i32
    elif !!!!LT(outputs_verified,1i32) then 0i32
    elif !!!!LT(1i32,outputs_verified) then 0i32
    else 1i32

let workstream_merge_authorization_binding (expected : i32) (passed : i32) (failed : i32) (cancelled : i32) (receipts : i32) (baseline_match : i32) (owners_unique : i32) (outputs_verified : i32) : i32 =
    inl completion = workstream_completion_binding expected expected passed failed cancelled receipts
    if !!!!LT(completion,1i32) then 0i32
    elif !!!!LT(1i32,completion) then 0i32
    elif !!!!LT(passed,expected) then 0i32
    elif !!!!LT(expected,passed) then 0i32
    elif !!!!LT(failed,0i32) then 0i32
    elif !!!!LT(0i32,failed) then 0i32
    elif !!!!LT(cancelled,0i32) then 0i32
    elif !!!!LT(0i32,cancelled) then 0i32
    else workstream_merge_binding receipts expected baseline_match owners_unique outputs_verified

let workstream_failure_binding (passed : i32) (failed : i32) (cancelled : i32) (merge_attempted : i32) : i32 =
    if !!!!LT(passed,0i32) then 0i32
    elif !!!!LT(failed,0i32) then 0i32
    elif !!!!LT(cancelled,0i32) then 0i32
    elif !!!!LT(merge_attempted,0i32) then 0i32
    elif !!!!LT(1i32,merge_attempted) then 0i32
    elif !!!!LT(0i32,failed) then if !!!!LT(merge_attempted,1i32) then 1i32 else 0i32
    elif !!!!LT(0i32,cancelled) then if !!!!LT(merge_attempted,1i32) then 1i32 else 0i32
    elif !!!!LT(passed,1i32) then 0i32
    else 1i32

let workstream_cancel_before_promotion_binding (failure_observed : i32) (siblings_in_flight : i32) (cancel_requested : i32) (staged_after_failure : i32) (promoted_after_cancel : i32) (canonical_changes : i32) (staging_discarded : i32) : i32 =
    if !!!!LT(failure_observed,1i32) then 0i32
    elif !!!!LT(1i32,failure_observed) then 0i32
    elif !!!!LT(siblings_in_flight,1i32) then 0i32
    elif !!!!LT(cancel_requested,1i32) then 0i32
    elif !!!!LT(1i32,cancel_requested) then 0i32
    elif !!!!LT(staged_after_failure,0i32) then 0i32
    elif !!!!LT(siblings_in_flight,staged_after_failure) then 0i32
    elif !!!!LT(promoted_after_cancel,0i32) then 0i32
    elif !!!!LT(0i32,promoted_after_cancel) then 0i32
    elif !!!!LT(canonical_changes,0i32) then 0i32
    elif !!!!LT(0i32,canonical_changes) then 0i32
    elif !!!!LT(siblings_in_flight,staging_discarded) then 0i32
    elif !!!!LT(staging_discarded,staged_after_failure) then 0i32
    elif !!!!LT(staged_after_failure,staging_discarded) then 0i32
    else 1i32
