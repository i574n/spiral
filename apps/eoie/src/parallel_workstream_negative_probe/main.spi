open parallel_workstream_contract.model

inl main () : i32 =
    inl concurrency = workstream_concurrency_binding 3i32 133i32 133i32 45i32
    inl completion = workstream_completion_binding 3i32 3i32 1i32 1i32 1i32 3i32
    inl merge_authorized = workstream_merge_authorization_binding 3i32 1i32 1i32 1i32 3i32 1i32 1i32 1i32
    inl cancel_unsafe = workstream_cancel_before_promotion_binding 1i32 2i32 1i32 2i32 1i32 0i32 2i32
    inl canonical_unsafe = workstream_cancel_before_promotion_binding 1i32 2i32 1i32 2i32 0i32 1i32 2i32
    inl negative_guard =
        if !!!!EQ(concurrency,0i32) then
            if !!!!EQ(completion,1i32) then
                if !!!!EQ(merge_authorized,0i32) then
                    if !!!!EQ(cancel_unsafe,0i32) then
                        if !!!!EQ(canonical_unsafe,0i32) then 0i32 else 1i32
                    else 1i32
                else 1i32
            else 1i32
        else 1i32
    match workstream_receipt_binding negative_guard 1i32 0i32 1i32 with
    | 0 =>
        match workstream_parallel_binding 1i32 56i32 3i32 3i32 with
        | 0 =>
            match workstream_merge_binding 2i32 3i32 1i32 1i32 1i32 with
            | 0 =>
                match workstream_merge_binding 3i32 3i32 0i32 1i32 1i32 with
                | 0 =>
                    match workstream_merge_binding 3i32 3i32 1i32 0i32 1i32 with
                    | 0 =>
                        match workstream_failure_binding 2i32 1i32 0i32 1i32 with
                        | 0 =>
                            match workstream_failure_binding 2i32 1i32 0i32 0i32 with
                            | 1 => 0i32
                            | _ => 7i32
                        | _ => 6i32
                    | _ => 5i32
                | _ => 4i32
            | _ => 3i32
        | _ => 2i32
    | _ => 1i32
