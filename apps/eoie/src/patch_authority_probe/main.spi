inl eq_i32 (a : i32) (b : i32) : bool = !!!!EQ(a,b)
inl minus_one () : i32 = !!!!Neg(1i32)

inl fallback_complete_route (role : i32) (before_hash : i32) (after_hash : i32) : i32 =
    inl role = patch_fallback_domain.patch_route_role_binding role role
    inl role = patch_fallback_domain.patch_route_forward_binding role 1i32
    inl role = patch_fallback_domain.patch_route_restore_binding role 1i32
    patch_fallback_domain.patch_route_complete_binding role (patch_fallback_domain.patch_route_hash_binding before_hash after_hash)

inl control_ok () : bool =
    inl m = minus_one ()
    eq_i32 (patch_control_domain.patch_witness_authorized 2i32 2i32) 1i32 &&
    eq_i32 (patch_control_domain.patch_witness_authorized 2i32 1i32) 0i32 &&
    eq_i32 (patch_control_domain.patch_witness_authorized 0i32 0i32) 0i32 &&
    eq_i32 (patch_control_domain.patch_operation_authorized 0i32 0i32) 1i32 &&
    eq_i32 (patch_control_domain.patch_operation_authorized 0i32 1i32) 0i32 &&
    eq_i32 (patch_control_domain.patch_operation_next 0i32 2i32) 1i32 &&
    eq_i32 (patch_control_domain.patch_operation_next 1i32 2i32) 2i32 &&
    eq_i32 (patch_control_domain.patch_operation_next 2i32 2i32) m &&
    eq_i32 (patch_control_domain.patch_match_authorized 1i32 1i32) 1i32 &&
    eq_i32 (patch_control_domain.patch_match_authorized 0i32 1i32) 0i32 &&
    eq_i32 (patch_control_domain.patch_match_authorized 2i32 1i32) 0i32 &&
    eq_i32 (patch_control_domain.patch_match_authorized 1i32 0i32) 0i32 &&
    eq_i32 (patch_control_domain.patch_commit_authorized 2i32 2i32) 1i32 &&
    eq_i32 (patch_control_domain.patch_commit_authorized 2i32 1i32) 0i32 &&
    eq_i32 (patch_control_domain.restoration_payload_identity 3i32 3i32) 3i32 &&
    eq_i32 (patch_control_domain.restoration_payload_identity 3i32 2i32) m &&
    eq_i32 (patch_control_domain.restoration_payload_slot_binding 3i32 1i32) 3i32 &&
    eq_i32 (patch_control_domain.restoration_payload_slot_binding 3i32 0i32) m &&
    eq_i32 (patch_control_domain.restoration_payload_outcome_binding 3i32 1i32) 3i32 &&
    eq_i32 (patch_control_domain.restoration_payload_outcome_binding 3i32 2i32) 3i32 &&
    eq_i32 (patch_control_domain.restoration_payload_outcome_binding 3i32 0i32) m &&
    eq_i32 (patch_control_domain.restoration_payload_outcome_binding 3i32 3i32) m

inl effect_ok () : bool =
    inl m = minus_one ()
    inl identity = patch_effect_domain.patch_guard_identity 2i32 4i32
    inl identity = patch_effect_domain.patch_guard_needle_binding identity 3i32
    inl identity = patch_effect_domain.patch_guard_match_binding identity 1i32
    inl identity = patch_effect_domain.patch_guard_operation_binding identity 1i32
    inl write = patch_effect_domain.patch_write_bytes_authorized 4i32 4i32
    inl rename = patch_effect_domain.patch_authority_pair (patch_effect_domain.patch_rename_stage_authorized 1i32 1i32) (patch_effect_domain.patch_rename_slot_authorized 7i32 7i32)
    eq_i32 identity 2i32 &&
    eq_i32 (patch_effect_domain.patch_guard_identity 2i32 m) m &&
    eq_i32 (patch_effect_domain.patch_guard_needle_binding 2i32 0i32) m &&
    eq_i32 (patch_effect_domain.patch_guard_match_binding 2i32 2i32) m &&
    eq_i32 (patch_effect_domain.patch_guard_operation_binding 2i32 0i32) m &&
    eq_i32 (patch_effect_domain.patch_read_limit_binding 10i32 10i32) 10i32 &&
    eq_i32 (patch_effect_domain.patch_read_limit_binding 10i32 11i32) m &&
    eq_i32 (patch_effect_domain.patch_read_receipt_binding 4i32 4i32) 4i32 &&
    eq_i32 (patch_effect_domain.patch_read_receipt_binding 4i32 3i32) m &&
    eq_i32 (patch_effect_domain.patch_stage_identity 1i32 7i32) 7i32 &&
    eq_i32 (patch_effect_domain.patch_stage_identity m 7i32) m &&
    eq_i32 (patch_effect_domain.patch_write_slot_binding 7i32 write) 7i32 &&
    eq_i32 (patch_effect_domain.patch_write_slot_binding 7i32 (patch_effect_domain.patch_write_bytes_authorized 4i32 3i32)) m &&
    eq_i32 (patch_effect_domain.patch_rename_slot_binding 7i32 rename) 7i32 &&
    eq_i32 (patch_effect_domain.patch_rename_stage_authorized 1i32 0i32) 0i32 &&
    eq_i32 (patch_effect_domain.patch_remove_receipt_binding 1i32 1i32) 1i32 &&
    eq_i32 (patch_effect_domain.patch_remove_receipt_binding 1i32 0i32) m

inl driver_ok () : bool =
    inl m = minus_one ()
    eq_i32 (patch_driver_domain.patch_driver_witness_binding 1i32 2i32) 2i32 &&
    eq_i32 (patch_driver_domain.patch_driver_witness_binding 0i32 2i32) m &&
    eq_i32 (patch_driver_domain.patch_driver_operation_binding 0i32 0i32) 1i32 &&
    eq_i32 (patch_driver_domain.patch_driver_operation_binding 1i32 1i32) 2i32 &&
    eq_i32 (patch_driver_domain.patch_driver_operation_binding 1i32 0i32) m &&
    eq_i32 (patch_driver_domain.patch_driver_stage_count_binding 2i32 2i32) 2i32 &&
    eq_i32 (patch_driver_domain.patch_driver_stage_count_binding 2i32 1i32) m &&
    eq_i32 (patch_driver_domain.patch_driver_promotion_binding 0i32 0i32) 1i32 &&
    eq_i32 (patch_driver_domain.patch_driver_promotion_binding 1i32 1i32) 2i32 &&
    eq_i32 (patch_driver_domain.patch_driver_complete_binding 2i32 2i32) 1i32 &&
    eq_i32 (patch_driver_domain.patch_driver_complete_binding 2i32 1i32) 0i32

inl orchestration_ok () : bool =
    inl m = minus_one ()
    inl c1 = patch_orchestration_domain.main.orchestration_operation_binding 0i32 0i32
    inl c2 = patch_orchestration_domain.main.orchestration_operation_binding c1 1i32
    inl guard = patch_orchestration_domain.main.orchestration_guard_identity 1i32 4i32
    inl guard = patch_orchestration_domain.main.orchestration_guard_needle_binding guard 3i32
    inl stages = patch_orchestration_domain.main.orchestration_stage_binding 2i32 2i32
    inl p1 = patch_orchestration_domain.main.orchestration_promotion_binding 0i32 0i32
    inl p2 = patch_orchestration_domain.main.orchestration_promotion_binding p1 1i32
    eq_i32 (patch_orchestration_domain.main.orchestration_witness_binding 2i32 2i32) 2i32 &&
    eq_i32 c2 2i32 &&
    eq_i32 (patch_orchestration_domain.main.orchestration_guard_match_binding guard 1i32) 1i32 &&
    eq_i32 (patch_orchestration_domain.main.orchestration_guard_match_binding guard 2i32) m &&
    eq_i32 (patch_orchestration_domain.main.orchestration_complete_binding stages p2) 1i32 &&
    eq_i32 (patch_orchestration_domain.main.orchestration_complete_binding 2i32 1i32) 0i32 &&
    eq_i32 (patch_orchestration_domain.main.orchestration_operation_binding 0i32 1i32) m

inl fallback_ok () : bool =
    inl m = minus_one ()
    inl candidate = fallback_complete_route 0i32 71i32 71i32
    inl primary = fallback_complete_route 1i32 71i32 71i32
    inl secondary = fallback_complete_route 2i32 71i32 71i32
    eq_i32 (patch_fallback_domain.patch_route_agreement_binding candidate primary) 1i32 &&
    eq_i32 (patch_fallback_domain.patch_route_agreement_binding primary secondary) 1i32 &&
    eq_i32 (patch_fallback_domain.patch_route_hash_binding 71i32 72i32) 0i32 &&
    eq_i32 (patch_fallback_domain.patch_route_complete_binding 0i32 0i32) 0i32 &&
    eq_i32 (patch_fallback_domain.patch_route_role_binding 0i32 1i32) m &&
    eq_i32 (patch_fallback_domain.patch_route_role_binding 3i32 3i32) m &&
    eq_i32 (patch_fallback_domain.patch_route_forward_binding 0i32 0i32) m &&
    eq_i32 (patch_fallback_domain.patch_route_restore_binding m 1i32) m &&
    eq_i32 (patch_fallback_domain.patch_route_agreement_binding 1i32 0i32) 0i32

inl main () : i32 =
    if control_ok () && effect_ok () && driver_ok () && orchestration_ok () && fallback_ok () then 0i32 else 1i32
