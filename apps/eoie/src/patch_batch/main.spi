inl fixture_paths () : model.two_file_paths = { target_a = "/tmp/eoie-patch-batch-target-a.txt"; stage_a = "/tmp/eoie-patch-batch-stage-a.txt"; backup_a = "/tmp/eoie-patch-batch-backup-a.txt"; target_b = "/tmp/eoie-patch-batch-target-b.txt"; stage_b = "/tmp/eoie-patch-batch-stage-b.txt"; backup_b = "/tmp/eoie-patch-batch-backup-b.txt" }
inl fixture_contents () : model.two_file_contents = { original_a = "original-a"; original_b = "original-b"; changed_a = "changed-a"; changed_b = "changed-b" }

inl main () : i32 =
    inl _ = model.static_probe_result ()
    inl paths = fixture_paths ()
    inl contents = fixture_contents ()
    inl passed = model.run_fault patch_model.model.FailBetweenPromotions contents paths
    inl unsupported = if model.run_fault patch_model.model.NoFault contents paths then false else true
    inl missing_rename = if rust_std_fs.model.rename "/tmp/eoie-patch-batch-missing.txt" "/tmp/eoie-patch-batch-missing-promoted.txt" then false else true
    inl cleaned = model.cleanup paths
    inl cleaned_again = model.cleanup paths
    if passed && unsupported && missing_rename && cleaned && cleaned_again then 0i32 else 1i32
