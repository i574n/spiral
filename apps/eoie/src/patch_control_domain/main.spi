
inl export_restoration_payload_identity () : () =
    !!!!Export("eoie_patch_restoration_payload_identity", ((fun (first, second) => restoration_payload_identity first second) : i32 * i32 -> i32))

inl export_restoration_payload_slot_binding () : () =
    !!!!Export("eoie_patch_restoration_payload_slot_binding", ((fun (first, second) => restoration_payload_slot_binding first second) : i32 * i32 -> i32))

inl export_restoration_payload_outcome_binding () : () =
    !!!!Export("eoie_patch_restoration_payload_outcome_binding", ((fun (first, second) => restoration_payload_outcome_binding first second) : i32 * i32 -> i32))

inl main () : i32 =
    inl _ = native_patch_control_plan ()
    inl _ = restoration_attempt_witness RestorationSucceeded
    inl _ = restoration_attempt_witness RestorationFailed
    inl _ = restoration_payload_identity 0i32 0i32
    inl _ = restoration_payload_slot_binding 0i32 1i32
    inl _ = restoration_payload_outcome_binding 0i32 1i32
    export_restoration_payload_identity ()
    export_restoration_payload_slot_binding ()
    export_restoration_payload_outcome_binding ()
    emit_runtime ()

    0i32
