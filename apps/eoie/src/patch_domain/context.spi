open patch_model.model

inl (~!\) forall t u. ((args : t), (code : string)) : u =
    $'Fable.Core.RustInterop.emitRustExpr !args !code '

nominal patch_source = string
nominal patch_root = string
nominal patch_context = { root : patch_root; source : patch_source }

inl context (root : string) (source : string) : patch_context =
    patch_context { root = patch_root root; source = patch_source source }

inl root (patch_context value) : string = inl (patch_root root) = value.root in root
inl source (patch_context value) : string = inl (patch_source source) = value.source in source

union quoted_result = | QuotedOk : i32 | QuotedError
union separator_result = | SeparatorOk : i32 | SeparatorError
union parsed_patch = | ParsedPatch : i32 | InvalidPatch

inl source_len (~source : string) : i32 =
    !\(source, $'"i32::try_from($0.len()).unwrap_or(i32::MAX)"')

inl source_byte (~source : string) (~index : i32) : i32 =
    !\((source, index), $'"usize::try_from($1).ok().and_then(|index| $0.as_bytes().get(index).copied()).map_or(-1, i32::from)"')

inl canonical_plan_count (~source : string) : i32 =
    !\(source, $'"canonical_plan_ir_domain::plan_ir_manifest_count(&$0)"')

inl i32_eq (a : i32) (b : i32) : bool = $"!a == !b"
inl i32_lt (a : i32) (b : i32) : bool = $"!a < !b"
inl i32_le (a : i32) (b : i32) : bool = $"!a <= !b"
inl i32_add (a : i32) (b : i32) : i32 = $"!a + !b"
inl i32_sub (a : i32) (b : i32) : i32 = $"!a - !b"
inl i32_positive (value : i32) : bool = $"0 < !value"

inl allowed_escape byte : bool =
    if i32_eq byte 110i32 then true
    elif i32_eq byte 114i32 then true
    elif i32_eq byte 116i32 then true
    elif i32_eq byte 92i32 then true
    else i32_eq byte 34i32

let rec skip_spaces source index length : i32 =
    if i32_lt index length then
        inl byte = source_byte source index
        if i32_eq byte 32i32 then skip_spaces source (i32_add index 1i32) length
        elif i32_eq byte 9i32 then skip_spaces source (i32_add index 1i32) length
        else index
    else index

let rec scan_quoted source index length : quoted_result =
    if i32_lt index length then
        inl byte = source_byte source index
        if i32_eq byte 34i32 then QuotedOk (i32_add index 1i32)
        elif i32_eq byte 92i32 then
            inl escaped_index = i32_add index 1i32
            if i32_lt escaped_index length then
                inl escaped = source_byte source escaped_index
                if allowed_escape escaped then scan_quoted source (i32_add index 2i32) length
                else QuotedError
            else QuotedError
        else scan_quoted source (i32_add index 1i32) length
    else QuotedError

inl parse_quoted source index length : quoted_result =
    if i32_lt index length then
        if i32_eq (source_byte source index) 34i32 then scan_quoted source (i32_add index 1i32) length
        else QuotedError
    else QuotedError

inl parse_separator source index length : separator_result =
    inl index = skip_spaces source index length
    if i32_lt index length then
        if i32_eq (source_byte source index) 44i32 then SeparatorOk (skip_spaces source (i32_add index 1i32) length)
        else SeparatorError
    else SeparatorError

inl safe_segment source start near_to : bool =
    inl length = i32_sub near_to start
    if i32_positive length then
        if i32_eq length 1i32 then if i32_eq (source_byte source start) 46i32 then false else true
        elif i32_eq length 2i32 then
            if i32_eq (source_byte source start) 46i32 then if i32_eq (source_byte source (i32_add start 1i32)) 46i32 then false else true
            else true
        else true
    else false

let rec safe_path_loop source index near_to segment_start : bool =
    if i32_lt index near_to then
        inl byte = source_byte source index
        if i32_eq byte 92i32 then false
        elif i32_eq byte 47i32 then
            if safe_segment source segment_start index then safe_path_loop source (i32_add index 1i32) near_to (i32_add index 1i32)
            else false
        else safe_path_loop source (i32_add index 1i32) near_to segment_start
    else safe_segment source segment_start near_to

inl safe_path source quoted_start quoted_after : bool =
    inl content_start = i32_add quoted_start 1i32
    inl content_end = i32_sub quoted_after 1i32
    inl content_length = i32_sub content_end content_start
    if i32_positive content_length then
        inl first = source_byte source content_start
        if i32_eq first 47i32 then false
        elif i32_eq first 92i32 then false
        else safe_path_loop source content_start content_end content_start
    else false

inl parse_patch source marker_index length : parsed_patch =
    inl first_quote = skip_spaces source (i32_add marker_index 12i32) length
    match parse_quoted source first_quote length with
    | QuotedOk after_path =>
        if safe_path source first_quote after_path then
            match parse_separator source after_path length with
            | SeparatorOk second_quote =>
                match parse_quoted source second_quote length with
                | QuotedOk after_before =>
                    match parse_separator source after_before length with
                    | SeparatorOk third_quote =>
                        match parse_quoted source third_quote length with
                        | QuotedOk after_after =>
                            inl end_index = skip_spaces source after_after length
                            if i32_lt end_index length then
                                if i32_eq (source_byte source end_index) 41i32 then ParsedPatch (i32_add end_index 1i32)
                                else InvalidPatch
                            else InvalidPatch
                        | QuotedError => InvalidPatch
                    | SeparatorError => InvalidPatch
                | QuotedError => InvalidPatch
            | SeparatorError => InvalidPatch
        else InvalidPatch
    | QuotedError => InvalidPatch

inl byte_at_is source index offset expected : bool =
    i32_eq (source_byte source (i32_add index offset)) expected

inl marker_at source index : bool =
    if byte_at_is source index 0i32 80i32 then
        if byte_at_is source index 1i32 97i32 then
            if byte_at_is source index 2i32 116i32 then
                if byte_at_is source index 3i32 99i32 then
                    if byte_at_is source index 4i32 104i32 then
                        if byte_at_is source index 5i32 69i32 then
                            if byte_at_is source index 6i32 120i32 then
                                if byte_at_is source index 7i32 97i32 then
                                    if byte_at_is source index 8i32 99i32 then
                                        if byte_at_is source index 9i32 116i32 then
                                            if byte_at_is source index 10i32 32i32 then byte_at_is source index 11i32 40i32
                                            else false
                                        else false
                                    else false
                                else false
                            else false
                        else false
                    else false
                else false
            else false
        else false
    else false

let rec scan_plan source index length count : patch_validation =
    if i32_lt index length then
        if marker_at source index then
            match parse_patch source index length with
            | ParsedPatch next_index => scan_plan source next_index length (i32_add count 1i32)
            | InvalidPatch => PatchPlanMalformed
        else scan_plan source (i32_add index 1i32) length count
    else if i32_positive count then PatchPlanValid count else PatchPlanEmpty

inl validate_source (patch_source source) : patch_validation =
    inl canonical_count = canonical_plan_count source
    if i32_positive canonical_count then PatchPlanValid canonical_count
    elif i32_lt canonical_count 0i32 then PatchPlanMalformed
    else
        inl length = source_len source
        if i32_lt length 0i32 then PatchPlanUnavailable
        elif i32_le length 262144i32 then scan_plan source 0i32 length 0i32
        else PatchPlanTooLarge

inl validate_context (patch_context value) : patch_validation = validate_source value.source
