let patch_driver_witness_binding (authorized : i32) (parsed : i32) : i32 =
    if !!!!LT(authorized,1i32) then -1i32
    elif !!!!LT(1i32,authorized) then -1i32
    elif !!!!LT(parsed,1i32) then -1i32
    else parsed

let patch_driver_operation_binding (cursor : i32) (observed : i32) : i32 =
    if !!!!LT(cursor,0i32) then -1i32
    elif !!!!LT(observed,0i32) then -1i32
    elif !!!!LT(cursor,observed) then -1i32
    elif !!!!LT(observed,cursor) then -1i32
    else !!!!Add(cursor,1i32)

let patch_driver_stage_count_binding (expected : i32) (observed : i32) : i32 =
    if !!!!LT(expected,0i32) then -1i32
    elif !!!!LT(observed,0i32) then -1i32
    elif !!!!LT(expected,observed) then -1i32
    elif !!!!LT(observed,expected) then -1i32
    else expected

let patch_driver_promotion_binding (cursor : i32) (observed : i32) : i32 =
    patch_driver_operation_binding cursor observed

let patch_driver_complete_binding (expected : i32) (observed : i32) : i32 =
    if !!!!LT(expected,0i32) then 0i32
    elif !!!!LT(observed,0i32) then 0i32
    elif !!!!LT(expected,observed) then 0i32
    elif !!!!LT(observed,expected) then 0i32
    else 1i32