open source_authoring_contract.bindings


inl main () : i32 =
    source_authoring_terminal.emit_runtime ()
    inl _ = source_authoring_shape_binding 1i32 1i32
    inl _ = source_authoring_template_binding 1i32 1i32
    inl _ = source_authoring_render_binding 1i32 0i32
    inl _ = source_authoring_freshness_binding 1i32 1i32
    inl _ = source_authoring_mode_binding 0i32 0i32
    inl _ = source_authoring_commit_binding 1i32 1i32
    !!!!Export("eoie_patch_driver_source_authoring_shape_binding", ((fun (first, second) => source_authoring_shape_binding first second) : i32 * i32 -> i32))
    !!!!Export("eoie_patch_driver_source_authoring_template_binding", ((fun (first, second) => source_authoring_template_binding first second) : i32 * i32 -> i32))
    !!!!Export("eoie_patch_driver_source_authoring_render_binding", ((fun (first, second) => source_authoring_render_binding first second) : i32 * i32 -> i32))
    !!!!Export("eoie_patch_driver_source_authoring_freshness_binding", ((fun (first, second) => source_authoring_freshness_binding first second) : i32 * i32 -> i32))
    !!!!Export("eoie_patch_driver_source_authoring_mode_binding", ((fun (first, second) => source_authoring_mode_binding first second) : i32 * i32 -> i32))
    !!!!Export("eoie_patch_driver_source_authoring_commit_binding", ((fun (first, second) => source_authoring_commit_binding first second) : i32 * i32 -> i32))

    0i32
