
inl main () : i32 =
    inl _ = native_patch_effect_plan ()
    inl _ = patch_read_limit_binding 1i32 1i32
    inl _ = patch_read_receipt_binding 1i32 1i32
    inl _ = patch_stage_identity 0i32 0i32
    inl _ = patch_write_bytes_authorized 1i32 1i32
    inl _ = patch_write_slot_binding 0i32 1i32
    inl _ = patch_rename_stage_authorized 0i32 0i32
    inl _ = patch_rename_slot_authorized 0i32 0i32
    inl _ = patch_authority_pair 1i32 1i32
    inl _ = patch_rename_slot_binding 0i32 1i32
    inl _ = patch_remove_receipt_binding 0i32 1i32
    !!!!Export("eoie_patch_read_limit_binding", ((fun (first, second) => patch_read_limit_binding first second) : i32 * i32 -> i32))
    !!!!Export("eoie_patch_read_receipt_binding", ((fun (first, second) => patch_read_receipt_binding first second) : i32 * i32 -> i32))
    !!!!Export("eoie_patch_stage_identity", ((fun (first, second) => patch_stage_identity first second) : i32 * i32 -> i32))
    !!!!Export("eoie_patch_write_bytes_authorized", ((fun (first, second) => patch_write_bytes_authorized first second) : i32 * i32 -> i32))
    !!!!Export("eoie_patch_write_slot_binding", ((fun (first, second) => patch_write_slot_binding first second) : i32 * i32 -> i32))
    !!!!Export("eoie_patch_rename_stage_authorized", ((fun (first, second) => patch_rename_stage_authorized first second) : i32 * i32 -> i32))
    !!!!Export("eoie_patch_rename_slot_authorized", ((fun (first, second) => patch_rename_slot_authorized first second) : i32 * i32 -> i32))
    !!!!Export("eoie_patch_authority_pair", ((fun (first, second) => patch_authority_pair first second) : i32 * i32 -> i32))
    !!!!Export("eoie_patch_rename_slot_binding", ((fun (first, second) => patch_rename_slot_binding first second) : i32 * i32 -> i32))
    !!!!Export("eoie_patch_remove_receipt_binding", ((fun (first, second) => patch_remove_receipt_binding first second) : i32 * i32 -> i32))

    0i32
