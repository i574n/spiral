    inl _ = patch_write_bytes_authorized 1i32 1i32
    inl _ = patch_write_slot_binding 0i32 1i32
    inl _ = patch_rename_stage_authorized 0i32 0i32
    inl _ = patch_rename_slot_authorized 0i32 0i32
    inl _ = patch_authority_pair 1i32 1i32
    inl _ = patch_rename_slot_binding 0i32 1i32
    inl _ = patch_remove_receipt_binding 0i32 1i32
    $"RustExportI32Binary(\"eoie_patch_read_limit_binding\",\"patch_read_limit_binding\")" : ()
    $"RustExportI32Binary(\"eoie_patch_read_receipt_binding\",\"patch_read_receipt_binding\")" : ()
    $"RustExportI32Binary(\"eoie_patch_stage_identity\",\"patch_stage_identity\")" : ()
