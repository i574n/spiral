    $"RustExportI32Binary(\"eoie_patch_rename_slot_authorized\",\"patch_rename_slot_authorized\")" : ()
    $"RustExportI32Binary(\"eoie_patch_authority_pair\",\"patch_authority_pair\")" : ()
