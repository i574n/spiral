inl rust_library () : () = $"RustLibrary()" : ()

inl main () : i32 =
    inl _ = candidate_plan ()
    inl _ = primary_fallback_plan ()
    inl _ = secondary_fallback_plan ()
    inl _ = patch_route_role_binding 0i32 0i32
    inl _ = patch_route_forward_binding 0i32 1i32
    inl _ = patch_route_restore_binding 0i32 1i32
    inl _ = patch_route_hash_binding 1i32 1i32
    inl _ = patch_route_complete_binding 0i32 1i32
    inl _ = patch_route_agreement_binding 1i32 1i32
    $"RustExportI32Binary(\"eoie_patch_route_role_binding\",\"patch_route_role_binding\")" : ()
    $"RustExportI32Binary(\"eoie_patch_route_forward_binding\",\"patch_route_forward_binding\")" : ()
    $"RustExportI32Binary(\"eoie_patch_route_restore_binding\",\"patch_route_restore_binding\")" : ()
    $"RustExportI32Binary(\"eoie_patch_route_hash_binding\",\"patch_route_hash_binding\")" : ()
    $"RustExportI32Binary(\"eoie_patch_route_complete_binding\",\"patch_route_complete_binding\")" : ()
    $"RustExportI32Binary(\"eoie_patch_route_agreement_binding\",\"patch_route_agreement_binding\")" : ()

    rust_library ()
    0i32
