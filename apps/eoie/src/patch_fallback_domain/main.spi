
inl main () : i32 =
    inl _ = candidate_plan ()
    inl _ = primary_fallback_plan ()
    inl _ = secondary_fallback_plan ()
    inl _ = patch_route_role_binding 0i32 0i32
    inl _ = patch_route_forward_binding 0i32 1i32
    inl _ = patch_route_restore_binding 0i32 1i32
    inl _ = patch_route_hash_binding 1i32 1i32
    inl _ = patch_route_complete_binding 0i32 1i32
    inl _ = patch_route_agreement_binding 1i32 1i32
    !!!!Export("eoie_patch_route_role_binding", ((fun (first, second) => patch_route_role_binding first second) : i32 * i32 -> i32))
    !!!!Export("eoie_patch_route_forward_binding", ((fun (first, second) => patch_route_forward_binding first second) : i32 * i32 -> i32))
    !!!!Export("eoie_patch_route_restore_binding", ((fun (first, second) => patch_route_restore_binding first second) : i32 * i32 -> i32))
    !!!!Export("eoie_patch_route_hash_binding", ((fun (first, second) => patch_route_hash_binding first second) : i32 * i32 -> i32))
    !!!!Export("eoie_patch_route_complete_binding", ((fun (first, second) => patch_route_complete_binding first second) : i32 * i32 -> i32))
    !!!!Export("eoie_patch_route_agreement_binding", ((fun (first, second) => patch_route_agreement_binding first second) : i32 * i32 -> i32))

    0i32
