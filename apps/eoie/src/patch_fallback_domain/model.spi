nominal candidate_idle = ()
nominal candidate_selected = ()
nominal candidate_forward_applied = ()
nominal candidate_restored = ()
nominal candidate_hash_agreed = ()

union candidate_route_step from to =
    | SelectCandidateRoute :: candidate_route_step candidate_idle candidate_selected
    | ApplyCandidateForward :: string -> candidate_route_step candidate_selected candidate_forward_applied
    | RestoreCandidateOriginal :: string -> candidate_route_step candidate_forward_applied candidate_restored
    | AgreeCandidateHash :: string -> candidate_route_step candidate_restored candidate_hash_agreed

union rec candidate_route_plan from to =
    | CandidateRouteStep :: forall from to. candidate_route_step from to -> candidate_route_plan from to
    | CandidateRouteThen :: forall from to. (exists middle. candidate_route_plan from middle * candidate_route_plan middle to) -> candidate_route_plan from to

inl candidate_plan () : candidate_route_plan candidate_idle candidate_hash_agreed =
    CandidateRouteThen (exists (
        CandidateRouteStep SelectCandidateRoute,
        CandidateRouteThen (exists (
            CandidateRouteStep (ApplyCandidateForward "forward-replacement-observed"),
            CandidateRouteThen (exists (
                CandidateRouteStep (RestoreCandidateOriginal "reverse-replacement-observed"),
                CandidateRouteStep (AgreeCandidateHash "before-and-after-hashes-match")
            ))
        ))
    ))

nominal primary_idle = ()
nominal primary_selected = ()
nominal primary_forward_applied = ()
nominal primary_restored = ()
nominal primary_hash_agreed = ()

union primary_route_step from to =
    | SelectPrimaryRoute :: primary_route_step primary_idle primary_selected
    | ApplyPrimaryForward :: string -> primary_route_step primary_selected primary_forward_applied
    | RestorePrimaryOriginal :: string -> primary_route_step primary_forward_applied primary_restored
    | AgreePrimaryHash :: string -> primary_route_step primary_restored primary_hash_agreed

union rec primary_route_plan from to =
    | PrimaryRouteStep :: forall from to. primary_route_step from to -> primary_route_plan from to
    | PrimaryRouteThen :: forall from to. (exists middle. primary_route_plan from middle * primary_route_plan middle to) -> primary_route_plan from to

inl primary_fallback_plan () : primary_route_plan primary_idle primary_hash_agreed =
    PrimaryRouteThen (exists (
        PrimaryRouteStep SelectPrimaryRoute,
        PrimaryRouteThen (exists (
            PrimaryRouteStep (ApplyPrimaryForward "forward-replacement-observed"),
            PrimaryRouteThen (exists (
                PrimaryRouteStep (RestorePrimaryOriginal "reverse-replacement-observed"),
                PrimaryRouteStep (AgreePrimaryHash "before-and-after-hashes-match")
            ))
        ))
    ))

nominal secondary_idle = ()
nominal secondary_selected = ()
nominal secondary_forward_applied = ()
nominal secondary_restored = ()
nominal secondary_hash_agreed = ()

union secondary_route_step from to =
    | SelectSecondaryRoute :: secondary_route_step secondary_idle secondary_selected
    | ApplySecondaryForward :: string -> secondary_route_step secondary_selected secondary_forward_applied
    | RestoreSecondaryOriginal :: string -> secondary_route_step secondary_forward_applied secondary_restored
    | AgreeSecondaryHash :: string -> secondary_route_step secondary_restored secondary_hash_agreed

union rec secondary_route_plan from to =
    | SecondaryRouteStep :: forall from to. secondary_route_step from to -> secondary_route_plan from to
    | SecondaryRouteThen :: forall from to. (exists middle. secondary_route_plan from middle * secondary_route_plan middle to) -> secondary_route_plan from to

inl secondary_fallback_plan () : secondary_route_plan secondary_idle secondary_hash_agreed =
    SecondaryRouteThen (exists (
        SecondaryRouteStep SelectSecondaryRoute,
        SecondaryRouteThen (exists (
            SecondaryRouteStep (ApplySecondaryForward "forward-replacement-observed"),
            SecondaryRouteThen (exists (
                SecondaryRouteStep (RestoreSecondaryOriginal "reverse-replacement-observed"),
                SecondaryRouteStep (AgreeSecondaryHash "before-and-after-hashes-match")
            ))
        ))
    ))

let patch_route_role_binding (expected_role : i32) (observed_role : i32) : i32 =
    if !!!!LT(expected_role,0i32) then -1i32
    elif !!!!LT(2i32,expected_role) then -1i32
    elif !!!!LT(expected_role,observed_role) then -1i32
    elif !!!!LT(observed_role,expected_role) then -1i32
    else expected_role

let patch_route_forward_binding (route_token : i32) (forward_outcome : i32) : i32 =
    if !!!!LT(route_token,0i32) then -1i32
    elif !!!!LT(2i32,route_token) then -1i32
    elif !!!!LT(forward_outcome,1i32) then -1i32
    elif !!!!LT(1i32,forward_outcome) then -1i32
    else route_token

let patch_route_restore_binding (route_token : i32) (restore_outcome : i32) : i32 =
    patch_route_forward_binding route_token restore_outcome

let patch_route_hash_binding (before_hash : i32) (after_hash : i32) : i32 =
    if !!!!LT(before_hash,after_hash) then 0i32
    elif !!!!LT(after_hash,before_hash) then 0i32
    else 1i32

let patch_route_complete_binding (route_token : i32) (hash_agreed : i32) : i32 =
    if !!!!LT(route_token,0i32) then 0i32
    elif !!!!LT(2i32,route_token) then 0i32
    elif !!!!LT(hash_agreed,1i32) then 0i32
    elif !!!!LT(1i32,hash_agreed) then 0i32
    else 1i32

let patch_route_agreement_binding (left_complete : i32) (right_complete : i32) : i32 =
    if !!!!LT(left_complete,1i32) then 0i32
    elif !!!!LT(1i32,left_complete) then 0i32
    elif !!!!LT(right_complete,1i32) then 0i32
    elif !!!!LT(1i32,right_complete) then 0i32
    else 1i32
