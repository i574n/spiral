nominal patch_scope = ()
nominal validated = ()
nominal staged = ()
nominal committed = ()
nominal rolled_back = ()

nominal validated_patch = { count : i32 }
nominal staged_patch = { count : i32 }
nominal committed_patch = { count : i32 }
nominal rolled_back_patch = { count : i32 }

union patch_plan scope state =
    | ValidatedPlan :: forall scope. validated_patch -> patch_plan scope validated
    | StagedPlan :: forall scope. staged_patch -> patch_plan scope staged
    | CommittedPlan :: forall scope. committed_patch -> patch_plan scope committed
    | RolledBackPlan :: forall scope. rolled_back_patch -> patch_plan scope rolled_back

union patch_transition scope from to =
    | StageTransition :: forall scope. patch_transition scope validated staged
    | CommitTransition :: forall scope. patch_transition scope staged committed
    | RollbackTransition :: forall scope. patch_transition scope staged rolled_back

inl execute forall scope from to.
    (transition : patch_transition scope from to)
    (plan : patch_plan scope from)
    : patch_plan scope to =
    match transition, plan with
    | StageTransition, ValidatedPlan payload =>
        StagedPlan (staged_patch { count = payload.count })
    | CommitTransition, StagedPlan payload =>
        CommittedPlan (committed_patch { count = payload.count })
    | RollbackTransition, StagedPlan payload =>
        RolledBackPlan (rolled_back_patch { count = payload.count })

union patch_fault =
    | NoFault
    | FailAfterStage
    | FailDuringCommit
    | FailBetweenPromotions

union transaction_outcome scope =
    | TransactionCommitted :: forall scope. patch_plan scope committed -> transaction_outcome scope
    | TransactionRolledBack :: forall scope. patch_plan scope rolled_back -> transaction_outcome scope

inl transact forall scope.
    (fault : patch_fault)
    (plan : patch_plan scope validated)
    : transaction_outcome scope =
    inl staged_plan = execute StageTransition plan
    match fault with
    | NoFault => TransactionCommitted (execute CommitTransition staged_plan)
    | FailAfterStage => TransactionRolledBack (execute RollbackTransition staged_plan)
    | FailDuringCommit => TransactionRolledBack (execute RollbackTransition staged_plan)
    | FailBetweenPromotions => TransactionRolledBack (execute RollbackTransition staged_plan)

union patch_validation =
    | PatchPlanValid : i32
    | PatchPlanEmpty
    | PatchPlanMalformed
    | PatchPlanTooLarge
    | PatchPlanUnavailable

inl validation_witness (validation : patch_validation) : i32 =
    match validation with
    | PatchPlanValid count => count
    | PatchPlanEmpty => 0i32
    | PatchPlanMalformed => -1i32
    | PatchPlanTooLarge => -2i32
    | PatchPlanUnavailable => -3i32

inl patch_domain_probe_result () : i32 = validation_witness PatchPlanEmpty

inl transaction_probe_result () : i32 =
    inl committed_plan : patch_plan patch_scope validated =
        ValidatedPlan (validated_patch { count = 2i32 })
    inl rollback_plan : patch_plan patch_scope validated =
        ValidatedPlan (validated_patch { count = 3i32 })
    inl _ = transact FailAfterStage rollback_plan
    match transact NoFault committed_plan, transact FailDuringCommit rollback_plan, transact FailBetweenPromotions rollback_plan with
    | TransactionCommitted (CommittedPlan _), TransactionRolledBack (RolledBackPlan _), TransactionRolledBack (RolledBackPlan _) => 0i32

inl outcome_is_rolled_back forall scope. (outcome : transaction_outcome scope) : bool =
    match outcome with
    | TransactionCommitted _ => false
    | TransactionRolledBack _ => true
