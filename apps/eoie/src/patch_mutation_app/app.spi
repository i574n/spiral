let patch_entry_public () : i32 = patch_mutation_contract.model.patch_entry ()

inl emit () : () =
    mutation_terminal.emit_runtime ()
    $"RustExportI32(\"eoie_patch_run\",\"patch_entry_public\")" : ()
    $"RustLibrary()" : ()
    inl _ = patch_mutation_contract.model.typed_patch_plan ()
    inl _ = patch_entry_public ()
    ()
