nominal patch_idle = ()
nominal patch_arguments_ready = ()
nominal patch_validated = ()
nominal patch_promoted = ()
nominal patch_postgate_checked = ()
nominal patch_committed = ()
nominal patch_restored = ()
nominal patch_rehearsed = ()

union patch_op from to =
    | CollectPatchArguments :: patch_op patch_idle patch_arguments_ready
    | ValidatePatchProtocol :: patch_op patch_arguments_ready patch_validated
    | CommitPatchMutation :: patch_op patch_validated patch_promoted
    | VerifyPatchPostgate :: patch_op patch_promoted patch_postgate_checked
    | ClosePatchMutation :: patch_op patch_postgate_checked patch_committed
    | RestorePatchMutation :: patch_op patch_promoted patch_restored
    | VerifyPatchRestoration :: patch_op patch_restored patch_rehearsed

union rec patch_plan from to =
    | PatchStep :: forall from to. patch_op from to -> patch_plan from to
    | PatchThen :: forall from to. (exists middle. patch_plan from middle * patch_plan middle to) -> patch_plan from to

inl typed_patch_plan () : patch_plan patch_idle patch_committed =
    PatchThen (exists (
        PatchStep CollectPatchArguments,
        PatchThen (exists (
            PatchStep ValidatePatchProtocol,
            PatchThen (exists (
                PatchStep CommitPatchMutation,
                PatchThen (exists (PatchStep VerifyPatchPostgate, PatchStep ClosePatchMutation))
            ))
        ))
    ))

inl typed_patch_rehearsal_plan () : patch_plan patch_idle patch_rehearsed =
    PatchThen (exists (
        PatchStep CollectPatchArguments,
        PatchThen (exists (
            PatchStep ValidatePatchProtocol,
            PatchThen (exists (
                PatchStep CommitPatchMutation,
                PatchThen (exists (PatchStep RestorePatchMutation, PatchStep VerifyPatchRestoration))
            ))
        ))
    ))

inl args_len_is expected : bool = rust_std_env.model.args_len_is expected
inl argument_owned index : string = rust_std_env.model.argument_owned index
inl patch_is_apply () : bool = rust_std_env.model.argument_equals 0i32 "apply"
inl patch_is_check () : bool = rust_std_env.model.argument_equals 0i32 "check"
inl patch_is_rehearse () : bool = rust_std_env.model.argument_equals 0i32 "rehearse"
inl patch_is_gated () : bool = rust_std_env.model.argument_equals 0i32 "gated"
inl i32_positive value : bool = $"0 < !value"
inl patch_usage_error () : i32 = $"patch_mutation_error(\"patch supports only: apply|check <root> <plan.spi>\")"
inl patch_rehearse_usage_error () : i32 = $"patch_mutation_error(\"patch rehearse expects: rehearse <root> <plan.spi>\")"
inl patch_gated_usage_error () : i32 = $"patch_gated_error(\"patch gated expects: gated <root> <plan.spi> <gate-program>\")"
inl patch_prepare_context (~root : string) (~plan : string) : string = $"patch_prepare_source_owned(!root.as_ref(), !plan.as_ref())"
inl patch_source_ready source : bool = i32_positive (patch_domain.context.source_len source)
inl patch_apply_context (~context : patch_domain.context.patch_context) (~count : i32) : i32 =
    inl root = patch_domain.context.root context
    inl source = patch_domain.context.source context
    $"patch_apply_context_owned(!root.as_ref(), !source.as_ref(), !count)"
inl patch_rehearse_context (~context : patch_domain.context.patch_context) (~count : i32) : i32 =
    inl root = patch_domain.context.root context
    inl source = patch_domain.context.source context
    $"patch_rehearse_context_owned(!root.as_ref(), !source.as_ref(), !count)"
inl patch_gate_timeout_ms () : u64 = 30000u64
inl patch_gated_context (~context : patch_domain.context.patch_context) (~count : i32) (~gate_program : string) (~timeout_ms : u64) : i32 =
    inl root = patch_domain.context.root context
    inl source = patch_domain.context.source context
    $"patch_gated_context_owned(!root.as_ref(), !source.as_ref(), !count, !gate_program.as_ref(), !timeout_ms)"
inl patch_check_physical (~root : string) (~source : string) (~count : i32) : i32 =
    $"patch_check_context_owned(!root.as_ref(), !source.as_ref(), !count)"
inl patch_plan_error code : i32 = $"patch_plan_error(!code)"
inl patch_check_success count : i32 = $"patch_check_success(!count)"
inl patch_preflight_error () : i32 = $"patch_preflight_error()"

inl patch_check_context root source count : i32 =
    inl observed = patch_check_physical root source count
    match patch_preflight_contract.model.patch_preflight_witness_binding count observed with
    | 1 =>
        match patch_preflight_contract.model.patch_preflight_mode_binding 0i32 1i32 with
        | 1 =>
            match patch_preflight_contract.model.patch_preflight_check_binding 0i32 0i32 with
            | 1 => patch_check_success observed
            | _ => patch_preflight_error ()
        | _ => patch_preflight_error ()
    | _ => patch_preflight_error ()

let patch_entry () : i32 =
    if args_len_is 3i32 then
        inl root = argument_owned 1i32
        inl plan = argument_owned 2i32
        inl source = patch_prepare_context root plan
        if patch_source_ready source then
            inl context = patch_domain.context.context root source
            inl count = patch_model.model.validation_witness (patch_domain.context.validate_context context)
            if patch_is_apply () then
                match patch_preflight_contract.model.patch_preflight_mode_binding 1i32 0i32 with
                | 1 => if i32_positive count then patch_apply_context context count else patch_plan_error count
                | _ => patch_preflight_error ()
            elif patch_is_check () then
                if i32_positive count then patch_check_context root source count else patch_plan_error count
            else patch_usage_error ()
        else 2i32
    else patch_usage_error ()

let patch_rehearse_entry () : i32 =
    if args_len_is 3i32 then
        inl root = argument_owned 1i32
        inl plan = argument_owned 2i32
        inl source = patch_prepare_context root plan
        if patch_source_ready source then
            inl context = patch_domain.context.context root source
            inl count = patch_model.model.validation_witness (patch_domain.context.validate_context context)
            if patch_is_rehearse () then
                if i32_positive count then patch_rehearse_context context count else patch_plan_error count
            else patch_rehearse_usage_error ()
        else 2i32
    else patch_rehearse_usage_error ()

let patch_gated_entry () : i32 =
    if args_len_is 4i32 then
        inl root = argument_owned 1i32
        inl plan = argument_owned 2i32
        inl gate_program = argument_owned 3i32
        inl source = patch_prepare_context root plan
        if patch_source_ready source then
            inl context = patch_domain.context.context root source
            inl count = patch_model.model.validation_witness (patch_domain.context.validate_context context)
            if patch_is_gated () then
                if i32_positive count then patch_gated_context context count gate_program (patch_gate_timeout_ms ()) else patch_plan_error count
            else patch_gated_usage_error ()
        else 2i32
    else patch_gated_usage_error ()
