inl rust_library () : () = $"RustLibrary()" : ()

nominal patch_orchestration_idle = ()
nominal patch_orchestration_witnessed = ()
nominal patch_orchestration_operations_complete = ()
nominal patch_orchestration_guards_complete = ()
nominal patch_orchestration_stages_complete = ()
nominal patch_orchestration_promotions_complete = ()
nominal patch_orchestration_complete = ()

union patch_orchestration_step from to =
    | BindOrchestrationWitness :: patch_orchestration_step patch_orchestration_idle patch_orchestration_witnessed
    | BindOrchestrationOperations :: patch_orchestration_step patch_orchestration_witnessed patch_orchestration_operations_complete
    | BindOrchestrationGuards :: patch_orchestration_step patch_orchestration_operations_complete patch_orchestration_guards_complete
    | BindOrchestrationStages :: patch_orchestration_step patch_orchestration_guards_complete patch_orchestration_stages_complete
    | BindOrchestrationPromotions :: patch_orchestration_step patch_orchestration_stages_complete patch_orchestration_promotions_complete
    | CompleteOrchestration :: patch_orchestration_step patch_orchestration_promotions_complete patch_orchestration_complete

union rec patch_orchestration_plan from to =
    | PatchOrchestrationStep :: forall from to. patch_orchestration_step from to -> patch_orchestration_plan from to
    | PatchOrchestrationThen :: forall from to. (exists middle. patch_orchestration_plan from middle * patch_orchestration_plan middle to) -> patch_orchestration_plan from to

inl native_patch_orchestration_plan () : patch_orchestration_plan patch_orchestration_idle patch_orchestration_complete =
    PatchOrchestrationThen (exists (
        PatchOrchestrationStep BindOrchestrationWitness,
        PatchOrchestrationThen (exists (
            PatchOrchestrationStep BindOrchestrationOperations,
            PatchOrchestrationThen (exists (
                PatchOrchestrationStep BindOrchestrationGuards,
                PatchOrchestrationThen (exists (
                    PatchOrchestrationStep BindOrchestrationStages,
                    PatchOrchestrationThen (exists (
                        PatchOrchestrationStep BindOrchestrationPromotions,
                        PatchOrchestrationStep CompleteOrchestration
                    ))
                ))
            ))
        ))
    ))

let orchestration_witness_binding (validated : i32) (parsed : i32) : i32 =
    inl control = patch_control_domain.patch_witness_authorized validated parsed
    inl result = patch_driver_domain.patch_driver_witness_binding control parsed
    if !!!!LT(result,0i32) then -1i32 else result

let orchestration_operation_binding (cursor : i32) (observed : i32) : i32 =
    inl authorized = patch_control_domain.patch_operation_authorized cursor observed
    if !!!!LT(authorized,1i32) then -1i32
    else patch_driver_domain.patch_driver_operation_binding cursor observed

let orchestration_guard_identity (operation : i32) (path_slot : i32) : i32 =
    patch_effect_domain.patch_guard_identity operation path_slot

let orchestration_guard_needle_binding (identity : i32) (needle_bytes : i32) : i32 =
    patch_effect_domain.patch_guard_needle_binding identity needle_bytes

let orchestration_guard_match_binding (identity : i32) (observed_matches : i32) : i32 =
    inl effect_identity = patch_effect_domain.patch_guard_match_binding identity observed_matches
    inl control_authorized = patch_control_domain.patch_match_authorized observed_matches 1i32
    inl result = patch_effect_domain.patch_guard_operation_binding effect_identity control_authorized
    if !!!!LT(result,0i32) then -1i32 else result

let orchestration_stage_binding (expected : i32) (observed : i32) : i32 =
    patch_driver_domain.patch_driver_stage_count_binding expected observed

let orchestration_promotion_binding (cursor : i32) (observed : i32) : i32 =
    patch_driver_domain.patch_driver_promotion_binding cursor observed

let orchestration_complete_binding (expected : i32) (observed : i32) : i32 =
    inl driver = patch_driver_domain.patch_driver_complete_binding expected observed
    inl control = patch_control_domain.patch_commit_authorized expected observed
    if !!!!LT(driver,1i32) then 0i32
    elif !!!!LT(control,1i32) then 0i32
    else 1i32



inl main () : i32 =
    inl _ = native_patch_orchestration_plan ()
    inl _ = orchestration_witness_binding 2i32 2i32
    inl op1 = orchestration_operation_binding 0i32 0i32
    inl _ = orchestration_operation_binding op1 1i32
    inl guard = orchestration_guard_identity 1i32 4i32
    inl guard = orchestration_guard_needle_binding guard 3i32
    inl _ = orchestration_guard_match_binding guard 1i32
    inl _ = orchestration_stage_binding 2i32 2i32
    inl promotion1 = orchestration_promotion_binding 0i32 0i32
    inl _ = orchestration_promotion_binding promotion1 1i32
    inl _ = orchestration_complete_binding 2i32 2i32
    $"RustExportI32Binary(\"eoie_patch_orchestration_witness_binding\",\"orchestration_witness_binding\")" : ()
    $"RustExportI32Binary(\"eoie_patch_orchestration_operation_binding\",\"orchestration_operation_binding\")" : ()
    $"RustExportI32Binary(\"eoie_patch_orchestration_guard_identity\",\"orchestration_guard_identity\")" : ()
    $"RustExportI32Binary(\"eoie_patch_orchestration_guard_needle_binding\",\"orchestration_guard_needle_binding\")" : ()
    $"RustExportI32Binary(\"eoie_patch_orchestration_guard_match_binding\",\"orchestration_guard_match_binding\")" : ()
    $"RustExportI32Binary(\"eoie_patch_orchestration_stage_binding\",\"orchestration_stage_binding\")" : ()
    $"RustExportI32Binary(\"eoie_patch_orchestration_promotion_binding\",\"orchestration_promotion_binding\")" : ()
    $"RustExportI32Binary(\"eoie_patch_orchestration_complete_binding\",\"orchestration_complete_binding\")" : ()

    rust_library ()
    0i32
