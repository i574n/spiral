nominal patch_preflight_raw = ()
nominal patch_preflight_parsed = ()
nominal patch_preflight_validated = ()
nominal patch_preflight_authorized = ()

union patch_preflight_policy =
    | RejectEmptyPlan
    | RejectWitnessMismatch
    | RejectAmbiguousMode
    | RejectUnsafePath
    | RejectMutationDuringCheck
    | AuthorizeValidatedApply
    | AuthorizeReadOnlyCheck

union patch_preflight_op from to =
    | ParsePatchPlan :: patch_preflight_op patch_preflight_raw patch_preflight_parsed
    | ValidatePatchWitnesses :: patch_preflight_op patch_preflight_parsed patch_preflight_validated
    | AuthorizePatchMode :: patch_preflight_op patch_preflight_validated patch_preflight_authorized

union rec patch_preflight_plan from to =
    | PatchPreflightStep :: forall from to. patch_preflight_op from to -> patch_preflight_plan from to
    | PatchPreflightThen :: forall from to. (exists middle. patch_preflight_plan from middle * patch_preflight_plan middle to) -> patch_preflight_plan from to

inl patch_preflight_public_plan () : patch_preflight_plan patch_preflight_raw patch_preflight_authorized =
    PatchPreflightThen (exists (
        PatchPreflightStep ParsePatchPlan,
        PatchPreflightThen (exists (
            PatchPreflightStep ValidatePatchWitnesses,
            PatchPreflightStep AuthorizePatchMode
        ))
    ))

let patch_preflight_witness_binding (expected : i32) (observed : i32) : i32 =
    if !!!!LT(expected,1i32) then 0i32
    elif !!!!LT(observed,1i32) then 0i32
    elif !!!!LT(expected,observed) then 0i32
    elif !!!!LT(observed,expected) then 0i32
    else 1i32

let patch_preflight_mode_binding (apply_mode : i32) (check_mode : i32) : i32 =
    if !!!!LT(apply_mode,0i32) then 0i32
    elif !!!!LT(check_mode,0i32) then 0i32
    elif !!!!LT(1i32,apply_mode) then 0i32
    elif !!!!LT(1i32,check_mode) then 0i32
    elif !!!!LT(apply_mode,1i32) then
        if !!!!LT(check_mode,1i32) then 0i32 else 1i32
    else
        if !!!!LT(check_mode,1i32) then 1i32 else 0i32

let patch_preflight_check_binding (unsafe_paths : i32) (mutations : i32) : i32 =
    if !!!!LT(unsafe_paths,0i32) then 0i32
    elif !!!!LT(mutations,0i32) then 0i32
    elif !!!!LT(0i32,unsafe_paths) then 0i32
    elif !!!!LT(0i32,mutations) then 0i32
    else 1i32
