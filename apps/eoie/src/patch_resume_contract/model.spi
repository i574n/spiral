nominal patch_resume_policy_owner = string
nominal patch_resume_negative_owner = string
nominal resume_pending owner = owner
nominal resume_identified owner = owner
nominal resume_matching owner = owner
nominal resume_mutated owner = owner
nominal resume_closed owner = owner

union patch_resume_transition from to =
    | RecordIdentity :: forall owner. patch_resume_transition (resume_pending owner) (resume_identified owner)
    | MatchResumeReceipt :: forall owner. patch_resume_transition (resume_identified owner) (resume_matching owner)
    | ResumeMutation :: forall owner. patch_resume_transition (resume_matching owner) (resume_mutated owner)
    | CloseResumeReceipt :: forall owner. patch_resume_transition (resume_mutated owner) (resume_closed owner)

union rec patch_resume_plan from to =
    | PatchResumeStep :: forall from to. patch_resume_transition from to -> patch_resume_plan from to
    | PatchResumeThen :: forall from to. (exists middle. patch_resume_plan from middle * patch_resume_plan middle to) -> patch_resume_plan from to

let bool_pair_binding (left : i32) (right : i32) : i32 =
    if !!!!LT(left,1i32) then 0i32
    elif !!!!LT(1i32,left) then 0i32
    elif !!!!LT(right,1i32) then 0i32
    elif !!!!LT(1i32,right) then 0i32
    else 1i32

let receipt_shape_binding (schema_ok : i32) (phase_ok : i32) (plan_match : i32) (source_match : i32) : i32 =
    inl header = bool_pair_binding schema_ok phase_ok
    inl identity = bool_pair_binding plan_match source_match
    bool_pair_binding header identity

let resume_decision_binding (receipt_present : i32) (receipt_matches : i32) : i32 =
    if !!!!LT(receipt_present,1i32) then 0i32
    elif !!!!LT(1i32,receipt_present) then -1i32
    elif !!!!LT(receipt_matches,1i32) then -1i32
    elif !!!!LT(1i32,receipt_matches) then -1i32
    else 1i32

let completion_binding (mutation_ok : i32) (receipt_removed : i32) : i32 =
    bool_pair_binding mutation_ok receipt_removed

inl full_plan forall owner. () : patch_resume_plan (resume_pending owner) (resume_closed owner) =
    PatchResumeThen (exists (
        PatchResumeStep RecordIdentity,
        PatchResumeThen (exists (
            PatchResumeStep MatchResumeReceipt,
            PatchResumeThen (exists (
                PatchResumeStep ResumeMutation,
                PatchResumeStep CloseResumeReceipt
            ))
        ))
    ))

inl policy_plan () : patch_resume_plan (resume_pending patch_resume_policy_owner) (resume_closed patch_resume_policy_owner) = full_plan ()
inl negative_plan () : patch_resume_plan (resume_pending patch_resume_negative_owner) (resume_closed patch_resume_negative_owner) = full_plan ()
