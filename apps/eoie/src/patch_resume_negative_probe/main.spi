open patch_resume_contract.model

inl one_is (value : i32) : bool =
    if !!!!LT(value,1i32) then false
    elif !!!!LT(1i32,value) then false
    else true

inl main () : i32 =
    inl _ = negative_plan ()
    if one_is (resume_decision_binding 0i32 0i32) then 1i32
    elif one_is (resume_decision_binding 1i32 0i32) then 2i32
    elif one_is (receipt_shape_binding 1i32 1i32 1i32 0i32) then 3i32
    elif one_is (completion_binding 1i32 0i32) then 4i32
    else 0i32
