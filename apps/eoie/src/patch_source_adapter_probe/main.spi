inl main () : i32 =
    inl minus_one = !!!!Neg(1i32)
    inl pair_ok = patch_source_adapter.main.source_resume_pair_binding 1i32 1i32
    inl pair_bad = patch_source_adapter.main.source_resume_pair_binding 1i32 0i32
    inl decision_resume = patch_source_adapter.main.source_resume_decision_binding 1i32 1i32
    inl decision_absent = patch_source_adapter.main.source_resume_decision_binding 0i32 0i32
    inl decision_stale = patch_source_adapter.main.source_resume_decision_binding 1i32 0i32
    inl completion_ok = patch_source_adapter.main.source_resume_completion_binding 1i32 1i32
    inl completion_bad = patch_source_adapter.main.source_resume_completion_binding 1i32 0i32
    if !!!!EQ(pair_ok,1i32) && !!!!EQ(pair_bad,0i32) && !!!!EQ(decision_resume,1i32) && !!!!EQ(decision_absent,0i32) && !!!!EQ(decision_stale,minus_one) && !!!!EQ(completion_ok,1i32) && !!!!EQ(completion_bad,0i32)
    then 0i32
    else 1i32
