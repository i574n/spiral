nominal path_tag_raw = ()
nominal path_tag_normalized = ()
nominal path_tag_hashed = ()
nominal path_tag_indexed = ()
nominal path_tag_rendered = ()

nominal adjective_bank = ()
nominal landmark_bank = ()
nominal artifact_bank = ()
nominal word_index bank = i32

type path_tag_indices = {
    adjective : word_index adjective_bank
    landmark : word_index landmark_bank
    artifact : word_index artifact_bank
}

union path_tag_policy =
    | RejectAbsolutePath
    | RejectParentTraversal
    | NormalizeSeparators
    | HashRelativePathWithSha256
    | DecodeFirstEighteenBits
    | SelectThreeDistinctWordBanks
    | RenderHyphenatedMnemonic

union path_tag_op from to =
    | ValidateRelativePath :: path_tag_op path_tag_raw path_tag_normalized
    | HashNormalizedPath :: path_tag_op path_tag_normalized path_tag_hashed
    | DecodeWordIndices :: path_tag_op path_tag_hashed path_tag_indexed
    | RenderMnemonicTag :: path_tag_op path_tag_indexed path_tag_rendered

union rec path_tag_plan from to =
    | PathTagStep :: forall from to. path_tag_op from to -> path_tag_plan from to
    | PathTagThen :: forall from to. (exists middle. path_tag_plan from middle * path_tag_plan middle to) -> path_tag_plan from to

inl path_tag_public_plan () : path_tag_plan path_tag_raw path_tag_rendered =
    PathTagThen (exists (
        PathTagStep ValidateRelativePath,
        PathTagThen (exists (
            PathTagStep HashNormalizedPath,
            PathTagThen (exists (
                PathTagStep DecodeWordIndices,
                PathTagStep RenderMnemonicTag
            ))
        ))
    ))

inl path_tag_indices adjective landmark artifact : path_tag_indices = {
    adjective = word_index adjective
    landmark = word_index landmark
    artifact = word_index artifact
}

let path_tag_relative_binding (is_absolute : i32) (has_parent : i32) (segments : i32) : i32 =
    if !!!!LT(0i32,is_absolute) then 0i32
    elif !!!!LT(0i32,has_parent) then 0i32
    elif !!!!LT(segments,1i32) then 0i32
    else 1i32

let path_tag_indices_binding (adjective : i32) (landmark : i32) (artifact : i32) : i32 =
    if !!!!LT(adjective,0i32) then 0i32
    elif !!!!LT(63i32,adjective) then 0i32
    elif !!!!LT(landmark,0i32) then 0i32
    elif !!!!LT(63i32,landmark) then 0i32
    elif !!!!LT(artifact,0i32) then 0i32
    elif !!!!LT(63i32,artifact) then 0i32
    else 1i32

let path_tag_relative_packed_binding (flags : i32) (segments : i32) : i32 =
    if !!!!LT(flags,0i32) then 0i32
    elif !!!!LT(0i32,flags) then 0i32
    elif !!!!LT(segments,1i32) then 0i32
    else 1i32

let path_tag_packed_indices_binding (packed : i32) (bank_size : i32) : i32 =
    if !!!!LT(packed,0i32) then 0i32
    elif !!!!LT(262143i32,packed) then 0i32
    elif !!!!LT(bank_size,64i32) then 0i32
    elif !!!!LT(64i32,bank_size) then 0i32
    else 1i32

let path_tag_shape_binding (words : i32) (separators : i32) : i32 =
    if !!!!LT(words,3i32) then 0i32
    elif !!!!LT(3i32,words) then 0i32
    elif !!!!LT(separators,2i32) then 0i32
    elif !!!!LT(2i32,separators) then 0i32
    else 1i32

let path_tag_determinism_binding (same_normalized_path : i32) (same_tag : i32) : i32 =
    if !!!!LT(same_normalized_path,1i32) then 0i32
    elif !!!!LT(same_tag,1i32) then 0i32
    else 1i32

let path_tag_collision_binding (same_tag : i32) (same_normalized_path : i32) : i32 =
    if !!!!LT(same_tag,1i32) then 1i32
    elif !!!!LT(same_normalized_path,1i32) then 0i32
    else 1i32
