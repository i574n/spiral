open model

let batch_plan_accept_binding (checkpoint_value : i32) (event_value : i32) : i32 =
    if valid_checkpoint_code checkpoint_value then
        if valid_event_code event_value then
            if !!!!EQ(checkpoint_value,0i32) then if !!!!EQ(event_value,0i32) then 1i32 else 0i32
            elif !!!!EQ(checkpoint_value,1i32) then if !!!!EQ(event_value,1i32) then 1i32 else 0i32
            elif !!!!EQ(checkpoint_value,2i32) then
                if !!!!EQ(event_value,2i32) then 1i32
                elif !!!!EQ(event_value,3i32) then 1i32
                else 0i32
            elif !!!!EQ(checkpoint_value,3i32) then if !!!!EQ(event_value,4i32) then 1i32 else 0i32
            elif !!!!EQ(checkpoint_value,4i32) then if !!!!EQ(event_value,4i32) then 1i32 else 0i32
            else 0i32
        else -1i32
    else -1i32

let batch_plan_advance_binding (checkpoint_value : i32) (event_value : i32) : i32 =
    inl accepted = batch_plan_accept_binding checkpoint_value event_value
    if !!!!EQ(accepted,1i32) then
        if !!!!EQ(checkpoint_value,0i32) then 1i32
        elif !!!!EQ(checkpoint_value,1i32) then 2i32
        elif !!!!EQ(checkpoint_value,2i32) then if !!!!EQ(event_value,3i32) then 4i32 else 3i32
        else 5i32
    else -1i32

inl batch_plan_next_policy (checkpoint_value : i32) (timeout_requested : i32) : i32 =
    if valid_checkpoint_code checkpoint_value then
        if !!!!EQ(checkpoint_value,0i32) then 0i32
        elif !!!!EQ(checkpoint_value,1i32) then 1i32
        elif !!!!EQ(checkpoint_value,2i32) then if !!!!EQ(timeout_requested,0i32) then 2i32 else 3i32
        elif !!!!EQ(checkpoint_value,3i32) then 4i32
        elif !!!!EQ(checkpoint_value,4i32) then 4i32
        else -1i32
    else -1i32
