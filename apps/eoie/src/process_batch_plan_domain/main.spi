inl rust_global (x : string) : () = real typecase `(!!!!LitToTypeLit(x)) with ~x => $"RustGlobal(@x)" : ()

open model
open bridge
open matrix
open terminal

inl main () : i32 =
    rust_global "#![allow(clippy::bool_comparison)]"
    inl _ = BatchSpawn "process-batch"
    inl _ = BatchRun
    inl _ = BatchLink "receipt"
    inl _ = BatchTimeout 1u32
    inl _ = BatchComplete 0i32
    inl _ = BatchTimeoutComplete
    inl _ = batch_plan_accept_binding 0i32 0i32
    inl _ = batch_plan_advance_binding 0i32 0i32
    inl _ = batch_plan_next_policy 2i32 0i32
    inl _ = matrix_authority_status ()
    inl _ = matrix_row_policy_binding 0i32 0i32
    inl _ = matrix_dependency_binding 0i32 0i32
    inl _ = matrix_observed_accept_binding 0i32 0i32
    inl _ = matrix_resume_action_binding 1i32 0i32
    inl _ = matrix_workspace_policy_binding 2i32 1i32
    inl _ = matrix_auto_budget_status ()
    inl _ = matrix_auto_chain_budget_binding 60000i32 14000i32
    inl _ = matrix_auto_chain_action_policy 6i32
    inl _ = matrix_auto_checkpoint_binding 0i32 1i32
    inl _ = matrix_auto_checkpoint_binding 1i32 1i32
    emit_matrix_runtime ()
    $"RustExportI32Binary(\"eoie_batch_plan_accept\",\"batch_plan_accept_binding\")" : ()
    $"RustExportI32Binary(\"eoie_batch_plan_advance\",\"batch_plan_advance_binding\")" : ()
    $"RustExportI32Binary(\"eoie_batch_matrix_row_policy\",\"matrix_row_policy_binding\")" : ()
    $"RustExportI32Binary(\"eoie_batch_matrix_dependency\",\"matrix_dependency_binding\")" : ()
    $"RustExportI32Binary(\"eoie_batch_matrix_observed_accept\",\"matrix_observed_accept_binding\")" : ()
    $"RustExportI32Binary(\"eoie_batch_matrix_resume_action\",\"matrix_resume_action_binding\")" : ()
    $"RustExportI32Binary(\"eoie_batch_matrix_workspace_policy\",\"matrix_workspace_policy_binding\")" : ()
    $"RustExportI32Binary(\"eoie_batch_matrix_auto_chain_budget\",\"matrix_auto_chain_budget_binding\")" : ()
    $"RustExportI32Binary(\"eoie_batch_matrix_auto_checkpoint\",\"matrix_auto_checkpoint_binding\")" : ()
    $"RustLibrary()" : ()
    0i32
