inl rust_global (x : string) : () = real typecase `(!!!!LitToTypeLit(x)) with ~x => $"RustGlobal(@x)" : ()

inl emit_matrix_runtime () : () =
    rust_global "use eoie_process_observation::{run_bounded_receipted_observed, spawn_detached_handoff};\nuse eoie_agile_lease::{agile_now_unix_ms, agile_prompt_lease_clock};\nuse eoie_rust_std_fs::{atomic_write as batch_atomic_write, read_regular_text_limited, rooted_list_names, rooted_open_regular_read, safe_relative_path as batch_safe_relative};\nuse std::collections::{BTreeMap, BTreeSet};\nuse std::fs;\nuse std::path::{Path, PathBuf};\nuse std::process::Command;\nuse std::thread;"
    rust_global "fn batch_arg<'a>(args: &'a [String], index: usize, name: &str) -> Result<&'a str, String> { args.get(index).map(String::as_str).ok_or_else(|| format!(\"missing argument: {name}\")) }\nfn batch_timeout(text: &str) -> Result<u64, String> { let value = text.parse::<u64>().map_err(|_| \"timeout-ms must be an integer\".to_owned())?; if value == 0 { Err(\"timeout-ms must be positive\".to_owned()) } else { Ok(value) } }\nfn batch_replace_tokens(value: &str, root: &Path, cwd: &Path) -> String { value.replace(\"{root}\", &root.to_string_lossy()).replace(\"{cwd}\", &cwd.to_string_lossy()) }\nfn batch_apply_env(command: &mut Command, cell: &str, root: &Path, cwd: &Path) { for token in cell.split(';').flat_map(str::split_whitespace) { if let Some((key,value)) = token.split_once('=') && !key.is_empty() { command.env(key, batch_replace_tokens(value, root, cwd)); } } }\nfn batch_program_is_cargo(program: &str) -> i32 { let name = Path::new(program).file_name().and_then(|value| value.to_str()).unwrap_or_default(); if matches!(name, \"cargo\" | \"cargo-clippy\" | \"cargo-fmt\") { 1 } else { 0 } }\nfn batch_resolve_cwd(root: &Path, cwd_relative: &str, program: &str) -> Result<PathBuf,String> { let requested = if cwd_relative.is_empty() || cwd_relative == \".\" { root.to_path_buf() } else { root.join(batch_safe_relative(cwd_relative)?) }; if rooted_list_names(&requested).is_err() { return Err(format!(\"invalid cwd: {}\", requested.display())); } let requested_manifest = if rooted_open_regular_read(&requested.join(\"Cargo.toml\")).is_ok() { 1 } else { 0 }; let nested_manifest = if rooted_open_regular_read(&requested.join(\"src/Cargo.toml\")).is_ok() { 1 } else { 0 }; let program_requested_code = batch_program_is_cargo(program) * 2 + requested_manifest; match eoie_batch_matrix_workspace_policy(program_requested_code, nested_manifest) { 0 => Ok(requested), 1 => Ok(requested.join(\"src\")), _ => Err(format!(\"typed workspace policy rejected program={} cwd={}\", program, requested.display())) } }\nfn batch_capture(root: &Path, receipt_relative: &str, timeout_ms: u64, cwd_relative: &str, env_cell: &str, program: &str, arguments: &[String]) -> Result<(i32,u64,usize,usize), String> { if rooted_list_names(root).is_err() { return Err(format!(\"invalid root: {}\", root.display())); } let cwd = batch_resolve_cwd(root, cwd_relative, program)?; let receipt = root.join(batch_safe_relative(receipt_relative)?); let mut command = Command::new(program); command.current_dir(&cwd).args(arguments); batch_apply_env(&mut command, env_cell, root, &cwd); let observation = run_bounded_receipted_observed(&mut command, timeout_ms, \"batch-plan\")?; let status = observation.status.code().unwrap_or(-1); let body = format!(\"schema=1\\nprogram={}\\ncwd={}\\nenv={}\\nstatus={}\\ntermination={:?}\\nelapsed_ms={}\\nstdout_bytes={}\\nstderr_bytes={}\\n--- stdout ---\\n{}\\n--- stderr ---\\n{}\\n\", program, cwd.display(), env_cell, status, observation.termination, observation.elapsed_ms, observation.stdout.len(), observation.stderr.len(), String::from_utf8_lossy(&observation.stdout), String::from_utf8_lossy(&observation.stderr)); batch_atomic_write(&receipt, body.as_bytes())?; Ok((status, observation.elapsed_ms, observation.stdout.len(), observation.stderr.len())) }"
    rust_global "#[derive(Clone)] struct BatchMatrixRow { id:String, program:String, args:Vec<String>, cwd:String, env:String, required:i32, policy:i32, depends_on:String, receipt:String }\nfn batch_required_code(value: &str) -> Result<i32,String> { match value { \"pass\" => Ok(0), \"blocked\" => Ok(1), _ => Err(format!(\"required_status must be pass|blocked: {value}\")) } }\nfn batch_policy_code(value: &str) -> Result<i32,String> { match value { \"stop\" => Ok(0), \"continue\" => Ok(1), _ => Err(format!(\"on_error must be stop|continue: {value}\")) } }\nfn batch_parse_spec(root: &Path, relative: &str) -> Result<Vec<BatchMatrixRow>,String> { let path = root.join(batch_safe_relative(relative)?); let text = read_regular_text_limited(&path, usize::MAX)?; let expected = [\"id\",\"program\",\"args\",\"cwd\",\"env\",\"required_status\",\"on_error\",\"depends_on\",\"receipt\"]; let mut lines = text.lines(); let header = lines.next().ok_or_else(|| \"matrix spec is empty\".to_owned())?; let fields = header.split('\\t').collect::<Vec<_>>(); if fields.len() != expected.len() || fields.iter().zip(expected.iter()).any(|(a,b)| a != b) { return Err(format!(\"matrix schema mismatch expected={} observed={}\", expected.join(\"|\"), fields.join(\"|\"))); } let mut ids = BTreeSet::new(); let mut rows = Vec::new(); for (offset,line) in lines.enumerate() { if line.trim().is_empty() { continue; } let cells = line.split('\\t').collect::<Vec<_>>(); if cells.len() != expected.len() { return Err(format!(\"matrix row {} has {} cells expected {}\", offset+2, cells.len(), expected.len())); } let id = cells[0].trim(); if id.is_empty() || !ids.insert(id.to_owned()) { return Err(format!(\"matrix row {} has empty or duplicate id {}\", offset+2, id)); } let required = batch_required_code(cells[5].trim())?; let policy = batch_policy_code(cells[6].trim())?; let depends = cells[7].trim(); let has_dep = if depends.is_empty() {0} else {1}; if eoie_batch_matrix_row_policy(required, policy) != 1 || eoie_batch_matrix_dependency(has_dep, if has_dep==0 {0} else {1}) != 1 { return Err(format!(\"typed matrix row authority rejected {}\", id)); } rows.push(BatchMatrixRow { id:id.to_owned(), program:cells[1].trim().to_owned(), args:cells[2].split_whitespace().map(str::to_owned).collect(), cwd:cells[3].trim().to_owned(), env:cells[4].trim().to_owned(), required, policy, depends_on:depends.to_owned(), receipt:cells[8].trim().to_owned() }); } if rows.is_empty() { return Err(\"matrix spec has no rows\".to_owned()); } Ok(rows) }"
    rust_global "fn batch_auto_sidecar(report:&Path,suffix:&str)->PathBuf { let name=report.file_name().and_then(|x|x.to_str()).unwrap_or(\"batch-report\"); report.with_file_name(format!(\"{name}.{suffix}\")) }\nfn batch_auto_cursor_read(path:&Path,spec:&str,total:usize)->Result<usize,String>{ if !path.exists(){return Ok(0);} let text=fs::read_to_string(path).map_err(|e|format!(\"read auto cursor {}: {e}\",path.display()))?; let mut schema=None; let mut seen_spec=None; let mut seen_total=None; let mut next=None; for line in text.lines(){ if let Some((key,value))=line.split_once('='){ match key { \"schema\"=>schema=Some(value.to_owned()), \"spec\"=>seen_spec=Some(value.to_owned()), \"total_chains\"=>seen_total=value.parse::<usize>().ok(), \"next_chain\"=>next=value.parse::<usize>().ok(), _=>{} } } } if schema.as_deref()!=Some(\"1\") || seen_spec.as_deref()!=Some(spec) || seen_total!=Some(total){ return Err(\"batch auto cursor identity mismatch\".to_owned()); } let next=next.ok_or_else(||\"batch auto cursor missing next_chain\".to_owned())?; if next>total{return Err(\"batch auto cursor outside chain range\".to_owned());} Ok(next) }\nfn batch_auto_cursor_write(path:&Path,spec:&str,total:usize,next:usize)->Result<(),String>{ let body=format!(\"schema=1\\nspec={}\\ntotal_chains={}\\nnext_chain={}\\ncomplete={}\\n\",spec,total,next,if next>=total{1}else{0}); batch_atomic_write(path,body.as_bytes()) }\nfn batch_auto_checkpoint_component(value:&str)->String{ value.chars().map(|c|if c.is_ascii_alphanumeric()||matches!(c,'-'|'_'|'.'){c}else{'_'}).collect() }\nfn batch_auto_checkpoint_paths(root:&Path,report:&Path)->Result<(PathBuf,PathBuf,PathBuf,String),String>{ let parent=root.parent().filter(|x|!x.as_os_str().is_empty()).ok_or_else(||\"batch-plan auto checkpoint requires a root with a parent path\".to_owned())?; let dir=parent.join(\".eoie-checkpoints\"); fs::create_dir_all(&dir).map_err(|e|format!(\"create checkpoint directory {}: {e}\",dir.display()))?; let root_name=batch_auto_checkpoint_component(root.file_name().and_then(|x|x.to_str()).unwrap_or(\"workspace\")); let report_name=batch_auto_checkpoint_component(report.file_name().and_then(|x|x.to_str()).unwrap_or(\"batch-report\")); let stem=format!(\"{root_name}-{report_name}\"); Ok((dir.join(format!(\"{stem}.latest.zip\")),dir.join(format!(\"{stem}.candidate.zip\")),dir.join(format!(\"{stem}.receipt\")),stem)) }\nfn batch_auto_checkpoint_cursor(root:&Path,report:&Path,spec:&str,total:usize)->Result<usize,String>{ let (latest,_,receipt,_)=batch_auto_checkpoint_paths(root,report)?; if !receipt.exists(){return Ok(0);} let text=fs::read_to_string(&receipt).map_err(|e|format!(\"read checkpoint receipt {}: {e}\",receipt.display()))?; let mut schema=None; let mut seen_spec=None; let mut seen_total=None; let mut next=None; for line in text.lines(){if let Some((key,value))=line.split_once('='){match key{\"schema\"=>schema=Some(value.to_owned()),\"spec\"=>seen_spec=Some(value.to_owned()),\"total_chains\"=>seen_total=value.parse::<usize>().ok(),\"next_chain\"=>next=value.parse::<usize>().ok(),_=>{}}}} if schema.as_deref()!=Some(\"1\")||seen_spec.as_deref()!=Some(spec)||seen_total!=Some(total){return Ok(0);}\nif !latest.is_file(){return Err(format!(\"checkpoint receipt is current but bundle is missing: {}\",latest.display()));} let next=next.ok_or_else(||\"checkpoint receipt missing next_chain\".to_owned())?; if next>total{return Err(\"checkpoint receipt outside chain range\".to_owned());} Ok(next) }\nfn batch_auto_checkpoint_create(root:&Path,spec:&str,total:usize,next:usize,report:&Path)->Result<PathBuf,String>{ let (latest,candidate,receipt,stem)=batch_auto_checkpoint_paths(root,report)?; let dir=latest.parent().ok_or_else(||\"checkpoint directory missing\".to_owned())?; if candidate.exists(){fs::remove_file(&candidate).map_err(|e|format!(\"remove stale checkpoint candidate {}: {e}\",candidate.display()))?;} let executable=std::env::current_exe().map_err(|e|format!(\"resolve current eoie for checkpoint: {e}\"))?; let executable_text=executable.to_string_lossy().into_owned(); let root_text=root.to_string_lossy().into_owned(); let candidate_text=candidate.to_string_lossy().into_owned(); let create_args=vec![\"bundle\".to_owned(),\"create\".to_owned(),root_text,candidate_text.clone(),\"generic\".to_owned()]; let create_receipt=format!(\"{stem}.create.receipt\"); let created=batch_capture(dir,&create_receipt,60000,\".\",\"\",&executable_text,&create_args)?; if created.0!=0{return Err(format!(\"checkpoint bundle create failed status={}\",created.0));} let verify_args=vec![\"bundle\".to_owned(),\"verify\".to_owned(),candidate_text,\"generic\".to_owned()]; let verify_receipt=format!(\"{stem}.verify.receipt\"); let verified=batch_capture(dir,&verify_receipt,60000,\".\",\"\",&executable_text,&verify_args)?; if verified.0!=0{return Err(format!(\"checkpoint bundle verify failed status={}\",verified.0));} fs::rename(&candidate,&latest).map_err(|e|format!(\"promote checkpoint {} -> {}: {e}\",candidate.display(),latest.display()))?; let bytes=fs::metadata(&latest).map_err(|e|format!(\"stat checkpoint {}: {e}\",latest.display()))?.len(); let body=format!(\"schema=1\\nspec={}\\ntotal_chains={}\\nnext_chain={}\\nbundle={}\\nbytes={}\\n\",spec,total,next,latest.display(),bytes); batch_atomic_write(&receipt,body.as_bytes())?; Ok(latest) }\nfn batch_auto_reinvoke(root:&Path,spec:&str,timeout_ms:u64,report_relative:&str,report:&Path,parallel_width:usize,next_chain:usize)->Result<u32,String>{ let executable=std::env::current_exe().map_err(|e|format!(\"resolve current eoie: {e}\"))?; let prefix=format!(\"reinvoke.{next_chain}\"); let stdout_path=batch_auto_sidecar(report,&format!(\"{prefix}.stdout\")); let stderr_path=batch_auto_sidecar(report,&format!(\"{prefix}.stderr\")); let target_receipt=batch_auto_sidecar(report,&format!(\"{prefix}.receipt\")); let target_receipt_relative=target_receipt.strip_prefix(root).map_err(|_|format!(\"reinvoke receipt escapes root: {}\",target_receipt.display()))?.to_string_lossy().into_owned(); let stdout=fs::File::create(&stdout_path).map_err(|e|format!(\"create {}: {e}\",stdout_path.display()))?; let stderr=fs::File::create(&stderr_path).map_err(|e|format!(\"create {}: {e}\",stderr_path.display()))?; let (_,_,_,remaining,_,_)=agile_prompt_lease_clock(root)?; let remaining=remaining.max(1); let supervisor_timeout=remaining.min(timeout_ms.saturating_mul(64).max(60000)); let mut command=Command::new(&executable); command.current_dir(root).arg(\"proxy\").arg(\"command-capture-env\").arg(root).arg(&target_receipt_relative).arg(supervisor_timeout.to_string()).arg(\".\").arg(\"\").arg(&executable).arg(\"proxy\").arg(\"batch-plan\").arg(root).arg(spec).arg(timeout_ms.to_string()).arg(report_relative).arg(parallel_width.to_string()).arg(\"auto\"); command.stdin(std::process::Stdio::null()).stdout(std::process::Stdio::from(stdout)).stderr(std::process::Stdio::from(stderr)); let handoff=spawn_detached_handoff(&mut command,\"batch-auto-reinvoke-supervisor\")?; let pid=handoff.pid; let handoff_receipt=batch_auto_sidecar(report,&format!(\"{prefix}.handoff.receipt\")); let body=format!(\"schema=2\\nstage=spawned\\nsupervisor_pid={}\\nbaton_next_chain={}\\nspec={}\\nreport={}\\nstdout={}\\nstderr={}\\ntarget_receipt={}\\nsupervisor_timeout_ms={}\\n\",pid,next_chain,spec,report_relative,stdout_path.display(),stderr_path.display(),target_receipt.display(),supervisor_timeout); batch_atomic_write(&handoff_receipt,body.as_bytes())?; Ok(pid) }\nfn batch_auto_merge_report(report:&Path,start_chain:usize,chunk:&str)->Result<(),String>{ if start_chain==0{return batch_atomic_write(report,chunk.as_bytes());} let mut prior=fs::read_to_string(report).map_err(|e|format!(\"read accumulated report {}: {e}\",report.display()))?; if !prior.starts_with(\"id\\tprogram\\trc\\tstatus\\trequired\\ton_error\\tdepends_on\\tresume_action\\treceipt\\telapsed_ms\\tstdout_bytes\\tstderr_bytes\\n\"){return Err(\"batch auto report schema mismatch\".to_owned());} let tail=chunk.split_once('\\n').map(|(_,tail)|tail).unwrap_or(\"\"); if !prior.ends_with('\\n'){prior.push('\\n');} prior.push_str(tail); batch_atomic_write(report,prior.as_bytes()) }\nfn batch_auto_lease_budget_observe(root:&Path,timeout_ms:u64)->Result<usize,String>{ let (_,_,wrap_at,_,should_wrap,should_yield)=agile_prompt_lease_clock(root)?; if should_wrap||should_yield{return Ok(0);} let now=agile_now_unix_ms()?; let work_remaining=wrap_at.saturating_sub(now).min(i32::MAX as u64) as i32; let timeout_i32=i32::try_from(timeout_ms).map_err(|_|\"timeout-ms exceeds auto policy range\".to_owned())?; let budget=eoie_batch_matrix_auto_chain_budget(work_remaining,timeout_i32); if budget<=0{Ok(0)}else{Ok(budget as usize)} }\n#[derive(Clone)] struct BatchRowOutcome { index:usize, row:BatchMatrixRow, accepted:i32, rc:i32, elapsed:u64, stdout_bytes:usize, stderr_bytes:usize }\nfn batch_partition_chains(rows:&[BatchMatrixRow])->Vec<Vec<(usize,BatchMatrixRow)>> { let all=rows.iter().cloned().enumerate().collect::<Vec<_>>(); let mut chains=Vec::<Vec<(usize,BatchMatrixRow)>>::new(); for item in all.iter().cloned() { if item.1.depends_on.is_empty() { chains.push(Vec::new()); } let Some(chain)=chains.last_mut() else { return vec![all]; }; if !item.1.depends_on.is_empty() && !chain.iter().any(|(_,prior)| prior.id==item.1.depends_on) { return vec![all]; } chain.push(item); } if chains.len()<2 { vec![all] } else { chains } }\nfn batch_run_chain(root:PathBuf, timeout_ms:u64, chain:Vec<(usize,BatchMatrixRow)>)->Result<Vec<BatchRowOutcome>,String> { let mut passed=BTreeMap::<String,bool>::new(); let mut outcomes=Vec::with_capacity(chain.len()); for (index,row) in chain { let dependency_ok=row.depends_on.is_empty() || passed.get(&row.depends_on).copied().unwrap_or(false); let has_dep=if row.depends_on.is_empty(){0}else{1}; let authority=if eoie_batch_matrix_row_policy(row.required,row.policy)==1 { eoie_batch_matrix_dependency(has_dep,if dependency_ok {1}else{0}) } else {-1}; let mut rc=-1i32; let mut elapsed=0u64; let mut stdout_bytes=0usize; let mut stderr_bytes=0usize; let accepted=if authority!=1 {0} else { let cwd=batch_replace_tokens(&row.cwd,&root,&root); let env=batch_replace_tokens(&row.env,&root,&root); let program=batch_replace_tokens(&row.program,&root,&root); let row_args=row.args.iter().map(|x|batch_replace_tokens(x,&root,&root)).collect::<Vec<_>>(); let receipt=batch_replace_tokens(&row.receipt,&root,&root); let result=batch_capture(&root,&receipt,timeout_ms,&cwd,&env,&program,&row_args)?; rc=result.0; elapsed=result.1; stdout_bytes=result.2; stderr_bytes=result.3; eoie_batch_matrix_observed_accept(row.required,rc) }; passed.insert(row.id.clone(),accepted==1); outcomes.push(BatchRowOutcome{index,row,accepted,rc,elapsed,stdout_bytes,stderr_bytes}); } Ok(outcomes) }\nfn batch_execute_matrix(args: &[String], stop_policy: bool) -> Result<(),String> { if eoie_batch_matrix_row_policy(0,0) != 1 || eoie_batch_matrix_dependency(0,0) != 1 { return Err(\"typed batch matrix authority rejected\".to_owned()); }\nif !matches!(args.len(),5..=8) { return Err(format!(\"{} expects root spec-relative timeout-ms report-relative [parallel-chains [auto | start-chain chain-count]]\", args.first().map(String::as_str).unwrap_or(\"batch-plan\"))); } let root = Path::new(batch_arg(args,1,\"root\")?); let spec = batch_arg(args,2,\"spec-relative\")?; let timeout_ms = batch_timeout(batch_arg(args,3,\"timeout-ms\")?)?; let report_relative=batch_arg(args,4,\"report-relative\")?; let report = root.join(batch_safe_relative(report_relative)?); let parallel_width=if args.len()>=6 { let value=batch_arg(args,5,\"parallel-chains\")?.parse::<usize>().map_err(|_|\"parallel-chains must be an integer\".to_owned())?; if value==0||value>56{return Err(\"parallel-chains must be within 1..56\".to_owned())} value } else { 12usize }; let auto_mode=if args.len()==7 { if batch_arg(args,6,\"mode\")?!=\"auto\" { return Err(\"seven-argument batch-plan form requires literal auto\".to_owned()); } true } else { false }; let requested_start=if args.len()==8 { batch_arg(args,6,\"start-chain\")?.parse::<usize>().map_err(|_|\"start-chain must be an integer\".to_owned())? } else { 0usize }; let requested_count=if args.len()==8 { let value=batch_arg(args,7,\"chain-count\")?.parse::<usize>().map_err(|_|\"chain-count must be an integer\".to_owned())?; if value==0{return Err(\"chain-count must be positive\".to_owned())} value } else { usize::MAX }; let rows = batch_parse_spec(root,spec)?; let all_chains=batch_partition_chains(&rows); let total_chains=all_chains.len(); let auto_cursor=if auto_mode {Some(batch_auto_sidecar(&report,\"cursor\"))} else {None}; let (start_chain,chain_count)=if let Some(cursor)=auto_cursor.as_ref(){ let start=batch_auto_cursor_read(cursor,spec,total_chains)?; if start>=total_chains { (start,0usize) } else { let budget=batch_auto_lease_budget_observe(root,timeout_ms)?; if budget==0{return Err(\"batch-plan auto refused: insufficient WORK budget or lease is in WRAP/YIELD\".to_owned())} (start,budget.min(total_chains-start)) } } else {(requested_start,requested_count)}; let mut checkpoint_path=String::new(); if auto_mode { let checkpointed=batch_auto_checkpoint_cursor(root,&report,spec,total_chains)?; let cursor_i32=i32::try_from(start_chain).map_err(|_|\"checkpoint cursor exceeds policy range\".to_owned())?; let checkpointed_i32=i32::try_from(checkpointed).map_err(|_|\"checkpoint receipt cursor exceeds policy range\".to_owned())?; let repair_evidence=cursor_i32.checked_sub(checkpointed_i32).ok_or_else(||\"checkpoint cursor delta overflow\".to_owned())?; match eoie_batch_matrix_auto_checkpoint(0i32,repair_evidence){1=>checkpoint_path=batch_auto_checkpoint_create(root,spec,total_chains,start_chain,&report)?.display().to_string(),0=>{},_=>return Err(\"typed checkpoint repair policy rejected\".to_owned())} if start_chain>=total_chains { println!(\"eoie proxy {} ok report={} rows=0 hard_failures=0 selected_chains=0 total_chains={} parallel_width={} start_chain={} auto=1 complete=1 checkpoint={}\",args[0],report.display(),total_chains,parallel_width,start_chain,checkpoint_path); return Ok(()); } }\nif start_chain>=total_chains{return Err(format!(\"start-chain {start_chain} outside total chains {total_chains}\"))} let chains=all_chains.into_iter().skip(start_chain).take(chain_count).collect::<Vec<_>>(); let parallel_chains=chains.len(); let selected_rows=chains.iter().map(Vec::len).sum::<usize>(); let mut outcomes=Vec::<BatchRowOutcome>::with_capacity(selected_rows); for group in chains.chunks(parallel_width) { let mut handles=Vec::with_capacity(group.len()); for chain in group.iter().cloned() { let root=root.to_path_buf(); handles.push(thread::spawn(move || batch_run_chain(root,timeout_ms,chain))); } for handle in handles { outcomes.extend(handle.join().map_err(|_|\"batch matrix worker panicked\".to_owned())??); } } outcomes.sort_by_key(|x|x.index); let mut hard_failures=0usize; let mut out=String::from(\"id\\tprogram\\trc\\tstatus\\trequired\\ton_error\\tdepends_on\\tresume_action\\treceipt\\telapsed_ms\\tstdout_bytes\\tstderr_bytes\\n\"); for outcome in outcomes { let row=outcome.row; let resume=eoie_batch_matrix_resume_action(outcome.accepted,row.policy); let status=if outcome.accepted==1 {\"pass\"} else {\"blocked\"}; if outcome.accepted!=1 && row.policy==0 { hard_failures+=1; } out.push_str(&format!(\"{}\\t{}\\t{}\\t{}\\t{}\\t{}\\t{}\\t{}\\t{}\\t{}\\t{}\\t{}\\n\",row.id,row.program,outcome.rc,status,if row.required==0 {\"pass\"}else{\"blocked\"},if row.policy==0 {\"stop\"}else{\"continue\"},row.depends_on,resume,row.receipt,outcome.elapsed,outcome.stdout_bytes,outcome.stderr_bytes)); } let next_chain=start_chain.saturating_add(parallel_chains); if auto_mode { if hard_failures>0 { let failure=batch_auto_sidecar(&report,\"failure\"); batch_atomic_write(&failure,out.as_bytes())?; } else { batch_auto_merge_report(&report,start_chain,&out)?; let cursor=auto_cursor.as_ref().ok_or_else(||\"batch auto cursor missing\".to_owned())?; batch_auto_cursor_write(cursor,spec,total_chains,next_chain)?; } } else { batch_atomic_write(&report,out.as_bytes())?; } let complete=auto_mode && hard_failures==0 && next_chain>=total_chains; if auto_mode { let checkpoint_evidence=(if hard_failures==0{0i32}else{2i32})+(if parallel_chains>0{1i32}else{0i32}); match eoie_batch_matrix_auto_checkpoint(1i32,checkpoint_evidence){1=>checkpoint_path=batch_auto_checkpoint_create(root,spec,total_chains,next_chain,&report)?.display().to_string(),0=>{},_=>return Err(\"typed checkpoint commit policy rejected\".to_owned())} } let mut reinvoke_pid=0u32; if auto_mode && hard_failures==0 && !complete { let work_budget=batch_auto_lease_budget_observe(root,timeout_ms)?; if work_budget>0{reinvoke_pid=batch_auto_reinvoke(root,spec,timeout_ms,report_relative,&report,parallel_width,next_chain)?;} } println!(\"eoie proxy {} ok report={} rows={} hard_failures={} selected_chains={} total_chains={} parallel_width={} start_chain={} next_chain={} auto={} complete={} checkpoint={} reinvoke_pid={}\",args[0],report.display(),selected_rows,hard_failures,parallel_chains,total_chains,parallel_width,start_chain,next_chain,if auto_mode{1}else{0},if complete{1}else{0},checkpoint_path,reinvoke_pid); if stop_policy && hard_failures>0 { Err(format!(\"batch plan blocked hard_failures={hard_failures}\")) } else { Ok(()) } }\npub fn command_capture_env_run(args:&[String])->Result<(),String>{ if args.len()<7 { return Err(\"command-capture-env expects root receipt-relative timeout-ms cwd-relative env-cell program [args...]\".to_owned()); }\nif eoie_batch_matrix_row_policy(0,0)!=1 || eoie_batch_matrix_dependency(0,0)!=1 { return Err(\"typed batch matrix authority rejected\".to_owned()); } let root=Path::new(batch_arg(args,1,\"root\")?); let timeout=batch_timeout(batch_arg(args,3,\"timeout-ms\")?)?; let result=batch_capture(root,batch_arg(args,2,\"receipt-relative\")?,timeout,batch_arg(args,4,\"cwd-relative\")?,batch_arg(args,5,\"env-cell\")?,batch_arg(args,6,\"program\")?,&args[7..])?; println!(\"eoie proxy command-capture-env ok status={} elapsed_ms={} stdout_bytes={} stderr_bytes={}\",result.0,result.1,result.2,result.3); Ok(()) }\npub fn command_capture_matrix_run(args:&[String])->Result<(),String>{ batch_execute_matrix(args,false) }\npub fn batch_plan_run(args:&[String])->Result<(),String>{ batch_execute_matrix(args,true) }\npub fn command_capture_matrix_gate_run(args:&[String])->Result<(),String>{ if args.len()!=3 { return Err(\"command-capture-matrix-gate expects root report-relative\".to_owned()); } let root=Path::new(batch_arg(args,1,\"root\")?); let report=root.join(batch_safe_relative(batch_arg(args,2,\"report-relative\")?)?); let text=fs::read_to_string(&report).map_err(|e|format!(\"read {}: {e}\",report.display()))?; let blockers=text.lines().skip(1).filter(|line| line.split('\\t').nth(3)==Some(\"blocked\")).count(); if blockers==0 { println!(\"eoie proxy command-capture-matrix-gate ok report={} blockers=0\",report.display()); Ok(()) } else { Err(format!(\"matrix gate blocked rows={blockers}\")) } }\npub fn batch_plan_resume_run(args:&[String])->Result<(),String>{ if args.len()!=4 { return Err(\"batch-plan-resume expects root report-relative resume-relative\".to_owned()); } let root=Path::new(batch_arg(args,1,\"root\")?); let report=root.join(batch_safe_relative(batch_arg(args,2,\"report-relative\")?)?); let resume=root.join(batch_safe_relative(batch_arg(args,3,\"resume-relative\")?)?); let text=fs::read_to_string(&report).map_err(|e|format!(\"read {}: {e}\",report.display()))?; let mut out=String::from(\"id\\tresume_action\\tstatus\\n\"); let mut hard=0usize; for line in text.lines().skip(1) { if line.trim().is_empty(){continue;} let cells=line.split('\\t').collect::<Vec<_>>(); if cells.len()<8 {continue;} let accepted=if cells[3]==\"pass\"{1}else{0}; let policy=if cells[5]==\"continue\"{1}else{0}; let action=eoie_batch_matrix_resume_action(accepted,policy); let status=if action==2 {hard+=1;\"blocked\"} else {\"pass\"}; out.push_str(&format!(\"{}\\t{}\\t{}\\n\",cells[0],action,status)); } batch_atomic_write(&resume,out.as_bytes())?; println!(\"eoie proxy batch-plan-resume ok resume={} hard_rerun={}\",resume.display(),hard); Ok(()) }"
