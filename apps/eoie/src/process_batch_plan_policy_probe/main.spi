open rust_std_env.model

inl accept (~checkpoint : i32) (~event : i32) : i32 =
    !\((checkpoint,event), $'"process_batch_plan_domain::eoie_batch_plan_accept($0, $1)"')

inl advance (~checkpoint : i32) (~event : i32) : i32 =
    !\((checkpoint,event), $'"process_batch_plan_domain::eoie_batch_plan_advance($0, $1)"')

inl row_policy (~required : i32) (~policy : i32) : i32 =
    !\((required,policy), $'"process_batch_plan_domain::eoie_batch_matrix_row_policy($0, $1)"')

inl dependency (~has_dependency : i32) (~dependency_passed : i32) : i32 =
    !\((has_dependency,dependency_passed), $'"process_batch_plan_domain::eoie_batch_matrix_dependency($0, $1)"')

inl observed (~required : i32) (~exit_code : i32) : i32 =
    !\((required,exit_code), $'"process_batch_plan_domain::eoie_batch_matrix_observed_accept($0, $1)"')

inl resume (~accepted : i32) (~policy : i32) : i32 =
    !\((accepted,policy), $'"process_batch_plan_domain::eoie_batch_matrix_resume_action($0, $1)"')

inl workspace_policy (~program_requested : i32) (~nested_manifest : i32) : i32 =
    !\((program_requested,nested_manifest), $'"process_batch_plan_domain::eoie_batch_matrix_workspace_policy($0, $1)"')

inl main () : i32 =
    inl spawn = advance 0i32 0i32
    inl run = advance spawn 1i32
    inl link = advance run 2i32
    inl complete = advance link 4i32
    inl row_pass = row_policy 0i32 0i32
    inl row_block = row_policy 1i32 1i32
    inl dep_root = dependency 0i32 0i32
    inl dep_pass = dependency 1i32 1i32
    inl accept_pass = observed 0i32 0i32
    inl accept_block = observed 1i32 1i32
    inl resume_skip = resume 1i32 0i32
    inl cargo_nested = workspace_policy 2i32 1i32
    inl cargo_root = workspace_policy 3i32 1i32
    inl noncargo_nested = workspace_policy 0i32 1i32
    inl invalid_workspace = workspace_policy 4i32 1i32
    if !!!!EQ(spawn,1i32) then
        if !!!!EQ(run,2i32) then
            if !!!!EQ(link,3i32) then
                if !!!!EQ(complete,5i32) then
                    if !!!!EQ(row_pass,1i32) then
                        if !!!!EQ(row_block,1i32) then
                            if !!!!EQ(dep_root,1i32) then
                                if !!!!EQ(dep_pass,1i32) then
                                    if !!!!EQ(accept_pass,1i32) then
                                        if !!!!EQ(accept_block,1i32) then
                                            if !!!!EQ(resume_skip,0i32) then
                                                if !!!!EQ(cargo_nested,1i32) then
                                                    if !!!!EQ(cargo_root,0i32) then
                                                        if !!!!EQ(noncargo_nested,0i32) then
                                                            if !!!!LT(invalid_workspace,0i32) then 0i32 else 1i32
                                                        else 1i32
                                                    else 1i32
                                                else 1i32
                                            else 1i32
                                        else 1i32
                                    else 1i32
                                else 1i32
                            else 1i32
                        else 1i32
                    else 1i32
                else 1i32
            else 1i32
        else 1i32
    else 1i32
