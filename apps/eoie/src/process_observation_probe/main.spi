open eoie_process_observation.process_observation

inl main () : i32 =
    inl plan = smoke_plan ()
    inl observation = smoke_observation ()
    match plan, observation with
    | ProcessLaunch (label, budget), ProcessObservation (ProcessStatusPassed status, ProcessExited exit_code, ElapsedMilliseconds elapsed, ProcessStdout stdout_text, ProcessStderr stderr_text) =>
        if !!!!EQ(label,"process-observation-smoke") && !!!!EQ(budget,1u64) && !!!!EQ(status,0i32) && !!!!EQ(exit_code,0i32) && !!!!EQ(elapsed,1u64) && !!!!EQ(stdout_text,"") && !!!!EQ(stderr_text,"")
        then 0i32
        else 1i32
    | _ => 1i32
