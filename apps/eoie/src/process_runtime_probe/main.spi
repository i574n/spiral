open rust_std_process.model

nominal probe_start = ()
nominal probe_input = ()
nominal probe_channels = ()
nominal probe_done = ()

union process_probe from to =
    | ProveInputRoundtrip :: process_probe probe_start probe_input
    | ProveBothChannels :: process_probe probe_input probe_channels
    | ProveClosedStdin :: process_probe probe_channels probe_done

inl main () : i32 =
    inl _ : process_probe probe_start probe_input = ProveInputRoundtrip
    inl stdin_word = cat_roundtrip_word "stdin-value"
    inl stdin_code = capture_word_code stdin_word
    inl stdin_stdout = capture_word_stdout_metric stdin_word
    inl stdin_stderr = capture_word_stderr_metric stdin_word
    if !!!!EQ(stdin_code,0i32) then
        if !!!!EQ(stdin_stdout,1i32) then
            if !!!!EQ(stdin_stderr,1i32) then
                inl _ : process_probe probe_input probe_channels = ProveBothChannels
                inl channels_word = shell_capture_word "printf stdout-value && printf stderr-value >&2"
                inl channels_code = capture_word_code channels_word
                inl channels_stdout = capture_word_stdout_metric channels_word
                inl channels_stderr = capture_word_stderr_metric channels_word
                if !!!!EQ(channels_code,0i32) then
                    if !!!!EQ(channels_stdout,12i32) then
                        if !!!!EQ(channels_stderr,12i32) then
                            inl _ : process_probe probe_channels probe_done = ProveClosedStdin
                            inl closed_word = shell_closed_stdin_word "read value || printf done"
                            inl closed_code = capture_word_code closed_word
                            inl closed_stdout = capture_word_stdout_metric closed_word
                            inl closed_stderr = capture_word_stderr_metric closed_word
                            if !!!!EQ(closed_code,0i32) then
                                if !!!!EQ(closed_stdout,4i32) then
                                    if !!!!EQ(closed_stderr,0i32) then 0i32 else 33i32
                                else 32i32
                            else 31i32
                        else 23i32
                    else 22i32
                else 21i32
            else 13i32
        else 12i32
    else 11i32
