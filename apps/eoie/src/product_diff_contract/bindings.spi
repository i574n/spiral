open model

let proxy_product_diff_request_binding (left_valid : i32) (right_valid : i32) : i32 =
    product_diff_request_binding left_valid right_valid

let proxy_product_diff_summary_binding (changed_entries : i32) (total_entries : i32) : i32 =
    product_diff_summary_binding changed_entries total_entries

let proxy_product_diff_worker_binding (workers : i32) (available : i32) : i32 =
    parallel_search_contract.model.parallel_search_worker_binding workers available
