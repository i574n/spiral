inl eq_i32 (a : i32) (b : i32) : bool = !!!!EQ(a,b)

inl positive_ok () : bool =
    inl _ = product_diff_contract.model.product_diff_public_plan ()
    eq_i32 (product_diff_contract.model.product_diff_request_binding 1i32 1i32) 1i32 &&
    eq_i32 (product_diff_contract.model.product_diff_summary_binding 0i32 5i32) 1i32 &&
    eq_i32 (product_diff_contract.model.product_diff_summary_binding 3i32 5i32) 1i32 &&
    eq_i32 (product_diff_contract.bindings.proxy_product_diff_request_binding 1i32 1i32) 1i32 &&
    eq_i32 (product_diff_contract.bindings.proxy_product_diff_summary_binding 2i32 5i32) 1i32 &&
    eq_i32 (product_diff_contract.bindings.proxy_product_diff_worker_binding 1i32 56i32) 1i32

inl negative_ok () : bool =
    eq_i32 (product_diff_contract.model.product_diff_request_binding 0i32 1i32) 0i32 &&
    eq_i32 (product_diff_contract.model.product_diff_request_binding 1i32 0i32) 0i32 &&
    eq_i32 (product_diff_contract.model.product_diff_summary_binding -1i32 5i32) 0i32 &&
    eq_i32 (product_diff_contract.model.product_diff_summary_binding 6i32 5i32) 0i32 &&
    eq_i32 (product_diff_contract.bindings.proxy_product_diff_worker_binding 0i32 56i32) 0i32 &&
    eq_i32 (product_diff_contract.bindings.proxy_product_diff_worker_binding 57i32 56i32) 0i32

inl main () : i32 = if positive_ok () && negative_ok () then 0i32 else 1i32
