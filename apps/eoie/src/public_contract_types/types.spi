// Public contract endpoint and subject vocabulary shared by executable contracts.
nominal contract_cold = ()
nominal contract_identified = ()
nominal contract_mutated = ()
nominal contract_bundled = ()
nominal contract_evidenced = ()
nominal contract_closed = ()

union contract_subject =
    | PublicSurface :: contract_subject
    | RootedFilesystem :: contract_subject
    | TypedMutation :: contract_subject
    | FlatBundle :: contract_subject
    | CoveragePruning :: contract_subject
