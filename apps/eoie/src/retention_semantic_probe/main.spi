open rust_std_env.model
open rust_std_process.model
open rust_std_fs.model
open rust_std_fs.rooted_effects

nominal retention_probe_start = ()
nominal retention_probe_fixture_ready = ()
nominal retention_probe_planned = ()
nominal retention_probe_receipt_verified = ()
nominal retention_probe_complete = ()

union retention_semantic_transition from to =
    | PrepareRetentionFixture :: retention_semantic_transition retention_probe_start retention_probe_fixture_ready
    | PlanRetentionWindow :: retention_semantic_transition retention_probe_fixture_ready retention_probe_planned
    | VerifyOpaqueReceipt :: retention_semantic_transition retention_probe_planned retention_probe_receipt_verified
    | ConfirmNestedCurrentRejected :: retention_semantic_transition retention_probe_receipt_verified retention_probe_complete

inl main () : i32 =
    inl eoie = argument_owned 0i32
    inl base = "/mnt/data/eoie-retention-semantic-probe"
    inl state = "/mnt/data/eoie-retention-semantic-probe/state"
    inl package = "/mnt/data/eoie-retention-semantic-probe/state/package.spiproj"
    inl receipt = "/mnt/data/eoie-retention-semantic-probe/state/retention_receipt.spi"
    inl rejected_receipt = "/mnt/data/eoie-retention-semantic-probe/state/rejected_receipt.spi"
    inl _ = cleanup_tree base
    inl _ : retention_semantic_transition retention_probe_start retention_probe_fixture_ready = PrepareRetentionFixture
    inl prepared = create_dir state && write_text package "modules:\n    retention_receipt\n" && write_text "/mnt/data/eoie-retention-semantic-probe/bundle_eoie_alpha1.zip" "one" && write_text "/mnt/data/eoie-retention-semantic-probe/bundle_eoie_alpha2.zip" "two" && write_text "/mnt/data/eoie-retention-semantic-probe/bundle_eoie_alpha3.zip" "three" && write_text "/mnt/data/eoie-retention-semantic-probe/bundle_eoie_alpha4.zip" "four" && write_text "/mnt/data/eoie-retention-semantic-probe/bundle_eoie_alpha5.zip" "five"
    if prepared then
        inl _ : retention_semantic_transition retention_probe_fixture_ready retention_probe_planned = PlanRetentionWindow
        inl plan_code = status_code5 eoie "bundle" "retention-plan" base "bundle_eoie_alpha5.zip" receipt
        if !!!!EQ(plan_code,0i32) then
            inl _ : retention_semantic_transition retention_probe_planned retention_probe_receipt_verified = VerifyOpaqueReceipt
            inl ok = text_contains "fingerprint=" receipt && text_contains "current=" receipt && text_contains "candidates=5" receipt && text_contains "deletes=2" receipt && text_contains "remaining=5" receipt && text_contains "status=planned" receipt && text_excludes "bundle_eoie_alpha" receipt
            if ok then
                inl invalid_code = status_code5 eoie "bundle" "retention-plan" base "nested/current.zip" rejected_receipt
                inl _ = cleanup_tree base
                if !!!!EQ(invalid_code,0i32) then 31i32
                else
                    inl _ : retention_semantic_transition retention_probe_receipt_verified retention_probe_complete = ConfirmNestedCurrentRejected
                    0i32
            else
                inl _ = cleanup_tree base
                21i32
        else
            inl _ = cleanup_tree base
            11i32
    else 1i32
