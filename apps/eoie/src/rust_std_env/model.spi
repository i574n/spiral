
inl args_len_is (~expected : i32) : bool =
    $'i32::try_from(std::env::args().skip(2).count()).unwrap_or(i32::MAX) == !expected ' : bool

inl argument_len (~index : i32) : i32 =
    $'usize::try_from(!index).ok().and_then(|index| std::env::args().skip(2).nth(index)).map_or(-1, |value| i32::try_from(value.len()).unwrap_or(i32::MAX))' : i32

inl argument_byte (~index : i32) (~offset : i32) : i32 =
    $'usize::try_from(!index).ok().and_then(|index| std::env::args().skip(2).nth(index)).and_then(|value| usize::try_from(!offset).ok().and_then(|offset| value.as_bytes().get(offset).copied())).map_or(-1, i32::from)' : i32

inl argument_equals (~index : i32) (~expected : string) : bool =
    $'usize::try_from(!index).ok().and_then(|index| std::env::args().skip(2).nth(index)).is_some_and(|value| value.as_str() == !expected.as_ref())' : bool

inl argument_owned (~index : i32) : string =
    $'usize::try_from(!index).ok().and_then(|index| std::env::args().skip(2).nth(index)).map_or_else(std::rc::Rc::<str>::default, std::rc::Rc::<str>::from)' : string
