inl rust_global (x : string) : () = !!!!Global(x)

inl emit_paths () : () =
    rust_global "pub fn safe_relative_path(value: &str) -> Result<PathBuf, String> {\n    let path = Path::new(value);\n    #[cfg(windows)] for c in path.components() {\n        if let std::path::Component::Normal(n) = c { windows_validate_component(n)?; }\n    }\n    if value.is_empty() || path.is_absolute() { return Err(format!(\"unsafe relative path: {value}\")); }\n    for component in path.components() { if !matches!(component, std::path::Component::Normal(_)) { return Err(format!(\"unsafe relative path: {value}\")); } }\n    Ok(path.to_path_buf())\n}\n\nfn reject_symlink_ancestors(root: &Path, relative: &Path) -> Result<(), String> {\n    let root_metadata = std::fs::symlink_metadata(root).map_err(|error| format!(\"metadata {}: {error}\", root.display()))?;\n    if root_metadata.file_type().is_symlink() || !root_metadata.is_dir() { return Err(format!(\"root must be a real directory: {}\", root.display())); }\n    let components = relative.components().collect::<Vec<_>>();\n    let mut cursor = root.to_path_buf();\n    for component in components.iter().take(components.len().saturating_sub(1)) {\n        cursor.push(component.as_os_str());\n        match std::fs::symlink_metadata(&cursor) {\n            Ok(metadata) if metadata.file_type().is_symlink() => return Err(format!(\"symlink ancestor rejected: {}\", cursor.display())),\n            Ok(metadata) if !metadata.is_dir() => return Err(format!(\"non-directory ancestor rejected: {}\", cursor.display())),\n            Ok(_) => {},\n            Err(error) if error.kind() == std::io::ErrorKind::NotFound => break,\n            Err(error) => return Err(format!(\"metadata {}: {error}\", cursor.display())),\n        }\n    }\n    Ok(())\n}\n\npub fn rooted_path(root: &Path, relative: &str) -> Result<PathBuf, String> {\n    let relative = safe_relative_path(relative)?;\n    reject_symlink_ancestors(root, &relative)?;\n    Ok(root.join(relative))\n}\n\npub fn copy_regular_atomic_preserve(source: &Path, target: &Path) -> Result<u64, String> {\n    eoie_rust_std_fs_mutation::copy_regular_atomic_preserve(source, target)\n}\n"
