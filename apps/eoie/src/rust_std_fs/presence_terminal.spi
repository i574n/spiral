inl rust_global (x : string) : () = !!!!Global(x)

inl emit_presence () : () =
    rust_global "#[cfg(target_os = \"linux\")] pub fn rooted_entry_exists(path: &Path) -> Result<bool, String> {\n    use std::ffi::CString;\n    use std::os::fd::{AsRawFd as _, FromRawFd as _};\n    use std::os::raw::{c_char, c_int};\n    use std::os::unix::ffi::OsStrExt as _;\n    const O_PATH: c_int = 0o10000000;\n    const O_CLOEXEC: c_int = 0o2000000;\n    const O_NOFOLLOW: c_int = 0o400000;\n    unsafe extern \"C\" { fn openat(dirfd: c_int, pathname: *const c_char, flags: c_int, ...) -> c_int; }\n    let parent = path.parent().ok_or_else(|| format!(\"entry has no parent: {}\", path.display()))?;\n    let leaf = path.file_name().ok_or_else(|| format!(\"entry has no leaf: {}\", path.display()))?;\n    let directory = open_nofollow_path(parent, true)?;\n    let encoded = CString::new(leaf.as_bytes()).map_err(|_| \"entry leaf contains NUL\".to_owned())?;\n    let fd = unsafe { openat(directory.as_raw_fd(), encoded.as_ptr(), O_PATH | O_CLOEXEC | O_NOFOLLOW) };\n    if fd >= 0 { drop(unsafe { std::fs::File::from_raw_fd(fd) }); return Ok(true); }\n    let error = std::io::Error::last_os_error();\n    if error.kind() == std::io::ErrorKind::NotFound { Ok(false) } else { Err(format!(\"nofollow presence {}: {error}\", path.display())) }\n}\n#[cfg(not(any(target_os = \"linux\", windows)))] pub fn rooted_entry_exists(_path: &Path) -> Result<bool, String> { Err(\"descriptor-relative presence requires the Linux backend\".to_owned()) }\n\n#[cfg(all(test, target_os = \"linux\"))] mod descriptor_presence_tests {\n    use super::*;\n    use std::os::unix::fs::symlink;\n    #[test] fn presence_is_nofollow_and_descriptor_relative() {\n        let nonce = std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).unwrap().as_nanos();\n        let root = std::env::temp_dir().join(format!(\"eoie-presence-{}-{nonce}\", std::process::id()));\n        let real = root.join(\"real\");\n        let file = real.join(\"file.txt\");\n        let ancestor = root.join(\"ancestor\");\n        let leaf = root.join(\"leaf\");\n        std::fs::create_dir_all(&real).unwrap();\n        std::fs::write(&file, b\"x\").unwrap();\n        symlink(&real, &ancestor).unwrap();\n        symlink(&file, &leaf).unwrap();\n        assert!(rooted_entry_exists(&real).unwrap());\n        assert!(rooted_entry_exists(&file).unwrap());\n        assert!(rooted_entry_exists(&leaf).unwrap());\n        assert!(!rooted_entry_exists(&root.join(\"missing\")).unwrap());\n        assert!(rooted_entry_exists(&ancestor.join(\"file.txt\")).is_err());\n        std::fs::remove_file(&ancestor).unwrap();\n        std::fs::remove_file(&leaf).unwrap();\n        std::fs::remove_dir_all(&root).unwrap();\n    }\n}"
