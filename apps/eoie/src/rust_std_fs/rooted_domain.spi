nominal unknown_path = string
nominal regular_path = string
nominal directory_path = string
nominal absent_path = string

union rooted_transition from to =
    | DiscoverRegular :: rooted_transition unknown_path regular_path
    | DiscoverDirectory :: rooted_transition unknown_path directory_path
    | DiscoverAbsent :: rooted_transition unknown_path absent_path
    | CopyRegular :: rooted_transition (regular_path * absent_path) regular_path
    | RemoveRegular :: rooted_transition regular_path absent_path
    | RemoveDirectory :: rooted_transition directory_path absent_path

union rooted_policy_result state =
    | RootedPolicyAccepted :: forall state. rooted_policy_result state
    | RootedPolicyRejected :: forall state. rooted_policy_result state

inl unknown (path : string) : unknown_path = unknown_path path
inl regular (path : string) : regular_path = regular_path path
inl directory (path : string) : directory_path = directory_path path
inl absent (path : string) : absent_path = absent_path path

inl transition_allowed forall from to. (transition : rooted_transition from to) : rooted_policy_result to =
    match transition with
    | DiscoverRegular => RootedPolicyAccepted
    | DiscoverDirectory => RootedPolicyAccepted
    | DiscoverAbsent => RootedPolicyAccepted
    | CopyRegular => RootedPolicyAccepted
    | RemoveRegular => RootedPolicyAccepted
    | RemoveDirectory => RootedPolicyAccepted

inl policy_accepted forall state. (result : rooted_policy_result state) : bool =
    match result with
    | RootedPolicyAccepted => true
    | RootedPolicyRejected => false
