
inl create_dir (path : string) : bool =
    $'std::fs::create_dir_all(&*!path).is_ok()' : bool

inl copy_atomic (source : string) (target : string) : bool =
    $'eoie_rust_std_fs::rooted_copy_atomic(std::path::Path::new(&*!source), std::path::Path::new(&*!target)).is_ok()' : bool

inl remove_regular (path : string) : bool =
    $'eoie_rust_std_fs::rooted_remove_regular(std::path::Path::new(&*!path)).is_ok()' : bool

inl remove_tree_within (root : string) (path : string) : bool =
    $'eoie_rust_std_fs::rooted_remove_tree_within(std::path::Path::new(&*!root), std::path::Path::new(&*!path)).is_ok()' : bool

inl read_limited_len (path : string) (limit : int) : int =
    $'eoie_rust_std_fs::rooted_read_limited(std::path::Path::new(&*!path), usize::try_from(!limit).unwrap_or(0)).map_or(-1, |bytes| i32::try_from(bytes.len()).unwrap_or(-1))' : int

inl read_regular_len (path : string) (limit : int) : int =
    $'eoie_rust_std_fs::read_regular_limited(std::path::Path::new(&*!path), usize::try_from(!limit).unwrap_or(0)).map_or(-1, |bytes| i32::try_from(bytes.len()).unwrap_or(-1))' : int

inl read_regular_text_equals (path : string) (limit : int) (expected : string) : bool =
    $'eoie_rust_std_fs::read_regular_text_limited(std::path::Path::new(&*!path), usize::try_from(!limit).unwrap_or(0)).is_ok_and(|value| value == *!expected)' : bool

inl descriptor_nofollow_native () : bool =
    $'eoie_rust_std_fs::descriptor_nofollow_capability() == "descriptor-relative-nofollow"' : bool

inl create_symlink (source : string) (target : string) : bool =
    $'std::os::unix::fs::symlink(&*!source, &*!target).is_ok()' : bool

inl list_len (path : string) : int =
    $'eoie_rust_std_fs::rooted_list_names(std::path::Path::new(&*!path)).map_or(-1, |names| i32::try_from(names.len()).unwrap_or(-1))' : int

inl tree_missing (path : string) : bool =
    $'\!std::path::Path::new(&*!path).exists()' : bool

inl cleanup_tree (path : string) : bool =
    $'std::fs::remove_dir_all(&*!path).is_ok() || \!std::path::Path::new(&*!path).exists()' : bool
