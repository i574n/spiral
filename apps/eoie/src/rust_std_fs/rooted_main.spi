open model
open rooted_effects

inl root () = "/tmp/eoie-rooted-filesystem-main"
inl source () = "/tmp/eoie-rooted-filesystem-main/source.txt"
inl copied () = "/tmp/eoie-rooted-filesystem-main/copied.txt"

inl rooted_roundtrip () : bool =
    cleanup_tree (root ())
        && create_dir (root ())
        && model.write_text (source ()) "abcdef"
        && copy_atomic (source ()) (copied ())
        && model.text_equals "abcdef" (copied ())
        && remove_regular (copied ())
        && model.file_missing (copied ())
        && remove_tree_within "/tmp" (root ())
        && tree_missing (root ())

inl main () : i32 =
    if rooted_roundtrip () then 0i32 else 1i32
