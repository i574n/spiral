open rooted_domain

union rooted_negative_fixture =
    | RemoveDirectoryAsRegular
    | RemoveRegularAsDirectory
    | CopyMissingSource
    | RemoveRootItself

inl fixtures_are_closed () : bool =
    match RemoveDirectoryAsRegular, RemoveRegularAsDirectory, CopyMissingSource, RemoveRootItself with
    | RemoveDirectoryAsRegular, RemoveRegularAsDirectory, CopyMissingSource, RemoveRootItself => true

inl main () : i32 =
    if fixtures_are_closed () then 0i32 else 1i32
