inl rust_global (x : string) : () = real typecase `(!!!!LitToTypeLit(x)) with ~x => $"RustGlobal(@x)" : ()

inl emit_rooted () : () = rust_global "use std::io::Read;\ninclude!(concat!(env!(\"CARGO_MANIFEST_DIR\"), \"/portable.rs\"));\n#[cfg(windows)] include!(concat!(env!(\"CARGO_MANIFEST_DIR\"), \"/windows.rs\"));\n\n#[cfg(target_os = \"linux\")]\nfn open_nofollow_path(path: &Path, final_directory: bool) -> Result<std::fs::File, String> {\n    use std::ffi::CString;\n    use std::os::fd::{AsRawFd, FromRawFd};\n    use std::os::raw::{c_char, c_int};\n    use std::os::unix::ffi::OsStrExt;\n\n    const AT_FDCWD: c_int = -100;\n    const O_RDONLY: c_int = 0;\n    const O_CLOEXEC: c_int = 0o2000000;\n    const O_DIRECTORY: c_int = 0o200000;\n    const O_NOFOLLOW: c_int = 0o400000;\n\n    unsafe extern \"C\" {\n        fn openat(dirfd: c_int, pathname: *const c_char, flags: c_int, ...) -> c_int;\n    }\n\n    fn open_component(dirfd: c_int, name: &std::ffi::OsStr, directory: bool) -> Result<std::fs::File, String> {\n        let encoded = CString::new(name.as_bytes()).map_err(|_| \"path component contains NUL\".to_owned())?;\n        let flags = O_RDONLY | O_CLOEXEC | O_NOFOLLOW | if directory { O_DIRECTORY } else { 0 };\n        let fd = unsafe { openat(dirfd, encoded.as_ptr(), flags) };\n        if fd < 0 {\n            return Err(format!(\"openat nofollow {}: {}\", name.to_string_lossy(), std::io::Error::last_os_error()));\n        }\n        Ok(unsafe { std::fs::File::from_raw_fd(fd) })\n    }\n\n    let base_name = if path.is_absolute() { std::ffi::OsStr::new(\"/\") } else { std::ffi::OsStr::new(\".\") };\n    let mut current = open_component(AT_FDCWD, base_name, true)?;\n    let mut components = Vec::new();\n    for component in path.components() {\n        match component {\n            std::path::Component::RootDir | std::path::Component::CurDir => {},\n            std::path::Component::Normal(value) => components.push(value.to_os_string()),\n            std::path::Component::ParentDir => return Err(format!(\"parent component rejected: {}\", path.display())),\n            std::path::Component::Prefix(_) => return Err(format!(\"platform prefix rejected: {}\", path.display())),\n        }\n    }\n    if components.is_empty() {\n        if final_directory { return Ok(current); }\n        return Err(format!(\"regular file path required: {}\", path.display()));\n    }\n    let last = components.len() - 1;\n    for (index, component) in components.iter().enumerate() {\n        let directory = index != last || final_directory;\n        current = open_component(current.as_raw_fd(), component.as_os_str(), directory)?;\n    }\n    Ok(current)\n}\n\n#[cfg(not(any(target_os = \"linux\", windows)))]\nfn open_nofollow_path(_path: &Path, _final_directory: bool) -> Result<std::fs::File, String> {\n    Err(\"descriptor-relative nofollow read requires the Linux backend\".to_owned())\n}\n\npub fn descriptor_nofollow_capability() -> &'static str {\n    #[cfg(windows)] { return \"windows-locked-ancestor-nofollow\"; }\n    #[cfg(target_os = \"linux\")]\n    { \"descriptor-relative-nofollow\" }\n    #[cfg(not(any(target_os = \"linux\", windows)))]\n    { \"unsupported-fail-closed\" }\n}\n\nfn read_prefix_nofollow(path: &Path, limit: usize) -> Result<Vec<u8>, String> {\n    let mut file = open_nofollow_path(path, false)?;\n    let metadata = file.metadata().map_err(|error| format!(\"metadata {}: {error}\", path.display()))?;\n    if !metadata.is_file() { return Err(format!(\"regular file required: {}\", path.display())); }\n    let mut bytes = Vec::with_capacity(limit.min(64 * 1024));\n    std::io::Read::take(&mut file, u64::try_from(limit).unwrap_or(u64::MAX))\n        .read_to_end(&mut bytes)\n        .map_err(|error| format!(\"read {}: {error}\", path.display()))?;\n    Ok(bytes)\n}\n\n#[cfg(target_os = \"linux\")]\nfn list_names_from_directory(directory: &std::fs::File) -> Result<Vec<String>, String> {\n    use std::os::fd::AsRawFd as _;\n    let descriptor_path = PathBuf::from(format!(\"/proc/self/fd/{}\", directory.as_raw_fd()));\n    let mut names = Vec::new();\n    for entry in std::fs::read_dir(&descriptor_path).map_err(|error| format!(\"read descriptor directory {}: {error}\", descriptor_path.display()))? {\n        names.push(entry.map_err(|error| error.to_string())?.file_name().to_string_lossy().into_owned());\n    }\n    names.sort();\n    Ok(names)\n}\n\n#[cfg(target_os = \"linux\")]\npub fn rooted_list_names(path: &Path) -> Result<Vec<String>, String> {\n    let directory = open_nofollow_path(path, true)?;\n    list_names_from_directory(&directory)\n}\n\n#[cfg(not(any(target_os = \"linux\", windows)))]\npub fn rooted_list_names(_path: &Path) -> Result<Vec<String>, String> {\n    Err(\"descriptor-relative directory listing requires the Linux backend\".to_owned())\n}\n\n#[cfg(target_os = \"linux\")]\npub fn rooted_canonical_directory(path: &Path) -> Result<PathBuf, String> {\n    use std::os::fd::AsRawFd as _;\n    let directory = open_nofollow_path(path, true)?;\n    let descriptor_path = PathBuf::from(format!(\"/proc/self/fd/{}\", directory.as_raw_fd()));\n    std::fs::read_link(&descriptor_path).map_err(|error| format!(\"read descriptor path {}: {error}\", descriptor_path.display()))\n}\n\n#[cfg(not(any(target_os = \"linux\", windows)))]\npub fn rooted_canonical_directory(_path: &Path) -> Result<PathBuf, String> {\n    Err(\"descriptor-relative canonical directory requires the Linux backend\".to_owned())\n}\n\n#[cfg(target_os = \"linux\")]\npub fn rooted_read_symlink(path: &Path) -> Result<PathBuf, String> {\n    use std::ffi::CString;\n    use std::os::fd::AsRawFd as _;\n    use std::os::raw::{c_char, c_int};\n    use std::os::unix::ffi::{OsStrExt as _, OsStringExt as _};\n\n    unsafe extern \"C\" {\n        fn readlinkat(dirfd: c_int, pathname: *const c_char, buf: *mut c_char, bufsiz: usize) -> isize;\n    }\n\n    let parent = path.parent().ok_or_else(|| format!(\"symlink has no parent: {}\", path.display()))?;\n    let name = path.file_name().ok_or_else(|| format!(\"symlink has no leaf: {}\", path.display()))?;\n    let parent_directory = open_nofollow_path(parent, true)?;\n    let encoded = CString::new(name.as_bytes()).map_err(|_| \"symlink leaf contains NUL\".to_owned())?;\n    let mut bytes = vec![0u8; 4096];\n    let count = unsafe { readlinkat(parent_directory.as_raw_fd(), encoded.as_ptr(), bytes.as_mut_ptr() as *mut c_char, bytes.len()) };\n    if count < 0 { return Err(format!(\"readlinkat {}: {}\", path.display(), std::io::Error::last_os_error())); }\n    let count = usize::try_from(count).map_err(|_| \"negative symlink length\".to_owned())?;\n    if count == bytes.len() { return Err(format!(\"symlink target too long: {}\", path.display())); }\n    bytes.truncate(count);\n    Ok(PathBuf::from(std::ffi::OsString::from_vec(bytes)))\n}\n\n#[cfg(not(any(target_os = \"linux\", windows)))]\npub fn rooted_read_symlink(_path: &Path) -> Result<PathBuf, String> {\n    Err(\"descriptor-relative symlink read requires the Linux backend\".to_owned())\n}\n\npub fn rooted_open_regular_read(path: &Path) -> Result<std::fs::File, String> {\n    let file = open_nofollow_path(path, false)?;\n    let metadata = file.metadata().map_err(|error| format!(\"metadata {}: {error}\", path.display()))?;\n    if !metadata.is_file() { return Err(format!(\"regular file required: {}\", path.display())); }\n    Ok(file)\n}\n\npub fn rooted_regular_size(path: &Path) -> Result<u64, String> {\n    let file = rooted_open_regular_read(path)?;\n    file.metadata().map(|metadata| metadata.len()).map_err(|error| format!(\"metadata {}: {error}\", path.display()))\n}\n\npub fn rooted_read_limited(path: &Path, limit: usize) -> Result<Vec<u8>, String> {\n    read_prefix_nofollow(path, limit)\n}\n\npub fn read_regular_limited(path: &Path, limit: usize) -> Result<Vec<u8>, String> {\n    let mut file = open_nofollow_path(path, false)?;\n    let metadata = file.metadata().map_err(|error| format!(\"metadata {}: {error}\", path.display()))?;\n    if !metadata.is_file() { return Err(format!(\"regular file required: {}\", path.display())); }\n    let observed = usize::try_from(metadata.len()).map_err(|_| \"regular file length does not fit usize\".to_owned())?;\n    if observed > limit { return Err(format!(\"regular file exceeds limit: {} bytes={} limit={}\", path.display(), observed, limit)); }\n    let read_limit = if limit == usize::MAX { limit } else { limit.checked_add(1).ok_or_else(|| \"regular file read limit overflow\".to_owned())? };\n    let mut bytes = Vec::with_capacity(observed);\n    std::io::Read::take(&mut file, u64::try_from(read_limit).unwrap_or(u64::MAX))\n        .read_to_end(&mut bytes)\n        .map_err(|error| format!(\"read {}: {error}\", path.display()))?;\n    if bytes.len() > limit { return Err(format!(\"regular file grew during read: {} limit={}\", path.display(), limit)); }\n    if bytes.len() != observed { return Err(format!(\"regular file changed during read: {} expected={} observed={}\", path.display(), observed, bytes.len())); }\n    Ok(bytes)\n}\n\npub fn read_regular_text_limited(path: &Path, limit: usize) -> Result<String, String> {\n    String::from_utf8(read_regular_limited(path, limit)?).map_err(|error| format!(\"regular file is not UTF-8: {}: {error}\", path.display()))\n}\npub fn rooted_copy_atomic(source: &Path, target: &Path) -> Result<usize, String> {\n    let bytes = read_regular_limited(source, usize::MAX)?;\n    atomic_write(target, &bytes)?;\n    Ok(bytes.len())\n}\n\npub fn rooted_remove_regular(path: &Path) -> Result<(), String> {\n    eoie_rust_std_fs_mutation::rooted_remove_regular(path)\n}\n\npub fn rooted_unlink_nondirectory(path: &Path) -> Result<(), String> {\n    eoie_rust_std_fs_mutation::rooted_unlink_nondirectory(path)\n}\n\npub fn rooted_remove_tree_within(root: &Path, path: &Path) -> Result<u64, String> {\n    eoie_rust_std_fs_mutation::rooted_remove_tree_within(root, path)\n}\n\n#[cfg(all(test, target_os = \"linux\"))]\nmod descriptor_nofollow_tests {\n    use super::*;\n    #[test]\n    fn rejects_symlink_ancestor_and_leaf() {\n        use std::os::unix::fs::symlink;\n        let nonce = std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).unwrap().as_nanos();\n        let root = std::env::temp_dir().join(format!(\"eoie-nofollow-{}-{nonce}\", std::process::id()));\n        let real = root.join(\"real\");\n        let secret = real.join(\"secret.txt\");\n        let ancestor = root.join(\"link\");\n        let leaf = root.join(\"leaf.txt\");\n        std::fs::create_dir_all(&real).unwrap();\n        std::fs::write(&secret, b\"secret\").unwrap();\n        symlink(&real, &ancestor).unwrap();\n        symlink(&secret, &leaf).unwrap();\n        assert_eq!(descriptor_nofollow_capability(), \"descriptor-relative-nofollow\");\n        assert!(rooted_open_regular_read(&secret).is_ok());\n        assert!(rooted_open_regular_read(&ancestor.join(\"secret.txt\")).is_err());\n        assert!(rooted_open_regular_read(&leaf).is_err());\n        assert_eq!(rooted_regular_size(&secret).unwrap(), 6);\n        assert!(rooted_regular_size(&ancestor.join(\"secret.txt\")).is_err());\n        assert!(rooted_regular_size(&leaf).is_err());\n        assert_eq!(rooted_read_symlink(&leaf).unwrap(), secret);\n        assert!(rooted_read_symlink(&ancestor.join(\"secret.txt\")).is_err());\n        assert!(rooted_read_symlink(&real.join(\"secret.txt\")).is_err());\n        assert_eq!(read_regular_limited(&secret, 64).unwrap(), b\"secret\");\n        assert!(read_regular_limited(&ancestor.join(\"secret.txt\"), 64).is_err());\n        assert!(read_regular_limited(&leaf, 64).is_err());\n        std::fs::remove_dir_all(&root).unwrap();\n    }\n    #[test]\n    fn directory_listing_stays_bound_after_path_swap() {\n        use std::os::unix::fs::symlink;\n        let nonce = std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).unwrap().as_nanos();\n        let root = std::env::temp_dir().join(format!(\"eoie-list-fd-{}-{nonce}\", std::process::id()));\n        let watched = root.join(\"watched\");\n        let moved = root.join(\"moved\");\n        let outside = root.join(\"outside\");\n        std::fs::create_dir_all(&watched).unwrap();\n        std::fs::create_dir_all(&outside).unwrap();\n        std::fs::write(watched.join(\"inside.txt\"), b\"inside\").unwrap();\n        std::fs::write(outside.join(\"outside.txt\"), b\"outside\").unwrap();\n        let held = open_nofollow_path(&watched, true).unwrap();\n        std::fs::rename(&watched, &moved).unwrap();\n        symlink(&outside, &watched).unwrap();\n        assert_eq!(list_names_from_directory(&held).unwrap(), vec![\"inside.txt\".to_owned()]);\n        assert!(rooted_list_names(&watched).is_err());\n        std::fs::remove_file(&watched).unwrap();\n        std::fs::remove_dir_all(&root).unwrap();\n    }\n}"