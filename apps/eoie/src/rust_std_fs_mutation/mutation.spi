inl rust_global (x : string) : () = real typecase `(!!!!LitToTypeLit(x)) with ~x => $"RustGlobal(@x)" : ()

inl emit_types () : () =
    rust_global "#[rustfmt::skip]\nmod dense {\n#[cfg(target_os = \"linux\")] use std::io::Write;\n#[cfg(windows)] include!(concat!(env!(\"CARGO_MANIFEST_DIR\"), \"/windows.rs\"));\nuse std::path::{Path, PathBuf};\n\npub struct StagedWriteReceipt {\n    target: PathBuf,\n    temporary: PathBuf,\n    bytes_written: usize,\n    stage_index: i32,\n    backup_slot: i32,\n}\nimpl StagedWriteReceipt {\n    pub fn target(&self) -> &Path { &self.target }\n    pub fn temporary(&self) -> &Path { &self.temporary }\n    pub fn bytes_written(&self) -> usize { self.bytes_written }\n    pub fn stage_index(&self) -> i32 { self.stage_index }\n    pub fn backup_slot(&self) -> i32 { self.backup_slot }\n    pub fn into_temporary(self) -> PathBuf { self.temporary }\n}\n\npub struct PromotionReceipt {\n    target: PathBuf,\n    temporary: PathBuf,\n    stage_index: i32,\n    backup_slot: i32,\n}\nimpl PromotionReceipt {\n    pub fn target(&self) -> &Path { &self.target }\n    pub fn temporary(&self) -> &Path { &self.temporary }\n    pub fn stage_index(&self) -> i32 { self.stage_index }\n    pub fn backup_slot(&self) -> i32 { self.backup_slot }\n}"

inl emit_linux_helpers () : () =
    rust_global "#[cfg(target_os = \"linux\")] use std::ffi::{CString, OsStr, OsString};"
    rust_global "#[cfg(target_os = \"linux\")] use std::os::fd::{AsRawFd, FromRawFd};"
    rust_global "#[cfg(target_os = \"linux\")] use std::os::raw::{c_char, c_int, c_uint};"
    rust_global "#[cfg(target_os = \"linux\")] use std::os::unix::ffi::OsStrExt;"
    rust_global "#[cfg(target_os = \"linux\")] use std::os::unix::fs::{MetadataExt, PermissionsExt};"
    rust_global ""
    rust_global "#[cfg(target_os = \"linux\")] const AT_FDCWD: c_int = -100;"
    rust_global "#[cfg(target_os = \"linux\")] const AT_REMOVEDIR: c_int = 0x200;"
    rust_global "#[cfg(target_os = \"linux\")] const RENAME_NOREPLACE: c_uint = 1;"
    rust_global "#[cfg(target_os = \"linux\")] const O_RDONLY: c_int = 0;"
    rust_global "#[cfg(target_os = \"linux\")] const O_WRONLY: c_int = 1;"
    rust_global "#[cfg(target_os = \"linux\")] const O_CREAT: c_int = 0o100;"
    rust_global "#[cfg(target_os = \"linux\")] const O_EXCL: c_int = 0o200;"
    rust_global "#[cfg(target_os = \"linux\")] const O_CLOEXEC: c_int = 0o2000000;"
    rust_global "#[cfg(target_os = \"linux\")] const O_DIRECTORY: c_int = 0o200000;"
    rust_global "#[cfg(target_os = \"linux\")] const O_NOFOLLOW: c_int = 0o400000;"
    rust_global ""
    rust_global "#[cfg(target_os = \"linux\")] unsafe extern \"C\" {"
    rust_global "    fn openat(dirfd: c_int, pathname: *const c_char, flags: c_int, ...) -> c_int;"
    rust_global "    fn mkdirat(dirfd: c_int, pathname: *const c_char, mode: c_uint) -> c_int;"
    rust_global "    fn renameat(olddirfd: c_int, oldpath: *const c_char, newdirfd: c_int, newpath: *const c_char) -> c_int;"
    rust_global "    fn renameat2(olddirfd: c_int, oldpath: *const c_char, newdirfd: c_int, newpath: *const c_char, flags: c_uint) -> c_int;"
    rust_global "    fn linkat(olddirfd: c_int, oldpath: *const c_char, newdirfd: c_int, newpath: *const c_char, flags: c_int) -> c_int;"
    rust_global "    fn symlinkat(target: *const c_char, newdirfd: c_int, linkpath: *const c_char) -> c_int;"
    rust_global "    fn unlinkat(dirfd: c_int, pathname: *const c_char, flags: c_int) -> c_int;"
    rust_global "}"
    rust_global ""
    rust_global "#[cfg(target_os = \"linux\")] fn c_name(name: &OsStr) -> Result<CString, String> {"
    rust_global "    CString::new(name.as_bytes()).map_err(|_| \"path component contains NUL\".to_owned())"
    rust_global "}"
    rust_global ""
    rust_global "#[cfg(target_os = \"linux\")] fn open_directory_at(dirfd: c_int, name: &OsStr, create: bool) -> Result<std::fs::File, String> {"
    rust_global "    let encoded = c_name(name)?;"
    rust_global "    let flags = O_RDONLY | O_CLOEXEC | O_DIRECTORY | O_NOFOLLOW;"
    rust_global "    let mut fd = unsafe { openat(dirfd, encoded.as_ptr(), flags) };"
    rust_global "    if fd < 0 && create {"
    rust_global "        let first = std::io::Error::last_os_error();"
    rust_global "        if first.raw_os_error() == Some(2) {"
    rust_global "            let made = unsafe { mkdirat(dirfd, encoded.as_ptr(), 0o755) };"
    rust_global "            if made != 0 {"
    rust_global "                let error = std::io::Error::last_os_error();"
    rust_global "                if error.raw_os_error() != Some(17) { return Err(format!(\"mkdirat {}: {error}\", name.to_string_lossy())); }"
    rust_global "            }"
    rust_global "            fd = unsafe { openat(dirfd, encoded.as_ptr(), flags) };"
    rust_global "        }"
    rust_global "    }"
    rust_global "    if fd < 0 { return Err(format!(\"openat directory {}: {}\", name.to_string_lossy(), std::io::Error::last_os_error())); }"
    rust_global "    Ok(unsafe { std::fs::File::from_raw_fd(fd) })"
    rust_global "}"
    rust_global ""
    rust_global "#[cfg(target_os = \"linux\")] fn path_components(path: &Path) -> Result<Vec<OsString>, String> {"
    rust_global "    let mut components = Vec::new();"
    rust_global "    for component in path.components() {"
    rust_global "        match component {"
    rust_global "            std::path::Component::RootDir | std::path::Component::CurDir => {},"
    rust_global "            std::path::Component::Normal(value) => components.push(value.to_os_string()),"
    rust_global "            std::path::Component::ParentDir => return Err(format!(\"parent component rejected: {}\", path.display())),"
    rust_global "            std::path::Component::Prefix(_) => return Err(format!(\"platform prefix rejected: {}\", path.display())),"
    rust_global "        }"
    rust_global "    }"
    rust_global "    Ok(components)"
    rust_global "}"
    rust_global ""
    rust_global "#[cfg(target_os = \"linux\")] fn open_directory_path(path: &Path, create: bool) -> Result<std::fs::File, String> {"
    rust_global "    let base = if path.is_absolute() { OsStr::new(\"/\") } else { OsStr::new(\".\") };"
    rust_global "    let mut current = open_directory_at(AT_FDCWD, base, false)?;"
    rust_global "    for component in path_components(path)? { current = open_directory_at(current.as_raw_fd(), component.as_os_str(), create)?; }"
    rust_global "    Ok(current)"
    rust_global "}"
    rust_global ""
    rust_global "#[cfg(target_os = \"linux\")] fn open_parent(path: &Path, create: bool) -> Result<(std::fs::File, OsString), String> {"
    rust_global "    let base = if path.is_absolute() { OsStr::new(\"/\") } else { OsStr::new(\".\") };"
    rust_global "    let mut current = open_directory_at(AT_FDCWD, base, false)?;"
    rust_global "    let mut components = path_components(path)?;"
    rust_global "    let leaf = components.pop().ok_or_else(|| format!(\"path has no leaf: {}\", path.display()))?;"
    rust_global "    for component in components { current = open_directory_at(current.as_raw_fd(), component.as_os_str(), create)?; }"
    rust_global "    Ok((current, leaf))"
    rust_global "}"
    rust_global ""
    rust_global "#[cfg(target_os = \"linux\")] fn open_leaf_optional(parent: &std::fs::File, leaf: &OsStr) -> Result<Option<std::fs::File>, String> {"
    rust_global "    let encoded = c_name(leaf)?;"
    rust_global "    let fd = unsafe { openat(parent.as_raw_fd(), encoded.as_ptr(), O_RDONLY | O_CLOEXEC | O_NOFOLLOW) };"
    rust_global "    if fd < 0 { let error = std::io::Error::last_os_error(); if error.raw_os_error() == Some(2) { return Ok(None); } return Err(format!(\"openat leaf {}: {error}\", leaf.to_string_lossy())); }"
    rust_global "    Ok(Some(unsafe { std::fs::File::from_raw_fd(fd) }))"
    rust_global "}"
    rust_global "#[cfg(target_os = \"linux\")] fn open_leaf(parent: &std::fs::File, leaf: &OsStr) -> Result<std::fs::File, String> {"
    rust_global "    open_leaf_optional(parent, leaf)?.ok_or_else(|| format!(\"leaf is absent: {}\", leaf.to_string_lossy()))"
    rust_global "}"
    rust_global ""
    rust_global "#[cfg(target_os = \"linux\")] fn target_mode(parent: &std::fs::File, leaf: &OsStr) -> Result<Option<u32>, String> {"
    rust_global "    match open_leaf_optional(parent, leaf)? {"
    rust_global "        Some(file) => {"
    rust_global "            let metadata = file.metadata().map_err(|error| format!(\"metadata {}: {error}\", leaf.to_string_lossy()))?;"
    rust_global "            if !metadata.is_file() { return Err(format!(\"regular file required: {}\", leaf.to_string_lossy())); }"
    rust_global "            Ok(Some(metadata.permissions().mode()))"
    rust_global "        }"
    rust_global "        None => Ok(None),"
    rust_global "    }"
    rust_global "}"
    rust_global ""
    rust_global "#[cfg(target_os = \"linux\")] fn create_stage(parent: &std::fs::File, parent_path: &Path, leaf: &OsStr, label: &str, bytes: &[u8], mode: Option<u32>) -> Result<PathBuf, String> {"
    rust_global "    let nonce = std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).map_err(|error| format!(\"clock before unix epoch: {error}\"))?.as_nanos();"
    rust_global "    for attempt in 0u8..32u8 {"
    rust_global "        let candidate = OsString::from(format!(\".{}.{}-{}-{nonce}-{attempt}\", leaf.to_string_lossy(), label, std::process::id()));"
    rust_global "        let encoded = c_name(candidate.as_os_str())?;"
    rust_global "        let fd = unsafe { openat(parent.as_raw_fd(), encoded.as_ptr(), O_WRONLY | O_CREAT | O_EXCL | O_CLOEXEC | O_NOFOLLOW, 0o600u32) };"
    rust_global "        if fd < 0 {"
    rust_global "            let error = std::io::Error::last_os_error();"
    rust_global "            if error.raw_os_error() == Some(17) { continue; }"
    rust_global "            return Err(format!(\"create exclusive stage {}: {error}\", candidate.to_string_lossy()));"
    rust_global "        }"
    rust_global "        let mut file = unsafe { std::fs::File::from_raw_fd(fd) };"
    rust_global "        file.write_all(bytes).map_err(|error| format!(\"write stage {}: {error}\", candidate.to_string_lossy()))?;"
    rust_global "        if let Some(mode) = mode { file.set_permissions(std::fs::Permissions::from_mode(mode)).map_err(|error| format!(\"permissions stage {}: {error}\", candidate.to_string_lossy()))?; }"
    rust_global "        file.sync_all().map_err(|error| format!(\"sync stage {}: {error}\", candidate.to_string_lossy()))?;"
    rust_global "        return Ok(parent_path.join(candidate));"
    rust_global "    }"
    rust_global "    Err(format!(\"exclusive stage collision after retries parent={} leaf={}\", parent_path.display(), leaf.to_string_lossy()))"
    rust_global "}"
    rust_global ""
    rust_global "#[cfg(target_os = \"linux\")] fn rename_same_parent(parent: &std::fs::File, temporary: &OsStr, target: &OsStr) -> Result<(), String> {"
    rust_global "    let temporary = c_name(temporary)?;"
    rust_global "    let target = c_name(target)?;"
    rust_global "    let rc = unsafe { renameat(parent.as_raw_fd(), temporary.as_ptr(), parent.as_raw_fd(), target.as_ptr()) };"
    rust_global "    if rc != 0 { return Err(format!(\"renameat commit: {}\", std::io::Error::last_os_error())); }"
    rust_global "    parent.sync_all().map_err(|error| format!(\"sync parent after rename: {error}\"))"
    rust_global "}"
    rust_global ""
    rust_global "#[cfg(target_os = \"linux\")] fn rename_same_parent_noreplace(parent: &std::fs::File, temporary: &OsStr, target: &OsStr) -> Result<(), String> {"
    rust_global "    let temporary = c_name(temporary)?;"
    rust_global "    let target = c_name(target)?;"
    rust_global "    let rc = unsafe { renameat2(parent.as_raw_fd(), temporary.as_ptr(), parent.as_raw_fd(), target.as_ptr(), RENAME_NOREPLACE) };"
    rust_global "    if rc != 0 { return Err(format!(\"renameat2 noreplace commit: {}\", std::io::Error::last_os_error())); }"
    rust_global "    parent.sync_all().map_err(|error| format!(\"sync parent after rename: {error}\"))"
    rust_global "}"
    rust_global ""
    rust_global "#[cfg(target_os = \"linux\")] fn unlink_name(parent: &std::fs::File, leaf: &OsStr, flags: c_int) -> Result<(), String> {"
    rust_global "    let encoded = c_name(leaf)?;"
    rust_global "    let rc = unsafe { unlinkat(parent.as_raw_fd(), encoded.as_ptr(), flags) };"
    rust_global "    if rc != 0 { return Err(format!(\"unlinkat {}: {}\", leaf.to_string_lossy(), std::io::Error::last_os_error())); }"
    rust_global "    parent.sync_all().map_err(|error| format!(\"sync parent after unlink: {error}\"))"
    rust_global "}"
    rust_global "#[cfg(target_os = \"linux\")] fn unlink_name_missing_ok(parent: &std::fs::File, leaf: &OsStr) -> Result<(), String> {"
    rust_global "    let encoded = c_name(leaf)?;"
    rust_global "    let rc = unsafe { unlinkat(parent.as_raw_fd(), encoded.as_ptr(), 0) };"
    rust_global "    if rc != 0 { let error = std::io::Error::last_os_error(); if error.raw_os_error() == Some(2) { return Ok(()); } return Err(format!(\"unlinkat {}: {error}\", leaf.to_string_lossy())); }"
    rust_global "    parent.sync_all().map_err(|error| format!(\"sync parent after unlink: {error}\"))"
    rust_global "}"

inl emit_public_mutation () : () =
    rust_global "pub fn mutation_boundary_capability() -> &'static str {\n    #[cfg(windows)] { return \"windows-locked-ancestor-nofollow\"; }\n    #[cfg(target_os = \"linux\")] { return \"descriptor-relative-mutation-tree\"; }\n    #[cfg(not(any(target_os = \"linux\", windows)))] { \"mutation-fail-closed-no-descriptor-backend\" }\n}\n\n#[cfg(target_os = \"linux\")] pub fn rooted_ensure_directory(path: &Path) -> Result<(), String> {\n    let directory = open_directory_path(path, true)?;\n    directory.sync_all().map_err(|error| format!(\"sync directory {}: {error}\", path.display()))\n}\n#[cfg(not(any(target_os = \"linux\", windows)))] pub fn rooted_ensure_directory(_path: &Path) -> Result<(), String> { Err(\"directory creation requires a descriptor-relative backend\".to_owned()) }\n\n#[cfg(target_os = \"linux\")] pub fn rooted_create_directory_within(root: &Path, path: &Path) -> Result<(), String> {\n    let relative = path.strip_prefix(root).map_err(|_| format!(\"directory escapes root: {}\", path.display()))?;\n    let mut components = path_components(relative)?;\n    let leaf = components.pop().ok_or_else(|| format!(\"directory path has no leaf: {}\", path.display()))?;\n    let mut parent = open_directory_path(root, false)?;\n    for component in components { parent = open_directory_at(parent.as_raw_fd(), component.as_os_str(), false)?; }\n    let encoded = c_name(leaf.as_os_str())?;\n    let rc = unsafe { mkdirat(parent.as_raw_fd(), encoded.as_ptr(), 0o755) };\n    if rc != 0 { return Err(format!(\"mkdirat {}: {}\", path.display(), std::io::Error::last_os_error())); }\n    let created = open_directory_at(parent.as_raw_fd(), leaf.as_os_str(), false)?;\n    created.sync_all().map_err(|error| format!(\"sync created directory {}: {error}\", path.display()))?;\n    parent.sync_all().map_err(|error| format!(\"sync parent after mkdir {}: {error}\", path.display()))\n}\n#[cfg(not(any(target_os = \"linux\", windows)))] pub fn rooted_create_directory_within(_root: &Path, _path: &Path) -> Result<(), String> { Err(\"directory creation requires a descriptor-relative backend\".to_owned()) }\n\n#[cfg(target_os = \"linux\")] pub fn rooted_set_directory_mode_within(root: &Path, path: &Path, mode: u32) -> Result<(), String> {\n    let relative = path.strip_prefix(root).map_err(|_| format!(\"directory mode target escapes root: {}\", path.display()))?;\n    let mut directory = open_directory_path(root, false)?;\n    for component in path_components(relative)? { directory = open_directory_at(directory.as_raw_fd(), component.as_os_str(), false)?; }\n    directory.set_permissions(std::fs::Permissions::from_mode(mode & 0o777)).map_err(|error| format!(\"directory mode {}: {error}\", path.display()))?;\n    directory.sync_all().map_err(|error| format!(\"sync directory mode {}: {error}\", path.display()))\n}\n#[cfg(not(any(target_os = \"linux\", windows)))] pub fn rooted_set_directory_mode_within(_root: &Path, _path: &Path, _mode: u32) -> Result<(), String> { Err(\"directory mode mutation requires a descriptor-relative backend\".to_owned()) }\n\n#[cfg(target_os = \"linux\")] pub fn rooted_promote_directory_within(root: &Path, temporary: &Path, target: &Path) -> Result<(), String> {\n    if temporary.parent() != target.parent() { return Err(\"directory promotion requires a shared parent\".to_owned()); }\n    let _ = temporary.strip_prefix(root).map_err(|_| format!(\"temporary directory escapes root: {}\", temporary.display()))?;\n    let _ = target.strip_prefix(root).map_err(|_| format!(\"target directory escapes root: {}\", target.display()))?;\n    let parent_path = target.parent().ok_or_else(|| format!(\"target has no parent: {}\", target.display()))?;\n    let relative_parent = parent_path.strip_prefix(root).map_err(|_| format!(\"promotion parent escapes root: {}\", parent_path.display()))?;\n    let mut parent = open_directory_path(root, false)?;\n    for component in path_components(relative_parent)? { parent = open_directory_at(parent.as_raw_fd(), component.as_os_str(), false)?; }\n    let temporary_leaf = temporary.file_name().ok_or_else(|| \"temporary path has no leaf\".to_owned())?;\n    let target_leaf = target.file_name().ok_or_else(|| \"target path has no leaf\".to_owned())?;\n    let staged = open_directory_at(parent.as_raw_fd(), temporary_leaf, false)?;\n    drop(staged);\n    rename_same_parent_noreplace(&parent, temporary_leaf, target_leaf)\n}\n#[cfg(not(any(target_os = \"linux\", windows)))] pub fn rooted_promote_directory_within(_root: &Path, _temporary: &Path, _target: &Path) -> Result<(), String> { Err(\"directory promotion requires a descriptor-relative backend\".to_owned()) }\n\n#[cfg(target_os = \"linux\")] pub fn rooted_create_regular_within(root: &Path, path: &Path, mode: u32) -> Result<std::fs::File, String> {\n    let relative = path.strip_prefix(root).map_err(|_| format!(\"regular output escapes root: {}\", path.display()))?;\n    let mut components = path_components(relative)?;\n    let leaf = components.pop().ok_or_else(|| format!(\"regular output has no leaf: {}\", path.display()))?;\n    let mut parent = open_directory_path(root, false)?;\n    for component in components { parent = open_directory_at(parent.as_raw_fd(), component.as_os_str(), false)?; }\n    let encoded = c_name(leaf.as_os_str())?;\n    let fd = unsafe { openat(parent.as_raw_fd(), encoded.as_ptr(), O_WRONLY | O_CREAT | O_EXCL | O_CLOEXEC | O_NOFOLLOW, mode & 0o777) };\n    if fd < 0 { return Err(format!(\"create regular {}: {}\", path.display(), std::io::Error::last_os_error())); }\n    let file = unsafe { std::fs::File::from_raw_fd(fd) };\n    file.set_permissions(std::fs::Permissions::from_mode(mode & 0o777)).map_err(|error| format!(\"permissions {}: {error}\", path.display()))?;\n    parent.sync_all().map_err(|error| format!(\"sync parent after regular create {}: {error}\", path.display()))?;\n    Ok(file)\n}\n#[cfg(not(any(target_os = \"linux\", windows)))] pub fn rooted_create_regular_within(_root: &Path, _path: &Path, _mode: u32) -> Result<std::fs::File, String> { Err(\"regular creation requires a descriptor-relative backend\".to_owned()) }\n\n#[cfg(target_os = \"linux\")] pub fn rooted_create_symlink_within(root: &Path, path: &Path, target: &Path) -> Result<(), String> {\n    let relative = path.strip_prefix(root).map_err(|_| format!(\"symlink output escapes root: {}\", path.display()))?;\n    let mut components = path_components(relative)?;\n    let leaf = components.pop().ok_or_else(|| format!(\"symlink output has no leaf: {}\", path.display()))?;\n    let mut parent = open_directory_path(root, false)?;\n    for component in components { parent = open_directory_at(parent.as_raw_fd(), component.as_os_str(), false)?; }\n    let target = c_name(target.as_os_str())?;\n    let leaf = c_name(leaf.as_os_str())?;\n    let rc = unsafe { symlinkat(target.as_ptr(), parent.as_raw_fd(), leaf.as_ptr()) };\n    if rc != 0 { return Err(format!(\"create symlink {}: {}\", path.display(), std::io::Error::last_os_error())); }\n    parent.sync_all().map_err(|error| format!(\"sync parent after symlink {}: {error}\", path.display()))\n}\n#[cfg(not(any(target_os = \"linux\", windows)))] pub fn rooted_create_symlink_within(_root: &Path, _path: &Path, _target: &Path) -> Result<(), String> { Err(\"symlink creation requires a descriptor-relative backend\".to_owned()) }\n\n#[cfg(target_os = \"linux\")] pub fn rooted_create_hardlink_within(root: &Path, existing: &Path, link: &Path) -> Result<(), String> {\n    let source_relative = existing.strip_prefix(root).map_err(|_| format!(\"hardlink source escapes root: {}\", existing.display()))?;\n    let mut source_components = path_components(source_relative)?;\n    let source_leaf = source_components.pop().ok_or_else(|| format!(\"hardlink source has no leaf: {}\", existing.display()))?;\n    let mut source_parent = open_directory_path(root, false)?;\n    for component in source_components { source_parent = open_directory_at(source_parent.as_raw_fd(), component.as_os_str(), false)?; }\n    let source_file = open_leaf(&source_parent, source_leaf.as_os_str())?;\n    let source_metadata = source_file.metadata().map_err(|error| format!(\"hardlink source metadata {}: {error}\", existing.display()))?;\n    if !source_metadata.is_file() { return Err(format!(\"hardlink source must be regular: {}\", existing.display())); }\n    let link_relative = link.strip_prefix(root).map_err(|_| format!(\"hardlink output escapes root: {}\", link.display()))?;\n    let mut link_components = path_components(link_relative)?;\n    let link_leaf = link_components.pop().ok_or_else(|| format!(\"hardlink output has no leaf: {}\", link.display()))?;\n    let mut link_parent = open_directory_path(root, false)?;\n    for component in link_components { link_parent = open_directory_at(link_parent.as_raw_fd(), component.as_os_str(), false)?; }\n    let source_name = c_name(source_leaf.as_os_str())?;\n    let link_name = c_name(link_leaf.as_os_str())?;\n    let rc = unsafe { linkat(source_parent.as_raw_fd(), source_name.as_ptr(), link_parent.as_raw_fd(), link_name.as_ptr(), 0) };\n    if rc != 0 { return Err(format!(\"create hardlink {} -> {}: {}\", link.display(), existing.display(), std::io::Error::last_os_error())); }\n    let linked = match open_leaf(&link_parent, link_leaf.as_os_str()) { Ok(file) => file, Err(error) => { let _ = unlink_name(&link_parent, link_leaf.as_os_str(), 0); return Err(format!(\"verify hardlink {}: {error}\", link.display())); } };\n    let linked_metadata = linked.metadata().map_err(|error| format!(\"hardlink metadata {}: {error}\", link.display()))?;\n    if !linked_metadata.is_file() || linked_metadata.dev() != source_metadata.dev() || linked_metadata.ino() != source_metadata.ino() { let _ = unlink_name(&link_parent, link_leaf.as_os_str(), 0); return Err(format!(\"hardlink identity mismatch: {} -> {}\", link.display(), existing.display())); }\n    link_parent.sync_all().map_err(|error| format!(\"sync parent after hardlink {}: {error}\", link.display()))\n}\n#[cfg(not(any(target_os = \"linux\", windows)))] pub fn rooted_create_hardlink_within(_root: &Path, _existing: &Path, _link: &Path) -> Result<(), String> { Err(\"hardlink creation requires a descriptor-relative backend\".to_owned()) }\n\n#[cfg(target_os = \"linux\")] pub fn atomic_write(path: &Path, bytes: &[u8]) -> Result<(), String> {\n    let parent_path = path.parent().ok_or_else(|| format!(\"path has no parent: {}\", path.display()))?;\n    let (parent, leaf) = open_parent(path, true)?;\n    let mode = target_mode(&parent, leaf.as_os_str())?;\n    let temporary = create_stage(&parent, parent_path, leaf.as_os_str(), \"eoie-tmp\", bytes, mode)?;\n    let temporary_leaf = temporary.file_name().ok_or_else(|| \"temporary path has no leaf\".to_owned())?;\n    if let Err(error) = rename_same_parent(&parent, temporary_leaf, leaf.as_os_str()) { let _ = unlink_name(&parent, temporary_leaf, 0); return Err(error); }\n    Ok(())\n}\n#[cfg(not(any(target_os = \"linux\", windows)))] pub fn atomic_write(_path: &Path, _bytes: &[u8]) -> Result<(), String> { Err(\"atomic mutation requires a descriptor-relative backend\".to_owned()) }\n\n#[cfg(target_os = \"linux\")] pub fn copy_regular_atomic_preserve(source: &Path, target: &Path) -> Result<u64, String> {\n    let (source_parent, source_leaf) = open_parent(source, false)?;\n    let mut source_file = open_leaf(&source_parent, source_leaf.as_os_str())?;\n    let metadata = source_file.metadata().map_err(|error| format!(\"metadata {}: {error}\", source.display()))?;\n    if !metadata.is_file() { return Err(format!(\"regular source required: {}\", source.display())); }\n    let parent_path = target.parent().ok_or_else(|| format!(\"target has no parent: {}\", target.display()))?;\n    let (target_parent, target_leaf) = open_parent(target, true)?;\n    let _ = target_mode(&target_parent, target_leaf.as_os_str())?;\n    let nonce = std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).map_err(|error| format!(\"clock before unix epoch: {error}\"))?.as_nanos();\n    for attempt in 0u8..32u8 {\n        let candidate = OsString::from(format!(\".{}.eoie-copy-{}-{nonce}-{attempt}\", target_leaf.to_string_lossy(), std::process::id()));\n        let encoded = c_name(candidate.as_os_str())?;\n        let fd = unsafe { openat(target_parent.as_raw_fd(), encoded.as_ptr(), O_WRONLY | O_CREAT | O_EXCL | O_CLOEXEC | O_NOFOLLOW, 0o600u32) };\n        if fd < 0 { let error = std::io::Error::last_os_error(); if error.raw_os_error() == Some(17) { continue; } return Err(format!(\"create copy stage {}: {error}\", candidate.to_string_lossy())); }\n        let mut staged = unsafe { std::fs::File::from_raw_fd(fd) };\n        let bytes = std::io::copy(&mut source_file, &mut staged).map_err(|error| format!(\"copy {}: {error}\", source.display()))?;\n        staged.set_permissions(std::fs::Permissions::from_mode(metadata.permissions().mode())).map_err(|error| format!(\"permissions copy stage: {error}\"))?;\n        staged.sync_all().map_err(|error| format!(\"sync copy stage: {error}\"))?;\n        drop(staged);\n        if let Err(error) = rename_same_parent(&target_parent, candidate.as_os_str(), target_leaf.as_os_str()) { let _ = unlink_name(&target_parent, candidate.as_os_str(), 0); return Err(error); }\n        return Ok(bytes);\n    }\n    Err(format!(\"copy stage collision after retries parent={} leaf={}\", parent_path.display(), target_leaf.to_string_lossy()))\n}\n#[cfg(not(any(target_os = \"linux\", windows)))] pub fn copy_regular_atomic_preserve(_source: &Path, _target: &Path) -> Result<u64, String> { Err(\"atomic copy requires a descriptor-relative backend\".to_owned()) }\n\n#[cfg(target_os = \"linux\")] pub fn stage_text_receipted_bound(target: &Path, text: &str, stage_index: i32, backup_slot: i32) -> Result<StagedWriteReceipt, String> {\n    if stage_index < 0 || backup_slot < 0 { return Err(\"stage identity must be non-negative\".to_owned()); }\n    let parent_path = target.parent().ok_or_else(|| format!(\"target has no parent: {}\", target.display()))?;\n    let (parent, leaf) = open_parent(target, false)?;\n    let mode = target_mode(&parent, leaf.as_os_str())?.ok_or_else(|| format!(\"replace target is absent: {}\", target.display()))?;\n    let temporary = create_stage(&parent, parent_path, leaf.as_os_str(), \"eoie-patch\", text.as_bytes(), Some(mode))?;\n    Ok(StagedWriteReceipt { target: target.to_path_buf(), temporary, bytes_written: text.len(), stage_index, backup_slot })\n}\n#[cfg(not(any(target_os = \"linux\", windows)))] pub fn stage_text_receipted_bound(_target: &Path, _text: &str, _stage_index: i32, _backup_slot: i32) -> Result<StagedWriteReceipt, String> { Err(\"staged mutation requires a descriptor-relative backend\".to_owned()) }\n\npub fn stage_text_receipted(target: &Path, text: &str) -> Result<StagedWriteReceipt, String> { stage_text_receipted_bound(target, text, 0, 0) }\npub fn stage_text(target: &Path, text: &str) -> Result<PathBuf, String> { stage_text_receipted(target, text).map(StagedWriteReceipt::into_temporary) }\n\n#[cfg(target_os = \"linux\")] pub fn stage_new_text(target: &Path, text: &str) -> Result<PathBuf, String> {\n    let parent_path = target.parent().ok_or_else(|| format!(\"target has no parent: {}\", target.display()))?;\n    let (parent, leaf) = open_parent(target, true)?;\n    if target_mode(&parent, leaf.as_os_str())?.is_some() { return Err(format!(\"new target already exists: {}\", target.display())); }\n    create_stage(&parent, parent_path, leaf.as_os_str(), \"eoie-create\", text.as_bytes(), None)\n}\n#[cfg(not(any(target_os = \"linux\", windows)))] pub fn stage_new_text(_target: &Path, _text: &str) -> Result<PathBuf, String> { Err(\"staged mutation requires a descriptor-relative backend\".to_owned()) }\n\n#[cfg(target_os = \"linux\")] pub fn promote_stage(temporary: &Path, target: &Path) -> Result<(), String> {\n    if temporary.parent() != target.parent() { return Err(\"staged promotion requires a shared parent\".to_owned()); }\n    let (parent, target_leaf) = open_parent(target, false)?;\n    let temporary_leaf = temporary.file_name().ok_or_else(|| \"temporary path has no leaf\".to_owned())?;\n    let staged = open_leaf(&parent, temporary_leaf)?;\n    if !staged.metadata().map_err(|error| format!(\"metadata stage: {error}\"))?.is_file() { return Err(\"stage must be a regular file\".to_owned()); }\n    rename_same_parent(&parent, temporary_leaf, target_leaf.as_os_str())\n}\n#[cfg(not(any(target_os = \"linux\", windows)))] pub fn promote_stage(_temporary: &Path, _target: &Path) -> Result<(), String> { Err(\"staged mutation requires a descriptor-relative backend\".to_owned()) }\n\npub fn promote_stage_receipted(receipt: &StagedWriteReceipt) -> Result<PromotionReceipt, String> {\n    promote_stage(receipt.temporary(), receipt.target())?;\n    Ok(PromotionReceipt { target: receipt.target.clone(), temporary: receipt.temporary.clone(), stage_index: receipt.stage_index, backup_slot: receipt.backup_slot })\n}\n\n#[cfg(target_os = \"linux\")] pub fn discard_stage(temporary: &Path) -> Result<(), String> {\n    let (parent, leaf) = open_parent(temporary, false)?;\n    unlink_name_missing_ok(&parent, leaf.as_os_str())\n}\n#[cfg(not(any(target_os = \"linux\", windows)))] pub fn discard_stage(_temporary: &Path) -> Result<(), String> { Err(\"staged mutation requires a descriptor-relative backend\".to_owned()) }\n\npub fn restore_text(target: &Path, original: &str) -> Result<(), String> {\n    let temporary = stage_text(target, original)?;\n    if let Err(error) = promote_stage(&temporary, target) { let _ = discard_stage(&temporary); return Err(error); }\n    Ok(())\n}\n\n#[cfg(target_os = \"linux\")] pub fn rooted_remove_regular(path: &Path) -> Result<(), String> {\n    let (parent, leaf) = open_parent(path, false)?;\n    let file = open_leaf(&parent, leaf.as_os_str())?;\n    if !file.metadata().map_err(|error| format!(\"metadata {}: {error}\", path.display()))?.is_file() { return Err(format!(\"regular file required: {}\", path.display())); }\n    unlink_name(&parent, leaf.as_os_str(), 0)\n}\n#[cfg(not(any(target_os = \"linux\", windows)))] pub fn rooted_remove_regular(_path: &Path) -> Result<(), String> { Err(\"regular removal requires a descriptor-relative backend\".to_owned()) }\n#[cfg(target_os = \"linux\")] pub fn rooted_unlink_nondirectory(path: &Path) -> Result<(), String> {\n    let (parent, leaf) = open_parent(path, false)?;\n    unlink_name(&parent, leaf.as_os_str(), 0)\n}\n#[cfg(not(any(target_os = \"linux\", windows)))] pub fn rooted_unlink_nondirectory(_path: &Path) -> Result<(), String> { Err(\"nofollow unlink requires a descriptor-relative backend\".to_owned()) }"

inl emit_tree_removal () : () =
    rust_global "#[cfg(target_os = \"linux\")] fn remove_directory_contents(directory: &std::fs::File) -> Result<u64, String> {\n    let descriptor_path = PathBuf::from(format!(\"/proc/self/fd/{}\", directory.as_raw_fd()));\n    let mut count = 0u64;\n    for entry in std::fs::read_dir(&descriptor_path).map_err(|error| format!(\"read descriptor directory {}: {error}\", descriptor_path.display()))? {\n        let name = entry.map_err(|error| format!(\"read descriptor entry: {error}\"))?.file_name();\n        match open_directory_at(directory.as_raw_fd(), name.as_os_str(), false) {\n            Ok(child) => {\n                count = count.checked_add(remove_directory_contents(&child)?).ok_or_else(|| \"tree count overflow\".to_owned())?;\n                unlink_name(directory, name.as_os_str(), AT_REMOVEDIR)?;\n                count = count.checked_add(1).ok_or_else(|| \"tree count overflow\".to_owned())?;\n            }\n            Err(open_error) => {\n                if let Err(unlink_error) = unlink_name(directory, name.as_os_str(), 0) { return Err(format!(\"remove tree leaf {}: open={open_error}; unlink={unlink_error}\", name.to_string_lossy())); }\n                count = count.checked_add(1).ok_or_else(|| \"tree count overflow\".to_owned())?;\n            }\n        }\n    }\n    Ok(count)\n}\n\n#[cfg(target_os = \"linux\")] pub fn rooted_remove_tree_within(root: &Path, path: &Path) -> Result<u64, String> {\n    let relative = path.strip_prefix(root).map_err(|_| format!(\"directory escapes root: {}\", path.display()))?;\n    let mut components = path_components(relative)?;\n    let leaf = components.pop().ok_or_else(|| format!(\"refusing to remove root itself: {}\", root.display()))?;\n    let mut parent = open_directory_path(root, false)?;\n    for component in components { parent = open_directory_at(parent.as_raw_fd(), component.as_os_str(), false)?; }\n    let directory = open_directory_at(parent.as_raw_fd(), leaf.as_os_str(), false)?;\n    let descendants = remove_directory_contents(&directory)?;\n    unlink_name(&parent, leaf.as_os_str(), AT_REMOVEDIR)?;\n    descendants.checked_add(1).ok_or_else(|| \"tree count overflow\".to_owned())\n}\n#[cfg(not(any(target_os = \"linux\", windows)))] pub fn rooted_remove_tree_within(_root: &Path, _path: &Path) -> Result<u64, String> { Err(\"tree removal requires a descriptor-relative backend\".to_owned()) }"

inl emit_tests () : () =
    rust_global "#[cfg(all(test, target_os = \"linux\"))] mod descriptor_mutation_tests {\n    use super::*;\n    use std::os::unix::fs::symlink;\n    fn fixture(name: &str) -> PathBuf {\n        let nonce = std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).unwrap().as_nanos();\n        std::env::temp_dir().join(format!(\"eoie-mutation-{name}-{}-{nonce}\", std::process::id()))\n    }\n    #[test] fn atomic_write_rejects_symlink_ancestor() {\n        let root = fixture(\"atomic\"); let inside = root.join(\"inside\"); let outside = root.join(\"outside\");\n        std::fs::create_dir_all(&inside).unwrap(); std::fs::create_dir_all(&outside).unwrap(); symlink(&outside, inside.join(\"link\")).unwrap();\n        assert_eq!(mutation_boundary_capability(), \"descriptor-relative-mutation-tree\");\n        assert!(atomic_write(&inside.join(\"link/escaped.txt\"), b\"no\").is_err()); assert!(!outside.join(\"escaped.txt\").exists());\n        atomic_write(&inside.join(\"ok.txt\"), b\"ok\").unwrap(); assert_eq!(std::fs::read(inside.join(\"ok.txt\")).unwrap(), b\"ok\");\n        std::fs::remove_dir_all(&root).unwrap();\n    }\n    #[test] fn promotion_fails_closed_after_parent_swap() {\n        let root = fixture(\"promote\"); let parent = root.join(\"parent\"); let outside = root.join(\"outside\");\n        std::fs::create_dir_all(&parent).unwrap(); std::fs::create_dir_all(&outside).unwrap(); let target = parent.join(\"value.txt\"); std::fs::write(&target, b\"old\").unwrap();\n        let temporary = stage_text(&target, \"new\").unwrap(); let moved = root.join(\"moved\"); std::fs::rename(&parent, &moved).unwrap(); symlink(&outside, &parent).unwrap();\n        assert!(promote_stage(&temporary, &target).is_err()); assert!(!outside.join(\"value.txt\").exists()); assert_eq!(std::fs::read(moved.join(\"value.txt\")).unwrap(), b\"old\");\n        std::fs::remove_dir_all(&root).unwrap();\n    }\n    #[test] fn tree_removal_rejects_symlink_target_and_stays_beneath_root() {\n        let root = fixture(\"tree\"); let outside = root.join(\"outside\"); let tree = root.join(\"tree\");\n        std::fs::create_dir_all(tree.join(\"nested\")).unwrap(); std::fs::create_dir_all(&outside).unwrap(); std::fs::write(tree.join(\"nested/file.txt\"), b\"x\").unwrap(); std::fs::write(outside.join(\"keep.txt\"), b\"keep\").unwrap();\n        let link = root.join(\"link\"); symlink(&outside, &link).unwrap(); assert!(rooted_remove_tree_within(&root, &link).is_err()); assert!(outside.join(\"keep.txt\").exists());\n        assert_eq!(rooted_remove_tree_within(&root, &tree).unwrap(), 3); assert!(!tree.exists()); assert!(outside.join(\"keep.txt\").exists());\n        std::fs::remove_dir_all(&root).unwrap();\n    }\n    #[test] fn directory_creation_and_promotion_are_descriptor_relative() {\n        let root = fixture(\"directory\"); let inside = root.join(\"inside\"); let outside = root.join(\"outside\");\n        std::fs::create_dir_all(&inside).unwrap(); std::fs::create_dir_all(&outside).unwrap(); symlink(&outside, inside.join(\"link\")).unwrap();\n        assert!(rooted_ensure_directory(&inside.join(\"link/escaped\")).is_err()); assert!(!outside.join(\"escaped\").exists());\n        let stage = inside.join(\"stage\"); let final_dir = inside.join(\"final\"); rooted_create_directory_within(&inside, &stage).unwrap(); rooted_promote_directory_within(&inside, &stage, &final_dir).unwrap(); assert!(final_dir.is_dir());\n        let stage2 = inside.join(\"stage2\"); let occupied = inside.join(\"occupied\"); rooted_create_directory_within(&inside, &stage2).unwrap(); rooted_create_directory_within(&inside, &occupied).unwrap(); assert!(rooted_promote_directory_within(&inside, &stage2, &occupied).is_err()); assert!(stage2.is_dir()); assert!(occupied.is_dir());\n        rooted_set_directory_mode_within(&inside, &final_dir, 0o711).unwrap(); let mode = std::os::unix::fs::PermissionsExt::mode(&std::fs::metadata(&final_dir).unwrap().permissions()) & 0o777; assert_eq!(mode, 0o711);\n        assert!(rooted_set_directory_mode_within(&inside, &inside.join(\"link\"), 0o700).is_err()); assert!(outside.is_dir());\n        std::fs::remove_dir_all(&root).unwrap();\n    }\n    #[test] fn archive_outputs_are_descriptor_relative() {\n        let root = fixture(\"archive-output\"); let inside = root.join(\"inside\"); let outside = root.join(\"outside\");\n        std::fs::create_dir_all(&inside).unwrap(); std::fs::create_dir_all(&outside).unwrap(); symlink(&outside, inside.join(\"link\")).unwrap();\n        assert!(rooted_create_regular_within(&inside, &inside.join(\"link/escaped.txt\"), 0o640).is_err()); assert!(!outside.join(\"escaped.txt\").exists());\n        let regular = inside.join(\"regular.txt\"); let mut file = rooted_create_regular_within(&inside, &regular, 0o640).unwrap(); file.write_all(b\"payload\").unwrap(); file.sync_all().unwrap(); drop(file); assert_eq!(std::fs::read(&regular).unwrap(), b\"payload\");\n        let symbolic = inside.join(\"symbolic.txt\"); rooted_create_symlink_within(&inside, &symbolic, Path::new(\"regular.txt\")).unwrap(); assert_eq!(std::fs::read_link(&symbolic).unwrap(), PathBuf::from(\"regular.txt\"));\n        assert!(rooted_create_symlink_within(&inside, &inside.join(\"link/escaped-symlink\"), Path::new(\"regular.txt\")).is_err()); assert!(!outside.join(\"escaped-symlink\").exists());\n        let hard = inside.join(\"hard.txt\"); rooted_create_hardlink_within(&inside, &regular, &hard).unwrap(); assert_eq!(std::fs::read(&hard).unwrap(), b\"payload\");\n        assert!(rooted_create_hardlink_within(&inside, &symbolic, &inside.join(\"bad-hard.txt\")).is_err()); assert!(!inside.join(\"bad-hard.txt\").exists());\n        std::fs::remove_dir_all(&root).unwrap();\n    }\n}"

inl main () : i32 =
    emit_types ()
    emit_linux_helpers ()
    emit_public_mutation ()
    emit_tree_removal ()
    emit_tests ()
    rust_global "}"
    rust_global "pub use dense::*;"
    $"RustLibrary()" : ()
    0i32
