    $'std::process::Command::new(&*!program).arg(&*!argument0).arg(&*!argument1).arg(&*!argument2).arg(&*!argument3).arg(&*!argument4).status().unwrap().code().unwrap_or(127)' : i32

inl status_code7 (~program : string) (~argument0 : string) (~argument1 : string) (~argument2 : string) (~argument3 : string) (~argument4 : string) (~argument5 : string) (~argument6 : string) : i32 =
    $'std::process::Command::new(&*!program).arg(&*!argument0).arg(&*!argument1).arg(&*!argument2).arg(&*!argument3).arg(&*!argument4).arg(&*!argument5).arg(&*!argument6).status().unwrap().code().unwrap_or(127)' : i32

inl kill_wait_code1 (~program : string) (~argument0 : string) : i32 =
    $'{ let mut child = std::process::Command::new(&*!program).arg(&*!argument0).spawn().unwrap(); let kill_failed = child.kill().is_err(); let wait_failed = child.wait().is_err(); if kill_failed { 1 } else if wait_failed { 2 } else { 0 } }' : i32

inl status_code2 (~program : string) (~argument0 : string) (~argument1 : string) : i32 =
    $'std::process::Command::new(&*!program).arg(&*!argument0).arg(&*!argument1).status().unwrap().code().unwrap_or(127)' : i32

