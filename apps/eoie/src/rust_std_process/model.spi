
inl status_code0 (~program : string) : i32 =
    $'std::process::Command::new(&*!program).status().unwrap().code().unwrap_or(127)' : i32

inl status_code1 (~program : string) (~argument0 : string) : i32 =
    $'std::process::Command::new(&*!program).arg(&*!argument0).status().unwrap().code().unwrap_or(127)' : i32

