
inl concat5 (~a : string) (~b : string) (~c : string) (~d : string) (~e : string) : string =
    $'std::rc::Rc::<str>::from([&*!a, &*!b, &*!c, &*!d, &*!e].concat())' : string

inl equals (a : string) (b : string) : bool =
    $'!a == !b '

inl pipe_member (~members : string) (~value : string) : bool =
    $'!members.split("|").any(|item| item == &*!value)' : bool

inl pipe_index (~members : string) (~value : string) : u64 =
    $'!members.split("|").position(|item| item == &*!value).map(|index| index as u64).unwrap_or(u64::MAX)' : u64

inl pipe_lookup (~members : string) (~values : string) (~value : string) : string =
    $'!members.split("|").zip(!values.split(char::from(10u8))).find_map(|(key,item)| if key == &*!value { Some(std::rc::Rc::<str>::from(item)) } else { None }).unwrap_or_else(|| std::rc::Rc::<str>::from(""))' : string


inl starts_with (text : string) (prefix : string) : bool =
    $'!text.starts_with(&*!prefix)' : bool

inl ends_with (text : string) (suffix : string) : bool =
    $'!text.ends_with(&*!suffix)' : bool

inl contains (text : string) (needle : string) : bool =
    $'!text.contains(&*!needle)' : bool

inl replace (text : string) (from : string) (into : string) : string =
    $'std::rc::Rc::<str>::from(!text.replace(&*!from, &!into))' : string

inl trim (text : string) : string =
    $'std::rc::Rc::<str>::from(!text.trim())' : string

inl trim_end_matches (text : string) (suffix : string) : string =
    $'std::rc::Rc::<str>::from(!text.trim_end_matches(&*!suffix))' : string
