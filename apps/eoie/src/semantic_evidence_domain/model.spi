union semantic_closeout_state =
    | SemanticCloseoutCurrent
    | SemanticCloseoutBlocked

let semantic_closeout_verdict_binding (gate_mask : i32) (flags : i32) : i32 =
    if !!!!LT(gate_mask,63i32) then 0i32
    elif !!!!LT(63i32,gate_mask) then 0i32
    elif !!!!LT(flags,7i32) then 0i32
    elif !!!!LT(7i32,flags) then 0i32
    else 1i32
