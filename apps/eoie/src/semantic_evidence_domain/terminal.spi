inl rust_global (x : string) : () = real typecase `(!!!!LitToTypeLit(x)) with ~x => $"RustGlobal(@x)" : ()

inl emit_runtime () : () = rust_global "use std::collections::BTreeSet;\nuse std::path::Path;\n\n#[derive(Clone,Debug)]\npub struct SemanticCloseoutStatus { pub gate_mask:i32, pub gate_count:usize, pub verified_count:usize, pub registry_sha256:String }\n\nfn closeout_quoted_fields(line:&str)->Vec<String>{line.split('\"').skip(1).step_by(2).map(str::to_owned).collect()}\nfn closeout_expected_migration(source:&str)->Result<i32,String>{for line in source.lines(){if line.contains(\"inl expected_migration ()\"){let value=line.split('=').nth(1).ok_or_else(||\"closeout expected migration is malformed\".to_owned())?.trim().trim_end_matches(\"u32\");return value.parse::<i32>().map_err(|_|format!(\"invalid closeout migration: {value}\"));}}Err(\"closeout expected migration is missing\".to_owned())}\nfn closeout_schema_v2(source:&str)->bool{source.lines().any(|line|line.contains(\"inl closeout_registry_schema () : u32 = 2u32\"))&&source.lines().any(|line|line.contains(\"inl registry_v2_status () : string = \\\"semantic-dereferenced\\\"\"))}\nfn closeout_sealed(source:&str)->bool{source.lines().any(|line|line.contains(\"inl closeout_sealed () : bool = true\"))}\n\npub fn observed_migration_from_state(root:&Path)->Result<i32,String>{let migration_path=root.join(eoie_rust_std_fs::safe_relative_path(\"state/migration.spi\")?);let source=eoie_rust_std_fs::read_regular_text_limited(&migration_path,2*1024*1024)?;let line=source.lines().find(|line|line.contains(\"MigrationDenominator (\")).ok_or_else(||\"migration denominator is missing\".to_owned())?;let body=line.split(\"MigrationDenominator (\").nth(1).ok_or_else(||\"migration denominator is malformed\".to_owned())?;let mut values=body.split(',').map(str::trim);let _settled=values.next();let _total=values.next();let _open=values.next();let score=values.next().ok_or_else(||\"migration score is missing\".to_owned())?.trim_end_matches(\"u32\");score.parse::<i32>().map_err(|_|format!(\"migration score is malformed: {score}\"))}\n\npub fn verify_closeout_registry(root:&Path,observed_migration:i32)->Result<SemanticCloseoutStatus,String>{let root_meta=std::fs::symlink_metadata(root).map_err(|e|format!(\"closeout root metadata {}: {e}\",root.display()))?;if root_meta.file_type().is_symlink()||!root_meta.is_dir(){return Err(format!(\"closeout root must be a real directory: {}\",root.display()))}let registry_rel=\"state/release_closeout.spi\";let registry_path=root.join(eoie_rust_std_fs::safe_relative_path(registry_rel)?);let source=eoie_rust_std_fs::read_regular_text_limited(&registry_path,64*1024)?;let expected_migration=closeout_expected_migration(&source)?;let migration_match=i32::from(expected_migration==observed_migration);let mut mask=0i32;let mut names=BTreeSet::new();let mut paths=BTreeSet::new();let mut verified=0usize;let gates=[(\"state\",1i32),(\"workspace\",2i32),(\"contracts\",4i32),(\"bundle\",8i32),(\"cold\",16i32),(\"migration\",32i32)];for (name,bit) in gates{let needle=format!(\"inl {name}_gate ()\");let line=source.lines().find(|line|line.contains(&needle)).ok_or_else(||format!(\"closeout gate missing: {name}\"))?;let fields=closeout_quoted_fields(line);if fields.len()!=2{return Err(format!(\"closeout gate malformed: {name}\"))}let relative=&fields[0];let expected_hash=&fields[1];if expected_hash.len()!=64||!expected_hash.bytes().all(|b|b.is_ascii_hexdigit()){return Err(format!(\"closeout gate hash malformed: {name}\"))}\nif !names.insert(name.to_owned())||!paths.insert(relative.clone()){return Err(format!(\"closeout duplicate gate name/path: {name} {relative}\"))}let relative_path=eoie_rust_std_fs::safe_relative_path(relative)?;let path=root.join(relative_path);let _=eoie_rust_std_fs::read_regular_limited(&path,8*1024*1024)?;let observed=eoie_proxy_search::inspection_file_sha256(&path)?;if observed!=*expected_hash{return Err(format!(\"closeout gate stale name={name} path={relative} expected={expected_hash} observed={observed}\"))}mask|=bit;verified+=1;}let flags=i32::from(closeout_sealed(&source))+2*migration_match+4*i32::from(closeout_schema_v2(&source));if eoie_semantic_closeout_verdict(mask,flags)!=1{return Err(format!(\"semantic closeout rejected gate_mask={mask} flags={flags} expected_migration={expected_migration} observed_migration={observed_migration}\"))}let registry_sha256=eoie_proxy_search::inspection_file_sha256(&registry_path)?;Ok(SemanticCloseoutStatus{gate_mask:mask,gate_count:names.len(),verified_count:verified,registry_sha256})}\n"
