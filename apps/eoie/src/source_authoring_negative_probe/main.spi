open source_authoring_contract.bindings

inl main () : i32 =
    match source_authoring_shape_binding 0i32 1i32 with
    | 0 =>
        match source_authoring_template_binding 0i32 1i32 with
        | 0 =>
            match source_authoring_render_binding 1i32 1i32 with
            | 0 =>
                match source_authoring_freshness_binding 1i32 0i32 with
                | 0 =>
                    match source_authoring_mode_binding 0i32 1i32 with
                    | 0 =>
                        match source_authoring_commit_binding 1i32 0i32 with
                        | 0 => 0i32
                        | _ => 6i32
                    | _ => 5i32
                | _ => 4i32
            | _ => 3i32
        | _ => 2i32
    | _ => 1i32
