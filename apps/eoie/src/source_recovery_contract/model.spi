nominal source_recovery_raw = ()
nominal source_recovery_classified = ()
nominal source_recovery_indexed = ()
nominal source_recovery_compared = ()
nominal source_recovery_reported = ()

union source_recovery_provenance =
    | Authored
    | Generated
    | CompilerSidecar

union source_recovery_op from to =
    | ClassifySource :: source_recovery_op source_recovery_raw source_recovery_classified
    | IndexSource :: source_recovery_op source_recovery_classified source_recovery_indexed
    | CompareSource :: source_recovery_op source_recovery_indexed source_recovery_compared
    | ReportSource :: source_recovery_op source_recovery_compared source_recovery_reported

union rec source_recovery_plan from to =
    | SourceRecoveryStep :: forall from to. source_recovery_op from to -> source_recovery_plan from to
    | SourceRecoveryThen :: forall from to. (exists middle. source_recovery_plan from middle * source_recovery_plan middle to) -> source_recovery_plan from to

let source_recovery_provenance_binding (sidecar : i32) (generated : i32) : i32 =
    if !!!!LT(sidecar,0i32) then 0i32
    elif !!!!LT(1i32,sidecar) then 0i32
    elif !!!!LT(generated,0i32) then 0i32
    elif !!!!LT(1i32,generated) then 0i32
    elif !!!!EQ(sidecar,1i32) then
        if !!!!EQ(generated,1i32) then 0i32 else 3i32
    elif !!!!EQ(generated,1i32) then 2i32
    else 1i32

let source_recovery_warning_binding (missing_large : i32) (authored : i32) : i32 =
    if !!!!LT(missing_large,0i32) then 0i32
    elif !!!!LT(authored,0i32) then 0i32
    elif !!!!LT(authored,missing_large) then 0i32
    else 1i32

inl source_recovery_public_plan () : source_recovery_plan source_recovery_raw source_recovery_reported =
    SourceRecoveryThen (exists (
        SourceRecoveryStep ClassifySource,
        SourceRecoveryThen (exists (
            SourceRecoveryStep IndexSource,
            SourceRecoveryThen (exists (
                SourceRecoveryStep CompareSource,
                SourceRecoveryStep ReportSource
            ))
        ))
    ))
