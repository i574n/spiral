union receipt_attestation_kind =
    | UnknownReceiptAttestation
    | RuntimeReceiptAttestation
    | BuildReceiptAttestation

inl receipt_attestation_kind_code_value = function
    | UnknownReceiptAttestation => 0u64
    | RuntimeReceiptAttestation => 1u64
    | BuildReceiptAttestation => 2u64

let receipt_attestation_kind_code (attestation : string) : u64 =
    if (=.) attestation "runtime" then receipt_attestation_kind_code_value RuntimeReceiptAttestation
    elif starts_with attestation "build:" then receipt_attestation_kind_code_value BuildReceiptAttestation
    else receipt_attestation_kind_code_value UnknownReceiptAttestation

let receipt_attestation_build_payload (attestation : string) : string =
    if (=.) (receipt_attestation_kind_code attestation) 2u64 then
        slice_exclusive attestation (sm.length "build:" : i32) (sm.length attestation : i32)
    else codec_empty ()

let receipt_attestation_text (build_fingerprint : string) : string =
    if (=.) build_fingerprint "" then "runtime"
    else sm.concat "build:" build_fingerprint