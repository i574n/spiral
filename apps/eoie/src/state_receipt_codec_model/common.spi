nominal parser_search = ()
nominal parser_quoted = ()
nominal parser_fields = ()
nominal serializer_rows = ()
nominal serializer_complete = ()

union codec_phase =
    | ParserSearch
    | ParserQuoted
    | ParserFields
    | SerializerRows
    | SerializerComplete

let codec_empty () : string = join ""

inl slice_exclusive (text : string) (from : i32) (near_to : i32) : string =
    if (=.) from near_to then codec_empty ()
    else sm.slice text {from; to=(-.) near_to 1i32}

inl char_text (text : string) (index : i32) : string =
    sm.slice text {from=index; to=index}

let codec_runtime_char (value : string) : char = sm.index value 0i32
inl char_backslash () : char = codec_runtime_char "\\"
inl char_quote () : char = codec_runtime_char "\""
inl char_newline () : char = codec_runtime_char "\n"
inl char_carriage_return () : char = codec_runtime_char "\r"
inl char_tab () : char = codec_runtime_char "\t"

let rec starts_with_loop (text : string) (pattern : string) (text_at : i32) (pattern_at : i32) (pattern_len : i32) : bool =
    if (=.) pattern_at pattern_len then true
    elif (=.) (sm.index text text_at) (sm.index pattern pattern_at) then
        starts_with_loop text pattern ((+.) text_at 1i32) ((+.) pattern_at 1i32) pattern_len
    else false

inl starts_with_at (text : string) (at : i32) (pattern : string) : bool =
    inl text_len = sm.length text : i32
    inl pattern_len = sm.length pattern : i32
    if (<) text_len ((+.) at pattern_len) then false
    else starts_with_loop text pattern at 0i32 pattern_len

inl starts_with (text : string) (pattern : string) : bool =
    inl text_len = sm.length text : i32
    inl pattern_len = sm.length pattern : i32
    if (<) text_len pattern_len then false
    else starts_with_loop text pattern 0i32 0i32 pattern_len

let rec find_text_loop (text : string) (pattern : string) (at : i32) (text_len : i32) (pattern_len : i32) : i32 =
    if (<) text_len ((+.) at pattern_len) then text_len
    elif starts_with_at text at pattern then at
    else find_text_loop text pattern ((+.) at 1i32) text_len pattern_len

inl find_text (text : string) (at : i32) (pattern : string) : i32 =
    find_text_loop text pattern at (sm.length text : i32) (sm.length pattern : i32)

let rec find_char_loop (text : string) (at : i32) (text_len : i32) (target : char) : i32 =
    if (=.) at text_len then text_len
    elif (=.) (sm.index text at) target then at
    else find_char_loop text ((+.) at 1i32) text_len target

inl find_char (text : string) (at : i32) (target : char) : i32 =
    find_char_loop text at (sm.length text : i32) target

let rec skip_spaces_loop (text : string) (at : i32) (text_len : i32) : i32 =
    if (=.) at text_len then text_len
    else
        inl current = sm.index text at
        if (=.) current ' ' then skip_spaces_loop text ((+.) at 1i32) text_len
        elif (=.) current (char_tab ()) then skip_spaces_loop text ((+.) at 1i32) text_len
        else at

inl skip_spaces (text : string) (at : i32) : i32 =
    skip_spaces_loop text at (sm.length text : i32)

let rec parse_quoted_loop (text : string) (at : i32) (text_len : i32) (out : string) (escaped : bool) : string * i32 * bool =
    if (=.) at text_len then out, at, false
    else
        inl current = sm.index text at
        if escaped then
            inl decoded =
                if (=.) current 'n' then "\n"
                elif (=.) current 'r' then "\r"
                elif (=.) current 't' then "\t"
                elif (=.) current (char_backslash ()) then "\\"
                elif (=.) current (char_quote ()) then "\""
                else codec_empty ()
            if (=.) decoded "" then out, at, false
            else parse_quoted_loop text ((+.) at 1i32) text_len (sm.concat out decoded) false
        elif (=.) current (char_backslash ()) then
            parse_quoted_loop text ((+.) at 1i32) text_len out true
        elif (=.) current (char_quote ()) then
            out, ((+.) at 1i32), true
        else
            parse_quoted_loop text ((+.) at 1i32) text_len (sm.concat out (char_text text at)) false

inl parse_quoted (text : string) (at : i32) : string * i32 * bool =
    inl text_len = sm.length text : i32
    if (=.) at text_len then codec_empty (), at, false
    elif (=.) (sm.index text at) (char_quote ()) then parse_quoted_loop text ((+.) at 1i32) text_len "" false
    else codec_empty (), at, false

inl codec_decimal_digit_value (value : char) : u64 =
    if (=.) value '0' then 0u64
    elif (=.) value '1' then 1u64
    elif (=.) value '2' then 2u64
    elif (=.) value '3' then 3u64
    elif (=.) value '4' then 4u64
    elif (=.) value '5' then 5u64
    elif (=.) value '6' then 6u64
    elif (=.) value '7' then 7u64
    elif (=.) value '8' then 8u64
    elif (=.) value '9' then 9u64
    else 10u64

let rec codec_u64_decimal_value_loop (text : string) (at : i32) (text_len : i32) (acc : u64) : u64 =
    if (=.) at text_len then acc
    else
        inl digit = codec_decimal_digit_value (sm.index text at)
        codec_u64_decimal_value_loop text ((+.) at 1i32) text_len ((+.) ((*.) acc 10u64) digit)

let rec codec_u64_decimal_valid_loop (text : string) (at : i32) (text_len : i32) (acc : u64) : bool =
    if (=.) at text_len then true
    else
        inl digit = codec_decimal_digit_value (sm.index text at)
        if (=.) digit 10u64 then false
        elif (>) acc 1844674407370955161u64 then false
        elif (=.) acc 1844674407370955161u64 then
            if (>) digit 5u64 then false
            else codec_u64_decimal_valid_loop text ((+.) at 1i32) text_len ((+.) ((*.) acc 10u64) digit)
        else codec_u64_decimal_valid_loop text ((+.) at 1i32) text_len ((+.) ((*.) acc 10u64) digit)

let codec_u64_decimal_normalize (text : string) : string =
    inl text_len = sm.length text : i32
    if (=.) text_len 0i32 then codec_empty ()
    elif codec_u64_decimal_valid_loop text 0i32 text_len 0u64 then text
    else codec_empty ()

let codec_u64_decimal_value (text : string) : u64 =
    inl normalized = codec_u64_decimal_normalize text
    inl text_len = sm.length normalized : i32
    if (=.) text_len 0i32 then 0u64
    else codec_u64_decimal_value_loop normalized 0i32 text_len 0u64

let rec state_receipt_dash_count_loop (input : string) (at : i32) (input_len : i32) (count : u64) : u64 =
    if (=.) at input_len then count
    else
        inl count = if (=.) (sm.index input at) '-' then (+.) count 1u64 else count
        state_receipt_dash_count_loop input ((+.) at 1i32) input_len count

let state_receipt_dash_shape (input : string) : u64 =
    inl separators = state_receipt_dash_count_loop input 0i32 (sm.length input : i32) 0u64
    (+.) ((*.) ((+.) separators 1u64) 10u64) separators

let rec state_receipt_find_last_char_loop (text : string) (at : i32) (near_to : i32) (target : char) (last : i32) : i32 =
    if (=.) at near_to then last
    else
        inl last = if (=.) (sm.index text at) target then at else last
        state_receipt_find_last_char_loop text ((+.) at 1i32) near_to target last

let rec state_receipt_trim_right_loop (text : string) (near_to : i32) : i32 =
    if (=.) near_to 0i32 then 0i32
    else
        inl before = (-.) near_to 1i32
        inl current = sm.index text before
        if (=.) current ' ' then state_receipt_trim_right_loop text before
        elif (=.) current (char_tab ()) then state_receipt_trim_right_loop text before
        else near_to

let state_receipt_trim (text : string) : string =
    inl from = skip_spaces text 0i32
    inl near_to = state_receipt_trim_right_loop text (sm.length text : i32)
    if (<) near_to from then codec_empty () else slice_exclusive text from near_to

let state_receipt_constructor_payload_from (source : string) (marker : string) (search_from : i32) : string * i32 * i32 =
    inl source_len = sm.length source : i32
    inl marker_at = find_text source search_from marker
    if (=.) marker_at source_len then codec_empty (), source_len, 0i32
    else
        inl payload_from = (+.) marker_at (sm.length marker : i32)
        inl line_end = find_char source payload_from (char_newline ())
        inl next_at = if (<) line_end source_len then (+.) line_end 1i32 else source_len
        inl close_at = state_receipt_find_last_char_loop source payload_from line_end ')' -1i32
        if (<) close_at payload_from then codec_empty (), next_at, 2i32
        else slice_exclusive source payload_from close_at, next_at, 1i32

let state_receipt_constructor_payload (source : string) (marker : string) : string =
    inl source_len = sm.length source : i32
    inl marker_at = find_text source 0i32 marker
    if (=.) marker_at source_len then codec_empty ()
    else
        inl payload_from = (+.) marker_at (sm.length marker : i32)
        inl line_end = find_char source payload_from (char_newline ())
        inl close_at = state_receipt_find_last_char_loop source payload_from line_end ')' -1i32
        if (<) close_at payload_from then codec_empty ()
        else slice_exclusive source payload_from close_at

let state_receipt_u32_literal_value_checked (input : string) : u64 * bool =
    inl input = state_receipt_trim input
    inl input_len = sm.length input : i32
    if (<) input_len 4i32 then 0u64, false
    else
        inl suffix_from = (-.) input_len 3i32
        if starts_with_at input suffix_from "u32" then
            inl digits = slice_exclusive input 0i32 suffix_from
            inl normalized = codec_u64_decimal_normalize digits
            if (=.) normalized "" then 0u64, false
            else
                inl value = codec_u64_decimal_value normalized
                if (<=) value 4294967295u64 then value, true else 0u64, false
        else 0u64, false

let rec state_receipt_series_records_loop (source : string) (search_from : i32) (previous : u64) (seen : bool) (last_payload : string) : bool * string =
    inl payload, next_at, status = state_receipt_constructor_payload_from source "SeriesRecord (" search_from
    if (=.) status 0i32 then true, last_payload
    elif (=.) status 2i32 then false, codec_empty ()
    else
        inl payload_len = sm.length payload : i32
        inl comma_at = find_char payload 0i32 ','
        if (=.) comma_at payload_len then false, codec_empty ()
        else
            inl sequence_raw, valid = state_receipt_u32_literal_value_checked (slice_exclusive payload 0i32 comma_at)
            inl sequence : u64 = sequence_raw
            if valid then
                if seen && (<=) sequence previous then false, codec_empty ()
                else state_receipt_series_records_loop source next_at sequence true payload
            else false, codec_empty ()

let state_receipt_last_series_record_payload (source : string) : string =
    inl valid, payload = state_receipt_series_records_loop source 0i32 0u64 false (codec_empty ())
    if valid then payload else codec_empty ()

let state_receipt_series_records_valid (source : string) : bool =
    inl source_len = sm.length source : i32
    inl marker_at = find_text source 0i32 "SeriesRecord ("
    if (=.) marker_at source_len then true
    else
        inl payload = state_receipt_last_series_record_payload source
        if (=.) payload "" then false else true

let state_receipt_u64_decimal_valid (input : string) : u64 =
    inl normalized = codec_u64_decimal_normalize input
    if (=.) normalized "" then 0u64 else 1u64

let state_receipt_u64_decimal_value (input : string) : u64 =
    codec_u64_decimal_value input

let state_receipt_u32_decimal_valid (input : string) : u64 =
    inl normalized = codec_u64_decimal_normalize input
    if (=.) normalized "" then 0u64
    else
        inl value = codec_u64_decimal_value normalized
        if (<=) value 4294967295u64 then 1u64 else 0u64

let state_receipt_u32_spi_literal_decimal (input : string) : string =
    inl input_len = sm.length input : i32
    if (>=) input_len 3i32 && starts_with_at input ((-.) input_len 3i32) "u32"
    then slice_exclusive input 0i32 ((-.) input_len 3i32)
    else input

let state_receipt_u32_spi_literal_valid (input : string) : u64 =
    state_receipt_u32_decimal_valid (state_receipt_u32_spi_literal_decimal input)

let state_receipt_u32_spi_literal_value (input : string) : u64 =
    codec_u64_decimal_value (state_receipt_u32_spi_literal_decimal input)

let state_receipt_named_u32_assignment_or_max (source : string) (name : string) : u64 =
    inl source_len = sm.length source : i32
    inl marker_at = find_text source 0i32 name
    if (=.) marker_at source_len then 18446744073709551615u64
    else
        inl equals_at = find_char source ((+.) marker_at (sm.length name : i32)) '='
        if (=.) equals_at source_len then 18446744073709551615u64
        else
            inl value_from = (+.) equals_at 1i32
            inl line_end = find_char source value_from (char_newline ())
            inl raw = state_receipt_trim (slice_exclusive source value_from line_end)
            inl value, valid = state_receipt_u32_literal_value_checked raw
            if valid then value else 18446744073709551615u64

let state_receipt_recovered_topology_count_or_max (source : string) : u64 =
    inl fixture = state_receipt_named_u32_assignment_or_max source "inl recovered_capability_fixture_count"
    if (<) fixture 18446744073709551615u64 then fixture
    else state_receipt_named_u32_assignment_or_max source "inl dogfood_recovered_topology_count"

let state_receipt_migration_denominator_payload (input : string) : string =
    state_receipt_constructor_payload input "MigrationDenominator ("

let state_receipt_series_records_valid_u64 (input : string) : u64 =
    if state_receipt_series_records_valid input then 1u64 else 0u64

let state_receipt_last_series_record_payload_export (input : string) : string =
    state_receipt_last_series_record_payload input

let state_receipt_coverage_checkpoint_kind (input : string) : u64 =
    inl durable = state_receipt_constructor_payload input "CoverageCheckpointDurable ("
    if (=.) durable "" then
        inl missing = state_receipt_constructor_payload input "CoverageCheckpointMissing ("
        if (=.) missing "" then 0u64 else 1u64
    else 2u64

let state_receipt_coverage_checkpoint_sha (input : string) : string =
    inl payload = state_receipt_constructor_payload input "CoverageCheckpointDurable ("
    inl payload_len = sm.length payload : i32
    if (=.) payload_len 0i32 then codec_empty ()
    else
        inl first_quote = find_char payload 0i32 (char_quote ())
        if (=.) first_quote payload_len then codec_empty ()
        else
            inl second_quote = find_char payload ((+.) first_quote 1i32) (char_quote ())
            if (=.) second_quote payload_len then codec_empty ()
            else slice_exclusive payload ((+.) first_quote 1i32) second_quote

let rec state_receipt_recovered_fixture_scan_loop (source : string) (search_from : i32) (seen_capabilities : string) (paths : string) (count : u64) : u64 * string =
    inl source_len = sm.length source : i32
    if (=.) search_from source_len then count, paths
    else
        inl line_end = find_char source search_from (char_newline ())
        inl next_at = if (<) line_end source_len then (+.) line_end 1i32 else source_len
        inl line = state_receipt_trim (slice_exclusive source search_from line_end)
        inl prefix = "// recovered-fixture|"
        inl line_len = sm.length line : i32
        if (>=) line_len 21i32 && (=.) (find_text line 0i32 prefix) 0i32 then
            inl first = find_char line 0i32 '|'
            inl second = find_char line ((+.) first 1i32) '|'
            inl third = find_char line ((+.) second 1i32) '|'
            inl fourth = find_char line ((+.) third 1i32) '|'
            inl fifth = find_char line ((+.) fourth 1i32) '|'
            if (=.) first line_len || (=.) second line_len || (=.) third line_len || (=.) fourth line_len || (<) fifth line_len then
                18446744073709551615u64, codec_empty ()
            else
                inl capability = slice_exclusive line ((+.) first 1i32) second
                inl path1 = slice_exclusive line ((+.) second 1i32) third
                inl path2 = slice_exclusive line ((+.) third 1i32) fourth
                inl path3 = slice_exclusive line ((+.) fourth 1i32) line_len
                if (=.) path1 "" || (=.) path2 "" || (=.) path3 "" then
                    18446744073709551615u64, codec_empty ()
                else
                    inl capability_marker = sm.concat "\n" (sm.concat capability "\n")
                    inl seen_len = sm.length seen_capabilities : i32
                    inl duplicate_at = find_text seen_capabilities 0i32 capability_marker
                    if (<) duplicate_at seen_len then
                        18446744073709551615u64, codec_empty ()
                    else
                        inl seen_capabilities = sm.concat seen_capabilities (sm.concat capability "\n")
                        inl row = sm.concat path1 (sm.concat "\n" (sm.concat path2 (sm.concat "\n" path3)))
                        inl paths = if (=.) paths "" then row else sm.concat paths (sm.concat "\n" row)
                        state_receipt_recovered_fixture_scan_loop source next_at seen_capabilities paths ((+.) count 1u64)
        else
            state_receipt_recovered_fixture_scan_loop source next_at seen_capabilities paths count

let state_receipt_recovered_fixture_scan (source : string) : u64 * string =
    state_receipt_recovered_fixture_scan_loop source 0i32 "\n" (codec_empty ()) 0u64

let state_receipt_recovered_fixture_record_count_or_max (source : string) : u64 =
    inl count, _ = state_receipt_recovered_fixture_scan source
    count

let state_receipt_recovered_fixture_paths (source : string) : string =
    inl count, paths = state_receipt_recovered_fixture_scan source
    if (=.) count 18446744073709551615u64 then codec_empty () else paths
