inl dash_shape_ok input expected : bool =
    (=.) (state_receipt_dash_shape input) expected

inl migration_payload_ok source expected : bool =
    (=.) (state_receipt_constructor_payload source "MigrationDenominator (") expected

inl coverage_kind_ok source expected : bool =
    (=.) (state_receipt_coverage_checkpoint_kind source) expected

inl coverage_sha_ok source expected : bool =
    (=.) (state_receipt_coverage_checkpoint_sha source) expected

inl recovered_topology_count_ok () : bool =
    (=.) (state_receipt_recovered_topology_count_or_max "inl recovered_capability_fixture_count () : u32 = 22u32") 22u64
    && (=.) (state_receipt_recovered_topology_count_or_max "inl dogfood_recovered_topology_count () : u32 = 22u32") 22u64
    && (=.) (state_receipt_recovered_topology_count_or_max "no topology count") 18446744073709551615u64
    && (=.) (state_receipt_recovered_topology_count_or_max "inl recovered_capability_fixture_count () : u32 = nope") 18446744073709551615u64

inl recovered_fixture_ledger_ok () : bool =
    inl ledger = "  // recovered-fixture|cap-a|evidence/a|evidence/b|evidence/c  \n// recovered-fixture|cap-b|evidence/d|evidence/e|evidence/f"
    (=.) (state_receipt_recovered_fixture_record_count_or_max ledger) 2u64
    && (=.) (state_receipt_recovered_fixture_paths ledger) "evidence/a\nevidence/b\nevidence/c\nevidence/d\nevidence/e\nevidence/f"
    && (=.) (state_receipt_recovered_fixture_record_count_or_max "// recovered-fixture|cap-a|a|b|c\n// recovered-fixture|cap-a|d|e|f") 18446744073709551615u64
    && (=.) (state_receipt_recovered_fixture_record_count_or_max "// recovered-fixture|cap-a|a|b|c|extra") 18446744073709551615u64
    && (=.) (state_receipt_recovered_fixture_record_count_or_max "// recovered-fixture|cap-a|a|b|") 18446744073709551615u64

inl main () : i32 =
    if dash_shape_ok "" 10u64 then
        if dash_shape_ok "a" 10u64 then
            if dash_shape_ok "a-b" 21u64 then
                if dash_shape_ok "a-b-c" 32u64 then
                    if dash_shape_ok "-a-" 32u64 then
                        if dash_shape_ok "a-" 21u64 then
                            if migration_payload_ok "prefix\ninl x () = MigrationDenominator (69u32, 69u32, 1000u32, 987u32)\nsuffix" "69u32, 69u32, 1000u32, 987u32" then
                                if migration_payload_ok "no constructor here" "" then
                                    if state_receipt_series_records_valid "" then
                                        if state_receipt_series_records_valid "SeriesRecord (1u32, 69u32, 987u32, \"a\", \"b\", 1u64, \"c\", \"d\", 2u64, \"p\")" then
                                            if (=.) (state_receipt_last_series_record_payload "SeriesRecord (1u32, 69u32, 987u32, \"a\", \"b\", 1u64, \"c\", \"d\", 2u64, \"p\")\nSeriesRecord (2u32, 69u32, 987u32, \"a\", \"b\", 1u64, \"c\", \"d\", 2u64, \"p\")") "2u32, 69u32, 987u32, \"a\", \"b\", 1u64, \"c\", \"d\", 2u64, \"p\"" then
                                                if state_receipt_series_records_valid "SeriesRecord (2u32, 69u32, 987u32)\nSeriesRecord (2u32, 69u32, 987u32)" then 12i32
                                                elif state_receipt_series_records_valid "SeriesRecord (2u32, 69u32, 987u32" then 13i32
                                                elif coverage_kind_ok "CoverageCheckpointDurable (804u32, \"abc\")" 2u64 then
                                                    if coverage_kind_ok "CoverageCheckpointMissing (804u32, \"missing\", \"reason\")" 1u64 then
                                                        if coverage_kind_ok "no checkpoint" 0u64 then
                                                            if coverage_sha_ok "CoverageCheckpointDurable (804u32, \"abc\")" "abc" then
                                                                if coverage_sha_ok "CoverageCheckpointDurable (804u32, abc)" "" then
                                                                    if recovered_topology_count_ok () then
                                                                        if recovered_fixture_ledger_ok () then 0i32 else 20i32
                                                                    else 19i32
                                                                else 18i32
                                                            else 17i32
                                                        else 16i32
                                                    else 15i32
                                                else 14i32
                                            else 11i32
                                        else 10i32
                                    else 9i32
                                else 8i32
                            else 7i32
                        else 6i32
                    else 5i32
                else 4i32
            else 3i32
        else 2i32
    else 1i32
