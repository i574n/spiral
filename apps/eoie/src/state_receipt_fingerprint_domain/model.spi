nominal fingerprint_idle = ()
nominal fingerprint_mixed = ()
nominal fingerprint_committed = ()

union fingerprint_byte_class =
    | FingerprintByteAccepted
    | FingerprintByteRejected

union fingerprint_op from to =
    | MixFingerprintByte :: i32 * i32 -> fingerprint_op fingerprint_idle fingerprint_mixed
    | CommitFingerprintStep :: i32 * i32 -> fingerprint_op fingerprint_mixed fingerprint_committed

let fingerprint_byte_valid (byte : i32) (unused : i32) : i32 =
    if !!!!LT(byte, 0i32) then 0i32
    elif !!!!LT(255i32, byte) then 0i32
    else 1i32
