inl main () : i32 =
    inl serialized = receipt_serialize (serializer_fixture_table ())
    inl malformed = receipt_serialize (serializer_malformed_table ())
    $"RustExportStringUnary(\"eoie_state_receipt_serialize\",\"receipt_serialize\")" : ()
    $"RustLibrary()" : ()
    if (=.) serialized (serializer_fixture_source ()) then
        if (=.) malformed (sm.concat (receipt_header ()) (receipt_footer ())) then 0i32 else 2i32
    else 1i32
