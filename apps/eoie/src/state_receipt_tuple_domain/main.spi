inl main () : i32 =
    inl snapshot_kind, snapshot_value, snapshot_extra0, snapshot_extra1, snapshot_extra2 = receipt_row_tuple "snapshot\t42"
    inl tuple_kind, tuple_path, tuple_bytes, tuple_fingerprint, tuple_attestation = receipt_row_tuple "module\talpha.spi\t12\t34\tbuild:99"
    inl bad_kind, _, _, _, _ = receipt_row_tuple "module\talpha.spi\t12\t34\tbuild:99\textra"
    !!!!Export("eoie_state_receipt_row_tuple", ((fun value => receipt_row_tuple value) : string -> string * string * string * string * string))
    if (=.) snapshot_kind "snapshot" then
        if (=.) snapshot_value "42" then
            if (=.) snapshot_extra0 "" then
                if (=.) snapshot_extra1 "" then
                    if (=.) snapshot_extra2 "" then
                        if (=.) tuple_kind "module" then
                            if (=.) tuple_path "alpha.spi" then
                                if (=.) tuple_bytes "12" then
                                    if (=.) tuple_fingerprint "34" then
                                        if (=.) tuple_attestation "build:99" then
                                            if (=.) bad_kind "" then 0i32 else 11i32
                                        else 10i32
                                    else 9i32
                                else 8i32
                            else 7i32
                        else 6i32
                    else 5i32
                else 4i32
            else 3i32
        else 2i32
    else 1i32
