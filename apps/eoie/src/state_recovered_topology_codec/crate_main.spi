let bundle_rehydrate_structure_binding (profile : i32) (observed_mask : i32) : i32 =
    if !!!!EQ(profile,2i32) then
        if !!!!EQ(observed_mask,3i32) || !!!!EQ(observed_mask,7i32) then 1i32 else 0i32
    else
        if !!!!EQ(observed_mask,4i32) || !!!!EQ(observed_mask,5i32) || !!!!EQ(observed_mask,6i32) || !!!!EQ(observed_mask,7i32) then 1i32 else 0i32

let bundle_profile_signature_binding (bootstrap_mask : i32) (model_mask : i32) : i32 =
    if !!!!EQ(bootstrap_mask,3i32) && !!!!EQ(model_mask,3i32) then 1i32 else 0i32

inl main () : i32 =
    inl _ = bundle_rehydrate_structure_binding 2i32 7i32
    inl _ = bundle_rehydrate_structure_binding 2i32 5i32
    inl _ = bundle_rehydrate_structure_binding 1i32 4i32
    inl _ = bundle_rehydrate_structure_binding 1i32 0i32
    inl _ = bundle_profile_signature_binding 3i32 3i32
    inl _ = bundle_profile_signature_binding 3i32 1i32
    inl _ = state_receipt_recovered_topology_count_or_max "inl recovered_capability_fixture_count () : u32 = 22u32"
    inl _ = state_receipt_recovered_fixture_record_count_or_max "// recovered-fixture|cap|a|b|c"
    inl _ = state_receipt_recovered_fixture_paths "// recovered-fixture|cap|a|b|c"
    !!!!Export("eoie_state_receipt_recovered_topology_count_or_max", ((fun value => state_receipt_recovered_topology_count_or_max value) : string -> u64))
    !!!!Export("eoie_state_receipt_recovered_fixture_record_count_or_max", ((fun value => state_receipt_recovered_fixture_record_count_or_max value) : string -> u64))
    !!!!Export("eoie_state_receipt_recovered_fixture_paths", ((fun value => state_receipt_recovered_fixture_paths value) : string -> string))
    !!!!Export("eoie_bundle_rehydrate_structure_binding", ((fun (first, second) => bundle_rehydrate_structure_binding first second) : i32 * i32 -> i32))
    !!!!Export("eoie_bundle_profile_signature_binding", ((fun (first, second) => bundle_profile_signature_binding first second) : i32 * i32 -> i32))
    0i32
