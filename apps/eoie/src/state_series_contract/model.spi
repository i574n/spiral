nominal series_idle = ()
nominal series_validated = ()
nominal series_appended = ()
nominal series_typechecked = ()

union series_kind =
    | RatingSeries
    | BenchmarkSeries

union series_op from to =
    | ValidateSeriesSources :: series_op series_idle series_validated
    | AppendSeriesRecord :: series_op series_validated series_appended
    | TypecheckSeriesHistory :: series_op series_appended series_typechecked

union rec series_plan from to =
    | SeriesStep :: forall from to. series_op from to -> series_plan from to
    | SeriesThen :: forall from to. (exists middle. series_plan from middle * series_plan middle to) -> series_plan from to

inl append_only_series_plan () : series_plan series_idle series_typechecked =
    SeriesThen (exists (
        SeriesStep ValidateSeriesSources,
        SeriesThen (exists (SeriesStep AppendSeriesRecord, SeriesStep TypecheckSeriesHistory))
    ))

let series_sequence_binding (previous : i32) (next : i32) : i32 =
    if !!!!LT(previous,0i32) then 0i32
    elif !!!!EQ(!!!!Add(previous,1i32),next) then 1i32
    else 0i32

let series_source_binding (path_length : i32) (packed_shape : i32) : i32 =
    if !!!!LT(path_length,1i32) then 0i32
    elif !!!!EQ(packed_shape,32i32) then 1i32
    else 0i32

let series_pair_binding (ratings_present : i32) (bench_present : i32) : i32 =
    if !!!!EQ(ratings_present,1i32) then
        if !!!!EQ(bench_present,1i32) then 1i32 else 0i32
    else 0i32

let series_monotonic_binding (previous : i32) (next : i32) : i32 =
    if !!!!LT(previous,0i32) then 0i32
    elif !!!!LT(next,previous) then 0i32
    else 1i32

let series_fingerprint_binding (ratings_nonzero : i32) (bench_nonzero : i32) : i32 =
    if !!!!EQ(ratings_nonzero,1i32) then
        if !!!!EQ(bench_nonzero,1i32) then 1i32 else 0i32
    else 0i32
