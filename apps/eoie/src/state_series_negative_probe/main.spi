open state_series_contract.model

inl main () : i32 =
    match series_sequence_binding 10i32 10i32 with
    | 0 =>
        match series_source_binding 0i32 32i32 with
        | 0 =>
            match series_source_binding 17i32 31i32 with
            | 0 =>
                match series_pair_binding 1i32 0i32 with
                | 0 =>
                    match series_monotonic_binding 144i32 130i32 with
                    | 0 =>
                        match series_fingerprint_binding 1i32 0i32 with
                        | 0 => 0i32
                        | _ => 6i32
                    | _ => 5i32
                | _ => 4i32
            | _ => 3i32
        | _ => 2i32
    | _ => 1i32
