open rust_std_env.model

inl argument_high (~action : i32) (~position : i32) : i32 =
    $'toolchain_argument_tail_domain::eoie_toolchain_argument_token_high(!action, !position)' : i32

inl argument_chunk (~token : i32) (~chunk : i32) : i32 =
    $'toolchain_argument_domain::eoie_toolchain_argument_token_chunk(!token, !chunk)' : i32

inl pair_exit (~a : i32) (~b : i32) (~c : i32) (~d : i32) : i32 =
    $'if !a == !b && !c == !d { 0 } else { 1 }' : i32

inl main () : i32 =
    pair_exit
        (argument_high 3i32 0i32) -1i32
        (argument_chunk 12i32 1i32) 1073722824i32
