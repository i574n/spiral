union toolchain_argument_action =
    | CargoLock
    | CargoFmtCheck
    | CargoCheck
    | CargoTest
    | CargoClippy
    | CargoBuild
    | CargoVersion
    | SpiralVersion

union toolchain_argument_token =
    | GenerateLockfileToken
    | OfflineToken
    | AllToken
    | SeparatorToken
    | CheckFlagToken
    | CheckToken
    | AllTargetsToken
    | LockedToken
    | TestToken
    | DenyWarningsToken
    | WarningsToken
    | BuildToken
    | ReleaseToken
    | VersionToken

union toolchain_argument_slot =
    | NoArgument
    | Argument :: toolchain_argument_token -> toolchain_argument_slot

nominal toolchain_argument_sequence = {
    count : i32
    slot0 : toolchain_argument_slot
    slot1 : toolchain_argument_slot
    slot2 : toolchain_argument_slot
    slot3 : toolchain_argument_slot
    slot4 : toolchain_argument_slot
    slot5 : toolchain_argument_slot
    }

inl empty_slot () : toolchain_argument_slot = NoArgument
inl present_slot token : toolchain_argument_slot = Argument token

inl argument_sequence = function
    | CargoLock => toolchain_argument_sequence { count = 2i32; slot0 = present_slot GenerateLockfileToken; slot1 = present_slot OfflineToken; slot2 = empty_slot (); slot3 = empty_slot (); slot4 = empty_slot (); slot5 = empty_slot () }
    | CargoFmtCheck => toolchain_argument_sequence { count = 3i32; slot0 = present_slot AllToken; slot1 = present_slot SeparatorToken; slot2 = present_slot CheckFlagToken; slot3 = empty_slot (); slot4 = empty_slot (); slot5 = empty_slot () }
    | CargoCheck => toolchain_argument_sequence { count = 4i32; slot0 = present_slot CheckToken; slot1 = present_slot AllTargetsToken; slot2 = present_slot OfflineToken; slot3 = present_slot LockedToken; slot4 = empty_slot (); slot5 = empty_slot () }
    | CargoTest => toolchain_argument_sequence { count = 3i32; slot0 = present_slot TestToken; slot1 = present_slot OfflineToken; slot2 = present_slot LockedToken; slot3 = empty_slot (); slot4 = empty_slot (); slot5 = empty_slot () }
    | CargoClippy => toolchain_argument_sequence { count = 6i32; slot0 = present_slot AllTargetsToken; slot1 = present_slot OfflineToken; slot2 = present_slot LockedToken; slot3 = present_slot SeparatorToken; slot4 = present_slot DenyWarningsToken; slot5 = present_slot WarningsToken }
    | CargoBuild => toolchain_argument_sequence { count = 4i32; slot0 = present_slot BuildToken; slot1 = present_slot ReleaseToken; slot2 = present_slot OfflineToken; slot3 = present_slot LockedToken; slot4 = empty_slot (); slot5 = empty_slot () }
    | CargoVersion => toolchain_argument_sequence { count = 1i32; slot0 = present_slot VersionToken; slot1 = empty_slot (); slot2 = empty_slot (); slot3 = empty_slot (); slot4 = empty_slot (); slot5 = empty_slot () }
    | SpiralVersion => toolchain_argument_sequence { count = 1i32; slot0 = present_slot VersionToken; slot1 = empty_slot (); slot2 = empty_slot (); slot3 = empty_slot (); slot4 = empty_slot (); slot5 = empty_slot () }

inl argument_sequence_count (toolchain_argument_sequence x) : i32 = x.count

inl argument_sequence_probe_code () : i32 =
    inl clippy = argument_sequence CargoClippy
    inl version = argument_sequence CargoVersion
    if !!!!EQ(argument_sequence_count clippy,6i32) && !!!!EQ(argument_sequence_count version,1i32)
    then 1016i32
    else -16i32
