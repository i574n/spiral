let toolchain_argument_count_binding (action_code : i32) (witness : i32) : i32 =
    if !!!!LT(action_code,0i32) then -1i32
    elif !!!!LT(7i32,action_code) then -1i32
    elif !!!!LT(witness,0i32) then -1i32
    elif !!!!LT(0i32,witness) then -1i32
    elif !!!!EQ(action_code,0i32) then 2i32
    elif !!!!EQ(action_code,1i32) then 3i32
    elif !!!!EQ(action_code,2i32) then 4i32
    elif !!!!EQ(action_code,3i32) then 3i32
    elif !!!!EQ(action_code,4i32) then 6i32
    elif !!!!EQ(action_code,5i32) then 4i32
    else 1i32

let toolchain_argument_token_low_binding (action_code : i32) (position : i32) : i32 =
    if !!!!LT(action_code,0i32) then -1i32
    elif !!!!LT(3i32,action_code) then -1i32
    elif !!!!LT(position,0i32) then -1i32
    elif !!!!EQ(action_code,0i32) then
        if !!!!EQ(position,0i32) then 0i32 elif !!!!EQ(position,1i32) then 1i32 else -1i32
    elif !!!!EQ(action_code,1i32) then
        if !!!!EQ(position,0i32) then 2i32 elif !!!!EQ(position,1i32) then 3i32 elif !!!!EQ(position,2i32) then 4i32 else -1i32
    elif !!!!EQ(action_code,2i32) then
        if !!!!EQ(position,0i32) then 5i32 elif !!!!EQ(position,1i32) then 6i32 elif !!!!EQ(position,2i32) then 1i32 elif !!!!EQ(position,3i32) then 7i32 else -1i32
    elif !!!!EQ(position,0i32) then 8i32
    elif !!!!EQ(position,1i32) then 1i32
    elif !!!!EQ(position,2i32) then 7i32
    else -1i32

let toolchain_argument_token_chunk_binding (token_code : i32) (chunk : i32) : i32 =
    if !!!!LT(token_code,0i32) then -1i32
    elif !!!!LT(13i32,token_code) then -1i32
    elif !!!!LT(chunk,0i32) then -1i32
    elif !!!!LT(2i32,chunk) then -1i32
    elif !!!!EQ(token_code,0i32) then
        if !!!!EQ(chunk,0i32) then 17970310i32 elif !!!!EQ(chunk,1i32) then 82176147i32 else 1044750506i32
    elif !!!!EQ(token_code,1i32) then
        if !!!!EQ(chunk,0i32) then 374520666i32 elif !!!!EQ(chunk,1i32) then 1073713576i32 else 1073741823i32
    elif !!!!EQ(token_code,2i32) then
        if !!!!EQ(chunk,0i32) then 1052083034i32 else 1073741823i32
    elif !!!!EQ(token_code,3i32) then
        if !!!!EQ(chunk,0i32) then 1073741658i32 else 1073741823i32
    elif !!!!EQ(token_code,4i32) then
        if !!!!EQ(chunk,0i32) then 71535450i32 elif !!!!EQ(chunk,1i32) then 1073741802i32 else 1073741823i32
    elif !!!!EQ(token_code,5i32) then
        if !!!!EQ(chunk,0i32) then 1050743010i32 else 1073741823i32
    elif !!!!EQ(token_code,6i32) then
        if !!!!EQ(chunk,0i32) then 884310874i32 elif !!!!EQ(chunk,1i32) then 641942547i32 else 1073741810i32
    elif !!!!EQ(token_code,7i32) then
        if !!!!EQ(chunk,0i32) then 338112346i32 elif !!!!EQ(chunk,1i32) then 1073740900i32 else 1073741823i32
    elif !!!!EQ(token_code,8i32) then
        if !!!!EQ(chunk,0i32) then 1073334419i32 else 1073741823i32
    elif !!!!EQ(token_code,9i32) then
        if !!!!EQ(chunk,0i32) then 1073741690i32 else 1073741823i32
    elif !!!!EQ(token_code,10i32) then
        if !!!!EQ(chunk,0i32) then 445039638i32 elif !!!!EQ(chunk,1i32) then 1073741382i32 else 1073741823i32
    elif !!!!EQ(token_code,11i32) then
        if !!!!EQ(chunk,0i32) then 1043702401i32 else 1073741823i32
    elif !!!!EQ(token_code,12i32) then
        if !!!!EQ(chunk,0i32) then 621959002i32 elif !!!!EQ(chunk,1i32) then 1073722824i32 else 1073741823i32
    elif !!!!EQ(chunk,0i32) then 145901402i32
    elif !!!!EQ(chunk,1i32) then 1020480i32
    else 1073741823i32
