let toolchain_argument_token_high_binding (action_code : i32) (position : i32) : i32 =
    if !!!!LT(action_code,4i32) then -1i32
    elif !!!!LT(7i32,action_code) then -1i32
    elif !!!!LT(position,0i32) then -1i32
    elif !!!!EQ(action_code,4i32) then
        if !!!!EQ(position,0i32) then 6i32 elif !!!!EQ(position,1i32) then 1i32 elif !!!!EQ(position,2i32) then 7i32 elif !!!!EQ(position,3i32) then 3i32 elif !!!!EQ(position,4i32) then 9i32 elif !!!!EQ(position,5i32) then 10i32 else -1i32
    elif !!!!EQ(action_code,5i32) then
        if !!!!EQ(position,0i32) then 11i32 elif !!!!EQ(position,1i32) then 13i32 elif !!!!EQ(position,2i32) then 1i32 elif !!!!EQ(position,3i32) then 7i32 else -1i32
    elif !!!!EQ(position,0i32) then 12i32
    else -1i32
