inl main () : i32 =
    inl _ = toolchain_program_profile_binding 1i32 0i32
    inl _ = toolchain_argument_profile_binding 1i32 0i32
    inl _ = toolchain_environment_profile_binding 7i32 0i32
    inl _ = toolchain_timeout_profile_binding 2i32 0i32
    inl _ = toolchain_success_profile_binding 2i32 0i32
    inl _ = toolchain_execution_plan_binding 4i32 0i32
    inl _ = toolchain_resume_profile_binding 5i32 0i32
    inl _ = toolchain_resume_retry_binding 4i32 3i32
    inl _ = toolchain_environment_entry_count_binding 3i32 0i32
    inl _ = toolchain_environment_entry_binding 3i32 7i32
    !!!!Export("eoie_toolchain_program_profile", ((fun (first, second) => toolchain_program_profile_binding first second) : i32 * i32 -> i32))
    !!!!Export("eoie_toolchain_argument_profile", ((fun (first, second) => toolchain_argument_profile_binding first second) : i32 * i32 -> i32))
    !!!!Export("eoie_toolchain_environment_profile", ((fun (first, second) => toolchain_environment_profile_binding first second) : i32 * i32 -> i32))
    !!!!Export("eoie_toolchain_timeout_profile", ((fun (first, second) => toolchain_timeout_profile_binding first second) : i32 * i32 -> i32))
    !!!!Export("eoie_toolchain_success_profile", ((fun (first, second) => toolchain_success_profile_binding first second) : i32 * i32 -> i32))
    !!!!Export("eoie_toolchain_execution_plan", ((fun (first, second) => toolchain_execution_plan_binding first second) : i32 * i32 -> i32))
    !!!!Export("eoie_toolchain_resume_profile", ((fun (first, second) => toolchain_resume_profile_binding first second) : i32 * i32 -> i32))
    !!!!Export("eoie_toolchain_resume_retry", ((fun (first, second) => toolchain_resume_retry_binding first second) : i32 * i32 -> i32))
    !!!!Export("eoie_toolchain_environment_entry_count", ((fun (first, second) => toolchain_environment_entry_count_binding first second) : i32 * i32 -> i32))
    !!!!Export("eoie_toolchain_environment_entry", ((fun (first, second) => toolchain_environment_entry_binding first second) : i32 * i32 -> i32))
    0i32
