nominal toolchain_idle = ()
nominal toolchain_running = ()
nominal toolchain_done = ()
nominal toolchain_mutator = ()

union toolchain_authority scope =
    | ToolchainMutator :: toolchain_authority toolchain_mutator

union toolchain_action =
    | CargoLock
    | CargoFmtCheck
    | CargoCheck
    | CargoTest
    | CargoClippy
    | CargoBuild
    | CargoVersion
    | SpiralVersion

union toolchain_program_profile =
    | SelectedTool
    | CargoFmtSibling
    | CargoClippySibling

union toolchain_argument_profile =
    | GenerateLockfileOffline
    | FormatAllCheck
    | CheckAllTargetsOfflineLocked
    | TestOfflineLocked
    | ClippyAllTargetsOfflineLockedDenyWarnings
    | BuildReleaseOfflineLocked
    | VersionOnly

union toolchain_environment_profile =
    | CargoEnvironment
    | CleanEnvironment
    | CargoEnvironmentWithSpiralAuthorities

union toolchain_timeout_policy =
    | CallerPositiveMilliseconds

union toolchain_success_policy =
    | RequireSuccessfulExit

union toolchain_resume_profile =
    | CargoUtilityResume
    | CargoCheckResume
    | CargoTestResume
    | CargoClippyResume
    | CargoReleaseResume
    | SpiralUtilityResume

union toolchain_resume_decision =
    | ContinueReceipt
    | RetryTimedOutReceipt

inl toolchain_resume_profile_code = function
    | CargoUtilityResume => 0i32
    | CargoCheckResume => 1i32
    | CargoTestResume => 2i32
    | CargoClippyResume => 3i32
    | CargoReleaseResume => 4i32
    | SpiralUtilityResume => 5i32

inl toolchain_resume_decision_code = function
    | ContinueReceipt => 0i32
    | RetryTimedOutReceipt => 1i32

union toolchain_command_spec =
    | ToolchainCommandSpec :: { program : toolchain_program_profile; arguments : toolchain_argument_profile; environment : toolchain_environment_profile; timeout : toolchain_timeout_policy; success : toolchain_success_policy } -> toolchain_command_spec

union toolchain_op from to result =
    | ToolchainRun :: toolchain_authority toolchain_mutator * toolchain_action -> toolchain_op toolchain_idle toolchain_running string
    | ToolchainFinish :: toolchain_authority toolchain_mutator -> toolchain_op toolchain_running toolchain_done string

union rec toolchain_plan from to =
    | ToolchainStep :: forall from to. (exists result. toolchain_op from to result * result) -> toolchain_plan from to
    | ToolchainThen :: forall from to. (exists middle. toolchain_plan from middle * toolchain_plan middle to) -> toolchain_plan from to

inl toolchain_action_code (action : toolchain_action) : i32 =
    match action with
    | CargoLock => 0i32
    | CargoFmtCheck => 1i32
    | CargoCheck => 2i32
    | CargoTest => 3i32
    | CargoClippy => 4i32
    | CargoBuild => 5i32
    | CargoVersion => 6i32
    | SpiralVersion => 7i32

inl command_spec (action : toolchain_action) : toolchain_command_spec =
    match action with
    | CargoLock => ToolchainCommandSpec { program = SelectedTool; arguments = GenerateLockfileOffline; environment = CargoEnvironment; timeout = CallerPositiveMilliseconds; success = RequireSuccessfulExit }
    | CargoFmtCheck => ToolchainCommandSpec { program = CargoFmtSibling; arguments = FormatAllCheck; environment = CargoEnvironment; timeout = CallerPositiveMilliseconds; success = RequireSuccessfulExit }
    | CargoCheck => ToolchainCommandSpec { program = SelectedTool; arguments = CheckAllTargetsOfflineLocked; environment = CargoEnvironment; timeout = CallerPositiveMilliseconds; success = RequireSuccessfulExit }
    | CargoTest => ToolchainCommandSpec { program = SelectedTool; arguments = TestOfflineLocked; environment = CargoEnvironmentWithSpiralAuthorities; timeout = CallerPositiveMilliseconds; success = RequireSuccessfulExit }
    | CargoClippy => ToolchainCommandSpec { program = CargoClippySibling; arguments = ClippyAllTargetsOfflineLockedDenyWarnings; environment = CargoEnvironment; timeout = CallerPositiveMilliseconds; success = RequireSuccessfulExit }
    | CargoBuild => ToolchainCommandSpec { program = SelectedTool; arguments = BuildReleaseOfflineLocked; environment = CargoEnvironment; timeout = CallerPositiveMilliseconds; success = RequireSuccessfulExit }
    | CargoVersion => ToolchainCommandSpec { program = SelectedTool; arguments = VersionOnly; environment = CargoEnvironment; timeout = CallerPositiveMilliseconds; success = RequireSuccessfulExit }
    | SpiralVersion => ToolchainCommandSpec { program = SelectedTool; arguments = VersionOnly; environment = CleanEnvironment; timeout = CallerPositiveMilliseconds; success = RequireSuccessfulExit }

inl program_profile_code = function
    | SelectedTool => 0i32
    | CargoFmtSibling => 1i32
    | CargoClippySibling => 2i32

inl argument_profile_code = function
    | GenerateLockfileOffline => 0i32
    | FormatAllCheck => 1i32
    | CheckAllTargetsOfflineLocked => 2i32
    | TestOfflineLocked => 3i32
    | ClippyAllTargetsOfflineLockedDenyWarnings => 4i32
    | BuildReleaseOfflineLocked => 5i32
    | VersionOnly => 6i32

inl environment_profile_code = function
    | CargoEnvironment => 0i32
    | CleanEnvironment => 1i32
    | CargoEnvironmentWithSpiralAuthorities => 2i32

inl timeout_policy_code = function
    | CallerPositiveMilliseconds => 0i32

inl success_policy_code = function
    | RequireSuccessfulExit => 0i32

let valid_action_code (action_code : i32) : i32 =
    if !!!!LT(action_code,0i32) then 0i32
    elif !!!!LT(7i32,action_code) then 0i32
    else 1i32

let program_profile_binding (action_code : i32) (unused : i32) : i32 =
    if !!!!LT(valid_action_code action_code,1i32) then -1i32
    elif !!!!EQ(action_code,1i32) then program_profile_code CargoFmtSibling
    elif !!!!EQ(action_code,4i32) then program_profile_code CargoClippySibling
    else program_profile_code SelectedTool

let argument_profile_binding (action_code : i32) (unused : i32) : i32 =
    if !!!!LT(valid_action_code action_code,1i32) then -1i32
    elif !!!!EQ(action_code,7i32) then argument_profile_code VersionOnly
    else action_code

let environment_profile_binding (action_code : i32) (unused : i32) : i32 =
    if !!!!LT(valid_action_code action_code,1i32) then -1i32
    elif !!!!EQ(action_code,3i32) then environment_profile_code CargoEnvironmentWithSpiralAuthorities
    elif !!!!EQ(action_code,7i32) then environment_profile_code CleanEnvironment
    else environment_profile_code CargoEnvironment

let timeout_profile_binding (action_code : i32) (unused : i32) : i32 =
    if !!!!LT(valid_action_code action_code,1i32) then -1i32 else timeout_policy_code CallerPositiveMilliseconds

let success_profile_binding (action_code : i32) (unused : i32) : i32 =
    if !!!!LT(valid_action_code action_code,1i32) then -1i32 else success_policy_code RequireSuccessfulExit

inl toolchain_command_plan_probe_code () : i32 = 1012i32

inl toolchain_command_negative_probe_code () : i32 = -2i32

inl toolchain_mapping_probe_code () : i32 =
    toolchain_action_code CargoVersion

inl smoke_plan () : toolchain_plan toolchain_idle toolchain_done =
    ToolchainThen (exists (ToolchainStep (exists (ToolchainRun (ToolchainMutator, CargoCheck), "checked")), ToolchainStep (exists (ToolchainFinish ToolchainMutator, "done"))))
