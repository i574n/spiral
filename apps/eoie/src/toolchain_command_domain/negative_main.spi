inl main () : i32 =
    inl rejected_action = toolchain_execution_plan_binding -1i32 0i32
    inl rejected_witness = toolchain_execution_plan_binding 0i32 1i32
    inl rejected_negative_index = toolchain_environment_entry_binding 0i32 -1i32
    inl rejected_past_end = toolchain_environment_entry_binding 0i32 5i32
    inl rejected_clean_entry = toolchain_environment_entry_binding 7i32 0i32
