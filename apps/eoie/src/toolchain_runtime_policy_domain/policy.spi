let toolchain_execution_gate_binding (checkpoint : i32) (reserved : i32) : i32 =
    if !!!!LT(reserved,0i32) then -1i32
    elif !!!!LT(0i32,reserved) then -1i32
    elif !!!!LT(checkpoint,0i32) then -1i32
    elif !!!!LT(5i32,checkpoint) then -1i32
    elif !!!!EQ(checkpoint,1i32) then 1i32
    else 0i32

let toolchain_observed_outcome_binding (timed_out : i32) (success : i32) : i32 =
    if !!!!LT(timed_out,0i32) then -1i32
    elif !!!!LT(1i32,timed_out) then -1i32
    elif !!!!LT(success,0i32) then -1i32
    elif !!!!LT(1i32,success) then -1i32
    elif !!!!EQ(timed_out,1i32) then 3i32
    elif !!!!EQ(success,1i32) then 1i32
    else 2i32
