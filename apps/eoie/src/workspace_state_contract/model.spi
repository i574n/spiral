nominal workspace_unmapped = ()
nominal workspace_mapped = ()
nominal workspace_scored = ()
nominal workspace_budgeted = ()
nominal workspace_leased = ()
nominal workspace_authoritative = ()

union workspace_map_evidence =
    | WorkspaceMapEvidence :: u32 * u32 * u32 * u32 -> workspace_map_evidence

union workspace_score_evidence =
    | WorkspaceScoreEvidence :: u32 * u32 * u32 * u32 -> workspace_score_evidence

union workspace_budget_evidence =
    | WorkspaceBudgetEvidence :: u32 * u32 * u32 * u32 -> workspace_budget_evidence

union workspace_lease_evidence =
    | WorkspaceLeaseEvidence :: u64 * u64 -> workspace_lease_evidence

union workspace_state_op from to =
    | MapWorkspace :: workspace_map_evidence -> workspace_state_op workspace_unmapped workspace_mapped
    | ScoreWorkspace :: workspace_score_evidence -> workspace_state_op workspace_mapped workspace_scored
    | BudgetWorkspace :: workspace_budget_evidence -> workspace_state_op workspace_scored workspace_budgeted
    | LeaseWorkspace :: workspace_lease_evidence -> workspace_state_op workspace_budgeted workspace_leased
    | AuthorizeWorkspace :: workspace_state_op workspace_leased workspace_authoritative

union rec workspace_state_plan from to =
    | WorkspaceStep :: forall from to. workspace_state_op from to -> workspace_state_plan from to
    | WorkspaceThen :: forall from to. (exists middle. workspace_state_plan from middle * workspace_state_plan middle to) -> workspace_state_plan from to

let map_binding (roots : i32) (cargo : i32) (mains : i32) (package_only : i32) : i32 =
    if !!!!LT(roots,1i32) then 0i32
    elif !!!!LT(cargo,1i32) then 0i32
    elif !!!!LT(mains,1i32) then 0i32
    elif !!!!LT(package_only,0i32) then 0i32
    elif !!!!LT(roots,cargo) then 0i32
    elif !!!!EQ(!!!!Sub(roots,cargo),package_only) then 1i32
    else 0i32

let score_binding (settled : i32) (total : i32) (migration : i32) (coverage : i32) : i32 =
    if !!!!LT(settled,1i32) then 0i32
    elif !!!!LT(total,settled) then 0i32
    elif !!!!LT(migration,1i32) then 0i32
    elif !!!!LT(coverage,500i32) then 0i32
    else 1i32

// Count topology is intentionally unbounded; only local source-size limits are authority.
let budget_binding (max_file : i32) (max_crate : i32) (_state_files : i32) (_state_limit : i32) : i32 =
    if !!!!LT(max_file,1i32) then 0i32
    elif !!!!LT(1000i32,max_file) then 0i32
    elif !!!!LT(max_crate,1i32) then 0i32
    elif !!!!LT(1000i32,max_crate) then 0i32
    else 1i32

let lease_binding (budget_ms : i32) (guard_ms : i32) : i32 =
    if !!!!EQ(budget_ms,4500000i32) then
        if !!!!EQ(guard_ms,600000i32) then 1i32 else 0i32
    else 0i32

let authority_binding (map_ok : i32) (score_ok : i32) (budget_ok : i32) (lease_ok : i32) : i32 =
    inl a = !!!!Mult(map_ok,score_ok)
    inl b = !!!!Mult(budget_ok,lease_ok)
    !!!!Mult(a,b)

inl build_authority_plan () : workspace_state_plan workspace_unmapped workspace_authoritative =
    inl map = WorkspaceMapEvidence (162u32,68u32,162u32,94u32)
    inl score = WorkspaceScoreEvidence (44u32,69u32,637u32,500u32)
    inl budget = WorkspaceBudgetEvidence (974u32,1000u32,59u32,62u32)
    inl lease = WorkspaceLeaseEvidence (4500000u64,600000u64)
    WorkspaceThen (exists (
        WorkspaceStep (MapWorkspace map),
        WorkspaceThen (exists (
            WorkspaceStep (ScoreWorkspace score),
            WorkspaceThen (exists (
                WorkspaceStep (BudgetWorkspace budget),
                WorkspaceThen (exists (
                    WorkspaceStep (LeaseWorkspace lease),
                    WorkspaceStep AuthorizeWorkspace
                ))
            ))
        ))
    ))

inl authority_status () : i32 =
    inl _ = build_authority_plan ()
    authority_binding
        (map_binding 162i32 68i32 162i32 94i32)
        (score_binding 44i32 69i32 637i32 500i32)
        (budget_binding 974i32 1000i32 59i32 62i32)
        (lease_binding 4500000i32 600000i32)
