open workspace_state_contract.model

inl main () : i32 =
    inl bad_map = map_binding 152i32 67i32 155i32 84i32
    inl bad_score = score_binding 39i32 69i32 558i32 496i32
    inl bad_budget = budget_binding 974i32 1001i32 59i32 62i32
    inl bad_lease = lease_binding 4500000i32 599999i32
    if !!!!EQ(bad_map,0i32) then
        if !!!!EQ(bad_score,0i32) then
            if !!!!EQ(bad_budget,0i32) then
                if !!!!EQ(bad_lease,0i32) then 0i32 else 4i32
            else 3i32
        else 2i32
    else 1i32
