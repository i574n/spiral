union adapter_family =
    | FileSystemAdapter
    | ProcessAdapter
    | ArchiveAdapter
    | EnvironmentAdapter
    | CoverageAdapter
    | HarnessAdapter
    | ToolchainAdapter

union adapter_stage =
    | BroadRustGlobal
    | GranularMapping
    | SharedByTwoMains
    | PillarIntegrated

union adapter_assessment =
    | AdapterAssessment :: string * adapter_family * u32 * u32 * u32 * adapter_stage * string -> adapter_assessment

inl filesystem_transaction () : adapter_assessment =
    AdapterAssessment ("filesystem-transaction", FileSystemAdapter, 990u32, 900u32, 1000u32, SharedByTwoMains, "typed mutation plus bounded slice deterministic search native SHA256 and mode-preserving atomic copy are direct public routes; three monolithic shadow branches remain before net shrinkage")

inl process_execution () : adapter_assessment =
    AdapterAssessment ("process-execution", ProcessAdapter, 920u32, 820u32, 960u32, SharedByTwoMains, "real success nonzero exit elapsed time timeout kill wait rejected spawn plus separate stdout and stderr capture receipts are consumed by two mains; direct deadline polling and stream content ownership remain")

inl archive_lifecycle () : adapter_assessment =
    AdapterAssessment ("archive-lifecycle", ArchiveAdapter, 1000u32, 1000u32, 1000u32, SharedByTwoMains, "one Stored-and-Deflate staged extractor owns proxy and bundle rehydration; two injected precommit faults prove exact parent rollback hot and cold while the duplicate Stored-only physical route is retired")

inl owned_environment () : adapter_assessment =
    AdapterAssessment ("owned-environment", EnvironmentAdapter, 720u32, 180u32, 520u32, SharedByTwoMains, "argument mappings are granular and already reused by operational owners")

inl session_clock () : adapter_assessment =
    AdapterAssessment ("session-clock", EnvironmentAdapter, 860u32, 40u32, 900u32, SharedByTwoMains, "granular SystemTime mapping is consumed by two main-owned applications with a four-thousand-two-hundred-second deadline used as both alpha publication floor and semantic hard stop")

inl coverage_runtime () : adapter_assessment =
    AdapterAssessment ("coverage-runtime", CoverageAdapter, 420u32, 960u32, 280u32, BroadRustGlobal, "valuable later but not on the critical bootstrap path")

inl toolchain_execution () : adapter_assessment =
    AdapterAssessment ("toolchain-execution", ToolchainAdapter, 900u32, 870u32, 940u32, BroadRustGlobal, "action parsing command construction sibling selection environment wiring and bounded launch still live in one runtime string; inventory ranks it before larger pillar owners")

inl runtime_named_file_count () : u32 = 8u32
inl exact_runtime_file_count () : u32 = 0u32
inl runtime_named_bytes () : u32 = 53795u32
inl exact_runtime_bytes () : u32 = 0u32

inl first_selected_mapping () : adapter_assessment = session_clock ()
inl next_selected_mapping () : adapter_assessment = toolchain_execution ()
inl next_pillar_mapping () : adapter_assessment = filesystem_transaction ()
inl main () : i32 = 0i32
