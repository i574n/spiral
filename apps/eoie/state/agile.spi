inl differential_catalog_closeout () = Task ("DIFFERENTIAL-CATALOG-CLOSEOUT", "Close the formal differential blocker with a typed staged contract and negative probe plus a physical verifier that dereferences four current hashes, the ten-scenario nine-receipt five-evidence differential settlement, the thirty-six-of-thirty-six legacy catalog, source markers, bundle-check consumption, live-status consumption and a hash-drift rejection fixture.", Feature, P0, D8, 100u32, Done, "SEMANTIC-EVIDENCE-CLOSEOUT-V2", "authority,differential,catalog,evidence,hash,negative-probe", "current", "current")

inl family_contracts_closeout () = Task ("FAMILY-CONTRACTS-CLOSEOUT", "Close the formal family-contract blocker by reusing the concrete thirty-six-family legacy catalog and runtime inventory as authority, compiling a typed staged contract and negative probe, dereferencing four current hashes, proving a thirty-six-to-thirty-six unique family-decision bijection with no unsettled families, consuming the proof in bundle-check and live status, and rejecting semantic family drift even after the fixture refreshes both catalog-dependent receipt hashes.", Feature, P0, D8, 100u32, Done, "DIFFERENTIAL-CATALOG-CLOSEOUT", "authority,family,catalog,inventory,bijection,negative-probe", "current", "current")

inl generic_bundle_profiles () = Task ("GENERIC-BUNDLE-PROFILES", "Make EOIE bundle validation reusable across arbitrary projects: auto-detect the strong EOIE release signature, retain fail-closed EOIE semantic checks for that profile, provide explicit generic and eoie profiles, and let generic roots receive deterministic manifest integrity checks without inheriting EOIE-only evidence coverage crate-layout or single-binary constraints. Follow with profile-aware generic rehydration and explicit payload ceilings.", Feature, P0, D7, 100u32, Done, "LEASE-EFFECT-AUTHORITY", "bundle,profile,generic,workspace,rehydrate,adoption", "current", "current")

