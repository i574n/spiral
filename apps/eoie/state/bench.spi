union bench_status =
    | BenchPlanned
    | BenchPassed
    | BenchFailed
    | BenchBlocked

union bench_kind =
    | BootstrapBench
    | TypecheckBench
    | RustEmitBench
    | CargoCheckBench
    | CargoTestBench
    | ClippyBench
    | FormatBench
    | BundleRoundtripBench
    | ParallelBench
    | CompilerInterfaceBench
    | CoverageBench

union bench_case =
    | BenchCase :: string * bench_kind * bench_status * u32 -> bench_case

