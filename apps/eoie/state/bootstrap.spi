nominal boot = ()
nominal fallback_selected = ()
nominal candidate_built = ()
nominal candidate_verified = ()
nominal promoted = ()

union bootstrap_state state =
    | Boot :: bootstrap_state boot
    | FallbackSelected :: bootstrap_state fallback_selected
    | CandidateBuilt :: bootstrap_state candidate_built
    | CandidateVerified :: bootstrap_state candidate_verified
    | Promoted :: bootstrap_state promoted

union fallback_role =
    | RecentOperationalFallback :: fallback_role
    | ArchiveOperationalFallback :: fallback_role

union eoie_pillar =
    | PatchBatching :: eoie_pillar
    | AgileControl :: eoie_pillar
    | BundleLifecycle :: eoie_pillar
    | ContainerProxy :: eoie_pillar

union bootstrap_rule =
    | RustInstalledFirst :: bootstrap_rule
    | CompilerPinnedByIdentity :: bootstrap_rule
    | CandidateMustPassE2e :: bootstrap_rule
    | FallbackBeforeHostEscape :: bootstrap_rule
    | SpiralAuthoredOnly :: bootstrap_rule
    | GeneratedRustIsMirror :: bootstrap_rule
    | RawRustRequiresExhaustedTechnique :: bootstrap_rule
    | SharedPackageBeforeDuplication :: bootstrap_rule
    | MainOwnsGeneratedCrate :: bootstrap_rule
    | FlatBundleRoot :: bootstrap_rule
    | StateAndSourceAreRootSiblings :: bootstrap_rule
    | SinglePublicBinary :: bootstrap_rule
    | SharedIncrementalTarget :: bootstrap_rule
    | CrateUnderBudget :: u32 -> bootstrap_rule
    | RustFileUnderBudget :: u32 -> bootstrap_rule

nominal spiral_source = ()
nominal generated_residual = ()
nominal shared_spiral_package = ()
nominal application_main = ()
nominal candidate_route = ()
nominal recent_fallback_route = ()
nominal archive_fallback_route = ()
nominal host_escape_rejected = ()

union source_authority state =
    | SpiralSourceAuthority :: source_authority spiral_source
    | GeneratedResidualAuthority :: source_authority generated_residual

union compile_authority_transition from to_ =
    | CompileSpiralSource :: compile_authority_transition spiral_source generated_residual

union crate_origin origin =
    | SharedPackageOrigin :: crate_origin shared_spiral_package
    | MainOwnedApplicationOrigin :: crate_origin application_main

union execution_route state =
    | CandidateRoute :: execution_route candidate_route
    | RecentFallbackRoute :: execution_route recent_fallback_route
    | ArchiveFallbackRoute :: execution_route archive_fallback_route
    | HostEscapeRejected :: execution_route host_escape_rejected

union route_transition from to_ =
    | CandidateUnavailable :: route_transition candidate_route recent_fallback_route
    | RecentFallbackUnavailable :: route_transition recent_fallback_route archive_fallback_route
    | ArchiveFallbackUnavailable :: route_transition archive_fallback_route host_escape_rejected

union bundle_root_entry =
    | PublicBinaryRoot :: bundle_root_entry
    | StateRoot :: bundle_root_entry
    | SourceRoot :: bundle_root_entry

union bootstrap_transition from to_ =
    | SelectFallback :: fallback_role -> bootstrap_transition boot fallback_selected
    | BuildCandidate :: bootstrap_transition fallback_selected candidate_built
    | VerifyCandidate :: bootstrap_transition candidate_built candidate_verified
    | PromoteCandidate :: bootstrap_transition candidate_verified promoted

union proof_kind =
    | SpiralTypecheck :: proof_kind
    | RustMirrorCompiled :: proof_kind
    | CargoCheck :: proof_kind
    | CargoTest :: proof_kind
    | ColdRoundtrip :: proof_kind
    | Differential :: proof_kind

union bootstrap_receipt =
    | BootstrapReceipt :: string * proof_kind * string -> bootstrap_receipt

inl settled_migration_score_0_1000 () : u32 = bootstrap_policy.model.settled_migration_score_0_1000 ()
inl recovered_prototype_score_0_1000 () : u32 = bootstrap_policy.model.recovered_prototype_score_0_1000 ()
inl shared_policy_probe () : i32 = bootstrap_policy.model.patch_probe_result ()
inl candidate_is_promotable has_typecheck has_e2e has_cold_diff : bool =
    if has_typecheck then
        if has_e2e then has_cold_diff else false
    else false

inl main () : i32 = 0i32
