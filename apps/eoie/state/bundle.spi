nominal root_unchecked = ()
nominal root_flat = ()
nominal archive_verified = ()
nominal one_binary = ()
nominal no_lib_rs = ()
nominal no_nested_src = ()
nominal no_generated_sidecars = ()
nominal crate_under_budget = ()
nominal no_spent_plans = ()

union bundle_rule witness =
    | RootFlat :: bundle_rule root_flat
    | OneBinary :: bundle_rule one_binary
    | NoLibRs :: bundle_rule no_lib_rs
    | NoNestedSrc :: bundle_rule no_nested_src
    | NoGeneratedSidecars :: bundle_rule no_generated_sidecars
    | CrateUnderBudget :: u32 -> bundle_rule crate_under_budget
    | NoSpentPlans :: bundle_rule no_spent_plans

union bundle_transition from to =
    | CheckRoot :: bundle_rule root_flat * bundle_rule one_binary * bundle_rule no_lib_rs * bundle_rule no_nested_src * bundle_rule no_generated_sidecars * bundle_rule crate_under_budget * bundle_rule no_spent_plans -> bundle_transition root_unchecked root_flat
    | VerifyArchive :: bundle_transition root_flat archive_verified

union bundle_observation =
    | BundleObservation :: string * u32 * u32 * u32 -> bundle_observation

union parity_relation =
    | Preserved
    | Strengthened
    | Retired

union parity_fact =
    | ParityFact :: string * parity_relation * string -> parity_fact

inl crate_line_budget () : bundle_rule crate_under_budget = CrateUnderBudget 1000u32
inl flat_root () : bundle_rule root_flat = RootFlat
inl single_binary () : bundle_rule one_binary = OneBinary
inl named_sources () : bundle_rule no_lib_rs = NoLibRs
inl flat_crates () : bundle_rule no_nested_src = NoNestedSrc
inl clean_generated_tree () : bundle_rule no_generated_sidecars = NoGeneratedSidecars
inl retired_plans_absent () : bundle_rule no_spent_plans = NoSpentPlans
inl current_observation () : bundle_observation = BundleObservation ("count-topology-unbounded-one-binary-local-source-limit-one-thousand", 1000u32, 73u32, 54u32)

inl legacy_source () = ParityFact ("cpp/legacy_full/eoie_alpha693_full.cpp#3322-3706", Preserved, "sha256 0e0fac43bbf368c88abc3d5e67a0973b15fc8e96e7df002901b41a59ad2d5509")
inl store_writer () = ParityFact ("ZIP32 store writer with CRC32 little-endian headers fixed DOS time staging rename and canonical central directory", Preserved, "Spiral-generated Rust implements the same physical archive core")
inl manifest_order () = ParityFact ("UTF-8 lexical order duplicate rejection unsafe path rejection and author-owned nested ZIP rejection", Strengthened, "the Cpp writer sorted filesystem paths and filtered binaries only under no-bins")
inl executable_mode () = ParityFact ("Unix executable permission preservation", Strengthened, "the Cpp writer wrote zero external attributes and restored binaries best-effort after extraction")
inl transitional_collector () = ParityFact ("legacy Rust collector execution path", Retired, "bundle create consumes only collect_bundle_manifest; the generic verifier and writer now belong to the manifest owner")
inl current_source () = ParityFact ("src/eoie_bundle_manifest/bundle_manifest.spi", Preserved, "generic Stored and deterministic Deflate verification is owned by the manifest package")

inl main () : i32 = 0i32
