union calibration_rule =
    | SubjectiveAnchor :: u32 * u32 * u32 * string -> calibration_rule
    | CountTopologyPolicy :: string -> calibration_rule
    | VerificationSplit :: u32 * u32 * u32 -> calibration_rule
    | MigrationDenominatorRule :: u32 * u32 * u32 * u32 -> calibration_rule
    | PortfolioTruthRule :: u32 * u32 * u32 * u32 * u32 * string -> calibration_rule

inl subjective_anchor () : calibration_rule = SubjectiveAnchor (543u32, 305u32, 700u32, "active codebase readiness is five-hundred-forty-three across sixteen weighted workstreams after zero-credit unfinished fronts are weighted explicitly; subjective ActiveSignal ratings are capped at seven-hundred while settled migration legacy absorption coverage and other ObjectiveDenominator values remain separately visible and excluded from the active rollup")
inl count_topology_policy () : calibration_rule = CountTopologyPolicy ("state files Cargo crates Spiral packages and projects are unbounded in count; only per-file and per-crate source-size gates remain bounded at one-thousand LOC")
inl verification_split () : calibration_rule = VerificationSplit (850u32, 820u32, 30u32)
inl migration_denominator_rule () : calibration_rule = MigrationDenominatorRule (69u32, 69u32, 0u32, 987u32)
inl portfolio_truth_rule () : calibration_rule = PortfolioTruthRule (987u32, 804u32, 543u32, 650u32, 0u32, "objective migration coverage and legacy closure stay separate from active codebase readiness; unfinished journal confined-IO autonomous-agent sensor causal-delta and onboarding fronts keep explicit zero credit, so mature subsystems cannot saturate the project score")
inl main () : i32 = 0i32
