union patch_exact = | PatchExact :: string * string * string -> patch_exact
inl command_profile_name () : patch_exact = PatchExact ("src/toolchain_command_domain/model.spi", "    | BuildOfflineLocked\n    | VersionOnly", "    | BuildReleaseOfflineLocked\n    | VersionOnly")
inl command_profile_use () : patch_exact = PatchExact ("src/toolchain_command_domain/model.spi", "| CargoBuild => ToolchainCommandSpec { program = SelectedTool; arguments = BuildOfflineLocked; environment = CargoEnvironment; timeout = CallerPositiveMilliseconds; success = RequireSuccessfulExit }", "| CargoBuild => ToolchainCommandSpec { program = SelectedTool; arguments = BuildReleaseOfflineLocked; environment = CargoEnvironment; timeout = CallerPositiveMilliseconds; success = RequireSuccessfulExit }")
inl command_profile_code () : patch_exact = PatchExact ("src/toolchain_command_domain/model.spi", "    | BuildOfflineLocked => 5i32", "    | BuildReleaseOfflineLocked => 5i32")
inl command_resume_types () : patch_exact = PatchExact ("src/toolchain_command_domain/model.spi", "union toolchain_success_policy =\n    | RequireSuccessfulExit\n\nunion toolchain_command_spec =", "union toolchain_success_policy =\n    | RequireSuccessfulExit\n\nunion toolchain_resume_profile =\n    | CargoUtilityResume\n    | CargoCheckResume\n    | CargoTestResume\n    | CargoClippyResume\n    | CargoReleaseResume\n    | SpiralUtilityResume\n\nunion toolchain_resume_decision =\n    | ContinueReceipt\n    | RetryTimedOutReceipt\n    | TerminalReceipt\n\ninl toolchain_resume_profile_code = function\n    | CargoUtilityResume => 0i32\n    | CargoCheckResume => 1i32\n    | CargoTestResume => 2i32\n    | CargoClippyResume => 3i32\n    | CargoReleaseResume => 4i32\n    | SpiralUtilityResume => 5i32\n\ninl toolchain_resume_decision_code = function\n    | ContinueReceipt => 0i32\n    | RetryTimedOutReceipt => 1i32\n    | TerminalReceipt => 2i32\n\nunion toolchain_command_spec =")
inl command_resume_bindings () : patch_exact = PatchExact ("src/toolchain_command_domain/bridge.spi", "let toolchain_execution_plan_binding", "let toolchain_resume_profile_binding (action_code : i32) (witness : i32) : i32 =\n    if !!!!LT(action_code,0i32) then -1i32\n    elif !!!!LT(7i32,action_code) then -1i32\n    elif !!!!LT(witness,0i32) then -1i32\n    elif !!!!LT(0i32,witness) then -1i32\n    elif !!!!EQ(action_code,2i32) then toolchain_resume_profile_code CargoCheckResume\n    elif !!!!EQ(action_code,3i32) then toolchain_resume_profile_code CargoTestResume\n    elif !!!!EQ(action_code,4i32) then toolchain_resume_profile_code CargoClippyResume\n    elif !!!!EQ(action_code,5i32) then toolchain_resume_profile_code CargoReleaseResume\n    elif !!!!EQ(action_code,7i32) then toolchain_resume_profile_code SpiralUtilityResume\n    else toolchain_resume_profile_code CargoUtilityResume\n\nlet toolchain_resume_retry_binding (checkpoint : i32) (outcome : i32) : i32 =\n    if !!!!EQ(checkpoint,4i32) && !!!!EQ(outcome,3i32) then toolchain_resume_decision_code RetryTimedOutReceipt else toolchain_resume_decision_code ContinueReceipt\n\nlet toolchain_resume_terminal_binding (checkpoint : i32) (outcome : i32) : i32 =\n    if !!!!EQ(checkpoint,5i32) && (!!!!EQ(outcome,1i32) || !!!!EQ(outcome,2i32)) then toolchain_resume_decision_code TerminalReceipt else toolchain_resume_decision_code ContinueReceipt\n\nlet toolchain_execution_plan_binding")
inl command_resume_exports () : patch_exact = PatchExact ("src/toolchain_command_domain/main.spi", "    inl _ = toolchain_execution_plan_binding 4i32 0i32", "    inl _ = toolchain_execution_plan_binding 4i32 0i32\n    inl _ = toolchain_resume_profile_binding 5i32 0i32\n    inl _ = toolchain_resume_retry_binding 4i32 3i32\n    inl _ = toolchain_resume_terminal_binding 5i32 1i32")
inl command_resume_export_symbols () : patch_exact = PatchExact ("src/toolchain_command_domain/main.spi", "    $\"RustExportI32Binary(\\\"eoie_toolchain_execution_plan\\\",\\\"toolchain_execution_plan_binding\\\")\" : ()", "    $\"RustExportI32Binary(\\\"eoie_toolchain_execution_plan\\\",\\\"toolchain_execution_plan_binding\\\")\" : ()\n    $\"RustExportI32Binary(\\\"eoie_toolchain_resume_profile\\\",\\\"toolchain_resume_profile_binding\\\")\" : ()\n    $\"RustExportI32Binary(\\\"eoie_toolchain_resume_retry\\\",\\\"toolchain_resume_retry_binding\\\")\" : ()\n    $\"RustExportI32Binary(\\\"eoie_toolchain_resume_terminal\\\",\\\"toolchain_resume_terminal_binding\\\")\" : ()")
inl argument_release_token () : patch_exact = PatchExact ("src/toolchain_argument_domain/arguments.spi", "    | BuildToken\n    | VersionToken", "    | BuildToken\n    | ReleaseToken\n    | VersionToken")
inl argument_release_sequence () : patch_exact = PatchExact ("src/toolchain_argument_domain/arguments.spi", "| CargoBuild => toolchain_argument_sequence { count = 3i32; slot0 = present_slot BuildToken; slot1 = present_slot OfflineToken; slot2 = present_slot LockedToken; slot3 = empty_slot (); slot4 = empty_slot (); slot5 = empty_slot () }", "| CargoBuild => toolchain_argument_sequence { count = 4i32; slot0 = present_slot BuildToken; slot1 = present_slot ReleaseToken; slot2 = present_slot OfflineToken; slot3 = present_slot LockedToken; slot4 = empty_slot (); slot5 = empty_slot () }")
inl argument_release_count () : patch_exact = PatchExact ("src/toolchain_argument_domain/bridge.spi", "    elif !!!!EQ(action_code,5i32) then 3i32", "    elif !!!!EQ(action_code,5i32) then 4i32")
inl argument_release_max () : patch_exact = PatchExact ("src/toolchain_argument_domain/bridge.spi", "    elif !!!!LT(12i32,token_code) then -1i32", "    elif !!!!LT(13i32,token_code) then -1i32")
inl argument_release_chunks () : patch_exact = PatchExact ("src/toolchain_argument_domain/bridge.spi", "    elif !!!!EQ(token_code,11i32) then\n        if !!!!EQ(chunk,0i32) then 1043702401i32 else 1073741823i32\n    elif !!!!EQ(chunk,0i32) then 621959002i32\n    elif !!!!EQ(chunk,1i32) then 1073722824i32\n    else 1073741823i32", "    elif !!!!EQ(token_code,11i32) then\n        if !!!!EQ(chunk,0i32) then 1043702401i32 else 1073741823i32\n    elif !!!!EQ(token_code,12i32) then\n        if !!!!EQ(chunk,0i32) then 621959002i32 elif !!!!EQ(chunk,1i32) then 1073722824i32 else 1073741823i32\n    elif !!!!EQ(chunk,0i32) then 145901402i32\n    elif !!!!EQ(chunk,1i32) then 1020480i32\n    else 1073741823i32")
inl argument_release_tail () : patch_exact = PatchExact ("src/toolchain_argument_tail_domain/bridge.spi", "if !!!!EQ(position,0i32) then 11i32 elif !!!!EQ(position,1i32) then 1i32 elif !!!!EQ(position,2i32) then 7i32 else -1i32", "if !!!!EQ(position,0i32) then 11i32 elif !!!!EQ(position,1i32) then 13i32 elif !!!!EQ(position,2i32) then 1i32 elif !!!!EQ(position,3i32) then 7i32 else -1i32")
inl state_receipt_identity () : patch_exact = PatchExact ("state/core.spi", "union toolchain_process_receipt =\n    | ToolchainProcessReceipt :: toolchain_process_action * toolchain_process_checkpoint * toolchain_process_outcome * u64 * string -> toolchain_process_receipt", "union toolchain_process_profile =\n    | CargoUtilityProcess\n    | CargoCheckProcessProfile\n    | CargoTestProcessProfile\n    | CargoClippyProcessProfile\n    | CargoReleaseProcessProfile\n    | SpiralUtilityProcess\n\nunion toolchain_process_identity =\n    | ToolchainProcessIdentity :: u64 * u64 * u64 * toolchain_process_profile -> toolchain_process_identity\n\nunion toolchain_process_receipt =\n    | ToolchainProcessReceipt :: toolchain_process_action * toolchain_process_checkpoint * toolchain_process_outcome * u64 * u32 * toolchain_process_identity -> toolchain_process_receipt")
union cargo_resume_evidence =
    | TimeoutReceiptTyped
    | RetryBudgetIndependent
    | ReleaseCommandCompiled
    | SharedTargetIdentity
    | PublicBinaryMaterialized

union cargo_resume_settlement =
    | CargoResumeSettlement :: u32 * u32 * u32 * cargo_resume_evidence * cargo_resume_evidence * cargo_resume_evidence * cargo_resume_evidence * cargo_resume_evidence -> cargo_resume_settlement

inl current_cargo_resume_settlement () : cargo_resume_settlement =
    CargoResumeSettlement (30u32, 69u32, 432u32, TimeoutReceiptTyped, RetryBudgetIndependent, ReleaseCommandCompiled, SharedTargetIdentity, PublicBinaryMaterialized)

inl main () : i32 = 0i32
