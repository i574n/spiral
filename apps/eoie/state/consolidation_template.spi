nominal template_authored = ()
nominal template_negative = ()
nominal template_consumed = ()
nominal template_cold = ()
nominal template_settled = ()

union consolidation_template_stage state =
    | TemplateAuthored :: consolidation_template_stage template_authored
    | TemplateNegative :: consolidation_template_stage template_negative
    | TemplateConsumed :: consolidation_template_stage template_consumed
    | TemplateCold :: consolidation_template_stage template_cold
    | TemplateSettled :: consolidation_template_stage template_settled

union consolidation_template_step from to_ =
    | ProveNegativeFixture :: consolidation_template_step template_authored template_negative
    | ProveTwoConsumers :: consolidation_template_step template_negative template_consumed
    | ProveColdRoundtrip :: consolidation_template_step template_consumed template_cold
    | SettleCapability :: consolidation_template_step template_cold template_settled

union consolidation_packet =
    | ConsolidationPacket :: string * string * string * string * string * u32 -> consolidation_packet

inl state_receipt_codec_packet () : consolidation_packet =
    ConsolidationPacket (
        "STATE-RECEIPT-CODEC-MAPPING",
        "state_receipt_codec_core",
        "state_receipt_parser_domain,state_receipt_serializer_domain",
        "state_receipt_parser_probe,state_receipt_serializer_probe",
        "malformed-receipt,malformed-row",
        2u32
    )

union throughput_rule =
    | ReuseSharedCore
    | OneResponsibilityPerCrate
    | NegativeFixtureBeforeIntegration
    | TwoConsumersBeforeSettlement
    | ColdReplayBeforeCredit
    | PhysicalCrateBelowOneThousand

inl main () : i32 = 0i32
