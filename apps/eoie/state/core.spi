nominal patch_batching = ()
nominal agile_control = ()
nominal bundle_control = ()
nominal container_proxy = ()
nominal coverage_pruning = ()
nominal spiral_codegen = ()
nominal self_evolution = ()
nominal parallel_execution = ()

union priority =
    | P0 :: priority
    | P1 :: priority
    | P2 :: priority
    | P3 :: priority
    | P4 :: priority
    | P5 :: priority

union difficulty =
    | D0 :: difficulty
    | D1 :: difficulty
    | D2 :: difficulty
    | D3 :: difficulty
    | D4 :: difficulty
    | D5 :: difficulty
    | D6 :: difficulty
    | D7 :: difficulty
    | D8 :: difficulty

union task_status =
    | Planned :: task_status
    | Active :: task_status
    | Blocked :: task_status
    | Paused :: task_status
    | Done :: task_status

union capability kind =
    | PatchBatching :: capability patch_batching
    | AgileControl :: capability agile_control
    | BundleControl :: capability bundle_control
    | ContainerProxy :: capability container_proxy
    | CoveragePruning :: capability coverage_pruning
    | SpiralCodegen :: capability spiral_codegen
    | SelfEvolution :: capability self_evolution
    | ParallelExecution :: capability parallel_execution

nominal proposed = ()
nominal contracted = ()
nominal implemented = ()
nominal covered = ()
nominal dogfooded = ()
nominal bundled = ()
nominal prunable = ()

union lifecycle stage =
    | Proposed :: lifecycle proposed
    | Contracted :: lifecycle contracted
    | Implemented :: lifecycle implemented
    | Covered :: lifecycle covered
    | Dogfooded :: lifecycle dogfooded
    | Bundled :: lifecycle bundled
    | Prunable :: lifecycle prunable

nominal zero = ()
nominal succ n = n
union rec static_budget n =
    | ZeroBudget :: static_budget zero
    | MoreBudget :: forall n. static_budget n -> static_budget (succ n)

inl spend forall n. (budget : static_budget (succ n)) : static_budget n =
    match budget with
    | MoreBudget rest => rest

nominal admin_scope = ()
nominal patch_scope = ()
nominal inspect_scope = ()
union authority scope =
    | AdminAuthority :: authority admin_scope
    | PatchAuthority :: authority patch_scope
    | InspectAuthority :: authority inspect_scope

inl attenuate_patch (authority : authority admin_scope) : authority patch_scope =
    match authority with
    | AdminAuthority => PatchAuthority

inl attenuate_inspect (authority : authority patch_scope) : authority inspect_scope =
    match authority with
    | PatchAuthority => InspectAuthority

union toolchain_process_action =
    | CargoLockProcess
    | CargoFmtCheckProcess
    | CargoCheckProcess
    | CargoTestProcess
    | CargoClippyProcess
    | CargoBuildProcess
    | CargoVersionProcess
    | SpiralVersionProcess

union toolchain_process_checkpoint =
    | ToolchainNotStarted
    | ToolchainSpawnCommitted
    | ToolchainRunCommitted
    | ToolchainLinkCommitted
    | ToolchainTimeoutCommitted
    | ToolchainCompletionCommitted

union toolchain_process_outcome =
    | ToolchainPending
    | ToolchainPassed :: i32 -> toolchain_process_outcome
    | ToolchainFailed :: i32 -> toolchain_process_outcome
    | ToolchainTimedOut :: u64 -> toolchain_process_outcome

union toolchain_process_profile =
    | CargoUtilityProcess
    | CargoCheckProcessProfile
    | CargoTestProcessProfile
    | CargoClippyProcessProfile
    | CargoReleaseProcessProfile
    | SpiralUtilityProcess

union toolchain_process_identity =
    | ToolchainProcessIdentity :: u64 * u64 * u64 * toolchain_process_profile -> toolchain_process_identity

union toolchain_process_receipt =
    | ToolchainProcessReceipt :: toolchain_process_action * toolchain_process_checkpoint * toolchain_process_outcome * u64 * u32 * toolchain_process_identity -> toolchain_process_receipt

union evidence_media_type =
    | CoverageLcovMedia
    | ReceiptTextMedia
    | Utf8TextMedia
    | BinaryMedia

union evidence_storage =
    | BundlePath
    | ExternalRequired

union evidence_ref =
    | EvidenceRef :: string * string * u64 * evidence_media_type * evidence_storage -> evidence_ref

union evidence_tree_policy =
    | ExactTree
    | StateTreeWithoutMetaManifests

union evidence_tree_ref =
    | EvidenceTreeRef :: string * string * evidence_tree_policy -> evidence_tree_ref

inl main () : i32 = 0i32
