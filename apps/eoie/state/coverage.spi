nominal test_profile = ()
nominal smoke_profile = ()
nominal mutation_profile = ()
nominal covered = ()
nominal uncovered = ()
nominal candidate = ()
nominal retained = ()
nominal pruned = ()
nominal tool_passed = ()
nominal tool_blocked = ()
nominal coverage_target_fresh = ()
nominal coverage_target_stale = ()
nominal smoke_passed = ()
nominal smoke_blocked = ()
nominal owner_profile_ready = ()
nominal owner_profile_blocked = ()
nominal promotion_denied = ()
nominal canonical_release_basis = ()
nominal owner_visibility_basis = ()

union coverage_measurement basis =
    | CanonicalReleaseMeasurement :: string * u32 * u32 * u32 * u32 * u32 * u32 * u32 * string -> coverage_measurement canonical_release_basis
    | OwnerVisibilityMeasurement :: string * u32 * u32 * u32 * u32 * string -> coverage_measurement owner_visibility_basis

union coverage_comparison basis =
    | CoverageComparable :: forall basis. coverage_measurement basis * coverage_measurement basis * i32 -> coverage_comparison basis

union coverage_mode mode =
    | TestProfile :: coverage_mode test_profile
    | SmokeProfile :: coverage_mode smoke_profile
    | MutationProfile :: coverage_mode mutation_profile

union line_evidence state =
    | CoveredLine :: u32 -> line_evidence covered
    | UncoveredLine :: u32 -> line_evidence uncovered

union prune_decision state =
    | Candidate :: string * line_evidence uncovered * line_evidence uncovered -> prune_decision candidate
    | Retained :: string -> prune_decision retained
    | Pruned :: string * string -> prune_decision pruned

union coverage_floor =
    | CoverageFloor :: u32 * u32 * u32 -> coverage_floor

union coverage_observation =
    | CoverageObservation :: string * u32 * u32 * u32 * u32 -> coverage_observation

union coverage_union =
    | CoverageUnion :: string * u32 * u32 * u32 * u32 -> coverage_union

union smoke_kind =
    | PublicProcess :: smoke_kind
    | GeneratedExample :: smoke_kind

union smoke_target state =
    | SmokePassed :: string * string * smoke_kind -> smoke_target smoke_passed
    | SmokeBlocked :: string * string * smoke_kind -> smoke_target smoke_blocked

union coverage_tool state =
    | ToolPassed :: string * string -> coverage_tool tool_passed
    | ToolBlocked :: string * string -> coverage_tool tool_blocked

union coverage_target state =
    | CoverageTargetFresh :: string * u32 * string -> coverage_target coverage_target_fresh
    | CoverageTargetStale :: string * string -> coverage_target coverage_target_stale

union coverage_checkpoint_durability =
    | CoverageCheckpointDurable :: u32 * string -> coverage_checkpoint_durability
    | CoverageCheckpointMissing :: u32 * string * string -> coverage_checkpoint_durability

union coverage_replay_seed =
    | CoverageReplaySeed :: u32 * u32 * string * string -> coverage_replay_seed

union owner_shard state =
    | OwnerShardReady :: string * u32 * u32 * string -> owner_shard owner_profile_ready
    | OwnerShardBlocked :: string * string -> owner_shard owner_profile_blocked

union dogfood_blocker =
    | CoverageBelowFloor :: string -> dogfood_blocker
    | IncompletePillars :: string -> dogfood_blocker

union dogfood_decision state =
    | DogfoodDenied :: coverage_floor * coverage_observation * dogfood_blocker -> dogfood_decision promotion_denied

union coverage_cost_summary =
    | CoverageCostSummary :: u32 * u32 * u32 * u32 * u32 -> coverage_cost_summary

union coverage_owner_cost =
    | CoverageOwnerCost :: string * u32 * u32 * u32 -> coverage_owner_cost

