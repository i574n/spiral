union coverage_scope =
    | ProductAndVendor :: coverage_scope
    | AuthorProductOnly :: coverage_scope

union coverage_basis =
    | CoverageBasis :: coverage_scope * u32 * u32 * u32 * u32 -> coverage_basis

union coverage_pillar =
    | WorkspacePillar
    | PublicPillar
    | SmokePillar

union coverage_pillar_observation =
    | CoveragePillarObservation :: coverage_scope * coverage_pillar * u32 * u32 * u32 -> coverage_pillar_observation

union coverage_owner_observation =
    | CoverageOwnerObservation :: string * u32 * u32 * string -> coverage_owner_observation

union coverage_refresh_outcome =
    | CoverageRefreshImproved :: u32 * u32 -> coverage_refresh_outcome
    | CoverageRefreshRegressed :: u32 * u32 -> coverage_refresh_outcome
    | CoverageRefreshUnchanged :: u32 -> coverage_refresh_outcome
    | CoverageRefreshRebased :: coverage_scope * u32 * coverage_scope * u32 -> coverage_refresh_outcome

union coverage_refresh_state =
    | CoverageRefreshComparable :: coverage_basis * coverage_pillar_observation * coverage_pillar_observation * coverage_pillar_observation * coverage_owner_observation * u32 * u32 * string * coverage_refresh_outcome -> coverage_refresh_state

union coverage_refresh_pending =
    | CoverageRefreshPending :: coverage_scope * u32 * u32 * u32 * string -> coverage_refresh_pending

inl historical_mixed_basis () : coverage_basis =
    CoverageBasis (ProductAndVendor, 27063u32, 197u32, 122u32, 134u32)

inl current_author_basis () : coverage_basis =
    CoverageBasis (AuthorProductOnly, 17303u32, 201u32, 122u32, 132u32)

inl post_prune_refresh_pending () : coverage_refresh_pending =
    CoverageRefreshPending (AuthorProductOnly, 17219u32, 399u32, 359u32, "fresh alpha replay now completes the workspace shard with two-hundred-one profiles and workspace attainment three-hundred-ninety-nine, proving that the eighteen-line denominator difference is not caused by the earlier timeout; binary-install release-closeout coverage-union handoff validators bundle check create-flat verify-flat rehydrate and retention rejection routes extend the same seventeen-thousand-two-hundred-nineteen-line fresh source union from seven-hundred-fifty-two to seven-hundred-sixty-eight with sha e90108cdf8741ed8af64882e8054792b0e372c723665f1d5fdd6f0c52671f359; an owner-only coverage-prune experiment expands the denominator to seventeen-thousand-two-hundred-sixty-six and is therefore explicitly excluded; canonical CoverageAttainment seven-hundred-seventy-eight on seventeen-thousand-two-hundred-thirty-seven remains unchanged with zero credit until the source-universe discrepancy is reconciled")

