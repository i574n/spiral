union fallback_gap =
    | NonZipExtraction
    | DestructiveIncidentRecovery
    | GenericCargoResume
    | ExternalPayloadLifecycle

union fallback_proof =
    | NonZipTarBzip2Proof :: u32 -> fallback_proof
    | IncidentSnapshotRestoreProof :: bool * bool -> fallback_proof
    | CargoReceiptResumeProof :: bool * bool -> fallback_proof
    | ExternalPayloadRoundTripProof :: u32 * bool -> fallback_proof

union fallback_gap_state =
    | FallbackGapSettled :: fallback_gap * fallback_proof -> fallback_gap_state

inl non_zip_extraction () : fallback_gap_state =
    FallbackGapSettled (NonZipExtraction, NonZipTarBzip2Proof 9780200u32)

inl destructive_incident_recovery () : fallback_gap_state =
    FallbackGapSettled (DestructiveIncidentRecovery, IncidentSnapshotRestoreProof (true, true))

inl generic_cargo_resume () : fallback_gap_state =
    FallbackGapSettled (GenericCargoResume, CargoReceiptResumeProof (true, false))

inl external_payload_lifecycle () : fallback_gap_state =
    FallbackGapSettled (ExternalPayloadLifecycle, ExternalPayloadRoundTripProof (16u32, true))

union cold_cutover_proof =
    | ExclusiveColdCutoverProof :: bool * bool * bool * bool -> cold_cutover_proof

inl exclusive_cold_cutover () : cold_cutover_proof =
    ExclusiveColdCutoverProof (true, true, true, true)

union retirement_basis =
    | CapabilityCompleteRetirement :: u32 * u32 * u32 * u32 * cold_cutover_proof -> retirement_basis

inl retirement_basis () : retirement_basis =
    CapabilityCompleteRetirement (36u32, 36u32, 34u32, 2u32, exclusive_cold_cutover ())

inl coverage_quality_checkpoint () : u32 * u32 = 804u32, 900u32

inl authority () : authority_state_domain.formal_authority_state =
    authority_state_domain.current_formal_authority ()

inl operational_replacement_ready () : bool =
    authority_state_domain.operational_replacement_ready ()

inl legacy_fallback_execution_allowed () : bool =
    authority_state_domain.legacy_fallback_execution_allowed ()

inl historical_oracle_policy () : string =
    "alpha834-and-alpha9252-are-immutable-historical-oracles-by-hash;they-are-not-PATH-authority-and-must-not-be-used-as-automatic-fallbacks;formal-exclusive-authority-remains-blocked-by-the-shared-AuthorityState"

inl main () : i32 =
    inl _ = authority ()
    inl _ = retirement_basis ()
    0i32
