union handoff_section =
    | HandoffSection :: string * string -> handoff_section

inl formal_authority () : authority_state_domain.formal_authority_state = authority_state_domain.current_formal_authority ()
inl formal_authority_blocker_mask () : i32 = authority_state_domain.current_formal_blocker_mask ()

inl identity () = HandoffSection ("Identity", "The legacy migration and absorption campaigns remain settled historical evidence. Operational replacement of the old implementations is retained as a proven lineage fact; the old bundles remain immutable historical oracles rather than runtime fallbacks. Volatile readiness, compiler identity and source census values are intentionally absent from this narrative and are rendered from their current typed authorities by agile handoff.")
inl authority () = HandoffSection ("Authority", "One compiled authority_state_domain owns the distinction between operational replacement and formal authority and is consumed by status, dogfood, fallback retirement, handoff and Agile. Semantic closeout, cold proof, differential catalog, family contracts and public cold rebuild remain the fail-closed authority surfaces. The live handoff projection reports the current compiled authority and blocker mask instead of copying them into prose.")
inl census () = HandoffSection ("Physical census", "source-topology is the physical count authority and atomically materializes state/authority_census.spi. The handoff renderer reads that current ten-field census directly, so source counts, rust_global debt, package topology and local density ceilings are not duplicated here.")
inl workflow () = HandoffSection ("Workflow", "The typed lease grants seventy-five minutes of semantic work plus a ten-minute closeout guard. At should_wrap, ordinary mutating verbs are rejected before their first mutation while inspection and wrap surfaces remain available; should_yield is reserved for the eighty-five-minute hard deadline. Cargo remains fail-closed against bundled vendor offline and the shared target remains outside versioned bundles.")
inl verification () = HandoffSection ("Verification", "Verification claims must come from current executable gates and evidence rather than remembered prose. The live projection reads ColdProof status, replay flags, promoted binary identity and Spiral compiler identity from their typed state modules. Source changes must regenerate their owners and renew the relevant Cargo, contract, Clippy, evidence, cold-source and cold-release gates before strict publication.")
inl scores () = HandoffSection ("Scores", "Current active readiness, subjective ceiling, coverage, Runtime Drift, Parallel Readiness, Canonical Plan IR and historical migration values are rendered directly from state/ratings.spi. Historical migration and legacy absorption evidence must not be read as current product readiness, and zero-credit autonomous fronts remain zero until physically implemented.")
inl roadmap () = HandoffSection ("Roadmap", "Do not copy a percentage or compiler mismatch into handoff prose. The renderer derives the active and blocked queue directly from state/agile.spi, while ratings carries the current weighted denominator. Prefer semantic Runtime Drift and executor-side Plan IR work before opening governance-only fronts; autonomous journal, agent, sensor, causal-delta and onboarding work earns credit only when executable.")
inl resume () = HandoffSection ("Resume", "Start with the typed lease and live status, then follow the Active work queue printed by agile handoff. Preserve descriptor-relative filesystem authority, offline vendor, ColdProof, differential and family drift fixtures, package-only reuse and the one-thousand-line local density gates. Never edit generated Rust by hand; when a Spiral source changes, regenerate the owning residual and renew evidence before strict release.")

inl main () : i32 = 0i32
