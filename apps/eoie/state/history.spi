union series_record =
    | SeriesRecord :: u32 * u32 * u32 * string * string * u64 * string * string * u64 * string -> series_record

inl history_series_plan () = state_series_contract.model.append_only_series_plan ()

union retired_state_slice =
    | RetiredStateSlice :: string * u32 * string * string -> retired_state_slice
union turn_release_mode = | ExperimentalRelease | SettledRelease
union turn_smoke_evidence = | TurnSmokeEvidence :: u32 * u32 * bool * bool * bool * string -> turn_smoke_evidence
union turn_compiler_evidence = | TurnCompilerEvidence :: bool * bool * bool * string -> turn_compiler_evidence
union turn_gate_evidence = | TurnGateEvidence :: bool * bool * u32 * u32 * bool * bool * bool -> turn_gate_evidence
union turn_release_evidence = | TurnReleaseEvidence :: turn_release_mode * string * string -> turn_release_evidence
union turn_source_stats_evidence = | TurnSourceStatsEvidence :: u32 * u32 * u32 * u32 * u32 * u32 * u32 * u32 -> turn_source_stats_evidence
union turn_bundle_evidence = | TurnBundleEvidence :: bool * bool * bool * string -> turn_bundle_evidence
union turn_snapshot = | TurnSnapshot :: turn_smoke_evidence * turn_compiler_evidence * turn_gate_evidence * turn_release_evidence * turn_source_stats_evidence * turn_bundle_evidence -> turn_snapshot

inl compiler_and_facade () = RetiredStateSlice ("compiler-and-facade", 10u32, "compiler-facade-era", "backend patches facade lint runtime rename program repair and Fsharp shard evidence were executed and superseded")
inl process_and_checkpoint () = RetiredStateSlice ("process-and-checkpoint", 10u32, "process-checkpoint-era", "process observation checkpoint and state patch plans were consumed into settled process packages and receipts")
inl deterministic_bundle () = RetiredStateSlice ("deterministic-bundle", 10u32, "deterministic-bundle-era", "manifest writer parity archive terminal fixes score repairs and evidence were absorbed into bundle lifecycle owners")
inl settlement_and_receipts () = RetiredStateSlice ("settlement-and-receipts", 10u32, "settlement-receipt-era", "semantic state and receipt patches for process rooted filesystem and selective receipts were consumed")
inl legacy_and_deflate () = RetiredStateSlice ("legacy-and-deflate", 4u32, "legacy-deflate-era", "legacy absorption archive Deflate integration and CLI dependency plans were consumed")
inl burnin_transaction_artifacts () = RetiredStateSlice ("burnin-transaction-artifacts", 8u32, "transaction-burnin-era", "multi-file multi-hunk and multi-crate apply restore and negative plans were consumed into burnin_receipts after hot and cold replay; executable plan modules were deleted to restore state headroom")

inl previous_two () : turn_snapshot =
    TurnSnapshot (
        TurnSmokeEvidence (67u32, 6u32, true, true, true, "workspace tests fourteen session-isolated public contracts release build six positive plus negative Spiral-only settlements and public bundle verify create plus rehydrate pass under narrow partial authority"),
        TurnCompilerEvidence (true, true, true, "compiler v183 regenerates shared bundle-verification consumers bundle lifecycle bundle owner bootstrap policy and public CLI without manual Rust edits"),
        TurnGateEvidence (true, true, 67u32, 87u32, true, true, true),
        TurnReleaseEvidence (ExperimentalRelease, "the sixth Spiral-only unit is consumed by public bundle verify while global candidate-primary authority remains paused", "settled V2 migration is eighty-seven of one thousand with six of sixty-nine units; twenty-one V1 units remain preserved historical settlement"),
        TurnSourceStatsEvidence (9264u32, 20705u32, 29969u32, 1109u32, 530u32, 461u32, 67u32, 884u32),
        TurnBundleEvidence (true, true, true, "flat bundle carries six package-only Spiral domains one public binary no target cache and requires cold recompilation valid plus corrupt verification and session-isolated contracts before extending partial authority")
    )

inl previous () : turn_snapshot =
    TurnSnapshot (
        TurnSmokeEvidence (67u32, 7u32, true, true, true, "workspace tests fourteen session-isolated public contracts release build seven positive plus negative Spiral-only settlements and public bundle check verify create plus rehydrate pass under narrow partial authority"),
        TurnCompilerEvidence (true, true, true, "compiler v183 regenerates the shared manifest contract two independent mains bundle manifest owner bundle check owner bootstrap policy and public CLI without manual Rust edits"),
        TurnGateEvidence (true, true, 67u32, 101u32, true, true, true),
        TurnReleaseEvidence (ExperimentalRelease, "the seventh Spiral-only unit is consumed by public bundle check and extends candidate authority only to manifest count and fingerprint stability while global candidate-primary authority remains paused", "settled V2 migration is one hundred one of one thousand with seven of sixty-nine units; twenty-one V1 units remain preserved historical settlement"),
        TurnSourceStatsEvidence (9258u32, 20668u32, 29926u32, 1105u32, 530u32, 471u32, 67u32, 884u32),
        TurnBundleEvidence (true, true, true, "flat bundle carries seven package-only Spiral domains one public binary no target cache and requires cold recompilation manifest parity drift rejection and session-isolated contracts before extending partial authority")
    )

inl current () : turn_snapshot =
    TurnSnapshot (
        TurnSmokeEvidence (67u32, 14u32, true, true, true, "workspace Rust tests fourteen public contracts one-hundred-twenty-one instrumented smoke phases release build fourteen Spiral-only settlements fresh source-topology and proxy-search owner shards plus the existing narrow partial routes pass"),
        TurnCompilerEvidence (true, true, true, "compiler v183 regenerates the coverage smoke owner bootstrap policy and public CLI without manual Rust edits while release instrumentation exports deterministic LCOV receipts"),
        TurnGateEvidence (true, true, 67u32, 203u32, true, true, true),
        TurnReleaseEvidence (ExperimentalRelease, "the fourteenth Spiral-only unit reactivates fresh public smoke and owner coverage evidence while global candidate-primary authority remains paused below unchanged floors", "settled V2 migration is two hundred three of one thousand with fourteen of sixty-nine units; twenty-one V1 units remain preserved historical settlement"),
        TurnSourceStatsEvidence (10180u32, 22343u32, 32523u32, 1106u32, 530u32, 517u32, 67u32, 930u32),
        TurnBundleEvidence (true, true, true, "flat bundle carries fourteen settled V2 units one hundred one source-topology packages plus one hundred five map roots one public binary no target cache and requires cold replay of the four-input coverage union exact serial-parallel search and manifest parity stable tags topology limits and session-isolated contracts before extending partial authority")
    )

