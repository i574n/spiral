inl retired_module_count () : u32 = 55u32
inl live_turn_module_count () : u32 = 1u32
inl freed_state_slots () : u32 = 11u32
inl retention_rule () : string = "keep three typed turn snapshots plus append-only tagged rating and benchmark series records in one module; compact consumed executable proof plans into typed receipt summaries before deleting their standalone modules"
inl main () : i32 = 0i32
