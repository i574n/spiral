union patch_exact = | PatchExact :: string * string * string -> patch_exact

inl package_contract () : patch_exact = PatchExact ("src/eoie_release_hygiene/package.spiproj", "modules:\n    hygiene_policy\n    hygiene_terminal\n    runtime_guard\n    main", "packages:\n    incident_recovery_contract\nmodules:\n    hygiene_policy\n    hygiene_terminal\n    incident_recovery_terminal\n    runtime_guard\n    main")

inl cargo_dependencies () : patch_exact = PatchExact ("src/eoie_release_hygiene/Cargo.toml", "path = \"hygiene.rs\"\n\n[[example]]", "path = \"hygiene.rs\"\n\n[dependencies]\nlegacy-capability-domain = { path = \"../legacy_capability_domain\" }\neoie-proxy-search = { path = \"../eoie_proxy_search\" }\neoie-rust-std-fs = { path = \"../rust_std_fs\" }\n\n[[example]]")

inl main_imports () : patch_exact = PatchExact ("src/eoie_release_hygiene/main.spi", "open hygiene_terminal\nopen runtime_guard", "open hygiene_terminal\nopen incident_recovery_contract.model\nopen incident_recovery_terminal\nopen runtime_guard")

inl main_plan () : patch_exact = PatchExact ("src/eoie_release_hygiene/main.spi", "    inl _ = hygiene_secondary_binding 0i32 1i32\n    rust_global", "    inl _ = hygiene_secondary_binding 0i32 1i32\n    inl _ = incident_recovery_complete_plan ()\n    inl _ = incident_recovery_scope_binding 1i32 1i32 1i32 1i32\n    inl _ = incident_recovery_leaf_binding 1i32 1i32\n    inl _ = incident_recovery_snapshot_binding 1i32 1i32 1i32 1i32\n    inl _ = incident_recovery_restore_binding 1i32 1i32 1i32 1i32\n    inl _ = incident_recovery_fault_binding 1i32 1i32\n    inl _ = incident_recovery_rollback_binding 1i32 1i32 1i32\n    inl _ = incident_recovery_completion_binding 1i32 1i32 1i32\n    rust_global")

inl main_runtime () : patch_exact = PatchExact ("src/eoie_release_hygiene/main.spi", "    hygiene_terminal.emit_runtime ()\n    runtime_guard.emit_runtime ()", "    hygiene_terminal.emit_runtime ()\n    incident_recovery_terminal.emit_runtime ()\n    runtime_guard.emit_runtime ()")

inl main_exports () : patch_exact = PatchExact ("src/eoie_release_hygiene/main.spi", "    $\"RustExportI32Binary(\\\"eoie_hygiene_secondary_binding\\\",\\\"hygiene_secondary_binding\\\")\" : ()", "    $\"RustExportI32Binary(\\\"eoie_hygiene_secondary_binding\\\",\\\"hygiene_secondary_binding\\\")\" : ()\n    $\"RustExportI32Quaternary(\\\"eoie_incident_recovery_scope_binding\\\",\\\"incident_recovery_scope_binding\\\")\" : ()\n    $\"RustExportI32Binary(\\\"eoie_incident_recovery_leaf_binding\\\",\\\"incident_recovery_leaf_binding\\\")\" : ()\n    $\"RustExportI32Quaternary(\\\"eoie_incident_recovery_snapshot_binding\\\",\\\"incident_recovery_snapshot_binding\\\")\" : ()\n    $\"RustExportI32Quaternary(\\\"eoie_incident_recovery_restore_binding\\\",\\\"incident_recovery_restore_binding\\\")\" : ()\n    $\"RustExportI32Binary(\\\"eoie_incident_recovery_fault_binding\\\",\\\"incident_recovery_fault_binding\\\")\" : ()\n    $\"RustExportI32Ternary(\\\"eoie_incident_recovery_rollback_binding\\\",\\\"incident_recovery_rollback_binding\\\")\" : ()\n    $\"RustExportI32Ternary(\\\"eoie_incident_recovery_completion_binding\\\",\\\"incident_recovery_completion_binding\\\")\" : ()")

inl cli_usage () : patch_exact = PatchExact ("src/eoie_cli/routing_terminal.spi", "prune-build-cache|prune-compiler-sidecars|differential-compare", "prune-build-cache|prune-compiler-sidecars|incident-recovery|differential-compare")

inl cli_route () : patch_exact = PatchExact ("src/eoie_cli/routing_terminal.spi", "        Some(\"prune-compiler-sidecars\") => eoie_proxy_result(eoie_release_hygiene::prune_compiler_sidecars(&args)),", "        Some(\"prune-compiler-sidecars\") => eoie_proxy_result(eoie_release_hygiene::prune_compiler_sidecars(&args)),\n        Some(\"incident-recovery\") => eoie_proxy_result(eoie_release_hygiene::incident_recovery_run(&args)),")

union incident_recovery_evidence =
    | IndexedRecoveryPlan
    | SnapshotHashParity
    | QuarantineRollbackExact
    | PromotionRollbackExact
    | AbsentTargetRestored
    | PublicRecoveryRoute

union incident_recovery_settlement =
    | IncidentRecoverySettlement :: u32 * u32 * u32 * incident_recovery_evidence * incident_recovery_evidence * incident_recovery_evidence * incident_recovery_evidence * incident_recovery_evidence * incident_recovery_evidence -> incident_recovery_settlement

inl current_incident_recovery_settlement () : incident_recovery_settlement =
    IncidentRecoverySettlement (31u32, 69u32, 446u32, IndexedRecoveryPlan, SnapshotHashParity, QuarantineRollbackExact, PromotionRollbackExact, AbsentTargetRestored, PublicRecoveryRoute)

inl main () : i32 = 0i32
