union legacy_origin =
    | LegacyCpp :: legacy_origin
    | LegacyRustMonolith :: legacy_origin
    | LegacyRustModular :: legacy_origin

union legacy_disposition =
    | Absorbed :: legacy_disposition
    | DeliberatelyPruned :: legacy_disposition
    | Deferred :: legacy_disposition
    | NeedsEvidence :: legacy_disposition

union legacy_risk =
    | LowRisk :: legacy_risk
    | MediumRisk :: legacy_risk
    | HighRisk :: legacy_risk

union legacy_capability_family =
    | CapabilityFamily :: string * legacy_origin * legacy_disposition * legacy_risk * string * string -> legacy_capability_family

union legacy_decision_kind =
    | PortNow :: legacy_decision_kind
    | PortAfterEvidence :: legacy_decision_kind
    | PruneNow :: legacy_decision_kind
    | KeepFallback :: legacy_decision_kind

union legacy_decision =
    | LegacyDecision :: string * legacy_decision_kind * string * string -> legacy_decision

