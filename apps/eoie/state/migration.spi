union migration_item =
    | LegacyItem :: string * string * u32 -> migration_item
    | PendingExperiment :: string * u32 * string -> migration_item
    | SpiralExperiment :: string * u32 * string -> migration_item
    | RecoveredPrototype :: string * u32 * string -> migration_item
    | RecoveredFoundationEvidence :: string * u32 * string -> migration_item
    | BlockedExperiment :: string * u32 * string -> migration_item
    | MigrationEvidence :: string * u32 * string -> migration_item


union migration_segment =
    | MigrationSegment :: string * u32 * u32 * string -> migration_segment

union migration_denominator =
    | MigrationDenominator :: u32 * u32 * u32 * u32 * string -> migration_denominator

inl patch_segment () : migration_segment = MigrationSegment ("patch", 12u32, 12u32, "read-only patch preflight transactional source authoring multi-file transaction specification typed batch create-replace authoring validate witnesses fingerprints ordered operations rooted paths preview staging freshness post-verification stale rejection total rollback postgate rollback after all promotions successful promote-restore-verify rehearsal bounded executable postgate composition semantic verification across control effect driver orchestration fallback and patch-source-adapter missing-root plus resume bindings are Spiral-authored and physically proved through package-only Spiral replay directed contracts global vendored Cargo gates and public candidate replay; all patch slots are now settled")
