nominal baseline_ready = ()
nominal patched_ready = ()
nominal cold_ready = ()

union baseline_route =
    | UpstreamV50Route :: baseline_route
    | PatchedV51Route :: baseline_route
    | ColdV51Route :: baseline_route

union baseline_status =
    | DiffRecorded :: baseline_status
    | ByteMatched :: baseline_status
    | NativePassed :: baseline_status
    | CleanOfBusinessLogic :: baseline_status

union baseline_receipt =
    | BaselineReceipt :: string * baseline_route * baseline_status * i32 * string -> baseline_receipt

inl source_diff () : baseline_receipt = BaselineReceipt ("portable-backends-v50-v51", PatchedV51Route, DiffRecorded, 118i32, "reports/v50-to-v51-portable-backends.patch")
inl target_globals () : baseline_receipt = BaselineReceipt ("rust-target-globals", PatchedV51Route, ByteMatched, 259i32, "golden-identical")
inl library_mode () : baseline_receipt = BaselineReceipt ("rust-library-mode", PatchedV51Route, NativePassed, 1i32, "rustc-test-deny-warnings")
inl clean_source () : baseline_receipt = BaselineReceipt ("compiler-business-logic-scan", ColdV51Route, CleanOfBusinessLogic, 0i32, "zero-Eoie-symbols-in-compiler-source")

inl main () : i32 = 0i32