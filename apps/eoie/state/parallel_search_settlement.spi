union patch_exact = | PatchExact :: string * string * string -> patch_exact

inl migration_proxy () : patch_exact = PatchExact ("state/migration.spi", "MigrationSegment (\"proxy\", 21u32, 7u32, \"exact filesystem roundtrip copy move source topology source map diff deterministic mnemonic path tags and direct-route dogfood shims satisfy the Spiral-only settlement standard; fourteen recovered slots remain evidence only\")", "MigrationSegment (\"proxy\", 21u32, 8u32, \"exact filesystem roundtrip copy move source topology source map diff deterministic mnemonic path tags direct-route dogfood shims and deterministic Rayon search plus manifest satisfy the Spiral-only settlement standard; thirteen recovered slots remain evidence only\")")

inl migration_denominator () : patch_exact = PatchExact ("state/migration.spi", "MigrationDenominator (69u32, 12u32, 57u32, 173u32, \"twelve of sixty-nine capability-equivalent slots satisfy the Spiral-only bootstrap settlement standard; twenty-one cold-proven v1 capabilities remain versioned historical settlement rather than erased evidence\")", "MigrationDenominator (69u32, 13u32, 56u32, 188u32, \"thirteen of sixty-nine capability-equivalent slots satisfy the Spiral-only bootstrap settlement standard; twenty-one cold-proven v1 capabilities remain versioned historical settlement rather than erased evidence\")")

inl consolidation_current () : patch_exact = PatchExact ("state/consolidation.spi", "SettlementRecord (\"spiral-only-current\", SettlementV2SpiralOnly, 12u32, 173u32, \"roundtrip copy move directory bundle output bundle verification manifest stability source topology source map diff mnemonic path tags append-only typed rating plus benchmark history and direct-route dogfood shims satisfy Spiral-authored positive negative physical rollback and cold replay gates; bundle has four partial routes proxy has four partial authority families and agile record has narrow authority\")", "SettlementRecord (\"spiral-only-current\", SettlementV2SpiralOnly, 13u32, 188u32, \"roundtrip copy move directory bundle output bundle verification manifest stability source topology source map diff mnemonic path tags append-only typed rating plus benchmark history direct-route dogfood shims and deterministic Rayon search plus manifest satisfy Spiral-authored positive negative physical parity and cold replay gates; bundle has four partial routes proxy has five partial authority families and agile record has narrow authority\")")

inl bootstrap_counts () : patch_exact = PatchExact ("src/bootstrap_policy/model.spi", "inl settled_migration_score_0_1000 () : u32 = 173u32\ninl settled_migration_status_code () : i32 = 173i32\ninl migration_total_capability_equivalents () : u32 = 69u32\ninl migration_settled_capability_equivalents () : u32 = 12u32\ninl migration_remaining_capability_equivalents () : u32 = 57u32", "inl settled_migration_score_0_1000 () : u32 = 188u32\ninl settled_migration_status_code () : i32 = 188i32\ninl migration_total_capability_equivalents () : u32 = 69u32\ninl migration_settled_capability_equivalents () : u32 = 13u32\ninl migration_remaining_capability_equivalents () : u32 = 56u32")

inl bench_settlement () : patch_exact = PatchExact ("state/bench.spi", "inl settled_migration () = BenchCase (\"twelve-consecutive-post-rebaseline-alphas-settle-roundtrip-copy-move-directory-bundle-output-verification-manifest-stability-source-topology-source-map-diff-mnemonic-path-tags-typed-series-and-dogfood-shims-as-twelve-of-sixty-nine-units\", TypecheckBench, BenchPassed, 173u32)", "inl settled_migration () = BenchCase (\"thirteen-consecutive-post-rebaseline-alphas-settle-roundtrip-copy-move-directory-bundle-output-verification-manifest-stability-source-topology-source-map-diff-mnemonic-path-tags-typed-series-dogfood-shims-and-parallel-search-manifest-as-thirteen-of-sixty-nine-units\", TypecheckBench, BenchPassed, 188u32)")

inl history_smoke () : patch_exact = PatchExact ("state/history.spi", "TurnSmokeEvidence (67u32, 12u32, true, true, true, \"workspace Rust tests fourteen session-isolated public contracts release build twelve Spiral-only settlements public proxy source-topology source-stats tagged spi-map spi-diff agile record and dogfood shim pass under narrow partial authority\")", "TurnSmokeEvidence (67u32, 13u32, true, true, true, \"workspace Rust tests fourteen session-isolated public contracts release build thirteen Spiral-only settlements public proxy source-topology source-stats tagged spi-map spi-diff agile record dogfood shim parallel-search and parallel-manifest pass under narrow partial authority\")")

inl history_gate () : patch_exact = PatchExact ("state/history.spi", "TurnGateEvidence (true, true, 67u32, 173u32, true, true, true)", "TurnGateEvidence (true, true, 67u32, 188u32, true, true, true)")

inl history_bundle () : patch_exact = PatchExact ("state/history.spi", "TurnBundleEvidence (true, true, true, \"flat bundle carries twelve settled V2 units ninety-eight source-topology packages plus one hundred two map roots one public binary no target cache and requires cold recompilation shim block fallback uninstall rollback four append-only series records stable tags topology limits and session-isolated contracts before extending partial authority\")", "TurnBundleEvidence (true, true, true, \"flat bundle carries thirteen settled V2 units one hundred one source-topology packages plus one hundred five map roots one public binary no target cache and requires cold recompilation exact serial-parallel search and manifest parity stable tags topology limits and session-isolated contracts before extending partial authority\")")

inl catalog_search () : patch_exact = PatchExact ("state/legacy_catalog.spi", "CapabilityFamily (\"contextual-search-and-range-read\", LegacyRustMonolith, NeedsEvidence, MediumRisk, \"bounded slice deterministic search context tail recent files\", \"slice and deterministic parallel search are direct public routes; context tail recency and three shadow routes remain\")", "CapabilityFamily (\"contextual-search-and-range-read\", LegacyRustMonolith, Absorbed, MediumRisk, \"bounded slice deterministic search context tail recent files\", \"slice context deterministic tagged parallel search and deterministic parallel manifest are direct public routes; recency remains a separate future enhancement\")")

inl catalog_parallel () : patch_exact = PatchExact ("state/legacy_catalog.spi", "CapabilityFamily (\"parallel-work-items\", LegacyRustModular, NeedsEvidence, MediumRisk, \"rayon deterministic ordering context\", \"search and coverage use parallelism; broader work batching is pending\")", "CapabilityFamily (\"parallel-work-items\", LegacyRustModular, Absorbed, MediumRisk, \"rayon deterministic ordering context\", \"search manifest state checks and coverage use bounded parallelism with deterministic ordering and explicit serial parity\")")

inl main () : i32 = 0i32
