inl status_calibration () = PatchReceipt ("public-settled-migration-status", ProductSpiral, SpiralTypecheck, "status reports fifty-one remaining capability-equivalent units instead of recovered prototype score")
inl no_manual_rust () = PatchReceipt ("no-product-rust-authorship", BootstrapWorkflow, ExperimentReceipt, "new Rust mirrors are generated from Spiral by the patched EOIE compiler lineage")
inl patch_domain () = PatchReceipt ("typed-patch-transaction-domain", ProductSpiral, SpiralTypecheck, "indexed lifecycle definitions execute stage commit rollback and two fault routes from generated mains and are imported by the transaction owner")
