union patch_layer =
    | CompilerBackend :: patch_layer
    | ProductSpiral :: patch_layer
    | GeneratedRust :: patch_layer
    | TypedState :: patch_layer
    | BootstrapWorkflow :: patch_layer

union patch_proof =
    | CompilerBuild :: patch_proof
    | SpiralTypecheck :: patch_proof
    | CargoCheck :: patch_proof
    | CargoTest :: patch_proof
    | ClippyClean :: patch_proof
    | RustfmtStable :: patch_proof
    | ExperimentReceipt :: patch_proof

union patch_receipt =
    | PatchReceipt :: string * patch_layer * patch_proof * string -> patch_receipt

inl recovered_prototype () = PatchReceipt ("recovered-prototype-preserved", BootstrapWorkflow, ExperimentReceipt, "old behavior retained as quarry rather than settled authority")
inl migration_reset () = PatchReceipt ("settled-migration-reset", TypedState, SpiralTypecheck, "reported prototype score separated from settled migration score")
inl shared_domain () = PatchReceipt ("shared-spiral-domain-package", ProductSpiral, SpiralTypecheck, "one typed package imported by two application owners")
inl filesystem_roundtrip_settlement_receipt () = PatchReceipt ("filesystem-exact-roundtrip-two-mains", ProductSpiral, CargoTest, "indexed absent written verified and cleaned states drive positive and mismatch physical mains; both remove their files and no Rust source is authored")
inl bootstrap_probe () = PatchReceipt ("bootstrap-route-probe", GeneratedRust, CargoCheck, "Rust mirror regenerated from its main through the Spiral compiler")
inl policy_probe () = PatchReceipt ("authorship-policy-probe", GeneratedRust, CargoCheck, "escape hatch remains rejected by typed policy")
inl package_cache_green () = PatchReceipt ("nested-package-cache-green-receipt", CompilerBackend, ExperimentReceipt, "the same persistent lane observed dependency-change and emitted the updated dependent application")
