union patch_exact = | PatchExact :: string * string * string -> patch_exact
inl patch_topology_import () : patch_exact = PatchExact ("src/eoie_source_topology/terminal.spi", "rust_global \"use std::collections", "rust_global \"use eoie_proxy_search::mnemonic_path_tag;\\nuse std::collections")
inl patch_topology_tags () : patch_exact = PatchExact ("src/eoie_source_topology/terminal.spi", "for record in map.values() {\\n        cargo += usize::from(record.cargo);", "let mut tag_owners = BTreeMap::<String, String>::new();\\n    for record in map.values() {\\n        let tag = mnemonic_path_tag(&record.path)?;\\n        if let Some(previous) = tag_owners.insert(tag.clone(), record.path.clone()) {\\n            if eoie_proxy_search::eoie_proxy_search_proxy_path_tag_collision_binding(1, i32::from(previous == record.path)) != 1 { return Err(format!(\\\"path-tag collision tag={} first={} second={}\\\", tag, previous, record.path)); }\\n        }\\n        println!(\\\"source-tag path={} tag={}\\\", record.path, tag);\\n        cargo += usize::from(record.cargo);")
inl main () : i32 = 0i32
