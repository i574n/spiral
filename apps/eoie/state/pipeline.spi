// Canonical direct-backend pipeline for this container.
nominal source_ready = ()
nominal source_typed = ()
nominal portable_c_ready = ()
nominal rust_emitted = ()
nominal native_proven = ()
nominal compared = ()

union pipeline_route =
    | UpstreamV50 :: pipeline_route
    | PatchedDirectRust :: pipeline_route
    | ColdBundle :: pipeline_route

union pipeline_phase =
    | Typecheck :: pipeline_phase
    | EmitPortableC :: pipeline_phase
    | LowerDirectRust :: pipeline_phase
    | FormatRust :: pipeline_phase
    | RustcDenyWarnings :: pipeline_phase
    | CargoCheck :: pipeline_phase
    | CargoTest :: pipeline_phase
    | GoldenCompare :: pipeline_phase
    | ColdCompile :: pipeline_phase

union evidence_kind =
    | SourceHash :: evidence_kind
    | RustHash :: evidence_kind
    | NativeExit :: evidence_kind
    | CargoReceipt :: evidence_kind
    | CleanSourceScan :: evidence_kind

union pipeline_step from to result =
    | InferTypes :: pipeline_route -> pipeline_step source_ready source_typed string
    | EmitAuthorityC :: pipeline_route -> pipeline_step source_typed portable_c_ready string
    | LowerRust :: pipeline_route -> pipeline_step portable_c_ready rust_emitted string
    | ProveNative :: pipeline_route -> pipeline_step rust_emitted native_proven string
    | CompareRelease :: evidence_kind * evidence_kind -> pipeline_step native_proven compared bool

union rec pipeline_plan from to =
    | PipelineStep :: forall from to. (exists result. pipeline_step from to result * result) -> pipeline_plan from to
    | PipelineThen :: forall from to. (exists middle. pipeline_plan from middle * pipeline_plan middle to) -> pipeline_plan from to

inl direct_plan () : pipeline_plan source_ready native_proven =
    PipelineThen (exists (
        PipelineStep (exists (InferTypes PatchedDirectRust, "typed")),
        PipelineThen (exists (
            PipelineStep (exists (EmitAuthorityC PatchedDirectRust, "portable-c")),
            PipelineThen (exists (
                PipelineStep (exists (LowerRust PatchedDirectRust, "rust")),
                PipelineStep (exists (ProveNative PatchedDirectRust, "rustc-cargo-proven"))
            ))
        ))
    ))

inl cold_plan () : pipeline_plan source_ready compared =
    PipelineThen (exists (
        direct_plan (),
        PipelineStep (exists (CompareRelease (RustHash, CleanSourceScan), true))
    ))

inl main () : i32 = 0i32