union rating_key =
    | TurnFruitfulness
    | TurnSatisfaction
    | EoieSota
    | ProjectSota
    | RecoveredPrototypeMaturity
    | SettledRewriteMaturity
    | MigrationCompleteness
    | WorkflowPrecision
    | SpiralAuthority
    | ParallelReadiness
    | VerificationMachinery
    | VerificationAttainment
    | CoverageAttainment
    | HandoffContinuity
    | LegacyCatalogCompleteness
    | LegacyAbsorptionMaturity
    | ToolchainResilience
    | RuntimeDriftVisibility
    | ConsolidationDefinitionStability
    | StateHygiene

union rating_role =
    | ActiveSignal
    | HistoricalEvidence
    | ObjectiveDenominator

union rating =
    | Rating :: rating_key * u32 * i32 -> rating

inl role (key : rating_key) : rating_role =
    match key with
    | RecoveredPrototypeMaturity | SettledRewriteMaturity | MigrationCompleteness | LegacyCatalogCompleteness | LegacyAbsorptionMaturity => HistoricalEvidence
    | CoverageAttainment => ObjectiveDenominator
    | _ => ActiveSignal

inl contributes_to_active_progress (key : rating_key) : bool =
    match role key with
    | ActiveSignal => true
    | HistoricalEvidence | ObjectiveDenominator => false

union calibration_basis =
    | CalibrationBasis :: u32 * u32 * u32 * u32 * u32 * string -> calibration_basis

inl active_patch_attainment () : u32 = 700u32
inl active_coverage_attainment () : u32 = 804u32
inl active_four_pillar_readiness () : u32 = 550u32
inl active_codebase_readiness () : u32 = 550u32
inl next_phase_workstream_count () : u32 = 16u32
inl subjective_phase_ceiling () : u32 = 620u32
inl phase_entry_absolute_reference () : u32 = 475u32

union phase_dimension =
    | PhaseDimension :: string * u32 * u32 -> phase_dimension

inl phase_runtime_drift () : phase_dimension = PhaseDimension ("runtime-drift-burndown", 850u32, 12u32)
