inl main () : i32 =
    emit_plan_op (PatchExact ("src/state_receipt_codec_model/package.spiproj", "    common-\n    attestation-", "    common-\n    row_kind-\n    attestation-"))
    emit_plan_op (PatchExact ("src/agile_state_runtime_policy_domain/policy.spi", "union agile_receipt_row_kind =\n    | UnknownReceiptRow\n    | SnapshotReceiptRow\n    | ModuleReceiptRow\n\ninl agile_receipt_row_kind_code_value = function\n    | UnknownReceiptRow => 0u64\n    | SnapshotReceiptRow => 1u64\n    | ModuleReceiptRow => 2u64\n\ninl agile_receipt_row_kind_text_value = function\n    | UnknownReceiptRow => \"\"\n    | SnapshotReceiptRow => \"snapshot\"\n    | ModuleReceiptRow => \"module\"\n\nlet agile_receipt_row_kind_code (~kind : string) : u64 =\n    if rust_std_string.model.equals kind \"snapshot\" then agile_receipt_row_kind_code_value SnapshotReceiptRow\n    elif rust_std_string.model.equals kind \"module\" then agile_receipt_row_kind_code_value ModuleReceiptRow\n    else agile_receipt_row_kind_code_value UnknownReceiptRow\n\nlet agile_receipt_row_kind_text (~code : string) : string =\n    if rust_std_string.model.equals code \"1\" then agile_receipt_row_kind_text_value SnapshotReceiptRow\n    elif rust_std_string.model.equals code \"2\" then agile_receipt_row_kind_text_value ModuleReceiptRow\n    else agile_receipt_row_kind_text_value UnknownReceiptRow", "let agile_receipt_row_kind_code (~kind : string) : u64 =\n    receipt_row_kind_code kind\n\nlet agile_receipt_row_kind_text (~code : string) : string =\n    receipt_row_kind_text code"))
    emit_plan_op (PatchExact ("src/state_receipt_serializer_domain/model.spi", "    inl prefix = \"snapshot\\t\"", "    inl prefix = sm.concat (receipt_row_kind_text \"1\") \"\\t\""))
    emit_plan_op (PatchExact ("src/state_receipt_serializer_domain/model.spi", "    inl prefix = \"module\\t\"", "    inl prefix = sm.concat (receipt_row_kind_text \"2\") \"\\t\""))
    emit_plan_op (PatchExact ("src/state_receipt_serializer_domain/model.spi", "        inl is_snapshot = starts_with_at line 0i32 \"snapshot\\t\"\n        inl is_module = starts_with_at line 0i32 \"module\\t\"", "        inl snapshot_prefix = sm.concat (receipt_row_kind_text \"1\") \"\\t\"\n        inl module_prefix = sm.concat (receipt_row_kind_text \"2\") \"\\t\"\n        inl is_snapshot = starts_with_at line 0i32 snapshot_prefix\n        inl is_module = starts_with_at line 0i32 module_prefix"))
    emit_plan_op (PatchExact ("src/agile_state_runtime_policy_domain/policy.spi", "    inl _ = agile_prompt_title_code \"alpha70456\"", "    inl _ = agile_prompt_title_code \"active-prompt\""))
    0i32
