union runtime_surface =
    | ExactRuntimeFile
    | AuxiliaryRuntimeFile

union runtime_debt =
    | ImportOnlyTerminal
    | LocalizedBridge
    | BroadRuntimeLogic
    | LegacyQuarryLogic

union rewrite_stage =
    | Inventoried
    | Ranked
    | FixtureReady
    | MappingActive
    | SharedByTwoMains
    | PillarIntegrated
    | Retired

union runtime_owner =
    | RuntimeOwner :: string * string * runtime_surface * runtime_debt * u32 * u32 * rewrite_stage * string -> runtime_owner

union runtime_inventory =
    | RuntimeInventory :: u32 * u32 * u32 * u32 -> runtime_inventory

union rust_global_baseline =
    | RustGlobalBaseline :: u32 * u32 * u32 * u32 * string -> rust_global_baseline

union experiment_result =
    | ExperimentPassed
    | ExperimentBlocked
    | ExperimentRejected

union runtime_experiment =
    | RuntimeExperiment :: string * experiment_result * string -> runtime_experiment

