nominal self_patch_idle = ()
nominal self_patch_paused = ()
nominal self_patch_mutated = ()
nominal self_patch_verified = ()
nominal self_patch_restored = ()
nominal self_patch_cold = ()

union self_patch_transition from to_ =
    | PauseSemanticWork :: self_patch_transition self_patch_idle self_patch_paused
    | ApplyVersionlessMutation :: self_patch_transition self_patch_paused self_patch_mutated
    | VerifyMutatedState :: self_patch_transition self_patch_mutated self_patch_verified
    | RestoreOriginalBytes :: self_patch_transition self_patch_verified self_patch_restored
    | ReplayFromFlatBundle :: self_patch_transition self_patch_restored self_patch_cold

union self_patch_failure =
    | ExpectedTextMissing
    | MutationHashUnchanged
    | RestorationHashMismatch
    | ResidualStageDetected
    | ColdReplayMismatch

union self_patch_receipt =
    | SelfPatchReceipt :: string * string * string * string * u32 * bool * bool * bool -> self_patch_receipt

inl warm_self_patch_receipt () : self_patch_receipt =
    SelfPatchReceipt (
        "state/oracle.spi",
        "5abd8b07ad6cbe16d908d482f9a797f2d244a5d2ec2b8c72e9cc1e998f65d2ba",
        "dead6a3aebe79fec4edf2b4c77510a163f61be0cd767d517a81994f6769f2222",
        "5abd8b07ad6cbe16d908d482f9a797f2d244a5d2ec2b8c72e9cc1e998f65d2ba",
        35u32,
        true,
        true,
        true
    )

inl negative_fixture () : self_patch_failure = ExpectedTextMissing
inl cold_replay_required () : bool = true
inl main () : i32 = 0i32
