union patch_exact = | PatchExact :: string * string * string -> patch_exact
inl history_types () : patch_exact = PatchExact ("state/history.spi", "union retired_state_slice =", "union series_record =\n    | SeriesRecord :: u32 * u32 * u32 * string * string * u64 * string * string * u64 * string -> series_record\n\ninl history_series_plan () = state_series_contract.model.append_only_series_plan ()\n\nunion retired_state_slice =")
inl mutation_usage () : patch_exact = PatchExact ("src/eoie_agile_mutation/agile_mutation.spi", "inl agile_usage_error () : i32 = $\"agile_mutation_error(\\\"agile supports begin <root> <title>, handoff <root>, list <root>, check <root>, set <root> <id> <progress> <Planned|Active|Blocked|Paused|Done>\\\")\"", "inl agile_usage_error () : i32 = $\"agile_mutation_error(\\\"agile supports begin <root> <title>, handoff <root>, list <root>, check <root>, record <root>, set <root> <id> <progress> <Planned|Active|Blocked|Paused|Done>\\\")\"")
inl mutation_record_function () : patch_exact = PatchExact ("src/eoie_agile_mutation/agile_mutation.spi", "inl agile_handoff (~root : string) : i32 = $\"handoff_render_owned(!root.as_ref())\"\ninl agile_begin", "inl agile_handoff (~root : string) : i32 = $\"handoff_render_owned(!root.as_ref())\"\ninl agile_record (~root : string) : i32 = $\"mutation_agile_record_owned(!root.as_ref())\"\ninl agile_begin")
inl mutation_record_route () : patch_exact = PatchExact ("src/eoie_agile_mutation/agile_mutation.spi", "elif argument_equals 0i32 \"handoff\" then agile_handoff root\n        else agile_usage_error ()", "elif argument_equals 0i32 \"handoff\" then agile_handoff root\n        elif argument_equals 0i32 \"record\" then agile_record root\n        else agile_usage_error ()")
inl cli_usage () : patch_exact = PatchExact ("src/eoie_cli/routing_terminal.spi", "agile: begin <root> <title> [--compiler <absolute>] | list <root> | check <root> | set <root> <id> <progress> <Planned|Active|Blocked|Paused|Done>", "agile: begin <root> <title> [--compiler <absolute>] | list <root> | check <root> | record <root> | set <root> <id> <progress> <Planned|Active|Blocked|Paused|Done>")
inl main () : i32 = 0i32
