union patch_exact = | PatchExact :: string * string * string -> patch_exact
inl consolidation_current () : patch_exact = PatchExact ("state/consolidation.spi", "SettlementRecord (\"spiral-only-current\", SettlementV2SpiralOnly, 10u32, 144u32, \"roundtrip copy move directory bundle output bundle verification manifest stability source topology source map diff and deterministic mnemonic path tags satisfy Spiral-authored two-main negative and cold replay gates; bundle has four partial routes and proxy has source-topology plus tagged source-map authority\")", "SettlementRecord (\"spiral-only-current\", SettlementV2SpiralOnly, 11u32, 159u32, \"roundtrip copy move directory bundle output bundle verification manifest stability source topology source map diff mnemonic path tags and append-only typed rating plus benchmark history satisfy Spiral-authored two-main negative and cold replay gates; bundle has four partial routes proxy has three partial authority families and agile record has narrow authority\")")
inl migration_agile_segment () : patch_exact = PatchExact ("state/migration.spi", "inl agile_segment () : migration_segment = MigrationSegment (\"agile\", 11u32, 0u32, \"recovered prototype evidence; no capability satisfies the new Spiral-only settlement standard\")", "inl agile_segment () : migration_segment = MigrationSegment (\"agile\", 11u32, 1u32, \"append-only typed rating and benchmark history is Spiral-authored consumed by public agile record and cold-replayed; ten recovered slots remain evidence only\")")
inl migration_denominator () : patch_exact = PatchExact ("state/migration.spi", "MigrationDenominator (69u32, 10u32, 59u32, 144u32, \"ten of sixty-nine capability-equivalent slots satisfy the Spiral-only bootstrap settlement standard; twenty-one cold-proven v1 capabilities remain versioned historical settlement rather than erased evidence\")", "MigrationDenominator (69u32, 11u32, 58u32, 159u32, \"eleven of sixty-nine capability-equivalent slots satisfy the Spiral-only bootstrap settlement standard; twenty-one cold-proven v1 capabilities remain versioned historical settlement rather than erased evidence\")")
inl migration_series_item () : patch_exact = PatchExact ("state/migration.spi", "inl mnemonic_path_tag_settlement () : migration_item = MigrationEvidence (\"mnemonic-three-word-path-tags-two-mains-and-public-source-map\", 100u32, \"one shared non-Cargo Spiral package models relative-path validation SHA256 first-eighteen-bit decoding three distinct sixty-four-word banks deterministic rendering and collision rejection; positive and negative mains pass while public spi-map assigns stable mnemonic tags without adding a Cargo crate\")", "inl mnemonic_path_tag_settlement () : migration_item = MigrationEvidence (\"mnemonic-three-word-path-tags-two-mains-and-public-source-map\", 100u32, \"one shared non-Cargo Spiral package models relative-path validation SHA256 first-eighteen-bit decoding three distinct sixty-four-word banks deterministic rendering and collision rejection; positive and negative mains pass while public spi-map assigns stable mnemonic tags without adding a Cargo crate\")\ninl typed_series_settlement () : migration_item = MigrationEvidence (\"typed-rating-benchmark-series-two-mains-and-public-agile-record\", 100u32, \"one shared non-Cargo Spiral package models validated sources append-only sequence monotonic settlement and fingerprint evidence; positive and negative mains pass while public agile record appends tagged canonical rating and benchmark snapshots then typechecks or rolls back\")")
inl migration_agile_pillar () : patch_exact = PatchExact ("state/migration.spi", "inl agile_pillar () : migration_item = SpiralExperiment (\"agile-control-pillar\", 8u32, \"list check begin and set now consume explicit owned arguments while lifecycle evidence remains shallow\")", "inl agile_pillar () : migration_item = SpiralExperiment (\"agile-control-pillar\", 18u32, \"list check begin set and append-only typed record consume explicit owned arguments while canonical rating and benchmark sources are fingerprinted tagged typechecked and rollback-safe\")")
inl bootstrap_score () : patch_exact = PatchExact ("src/bootstrap_policy/model.spi", "inl settled_migration_score_0_1000 () : u32 = 144u32", "inl settled_migration_score_0_1000 () : u32 = 159u32")
inl bench_lease () : patch_exact = PatchExact ("state/bench.spi", "inl session_lease_tail_regression () = BenchCase (\"current-agile-begin-rejects-a-valid-title-because-the-lease-owner-reads-the-wrong-tail-index-and-this-round-uses-manual-timing\", BootstrapBench, BenchFailed, 20u32)", "inl session_lease_tail_regression () = BenchCase (\"agile-begin-accepts-a-valid-multiword-title-through-the-canonical-v183-compiler-and-opens-the-fifty-minute-typed-lease\", BootstrapBench, BenchPassed, 100u32)")
inl bench_series () : patch_exact = PatchExact ("state/bench.spi", "inl mnemonic_path_tags () = BenchCase (\"shared-Spiral-path-tag-contract-positive-and-negative-mains-validate-relative-paths-decode-eighteen-SHA256-bits-select-three-sixty-four-word-banks-normalize-separators-and-public-spi-map-rejects-collisions\", RustEmitBench, BenchPassed, 100u32)", "inl mnemonic_path_tags () = BenchCase (\"shared-Spiral-path-tag-contract-positive-and-negative-mains-validate-relative-paths-decode-eighteen-SHA256-bits-select-three-sixty-four-word-banks-normalize-separators-and-public-spi-map-rejects-collisions\", RustEmitBench, BenchPassed, 100u32)\ninl typed_rating_benchmark_series () = BenchCase (\"shared-Spiral-series-contract-positive-and-negative-mains-prove-sequence-source-pair-monotonic-and-fingerprint-rules-while-public-agile-record-appends-tagged-canonical-snapshots-and-typechecks-or-rolls-back\", TypecheckBench, BenchPassed, 100u32)")
inl bench_settlement () : patch_exact = PatchExact ("state/bench.spi", "inl settled_migration () = BenchCase (\"ten-consecutive-post-rebaseline-alphas-settle-roundtrip-copy-move-directory-bundle-output-verification-manifest-stability-source-topology-source-map-diff-and-mnemonic-path-tags-as-ten-of-sixty-nine-units\", TypecheckBench, BenchPassed, 144u32)", "inl settled_migration () = BenchCase (\"eleven-consecutive-post-rebaseline-alphas-settle-roundtrip-copy-move-directory-bundle-output-verification-manifest-stability-source-topology-source-map-diff-mnemonic-path-tags-and-typed-rating-benchmark-series-as-eleven-of-sixty-nine-units\", TypecheckBench, BenchPassed, 159u32)")
inl bench_throughput () : patch_exact = PatchExact ("state/bench.spi", "inl settlement_throughput () = BenchCase (\"ten-v2-units-across-ten-consecutive-alphas-project-fifty-nine-further-alphas-at-one-unit-per-alpha\", TypecheckBench, BenchPassed, 100u32)", "inl settlement_throughput () = BenchCase (\"eleven-v2-units-across-eleven-consecutive-alphas-project-fifty-eight-further-alphas-at-one-unit-per-alpha\", TypecheckBench, BenchPassed, 100u32)")
inl handoff_contract () : patch_exact = PatchExact ("state/handoff.spi", "Settlement V2 contains ten of sixty-nine Spiral-only units and score one hundred forty-four.", "Settlement V2 contains eleven of sixty-nine Spiral-only units and score one hundred fifty-nine.")
inl handoff_scores () : patch_exact = PatchExact ("state/handoff.spi", "Settlement V2 is ten of sixty-nine units and score one hundred forty-four. The tenth unit adds no Cargo crate, reuses the proxy SHA256 boundary and extends the source map; fifty-nine units remain at unchanged denominator.", "Settlement V2 is eleven of sixty-nine units and score one hundred fifty-nine. The eleventh unit adds no Cargo crate, restores append-only typed rating and benchmark history through public agile record and leaves fifty-eight units at the unchanged denominator.")
inl main () : i32 = 0i32
