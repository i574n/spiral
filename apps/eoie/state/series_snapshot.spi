union patch_exact = | PatchExact :: string * string * string -> patch_exact
inl history_smoke () : patch_exact = PatchExact ("state/history.spi", "TurnSmokeEvidence (67u32, 10u32, true, true, true, \"eighty-five workspace Rust tests fourteen session-isolated public contracts release build ten Spiral-only settlements and public proxy source-topology source-stats tagged spi-map and spi-diff pass under narrow partial authority\")", "TurnSmokeEvidence (67u32, 11u32, true, true, true, \"workspace Rust tests fourteen session-isolated public contracts release build eleven Spiral-only settlements public proxy source-topology source-stats tagged spi-map spi-diff and public agile record pass under narrow partial authority\")")
inl history_compiler () : patch_exact = PatchExact ("state/history.spi", "TurnCompilerEvidence (true, true, true, \"compiler v183 regenerates the shared path-tag contract positive and negative mains proxy SHA256 bridge tagged source map bootstrap policy and public CLI without manual Rust edits\")", "TurnCompilerEvidence (true, true, true, \"compiler v183 regenerates the shared typed-series contract positive and negative mains Agile state mutation router bootstrap policy and public CLI without manual Rust edits\")")
inl history_gate () : patch_exact = PatchExact ("state/history.spi", "TurnGateEvidence (true, true, 67u32, 144u32, true, true, true)", "TurnGateEvidence (true, true, 67u32, 159u32, true, true, true)")
inl history_release () : patch_exact = PatchExact ("state/history.spi", "TurnReleaseEvidence (ExperimentalRelease, \"the tenth Spiral-only unit is consumed by public tagged spi-map while global candidate-primary authority remains paused\", \"settled V2 migration is one hundred forty-four of one thousand with ten of sixty-nine units; twenty-one V1 units remain preserved historical settlement\")", "TurnReleaseEvidence (ExperimentalRelease, \"the eleventh Spiral-only unit is consumed by public agile record while global candidate-primary authority remains paused\", \"settled V2 migration is one hundred fifty-nine of one thousand with eleven of sixty-nine units; twenty-one V1 units remain preserved historical settlement\")")
inl history_stats () : patch_exact = PatchExact ("state/history.spi", "TurnSourceStatsEvidence (9655u32, 21398u32, 31053u32, 1103u32, 530u32, 484u32, 67u32, 884u32)", "TurnSourceStatsEvidence (9806u32, 21222u32, 31028u32, 1106u32, 530u32, 490u32, 67u32, 884u32)")
inl history_bundle () : patch_exact = PatchExact ("state/history.spi", "TurnBundleEvidence (true, true, true, \"flat bundle carries ten settled V2 units ninety-two source-topology packages plus ninety-six map roots one public binary no target cache and requires cold recompilation stable mnemonic tags zero collisions exact three-added-four-changed diff topology limits and session-isolated contracts before extending partial authority\")", "TurnBundleEvidence (true, true, true, \"flat bundle carries eleven settled V2 units ninety-five source-topology packages plus ninety-nine map roots one public binary no target cache and requires cold recompilation two append-only series records stable source tags topology limits and session-isolated contracts before extending partial authority\")")
inl history_retention () : patch_exact = PatchExact ("state/history.spi", "inl retention_rule () : string = \"keep three typed turn snapshots in one module and compact older evidence into versionless historical slices\"", "inl retention_rule () : string = \"keep three typed turn snapshots plus append-only tagged rating and benchmark series records in one module and compact older narrative evidence into versionless historical slices\"")
inl main () : i32 = 0i32
