inl agile_shim_done () : patch_exact = PatchExact ("state/agile.spi", "Task (\"DOGFOOD-SHIM\", \"Restore wrappers that reject direct Python and shell routes when an EOIE primitive exists\", Story, P1, D7, 0u32, Planned, \"PROMOTION-CANDIDATE\", \"shim,dogfood,proxy\", \"future\", \"future\")", "Task (\"DOGFOOD-SHIM\", \"Restore wrappers that reject direct Python and shell routes when an EOIE primitive exists\", Story, P1, D7, 100u32, Done, \"PROMOTION-CANDIDATE\", \"shim,dogfood,proxy\", \"current\", \"settled\")")
