union patch_exact = | PatchExact :: string * string * string -> patch_exact
inl consolidation_current () : patch_exact = PatchExact ("state/consolidation.spi", "SettlementRecord (\"spiral-only-current\", SettlementV2SpiralOnly, 11u32, 159u32, \"roundtrip copy move directory bundle output bundle verification manifest stability source topology source map diff mnemonic path tags and append-only typed rating plus benchmark history satisfy Spiral-authored two-main negative and cold replay gates; bundle has four partial routes proxy has three partial authority families and agile record has narrow authority\")", "SettlementRecord (\"spiral-only-current\", SettlementV2SpiralOnly, 12u32, 173u32, \"roundtrip copy move directory bundle output bundle verification manifest stability source topology source map diff mnemonic path tags append-only typed rating plus benchmark history and direct-route dogfood shims satisfy Spiral-authored positive negative physical rollback and cold replay gates; bundle has four partial routes proxy has four partial authority families and agile record has narrow authority\")")
inl migration_proxy () : patch_exact = PatchExact ("state/migration.spi", "MigrationSegment (\"proxy\", 21u32, 6u32, \"exact filesystem roundtrip copy move source topology source map diff and deterministic mnemonic path tags satisfy the Spiral-only settlement standard; fifteen recovered slots remain evidence only\")", "MigrationSegment (\"proxy\", 21u32, 7u32, \"exact filesystem roundtrip copy move source topology source map diff deterministic mnemonic path tags and direct-route dogfood shims satisfy the Spiral-only settlement standard; fourteen recovered slots remain evidence only\")")
inl migration_denominator () : patch_exact = PatchExact ("state/migration.spi", "MigrationDenominator (69u32, 11u32, 58u32, 159u32, \"eleven of sixty-nine capability-equivalent slots satisfy the Spiral-only bootstrap settlement standard; twenty-one cold-proven v1 capabilities remain versioned historical settlement rather than erased evidence\")", "MigrationDenominator (69u32, 12u32, 57u32, 173u32, \"twelve of sixty-nine capability-equivalent slots satisfy the Spiral-only bootstrap settlement standard; twenty-one cold-proven v1 capabilities remain versioned historical settlement rather than erased evidence\")")
inl migration_evidence () : patch_exact = PatchExact ("state/migration.spi", "inl granular_mappings () : migration_item", "inl dogfood_shim_settlement () : migration_item = MigrationEvidence (\"dogfood-direct-route-shims-two-mains-and-public-proxy\", 100u32, \"one shared non-Cargo Spiral package models block warn pass explicit-gap fallback install and uninstall decisions; positive and negative mains pass while public proxy installs four link wrappers blocks Python and shell with exit one-eleven permits only explicit fallback reasons and restores preexisting bytes exactly\")\n\ninl granular_mappings () : migration_item")
inl migration_horizon () : patch_exact = PatchExact ("state/migration.spi", "five typed segments total sixty-nine capability-equivalent units; ten are settled fifty-nine remain and nearest-integer scaling yields the public score of one hundred forty-four per thousand", "five typed segments total sixty-nine capability-equivalent units; twelve are settled fifty-seven remain and floor scaling yields the public score of one hundred seventy-three per thousand")
