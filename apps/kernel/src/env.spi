///- --package .
:# env static =
    :< testing

:< sm'_operators
:< syntax

:| quot_kind =
    | QuotType
    | QuotMk
    | QuotLift
    | QuotInd

:| decl =
    | Axiom : name * list name * term
    | Def : name * list name * term * term
    | Recursor : name * list name * term * i32 * i32 * list (name * term) * i32
    | Quotient : name * quot_kind * list name * term

:~ decl_name (d : decl) : string =
    ?= d ?|
    | Axiom (name n, _, _) => n
    | Def (name n, _, _, _) => n
    | Recursor (name n, _, _, _, _, _, _) => n
    | Quotient (name n, _, _, _) => n

:~ decl_type (d : decl) : term =
    ?= d ?|
    | Axiom (_, _, ty) => ty
    | Def (_, _, ty, _) => ty
    | Recursor (_, _, ty, _, _, _, _) => ty
    | Quotient (_, _, _, ty) => ty

:~ ^ find_decl (env : list decl) (n : string) : option decl =
    ?= env ?|
    | d :: rest => ? decl_name d = n ?> Some d |: find_decl rest n
    | [] => None

:~ unfold (env : list decl) (n : string) : option term =
    ?= find_decl env n ?|
    | Some (Def (_, _, _, value)) => Some value
    | _ => None

:~ decl_params (d : decl) : list name =
    ?= d ?|
    | Axiom (_, ps, _) => ps
    | Def (_, ps, _, _) => ps
    | Recursor (_, ps, _, _, _, _, _) => ps
    | Quotient (_, _, ps, _) => ps

:~ ^ level_for (ps : list name) (ls : list level) (n : string) : option level =
    ?= ps ?|
    | (name p) :: rest =>
        ?= ls ?|
        | l :: more => ? p = n ?> Some l |: level_for rest more n
        | [] => None
    | [] => None

:~ ^ instantiate_level (l : level) (ps : list name) (ls : list level) : level =
    ?= l ?|
    | Succ x => Succ (instantiate_level x ps ls)
    | Max (a, b) => Max (instantiate_level a ps ls, instantiate_level b ps ls)
    | IMax (a, b) => IMax (instantiate_level a ps ls, instantiate_level b ps ls)
    | Param (name n) =>
        ?= level_for ps ls n ?|
        | Some v => v
        | None => l
    | Zero => Zero

:~ ^ instantiate_levels (t : term) (ps : list name) (ls : list level) : term =
    ?= t ?|
    | Sort l => Sort (instantiate_level l ps ls)
    | Const (n, us) => Const (n, listm::map (\ u => instantiate_level u ps ls) us)
    | App (f, a) => App (instantiate_levels f ps ls, instantiate_levels a ps ls)
    | Lam (n, b, ty, body) => Lam (n, b, instantiate_levels ty ps ls, instantiate_levels body ps ls)
    | Pi (n, b, ty, body) => Pi (n, b, instantiate_levels ty ps ls, instantiate_levels body ps ls)
    | Let (n, ty, v, body) =>
        Let (n, instantiate_levels ty ps ls, instantiate_levels v ps ls, instantiate_levels body ps ls)
    | Proj (s, i, x) => Proj (s, i, instantiate_levels x ps ls)
    | other => other

:~ unfold_at (env : list decl) (n : string) (ls : list level) : option term =
    ?= find_decl env n ?|
    | Some (Def (_, ps, _, value)) => Some (instantiate_levels value ps ls)
    | _ => None

:~ ^ declares (ps : list name) (n : string) : bool =
    ?= ps ?|
    | (name p) :: rest => ? p = n ?> !+ |: declares rest n
    | [] => !-

:~ first_stray (a : option string) (b : () -> option string) : option string =
    ?= a ?|
    | Some n => Some n
    | None => b ()

:~ ^ stray_param (ps : list name) (l : level) : option string =
    ?= l ?|
    | Param (name n) => ? declares ps n ?> None |: Some n
    | Succ x => stray_param ps x
    | Max (a, b) => first_stray (stray_param ps a) (\ () => stray_param ps b)
    | IMax (a, b) => first_stray (stray_param ps a) (\ () => stray_param ps b)
    | Zero => None

:~ ^ stray_in_levels (ps : list name) (us : list level) : option string =
    ?= us ?|
    | u :: rest => first_stray (stray_param ps u) (\ () => stray_in_levels ps rest)
    | [] => None

:~ ^ stray_in_term (ps : list name) (t : term) : option string =
    ?= t ?|
    | Sort l => stray_param ps l
    | Const (_, us) => stray_in_levels ps us
    | App (f, a) => first_stray (stray_in_term ps f) (\ () => stray_in_term ps a)
    | Lam (_, _, ty, body) => first_stray (stray_in_term ps ty) (\ () => stray_in_term ps body)
    | Pi (_, _, ty, body) => first_stray (stray_in_term ps ty) (\ () => stray_in_term ps body)
    | Let (_, ty, v, body) =>
        first_stray (stray_in_term ps ty) (\ () => first_stray (stray_in_term ps v) (\ () => stray_in_term ps body))
    | Proj (_, _, x) => stray_in_term ps x
    | _ => None

:~ stray_in_decl (d : decl) : option string =
    ?= d ?|
    | Axiom (_, ps, ty) => stray_in_term ps ty
    | Def (_, ps, ty, value) => first_stray (stray_in_term ps ty) (\ () => stray_in_term ps value)
    | Recursor (_, ps, ty, _, _, _, _) => stray_in_term ps ty
    | Quotient (_, _, ps, ty) => stray_in_term ps ty

:~ recursor_rules (env : list decl) (n : string) : option (list name * i32 * i32 * list (name * term) * i32) =
    ?= find_decl env n ?|
    | Some (Recursor (_, ps, _, np, ni, rules, nfront)) => Some (ps, np, ni, rules, nfront)
    | _ => None

:~ structure_ctor (env : list decl) (s : string) : option (string * i32) =
    ?= recursor_rules env (s ++# ".rec") ?|
    | Some (_, np, ni, rules, _) =>
        ?= rules ?|
        | ((name c), _) :: rest => ? ni = 0i32 && (listm::length rest : i32) = 0i32 ?> Some (c, np) |: None
        | [] => None
    | None => None

:~ rec_family (r : string) : string = sm'::slice 0i32 (sm'::length r - 5i32) r

:~ ^ structure_of_ctor (env : list decl) (c : string) : option (string * i32) =
    ?= env ?|
    | d :: rest =>
        ?= d ?|
        | Recursor ((name r), _, _, _, _, _, _) =>
            ?= structure_ctor env (rec_family r) ?|
            | Some (k, np) => ? k = c ?> Some (rec_family r, np) |: structure_of_ctor rest c
            | None => structure_of_ctor rest c
        | _ => structure_of_ctor rest c
    | [] => None

:~ quot_kind_of (env : list decl) (n : string) : option quot_kind =
    ?= find_decl env n ?|
    | Some (Quotient (_, k, _, _)) => Some k
    | _ => None
///> rust
:# a_definition_unfolds_and_an_axiom_does_not =
    := env = [ Axiom (name "nat", [], Sort (Succ Zero)); Def (name "id_prop", [], Sort (Succ Zero), Sort Zero) ]
    (unfold env "id_prop", unfold env "nat", unfold env "missing") |> _assert_eq (Some (Sort Zero), None, None)

///> rust
:# a_level_parameter_counts_only_when_the_declaration_names_it =
    := ty = Pi (name "A", Default, Sort (Param (name "u")), Sort (Max (Param (name "u"), Param (name "v"))))
    (stray_in_term [ name "u"; name "v" ] ty, stray_in_term [ name "u" ] ty) |> _assert_eq (None, Some "v")
