:# kernel_verdicts_are_written_beside_their_lean_source =
    := later = followed_by (conversion_corpus ()) (followed_by (quotient_corpus ()) (followed_by (structure_corpus ()) (followed_by (mutual_corpus ()) (followed_by (nested_corpus ()) (followed_by (universe_corpus ()) (followed_by (k_like_corpus ()) (followed_by (literal_corpus ()) (string_corpus ()))))))))
    := families = followed_by (inductive_corpus ()) (followed_by (family_corpus ()) later)
    := entries = followed_by (corpus ()) families
