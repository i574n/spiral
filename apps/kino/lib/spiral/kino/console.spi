inl (~!\\) forall t u. ((args : t), (code : string)) : u =
    $'__spiral_emit_rust !args !code '

inl show_value forall t. (value : t) : () =
    inl rust () : () =
        inl _ : () =
            !\\(value, $'"{ struct SpiralKinoShow<T>(T); trait SpiralKinoDebug { fn spiral_kino_show(&self) -> String; } impl<T: std::fmt::Debug> SpiralKinoDebug for SpiralKinoShow<T> { fn spiral_kino_show(&self) -> String { format\!(\\\"{:?}\\\", self.0) } } trait SpiralKinoOther { fn spiral_kino_show(&self) -> String; } impl<T> SpiralKinoOther for &SpiralKinoShow<T> { fn spiral_kino_show(&self) -> String { String::from(std::any::type_name::<T>()) } } let text = (&SpiralKinoShow(&$0)).spiral_kino_show(); let mut out = std::io::stdout(); let _ = <std::io::Stdout as std::io::Write>::write_all(&mut out, format\!(\\\"SPIRAL_KINO_VALUE:{}\\\", text).as_bytes()); let _ = <std::io::Stdout as std::io::Write>::write_all(&mut out, &[10u8]); let _ = <std::io::Stdout as std::io::Write>::flush(&mut out); }"')
        ()
    inl gleam () : () =
        global "import gleam/io"
        global "import gleam/string"
        $'io.println(string.inspect(!value))' : ()
    inl cpp () : () =
        global "#include <iostream>"
        $'std::cout << !value << std::endl' : ()
    !!!!BackendSwitch ({
        Rust = fun () => rust ()
        Fsharp = fun () => $'System.Console.WriteLine(match box !value with :? string as s -> s | v -> sprintf "%A" v)' : ()
        TypeScript = fun () => $'console.log(!value)' : ()
        Python = fun () => $'print(!value)' : ()
        Lua = fun () => $'print(!value)' : ()
        Gleam = fun () => gleam ()
        Cpp = fun () => cpp ()
        Zig = fun () => $'{ spiralPrintAny(!value); spiralPrint(&[_]u8{10}); }' : ()
        Lean = fun () => $'IO.println (toString !value)' : ()
    })

inl write_line forall t. (text : t) : () =
    inl rust () : () =
        inl _ : () =
            !\\(text, $'"{ let mut out = std::io::stdout(); let _ = <std::io::Stdout as std::io::Write>::write_all(&mut out, ToString::to_string(&$0).as_bytes()); let _ = <std::io::Stdout as std::io::Write>::write_all(&mut out, &[10u8]); let _ = <std::io::Stdout as std::io::Write>::flush(&mut out); }"')
        ()
    inl gleam () : () =
        global "import gleam/io"
        $'io.println(!text)' : ()
    inl cpp () : () =
        global "#include <iostream>"
        $'std::cout << !text << std::endl' : ()
    !!!!BackendSwitch ({
        Rust = fun () => rust ()
        Fsharp = fun () => $'System.Console.WriteLine(!text)' : ()
        TypeScript = fun () => $'console.log(!text)' : ()
        Python = fun () => $'print(!text)' : ()
        Lua = fun () => $'print(!text)' : ()
        Gleam = fun () => gleam ()
        Cpp = fun () => cpp ()
        Zig = fun () => $'{ spiralPrintAny(!text); spiralPrint(&[_]u8{10}); }' : ()
        Lean = fun () => $'IO.println (toString !text)' : ()
    })

inl display (mime : string) (data : string) : () =
    write_line "SPIRAL_KINO_DISPLAY_BEGIN"
    write_line mime
    write_line data
    write_line "SPIRAL_KINO_DISPLAY_END"
