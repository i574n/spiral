inl (++) (left : string) (right : string) : string = !!!!StaticStringConcat(left,right)

union rec rows =
    | NoRow
    | Row : string * rows

union rec cells =
    | NoCell
    | Cell : string * string * cells

union mark =
    | NoMark
    | Mark : string * string

union rec tokens =
    | NoWord
    | Word : string * tokens

let rec rev_rows (xs : rows) (acc : rows) : rows =
    match xs with
    | NoRow => acc
    | Row (s, rest) => rev_rows rest (Row (s, acc))

let rec snoc (xs : rows) (item : string) : rows =
    match xs with
    | NoRow => Row (item, NoRow)
    | Row (s, rest) => Row (s, snoc rest item)

let rec has_row (xs : rows) (item : string) : bool =
    match xs with
    | NoRow => false
    | Row (s, rest) => if s = item then true else has_row rest item

inl add_row (xs : rows) (item : string) : rows =
    if has_row xs item then xs else snoc xs item

let rec join_rows (xs : rows) : string =
    match xs with
    | NoRow => ""
    | Row (s, NoRow) => s
    | Row (s, rest) => s ++ "\n" ++ join_rows rest

let rec join_rev (xs : rows) (acc : string) (started : i32) : string =
    match xs with
    | NoRow => acc
    | Row (s, rest) =>
        if started = 0i32 then join_rev rest s 1i32
        else join_rev rest (s ++ "\n" ++ acc) 1i32

let rec count_cells (xs : cells) : i32 =
    match xs with
    | NoCell => 0i32
    | Cell (_, _, rest) => 1i32 + count_cells rest

let rec rev_cells (xs : cells) (acc : cells) : cells =
    match xs with
    | NoCell => acc
    | Cell (k, s, rest) => rev_cells rest (Cell (k, s, acc))

let rec emit_cells (xs : cells) : string =
    match xs with
    | NoCell => ""
    | Cell (k, s, rest) =>
        k ++ "\n" ++ text.show_i32 (text.length s) ++ "\n" ++ s ++ emit_cells rest

inl wire (xs : cells) : string =
    inl ordered = rev_cells xs NoCell
    text.show_i32 (count_cells ordered) ++ "\n" ++ emit_cells ordered

let rec letter_end (line : string) (i : i32) : i32 =
    if i >= text.length line then i
    elif text.is_letter (text.index line i) then letter_end line (i + 1i32)
    else i

inl marker (line : string) : mark =
    if text.starts_with line "#!" then
        inl n = letter_end line 2i32
        if n = 2i32 then NoMark
        else Mark (text.slice_len line 2i32 (n - 2i32), text.drop line n)
    else NoMark

inl add_line (buffer : string) (line : string) : string =
    if buffer = "" then line else buffer ++ "\n" ++ line

inl push (xs : cells) (kind : string) (buffer : string) : cells =
    if kind = "" then xs
    else
        inl source = text.trim buffer
        if source = "" then xs else Cell (kind, source, xs)

let rec walk (src : string) (i : i32) (xs : cells) (kind : string) (buffer : string) : cells =
    match text.next_line src i with
    | LineDone => push xs kind buffer
    | LineGot (line, next) =>
        match marker line with
        | NoMark => walk src next xs kind (add_line buffer line)
        | Mark (name, rest) =>
            inl xs2 = push xs kind buffer
            // A mid-cell `#!import` splits the cell: the lines after it stay in the same kernel (.NET Interactive
            // runs them as the next submission), e.g. polyglot's Notebooks.dib `#!import common.fsx` / `let ...`.
            if name = "import" then walk src next (Cell ("import", text.trim rest, xs2)) kind ""
            elif name = "meta" then walk src next xs2 "" ""
            elif name = "markdown" then walk src next xs2 name ""
            elif name = "spiral" then walk src next xs2 name ""
            elif name = "fsharp" then walk src next xs2 name ""
            else walk src next xs2 ("code/" ++ name) ""

inl parse_dib (src : string) : string =
    wire (walk (text.replace src "\r\n" "\n") 0i32 NoCell "" "")


// to_spi is `spiral dib-export <nb>.dib spi` (apps/spiral/spiral.spi: parse, format_block, format_blocks) byte for byte,
// so a .spi regenerated from the .livemd equals the one exported from the .dib:
// - only markdown and Spiral cells count; a Spiral cell with `///- ` and ` --real` belongs to the .spir export;
// - a markdown cell is kept only when another markdown or Spiral cell follows it;
// - a Spiral cell is copied verbatim (trimmed, directive lines like `///> _` included) unless it has `///- ` and
//   ` --test` or ` --ignore`; a markdown line becomes `/// <line>` (after its indentation), an empty one `/// `, and
//   lines ending in ` (test)` are dropped;
// - cells are joined by a blank line, except that a markdown cell sits directly on the code cell after it.
inl spir_cell (source : string) : bool = text.contains source "///- " && text.contains source " --real"

inl test_cell (source : string) : bool =
    text.contains source "///- " && (text.contains source " --test" || text.contains source " --ignore")

let rec spi_blocks (xs : cells) (acc : cells) : cells =
    match xs with
    | NoCell => rev_cells acc NoCell
    | Cell (kind, source, rest) =>
        if kind = "markdown" then spi_blocks rest (Cell (kind, source, acc))
        elif kind = "spiral" && spir_cell (text.trim source) = false then spi_blocks rest (Cell (kind, source, acc))
        else spi_blocks rest acc

let rec keep_docs (xs : cells) : cells =
    match xs with
    | NoCell => NoCell
    | Cell (kind, source, rest) =>
        match rest with
        | NoCell => if kind = "markdown" then NoCell else Cell (kind, source, NoCell)
        | _ => Cell (kind, source, keep_docs rest)

let rec lead_ws (line : string) (i : i32) : i32 =
    if i >= text.length line then i
    else
        inl ch = text.index line i
        if ch = ' ' then lead_ws line (i + 1i32)
        elif ch = '\t' then lead_ws line (i + 1i32)
        else i

inl doc_line (line : string) : string =
    if line = "" then "/// "
    else
        inl i = lead_ws line 0i32
        if i >= text.length line then line
        else text.take line i ++ "/// " ++ text.drop line i

inl test_heading (line : string) : bool =
    inl n = text.length line
    inl m = text.length " (test)"
    if n >= m then text.starts_at line (n - m) " (test)" else false

let rec md_go (src : string) (i : i32) (acc : rows) : rows =
    match text.next_line src i with
    | LineDone => rev_rows acc NoRow
    | LineGot (line, next) =>
        inl t = text.take line (text.trim_end line (text.length line))
        if test_heading t then md_go src next acc else md_go src next (Row (doc_line t, acc))

inl format_cell (kind : string) (source : string) : string =
    inl t = text.trim source
    if kind = "markdown" then join_rows (md_go t 0i32 NoRow)
    elif test_cell t then ""
    else t

let rec formatted (xs : cells) (acc : cells) : cells =
    match xs with
    | NoCell => rev_cells acc NoCell
    | Cell (kind, source, rest) =>
        inl s = format_cell kind source
        if s = "" then formatted rest acc else formatted rest (Cell (kind, s, acc))

let rec emit_spi (xs : cells) : string =
    match xs with
    | NoCell => ""
    | Cell (kind, s, rest) =>
        match rest with
        | NoCell => s ++ "\n"
        | Cell (next, _, _) =>
            inl brk = if kind = "markdown" && next <> "markdown" then "" else "\n"
            s ++ brk ++ "\n" ++ emit_spi rest

let rec read_cells (src : string) (i : i32) (n : i32) (acc : cells) : cells =
    if n <= 0i32 then rev_cells acc NoCell
    else
        match text.next_line src i with
        | LineDone => rev_cells acc NoCell
        | LineGot (kind, j) =>
            match text.next_line src j with
            | LineDone => rev_cells acc NoCell
            | LineGot (len_text, k) =>
                inl nlen = text.parse_i32 len_text
                read_cells src (k + nlen) (n - 1i32) (Cell (kind, text.slice_len src k nlen, acc))

inl load (src : string) : cells =
    match text.next_line src 0i32 with
    | LineDone => NoCell
    | LineGot (count, next) => read_cells src next (text.parse_i32 count) NoCell

inl to_spi (src : string) : string = emit_spi (formatted (keep_docs (spi_blocks (load src) NoCell)) NoCell)
