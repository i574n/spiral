inl export forall t. (name : string) (f : t) : () = !!!!Export(name, f)

inl main () : i32 =
    export "prepare" ((fun code => directives.prepare code) : string -> string)
    export "patch_rust" ((fun (rust : string), (show : string) => cell.patch_rust rust show) : string * string -> string)
    export "split_output" ((fun output => cell.split_output output) : string -> string)
    export "unit_result" ((fun output => cell.unit_result output) : string -> string)
    export "package_project" ((fun includes => cell.package_project includes) : string -> string)
    export "parse_dib" ((fun text => document.parse_dib text) : string -> string)
    export "to_spi" ((fun text => document.to_spi text) : string -> string)
    export "plan" ((fun text => notebook.plan text) : string -> string)
    0i32
