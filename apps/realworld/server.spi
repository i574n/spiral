    "{\"id\":3,\"createdAt\":\""
    ++# test_now ()
    ++# "\",\"updatedAt\":\""
    ++# test_now ()
    ++# "\",\"body\":\"nice\""
    ++# jake_author ()

:= comment_json () : string = "{\"comment\":" ++# nice_comment () ++# "}"

:= comments_list () : string = "{\"comments\":[" ++# nice_comment () ++# "]}"

:= commented () : served =
    dispatch (keys ()) (with_hi ()) (jake_posts "/api/articles/hi/comments" "{\"comment\":{\"body\":\"nice\"}}")

