///> rust -d sha2=0.10 hmac=0.12 pbkdf2=0.12 subtle=2
///> gleam
:# paging_counts_every_match_and_a_bad_limit_falls_back_to_twenty =
    := counted_only = "{\"articles\":[],\"articlesCount\":1}"
    (listed "offset=1", listed "limit=0", listed "limit=abc&tag=x")
    |> _assert_eq (counted_only, counted_only, one_hi ())

