///- --package .
:# server static =
    :< testing

:< sm'_operators
:< conduit_error
:< auth

:== rw_user = realworld_model::user

:== response = { status : i32; body : string }

:== served = { store : rw_store; reply : response }

:== login_envelope = { user : realworld_api::login_body }

:== register_envelope = { user : realworld_api::registration_body }

:== user_view = { email : string; token : string; username : string; bio : option string; image : option string }

:== user_body = { user : user_view }

:= user_json (u : rw_user) (token : string) : string =
    json::encode (
        { user = { email = u::email; token; username = u::username; bio = u::bio; image = u::image } } : user_body
    )

:= replied (s : rw_store) (status : i32) (body : string) : served =
    { store = s; reply = { status = status; body = body } }

:= failed (s : rw_store) (e : conduit_error) : served = replied s (error_status e) (error_body e)

:= emptied (s : rw_store) : served = replied s 204i32 ""

:= refused_by (why : refusal) : conduit_error = ?= why ?| MissingToken => TokenMissing | _ => TokenInvalid

:= token_in (header : string) : string =
    ? sm'::length header < 6i32 ?> "" |: sm'::substring 6i32 (sm'::length header - 6i32) header

:= user_reply (s : rw_store) (status : i32) (email : string) (header : string) : served =
    ?= user_with s email ?|
    | Some (_, u) => replied s status (user_json u (token_in header))
    | None => failed s (NotFound UserEntity)

:= login_of (body : string) : realworld_api::login_body =
    := envelope : login_envelope = json::decode body
    envelope::user

:= login_problem (b : realworld_api::login_body) : option conduit_error =
    first_failed (listm::append (email_checks b::email) [ required Password b::password ])

:= logged_reply (s : rw_store) (secret : string) (b : realworld_api::login_body) : served =
    ?= login s secret b::email b::password ?|
    | LoggedIn header => user_reply s 200i32 b::email header
    | LoginRefused => failed s CredentialsInvalid

:= login_route (s : rw_store) (secret : string) (body : string) : served =
    := b = login_of body
    ?= login_problem b ?| Some e => failed s e | None => logged_reply s secret b

:= registration_of (body : string) : realworld_api::registration_body =
    := envelope : register_envelope = json::decode body
    envelope::user

:= new_user (r : realworld_api::registration_body) : rw_user =
    { username = r::username; email = r::email; bio = None; image = None; password_hash = "" }

:= issued (s : rw_store) (secret : string) (email : string) : served =
    ?= logged_in secret (realworld_model::Id (s::next_id - 1i32)) ?|
    | LoggedIn header => user_reply s 201i32 email header
    | LoginRefused => replied s 500i32 "{}"

:== server_keys = { secret : string; salt : string; rounds : u32 }

:= username_is (name : string) ((_, u) : user_row) : bool = u::username = name

:= name_taken (s : rw_store) (name : string) : bool =
    ?= realworld_model::find_by (username_is name) s::users ?|
    | Some _ => !+
    | None => !-

:= email_taken (s : rw_store) (email : string) : bool = ?= user_with s email ?| Some _ => !+ | None => !-

:= registration_shape (r : realworld_api::registration_body) : list check =
    required Username r::username :: listm::append (email_checks r::email) [ required Password r::password ]

:= registration_problem (s : rw_store) (r : realworld_api::registration_body) : option conduit_error =
    := unique = [ (name_taken s r::username |> not, Taken Username); (email_taken s r::email |> not, Taken Email) ]
    first_failed (listm::append (registration_shape r) unique)

:= register_route (k : server_keys) (s : rw_store) (body : string) : served =
    := r = registration_of body
    ?= registration_problem s r ?|
    | Some e => failed s e
    | None => issued (register s (new_user r) r::password k::salt k::rounds) k::secret r::email

:= current_of (s : rw_store) (header : string) (uid : i32) : served =
    ?= realworld_model::get_user s (realworld_model::Id uid) ?|
    | Some u => replied s 200i32 (user_json u (token_in header))
    | None => failed s (NotFound UserEntity)

:= current_route (s : rw_store) (secret : string) (header : string) : served =
    ?= authenticate (real_crypto ()) secret header ?|
    | Admitted r => current_of s header (user_of r)
    | Unauthorized why => failed s (refused_by why)


:= tags_json (tags : list string) : string = json::encode { tags }

:= bool_json (b : bool) : string = json::encode b

:== profile_view = { username : string; bio : option string; image : option string; following : bool }

:= profile_of (u : rw_user) (following : bool) : profile_view =
    { username = u::username; bio = u::bio; image = u::image; following }

:= profile_json (u : rw_user) (following : bool) : string = json::encode { profile = profile_of u following }

:== uid = realworld_model::id rw_user

:= viewer_of (secret : string) (header : string) : option uid =
    ?= authenticate (real_crypto ()) secret header ?|
    | Admitted r => Some (realworld_model::Id (user_of r))
    | Unauthorized _ => None

:= follows_from (s : rw_store) (viewer : option uid) (target : uid) : bool =
    ?= viewer ?| Some v => realworld_model::is_following s v target | None => false

:= named (name : string) (p : uid * rw_user) : bool =
    ?= p ?|
    | (_, u) => u::username = name

:= profile_route (s : rw_store) (v : option uid) (n : string) : served =
    ?= realworld_model::find_by (named n) s::users ?|
    | Some (id, u) => replied s 200i32 (profile_json u (follows_from s v id))
    | None => failed s (NotFound ProfileEntity)

:== aid = realworld_model::id realworld_model::article

:== rw_article = realworld_model::article

:= favorite_count (s : rw_store) (a : aid) : i32 =
    listm::fold (\ n p => ? realworld_model::id_eq (realworld_model::pair_val p) a ?> n + 1i32 |: n) 0i32 s::favorites

:= favorited_by (s : rw_store) (v : option uid) (a : aid) : bool =
    ?= v ?| Some u => realworld_model::is_favorited s u a | None => false

:= user_fields (s : rw_store) (v : option uid) (who : uid) : string =
    json::encode (
        ?= realworld_model::get_user s who ?|
        | Some u => Some (profile_of u (follows_from s v who))
        | None => None
    )

:= author_fields (s : rw_store) (v : option uid) (a : rw_article) : string = user_fields s v a::author

:= article_head (a : rw_article) : string =
    "{\"slug\":"
    ++# json::quote a::slug
    ++# ",\"title\":"
    ++# json::quote a::title
    ++# ",\"description\":"
    ++# json::quote a::description

:= body_json (a : rw_article) : string = ",\"body\":" ++# json::quote a::body

:= article_tags_and_dates (a : rw_article) : string =
    ",\"tagList\":"
    ++# json::encode a::tag_list
    ++# ",\"createdAt\":"
    ++# json::quote a::created_at
    ++# ",\"updatedAt\":"
    ++# json::quote a::updated_at

:= article_flags (s : rw_store) (v : option uid) (id : aid) : string =
    ",\"favorited\":"
    ++# bool_json (favorited_by s v id)
    ++# ",\"favoritesCount\":"
    ++# json::encode (favorite_count s id)

:= article_tail (s : rw_store) (v : option uid) (id : aid) (a : rw_article) : string =
    article_tags_and_dates a ++# article_flags s v id ++# ",\"author\":" ++# author_fields s v a ++# "}"

:= article_fields (s : rw_store) (v : option uid) ((id, a) : aid * rw_article) : string =
    article_head a ++# body_json a ++# article_tail s v id a

:= article_summary (s : rw_store) (v : option uid) ((id, a) : aid * rw_article) : string =
    article_head a ++# article_tail s v id a

:= with_slug (slug : string) (p : aid * rw_article) : bool =
    ?= p ?|
    | (_, a) => a::slug = slug

:= article_reply (s : rw_store) (v : option uid) (p : aid * rw_article) : served =
    replied s 200i32 ("{\"article\":" ++# article_fields s v p ++# "}")

:= article_route (s : rw_store) (v : option uid) (n : string) : served =
    ?= realworld_model::find_by (with_slug n) s::articles ?|
    | Some p => article_reply s v p
    | None => failed s (NotFound ArticleEntity)

:== article_row = aid * rw_article

:= joined_articles (s : rw_store) (v : option uid) (xs : list article_row) : string =
    listm::fold (\ acc p => ? acc = "" ?> article_summary s v p |: acc ++# "," ++# article_summary s v p) "" xs

:= no_token (s : rw_store) : served = failed s TokenMissing

:= by_followed (s : rw_store) (me : uid) (p : article_row) : bool =
    ?= p ?|
    | (_, a) => realworld_model::is_following s me a::author

:== user_envelope = { user : realworld_api::user_update }

:= or_keep (o : option string) (old : string) : string = ?= o ?| Some x => x | None => old

:| presence =
    | Absent
    | Null
    | Present

:| patch t =
    | Unchanged
    | Cleared
    | SetTo : t

:= presence_in (obj : string) (key : string) : presence =
    := at = json_scan::value_at obj key
    ? at < 0i32 ?> Absent |? json_scan::absent obj at ?> Null |: Present

:= patch_of \* t. (p : presence) (decoded : option t) : patch t =
    ?= p, decoded ?|
    | Absent, _ => Unchanged
    | Present, Some x => SetTo x
    | _ => Cleared

:= envelope_object (body : string) (envelope : string) : string =
    json_scan::object_at body (json_scan::value_at body envelope)

:= text_patch (obj : string) (key : string) (decoded : option string) : patch string =
    patch_of (presence_in obj key) decoded

:= kept_text (p : patch string) (old : string) : string = ?= p ?| SetTo x => x | _ => old

:= present_text (x : string) : option string = ? x = "" ?> None |: Some x

:= kept_option (p : patch string) (old : option string) : option string =
    ?= p ?|
    | SetTo x => present_text x
    | Cleared => None
    | Unchanged => old

:= filled (f : field) (p : patch string) : check =
    ?= p ?|
    | Unchanged => (!+, Blank f)
    | Cleared => (!-, Blank f)
    | SetTo x => required f x

:= shaped_email (p : patch string) : check =
    ?= p ?|
    | SetTo x => (email_shaped x, Invalid Email)
    | _ => (!+, Invalid Email)

:= long_password (p : patch string) : check =
    ?= p ?|
    | SetTo x => password_long_enough x
    | _ => (!+, TooShort Password)

:== user_patch =
    {
        email : patch string
        username : patch string
        password : patch string
        bio : patch string
        image : patch string
    }

:= user_patch_of (body : string) : user_patch =
    := e : user_envelope = json::decode body
    := obj = envelope_object body "user"
    := u = e::user
    {
        email = text_patch obj "email" u::email
        username = text_patch obj "username" u::username
        password = text_patch obj "password" u::password
        bio = text_patch obj "bio" u::bio
        image = text_patch obj "image" u::image
    }

:= free_or_mine (me : uid) (owner : option uid) : bool =
    ?= owner ?|
    | Some other => realworld_model::id_eq other me
    | None => !+

:= taken_by_other
    (s : rw_store) (me : uid) (p : patch string) (taken : rw_store -> string -> option uid) (f : field)
    : check
    =
    ?= p ?|
    | SetTo x => (free_or_mine me (taken s x), Taken f)
    | _ => (!+, Taken f)

:= email_owner (s : rw_store) (email : string) : option uid =
    ?= user_with s email ?|
    | Some (id, _) => Some id
    | None => None

:= name_owner (s : rw_store) (name : string) : option uid =
    ?= realworld_model::find_by (username_is name) s::users ?|
    | Some (id, _) => Some id
    | None => None

:= user_patch_problem (s : rw_store) (me : uid) (p : user_patch) : option conduit_error =
    := shape =
        [
            filled Email p::email
            shaped_email p::email
            filled Username p::username
            filled Password p::password
            long_password p::password
        ]
    first_failed (
        listm::append shape [
            taken_by_other s me p::username name_owner Username
            taken_by_other s me p::email email_owner Email
        ]
    )

:= patched (u : rw_user) (p : user_patch) : rw_user =
    { u with
        email = kept_text p::email u::email
        username = kept_text p::username u::username
        bio = kept_option p::bio u::bio
        image = kept_option p::image u::image
    }

:= rehashed_user (k : server_keys) (u : rw_user) (p : user_patch) : rw_user =
    ?= p::password ?| SetTo x => { u with password_hash = stored_hash k::salt x k::rounds } | _ => u

:= updated_reply (s : rw_store) (me : uid) (u : rw_user) (header : string) : served =
    replied (realworld_model::update_user s me u) 200i32 (user_json u (token_in header))

:= update_found (k : server_keys) (s : rw_store) (me : uid) (h : string) (p : user_patch) : served =
    ?= realworld_model::get_user s me ?|
    | Some u => updated_reply s me (rehashed_user k (patched u p) p) h
    | None => failed s (NotFound UserEntity)

:= update_checked (k : server_keys) (s : rw_store) (me : uid) (h : string) (p : user_patch) : served =
    ?= user_patch_problem s me p ?| Some e => failed s e | None => update_found k s me h p

:= update_user_route (k : server_keys) (s : rw_store) (v : option uid) (header : string) (body : string) : served =
    ?= v ?| Some me => update_checked k s me header (user_patch_of body) | None => no_token s

:== article_input = { title : string; description : string; body : string; tagList : list string }

:== article_envelope = { article : article_input }

:= slug_of (title : string) : string = sm'::replace " " "-" (sm'::to_lower title)

:= authored (now : string) (i : article_input) (author : uid) : rw_article =
    {
        slug = slug_of i::title
        title = i::title
        description = i::description
        body = i::body
        tag_list = i::tagList
        author
        created_at = now
        updated_at = now
    }

:= slug_taken (s : rw_store) (slug : string) : bool =
    ?= realworld_model::find_by (with_slug slug) s::articles ?|
    | Some _ => !+
    | None => !-

:= unique_slug (s : rw_store) (slug : string) : string =
    ? slug_taken s slug
    ?> slug ++# "-" ++# sm'::obj_to_string s::next_id
    |: slug

:= created (now : string) (s : rw_store) (v : uid) (i : article_input) : served =
    := drafted = authored now i v
    := a = { drafted with slug = unique_slug s drafted::slug }
    replied
        (realworld_model::create_article s a)
        201i32
        ("{\"article\":" ++# article_fields s (Some v) (realworld_model::Id s::next_id, a) ++# "}")

:= article_problem (i : article_input) : option conduit_error =
    first_failed [ required Title i::title; required Description i::description; required Body i::body ]

:= create_checked (now : string) (s : rw_store) (v : uid) (i : article_input) : served =
    ?= article_problem i ?| Some e => failed s e | None => created now s v i

:= create_route (now : string) (s : rw_store) (viewer : option uid) (body : string) : served =
    := e : article_envelope = json::decode body
    ?= viewer ?|
    | Some v => create_checked now s v e::article
    | None => no_token s

:= toggled_follow (s : rw_store) (me : uid) (id : uid) (on : bool) : rw_store =
    ? on ?> realworld_model::follow s me id |: realworld_model::unfollow s me id

:= follow_if_found (s : rw_store) (me : uid) (n : string) (on : bool) : rw_store =
    ?= realworld_model::find_by (named n) s::users ?| Some (id, _) => toggled_follow s me id on | None => s

:= follow_route (s : rw_store) (v : option uid) (on : bool) (n : string) : served =
    ?= v ?| Some me => profile_route (follow_if_found s me n on) (Some me) n | None => no_token s

:= toggled_favorite (s : rw_store) (me : uid) (id : aid) (on : bool) : rw_store =
    ? on ?> realworld_model::favorite s me id |: realworld_model::unfavorite s me id

:= favorite_if_found (s : rw_store) (me : uid) (n : string) (on : bool) : rw_store =
    ?= realworld_model::find_by (with_slug n) s::articles ?| Some (id, _) => toggled_favorite s me id on | None => s

:= favorite_route (s : rw_store) (v : option uid) (on : bool) (n : string) : served =
    ?= v ?| Some me => article_route (favorite_if_found s me n on) (Some me) n | None => no_token s

:== rw_comment = realworld_model::comment

:== cid = realworld_model::id rw_comment

:== comment_input = { body : string }

:== comment_envelope = { comment : comment_input }

:= comment_head (id : cid) (c : rw_comment) : string =
    "{\"id\":" ++# sm'::obj_to_string (realworld_model::id_raw id) ++# ",\"createdAt\":" ++# json::quote c::created_at

:= comment_tail (c : rw_comment) : string =
    ",\"updatedAt\":" ++# json::quote c::updated_at ++# ",\"body\":" ++# json::quote c::body

:= comment_fields (s : rw_store) (v : option uid) (p : cid * rw_comment) : string =
    ?= p ?|
    | (id, c) => comment_head id c ++# comment_tail c ++# ",\"author\":" ++# user_fields s v c::author ++# "}"

:= article_id_of (s : rw_store) (slug : string) : option aid =
    ?= realworld_model::find_by (with_slug slug) s::articles ?| Some (id, _) => Some id | None => None

:= on_article (a : aid) (p : cid * rw_comment) : bool = realworld_model::comment_of_article a p

:= comments_json (s : rw_store) (v : option uid) (a : aid) : string =
    := items =
        listm::fold
            \ acc p =>
                ? on_article a p
                ?> ? acc = "" ?> comment_fields s v p |: acc ++# "," ++# comment_fields s v p
                |: acc
            ""
            s::comments
    "{\"comments\":[" ++# items ++# "]}"

:= comments_route (s : rw_store) (v : option uid) (slug : string) : served =
    ?= article_id_of s slug ?|
    | Some a => replied s 200i32 (comments_json s v a)
    | None => failed s (NotFound ArticleEntity)

:= new_comment (now : string) (me : uid) (a : aid) (text : string) : rw_comment =
    { body = text; author = me; article = a; created_at = now; updated_at = now }

:= comment_reply (s : rw_store) (me : uid) (c : rw_comment) : served =
    replied
        (realworld_model::add_comment s c)
        201i32
        ("{\"comment\":" ++# comment_fields s (Some me) (realworld_model::Id s::next_id, c) ++# "}")

:= added_comment (now : string) (s : rw_store) (me : uid) (a : aid) (text : string) : served =
    ?= first_failed [ required Body text ] ?|
    | Some e => failed s e
    | None => comment_reply s me (new_comment now me a text)

:= comment_on (now : string) (s : rw_store) (me : uid) (slug : string) (text : string) : served =
    ?= article_id_of s slug ?| Some a => added_comment now s me a text | None => failed s (NotFound ArticleEntity)

:= comment_route (now : string) (s : rw_store) (v : option uid) (slug : string) (body : string) : served =
    := e : comment_envelope = json::decode body
    ?= v ?| Some me => comment_on now s me slug e::comment::body | None => no_token s

:= dropped (s : rw_store) (slug : string) : rw_store =
    { s with articles = realworld_model::keep_where (\ p => ? with_slug slug p ?> false |: true) s::articles }

:= drop_if_author (s : rw_store) (me : uid) (slug : string) (a : rw_article) : served =
    ? realworld_model::id_eq a::author me ?> emptied (dropped s slug) |: failed s (Forbidden ArticleEntity)

:= drop_owned (s : rw_store) (me : uid) (slug : string) : served =
    ?= realworld_model::find_by (with_slug slug) s::articles ?|
    | Some (_, a) => drop_if_author s me slug a
    | None => failed s (NotFound ArticleEntity)

:= drop_route (s : rw_store) (v : option uid) (slug : string) : served =
    ?= v ?| Some me => drop_owned s me slug | None => no_token s

:== edit_envelope = { article : realworld_api::article_update }

:== article_patch = { fields : realworld_api::article_update; tags : patch (list string) }

:= kept_tags (p : patch (list string)) (old : list string) : list string = ?= p ?| SetTo x => x | _ => old

:= retitled_slug (a : rw_article) (title : option string) : string = ?= title ?| Some t => slug_of t | None => a::slug

:= edited (now : string) (a : rw_article) (e : article_patch) : rw_article =
    := p = e::fields
    := t = or_keep p::title a::title
    := text =
        { a with
            title = t
            slug = retitled_slug a p::title
            description = or_keep p::description a::description
            body = or_keep p::body a::body
        }
    { text with tag_list = kept_tags e::tags a::tag_list; updated_at = now }

:= article_patch_problem (e : article_patch) : option conduit_error =
    := p = e::fields
    := tags_ok = ?= e::tags ?| Cleared => !- | _ => !+
    first_failed [
        (tags_ok, Invalid TagList)
        (or_keep p::title "x" <> "", Blank Title)
        (or_keep p::body "x" <> "", Blank Body)
    ]

:= replaced (s : rw_store) (id : aid) (b : rw_article) : rw_store =
    := swap = \ acc p => ? realworld_model::id_eq (realworld_model::pair_key p) id ?> (id, b) :: acc |: p :: acc
    { s with articles = listm::fold swap [] s::articles |> listm::rev }

:= edit_reply (s : rw_store) (me : uid) (p : aid * rw_article) : served =
    replied s 200i32 ("{\"article\":" ++# article_fields s (Some me) p ++# "}")

:= edit_if_author (s : rw_store) (me : uid) (id : aid) (a : rw_article) (b : rw_article) : served =
    ? realworld_model::id_eq a::author me
    ?> edit_reply (replaced s id b) me (id, b)
    |: failed s (Forbidden ArticleEntity)

:= edit_of (body : string) : article_patch =
    := e : edit_envelope = json::decode body
    := obj = envelope_object body "article"
    { fields = e::article; tags = patch_of (presence_in obj "tagList") e::article::tagList }

:= edit_checked (now : string) (s : rw_store) (me : uid) (id : aid) (a : rw_article) (e : article_patch) : served =
    ?= article_patch_problem e ?| Some problem => failed s problem | None => edit_if_author s me id a (edited now a e)

:= edit_owned (now : string) (s : rw_store) (me : uid) (n : string) (b : string) : served =
    ?= realworld_model::find_by (with_slug n) s::articles ?|
    | Some (id, a) => edit_checked now s me id a (edit_of b)
    | None => failed s (NotFound ArticleEntity)

:= edit_route (now : string) (s : rw_store) (v : option uid) (slug : string) (body : string) : served =
    ?= v ?| Some me => edit_owned now s me slug body | None => no_token s

:= comment_by (s : rw_store) (n : i32) : option (cid * rw_comment) =
    realworld_model::find_by
        \ p => realworld_model::id_eq (realworld_model::pair_key p) (realworld_model::Id n)
        s::comments

:= drop_comment_if_author (s : rw_store) (me : uid) (id : cid) (c : rw_comment) : served =
    ? realworld_model::id_eq c::author me
    ?> emptied (realworld_model::delete_comment s id)
    |: failed s (Forbidden CommentEntity)

:= comment_under (s : rw_store) (a : aid) (n : i32) : option (cid * rw_comment) =
    ?= comment_by s n ?| Some p ?& on_article a p => Some p | _ => None

:= drop_found_comment (s : rw_store) (me : uid) (a : aid) (n : i32) : served =
    ?= comment_under s a n ?|
    | Some (id, c) => drop_comment_if_author s me id c
    | None => failed s (NotFound CommentEntity)

:= drop_comment_route (s : rw_store) (v : option uid) (slug : string) (n : i32) : served =
    ?= v, article_id_of s slug ?|
    | None, _ => no_token s
    | Some _, None => failed s (NotFound ArticleEntity)
    | Some me, Some a => drop_found_comment s me a n

:== http_request =
    {
        method : realworld_api::http_method
        path : string
        query : string
        authorization : string
        body : string
        now : string
    }

:== article_filter =
    {
        tag : option string
        author : option string
        favorited : option string
        limit : i32
        offset : i32
    }

:= query_word (name : string) (r : http_request) : option string =
    := v = url_query::query_value name r::query
    ? v = "" ?> None |: Some v

:= count_or (fallback : i32) (v : string) : i32 =
    ?= (convert::try_convert v : option i32) ?|
    | Some n => n
    | None => fallback

:= query_count (name : string) (fallback : i32) (r : http_request) : i32 =
    ?= query_word name r ?|
    | Some v => count_or fallback v
    | None => fallback

:= filter_of (r : http_request) : article_filter =
    {
        tag = query_word "tag" r
        author = query_word "author" r
        favorited = query_word "favorited" r
        limit = query_count "limit" 20i32 r
        offset = query_count "offset" 0i32 r
    }

:= user_id_named (s : rw_store) (name : string) : option uid =
    ?= realworld_model::find_by (named name) s::users ?| Some (id, _) => Some id | None => None

:= has_tag (t : string) (a : rw_article) : bool = listm::fold (\ hit x => hit || x = t) false a::tag_list

:= tagged (f : article_filter) ((_, a) : article_row) : bool = ?= f::tag ?| Some t => has_tag t a | None => true

:= written_by (s : rw_store) (name : string) (a : rw_article) : bool =
    ?= user_id_named s name ?| Some u => realworld_model::id_eq u a::author | None => false

:= authored_by (s : rw_store) (f : article_filter) ((_, a) : article_row) : bool =
    ?= f::author ?| Some name => written_by s name a | None => true

:= liked_by_name (s : rw_store) (name : string) (id : aid) : bool =
    ?= user_id_named s name ?| Some u => realworld_model::is_favorited s u id | None => false

:= liked_by (s : rw_store) (f : article_filter) ((id, _) : article_row) : bool =
    ?= f::favorited ?| Some name => liked_by_name s name id | None => true

:= kept (s : rw_store) (f : article_filter) (p : article_row) : bool = tagged f p && authored_by s f p && liked_by s f p

:= articles_page (s : rw_store) (v : option uid) (f : article_filter) (matched : list article_row) : string =
    := page = matched |> listm'::skip_ f::offset |> listm'::take_ f::limit
    "{\"articles\":["
    ++# joined_articles s v page
    ++# "],\"articlesCount\":"
    ++# sm'::obj_to_string (listm::length matched : i32)
    ++# "}"

:= listed_articles (s : rw_store) (v : option uid) (f : article_filter) : string =
    articles_page s v f (realworld_model::keep_where (kept s f) s::articles)

:= feed_route (s : rw_store) (v : option uid) (f : article_filter) : served =
    ?= v ?|
    | Some me => replied s 200i32 (articles_page s v f (realworld_model::keep_where (by_followed s me) s::articles))
    | None => no_token s

:| social_op =
    | FollowOp : bool * string
    | FavoriteOp : bool * string

:| article_op =
    | CommentsOp : string
    | CommentOp : string
    | DropOp : string
    | EditOp : string
    | DropCommentOp : string * i32

:| route =
    | ToLogin
    | ToRegister
    | ToCurrent
    | ToTags
    | ToProfile : string
    | ToArticles : article_filter
    | ToArticle : string
    | ToCreate
    | ToFeed : article_filter
    | ToUpdateUser
    | ToSocial : social_op
    | ToArticleOp : article_op
    | Nowhere

:== slug_at = { slug : string }

:== name_at = { username : string }

:== comment_at = { slug : string; id : i32 }

:= on \* t. (r : http_request) (m : realworld_api::http_method) (pattern : string) : option t =
    ? r::method = m ?> routes::matched pattern r::path |: None

:= exact
    (r : http_request) (m : realworld_api::http_method) (path : string) (hit : route) (miss : () -> route)
    : route
    =
    ? r::method = m && r::path = path ?> hit |: miss ()

:= by_slug
    (r : http_request) (m : realworld_api::http_method) (pattern : string) (hit : string -> route) (miss : () -> route)
    : route
    =
    ?= (on r m pattern : option slug_at) ?| Some p => hit p::slug | None => miss ()

:= by_name
    (r : http_request) (m : realworld_api::http_method) (pattern : string) (hit : string -> route) (miss : () -> route)
    : route
    =
    ?= (on r m pattern : option name_at) ?| Some p => hit p::username | None => miss ()

:= article_reads (r : http_request) : route =
    by_slug r realworld_api::Get "/api/articles/:slug/comments" (\ s => ToArticleOp (CommentsOp s)) \ () =>
        by_slug r realworld_api::Get "/api/articles/:slug" (\ s => ToArticle s) (\ () => Nowhere)

:= list_reads (r : http_request) : route =
    exact r realworld_api::Get "/api/articles/feed" (ToFeed (filter_of r)) \ () =>
        exact r realworld_api::Get "/api/articles" (ToArticles (filter_of r)) (\ () => article_reads r)

:= read_route (r : http_request) : route =
    exact r realworld_api::Get "/api/tags" ToTags \ () =>
        by_name r realworld_api::Get "/api/profiles/:username" (\ n => ToProfile n) (\ () => list_reads r)

:= dropped_comment (r : http_request) (miss : () -> route) : route =
    ?= (on r realworld_api::Delete "/api/articles/:slug/comments/:id" : option comment_at) ?|
    | Some p => ToArticleOp (DropCommentOp (p::slug, p::id))
    | None => miss ()

:= article_writes (r : http_request) : route =
    by_slug r realworld_api::Post
        "/api/articles/:slug/comments"
        \ s => ToArticleOp (CommentOp s)
        \ () =>
            dropped_comment r \ () =>
                by_slug r realworld_api::Delete
                    "/api/articles/:slug"
                    \ s => ToArticleOp (DropOp s)
                    \ () =>
                        by_slug r realworld_api::Put
                            "/api/articles/:slug"
                            \ s => ToArticleOp (EditOp s)
                            \ () => read_route r

:= social_route (r : http_request) : route =
    by_name r realworld_api::Post
        "/api/profiles/:username/follow"
        \ n => ToSocial (FollowOp (!+, n))
        \ () =>
            by_name r realworld_api::Delete
                "/api/profiles/:username/follow"
                \ n => ToSocial (FollowOp (!-, n))
                \ () =>
                    by_slug r realworld_api::Post
                        "/api/articles/:slug/favorite"
                        \ s => ToSocial (FavoriteOp (!+, s))
                        \ () =>
                            by_slug r realworld_api::Delete
                                "/api/articles/:slug/favorite"
                                \ s => ToSocial (FavoriteOp (!-, s))
                                \ () => article_writes r

:= route_of (r : http_request) : route =
    exact r realworld_api::Post "/api/users/login" ToLogin \ () =>
        exact r realworld_api::Post "/api/users" ToRegister \ () =>
            exact r realworld_api::Get "/api/user" ToCurrent \ () =>
                exact r realworld_api::Post "/api/articles" ToCreate \ () =>
                    exact r realworld_api::Put "/api/user" ToUpdateUser (\ () => social_route r)

:= missing (s : rw_store) : served = failed s NoRoute

:= tags_reply (s : rw_store) : served = replied s 200i32 (tags_json (realworld_model::get_tags s))

:= listed_reads (s : rw_store) (v : option uid) (t : route) : served =
    ?= t ?|
    | ToTags => tags_reply s
    | ToArticles f => replied s 200i32 (listed_articles s v f)
    | ToFeed f => feed_route s v f
    | ToArticle n => article_route s v n
    | _ => missing s

:= edits (s : rw_store) (v : option uid) (r : http_request) (op : article_op) : served =
    ?= op ?|
    | EditOp n => edit_route r::now s v n r::body
    | DropCommentOp (slug, n) => drop_comment_route s v slug n
    | _ => missing s

:= article_op_reply (s : rw_store) (v : option uid) (r : http_request) (op : article_op) : served =
    ?= op ?|
    | CommentsOp n => comments_route s v n
    | CommentOp n => comment_route r::now s v n r::body
    | DropOp n => drop_route s v n
    | _ => edits s v r op

:= comment_reads (s : rw_store) (v : option uid) (r : http_request) (t : route) : served =
    ?= t ?| ToArticleOp op => article_op_reply s v r op | _ => listed_reads s v t

:= social_reads (s : rw_store) (v : option uid) (r : http_request) (t : route) : served =
    ?= t ?|
    | ToSocial (FollowOp (on, n)) => follow_route s v on n
    | ToSocial (FavoriteOp (on, n)) => favorite_route s v on n
    | _ => comment_reads s v r t

:= reads (k : server_keys) (s : rw_store) (r : http_request) (t : route) : served =
    := v = viewer_of k::secret r::authorization
    ?= t ?|
    | ToProfile n => profile_route s v n
    | ToCreate => create_route r::now s v r::body
    | ToUpdateUser => update_user_route k s v r::authorization r::body
    | _ => social_reads s v r t

:= dispatch (k : server_keys) (s : rw_store) (r : http_request) =
    ?= route_of r ?|
    | ToLogin => login_route s k::secret r::body
    | ToRegister => register_route k s r::body
    | ToCurrent => current_route s k::secret r::authorization
    | t => reads k s r t

:= keys () : server_keys = { secret = "s3cret"; salt = "salt-1"; rounds = 2u32 }

:= test_now () : string = "2026-11-11T00:00:00.000Z"

:= post (path : string) (body : string) : http_request =
    { method = realworld_api::Post; path = path; query = ""; authorization = ""; body = body; now = test_now () }

:= jake_body () : string = "{\"user\":{\"username\":\"jake\",\"email\":\"jake@jake.jake\",\"password\":\"hunter2\"}}"

:= registered () : served = dispatch (keys ()) (realworld_model::empty_store ()) (post "/api/users" (jake_body ()))

:= status_of (s : served) : i32 = s::reply::status

:= as_jake (path : string) : http_request =
    {
        method = realworld_api::Get
        path = path
        query = ""
        authorization = header_for (real_crypto ()) "s3cret" 1i32
        body = ""
        now = test_now ()
    }

///> rust -d sha2=0.10 hmac=0.12 pbkdf2=0.12 subtle=2
///> gleam
:# register_creates_and_login_answers_with_the_user =
    := made = registered ()
    (status_of made, status_of (dispatch (keys ()) made::store (post "/api/users/login" (jake_body ()))))
    |> _assert_eq (201i32, 200i32)

:= status_at (s : served) (r : http_request) : i32 = status_of (dispatch (keys ()) s::store r)

///> rust -d sha2=0.10 hmac=0.12 pbkdf2=0.12 subtle=2
///> gleam
:# the_user_route_needs_a_valid_token =
    := m = registered ()
    := j = as_jake "/api/user"
    := ~empty = ""
    (status_at m j, status_at m { j with authorization = empty }) |> _assert_eq (200i32, 401i32)

:= wrong_login () : string = "{\"user\":{\"email\":\"jake@jake.jake\",\"password\":\"nope\"}}"

///> rust -d sha2=0.10 hmac=0.12 pbkdf2=0.12 subtle=2
///> gleam
:# a_wrong_password_is_401 =
    status_at (registered ()) (post "/api/users/login" (wrong_login ())) |> _assert_eq 401i32

///> rust -d sha2=0.10 hmac=0.12 pbkdf2=0.12 subtle=2
///> gleam
:# an_unknown_route_is_404 =
    status_at (registered ()) (post "/x" "") |> _assert_eq 404i32

///> rust -d sha2=0.10 hmac=0.12 pbkdf2=0.12 subtle=2
///> gleam
:# the_user_body_has_the_spec_shape =
    sm'::starts_with "{\"user\":{\"email\":\"jake@jake.jake\",\"token\":\"1." (registered ())::reply::body
    |> _assert_eq !+

:= anonymous (path : string) : http_request =
    { method = realworld_api::Get; path = path; query = ""; authorization = ""; body = ""; now = test_now () }

:= listing (query : string) : http_request =
    := r = anonymous "/api/articles"
    { r with query = query }

:= with_article (s : served) : rw_store = realworld_model::create_article s::store (realworld_model::sample_article ())

:= body_at (s : rw_store) (r : http_request) : string = (dispatch (keys ()) s r)::reply::body

:= jake_profile (following : bool) : string =
    "{\"profile\":{\"username\":\"jake\",\"bio\":null,\"image\":null,\"following\":"
    ++# (? following ?> "true" |: "false")
    ++# "}}"

:= anon_body (s : rw_store) (path : string) : string = body_at s (anonymous path)

:= anon_status (s : rw_store) (path : string) : i32 = (dispatch (keys ()) s (anonymous path))::reply::status

:= self_followed () : rw_store =
    realworld_model::follow (registered ())::store (realworld_model::Id 1i32) (realworld_model::Id 1i32)

///> rust -d sha2=0.10 hmac=0.12 pbkdf2=0.12 subtle=2
///> gleam
:# tags_list_the_distinct_article_tags =
    anon_body (with_article (registered ())) "/api/tags" |> _assert_eq "{\"tags\":[\"x\"]}"

///> rust -d sha2=0.10 hmac=0.12 pbkdf2=0.12 subtle=2
///> gleam
:# a_profile_answers_without_a_token_and_an_unknown_one_is_404 =
    := s = (registered ())::store
    (anon_body s "/api/profiles/jake", anon_status s "/api/profiles/nobody") |> _assert_eq (jake_profile false, 404i32)

///> rust -d sha2=0.10 hmac=0.12 pbkdf2=0.12 subtle=2
///> gleam
:# a_profile_shows_following_for_the_token_holder =
    := s = self_followed ()
    (body_at s (as_jake "/api/profiles/jake"), anon_body s "/api/profiles/jake")
    |> _assert_eq (jake_profile true, jake_profile false)

:= hi_prefix () : string = "{\"slug\":\"hi\",\"title\":\"Hi\",\"description\":\"d\""

:= hi_rest () : string = ",\"tagList\":[\"x\"],\"createdAt\":\"\",\"updatedAt\":\"\""

:= hi_head () : string = hi_prefix () ++# ",\"body\":\"b\"" ++# hi_rest ()

:= jake_author () : string = ",\"author\":{\"username\":\"jake\",\"bio\":null,\"image\":null,\"following\":false}}"

:= hi_flags (fav : bool) (count : i32) : string =
    ",\"favorited\":" ++# bool_json fav ++# ",\"favoritesCount\":" ++# sm'::obj_to_string count

:= hi_fields (fav : bool) (count : i32) : string = hi_head () ++# hi_flags fav count ++# jake_author ()

:= hi_summary () : string = hi_prefix () ++# hi_rest () ++# hi_flags !- 0i32 ++# jake_author ()

:= with_hi () : rw_store = with_article (registered ())

:= hi_json (fav : bool) (count : i32) : string = "{\"article\":" ++# hi_fields fav count ++# "}"

///> rust -d sha2=0.10 hmac=0.12 pbkdf2=0.12 subtle=2
///> gleam
:# an_article_reads_by_slug_and_an_unknown_slug_is_404 =
    := s = with_hi ()
    (anon_body s "/api/articles/hi", anon_status s "/api/articles/nope") |> _assert_eq (hi_json false 0i32, 404i32)

///> rust -d sha2=0.10 hmac=0.12 pbkdf2=0.12 subtle=2
///> gleam
:# the_article_list_counts_its_articles =
    anon_body (with_hi ()) "/api/articles"
    |> _assert_eq ("{\"articles\":[" ++# hi_summary () ++# "],\"articlesCount\":1}")

:= favored () : rw_store = realworld_model::favorite (with_hi ()) (realworld_model::Id 1i32) (realworld_model::Id 2i32)

:= one_hi () : string = "{\"articles\":[" ++# hi_summary () ++# "],\"articlesCount\":1}"

:= no_articles () : string = "{\"articles\":[],\"articlesCount\":0}"

:= listed (query : string) : string = body_at (with_hi ()) (listing query)

///> rust -d sha2=0.10 hmac=0.12 pbkdf2=0.12 subtle=2
///> gleam
:# list_filters_keep_only_matching_tags_and_authors =
    (listed "tag=x", listed "tag=y", listed "author=jake", listed "author=nobody")
