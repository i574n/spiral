:= self_followed_hi () : rw_store =
    realworld_model::follow (with_hi ()) (realworld_model::Id 1i32) (realworld_model::Id 1i32)

:= following_author () : string = ",\"author\":{\"username\":\"jake\",\"bio\":null,\"image\":null,\"following\":true}}"

:= hi_fields_following () : string = hi_prefix () ++# hi_rest () ++# hi_flags !- 0i32 ++# following_author ()

:= feed_of (s : rw_store) : string = body_at s (as_jake "/api/articles/feed")

:= one_followed () : string = "{\"articles\":[" ++# hi_fields_following () ++# "],\"articlesCount\":1}"

///> rust -d sha2=0.10 hmac=0.12 pbkdf2=0.12 subtle=2
///> gleam
:# the_feed_lists_only_articles_by_followed_authors =
    (feed_of (with_hi ()), feed_of (self_followed_hi ()))
    |> _assert_eq ("{\"articles\":[],\"articlesCount\":0}", one_followed ())

///> rust -d sha2=0.10 hmac=0.12 pbkdf2=0.12 subtle=2
///> gleam
:# the_feed_needs_a_token =
    anon_status (with_hi ()) "/api/articles/feed" |> _assert_eq 401i32

:= hey_body () : string = "{\"article\":{\"title\":\"Hey\"}}"

:= edited_hi () : served = dispatch (keys ()) (with_hi ()) (jake_puts "/api/articles/hi" (hey_body ()))

:= edit_statuses (e : served) : i32 * i32 * i32 =
    e::reply::status, anon_status e::store "/api/articles/hey", anon_status e::store "/api/articles/hi"

///> rust -d sha2=0.10 hmac=0.12 pbkdf2=0.12 subtle=2
///> gleam
:# the_author_edits_an_article_and_its_slug_follows_the_title =
    edit_statuses (edited_hi ()) |> _assert_eq (200i32, 200i32, 404i32)

:= comment_dropped () : served = dispatch (keys ()) (commented ())::store (jake_deletes "/api/articles/hi/comments/3")

///> rust -d sha2=0.10 hmac=0.12 pbkdf2=0.12 subtle=2
///> gleam
:# the_author_deletes_a_comment =
    := d = comment_dropped ()
    (d::reply::status, anon_body d::store "/api/articles/hi/comments") |> _assert_eq (204i32, "{\"comments\":[]}")

:= reply_to (s : rw_store) (r : http_request) : i32 * string =
    := out = dispatch (keys ()) s r
    out::reply::status, out::reply::body

:= signup (username : string) (email : string) : string =
    "{\n  \"user\": {\n    \"username\": \""
    ++# username
    ++# "\",\n    \"email\": \""
    ++# email
    ++# "\",\n    \"password\": \"password123\"\n  }\n}"

///> rust -d sha2=0.10 hmac=0.12 pbkdf2=0.12 subtle=2
///> gleam
:# a_pretty_printed_registration_keeps_its_fields_and_starts_with_a_null_bio =
    := ~name = "auth_1"
    := status, body = reply_to (realworld_model::empty_store ()) (post "/api/users" (signup name "auth_1@test.com"))
    (status, sm'::contains "\"username\":\"auth_1\"" body, sm'::contains "\"bio\":null" body)
    |> _assert_eq (201i32, !+, !+)

///> rust -d sha2=0.10 hmac=0.12 pbkdf2=0.12 subtle=2
///> gleam
:# registration_rejects_blank_and_malformed_fields_and_duplicates =
    := s = (registered ())::store
    := blank = reply_to s (post "/api/users" (signup "" "x@test.com"))
    := malformed = reply_to s (post "/api/users" (signup "new" "not-an-email"))
    := taken = reply_to s (post "/api/users" (signup "jake" "other@test.com"))
    (blank, fst malformed, taken)
    |> _assert_eq (
        (422i32, "{\"errors\":{\"username\":[\"can't be blank\"]}}"),
        422i32,
        (409i32, "{\"errors\":{\"username\":[\"has already been taken\"]}}")
    )

///> rust -d sha2=0.10 hmac=0.12 pbkdf2=0.12 subtle=2
///> gleam
:# login_validates_its_fields_and_a_wrong_password_is_invalid_credentials =
    := s = (registered ())::store
    (reply_to s (post "/api/users/login" "{\"user\":{\"email\":\"\",\"password\":\"x\"}}"), reply_to s (
        post "/api/users/login" (wrong_login ())))
    |> _assert_eq (
        (422i32, "{\"errors\":{\"email\":[\"can't be blank\"]}}"),
        (401i32, "{\"errors\":{\"credentials\":[\"invalid\"]}}")
    )

///> rust -d sha2=0.10 hmac=0.12 pbkdf2=0.12 subtle=2
///> gleam
:# errors_name_the_missing_token_and_the_missing_profile =
    := s = (registered ())::store
    (reply_to s (anonymous "/api/articles/feed"), reply_to s (anonymous "/api/profiles/nobody"))
    |> _assert_eq (
        (401i32, "{\"errors\":{\"token\":[\"is missing\"]}}"),
        (404i32, "{\"errors\":{\"profile\":[\"not found\"]}}")
    )

:= put_user (s : rw_store) (body : string) : i32 = fst (reply_to s (jake_puts "/api/user" body))

///> rust -d sha2=0.10 hmac=0.12 pbkdf2=0.12 subtle=2
///> gleam
:# a_user_update_rejects_null_blank_malformed_and_short_values =
    := s = (registered ())::store
    [
        "{\"user\":{\"email\":null}}"
        "{\"user\":{\"username\":\"\"}}"
        "{\"user\":{\"email\":\"not-an-email\"}}"
        "{\"user\":{\"password\":\"short7c\"}}"
    ]
    |> listm::map (put_user s)
    |> _assert_eq [ 422i32; 422i32; 422i32; 422i32 ]

///> rust -d sha2=0.10 hmac=0.12 pbkdf2=0.12 subtle=2
///> gleam
:# a_new_password_of_eight_characters_logs_in =
    := up = dispatch (keys ()) (registered ())::store (jake_puts "/api/user" "{\"user\": {\"password\": \"bonjour1\"}}")
    := again = "{\"user\":{\"email\":\"jake@jake.jake\",\"password\":\"bonjour1\"}}"
    (up::reply::status, status_at up (post "/api/users/login" again), status_at up (post "/api/users/login" (
        jake_body ())))
    |> _assert_eq (200i32, 200i32, 401i32)

:= tags_after (body : string) : i32 * string =
    := out = dispatch (keys ()) (with_hi ()) (jake_puts "/api/articles/hi" body)
    out::reply::status, ? out::reply::status = 200i32 ?> anon_body out::store "/api/articles/hi" |: ""

///> rust -d sha2=0.10 hmac=0.12 pbkdf2=0.12 subtle=2
///> gleam
:# an_edit_keeps_absent_tags_clears_empty_ones_and_rejects_null =
    := kept = tags_after "{\"article\":{\"body\":\"nb\"}}"
    := cleared = tags_after "{\"article\":{\"tagList\":[]}}"
    (
        fst kept,
        sm'::contains "\"tagList\":[\"x\"]" (snd kept),
        sm'::contains "\"tagList\":[]" (snd cleared),
        fst (tags_after "{\"article\":{\"tagList\":null}}")
    )
    |> _assert_eq (200i32, !+, !+, 422i32)

///> rust -d sha2=0.10 hmac=0.12 pbkdf2=0.12 subtle=2
///> gleam
:# a_comment_drop_names_the_missing_article_or_the_missing_comment =
    := s = (commented ())::store
    (
        reply_to s (jake_deletes "/api/articles/nope/comments/3"),
        reply_to s (jake_deletes "/api/articles/hi/comments/99")
    )
    |> _assert_eq (
        (404i32, "{\"errors\":{\"article\":[\"not found\"]}}"),
        (404i32, "{\"errors\":{\"comment\":[\"not found\"]}}")
    )

///> rust -d sha2=0.10 hmac=0.12 pbkdf2=0.12 subtle=2
///> gleam
:# a_created_article_is_stamped_with_the_request_time_and_a_blank_title_is_422 =
    := made = created_hi ()
    := blank =
        reply_to
            (registered ())::store
            (jake_posts "/api/articles" "{\"article\":{\"title\":\"\",\"description\":\"d\",\"body\":\"b\"}}")
    (sm'::contains ("\"createdAt\":\"" ++# test_now ()) made::reply::body, blank)
    |> _assert_eq (!+, (422i32, "{\"errors\":{\"title\":[\"can't be blank\"]}}"))

:= again (s : served) : served = dispatch (keys ()) s::store (jake_posts "/api/articles" (hi_there_body ()))

///> rust -d sha2=0.10 hmac=0.12 pbkdf2=0.12 subtle=2
///> gleam
:# a_duplicate_title_gets_its_own_slug_and_editing_the_body_keeps_it =
    := first = created_hi ()
    := second = again first
    := slug = "hi-there-" ++# sm'::obj_to_string (second::store::next_id - 1i32)
    := kept = dispatch (keys ()) second::store (jake_puts ("/api/articles/" ++# slug) "{\"article\":{\"body\":\"nb\"}}")
    (
        sm'::contains "\"slug\":\"hi-there\"" first::reply::body,
        sm'::contains ("\"slug\":\"" ++# slug ++# "\"") second::reply::body,
        kept::reply::status,
        sm'::contains ("\"slug\":\"" ++# slug ++# "\"") kept::reply::body
    )
    |> _assert_eq (!+, !+, 200i32, !+)

///> rust -d sha2=0.10 hmac=0.12 pbkdf2=0.12 subtle=2
///> gleam
:# an_empty_bio_clears_to_null_and_stays_null =
    := up = dispatch (keys ()) (bio_update ())::store (jake_puts "/api/user" "{\"user\":{\"bio\":\"\"}}")
    (up::reply::status, sm'::contains "\"bio\":null" up::reply::body, sm'::contains "\"bio\":null" (me_after up))
    |> _assert_eq (200i32, !+, !+)
