```elixir
Spiral.Kino.eval!(
  ~S"""
  inl command_alias (alias : rust.static_ref sm'.str) (command : runtime.command) : runtime.command =
      !\\((command, alias), $'"clap::Command::alias($0, $1)"')

  let get_command () =
      ###"command"
      |> runtime.new_command
      |> runtime.command_subcommand_required true
      |> runtime.command_subcommand (
          ###(get_args () .gleam |> fst)
          |> runtime.new_command
          |> runtime.command_init_arg ((get_args () .gleam |> snd).gleam_path) (
              runtime.arg_required true
          )
          |> runtime.command_init_arg ((get_args () .gleam |> snd).target) (
              real runtime.arg_union `gleam_target ignore
          )
          |> runtime.command_init_arg ((get_args () .gleam |> snd).deps) (
              runtime.arg_value_names ;[ ###"NAME"; ###"VERSION" ]
              >> runtime.arg_num_args_range (
                  runtime.new_value_range
                      false
                      (am'.Start (1i32 |> convert.convert : convert.unativeint))
                      (am'.End eval)
              )
              >> runtime.arg_action runtime.Append
          )
      )
      |> runtime.command_subcommand (
          ###(get_args () .cuda |> fst)
          |> runtime.new_command
          |> runtime.command_init_arg ((get_args () .cuda |> snd).py_path) (
              runtime.arg_required true
          )
          |> runtime.command_init_arg ((get_args () .cuda |> snd).env) (
              real runtime.arg_union `cuda_env ignore
          )
          |> runtime.command_init_arg ((get_args () .cuda |> snd).deps) (
              runtime.arg_value_names ;[ ###"NAME"; ###"VERSION" ]
              >> runtime.arg_num_args_range (
                  runtime.new_value_range
                      false
                      (am'.Start (1i32 |> convert.convert : convert.unativeint))
                      (am'.End eval)
              )
              >> runtime.arg_action runtime.Append
          )
      )
      |> runtime.command_subcommand (
          ###(get_args () .rust |> fst)
          |> runtime.new_command
          |> runtime.command_init_arg ((get_args () .rust |> snd).rs_path) (
              runtime.arg_required true
          )
          |> runtime.command_init_arg ((get_args () .rust |> snd).deps) (
              runtime.arg_value_names ;[ ###"NAME"; ###"VERSION" ]
              >> runtime.arg_num_args_range (
                  runtime.new_value_range
                      false
                      (am'.Start (1i32 |> convert.convert : convert.unativeint))
                      (am'.End eval)
              )
              >> runtime.arg_action runtime.Append
          )
          |> runtime.command_init_arg ((get_args () .rust |> snd).wasm) (
              runtime.arg_num_args_range (
                  runtime.new_value_range
                      true
                      (am'.End eval)
                      (am'.End fun _ => (1i32 |> convert.convert : convert.unativeint))
              )
              >> runtime.arg_require_equals true
              >> runtime.arg_default_missing_value ""
          )
          |> runtime.command_init_arg ((get_args () .rust |> snd).contract) (
              runtime.arg_num_args_range (
                  runtime.new_value_range
                      true
                      (am'.End eval)
                      (am'.End fun _ => (1i32 |> convert.convert : convert.unativeint))
              )
              >> runtime.arg_require_equals true
              >> runtime.arg_default_missing_value ""
          )
          |> runtime.command_init_arg ((get_args () .rust |> snd).cleanup) (
              runtime.arg_default_value "true"
              >> runtime.arg_action runtime.SetFalse
          )
      )
      |> runtime.command_subcommand (
          inl parse (s : rust.ref sm'.str) : resultm.result' (sm'.std_string * sm'.std_string) sm'.std_string =
              trace Verbose (fun () => "spiral.get_command") (fun () => { s })
              inl path = "" |> sm'.to_std_string
              inl ext = "" |> sm'.to_std_string
              Ok (path, ext)
              |> resultm.box
          ###(get_args () .notebook_export |> fst)
          |> runtime.new_command
          |> command_alias ###"dib-export"
          |> runtime.command_init_arg ((get_args () .notebook_export |> snd).entries) (
              runtime.arg_required true
              >> runtime.arg_index 1
              >> runtime.arg_value_names ;[ ###"PATH"; ###"EXT" ]
              >> runtime.arg_num_args_range (
                  runtime.new_value_range
                      false
                      (am'.Start (2i32 |> convert.convert : convert.unativeint))
                      (am'.End eval)
              )
              >> runtime.arg_action runtime.Append
          )
      )
      |> runtime.command_subcommand (
          ###(get_args () .lua |> fst)
          |> runtime.new_command
          |> runtime.command_init_arg ((get_args () .lua |> snd).lua_path) (
              runtime.arg_required true
          )
      )
      |> runtime.command_subcommand (
          ###(get_args () .cpp |> fst)
          |> runtime.new_command
          |> runtime.command_init_arg ((get_args () .cpp |> snd).cpp_path) (
              runtime.arg_required true
          )
      )
  """,
  timeout: 300_000
)
```

### run

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"let rec run trace_level (matches : runtime.arg_matches) : async.future_pin (resultm.result' string string) =\n    fun () =>\n        match matches |> runtime.matches_subcommand |> optionm'.unbox with\n        | Some (subcommand, arg_matches)\n                when (subcommand |> sm'.from_std_string) = (get_args () .gleam |> fst) =>\n\n            inl gleam_path =\n                arg_matches\n                |> runtime.matches_get_one ((get_args () .gleam |> snd).gleam_path |> fst)\n                |> optionm'.unbox\n                |> optionm.value\n                |> sm'.from_std_string\n\n            inl target =\n                arg_matches\n                |> runtime.matches_get_one ((get_args () .gleam |> snd).target |> fst)\n                |> optionm'.unbox\n                |> optionm.map (\n                    sm'.from_std_string\n                    >> reflection.union_try_pick\n                )\n                |> optionm'.flatten\n                |> optionm'.default_value Erlang\n\n            inl deps : am'.vec sm'.std_string =\n                arg_matches\n                |> runtime.matches_get_many ((get_args () .gleam |> snd).deps |> fst)\n                |> optionm'.unbox\n                |> optionm'.default_value (;[] |> am'.to_vec)\n\n            inl command_result =\n                process_gleam { gleam_path target deps }\n                |> fun { extension code output } =>\n                    ;[\n                        \"extension\", extension |> optionm'.default_value \"\"\n                        \"code\", code |> optionm'.default_value \"\"\n                        \"output\", output |> optionm'.default_value \"\"\n                    ]\n\n            ;[\n                \"command_result\",\n                command_result\n                |> am'.to_vec\n                |> am'.vec_map' fun k, v =>\n                    new_pair (sm'.to_std_string k) (sm'.to_std_string v)\n                |> mapm.b_tree_map_from_vec_pairs\n                |> sm'.serialize\n                |> resultm.unwrap'\n                |> sm'.from_std_string\n            ]\n\n        | Some (subcommand, arg_matches)\n                when (subcommand |> sm'.from_std_string) = (get_args () .lua |> fst) =>\n\n            inl lua_path =\n                arg_matches\n                |> runtime.matches_get_one ((get_args () .lua |> snd).lua_path |> fst)\n                |> optionm'.unbox\n                |> optionm.value\n                |> sm'.from_std_string\n\n            inl command_result =\n                process_lua { lua_path }\n                |> fun { extension code output stdio } =>\n                    ;[\n                        \"extension\", extension |> optionm'.default_value \"\"\n                        \"code\", code |> optionm'.default_value \"\"\n                        \"output\", stdio |> optionm'.default_value \"\"\n                    ]\n\n            ;[\n                \"command_result\",\n                command_result\n                |> am'.to_vec\n                |> am'.vec_map' fun k, v =>\n                    new_pair (sm'.to_std_string k) (sm'.to_std_string v)\n                |> mapm.b_tree_map_from_vec_pairs\n                |> sm'.serialize\n                |> resultm.unwrap'\n                |> sm'.from_std_string\n            ]\n\n        | Some (subcommand, arg_matches)\n                when (subcommand |> sm'.from_std_string) = (get_args () .cuda |> fst) =>\n\n            inl py_path =\n                arg_matches\n                |> runtime.matches_get_one ((get_args () .cuda |> snd).py_path |> fst)\n                |> optionm'.unbox\n                |> optionm.value\n                |> sm'.from_std_string\n\n            inl env =\n                arg_matches\n                |> runtime.matches_get_one ((get_args () .cuda |> snd).env |> fst)\n                |> optionm'.unbox\n                |> optionm.map (\n                    sm'.from_std_string\n                    >> reflection.union_try_pick\n                )\n                |> optionm'.flatten\n                |> optionm'.default_value Pip\n\n            inl deps : am'.vec sm'.std_string =\n                arg_matches\n                |> runtime.matches_get_many ((get_args () .cuda |> snd).deps |> fst)\n                |> optionm'.unbox\n                |> optionm'.default_value (;[] |> am'.to_vec)\n\n            inl command_result =\n                process_cuda { py_path env deps }\n                |> fun { extension code output } =>\n                    ;[\n                        \"extension\", extension |> optionm'.default_value \"\"\n                        \"code\", code |> optionm'.default_value \"\"\n                        \"output\", output |> optionm'.default_value \"\"\n                    ]\n\n            ;[\n                \"command_result\",\n                command_result\n                |> am'.to_vec\n                |> am'.vec_map' fun k, v =>\n                    new_pair (sm'.to_std_string k) (sm'.to_std_string v)\n                |> mapm.b_tree_map_from_vec_pairs\n                |> sm'.serialize\n                |> resultm.unwrap'\n                |> sm'.from_std_string\n            ]\n\n        | Some (subcommand, arg_matches)\n                when (subcommand |> sm'.from_std_string) = (get_args () .cpp |> fst) =>\n\n            inl cpp_path =\n                arg_matches\n                |> runtime.matches_get_one ((get_args () .cpp |> snd).cpp_path |> fst)\n                |> optionm'.unbox\n                |> optionm.value\n                |> sm'.from_std_string\n\n            inl command_result =\n                process_cpp { cpp_path }\n                |> fun { extension code output } =>\n                    ;[\n                        \"extension\", extension |> optionm'.default_value \"\"\n                        \"code\", code |> optionm'.default_value \"\"\n                        \"output\", output |> optionm'.default_value \"\"\n                    ]\n\n            ;[\n                \"command_result\",\n                command_result\n                |> am'.to_vec\n                |> am'.vec_map' fun k, v =>\n                    new_pair (sm'.to_std_string k) (sm'.to_std_string v)\n                |> mapm.b_tree_map_from_vec_pairs\n                |> sm'.serialize\n                |> resultm.unwrap'\n                |> sm'.from_std_string\n            ]\n\n        | Some (subcommand, arg_matches)\n            when (subcommand |> sm'.from_std_string) = (get_args () .notebook_export |> fst) =>\n\n            inl deps : am'.vec (sm'.std_string * sm'.std_string) =\n                arg_matches\n                |> runtime.matches_get_many ((get_args () .cuda |> snd).deps |> fst)\n                |> optionm'.unbox\n                |> optionm'.default_value (;[] |> am'.to_vec)\n\n            inl entries =\n                arg_matches\n                |> runtime.matches_get_many ((get_args () .notebook_export |> snd).entries |> fst)\n                |> optionm'.unbox\n                |> optionm.map (fun (entries : am'.vec sm'.std_string) =>\n                    entries\n                    |> fun x =>\n                        !\\\\(x, $'$\"$0.chunks_exact(2).map(|chunk| chunk.to_vec()).collect()\"')\n                        : am'.vec (am'.vec sm'.std_string)\n                    |> am'.vec_map' fun chunk =>\n                        inl exts () =\n                            reflection.get_union_fields_untag () : _ (_ * export_output)\n                        chunk\n                        |> am'.from_vec_base\n                        |> am'.to_list_base'\n                        |> listm'.unbox\n                        |> function\n                            | [ path; ext ] =>\n                                match ext |> sm'.from_std_string |> reflection.union_try_pick with\n                                | Some (ext : export_output) => (path |> sm'.from_std_string, ext) |> Ok\n                                | None => \"spiral.run / invalid ext / \" ++#? { ext exts } |> Error\n                            | _ =>\n                                \"spiral.run / invalid entries / \" ++#? { entries = entries |> rust.clone; exts }\n                                |> Error\n                            |> resultm.get\n                    |> am'.from_vec_base\n                    |> am'.to_list_base'\n                    |> listm'.unbox\n                )\n                |> optionm'.default_value []\n                |> listm'.box\n                |> listm'.to_array'\n                |> am'.to_vec\n\n            process_export { entries }\n\n        | matches =>\n            match matches with\n            | Some (subcommand, arg_matches)\n                    when (subcommand |> sm'.from_std_string) = (get_args () .rust |> fst) =>\n\n                inl rs_path =\n                    arg_matches\n                    |> runtime.matches_get_one ((get_args () .rust |> snd).rs_path |> fst)\n                    |> optionm'.unbox\n                    |> optionm.value\n                    |> sm'.from_std_string\n\n                inl deps : am'.vec sm'.std_string =\n                    arg_matches\n                    |> runtime.matches_get_many ((get_args () .rust |> snd).deps |> fst)\n                    |> optionm'.unbox\n                    |> optionm'.default_value (;[] |> am'.to_vec)\n\n                inl cleanup =\n                    arg_matches\n                    |> runtime.matches_get_flag ((get_args () .rust |> snd).cleanup |> fst)\n\n                inl wasm =\n                    arg_matches\n                    |> runtime.matches_get_one ((get_args () .rust |> snd).wasm |> fst)\n                    |> optionm'.unbox\n                    |> optionm.map sm'.from_std_string\n\n                inl contract =\n                    arg_matches\n                    |> runtime.matches_get_one ((get_args () .rust |> snd).contract |> fst)\n                    |> optionm'.unbox\n                    |> optionm.map sm'.from_std_string\n\n                inl runtime =\n                    match wasm, contract with\n                    | Some wasm, _ => Wasm wasm |> Some\n                    | _, Some contract => Contract contract |> Some\n                    | _ => None\n\n                process_rust { rs_path deps trace_level runtime cleanup }\n\n            | Some (subcommand, arg_matches) =>\n                trace Debug\n                    fun () => \"spiral.run / invalid subcommand\"\n                    fun () => { subcommand arg_matches }\n\n                { extension = None; code = None; code_path = None; output = None }\n            | _ =>\n                { extension = None; code = None; code_path = None; output = None }\n            |> fun { extension code code_path output } =>\n                ;[\n                    \"extension\", extension |> optionm'.default_value \"\"\n                    \"code\", code |> optionm'.default_value \"\"\n                    \"code_path\", code_path |> optionm'.default_value \"\"\n                    \"output\", output |> optionm'.default_value \"\"\n                ]\n        |> am'.to_vec\n        |> am'.vec_map' fun k, v =>\n            new_pair (sm'.to_std_string k) (sm'.to_std_string v)\n        |> mapm.b_tree_map_from_vec_pairs\n        |> sm'.serialize\n        |> resultm.map_error' (sm'.format' >> sm'.from_std_string)\n        |> resultm.map' sm'.from_std_string\n    |> async.new_future_move","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  let rec run trace_level (matches : runtime.arg_matches) : async.future_pin (resultm.result' string string) =
      fun () =>
          match matches |> runtime.matches_subcommand |> optionm'.unbox with
          | Some (subcommand, arg_matches)
                  when (subcommand |> sm'.from_std_string) = (get_args () .gleam |> fst) =>

              inl gleam_path =
                  arg_matches
                  |> runtime.matches_get_one ((get_args () .gleam |> snd).gleam_path |> fst)
                  |> optionm'.unbox
                  |> optionm.value
                  |> sm'.from_std_string

              inl target =
                  arg_matches
                  |> runtime.matches_get_one ((get_args () .gleam |> snd).target |> fst)
                  |> optionm'.unbox
                  |> optionm.map (
                      sm'.from_std_string
                      >> reflection.union_try_pick
                  )
                  |> optionm'.flatten
                  |> optionm'.default_value Erlang

              inl deps : am'.vec sm'.std_string =
                  arg_matches
                  |> runtime.matches_get_many ((get_args () .gleam |> snd).deps |> fst)
                  |> optionm'.unbox
                  |> optionm'.default_value (;[] |> am'.to_vec)

              inl command_result =
                  process_gleam { gleam_path target deps }
                  |> fun { extension code output } =>
                      ;[
                          "extension", extension |> optionm'.default_value ""
                          "code", code |> optionm'.default_value ""
                          "output", output |> optionm'.default_value ""
                      ]

              ;[
                  "command_result",
                  command_result
                  |> am'.to_vec
                  |> am'.vec_map' fun k, v =>
                      new_pair (sm'.to_std_string k) (sm'.to_std_string v)
                  |> mapm.b_tree_map_from_vec_pairs
                  |> sm'.serialize
                  |> resultm.unwrap'
                  |> sm'.from_std_string
              ]

          | Some (subcommand, arg_matches)
                  when (subcommand |> sm'.from_std_string) = (get_args () .lua |> fst) =>

              inl lua_path =
                  arg_matches
                  |> runtime.matches_get_one ((get_args () .lua |> snd).lua_path |> fst)
                  |> optionm'.unbox
                  |> optionm.value
                  |> sm'.from_std_string

              inl command_result =
                  process_lua { lua_path }
                  |> fun { extension code output stdio } =>
                      ;[
                          "extension", extension |> optionm'.default_value ""
                          "code", code |> optionm'.default_value ""
                          "output", stdio |> optionm'.default_value ""
                      ]

              ;[
                  "command_result",
                  command_result
                  |> am'.to_vec
                  |> am'.vec_map' fun k, v =>
                      new_pair (sm'.to_std_string k) (sm'.to_std_string v)
                  |> mapm.b_tree_map_from_vec_pairs
                  |> sm'.serialize
                  |> resultm.unwrap'
                  |> sm'.from_std_string
              ]

          | Some (subcommand, arg_matches)
                  when (subcommand |> sm'.from_std_string) = (get_args () .cuda |> fst) =>

              inl py_path =
                  arg_matches
                  |> runtime.matches_get_one ((get_args () .cuda |> snd).py_path |> fst)
                  |> optionm'.unbox
                  |> optionm.value
                  |> sm'.from_std_string

              inl env =
                  arg_matches
                  |> runtime.matches_get_one ((get_args () .cuda |> snd).env |> fst)
                  |> optionm'.unbox
                  |> optionm.map (
                      sm'.from_std_string
                      >> reflection.union_try_pick
                  )
                  |> optionm'.flatten
                  |> optionm'.default_value Pip

              inl deps : am'.vec sm'.std_string =
                  arg_matches
                  |> runtime.matches_get_many ((get_args () .cuda |> snd).deps |> fst)
                  |> optionm'.unbox
                  |> optionm'.default_value (;[] |> am'.to_vec)

              inl command_result =
                  process_cuda { py_path env deps }
                  |> fun { extension code output } =>
                      ;[
                          "extension", extension |> optionm'.default_value ""
                          "code", code |> optionm'.default_value ""
                          "output", output |> optionm'.default_value ""
                      ]

              ;[
                  "command_result",
                  command_result
                  |> am'.to_vec
                  |> am'.vec_map' fun k, v =>
                      new_pair (sm'.to_std_string k) (sm'.to_std_string v)
                  |> mapm.b_tree_map_from_vec_pairs
                  |> sm'.serialize
                  |> resultm.unwrap'
                  |> sm'.from_std_string
              ]

          | Some (subcommand, arg_matches)
                  when (subcommand |> sm'.from_std_string) = (get_args () .cpp |> fst) =>

              inl cpp_path =
                  arg_matches
                  |> runtime.matches_get_one ((get_args () .cpp |> snd).cpp_path |> fst)
                  |> optionm'.unbox
                  |> optionm.value
                  |> sm'.from_std_string

              inl command_result =
                  process_cpp { cpp_path }
                  |> fun { extension code output } =>
                      ;[
                          "extension", extension |> optionm'.default_value ""
                          "code", code |> optionm'.default_value ""
                          "output", output |> optionm'.default_value ""
                      ]

              ;[
                  "command_result",
                  command_result
                  |> am'.to_vec
                  |> am'.vec_map' fun k, v =>
                      new_pair (sm'.to_std_string k) (sm'.to_std_string v)
                  |> mapm.b_tree_map_from_vec_pairs
                  |> sm'.serialize
                  |> resultm.unwrap'
                  |> sm'.from_std_string
              ]

          | Some (subcommand, arg_matches)
              when (subcommand |> sm'.from_std_string) = (get_args () .notebook_export |> fst) =>

              inl deps : am'.vec (sm'.std_string * sm'.std_string) =
                  arg_matches
                  |> runtime.matches_get_many ((get_args () .cuda |> snd).deps |> fst)
                  |> optionm'.unbox
                  |> optionm'.default_value (;[] |> am'.to_vec)

              inl entries =
                  arg_matches
                  |> runtime.matches_get_many ((get_args () .notebook_export |> snd).entries |> fst)
                  |> optionm'.unbox
                  |> optionm.map (fun (entries : am'.vec sm'.std_string) =>
                      entries
                      |> fun x =>
                          !\\(x, $'$"$0.chunks_exact(2).map(|chunk| chunk.to_vec()).collect()"')
                          : am'.vec (am'.vec sm'.std_string)
                      |> am'.vec_map' fun chunk =>
                          inl exts () =
                              reflection.get_union_fields_untag () : _ (_ * export_output)
                          chunk
                          |> am'.from_vec_base
                          |> am'.to_list_base'
                          |> listm'.unbox
                          |> function
                              | [ path; ext ] =>
                                  match ext |> sm'.from_std_string |> reflection.union_try_pick with
                                  | Some (ext : export_output) => (path |> sm'.from_std_string, ext) |> Ok
                                  | None => "spiral.run / invalid ext / " ++#? { ext exts } |> Error
                              | _ =>
                                  "spiral.run / invalid entries / " ++#? { entries = entries |> rust.clone; exts }
                                  |> Error
                              |> resultm.get
                      |> am'.from_vec_base
                      |> am'.to_list_base'
                      |> listm'.unbox
                  )
                  |> optionm'.default_value []
                  |> listm'.box
                  |> listm'.to_array'
                  |> am'.to_vec

              process_export { entries }

          | matches =>
              match matches with
              | Some (subcommand, arg_matches)
                      when (subcommand |> sm'.from_std_string) = (get_args () .rust |> fst) =>

                  inl rs_path =
                      arg_matches
                      |> runtime.matches_get_one ((get_args () .rust |> snd).rs_path |> fst)
                      |> optionm'.unbox
                      |> optionm.value
                      |> sm'.from_std_string

                  inl deps : am'.vec sm'.std_string =
                      arg_matches
                      |> runtime.matches_get_many ((get_args () .rust |> snd).deps |> fst)
                      |> optionm'.unbox
                      |> optionm'.default_value (;[] |> am'.to_vec)

                  inl cleanup =
                      arg_matches
                      |> runtime.matches_get_flag ((get_args () .rust |> snd).cleanup |> fst)

                  inl wasm =
                      arg_matches
                      |> runtime.matches_get_one ((get_args () .rust |> snd).wasm |> fst)
                      |> optionm'.unbox
                      |> optionm.map sm'.from_std_string

                  inl contract =
                      arg_matches
                      |> runtime.matches_get_one ((get_args () .rust |> snd).contract |> fst)
                      |> optionm'.unbox
                      |> optionm.map sm'.from_std_string

                  inl runtime =
                      match wasm, contract with
                      | Some wasm, _ => Wasm wasm |> Some
                      | _, Some contract => Contract contract |> Some
                      | _ => None

                  process_rust { rs_path deps trace_level runtime cleanup }

              | Some (subcommand, arg_matches) =>
                  trace Debug
                      fun () => "spiral.run / invalid subcommand"
                      fun () => { subcommand arg_matches }

                  { extension = None; code = None; code_path = None; output = None }
              | _ =>
                  { extension = None; code = None; code_path = None; output = None }
              |> fun { extension code code_path output } =>
                  ;[
                      "extension", extension |> optionm'.default_value ""
                      "code", code |> optionm'.default_value ""
                      "code_path", code_path |> optionm'.default_value ""
                      "output", output |> optionm'.default_value ""
                  ]
          |> am'.to_vec
          |> am'.vec_map' fun k, v =>
              new_pair (sm'.to_std_string k) (sm'.to_std_string v)
          |> mapm.b_tree_map_from_vec_pairs
          |> sm'.serialize
          |> resultm.map_error' (sm'.format' >> sm'.from_std_string)
          |> resultm.map' sm'.from_std_string
      |> async.new_future_move
  """,
  timeout: 300_000
)
```

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"///- --test\n///> rust -d async-walkdir chrono clap encoding_rs encoding_rs_io futures rand rayon regex serde_json sha2 mlua['lua51','vendored']\n\ninl file_name = \"main.rs\"\ninl code = \"fn main() {\\n    println!(\\\"{}\\\", 3 - 6);\\n}\\n\"\n\ninl temp_dir, disposable =\n    #?*(file_name, code)\n    |> crypto.hash_text\n    |> file_system.create_temp_dir'\ndisposable |> use |> ignore\ninl rs_path = temp_dir </> file_name\n\ncode |> file_system.write_all_text rs_path\n\nget_command ()\n|> runtime.command_get_matches_from (\n    $'$\"_ rust -r \\\\\\\"{!rs_path}\\\\\\\" -d regex=\\'*\\'\"'\n    |> runtime.split_args\n    |> resultm.get\n)\n|> run Verbose\n|> async.block_on_futures\n|> resultm.unwrap'\n|> sm'.deserialize\n|> resultm.unwrap'\n|> mapm.get (\"command_result\" |> sm'.to_std_string)\n|> optionm'.unwrap\n|> sm'.from_std_string\n|> sm'.deserialize\n|> resultm.unwrap'\n|> fun result =>\n    result\n    |> mapm.get (\"extension\" |> sm'.to_std_string)\n    |> optionm'.unwrap\n    |> sm'.from_std_string\n    |> _assert_eq \"rs\"\n    result\n    |> mapm.get (\"output\" |> sm'.to_std_string)\n    |> optionm'.unwrap\n    |> sm'.from_std_string\n    |> _assert_eq \"-3\"","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  ///- --test
  ///> rust -d async-walkdir chrono clap encoding_rs encoding_rs_io futures rand rayon regex serde_json sha2 mlua['lua51','vendored']

  inl file_name = "main.rs"
  inl code = "fn main() {\n    println!(\"{}\", 3 - 6);\n}\n"

  inl temp_dir, disposable =
      #?*(file_name, code)
      |> crypto.hash_text
      |> file_system.create_temp_dir'
  disposable |> use |> ignore
  inl rs_path = temp_dir </> file_name

  code |> file_system.write_all_text rs_path

  get_command ()
  |> runtime.command_get_matches_from (
      $'$"_ rust -r \\\"{!rs_path}\\\" -d regex=\'*\'"'
      |> runtime.split_args
      |> resultm.get
  )
  |> run Verbose
  |> async.block_on_futures
  |> resultm.unwrap'
  |> sm'.deserialize
  |> resultm.unwrap'
  |> mapm.get ("command_result" |> sm'.to_std_string)
  |> optionm'.unwrap
  |> sm'.from_std_string
  |> sm'.deserialize
  |> resultm.unwrap'
  |> fun result =>
      result
      |> mapm.get ("extension" |> sm'.to_std_string)
      |> optionm'.unwrap
      |> sm'.from_std_string
      |> _assert_eq "rs"
      result
      |> mapm.get ("output" |> sm'.to_std_string)
      |> optionm'.unwrap
      |> sm'.from_std_string
      |> _assert_eq "-3"
  """,
  timeout: 300_000
)
```

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"///- --test\n///> rust -d async-walkdir chrono clap encoding_rs encoding_rs_io futures rand rayon regex serde_json sha2 mlua['lua51','vendored']\n\ninl file_name = \"main.fs\"\ninl code = \"3 - 6 |> System.Console.WriteLine\\n\"\n\ninl temp_dir, disposable =\n    #?*(file_name, code)\n    |> crypto.hash_text\n    |> file_system.create_temp_dir'\ndisposable |> use |> ignore\ninl fs_path = temp_dir </> file_name\n\ncode |> file_system.write_all_text fs_path\n\nget_command ()\n|> runtime.command_get_matches_from\n    ($'$\"_ fable -f \\\\\\\"{!fs_path}\\\\\\\" -c \\\\\\\"typescript\\\\\\\"\"' |> runtime.split_args |> resultm.get)\n|> run Verbose\n|> async.block_on_futures\n|> resultm.unwrap'\n|> sm'.deserialize\n|> resultm.unwrap'\n|> mapm.get (\"command_result\" |> sm'.to_std_string)\n|> optionm'.unwrap\n|> sm'.from_std_string\n|> sm'.deserialize\n|> resultm.unwrap'\n|> fun result =>\n    result\n    |> mapm.get (\"extension\" |> sm'.to_std_string)\n    |> optionm'.unwrap\n    |> sm'.from_std_string\n    |> _assert_eq \"ts\"\n    result\n    |> mapm.get (\"output\" |> sm'.to_std_string)\n    |> optionm'.unwrap\n    |> sm'.from_std_string\n    |> _assert_eq \"-3\"","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  ///- --test
  ///> rust -d async-walkdir chrono clap encoding_rs encoding_rs_io futures rand rayon regex serde_json sha2 mlua['lua51','vendored']

  inl file_name = "main.fs"
  inl code = "3 - 6 |> System.Console.WriteLine\n"

  inl temp_dir, disposable =
      #?*(file_name, code)
      |> crypto.hash_text
      |> file_system.create_temp_dir'
  disposable |> use |> ignore
  inl fs_path = temp_dir </> file_name

  code |> file_system.write_all_text fs_path

  get_command ()
  |> runtime.command_get_matches_from
      ($'$"_ fable -f \\\"{!fs_path}\\\" -c \\\"typescript\\\""' |> runtime.split_args |> resultm.get)
  |> run Verbose
  |> async.block_on_futures
  |> resultm.unwrap'
  |> sm'.deserialize
  |> resultm.unwrap'
  |> mapm.get ("command_result" |> sm'.to_std_string)
  |> optionm'.unwrap
  |> sm'.from_std_string
  |> sm'.deserialize
  |> resultm.unwrap'
  |> fun result =>
      result
      |> mapm.get ("extension" |> sm'.to_std_string)
      |> optionm'.unwrap
      |> sm'.from_std_string
      |> _assert_eq "ts"
      result
      |> mapm.get ("output" |> sm'.to_std_string)
      |> optionm'.unwrap
      |> sm'.from_std_string
      |> _assert_eq "-3"
  """,
  timeout: 300_000
)
```

