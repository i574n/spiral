### get_workspace_cargo_toml_content

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"inl get_workspace_cargo_toml_content { workspace_root contract } : string =\n    inl msrv_aware_resolver_for_near_cargo = contract\n    inl cargo_features : string =\n        if msrv_aware_resolver_for_near_cargo\n        then $'$\"cargo-features = [\\\\\\\"profile-rustflags\\\\\\\", \\\\\\\"edition2024\\\\\\\"]\"'\n        else $'$\"cargo-features = [\\\\\\\"profile-rustflags\\\\\\\"]\"'\n    inl resolver : string =\n        if msrv_aware_resolver_for_near_cargo\n        then $'$\"resolver = \\\\\\\"3\\\\\\\"\"'\n        else $'$\"resolver = \\\\\\\"2\\\\\\\"\"'\n    cargo_features\n    ++\\# $'$\"\"'\n    ++\\# $'$\"[workspace]\"'\n    ++\\# resolver\n    ++\\# $'$\"members = [\\\\\\\"packages/Rust/*\\\\\\\"]\"'\n    ++\\# $'$\"\"'\n    ++\\# $'$\"[workspace.dependencies]\"'\n    ++\\# $'$\"inline_colorization = \\\\\\\"~0.1\\\\\\\"\"'\n    ++\\# $'$\"\"'\n    ++\\# $'$\"[profile.dev]\"'\n    ++\\# $'$\"codegen-units = 256\"'\n    ++\\# $'$\"opt-level = 0\"'\n    ++\\# $'$\"lto = false\"'\n    ++\\# $'$\"debug = 1\"'\n    ++\\# $'$\"panic = \\\\\\\"unwind\\\\\\\"\"'\n    ++\\# $'$\"rustflags = [\\\\\\\"-C\\\\\\\", \\\\\\\"link-arg=-s\\\\\\\"]\"'\n    ++\\# $'$\"strip = \\\\\\\"debuginfo\\\\\\\"\"'\n    ++\\# $'$\"rpath = true\"'\n    ++\\# $'$\"\"'\n    ++\\# $'$\"[profile.release]\"'\n    ++\\# $'$\"codegen-units = 1\"'\n    ++\\# $'$\"opt-level = \\\\\\\"z\\\\\\\"\"'\n    ++\\# $'$\"lto = true\"'\n    ++\\# $'$\"debug = false\"'\n    ++\\# $'$\"panic = \\\\\\\"abort\\\\\\\"\"'\n    ++\\# $'$\"overflow-checks = true\"'\n    ++\\# $'$\"rustflags = [\\\\\\\"-C\\\\\\\", \\\\\\\"link-arg=-s\\\\\\\"]\"'","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  inl get_workspace_cargo_toml_content { workspace_root contract } : string =
      inl msrv_aware_resolver_for_near_cargo = contract
      inl cargo_features : string =
          if msrv_aware_resolver_for_near_cargo
          then $'$"cargo-features = [\\\"profile-rustflags\\\", \\\"edition2024\\\"]"'
          else $'$"cargo-features = [\\\"profile-rustflags\\\"]"'
      inl resolver : string =
          if msrv_aware_resolver_for_near_cargo
          then $'$"resolver = \\\"3\\\""'
          else $'$"resolver = \\\"2\\\""'
      cargo_features
      ++\# $'$""'
      ++\# $'$"[workspace]"'
      ++\# resolver
      ++\# $'$"members = [\\\"packages/Rust/*\\\"]"'
      ++\# $'$""'
      ++\# $'$"[workspace.dependencies]"'
      ++\# $'$"inline_colorization = \\\"~0.1\\\""'
      ++\# $'$""'
      ++\# $'$"[profile.dev]"'
      ++\# $'$"codegen-units = 256"'
      ++\# $'$"opt-level = 0"'
      ++\# $'$"lto = false"'
      ++\# $'$"debug = 1"'
      ++\# $'$"panic = \\\"unwind\\\""'
      ++\# $'$"rustflags = [\\\"-C\\\", \\\"link-arg=-s\\\"]"'
      ++\# $'$"strip = \\\"debuginfo\\\""'
      ++\# $'$"rpath = true"'
      ++\# $'$""'
      ++\# $'$"[profile.release]"'
      ++\# $'$"codegen-units = 1"'
      ++\# $'$"opt-level = \\\"z\\\""'
      ++\# $'$"lto = true"'
      ++\# $'$"debug = false"'
      ++\# $'$"panic = \\\"abort\\\""'
      ++\# $'$"overflow-checks = true"'
      ++\# $'$"rustflags = [\\\"-C\\\", \\\"link-arg=-s\\\"]"'
  """,
  timeout: 300_000
)
```

### get_cargo_toml_content

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"inl get_cargo_toml_content { hash runtime deps } : string =\n    $'$\"cargo-features = [\\\\\\\"edition2024\\\\\\\"]\"'\n    ++\\# $'$\"\"'\n    ++\\# $'$\"[package]\"'\n    ++\\# $'$\"name = \\\\\\\"spiral_{!hash}\\\\\\\"\"'\n    ++\\# $'$\"version = \\\\\\\"0.0.1\\\\\\\"\"'\n    ++\\# $'$\"edition = \\\\\\\"2024\\\\\\\"\"'\n    ++\\# $'$\"\"'\n    ++\\# $'$\"[dependencies]\"'\n    ++\\# $'$\"inline_colorization = {{ workspace = true }}\"'\n    ++\\# $'$\"{!deps}\"'\n    ++\\# $'$\"\"'\n    ++\\# (\n        if runtime = None then\n            $'$\"[[bin]]\"'\n            ++\\# $'$\"name = \\\\\\\"spiral_{!hash}\\\\\\\"\"'\n        else\n            $'$\"[lib]\"'\n            ++\\# $'$\"crate-type = [\\\\\\\"cdylib\\\\\\\"]\"'\n    )\n    ++\\# $'$\"path = \\\\\\\"spiral.rs\\\\\\\"\"'","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  inl get_cargo_toml_content { hash runtime deps } : string =
      $'$"cargo-features = [\\\"edition2024\\\"]"'
      ++\# $'$""'
      ++\# $'$"[package]"'
      ++\# $'$"name = \\\"spiral_{!hash}\\\""'
      ++\# $'$"version = \\\"0.0.1\\\""'
      ++\# $'$"edition = \\\"2024\\\""'
      ++\# $'$""'
      ++\# $'$"[dependencies]"'
      ++\# $'$"inline_colorization = {{ workspace = true }}"'
      ++\# $'$"{!deps}"'
      ++\# $'$""'
      ++\# (
          if runtime = None then
              $'$"[[bin]]"'
              ++\# $'$"name = \\\"spiral_{!hash}\\\""'
          else
              $'$"[lib]"'
              ++\# $'$"crate-type = [\\\"cdylib\\\"]"'
      )
      ++\# $'$"path = \\\"spiral.rs\\\""'
  """,
  timeout: 300_000
)
```

### get_empty_cargo_toml_content

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"inl get_empty_cargo_toml_content () =\n    inl guid = date_time.now () |> date_time.new_guid_from_date_time |> sm'.obj_to_string\n    $'$\"[package]\"'\n    ++\\# $'$\"name = \\\\\\\"spiral_{!guid}\\\\\\\"\"'\n    ++\\# $'$\"version = \\\\\\\"0.0.1\\\\\\\"\"'\n    ++\\# $'$\"edition = \\\\\\\"2021\\\\\\\"\"'\n    ++\\# $'$\"\"'\n    ++\\# $'$\"[[bin]]\"'\n    ++\\# $'$\"name = \\\\\\\"spiral_{!guid}\\\\\\\"\"'\n    ++\\# $'$\"path = \\\\\\\"spiral.rs\\\\\\\"\"'","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  inl get_empty_cargo_toml_content () =
      inl guid = date_time.now () |> date_time.new_guid_from_date_time |> sm'.obj_to_string
      $'$"[package]"'
      ++\# $'$"name = \\\"spiral_{!guid}\\\""'
      ++\# $'$"version = \\\"0.0.1\\\""'
      ++\# $'$"edition = \\\"2021\\\""'
      ++\# $'$""'
      ++\# $'$"[[bin]]"'
      ++\# $'$"name = \\\"spiral_{!guid}\\\""'
      ++\# $'$"path = \\\"spiral.rs\\\""'
  """,
  timeout: 300_000
)
```

