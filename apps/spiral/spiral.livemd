### process_cuda

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":":= process_cuda { py_path env deps } =\n    := extension = \"py\"\n\n    := new_code_path = py_path\n    := new_code = new_code_path |> file_system.read_all_text\n\n    := workspace_root_external = file_system.get_workspace_root_external ()\n    := workspace_root = workspace_root_external |> resultm.box |> resultm.unwrap_or_else id\n\n    := package_dir = new_code_path |> file_system.directory_get_parent |> optionm'.default_value' \"\"\n\n    := manifest_path =\n        ?= env ?|\n        | Pip => package_dir </> \"requirements.txt\"\n        | Poetry => package_dir </> \"pyproject.toml\"\n\n    := deps =\n        deps\n        |> am'.vec_map \\ dep =>\n            := dep = dep |> sm'.from_std_string\n            ? dep |> sm'.contains \"=\"\n            ?> dep\n            |? dep |> sm'.ends_with \"]\"\n            ?> dep |> sm'.replace \"[\" $'$\"={{version=\\'*\\',features=[\"' |> \\ x => $'$\"{!x}}}\"'\n            |: $'$\"{!dep}=\\'*\\'\"'\n        |> am'.from_vec\n        |> \\ x => x : array _\n        |> seq.of_array'\n        |> sm'.concat \"\\n\"\n\n    := exit_code, run_result =\n        ? deps = \"\"\n        ?> 0, \"\"\n        |:\n            := manifest =\n                ?= env ?|\n                | Pip =>\n                    deps\n                | Poetry =>\n                    $'$\"[tool.poetry]\"'\n                    ++\\# $'$\"name = \\\\\\\"test\\\\\\\"\"'\n                    ++\\# $'$\"version = \\\\\\\"0.0.1\\\\\\\"\"'\n                    ++\\# $'$\"description = \\\\\\\"\\\\\\\"\"'\n                    ++\\# $'$\"authors = []\"'\n                    ++\\# $'$\"\"'\n                    ++\\# $'$\"[tool.poetry.dependencies]\"'\n                    ++\\# $'$\"python=\\\\\\\"~3.12\\\\\\\"\"'\n                    ++\\# $'$\"{!deps}\"'\n                    ++\\# $'$\"\"'\n                    ++\\# $'$\"[build-system]\"'\n                    ++\\# $'$\"requires = [\\\\\\\"poetry-core\\\\\\\"]\"'\n                    ++\\# $'$\"build-backend = \\\\\\\"poetry.core.masonry.api\\\\\\\"\"'\n\n            manifest |> file_system.write_all_text_exists manifest_path\n\n            runtime.execution_options \\ x => { x ?|\n                command =\n                    ?= env ?|\n                    | Pip => $'$\"pip install -r requirements.txt\"'\n                    | Poetry => $'$\"poetry install\"'\n                working_directory = package_dir |> optionm'.some'\n            }\n            |> runtime.execute_with_options\n\n    ? exit_code <>. 0 ?>\n        failwith (\"spiral.process_cuda / env install error\\n\" ++# run_result)\n    |:\n        := command =\n            ?= env ?|\n            | Pip => $'$\"python \\\\\\\"{!new_code_path}\\\\\\\"\"'\n            | Poetry => $'$\"poetry run python \\\\\\\"{!new_code_path}\\\\\\\"\"'\n        := environment_variables =\n            ;[\n                \"TRACE_LEVEL\", \"Verbose\"\n            ]\n        := exit_code, run_result =\n            runtime.execution_options \\ x => { x ?|\n                command\n                environment_variables = am'.base environment_variables\n                working_directory = package_dir |> optionm'.some'\n            }\n            |> runtime.execute_with_options\n\n        := external_command =\n            := vars =\n                environment_variables\n                |> arraym.map \\ k, v => $'$\"$env:{!k}=\\'\\'{!v}\\'\\'\"' : string\n                |> \\ x => x : array _\n                |> seq.of_array\n                |> sm'.concat \";\"\n            $'$\"pwsh -c \\'{!vars}; {!command}\\'\"' : string\n        ? exit_code = 0 ?>\n            := output =\n                try\n                    \\ () =>\n                        run_result\n                        |> sm'.split \"\\n\"\n                        |> \\ x => array x : array _\n                        |> seq.of_array\n                        |> sm'.concat \"\\n\"\n                    \\ ex =>\n                        trace Critical\n                            \\ () => \"spiral.process_cuda / Exception\"\n                            \\ () => { ex run_result new_code_path external_command }\n                        None\n                |> optionm'.box\n                |> optionm'.unwrap\n\n            {\n                extension = Some extension\n                code = Some new_code\n                code_path = Some new_code_path\n                output = Some output\n            }\n        |:\n            failwith (\"spiral.process_cuda / child failed\\n\" ++# run_result)","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  := process_cuda { py_path env deps } =
      := extension = "py"

      := new_code_path = py_path
      := new_code = new_code_path |> file_system.read_all_text

      := workspace_root_external = file_system.get_workspace_root_external ()
      := workspace_root = workspace_root_external |> resultm.box |> resultm.unwrap_or_else id

      := package_dir = new_code_path |> file_system.directory_get_parent |> optionm'.default_value' ""

      := manifest_path =
          ?= env ?|
          | Pip => package_dir </> "requirements.txt"
          | Poetry => package_dir </> "pyproject.toml"

      := deps =
          deps
          |> am'.vec_map \ dep =>
              := dep = dep |> sm'.from_std_string
              ? dep |> sm'.contains "="
              ?> dep
              |? dep |> sm'.ends_with "]"
              ?> dep |> sm'.replace "[" $'$"={{version=\'*\',features=["' |> \ x => $'$"{!x}}}"'
              |: $'$"{!dep}=\'*\'"'
          |> am'.from_vec
          |> \ x => x : array _
          |> seq.of_array'
          |> sm'.concat "\n"

      := exit_code, run_result =
          ? deps = ""
          ?> 0, ""
          |:
              := manifest =
                  ?= env ?|
                  | Pip =>
                      deps
                  | Poetry =>
                      $'$"[tool.poetry]"'
                      ++\# $'$"name = \\\"test\\\""'
                      ++\# $'$"version = \\\"0.0.1\\\""'
                      ++\# $'$"description = \\\"\\\""'
                      ++\# $'$"authors = []"'
                      ++\# $'$""'
                      ++\# $'$"[tool.poetry.dependencies]"'
                      ++\# $'$"python=\\\"~3.12\\\""'
                      ++\# $'$"{!deps}"'
                      ++\# $'$""'
                      ++\# $'$"[build-system]"'
                      ++\# $'$"requires = [\\\"poetry-core\\\"]"'
                      ++\# $'$"build-backend = \\\"poetry.core.masonry.api\\\""'

              manifest |> file_system.write_all_text_exists manifest_path

              runtime.execution_options \ x => { x ?|
                  command =
                      ?= env ?|
                      | Pip => $'$"pip install -r requirements.txt"'
                      | Poetry => $'$"poetry install"'
                  working_directory = package_dir |> optionm'.some'
              }
              |> runtime.execute_with_options

      ? exit_code <>. 0 ?>
          failwith ("spiral.process_cuda / env install error\n" ++# run_result)
      |:
          := command =
              ?= env ?|
              | Pip => $'$"python \\\"{!new_code_path}\\\""'
              | Poetry => $'$"poetry run python \\\"{!new_code_path}\\\""'
          := environment_variables =
              ;[
                  "TRACE_LEVEL", "Verbose"
              ]
          := exit_code, run_result =
              runtime.execution_options \ x => { x ?|
                  command
                  environment_variables = am'.base environment_variables
                  working_directory = package_dir |> optionm'.some'
              }
              |> runtime.execute_with_options

          := external_command =
              := vars =
                  environment_variables
                  |> arraym.map \ k, v => $'$"$env:{!k}=\'\'{!v}\'\'"' : string
                  |> \ x => x : array _
                  |> seq.of_array
                  |> sm'.concat ";"
              $'$"pwsh -c \'{!vars}; {!command}\'"' : string
          ? exit_code = 0 ?>
              := output =
                  try
                      \ () =>
                          run_result
                          |> sm'.split "\n"
                          |> \ x => array x : array _
                          |> seq.of_array
                          |> sm'.concat "\n"
                      \ ex =>
                          trace Critical
                              \ () => "spiral.process_cuda / Exception"
                              \ () => { ex run_result new_code_path external_command }
                          None
                  |> optionm'.box
                  |> optionm'.unwrap

              {
                  extension = Some extension
                  code = Some new_code
                  code_path = Some new_code_path
                  output = Some output
              }
          |:
              failwith ("spiral.process_cuda / child failed\n" ++# run_result)
  """,
  timeout: 300_000
)
```

## cpp

<!-- livebook:{"break_markdown":true} -->

### process_cpp

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":":= process_cpp { cpp_path } =\n    := extension = \"cpp\"\n\n    := new_code_path = cpp_path\n    := new_code = new_code_path |> file_system.read_all_text\n\n    := package_dir = new_code_path |> file_system.directory_get_parent |> optionm'.default_value' \"\"\n\n    := cxx =\n        := cxx = \"SPIRAL_CXX\" |> env.get_environment_variable\n        ? cxx = \"\" ?> \"g++\" |: cxx\n    := exe_path = new_code_path ++# \".out\" ++# (? platform.is_windows () ?> \".exe\" |: \"\")\n\n    := build_command =\n        cxx ++# \" -std=c++20 -O2 -w \\\"\" ++# new_code_path ++# \"\\\" -o \\\"\" ++# exe_path ++# \"\\\" -lm\"\n    := exit_code, build_result =\n        runtime.execution_options \\ x => { x ?|\n            command = build_command\n            working_directory = package_dir |> optionm'.some'\n        }\n        |> runtime.execute_with_options\n\n    ? exit_code <>. 0 ?>\n        failwith (\"spiral.process_cpp / build failed\\n\" ++# build_result)\n    |:\n        := command = \"\\\"\" ++# exe_path ++# \"\\\"\"\n        := exit_code, run_result =\n            runtime.execution_options \\ x => { x ?|\n                command\n                working_directory = package_dir |> optionm'.some'\n            }\n            |> runtime.execute_with_options\n\n        ? exit_code = 0 ?>\n            {\n                extension = Some extension\n                code = Some new_code\n                code_path = Some new_code_path\n                output = Some run_result\n            }\n        |:\n            failwith (\"spiral.process_cpp / child failed\\n\" ++# run_result)","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  := process_cpp { cpp_path } =
      := extension = "cpp"

      := new_code_path = cpp_path
      := new_code = new_code_path |> file_system.read_all_text

      := package_dir = new_code_path |> file_system.directory_get_parent |> optionm'.default_value' ""

      := cxx =
          := cxx = "SPIRAL_CXX" |> env.get_environment_variable
          ? cxx = "" ?> "g++" |: cxx
      := exe_path = new_code_path ++# ".out" ++# (? platform.is_windows () ?> ".exe" |: "")

      := build_command =
          cxx ++# " -std=c++20 -O2 -w \"" ++# new_code_path ++# "\" -o \"" ++# exe_path ++# "\" -lm"
      := exit_code, build_result =
          runtime.execution_options \ x => { x ?|
              command = build_command
              working_directory = package_dir |> optionm'.some'
          }
          |> runtime.execute_with_options

      ? exit_code <>. 0 ?>
          failwith ("spiral.process_cpp / build failed\n" ++# build_result)
      |:
          := command = "\"" ++# exe_path ++# "\""
          := exit_code, run_result =
              runtime.execution_options \ x => { x ?|
                  command
                  working_directory = package_dir |> optionm'.some'
              }
              |> runtime.execute_with_options

          ? exit_code = 0 ?>
              {
                  extension = Some extension
                  code = Some new_code
                  code_path = Some new_code_path
                  output = Some run_result
              }
          |:
              failwith ("spiral.process_cpp / child failed\n" ++# run_result)
  """,
  timeout: 300_000
)
```

