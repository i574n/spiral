ing ] |> am'.to_vec)\n        deps\n        |> am'.vec_map fun dep =>\n            inl dep = dep |> sm'.from_std_string\n            if dep |> sm'.contains \"=\"\n            then dep\n            elif dep |> sm'.ends_with \"]\"\n            then dep |> sm'.replace \"[\" $'$\"={{version=\\'*\\',features=[\"' |> fun x => $'$\"{!x}}}\"'\n            else $'$\"{!dep}=\\'*\\'\"'\n        |> am'.from_vec\n        |> fun x => x : _ i32 _\n        |> seq.of_array'\n        |> sm'.concat \"\\n\"\n\n    inl new_code_path = package_dir </> $'$\"{!workspace_name}.{!extension}\"'\n\n    inl cargo_toml_content = get_cargo_toml_content { hash runtime deps }\n    inl workspace_cargo_toml_content = get_workspace_cargo_toml_content { workspace_root contract }\n\n    cargo_toml_content |> file_system.write_all_text_exists cargo_toml_path\n    workspace_cargo_toml_content |> file_system.write_all_text_exists workspace_cargo_toml_path\n\n    inl main_code : string =\n        if runtime = None\n        then \"\"\n        else\n            $'$\"\\#[near_sdk::near_bindgen]\"'\n            ++\\# $'$\"\\#[derive(near_sdk::PanicOnDefault)]\"'\n            ++\\# $'$\"pub struct MainState {{\"'\n            ++\\# $'$\"}}\"'\n            ++\\# $'$\"\"'\n            ++\\# $'$\"\\#[near_sdk::near_bindgen]\"'\n            ++\\# $'$\"impl MainState {{\"'\n            ++\\# $'$\"    pub fn state_main() {{\"'\n            ++\\# $'$\"        spiral_main();\"'\n            ++\\# $'$\"    }}\"'\n            ++\\# $'$\"}}\"'\n\n    inl new_code =\n        if main_code = \"\"\n        then code\n        else $'$\"{!code}\\\\n\\\\n{!main_code}\\\\n\"'\n\n    new_code |> file_system.write_all_text_exists new_code_path\n\n    inl exit_code, cargo_fmt_result =\n        fun () =>\n            inl exit_code, result =\n                execution_options fun x => { x with\n                    command = $'$\"cargo fmt --manifest-path \\\\\\\"{!cargo_toml_path}\\\\\\\" --\"'\n                    working_directory = workspace_root_external |> resultm.box |> resultm.ok'\n                }\n                |> execute_with_options\n\n            inl return () =\n                if exit_code = 0\n                then Ok (exit_code, result)\n                else Error (exit_code, result)\n\n            if result |> sm'.contains \"failed to load manifest for workspace member\" |> not\n            then return ()\n            else\n                inl missing_toml_path =\n                    \"failed to read `(?<a>.*?Cargo.toml)`\"\n                    |> sm'.new_regex\n                    |> resultm.unwrap'\n                    |> sm'.regex_captures result\n                    |> am'.from_vec\n                    |> fun x => x : _ i32 _\n                    |> am'.try_item 0\n                    |> optionm.map (mapm.get \"a\" >> optionm'.unbox)\n                    |> optionm'.flatten\n                match missing_toml_path with\n                | None => Error (exit_code, result)\n                | Some missing_toml_path =>\n                    if missing_toml_path |> file_system.file_exists |> not then\n                        missing_toml_path\n                        |> file_system.directory_get_parent\n                        |> optionm'.default_value' \"\"\n                        |> file_system.create_dir\n                        |> ignore\n                        get_empty_cargo_toml_content ()\n                        |> file_system.write_all_text missing_toml_path\n                    return ()\n        |> retry_fn' 3u8\n\n    if exit_code <>. 0 then\n        trace Critical\n            fun () => \"spiral.process_rust / cargo fmt error\"\n            fun () => { exit_code cargo_fmt_result }\n\n    inl new_code = new_code_path |> file_system.read_all_text\n\n    inl command =\n        if runtime <> None\n        then $'$\"cargo +nightly-2024-07-14 build --timings --release --target wasm32-unknown-unknown --manifest-path \\\\\\\"{!cargo_toml_path}\\\\\\\"\"'\n        else $'$\"cargo run --timings --manifest-path \\\\\\\"{!cargo_toml_path}\\\\\\\"\"'\n    inl environment_variables =\n        if runtime <> None\n        then ;[]\n        else\n            inl fast = false\n            ;[\n                \"TRACE_LEVEL\", \"Verbose\"\n                \"RUSTC_WRAPPER\", \"sccache\"\n                \"RUST_BACKTRACE\", \"full\"\n                \"RUSTFLAGS\",\n                if fast\n                then \"-C prefer-dynamic -C strip=symbols -C link-arg=-s -C debuginfo=0\"\n                else \"-C prefer-dynamic\"\n            ]\n    inl exit_code, cargo_result =\n        execution_options fun x => { x with\n            command\n            environment_variables\n            working_directory = workspace_root_external |> resultm.box |> resultm.ok'\n        }\n        |> execute_with_options\n\n    inl result, error =\n        if runtime = None then\n            inl external_command =\n                inl vars =\n                    a environment_variables\n                    |> am.map fun k, v => $'$\"$env:{!k}=\\'\\'{!v}\\'\\'\"' : string\n                    |> fun x => x : _ i32 _\n                    |> seq.of_array\n                    |> sm'.concat \";\"\n                inl command =\n                    a ;[\n                        vars\n                        command\n                    ]\n                    |> fun x => x : _ i32 _\n                    |> seq.of_array\n                    |> sm'.concat \";\"\n                $'$\"pwsh -c \\'{!command}\\'\"' : string\n            if exit_code <>. 0 then\n                trace Critical\n                    fun () => \"spiral.process_rust / error\"\n                    fun () => { exit_code new_code_path external_command cleanup cargo_result }\n                result', \"spiral.process_rust / error / \" ++#? { exit_code new_code_path external_command } ++# \"\\n\" ++# cargo_result\n            else\n                inl output =\n                    try\n                        fun () =>\n                            cargo_result\n                            |> sm'.split \"\\n\"\n                            |> fun x => a x : _ i32 _\n                            |> am'.skip_while fun line =>\n                                (line |> sm'.contains \"profile [optimized] target\" |> not)\n                                    && (line |> sm'.contains \"profile [unoptimized] target\" |> not)\n                                    && (line |> sm'.contains \"profile [unoptimized + debuginfo] target\" |> not)\n                            |> am'.skip 2\n                            |> seq.of_array\n                            |> sm'.concat \"\\n\"\n                        fun ex =>\n                            trace Critical\n                                fun () => \"spiral.process_rust / Exception\"\n                                fun () => { ex new_code_path external_command cargo_result }\n                            None\n                    |> optionm'.box\n                    |> optionm'.unwrap\n                { result' with\n                    code = Some new_code\n                    code_path = Some new_code_path\n                    output = Some output\n                }, \"\"\n        else\n            inl wasm_path : string =\n                $'$\"target/spiral/{!workspace_dir_name}/target/wasm32-unknown-unknown/release/spiral_{!hash}.wasm\"'\n\n            inl spiral_wasm_command : string =\n                inl runtime_cmd =\n                    match runtime with\n                    | Some (Wasm cmd) => cmd\n                    | Some (Contract cmd) => cmd\n                    | _ => \"\"\n                $'$\"workspace/target/release/spiral_wasm -w {!wasm_path} -t debug {!runtime_cmd}\"'\n            inl command =\n                inl invoke_block_path = \"scripts/invoke-block.ps1\"\n                inl automation = \"AUTOMATION\" |> env.get_environment_variable\n                $'$\"pwsh -c \\\\\\\"pwsh {!invoke_block_path} $env:SPIRAL_WASM_COMMAND -Linux -EnvironmentVariables AUTOMATION={!automation}\\`nNEAR_RPC_TIMEOUT_SECS=100\\\\\\\"\"'\n\n            if exit_code = 0 then\n                inl exit_code, spiral_wasm_result =\n                    execution_options fun x => { x with\n                        command\n                        environment_variables = ;[ \"SPIRAL_WASM_COMMAND\", spiral_wasm_command ]\n                        working_directory = workspace_root |> optionm'.some'\n                    }\n                    |> execute_with_options\n\n                if exit_code = 0 then\n                    { result' with\n                        code = Some new_code\n                        code_path = Some new_code_path\n                        output = Some spiral_wasm_result\n                    }, \"\"\n                else\n                    trace Critical\n                        fun () => \"spiral.process_rust / wasm error\"\n                        fun () => {\n                            exit_code new_code_path cargo_result cleanup\n                            spiral_wasm_result = $'$\"\\\\n{!spiral_wasm_result}\"' : string\n                        }\n                    result', \"spiral.process_rust / wasm error / \" ++#? { exit_code new_code_path } ++# \"\\n\" ++# spiral_wasm_result\n            else\n                trace Critical\n                    fun () => \"spiral.process_rust / cargo error\"\n                    fun () => {\n                        exit_code new_code_path wasm_path command cleanup\n                        cargo_result = $'$\"\\\\n{!cargo_result}\"' : string\n                    }\n                result', \"spiral.process_rust / cargo error / \" ++#? { exit_code new_code_path } ++# \"\\n\" ++# cargo_result\n\n    inl ci = \"CI\" |> env.get_environment_variable\n\n    if cleanup || ci <> \"\" then\n        package_dir |> file_system.directory_delete true\n\n        inl cleanup =\n            inl build_target =\n                if runtime <> None\n                then \"wasm32-unknown-unknown/release\"\n                else \"debug\"\n\n            [ \".d\"; \".exe\"; \".pdb\"; \".wasm\"; \"\" ]\n            |> listm.map fun ext =>\n                workspace_dir </> $'$\"target/{!build_target}/spiral_{!hash}{!ext}\"'\n            |> listm.map fun path => path, path |> file_system.file_exists\n\n        trace Verbose\n            fun () => \"spiral.process_rust / cleanup\"\n            fun () => { new_code_path cleanup }\n\n        cleanup\n        |> listm'.filter snd\n        |> listm.iter (fst >> file_system.file_delete)\n\n    if error <> \"\" then\n        run_target function\n            | Rust => fun () => $'{ eprintln\\!(\"{}\", !error); std::process::exit(1) }' : ()\n            | _ => fun () => failwith error\n    result","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  inl process_rust { rs_path deps trace_level runtime cleanup } =
      open runtime

      inl extension = "rs"
      inl code = rs_path |> file_system.read_all_text

      inl hash = #?{ extension code runtime } |> crypto.hash_text

      inl workspace_name = "spiral"
      inl contract = runtime <> None
      inl workspace_dir_name : string = if contract then "spiral_contract" else workspace_name

      inl workspace_root_external = file_system.get_workspace_root_external ()
      inl workspace_root = workspace_root_external |> resultm.box |> resultm.unwrap_or_else id

      inl package_dir =
          get_package_dir { workspace_root name = workspace_dir_name; target = Some Rust; hash = hash |> Some }

      package_dir |> file_system.create_dir |> ignore

      inl workspace_dir = package_dir </> "../../.."
      inl workspace_cargo_toml_path = workspace_dir </> "Cargo.toml"

      if workspace_cargo_toml_path |> file_system.file_exists |> not
      then get_empty_cargo_toml_content () |> file_system.write_all_text workspace_cargo_toml_path

      inl cargo_toml_path = package_dir </> "Cargo.toml"

      inl result' = {
          extension = Some extension
          code = None
          code_path = None
          output = None
      }

      inl deps =
          inl deps =
              if runtime = None
              then deps
              else
                  inl has_near_sdk =
                      deps
                      |> am'.vec_filter (sm'.from_std_string >> sm'.contains "near-sdk")
                      |> am'.vec_len
                      |> convert.i32
                      |> fun (n : int) => n > 0
                  if has_near_sdk
                  then deps
                  else deps |> am'.vec_extend (;[ "near-sdk=\"=5.11.0\"" |> sm'.to_std_string ] |> am'.to_vec)
                  |> am'.vec_extend (;[ "indexmap=\"=2.11.4\"" |> sm'.to_std_string ] |> am'.to_vec)
          deps
          |> am'.vec_map fun dep =>
              inl dep = dep |> sm'.from_std_string
              if dep |> sm'.contains "="
              then dep
              elif dep |> sm'.ends_with "]"
              then dep |> sm'.replace "[" $'$"={{version=\'*\',features=["' |> fun x => $'$"{!x}}}"'
              else $'$"{!dep}=\'*\'"'
          |> am'.from_vec
          |> fun x => x : _ i32 _
          |> seq.of_array'
          |> sm'.concat "\n"

      inl new_code_path = package_dir </> $'$"{!workspace_name}.{!extension}"'

      inl cargo_toml_content = get_cargo_toml_content { hash runtime deps }
      inl workspace_cargo_toml_content = get_workspace_cargo_toml_content { workspace_root contract }

      cargo_toml_content |> file_system.write_all_text_exists cargo_toml_path
      workspace_cargo_toml_content |> file_system.write_all_text_exists workspace_cargo_toml_path

      inl main_code : string =
          if runtime = None
          then ""
          else
              $'$"\#[near_sdk::near_bindgen]"'
              ++\# $'$"\#[derive(near_sdk::PanicOnDefault)]"'
              ++\# $'$"pub struct MainState {{"'
              ++\# $'$"}}"'
              ++\# $'$""'
              ++\# $'$"\#[near_sdk::near_bindgen]"'
              ++\# $'$"impl MainState {{"'
              ++\# $'$"    pub fn state_main() {{"'
              ++\# $'$"        spiral_main();"'
              ++\# $'$"    }}"'
              ++\# $'$"}}"'

      inl new_code =
          if main_code = ""
          then code
          else $'$"{!code}\\n\\n{!main_code}\\n"'

      new_code |> file_system.write_all_text_exists new_code_path

      inl exit_code, cargo_fmt_result =
          fun () =>
              inl exit_code, result =
                  execution_options fun x => { x with
                      command = $'$"cargo fmt --manifest-path \\\"{!cargo_toml_path}\\\" --"'
                      working_directory = workspace_root_external |> resultm.box |> resultm.ok'
                  }
                  |> execute_with_options

              inl return () =
                  if exit_code = 0
                  then Ok (exit_code, result)
                  else Error (exit_code, result)

              if result |> sm'.contains "failed to load manifest for workspace member" |> not
              then return ()
              else
                  inl missing_toml_path =
                      "failed to read `(?<a>.*?Cargo.toml)`"
                      |> sm'.new_regex
                      |> resultm.unwrap'
                      |> sm'.regex_captures result
                      |> am'.from_vec
                      |> fun x => x : _ i32 _
                      |> am'.try_item 0
                      |> optionm.map (mapm.get "a" >> optionm'.unbox)
                      |> optionm'.flatten
                  match missing_toml_path with
                  | None => Error (exit_code, result)
                  | Some missing_toml_path =>
                      if missing_toml_path |> file_system.file_exists |> not then
                          missing_toml_path
                          |> file_system.directory_get_parent
                          |> optionm'.default_value' ""
                          |> file_system.create_dir
                          |> ignore
                          get_empty_cargo_toml_content ()
                          |> file_system.write_all_text missing_toml_path
                      return ()
          |> retry_fn' 3u8

      if exit_code <>. 0 then
          trace Critical
              fun () => "spiral.process_rust / cargo fmt error"
              fun () => { exit_code cargo_fmt_result }

      inl new_code = new_code_path |> file_system.read_all_text

      inl command =
          if runtime <> None
          then $'$"cargo +nightly-2024-07-14 build --timings --release --target wasm32-unknown-unknown --manifest-path \\\"{!cargo_toml_path}\\\""'
          else $'$"cargo run --timings --manifest-path \\\"{!cargo_toml_path}\\\""'
      inl environment_variables =
          if runtime <> None
          then ;[]
          else
              inl fast = false
              ;[
                  "TRACE_LEVEL", "Verbose"
                  "RUSTC_WRAPPER", "sccache"
                  "RUST_BACKTRACE", "full"
                  "RUSTFLAGS",
                  if fast
                  then "-C prefer-dynamic -C strip=symbols -C link-arg=-s -C debuginfo=0"
                  else "-C prefer-dynamic"
              ]
      inl exit_code, cargo_result =
          execution_options fun x => { x with
              command
              environment_variables
              working_directory = workspace_root_external |> resultm.box |> resultm.ok'
          }
          |> execute_with_options

      inl result, error =
          if runtime = None then
              inl external_command =
                  inl vars =
                      a environment_variables
                      |> am.map fun k, v => $'$"$env:{!k}=\'\'{!v}\'\'"' : string
                      |> fun x => x : _ i32 _
                      |> seq.of_array
                      |> sm'.concat ";"
                  inl command =
                      a ;[
                          vars
                          command
                      ]
                      |> fun x => x : _ i32 _
                      |> seq.of_array
                      |> sm'.concat ";"
                  $'$"pwsh -c \'{!command}\'"' : string
              if exit_code <>. 0 then
                  trace Critical
                      fun () => "spiral.process_rust / error"
                      fun () => { exit_code new_code_path external_command cleanup cargo_result }
                  result', "spiral.process_rust / error / " ++#? { exit_code new_code_path external_command } ++# "\n" ++# cargo_result
              else
                  inl output =
                      try
                          fun () =>
                              cargo_result
                              |> sm'.split "\n"
                              |> fun x => a x : _ i32 _
                              |> am'.skip_while fun line =>
                                  (line |> sm'.contains "profile [optimized] target" |> not)
                                      && (line |> sm'.contains "profile [unoptimized] target" |> not)
                                      && (line |> sm'.contains "profile [unoptimized + debuginfo] target" |> not)
                              |> am'.skip 2
                              |> seq.of_array
                              |> sm'.concat "\n"
                          fun ex =>
                              trace Critical
                                  fun () => "spiral.process_rust / Exception"
                                  fun () => { ex new_code_path external_command cargo_result }
                              None
                      |> optionm'.box
                      |> optionm'.unwrap
                  { result' with
                      code = Some new_code
                      code_path = Some new_code_path
                      output = Some output
                  }, ""
          else
              inl wasm_path : string =
                  $'$"target/spiral/{!workspace_dir_name}/target/wasm32-unknown-unknown/release/spiral_{!hash}.wasm"'

              inl spiral_wasm_command : string =
                  inl runtime_cmd =
                      match runtime with
                      | Some (Wasm cmd) => cmd
                      | Some (Contract cmd) => cmd
                      | _ => ""
                  $'$"workspace/target/release/spiral_wasm -w {!wasm_path} -t debug {!runtime_cmd}"'
              inl command =
                  inl invoke_block_path = "scripts/invoke-block.ps1"
                  inl automation = "AUTOMATION" |> env.get_environment_variable
                  $'$"pwsh -c \\\"pwsh {!invoke_block_path} $env:SPIRAL_WASM_COMMAND -Linux -EnvironmentVariables AUTOMATION={!automation}\`nNEAR_RPC_TIMEOUT_SECS=100\\\""'

              if exit_code = 0 then
                  inl exit_code, spiral_wasm_result =
                      execution_options fun x => { x with
                          command
                          environment_variables = ;[ "SPIRAL_WASM_COMMAND", spiral_wasm_command ]
                          working_directory = workspace_root |> optionm'.some'
                      }
                      |> execute_with_options

                  if exit_code = 0 then
                      { result' with
                          code = Some new_code
                          code_path = Some new_code_path
                          output = Some spiral_wasm_result
                      }, ""
                  else
                      trace Critical
                          fun () => "spiral.process_rust / wasm error"
                          fun () => {
                              exit_code new_code_path cargo_result cleanup
                              spiral_wasm_result = $'$"\\n{!spiral_wasm_result}"' : string
                          }
                      result', "spiral.process_rust / wasm error / " ++#? { exit_code new_code_path } ++# "\n" ++# spiral_wasm_result
              else
                  trace Critical
                      fun () => "spiral.process_rust / cargo error"
                      fun () => {
                          exit_code new_code_path wasm_path command cleanup
                          cargo_result = $'$"\\n{!cargo_result}"' : string
                      }
                  result', "spiral.process_rust / cargo error / " ++#? { exit_code new_code_path } ++# "\n" ++# cargo_result

      inl ci = "CI" |> env.get_environment_variable

      if cleanup || ci <> "" then
          package_dir |> file_system.directory_delete true

          inl cleanup =
              inl build_target =
                  if runtime <> None
                  then "wasm32-unknown-unknown/release"
                  else "debug"

              [ ".d"; ".exe"; ".pdb"; ".wasm"; "" ]
              |> listm.map fun ext =>
                  workspace_dir </> $'$"target/{!build_target}/spiral_{!hash}{!ext}"'
              |> listm.map fun path => path, path |> file_system.file_exists

          trace Verbose
              fun () => "spiral.process_rust / cleanup"
              fun () => { new_code_path cleanup }

          cleanup
          |> listm'.filter snd
          |> listm.iter (fst >> file_system.file_delete)

      if error <> "" then
          run_target function
              | Rust => fun () => $'{ eprintln\!("{}", !error); std::process::exit(1) }' : ()
              | _ => fun () => failwith error
      result
  """,
  timeout: 300_000
)
```

## export

<!-- livebook:{"break_markdown":true} -->

### escape_cell (test)

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"///- --test static\n\ninl escape_cell t =\n    trace Verbose (fun () => \"spiral.escape_cell\") (fun () => { t_len = ##t })\n    t\n    |> sm'.split \"\\n\"\n    |> am'.to_list_base'\n    |> listm'.unbox\n    |> listm.map function\n        | line when (line |> sm'.starts_with \"\\\\#!\") || (line |> sm'.starts_with \"\\\\#r\") =>\n            inl len = ##line\n            let rec 루프 i =\n                if i >= len\n                then line\n                else\n                    match line |> sm'.index i with\n                    | '\\\\' =>\n                        match line |> sm'.index (i + 1) with\n                        | '#' => (line |> sm'.slice 0i32 i) ++# (line |> sm'.slice (i + 1) (len - i - 1))\n                        | _ => 루프 (i + 1)\n                    | _ => 루프 (i + 1)\n            루프 0\n        | line => line\n    |> sm'.concat_list \"\\n\"","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  ///- --test static

  inl escape_cell t =
      trace Verbose (fun () => "spiral.escape_cell") (fun () => { t_len = ##t })
      t
      |> sm'.split "\n"
      |> am'.to_list_base'
      |> listm'.unbox
      |> listm.map function
          | line when (line |> sm'.starts_with "\\#!") || (line |> sm'.starts_with "\\#r") =>
              inl len = ##line
              let rec 루프 i =
                  if i >= len
                  then line
                  else
                      match line |> sm'.index i with
                      | '\\' =>
                          match line |> sm'.index (i + 1) with
                          | '#' => (line |> sm'.slice 0i32 i) ++# (line |> sm'.slice (i + 1) (len - i - 1))
                          | _ => 루프 (i + 1)
                      | _ => 루프 (i + 1)
              루프 0
          | line => line
      |> sm'.concat_list "\n"
  """,
  timeout: 300_000
)
```

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"///- --test\n///> fsharp\n///> gleam\n\n\"a\\n\\#!magic\\nb\\n\"\n|> escape_cell\n|> _assert_eq \"a\\n#!magic\\nb\\n\"","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  ///- --test
  ///> fsharp
  ///> gleam

  "a\n\#!magic\nb\n"
  |> escape_cell
  |> _assert_eq "a\n#!magic\nb\n"
  """,
  timeout: 300_000
)
```

