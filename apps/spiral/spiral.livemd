### get_package_dir

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"let get_package_dir { workspace_root target name hash } =\n    inl dir = workspace_root </> \"target/spiral\" </> name\n    match hash, (target : option package_target) with\n    | Some hash, Some target => dir </> \"packages\" </> (target |> reflection.union_to_string) </> hash\n    | _ => dir","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  let get_package_dir { workspace_root target name hash } =
      inl dir = workspace_root </> "target/spiral" </> name
      match hash, (target : option package_target) with
      | Some hash, Some target => dir </> "packages" </> (target |> reflection.union_to_string) </> hash
      | _ => dir
  """,
  timeout: 300_000
)
```

### persist_code_project

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"let persist_code_project { workspace_root package_dir packages modules name code } =\n    package_dir |> file_system.create_dir |> ignore\n\n    inl fs_path = package_dir </> $'$\"{!name}.fs\"' |> file_system.normalize_path\n    code |> file_system.write_all_text_exists fs_path\n\n    inl modules_code =\n        modules\n        |> listm.map fun path =>\n            inl path = workspace_root </> path\n            $'$\"<Compile Include=\\\\\\\"{!path}\\\\\\\" />\"' : string\n        |> listm'.box\n        |> seq.of_list'\n        |> sm'.concat \"\\\\n        \"\n\n    inl packages_code =\n        packages\n        |> listm.map fun (package : string), (version : string) =>\n            $'$\"<PackageReference Include=\\\\\\\"{!package}\\\\\\\" Version=\\\\\\\"{!version}\\\\\\\" />\"' : string\n        |> listm'.box\n        |> seq.of_list'\n        |> sm'.concat \"\\\\n        \"\n\n    inl fsproj_path = package_dir </> $'$\"{!name}.fsproj\"' |> file_system.normalize_path\n    inl fsproj_code : string =\n        $'$\"<Project Sdk=\\\\\\\"Microsoft.NET.Sdk\\\\\\\">\"'\n        ++\\# $'$\"<PropertyGroup>\"'\n        ++\\# $'$\"    <TargetFramework>net9.0</TargetFramework>\"'\n        ++\\# $'$\"    <LangVersion>preview</LangVersion>\"'\n        ++\\# $'$\"    <RollForward>Major</RollForward>\"'\n        ++\\# $'$\"    <TargetLatestRuntimePatch>true</TargetLatestRuntimePatch>\"'\n        ++\\# $'$\"    <PublishAot>false</PublishAot>\"'\n        ++\\# $'$\"    <PublishTrimmed>false</PublishTrimmed>\"'\n        ++\\# $'$\"    <PublishSingleFile>true</PublishSingleFile>\"'\n        ++\\# $'$\"    <SelfContained>true</SelfContained>\"'\n        ++\\# $'$\"    <Version>0.0.1-alpha.1</Version>\"'\n        ++\\# $'$\"    <OutputType>Exe</OutputType>\"'\n        ++\\# $'$\"    <ServerGarbageCollection>true</ServerGarbageCollection>\"'\n        ++\\# $'$\"    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>\"'\n        ++\\# $'$\"</PropertyGroup>\"'\n\n        ++\\# $'$\"<PropertyGroup Condition=\\\\\\\"$([MSBuild]::IsOSPlatform(\\'FreeBSD\\'))\\\\\\\">\"'\n        ++\\# $'$\"    <DefineConstants>_FREEBSD</DefineConstants>\"'\n        ++\\# $'$\"</PropertyGroup>\"'\n\n        ++\\# $'$\"<PropertyGroup Condition=\\\\\\\"$([MSBuild]::IsOSPlatform(\\'Linux\\'))\\\\\\\">\"'\n        ++\\# $'$\"    <DefineConstants>_LINUX</DefineConstants>\"'\n        ++\\# $'$\"</PropertyGroup>\"'\n\n        ++\\# $'$\"<PropertyGroup Condition=\\\\\\\"$([MSBuild]::IsOSPlatform(\\'OSX\\'))\\\\\\\">\"'\n        ++\\# $'$\"    <DefineConstants>_OSX</DefineConstants>\"'\n        ++\\# $'$\"</PropertyGroup>\"'\n\n        ++\\# $'$\"<PropertyGroup Condition=\\\\\\\"$([MSBuild]::IsOSPlatform(\\'Windows\\'))\\\\\\\">\"'\n        ++\\# $'$\"    <DefineConstants>_WINDOWS</DefineConstants>\"'\n        ++\\# $'$\"</PropertyGroup>\"'\n\n        ++\\# $'$\"<ItemGroup>\"'\n        ++\\# $'$\"    {!modules_code}\"'\n        ++\\# $'$\"    <Compile Include=\\\\\\\"{!fs_path}\\\\\\\" />\"'\n        ++\\# $'$\"</ItemGroup>\"'\n\n        ++\\# $'$\"<ItemGroup>\"'\n        ++\\# $'$\"    {!packages_code}\"'\n        ++\\# $'$\"</ItemGroup>\"'\n\n        ++\\# $'$\"</Project>\"'\n\n    fsproj_code |> file_system.write_all_text_exists fsproj_path\n\n    fsproj_path","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  let persist_code_project { workspace_root package_dir packages modules name code } =
      package_dir |> file_system.create_dir |> ignore

      inl fs_path = package_dir </> $'$"{!name}.fs"' |> file_system.normalize_path
      code |> file_system.write_all_text_exists fs_path

      inl modules_code =
          modules
          |> listm.map fun path =>
              inl path = workspace_root </> path
              $'$"<Compile Include=\\\"{!path}\\\" />"' : string
          |> listm'.box
          |> seq.of_list'
          |> sm'.concat "\\n        "

      inl packages_code =
          packages
          |> listm.map fun (package : string), (version : string) =>
              $'$"<PackageReference Include=\\\"{!package}\\\" Version=\\\"{!version}\\\" />"' : string
          |> listm'.box
          |> seq.of_list'
          |> sm'.concat "\\n        "

      inl fsproj_path = package_dir </> $'$"{!name}.fsproj"' |> file_system.normalize_path
      inl fsproj_code : string =
          $'$"<Project Sdk=\\\"Microsoft.NET.Sdk\\\">"'
          ++\# $'$"<PropertyGroup>"'
          ++\# $'$"    <TargetFramework>net9.0</TargetFramework>"'
          ++\# $'$"    <LangVersion>preview</LangVersion>"'
          ++\# $'$"    <RollForward>Major</RollForward>"'
          ++\# $'$"    <TargetLatestRuntimePatch>true</TargetLatestRuntimePatch>"'
          ++\# $'$"    <PublishAot>false</PublishAot>"'
          ++\# $'$"    <PublishTrimmed>false</PublishTrimmed>"'
          ++\# $'$"    <PublishSingleFile>true</PublishSingleFile>"'
          ++\# $'$"    <SelfContained>true</SelfContained>"'
          ++\# $'$"    <Version>0.0.1-alpha.1</Version>"'
          ++\# $'$"    <OutputType>Exe</OutputType>"'
          ++\# $'$"    <ServerGarbageCollection>true</ServerGarbageCollection>"'
          ++\# $'$"    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>"'
          ++\# $'$"</PropertyGroup>"'

          ++\# $'$"<PropertyGroup Condition=\\\"$([MSBuild]::IsOSPlatform(\'FreeBSD\'))\\\">"'
          ++\# $'$"    <DefineConstants>_FREEBSD</DefineConstants>"'
          ++\# $'$"</PropertyGroup>"'

          ++\# $'$"<PropertyGroup Condition=\\\"$([MSBuild]::IsOSPlatform(\'Linux\'))\\\">"'
          ++\# $'$"    <DefineConstants>_LINUX</DefineConstants>"'
          ++\# $'$"</PropertyGroup>"'

          ++\# $'$"<PropertyGroup Condition=\\\"$([MSBuild]::IsOSPlatform(\'OSX\'))\\\">"'
          ++\# $'$"    <DefineConstants>_OSX</DefineConstants>"'
          ++\# $'$"</PropertyGroup>"'

          ++\# $'$"<PropertyGroup Condition=\\\"$([MSBuild]::IsOSPlatform(\'Windows\'))\\\">"'
          ++\# $'$"    <DefineConstants>_WINDOWS</DefineConstants>"'
          ++\# $'$"</PropertyGroup>"'

          ++\# $'$"<ItemGroup>"'
          ++\# $'$"    {!modules_code}"'
          ++\# $'$"    <Compile Include=\\\"{!fs_path}\\\" />"'
          ++\# $'$"</ItemGroup>"'

          ++\# $'$"<ItemGroup>"'
          ++\# $'$"    {!packages_code}"'
          ++\# $'$"</ItemGroup>"'

          ++\# $'$"</Project>"'

      fsproj_code |> file_system.write_all_text_exists fsproj_path

      fsproj_path
  """,
  timeout: 300_000
)
```

### publish_project

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"inl publish_project runtime' output_dir path =\n    inl full_path = path |> file_system.get_full_path\n    inl file_dir = full_path |> file_system.directory_get_parent |> optionm'.default_value' \"\"\n    inl extension = full_path |> file_system.get_extension\n\n    trace Debug\n        fun () => \"publish_project\"\n        fun () => { full_path }\n\n    match extension with\n    | \"fsproj\" => ()\n    | _ => failwith $'$\"app.publish_project / Invalid project file / extension: {!extension}\"'\n\n    inl runtimes =\n        runtime'\n        |> optionm.map listm.singleton\n        |> optionm'.default_value [ \"linux-x64\"; \"win-x64\" ]\n\n    inl output_dir = output_dir |> optionm'.default_value \"dist\"\n\n    runtimes\n    |> listm.map fun runtime' =>\n        runtime.execution_options fun x => { x with\n            command = $'$\"dotnet publish \\\\\\\"{!path}\\\\\\\" --configuration Release --output \\\\\\\"{!output_dir}\\\\\\\" --runtime {!runtime'}\"'\n            working_directory = file_dir |> Some |> optionm'.box\n        }\n        |> runtime.execute_with_options\n        |> fst\n    |> listm'.sum","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  inl publish_project runtime' output_dir path =
      inl full_path = path |> file_system.get_full_path
      inl file_dir = full_path |> file_system.directory_get_parent |> optionm'.default_value' ""
      inl extension = full_path |> file_system.get_extension

      trace Debug
          fun () => "publish_project"
          fun () => { full_path }

      match extension with
      | "fsproj" => ()
      | _ => failwith $'$"app.publish_project / Invalid project file / extension: {!extension}"'

      inl runtimes =
          runtime'
          |> optionm.map listm.singleton
          |> optionm'.default_value [ "linux-x64"; "win-x64" ]

      inl output_dir = output_dir |> optionm'.default_value "dist"

      runtimes
      |> listm.map fun runtime' =>
          runtime.execution_options fun x => { x with
              command = $'$"dotnet publish \\\"{!path}\\\" --configuration Release --output \\\"{!output_dir}\\\" --runtime {!runtime'}"'
              working_directory = file_dir |> Some |> optionm'.box
          }
          |> runtime.execute_with_options
          |> fst
      |> listm'.sum
  """,
  timeout: 300_000
)
```

### publish_code

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"inl publish_code { workspace_root runtime packages modules output_dir name code } =\n    inl package_dir = get_package_dir { workspace_root name target = None; hash = None }\n    inl fsproj_path = persist_code_project { workspace_root package_dir packages modules name code }\n    inl exit_code = fsproj_path |> publish_project runtime output_dir\n    if exit_code <>. 0 then\n        trace Critical\n            fun () => \"publish_code\"\n            fun () => {\n                code = code |> sm'.ellipsis_end 400\n                fsproj_text = fsproj_path |> file_system.read_all_text\n            }\n    exit_code","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  inl publish_code { workspace_root runtime packages modules output_dir name code } =
      inl package_dir = get_package_dir { workspace_root name target = None; hash = None }
      inl fsproj_path = persist_code_project { workspace_root package_dir packages modules name code }
      inl exit_code = fsproj_path |> publish_project runtime output_dir
      if exit_code <>. 0 then
          trace Critical
              fun () => "publish_code"
              fun () => {
                  code = code |> sm'.ellipsis_end 400
                  fsproj_text = fsproj_path |> file_system.read_all_text
              }
      exit_code
  """,
  timeout: 300_000
)
```

