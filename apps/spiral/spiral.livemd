## main

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"///> _\n\ninl run_main (args : array_base string) : i32 =\n    inl trace_state = get_trace_state_or_init (Debug |> Some)\n    inl json_protocol = (env.get_environment_variable \"SPIRAL_JSON\") = \"1\"\n    inl trace_enabled = trace_state.enabled\n    if json_protocol then trace_enabled <- false\n\n    trace Debug\n        fun () => \"spiral.main\"\n        fun () => { args }\n\n    inl command = get_command ()\n    inl arg_matches = command |> runtime.command_get_matches\n\n    inl trace_state_level = trace_state.level\n\n    inl result =\n        arg_matches\n        |> run *trace_state_level\n        |> async.block_on_futures\n        |> resultm.unwrap'\n\n    if json_protocol || *trace_state_level = Info\n    then result |> console.write_line\n\n    0i32\n\ninl main () =\n    if is_rust () then\n        inl args =\n            $'Rc::new(RefCell::new(std::env::args().skip(1).map(|x| Rc::<str>::from(x)).collect::<Vec<Rc<str>>>()))'\n            : array_base string\n        run_main args |> ignore\n    else\n        $'let tests () = !tests ()' : ()\n        $'let main args = !run_main args' : ()","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  ///> _

  inl run_main (args : array_base string) : i32 =
      inl trace_state = get_trace_state_or_init (Debug |> Some)
      inl json_protocol = (env.get_environment_variable "SPIRAL_JSON") = "1"
      inl trace_enabled = trace_state.enabled
      if json_protocol then trace_enabled <- false

      trace Debug
          fun () => "spiral.main"
          fun () => { args }

      inl command = get_command ()
      inl arg_matches = command |> runtime.command_get_matches

      inl trace_state_level = trace_state.level

      inl result =
          arg_matches
          |> run *trace_state_level
          |> async.block_on_futures
          |> resultm.unwrap'

      if json_protocol || *trace_state_level = Info
      then result |> console.write_line

      0i32

  inl main () =
      if is_rust () then
          inl args =
              $'Rc::new(RefCell::new(std::env::args().skip(1).map(|x| Rc::<str>::from(x)).collect::<Vec<Rc<str>>>()))'
              : array_base string
          run_main args |> ignore
      else
          $'let tests () = !tests ()' : ()
          $'let main args = !run_main args' : ()
  """,
  timeout: 300_000
)
```
