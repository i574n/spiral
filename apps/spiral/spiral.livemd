### get_args

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"inl get_args () =\n    {\n        gleam = \"gleam\", {\n            gleam_path = \"gleam-path\", 'g'\n            target = \"target\", 't'\n            deps = \"deps\", 'd'\n        }\n        lua = \"lua\", {\n            lua_path = \"lua-path\", 'l'\n        }\n        cuda = \"cuda\", {\n            py_path = \"py-path\", 'p'\n            env = \"env\", 'e'\n            deps = \"deps\", 'd'\n        }\n        cpp = \"cpp\", {\n            cpp_path = \"cpp-path\", 'c'\n        }\n        rust = \"rust\", {\n            rs_path = \"rs-path\", 'r'\n            deps = \"deps\", 'd'\n            wasm = \"wasm\", 'w'\n            contract = \"contract\", 'c'\n            cleanup = \"cleanup\", 'l'\n        }\n        notebook_export = \"export\", {\n            entries = \"entries\", 'e'\n        }\n    }","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  inl get_args () =
      {
          gleam = "gleam", {
              gleam_path = "gleam-path", 'g'
              target = "target", 't'
              deps = "deps", 'd'
          }
          lua = "lua", {
              lua_path = "lua-path", 'l'
          }
          cuda = "cuda", {
              py_path = "py-path", 'p'
              env = "env", 'e'
              deps = "deps", 'd'
          }
          cpp = "cpp", {
              cpp_path = "cpp-path", 'c'
          }
          rust = "rust", {
              rs_path = "rs-path", 'r'
              deps = "deps", 'd'
              wasm = "wasm", 'w'
              contract = "contract", 'c'
              cleanup = "cleanup", 'l'
          }
          notebook_export = "export", {
              entries = "entries", 'e'
          }
      }
  """,
  timeout: 300_000
)
```

### get_command

