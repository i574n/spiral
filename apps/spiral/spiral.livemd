### process_gleam

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"inl process_gleam { gleam_path target deps } =\n    inl extension = \"gleam\"\n\n    inl new_code_path = gleam_path\n    inl new_code = new_code_path |> file_system.read_all_text\n\n    inl hash = #?{ extension new_code } |> crypto.hash_text\n\n    inl workspace_root_external = file_system.get_workspace_root_external ()\n    inl workspace_root =\n        workspace_root_external |> resultm.box |> resultm.unwrap_or_else id |> file_system.standardize_path\n\n    inl src_dir =\n        new_code_path\n        |> file_system.directory_get_parent\n        |> optionm'.default_value' \"\"\n        |> file_system.standardize_path\n\n    inl package_dir = src_dir </> \"..\" |> file_system.standardize_path\n\n    fun () =>\n        inl ci = \"CI\" |> env.get_environment_variable\n        if ci <> \"\" then\n            package_dir\n            |> file_system.directory_delete true\n    |> new_disposable\n    |> fun x => x : _ ()\n    |> use\n    |> ignore\n\n    inl manifest_path = package_dir </> \"gleam.toml\"\n\n    inl deps =\n        ;[\n            \"gleam_stdlib=\\\"0.57.0\\\"\"\n            \"gleam_time=\\\">=1.0.0 and <2.0.0\\\"\"\n            \"gleam_erlang=\\\">=0.34.0 and <1.0.0\\\"\"\n            \"envoy=\\\">=1.0.0 and <2.0.0\\\"\"\n            \"gary=\\\">=1.1.0 and <2.0.0\\\"\"\n            \"gtempo=\\\">=7.1.0 and <8.0.0\\\"\"\n        ]\n        |> am'.to_vec\n        |> am'.vec_map sm'.to_std_string\n        |> am'.vec_extend deps\n        |> am'.vec_map fun dep =>\n            inl dep = dep |> sm'.from_std_string\n            if dep |> sm'.contains \"=\"\n            then dep\n            elif dep |> sm'.ends_with \"]\"\n            then dep |> sm'.replace \"[\" $'$\"={{version=\\'*\\',features=[\"' |> fun x => $'$\"{!x}}}\"'\n            else $'$\"{!dep}=\\'*\\'\"'\n        |> am'.from_vec\n        |> fun x => x : _ i32 _\n        |> seq.of_array'\n        |> sm'.concat \"\\n\"\n\n    inl target' = target |> reflection.union_to_string |> sm'.to_lower\n\n    inl manifest =\n        inl main =\n            if new_code_path |> sm'.contains \"_real\"\n            then \"main_real\"\n            else \"main\"\n        $'$\"name = \\\\\\\"{!main}\\\\\\\"\"'\n        ++\\# $'$\"target = \\\\\\\"{!target'}\\\\\\\"\"'\n        ++\\# $'$\"\"'\n        ++\\# $'$\"[dependencies]\"'\n        ++\\# $'$\"{!deps}\"'\n\n    manifest |> file_system.write_all_text_exists manifest_path\n\n    inl exit_code, run_result =\n        0i32, \"\"\n\n    if exit_code <>. 0 then\n        trace Critical\n            fun () => \"spiral.process_gleam / check error\"\n            fun () => { exit_code run_result new_code_path }\n        { extension = Some extension; code = None; code_path = None; output = None }\n    else\n        inl command =\n            if target = Erlang\n            then $'$\"gleam run --no-print-progress \\\\\\\"{!new_code_path}\\\\\\\"\"' : string\n            else $'$\"gleam build --no-print-progress\"'\n        inl environment_variables =\n            ;[\n                \"TRACE_LEVEL\", \"\"\n                \"GLEAM_LOG\", \"\"\n                \"GLEAM_LOG_NOCOLOUR\", \"\"\n            ]\n        inl exit_code, run_result =\n            runtime.execution_options fun x => { x with\n                command\n                environment_variables\n                working_directory = package_dir |> optionm'.some'\n                stderr = false\n            }\n            |> runtime.execute_with_options\n\n        inl external_command =\n            inl vars =\n                a environment_variables\n                |> am.map fun k, v => $'$\"$env:{!k}=\\'\\'{!v}\\'\\'\"' : string\n                |> fun x => x : _ i32 _\n                |> seq.of_array\n                |> sm'.concat \";\"\n            $'$\"pwsh -c \\'{!vars}; {!command}\\'\"' : string\n        if exit_code <>. 0 then\n            trace Critical\n                fun () => \"spiral.process_gleam / error\"\n                fun () => { exit_code run_result new_code_path external_command }\n            { extension = Some extension; code = None; code_path = None; output = None }\n        else\n            inl run_result =\n                if target = Erlang\n                then run_result\n                else\n                    inl js_path = $'$\"{!package_dir}/build/dev/javascript/main/main.mjs\"'\n                    inl js_text = js_path |> file_system.read_all_text\n                    inl js_text = js_text |> sm'.replace $'$\"\\#app_\"' $'$\"\\#app_{!hash}\"'\n                    if js_text |> sm'.ends_with \"main()\" |> not then\n                        $'$\"{!js_text}\\nmain()\"'\n                        |> file_system.write_all_text_exists js_path\n\n                    inl exit_code, run_result =\n                        runtime.execution_options fun x => { x with\n                            command =\n                                $'$\"bunx --bun esbuild --bundle --minify --loader:.wasm=file --outdir={!src_dir} {!js_path}\"'\n                            environment_variables =\n                                match \"~/.bun/bin\" |> env.append_path with\n                                | Some path => ;[ \"PATH\", path ]\n                                | None => ;[]\n                            working_directory = package_dir |> optionm'.some'\n                        }\n                        |> runtime.execute_with_options\n\n                    if exit_code <>. 0 then\n                        trace Critical\n                            fun () => \"spiral.process_gleam / esbuild error\"\n                            fun () => { exit_code run_result new_code_path }\n                        \"\"\n                    else\n                        inl html =\n                            $'$\"<\\!DOCTYPE html>\"'\n                            ++\\# $'$\"<html lang=\\\\\\\"en\\\\\\\">\"'\n                            ++\\# $'$\"  <head>\"'\n                            ++\\# $'$\"    <meta charset=\\\\\\\"UTF-8\\\\\\\" />\"'\n                            ++\\# $'$\"    <meta name=\\\\\\\"viewport\\\\\\\" content=\\\\\\\"width=device-width, initial-scale=1.0\\\\\\\" />\"'\n                            ++\\# $'$\"    <link\"'\n                            ++\\# $'$\"      data-trunk\"'\n                            ++\\# $'$\"      rel=\\\\\\\"inline\\\\\\\"\"'\n                            ++\\# $'$\"      href=\\\\\\\"../build/packages/lustre_ui/priv/static/lustre_ui.css\\\\\\\"\"'\n                            ++\\# $'$\"    />\"'\n                            ++\\# $'$\"    <link\"'\n                            ++\\# $'$\"      data-trunk\"'\n                            ++\\# $'$\"      rel=\\\\\\\"inline\\\\\\\"\"'\n                            ++\\# $'$\"      type=\\\\\\\"module\\\\\\\"\"'\n                            ++\\# $'$\"      href=\\\\\\\"main.js\\\\\\\"\"'\n                            ++\\# $'$\"    />\"'\n                            ++\\# $'$\"  </head>\"'\n                            ++\\# $'$\"  <body>\"'\n                            ++\\# $'$\"    <div id=\\\\\\\"app_{!hash}\\\\\\\"></div>\"'\n                            ++\\# $'$\"  </body>\"'\n                            ++\\# $'$\"</html>\"'\n\n                        inl html_path = $'$\"{!src_dir}/index.html\"'\n                        html |> file_system.write_all_text_exists html_path\n\n                        \"\" |> file_system.write_all_text_exists $'$\"{!src_dir}/spiral_{!hash}.rs\"'\n\n                        inl manifest =\n                            $'$\"[package]\"'\n                            ++\\# $'$\"name = \\\\\\\"spiral_{!hash}\\\\\\\"\"'\n                            ++\\# $'$\"\"'\n                            ++\\# $'$\"[workspace]\"'\n                            ++\\# $'$\"\"'\n                            ++\\# $'$\"[lib]\"'\n                            ++\\# $'$\"crate-type = [\\\\\\\"cdylib\\\\\\\", \\\\\\\"rlib\\\\\\\"]\"'\n                            ++\\# $'$\"path = \\\\\\\"spiral_{!hash}.rs\\\\\\\"\"'\n                            ++\\# $'$\"\"'\n                            ++\\# $'$\"[dependencies]\"'\n\n                        manifest |> file_system.write_all_text_exists $'$\"{!src_dir}/Cargo.toml\"'\n\n                        inl exit_code, run_result =\n                            runtime.execution_options fun x => { x with\n                                command = $'$\"trunk build --release --minify --dist={!src_dir} --public-url=./ --no-sri\"'\n                                environment_variables =\n                                    ;[\n                                        \"TRUNK_TOOLS_WASM_BINDGEN\", \"0.2.93\"\n                                    ]\n                                working_directory = src_dir |> optionm'.some'\n                            }\n                            |> runtime.execute_with_options\n\n                        if exit_code = 0\n                        then html_path |> file_system.read_all_text\n                        else\n                            trace Critical\n                                fun () => \"spiral.process_gleam / trunk error\"\n                                fun () => { exit_code run_result new_code_path }\n                            \"\"\n\n            inl run_result' = run_result |> sm'.to_std_string\n\n            inl output =\n                try\n                    fun () =>\n                        run_result\n                        |> sm'.split \"\\n\"\n                        |> am'.to_vec\n                        |> am'.vec_filter fun x =>\n                            (x |> sm'.starts_with \"{compiling,\" |> not)\n                            && (x |> sm'.starts_with \"{compiled,\" |> not)\n                            && (x |> sm'.ends_with \".beam\\\"}\" |> not)\n                            && (x |> sm'.starts_with \"src\\\\main.gleam:\" |> not)\n                            && (x |> sm'.starts_with \"src\\\\main_real.gleam:\" |> not)\n                            && (x |> sm'.starts_with \"src/main.gleam:\" |> not)\n                            && (x |> sm'.starts_with \"src/main_real.gleam:\" |> not)\n                            && (x |> sm'.starts_with \"% \" |> not)\n                        |> am'.from_vec\n                        |> fun x => x : _ int _\n                        |> seq.of_array\n                        |> sm'.concat \"\\n\"\n                        |> sm'.trim_start [ '\\n' ]\n                    fun ex =>\n                        trace Critical\n                            fun () => \"spiral.process_gleam / Exception\"\n                            fun () => { ex run_result' new_code_path external_command }\n                        None\n                |> optionm'.box\n                |> optionm'.unwrap\n\n            {\n                extension = Some extension\n                code = Some new_code\n                code_path = Some new_code_path\n                output = Some output\n            }","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  inl process_gleam { gleam_path target deps } =
      inl extension = "gleam"

      inl new_code_path = gleam_path
      inl new_code = new_code_path |> file_system.read_all_text

      inl hash = #?{ extension new_code } |> crypto.hash_text

      inl workspace_root_external = file_system.get_workspace_root_external ()
      inl workspace_root =
          workspace_root_external |> resultm.box |> resultm.unwrap_or_else id |> file_system.standardize_path

      inl src_dir =
          new_code_path
          |> file_system.directory_get_parent
          |> optionm'.default_value' ""
          |> file_system.standardize_path

      inl package_dir = src_dir </> ".." |> file_system.standardize_path

      fun () =>
          inl ci = "CI" |> env.get_environment_variable
          if ci <> "" then
              package_dir
              |> file_system.directory_delete true
      |> new_disposable
      |> fun x => x : _ ()
      |> use
      |> ignore

      inl manifest_path = package_dir </> "gleam.toml"

      inl deps =
          ;[
              "gleam_stdlib=\"0.57.0\""
              "gleam_time=\">=1.0.0 and <2.0.0\""
              "gleam_erlang=\">=0.34.0 and <1.0.0\""
              "envoy=\">=1.0.0 and <2.0.0\""
              "gary=\">=1.1.0 and <2.0.0\""
              "gtempo=\">=7.1.0 and <8.0.0\""
          ]
          |> am'.to_vec
          |> am'.vec_map sm'.to_std_string
          |> am'.vec_extend deps
          |> am'.vec_map fun dep =>
              inl dep = dep |> sm'.from_std_string
              if dep |> sm'.contains "="
              then dep
              elif dep |> sm'.ends_with "]"
              then dep |> sm'.replace "[" $'$"={{version=\'*\',features=["' |> fun x => $'$"{!x}}}"'
              else $'$"{!dep}=\'*\'"'
          |> am'.from_vec
          |> fun x => x : _ i32 _
          |> seq.of_array'
          |> sm'.concat "\n"

      inl target' = target |> reflection.union_to_string |> sm'.to_lower

      inl manifest =
          inl main =
              if new_code_path |> sm'.contains "_real"
              then "main_real"
              else "main"
          $'$"name = \\\"{!main}\\\""'
          ++\# $'$"target = \\\"{!target'}\\\""'
          ++\# $'$""'
          ++\# $'$"[dependencies]"'
          ++\# $'$"{!deps}"'

      manifest |> file_system.write_all_text_exists manifest_path

      inl exit_code, run_result =
          0i32, ""

      if exit_code <>. 0 then
          trace Critical
              fun () => "spiral.process_gleam / check error"
              fun () => { exit_code run_result new_code_path }
          { extension = Some extension; code = None; code_path = None; output = None }
      else
          inl command =
              if target = Erlang
              then $'$"gleam run --no-print-progress \\\"{!new_code_path}\\\""' : string
              else $'$"gleam build --no-print-progress"'
          inl environment_variables =
              ;[
                  "TRACE_LEVEL", ""
                  "GLEAM_LOG", ""
                  "GLEAM_LOG_NOCOLOUR", ""
              ]
          inl exit_code, run_result =
              runtime.execution_options fun x => { x with
                  command
                  environment_variables
                  working_directory = package_dir |> optionm'.some'
                  stderr = false
              }
              |> runtime.execute_with_options

          inl external_command =
              inl vars =
                  a environment_variables
                  |> am.map fun k, v => $'$"$env:{!k}=\'\'{!v}\'\'"' : string
                  |> fun x => x : _ i32 _
                  |> seq.of_array
                  |> sm'.concat ";"
              $'$"pwsh -c \'{!vars}; {!command}\'"' : string
          if exit_code <>. 0 then
              trace Critical
                  fun () => "spiral.process_gleam / error"
                  fun () => { exit_code run_result new_code_path external_command }
              { extension = Some extension; code = None; code_path = None; output = None }
          else
              inl run_result =
                  if target = Erlang
                  then run_result
                  else
                      inl js_path = $'$"{!package_dir}/build/dev/javascript/main/main.mjs"'
                      inl js_text = js_path |> file_system.read_all_text
                      inl js_text = js_text |> sm'.replace $'$"\#app_"' $'$"\#app_{!hash}"'
                      if js_text |> sm'.ends_with "main()" |> not then
                          $'$"{!js_text}\nmain()"'
                          |> file_system.write_all_text_exists js_path

                      inl exit_code, run_result =
                          runtime.execution_options fun x => { x with
                              command =
                                  $'$"bunx --bun esbuild --bundle --minify --loader:.wasm=file --outdir={!src_dir} {!js_path}"'
                              environment_variables =
                                  match "~/.bun/bin" |> env.append_path with
                                  | Some path => ;[ "PATH", path ]
                                  | None => ;[]
                              working_directory = package_dir |> optionm'.some'
                          }
                          |> runtime.execute_with_options

                      if exit_code <>. 0 then
                          trace Critical
                              fun () => "spiral.process_gleam / esbuild error"
                              fun () => { exit_code run_result new_code_path }
                          ""
                      else
                          inl html =
                              $'$"<\!DOCTYPE html>"'
                              ++\# $'$"<html lang=\\\"en\\\">"'
                              ++\# $'$"  <head>"'
                              ++\# $'$"    <meta charset=\\\"UTF-8\\\" />"'
                              ++\# $'$"    <meta name=\\\"viewport\\\" content=\\\"width=device-width, initial-scale=1.0\\\" />"'
                              ++\# $'$"    <link"'
                              ++\# $'$"      data-trunk"'
                              ++\# $'$"      rel=\\\"inline\\\""'
                              ++\# $'$"      href=\\\"../build/packages/lustre_ui/priv/static/lustre_ui.css\\\""'
                              ++\# $'$"    />"'
                              ++\# $'$"    <link"'
                              ++\# $'$"      data-trunk"'
                              ++\# $'$"      rel=\\\"inline\\\""'
                              ++\# $'$"      type=\\\"module\\\""'
                              ++\# $'$"      href=\\\"main.js\\\""'
                              ++\# $'$"    />"'
                              ++\# $'$"  </head>"'
                              ++\# $'$"  <body>"'
                              ++\# $'$"    <div id=\\\"app_{!hash}\\\"></div>"'
                              ++\# $'$"  </body>"'
                              ++\# $'$"</html>"'

                          inl html_path = $'$"{!src_dir}/index.html"'
                          html |> file_system.write_all_text_exists html_path

                          "" |> file_system.write_all_text_exists $'$"{!src_dir}/spiral_{!hash}.rs"'

                          inl manifest =
                              $'$"[package]"'
                              ++\# $'$"name = \\\"spiral_{!hash}\\\""'
                              ++\# $'$""'
                              ++\# $'$"[workspace]"'
                              ++\# $'$""'
                              ++\# $'$"[lib]"'
                              ++\# $'$"crate-type = [\\\"cdylib\\\", \\\"rlib\\\"]"'
                              ++\# $'$"path = \\\"spiral_{!hash}.rs\\\""'
                              ++\# $'$""'
                              ++\# $'$"[dependencies]"'

                          manifest |> file_system.write_all_text_exists $'$"{!src_dir}/Cargo.toml"'

                          inl exit_code, run_result =
                              runtime.execution_options fun x => { x with
                                  command = $'$"trunk build --release --minify --dist={!src_dir} --public-url=./ --no-sri"'
                                  environment_variables =
                                      ;[
                                          "TRUNK_TOOLS_WASM_BINDGEN", "0.2.93"
                                      ]
                                  working_directory = src_dir |> optionm'.some'
                              }
                              |> runtime.execute_with_options

                          if exit_code = 0
                          then html_path |> file_system.read_all_text
                          else
                              trace Critical
                                  fun () => "spiral.process_gleam / trunk error"
                                  fun () => { exit_code run_result new_code_path }
                              ""

              inl run_result' = run_result |> sm'.to_std_string

              inl output =
                  try
                      fun () =>
                          run_result
                          |> sm'.split "\n"
                          |> am'.to_vec
                          |> am'.vec_filter fun x =>
                              (x |> sm'.starts_with "{compiling," |> not)
                              && (x |> sm'.starts_with "{compiled," |> not)
                              && (x |> sm'.ends_with ".beam\"}" |> not)
                              && (x |> sm'.starts_with "src\\main.gleam:" |> not)
                              && (x |> sm'.starts_with "src\\main_real.gleam:" |> not)
                              && (x |> sm'.starts_with "src/main.gleam:" |> not)
                              && (x |> sm'.starts_with "src/main_real.gleam:" |> not)
                              && (x |> sm'.starts_with "% " |> not)
                          |> am'.from_vec
                          |> fun x => x : _ int _
                          |> seq.of_array
                          |> sm'.concat "\n"
                          |> sm'.trim_start [ '\n' ]
                      fun ex =>
                          trace Critical
                              fun () => "spiral.process_gleam / Exception"
                              fun () => { ex run_result' new_code_path external_command }
                          None
                  |> optionm'.box
                  |> optionm'.unwrap

              {
                  extension = Some extension
                  code = Some new_code
                  code_path = Some new_code_path
                  output = Some output
              }
  """,
  timeout: 300_000
)
```

## lua

<!-- livebook:{"break_markdown":true} -->

### process_lua

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"nominal lua =\n    `(\n        rust_type\n            `($'mlua_Lua')\n            `($'mlua::Lua')\n            \"type mlua_Lua = obj\"\n    )\n\nnominal lua_function =\n    `(\n        rust_type\n            `($'mlua_LuaFunction')\n            `($'mlua::prelude::LuaFunction')\n            \"type mlua_LuaFunction = obj\"\n    )\n\nnominal lua_error =\n    `(\n        rust_type\n            `($'mlua_LuaError')\n            `($'mlua::prelude::LuaError')\n            \"type mlua_LuaError = obj\"\n    )\n\nnominal lua_value =\n    `(\n        rust_type\n            `($'mlua_LuaValue')\n            `($'mlua::prelude::LuaValue')\n            \"type mlua_LuaValue = obj\"\n    )\n\nnominal lua_multi_value =\n    `(\n        rust_type\n            `($'mlua_LuaMultiValue')\n            `($'mlua::prelude::LuaMultiValue')\n            \"type mlua_LuaMultiValue = obj\"\n    )\n\ninl lua_values_debug (values : lua_multi_value) : am'.vec string =\n    run_target_args (fun () => values) function\n        | Rust => fun values =>\n            $'!values.iter().map(|x| Rc::<str>::from(format\\!(\"{:?}\", x))).collect::<Vec<_>>()' : am'.vec string\n        | _ => fun values =>\n            inl values : am'.vec (rust.ref lua_value) = !\\\\(values, $'$\"$0.iter().collect()\"')\n            values |> am'.vec_map (rust.deref >> sm'.format_debug)\n\ninl process_lua { lua_path } =\n    inl extension = \"lua\"\n\n    inl new_code_path = lua_path\n    inl new_code = new_code_path |> file_system.read_all_text\n\n    inl hash = #?{ extension new_code } |> crypto.hash_text\n\n    inl workspace_root_external = file_system.get_workspace_root_external ()\n    inl workspace_root =\n        workspace_root_external |> resultm.box |> resultm.unwrap_or_else id |> file_system.standardize_path\n\n    inl src_dir =\n        new_code_path\n        |> file_system.directory_get_parent\n        |> optionm'.default_value' \"\"\n        |> file_system.standardize_path\n\n    inl package_dir = src_dir </> \"..\" |> file_system.standardize_path\n\n    inl stdio = [] |> mut\n    inl stdio_clone = stdio |> rust.clone\n\n    inl lua : lua =\n        !\\($'$\"mlua::Lua::new_with(mlua::StdLib::ALL_SAFE, mlua::LuaOptions::default()).unwrap()\"')\n\n    inl custom_print (args : lua_multi_value) : _ _ lua_error =\n        inl args =\n            args\n            |> lua_values_debug\n            |> am'.from_vec_base\n            |> am'.to_list_base'\n            |> listm'.unbox\n            |> sm'.concat_list \", \"\n        stdio <- args :: *stdio\n        Ok () |> resultm.box\n\n    inl custom_print : lua_function =\n        !\\\\(\n            (lua, custom_print),\n            $'$\"$0.create_function(move |_, args: mlua::prelude::LuaMultiValue| $1(args)).unwrap()\"'\n        )\n\n    !\\\\((lua, custom_print), $'$\"$0.globals().set(\\\\\\\"print\\\\\\\", $1).unwrap()\"')\n\n    inl output : lua_multi_value =\n        inl new_code = new_code |> sm'.to_std_string\n        !\\\\((lua, new_code), $'$\"$0.load($1).eval::<mlua::MultiValue>().unwrap()\"')\n    inl output =\n        output |> lua_values_debug |> am'.from_vec |> sm'.concat_array \"\\n\"\n\n    inl stdio =\n        *stdio_clone\n        |> listm.rev\n        |> sm'.concat_list \"\\n\"\n\n    fun () =>\n        inl ci = \"CI\" |> env.get_environment_variable\n        if ci <> \"\" then\n            package_dir\n            |> file_system.directory_delete true\n    |> new_disposable\n    |> fun x => x : _ ()\n    |> use\n    |> ignore\n\n    {\n        extension = Some extension\n        code = Some new_code\n        code_path = Some new_code_path\n        output = Some output\n        stdio = Some stdio\n    }","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  nominal lua =
      `(
          rust_type
              `($'mlua_Lua')
              `($'mlua::Lua')
              "type mlua_Lua = obj"
      )

  nominal lua_function =
      `(
          rust_type
              `($'mlua_LuaFunction')
              `($'mlua::prelude::LuaFunction')
              "type mlua_LuaFunction = obj"
      )

  nominal lua_error =
      `(
          rust_type
              `($'mlua_LuaError')
              `($'mlua::prelude::LuaError')
              "type mlua_LuaError = obj"
      )

  nominal lua_value =
      `(
          rust_type
              `($'mlua_LuaValue')
              `($'mlua::prelude::LuaValue')
              "type mlua_LuaValue = obj"
      )

  nominal lua_multi_value =
      `(
          rust_type
              `($'mlua_LuaMultiValue')
              `($'mlua::prelude::LuaMultiValue')
              "type mlua_LuaMultiValue = obj"
      )

  inl lua_values_debug (values : lua_multi_value) : am'.vec string =
      run_target_args (fun () => values) function
          | Rust => fun values =>
              $'!values.iter().map(|x| Rc::<str>::from(format\!("{:?}", x))).collect::<Vec<_>>()' : am'.vec string
          | _ => fun values =>
              inl values : am'.vec (rust.ref lua_value) = !\\(values, $'$"$0.iter().collect()"')
              values |> am'.vec_map (rust.deref >> sm'.format_debug)

  inl process_lua { lua_path } =
      inl extension = "lua"

      inl new_code_path = lua_path
      inl new_code = new_code_path |> file_system.read_all_text

      inl hash = #?{ extension new_code } |> crypto.hash_text

      inl workspace_root_external = file_system.get_workspace_root_external ()
      inl workspace_root =
          workspace_root_external |> resultm.box |> resultm.unwrap_or_else id |> file_system.standardize_path

      inl src_dir =
          new_code_path
          |> file_system.directory_get_parent
          |> optionm'.default_value' ""
          |> file_system.standardize_path

      inl package_dir = src_dir </> ".." |> file_system.standardize_path

      inl stdio = [] |> mut
      inl stdio_clone = stdio |> rust.clone

      inl lua : lua =
          !\($'$"mlua::Lua::new_with(mlua::StdLib::ALL_SAFE, mlua::LuaOptions::default()).unwrap()"')

      inl custom_print (args : lua_multi_value) : _ _ lua_error =
          inl args =
              args
              |> lua_values_debug
              |> am'.from_vec_base
              |> am'.to_list_base'
              |> listm'.unbox
              |> sm'.concat_list ", "
          stdio <- args :: *stdio
          Ok () |> resultm.box

      inl custom_print : lua_function =
          !\\(
              (lua, custom_print),
              $'$"$0.create_function(move |_, args: mlua::prelude::LuaMultiValue| $1(args)).unwrap()"'
          )

      !\\((lua, custom_print), $'$"$0.globals().set(\\\"print\\\", $1).unwrap()"')

      inl output : lua_multi_value =
          inl new_code = new_code |> sm'.to_std_string
          !\\((lua, new_code), $'$"$0.load($1).eval::<mlua::MultiValue>().unwrap()"')
      inl output =
          output |> lua_values_debug |> am'.from_vec |> sm'.concat_array "\n"

      inl stdio =
          *stdio_clone
          |> listm.rev
          |> sm'.concat_list "\n"

      fun () =>
          inl ci = "CI" |> env.get_environment_variable
          if ci <> "" then
              package_dir
              |> file_system.directory_delete true
      |> new_disposable
      |> fun x => x : _ ()
      |> use
      |> ignore

      {
          extension = Some extension
          code = Some new_code
          code_path = Some new_code_path
          output = Some output
          stdio = Some stdio
      }
  """,
  timeout: 300_000
)
```

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"///- --test\n///> rust -d async-walkdir chrono clap encoding_rs encoding_rs_io futures rand rayon regex serde_json sha2 mlua['lua51','vendored']\n\ninl file_name = \"test.lua\"\ninl code =\n    \"1 + 1\"\n\ninl temp_dir, disposable =\n    #?*(file_name, code)\n    |> crypto.hash_text\n    |> file_system.create_temp_dir'\ndisposable |> use |> ignore\ninl path = temp_dir </> file_name |> file_system.normalize_path\n\ncode\n|> file_system.write_all_text path\n\ninl output = process_lua { lua_path = path }\n\n#?output |> console.write_line\n\noutput.output\n|> _assert_eq (\"Integer(2)\" |> Some)\n\noutput.stdio\n|> _assert_eq (\"\" |> Some)\n\n\"print(1 + 1)\"\n|> file_system.write_all_text path\n\ninl output = process_lua { lua_path = path }\n\n#?output |> console.write_line\n\noutput.output\n|> _assert_eq (\"\" |> Some)\n\noutput.stdio\n|> _assert_eq (\"Integer(2)\" |> Some)","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  ///- --test
  ///> rust -d async-walkdir chrono clap encoding_rs encoding_rs_io futures rand rayon regex serde_json sha2 mlua['lua51','vendored']

  inl file_name = "test.lua"
  inl code =
      "1 + 1"

  inl temp_dir, disposable =
      #?*(file_name, code)
      |> crypto.hash_text
      |> file_system.create_temp_dir'
  disposable |> use |> ignore
  inl path = temp_dir </> file_name |> file_system.normalize_path

  code
  |> file_system.write_all_text path

  inl output = process_lua { lua_path = path }

  #?output |> console.write_line

  output.output
  |> _assert_eq ("Integer(2)" |> Some)

  output.stdio
  |> _assert_eq ("" |> Some)

  "print(1 + 1)"
  |> file_system.write_all_text path

  inl output = process_lua { lua_path = path }

  #?output |> console.write_line

  output.output
  |> _assert_eq ("" |> Some)

  output.stdio
  |> _assert_eq ("Integer(2)" |> Some)
  """,
  timeout: 300_000
)
```

