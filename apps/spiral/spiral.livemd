## main

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":"///> _\n\n:= run_main (args : array_base string) : i32 =\n    := trace_state = get_trace_state_or_init (Debug |> Some)\n    := json_protocol = (env.get_environment_variable \"SPIRAL_JSON\") = \"1\"\n    := trace_enabled = trace_state.enabled\n    ? json_protocol ?> trace_enabled <- !-\n\n    trace Debug\n        \\ () => \"spiral.main\"\n        \\ () => { args }\n\n    := command = get_command ()\n    := arg_matches = command |> runtime.command_get_matches\n\n    := trace_state_level = trace_state.level\n\n    := result =\n        arg_matches\n        |> run *trace_state_level\n        |> async.block_on_futures\n        |> resultm.unwrap'\n\n    ? json_protocol || *trace_state_level = Info\n    ?> result |> console.write_line\n\n    0i32\n\n:= main () =\n    ? is_rust () ?>\n        := args =\n            $'Rc::new(RefCell::new(std::env::args().skip(1).map(|x| Rc::<str>::from(x)).collect::<Vec<Rc<str>>>()))'\n            : array_base string\n        run_main args |> ignore\n    |:\n        $'let tests () = !tests ()' : ()\n        $'let main args = !run_main args' : ()","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  ///> _

  := run_main (args : array_base string) : i32 =
      := trace_state = get_trace_state_or_init (Debug |> Some)
      := json_protocol = (env.get_environment_variable "SPIRAL_JSON") = "1"
      := trace_enabled = trace_state.enabled
      ? json_protocol ?> trace_enabled <- !-

      trace Debug
          \ () => "spiral.main"
          \ () => { args }

      := command = get_command ()
      := arg_matches = command |> runtime.command_get_matches

      := trace_state_level = trace_state.level

      := result =
          arg_matches
          |> run *trace_state_level
          |> async.block_on_futures
          |> resultm.unwrap'

      ? json_protocol || *trace_state_level = Info
      ?> result |> console.write_line

      0i32

  := main () =
      ? is_rust () ?>
          := args =
              $'Rc::new(RefCell::new(std::env::args().skip(1).map(|x| Rc::<str>::from(x)).collect::<Vec<Rc<str>>>()))'
              : array_base string
          run_main args |> ignore
      |:
          $'let tests () = !tests ()' : ()
          $'let main args = !run_main args' : ()
  """,
  timeout: 300_000
)
```
