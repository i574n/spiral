### read_file

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"inl read_file path =\n    inl code =\n        path\n        |> file_system.read_all_text\n        |> sm'.replace_regex \"(?P<a> *)(?P<b>let\\\\s+main\\\\s+.*?\\\\s*=)\" \"$a[<EntryPoint>]\\n$a$b\"\n    inl code_trim = code |> sm'.trim_end []\n    if code_trim |> sm'.ends_with \"\\\\n()\"\n    then code_trim |> sm'.slice 0 (##code_trim - 3)\n    else code","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  inl read_file path =
      inl code =
          path
          |> file_system.read_all_text
          |> sm'.replace_regex "(?P<a> *)(?P<b>let\\s+main\\s+.*?\\s*=)" "$a[<EntryPoint>]\n$a$b"
      inl code_trim = code |> sm'.trim_end []
      if code_trim |> sm'.ends_with "\\n()"
      then code_trim |> sm'.slice 0 (##code_trim - 3)
      else code
  """,
  timeout: 300_000
)
```

### persist_file

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"inl persist_file { workspace_root package_dir packages modules path } =\n    inl full_path = path |> file_system.get_full_path\n    inl name = full_path |> file_system.get_file_name_without_extension\n    inl code = full_path |> read_file\n    persist_code_project { workspace_root package_dir packages modules name code }","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  inl persist_file { workspace_root package_dir packages modules path } =
      inl full_path = path |> file_system.get_full_path
      inl name = full_path |> file_system.get_file_name_without_extension
      inl code = full_path |> read_file
      persist_code_project { workspace_root package_dir packages modules name code }
  """,
  timeout: 300_000
)
