### get_command

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":":= command_alias (alias : rust.static_ref sm'.str) (command : runtime.command) : runtime.command =\n    !\\\\((command, alias), $'\"clap::Command::alias($0, $1)\"')\n\n:~ get_command () =\n    ###\"command\"\n    |> runtime.new_command\n    |> runtime.command_subcommand_required !+\n    |> runtime.command_subcommand (\n        ###(get_args () .gleam |> fst)\n        |> runtime.new_command\n        |> runtime.command_init_arg ((get_args () .gleam |> snd).gleam_path) (\n            runtime.arg_required !+\n        )\n        |> runtime.command_init_arg ((get_args () .gleam |> snd).target) (\n            ~> runtime.arg_union `gleam_target ignore\n        )\n        |> runtime.command_init_arg ((get_args () .gleam |> snd).deps) (\n            runtime.arg_value_names (am'.base ;[ ###\"NAME\"; ###\"VERSION\" ])\n            >> runtime.arg_num_args_range (\n                runtime.new_value_range\n                    !-\n                    (am'.Start (1i32 |> convert.convert : convert.unativeint))\n                    (am'.End eval)\n            )\n            >> runtime.arg_action runtime.Append\n        )\n    )\n    |> runtime.command_subcommand (\n        ###(get_args () .cuda |> fst)\n        |> runtime.new_command\n        |> runtime.command_init_arg ((get_args () .cuda |> snd).py_path) (\n            runtime.arg_required !+\n        )\n        |> runtime.command_init_arg ((get_args () .cuda |> snd).env) (\n            ~> runtime.arg_union `cuda_env ignore\n        )\n        |> runtime.command_init_arg ((get_args () .cuda |> snd).deps) (\n            runtime.arg_value_names (am'.base ;[ ###\"NAME\"; ###\"VERSION\" ])\n            >> runtime.arg_num_args_range (\n                runtime.new_value_range\n                    !-\n                    (am'.Start (1i32 |> convert.convert : convert.unativeint))\n                    (am'.End eval)\n            )\n            >> runtime.arg_action runtime.Append\n        )\n    )\n    |> runtime.command_subcommand (\n        ###(get_args () .rust |> fst)\n        |> runtime.new_command\n        |> runtime.command_init_arg ((get_args () .rust |> snd).rs_path) (\n            runtime.arg_required !+\n        )\n        |> runtime.command_init_arg ((get_args () .rust |> snd).deps) (\n            runtime.arg_value_names (am'.base ;[ ###\"NAME\"; ###\"VERSION\" ])\n            >> runtime.arg_num_args_range (\n                runtime.new_value_range\n                    !-\n                    (am'.Start (1i32 |> convert.convert : convert.unativeint))\n                    (am'.End eval)\n            )\n            >> runtime.arg_action runtime.Append\n        )\n        |> runtime.command_init_arg ((get_args () .rust |> snd).wasm) (\n            runtime.arg_num_args_range (\n                runtime.new_value_range\n                    !+\n                    (am'.End eval)\n                    (am'.End \\ _ => (1i32 |> convert.convert : convert.unativeint))\n            )\n            >> runtime.arg_require_equals !+\n            >> runtime.arg_default_missing_value \"\"\n        )\n        |> runtime.command_init_arg ((get_args () .rust |> snd).contract) (\n            runtime.arg_num_args_range (\n                runtime.new_value_range\n                    !+\n                    (am'.End eval)\n                    (am'.End \\ _ => (1i32 |> convert.convert : convert.unativeint))\n            )\n            >> runtime.arg_require_equals !+\n            >> runtime.arg_default_missing_value \"\"\n        )\n        |> runtime.command_init_arg ((get_args () .rust |> snd).cleanup) (\n            runtime.arg_default_value \"true\"\n            >> runtime.arg_action runtime.SetFalse\n        )\n    )\n    |> runtime.command_subcommand (\n        := parse (s : rust.ref sm'.str) : resultm.result' (sm'.std_string * sm'.std_string) sm'.std_string =\n            trace Verbose (\\ () => \"spiral.get_command\") (\\ () => { s })\n            := path = \"\" |> sm'.to_std_string\n            := ext = \"\" |> sm'.to_std_string\n            Ok (path, ext)\n            |> resultm.box\n        ###(get_args () .notebook_export |> fst)\n        |> runtime.new_command\n        |> command_alias ###\"dib-export\"\n        |> runtime.command_init_arg ((get_args () .notebook_export |> snd).entries) (\n            runtime.arg_required !+\n            >> runtime.arg_index 1\n            >> runtime.arg_value_names (am'.base ;[ ###\"PATH\"; ###\"EXT\" ])\n            >> runtime.arg_num_args_range (\n                runtime.new_value_range\n                    !-\n                    (am'.Start (2i32 |> convert.convert : convert.unativeint))\n                    (am'.End eval)\n            )\n            >> runtime.arg_action runtime.Append\n        )\n    )\n    |> runtime.command_subcommand (\n        ###(get_args () .lua |> fst)\n        |> runtime.new_command\n        |> runtime.command_init_arg ((get_args () .lua |> snd).lua_path) (\n            runtime.arg_required !+\n        )\n    )\n    |> runtime.command_subcommand (\n        ###(get_args () .cpp |> fst)\n        |> runtime.new_command\n        |> runtime.command_init_arg ((get_args () .cpp |> snd).cpp_path) (\n            runtime.arg_required !+\n        )\n    )","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  := command_alias (alias : rust.static_ref sm'.str) (command : runtime.command) : runtime.command =
      !\\((command, alias), $'"clap::Command::alias($0, $1)"')

  :~ get_command () =
      ###"command"
      |> runtime.new_command
      |> runtime.command_subcommand_required !+
      |> runtime.command_subcommand (
          ###(get_args () .gleam |> fst)
          |> runtime.new_command
          |> runtime.command_init_arg ((get_args () .gleam |> snd).gleam_path) (
              runtime.arg_required !+
          )
          |> runtime.command_init_arg ((get_args () .gleam |> snd).target) (
              ~> runtime.arg_union `gleam_target ignore
          )
          |> runtime.command_init_arg ((get_args () .gleam |> snd).deps) (
              runtime.arg_value_names (am'.base ;[ ###"NAME"; ###"VERSION" ])
              >> runtime.arg_num_args_range (
                  runtime.new_value_range
                      !-
                      (am'.Start (1i32 |> convert.convert : convert.unativeint))
                      (am'.End eval)
              )
              >> runtime.arg_action runtime.Append
          )
      )
      |> runtime.command_subcommand (
          ###(get_args () .cuda |> fst)
          |> runtime.new_command
          |> runtime.command_init_arg ((get_args () .cuda |> snd).py_path) (
              runtime.arg_required !+
          )
          |> runtime.command_init_arg ((get_args () .cuda |> snd).env) (
              ~> runtime.arg_union `cuda_env ignore
          )
          |> runtime.command_init_arg ((get_args () .cuda |> snd).deps) (
              runtime.arg_value_names (am'.base ;[ ###"NAME"; ###"VERSION" ])
              >> runtime.arg_num_args_range (
                  runtime.new_value_range
                      !-
                      (am'.Start (1i32 |> convert.convert : convert.unativeint))
                      (am'.End eval)
              )
              >> runtime.arg_action runtime.Append
          )
      )
      |> runtime.command_subcommand (
          ###(get_args () .rust |> fst)
          |> runtime.new_command
          |> runtime.command_init_arg ((get_args () .rust |> snd).rs_path) (
              runtime.arg_required !+
          )
          |> runtime.command_init_arg ((get_args () .rust |> snd).deps) (
              runtime.arg_value_names (am'.base ;[ ###"NAME"; ###"VERSION" ])
              >> runtime.arg_num_args_range (
                  runtime.new_value_range
                      !-
                      (am'.Start (1i32 |> convert.convert : convert.unativeint))
                      (am'.End eval)
              )
              >> runtime.arg_action runtime.Append
          )
          |> runtime.command_init_arg ((get_args () .rust |> snd).wasm) (
              runtime.arg_num_args_range (
                  runtime.new_value_range
                      !+
                      (am'.End eval)
                      (am'.End \ _ => (1i32 |> convert.convert : convert.unativeint))
              )
              >> runtime.arg_require_equals !+
              >> runtime.arg_default_missing_value ""
          )
          |> runtime.command_init_arg ((get_args () .rust |> snd).contract) (
              runtime.arg_num_args_range (
                  runtime.new_value_range
                      !+
                      (am'.End eval)
                      (am'.End \ _ => (1i32 |> convert.convert : convert.unativeint))
              )
              >> runtime.arg_require_equals !+
              >> runtime.arg_default_missing_value ""
          )
          |> runtime.command_init_arg ((get_args () .rust |> snd).cleanup) (
              runtime.arg_default_value "true"
              >> runtime.arg_action runtime.SetFalse
          )
      )
      |> runtime.command_subcommand (
          := parse (s : rust.ref sm'.str) : resultm.result' (sm'.std_string * sm'.std_string) sm'.std_string =
              trace Verbose (\ () => "spiral.get_command") (\ () => { s })
              := path = "" |> sm'.to_std_string
              := ext = "" |> sm'.to_std_string
              Ok (path, ext)
              |> resultm.box
          ###(get_args () .notebook_export |> fst)
          |> runtime.new_command
          |> command_alias ###"dib-export"
          |> runtime.command_init_arg ((get_args () .notebook_export |> snd).entries) (
              runtime.arg_required !+
              >> runtime.arg_index 1
              >> runtime.arg_value_names (am'.base ;[ ###"PATH"; ###"EXT" ])
              >> runtime.arg_num_args_range (
                  runtime.new_value_range
                      !-
                      (am'.Start (2i32 |> convert.convert : convert.unativeint))
                      (am'.End eval)
              )
              >> runtime.arg_action runtime.Append
          )
      )
      |> runtime.command_subcommand (
          ###(get_args () .lua |> fst)
          |> runtime.new_command
          |> runtime.command_init_arg ((get_args () .lua |> snd).lua_path) (
              runtime.arg_required !+
          )
      )
      |> runtime.command_subcommand (
          ###(get_args () .cpp |> fst)
          |> runtime.new_command
          |> runtime.command_init_arg ((get_args () .cpp |> snd).cpp_path) (
              runtime.arg_required !+
          )
      )
  """,
  timeout: 300_000
)
```

### run

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":":~ ^ run trace_level (matches : runtime.arg_matches) : async.future_pin (resultm.result' string string) =\n    \\ () =>\n        ?= matches |> runtime.matches_subcommand |> optionm'.unbox ?|\n        | Some (subcommand, arg_matches)\n                ?& (subcommand |> sm'.from_std_string) = (get_args () .gleam |> fst) =>\n\n            := gleam_path =\n                arg_matches\n                |> runtime.matches_get_one ((get_args () .gleam |> snd).gleam_path |> fst)\n                |> optionm'.unbox\n                |> optionm.value\n                |> sm'.from_std_string\n\n            := target =\n                arg_matches\n                |> runtime.matches_get_one ((get_args () .gleam |> snd).target |> fst)\n                |> optionm'.unbox\n                |> optionm.map (\n                    sm'.from_std_string\n                    >> reflection.union_try_pick\n                )\n                |> optionm'.flatten\n                |> optionm'.default_value Erlang\n\n            := deps : am'.vec sm'.std_string =\n                arg_matches\n                |> runtime.matches_get_many ((get_args () .gleam |> snd).deps |> fst)\n                |> optionm'.unbox\n                |> optionm'.default_value (;[] |> am'.base |> am'.to_vec)\n\n            := command_result =\n                process_gleam { gleam_path target deps }\n                |> \\ { extension code output } =>\n                    ;[\n                        \"extension\", extension |> optionm'.default_value \"\"\n                        \"code\", code |> optionm'.default_value \"\"\n                        \"output\", output |> optionm'.default_value \"\"\n                    ]\n\n            ;[\n                \"command_result\",\n                command_result\n                |> am'.base\n                |> am'.to_vec\n                |> am'.vec_map' \\ k, v =>\n                    new_pair (sm'.to_std_string k) (sm'.to_std_string v)\n                |> mapm.b_tree_map_from_vec_pairs\n                |> sm'.serialize\n                |> resultm.unwrap'\n                |> sm'.from_std_string\n            ]\n\n        | Some (subcommand, arg_matches)\n                ?& (subcommand |> sm'.from_std_string) = (get_args () .lua |> fst) =>\n\n            := lua_path =\n                arg_matches\n                |> runtime.matches_get_one ((get_args () .lua |> snd).lua_path |> fst)\n                |> optionm'.unbox\n                |> optionm.value\n                |> sm'.from_std_string\n\n            := command_result =\n                process_lua { lua_path }\n                |> \\ { extension code output stdio } =>\n                    ;[\n                        \"extension\", extension |> optionm'.default_value \"\"\n                        \"code\", code |> optionm'.default_value \"\"\n                        \"output\", stdio |> optionm'.default_value \"\"\n                    ]\n\n            ;[\n                \"command_result\",\n                command_result\n                |> am'.base\n                |> am'.to_vec\n                |> am'.vec_map' \\ k, v =>\n                    new_pair (sm'.to_std_string k) (sm'.to_std_string v)\n                |> mapm.b_tree_map_from_vec_pairs\n                |> sm'.serialize\n                |> resultm.unwrap'\n                |> sm'.from_std_string\n            ]\n\n        | Some (subcommand, arg_matches)\n                ?& (subcommand |> sm'.from_std_string) = (get_args () .cuda |> fst) =>\n\n            := py_path =\n                arg_matches\n                |> runtime.matches_get_one ((get_args () .cuda |> snd).py_path |> fst)\n                |> optionm'.unbox\n                |> optionm.value\n                |> sm'.from_std_string\n\n            := env =\n                arg_matches\n                |> runtime.matches_get_one ((get_args () .cuda |> snd).env |> fst)\n                |> optionm'.unbox\n                |> optionm.map (\n                    sm'.from_std_string\n                    >> reflection.union_try_pick\n                )\n                |> optionm'.flatten\n                |> optionm'.default_value Pip\n\n            := deps : am'.vec sm'.std_string =\n                arg_matches\n                |> runtime.matches_get_many ((get_args () .cuda |> snd).deps |> fst)\n                |> optionm'.unbox\n                |> optionm'.default_value (;[] |> am'.base |> am'.to_vec)\n\n            := command_result =\n                process_cuda { py_path env deps }\n                |> \\ { extension code output } =>\n                    ;[\n                        \"extension\", extension |> optionm'.default_value \"\"\n                        \"code\", code |> optionm'.default_value \"\"\n                        \"output\", output |> optionm'.default_value \"\"\n                    ]\n\n            ;[\n                \"command_result\",\n                command_result\n                |> am'.base\n                |> am'.to_vec\n                |> am'.vec_map' \\ k, v =>\n                    new_pair (sm'.to_std_string k) (sm'.to_std_string v)\n                |> mapm.b_tree_map_from_vec_pairs\n                |> sm'.serialize\n                |> resultm.unwrap'\n                |> sm'.from_std_string\n            ]\n\n        | Some (subcommand, arg_matches)\n                ?& (subcommand |> sm'.from_std_string) = (get_args () .cpp |> fst) =>\n\n            := cpp_path =\n                arg_matches\n                |> runtime.matches_get_one ((get_args () .cpp |> snd).cpp_path |> fst)\n                |> optionm'.unbox\n                |> optionm.value\n                |> sm'.from_std_string\n\n            := command_result =\n                process_cpp { cpp_path }\n                |> \\ { extension code output } =>\n                    ;[\n                        \"extension\", extension |> optionm'.default_value \"\"\n                        \"code\", code |> optionm'.default_value \"\"\n                        \"output\", output |> optionm'.default_value \"\"\n                    ]\n\n            ;[\n                \"command_result\",\n                command_result\n                |> am'.base\n                |> am'.to_vec\n                |> am'.vec_map' \\ k, v =>\n                    new_pair (sm'.to_std_string k) (sm'.to_std_string v)\n                |> mapm.b_tree_map_from_vec_pairs\n                |> sm'.serialize\n                |> resultm.unwrap'\n                |> sm'.from_std_string\n            ]\n\n        | Some (subcommand, arg_matches)\n            ?& (subcommand |> sm'.from_std_string) = (get_args () .notebook_export |> fst) =>\n\n            := deps : am'.vec (sm'.std_string * sm'.std_string) =\n                arg_matches\n                |> runtime.matches_get_many ((get_args () .cuda |> snd).deps |> fst)\n                |> optionm'.unbox\n                |> optionm'.default_value (;[] |> am'.base |> am'.to_vec)\n\n            := entries =\n                arg_matches\n                |> runtime.matches_get_many ((get_args () .notebook_export |> snd).entries |> fst)\n                |> optionm'.unbox\n                |> optionm.map (\\ (entries : am'.vec sm'.std_string) =>\n                    entries\n                    |> \\ x =>\n                        !\\\\(x, $'$\"$0.chunks_exact(2).map(|chunk| chunk.to_vec()).collect()\"')\n                        : am'.vec (am'.vec sm'.std_string)\n                    |> am'.vec_map' \\ chunk =>\n                        := exts () =\n                            reflection.get_union_fields_untag () : _ (_ * export_output)\n                        chunk\n                        |> am'.from_vec_base\n                        |> am'.to_list_base'\n                        |> listm'.unbox\n                        |> \\|\n                            | [ path; ext ] =>\n                                ?= ext |> sm'.from_std_string |> reflection.union_try_pick ?|\n                                | Some (ext : export_output) => (path |> sm'.from_std_string, ext) |> Ok\n                                | None => \"spiral.run / invalid ext / \" ++#? { ext exts } |> Error\n                            | _ =>\n                                \"spiral.run / invalid entries / \" ++#? { entries = entries |> rust.clone; exts }\n                                |> Error\n                            |> resultm.get\n                    |> am'.from_vec_base\n                    |> am'.to_list_base'\n                    |> listm'.unbox\n                )\n                |> optionm'.default_value []\n                |> listm'.box\n                |> listm'.to_array'\n                |> am'.to_vec\n\n            process_export { entries }\n\n        | matches =>\n            ?= matches ?|\n            | Some (subcommand, arg_matches)\n                    ?& (subcommand |> sm'.from_std_string) = (get_args () .rust |> fst) =>\n\n                := rs_path =\n                    arg_matches\n                    |> runtime.matches_get_one ((get_args () .rust |> snd).rs_path |> fst)\n                    |> optionm'.unbox\n                    |> optionm.value\n                    |> sm'.from_std_string\n\n                := deps : am'.vec sm'.std_string =\n                    arg_matches\n                    |> runtime.matches_get_many ((get_args () .rust |> snd).deps |> fst)\n                    |> optionm'.unbox\n                    |> optionm'.default_value (;[] |> am'.base |> am'.to_vec)\n\n                := cleanup =\n                    arg_matches\n                    |> runtime.matches_get_flag ((get_args () .rust |> snd).cleanup |> fst)\n\n                := wasm =\n                    arg_matches\n                    |> runtime.matches_get_one ((get_args () .rust |> snd).wasm |> fst)\n                    |> optionm'.unbox\n                    |> optionm.map sm'.from_std_string\n\n                := contract =\n                    arg_matches\n                    |> runtime.matches_get_one ((get_args () .rust |> snd).contract |> fst)\n                    |> optionm'.unbox\n                    |> optionm.map sm'.from_std_string\n\n                := runtime =\n                    ?= wasm, contract ?|\n                    | Some wasm, _ => Wasm wasm |> Some\n                    | _, Some contract => Contract contract |> Some\n                    | _ => None\n\n                process_rust { rs_path deps trace_level runtime cleanup }\n\n            | Some (subcommand, arg_matches) =>\n                trace Debug\n                    \\ () => \"spiral.run / invalid subcommand\"\n                    \\ () => { subcommand arg_matches }\n\n                { extension = None; code = None; code_path = None; output = None }\n            | _ =>\n                { extension = None; code = None; code_path = None; output = None }\n            |> \\ { extension code code_path output } =>\n                ;[\n                    \"extension\", extension |> optionm'.default_value \"\"\n                    \"code\", code |> optionm'.default_value \"\"\n                    \"code_path\", code_path |> optionm'.default_value \"\"\n                    \"output\", output |> optionm'.default_value \"\"\n                ]\n        |> am'.base\n        |> am'.to_vec\n        |> am'.vec_map' \\ k, v =>\n            new_pair (sm'.to_std_string k) (sm'.to_std_string v)\n        |> mapm.b_tree_map_from_vec_pairs\n        |> sm'.serialize\n        |> resultm.map_error' (sm'.format' >> sm'.from_std_string)\n        |> resultm.map' sm'.from_std_string\n    |> async.new_future_move","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  :~ ^ run trace_level (matches : runtime.arg_matches) : async.future_pin (resultm.result' string string) =
      \ () =>
          ?= matches |> runtime.matches_subcommand |> optionm'.unbox ?|
          | Some (subcommand, arg_matches)
                  ?& (subcommand |> sm'.from_std_string) = (get_args () .gleam |> fst) =>

              := gleam_path =
                  arg_matches
                  |> runtime.matches_get_one ((get_args () .gleam |> snd).gleam_path |> fst)
                  |> optionm'.unbox
                  |> optionm.value
                  |> sm'.from_std_string

              := target =
                  arg_matches
                  |> runtime.matches_get_one ((get_args () .gleam |> snd).target |> fst)
                  |> optionm'.unbox
                  |> optionm.map (
                      sm'.from_std_string
                      >> reflection.union_try_pick
                  )
                  |> optionm'.flatten
                  |> optionm'.default_value Erlang

              := deps : am'.vec sm'.std_string =
                  arg_matches
                  |> runtime.matches_get_many ((get_args () .gleam |> snd).deps |> fst)
                  |> optionm'.unbox
                  |> optionm'.default_value (;[] |> am'.base |> am'.to_vec)

              := command_result =
                  process_gleam { gleam_path target deps }
                  |> \ { extension code output } =>
                      ;[
                          "extension", extension |> optionm'.default_value ""
                          "code", code |> optionm'.default_value ""
                          "output", output |> optionm'.default_value ""
                      ]

              ;[
                  "command_result",
                  command_result
                  |> am'.base
                  |> am'.to_vec
                  |> am'.vec_map' \ k, v =>
                      new_pair (sm'.to_std_string k) (sm'.to_std_string v)
                  |> mapm.b_tree_map_from_vec_pairs
                  |> sm'.serialize
                  |> resultm.unwrap'
                  |> sm'.from_std_string
              ]

          | Some (subcommand, arg_matches)
                  ?& (subcommand |> sm'.from_std_string) = (get_args () .lua |> fst) =>

              := lua_path =
                  arg_matches
                  |> runtime.matches_get_one ((get_args () .lua |> snd).lua_path |> fst)
                  |> optionm'.unbox
                  |> optionm.value
                  |> sm'.from_std_string

              := command_result =
                  process_lua { lua_path }
                  |> \ { extension code output stdio } =>
                      ;[
                          "extension", extension |> optionm'.default_value ""
                          "code", code |> optionm'.default_value ""
                          "output", stdio |> optionm'.default_value ""
                      ]

              ;[
                  "command_result",
                  command_result
                  |> am'.base
                  |> am'.to_vec
                  |> am'.vec_map' \ k, v =>
                      new_pair (sm'.to_std_string k) (sm'.to_std_string v)
                  |> mapm.b_tree_map_from_vec_pairs
                  |> sm'.serialize
                  |> resultm.unwrap'
                  |> sm'.from_std_string
              ]

          | Some (subcommand, arg_matches)
                  ?& (subcommand |> sm'.from_std_string) = (get_args () .cuda |> fst) =>

              := py_path =
                  arg_matches
                  |> runtime.matches_get_one ((get_args () .cuda |> snd).py_path |> fst)
                  |> optionm'.unbox
                  |> optionm.value
                  |> sm'.from_std_string

              := env =
                  arg_matches
                  |> runtime.matches_get_one ((get_args () .cuda |> snd).env |> fst)
                  |> optionm'.unbox
                  |> optionm.map (
                      sm'.from_std_string
                      >> reflection.union_try_pick
                  )
                  |> optionm'.flatten
                  |> optionm'.default_value Pip

              := deps : am'.vec sm'.std_string =
                  arg_matches
                  |> runtime.matches_get_many ((get_args () .cuda |> snd).deps |> fst)
                  |> optionm'.unbox
                  |> optionm'.default_value (;[] |> am'.base |> am'.to_vec)

              := command_result =
                  process_cuda { py_path env deps }
                  |> \ { extension code output } =>
                      ;[
                          "extension", extension |> optionm'.default_value ""
                          "code", code |> optionm'.default_value ""
                          "output", output |> optionm'.default_value ""
                      ]

              ;[
                  "command_result",
                  command_result
                  |> am'.base
                  |> am'.to_vec
                  |> am'.vec_map' \ k, v =>
                      new_pair (sm'.to_std_string k) (sm'.to_std_string v)
                  |> mapm.b_tree_map_from_vec_pairs
                  |> sm'.serialize
                  |> resultm.unwrap'
                  |> sm'.from_std_string
              ]

          | Some (subcommand, arg_matches)
                  ?& (subcommand |> sm'.from_std_string) = (get_args () .cpp |> fst) =>

              := cpp_path =
                  arg_matches
                  |> runtime.matches_get_one ((get_args () .cpp |> snd).cpp_path |> fst)
                  |> optionm'.unbox
                  |> optionm.value
                  |> sm'.from_std_string

              := command_result =
                  process_cpp { cpp_path }
                  |> \ { extension code output } =>
                      ;[
                          "extension", extension |> optionm'.default_value ""
                          "code", code |> optionm'.default_value ""
                          "output", output |> optionm'.default_value ""
                      ]

              ;[
                  "command_result",
                  command_result
                  |> am'.base
                  |> am'.to_vec
                  |> am'.vec_map' \ k, v =>
                      new_pair (sm'.to_std_string k) (sm'.to_std_string v)
                  |> mapm.b_tree_map_from_vec_pairs
                  |> sm'.serialize
                  |> resultm.unwrap'
                  |> sm'.from_std_string
              ]

          | Some (subcommand, arg_matches)
              ?& (subcommand |> sm'.from_std_string) = (get_args () .notebook_export |> fst) =>

              := deps : am'.vec (sm'.std_string * sm'.std_string) =
                  arg_matches
                  |> runtime.matches_get_many ((get_args () .cuda |> snd).deps |> fst)
                  |> optionm'.unbox
                  |> optionm'.default_value (;[] |> am'.base |> am'.to_vec)

              := entries =
                  arg_matches
                  |> runtime.matches_get_many ((get_args () .notebook_export |> snd).entries |> fst)
                  |> optionm'.unbox
                  |> optionm.map (\ (entries : am'.vec sm'.std_string) =>
                      entries
                      |> \ x =>
                          !\\(x, $'$"$0.chunks_exact(2).map(|chunk| chunk.to_vec()).collect()"')
                          : am'.vec (am'.vec sm'.std_string)
                      |> am'.vec_map' \ chunk =>
                          := exts () =
                              reflection.get_union_fields_untag () : _ (_ * export_output)
                          chunk
                          |> am'.from_vec_base
                          |> am'.to_list_base'
                          |> listm'.unbox
                          |> \|
                              | [ path; ext ] =>
                                  ?= ext |> sm'.from_std_string |> reflection.union_try_pick ?|
                                  | Some (ext : export_output) => (path |> sm'.from_std_string, ext) |> Ok
                                  | None => "spiral.run / invalid ext / " ++#? { ext exts } |> Error
                              | _ =>
                                  "spiral.run / invalid entries / " ++#? { entries = entries |> rust.clone; exts }
                                  |> Error
                              |> resultm.get
                      |> am'.from_vec_base
                      |> am'.to_list_base'
                      |> listm'.unbox
                  )
                  |> optionm'.default_value []
                  |> listm'.box
                  |> listm'.to_array'
                  |> am'.to_vec

              process_export { entries }

          | matches =>
              ?= matches ?|
              | Some (subcommand, arg_matches)
                      ?& (subcommand |> sm'.from_std_string) = (get_args () .rust |> fst) =>

                  := rs_path =
                      arg_matches
                      |> runtime.matches_get_one ((get_args () .rust |> snd).rs_path |> fst)
                      |> optionm'.unbox
                      |> optionm.value
                      |> sm'.from_std_string

                  := deps : am'.vec sm'.std_string =
                      arg_matches
                      |> runtime.matches_get_many ((get_args () .rust |> snd).deps |> fst)
                      |> optionm'.unbox
                      |> optionm'.default_value (;[] |> am'.base |> am'.to_vec)

                  := cleanup =
                      arg_matches
                      |> runtime.matches_get_flag ((get_args () .rust |> snd).cleanup |> fst)

                  := wasm =
                      arg_matches
                      |> runtime.matches_get_one ((get_args () .rust |> snd).wasm |> fst)
                      |> optionm'.unbox
                      |> optionm.map sm'.from_std_string

                  := contract =
                      arg_matches
                      |> runtime.matches_get_one ((get_args () .rust |> snd).contract |> fst)
                      |> optionm'.unbox
                      |> optionm.map sm'.from_std_string

                  := runtime =
                      ?= wasm, contract ?|
                      | Some wasm, _ => Wasm wasm |> Some
                      | _, Some contract => Contract contract |> Some
                      | _ => None

                  process_rust { rs_path deps trace_level runtime cleanup }

              | Some (subcommand, arg_matches) =>
                  trace Debug
                      \ () => "spiral.run / invalid subcommand"
                      \ () => { subcommand arg_matches }

                  { extension = None; code = None; code_path = None; output = None }
              | _ =>
                  { extension = None; code = None; code_path = None; output = None }
              |> \ { extension code code_path output } =>
                  ;[
                      "extension", extension |> optionm'.default_value ""
                      "code", code |> optionm'.default_value ""
                      "code_path", code_path |> optionm'.default_value ""
                      "output", output |> optionm'.default_value ""
                  ]
          |> am'.base
          |> am'.to_vec
          |> am'.vec_map' \ k, v =>
              new_pair (sm'.to_std_string k) (sm'.to_std_string v)
          |> mapm.b_tree_map_from_vec_pairs
          |> sm'.serialize
          |> resultm.map_error' (sm'.format' >> sm'.from_std_string)
          |> resultm.map' sm'.from_std_string
      |> async.new_future_move
  """,
  timeout: 300_000
)
```

