  := get_args () =
      {
          gleam = "gleam", {
              gleam_path = "gleam-path", 'g'
              target = "target", 't'
              deps = "deps", 'd'
          }
          lua = "lua", {
              lua_path = "lua-path", 'l'
          }
          cuda = "cuda", {
              py_path = "py-path", 'p'
              env = "env", 'e'
              deps = "deps", 'd'
          }
          cpp = "cpp", {
              cpp_path = "cpp-path", 'c'
          }
          rust = "rust", {
              rs_path = "rs-path", 'r'
              deps = "deps", 'd'
              wasm = "wasm", 'w'
              contract = "contract", 'c'
              cleanup = "cleanup", 'l'
          }
          notebook_export = "export", {
              entries = "entries", 'e'
          }
      }
  """,
  timeout: 300_000
