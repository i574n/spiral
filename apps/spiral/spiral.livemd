<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"///- --test\n///> fsharp\n///> gleam\n///> rust\n///> cuda\n\nexample1 ()\n|> parse Spir\n|> resultm.get\n|> (format_blocks Spir)\n|> _assert_eq (\n    \"/// # TestModule (TestNamespace)\"\n    ++\\# \"\"\n    ++\\# \"/// ## ParserLibrary\"\n    ++\\# \"///- --real\"\n    ++\\# \"\"\n    ++\\# \"inl x = 2i32\"\n    ++\\# \"\"\n)","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  ///- --test
  ///> fsharp
  ///> gleam
  ///> rust
  ///> cuda

  example1 ()
  |> parse Spir
  |> resultm.get
  |> (format_blocks Spir)
  |> _assert_eq (
      "/// # TestModule (TestNamespace)"
      ++\# ""
      ++\# "/// ## ParserLibrary"
      ++\# "///- --real"
      ++\# ""
      ++\# "inl x = 2i32"
      ++\# ""
  )
  """,
  timeout: 300_000
)
```

### parse_export

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"inl parse_export output file =\n    trace Debug\n        (fun () => \"spiral.parse_export\")\n        fun () => { output = output |> reflection.union_to_string; file }\n    inl t = file |> file_system.read_all_text\n    match parse output t with\n    | Ok blocks => blocks |> format_blocks output\n    | Error msg => msg () |> failwith","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  inl parse_export output file =
      trace Debug
          (fun () => "spiral.parse_export")
          fun () => { output = output |> reflection.union_to_string; file }
      inl t = file |> file_system.read_all_text
      match parse output t with
      | Ok blocks => blocks |> format_blocks output
      | Error msg => msg () |> failwith
  """,
  timeout: 300_000
)
```

### write_export

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"inl write_export output path =\n    trace Debug\n        (fun () => \"spiral.write_export\")\n        (fun () => { output = output |> reflection.union_to_string; path })\n    inl result = parse_export output path\n    inl path_dir = path |> file_system.directory_get_parent |> optionm'.default_value' \"\"\n    inl file_name_without_ext =\n        match output, path |> file_system.get_file_name_without_extension with\n        | Spir, file_name_without_ext => file_name_without_ext ++# \"_real\"\n        | _, file_name_without_ext => file_name_without_ext\n    inl output_path =\n        path_dir </> (file_name_without_ext ++# \".\" ++# (output |> reflection.union_to_string |> sm'.to_lower))\n    result |> file_system.write_all_text_exists output_path","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  inl write_export output path =
      trace Debug
          (fun () => "spiral.write_export")
          (fun () => { output = output |> reflection.union_to_string; path })
      inl result = parse_export output path
      inl path_dir = path |> file_system.directory_get_parent |> optionm'.default_value' ""
      inl file_name_without_ext =
          match output, path |> file_system.get_file_name_without_extension with
          | Spir, file_name_without_ext => file_name_without_ext ++# "_real"
          | _, file_name_without_ext => file_name_without_ext
      inl output_path =
          path_dir </> (file_name_without_ext ++# "." ++# (output |> reflection.union_to_string |> sm'.to_lower))
      result |> file_system.write_all_text_exists output_path
  """,
  timeout: 300_000
)
```

### process_export

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"inl process_export { entries } =\n    entries\n    |> async.into_par_iter\n    |> async.par_map fun path, export =>\n        path\n        |> file_system.get_full_path\n        |> write_export export\n    |> async.par_collect\n    |> ignore\n    ;[]","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  inl process_export { entries } =
      entries
      |> async.into_par_iter
      |> async.par_map fun path, export =>
          path
          |> file_system.get_full_path
          |> write_export export
      |> async.par_collect
      |> ignore
      ;[]
  """,
  timeout: 300_000
)
```

