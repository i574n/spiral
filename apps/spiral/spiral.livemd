### format_block

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":":= format_block output (block : block) =\n    trace Verbose (\\ () => \"spiral.format_block\") (\\ () => {})\n    ?= output, block ?|\n    | output, { magic = (Markdown) content = content } =>\n        := markdown_comment =\n            ?= output ?|\n            | Spi | Spir => \"/// \"\n            | Fs => \"/// \"\n            | _ => \"\"\n        content ()\n        |> sm'.split \"\\n\"\n        |> am'.to_list_base'\n        |> listm'.unbox\n        |> listm.map (sm'.trim_end [])\n        |> listm'.filter (sm'.ends_with \" (test)\" >> not)\n        |> listm.map \\|\n            | \"\" => markdown_comment\n            | line =>\n                := len = ##line\n                :~ ^ 루프 i =\n                    ? i >= len\n                    ?> line\n                    |:\n                        ?= line |> sm'.index i ?|\n                        | ' ' | '\\t' => 루프 (i + 1)\n                        | _ =>\n                            (line |> sm'.slice 0i32 (i - 1))\n                            ++# markdown_comment\n                            ++# (line |> sm'.slice i (len - 1))\n                루프 0\n        |> sm'.concat_list \"\\n\"\n    | Fs, { magic = (Fsharp) content = content } =>\n        := trimmed_content = content () |> sm'.trim\n        ? trimmed_content |> sm'.contains \"///- \"\n            && (trimmed_content |> sm'.contains (\" --\" ++# \"test\")\n                || trimmed_content |> sm'.contains (\" --\" ++# \"ignore\"))\n        ?> \"\"\n        |:\n            content ()\n            |> sm'.split \"\\n\"\n            |> am'.to_list_base'\n            |> listm'.unbox\n            |> listm'.filter (sm'.trim_start [] >> sm'.starts_with \"#r\" >> not)\n            |> sm'.concat_list \"\\n\"\n    | (Spi | Spir), { magic = (Spiral output') content = content } ?& output' = output =>\n        := trimmed_content = content () |> sm'.trim\n        ? trimmed_content |> sm'.contains \"///- \"\n            && (trimmed_content |> sm'.contains (\" --\" ++# \"test\")\n                || trimmed_content |> sm'.contains (\" --\" ++# \"ignore\"))\n        ?> \"\"\n        |: content ()\n    | _ => \"\"","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  := format_block output (block : block) =
      trace Verbose (\ () => "spiral.format_block") (\ () => {})
      ?= output, block ?|
      | output, { magic = (Markdown) content = content } =>
          := markdown_comment =
              ?= output ?|
              | Spi | Spir => "/// "
              | Fs => "/// "
              | _ => ""
          content ()
          |> sm'.split "\n"
          |> am'.to_list_base'
          |> listm'.unbox
          |> listm.map (sm'.trim_end [])
          |> listm'.filter (sm'.ends_with " (test)" >> not)
          |> listm.map \|
              | "" => markdown_comment
              | line =>
                  := len = ##line
                  :~ ^ 루프 i =
                      ? i >= len
                      ?> line
                      |:
                          ?= line |> sm'.index i ?|
                          | ' ' | '\t' => 루프 (i + 1)
                          | _ =>
                              (line |> sm'.slice 0i32 (i - 1))
                              ++# markdown_comment
                              ++# (line |> sm'.slice i (len - 1))
                  루프 0
          |> sm'.concat_list "\n"
      | Fs, { magic = (Fsharp) content = content } =>
          := trimmed_content = content () |> sm'.trim
          ? trimmed_content |> sm'.contains "///- "
              && (trimmed_content |> sm'.contains (" --" ++# "test")
                  || trimmed_content |> sm'.contains (" --" ++# "ignore"))
          ?> ""
          |:
              content ()
              |> sm'.split "\n"
              |> am'.to_list_base'
              |> listm'.unbox
              |> listm'.filter (sm'.trim_start [] >> sm'.starts_with "#r" >> not)
              |> sm'.concat_list "\n"
      | (Spi | Spir), { magic = (Spiral output') content = content } ?& output' = output =>
          := trimmed_content = content () |> sm'.trim
          ? trimmed_content |> sm'.contains "///- "
              && (trimmed_content |> sm'.contains (" --" ++# "test")
                  || trimmed_content |> sm'.contains (" --" ++# "ignore"))
          ?> ""
          |: content ()
      | _ => ""
  """,
  timeout: 300_000
)
```

### format_blocks

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":":= format_blocks output blocks =\n    trace Verbose (\\ () => \"spiral.format_blocks\") (\\ () => {})\n    blocks\n    |> listm.map \\ block =>\n        block, format_block output block\n    |> listm'.filter (snd >> (<>) \"\")\n    |> \\ list =>\n        (list, (None, []))\n        ||> listm.foldBack (\\ (block, content) (last_magic, acc) =>\n            := line_break =\n                ? block.magic = Markdown && last_magic <> Some Markdown && last_magic <> None\n                ?> \"\"\n                |: \"\\n\"\n            Some block.magic, content ++# line_break :: acc\n        )\n    |> snd\n    |> sm'.concat_list \"\\n\"","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  := format_blocks output blocks =
      trace Verbose (\ () => "spiral.format_blocks") (\ () => {})
      blocks
      |> listm.map \ block =>
          block, format_block output block
      |> listm'.filter (snd >> (<>) "")
      |> \ list =>
          (list, (None, []))
          ||> listm.foldBack (\ (block, content) (last_magic, acc) =>
              := line_break =
                  ? block.magic = Markdown && last_magic <> Some Markdown && last_magic <> None
                  ?> ""
                  |: "\n"
              Some block.magic, content ++# line_break :: acc
          )
      |> snd
      |> sm'.concat_list "\n"
  """,
  timeout: 300_000
)
```

### indent_block

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":":= indent_block (block : block) =\n    trace Verbose (\\ () => \"spiral.indent_block\") (\\ () => {})\n    { block ?|\n        content = \\ () =>\n            (([], !-), block.content () |> sm'.split \"\\n\" |> am'.to_list_base' |> listm'.unbox)\n            ||> listm.fold \\ (lines, is_multiline) line =>\n                := trimmed_line = line |> sm'.trim\n                ? trimmed_line = \"\"\n                ?> \"\" :: lines, is_multiline\n                |:\n                    := single_quote_line () =\n                        (trimmed_line\n                            |> sm'.to_char_list\n                            |> listm.map ((=) '\"' >> convert.try_convert >> optionm'.default_value 0)\n                            |> listm'.sum) = 1i32\n                        && trimmed_line |> sm'.contains \"'\\\"'\" |> not\n                        && trimmed_line |> sm'.ends_with \"{\" |> not\n                        && trimmed_line |> sm'.ends_with \"{|\" |> not\n                        && trimmed_line |> sm'.starts_with \"}\" |> not\n                        && trimmed_line |> sm'.starts_with \"|}\" |> not\n\n                    ?= is_multiline, trimmed_line |> sm'.split_string (am'.base ;[ \"\\\"\\\"\\\"\" ]) ?|\n                    | !-, ;[ _; _ ] =>\n                        \"    \" ++# line :: lines, !+\n\n                    | !+, ;[ _; _ ] =>\n                        line :: lines, !-\n\n                    | !-, _ ?& single_quote_line () =>\n                        \"    \" ++# line :: lines, !+\n\n                    | !-, _ ?& line |> sm'.starts_with \"#\" && block.magic = Fsharp =>\n                        line :: lines, !-\n\n                    | !-, _ =>\n                        \"    \" ++# line :: lines, !-\n\n                    | !+, _ ?& single_quote_line () && (line |> sm'.starts_with \"    \") =>\n                        \"    \" ++# line :: lines, !-\n\n                    | !+, _ ?& single_quote_line () =>\n                        line :: lines, !-\n\n                    | !+, _ =>\n                        line :: lines, !+\n            |> fst\n            |> listm.rev\n            |> sm'.concat_list \"\\n\"\n    }","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  := indent_block (block : block) =
      trace Verbose (\ () => "spiral.indent_block") (\ () => {})
      { block ?|
          content = \ () =>
              (([], !-), block.content () |> sm'.split "\n" |> am'.to_list_base' |> listm'.unbox)
              ||> listm.fold \ (lines, is_multiline) line =>
                  := trimmed_line = line |> sm'.trim
                  ? trimmed_line = ""
                  ?> "" :: lines, is_multiline
                  |:
                      := single_quote_line () =
                          (trimmed_line
                              |> sm'.to_char_list
                              |> listm.map ((=) '"' >> convert.try_convert >> optionm'.default_value 0)
                              |> listm'.sum) = 1i32
                          && trimmed_line |> sm'.contains "'\"'" |> not
                          && trimmed_line |> sm'.ends_with "{" |> not
                          && trimmed_line |> sm'.ends_with "{|" |> not
                          && trimmed_line |> sm'.starts_with "}" |> not
                          && trimmed_line |> sm'.starts_with "|}" |> not

                      ?= is_multiline, trimmed_line |> sm'.split_string (am'.base ;[ "\"\"\"" ]) ?|
                      | !-, ;[ _; _ ] =>
                          "    " ++# line :: lines, !+

                      | !+, ;[ _; _ ] =>
                          line :: lines, !-

                      | !-, _ ?& single_quote_line () =>
                          "    " ++# line :: lines, !+

                      | !-, _ ?& line |> sm'.starts_with "#" && block.magic = Fsharp =>
                          line :: lines, !-

                      | !-, _ =>
                          "    " ++# line :: lines, !-

                      | !+, _ ?& single_quote_line () && (line |> sm'.starts_with "    ") =>
                          "    " ++# line :: lines, !-

                      | !+, _ ?& single_quote_line () =>
                          line :: lines, !-

                      | !+, _ =>
                          line :: lines, !+
              |> fst
              |> listm.rev
              |> sm'.concat_list "\n"
      }
  """,
  timeout: 300_000
)
```

### parse

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":":= parse output t =\n    trace Verbose (\\ () => \"spiral.parse\") (\\ () => {})\n    ?= t |> run_parser (blocks ()) ?|\n    | Ok (blocks, _, _) =>\n        blocks\n        |> listm'.filter \\ block =>\n            block.magic |> kernel_outputs |> listm'.contains output || block.magic = Markdown\n        |> listm.map Some\n        |> \\ x => x ++ [ None ]\n        |> listm'.pairwise\n        |> listm'.choose \\|\n            | Some { magic = (Markdown) } &= block, Some { magic = (Markdown) } => block\n            | Some { magic = (Markdown) } &= block, Some { magic = magic }\n                ?& magic |> kernel_outputs |> listm'.contains output => block\n            | Some { magic = (Markdown) } &= block, _ ?& output = Md => block\n            | Some { magic = (Markdown) }, _ => None\n            | Some block, _ => Some block\n            | _ => None\n        |> listm.map \\ block => block, block.content ()\n        |> listm.fold\n            \\ acc, indent => \\|\n                | ({ magic = (Markdown) } : block) &= block, content\n                    ?& output = Fs\n                            && content |> sm'.starts_with \"# \"\n                            && content |> sm'.ends_with \")\"\n                    =>\n                    ?= sm'.index_of \" (\" content, sm'.last_index_of \")\" content ?|\n                    | i_open, i_close ?& i_open > 1 && i_close > i_open + 1 =>\n                        := module_name =\n                            content |> sm'.substring 2 (i_open - 2) |> sm'.trim\n                        := namespace_name =\n                            content |> sm'.substring (i_open + 2) (i_close - (i_open + 2)) |> sm'.trim\n\n                        := module_block =\n                            {\n                                magic = Fsharp\n                                content = \\ () =>\n                                    \"#if !INTERACTIVE\\nnamespace \" ++# namespace_name\n                                    ++\\# \"#endif\\n\\nmodule \" ++# module_name ++# \" =\"\n                            }\n\n                        module_block :: acc, (indent + 1)\n                    | b => { block ?| magic = Markdown } :: acc, indent\n                | block, _ ?& indent > 0 =>\n                    indent_block block :: acc, indent\n                | block, _ => block :: acc, indent\n            ([], 0i32)\n        |> fst\n        |> listm.rev\n        |> Ok\n    | Error error_msg => error_msg |> Error","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  := parse output t =
      trace Verbose (\ () => "spiral.parse") (\ () => {})
      ?= t |> run_parser (blocks ()) ?|
      | Ok (blocks, _, _) =>
          blocks
          |> listm'.filter \ block =>
              block.magic |> kernel_outputs |> listm'.contains output || block.magic = Markdown
          |> listm.map Some
          |> \ x => x ++ [ None ]
          |> listm'.pairwise
          |> listm'.choose \|
              | Some { magic = (Markdown) } &= block, Some { magic = (Markdown) } => block
              | Some { magic = (Markdown) } &= block, Some { magic = magic }
                  ?& magic |> kernel_outputs |> listm'.contains output => block
              | Some { magic = (Markdown) } &= block, _ ?& output = Md => block
              | Some { magic = (Markdown) }, _ => None
              | Some block, _ => Some block
              | _ => None
          |> listm.map \ block => block, block.content ()
          |> listm.fold
              \ acc, indent => \|
                  | ({ magic = (Markdown) } : block) &= block, content
                      ?& output = Fs
                              && content |> sm'.starts_with "# "
                              && content |> sm'.ends_with ")"
                      =>
                      ?= sm'.index_of " (" content, sm'.last_index_of ")" content ?|
                      | i_open, i_close ?& i_open > 1 && i_close > i_open + 1 =>
                          := module_name =
                              content |> sm'.substring 2 (i_open - 2) |> sm'.trim
                          := namespace_name =
                              content |> sm'.substring (i_open + 2) (i_close - (i_open + 2)) |> sm'.trim

                          := module_block =
                              {
                                  magic = Fsharp
                                  content = \ () =>
                                      "#if !INTERACTIVE\nnamespace " ++# namespace_name
                                      ++\# "#endif\n\nmodule " ++# module_name ++# " ="
                              }

                          module_block :: acc, (indent + 1)
                      | b => { block ?| magic = Markdown } :: acc, indent
                  | block, _ ?& indent > 0 =>
                      indent_block block :: acc, indent
                  | block, _ => block :: acc, indent
              ([], 0i32)
          |> fst
          |> listm.rev
          |> Ok
      | Error error_msg => error_msg |> Error
  """,
  timeout: 300_000
)
```

### parse_export

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":":= parse_export output file =\n    trace Debug\n        (\\ () => \"spiral.parse_export\")\n        \\ () => { output = output |> reflection.union_to_string; file }\n    := t = file |> file_system.read_all_text\n    ?= parse output t ?|\n    | Ok blocks => blocks |> format_blocks output\n    | Error msg => msg () |> failwith","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  := parse_export output file =
      trace Debug
          (\ () => "spiral.parse_export")
          \ () => { output = output |> reflection.union_to_string; file }
      := t = file |> file_system.read_all_text
      ?= parse output t ?|
      | Ok blocks => blocks |> format_blocks output
      | Error msg => msg () |> failwith
  """,
  timeout: 300_000
)
```

### write_export

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":":= write_export output path =\n    trace Debug\n        (\\ () => \"spiral.write_export\")\n        (\\ () => { output = output |> reflection.union_to_string; path })\n    := result = parse_export output path\n    := path_dir = path |> file_system.directory_get_parent |> optionm'.default_value' \"\"\n    := file_name_without_ext =\n        ?= output, path |> file_system.get_file_name_without_extension ?|\n        | Spir, file_name_without_ext => file_name_without_ext ++# \"_real\"\n        | _, file_name_without_ext => file_name_without_ext\n    := output_path =\n        path_dir </> (file_name_without_ext ++# \".\" ++# (output |> reflection.union_to_string |> sm'.to_lower))\n    result |> file_system.write_all_text_exists output_path","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  := write_export output path =
      trace Debug
          (\ () => "spiral.write_export")
          (\ () => { output = output |> reflection.union_to_string; path })
      := result = parse_export output path
      := path_dir = path |> file_system.directory_get_parent |> optionm'.default_value' ""
      := file_name_without_ext =
          ?= output, path |> file_system.get_file_name_without_extension ?|
          | Spir, file_name_without_ext => file_name_without_ext ++# "_real"
          | _, file_name_without_ext => file_name_without_ext
      := output_path =
          path_dir </> (file_name_without_ext ++# "." ++# (output |> reflection.union_to_string |> sm'.to_lower))
      result |> file_system.write_all_text_exists output_path
  """,
  timeout: 300_000
)
```

### process_export

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":":= process_export { entries } =\n    entries\n    |> async.into_par_iter\n    |> async.par_map \\ path, export =>\n        path\n        |> file_system.get_full_path\n        |> write_export export\n    |> async.par_collect\n    |> ignore\n    ;[]","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  := process_export { entries } =
      entries
      |> async.into_par_iter
      |> async.par_map \ path, export =>
          path
          |> file_system.get_full_path
          |> write_export export
      |> async.par_collect
      |> ignore
      ;[]
  """,
  timeout: 300_000
)
```

