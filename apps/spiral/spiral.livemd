### block

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"type block =\n    {\n        magic : magic\n        content : () -> string\n    }\n\ninl block () =\n    trace Verbose (fun () => \"spiral.block\") (fun () => {})\n    pipe2\n        (magic_command ())\n        (content ())\n        fun magic, content =>\n            trace Verbose (fun () => \"spiral.block\") (fun () => { magic })\n            inl magic, content =\n                match magic () with\n                | \"fsharp\" => Fsharp, content\n                | \"markdown\" => Markdown, content\n                | \"spiral\" =>\n                    inl content = content ()\n                    inl output =\n                        if content |> sm'.contains \"///- \" && content |> sm'.contains (\" --\" ++# \"real\")\n                        then Spir\n                        else Spi\n                    output |> Spiral, fun () => content\n                | magic => magic |> Magic, content\n            {\n                magic = magic\n                content = content\n            }","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  type block =
      {
          magic : magic
          content : () -> string
      }

  inl block () =
      trace Verbose (fun () => "spiral.block") (fun () => {})
      pipe2
          (magic_command ())
          (content ())
          fun magic, content =>
              trace Verbose (fun () => "spiral.block") (fun () => { magic })
              inl magic, content =
                  match magic () with
                  | "fsharp" => Fsharp, content
                  | "markdown" => Markdown, content
                  | "spiral" =>
                      inl content = content ()
                      inl output =
                          if content |> sm'.contains "///- " && content |> sm'.contains (" --" ++# "real")
                          then Spir
                          else Spi
                      output |> Spiral, fun () => content
                  | magic => magic |> Magic, content
              {
                  magic = magic
                  content = content
              }
  """,
  timeout: 300_000
)
```

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"///- --test\n\n\"#!magic\\n\\n\\na\\n\\n\\n\"\n|> run_parser (block ())\n|> resultm.map fun block, b, s => { block with content = block.content () }, b, s\n|> unwrap_format\n|> _assert_eq #?*(Magic \"magic\", \"a\", \"\", new_parser_state 14 7 1 14)","print_code":false},"livebook_object":"smart_cell"} -->

