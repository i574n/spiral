### get_workspace_cargo_toml_content

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":":= get_workspace_cargo_toml_content { workspace_root contract } : string =\n    := msrv_aware_resolver_for_near_cargo = contract\n    := cargo_features : string =\n        ? msrv_aware_resolver_for_near_cargo\n        ?> $'$\"cargo-features = [\\\\\\\"profile-rustflags\\\\\\\", \\\\\\\"edition2024\\\\\\\"]\"'\n        |: $'$\"cargo-features = [\\\\\\\"profile-rustflags\\\\\\\"]\"'\n    := resolver : string =\n        ? msrv_aware_resolver_for_near_cargo\n        ?> $'$\"resolver = \\\\\\\"3\\\\\\\"\"'\n        |: $'$\"resolver = \\\\\\\"2\\\\\\\"\"'\n    cargo_features\n    ++\\# $'$\"\"'\n    ++\\# $'$\"[workspace]\"'\n    ++\\# resolver\n    ++\\# $'$\"members = [\\\\\\\"packages/Rust/*\\\\\\\"]\"'\n    ++\\# $'$\"\"'\n    ++\\# $'$\"[workspace.dependencies]\"'\n    ++\\# $'$\"inline_colorization = \\\\\\\"~0.1\\\\\\\"\"'\n    ++\\# $'$\"\"'\n    ++\\# $'$\"[profile.dev]\"'\n    ++\\# $'$\"codegen-units = 256\"'\n    ++\\# $'$\"opt-level = 0\"'\n    ++\\# $'$\"lto = false\"'\n    ++\\# $'$\"debug = 1\"'\n    ++\\# $'$\"panic = \\\\\\\"unwind\\\\\\\"\"'\n    ++\\# $'$\"rustflags = [\\\\\\\"-C\\\\\\\", \\\\\\\"link-arg=-s\\\\\\\"]\"'\n    ++\\# $'$\"strip = \\\\\\\"debuginfo\\\\\\\"\"'\n    ++\\# $'$\"rpath = true\"'\n    ++\\# $'$\"\"'\n    ++\\# $'$\"[profile.release]\"'\n    ++\\# $'$\"codegen-units = 1\"'\n    ++\\# $'$\"opt-level = \\\\\\\"z\\\\\\\"\"'\n    ++\\# $'$\"lto = true\"'\n    ++\\# $'$\"debug = false\"'\n    ++\\# $'$\"panic = \\\\\\\"abort\\\\\\\"\"'\n    ++\\# $'$\"overflow-checks = true\"'\n    ++\\# $'$\"rustflags = [\\\\\\\"-C\\\\\\\", \\\\\\\"link-arg=-s\\\\\\\"]\"'","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  := get_workspace_cargo_toml_content { workspace_root contract } : string =
      := msrv_aware_resolver_for_near_cargo = contract
      := cargo_features : string =
          ? msrv_aware_resolver_for_near_cargo
          ?> $'$"cargo-features = [\\\"profile-rustflags\\\", \\\"edition2024\\\"]"'
          |: $'$"cargo-features = [\\\"profile-rustflags\\\"]"'
      := resolver : string =
          ? msrv_aware_resolver_for_near_cargo
          ?> $'$"resolver = \\\"3\\\""'
          |: $'$"resolver = \\\"2\\\""'
      cargo_features
      ++\# $'$""'
      ++\# $'$"[workspace]"'
      ++\# resolver
      ++\# $'$"members = [\\\"packages/Rust/*\\\"]"'
      ++\# $'$""'
      ++\# $'$"[workspace.dependencies]"'
      ++\# $'$"inline_colorization = \\\"~0.1\\\""'
      ++\# $'$""'
      ++\# $'$"[profile.dev]"'
      ++\# $'$"codegen-units = 256"'
      ++\# $'$"opt-level = 0"'
      ++\# $'$"lto = false"'
      ++\# $'$"debug = 1"'
      ++\# $'$"panic = \\\"unwind\\\""'
      ++\# $'$"rustflags = [\\\"-C\\\", \\\"link-arg=-s\\\"]"'
      ++\# $'$"strip = \\\"debuginfo\\\""'
      ++\# $'$"rpath = true"'
      ++\# $'$""'
      ++\# $'$"[profile.release]"'
      ++\# $'$"codegen-units = 1"'
      ++\# $'$"opt-level = \\\"z\\\""'
      ++\# $'$"lto = true"'
      ++\# $'$"debug = false"'
      ++\# $'$"panic = \\\"abort\\\""'
      ++\# $'$"overflow-checks = true"'
      ++\# $'$"rustflags = [\\\"-C\\\", \\\"link-arg=-s\\\"]"'
  """,
  timeout: 300_000
)
```

### get_cargo_toml_content

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":":= get_cargo_toml_content { hash runtime deps } : string =\n    $'$\"cargo-features = [\\\\\\\"edition2024\\\\\\\"]\"'\n    ++\\# $'$\"\"'\n    ++\\# $'$\"[package]\"'\n    ++\\# $'$\"name = \\\\\\\"spiral_{!hash}\\\\\\\"\"'\n    ++\\# $'$\"version = \\\\\\\"0.0.1\\\\\\\"\"'\n    ++\\# $'$\"edition = \\\\\\\"2024\\\\\\\"\"'\n    ++\\# $'$\"\"'\n    ++\\# $'$\"[dependencies]\"'\n    ++\\# $'$\"inline_colorization = {{ workspace = true }}\"'\n    ++\\# $'$\"{!deps}\"'\n    ++\\# $'$\"\"'\n    ++\\# (\n        ? runtime = None ?>\n            $'$\"[[bin]]\"'\n            ++\\# $'$\"name = \\\\\\\"spiral_{!hash}\\\\\\\"\"'\n        |:\n            $'$\"[lib]\"'\n            ++\\# $'$\"crate-type = [\\\\\\\"cdylib\\\\\\\"]\"'\n    )\n    ++\\# $'$\"path = \\\\\\\"spiral.rs\\\\\\\"\"'","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  := get_cargo_toml_content { hash runtime deps } : string =
      $'$"cargo-features = [\\\"edition2024\\\"]"'
      ++\# $'$""'
      ++\# $'$"[package]"'
      ++\# $'$"name = \\\"spiral_{!hash}\\\""'
      ++\# $'$"version = \\\"0.0.1\\\""'
      ++\# $'$"edition = \\\"2024\\\""'
      ++\# $'$""'
      ++\# $'$"[dependencies]"'
      ++\# $'$"inline_colorization = {{ workspace = true }}"'
      ++\# $'$"{!deps}"'
      ++\# $'$""'
      ++\# (
          ? runtime = None ?>
              $'$"[[bin]]"'
              ++\# $'$"name = \\\"spiral_{!hash}\\\""'
          |:
              $'$"[lib]"'
              ++\# $'$"crate-type = [\\\"cdylib\\\"]"'
      )
      ++\# $'$"path = \\\"spiral.rs\\\""'
  """,
  timeout: 300_000
)
```

### get_empty_cargo_toml_content

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":":= get_empty_cargo_toml_content () =\n    := guid = date_time.now () |> date_time.new_guid_from_date_time |> sm'.obj_to_string\n    $'$\"[package]\"'\n    ++\\# $'$\"name = \\\\\\\"spiral_{!guid}\\\\\\\"\"'\n    ++\\# $'$\"version = \\\\\\\"0.0.1\\\\\\\"\"'\n    ++\\# $'$\"edition = \\\\\\\"2021\\\\\\\"\"'\n    ++\\# $'$\"\"'\n    ++\\# $'$\"[[bin]]\"'\n    ++\\# $'$\"name = \\\\\\\"spiral_{!guid}\\\\\\\"\"'\n    ++\\# $'$\"path = \\\\\\\"spiral.rs\\\\\\\"\"'","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  := get_empty_cargo_toml_content () =
      := guid = date_time.now () |> date_time.new_guid_from_date_time |> sm'.obj_to_string
      $'$"[package]"'
      ++\# $'$"name = \\\"spiral_{!guid}\\\""'
      ++\# $'$"version = \\\"0.0.1\\\""'
      ++\# $'$"edition = \\\"2021\\\""'
      ++\# $'$""'
      ++\# $'$"[[bin]]"'
      ++\# $'$"name = \\\"spiral_{!guid}\\\""'
      ++\# $'$"path = \\\"spiral.rs\\\""'
  """,
  timeout: 300_000
)
```

### process_rust

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":":= process_rust { rs_path deps trace_level runtime cleanup } =\n    :< runtime\n\n    := extension = \"rs\"\n    := code = rs_path |> file_system.read_all_text\n\n    := hash = #?{ extension code runtime } |> crypto.hash_text\n\n    := workspace_name = \"spiral\"\n    := contract = runtime <> None\n    := workspace_dir_name : string = ? contract ?> \"spiral_contract\" |: workspace_name\n\n    := workspace_root_external = file_system.get_workspace_root_external ()\n    := workspace_root = workspace_root_external |> resultm.box |> resultm.unwrap_or_else id\n\n    := package_dir =\n        get_package_dir { workspace_root name = workspace_dir_name; target = Some Rust; hash = hash |> Some }\n\n    package_dir |> file_system.create_dir |> ignore\n\n    := workspace_dir = package_dir </> \"../../..\"\n    := workspace_cargo_toml_path = workspace_dir </> \"Cargo.toml\"\n\n    ? workspace_cargo_toml_path |> file_system.file_exists |> not\n    ?> get_empty_cargo_toml_content () |> file_system.write_all_text workspace_cargo_toml_path\n\n    := cargo_toml_path = package_dir </> \"Cargo.toml\"\n\n    := result' = {\n        extension = Some extension\n        code = None\n        code_path = None\n        output = None\n    }\n\n    := deps =\n        := deps =\n            ? runtime = None\n            ?> deps\n            |:\n                := has_near_sdk =\n                    deps\n                    |> am'.vec_filter (sm'.from_std_string >> sm'.contains \"near-sdk\")\n                    |> am'.vec_len\n                    |> convert.i32\n                    |> \\ (n : int) => n > 0\n                ? has_near_sdk\n                ?> deps\n                |: deps |> am'.vec_extend (;[ \"near-sdk=\\\"=5.11.0\\\"\" |> sm'.to_std_string ] |> am'.base |> am'.to_vec)\n                |> am'.vec_extend (;[ \"indexmap=\\\"=2.11.4\\\"\" |> sm'.to_std_string ] |> am'.base |> am'.to_vec)\n        deps\n        |> am'.vec_map \\ dep =>\n            := dep = dep |> sm'.from_std_string\n            ? dep |> sm'.contains \"=\"\n            ?> dep\n            |? dep |> sm'.ends_with \"]\"\n            ?> dep |> sm'.replace \"[\" $'$\"={{version=\\'*\\',features=[\"' |> \\ x => $'$\"{!x}}}\"'\n            |: $'$\"{!dep}=\\'*\\'\"'\n        |> am'.from_vec\n        |> \\ x => x : array _\n        |> seq.of_array'\n        |> sm'.concat \"\\n\"\n\n    := new_code_path = package_dir </> $'$\"{!workspace_name}.{!extension}\"'\n\n    := cargo_toml_content = get_cargo_toml_content { hash runtime deps }\n    := workspace_cargo_toml_content = get_workspace_cargo_toml_content { workspace_root contract }\n\n    cargo_toml_content |> file_system.write_all_text_exists cargo_toml_path\n    workspace_cargo_toml_content |> file_system.write_all_text_exists workspace_cargo_toml_path\n\n    := main_code : string =\n        ? runtime = None\n        ?> \"\"\n        |:\n            $'$\"\\#[near_sdk::near_bindgen]\"'\n            ++\\# $'$\"\\#[derive(near_sdk::PanicOnDefault)]\"'\n            ++\\# $'$\"pub struct MainState {{\"'\n            ++\\# $'$\"}}\"'\n            ++\\# $'$\"\"'\n            ++\\# $'$\"\\#[near_sdk::near_bindgen]\"'\n            ++\\# $'$\"impl MainState {{\"'\n            ++\\# $'$\"    pub fn state_main() {{\"'\n            ++\\# $'$\"        spiral_main();\"'\n            ++\\# $'$\"    }}\"'\n            ++\\# $'$\"}}\"'\n\n    := new_code =\n        ? main_code = \"\"\n        ?> code\n        |: $'$\"{!code}\\\\n\\\\n{!main_code}\\\\n\"'\n\n    new_code |> file_system.write_all_text_exists new_code_path\n\n    := exit_code, cargo_fmt_result =\n        \\ () =>\n            := exit_code, result =\n                execution_options \\ x => { x ?|\n                    command = $'$\"cargo fmt --manifest-path \\\\\\\"{!cargo_toml_path}\\\\\\\" --\"'\n                    working_directory = workspace_root_external |> resultm.box |> resultm.ok'\n                }\n                |> execute_with_options\n\n            := return () =\n                ? exit_code = 0\n                ?> Ok (exit_code, result)\n                |: Error (exit_code, result)\n\n            ? result |> sm'.contains \"failed to load manifest for workspace member\" |> not\n            ?> return ()\n            |:\n                := missing_toml_path =\n                    \"failed to read `(?<a>.*?Cargo.toml)`\"\n                    |> sm'.new_regex\n                    |> resultm.unwrap'\n                    |> sm'.regex_captures result\n                    |> am'.from_vec\n                    |> \\ x => x : array _\n                    |> am'.try_item 0\n                    |> optionm.map (mapm.get \"a\" >> optionm'.unbox)\n                    |> optionm'.flatten\n                ?= missing_toml_path ?|\n                | None => Error (exit_code, result)\n                | Some missing_toml_path =>\n                    ? missing_toml_path |> file_system.file_exists |> not ?>\n                        missing_toml_path\n                        |> file_system.directory_get_parent\n                        |> optionm'.default_value' \"\"\n                        |> file_system.create_dir\n                        |> ignore\n                        get_empty_cargo_toml_content ()\n                        |> file_system.write_all_text missing_toml_path\n                    return ()\n        |> retry_fn' 3u8\n\n    ? exit_code <>. 0 ?>\n        trace Critical\n            \\ () => \"spiral.process_rust / cargo fmt error\"\n            \\ () => { exit_code cargo_fmt_result }\n\n    := new_code = new_code_path |> file_system.read_all_text\n\n    := command =\n        ? runtime <> None\n        then $'$\"cargo +nightly-2024-07-14 build --timings --release --target wasm32-unknown-unknown --manifest-path \\\n            \\\\\\\"{!cargo_toml_path}\\\\\\\"\"'\n        |: $'$\"cargo run --timings --manifest-path \\\\\\\"{!cargo_toml_path}\\\\\\\"\"'\n    := environment_variables =\n        ? runtime <> None\n        ?> ;[]\n        |:\n            := fast = !-\n            ;[\n                \"TRACE_LEVEL\", \"Verbose\"\n                \"RUSTC_WRAPPER\", \"sccache\"\n                \"RUST_BACKTRACE\", \"full\"\n                \"RUSTFLAGS\",\n                ? fast\n                ?> \"-C prefer-dynamic -C strip=symbols -C link-arg=-s -C debuginfo=0\"\n                |: \"-C prefer-dynamic\"\n            ]\n    := exit_code, cargo_result =\n        execution_options \\ x => { x ?|\n            command\n            environment_variables = am'.base environment_variables\n            working_directory = workspace_root_external |> resultm.box |> resultm.ok'\n        }\n        |> execute_with_options\n\n    := result, error =\n        ? runtime = None ?>\n            := external_command =\n                := vars =\n                    environment_variables\n                    |> arraym.map \\ k, v => $'$\"$env:{!k}=\\'\\'{!v}\\'\\'\"' : string\n                    |> \\ x => x : array _\n                    |> seq.of_array\n                    |> sm'.concat \";\"\n                := command =\n                    ;[\n                        vars\n                        command\n                    ]\n                    |> \\ x => x : array _\n                    |> seq.of_array\n                    |> sm'.concat \";\"\n                $'$\"pwsh -c \\'{!command}\\'\"' : string\n            ? exit_code <>. 0 ?>\n                trace Critical\n                    \\ () => \"spiral.process_rust / error\"\n                    \\ () => { exit_code new_code_path external_command cleanup cargo_result }\n                result',\n                \"spiral.process_rust / error / \"\n                ++#? { exit_code new_code_path external_command }\n                ++# \"\\n\"\n                ++# cargo_result\n            |:\n                := output =\n                    try\n                        \\ () =>\n                            cargo_result\n                            |> sm'.split \"\\n\"\n                            |> \\ x => array x : array _\n                            |> am'.skip_while \\ line =>\n                                (line |> sm'.contains \"profile [optimized] target\" |> not)\n                                    && (line |> sm'.contains \"profile [unoptimized] target\" |> not)\n                                    && (line |> sm'.contains \"profile [unoptimized + debuginfo] target\" |> not)\n                            |> am'.skip 2\n                            |> seq.of_array\n                            |> sm'.concat \"\\n\"\n                        \\ ex =>\n                            trace Critical\n                                \\ () => \"spiral.process_rust / Exception\"\n                                \\ () => { ex new_code_path external_command cargo_result }\n                            None\n                    |> optionm'.box\n                    |> optionm'.unwrap\n                { result' ?|\n                    code = Some new_code\n                    code_path = Some new_code_path\n                    output = Some output\n                }, \"\"\n        |:\n            := wasm_path : string =\n                $'$\"target/spiral/{!workspace_dir_name}/target/wasm32-unknown-unknown/release/spiral_{!hash}.wasm\"'\n\n            := spiral_wasm_command : string =\n                := runtime_cmd =\n                    ?= runtime ?|\n                    | Some (Wasm cmd) => cmd\n                    | Some (Contract cmd) => cmd\n                    | _ => \"\"\n                $'$\"workspace/target/release/spiral_wasm -w {!wasm_path} -t debug {!runtime_cmd}\"'\n            := command =\n                := invoke_block_path = \"scripts/invoke-block.ps1\"\n                := automation = \"AUTOMATION\" |> env.get_environment_variable\n                $'$\"pwsh -c \\\\\\\"pwsh {!invoke_block_path} $env:SPIRAL_WASM_COMMAND -Linux -EnvironmentVariables \\\n                    AUTOMATION={!automation}\\`nNEAR_RPC_TIMEOUT_SECS=100\\\\\\\"\"'\n\n            ? exit_code = 0 ?>\n                := exit_code, spiral_wasm_result =\n                    execution_options \\ x => { x ?|\n                        command\n                        environment_variables = am'.base ;[ \"SPIRAL_WASM_COMMAND\", spiral_wasm_command ]\n                        working_directory = workspace_root |> optionm'.some'\n                    }\n                    |> execute_with_options\n\n                ? exit_code = 0 ?>\n                    { result' ?|\n                        code = Some new_code\n                        code_path = Some new_code_path\n                        output = Some spiral_wasm_result\n                    }, \"\"\n                |:\n                    trace Critical\n                        \\ () => \"spiral.process_rust / wasm error\"\n                        \\ () => {\n                            exit_code new_code_path cargo_result cleanup\n                            spiral_wasm_result = $'$\"\\\\n{!spiral_wasm_result}\"' : string\n                        }\n                    result',\n                    \"spiral.process_rust / wasm error / \"\n                    ++#? { exit_code new_code_path }\n                    ++# \"\\n\"\n                    ++# spiral_wasm_result\n            |:\n                trace Critical\n                    \\ () => \"spiral.process_rust / cargo error\"\n                    \\ () => {\n                        exit_code new_code_path wasm_path command cleanup\n                        cargo_result = $'$\"\\\\n{!cargo_result}\"' : string\n                    }\n                result',\n                \"spiral.process_rust / cargo error / \" ++#? { exit_code new_code_path } ++# \"\\n\" ++# cargo_result\n\n    := ci = \"CI\" |> env.get_environment_variable\n\n    ? cleanup || ci <> \"\" ?>\n        package_dir |> file_system.directory_delete !+\n\n        := cleanup =\n            := build_target =\n                ? runtime <> None\n                ?> \"wasm32-unknown-unknown/release\"\n                |: \"debug\"\n\n            [ \".d\"; \".exe\"; \".pdb\"; \".wasm\"; \"\" ]\n            |> listm.map \\ ext =>\n                workspace_dir </> $'$\"target/{!build_target}/spiral_{!hash}{!ext}\"'\n            |> listm.map \\ path => path, path |> file_system.file_exists\n\n        trace Verbose\n            \\ () => \"spiral.process_rust / cleanup\"\n            \\ () => { new_code_path cleanup }\n\n        cleanup\n        |> listm'.filter snd\n        |> listm.iter (fst >> file_system.file_delete)\n\n    ? error <> \"\" ?>\n        run_target \\|\n            | Rust => \\ () => $'{ eprintln\\!(\"{}\", !error); std::process::exit(1) }' : ()\n            | _ => \\ () => failwith error\n    result","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  := process_rust { rs_path deps trace_level runtime cleanup } =
      :< runtime

      := extension = "rs"
      := code = rs_path |> file_system.read_all_text

      := hash = #?{ extension code runtime } |> crypto.hash_text

      := workspace_name = "spiral"
      := contract = runtime <> None
      := workspace_dir_name : string = ? contract ?> "spiral_contract" |: workspace_name

      := workspace_root_external = file_system.get_workspace_root_external ()
      := workspace_root = workspace_root_external |> resultm.box |> resultm.unwrap_or_else id

      := package_dir =
          get_package_dir { workspace_root name = workspace_dir_name; target = Some Rust; hash = hash |> Some }

      package_dir |> file_system.create_dir |> ignore

      := workspace_dir = package_dir </> "../../.."
      := workspace_cargo_toml_path = workspace_dir </> "Cargo.toml"

      ? workspace_cargo_toml_path |> file_system.file_exists |> not
      ?> get_empty_cargo_toml_content () |> file_system.write_all_text workspace_cargo_toml_path

      := cargo_toml_path = package_dir </> "Cargo.toml"

      := result' = {
          extension = Some extension
          code = None
          code_path = None
          output = None
      }

      := deps =
          := deps =
              ? runtime = None
              ?> deps
              |:
                  := has_near_sdk =
                      deps
                      |> am'.vec_filter (sm'.from_std_string >> sm'.contains "near-sdk")
                      |> am'.vec_len
                      |> convert.i32
                      |> \ (n : int) => n > 0
                  ? has_near_sdk
                  ?> deps
                  |: deps |> am'.vec_extend (;[ "near-sdk=\"=5.11.0\"" |> sm'.to_std_string ] |> am'.base |> am'.to_vec)
                  |> am'.vec_extend (;[ "indexmap=\"=2.11.4\"" |> sm'.to_std_string ] |> am'.base |> am'.to_vec)
          deps
          |> am'.vec_map \ dep =>
              := dep = dep |> sm'.from_std_string
              ? dep |> sm'.contains "="
              ?> dep
              |? dep |> sm'.ends_with "]"
              ?> dep |> sm'.replace "[" $'$"={{version=\'*\',features=["' |> \ x => $'$"{!x}}}"'
              |: $'$"{!dep}=\'*\'"'
          |> am'.from_vec
          |> \ x => x : array _
          |> seq.of_array'
          |> sm'.concat "\n"

      := new_code_path = package_dir </> $'$"{!workspace_name}.{!extension}"'

      := cargo_toml_content = get_cargo_toml_content { hash runtime deps }
      := workspace_cargo_toml_content = get_workspace_cargo_toml_content { workspace_root contract }

      cargo_toml_content |> file_system.write_all_text_exists cargo_toml_path
      workspace_cargo_toml_content |> file_system.write_all_text_exists workspace_cargo_toml_path

      := main_code : string =
          ? runtime = None
          ?> ""
          |:
              $'$"\#[near_sdk::near_bindgen]"'
              ++\# $'$"\#[derive(near_sdk::PanicOnDefault)]"'
              ++\# $'$"pub struct MainState {{"'
              ++\# $'$"}}"'
              ++\# $'$""'
              ++\# $'$"\#[near_sdk::near_bindgen]"'
              ++\# $'$"impl MainState {{"'
              ++\# $'$"    pub fn state_main() {{"'
              ++\# $'$"        spiral_main();"'
              ++\# $'$"    }}"'
              ++\# $'$"}}"'

      := new_code =
          ? main_code = ""
          ?> code
          |: $'$"{!code}\\n\\n{!main_code}\\n"'

      new_code |> file_system.write_all_text_exists new_code_path

      := exit_code, cargo_fmt_result =
          \ () =>
              := exit_code, result =
                  execution_options \ x => { x ?|
                      command = $'$"cargo fmt --manifest-path \\\"{!cargo_toml_path}\\\" --"'
                      working_directory = workspace_root_external |> resultm.box |> resultm.ok'
                  }
                  |> execute_with_options

              := return () =
                  ? exit_code = 0
                  ?> Ok (exit_code, result)
                  |: Error (exit_code, result)

              ? result |> sm'.contains "failed to load manifest for workspace member" |> not
              ?> return ()
              |:
                  := missing_toml_path =
                      "failed to read `(?<a>.*?Cargo.toml)`"
                      |> sm'.new_regex
                      |> resultm.unwrap'
                      |> sm'.regex_captures result
                      |> am'.from_vec
                      |> \ x => x : array _
                      |> am'.try_item 0
                      |> optionm.map (mapm.get "a" >> optionm'.unbox)
                      |> optionm'.flatten
                  ?= missing_toml_path ?|
                  | None => Error (exit_code, result)
                  | Some missing_toml_path =>
                      ? missing_toml_path |> file_system.file_exists |> not ?>
                          missing_toml_path
                          |> file_system.directory_get_parent
                          |> optionm'.default_value' ""
                          |> file_system.create_dir
                          |> ignore
                          get_empty_cargo_toml_content ()
                          |> file_system.write_all_text missing_toml_path
                      return ()
          |> retry_fn' 3u8

      ? exit_code <>. 0 ?>
          trace Critical
              \ () => "spiral.process_rust / cargo fmt error"
              \ () => { exit_code cargo_fmt_result }

      := new_code = new_code_path |> file_system.read_all_text

      := command =
          ? runtime <> None
          then $'$"cargo +nightly-2024-07-14 build --timings --release --target wasm32-unknown-unknown --manifest-path \
              \\\"{!cargo_toml_path}\\\""'
          |: $'$"cargo run --timings --manifest-path \\\"{!cargo_toml_path}\\\""'
      := environment_variables =
          ? runtime <> None
          ?> ;[]
          |:
              := fast = !-
              ;[
                  "TRACE_LEVEL", "Verbose"
                  "RUSTC_WRAPPER", "sccache"
                  "RUST_BACKTRACE", "full"
                  "RUSTFLAGS",
                  ? fast
                  ?> "-C prefer-dynamic -C strip=symbols -C link-arg=-s -C debuginfo=0"
                  |: "-C prefer-dynamic"
              ]
      := exit_code, cargo_result =
          execution_options \ x => { x ?|
              command
              environment_variables = am'.base environment_variables
              working_directory = workspace_root_external |> resultm.box |> resultm.ok'
          }
          |> execute_with_options

      := result, error =
          ? runtime = None ?>
              := external_command =
                  := vars =
                      environment_variables
                      |> arraym.map \ k, v => $'$"$env:{!k}=\'\'{!v}\'\'"' : string
                      |> \ x => x : array _
                      |> seq.of_array
                      |> sm'.concat ";"
                  := command =
                      ;[
                          vars
                          command
                      ]
                      |> \ x => x : array _
                      |> seq.of_array
                      |> sm'.concat ";"
                  $'$"pwsh -c \'{!command}\'"' : string
              ? exit_code <>. 0 ?>
                  trace Critical
                      \ () => "spiral.process_rust / error"
                      \ () => { exit_code new_code_path external_command cleanup cargo_result }
                  result',
                  "spiral.process_rust / error / "
                  ++#? { exit_code new_code_path external_command }
                  ++# "\n"
                  ++# cargo_result
              |:
                  := output =
                      try
                          \ () =>
                              cargo_result
                              |> sm'.split "\n"
                              |> \ x => array x : array _
                              |> am'.skip_while \ line =>
                                  (line |> sm'.contains "profile [optimized] target" |> not)
                                      && (line |> sm'.contains "profile [unoptimized] target" |> not)
                                      && (line |> sm'.contains "profile [unoptimized + debuginfo] target" |> not)
                              |> am'.skip 2
                              |> seq.of_array
                              |> sm'.concat "\n"
                          \ ex =>
                              trace Critical
                                  \ () => "spiral.process_rust / Exception"
                                  \ () => { ex new_code_path external_command cargo_result }
                              None
                      |> optionm'.box
                      |> optionm'.unwrap
                  { result' ?|
                      code = Some new_code
                      code_path = Some new_code_path
                      output = Some output
                  }, ""
          |:
              := wasm_path : string =
                  $'$"target/spiral/{!workspace_dir_name}/target/wasm32-unknown-unknown/release/spiral_{!hash}.wasm"'

              := spiral_wasm_command : string =
                  := runtime_cmd =
                      ?= runtime ?|
                      | Some (Wasm cmd) => cmd
                      | Some (Contract cmd) => cmd
                      | _ => ""
                  $'$"workspace/target/release/spiral_wasm -w {!wasm_path} -t debug {!runtime_cmd}"'
              := command =
                  := invoke_block_path = "scripts/invoke-block.ps1"
                  := automation = "AUTOMATION" |> env.get_environment_variable
                  $'$"pwsh -c \\\"pwsh {!invoke_block_path} $env:SPIRAL_WASM_COMMAND -Linux -EnvironmentVariables \
                      AUTOMATION={!automation}\`nNEAR_RPC_TIMEOUT_SECS=100\\\""'

              ? exit_code = 0 ?>
                  := exit_code, spiral_wasm_result =
                      execution_options \ x => { x ?|
                          command
                          environment_variables = am'.base ;[ "SPIRAL_WASM_COMMAND", spiral_wasm_command ]
                          working_directory = workspace_root |> optionm'.some'
                      }
                      |> execute_with_options

                  ? exit_code = 0 ?>
                      { result' ?|
                          code = Some new_code
                          code_path = Some new_code_path
                          output = Some spiral_wasm_result
                      }, ""
                  |:
                      trace Critical
                          \ () => "spiral.process_rust / wasm error"
                          \ () => {
                              exit_code new_code_path cargo_result cleanup
                              spiral_wasm_result = $'$"\\n{!spiral_wasm_result}"' : string
                          }
                      result',
                      "spiral.process_rust / wasm error / "
                      ++#? { exit_code new_code_path }
                      ++# "\n"
                      ++# spiral_wasm_result
              |:
                  trace Critical
                      \ () => "spiral.process_rust / cargo error"
                      \ () => {
                          exit_code new_code_path wasm_path command cleanup
                          cargo_result = $'$"\\n{!cargo_result}"' : string
                      }
                  result',
                  "spiral.process_rust / cargo error / " ++#? { exit_code new_code_path } ++# "\n" ++# cargo_result

      := ci = "CI" |> env.get_environment_variable

      ? cleanup || ci <> "" ?>
          package_dir |> file_system.directory_delete !+

          := cleanup =
              := build_target =
                  ? runtime <> None
                  ?> "wasm32-unknown-unknown/release"
                  |: "debug"

              [ ".d"; ".exe"; ".pdb"; ".wasm"; "" ]
              |> listm.map \ ext =>
                  workspace_dir </> $'$"target/{!build_target}/spiral_{!hash}{!ext}"'
              |> listm.map \ path => path, path |> file_system.file_exists

          trace Verbose
              \ () => "spiral.process_rust / cleanup"
              \ () => { new_code_path cleanup }

          cleanup
          |> listm'.filter snd
          |> listm.iter (fst >> file_system.file_delete)

      ? error <> "" ?>
          run_target \|
              | Rust => \ () => $'{ eprintln\!("{}", !error); std::process::exit(1) }' : ()
              | _ => \ () => failwith error
      result
  """,
  timeout: 300_000
)
```

