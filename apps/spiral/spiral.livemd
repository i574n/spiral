### process_cpp

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"inl process_cpp { cpp_path } =\n    inl extension = \"cpp\"\n\n    inl new_code_path = cpp_path\n    inl new_code = new_code_path |> file_system.read_all_text\n\n    inl package_dir = new_code_path |> file_system.directory_get_parent |> optionm'.default_value' \"\"\n\n    inl cxx =\n        inl cxx = \"SPIRAL_CXX\" |> env.get_environment_variable\n        if cxx = \"\" then \"g++\" else cxx\n    inl exe_path = new_code_path ++# \".out\" ++# (if platform.is_windows () then \".exe\" else \"\")\n\n    inl build_command =\n        cxx ++# \" -std=c++20 -O2 -w \\\"\" ++# new_code_path ++# \"\\\" -o \\\"\" ++# exe_path ++# \"\\\" -lm\"\n    inl exit_code, build_result =\n        runtime.execution_options fun x => { x with\n            command = build_command\n            working_directory = package_dir |> optionm'.some'\n        }\n        |> runtime.execute_with_options\n\n    if exit_code <>. 0 then\n        failwith (\"spiral.process_cpp / build failed\\n\" ++# build_result)\n    else\n        inl command = \"\\\"\" ++# exe_path ++# \"\\\"\"\n        inl exit_code, run_result =\n            runtime.execution_options fun x => { x with\n                command\n                working_directory = package_dir |> optionm'.some'\n            }\n            |> runtime.execute_with_options\n\n        if exit_code = 0 then\n            {\n                extension = Some extension\n                code = Some new_code\n                code_path = Some new_code_path\n                output = Some run_result\n            }\n        else\n            failwith (\"spiral.process_cpp / child failed\\n\" ++# run_result)","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  inl process_cpp { cpp_path } =
      inl extension = "cpp"

      inl new_code_path = cpp_path
      inl new_code = new_code_path |> file_system.read_all_text

      inl package_dir = new_code_path |> file_system.directory_get_parent |> optionm'.default_value' ""

      inl cxx =
          inl cxx = "SPIRAL_CXX" |> env.get_environment_variable
          if cxx = "" then "g++" else cxx
      inl exe_path = new_code_path ++# ".out" ++# (if platform.is_windows () then ".exe" else "")

      inl build_command =
          cxx ++# " -std=c++20 -O2 -w \"" ++# new_code_path ++# "\" -o \"" ++# exe_path ++# "\" -lm"
      inl exit_code, build_result =
          runtime.execution_options fun x => { x with
              command = build_command
              working_directory = package_dir |> optionm'.some'
          }
          |> runtime.execute_with_options

      if exit_code <>. 0 then
          failwith ("spiral.process_cpp / build failed\n" ++# build_result)
      else
          inl command = "\"" ++# exe_path ++# "\""
          inl exit_code, run_result =
              runtime.execution_options fun x => { x with
                  command
                  working_directory = package_dir |> optionm'.some'
              }
              |> runtime.execute_with_options

          if exit_code = 0 then
              {
                  extension = Some extension
                  code = Some new_code
                  code_path = Some new_code_path
                  output = Some run_result
              }
          else
              failwith ("spiral.process_cpp / child failed\n" ++# run_result)
  """,
  timeout: 300_000
)
```

