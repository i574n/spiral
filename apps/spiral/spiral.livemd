<!-- livebook:{"break_markdown":true} -->

### process_lua

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":":! lua =\n    `(\n        rust.rust_type\n            `($'mlua_Lua')\n            `($'mlua::Lua')\n            \"type mlua_Lua = obj\"\n    )\n\n:! lua_function =\n    `(\n        rust.rust_type\n            `($'mlua_LuaFunction')\n            `($'mlua::prelude::LuaFunction')\n            \"type mlua_LuaFunction = obj\"\n    )\n\n:! lua_error =\n    `(\n        rust.rust_type\n            `($'mlua_LuaError')\n            `($'mlua::prelude::LuaError')\n            \"type mlua_LuaError = obj\"\n    )\n\n:! lua_value =\n    `(\n        rust.rust_type\n            `($'mlua_LuaValue')\n            `($'mlua::prelude::LuaValue')\n            \"type mlua_LuaValue = obj\"\n    )\n\n:! lua_multi_value =\n    `(\n        rust.rust_type\n            `($'mlua_LuaMultiValue')\n            `($'mlua::prelude::LuaMultiValue')\n            \"type mlua_LuaMultiValue = obj\"\n    )\n\n:= lua_values_debug (values : lua_multi_value) : am'.vec string =\n    run_target_args (\\ () => values) \\|\n        | Rust => \\ values =>\n            $'!values.iter().map(|x| Rc::<str>::from(format\\!(\"{:?}\", x))).collect::<Vec<_>>()' : am'.vec string\n        | _ => \\ values =>\n            := values : am'.vec (rust.ref lua_value) = !\\\\(values, $'$\"$0.iter().collect()\"')\n            values |> am'.vec_map (rust.deref >> sm'.format_debug)\n\n:= lua_values_text (values : lua_multi_value) : am'.vec string =\n    run_target_args (\\ () => values) \\|\n        | Rust => \\ values =>\n            $'!values.iter().map(|x| Rc::<str>::from(x.to_string().unwrap_or_else(|_| format\\!(\"{:?}\", \\\n                x)))).collect::<Vec<_>>()' : am'.vec string\n        | _ => \\ values => lua_values_debug values\n\n:= process_lua { lua_path } =\n    := extension = \"lua\"\n\n    := new_code_path = lua_path\n    := new_code = new_code_path |> file_system.read_all_text\n\n    := hash = #?{ extension new_code } |> crypto.hash_text\n\n    := workspace_root_external = file_system.get_workspace_root_external ()\n    := workspace_root =\n        workspace_root_external |> resultm.box |> resultm.unwrap_or_else id |> file_system.standardize_path\n\n    := src_dir =\n        new_code_path\n        |> file_system.directory_get_parent\n        |> optionm'.default_value' \"\"\n        |> file_system.standardize_path\n\n    := package_dir = src_dir </> \"..\" |> file_system.standardize_path\n\n    := stdio = [] |> mut\n    := stdio_clone = stdio |> rust.clone\n    := partial_line = \"\" |> mut\n    := partial_line_write = partial_line |> rust.clone\n    := partial_line_final = partial_line |> rust.clone\n\n    := lua : lua =\n        !\\($'$\"mlua::Lua::new_with(mlua::StdLib::ALL_SAFE, mlua::LuaOptions::default()).unwrap()\"')\n\n    := custom_print (args : lua_multi_value) : _ _ lua_error =\n        := args =\n            args\n            |> lua_values_text\n            |> am'.from_vec_base\n            |> am'.to_list_base'\n            |> listm'.unbox\n            |> sm'.concat_list \"\\t\"\n        stdio <- (*partial_line ++# args) :: *stdio\n        partial_line <- \"\"\n        Ok () |> resultm.box\n\n    := custom_print : lua_function =\n        !\\\\(\n            (lua, custom_print),\n            $'$\"$0.create_function(move |_, args: mlua::prelude::LuaMultiValue| $1(args)).unwrap()\"'\n        )\n\n    !\\\\((lua, custom_print), $'$\"$0.globals().set(\\\\\\\"print\\\\\\\", $1).unwrap()\"')\n\n    := custom_write (args : lua_multi_value) : _ _ lua_error =\n        := text =\n            args\n            |> lua_values_text\n            |> am'.from_vec_base\n            |> am'.to_list_base'\n            |> listm'.unbox\n            |> sm'.concat_list \"\"\n        partial_line_write <- *partial_line_write ++# text\n        Ok () |> resultm.box\n\n    := custom_write : lua_function =\n        !\\\\(\n            (lua, custom_write),\n            $'$\"$0.create_function(move |_, args: mlua::prelude::LuaMultiValue| $1(args)).unwrap()\"'\n        )\n\n    !\\\\((lua, custom_write), $'$\"$0.globals().get::<mlua::Table>(\\\\\\\"io\\\\\\\").unwrap().set(\\\\\\\"write\\\\\\\", $1).unwrap()\"')\n\n    := output : lua_multi_value =\n        := new_code = new_code |> sm'.to_std_string\n        !\\\\((lua, new_code), $'$\"$0.load($1).eval::<mlua::MultiValue>().unwrap()\"')\n    := output =\n        output |> lua_values_text |> am'.from_vec |> sm'.concat_array \"\\n\"\n\n    := stdio =\n        := lines = ? *partial_line_final = \"\" ?> *stdio_clone |: *partial_line_final :: *stdio_clone\n        lines\n        |> listm.rev\n        |> sm'.concat_list \"\\n\"\n\n    \\ () =>\n        := ci = \"CI\" |> env.get_environment_variable\n        ? ci <> \"\" && package_owns_code src_dir ?>\n            package_dir\n            |> file_system.directory_delete !+\n    |> new_disposable\n    |> \\ x => x : _ ()\n    |> use\n    |> ignore\n\n    {\n        extension = Some extension\n        code = Some new_code\n        code_path = Some new_code_path\n        output = Some output\n        stdio = Some stdio\n    }","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  :! lua =
      `(
          rust.rust_type
              `($'mlua_Lua')
              `($'mlua::Lua')
              "type mlua_Lua = obj"
      )

  :! lua_function =
      `(
          rust.rust_type
              `($'mlua_LuaFunction')
              `($'mlua::prelude::LuaFunction')
              "type mlua_LuaFunction = obj"
      )

  :! lua_error =
      `(
          rust.rust_type
              `($'mlua_LuaError')
              `($'mlua::prelude::LuaError')
              "type mlua_LuaError = obj"
      )

  :! lua_value =
      `(
          rust.rust_type
              `($'mlua_LuaValue')
              `($'mlua::prelude::LuaValue')
              "type mlua_LuaValue = obj"
      )

  :! lua_multi_value =
      `(
          rust.rust_type
              `($'mlua_LuaMultiValue')
              `($'mlua::prelude::LuaMultiValue')
              "type mlua_LuaMultiValue = obj"
      )

  := lua_values_debug (values : lua_multi_value) : am'.vec string =
      run_target_args (\ () => values) \|
          | Rust => \ values =>
              $'!values.iter().map(|x| Rc::<str>::from(format\!("{:?}", x))).collect::<Vec<_>>()' : am'.vec string
          | _ => \ values =>
              := values : am'.vec (rust.ref lua_value) = !\\(values, $'$"$0.iter().collect()"')
              values |> am'.vec_map (rust.deref >> sm'.format_debug)

  := lua_values_text (values : lua_multi_value) : am'.vec string =
      run_target_args (\ () => values) \|
          | Rust => \ values =>
              $'!values.iter().map(|x| Rc::<str>::from(x.to_string().unwrap_or_else(|_| format\!("{:?}", \
                  x)))).collect::<Vec<_>>()' : am'.vec string
          | _ => \ values => lua_values_debug values

  := process_lua { lua_path } =
      := extension = "lua"

      := new_code_path = lua_path
      := new_code = new_code_path |> file_system.read_all_text

      := hash = #?{ extension new_code } |> crypto.hash_text

      := workspace_root_external = file_system.get_workspace_root_external ()
      := workspace_root =
          workspace_root_external |> resultm.box |> resultm.unwrap_or_else id |> file_system.standardize_path

      := src_dir =
          new_code_path
          |> file_system.directory_get_parent
          |> optionm'.default_value' ""
          |> file_system.standardize_path

      := package_dir = src_dir </> ".." |> file_system.standardize_path

      := stdio = [] |> mut
      := stdio_clone = stdio |> rust.clone
      := partial_line = "" |> mut
      := partial_line_write = partial_line |> rust.clone
      := partial_line_final = partial_line |> rust.clone

      := lua : lua =
          !\($'$"mlua::Lua::new_with(mlua::StdLib::ALL_SAFE, mlua::LuaOptions::default()).unwrap()"')

      := custom_print (args : lua_multi_value) : _ _ lua_error =
          := args =
              args
              |> lua_values_text
              |> am'.from_vec_base
              |> am'.to_list_base'
              |> listm'.unbox
              |> sm'.concat_list "\t"
          stdio <- (*partial_line ++# args) :: *stdio
          partial_line <- ""
          Ok () |> resultm.box

      := custom_print : lua_function =
          !\\(
              (lua, custom_print),
              $'$"$0.create_function(move |_, args: mlua::prelude::LuaMultiValue| $1(args)).unwrap()"'
          )

      !\\((lua, custom_print), $'$"$0.globals().set(\\\"print\\\", $1).unwrap()"')

      := custom_write (args : lua_multi_value) : _ _ lua_error =
          := text =
              args
              |> lua_values_text
              |> am'.from_vec_base
              |> am'.to_list_base'
              |> listm'.unbox
              |> sm'.concat_list ""
          partial_line_write <- *partial_line_write ++# text
          Ok () |> resultm.box

      := custom_write : lua_function =
          !\\(
              (lua, custom_write),
              $'$"$0.create_function(move |_, args: mlua::prelude::LuaMultiValue| $1(args)).unwrap()"'
          )

      !\\((lua, custom_write), $'$"$0.globals().get::<mlua::Table>(\\\"io\\\").unwrap().set(\\\"write\\\", $1).unwrap()"')

      := output : lua_multi_value =
          := new_code = new_code |> sm'.to_std_string
          !\\((lua, new_code), $'$"$0.load($1).eval::<mlua::MultiValue>().unwrap()"')
      := output =
          output |> lua_values_text |> am'.from_vec |> sm'.concat_array "\n"

      := stdio =
          := lines = ? *partial_line_final = "" ?> *stdio_clone |: *partial_line_final :: *stdio_clone
          lines
          |> listm.rev
          |> sm'.concat_list "\n"

      \ () =>
          := ci = "CI" |> env.get_environment_variable
          ? ci <> "" && package_owns_code src_dir ?>
              package_dir
              |> file_system.directory_delete !+
      |> new_disposable
      |> \ x => x : _ ()
      |> use
      |> ignore

      {
          extension = Some extension
          code = Some new_code
          code_path = Some new_code_path
          output = Some output
          stdio = Some stdio
      }
  """,
  timeout: 300_000
)
```

