### process_gleam

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":":= package_owns_code (src_dir : string) : bool =\n    (src_dir |> sm'.ends_with \"/src\") || (src_dir |> sm'.ends_with \"\\\\src\")\n\n:= process_gleam { gleam_path target deps } =\n    := extension = \"gleam\"\n\n    := new_code_path = gleam_path\n    := new_code = new_code_path |> file_system.read_all_text\n\n    := hash = #?{ extension new_code } |> crypto.hash_text\n\n    := workspace_root_external = file_system.get_workspace_root_external ()\n    := workspace_root =\n        workspace_root_external |> resultm.box |> resultm.unwrap_or_else id |> file_system.standardize_path\n\n    := src_dir =\n        new_code_path\n        |> file_system.directory_get_parent\n        |> optionm'.default_value' \"\"\n        |> file_system.standardize_path\n\n    := owned = package_owns_code src_dir\n\n    := package_dir =\n        ? owned\n        ?> src_dir </> \"..\" |> file_system.standardize_path\n        |: src_dir </> \"gleam_package\" |> file_system.standardize_path\n\n    \\ () =>\n        := ci = \"CI\" |> env.get_environment_variable\n        ? ci <> \"\" && package_owns_code src_dir ?>\n            package_dir\n            |> file_system.directory_delete !+\n    |> new_disposable\n    |> \\ x => x : _ ()\n    |> use\n    |> ignore\n\n    := manifest_path = package_dir </> \"gleam.toml\"\n\n    := deps =\n        am'.base ;[\n            \"gleam_stdlib=\\\"0.57.0\\\"\"\n            \"gleam_time=\\\">=1.0.0 and <2.0.0\\\"\"\n            \"gleam_erlang=\\\">=0.34.0 and <1.0.0\\\"\"\n            \"envoy=\\\">=1.0.0 and <2.0.0\\\"\"\n            \"gary=\\\">=1.1.0 and <2.0.0\\\"\"\n            \"gtempo=\\\">=7.1.0 and <8.0.0\\\"\"\n        ]\n        |> am'.to_vec\n        |> am'.vec_map sm'.to_std_string\n        |> am'.vec_extend deps\n        |> am'.vec_map \\ dep =>\n            := dep = dep |> sm'.from_std_string\n            ? dep |> sm'.contains \"=\"\n            ?> dep\n            |? dep |> sm'.ends_with \"]\"\n            ?> dep |> sm'.replace \"[\" $'$\"={{version=\\'*\\',features=[\"' |> \\ x => $'$\"{!x}}}\"'\n            |: $'$\"{!dep}=\\'*\\'\"'\n        |> am'.from_vec\n        |> \\ x => x : array _\n        |> seq.of_array'\n        |> sm'.concat \"\\n\"\n\n    := target' = target |> reflection.union_to_string |> sm'.to_lower\n\n    := manifest =\n        := main =\n            ? new_code_path |> sm'.contains \"_real\"\n            ?> \"main_real\"\n            |: \"main\"\n        $'$\"name = \\\\\\\"{!main}\\\\\\\"\"'\n        ++\\# $'$\"target = \\\\\\\"{!target'}\\\\\\\"\"'\n        ++\\# $'$\"\"'\n        ++\\# $'$\"[dependencies]\"'\n        ++\\# $'$\"{!deps}\"'\n\n    manifest |> file_system.write_all_text_exists manifest_path\n\n    ? owned |> not ?>\n        := module_file = ? new_code_path |> sm'.contains \"_real\" ?> \"main_real.gleam\" |: \"main.gleam\"\n        new_code |> file_system.write_all_text_exists (package_dir </> \"src\" </> module_file)\n\n    := exit_code, run_result =\n        0i32, \"\"\n\n    ? exit_code <>. 0 ?>\n        trace Critical\n            \\ () => \"spiral.process_gleam / check error\"\n            \\ () => { exit_code run_result new_code_path }\n        { extension = Some extension; code = None; code_path = None; output = None }\n    |:\n        := command =\n            ? target = Erlang\n            ?> $'$\"gleam run --no-print-progress \\\\\\\"{!new_code_path}\\\\\\\"\"' : string\n            |: $'$\"gleam build --no-print-progress\"'\n        := environment_variables =\n            ;[\n                \"TRACE_LEVEL\", \"\"\n                \"GLEAM_LOG\", \"\"\n                \"GLEAM_LOG_NOCOLOUR\", \"\"\n            ]\n        ? target = Erlang ?>\n            runtime.execution_options \\ x => { x ?|\n                command = \"gleam build --no-print-progress\"\n                environment_variables = am'.base environment_variables\n                working_directory = package_dir |> optionm'.some'\n                stderr = !-\n            }\n            |> runtime.execute_with_options\n            |> ignore\n        := exit_code, run_result =\n            runtime.execution_options \\ x => { x ?|\n                command\n                environment_variables = am'.base environment_variables\n                working_directory = package_dir |> optionm'.some'\n                stderr = !-\n            }\n            |> runtime.execute_with_options\n\n        := external_command =\n            := vars =\n                environment_variables\n                |> arraym.map \\ k, v => $'$\"$env:{!k}=\\'\\'{!v}\\'\\'\"' : string\n                |> \\ x => x : array _\n                |> seq.of_array\n                |> sm'.concat \";\"\n            $'$\"pwsh -c \\'{!vars}; {!command}\\'\"' : string\n        ? exit_code <>. 0 ?>\n            trace Critical\n                \\ () => \"spiral.process_gleam / error\"\n                \\ () => { exit_code run_result new_code_path external_command }\n            failwith (\"spiral.process_gleam / gleam run failed\\n\" ++# run_result)\n        |:\n            := run_result =\n                ? target = Erlang\n                ?> run_result\n                |:\n                    := js_path = $'$\"{!package_dir}/build/dev/javascript/main/main.mjs\"'\n                    := js_text = js_path |> file_system.read_all_text\n                    := js_text = js_text |> sm'.replace $'$\"\\#app_\"' $'$\"\\#app_{!hash}\"'\n                    ? js_text |> sm'.ends_with \"main()\" |> not ?>\n                        $'$\"{!js_text}\\nmain()\"'\n                        |> file_system.write_all_text_exists js_path\n\n                    := exit_code, run_result =\n                        runtime.execution_options \\ x => { x ?|\n                            command =\n                                $'$\"bunx --bun esbuild --bundle --minify --loader:.wasm=file --outdir={!src_dir} \\\n                                    {!js_path}\"'\n                            environment_variables =\n                                ?= \"~/.bun/bin\" |> env.append_path ?|\n                                | Some path => am'.base ;[ \"PATH\", path ]\n                                | None => am'.base ;[]\n                            working_directory = package_dir |> optionm'.some'\n                        }\n                        |> runtime.execute_with_options\n\n                    ? exit_code <>. 0 ?>\n                        trace Critical\n                            \\ () => \"spiral.process_gleam / esbuild error\"\n                            \\ () => { exit_code run_result new_code_path }\n                        \"\"\n                    |:\n                        := html =\n                            $'$\"<\\!DOCTYPE html>\"'\n                            ++\\# $'$\"<html lang=\\\\\\\"en\\\\\\\">\"'\n                            ++\\# $'$\"  <head>\"'\n                            ++\\# $'$\"    <meta charset=\\\\\\\"UTF-8\\\\\\\" />\"'\n                            ++\\# $'$\"    <meta name=\\\\\\\"viewport\\\\\\\" content=\\\\\\\"width=device-width, \\\n                                initial-scale=1.0\\\\\\\" />\"'\n                            ++\\# $'$\"    <link\"'\n                            ++\\# $'$\"      data-trunk\"'\n                            ++\\# $'$\"      rel=\\\\\\\"inline\\\\\\\"\"'\n                            ++\\# $'$\"      href=\\\\\\\"../build/packages/lustre_ui/priv/static/lustre_ui.css\\\\\\\"\"'\n                            ++\\# $'$\"    />\"'\n                            ++\\# $'$\"    <link\"'\n                            ++\\# $'$\"      data-trunk\"'\n                            ++\\# $'$\"      rel=\\\\\\\"inline\\\\\\\"\"'\n                            ++\\# $'$\"      type=\\\\\\\"module\\\\\\\"\"'\n                            ++\\# $'$\"      href=\\\\\\\"main.js\\\\\\\"\"'\n                            ++\\# $'$\"    />\"'\n                            ++\\# $'$\"  </head>\"'\n                            ++\\# $'$\"  <body>\"'\n                            ++\\# $'$\"    <div id=\\\\\\\"app_{!hash}\\\\\\\"></div>\"'\n                            ++\\# $'$\"  </body>\"'\n                            ++\\# $'$\"</html>\"'\n\n                        := html_path = $'$\"{!src_dir}/index.html\"'\n                        html |> file_system.write_all_text_exists html_path\n\n                        \"\" |> file_system.write_all_text_exists $'$\"{!src_dir}/spiral_{!hash}.rs\"'\n\n                        := manifest =\n                            $'$\"[package]\"'\n                            ++\\# $'$\"name = \\\\\\\"spiral_{!hash}\\\\\\\"\"'\n                            ++\\# $'$\"\"'\n                            ++\\# $'$\"[workspace]\"'\n                            ++\\# $'$\"\"'\n                            ++\\# $'$\"[lib]\"'\n                            ++\\# $'$\"crate-type = [\\\\\\\"cdylib\\\\\\\", \\\\\\\"rlib\\\\\\\"]\"'\n                            ++\\# $'$\"path = \\\\\\\"spiral_{!hash}.rs\\\\\\\"\"'\n                            ++\\# $'$\"\"'\n                            ++\\# $'$\"[dependencies]\"'\n\n                        manifest |> file_system.write_all_text_exists $'$\"{!src_dir}/Cargo.toml\"'\n\n                        := exit_code, run_result =\n                            runtime.execution_options \\ x => { x ?|\n                                command = $'$\"trunk build --release --minify --dist={!src_dir} --public-url=./ \\\n                                    --no-sri\"'\n                                environment_variables =\n                                    am'.base ;[\n                                        \"TRUNK_TOOLS_WASM_BINDGEN\", \"0.2.93\"\n                                    ]\n                                working_directory = src_dir |> optionm'.some'\n                            }\n                            |> runtime.execute_with_options\n\n                        ? exit_code = 0\n                        ?> html_path |> file_system.read_all_text\n                        |:\n                            trace Critical\n                                \\ () => \"spiral.process_gleam / trunk error\"\n                                \\ () => { exit_code run_result new_code_path }\n                            \"\"\n\n            := run_result' = run_result |> sm'.to_std_string\n\n            := output =\n                try\n                    \\ () =>\n                        run_result\n                        |> sm'.split \"\\n\"\n                        |> am'.to_vec\n                        |> am'.vec_filter \\ x =>\n                            (x |> sm'.starts_with \"{compiling,\" |> not)\n                            && (x |> sm'.starts_with \"{compiled,\" |> not)\n                            && (x |> sm'.ends_with \".beam\\\"}\" |> not)\n                            && (x |> sm'.starts_with \"src\\\\main.gleam:\" |> not)\n                            && (x |> sm'.starts_with \"src\\\\main_real.gleam:\" |> not)\n                            && (x |> sm'.starts_with \"src/main.gleam:\" |> not)\n                            && (x |> sm'.starts_with \"src/main_real.gleam:\" |> not)\n                            && (x |> sm'.starts_with \"% \" |> not)\n                        |> am'.from_vec\n                        |> \\ x => x : array _\n                        |> seq.of_array\n                        |> sm'.concat \"\\n\"\n                        |> sm'.trim_start [ '\\n' ]\n                    \\ ex =>\n                        trace Critical\n                            \\ () => \"spiral.process_gleam / Exception\"\n                            \\ () => { ex run_result' new_code_path external_command }\n                        None\n                |> optionm'.box\n                |> optionm'.unwrap\n\n            {\n                extension = Some extension\n                code = Some new_code\n                code_path = Some new_code_path\n                output = Some output\n            }","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  := package_owns_code (src_dir : string) : bool =
      (src_dir |> sm'.ends_with "/src") || (src_dir |> sm'.ends_with "\\src")

  := process_gleam { gleam_path target deps } =
      := extension = "gleam"

      := new_code_path = gleam_path
      := new_code = new_code_path |> file_system.read_all_text

      := hash = #?{ extension new_code } |> crypto.hash_text

      := workspace_root_external = file_system.get_workspace_root_external ()
      := workspace_root =
          workspace_root_external |> resultm.box |> resultm.unwrap_or_else id |> file_system.standardize_path

      := src_dir =
          new_code_path
          |> file_system.directory_get_parent
          |> optionm'.default_value' ""
          |> file_system.standardize_path

      := owned = package_owns_code src_dir

      := package_dir =
          ? owned
          ?> src_dir </> ".." |> file_system.standardize_path
          |: src_dir </> "gleam_package" |> file_system.standardize_path

      \ () =>
          := ci = "CI" |> env.get_environment_variable
          ? ci <> "" && package_owns_code src_dir ?>
              package_dir
              |> file_system.directory_delete !+
      |> new_disposable
      |> \ x => x : _ ()
      |> use
      |> ignore

      := manifest_path = package_dir </> "gleam.toml"

      := deps =
          am'.base ;[
              "gleam_stdlib=\"0.57.0\""
              "gleam_time=\">=1.0.0 and <2.0.0\""
              "gleam_erlang=\">=0.34.0 and <1.0.0\""
              "envoy=\">=1.0.0 and <2.0.0\""
              "gary=\">=1.1.0 and <2.0.0\""
              "gtempo=\">=7.1.0 and <8.0.0\""
          ]
          |> am'.to_vec
          |> am'.vec_map sm'.to_std_string
          |> am'.vec_extend deps
          |> am'.vec_map \ dep =>
              := dep = dep |> sm'.from_std_string
              ? dep |> sm'.contains "="
              ?> dep
              |? dep |> sm'.ends_with "]"
              ?> dep |> sm'.replace "[" $'$"={{version=\'*\',features=["' |> \ x => $'$"{!x}}}"'
              |: $'$"{!dep}=\'*\'"'
          |> am'.from_vec
          |> \ x => x : array _
          |> seq.of_array'
          |> sm'.concat "\n"

      := target' = target |> reflection.union_to_string |> sm'.to_lower

      := manifest =
          := main =
              ? new_code_path |> sm'.contains "_real"
              ?> "main_real"
              |: "main"
          $'$"name = \\\"{!main}\\\""'
          ++\# $'$"target = \\\"{!target'}\\\""'
          ++\# $'$""'
          ++\# $'$"[dependencies]"'
          ++\# $'$"{!deps}"'

      manifest |> file_system.write_all_text_exists manifest_path

      ? owned |> not ?>
          := module_file = ? new_code_path |> sm'.contains "_real" ?> "main_real.gleam" |: "main.gleam"
          new_code |> file_system.write_all_text_exists (package_dir </> "src" </> module_file)

      := exit_code, run_result =
          0i32, ""

      ? exit_code <>. 0 ?>
          trace Critical
              \ () => "spiral.process_gleam / check error"
              \ () => { exit_code run_result new_code_path }
          { extension = Some extension; code = None; code_path = None; output = None }
      |:
          := command =
              ? target = Erlang
              ?> $'$"gleam run --no-print-progress \\\"{!new_code_path}\\\""' : string
              |: $'$"gleam build --no-print-progress"'
          := environment_variables =
              ;[
                  "TRACE_LEVEL", ""
                  "GLEAM_LOG", ""
                  "GLEAM_LOG_NOCOLOUR", ""
              ]
          ? target = Erlang ?>
              runtime.execution_options \ x => { x ?|
                  command = "gleam build --no-print-progress"
                  environment_variables = am'.base environment_variables
                  working_directory = package_dir |> optionm'.some'
                  stderr = !-
              }
              |> runtime.execute_with_options
              |> ignore
          := exit_code, run_result =
              runtime.execution_options \ x => { x ?|
                  command
                  environment_variables = am'.base environment_variables
                  working_directory = package_dir |> optionm'.some'
                  stderr = !-
              }
              |> runtime.execute_with_options

          := external_command =
              := vars =
                  environment_variables
                  |> arraym.map \ k, v => $'$"$env:{!k}=\'\'{!v}\'\'"' : string
                  |> \ x => x : array _
                  |> seq.of_array
                  |> sm'.concat ";"
              $'$"pwsh -c \'{!vars}; {!command}\'"' : string
          ? exit_code <>. 0 ?>
              trace Critical
                  \ () => "spiral.process_gleam / error"
                  \ () => { exit_code run_result new_code_path external_command }
              failwith ("spiral.process_gleam / gleam run failed\n" ++# run_result)
          |:
              := run_result =
                  ? target = Erlang
                  ?> run_result
                  |:
                      := js_path = $'$"{!package_dir}/build/dev/javascript/main/main.mjs"'
                      := js_text = js_path |> file_system.read_all_text
                      := js_text = js_text |> sm'.replace $'$"\#app_"' $'$"\#app_{!hash}"'
                      ? js_text |> sm'.ends_with "main()" |> not ?>
                          $'$"{!js_text}\nmain()"'
                          |> file_system.write_all_text_exists js_path

                      := exit_code, run_result =
                          runtime.execution_options \ x => { x ?|
                              command =
                                  $'$"bunx --bun esbuild --bundle --minify --loader:.wasm=file --outdir={!src_dir} \
                                      {!js_path}"'
                              environment_variables =
                                  ?= "~/.bun/bin" |> env.append_path ?|
                                  | Some path => am'.base ;[ "PATH", path ]
                                  | None => am'.base ;[]
                              working_directory = package_dir |> optionm'.some'
                          }
                          |> runtime.execute_with_options

                      ? exit_code <>. 0 ?>
                          trace Critical
                              \ () => "spiral.process_gleam / esbuild error"
                              \ () => { exit_code run_result new_code_path }
                          ""
                      |:
                          := html =
                              $'$"<\!DOCTYPE html>"'
                              ++\# $'$"<html lang=\\\"en\\\">"'
                              ++\# $'$"  <head>"'
                              ++\# $'$"    <meta charset=\\\"UTF-8\\\" />"'
                              ++\# $'$"    <meta name=\\\"viewport\\\" content=\\\"width=device-width, \
                                  initial-scale=1.0\\\" />"'
                              ++\# $'$"    <link"'
                              ++\# $'$"      data-trunk"'
                              ++\# $'$"      rel=\\\"inline\\\""'
                              ++\# $'$"      href=\\\"../build/packages/lustre_ui/priv/static/lustre_ui.css\\\""'
                              ++\# $'$"    />"'
                              ++\# $'$"    <link"'
                              ++\# $'$"      data-trunk"'
                              ++\# $'$"      rel=\\\"inline\\\""'
                              ++\# $'$"      type=\\\"module\\\""'
                              ++\# $'$"      href=\\\"main.js\\\""'
                              ++\# $'$"    />"'
                              ++\# $'$"  </head>"'
                              ++\# $'$"  <body>"'
                              ++\# $'$"    <div id=\\\"app_{!hash}\\\"></div>"'
                              ++\# $'$"  </body>"'
                              ++\# $'$"</html>"'

                          := html_path = $'$"{!src_dir}/index.html"'
                          html |> file_system.write_all_text_exists html_path

                          "" |> file_system.write_all_text_exists $'$"{!src_dir}/spiral_{!hash}.rs"'

                          := manifest =
                              $'$"[package]"'
                              ++\# $'$"name = \\\"spiral_{!hash}\\\""'
                              ++\# $'$""'
                              ++\# $'$"[workspace]"'
                              ++\# $'$""'
                              ++\# $'$"[lib]"'
                              ++\# $'$"crate-type = [\\\"cdylib\\\", \\\"rlib\\\"]"'
                              ++\# $'$"path = \\\"spiral_{!hash}.rs\\\""'
                              ++\# $'$""'
                              ++\# $'$"[dependencies]"'

                          manifest |> file_system.write_all_text_exists $'$"{!src_dir}/Cargo.toml"'

                          := exit_code, run_result =
                              runtime.execution_options \ x => { x ?|
                                  command = $'$"trunk build --release --minify --dist={!src_dir} --public-url=./ \
                                      --no-sri"'
                                  environment_variables =
                                      am'.base ;[
                                          "TRUNK_TOOLS_WASM_BINDGEN", "0.2.93"
                                      ]
                                  working_directory = src_dir |> optionm'.some'
                              }
                              |> runtime.execute_with_options

                          ? exit_code = 0
                          ?> html_path |> file_system.read_all_text
                          |:
                              trace Critical
                                  \ () => "spiral.process_gleam / trunk error"
                                  \ () => { exit_code run_result new_code_path }
                              ""

              := run_result' = run_result |> sm'.to_std_string

              := output =
                  try
                      \ () =>
                          run_result
                          |> sm'.split "\n"
                          |> am'.to_vec
                          |> am'.vec_filter \ x =>
                              (x |> sm'.starts_with "{compiling," |> not)
                              && (x |> sm'.starts_with "{compiled," |> not)
                              && (x |> sm'.ends_with ".beam\"}" |> not)
                              && (x |> sm'.starts_with "src\\main.gleam:" |> not)
                              && (x |> sm'.starts_with "src\\main_real.gleam:" |> not)
                              && (x |> sm'.starts_with "src/main.gleam:" |> not)
                              && (x |> sm'.starts_with "src/main_real.gleam:" |> not)
                              && (x |> sm'.starts_with "% " |> not)
                          |> am'.from_vec
                          |> \ x => x : array _
                          |> seq.of_array
                          |> sm'.concat "\n"
                          |> sm'.trim_start [ '\n' ]
                      \ ex =>
                          trace Critical
                              \ () => "spiral.process_gleam / Exception"
                              \ () => { ex run_result' new_code_path external_command }
                          None
                  |> optionm'.box
                  |> optionm'.unwrap

              {
                  extension = Some extension
                  code = Some new_code
                  code_path = Some new_code_path
                  output = Some output
              }
  """,
  timeout: 300_000
)
```

