///- --package .
test combat static =
    open testing

inl unit_scale () : i32 = 4096

inl sub_key (key : rng.roll_key) (index : u32) : rng.roll_key =
    {key with purpose = key.purpose * 256u32 + index}

inl uniform_unit (key : rng.roll_key) (index : u32) : i32 =
    conv (rng.draw (sub_key key index) % 4096u32)

inl irwin_hall_twelve (key : rng.roll_key) (attempt : u32) : i32 =
    let rec sum (i : u32) (total : i32) : i32 =
        if i >= 12u32 then total else sum (i + 1u32) (total + uniform_unit key (attempt * 12u32 + i))
    sum 0u32 0i32

inl truncated_normal_unit (key : rng.roll_key) : i32 =
    let rec attempt (n : u32) : i32 =
        inl v = 2048i32 + (irwin_hall_twelve key n - 24576i32) / 4i32
        if v >= 0i32 && v <= unit_scale () then v
        elif n >= 7u32 then (if v < 0i32 then 0i32 else unit_scale ())
        else attempt (n + 1u32)
    attempt 0u32

inl unit_draw_stats (seed : u32) (count : i32) : i32 * i32 * i32 =
    let rec loop (i : i32) (total : i32) (low : i32) (high : i32) : i32 * i32 * i32 =
        if i >= count then total / count, low, high
        else
            inl v = truncated_normal_unit (rng.roll_key seed (conv i) 0u32 9u32)
            loop (i + 1i32) (total + v) (if v < low then v else low) (if v > high then v else high)
    loop 0i32 0i32 (unit_scale ()) 0i32

inl melee_roll (low : i32) (high : i32) (key : rng.roll_key) : i32 =
    low + (truncated_normal_unit key * (high - low) + 2048i32) / unit_scale ()

inl uniform_between (low : i32) (high : i32) (key : rng.roll_key) (index : u32) : i32 =
    conv (rng.roll_between (conv low) (conv high) (sub_key key index))

inl defense_block (defense : i32) (key : rng.roll_key) : i32 =
    uniform_between (defense / 2i32) defense key 200u32

inl armor_block (armor : i32) (key : rng.roll_key) : i32 =
    if armor > 3i32 then uniform_between (armor / 2i32) (armor - (armor % 2i32 + 1i32)) key 201u32
    elif armor > 0i32 then 1i32
    else 0i32

inl blocked_hit (raw : i32) (defense : i32) (armor : i32) (has_block_charge : bool) (key : rng.roll_key) : i32 =
    inl after_defense = if has_block_charge then raw - defense_block defense key else raw
    if after_defense <= 0i32 then 0i32
    else
        inl after_armor = after_defense - armor_block armor key
        if after_armor <= 0i32 then 0i32 else after_armor

type gear = {armor : i32; defense : i32}

inl balanced_defense_percent () : i32 = 75i32
inl shield_scaling_per_mille () : i32 = 160i32

inl shielded_defense (shield_skill : i32) (shield_defense : i32) : i32 =
    (shield_skill * 25i32 + 223i32) * shield_defense * balanced_defense_percent () * shield_scaling_per_mille () / 10000000i32

inl knight_sample_gear () : gear =
    inl brass_helmet = 3i32
    inl brass_armor = 8i32
    inl brass_legs = 5i32
    inl leather_boots = 1i32
    inl dwarven_shield = 26i32
    {armor = brass_helmet + brass_armor + brass_legs + leather_boots; defense = shielded_defense 11i32 dwarven_shield}

inl max_block_charges () : i32 = 2i32
inl block_charge_ms () : i32 = 1000i32

inl creature_hit (melee_max : i32) (defender : gear) (shielded : bool) (key : rng.roll_key) : i32 =
    blocked_hit (melee_roll 0i32 melee_max key) defender.defense defender.armor shielded key

inl melee_hit (mode : damage.fight_mode) (level : i32) (attack_value : i32) (attack_skill : i32) (defense : i32) (armor : i32) (key : rng.roll_key) : i32 =
    inl high = damage.max_melee_damage mode attack_value attack_skill level
    inl low = if attack_value > 0i32 then level / 5i32 else 0i32
    blocked_hit (melee_roll low high key) defense armor true key

inl swing_stats (mode : damage.fight_mode) (level : i32) (attack_value : i32) (attack_skill : i32) (defense : i32) (armor : i32) (seed : u32) (swings : i32) : i32 * i32 =
    let rec loop (i : i32) (landed : i32) (total : i32) : i32 * i32 =
        if i >= swings then landed, total
        else
            inl hit = melee_hit mode level attack_value attack_skill defense armor (rng.roll_key seed (conv i) 1u32 7u32)
            loop (i + 1i32) (if hit > 0i32 then landed + 1i32 else landed) (total + hit)
    loop 0i32 0i32 0i32

inl capped_hit_stats (mode : damage.fight_mode) (level : i32) (attack_value : i32) (attack_skill : i32) (defense : i32) (armor : i32) (max_health : i32) (seed : u32) (swings : i32) : i32 * i32 =
    let rec loop (i : i32) (health : i32) (landed : i32) (total : i32) : i32 * i32 =
        if i >= swings then landed, total
        else
            inl hit = melee_hit mode level attack_value attack_skill defense armor (rng.roll_key seed (conv i) 1u32 7u32)
            inl taken = if hit > health then health else hit
            inl left = health - taken
            loop (i + 1i32) (if left <= 0i32 then max_health else left) (if taken > 0i32 then landed + 1i32 else landed) (total + taken)
    loop 0i32 max_health 0i32 0i32

///> c
test armor_block_follows_canary_bounds =
    inl ~armor = 10i32
    inl key = rng.roll_key 1u32 2u32 3u32 4u32
    inl block = armor_block armor key
    (block >= 5i32 && block <= 9i32) |> _assert_eq true
    armor_block (armor - 7i32) key |> _assert_eq 1i32
    armor_block (armor - 10i32) key |> _assert_eq 0i32

///> c
test truncated_normal_stays_in_unit_range_with_mean_near_half =
    inl ~seed = 11u32
    match unit_draw_stats seed 4000i32 with
    | mean, low, high =>
        mean |> _assert_eq 2055i32
        low |> _assert_eq 0i32
        high |> _assert_eq 4093i32

///> c
test level_8_knight_rarely_hurts_a_troll =
    inl ~seed = 5u32
    match swing_stats (open damage in Offensive) 8i32 21i32 11i32 10i32 10i32 seed 2000i32 with
    | landed, total =>
        landed |> _assert_eq 435i32
        total |> _assert_eq 1393i32

///> c
test axe_skill_30_hurts_a_troll_often =
    inl ~seed = 5u32
    match swing_stats (open damage in Offensive) 8i32 21i32 30i32 10i32 10i32 seed 2000i32 with
    | landed, total =>
        landed |> _assert_eq 1680i32
        total |> _assert_eq 28222i32

///> c
test balanced_axe_skill_30_matches_live_troll_hits =
    inl ~seed = 5u32
    match swing_stats (open damage in Balanced) 8i32 21i32 30i32 10i32 10i32 seed 2000i32 with
    | landed, total =>
        landed |> _assert_eq 1435i32
        total |> _assert_eq 15398i32

///> wgsl
test balanced_swing_stats_on_gpu =
    inl ~seed = 5u32
    match swing_stats (open damage in Balanced) 8i32 21i32 30i32 10i32 10i32 seed 2000i32 with
    | landed, total => if landed = 1435i32 && total = 15398i32 then 0i32 else 1i32

///> c
test hits_capped_at_remaining_health_match_live_skeleton_log =
    inl ~seed = 5u32
    match capped_hit_stats (open damage in Balanced) 8i32 21i32 30i32 10i32 10i32 50i32 seed 2000i32 with
    | landed, total =>
        landed |> _assert_eq 1435i32
        total |> _assert_eq 13451i32
