test creatures static =
    open testing

union arena_creature =
    | CaveRat
    | Troll
    | Wolf
    | Skeleton
    | Goblin
    | Cyclops

type creature_stats = {experience : i32; max_health : i32; speed : i32; target_distance : i32; melee_max : i32; combat_spells : i32; armor : i32; defense : i32; run_health : i32; step_ms : i32}

type gold_drop = {chance_per_100000 : i32; max_count : i32}

inl gold_drop_of (kind : arena_creature) : gold_drop =
    match kind with
    | Troll => {chance_per_100000 = 65300; max_count = 12}
    | Goblin => {chance_per_100000 = 50320; max_count = 9}
    | Skeleton => {chance_per_100000 = 43900; max_count = 10}
    | Cyclops => {chance_per_100000 = 82000; max_count = 47}
    | _ => {chance_per_100000 = 0; max_count = 0}

inl stats_of (kind : arena_creature) : creature_stats =
    match kind with
    | CaveRat => {experience = 10; max_health = 30; speed = 75; target_distance = 1; melee_max = 10; combat_spells = 0; armor = 5; defense = 5; run_health = 3; step_ms = 800}
    | Troll => {experience = 20; max_health = 50; speed = 63; target_distance = 1; melee_max = 15; combat_spells = 0; armor = 10; defense = 10; run_health = 15; step_ms = 950}
    | Wolf => {experience = 18; max_health = 25; speed = 82; target_distance = 1; melee_max = 20; combat_spells = 0; armor = 5; defense = 5; run_health = 8; step_ms = 750}
    | Skeleton => {experience = 35; max_health = 50; speed = 77; target_distance = 1; melee_max = 20; combat_spells = 1; armor = 10; defense = 10; run_health = 0; step_ms = 800}
    | Goblin => {experience = 25; max_health = 50; speed = 60; target_distance = 1; melee_max = 10; combat_spells = 1; armor = 10; defense = 10; run_health = 15; step_ms = 1000}
    | Cyclops => {experience = 150; max_health = 260; speed = 95; target_distance = 1; melee_max = 105; combat_spells = 0; armor = 20; defense = 20; run_health = 0; step_ms = 650}

inl server_beat_ms () : i32 = 50
inl grass_ground_speed () : i32 = 150

inl canary_step_speed_exact_up_to () : i32 = 408

inl canary_step_speed (speed : i32) : i32 =
    if speed < 8 then 1
    elif speed <= 35 then (12289 * speed - 81935) / 4096
    elif speed <= 47 then (11606 * speed - 57372) / 4096
    elif speed <= 61 then (11118 * speed - 33954) / 4096
    elif speed <= 80 then (10582 * speed - 732) / 4096
    elif speed <= 96 then (10013 * speed + 45006) / 4096
    elif speed <= 114 then (9558 * speed + 88680) / 4096
    elif speed <= 122 then (9217 * speed + 127881) / 4096
    elif speed <= 137 then (9012 * speed + 153088) / 4096
    elif speed <= 156 then (8648 * speed + 202848) / 4096
    elif speed <= 196 then (8056 * speed + 295768) / 4096
    elif speed <= 214 then (7510 * speed + 400590) / 4096
    elif speed <= 232 then (7282 * speed + 449600) / 4096
    elif speed <= 255 then (6964 * speed + 523272) / 4096
    elif speed <= 281 then (6617 * speed + 612091) / 4096
    elif speed <= 301 then (6372 * speed + 680716) / 4096
    elif speed <= 337 then (6063 * speed + 774007) / 4096
    elif speed <= 362 then (5735 * speed + 883711) / 4096
    elif speed <= 388 then (5559 * speed + 947585) / 4096
    else (5325 * speed + 1037437) / 4096

inl canary_step_speed_in_double (speed : i32) : i32 =
    inl rounded : i32 = conv (857.36 * log (conv speed + 261.29 : f64) - 4795.01 + 0.5)
    if rounded < 1 then 1 else rounded

inl step_ms_from_canary_formula (speed : i32) (ground_speed : i32) : i32 =
    inl duration = 1000 * ground_speed / canary_step_speed speed
    (duration + server_beat_ms () - 1) / server_beat_ms () * server_beat_ms ()

inl player_step_ms (level : i32) : i32 = step_ms_from_canary_formula (110 + level - 1) (grass_ground_speed ())

inl experience_per_health (kind : arena_creature) : i32 =
    inl s = stats_of kind
    s.experience * 1000 / s.max_health

///> c
test stats_match_canary_data_canary_lua_2026_10_12 =
    inl ~marker = 0i32
    (stats_of Troll).max_health + marker |> _assert_eq 50i32
    (stats_of Troll).melee_max + marker |> _assert_eq 15i32
    (stats_of CaveRat).experience + marker |> _assert_eq 10i32
    (stats_of Cyclops).max_health + marker |> _assert_eq 260i32
    (stats_of Wolf).speed + marker |> _assert_eq 82i32

///> c
test every_arena_creature_fights_in_melee_range =
    inl ~marker = 0i32
    (stats_of CaveRat).target_distance + marker |> _assert_eq 1i32
    (stats_of Troll).target_distance + marker |> _assert_eq 1i32
    (stats_of Wolf).target_distance + marker |> _assert_eq 1i32
    (stats_of Skeleton).target_distance + marker |> _assert_eq 1i32
    (stats_of Goblin).target_distance + marker |> _assert_eq 1i32
    (stats_of Cyclops).target_distance + marker |> _assert_eq 1i32

///> c
test experience_per_health_ranks_skeleton_above_troll =
    inl ~marker = 0i32
    experience_per_health Skeleton + marker |> _assert_eq 700i32
    experience_per_health Troll + marker |> _assert_eq 400i32

///> c
test armor_defense_and_flee_match_data_canary_2026_10_13 =
    inl ~marker = 0i32
    (stats_of Troll).armor + marker |> _assert_eq 10i32
    (stats_of Cyclops).defense + marker |> _assert_eq 20i32
    (stats_of Troll).run_health + marker |> _assert_eq 15i32
    (stats_of Skeleton).run_health + marker |> _assert_eq 0i32
    (stats_of Wolf).armor + marker |> _assert_eq 5i32

///> c
test step_ms_matches_canary_step_formula_on_grass =
    inl check kind = (stats_of kind).step_ms = step_ms_from_canary_formula (stats_of kind).speed (grass_ground_speed ())
    (check CaveRat && check Troll && check Wolf && check Skeleton && check Goblin && check Cyclops) |> _assert_eq true
    inl ~level = 8i32
    player_step_ms level |> _assert_eq 550i32
    player_step_ms (level + 22) |> _assert_eq 450i32

///> wgsl
test stats_on_gpu =
    inl ~marker = 0i32
    if (stats_of Troll).max_health + marker = 50i32 && experience_per_health Skeleton + marker = 700i32 then 0i32 else 1i32

///> c
test integer_step_speed_equals_canary_double_formula_for_every_speed_up_to_its_exact_limit =
    let rec mismatches (speed : i32) (count : i32) : i32 =
        if speed > canary_step_speed_exact_up_to () then count
        elif canary_step_speed speed = canary_step_speed_in_double speed then mismatches (speed + 1) count
        else mismatches (speed + 1) (count + 1)
    inl ~first = 1i32
    mismatches first 0 |> _assert_eq 0i32

///> wgsl
test integer_step_speed_on_gpu =
    inl ~cyclops = 95i32
    if canary_step_speed cyclops = 243i32 && step_ms_from_canary_formula cyclops (grass_ground_speed ()) = 650i32 then 0i32 else 1i32
