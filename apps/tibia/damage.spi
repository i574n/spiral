test damage static =
    open testing

inl level_bonus (level : i32) : i32 =
    level / 5

union fight_mode =
    | Offensive
    | Balanced
    | Defensive

inl attack_factor_percent (mode : fight_mode) : i32 =
    match mode with
    | Offensive => 100
    | Balanced => 75
    | Defensive => 50

inl max_melee_damage (mode : fight_mode) (attack_value : i32) (attack_skill : i32) (level : i32) : i32 =
    (85 * attack_factor_percent mode * attack_value * attack_skill * 2 + 100000) / 200000 + level_bonus level

inl max_melee_damage_offensive (attack_value : i32) (attack_skill : i32) (level : i32) : i32 =
    max_melee_damage Offensive attack_value attack_skill level

///> c
test max_melee_matches_canary_double_formula =
    inl ~value = 50i32
    max_melee_damage_offensive value 80 100 |> _assert_eq 360i32
    max_melee_damage_offensive (value - 8) 65 8 |> _assert_eq 233i32
    max_melee_damage_offensive (value - 49) 1 1 |> _assert_eq 0i32
    max_melee_damage_offensive (value + 50) 120 500 |> _assert_eq 1120i32
    max_melee_damage_offensive (value - 15) 50 30 |> _assert_eq 155i32
    max_melee_damage_offensive (value - 30) 10 9 |> _assert_eq 18i32
    max_melee_damage_offensive (value - 2) 99 250 |> _assert_eq 454i32
    max_melee_damage_offensive (value + 150) 130 1000 |> _assert_eq 2410i32

///> c
test fight_mode_scales_max_melee_like_canary_attack_factor =
    inl ~skill = 30i32
    max_melee_damage Offensive 21 skill 8 |> _assert_eq 55i32
    max_melee_damage Balanced 21 skill 8 |> _assert_eq 41i32
    max_melee_damage Defensive 21 skill 8 |> _assert_eq 28i32
    max_melee_damage Balanced 21 (skill - 19) 8 |> _assert_eq 16i32

///> c
test level_bonus_truncates =
    inl ~level = 9i32
    level_bonus level |> _assert_eq 1i32
    level_bonus (level + 1) |> _assert_eq 2i32

///> wgsl
test max_melee_matches_canary_on_gpu =
    inl ~value = 50i32
    if max_melee_damage_offensive value 80 100 = 360i32 && max_melee_damage_offensive (value + 150) 130 1000 = 2410i32 then 0i32 else 1i32
