///- --package .
test network static =
    open testing

inl one () : i32 = 256
inl input_count () : i32 = 8
inl hidden_count () : i32 = 6
inl output_count () : i32 = 3
inl attacker_unit () : i32 = 85
inl weight_count () : i32 = input_count () * hidden_count () + hidden_count () * output_count ()

nominal weights = a i32 i32
nominal inputs = a i32 i32

union feature =
    | HealthFraction
    | Attackers
    | TargetHealth
    | TargetDistance
    | HealReady
    | StrikeReady
    | TargetFleeing
    | Bias

union output =
    | HealOutput
    | EngageOutput
    | RetreatOutput

nominal hidden = i32

inl feature_slot (f : feature) : i32 =
    match f with
    | HealthFraction => 0
    | Attackers => 1
    | TargetHealth => 2
    | TargetDistance => 3
    | HealReady => 4
    | StrikeReady => 5
    | TargetFleeing => 6
    | Bias => 7

inl output_slot (o : output) : i32 =
    match o with
    | HealOutput => 0
    | EngageOutput => 1
    | RetreatOutput => 2

inl input_weight_slot (hidden h) (f : feature) : i32 = h * input_count () + feature_slot f

inl output_weight_slot (o : output) (hidden h) : i32 = input_count () * hidden_count () + output_slot o * hidden_count () + h

type decision = {heal : bool; engage : bool; retreat : bool}

inl filled (count : i32) (value : i32) : a i32 i32 =
    inl x : a i32 i32 = create count
    let rec fill (i : i32) : () =
        if i < count then
            set x i value
            fill (i + 1)
    fill 0
    x

inl zero_weights () : weights = weights (filled (weight_count ()) 0)

inl weight (weights w) (i : i32) : i32 = index w i

inl inputs_of (health_fraction : i32) (attackers : i32) (target_health : i32) (target_distance : i32) (heal_ready : bool) (strike_ready : bool) (target_fleeing : bool) : inputs =
    inl x = filled (input_count ()) 0
    inl flag b = if b then one () else 0
    inl put f value = set x (feature_slot f) value
    put HealthFraction health_fraction
    put Attackers (attackers * attacker_unit ())
    put TargetHealth target_health
    put TargetDistance ((if target_distance > 7 then 7 else target_distance) * 32)
    put HealReady (flag heal_ready)
    put StrikeReady (flag strike_ready)
    put TargetFleeing (flag target_fleeing)
    put Bias (one ())
    inputs x

inl hidden_unit (w : weights) (inputs x) (j : i32) : i32 =
    let rec sum (i : i32) (total : i32) : i32 =
        if i >= input_count () then total else sum (i + 1) (total + weight w (j * input_count () + i) * index x i)
    inl h = sum 0 0 / one ()
    if h > 0 then h else 0

inl hidden_layer (w : weights) (x : inputs) : a i32 i32 =
    inl hidden = filled (hidden_count ()) 0
    let rec activate (j : i32) : () =
        if j < hidden_count () then
            set hidden j (hidden_unit w x j)
            activate (j + 1)
    activate 0
    hidden

inl output_unit (w : weights) (hidden : a i32 i32) (k : i32) : i32 =
    inl offset = input_count () * hidden_count ()
    let rec sum (j : i32) (total : i32) : i32 =
        if j >= hidden_count () then total else sum (j + 1) (total + weight w (offset + k * hidden_count () + j) * index hidden j)
    sum 0 0 / one ()

inl decide (w : weights) (x : inputs) : decision =
    inl hidden = hidden_layer w x
    inl heal = output_unit w hidden 0
    inl engage = output_unit w hidden 1
    inl retreat = output_unit w hidden 2
    {heal = heal > 0; engage = engage > 0 && engage >= retreat; retreat = retreat > 0 && retreat > engage}

inl with_weight (i : i32) (value : i32) (weights w) : weights =
    set w i value
    weights w

inl with_input_weight (h : hidden) (f : feature) (value : i32) (w : weights) : weights = with_weight (input_weight_slot h f) value w

inl with_output_weight (o : output) (h : hidden) (value : i32) (w : weights) : weights = with_weight (output_weight_slot o h) value w

inl fraction_below (heal_below : i32) (max_health : i32) : i32 = (heal_below - 1) * one () / max_health + 1

inl threshold_healer (heal_below_fraction : i32) : weights =
    zero_weights ()
    |> with_input_weight (hidden 0) HealthFraction (0 - one ())
    |> with_input_weight (hidden 0) Bias heal_below_fraction
    |> with_input_weight (hidden 1) Bias (one ())
    |> with_output_weight HealOutput (hidden 0) (one ())
    |> with_output_weight EngageOutput (hidden 1) (one ())

inl with_kiting (min_attackers : i32) (w : weights) : weights =
    w
    |> with_input_weight (hidden 2) Attackers (one ())
    |> with_input_weight (hidden 2) StrikeReady (0 - one ())
    |> with_input_weight (hidden 2) Bias (0 - (min_attackers - 1) * attacker_unit ())
    |> with_output_weight RetreatOutput (hidden 2) (4 * one ())

inl clamp_weight (x : i32) : i32 = if x < -2048 then -2048 elif x > 2048 then 2048 else x

inl mutate (seed : u32) (generation : i32) (child : i32) (spread : i32) (w : weights) : weights =
    inl next = filled (weight_count ()) 0
    let rec copy (i : i32) : () =
        if i < weight_count () then
            inl draw : i32 = conv (rng.roll_between 0 (conv (2 * spread)) (rng.roll_key seed (conv generation) (conv child) (conv (1000 + i))))
            set next i (clamp_weight (weight w i + draw - spread))
            copy (i + 1)
    copy 0
    weights next

inl evolve (fitness : weights -> i32) (start : weights) (seed : u32) (generations : i32) (offspring : i32) (spread : i32) : weights =
    let rec generation (index : i32) (parent : weights) (parent_score : i32) (width : i32) : weights =
        if index >= generations then parent
        else
            let rec children (child : i32) (best : weights) (best_score : i32) : weights * i32 =
                if child >= offspring then best, best_score
                else
                    inl candidate = mutate seed index child width parent
                    inl score = fitness candidate
                    if score > best_score then children (child + 1) candidate score else children (child + 1) best best_score
            match children 0 parent parent_score with
            | best, best_score => generation (index + 1) best best_score (if width > 4 then width * 4 / 5 else 4)
    generation 0 start (fitness start) spread

///> c
test a_zero_network_holds =
    inl ~health = 128i32
    inl d = decide (zero_weights ()) (inputs_of health 1 200 1 true true false)
    d.heal |> _assert_eq false
    d.engage |> _assert_eq false
    d.retreat |> _assert_eq false

///> c
test a_hand_wired_network_heals_when_low =
    inl ~health = 64i32
    inl w = zero_weights () |> with_input_weight (hidden 0) HealthFraction (-256) |> with_input_weight (hidden 0) Bias 128 |> with_output_weight HealOutput (hidden 0) 256
    (decide w (inputs_of health 0 0 0 true true false)).heal |> _assert_eq true
    (decide w (inputs_of (health + 100) 0 0 0 true true false)).heal |> _assert_eq false

///> c
test a_threshold_healer_heals_below_and_engages_above =
    inl ~health = 99i32
    inl w = threshold_healer 100
    (decide w (inputs_of health 0 0 1 true true false)).heal |> _assert_eq true
    (decide w (inputs_of (health + 1) 0 0 1 true true false)).heal |> _assert_eq false
    (decide w (inputs_of (health + 1) 0 0 1 true true false)).engage |> _assert_eq true
    (decide w (inputs_of (health + 1) 2 0 1 true true false)).retreat |> _assert_eq false

///> c
test kiting_retreats_only_while_the_strike_recovers =
    inl ~health = 400i32
    inl w = threshold_healer 100 |> with_kiting 2
    (decide w (inputs_of health 2 0 1 true false false)).retreat |> _assert_eq true
    (decide w (inputs_of health 2 0 1 true true false)).retreat |> _assert_eq false
    (decide w (inputs_of health 1 0 1 true false false)).retreat |> _assert_eq false
    (decide w (inputs_of health 2 0 1 true true false)).engage |> _assert_eq true

///> c
test an_output_is_not_a_feature fails "Unification failure" =
    zero_weights () |> with_input_weight (hidden 0) HealOutput 1

///> c
test inputs_are_not_weights fails "Unification failure" =
    decide (inputs_of 1 0 0 0 true true false) (inputs_of 1 0 0 0 true true false)

///> c
test evolution_learns_to_heal_below_a_quarter =
    inl ~seed = 5u32
    inl score (w : weights) : i32 =
        let rec loop (h : i32) (total : i32) : i32 =
            if h > 256 then total
            else
                inl wanted = h < 64
                inl got = (decide w (inputs_of h 0 0 0 true true false)).heal
                loop (h + 16) (if wanted = got then total + 1 else total)
        loop 0 0
    inl best = evolve score (zero_weights ()) seed 30 12 256
    score best |> _assert_eq 17i32

///> wgsl
test network_decides_on_gpu =
    inl ~health = 64i32
    inl w = zero_weights () |> with_input_weight (hidden 0) HealthFraction (-256) |> with_input_weight (hidden 0) Bias 128 |> with_output_weight HealOutput (hidden 0) 256
    if (decide w (inputs_of health 0 0 0 true true false)).heal && (decide w (inputs_of (health + 100) 0 0 0 true true false)).heal = false then 0i32 else 1i32
