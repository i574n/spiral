test on_the_hunting_ground_walking_pays_and_the_evolved_shuttle_edges_the_hand_route =
    open hunting_pack
    inl camp = arena_hunt ()
    inl ~tuned = cavebot_heal_tuned_on Experience camp (training_block ())
    inl cavebot = cavebot_with_heal tuned
    inl judged (t : tactic) : i32 = quantity.value_of (judged_on Experience camp t (held_out_block ()))
    (tuned, judged cavebot, judged (cavebot |> patrolling (plaza_and_fields_route ())), judged (cavebot |> patrolling (spawn_side_loop_route ())), judged (cavebot |> sweeping_spawns), judged (cavebot |> patrolling (central_shuttle_route ())))
    |> _assert_eq (100i32, 89020i32, 109700i32, 112470i32, 119760i32, 118810i32)

///> c
test the_random_control_stays_far_below_every_rule =
    open hunting_pack
    inl camp = arena_hunt ()
    inl ~marker = 0i32
    inl l = ledger_on camp (random_control ()) (held_out_block ())
    inl spot = uniform_camp (open creatures in Cyclops) |> on_layout (open terrain in ArenaSpot)
    inl clears = clears_judged_on spot (random_control ()) (held_out_block ())
    (quantity.value_of (judged_on Experience camp (random_control ()) (held_out_block ())) + marker, l.hunt_kills, l.hunt_deaths, quantity.value_of l.hunt_profit, clears.clear_potions, clears.clear_deaths, clears.clear_ms)
    |> _assert_eq (47610i32, 905i32, 0i32, -1146982i32, 7132i32, 0i32, 9247700i32)

///> c
test on_the_cyclops_hunting_ground_sweeping_leads_and_stepping_back_buys_cost =
    open hunting_pack
    inl camp = cyclops_hunting_ground ()
    inl ~standing_heal = cavebot_heal_tuned_on Experience camp (training_block ())
    inl sweeping_heal = shaped_cavebot_heal_tuned_on Experience sweeping_spawns camp (training_block ())
    inl judged (t : tactic) : i32 * i32 * i32 =
        inl l = ledger_on camp t (held_out_block ())
        quantity.value_of (judged_on Experience camp t (held_out_block ())), l.hunt_deaths, quantity.value_of l.hunt_profit
    inl retreating = tactic_with_order (open policy in ReachFirst) {first = 154; second = 26; third = 2}
    (standing_heal, sweeping_heal, judged (cavebot_with_heal standing_heal), judged (cavebot_with_heal sweeping_heal |> sweeping_spawns), judged (cavebot_with_heal standing_heal |> patrolling (central_shuttle_route ())), judged retreating, judged (retreating |> sweeping_spawns))
    |> _assert_eq (110i32, 190i32, (121050i32, 0i32, -184112i32), (138900i32, 0i32, -254055i32), (103600i32, 7i32, -349233i32), (100950i32, 0i32, -107900i32), (127200i32, 0i32, -150159i32))
///> c
test the_live_wake_delay_brings_the_arena_clears_toward_the_live_potion_counts =
    open hunting_pack
    inl ~wake = live_wake_ms ()
    inl totals (camp : camp) (t : tactic) : i32 * i32 * i32 =
        let rec each (i : i32) (potions : i32) (ms : i32) (hits : i32) : i32 * i32 * i32 =
            if i >= (range_of (held_out_block ())).count then potions, ms, hits
            else
                inl elapsed, p = clear_run camp t ((range_of (held_out_block ())).first + conv i) 6000
                each (i + 1) (potions + p.hunter.potions) (ms + elapsed) (hits + p.hunter.hits_taken)
        each 0 0 0 0
    inl spot = uniform_camp (open creatures in Cyclops) |> on_layout (open terrain in ArenaSpot) |> waking_at wake
    inl mixed = cyclops_and_two_trolls_on_the_arena_spot () |> waking_at wake
    inl retreat = tactic_with_order (open policy in ReachFirst) {first = 154; second = 26; third = 2}
    (totals spot (cavebot_with_heal 160), totals spot retreat, totals mixed (cavebot_with_heal 160))
    |> _assert_eq ((1334i32, 8838000i32, 6417i32), (1201i32, 9037600i32, 5837i32), (36i32, 3708400i32, 946i32))

test after_a_step_the_swing_waits_for_the_next_think_so_retreating_costs_more_potions_and_rules_stay =
    open hunting_pack
    inl totals (camp : camp) (t : tactic) : i32 * i32 * i32 =
        let rec each (i : i32) (potions : i32) (ms : i32) (hits : i32) : i32 * i32 * i32 =
            if i >= (range_of (held_out_block ())).count then potions, ms, hits
            else
                inl elapsed, p = clear_run camp t ((range_of (held_out_block ())).first + conv i) 6000
                each (i + 1) (potions + p.hunter.potions) (ms + elapsed) (hits + p.hunter.hits_taken)
        each 0 0 0 0
    inl spot = uniform_camp (open creatures in Cyclops) |> on_layout (open terrain in ArenaSpot) |> waking_at (live_wake_ms ())
    inl live_retreat = tactic_with_order (open policy in ReachFirst) {first = 160; second = 0; third = 2}
    (totals spot live_retreat, totals (spot |> swinging_on_think) live_retreat, totals (spot |> swinging_on_think) (cavebot_with_heal 160))
    |> _assert_eq ((1178i32, 8952000i32, 5747i32), (1214i32, 9060800i32, 5856i32), (1336i32, 8876000i32, 6424i32))
