///- --package . --timeout 1800000
test pack_sim static =
    open testing

///> c
test cyclops_hits_on_the_knight_sample_match_the_live_measurement =
    inl ~seed = 3u32
    inl melee_max = (creatures.stats_of (open creatures in Cyclops)).melee_max
    inl gear = combat.knight_sample_gear ()
    let rec loop (i : i32) (landed : i32) (total : i32) (high : i32) : i32 * i32 * i32 =
        if i >= 2000 then landed, total, high
        else
            inl h = combat.creature_hit melee_max gear true (rng.roll_key seed (conv i) 0u32 (hunting_pack.purpose_creature_hit ()))
            loop (i + 1) (if h > 0 then landed + 1 else landed) (total + h) (if h > high then h else high)
    match loop 0 0 0 0 with
    | landed, total, high => (gear.armor, gear.defense, total * 100 / landed, high) |> _assert_eq (17i32, 15i32, 3497i32, 86i32)

///> rust
///> c
test golden_seed_7_troll_pack =
    open hunting_pack
    open creatures
    inl ~seed = 7u32
    inl outcome = simulate (uniform_camp Troll) (cavebot (open policy in ReachFirst)) seed (scenario_ticks ())
    outcome.kills |> _assert_eq 8i32
    outcome.escapes |> _assert_eq 17i32
    outcome.deaths |> _assert_eq 0i32

///> c
test current_first_targeting_finishes_fleeing_trolls_over_twenty_seeds =
    open hunting_pack
    open creatures
    inl ~first = 1u32
    match totals (uniform_camp Troll) (cavebot (open policy in ReachFirst)) first 20, totals (uniform_camp Troll) (cavebot (open policy in CurrentFirst)) first 20 with
    | (reach_kills, reach_escapes, reach_deaths), (current_kills, current_escapes, current_deaths) =>
        reach_kills |> _assert_eq 76i32
        reach_escapes |> _assert_eq 380i32
        reach_deaths |> _assert_eq 0i32
        current_kills |> _assert_eq 332i32
        current_escapes |> _assert_eq 11i32
        current_deaths |> _assert_eq 0i32
        (current_kills > reach_kills && current_escapes < reach_escapes) |> _assert_eq true

///> c
test mixed_camp_from_the_catalog_over_twenty_seeds =
    open catalog
    open hunting_pack
    inl ~first = 1u32
    inl camp = camp_of_entries (pack_entry (spawn_of TrollKind 1 2), pack_entry (spawn_of GoblinKind 1 2), pack_entry (spawn_of TrollKind 1 2))
    match totals camp (cavebot (open policy in CurrentFirst)) first 20 with
    | kills, escapes, deaths =>
        kills |> _assert_eq 331i32
        escapes |> _assert_eq 14i32
        deaths |> _assert_eq 0i32

///> c
test a_strike_needs_a_readiness_proof fails "Unification failure" =
    open hunting_pack
    open creatures
    player_strikes (uniform_camp Troll) 7 0 (quantity.ms 0) (start (uniform_camp Troll))

///> c
test a_pack_with_millisecond_health_is_rejected fails "Unification failure" =
    open hunting_pack
    open creatures
    inl p = start (uniform_camp Troll)
    respawn_player (uniform_camp Troll) {p with player_health = quantity.ms 150}

///> c
test cyclops_pack_healing_below_130_dies_while_170_and_above_tie_on_kills =
    open hunting_pack
    open creatures
    inl ~first = 1u32
    inl camp = uniform_camp Cyclops
    inl deaths heal = match totals camp (cavebot_with_heal heal) first 100 with | _, _, d => d
    inl at heal = score camp (cavebot_with_heal heal) first 100
    (deaths 90, deaths 170, at 90, at 130, at 170, at 210) |> _assert_eq (127i32, 0i32, -5399i32, -247i32, 950i32, 950i32)

///> c
test cyclops_pack_no_policy_dominates_the_tuned_cavebot_on_a_hundred_held_out_seeds =
    open hunting_pack
    open creatures
    inl ~search = 11u32
    inl camp = uniform_camp Cyclops
    inl heal = tuned_cavebot_heal_for Profit camp (training_first ()) (training_count ())
    inl floor = (ledger_of camp (cavebot_with_heal heal) (training_first ()) (training_count ())).hunt_kills
    inl objective = ProfitKeepingKills floor
    inl training t = worth objective camp t (training_first ()) (training_count ())
    inl held_out t =
        inl l = ledger_of camp t (held_out_first ()) (held_out_count ())
        l.hunt_kills, quantity.value_of l.hunt_profit
    inl g = evolve_tactic_from_for objective {first = heal; second = 0; third = 4} camp search (training_first ()) (training_count ()) 6 6
    inl kiting n = network_tactic (cavebot_network camp heal |> network.with_kiting n)
    inl k1, k2, k3 = training (kiting 1), training (kiting 2), training (kiting 3)
    inl chosen = if k1 >= k2 && k1 >= k3 then 1 elif k2 >= k3 then 2 else 3
    inl cold = network.evolve (fun w => training (network_tactic w)) (network.zero_weights ()) (search + 2u32) 6 6 256
    inl warm = network.evolve (fun w => training (network_tactic w)) (cavebot_network camp heal |> network.with_kiting chosen) (search + 4u32) 6 6 64
    inl tuned = heal, floor, chosen, g.first, g.second, g.third
    inl table = held_out (cavebot_with_heal heal), held_out (tactic_of g), held_out (kiting chosen), held_out (network_tactic cold), held_out (network_tactic warm)
    (tuned, table) |> _assert_eq ((160i32, 950i32, 2i32, 160i32, 0i32, 4i32), ((955i32, -454093i32), (955i32, -454093i32), (899i32, -165523i32), (955i32, -1480893i32), (955i32, -453493i32)))
    inl dominates (k, p) (bk, bp) = k >= bk && p >= bp && (k > bk || p > bp)
    inl cavebot, rules, kited, cold_learned, warm_learned = table
    (dominates kited cavebot, dominates rules cavebot, dominates cold_learned cavebot, dominates warm_learned cavebot) |> _assert_eq (false, false, false, true)

///> c
test cyclops_clear_predictions_for_the_live_arena =
    open hunting_pack
    open creatures
    inl ~first = 1u32
    inl camp = uniform_camp Cyclops
    let rec sum (t : tactic) (i : i32) (ms : i32) (potions : i32) (deaths : i32) : i32 * i32 * i32 =
        if i >= 20 then ms / 20, potions * 10 / 20, deaths
        else
            match clear_run camp t (first + conv i) 6000 with
            | elapsed, p => sum t (i + 1) (ms + elapsed) (potions + p.potions) (deaths + p.deaths)
    (sum (cavebot_with_heal 70) 0 0 0 0, sum (network_tactic (cavebot_network camp 70 |> network.with_kiting 3)) 0 0 0 0) |> _assert_eq ((84740i32, 140i32, 10i32), (89360i32, 147i32, 9i32))

///> c
test a_knight_slain_by_a_hit_cannot_drink_in_the_same_tick =
    open hunting_pack
    open creatures
    inl ~seed = 1u32
    inl p = simulate (uniform_camp Cyclops) (cavebot_with_heal 0) seed 600
    (p.potions, p.deaths) |> _assert_eq (0i32, 4i32)

///> c
test a_corridor_cuts_potions_and_deaths_in_a_cyclops_clear =
    open hunting_pack
    open creatures
    inl ~first = 1u32
    inl open_field = uniform_camp Cyclops
    inl corridor = open_field |> on_layout (open terrain in EastCorridor)
    let rec sum (camp : camp) (i : i32) (ms : i32) (potions : i32) (deaths : i32) : i32 * i32 * i32 =
        if i >= 20 then ms / 20, potions * 10 / 20, deaths
        else
            match clear_run camp (cavebot_with_heal 100) (first + conv i) 6000 with
            | elapsed, p => sum camp (i + 1) (ms + elapsed) (potions + p.potions) (deaths + p.deaths)
    inl in_the_open = sum open_field 0 0 0 0
    inl in_the_corridor = sum corridor 0 0 0 0
    (in_the_open, in_the_corridor) |> _assert_eq ((85915i32, 153i32, 3i32), (85000i32, 65i32, 0i32))
    inl _, open_potions, open_deaths = in_the_open
    inl _, corridor_potions, corridor_deaths = in_the_corridor
    (corridor_potions < open_potions, corridor_deaths < open_deaths) |> _assert_eq (true, true)

///> c
test room_and_corridor_evolved_retreat_dominates_the_fully_tuned_cavebot =
    open hunting_pack
    open creatures
    inl ~search = 29u32
    inl room = uniform_camp Cyclops |> on_layout (open terrain in RoomAndCorridor)
    inl heal = tuned_cavebot_heal_for Profit room (training_first ()) (training_count ())
    inl floor = (ledger_of room (cavebot_with_heal heal) (training_first ()) (training_count ())).hunt_kills
    inl objective = ProfitKeepingKills floor
    inl training t = worth objective room t (training_first ()) (training_count ())
    inl held_out t =
        inl l = ledger_of room t (held_out_first ()) (held_out_count ())
        l.hunt_kills, quantity.value_of l.hunt_profit
    inl evolve order = evolve_rules_for objective order {first = heal; second = 0; third = 4} room search (training_first ()) (training_count ()) 6 6
    inl current = evolve (open policy in CurrentFirst)
    inl reach = evolve (open policy in ReachFirst)
    inl current_worth = training (tactic_with_order (open policy in CurrentFirst) current)
    inl reach_worth = training (tactic_with_order (open policy in ReachFirst) reach)
    inl chosen = if reach_worth > current_worth then tactic_with_order (open policy in ReachFirst) reach else tactic_with_order (open policy in CurrentFirst) current
    inl genes = if reach_worth > current_worth then reach else current
    inl cavebot = held_out (cavebot_with_heal heal)
    inl evolved = held_out chosen
    ((heal, floor, genes.first, genes.second, genes.third, reach_worth > current_worth), cavebot, evolved) |> _assert_eq ((230i32, 956i32, 207i32, 34i32, 3i32, true), (942i32, -477181i32), (946i32, -288217i32))
    inl base_kills, base_profit = cavebot
    inl kills, profit = evolved
    (kills >= base_kills, profit > base_profit) |> _assert_eq (true, true)

///> c
test the_arena_spot_simulation_predicts_the_clean_live_clear =
    open hunting_pack
    open creatures
    inl ~first = 1u32
    inl spot = uniform_camp Cyclops |> on_layout (open terrain in ArenaSpot)
    let rec sum (i : i32) (ms : i32) (potions : i32) (deaths : i32) (hits : i32) (taken : i32) : i32 * i32 * i32 * i32 =
        if i >= 20 then ms / 20, potions * 10 / 20, deaths, taken * 100 / hits
        else
            match clear_run spot (cavebot_with_heal 160) (first + conv i) 6000 with
            | elapsed, p => sum (i + 1) (ms + elapsed) (potions + p.potions) (deaths + p.deaths) (hits + p.hits_taken) (taken + quantity.value_of p.damage_taken)
    sum 0 0 0 0 0 0 |> _assert_eq (85000i32, 124i32, 0i32, 3524i32)

///> c
test on_the_arena_spot_retreating_at_two_attackers_saves_potions =
    open hunting_pack
    open creatures
    inl ~first = 1u32
    inl spot = uniform_camp Cyclops |> on_layout (open terrain in ArenaSpot)
    let rec sum (t : tactic) (i : i32) (ms : i32) (potions : i32) (deaths : i32) : i32 * i32 * i32 =
        if i >= 20 then ms / 20, potions * 10 / 20, deaths
        else
            match clear_run spot t (first + conv i) 6000 with
            | elapsed, p => sum t (i + 1) (ms + elapsed) (potions + p.potions) (deaths + p.deaths)
    inl rules order n = tactic_with_order order {first = 160; second = 0; third = n}
    inl kite order n =
        inl t = network_tactic (cavebot_network spot 160 |> network.with_kiting n)
        {t with order = order}
    open policy
    inl cavebot = sum (cavebot_with_heal 160) 0 0 0 0
    inl retreating = sum (rules ReachFirst 2) 0 0 0 0
    (cavebot, retreating, sum (rules ReachFirst 3) 0 0 0 0, sum (rules CurrentFirst 2) 0 0 0 0, sum (kite ReachFirst 2) 0 0 0 0) |> _assert_eq ((85000i32, 124i32, 0i32), (86300i32, 88i32, 0i32), (85000i32, 124i32, 0i32), (418935i32, 427i32, 0i32), (86300i32, 87i32, 0i32))
    inl _, cavebot_potions, cavebot_deaths = cavebot
    inl _, retreat_potions, retreat_deaths = retreating
    (retreat_potions < cavebot_potions, retreat_deaths <= cavebot_deaths) |> _assert_eq (true, true)

///> c
test on_the_arena_spot_evolved_retreating_cuts_potions_by_a_third_within_the_time_cap =
    open hunting_pack
    open creatures
    inl ~search = 31u32
    inl spot = uniform_camp Cyclops |> on_layout (open terrain in ArenaSpot)
    inl tf = training_first ()
    inl tc = training_count ()
    inl heal = tuned_cavebot_heal_for (CheapClearWithin 1000000) spot tf tc
    inl cavebot_ms = (clear_ledger_of spot (cavebot_with_heal heal) tf tc).clear_ms / tc
    inl objective = CheapClearWithin (cavebot_ms * 115 / 100)
    inl training t = worth objective spot t tf tc
    inl evolve order = evolve_rules_for objective order {first = heal; second = 0; third = 4} spot search tf tc 6 6
    inl current = evolve (open policy in CurrentFirst)
    inl reach = evolve (open policy in ReachFirst)
    inl reach_wins = training (tactic_with_order (open policy in ReachFirst) reach) > training (tactic_with_order (open policy in CurrentFirst) current)
    inl genes = if reach_wins then reach else current
    inl evolved = if reach_wins then tactic_with_order (open policy in ReachFirst) reach else tactic_with_order (open policy in CurrentFirst) current
    inl held t =
        inl l = clear_ledger_of spot t (held_out_first ()) (held_out_count ())
        l.clear_potions, l.clear_deaths, l.clear_ms / held_out_count ()
    inl baseline = held (cavebot_with_heal heal)
    inl learned = held evolved
    ((heal, cavebot_ms, genes.first, genes.second, genes.third, reach_wins), baseline, learned) |> _assert_eq ((140i32, 87700i32, 143i32, 34i32, 1i32, false), (1309i32, 1i32, 88580i32), (852i32, 0i32, 91781i32))
    inl base_potions, base_deaths, base_ms = baseline
    inl potions, deaths, ms = learned
    (potions < base_potions, deaths <= base_deaths, ms <= base_ms, ms <= cavebot_ms * 115 / 100) |> _assert_eq (true, true, false, true)

///> c
test mixed_arena_camp_no_rules_dominate_the_tuned_cavebot_and_kind_aware_cyclops_rules_drink_a_fifth_less =
    open hunting_pack
    open policy
    inl ~search_seed = 37u32
    inl camp = cyclops_and_two_trolls_on_the_arena_spot ()
    inl tf = training_first ()
    inl tc = training_count ()
    inl heal = tuned_cavebot_heal_for (CheapClearWithin 1000000) camp tf tc
    inl cavebot_ms = (clear_ledger_of camp (cavebot_with_heal heal) tf tc).clear_ms / tc
    inl objective = CheapClearWithin (cavebot_ms * 115 / 100)
    inl training t = worth objective camp t tf tc
    inl blind order = evolve_rules_for objective order {first = heal; second = 0; third = 4} camp search_seed tf tc 6 6
    inl blind_current = blind CurrentFirst
    inl blind_reach = blind ReachFirst
    inl blind_reach_wins = training (tactic_with_order ReachFirst blind_reach) > training (tactic_with_order CurrentFirst blind_current)
    inl blind_genes = if blind_reach_wins then blind_reach else blind_current
    inl blind_tactic = tactic_with_order (if blind_reach_wins then ReachFirst else CurrentFirst) blind_genes
    inl aware order = evolve_temperate_for objective order (temperate_genes heal 0 0 4 4) camp (search_seed + 2u32) tf tc 6 3
    inl aware_current = aware CurrentFirst
    inl aware_reach = aware ReachFirst
    inl aware_reach_wins = training (temperate_tactic ReachFirst aware_reach) > training (temperate_tactic CurrentFirst aware_current)
    inl aware_genes = if aware_reach_wins then aware_reach else aware_current
    inl aware_tactic = temperate_tactic (if aware_reach_wins then ReachFirst else CurrentFirst) aware_genes
    inl gene i = search.gene aware_genes i
    inl held t =
        inl l = clear_ledger_of camp t (held_out_first ()) (held_out_count ())
        l.clear_potions, l.clear_deaths, l.clear_ms / held_out_count ()
    inl cavebot = held (cavebot_with_heal heal)
    inl blind_evolved = held blind_tactic
    inl cyclops_rules = held (tactic_with_order CurrentFirst (evolved_on_the_cyclops_spot ()))
    inl cyclops_rules_standing_only = held (temperate_tactic CurrentFirst (against_standing_only (evolved_on_the_cyclops_spot ())))
    inl aware_evolved = held aware_tactic
    ((heal, cavebot_ms, blind_genes.first, blind_genes.second, blind_genes.third, blind_reach_wins), (gene 0, gene 1, gene 2, gene 3, gene 4, aware_reach_wins)) |> _assert_eq ((70i32, 36356i32, 51i32, 6i32, 4i32, false), (59i32, 0i32, 4i32, 4i32, 3i32, false))
    (cavebot, blind_evolved, cyclops_rules, cyclops_rules_standing_only, aware_evolved) |> _assert_eq ((80i32, 1i32, 37871i32), (74i32, 2i32, 37792i32), (204i32, 0i32, 40784i32), (158i32, 0i32, 40459i32), (76i32, 2i32, 37792i32))
    inl dominates (p, d, ms) (bp, bd, bms) = p <= bp && d <= bd && ms <= bms && (p < bp || d < bd || ms < bms)
    (dominates aware_evolved cavebot, dominates aware_evolved blind_evolved, dominates blind_evolved cavebot, dominates cyclops_rules_standing_only cyclops_rules) |> _assert_eq (false, false, false, true)

///> c
test kills_and_gold_do_not_add fails "Unification failure" =
    open hunting_pack
    open creatures
    inl camp = uniform_camp Cyclops
    inl t = cavebot_with_heal 160
    quantity.plus (measured Kills camp t 1 1) (measured Profit camp t 1 1)
