test vitality static =
    open testing

nominal alive = ()
nominal dead = ()

union vitality phase =
    | Living :: i32 * i32 -> vitality alive
    | Fallen :: i32 -> vitality dead

union struck =
    | Survived : vitality alive
    | Slain : vitality dead

inl spawn (maximum : i32) : vitality alive =
    Living (maximum, maximum)

inl health (target : vitality alive) : i32 =
    match target with
    | Living (current, _) => current

inl maximum_health (target : vitality alive) : i32 =
    match target with
    | Living (_, maximum) => maximum

inl strike (damage : i32) (target : vitality alive) : struck =
    match target with
    | Living (current, maximum) =>
        inl remaining = current - damage
        if remaining > 0 then Survived (Living (remaining, maximum)) else Slain (Fallen maximum)

inl heal (amount : i32) (target : vitality alive) : vitality alive =
    match target with
    | Living (current, maximum) =>
        inl restored = current + amount
        Living ((if restored > maximum then maximum else restored), maximum)

inl survivor_health (outcome : struck) : i32 =
    match outcome with
    | Survived target => health target
    | Slain _ => 0

///> rust
///> c
test strike_reduces_health =
    inl ~damage = 30i32
    spawn 100 |> strike damage |> survivor_health |> _assert_eq 70i32

///> rust
///> c
test lethal_strike_slays =
    inl ~damage = 100i32
    spawn 100 |> strike damage |> survivor_health |> _assert_eq 0i32

///> rust
///> c
test heal_caps_at_maximum =
    inl ~amount = 500i32
    inl healed = spawn 100 |> heal amount
    health healed |> _assert_eq (maximum_health healed)

///> rust
///> c
test strike_then_heal =
    inl ~damage = 60i32
    match spawn 100 |> strike damage with
    | Survived wounded => wounded |> heal 25 |> health |> _assert_eq 65i32
    | Slain _ => _assert_eq 0i32 1i32

test healing_the_fallen_does_not_compile fails "Unification failure" =
    heal 10 (Fallen 100)

///> wgsl
test strike_then_heal_on_gpu =
    inl ~damage = 60i32
    match spawn 100 |> strike damage with
    | Survived wounded => if (wounded |> heal 25 |> health) = 65i32 then 0i32 else 1i32
    | Slain _ => 2i32
