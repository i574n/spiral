test wire static =
    open testing

type xtea_key = {k0 : u32; k1 : u32; k2 : u32; k3 : u32}

inl xtea_key k0 k1 k2 k3 : xtea_key = {k0 k1 k2 k3}

inl xtea_delta () : u32 = 2654435769

inl xtea_rounds () : i32 = 32

inl key_word (key : xtea_key) (index : u32) : u32 =
    if index = 0 then key.k0 elif index = 1 then key.k1 elif index = 2 then key.k2 else key.k3

inl xtea_mix (value : u32) : u32 =
    ((value <<< 4) ^^^ (value >>> 5)) + value

inl xtea_encrypt (key : xtea_key) (v0 : u32) (v1 : u32) : u32 * u32 =
    let rec round (index : i32) (a : u32) (b : u32) (sum : u32) : u32 * u32 =
        if index >= xtea_rounds () then a, b
        else
            inl a' = a + (xtea_mix b ^^^ (sum + key_word key (sum &&& 3)))
            inl sum' = sum + xtea_delta ()
            inl b' = b + (xtea_mix a' ^^^ (sum' + key_word key ((sum' >>> 11) &&& 3)))
            round (index + 1) a' b' sum'
    round 0 v0 v1 0

inl xtea_decrypt (key : xtea_key) (v0 : u32) (v1 : u32) : u32 * u32 =
    let rec round (index : i32) (a : u32) (b : u32) (sum : u32) : u32 * u32 =
        if index >= xtea_rounds () then a, b
        else
            inl b' = b - (xtea_mix a ^^^ (sum + key_word key ((sum >>> 11) &&& 3)))
            inl sum' = sum - xtea_delta ()
            inl a' = a - (xtea_mix b' ^^^ (sum' + key_word key (sum' &&& 3)))
            round (index + 1) a' b' sum'
    round 0 v0 v1 (xtea_delta () * 32)

inl adler_modulus () : u32 = 65521

type adler = {low : u32; high : u32}

inl adler_start () : adler = {low = 1; high = 0}

inl adler_step (byte : u32) (state : adler) : adler =
    inl low = (state.low + byte) % adler_modulus ()
    {low = low; high = (state.high + low) % adler_modulus ()}

inl adler_value (state : adler) : u32 =
    (state.high <<< 16) ||| state.low

///> rust
///> c
test xtea_matches_published_vector =
    inl ~v0 = 1094861636u32
    inl key = xtea_key 66051 67438087 134810123 202182159
    inl a, b = xtea_encrypt key v0 1162233672
    a |> _assert_eq 1232991184u32
    b |> _assert_eq 1918971061u32

///> rust
///> c
test xtea_matches_reference_on_small_key =
    inl ~zero = 0u32
    inl a, b = xtea_encrypt (xtea_key 1 2 3 4) zero zero
    a |> _assert_eq 2778180417u32
    b |> _assert_eq 1979796850u32

///> rust
///> c
test xtea_round_trips =
    inl ~v0 = 123456789u32
    inl key = xtea_key 11 22 33 44
    inl a, b = xtea_encrypt key v0 987654321
    inl c, d = xtea_decrypt key a b
    c |> _assert_eq v0
    d |> _assert_eq 987654321u32

///> rust
///> c
test adler32_of_wikipedia =
    inl ~first = 87u32
    adler_start ()
    |> adler_step first
    |> adler_step 105
    |> adler_step 107
    |> adler_step 105
    |> adler_step 112
    |> adler_step 101
    |> adler_step 100
    |> adler_step 105
    |> adler_step 97
    |> adler_value
    |> _assert_eq 300286872u32

///> wgsl
test xtea_published_vector_on_gpu =
    inl ~v0 = 1094861636u32
    inl a, b = xtea_encrypt (xtea_key 66051 67438087 134810123 202182159) v0 1162233672
    if a = 1232991184u32 && b = 1918971061u32 then 0i32 else 1i32

///> zig
test xtea_published_vector_on_zig =
    inl ~v0 = 1094861636u32
    inl a, b = xtea_encrypt (xtea_key 66051 67438087 134810123 202182159) v0 1162233672
    if a = 1232991184u32 && b = 1918971061u32 then 0i32 else 1i32
