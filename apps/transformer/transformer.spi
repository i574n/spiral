///- --package .
:# transformer static =
    :< testing

:< sm'_operators
:< f32_kernels

:== bytes = array u8

:== floats = array f32

:= u32_at (b : bytes) (at : i32) : u32 =
    := byte (k : i32) : u32 = conv (index b (at + k))
    byte 0 ||| (byte 1 <<< 8) ||| (byte 2 <<< 16) ||| (byte 3 <<< 24)

:= i32_at (b : bytes) (at : i32) : i32 = conv (u32_at b at)

:= f32_at (b : bytes) (at : i32) : f32 = convert::f32_of_bits (u32_at b at)

:== config = { dim : i32; hidden : i32; layers : i32; heads : i32; kv_heads : i32; vocab : i32; seq : i32 }

:= config_of (b : bytes) : config =
    := field (k : i32) : i32 = i32_at b (4 * k)
    {
        dim = field 0; hidden = field 1; layers = field 2; heads = field 3
        kv_heads = field 4; vocab = abs (field 5); seq = field 6
    }

:= shared_classifier (b : bytes) : bool = i32_at b 20 > 0

:= head_size (c : config) : i32 = c::dim / c::heads

:= kv_dim (c : config) : i32 = c::dim * c::kv_heads / c::heads

:~ ^ decode_floats (b : bytes) (out : floats) (start : i32) (i : i32) : () =
    ? i < length out ?>
        set out i (f32_at b (start + 4 * i))
        decode_floats b out start (i + 1)

:= floats_from (b : bytes) (start : i32) (count : i32) : floats =
    := out : floats = create count
    decode_floats b out start 0
    out

:= zeros (count : i32) : floats = create count

:== slab = { at : i32; size : i32 }

:= after (s : slab) (size : i32) : slab = { at = s::at + s::size; size = size }

:== attention_w = { rms : slab; wq : slab; wk : slab; wv : slab; wo : slab }

:== ffn_w = { rms : slab; w1 : slab; w2 : slab; w3 : slab }

:== layout = { embed : slab; att : attention_w; ffn : ffn_w; final : slab; cls : slab }

:= qkv_slabs (c : config) (r : slab) : slab * slab * slab =
    := per = c::layers * c::dim
    := q = after r (per * c::dim)
    := k = after q (per * kv_dim c)
    q, k, after k (per * kv_dim c)

:= attention_of (c : config) (embed : slab) : attention_w =
    := r = after embed (c::layers * c::dim)
    := q, k, v = qkv_slabs c r
    { rms = r; wq = q; wk = k; wv = v; wo = after v (c::layers * c::dim * c::dim) }

:= ffn_of (c : config) (wo : slab) : ffn_w =
    := per = c::layers * c::dim * c::hidden
    := rms = after wo (c::layers * c::dim)
    := w1 = after rms per
    := w2 = after w1 per
    { rms = rms; w1 = w1; w2 = w2; w3 = after w2 per }

:= classifier (c : config) (shared : bool) (embed : slab) (final : slab) : slab =
    ? shared ?> embed |: after (after final (c::seq * head_size c)) (c::vocab * c::dim)

:= layout_with (c : config) (shared : bool) (e : slab) (a : attention_w) : layout =
    := f = ffn_of c a::wo
    := z = after f::w3 c::dim
    { embed = e; att = a; ffn = f; final = z; cls = classifier c shared e z }

:= layout_of (c : config) (shared : bool) : layout =
    := embed = { at = 0; size = c::vocab * c::dim }
    layout_with c shared embed (attention_of c embed)

:== model = { c : config; l : layout; w : floats }

:= weight_count (l : layout) : i32 =
    := last = ? l::cls::at = l::embed::at ?> l::final |: l::cls
    last::at + last::size

:= model_of (b : bytes) : model =
    := c = config_of b
    := l = layout_of c (shared_classifier b)
    { c = c; l = l; w = floats_from b 28 (weight_count l) }

:== buffers = { x : floats; xb : floats; xb2 : floats; hb : floats; hb2 : floats; q : floats; k : floats; v : floats }

:== caches = { att : floats; logits : floats; keys : floats; values : floats }

:= buffers_of (c : config) : buffers =
    := d = zeros
    {
        x = d c::dim; xb = d c::dim; xb2 = d c::dim; hb = d c::hidden
        hb2 = d c::hidden; q = d c::dim; k = d (kv_dim c); v = d (kv_dim c)
    }

:= caches_of (c : config) : caches =
    := cache = c::layers * c::seq * kv_dim c
    { att = zeros (c::heads * c::seq); logits = zeros c::vocab; keys = zeros cache; values = zeros cache }

:= rotate (v : floats) (i : i32) (fcr : f32) (fci : f32) : () =
    := v0 = index v i
    := v1 = index v (i + 1)
    set v i (v0 * fcr - v1 * fci)
    set v (i + 1) (v0 * fci + v1 * fcr)

:= rope_angle (c : config) (pos : i32) (i : i32) : f32 =
    := hs = head_size c
    conv pos * (1.0f32 / (10000.0f32 ** (conv (i % hs) / conv hs)))

:= rope_pair (c : config) (b : buffers) (i : i32) (angle : f32) : () =
    rotate b::q i (cos angle) (sin angle)
    ? i < kv_dim c ?> rotate b::k i (cos angle) (sin angle)

:~ ^ rope_from (c : config) (b : buffers) (pos : i32) (i : i32) : () =
    ? i < c::dim ?>
        rope_pair c b i (rope_angle c pos i)
        rope_from c b pos (i + 2)

:= cache_row (c : config) (layer : i32) (t : i32) : i32 = (layer * c::seq + t) * kv_dim c

:= kv_head (c : config) (h : i32) : i32 = h / (c::heads / c::kv_heads) * head_size c

:= score_at (c : config) (b : buffers) (s : caches) (layer : i32) (h : i32) (t : i32) : f32 =
    := hs = head_size c
    dot s::keys (cache_row c layer t + kv_head c h) b::q (h * hs) hs 0 0.0f32 / sqrt (conv hs)

:~ ^ scores_from (c : config) (b : buffers) (s : caches) (layer : i32) (h : i32) (pos : i32) (t : i32) : () =
    ? t <= pos ?>
        set s::att (h * c::seq + t) (score_at c b s layer h t)
        scores_from c b s layer h pos (t + 1)

:= mix_at (c : config) (b : buffers) (s : caches) (layer : i32) (h : i32) (t : i32) : () =
    := hs = head_size c
    axpy b::xb (h * hs) (index s::att (h * c::seq + t)) s::values (cache_row c layer t + kv_head c h) hs 0

:~ ^ mix_from (c : config) (b : buffers) (s : caches) (layer : i32) (h : i32) (pos : i32) (t : i32) : () =
    ? t <= pos ?>
        mix_at c b s layer h t
        mix_from c b s layer h pos (t + 1)

:= attend_head (c : config) (b : buffers) (s : caches) (layer : i32) (pos : i32) (h : i32) : () =
    scores_from c b s layer h pos 0
    softmax s::att (h * c::seq) (pos + 1)
    zero_from b::xb (h * head_size c) (head_size c) 0
    mix_from c b s layer h pos 0

:~ ^ heads_from (c : config) (b : buffers) (s : caches) (layer : i32) (pos : i32) (h : i32) : () =
    ? h < c::heads ?>
        attend_head c b s layer pos h
        heads_from c b s layer pos (h + 1)

:= layer_at (s : slab) (layer : i32) (per : i32) : i32 = s::at + layer * per

:= project (m : model) (o : floats) (x : floats) (s : slab) (layer : i32) (n : i32) (d : i32) : () =
    matmul o x m::w (layer_at s layer (n * d)) n d

:= normed (m : model) (b : buffers) (s : slab) (layer : i32) : () =
    rmsnorm b::xb b::x m::w (layer_at s layer m::c::dim) m::c::dim

:= qkv (m : model) (b : buffers) (layer : i32) : () =
    := a = m::l::att
    := d = m::c::dim
    normed m b a::rms layer
    project m b::q b::xb a::wq layer d d
    project m b::k b::xb a::wk layer d (kv_dim m::c)
    project m b::v b::xb a::wv layer d (kv_dim m::c)

:= cache_kv (c : config) (b : buffers) (s : caches) (layer : i32) (pos : i32) : () =
    rope_from c b pos 0
    copy_into s::keys (cache_row c layer pos) b::k 0 (kv_dim c) 0
    copy_into s::values (cache_row c layer pos) b::v 0 (kv_dim c) 0

:= attention (m : model) (b : buffers) (s : caches) (layer : i32) (pos : i32) : () =
    := d = m::c::dim
    qkv m b layer
    cache_kv m::c b s layer pos
    heads_from m::c b s layer pos 0
    project m b::xb2 b::xb m::l::att::wo layer d d
    add_into b::x b::xb2 d 0

:~ ^ swiglu_from (hb : floats) (hb2 : floats) (n : i32) (i : i32) : () =
    ? i < n ?>
        := v = index hb i
        set hb i (v * (1.0f32 / (1.0f32 + exp (0.0f32 - v))) * index hb2 i)
        swiglu_from hb hb2 n (i + 1)

:= ffn_hidden (m : model) (b : buffers) (layer : i32) : () =
    normed m b m::l::ffn::rms layer
    project m b::hb b::xb m::l::ffn::w1 layer m::c::dim m::c::hidden
    project m b::hb2 b::xb m::l::ffn::w3 layer m::c::dim m::c::hidden

:= feed_forward (m : model) (b : buffers) (layer : i32) : () =
    ffn_hidden m b layer
    swiglu_from b::hb b::hb2 m::c::hidden 0
    project m b::xb b::hb m::l::ffn::w2 layer m::c::hidden m::c::dim
    add_into b::x b::xb m::c::dim 0

:~ ^ layers_from (m : model) (b : buffers) (s : caches) (pos : i32) (layer : i32) : () =
    ? layer < m::c::layers ?>
        attention m b s layer pos
        feed_forward m b layer
        layers_from m b s pos (layer + 1)

:= logits_of (m : model) (b : buffers) (s : caches) : () =
    rmsnorm b::x b::x m::w m::l::final::at m::c::dim
    matmul s::logits b::x m::w m::l::cls::at m::c::dim m::c::vocab

:= forward (m : model) (b : buffers) (s : caches) (token : i32) (pos : i32) : () =
    copy_into b::x 0 m::w (m::l::embed::at + token * m::c::dim) m::c::dim 0
    layers_from m b s pos 0
    logits_of m b s

:~ ^ argmax_from (x : floats) (n : i32) (i : i32) (best : i32) : i32 =
    ? i >= n ?> best |: argmax_from x n (i + 1) (? index x i > index x best ?> i |: best)

:= argmax (x : floats) : i32 = argmax_from x (length x) 1 0

:~ ^ copy_bytes (o : bytes) (t : bytes) (from : i32) (k : i32) : () =
    ? k < length o ?>
        set o k (index t (from + k))
        copy_bytes o t from (k + 1)

:= piece_at (t : bytes) (at : i32) : bytes =
    := piece : bytes = create (i32_at t (at + 4))
    copy_bytes piece t (at + 8) 0
    piece

:~ ^ read_pieces (t : bytes) (pieces : array bytes) (i : i32) (at : i32) : () =
    ? i < length pieces ?>
        := piece = piece_at t at
        set pieces i piece
        read_pieces t pieces (i + 1) (at + 8 + length piece)

:= vocab_of (t : bytes) (count : i32) : array bytes =
    := pieces : array bytes = create count
    read_pieces t pieces 0 4
    pieces

:= hex_digit (b : u8) : i32 = ? b >= 65u8 ?> conv b - 55 |: conv b - 48

:= raw_byte (p : bytes) : option i32 =
    ? length p = 6 && index p 0 = 60u8 && index p 1 = 48u8 && index p 2 = 120u8
    ?> Some (hex_digit (index p 3) * 16 + hex_digit (index p 4))
    |: None

:~ ^ ascii_from (p : bytes) (start : i32) (i : i32) (acc : string) : string =
    ? i >= length p ?> acc |: ascii_from p start (i + 1) (acc ++# unicode::char_of (conv (index p i)))

:= piece_text (prev : i32) (p : bytes) : string =
    ?= raw_byte p ?|
    | Some b => unicode::char_of b
    | None =>
        := start = ? prev = 1 && length p > 0 && index p 0 = 32u8 ?> 1 |: 0
        ascii_from p start start ""

:~ ^ read_scores (t : bytes) (scores : floats) (i : i32) (at : i32) : () =
    ? i < length scores ?>
        set scores i (f32_at t at)
        read_scores t scores (i + 1) (at + 8 + i32_at t (at + 4))

:= scores_of (t : bytes) (count : i32) : floats =
    := scores : floats = create count
    read_scores t scores 0 4
    scores

:~ ^ same_from (a : bytes) (b : bytes) (k : i32) : bool =
    ? k >= length a ?> !+ |: ? index a k <> index b k ?> !- |: same_from a b (k + 1)

:= same_bytes (a : bytes) (b : bytes) : bool = ? length a <> length b ?> !- |: same_from a b 0

:~ ^ find_piece (pieces : array bytes) (p : bytes) (i : i32) : i32 =
    ? i >= length pieces ?> -1 |: ? same_bytes (index pieces i) p ?> i |: find_piece pieces p (i + 1)

:~ ^ put_bytes (o : bytes) (at : i32) (x : bytes) (k : i32) : () =
    ? k < length x ?>
        set o (at + k) (index x k)
        put_bytes o at x (k + 1)

:= joined (a : bytes) (b : bytes) : bytes =
    := o : bytes = create (length a + length b)
    put_bytes o 0 a 0
    put_bytes o (length a) b 0
    o

:= slice_bytes (t : bytes) (from : i32) (n : i32) : bytes =
    := o : bytes = create n
    copy_bytes o t from 0
    o

:~ ^ codepoint_end (t : bytes) (i : i32) : i32 =
    ? i >= length t ?> i |: ? (index t i &&& 192u8) = 128u8 ?> codepoint_end t (i + 1) |: i

:~ ^ fallback_bytes (t : bytes) (i : i32) (stop : i32) (acc : list i32) : list i32 =
    ? i >= stop ?> acc |: fallback_bytes t (i + 1) stop ((conv (index t i) : i32) + 3 :: acc)

:~ ^ initial_from (pieces : array bytes) (t : bytes) (i : i32) (acc : list i32) : list i32 =
    ? i >= length t ?> acc
    |:
        := stop = codepoint_end t (i + 1)
        := id = find_piece pieces (slice_bytes t i (stop - i)) 0
        initial_from pieces t stop (? id >= 0 ?> id :: acc |: fallback_bytes t i stop acc)

:== best = { score : f32; at : i32; id : i32 }

:= better (pieces : array bytes) (scores : floats) (x : i32) (y : i32) (at : i32) (b : best) : best =
    := id = find_piece pieces (joined (index pieces x) (index pieces y)) 0
    ? id < 0 ?> b |: ? index scores id > b::score ?> { score = index scores id; at = at; id = id } |: b

:~ ^ best_pair (pieces : array bytes) (scores : floats) (ids : list i32) (at : i32) (b : best) : best =
    ?= ids ?|
    | [] => b
    | x :: rest =>
        ?= rest ?|
        | [] => b
        | y :: _ => best_pair pieces scores rest (at + 1) (better pieces scores x y at b)

:~ ^ merged_at (ids : list i32) (at : i32) (id : i32) : list i32 =
    ?= ids ?|
    | [] => []
    | x :: rest =>
        ? at > 0 ?> x :: merged_at rest (at - 1) id
        |: ?= rest ?| | _ :: tail => id :: tail | [] => [ id ]

:~ ^ merge_all (pieces : array bytes) (scores : floats) (ids : list i32) : list i32 =
    := b = best_pair pieces scores ids 0 { score = -10000000000.0f32; at = -1; id = -1 }
    ? b::at < 0 ?> ids |: merge_all pieces scores (merged_at ids b::at b::id)

:= space_piece () : bytes =
    := p : bytes = create 1
    set p 0 32u8
    p

:= encode (pieces : array bytes) (scores : floats) (text : bytes) : list i32 =
    ? length text = 0 ?> [ 1 ]
    |:
        := prefix = find_piece pieces (space_piece ()) 0
        1 :: merge_all pieces scores (prefix :: listm::rev (initial_from pieces text 0 []))

:== run = { m : model; b : buffers; s : caches; pieces : array bytes; steps : i32 }

:= next_token (r : run) (token : i32) (pos : i32) : i32 =
    forward r::m r::b r::s token pos
    argmax r::s::logits

:~ ^ generate (r : run) (token : i32) (pos : i32) (out : string) : string =
    ? pos >= r::steps ?> out
    |:
        := next = next_token r token pos
        ? next = 1 ?> out |: generate r next (pos + 1) (out ++# piece_text token (index r::pieces next))

:~ ^ generate_from (r : run) (forced : list i32) (token : i32) (pos : i32) (out : string) : string =
    ? pos >= r::steps ?> out
    |:
        := sampled = next_token r token pos
        := next, rest = ?= forced ?| | p :: more => p, more | [] => sampled, []
        ? next = 1 ?> out |: generate_from r rest next (pos + 1) (out ++# piece_text token (index r::pieces next))

:= random_u32 (rng : array u64) : u32 =
    := a = index rng 0
    := b = a ^^^ (a >>> 12)
    := c = b ^^^ (b <<< 25)
    := d = c ^^^ (c >>> 27)
    set rng 0 d
    conv ((d * 2685821657736338717u64) >>> 32)

:= random_f32 (rng : array u64) : f32 = conv (random_u32 rng >>> 8) / 16777216.0f32

:== sampler = { temperature : f32; topp : f32; rng : array u64 }

:= sampler_of (temperature : f32) (topp : f32) (seed : u64) : sampler =
    := rng : array u64 = create 1
    set rng 0 seed
    { temperature = temperature; topp = topp; rng = rng }

:~ ^ mult_from (probs : floats) (coin : f32) (i : i32) (cdf : f32) : i32 =
    ? i >= length probs ?> length probs - 1
    |:
        := cdf = cdf + index probs i
        ? coin < cdf ?> i |: mult_from probs coin (i + 1) cdf

:= beats (probs : floats) (cutoff : f32) (i : i32) (best : i32) : bool =
    ? index probs i < cutoff ?> !- |: ? best < 0 ?> !+ |: index probs i > index probs best

:~ ^ pick_max (probs : floats) (taken : array bool) (cutoff : f32) (i : i32) (best : i32) : i32 =
    ? i >= length probs ?> best
    |: pick_max probs taken cutoff (i + 1) (? index taken i ?> best |: ? beats probs cutoff i best ?> i |: best)

:~ ^ nucleus (p : floats) (taken : array bool) (cut : f32) (top : f32) (acc : f32) (picks : list i32) : f32 * list i32 =
    := i = pick_max p taken cut 0 (-1)
    ? i < 0 ?> acc, picks
    |:
        set taken i !+
        := acc = acc + index p i
        ? acc > top ?> acc, i :: picks |: nucleus p taken cut top acc (i :: picks)

:~ ^ draw (probs : floats) (r : f32) (cdf : f32) (order : list i32) (last : i32) : i32 =
    ?= order ?|
    | [] => last
    | i :: rest =>
        := cdf = cdf + index probs i
        ? r < cdf ?> i |: draw probs r cdf rest last

:= sample_topp (probs : floats) (topp : f32) (coin : f32) : i32 =
    := cutoff = (1.0f32 - topp) / conv (length probs - 1)
    := taken : array bool = create (length probs)
    := total, chosen = nucleus probs taken cutoff topp 0.0f32 []
    ?= chosen ?|
    | last :: _ => draw probs (coin * total) 0.0f32 (listm::rev chosen) last
    | [] => 0

:~ ^ scale_from (x : floats) (t : f32) (i : i32) : () =
    ? i < length x ?>
        set x i (index x i / t)
        scale_from x t (i + 1)

:= sample (s : sampler) (logits : floats) : i32 =
    ? s::temperature = 0.0f32 ?> argmax logits
    |:
        scale_from logits s::temperature 0
        softmax logits 0 (length logits)
        := coin = random_f32 s::rng
        ? s::topp <= 0.0f32 || s::topp >= 1.0f32 ?> mult_from logits coin 0 0.0f32 |: sample_topp logits s::topp coin

:~ ^ generate_sampled (r : run) (s : sampler) (forced : list i32) (token : i32) (pos : i32) (out : string) : string =
    ? pos >= r::steps ?> out
    |:
        forward r::m r::b r::s token pos
        := next, rest = ?= forced ?| | p :: more => p, more | [] => sample s r::s::logits, []
        ? next = 1 ?> out |: generate_sampled r s rest next (pos + 1) (out ++# piece_text token (index r::pieces next))

:= generate_prompted (r : run) (tokens : list i32) : string =
    ?= tokens ?|
    | first :: rest => generate_from r rest first 0 ""
    | [] => generate_from r [] 1 0 ""

:= file_bytes (variable : string) : bytes = file_system::read_bytes (env::get_environment_variable variable)

:= run_of (m : model) (pieces : array bytes) (steps : i32) : run =
    { m = m; b = buffers_of m::c; s = caches_of m::c; pieces = pieces; steps = steps }

:= piece_of (codes : list u8) : bytes =
    := p : bytes = create (listm::length codes)
    :~ ^ put (rest : list u8) (i : i32) : () =
        ?= rest ?|
        | head :: tail =>
            set p i head
            put tail (i + 1)
        | [] => ()
    put codes 0
    p

///> rust
:# prompt_encodes_and_generates_like_run_c_on_stories260k =
    := o = oracle::stories260k ()
    := m = model_of (file_system::read_bytes (oracle::model_path o::checkpoint))
    := t = file_system::read_bytes (oracle::model_path o::tokenizer)
    := r = run_of m (vocab_of t m::c::vocab) o::steps
    := tokens = encode r::pieces (scores_of t m::c::vocab) (piece_of (oracle::dragon_prompt ()))
    generate_prompted r tokens |> _assert_eq (oracle::dragon_text ())

///> rust
:# topp_sampling_matches_run_c_on_stories260k =
    := o = oracle::stories260k ()
    := m = model_of (file_system::read_bytes (oracle::model_path o::checkpoint))
    := r = run_of m (vocab_of (file_system::read_bytes (oracle::model_path o::tokenizer)) m::c::vocab) o::steps
    generate_sampled r (sampler_of 1.0f32 0.9f32 42u64) [] 1 0 "" |> _assert_eq (oracle::sampled_text ())

///> rust
:# raw_byte_pieces_decode_and_bos_strips_the_space =
    := ~prev = 1i32
    := raw = piece_text 5 (piece_of [ 60u8; 48u8; 120u8; 52u8; 49u8; 62u8 ])
    (raw, piece_text prev (piece_of [ 32u8; 104u8; 105u8 ])) |> _assert_eq ("A", "hi")

///> rust
:# greedy_stories260k_matches_run_c =
    := o = oracle::stories260k ()
    := m = model_of (file_system::read_bytes (oracle::model_path o::checkpoint))
    := r = run_of m (vocab_of (file_system::read_bytes (oracle::model_path o::tokenizer)) m::c::vocab) o::steps
    generate r 1 0 "" |> _assert_eq (oracle::greedy_text o)

:= probe_error (logits : floats) (probes : list oracle::probe) : f32 =
    probes |> listm::fold (\ worst (p : oracle::probe) => max worst (abs (index logits p::token - p::logit))) 0.0f32

:~ ^ worst_logit_error (r : run) (token : i32) (pos : i32) (steps : list (list oracle::probe)) (worst : f32) : f32 =
    ?= steps ?|
    | [] => worst
    | probes :: rest =>
        := next = next_token r token pos
        worst_logit_error r next (pos + 1) rest (max worst (probe_error r::s::logits probes))

///> rust
:# logits_stories260k_stay_within_1e4_of_run_c =
    := o = oracle::stories260k ()
    := m = model_of (file_system::read_bytes (oracle::model_path o::checkpoint))
    := r = run_of m (vocab_of (file_system::read_bytes (oracle::model_path o::tokenizer)) m::c::vocab) o::steps
    (worst_logit_error r 1 0 (oracle::stories260k_probes ()) 0.0f32 < 0.0001f32) |> _assert_eq !+

:~ ^ dump_from (x : floats) (i : i32) : () =
    ? i < length x ?>
        console::write_line (conv (index x i * 10000000.0f32) : i64)
        dump_from x (i + 1)

:~ ^ dump_steps (r : run) (token : i32) (pos : i32) (n : i32) : () =
    ? pos < n ?>
        := next = next_token r token pos
        dump_from r::s::logits 0
        dump_steps r next (pos + 1) n

:= dump_count () : option i32 = convert::try_convert (env::get_environment_variable "TRANSFORMER_DUMP_STEPS")

:= seed_of () : option i32 = convert::try_convert (env::get_environment_variable "TRANSFORMER_SEED")

:= prompt_tokens (r : run) (t : bytes) : list i32 =
    := path = env::get_environment_variable "TRANSFORMER_PROMPT_FILE"
    ? path = "" ?> [ 1 ] |: encode r::pieces (scores_of t r::m::c::vocab) (file_system::read_bytes path)

:= generate_with (r : run) (tokens : list i32) : string =
    := first, rest = ?= tokens ?| | x :: more => x, more | [] => 1, []
    ?= seed_of () ?|
    | Some seed => generate_sampled r (sampler_of 1.0f32 0.9f32 (conv seed)) rest first 0 ""
    | None => generate_from r rest first 0 ""

///> _
:= main () : i32 =
    := m = model_of (file_bytes "TRANSFORMER_CHECKPOINT")
    := t = file_bytes "TRANSFORMER_TOKENIZER"
    := r = run_of m (vocab_of t m::c::vocab) 256
    ?= dump_count () ?|
    | Some n => dump_steps r 1 0 n
    | None => console::write_line (generate_with r (prompt_tokens r t))
    0
