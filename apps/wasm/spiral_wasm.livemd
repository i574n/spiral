### get_command

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":":~ get_command () =\n    ###\"command\"\n    |> runtime.new_command\n    |> runtime.command_args_override_self !+\n    |> runtime.command_init_arg (get_args () .exception) (\n        runtime.arg_num_args_range (\n            runtime.new_value_range\n                !+\n                (am'.End eval)\n                (am'.End \\ _ => (1i32 |> convert.convert : convert.unativeint))\n        )\n        >> runtime.arg_require_equals !+\n        >> runtime.arg_default_missing_value \"\"\n    )\n    |> runtime.command_init_arg (get_args () .trace_level) (\n        ~> runtime.arg_union `trace_level ignore\n    )\n    |> runtime.command_init_arg (get_args () .wasm) (\n        runtime.arg_required !+\n    )","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  :~ get_command () =
      ###"command"
      |> runtime.new_command
      |> runtime.command_args_override_self !+
      |> runtime.command_init_arg (get_args () .exception) (
          runtime.arg_num_args_range (
              runtime.new_value_range
                  !+
                  (am'.End eval)
                  (am'.End \ _ => (1i32 |> convert.convert : convert.unativeint))
          )
          >> runtime.arg_require_equals !+
          >> runtime.arg_default_missing_value ""
      )
      |> runtime.command_init_arg (get_args () .trace_level) (
          ~> runtime.arg_union `trace_level ignore
      )
      |> runtime.command_init_arg (get_args () .wasm) (
          runtime.arg_required !+
      )
  """,
  timeout: 300_000
)
```

### run

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":":~ ^ run\n    (matches : runtime.arg_matches)\n    : async.future_pin (\n        resultm.result'\n            u8\n            resultm.anyhow_error\n    )\n    =\n    \\ () =>\n        := wasm_path =\n            matches\n            |> runtime.matches_get_one (get_args () .wasm |> fst)\n            |> optionm'.unbox\n            |> optionm.value\n            |> sm'.from_std_string\n\n        trace Verbose (\\ () => \"spiral_wasm.run\") \\ () => { wasm_path }\n\n        := wasm = wasm_path |> file_system.read |> resultm.try'\n\n        :~ fn (retry : u8) =\n            \\ () =>\n                := worker = near_workspaces.sandbox_worker () |> resultm.try'\n                := contract = worker |> near_workspaces.dev_deploy wasm |> async.await |> resultm.try'\n\n                trace Verbose (\\ () => \"spiral_wasm.run\") \\ () => { retry worker contract }\n\n                := result =\n                    contract\n                    |> near_workspaces.call \"state_main\"\n                    |> near_workspaces.gas (near_workspaces.from_tgas 300)\n                    |> near_workspaces.transact\n                    |> async.await\n                    |> resultm.try'\n\n                trace Verbose (\\ () => \"spiral_wasm.run\") \\ () => { retry result }\n\n                result\n                |> near_workspaces.logs\n                |> am'.vec_map sm'.ref_to_std_string\n                |> am'.vec_for_each console.write_line\n\n                trace_raw Info (\\ () => \" \")\n                result |> near_workspaces.print_usd retry\n\n                := result2 = result |> near_workspaces.into_result\n\n                trace Verbose (\\ () => \"spiral_wasm.run\") \\ () => { result2 }\n\n                := receipt_failures = result |> near_workspaces.receipt_failures\n                := receipt_failures_len = receipt_failures |> am'.vec_len |> convert.i32\n\n                trace Verbose\n                    \\ () => \"spiral_wasm.run\"\n                    \\ () => { receipt_failures_len receipt_failures }\n\n                := receipt_outcomes = result |> near_workspaces.receipt_outcomes\n                := receipt_outcomes_len = receipt_outcomes |> am'.vec_len |> convert.i32\n\n                trace Verbose\n                    \\ () => \"spiral_wasm.run\"\n                    \\ () => { receipt_outcomes_len receipt_outcomes }\n\n                := json = result |> near_workspaces.json\n\n                trace Verbose (\\ () => \"spiral_wasm.run\") \\ () => { json }\n\n                := borsh = result |> near_workspaces.borsh\n\n                trace Verbose (\\ () => \"spiral_wasm.run\") \\ () => { borsh }\n\n                := error = #?{ receipt_outcomes_len retry receipt_failures }\n                ? receipt_failures_len > 0\n                ?> (Ok (Some error) : _ _ resultm.anyhow_error) |> resultm.box\n                |? receipt_outcomes_len > 1\n                ?> (Ok None : _ _ resultm.anyhow_error) |> resultm.box\n                |: error |> resultm.anyhow_error |> resultm.err\n            |> async.new_future_move\n\n        :~ ^ 루프 (retry : u8) =\n            := max = 15\n            := init (error : _ string) =\n                \\ () =>\n                    { retry error }\n                |> async.new_future_move\n            \\ () =>\n                := result =\n                    fn retry\n                    |> async.await\n                    |> resultm.map_error' sm'.format'\n                    |> resultm.unbox\n                ?= result ?|\n                | Ok (None) =>\n                    init None\n                    |> async.await\n                    |> Ok\n                | Ok (Some error) =>\n                    trace Critical (\\ () => \"spiral_wasm.run / Ok (Some error)\") \\ () => { retry error }\n                    init (Some error)\n                    |> async.await\n                    |> Error\n                | Error error ?& retry >= max =>\n                    trace Warning (\\ () => \"spiral_wasm.run / Error error\") \\ () => { retry error }\n                    trace_raw Warning (\\ () => \"\\n\")\n                    init None\n                    |> async.await\n                    |> Ok\n                | Error error =>\n                    trace Warning (\\ () => \"spiral_wasm.run / Error error\") \\ () => { retry error }\n                    trace_raw Warning (\\ () => \"\\n\")\n                    루프 (retry + 1) |> async.await\n            |> async.new_future_move\n        := retries = 루프 1 |> async.await\n\n        trace Verbose (\\ () => \"spiral_wasm.run\") \\ () => { retries }\n\n        ?= retries ?|\n        | Ok { retry } => Ok retry |> resultm.box\n        | Error { retry error } => #?{ retries error } |> resultm.anyhow_error |> resultm.err\n\n    |> async.new_future_move","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  :~ ^ run
      (matches : runtime.arg_matches)
      : async.future_pin (
          resultm.result'
              u8
              resultm.anyhow_error
      )
      =
      \ () =>
          := wasm_path =
              matches
              |> runtime.matches_get_one (get_args () .wasm |> fst)
              |> optionm'.unbox
              |> optionm.value
              |> sm'.from_std_string

          trace Verbose (\ () => "spiral_wasm.run") \ () => { wasm_path }

          := wasm = wasm_path |> file_system.read |> resultm.try'

          :~ fn (retry : u8) =
              \ () =>
                  := worker = near_workspaces.sandbox_worker () |> resultm.try'
                  := contract = worker |> near_workspaces.dev_deploy wasm |> async.await |> resultm.try'

                  trace Verbose (\ () => "spiral_wasm.run") \ () => { retry worker contract }

                  := result =
                      contract
                      |> near_workspaces.call "state_main"
                      |> near_workspaces.gas (near_workspaces.from_tgas 300)
                      |> near_workspaces.transact
                      |> async.await
                      |> resultm.try'

                  trace Verbose (\ () => "spiral_wasm.run") \ () => { retry result }

                  result
                  |> near_workspaces.logs
                  |> am'.vec_map sm'.ref_to_std_string
                  |> am'.vec_for_each console.write_line

                  trace_raw Info (\ () => " ")
                  result |> near_workspaces.print_usd retry

                  := result2 = result |> near_workspaces.into_result

                  trace Verbose (\ () => "spiral_wasm.run") \ () => { result2 }

                  := receipt_failures = result |> near_workspaces.receipt_failures
                  := receipt_failures_len = receipt_failures |> am'.vec_len |> convert.i32

                  trace Verbose
                      \ () => "spiral_wasm.run"
                      \ () => { receipt_failures_len receipt_failures }

                  := receipt_outcomes = result |> near_workspaces.receipt_outcomes
                  := receipt_outcomes_len = receipt_outcomes |> am'.vec_len |> convert.i32

                  trace Verbose
                      \ () => "spiral_wasm.run"
                      \ () => { receipt_outcomes_len receipt_outcomes }

                  := json = result |> near_workspaces.json

                  trace Verbose (\ () => "spiral_wasm.run") \ () => { json }

                  := borsh = result |> near_workspaces.borsh

                  trace Verbose (\ () => "spiral_wasm.run") \ () => { borsh }

                  := error = #?{ receipt_outcomes_len retry receipt_failures }
                  ? receipt_failures_len > 0
                  ?> (Ok (Some error) : _ _ resultm.anyhow_error) |> resultm.box
                  |? receipt_outcomes_len > 1
                  ?> (Ok None : _ _ resultm.anyhow_error) |> resultm.box
                  |: error |> resultm.anyhow_error |> resultm.err
              |> async.new_future_move

          :~ ^ 루프 (retry : u8) =
              := max = 15
              := init (error : _ string) =
                  \ () =>
                      { retry error }
                  |> async.new_future_move
              \ () =>
                  := result =
                      fn retry
                      |> async.await
                      |> resultm.map_error' sm'.format'
                      |> resultm.unbox
                  ?= result ?|
                  | Ok (None) =>
                      init None
                      |> async.await
                      |> Ok
                  | Ok (Some error) =>
                      trace Critical (\ () => "spiral_wasm.run / Ok (Some error)") \ () => { retry error }
                      init (Some error)
                      |> async.await
                      |> Error
                  | Error error ?& retry >= max =>
                      trace Warning (\ () => "spiral_wasm.run / Error error") \ () => { retry error }
                      trace_raw Warning (\ () => "\n")
                      init None
                      |> async.await
                      |> Ok
                  | Error error =>
                      trace Warning (\ () => "spiral_wasm.run / Error error") \ () => { retry error }
                      trace_raw Warning (\ () => "\n")
                      루프 (retry + 1) |> async.await
              |> async.new_future_move
          := retries = 루프 1 |> async.await

          trace Verbose (\ () => "spiral_wasm.run") \ () => { retries }

          ?= retries ?|
          | Ok { retry } => Ok retry |> resultm.box
          | Error { retry error } => #?{ retries error } |> resultm.anyhow_error |> resultm.err

      |> async.new_future_move
  """,
  timeout: 300_000
)
```

### main

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":"///> _\n\n:= run_main (args : array_base string) : i32 =\n    := command = get_command ()\n    := arg_matches = command |> runtime.command_get_matches\n\n    := trace_level =\n        arg_matches\n        |> runtime.matches_get_one (get_args () .trace_level |> fst)\n        |> optionm'.unbox\n        |> optionm.map (\n            sm'.from_std_string\n            >> reflection.union_try_pick\n        )\n        |> optionm'.flatten\n        |> optionm'.default_value Verbose\n\n    := trace_state = get_trace_state_or_init (Some trace_level)\n\n    trace Verbose\n        \\ () => \"spiral_wasm.main\"\n        \\ () => { args }\n\n    := exception =\n        arg_matches\n        |> runtime.matches_get_one (get_args () .exception |> fst)\n        |> optionm'.map (sm'.from_std_string >> sm'.trim_start [ '\\\\' ] >> sm'.trim_end [ '\\\\' ])\n        |> optionm'.unbox\n\n    := result =\n        arg_matches\n        |> run\n        |> async.block_on_tokio\n        |> resultm.map_error' sm'.format'\n\n    ?= result |> rust.clone_rust |> resultm.unbox, exception ?|\n    | Ok retries, Some exception =>\n        ($'$\"spiral_wasm.main / retries: {!retries} / exception: \\'{!exception}\\'\"' : string)\n        |> resultm.err |> resultm.unwrap'\n    | Error _error, Some (\"\") =>\n        ()\n    | Error error, Some exception ?& error |> sm'.from_std_string |> sm'.contains exception =>\n        ()\n    | Error error, Some exception =>\n        ($'$\"spiral_wasm.main / exception: \\'{!exception}\\' / error: {!error}\"' : string)\n        |> resultm.err |> resultm.unwrap'\n    | Ok _retries, _ =>\n        ()\n    | Error _error, _ =>\n        result |> resultm.unwrap' |> ignore\n\n    0i32","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  ///> _

  := run_main (args : array_base string) : i32 =
      := command = get_command ()
      := arg_matches = command |> runtime.command_get_matches

      := trace_level =
          arg_matches
          |> runtime.matches_get_one (get_args () .trace_level |> fst)
          |> optionm'.unbox
          |> optionm.map (
              sm'.from_std_string
              >> reflection.union_try_pick
          )
          |> optionm'.flatten
          |> optionm'.default_value Verbose

      := trace_state = get_trace_state_or_init (Some trace_level)

      trace Verbose
          \ () => "spiral_wasm.main"
          \ () => { args }

      := exception =
          arg_matches
          |> runtime.matches_get_one (get_args () .exception |> fst)
          |> optionm'.map (sm'.from_std_string >> sm'.trim_start [ '\\' ] >> sm'.trim_end [ '\\' ])
          |> optionm'.unbox

      := result =
          arg_matches
          |> run
          |> async.block_on_tokio
          |> resultm.map_error' sm'.format'

      ?= result |> rust.clone_rust |> resultm.unbox, exception ?|
      | Ok retries, Some exception =>
          ($'$"spiral_wasm.main / retries: {!retries} / exception: \'{!exception}\'"' : string)
          |> resultm.err |> resultm.unwrap'
      | Error _error, Some ("") =>
          ()
      | Error error, Some exception ?& error |> sm'.from_std_string |> sm'.contains exception =>
          ()
      | Error error, Some exception =>
          ($'$"spiral_wasm.main / exception: \'{!exception}\' / error: {!error}"' : string)
          |> resultm.err |> resultm.unwrap'
      | Ok _retries, _ =>
          ()
      | Error _error, _ =>
          result |> resultm.unwrap' |> ignore

      0i32
  """,
  timeout: 300_000
)
```

F#: `main` for the Fable build. Native Rust (`--backend Rust`, see build.ps1): runs `run_main` with the process
args.

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":":= main () =\n    backend_switch {\n        Fsharp = \\ () => $'let main args = !run_main args' : ()\n        Rust = \\ () =>\n            := args =\n                $'Rc::new(RefCell::new(std::env::args().skip(1).map(|x| Rc::<str>::from(x)).collect::<Vec<Rc<str>>>()))'\n                : array_base string\n            run_main args |> ignore\n    } : ()","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  := main () =
      backend_switch {
          Fsharp = \ () => $'let main args = !run_main args' : ()
          Rust = \ () =>
              := args =
                  $'Rc::new(RefCell::new(std::env::args().skip(1).map(|x| Rc::<str>::from(x)).collect::<Vec<Rc<str>>>()))'
                  : array_base string
              run_main args |> ignore
      } : ()
  """,
  timeout: 300_000
)
```
