{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "spiral",
  "rules": {
    "source_file": {
      "type": "SEQ",
      "members": [
        {
          "type": "REPEAT",
          "content": {
            "type": "SEQ",
            "members": [
              {
                "type": "CHOICE",
                "members": [
                  {
                    "type": "SYMBOL",
                    "name": "_line"
                  },
                  {
                    "type": "BLANK"
                  }
                ]
              },
              {
                "type": "SYMBOL",
                "name": "_line_break"
              }
            ]
          }
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "_line"
            },
            {
              "type": "BLANK"
            }
          ]
        }
      ]
    },
    "_line_break": {
      "type": "PATTERN",
      "value": "\\r?\\n"
    },
    "_line": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "test_header"
        },
        {
          "type": "SYMBOL",
          "name": "target_directive"
        },
        {
          "type": "SYMBOL",
          "name": "doc_comment"
        },
        {
          "type": "SYMBOL",
          "name": "line_comment"
        },
        {
          "type": "SYMBOL",
          "name": "definition_line"
        },
        {
          "type": "SYMBOL",
          "name": "indented_line"
        },
        {
          "type": "SYMBOL",
          "name": "other_line"
        }
      ]
    },
    "test_header": {
      "type": "SEQ",
      "members": [
        {
          "type": "ALIAS",
          "content": {
            "type": "TOKEN",
            "content": {
              "type": "PREC",
              "value": 6,
              "content": {
                "type": "PATTERN",
                "value": "test[ \\t]+"
              }
            }
          },
          "named": true,
          "value": "test_keyword"
        },
        {
          "type": "FIELD",
          "name": "name",
          "content": {
            "type": "ALIAS",
            "content": {
              "type": "IMMEDIATE_TOKEN",
              "content": {
                "type": "PATTERN",
                "value": "[^\\s=]+"
              }
            },
            "named": true,
            "value": "test_name"
          }
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "ALIAS",
              "content": {
                "type": "IMMEDIATE_TOKEN",
                "content": {
                  "type": "PATTERN",
                  "value": "[^\\r\\n]+"
                }
              },
              "named": true,
              "value": "test_signature"
            },
            {
              "type": "BLANK"
            }
          ]
        }
      ]
    },
    "target_directive": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 5,
        "content": {
          "type": "PATTERN",
          "value": "\\/\\/\\/>[^\\r\\n]*"
        }
      }
    },
    "doc_comment": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 4,
        "content": {
          "type": "PATTERN",
          "value": "\\/\\/\\/[^\\r\\n]*"
        }
      }
    },
    "line_comment": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 3,
        "content": {
          "type": "PATTERN",
          "value": "\\/\\/[^\\r\\n]*"
        }
      }
    },
    "definition_line": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 2,
        "content": {
          "type": "PATTERN",
          "value": "(inl|let|type|union|nominal|prototype|instance|open|and)[ \\t][^\\r\\n]*"
        }
      }
    },
    "indented_line": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 1,
        "content": {
          "type": "PATTERN",
          "value": "[ \\t]+[^\\r\\n]*"
        }
      }
    },
    "other_line": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 0,
        "content": {
          "type": "PATTERN",
          "value": "[^\\r\\n]+"
        }
      }
    }
  },
  "extras": [],
  "conflicts": [],
  "precedences": [],
  "externals": [],
  "inline": [],
  "supertypes": [],
  "reserved": {}
}