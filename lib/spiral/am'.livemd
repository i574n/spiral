### choose

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"inl choose f l =\n    (l, [])\n    ||> am.foldBack fun x acc =>\n        match f x with\n        | Some y => y :: acc\n        | None => acc\n    |> listm.toArray","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  inl choose f l =
      (l, [])
      ||> am.foldBack fun x acc =>
          match f x with
          | Some y => y :: acc
          | None => acc
      |> listm.toArray
  """,
  timeout: 300_000
)
```

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"///- --test\n///> fsharp\n///> cuda\n////> rust // v0.get_mut()[v2.get().clone() as usize] = match v1.get().clone().as_ref() { ^ expected `i32`, found `usize`\n///> typescript\n///> cuda\n\n10\n|> init\n|> fun x => a x : _ int _\n|> choose (fun x => if x % 2 = 0 then Some x else None)\n|> _assert_eq (a' ;[ 0; 2; 4; 6; 8 ])","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  ///- --test
  ///> fsharp
  ///> cuda
  ////> rust // v0.get_mut()[v2.get().clone() as usize] = match v1.get().clone().as_ref() { ^ expected `i32`, found `usize`
  ///> typescript
  ///> cuda

  10
  |> init
  |> fun x => a x : _ int _
  |> choose (fun x => if x % 2 = 0 then Some x else None)
  |> _assert_eq (a' ;[ 0; 2; 4; 6; 8 ])
  """,
  timeout: 300_000
)
```

