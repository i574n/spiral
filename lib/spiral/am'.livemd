### sort_by

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"inl sort_by forall dim el key. (fn : el -> key) (a : a dim el) : a dim el =\n    inl fable () = $'!a |> Array.sortBy !fn ' : a dim el\n    backend_switch {\n        Gleam = fun () => fable ()\n        Lua = fun () => fable ()\n        Fsharp = fun () => fable ()\n        Python = fun () =>\n            // Keys computed in Spiral: Python closures take a tuple element's fields as separate arguments.\n            inl keys = am.map fn ($'!a ' : a int el)\n            // Union keys order by case first (as in F#); Python's NamedTuple cases compare their fields only.\n            $'!a[sorted(range(len(!a)), key=lambda __i: (lambda __k: (__k.tag, __k) if hasattr(__k, \"tag\") else __k)(!keys[__i]))]' : a dim el\n        TypeScript = fun () => fable ()\n        Cpp = fun () => fable ()\n        CppHost = fun () => fable ()\n        Delphi = fun () => fable ()\n        Cuda = fun () => fable ()\n        // native Rust: a stable insertion sort (F#'s Array.sortBy is stable) by core's structural `comp`, which orders\n        // union keys by case first as F# does (codegenRust's unions derive only `Clone`: no Rust `Ord` to sort by)\n        Rust = fun () =>\n            // (as the Python arm: an int dim, which length/loopw need; sort_by's dim is unconstrained)\n            inl a = $'!a ' : a int el\n            // the copy and the keys through Rust: am.init needs a Default element, and codegenRust's unions have none;\n            // a tuple element is one Rust value (see rust.one_param_fn)\n            inl key_fn = join (rust.one_param_fn fn)\n            inl r = $'Rc::new(RefCell::new(!a.borrow().clone()))' : a int el\n            inl keys = $'Rc::new(RefCell::new(!a.borrow().iter().map(|x| !key_fn(x.clone())).collect::<Vec<_>>()))' : a int key\n            loopw.for' {from=1; nearTo=length a} fun i =>\n                inl x = index i r\n                inl k = index i keys\n                inl s = mut {j=i}\n                loopw.while (fun () => s.j > 0 && gt_is (comp (index (s.j - 1) keys) k)) fun () =>\n                    inl j = s.j\n                    set r j (index (j - 1) r)\n                    set keys j (index (j - 1) keys)\n                    s <- {j=j - 1}\n                set r s.j x\n                set keys s.j k\n            $'!r ' : a dim el\n    }","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  inl sort_by forall dim el key. (fn : el -> key) (a : a dim el) : a dim el =
      inl fable () = $'!a |> Array.sortBy !fn ' : a dim el
      backend_switch {
          Gleam = fun () => fable ()
          Lua = fun () => fable ()
          Fsharp = fun () => fable ()
          Python = fun () =>
              // Keys computed in Spiral: Python closures take a tuple element's fields as separate arguments.
              inl keys = am.map fn ($'!a ' : a int el)
              // Union keys order by case first (as in F#); Python's NamedTuple cases compare their fields only.
              $'!a[sorted(range(len(!a)), key=lambda __i: (lambda __k: (__k.tag, __k) if hasattr(__k, "tag") else __k)(!keys[__i]))]' : a dim el
          TypeScript = fun () => fable ()
          Cpp = fun () => fable ()
          CppHost = fun () => fable ()
          Delphi = fun () => fable ()
          Cuda = fun () => fable ()
          // native Rust: a stable insertion sort (F#'s Array.sortBy is stable) by core's structural `comp`, which orders
          // union keys by case first as F# does (codegenRust's unions derive only `Clone`: no Rust `Ord` to sort by)
          Rust = fun () =>
              // (as the Python arm: an int dim, which length/loopw need; sort_by's dim is unconstrained)
              inl a = $'!a ' : a int el
              // the copy and the keys through Rust: am.init needs a Default element, and codegenRust's unions have none;
              // a tuple element is one Rust value (see rust.one_param_fn)
              inl key_fn = join (rust.one_param_fn fn)
              inl r = $'Rc::new(RefCell::new(!a.borrow().clone()))' : a int el
              inl keys = $'Rc::new(RefCell::new(!a.borrow().iter().map(|x| !key_fn(x.clone())).collect::<Vec<_>>()))' : a int key
              loopw.for' {from=1; nearTo=length a} fun i =>
                  inl x = index i r
                  inl k = index i keys
                  inl s = mut {j=i}
                  loopw.while (fun () => s.j > 0 && gt_is (comp (index (s.j - 1) keys) k)) fun () =>
                      inl j = s.j
                      set r j (index (j - 1) r)
                      set keys j (index (j - 1) keys)
                      s <- {j=j - 1}
                  set r s.j x
                  set keys s.j k
              $'!r ' : a dim el
      }
  """,
  timeout: 300_000
)
```

