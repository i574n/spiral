          |> resultm.unbox
          |> fun x =>
              match acc, x |> resultm.map optionm'.unbox with
              | Ok acc, Ok (Some x) => acc |> vec_extend x |> Ok
              | _, Error error => error |> Error
              | _ => acc
  """,
