/// # am'
test am static =
    :< testing

:< rust
:< rust_operators

/// ## am'

/// ### length
:= length \* el. (a : array el) : int =
    a |> length

/// ### index
:= index \* el. (i : int) (a : array el) : el =
    backend_switch {
        Gleam = \ () => index a i
        Lua = \ () => index a i
        Fsharp = \ () => index a i
        Python = \ () => $'!a[!i]' : el
        Rust = \ () => index a i
        TypeScript = \ () => index a i
        Zig = \ () => index a i
        Lean = \ () => index a i
        C = \ () => index a i
    }

/// ### index_base
:= index_base \* el. (i : int) (ar : array_base el) : el =
    ar |> array |> index i

/// ### create_base
:= create_base \* el. (n : int) : array_base el = !!!!ArrayCreate(`el, n)

/// ### set_base
:= set_base \* el. (ar : array_base el) (i : int) (v : el) : () = !!!!ArrayIndexSet(ar, i, v)

/// ### length_base
:= length_base \* el. (ar : array_base el) : int =
    ar |> array |> length

///> rust
test base_wrappers_round_trip =
    := a : array_base i32 = create_base 3i32
    set_base a 1i32 7i32
    (;[ length_base a; index_base 1i32 a ]) |> _assert_eq (;[ 3i32; 7i32 ])

/// ### base
:= base \* el. ((array a) : array el) : array_base el =
    a

/// ### base'
:= base' \* el. ((array a) : array el) : array_base el =
    a

/// ### generic_equable
:= generic_equable x1 x2 =
    ? length x1 <>.. length x2
    ?> !-
    |:
        :~ ^ 루프 i =
            ? i < length x1
            ?> index i x1 = index i x2 && 루프 (i + 1)
            |: !+
        루프 0

/// ### equable

/// ### append
:+ append array t = arraym.append

test append =
    ()

/// ### map_base
:= map_base \* t u. (fn : t -> u) (x : array_base t) : array_base u =
    array x
    |> arraym.map fn
    |> \ (array x : array _) => x

/// ### collect
:= collect \* t r. (fn : t -> array r) (items : array t) : array r =
    items
    |> arraym.map fn
    |> arraym.fold (++) (;[])

/// ### init_base
:= init_base n fn : array_base _ =
    arraym.init n fn
    |> \ (array x : array _) => x

/// ### init
:= init n : array_base _ =
    init_base n id

/// ### choose
:= choose f l =
    (l, [])
    ||> arraym.foldBack \ x acc =>
        ?= f x ?|
        | Some y => y :: acc
        | None => acc
    |> arraym.fromList

///> fsharp
///> cuda
///> typescript
///> cuda
test choose =
    10
    |> init
    |> \ x => array x : array _
    |> choose (\ x => ? x % 2 = 0 ?> Some x |: None)
    |> _assert_eq (;[ 0; 2; 4; 6; 8 ])

/// ### sum
:= sum a =
    a |> arraym.fold (+) 0

///> fsharp
///> cuda
///> rust
///> typescript
test sum =
    10
    |> init
    |> \ x => array x : array _
    |> sum
    |> _assert_eq 45

/// ### init_series
:= init_series start end inc : array_base _ =
    := total = conv ((end - start) / inc) + 1
    arraym.init total (conv >> (*) inc >> (+) start)
    |> \ (array x : array _) => x

///> fsharp
///> cuda
///> rust
///> typescript
test init_series =
    init_series 0i32 6 2
    |> array
    |> \ x => x : array _
    |> _assert_eq (;[ 0i32; 2; 4; 6 ])

/// ### head
:= head (ar : array _) =
    ? var_is ar || length ar > 0
    ?> ar |> index 0
    |: error_type "The length of the array should be greater than 0."

/// ### last
:= last (ar : array _) =
    := len = length ar
    ? var_is ar || len > 0
    ?> ar |> index (len - 1)
    |: error_type "The length of the array should be greater than 0."

///> fsharp
///> cuda
///> rust
///> typescript
test last =
    10
    |> init
    |> \ x => array x : array _
    |> last
    |> _assert_eq 9

/// ### try_pick
:= try_pick \* t u. (fn : t -> option u) (array : array t) : option u =
    (array, None)
    ||> arraym.foldBack \ x acc =>
        ?= acc ?|
        | Some _ => acc
        | None => x |> fn

///> fsharp
///> cuda
///> typescript
///> cuda
test try_pick =
    10
    |> init
    |> \ x => array x : array _
    |> try_pick (\ x => ? x = 5i32 ?> Some x |: None)
    |> _assert_eq (Some 5i32)

/// ### indexed
:= indexed \* t u {number}. (ar : array_base t) : array_base (u * t) =
    ((0, ;[]), (array ar : array _))
    ||> arraym.fold \ (i, acc) x =>
        i + 1, acc ++ ;[i, x]
    |> snd
    |> \ (array x : array _) => x

///> fsharp
///> rust
///> typescript
///> cuda
test indexed =
    arraym.init 3i32 ((*) 2)
    |> \ (array x : array _) => x
    |> indexed
    |> _assert_eq' (base ;[0i32, 0; 1, 2; 2, 4])

/// ### slice
:= slice \* el. from nearTo s : array el =
    arraym.slice { from nearTo } s

///> fsharp
///> cuda
///> rust
///> typescript
test slice =
    := x : array _ = ;[ 1i32; 2; 3 ]
    x |> slice 0 0 |> _assert_eq (;[])
    x |> slice 0 1 |> _assert_eq (;[ 1 ])
    x |> slice 1 1 |> _assert_eq (;[])
    x |> slice 1 2 |> _assert_eq (;[ 2 ])
    x |> slice 2 2 |> _assert_eq (;[])
    x |> slice 0 2 |> _assert_eq (;[ 1; 2 ])

/// ### range
:| range dim =
    | Start : dim
    | End : (() -> dim) -> dim

:= range start end s =
    := start, end =
        := len () =
            s |> length |> conv
        ?= start, end ?|
        | Start start, End fn =>
            start, fn len
        | End start_fn, End end_fn =>
            start_fn len, end_fn len
    s |> slice (start |> convert.unbox) (end |> convert.unbox)

/// ## rust

/// ### vec
:! vec t =
    `(
        rust.rust_type
            `($'Vec<`t>')
            `($'Vec<`t>')
            "type Vec<'T> = class end"
    )

/// ### from_vec
:= from_vec \* el. (vec : vec el) : array el =
    backend_switch {
        Rust = \ () =>
            := vec = ~~ vec
            $'Rc::new(RefCell::new(!vec))' : array el
    }

/// ### from_vec_base
:= from_vec_base \* el. (vec : vec el) : array_base el =
    backend_switch {
        Rust = \ () =>
            := vec = ~~ vec
            $'Rc::new(RefCell::new(!vec))' : array_base el
    }

/// ### to_vec
:= to_vec \* t. (ab : array_base t) : vec t =
    backend_switch {
        Rust = \ () => $'(!ab).borrow().clone()' : vec t
    }

/// ### to_vec'
:= to_vec' \* (t : * -> * -> *) u v. (x : t u v) : vec u =
    backend_switch {
        Rust = \ () => $'(!x).clone()' : vec u
    }

/// ### to_vec''
:= to_vec'' \* (t : * -> *) (u : * -> *) v. (x : t (u v)) : vec v =
    backend_switch {
        Rust = \ () => $'(!x).to_vec()' : vec v
    }

/// ### to_vec'''
:= to_vec''' \* t. (ab : array_base t) : vec t =
    !\\(ab, $'"to_vec($0)"')

/// ### vec_push
:= vec_push \* el. (el : el) (vec : vec el) : vec el =
    := el = ~~ el
    := vec = ~~ vec
    (!\($'"true; let mut !vec = !vec"') : bool) |> ignore
    (!\($'"true; !vec.push(!el)"') : bool) |> ignore
    !\($'"!vec"')

/// ### vec_reverse
:= vec_reverse \* el. (vec : vec el) : vec el =
    := vec = ~~ vec
    (!\($'"true; let mut !vec = !vec"') : bool) |> ignore
    (!\($'"true; !vec.reverse()"') : bool) |> ignore
    !\($'"!vec"')

/// ### vec_retain
:= vec_retain \* el. (fn : el -> bool) (vec : vec el) : vec el =
    := vec = ~~ vec
    := fn = ~~ fn
    (!\($'"true; let mut !vec = !vec"') : bool) |> ignore
    (!\($'"true; !vec.retain(|x| !fn(x.clone()))"') : bool) |> ignore
    !\($'"!vec"')

/// ### vec_sort_by_key
:= vec_sort_by_key \* el t. (fn : el -> t) (vec : vec el) : vec el =
    := vec = ~~ vec
    := fn = rust.one_param_fn fn
    := fn = ~~ fn
    (!\($'"true; let mut !vec = !vec"') : bool) |> ignore
    (!\($'"true; !vec.sort_by_key(|x| !fn(x.clone()))"') : bool) |> ignore
    !\($'"!vec"')

/// ### vec_extend
:= vec_extend \* el. (el : vec el) (vec : vec el) : vec el =
    := el = ~~ el
    := vec = ~~ vec
    (!\($'"true; let mut !vec = !vec"') : bool) |> ignore
    (!\($'"true; !vec.extend(!el)"') : bool) |> ignore
    !\($'"!vec"')

/// ### vec_mapi
:= vec_mapi \* dim t u. (fn : dim -> t -> u) (ar : vec t) : vec u =
    := fn i = rust.one_param_fn (fn i)
    := fn = ~~ fn
    := ar = ~~ ar
    !\($'"!ar.iter().enumerate().map(|(i, x)| !fn(i.try_into().unwrap())(x.clone())).collect::<Vec<_>>()"')

/// ### vec_map
:= vec_map \* t u. (fn : t -> u) (ar : vec t) : vec u =
    := fn = rust.one_param_fn fn
    !\\((ar, fn), $'"$0.iter().map(|x| $1(x.clone())).collect::<Vec<_>>()"')

/// ### vec_map'
:= vec_map' \* t u. (fn : t -> u) (ar : vec t) : vec u =
    := fn = rust.one_param_fn fn
    !\\((ar, fn), $'"$0.iter().map(|x| $1(x.clone())).collect::<Vec<_>>()"')

/// ### vec_fold'
:= vec_fold' \* t u. (fn : u -> t -> u) (init : u) (ar : vec t) : u =
    (!\\(ar, $'"true; let _vec_fold_ = $0.into_iter().fold(!init, |acc, x| { //"') : bool) |> ignore
    (!\\(fn !\($'"acc"') !\($'"x"'), $'"true; $0 })"') : bool) |> ignore
    !\($'"_vec_fold_"')

/// ### vec_for_each
:= vec_for_each \* t. (fn : t -> ()) (ar : vec t) : () =
    (!\\((ar, fn), $'"true; $0.iter().for_each(|x| { $1(x.clone()); }); //"') : bool) |> ignore

/// ### vec_for_each'
:= vec_for_each' \* t. (fn : t -> ()) (ar : vec t) : () =
    (!\\(ar, $'"true; $0.into_iter().for_each(|x| { //"') : bool) |> ignore
    (!\\(fn !\($'"x"'), $'$"true"') : bool) |> ignore
    (!\($'"true; }}); //"') : bool) |> ignore

/// ### vec_for_each''
:= vec_for_each'' \* t. (fn : t -> ()) (ar : vec t) : () =
    (!\\(ar, $'"true; $0.into_iter().for_each(|x| { //"') : bool) |> ignore
    (!\\(fn !\($'"x"'), $'$"true"') : bool) |> ignore
    (!\($'"true; }}); //"') : bool) |> ignore

/// ### vec_for_each'''
:= vec_for_each''' \* t. (fn : t -> ()) (ar : vec t) : () =
    (!\\(ar, $'"true; $0.into_iter().for_each(|x| { //"') : bool) |> ignore
    (!\\(fn !\($'"x"'), $'$"true"') : bool) |> ignore
    (!\($'"true; }); //"') : bool) |> ignore

/// ### vec_filter
:= vec_filter \* t. (fn : t -> bool) (ar : vec t) : vec t =
    := fn = rust.one_param_fn fn
    !\\((ar, fn), $'"$0.iter().filter(|x| $1((*x).clone())).cloned().collect::<Vec<_>>()"')

/// ### vec_len
:= vec_len \* t. (vec : vec t) : convert.unativeint =
    backend_switch {
        Rust = \ () => $'((!vec).len() as usize)' : convert.unativeint
    }

/// ### vec_chunks
:= vec_chunks \* t. (n : i32) (vec : vec t) : vec (vec t) =
    !\\(vec, $'"$0.chunks(!n).map(|x| x.into_iter().map(|x| x.clone()).collect::<Vec<_>>()).collect::<Vec<_>>()"')

/// ### slice
:! slice t =
    `(
        rust.rust_type
            `($'Slice<`t>')
            `($'[`t]')
            "type Slice<'T> = class end"
    )

/// ### slice'
:== slice'_switch el =
    {
        Gleam : $'Slice\'<`el>'
        Lua : $'Slice\'<`el>'
        Fsharp : $'Slice\'<`el>'
        Python : $'Slice\'<`el>'
        TypeScript : $'Slice\'<`el>'
        Cpp : $'Slice\'<`el>'
        CppHost : $'Slice\'<`el>'
        Delphi : $'Slice\'<`el>'
        Cuda : $'Slice\'<`el>'
        Rust : $'_'
    }
:! slice' el dim =
    `(
        rust.fsharp_global "type Slice'<'T> = class end"
        $'' : $'backend_switch `(slice'_switch el)'
    )

/// ### slice''
:! slice'' el dim =
    `(
        rust.rust_type
            `($'Slice\'_<`el>')
            `($'[`el; 10]')
            "type Slice'_<'T> = class end"
    )

/// ### slice_singleton
:= slice_singleton \* dim el. (x : option el) : slice' el dim =
    ?= x ?|
    | Some x => !\($'"[!x]"')
    | None =>
        !\($'"[\\\"\\\".to_string()]"') : slice' el dim

/// ### slice_length
:= slice_length \* t dim. (x : slice' t dim) : convert.unativeint =
    !\($'"!x.len()"')

/// ### slice_range
:= slice_range \* t dim.
    (start : range t) (end : range t) (s : slice' t dim) : rust.ref (slice' t dim)
    =
    := len () =
        s |> slice_length
    := start, (end : convert.unativeint) =
        ?= start, end ?|
        | Start start, End fn => start, (len >> convert.convert) |> fn |> convert.convert
        | End start_fn, End end_fn =>
            (len >> convert.convert) |> start_fn, (len >> convert.convert) |> end_fn |> convert.convert
    ?= start, end ?|
    | start, end ?& end |> convert.unbox =. len () => !\($'"&!s[!start..]"')
    | start, end => !\\((start, end), $'"&!s[$0..$1]"')

/// ### new_slice
:= new_slice \* el dim. (el : el) : slice' el dim =
    !\\(el, $'"[$0; @dim as usize]"')

/// ### as_slice
:= as_slice \* t. (x : array_base t) : rust.ref (slice t) =
    := x = x |> to_vec
    !\($'"!x.as_slice()"')

/// ### slice_to_vec
:= slice_to_vec \* t. (slice : rust.ref (slice t)) : vec t =
    !\\(slice, $'"$0.iter().map(|x| *x).collect::<Vec<_>>()"')

/// ### to_le_bytes
:= to_le_bytes \* t. (x : t) : slice' u8 8 =
    backend_switch {
        Rust = \ () => $'(!x).to_le_bytes().to_vec()' : slice' u8 8
    }

/// ### as_bytes
:= as_bytes \* t. (x : t) : rust.ref (slice u8) =
    backend_switch {
        Rust = \ () => $'(!x).as_bytes()' : rust.ref (slice u8)
    }

/// ### any
:= any \* t. (fn : t -> bool) (source : array_base t) : bool =
    := n = source |> array |> length
    :~ ^ loop i =
        ? i >= n ?> !-
        |? source |> index_base i |> fn ?> !+
        |: loop (i + 1)
    loop 0

///> rust
///> fsharp
///> typescript
test any =
    := source = init 5
    (source |> any (\ x => x = 3), source |> any (\ x => x > 10)) |> _assert_eq (!+, !-)

/// ### iter_collect vec
:+ iter_collect vec = \ (iter : into_iterator u) =>
    !\\(iter, $'"$0.collect::<Vec<_>>()"')

:+ iter_collect'' vec = \ (iter : into_iterator (t (u v))) =>
    !\\(iter, $'"$0.collect::<Vec<_>>()"')

/// ### new_vec
:= new_vec \* t. (items : list t) : vec t =
    backend_switch {
        Rust = \ () => items |> listm.fold (\ v x => vec_push x v) ($'Vec::new()' : vec t)
    }

///> rust
test new_vec =
    [ 0i32; 1 ]
    |> new_vec
    |> sm'.format_debug'
    |> sm'.from_std_string
    |> _assert_eq "[0, 1]"

///> rust
test new_vec_keeps_a_list_built_at_runtime =
    :~ ^ build (n : i32) (acc : list i32) : list i32 = ? n <= 0i32 ?> acc |: build (n - 1i32) (n :: acc)
    := ~count = 3i32
    build count [] |> new_vec |> vec_len |> convert.i32 |> _assert_eq 3i32

/// ## fsharp

/// ### average
:= average \* el {number}. (a : array el) : el =
    run_target \|
        | Fsharp => \ () => $'!a |> Array.average' : el
        | _ => \ () => arraym.fold (+) 0 a / conv (length a)

///> fsharp
///> rust
test average_divides_the_sum_by_the_count =
    ;[ 1.0f64; 2.0f64; 4.5f64 ] |> average |> _assert_eq 2.5f64

/// ### distinct
:= distinct \* el. (a : array el) : array el =
    ? is_rust () ?>
        := a = $'!a ' : array el
        := r = $'Rc::new(RefCell::new(Vec::with_capacity(!a.borrow().len())))' : array el
        loop.for' { from = 0; nearTo = length a } \ i =>
            := x = index i a
            := n = length r
            := s = mut { j = 0 }
            loop.while' (\ () => s.j < n && index s.j r <> x) \ () =>
                s <- { j = s.j + 1 }
            ? s.j = n ?> $'!r.borrow_mut().push(!x)' : ()
        $'!r ' : array el
    |: $'!a |> Array.distinct'

:= growable \* el. () : array el =
    run_target \|
        | Rust => \ () => $'Rc::new(RefCell::new(Vec::new()))' : array el
        | _ => \ () => failwith "growable: no arm for this backend"

:= push_back \* el. (item : el) (items : array el) : () =
    run_target \|
        | Rust => \ () => $'(!items).borrow_mut().push(!item)' : ()
        | _ => \ () => failwith "push_back: no arm for this backend"

/// ### skip
:= skip \* el. (n : int) (a : array el) : array el =
    run_target \|
        | Rust => fun () => $'Rc::new(RefCell::new((!a).borrow().iter().skip((!n) as \
            usize).cloned().collect::<Vec<_>>()))' : array el
        | Zig => \ () => $'(spiral_gpa.dupe(`el, (!a)[\@intCast(!n)..]) catch \@panic("out of memory"))' : array el
        | _ => \ () => $'!a |> Array.skip !n '

/// ### skip_while
:= skip_while \* el. (fn : el -> bool) (a : array el) : array el =
    ? is_rust ()
    ?> $'Rc::new(RefCell::new((!a).borrow().iter().skip_while(|x| (!fn)((*x).clone())).cloned().collect::<Vec<_>>()))'
    |: $'!a |> Array.skipWhile !fn '

/// ### to_list_base'
:= to_list_base' \* t. (items : array_base t) : listm'.list' t =
    backend_switch {
        Gleam = \ () => $'!items |> spiral_array_to_list' : listm'.list' t
        Lua = \ () =>
            := len = $'##(!items)' : i32
            := r : array t = arraym.init len \ i =>
                := at = i + 1i32
                $'!items[!at]' : t
            := (array r) = r
            $'!r ' : listm'.list' t
        Fsharp = \ () => $'!items |> Array.toList' : listm'.list' t
        Python = \ () => $'list(!items)' : listm'.list' t
        Rust = \ () => $'Rc::new((!items).borrow().clone())' : listm'.list' t
        TypeScript = \ () => $'[...!items]' : listm'.list' t
        Zig = \ () => $'!items ' : listm'.list' t
    }

/// ### to_list'
:= to_list' \* t. (items : array t) : listm'.list' t =
    items |> base |> to_list_base'

///> fsharp
///> cuda
///> rust
///> typescript
test to_list =
    ;[ -3i32; 6 ]
    |> to_list'
    |> listm'.unbox
    |> _assert_eq [ -3; 6 ]

///> lua
///> python
///> rust
///> typescript
test to_list_snapshots_the_array =
    := source = ;[ 1i32; 2i32; 3i32 ]
    := snapshot = to_list' source
    set source 0i32 9i32
    snapshot |> listm'.unbox |> _assert_eq [ 1i32; 2i32; 3i32 ]

/// ### vec_collect
:= vec_collect fn vec =
    ((;[] |> base |> to_vec), ((vec |> from_vec : array _) |> to_list' |> listm'.unbox))
    ||> listm.fold \ acc x =>
        acc |> vec_extend (fn x)

/// ### vec_collect_option
:= vec_collect_option vec =
    ((;[] |> base |> to_vec |> Ok), ((vec |> from_vec : array _) |> arraym.toList))
    ||> listm.fold \ acc x =>
        x
        |> resultm.unbox
        |> \ x =>
            ?= acc, x |> resultm.map optionm'.unbox ?|
            | Ok acc, Ok (Some x) => acc |> vec_extend x |> Ok
            | _, Error error => error |> Error
            | _ => acc

/// ### vec_collect_into
:= vec_collect_into \* (c : * -> * -> *) t e.
    (x : vec (c t e))
    : c (vec t) e
    =
    !\($'"!x.into_iter().collect()"')

/// ### parallel_map
:= parallel_map \* el el'. (fn : el -> el') (a : array el) : array el' =
    run_target \|
        | Fsharp => \ () => $'!a |> Array.Parallel.map !fn ' : array el'
        | _ => \ () => arraym.map fn a

/// ### map'
:= map' \* el el'. (fn : el -> el') (a : array el) : array el' =
    run_target \|
        | Fsharp => \ () => $'!a |> Array.map !fn ' : array el'
        | _ => \ () => arraym.map fn a

/// ### sort_by
:= sort_by \* el key. (fn : el -> key) (a : array el) : array el =
    := fsharp () = $'!a |> Array.sortBy !fn ' : array el
    := insertion_sort () =
        := r = arraym.map id ($'!a ' : array el)
        := keys = arraym.map fn ($'!a ' : array el)
        loop.for' { from = 1; nearTo = length r } \ i =>
            := x = index i r
            := k = index i keys
            := s = mut { j = i }
            loop.while' (\ () => s.j > 0 && gt_is (comp (index (s.j - 1) keys) k)) \ () =>
                := j = s.j
                set r j (index (j - 1) r)
                set keys j (index (j - 1) keys)
                s <- { j = j - 1 }
            set r s.j x
            set keys s.j k
        $'!r ' : array el
    backend_switch {
        Gleam = \ () => fsharp ()
        Lua = insertion_sort
        Fsharp = \ () => fsharp ()
        Python = \ () =>
            := keys = arraym.map fn ($'!a ' : array el)
            $'!a[sorted(range(len(!a)), key=lambda __i: (lambda __k: (__k.tag, __k) if hasattr(__k, "tag") else \
                __k)(!keys[__i]))]' : array el
        TypeScript = \ () =>
            := keys = arraym.map fn ($'!a ' : array el)
            global (
                "function spiral_compare(a: any, b: any): number { if (typeof a === 'object' && a !== null && "
                ^^ "typeof b === 'object' && b !== null) { if (Array.isArray(a)) { for (let i = 0; i < "
                ^^ "Math.min(a.length, b.length); i++) { const c = spiral_compare(a[i], b[i]); if (c !== 0) return c; "
                ^^ "} return a.length - b.length; } if (a.tag !== b.tag) return a.tag - b.tag; for (const k of "
                ^^ "Object.keys(a)) { if (k === 'tag') continue; const c = spiral_compare(a[k], b[k]); if (c !== 0) "
                ^^ "return c; } return 0; } return a < b ? -1 : a > b ? 1 : 0; }"
            )
            $'!a.map((_x: any, i: number) => i).sort((i: number, j: number) => spiral_compare(!keys[i], \
                !keys[j])).map((i: number) => !a[i])' : array el
        Cpp = \ () => fsharp ()
        CppHost = \ () => fsharp ()
        Delphi = \ () => fsharp ()
        Cuda = \ () => fsharp ()
        Zig = insertion_sort
        Lean = insertion_sort
        Rust = \ () =>
            := a = $'!a ' : array el
            := key_fn = ~~ (rust.one_param_fn fn)
            := r = $'Rc::new(RefCell::new(!a.borrow().clone()))' : array el
            := keys =
                $'Rc::new(RefCell::new(!a.borrow().iter().map(|x| !key_fn(x.clone())).collect::<Vec<_>>()))' : array key
            loop.for' { from = 1; nearTo = length a } \ i =>
                := x = index i r
                := k = index i keys
                := s = mut { j = i }
                loop.while' (\ () => s.j > 0 && gt_is (comp (index (s.j - 1) keys) k)) \ () =>
                    := j = s.j
                    set r j (index (j - 1) r)
                    set keys j (index (j - 1) keys)
                    s <- { j = j - 1 }
                set r s.j x
                set keys s.j k
            $'!r ' : array el
    }

/// ### sort
:= sort \* el. (a : array el) : array el =
    run_target \|
        | Fsharp => \ () => $'!a |> Array.sort'
        | _ => \ () => sort_by id a

/// ### sort_descending
:= sort_descending \* el. (a : array el) : array el =
    run_target \|
        | Fsharp => \ () => $'!a |> Array.sortDescending'
        | _ => \ () =>
            := ascending = sort a
            := n = length ascending
            arraym.init n \ i => index (n - 1 - i) ascending

///> rust
///> fsharp
///> python
///> typescript
///> lua
test sort_orders_on_every_backend =
    := a = ;[ 3i32; 1i32; 2i32 ]
    := ascending = sort a
    ? index 0 ascending <> 1i32 || index 2 ascending <> 3i32 ?> failwith "ascending"
    := descending = sort_descending a
    ? index 0 descending <> 3i32 || index 2 descending <> 1i32 ?> failwith "descending"

/// ### transpose
:= transpose \* el. (a : array_base (array_base el)) : array_base (array_base el) =
    run_target \|
        | Fsharp => \ () => $'!a |> Array.transpose' : array_base (array_base el)
        | _ => \ () =>
            := rows : array (array_base el) = array a
            := height : int = length rows
            := width : int = ? height = 0 ?> 0 |: length (array (index 0 rows) : array el)
            arraym.init width (\ (c : int) =>
                arraym.init height (\ (r : int) => index c (array (index r rows) : array el))
                |> \ (array column : array el) => column
            )
            |> \ (array result : array (array_base el)) => result

///> fsharp
///> rust
test transpose_swaps_rows_and_columns =
    := row = \ (cells : array i32) => cells |> \ (array x : array i32) => x
    := rows : array (array_base i32) = ;[ row ;[ 1i32; 2i32; 3i32 ]; row ;[ 4i32; 5i32; 6i32 ] ]
    := flipped : array (array_base i32) = array (rows |> \ (array x : array (array_base i32)) => x |> transpose)
    := last : array i32 = array (index 2 flipped)
    (length flipped, index 0 last, index 1 last) |> _assert_eq (3, 3i32, 6i32)

/// ### try_item
:= try_item \* el. (i : i32) (a : array el) : option el =
    := fsharp () : option el = $'!a |> Array.tryItem !i ' |> optionm'.unbox
    := in_bounds_item () : option el =
        := a = $'!a ' : array el
        ? i >= 0 && i < length a ?> Some (index i a) |: None
    backend_switch {
        Gleam = fsharp
        Lua = fsharp
        Fsharp = fsharp
        Python = fsharp
        TypeScript = fsharp
        Cpp = fsharp
        CppHost = fsharp
        Delphi = fsharp
        Cuda = fsharp
        Zig = in_bounds_item
        Lean = in_bounds_item
        Rust = in_bounds_item
    }

///> rust
///> zig
///> fsharp
test try_item_is_none_out_of_bounds =
    := a = ;[ 10i32; 20i32 ]
    := code (i : i32) : i32 = ?= try_item i a ?| | Some x => x | None => -1i32
    [ code (-1i32); code 0i32; code 1i32; code 2i32 ] |> _assert_eq [ -1i32; 10i32; 20i32; -1i32 ]
