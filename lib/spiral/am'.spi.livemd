<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":":= average \\* el {number}. (a : array el) : el =\n    run_target \\|\n        | Fsharp => \\ () => $'!a |> Array.average' : el\n        | _ => \\ () => arraym::fold (+) 0 a / conv (length a)","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  := average \* el {number}. (a : array el) : el =
      run_target \|
          | Fsharp => \ () => $'!a |> Array.average' : el
          | _ => \ () => arraym::fold (+) 0 a / conv (length a)
  """,
  timeout: 300_000
)
```

#### average_divides_the_sum_by_the_count (test)

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":"///- --test --symbol\n///> rust\n\n;[ 1.0f64; 2.0f64; 4.5f64 ] |> average |> _assert_eq 2.5f64","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  ///- --test --symbol
  ///> rust

  ;[ 1.0f64; 2.0f64; 4.5f64 ] |> average |> _assert_eq 2.5f64
  """,
  timeout: 300_000
)
```

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":":= distinct \\* el. (a : array el) : array el =\n    ? is_rust () ?>\n        := a = $'!a ' : array el\n        := r = $'Rc::new(RefCell::new(Vec::with_capacity(!a.borrow().len())))' : array el\n        loop::for' { from = 0; nearTo = length a } \\ i =>\n            := x = index i a\n            := n = length r\n            := s = mut { j = 0 }\n            loop::while' (\\ () => s::j < n && index s::j r <> x) \\ () =>\n                s <- { j = s::j + 1 }\n            ? s::j = n ?> $'!r.borrow_mut().push(!x)' : ()\n        $'!r ' : array el\n    |: $'!a |> Array.distinct'\n\n:= growable \\* el. () : array el =\n    run_target \\|\n        | Rust => \\ () => $'Rc::new(RefCell::new(Vec::new()))' : array el\n        | _ => \\ () => failwith \"growable: no arm for this backend\"\n\n:= push_back \\* el. (item : el) (items : array el) : () =\n    run_target \\|\n        | Rust => \\ () => $'(!items).borrow_mut().push(!item)' : ()\n        | _ => \\ () => failwith \"push_back: no arm for this backend\"\n\n:= skip \\* el. (n : int) (a : array el) : array el =\n    run_target \\|\n        | Rust => fun () => $'Rc::new(RefCell::new((!a).borrow().iter().skip((!n) as \\\n            usize).cloned().collect::<Vec<_>>()))' : array el\n        | Zig => \\ () => $'(spiral_gpa.dupe(`el, (!a)[@@intCast(!n)..]) catch @@panic(\"out of memory\"))' : array el\n        | _ => \\ () => $'!a |> Array.skip !n '\n\n:= skip_while \\* el. (fn : el -> bool) (a : array el) : array el =\n    ? is_rust ()\n    ?> $'Rc::new(RefCell::new((!a).borrow().iter().skip_while(|x| (!fn)((*x).clone())).cloned().collect::<Vec<_>>()))'\n    |: $'!a |> Array.skipWhile !fn '\n\n:= to_list_base' \\* t. (items : array_base t) : listm'::list' t =\n    backend_switch {\n        Gleam = \\ () => $'!items |> spiral_array_to_list' : listm'::list' t\n        Lua = \\ () =>\n            := len = $'##(!items)' : i32\n            := r : array t = arraym::init len \\ i =>\n                := at = i + 1i32\n                $'!items[!at]' : t\n            := (array r) = r\n            $'!r ' : listm'::list' t\n        Fsharp = \\ () => $'!items |> Array.toList' : listm'::list' t\n        Python = \\ () => $'list(!items)' : listm'::list' t\n        Rust = \\ () => $'Rc::new((!items).borrow().clone())' : listm'::list' t\n        TypeScript = \\ () => $'[...!items]' : listm'::list' t\n        Zig = \\ () => $'!items ' : listm'::list' t\n    }\n\n:= to_list' \\* t. (items : array t) : listm'::list' t =\n    items |> base |> to_list_base'","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  := distinct \* el. (a : array el) : array el =
      ? is_rust () ?>
          := a = $'!a ' : array el
          := r = $'Rc::new(RefCell::new(Vec::with_capacity(!a.borrow().len())))' : array el
          loop::for' { from = 0; nearTo = length a } \ i =>
              := x = index i a
              := n = length r
              := s = mut { j = 0 }
              loop::while' (\ () => s::j < n && index s::j r <> x) \ () =>
                  s <- { j = s::j + 1 }
              ? s::j = n ?> $'!r.borrow_mut().push(!x)' : ()
          $'!r ' : array el
      |: $'!a |> Array.distinct'

  := growable \* el. () : array el =
      run_target \|
          | Rust => \ () => $'Rc::new(RefCell::new(Vec::new()))' : array el
          | _ => \ () => failwith "growable: no arm for this backend"

  := push_back \* el. (item : el) (items : array el) : () =
      run_target \|
          | Rust => \ () => $'(!items).borrow_mut().push(!item)' : ()
          | _ => \ () => failwith "push_back: no arm for this backend"

  := skip \* el. (n : int) (a : array el) : array el =
      run_target \|
          | Rust => fun () => $'Rc::new(RefCell::new((!a).borrow().iter().skip((!n) as \
              usize).cloned().collect::<Vec<_>>()))' : array el
          | Zig => \ () => $'(spiral_gpa.dupe(`el, (!a)[@@intCast(!n)..]) catch @@panic("out of memory"))' : array el
          | _ => \ () => $'!a |> Array.skip !n '

  := skip_while \* el. (fn : el -> bool) (a : array el) : array el =
      ? is_rust ()
      ?> $'Rc::new(RefCell::new((!a).borrow().iter().skip_while(|x| (!fn)((*x).clone())).cloned().collect::<Vec<_>>()))'
      |: $'!a |> Array.skipWhile !fn '

  := to_list_base' \* t. (items : array_base t) : listm'::list' t =
      backend_switch {
          Gleam = \ () => $'!items |> spiral_array_to_list' : listm'::list' t
          Lua = \ () =>
              := len = $'##(!items)' : i32
              := r : array t = arraym::init len \ i =>
                  := at = i + 1i32
                  $'!items[!at]' : t
              := (array r) = r
              $'!r ' : listm'::list' t
          Fsharp = \ () => $'!items |> Array.toList' : listm'::list' t
          Python = \ () => $'list(!items)' : listm'::list' t
          Rust = \ () => $'Rc::new((!items).borrow().clone())' : listm'::list' t
          TypeScript = \ () => $'[...!items]' : listm'::list' t
          Zig = \ () => $'!items ' : listm'::list' t
      }

  := to_list' \* t. (items : array t) : listm'::list' t =
      items |> base |> to_list_base'
  """,
  timeout: 300_000
)
```

