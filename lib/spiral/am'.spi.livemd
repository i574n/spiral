#### slice (test)

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":"///- --test --symbol\n///> fsharp\n///> cuda\n///> rust\n///> typescript\n\n:= x : array _ = ;[ 1i32; 2; 3 ]\nx |> slice 0 0 |> _assert_eq (;[])\nx |> slice 0 1 |> _assert_eq (;[ 1 ])\nx |> slice 1 1 |> _assert_eq (;[])\nx |> slice 1 2 |> _assert_eq (;[ 2 ])\nx |> slice 2 2 |> _assert_eq (;[])\nx |> slice 0 2 |> _assert_eq (;[ 1; 2 ])","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  ///- --test --symbol
  ///> fsharp
  ///> cuda
  ///> rust
  ///> typescript

  := x : array _ = ;[ 1i32; 2; 3 ]
  x |> slice 0 0 |> _assert_eq (;[])
  x |> slice 0 1 |> _assert_eq (;[ 1 ])
  x |> slice 1 1 |> _assert_eq (;[])
  x |> slice 1 2 |> _assert_eq (;[ 2 ])
  x |> slice 2 2 |> _assert_eq (;[])
  x |> slice 0 2 |> _assert_eq (;[ 1; 2 ])
  """,
  timeout: 300_000
)
```

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":":| range dim =\n    | Start : dim\n    | End : (() -> dim) -> dim\n\n:= range start end s =\n    := start, end =\n        := len () =\n            s |> length |> conv\n        ?= start, end ?|\n        | Start start, End fn =>\n            start, fn len\n        | End start_fn, End end_fn =>\n            start_fn len, end_fn len\n    s |> slice (start |> convert::unbox) (end |> convert::unbox)","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  :| range dim =
      | Start : dim
      | End : (() -> dim) -> dim

  := range start end s =
      := start, end =
          := len () =
              s |> length |> conv
          ?= start, end ?|
          | Start start, End fn =>
              start, fn len
          | End start_fn, End end_fn =>
              start_fn len, end_fn len
      s |> slice (start |> convert::unbox) (end |> convert::unbox)
  """,
  timeout: 300_000
)
```

## rust

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":":! vec t =\n    `(\n        rust::rust_type\n            `($'Vec<`t>')\n            `($'Vec<`t>')\n            \"type Vec<'T> = class end\"\n    )\n\n:= from_vec \\* el. (vec : vec el) : array el =\n    backend_switch {\n        Rust = \\ () =>\n            := vec = ~~ vec\n            $'Rc::new(RefCell::new(!vec))' : array el\n    }\n\n:= from_vec_base \\* el. (vec : vec el) : array_base el =\n    backend_switch {\n        Rust = \\ () =>\n            := vec = ~~ vec\n            $'Rc::new(RefCell::new(!vec))' : array_base el\n    }\n\n:= to_vec \\* t. (ab : array_base t) : vec t =\n    backend_switch {\n        Rust = \\ () => $'(!ab).borrow().clone()' : vec t\n    }\n\n:= to_vec' \\* (t : * -> * -> *) u v. (x : t u v) : vec u =\n    backend_switch {\n        Rust = \\ () => $'(!x).clone()' : vec u\n    }\n\n:= to_vec'' \\* (t : * -> *) (u : * -> *) v. (x : t (u v)) : vec v =\n    backend_switch {\n        Rust = \\ () => $'(!x).to_vec()' : vec v\n    }\n\n:= to_vec''' \\* t. (ab : array_base t) : vec t =\n    !\\\\(ab, $'\"to_vec($0)\"')\n\n:= vec_push \\* el. (el : el) (vec : vec el) : vec el =\n    := el = ~~ el\n    := vec = ~~ vec\n    (!\\($'\"true; let mut !vec = !vec\"') : bool) |> ignore\n    (!\\($'\"true; !vec.push(!el)\"') : bool) |> ignore\n    !\\($'\"!vec\"')\n\n:= vec_reverse \\* el. (vec : vec el) : vec el =\n    := vec = ~~ vec\n    (!\\($'\"true; let mut !vec = !vec\"') : bool) |> ignore\n    (!\\($'\"true; !vec.reverse()\"') : bool) |> ignore\n    !\\($'\"!vec\"')\n\n:= vec_retain \\* el. (fn : el -> bool) (vec : vec el) : vec el =\n    := vec = ~~ vec\n    := fn = ~~ fn\n    (!\\($'\"true; let mut !vec = !vec\"') : bool) |> ignore\n    (!\\($'\"true; !vec.retain(|x| !fn(x.clone()))\"') : bool) |> ignore\n    !\\($'\"!vec\"')\n\n:= vec_sort_by_key \\* el t. (fn : el -> t) (vec : vec el) : vec el =\n    := vec = ~~ vec\n    := fn = rust::one_param_fn fn\n    := fn = ~~ fn\n    (!\\($'\"true; let mut !vec = !vec\"') : bool) |> ignore\n    (!\\($'\"true; !vec.sort_by_key(|x| !fn(x.clone()))\"') : bool) |> ignore\n    !\\($'\"!vec\"')\n\n:= vec_extend \\* el. (el : vec el) (vec : vec el) : vec el =\n    := el = ~~ el\n    := vec = ~~ vec\n    (!\\($'\"true; let mut !vec = !vec\"') : bool) |> ignore\n    (!\\($'\"true; !vec.extend(!el)\"') : bool) |> ignore\n    !\\($'\"!vec\"')\n\n:= vec_mapi \\* dim t u. (fn : dim -> t -> u) (ar : vec t) : vec u =\n    := fn i = rust::one_param_fn (fn i)\n    := fn = ~~ fn\n    := ar = ~~ ar\n    !\\($'\"!ar.iter().enumerate().map(|(i, x)| !fn(i.try_into().unwrap())(x.clone())).collect::<Vec<_>>()\"')\n\n:= vec_map \\* t u. (fn : t -> u) (ar : vec t) : vec u =\n    := fn = rust::one_param_fn fn\n    !\\\\((ar, fn), $'\"$0.iter().map(|x| $1(x.clone())).collect::<Vec<_>>()\"')\n\n:= vec_map' \\* t u. (fn : t -> u) (ar : vec t) : vec u =\n    := fn = rust::one_param_fn fn\n    !\\\\((ar, fn), $'\"$0.iter().map(|x| $1(x.clone())).collect::<Vec<_>>()\"')\n\n:= vec_fold' \\* t u. (fn : u -> t -> u) (init : u) (ar : vec t) : u =\n    (!\\\\(ar, $'\"true; let _vec_fold_ = $0.into_iter().fold(!init, |acc, x| { //\"') : bool) |> ignore\n    (!\\\\(fn !\\($'\"acc\"') !\\($'\"x\"'), $'\"true; $0 })\"') : bool) |> ignore\n    !\\($'\"_vec_fold_\"')\n\n:= vec_for_each \\* t. (fn : t -> ()) (ar : vec t) : () =\n    (!\\\\((ar, fn), $'\"true; $0.iter().for_each(|x| { $1(x.clone()); }); //\"') : bool) |> ignore\n\n:= vec_for_each' \\* t. (fn : t -> ()) (ar : vec t) : () =\n    (!\\\\(ar, $'\"true; $0.into_iter().for_each(|x| { //\"') : bool) |> ignore\n    (!\\\\(fn !\\($'\"x\"'), $'$\"true\"') : bool) |> ignore\n    (!\\($'\"true; }}); //\"') : bool) |> ignore\n\n:= vec_for_each'' \\* t. (fn : t -> ()) (ar : vec t) : () =\n    (!\\\\(ar, $'\"true; $0.into_iter().for_each(|x| { //\"') : bool) |> ignore\n    (!\\\\(fn !\\($'\"x\"'), $'$\"true\"') : bool) |> ignore\n    (!\\($'\"true; }}); //\"') : bool) |> ignore\n\n:= vec_for_each''' \\* t. (fn : t -> ()) (ar : vec t) : () =\n    (!\\\\(ar, $'\"true; $0.into_iter().for_each(|x| { //\"') : bool) |> ignore\n    (!\\\\(fn !\\($'\"x\"'), $'$\"true\"') : bool) |> ignore\n    (!\\($'\"true; }); //\"') : bool) |> ignore\n\n:= vec_filter \\* t. (fn : t -> bool) (ar : vec t) : vec t =\n    := fn = rust::one_param_fn fn\n    !\\\\((ar, fn), $'\"$0.iter().filter(|x| $1((*x).clone())).cloned().collect::<Vec<_>>()\"')\n\n:= vec_len \\* t. (vec : vec t) : convert::unativeint =\n    backend_switch {\n        Rust = \\ () => $'((!vec).len() as usize)' : convert::unativeint\n    }\n\n:= vec_chunks \\* t. (n : i32) (vec : vec t) : vec (vec t) =\n    !\\\\(vec, $'\"$0.chunks(!n).map(|x| x.into_iter().map(|x| x.clone()).collect::<Vec<_>>()).collect::<Vec<_>>()\"')\n\n:! slice t =\n    `(\n        rust::rust_type\n            `($'Slice<`t>')\n            `($'[`t]')\n            \"type Slice<'T> = class end\"\n    )\n\n:== slice'_switch el =\n    {\n        Gleam : $'Slice\\'<`el>'\n        Lua : $'Slice\\'<`el>'\n        Fsharp : $'Slice\\'<`el>'\n        Python : $'Slice\\'<`el>'\n        TypeScript : $'Slice\\'<`el>'\n        Cpp : $'Slice\\'<`el>'\n        CppHost : $'Slice\\'<`el>'\n        Pascal : $'Slice\\'<`el>'\n        Cuda : $'Slice\\'<`el>'\n        Rust : $'_'\n    }\n:! slice' el dim =\n    `(\n        rust::fsharp_global \"type Slice'<'T> = class end\"\n        $'' : $'backend_switch `(slice'_switch el)'\n    )\n\n:! slice'' el dim =\n    `(\n        rust::rust_type\n            `($'Slice\\'_<`el>')\n            `($'[`el; 10]')\n            \"type Slice'_<'T> = class end\"\n    )\n\n:= slice_singleton \\* dim el. (x : option el) : slice' el dim =\n    ?= x ?|\n    | Some x => !\\($'\"[!x]\"')\n    | None =>\n        !\\($'\"[\\\\\\\"\\\\\\\".to_string()]\"') : slice' el dim\n\n:= slice_count \\* t dim. (x : slice' t dim) : convert::unativeint =\n    !\\($'\"!x.len()\"')\n\n:= slice_range \\* t dim.\n    (start : range t) (end : range t) (s : slice' t dim) : rust::ref (slice' t dim)\n    =\n    := len () =\n        s |> slice_count\n    := start, (end : convert::unativeint) =\n        ?= start, end ?|\n        | Start start, End fn => start, (len >> convert::convert) |> fn |> convert::convert\n        | End start_fn, End end_fn =>\n            (len >> convert::convert) |> start_fn, (len >> convert::convert) |> end_fn |> convert::convert\n    ?= start, end ?|\n    | start, end ?& end |> convert::unbox =. len () => !\\($'\"&!s[!start..]\"')\n    | start, end => !\\\\((start, end), $'\"&!s[$0..$1]\"')\n\n:= new_slice \\* el dim. (el : el) : slice' el dim =\n    !\\\\(el, $'\"[$0; @dim as usize]\"')\n\n:= as_slice \\* t. (x : array_base t) : rust::ref (slice t) =\n    := x = x |> to_vec\n    !\\($'\"!x.as_slice()\"')\n\n:= slice_to_vec \\* t. (slice : rust::ref (slice t)) : vec t =\n    !\\\\(slice, $'\"$0.iter().map(|x| *x).collect::<Vec<_>>()\"')\n\n:= to_le_bytes \\* t. (x : t) : slice' u8 8 =\n    backend_switch {\n        Rust = \\ () => $'(!x).to_le_bytes().to_vec()' : slice' u8 8\n    }\n\n:= as_bytes \\* t. (x : t) : rust::ref (slice u8) =\n    backend_switch {\n        Rust = \\ () => $'(!x).as_bytes()' : rust::ref (slice u8)\n    }\n\n:= any \\* t. (fn : t -> bool) (source : array_base t) : bool =\n    := n = source |> array |> length\n    :~ ^ loop i =\n        ? i >= n ?> !-\n        |? source |> index_base i |> fn ?> !+\n        |: loop (i + 1)\n    loop 0","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  :! vec t =
      `(
          rust::rust_type
              `($'Vec<`t>')
              `($'Vec<`t>')
              "type Vec<'T> = class end"
      )

  := from_vec \* el. (vec : vec el) : array el =
      backend_switch {
          Rust = \ () =>
              := vec = ~~ vec
              $'Rc::new(RefCell::new(!vec))' : array el
      }

  := from_vec_base \* el. (vec : vec el) : array_base el =
      backend_switch {
          Rust = \ () =>
              := vec = ~~ vec
              $'Rc::new(RefCell::new(!vec))' : array_base el
      }

  := to_vec \* t. (ab : array_base t) : vec t =
      backend_switch {
          Rust = \ () => $'(!ab).borrow().clone()' : vec t
      }

  := to_vec' \* (t : * -> * -> *) u v. (x : t u v) : vec u =
      backend_switch {
          Rust = \ () => $'(!x).clone()' : vec u
      }

  := to_vec'' \* (t : * -> *) (u : * -> *) v. (x : t (u v)) : vec v =
      backend_switch {
          Rust = \ () => $'(!x).to_vec()' : vec v
      }

  := to_vec''' \* t. (ab : array_base t) : vec t =
      !\\(ab, $'"to_vec($0)"')

  := vec_push \* el. (el : el) (vec : vec el) : vec el =
      := el = ~~ el
      := vec = ~~ vec
      (!\($'"true; let mut !vec = !vec"') : bool) |> ignore
      (!\($'"true; !vec.push(!el)"') : bool) |> ignore
      !\($'"!vec"')

  := vec_reverse \* el. (vec : vec el) : vec el =
      := vec = ~~ vec
      (!\($'"true; let mut !vec = !vec"') : bool) |> ignore
      (!\($'"true; !vec.reverse()"') : bool) |> ignore
      !\($'"!vec"')

  := vec_retain \* el. (fn : el -> bool) (vec : vec el) : vec el =
      := vec = ~~ vec
      := fn = ~~ fn
      (!\($'"true; let mut !vec = !vec"') : bool) |> ignore
      (!\($'"true; !vec.retain(|x| !fn(x.clone()))"') : bool) |> ignore
      !\($'"!vec"')

  := vec_sort_by_key \* el t. (fn : el -> t) (vec : vec el) : vec el =
      := vec = ~~ vec
      := fn = rust::one_param_fn fn
      := fn = ~~ fn
      (!\($'"true; let mut !vec = !vec"') : bool) |> ignore
      (!\($'"true; !vec.sort_by_key(|x| !fn(x.clone()))"') : bool) |> ignore
      !\($'"!vec"')

  := vec_extend \* el. (el : vec el) (vec : vec el) : vec el =
      := el = ~~ el
      := vec = ~~ vec
      (!\($'"true; let mut !vec = !vec"') : bool) |> ignore
      (!\($'"true; !vec.extend(!el)"') : bool) |> ignore
      !\($'"!vec"')

  := vec_mapi \* dim t u. (fn : dim -> t -> u) (ar : vec t) : vec u =
      := fn i = rust::one_param_fn (fn i)
      := fn = ~~ fn
      := ar = ~~ ar
      !\($'"!ar.iter().enumerate().map(|(i, x)| !fn(i.try_into().unwrap())(x.clone())).collect::<Vec<_>>()"')

  := vec_map \* t u. (fn : t -> u) (ar : vec t) : vec u =
      := fn = rust::one_param_fn fn
      !\\((ar, fn), $'"$0.iter().map(|x| $1(x.clone())).collect::<Vec<_>>()"')

  := vec_map' \* t u. (fn : t -> u) (ar : vec t) : vec u =
      := fn = rust::one_param_fn fn
      !\\((ar, fn), $'"$0.iter().map(|x| $1(x.clone())).collect::<Vec<_>>()"')

  := vec_fold' \* t u. (fn : u -> t -> u) (init : u) (ar : vec t) : u =
      (!\\(ar, $'"true; let _vec_fold_ = $0.into_iter().fold(!init, |acc, x| { //"') : bool) |> ignore
      (!\\(fn !\($'"acc"') !\($'"x"'), $'"true; $0 })"') : bool) |> ignore
      !\($'"_vec_fold_"')

  := vec_for_each \* t. (fn : t -> ()) (ar : vec t) : () =
      (!\\((ar, fn), $'"true; $0.iter().for_each(|x| { $1(x.clone()); }); //"') : bool) |> ignore

  := vec_for_each' \* t. (fn : t -> ()) (ar : vec t) : () =
      (!\\(ar, $'"true; $0.into_iter().for_each(|x| { //"') : bool) |> ignore
      (!\\(fn !\($'"x"'), $'$"true"') : bool) |> ignore
      (!\($'"true; }}); //"') : bool) |> ignore

  := vec_for_each'' \* t. (fn : t -> ()) (ar : vec t) : () =
      (!\\(ar, $'"true; $0.into_iter().for_each(|x| { //"') : bool) |> ignore
      (!\\(fn !\($'"x"'), $'$"true"') : bool) |> ignore
      (!\($'"true; }}); //"') : bool) |> ignore

  := vec_for_each''' \* t. (fn : t -> ()) (ar : vec t) : () =
      (!\\(ar, $'"true; $0.into_iter().for_each(|x| { //"') : bool) |> ignore
      (!\\(fn !\($'"x"'), $'$"true"') : bool) |> ignore
      (!\($'"true; }); //"') : bool) |> ignore

  := vec_filter \* t. (fn : t -> bool) (ar : vec t) : vec t =
      := fn = rust::one_param_fn fn
      !\\((ar, fn), $'"$0.iter().filter(|x| $1((*x).clone())).cloned().collect::<Vec<_>>()"')

  := vec_len \* t. (vec : vec t) : convert::unativeint =
      backend_switch {
          Rust = \ () => $'((!vec).len() as usize)' : convert::unativeint
      }

  := vec_chunks \* t. (n : i32) (vec : vec t) : vec (vec t) =
      !\\(vec, $'"$0.chunks(!n).map(|x| x.into_iter().map(|x| x.clone()).collect::<Vec<_>>()).collect::<Vec<_>>()"')

  :! slice t =
      `(
          rust::rust_type
              `($'Slice<`t>')
              `($'[`t]')
              "type Slice<'T> = class end"
      )

  :== slice'_switch el =
      {
          Gleam : $'Slice\'<`el>'
          Lua : $'Slice\'<`el>'
          Fsharp : $'Slice\'<`el>'
          Python : $'Slice\'<`el>'
          TypeScript : $'Slice\'<`el>'
          Cpp : $'Slice\'<`el>'
          CppHost : $'Slice\'<`el>'
          Pascal : $'Slice\'<`el>'
          Cuda : $'Slice\'<`el>'
          Rust : $'_'
      }
  :! slice' el dim =
      `(
          rust::fsharp_global "type Slice'<'T> = class end"
          $'' : $'backend_switch `(slice'_switch el)'
      )

  :! slice'' el dim =
      `(
          rust::rust_type
              `($'Slice\'_<`el>')
              `($'[`el; 10]')
              "type Slice'_<'T> = class end"
      )

  := slice_singleton \* dim el. (x : option el) : slice' el dim =
      ?= x ?|
      | Some x => !\($'"[!x]"')
      | None =>
          !\($'"[\\\"\\\".to_string()]"') : slice' el dim

  := slice_count \* t dim. (x : slice' t dim) : convert::unativeint =
      !\($'"!x.len()"')

  := slice_range \* t dim.
      (start : range t) (end : range t) (s : slice' t dim) : rust::ref (slice' t dim)
      =
      := len () =
          s |> slice_count
      := start, (end : convert::unativeint) =
          ?= start, end ?|
          | Start start, End fn => start, (len >> convert::convert) |> fn |> convert::convert
          | End start_fn, End end_fn =>
              (len >> convert::convert) |> start_fn, (len >> convert::convert) |> end_fn |> convert::convert
      ?= start, end ?|
      | start, end ?& end |> convert::unbox =. len () => !\($'"&!s[!start..]"')
      | start, end => !\\((start, end), $'"&!s[$0..$1]"')

  := new_slice \* el dim. (el : el) : slice' el dim =
      !\\(el, $'"[$0; @dim as usize]"')

  := as_slice \* t. (x : array_base t) : rust::ref (slice t) =
      := x = x |> to_vec
      !\($'"!x.as_slice()"')

  := slice_to_vec \* t. (slice : rust::ref (slice t)) : vec t =
      !\\(slice, $'"$0.iter().map(|x| *x).collect::<Vec<_>>()"')

  := to_le_bytes \* t. (x : t) : slice' u8 8 =
      backend_switch {
          Rust = \ () => $'(!x).to_le_bytes().to_vec()' : slice' u8 8
      }

  := as_bytes \* t. (x : t) : rust::ref (slice u8) =
      backend_switch {
          Rust = \ () => $'(!x).as_bytes()' : rust::ref (slice u8)
      }

  := any \* t. (fn : t -> bool) (source : array_base t) : bool =
      := n = source |> array |> length
      :~ ^ loop i =
          ? i >= n ?> !-
          |? source |> index_base i |> fn ?> !+
          |: loop (i + 1)
      loop 0
  """,
  timeout: 300_000
)
```

#### any (test)

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":"///- --test --symbol\n///> rust\n///> typescript\n\n:= source = init 5\n(source |> any (\\ x => x = 3), source |> any (\\ x => x > 10)) |> _assert_eq (!+, !-)","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  ///- --test --symbol
  ///> rust
  ///> typescript

  := source = init 5
  (source |> any (\ x => x = 3), source |> any (\ x => x > 10)) |> _assert_eq (!+, !-)
  """,
  timeout: 300_000
)
```

### iter_collect vec

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":":+ iter_collect vec = \\ (iter : into_iterator u) =>\n    !\\\\(iter, $'\"$0.collect::<Vec<_>>()\"')\n\n:+ iter_collect'' vec = \\ (iter : into_iterator (t (u v))) =>\n    !\\\\(iter, $'\"$0.collect::<Vec<_>>()\"')\n\n:= new_vec \\* t. (items : list t) : vec t =\n    backend_switch {\n        Rust = \\ () => items |> listm::fold (\\ v x => vec_push x v) ($'Vec::new()' : vec t)\n    }","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  :+ iter_collect vec = \ (iter : into_iterator u) =>
      !\\(iter, $'"$0.collect::<Vec<_>>()"')

  :+ iter_collect'' vec = \ (iter : into_iterator (t (u v))) =>
      !\\(iter, $'"$0.collect::<Vec<_>>()"')

  := new_vec \* t. (items : list t) : vec t =
      backend_switch {
          Rust = \ () => items |> listm::fold (\ v x => vec_push x v) ($'Vec::new()' : vec t)
      }
  """,
  timeout: 300_000
)
```

