<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":":= head (ar : array _) =\n    ? var_is ar || length ar > 0\n    ?> ar |> index 0\n    |: error_type \"The length of the array should be greater than 0.\"\n\n:= last (ar : array _) =\n    := len = length ar\n    ? var_is ar || len > 0\n    ?> ar |> index (len - 1)\n    |: error_type \"The length of the array should be greater than 0.\"","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  := head (ar : array _) =
      ? var_is ar || length ar > 0
      ?> ar |> index 0
      |: error_type "The length of the array should be greater than 0."

  := last (ar : array _) =
      := len = length ar
      ? var_is ar || len > 0
      ?> ar |> index (len - 1)
      |: error_type "The length of the array should be greater than 0."
  """,
  timeout: 300_000
)
```

