## am'

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":":= length \\* el. (a : array el) : int =\n    a |> length\n\n:= index \\* el. (i : int) (a : array el) : el =\n    backend_switch {\n        Gleam = \\ () => index a i\n        Lua = \\ () => index a i\n        Fsharp = \\ () => index a i\n        Python = \\ () => $'!a[!i]' : el\n        Rust = \\ () => index a i\n        TypeScript = \\ () => index a i\n        Zig = \\ () => index a i\n        Lean = \\ () => index a i\n        C = \\ () => index a i\n        Pascal = \\ () => index a i\n        Wgsl = \\ () => index a i\n    }\n\n:= index_base \\* el. (i : int) (ar : array_base el) : el =\n    ar |> array |> index i\n\n:= create_base \\* el. (n : int) : array_base el = !!!!ArrayCreate(`el, n)\n\n:= set_base \\* el. (ar : array_base el) (i : int) (v : el) : () = !!!!ArrayIndexSet(ar, i, v)\n\n:= length_base \\* el. (ar : array_base el) : int =\n    ar |> array |> length","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  := length \* el. (a : array el) : int =
      a |> length

  := index \* el. (i : int) (a : array el) : el =
      backend_switch {
          Gleam = \ () => index a i
          Lua = \ () => index a i
          Fsharp = \ () => index a i
          Python = \ () => $'!a[!i]' : el
          Rust = \ () => index a i
          TypeScript = \ () => index a i
          Zig = \ () => index a i
          Lean = \ () => index a i
          C = \ () => index a i
          Pascal = \ () => index a i
          Wgsl = \ () => index a i
      }

  := index_base \* el. (i : int) (ar : array_base el) : el =
      ar |> array |> index i

  := create_base \* el. (n : int) : array_base el = !!!!ArrayCreate(`el, n)

  := set_base \* el. (ar : array_base el) (i : int) (v : el) : () = !!!!ArrayIndexSet(ar, i, v)

  := length_base \* el. (ar : array_base el) : int =
      ar |> array |> length
  """,
  timeout: 300_000
)
```

#### base_wrappers_round_trip (test)

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":"///- --test --symbol\n///> rust\n\n:= a : array_base i32 = create_base 3i32\nset_base a 1i32 7i32\n(;[ length_base a; index_base 1i32 a ]) |> _assert_eq (;[ 3i32; 7i32 ])","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  ///- --test --symbol
  ///> rust

  := a : array_base i32 = create_base 3i32
  set_base a 1i32 7i32
  (;[ length_base a; index_base 1i32 a ]) |> _assert_eq (;[ 3i32; 7i32 ])
  """,
  timeout: 300_000
)
```

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":":= base \\* el. ((array a) : array el) : array_base el =\n    a\n\n:= base' \\* el. ((array a) : array el) : array_base el =\n    a\n\n:= generic_equable x1 x2 =\n    ? length x1 <>.. length x2\n    ?> !-\n    |:\n        :~ ^ 루프 i =\n            ? i < length x1\n            ?> index i x1 = index i x2 && 루프 (i + 1)\n            |: !+\n        루프 0","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  := base \* el. ((array a) : array el) : array_base el =
      a

  := base' \* el. ((array a) : array el) : array_base el =
      a

  := generic_equable x1 x2 =
      ? length x1 <>.. length x2
      ?> !-
      |:
          :~ ^ 루프 i =
              ? i < length x1
              ?> index i x1 = index i x2 && 루프 (i + 1)
              |: !+
          루프 0
  """,
  timeout: 300_000
)
```

