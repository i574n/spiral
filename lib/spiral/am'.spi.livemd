<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":":= vec_collect fn vec =\n    ((;[] |> base |> to_vec), ((vec |> from_vec : array _) |> to_list' |> listm'::unbox))\n    ||> listm::fold \\ acc x =>\n        acc |> vec_extend (fn x)\n\n:= vec_collect_option vec =\n    ((;[] |> base |> to_vec |> Ok), ((vec |> from_vec : array _) |> arraym::toList))\n    ||> listm::fold \\ acc x =>\n        x\n        |> resultm::unbox\n        |> \\ x =>\n            ?= acc, x |> resultm::map optionm'::unbox ?|\n            | Ok acc, Ok (Some x) => acc |> vec_extend x |> Ok\n            | _, Error error => error |> Error\n            | _ => acc\n\n:= vec_collect_into \\* (c : * -> * -> *) t e.\n    (x : vec (c t e))\n    : c (vec t) e\n    =\n    !\\($'\"!x.into_iter().collect()\"')\n\n:= parallel_map \\* el el'. (fn : el -> el') (a : array el) : array el' =\n    run_target \\|\n        | Fsharp => \\ () => $'!a |> Array.Parallel.map !fn ' : array el'\n        | _ => \\ () => arraym::map fn a\n\n:= map' \\* el el'. (fn : el -> el') (a : array el) : array el' =\n    run_target \\|\n        | Fsharp => \\ () => $'!a |> Array.map !fn ' : array el'\n        | _ => \\ () => arraym::map fn a\n\n:= sort_by \\* el key. (fn : el -> key) (a : array el) : array el =\n    := fsharp () = $'!a |> Array.sortBy !fn ' : array el\n    := insertion_sort () =\n        := r = arraym::map id ($'!a ' : array el)\n        := keys = arraym::map fn ($'!a ' : array el)\n        loop::for' { from = 1; nearTo = length r } \\ i =>\n            := x = index i r\n            := k = index i keys\n            := s = mut { j = i }\n            loop::while' (\\ () => s::j > 0 && gt_is (comp (index (s::j - 1) keys) k)) \\ () =>\n                := j = s::j\n                set r j (index (j - 1) r)\n                set keys j (index (j - 1) keys)\n                s <- { j = j - 1 }\n            set r s::j x\n            set keys s::j k\n        $'!r ' : array el\n    backend_switch {\n        Gleam = \\ () => fsharp ()\n        Lua = insertion_sort\n        Fsharp = \\ () => fsharp ()\n        Python = \\ () =>\n            := keys = arraym::map fn ($'!a ' : array el)\n            $'!a[sorted(range(len(!a)), key=lambda __i: (lambda __k: (__k.tag, __k) if hasattr(__k, \"tag\") else \\\n                __k)(!keys[__i]))]' : array el\n        TypeScript = \\ () =>\n            := keys = arraym::map fn ($'!a ' : array el)\n            global (\n                \"function spiral_compare(a: any, b: any): number { if (typeof a === 'object' && a !== null && \"\n                ^^ \"typeof b === 'object' && b !== null) { if (Array.isArray(a)) { for (let i = 0; i < \"\n                ^^ \"Math.min(a.length, b.length); i++) { const c = spiral_compare(a[i], b[i]); if (c !== 0) return c; \"\n                ^^ \"} return a.length - b.length; } if (a.tag !== b.tag) return a.tag - b.tag; for (const k of \"\n                ^^ \"Object.keys(a)) { if (k === 'tag') continue; const c = spiral_compare(a[k], b[k]); if (c !== 0) \"\n                ^^ \"return c; } return 0; } return a < b ? -1 : a > b ? 1 : 0; }\"\n            )\n            $'!a.map((_x: any, i: number) => i).sort((i: number, j: number) => spiral_compare(!keys[i], \\\n                !keys[j])).map((i: number) => !a[i])' : array el\n        Cpp = \\ () => fsharp ()\n        CppHost = \\ () => fsharp ()\n        Pascal = \\ () => fsharp ()\n        Cuda = \\ () => fsharp ()\n        Zig = insertion_sort\n        Lean = insertion_sort\n        Rust = \\ () =>\n            := a = $'!a ' : array el\n            := key_fn = ~~ (rust::one_param_fn fn)\n            := r = $'Rc::new(RefCell::new(!a.borrow().clone()))' : array el\n            := keys =\n                $'Rc::new(RefCell::new(!a.borrow().iter().map(|x| !key_fn(x.clone())).collect::<Vec<_>>()))' : array key\n            loop::for' { from = 1; nearTo = length a } \\ i =>\n                := x = index i r\n                := k = index i keys\n                := s = mut { j = i }\n                loop::while' (\\ () => s::j > 0 && gt_is (comp (index (s::j - 1) keys) k)) \\ () =>\n                    := j = s::j\n                    set r j (index (j - 1) r)\n                    set keys j (index (j - 1) keys)\n                    s <- { j = j - 1 }\n                set r s::j x\n                set keys s::j k\n            $'!r ' : array el\n    }\n\n:= sort \\* el. (a : array el) : array el =\n    run_target \\|\n        | Fsharp => \\ () => $'!a |> Array.sort'\n        | _ => \\ () => sort_by id a\n\n:= sort_descending \\* el. (a : array el) : array el =\n    run_target \\|\n        | Fsharp => \\ () => $'!a |> Array.sortDescending'\n        | _ => \\ () =>\n            := ascending = sort a\n            := n = length ascending\n            arraym::init n \\ i => index (n - 1 - i) ascending","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  := vec_collect fn vec =
      ((;[] |> base |> to_vec), ((vec |> from_vec : array _) |> to_list' |> listm'::unbox))
      ||> listm::fold \ acc x =>
          acc |> vec_extend (fn x)

  := vec_collect_option vec =
      ((;[] |> base |> to_vec |> Ok), ((vec |> from_vec : array _) |> arraym::toList))
      ||> listm::fold \ acc x =>
          x
          |> resultm::unbox
          |> \ x =>
              ?= acc, x |> resultm::map optionm'::unbox ?|
              | Ok acc, Ok (Some x) => acc |> vec_extend x |> Ok
              | _, Error error => error |> Error
              | _ => acc

  := vec_collect_into \* (c : * -> * -> *) t e.
      (x : vec (c t e))
      : c (vec t) e
      =
      !\($'"!x.into_iter().collect()"')

  := parallel_map \* el el'. (fn : el -> el') (a : array el) : array el' =
      run_target \|
          | Fsharp => \ () => $'!a |> Array.Parallel.map !fn ' : array el'
          | _ => \ () => arraym::map fn a

  := map' \* el el'. (fn : el -> el') (a : array el) : array el' =
      run_target \|
          | Fsharp => \ () => $'!a |> Array.map !fn ' : array el'
          | _ => \ () => arraym::map fn a

  := sort_by \* el key. (fn : el -> key) (a : array el) : array el =
      := fsharp () = $'!a |> Array.sortBy !fn ' : array el
      := insertion_sort () =
          := r = arraym::map id ($'!a ' : array el)
          := keys = arraym::map fn ($'!a ' : array el)
          loop::for' { from = 1; nearTo = length r } \ i =>
              := x = index i r
              := k = index i keys
              := s = mut { j = i }
              loop::while' (\ () => s::j > 0 && gt_is (comp (index (s::j - 1) keys) k)) \ () =>
                  := j = s::j
                  set r j (index (j - 1) r)
                  set keys j (index (j - 1) keys)
                  s <- { j = j - 1 }
              set r s::j x
              set keys s::j k
          $'!r ' : array el
      backend_switch {
          Gleam = \ () => fsharp ()
          Lua = insertion_sort
          Fsharp = \ () => fsharp ()
          Python = \ () =>
              := keys = arraym::map fn ($'!a ' : array el)
              $'!a[sorted(range(len(!a)), key=lambda __i: (lambda __k: (__k.tag, __k) if hasattr(__k, "tag") else \
                  __k)(!keys[__i]))]' : array el
          TypeScript = \ () =>
              := keys = arraym::map fn ($'!a ' : array el)
              global (
                  "function spiral_compare(a: any, b: any): number { if (typeof a === 'object' && a !== null && "
                  ^^ "typeof b === 'object' && b !== null) { if (Array.isArray(a)) { for (let i = 0; i < "
                  ^^ "Math.min(a.length, b.length); i++) { const c = spiral_compare(a[i], b[i]); if (c !== 0) return c; "
                  ^^ "} return a.length - b.length; } if (a.tag !== b.tag) return a.tag - b.tag; for (const k of "
                  ^^ "Object.keys(a)) { if (k === 'tag') continue; const c = spiral_compare(a[k], b[k]); if (c !== 0) "
                  ^^ "return c; } return 0; } return a < b ? -1 : a > b ? 1 : 0; }"
              )
              $'!a.map((_x: any, i: number) => i).sort((i: number, j: number) => spiral_compare(!keys[i], \
                  !keys[j])).map((i: number) => !a[i])' : array el
          Cpp = \ () => fsharp ()
          CppHost = \ () => fsharp ()
          Pascal = \ () => fsharp ()
          Cuda = \ () => fsharp ()
          Zig = insertion_sort
          Lean = insertion_sort
          Rust = \ () =>
              := a = $'!a ' : array el
              := key_fn = ~~ (rust::one_param_fn fn)
              := r = $'Rc::new(RefCell::new(!a.borrow().clone()))' : array el
              := keys =
                  $'Rc::new(RefCell::new(!a.borrow().iter().map(|x| !key_fn(x.clone())).collect::<Vec<_>>()))' : array key
              loop::for' { from = 1; nearTo = length a } \ i =>
                  := x = index i r
                  := k = index i keys
                  := s = mut { j = i }
                  loop::while' (\ () => s::j > 0 && gt_is (comp (index (s::j - 1) keys) k)) \ () =>
                      := j = s::j
                      set r j (index (j - 1) r)
                      set keys j (index (j - 1) keys)
                      s <- { j = j - 1 }
                  set r s::j x
                  set keys s::j k
              $'!r ' : array el
      }

  := sort \* el. (a : array el) : array el =
      run_target \|
          | Fsharp => \ () => $'!a |> Array.sort'
          | _ => \ () => sort_by id a

  := sort_descending \* el. (a : array el) : array el =
      run_target \|
          | Fsharp => \ () => $'!a |> Array.sortDescending'
          | _ => \ () =>
              := ascending = sort a
              := n = length ascending
              arraym::init n \ i => index (n - 1 - i) ascending
  """,
  timeout: 300_000
)
```

#### sort_orders_on_every_backend (test)

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":"///- --test --symbol\n///> rust\n///> python\n///> typescript\n///> lua\n\n:= a = ;[ 3i32; 1i32; 2i32 ]\n:= ascending = sort a\n? index 0 ascending <> 1i32 || index 2 ascending <> 3i32 ?> failwith \"ascending\"\n:= descending = sort_descending a\n? index 0 descending <> 3i32 || index 2 descending <> 1i32 ?> failwith \"descending\"","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  ///- --test --symbol
  ///> rust
  ///> python
  ///> typescript
  ///> lua

  := a = ;[ 3i32; 1i32; 2i32 ]
  := ascending = sort a
  ? index 0 ascending <> 1i32 || index 2 ascending <> 3i32 ?> failwith "ascending"
  := descending = sort_descending a
  ? index 0 descending <> 3i32 || index 2 descending <> 1i32 ?> failwith "descending"
  """,
  timeout: 300_000
)
```

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":":= transpose \\* el. (a : array_base (array_base el)) : array_base (array_base el) =\n    run_target \\|\n        | Fsharp => \\ () => $'!a |> Array.transpose' : array_base (array_base el)\n        | _ => \\ () =>\n            := rows : array (array_base el) = array a\n            := height : int = length rows\n            := width : int = ? height = 0 ?> 0 |: length (array (index 0 rows) : array el)\n            arraym::init width (\\ (c : int) =>\n                arraym::init height \\ (r : int) => index c (array (index r rows) : array el)\n                |> \\ (array column : array el) => column\n            )\n            |> \\ (array result : array (array_base el)) => result","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  := transpose \* el. (a : array_base (array_base el)) : array_base (array_base el) =
      run_target \|
          | Fsharp => \ () => $'!a |> Array.transpose' : array_base (array_base el)
          | _ => \ () =>
              := rows : array (array_base el) = array a
              := height : int = length rows
              := width : int = ? height = 0 ?> 0 |: length (array (index 0 rows) : array el)
              arraym::init width (\ (c : int) =>
                  arraym::init height \ (r : int) => index c (array (index r rows) : array el)
                  |> \ (array column : array el) => column
              )
              |> \ (array result : array (array_base el)) => result
  """,
  timeout: 300_000
)
```

#### transpose_swaps_rows_and_columns (test)

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":"///- --test --symbol\n///> rust\n\n:= row = \\ (cells : array i32) => cells |> \\ (array x : array i32) => x\n:= rows : array (array_base i32) = ;[ row ;[ 1i32; 2i32; 3i32 ]; row ;[ 4i32; 5i32; 6i32 ] ]\n:= flipped : array (array_base i32) = array (rows |> \\ (array x : array (array_base i32)) => x |> transpose)\n:= last : array i32 = array (index 2 flipped)\n(length flipped, index 0 last, index 1 last) |> _assert_eq (3, 3i32, 6i32)","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  ///- --test --symbol
  ///> rust

  := row = \ (cells : array i32) => cells |> \ (array x : array i32) => x
  := rows : array (array_base i32) = ;[ row ;[ 1i32; 2i32; 3i32 ]; row ;[ 4i32; 5i32; 6i32 ] ]
  := flipped : array (array_base i32) = array (rows |> \ (array x : array (array_base i32)) => x |> transpose)
  := last : array i32 = array (index 2 flipped)
  (length flipped, index 0 last, index 1 last) |> _assert_eq (3, 3i32, 6i32)
  """,
  timeout: 300_000
)
```

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":":= try_item \\* el. (i : i32) (a : array el) : option el =\n    := fsharp () : option el = $'!a |> Array.tryItem !i ' |> optionm'::unbox\n    := in_bounds_item () : option el =\n        := a = $'!a ' : array el\n        ? i >= 0 && i < length a ?> Some (index i a) |: None\n    backend_switch {\n        Gleam = fsharp\n        Lua = fsharp\n        Fsharp = fsharp\n        Python = fsharp\n        TypeScript = fsharp\n        Cpp = fsharp\n        CppHost = fsharp\n        Pascal = fsharp\n        Cuda = fsharp\n        Zig = in_bounds_item\n        Lean = in_bounds_item\n        Rust = in_bounds_item\n    }","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  := try_item \* el. (i : i32) (a : array el) : option el =
      := fsharp () : option el = $'!a |> Array.tryItem !i ' |> optionm'::unbox
      := in_bounds_item () : option el =
          := a = $'!a ' : array el
          ? i >= 0 && i < length a ?> Some (index i a) |: None
      backend_switch {
          Gleam = fsharp
          Lua = fsharp
          Fsharp = fsharp
          Python = fsharp
          TypeScript = fsharp
          Cpp = fsharp
          CppHost = fsharp
          Pascal = fsharp
          Cuda = fsharp
          Zig = in_bounds_item
          Lean = in_bounds_item
          Rust = in_bounds_item
      }
  """,
  timeout: 300_000
)
```

#### try_item_is_none_out_of_bounds (test)

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":"///- --test --symbol\n///> rust\n///> zig\n\n:= a = ;[ 10i32; 20i32 ]\n:= code (i : i32) : i32 = ?= try_item i a ?| | Some x => x | None => -1i32\n[ code (-1i32); code 0i32; code 1i32; code 2i32 ] |> _assert_eq [ -1i32; 10i32; 20i32; -1i32 ]","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  ///- --test --symbol
  ///> rust
  ///> zig

  := a = ;[ 10i32; 20i32 ]
  := code (i : i32) : i32 = ?= try_item i a ?| | Some x => x | None => -1i32
  [ code (-1i32); code 0i32; code 1i32; code 2i32 ] |> _assert_eq [ -1i32; 10i32; 20i32; -1i32 ]
  """,
  timeout: 300_000
)
```
