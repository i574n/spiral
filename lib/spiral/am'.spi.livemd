<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":":= indexed \\* t u {number}. (ar : array_base t) : array_base (u * t) =\n    ((0, ;[]), (array ar : array _))\n    ||> arraym::fold \\ (i, acc) x =>\n        i + 1, acc ++ ;[i, x]\n    |> snd\n    |> \\ (array x : array _) => x","print_code":false},"livebook_object":"smart_cell"} -->

