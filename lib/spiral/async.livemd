### start_child_timeout

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"inl start_child_timeout forall t. (timeout : i32) (a : async t) : async (async t) =\n    if rust.is_native ()\n    then a |> start_child_native timeout\n    else\n        run_target function\n            | Fsharp _\n            | TypeScript _ => fun () =>\n                $'Async.StartChild (!a, !timeout)'\n            | _ => fun () => null ()","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  inl start_child_timeout forall t. (timeout : i32) (a : async t) : async (async t) =
      if rust.is_native ()
      then a |> start_child_native timeout
      else
          run_target function
              | Fsharp _
              | TypeScript _ => fun () =>
                  $'Async.StartChild (!a, !timeout)'
              | _ => fun () => null ()
  """,
  timeout: 300_000
)
```

### start_immediate

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"// Native Rust: runs to completion on the calling thread (F# starts on it too, and continues on the thread pool).\ninl start_immediate forall t. (a : async t) : () =\n    if rust.is_native ()\n    then a |> run_synchronously |> fun _ => ()\n    else\n        run_target function\n            | Fsharp _\n            | TypeScript _ => fun () =>\n                a |> $'Async.StartImmediate'\n            | _ => fun () => null ()","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  // Native Rust: runs to completion on the calling thread (F# starts on it too, and continues on the thread pool).
  inl start_immediate forall t. (a : async t) : () =
      if rust.is_native ()
      then a |> run_synchronously |> fun _ => ()
      else
          run_target function
              | Fsharp _
              | TypeScript _ => fun () =>
                  a |> $'Async.StartImmediate'
              | _ => fun () => null ()
  """,
  timeout: 300_000
)
```

### start_with_continuations

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"// Native Rust: runs to completion on the calling thread; the result and a panic are ignored (F#'s three `ignore`s).\ninl start_with_continuations forall t. (a : async t) : () =\n    if rust.is_native ()\n    then a |> catch_native |> run_synchronously |> fun _ => ()\n    else\n        run_target_args' a function\n            | Fsharp _\n            | TypeScript _ => fun a =>\n                $'Async.StartWithContinuations (!a, ignore, ignore, ignore)'\n            | _ => fun _ => null ()","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  // Native Rust: runs to completion on the calling thread; the result and a panic are ignored (F#'s three `ignore`s).
  inl start_with_continuations forall t. (a : async t) : () =
      if rust.is_native ()
      then a |> catch_native |> run_synchronously |> fun _ => ()
      else
          run_target_args' a function
              | Fsharp _
              | TypeScript _ => fun a =>
                  $'Async.StartWithContinuations (!a, ignore, ignore, ignore)'
              | _ => fun _ => null ()
  """,
  timeout: 300_000
)
```

