### run_synchronously

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"inl run_synchronously forall t. (a : async t) : t =\n    run_target function\n        | Fsharp _ => fun () =>\n            a |> $'Async.RunSynchronously'\n        | Cuda => fun () =>\n            $'asyncio.run(!a())'\n        // Native Rust: a minimal executor (std only): poll on this thread, parked until the future's waker unparks it.\n        | RustNative => fun () =>\n            $'{ struct SpiralThreadWaker(std::thread::Thread); impl std::task::Wake for SpiralThreadWaker { fn wake(self: std::sync::Arc<Self>) { self.0.unpark(); } } let waker = std::task::Waker::from(std::sync::Arc::new(SpiralThreadWaker(std::thread::current()))); let mut cx = std::task::Context::from_waker(&waker); let mut f = !a; loop { match std::future::Future::poll(f.as_mut(), &mut cx) { std::task::Poll::Ready(v) => break v, std::task::Poll::Pending => std::thread::park() } } }' : t\n        | _ => fun () => null ()\n\n// Native Rust only (async.catch', start_with_continuations): every poll of `a` runs under catch_unwind; a panic (the\n// native exception, as in base.try) becomes Err with its message, and its panic report is suppressed like in\n// base.catch_unwind_native (a once-installed hook that defers to the previous one unless this thread's counter is set).\n// A panic=abort build aborts instead (and its hook always reports).\ninl catch_native forall t. (a : async t) : async (resultm.result' t exn) =\n    $'Box::pin({ thread_local\\! { static QUIET: std::cell::Cell<u32> = std::cell::Cell::new(0); } static HOOK: std::sync::Once = std::sync::Once::new(); HOOK.call_once(|| { let prev = std::panic::take_hook(); std::panic::set_hook(Box::new(move |info| if cfg\\!(panic = \"abort\") || QUIET.with(|q| q.get()) == 0 { prev(info) })) }); let mut f = !a; std::future::poll_fn(move |cx| { QUIET.with(|q| q.set(q.get() + 1)); let r = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| std::future::Future::poll(f.as_mut(), cx))); QUIET.with(|q| q.set(q.get() - 1)); match r { Ok(std::task::Poll::Ready(v)) => std::task::Poll::Ready(Ok(v)), Ok(std::task::Poll::Pending) => std::task::Poll::Pending, Err(e) => std::task::Poll::Ready(Err(Rc::<str>::from(e.downcast_ref::<String>().map(|s| s.as_str()).or_else(|| e.downcast_ref::<&str>().copied()).unwrap_or(\"panic\")))) } }) })' : async (resultm.result' t exn)\n\n// Native Rust only (async.start_child, start_child_timeout; timeout < 0 = none). Native futures hold `Rc` state and\n// aren't `Send`, so the child can't run on another thread: it is polled once when the outer async runs (it starts\n// there, like F#'s child) and then each time the returned handle is polled (cooperative, on the awaiting thread).\n// A panic in that first poll is kept (its report suppressed, as in catch_native) and resumed by the handle (F# raises a\n// child's exception at the await). With a\n// timeout, a timer thread wakes the handle at the deadline; a child still pending then, or one that finished after\n// it, makes the handle panic with .NET's TimeoutException message. A blocking poll can't be preempted.\ninl start_child_native forall t. (timeout : i32) (a : async t) : async (async t) =\n    $'Box::pin({ thread_local\\! { static QUIET: std::cell::Cell<u32> = std::cell::Cell::new(0); } static HOOK: std::sync::Once = std::sync::Once::new(); HOOK.call_once(|| { let prev = std::panic::take_hook(); std::panic::set_hook(Box::new(move |info| if cfg\\!(panic = \"abort\") || QUIET.with(|q| q.get()) == 0 { prev(info) })) }); let mut f = !a; let timeout_ms: i32 = !timeout; async move { let deadline = if timeout_ms >= 0 { Some(std::time::Instant::now() + std::time::Duration::from_millis(timeout_ms as u64)) } else { None }; let first = std::future::poll_fn(|cx| { QUIET.with(|q| q.set(q.get() + 1)); let r = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| std::future::Future::poll(f.as_mut(), cx))); QUIET.with(|q| q.set(q.get() - 1)); std::task::Poll::Ready(r) }).await; let mut done = match first { Ok(std::task::Poll::Ready(v)) => Some(Ok((v, std::time::Instant::now()))), Ok(std::task::Poll::Pending) => None, Err(e) => Some(Err(e)) }; let mut timer: Option<std::sync::Arc<std::sync::Mutex<std::task::Waker>>> = None; let h: std::pin::Pin<Box<dyn std::future::Future<Output = `t>>> = Box::pin(std::future::poll_fn(move |cx| { if done.is_none() { if let std::task::Poll::Ready(v) = std::future::Future::poll(f.as_mut(), cx) { done = Some(Ok((v, std::time::Instant::now()))) } } match done.take() { Some(Err(e)) => std::panic::resume_unwind(e), Some(Ok((v, at))) => if deadline.map_or(false, |d| at > d) { panic\\!(\"The operation has timed out.\") } else { std::task::Poll::Ready(v) }, None => match deadline { Some(d) if std::time::Instant::now() >= d => panic\\!(\"The operation has timed out.\"), Some(d) => { match &timer { Some(w) => *w.lock().unwrap() = cx.waker().clone(), None => { let w = std::sync::Arc::new(std::sync::Mutex::new(cx.waker().clone())); let w2 = w.clone(); std::thread::spawn(move || { let now = std::time::Instant::now(); if d > now { std::thread::sleep(d - now) } w2.lock().unwrap().wake_by_ref() }); timer = Some(w) } } std::task::Poll::Pending }, None => std::task::Poll::Pending } } })); h } })' : async (async t)","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  inl run_synchronously forall t. (a : async t) : t =
      run_target function
          | Fsharp _ => fun () =>
              a |> $'Async.RunSynchronously'
          | Cuda => fun () =>
              $'asyncio.run(!a())'
          // Native Rust: a minimal executor (std only): poll on this thread, parked until the future's waker unparks it.
          | RustNative => fun () =>
              $'{ struct SpiralThreadWaker(std::thread::Thread); impl std::task::Wake for SpiralThreadWaker { fn wake(self: std::sync::Arc<Self>) { self.0.unpark(); } } let waker = std::task::Waker::from(std::sync::Arc::new(SpiralThreadWaker(std::thread::current()))); let mut cx = std::task::Context::from_waker(&waker); let mut f = !a; loop { match std::future::Future::poll(f.as_mut(), &mut cx) { std::task::Poll::Ready(v) => break v, std::task::Poll::Pending => std::thread::park() } } }' : t
          | _ => fun () => null ()

  // Native Rust only (async.catch', start_with_continuations): every poll of `a` runs under catch_unwind; a panic (the
  // native exception, as in base.try) becomes Err with its message, and its panic report is suppressed like in
  // base.catch_unwind_native (a once-installed hook that defers to the previous one unless this thread's counter is set).
  // A panic=abort build aborts instead (and its hook always reports).
  inl catch_native forall t. (a : async t) : async (resultm.result' t exn) =
      $'Box::pin({ thread_local\! { static QUIET: std::cell::Cell<u32> = std::cell::Cell::new(0); } static HOOK: std::sync::Once = std::sync::Once::new(); HOOK.call_once(|| { let prev = std::panic::take_hook(); std::panic::set_hook(Box::new(move |info| if cfg\!(panic = "abort") || QUIET.with(|q| q.get()) == 0 { prev(info) })) }); let mut f = !a; std::future::poll_fn(move |cx| { QUIET.with(|q| q.set(q.get() + 1)); let r = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| std::future::Future::poll(f.as_mut(), cx))); QUIET.with(|q| q.set(q.get() - 1)); match r { Ok(std::task::Poll::Ready(v)) => std::task::Poll::Ready(Ok(v)), Ok(std::task::Poll::Pending) => std::task::Poll::Pending, Err(e) => std::task::Poll::Ready(Err(Rc::<str>::from(e.downcast_ref::<String>().map(|s| s.as_str()).or_else(|| e.downcast_ref::<&str>().copied()).unwrap_or("panic")))) } }) })' : async (resultm.result' t exn)

  // Native Rust only (async.start_child, start_child_timeout; timeout < 0 = none). Native futures hold `Rc` state and
  // aren't `Send`, so the child can't run on another thread: it is polled once when the outer async runs (it starts
  // there, like F#'s child) and then each time the returned handle is polled (cooperative, on the awaiting thread).
  // A panic in that first poll is kept (its report suppressed, as in catch_native) and resumed by the handle (F# raises a
  // child's exception at the await). With a
  // timeout, a timer thread wakes the handle at the deadline; a child still pending then, or one that finished after
  // it, makes the handle panic with .NET's TimeoutException message. A blocking poll can't be preempted.
  inl start_child_native forall t. (timeout : i32) (a : async t) : async (async t) =
      $'Box::pin({ thread_local\! { static QUIET: std::cell::Cell<u32> = std::cell::Cell::new(0); } static HOOK: std::sync::Once = std::sync::Once::new(); HOOK.call_once(|| { let prev = std::panic::take_hook(); std::panic::set_hook(Box::new(move |info| if cfg\!(panic = "abort") || QUIET.with(|q| q.get()) == 0 { prev(info) })) }); let mut f = !a; let timeout_ms: i32 = !timeout; async move { let deadline = if timeout_ms >= 0 { Some(std::time::Instant::now() + std::time::Duration::from_millis(timeout_ms as u64)) } else { None }; let first = std::future::poll_fn(|cx| { QUIET.with(|q| q.set(q.get() + 1)); let r = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| std::future::Future::poll(f.as_mut(), cx))); QUIET.with(|q| q.set(q.get() - 1)); std::task::Poll::Ready(r) }).await; let mut done = match first { Ok(std::task::Poll::Ready(v)) => Some(Ok((v, std::time::Instant::now()))), Ok(std::task::Poll::Pending) => None, Err(e) => Some(Err(e)) }; let mut timer: Option<std::sync::Arc<std::sync::Mutex<std::task::Waker>>> = None; let h: std::pin::Pin<Box<dyn std::future::Future<Output = `t>>> = Box::pin(std::future::poll_fn(move |cx| { if done.is_none() { if let std::task::Poll::Ready(v) = std::future::Future::poll(f.as_mut(), cx) { done = Some(Ok((v, std::time::Instant::now()))) } } match done.take() { Some(Err(e)) => std::panic::resume_unwind(e), Some(Ok((v, at))) => if deadline.map_or(false, |d| at > d) { panic\!("The operation has timed out.") } else { std::task::Poll::Ready(v) }, None => match deadline { Some(d) if std::time::Instant::now() >= d => panic\!("The operation has timed out."), Some(d) => { match &timer { Some(w) => *w.lock().unwrap() = cx.waker().clone(), None => { let w = std::sync::Arc::new(std::sync::Mutex::new(cx.waker().clone())); let w2 = w.clone(); std::thread::spawn(move || { let now = std::time::Instant::now(); if d > now { std::thread::sleep(d - now) } w2.lock().unwrap().wake_by_ref() }); timer = Some(w) } } std::task::Poll::Pending }, None => std::task::Poll::Pending } } })); h } })' : async (async t)
  """,
  timeout: 300_000
)
```

### start

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"// Native Rust: runs to completion on the calling thread (std executor), as the future isn't `Send`; F# returns at once\n// and runs it on the thread pool.\ninl start (a : async ()) : () =\n    if rust.is_native ()\n    then a |> run_synchronously\n    else\n        run_target function\n            | Fsharp _\n            | TypeScript _ => fun () =>\n                a |> $'Async.Start'\n            | _ => fun () => null ()","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  // Native Rust: runs to completion on the calling thread (std executor), as the future isn't `Send`; F# returns at once
  // and runs it on the thread pool.
  inl start (a : async ()) : () =
      if rust.is_native ()
      then a |> run_synchronously
      else
          run_target function
              | Fsharp _
              | TypeScript _ => fun () =>
                  a |> $'Async.Start'
              | _ => fun () => null ()
  """,
  timeout: 300_000
)
```

