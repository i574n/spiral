= depth = 1, 0\n\n    x' |> rust::fix_closure depth\n\n    !\\($'\"__future_init\"')\n\n:= new_future \\* t. (x : () -> t) : future_pin t =\n    := result = future_init !- x\n    !\\($'\"!result\"')\n\n:= new_future_move \\* t. (x : () -> t) : future_pin t =\n    := result = future_init !+ x\n    !\\($'\"!result\"')\n\n:= new_future_send \\* t. (x : () -> t) : future_pin_send t =\n    := result = future_init !- x\n    !\\($'\"!result\"')\n\n:= new_future_move_send \\* t. (x : () -> t) : future_pin_send t =\n    := result = future_init !+ x\n    !\\($'\"!result\"')\n\n:! async_python t =\n    `(\n        backend_switch `(()) `({}) {\n            Python = (\\ () => global \"import asyncio\") : () -> ()\n        }\n        $'' : $'any'\n    )\n:== async_switch t =\n    {\n        Fsharp : $'Async<`t>'\n        Python : async_python t\n        Rust : $'std::pin::Pin<Box<dyn std::future::Future<Output = `t>>>'\n    }\n:! async t = $'backend_switch `(async_switch t)'\n\n:! task t =\n    `(\n        ?: t ?|\n        | () => $'' : $'System.Threading.Tasks.Task'\n        | _ => $'' : $'System.Threading.Tasks.Task<`t>'\n    )\n\n:= new_task \\* t. (fn : () -> t) : task t =\n    run_target_args' fn \\|\n        | Fsharp _ => \\ fn =>\n            := result : optionm'::option' (task t) = optionm'::none' ()\n            $'let mutable _new_task_!result = !result '\n            $'task {'\n            fn () |> ignore\n            $'}'\n            $'|> fun x -> _new_task_!result <- Some x'\n            $'match _new_task_!result with Some x -> x | None -> failwith \"async.new_task / _new_task_!result=None\"'\n        | _ => \\ _ => null ()\n\n:= await_task \\* t. (a : task t) : async t =\n    run_target \\|\n        | Fsharp _\n        | TypeScript _ => \\ () =>\n            a |> $'Async.AwaitTask'\n        | _ => \\ () => null ()\n\n:= future_of_async \\* t. (a : async t) : future_pin t =\n    $'!a' : future_pin t\n\n:= async_of_future \\* t. (f : future_pin t) : async t =\n    $'!f' : async t\n\n:! poll t =\n    `(\n        rust::rust_type\n            `($'std_task_Poll<`t>')\n            `($'std::task::Poll<`t>')\n            \"type std_task_Poll<'T> = class end\"\n    )\n\n:! context =\n    `(\n        rust::rust_type\n            `($'std_task_Context')\n            `($'std::task::Context')\n            \"type std_task_Context = class end\"\n    )\n\n:! waker =\n    `(\n        rust::rust_type\n            `($'std_task_Waker')\n            `($'std::task::Waker')\n            \"type std_task_Waker = class end\"\n    )\n\n:! thread_handle =\n    `(\n        rust::rust_type\n            `($'std_thread_Thread')\n            `($'std::thread::Thread')\n            \"type std_thread_Thread = class end\"\n    )\n\n:= current_thread () : thread_handle =\n    $'std::thread::current()' : thread_handle\n\n:= thread_park () : () =\n    $'std::thread::park()' : ()\n\n:= thread_waker_types () =\n    global \"struct SpiralThreadWaker(std::thread::Thread);\"\n    global \"impl std::task::Wake for SpiralThreadWaker { fn wake(self: std::sync::Arc<Self>) { self.0.unpark() } }\"\n\n:= thread_waker (thread : thread_handle) : waker =\n    thread_waker_types ()\n    $'std::task::Waker::from(std::sync::Arc::new(SpiralThreadWaker(!thread)))' : waker\n\n:= context_of_waker (w : rust::ref waker) : context =\n    $'std::task::Context::from_waker(!w)' : context\n\n:= poll_once \\* t. (f : rust::ref (rust::mut' (future_pin t))) (cx : rust::ref (rust::mut' context)) : poll t =\n    $'std::future::Future::poll((!f).as_mut(), !cx)' : poll t\n\n:= poll_ready \\* t. (x : t) : poll t =\n    $'std::task::Poll::Ready(!x)' : poll t\n\n:= poll_pending \\* t. () : poll t =\n    $'std::task::Poll::Pending' : poll t\n\n:= poll_option \\* t. (p : poll t) : optionm'::option' t =\n    $'match !p { std::task::Poll::Ready(v) => Some(v), std::task::Poll::Pending => None }' : optionm'::option' t\n\n:= poll_fn \\* t. (body : rust::ref (rust::mut' context) -> poll t) : future_pin t =\n    (!\\($'\"true; let __poll_fn = Box::pin(std::future::poll_fn(move |__poll_cx: &mut std::task::Context| { //\"') : bool)\n    |> ignore\n    (!\\\\(body ($'__poll_cx' : rust::ref (rust::mut' context)), $'\"true; $0 }))\"') : bool) |> ignore\n    !\\($'\"__poll_fn\"')\n\n:= catch_unwind_poll \\* t.\n    (f : rust::ref (rust::mut' (future_pin t)))\n    (cx : rust::ref (rust::mut' context))\n    : rust_caught (poll t)\n    =\n    $'std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| std::future::Future::poll((!f).as_mut(), !cx)))'\n    : rust_caught (poll t)\n\n:= run_synchronously_rust \\* t. (a : async t) : t =\n    := waker = current_thread () |> thread_waker\n    := context = waker |> rust::to_ref |> context_of_waker\n    := future = a |> future_of_async\n    future |> rust::to_mut\n    context |> rust::to_mut\n    := result = mut (optionm'::none' ())\n    rust::loop 0 \\ () =>\n        := polled = poll_once (rust::to_ref_mut future) (rust::to_ref_mut context) |> poll_option\n        result <- polled\n        := _ =\n            ? optionm'::is_none' polled ?>\n                thread_park ()\n                !-\n            |:\n                rust::break ()\n                !+\n        ()\n    *result |> optionm'::unwrap\n\n:= caught_poll \\* t. (caught : rust_caught (poll t)) : poll (resultm::result' t exn) =\n    ? rust_caught_ok caught ?>\n        := polled = caught |> rust_caught_value |> poll_option\n        ? optionm'::is_none' polled ?> poll_pending () |: polled |> optionm'::unwrap |> resultm::ok'' |> poll_ready\n    |: caught |> rust_caught_payload |> rust_panic_text |> rust_exn_of_text |> resultm::err |> poll_ready\n\n:= ignore \\* t. (a : async t) : async () =\n    ? is_rust ()\n    ?> new_future_move (\\ () => a |> future_of_async |> await |> ignore) |> async_of_future\n    |:\n        run_target \\|\n            | Fsharp _\n            | TypeScript _ => \\ () =>\n                a |> $'Async.Ignore'\n            | _ => \\ () => null ()\n\n:= run_synchronously \\* t. (a : async t) : t =\n    run_target \\|\n        | Fsharp _ => \\ () =>\n            a |> $'Async.RunSynchronously'\n        | Cuda => \\ () =>\n            $'asyncio.run(!a())'\n        | Rust => \\ () => run_synchronously_rust a\n        | _ => \\ () => null ()\n\n:= catch_rust \\* t. (a : async t) : async (resultm::result' t exn) =\n    := future = a |> future_of_async\n    future |> rust::to_mut\n    poll_fn \\ cx => rust_quietly (\\ () => catch_unwind_poll (rust::to_ref_mut future) cx |> caught_poll)\n    |> async_of_future\n\n:= start (a : async ()) : () =\n    ? is_rust ()\n    ?> a |> run_synchronously\n    |:\n        run_target \\|\n            | Fsharp _\n            | TypeScript _ => \\ () =>\n                a |> $'Async.Start'\n            | _ => \\ () => null ()\n\n:! task_canceled_exception = $'System.Threading.Tasks.TaskCanceledException'\n\n:= sleep (ms : i32) : async () =\n    run_target \\|\n        | Fsharp _\n        | TypeScript _ => \\ () =>\n            ms |> $'Async.Sleep'\n        | Cuda _ => \\ () =>\n            $'asyncio.sleep(!ms / 1000)'\n        | Rust => \\ () =>\n            new_future_move (\\ () => threading::sleep ms) |> async_of_future\n        | _ => \\ () => null ()\n\n:= do (a : async ()) : () =\n    backend_switch {\n        Fsharp = \\ () => $'do\\! !a ' : ()\n        Python = \\ () => $'await !a ' : ()\n    }\n\n:= let' \\* t. (a : async t) : t =\n    $'let\\! !a = !a '\n    $'!a '\n\n:= return_await' \\* t. (a : async t) : t =\n    backend_switch {\n        Fsharp = \\ () => $'return\\! !a ' : ()\n        Python = \\ () => $'await !a()' : ()\n    }\n\n:= catch' \\* t e. (a : async t) : async (choice2' t e) =\n    ? is_rust ()\n    ?>\n        := r = a |> catch_rust\n        $'(!r)' : async (choice2' t e)\n    |:\n        run_target \\|\n            | Fsharp _\n            | TypeScript _ => \\ () =>\n                a |> $'Async.Catch'\n            | _ => \\ () => null ()\n\n:= cancellation_token () : async threading::cancellation_token =\n    $'Async.CancellationToken'\n\n:! value_task = $'System.Threading.Tasks.ValueTask'\n\n:= value_task_as_task (task : value_task) : task () =\n    run_target \\|\n        | Fsharp => \\ () => $'!task.AsTask' ()\n        | _ => \\ () => null ()\n\n:= main () =\n    ()","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  :< rust_operators

  := base_let' x =
      let' x

  :! future t =
      `(
          rust::rust_type
              `($'std_future_Future<`t>')
              `($'std::future::Future<Output = `t>')
              "type std_future_Future<'T> = class end"
      )

  :== future_pin t = rust::pin (rust::box (rust::dyn' (future t)))

  :== future_pin_send t = rust::pin (rust::box (rust::send (rust::dyn' (future t))))

  := block_on_tokio \* t. (fn : future_pin t) : t =
      := runtime : infer =
          !\($'$"tokio::runtime::Builder::new_multi_thread().enable_all().build().unwrap()"')
      !\\(fn, $'"!runtime.handle().block_on($0)"')

  := block_on_futures \* t. (fn : future_pin t) : t =
      !\\(fn, $'"futures::executor::block_on($0)"')

  :! stream_ext_tokio =
      `(
          rust::rust_type
              `($'tokio_stream_StreamExt')
              `($'tokio_stream::StreamExt')
              "type tokio_stream_StreamExt = class end"
      )

  :! join_handle_tokio t =
      `(
          rust::rust_type
              `($'tokio_task_JoinHandle<`t>')
              `($'tokio::task::JoinHandle<`t>')
              "type tokio_task_JoinHandle<'T> = class end"
      )

  := stream_collect_futures \* t u.
      (stream : t)
      : future_pin (am'::vec u)
      =
      !\($'"Box::pin(futures::stream::StreamExt::collect(!stream))"')

  := stream_filter_map_futures \* t u v.
      (fn : u -> optionm'::option' v)
      (stream : t)
      : infer' v
      =
      := fn = ~~ fn
      !\($'"futures::stream::StreamExt::filter_map(!stream, |x| async { !fn(x) })"')

  :! try_join_all t =
      `(
          rust::rust_type
              `($'futures_future_TryJoinAll<`t>')
              `($'futures::future::TryJoinAll<`t>')
              "type futures_future_TryJoinAll<'T> = class end"
      )

  := try_join_all \* t.
      (x : am'::vec (future_pin (resultm::result' t sm'::std_string)))
      : try_join_all (future_pin (resultm::result' t sm'::std_string))
      =
      := x = ~~ x
      !\($'"futures::future::try_join_all(!x)"')

  :! fuse_tokio t =
      `(
          rust::rust_type
              `($'tokio_prelude_stream_Fuse<`t>')
              `($'tokio::prelude::stream::Fuse<`t>')
              "type tokio_prelude_stream_Fuse<'T> = class end"
      )

  :== fuse' t = fuse_tokio t

  :! join_all t =
      `(
          rust::rust_type
              `($'futures_future_JoinAll<`t>')
              `($'futures::future::JoinAll<`t>')
              "type futures_future_JoinAll<'T> = class end"
      )

  := join_all \* t. (x : am'::vec (future_pin t)) : join_all (future_pin t) =
      := x = ~~ x
      !\($'"futures::future::join_all(!x)"')

  :== join_handle' t = join_handle_tokio t

  := try_await_all \* t.
      (x : try_join_all (future_pin (resultm::result' t sm'::std_string)))
      : resultm::result' (am'::vec t) sm'::std_string
      =
      !\($'"!x.await"')

  := await \* t. (x : future_pin t) : t =
      !\($'"!x.await"')

  := await_send \* t. (x : future_pin_send t) : t =
      !\($'"!x.await"')

  :== into_iter t = array_base t

  := into_par_iter \* t. (x : am'::vec t) : into_iter t =
      x |> am'::from_vec_base

  := par_map \* t u. (fn : t -> u) (ar : into_iter t) : into_iter u =
      := n : i32 = $'(!ar.borrow().len() as i32)'
      :~ ^ loop (i : i32) (acc : am'::vec u) : am'::vec u =
          ? i < n ?> loop (i + 1) (acc |> am'::vec_push (fn (am'::index_base i ar))) |: acc
      loop 0 (am'::new_vec []) |> am'::from_vec_base

  := par_collect \* t. (iter : into_iter t) : am'::vec t =
      iter |> am'::to_vec

  := future_init \* t. (move : bool) (x : () -> t) : infer' t =
      (!\($'"true; let __future_init = Box::pin(/*"') : bool) |> ignore
      ? move
      ?> (!\($'"*/ async move { /*"') : bool) |> ignore
      |: (!\($'"*/ async { /*"') : bool) |> ignore
      (!\($'"*/ ()"') : bool) |> ignore

      := x' = x ()

      := depth = 1, 0

      x' |> rust::fix_closure depth

      !\($'"__future_init"')

  := new_future \* t. (x : () -> t) : future_pin t =
      := result = future_init !- x
      !\($'"!result"')

  := new_future_move \* t. (x : () -> t) : future_pin t =
      := result = future_init !+ x
      !\($'"!result"')

  := new_future_send \* t. (x : () -> t) : future_pin_send t =
      := result = future_init !- x
      !\($'"!result"')

  := new_future_move_send \* t. (x : () -> t) : future_pin_send t =
      := result = future_init !+ x
      !\($'"!result"')

  :! async_python t =
      `(
          backend_switch `(()) `({}) {
              Python = (\ () => global "import asyncio") : () -> ()
          }
          $'' : $'any'
      )
  :== async_switch t =
      {
          Fsharp : $'Async<`t>'
          Python : async_python t
          Rust : $'std::pin::Pin<Box<dyn std::future::Future<Output = `t>>>'
      }
  :! async t = $'backend_switch `(async_switch t)'

  :! task t =
      `(
          ?: t ?|
          | () => $'' : $'System.Threading.Tasks.Task'
          | _ => $'' : $'System.Threading.Tasks.Task<`t>'
      )

  := new_task \* t. (fn : () -> t) : task t =
      run_target_args' fn \|
          | Fsharp _ => \ fn =>
              := result : optionm'::option' (task t) = optionm'::none' ()
              $'let mutable _new_task_!result = !result '
              $'task {'
              fn () |> ignore
              $'}'
              $'|> fun x -> _new_task_!result <- Some x'
              $'match _new_task_!result with Some x -> x | None -> failwith "async.new_task / _new_task_!result=None"'
          | _ => \ _ => null ()

  := await_task \* t. (a : task t) : async t =
      run_target \|
          | Fsharp _
          | TypeScript _ => \ () =>
              a |> $'Async.AwaitTask'
          | _ => \ () => null ()

  := future_of_async \* t. (a : async t) : future_pin t =
      $'!a' : future_pin t

  := async_of_future \* t. (f : future_pin t) : async t =
      $'!f' : async t

  :! poll t =
      `(
          rust::rust_type
              `($'std_task_Poll<`t>')
              `($'std::task::Poll<`t>')
              "type std_task_Poll<'T> = class end"
      )

  :! context =
      `(
          rust::rust_type
              `($'std_task_Context')
              `($'std::task::Context')
              "type std_task_Context = class end"
      )

  :! waker =
      `(
          rust::rust_type
              `($'std_task_Waker')
              `($'std::task::Waker')
              "type std_task_Waker = class end"
      )

  :! thread_handle =
      `(
          rust::rust_type
              `($'std_thread_Thread')
              `($'std::thread::Thread')
              "type std_thread_Thread = class end"
      )

  := current_thread () : thread_handle =
      $'std::thread::current()' : thread_handle

  := thread_park () : () =
      $'std::thread::park()' : ()

  := thread_waker_types () =
      global "struct SpiralThreadWaker(std::thread::Thread);"
      global "impl std::task::Wake for SpiralThreadWaker { fn wake(self: std::sync::Arc<Self>) { self.0.unpark() } }"

  := thread_waker (thread : thread_handle) : waker =
      thread_waker_types ()
      $'std::task::Waker::from(std::sync::Arc::new(SpiralThreadWaker(!thread)))' : waker

  := context_of_waker (w : rust::ref waker) : context =
      $'std::task::Context::from_waker(!w)' : context

  := poll_once \* t. (f : rust::ref (rust::mut' (future_pin t))) (cx : rust::ref (rust::mut' context)) : poll t =
      $'std::future::Future::poll((!f).as_mut(), !cx)' : poll t

  := poll_ready \* t. (x : t) : poll t =
      $'std::task::Poll::Ready(!x)' : poll t

  := poll_pending \* t. () : poll t =
      $'std::task::Poll::Pending' : poll t

  := poll_option \* t. (p : poll t) : optionm'::option' t =
      $'match !p { std::task::Poll::Ready(v) => Some(v), std::task::Poll::Pending => None }' : optionm'::option' t

  := poll_fn \* t. (body : rust::ref (rust::mut' context) -> poll t) : future_pin t =
      (!\($'"true; let __poll_fn = Box::pin(std::future::poll_fn(move |__poll_cx: &mut std::task::Context| { //"') : bool)
      |> ignore
      (!\\(body ($'__poll_cx' : rust::ref (rust::mut' context)), $'"true; $0 }))"') : bool) |> ignore
      !\($'"__poll_fn"')

  := catch_unwind_poll \* t.
      (f : rust::ref (rust::mut' (future_pin t)))
      (cx : rust::ref (rust::mut' context))
      : rust_caught (poll t)
      =
      $'std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| std::future::Future::poll((!f).as_mut(), !cx)))'
      : rust_caught (poll t)

  := run_synchronously_rust \* t. (a : async t) : t =
      := waker = current_thread () |> thread_waker
      := context = waker |> rust::to_ref |> context_of_waker
      := future = a |> future_of_async
      future |> rust::to_mut
      context |> rust::to_mut
      := result = mut (optionm'::none' ())
      rust::loop 0 \ () =>
          := polled = poll_once (rust::to_ref_mut future) (rust::to_ref_mut context) |> poll_option
          result <- polled
          := _ =
              ? optionm'::is_none' polled ?>
                  thread_park ()
                  !-
              |:
                  rust::break ()
                  !+
          ()
      *result |> optionm'::unwrap

  := caught_poll \* t. (caught : rust_caught (poll t)) : poll (resultm::result' t exn) =
      ? rust_caught_ok caught ?>
          := polled = caught |> rust_caught_value |> poll_option
          ? optionm'::is_none' polled ?> poll_pending () |: polled |> optionm'::unwrap |> resultm::ok'' |> poll_ready
      |: caught |> rust_caught_payload |> rust_panic_text |> rust_exn_of_text |> resultm::err |> poll_ready

  := ignore \* t. (a : async t) : async () =
      ? is_rust ()
      ?> new_future_move (\ () => a |> future_of_async |> await |> ignore) |> async_of_future
      |:
          run_target \|
              | Fsharp _
              | TypeScript _ => \ () =>
                  a |> $'Async.Ignore'
              | _ => \ () => null ()

  := run_synchronously \* t. (a : async t) : t =
      run_target \|
          | Fsharp _ => \ () =>
              a |> $'Async.RunSynchronously'
          | Cuda => \ () =>
              $'asyncio.run(!a())'
          | Rust => \ () => run_synchronously_rust a
          | _ => \ () => null ()

  := catch_rust \* t. (a : async t) : async (resultm::result' t exn) =
      := future = a |> future_of_async
      future |> rust::to_mut
      poll_fn \ cx => rust_quietly (\ () => catch_unwind_poll (rust::to_ref_mut future) cx |> caught_poll)
      |> async_of_future

  := start (a : async ()) : () =
      ? is_rust ()
      ?> a |> run_synchronously
      |:
          run_target \|
              | Fsharp _
              | TypeScript _ => \ () =>
                  a |> $'Async.Start'
              | _ => \ () => null ()

  :! task_canceled_exception = $'System.Threading.Tasks.TaskCanceledException'

  := sleep (ms : i32) : async () =
      run_target \|
          | Fsharp _
          | TypeScript _ => \ () =>
              ms |> $'Async.Sleep'
          | Cuda _ => \ () =>
              $'asyncio.sleep(!ms / 1000)'
          | Rust => \ () =>
              new_future_move (\ () => threading::sleep ms) |> async_of_future
          | _ => \ () => null ()

  := do (a : async ()) : () =
      backend_switch {
          Fsharp = \ () => $'do\! !a ' : ()
          Python = \ () => $'await !a ' : ()
      }

  := let' \* t. (a : async t) : t =
      $'let\! !a = !a '
      $'!a '

  := return_await' \* t. (a : async t) : t =
      backend_switch {
          Fsharp = \ () => $'return\! !a ' : ()
          Python = \ () => $'await !a()' : ()
      }

  := catch' \* t e. (a : async t) : async (choice2' t e) =
      ? is_rust ()
      ?>
          := r = a |> catch_rust
          $'(!r)' : async (choice2' t e)
      |:
          run_target \|
              | Fsharp _
              | TypeScript _ => \ () =>
                  a |> $'Async.Catch'
              | _ => \ () => null ()

  := cancellation_token () : async threading::cancellation_token =
      $'Async.CancellationToken'

  :! value_task = $'System.Threading.Tasks.ValueTask'

  := value_task_as_task (task : value_task) : task () =
      run_target \|
          | Fsharp => \ () => $'!task.AsTask' ()
          | _ => \ () => null ()

  := main () =
      ()
  """,
  timeout: 300_000
)
```

#### run_synchronously_drives_a_future_to_its_value (test)

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":"///- --test --symbol\n///> rust\n\n:= ~n = 41i32\nnew_future_move (\\ () => n + 1i32) |> async_of_future |> run_synchronously |> _assert_eq 42i32","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  ///- --test --symbol
  ///> rust

  := ~n = 41i32
  new_future_move (\ () => n + 1i32) |> async_of_future |> run_synchronously |> _assert_eq 42i32
  """,
  timeout: 300_000
)
```

