<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":":< rust_operators\n\n:= base_let' x =\n    let' x\n\n:! future t =\n    `(\n        rust::rust_type\n            `($'std_future_Future<`t>')\n            `($'std::future::Future<Output = `t>')\n            \"type std_future_Future<'T> = class end\"\n    )\n\n:== future_pin t = rust::pin (rust::box (rust::dyn' (future t)))\n\n:== future_pin_send t = rust::pin (rust::box (rust::send (rust::dyn' (future t))))\n\n:= block_on_tokio \\* t. (fn : future_pin t) : t =\n    := runtime : infer =\n        !\\($'$\"tokio::runtime::Builder::new_multi_thread().enable_all().build().unwrap()\"')\n    !\\\\(fn, $'\"!runtime.handle().block_on($0)\"')\n\n:= block_on_futures \\* t. (fn : future_pin t) : t =\n    !\\\\(fn, $'\"futures::executor::block_on($0)\"')\n\n:! stream_ext_tokio =\n    `(\n        rust::rust_type\n            `($'tokio_stream_StreamExt')\n            `($'tokio_stream::StreamExt')\n            \"type tokio_stream_StreamExt = class end\"\n    )\n\n:! join_handle_tokio t =\n    `(\n        rust::rust_type\n            `($'tokio_task_JoinHandle<`t>')\n            `($'tokio::task::JoinHandle<`t>')\n            \"type tokio_task_JoinHandle<'T> = class end\"\n    )\n\n:= stream_collect_futures \\* t u.\n    (stream : t)\n    : future_pin (am'::vec u)\n    =\n    !\\($'\"Box::pin(futures::stream::StreamExt::collect(!stream))\"')\n\n:= stream_filter_map_futures \\* t u v.\n    (fn : u -> optionm'::option' v)\n    (stream : t)\n    : infer' v\n    =\n    := fn = ~~ fn\n    !\\($'\"futures::stream::StreamExt::filter_map(!stream, |x| async { !fn(x) })\"')\n\n:! try_join_all t =\n    `(\n        rust::rust_type\n            `($'futures_future_TryJoinAll<`t>')\n            `($'futures::future::TryJoinAll<`t>')\n            \"type futures_future_TryJoinAll<'T> = class end\"\n    )\n\n:= try_join_all \\* t.\n    (x : am'::vec (future_pin (resultm::result' t sm'::std_string)))\n    