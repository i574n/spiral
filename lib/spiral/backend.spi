inl backend_switch forall t. x : t =
    real
        inl backend (key : string) : t =
            inl s = real_core.string_lit_to_symbol key
            real_core.record_type_try_find `(`x) s
                (forall v'. => (x s) ())
                fun () =>
                    !!!!BackendSwitch({
                        Gleam = fun () =>
                            $'Nil // backend.backend_switch / record_type_try_find / key: !key ' : t
                        Lua = fun () =>
                            $'print("backend.backend_switch / record_type_try_find")' : t
                        Fsharp = fun () =>
                            $'() // backend.backend_switch / record_type_try_find / key: !key ' : t
                        Python = fun () =>
                            $'None ## backend.backend_switch / record_type_try_find / key: !key ' : t
                        Cpp = fun () =>
                            $'nullptr // backend.backend_switch / record_type_try_find / key: !key ' : t
                        Rust = fun () =>
                            typecase t with
                            | () => $'() /* backend_switch: no Rust arm (lib/spiral) */' : t
                            | _ =>
                                $'compile_error\!("backend_switch: this lib/spiral function has no Rust arm yet")' : t
                        CppHost = fun () =>
                            $'nullptr // backend.backend_switch / record_type_try_find / key: !key ' : t
                        Zig = fun () =>
                            typecase t with
                            | () => $'{}' : t
                            | _ => $'\@compileError("backend_switch: this lib/spiral function has no Zig arm yet")' : t
                        Lean = fun () =>
                            typecase t with
                            | () => $'pure ()' : t
                            | _ => $'backend_switch_has_no_Lean_arm_in_lib_spiral' : t
                        TypeScript = fun () =>
                            typecase t with
                            | () => $'undefined /* backend_switch: no TypeScript arm (lib/spiral) */' : t
                            | _ => $'(() => { throw new Error("backend_switch: this lib/spiral function has no \
                                TypeScript arm yet") })()' : t
                        C = fun () =>
                            typecase t with
                            | () => $'((void)0)' : t
                            | _ => $'backend_switch_has_no_C_arm_in_lib_spiral' : t
                        Delphi = fun () =>
                            typecase t with
                            | () => $'' : t
                            | _ => $'backend_switch_has_no_Delphi_arm_in_lib_spiral' : t
                        Wasm = fun () =>
                            typecase t with
                            | () => $'' : t
                            | _ => $'backend_switch_has_no_Wasm_arm_in_lib_spiral' : t
                        Bend = fun () =>
                            typecase t with
                            | () => () : t
                            | _ => $'backend_switch_has_no_Bend_arm_in_lib_spiral' : t
                        Kotlin = fun () =>
                            typecase t with
                            | () => $'' : t
                            | _ => $'backend_switch_has_no_Kotlin_arm_in_lib_spiral' : t
                        Swift = fun () =>
                            typecase t with
                            | () => $'' : t
                            | _ => $'backend_switch_has_no_Swift_arm_in_lib_spiral' : t
                    })
        !!!!BackendSwitch({
            Gleam = fun () => backend "Gleam"
            Lua = fun () => backend "Lua"
            Fsharp = fun () => backend "Fsharp"
            Python = fun () => backend "Python"
            Cpp = fun () => backend "Cpp"
            Rust = fun () => backend "Rust"
            CppHost = fun () => backend "Cpp"
            TypeScript = fun () => backend "TypeScript"
            Zig = fun () => backend "Zig"
            Lean = fun () => backend "Lean"
            C = fun () => backend "C"
            Delphi = fun () => backend "Delphi"
            Wasm = fun () => backend "Wasm"
            Bend = fun () => backend "Bend"
            Kotlin = fun () => backend "Kotlin"
            Swift = fun () => backend "Swift"
        })

union backend =
    | Gleam
    | Lua
    | Fsharp
    | Cuda
    | Cpp
    | Rust
    | TypeScript
    | Zig
    | C
    | Lean
    | Delphi
    | Wasm
    | Bend
    | Kotlin
    | Swift

inl run_target_args' forall t u. (args : u) (fn : backend -> (u -> t)) : t =
    backend_switch {
        Gleam = fun () =>
            inl target = Gleam
            fn target args
        Lua = fun () =>
            inl target = Lua
            fn target args
        Fsharp = fun () =>
            inl target = Fsharp
            fn target args
        Python = fun () =>
            inl target = Cuda
            fn target args
        Cpp = fun () =>
            inl target = Cpp
            fn target args
        Rust = fun () =>
            inl target = Rust
            fn target args
        TypeScript = fun () =>
            inl target = TypeScript
            fn target args
        CppHost = fun () =>
            inl target = Cpp
            fn target args
        Zig = fun () =>
            inl target = Zig
            fn target args
        C = fun () =>
            inl target = C
            fn target args
        Lean = fun () =>
            inl target = Lean
            fn target args
        Delphi = fun () =>
            inl target = Delphi
            fn target args
        Wasm = fun () =>
            inl target = Wasm
            fn target args
        Bend = fun () =>
            inl target = Bend
            fn target args
        Kotlin = fun () =>
            inl target = Kotlin
            fn target args
        Swift = fun () =>
            inl target = Swift
            fn target args
    }

/// ### is_rust
inl is_rust () : bool =
    backend_switch {
        Gleam = fun () => false
        Lua = fun () => false
        Fsharp = fun () => false
        Python = fun () => false
        TypeScript = fun () => false
        Cpp = fun () => false
        CppHost = fun () => false
        Delphi = fun () => false
        Cuda = fun () => false
        Zig = fun () => false
        Lean = fun () => false
        Kotlin = fun () => false
        Swift = fun () => false
        Rust = fun () => true
    }

/// ### is_zig
inl is_zig () : bool =
    backend_switch {
        Gleam = fun () => false
        Lua = fun () => false
        Fsharp = fun () => false
        Python = fun () => false
        TypeScript = fun () => false
        Cpp = fun () => false
        CppHost = fun () => false
        Delphi = fun () => false
        Cuda = fun () => false
        Zig = fun () => true
        Lean = fun () => false
        Rust = fun () => false
        C = fun () => false
        Wasm = fun () => false
        Bend = fun () => false
        Kotlin = fun () => false
        Swift = fun () => false
    }

inl run_target_args forall t u. (args : () -> u) (fn : backend -> (u -> t)) : t =
    inl args = args () |> dyn
    fn |> run_target_args' args

inl run_target forall t. (fn : backend -> (() -> t)) : t =
    run_target_args id fn

inl indent (body : () -> ()) : () =
    backend_switch {
        Gleam = fun () =>
            !!!!Indent(body ())
            ()
        Lua = fun () =>
            !!!!Indent(body ())
            ()
        Fsharp = fun () =>
            inl body () =
                body ()
                $'(* indent' : ()
            !!!!Indent(body ())
            $'indent *)' : ()
        Python = fun () =>
            !!!!Indent(body ())
            ()
        Zig = fun () =>
            !!!!Indent(body ())
            ()
        Lean = fun () =>
            !!!!Indent(body ())
            ()
    }

/// ### rust.rust_type
