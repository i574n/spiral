inl backend_switch forall t. x : t =
    real
        inl backend (key : string) : t =
            inl s = real_core.string_lit_to_symbol key
            real_core.record_type_try_find `(`x) s
                (forall v'. => (x s) ())
                (fun () =>
                    // inl x = ()
                        // typecase t with
                        // | ~t => $'"`t"' : string
                    !!!!BackendSwitch ({
                        Gleam = fun () =>
                            $'Nil // backend.backend_switch / record_type_try_find / key: !key ' : t
                        Lua = fun () =>
                            $'print("backend.backend_switch / record_type_try_find")' : t
                        Fsharp = fun () =>
                            $'() // backend.backend_switch / record_type_try_find / key: !key ' : t
                        Python = fun () =>
                            $'None ## backend.backend_switch / record_type_try_find / key: !key ' : t
                        Cpp = fun () =>
                            $'nullptr // backend.backend_switch / record_type_try_find / key: !key ' : t
                        // Native Rust (codegenRust). Every key of a BackendSwitch is evaluated in every build, so a
                        // missing arm can't fail partial evaluation (that would break the F# builds too). A unit arm
                        // is a visible no-op, like the other backends' fallbacks; a value arm is a rustc error, which
                        // only fires when native Rust code actually reaches the call.
                        Rust = fun () =>
                            typecase t with
                            | () => $'() /* backend_switch: no native Rust arm (lib/spiral) */' : t
                            | _ => $'compile_error\!("backend_switch: this lib/spiral function has no native Rust arm yet")' : t
                        // C++ host (upstream CodegenCpp names its host backend CppHost).
                        CppHost = fun () =>
                            $'nullptr // backend.backend_switch / record_type_try_find / key: !key ' : t
                        // Native TypeScript (CodegenTypescript): no lib/spiral arms yet.
                        TypeScript = fun () =>
                            typecase t with
                            | () => $'undefined /* backend_switch: no native TypeScript arm (lib/spiral) */' : t
                            | _ => $'(() => { throw new Error("backend_switch: this lib/spiral function has no native TypeScript arm yet") })()' : t
                    })
                )
        !!!!BackendSwitch ({
            Gleam = fun () => backend "Gleam"
            Lua = fun () => backend "Lua"
            Fsharp = fun () => backend "Fsharp"
            Python = fun () => backend "Python"
            Cpp = fun () => backend "Cpp"
            Rust = fun () => backend "Rust"
            // User records keep their `Cpp` key for the C++ host, like the type-level backend_switch in CodegenCpp.
            CppHost = fun () => backend "Cpp"
            TypeScript = fun () => backend "TypeScript"
        })

union target =
    | Wasm
    | Contract

// `RustNative` is the native Rust backend (codegenRust, `--backend Rust`), kept apart from the Fable `Rust`
// target so that a library arm never serves both: `Rust _` arms are F# text for Fable, `RustNative` arms Rust text.
union backend =
    | Gleam
    | Lua
    | Fsharp
    | Cuda
    | Cpp
    | Rust : option target
    | RustNative
    | TypeScript

inl run_target_args' forall t u. (args : u) (fn : backend -> (u -> t)) : t =
    backend_switch {
        Gleam = fun () =>
            inl target = Gleam
            fn target args
        Lua = fun () =>
            inl target = Lua
            fn target args
        // The .NET build: only the Fsharp arm (Fable's targets, once evaluated here under `#if FABLE_COMPILER`, are gone).
        Fsharp = fun () =>
            inl target = Fsharp
            fn target args
        Python = fun () =>
            inl target = Cuda
            fn target args
        Cpp = fun () =>
            inl target = Cpp
            fn target args
        Rust = fun () =>
            inl target = RustNative
            fn target args
        // Native TypeScript: the `TypeScript` target, as Fable's; arms tell them apart with typescript.is_native ().
        TypeScript = fun () =>
            inl target = TypeScript
            fn target args
        CppHost = fun () =>
            inl target = Cpp
            fn target args
    }

inl run_target_args forall t u. (args : () -> u) (fn : backend -> (u -> t)) : t =
    inl args = args () |> dyn
    fn |> run_target_args' args

inl run_target forall t. (fn : backend -> (() -> t)) : t =
    run_target_args id fn

inl indent (body : () -> ()) : () =
    backend_switch {
        Gleam = fun () =>
            !!!!Indent (body())
            ()
        Lua = fun () =>
            !!!!Indent (body())
            ()
        Fsharp = fun () =>
            inl body () =
                body ()
                $'(* indent' : ()
            !!!!Indent (body())
            $'indent *)' : ()
        Python = fun () =>
            !!!!Indent (body())
            ()
    }

/// ### native_type
// A type that is `rs` on the native Rust backend and `fs` on the other backends, through the type-level backend_switch
// every codegen resolves; `fsharp` declares `fs` in F# builds only (an opaque `type x = class end`, or an alias of a
// .NET type). Used as `native_type `(fs) `(rs) "decl"` in a nominal's body (unqualified: backend is opened everywhere,
// --real cells and modules that open rust.rust_operators included). lib/spiral's Rust types were Fable `[<Emit>]` aliases that codegenRust read back out of the F# globals.
type native_type_switch fs rs =
    {
        Gleam : fs
        Lua : fs
        Fsharp : fs
        Python : fs
        TypeScript : fs
        Cpp : fs
        CppHost : fs
        Delphi : fs
        Cuda : fs
        Rust : rs
    }

// A global only F# builds emit. In a nominal's body it runs once (nominal types are memoized), under whichever backend's
// branch first elaborates the type; the switch runs its Fsharp arm as F# either way, so the text reaches F# builds only.
inl fsharp_global (text : string) : () =
    backend_switch {
        Fsharp = fun () => global text
    }

inl native_type forall fs rs. (fsharp : string) : $'backend_switch `(native_type_switch fs rs)' =
    fsharp_global fsharp
    $'' : $'backend_switch `(native_type_switch fs rs)'
