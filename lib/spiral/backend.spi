inl backend_switch forall t. x : t =
    real
        inl backend (key : string) : t =
            inl s = real_core.string_lit_to_symbol key
            real_core.record_type_try_find `(`x) s
                (forall v'. => (x s) ())
                (fun () =>
                    !!!!BackendSwitch ({
                        Gleam = fun () =>
                            $'Nil // backend.backend_switch / record_type_try_find / key: !key ' : t
                        Lua = fun () =>
                            $'print("backend.backend_switch / record_type_try_find")' : t
                        Fsharp = fun () =>
                            $'() // backend.backend_switch / record_type_try_find / key: !key ' : t
                        Python = fun () =>
                            $'None ## backend.backend_switch / record_type_try_find / key: !key ' : t
                        Cpp = fun () =>
                            $'nullptr // backend.backend_switch / record_type_try_find / key: !key ' : t
                        Rust = fun () =>
                            typecase t with
                            | () => $'() /* backend_switch: no Rust arm (lib/spiral) */' : t
                            | _ => $'compile_error\!("backend_switch: this lib/spiral function has no Rust arm yet")' : t
                        CppHost = fun () =>
                            $'nullptr // backend.backend_switch / record_type_try_find / key: !key ' : t
                        Zig = fun () =>
                            typecase t with
                            | () => $'{}' : t
                            | _ => $'\@compileError("backend_switch: this lib/spiral function has no Zig arm yet")' : t
                        Lean = fun () =>
                            typecase t with
                            | () => $'pure ()' : t
                            | _ => $'backend_switch_has_no_Lean_arm_in_lib_spiral' : t
                        TypeScript = fun () =>
                            typecase t with
                            | () => $'undefined /* backend_switch: no TypeScript arm (lib/spiral) */' : t
                            | _ => $'(() => { throw new Error("backend_switch: this lib/spiral function has no TypeScript arm yet") })()' : t
                        C = fun () =>
                            typecase t with
                            | () => $'((void)0)' : t
                            | _ => $'backend_switch_has_no_C_arm_in_lib_spiral' : t
                        Delphi = fun () =>
                            typecase t with
                            | () => $'' : t
                            | _ => $'backend_switch_has_no_Delphi_arm_in_lib_spiral' : t
                        Wasm = fun () =>
                            typecase t with
                            | () => $'' : t
                            | _ => $'backend_switch_has_no_Wasm_arm_in_lib_spiral' : t
                    })
                )
        !!!!BackendSwitch ({
            Gleam = fun () => backend "Gleam"
            Lua = fun () => backend "Lua"
            Fsharp = fun () => backend "Fsharp"
            Python = fun () => backend "Python"
            Cpp = fun () => backend "Cpp"
            Rust = fun () => backend "Rust"
            CppHost = fun () => backend "Cpp"
            TypeScript = fun () => backend "TypeScript"
            Zig = fun () => backend "Zig"
            Lean = fun () => backend "Lean"
            C = fun () => backend "C"
            Delphi = fun () => backend "Delphi"
            Wasm = fun () => backend "Wasm"
        })

union backend =
    | Gleam
    | Lua
    | Fsharp
    | Cuda
    | Cpp
    | Rust
    | TypeScript

inl run_target_args' forall t u. (args : u) (fn : backend -> (u -> t)) : t =
    backend_switch {
        Gleam = fun () =>
            inl target = Gleam
            fn target args
        Lua = fun () =>
            inl target = Lua
            fn target args
        Fsharp = fun () =>
            inl target = Fsharp
            fn target args
        Python = fun () =>
            inl target = Cuda
            fn target args
        Cpp = fun () =>
            inl target = Cpp
            fn target args
        Rust = fun () =>
            inl target = Rust
            fn target args
        TypeScript = fun () =>
            inl target = TypeScript
            fn target args
        CppHost = fun () =>
            inl target = Cpp
            fn target args
    }

/// ### is_rust
inl is_rust () : bool =
    backend_switch {
        Gleam = fun () => false
        Lua = fun () => false
        Fsharp = fun () => false
        Python = fun () => false
        TypeScript = fun () => false
        Cpp = fun () => false
        CppHost = fun () => false
        Delphi = fun () => false
        Cuda = fun () => false
        Zig = fun () => false
        Lean = fun () => false
        Rust = fun () => true
    }

inl run_target_args forall t u. (args : () -> u) (fn : backend -> (u -> t)) : t =
    inl args = args () |> dyn
    fn |> run_target_args' args

inl run_target forall t. (fn : backend -> (() -> t)) : t =
    run_target_args id fn

inl indent (body : () -> ()) : () =
    backend_switch {
        Gleam = fun () =>
            !!!!Indent (body())
            ()
        Lua = fun () =>
            !!!!Indent (body())
            ()
        Fsharp = fun () =>
            inl body () =
                body ()
                $'(* indent' : ()
            !!!!Indent (body())
            $'indent *)' : ()
        Python = fun () =>
            !!!!Indent (body())
            ()
        Zig = fun () =>
            !!!!Indent (body())
            ()
        Lean = fun () =>
            !!!!Indent (body())
            ()
    }

/// ### rust_type
type rust_type_switch fs rs =
    {
        Gleam : fs
        Lua : fs
        Fsharp : fs
        Python : fs
        TypeScript : fs
        Cpp : fs
        CppHost : fs
        Delphi : fs
        Cuda : fs
        Zig : fs
        Lean : fs
        Rust : rs
    }

inl fsharp_global (text : string) : () =
    backend_switch {
        Fsharp = fun () => global text
    }

inl rust_type forall fs rs. (fsharp : string) : $'backend_switch `(rust_type_switch fs rs)' =
    fsharp_global fsharp
    $'' : $'backend_switch `(rust_type_switch fs rs)'
