### let'

#!spiral

inl let' fn =
    inl result : unit =
        backend_switch {
            Gleam = fun () => $'Nil' : unit
            Lua = fun () => $'nil' : unit
            Fsharp = fun () => $'()' : unit
            Python = fun () => $'None' : unit
        }
    backend_switch {
        Gleam = fun () =>
            $'let _let\'_!result = {' : ()
            fn |> indent
            $'}' : ()
        Lua = fun () =>
            $'local _get_let_!result = function()' : ()
            fn |> indent
            $'end' : ()
            $'local _let_!result = _get_let_!result()' : ()
        Fsharp = fun () =>
            $'let _let\'_!result =' : ()
            fn |> indent
        Python = fun () =>
            $'def _let\'_!result():' : ()
            fn |> indent
    }
    $'_let\'_!result '

#!markdown

### exec_unit

#!spiral

inl exec_unit (fn : () -> ()) : () =
    backend_switch {
        Gleam = fun () => fn ()
        Lua = fun () => fn ()
        Fsharp = fun () =>
            inl unit = $'()' : $'unit'
            ($'(fun () -> !fn (); !unit) ()' : $'unit') |> ignore
        Python = fun () => fn ()
        Rust = fun () => fn ()
        TypeScript = fun () => fn ()
    }

