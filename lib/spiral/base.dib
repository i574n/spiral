#!markdown

### use

#!spiral

inl use forall t. (x : t) : t =
    backend_switch {
        Gleam = fun () => $'use !x = !x ' : ()
        Lua = fun () => $'use !x = !x ' : ()
        Fsharp = fun () => $'use !x = !x ' : ()
        Python = fun () => $'use !x = !x ' : ()
        Cpp = fun () => $'use !x = !x ' : ()
        TypeScript = fun () => $'use !x = !x ' : ()
        // Native Rust: F#'s `use` disposes at the end of the scope; a Drop guard over the disposable's closure.
        Rust = fun () =>
            global "struct SpiralUse(std::rc::Rc<dyn Fn()>);\nimpl Drop for SpiralUse {\n    fn drop(&mut self) { (self.0)() }\n}"
            $'let _spiral_use = SpiralUse((!x).clone())' : ()
    }
    $'!x '

