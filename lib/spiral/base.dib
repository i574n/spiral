### pair

#!spiral

type pair_switch a b =
    {
        Gleam : $'\#(`a, `b  )'
        Lua : $'(`a, `b)'
        Fsharp : $'(`a * `b)'
        Python : $'(`a, `b)'
        Rust : $'(`a, `b)'
    }
nominal pair a b = $'backend_switch `(pair_switch a b)'

inl pair x y =
    x, y

#!spiral

///- --test
///> gleam
///> fsharp
///> cuda
///> rust
///> typescript

pair 1i32 2i32
|> _assert_eq (1, 2)

#!markdown

### new_pair

#!spiral

inl new_pair forall a b. (a : a) (b : b) : pair a b =
    backend_switch {
        Gleam = fun () =>
            $'\#(!a, !b )' : pair a b
        Lua = fun () =>
            $'{!a, !b}' : pair a b
        Fsharp = fun () =>
            $'!a, !b ' : pair a b
        Python = fun () =>
            $'!a, !b ' : pair a b
        Rust = fun () =>
            // the tuple takes its fields: a join point's arguments are the codegen's copies (`.clone()`, or a move for a
            // type without Clone), so a field value used again or captured by an `Fn` closure stays usable
            inl a, b = join (a, b)
            $'(!a, !b)' : pair a b
    }

#!markdown

### from_pair

#!spiral

inl from_pair forall a b. (pair : pair a b) : a * b =
    backend_switch {
        Gleam = fun () =>
            $'let \#(a, b) = !pair '
            ($'a' : a), ($'b' : b)
        Lua = fun () =>
            $'local a, b = !pair[1], !pair[2]'
            ($'a' : a), ($'b' : b)
        Fsharp = fun () =>
            $'let (a, b) = !pair '
            ($'a' : a), ($'b' : b)
        Python = fun () =>
            $'a, b = !pair '
            ($'a' : a), ($'b' : b)
        Rust = fun () => ($'!pair.0.clone()' : a), ($'!pair.1.clone()' : b)
    }

#!spiral

///- --test
///> gleam
///> fsharp
///> cuda
///> rust
///> typescript

new_pair "a" (new_pair 1i32 "b")
|> from_pair
|> _assert_eq' ("a", (new_pair 1i32 "b"))

