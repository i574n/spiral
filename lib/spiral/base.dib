#!markdown

### try

#!spiral

// Native Rust only: runs `fn` under `catch_unwind`; a panic (the native exception: failwith panics with its message)
// goes to `ex_fn` as its message. While `fn` runs, this thread's panic reports are suppressed (F#'s try ... with prints
// nothing): the call site installs, once, a panic hook that defers to the previous one unless its thread-local
// counter is set, so nested and concurrent sites compose. A panic=abort build (wasm32, contracts) aborts instead, and
// there the hook always reports (it is the only report before the abort).
inl catch_unwind_native forall t. (fn : () -> t) (ex_fn : exn -> t) : t =
    inl fn = dyn fn
    inl ex_fn = dyn ex_fn
    $'{ thread_local\! { static QUIET: std::cell::Cell<u32> = std::cell::Cell::new(0); } static HOOK: std::sync::Once = std::sync::Once::new(); HOOK.call_once(|| { let prev = std::panic::take_hook(); std::panic::set_hook(Box::new(move |info| if cfg\!(panic = "abort") || QUIET.with(|q| q.get()) == 0 { prev(info) })) }); QUIET.with(|q| q.set(q.get() + 1)); let r = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| (!fn)())); QUIET.with(|q| q.set(q.get() - 1)); match r { Ok(x) => x, Err(e) => (!ex_fn)(Rc::<str>::from(e.downcast_ref::<String>().map(|s| s.as_str()).or_else(|| e.downcast_ref::<&str>().copied()).unwrap_or("panic"))) } }' : t

inl try forall t. (fn : () -> t) (ex_fn : exn -> option t) : option t =
    inl some x : option t = Some x
    inl some = dyn some
    inl fn = dyn fn
    inl ex_fn = dyn ex_fn
    backend_switch {
        Gleam = fun () =>
            fn () |> some
        Lua = fun () =>
            fn () |> some
        Fsharp = fun () =>
            $'let result = ref !(None : option t)'
            $'try'
            $'    result.Value <- !fn () |> !some '
            $'with ex ->'
            $'    result.Value <- !ex_fn ex '
            $'result.Value' : option t
        Python = fun () =>
            $'result = !(None : option t)'
            inl fn = dyn fn
            inl ex_fn = dyn ex_fn
            $'try:'
            $'    result = !some(!fn())\n        \'\'\''
            $'\'\'\''
            $'except Exception as e:'
            $'    result = !ex_fn(e)'
            $'result' : option t
        // Native Rust: a panic is the exception (caught where unwinding is on; a panic=abort build aborts).
        Rust = fun () =>
            catch_unwind_native (fun () => some (fn ())) ex_fn
    }

#!spiral

///- --test
///> fsharp
///> cuda
///> rust
///> typescript

try
    fun () => a ;[ 0i32 ] |> am'.index 1i32 |> sm'.format
    (fun ex => $'!ex ' |> sm'.format_exception |> Some)
|> optionm.value
|> _assert_eq (run_target function
    | Gleam => fun () => null ()
    | Lua => fun () => null ()
    | Fsharp => fun () => join "System.IndexOutOfRangeException: Index was outside the bounds of the array."
    | Cuda => fun () => "index 1 is out of bounds for axis 0 with size 1"
    | Cpp => fun () => null ()
    | Rust => fun () => "Exception { message: \"index out of bounds: the len is 1 but the index is 1\" }"
    | RustNative => fun () => "index out of bounds: the len is 1 but the index is 1"
    | TypeScript => fun () => "Error: Index was outside the bounds of the array.\\nParameter name: index"
)

#!spiral

///- --test
///> gleam
///> fsharp
///> cuda
///> rust
///> typescript

try
    fun () => a ;[ 0i32 ] |> am'.index 0i32 |> sm'.format
    (fun ex => $'!ex ' |> sm'.format_exception |> Some)
|> optionm.value
|> _assert_eq "0"

#!markdown

### try_unit

#!spiral

// F# and Python: try_unit / try_finally as one-line try statements over the closures
inl try_unit_fsharp_python () : bool =
    backend_switch {
        Gleam = fun () => false
        Lua = fun () => false
        Fsharp = fun () => true
        Python = fun () => true
        TypeScript = fun () => false
        Cpp = fun () => false
        CppHost = fun () => false
        Delphi = fun () => false
        Cuda = fun () => false
        Rust = fun () => false
    }

inl try_unit forall t. (fn : () -> ()) (ex_fn : (() -> exn) -> ()) : t =
    inl native =
        backend_switch {
            Gleam = fun () => false
            Lua = fun () => false
            Fsharp = fun () => false
            Python = fun () => false
            TypeScript = fun () => false
            Cpp = fun () => false
            CppHost = fun () => false
            Delphi = fun () => false
            Cuda = fun () => false
            Rust = fun () => true
        }
    if native
    then
        // Native Rust: a panic is the exception (catch_unwind_native).
        catch_unwind_native fn (fun ex => ex_fn fun () => ex)
        $'()' : t
    elif try_unit_fsharp_python ()
    then
        inl fn = dyn fn
        inl ex_fn = dyn ex_fn
        backend_switch {
            Fsharp = fun () =>
                $'try !fn () with ex -> !ex_fn (fun () -> ex)' : ()
                $'()' : t
            // (a helper def: the Python codegen puts `del` lines after a variable's last use, which would split a
            // try/except written inline)
            Python = fun () =>
                global "def _spiral_try_unit(fn, ex_fn):\n    try: fn()\n    except Exception as ex: ex_fn(lambda: ex)"
                $'_spiral_try_unit(!fn, !ex_fn)' : ()
                $'None' : t
        }
    else
        backend_switch {
            Gleam = fun () => $'// base.try_unit' : ()
            Lua = fun () => $'-- base.try_unit' : ()
            Fsharp = fun () => $'try' : ()
            Python = fun () => $'try:' : ()
        }
        fn |> indent
        backend_switch {
            Gleam = fun () => $'// base.try_unit' : ()
            Lua = fun () => $'-- base.try_unit' : ()
            Fsharp = fun () => $'with ex ->' : ()
            Python = fun () => $'except Exception as ex:' : ()
        }
        fun () =>
            inl ex = $'ex'
            backend_switch {
                Fsharp = fun () => $'()' : ()
            }
            inl ex () =
                ex
            ex_fn ex
        |> indent
        backend_switch {
            Gleam = fun () => $'// base.try_unit' : ()
            Lua = fun () => $'-- base.try_unit' : ()
            Fsharp = fun () =>
                $'|> ignore'
                $'(* try_unit'
                $'try_unit *)' : t
            Python = fun () => $'None' : t
        }

#!markdown

### try_unit'

#!spiral

inl try_unit' forall t. (ex_fn : (() -> exn) -> ()) (fn : () -> ()) : t =
    try_unit fn ex_fn

#!markdown

### try_finally

#!spiral

inl try_finally forall t. (fn : () -> ()) (finally : () -> ()) : t =
    inl native =
        backend_switch {
            Gleam = fun () => false
            Lua = fun () => false
            Fsharp = fun () => false
            Python = fun () => false
            TypeScript = fun () => false
            Cpp = fun () => false
            CppHost = fun () => false
            Delphi = fun () => false
            Cuda = fun () => false
            Rust = fun () => true
        }
    if native
    then
        // Native Rust: `finally` runs after `fn` returns or panics; the panic then continues unwinding.
        inl fn = dyn fn
        inl finally = dyn finally
        $'{ let r = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| (!fn)())); (!finally)(); if let Err(e) = r { std::panic::resume_unwind(e) } }' : ()
        $'()' : t
    elif try_unit_fsharp_python ()
    then
        inl fn = dyn fn
        inl finally = dyn finally
        backend_switch {
            Fsharp = fun () =>
                $'try !fn () finally !finally ()' : ()
                $'()' : t
            Python = fun () =>
                global "def _spiral_try_finally(fn, finally_fn):\n    try: fn()\n    finally: finally_fn()"
                $'_spiral_try_finally(!fn, !finally)' : ()
                $'None' : t
        }
    else
        backend_switch {
            Gleam = fun () => $'// base.try_finally' : ()
            Lua = fun () => $'-- base.try_finally' : ()
            Fsharp = fun () => $'try' : ()
            Python = fun () => $'try:' : ()
        }
        fn |> indent
        backend_switch {
            Gleam = fun () => $'// base.try_finally' : ()
            Lua = fun () => $'-- base.try_finally' : ()
            Fsharp = fun () => $'finally' : ()
            Python = fun () => $'finally:' : ()
        }
        finally |> indent
        backend_switch {
            Gleam = fun () => $'// base.try_finally' : ()
            Lua = fun () => $'-- base.try_finally' : ()
            Fsharp = fun () =>
                $'(* try_finally'
                $'try_finally *)'
                ()
            Python = fun () => $'// base.try_finally' : ()
        }

#!markdown

### (:>)

#!spiral

prototype (~:>) r : forall t. t -> r
