#!markdown

### run_target (test)

#!spiral

///- --test
///> gleam
///> lua
///> fsharp
///> cuda
///> rust
///> typescript

run_target function
    | Gleam => fun () => $'1 + 1'
    | Lua => fun () => $'1 + 1'
    | Fsharp => fun () => $'1uy + 1uy'
    | Cuda => fun () => $'1 + 1'
    | Rust (None) => fun () => $'1uy + 1uy'
    | RustNative => fun () => $'1u8 + 1u8'
    | TypeScript => fun () => $'1uy + 1uy'
    | _ => fun () => $'2uy + 2uy'
|> _assert_eq 2u8

