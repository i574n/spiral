### try_finally

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"inl try_finally forall t. (fn : () -> ()) (finally : () -> ()) : t =\n    if is_rust ()\n    then\n        // Rust: `finally` runs after `fn` returns or panics; the panic then continues unwinding.\n        inl fn = dyn fn\n        inl finally = dyn finally\n        $'{ let r = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| (!fn)())); (!finally)(); if let Err(e) = r { std::panic::resume_unwind(e) } }' : ()\n        $'()' : t\n    elif try_unit_fsharp_python ()\n    then\n        inl fn = dyn fn\n        inl finally = dyn finally\n        backend_switch {\n            Fsharp = fun () =>\n                $'try !fn () finally !finally ()' : ()\n                $'()' : t\n            Python = fun () =>\n                global \"def _spiral_try_finally(fn, finally_fn):\\n    try: fn()\\n    finally: finally_fn()\"\n                $'_spiral_try_finally(!fn, !finally)' : ()\n                $'None' : t\n        }\n    else\n        backend_switch {\n            Gleam = fun () => $'// base.try_finally' : ()\n            Lua = fun () => $'-- base.try_finally' : ()\n            Fsharp = fun () => $'try' : ()\n            Python = fun () => $'try:' : ()\n        }\n        fn |> indent\n        backend_switch {\n            Gleam = fun () => $'// base.try_finally' : ()\n            Lua = fun () => $'-- base.try_finally' : ()\n            Fsharp = fun () => $'finally' : ()\n            Python = fun () => $'finally:' : ()\n        }\n        finally |> indent\n        backend_switch {\n            Gleam = fun () => $'// base.try_finally' : ()\n            Lua = fun () => $'-- base.try_finally' : ()\n            Fsharp = fun () =>\n                $'(* try_finally'\n                $'try_finally *)'\n                ()\n            Python = fun () => $'// base.try_finally' : ()\n        }","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  inl try_finally forall t. (fn : () -> ()) (finally : () -> ()) : t =
      if is_rust ()
      then
          // Rust: `finally` runs after `fn` returns or panics; the panic then continues unwinding.
          inl fn = dyn fn
          inl finally = dyn finally
          $'{ let r = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| (!fn)())); (!finally)(); if let Err(e) = r { std::panic::resume_unwind(e) } }' : ()
          $'()' : t
      elif try_unit_fsharp_python ()
      then
          inl fn = dyn fn
          inl finally = dyn finally
          backend_switch {
              Fsharp = fun () =>
                  $'try !fn () finally !finally ()' : ()
                  $'()' : t
              Python = fun () =>
                  global "def _spiral_try_finally(fn, finally_fn):\n    try: fn()\n    finally: finally_fn()"
                  $'_spiral_try_finally(!fn, !finally)' : ()
                  $'None' : t
          }
      else
          backend_switch {
              Gleam = fun () => $'// base.try_finally' : ()
              Lua = fun () => $'-- base.try_finally' : ()
              Fsharp = fun () => $'try' : ()
              Python = fun () => $'try:' : ()
          }
          fn |> indent
          backend_switch {
              Gleam = fun () => $'// base.try_finally' : ()
              Lua = fun () => $'-- base.try_finally' : ()
              Fsharp = fun () => $'finally' : ()
              Python = fun () => $'finally:' : ()
          }
          finally |> indent
          backend_switch {
              Gleam = fun () => $'// base.try_finally' : ()
              Lua = fun () => $'-- base.try_finally' : ()
              Fsharp = fun () =>
                  $'(* try_finally'
                  $'try_finally *)'
                  ()
              Python = fun () => $'// base.try_finally' : ()
          }
  """,
  timeout: 300_000
)
```

