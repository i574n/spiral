  ///- --test --print-code
  ///> gleam
  ///> fsharp
  ///> cuda
  ///> rust
  ///> typescript

  [ 5i32; 4; join 3; 2; 1 ]
  |> fold_list (fun acc n => join_body_unit ((+) acc) n n) 0
