  """,
  timeout: 300_000
)
```

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"///- --test --print-code\n///> gleam\n///> fsharp\n///> cuda\n///> rust\n///> typescript\n\n[ 5i32; 4; join 3; 2; 1 ]\n|> fold_list (fun acc n => join_body_unit ((+) acc) n n) 0\n|> _assert_eq 15","print_code":true},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
