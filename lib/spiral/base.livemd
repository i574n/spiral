### new_pair

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"inl new_pair forall a b. (a : a) (b : b) : pair a b =\n    backend_switch {\n        Gleam = fun () =>\n            $'\\#(!a, !b )' : pair a b\n        Lua = fun () =>\n            $'{!a, !b}' : pair a b\n        Fsharp = fun () =>\n            $'!a, !b ' : pair a b\n        Python = fun () =>\n            $'!a, !b ' : pair a b\n        Rust = fun () =>\n            // the tuple takes its fields: a join point's arguments are the codegen's copies (`.clone()`, or a move for a\n            // type without Clone), so a field value used again or captured by an `Fn` closure stays usable\n            inl a, b = join (a, b)\n            $'(!a, !b)' : pair a b\n        TypeScript = fun () => $'[!a, !b]' : pair a b\n    }","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  inl new_pair forall a b. (a : a) (b : b) : pair a b =
      backend_switch {
          Gleam = fun () =>
              $'\#(!a, !b )' : pair a b
          Lua = fun () =>
              $'{!a, !b}' : pair a b
          Fsharp = fun () =>
              $'!a, !b ' : pair a b
          Python = fun () =>
              $'!a, !b ' : pair a b
          Rust = fun () =>
              // the tuple takes its fields: a join point's arguments are the codegen's copies (`.clone()`, or a move for a
              // type without Clone), so a field value used again or captured by an `Fn` closure stays usable
              inl a, b = join (a, b)
              $'(!a, !b)' : pair a b
          TypeScript = fun () => $'[!a, !b]' : pair a b
      }
  """,
  timeout: 300_000
)
```

### from_pair

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"inl from_pair forall a b. (pair : pair a b) : a * b =\n    backend_switch {\n        Gleam = fun () =>\n            $'let \\#(a, b) = !pair '\n            ($'a' : a), ($'b' : b)\n        Lua = fun () =>\n            $'local a, b = !pair[1], !pair[2]'\n            ($'a' : a), ($'b' : b)\n        Fsharp = fun () =>\n            $'let (a, b) = !pair '\n            ($'a' : a), ($'b' : b)\n        Python = fun () =>\n            $'a, b = !pair '\n            ($'a' : a), ($'b' : b)\n        Rust = fun () => ($'!pair.0.clone()' : a), ($'!pair.1.clone()' : b)\n        TypeScript = fun () => ($'!pair[0]' : a), ($'!pair[1]' : b)\n    }","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  inl from_pair forall a b. (pair : pair a b) : a * b =
      backend_switch {
          Gleam = fun () =>
              $'let \#(a, b) = !pair '
              ($'a' : a), ($'b' : b)
          Lua = fun () =>
              $'local a, b = !pair[1], !pair[2]'
              ($'a' : a), ($'b' : b)
          Fsharp = fun () =>
              $'let (a, b) = !pair '
              ($'a' : a), ($'b' : b)
          Python = fun () =>
              $'a, b = !pair '
              ($'a' : a), ($'b' : b)
          Rust = fun () => ($'!pair.0.clone()' : a), ($'!pair.1.clone()' : b)
          TypeScript = fun () => ($'!pair[0]' : a), ($'!pair[1]' : b)
      }
  """,
  timeout: 300_000
)
```

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"///- --test\n///> gleam\n///> fsharp\n///> cuda\n///> rust\n///> typescript\n\nnew_pair \"a\" (new_pair 1i32 \"b\")\n|> from_pair\n|> _assert_eq' (\"a\", (new_pair 1i32 \"b\"))","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  ///- --test
  ///> gleam
  ///> fsharp
  ///> cuda
  ///> rust
  ///> typescript

  new_pair "a" (new_pair 1i32 "b")
  |> from_pair
  |> _assert_eq' ("a", (new_pair 1i32 "b"))
  """,
