### exn

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"type exn_switch =\n    {\n        Gleam : $'Nil'\n        Lua : $'nil'\n        Fsharp : $'exn'\n        Python : $'BaseException'\n        Rust : $'Rc<str>'\n        TypeScript : $'any'\n    }\nnominal exn = $'backend_switch `(exn_switch)'\n\ninl exn x =\n    x |> $'`exn '","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  type exn_switch =
      {
          Gleam : $'Nil'
          Lua : $'nil'
          Fsharp : $'exn'
          Python : $'BaseException'
          Rust : $'Rc<str>'
          TypeScript : $'any'
      }
  nominal exn = $'backend_switch `(exn_switch)'

  inl exn x =
      x |> $'`exn '
  """,
  timeout: 300_000
)
```

### try

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"// Rust only: runs `fn` under `catch_unwind`; a panic (the native exception: failwith panics with its message)\n// goes to `ex_fn` as its message. While `fn` runs, this thread's panic reports are suppressed (F#'s try ... with prints\n// nothing): the call site installs, once, a panic hook that defers to the previous one unless its thread-local\n// counter is set, so nested and concurrent sites compose. A panic=abort build (wasm32, contracts) aborts instead, and\n// there the hook always reports (it is the only report before the abort).\ninl catch_unwind_rust forall t. (fn : () -> t) (ex_fn : exn -> t) : t =\n    inl fn = dyn fn\n    inl ex_fn = dyn ex_fn\n    $'{ thread_local\\! { static QUIET: std::cell::Cell<u32> = std::cell::Cell::new(0); } static HOOK: std::sync::Once = std::sync::Once::new(); HOOK.call_once(|| { let prev = std::panic::take_hook(); std::panic::set_hook(Box::new(move |info| if cfg\\!(panic = \"abort\") || QUIET.with(|q| q.get()) == 0 { prev(info) })) }); QUIET.with(|q| q.set(q.get() + 1)); let r = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| (!fn)())); QUIET.with(|q| q.set(q.get() - 1)); match r { Ok(x) => x, Err(e) => (!ex_fn)(Rc::<str>::from(e.downcast_ref::<String>().map(|s| s.as_str()).or_else(|| e.downcast_ref::<&str>().copied()).unwrap_or(\"panic\"))) } }' : t\n\ninl try forall t. (fn : () -> t) (ex_fn : exn -> option t) : option t =\n    inl some x : option t = Some x\n    inl some = dyn some\n    inl fn = dyn fn\n    inl ex_fn = dyn ex_fn\n    backend_switch {\n        Gleam = fun () =>\n            fn () |> some\n        Lua = fun () =>\n            fn () |> some\n        Fsharp = fun () =>\n            $'let result = ref !(None : option t)'\n            $'try'\n            $'    result.Value <- !fn () |> !some '\n            $'with ex ->'\n            $'    result.Value <- !ex_fn ex '\n            $'result.Value' : option t\n        // Python: a module-level helper (independent of the indentation of the code that calls it).\n        Python = fun () =>\n            global \"def spiral_try(fn, some, ex_fn):\\n    try:\\n        return some(fn())\\n    except Exception as e:\\n        return ex_fn(e)\"\n            $'spiral_try(!fn, !some, !ex_fn)' : option t\n        // Rust: a panic is the exception (caught where unwinding is on; a panic=abort build aborts).\n        Rust = fun () =>\n            catch_unwind_rust (fun () => some (fn ())) ex_fn\n        // TypeScript: a thrown value (failwith throws an Error) is the exception.\n        TypeScript = fun () =>\n            $'(() => { try { return !some(!fn()); } catch (ex) { return !ex_fn(ex); } })()' : option t\n    }","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  // Rust only: runs `fn` under `catch_unwind`; a panic (the native exception: failwith panics with its message)
  // goes to `ex_fn` as its message. While `fn` runs, this thread's panic reports are suppressed (F#'s try ... with prints
  // nothing): the call site installs, once, a panic hook that defers to the previous one unless its thread-local
  // counter is set, so nested and concurrent sites compose. A panic=abort build (wasm32, contracts) aborts instead, and
  // there the hook always reports (it is the only report before the abort).
  inl catch_unwind_rust forall t. (fn : () -> t) (ex_fn : exn -> t) : t =
      inl fn = dyn fn
      inl ex_fn = dyn ex_fn
      $'{ thread_local\! { static QUIET: std::cell::Cell<u32> = std::cell::Cell::new(0); } static HOOK: std::sync::Once = std::sync::Once::new(); HOOK.call_once(|| { let prev = std::panic::take_hook(); std::panic::set_hook(Box::new(move |info| if cfg\!(panic = "abort") || QUIET.with(|q| q.get()) == 0 { prev(info) })) }); QUIET.with(|q| q.set(q.get() + 1)); let r = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| (!fn)())); QUIET.with(|q| q.set(q.get() - 1)); match r { Ok(x) => x, Err(e) => (!ex_fn)(Rc::<str>::from(e.downcast_ref::<String>().map(|s| s.as_str()).or_else(|| e.downcast_ref::<&str>().copied()).unwrap_or("panic"))) } }' : t

  inl try forall t. (fn : () -> t) (ex_fn : exn -> option t) : option t =
      inl some x : option t = Some x
      inl some = dyn some
      inl fn = dyn fn
      inl ex_fn = dyn ex_fn
      backend_switch {
          Gleam = fun () =>
              fn () |> some
          Lua = fun () =>
              fn () |> some
          Fsharp = fun () =>
              $'let result = ref !(None : option t)'
              $'try'
              $'    result.Value <- !fn () |> !some '
              $'with ex ->'
              $'    result.Value <- !ex_fn ex '
              $'result.Value' : option t
          // Python: a module-level helper (independent of the indentation of the code that calls it).
          Python = fun () =>
              global "def spiral_try(fn, some, ex_fn):\n    try:\n        return some(fn())\n    except Exception as e:\n        return ex_fn(e)"
              $'spiral_try(!fn, !some, !ex_fn)' : option t
          // Rust: a panic is the exception (caught where unwinding is on; a panic=abort build aborts).
          Rust = fun () =>
              catch_unwind_rust (fun () => some (fn ())) ex_fn
          // TypeScript: a thrown value (failwith throws an Error) is the exception.
          TypeScript = fun () =>
              $'(() => { try { return !some(!fn()); } catch (ex) { return !ex_fn(ex); } })()' : option t
      }
  """,
  timeout: 300_000
)
```

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"///- --test\n///> fsharp\n///> cuda\n///> rust\n///> typescript\n\ntry\n    fun () => a ;[ 0i32 ] |> am'.index 1i32 |> sm'.format\n    (fun ex => $'!ex ' |> sm'.format_exception |> Some)\n|> optionm.value\n|> _assert_eq (run_target function\n    | Gleam => fun () => null ()\n    | Lua => fun () => null ()\n    | Fsharp => fun () => join \"System.IndexOutOfRangeException: Index was outside the bounds of the array.\"\n    | Cuda => fun () => \"index 1 is out of bounds for axis 0 with size 1\"\n    | Cpp => fun () => null ()\n    | Rust => fun () => \"index out of bounds: the len is 1 but the index is 1\"\n    | TypeScript => fun () => \"RangeError: array index 1 out of bounds for length 1\"\n)","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  ///- --test
  ///> fsharp
  ///> cuda
  ///> rust
  ///> typescript

  try
      fun () => a ;[ 0i32 ] |> am'.index 1i32 |> sm'.format
      (fun ex => $'!ex ' |> sm'.format_exception |> Some)
  |> optionm.value
  |> _assert_eq (run_target function
      | Gleam => fun () => null ()
      | Lua => fun () => null ()
      | Fsharp => fun () => join "System.IndexOutOfRangeException: Index was outside the bounds of the array."
      | Cuda => fun () => "index 1 is out of bounds for axis 0 with size 1"
      | Cpp => fun () => null ()
      | Rust => fun () => "index out of bounds: the len is 1 but the index is 1"
      | TypeScript => fun () => "RangeError: array index 1 out of bounds for length 1"
  )
  """,
  timeout: 300_000
)
```

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"///- --test\n///> gleam\n///> fsharp\n///> cuda\n///> rust\n///> typescript\n\ntry\n    fun () => a ;[ 0i32 ] |> am'.index 0i32 |> sm'.format\n    (fun ex => $'!ex ' |> sm'.format_exception |> Some)\n|> optionm.value\n|> _assert_eq \"0\"","print_code":false},"livebook_object":"smart_cell"} -->

