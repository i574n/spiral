### let'

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"inl let' fn =\n    inl result : unit =\n        backend_switch {\n            Gleam = fun () => $'Nil' : unit\n            Lua = fun () => $'nil' : unit\n            Fsharp = fun () => $'()' : unit\n            Python = fun () => $'None' : unit\n        }\n    backend_switch {\n        Gleam = fun () =>\n            $'let _let\\'_!result = {' : ()\n            fn |> indent\n            $'}' : ()\n        Lua = fun () =>\n            $'local _get_let_!result = function()' : ()\n            fn |> indent\n            $'end' : ()\n            $'local _let_!result = _get_let_!result()' : ()\n        Fsharp = fun () =>\n            $'let _let\\'_!result =' : ()\n            fn |> indent\n        Python = fun () =>\n            $'def _let\\'_!result():' : ()\n            fn |> indent\n    }\n    $'_let\\'_!result '","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  inl let' fn =
      inl result : unit =
          backend_switch {
              Gleam = fun () => $'Nil' : unit
              Lua = fun () => $'nil' : unit
              Fsharp = fun () => $'()' : unit
              Python = fun () => $'None' : unit
          }
      backend_switch {
          Gleam = fun () =>
              $'let _let\'_!result = {' : ()
              fn |> indent
              $'}' : ()
          Lua = fun () =>
              $'local _get_let_!result = function()' : ()
              fn |> indent
              $'end' : ()
              $'local _let_!result = _get_let_!result()' : ()
          Fsharp = fun () =>
              $'let _let\'_!result =' : ()
              fn |> indent
          Python = fun () =>
              $'def _let\'_!result():' : ()
              fn |> indent
      }
      $'_let\'_!result '
  """,
  timeout: 300_000
)
```

