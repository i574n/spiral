### try_unit

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"// F# and Python: try_unit / try_finally as one-line try statements over the closures\ninl try_unit_fsharp_python () : bool =\n    backend_switch {\n        Gleam = fun () => false\n        Lua = fun () => false\n        Fsharp = fun () => true\n        Python = fun () => true\n        TypeScript = fun () => false\n        Cpp = fun () => false\n        CppHost = fun () => false\n        Delphi = fun () => false\n        Cuda = fun () => false\n        Rust = fun () => false\n    }\n\ninl try_unit forall t. (fn : () -> ()) (ex_fn : (() -> exn) -> ()) : t =\n    if is_rust ()\n    then\n        // Rust: a panic is the exception (catch_unwind_rust).\n        catch_unwind_rust fn (fun ex => ex_fn fun () => ex)\n        $'()' : t\n    elif try_unit_fsharp_python ()\n    then\n        inl fn = dyn fn\n        inl ex_fn = dyn ex_fn\n        backend_switch {\n            Fsharp = fun () =>\n                $'try !fn () with ex -> !ex_fn (fun () -> ex)' : ()\n                $'()' : t\n            // (a helper def: the Python codegen puts `del` lines after a variable's last use, which would split a\n            // try/except written inline)\n            Python = fun () =>\n                global \"def _spiral_try_unit(fn, ex_fn):\\n    try: fn()\\n    except Exception as ex: ex_fn(lambda: ex)\"\n                $'_spiral_try_unit(!fn, !ex_fn)' : ()\n                $'None' : t\n        }\n    else\n        backend_switch {\n            Gleam = fun () => $'// base.try_unit' : ()\n            Lua = fun () => $'-- base.try_unit' : ()\n            Fsharp = fun () => $'try' : ()\n            Python = fun () => $'try:' : ()\n        }\n        fn |> indent\n        backend_switch {\n            Gleam = fun () => $'// base.try_unit' : ()\n            Lua = fun () => $'-- base.try_unit' : ()\n            Fsharp = fun () => $'with ex ->' : ()\n            Python = fun () => $'except Exception as ex:' : ()\n        }\n        fun () =>\n            inl ex = $'ex'\n            backend_switch {\n                Fsharp = fun () => $'()' : ()\n            }\n            inl ex () =\n                ex\n            ex_fn ex\n        |> indent\n        backend_switch {\n            Gleam = fun () => $'// base.try_unit' : ()\n            Lua = fun () => $'-- base.try_unit' : ()\n            Fsharp = fun () =>\n                $'|> ignore'\n                $'(* try_unit'\n                $'try_unit *)' : t\n            Python = fun () => $'None' : t\n        }","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  // F# and Python: try_unit / try_finally as one-line try statements over the closures
  inl try_unit_fsharp_python () : bool =
      backend_switch {
          Gleam = fun () => false
          Lua = fun () => false
          Fsharp = fun () => true
          Python = fun () => true
          TypeScript = fun () => false
          Cpp = fun () => false
          CppHost = fun () => false
          Delphi = fun () => false
          Cuda = fun () => false
          Rust = fun () => false
      }

  inl try_unit forall t. (fn : () -> ()) (ex_fn : (() -> exn) -> ()) : t =
      if is_rust ()
      then
          // Rust: a panic is the exception (catch_unwind_rust).
          catch_unwind_rust fn (fun ex => ex_fn fun () => ex)
          $'()' : t
      elif try_unit_fsharp_python ()
      then
          inl fn = dyn fn
          inl ex_fn = dyn ex_fn
          backend_switch {
              Fsharp = fun () =>
                  $'try !fn () with ex -> !ex_fn (fun () -> ex)' : ()
                  $'()' : t
              // (a helper def: the Python codegen puts `del` lines after a variable's last use, which would split a
              // try/except written inline)
              Python = fun () =>
                  global "def _spiral_try_unit(fn, ex_fn):\n    try: fn()\n    except Exception as ex: ex_fn(lambda: ex)"
                  $'_spiral_try_unit(!fn, !ex_fn)' : ()
                  $'None' : t
          }
      else
          backend_switch {
              Gleam = fun () => $'// base.try_unit' : ()
              Lua = fun () => $'-- base.try_unit' : ()
              Fsharp = fun () => $'try' : ()
              Python = fun () => $'try:' : ()
          }
          fn |> indent
          backend_switch {
              Gleam = fun () => $'// base.try_unit' : ()
              Lua = fun () => $'-- base.try_unit' : ()
              Fsharp = fun () => $'with ex ->' : ()
              Python = fun () => $'except Exception as ex:' : ()
          }
          fun () =>
              inl ex = $'ex'
              backend_switch {
                  Fsharp = fun () => $'()' : ()
              }
              inl ex () =
                  ex
              ex_fn ex
          |> indent
          backend_switch {
              Gleam = fun () => $'// base.try_unit' : ()
              Lua = fun () => $'-- base.try_unit' : ()
              Fsharp = fun () =>
                  $'|> ignore'
                  $'(* try_unit'
                  $'try_unit *)' : t
              Python = fun () => $'None' : t
          }
  """,
  timeout: 300_000
)
```

