### defaultof

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"inl rec defaultof forall t. (() : ()) : t =\n    inl run default =\n        real\n            typecase t with\n            | string => \"\"\n            | int => 0\n            | char => '\\0'\n            | ~a * ~b => (defaultof `a ()), (defaultof `b ())\n            | option ~u => None `u\n            | ~t =>\n                if real_core.union_type_is `t then\n                    real_core.union_untag `t 0\n                        (fun k => forall v. => real_core.nominal_create `t (k, ()))\n                        (fun _ => failwith `t ($'\"defaultof / invalid tag\"' : string))\n                else default ()\n    backend_switch {\n        Gleam = fun () => run (fun () => ($'\"base.defaultof / invalid type / t: `t\"') : t) : t\n        Lua = fun () => run (fun () => ($'\"base.defaultof / invalid type / t: `t\"') : t) : t\n        Fsharp = fun () => run (fun () => $'Unchecked.defaultof<`t>' : t) : t\n        // Python: the F# defaults (Unchecked.defaultof) of the primitives the typecase above doesn't list.\n        Python = fun () =>\n            run (fun () =>\n                real\n                    typecase t with\n                    | i8 => 0i8\n                    | i16 => 0i16\n                    | i64 => 0i64\n                    | u8 => 0u8\n                    | u16 => 0u16\n                    | u32 => 0u32\n                    | u64 => 0u64\n                    | f32 => 0.0f32\n                    | f64 => 0.0f64\n                    | bool => false\n                    | _ => $'\"base.defaultof / invalid type / t: `t\"' : t\n                : t\n            ) : t\n        Rust = fun () => run (fun () => $'Default::default()' : t) : t\n    }","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  inl rec defaultof forall t. (() : ()) : t =
      inl run default =
          real
              typecase t with
              | string => ""
              | int => 0
              | char => '\0'
              | ~a * ~b => (defaultof `a ()), (defaultof `b ())
              | option ~u => None `u
              | ~t =>
                  if real_core.union_type_is `t then
                      real_core.union_untag `t 0
                          (fun k => forall v. => real_core.nominal_create `t (k, ()))
                          (fun _ => failwith `t ($'"defaultof / invalid tag"' : string))
                  else default ()
      backend_switch {
          Gleam = fun () => run (fun () => ($'"base.defaultof / invalid type / t: `t"') : t) : t
          Lua = fun () => run (fun () => ($'"base.defaultof / invalid type / t: `t"') : t) : t
          Fsharp = fun () => run (fun () => $'Unchecked.defaultof<`t>' : t) : t
          // Python: the F# defaults (Unchecked.defaultof) of the primitives the typecase above doesn't list.
          Python = fun () =>
              run (fun () =>
                  real
                      typecase t with
                      | i8 => 0i8
                      | i16 => 0i16
                      | i64 => 0i64
                      | u8 => 0u8
                      | u16 => 0u16
                      | u32 => 0u32
                      | u64 => 0u64
                      | f32 => 0.0f32
                      | f64 => 0.0f64
                      | bool => false
                      | _ => $'"base.defaultof / invalid type / t: `t"' : t
                  : t
              ) : t
          Rust = fun () => run (fun () => $'Default::default()' : t) : t
      }
  """,
  timeout: 300_000
)
```

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"///- --test\n///> gleam\n///> fsharp\n\nreal defaultof `string ()\n|> _assert_eq \"\"\n\nreal defaultof `i32 ()\n|> _assert_eq 0i32\n\nreal defaultof `(option string) ()\n|> _assert_eq (None : option string)","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  ///- --test
  ///> gleam
  ///> fsharp

  real defaultof `string ()
  |> _assert_eq ""

  real defaultof `i32 ()
  |> _assert_eq 0i32

  real defaultof `(option string) ()
  |> _assert_eq (None : option string)
  """,
  timeout: 300_000
)
```

### choice2'

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"// Rust: `Result` (Choice1Of2 = Ok, Choice2Of2 = Err), the shape async.catch' produces.\ntype choice2_switch a b =\n    {\n        Gleam : $'Choice<`a, `b>'\n        Lua : $'Choice<`a, `b>'\n        Fsharp : $'Choice<`a, `b>'\n        Python : $'Choice<`a, `b>'\n        Rust : $'Result<`a, `b>'\n    }\nnominal choice2' a b = $'backend_switch `(choice2_switch a b)'","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  // Rust: `Result` (Choice1Of2 = Ok, Choice2Of2 = Err), the shape async.catch' produces.
  type choice2_switch a b =
      {
          Gleam : $'Choice<`a, `b>'
          Lua : $'Choice<`a, `b>'
          Fsharp : $'Choice<`a, `b>'
          Python : $'Choice<`a, `b>'
          Rust : $'Result<`a, `b>'
      }
  nominal choice2' a b = $'backend_switch `(choice2_switch a b)'
  """,
  timeout: 300_000
)
```

### choice2_unbox

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"inl choice2_unbox forall t1 t2. (choice : choice2' t1 t2) : choice2 t1 t2 =\n    run_target_args (fun () => choice) function\n        | Fsharp _ => fun choice =>\n            inl c1of2 (x : t1) : _ _ t2 = C1of2 x\n            inl c2of2 (x : t2) : _ t1 _ = C2of2 x\n            inl c1of2 = join c1of2\n            inl c2of2 = join c2of2\n            $'match !choice with Choice1Of2 x -> !c1of2 x | Choice2Of2 x -> !c2of2 x'\n        | Rust => fun choice =>\n            inl c1of2 (x : t1) : _ _ t2 = C1of2 x\n            inl c2of2 (x : t2) : _ t1 _ = C2of2 x\n            inl c1of2 = join c1of2\n            inl c2of2 = join c2of2\n            $'match !choice { Ok(x) => (!c1of2)(x), Err(x) => (!c2of2)(x) }'\n        | _ => fun _ => null ()","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  inl choice2_unbox forall t1 t2. (choice : choice2' t1 t2) : choice2 t1 t2 =
      run_target_args (fun () => choice) function
          | Fsharp _ => fun choice =>
              inl c1of2 (x : t1) : _ _ t2 = C1of2 x
              inl c2of2 (x : t2) : _ t1 _ = C2of2 x
              inl c1of2 = join c1of2
              inl c2of2 = join c2of2
              $'match !choice with Choice1Of2 x -> !c1of2 x | Choice2Of2 x -> !c2of2 x'
          | Rust => fun choice =>
              inl c1of2 (x : t1) : _ _ t2 = C1of2 x
              inl c2of2 (x : t2) : _ t1 _ = C2of2 x
              inl c1of2 = join c1of2
              inl c2of2 = join c2of2
              $'match !choice { Ok(x) => (!c1of2)(x), Err(x) => (!c2of2)(x) }'
          | _ => fun _ => null ()
  """,
  timeout: 300_000
)
```

