Spiral.Kino.eval!(
  ~S"""
  ///- --test
  ///> gleam
  ///> fsharp
  ///> cuda
  ///> rust
  ///> typescript

  try
      fun () => a ;[ 0i32 ] |> am'.index 0i32 |> sm'.format
      (fun ex => $'!ex ' |> sm'.format_exception |> Some)
  |> optionm.value
  |> _assert_eq "0"
  """,
  timeout: 300_000
)
