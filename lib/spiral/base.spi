/// # base

/// ## base

/// ### emit
inl emit forall t. (x : t) : t =
    $'!x '

/// ### emit_unit
inl emit_unit forall t. (x : t) : () =
    $'!x '

/// ### use
inl use forall t. (x : t) : t =
    backend_switch {
        Gleam = fun () => $'use !x = !x ' : ()
        Lua = fun () => $'use !x = !x ' : ()
        Fsharp = fun () => $'use !x = !x ' : ()
        Python = fun () => $'use !x = !x ' : ()
        Cpp = fun () => $'use !x = !x ' : ()
        TypeScript = fun () => $'use !x = !x ' : ()
        Rust = fun () =>
            global "struct SpiralUse(std::rc::Rc<dyn Fn()>);\nimpl Drop for SpiralUse {\n    fn drop(&mut self) { (self.0)() }\n}"
            $'let _spiral_use = SpiralUse((!x).clone())' : ()
    }
    $'!x '

/// ### unit
nominal unit = $'unit'

/// ### eval
inl eval fn =
    fn ()

/// ### flip
inl flip fn a b =
    fn b a

/// ### do
inl do (body : () -> ()) : () =
    !!!!Do (body())

/// ### let'
inl let' fn =
    inl result : unit =
        backend_switch {
            Gleam = fun () => $'Nil' : unit
            Lua = fun () => $'nil' : unit
            Fsharp = fun () => $'()' : unit
            Python = fun () => $'None' : unit
        }
    backend_switch {
        Gleam = fun () =>
            $'let _let\'_!result = {' : ()
            fn |> indent
            $'}' : ()
        Lua = fun () =>
            $'local _get_let_!result = function()' : ()
            fn |> indent
            $'end' : ()
            $'local _let_!result = _get_let_!result()' : ()
        Fsharp = fun () =>
            $'let _let\'_!result =' : ()
            fn |> indent
        Python = fun () =>
            $'def _let\'_!result():' : ()
            fn |> indent
    }
    $'_let\'_!result '

/// ### exec_unit
inl exec_unit (fn : () -> ()) : () =
    fn ()

/// ### lazy
nominal lazy t = $'Lazy<`t>'

/// ### memoize
inl memoize forall t. (fn : () -> t) : () -> t =
    inl body () =
        inl result = mut None
        inl computed = mut false
        fun () =>
            if *computed
            then *result
            else
                result <- fn () |> Some
                computed <- true
                *result
            |> optionm.value
        : () -> t
    backend_switch {
        Gleam = fun () => body ()
        Lua = fun () => body ()
        Fsharp = fun () =>
            inl result : lazy t = $'lazy !fn ()'
            fun () => $'!result.Value' : t
        Python = fun () => body ()
        Rust = fun () => body ()
        TypeScript = fun () => body ()
        Zig = fun () => body ()
        Lean = fun () => body ()
    }

/// ### capture
inl capture forall t. (fn : () -> t) : t =
    backend_switch {
        Gleam = fun () =>
            fn ()
        Lua = fun () =>
            fn ()
        Fsharp = fun () =>
            inl result = dyn true
            $'let mutable _capture_!result : `t option = None '
            $'('
            $'(fun () ->'
            $'(fun () ->'
            fn () |> emit_unit
            $')'
            $'|> fun x -> x ()'
            $') () )'
            $'|> fun x -> _capture_!result <- Some x'
            $'match _capture_!result with Some x -> x | None -> failwith "base.capture / _capture_!result=None"' : t
        Python = fun () =>
            fn ()
        Rust = fun () => fn ()
        Zig = fun () => fn ()
        Lean = fun () => fn ()
    }

/// ### yield_from
inl yield_from forall (t : * -> *) u. (a : t u) : () =
    backend_switch {
        Fsharp = fun () => $'yield\! !a ' : ()
        Python = fun () => $'asyncio.run(!a())' : ()
    }

/// ### join_body
inl join_body body acc x =
    if var_is x |> not
    then body acc x
    else
        inl acc = dyn acc
        join body acc x

/// ### join_body_unit
inl join_body_unit body d x =
    if var_is d |> not
    then body x
    else
        inl x = dyn x
        join body x

/// ### (+.)
inl (+.) forall t. (a : t) (b : t) : t =
    !!!!Add(a,b)

/// ### (-.)
inl (-.) forall t. (a : t) (b : t) : t =
    !!!!Sub(a,b)

/// ### (*.)
inl (*.) forall t. (a : t) (b : t) : t =
    !!!!Mult(a,b)

/// ### (/.)
inl (/.) forall t. (a : t) (b : t) : t =
    !!!!Div(a,b)

/// ### (=.)
inl (=.) forall t. (a : t) (b : t) : bool =
    backend_switch {
        Gleam = fun () => $'!a == !b ' : bool
        Lua = fun () => $'!a == !b ' : bool
        Fsharp = fun () => $'!a = !b ' : bool
        Python = fun () => $'!a == !b ' : bool
        Rust = fun () => $'!a == !b ' : bool
        TypeScript = fun () => $'!a === !b ' : bool
        Zig = fun () =>
            if (real typecase t with string => true | _ => false)
            then $'std.mem.eql(u8, !a, !b)' : bool
            else $'(!a == !b)' : bool
        Lean = fun () => $'(!a == !b)' : bool
    }

/// ### (<>.)
inl (<>.) forall t. (a : t) (b : t) : bool =
    backend_switch {
        Gleam = fun () => $'!a \!= !b ' : bool
        Lua = fun () => $'!a ~= !b ' : bool
        Fsharp = fun () => $'!a <> !b ' : bool
        Python = fun () => $'!a \!= !b ' : bool
        Rust = fun () => $'!a \!= !b ' : bool
        TypeScript = fun () => $'!a \!== !b ' : bool
        Zig = fun () =>
            if (real typecase t with string => true | _ => false)
            then $'(\!std.mem.eql(u8, !a, !b))' : bool
            else $'(!a \!= !b)' : bool
        Lean = fun () => $'(!a \!= !b)' : bool
    }

/// ### (<>..)
inl (<>..) a b =
    fun () => a = b
    |> dyn
    |> eval
    |> not

/// ### append
prototype append t : t -> t -> t

/// ### (++)
inl (++) a b =
    b |> append a

/// ### pair
type pair_switch a b =
    {
        Gleam : $'\#(`a, `b  )'
        Lua : $'(`a, `b)'
        Fsharp : $'(`a * `b)'
        Python : $'(`a, `b)'
        Rust : $'(`a, `b)'
        TypeScript : $'[`a, `b]'
    }
nominal pair a b = $'backend_switch `(pair_switch a b)'

inl pair x y =
    x, y

/// ### new_pair
inl new_pair forall a b. (a : a) (b : b) : pair a b =
    backend_switch {
        Gleam = fun () =>
            $'\#(!a, !b )' : pair a b
        Lua = fun () =>
            $'{!a, !b}' : pair a b
        Fsharp = fun () =>
            $'!a, !b ' : pair a b
        Python = fun () =>
            $'!a, !b ' : pair a b
        Rust = fun () =>
            inl a, b = join (a, b)
            $'(!a, !b)' : pair a b
        TypeScript = fun () => $'[!a, !b]' : pair a b
    }

/// ### from_pair
inl from_pair forall a b. (pair : pair a b) : a * b =
    backend_switch {
        Gleam = fun () =>
            $'let \#(a, b) = !pair '
            ($'a' : a), ($'b' : b)
        Lua = fun () =>
            $'local a, b = !pair[1], !pair[2]'
            ($'a' : a), ($'b' : b)
        Fsharp = fun () =>
            $'let (a, b) = !pair '
            ($'a' : a), ($'b' : b)
        Python = fun () =>
            $'a, b = !pair '
            ($'a' : a), ($'b' : b)
        Rust = fun () => ($'!pair.0.clone()' : a), ($'!pair.1.clone()' : b)
        TypeScript = fun () => ($'!pair[0]' : a), ($'!pair[1]' : b)
    }

/// ### (||>)
inl (||>) (arg1, arg2) fn =
    arg2 |> fn arg1

/// ### (||>)

/// ### infer
nominal infer = $'_'

/// ### infer'
nominal infer' t = $'_'

/// ### any
nominal any = $'obj'

/// ### null
inl null forall t. () : t =
    backend_switch {
        Gleam = fun () => $'Nil' : t
        Lua = fun () => $'nil' : t
        Fsharp = fun () => $'null |> unbox<`t>' : t
        Python = fun () => $'None' : t
        TypeScript = fun () => $'null' : t
    }

/// ### defaultof
inl rec defaultof forall t. (() : ()) : t =
    inl run default =
        real
            typecase t with
            | string => ""
            | int => 0
            | char => '\0'
            | ~a * ~b => (defaultof `a ()), (defaultof `b ())
            | option ~u => None `u
            | ~t =>
                if real_core.union_type_is `t then
                    real_core.union_untag `t 0
                        (fun k => forall v. => real_core.nominal_create `t (k, ()))
                        (fun _ => failwith `t ($'"defaultof / invalid tag"' : string))
                else default ()
    backend_switch {
        Gleam = fun () => run (fun () => ($'"base.defaultof / invalid type / t: `t"') : t) : t
        Lua = fun () => run (fun () => ($'"base.defaultof / invalid type / t: `t"') : t) : t
        Fsharp = fun () => run (fun () => $'Unchecked.defaultof<`t>' : t) : t
        Python = fun () =>
            run (fun () =>
                real
                    typecase t with
                    | i8 => 0i8
                    | i16 => 0i16
                    | i64 => 0i64
                    | u8 => 0u8
                    | u16 => 0u16
                    | u32 => 0u32
                    | u64 => 0u64
                    | f32 => 0.0f32
                    | f64 => 0.0f64
                    | bool => false
                    | _ => $'"base.defaultof / invalid type / t: `t"' : t
                : t
            ) : t
        Rust = fun () => run (fun () => $'Default::default()' : t) : t
        Zig = fun () => run (fun () => $'std.mem.zeroes(`t)' : t) : t
        Lean = fun () => run (fun () => $'(default : `t)' : t) : t
    }

/// ### choice2'
type choice2_switch a b =
    {
        Gleam : $'Choice<`a, `b>'
        Lua : $'Choice<`a, `b>'
        Fsharp : $'Choice<`a, `b>'
        Python : $'Choice<`a, `b>'
        Rust : $'Result<`a, `b>'
    }
nominal choice2' a b = $'backend_switch `(choice2_switch a b)'

/// ### choice2_unbox
inl choice2_unbox forall t1 t2. (choice : choice2' t1 t2) : choice2 t1 t2 =
    run_target_args (fun () => choice) function
        | Fsharp _ => fun choice =>
            inl c1of2 (x : t1) : _ _ t2 = C1of2 x
            inl c2of2 (x : t2) : _ t1 _ = C2of2 x
            inl c1of2 = join c1of2
            inl c2of2 = join c2of2
            $'match !choice with Choice1Of2 x -> !c1of2 x | Choice2Of2 x -> !c2of2 x'
        | Rust => fun choice =>
            inl c1of2 (x : t1) : _ _ t2 = C1of2 x
            inl c2of2 (x : t2) : _ t1 _ = C2of2 x
            inl c1of2 = join c1of2
            inl c2of2 = join c2of2
            $'match !choice { Ok(x) => (!c1of2)(x), Err(x) => (!c2of2)(x) }'
        | _ => fun _ => null ()

/// ### ref
nominal ref t = $'`t ref'

/// ### new_ref
inl new_ref forall t. (x : t) : ref t =
    $'ref !x '

/// ### ref_value
inl ref_value forall t. (x : ref t) : t =
    $'!x.Value'

/// ### ref_set_value
inl ref_set_value forall t. (value : t) (ref : ref t) : ref t =
    $'!ref.Value <- !value '
    ref

/// ### exn
type exn_switch =
    {
        Gleam : $'Nil'
        Lua : $'nil'
        Fsharp : $'exn'
        Python : $'BaseException'
        Rust : $'Rc<str>'
        TypeScript : $'any'
    }
nominal exn = $'backend_switch `(exn_switch)'

inl exn x =
    x |> $'`exn '

/// ### try
inl catch_unwind_rust forall t. (fn : () -> t) (ex_fn : exn -> t) : t =
    inl fn = dyn fn
    inl ex_fn = dyn ex_fn
    $'{ thread_local\! { static QUIET: std::cell::Cell<u32> = std::cell::Cell::new(0); } static HOOK: std::sync::Once = std::sync::Once::new(); HOOK.call_once(|| { let prev = std::panic::take_hook(); std::panic::set_hook(Box::new(move |info| if cfg\!(panic = "abort") || QUIET.with(|q| q.get()) == 0 { prev(info) })) }); QUIET.with(|q| q.set(q.get() + 1)); let r = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| (!fn)())); QUIET.with(|q| q.set(q.get() - 1)); match r { Ok(x) => x, Err(e) => (!ex_fn)(Rc::<str>::from(e.downcast_ref::<String>().map(|s| s.as_str()).or_else(|| e.downcast_ref::<&str>().copied()).unwrap_or("panic"))) } }' : t

inl try forall t. (fn : () -> t) (ex_fn : exn -> option t) : option t =
    inl some x : option t = Some x
    inl some = dyn some
    inl fn = dyn fn
    inl ex_fn = dyn ex_fn
    backend_switch {
        Gleam = fun () =>
            fn () |> some
        Lua = fun () =>
            fn () |> some
        Fsharp = fun () =>
            $'(try !fn () |> !some with ex -> !ex_fn ex)' : option t
        Python = fun () =>
            global "def spiral_try(fn, some, ex_fn):\n    try:\n        return some(fn())\n    except Exception as e:\n        return ex_fn(e)"
            $'spiral_try(!fn, !some, !ex_fn)' : option t
        Rust = fun () =>
            catch_unwind_rust (fun () => some (fn ())) ex_fn
        TypeScript = fun () =>
            $'(() => { try { return !some(!fn()); } catch (ex) { return !ex_fn(ex); } })()' : option t
    }

/// ### try_unit
inl try_unit_fsharp_python () : bool =
    backend_switch {
        Gleam = fun () => false
        Lua = fun () => false
        Fsharp = fun () => true
        Python = fun () => true
        TypeScript = fun () => false
        Cpp = fun () => false
        CppHost = fun () => false
        Delphi = fun () => false
        Cuda = fun () => false
        Rust = fun () => false
    }

inl try_unit forall t. (fn : () -> ()) (ex_fn : (() -> exn) -> ()) : t =
    if is_rust ()
    then
        catch_unwind_rust fn (fun ex => ex_fn fun () => ex)
        $'()' : t
    elif try_unit_fsharp_python ()
    then
        inl fn = dyn fn
        inl ex_fn = dyn ex_fn
        backend_switch {
            Fsharp = fun () =>
                $'try !fn () with ex -> !ex_fn (fun () -> ex)' : ()
                $'()' : t
            Python = fun () =>
                global "def _spiral_try_unit(fn, ex_fn):\n    try: fn()\n    except Exception as ex: ex_fn(lambda: ex)"
                $'_spiral_try_unit(!fn, !ex_fn)' : ()
                $'None' : t
        }
    else
        backend_switch {
            Gleam = fun () => $'// base.try_unit' : ()
            Lua = fun () => $'-- base.try_unit' : ()
            Fsharp = fun () => $'try' : ()
            Python = fun () => $'try:' : ()
        }
        fn |> indent
        backend_switch {
            Gleam = fun () => $'// base.try_unit' : ()
            Lua = fun () => $'-- base.try_unit' : ()
            Fsharp = fun () => $'with ex ->' : ()
            Python = fun () => $'except Exception as ex:' : ()
        }
        fun () =>
            inl ex = $'ex'
            backend_switch {
                Fsharp = fun () => $'()' : ()
            }
            inl ex () =
                ex
            ex_fn ex
        |> indent
        backend_switch {
            Gleam = fun () => $'// base.try_unit' : ()
            Lua = fun () => $'-- base.try_unit' : ()
            Fsharp = fun () =>
                $'|> ignore'
                $'(* try_unit'
                $'try_unit *)' : t
            Python = fun () => $'None' : t
        }

/// ### try_unit'
inl try_unit' forall t. (ex_fn : (() -> exn) -> ()) (fn : () -> ()) : t =
    try_unit fn ex_fn

/// ### try_finally
inl try_finally forall t. (fn : () -> ()) (finally : () -> ()) : t =
    if is_rust ()
    then
        inl fn = dyn fn
        inl finally = dyn finally
        $'{ let r = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| (!fn)())); (!finally)(); if let Err(e) = r { std::panic::resume_unwind(e) } }' : ()
        $'()' : t
    elif try_unit_fsharp_python ()
    then
        inl fn = dyn fn
        inl finally = dyn finally
        backend_switch {
            Fsharp = fun () =>
                $'try !fn () finally !finally ()' : ()
                $'()' : t
            Python = fun () =>
                global "def _spiral_try_finally(fn, finally_fn):\n    try: fn()\n    finally: finally_fn()"
                $'_spiral_try_finally(!fn, !finally)' : ()
                $'None' : t
        }
    else
        backend_switch {
            Gleam = fun () => $'// base.try_finally' : ()
            Lua = fun () => $'-- base.try_finally' : ()
            Fsharp = fun () => $'try' : ()
            Python = fun () => $'try:' : ()
        }
        fn |> indent
        backend_switch {
            Gleam = fun () => $'// base.try_finally' : ()
            Lua = fun () => $'-- base.try_finally' : ()
            Fsharp = fun () => $'finally' : ()
            Python = fun () => $'finally:' : ()
        }
        finally |> indent
        backend_switch {
            Gleam = fun () => $'// base.try_finally' : ()
            Lua = fun () => $'-- base.try_finally' : ()
            Fsharp = fun () =>
                $'(* try_finally'
                $'try_finally *)'
                ()
            Python = fun () => $'// base.try_finally' : ()
        }

/// ### (:>)
prototype (~:>) r : forall t. t -> r
