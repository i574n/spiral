/// # base
test base static =
    open testing

/// ## base

/// ### emit
inl emit forall t. (x : t) : t =
    $'!x '

/// ### emit_unit
inl emit_unit forall t. (x : t) : () =
    $'!x '

/// ### use
inl use forall t. (x : t) : t =
    backend_switch {
        Gleam = fun () => $'use !x = !x ' : ()
        Lua = fun () => $'use !x = !x ' : ()
        Fsharp = fun () => $'use !x = !x ' : ()
        Python = fun () => $'use !x = !x ' : ()
        Cpp = fun () => $'use !x = !x ' : ()
        TypeScript = fun () => $'use !x = !x ' : ()
        Rust = fun () =>
            global "struct SpiralUse(std::rc::Rc<dyn Fn()>);\nimpl Drop for SpiralUse {\n    fn drop(&mut self) { (self.0)() }\n}"
            $'let _spiral_use = SpiralUse((!x).clone())' : ()
    }
    $'!x '

/// ### unit
nominal unit = $'unit'

///> gleam
///> lua
///> fsharp
///> cuda
///> rust
///> typescript
test run_target =
    run_target function
        | Gleam => fun () => $'1 + 1'
        | Lua => fun () => $'1 + 1'
        | Fsharp => fun () => $'1uy + 1uy'
        | Cuda => fun () => $'1 + 1'
        | Rust => fun () => $'1u8 + 1u8'
        | TypeScript => fun () => $'1 + 1'
        | _ => fun () => $'2uy + 2uy'
    |> _assert_eq 2u8

/// ### eval
inl eval fn =
    fn ()

/// ### flip
inl flip fn a b =
    fn b a

/// ### do
inl do (body : () -> ()) : () =
    !!!!Do (body())

/// ### let'
inl let' fn =
    inl result : unit =
        backend_switch {
            Gleam = fun () => $'Nil' : unit
            Lua = fun () => $'nil' : unit
            Fsharp = fun () => $'()' : unit
            Python = fun () => $'None' : unit
        }
    backend_switch {
        Gleam = fun () =>
            $'let _let\'_!result = {' : ()
            fn |> indent
            $'}' : ()
        Lua = fun () =>
            $'local _get_let_!result = function()' : ()
            fn |> indent
            $'end' : ()
            $'local _let_!result = _get_let_!result()' : ()
        Fsharp = fun () =>
            $'let _let\'_!result =' : ()
            fn |> indent
        Python = fun () =>
            $'def _let\'_!result():' : ()
            fn |> indent
    }
    $'_let\'_!result '

/// ### exec_unit
inl exec_unit (fn : () -> ()) : () =
    fn ()

/// ### lazy
nominal lazy t = $'Lazy<`t>'

/// ### memoize
inl memoize forall t. (fn : () -> t) : () -> t =
    inl body () =
        inl result = mut None
        inl computed = mut false
        fun () =>
            if *computed
            then *result
            else
                result <- fn () |> Some
                computed <- true
                *result
            |> optionm.value
        : () -> t
    backend_switch {
        Gleam = fun () => body ()
        Lua = fun () => body ()
        Fsharp = fun () =>
            inl result : lazy t = $'lazy !fn ()'
            fun () => $'!result.Value' : t
        Python = fun () => body ()
        Rust = fun () => body ()
        TypeScript = fun () => body ()
        Zig = fun () => body ()
        Lean = fun () => body ()
    }

///> fsharp
///> cuda
///> rust
///> typescript
test memoize =
    inl count = mut 0i32
    inl add =
        fun () =>
            count <- *count + 1
            count
        |> memoize

    add () |> ignore
    add () |> ignore
    add () |> ignore

    *count
    |> _assert_eq 1

/// ### capture
inl capture forall t. (fn : () -> t) : t =
    backend_switch {
        Gleam = fun () =>
            fn ()
        Lua = fun () =>
            fn ()
        Fsharp = fun () =>
            inl result = dyn true
            $'let mutable _capture_!result : `t option = None '
            $'('
            $'(fun () ->'
            $'(fun () ->'
            fn () |> emit_unit
            $')'
            $'|> fun x -> x ()'
            $') () )'
            $'|> fun x -> _capture_!result <- Some x'
            $'match _capture_!result with Some x -> x | None -> failwith "base.capture / _capture_!result=None"' : t
        Python = fun () =>
            fn ()
        Rust = fun () => fn ()
        Zig = fun () => fn ()
        Lean = fun () => fn ()
    }

/// ### yield_from
inl yield_from forall (t : * -> *) u. (a : t u) : () =
    backend_switch {
        Fsharp = fun () => $'yield\! !a ' : ()
        Python = fun () => $'asyncio.run(!a())' : ()
    }

/// ### join_body
inl join_body body acc x =
    if var_is x |> not
    then body acc x
    else
        inl acc = dyn acc
        join body acc x

test join_body static =
    inl rec fold_list f s = function
        | Cons (x, x') => fold_list f (f s x) x'
        | Nil => s

///> gleam
///> lua
///> fsharp
///> cuda
///> rust
///> typescript
test join_body_2 print_code =
    [ 5i32; 4; join 3; 2; 1 ]
    |> fold_list (+) 0
    |> _assert_eq 15

///> gleam
///> fsharp
///> cuda
///> rust
///> typescript
test join_body_3 print_code =
    [ 5i32; 4; join 3; 2; 1 ]
    |> fold_list (join_body (+)) 0
    |> _assert_eq 15

/// ### join_body_unit
inl join_body_unit body d x =
    if var_is d |> not
    then body x
    else
        inl x = dyn x
        join body x

///> gleam
///> fsharp
///> cuda
///> rust
///> typescript
test join_body_unit print_code =
    [ 5i32; 4; join 3; 2; 1 ]
    |> fold_list (fun acc n => join_body_unit ((+) acc) n n) 0
    |> _assert_eq 15

/// ### (+.)
inl (+.) forall t. (a : t) (b : t) : t =
    !!!!Add(a,b)

