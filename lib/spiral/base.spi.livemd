### choice2'

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":":== choice2_switch a b =\n    {\n        Gleam : $'Choice<`a, `b>'\n        Lua : $'Choice<`a, `b>'\n        Fsharp : $'Choice<`a, `b>'\n        Python : $'Choice<`a, `b>'\n        Rust : $'Result<`a, `b>'\n    }\n:! choice2' a b = $'backend_switch `(choice2_switch a b)'\n\n:= choice2_unbox \\* t1 t2. (choice : choice2' t1 t2) : choice2 t1 t2 =\n    run_target_args (\\ () => choice) \\|\n        | Fsharp _ => \\ choice =>\n            := c1of2 (x : t1) : _ _ t2 = C1of2 x\n            := c2of2 (x : t2) : _ t1 _ = C2of2 x\n            := c1of2 = ~~ c1of2\n            := c2of2 = ~~ c2of2\n            $'match !choice with Choice1Of2 x -> !c1of2 x | Choice2Of2 x -> !c2of2 x'\n        | Rust => \\ choice =>\n            := c1of2 (x : t1) : _ _ t2 = C1of2 x\n            := c2of2 (x : t2) : _ t1 _ = C2of2 x\n            := c1of2 = ~~ c1of2\n            := c2of2 = ~~ c2of2\n            $'match !choice { Ok(x) => (!c1of2)(x), Err(x) => (!c2of2)(x) }'\n        | _ => \\ _ => null ()\n\n:! ref t = $'`t ref'\n\n:= new_ref \\* t. (x : t) : ref t =\n    $'ref !x '\n\n:= ref_value \\* t. (x : ref t) : t =\n    $'!x.Value'\n\n:= ref_set_value \\* t. (value : t) (ref : ref t) : ref t =\n    $'!ref.Value <- !value '\n    ref\n\n:== exn_switch =\n    {\n        Gleam : $'Nil'\n        Lua : $'nil'\n        Fsharp : $'exn'\n        Python : $'BaseException'\n        Rust : $'Rc<str>'\n        TypeScript : $'any'\n        Zig : $'[]const u8'\n        C : $'const char *'\n    }\n:! exn = $'backend_switch `(exn_switch)'\n\n:= exn x =\n    x |> $'`exn '\n\n:! rust_panic_payload = $'Box<dyn std::any::Any + Send>'\n\n:! rust_panic_hook = $'Box<dyn Fn(&std::panic::PanicHookInfo) + Sync + Send>'\n\n:! rust_caught t = $'std::thread::Result<`t>'\n\n:= rust_panic_aborts () : bool =\n    $'cfg\\!(panic = \"abort\")' : bool\n\n:= rust_panic_take_hook () : rust_panic_hook =\n    $'std::panic::take_hook()' : rust_panic_hook\n\n:= rust_panic_set_hook (hook : rust_panic_hook) : () =\n    $'std::panic::set_hook(!hook)' : ()\n\n:= rust_panic_silent_hook () : rust_panic_hook =\n    $'Box::new(|_| ())' : rust_panic_hook\n\n:= rust_resume_unwind (payload : rust_panic_payload) : () =\n    $'std::panic::resume_unwind(!payload)' : ()\n\n:= rust_catch_unwind \\* t. (fn : () -> t) : rust_caught t =\n    := fn = dyn fn\n    $'std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| (!fn)()))' : rust_caught t\n\n:= rust_quietly \\* t. (catch : () -> t) : t =\n    ? rust_panic_aborts () ?> catch ()\n    |:\n        := previous = rust_panic_take_hook ()\n        rust_panic_silent_hook () |> rust_panic_set_hook\n        := caught = catch ()\n        rust_panic_set_hook previous\n        caught\n\n:= rust_caught_ok \\* t. (caught : rust_caught t) : bool =\n    $'!caught.is_ok()' : bool\n\n:= rust_caught_value \\* t. (caught : rust_caught t) : t =\n    $'!caught.unwrap()' : t\n\n:= rust_caught_payload \\* t. (caught : rust_caught t) : rust_panic_payload =\n    $'!caught.err().unwrap()' : rust_panic_payload\n\n:= rust_panic_holds_string (payload : rust_panic_payload) : bool =\n    $'!payload.downcast_ref::<String>().is_some()' : bool\n\n:= rust_panic_holds_str (payload : rust_panic_payload) : bool =\n    $'!payload.downcast_ref::<&str>().is_some()' : bool\n\n:= rust_panic_string (payload : rust_panic_payload) : string =\n    $'Rc::<str>::from(!payload.downcast_ref::<String>().unwrap().as_str())' : string\n\n:= rust_panic_str (payload : rust_panic_payload) : string =\n    $'Rc::<str>::from(*!payload.downcast_ref::<&str>().unwrap())' : string\n\n:= rust_panic_text (payload : rust_panic_payload) : string =\n    ? rust_panic_holds_string payload ?> rust_panic_string payload\n    |? rust_panic_holds_str payload ?> rust_panic_str payload\n    |: \"panic\"\n\n:= rust_exn_of_text (text : string) : exn =\n    $'!text' : exn\n\n:= catch_unwind_rust \\* t. (fn : () -> t) (ex_fn : exn -> t) : t =\n    rust_quietly \\ () =>\n        := caught = rust_catch_unwind fn\n        ? rust_caught_ok caught ?> rust_caught_value caught\n        |: caught |> rust_caught_payload |> rust_panic_text |> rust_exn_of_text |> ex_fn\n\n:! lua_attempt = $'table'\n\n:= lua_pcall \\* t. (fn : () -> t) : lua_attempt =\n    $'{pcall(!fn)}' : lua_attempt\n\n:= lua_attempt_ok (attempt : lua_attempt) : bool =\n    $'!attempt[1]' : bool\n\n:= lua_attempt_value \\* t. (attempt : lua_attempt) : t =\n    $'!attempt[2]' : t\n\n:= lua_attempt_error (attempt : lua_attempt) : exn =\n    $'!attempt[2]' : exn\n\n:= try \\* t. (fn : () -> t) (ex_fn : exn -> option t) : option t =\n    := some x : option t = Some x\n    := some = dyn some\n    := fn = dyn fn\n    := ex_fn = dyn ex_fn\n    backend_switch {\n        Gleam = \\ () =>\n            fn () |> some\n        Lua = \\ () =>\n            := attempt = lua_pcall fn\n            ? lua_attempt_ok attempt ?> attempt |> lua_attempt_value |> some\n            |: attempt |> lua_attempt_error |> ex_fn\n        Fsharp = \\ () =>\n            $'(try !fn () |> !some with ex -> !ex_fn ex)' : option t\n        Python = \\ () =>\n            global \"\"\"\n                def spiral_try(fn, some, ex_fn):\n                    try:\n                        return some(fn())\n                    except Exception as e:\n                        return ex_fn(e)\n                \"\"\"\n            $'spiral_try(!fn, !some, !ex_fn)' : option t\n        Rust = \\ () =>\n            catch_unwind_rust (\\ () => some (fn ())) ex_fn\n        TypeScript = \\ () =>\n            $'(() => { try { return !some(!fn()); } catch (ex) { return !ex_fn(ex); } })()' : option t\n        Zig = \\ () =>\n            fn () |> some\n        C = \\ () =>\n            fn () |> some\n    }","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ":== choice2_switch a b =\n    {\n        Gleam : $'Choice<`a, `b>'\n        Lua : $'Choice<`a, `b>'\n        Fsharp : $'Choice<`a, `b>'\n        Python : $'Choice<`a, `b>'\n        Rust : $'Result<`a, `b>'\n    }\n:! choice2' a b = $'backend_switch `(choice2_switch a b)'\n\n:= choice2_unbox \\* t1 t2. (choice : choice2' t1 t2) : choice2 t1 t2 =\n    run_target_args (\\ () => choice) \\|\n        | Fsharp _ => \\ choice =>\n            := c1of2 (x : t1) : _ _ t2 = C1of2 x\n            := c2of2 (x : t2) : _ t1 _ = C2of2 x\n            := c1of2 = ~~ c1of2\n            := c2of2 = ~~ c2of2\n            $'match !choice with Choice1Of2 x -> !c1of2 x | Choice2Of2 x -> !c2of2 x'\n        | Rust => \\ choice =>\n            := c1of2 (x : t1) : _ _ t2 = C1of2 x\n            := c2of2 (x : t2) : _ t1 _ = C2of2 x\n            := c1of2 = ~~ c1of2\n            := c2of2 = ~~ c2of2\n            $'match !choice { Ok(x) => (!c1of2)(x), Err(x) => (!c2of2)(x) }'\n        | _ => \\ _ => null ()\n\n:! ref t = $'`t ref'\n\n:= new_ref \\* t. (x : t) : ref t =\n    $'ref !x '\n\n:= ref_value \\* t. (x : ref t) : t =\n    $'!x.Value'\n\n:= ref_set_value \\* t. (value : t) (ref : ref t) : ref t =\n    $'!ref.Value <- !value '\n    ref\n\n:== exn_switch =\n    {\n        Gleam : $'Nil'\n        Lua : $'nil'\n        Fsharp : $'exn'\n        Python : $'BaseException'\n        Rust : $'Rc<str>'\n        TypeScript : $'any'\n        Zig : $'[]const u8'\n        C : $'const char *'\n    }\n:! exn = $'backend_switch `(exn_switch)'\n\n:= exn x =\n    x |> $'`exn '\n\n:! rust_panic_payload = $'Box<dyn std::any::Any + Send>'\n\n:! rust_panic_hook = $'Box<dyn Fn(&std::panic::PanicHookInfo) + Sync + Send>'\n\n:! rust_caught t = $'std::thread::Result<`t>'\n\n:= rust_panic_aborts () : bool =\n    $'cfg\\!(panic = \"abort\")' : bool\n\n:= rust_panic_take_hook () : rust_panic_hook =\n    $'std::panic::take_hook()' : rust_panic_hook\n\n:= rust_panic_set_hook (hook : rust_panic_hook) : () =\n    $'std::panic::set_hook(!hook)' : ()\n\n:= rust_panic_silent_hook () : rust_panic_hook =\n    $'Box::new(|_| ())' : rust_panic_hook\n\n:= rust_resume_unwind (payload : rust_panic_payload) : () =\n    $'std::panic::resume_unwind(!payload)' : ()\n\n:= rust_catch_unwind \\* t. (fn : () -> t) : rust_caught t =\n    := fn = dyn fn\n    $'std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| (!fn)()))' : rust_caught t\n\n:= rust_quietly \\* t. (catch : () -> t) : t =\n    ? rust_panic_aborts () ?> catch ()\n    |:\n        := previous = rust_panic_take_hook ()\n        rust_panic_silent_hook () |> rust_panic_set_hook\n        := caught = catch ()\n        rust_panic_set_hook previous\n        caught\n\n:= rust_caught_ok \\* t. (caught : rust_caught t) : bool =\n    $'!caught.is_ok()' : bool\n\n:= rust_caught_value \\* t. (caught : rust_caught t) : t =\n    $'!caught.unwrap()' : t\n\n:= rust_caught_payload \\* t. (caught : rust_caught t) : rust_panic_payload =\n    $'!caught.err().unwrap()' : rust_panic_payload\n\n:= rust_panic_holds_string (payload : rust_panic_payload) : bool =\n    $'!payload.downcast_ref::<String>().is_some()' : bool\n\n:= rust_panic_holds_str (payload : rust_panic_payload) : bool =\n    $'!payload.downcast_ref::<&str>().is_some()' : bool\n\n:= rust_panic_string (payload : rust_panic_payload) : string =\n    $'Rc::<str>::from(!payload.downcast_ref::<String>().unwrap().as_str())' : string\n\n:= rust_panic_str (payload : rust_panic_payload) : string =\n    $'Rc::<str>::from(*!payload.downcast_ref::<&str>().unwrap())' : string\n\n:= rust_panic_text (payload : rust_panic_payload) : string =\n    ? rust_panic_holds_string payload ?> rust_panic_string payload\n    |? rust_panic_holds_str payload ?> rust_panic_str payload\n    |: \"panic\"\n\n:= rust_exn_of_text (text : string) : exn =\n    $'!text' : exn\n\n:= catch_unwind_rust \\* t. (fn : () -> t) (ex_fn : exn -> t) : t =\n    rust_quietly \\ () =>\n        := caught = rust_catch_unwind fn\n        ? rust_caught_ok caught ?> rust_caught_value caught\n        |: caught |> rust_caught_payload |> rust_panic_text |> rust_exn_of_text |> ex_fn\n\n:! lua_attempt = $'table'\n\n:= lua_pcall \\* t. (fn : () -> t) : lua_attempt =\n    $'{pcall(!fn)}' : lua_attempt\n\n:= lua_attempt_ok (attempt : lua_attempt) : bool =\n    $'!attempt[1]' : bool\n\n:= lua_attempt_value \\* t. (attempt : lua_attempt) : t =\n    $'!attempt[2]' : t\n\n:= lua_attempt_error (attempt : lua_attempt) : exn =\n    $'!attempt[2]' : exn\n\n:= try \\* t. (fn : () -> t) (ex_fn : exn -> option t) : option t =\n    := some x : option t = Some x\n    := some = dyn some\n    := fn = dyn fn\n    := ex_fn = dyn ex_fn\n    backend_switch {\n        Gleam = \\ () =>\n            fn () |> some\n        Lua = \\ () =>\n            := attempt = lua_pcall fn\n            ? lua_attempt_ok attempt ?> attempt |> lua_attempt_value |> some\n            |: attempt |> lua_attempt_error |> ex_fn\n        Fsharp = \\ () =>\n            $'(try !fn () |> !some with ex -> !ex_fn ex)' : option t\n        Python = \\ () =>\n            global \"\"\"\n                def spiral_try(fn, some, ex_fn):\n                    try:\n                        return some(fn())\n                    except Exception as e:\n                        return ex_fn(e)\n                \"\"\"\n            $'spiral_try(!fn, !some, !ex_fn)' : option t\n        Rust = \\ () =>\n            catch_unwind_rust (\\ () => some (fn ())) ex_fn\n        TypeScript = \\ () =>\n            $'(() => { try { return !some(!fn()); } catch (ex) { return !ex_fn(ex); } })()' : option t\n        Zig = \\ () =>\n            fn () |> some\n        C = \\ () =>\n            fn () |> some\n    }",
  timeout: 300_000
)
```

#### try_catches_failures_and_keeps_values (test)

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":"///- --test --symbol\n///> lua\n///> cuda\n///> rust\n///> typescript\n\n:= ~n = 5i32\n(try (\\ () => n) (\\ _ => None), try (\\ () => failwith \"boom\" : i32) (\\ _ => Some 0i32))\n|> _assert_eq (Some 5i32, Some 0i32)","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  ///- --test --symbol
  ///> lua
  ///> cuda
  ///> rust
  ///> typescript

  := ~n = 5i32
  (try (\ () => n) (\ _ => None), try (\ () => failwith "boom" : i32) (\ _ => Some 0i32))
  |> _assert_eq (Some 5i32, Some 0i32)
  """,
  timeout: 300_000
)
```

#### try_keeps_values (test)

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":"///- --test --symbol\n///> c\n\n:= ~n = 5i32\ntry (\\ () => n) (\\ _ => None)\n|> _assert_eq (Some 5i32)","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  ///- --test --symbol
  ///> c

  := ~n = 5i32
  try (\ () => n) (\ _ => None)
  |> _assert_eq (Some 5i32)
  """,
  timeout: 300_000
)
```

#### try (test)

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":"///- --test --no-agree \"exception text is backend-specific\" --symbol\n///> cuda\n///> rust\n///> typescript\n\ntry\n    \\ () => ;[ 0i32 ] |> am'::index 1i32 |> sm'::format\n    \\ ex => $'!ex ' |> sm'::format_exception |> Some\n|> optionm::value\n|> _assert_eq (run_target \\|\n    | Gleam => \\ () => null ()\n    | Lua => \\ () => null ()\n    | Fsharp => \\ () => ~~ \"System.IndexOutOfRangeException: Index was outside the bounds of the array.\"\n    | Cuda => \\ () => \"index 1 is out of bounds for axis 0 with size 1\"\n    | Cpp => \\ () => null ()\n    | Rust => \\ () => \"index out of bounds: the len is 1 but the index is 1\"\n    | TypeScript => \\ () => \"RangeError: array index 1 out of bounds for length 1\"\n    | _ => \\ () => null ()\n)","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  ///- --test --no-agree "exception text is backend-specific" --symbol
  ///> cuda
  ///> rust
  ///> typescript

  try
      \ () => ;[ 0i32 ] |> am'::index 1i32 |> sm'::format
      \ ex => $'!ex ' |> sm'::format_exception |> Some
  |> optionm::value
  |> _assert_eq (run_target \|
      | Gleam => \ () => null ()
      | Lua => \ () => null ()
      | Fsharp => \ () => ~~ "System.IndexOutOfRangeException: Index was outside the bounds of the array."
      | Cuda => \ () => "index 1 is out of bounds for axis 0 with size 1"
      | Cpp => \ () => null ()
      | Rust => \ () => "index out of bounds: the len is 1 but the index is 1"
      | TypeScript => \ () => "RangeError: array index 1 out of bounds for length 1"
      | _ => \ () => null ()
  )
  """,
  timeout: 300_000
)
```

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":"///- --test --symbol\n///> gleam\n///> cuda\n///> rust\n///> typescript\n\ntry\n    \\ () => ;[ 0i32 ] |> am'::index 0i32 |> sm'::format\n    \\ ex => $'!ex ' |> sm'::format_exception |> Some\n|> optionm::value\n|> _assert_eq \"0\"","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  ///- --test --symbol
  ///> gleam
  ///> cuda
  ///> rust
  ///> typescript

  try
      \ () => ;[ 0i32 ] |> am'::index 0i32 |> sm'::format
      \ ex => $'!ex ' |> sm'::format_exception |> Some
  |> optionm::value
  |> _assert_eq "0"
  """,
  timeout: 300_000
)
```

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":":= try_unit_fsharp_python () : bool =\n    backend_switch {\n        Gleam = \\ () => !-\n        Lua = \\ () => !-\n        Fsharp = \\ () => !+\n        Python = \\ () => !+\n        TypeScript = \\ () => !-\n        Cpp = \\ () => !-\n        CppHost = \\ () => !-\n        Pascal = \\ () => !-\n        Cuda = \\ () => !-\n        Rust = \\ () => !-\n    }\n\n:= try_unit \\* t. (fn : () -> ()) (ex_fn : (() -> exn) -> ()) : t =\n    run_target \\|\n        | Rust => \\ () =>\n            catch_unwind_rust fn \\ ex => ex_fn \\ () => ex\n            $'()' : t\n        | Zig => \\ () =>\n            fn ()\n            $'std.mem.zeroes(`t)' : t\n        | Gleam _ => \\ () =>\n            global \"import exception\"\n            global \"import gleam/result\"\n            := fn = dyn fn\n            := rescued = $'exception.rescue(fn() { !fn(Nil) })' : $'Result(Nil, exception.Exception)'\n            ? $'result.is_error(!rescued)' : bool ?> ex_fn (\\ () => $'Nil' : exn) |: ()\n            $'Nil' : t\n        | Lua => \\ () =>\n            := fn = dyn fn\n            := ok = $'pcall(!fn)' : bool\n            ? ok ?> () |: ex_fn (\\ () => $'nil' : exn)\n            $'(function() return nil end)()' : t\n        | _ => \\ () =>\n            ? try_unit_fsharp_python ()\n            ?>\n                := fn = dyn fn\n                := ex_fn = dyn ex_fn\n                backend_switch {\n                    Fsharp = \\ () =>\n                        $'try !fn () with ex -> !ex_fn (fun () -> ex)' : ()\n                        $'()' : t\n                    Python = \\ () =>\n                        global \"\"\"\n                            def _spiral_try_unit(fn, ex_fn):\n                                try: fn()\n                                except Exception as ex: ex_fn(lambda: ex)\n                            \"\"\"\n                        $'_spiral_try_unit(!fn, !ex_fn)' : ()\n                        $'None' : t\n                }\n            |:\n                backend_switch {\n                    Gleam = \\ () => $'// base.try_unit' : ()\n                    Lua = \\ () => $'-- base.try_unit' : ()\n                    Fsharp = \\ () => $'try' : ()\n                    Python = \\ () => $'try:' : ()\n                }\n                fn |> indent\n                backend_switch {\n                    Gleam = \\ () => $'// base.try_unit' : ()\n                    Lua = \\ () => $'-- base.try_unit' : ()\n                    Fsharp = \\ () => $'with ex ->' : ()\n                    Python = \\ () => $'except Exception as ex:' : ()\n                }\n                \\ () =>\n                    := ex = $'ex'\n                    backend_switch {\n                        Fsharp = \\ () => $'()' : ()\n                    }\n                    := ex () =\n                        ex\n                    ex_fn ex\n                |> indent\n                backend_switch {\n                    Gleam = \\ () => $'// base.try_unit' : ()\n                    Lua = \\ () => $'-- base.try_unit' : ()\n                    Fsharp = \\ () =>\n                        $'|> ignore'\n                        $'(* try_unit'\n                        $'try_unit *)' : t\n                    Python = \\ () => $'None' : t\n                }\n\n:= try_unit' \\* t. (ex_fn : (() -> exn) -> ()) (fn : () -> ()) : t =\n    try_unit fn ex_fn\n\n:= try_finally \\* t. (fn : () -> ()) (finally : () -> ()) : t =\n    run_target \\|\n        | Rust => \\ () =>\n            := caught = rust_catch_unwind fn\n            finally ()\n            ? rust_caught_ok caught ?> () |: caught |> rust_caught_payload |> rust_resume_unwind\n            $'()' : t\n        | Zig => \\ () =>\n            fn ()\n            finally ()\n            $'std.mem.zeroes(`t)' : t\n        | Gleam _ => \\ () =>\n            global \"import exception\"\n            := fn = dyn fn\n            := finally = dyn finally\n            $'exception.defer(fn() { !finally(Nil) }, fn() { !fn(Nil) })' : ()\n            $'Nil' : t\n        | Lua => \\ () =>\n            := fn = dyn fn\n            := outcome = $'{pcall(!fn)}' : $'table'\n            finally ()\n            ? ($'!outcome[1]' : bool) ?> () |: $'error(!outcome[2], 0)' : ()\n            $'(function() return nil end)()' : t\n        | _ => \\ () =>\n            ? try_unit_fsharp_python ()\n            ?>\n                := fn = dyn fn\n                := finally = dyn finally\n                backend_switch {\n                    Fsharp = \\ () =>\n                        $'try !fn () finally !finally ()' : ()\n                        $'()' : t\n                    Python = \\ () =>\n                        global \"\"\"\n                            def _spiral_try_finally(fn, finally_fn):\n                                try: fn()\n                                finally: finally_fn()\n                            \"\"\"\n                        $'_spiral_try_finally(!fn, !finally)' : ()\n                        $'None' : t\n                }\n            |:\n                backend_switch {\n                    Gleam = \\ () => $'// base.try_finally' : ()\n                    Lua = \\ () => $'-- base.try_finally' : ()\n                    Fsharp = \\ () => $'try' : ()\n                    Python = \\ () => $'try:' : ()\n                }\n                fn |> indent\n                backend_switch {\n                    Gleam = \\ () => $'// base.try_finally' : ()\n                    Lua = \\ () => $'-- base.try_finally' : ()\n                    Fsharp = \\ () => $'finally' : ()\n                    Python = \\ () => $'finally:' : ()\n                }\n                finally |> indent\n                backend_switch {\n                    Gleam = \\ () => $'// base.try_finally' : ()\n                    Lua = \\ () => $'-- base.try_finally' : ()\n                    Fsharp = \\ () =>\n                        $'(* try_finally'\n                        $'try_finally *)'\n                        ()\n                    Python = \\ () => $'// base.try_finally' : ()\n                }","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ":= try_unit_fsharp_python () : bool =\n    backend_switch {\n        Gleam = \\ () => !-\n        Lua = \\ () => !-\n        Fsharp = \\ () => !+\n        Python = \\ () => !+\n        TypeScript = \\ () => !-\n        Cpp = \\ () => !-\n        CppHost = \\ () => !-\n        Pascal = \\ () => !-\n        Cuda = \\ () => !-\n        Rust = \\ () => !-\n    }\n\n:= try_unit \\* t. (fn : () -> ()) (ex_fn : (() -> exn) -> ()) : t =\n    run_target \\|\n        | Rust => \\ () =>\n            catch_unwind_rust fn \\ ex => ex_fn \\ () => ex\n            $'()' : t\n        | Zig => \\ () =>\n            fn ()\n            $'std.mem.zeroes(`t)' : t\n        | Gleam _ => \\ () =>\n            global \"import exception\"\n            global \"import gleam/result\"\n            := fn = dyn fn\n            := rescued = $'exception.rescue(fn() { !fn(Nil) })' : $'Result(Nil, exception.Exception)'\n            ? $'result.is_error(!rescued)' : bool ?> ex_fn (\\ () => $'Nil' : exn) |: ()\n            $'Nil' : t\n        | Lua => \\ () =>\n            := fn = dyn fn\n            := ok = $'pcall(!fn)' : bool\n            ? ok ?> () |: ex_fn (\\ () => $'nil' : exn)\n            $'(function() return nil end)()' : t\n        | _ => \\ () =>\n            ? try_unit_fsharp_python ()\n            ?>\n                := fn = dyn fn\n                := ex_fn = dyn ex_fn\n                backend_switch {\n                    Fsharp = \\ () =>\n                        $'try !fn () with ex -> !ex_fn (fun () -> ex)' : ()\n                        $'()' : t\n                    Python = \\ () =>\n                        global \"\"\"\n                            def _spiral_try_unit(fn, ex_fn):\n                                try: fn()\n                                except Exception as ex: ex_fn(lambda: ex)\n                            \"\"\"\n                        $'_spiral_try_unit(!fn, !ex_fn)' : ()\n                        $'None' : t\n                }\n            |:\n                backend_switch {\n                    Gleam = \\ () => $'// base.try_unit' : ()\n                    Lua = \\ () => $'-- base.try_unit' : ()\n                    Fsharp = \\ () => $'try' : ()\n                    Python = \\ () => $'try:' : ()\n                }\n                fn |> indent\n                backend_switch {\n                    Gleam = \\ () => $'// base.try_unit' : ()\n                    Lua = \\ () => $'-- base.try_unit' : ()\n                    Fsharp = \\ () => $'with ex ->' : ()\n                    Python = \\ () => $'except Exception as ex:' : ()\n                }\n                \\ () =>\n                    := ex = $'ex'\n                    backend_switch {\n                        Fsharp = \\ () => $'()' : ()\n                    }\n                    := ex () =\n                        ex\n                    ex_fn ex\n                |> indent\n                backend_switch {\n                    Gleam = \\ () => $'// base.try_unit' : ()\n                    Lua = \\ () => $'-- base.try_unit' : ()\n                    Fsharp = \\ () =>\n                        $'|> ignore'\n                        $'(* try_unit'\n                        $'try_unit *)' : t\n                    Python = \\ () => $'None' : t\n                }\n\n:= try_unit' \\* t. (ex_fn : (() -> exn) -> ()) (fn : () -> ()) : t =\n    try_unit fn ex_fn\n\n:= try_finally \\* t. (fn : () -> ()) (finally : () -> ()) : t =\n    run_target \\|\n        | Rust => \\ () =>\n            := caught = rust_catch_unwind fn\n            finally ()\n            ? rust_caught_ok caught ?> () |: caught |> rust_caught_payload |> rust_resume_unwind\n            $'()' : t\n        | Zig => \\ () =>\n            fn ()\n            finally ()\n            $'std.mem.zeroes(`t)' : t\n        | Gleam _ => \\ () =>\n            global \"import exception\"\n            := fn = dyn fn\n            := finally = dyn finally\n            $'exception.defer(fn() { !finally(Nil) }, fn() { !fn(Nil) })' : ()\n            $'Nil' : t\n        | Lua => \\ () =>\n            := fn = dyn fn\n            := outcome = $'{pcall(!fn)}' : $'table'\n            finally ()\n            ? ($'!outcome[1]' : bool) ?> () |: $'error(!outcome[2], 0)' : ()\n            $'(function() return nil end)()' : t\n        | _ => \\ () =>\n            ? try_unit_fsharp_python ()\n            ?>\n                := fn = dyn fn\n                := finally = dyn finally\n                backend_switch {\n                    Fsharp = \\ () =>\n                        $'try !fn () finally !finally ()' : ()\n                        $'()' : t\n                    Python = \\ () =>\n                        global \"\"\"\n                            def _spiral_try_finally(fn, finally_fn):\n                                try: fn()\n                                finally: finally_fn()\n                            \"\"\"\n                        $'_spiral_try_finally(!fn, !finally)' : ()\n                        $'None' : t\n                }\n            |:\n                backend_switch {\n                    Gleam = \\ () => $'// base.try_finally' : ()\n                    Lua = \\ () => $'-- base.try_finally' : ()\n                    Fsharp = \\ () => $'try' : ()\n                    Python = \\ () => $'try:' : ()\n                }\n                fn |> indent\n                backend_switch {\n                    Gleam = \\ () => $'// base.try_finally' : ()\n                    Lua = \\ () => $'-- base.try_finally' : ()\n                    Fsharp = \\ () => $'finally' : ()\n                    Python = \\ () => $'finally:' : ()\n                }\n                finally |> indent\n                backend_switch {\n                    Gleam = \\ () => $'// base.try_finally' : ()\n                    Lua = \\ () => $'-- base.try_finally' : ()\n                    Fsharp = \\ () =>\n                        $'(* try_finally'\n                        $'try_finally *)'\n                        ()\n                    Python = \\ () => $'// base.try_finally' : ()\n                }",
  timeout: 300_000
)
