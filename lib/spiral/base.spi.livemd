## base

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":":= emit \\* t. (x : t) : t =\n    $'!x '\n\n:= emit_unit \\* t. (x : t) : () =\n    $'!x '\n\n:= export \\* t. (name : string) (f : t) : () =\n    !!!!Export(name, f)\n\n:= use \\* t. (x : t) : t =\n    backend_switch {\n        Gleam = \\ () => $'use !x = !x ' : ()\n        Lua = \\ () => $'use !x = !x ' : ()\n        Fsharp = \\ () => $'use !x = !x ' : ()\n        Python = \\ () => $'use !x = !x ' : ()\n        Cpp = \\ () => $'use !x = !x ' : ()\n        TypeScript = \\ () => $'use !x = !x ' : ()\n        Rust = \\ () =>\n            global \"\"\"\n                struct SpiralUse(std::rc::Rc<dyn Fn()>);\n                impl Drop for SpiralUse {\n                    fn drop(&mut self) { (self.0)() }\n                }\n                \"\"\"\n            $'let _spiral_use = SpiralUse((!x).clone())' : ()\n    }\n    $'!x '\n\n:! unit = $'unit'","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ":= emit \\* t. (x : t) : t =\n    $'!x '\n\n:= emit_unit \\* t. (x : t) : () =\n    $'!x '\n\n:= export \\* t. (name : string) (f : t) : () =\n    !!!!Export(name, f)\n\n:= use \\* t. (x : t) : t =\n    backend_switch {\n        Gleam = \\ () => $'use !x = !x ' : ()\n        Lua = \\ () => $'use !x = !x ' : ()\n        Fsharp = \\ () => $'use !x = !x ' : ()\n        Python = \\ () => $'use !x = !x ' : ()\n        Cpp = \\ () => $'use !x = !x ' : ()\n        TypeScript = \\ () => $'use !x = !x ' : ()\n        Rust = \\ () =>\n            global \"\"\"\n                struct SpiralUse(std::rc::Rc<dyn Fn()>);\n                impl Drop for SpiralUse {\n                    fn drop(&mut self) { (self.0)() }\n                }\n                \"\"\"\n            $'let _spiral_use = SpiralUse((!x).clone())' : ()\n    }\n    $'!x '\n\n:! unit = $'unit'",
  timeout: 300_000
)
```

#### run_target (test)

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":"///- --test --symbol\n///> gleam\n///> lua\n///> cuda\n///> rust\n///> typescript\n\nrun_target \\|\n    | Gleam => \\ () => $'1 + 1'\n    | Lua => \\ () => $'1 + 1'\n    | Fsharp => \\ () => $'1uy + 1uy'\n    | Cuda => \\ () => $'1 + 1'\n    | Rust => \\ () => $'1u8 + 1u8'\n    | TypeScript => \\ () => $'1 + 1'\n    | _ => \\ () => $'2uy + 2uy'\n|> _assert_eq 2u8","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  ///- --test --symbol
  ///> gleam
  ///> lua
  ///> cuda
  ///> rust
  ///> typescript

  run_target \|
      | Gleam => \ () => $'1 + 1'
      | Lua => \ () => $'1 + 1'
      | Fsharp => \ () => $'1uy + 1uy'
      | Cuda => \ () => $'1 + 1'
      | Rust => \ () => $'1u8 + 1u8'
      | TypeScript => \ () => $'1 + 1'
      | _ => \ () => $'2uy + 2uy'
  |> _assert_eq 2u8
  """,
  timeout: 300_000
)
```

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":":= eval fn =\n    fn ()\n\n:= flip fn a b =\n    fn b a\n\n:= do (body : () -> ()) : () =\n    !!!!Do(body ())\n\n:= let' fn =\n    := result : unit =\n        backend_switch {\n            Gleam = \\ () => $'Nil' : unit\n            Lua = \\ () => $'nil' : unit\n            Fsharp = \\ () => $'()' : unit\n            Python = \\ () => $'None' : unit\n        }\n    backend_switch {\n        Gleam = \\ () =>\n            $'let _let\\'_!result = {' : ()\n            fn |> indent\n            $'}' : ()\n        Lua = \\ () =>\n            $'local _get_let_!result = function()' : ()\n            fn |> indent\n            $'end' : ()\n            $'local _let_!result = _get_let_!result()' : ()\n        Fsharp = \\ () =>\n            $'let _let\\'_!result =' : ()\n            fn |> indent\n        Python = \\ () =>\n            $'def _let\\'_!result():' : ()\n            fn |> indent\n    }\n    $'_let\\'_!result '\n\n:= exec_unit (fn : () -> ()) : () =\n    fn ()\n\n:! lazy t = $'Lazy<`t>'\n\n:= memoize \\* t. (fn : () -> t) : () -> t =\n    := body () =\n        := result = mut None\n        := computed = mut !-\n        \\ () =>\n            ? *computed\n            ?> *result\n            |:\n                result <- fn () |> Some\n                computed <- !+\n                *result\n            |> optionm::value\n        : () -> t\n    backend_switch {\n        Gleam = \\ () => body ()\n        Lua = \\ () => body ()\n        Fsharp = \\ () =>\n            := result : lazy t = $'lazy !fn ()'\n            \\ () => $'!result.Value' : t\n        Python = \\ () => body ()\n        Rust = \\ () => body ()\n        TypeScript = \\ () => body ()\n        Zig = \\ () => body ()\n        Lean = \\ () => body ()\n    }","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  := eval fn =
      fn ()

  := flip fn a b =
      fn b a

  := do (body : () -> ()) : () =
      !!!!Do(body ())

  := let' fn =
      := result : unit =
          backend_switch {
              Gleam = \ () => $'Nil' : unit
              Lua = \ () => $'nil' : unit
              Fsharp = \ () => $'()' : unit
              Python = \ () => $'None' : unit
          }
      backend_switch {
          Gleam = \ () =>
              $'let _let\'_!result = {' : ()
              fn |> indent
              $'}' : ()
          Lua = \ () =>
              $'local _get_let_!result = function()' : ()
              fn |> indent
              $'end' : ()
              $'local _let_!result = _get_let_!result()' : ()
          Fsharp = \ () =>
              $'let _let\'_!result =' : ()
              fn |> indent
          Python = \ () =>
              $'def _let\'_!result():' : ()
              fn |> indent
      }
      $'_let\'_!result '

  := exec_unit (fn : () -> ()) : () =
      fn ()

  :! lazy t = $'Lazy<`t>'

  := memoize \* t. (fn : () -> t) : () -> t =
      := body () =
          := result = mut None
          := computed = mut !-
          \ () =>
              ? *computed
              ?> *result
              |:
                  result <- fn () |> Some
                  computed <- !+
                  *result
              |> optionm::value
          : () -> t
      backend_switch {
          Gleam = \ () => body ()
          Lua = \ () => body ()
          Fsharp = \ () =>
              := result : lazy t = $'lazy !fn ()'
              \ () => $'!result.Value' : t
          Python = \ () => body ()
          Rust = \ () => body ()
          TypeScript = \ () => body ()
          Zig = \ () => body ()
          Lean = \ () => body ()
      }
  """,
  timeout: 300_000
)
```

#### memoize (test)

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":"///- --test --symbol\n///> cuda\n///> rust\n///> typescript\n\n:= count = mut 0i32\n:= add =\n    \\ () =>\n        count <- *count + 1\n        count\n    |> memoize\n\nadd () |> ignore\nadd () |> ignore\nadd () |> ignore\n\n*count\n|> _assert_eq 1","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  ///- --test --symbol
  ///> cuda
  ///> rust
  ///> typescript

  := count = mut 0i32
  := add =
      \ () =>
          count <- *count + 1
          count
      |> memoize

  add () |> ignore
  add () |> ignore
  add () |> ignore

  *count
  |> _assert_eq 1
  """,
  timeout: 300_000
)
```

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":":= capture \\* t. (fn : () -> t) : t =\n    backend_switch {\n        Gleam = \\ () =>\n            fn ()\n        Lua = \\ () =>\n            fn ()\n        Fsharp = \\ () =>\n            := result = dyn !+\n            $'let mutable _capture_!result : `t option = None '\n            $'('\n            $'(fun () ->'\n            $'(fun () ->'\n            fn () |> emit_unit\n            $')'\n            $'|> fun x -> x ()'\n            $') () )'\n            $'|> fun x -> _capture_!result <- Some x'\n            $'match _capture_!result with Some x -> x | None -> failwith \"base.capture / _capture_!result=None\"' : t\n        Python = \\ () =>\n            fn ()\n        Rust = \\ () => fn ()\n        Zig = \\ () => fn ()\n        Lean = \\ () => fn ()\n    }\n\n:= yield_from \\* (t : * -> *) u. (a : t u) : () =\n    backend_switch {\n        Fsharp = \\ () => $'yield\\! !a ' : ()\n        Python = \\ () => $'asyncio.run(!a())' : ()\n    }\n\n:= join_body body acc x =\n    ? var_is x |> not\n    ?> body acc x\n    |:\n        := acc = dyn acc\n        ~~ body acc x","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  := capture \* t. (fn : () -> t) : t =
      backend_switch {
          Gleam = \ () =>
              fn ()
          Lua = \ () =>
              fn ()
          Fsharp = \ () =>
              := result = dyn !+
              $'let mutable _capture_!result : `t option = None '
              $'('
              $'(fun () ->'
              $'(fun () ->'
              fn () |> emit_unit
              $')'
              $'|> fun x -> x ()'
              $') () )'
              $'|> fun x -> _capture_!result <- Some x'
              $'match _capture_!result with Some x -> x | None -> failwith "base.capture / _capture_!result=None"' : t
          Python = \ () =>
              fn ()
          Rust = \ () => fn ()
          Zig = \ () => fn ()
          Lean = \ () => fn ()
      }

  := yield_from \* (t : * -> *) u. (a : t u) : () =
      backend_switch {
          Fsharp = \ () => $'yield\! !a ' : ()
          Python = \ () => $'asyncio.run(!a())' : ()
      }

  := join_body body acc x =
      ? var_is x |> not
      ?> body acc x
      |:
          := acc = dyn acc
          ~~ body acc x
  """,
  timeout: 300_000
)
```

