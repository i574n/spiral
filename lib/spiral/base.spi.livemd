<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":":! infer = $'_'\n\n:! infer' t = $'_'\n\n:! any = $'obj'\n\n:= null \\* t. () : t =\n    backend_switch {\n        Gleam = \\ () => $'Nil' : t\n        Lua = \\ () => $'nil' : t\n        Fsharp = \\ () => $'null |> unbox<`t>' : t\n        Python = \\ () => $'None' : t\n        TypeScript = \\ () => $'null' : t\n        Zig = \\ () => $'std.mem.zeroes(`t)' : t\n    }\n\n:= ^ defaultof \\* t. (() : ()) : t =\n    := run default =\n        ~>\n            ?: t ?|\n            | string => \"\"\n            | int => 0\n            | char => '\\0'\n            | ~a * ~b => (defaultof `a ()), (defaultof `b ())\n            | option ~u => None `u\n            | ~t =>\n                ? real_core::union_type_is `t ?>\n                    real_core::union_untag `t 0\n                        (\\ k => \\* v. => real_core::nominal_create `t (k, ()))\n                        (\\ _ => failwith `t ($'\"defaultof / invalid tag\"' : string))\n                |: default ()\n    backend_switch {\n        Gleam = \\ () => run (\\ () => ($'\"base.defaultof / invalid type / t: `t\"') : t) : t\n        Lua = \\ () => run (\\ () => ($'\"base.defaultof / invalid type / t: `t\"') : t) : t\n        Fsharp = \\ () => run (\\ () => $'Unchecked.defaultof<`t>' : t) : t\n        Python = \\ () =>\n            run (\\ () =>\n                ~>\n                    ?: t ?|\n                    | i8 => 0i8\n                    | i16 => 0i16\n                    | i64 => 0i64\n                    | u8 => 0u8\n                    | u16 => 0u16\n                    | u32 => 0u32\n                    | u64 => 0u64\n                    | f32 => 0.0f32\n                    | f64 => 0.0f64\n                    | bool => !-\n                    | _ => $'\"base.defaultof / invalid type / t: `t\"' : t\n                : t\n            ) : t\n        Rust = \\ () => run (\\ () => $'Default::default()' : t) : t\n        C = \\ () => run (\\ () => $'(`t){0}' : t) : t\n        Pascal = \\ () => run (\\ () => $'Default(`t)' : t) : t\n        Zig = \\ () => run (\\ () => $'std.mem.zeroes(`t)' : t) : t\n        Lean = \\ () => run (\\ () => $'(default : `t)' : t) : t\n    }","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  :! infer = $'_'

  :! infer' t = $'_'

  :! any = $'obj'

  := null \* t. () : t =
      backend_switch {
          Gleam = \ () => $'Nil' : t
          Lua = \ () => $'nil' : t
          Fsharp = \ () => $'null |> unbox<`t>' : t
          Python = \ () => $'None' : t
          TypeScript = \ () => $'null' : t
          Zig = \ () => $'std.mem.zeroes(`t)' : t
      }

  := ^ defaultof \* t. (() : ()) : t =
      := run default =
          ~>
              ?: t ?|
              | string => ""
              | int => 0
              | char => '\0'
              | ~a * ~b => (defaultof `a ()), (defaultof `b ())
              | option ~u => None `u
              | ~t =>
                  ? real_core::union_type_is `t ?>
                      real_core::union_untag `t 0
                          (\ k => \* v. => real_core::nominal_create `t (k, ()))
                          (\ _ => failwith `t ($'"defaultof / invalid tag"' : string))
                  |: default ()
      backend_switch {
          Gleam = \ () => run (\ () => ($'"base.defaultof / invalid type / t: `t"') : t) : t
          Lua = \ () => run (\ () => ($'"base.defaultof / invalid type / t: `t"') : t) : t
          Fsharp = \ () => run (\ () => $'Unchecked.defaultof<`t>' : t) : t
          Python = \ () =>
              run (\ () =>
                  ~>
                      ?: t ?|
                      | i8 => 0i8
                      | i16 => 0i16
                      | i64 => 0i64
                      | u8 => 0u8
                      | u16 => 0u16
                      | u32 => 0u32
                      | u64 => 0u64
                      | f32 => 0.0f32
                      | f64 => 0.0f64
                      | bool => !-
                      | _ => $'"base.defaultof / invalid type / t: `t"' : t
                  : t
              ) : t
          Rust = \ () => run (\ () => $'Default::default()' : t) : t
          C = \ () => run (\ () => $'(`t){0}' : t) : t
          Pascal = \ () => run (\ () => $'Default(`t)' : t) : t
          Zig = \ () => run (\ () => $'std.mem.zeroes(`t)' : t) : t
          Lean = \ () => run (\ () => $'(default : `t)' : t) : t
      }
  """,
  timeout: 300_000
)
```

