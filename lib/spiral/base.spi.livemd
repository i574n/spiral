<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":":= new_pair \\* a b. (a : a) (b : b) : pair a b =\n    backend_switch {\n        Gleam = \\ () =>\n            $'##(!a, !b )' : pair a b\n        Lua = \\ () =>\n            $'{!a, !b}' : pair a b\n        Fsharp = \\ () =>\n            $'!a, !b ' : pair a b\n        Python = \\ () =>\n            $'!a, !b ' : pair a b\n        Rust = \\ () =>\n            := a, b = ~~ (a, b)\n            $'(!a, !b)' : pair a b\n        TypeScript = \\ () => $'[!a, !b]' : pair a b\n        Zig = \\ () => $'.{ !a, !b }' : pair a b\n    }\n\n:= from_pair \\* a b. (pair : pair a b) : a * b =\n    backend_switch {\n        Gleam = \\ () => ($'!pair.0' : a), ($'!pair.1' : b)\n        Lua = \\ () => ($'!pair[1]' : a), ($'!pair[2]' : b)\n        Fsharp = \\ () => ($'fst !pair ' : a), ($'snd !pair ' : b)\n        Python = \\ () => ($'!pair[0]' : a), ($'!pair[1]' : b)\n        Rust = \\ () => ($'!pair.0.clone()' : a), ($'!pair.1.clone()' : b)\n        TypeScript = \\ () => ($'!pair[0]' : a), ($'!pair[1]' : b)\n        Zig = \\ () => ($'!pair[0]' : a), ($'!pair[1]' : b)\n    }","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  := new_pair \* a b. (a : a) (b : b) : pair a b =
      backend_switch {
          Gleam = \ () =>
              $'##(!a, !b )' : pair a b
          Lua = \ () =>
              $'{!a, !b}' : pair a b
          Fsharp = \ () =>
              $'!a, !b ' : pair a b
          Python = \ () =>
              $'!a, !b ' : pair a b
          Rust = \ () =>
              := a, b = ~~ (a, b)
              $'(!a, !b)' : pair a b
          TypeScript = \ () => $'[!a, !b]' : pair a b
          Zig = \ () => $'.{ !a, !b }' : pair a b
      }

  := from_pair \* a b. (pair : pair a b) : a * b =
      backend_switch {
          Gleam = \ () => ($'!pair.0' : a), ($'!pair.1' : b)
          Lua = \ () => ($'!pair[1]' : a), ($'!pair[2]' : b)
          Fsharp = \ () => ($'fst !pair ' : a), ($'snd !pair ' : b)
          Python = \ () => ($'!pair[0]' : a), ($'!pair[1]' : b)
          Rust = \ () => ($'!pair.0.clone()' : a), ($'!pair.1.clone()' : b)
          TypeScript = \ () => ($'!pair[0]' : a), ($'!pair[1]' : b)
          Zig = \ () => ($'!pair[0]' : a), ($'!pair[1]' : b)
      }
  """,
  timeout: 300_000
)
```

