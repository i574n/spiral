```elixir
Spiral.Kino.eval!(
  ~S"""
  ///- --test
  ///> fsharp

  inl get_solutions () =
      [
          "A",
          fun n =>
              n + 1f64
      ]

  inl rec empty_1_tests () =
      inl test_cases = [
          0, 1
          2, 3
          5, 6
      ]

      inl solutions = get_solutions ()

      // inl is_fast () = true

      inl count =
          if is_fast ()
          then 1000i32
          else 2000000i32

      run_all (reflection.nameof { empty_1_tests }) count solutions test_cases
      |> sort_result_list

  empty_1_tests ()
  """,
  timeout: 300_000
)
```
