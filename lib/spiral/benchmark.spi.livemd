```elixir
Spiral.Cells.eval!(
  ~S"""
  ///- --test --symbol
  ///> fsharp

  := get_solutions () =
      [
          "A",
          \ n =>
              n + 1f64
      ]

  := ^ empty_1_tests () =
      := test_cases = [
          0, 1
          2, 3
          5, 6
      ]

      := solutions = get_solutions ()


      := count =
          ? is_fast ()
          ?> 1000i32
          |: 2000000i32

      run_all (reflection::nameof { empty_1_tests }) count solutions test_cases
      |> sort_result_list

  empty_1_tests ()
  """,
  timeout: 300_000
)
```
