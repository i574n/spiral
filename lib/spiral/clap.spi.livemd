<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":":= command_arg (arg : arg) (command : command) : command =\n    !\\\\((command, arg), $'\"clap::Command::arg($0, $1)\"')\n\n:= arg_required (value : bool) (arg : arg) : arg =\n    !\\\\((arg, value), $'\"$0.required($1)\"')\n\n:= arg_require_equals (value : bool) (arg : arg) : arg =\n    !\\\\((arg, value), $'\"$0.require_equals($1)\"')\n\n:= arg_default_value (value : string) (arg : arg) : arg =\n    := value = #value\n    !\\\\((arg, value), $'\"$0.default_value(&*Box::leak(String::from($1).into_boxed_str()))\"')\n\n:= arg_default_missing_value (value : string) (arg : arg) : arg =\n    := value = #value\n    backend_switch {\n        Rust = fun () => !\\\\((arg, value), $'\"$0.default_missing_value(&*Box::leak(String::from($1).into_boxed_str()))\\\n            \"') : arg\n    }\n\n:= arg_short (value : char) (arg : arg) : arg =\n    !\\\\((arg, value), $'\"$0.short($1 as char)\"')\n\n:= arg_long (value : rust::static_ref sm'::str) (arg : arg) : arg =\n    !\\\\((arg, value), $'\"$0.long($1)\"')\n\n:= arg_value_names (values : array_base (rust::static_ref sm'::str)) (arg : arg) : arg =\n    := values = values |> am'::to_vec\n    !\\\\((arg, values), $'\"$0.value_names($1)\"')\n\n:! value_range =\n    `(\n        rust::rust_type\n            `($'clap_builder_ValueRange')\n            `($'clap::builder::ValueRange')\n            \"type clap_builder_ValueRange = class end\"\n    )\n\n:= new_value_range \\* t. inclusive (start : _ t) (end : _ t) : value_range =\n    := len () =\n        0i32 |> convert::convert\n    := start, end =\n        :< am'\n        ?= start, end ?|\n        | Start start, End fn =>\n            start, len |> fn\n        | End start_fn, End end_fn =>\n            start_fn len, end_fn len\n    := inclusive =\n        ? inclusive\n        ?> \"=\"\n        |: \"\"\n    ?= start, end ?|\n    | start, end ?& end =. len () => !\\\\(start, $'\"clap::builder::ValueRange::new($0..)\"')\n    | start, end => !\\\\((start, end), $'\"clap::builder::ValueRange::new($0..\" + !inclusive + \"$1)\"')\n\n:= arg_num_args_range (value : value_range) (arg : arg) : arg =\n    !\\\\((arg, value), $'\"$0.num_args($1)\"')\n\n:! value_parser =\n    `(\n        rust::rust_type\n            `($'clap_builder_ValueParser')\n            `($'clap::builder::ValueParser')\n            \"type clap_builder_ValueParser = class end\"\n    )\n\n:! possible_value =\n    `(\n        rust::rust_type\n            `($'clap_builder_PossibleValue')\n            `($'clap::builder::PossibleValue')\n            \"type clap_builder_PossibleValue = class end\"\n    )\n\n:= new_possible_value \\* t. (x : t) : possible_value =\n    !\\\\(x, $'\"clap::builder::PossibleValue::new(&**$0)\"')\n\n:= arg_value_parser (values : value_parser) (arg : arg) : arg =\n    !\\\\((arg, values), $'\"$0.value_parser($1)\"')\n\n:! arg_action' =\n    `(\n        rust::rust_type\n            `($'clap_ArgAction')\n            `($'clap::ArgAction')\n            \"type clap_ArgAction = class end\"\n    )\n\n:| arg_action =\n    | Set\n    | Append\n    | SetTrue\n    | SetFalse\n    | Count\n    | Help\n    | HelpShort\n    | HelpLong\n    | Version\n\n:= arg_action = \\|\n    | Set => !\\($'\"clap::ArgAction::Set\"') : arg_action'\n    | Append => !\\($'\"clap::ArgAction::Append\"') : arg_action'\n    | SetTrue => !\\($'\"clap::ArgAction::SetTrue\"') : arg_action'\n    | SetFalse => !\\($'\"clap::ArgAction::SetFalse\"') : arg_action'\n    | Count => !\\($'\"clap::ArgAction::Count\"') : arg_action'\n    | Help => !\\($'\"clap::ArgAction::Help\"') : arg_action'\n    | HelpShort => !\\($'\"clap::ArgAction::HelpShort\"') : arg_action'\n    | HelpLong => !\\($'\"clap::ArgAction::HelpLong\"') : arg_action'\n    | Version => !\\($'\"clap::ArgAction::Version\"') : arg_action'\n\n:= arg_action (value : arg_action) (arg : arg) : arg =\n    := value = value |> arg_action\n    !\\\\((arg, value), $'\"$0.action($1)\"')\n\n:= arg_index (value : i32) (arg : arg) : arg =\n    := index : convert::unativeint = convert::convert value\n    !\\\\((arg, index), $'\"$0.index($1)\"')\n\n:! arg_matches =\n    `(\n        rust::rust_type\n            `($'clap_ArgMatches')\n            `($'clap::ArgMatches')\n            \"type clap_ArgMatches = class end\"\n    )\n\n:= command_get_matches (command : command) : arg_matches =\n    !\\\\(command, $'\"clap::Command::get_matches($0)\"')\n\n:= command_get_matches_from (args : array_base string) (command : command) : arg_matches =\n    := args = args |> am'::to_vec |> am'::vec_map sm'::to_std_string\n    !\\\\(command, $'\"clap::Command::get_matches_from($0, !args)\"')\n\n:= command_args_override_self (yes : bool) (command : command) : command =\n    !\\\\(command, $'\"clap::Command::args_override_self($0, !yes)\"')\n\n:= command_init_arg (long, short) fn command =\n    command\n    |> command_arg (\n        ###long\n        |> new_arg\n        |> arg_short short\n        |> arg_long ###long\n        |> fn\n    )\n\n:= matches_get_one \\* t. (x : string) (matches : arg_matches) : optionm'::option' t =\n    := x = ~~ x\n    := x = x |> sm'::as_str\n    !\\\\((matches, x), $'\"clap::ArgMatches::get_one(&$0, $1).cloned()\"')\n\n:= matches_get_flag (x : string) (matches : arg_matches) : bool =\n    := x = ~~ x\n    := x = x |> sm'::as_str\n    !\\\\((matches, x), $'\"clap::ArgMatches::get_flag(&$0, $1)\"')\n\n:= matches_get_many \\* t. (x : string) (matches : arg_matches) : optionm'::option' (am'::vec t) =\n    := x = ~~ x\n    := x = x |> sm'::as_str\n    !\\\\((matches, x), $'\"clap::ArgMatches::get_many(&$0, $1).map(|x| x.cloned().into_iter().collect())\"')\n\n:= matches_subcommand (matches : arg_matches) : optionm'::option' (sm'::std_string * arg_matches) =\n    !\\\\((matches, sm'.ref_to_std_string), $'\"clap::ArgMatches::subcommand(Box::leak(Box::new($0))).map(|(a, b)| \\\n        ($1(a), b.clone()))\"')\n\n:= command_subcommand_required (value : bool) (command : command) : command =\n    !\\\\(command, $'\"clap::Command::subcommand_required($0, !value)\"')\n\n:= command_subcommand (subcommand : command) (command : command) : command =\n    !\\\\(command, $'\"clap::Command::subcommand($0, !subcommand)\"')\n\n:= value_parser_possible_values (values : array_base string) : value_parser =\n    := values =\n        values\n        |> am'::to_vec\n        |> am'::vec_map (sm'::to_std_string >> rust::new_box >> rust::box_leak >> new_possible_value)\n    !\\\\(values, $'\"Into::<clap::builder::ValueParser>::into(clap::builder::PossibleValuesParser::new($0))\"')\n\n:= arg_union \\* union_type. (fn : union_type -> ()) (arg : arg) : arg =\n    arg\n    |> arg_value_parser (\n        ~> reflection::get_union_fields_untag `union_type ()\n        |> \\ x => x : _ (string * union_type)\n        |> listm::map (fst >> sm'::to_lower)\n        |> listm'::box\n        |> listm'::to_array'\n        |> value_parser_possible_values\n    )","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  := command_arg (arg : arg) (command : command) : command =
      !\\((command, arg), $'"clap::Command::arg($0, $1)"')

  := arg_required (value : bool) (arg : arg) : arg =
      !\\((arg, value), $'"$0.required($1)"')

  := arg_require_equals (value : bool) (arg : arg) : arg =
      !\\((arg, value), $'"$0.require_equals($1)"')

  := arg_default_value (value : string) (arg : arg) : arg =
      := value = #value
      !\\((arg, value), $'"$0.default_value(&*Box::leak(String::from($1).into_boxed_str()))"')

  := arg_default_missing_value (value : string) (arg : arg) : arg =
      := value = #value
      backend_switch {
          Rust = fun () => !\\((arg, value), $'"$0.default_missing_value(&*Box::leak(String::from($1).into_boxed_str()))\
              "') : arg
      }

  := arg_short (value : char) (arg : arg) : arg =
      !\\((arg, value), $'"$0.short($1 as char)"')

  := arg_long (value : rust::static_ref sm'::str) (arg : arg) : arg =
      !\\((arg, value), $'"$0.long($1)"')

  := arg_value_names (values : array_base (rust::static_ref sm'::str)) (arg : arg) : arg =
      := values = values |> am'::to_vec
      !\\((arg, values), $'"$0.value_names($1)"')

  :! value_range =
      `(
          rust::rust_type
              `($'clap_builder_ValueRange')
              `($'clap::builder::ValueRange')
              "type clap_builder_ValueRange = class end"
      )

  := new_value_range \* t. inclusive (start : _ t) (end : _ t) : value_range =
      := len () =
          0i32 |> convert::convert
      := start, end =
          :< am'
          ?= start, end ?|
          | Start start, End fn =>
              start, len |> fn
          | End start_fn, End end_fn =>
              start_fn len, end_fn len
      := inclusive =
          ? inclusive
          ?> "="
          |: ""
      ?= start, end ?|
      | start, end ?& end =. len () => !\\(start, $'"clap::builder::ValueRange::new($0..)"')
      | start, end => !\\((start, end), $'"clap::builder::ValueRange::new($0.." + !inclusive + "$1)"')

  := arg_num_args_range (value : value_range) (arg : arg) : arg =
      !\\((arg, value), $'"$0.num_args($1)"')

  :! value_parser =
      `(
          rust::rust_type
              `($'clap_builder_ValueParser')
              `($'clap::builder::ValueParser')
              "type clap_builder_ValueParser = class end"
      )

  :! possible_value =
      `(
          rust::rust_type
              `($'clap_builder_PossibleValue')
              `($'clap::builder::PossibleValue')
              "type clap_builder_PossibleValue = class end"
      )

  := new_possible_value \* t. (x : t) : possible_value =
      !\\(x, $'"clap::builder::PossibleValue::new(&**$0)"')

  := arg_value_parser (values : value_parser) (arg : arg) : arg =
      !\\((arg, values), $'"$0.value_parser($1)"')

  :! arg_action' =
      `(
          rust::rust_type
              `($'clap_ArgAction')
              `($'clap::ArgAction')
              "type clap_ArgAction = class end"
      )

  :| arg_action =
      | Set
      | Append
      | SetTrue
      | SetFalse
      | Count
      | Help
      | HelpShort
      | HelpLong
      | Version

  := arg_action = \|
      | Set => !\($'"clap::ArgAction::Set"') : arg_action'
      | Append => !\($'"clap::ArgAction::Append"') : arg_action'
      | SetTrue => !\($'"clap::ArgAction::SetTrue"') : arg_action'
      | SetFalse => !\($'"clap::ArgAction::SetFalse"') : arg_action'
      | Count => !\($'"clap::ArgAction::Count"') : arg_action'
      | Help => !\($'"clap::ArgAction::Help"') : arg_action'
      | HelpShort => !\($'"clap::ArgAction::HelpShort"') : arg_action'
      | HelpLong => !\($'"clap::ArgAction::HelpLong"') : arg_action'
      | Version => !\($'"clap::ArgAction::Version"') : arg_action'

  := arg_action (value : arg_action) (arg : arg) : arg =
      := value = value |> arg_action
      !\\((arg, value), $'"$0.action($1)"')

  := arg_index (value : i32) (arg : arg) : arg =
      := index : convert::unativeint = convert::convert value
      !\\((arg, index), $'"$0.index($1)"')

  :! arg_matches =
      `(
          rust::rust_type
              `($'clap_ArgMatches')
              `($'clap::ArgMatches')
              "type clap_ArgMatches = class end"
      )

  := command_get_matches (command : command) : arg_matches =
      !\\(command, $'"clap::Command::get_matches($0)"')

  := command_get_matches_from (args : array_base string) (command : command) : arg_matches =
      := args = args |> am'::to_vec |> am'::vec_map sm'::to_std_string
      !\\(command, $'"clap::Command::get_matches_from($0, !args)"')

  := command_args_override_self (yes : bool) (command : command) : command =
      !\\(command, $'"clap::Command::args_override_self($0, !yes)"')

  := command_init_arg (long, short) fn command =
      command
      |> command_arg (
          ###long
          |> new_arg
          |> arg_short short
          |> arg_long ###long
          |> fn
      )

  := matches_get_one \* t. (x : string) (matches : arg_matches) : optionm'::option' t =
      := x = ~~ x
      := x = x |> sm'::as_str
      !\\((matches, x), $'"clap::ArgMatches::get_one(&$0, $1).cloned()"')

  := matches_get_flag (x : string) (matches : arg_matches) : bool =
      := x = ~~ x
      := x = x |> sm'::as_str
      !\\((matches, x), $'"clap::ArgMatches::get_flag(&$0, $1)"')

  := matches_get_many \* t. (x : string) (matches : arg_matches) : optionm'::option' (am'::vec t) =
      := x = ~~ x
      := x = x |> sm'::as_str
      !\\((matches, x), $'"clap::ArgMatches::get_many(&$0, $1).map(|x| x.cloned().into_iter().collect())"')

  := matches_subcommand (matches : arg_matches) : optionm'::option' (sm'::std_string * arg_matches) =
      !\\((matches, sm'.ref_to_std_string), $'"clap::ArgMatches::subcommand(Box::leak(Box::new($0))).map(|(a, b)| \
          ($1(a), b.clone()))"')

  := command_subcommand_required (value : bool) (command : command) : command =
      !\\(command, $'"clap::Command::subcommand_required($0, !value)"')

  := command_subcommand (subcommand : command) (command : command) : command =
      !\\(command, $'"clap::Command::subcommand($0, !subcommand)"')

  := value_parser_possible_values (values : array_base string) : value_parser =
      := values =
          values
          |> am'::to_vec
          |> am'::vec_map (sm'::to_std_string >> rust::new_box >> rust::box_leak >> new_possible_value)
      !\\(values, $'"Into::<clap::builder::ValueParser>::into(clap::builder::PossibleValuesParser::new($0))"')

  := arg_union \* union_type. (fn : union_type -> ()) (arg : arg) : arg =
      arg
      |> arg_value_parser (
          ~> reflection::get_union_fields_untag `union_type ()
          |> \ x => x : _ (string * union_type)
          |> listm::map (fst >> sm'::to_lower)
          |> listm'::box
          |> listm'::to_array'
          |> value_parser_possible_values
      )
  """,
  timeout: 300_000
)
```

#### arg_union (test)

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":"///- --test --symbol\n///> rust -d clap\n\n###\"command\"\n|> new_command\n|> command_init_arg (\"trace-level\", 't') (\n    ~> arg_union `trace_level ignore\n)\n|> command_get_matches_from (am'::base ;[ \"_\"; \"--trace-level\"; \"critical\" ])\n|> matches_get_one \"trace-level\"\n|> optionm'::unwrap\n|> sm'::from_std_string\n|> reflection::union_try_pick\n|> optionm::value\n|> _assert_eq Critical","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  ///- --test --symbol
  ///> rust -d clap

  ###"command"
  |> new_command
  |> command_init_arg ("trace-level", 't') (
      ~> arg_union `trace_level ignore
  )
  |> command_get_matches_from (am'::base ;[ "_"; "--trace-level"; "critical" ])
  |> matches_get_one "trace-level"
  |> optionm'::unwrap
  |> sm'::from_std_string
  |> reflection::union_try_pick
  |> optionm::value
  |> _assert_eq Critical
  """,
  timeout: 300_000
)
```

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":":= command_debug_assert (command : command) : () =\n    !\\\\(command, $'\"clap::Command::debug_assert($0)\"')","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  := command_debug_assert (command : command) : () =
      !\\(command, $'"clap::Command::debug_assert($0)"')
  """,
  timeout: 300_000
)
