## fsharp

#!markdown

### upcast

#!spiral

inl upcast forall t u. (x : t) : u =
    $'!x :> `u '

#!markdown

### downcast

#!spiral

inl downcast forall t u. (x : t) : u =
    $'!x :?> `u '

#!markdown

### random

#!spiral

nominal random = $'System.Random'

inl random () : random =
    $'`random ' ()

#!markdown

### random_next

#!spiral

inl random_next (min : i32) (max : i32) (random : random) : i32 =
    $'!random.Next (!min, !max)'

#!markdown

### disposable

#!spiral

type disposable_switch t =
    {
        Gleam : $'Nil'
        Fsharp : $'System.IDisposable'
        Python : $'object'
        Rust : $'Rc<dyn Fn()>'
    }
nominal disposable t = $'backend_switch `(disposable_switch t)'

#!markdown

### dispose

#!spiral

inl dispose (disposable : disposable _) : () =
    backend_switch {
        Gleam = fun () => $'// common.dispose' : ()
        Lua = fun () => $'-- common.dispose' : ()
        Fsharp = fun () => disposable |> $'_.Dispose()' : ()
        Python = fun () => $'!disposable.__exit__(None, None, None)' : ()
        Rust = fun () => $'(!disposable)()' : ()
    }

#!markdown

### yield

#!spiral

inl yield forall t. (x : t) : () =
    $'yield !x '

#!markdown

### return

#!spiral

inl return forall t. (x : t) : () =
    $'return !x '

#!markdown

### return'

#!spiral

inl return' forall t. (x : t) : t =
    $'return !x '

#!markdown

### return_in

#!spiral

inl return_in forall t. (x : t) : t =
    $'!x in return !x '

#!markdown

### retry_fn

#!spiral

inl retry_fn forall t. retries (fn : () -> t) : option t =
    let rec 루프 retry =
        try
            fun () =>
                if retry < retries
                then fn () |> Some
                else None
            fun ex =>
                trace Warning
                    fun () => "common.retry_fn"
                    fun () => { retry ex }
                None
        |> function
            | Some x => x
            | None => 루프 (retry + 1)
    루프 0

#!spiral

///- --test
///> fsharp
///> cuda
///> rust
///> typescript

inl retry_fn_test = mut 0i32
fun () =>
    retry_fn_test <- *retry_fn_test + 1
    *retry_fn_test
|> retry_fn 3i32
|> _assert_eq' (Some 1i32)

#!spiral

///- --test
///> fsharp
////> cuda // v3 = $"retry: {v0} / ex: %A{v1} / {v2 ()}"
///> rust
///> typescript
///> cuda

inl retry_fn_test = mut 0i32
fun () =>
    if *retry_fn_test >= 2
    then *retry_fn_test
    else
        retry_fn_test <- *retry_fn_test + 1
        failwith "test"
|> retry_fn 3i32
|> _assert_eq' (Some 2i32)

