## common

#!markdown

### retry_fn'

#!spiral

inl retry_fn' retries fn =
    let rec 루프 retry =
        inl is_error, result =
            match fn () with
            | Ok x => false, x
            | Error x => true, x
        if not is_error || retry >= retries
        then result
        else
            trace Debug
                fun () => "common.retry_fn\' / 루프"
                fun () => { is_error retry = $'$"{!retry}/{!retries}"' : string; result }
            루프 (retry + 1)
    루프 1

