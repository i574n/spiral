### retry_fn

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"inl retry_fn forall t. retries (fn : () -> t) : option t =\n    let rec 루프 retry =\n        try\n            fun () =>\n                if retry < retries\n                then fn () |> Some\n                else None\n            fun ex =>\n                trace Warning\n                    fun () => \"common.retry_fn\"\n                    fun () => { retry ex }\n                None\n        |> function\n            | Some x => x\n            | None => 루프 (retry + 1)\n    루프 0","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  inl retry_fn forall t. retries (fn : () -> t) : option t =
      let rec 루프 retry =
          try
              fun () =>
                  if retry < retries
                  then fn () |> Some
                  else None
              fun ex =>
                  trace Warning
                      fun () => "common.retry_fn"
                      fun () => { retry ex }
                  None
          |> function
              | Some x => x
              | None => 루프 (retry + 1)
      루프 0
  """,
  timeout: 300_000
)
```

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"///- --test\n///> fsharp\n///> cuda\n///> rust\n///> typescript\n\ninl retry_fn_test = mut 0i32\nfun () =>\n    retry_fn_test <- *retry_fn_test + 1\n    *retry_fn_test\n|> retry_fn 3i32\n|> _assert_eq' (Some 1i32)","print_code":false},"livebook_object":"smart_cell"} -->

