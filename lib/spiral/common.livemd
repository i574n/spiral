### retry_fn'

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"inl retry_fn' retries fn =\n    let rec 루프 retry =\n        inl is_error, result =\n            match fn () with\n            | Ok x => false, x\n            | Error x => true, x\n        if not is_error || retry >= retries\n        then result\n        else\n            trace Debug\n                fun () => \"common.retry_fn\\' / 루프\"\n                fun () =>\n                    open sm'_operators\n                    { is_error retry = sm'.obj_to_string retry ++# \"/\" ++# sm'.obj_to_string retries; result }\n            루프 (retry + 1)\n    루프 1","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  inl retry_fn' retries fn =
      let rec 루프 retry =
          inl is_error, result =
              match fn () with
              | Ok x => false, x
              | Error x => true, x
          if not is_error || retry >= retries
          then result
          else
              trace Debug
                  fun () => "common.retry_fn\' / 루프"
                  fun () =>
                      open sm'_operators
                      { is_error retry = sm'.obj_to_string retry ++# "/" ++# sm'.obj_to_string retries; result }
              루프 (retry + 1)
      루프 1
  """,
  timeout: 300_000
)
```

