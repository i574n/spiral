/// # common
test common static =
    :< testing

/// ## common

/// ### retry_fn'
:= retry_fn' retries fn =
    :~ ^ 루프 retry =
        := is_error, result =
            ?= fn () ?|
            | Ok x => !-, x
            | Error x => !+, x
        ? not is_error || retry >= retries
        ?> result
        |:
            trace Debug
                \ () => "common.retry_fn\' / 루프"
                \ () =>
                    :< sm'_operators
                    { is_error retry = sm'.obj_to_string retry ++# "/" ++# sm'.obj_to_string retries; result }
            루프 (retry + 1)
    루프 1

/// ## fsharp

/// ### upcast
:= upcast \* t u. (x : t) : u =
    $'!x :> `u '

/// ### downcast
:= downcast \* t u. (x : t) : u =
    $'!x :?> `u '

/// ### random
:! random = $'System.Random'

:= random () : random =
    $'`random ' ()

/// ### random_next
:= random_next (min : i32) (max : i32) (random : random) : i32 =
    $'!random.Next (!min, !max)'

/// ### disposable
:== disposable_switch t =
    {
        Gleam : $'Nil'
        Fsharp : $'System.IDisposable'
        Python : $'object'
        Rust : $'Rc<dyn Fn()>'
        TypeScript : $'() => void'
    }
:! disposable t = $'backend_switch `(disposable_switch t)'

/// ### dispose
:= dispose (disposable : disposable _) : () =
    backend_switch {
        Gleam = \ () => $'// common.dispose' : ()
        Lua = \ () => $'-- common.dispose' : ()
        Fsharp = \ () => disposable |> $'_.Dispose()' : ()
        Python = \ () => $'!disposable.__exit__(None, None, None)' : ()
        Rust = \ () => $'(!disposable)()' : ()
        TypeScript = \ () => $'(!disposable)()' : ()
    }

/// ### yield
:= yield \* t. (x : t) : () =
    $'yield !x '

/// ### return
:= return \* t. (x : t) : () =
    $'return !x '

/// ### return'
:= return' \* t. (x : t) : t =
    $'return !x '

/// ### return_in
:= return_in \* t. (x : t) : t =
    $'!x in return !x '

/// ### retry_fn
:= retry_fn \* t. retries (fn : () -> t) : option t =
    :~ ^ 루프 retry =
        try
            \ () =>
                ? retry < retries
                ?> fn () |> Some
                |: None
            \ ex =>
                trace Warning
                    \ () => "common.retry_fn"
                    \ () => { retry ex }
                None
        |> \|
            | Some x => x
            | None => 루프 (retry + 1)
    루프 0

///> fsharp
///> cuda
///> rust
///> typescript
test retry_fn =
    := retry_fn_test = mut 0i32
    \ () =>
        retry_fn_test <- *retry_fn_test + 1
        *retry_fn_test
    |> retry_fn 3i32
    |> _assert_eq' (Some 1i32)

///> fsharp
///> rust
///> typescript
///> cuda
test retry_fn_2 =
    := retry_fn_test = mut 0i32
    \ () =>
        ? *retry_fn_test >= 2
        ?> *retry_fn_test
        |:
            retry_fn_test <- *retry_fn_test + 1
            failwith "test"
    |> retry_fn 3i32
    |> _assert_eq' (Some 2i32)

/// ## common

/// ### lua_math_random
:= lua_math_random (low : i32) (high : i32) : i32 = $'math.random(!low, !high)' : i32

/// ### random'
:= random' \* t. (min : t) (max : t) : t =
    run_target \|
        | Zig => \ () =>
            := x = guid.zig_random_u64 ()
            $'(blk: { const lo: i128 = !min; const span: i128 = \@as(i128, !max) - lo; const n: i128 = if (span <= 0) \
                0 else \@intCast(\@as(u128, !x) % \@as(u128, \@intCast(span))); break :blk \@as(`t, \@intCast(lo + \
                n)); })' : t
        | Rust => \ () =>
            :< rust.rust_operators
            !\\((min, max), $'"{ use std::sync::atomic::{AtomicU64, Ordering}; use std::hash::{BuildHasher, Hasher}; \
                static SPIRAL_NATIVE_RNG: AtomicU64 = AtomicU64::new(0); let mut x = \
                SPIRAL_NATIVE_RNG.load(Ordering::Relaxed); if x == 0 { let mut h = \
                std::collections::hash_map::RandomState::new().build_hasher(); \
                h.write_u128(std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).map(|d| \
                d.as_nanos()).unwrap_or(0)); x = h.finish() | 1; } x ^= x << 13; x ^= x >> 7; x ^= x << 17; \
                SPIRAL_NATIVE_RNG.store(x, Ordering::Relaxed); let span = ($1 as i128) - ($0 as i128); let n = if \
                span <= 0 { 0 } else { (x as i128) % span }; (($0 as i128) + n) as _ }"')
        | Cuda _ => \ () =>
            global "import random"
            $'random.randrange(!min, !max)' : t
        | TypeScript => \ () =>
            $'(() => { const a = Number(!min), b = Number(!max); const r = a + Math.floor(Math.random() * Math.max(0, \
                b - a)); return (typeof !min === "bigint" ? BigInt(r) : r); })()' : t
        | Lua => \ () =>
            := low, high = convert.i32 min, convert.i32 max - 1i32
            convert.convert (? high < low ?> low |: lua_math_random low high)
        | _ => \ () =>
            random () |> random_next (convert.i32 min) (convert.i32 max) |> convert.convert

///> lua
test random_draws_stay_in_their_half_open_range =
    :~ ^ outside (draws : i32) : i32 =
        ? draws = 0i32 ?> 0i32
        |:
            := x = random' 3i32 7i32
            (? x < 3i32 || x >= 7i32 ?> 1i32 |: 0i32) + outside (draws - 1i32)
    (outside 200i32, random' 5i32 5i32, random' 5i32 6i32) |> _assert_eq (0i32, 5i32, 5i32)

/// ### new_disposable
:= new_disposable (fn : () -> ()) : disposable _ =
    run_target \|
        | Rust => \ () =>
            :< rust.rust_operators
            !\\(fn, $'"$0.clone()"') : disposable _
        | TypeScript => \ () =>
            := fn = ~~ fn
            $'!fn ' : disposable _
        | Fsharp _ => \ () =>
            := fn = ~~ fn
            $'{ new System.IDisposable with member _.Dispose () = !fn () }'
        | Cuda _ => \ () =>
            $'class Disposable:'
            $'    def __init__(self, fn):'
            $'        self.fn = fn'
            $'    def __exit__(self, exc_type, exc_value, traceback):'
            $'        self.fn()'
            $'        return False'
            $'Disposable(!fn)'
        | _ => \ () => null ()

///> fsharp
///> cuda
///> rust
///> typescript
test new_disposable =
    := new_disposable_test = mut 0i32
    new_disposable \ () => new_disposable_test <- *new_disposable_test + 1
    |> \ x => x : disposable ()
    |> dispose
    *new_disposable_test |> _assert_eq 1

///> fsharp
test new_disposable_2 =
    := new_disposable_test = mut 0i32
    \ () =>
        new_disposable \ () => new_disposable_test <- *new_disposable_test + 1
        |> \ x => x : disposable ()
        |> use
        |> ignore
        |> return
    |> async.new_task
    |> async.await_task
    |> async.run_synchronously
    *new_disposable_test |> _assert_eq 1

///> fsharp
test new_disposable_3 =
    := new_disposable_test = mut 0i32
    \ () =>
        new_disposable \ () => new_disposable_test <- *new_disposable_test + 1
        |> \ x => x : disposable ()
        |> ignore
        |> return
    |> async.new_task
    |> async.await_task
    |> async.run_synchronously
    *new_disposable_test |> _assert_eq 0

/// ## main
///> fsharp

:= main () =
    init_trace_state None
    := new_disposable x : _ () = new_disposable x
    $'let new_disposable x = !new_disposable x' : ()
    := retry_fn (r : i32) (x : () -> _) : optionm'.option' () = retry_fn r x |> optionm'.box
    $'let retry_fn x = !retry_fn x' : ()
    := memoize (fn : () -> ()) : () -> () = memoize fn
    $'let memoize x = !memoize x' : ()
