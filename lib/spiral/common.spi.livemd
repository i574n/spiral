<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":":= retry_fn' retries fn =\n    :~ ^ 루프 retry =\n        := is_error, result =\n            ?= fn () ?|\n            | Ok x => !-, x\n            | Error x => !+, x\n        ? not is_error || retry >= retries\n        ?> result\n        |:\n            trace Debug\n                \\ () => \"common.retry_fn\\' / 루프\"\n                \\ () =>\n                    :< sm'_operators\n                    { is_error retry = sm'::obj_to_string retry ++# \"/\" ++# sm'::obj_to_string retries; result }\n            루프 (retry + 1)\n    루프 1\n\n:= upcast \\* t u. (x : t) : u =\n    $'!x :> `u '\n\n:= downcast \\* t u. (x : t) : u =\n    $'!x :?> `u '\n\n:! random = $'System.Random'\n\n:= random () : random =\n    $'`random ' ()\n\n:= random_next (min : i32) (max : i32) (random : random) : i32 =\n    $'!random.Next (!min, !max)'\n\n:== disposable_switch t =\n    {\n        Gleam : $'Nil'\n        Fsharp : $'System.IDisposable'\n        Python : $'object'\n        Rust : $'Rc<dyn Fn()>'\n        TypeScript : $'() => void'\n    }\n:! disposable t = $'backend_switch `(disposable_switch t)'\n\n:= dispose (disposable : disposable _) : () =\n    backend_switch {\n        Gleam = \\ () => $'// common.dispose' : ()\n        Lua = \\ () => $'-- common.dispose' : ()\n        Fsharp = \\ () => disposable |> $'_.Dispose()' : ()\n        Python = \\ () => $'!disposable.__exit__(None, None, None)' : ()\n        Rust = \\ () => $'(!disposable)()' : ()\n        TypeScript = \\ () => $'(!disposable)()' : ()\n    }\n\n:= yield \\* t. (x : t) : () =\n    $'yield !x '\n\n:= return \\* t. (x : t) : () =\n    $'return !x '\n\n:= return' \\* t. (x : t) : t =\n    $'return !x '\n\n:= return_in \\* t. (x : t) : t =\n    $'!x in return !x '\n\n:= retry_fn \\* t. retries (fn : () -> t) : option t =\n    :~ ^ 루프 retry =\n        try\n            \\ () =>\n                ? retry < retries\n                ?> fn () |> Some\n                |: None\n            \\ ex =>\n                trace Warning\n                    \\ () => \"common.retry_fn\"\n                    \\ () => { retry ex }\n                None\n        |> \\|\n            | Some x => x\n            | None => 루프 (retry + 1)\n    루프 0","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  := retry_fn' retries fn =
      :~ ^ 루프 retry =
          := is_error, result =
              ?= fn () ?|
              | Ok x => !-, x
              | Error x => !+, x
          ? not is_error || retry >= retries
          ?> result
          |:
              trace Debug
                  \ () => "common.retry_fn\' / 루프"
                  \ () =>
                      :< sm'_operators
                      { is_error retry = sm'::obj_to_string retry ++# "/" ++# sm'::obj_to_string retries; result }
              루프 (retry + 1)
      루프 1

  := upcast \* t u. (x : t) : u =
      $'!x :> `u '

  := downcast \* t u. (x : t) : u =
      $'!x :?> `u '

  :! random = $'System.Random'

  := random () : random =
      $'`random ' ()

  := random_next (min : i32) (max : i32) (random : random) : i32 =
      $'!random.Next (!min, !max)'

  :== disposable_switch t =
      {
          Gleam : $'Nil'
          Fsharp : $'System.IDisposable'
          Python : $'object'
          Rust : $'Rc<dyn Fn()>'
          TypeScript : $'() => void'
      }
  :! disposable t = $'backend_switch `(disposable_switch t)'

  := dispose (disposable : disposable _) : () =
      backend_switch {
          Gleam = \ () => $'// common.dispose' : ()
          Lua = \ () => $'-- common.dispose' : ()
          Fsharp = \ () => disposable |> $'_.Dispose()' : ()
          Python = \ () => $'!disposable.__exit__(None, None, None)' : ()
          Rust = \ () => $'(!disposable)()' : ()
          TypeScript = \ () => $'(!disposable)()' : ()
      }

  := yield \* t. (x : t) : () =
      $'yield !x '

  := return \* t. (x : t) : () =
      $'return !x '

  := return' \* t. (x : t) : t =
      $'return !x '

  := return_in \* t. (x : t) : t =
      $'!x in return !x '

  := retry_fn \* t. retries (fn : () -> t) : option t =
      :~ ^ 루프 retry =
          try
              \ () =>
                  ? retry < retries
                  ?> fn () |> Some
                  |: None
              \ ex =>
                  trace Warning
                      \ () => "common.retry_fn"
                      \ () => { retry ex }
                  None
          |> \|
              | Some x => x
              | None => 루프 (retry + 1)
      루프 0
  """,
  timeout: 300_000
)
```

