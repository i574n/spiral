<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":":= lua_math_random (low : i32) (high : i32) : i32 = $'math.random(!low, !high)' : i32\n\n:= native_rng_state () : () =\n    global \"static SPIRAL_NATIVE_RNG: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(0);\"\n\n:= native_rng_load () : u64 =\n    native_rng_state ()\n    $'SPIRAL_NATIVE_RNG.load(std::sync::atomic::Ordering::Relaxed)' : u64\n\n:= native_rng_store (x : u64) : () = $'SPIRAL_NATIVE_RNG.store(!x, std::sync::atomic::Ordering::Relaxed)' : ()\n\n:= xorshift (x : u64) : u64 =\n    := x = x ^^^ (x <<< 13i32)\n    := x = x ^^^ (x >>> 7i32)\n    x ^^^ (x <<< 17i32)\n\n:= native_rng_seed () : u64 =\n    := a, _ = guid::rust_random_pair ()\n    a ||| 1u64\n\n:= native_rng_next () : u64 =\n    := current = native_rng_load ()\n    := next = xorshift (? current = 0u64 ?> native_rng_seed () |: current)\n    native_rng_store next\n    next\n\n:= random_in_span (x : u64) (lo : i64) (hi : i64) : i64 =\n    := span = hi - lo\n    ? span <= 0i64 ?> lo |: lo + convert::i64 (x % convert::u64 span)\n\n:= typescript_random_u53 () : u64 = $'BigInt(Math.floor(Math.random() * 9007199254740992))' : u64\n\n:= native_random_between (lo : i64) (hi : i64) : i64 = random_in_span (native_rng_next ()) lo hi\n\n:= process_counter_add (name : string) (n : u64) : u64 =\n    run_target \\|\n        | Rust => \\ () =>\n            global \"\"\"\n                fn spiral_process_counter_add(name: &str, n: u64) -> u64 {\n                    use std::collections::HashMap;\n                    use std::sync::Mutex;\n                    static COUNTERS: Mutex<Option<HashMap<String, u64>>> = Mutex::new(None);\n                    let mut guard = COUNTERS.lock().unwrap();\n                    let total = guard.get_or_insert_with(HashMap::new).entry(name.to_string()).or_insert(0);\n                    *total += n;\n                    *total\n                }\n                \"\"\"\n            $'spiral_process_counter_add(&*!name, !n)' : u64\n        | _ => \\ () => failwith \"process_counter_add: Rust only; on the BEAM use an otp_actor counter\"\n\n:= process_counter_value (name : string) : u64 = process_counter_add name 0u64","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ":= lua_math_random (low : i32) (high : i32) : i32 = $'math.random(!low, !high)' : i32\n\n:= native_rng_state () : () =\n    global \"static SPIRAL_NATIVE_RNG: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(0);\"\n\n:= native_rng_load () : u64 =\n    native_rng_state ()\n    $'SPIRAL_NATIVE_RNG.load(std::sync::atomic::Ordering::Relaxed)' : u64\n\n:= native_rng_store (x : u64) : () = $'SPIRAL_NATIVE_RNG.store(!x, std::sync::atomic::Ordering::Relaxed)' : ()\n\n:= xorshift (x : u64) : u64 =\n    := x = x ^^^ (x <<< 13i32)\n    := x = x ^^^ (x >>> 7i32)\n    x ^^^ (x <<< 17i32)\n\n:= native_rng_seed () : u64 =\n    := a, _ = guid::rust_random_pair ()\n    a ||| 1u64\n\n:= native_rng_next () : u64 =\n    := current = native_rng_load ()\n    := next = xorshift (? current = 0u64 ?> native_rng_seed () |: current)\n    native_rng_store next\n    next\n\n:= random_in_span (x : u64) (lo : i64) (hi : i64) : i64 =\n    := span = hi - lo\n    ? span <= 0i64 ?> lo |: lo + convert::i64 (x % convert::u64 span)\n\n:= typescript_random_u53 () : u64 = $'BigInt(Math.floor(Math.random() * 9007199254740992))' : u64\n\n:= native_random_between (lo : i64) (hi : i64) : i64 = random_in_span (native_rng_next ()) lo hi\n\n:= process_counter_add (name : string) (n : u64) : u64 =\n    run_target \\|\n        | Rust => \\ () =>\n            global \"\"\"\n                fn spiral_process_counter_add(name: &str, n: u64) -> u64 {\n                    use std::collections::HashMap;\n                    use std::sync::Mutex;\n                    static COUNTERS: Mutex<Option<HashMap<String, u64>>> = Mutex::new(None);\n                    let mut guard = COUNTERS.lock().unwrap();\n                    let total = guard.get_or_insert_with(HashMap::new).entry(name.to_string()).or_insert(0);\n                    *total += n;\n                    *total\n                }\n                \"\"\"\n            $'spiral_process_counter_add(&*!name, !n)' : u64\n        | _ => \\ () => failwith \"process_counter_add: Rust only; on the BEAM use an otp_actor counter\"\n\n:= process_counter_value (name : string) : u64 = process_counter_add name 0u64",
  timeout: 300_000
)
```

#### process_counters_add_up_per_name (test)

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":"///- --test --symbol\n///> rust\n\n:= ~a, b = \"spiral-counter-test-a\", \"spiral-counter-test-b\"\nprocess_counter_add a 2u64 |> ignore\nprocess_counter_add a 3u64 |> ignore\nprocess_counter_add b 1u64 |> ignore\n(process_counter_value a, process_counter_value b, process_counter_value \"spiral-counter-test-none\")\n|> _assert_eq (5u64, 1u64, 0u64)","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  ///- --test --symbol
  ///> rust

  := ~a, b = "spiral-counter-test-a", "spiral-counter-test-b"
  process_counter_add a 2u64 |> ignore
  process_counter_add a 3u64 |> ignore
  process_counter_add b 1u64 |> ignore
  (process_counter_value a, process_counter_value b, process_counter_value "spiral-counter-test-none")
  |> _assert_eq (5u64, 1u64, 0u64)
  """,
  timeout: 300_000
)
```

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":":= random' \\* t. (min : t) (max : t) : t =\n    run_target \\|\n        | Zig => \\ () => random_in_span (guid::zig_random_u64 ()) (convert::i64 min) (convert::i64 max) |> convert::numeric_conv\n        | Rust => \\ () => native_random_between (convert::i64 min) (convert::i64 max) |> convert::convert\n        | Cuda _ => \\ () =>\n            global \"import random\"\n            $'random.randrange(!min, !max)' : t\n        | TypeScript => \\ () => random_in_span (typescript_random_u53 ()) (convert::i64 min) (convert::i64 max) |> convert::numeric_conv\n        | Lua => \\ () =>\n            := low, high = convert::i32 min, convert::i32 max - 1i32\n            convert::convert (? high < low ?> low |: lua_math_random low high)\n        | _ => \\ () =>\n            random () |> random_next (convert::i32 min) (convert::i32 max) |> convert::convert","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  := random' \* t. (min : t) (max : t) : t =
      run_target \|
          | Zig => \ () => random_in_span (guid::zig_random_u64 ()) (convert::i64 min) (convert::i64 max) |> convert::numeric_conv
          | Rust => \ () => native_random_between (convert::i64 min) (convert::i64 max) |> convert::convert
          | Cuda _ => \ () =>
              global "import random"
              $'random.randrange(!min, !max)' : t
          | TypeScript => \ () => random_in_span (typescript_random_u53 ()) (convert::i64 min) (convert::i64 max) |> convert::numeric_conv
          | Lua => \ () =>
              := low, high = convert::i32 min, convert::i32 max - 1i32
              convert::convert (? high < low ?> low |: lua_math_random low high)
          | _ => \ () =>
              random () |> random_next (convert::i32 min) (convert::i32 max) |> convert::convert
  """,
  timeout: 300_000
)
```

#### random_draws_stay_in_their_half_open_range (test)

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":"///- --test --symbol\n///> lua\n///> rust\n\n:~ ^ outside (draws : i32) : i32 =\n    ? draws = 0i32 ?> 0i32\n    |:\n        := x = random' 3i32 7i32\n        (? x < 3i32 || x >= 7i32 ?> 1i32 |: 0i32) + outside (draws - 1i32)\n(outside 200i32, random' 5i32 5i32, random' 5i32 6i32) |> _assert_eq (0i32, 5i32, 5i32)","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  ///- --test --symbol
  ///> lua
  ///> rust

  :~ ^ outside (draws : i32) : i32 =
      ? draws = 0i32 ?> 0i32
      |:
          := x = random' 3i32 7i32
          (? x < 3i32 || x >= 7i32 ?> 1i32 |: 0i32) + outside (draws - 1i32)
  (outside 200i32, random' 5i32 5i32, random' 5i32 6i32) |> _assert_eq (0i32, 5i32, 5i32)
  """,
  timeout: 300_000
)
```

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":":= new_disposable (fn : () -> ()) : disposable _ =\n    run_target \\|\n        | Rust => \\ () =>\n            :< rust_operators\n            !\\\\(fn, $'\"$0.clone()\"') : disposable _\n        | TypeScript => \\ () =>\n            := fn = ~~ fn\n            $'!fn ' : disposable _\n        | Fsharp _ => \\ () =>\n            := fn = ~~ fn\n            $'{ new System.IDisposable with member _.Dispose () = !fn () }'\n        | Cuda _ => \\ () =>\n            $'class Disposable:'\n            $'    def __init__(self, fn):'\n            $'        self.fn = fn'\n            $'    def __exit__(self, exc_type, exc_value, traceback):'\n            $'        self.fn()'\n            $'        return False'\n            $'Disposable(!fn)'\n        | _ => \\ () => null ()","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  := new_disposable (fn : () -> ()) : disposable _ =
      run_target \|
          | Rust => \ () =>
              :< rust_operators
              !\\(fn, $'"$0.clone()"') : disposable _
          | TypeScript => \ () =>
              := fn = ~~ fn
              $'!fn ' : disposable _
          | Fsharp _ => \ () =>
              := fn = ~~ fn
              $'{ new System.IDisposable with member _.Dispose () = !fn () }'
          | Cuda _ => \ () =>
              $'class Disposable:'
              $'    def __init__(self, fn):'
              $'        self.fn = fn'
              $'    def __exit__(self, exc_type, exc_value, traceback):'
              $'        self.fn()'
              $'        return False'
              $'Disposable(!fn)'
          | _ => \ () => null ()
  """,
  timeout: 300_000
)
```

#### new_disposable (test)

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":"///- --test --symbol\n///> cuda\n///> rust\n///> typescript\n\n:= new_disposable_test = mut 0i32\nnew_disposable \\ () => new_disposable_test <- *new_disposable_test + 1\n|> \\ x => x : disposable ()\n|> dispose\n*new_disposable_test |> _assert_eq 1","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
