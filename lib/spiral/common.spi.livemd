<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":"///> fsharp\n\n:= main () =\n    init_trace_state None\n    := new_disposable x : _ () = new_disposable x\n    $'let new_disposable x = !new_disposable x' : ()\n    := retry_fn (r : i32) (x : () -> _) : optionm'::option' () = retry_fn r x |> optionm'::box\n    $'let retry_fn x = !retry_fn x' : ()\n    := memoize (fn : () -> ()) : () -> () = memoize fn\n    $'let memoize x = !memoize x' : ()","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  ///> fsharp

  := main () =
      init_trace_state None
      := new_disposable x : _ () = new_disposable x
      $'let new_disposable x = !new_disposable x' : ()
      := retry_fn (r : i32) (x : () -> _) : optionm'::option' () = retry_fn r x |> optionm'::box
      $'let retry_fn x = !retry_fn x' : ()
      := memoize (fn : () -> ()) : () -> () = memoize fn
      $'let memoize x = !memoize x' : ()
  """,
  timeout: 300_000
)
```
