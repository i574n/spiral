```elixir
Spiral.Cells.eval!(
  ~S"""
  ///- --test --symbol
  ///> rust
  ///> typescript
  ///> cuda

  := retry_fn_test = mut 0i32
  \ () =>
      ? *retry_fn_test >= 2
      ?> *retry_fn_test
      |:
          retry_fn_test <- *retry_fn_test + 1
          failwith "test"
  |> retry_fn 3i32
  |> _assert_eq' (Some 2i32)
