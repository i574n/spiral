<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":":= write_ln l : () =\n    write l\n    backend_switch {\n        Gleam = \\ () => write_line () : ()\n        Lua = \\ () => write_line () : ()\n        Fsharp = \\ () => write_line () : ()\n        Python = \\ () => $\"print()\" : ()\n        Cuda = \\ () => $'printf(\"\\\\n\")' : ()\n        Rust = \\ () => $'println\\!()' : ()\n        Zig = \\ () => $'spiralPrint(&[_]u8{10})' : ()\n        Lean = \\ () => $'IO.println \"\"' : ()\n    }\n\n:= color_reset () =\n    run_target \\|\n        | Zig => \\ () =>\n            $'\"\\\\u{001b}[0m\"' : string\n        | Gleam _ => \\ () => $'\"\\\\u{001b}[0m\"'\n        | Lua _ => \\ () => $'\"\"'\n        | Rust => \\ () => $'Rc::<str>::from(\"\\\\u{001b}[0m\")' : string\n        | _ => \\ () => $'\"\\\\u001b[0m\"'\n\n:= color_bright_black () =\n    run_target \\|\n        | Zig => \\ () =>\n            $'\"\\\\u{001b}[90m\"' : string\n        | Gleam _ => \\ () => $'\"\\\\u{001b}[90m\"'\n        | Lua _ => \\ () => $'\"\"'\n        | Rust => \\ () => $'Rc::<str>::from(\"\\\\u{001b}[90m\")' : string\n        | _ => \\ () => $'\"\\\\u001b[90m\"'\n\n:= color_bright_red () =\n    run_target \\|\n        | Zig => \\ () =>\n            $'\"\\\\u{001b}[91m\"' : string\n        | Gleam _ => \\ () => $'\"\\\\u{001b}[91m\"'\n        | Lua _ => \\ () => $'\"\"'\n        | Rust => \\ () => $'Rc::<str>::from(\"\\\\u{001b}[91m\")' : string\n        | _ => \\ () => $'\"\\\\u001b[91m\"'\n\n:= color_bright_green () =\n    run_target \\|\n        | Zig => \\ () =>\n            $'\"\\\\u{001b}[92m\"' : string\n        | Gleam _ => \\ () => $'\"\\\\u{001b}[92m\"'\n        | Lua _ => \\ () => $'\"\"'\n        | Rust => \\ () => $'Rc::<str>::from(\"\\\\u{001b}[92m\")' : string\n        | _ => \\ () => $'\"\\\\u001b[92m\"'\n\n:= color_yellow () =\n    run_target \\|\n        | Zig => \\ () =>\n            $'\"\\\\u{001b}[93m\"' : string\n        | Gleam _ => \\ () => $'\"\\\\u{001b}[93m\"'\n        | Lua _ => \\ () => $'\"\"'\n        | Rust => \\ () => $'Rc::<str>::from(\"\\\\u{001b}[93m\")' : string\n        | _ => \\ () => $'\"\\\\u001b[93m\"'\n\n:= color_bright_blue () =\n    run_target \\|\n        | Zig => \\ () =>\n            $'\"\\\\u{001b}[94m\"' : string\n        | Gleam _ => \\ () => $'\"\\\\u{001b}[94m\"'\n        | Lua _ => \\ () => $'\"\"'\n        | Rust => \\ () => $'Rc::<str>::from(\"\\\\u{001b}[94m\")' : string\n        | _ => \\ () => $'\"\\\\u001b[94m\"'\n\n:= color_bright_magenta () =\n    run_target \\|\n        | Zig => \\ () =>\n            $'\"\\\\u{001b}[95m\"' : string\n        | Gleam _ => \\ () => $'\"\\\\u{001b}[95m\"'\n        | Lua _ => \\ () => $'\"\"'\n        | Rust => \\ () => $'Rc::<str>::from(\"\\\\u{001b}[95m\")' : string\n        | _ => \\ () => $'\"\\\\u001b[95m\"'\n\n:= color_bright_cyan () =\n    run_target \\|\n        | Zig => \\ () =>\n            $'\"\\\\u{001b}[96m\"' : string\n        | Gleam _ => \\ () => $'\"\\\\u{001b}[96m\"'\n        | Lua _ => \\ () => $'\"\"'\n        | Rust => \\ () => $'Rc::<str>::from(\"\\\\u{001b}[96m\")' : string\n        | _ => \\ () => $'\"\\\\u001b[96m\"'\n\n:= color_bright_white () =\n    run_target \\|\n        | Zig => \\ () =>\n            $'\"\\\\u{001b}[97m\"' : string\n        | Gleam _ => \\ () => $'\"\\\\u{001b}[97m\"'\n        | Lua _ => \\ () => $'\"\"'\n        | Rust => \\ () => $'Rc::<str>::from(\"\\\\u{001b}[97m\")' : string\n        | _ => \\ () => $'\"\\\\u001b[97m\"'","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  := write_ln l : () =
      write l
      backend_switch {
          Gleam = \ () => write_line () : ()
          Lua = \ () => write_line () : ()
          Fsharp = \ () => write_line () : ()
          Python = \ () => $"print()" : ()
          Cuda = \ () => $'printf("\\n")' : ()
          Rust = \ () => $'println\!()' : ()
          Zig = \ () => $'spiralPrint(&[_]u8{10})' : ()
          Lean = \ () => $'IO.println ""' : ()
      }

  := color_reset () =
      run_target \|
          | Zig => \ () =>
              $'"\\u{001b}[0m"' : string
          | Gleam _ => \ () => $'"\\u{001b}[0m"'
          | Lua _ => \ () => $'""'
          | Rust => \ () => $'Rc::<str>::from("\\u{001b}[0m")' : string
          | _ => \ () => $'"\\u001b[0m"'

  := color_bright_black () =
      run_target \|
          | Zig => \ () =>
              $'"\\u{001b}[90m"' : string
          | Gleam _ => \ () => $'"\\u{001b}[90m"'
          | Lua _ => \ () => $'""'
          | Rust => \ () => $'Rc::<str>::from("\\u{001b}[90m")' : string
          | _ => \ () => $'"\\u001b[90m"'

  := color_bright_red () =
      run_target \|
          | Zig => \ () =>
              $'"\\u{001b}[91m"' : string
          | Gleam _ => \ () => $'"\\u{001b}[91m"'
          | Lua _ => \ () => $'""'
          | Rust => \ () => $'Rc::<str>::from("\\u{001b}[91m")' : string
          | _ => \ () => $'"\\u001b[91m"'

  := color_bright_green () =
      run_target \|
          | Zig => \ () =>
              $'"\\u{001b}[92m"' : string
          | Gleam _ => \ () => $'"\\u{001b}[92m"'
          | Lua _ => \ () => $'""'
          | Rust => \ () => $'Rc::<str>::from("\\u{001b}[92m")' : string
          | _ => \ () => $'"\\u001b[92m"'

  := color_yellow () =
      run_target \|
          | Zig => \ () =>
              $'"\\u{001b}[93m"' : string
          | Gleam _ => \ () => $'"\\u{001b}[93m"'
          | Lua _ => \ () => $'""'
          | Rust => \ () => $'Rc::<str>::from("\\u{001b}[93m")' : string
          | _ => \ () => $'"\\u001b[93m"'

  := color_bright_blue () =
      run_target \|
          | Zig => \ () =>
              $'"\\u{001b}[94m"' : string
          | Gleam _ => \ () => $'"\\u{001b}[94m"'
          | Lua _ => \ () => $'""'
