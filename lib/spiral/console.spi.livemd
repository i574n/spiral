```elixir
Spiral.Cells.eval!(
  ~S"""
  := write_c \* t. (x : t) : () =
      ~>
          ?: t ?|
          | string => $'printf("%s", (!x)->ptr)' : ()
          | i32 => $'printf("%d", !x)' : ()
          | i64 => $'printf("%lld", (long long)(!x))' : ()
          | u32 => $'printf("%u", !x)' : ()
          | u64 => $'printf("%llu", (unsigned long long)(!x))' : ()
          | _ => $'backend_switch_has_no_C_arm_in_lib_spiral' : ()

  := write_gleam \* t. (x : t) : () =
      global "import gleam/io"
      ? (~> ?: t ?| string => !+ | _ => !-) ?> $'io.print(!x)' : ()
      |:
          global "import gleam/int"
          $'io.print(int.to_string(!x))' : ()

  := write_lua \* t. (x : t) : () =
      ~>
          ?: t ?|
          | i64 => $'io.write(spiral_w64.tostring(!x, true))' : ()
          | u64 => $'io.write(spiral_w64.tostring(!x, false))' : ()
          | _ => $'io.write(!x)' : ()

  := write \* t. (x : t) : () =
      backend_switch {
          Gleam = \ () => write_gleam x
          Lua = \ () => write_lua x
          Fsharp = \ () => $'!x |> System.Console.Write' : ()
          Python = \ () => $'print(!x, end="")' : ()
          Rust = \ () =>
              $'print\!("{}", !x)' : ()
              $'std::io::Write::flush(&mut std::io::stdout()).unwrap()' : ()
          TypeScript = \ () => $'process.stdout.write(String(!x))' : ()
          Zig = \ () => $'spiralPrintAny(!x)' : ()
          Lean = \ () => $'IO.print (toString !x)' : ()
          C = \ () => write_c x
          Pascal = \ () => $'Write(!x)' : ()
          Kotlin = \ () =>
              $'run { System.out.write(!x.toString().toByteArray(Charsets.UTF_8)); System.out.flush() }' : ()
          Swift = \ () => $'print(!x, terminator: "")' : ()
          Wasm = \ () => write_wasm x
      }
  """,
  timeout: 300_000
)
```

