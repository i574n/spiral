### to'

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"inl to' forall t u. (fn : t -> option u) (x : t) : option u =\n    real\n        typecase t * u with\n        | ~x * ~x => Some `u x\n        | int * int => Some `u (conv `t `u x)\n        | float * float => Some `u (conv `t `u x)\n        | int * float => Some `u (conv `t `u x)\n        | float * int => Some `u (conv `t `u x)\n        | i64 * f64 => Some `u (conv `t `u x)\n        | f64 * i64 => Some `u (conv `t `u x)\n        | i32 * f64 => Some `u (conv `t `u x)\n        | f64 * i32 => Some `u (conv `t `u x)\n        | i64 * f32 => Some `u (conv `t `u x)\n        | f32 * i64 => Some `u (conv `t `u x)\n        | char * bool => Some `u (x = '1')\n        | bool * char => Some `u (if x then '1' else '0')\n        | bool * _ => Some `u (if x then 1 else 0)\n        | _ => fn x","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  inl to' forall t u. (fn : t -> option u) (x : t) : option u =
      real
          typecase t * u with
          | ~x * ~x => Some `u x
          | int * int => Some `u (conv `t `u x)
          | float * float => Some `u (conv `t `u x)
          | int * float => Some `u (conv `t `u x)
          | float * int => Some `u (conv `t `u x)
          | i64 * f64 => Some `u (conv `t `u x)
          | f64 * i64 => Some `u (conv `t `u x)
          | i32 * f64 => Some `u (conv `t `u x)
          | f64 * i32 => Some `u (conv `t `u x)
          | i64 * f32 => Some `u (conv `t `u x)
          | f32 * i64 => Some `u (conv `t `u x)
          | char * bool => Some `u (x = '1')
          | bool * char => Some `u (if x then '1' else '0')
          | bool * _ => Some `u (if x then 1 else 0)
          | _ => fn x
  """,
  timeout: 300_000
)
```

### to

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"inl to forall t u. (x : t) : u =\n    if is_rust ()\n    then\n        inl from_string : bool =\n            real\n                typecase t with\n                | string => true\n                | _ => false\n        x\n        |> to' fun x =>\n            inl y : u =\n                if from_string\n                then $'(!x).parse::<`u>().unwrap()'\n                else $'(!x as `u)'\n            Some y\n        |> optionm.value\n    else\n        x\n        |> to' fun x => $'!x ' |> Some\n        |> optionm.value\n\ninl numeric_conv forall t u. (x : t) : u =\n    if (real typecase t with i8 => true | i16 => true | i32 => true | i64 => true | u8 => true | u16 => true | u32 => true | u64 => true | f32 => true | f64 => true | _ => false)\n    then real conv `t `u x\n    else $'!x ' : u","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  inl to forall t u. (x : t) : u =
      if is_rust ()
      then
          inl from_string : bool =
              real
                  typecase t with
                  | string => true
                  | _ => false
          x
          |> to' fun x =>
              inl y : u =
                  if from_string
                  then $'(!x).parse::<`u>().unwrap()'
                  else $'(!x as `u)'
              Some y
          |> optionm.value
      else
          x
          |> to' fun x => $'!x ' |> Some
          |> optionm.value

  inl numeric_conv forall t u. (x : t) : u =
      if (real typecase t with i8 => true | i16 => true | i32 => true | i64 => true | u8 => true | u16 => true | u32 => true | u64 => true | f32 => true | f64 => true | _ => false)
      then real conv `t `u x
      else $'!x ' : u
  """,
  timeout: 300_000
)
```

### convert_i32_base

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"inl convert_i32_base forall t. (base : i32) (x : t) : i32 =\n    backend_switch {\n        Gleam = fun () =>\n            global \"import gleam/int\"\n            inl (n : int), (err : int) =\n                $'case int.base_parse(!x, !base) { Ok(n) -> ##(n, 0) Error(Nil) -> ##(0, 1) }'\n            if err = 0\n            then n |> Some\n            else None\n            |> optionm.value\n        Lua = fun () => $'tonumber( !x, !base )' : i32\n        Fsharp = fun () => $'System.Convert.ToInt32 (!x, !base)' : i32\n        Python = fun () => $'int (!x, !base)' : i32\n        Rust = fun () => $'i32::from_str_radix(&*(!x), (!base) as u32).unwrap()' : i32\n        TypeScript = fun () => $'parseInt(!x, !base)' : i32\n        C = fun () => $'(int32_t)strtol((!x)->ptr, NULL, !base)' : i32\n        Delphi = fun () =>\n            if base = 16 then $'StrToInt(##36 + !x)' : i32\n            elif base = 2 then $'StrToInt(##37 + !x)' : i32\n            elif base = 8 then $'StrToInt(##38 + !x)' : i32\n            elif base = 10 then $'StrToInt(!x)' : i32\n            else $'backend_switch_has_no_Delphi_arm_in_lib_spiral' : i32\n        Wasm = fun () => $'(i32.wrap_i64 (call $parse_i64 !x !base))' : i32\n    }","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  inl convert_i32_base forall t. (base : i32) (x : t) : i32 =
      backend_switch {
          Gleam = fun () =>
              global "import gleam/int"
              inl (n : int), (err : int) =
                  $'case int.base_parse(!x, !base) { Ok(n) -> ##(n, 0) Error(Nil) -> ##(0, 1) }'
              if err = 0
              then n |> Some
              else None
              |> optionm.value
          Lua = fun () => $'tonumber( !x, !base )' : i32
          Fsharp = fun () => $'System.Convert.ToInt32 (!x, !base)' : i32
          Python = fun () => $'int (!x, !base)' : i32
          Rust = fun () => $'i32::from_str_radix(&*(!x), (!base) as u32).unwrap()' : i32
          TypeScript = fun () => $'parseInt(!x, !base)' : i32
          C = fun () => $'(int32_t)strtol((!x)->ptr, NULL, !base)' : i32
          Delphi = fun () =>
              if base = 16 then $'StrToInt(##36 + !x)' : i32
              elif base = 2 then $'StrToInt(##37 + !x)' : i32
              elif base = 8 then $'StrToInt(##38 + !x)' : i32
              elif base = 10 then $'StrToInt(!x)' : i32
              else $'backend_switch_has_no_Delphi_arm_in_lib_spiral' : i32
          Wasm = fun () => $'(i32.wrap_i64 (call $parse_i64 !x !base))' : i32
      }
  """,
  timeout: 300_000
)
```

### convert_i32

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"inl is_string_type forall t. (_ : t) : bool = real typecase t with string => true | _ => false\ninl is_float_type forall t. (_ : t) : bool = real typecase t with f64 => true | f32 => true | _ => false\n\ninl convert_i32 forall t. (x : t) : int =\n    backend_switch {\n        Gleam = fun () => x |> convert_i32_base 10 : int\n        Lua = fun () => x |> convert_i32_base 10 : int\n        Fsharp = fun () => $'System.Convert.ToInt32(!x)' : int\n        Python = fun () => x |> convert_i32_base 10 : int\n        Rust = fun () =>\n            if (real typecase t with string => true | _ => false)\n            then x |> convert_i32_base 10 : int\n            elif (real typecase t with f64 => true | f32 => true | _ => false)\n            then $'((!x).round_ties_even() as i32)' : int\n            else $'(!x as i32)' : int\n        C = fun () =>\n            if is_string_type x\n            then x |> convert_i32_base 10 : int\n            elif is_float_type x\n            then\n                global \"#include <math.h>\"\n                $'(int32_t)nearbyint(!x)' : int\n            else $'(int32_t)(!x)' : int\n        Delphi = fun () =>\n            if is_string_type x\n            then x |> convert_i32_base 10 : int\n            elif is_float_type x\n            then $'Round(!x)' : int\n            else $'Int32(!x)' : int\n        TypeScript = fun () =>\n            if is_string_type x\n            then x |> convert_i32_base 10 : int\n            elif is_float_type x\n            then $'backend_switch_has_no_TypeScript_float_rounding_in_lib_spiral' : int\n            else $'Number(!x)' : int\n        Wasm = fun () =>\n            if is_string_type x\n            then x |> convert_i32_base 10 : int\n            elif is_float_type x\n            then $'(i32.trunc_sat_f64_s (f64.nearest !x))' : int\n            else x |> numeric_conv : int\n    }","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  inl is_string_type forall t. (_ : t) : bool = real typecase t with string => true | _ => false
  inl is_float_type forall t. (_ : t) : bool = real typecase t with f64 => true | f32 => true | _ => false

  inl convert_i32 forall t. (x : t) : int =
      backend_switch {
          Gleam = fun () => x |> convert_i32_base 10 : int
          Lua = fun () => x |> convert_i32_base 10 : int
          Fsharp = fun () => $'System.Convert.ToInt32(!x)' : int
          Python = fun () => x |> convert_i32_base 10 : int
          Rust = fun () =>
              if (real typecase t with string => true | _ => false)
              then x |> convert_i32_base 10 : int
              elif (real typecase t with f64 => true | f32 => true | _ => false)
              then $'((!x).round_ties_even() as i32)' : int
              else $'(!x as i32)' : int
          C = fun () =>
              if is_string_type x
              then x |> convert_i32_base 10 : int
              elif is_float_type x
              then
                  global "#include <math.h>"
                  $'(int32_t)nearbyint(!x)' : int
              else $'(int32_t)(!x)' : int
          Delphi = fun () =>
              if is_string_type x
              then x |> convert_i32_base 10 : int
              elif is_float_type x
              then $'Round(!x)' : int
              else $'Int32(!x)' : int
          TypeScript = fun () =>
              if is_string_type x
              then x |> convert_i32_base 10 : int
              elif is_float_type x
              then $'backend_switch_has_no_TypeScript_float_rounding_in_lib_spiral' : int
              else $'Number(!x)' : int
          Wasm = fun () =>
              if is_string_type x
              then x |> convert_i32_base 10 : int
              elif is_float_type x
              then $'(i32.trunc_sat_f64_s (f64.nearest !x))' : int
              else x |> numeric_conv : int
      }
  """,
  timeout: 300_000
)
```

### try_convert

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"inl integer_fits forall u. (_ : u) (value : i64) : bool =\n    inl bounded : bool = real typecase u with i64 => false | u64 => false | _ => true\n    inl lowest : i64 = real typecase u with i8 => -128i64 | i16 => -32768i64 | i32 => -2147483648i64 | _ => 0i64\n    inl highest : i64 = real typecase u with i8 => 127i64 | i16 => 32767i64 | i32 => 2147483647i64 | u8 => 255i64 | u16 => 65535i64 | u32 => 4294967295i64 | _ => 0i64\n    not bounded || (value >= lowest && value <= highest)\n\ninl parsed_integer forall u. (ok : bool) (value : i64) : option u =\n    inl integral : bool = real typecase u with i8 => true | i16 => true | i32 => true | i64 => true | u8 => true | u16 => true | u32 => true | u64 => true | _ => false\n    if integral then\n        inl converted : u = real conv `i64 `u value\n        if ok && integer_fits converted value then Some converted else None\n    else None\n\ninl try_convert forall t u. (x : t) : option u =\n    x |> to' fun x =>\n        backend_switch {\n            Gleam = fun () =>\n                if (real typecase u with int => true | _ => false) then\n                    global \"import gleam/int\"\n                    global \"import gleam/string\"\n                    inl (n : int), (err : int) =\n                        $'case int.parse(string.trim(!x)) { Ok(n) -> ##(n, 0) Error(Nil) -> ##(0, 1) }'\n                    if err = 0\n                    then n |> to |> Some\n                    else None : _ u\n                else x |> to |> Some\n            Lua = fun () =>\n                if is_string_type x\n                then parsed_integer ($'(string.match(!x, \"^%s*[+-]?%d+%s*$\") ~= nil)' : bool) ($'(tonumber(!x) or 0)' : i64)\n                else x |> to |> Some : _ u\n            Fsharp = fun () =>\n                resultm.from_try\n                    fun () => $'!x |> `u '\n                    eval\n                |> resultm.ok\n                : _ u\n            Python = fun () =>\n                resultm.from_try\n                    fun () => $'`u(!x)'\n                    eval\n                |> resultm.ok\n                : _ u\n            Rust = fun () =>\n                if (real typecase u with string => true | _ => false)\n                then Some $'Rc::<str>::from(format\\!(\"{}\", !x))'\n                elif (real typecase t with string => true | _ => false)\n                then\n                    ($'(!x).trim().parse::<`u>().ok()' : optionm'.option' u) |> optionm'.unbox\n                else Some $'((!x) as `u)'\n            C = fun () =>\n                if is_string_type x\n                then\n                    global \"#include <stdbool.h>\"\n                    global \"#include <stdlib.h>\"\n                    global \"#include <ctype.h>\"\n                    global \"#include <errno.h>\"\n                    global \"static bool spiral_integer_text_ok(const char *s) { char *end; while (isspace((unsigned char)*s)) s++; if (!*s) return false; errno = 0; strtoll(s, &end, 10); if (errno != 0 || end == s) return false; while (isspace((unsigned char)*end)) end++; return *end == 0; }\"\n                    parsed_integer ($'spiral_integer_text_ok((!x)->ptr)' : bool) ($'strtoll((!x)->ptr, NULL, 10)' : i64)\n                else x |> to |> Some : _ u\n            Delphi = fun () =>\n                if is_string_type x\n                then parsed_integer ($'(StrToInt64Def(Trim(!x), 0) = StrToInt64Def(Trim(!x), 1))' : bool) ($'StrToInt64Def(Trim(!x), 0)' : i64)\n                else x |> to |> Some : _ u\n            TypeScript = fun () =>\n                if is_string_type x\n                then\n                    inl ok : bool = $'/^\\\\s*[+-]?\\\\d+\\\\s*$/.test(!x)'\n                    parsed_integer ok ($'(!ok ? BigInt(!x) : 0n)' : i64)\n                else x |> to |> Some : _ u\n            Wasm = fun () =>\n                if is_string_type x\n                then parsed_integer ($'(call $integer_text_ok !x)' : bool) ($'(call $parse_i64 !x (i32.const 10))' : i64)\n                else x |> to |> Some : _ u\n        }","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  inl integer_fits forall u. (_ : u) (value : i64) : bool =
      inl bounded : bool = real typecase u with i64 => false | u64 => false | _ => true
      inl lowest : i64 = real typecase u with i8 => -128i64 | i16 => -32768i64 | i32 => -2147483648i64 | _ => 0i64
      inl highest : i64 = real typecase u with i8 => 127i64 | i16 => 32767i64 | i32 => 2147483647i64 | u8 => 255i64 | u16 => 65535i64 | u32 => 4294967295i64 | _ => 0i64
      not bounded || (value >= lowest && value <= highest)

  inl parsed_integer forall u. (ok : bool) (value : i64) : option u =
      inl integral : bool = real typecase u with i8 => true | i16 => true | i32 => true | i64 => true | u8 => true | u16 => true | u32 => true | u64 => true | _ => false
      if integral then
          inl converted : u = real conv `i64 `u value
          if ok && integer_fits converted value then Some converted else None
      else None

  inl try_convert forall t u. (x : t) : option u =
      x |> to' fun x =>
          backend_switch {
              Gleam = fun () =>
                  if (real typecase u with int => true | _ => false) then
                      global "import gleam/int"
                      global "import gleam/string"
                      inl (n : int), (err : int) =
                          $'case int.parse(string.trim(!x)) { Ok(n) -> ##(n, 0) Error(Nil) -> ##(0, 1) }'
                      if err = 0
                      then n |> to |> Some
                      else None : _ u
                  else x |> to |> Some
              Lua = fun () =>
                  if is_string_type x
                  then parsed_integer ($'(string.match(!x, "^%s*[+-]?%d+%s*$") ~= nil)' : bool) ($'(tonumber(!x) or 0)' : i64)
                  else x |> to |> Some : _ u
              Fsharp = fun () =>
                  resultm.from_try
                      fun () => $'!x |> `u '
                      eval
                  |> resultm.ok
                  : _ u
              Python = fun () =>
                  resultm.from_try
                      fun () => $'`u(!x)'
                      eval
                  |> resultm.ok
                  : _ u
              Rust = fun () =>
                  if (real typecase u with string => true | _ => false)
                  then Some $'Rc::<str>::from(format\!("{}", !x))'
                  elif (real typecase t with string => true | _ => false)
                  then
                      ($'(!x).trim().parse::<`u>().ok()' : optionm'.option' u) |> optionm'.unbox
                  else Some $'((!x) as `u)'
              C = fun () =>
                  if is_string_type x
                  then
                      global "#include <stdbool.h>"
                      global "#include <stdlib.h>"
                      global "#include <ctype.h>"
                      global "#include <errno.h>"
                      global "static bool spiral_integer_text_ok(const char *s) { char *end; while (isspace((unsigned char)*s)) s++; if (!*s) return false; errno = 0; strtoll(s, &end, 10); if (errno != 0 || end == s) return false; while (isspace((unsigned char)*end)) end++; return *end == 0; }"
                      parsed_integer ($'spiral_integer_text_ok((!x)->ptr)' : bool) ($'strtoll((!x)->ptr, NULL, 10)' : i64)
                  else x |> to |> Some : _ u
              Delphi = fun () =>
                  if is_string_type x
                  then parsed_integer ($'(StrToInt64Def(Trim(!x), 0) = StrToInt64Def(Trim(!x), 1))' : bool) ($'StrToInt64Def(Trim(!x), 0)' : i64)
                  else x |> to |> Some : _ u
              TypeScript = fun () =>
                  if is_string_type x
                  then
                      inl ok : bool = $'/^\\s*[+-]?\\d+\\s*$/.test(!x)'
                      parsed_integer ok ($'(!ok ? BigInt(!x) : 0n)' : i64)
                  else x |> to |> Some : _ u
              Wasm = fun () =>
                  if is_string_type x
                  then parsed_integer ($'(call $integer_text_ok !x)' : bool) ($'(call $parse_i64 !x (i32.const 10))' : i64)
                  else x |> to |> Some : _ u
          }
  """,
  timeout: 300_000
)
```

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"///- --test\n///> gleam\n///> lua\n///> fsharp\n///> rust\n\n3i32\n|> try_convert\n|> optionm.value\n|> _assert_eq' (\n    backend_switch {\n        Gleam = fun () => ($'3' : unativeint) : unativeint\n        Lua = fun () => ($'3' : unativeint) : unativeint\n        Fsharp = fun () => ($'3 |> `unativeint ' : unativeint) : unativeint\n        Python = fun () => ($'3' : unativeint) : unativeint\n        Rust = fun () => ($'3usize' : unativeint) : unativeint\n    } : unativeint\n)","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  ///- --test
  ///> gleam
  ///> lua
  ///> fsharp
  ///> rust

  3i32
  |> try_convert
  |> optionm.value
  |> _assert_eq' (
      backend_switch {
          Gleam = fun () => ($'3' : unativeint) : unativeint
          Lua = fun () => ($'3' : unativeint) : unativeint
          Fsharp = fun () => ($'3 |> `unativeint ' : unativeint) : unativeint
          Python = fun () => ($'3' : unativeint) : unativeint
          Rust = fun () => ($'3usize' : unativeint) : unativeint
      } : unativeint
  )
  """,
  timeout: 300_000
)
```

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"///- --test\n///> gleam\n///> fsharp\n///> rust\n///> cuda\n\n\"3\"\n|> try_convert\n|> _assert_eq (3i32 |> Some)\n\n\"a\"\n|> try_convert\n|> _assert_eq (None : _ int)\n\ntrue\n|> try_convert\n|> _assert_eq (1i32 |> Some)\n\nfalse\n|> try_convert\n|> _assert_eq (0i32 |> Some)","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  ///- --test
  ///> gleam
  ///> fsharp
  ///> rust
  ///> cuda

  "3"
  |> try_convert
  |> _assert_eq (3i32 |> Some)

  "a"
  |> try_convert
  |> _assert_eq (None : _ int)

  true
  |> try_convert
  |> _assert_eq (1i32 |> Some)

  false
  |> try_convert
  |> _assert_eq (0i32 |> Some)
  """,
  timeout: 300_000
)
```

