  type unativeint_switch =
      {
          Gleam : $'unativeint'
          Lua : $'unativeint'
          Fsharp : $'unativeint'
          Python : $'unativeint'
          TypeScript : $'unativeint'
          Cpp : $'unativeint'
          CppHost : $'unativeint'
          Delphi : $'unativeint'
          Cuda : $'unativeint'
