### (~:>) any

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":":+ (~:>) any = to_any\n\n:= f32_of_bits (bits : u32) : f32 =\n    run_target \\|\n        | Rust => \\ () => $'f32::from_bits(!bits)' : f32\n        | C => \\ () =>\n            global \"#include <stdint.h>\"\n            global \"#include <string.h>\"\n            global (\n                \"static float spiral_f32_of_bits(uint32_t u) { float f; memcpy(&f, &u, sizeof f); \"\n                ^^ \"return f; }\"\n            )\n            $'spiral_f32_of_bits(!bits)' : f32\n        | Wgsl => \\ () => $'bitcast<f32>(!bits)' : f32\n        | Zig => \\ () => $'@@as(f32, @@bitCast(!bits))' : f32\n        | _ => \\ () => failwith \"convert.f32_of_bits / no arm for this backend\"\n\n:= c_bits_of_f32 () : () =\n    global \"#include <stdint.h>\"\n    global \"#include <string.h>\"\n    global \"static uint32_t spiral_bits_of_f32(float f) { uint32_t u; memcpy(&u, &f, sizeof u); return u; }\"\n\n:= bits_of_f32 (x : f32) : u32 =\n    run_target \\|\n        | Rust => \\ () => $'(!x).to_bits()' : u32\n        | C => \\ () =>\n            c_bits_of_f32 ()\n            $'spiral_bits_of_f32(!x)' : u32\n        | Wgsl => \\ () => $'bitcast<u32>(!x)' : u32\n        | Zig => \\ () => $'@@as(u32, @@bitCast(!x))' : u32\n        | _ => \\ () => failwith \"convert.bits_of_f32 / no arm for this backend\"\n\n:= parse_f64 (text : string) : option f64 =\n    := value, parsed =\n        run_target \\|\n            | Rust => \\ () => $'match (!text).trim().parse::<f64>() { Ok(f) => (f, true), Err(_) => (0.0, false) }' : f64 * bool\n            | Gleam => \\ () =>\n                global \"import gleam/float\"\n                global \"import gleam/int\"\n                $'case float.parse(!text) { Ok(f) -> ##(f, True) Error(_) -> case int.parse(!text) { Ok(i) -> ##(int.to_float(i), True) Error(_) -> ##(0.0, False) } }' : f64 * bool\n            | _ => \\ () => failwith \"convert.parse_f64 / no arm for this backend\"\n    ? parsed ?> Some value |: None","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  :+ (~:>) any = to_any

  := f32_of_bits (bits : u32) : f32 =
      run_target \|
          | Rust => \ () => $'f32::from_bits(!bits)' : f32
          | C => \ () =>
              global "#include <stdint.h>"
              global "#include <string.h>"
              global (
                  "static float spiral_f32_of_bits(uint32_t u) { float f; memcpy(&f, &u, sizeof f); "
                  ^^ "return f; }"
              )
              $'spiral_f32_of_bits(!bits)' : f32
          | Wgsl => \ () => $'bitcast<f32>(!bits)' : f32
          | Zig => \ () => $'@@as(f32, @@bitCast(!bits))' : f32
          | _ => \ () => failwith "convert.f32_of_bits / no arm for this backend"

  := c_bits_of_f32 () : () =
      global "#include <stdint.h>"
      global "#include <string.h>"
      global "static uint32_t spiral_bits_of_f32(float f) { uint32_t u; memcpy(&u, &f, sizeof u); return u; }"

  := bits_of_f32 (x : f32) : u32 =
      run_target \|
          | Rust => \ () => $'(!x).to_bits()' : u32
          | C => \ () =>
              c_bits_of_f32 ()
              $'spiral_bits_of_f32(!x)' : u32
          | Wgsl => \ () => $'bitcast<u32>(!x)' : u32
          | Zig => \ () => $'@@as(u32, @@bitCast(!x))' : u32
          | _ => \ () => failwith "convert.bits_of_f32 / no arm for this backend"

  := parse_f64 (text : string) : option f64 =
      := value, parsed =
          run_target \|
              | Rust => \ () => $'match (!text).trim().parse::<f64>() { Ok(f) => (f, true), Err(_) => (0.0, false) }' : f64 * bool
              | Gleam => \ () =>
                  global "import gleam/float"
                  global "import gleam/int"
                  $'case float.parse(!text) { Ok(f) -> ##(f, True) Error(_) -> case int.parse(!text) { Ok(i) -> ##(int.to_float(i), True) Error(_) -> ##(0.0, False) } }' : f64 * bool
              | _ => \ () => failwith "convert.parse_f64 / no arm for this backend"
      ? parsed ?> Some value |: None
  """,
  timeout: 300_000
)
```

