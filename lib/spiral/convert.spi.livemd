## convert

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":":== unativeint_switch =\n    {\n        Gleam : $'unativeint'\n        Lua : $'unativeint'\n        Fsharp : $'unativeint'\n        Python : $'unativeint'\n        TypeScript : $'unativeint'\n        Cpp : $'unativeint'\n        CppHost : $'unativeint'\n        Pascal : $'unativeint'\n        Cuda : $'unativeint'\n        Rust : $'usize'\n        Zig : $'usize'\n    }\n:! unativeint = $'backend_switch `(unativeint_switch)'\n\n:= to' \\* t u. (fn : t -> option u) (x : t) : option u =\n    ~>\n        ?: t * u ?|\n        | ~x * ~x => Some `u x\n        | int * int => Some `u (conv `t `u x)\n        | float * float => Some `u (conv `t `u x)\n        | int * float => Some `u (conv `t `u x)\n        | float * int => Some `u (conv `t `u x)\n        | i64 * f64 => Some `u (conv `t `u x)\n        | f64 * i64 => Some `u (conv `t `u x)\n        | i32 * f64 => Some `u (conv `t `u x)\n        | f64 * i32 => Some `u (conv `t `u x)\n        | i64 * f32 => Some `u (conv `t `u x)\n        | f32 * i64 => Some `u (conv `t `u x)\n        | char * bool => Some `u (x = '1')\n        | bool * char => Some `u (? x ?> '1' |: '0')\n        | bool * _ => Some `u (? x ?> 1 |: 0)\n        | _ => fn x\n\n:= to \\* t u. (x : t) : u =\n    ? is_rust () ?>\n        := from_string : bool =\n            ~>\n                ?: t ?|\n                | string => !+\n                | _ => !-\n        x\n        |> to' \\ x =>\n            := y : u =\n                ? from_string\n                ?> $'(!x).parse::<`u>().unwrap()'\n                |: $'(!x as `u)'\n            Some y\n        |> optionm::value\n    |:\n        x\n        |> to' \\ x => $'!x ' |> Some\n        |> optionm::value\n\n:= numeric_conv \\* t u. (x : t) : u =\n    ?\n        ~>\n            ?: t ?|\n            | i8 => !+\n            | i16 => !+\n            | i32 => !+\n            | i64 => !+\n            | u8 => !+\n            | u16 => !+\n            | u32 => !+\n            | u64 => !+\n            | f32 => !+\n            | f64 => !+\n            | _ => !-\n        && (\n            ~>\n                ?: u ?|\n                | i8 => !+\n                | i16 => !+\n                | i32 => !+\n                | i64 => !+\n                | u8 => !+\n                | u16 => !+\n                | u32 => !+\n                | u64 => !+\n                | f32 => !+\n                | f64 => !+\n                | _ => !-\n        )\n    ?> ~> conv `t `u x\n    |: $'!x ' : u\n\n:= lean_parse_helpers () : () =\n    global \"\"\"\n        def spiralParseInt? (s : String) : Option Int :=\n          let u := s.trimAscii.toString\n          let v := if u.startsWith \"+\" then (u.drop 1).toString else u\n          v.toInt?\n\n        def spiralDigit (c : Char) : Int :=\n          if c.isDigit then (c.toNat : Int) - 48\n          else if 'a' ≤ c && c ≤ 'z' then (c.toNat : Int) - 87\n          else if 'A' ≤ c && c ≤ 'Z' then (c.toNat : Int) - 55\n          else 0\n\n        def spiralParseIntBase (s : String) (base : Int32) : Int32 :=\n          let u := s.trimAscii.toString\n          let neg := u.startsWith \"-\"\n          let body := if neg || u.startsWith \"+\" then (u.drop 1).toString else u\n          let v := body.foldl (fun acc c => acc * base.toInt + spiralDigit c) 0\n          Int32.ofInt (if neg then -v else v)\n        \"\"\"\n\n:= convert_i32_base \\* t. (base : i32) (x : t) : i32 =\n    backend_switch {\n        Gleam = \\ () =>\n            global \"import gleam/int\"\n            := (n : int), (err : int) =\n                $'case int.base_parse(!x, !base) { Ok(n) -> ##(n, 0) Error(Nil) -> ##(0, 1) }'\n            ? err = 0\n            ?> n |> Some\n            |: None\n            |> optionm::value\n        Lua = \\ () => $'tonumber( !x, !base )' : i32\n        Fsharp = \\ () => $'System.Convert.ToInt32 (!x, !base)' : i32\n        Python = \\ () => $'int (!x, !base)' : i32\n        Rust = \\ () =>\n            := radix : u32 = conv base\n            $'i32::from_str_radix(&*(!x), !radix).unwrap()' : i32\n        TypeScript = \\ () => $'parseInt(!x, !base)' : i32\n        C = \\ () => $'(int32_t)strtol((!x)->ptr, NULL, !base)' : i32\n        Pascal = \\ () =>\n            ? base = 16 ?> $'StrToInt(##36 + !x)' : i32\n            |? base = 2 ?> $'StrToInt(##37 + !x)' : i32\n            |? base = 8 ?> $'StrToInt(##38 + !x)' : i32\n            |? base = 10 ?> $'StrToInt(!x)' : i32\n            |: $'backend_switch_has_no_Pascal_arm_in_lib_spiral' : i32\n        Wasm = \\ () => $'(i32.wrap_i64 (call $parse_i64 !x !base))' : i32\n        Lean = \\ () =>\n            lean_parse_helpers ()\n            $'(spiralParseIntBase !x !base)' : i32\n        Kotlin = \\ () => $'((!x).trim().toIntOrNull(!base) ?: 0)' : i32\n        Swift = \\ () => $'(Int32(String((!x).split(separator: \" \").first ?? \"\"), radix: Int(!base)) ?? 0)' : i32\n        Zig = \\ () => $'(std.fmt.parseInt(i32, std.mem.trim(u8, !x, \" \\\\t\\\\r\\\\n\"), @@intCast(!base)) catch 0)' : i32\n    }","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ":== unativeint_switch =\n    {\n        Gleam : $'unativeint'\n        Lua : $'unativeint'\n        Fsharp : $'unativeint'\n        Python : $'unativeint'\n        TypeScript : $'unativeint'\n        Cpp : $'unativeint'\n        CppHost : $'unativeint'\n        Pascal : $'unativeint'\n        Cuda : $'unativeint'\n        Rust : $'usize'\n        Zig : $'usize'\n    }\n:! unativeint = $'backend_switch `(unativeint_switch)'\n\n:= to' \\* t u. (fn : t -> option u) (x : t) : option u =\n    ~>\n        ?: t * u ?|\n        | ~x * ~x => Some `u x\n        | int * int => Some `u (conv `t `u x)\n        | float * float => Some `u (conv `t `u x)\n        | int * float => Some `u (conv `t `u x)\n        | float * int => Some `u (conv `t `u x)\n        | i64 * f64 => Some `u (conv `t `u x)\n        | f64 * i64 => Some `u (conv `t `u x)\n        | i32 * f64 => Some `u (conv `t `u x)\n        | f64 * i32 => Some `u (conv `t `u x)\n        | i64 * f32 => Some `u (conv `t `u x)\n        | f32 * i64 => Some `u (conv `t `u x)\n        | char * bool => Some `u (x = '1')\n        | bool * char => Some `u (? x ?> '1' |: '0')\n        | bool * _ => Some `u (? x ?> 1 |: 0)\n        | _ => fn x\n\n:= to \\* t u. (x : t) : u =\n    ? is_rust () ?>\n        := from_string : bool =\n            ~>\n                ?: t ?|\n                | string => !+\n                | _ => !-\n        x\n        |> to' \\ x =>\n            := y : u =\n                ? from_string\n                ?> $'(!x).parse::<`u>().unwrap()'\n                |: $'(!x as `u)'\n            Some y\n        |> optionm::value\n    |:\n        x\n        |> to' \\ x => $'!x ' |> Some\n        |> optionm::value\n\n:= numeric_conv \\* t u. (x : t) : u =\n    ?\n        ~>\n            ?: t ?|\n            | i8 => !+\n            | i16 => !+\n            | i32 => !+\n            | i64 => !+\n            | u8 => !+\n            | u16 => !+\n            | u32 => !+\n            | u64 => !+\n            | f32 => !+\n            | f64 => !+\n            | _ => !-\n        && (\n            ~>\n                ?: u ?|\n                | i8 => !+\n                | i16 => !+\n                | i32 => !+\n                | i64 => !+\n                | u8 => !+\n                | u16 => !+\n                | u32 => !+\n                | u64 => !+\n                | f32 => !+\n                | f64 => !+\n                | _ => !-\n        )\n    ?> ~> conv `t `u x\n    |: $'!x ' : u\n\n:= lean_parse_helpers () : () =\n    global \"\"\"\n        def spiralParseInt? (s : String) : Option Int :=\n          let u := s.trimAscii.toString\n          let v := if u.startsWith \"+\" then (u.drop 1).toString else u\n          v.toInt?\n\n        def spiralDigit (c : Char) : Int :=\n          if c.isDigit then (c.toNat : Int) - 48\n          else if 'a' ≤ c && c ≤ 'z' then (c.toNat : Int) - 87\n          else if 'A' ≤ c && c ≤ 'Z' then (c.toNat : Int) - 55\n          else 0\n\n        def spiralParseIntBase (s : String) (base : Int32) : Int32 :=\n          let u := s.trimAscii.toString\n          let neg := u.startsWith \"-\"\n          let body := if neg || u.startsWith \"+\" then (u.drop 1).toString else u\n          let v := body.foldl (fun acc c => acc * base.toInt + spiralDigit c) 0\n          Int32.ofInt (if neg then -v else v)\n        \"\"\"\n\n:= convert_i32_base \\* t. (base : i32) (x : t) : i32 =\n    backend_switch {\n        Gleam = \\ () =>\n            global \"import gleam/int\"\n            := (n : int), (err : int) =\n                $'case int.base_parse(!x, !base) { Ok(n) -> ##(n, 0) Error(Nil) -> ##(0, 1) }'\n            ? err = 0\n            ?> n |> Some\n            |: None\n            |> optionm::value\n        Lua = \\ () => $'tonumber( !x, !base )' : i32\n        Fsharp = \\ () => $'System.Convert.ToInt32 (!x, !base)' : i32\n        Python = \\ () => $'int (!x, !base)' : i32\n        Rust = \\ () =>\n            := radix : u32 = conv base\n            $'i32::from_str_radix(&*(!x), !radix).unwrap()' : i32\n        TypeScript = \\ () => $'parseInt(!x, !base)' : i32\n        C = \\ () => $'(int32_t)strtol((!x)->ptr, NULL, !base)' : i32\n        Pascal = \\ () =>\n            ? base = 16 ?> $'StrToInt(##36 + !x)' : i32\n            |? base = 2 ?> $'StrToInt(##37 + !x)' : i32\n            |? base = 8 ?> $'StrToInt(##38 + !x)' : i32\n            |? base = 10 ?> $'StrToInt(!x)' : i32\n            |: $'backend_switch_has_no_Pascal_arm_in_lib_spiral' : i32\n        Wasm = \\ () => $'(i32.wrap_i64 (call $parse_i64 !x !base))' : i32\n        Lean = \\ () =>\n            lean_parse_helpers ()\n            $'(spiralParseIntBase !x !base)' : i32\n        Kotlin = \\ () => $'((!x).trim().toIntOrNull(!base) ?: 0)' : i32\n        Swift = \\ () => $'(Int32(String((!x).split(separator: \" \").first ?? \"\"), radix: Int(!base)) ?? 0)' : i32\n        Zig = \\ () => $'(std.fmt.parseInt(i32, std.mem.trim(u8, !x, \" \\\\t\\\\r\\\\n\"), @@intCast(!base)) catch 0)' : i32\n    }",
  timeout: 300_000
)
