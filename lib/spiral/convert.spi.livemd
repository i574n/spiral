|: $'BigInt.asUintN(64, BigInt(!x))' : u64\n        Zig = \\ () => numeric_conv x : u64\n        Lean = \\ () => numeric_conv x : u64\n        C = \\ () => numeric_conv x : u64\n        Pascal = \\ () => numeric_conv x : u64\n    }\n\n:= i32 \\* t. (x : t) : i32 =\n    backend_switch {\n        Gleam = \\ () => x |> convert : i32\n        Lua = \\ () => x |> convert : i32\n        Fsharp = \\ () => x |> convert : i32\n        Python = \\ () => x |> convert : i32\n        Rust = \\ () => x |> to : i32\n        TypeScript = \\ () =>\n            ? (~> ?: t ?| f32 => !+ | f64 => !+ | _ => !-)\n            ?> $'(Math.trunc(!x) | 0)' : i32\n            |: $'Number(BigInt.asIntN(32, BigInt(!x)))' : i32\n        Zig = \\ () => numeric_conv x : i32\n        Lean = \\ () => numeric_conv x : i32\n        C = \\ () => numeric_conv x : i32\n        Pascal = \\ () => numeric_conv x : i32\n    }\n\n:= i64 \\* t. (x : t) : i64 =\n    backend_switch {\n        Gleam = \\ () => x |> convert : i64\n        Lua = \\ () => x |> to : i64\n        Fsharp = \\ () => x |> $'int64' : i64\n        Python = \\ () => x |> to : i64\n        Rust = \\ () => x |> to : i64\n        TypeScript = \\ () =>\n            ? (~> ?: t ?| f32 => !+ | f64 => !+ | _ => !-)\n            ?> $'BigInt.asIntN(64, BigInt(Math.trunc(!x)))' : i64\n            |: $'BigInt.asIntN(64, BigInt(!x))' : i64\n        Zig = \\ () => numeric_conv x : i64\n        Lean = \\ () => numeric_conv x : i64\n        C = \\ () => numeric_conv x : i64\n        Pascal = \\ () => numeric_conv x : i64\n    }\n\n:= f32 \\* t. (x : t) : f32 =\n    backend_switch {\n        Gleam = \\ () => x |> convert : f32\n        Lua = \\ () => x |> to : f32\n        Fsharp = \\ () => x |> $'float32' : f32\n        Python = \\ () => x |> to : f32\n        Rust = \\ () => $'(!x as f32)' : f32\n        Zig = \\ () => numeric_conv x : f32\n        Lean = \\ () => numeric_conv x : f32\n        C = \\ () => numeric_conv x : f32\n        Pascal = \\ () => numeric_conv x : f32\n    }\n\n:= f64 \\* t. (x : t) : f64 =\n    backend_switch {\n        Gleam = \\ () => x |> convert : f64\n        Lua = \\ () => x |> to : f64\n        Fsharp = \\ () => x |> $'float' : f64\n        Python = \\ () => x |> to : f64\n        Rust = \\ () => $'(!x as f64)' : f64\n        Zig = \\ () => numeric_conv x : f64\n        Lean = \\ () => numeric_conv x : f64\n        C = \\ () => numeric_conv x : f64\n        Pascal = \\ () => numeric_conv x : f64\n    }","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  := convert \* t u. (x : t) : u =
      x |> try_convert |> optionm::value

  := unbox \* t u. (x : t) : u =
      backend_switch {
          Gleam = \ () => x |> convert : u
          Lua = \ () => x |> to : u
          Fsharp = \ () => $'!x |> unbox<`u>' : u
          Python = \ () => x |> to : u
          Rust = \ () => $'(!x)' : u
          Zig = \ () => x |> to : u
      }

  := u8 \* t. (x : t) : u8 =
      backend_switch {
          Gleam = \ () => x |> convert : u8
          Lua = \ () => x |> to : u8
          Fsharp = \ () => x |> $'uint8' : u8
          Python = \ () => x |> to : u8
          Rust = \ () => $'(!x as u8)' : u8
          TypeScript = \ () => $'Number(BigInt.asUintN(8, BigInt(!x)))' : u8
          Zig = \ () => numeric_conv x : u8
          Lean = \ () => numeric_conv x : u8
          C = \ () => $'((uint8_t)(!x))' : u8
          Pascal = \ () => $'Byte(!x)' : u8
      }

  := u16 \* t. (x : t) : u16 =
      backend_switch {
          Gleam = \ () => x |> convert : u16
          Lua = \ () => x |> to : u16
          Fsharp = \ () => x |> $'uint16' : u16
          Python = \ () => $'!x & 0xFFFF' : u16
          Rust = \ () => $'(!x as u16)' : u16
          TypeScript = \ () => $'Number(BigInt.asUintN(16, BigInt(!x)))' : u16
          Zig = \ () => numeric_conv x : u16
          Lean = \ () => numeric_conv x : u16
          C = \ () => numeric_conv x : u16
          Pascal = \ () => numeric_conv x : u16
      }

  := u64 \* t. (x : t) : u64 =
      backend_switch {
          Gleam = \ () => x |> convert : u64
          Lua = \ () => x |> to : u64
          Fsharp = \ () => x |> $'uint64' : u64
          Python = \ () => x |> to : u64
          Rust = \ () => $'(!x as u64)' : u64
          TypeScript = \ () =>
              ? (~> ?: t ?| f32 => !+ | f64 => !+ | _ => !-)
              ?> $'BigInt.asUintN(64, BigInt(Math.trunc(!x)))' : u64
              |: $'BigInt.asUintN(64, BigInt(!x))' : u64
          Zig = \ () => numeric_conv x : u64
          Lean = \ () => numeric_conv x : u64
          C = \ () => numeric_conv x : u64
          Pascal = \ () => numeric_conv x : u64
      }

  := i32 \* t. (x : t) : i32 =
      backend_switch {
          Gleam = \ () => x |> convert : i32
          Lua = \ () => x |> convert : i32
          Fsharp = \ () => x |> convert : i32
          Python = \ () => x |> convert : i32
          Rust = \ () => x |> to : i32
          TypeScript = \ () =>
              ? (~> ?: t ?| f32 => !+ | f64 => !+ | _ => !-)
              ?> $'(Math.trunc(!x) | 0)' : i32
              |: $'Number(BigInt.asIntN(32, BigInt(!x)))' : i32
          Zig = \ () => numeric_conv x : i32
          Lean = \ () => numeric_conv x : i32
          C = \ () => numeric_conv x : i32
          Pascal = \ () => numeric_conv x : i32
      }

  := i64 \* t. (x : t) : i64 =
      backend_switch {
          Gleam = \ () => x |> convert : i64
          Lua = \ () => x |> to : i64
          Fsharp = \ () => x |> $'int64' : i64
          Python = \ () => x |> to : i64
          Rust = \ () => x |> to : i64
          TypeScript = \ () =>
              ? (~> ?: t ?| f32 => !+ | f64 => !+ | _ => !-)
              ?> $'BigInt.asIntN(64, BigInt(Math.trunc(!x)))' : i64
              |: $'BigInt.asIntN(64, BigInt(!x))' : i64
          Zig = \ () => numeric_conv x : i64
          Lean = \ () => numeric_conv x : i64
          C = \ () => numeric_conv x : i64
          Pascal = \ () => numeric_conv x : i64
      }

  := f32 \* t. (x : t) : f32 =
      backend_switch {
          Gleam = \ () => x |> convert : f32
          Lua = \ () => x |> to : f32
          Fsharp = \ () => x |> $'float32' : f32
          Python = \ () => x |> to : f32
          Rust = \ () => $'(!x as f32)' : f32
          Zig = \ () => numeric_conv x : f32
          Lean = \ () => numeric_conv x : f32
          C = \ () => numeric_conv x : f32
          Pascal = \ () => numeric_conv x : f32
      }

  := f64 \* t. (x : t) : f64 =
      backend_switch {
          Gleam = \ () => x |> convert : f64
          Lua = \ () => x |> to : f64
          Fsharp = \ () => x |> $'float' : f64
          Python = \ () => x |> to : f64
          Rust = \ () => $'(!x as f64)' : f64
          Zig = \ () => numeric_conv x : f64
          Lean = \ () => numeric_conv x : f64
          C = \ () => numeric_conv x : f64
          Pascal = \ () => numeric_conv x : f64
      }
  """,
  timeout: 300_000
)
```

