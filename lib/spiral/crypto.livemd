)
```

### hash_to_port

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"inl hash_to_port (text : string) : u16 =\n    inl first_letter_code = text |> sm'.index 0i32 |> sm'.convert_to_utf32\n    inl hash_part = text |> sm'.slice 0i32 7\n    inl combined_value = convert.convert_i32_base 16 hash_part + first_letter_code |> convert.u16\n    trace Verbose\n        fun () => \"crypto.hash_to_port\"\n        fun () => { first_letter_code hash_part combined_value }\n    combined_value % 48128 + 1024","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  inl hash_to_port (text : string) : u16 =
      inl first_letter_code = text |> sm'.index 0i32 |> sm'.convert_to_utf32
      inl hash_part = text |> sm'.slice 0i32 7
      inl combined_value = convert.convert_i32_base 16 hash_part + first_letter_code |> convert.u16
      trace Verbose
          fun () => "crypto.hash_to_port"
          fun () => { first_letter_code hash_part combined_value }
      combined_value % 48128 + 1024
  """,
  timeout: 300_000
)
```

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"///- --test\n///> fsharp\n///> cuda\n///> rust -d sha2\n///> typescript\n\n\"\\n\"\n|> hash_text\n|> hash_to_port\n|> _assert_eq 19273","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  ///- --test
  ///> fsharp
  ///> cuda
  ///> rust -d sha2
  ///> typescript

  "\n"
  |> hash_text
  |> hash_to_port
  |> _assert_eq 19273
  """,
  timeout: 300_000
)
```

## main

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"///> fsharp\n\ninl main () =\n    $'let hash_text x = !hash_text x' : ()\n    $'let hash_to_port x = !hash_to_port x' : ()","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  ///> fsharp

  inl main () =
      $'let hash_text x = !hash_text x' : ()
      $'let hash_to_port x = !hash_to_port x' : ()
  """,
  timeout: 300_000
)
```
