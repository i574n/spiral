### hash_read

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"inl hash_read data : resultm.result' string stream.io_error =\n    inl reader = data |> stream.new_buf_reader\n    (!\\($'\"true; let mut !reader = !reader\"') : bool) |> ignore\n    inl hasher = new_sha256 ()\n    (!\\($'\"true; let mut !hasher = !hasher\"') : bool) |> ignore\n    real\n        inl size = 1024\n        inl zero = convert.convert `i32 `(convert.unativeint) 0\n        inl buffer = am'.new_slice `u8 `@size 0u8\n        rust.loop 0 fun () =>\n            inl count = stream.buf_reader_read `u8 `@size buffer reader\n            inl count = resultm.unwrap' `(convert.unativeint) `(stream.io_error) count\n            inl _ =\n                if (=.) `(convert.unativeint) count zero then\n                    rust.break `(()) ()\n                    true\n                else false\n            hasher_update `u8 `@size\n                (\n                    am'.slice_range `u8 `@size\n                        (am'.Start `(convert.unativeint) zero)\n                        (am'.End `(convert.unativeint)\n                            ((fun _ => count) : (() -> convert.unativeint) -> convert.unativeint))\n                        buffer\n                )\n                hasher\n    hasher\n    |> hasher_finalize\n    |> am'.slice_to_vec\n    |> am'.vec_map (sm'.format_hex' >> sm'.from_std_string)\n    |> am'.from_vec_base\n    |> am'.to_list_base'\n    |> listm'.unbox\n    |> sm'.concat_list (join \"\")\n    |> Ok\n    |> resultm.box","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  inl hash_read data : resultm.result' string stream.io_error =
      inl reader = data |> stream.new_buf_reader
      (!\($'"true; let mut !reader = !reader"') : bool) |> ignore
      inl hasher = new_sha256 ()
      (!\($'"true; let mut !hasher = !hasher"') : bool) |> ignore
      real
          inl size = 1024
          inl zero = convert.convert `i32 `(convert.unativeint) 0
          inl buffer = am'.new_slice `u8 `@size 0u8
          rust.loop 0 fun () =>
              inl count = stream.buf_reader_read `u8 `@size buffer reader
              inl count = resultm.unwrap' `(convert.unativeint) `(stream.io_error) count
              inl _ =
                  if (=.) `(convert.unativeint) count zero then
                      rust.break `(()) ()
                      true
                  else false
              hasher_update `u8 `@size
                  (
                      am'.slice_range `u8 `@size
                          (am'.Start `(convert.unativeint) zero)
                          (am'.End `(convert.unativeint)
                              ((fun _ => count) : (() -> convert.unativeint) -> convert.unativeint))
                          buffer
                  )
                  hasher
      hasher
      |> hasher_finalize
      |> am'.slice_to_vec
      |> am'.vec_map (sm'.format_hex' >> sm'.from_std_string)
      |> am'.from_vec_base
      |> am'.to_list_base'
      |> listm'.unbox
      |> sm'.concat_list (join "")
      |> Ok
      |> resultm.box
  """,
  timeout: 300_000
)
```

### get_file_hash

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"inl get_file_hash (path : string) =\n    inl path = path |> file_system.normalize_path\n    inl file = path |> file_system.file_open |> resultm.unwrap'\n    inl reader = file |> stream.new_buf_reader\n    reader\n    |> hash_read","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  inl get_file_hash (path : string) =
      inl path = path |> file_system.normalize_path
      inl file = path |> file_system.file_open |> resultm.unwrap'
      inl reader = file |> stream.new_buf_reader
      reader
      |> hash_read
  """,
  timeout: 300_000
)
```

