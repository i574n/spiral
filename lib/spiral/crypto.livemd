## crypto

<!-- livebook:{"break_markdown":true} -->

### hash_text

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"let hash_text (~input : string) =\n    run_target function\n        | Fsharp => fun () =>\n            inl sha256 = sha256 () |> use\n            input\n            |> sm'.utf8_get_bytes\n            |> sha256_compute_hash sha256\n            |> am.map (sm'.byte_to_string \"x2\")\n            |> seq.of_array'\n            |> sm'.concat (join \"\")\n        | TypeScript => fun () =>\n            create_hash \"sha256\"\n            |> hash_update input\n            |> hash_digest \"hex\"\n        | Rust => fun () =>\n            input\n            |> sm'.utf8_get_bytes\n            |> fun (a x) => x\n            |> am'.to_vec\n            |> stream.new_cursor\n            |> hash_read\n            |> resultm.unwrap'\n        | Cuda => fun () =>\n            hashlib_sha256 ()\n            |> sha256_update (input |> sm'.encode_utf8)\n            |> sha256_hexdigest\n        | _ => fun () => null ()","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  let hash_text (~input : string) =
      run_target function
          | Fsharp => fun () =>
              inl sha256 = sha256 () |> use
              input
              |> sm'.utf8_get_bytes
              |> sha256_compute_hash sha256
              |> am.map (sm'.byte_to_string "x2")
              |> seq.of_array'
              |> sm'.concat (join "")
          | TypeScript => fun () =>
              create_hash "sha256"
              |> hash_update input
              |> hash_digest "hex"
          | Rust => fun () =>
              input
              |> sm'.utf8_get_bytes
              |> fun (a x) => x
              |> am'.to_vec
              |> stream.new_cursor
              |> hash_read
              |> resultm.unwrap'
          | Cuda => fun () =>
              hashlib_sha256 ()
              |> sha256_update (input |> sm'.encode_utf8)
              |> sha256_hexdigest
          | _ => fun () => null ()
  """,
  timeout: 300_000
)
```

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"///- --test\n///> fsharp\n///> cuda\n///> rust -d sha2\n///> typescript\n\n\"\\n\"\n|> hash_text\n|> _assert_eq \"01ba4719c80b6fe911b091a7c05124b64eeece964e09c058ef8f9805daca546b\"\n\n\"\"\n|> hash_text\n|> _assert_eq \"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855\"","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  ///- --test
  ///> fsharp
  ///> cuda
  ///> rust -d sha2
  ///> typescript

  "\n"
  |> hash_text
  |> _assert_eq "01ba4719c80b6fe911b091a7c05124b64eeece964e09c058ef8f9805daca546b"

  ""
  |> hash_text
  |> _assert_eq "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"
  """,
