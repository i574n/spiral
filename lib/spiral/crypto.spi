:# crypto static =
    :< testing
    :< file_system_operators

:< rust_operators
:< sm'_operators

:! sha256 = $'System.Security.Cryptography.SHA256'

:= sha256 () : sha256 =
    $'`sha256.Create' ()

:= sha256_compute_hash (x : sha256) (data : array u8) : array u8 =
    data |> $'!x.ComputeHash'

:! sha256' =
    `(
        rust::rust_type
            `($'sha2_Sha256')
            `($'sha2::Sha256')
            "type sha2_Sha256 = class end"
    )

:= new_sha256 () : sha256' =
    (!\($'"true; let result : sha2::Sha256 = sha2::Digest::new()"') : bool) |> ignore
    !\($'"result"')

:= hasher_update \* el dim. (slice : rust::ref (am'::slice' el dim)) (hasher : sha256') : () =
    (!\($'"true; sha2::Digest::update(&mut !hasher, !slice)"') : bool) |> ignore

:= hasher_finalize (hasher : sha256') : rust::ref (am'::slice u8) =
    !\($'"&sha2::Digest::finalize(!hasher)"')

:= hash_reader_loop reader hasher : () =
    ~>
        := size = 1024
        := zero = convert::convert `i32 `(convert::unativeint) 0
        := buffer = am'::new_slice `u8 `@size 0u8
        rust::loop 0 \ () =>
            := count = stream::buf_reader_read `u8 `@size buffer reader
            := count = resultm::unwrap' `(convert::unativeint) `(stream::io_error) count
            := _ =
                ? (=.) `(convert::unativeint) count zero ?>
                    rust::break `(()) ()
                    !+
                |: !-
            hasher_update `u8 `@size
                (
                    am'::slice_range `u8 `@size
                        (am'::Start `(convert::unativeint) zero)
                        (am'::End `(convert::unativeint)
                            ((\ _ => count) : (() -> convert::unativeint) -> convert::unativeint))
                        buffer
                )
                hasher

:= hasher_hex (hasher : sha256') : string =
    hasher
    |> hasher_finalize
    |> am'::slice_to_vec
    |> am'::vec_map (sm'::format_hex' >> sm'::from_std_string)
    |> am'::from_vec_base
    |> am'::to_list_base'
    |> listm'::unbox
    |> sm'::concat_list (~~ "")

:= mut_buf_reader data =
    := reader = data |> stream::new_buf_reader
    (!\($'"true; let mut !reader = !reader"') : bool) |> ignore
    reader

:= hash_read data : resultm::result' string stream::io_error =
    := reader = mut_buf_reader data
    := hasher = new_sha256 ()
    (!\($'"true; let mut !hasher = !hasher"') : bool) |> ignore
    hash_reader_loop reader hasher
    hasher |> hasher_hex |> Ok |> resultm::box

:= get_file_hash (path : string) =
    := path = path |> file_system::normalize_path
    := file = path |> file_system::file_open |> resultm::unwrap'
    := reader = file |> stream::new_buf_reader
    reader
    |> hash_read

:= sha256_of_newline () : string = "01ba4719c80b6fe911b091a7c05124b64eeece964e09c058ef8f9805daca546b"

:= sha256_of_empty () : string = "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"

:= create_hash (x : string) : any =
    global "import * as spiral_node_crypto from 'node:crypto';"
    $'spiral_node_crypto.createHash(!x)' : any

:= hash_update (s : string) (x : any) : any =
    $'!x.update(!s, "utf8")' : any

:= hash_digest (s : string) (x : any) : string =
    $'!x.digest(!s)' : string

:! py_sha256 = any

:= hashlib_sha256 () : py_sha256 =
    backend_switch {
        Python = \ () =>
            global "import hashlib"
            $'hashlib.sha256()' : py_sha256
    }

:= sha256_update (x : string) (sha256 : py_sha256) : py_sha256 =
    backend_switch {
        Python = \ () =>
            $'!sha256.update(!x)' : ()
    }
    sha256

:= sha256_hexdigest (sha256 : py_sha256) : string =
    backend_switch {
        Python = \ () =>
            $'!sha256.hexdigest()' : string
    }

:= zig_sha256_global () : () =
    global """
        fn spiral_out_sha256_hex(input: []const u8) []const u8 {
            var digest: [32]u8 = undefined;
            std.crypto.hash.sha2.Sha256.hash(input, &digest, .{});
            const hex = std.fmt.bytesToHex(digest, .lower);
            return spiral_gpa.dupe(u8, &hex) catch @panic("out of memory");
        }
        """

:= zig_sha256_hex (input : string) : string =
    zig_sha256_global ()
    $'spiral_out_sha256_hex(!input)' : string

///> zig
:# zig_sha256_hex_matches_known_digests =
    (zig_sha256_hex "", zig_sha256_hex "\n") |> _assert_eq (sha256_of_empty (), sha256_of_newline ())

:= hash_text_fsharp (~input : string) =
    := sha256 = sha256 () |> use
    input
    |> sm'::utf8_get_bytes
    |> sha256_compute_hash sha256
    |> arraym::map (sm'::byte_to_string "x2")
    |> seq::of_array'
    |> sm'::concat (~~ "")

:= hash_text_typescript (~input : string) =
    create_hash "sha256"
    |> hash_update input
    |> hash_digest "hex"

:= hash_text_rust (~input : string) =
    input
    |> sm'::utf8_get_bytes
    |> \ (array x) => x
    |> am'::to_vec
    |> stream::new_cursor
    |> hash_read
    |> resultm::unwrap'

:= hash_text_cuda (~input : string) =
    hashlib_sha256 ()
    |> sha256_update (input |> sm'::encode_utf8)
    |> sha256_hexdigest

:= gleam_hash_imports () : () =
    global "import gleam/bit_array"
    global "import gleam/string"

:= gleam_hash_kind_global () : () =
    global """
        type SpiralHashKind {
          Sha256
        }
        """

:= gleam_crypto_hash_global () : () =
    global """
        @external(erlang, "crypto", "hash")
        fn spiral_crypto_hash(kind: SpiralHashKind, data: String) -> BitArray
        """

:= hash_text_gleam (~input : string) =
    gleam_hash_imports ()
    gleam_hash_kind_global ()
    gleam_crypto_hash_global ()
    $'string.lowercase(bit_array.base16_encode(spiral_crypto_hash(Sha256, !input)))' : string

:~ hash_text (~input : string) =
    run_target \|
        | Zig => \ () => zig_sha256_hex input
        | Fsharp => \ () => hash_text_fsharp input
        | TypeScript => \ () => hash_text_typescript input
        | Rust => \ () => hash_text_rust input
        | Cuda => \ () => hash_text_cuda input
        | Gleam _ => \ () => hash_text_gleam input
        | _ => \ () => null ()

:= temp_dir_for (file_name : string) (text : string) : string =
    := temp_dir, disposable =
        #?*(file_name, text)
        |> hash_text
        |> file_system::create_temp_directory'
    disposable |> use |> ignore
    temp_dir

:= file_hash_of (text : string) : string =
    := file_name = ~~ "test.txt"
    := path = file_system::(</>) (temp_dir_for file_name text) file_name
    text |> file_system::write_all_text path
    path |> get_file_hash |> resultm::unwrap'

///> rust -d chrono regex sha2
:# get_file_hash_2 =
    file_hash_of "\n" |> _assert_eq (sha256_of_newline ())

///> rust -d chrono regex sha2
:# get_file_hash_3 =
    file_hash_of "" |> _assert_eq (sha256_of_empty ())

///> cuda
///> rust -d sha2
///> typescript
///> gleam
:# hash_text =
    "\n" |> hash_text |> _assert_eq (sha256_of_newline ())

///> cuda
///> rust -d sha2
///> typescript
///> gleam
:# hash_text_of_empty =
    "" |> hash_text |> _assert_eq (sha256_of_empty ())

:= crypto_gleam_imports () : () =
    global "import gleam/bit_array"
    global "import gleam/erlang/atom"
    global "import gleam/string"

:= crypto_gleam_sha1_global () : () =
    global """
        @external(erlang, "crypto", "hash")
        fn spiral_crypto_hash_by(kind: atom.Atom, data: String) -> BitArray

        @external(erlang, "crypto", "mac")
        fn spiral_crypto_mac(kind: atom.Atom, sub: atom.Atom, key: String, data: String) -> BitArray

        """

:= crypto_gleam_sha1 () =
    crypto_gleam_imports ()
    crypto_gleam_sha1_global ()

:= hex_byte (b : u8) : string =
    := high : i32 = conv (b >>> 4i32)
    := low : i32 = conv (b &&& 15u8)
    sm'::slice high high "0123456789abcdef" ++# sm'::slice low low "0123456789abcdef"

:= hex_of_bytes (bytes : array_base u8) : string =
    := size : i32 = am'::length_base bytes
    :~ ^ go (i : i32) (acc : string) : string =
        ? i >= size ?> acc |: go (i + 1i32) (acc ++# hex_byte (am'::index_base i bytes))
    go 0i32 ""

:= rust_hex_of_vec (bytes : am'::vec u8) : string =
    $'Rc::<str>::from((!bytes).iter().flat_map(|b| [b >> 4, \
        b & 15]).map(|n| char::from(b"0123456789abcdef"[n as usize])).collect::<String>())'
    : string

:= hex_of_vec (bytes : am'::vec u8) : string =
    backend_switch {
        Rust = \ () => rust_hex_of_vec bytes
    }

///> rust
:# hex_of_vec =
    [ 0u8; 15; 16; 171; 255 ]
    |> am'::new_vec
    |> hex_of_vec
    |> _assert_eq "000f10abff"

:= rust_sha1_digest (text : string) : array_base u8 =
    $'Rc::new(RefCell::new(<sha1::Sha1 as sha1::Digest>::digest(!text.as_bytes()).to_vec()))' : array_base u8

:= sha1_hex (text : string) : string =
    backend_switch {
        Gleam = \ () =>
            crypto_gleam_sha1 ()
            $'string.lowercase(bit_array.base16_encode(spiral_crypto_hash_by(atom.create("sha"), !text)))' : string
        Rust = \ () => text |> rust_sha1_digest |> hex_of_bytes
    }

:! hmac_sha1 = $'hmac::Hmac<sha1::Sha1>'

:! hmac_sha1_tag = $'hmac::digest::Output<hmac::Hmac<sha1::Sha1>>'

:= gleam_hmac_sha1_base64 (key : string) (text : string) : string =
    crypto_gleam_sha1 ()
    $'bit_array.base64_encode(spiral_crypto_mac(atom.create("hmac"), atom.create("sha"), !key, !text), True)'
    : string

:= rust_hmac_sha1_new (key : string) : hmac_sha1 =
    $'<hmac::Hmac<sha1::Sha1> as hmac::digest::KeyInit>::new_from_slice(!key.as_bytes()).unwrap()' : hmac_sha1

:= rust_base64_of_tag (tag : hmac_sha1_tag) : string =
    $'Rc::<str>::from(base64::Engine::encode(&base64::engine::general_purpose::STANDARD, !tag))' : string

:= rust_hmac_sha1_base64 (key : string) (text : string) : string =
    := mac = rust_hmac_sha1_new key
    mac |> rust::to_mut
    $'hmac::Mac::update(&mut !mac, !text.as_bytes())' : ()
    rust_base64_of_tag ($'hmac::Mac::finalize(!mac).into_bytes()' : hmac_sha1_tag)

:= hmac_sha1_base64 (key : string) (text : string) : string =
    backend_switch {
        Gleam = \ () => gleam_hmac_sha1_base64 key text
        Rust = \ () => rust_hmac_sha1_base64 key text
    }

///> rust -d sha1 hmac base64
///> gleam
:# sha1_hex_and_hmac_sha1_base64 =
    := ~text = "abc"
    sha1_hex text |> _assert_eq "a9993e364706816aba3e25717850c26c9cd0d89d"

///> rust -d sha1 hmac base64
///> gleam
:# hmac_sha1_base64_of_the_quick_brown_fox =
    hmac_sha1_base64 "key" "The quick brown fox jumps over the lazy dog" |> _assert_eq "3nybhbi3iqa8ino29wqQcBydtNk="

:= hex_nibble (c : string) : i32 = sm'::index_of c "0123456789abcdef"

:= hex_byte_at (text : string) (i : i32) : option u8 =
    := hi = hex_nibble (sm'::slice i i text)
    := lo = hex_nibble (sm'::slice (i + 1i32) (i + 1i32) text)
    ? hi < 0i32 || lo < 0i32 ?> None |: Some (convert::convert (hi * 16i32 + lo))

:~ ^ hex_bytes (text : string) (size : i32) (i : i32) (acc : list u8) : option (list u8) =
    ? i >= size
    ?> Some (listm::rev acc)
    |:
        ?= hex_byte_at text i ?|
        | Some byte => hex_bytes text size (i + 2i32) (byte :: acc)
        | None => None

:= decode_hex (text : string) : option (list u8) =
    := size : i32 = sm'::length text
    ? size % 2i32 <> 0i32 ?> None |: hex_bytes text size 0i32 []

:! ed25519_signature = $'ed25519_dalek::Signature'

:= rust_ed25519_signature (signature : array_base u8) : ed25519_signature =
    $'ed25519_dalek::Signature::from_bytes(&<[u8; 64]>::try_from(&(*!signature.borrow())[..]).unwrap())' : ed25519_signature

:= rust_ed25519_verify (key : array_base u8) (message : string) (signature : array_base u8) : bool =
    := sig = rust_ed25519_signature signature
    $'ed25519_dalek::VerifyingKey::from_bytes(&<[u8; 32]>::try_from(&(*!key.borrow())[..]).unwrap()) \
        .map(|k| k.verify_strict(!message.as_bytes(), &!sig).is_ok()).unwrap_or(false)'

:= verify_decoded (key : list u8) (sig : list u8) (message : string) : bool =
    ? (listm::length key : i32) <> 32i32 || (listm::length sig : i32) <> 64i32
    ?> !-
    |: rust_ed25519_verify (key |> listm'::box |> listm'::to_array') message (sig |> listm'::box |> listm'::to_array')

:= ed25519_verify (public_key : string) (message : string) (signature : string) : bool =
    ?= decode_hex public_key ?|
    | None => !-
    | Some key =>
        ?= decode_hex signature ?|
        | None => !-
        | Some sig => verify_decoded key sig message

:= rfc8032_key () : string = "d75a980182b10ab7d54bfed3c964073a0ee172f3daa62325af021a68f707511a"

:= rfc8032_head () : string = "e5564300c360ac729086e2cc806e828a84877f1eb8e5d974d873e06522490155"

:= rfc8032_signature () : string = rfc8032_head () ++# "5fb8821590a33bacc61e39701cf9b46bd25bf5f0595bbe24655141438e7a100b"

:= rfc8032_flipped () : string = rfc8032_head () ++# "5fb8821590a33bacc61e39701cf9b46bd25bf5f0595bbe24655141438e7a100a"

///> rust -d ed25519-dalek
:# ed25519_verify_checks_rfc8032_vector_1 =
    := ~key = rfc8032_key ()
    := ~signature = rfc8032_signature ()
    ed25519_verify key "" signature |> _assert_eq !+

///> rust -d ed25519-dalek
:# ed25519_verify_rejects_a_flipped_signature_bit =
    := ~key = rfc8032_key ()
    := ~flipped = rfc8032_flipped ()
    ed25519_verify key "" flipped |> _assert_eq !-

///> rust -d ed25519-dalek
:# ed25519_verify_rejects_a_short_key =
    := ~signature = rfc8032_signature ()
    ed25519_verify "d75a98" "" signature |> _assert_eq !-

///> rust -d ed25519-dalek
:# decode_hex_reads_bytes =
    (decode_hex "0aff" = Some [ 10u8; 255u8 ]) |> _assert_eq !+

:= crypto_gleam_pbkdf2 () =
    crypto_gleam_sha1 ()
    global """
        @external(erlang, "crypto", "pbkdf2_hmac")
        fn spiral_crypto_pbkdf2(digest: atom.Atom, pass: String, salt: String, iter: Int, len: Int) -> BitArray
        """

:= crypto_gleam_hash_equals () =
    crypto_gleam_sha1 ()
    global """
        @external(erlang, "crypto", "hash_equals")
        fn spiral_crypto_hash_equals(a: String, b: String) -> Bool
        """

:! hmac_sha256 = $'hmac::Hmac<sha2::Sha256>'

:! hmac_sha256_tag = $'hmac::digest::Output<hmac::Hmac<sha2::Sha256>>'

:= rust_hmac_sha256_new (key : string) : hmac_sha256 =
    $'<hmac::Hmac<sha2::Sha256> as hmac::digest::KeyInit>::new_from_slice(!key.as_bytes()).unwrap()' : hmac_sha256

:= rust_tag_bytes (tag : hmac_sha256_tag) : array_base u8 = $'Rc::new(RefCell::new(!tag.to_vec()))' : array_base u8

:= rust_hmac_sha256 (key : string) (text : string) : array_base u8 =
    := mac = rust_hmac_sha256_new key
    mac |> rust::to_mut
    $'hmac::Mac::update(&mut !mac, !text.as_bytes())' : ()
    rust_tag_bytes ($'hmac::Mac::finalize(!mac).into_bytes()' : hmac_sha256_tag)

:= gleam_hmac_sha256_hex (key : string) (text : string) : string =
    crypto_gleam_sha1 ()
    := mac = $'spiral_crypto_mac(atom.create("hmac"), atom.create("sha256"), !key, !text)' : string
    $'string.lowercase(bit_array.base16_encode(!mac))' : string

:= hmac_sha256_hex (key : string) (text : string) : string =
    backend_switch {
        Gleam = \ () => gleam_hmac_sha256_hex key text
        Rust = \ () => rust_hmac_sha256 key text |> hex_of_bytes
    }

:= rust_pbkdf2_sha256 (pass : string) (salt : string) (rounds : u32) : array_base u8 =
    $'{ let mut out = [0u8; 32]; pbkdf2::pbkdf2_hmac::<sha2::Sha256>(!pass.as_bytes(), !salt.as_bytes(), !rounds, &mut out); Rc::new(RefCell::new(out.to_vec())) }'
    : array_base u8

:= gleam_pbkdf2_sha256_hex (pass : string) (salt : string) (rounds : u32) : string =
    crypto_gleam_pbkdf2 ()
    := key = $'spiral_crypto_pbkdf2(atom.create("sha256"), !pass, !salt, !rounds, 32)' : string
    $'string.lowercase(bit_array.base16_encode(!key))' : string

:= pbkdf2_sha256_hex (pass : string) (salt : string) (rounds : u32) : string =
    backend_switch {
        Gleam = \ () => gleam_pbkdf2_sha256_hex pass salt rounds
        Rust = \ () => rust_pbkdf2_sha256 pass salt rounds |> hex_of_bytes
    }

:= rust_constant_time_equal (a : string) (b : string) : bool =
    $'{ use subtle::ConstantTimeEq; !a.len() == !b.len() && bool::from(!a.as_bytes().ct_eq(!b.as_bytes())) }' : bool

:= gleam_constant_time_equal (a : string) (b : string) : bool =
    crypto_gleam_hash_equals ()
    $'string.byte_size(!a) == string.byte_size(!b) && spiral_crypto_hash_equals(!a, !b)' : bool

:= constant_time_equal (a : string) (b : string) : bool =
    backend_switch {
        Gleam = \ () => gleam_constant_time_equal a b
        Rust = \ () => rust_constant_time_equal a b
    }

///> rust -d sha2=0.10 hmac=0.12
///> gleam
:# hmac_sha256_matches_rfc4231_test_case_2 =
    hmac_sha256_hex "Jefe" "what do ya want for nothing?"
    |> _assert_eq "5bdcc146bf60754e6a042426089575c75a003f089d2739839dec58b964ec3843"

///> rust -d sha2=0.10 pbkdf2=0.12
///> gleam
:# pbkdf2_sha256_matches_the_published_one_round_vector =
    pbkdf2_sha256_hex "password" "salt" 1u32
    |> _assert_eq "120fb6cffcf8b32c43e7225256c4f837a86548c92ccc35480805987cb70be17b"

///> rust -d sha2=0.10 pbkdf2=0.12
///> gleam
:# pbkdf2_sha256_matches_the_published_two_round_vector =
    pbkdf2_sha256_hex "password" "salt" 2u32
    |> _assert_eq "ae4d0c95af6b46d32d0adff928f06dd02a303f8ef3c251dfd6e2d85a95474c43"

///> rust -d sha2=0.10 pbkdf2=0.12
///> gleam
:# pbkdf2_sha256_at_4096_rounds_matches_the_published_vector =
    pbkdf2_sha256_hex "password" "salt" 4096u32
    |> _assert_eq "c5e478d59288c841aa530db6845c4c8d962893a001ce4e11a4963873aa98134a"

///> rust -d subtle
///> gleam
:# constant_time_equal_compares_whole_strings_and_lengths =
    (constant_time_equal "abc" "abc", constant_time_equal "abc" "abd", constant_time_equal "abc" "ab")
    |> _assert_eq (!+, !-, !-)

:= port_parts (text : string) : i32 * string * u16 =
    := first_letter_code = text |> sm'::index 0i32 |> sm'::convert_to_utf32
    := hash_part = text |> sm'::slice 0i32 7
    first_letter_code, hash_part, (convert::convert_i32_base 16 hash_part + first_letter_code |> convert::u16)

:= hash_to_port (text : string) : u16 =
    := first_letter_code, hash_part, combined_value = port_parts text
    trace Verbose
        \ () => "crypto.hash_to_port"
        \ () => { first_letter_code hash_part combined_value }
    combined_value % 48128 + 1024

///> cuda
///> rust -d sha2
///> typescript
:# hash_to_port =
    "\n"
    |> hash_text
    |> hash_to_port
    |> _assert_eq 19273

:= utf8_bytes (text : string) : array_base u8 =
    backend_switch {
        Rust = \ () => $'Rc::new(RefCell::new((!text).as_bytes().to_vec()))' : array_base u8
    }

:= sha256_hex_bytes (data : array_base u8) : string =
    backend_switch {
        Rust = \ () =>
            $'Rc::<str>::from(<sha2::Sha256 as sha2::Digest>::digest(&*(!data).borrow()).iter().map(|b| \
                format\!("{:02x}", b)).collect::<String>())' : string
    }

:= rust_hmac_sha256_new_bytes (key : array_base u8) : hmac_sha256 =
    $'<hmac::Hmac<sha2::Sha256> as hmac::digest::KeyInit>::new_from_slice(&*(!key).borrow()) \
        .unwrap()' : hmac_sha256

:= rust_hmac_sha256_bytes (key : array_base u8) (text : string) : array_base u8 =
    := mac = rust_hmac_sha256_new_bytes key
    mac |> rust::to_mut
    $'hmac::Mac::update(&mut !mac, !text.as_bytes())' : ()
    rust_tag_bytes ($'hmac::Mac::finalize(!mac).into_bytes()' : hmac_sha256_tag)

:= hmac_sha256_bytes (key : array_base u8) (text : string) : array_base u8 =
    backend_switch {
        Rust = \ () => rust_hmac_sha256_bytes key text
    }

///> rust -d sha2=0.10 hmac=0.12
:# byte_key_sha256_matches_the_published_vector =
    sha256_hex_bytes (utf8_bytes "abc") |> _assert_eq "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad"

///> rust -d sha2=0.10 hmac=0.12
:# byte_key_hmac_and_sha256_match_published_vectors =
    hmac_sha256_bytes (utf8_bytes "Jefe") "what do ya want for nothing?" |> hex_of_bytes
    |> _assert_eq "5bdcc146bf60754e6a042426089575c75a003f089d2739839dec58b964ec3843"

///> fsharp

:= main () =
    $'let hash_text x = !hash_text x' : ()
    $'let hash_to_port x = !hash_to_port x' : ()
