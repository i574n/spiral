```elixir
Spiral.Cells.eval!(
  ":~ hash_text (~input : string) =\n    run_target \\|\n        | Zig => \\ () => zig_sha256_hex input\n        | Fsharp => \\ () =>\n            := sha256 = sha256 () |> use\n            input\n            |> sm'::utf8_get_bytes\n            |> sha256_compute_hash sha256\n            |> arraym::map (sm'::byte_to_string \"x2\")\n            |> seq::of_array'\n            |> sm'::concat (~~ \"\")\n        | TypeScript => \\ () =>\n            create_hash \"sha256\"\n            |> hash_update input\n            |> hash_digest \"hex\"\n        | Rust => \\ () =>\n            input\n            |> sm'::utf8_get_bytes\n            |> \\ (array x) => x\n            |> am'::to_vec\n            |> stream::new_cursor\n            |> hash_read\n            |> resultm::unwrap'\n        | Cuda => \\ () =>\n            hashlib_sha256 ()\n            |> sha256_update (input |> sm'::encode_utf8)\n            |> sha256_hexdigest\n        | Gleam _ => \\ () =>\n            global \"import gleam/bit_array\"\n            global \"import gleam/string\"\n            global \"\"\"\n                type SpiralHashKind {\n                  Sha256\n                }\n                \"\"\"\n            global \"\"\"\n                @external(erlang, \"crypto\", \"hash\")\n                fn spiral_crypto_hash(kind: SpiralHashKind, data: String) -> BitArray\n                \"\"\"\n            $'string.lowercase(bit_array.base16_encode(spiral_crypto_hash(Sha256, !input)))' : string\n        | _ => \\ () => null ()",
  timeout: 300_000
)
