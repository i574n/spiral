<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":":< rust_operators\n:< sm'_operators\n\n:! sha256 = $'System.Security.Cryptography.SHA256'\n\n:= sha256 () : sha256 =\n    $'`sha256.Create' ()\n\n:= sha256_compute_hash (x : sha256) (data : array u8) : array u8 =\n    data |> $'!x.ComputeHash'\n\n:! sha256' =\n    `(\n        rust::rust_type\n            `($'sha2_Sha256')\n            `($'sha2::Sha256')\n            \"type sha2_Sha256 = class end\"\n    )\n\n:= new_sha256 () : sha256' =\n    (!\\($'\"true; let result : sha2::Sha256 = sha2::Digest::new()\"') : bool) |> ignore\n    !\\($'\"result\"')\n\n:= hasher_update \\* el dim. (slice : rust::ref (am'::slice' el dim)) (hasher : sha256') : () =\n    (!\\($'\"true; sha2::Digest::update(&mut !hasher, !slice)\"') : bool) |> ignore\n\n:= hasher_finalize (hasher : sha256') : rust::ref (am'::slice u8) =\n    !\\($'\"&sha2::Digest::finalize(!hasher)\"')\n\n:= hash_read data : resultm::result' string stream::io_error =\n    := reader = data |> stream::new_buf_reader\n    (!\\($'\"true; let mut !reader = !reader\"') : bool) |> ignore\n    := hasher = new_sha256 ()\n    (!\\($'\"true; let mut !hasher = !hasher\"') : bool) |> ignore\n    ~>\n        := size = 1024\n        := zero = convert::convert `i32 `(convert::unativeint) 0\n        := buffer = am'::new_slice `u8 `@size 0u8\n        rust::loop 0 \\ () =>\n            := count = stream::buf_reader_read `u8 `@size buffer reader\n            := count = resultm::unwrap' `(convert::unativeint) `(stream::io_error) count\n            := _ =\n                ? (=.) `(convert::unativeint) count zero ?>\n                    rust::break `(()) ()\n                    !+\n                |: !-\n            hasher_update `u8 `@size\n                (\n                    am'::slice_range `u8 `@size\n                        (am'::Start `(convert::unativeint) zero)\n                        (am'::End `(convert::unativeint)\n                            ((\\ _ => count) : (() -> convert::unativeint) -> convert::unativeint))\n                        buffer\n                )\n                hasher\n    hasher\n    |> hasher_finalize\n    |> am'::slice_to_vec\n    |> am'::vec_map (sm'::format_hex' >> sm'::from_std_string)\n    |> am'::from_vec_base\n    |> am'::to_list_base'\n    |> listm'::unbox\n    |> sm'::concat_list (~~ \"\")\n    |> Ok\n    |> resultm::box\n\n:= get_file_hash (path : string) =\n    := path = path |> file_system::normalize_path\n    := file = path |> file_system::file_open |> resultm::unwrap'\n    := reader = file |> stream::new_buf_reader\n    reader\n    |> hash_read","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  :< rust_operators
  :< sm'_operators

  :! sha256 = $'System.Security.Cryptography.SHA256'

  := sha256 () : sha256 =
      $'`sha256.Create' ()

  := sha256_compute_hash (x : sha256) (data : array u8) : array u8 =
      data |> $'!x.ComputeHash'

  :! sha256' =
      `(
          rust::rust_type
              `($'sha2_Sha256')
              `($'sha2::Sha256')
              "type sha2_Sha256 = class end"
      )

  := new_sha256 () : sha256' =
      (!\($'"true; let result : sha2::Sha256 = sha2::Digest::new()"') : bool) |> ignore
      !\($'"result"')

  := hasher_update \* el dim. (slice : rust::ref (am'::slice' el dim)) (hasher : sha256') : () =
      (!\($'"true; sha2::Digest::update(&mut !hasher, !slice)"') : bool) |> ignore

  := hasher_finalize (hasher : sha256') : rust::ref (am'::slice u8) =
      !\($'"&sha2::Digest::finalize(!hasher)"')

  := hash_read data : resultm::result' string stream::io_error =
      := reader = data |> stream::new_buf_reader
      (!\($'"true; let mut !reader = !reader"') : bool) |> ignore
      := hasher = new_sha256 ()
      (!\($'"true; let mut !hasher = !hasher"') : bool) |> ignore
      ~>
          := size = 1024
          := zero = convert::convert `i32 `(convert::unativeint) 0
          := buffer = am'::new_slice `u8 `@size 0u8
          rust::loop 0 \ () =>
              := count = stream::buf_reader_read `u8 `@size buffer reader
              := count = resultm::unwrap' `(convert::unativeint) `(stream::io_error) count
              := _ =
                  ? (=.) `(convert::unativeint) count zero ?>
                      rust::break `(()) ()
                      !+
                  |: !-
              hasher_update `u8 `@size
                  (
                      am'::slice_range `u8 `@size
                          (am'::Start `(convert::unativeint) zero)
                          (am'::End `(convert::unativeint)
                              ((\ _ => count) : (() -> convert::unativeint) -> convert::unativeint))
                          buffer
                  )
                  hasher
      hasher
      |> hasher_finalize
      |> am'::slice_to_vec
      |> am'::vec_map (sm'::format_hex' >> sm'::from_std_string)
      |> am'::from_vec_base
      |> am'::to_list_base'
      |> listm'::unbox
      |> sm'::concat_list (~~ "")
      |> Ok
      |> resultm::box

  := get_file_hash (path : string) =
      := path = path |> file_system::normalize_path
      := file = path |> file_system::file_open |> resultm::unwrap'
      := reader = file |> stream::new_buf_reader
      reader
      |> hash_read
  """,
  timeout: 300_000
)
```

#### get_file_hash_2 (test)

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":"///- --test --symbol\n///> rust -d chrono regex sha2\n\n:= file_name = ~~ \"test.txt\"\n:= text = \"\\n\"\n\n:= temp_dir, disposable =\n    #?*(file_name, text)\n    |> crypto::hash_text\n    |> file_system::create_temp_directory'\ndisposable |> use |> ignore\n\n:= path = temp_dir </> file_name\ntext |> file_system::write_all_text path\n\npath\n|> get_file_hash\n|> resultm::unwrap'\n|> _assert_eq \"01ba4719c80b6fe911b091a7c05124b64eeece964e09c058ef8f9805daca546b\"","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  ///- --test --symbol
  ///> rust -d chrono regex sha2

  := file_name = ~~ "test.txt"
  := text = "\n"

  := temp_dir, disposable =
      #?*(file_name, text)
      |> crypto::hash_text
      |> file_system::create_temp_directory'
  disposable |> use |> ignore

  := path = temp_dir </> file_name
  text |> file_system::write_all_text path

  path
  |> get_file_hash
  |> resultm::unwrap'
  |> _assert_eq "01ba4719c80b6fe911b091a7c05124b64eeece964e09c058ef8f9805daca546b"
  """,
  timeout: 300_000
)
```

#### get_file_hash_3 (test)

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":"///- --test --symbol\n///> rust -d chrono regex sha2\n\n:= file_name = ~~ \"test.txt\"\n:= text = \"\"\n\n:= temp_dir, disposable =\n    #?*(file_name, text)\n    |> crypto::hash_text\n    |> file_system::create_temp_directory'\ndisposable |> use |> ignore\n\n:= path = temp_dir </> file_name\ntext |> file_system::write_all_text path\npath\n|> get_file_hash\n|> resultm::unwrap'\n|> _assert_eq \"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855\"","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  ///- --test --symbol
  ///> rust -d chrono regex sha2

  := file_name = ~~ "test.txt"
  := text = ""

  := temp_dir, disposable =
      #?*(file_name, text)
      |> crypto::hash_text
      |> file_system::create_temp_directory'
  disposable |> use |> ignore

  := path = temp_dir </> file_name
  text |> file_system::write_all_text path
  path
  |> get_file_hash
  |> resultm::unwrap'
  |> _assert_eq "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"
  """,
  timeout: 300_000
)
```

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":":= create_hash (x : string) : any =\n    global \"import * as spiral_node_crypto from 'node:crypto';\"\n    $'spiral_node_crypto.createHash(!x)' : any\n\n:= hash_update (s : string) (x : any) : any =\n    $'!x.update(!s, \"utf8\")' : any\n\n:= hash_digest (s : string) (x : any) : string =\n    $'!x.digest(!s)' : string\n\n:! py_sha256 = any\n\n:= hashlib_sha256 () : py_sha256 =\n    backend_switch {\n        Python = \\ () =>\n            global \"import hashlib\"\n            $'hashlib.sha256()' : py_sha256\n    }\n\n:= sha256_update (x : string) (sha256 : py_sha256) : py_sha256 =\n    backend_switch {\n        Python = \\ () =>\n            $'!sha256.update(!x)' : ()\n    }\n    sha256\n\n:= sha256_hexdigest (sha256 : py_sha256) : string =\n    backend_switch {\n        Python = \\ () =>\n            $'!sha256.hexdigest()' : string\n    }\n\n:= zig_sha256_hex (input : string) : string =\n    global \"\"\"\n        fn spiral_out_sha256_hex(input: []const u8) []const u8 {\n            var digest: [32]u8 = undefined;\n            std.crypto.hash.sha2.Sha256.hash(input, &digest, .{});\n            const hex = std.fmt.bytesToHex(digest, .lower);\n            return spiral_gpa.dupe(u8, &hex) catch @panic(\"out of memory\");\n        }\n        \"\"\"\n    $'spiral_out_sha256_hex(!input)' : string","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ":= create_hash (x : string) : any =\n    global \"import * as spiral_node_crypto from 'node:crypto';\"\n    $'spiral_node_crypto.createHash(!x)' : any\n\n:= hash_update (s : string) (x : any) : any =\n    $'!x.update(!s, \"utf8\")' : any\n\n:= hash_digest (s : string) (x : any) : string =\n    $'!x.digest(!s)' : string\n\n:! py_sha256 = any\n\n:= hashlib_sha256 () : py_sha256 =\n    backend_switch {\n        Python = \\ () =>\n            global \"import hashlib\"\n            $'hashlib.sha256()' : py_sha256\n    }\n\n:= sha256_update (x : string) (sha256 : py_sha256) : py_sha256 =\n    backend_switch {\n        Python = \\ () =>\n            $'!sha256.update(!x)' : ()\n    }\n    sha256\n\n:= sha256_hexdigest (sha256 : py_sha256) : string =\n    backend_switch {\n        Python = \\ () =>\n            $'!sha256.hexdigest()' : string\n    }\n\n:= zig_sha256_hex (input : string) : string =\n    global \"\"\"\n        fn spiral_out_sha256_hex(input: []const u8) []const u8 {\n            var digest: [32]u8 = undefined;\n            std.crypto.hash.sha2.Sha256.hash(input, &digest, .{});\n            const hex = std.fmt.bytesToHex(digest, .lower);\n            return spiral_gpa.dupe(u8, &hex) catch @panic(\"out of memory\");\n        }\n        \"\"\"\n    $'spiral_out_sha256_hex(!input)' : string",
  timeout: 300_000
)
```

