/// # csv
test csv static =
    :< testing

:< sm'_operators

/// ### csv_line_as_tsv
:~ ^ quoted_as_tsv (segments : array string) (at : i32) (count : i32) (acc : string) : string =
    ? at >= count ?> acc
    |:
        := segment = am'.index at segments
        := piece =
            ? at % 2i32 = 1i32 ?> segment |> sm'.replace "\t" " " |> sm'.replace "\r" " " |> sm'.replace "\n" " "
            |? segment = "" && at > 0i32 && at < count - 1i32 ?> "\""
            |: segment |> sm'.replace "\t" " " |> sm'.replace "," "\t"
        quoted_as_tsv segments (at + 1i32) count (acc ++# piece)

:~ csv_line_as_tsv (line : string) : string =
    := segments = sm'.split "\"" line |> array
    quoted_as_tsv segments 0i32 (am'.length segments) ""

///> rust
///> fsharp
test quoted_csv_cells_become_tab_separated =
    csv_line_as_tsv "\"Round\",\"Mode\",3" |> _assert_eq "Round\tMode\t3"
    csv_line_as_tsv "a,\"b,c\",\"say \"\"hi\"\"\"" |> _assert_eq "a\tb,c\tsay \"hi\""
    csv_line_as_tsv "x,,y" |> _assert_eq "x\t\ty"
    csv_line_as_tsv "x,\"\",y" |> _assert_eq "x\t\ty"
    csv_line_as_tsv "" |> _assert_eq ""

///> rust
///> fsharp
test non_ascii_and_tabs_inside_cells_keep_the_columns =
    csv_line_as_tsv "\"Ação\",x" |> _assert_eq "Ação\tx"
    csv_line_as_tsv "\"a\tb\",c" |> _assert_eq "a b\tc"
    csv_line_as_tsv "é,\"ü\"" |> _assert_eq "é\tü"
    csv_line_as_tsv "x,\"a,b" |> _assert_eq "x\ta,b"
