### time_span_format

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"inl time_span_format (format : string) (time_span : time_span) : string =\n    run_target_args (fun () => format, time_span) function\n        | TypeScript _ => fun format, time_span =>\n            $'!time_span.ToString (\"c\", System.Globalization.CultureInfo.InvariantCulture)'\n        | Rust => fun format, time_span =>\n            // Rust: \"\"/\"c\" -> .NET's constant format [-][d.]hh:mm:ss[.fffffff]; otherwise the hh, mm and ss\n            // tokens of a .NET custom format.\n            $'{ let t = !time_span; let f: &str = &(!format); let neg = t < chrono::TimeDelta::zero(); let a = if neg { -t } else { t }; let n = a.num_seconds() * 10000000 + (a - chrono::TimeDelta::seconds(a.num_seconds())).num_nanoseconds().unwrap() / 100; let (d, h, m, s, x) = (n / 864000000000, (n / 36000000000) % 24, (n / 600000000) % 60, (n / 10000000) % 60, n % 10000000); if f.is_empty() || f == \"c\" { Rc::<str>::from(format\\!(\"{}{}{:02}:{:02}:{:02}{}\", if neg { \"-\" } else { \"\" }, if d > 0 { format\\!(\"{}.\", d) } else { std::string::String::new() }, h, m, s, if x > 0 { format\\!(\".{:07}\", x) } else { std::string::String::new() })) } else { Rc::<str>::from(f.replace(\"hh\", &format\\!(\"{:02}\", h)).replace(\"mm\", &format\\!(\"{:02}\", m)).replace(\"ss\", &format\\!(\"{:02}\", s))) } }' : string\n        | _ => fun format, time_span =>\n            backend_switch {\n                Gleam = fun () =>\n                    global \"import tempo/datetime\"\n                    inl tempo_date_time : tempo_date_time =\n                        time_span\n                        |> $'duration.seconds'\n                        |> fun x => x : duration_gleam\n                        |> $'datetime.from_duration'\n                    inl format =\n                        if format = \"\"\n                        then \"c\"\n                        else format\n                    $'!tempo_date_time |> datetime.format(tempo.Custom(!format))' : string\n                Lua = fun () =>\n                    inl total_seconds = time_span |> convert.unbox : f64\n                    inl hours = total_seconds / 3600\n                    inl minutes = (total_seconds % 3600) / 60\n                    inl seconds = total_seconds % 60\n                    inl result =\n                        sm'.pad_left 2 '0' #?hours\n                        ++# \":\"\n                        ++# sm'.pad_left 2 '0' #?minutes\n                        ++# \":\"\n                        ++# sm'.pad_left 2 '0' #?seconds\n                    inl ms = time_span |> milliseconds\n                    if ms <= 0\n                    then result\n                    else\n                        inl ms =\n                            #?**ms\n                            |> sm'.pad_left 3 '0'\n                            |> sm'.pad_right 7 '0'\n                        result ++# ms\n                Fsharp = fun () => $'!time_span.ToString !format ' : string\n                Python = fun () =>\n                    inl date = $'!time_span + !(min_value ())' : date_time\n                    inl time = $'!date.strftime(\"%H:%M:%S\")' : string\n                    inl days = time_span |> days\n                    inl result =\n                        if days <= 0\n                        then time\n                        else #?**days ++# time\n                    inl ms = time_span |> milliseconds\n                    if ms <= 0\n                    then result\n                    else\n                        inl ms =\n                            #?**ms\n                            |> sm'.pad_left 3 '0'\n                            |> sm'.pad_right 7 '0'\n                        result ++# ms\n            }","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  inl time_span_format (format : string) (time_span : time_span) : string =
      run_target_args (fun () => format, time_span) function
          | TypeScript _ => fun format, time_span =>
              $'!time_span.ToString ("c", System.Globalization.CultureInfo.InvariantCulture)'
          | Rust => fun format, time_span =>
              // Rust: ""/"c" -> .NET's constant format [-][d.]hh:mm:ss[.fffffff]; otherwise the hh, mm and ss
              // tokens of a .NET custom format.
              $'{ let t = !time_span; let f: &str = &(!format); let neg = t < chrono::TimeDelta::zero(); let a = if neg { -t } else { t }; let n = a.num_seconds() * 10000000 + (a - chrono::TimeDelta::seconds(a.num_seconds())).num_nanoseconds().unwrap() / 100; let (d, h, m, s, x) = (n / 864000000000, (n / 36000000000) % 24, (n / 600000000) % 60, (n / 10000000) % 60, n % 10000000); if f.is_empty() || f == "c" { Rc::<str>::from(format\!("{}{}{:02}:{:02}:{:02}{}", if neg { "-" } else { "" }, if d > 0 { format\!("{}.", d) } else { std::string::String::new() }, h, m, s, if x > 0 { format\!(".{:07}", x) } else { std::string::String::new() })) } else { Rc::<str>::from(f.replace("hh", &format\!("{:02}", h)).replace("mm", &format\!("{:02}", m)).replace("ss", &format\!("{:02}", s))) } }' : string
          | _ => fun format, time_span =>
              backend_switch {
                  Gleam = fun () =>
                      global "import tempo/datetime"
                      inl tempo_date_time : tempo_date_time =
                          time_span
                          |> $'duration.seconds'
                          |> fun x => x : duration_gleam
                          |> $'datetime.from_duration'
                      inl format =
                          if format = ""
                          then "c"
                          else format
                      $'!tempo_date_time |> datetime.format(tempo.Custom(!format))' : string
                  Lua = fun () =>
                      inl total_seconds = time_span |> convert.unbox : f64
                      inl hours = total_seconds / 3600
                      inl minutes = (total_seconds % 3600) / 60
                      inl seconds = total_seconds % 60
                      inl result =
                          sm'.pad_left 2 '0' #?hours
                          ++# ":"
                          ++# sm'.pad_left 2 '0' #?minutes
                          ++# ":"
                          ++# sm'.pad_left 2 '0' #?seconds
                      inl ms = time_span |> milliseconds
                      if ms <= 0
                      then result
                      else
                          inl ms =
                              #?**ms
                              |> sm'.pad_left 3 '0'
                              |> sm'.pad_right 7 '0'
                          result ++# ms
                  Fsharp = fun () => $'!time_span.ToString !format ' : string
                  Python = fun () =>
                      inl date = $'!time_span + !(min_value ())' : date_time
                      inl time = $'!date.strftime("%H:%M:%S")' : string
                      inl days = time_span |> days
                      inl result =
                          if days <= 0
                          then time
                          else #?**days ++# time
                      inl ms = time_span |> milliseconds
                      if ms <= 0
                      then result
                      else
                          inl ms =
                              #?**ms
                              |> sm'.pad_left 3 '0'
                              |> sm'.pad_right 7 '0'
                          result ++# ms
              }
  """,
  timeout: 300_000
)
```

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"///- --test\n///> fsharp\n///> cuda\n///> rust -d chrono\n///> typescript\n\n(join date_time_milliseconds 2002 2 2 20 22 24 26)\n|> new_time_span (date_time_milliseconds 2001 1 1 10 11 12 13)\n|> time_span_format \"c\"\n|> _assert_eq (backend_switch {\n    Fsharp = fun () => \"397.10:11:12.0130000\"\n    Python = fun () => \"39710:11:120130000\"\n    Rust = fun () => \"397.10:11:12.0130000\"\n})","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  ///- --test
  ///> fsharp
  ///> cuda
  ///> rust -d chrono
  ///> typescript

  (join date_time_milliseconds 2002 2 2 20 22 24 26)
  |> new_time_span (date_time_milliseconds 2001 1 1 10 11 12 13)
  |> time_span_format "c"
  |> _assert_eq (backend_switch {
      Fsharp = fun () => "397.10:11:12.0130000"
      Python = fun () => "39710:11:120130000"
      Rust = fun () => "397.10:11:12.0130000"
  })
  """,
  timeout: 300_000
)
