### specify_date_kind

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"inl specify_date_kind (kind : date_time_kind) (date_time : date_time) : date_time =\n    backend_switch {\n        Gleam = fun () => date_time\n        Lua = fun () => date_time\n        Fsharp = fun () =>\n            inl kind : $'System.DateTimeKind' =\n                match kind with\n                | Unspecified => $'System.DateTimeKind.Unspecified'\n                | Utc => $'System.DateTimeKind.Utc'\n                | Local => $'System.DateTimeKind.Local'\n            $'System.DateTime.SpecifyKind (!date_time, !kind)' : date_time\n        Python = fun () => $'!date_time.replace(tzinfo=None)' : date_time\n        // Rust: a chrono::NaiveDateTime carries no kind; the value is unchanged.\n        Rust = fun () => date_time\n    }","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  inl specify_date_kind (kind : date_time_kind) (date_time : date_time) : date_time =
      backend_switch {
          Gleam = fun () => date_time
          Lua = fun () => date_time
          Fsharp = fun () =>
              inl kind : $'System.DateTimeKind' =
                  match kind with
                  | Unspecified => $'System.DateTimeKind.Unspecified'
                  | Utc => $'System.DateTimeKind.Utc'
                  | Local => $'System.DateTimeKind.Local'
              $'System.DateTime.SpecifyKind (!date_time, !kind)' : date_time
          Python = fun () => $'!date_time.replace(tzinfo=None)' : date_time
          // Rust: a chrono::NaiveDateTime carries no kind; the value is unchanged.
          Rust = fun () => date_time
      }
  """,
  timeout: 300_000
)
```

### to_universal_time

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"inl to_universal_time (date_time : date_time) : date_time =\n    backend_switch {\n        Gleam = fun () => date_time\n        Lua = fun () => date_time\n        Fsharp = fun () => date_time |> $'_.ToUniversalTime()' : date_time\n        Python = fun () =>\n            global \"import datetime\"\n            $'!date_time.replace(tzinfo=datetime.timezone.utc)' : date_time\n        // Rust: like Python, the wall-clock value is kept (a NaiveDateTime has no kind to convert from).\n        Rust = fun () => date_time\n    }","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  inl to_universal_time (date_time : date_time) : date_time =
      backend_switch {
          Gleam = fun () => date_time
          Lua = fun () => date_time
          Fsharp = fun () => date_time |> $'_.ToUniversalTime()' : date_time
          Python = fun () =>
              global "import datetime"
              $'!date_time.replace(tzinfo=datetime.timezone.utc)' : date_time
          // Rust: like Python, the wall-clock value is kept (a NaiveDateTime has no kind to convert from).
          Rust = fun () => date_time
      }
  """,
  timeout: 300_000
)
```

