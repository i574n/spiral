  inl to_calendar (timestamp : timestamp) : date_time =
      backend_switch {
          Gleam = fun () =>
              global "import gleam/time/timestamp"
              global "import gleam/time/calendar"
      }
      inl duration = $'calendar.local_offset()' : duration_gleam
