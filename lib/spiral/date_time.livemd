### add_days

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"inl add_days (days : i32) (date_time : date_time) : date_time =\n    backend_switch {\n        Gleam = fun () =>\n            global \"import gleam/time/duration\"\n            inl duration : duration_gleam = $'duration.days(#days)' : duration_gleam\n            inl (date : date_gleam), (time_of_day : time_of_day_gleam), (existing_duration : duration_gleam) =\n                date_time |> split_date_time\n            inl new_duration : duration_gleam = $'!existing_duration + !duration '\n            (date, time_of_day, new_duration) |> convert.to : date_time\n        Lua = fun () =>\n            inl seconds = days * 86400\n            (date_time |> convert.unbox) + seconds |> convert.unbox : date_time\n        Fsharp = fun () =>\n            $'!date_time.AddDays' days : date_time\n        Python = fun () =>\n            global \"import datetime\"\n            $'!date_time + datetime.timedelta(days=!days)' : date_time\n        Rust = fun () => $'!date_time + chrono::TimeDelta::days(!days as i64)' : date_time\n    }","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  inl add_days (days : i32) (date_time : date_time) : date_time =
      backend_switch {
          Gleam = fun () =>
              global "import gleam/time/duration"
              inl duration : duration_gleam = $'duration.days(#days)' : duration_gleam
              inl (date : date_gleam), (time_of_day : time_of_day_gleam), (existing_duration : duration_gleam) =
                  date_time |> split_date_time
              inl new_duration : duration_gleam = $'!existing_duration + !duration '
              (date, time_of_day, new_duration) |> convert.to : date_time
          Lua = fun () =>
              inl seconds = days * 86400
              (date_time |> convert.unbox) + seconds |> convert.unbox : date_time
          Fsharp = fun () =>
              $'!date_time.AddDays' days : date_time
          Python = fun () =>
              global "import datetime"
              $'!date_time + datetime.timedelta(days=!days)' : date_time
          Rust = fun () => $'!date_time + chrono::TimeDelta::days(!days as i64)' : date_time
      }
  """,
  timeout: 300_000
)
```

