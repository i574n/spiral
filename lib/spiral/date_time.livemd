### date_time_utc

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"inl date_time_utc\n    (year : int) (month : int) (day : int) (hour : int) (minute : int) (second : int)\n    : date_time\n    =\n    backend_switch {\n        Gleam = fun () =>\n            global \"import gleam/time/calendar\"\n            global \"import gleam/time/duration\"\n            global \"import gleam/time/timestamp\"\n            global \"import tempo/month\"\n            inl calendar_month : resultm.result' calendar_month () =\n                $\"!month |> month.from_int\"\n            inl calendar_month = calendar_month |> resultm.unbox |> resultm.get\n            inl date : date_gleam = $'calendar.Date(#year, #calendar_month, #day)'\n            inl time_of_day : time_of_day_gleam = $'calendar.TimeOfDay(#hour, #minute, #second, 0)'\n            inl duration : duration_gleam = $'duration.Duration(0)   ' : duration_gleam\n            (date, time_of_day, duration) |> convert.to : date_time\n        Lua = fun () =>\n            inl total_seconds = second + (minute * 60) + (hour * 3600)\n            inl date_time = $'os.time{year=!year, month=!month, day=!day, hour=0, min=0, sec=0} or 0' : int\n            date_time + total_seconds |> convert.unbox : date_time\n        Fsharp = fun () =>\n            $'System.DateTime (!year, !month, !day, !hour, !minute, !second, System.DateTimeKind.Utc)' : date_time\n        Python = fun () =>\n            global \"import datetime\"\n            $'datetime.datetime(!year, !month, !day, !hour, !minute, !second, tzinfo=datetime.timezone.utc)' : date_time\n        // Rust: a NaiveDateTime has no kind (see specify_date_kind)\n        Rust = fun () =>\n            $'chrono::NaiveDate::from_ymd_opt(!year, !month as u32, !day as u32).unwrap().and_hms_opt(!hour as u32, !minute as u32, !second as u32).unwrap()' : date_time\n    }","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  inl date_time_utc
      (year : int) (month : int) (day : int) (hour : int) (minute : int) (second : int)
      : date_time
      =
      backend_switch {
          Gleam = fun () =>
              global "import gleam/time/calendar"
              global "import gleam/time/duration"
              global "import gleam/time/timestamp"
              global "import tempo/month"
              inl calendar_month : resultm.result' calendar_month () =
                  $"!month |> month.from_int"
              inl calendar_month = calendar_month |> resultm.unbox |> resultm.get
              inl date : date_gleam = $'calendar.Date(#year, #calendar_month, #day)'
              inl time_of_day : time_of_day_gleam = $'calendar.TimeOfDay(#hour, #minute, #second, 0)'
              inl duration : duration_gleam = $'duration.Duration(0)   ' : duration_gleam
              (date, time_of_day, duration) |> convert.to : date_time
          Lua = fun () =>
              inl total_seconds = second + (minute * 60) + (hour * 3600)
              inl date_time = $'os.time{year=!year, month=!month, day=!day, hour=0, min=0, sec=0} or 0' : int
              date_time + total_seconds |> convert.unbox : date_time
          Fsharp = fun () =>
              $'System.DateTime (!year, !month, !day, !hour, !minute, !second, System.DateTimeKind.Utc)' : date_time
          Python = fun () =>
              global "import datetime"
              $'datetime.datetime(!year, !month, !day, !hour, !minute, !second, tzinfo=datetime.timezone.utc)' : date_time
          // Rust: a NaiveDateTime has no kind (see specify_date_kind)
          Rust = fun () =>
              $'chrono::NaiveDate::from_ymd_opt(!year, !month as u32, !day as u32).unwrap().and_hms_opt(!hour as u32, !minute as u32, !second as u32).unwrap()' : date_time
      }
  """,
  timeout: 300_000
)
```

