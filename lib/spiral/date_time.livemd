### time_span

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"nominal time_span_python =\n    `(\n        backend_switch `(()) `({}) {\n            Python = (fun () => global \"import datetime\") : () -> ()\n        }\n        $'' : $'datetime.timedelta'\n    )\ntype time_span_switch =\n    {\n        Gleam : $'duration.Duration'\n        Lua : $'number'\n        Fsharp : $'System.TimeSpan'\n        Python : time_span_python\n        Rust : $'chrono::TimeDelta'\n    }\nnominal time_span = $'backend_switch `(time_span_switch)'\n\ninl time_span x : time_span =\n    backend_switch {\n        Gleam = fun () => x |> convert.unbox : time_span\n        Lua = fun () => x |> convert.unbox : time_span\n        Fsharp = fun () => $'!x |> `time_span ' : time_span\n        Python = fun () =>\n            global \"import datetime\"\n            $'datetime.timedelta(!x)' : time_span\n        // Rust: x is a count of 100 ns ticks, like F#'s TimeSpan (int64)\n        Rust = fun () =>\n            $'(chrono::TimeDelta::microseconds((!x as i64) / 10) + chrono::TimeDelta::nanoseconds(((!x as i64) % 10) * 100))' : time_span\n    }","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  nominal time_span_python =
      `(
          backend_switch `(()) `({}) {
              Python = (fun () => global "import datetime") : () -> ()
          }
          $'' : $'datetime.timedelta'
      )
  type time_span_switch =
      {
          Gleam : $'duration.Duration'
          Lua : $'number'
          Fsharp : $'System.TimeSpan'
          Python : time_span_python
          Rust : $'chrono::TimeDelta'
      }
  nominal time_span = $'backend_switch `(time_span_switch)'

  inl time_span x : time_span =
      backend_switch {
          Gleam = fun () => x |> convert.unbox : time_span
          Lua = fun () => x |> convert.unbox : time_span
          Fsharp = fun () => $'!x |> `time_span ' : time_span
          Python = fun () =>
              global "import datetime"
              $'datetime.timedelta(!x)' : time_span
          // Rust: x is a count of 100 ns ticks, like F#'s TimeSpan (int64)
          Rust = fun () =>
              $'(chrono::TimeDelta::microseconds((!x as i64) / 10) + chrono::TimeDelta::nanoseconds(((!x as i64) % 10) * 100))' : time_span
      }
  """,
  timeout: 300_000
)
```

### new_time_span

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"inl new_time_span (a : date_time) (b : date_time) : time_span =\n    run_target function\n        | Gleam => fun () =>\n            inl timestamp : timestamp = a |> split_date_time |> new_timestamp_gleam\n            inl timestamp' : timestamp = b |> split_date_time |> new_timestamp_gleam\n            inl duration : duration_gleam = $'!timestamp |> timestamp.difference(!timestamp')'\n            ($'duration.to_seconds(!duration)' : float)\n            |> convert.convert\n            |> fun x => x : int\n            |> convert.convert\n        // Contracts have no clock (now () is null there): no DateTime arithmetic either.\n        | _ => fun () => $'!b - !a '","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  inl new_time_span (a : date_time) (b : date_time) : time_span =
      run_target function
          | Gleam => fun () =>
              inl timestamp : timestamp = a |> split_date_time |> new_timestamp_gleam
              inl timestamp' : timestamp = b |> split_date_time |> new_timestamp_gleam
              inl duration : duration_gleam = $'!timestamp |> timestamp.difference(!timestamp')'
              ($'duration.to_seconds(!duration)' : float)
              |> convert.convert
              |> fun x => x : int
              |> convert.convert
          // Contracts have no clock (now () is null there): no DateTime arithmetic either.
          | _ => fun () => $'!b - !a '
  """,
  timeout: 300_000
)
```

### total_seconds

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"inl total_seconds (time_span : time_span) : f64 =\n    inl n : i64 =\n        run_target function\n            | Gleam => fun () =>\n                backend_switch {\n                    Gleam = fun () => global \"import gleam/time/duration\"\n                }\n                inl duration : duration_gleam = time_span |> $'duration.seconds'\n                duration\n                |> $'duration.to_seconds'\n                |> (*) 10000000f64\n                |> convert.convert\n            | Lua => fun () =>\n                inl seconds = time_span |> convert.unbox : f64\n                seconds * 10000000 |> convert.convert : i64\n            | Cuda => fun () => $'!time_span.total_seconds() * 10000000' : i64\n            // Rust: the TimeDelta's 100 ns ticks (num_seconds truncates toward zero; the sub-second rest fits)\n            | Rust => fun () =>\n                $'{ let t = !time_span; t.num_seconds() * 10000000 + (t - chrono::TimeDelta::seconds(t.num_seconds())).num_nanoseconds().unwrap() / 100 }' : i64\n            | _ => fun () => time_span |> $'_.Ticks' : i64\n    n / 10000000 |> convert.convert","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  inl total_seconds (time_span : time_span) : f64 =
      inl n : i64 =
          run_target function
              | Gleam => fun () =>
                  backend_switch {
                      Gleam = fun () => global "import gleam/time/duration"
                  }
                  inl duration : duration_gleam = time_span |> $'duration.seconds'
                  duration
                  |> $'duration.to_seconds'
                  |> (*) 10000000f64
                  |> convert.convert
              | Lua => fun () =>
                  inl seconds = time_span |> convert.unbox : f64
                  seconds * 10000000 |> convert.convert : i64
              | Cuda => fun () => $'!time_span.total_seconds() * 10000000' : i64
              // Rust: the TimeDelta's 100 ns ticks (num_seconds truncates toward zero; the sub-second rest fits)
              | Rust => fun () =>
                  $'{ let t = !time_span; t.num_seconds() * 10000000 + (t - chrono::TimeDelta::seconds(t.num_seconds())).num_nanoseconds().unwrap() / 100 }' : i64
              | _ => fun () => time_span |> $'_.Ticks' : i64
      n / 10000000 |> convert.convert
  """,
  timeout: 300_000
)
```

### days

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"inl days (time_span : time_span) : f64 =\n    backend_switch {\n        Gleam = fun () =>\n            backend_switch {\n                Gleam = fun () => global \"import gleam/time/duration\"\n            }\n            inl duration : duration_gleam = time_span |> $'duration.seconds'\n            duration\n            |> $'duration.to_seconds'\n            |> (/) 86400f64\n        Lua = fun () =>\n            inl seconds = time_span |> convert.unbox : f64\n            seconds / 86400 |> convert.convert : f64\n        Fsharp = fun () => time_span |> $'_.TotalDays' : f64\n        Python = fun () => $'!time_span.days' : f64\n        // Rust: F#'s TotalDays (100 ns ticks / ticks per day)\n        Rust = fun () =>\n            $'{ let t = !time_span; (t.num_seconds() * 10000000 + (t - chrono::TimeDelta::seconds(t.num_seconds())).num_nanoseconds().unwrap() / 100) as f64 / 864000000000.0 }' : f64\n    }","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  inl days (time_span : time_span) : f64 =
      backend_switch {
          Gleam = fun () =>
              backend_switch {
                  Gleam = fun () => global "import gleam/time/duration"
              }
              inl duration : duration_gleam = time_span |> $'duration.seconds'
              duration
              |> $'duration.to_seconds'
              |> (/) 86400f64
          Lua = fun () =>
              inl seconds = time_span |> convert.unbox : f64
              seconds / 86400 |> convert.convert : f64
          Fsharp = fun () => time_span |> $'_.TotalDays' : f64
          Python = fun () => $'!time_span.days' : f64
          // Rust: F#'s TotalDays (100 ns ticks / ticks per day)
          Rust = fun () =>
              $'{ let t = !time_span; (t.num_seconds() * 10000000 + (t - chrono::TimeDelta::seconds(t.num_seconds())).num_nanoseconds().unwrap() / 100) as f64 / 864000000000.0 }' : f64
      }
  """,
  timeout: 300_000
)
```

### ticks

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"inl ticks (date_time : date_time) : timestamp =\n    backend_switch {\n        Gleam = fun () =>\n            date_time\n            |> new_time_span (min_value ())\n            |> total_seconds\n            |> ((*) 10000000)\n            |> convert.convert\n            |> fun x => x : int\n            |> timestamp\n        Lua = fun () =>\n            date_time\n            |> new_time_span (min_value ())\n            |> total_seconds\n            |> ((-) 14400)\n            |> ((*) -10000000)\n            |> convert.convert\n            : timestamp\n        Fsharp = fun () =>\n            date_time\n            |> new_time_span (min_value ())\n            |> total_seconds\n            |> ((*) 10000000)\n            |> convert.convert\n            : timestamp\n        Python = fun () =>\n            date_time\n            |> new_time_span (min_value ())\n            |> total_seconds\n            |> ((*) 10000000)\n            |> convert.convert\n            : timestamp\n        Rust = fun () =>\n            date_time\n            |> new_time_span (min_value ())\n            |> total_seconds\n            |> ((*) 10000000)\n            |> convert.convert\n            : timestamp\n    }","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  inl ticks (date_time : date_time) : timestamp =
      backend_switch {
          Gleam = fun () =>
              date_time
              |> new_time_span (min_value ())
              |> total_seconds
              |> ((*) 10000000)
              |> convert.convert
              |> fun x => x : int
              |> timestamp
          Lua = fun () =>
              date_time
              |> new_time_span (min_value ())
              |> total_seconds
              |> ((-) 14400)
              |> ((*) -10000000)
              |> convert.convert
              : timestamp
          Fsharp = fun () =>
              date_time
              |> new_time_span (min_value ())
              |> total_seconds
              |> ((*) 10000000)
              |> convert.convert
              : timestamp
          Python = fun () =>
              date_time
              |> new_time_span (min_value ())
              |> total_seconds
              |> ((*) 10000000)
              |> convert.convert
              : timestamp
          Rust = fun () =>
              date_time
              |> new_time_span (min_value ())
              |> total_seconds
              |> ((*) 10000000)
              |> convert.convert
              : timestamp
      }
  """,
  timeout: 300_000
)
```

