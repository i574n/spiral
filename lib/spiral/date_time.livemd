### get_utc_offset

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"inl get_utc_offset (time_zone_info : time_zone_info) (date_time : date_time) : time_span =\n    run_target function\n        | Fsharp _ => fun () => date_time |> $'_.GetUtcOffset' (time_zone_local ())\n        | Rust => fun () =>\n            $'chrono::TimeDelta::seconds(chrono::TimeZone::offset_from_local_datetime(&chrono::Local, &!date_time).earliest().map(|o| o.local_minus_utc()).unwrap_or(0) as i64)' : time_span\n        | target => fun () =>\n            backend_switch {\n                Gleam = fun () =>\n                    global \"import gleam/time/duration\"\n                    inl duration : duration_gleam = $'calendar.utc_offset()' : duration_gleam\n                    duration\n                    |> $'duration.to_seconds'\n                    |> ((*) 10000000i32)\n                    |> convert.convert\n                    |> fun x => x : int\n                    |> convert.unbox\n                    : time_span\n                Lua = fun () =>\n                    inl date_time = date_time |> convert.unbox : int\n                    inl offset = 5i32 * 3600i32\n                    offset * 10000000 |> convert.convert : time_span\n                Fsharp = fun () => failwith $'$\"date_time.get_utc_offset / target: {!target}\"' : time_span\n                Python = fun () => $'!date_time.utcoffset()' : time_span\n            }","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  inl get_utc_offset (time_zone_info : time_zone_info) (date_time : date_time) : time_span =
      run_target function
          | Fsharp _ => fun () => date_time |> $'_.GetUtcOffset' (time_zone_local ())
          | Rust => fun () =>
              $'chrono::TimeDelta::seconds(chrono::TimeZone::offset_from_local_datetime(&chrono::Local, &!date_time).earliest().map(|o| o.local_minus_utc()).unwrap_or(0) as i64)' : time_span
          | target => fun () =>
              backend_switch {
                  Gleam = fun () =>
                      global "import gleam/time/duration"
                      inl duration : duration_gleam = $'calendar.utc_offset()' : duration_gleam
                      duration
                      |> $'duration.to_seconds'
                      |> ((*) 10000000i32)
                      |> convert.convert
                      |> fun x => x : int
                      |> convert.unbox
                      : time_span
                  Lua = fun () =>
                      inl date_time = date_time |> convert.unbox : int
                      inl offset = 5i32 * 3600i32
                      offset * 10000000 |> convert.convert : time_span
                  Fsharp = fun () => failwith $'$"date_time.get_utc_offset / target: {!target}"' : time_span
                  Python = fun () => $'!date_time.utcoffset()' : time_span
              }
  """,
  timeout: 300_000
)
```

### date_time_guid_from_date_time

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"let date_time_guid_from_date_time (guid' : guid.guid) (date_time : date_time) =\n    inl create prefix time_zone : date_time_guid =\n        inl guid_range =\n            guid'\n            |> sm'.obj_to_string\n            |> sm'.range\n                (am'.Start (##prefix + ##time_zone))\n                (am'.End eval)\n        prefix ++# time_zone ++# guid_range |> guid.new_guid\n    run_target function\n        | Rust => fun () =>\n            // The layout: yyyyMMdd-HHmm-ss + 7 consecutive fraction digits split 2-4-1, then the\n            // utc offset sign and hhmm.\n            inl prefix : string =\n                $'{ let s = !date_time.format(\"%Y%m%d-%H%M-%S%f\").to_string(); Rc::<str>::from(format\\!(\"{}-{}-{}\", &s[0..18], &s[18..22], &s[22..23])) }'\n            inl time_zone = date_time |> get_utc_offset (time_zone_local ())\n            inl time_zone_signal = if hours time_zone > 0 then 1u8 else 0\n            inl time_zone_value = time_zone |> time_span_format (join \"hhmm\")\n            inl time_zone = #?time_zone_signal ++# time_zone_value\n            create prefix time_zone\n        | target => fun () =>\n            inl prefix = date_time |> format (join \"yyyyMMdd-HHmm-ssff-ffff-f\")\n            inl time_zone = date_time |> get_utc_offset (time_zone_local ())\n            inl time_zone_signal = if hours time_zone > 0 then 1u8 else 0\n            inl time_zone_value = time_zone |> time_span_format (join \"hhmm\")\n            inl time_zone = #?time_zone_signal ++# time_zone_value\n            create prefix time_zone","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  let date_time_guid_from_date_time (guid' : guid.guid) (date_time : date_time) =
      inl create prefix time_zone : date_time_guid =
          inl guid_range =
              guid'
              |> sm'.obj_to_string
              |> sm'.range
                  (am'.Start (##prefix + ##time_zone))
                  (am'.End eval)
          prefix ++# time_zone ++# guid_range |> guid.new_guid
      run_target function
          | Rust => fun () =>
              // The layout: yyyyMMdd-HHmm-ss + 7 consecutive fraction digits split 2-4-1, then the
              // utc offset sign and hhmm.
              inl prefix : string =
                  $'{ let s = !date_time.format("%Y%m%d-%H%M-%S%f").to_string(); Rc::<str>::from(format\!("{}-{}-{}", &s[0..18], &s[18..22], &s[22..23])) }'
              inl time_zone = date_time |> get_utc_offset (time_zone_local ())
              inl time_zone_signal = if hours time_zone > 0 then 1u8 else 0
              inl time_zone_value = time_zone |> time_span_format (join "hhmm")
              inl time_zone = #?time_zone_signal ++# time_zone_value
              create prefix time_zone
          | target => fun () =>
              inl prefix = date_time |> format (join "yyyyMMdd-HHmm-ssff-ffff-f")
              inl time_zone = date_time |> get_utc_offset (time_zone_local ())
              inl time_zone_signal = if hours time_zone > 0 then 1u8 else 0
              inl time_zone_value = time_zone |> time_span_format (join "hhmm")
              inl time_zone = #?time_zone_signal ++# time_zone_value
              create prefix time_zone
  """,
  timeout: 300_000
)
```

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"///- --test\n///> fsharp\n////> cuda\n///> rust -d chrono\n\ninl suffix = test_guid () |> sm'.obj_to_string |> sm'.range (am'.End fun x => x () - 6i32) (am'.End eval)\nunix_epoch ()\n|> specify_date_kind Utc\n|> to_universal_time\n|> date_time_guid_from_date_time (test_guid ())\n|> sm'.obj_to_string\n|> fun s => s |> _assert_eq' ((s |> sm'.slice 0i32 29) ++# suffix)","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
