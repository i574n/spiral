### new_timestamp_gleam

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"inl new_timestamp_gleam\n    (date, time_of_day, duration : date_gleam * time_of_day_gleam * duration_gleam)\n    : timestamp\n    =\n    global \"import gleam/time/timestamp\"\n    inl result : timestamp = $'timestamp.from_calendar(!date, !time_of_day, !duration)'\n\n    global \"import tempo/datetime\"\n    inl tempo_date_time : tempo_date_time =\n        result |> $'datetime.from_timestamp'\n    inl tempo_date_time : tempo_date_time = $'!tempo_date_time |> datetime.add(!duration)'\n    tempo_date_time |> $'datetime.to_timestamp'","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  inl new_timestamp_gleam
      (date, time_of_day, duration : date_gleam * time_of_day_gleam * duration_gleam)
      : timestamp
      =
      global "import gleam/time/timestamp"
      inl result : timestamp = $'timestamp.from_calendar(!date, !time_of_day, !duration)'

      global "import tempo/datetime"
      inl tempo_date_time : tempo_date_time =
          result |> $'datetime.from_timestamp'
      inl tempo_date_time : tempo_date_time = $'!tempo_date_time |> datetime.add(!duration)'
      tempo_date_time |> $'datetime.to_timestamp'
  """,
  timeout: 300_000
)
```

### format

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"inl format (format : string) (date_time : date_time) : string =\n    backend_switch {\n        Gleam = fun () =>\n            global \"import tempo/datetime\"\n            inl tempo_date_time : tempo_date_time =\n                date_time |> split_date_time |> new_timestamp_gleam |> $'datetime.from_timestamp'\n            // inl tempo_date_time : tempo_date_time = $'!tempo_date_time |> datetime.add(!duration)'\n            inl format =\n                if format = \"\"\n                then \"M-D-YY hh:mm:ss A\"\n                else format\n            $'!tempo_date_time |> datetime.format(tempo.Custom(!format))' : string\n            // #?{ date_time format date time_of_day duration timestamp tempo_date_time }\n        Lua = fun () =>\n            inl date_time = join date_time\n            if format <> \"\"\n            then $'os.date(!format, !date_time)' : string\n            else\n                inl date =\n                    if get_year date_time < 1000\n                    then $'(os.date(\"%m-%d-%y\", !date_time) or \"\"):gsub(\"0(%d)\", \"%1\")' : string\n                    else $'(os.date(\"%m-%d-%Y\", !date_time) or \"\"):gsub(\"0(%d)\", \"%1\")' : string\n                inl time =\n                    $'os.date(\"%I:%M:%S %p\", !date_time) or \"\"' : string\n                date ++# \" \" ++# time\n        Fsharp = fun () =>\n            inl format =\n                if format = \"\"\n                then \"M-d-y hh:mm:ss tt\"\n                else format\n            $'!date_time.ToString' format : string\n        Python = fun () =>\n            inl date_time = join date_time\n            if format <> \"\"\n            then $'!date_time.strftime(!format)' : string\n            elif get_year date_time < 1000\n            then $'\\'{dt.month}-{dt.day}-{dt.year} {dt:%I}:{dt:%M}:{dt:%S} {dt:%p}\\'.format(dt=!date_time)' : string\n            else $'\\'{dt.month}-{dt.day}-{dt:%y} {dt:%I}:{dt:%M}:{dt:%S} {dt:%p}\\'.format(dt=!date_time)' : string\n        // Rust: like Lua/Python, a non-empty format is a strftime (chrono) format. The default is F#'s\n        // \"M-d-y hh:mm:ss tt\" (`y`: the year mod 100, unpadded).\n        Rust = fun () =>\n            inl format =\n                if format = \"\"\n                then \"%-m-%-d-%-y %I:%M:%S %p\"\n                else format\n            $'Rc::<str>::from(!date_time.format(&*!format).to_string())' : string\n    }","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  inl format (format : string) (date_time : date_time) : string =
      backend_switch {
          Gleam = fun () =>
              global "import tempo/datetime"
              inl tempo_date_time : tempo_date_time =
                  date_time |> split_date_time |> new_timestamp_gleam |> $'datetime.from_timestamp'
              // inl tempo_date_time : tempo_date_time = $'!tempo_date_time |> datetime.add(!duration)'
              inl format =
                  if format = ""
                  then "M-D-YY hh:mm:ss A"
                  else format
              $'!tempo_date_time |> datetime.format(tempo.Custom(!format))' : string
              // #?{ date_time format date time_of_day duration timestamp tempo_date_time }
          Lua = fun () =>
              inl date_time = join date_time
              if format <> ""
              then $'os.date(!format, !date_time)' : string
              else
                  inl date =
                      if get_year date_time < 1000
                      then $'(os.date("%m-%d-%y", !date_time) or ""):gsub("0(%d)", "%1")' : string
                      else $'(os.date("%m-%d-%Y", !date_time) or ""):gsub("0(%d)", "%1")' : string
                  inl time =
                      $'os.date("%I:%M:%S %p", !date_time) or ""' : string
                  date ++# " " ++# time
          Fsharp = fun () =>
              inl format =
                  if format = ""
                  then "M-d-y hh:mm:ss tt"
                  else format
              $'!date_time.ToString' format : string
          Python = fun () =>
              inl date_time = join date_time
              if format <> ""
              then $'!date_time.strftime(!format)' : string
              elif get_year date_time < 1000
              then $'\'{dt.month}-{dt.day}-{dt.year} {dt:%I}:{dt:%M}:{dt:%S} {dt:%p}\'.format(dt=!date_time)' : string
              else $'\'{dt.month}-{dt.day}-{dt:%y} {dt:%I}:{dt:%M}:{dt:%S} {dt:%p}\'.format(dt=!date_time)' : string
          // Rust: like Lua/Python, a non-empty format is a strftime (chrono) format. The default is F#'s
          // "M-d-y hh:mm:ss tt" (`y`: the year mod 100, unpadded).
          Rust = fun () =>
              inl format =
                  if format = ""
                  then "%-m-%-d-%-y %I:%M:%S %p"
                  else format
              $'Rc::<str>::from(!date_time.format(&*!format).to_string())' : string
      }
  """,
  timeout: 300_000
)
```

