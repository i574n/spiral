## date_time

<!-- livebook:{"break_markdown":true} -->

### timestamp

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"nominal timestamp_gleam =\n    `(\n        backend_switch `(()) `({}) {\n            Gleam = (fun () => global \"import gleam/time/timestamp\") : () -> ()\n        }\n        $'' : $'timestamp.Timestamp'\n    )\nnominal timestamp_python =\n    `(\n        backend_switch `(()) `({}) {\n            Python = (fun () => global \"import datetime\") : () -> ()\n        }\n        $'' : i64\n    )\ntype timestamp_switch =\n    {\n        Gleam : timestamp_gleam\n        Lua : i64\n        Fsharp : i64\n        Python : timestamp_python\n        Rust : i64\n    }\nnominal timestamp = $'backend_switch `(timestamp_switch)'\n\ninl timestamp forall t {int}. (x : t) : timestamp =\n    run_target function\n        | Gleam => fun () =>\n            backend_switch {\n                Gleam = fun () => global \"import gleam/time/timestamp\"\n            }\n            x |> $'timestamp.from_unix_seconds'\n        | Rust => fun () => $'(!x as i64)'\n        | _ => fun () => x |> convert.unbox","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  nominal timestamp_gleam =
      `(
          backend_switch `(()) `({}) {
              Gleam = (fun () => global "import gleam/time/timestamp") : () -> ()
          }
          $'' : $'timestamp.Timestamp'
      )
  nominal timestamp_python =
      `(
          backend_switch `(()) `({}) {
              Python = (fun () => global "import datetime") : () -> ()
          }
          $'' : i64
      )
  type timestamp_switch =
      {
          Gleam : timestamp_gleam
          Lua : i64
          Fsharp : i64
          Python : timestamp_python
          Rust : i64
      }
  nominal timestamp = $'backend_switch `(timestamp_switch)'

  inl timestamp forall t {int}. (x : t) : timestamp =
      run_target function
          | Gleam => fun () =>
              backend_switch {
                  Gleam = fun () => global "import gleam/time/timestamp"
              }
              x |> $'timestamp.from_unix_seconds'
          | Rust => fun () => $'(!x as i64)'
          | _ => fun () => x |> convert.unbox
  """,
  timeout: 300_000
)
```

