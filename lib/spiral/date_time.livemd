<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"inl to_calendar_utc (timestamp : timestamp) : date_time =\n    backend_switch {\n        Gleam = fun () =>\n            global \"import gleam/time/calendar\"\n            global \"import gleam/time/timestamp\"\n    }\n    inl duration = $'calendar.utc_offset' : duration_gleam\n    inl (date : date_gleam), (time_of_day : time_of_day_gleam) = $'!timestamp |> timestamp.to_calendar(!duration)'\n    (date, time_of_day, duration) |> convert.to","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  inl to_calendar_utc (timestamp : timestamp) : date_time =
      backend_switch {
          Gleam = fun () =>
              global "import gleam/time/calendar"
              global "import gleam/time/timestamp"
      }
      inl duration = $'calendar.utc_offset' : duration_gleam
      inl (date : date_gleam), (time_of_day : time_of_day_gleam) = $'!timestamp |> timestamp.to_calendar(!duration)'
      (date, time_of_day, duration) |> convert.to
  """,
  timeout: 300_000
)
