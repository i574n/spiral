### date_time

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"nominal date_gleam =\n    `(\n        backend_switch `(()) `({}) {\n            Gleam = (fun () =>\n                global \"import gleam/time/calendar\"\n                        ) : () -> ()\n        }\n        $'' : $'calendar.Date'\n    )\nnominal time_of_day_gleam =\n    `(\n        backend_switch `(()) `({}) {\n            Gleam = (fun () =>\n                global \"import gleam/time/calendar\"\n                        ) : () -> ()\n        }\n        $'' : $'calendar.TimeOfDay'\n    )\nnominal duration_gleam =\n    `(\n        backend_switch `(()) `({}) {\n            Gleam = (fun () =>\n                global \"import gleam/time/duration\"\n                        ) : () -> ()\n        }\n        $'' : $'duration.Duration'\n    )\n\nnominal date_time_python =\n    `(\n        backend_switch `(()) `({}) {\n            Python = (fun () => global \"import datetime\") : () -> ()\n        }\n        $'' : $'datetime.datetime'\n    )\ntype date_time_switch =\n    {\n        Gleam : date_gleam * time_of_day_gleam * duration_gleam\n        Lua : i64\n        Fsharp : $'System.DateTime'\n        Python : date_time_python\n        Rust : $'chrono::NaiveDateTime'\n    }\nnominal date_time = $'backend_switch `(date_time_switch)'","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  nominal date_gleam =
      `(
          backend_switch `(()) `({}) {
              Gleam = (fun () =>
                  global "import gleam/time/calendar"
                          ) : () -> ()
          }
          $'' : $'calendar.Date'
      )
  nominal time_of_day_gleam =
      `(
          backend_switch `(()) `({}) {
              Gleam = (fun () =>
                  global "import gleam/time/calendar"
                          ) : () -> ()
          }
          $'' : $'calendar.TimeOfDay'
      )
  nominal duration_gleam =
      `(
          backend_switch `(()) `({}) {
              Gleam = (fun () =>
                  global "import gleam/time/duration"
                          ) : () -> ()
          }
          $'' : $'duration.Duration'
      )

  nominal date_time_python =
      `(
          backend_switch `(()) `({}) {
              Python = (fun () => global "import datetime") : () -> ()
          }
          $'' : $'datetime.datetime'
      )
  type date_time_switch =
      {
          Gleam : date_gleam * time_of_day_gleam * duration_gleam
          Lua : i64
          Fsharp : $'System.DateTime'
          Python : date_time_python
          Rust : $'chrono::NaiveDateTime'
      }
  nominal date_time = $'backend_switch `(date_time_switch)'
  """,
  timeout: 300_000
)
```

