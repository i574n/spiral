///> fsharp
///> cuda
///> rust -d chrono
///> typescript
test hours =
    ~~ date_time_milliseconds 2002 2 2 20 22 24 26
    |> new_time_span (date_time_milliseconds 2001 1 1 10 11 12 13)
    |> hours
    |> _assert_eq 10

/// ### minutes
:= minutes (time_span : time_span) : i32 =
    backend_switch {
        Gleam = \ () =>
            := total_seconds = (time_span |> convert.to : i32) |> convert.convert : f64
            ((total_seconds / 60.0) |> math.floor |> convert.unbox : i32) % 60
        Lua = \ () =>
            := total_seconds = (time_span |> convert.to : i32) |> convert.convert : f64
            ((total_seconds / 60.0) |> math.floor |> convert.unbox : i32) % 60
        Fsharp = \ () => time_span |> $'_.Minutes' : i32
        Python = \ () => (($'!time_span.seconds' : i32) / 60i32) % 60i32
        Rust = \ () =>
            := total : i64 = $'!time_span.num_minutes()'
            conv (total % 60i64) : i32
        TypeScript = \ () =>
            := total : f64 = $'!time_span'
            (conv (total / 60000f64) : i32) % 60i32
    }

///> gleam
