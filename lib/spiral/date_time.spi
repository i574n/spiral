///> cuda
///> rust -d chrono
///> typescript
test time_span_format_2 =
    ~~ date_time_milliseconds 2002 2 2 20 22 24 26
    |> new_time_span (date_time_milliseconds 2002 2 2 10 11 12 26)
    |> time_span_format "c"
    |> _assert_eq "10:11:12"

///> fsharp
///> cuda
///> rust -d chrono
///> typescript
test time_span_format_3 =
    ~~ date_time_milliseconds 2002 2 2 20 22 24 999
    |> new_time_span (date_time_milliseconds 2002 2 2 10 11 12 0)
    |> time_span_format "c"
    |> _assert_eq "10:11:12.9990000"

///> rust -d chrono
///> typescript
test time_span_format_custom_and_negative =
    := later = date_time_milliseconds 2002 2 2 20 22 24 26
    := earlier = date_time_milliseconds 2002 2 2 10 11 12 26
    := custom = later |> new_time_span earlier |> time_span_format "hh-mm-ss"
    (custom, earlier |> new_time_span later |> time_span_format "c") |> _assert_eq ("10-11-12", "-10:11:12")

/// ### time_zone_info
:== time_zone_info_switch =
    {
        Gleam : $'System.TimeZoneInfo'
        Lua : $'System.TimeZoneInfo'
        Fsharp : $'System.TimeZoneInfo'
        Python : $'System.TimeZoneInfo'
        Rust : $'chrono::FixedOffset'
    }
:! time_zone_info = $'backend_switch `(time_zone_info_switch)'

/// ### add_days
:= add_days (days : i32) (date_time : date_time) : date_time =
    backend_switch {
        Gleam = \ () =>
            global "import gleam/time/duration"
            := duration : duration_gleam = $'duration.days(#days)' : duration_gleam
            := (date : date_gleam), (time_of_day : time_of_day_gleam), (existing_duration : duration_gleam) =
                date_time |> split_date_time
            := new_duration : duration_gleam = $'!existing_duration + !duration '
            (date, time_of_day, new_duration) |> convert.to : date_time
        Lua = \ () =>
            := seconds = days * 86400
            (date_time |> convert.unbox) + seconds |> convert.unbox : date_time
        Fsharp = \ () =>
            $'!date_time.AddDays' days : date_time
        Python = \ () =>
            global "import datetime"
            $'!date_time + datetime.timedelta(days=!days)' : date_time
        Rust = \ () =>
            := days' : i64 = conv days
            := delta = $'chrono::TimeDelta::days(!days')' : time_span
            $'!date_time + !delta' : date_time
        Zig = \ () =>
            (date_time |> zig_micros_of) + (days |> convert.convert : i64) * 86400000000i64 |> zig_date_time_of
    }

///> fsharp
///> rust -d chrono
test add_days_moves_the_timestamp =
    date_time_utc 2026 10 13 12 0 0
    |> add_days 3
    |> to_timestamp
    |> _assert_eq' (1792152000000000i64 |> timestamp)

/// ### to_calendar
:= to_calendar_gleam (timestamp : timestamp_gleam) : date_time =
    backend_switch {
        Gleam = \ () =>
            global "import gleam/time/timestamp"
            global "import gleam/time/calendar"
    }
    := duration = $'calendar.local_offset()' : duration_gleam
    := (date : date_gleam), (time_of_day : time_of_day_gleam) = $'!timestamp |> timestamp.to_calendar(!duration)'
    (date, time_of_day, duration) |> convert.to

:= to_calendar (timestamp : timestamp) : date_time =
    timestamp |> timestamp_gleam_of |> to_calendar_gleam

/// ### now
:= now () : date_time =
    backend_switch {
        Gleam = \ () =>
            := timestamp = $'timestamp.system_time ()' : timestamp_gleam
            timestamp |> to_calendar_gleam
        Lua = \ () =>
            := date_time = $'os.time()' : date_time
            date_time
        Fsharp = \ () =>
            run_target \|
                | _ => \ () => $'System.DateTime.Now'
            : date_time
        Python = \ () =>
            global "import datetime"
            $'datetime.datetime.now()' : date_time
        Rust = \ () => $'chrono::Local::now().naive_local()' : date_time
        Zig = \ () => zig_micros_now () |> zig_date_time_of
    }

/// ### utc_now
:= utc_now () : date_time =
    backend_switch {
        Gleam = \ () =>
            := timestamp = $'timestamp.system_time ()' : timestamp_gleam
            timestamp |> to_calendar_utc_gleam
        Lua = \ () =>
            := date_time = $'os.time()' : date_time
            date_time
        Fsharp = \ () => $'System.DateTime.UtcNow' : date_time
        Python = \ () =>
            global "import datetime"
            $'datetime.datetime.utcnow()' : date_time
        Rust = \ () => $'chrono::Utc::now().naive_utc()' : date_time
        Zig = \ () => zig_micros_now () |> zig_date_time_of
    }

/// ### stopwatch
:! stopwatch_python =
    `(
        global "import timeit"
        $'' : $'timeit.default_timer'
    )
:== stopwatch_switch =
    {
        Fsharp : $'System.Diagnostics.Stopwatch'
        Python : stopwatch_python
        Rust : $'std::time::Instant'
    }
:! stopwatch = $'backend_switch `(stopwatch_switch)'

:= stopwatch () : stopwatch =
    backend_switch {
        Fsharp = \ () => $'`stopwatch ()' : stopwatch
        Python = \ () => $'`stopwatch ' : stopwatch
        Rust = \ () => $'std::time::Instant::now()' : stopwatch
    }

:= stopwatch_elapsed_milliseconds (stopwatch : stopwatch) : i64 =
    ? is_rust () ?>
        := elapsed = $'!stopwatch.elapsed()' : rust_std_duration
        := seconds : u64 = $'!elapsed.as_secs()'
        := millis : u32 = $'!elapsed.subsec_millis()'
        (conv seconds : i64) * 1000i64 + conv millis
    |: $'!stopwatch.ElapsedMilliseconds'

:= stopwatch_elapsed_microseconds (stopwatch : stopwatch) : i64 =
    ? is_rust () ?>
        := elapsed = $'!stopwatch.elapsed()' : rust_std_duration
        := seconds : u64 = $'!elapsed.as_secs()'
        := micros : u32 = $'!elapsed.subsec_micros()'
        (conv seconds : i64) * 1000000i64 + conv micros
    |:
        := ticks : i64 = $'!stopwatch.Elapsed.Ticks'
        ticks / 10i64

:= stopwatch_start (stopwatch : stopwatch) : () =
    ? is_rust () |> not
    ?> $'!stopwatch.Start' ()

/// ### monotonic_milliseconds
:= monotonic_milliseconds () : i64 =
    run_target \|
        | Gleam => \ () =>
            erlang_term.apply "erlang" "monotonic_time" [ erlang_term.atom "millisecond" ] |> erlang_term.cast
        | _ => \ () => failwith "monotonic_milliseconds: no arm for this backend"

///> gleam
test the_monotonic_clock_does_not_go_back =
    := a = monotonic_milliseconds ()
    := b = monotonic_milliseconds ()
    (b >= a) |> _assert_eq !+

/// ## rust

/// ### duration'
:! duration' =
    `(
        rust.rust_type
            `($'std_time_Duration')
            `($'std::time::Duration')
            "type std_time_Duration = class end"
    )

/// ### date_time'
:! date_time' t =
    `(
        rust.rust_type
            `($'chrono_DateTime<`t>')
            `($'chrono::DateTime<`t>')
            "type chrono_DateTime<'T> = class end"
    )

/// ### local
:! local =
    `(
        rust.rust_type
            `($'chrono_Local')
            `($'chrono::Local')
            "type chrono_Local = class end"
    )

/// ### naive_date_time
:! naive_date_time =
    `(
        rust.rust_type
            `($'chrono_NaiveDateTime')
            `($'chrono::NaiveDateTime')
            "type chrono_NaiveDateTime = class end"
    )

/// ## utc
:! utc =
    `(
        rust.rust_type
            `($'chrono_Utc')
            `($'chrono::Utc')
            "type chrono_Utc = class end"
    )

/// ### naive_utc
:= naive_utc (date_time : date_time' utc) : naive_date_time =
    !\\(date_time, $'"$0.naive_utc()"')

/// ### to_local
:= to_local (date_time : date_time' utc) : date_time' local =
    := naive_date_time = date_time |> naive_utc
    !\\(naive_date_time, $'"chrono::offset::TimeZone::from_utc_datetime(&chrono::Local, &$0)"')

/// ### from_timestamp_micros
:= from_timestamp_micros \* t {number; int}. (timestamp : t) : option (date_time' utc) =
    := result : optionm'.option' (date_time' utc) =
        !\\(timestamp, $'"chrono::DateTime::from_timestamp_micros($0)"')
    result |> optionm'.unbox

/// ### format'
:= format' (format : string) (date_time : date_time' utc) : sm'.std_string =
    !\\((date_time, #format), $'"$0.format($1).to_string()"')

/// ### format''
:= format'' (format : string) (date_time : date_time' _) : sm'.std_string =
    !\\((date_time, #format), $'"$0.format($1).to_string()"')

/// ### format_timestamp
:= format_timestamp \* t {number; int}. (timestamp : t) =
    := timestamp = ~~ timestamp
    (timestamp / 1000)
    |> from_timestamp_micros
    |> optionm.map \ x =>
        x
        |> to_local
        |> format'' "%Y-%m-%d %H:%M:%S"
        |> sm'.from_std_string
    |> resultm.from_option

/// ### duration_from_millis
:= duration_from_millis (ms : u64) : duration' =
    := ms = ~~ ms
    !\($'"std::time::Duration::from_millis(!ms)"')

/// ## date_time

/// ### time_zone_local
:= time_zone_local () : time_zone_info =
    run_target \|
        | Fsharp _ => \ () =>
            $'System.TimeZoneInfo.Local'
        | Rust => \ () => $'*chrono::Local::now().offset()' : time_zone_info
        | _ => \ () => null ()

/// ### get_utc_offset
:= get_utc_offset (time_zone_info : time_zone_info) (date_time : date_time) : time_span =
    run_target \|
        | Fsharp _ => \ () => date_time |> $'_.GetUtcOffset' (time_zone_local ())
        | Rust => \ () =>
            := offset : i32 =
                $'chrono::TimeZone::offset_from_local_datetime(&chrono::Local, \
                    &!date_time).earliest().map(|o| o.local_minus_utc()).unwrap_or(0)'
            := seconds : i64 = conv offset
            $'chrono::TimeDelta::seconds(!seconds)' : time_span
        | target => \ () =>
            backend_switch {
                Gleam = \ () =>
                    global "import gleam/time/duration"
                    := duration : duration_gleam = $'calendar.utc_offset()' : duration_gleam
                    duration
                    |> $'duration.to_seconds'
                    |> ((*) 10000000i32)
                    |> convert.convert
                    |> \ x => x : int
                    |> convert.unbox
                    : time_span
                Lua = \ () =>
                    := date_time = date_time |> convert.unbox : int
                    := offset = 5i32 * 3600i32
                    offset * 10000000 |> convert.convert : time_span
                Fsharp = \ () => failwith $'$"date_time.get_utc_offset / target: {!target}"' : time_span
                Python = \ () => $'!date_time.utcoffset()' : time_span
            }

/// ### guid_sub_micro_digit
:= guid_sub_micro_digit (date_time : date_time) : i64 =
    run_target \|
        | Fsharp => \ () => $'(!date_time.Ticks % 10L)' : i64
        | Rust => \ () =>
            := nanos : u32 = $'!date_time.and_utc().timestamp_subsec_nanos()'
            conv (nanos / 100u32 % 10u32) : i64
        | _ => \ () => 0i64

/// ### with_guid_sub_micro_digit
:= with_guid_sub_micro_digit (digit : i64) (date_time : date_time) : date_time =
    run_target \|
        | Fsharp => \ () => $'!date_time.AddTicks(!digit)' : date_time
        | Rust => \ () => $'(!date_time + chrono::TimeDelta::nanoseconds(!digit * 100))' : date_time
        | _ => \ () => date_time

/// ### guid_prefix_of_micros
:= guid_prefix_of_micros (micros : i64) (sub_micro : i64) : string =
    := year, month, day, hour, minute, second, fraction_micros = civil_of_micros micros
    := fraction = pad_digits 7i32 (fraction_micros * 10 + sub_micro)
    pad_digits 4i32 year ++# pad_digits 2i32 month ++# pad_digits 2i32 day
    ++# "-" ++# pad_digits 2i32 hour ++# pad_digits 2i32 minute
    ++# "-" ++# pad_digits 2i32 second ++# (fraction |> sm'.slice 0i32 1i32)
    ++# "-" ++# (fraction |> sm'.slice 2i32 5i32)
    ++# "-" ++# (fraction |> sm'.slice 6i32 6i32)

/// ### guid_time_zone
:= guid_time_zone (date_time : date_time) : string =
    run_target \|
        | Zig => \ () => "00000"
        | _ => \ () =>
            := time_zone = date_time |> get_utc_offset (time_zone_local ())
            := time_zone_signal = ? hours time_zone > 0 ?> 1u8 |: 0
            := time_zone_value = time_zone |> time_span_format (~~ "hhmm")
            #?time_zone_signal ++# time_zone_value

/// ### date_time_guid_from_date_time
:~ date_time_guid_from_date_time (guid' : guid.guid) (date_time : date_time) =
    := create prefix time_zone : date_time_guid =
        := guid_range =
            guid'
            |> guid.to_string
            |> sm'.range
                (am'.Start (##prefix + ##time_zone))
                (am'.End eval)
        prefix ++# time_zone ++# guid_range |> guid.new_guid
    := micros = date_time |> to_timestamp |> \ (timestamp micros) => micros
    create (guid_prefix_of_micros micros (guid_sub_micro_digit date_time)) (guid_time_zone date_time)

///> fsharp
///> rust -d chrono
test date_time_guid_from_date_time =
    := suffix = test_guid () |> sm'.obj_to_string |> sm'.range (am'.End \ x => x () - 6i32) (am'.End eval)
    unix_epoch ()
    |> specify_date_kind Utc
    |> to_universal_time
    |> date_time_guid_from_date_time (test_guid ())
    |> sm'.obj_to_string
    |> \ s => s |> _assert_eq' ((s |> sm'.slice 0i32 29) ++# suffix)

///> fsharp
///> rust -d chrono
test date_time_guid_from_date_time_2 no_agree "local UTC offset in year 1 is implementation-defined" =
    := suffix = test_guid () |> sm'.obj_to_string |> sm'.range (am'.End \ x => x () - 6i32) (am'.End eval)
    min_value ()
    |> specify_date_kind Local
    |> date_time_guid_from_date_time (test_guid ())
    |> sm'.obj_to_string
    |> \ s => s |> _assert_eq' $'$"00010101-0000-0000-0000-0{!(s |> sm'.slice 25i32 29)}{!suffix}"'

///> fsharp
///> rust -d chrono
test date_time_guid_from_date_time_3 =
    := suffix = test_guid () |> sm'.obj_to_string |> sm'.range (am'.End \ x => x () - 6i32) (am'.End eval)
    max_value ()
    |> specify_date_kind Utc
    |> add_days -1
    |> date_time_guid_from_date_time (test_guid ())
    |> sm'.obj_to_string
    |> \ s => s |> _assert_eq ("99991230-2359-5999-9999-9" ++# (s |> sm'.slice 25i32 29) ++# suffix)

///> fsharp
///> rust -d chrono
test date_time_guid_from_date_time_4 =
    := suffix = test_guid () |> sm'.obj_to_string |> sm'.range (am'.End \ x => x () - 6i32) (am'.End eval)
    unix_epoch ()
    |> specify_date_kind Utc
    |> add_days 1
    |> date_time_guid_from_date_time (test_guid ())
    |> sm'.obj_to_string
    |> \ s => s |> _assert_eq ("19700102-0000-0000-0000-0" ++# (s |> sm'.slice 25i32 29) ++# suffix)

///> zig
test zig_date_time_guid_writes_seven_contiguous_fraction_digits =
    unix_epoch ()
    |> add_days 1i32
    |> date_time_guid_from_date_time (test_guid ())
    |> guid.to_string
    |> sm'.slice 0i32 29i32
    |> _assert_eq "19700102-0000-0000-0000-000000"
    1234567i64
    |> zig_date_time_of
    |> date_time_guid_from_date_time (test_guid ())
    |> guid.to_string
    |> sm'.slice 0i32 29i32
    |> _assert_eq "19700101-0000-0123-4567-000000"

///> fsharp
///> rust -d chrono
test date_time_guid_fraction_digits_are_contiguous =
    date_time_milliseconds 1970 1 1 0 0 1 123
    |> date_time_guid_from_date_time (test_guid ())
    |> sm'.obj_to_string
    |> sm'.slice 0i32 24i32
    |> _assert_eq "19700101-0000-0112-3000-0"

/// ### days_from_civil
:= days_from_civil (year : i64) (month : i64) (day : i64) : i64 =
    := y = ? month <= 2 ?> year - 1 |: year
    := era = floor_div y 400
    := year_of_era = y - era * 400
    := month_from_march = ? month > 2 ?> month - 3 |: month + 9
    := day_of_year = (153 * month_from_march + 2) / 5 + day - 1
    := day_of_era = year_of_era * 365 + year_of_era / 4 - year_of_era / 100 + day_of_year
    era * 146097 + day_of_era - 719468

/// ### micros_of_guid_prefix
:= micros_of_guid_prefix (text : string) : i64 * i64 =
    := field first last : i64 = text |> sm'.slice first last |> convert.try_convert |> optionm.value
    := days = days_from_civil (field 0i32 3i32) (field 4i32 5i32) (field 6i32 7i32)
    := seconds = days * 86400 + field 9i32 10i32 * 3600 + field 11i32 12i32 * 60 + field 14i32 15i32
    := fraction = field 16i32 17i32 * 100000 + field 19i32 22i32 * 10 + field 24i32 24i32
    seconds * 1000000 + fraction / 10, fraction % 10

/// ### date_time_from_guid
:= date_time_from_guid (date_time_guid : date_time_guid) : date_time =
    := micros, sub_micro = date_time_guid |> guid.to_string |> micros_of_guid_prefix
    micros |> timestamp |> to_calendar_utc |> with_guid_sub_micro_digit sub_micro

///> fsharp
///> rust -d chrono
///> zig
test date_time_guid_round_trips_through_the_prefix =
    1791892800123456i64
    |> timestamp
    |> to_calendar_utc
    |> date_time_guid_from_date_time (test_guid ())
    |> date_time_from_guid
    |> to_timestamp
    |> \ (timestamp micros) => micros
    |> _assert_eq 1791892800123456i64

///> fsharp
test date_time_from_guid =
    date_time_from_guid (guid.new_guid "00010101-0000-0000-0000-0a9876543210")
    |> _assert_eq' (min_value ())

///> fsharp
test date_time_from_guid_2 =
    date_time_from_guid (guid.new_guid $'$"99991231-2359-5999-9999-9{(!test_guid () |> string |> fun s -> s.Substring \
        (s.Length - 11))}"')
    |> _assert_eq' (max_value ())

///> fsharp
test date_time_from_guid_3 =
    date_time_from_guid (guid.new_guid $'$"19700101-0000-0000-0000-0{(!test_guid () |> string |> fun s -> s.Substring \
        (s.Length - 11))}"')
    |> _assert_eq' $'System.DateTime.UnixEpoch'

/// ### timestamp_guid_from_timestamp
:= timestamp_guid_from_timestamp (source : guid.guid) ((timestamp micros) : timestamp) : timestamp_guid =
    := digits = micros |> sm'.obj_to_string |> sm'.pad_left 18i32 '0'
    := piece first last = digits |> sm'.slice first last
    piece 0i32 7i32 ++# "-" ++# piece 8i32 11i32 ++# "-" ++# piece 12i32 15i32 ++# "-" ++# piece 16i32 17i32
    ++# (source |> guid.to_string |> sm'.range (am'.Start 21i32) (am'.End eval))
    |> guid.new_guid

///> fsharp
///> rust
///> zig
///> cuda
///> gleam
///> lua
test timestamp_guid_from_timestamp =
    timestamp_guid_from_timestamp (test_guid ()) (0i64 |> timestamp)
    |> guid.to_string
    |> _assert_eq "00000000-0000-0000-0043-210fedcba987"

///> fsharp
test timestamp_guid_from_timestamp_2 =
    timestamp_guid_from_timestamp (test_guid ()) (999999999999999999i64 |> timestamp)
    |> _assert_eq' (guid.new_guid $'$"99999999-9999-9999-9943-2{(!test_guid () |> string |> fun s -> s.Substring \
        (s.Length - 11))}"')

/// ### timestamp_from_guid
:= timestamp_from_guid (source : date_time_guid) : timestamp =
    := text = source |> guid.to_string
    := piece first last = text |> sm'.slice first last
    piece 0i32 7i32 ++# piece 9i32 12i32 ++# piece 14i32 17i32 ++# piece 19i32 20i32
    |> convert.try_convert
    |> optionm.value
    |> \ (micros : i64) => micros |> timestamp

///> fsharp
///> rust
///> zig
///> cuda
///> gleam
///> lua
test timestamp_from_guid =
    timestamp_from_guid (guid.new_guid "00000000-0000-0000-00dc-ba9876543210")
    |> \ (timestamp micros) => micros
    |> _assert_eq 0i64

///> fsharp
test timestamp_from_guid_2 =
    timestamp_from_guid (guid.new_guid $'$"99999999-9999-9999-99{(!test_guid () |> string |> fun s -> s.Substring \
        (s.Length - 15))}"')
    |> _assert_eq' (999999999999999999i64 |> timestamp)

/// ### new_guid_from_date_time
:= new_guid_from_date_time (date_time : date_time) =
    := guid = guid.new_raw_guid ()
    date_time |> date_time_guid_from_date_time guid

///> fsharp
test new_guid_from_date_time =
    utc_now ()
    |> new_guid_from_date_time
    |> date_time_from_guid
    |> \ date_time => new_time_span date_time (utc_now ()) |> total_seconds |> convert.i32
    |> _assert_eq 0

/// ### new_guid_from_timestamp
:= new_guid_from_timestamp (timestamp : timestamp) =
    := guid = guid.new_raw_guid ()
    timestamp |> timestamp_guid_from_timestamp guid

///> fsharp
test new_guid_from_timestamp =
    utc_now ()
    |> to_timestamp
    |> new_guid_from_timestamp
    |> timestamp_from_guid
    |> \ (timestamp t) =>
        (convert.convert t - (utc_now () |> to_timestamp |> \ (timestamp x) => convert.convert x)) / 100000i64
    |> _assert_eq 0i64

/// ## main
///> fsharp

:= main () =
    $'let date_time_guid_from_date_time x = !date_time_guid_from_date_time x' : ()
    $'let date_time_from_guid x = !date_time_from_guid x' : ()
    $'let timestamp_guid_from_timestamp x = !timestamp_guid_from_timestamp x' : ()
    $'let timestamp_from_guid x = !timestamp_from_guid x' : ()
    $'let new_guid_from_date_time x = !new_guid_from_date_time x' : ()
    $'let new_guid_from_timestamp x = !new_guid_from_timestamp x' : ()
    $'let format x = !format x' : ()
    $'let format_iso8601 x = !format_iso8601 x' : ()

///> zig
test zig_date_time_is_micros_since_the_unix_epoch =
    unix_epoch () |> format "yyyy-MM-dd HH:mm:ss" |> _assert_eq "1970-01-01 00:00:00"
    min_value () |> get_year |> _assert_eq 1i32
    max_value () |> get_year |> _assert_eq 9999i32
    unix_epoch () |> add_days 1i32 |> format "yyyy-MM-dd" |> _assert_eq "1970-01-02"
    max_value () |> format "HH:mm:ss.ffffff" |> _assert_eq "23:59:59.999999"
    unix_epoch () |> add_days -1i32 |> format_iso8601 |> _assert_eq "1969-12-31T00-00-00.000"

///> rust
test stopwatch_microseconds_agree_with_milliseconds =
    := watch = stopwatch ()
    stopwatch_start watch
    := before = stopwatch_elapsed_microseconds watch
    := millis = stopwatch_elapsed_milliseconds watch
    := after = stopwatch_elapsed_microseconds watch
    ? before < 0i64 ?> failwith "elapsed microseconds are never negative"
    ? after < before ?> failwith "elapsed microseconds never go back"
    ? millis * 1000i64 > after ?> failwith "the millisecond reading never runs ahead of a later microsecond reading"

///> lua
test pre_epoch_micros_floor_to_the_second_below_on_lua =
    timestamp -1i64
    |> to_calendar_utc
    |> to_timestamp
    |> _assert_eq' (-1000000i64 |> timestamp)
