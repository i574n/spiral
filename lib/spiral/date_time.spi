test seconds =
    ~~ date_time_milliseconds 2002 2 2 20 22 24 26
    |> new_time_span (date_time_milliseconds 2001 1 1 10 11 12 13)
    |> seconds
    |> _assert_eq 12

/// ### milliseconds
:= milliseconds (time_span : time_span) : i32 =
    backend_switch {
        Gleam = \ () =>
            := total_seconds = (time_span |> convert.to : i32) |> convert.convert : f64
            ((total_seconds * 1000.0) |> math.floor |> convert.unbox : i32) % 1000
        Lua = \ () =>
            := total_seconds = (time_span |> convert.to : i32) |> convert.convert : f64
            ((total_seconds * 1000.0) |> math.floor |> convert.unbox : i32) % 1000
        Fsharp = \ () => time_span |> $'_.Milliseconds' : i32
        Python = \ () => ($'!time_span.microseconds' : i32) / 1000i32
        Rust = \ () =>
            := total : i64 = $'!time_span.num_milliseconds()'
            conv (total % 1000i64) : i32
        TypeScript = \ () =>
            := total : f64 = $'!time_span'
            := whole : i64 = conv total
            conv (whole % 1000i64) : i32
    }

///> fsharp
///> cuda
///> rust -d chrono
///> typescript
test milliseconds =
    ~~ date_time_milliseconds 2002 2 2 20 22 24 26
    |> new_time_span (date_time_milliseconds 2001 1 1 10 11 12 13)
    |> milliseconds
    |> _assert_eq 13

/// ### time_span_ticks_text
:= time_span_ticks_text (format : string) (ticks : i64) : string =
    := negative = ticks < 0i64
    := a = ? negative ?> 0i64 - ticks |: ticks
    := days, hours = a / 864000000000i64, (a / 36000000000i64) % 24i64
    := minutes, seconds, fraction = (a / 600000000i64) % 60i64, (a / 10000000i64) % 60i64, a % 10000000i64
    := two (n : i64) : string = sm'.pad_left 2 '0' ("" ++#? n)
    ? format = "" || format = "c" ?>
        := sign = ? negative ?> "-" |: ""
        := day_part = ? days > 0i64 ?> "" ++#? days ++# "." |: ""
        := fraction_part = ? fraction > 0i64 ?> "." ++# sm'.pad_left 7 '0' ("" ++#? fraction) |: ""
        sign ++# day_part ++# two hours ++# ":" ++# two minutes ++# ":" ++# two seconds ++# fraction_part
    |: format |> sm'.replace "hh" (two hours) |> sm'.replace "mm" (two minutes) |> sm'.replace "ss" (two seconds)

/// ### rust_time_span_nanoseconds
:= rust_time_span_nanoseconds (time_span : time_span) : i64 = $'!time_span.num_nanoseconds().unwrap()' : i64

/// ### typescript_time_span_milliseconds
:= typescript_time_span_milliseconds (time_span : time_span) : f64 = $'!time_span' : f64

/// ### time_span_format
:= time_span_format (format : string) (time_span : time_span) : string =
    run_target_args (\ () => format, time_span) \|
        | TypeScript => \ format, time_span =>
            := milliseconds : i64 = conv (typescript_time_span_milliseconds time_span)
            time_span_ticks_text format (milliseconds * 10000i64)
        | Rust => \ format, time_span => time_span_ticks_text format (rust_time_span_nanoseconds time_span / 100i64)
        | _ => \ format, time_span =>
            backend_switch {
                Gleam = \ () =>
                    global "import tempo/datetime"
                    := tempo_date_time : tempo_date_time =
                        time_span
                        |> $'duration.seconds'
                        |> \ x => x : duration_gleam
                        |> $'datetime.from_duration'
                    := format =
                        ? format = ""
                        ?> "c"
                        |: format
                    $'!tempo_date_time |> datetime.format(tempo.Custom(!format))' : string
                Lua = \ () =>
                    := total_seconds = time_span |> convert.unbox : f64
                    := hours = total_seconds / 3600
                    := minutes = (total_seconds % 3600) / 60
                    := seconds = total_seconds % 60
                    := result =
                        sm'.pad_left 2 '0' #?hours
                        ++# ":"
                        ++# sm'.pad_left 2 '0' #?minutes
                        ++# ":"
                        ++# sm'.pad_left 2 '0' #?seconds
                    := ms = time_span |> milliseconds
                    ? ms <= 0
                    ?> result
                    |:
                        := ms =
                            #?**ms
                            |> sm'.pad_left 3 '0'
                            |> sm'.pad_right 7 '0'
                        result ++# "." ++# ms
                Fsharp = \ () => $'!time_span.ToString !format ' : string
                Python = \ () =>
                    := date = $'!time_span + !(min_value ())' : date_time
                    := time = $'!date.strftime("%H:%M:%S")' : string
                    := days = time_span |> days
                    := result =
                        ? days <= 0
                        ?> time
                        |: #?**days ++# "." ++# time
                    := ms = time_span |> milliseconds
                    ? ms <= 0
                    ?> result
                    |:
                        := ms =
                            #?**ms
                            |> sm'.pad_left 3 '0'
                            |> sm'.pad_right 7 '0'
                        result ++# "." ++# ms
            }

///> fsharp
///> cuda
///> rust -d chrono
///> typescript
test time_span_format =
    ~~ date_time_milliseconds 2002 2 2 20 22 24 26
    |> new_time_span (date_time_milliseconds 2001 1 1 10 11 12 13)
    |> time_span_format "c"
    |> _assert_eq "397.10:11:12.0130000"

