test time_span_format_2 =
    (join date_time_milliseconds 2002 2 2 20 22 24 26)
    |> new_time_span (date_time_milliseconds 2002 2 2 10 11 12 26)
    |> time_span_format "c"
    |> _assert_eq "10:11:12"

