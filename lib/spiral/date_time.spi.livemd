<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":":! time_span_python =\n    `(\n        backend_switch `(()) `({}) {\n            Python = (\\ () => global \"import datetime\") : () -> ()\n        }\n        $'' : $'datetime.timedelta'\n    )\n:== time_span_switch =\n    {\n        Gleam : $'duration.Duration'\n        Lua : $'number'\n        Fsharp : $'System.TimeSpan'\n        Python : time_span_python\n        Rust : $'chrono::TimeDelta'\n        TypeScript : $'number'\n    }\n:! time_span = $'backend_switch `(time_span_switch)'\n\n:= rust_time_delta_microseconds (n : i64) : time_span = $'chrono::TimeDelta::microseconds(!n)' : time_span\n\n:= rust_time_delta_nanoseconds (n : i64) : time_span = $'chrono::TimeDelta::nanoseconds(!n)' : time_span\n\n:= rust_time_delta_sum (a : time_span) (b : time_span) : time_span = $'!a + !b' : time_span\n\n:= rust_time_delta_of_ticks (ticks : i64) : time_span =\n    := whole_microseconds = rust_time_delta_microseconds (ticks / 10i64)\n    rust_time_delta_sum whole_microseconds (rust_time_delta_nanoseconds ((ticks % 10i64) * 100i64))\n\n:= python_timedelta x : time_span =\n    global \"import datetime\"\n    $'datetime.timedelta(!x)' : time_span\n\n:= time_span x : time_span =\n    backend_switch {\n        Gleam = \\ () => x |> convert::unbox : time_span\n        Lua = \\ () => x |> convert::unbox : time_span\n        Fsharp = \\ () => $'!x |> `time_span ' : time_span\n        Python = \\ () => python_timedelta x\n        Rust = \\ () => rust_time_delta_of_ticks (conv x)\n    }\n\n:= gleam_stamp (date_time : date_time) : timestamp_gleam = date_time |> split_date_time |> new_timestamp_gleam\n\n:= gleam_whole_seconds (duration : duration_gleam) : time_span =\n    ($'duration.to_seconds(!duration)' : float)\n    |> convert::convert\n    |> \\ x => x : int\n    |> convert::convert\n\n:= gleam_span (a : date_time) (b : date_time) : time_span =\n    := timestamp, timestamp' = gleam_stamp a, gleam_stamp b\n    := duration : duration_gleam = $'!timestamp |> timestamp.difference(!timestamp')'\n    gleam_whole_seconds duration\n\n:= new_time_span (a : date_time) (b : date_time) : time_span =\n    run_target \\|\n        | Gleam => \\ () => gleam_span a b\n        | _ => \\ () => $'!b - !a '\n\n:! rust_std_duration = $'std::time::Duration'\n\n:= rust_time_delta_ticks (time_span : time_span) : i64 =\n    := seconds : i64 = $'!time_span.num_seconds()'\n    := nanos : i32 = $'!time_span.subsec_nanos()'\n    seconds * 10000000i64 + (conv nanos : i64) / 100i64\n\n:= gleam_duration_imports () : () =\n    backend_switch {\n        Gleam = \\ () => global \"import gleam/time/duration\"\n    }\n\n:= gleam_ticks (time_span : time_span) : i64 =\n    gleam_duration_imports ()\n    := duration : duration_gleam = time_span |> $'duration.seconds'\n    duration |> $'duration.to_seconds' |> (*) 10000000f64 |> convert::convert\n\n:= lua_ticks (time_span : time_span) : i64 =\n    := seconds = time_span |> convert::unbox : f64\n    seconds * 10000000 |> convert::convert : i64\n\n:= cuda_ticks (time_span : time_span) : i64 = $'!time_span.total_seconds() * 10000000' : i64\n\n:= dotnet_ticks (time_span : time_span) : i64 = time_span |> $'_.Ticks' : i64\n\n:= span_ticks (time_span : time_span) : i64 =\n    run_target \\|\n        | Gleam => \\ () => gleam_ticks time_span\n        | Lua => \\ () => lua_ticks time_span\n        | Cuda => \\ () => cuda_ticks time_span\n        | Rust => \\ () => rust_time_delta_ticks time_span\n        | _ => \\ () => dotnet_ticks time_span\n\n:= total_seconds (time_span : time_span) : f64 = (conv (span_ticks time_span) : f64) / 10000000f64\n\n:= gleam_days (time_span : time_span) : f64 =\n    gleam_duration_imports ()\n    := duration : duration_gleam = time_span |> $'duration.seconds'\n    duration |> $'duration.to_seconds' |> (/) 86400f64\n\n:= lua_days (time_span : time_span) : f64 =\n    := seconds = time_span |> convert::unbox : f64\n    seconds / 86400 |> convert::convert : f64\n\n:= days (time_span : time_span) : f64 =\n    backend_switch {\n        Gleam = \\ () => gleam_days time_span\n        Lua = \\ () => lua_days time_span\n        Fsharp = \\ () => time_span |> $'_.TotalDays' : f64\n        Python = \\ () => $'!time_span.days' : f64\n        Rust = \\ () => (conv (rust_time_delta_ticks time_span) : f64) / 864000000000f64\n    }\n\n:= gleam_micros (date_time : date_time) : i64 =\n    global \"import gleam/time/timestamp\"\n    := t = gleam_stamp date_time\n    := seconds : i64 = $'timestamp.to_unix_seconds_and_nanoseconds(!t).0'\n    := nanos : i64 = $'timestamp.to_unix_seconds_and_nanoseconds(!t).1'\n    seconds * 1000000i64 + nanos / 1000i64\n\n:= fsharp_micros (date_time : date_time) : i64 =\n    := ticks : i64 = $'!date_time.Ticks'\n    (ticks - 621355968000000000i64) / 10i64\n\n:= python_micros (date_time : date_time) : i64 =\n    global \"import datetime\"\n    $'(!date_time.replace(tzinfo=None) - datetime.datetime(1970, 1, 1)) // \\\n        datetime.timedelta(microseconds=1)' : i64\n\n:= to_timestamp (date_time : date_time) : timestamp =\n    backend_switch {\n        Gleam = \\ () => gleam_micros date_time |> timestamp\n        Lua = \\ () => ($'!date_time * 1000000' : i64) |> timestamp\n        Fsharp = \\ () => fsharp_micros date_time |> timestamp\n        Python = \\ () => python_micros date_time |> timestamp\n        Rust = \\ () => ($'!date_time.and_utc().timestamp_micros()' : i64) |> timestamp\n        Zig = \\ () => date_time |> zig_micros_of |> timestamp\n    }","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  :! time_span_python =
      `(
          backend_switch `(()) `({}) {
              Python = (\ () => global "import datetime") : () -> ()
          }
          $'' : $'datetime.timedelta'
      )
  :== time_span_switch =
      {
          Gleam : $'duration.Duration'
          Lua : $'number'
          Fsharp : $'System.TimeSpan'
          Python : time_span_python
          Rust : $'chrono::TimeDelta'
          TypeScript : $'number'
      }
  :! time_span = $'backend_switch `(time_span_switch)'

  := rust_time_delta_microseconds (n : i64) : time_span = $'chrono::TimeDelta::microseconds(!n)' : time_span

  := rust_time_delta_nanoseconds (n : i64) : time_span = $'chrono::TimeDelta::nanoseconds(!n)' : time_span

  := rust_time_delta_sum (a : time_span) (b : time_span) : time_span = $'!a + !b' : time_span

  := rust_time_delta_of_ticks (ticks : i64) : time_span =
      := whole_microseconds = rust_time_delta_microseconds (ticks / 10i64)
      rust_time_delta_sum whole_microseconds (rust_time_delta_nanoseconds ((ticks % 10i64) * 100i64))

  := python_timedelta x : time_span =
      global "import datetime"
      $'datetime.timedelta(!x)' : time_span

  := time_span x : time_span =
      backend_switch {
          Gleam = \ () => x |> convert::unbox : time_span
          Lua = \ () => x |> convert::unbox : time_span
          Fsharp = \ () => $'!x |> `time_span ' : time_span
          Python = \ () => python_timedelta x
          Rust = \ () => rust_time_delta_of_ticks (conv x)
      }

  := gleam_stamp (date_time : date_time) : timestamp_gleam = date_time |> split_date_time |> new_timestamp_gleam

  := gleam_whole_seconds (duration : duration_gleam) : time_span =
      ($'duration.to_seconds(!duration)' : float)
      |> convert::convert
      |> \ x => x : int
      |> convert::convert

  := gleam_span (a : date_time) (b : date_time) : time_span =
      := timestamp, timestamp' = gleam_stamp a, gleam_stamp b
      := duration : duration_gleam = $'!timestamp |> timestamp.difference(!timestamp')'
      gleam_whole_seconds duration

  := new_time_span (a : date_time) (b : date_time) : time_span =
      run_target \|
          | Gleam => \ () => gleam_span a b
          | _ => \ () => $'!b - !a '

  :! rust_std_duration = $'std::time::Duration'

  := rust_time_delta_ticks (time_span : time_span) : i64 =
      := seconds : i64 = $'!time_span.num_seconds()'
      := nanos : i32 = $'!time_span.subsec_nanos()'
      seconds * 10000000i64 + (conv nanos : i64) / 100i64

  := gleam_duration_imports () : () =
      backend_switch {
          Gleam = \ () => global "import gleam/time/duration"
      }

  := gleam_ticks (time_span : time_span) : i64 =
      gleam_duration_imports ()
      := duration : duration_gleam = time_span |> $'duration.seconds'
      duration |> $'duration.to_seconds' |> (*) 10000000f64 |> convert::convert

  := lua_ticks (time_span : time_span) : i64 =
      := seconds = time_span |> convert::unbox : f64
      seconds * 10000000 |> convert::convert : i64

  := cuda_ticks (time_span : time_span) : i64 = $'!time_span.total_seconds() * 10000000' : i64

  := dotnet_ticks (time_span : time_span) : i64 = time_span |> $'_.Ticks' : i64

  := span_ticks (time_span : time_span) : i64 =
      run_target \|
          | Gleam => \ () => gleam_ticks time_span
          | Lua => \ () => lua_ticks time_span
          | Cuda => \ () => cuda_ticks time_span
          | Rust => \ () => rust_time_delta_ticks time_span
          | _ => \ () => dotnet_ticks time_span

  := total_seconds (time_span : time_span) : f64 = (conv (span_ticks time_span) : f64) / 10000000f64

  := gleam_days (time_span : time_span) : f64 =
      gleam_duration_imports ()
      := duration : duration_gleam = time_span |> $'duration.seconds'
      duration |> $'duration.to_seconds' |> (/) 86400f64

  := lua_days (time_span : time_span) : f64 =
      := seconds = time_span |> convert::unbox : f64
      seconds / 86400 |> convert::convert : f64

  := days (time_span : time_span) : f64 =
      backend_switch {
          Gleam = \ () => gleam_days time_span
          Lua = \ () => lua_days time_span
          Fsharp = \ () => time_span |> $'_.TotalDays' : f64
          Python = \ () => $'!time_span.days' : f64
          Rust = \ () => (conv (rust_time_delta_ticks time_span) : f64) / 864000000000f64
      }

  := gleam_micros (date_time : date_time) : i64 =
      global "import gleam/time/timestamp"
      := t = gleam_stamp date_time
      := seconds : i64 = $'timestamp.to_unix_seconds_and_nanoseconds(!t).0'
      := nanos : i64 = $'timestamp.to_unix_seconds_and_nanoseconds(!t).1'
      seconds * 1000000i64 + nanos / 1000i64

  := fsharp_micros (date_time : date_time) : i64 =
      := ticks : i64 = $'!date_time.Ticks'
      (ticks - 621355968000000000i64) / 10i64

  := python_micros (date_time : date_time) : i64 =
      global "import datetime"
      $'(!date_time.replace(tzinfo=None) - datetime.datetime(1970, 1, 1)) // \
          datetime.timedelta(microseconds=1)' : i64

  := to_timestamp (date_time : date_time) : timestamp =
      backend_switch {
          Gleam = \ () => gleam_micros date_time |> timestamp
          Lua = \ () => ($'!date_time * 1000000' : i64) |> timestamp
          Fsharp = \ () => fsharp_micros date_time |> timestamp
          Python = \ () => python_micros date_time |> timestamp
          Rust = \ () => ($'!date_time.and_utc().timestamp_micros()' : i64) |> timestamp
          Zig = \ () => date_time |> zig_micros_of |> timestamp
      }
  """,
  timeout: 300_000
)
```

#### to_timestamp (test)

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":"///- --test --symbol\n///> gleam\n///> cuda\n///> rust -d chrono\n\nunix_epoch ()\n|> to_timestamp\n|> _assert_eq' (0i64 |> timestamp)\n\ndate_time_utc 2026 10 13 12 0 0\n|> to_timestamp\n|> _assert_eq' (1791892800000000i64 |> timestamp)","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  ///- --test --symbol
  ///> gleam
  ///> cuda
  ///> rust -d chrono

  unix_epoch ()
  |> to_timestamp
  |> _assert_eq' (0i64 |> timestamp)

  date_time_utc 2026 10 13 12 0 0
  |> to_timestamp
  |> _assert_eq' (1791892800000000i64 |> timestamp)
  """,
  timeout: 300_000
)
```

