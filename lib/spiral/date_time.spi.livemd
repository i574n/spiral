<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":":= gleam_calendar_imports () : () =\n    backend_switch {\n        Gleam = \\ () =>\n            global \"import gleam/time/calendar\"\n            global \"import gleam/time/timestamp\"\n    }\n\n:= to_calendar_utc_gleam (timestamp : timestamp_gleam) : date_time =\n    gleam_calendar_imports ()\n    := duration = $'calendar.utc_offset' : duration_gleam\n    := (date : date_gleam), (time_of_day : time_of_day_gleam) = $'!timestamp |> timestamp.to_calendar(!duration)'\n    gleam_date_time date time_of_day duration\n\n:= to_calendar_utc_python (micros : i64) : date_time =\n    global \"import datetime\"\n    $'datetime.datetime(1970, 1, 1) + datetime.timedelta(microseconds=!micros)' : date_time\n\n:= to_calendar_utc_rust (micros : i64) : date_time =\n    $'chrono::DateTime::from_timestamp_micros(!micros).unwrap().naive_utc()' : date_time\n\n:= to_calendar_utc ((timestamp micros) &= timestamp : timestamp) : date_time =\n    backend_switch {\n        Gleam = \\ () => timestamp |> timestamp_gleam_of |> to_calendar_utc_gleam\n        Lua = \\ () => floor_div micros 1000000i64 |> convert::unbox : date_time\n        Fsharp = \\ () => $'System.DateTime.UnixEpoch.AddTicks(!micros * 10L)' : date_time\n        Python = \\ () => to_calendar_utc_python micros\n        Rust = \\ () => to_calendar_utc_rust micros\n        Zig = \\ () => micros |> zig_date_time_of\n    }\n\n:! time_zone_provider =\n    `(\n        backend_switch `(()) `({}) {\n            Gleam = (\\ () =>\n                global \"import tempo\"\n                        ) : () -> ()\n        }\n        $'' : $'tempo.TimeZoneProvider'\n    )\n\n:= unix_epoch_lua () : date_time =\n    := stamp : optionm'::option' date_time = $'os.time{year=1970, month=1, day=1, hour=0, min=0, sec=0}'\n    stamp |> optionm'::default_value' ($'0' : date_time)\n\n:= unix_epoch_python () : date_time =\n    global \"import datetime\"\n    $'datetime.datetime(1970, 1, 1)' : date_time\n\n:= unix_epoch () : date_time =\n    backend_switch {\n        Gleam = \\ () => 0i32 |> timestamp |> to_calendar_utc : date_time\n        Lua = \\ () => unix_epoch_lua ()\n        Fsharp = \\ () => $'System.DateTime.UnixEpoch' : date_time\n        Python = \\ () => unix_epoch_python ()\n        Rust = \\ () => rust_date_at (rust_naive_date 1970i32 1u32 1u32) 0u32 0u32 0u32\n        Zig = \\ () => 0i64 |> zig_date_time_of\n    }","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  := gleam_calendar_imports () : () =
      backend_switch {
          Gleam = \ () =>
              global "import gleam/time/calendar"
              global "import gleam/time/timestamp"
      }

  := to_calendar_utc_gleam (timestamp : timestamp_gleam) : date_time =
      gleam_calendar_imports ()
      := duration = $'calendar.utc_offset' : duration_gleam
      := (date : date_gleam), (time_of_day : time_of_day_gleam) = $'!timestamp |> timestamp.to_calendar(!duration)'
      gleam_date_time date time_of_day duration

  := to_calendar_utc_python (micros : i64) : date_time =
      global "import datetime"
      $'datetime.datetime(1970, 1, 1) + datetime.timedelta(microseconds=!micros)' : date_time

  := to_calendar_utc_rust (micros : i64) : date_time =
      $'chrono::DateTime::from_timestamp_micros(!micros).unwrap().naive_utc()' : date_time

  := to_calendar_utc ((timestamp micros) &= timestamp : timestamp) : date_time =
      backend_switch {
          Gleam = \ () => timestamp |> timestamp_gleam_of |> to_calendar_utc_gleam
          Lua = \ () => floor_div micros 1000000i64 |> convert::unbox : date_time
          Fsharp = \ () => $'System.DateTime.UnixEpoch.AddTicks(!micros * 10L)' : date_time
          Python = \ () => to_calendar_utc_python micros
          Rust = \ () => to_calendar_utc_rust micros
          Zig = \ () => micros |> zig_date_time_of
      }

  :! time_zone_provider =
      `(
          backend_switch `(()) `({}) {
              Gleam = (\ () =>
                  global "import tempo"
                          ) : () -> ()
          }
          $'' : $'tempo.TimeZoneProvider'
      )

  := unix_epoch_lua () : date_time =
      := stamp : optionm'::option' date_time = $'os.time{year=1970, month=1, day=1, hour=0, min=0, sec=0}'
      stamp |> optionm'::default_value' ($'0' : date_time)

  := unix_epoch_python () : date_time =
      global "import datetime"
      $'datetime.datetime(1970, 1, 1)' : date_time

  := unix_epoch () : date_time =
      backend_switch {
          Gleam = \ () => 0i32 |> timestamp |> to_calendar_utc : date_time
          Lua = \ () => unix_epoch_lua ()
          Fsharp = \ () => $'System.DateTime.UnixEpoch' : date_time
          Python = \ () => unix_epoch_python ()
          Rust = \ () => rust_date_at (rust_naive_date 1970i32 1u32 1u32) 0u32 0u32 0u32
          Zig = \ () => 0i64 |> zig_date_time_of
      }
  """,
  timeout: 300_000
)
```

