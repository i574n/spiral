<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":":= gleam_time_imports () : () =\n    global \"import gleam/time/calendar\"\n    global \"import gleam/time/duration\"\n    global \"import gleam/time/timestamp\"\n\n:= gleam_month (month : int) : calendar_month =\n    global \"import tempo/month\"\n    := calendar_month : resultm::result' calendar_month () = $\"!month |> month.from_int\"\n    calendar_month |> resultm::unbox |> resultm::get\n\n:= gleam_date (year : int) (month : int) (day : int) : date_gleam =\n    := calendar_month = gleam_month month\n    $'calendar.Date(#year, #calendar_month, #day)' : date_gleam\n\n:= gleam_time_of_day (hour : int) (minute : int) (second : int) (nanoseconds : int) : time_of_day_gleam =\n    $'calendar.TimeOfDay(#hour, #minute, #second, #nanoseconds)' : time_of_day_gleam\n\n:= date_time_milliseconds_gleam\n    (year : int) (month : int) (day : int) (hour : int) (minute : int) (second : int) (millisecond : int)\n    : date_time\n    =\n    gleam_time_imports ()\n    := date = gleam_date year month day\n    := time_of_day = gleam_time_of_day hour minute second (millisecond * 1000000)\n    gleam_date_time date time_of_day ($'duration.milliseconds(#millisecond)' : duration_gleam)\n\n:= lua_midnight (year : int) (month : int) (day : int) : int =\n    := stamp : optionm'::option' int = $'os.time{year=!year, month=!month, day=!day, hour=0, min=0, sec=0}'\n    stamp |> optionm'::default_value' 0i32\n\n:= date_time_milliseconds_lua\n    (year : int) (month : int) (day : int) (hour : int) (minute : int) (second : int) (millisecond : int)\n    : date_time\n    =\n    := total_seconds = second + (minute * 60) + (hour * 3600)\n    lua_midnight year month day + (total_seconds + (millisecond / 1000)) |> convert::unbox : date_time\n\n:= date_time_milliseconds_python\n    (year : int) (month : int) (day : int) (hour : int) (minute : int) (second : int) (millisecond : int)\n    : date_time\n    =\n    global \"import datetime\"\n    $'datetime.datetime(!year, !month, !day, !hour, !minute, !second, !millisecond * 1000)' : date_time\n\n:= date_time_milliseconds_rust\n    (year : int) (month : int) (day : int) (hour : int) (minute : int) (second : int) (millisecond : int)\n    : date_time\n    =\n    := date = rust_naive_date (conv year) (conv month) (conv day)\n    rust_date_at_milli date (conv hour) (conv minute) (conv second) (conv millisecond)\n\n:= date_time_milliseconds_typescript\n    (year : int) (month : int) (day : int) (hour : int) (minute : int) (second : int) (millisecond : int)\n    : date_time\n    =\n    $'new Date(!year, !month - 1, !day, !hour, !minute, !second, !millisecond)' : date_time\n\n:= date_time_milliseconds_fsharp\n    (year : int) (month : int) (day : int) (hour : int) (minute : int) (second : int) (millisecond : int)\n    : date_time\n    =\n    $'System.DateTime (!year, !month, !day, !hour, !minute, !second, !millisecond)' : date_time\n\n:= date_time_milliseconds\n    (year : int) (month : int) (day : int) (hour : int) (minute : int) (second : int) (millisecond : int)\n    : date_time\n    =\n    backend_switch {\n        Gleam = \\ () => date_time_milliseconds_gleam year month day hour minute second millisecond\n        Lua = \\ () => date_time_milliseconds_lua year month day hour minute second millisecond\n        Fsharp = \\ () => date_time_milliseconds_fsharp year month day hour minute second millisecond\n        Python = \\ () => date_time_milliseconds_python year month day hour minute second millisecond\n        Rust = \\ () => date_time_milliseconds_rust year month day hour minute second millisecond\n        TypeScript = \\ () => date_time_milliseconds_typescript year month day hour minute second millisecond\n    }","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  := gleam_time_imports () : () =
      global "import gleam/time/calendar"
      global "import gleam/time/duration"
      global "import gleam/time/timestamp"

  := gleam_month (month : int) : calendar_month =
      global "import tempo/month"
      := calendar_month : resultm::result' calendar_month () = $"!month |> month.from_int"
      calendar_month |> resultm::unbox |> resultm::get

  := gleam_date (year : int) (month : int) (day : int) : date_gleam =
      := calendar_month = gleam_month month
      $'calendar.Date(#year, #calendar_month, #day)' : date_gleam

  := gleam_time_of_day (hour : int) (minute : int) (second : int) (nanoseconds : int) : time_of_day_gleam =
      $'calendar.TimeOfDay(#hour, #minute, #second, #nanoseconds)' : time_of_day_gleam

  := date_time_milliseconds_gleam
      (year : int) (month : int) (day : int) (hour : int) (minute : int) (second : int) (millisecond : int)
      : date_time
      =
      gleam_time_imports ()
      := date = gleam_date year month day
      := time_of_day = gleam_time_of_day hour minute second (millisecond * 1000000)
      gleam_date_time date time_of_day ($'duration.milliseconds(#millisecond)' : duration_gleam)

  := lua_midnight (year : int) (month : int) (day : int) : int =
      := stamp : optionm'::option' int = $'os.time{year=!year, month=!month, day=!day, hour=0, min=0, sec=0}'
      stamp |> optionm'::default_value' 0i32

  := date_time_milliseconds_lua
      (year : int) (month : int) (day : int) (hour : int) (minute : int) (second : int) (millisecond : int)
      : date_time
      =
      := total_seconds = second + (minute * 60) + (hour * 3600)
      lua_midnight year month day + (total_seconds + (millisecond / 1000)) |> convert::unbox : date_time

  := date_time_milliseconds_python
      (year : int) (month : int) (day : int) (hour : int) (minute : int) (second : int) (millisecond : int)
      : date_time
      =
      global "import datetime"
      $'datetime.datetime(!year, !month, !day, !hour, !minute, !second, !millisecond * 1000)' : date_time

  := date_time_milliseconds_rust
      (year : int) (month : int) (day : int) (hour : int) (minute : int) (second : int) (millisecond : int)
      : date_time
      =
      := date = rust_naive_date (conv year) (conv month) (conv day)
      rust_date_at_milli date (conv hour) (conv minute) (conv second) (conv millisecond)

  := date_time_milliseconds_typescript
      (year : int) (month : int) (day : int) (hour : int) (minute : int) (second : int) (millisecond : int)
      : date_time
      =
      $'new Date(!year, !month - 1, !day, !hour, !minute, !second, !millisecond)' : date_time

  := date_time_milliseconds_fsharp
      (year : int) (month : int) (day : int) (hour : int) (minute : int) (second : int) (millisecond : int)
      : date_time
      =
      $'System.DateTime (!year, !month, !day, !hour, !minute, !second, !millisecond)' : date_time

  := date_time_milliseconds
      (year : int) (month : int) (day : int) (hour : int) (minute : int) (second : int) (millisecond : int)
      : date_time
      =
      backend_switch {
          Gleam = \ () => date_time_milliseconds_gleam year month day hour minute second millisecond
          Lua = \ () => date_time_milliseconds_lua year month day hour minute second millisecond
          Fsharp = \ () => date_time_milliseconds_fsharp year month day hour minute second millisecond
          Python = \ () => date_time_milliseconds_python year month day hour minute second millisecond
          Rust = \ () => date_time_milliseconds_rust year month day hour minute second millisecond
          TypeScript = \ () => date_time_milliseconds_typescript year month day hour minute second millisecond
      }
  """,
  timeout: 300_000
)
```

