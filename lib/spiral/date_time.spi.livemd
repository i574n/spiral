<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":":= max_value_gleam () : date_time =\n    := date = $'calendar.Date(9999, calendar.December, 31)' : date_gleam\n    := time_of_day = $'calendar.TimeOfDay(23, 59, 59, 999)' : time_of_day_gleam\n    gleam_date_time date time_of_day ($'duration.seconds(0)  ' : duration_gleam)\n\n:= max_value_lua () : date_time =\n    := stamp : optionm'::option' date_time = $'os.time{year=9999, month=12, day=31, hour=23, min=59, sec=59}'\n    stamp |> optionm'::default_value' ($'253402300799' : date_time)\n\n:= max_value_python () : date_time =\n    global \"import datetime\"\n    $'datetime.datetime.max' : date_time\n\n:= max_value_rust () : date_time = rust_date_at_nano (rust_naive_date 9999i32 12u32 31u32) 23u32 59u32 59u32 999999900u32\n\n:= max_value () : date_time =\n    backend_switch {\n        Gleam = \\ () => max_value_gleam ()\n        Lua = \\ () => max_value_lua ()\n        Fsharp = \\ () => $'System.DateTime.MaxValue' : date_time\n        Python = \\ () => max_value_python ()\n        Rust = \\ () => max_value_rust ()\n        Zig = \\ () => 253402300799999999i64 |> zig_date_time_of\n    }","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  := max_value_gleam () : date_time =
      := date = $'calendar.Date(9999, calendar.December, 31)' : date_gleam
      := time_of_day = $'calendar.TimeOfDay(23, 59, 59, 999)' : time_of_day_gleam
      gleam_date_time date time_of_day ($'duration.seconds(0)  ' : duration_gleam)

  := max_value_lua () : date_time =
      := stamp : optionm'::option' date_time = $'os.time{year=9999, month=12, day=31, hour=23, min=59, sec=59}'
      stamp |> optionm'::default_value' ($'253402300799' : date_time)

  := max_value_python () : date_time =
      global "import datetime"
      $'datetime.datetime.max' : date_time

  := max_value_rust () : date_time = rust_date_at_nano (rust_naive_date 9999i32 12u32 31u32) 23u32 59u32 59u32 999999900u32

  := max_value () : date_time =
      backend_switch {
          Gleam = \ () => max_value_gleam ()
          Lua = \ () => max_value_lua ()
          Fsharp = \ () => $'System.DateTime.MaxValue' : date_time
          Python = \ () => max_value_python ()
          Rust = \ () => max_value_rust ()
          Zig = \ () => 253402300799999999i64 |> zig_date_time_of
      }
  """,
  timeout: 300_000
)
```

