<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":":! duration' =\n    `(\n        rust::rust_type\n            `($'std_time_Duration')\n            `($'std::time::Duration')\n            \"type std_time_Duration = class end\"\n    )\n\n:! date_time' t =\n    `(\n        rust::rust_type\n            `($'chrono_DateTime<`t>')\n            `($'chrono::DateTime<`t>')\n            \"type chrono_DateTime<'T> = class end\"\n    )\n\n:! local =\n    `(\n        rust::rust_type\n            `($'chrono_Local')\n            `($'chrono::Local')\n            \"type chrono_Local = class end\"\n    )\n\n:! naive_date_time =\n    `(\n        rust::rust_type\n            `($'chrono_NaiveDateTime')\n            `($'chrono::NaiveDateTime')\n            \"type chrono_NaiveDateTime = class end\"\n    )\n\n:! utc =\n    `(\n        rust::rust_type\n            `($'chrono_Utc')\n            `($'chrono::Utc')\n            \"type chrono_Utc = class end\"\n    )\n\n:= naive_utc (date_time : date_time' utc) : naive_date_time =\n    !\\\\(date_time, $'\"$0.naive_utc()\"')\n\n:= to_local (date_time : date_time' utc) : date_time' local =\n    := naive_date_time = date_time |> naive_utc\n    !\\\\(naive_date_time, $'\"chrono::offset::TimeZone::from_utc_datetime(&chrono::Local, &$0)\"')\n\n:= from_timestamp_micros \\* t {number; int}. (timestamp : t) : option (date_time' utc) =\n    := result : optionm'::option' (date_time' utc) =\n        !\\\\(timestamp, $'\"chrono::DateTime::from_timestamp_micros($0)\"')\n    result |> optionm'::unbox\n\n:= format' (format : string) (date_time : date_time' utc) : sm'::std_string =\n    !\\\\((date_time, #format), $'\"$0.format($1).to_string()\"')\n\n:= format'' (format : string) (date_time : date_time' _) : sm'::std_string =\n    !\\\\((date_time, #format), $'\"$0.format($1).to_string()\"')\n\n:= format_timestamp \\* t {number; int}. (timestamp : t) =\n    := timestamp = ~~ timestamp\n    (timestamp / 1000)\n    |> from_timestamp_micros\n    |> optionm::map \\ x =>\n        x\n        |> to_local\n        |> format'' \"%Y-%m-%d %H:%M:%S\"\n        |> sm'::from_std_string\n    |> resultm::from_option\n\n:= duration_from_millis (ms : u64) : duration' =\n    := ms = ~~ ms\n    !\\($'\"std::time::Duration::from_millis(!ms)\"')\n\n:= time_zone_local () : time_zone_info =\n    run_target \\|\n        | Fsharp _ => \\ () =>\n            $'System.TimeZoneInfo.Local'\n        | Rust => \\ () => $'*chrono::Local::now().offset()' : time_zone_info\n        | _ => \\ () => null ()\n\n:= rust_local_offset_seconds (date_time : date_time) : i32 =\n    $'chrono::TimeZone::offset_from_local_datetime(&chrono::Local, \\\n        &!date_time).earliest().map(|o| o.local_minus_utc()).unwrap_or(0)' : i32\n\n:= rust_utc_offset (date_time : date_time) : time_span =\n    := seconds : i64 = conv (rust_local_offset_seconds date_time)\n    $'chrono::TimeDelta::seconds(!seconds)' : time_span\n\n:= gleam_utc_offset () : time_span =\n    global \"import gleam/time/duration\"\n    := duration = $'calendar.utc_offset()' : duration_gleam\n    duration\n    |> $'duration.to_seconds'\n    |> ((*) 10000000i32)\n    |> convert::convert\n    |> \\ x => x : int\n    |> convert::unbox\n\n:= lua_utc_offset (date_time : date_time) : time_span =\n    := date_time = date_time |> convert::unbox : int\n    := offset = 5i32 * 3600i32\n    offset * 10000000 |> convert::convert : time_span\n\n:= other_utc_offset target (date_time : date_time) : time_span =\n    backend_switch {\n        Gleam = \\ () => gleam_utc_offset ()\n        Lua = \\ () => lua_utc_offset date_time\n        Fsharp = \\ () => failwith $'$\"date_time.get_utc_offset / target: {!target}\"' : time_span\n        Python = \\ () => $'!date_time.utcoffset()' : time_span\n    }\n\n:= get_utc_offset (time_zone_info : time_zone_info) (date_time : date_time) : time_span =\n    run_target \\|\n        | Fsharp _ => \\ () => date_time |> $'_.GetUtcOffset' (time_zone_local ())\n        | Rust => \\ () => rust_utc_offset date_time\n        | target => \\ () => other_utc_offset target date_time\n\n:= guid_sub_micro_digit (date_time : date_time) : i64 =\n    run_target \\|\n        | Fsharp => \\ () => $'(!date_time.Ticks % 10L)' : i64\n        | Rust => \\ () =>\n            := nanos : u32 = $'!date_time.and_utc().timestamp_subsec_nanos()'\n            conv (nanos / 100u32 % 10u32) : i64\n        | _ => \\ () => 0i64\n\n:= with_guid_sub_micro_digit (digit : i64) (date_time : date_time) : date_time =\n    run_target \\|\n        | Fsharp => \\ () => $'!date_time.AddTicks(!digit)' : date_time\n        | Rust => \\ () => $'(!date_time + chrono::TimeDelta::nanoseconds(!digit * 100))' : date_time\n        | _ => \\ () => date_time\n\n:= guid_date_part (year : i64) (month : i64) (day : i64) : string =\n    pad_digits 4i32 year ++# pad_digits 2i32 month ++# pad_digits 2i32 day\n\n:= guid_clock_part (hour : i64) (minute : i64) (second : i64) : string =\n    pad_digits 2i32 hour ++# pad_digits 2i32 minute ++# \"-\" ++# pad_digits 2i32 second\n\n:= guid_fraction_part (fraction : string) : string =\n    (fraction |> sm'::slice 0i32 1i32) ++# \"-\" ++# (fraction |> sm'::slice 2i32 5i32) ++# \"-\" ++# (fraction |> sm'::slice 6i32 6i32)\n\n:= guid_prefix_of_micros (micros : i64) (sub_micro : i64) : string =\n    := year, month, day, hour, minute, second, fraction_micros = civil_of_micros micros\n    := fraction = pad_digits 7i32 (fraction_micros * 10 + sub_micro)\n    guid_date_part year month day ++# \"-\" ++# guid_clock_part hour minute second ++# guid_fraction_part fraction\n\n:= guid_offset_text (date_time : date_time) : string =\n    := time_zone = date_time |> get_utc_offset (time_zone_local ())\n    := time_zone_signal = ? hours time_zone > 0 ?> 1u8 |: 0\n    := time_zone_value = time_zone |> time_span_format (~~ \"hhmm\")\n    #?time_zone_signal ++# time_zone_value\n\n:= guid_time_zone (date_time : date_time) : string =\n    run_target \\|\n        | Zig => \\ () => \"00000\"\n        | _ => \\ () => guid_offset_text date_time\n\n:= guid_with_prefix (guid' : guid::guid) (prefix : string) (time_zone : string) : date_time_guid =\n    := guid_range =\n        guid'\n        |> guid::to_string\n        |> sm'::range\n            (am'::Start (##prefix + ##time_zone))\n            (am'::End eval)\n    prefix ++# time_zone ++# guid_range |> guid::new_guid\n\n:~ date_time_guid_from_date_time (guid' : guid::guid) (date_time : date_time) =\n    := micros = date_time |> to_timestamp |> \\ (timestamp micros) => micros\n    := prefix = guid_prefix_of_micros micros (guid_sub_micro_digit date_time)\n    guid_with_prefix guid' prefix (guid_time_zone date_time)","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  :! duration' =
      `(
          rust::rust_type
              `($'std_time_Duration')
              `($'std::time::Duration')
              "type std_time_Duration = class end"
      )

  :! date_time' t =
      `(
          rust::rust_type
              `($'chrono_DateTime<`t>')
              `($'chrono::DateTime<`t>')
              "type chrono_DateTime<'T> = class end"
      )

  :! local =
      `(
          rust::rust_type
              `($'chrono_Local')
              `($'chrono::Local')
              "type chrono_Local = class end"
      )

  :! naive_date_time =
      `(
          rust::rust_type
              `($'chrono_NaiveDateTime')
              `($'chrono::NaiveDateTime')
              "type chrono_NaiveDateTime = class end"
      )

  :! utc =
      `(
          rust::rust_type
              `($'chrono_Utc')
              `($'chrono::Utc')
              "type chrono_Utc = class end"
      )

  := naive_utc (date_time : date_time' utc) : naive_date_time =
      !\\(date_time, $'"$0.naive_utc()"')

  := to_local (date_time : date_time' utc) : date_time' local =
      := naive_date_time = date_time |> naive_utc
      !\\(naive_date_time, $'"chrono::offset::TimeZone::from_utc_datetime(&chrono::Local, &$0)"')

  := from_timestamp_micros \* t {number; int}. (timestamp : t) : option (date_time' utc) =
      := result : optionm'::option' (date_time' utc) =
          !\\(timestamp, $'"chrono::DateTime::from_timestamp_micros($0)"')
      result |> optionm'::unbox

  := format' (format : string) (date_time : date_time' utc) : sm'::std_string =
      !\\((date_time, #format), $'"$0.format($1).to_string()"')

  := format'' (format : string) (date_time : date_time' _) : sm'::std_string =
      !\\((date_time, #format), $'"$0.format($1).to_string()"')

  := format_timestamp \* t {number; int}. (timestamp : t) =
      := timestamp = ~~ timestamp
      (timestamp / 1000)
      |> from_timestamp_micros
      |> optionm::map \ x =>
          x
          |> to_local
          |> format'' "%Y-%m-%d %H:%M:%S"
          |> sm'::from_std_string
      |> resultm::from_option

  := duration_from_millis (ms : u64) : duration' =
      := ms = ~~ ms
      !\($'"std::time::Duration::from_millis(!ms)"')

  := time_zone_local () : time_zone_info =
      run_target \|
          | Fsharp _ => \ () =>
              $'System.TimeZoneInfo.Local'
          | Rust => \ () => $'*chrono::Local::now().offset()' : time_zone_info
          | _ => \ () => null ()

  := rust_local_offset_seconds (date_time : date_time) : i32 =
      $'chrono::TimeZone::offset_from_local_datetime(&chrono::Local, \
          &!date_time).earliest().map(|o| o.local_minus_utc()).unwrap_or(0)' : i32

  := rust_utc_offset (date_time : date_time) : time_span =
      := seconds : i64 = conv (rust_local_offset_seconds date_time)
      $'chrono::TimeDelta::seconds(!seconds)' : time_span

  := gleam_utc_offset () : time_span =
      global "import gleam/time/duration"
      := duration = $'calendar.utc_offset()' : duration_gleam
      duration
      |> $'duration.to_seconds'
      |> ((*) 10000000i32)
      |> convert::convert
      |> \ x => x : int
      |> convert::unbox

  := lua_utc_offset (date_time : date_time) : time_span =
      := date_time = date_time |> convert::unbox : int
      := offset = 5i32 * 3600i32
      offset * 10000000 |> convert::convert : time_span

  := other_utc_offset target (date_time : date_time) : time_span =
      backend_switch {
          Gleam = \ () => gleam_utc_offset ()
          Lua = \ () => lua_utc_offset date_time
          Fsharp = \ () => failwith $'$"date_time.get_utc_offset / target: {!target}"' : time_span
          Python = \ () => $'!date_time.utcoffset()' : time_span
      }

  := get_utc_offset (time_zone_info : time_zone_info) (date_time : date_time) : time_span =
      run_target \|
          | Fsharp _ => \ () => date_time |> $'_.GetUtcOffset' (time_zone_local ())
          | Rust => \ () => rust_utc_offset date_time
          | target => \ () => other_utc_offset target date_time

  := guid_sub_micro_digit (date_time : date_time) : i64 =
      run_target \|
          | Fsharp => \ () => $'(!date_time.Ticks % 10L)' : i64
          | Rust => \ () =>
              := nanos : u32 = $'!date_time.and_utc().timestamp_subsec_nanos()'
              conv (nanos / 100u32 % 10u32) : i64
          | _ => \ () => 0i64

  := with_guid_sub_micro_digit (digit : i64) (date_time : date_time) : date_time =
      run_target \|
          | Fsharp => \ () => $'!date_time.AddTicks(!digit)' : date_time
          | Rust => \ () => $'(!date_time + chrono::TimeDelta::nanoseconds(!digit * 100))' : date_time
          | _ => \ () => date_time

  := guid_date_part (year : i64) (month : i64) (day : i64) : string =
      pad_digits 4i32 year ++# pad_digits 2i32 month ++# pad_digits 2i32 day

  := guid_clock_part (hour : i64) (minute : i64) (second : i64) : string =
      pad_digits 2i32 hour ++# pad_digits 2i32 minute ++# "-" ++# pad_digits 2i32 second

  := guid_fraction_part (fraction : string) : string =
      (fraction |> sm'::slice 0i32 1i32) ++# "-" ++# (fraction |> sm'::slice 2i32 5i32) ++# "-" ++# (fraction |> sm'::slice 6i32 6i32)

  := guid_prefix_of_micros (micros : i64) (sub_micro : i64) : string =
      := year, month, day, hour, minute, second, fraction_micros = civil_of_micros micros
      := fraction = pad_digits 7i32 (fraction_micros * 10 + sub_micro)
      guid_date_part year month day ++# "-" ++# guid_clock_part hour minute second ++# guid_fraction_part fraction

  := guid_offset_text (date_time : date_time) : string =
      := time_zone = date_time |> get_utc_offset (time_zone_local ())
      := time_zone_signal = ? hours time_zone > 0 ?> 1u8 |: 0
      := time_zone_value = time_zone |> time_span_format (~~ "hhmm")
      #?time_zone_signal ++# time_zone_value

  := guid_time_zone (date_time : date_time) : string =
      run_target \|
          | Zig => \ () => "00000"
          | _ => \ () => guid_offset_text date_time

  := guid_with_prefix (guid' : guid::guid) (prefix : string) (time_zone : string) : date_time_guid =
      := guid_range =
          guid'
          |> guid::to_string
          |> sm'::range
              (am'::Start (##prefix + ##time_zone))
              (am'::End eval)
      prefix ++# time_zone ++# guid_range |> guid::new_guid

  :~ date_time_guid_from_date_time (guid' : guid::guid) (date_time : date_time) =
      := micros = date_time |> to_timestamp |> \ (timestamp micros) => micros
      := prefix = guid_prefix_of_micros micros (guid_sub_micro_digit date_time)
      guid_with_prefix guid' prefix (guid_time_zone date_time)
  """,
  timeout: 300_000
)
```

