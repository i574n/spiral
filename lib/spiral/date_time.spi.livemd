<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":"///- --test --symbol\n///> rust -d chrono\n///> typescript\n\n:= later = date_time_milliseconds 2002 2 2 20 22 24 26\n:= earlier = date_time_milliseconds 2002 2 2 10 11 12 26\n:= custom = later |> new_time_span earlier |> time_span_format \"hh-mm-ss\"\n(custom, earlier |> new_time_span later |> time_span_format \"c\") |> _assert_eq (\"10-11-12\", \"-10:11:12\")","print_code":false},"livebook_object":"smart_cell"} -->

