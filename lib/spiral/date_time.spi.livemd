)
```

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":"///> fsharp\n\n:= fsharp_to_guid_exports () : () =\n    $'let date_time_guid_from_date_time x = !date_time_guid_from_date_time x' : ()\n    $'let timestamp_guid_from_timestamp x = !timestamp_guid_from_timestamp x' : ()\n\n:= fsharp_from_guid_exports () : () =\n    $'let date_time_from_guid x = !date_time_from_guid x' : ()\n    $'let timestamp_from_guid x = !timestamp_from_guid x' : ()\n\n:= fsharp_new_guid_exports () : () =\n    $'let new_guid_from_date_time x = !new_guid_from_date_time x' : ()\n    $'let new_guid_from_timestamp x = !new_guid_from_timestamp x' : ()\n\n:= fsharp_format_exports () : () =\n    $'let format x = !format x' : ()\n    $'let format_iso8601 x = !format_iso8601 x' : ()\n\n:= main () =\n    fsharp_to_guid_exports ()\n    fsharp_from_guid_exports ()\n    fsharp_new_guid_exports ()\n    fsharp_format_exports ()","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  ///> fsharp

  := fsharp_to_guid_exports () : () =
      $'let date_time_guid_from_date_time x = !date_time_guid_from_date_time x' : ()
      $'let timestamp_guid_from_timestamp x = !timestamp_guid_from_timestamp x' : ()

  := fsharp_from_guid_exports () : () =
      $'let date_time_from_guid x = !date_time_from_guid x' : ()
      $'let timestamp_from_guid x = !timestamp_from_guid x' : ()

  := fsharp_new_guid_exports () : () =
      $'let new_guid_from_date_time x = !new_guid_from_date_time x' : ()
      $'let new_guid_from_timestamp x = !new_guid_from_timestamp x' : ()

  := fsharp_format_exports () : () =
      $'let format x = !format x' : ()
      $'let format_iso8601 x = !format_iso8601 x' : ()

  := main () =
      fsharp_to_guid_exports ()
      fsharp_from_guid_exports ()
      fsharp_new_guid_exports ()
      fsharp_format_exports ()
  """,
  timeout: 300_000
)
