<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":":= span_two_digits (n : i64) : string = sm'::pad_left 2 '0' (\"\" ++#? n)\n\n:= span_fields (a : i64) : i64 * i64 * i64 * i64 * i64 =\n    a / 864000000000i64, (a / 36000000000i64) % 24i64, (a / 600000000i64) % 60i64, (a / 10000000i64) % 60i64, a % 10000000i64\n\n:= day_prefix (days : i64) : string = ? days > 0i64 ?> \"\" ++#? days ++# \".\" |: \"\"\n\n:= fraction_suffix (fraction : i64) : string = ? fraction > 0i64 ?> \".\" ++# sm'::pad_left 7 '0' (\"\" ++#? fraction) |: \"\"\n\n:= clock_text (hours : i64) (minutes : i64) (seconds : i64) : string =\n    span_two_digits hours ++# \":\" ++# span_two_digits minutes ++# \":\" ++# span_two_digits seconds\n\n:= constant_span_text (negative : bool) (fields : i64 * i64 * i64 * i64 * i64) : string =\n    := days, hours, minutes, seconds, fraction = fields\n    := sign = ? negative ?> \"-\" |: \"\"\n    sign ++# day_prefix days ++# clock_text hours minutes seconds ++# fraction_suffix fraction\n\n:= custom_span_text (format : string) (fields : i64 * i64 * i64 * i64 * i64) : string =\n    := _, hours, minutes, seconds, _ = fields\n    := with_hours = format |> sm'::replace \"hh\" (span_two_digits hours)\n    with_hours |> sm'::replace \"mm\" (span_two_digits minutes) |> sm'::replace \"ss\" (span_two_digits seconds)\n\n:= time_span_ticks_text (format : string) (ticks : i64) : string =\n    := negative = ticks < 0i64\n    := fields = span_fields (? negative ?> 0i64 - ticks |: ticks)\n    ? format = \"\" || format = \"c\" ?> constant_span_text negative fields |: custom_span_text format fields\n\n:= rust_time_span_nanoseconds (time_span : time_span) : i64 = $'!time_span.num_nanoseconds().unwrap()' : i64\n\n:= typescript_time_span_milliseconds (time_span : time_span) : f64 = $'!time_span' : f64\n\n:= typescript_span_text (format : string) (time_span : time_span) : string =\n    := milliseconds : i64 = conv (typescript_time_span_milliseconds time_span)\n    time_span_ticks_text format (milliseconds * 10000i64)\n\n:= rust_span_text (format : string) (time_span : time_span) : string =\n    time_span_ticks_text format (rust_time_span_nanoseconds time_span / 100i64)\n\n:= gleam_span_tempo (time_span : time_span) : tempo_date_time =\n    global \"import tempo/datetime\"\n    time_span\n    |> $'duration.seconds'\n    |> \\ x => x : duration_gleam\n    |> $'datetime.from_duration'\n\n:= gleam_span_text (format : string) (time_span : time_span) : string =\n    := tempo_date_time = gleam_span_tempo time_span\n    := pattern = ? format = \"\" ?> \"c\" |: format\n    $'!tempo_date_time |> datetime.format(tempo.Custom(!pattern))' : string\n\n:= lua_two n : string = sm'::pad_left 2 '0' #?n\n\n:= lua_clock_text (time_span : time_span) : string =\n    := total_seconds = time_span |> convert::unbox : f64\n    := hours = total_seconds / 3600\n    := minutes = (total_seconds % 3600) / 60\n    := seconds = total_seconds % 60\n    lua_two hours ++# \":\" ++# lua_two minutes ++# \":\" ++# lua_two seconds\n\n:= millis_suffix (result : string) (ms : i32) : string =\n    ? ms <= 0\n    ?> result\n    |:\n        := ms =\n            #?**ms\n            |> sm'::pad_left 3 '0'\n            |> sm'::pad_right 7 '0'\n        result ++# \".\" ++# ms\n\n:= python_clock_text (time_span : time_span) : string =\n    := date = $'!time_span + !(min_value ())' : date_time\n    := time = $'!date.strftime(\"%H:%M:%S\")' : string\n    := days = time_span |> days\n    ? days <= 0 ?> time |: #?**days ++# \".\" ++# time\n\n:= other_span_text (format : string) (time_span : time_span) : string =\n    backend_switch {\n        Gleam = \\ () => gleam_span_text format time_span\n        Lua = \\ () => millis_suffix (lua_clock_text time_span) (time_span |> milliseconds)\n        Fsharp = \\ () => $'!time_span.ToString !format ' : string\n        Python = \\ () => millis_suffix (python_clock_text time_span) (time_span |> milliseconds)\n    }\n\n:= time_span_format (format : string) (time_span : time_span) : string =\n    run_target_args (\\ () => format, time_span) \\|\n        | TypeScript => \\ format, span => typescript_span_text format span\n        | Rust => \\ format, span => rust_span_text format span\n        | _ => \\ format, span => other_span_text format span","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  := span_two_digits (n : i64) : string = sm'::pad_left 2 '0' ("" ++#? n)

  := span_fields (a : i64) : i64 * i64 * i64 * i64 * i64 =
      a / 864000000000i64, (a / 36000000000i64) % 24i64, (a / 600000000i64) % 60i64, (a / 10000000i64) % 60i64, a % 10000000i64

  := day_prefix (days : i64) : string = ? days > 0i64 ?> "" ++#? days ++# "." |: ""

  := fraction_suffix (fraction : i64) : string = ? fraction > 0i64 ?> "." ++# sm'::pad_left 7 '0' ("" ++#? fraction) |: ""

  := clock_text (hours : i64) (minutes : i64) (seconds : i64) : string =
      span_two_digits hours ++# ":" ++# span_two_digits minutes ++# ":" ++# span_two_digits seconds

  := constant_span_text (negative : bool) (fields : i64 * i64 * i64 * i64 * i64) : string =
      := days, hours, minutes, seconds, fraction = fields
      := sign = ? negative ?> "-" |: ""
      sign ++# day_prefix days ++# clock_text hours minutes seconds ++# fraction_suffix fraction

  := custom_span_text (format : string) (fields : i64 * i64 * i64 * i64 * i64) : string =
      := _, hours, minutes, seconds, _ = fields
      := with_hours = format |> sm'::replace "hh" (span_two_digits hours)
      with_hours |> sm'::replace "mm" (span_two_digits minutes) |> sm'::replace "ss" (span_two_digits seconds)

  := time_span_ticks_text (format : string) (ticks : i64) : string =
      := negative = ticks < 0i64
      := fields = span_fields (? negative ?> 0i64 - ticks |: ticks)
      ? format = "" || format = "c" ?> constant_span_text negative fields |: custom_span_text format fields

  := rust_time_span_nanoseconds (time_span : time_span) : i64 = $'!time_span.num_nanoseconds().unwrap()' : i64

  := typescript_time_span_milliseconds (time_span : time_span) : f64 = $'!time_span' : f64

  := typescript_span_text (format : string) (time_span : time_span) : string =
      := milliseconds : i64 = conv (typescript_time_span_milliseconds time_span)
      time_span_ticks_text format (milliseconds * 10000i64)

  := rust_span_text (format : string) (time_span : time_span) : string =
      time_span_ticks_text format (rust_time_span_nanoseconds time_span / 100i64)

  := gleam_span_tempo (time_span : time_span) : tempo_date_time =
      global "import tempo/datetime"
      time_span
      |> $'duration.seconds'
      |> \ x => x : duration_gleam
      |> $'datetime.from_duration'

  := gleam_span_text (format : string) (time_span : time_span) : string =
      := tempo_date_time = gleam_span_tempo time_span
      := pattern = ? format = "" ?> "c" |: format
      $'!tempo_date_time |> datetime.format(tempo.Custom(!pattern))' : string

  := lua_two n : string = sm'::pad_left 2 '0' #?n

  := lua_clock_text (time_span : time_span) : string =
      := total_seconds = time_span |> convert::unbox : f64
      := hours = total_seconds / 3600
      := minutes = (total_seconds % 3600) / 60
      := seconds = total_seconds % 60
      lua_two hours ++# ":" ++# lua_two minutes ++# ":" ++# lua_two seconds

  := millis_suffix (result : string) (ms : i32) : string =
      ? ms <= 0
      ?> result
      |:
          := ms =
              #?**ms
              |> sm'::pad_left 3 '0'
              |> sm'::pad_right 7 '0'
          result ++# "." ++# ms

  := python_clock_text (time_span : time_span) : string =
      := date = $'!time_span + !(min_value ())' : date_time
      := time = $'!date.strftime("%H:%M:%S")' : string
      := days = time_span |> days
      ? days <= 0 ?> time |: #?**days ++# "." ++# time

  := other_span_text (format : string) (time_span : time_span) : string =
      backend_switch {
          Gleam = \ () => gleam_span_text format time_span
          Lua = \ () => millis_suffix (lua_clock_text time_span) (time_span |> milliseconds)
          Fsharp = \ () => $'!time_span.ToString !format ' : string
          Python = \ () => millis_suffix (python_clock_text time_span) (time_span |> milliseconds)
      }

  := time_span_format (format : string) (time_span : time_span) : string =
      run_target_args (\ () => format, time_span) \|
          | TypeScript => \ format, span => typescript_span_text format span
          | Rust => \ format, span => rust_span_text format span
          | _ => \ format, span => other_span_text format span
  """,
  timeout: 300_000
)
```

