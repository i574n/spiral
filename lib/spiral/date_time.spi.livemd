<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":":= guid_field (text : string) (first : i32) (last : i32) : i64 =\n    text |> sm'::slice first last |> convert::try_convert |> optionm::value\n\n:= guid_seconds (text : string) : i64 =\n    := field = guid_field text\n    := days = days_from_civil (field 0i32 3i32) (field 4i32 5i32) (field 6i32 7i32)\n    days * 86400 + field 9i32 10i32 * 3600 + field 11i32 12i32 * 60 + field 14i32 15i32\n\n:= guid_fraction (text : string) : i64 =\n    := field = guid_field text\n    field 16i32 17i32 * 100000 + field 19i32 22i32 * 10 + field 24i32 24i32\n\n:= micros_of_guid_prefix (text : string) : i64 * i64 =\n    := seconds = guid_seconds text\n    := fraction = guid_fraction text\n    seconds * 1000000 + fraction / 10, fraction % 10\n\n:= date_time_from_guid (date_time_guid : date_time_guid) : date_time =\n    := micros, sub_micro = date_time_guid |> guid::to_string |> micros_of_guid_prefix\n    micros |> timestamp |> to_calendar_utc |> with_guid_sub_micro_digit sub_micro","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  := guid_field (text : string) (first : i32) (last : i32) : i64 =
      text |> sm'::slice first last |> convert::try_convert |> optionm::value

  := guid_seconds (text : string) : i64 =
      := field = guid_field text
      := days = days_from_civil (field 0i32 3i32) (field 4i32 5i32) (field 6i32 7i32)
      days * 86400 + field 9i32 10i32 * 3600 + field 11i32 12i32 * 60 + field 14i32 15i32

  := guid_fraction (text : string) : i64 =
      := field = guid_field text
      field 16i32 17i32 * 100000 + field 19i32 22i32 * 10 + field 24i32 24i32

  := micros_of_guid_prefix (text : string) : i64 * i64 =
      := seconds = guid_seconds text
      := fraction = guid_fraction text
      seconds * 1000000 + fraction / 10, fraction % 10

  := date_time_from_guid (date_time_guid : date_time_guid) : date_time =
      := micros, sub_micro = date_time_guid |> guid::to_string |> micros_of_guid_prefix
      micros |> timestamp |> to_calendar_utc |> with_guid_sub_micro_digit sub_micro
  """,
  timeout: 300_000
)
```

