<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":":= timestamp_digits_text (micros : i64) : string =\n    := digits = micros |> sm'::obj_to_string |> sm'::pad_left 18i32 '0'\n    := piece first last = digits |> sm'::slice first last\n    piece 0i32 7i32 ++# \"-\" ++# piece 8i32 11i32 ++# \"-\" ++# piece 12i32 15i32 ++# \"-\" ++# piece 16i32 17i32\n\n:= timestamp_guid_from_timestamp (source : guid::guid) ((timestamp micros) : timestamp) : timestamp_guid =\n    timestamp_digits_text micros ++# (source |> guid::to_string |> sm'::range (am'::Start 21i32) (am'::End eval))\n    |> guid::new_guid","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  := timestamp_digits_text (micros : i64) : string =
      := digits = micros |> sm'::obj_to_string |> sm'::pad_left 18i32 '0'
      := piece first last = digits |> sm'::slice first last
      piece 0i32 7i32 ++# "-" ++# piece 8i32 11i32 ++# "-" ++# piece 12i32 15i32 ++# "-" ++# piece 16i32 17i32

  := timestamp_guid_from_timestamp (source : guid::guid) ((timestamp micros) : timestamp) : timestamp_guid =
      timestamp_digits_text micros ++# (source |> guid::to_string |> sm'::range (am'::Start 21i32) (am'::End eval))
      |> guid::new_guid
  """,
  timeout: 300_000
)
```

