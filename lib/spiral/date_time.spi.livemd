#### calendar_constructors_build_the_same_instants_on_rust (test)

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":"///- --test --symbol\n///> rust -d chrono\n\n:= shown (d : date_time) : string = d |> format \"%Y-%m-%d %H:%M:%S.%f\"\n:= utc, milliseconds = shown (date_time_utc 1970 1 1 0 0 0), shown (date_time_milliseconds 1970 1 1 0 0 0 250)\n(utc, milliseconds, shown (unix_epoch ()), shown (min_value ()), shown (max_value ()))\n|> _assert_eq (\n    \"1970-01-01 00:00:00.000000000\", \"1970-01-01 00:00:00.250000000\", \"1970-01-01 00:00:00.000000000\",\n    \"0001-01-01 00:00:00.000000000\", \"9999-12-31 23:59:59.999999900\"\n)","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  ///- --test --symbol
  ///> rust -d chrono

  := shown (d : date_time) : string = d |> format "%Y-%m-%d %H:%M:%S.%f"
  := utc, milliseconds = shown (date_time_utc 1970 1 1 0 0 0), shown (date_time_milliseconds 1970 1 1 0 0 0 250)
  (utc, milliseconds, shown (unix_epoch ()), shown (min_value ()), shown (max_value ()))
  |> _assert_eq (
      "1970-01-01 00:00:00.000000000", "1970-01-01 00:00:00.250000000", "1970-01-01 00:00:00.000000000",
      "0001-01-01 00:00:00.000000000", "9999-12-31 23:59:59.999999900"
  )
  """,
  timeout: 300_000
)
```

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":":| date_time_kind =\n    | Unspecified\n    | Utc\n    | Local\n\n:= fsharp_date_kind (kind : date_time_kind) : $'System.DateTimeKind' =\n    ?= kind ?|\n    | Unspecified => $'System.DateTimeKind.Unspecified'\n    | Utc => $'System.DateTimeKind.Utc'\n    | Local => $'System.DateTimeKind.Local'\n\n:= fsharp_specified (kind : date_time_kind) (date_time : date_time) : date_time =\n    := kind = fsharp_date_kind kind\n    $'System.DateTime.SpecifyKind (!date_time, !kind)' : date_time\n\n:= specify_date_kind (kind : date_time_kind) (date_time : date_time) : date_time =\n    backend_switch {\n        Gleam = \\ () => date_time\n        Lua = \\ () => date_time\n        Fsharp = \\ () => fsharp_specified kind date_time\n        Python = \\ () => $'!date_time.replace(tzinfo=None)' : date_time\n        Rust = \\ () => date_time\n        Zig = \\ () => date_time\n    }\n\n:= python_utc (date_time : date_time) : date_time =\n    global \"import datetime\"\n    $'!date_time.replace(tzinfo=datetime.timezone.utc)' : date_time\n\n:= to_universal_time (date_time : date_time) : date_time =\n    backend_switch {\n        Gleam = \\ () => date_time\n        Lua = \\ () => date_time\n        Fsharp = \\ () => date_time |> $'_.ToUniversalTime()' : date_time\n        Python = \\ () => python_utc date_time\n        Rust = \\ () => date_time\n        Zig = \\ () => date_time\n    }","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  :| date_time_kind =
      | Unspecified
      | Utc
      | Local

  := fsharp_date_kind (kind : date_time_kind) : $'System.DateTimeKind' =
      ?= kind ?|
      | Unspecified => $'System.DateTimeKind.Unspecified'
      | Utc => $'System.DateTimeKind.Utc'
      | Local => $'System.DateTimeKind.Local'

  := fsharp_specified (kind : date_time_kind) (date_time : date_time) : date_time =
      := kind = fsharp_date_kind kind
      $'System.DateTime.SpecifyKind (!date_time, !kind)' : date_time

  := specify_date_kind (kind : date_time_kind) (date_time : date_time) : date_time =
      backend_switch {
          Gleam = \ () => date_time
          Lua = \ () => date_time
          Fsharp = \ () => fsharp_specified kind date_time
          Python = \ () => $'!date_time.replace(tzinfo=None)' : date_time
          Rust = \ () => date_time
          Zig = \ () => date_time
      }

  := python_utc (date_time : date_time) : date_time =
      global "import datetime"
      $'!date_time.replace(tzinfo=datetime.timezone.utc)' : date_time

  := to_universal_time (date_time : date_time) : date_time =
      backend_switch {
          Gleam = \ () => date_time
          Lua = \ () => date_time
          Fsharp = \ () => date_time |> $'_.ToUniversalTime()' : date_time
          Python = \ () => python_utc date_time
          Rust = \ () => date_time
          Zig = \ () => date_time
      }
  """,
  timeout: 300_000
)
```

