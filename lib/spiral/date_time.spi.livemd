<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":":= fsharp_span_of_micros (micros : i64) : time_span =\n    := ticks = micros * 10i64\n    $'System.TimeSpan.FromTicks(!ticks)' : time_span\n\n:= python_span_of_micros (micros : i64) : time_span =\n    global \"import datetime\"\n    $'datetime.timedelta(microseconds=!micros)' : time_span\n\n:= time_span_of_micros (micros : i64) : time_span =\n    backend_switch {\n        Gleam = \\ () => micros / 1000000 |> convert::unbox : time_span\n        Lua = \\ () => $'!micros / 1000000' : time_span\n        Fsharp = \\ () => fsharp_span_of_micros micros\n        Python = \\ () => python_span_of_micros micros\n        Rust = \\ () => $'chrono::TimeDelta::microseconds(!micros)' : time_span\n    }","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  := fsharp_span_of_micros (micros : i64) : time_span =
      := ticks = micros * 10i64
      $'System.TimeSpan.FromTicks(!ticks)' : time_span

  := python_span_of_micros (micros : i64) : time_span =
      global "import datetime"
      $'datetime.timedelta(microseconds=!micros)' : time_span

  := time_span_of_micros (micros : i64) : time_span =
      backend_switch {
          Gleam = \ () => micros / 1000000 |> convert::unbox : time_span
          Lua = \ () => $'!micros / 1000000' : time_span
          Fsharp = \ () => fsharp_span_of_micros micros
          Python = \ () => python_span_of_micros micros
          Rust = \ () => $'chrono::TimeDelta::microseconds(!micros)' : time_span
      }
  """,
  timeout: 300_000
)
