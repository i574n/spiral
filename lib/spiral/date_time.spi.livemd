#### zig_date_time_is_micros_since_the_unix_epoch (test)

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":"///- --test --symbol\n///> zig\n\nunix_epoch () |> format \"yyyy-MM-dd HH:mm:ss\" |> _assert_eq \"1970-01-01 00:00:00\"\nmin_value () |> get_year |> _assert_eq 1i32\nmax_value () |> get_year |> _assert_eq 9999i32\nunix_epoch () |> add_days 1i32 |> format \"yyyy-MM-dd\" |> _assert_eq \"1970-01-02\"\nmax_value () |> format \"HH:mm:ss.ffffff\" |> _assert_eq \"23:59:59.999999\"\nunix_epoch () |> add_days -1i32 |> format_iso8601 |> _assert_eq \"1969-12-31T00-00-00.000\"","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  ///- --test --symbol
  ///> zig

  unix_epoch () |> format "yyyy-MM-dd HH:mm:ss" |> _assert_eq "1970-01-01 00:00:00"
  min_value () |> get_year |> _assert_eq 1i32
  max_value () |> get_year |> _assert_eq 9999i32
  unix_epoch () |> add_days 1i32 |> format "yyyy-MM-dd" |> _assert_eq "1970-01-02"
  max_value () |> format "HH:mm:ss.ffffff" |> _assert_eq "23:59:59.999999"
  unix_epoch () |> add_days -1i32 |> format_iso8601 |> _assert_eq "1969-12-31T00-00-00.000"
  """,
  timeout: 300_000
)
```

#### stopwatch_microseconds_agree_with_milliseconds (test)

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":"///- --test --symbol\n///> rust\n///> pascal\n\n:= watch = stopwatch ()\nstopwatch_start watch\n:= before = stopwatch_elapsed_microseconds watch\n:= millis = stopwatch_elapsed_milliseconds watch\n:= after = stopwatch_elapsed_microseconds watch\n? before < 0i64 ?> failwith \"elapsed microseconds are never negative\"\n? after < before ?> failwith \"elapsed microseconds never go back\"\n? millis * 1000i64 > after ?> failwith \"the millisecond reading never runs ahead of a later microsecond reading\"","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  ///- --test --symbol
  ///> rust
  ///> pascal

  := watch = stopwatch ()
  stopwatch_start watch
  := before = stopwatch_elapsed_microseconds watch
  := millis = stopwatch_elapsed_milliseconds watch
  := after = stopwatch_elapsed_microseconds watch
  ? before < 0i64 ?> failwith "elapsed microseconds are never negative"
  ? after < before ?> failwith "elapsed microseconds never go back"
  ? millis * 1000i64 > after ?> failwith "the millisecond reading never runs ahead of a later microsecond reading"
  """,
  timeout: 300_000
)
```

