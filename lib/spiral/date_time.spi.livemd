<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":":= date_time_utc_gleam (year : int) (month : int) (day : int) (hour : int) (minute : int) (second : int) : date_time =\n    gleam_time_imports ()\n    := date = gleam_date year month day\n    := time_of_day = $'calendar.TimeOfDay(#hour, #minute, #second, 0)' : time_of_day_gleam\n    gleam_date_time date time_of_day ($'duration.seconds(0)   ' : duration_gleam)\n\n:= date_time_utc_lua (year : int) (month : int) (day : int) (hour : int) (minute : int) (second : int) : date_time =\n    := total_seconds = second + (minute * 60) + (hour * 3600)\n    lua_midnight year month day + total_seconds |> convert::unbox : date_time\n\n:= date_time_utc_python (year : int) (month : int) (day : int) (hour : int) (minute : int) (second : int) : date_time =\n    global \"import datetime\"\n    $'datetime.datetime(!year, !month, !day, !hour, !minute, !second, tzinfo=datetime.timezone.utc)' : date_time\n\n:= date_time_utc_rust (year : int) (month : int) (day : int) (hour : int) (minute : int) (second : int) : date_time =\n    := date = rust_naive_date (conv year) (conv month) (conv day)\n    rust_date_at date (conv hour) (conv minute) (conv second)\n\n:= fsharp_utc (year : int) (month : int) (day : int) (hour : int) (minute : int) (second : int) : date_time =\n    $'System.DateTime (!year, !month, !day, !hour, !minute, !second, System.DateTimeKind.Utc)' : date_time\n\n:= date_time_utc\n    (year : int) (month : int) (day : int) (hour : int) (minute : int) (second : int)\n    : date_time\n    =\n    backend_switch {\n        Gleam = \\ () => date_time_utc_gleam year month day hour minute second\n        Lua = \\ () => date_time_utc_lua year month day hour minute second\n        Fsharp = \\ () => fsharp_utc year month day hour minute second\n        Python = \\ () => date_time_utc_python year month day hour minute second\n        Rust = \\ () => date_time_utc_rust year month day hour minute second\n    }","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  := date_time_utc_gleam (year : int) (month : int) (day : int) (hour : int) (minute : int) (second : int) : date_time =
      gleam_time_imports ()
      := date = gleam_date year month day
      := time_of_day = $'calendar.TimeOfDay(#hour, #minute, #second, 0)' : time_of_day_gleam
      gleam_date_time date time_of_day ($'duration.seconds(0)   ' : duration_gleam)

  := date_time_utc_lua (year : int) (month : int) (day : int) (hour : int) (minute : int) (second : int) : date_time =
      := total_seconds = second + (minute * 60) + (hour * 3600)
      lua_midnight year month day + total_seconds |> convert::unbox : date_time

  := date_time_utc_python (year : int) (month : int) (day : int) (hour : int) (minute : int) (second : int) : date_time =
      global "import datetime"
      $'datetime.datetime(!year, !month, !day, !hour, !minute, !second, tzinfo=datetime.timezone.utc)' : date_time

  := date_time_utc_rust (year : int) (month : int) (day : int) (hour : int) (minute : int) (second : int) : date_time =
      := date = rust_naive_date (conv year) (conv month) (conv day)
      rust_date_at date (conv hour) (conv minute) (conv second)

  := fsharp_utc (year : int) (month : int) (day : int) (hour : int) (minute : int) (second : int) : date_time =
      $'System.DateTime (!year, !month, !day, !hour, !minute, !second, System.DateTimeKind.Utc)' : date_time

  := date_time_utc
      (year : int) (month : int) (day : int) (hour : int) (minute : int) (second : int)
      : date_time
      =
      backend_switch {
          Gleam = \ () => date_time_utc_gleam year month day hour minute second
          Lua = \ () => date_time_utc_lua year month day hour minute second
          Fsharp = \ () => fsharp_utc year month day hour minute second
          Python = \ () => date_time_utc_python year month day hour minute second
          Rust = \ () => date_time_utc_rust year month day hour minute second
      }
  """,
  timeout: 300_000
)
```

