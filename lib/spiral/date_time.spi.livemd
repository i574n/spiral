<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":":= span_seconds_float (time_span : time_span) : f64 = (time_span |> convert::to : i32) |> convert::convert : f64\n\n:= rust_span_hours (time_span : time_span) : i32 =\n    := total : i64 = $'!time_span.num_hours()'\n    conv (total % 24i64) : i32\n\n:= typescript_span_hours (time_span : time_span) : i32 =\n    := total : f64 = $'!time_span'\n    (conv (total / 3600000f64) : i32) % 24i32\n\n:= hours (time_span : time_span) : i32 =\n    backend_switch {\n        Gleam = \\ () => ((span_seconds_float time_span / 3600.0) |> math::floor |> convert::unbox : i32) % 24\n        Lua = \\ () => ((span_seconds_float time_span / 3600.0) |> math::floor |> convert::unbox : i32) % 24\n        Fsharp = \\ () => time_span |> $'_.Hours' : i32\n        Python = \\ () => ($'!time_span.seconds' : i32) / 3600i32\n        Rust = \\ () => rust_span_hours time_span\n        TypeScript = \\ () => typescript_span_hours time_span\n    }","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  := span_seconds_float (time_span : time_span) : f64 = (time_span |> convert::to : i32) |> convert::convert : f64

  := rust_span_hours (time_span : time_span) : i32 =
      := total : i64 = $'!time_span.num_hours()'
      conv (total % 24i64) : i32

  := typescript_span_hours (time_span : time_span) : i32 =
      := total : f64 = $'!time_span'
      (conv (total / 3600000f64) : i32) % 24i32

  := hours (time_span : time_span) : i32 =
      backend_switch {
          Gleam = \ () => ((span_seconds_float time_span / 3600.0) |> math::floor |> convert::unbox : i32) % 24
          Lua = \ () => ((span_seconds_float time_span / 3600.0) |> math::floor |> convert::unbox : i32) % 24
          Fsharp = \ () => time_span |> $'_.Hours' : i32
          Python = \ () => ($'!time_span.seconds' : i32) / 3600i32
          Rust = \ () => rust_span_hours time_span
          TypeScript = \ () => typescript_span_hours time_span
      }
  """,
  timeout: 300_000
)
