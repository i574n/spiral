Spiral.Cells.eval!(
  ":= to_calendar_gleam (timestamp : timestamp_gleam) : date_time =\n    gleam_calendar_imports ()\n    := duration = $'calendar.local_offset()' : duration_gleam\n    := (date : date_gleam), (time_of_day : time_of_day_gleam) = $'!timestamp |> timestamp.to_calendar(!duration)'\n    gleam_date_time date time_of_day duration\n\n:= to_calendar (timestamp : timestamp) : date_time =\n    timestamp |> timestamp_gleam_of |> to_calendar_gleam\n\n:= gleam_now () : date_time =\n    := timestamp = $'timestamp.system_time ()' : timestamp_gleam\n    timestamp |> to_calendar_gleam\n\n:= fsharp_now () : date_time =\n    run_target \\|\n        | _ => \\ () => $'System.DateTime.Now'\n\n:= python_now () : date_time =\n    global \"import datetime\"\n    $'datetime.datetime.now()' : date_time\n\n:= now () : date_time =\n    backend_switch {\n        Gleam = \\ () => gleam_now ()\n        Lua = \\ () => $'os.time()' : date_time\n        Fsharp = \\ () => fsharp_now ()\n        Python = \\ () => python_now ()\n        Rust = \\ () => $'chrono::Local::now().naive_local()' : date_time\n        Zig = \\ () => zig_micros_now () |> zig_date_time_of\n    }\n\n:= gleam_utc_now () : date_time =\n    := timestamp = $'timestamp.system_time ()' : timestamp_gleam\n    timestamp |> to_calendar_utc_gleam\n\n:= python_utc_now () : date_time =\n    global \"import datetime\"\n    $'datetime.datetime.utcnow()' : date_time\n\n:= utc_now () : date_time =\n    backend_switch {\n        Gleam = \\ () => gleam_utc_now ()\n        Lua = \\ () => $'os.time()' : date_time\n        Fsharp = \\ () => $'System.DateTime.UtcNow' : date_time\n        Python = \\ () => python_utc_now ()\n        Rust = \\ () => $'chrono::Utc::now().naive_utc()' : date_time\n        Zig = \\ () => zig_micros_now () |> zig_date_time_of\n    }\n\n:! stopwatch_python =\n    `(\n        global \"import timeit\"\n        $'' : $'timeit.default_timer'\n    )\n:== stopwatch_switch =\n    {\n        Pascal : $'TStopwatch'\n        Fsharp : $'System.Diagnostics.Stopwatch'\n        Python : stopwatch_python\n        Rust : $'std::time::Instant'\n    }\n:! stopwatch = $'backend_switch `(stopwatch_switch)'\n\n:= pascal_stopwatch () : stopwatch =\n    global \"uses System.Diagnostics\"\n    $'TStopwatch.StartNew' : stopwatch\n\n:= stopwatch () : stopwatch =\n    backend_switch {\n        Pascal = \\ () => pascal_stopwatch ()\n        Fsharp = \\ () => $'`stopwatch ()' : stopwatch\n        Python = \\ () => $'`stopwatch ' : stopwatch\n        Rust = \\ () => $'std::time::Instant::now()' : stopwatch\n    }\n\n:= rust_elapsed_milliseconds (stopwatch : stopwatch) : i64 =\n    := elapsed = $'!stopwatch.elapsed()' : rust_std_duration\n    := seconds : u64 = $'!elapsed.as_secs()'\n    := millis : u32 = $'!elapsed.subsec_millis()'\n    (conv seconds : i64) * 1000i64 + conv millis\n\n:= stopwatch_elapsed_milliseconds (stopwatch : stopwatch) : i64 =\n    ? is_rust () ?> rust_elapsed_milliseconds stopwatch |: $'!stopwatch.ElapsedMilliseconds'\n\n:= rust_elapsed_microseconds (stopwatch : stopwatch) : i64 =\n    := elapsed = $'!stopwatch.elapsed()' : rust_std_duration\n    := seconds : u64 = $'!elapsed.as_secs()'\n    := micros : u32 = $'!elapsed.subsec_micros()'\n    (conv seconds : i64) * 1000000i64 + conv micros\n\n:= dotnet_elapsed_microseconds (stopwatch : stopwatch) : i64 =\n    := ticks : i64 = $'!stopwatch.Elapsed.Ticks'\n    ticks / 10i64\n\n:= stopwatch_elapsed_microseconds (stopwatch : stopwatch) : i64 =\n    ? is_rust () ?> rust_elapsed_microseconds stopwatch |: dotnet_elapsed_microseconds stopwatch\n\n:= stopwatch_start (stopwatch : stopwatch) : () =\n    run_target \\|\n        | Rust => \\ () => ()\n        | Pascal => \\ () => ()\n        | _ => \\ () => $'!stopwatch.Start' ()\n\n:= monotonic_milliseconds () : i64 =\n    run_target \\|\n        | Gleam => \\ () =>\n            erlang_term::apply \"erlang\" \"monotonic_time\" [ erlang_term::atom \"millisecond\" ] |> erlang_term::cast\n        | _ => \\ () => failwith \"monotonic_milliseconds: no arm for this backend\"\n\n:= rust_monotonic_global () : () =\n    global \"\"\"\n        fn spiral_monotonic_nanoseconds() -> u64 {\n            static START: std::sync::OnceLock<std::time::Instant> = std::sync::OnceLock::new();\n            START.get_or_init(std::time::Instant::now).elapsed().as_nanos() as u64\n        }\n        \"\"\"\n\n:= rust_monotonic_nanoseconds () : u64 =\n    rust_monotonic_global ()\n    $'spiral_monotonic_nanoseconds()' : u64\n\n:~ monotonic_nanoseconds () : u64 =\n    run_target \\|\n        | Rust => \\ () => rust_monotonic_nanoseconds ()\n        | _ => \\ () => failwith \"monotonic_nanoseconds: no arm for this backend\"",
  timeout: 300_000
)
