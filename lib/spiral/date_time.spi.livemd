<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":":== time_zone_info_switch =\n    {\n        Gleam : $'System.TimeZoneInfo'\n        Lua : $'System.TimeZoneInfo'\n        Fsharp : $'System.TimeZoneInfo'\n        Python : $'System.TimeZoneInfo'\n        Rust : $'chrono::FixedOffset'\n    }\n:! time_zone_info = $'backend_switch `(time_zone_info_switch)'\n\n:= gleam_add_days (days : i32) (date_time : date_time) : date_time =\n    global \"import gleam/time/duration\"\n    := duration = $'duration.days(#days)' : duration_gleam\n    := date, time_of_day, existing_duration = date_time |> split_date_time\n    gleam_date_time date time_of_day ($'!existing_duration + !duration ' : duration_gleam)\n\n:= lua_add_days (days : i32) (date_time : date_time) : date_time =\n    := seconds = days * 86400\n    (date_time |> convert::unbox) + seconds |> convert::unbox : date_time\n\n:= python_add_days (days : i32) (date_time : date_time) : date_time =\n    global \"import datetime\"\n    $'!date_time + datetime.timedelta(days=!days)' : date_time\n\n:= rust_add_days (days : i32) (date_time : date_time) : date_time =\n    := days' : i64 = conv days\n    := delta = $'chrono::TimeDelta::days(!days')' : time_span\n    $'!date_time + !delta' : date_time\n\n:= zig_add_days (days : i32) (date_time : date_time) : date_time =\n    (date_time |> zig_micros_of) + (days |> convert::convert : i64) * 86400000000i64 |> zig_date_time_of\n\n:= add_days (days : i32) (date_time : date_time) : date_time =\n    backend_switch {\n        Gleam = \\ () => gleam_add_days days date_time\n        Lua = \\ () => lua_add_days days date_time\n        Fsharp = \\ () => $'!date_time.AddDays' days : date_time\n        Python = \\ () => python_add_days days date_time\n        Rust = \\ () => rust_add_days days date_time\n        Zig = \\ () => zig_add_days days date_time\n    }","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  :== time_zone_info_switch =
      {
          Gleam : $'System.TimeZoneInfo'
          Lua : $'System.TimeZoneInfo'
          Fsharp : $'System.TimeZoneInfo'
          Python : $'System.TimeZoneInfo'
          Rust : $'chrono::FixedOffset'
      }
  :! time_zone_info = $'backend_switch `(time_zone_info_switch)'

  := gleam_add_days (days : i32) (date_time : date_time) : date_time =
      global "import gleam/time/duration"
      := duration = $'duration.days(#days)' : duration_gleam
      := date, time_of_day, existing_duration = date_time |> split_date_time
      gleam_date_time date time_of_day ($'!existing_duration + !duration ' : duration_gleam)

  := lua_add_days (days : i32) (date_time : date_time) : date_time =
      := seconds = days * 86400
      (date_time |> convert::unbox) + seconds |> convert::unbox : date_time

  := python_add_days (days : i32) (date_time : date_time) : date_time =
      global "import datetime"
      $'!date_time + datetime.timedelta(days=!days)' : date_time

  := rust_add_days (days : i32) (date_time : date_time) : date_time =
      := days' : i64 = conv days
      := delta = $'chrono::TimeDelta::days(!days')' : time_span
      $'!date_time + !delta' : date_time

  := zig_add_days (days : i32) (date_time : date_time) : date_time =
      (date_time |> zig_micros_of) + (days |> convert::convert : i64) * 86400000000i64 |> zig_date_time_of

  := add_days (days : i32) (date_time : date_time) : date_time =
      backend_switch {
          Gleam = \ () => gleam_add_days days date_time
          Lua = \ () => lua_add_days days date_time
          Fsharp = \ () => $'!date_time.AddDays' days : date_time
          Python = \ () => python_add_days days date_time
          Rust = \ () => rust_add_days days date_time
          Zig = \ () => zig_add_days days date_time
      }
  """,
  timeout: 300_000
)
```

#### add_days_moves_the_timestamp (test)

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":"///- --test --symbol\n///> rust -d chrono\n\ndate_time_utc 2026 10 13 12 0 0\n|> add_days 3\n|> to_timestamp\n|> _assert_eq' (1792152000000000i64 |> timestamp)","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  ///- --test --symbol
  ///> rust -d chrono

  date_time_utc 2026 10 13 12 0 0
  |> add_days 3
  |> to_timestamp
  |> _assert_eq' (1792152000000000i64 |> timestamp)
  """,
  timeout: 300_000
)
```

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":":= to_calendar_gleam (timestamp : timestamp_gleam) : date_time =\n    gleam_calendar_imports ()\n    := duration = $'calendar.local_offset()' : duration_gleam\n    := (date : date_gleam), (time_of_day : time_of_day_gleam) = $'!timestamp |> timestamp.to_calendar(!duration)'\n    gleam_date_time date time_of_day duration\n\n:= to_calendar (timestamp : timestamp) : date_time =\n    timestamp |> timestamp_gleam_of |> to_calendar_gleam\n\n:= gleam_now () : date_time =\n    := timestamp = $'timestamp.system_time ()' : timestamp_gleam\n    timestamp |> to_calendar_gleam\n\n:= fsharp_now () : date_time =\n    run_target \\|\n        | _ => \\ () => $'System.DateTime.Now'\n\n:= python_now () : date_time =\n    global \"import datetime\"\n    $'datetime.datetime.now()' : date_time\n\n:= now () : date_time =\n    backend_switch {\n        Gleam = \\ () => gleam_now ()\n        Lua = \\ () => $'os.time()' : date_time\n        Fsharp = \\ () => fsharp_now ()\n        Python = \\ () => python_now ()\n        Rust = \\ () => $'chrono::Local::now().naive_local()' : date_time\n        Zig = \\ () => zig_micros_now () |> zig_date_time_of\n    }\n\n:= gleam_utc_now () : date_time =\n    := timestamp = $'timestamp.system_time ()' : timestamp_gleam\n    timestamp |> to_calendar_utc_gleam\n\n:= python_utc_now () : date_time =\n    global \"import datetime\"\n    $'datetime.datetime.utcnow()' : date_time\n\n:= utc_now () : date_time =\n    backend_switch {\n        Gleam = \\ () => gleam_utc_now ()\n        Lua = \\ () => $'os.time()' : date_time\n        Fsharp = \\ () => $'System.DateTime.UtcNow' : date_time\n        Python = \\ () => python_utc_now ()\n        Rust = \\ () => $'chrono::Utc::now().naive_utc()' : date_time\n        Zig = \\ () => zig_micros_now () |> zig_date_time_of\n    }\n\n:! stopwatch_python =\n    `(\n        global \"import timeit\"\n        $'' : $'timeit.default_timer'\n    )\n:== stopwatch_switch =\n    {\n        Pascal : $'TStopwatch'\n        Fsharp : $'System.Diagnostics.Stopwatch'\n        Python : stopwatch_python\n        Rust : $'std::time::Instant'\n    }\n:! stopwatch = $'backend_switch `(stopwatch_switch)'\n\n:= pascal_stopwatch () : stopwatch =\n    global \"uses System.Diagnostics\"\n    $'TStopwatch.StartNew' : stopwatch\n\n:= stopwatch () : stopwatch =\n    backend_switch {\n        Pascal = \\ () => pascal_stopwatch ()\n        Fsharp = \\ () => $'`stopwatch ()' : stopwatch\n        Python = \\ () => $'`stopwatch ' : stopwatch\n        Rust = \\ () => $'std::time::Instant::now()' : stopwatch\n    }\n\n:= rust_elapsed_milliseconds (stopwatch : stopwatch) : i64 =\n    := elapsed = $'!stopwatch.elapsed()' : rust_std_duration\n    := seconds : u64 = $'!elapsed.as_secs()'\n    := millis : u32 = $'!elapsed.subsec_millis()'\n    (conv seconds : i64) * 1000i64 + conv millis\n\n:= stopwatch_elapsed_milliseconds (stopwatch : stopwatch) : i64 =\n    ? is_rust () ?> rust_elapsed_milliseconds stopwatch |: $'!stopwatch.ElapsedMilliseconds'\n\n:= rust_elapsed_microseconds (stopwatch : stopwatch) : i64 =\n    := elapsed = $'!stopwatch.elapsed()' : rust_std_duration\n    := seconds : u64 = $'!elapsed.as_secs()'\n    := micros : u32 = $'!elapsed.subsec_micros()'\n    (conv seconds : i64) * 1000000i64 + conv micros\n\n:= dotnet_elapsed_microseconds (stopwatch : stopwatch) : i64 =\n    := ticks : i64 = $'!stopwatch.Elapsed.Ticks'\n    ticks / 10i64\n\n:= stopwatch_elapsed_microseconds (stopwatch : stopwatch) : i64 =\n    ? is_rust () ?> rust_elapsed_microseconds stopwatch |: dotnet_elapsed_microseconds stopwatch\n\n:= stopwatch_start (stopwatch : stopwatch) : () =\n    run_target \\|\n        | Rust => \\ () => ()\n        | Pascal => \\ () => ()\n        | _ => \\ () => $'!stopwatch.Start' ()\n\n:= monotonic_milliseconds () : i64 =\n    run_target \\|\n        | Gleam => \\ () =>\n            erlang_term::apply \"erlang\" \"monotonic_time\" [ erlang_term::atom \"millisecond\" ] |> erlang_term::cast\n        | _ => \\ () => failwith \"monotonic_milliseconds: no arm for this backend\"\n\n:= rust_monotonic_global () : () =\n    global \"\"\"\n        fn spiral_monotonic_nanoseconds() -> u64 {\n            static START: std::sync::OnceLock<std::time::Instant> = std::sync::OnceLock::new();\n            START.get_or_init(std::time::Instant::now).elapsed().as_nanos() as u64\n        }\n        \"\"\"\n\n:= rust_monotonic_nanoseconds () : u64 =\n    rust_monotonic_global ()\n    $'spiral_monotonic_nanoseconds()' : u64\n\n:~ monotonic_nanoseconds () : u64 =\n    run_target \\|\n        | Rust => \\ () => rust_monotonic_nanoseconds ()\n        | _ => \\ () => failwith \"monotonic_nanoseconds: no arm for this backend\"","print_code":false},"livebook_object":"smart_cell"} -->

