## env

<!-- livebook:{"break_markdown":true} -->

### get_environment_variable

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"let get_environment_variable (var : string) : string =\n    run_target_args (fun () => var) function\n        | Gleam _ => fun var =>\n            backend_switch {\n                Gleam = fun () =>\n                    global \"import envoy\"\n                    global \"import gleam/result\"\n            }\n            $'!var |> envoy.get |> result.unwrap(\"\")' : string\n        | Fsharp => fun var =>\n            var\n            |> $'System.Environment.GetEnvironmentVariable'\n            |> optionm'.of_obj\n            |> optionm'.unbox\n            |> optionm'.default_value \"\"\n        | Lua => fun var =>\n            $'os.getenv(!var) or \"\"' : string\n        | Rust => fun var =>\n            $'Rc::<str>::from(std::env::var(&*!var).unwrap_or_default())' : string\n        | TypeScript => fun var =>\n            $'(process.env[!var] ?? \"\")' : string\n        | Cuda _ => fun var =>\n            os_environ ()\n            |> environ_get var\n            |> optionm'.of_obj\n            |> optionm'.unbox\n            |> optionm'.default_value \"\"\n        | target => fun var =>\n            join \"env.get_environment_variable / target: \" ++#? target ++# \" / var: \" ++#? var |> failwith","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  let get_environment_variable (var : string) : string =
      run_target_args (fun () => var) function
          | Gleam _ => fun var =>
              backend_switch {
                  Gleam = fun () =>
                      global "import envoy"
                      global "import gleam/result"
              }
              $'!var |> envoy.get |> result.unwrap("")' : string
          | Fsharp => fun var =>
              var
              |> $'System.Environment.GetEnvironmentVariable'
              |> optionm'.of_obj
              |> optionm'.unbox
              |> optionm'.default_value ""
          | Lua => fun var =>
              $'os.getenv(!var) or ""' : string
          | Rust => fun var =>
              $'Rc::<str>::from(std::env::var(&*!var).unwrap_or_default())' : string
          | TypeScript => fun var =>
              $'(process.env[!var] ?? "")' : string
          | Cuda _ => fun var =>
              os_environ ()
              |> environ_get var
              |> optionm'.of_obj
              |> optionm'.unbox
              |> optionm'.default_value ""
          | target => fun var =>
              join "env.get_environment_variable / target: " ++#? target ++# " / var: " ++#? var |> failwith
  """,
  timeout: 300_000
)
```

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"///- --test\n///> gleam\n///> lua\n///> fsharp\n///> cuda\n///> rust\n///> typescript\n\n\"PATH2\"\n|> get_environment_variable\n|> sm'.length\n|> _assert_eq 0i32","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  ///- --test
  ///> gleam
  ///> lua
  ///> fsharp
  ///> cuda
  ///> rust
  ///> typescript

  "PATH2"
  |> get_environment_variable
  |> sm'.length
  |> _assert_eq 0i32
  """,
  timeout: 300_000
)
```

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"///- --test\n///> gleam\n///> lua\n///> fsharp\n///> cuda\n///> rust\n///> typescript\n\n\"PATH\"\n|> get_environment_variable\n|> sm'.length\n|> fun x =>\n    if x > 0i32\n    then 1\n    else 0\n    |> _assert_eq 1i32","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  ///- --test
  ///> gleam
  ///> lua
  ///> fsharp
  ///> cuda
  ///> rust
  ///> typescript

  "PATH"
  |> get_environment_variable
  |> sm'.length
  |> fun x =>
      if x > 0i32
      then 1
      else 0
      |> _assert_eq 1i32
  """,
  timeout: 300_000
)
```

### get_entry_assembly_name

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"let get_entry_assembly_name () : string =\n    run_target function\n        | Rust => fun () => (join \"CARGO_PKG_NAME\") |> get_environment_variable\n        | Fsharp _ => fun () => $'System.Reflection.Assembly.GetEntryAssembly().GetName().Name'\n        | target => fun () => \"env.get_entry_assembly_name / target: \" ++#? target","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  let get_entry_assembly_name () : string =
      run_target function
          | Rust => fun () => (join "CARGO_PKG_NAME") |> get_environment_variable
          | Fsharp _ => fun () => $'System.Reflection.Assembly.GetEntryAssembly().GetName().Name'
          | target => fun () => "env.get_entry_assembly_name / target: " ++#? target
  """,
  timeout: 300_000
)
```

### append_path

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"inl append_path (path : string) : option string =\n    inl env_path = \"PATH\" |> get_environment_variable\n    if env_path = \"\"\n    then None\n    else\n        inl env_sep =\n            if platform.is_windows ()\n            then \";\"\n            else \":\"\n        path ++# env_sep ++# env_path |> Some","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  inl append_path (path : string) : option string =
      inl env_path = "PATH" |> get_environment_variable
      if env_path = ""
      then None
      else
          inl env_sep =
              if platform.is_windows ()
              then ";"
              else ":"
          path ++# env_sep ++# env_path |> Some
  """,
  timeout: 300_000
)
```
