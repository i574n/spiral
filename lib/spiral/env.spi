/// # env
test env static =
    :< testing

:< sm'_operators

/// ## rust

/// ### var_error
:! var_error =
    `(
        rust.rust_type
            `($'std_env_VarError')
            `($'std::env::VarError')
            "type std_env_VarError = class end"
    )

/// ### get_environment_variable_comptime
:= get_environment_variable_comptime (var : string) : string =
    run_target_args (\ () => var) \|
        | Rust => \ var =>
            :< rust.rust_operators
            !\($'"option_env\!(\\\"" + !var + "\\\").unwrap_or(\\\"\\\")"')
            |> sm'.ref_to_std_string
            |> sm'.from_std_string
        | target => \ _ => null ()

/// ## python

/// ### os_environ
:! os_environ = any

:= os_environ () : os_environ =
    backend_switch {
        Gleam = \ () => "env.os_environ" |> failwith : os_environ
        Lua = \ () => "env.os_environ" |> failwith : os_environ
        Python = \ () =>
            global "import os"
            $'os.environ' : os_environ
    }

:= environ_get (key : string) (os_environ : os_environ) : string =
    backend_switch {
        Gleam = \ () => "env.environ_get" |> failwith : string
        Lua = \ () => "env.environ_get" |> failwith : string
        Python = \ () =>
            $'!os_environ.get(!key)' : string
    }

/// ## env

/// ### get_environment_variable
:~ get_environment_variable (var : string) : string =
    run_target_args (\ () => var) \|
        | Zig => \ _ =>
            $'(std.process.Environ.getAlloc(spiral_environ, spiral_gpa, !var) catch "")' : string
        | Gleam _ => \ var =>
            backend_switch {
                Gleam = \ () =>
                    global "import envoy"
                    global "import gleam/result"
            }
            $'!var |> envoy.get |> result.unwrap("")' : string
        | Fsharp => \ var =>
            var
            |> $'System.Environment.GetEnvironmentVariable'
            |> optionm'.of_obj
            |> optionm'.unbox
            |> optionm'.default_value ""
        | Lua => \ var =>
            $'os.getenv(!var) or ""' : string
        | Delphi => \ var =>
            $'GetEnvironmentVariable(!var)' : string
        | Rust => \ var =>
            $'Rc::<str>::from(std::env::var(&*!var).unwrap_or_default())' : string
        | TypeScript => \ var =>
            $'(process.env[!var] ?? "")' : string
        | Cuda _ => \ var =>
            os_environ ()
            |> environ_get var
            |> optionm'.of_obj
            |> optionm'.unbox
            |> optionm'.default_value ""
        | target => \ var =>
            ~~ "env.get_environment_variable / target: " ++#? target ++# " / var: " ++#? var |> failwith

///> gleam
///> lua
///> fsharp
///> cuda
///> rust
///> typescript
test get_environment_variable =
    "PATH2"
    |> get_environment_variable
    |> sm'.length
    |> _assert_eq 0i32

///> gleam
///> lua
///> fsharp
///> cuda
///> rust
///> typescript
test get_environment_variable_2 =
    "PATH"
    |> get_environment_variable
    |> sm'.length
    |> \ x =>
        ? x > 0i32
        ?> 1
        |: 0
        |> _assert_eq 1i32

/// ### try_get_environment_variable
:= try_get_environment_variable (var : string) : option string =
    := value = var |> get_environment_variable
    ? value = "" ?> None |: Some value

///> gleam
///> lua
///> fsharp
///> rust
///> typescript
test try_get_environment_variable_is_none_when_unset =
    := is_set var =
        ?= var |> try_get_environment_variable ?|
        | Some _ => 1i32
        | None => 0i32
    (is_set "PATH2", is_set "PATH")
    |> _assert_eq (0i32, 1i32)

:= env_gleam_argv () =
    global "import gleam/erlang/charlist"
    global "import gleam/list"
    global "import gleam/result"
    global """
        @external(erlang, "init", "get_plain_arguments")
        fn spiral_env_plain_arguments() -> List(charlist.Charlist)
        """

/// ### argument_offset
:= argument_offset () : i32 =
    run_target \|
        | TypeScript => \ () => 2i32
        | Gleam => \ () => 0i32
        | _ => \ () => 1i32

/// ### host_argument_count
:= host_argument_count () : i32 =
    run_target \|
        | Rust => \ () => ($'std::env::args().count()' : convert.unativeint) |> convert.convert
        | Fsharp => \ () => $'System.Environment.GetCommandLineArgs().Length' : i32
        | TypeScript => \ () => $'process.argv.length' : i32
        | Cuda _ => \ () =>
            global "import sys"
            $'len(sys.argv)' : i32
        | Gleam => \ () =>
            env_gleam_argv ()
            $'list.length(spiral_env_plain_arguments())' : i32
        | target => \ () => "env.host_argument_count / target: " ++#? target |> failwith

/// ### host_argument
:= host_argument (position : i32) : string =
    run_target_args (\ () => position) \|
        | Rust => \ position =>
            := position : convert.unativeint = convert.convert position
            $'Rc::<str>::from(std::env::args().nth(!position).unwrap_or_default())' : string
        | Fsharp => \ position => $'System.Environment.GetCommandLineArgs().[!position]' : string
        | TypeScript => \ position => $'process.argv[!position]' : string
        | Cuda _ => \ position =>
            global "import sys"
            $'sys.argv[!position]' : string
        | Gleam => \ position =>
            env_gleam_argv ()
            := rest = $'list.drop(spiral_env_plain_arguments(), !position)' : $'List(charlist.Charlist)'
            $'result.unwrap(result.map(list.first(!rest), charlist.to_string), "")' : string
        | target => \ _ => "env.host_argument / target: " ++#? target |> failwith

/// ### exit_with
:= exit_with (code : i32) : () =
    run_target_args (\ () => code) \|
        | Rust => \ code => $'std::process::exit(!code)' : ()
        | Fsharp => \ code => $'exit !code' : ()
        | TypeScript => \ code => $'process.exit(!code)' : ()
        | Cuda _ => \ code =>
            global "import sys"
            $'sys.exit(!code)' : ()
        | target => \ _ => "env.exit_with / target: " ++#? target |> failwith

/// ### command_line_argument_count
:~ command_line_argument_count () : i32 =
    host_argument_count () - argument_offset ()

/// ### command_line_argument
:~ command_line_argument (index : i32) : string =
    index + argument_offset () |> host_argument

/// ### try_command_line_argument
:= try_command_line_argument (index : i32) : option string =
    ? index >= 0 && index < command_line_argument_count ()
    ?> index |> command_line_argument |> Some
    |: None

///> fsharp
///> cuda
///> rust
///> typescript
test command_line_arguments_outside_the_range_are_none =
    := count = command_line_argument_count ()
    := is_set index =
        ?= index |> try_command_line_argument ?|
        | Some _ => 1i32
        | None => 0i32
    (count >= 0i32, is_set (-1i32), is_set count)
    |> _assert_eq (!+, 0i32, 0i32)

/// ### command_line_arguments
:~ ^ arguments_from (index : i32) : list string =
    ?= try_command_line_argument index ?|
    | None => []
    | Some argument => argument :: arguments_from (index + 1i32)

:= command_line_arguments () : list string = arguments_from 0i32

///> rust
///> gleam
test command_line_arguments_list_every_argument_in_order =
    := listed = command_line_arguments ()
    := head_is_first (head : string) = ?= try_command_line_argument 0i32 ?| | Some a => a = head | None => !-
    := first_matches = ?= listed ?| | head :: _ => head_is_first head | [] => command_line_argument_count () = 0i32
    (listm.length listed, first_matches) |> _assert_eq (command_line_argument_count (), !+)

/// ### get_entry_assembly_name
:~ get_entry_assembly_name () : string =
    run_target \|
        | Rust => \ () => (~~ "CARGO_PKG_NAME") |> get_environment_variable
        | Fsharp _ => \ () => $'System.Reflection.Assembly.GetEntryAssembly().GetName().Name'
        | target => \ () => "env.get_entry_assembly_name / target: " ++#? target

:~ current_executable () : string =
    run_target \|
        | Rust => \ () =>
            $'std::env::current_exe().map(|path| Rc::<str>::from(path.to_string_lossy().as_ref())).unwrap_or_else(|_| \
                Rc::<str>::from(""))' : string
        | Fsharp _ => \ () => $'System.Environment.ProcessPath' : string
        | target => \ () => "env.current_executable / target: " ++#? target

///> rust
test current_executable_names_an_existing_file =
    := path = current_executable ()
    ($'std::path::Path::new(&*!path).is_file()' : bool) |> _assert_eq !+

/// ### append_path
:= append_path (path : string) : option string =
    := env_path = "PATH" |> get_environment_variable
    ? env_path = ""
    ?> None
    |:
        := env_sep =
            ? platform.is_windows ()
            ?> ";"
            |: ":"
        path ++# env_sep ++# env_path |> Some

/// ### environment_snapshot
:~ environment_snapshot () : string =
    run_target \|
        | Rust => \ () =>
            $'Rc::<str>::from(std::env::vars_os().map(|(key, value)| format\!("{}={}", key.to_string_lossy(), \
                value.to_string_lossy())).collect::<Vec<_>>().join(&char::from(0u8).to_string()).as_str())' : string
        | target => \ () => "env.environment_snapshot / target: " ++#? target |> failwith

/// ### environment_restored
:~ environment_restored (snapshot : string) (kept_prefix : string) : () =
    run_target_args' (snapshot, kept_prefix) \|
        | Rust => \ snapshot, kept_prefix =>
            $'{ let hidden = |key: &str| key.starts_with(char::from(61u8)); \
                let wanted = (!snapshot).split(char::from(0u8)).filter_map(|pair| \
                pair.char_indices().skip(1).find(|(_, c)| *c == char::from(61u8)).map(|(at, \
                _)| (pair[..at].to_owned(), pair[at + 1..].to_owned()))).filter(|(key, \
                _)| \!hidden(key)).collect::<std::collections::HashMap<String, String>>(); \
                for (key, _) in std::env::vars_os() { let key = key.to_string_lossy().into_owned(); \
                if \!hidden(&key) && \!key.starts_with(&*!kept_prefix) && \!wanted.contains_key(&key) { unsafe { \
                std::env::remove_var(&key); } } } for (key, value) in &wanted { if std::env::var_os(key).map_or(true, \
                |now| now.to_string_lossy() \!= value.as_str()) { unsafe { std::env::set_var(key, value); } } } }' : ()
        | target => \ _ => "env.environment_restored / target: " ++#? target |> failwith

///> rust
test an_environment_snapshot_restores_to_itself =
    := before = environment_snapshot ()
    environment_restored before "SPIRAL_KEPT_"
    (sm'.length before > 0i32, environment_snapshot () = before, "PATH2" |> get_environment_variable)
    |> _assert_eq (!+, !+, "")
