/// # env
test env static =
    open testing

open sm'_operators

/// ## rust

/// ### var_error
nominal var_error =
    `(
        rust.rust_type
            `($'std_env_VarError')
            `($'std::env::VarError')
            "type std_env_VarError = class end"
    )

/// ### get_environment_variable_comptime
inl get_environment_variable_comptime (var : string) : string =
    run_target_args (fun () => var) function
        | Rust => fun var =>
            open rust.rust_operators
            !\($'"option_env\!(\\\"" + !var + "\\\").unwrap_or(\\\"\\\")"')
            |> sm'.ref_to_std_string
            |> sm'.from_std_string
        | target => fun _ => null ()

/// ## python

/// ### os_environ
nominal os_environ = any

inl os_environ () : os_environ =
    backend_switch {
        Gleam = fun () => "env.os_environ" |> failwith : os_environ
        Lua = fun () => "env.os_environ" |> failwith : os_environ
        Python = fun () =>
            global "import os"
            $'os.environ' : os_environ
    }

inl environ_get (key : string) (os_environ : os_environ) : string =
    backend_switch {
        Gleam = fun () => "env.environ_get" |> failwith : string
        Lua = fun () => "env.environ_get" |> failwith : string
        Python = fun () =>
            $'!os_environ.get(!key)' : string
    }

/// ## env

/// ### get_environment_variable
let get_environment_variable (var : string) : string =
    run_target_args (fun () => var) function
        | Zig => fun _ =>
            $'(std.process.Environ.getAlloc(spiral_environ, spiral_gpa, !var) catch "")' : string
        | Gleam _ => fun var =>
            backend_switch {
                Gleam = fun () =>
                    global "import envoy"
                    global "import gleam/result"
            }
            $'!var |> envoy.get |> result.unwrap("")' : string
        | Fsharp => fun var =>
            var
            |> $'System.Environment.GetEnvironmentVariable'
            |> optionm'.of_obj
            |> optionm'.unbox
            |> optionm'.default_value ""
        | Lua => fun var =>
            $'os.getenv(!var) or ""' : string
        | Rust => fun var =>
            $'Rc::<str>::from(std::env::var(&*!var).unwrap_or_default())' : string
        | TypeScript => fun var =>
            $'(process.env[!var] ?? "")' : string
        | Cuda _ => fun var =>
            os_environ ()
            |> environ_get var
            |> optionm'.of_obj
            |> optionm'.unbox
            |> optionm'.default_value ""
        | target => fun var =>
            join "env.get_environment_variable / target: " ++#? target ++# " / var: " ++#? var |> failwith

///> gleam
///> lua
///> fsharp
///> cuda
///> rust
///> typescript
test get_environment_variable =
    "PATH2"
    |> get_environment_variable
    |> sm'.length
    |> _assert_eq 0i32

///> gleam
///> lua
///> fsharp
///> cuda
///> rust
///> typescript
test get_environment_variable_2 =
    "PATH"
    |> get_environment_variable
    |> sm'.length
    |> fun x =>
        if x > 0i32
        then 1
        else 0
        |> _assert_eq 1i32

/// ### try_get_environment_variable
inl try_get_environment_variable (var : string) : option string =
    inl value = var |> get_environment_variable
    if value = "" then None else Some value

///> gleam
///> lua
///> fsharp
///> rust
///> typescript
test try_get_environment_variable_is_none_when_unset =
    inl is_set var =
        match var |> try_get_environment_variable with
        | Some _ => 1i32
        | None => 0i32
    (is_set "PATH2", is_set "PATH")
    |> _assert_eq (0i32, 1i32)

inl env_gleam_argv () =
    global "import gleam/erlang/charlist"
    global "import gleam/list"
    global "import gleam/result"
    global """
        @external(erlang, "init", "get_plain_arguments")
        fn spiral_env_plain_arguments() -> List(charlist.Charlist)
        """

/// ### argument_offset
inl argument_offset () : i32 =
    run_target function
        | TypeScript => fun () => 2i32
        | Gleam => fun () => 0i32
        | _ => fun () => 1i32

/// ### host_argument_count
inl host_argument_count () : i32 =
    run_target function
        | Rust => fun () => ($'std::env::args().count()' : convert.unativeint) |> convert.convert
        | Fsharp => fun () => $'System.Environment.GetCommandLineArgs().Length' : i32
        | TypeScript => fun () => $'process.argv.length' : i32
        | Cuda _ => fun () =>
            global "import sys"
            $'len(sys.argv)' : i32
        | Gleam => fun () =>
            env_gleam_argv ()
            $'list.length(spiral_env_plain_arguments())' : i32
        | target => fun () => "env.host_argument_count / target: " ++#? target |> failwith

/// ### host_argument
inl host_argument (position : i32) : string =
    run_target_args (fun () => position) function
        | Rust => fun position =>
            inl position : convert.unativeint = convert.convert position
            $'Rc::<str>::from(std::env::args().nth(!position).unwrap_or_default())' : string
        | Fsharp => fun position => $'System.Environment.GetCommandLineArgs().[!position]' : string
        | TypeScript => fun position => $'process.argv[!position]' : string
        | Cuda _ => fun position =>
            global "import sys"
            $'sys.argv[!position]' : string
        | Gleam => fun position =>
            env_gleam_argv ()
            inl rest = $'list.drop(spiral_env_plain_arguments(), !position)' : $'List(charlist.Charlist)'
            $'result.unwrap(result.map(list.first(!rest), charlist.to_string), "")' : string
        | target => fun _ => "env.host_argument / target: " ++#? target |> failwith

/// ### command_line_argument_count
let command_line_argument_count () : i32 =
    host_argument_count () - argument_offset ()

/// ### command_line_argument
let command_line_argument (index : i32) : string =
    index + argument_offset () |> host_argument

/// ### try_command_line_argument
inl try_command_line_argument (index : i32) : option string =
    if index >= 0 && index < command_line_argument_count ()
    then index |> command_line_argument |> Some
    else None

///> fsharp
///> cuda
///> rust
///> typescript
test command_line_arguments_outside_the_range_are_none =
    inl count = command_line_argument_count ()
    inl is_set index =
        match index |> try_command_line_argument with
        | Some _ => 1i32
        | None => 0i32
    (count >= 0i32, is_set (-1i32), is_set count)
    |> _assert_eq (true, 0i32, 0i32)

/// ### get_entry_assembly_name
let get_entry_assembly_name () : string =
    run_target function
        | Rust => fun () => (join "CARGO_PKG_NAME") |> get_environment_variable
        | Fsharp _ => fun () => $'System.Reflection.Assembly.GetEntryAssembly().GetName().Name'
        | target => fun () => "env.get_entry_assembly_name / target: " ++#? target

let current_executable () : string =
    run_target function
        | Rust => fun () =>
            $'std::env::current_exe().map(|path| Rc::<str>::from(path.to_string_lossy().as_ref())).unwrap_or_else(|_| \
                Rc::<str>::from(""))' : string
        | Fsharp _ => fun () => $'System.Environment.ProcessPath' : string
        | target => fun () => "env.current_executable / target: " ++#? target

///> rust
test current_executable_names_an_existing_file =
    inl path = current_executable ()
    ($'std::path::Path::new(&*!path).is_file()' : bool) |> _assert_eq true

/// ### append_path
inl append_path (path : string) : option string =
    inl env_path = "PATH" |> get_environment_variable
    if env_path = ""
    then None
    else
        inl env_sep =
            if platform.is_windows ()
            then ";"
            else ":"
        path ++# env_sep ++# env_path |> Some

/// ### environment_snapshot
let environment_snapshot () : string =
    run_target function
        | Rust => fun () =>
            $'Rc::<str>::from(std::env::vars_os().map(|(key, value)| format\!("{}={}", key.to_string_lossy(), \
                value.to_string_lossy())).collect::<Vec<_>>().join(&char::from(0u8).to_string()).as_str())' : string
        | target => fun () => "env.environment_snapshot / target: " ++#? target |> failwith

/// ### environment_restored
let environment_restored (snapshot : string) (kept_prefix : string) : () =
    run_target_args' (snapshot, kept_prefix) function
        | Rust => fun snapshot, kept_prefix =>
            $'{ let hidden = |key: &str| key.starts_with(char::from(61u8)); \
                let wanted = (!snapshot).split(char::from(0u8)).filter_map(|pair| \
                pair.char_indices().skip(1).find(|(_, c)| *c == char::from(61u8)).map(|(at, \
                _)| (pair[..at].to_owned(), pair[at + 1..].to_owned()))).filter(|(key, \
                _)| \!hidden(key)).collect::<std::collections::HashMap<String, String>>(); \
                for (key, _) in std::env::vars_os() { let key = key.to_string_lossy().into_owned(); \
                if \!hidden(&key) && \!key.starts_with(&*!kept_prefix) && \!wanted.contains_key(&key) { unsafe { \
                std::env::remove_var(&key); } } } for (key, value) in &wanted { if std::env::var_os(key).map_or(true, \
                |now| now.to_string_lossy() \!= value.as_str()) { unsafe { std::env::set_var(key, value); } } } }' : ()
        | target => fun _ => "env.environment_restored / target: " ++#? target |> failwith

///> rust
test an_environment_snapshot_restores_to_itself =
    inl before = environment_snapshot ()
    environment_restored before "SPIRAL_KEPT_"
    (sm'.length before > 0i32, environment_snapshot () = before, "PATH2" |> get_environment_variable)
    |> _assert_eq (true, true, "")
