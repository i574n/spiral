```elixir
Spiral.Cells.eval!(
  ~S"""
  :! os_environ = any

  := os_environ () : os_environ =
      backend_switch {
          Gleam = \ () => "env.os_environ" |> failwith : os_environ
          Lua = \ () => "env.os_environ" |> failwith : os_environ
          Python = \ () =>
              global "import os"
              $'os.environ' : os_environ
      }

  := environ_get (key : string) (os_environ : os_environ) : string =
      backend_switch {
          Gleam = \ () => "env.environ_get" |> failwith : string
          Lua = \ () => "env.environ_get" |> failwith : string
          Python = \ () =>
              $'!os_environ.get(!key)' : string
      }
  """,
  timeout: 300_000
)
```

## env

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":":~ get_environment_variable (var : string) : string =\n    run_target_args (\\ () => var) \\|\n        | Zig => \\ _ =>\n            $'(std.process.Environ.getAlloc(spiral_environ, spiral_gpa, !var) catch \"\")' : string\n        | Gleam _ => \\ var =>\n            backend_switch {\n                Gleam = \\ () =>\n                    global \"import envoy\"\n                    global \"import gleam/result\"\n            }\n            $'!var |> envoy.get |> result.unwrap(\"\")' : string\n        | Fsharp => \\ var =>\n            var\n            |> $'System.Environment.GetEnvironmentVariable'\n            |> optionm'::of_obj\n            |> optionm'::unbox\n            |> optionm'::default_value \"\"\n        | Lua => \\ var =>\n            $'os.getenv(!var) or \"\"' : string\n        | Pascal => \\ var =>\n            $'GetEnvironmentVariable(!var)' : string\n        | Rust => \\ var =>\n            $'Rc::<str>::from(std::env::var(&*!var).unwrap_or_default())' : string\n        | TypeScript => \\ var =>\n            $'(process.env[!var] ?? \"\")' : string\n        | Cuda _ => \\ var =>\n            os_environ ()\n            |> environ_get var\n            |> optionm'::of_obj\n            |> optionm'::unbox\n            |> optionm'::default_value \"\"\n        | C => \\ var =>\n            global \"#include <stdlib.h>\"\n            global \"#include <string.h>\"\n            $'({ const char * spiral_env = getenv((!var)->ptr); \\\n                \\spiral_env ? StringLit((uint32_t)strlen(spiral_env) + 1, (char *)spiral_env) : \\\n                \\StringLit(1, \"\"); })' : string\n        | target => \\ var =>\n            ~~ \"env.get_environment_variable / target: \" ++#? target ++# \" / var: \" ++#? var |> failwith","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  :~ get_environment_variable (var : string) : string =
      run_target_args (\ () => var) \|
          | Zig => \ _ =>
              $'(std.process.Environ.getAlloc(spiral_environ, spiral_gpa, !var) catch "")' : string
          | Gleam _ => \ var =>
              backend_switch {
                  Gleam = \ () =>
                      global "import envoy"
                      global "import gleam/result"
              }
              $'!var |> envoy.get |> result.unwrap("")' : string
          | Fsharp => \ var =>
              var
              |> $'System.Environment.GetEnvironmentVariable'
              |> optionm'::of_obj
              |> optionm'::unbox
              |> optionm'::default_value ""
          | Lua => \ var =>
              $'os.getenv(!var) or ""' : string
          | Pascal => \ var =>
              $'GetEnvironmentVariable(!var)' : string
          | Rust => \ var =>
              $'Rc::<str>::from(std::env::var(&*!var).unwrap_or_default())' : string
          | TypeScript => \ var =>
              $'(process.env[!var] ?? "")' : string
          | Cuda _ => \ var =>
              os_environ ()
              |> environ_get var
              |> optionm'::of_obj
              |> optionm'::unbox
              |> optionm'::default_value ""
          | C => \ var =>
              global "#include <stdlib.h>"
              global "#include <string.h>"
              $'({ const char * spiral_env = getenv((!var)->ptr); \
                  \spiral_env ? StringLit((uint32_t)strlen(spiral_env) + 1, (char *)spiral_env) : \
                  \StringLit(1, ""); })' : string
          | target => \ var =>
              ~~ "env.get_environment_variable / target: " ++#? target ++# " / var: " ++#? var |> failwith
  """,
  timeout: 300_000
)
```

