<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":"///- --test --symbol\n///> c\n///> rust\n\n:= ~unset = \"SPIRAL_SURELY_UNSET_VARIABLE_1102\"\n(get_environment_variable unset, sm'::length (get_environment_variable \"PATH\") > 0i32) |> _assert_eq (\"\", !+)","print_code":false},"livebook_object":"smart_cell"} -->

