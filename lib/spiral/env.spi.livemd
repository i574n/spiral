<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":":= env_gleam_argv () =\n    global \"import gleam/erlang/charlist\"\n    global \"import gleam/list\"\n    global \"import gleam/result\"\n    global \"@external(erlang, \\\"init\\\", \\\"get_plain_arguments\\\")\"\n    global \"fn spiral_env_plain_arguments() -> List(charlist.Charlist)\"\n\n:= argument_offset () : i32 =\n    run_target \\|\n        | TypeScript => \\ () => 2i32\n        | Gleam => \\ () => 0i32\n        | _ => \\ () => 1i32\n\n:= host_argument_count () : i32 =\n    run_target \\|\n        | Rust => \\ () => ($'std::env::args().count()' : convert::unativeint) |> convert::convert\n        | Fsharp => \\ () => $'System.Environment.GetCommandLineArgs().Length' : i32\n        | TypeScript => \\ () => $'process.argv.length' : i32\n        | Cuda _ => \\ () =>\n            global \"import sys\"\n            $'len(sys.argv)' : i32\n        | Gleam => \\ () =>\n            env_gleam_argv ()\n            $'list.length(spiral_env_plain_arguments())' : i32\n        | target => \\ () => \"env.host_argument_count / target: \" ++#? target |> failwith\n\n:= host_argument (position : i32) : string =\n    run_target_args (\\ () => position) \\|\n        | Rust => \\ position =>\n            := position : convert::unativeint = convert::convert position\n            $'Rc::<str>::from(std::env::args().nth(!position).unwrap_or_default())' : string\n        | Fsharp => \\ position => $'System.Environment.GetCommandLineArgs().[!position]' : string\n        | TypeScript => \\ position => $'process.argv[!position]' : string\n        | Cuda _ => \\ position =>\n            global \"import sys\"\n            $'sys.argv[!position]' : string\n        | Gleam => \\ position =>\n            env_gleam_argv ()\n            := rest = $'list.drop(spiral_env_plain_arguments(), !position)' : $'List(charlist.Charlist)'\n            $'result.unwrap(result.map(list.first(!rest), charlist.to_string), \"\")' : string\n        | target => \\ _ => \"env.host_argument / target: \" ++#? target |> failwith\n\n:= exit_with (code : i32) : () =\n    run_target_args (\\ () => code) \\|\n        | Rust => \\ code => $'std::process::exit(!code)' : ()\n        | Fsharp => \\ code => $'exit !code' : ()\n        | TypeScript => \\ code => $'process.exit(!code)' : ()\n        | Cuda _ => \\ code =>\n            global \"import sys\"\n            $'sys.exit(!code)' : ()\n        | target => \\ _ => \"env.exit_with / target: \" ++#? target |> failwith\n\n:~ command_line_argument_count () : i32 =\n    host_argument_count () - argument_offset ()\n\n:~ command_line_argument (index : i32) : string =\n    index + argument_offset () |> host_argument\n\n:= try_command_line_argument (index : i32) : option string =\n    ? index >= 0 && index < command_line_argument_count ()\n    ?> index |> command_line_argument |> Some\n    |: None\n\n:= argument_is_set (index : i32) : i32 =\n    ?= index |> try_command_line_argument ?|\n    | Some _ => 1i32\n    | None => 0i32","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  := env_gleam_argv () =
      global "import gleam/erlang/charlist"
      global "import gleam/list"
      global "import gleam/result"
      global "@external(erlang, \"init\", \"get_plain_arguments\")"
      global "fn spiral_env_plain_arguments() -> List(charlist.Charlist)"

  := argument_offset () : i32 =
      run_target \|
          | TypeScript => \ () => 2i32
          | Gleam => \ () => 0i32
          | _ => \ () => 1i32

  := host_argument_count () : i32 =
      run_target \|
          | Rust => \ () => ($'std::env::args().count()' : convert::unativeint) |> convert::convert
          | Fsharp => \ () => $'System.Environment.GetCommandLineArgs().Length' : i32
          | TypeScript => \ () => $'process.argv.length' : i32
          | Cuda _ => \ () =>
              global "import sys"
              $'len(sys.argv)' : i32
          | Gleam => \ () =>
              env_gleam_argv ()
              $'list.length(spiral_env_plain_arguments())' : i32
          | target => \ () => "env.host_argument_count / target: " ++#? target |> failwith

  := host_argument (position : i32) : string =
      run_target_args (\ () => position) \|
          | Rust => \ position =>
              := position : convert::unativeint = convert::convert position
              $'Rc::<str>::from(std::env::args().nth(!position).unwrap_or_default())' : string
          | Fsharp => \ position => $'System.Environment.GetCommandLineArgs().[!position]' : string
          | TypeScript => \ position => $'process.argv[!position]' : string
          | Cuda _ => \ position =>
              global "import sys"
              $'sys.argv[!position]' : string
          | Gleam => \ position =>
              env_gleam_argv ()
              := rest = $'list.drop(spiral_env_plain_arguments(), !position)' : $'List(charlist.Charlist)'
              $'result.unwrap(result.map(list.first(!rest), charlist.to_string), "")' : string
          | target => \ _ => "env.host_argument / target: " ++#? target |> failwith

  := exit_with (code : i32) : () =
      run_target_args (\ () => code) \|
          | Rust => \ code => $'std::process::exit(!code)' : ()
          | Fsharp => \ code => $'exit !code' : ()
          | TypeScript => \ code => $'process.exit(!code)' : ()
          | Cuda _ => \ code =>
              global "import sys"
              $'sys.exit(!code)' : ()
          | target => \ _ => "env.exit_with / target: " ++#? target |> failwith

  :~ command_line_argument_count () : i32 =
      host_argument_count () - argument_offset ()

  :~ command_line_argument (index : i32) : string =
      index + argument_offset () |> host_argument

  := try_command_line_argument (index : i32) : option string =
      ? index >= 0 && index < command_line_argument_count ()
      ?> index |> command_line_argument |> Some
      |: None

  := argument_is_set (index : i32) : i32 =
      ?= index |> try_command_line_argument ?|
      | Some _ => 1i32
      | None => 0i32
  """,
  timeout: 300_000
)
```

#### command_line_arguments_outside_the_range_are_none (test)

