<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":":= fsharp_entry_name () : string = $'System.Reflection.Assembly.GetEntryAssembly().GetName().Name'\n\n:~ get_entry_assembly_name () : string =\n    run_target \\|\n        | Rust => \\ () => (~~ \"CARGO_PKG_NAME\") |> get_environment_variable\n        | Fsharp _ => \\ () => fsharp_entry_name ()\n        | target => \\ () => \"env.get_entry_assembly_name / target: \" ++#? target\n\n:! env_path_buf = $'std::path::PathBuf'\n\n:= rust_current_exe () : optionm'::option' env_path_buf = $'std::env::current_exe().ok()' : optionm'::option' env_path_buf\n\n:= rust_path_text (path : env_path_buf) : string = $'Rc::<str>::from(!path.to_string_lossy().as_ref())' : string\n\n:~ current_executable () : string =\n    run_target \\|\n        | Rust => \\ () =>\n            ?= rust_current_exe () |> optionm'::map' rust_path_text |> optionm'::unbox ?|\n            | Some path => path\n            | None => \"\"\n        | Fsharp _ => \\ () => $'System.Environment.ProcessPath' : string\n        | target => \\ () => \"env.current_executable / target: \" ++#? target","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  := fsharp_entry_name () : string = $'System.Reflection.Assembly.GetEntryAssembly().GetName().Name'

  :~ get_entry_assembly_name () : string =
      run_target \|
          | Rust => \ () => (~~ "CARGO_PKG_NAME") |> get_environment_variable
          | Fsharp _ => \ () => fsharp_entry_name ()
          | target => \ () => "env.get_entry_assembly_name / target: " ++#? target

  :! env_path_buf = $'std::path::PathBuf'

  := rust_current_exe () : optionm'::option' env_path_buf = $'std::env::current_exe().ok()' : optionm'::option' env_path_buf

  := rust_path_text (path : env_path_buf) : string = $'Rc::<str>::from(!path.to_string_lossy().as_ref())' : string

  :~ current_executable () : string =
      run_target \|
          | Rust => \ () =>
              ?= rust_current_exe () |> optionm'::map' rust_path_text |> optionm'::unbox ?|
              | Some path => path
              | None => ""
          | Fsharp _ => \ () => $'System.Environment.ProcessPath' : string
          | target => \ () => "env.current_executable / target: " ++#? target
  """,
  timeout: 300_000
)
```

