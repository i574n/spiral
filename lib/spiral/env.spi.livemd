<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":":~ set_environment_variable (var : string) (value : string) : () =\n    run_target_args (\\ () => var, value) \\|\n        | Gleam _ => \\ var, value =>\n            backend_switch {\n                Gleam = \\ () =>\n                    global \"import envoy\"\n            }\n            $'envoy.set(!var, !value)' : ()\n        | Fsharp => \\ var, value =>\n            $'System.Environment.SetEnvironmentVariable(!var, !value)' : ()\n        | Rust => \\ var, value =>\n            $'unsafe { std::env::set_var(&*!var, &*!value) }' : ()\n        | TypeScript => \\ var, value =>\n            $'process.env[!var] = !value' : ()\n        | target => \\ var, _ =>\n            ~~ \"env.set_environment_variable / target: \" ++#? target ++# \" / var: \" ++#? var |> failwith\n\n:~ remove_environment_variable (var : string) : () =\n    run_target_args (\\ () => var) \\|\n        | Gleam _ => \\ var =>\n            backend_switch {\n                Gleam = \\ () =>\n                    global \"import envoy\"\n            }\n            $'envoy.unset(!var)' : ()\n        | Fsharp => \\ var =>\n            $'System.Environment.SetEnvironmentVariable(!var, null)' : ()\n        | Rust => \\ var =>\n            $'unsafe { std::env::remove_var(&*!var) }' : ()\n        | TypeScript => \\ var =>\n            $'delete process.env[!var]' : ()\n        | target => \\ var =>\n            ~~ \"env.remove_environment_variable / target: \" ++#? target ++# \" / var: \" ++#? var |> failwith","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  :~ set_environment_variable (var : string) (value : string) : () =
      run_target_args (\ () => var, value) \|
          | Gleam _ => \ var, value =>
              backend_switch {
                  Gleam = \ () =>
                      global "import envoy"
              }
              $'envoy.set(!var, !value)' : ()
          | Fsharp => \ var, value =>
              $'System.Environment.SetEnvironmentVariable(!var, !value)' : ()
          | Rust => \ var, value =>
              $'unsafe { std::env::set_var(&*!var, &*!value) }' : ()
          | TypeScript => \ var, value =>
              $'process.env[!var] = !value' : ()
          | target => \ var, _ =>
              ~~ "env.set_environment_variable / target: " ++#? target ++# " / var: " ++#? var |> failwith

  :~ remove_environment_variable (var : string) : () =
      run_target_args (\ () => var) \|
          | Gleam _ => \ var =>
              backend_switch {
                  Gleam = \ () =>
                      global "import envoy"
              }
              $'envoy.unset(!var)' : ()
          | Fsharp => \ var =>
              $'System.Environment.SetEnvironmentVariable(!var, null)' : ()
          | Rust => \ var =>
              $'unsafe { std::env::remove_var(&*!var) }' : ()
          | TypeScript => \ var =>
              $'delete process.env[!var]' : ()
          | target => \ var =>
              ~~ "env.remove_environment_variable / target: " ++#? target ++# " / var: " ++#? var |> failwith
  """,
  timeout: 300_000
)
```

