<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":":= append_path (path : string) : option string =\n    := env_path = \"PATH\" |> get_environment_variable\n    ? env_path = \"\"\n    ?> None\n    |:\n        := env_sep = ? platform::is_windows () ?> \";\" |: \":\"\n        path ++# env_sep ++# env_path |> Some\n\n:~ environment_snapshot () : string =\n    run_target \\|\n        | Rust => \\ () =>\n            $'Rc::<str>::from(std::env::vars_os().map(|(key, value)| format\\!(\"{}={}\", key.to_string_lossy(), \\\n                value.to_string_lossy())).collect::<Vec<_>>().join(&char::from(0u8).to_string()).as_str())' : string\n        | target => \\ () => \"env.environment_snapshot / target: \" ++#? target |> failwith\n\n:= environment_snapshot_usable (snapshot : string) : bool =\n    := nul = sm'::char_text 0u8\n    := held = nul ++# snapshot |> sm'::to_lower\n    := keeps (name : string) : bool =\n        get_environment_variable name = \"\" || held |> sm'::contains (nul ++# sm'::to_lower name ++# \"=\")\n    := critical =\n        ? platform::is_windows ()\n        ?> [ \"PATH\"; \"SystemRoot\"; \"TEMP\"; \"TMP\"; \"USERPROFILE\"; \"LOCALAPPDATA\"; \"APPDATA\" ]\n        |: [ \"PATH\"; \"HOME\" ]\n    snapshot <> \"\" && (critical |> listm::fold (\\ kept name => kept && keeps name) !+)\n\n:= rust_remove_var (key : string) : () = $'unsafe { std::env::remove_var(&*!key) }' : ()\n\n:= rust_set_var (key : string) (value : string) : () = $'unsafe { std::env::set_var(&*!key, &*!value) }' : ()\n\n:== env_entries = array_base string\n\n:= equals_after_first (entry : string) : i32 =\n    := size : i32 = sm'::length entry\n    ? size < 2i32 ?> -1i32 |: sm'::index_of \"=\" (sm'::substring 1i32 (size - 1i32) entry)\n\n:= entry_pair (entry : string) : string * string =\n    := found = equals_after_first entry\n    := size : i32 = sm'::length entry\n    ? found < 0i32 ?> \"\", \"\"\n    |: sm'::substring 0i32 (found + 1i32) entry, sm'::substring (found + 2i32) (size - found - 2i32) entry\n\n:= restorable (key : string) : bool = key <> \"\" && not (sm'::starts_with \"=\" key)\n\n:~ ^ value_in (all : env_entries) (key : string) (i : i32) : option string =\n    ? i >= am'::length_base all ?> None\n    |:\n        := k, v = entry_pair (am'::index_base i all)\n        ? k = key && restorable k ?> Some v |: value_in all key (i + 1i32)\n\n:= extra (wanted : env_entries) (kept : string) (key : string) : bool =\n    restorable key && not (sm'::starts_with kept key) && value_in wanted key 0i32 = None\n\n:= remove_if_extra (wanted : env_entries) (kept : string) (entry : string) : () =\n    := key, _ = entry_pair entry\n    ? extra wanted kept key ?> rust_remove_var key\n\n:~ ^ removed_extras (current : env_entries) (wanted : env_entries) (kept : string) (i : i32) : () =\n    ? i < am'::length_base current ?>\n        remove_if_extra wanted kept (am'::index_base i current)\n        removed_extras current wanted kept (i + 1i32)\n\n:= set_if_changed (current : env_entries) (entry : string) : () =\n    := key, value = entry_pair entry\n    ? restorable key && value_in current key 0i32 <> Some value ?> rust_set_var key value\n\n:~ ^ set_changed (wanted : env_entries) (current : env_entries) (i : i32) : () =\n    ? i < am'::length_base wanted ?>\n        set_if_changed current (am'::index_base i wanted)\n        set_changed wanted current (i + 1i32)\n\n:= nul_split (text : string) = sm'::split (sm'::char_text 0u8) text\n\n:= rust_restored (snapshot : string) (kept_prefix : string) : () =\n    := wanted = nul_split snapshot\n    := current = nul_split (environment_snapshot ())\n    removed_extras current wanted kept_prefix 0i32\n    set_changed wanted current 0i32\n\n:~ environment_restored (snapshot : string) (kept_prefix : string) : () =\n    ? environment_snapshot_usable snapshot = !-\n    ?> \"env.environment_restored: refusing an empty or truncated snapshot\" |> failwith\n    run_target_args' (snapshot, kept_prefix) \\|\n        | Rust => \\ snapshot, kept_prefix => rust_restored snapshot kept_prefix\n        | target => \\ _ => \"env.environment_restored / target: \" ++#? target |> failwith\n\n:= changed_after_snapshot () : () =\n    rust_set_var \"SPIRAL_RESTORE_CHANGED\" \"after\"\n    rust_set_var \"SPIRAL_RESTORE_ADDED\" \"1\"\n    rust_set_var \"SPIRAL_KEPT_NOTE\" \"kept\"\n\n:= snapshot_then_changed () : string =\n    rust_set_var \"SPIRAL_RESTORE_CHANGED\" \"before\"\n    := before = environment_snapshot ()\n    changed_after_snapshot ()\n    before\n\n:= restore_test_values () : string * string * string =\n    := read = get_environment_variable\n    read \"SPIRAL_RESTORE_CHANGED\", read \"SPIRAL_RESTORE_ADDED\", read \"SPIRAL_KEPT_NOTE\"","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  := append_path (path : string) : option string =
      := env_path = "PATH" |> get_environment_variable
      ? env_path = ""
      ?> None
      |:
          := env_sep = ? platform::is_windows () ?> ";" |: ":"
          path ++# env_sep ++# env_path |> Some

  :~ environment_snapshot () : string =
      run_target \|
          | Rust => \ () =>
              $'Rc::<str>::from(std::env::vars_os().map(|(key, value)| format\!("{}={}", key.to_string_lossy(), \
                  value.to_string_lossy())).collect::<Vec<_>>().join(&char::from(0u8).to_string()).as_str())' : string
          | target => \ () => "env.environment_snapshot / target: " ++#? target |> failwith

  := environment_snapshot_usable (snapshot : string) : bool =
      := nul = sm'::char_text 0u8
      := held = nul ++# snapshot |> sm'::to_lower
      := keeps (name : string) : bool =
          get_environment_variable name = "" || held |> sm'::contains (nul ++# sm'::to_lower name ++# "=")
      := critical =
          ? platform::is_windows ()
          ?> [ "PATH"; "SystemRoot"; "TEMP"; "TMP"; "USERPROFILE"; "LOCALAPPDATA"; "APPDATA" ]
          |: [ "PATH"; "HOME" ]
      snapshot <> "" && (critical |> listm::fold (\ kept name => kept && keeps name) !+)

  := rust_remove_var (key : string) : () = $'unsafe { std::env::remove_var(&*!key) }' : ()

  := rust_set_var (key : string) (value : string) : () = $'unsafe { std::env::set_var(&*!key, &*!value) }' : ()

  :== env_entries = array_base string

  := equals_after_first (entry : string) : i32 =
      := size : i32 = sm'::length entry
      ? size < 2i32 ?> -1i32 |: sm'::index_of "=" (sm'::substring 1i32 (size - 1i32) entry)

  := entry_pair (entry : string) : string * string =
      := found = equals_after_first entry
      := size : i32 = sm'::length entry
      ? found < 0i32 ?> "", ""
      |: sm'::substring 0i32 (found + 1i32) entry, sm'::substring (found + 2i32) (size - found - 2i32) entry

  := restorable (key : string) : bool = key <> "" && not (sm'::starts_with "=" key)

  :~ ^ value_in (all : env_entries) (key : string) (i : i32) : option string =
      ? i >= am'::length_base all ?> None
      |:
          := k, v = entry_pair (am'::index_base i all)
          ? k = key && restorable k ?> Some v |: value_in all key (i + 1i32)

  := extra (wanted : env_entries) (kept : string) (key : string) : bool =
      restorable key && not (sm'::starts_with kept key) && value_in wanted key 0i32 = None

  := remove_if_extra (wanted : env_entries) (kept : string) (entry : string) : () =
      := key, _ = entry_pair entry
      ? extra wanted kept key ?> rust_remove_var key

  :~ ^ removed_extras (current : env_entries) (wanted : env_entries) (kept : string) (i : i32) : () =
      ? i < am'::length_base current ?>
          remove_if_extra wanted kept (am'::index_base i current)
          removed_extras current wanted kept (i + 1i32)

  := set_if_changed (current : env_entries) (entry : string) : () =
      := key, value = entry_pair entry
      ? restorable key && value_in current key 0i32 <> Some value ?> rust_set_var key value

  :~ ^ set_changed (wanted : env_entries) (current : env_entries) (i : i32) : () =
      ? i < am'::length_base wanted ?>
          set_if_changed current (am'::index_base i wanted)
          set_changed wanted current (i + 1i32)

  := nul_split (text : string) = sm'::split (sm'::char_text 0u8) text

  := rust_restored (snapshot : string) (kept_prefix : string) : () =
      := wanted = nul_split snapshot
      := current = nul_split (environment_snapshot ())
      removed_extras current wanted kept_prefix 0i32
      set_changed wanted current 0i32

  :~ environment_restored (snapshot : string) (kept_prefix : string) : () =
      ? environment_snapshot_usable snapshot = !-
      ?> "env.environment_restored: refusing an empty or truncated snapshot" |> failwith
      run_target_args' (snapshot, kept_prefix) \|
          | Rust => \ snapshot, kept_prefix => rust_restored snapshot kept_prefix
          | target => \ _ => "env.environment_restored / target: " ++#? target |> failwith

  := changed_after_snapshot () : () =
      rust_set_var "SPIRAL_RESTORE_CHANGED" "after"
      rust_set_var "SPIRAL_RESTORE_ADDED" "1"
      rust_set_var "SPIRAL_KEPT_NOTE" "kept"

  := snapshot_then_changed () : string =
      rust_set_var "SPIRAL_RESTORE_CHANGED" "before"
      := before = environment_snapshot ()
      changed_after_snapshot ()
      before

  := restore_test_values () : string * string * string =
      := read = get_environment_variable
      read "SPIRAL_RESTORE_CHANGED", read "SPIRAL_RESTORE_ADDED", read "SPIRAL_KEPT_NOTE"
  """,
  timeout: 300_000
)
```

