## rust

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":":! var_error =\n    `(\n        rust::rust_type\n            `($'std_env_VarError')\n            `($'std::env::VarError')\n            \"type std_env_VarError = class end\"\n    )\n\n:= get_environment_variable_comptime (var : string) : string =\n    run_target_args (\\ () => var) \\|\n        | Rust => \\ var =>\n            :< rust_operators\n            !\\($'\"option_env\\!(\\\\\\\"\" + !var + \"\\\\\\\").unwrap_or(\\\\\\\"\\\\\\\")\"')\n            |> sm'::ref_to_std_string\n            |> sm'::from_std_string\n        | target => \\ _ => null ()","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  :! var_error =
      `(
          rust::rust_type
              `($'std_env_VarError')
              `($'std::env::VarError')
              "type std_env_VarError = class end"
      )

  := get_environment_variable_comptime (var : string) : string =
      run_target_args (\ () => var) \|
          | Rust => \ var =>
              :< rust_operators
              !\($'"option_env\!(\\\"" + !var + "\\\").unwrap_or(\\\"\\\")"')
              |> sm'::ref_to_std_string
              |> sm'::from_std_string
          | target => \ _ => null ()
  """,
  timeout: 300_000
)
```

