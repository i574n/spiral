:< sm'_operators

:# erlang_file static =
    :< testing

:= text_of_call (m : string) (f : string) (args : list erlang_term::term) : string =
    erlang_term::apply "unicode" "characters_to_binary" [ erlang_term::apply m f args ] |> erlang_term::cast

/// ## paths
:= dir_name (path : string) : string = text_of_call "filename" "dirname" [ erlang_term::of path ]

:= base_name (path : string) : string = text_of_call "filename" "basename" [ erlang_term::of path ]

:= absolute_path (path : string) : string = text_of_call "filename" "absname" [ erlang_term::of path ]

:= joined_path (dir : string) (name : string) : string = text_of_call "filename" "join" [ erlang_term::of dir; erlang_term::of name ]

/// ## files
:= file_written (path : string) (content : string) : bool =
    := r = erlang_term::apply "file" "write_file" [ erlang_term::of path; erlang_term::of content ]
    erlang_term::equal r (erlang_term::atom "ok")

:~ ^ items_from (native : erlang_term::term) (i : i32) (acc : list erlang_term::term) : list erlang_term::term =
    ? i < 1i32 ?> acc
    |: items_from native (i - 1i32) (erlang_term::apply "lists" "nth" [ erlang_term::of i; native ] :: acc)

:= items_of (native : erlang_term::term) : list erlang_term::term =
    items_from native (erlang_term::apply "erlang" "length" [ native ] |> erlang_term::cast) []

:= text_of (c : erlang_term::term) : string = erlang_term::apply "unicode" "characters_to_binary" [ c ] |> erlang_term::cast

:= matching_paths (pattern : string) : list string =
    erlang_term::apply "filelib" "wildcard" [ erlang_term::charlist pattern ] |> items_of |> listm::map text_of

/// ## output
:= put_text (s : string) : () = erlang_term::apply "io" "put_chars" [ erlang_term::of s ] |> ignore

///> gleam
:# a_path_splits_into_its_dir_and_base =
    (dir_name "a/b/c.spi", base_name "a/b/c.spi") |> _assert_eq ("a/b", "c.spi")

///> gleam
:# joining_a_dir_and_a_name_puts_one_separator =
    joined_path "a/b" "c.spi" |> _assert_eq "a/b/c.spi"

///> gleam
:# a_wildcard_lists_matching_files_as_strings =
    matching_paths "erlang_file.spi" |> _assert_eq [ "erlang_file.spi" ]

///> gleam
:# an_absolute_path_keeps_its_base_name =
    base_name (absolute_path "x.spi") |> _assert_eq "x.spi"
