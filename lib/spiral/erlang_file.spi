///> zig
:< sm'_operators

:# erlang_file static =
    :< testing

:= text_of_call (m : string) (f : string) (args : list erlang_term::term) : string =
    erlang_term::apply "unicode" "characters_to_binary" [ erlang_term::apply m f args ] |> erlang_term::cast

:= dir_name (path : string) : string = text_of_call "filename" "dirname" [ erlang_term::of path ]

:= base_name (path : string) : string = text_of_call "filename" "basename" [ erlang_term::of path ]

:= absolute_path (path : string) : string = text_of_call "filename" "absname" [ erlang_term::of path ]

:= joined_path (dir : string) (name : string) : string =
    text_of_call "filename" "join" [ erlang_term::of dir; erlang_term::of name ]

:= file_written (path : string) (content : string) : bool =
    := r = erlang_term::apply "file" "write_file" [ erlang_term::of path; erlang_term::of content ]
    erlang_term::equal r (erlang_term::atom "ok")

:= text_of (c : erlang_term::term) : string =
    erlang_term::apply "unicode" "characters_to_binary" [ c ] |> erlang_term::cast

:= matching_paths (pattern : string) : list string =
    erlang_term::apply "filelib" "wildcard" [ erlang_term::charlist pattern ]
    |> erlang_term::items_of
    |> listm::map text_of

:= append_mode () : erlang_term::term = erlang_term::list_term [ erlang_term::atom "append" ]

:= file_appended (path : string) (content : string) : bool =
    := r = erlang_term::apply "file" "write_file" [ erlang_term::of path; erlang_term::of content; append_mode () ]
    erlang_term::equal r (erlang_term::atom "ok")

:= file_text (path : string) : string =
    := r = erlang_term::apply "file" "read_file" [ erlang_term::of path ]
    erlang_term::apply "erlang" "element" [ erlang_term::of 2i32; r ] |> erlang_term::cast

:= regular_file (path : string) : bool =
    erlang_term::equal (erlang_term::apply "filelib" "is_regular" [ erlang_term::of path ]) (erlang_term::atom "true")

:= put_text (s : string) : () = erlang_term::apply "io" "put_chars" [ erlang_term::of s ] |> ignore

:= put_error_text (s : string) : () =
    erlang_term::apply "io" "put_chars" [ erlang_term::atom "standard_error"; erlang_term::of s ] |> ignore

///> gleam
:# a_path_splits_into_its_dir_and_base =
    (dir_name "a/b/c.spi", base_name "a/b/c.spi") |> _assert_eq ("a/b", "c.spi")

///> gleam
:# joining_a_dir_and_a_name_puts_one_separator =
    joined_path "a/b" "c.spi" |> _assert_eq "a/b/c.spi"

///> gleam
:# a_wildcard_lists_matching_files_as_strings =
    matching_paths "erlang_file.spi" |> _assert_eq [ "erlang_file.spi" ]

:= test_cache_directory () : string =
    text_of (
        erlang_term::apply "filename" "basedir" [ erlang_term::atom "user_cache"; erlang_term::of "erlang-file-test" ]
    )

:= test_cache_file (name : string) : string =
    := path = joined_path (test_cache_directory ()) name
    erlang_term::apply "filelib" "ensure_dir" [ erlang_term::of path ] |> ignore
    path

///> gleam
:# appending_adds_after_what_was_written =
    := path = test_cache_file "append.txt"
    := wrote = file_written path "a"
    := appended = file_appended path "b"
    (wrote, appended, file_text path) |> _assert_eq (!+, !+, "ab")

///> gleam
:# only_an_existing_file_is_regular =
    (regular_file "erlang_file.spi", regular_file "no_such_file.spi", regular_file ".") |> _assert_eq (!+, !-, !-)

///> gleam
:# an_absolute_path_keeps_its_base_name =
    base_name (absolute_path "x.spi") |> _assert_eq "x.spi"
