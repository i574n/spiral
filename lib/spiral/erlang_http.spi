:< sm'_operators

:# erlang_http static =
    :< testing

:| http_outcome =
    | Replied : i32 * string
    | Unreachable : string

:= started () : () =
    erlang_term::apply "application" "ensure_all_started" [ erlang_term::atom "inets" ] |> ignore
    erlang_term::apply "application" "ensure_all_started" [ erlang_term::atom "ssl" ] |> ignore

:= pair_of (a : erlang_term::term) (b : erlang_term::term) : erlang_term::term = erlang_term::tuple [ a; b ]

:= header (name : string) (value : string) : erlang_term::term =
    pair_of (erlang_term::charlist name) (erlang_term::charlist value)

:= atom_pair (key : string) (value : erlang_term::term) : erlang_term::term = pair_of (erlang_term::atom key) value

:= ssl_options (ca_file : string) : erlang_term::term =
    := verify = pair_of (erlang_term::atom "verify") (erlang_term::atom "verify_peer")
    erlang_term::list_term [ verify; pair_of (erlang_term::atom "cacertfile") (erlang_term::charlist ca_file) ]

:= http_options (ca_file : string) : erlang_term::term =
    := timeout = atom_pair "timeout" (erlang_term::of 10000i32)
    ? ca_file = ""
    ?> erlang_term::list_term [ timeout ]
    |: erlang_term::list_term [ timeout; atom_pair "ssl" (ssl_options ca_file) ]

:= binary_body () : erlang_term::term =
    erlang_term::list_term [ pair_of (erlang_term::atom "body_format") (erlang_term::atom "binary") ]

:= json_request (url : string) (headers : list erlang_term::term) (body : string) : erlang_term::term =
    := kind = erlang_term::charlist "application/json"
    erlang_term::tuple [ erlang_term::charlist url; erlang_term::list_term headers; kind; erlang_term::of body ]

:= ok_tagged (r : erlang_term::term) : bool =
    erlang_term::is_tuple r && erlang_term::equal (erlang_term::element_at 1i32 r) (erlang_term::atom "ok")

:= status_of (reply : erlang_term::term) : i32 =
    erlang_term::element_at 2i32 (erlang_term::element_at 1i32 reply) |> erlang_term::cast

:= replied_of (r : erlang_term::term) : http_outcome =
    := reply = erlang_term::element_at 2i32 r
    Replied (status_of reply, erlang_term::element_at 3i32 reply |> erlang_term::cast)

:= outcome_of (r : erlang_term::term) : http_outcome =
    ? ok_tagged r ?> replied_of r |: Unreachable (erlang_term::inspect r)

:= http_request_args (request : erlang_term::term) (ca_file : string) : list erlang_term::term =
    [ erlang_term::atom "post"; request; http_options ca_file; binary_body () ]

:= posted_json (url : string) (headers : list erlang_term::term) (body : string) (ca_file : string) : http_outcome =
    started ()
    := request = json_request url headers body
    erlang_term::apply "httpc" "request" (http_request_args request ca_file) |> outcome_of

:= is_unreachable (o : http_outcome) : bool = ?= o ?| Unreachable _ => !+ | Replied _ => !-

:= replied_status (o : http_outcome) : i32 = ?= o ?| Replied (status, _) => status | Unreachable _ => 0i32

:= replied_body (o : http_outcome) : string = ?= o ?| Replied (_, body) => body | Unreachable _ => ""

///> gleam
:# a_closed_port_is_unreachable =
    posted_json "http://127.0.0.1:9/x" [ header "authorization" "Bearer t" ] "{}" "" |> is_unreachable |> _assert_eq !+

///> gleam
:# a_reply_reads_its_status_and_body =
    := r = Replied (201i32, "ok")
    (replied_status r, replied_body r, replied_status (Unreachable "x")) |> _assert_eq (201i32, "ok", 0i32)
