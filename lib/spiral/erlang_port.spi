:< sm'_operators

:# erlang_port static =
    :< testing

:= erlang_port_imports () =
    global "import gleam/erlang/process"
    global "import gleam/result"

:! port = $'Dynamic'

:! selector = $'process.Selector(Dynamic)'

:! received = $'Result(Dynamic, Nil)'

:= spawn_executable_name (executable : erlang_term::term) : erlang_term::term =
    erlang_term::tuple [ erlang_term::atom "spawn_executable"; executable ]

:= open_executable (executable : erlang_term::term) (options : list erlang_term::term) : port =
    := name = spawn_executable_name executable
    erlang_term::apply "erlang" "open_port" [ name; erlang_term::list_term options ] |> erlang_term::cast

:= term_of (p : port) : erlang_term::term = erlang_term::of p

:= os_pid (p : port) : i32 =
    := info = erlang_term::apply "erlang" "port_info" [ term_of p; erlang_term::atom "os_pid" ]
    erlang_term::apply "erlang" "element" [ erlang_term::of 2i32; info ] |> erlang_term::cast

:= close (p : port) : bool = erlang_term::apply "erlang" "port_close" [ term_of p ] |> erlang_term::cast

:= unlink (p : port) : bool = erlang_term::apply "erlang" "unlink" [ term_of p ] |> erlang_term::cast

:= selector_of (p : port) : selector =
    erlang_port_imports ()
    := keep = \ (message : erlang_term::term) => message
    $'process.select_record(process.new_selector(), !p, 1, !keep)' : selector

:= receive_within (choices : selector) (timeout_ms : i32) : received =
    erlang_port_imports ()
    $'process.selector_receive(!choices, !timeout_ms)' : received

:= received_some (outcome : received) : bool =
    erlang_port_imports ()
    $'result.is_ok(!outcome)' : bool

:= received_message (outcome : received) (otherwise : erlang_term::term) : erlang_term::term =
    erlang_port_imports ()
    $'result.unwrap(!outcome, !otherwise)' : erlang_term::term

:= element (index : i32) (tuple : erlang_term::term) : erlang_term::term =
    erlang_term::apply "erlang" "element" [ erlang_term::of index; tuple ]

:= message_event (message : erlang_term::term) : erlang_term::term = element 2i32 message

:= event_kind (event : erlang_term::term) : string =
    erlang_term::apply "erlang" "atom_to_binary" [ element 1i32 event ] |> erlang_term::cast

:= event_value (event : erlang_term::term) : erlang_term::term = element 2i32 event

:= halt_args () : erlang_term::term =
    [ "-noshell"; "-eval"; "halt(3)." ] |> listm::map erlang_term::charlist |> erlang_term::list_term

:= erl_halt_port () : port =
    := found = erlang_term::apply "os" "find_executable" [ erlang_term::charlist "erl" ]
    := args = erlang_term::tuple [ erlang_term::atom "args"; halt_args () ]
    open_executable found [ erlang_term::atom "exit_status"; args ]

:= exit_text (outcome : received) : option string =
    := event = message_event (received_message outcome (erlang_term::atom "none"))
    ? event_kind event = "exit_status" ?> Some ("exit " ++#? (event_value event |> erlang_term::cast : i32)) |: None

:= exit_text_or (outcome : received) (next : () -> string) : string =
    ?= exit_text outcome ?|
    | Some text => text
    | None => next ()

:~ ^ exit_text_within (p : port) (left : i32) : string =
    := outcome = receive_within (selector_of p) 30000i32
    ? received_some outcome = !- || left <= 0i32 ?> "timeout"
    |: exit_text_or outcome \ () => exit_text_within p (left - 1i32)

///> gleam
:# an_executable_port_reports_its_os_pid_and_exit =
    := p = erl_halt_port ()
    (os_pid p > 0i32, exit_text_within p 50i32) |> _assert_eq (!+, "exit 3")

:| port_event =
    | Output : string
    | Exited : i32
    | Quiet

:| run_outcome =
    | Finished : i32 * string
    | TimedOut : string

:= event_named (event : erlang_term::term) : port_event =
    := kind = event_kind event
    ? kind = "exit_status" ?> Exited (event_value event |> erlang_term::cast)
    |? kind = "data" ?> Output (event_value event |> erlang_term::cast)
    |: Quiet

:= event_of (outcome : received) : port_event =
    ? received_some outcome
    ?> event_named (message_event (received_message outcome (erlang_term::atom "none")))
    |: Quiet

:= joined_output (parts : list string) : string = sm'::concat_list "" (listm::rev parts)

:= next_event (p : port) : port_event = event_of (receive_within (selector_of p) 1000i32)

:~ ^ run_collect (p : port) (quiet : i32) (parts : list string) : run_outcome =
    ?= next_event p ?|
    | Output text => run_collect p quiet (text :: parts)
    | Exited code => Finished (code, joined_output parts)
    | Quiet => after_quiet p quiet parts

:& :~ after_quiet (p : port) (quiet : i32) (parts : list string) : run_outcome =
    ? quiet <= 0i32 ?> TimedOut (joined_output parts) |: run_collect p (quiet - 1i32) parts

:= erl_eval_args (expression : string) : erlang_term::term =
    [ "-noshell"; "-eval"; expression ] |> listm::map erlang_term::charlist |> erlang_term::list_term

:= erl_eval_options (expression : string) : list erlang_term::term =
    [
        erlang_term::atom "binary"
        erlang_term::atom "exit_status"
        erlang_term::tuple [ erlang_term::atom "args"; erl_eval_args expression ]
    ]

:= erl_eval_port (expression : string) : port =
    := found = erlang_term::apply "os" "find_executable" [ erlang_term::charlist "erl" ]
    open_executable found (erl_eval_options expression)

///> gleam
:# a_run_collects_its_output_until_the_exit =
    run_collect (erl_eval_port "io:put_chars(\"hi\"), halt(3).") 60i32 [] |> _assert_eq (Finished (3i32, "hi"))
