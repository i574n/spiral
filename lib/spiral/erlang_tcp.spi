:< sm'_operators

:# erlang_tcp static =
    :< testing

:! socket = erlang_term::term

:! listener = erlang_term::term

:| tcp_failure =
    | Refused
    | TimedOut
    | Closed
    | Failed : string

:| tcp_wait =
    | Forever
    | WithinMs : i32

/// ## outcomes
:= element (index : i32) (tuple : erlang_term::term) : erlang_term::term =
    erlang_term::apply "erlang" "element" [ erlang_term::of index; tuple ]

:= failure_of (reason : erlang_term::term) : tcp_failure =
    ? erlang_term::equal reason (erlang_term::atom "econnrefused") ?> Refused
    |? erlang_term::equal reason (erlang_term::atom "timeout") ?> TimedOut
    |? erlang_term::equal reason (erlang_term::atom "closed") ?> Closed
    |: Failed (erlang_term::inspect reason)

:= is_ok (t : erlang_term::term) : bool = erlang_term::equal t (erlang_term::atom "ok")

:= outcome_of (t : erlang_term::term) : result erlang_term::term tcp_failure =
    ? is_ok (element 1i32 t) ?> Ok (element 2i32 t) |: Error (failure_of (element 2i32 t))

:= done_of (t : erlang_term::term) : result () tcp_failure = ? is_ok t ?> Ok () |: Error (failure_of (element 2i32 t))

:= wait_term (w : tcp_wait) : erlang_term::term =
    ?= w ?| Forever => erlang_term::atom "infinity" | WithinMs ms => erlang_term::of ms

/// ## line sockets
:= option_pair (key : string) (value : erlang_term::term) : erlang_term::term =
    erlang_term::tuple [ erlang_term::atom key; value ]

:= line_options () : list erlang_term::term =
    := framing = option_pair "packet" (erlang_term::atom "line")
    := passive = option_pair "active" (erlang_term::atom "false")
    [ erlang_term::atom "binary"; framing; passive; option_pair "packet_size" (erlang_term::of 8000000i32) ]

:= loopback () : erlang_term::term = [ 127i32; 0i32; 0i32; 1i32 ] |> listm::map erlang_term::of |> erlang_term::tuple

:= connect_local (port : i32) (timeout_ms : i32) : result socket tcp_failure =
    := args = [ loopback (); erlang_term::of port; erlang_term::list_term (line_options ()); erlang_term::of timeout_ms ]
    erlang_term::apply "gen_tcp" "connect" args |> outcome_of |> resultm::map socket

:= raw (s : socket) : erlang_term::term = ?= s ?| socket t => t

:= send_line (s : socket) (line : string) : result () tcp_failure =
    erlang_term::apply "gen_tcp" "send" [ raw s; erlang_term::of (line ++# "\n") ] |> done_of

:= trimmed (t : erlang_term::term) : string = erlang_term::apply "string" "trim" [ t ] |> erlang_term::cast

:= receive_line (s : socket) (w : tcp_wait) : result string tcp_failure =
    erlang_term::apply "gen_tcp" "recv" [ raw s; erlang_term::of 0i32; wait_term w ] |> outcome_of |> resultm::map trimmed

:= close (s : socket) : () =
    := closed = erlang_term::apply "gen_tcp" "close" [ raw s ]
    ()

/// ## listening, for local servers and tests
:= listen_local () : result listener tcp_failure =
    := opts = erlang_term::list_term (listm::append (line_options ()) [ option_pair "ip" (loopback ()) ])
    erlang_term::apply "gen_tcp" "listen" [ erlang_term::of 0i32; opts ] |> outcome_of |> resultm::map listener

:= listener_raw (l : listener) : erlang_term::term = ?= l ?| listener t => t

:= listener_port (l : listener) : i32 =
    ?= erlang_term::apply "inet" "port" [ listener_raw l ] |> outcome_of ?|
    | Ok port => erlang_term::cast port
    | Error _ => 0i32

:= accept (l : listener) (w : tcp_wait) : result socket tcp_failure =
    erlang_term::apply "gen_tcp" "accept" [ listener_raw l; wait_term w ] |> outcome_of |> resultm::map socket

:= stop_listening (l : listener) : () =
    := closed = erlang_term::apply "gen_tcp" "close" [ listener_raw l ]
    ()

:= failure \* t. (r : result t tcp_failure) : option tcp_failure =
    ?= r ?|
    | Ok _ => None
    | Error f => Some f

:= sure \* t. (r : result t tcp_failure) : t =
    ?= r ?|
    | Ok v => v
    | Error _ => failwith "erlang_tcp: unexpected failure in a test"

///> gleam
:# a_line_round_trips_over_a_loopback_socket =
    := l = listen_local () |> sure
    := client = connect_local (listener_port l) 2000i32 |> sure
    := server = accept l (WithinMs 2000i32) |> sure
    send_line client "hello\tworld" |> sure
    := heard = receive_line server (WithinMs 2000i32) |> sure
    send_line server "spiral-cells\t1" |> sure
    := answered = receive_line client (WithinMs 2000i32) |> sure
    close client
    close server
    stop_listening l
    (heard, answered) |> _assert_eq ("hello\tworld", "spiral-cells\t1")

///> gleam
:# an_idle_socket_times_out_and_a_closed_peer_reads_closed =
    := l = listen_local () |> sure
    := client = connect_local (listener_port l) 2000i32 |> sure
    := server = accept l (WithinMs 2000i32) |> sure
    := idle = receive_line client (WithinMs 50i32) |> failure
    close server
    := gone = receive_line client (WithinMs 2000i32) |> failure
    close client
    stop_listening l
    (idle, gone) |> _assert_eq (Some TimedOut, Some Closed)

///> gleam
:# a_port_nobody_listens_on_refuses =
    := l = listen_local () |> sure
    := port = listener_port l
    stop_listening l
    := f = connect_local port 2000i32 |> failure
    (f = Some Refused || f = Some TimedOut) |> _assert_eq !+
