:# f32_lanes static =
    :< testing

:== floats = array f32

:== partial = { a0 : f32; a1 : f32; a2 : f32; a3 : f32 }

:== span = { a : floats; ao : i32; b : floats; bo : i32 }

:= term (s : span) (j : i32) : f32 = index s::a (s::ao + j) * index s::b (s::bo + j)

:= step4 (s : span) (j : i32) (p : partial) : partial =
    {
        a0 = p::a0 + term s j
        a1 = p::a1 + term s (j + 1)
        a2 = p::a2 + term s (j + 2)
        a3 = p::a3 + term s (j + 3)
    }

:~ ^ quads (s : span) (n4 : i32) (j : i32) (p : partial) : partial =
    ? j >= n4 ?> p |: quads s n4 (j + 4) (step4 s j p)

:= zero_partial () : partial = { a0 = 0.0f32; a1 = 0.0f32; a2 = 0.0f32; a3 = 0.0f32 }

:= dot4 (a : floats) (ao : i32) (b : floats) (bo : i32) (n : i32) : f32 =
    := n4 = n - n % 4
    := p = quads { a = a; ao = ao; b = b; bo = bo } n4 0 (zero_partial ())
    f32_kernels::dot a ao b bo n n4 (p::a0 + p::a1 + (p::a2 + p::a3))

:~ ^ ramp_from (x : floats) (start : f32) (i : i32) : () =
    ? i < length x ?>
        set x i (start + conv i)
        ramp_from x start (i + 1)

:= ramp (n : i32) (start : f32) : floats =
    := x : floats = create n
    ramp_from x start 0
    x

:= exact_pair (n : i32) : f32 * f32 =
    := a, b = ramp n 1.0f32, ramp (n + 3) 2.0f32
    dot4 a 0 b 3 n, f32_kernels::dot a 0 b 3 n 0 0.0f32

:= wide_pair () : f32 * f32 =
    := a, b = ramp 288 0.125f32, ramp 288 (0.0f32 - 1.5f32)
    dot4 a 0 b 0 288, f32_kernels::dot a 0 b 0 288 0 0.0f32

///> c
///> rust
:# four_accumulators_equal_the_scalar_dot_on_exact_values =
    (exact_pair 16, exact_pair 7, exact_pair 3)
    |> _assert_eq ((2040.0f32, 2040.0f32), (252.0f32, 252.0f32), (38.0f32, 38.0f32))

///> c
///> rust
:# four_accumulators_stay_within_float_tolerance_of_the_scalar_dot =
    := got, want = wide_pair ()
    (abs (got - want) <= 0.001f32 * abs want) |> _assert_eq !+
