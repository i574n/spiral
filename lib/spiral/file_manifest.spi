///- --package .
:# file_manifest static =
    :< testing
    :< file_system_operators

:< sm'_operators

:== manifest_entry = { path : string; bytes : i64; sha256 : string }

:| manifest_change =
    | Added : string
    | Changed : string
    | Removed : string

:~ child_names (dir : string) : list string =
    file_system::read_directory_names dir
    |> resultm::unwrap'
    |> am'::vec_fold' (\ names name => sm'::from_std_string name :: names) []

:= relative_joined (rel : string) (name : string) : string = ? rel = "" ?> name |: rel ++# "/" ++# name

:= is_plain_file (root : string) (child : string) : bool = file_system::directory_exists (root ++# "/" ++# child) = !-

:= dir_at (root : string) (rel : string) : string = ? rel = "" ?> root |: root ++# "/" ++# rel

:= gather_child
    (recurse : string -> list string -> list string) (root : string) (skipped : list string) (rel : string)
    (acc : list string) (name : string)
    : list string
    =
    := child = relative_joined rel name
    ? is_plain_file root child ?> child :: acc |? listm'::contains name skipped ?> acc |: recurse child acc

:~ ^ files_under (root : string) (skipped : list string) (rel : string) (found : list string) : list string =
    child_names (dir_at root rel) |> listm::fold (gather_child (files_under root skipped) root skipped rel) found

:~ sorted (items : list string) : list string =
    array (listm'::to_array' (listm'::box items)) |> am'::sort |> am'::to_list' |> listm'::unbox

:~ entry_of (root : string) (rel : string) : manifest_entry =
    := full = root ++# "/" ++# rel
    := sha256 = full |> file_system::read_all_bytes |> stream::new_cursor |> crypto::hash_read |> resultm::unwrap'
    { path = rel; bytes = file_system::rust_file_length full; sha256 = sha256 }

:~ file_manifest (root : string) (skipped : list string) : list manifest_entry =
    files_under root skipped "" [] |> sorted |> listm::map (entry_of root)

:= manifest_line (entry : manifest_entry) : string =
    entry::sha256 ++# " " ++# sm'::show entry::bytes ++# " " ++# entry::path ++# "\n"

:~ manifest_text (entries : list manifest_entry) : string = entries |> listm::map manifest_line |> sm'::concat_list ""

:~ manifest_fingerprint (entries : list manifest_entry) : string = crypto::hash_text (manifest_text entries)

:= bytes_field (rest : string) (second : i32) : option i64 = convert::try_convert (sm'::slice 0i32 (second - 1i32) rest)

:= entry_parts (line : string) (first : i32) (rest : string) (second : i32) : option manifest_entry =
    := sha256 = sm'::slice 0i32 (first - 1i32) line
    := path = sm'::slice (second + 1i32) (sm'::length rest - 1i32) rest
    ?= bytes_field rest second ?|
    | Some bytes => Some { path = path; bytes = bytes; sha256 = sha256 }
    | None => None

:= after_first_space (line : string) (first : i32) : string =
    ? first < 0i32 ?> "" |: sm'::slice (first + 1i32) (sm'::length line - 1i32) line

:~ entry_of_line (line : string) : option manifest_entry =
    := first = sm'::index_of " " line
    := rest = after_first_space line first
    := second = sm'::index_of " " rest
    ? first <= 0i32 || second <= 0i32 || second + 1i32 >= sm'::length rest ?> None |: entry_parts line first rest second

:~ ^ entries_of (lines : list string) (acc : list manifest_entry) : option (list manifest_entry) =
    ?= lines ?|
    | [] => Some (listm::rev acc)
    | line :: rest ?& line = "" => entries_of rest acc
    | line :: rest =>
        ?= entry_of_line line ?|
        | Some found => entries_of rest (found :: acc)
        | None => None

:~ manifest_of_text (text : string) : option (list manifest_entry) =
    entries_of (sm'::split_list "\n" (sm'::replace "\r" "" text)) []

:= same_content (base : manifest_entry) (target : manifest_entry) : bool =
    base::sha256 = target::sha256 && base::bytes = target::bytes

:= drained (change : manifest_entry -> manifest_change) (rest : list manifest_entry) (acc : list manifest_change) : list manifest_change =
    listm::rev (listm::fold (\ (done : list manifest_change) (e : manifest_entry) => change e :: done) acc rest)

:= removed_change (b : manifest_entry) : manifest_change = Removed b::path

:= added_change (t : manifest_entry) : manifest_change = Added t::path

:~ ^ changes_from (base : list manifest_entry) (target : list manifest_entry) (acc : list manifest_change)
    : list manifest_change
    =
    ?= base, target ?|
    | _, [] => drained removed_change base acc
    | [], _ => drained added_change target acc
    | (b :: brest), (t :: trest) => changes_at base target b brest t trest acc

:& :~ changes_at
    (base : list manifest_entry) (target : list manifest_entry) (b : manifest_entry) (brest : list manifest_entry)
    (t : manifest_entry) (trest : list manifest_entry) (acc : list manifest_change)
    : list manifest_change
    =
    ? b::path = t::path
    ?> changes_from brest trest (? same_content b t ?> acc |: Changed t::path :: acc)
    |? lt_is (comp b::path t::path)
    ?> changes_from brest target (Removed b::path :: acc)
    |: changes_from base trest (Added t::path :: acc)

:~ manifest_changes (base : list manifest_entry) (target : list manifest_entry) : list manifest_change =
    changes_from base target []

:= change_line = \|
    | Added path => "added " ++# path
    | Changed path => "changed " ++# path
    | Removed path => "removed " ++# path

:= test_entry (path : string) (sha256 : string) : manifest_entry = { path = path; bytes = 1i64; sha256 = sha256 }

:= walk_base () : list manifest_entry = [ test_entry "a.txt" "1"; test_entry "b.txt" "2"; test_entry "d.txt" "4" ]

:= walk_target () : list manifest_entry = [ test_entry "b.txt" "2"; test_entry "c.txt" "3"; test_entry "d.txt" "5" ]

:= round_trip_entries () : list manifest_entry =
    [ { path = "a b.txt"; bytes = 12i64; sha256 = "aa" }; { path = "sub/c.txt"; bytes = 0i64; sha256 = "bb" } ]

:= make_sample_dirs (temp_dir : string) : () =
    file_system::create_dir_all (file_system::(</>) temp_dir "sub") |> resultm::unwrap'
    file_system::create_dir_all (file_system::(</>) temp_dir "target") |> resultm::unwrap'

:= nested_path (temp_dir : string) (dir : string) (name : string) : string =
    file_system::(</>) (file_system::(</>) temp_dir dir) name

:= write_sample_files (temp_dir : string) : () =
    "x" |> file_system::write_all_text (file_system::(</>) temp_dir "b.txt")
    "y" |> file_system::write_all_text (nested_path temp_dir "sub" "a.txt")
    "z" |> file_system::write_all_text (nested_path temp_dir "target" "skip.txt")

:= sample_tree_rows (temp_dir : string) : list (string * string) =
    file_manifest temp_dir [ "target" ] |> listm::map (\ (e : manifest_entry) => e::path, e::sha256)

:= sample_tree_expected () : list (string * string) =
    [
        ("b.txt", "2d711642b726b04401627ca9fbac32f5c8530fb1903cc4db02258717921a4881")
        ("sub/a.txt", "a1fce4363854ff888cff4b8e7875d600c2682390412a8cf79b37d0b11148b0fa")
    ]

:= stable_fingerprint (temp_dir : string) : bool =
    := entries = file_manifest temp_dir [ "target" ]
    manifest_fingerprint entries = manifest_fingerprint (file_manifest temp_dir [ "target" ])

:= sample_tree_dir (name : string) : string =
    := temp_dir, disposable = name |> crypto::hash_text |> file_system::create_temp_directory'
    disposable |> use |> ignore
    make_sample_dirs temp_dir
    write_sample_files temp_dir
    temp_dir

///> rust
:# changes_walk_two_sorted_manifests_once =
    manifest_changes (walk_base ()) (walk_target ()) |> listm::map change_line
    |> _assert_eq [ "removed a.txt"; "added c.txt"; "changed d.txt" ]

///> rust
:# the_canonical_text_lists_hash_bytes_and_path_per_line =
    manifest_text [ test_entry "a.txt" "1"; test_entry "sub/b.txt" "2" ] |> _assert_eq "1 1 a.txt\n2 1 sub/b.txt\n"

///> rust
:# the_canonical_text_reads_back_and_rejects_a_bad_line =
    manifest_of_text (manifest_text (round_trip_entries ())) |> _assert_eq (Some (round_trip_entries ()))

///> rust
:# a_bad_line_or_empty_text_reads_as_expected =
    manifest_of_text "aa 12 a.txt\r\nbb x c.txt\n" |> _assert_eq None
    manifest_of_text "" |> _assert_eq (Some [])

///> rust -d chrono regex sha2
:# a_tree_lists_sorted_relative_files_and_skips_named_directories =
    sample_tree_rows (sample_tree_dir "file_manifest_walk") |> _assert_eq (sample_tree_expected ())

///> rust -d chrono regex sha2
:# a_tree_fingerprint_is_stable =
    stable_fingerprint (sample_tree_dir "file_manifest_fingerprint") |> _assert_eq !+
