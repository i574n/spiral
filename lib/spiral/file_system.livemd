## file_system

<!-- livebook:{"break_markdown":true} -->

### (< />)

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"let (</>) (a : string) (b : string) : string =\n    run_target_args (fun () => a, b) function\n        | Rust => fun a, b =>\n            a\n            |> sm'.to_std_string\n            |> new_path_buf\n            |> path_buf_join b\n            |> path_buf_display\n            |> sm'.format'\n            |> sm'.from_std_string\n        | TypeScript => fun a, b =>\n            a |> ts_path_join b\n        | Fsharp => fun a, b =>\n            $'System.IO.Path.Combine (!a, !b)'\n        | target => fun a, b => failwith $'$\"file_system.(</>) / target: {!target} / a: {!a} / b: {!b}\"'","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  let (</>) (a : string) (b : string) : string =
      run_target_args (fun () => a, b) function
          | Rust => fun a, b =>
              a
              |> sm'.to_std_string
              |> new_path_buf
              |> path_buf_join b
              |> path_buf_display
              |> sm'.format'
              |> sm'.from_std_string
          | TypeScript => fun a, b =>
              a |> ts_path_join b
          | Fsharp => fun a, b =>
              $'System.IO.Path.Combine (!a, !b)'
          | target => fun a, b => failwith $'$"file_system.(</>) / target: {!target} / a: {!a} / b: {!b}"'
  """,
  timeout: 300_000
)
```

### get_temp_path

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"let get_temp_path () : string =\n    run_target function\n        | Rust => fun () =>\n            !\\($'\"std::env::temp_dir()\"')\n            |> path_buf_display\n            |> sm'.format'\n            |> sm'.from_std_string\n        | Fsharp => fun () =>\n            $'System.IO.Path.GetTempPath' ()\n        | target => fun () => failwith $'$\"file_system.get_temp_path / target: {!target}\"'","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  let get_temp_path () : string =
      run_target function
          | Rust => fun () =>
              !\($'"std::env::temp_dir()"')
              |> path_buf_display
              |> sm'.format'
              |> sm'.from_std_string
          | Fsharp => fun () =>
              $'System.IO.Path.GetTempPath' ()
          | target => fun () => failwith $'$"file_system.get_temp_path / target: {!target}"'
  """,
  timeout: 300_000
)
```

### get_file_name

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"let get_file_name (path : string) : string =\n    run_target_args' path function\n        | Fsharp => fun path =>\n            path |> $'System.IO.Path.GetFileName'\n        | Rust => fun path =>\n            path\n            |> sm'.to_std_string\n            |> new_path_buf\n            |> path_buf_file_name\n            |> optionm'.map' sm'.from_os_str_ref\n            |> optionm'.unbox\n            |> optionm'.default_value \"\"\n        | TypeScript => fun path =>\n            open typescript_operators\n            global \"type IPathBasename = abstract basename: path: string -> string\"\n            inl path' : $'IPathBasename' = typescript.import_all \"path\"\n            !\\\\(path, $'\"!path'.basename($0)\"')\n        | target => fun path => failwith $'$\"file_system.get_file_name / target: {!target} / path: {!path}\"'","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  let get_file_name (path : string) : string =
      run_target_args' path function
          | Fsharp => fun path =>
              path |> $'System.IO.Path.GetFileName'
          | Rust => fun path =>
              path
              |> sm'.to_std_string
              |> new_path_buf
              |> path_buf_file_name
              |> optionm'.map' sm'.from_os_str_ref
              |> optionm'.unbox
              |> optionm'.default_value ""
          | TypeScript => fun path =>
              open typescript_operators
              global "type IPathBasename = abstract basename: path: string -> string"
              inl path' : $'IPathBasename' = typescript.import_all "path"
              !\\(path, $'"!path'.basename($0)"')
          | target => fun path => failwith $'$"file_system.get_file_name / target: {!target} / path: {!path}"'
  """,
  timeout: 300_000
)
```

### get_file_name_without_extension

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"let get_file_name_without_extension (path : string) : string =\n    run_target_args' path function\n        | Rust => fun path =>\n            inl path_buf = path |> sm'.to_std_string |> new_path_buf\n            inl file_stem = !\\\\(path_buf, $'\"$0.file_stem()\"')\n            match file_stem |> optionm'.map' sm'.from_os_str_ref |> optionm'.unbox with\n            | Some file_stem => file_stem\n            | None => \"\"\n        | _ => fun path =>\n            path |> $'System.IO.Path.GetFileNameWithoutExtension'","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  let get_file_name_without_extension (path : string) : string =
      run_target_args' path function
          | Rust => fun path =>
              inl path_buf = path |> sm'.to_std_string |> new_path_buf
              inl file_stem = !\\(path_buf, $'"$0.file_stem()"')
              match file_stem |> optionm'.map' sm'.from_os_str_ref |> optionm'.unbox with
              | Some file_stem => file_stem
              | None => ""
          | _ => fun path =>
              path |> $'System.IO.Path.GetFileNameWithoutExtension'
  """,
