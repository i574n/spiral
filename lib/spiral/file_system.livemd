<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"inl path_buf_display (path_buf : path_buf) : display =\n    run_target_args (fun () => path_buf) function\n        | Rust => fun path_buf =>\n            inl path_buf = join path_buf\n            !\\($'\"!path_buf.display()\"')\n        | _ => fun path_buf => path_buf |> convert.unbox","print_code":false},"livebook_object":"smart_cell"} -->

