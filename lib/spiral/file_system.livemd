### file_share

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"nominal file_share' = $'System.IO.FileShare'\n\nunion file_share =\n    | ShareNone\n    | ShareRead\n    | ShareWrite\n    | ShareReadWrite\n    | ShareDelete\n\ninl file_share = function\n    | ShareNone => $'System.IO.FileShare.None' : file_share'\n    | ShareRead => $'System.IO.FileShare.Read' : file_share'\n    | ShareWrite => $'System.IO.FileShare.Write' : file_share'\n    | ShareReadWrite => $'System.IO.FileShare.ReadWrite' : file_share'\n    | ShareDelete => $'System.IO.FileShare.Delete' : file_share'","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  nominal file_share' = $'System.IO.FileShare'

  union file_share =
      | ShareNone
      | ShareRead
      | ShareWrite
      | ShareReadWrite
      | ShareDelete

  inl file_share = function
      | ShareNone => $'System.IO.FileShare.None' : file_share'
      | ShareRead => $'System.IO.FileShare.Read' : file_share'
      | ShareWrite => $'System.IO.FileShare.Write' : file_share'
      | ShareReadWrite => $'System.IO.FileShare.ReadWrite' : file_share'
      | ShareDelete => $'System.IO.FileShare.Delete' : file_share'
  """,
  timeout: 300_000
)
```

### file_stream

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"nominal file_stream' = $'System.IO.FileStream'\n\ninl file_stream (path : string) mode access share : file_stream' =\n    run_target function\n        | Fsharp => fun () =>\n            inl mode = mode |> file_mode\n            inl access = access |> file_access\n            inl share = share |> file_share\n            $'new System.IO.FileStream (!path, !mode, !access, !share)'\n        | _ => fun () => null ()","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  nominal file_stream' = $'System.IO.FileStream'

  inl file_stream (path : string) mode access share : file_stream' =
      run_target function
          | Fsharp => fun () =>
              inl mode = mode |> file_mode
              inl access = access |> file_access
              inl share = share |> file_share
              $'new System.IO.FileStream (!path, !mode, !access, !share)'
          | _ => fun () => null ()
  """,
  timeout: 300_000
)
```

### file_info

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"nominal file_info =\n    `(\n        backend_switch `(()) `({}) {\n            Fsharp = (fun () =>\n                global \"type System_IO_FileInfo = System.IO.FileInfo\\n\"\n                        ) : () -> ()\n        }\n        $'' : $'System_IO_FileInfo'\n    )\n\ninl file_info (path : string) : file_info =\n    run_target function\n        | Fsharp => fun () => $'!path |> `file_info '\n        | _ => fun () => null ()","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  nominal file_info =
      `(
          backend_switch `(()) `({}) {
              Fsharp = (fun () =>
                  global "type System_IO_FileInfo = System.IO.FileInfo\n"
                          ) : () -> ()
          }
          $'' : $'System_IO_FileInfo'
      )

  inl file_info (path : string) : file_info =
      run_target function
          | Fsharp => fun () => $'!path |> `file_info '
          | _ => fun () => null ()
  """,
  timeout: 300_000
)
```

