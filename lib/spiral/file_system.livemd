### link_directory

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"let link_directory target_path path =\n    if target_path |> directory_exists |> not\n    then target_path |> create_dir |> ignore\n\n    inl lib_dir_path = path |> directory_get_parent |> optionm'.default_value' \"\"\n    if lib_dir_path |> directory_exists |> not\n    then lib_dir_path |> create_dir |> ignore\n\n    if (path |> directory_exists)\n        && (path |> read_link |> resultm.is_err)\n    then path |> directory_delete true\n\n    if path |> directory_exists |> not\n    then path |> directory_create_symbolic_link target_path","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  let link_directory target_path path =
      if target_path |> directory_exists |> not
      then target_path |> create_dir |> ignore

      inl lib_dir_path = path |> directory_get_parent |> optionm'.default_value' ""
      if lib_dir_path |> directory_exists |> not
      then lib_dir_path |> create_dir |> ignore

      if (path |> directory_exists)
          && (path |> read_link |> resultm.is_err)
      then path |> directory_delete true

      if path |> directory_exists |> not
      then path |> directory_create_symbolic_link target_path
  """,
  timeout: 300_000
)
```

### link_file

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"let link_file target_path path =\n    if (path |> file_exists)\n        && (path |> read_link |> resultm.is_err)\n    then path |> file_delete\n\n    if path |> file_exists |> not\n    then path |> file_create_symbolic_link target_path","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  let link_file target_path path =
      if (path |> file_exists)
          && (path |> read_link |> resultm.is_err)
      then path |> file_delete

      if path |> file_exists |> not
      then path |> file_create_symbolic_link target_path
  """,
  timeout: 300_000
)
```

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"///- --test\n///> rust -d sha2 regex\n\ninl file_name = \"LICENSE\"\ninl text = file_name\n\ninl test_hash =\n    #?*(file_name, text)\n    |> crypto.hash_text\n\ninl workspace_root = get_workspace_root ()\ninl test_dir = workspace_root </> \"target/test/file_system\" </> test_hash\n\ninl disposable = test_dir |> create_dir\ndisposable |> use |> ignore\n\ninl dir_path = test_dir </> \"dir1\"\n\nif dir_path |> directory_exists\nthen dir_path |> directory_delete true\n\ndir_path |> create_dir |> ignore\n\ninl path = dir_path </> file_name\ntext |> write_all_text path\n\ninl dir_link_path = test_dir </> \"link1\"\n\ndir_link_path |> link_directory dir_path\n\ninl link_path = dir_link_path </> file_name\n\nlink_path\n|> read_all_text\n|> _assert_eq text\n\ndir_link_path\n|> read_link\n|> resultm.unwrap'\n|> path_buf_display\n|> convert.convert\n|> _assert sm'.ends_with \"dir1\"\n\nlink_path\n|> read_link\n|> resultm.unwrap'\n|> path_buf_display\n|> convert.convert\n|> _assert sm'.ends_with \"LICENSE\"\n\ninl link_name = \"LICENSE_\"\n\ninl link_path = dir_path </> link_name\n\nlink_path |> link_file path\n\ninl link_path' = dir_link_path </> link_name\n\nlink_path'\n|> read_all_text\n|> _assert_eq text\n\nlink_path\n|> read_link\n|> resultm.unwrap'\n|> path_buf_display\n|> convert.convert\n|> _assert sm'.ends_with \"LICENSE\"\n\nlink_path'\n|> read_link\n|> resultm.unwrap'\n|> path_buf_display\n|> convert.convert\n|> _assert sm'.ends_with \"LICENSE\"","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  ///- --test
  ///> rust -d sha2 regex

  inl file_name = "LICENSE"
  inl text = file_name

  inl test_hash =
      #?*(file_name, text)
      |> crypto.hash_text

  inl workspace_root = get_workspace_root ()
  inl test_dir = workspace_root </> "target/test/file_system" </> test_hash

  inl disposable = test_dir |> create_dir
  disposable |> use |> ignore

  inl dir_path = test_dir </> "dir1"

  if dir_path |> directory_exists
  then dir_path |> directory_delete true

  dir_path |> create_dir |> ignore

  inl path = dir_path </> file_name
  text |> write_all_text path

  inl dir_link_path = test_dir </> "link1"

  dir_link_path |> link_directory dir_path

  inl link_path = dir_link_path </> file_name

  link_path
  |> read_all_text
  |> _assert_eq text

  dir_link_path
  |> read_link
  |> resultm.unwrap'
  |> path_buf_display
  |> convert.convert
  |> _assert sm'.ends_with "dir1"

  link_path
  |> read_link
  |> resultm.unwrap'
  |> path_buf_display
  |> convert.convert
  |> _assert sm'.ends_with "LICENSE"

  inl link_name = "LICENSE_"

  inl link_path = dir_path </> link_name

  link_path |> link_file path

  inl link_path' = dir_link_path </> link_name

  link_path'
  |> read_all_text
  |> _assert_eq text

  link_path
  |> read_link
  |> resultm.unwrap'
  |> path_buf_display
  |> convert.convert
  |> _assert sm'.ends_with "LICENSE"

  link_path'
  |> read_link
  |> resultm.unwrap'
  |> path_buf_display
  |> convert.convert
  |> _assert sm'.ends_with "LICENSE"
  """,
  timeout: 300_000
)
```

## rust

<!-- livebook:{"break_markdown":true} -->

### file_exists_content

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"let file_exists_content path content : bool =\n    run_target function\n        | Rust => fun () =>\n            if path |> file_exists |> not\n            then false\n            else\n                inl existing_content = path |> read_all_text\n                content = existing_content\n        | _ => fun () => null ()","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  let file_exists_content path content : bool =
      run_target function
          | Rust => fun () =>
              if path |> file_exists |> not
              then false
              else
                  inl existing_content = path |> read_all_text
                  content = existing_content
          | _ => fun () => null ()
  """,
  timeout: 300_000
)
```

### write_all_text_exists

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"let write_all_text_exists path contents =\n    inl exists' = contents |> file_exists_content path\n    if not exists' then\n        inl dir = path |> directory_get_parent |> optionm'.default_value' \"\"\n        if dir |> directory_exists |> not\n        then dir |> create_dir |> ignore\n        contents |> write_all_text path","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  let write_all_text_exists path contents =
      inl exists' = contents |> file_exists_content path
      if not exists' then
          inl dir = path |> directory_get_parent |> optionm'.default_value' ""
          if dir |> directory_exists |> not
          then dir |> create_dir |> ignore
          contents |> write_all_text path
  """,
  timeout: 300_000
)
```

## main

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"///> fsharp\n\ninl main () =\n    init_trace_state None\n    $'let file_exists_content x = !file_exists_content x' : ()\n    $'let write_all_text_async x = !write_all_text_async x' : ()\n    $'let create_temp_path () = !create_temp_path ()' : ()\n    $'let create_temp_dir () = !create_temp_dir ()' : ()\n    $'let create_temp_dir\\' x = !create_temp_dir' x' : ()\n    $'let get_source_directory () = !get_source_directory ()' : ()\n    $'let normalize_path x = !normalize_path x' : ()\n    $'let get_full_path x = !get_full_path x' : ()\n    $'let standardize_path x = !standardize_path x' : ()\n    $'let new_file_uri x = !new_file_uri x' : ()\n    $'let get_workspace_root () = !get_workspace_root ()' : ()\n    $'let link_directory x = !link_directory x' : ()\n    inl combine x = (</>) x\n    $'let (</>) x = !combine x' : ()","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  ///> fsharp

  inl main () =
      init_trace_state None
      $'let file_exists_content x = !file_exists_content x' : ()
      $'let write_all_text_async x = !write_all_text_async x' : ()
      $'let create_temp_path () = !create_temp_path ()' : ()
      $'let create_temp_dir () = !create_temp_dir ()' : ()
      $'let create_temp_dir\' x = !create_temp_dir' x' : ()
      $'let get_source_directory () = !get_source_directory ()' : ()
      $'let normalize_path x = !normalize_path x' : ()
      $'let get_full_path x = !get_full_path x' : ()
      $'let standardize_path x = !standardize_path x' : ()
      $'let new_file_uri x = !new_file_uri x' : ()
      $'let get_workspace_root () = !get_workspace_root ()' : ()
      $'let link_directory x = !link_directory x' : ()
      inl combine x = (</>) x
      $'let (</>) x = !combine x' : ()
  """,
  timeout: 300_000
)
```
