### file_copy

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"let file_copy (new_path : string) (old_path : string) : () =\n    run_target_args' (old_path, new_path) function\n        | Fsharp => fun old_path, new_path =>\n            $'System.IO.File.Copy (!old_path, !new_path, true)'\n        | Rust => fun old_path, new_path =>\n            inl result : _ _ stream.io_error = !\\\\((old_path, new_path), $'\"std::fs::copy(&*$0, &*$1)\"')\n            match result |> resultm.map_error' sm'.format' |> resultm.unbox with\n            | Ok (result : u64) =>\n                trace Debug\n                    fun () => \"file_system.file_copy\"\n                    fun () => { old_path new_path result }\n            | Error error =>\n                trace Warning\n                    fun () => \"file_system.file_copy\"\n                    fun () => { old_path new_path error }\n        | _ => fun _ => ()","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  let file_copy (new_path : string) (old_path : string) : () =
      run_target_args' (old_path, new_path) function
          | Fsharp => fun old_path, new_path =>
              $'System.IO.File.Copy (!old_path, !new_path, true)'
          | Rust => fun old_path, new_path =>
              inl result : _ _ stream.io_error = !\\((old_path, new_path), $'"std::fs::copy(&*$0, &*$1)"')
              match result |> resultm.map_error' sm'.format' |> resultm.unbox with
              | Ok (result : u64) =>
                  trace Debug
                      fun () => "file_system.file_copy"
                      fun () => { old_path new_path result }
              | Error error =>
                  trace Warning
                      fun () => "file_system.file_copy"
                      fun () => { old_path new_path error }
          | _ => fun _ => ()
  """,
  timeout: 300_000
)
```

