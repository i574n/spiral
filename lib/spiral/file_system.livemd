### file_delete

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"inl file_delete (path : string) : () =\n    run_target function\n        | Fsharp => fun () =>\n            path |> $'System.IO.File.Delete'\n        | Rust => fun () =>\n            inl result : resultm.result' () stream.io_error =\n                if path |> file_exists\n                then !\\\\(path, $'\"std::fs::remove_file(&*$0)\"')\n                else Ok () |> resultm.box\n            match result |> resultm.map_error' sm'.format |> resultm.unbox with\n            | Ok () => ()\n            | Error error' => trace Critical (fun () => \"file_system.file_delete\") fun () => { error' }\n        | _ => fun () => ()","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  inl file_delete (path : string) : () =
      run_target function
          | Fsharp => fun () =>
              path |> $'System.IO.File.Delete'
          | Rust => fun () =>
              inl result : resultm.result' () stream.io_error =
                  if path |> file_exists
                  then !\\(path, $'"std::fs::remove_file(&*$0)"')
                  else Ok () |> resultm.box
              match result |> resultm.map_error' sm'.format |> resultm.unbox with
              | Ok () => ()
              | Error error' => trace Critical (fun () => "file_system.file_delete") fun () => { error' }
          | _ => fun () => ()
  """,
  timeout: 300_000
)
```

### read_link

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"let read_link (path : string) : resultm.result' path_buf stream.io_error =\n    let run 루프 n error path' =\n        inl name = path' |> get_file_name\n        inl parent = path' |> directory_get_parent |> optionm'.unbox\n        inl error'' = #?error\n        match parent with\n        | _ when n >= 11 =>\n            ($'$\"file_system.read_link / \"' : string)\n            +. $'$\"path: {!path} / n: {!n} / path\\': {!path'} / name: {!name}\"'\n            |> stream.new_io_error\n            |> resultm.err\n        | Some parent when path' <>. \"\" =>\n            match 루프 (n + 1) parent |> resultm.map_error' sm'.format |> resultm.unbox with\n            | Ok parent' =>\n                (parent' |> path_buf_display |> convert.convert) </> name\n                |> sm'.to_std_string\n                |> new_path_buf\n                |> resultm.ok''\n            | Error error' =>\n                ($'$\"file_system.read_link / \"' : string)\n                +. $'$\"error\\': {!error'} / error: {!error''} / name: {!name}\"'\n                |> stream.new_io_error\n                |> resultm.err\n        | _ =>\n            ($'$\"file_system.read_link / run / The file or directory is not a reparse point. / \"' : string)\n            +. $'$\"path: {!path} / error: {!error''} / path\\': {!path'} / name: {!name}\"'\n            |> stream.new_io_error\n            |> resultm.err\n\n    run_target function\n        | Rust => fun () =>\n            if path |> directory_exists\n            then !\\\\(path, $'\"std::fs::read_link(&*$0)\"')\n            else\n                // let rec 루프 n path' =\n                let rec 루프 forall t {number}.\n                    (n : t)\n                    (path' : string)\n                    : resultm.result' path_buf stream.io_error\n                    =\n                    run_target function\n                        | Rust => fun () =>\n                            inl result : _ _ stream.io_error = !\\\\(path', $'\"std::fs::read_link(&*$0)\"')\n                            inl result = result |> resultm.map_error' sm'.format |> resultm.unbox\n                            match result with\n                            | Ok x => x |> resultm.ok''\n                            | Error error => path' |> run 루프 n error\n                        | _ => fun () => null ()\n                path |> 루프 0u8\n        | Fsharp _\n        | TypeScript _ => fun () =>\n            // let rec 루프 n path' =\n            let rec 루프 forall t {number}.\n                (n : t)\n                (path' : string)\n                : resultm.result' path_buf stream.io_error\n                =\n                inl result =\n                    path'\n                    |> directory_info\n                    |> directory_info_attributes\n                    |> file_attributes_has_flag (file_attributes_reparse_point ())\n                if result then\n                    path'\n                    |> file_info\n                    |> file_info_link_target\n                    |> convert.unbox\n                    |> resultm.ok''\n                else\n                    inl error =\n                        ($'$\"file_system.read_link / Fsharp / \"' : string)\n                        +. $'$\"The file or directory is not a reparse point. / \"'\n                        +. $'$\"path: {!path} / result: {!result} / path\\': {!path'} / n: {!n}\"'\n                        |> stream.new_io_error\n                    path' |> run 루프 n error\n            path |> 루프 0u8\n        | _ => fun () => $'Unchecked.defaultof<_>'","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  let read_link (path : string) : resultm.result' path_buf stream.io_error =
      let run 루프 n error path' =
          inl name = path' |> get_file_name
          inl parent = path' |> directory_get_parent |> optionm'.unbox
          inl error'' = #?error
          match parent with
          | _ when n >= 11 =>
              ($'$"file_system.read_link / "' : string)
              +. $'$"path: {!path} / n: {!n} / path\': {!path'} / name: {!name}"'
              |> stream.new_io_error
              |> resultm.err
          | Some parent when path' <>. "" =>
              match 루프 (n + 1) parent |> resultm.map_error' sm'.format |> resultm.unbox with
              | Ok parent' =>
                  (parent' |> path_buf_display |> convert.convert) </> name
                  |> sm'.to_std_string
                  |> new_path_buf
                  |> resultm.ok''
              | Error error' =>
                  ($'$"file_system.read_link / "' : string)
                  +. $'$"error\': {!error'} / error: {!error''} / name: {!name}"'
                  |> stream.new_io_error
                  |> resultm.err
          | _ =>
              ($'$"file_system.read_link / run / The file or directory is not a reparse point. / "' : string)
              +. $'$"path: {!path} / error: {!error''} / path\': {!path'} / name: {!name}"'
              |> stream.new_io_error
              |> resultm.err

      run_target function
          | Rust => fun () =>
              if path |> directory_exists
              then !\\(path, $'"std::fs::read_link(&*$0)"')
              else
                  // let rec 루프 n path' =
                  let rec 루프 forall t {number}.
                      (n : t)
                      (path' : string)
                      : resultm.result' path_buf stream.io_error
                      =
                      run_target function
                          | Rust => fun () =>
                              inl result : _ _ stream.io_error = !\\(path', $'"std::fs::read_link(&*$0)"')
                              inl result = result |> resultm.map_error' sm'.format |> resultm.unbox
                              match result with
                              | Ok x => x |> resultm.ok''
                              | Error error => path' |> run 루프 n error
                          | _ => fun () => null ()
                  path |> 루프 0u8
          | Fsharp _
          | TypeScript _ => fun () =>
              // let rec 루프 n path' =
              let rec 루프 forall t {number}.
                  (n : t)
                  (path' : string)
                  : resultm.result' path_buf stream.io_error
                  =
                  inl result =
                      path'
                      |> directory_info
                      |> directory_info_attributes
                      |> file_attributes_has_flag (file_attributes_reparse_point ())
                  if result then
                      path'
                      |> file_info
                      |> file_info_link_target
                      |> convert.unbox
                      |> resultm.ok''
                  else
                      inl error =
                          ($'$"file_system.read_link / Fsharp / "' : string)
                          +. $'$"The file or directory is not a reparse point. / "'
                          +. $'$"path: {!path} / result: {!result} / path\': {!path'} / n: {!n}"'
                          |> stream.new_io_error
                      path' |> run 루프 n error
              path |> 루프 0u8
          | _ => fun () => $'Unchecked.defaultof<_>'
  """,
  timeout: 300_000
)
```

### normalize_path

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"let normalize_path (path : string) : string =\n    if path = \"\"\n    then \"\"\n    else\n        inl result =\n            match path |> read_link |> resultm.ok' |> optionm'.unbox with\n            | Some path_buf =>\n                path_buf\n                |> path_buf_display\n                |> convert.convert\n            | None => path\n        inl result =\n            if result = \"\"\n            then path\n            else result\n        inl result' = result |> sm'.replace_regex @\"^\\\\\\\\\\?\\\\\" \"\"\n        if ##result' < 2\n        then path\n        else sm'.(++#) (result' |> sm'.slice 0i32 0i32 |> sm'.to_lower) (result' |> sm'.slice 1i32 ((sm'.length result' : i32) - 1i32)) |> sm'.replace \"\\\\\" \"/\"","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  let normalize_path (path : string) : string =
      if path = ""
      then ""
      else
          inl result =
              match path |> read_link |> resultm.ok' |> optionm'.unbox with
              | Some path_buf =>
                  path_buf
                  |> path_buf_display
                  |> convert.convert
              | None => path
          inl result =
              if result = ""
              then path
              else result
          inl result' = result |> sm'.replace_regex @"^\\\\\?\\" ""
          if ##result' < 2
          then path
          else sm'.(++#) (result' |> sm'.slice 0i32 0i32 |> sm'.to_lower) (result' |> sm'.slice 1i32 ((sm'.length result' : i32) - 1i32)) |> sm'.replace "\\" "/"
  """,
  timeout: 300_000
)
```

### get_workspace_root

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"inl get_workspace_root () =\n    inl dirs =\n        [ get_current_directory; get_source_directory; fun () => \"/workspaces\" ]\n    let run dir =\n        dir\n        |> find_parent Directory (\"spiral\" </> \"workspace\")\n        |> function\n            | Ok dir => dir |> normalize_path |> Some\n            | Error error =>\n                trace Warning\n                    fun () => \"file_system.get_workspace_root\"\n                    fun () => { dir error }\n                None\n    inl root =\n        (None, dirs)\n        ||> listm.fold fun acc dir =>\n            match acc with\n            | Some dir => Some dir\n            | None => dir () |> run\n        |> optionm.value\n    inl root =\n        match root |> get_file_name with\n        | \"deps\" =>\n            root\n            |> directory_get_parent\n            |> optionm'.get'\n            |> run\n            |> optionm.value\n        | _ => root\n    root </> \"polyglot\"","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  inl get_workspace_root () =
      inl dirs =
          [ get_current_directory; get_source_directory; fun () => "/workspaces" ]
      let run dir =
          dir
          |> find_parent Directory ("spiral" </> "workspace")
          |> function
              | Ok dir => dir |> normalize_path |> Some
              | Error error =>
                  trace Warning
                      fun () => "file_system.get_workspace_root"
                      fun () => { dir error }
                  None
      inl root =
          (None, dirs)
          ||> listm.fold fun acc dir =>
              match acc with
              | Some dir => Some dir
              | None => dir () |> run
          |> optionm.value
      inl root =
          match root |> get_file_name with
          | "deps" =>
              root
              |> directory_get_parent
              |> optionm'.get'
              |> run
              |> optionm.value
          | _ => root
      root </> "polyglot"
  """,
  timeout: 300_000
)
```

