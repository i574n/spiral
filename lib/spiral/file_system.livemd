      fun () =>
          join
              get_source_directory ()
              |> find_parent file_type file
              |> resultm.get
              |> sm'.to_std_string
              |> new_path_buf
              |> path_buf_file_name
              |> optionm'.try'
              |> sm'.from_os_str_ref
              |> Some
              |> optionm'.box
      |> fun x => x () |> optionm'.unbox
      |> optionm'.default_value ""
