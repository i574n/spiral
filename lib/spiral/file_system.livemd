### directory_get_parent

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"let directory_get_parent (path : string) : optionm'.option' string =\n    run_target_args' path function\n        | Fsharp => fun path =>\n            inl parent : directory_info = path |> $'System.IO.Directory.GetParent'\n            if parent =. null ()\n            then None\n            else parent |> directory_info_full_name |> Some\n            |> optionm'.box\n        | Rust => fun path =>\n            inl path_buf = path |> sm'.to_std_string |> new_path_buf\n            inl parent = path_buf |> path_buf_parent\n            parent\n            |> optionm'.map' (path_buf_display >> sm'.format' >> sm'.from_std_string)\n        | TypeScript _ => fun path =>\n            open typescript_operators\n            global \"type IPathDirname = abstract dirname: path: string -> string\"\n            inl path' : $'IPathDirname' = typescript.import_all \"path\"\n            inl parent = !\\\\(path, $'\"!path'.dirname($0)\"')\n            if parent = path\n            then None\n            else parent |> Some\n            |> optionm'.box\n        | _ => fun _ => optionm'.none' ()","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  let directory_get_parent (path : string) : optionm'.option' string =
      run_target_args' path function
          | Fsharp => fun path =>
              inl parent : directory_info = path |> $'System.IO.Directory.GetParent'
              if parent =. null ()
              then None
              else parent |> directory_info_full_name |> Some
              |> optionm'.box
          | Rust => fun path =>
              inl path_buf = path |> sm'.to_std_string |> new_path_buf
              inl parent = path_buf |> path_buf_parent
              parent
              |> optionm'.map' (path_buf_display >> sm'.format' >> sm'.from_std_string)
          | TypeScript _ => fun path =>
              open typescript_operators
              global "type IPathDirname = abstract dirname: path: string -> string"
              inl path' : $'IPathDirname' = typescript.import_all "path"
              inl parent = !\\(path, $'"!path'.dirname($0)"')
              if parent = path
              then None
              else parent |> Some
              |> optionm'.box
          | _ => fun _ => optionm'.none' ()
  """,
  timeout: 300_000
)
```

