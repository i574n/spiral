<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"inl create_temp_dir () =\n    inl dir = create_temp_path ()\n    dir, dir |> create_dir","print_code":false},"livebook_object":"smart_cell"} -->

