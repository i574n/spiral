/// # file_system
:< sm'_operators
:< rust
:< rust_operators

test file_system static =
    :< testing

/// ## fsharp

/// ### file_mode
:! file_mode' = $'System.IO.FileMode'

:| file_mode =
    | ModeCreateNew
    | ModeCreate
    | ModeOpen
    | ModeOpenOrCreate
    | Truncate
    | Append

:= file_mode = \|
    | ModeCreateNew => $'System.IO.FileMode.CreateNew' : file_mode'
    | ModeCreate => $'System.IO.FileMode.Create' : file_mode'
    | ModeOpen => $'System.IO.FileMode.Open' : file_mode'
    | ModeOpenOrCreate => $'System.IO.FileMode.OpenOrCreate' : file_mode'
    | Truncate => $'System.IO.FileMode.Truncate' : file_mode'
    | Append => $'System.IO.FileMode.Append' : file_mode'

/// ### file_access
:! file_access' = $'System.IO.FileAccess'

:| file_access =
    | AccessRead
    | AccessWrite
    | AccessReadWrite

:= file_access = \|
    | AccessRead => $'System.IO.FileAccess.Read' : file_access'
    | AccessWrite => $'System.IO.FileAccess.ReadWrite' : file_access'
    | AccessReadWrite => $'System.IO.FileAccess.ReadWrite' : file_access'

/// ### file_share
:! file_share' = $'System.IO.FileShare'

:| file_share =
    | ShareNone
    | ShareRead
    | ShareWrite
    | ShareReadWrite
    | ShareDelete

:= file_share = \|
    | ShareNone => $'System.IO.FileShare.None' : file_share'
    | ShareRead => $'System.IO.FileShare.Read' : file_share'
    | ShareWrite => $'System.IO.FileShare.Write' : file_share'
    | ShareReadWrite => $'System.IO.FileShare.ReadWrite' : file_share'
    | ShareDelete => $'System.IO.FileShare.Delete' : file_share'

/// ### file_info
:! file_info =
    `(
        backend_switch `(()) `({}) {
            Fsharp = (\ () =>
                global """
                    type System_IO_FileInfo = System.IO.FileInfo

                    """
                        ) : () -> ()
        }
        $'' : $'System_IO_FileInfo'
    )

:= file_info (path : string) : file_info =
    run_target \|
        | Fsharp => \ () => $'!path |> `file_info '
        | _ => \ () => null ()

/// ### directory_info
:! directory_info =
    `(
        backend_switch `(()) `({}) {
            Fsharp = (\ () =>
                global """
                    type System_IO_DirectoryInfo = System.IO.DirectoryInfo

                    """
                        ) : () -> ()
        }
        $'' : $'System_IO_DirectoryInfo'
    )

:= directory_info (path : string) : directory_info =
    run_target \|
        | Fsharp => \ () => $'!path |> `directory_info '
        | _ => \ () => null ()

/// ### directory_info_name
:= directory_info_name (info : directory_info) : string =
    run_target \|
        | Fsharp => \ () => info |> $'_.Name'
        | _ => \ () => null ()

/// ### directory_info_full_name
:= directory_info_full_name (info : directory_info) : string =
    run_target \|
        | Fsharp => \ () => info |> $'_.FullName'
        | _ => \ () => null ()

/// ### file_attributes
:! file_attributes = $'System.IO.FileAttributes'

/// ### directory_info_attributes
:~ directory_info_attributes (info : directory_info) : file_attributes =
    run_target \|
        | Fsharp => \ () => info |> $'_.Attributes'
        | _ => \ () => null ()

/// ### file_attributes_reparse_point
:~ file_attributes_reparse_point () : file_attributes =
    run_target \|
        | Fsharp => \ () => $'`file_attributes.ReparsePoint'
        | _ => \ () => null ()

/// ### file_attributes_has_flag
:~ file_attributes_has_flag (flag : file_attributes) (file_attributes : file_attributes) : bool =
    run_target \|
        | Fsharp => \ () => $'!file_attributes.HasFlag !flag '
        | _ => \ () => null ()

/// ### create_directory
:~ create_directory (path : string) : directory_info =
    run_target \|
        | Fsharp => \ () => path |> $'System.IO.Directory.CreateDirectory'
        | _ => \ () => null ()

/// ### directory_get_files
:~ directory_get_files (path : string) : array_base string =
    run_target \|
        | Fsharp => \ () => path |> $'System.IO.Directory.GetFiles'
        | _ => \ () => null ()

/// ### write_all_text_async
:~ write_all_text_async (path : string) (text : string) : _ () =
    run_target \|
        | Fsharp => \ () => $'System.IO.File.WriteAllTextAsync (!path, !text)' |> async.await_task
        | _ => \ () => null ()

/// ### file_system_info
:! file_system_info = $'System.IO.FileSystemInfo'

/// ### get_source_directory
:= get_source_directory () =
    run_target \|
        | Rust => \ () => $'Rc::<str>::from(env\!("CARGO_MANIFEST_DIR"))' : string
        | _ => \ () => $'__SOURCE_DIRECTORY__' : string

///> fsharp
test get_source_directory =
    get_source_directory ()
    |> directory_info
    |> directory_info_name
    |> _assert_in [ "spiral"; "fsharp" ]

/// ## rust

/// ### display
:! display =
    `(
        rust.rust_type
            `($'std_path_Display')
            `($'std::path::Display')
            "type std_path_Display = string"
    )

/// ### path
:! path =
    `(
        rust.rust_type
            `($'std_path_Path')
            `($'std::path::Path')
            "type std_path_Path = class end"
    )

/// ### path_buf
:! path_buf =
    `(
        rust.rust_type
            `($'std_path_PathBuf')
            `($'std::path::PathBuf')
            "type std_path_PathBuf = string"
    )

/// ### new_path_buf
:= new_path_buf (path : sm'.std_string) : path_buf =
    run_target \|
        | Rust => \ () => !\\(path, $'"std::path::PathBuf::from($0)"')
        | _ => \ () => path |> convert.unbox

/// ### path_buf_join
:= path_buf_join (s : string) (path_buf : path_buf) : path_buf =
    !\\((path_buf, s |> sm'.to_std_string), $'"$0.join($1)"')

/// ### path_buf_display
:= path_buf_display (path_buf : path_buf) : display =
    run_target_args (\ () => path_buf) \|
        | Rust => \ path_buf =>
            := path_buf = ~~ path_buf
            !\($'"!path_buf.display()"')
        | _ => \ path_buf => path_buf |> convert.unbox

/// ### path_buf_file_name
:= path_buf_file_name (path : path_buf) : optionm'.option' (rust.ref sm'.os_str) =
    !\\(path, $'"$0.file_name()"')

/// ### path_buf_exists
:= path_buf_exists (path_buf : path_buf) : bool =
    !\\(path_buf, $'"$0.exists()"')

/// ### path_buf_is_dir
:= path_buf_is_dir (path_buf : path_buf) : bool =
    !\\(path_buf, $'"$0.is_dir()"')

/// ### path_buf_is_file
:= path_buf_is_file (path_buf : path_buf) : bool =
    !\\(path_buf, $'"$0.is_file()"')

/// ### path_buf_parent
:= path_buf_parent (path_buf : path_buf) : optionm'.option' path_buf =
    !\\(path_buf, $'"$0.parent().map(std::path::PathBuf::from)"')

/// ### dir_entry
:! dir_entry =
    `(
        rust.rust_type
            `($'async_walkdir_DirEntry')
            `($'async_walkdir::DirEntry')
            "type async_walkdir_DirEntry = class end"
    )

/// ### walk_dir
:! walk_dir =
    `(
        rust.rust_type
            `($'async_walkdir_WalkDir')
            `($'async_walkdir::WalkDir')
            "type async_walkdir_WalkDir = class end"
    )

/// ### async_walkdir_filtering
:! async_walkdir_filtering =
    `(
        rust.rust_type
            `($'async_walkdir_Filtering')
            `($'async_walkdir::Filtering')
            "type async_walkdir_Filtering = class end"
    )

/// ### filtering
:| filtering =
    | Ignore
    | IgnoreDir
    | Continue

/// ### async_walkdir_error
:! async_walkdir_error =
    `(
        rust.rust_type
            `($'async_walkdir_Error')
            `($'async_walkdir::Error')
            "type async_walkdir_Error = class end"
    )

/// ### new_walk_dir
:= new_walk_dir (dir : string) : walk_dir =
    !\\(dir, $'"async_walkdir::WalkDir::new(&*$0)"')

/// ### walk_dir_filter
:= walk_dir_filter (fn : dir_entry -> async.future_pin_send filtering) (walk_dir : walk_dir) : walk_dir =
    ? is_rust () ?>
        global """
            struct SpiralAssertSend<T>(T);
            unsafe impl<T> Send for SpiralAssertSend<T> {}
            impl<T: std::future::Future + Unpin> std::future::Future for SpiralAssertSend<T> {
                type Output = T::Output;
                fn poll(mut self: std::pin::Pin<&mut Self>, cx: &mut std::task::Context<'_>) -> std::task::Poll<T::Output> { std::pin::Pin::new(&mut self.0).poll(cx) }
            }
            """
        := fn entry =
            := future = fn entry
            async.new_future_move_send \ () =>
                := result = future |> async.await_send
                := filtering : async_walkdir_filtering =
                    ?= result ?|
                    | Ignore => !\($'"async_walkdir::Filtering::Ignore"')
                    | IgnoreDir => !\($'"async_walkdir::Filtering::IgnoreDir"')
                    | Continue => !\($'"async_walkdir::Filtering::Continue"')
                filtering
        !\\((walk_dir, fn), $'"{ let f = SpiralAssertSend($1); async_walkdir::WalkDir::filter($0, move |x| { let f = &f; SpiralAssertSend((f.0)(x)) }) }"')
    |:
        := fn entry = async.new_future_send \ () =>
            := result = fn entry |> async.await_send
            := filtering : async_walkdir_filtering =
                ?= result ?|
                | Ignore => !\($'"async_walkdir::Filtering::Ignore"')
                | IgnoreDir => !\($'"async_walkdir::Filtering::IgnoreDir"')
                | Continue => !\($'"async_walkdir::Filtering::Continue"')
            filtering
        !\\((walk_dir, fn), $'"async_walkdir::WalkDir::filter($0, move |x| $1(x))"')

/// ### file_type
:! file_type =
    `(
        rust.rust_type
            `($'std_fs_FileType')
            `($'std::fs::FileType')
            "type std_fs_FileType = class end"
    )

/// ### dir_entry_file_type
:= dir_entry_file_type (dir_entry : dir_entry) : async.future_pin_send (resultm.result' file_type stream.io_error) =
    := dir_entry = dir_entry |> rust.emit
    !\($'"Box::pin(async_walkdir::DirEntry::file_type(&!dir_entry))"')

/// ### file_type_is_dir
:= file_type_is_dir (file_type : file_type) : bool =
    !\\(file_type, $'"std::fs::FileType::is_dir(&$0)"')

/// ### file
:! file =
    `(
        rust.rust_type
            `($'std_fs_File')
            `($'std::fs::File')
            "type std_fs_File = class end"
    )

/// ### file_open
:= file_open (path : string) : resultm.result' file stream.io_error =
    !\($'"std::fs::File::open(&*!path)"')

/// ### rename
:= rename (to : string) (path : string) : resultm.result' () stream.io_error =
    !\($'"std::fs::rename(&*!path, &*!to)"')

/// ### dir_entry_path
:= dir_entry_path (dir_entry : dir_entry) : path_buf =
    !\\(dir_entry, $'"async_walkdir::DirEntry::path(&$0)"')

/// ### create_dir_all
:= create_dir_all (path : string) : resultm.result' () stream.io_error =
    !\\(path, $'"std::fs::create_dir_all(&*$0)"')

/// ### file_info_link_target
:= file_info_link_target (file_info : file_info) : string =
    run_target \|
        | Fsharp => \ () =>
            file_info |> $'_.LinkTarget'
        | _ => \ () => null ()

/// ### read
:= read (path : string) : resultm.result' (am'.vec u8) stream.io_error =
    !\\(path, $'"std::fs::read(&*$0)"')

/// ## typescript

/// ### ts_path_join
:= ts_path_join (b : string) (a : string) : string =
    global "import * as spiral_node_path from 'node:path';"
    $'spiral_node_path.join(!a, !b)' : string

/// ## file_system

/// ### (< />)
:~ (</>) (a : string) (b : string) : string =
    run_target_args (\ () => a, b) \|
        | Rust => \ a, b =>
            a
            |> sm'.to_std_string
            |> new_path_buf
            |> path_buf_join b
            |> path_buf_display
            |> sm'.format'
            |> sm'.from_std_string
        | TypeScript => \ a, b =>
            a |> ts_path_join b
        | Fsharp => \ a, b =>
            $'System.IO.Path.Combine (!a, !b)'
        | _ => \ a, b =>
            ? a = "" ?> b
            |? (a |> sm'.ends_with "/") || (a |> sm'.ends_with "\\") ?> a ++# b
            |: a ++# "/" ++# b

///> gleam
///> zig
///> lua
test path_join_without_a_native_arm =
    "dir" </> "file" |> _assert_eq "dir/file"
    "dir/" </> "file" |> _assert_eq "dir/file"
    "" </> "file" |> _assert_eq "file"

/// ### get_temp_path
:= without_trailing_separator (path : string) : string =
    ? sm'.length path > 1i32 && (sm'.ends_with "/" path || sm'.ends_with "\\" path)
    ?> sm'.substring 0i32 (sm'.length path - 1i32) path
    |: path

:! gleam_dynamic = $'Dynamic'

:! gleam_atom = $'atom.Atom'

:! gleam_charlist = $'charlist.Charlist'

:= file_system_gleam_env () =
    global "import gleam/dynamic.{type Dynamic}"
    global "import gleam/erlang/charlist"
    global """
        @external(erlang, "os", "getenv")
        fn spiral_fs_os_getenv(name: charlist.Charlist) -> Dynamic

        @external(erlang, "gleam_stdlib", "identity")
        fn spiral_fs_env_coerce(value: a) -> b

        """

:= gleam_env_value (name : string) : gleam_dynamic =
    file_system_gleam_env ()
    := chars : gleam_charlist = $'charlist.from_string(!name)'
    $'spiral_fs_os_getenv(!chars)'

:= gleam_env_unset (value : gleam_dynamic) : bool =
    := unset : gleam_dynamic = $'spiral_fs_env_coerce(False)'
    $'!value == !unset'

:= gleam_env_text (value : gleam_dynamic) : string =
    := chars : gleam_charlist = $'spiral_fs_env_coerce(!value)'
    $'charlist.to_string(!chars)'

:~ ^ gleam_temp_dir_from (names : list string) : string =
    ?= names ?|
    | [] => "/tmp"
    | name :: rest =>
        := value = gleam_env_value name
        ? gleam_env_unset value ?> gleam_temp_dir_from rest
        |:
            := dir = gleam_env_text value
            ? dir = "" ?> gleam_temp_dir_from rest |: dir

:~ get_temp_path () : string =
    run_target \|
        | Rust => \ () =>
            !\($'"std::env::temp_dir()"')
            |> path_buf_display
            |> sm'.format'
            |> sm'.from_std_string
            |> without_trailing_separator
        | Fsharp => \ () =>
            $'System.IO.Path.GetTempPath' () |> without_trailing_separator
        | Gleam => \ () =>
            file_system_gleam_env ()
            gleam_temp_dir_from [ "TMPDIR"; "TEMP"; "TMP" ] |> without_trailing_separator
        | target => \ () => ~~ "file_system.get_temp_path / target: " ++#? target |> failwith

:= file_system_gleam_paths () =
    global "import gleam/dynamic.{type Dynamic}"
    global "import gleam/erlang/atom"
    global "import gleam/string"
    global "import gleam/list"
    global """
        @external(erlang, "filelib", "is_dir")
        fn spiral_fs_is_dir(path: String) -> Bool

        @external(erlang, "file", "delete")
        fn spiral_fs_delete(path: String) -> Dynamic

        @external(erlang, "filename", "basename")
        fn spiral_fs_basename(path: String) -> String

        @external(erlang, "file", "write_file")
        fn spiral_fs_write_file_modes(path: String, data: String, modes: List(atom.Atom)) -> Dynamic

        @external(erlang, "gleam_stdlib", "identity")
        fn spiral_fs_path_coerce(value: a) -> b

        @external(erlang, "filename", "extension")
        fn spiral_fs_extension(path: String) -> String

        @external(erlang, "filename", "absname")
        fn spiral_fs_absname(path: String) -> String
        """



:= gleam_atom_named (name : string) : gleam_atom = $'atom.create(!name)'

:= gleam_atoms_of (a : gleam_atom) : listm'.list' gleam_atom = $'[!a]'

:= gleam_atom_of_dynamic (d : gleam_dynamic) : gleam_atom = $'spiral_fs_path_coerce(!d)'

:= gleam_atoms_equal (a : gleam_atom) (b : gleam_atom) : bool = $'!a == !b'

:= gleam_written (path : string) (text : string) (modes : listm'.list' gleam_atom) : gleam_dynamic =
    $'spiral_fs_write_file_modes(!path, !text, !modes)'

:= gleam_segment_step (acc : list string) (segment : string) : list string =
    ? segment = "" || segment = "." ?> acc
    |? segment = ".." ?>
        ?= acc ?|
        | _ :: up => up
        | [] => []
    |: (segment :: acc)

:= gleam_lexical_full_path (path : string) : string =
    file_system_gleam_paths ()
    := absolute : string = $'spiral_fs_absname(!path)'
    ?= sm'.split_list "/" absolute ?|
    | root :: segments =>
        root ++# "/" ++# (segments |> listm.fold gleam_segment_step [] |> listm.rev |> sm'.concat_list "/")
    | [] => path

:= gleam_dotted_extension (path : string) : string =
    file_system_gleam_paths ()
    := base : string = $'spiral_fs_basename(!path)'
    := rest = ? sm'.starts_with "." base ?> sm'.substring 1i32 (sm'.length base - 1i32) base |: base
    $'spiral_fs_extension(!rest)' : string

:= gleam_append_text (path : string) (text : string) : () =
    file_system_gleam_paths ()
    := written = gleam_written path text (gleam_atoms_of (gleam_atom_named "append")) |> gleam_atom_of_dynamic
    ? gleam_atoms_equal written (gleam_atom_named "ok") |> not
    ?> failwith "file_system.append_all_text: the append failed"

/// ### get_file_name
:~ get_file_name (path : string) : string =
    run_target_args' path \|
        | Fsharp => \ path =>
            path |> $'System.IO.Path.GetFileName'
        | Rust => \ path =>
            path
            |> sm'.to_std_string
            |> new_path_buf
            |> path_buf_file_name
            |> optionm'.map' sm'.from_os_str_ref
            |> optionm'.unbox
            |> optionm'.default_value ""
        | TypeScript => \ path =>
            global "import * as spiral_node_path from 'node:path';"
            $'spiral_node_path.basename(!path)' : string
        | Gleam => \ path =>
            file_system_gleam_paths ()
            $'spiral_fs_basename(!path)' : string
        | target =>
            \ path => ~~ "file_system.get_file_name / target: " ++#? target ++# " / path: " ++# path |> failwith

/// ### get_file_name_without_extension
:~ get_file_name_without_extension (path : string) : string =
    run_target_args' path \|
        | Rust => \ path =>
            := path_buf = path |> sm'.to_std_string |> new_path_buf
            := file_stem = !\\(path_buf, $'"$0.file_stem()"')
            ?= file_stem |> optionm'.map' sm'.from_os_str_ref |> optionm'.unbox ?|
            | Some file_stem => file_stem
            | None => ""
        | _ => \ path =>
            path |> $'System.IO.Path.GetFileNameWithoutExtension'

/// ### get_extension
:~ get_extension (path : string) : string =
    run_target_args' path \|
        | Rust => \ path =>
            := path_buf = path |> sm'.to_std_string |> new_path_buf
            := extension = !\\(path_buf, $'"$0.extension()"')
            ?= extension |> optionm'.map' sm'.from_os_str_ref |> optionm'.unbox ?|
            | Some extension => "." ++# extension
            | None => ""
        | Gleam => \ path =>
            file_system_gleam_paths ()
            gleam_dotted_extension path
        | Fsharp => \ path =>
            $'(let name = System.IO.Path.GetFileName (!path : string) in if name.StartsWith "." && name.IndexOf(\
                ".", 1, System.StringComparison.Ordinal) < 0 then "" else System.IO.Path.GetExtension (!path : string))'
            : string
        | _ => \ path =>
            path |> $'System.IO.Path.GetExtension'

///> rust
///> gleam
test get_extension_keeps_the_dot_and_skips_dotfiles =
    (get_extension "a/b.txt", get_extension "a/b", get_extension "a/.bashrc", get_extension "a.tar.gz")
    |> _assert_eq (".txt", "", "", ".gz")

/// ### directory_separator_char
:~ directory_separator_char () : char =
    run_target \|
        | Rust => \ () => $'(std::path::MAIN_SEPARATOR as u8)' : char
        | TypeScript _ => \ () => '/'
        | Zig => \ () => $'std.fs.path.sep' : char
        | _ => \ () => $'System.IO.Path.DirectorySeparatorChar'

/// ### get_current_directory
:= file_system_gleam_stat () =
    global "import gleam/dynamic.{type Dynamic}"
    global "import gleam/erlang/atom"
    global "import gleam/erlang/charlist"
    global """
        @external(erlang, "file", "get_cwd")
        fn spiral_fs_get_cwd() -> Result(charlist.Charlist, Dynamic)

        @external(erlang, "file", "read_file_info")
        fn spiral_fs_read_file_info(path: String, options: List(#(atom.Atom, atom.Atom))) -> Result(Dynamic, Dynamic)

        @external(erlang, "erlang", "element")
        fn spiral_fs_stat_element(index: Int, tuple: Dynamic) -> Int

        """

:= gleam_cwd () : string =
    file_system_gleam_stat ()
    ?= ($'spiral_fs_get_cwd()' : resultm.result' gleam_charlist gleam_dynamic) |> resultm.unbox ?|
    | Ok chars => $'charlist.to_string(!chars)' : string
    | Error _ => failwith "file_system.get_current_directory: file:get_cwd failed"

:= gleam_mtime_ms (path : string) : u64 =
    file_system_gleam_stat ()
    := time = gleam_atom_named "time"
    := posix = gleam_atom_named "posix"
    := option : gleam_dynamic = $'##(!time, !posix)'
    := options : listm'.list' gleam_dynamic = $'[!option]'
    ?= ($'spiral_fs_read_file_info(!path, !options)' : resultm.result' gleam_dynamic gleam_dynamic) |> resultm.unbox ?|
    | Ok info => ($'spiral_fs_stat_element(6, !info)' : u64) * 1000u64
    | Error _ => 0u64

:~ get_current_directory () : string =
    run_target \|
        | Rust => \ () =>
            := current_dir = !\($'"std::env::current_dir()"') : resultm.result' path_buf stream.io_error
            current_dir
            |> resultm.unwrap'
            |> path_buf_display
            |> sm'.format'
            |> sm'.from_std_string
        | Fsharp => \ () =>
            $'System.IO.Directory.GetCurrentDirectory' ()
        | TypeScript _ => \ () =>
            global "import * as spiral_node_fs from 'node:fs';"
            $'spiral_node_fs.realpathSync(".")' : string
        | Zig => \ () =>
            global "var spiral_io_threaded: std.Io.Threaded = .init_single_threaded;"
            $'(std.process.currentPathAlloc(spiral_io_threaded.io(), spiral_gpa) catch \
                \@panic("file_system.get_current_directory failed"))' : string
        | Gleam => \ () =>
            file_system_gleam_stat ()
            gleam_cwd ()
        | Delphi => \ () => $'GetCurrentDir()' : string
        | _ => \ () => null ()

test get_current_directory =
    get_current_directory ()
    |> _assert_contains (directory_separator_char ())

/// ### directory_exists
:~ directory_exists (path : string) : bool =
    run_target_args' path \|
        | Zig => \ _ =>
            global "var spiral_io_threaded: std.Io.Threaded = .init_single_threaded;"
            $'(if (std.Io.Dir.cwd().statFile(spiral_io_threaded.io(), !path, .{})) |s| s.kind == .directory else |_| \
                false)' : bool
        | Fsharp => \ path =>
            path |> $'System.IO.Directory.Exists'
        | Rust => \ path =>
            := path = path |> sm'.to_std_string |> new_path_buf
            path_buf_exists path && path_buf_is_dir path
        | TypeScript => \ path =>
            global "import * as spiral_node_fs from 'node:fs';"
            $'(spiral_node_fs.existsSync(!path) && spiral_node_fs.statSync(!path).isDirectory())' : bool
        | Gleam => \ path =>
            file_system_gleam_paths ()
            $'spiral_fs_is_dir(!path)' : bool
        | Delphi => \ path => $'DirectoryExists(!path)' : bool
        | _ => \ _ => null ()

/// ### directory_get_parent
:~ directory_get_parent (path : string) : optionm'.option' string =
    run_target_args' path \|
        | Fsharp => \ path =>
            := parent : directory_info = path |> $'System.IO.Directory.GetParent'
            ? parent =. null ()
            ?> None
            |: parent |> directory_info_full_name |> Some
            |> optionm'.box
        | Rust => \ path =>
            := path_buf = path |> sm'.to_std_string |> new_path_buf
            := parent = path_buf |> path_buf_parent
            parent
            |> optionm'.map' (path_buf_display >> sm'.format' >> sm'.from_std_string)
        | TypeScript _ => \ path =>
            global "import * as spiral_node_path from 'node:path';"
            := parent = $'spiral_node_path.dirname(!path)' : string
            ? parent = path
            ?> None
            |: parent |> Some
            |> optionm'.box
        | _ => \ _ => optionm'.none' ()

:= directory_parent (path : string) : option string =
    run_target_args' path \|
        | Delphi => \ path =>
            := parent = $'ExtractFileDir(ExcludeTrailingPathDelimiter(!path))' : string
            ? parent = path || parent = "" ?> None |: Some parent
        | _ => \ path => path |> directory_get_parent |> optionm'.unbox

/// ### create_temp_path'
:~ create_temp_path' (guid : guid.guid) =
    run_target_args' guid \|
        | _ => \ guid =>
            get_temp_path ()
            </> ~~ "!create_temp_path_"
            </> (env.get_entry_assembly_name ())
            </> (guid |> sm'.obj_to_string)

///> fsharp
///> rust -d chrono
test create_temp_path =
    guid.hash_guid ""
    |> create_temp_path'
    |> _assert_contains (directory_separator_char ())

/// ### create_temp_path
:~ create_temp_path () =
    run_target \|
        | _ => \ () =>
            date_time.now ()
            |> date_time.new_guid_from_date_time
            |> create_temp_path'

/// ### file_copy
:~ file_copy (new_path : string) (old_path : string) : () =
    run_target_args' (old_path, new_path) \|
        | Fsharp => \ old_path, new_path =>
            $'System.IO.File.Copy (!old_path, !new_path, true)'
        | Rust => \ old_path, new_path =>
            := result : _ _ stream.io_error = !\\((old_path, new_path), $'"std::fs::copy(&*$0, &*$1)"')
            ?= result |> resultm.map_error' sm'.format' |> resultm.unbox ?|
            | Ok (result : u64) =>
                trace Debug
                    \ () => "file_system.file_copy"
                    \ () => { old_path new_path result }
            | Error error =>
                trace Warning
                    \ () => "file_system.file_copy"
                    \ () => { old_path new_path error }
        | _ => \ _ => ()

:= file_system_gleam_files () =
    global "import gleam/bit_array"
    global "import gleam/dynamic.{type Dynamic}"
    global "import gleam/erlang/atom"
    global """
        @external(erlang, "file", "read_file")
        fn spiral_fs_read_file(path: String) -> Result(BitArray, Dynamic)

        @external(erlang, "file", "write_file")
        fn spiral_fs_write_file(path: String, data: String) -> Dynamic

        @external(erlang, "filelib", "is_regular")
        fn spiral_fs_is_regular(path: String) -> Bool

        @external(erlang, "gleam_stdlib", "identity")
        fn spiral_fs_coerce(value: a) -> b

        """

:! gleam_bytes = $'BitArray'

:= gleam_read_text (path : string) : string =
    file_system_gleam_files ()
    ?= ($'spiral_fs_read_file(!path)' : resultm.result' gleam_bytes gleam_dynamic) |> resultm.unbox ?|
    | Ok bytes =>
        ?= ($'bit_array.to_string(!bytes)' : resultm.result' string ()) |> resultm.unbox ?|
        | Ok text => text
        | Error _ => failwith "file_system.read_all_text: the file is not UTF-8"
    | Error _ => failwith "file_system.read_all_text: file:read_file failed"

:= gleam_write_text (path : string) (text : string) : () =
    file_system_gleam_files ()
    := raw : gleam_dynamic = $'spiral_fs_write_file(!path, !text)'
    := written : gleam_atom = $'spiral_fs_coerce(!raw)'
    ? gleam_atoms_equal written (gleam_atom_named "ok") |> not
    ?> failwith "file_system.write_all_text: the write failed"

/// ### lua_file
:! lua_file = $'any'

:= lua_file_open (path : string) (mode : string) : lua_file = $'io.open(!path, !mode)' : lua_file

:= lua_file_present (file : lua_file) : bool = $'(!file) ~= nil' : bool

:= lua_file_write (file : lua_file) (text : string) : () = $'(!file):write(!text)' : ()

:= lua_file_read_all (file : lua_file) : string = $'(!file):read("*a")' : string

:= lua_file_close (file : lua_file) : () = $'(!file):close()' : ()

:= lua_file_remove (path : string) : () = $'os.remove(!path)' : ()

/// ### file_exists
:~ file_exists (path : string) : bool =
    run_target_args' path \|
        | Zig => \ _ =>
            global "var spiral_io_threaded: std.Io.Threaded = .init_single_threaded;"
            $'(if (std.Io.Dir.cwd().statFile(spiral_io_threaded.io(), !path, .{})) |s| s.kind == .file else |_| false)' : bool
        | Fsharp => \ path =>
            path |> $'System.IO.File.Exists'
        | Rust => \ path =>
            := path_buf = path |> sm'.to_std_string |> new_path_buf
            path_buf_exists path_buf && path_buf_is_file path_buf
        | Gleam => \ path =>
            file_system_gleam_files ()
            $'spiral_fs_is_regular(!path)' : bool
        | TypeScript => \ path =>
            global "import * as spiral_node_fs from 'node:fs';"
            $'(spiral_node_fs.existsSync(!path) && spiral_node_fs.statSync(!path).isFile())' : bool
        | Gleam _ => \ path =>
            global """
                @external(erlang, "filelib", "is_regular")
                fn spiral_filelib_is_regular(path: String) -> Bool
                """
            $'spiral_filelib_is_regular(!path)' : bool
        | Lua => \ path =>
            := file = lua_file_open path "r"
            ? lua_file_present file ?>
                lua_file_close file
                !+
            |: !-
        | Delphi => \ path => $'FileExists(!path)' : bool
        | _ => \ _ => null ()

/// ### write_all_text
:= write_all_text (path : string) (text : string) : () =
    run_target_args' (path, text) \|
        | Zig => \ _ =>
            global "var spiral_io_threaded: std.Io.Threaded = .init_single_threaded;"
            $'std.Io.Dir.cwd().writeFile(spiral_io_threaded.io(), .{ .sub_path = !path, .data = !text }) catch \
                \@panic("file_system.write_all_text failed")' : ()
        | Fsharp => \ path, text =>
            $'System.IO.File.WriteAllText (!path, !text)'
        | Rust => \ path, text =>
            !\\((path, text), $'"std::fs::write(&*$0, &*$1).unwrap()"')
        | Gleam => \ path, text =>
            file_system_gleam_files ()
            gleam_write_text path text
        | Lua => \ path, text =>
            := file = lua_file_open path "w"
            lua_file_write file text
            lua_file_close file
        | Delphi => \ path, text =>
            := handle = $'FileCreate(!path)' : i64
            ? handle = -1i64 ?> failwith "file_system.write_all_text / cannot create the file"
            := length = sm'.length text
            ? length > 0i32 ?>
                := first = 1i32
                := written = $'FileWrite(!handle, (!text)[!first], !length)' : i32
                ? written <> length ?> failwith "file_system.write_all_text / short write"
            $'FileClose(!handle)' : ()
        | _ => \ _ => ()

/// ### read_all_bytes
:= read_all_bytes (path : string) : am'.vec u8 =
    run_target \|
        | Fsharp => \ () =>
            $'!path |> System.IO.File.ReadAllBytes'
            |> am'.to_vec
        | Rust => \ () =>
            path |> read |> resultm.unwrap'
        | _ => \ () => null ()

/// ### read_all_text
:= read_all_text (path : string) : string =
    run_target \|
        | Zig => \ () =>
            global "var spiral_io_threaded: std.Io.Threaded = .init_single_threaded;"
            $'(std.Io.Dir.cwd().readFileAlloc(spiral_io_threaded.io(), !path, spiral_gpa, .unlimited) catch \
                \@panic("file_system.read_all_text failed"))' : string
        | Fsharp => \ () =>
            $'!path |> System.IO.File.ReadAllText'
        | Gleam => \ () =>
            file_system_gleam_files ()
            gleam_read_text path
        | Rust => \ () =>
            path
            |> read_all_bytes
            |> sm'.string_from_utf8
            |> resultm.unwrap'
            |> sm'.from_std_string
        | Lua => \ () =>
            := file = lua_file_open path "r"
            := text = lua_file_read_all file
            lua_file_close file
            text
        | Delphi => \ () =>
            := handle = $'FileOpen(!path, fmOpenRead)' : i64
            ? handle = -1i64 ?> failwith "file_system.read_all_text / cannot open the file"
            := size = $'FileSeek(!handle, 0, 2)' : i32
            := start = $'FileSeek(!handle, 0, 0)' : i32
            ? start <> 0i32 ?> failwith "file_system.read_all_text / cannot rewind the file"
            := text = $'StringOfChar(Chr(0), !size)' : string
            ? size > 0i32 ?>
                := first = 1i32
                := read = $'FileRead(!handle, (!text)[!first], !size)' : i32
                ? read <> size ?> failwith "file_system.read_all_text / short read"
            $'FileClose(!handle)' : ()
            text
        | _ => \ () => null ()

///> delphi
test delphi_read_all_text_reads_back_what_was_written =
    := path = "spiral-delphi-read-probe.txt"
    write_all_text path "ab"
    path |> read_all_text |> _assert_eq "ab"
    write_all_text path ""
    path |> read_all_text |> _assert_eq ""

/// ### read_text_or_empty
:= read_text_or_empty (path : string) : string =
    run_target \|
        | Rust => \ () =>
            $'std::rc::Rc::<str>::from(std::fs::read_to_string(&*!path).unwrap_or_default().as_str())' : string
        | Fsharp => \ () =>
            $'(try System.IO.File.ReadAllText(!path : string) with _ -> "")' : string
        | _ => \ () => failwith "file_system.read_text_or_empty: no arm for this backend"

///> fsharp
///> rust
test read_text_or_empty_reads_a_file_or_gives_empty =
    := path = get_temp_path () </> "spiral-read-text-or-empty.txt"
    write_all_text path "kept"
    path |> read_text_or_empty |> _assert_eq "kept"
    (path ++# ".missing") |> read_text_or_empty |> _assert_eq ""

/// ### directory_create_symbolic_link
:= directory_create_symbolic_link (target : string) (path : string) : () =
    run_target \|
        | Fsharp => \ () =>
            ($'System.IO.Directory.CreateSymbolicLink (!path, !target)' : file_system_info)
            |> ignore
        | Rust => \ () =>
            global """
                #[cfg(windows)]
                fn spiral_fs_symlink_dir(target: &str, path: &str) -> std::io::Result<()> {
                    std::os::windows::fs::symlink_dir(target, path)
                }
                #[cfg(unix)]
                fn spiral_fs_symlink_dir(target: &str, path: &str) -> std::io::Result<()> {
                    std::os::unix::fs::symlink(target, path)
                }
                #[cfg(not(any(windows, unix)))]
                fn spiral_fs_symlink_dir(_target: &str, _path: &str) -> std::io::Result<()> {
                    Err(std::io::ErrorKind::Unsupported.into())
                }
                """
            := linked : resultm.result' () stream.io_error = $'spiral_fs_symlink_dir(&*!target, &*!path)'
            ?= linked |> resultm.map_error' sm'.format |> resultm.unbox ?|
            | Ok () => ()
            | Error why => failwith ("directory_create_symbolic_link / " ++# path ++# ": " ++# why)
        | _ => \ () => ()

/// ### file_create_symbolic_link
:= file_create_symbolic_link (target : string) (path : string) : () =
    run_target \|
        | Fsharp => \ () =>
            ($'System.IO.File.CreateSymbolicLink (!path, !target)' : file_system_info)
            |> ignore
        | Rust => \ () =>
            global """
                #[cfg(windows)]
                fn spiral_fs_symlink_file(target: &str, path: &str) -> std::io::Result<()> {
                    std::os::windows::fs::symlink_file(target, path)
                }
                #[cfg(unix)]
                fn spiral_fs_symlink_file(target: &str, path: &str) -> std::io::Result<()> {
                    std::os::unix::fs::symlink(target, path)
                }
                #[cfg(not(any(windows, unix)))]
                fn spiral_fs_symlink_file(_target: &str, _path: &str) -> std::io::Result<()> {
                    Err(std::io::ErrorKind::Unsupported.into())
                }
                """
            := linked : resultm.result' () stream.io_error = $'spiral_fs_symlink_file(&*!target, &*!path)'
            ?= linked |> resultm.map_error' sm'.format |> resultm.unbox ?|
            | Ok () => ()
            | Error why => failwith ("file_create_symbolic_link / " ++# path ++# ": " ++# why)
        | _ => \ () => ()

:= mklink_status (native_path : string) (native_target : string) : i32 =
    global """
        fn spiral_fs_mklink_junction(path: &str, target: &str) -> i32 {
            let output = std::process::Command::new("cmd").args(["/d", "/c", "mklink", "/J", path, target]).output();
            output.map(|o| o.status.code().unwrap_or(-2)).unwrap_or(-1)
        }
        """
    $'spiral_fs_mklink_junction(&*!native_path, &*!native_target)' : i32

/// ### directory_create_junction
:= directory_create_junction (target : string) (path : string) : result () string =
    ? path |> directory_exists ?> Error ("directory_create_junction / path exists: " ++# path)
    |:
        run_target \|
            | Rust => \ () =>
                ? platform.is_windows () ?>
                    := native_path = path |> sm'.replace "/" "\\"
                    := native_target = target |> sm'.replace "/" "\\"
                    := exit_code = mklink_status native_path native_target
                    := failure = "directory_create_junction / mklink /J exit " ++# sm'.format exit_code
                    ? exit_code = 0i32 ?> Ok () |: Error failure
                |:
                    path |> directory_create_symbolic_link target
                    Ok ()
            | _ => \ () =>
                path |> directory_create_symbolic_link target
                Ok ()

/// ### file_is_read_only
:= file_is_read_only (path : string) : bool =
    run_target \|
        | Rust => \ () => $'std::fs::metadata(&*!path).map(|m| m.permissions().readonly()).unwrap_or(false)' : bool
        | _ => \ () => !-

:! fs_permissions = $'std::fs::Permissions'

:= rust_permissions (path : string) : optionm'.option' fs_permissions =
    $'std::fs::metadata(&*!path).ok().map(|m| m.permissions())' : optionm'.option' fs_permissions

:= rust_permissions_set (path : string) (read_only : bool) (mode : fs_permissions) : bool =
    := mode = mode
    mode |> rust.to_mut
    $'!mode.set_readonly(!read_only)' : ()
    $'std::fs::set_permissions(&*!path, !mode).is_ok()' : bool

/// ### file_set_read_only
:= file_set_read_only (read_only : bool) (path : string) : bool =
    run_target \|
        | Rust => \ () =>
            ?= rust_permissions path |> optionm'.unbox ?|
            | Some permissions => rust_permissions_set path read_only permissions
            | None => !-
        | _ => \ () => !-

/// ### entry_kind
:| entry_kind =
    | File
    | Directory

/// ### find_parent
:~ find_parent file_type name root_dir =
    := is_file = file_type = File
    := exists_fn = ? is_file ?> file_exists |: directory_exists
    :~ ^ 루프 dir =
        ? dir </> name |> exists_fn
        ?> dir |> Ok
        |:
            ?= dir |> directory_parent ?|
            | Some parent => parent |> 루프
            | None =>
                "file_system.find_parent / No parent for " ++# (? is_file ?> "file" |: "dir")
                ++# " '" ++# name ++# "' at '" ++# root_dir ++# "' (until '" ++# dir ++# "')"
                |> Error
    root_dir |> 루프

///> fsharp
test find_parent =
    ;[ Directory, "workspace"; File, "README.md" ]
    |> arraym.map \ file_type, file =>
        get_source_directory ()
        |> find_parent file_type file
        |> resultm.get
        |> directory_info
        |> directory_info_name
    |> am'.distinct
    |> _assert_in [ ;[ "spiral" ]; ;[ "polyglot" ] ]

///> rust
test find_parent_2 =
    ;[ Directory, "workspace"; File, "README.md" ]
    |> arraym.map \ file_type, file =>
        \ () =>
            ~~
                get_current_directory ()
                |> find_parent file_type file
                |> resultm.get
                |> sm'.to_std_string
                |> new_path_buf
                |> path_buf_file_name
                |> optionm'.try'
                |> sm'.from_os_str_ref
                |> Some
                |> optionm'.box
        |> \ x => x () |> optionm'.unbox
        |> optionm'.default_value ""
    |> am'.distinct
    |> \ result =>
        result |> am'.length |> _assert_eq 1i32
        index result 0i32 |> _assert_eq "spiral"

/// ### file_delete
:= file_delete (path : string) : () =
    run_target \|
        | Zig => \ () =>
            global "var spiral_io_threaded: std.Io.Threaded = .init_single_threaded;"
            $'std.Io.Dir.cwd().deleteFile(spiral_io_threaded.io(), !path) catch {}' : ()
        | Fsharp => \ () =>
            path |> $'System.IO.File.Delete'
        | Rust => \ () =>
            := result : resultm.result' () stream.io_error =
                ? path |> file_exists
                ?> !\\(path, $'"std::fs::remove_file(&*$0)"')
                |: Ok () |> resultm.box
            ?= result |> resultm.map_error' sm'.format |> resultm.unbox ?|
            | Ok () => ()
            | Error error' => console.write_error_line (sm'.(++#) "file_system.file_delete: " error')
        | Gleam => \ () =>
            file_system_gleam_paths ()
            $'spiral_fs_delete(!path)' : ()
        | Lua => \ () => lua_file_remove path
        | _ => \ () => ()

///> gleam
test file_exists_on_gleam_tells_files_from_missing_paths =
    := ~path = "spiral-file-exists-probe.txt"
    write_all_text path "x"
    := written = file_exists path
    file_delete path
    (written, file_exists path, file_exists "spiral-no-such-file.txt") |> _assert_eq (!+, !-, !-)

/// ### read_link
:~ read_link (path : string) : resultm.result' path_buf stream.io_error =
    :~ run 루프 n error path' =
        := name = path' |> get_file_name
        := parent = path' |> directory_get_parent |> optionm'.unbox
        := error'' = #?error
        ?= parent ?|
        | _ ?& n >= 11 =>
            ($'$"file_system.read_link / "' : string)
            ++# $'$"path: {!path} / n: {!n} / path\': {!path'} / name: {!name}"'
            |> stream.new_io_error
            |> resultm.err
        | Some parent ?& path' <>. "" =>
            ?= 루프 (n + 1) parent |> resultm.map_error' sm'.format |> resultm.unbox ?|
            | Ok parent' =>
                (parent' |> path_buf_display |> convert.convert) </> name
                |> sm'.to_std_string
                |> new_path_buf
                |> resultm.ok''
            | Error error' =>
                ($'$"file_system.read_link / "' : string)
                ++# $'$"error\': {!error'} / error: {!error''} / name: {!name}"'
                |> stream.new_io_error
                |> resultm.err
        | _ =>
            ($'$"file_system.read_link / run / The file or directory is not a reparse point. / "' : string)
            ++# $'$"path: {!path} / error: {!error''} / path\': {!path'} / name: {!name}"'
            |> stream.new_io_error
            |> resultm.err

    run_target \|
        | Rust => \ () =>
            ? path |> directory_exists
            ?> !\\(path, $'"std::fs::read_link(&*$0)"')
            |:
                :~ ^ 루프 \* t {number}.
                    (n : t)
                    (path' : string)
                    : resultm.result' path_buf stream.io_error
                    =
                    run_target \|
                        | Rust => \ () =>
                            := result : _ _ stream.io_error = !\\(path', $'"std::fs::read_link(&*$0)"')
                            := result = result |> resultm.map_error' sm'.format |> resultm.unbox
                            ?= result ?|
                            | Ok x => x |> resultm.ok''
                            | Error error => path' |> run 루프 n error
                        | _ => \ () => null ()
                path |> 루프 0u8
        | Fsharp _
        | TypeScript _ => \ () =>
            :~ ^ 루프 \* t {number}.
                (n : t)
                (path' : string)
                : resultm.result' path_buf stream.io_error
                =
                := result =
                    path'
                    |> directory_info
                    |> directory_info_attributes
                    |> file_attributes_has_flag (file_attributes_reparse_point ())
                ? result ?>
                    path'
                    |> file_info
                    |> file_info_link_target
                    |> convert.unbox
                    |> resultm.ok''
                |:
                    := error =
                        ($'$"file_system.read_link / Fsharp / "' : string)
                        ++# $'$"The file or directory is not a reparse point. / "'
                        ++# $'$"path: {!path} / result: {!result} / path\': {!path'} / n: {!n}"'
                        |> stream.new_io_error
                    path' |> run 루프 n error
            path |> 루프 0u8
        | _ => \ () => $'Unchecked.defaultof<_>'

/// ### normalize_path
:~ normalize_path (path : string) : string =
    ? path = ""
    ?> ""
    |:
        := result =
            ?= path |> read_link |> resultm.ok' |> optionm'.unbox ?|
            | Some path_buf =>
                path_buf
                |> path_buf_display
                |> convert.convert
            | None => path
        := result =
            ? result = ""
            ?> path
            |: result
        := result' =
            ? result |> sm'.starts_with "\\\\?\\"
            ?> result |> sm'.substring 4i32 ((sm'.length result : i32) - 4i32)
            |: result
        ? ##result' < 2
        ?> path
        |:
            sm'.(++#)
                (result' |> sm'.slice 0i32 0i32 |> sm'.to_lower)
                (result' |> sm'.slice 1i32 ((sm'.length result' : i32) - 1i32))
            |> sm'.replace "\\" "/"

///> rust
test normalize_path_drops_the_verbatim_prefix =
    := ~path = "\\\\?\\C:\\x"
    path |> normalize_path |> _assert_eq "c:/x"

/// ### get_workspace_root
:= get_workspace_root () =
    := repo_root = env.get_environment_variable "SPIRAL_REPO_ROOT"
    ? repo_root <> ""
    ?> repo_root |> normalize_path
    |:
        := dirs =
            [ get_current_directory; get_source_directory; \ () => "/workspaces" ]
        :~ run dir =
            dir
            |> find_parent Directory ("spiral" </> "workspace")
            |> \|
                | Ok dir => dir |> normalize_path |> Some
                | Error error =>
                    trace Warning
                        \ () => "file_system.get_workspace_root"
                        \ () => { dir error }
                    None
        := root =
            (None, dirs)
            ||> listm.fold \ acc dir =>
                ?= acc ?|
                | Some dir => Some dir
                | None => dir () |> run
            |> optionm.value
        := root =
            ?= root |> get_file_name ?|
            | "deps" =>
                root
                |> directory_get_parent
                |> optionm'.get'
                |> run
                |> optionm.value
            | _ => root
        root </> "spiral"

/// ### get_workspace_root_external
:= get_workspace_root_external () =
    := workspace_root = get_workspace_root ()
    := current_dir = get_current_directory () |> sm'.to_lower
    := workspace_root = workspace_root |> sm'.to_lower
    ? current_dir |> sm'.starts_with workspace_root
    ?> Error workspace_root
    |: Ok workspace_root

///> rust -d regex
test get_workspace_root_external =
    ?= get_workspace_root_external () ?|
    | Ok root => root
    | Error root => root
    |> get_file_name
    |> _assert_eq "spiral"

/// ### get_full_path
:~ get_full_path (path : string) : string =
    run_target_args (\ () => path) \|
        | Fsharp => \ path =>
            path |> $'System.IO.Path.GetFullPath'
        | Rust => \ path =>
            := current_dir = get_current_directory ()
            current_dir </> path
            |> normalize_path
            |> sm'.split "/"
            |> \ x =>
                ((array x : array _), (0i32, (;[] : array _)))
                ||> arraym.foldBack \ x level, acc =>
                    ?= x, level ?|
                    | "..", _ => level + 1, acc
                    | ".", _ => level, acc
                    | _, 0 ?& x |> sm'.ends_with ":" =>
                        := drive = current_dir |> sm'.slice 0i32 0i32
                        := letter = x |> sm'.slice 0i32 0i32
                        0, ;[ sm'.(++#) (? sm'.to_lower letter = sm'.to_lower drive ?> drive |: sm'.to_upper letter) ":" ] ++ acc
                    | _, 0 => 0, ;[ x ] ++ acc
                    | _ => level - 1, acc
            |> snd
            |> seq.of_array'
            |> sm'.concat (directory_separator_char () |> sm'.obj_to_string)
        | Gleam => \ path =>
            file_system_gleam_paths ()
            gleam_lexical_full_path path
        | _ => \ _ => null ()

///> fsharp
test get_full_path =
    "."
    |> get_full_path
    |> directory_info
    |> directory_info_name
    |> _assert_in [ "spiral"; "fsharp" ]

///> rust -d regex
test get_full_path_2 =
    "dir/.././._file"
    |> get_full_path
    |> _assert_eq (get_current_directory () </> "._file")

///> rust -d regex
test get_full_path_keeps_the_drive_of_an_absolute_path =
    ? platform.is_windows () ?>
        := drive = ? get_current_directory () |> sm'.starts_with "Z" ?> "Y" |: "Z"
        sm'.(++#) drive ":/spiral_drive_probe/x"
        |> get_full_path
        |> _assert_eq (sm'.(++#) drive ":\\spiral_drive_probe\\x")

///> rust -d regex
test get_full_path_3 =
    := directory_name path =
        path
        |> sm'.to_std_string
        |> new_path_buf
        |> path_buf_file_name
        |> optionm'.unwrap
        |> sm'.from_os_str_ref
    "."
    |> get_full_path
    |> directory_name
    |> _assert_eq (get_current_directory () |> directory_name)

///> rust -d regex
test get_full_path_4 =
    "dir/.././._file"
    |> get_full_path
    |> normalize_path
    |> _assert_eq (get_current_directory () </> "._file" |> normalize_path)

/// ### standardize_path
:~ standardize_path path =
    path |> get_full_path |> normalize_path

/// ### absolute_path
:~ absolute_path path =
    := current_dir = get_current_directory ()
    current_dir </> path |> standardize_path

/// ### new_file_uri
:= new_file_uri (path : string) : string =
    := path = path |> sm'.trim_start [ '/' ]
    "file:///" ++# path

///> rust -d regex
test new_file_uri =
    @"\\?\C:\test"
    |> normalize_path
    |> new_file_uri
    |> _assert_eq "file:///c:/test"

///> rust -d regex
test new_file_uri_2 =
    @"\\?\C:\test"
    |> normalize_path
    |> new_file_uri
    |> _assert_eq "file:///c:/test"

/// ## fsharp

/// ### trace_file
:~ ^ trace_file text : () =
    run_target \|
    | Fsharp => \ () =>
        resultm.from_try
            \ () =>
                := assembly_name = env.get_entry_assembly_name ()
                := guid = date_time.now () |> date_time.new_guid_from_date_time
                := file_name = assembly_name ++# "_" ++# sm'.obj_to_string guid ++# ".txt"

                := workspace_root = get_workspace_root ()
                := trace_dir = workspace_root </> "target/trace"
                trace_dir |> create_directory |> ignore
                := path = trace_dir </> file_name
                text |> write_all_text_async path |> async.run_synchronously
            \ ex =>
                := ex = ex ()
                := text = $'$"file_system.trace_file / ex: %A{!ex}"'
                text |> console.write_line
                text |> trace_file
                ex
        |> resultm.get
    | _ => \ () => ()

///> fsharp
test trace_file =
    := get_count dir : i64 =
        := files = dir |> directory_get_files
        array files |> am'.length |> conv

    := trace_dir = get_workspace_root () </> "target/trace"
    trace_dir |> create_directory |> ignore

    := count = get_count trace_dir

    trace_file "test"

    get_count trace_dir
    |> _assert_eq (count + 1)

/// ## file_system

/// ### delete_comparable_path
:~ delete_comparable_path (path : string) : string =
    path |> get_full_path |> sm'.replace "\\" "/" |> sm'.trim_end ['/'] |> sm'.to_lower

/// ### delete_target_contains
:= delete_target_contains (target : string) (root : string) : bool =
    root <> "" && (target = root || sm'.starts_with (target ++# "/") root)

/// ### delete_shape_protected
:~ delete_shape_protected (target : string) : bool =
    := parts = sm'.split "/" target |> array
    := count = am'.length parts
    := part (at : i32) : string = ? at < count ?> am'.index at parts |: ""
    := rooted_home = part 0i32 = "" && (count = 2i32 || (count = 3i32 && part 1i32 = "home"))
    := app_data = part 3i32 = "appdata" && (count <= 5i32 || (count = 6i32 && part 4i32 = "local" && part 5i32 = "temp"))
    := users = part 1i32 = "users" && (count <= 3i32 || app_data)
    count <= 1i32 || rooted_home || users || (count = 2i32 && part 1i32 = "windows")

/// ### delete_variable_protected
:~ ^ delete_variable_protected (target : string) (names : list string) : bool =
    ?= names ?|
    | [] => !-
    | name :: rest =>
        := value = env.get_environment_variable name
        ? value <> "" && delete_target_contains target (delete_comparable_path value) ?> !+
        |: delete_variable_protected target rest

/// ### delete_target_is_protected
:= delete_target_is_protected (path : string) : bool =
    := variables = ["USERPROFILE"; "HOME"; "TEMP"; "TMP"; "TMPDIR"; "LOCALAPPDATA"; "APPDATA"; "SystemRoot"; "ProgramData"]
    := target = delete_comparable_path path
    path = "" || delete_shape_protected target || delete_variable_protected target variables

///> rust
test delete_target_is_protected_refuses_kits_cases_on_windows =
    ? platform.is_windows ()
    ?>
        (
            delete_target_is_protected "C:\\",
            delete_target_is_protected "C:\\Users",
            delete_target_is_protected "C:\\Users\\me",
            delete_target_is_protected "c:/users/someone",
            delete_target_is_protected "C:\\Users\\me\\AppData",
            delete_target_is_protected "C:\\Users\\me\\AppData\\Local\\Temp",
            delete_target_is_protected "C:\\Windows",
            delete_target_is_protected "",
            delete_target_is_protected "C:\\home\\git\\kit\\.cache\\x",
            delete_target_is_protected (get_temp_path () </> "kit-run-42")
        )
        |> _assert_eq (!+, !+, !+, !+, !+, !+, !+, !+, !-, !-)

///> rust
test delete_target_is_protected_covers_roots_profiles_and_temp =
    := home =
        ? platform.is_windows ()
        ?> env.get_environment_variable "USERPROFILE"
        |: env.get_environment_variable "HOME"
    := scratch = get_temp_path () </> "spiral-delete-guard-probe"
    (
        delete_target_is_protected home,
        delete_target_is_protected (home </> ".."),
        delete_target_is_protected (get_temp_path ()),
        delete_target_is_protected (home </> "AppData" </> ".." </> ".."),
        delete_target_is_protected scratch
    )
    |> _assert_eq (!+, !+, !+, !+, !-)

/// ### directory_delete
:~ directory_delete recursive (path : string) : () =
    run_target_args' (path, recursive) \|
        | Fsharp => \ path, recursive =>
            ? recursive && delete_target_is_protected path
            ?> "file_system.directory_delete: refusing a drive root, profile, temp root or system folder: " ++# path |> failwith
            $'System.IO.Directory.Delete (!path, !recursive)'
        | Rust => \ path, recursive =>
            ? recursive && delete_target_is_protected path
            ?> "file_system.directory_delete: refusing a drive root, profile, temp root or system folder: " ++# path |> failwith
            ? path |> directory_exists ?>
                ? recursive
                ?> !\\(path, $'"std::fs::remove_dir_all(&*$0).unwrap()"')
                |: !\\(path, $'"std::fs::remove_dir(&*$0).unwrap()"')
        | _ => \ _ => ()

///> rust
test directory_delete_removes_a_scratch_tree =
    := scratch = get_temp_path () </> "spiral-delete-guard-scratch"
    create_dir_all (scratch </> "inner") |> ignore
    directory_delete !+ scratch
    scratch |> directory_exists
    |> _assert_eq !-

///> rust
test directory_delete_refuses_a_protected_surrogate_root =
    := surrogate = get_temp_path () </> "spiral-delete-guard-surrogate"
    create_dir_all (surrogate </> "inner") |> ignore
    := before = env.environment_snapshot ()
    env.environment_restored (before ++# sm'.char_text 0u8 ++# "LOCALAPPDATA=" ++# surrogate) "SPIRAL_KEPT_"
    := refused =
        catch_unwind_rust
            (\ () =>
                directory_delete !+ surrogate
                !-
            )
            (\ _ => !+)
    env.environment_restored before "SPIRAL_KEPT_"
    := kept = surrogate |> directory_exists
    directory_delete !+ surrogate
    (refused, kept)
    |> _assert_eq (!+, !+)

/// ### create_dir
:~ create_dir dir =
    run_target_args' dir \|
        | Rust => \ dir =>
            ?= dir |> create_dir_all |> resultm.map_error' sm'.format' |> resultm.unbox ?|
            | Ok () =>
                trace Verbose
                    \ () => "file_system.create_dir"
                    \ () => { dir }
            | Error error =>
                trace Critical
                    \ () => "file_system.create_dir"
                    \ () => { dir error }
            := disposable : _ () = new_disposable \ () =>
                dir
                |> directory_delete !+
            disposable
        | _ => \ _ => null ()

/// ### create_temp_dir
:= create_temp_dir () =
    := dir = create_temp_path ()
    dir, dir |> create_dir

///> rust -d chrono
test create_temp_dir =
    := path, disposable = create_temp_dir ()
    ~~
        path
        |> directory_exists
        |> _assert_eq !+
        disposable |> use |> ignore
        path
        |> directory_exists
        |> _assert_eq !+
    path
    |> directory_exists
    |> _assert_eq !-

/// ### create_temp_dir'
:= create_temp_dir' (hash : string) =
    := dir = hash |> guid.hash_guid |> create_temp_path'
    dir, dir |> create_dir

/// ### link_directory
:~ link_directory target_path path =
    ? target_path |> directory_exists |> not
    ?> target_path |> create_dir |> ignore

    := lib_dir_path = path |> directory_get_parent |> optionm'.default_value' ""
    ? lib_dir_path |> directory_exists |> not
    ?> lib_dir_path |> create_dir |> ignore

    ? (path |> directory_exists)
        && (path |> read_link |> resultm.is_err)
    ?> path |> directory_delete !+

    ? path |> directory_exists |> not
    ?> path |> directory_create_symbolic_link target_path

/// ### link_file
:~ link_file target_path path =
    ? (path |> file_exists)
        && (path |> read_link |> resultm.is_err)
    ?> path |> file_delete

    ? path |> file_exists |> not
    ?> path |> file_create_symbolic_link target_path

///> rust -d sha2 regex
test link_file =
    := file_name = "LICENSE"
    := text = file_name

    := test_hash =
        #?*(file_name, text)
        |> crypto.hash_text

    := workspace_root = get_workspace_root ()
    := test_dir = workspace_root </> "target/test/file_system" </> test_hash

    := disposable = test_dir |> create_dir
    disposable |> use |> ignore

    := dir_path = test_dir </> "dir1"

    ? dir_path |> directory_exists
    ?> dir_path |> directory_delete !+

    dir_path |> create_dir |> ignore

    := path = dir_path </> file_name
    text |> write_all_text path

    := dir_link_path = test_dir </> "link1"

    dir_link_path |> link_directory dir_path

    := link_path = dir_link_path </> file_name

    link_path
    |> read_all_text
    |> _assert_eq text

    dir_link_path
    |> read_link
    |> resultm.unwrap'
    |> path_buf_display
    |> convert.convert
    |> _assert sm'.ends_with "dir1"

    link_path
    |> read_link
    |> resultm.unwrap'
    |> path_buf_display
    |> convert.convert
    |> _assert sm'.ends_with "LICENSE"

    := link_name = "LICENSE_"

    := link_path = dir_path </> link_name

    link_path |> link_file path

    := link_path' = dir_link_path </> link_name

    link_path'
    |> read_all_text
    |> _assert_eq text

    link_path
    |> read_link
    |> resultm.unwrap'
    |> path_buf_display
    |> convert.convert
    |> _assert sm'.ends_with "LICENSE"

    link_path'
    |> read_link
    |> resultm.unwrap'
    |> path_buf_display
    |> convert.convert
    |> _assert sm'.ends_with "LICENSE"

///> rust -d sha2 regex
test directory_create_junction_links_reads_and_refuses_a_taken_path =
    := test_dir = get_workspace_root () </> "target/test/file_system/junction"
    ? test_dir |> directory_exists ?> test_dir |> directory_delete !+
    := target = test_dir </> "target"
    target |> create_dir |> ignore
    "through the junction" |> write_all_text (target </> "hello.txt")
    := link = test_dir </> "link"
    := first = directory_create_junction target link
    := second = directory_create_junction target link
    := read = (link </> "hello.txt") |> read_all_text
    (first = Ok (), second <> Ok (), read) |> _assert_eq (!+, !+, "through the junction")

///> rust -d sha2 regex
test file_read_only_round_trips =
    := test_dir = get_workspace_root () </> "target/test/file_system/read_only"
    test_dir |> create_dir |> ignore
    := path = test_dir </> "blob.txt"
    ? path |> file_exists ?> file_set_read_only !- path |> ignore
    "blob" |> write_all_text path
    := before = file_is_read_only path
    := locked = file_set_read_only !+ path
    := after = file_is_read_only path
    := unlocked = file_set_read_only !- path
    (before, locked, after, unlocked, file_is_read_only path) |> _assert_eq (!-, !+, !+, !+, !-)

/// ## rust

/// ### file_exists_content
:~ file_exists_content path content : bool =
    run_target \|
        | Rust => \ () =>
            ? path |> file_exists |> not
            ?> !-
            |:
                := existing_content = path |> read_all_text
                content = existing_content
        | _ => \ () => null ()

/// ### write_all_text_exists
:~ write_all_text_exists path contents =
    := exists' = contents |> file_exists_content path
    ? not exists' ?>
        := dir = path |> directory_get_parent |> optionm'.default_value' ""
        ? dir |> directory_exists |> not
        ?> dir |> create_dir |> ignore
        contents |> write_all_text path

/// ## main
///> fsharp

:= main () =
    init_trace_state None
    $'let file_exists_content x = !file_exists_content x' : ()
    $'let write_all_text_async x = !write_all_text_async x' : ()
    $'let create_temp_path () = !create_temp_path ()' : ()
    $'let create_temp_dir () = !create_temp_dir ()' : ()
    $'let create_temp_dir\' x = !create_temp_dir' x' : ()
    $'let get_source_directory () = !get_source_directory ()' : ()
    $'let normalize_path x = !normalize_path x' : ()
    $'let get_full_path x = !get_full_path x' : ()
    $'let standardize_path x = !standardize_path x' : ()
    $'let new_file_uri x = !new_file_uri x' : ()
    $'let get_workspace_root () = !get_workspace_root ()' : ()
    $'let link_directory x = !link_directory x' : ()
    := combine x = (</>) x
    $'let (</>) x = !combine x' : ()

/// ### remove_dir_all
:= remove_dir_all (path : string) : resultm.result' () stream.io_error =
    ? delete_target_is_protected path
    ?> "file_system.remove_dir_all: refusing a drive root, profile, temp root or system folder: " ++# path |> failwith
    !\\(path, $'"std::fs::remove_dir_all(&*$0)"')

/// ### copy_file
:= copy_file (to : string) (path : string) : resultm.result' u64 stream.io_error =
    !\($'"std::fs::copy(&*!path, &*!to)"')

/// ### canonicalize
:= canonicalize (path : string) : resultm.result' path_buf stream.io_error =
    !\\(path, $'"std::fs::canonicalize(&*$0)"')

/// ### set_current_dir
:= set_current_dir (path : string) : resultm.result' () stream.io_error =
    !\\(path, $'"std::env::set_current_dir(&*$0)"')

/// ### get_current_dir
:= get_current_dir () : resultm.result' path_buf stream.io_error =
    !\($'"std::env::current_dir()"')

/// ### path_join_native
:= path_join_native (dir : string) (name : string) : string =
    run_target_args' (dir, name) \|
        | Rust => \ dir, name =>
            := joined : sm'.std_string = !\\((dir, name), $'"std::path::Path::new(&*$0).join(&*$1).display().to_string\
                ()"')
            sm'.from_std_string joined
        | Fsharp => \ dir, name => $'System.IO.Path.Combine (!dir, !name)' : string
        | _ => \ dir, name => dir </> name

///> rust
test path_join_native_uses_the_platform_separator =
    := joined = path_join_native "dir" "file"
    (joined = "dir/file" || joined = "dir\\file") |> _assert_eq !+

/// ### read_dir_names
:= read_dir_names (path : string) : resultm.result' (am'.vec sm'.std_string) stream.io_error =
    !\\(path, $'"std::fs::read_dir(&*$0).map(|entries| entries.filter_map(|entry| entry.ok().map(|entry| \
        entry.file_name().to_string_lossy().into_owned())).collect::<Vec<std::string::String>>())"')

///> rust -d chrono
test copy_list_canonicalize_and_remove_a_tree =
    := root, disposable = create_temp_dir ()
    ~~
        := tree = root </> "tree"
        tree |> create_dir_all |> resultm.unwrap'
        "x" |> write_all_text (tree </> "a.txt")
        := copied = tree </> "a.txt" |> copy_file (tree </> "b.txt") |> resultm.unwrap'
        := names = tree |> read_dir_names |> resultm.unwrap' |> am'.vec_len |> convert.i32
        := canonical_ok = ?= tree |> canonicalize |> resultm.unbox ?| Ok _ => !+ | Error _ => !-
        tree |> remove_dir_all |> resultm.unwrap'
        (copied, names, canonical_ok, tree |> directory_exists) |> _assert_eq (1u64, 2i32, !+, !-)
        disposable |> use |> ignore

:! rust_metadata_found = $'std::io::Result<std::fs::Metadata>'

:! rust_metadata = $'std::fs::Metadata'

:! rust_modified_found = $'std::io::Result<std::time::SystemTime>'

:! rust_system_time = $'std::time::SystemTime'

:! rust_elapsed = $'std::time::Duration'

:! rust_file_opened = $'std::io::Result<std::fs::File>'

:! rust_open_file = $'std::fs::File'

:! rust_io_done = $'std::io::Result<()>'

:= rust_metadata_of (path : string) : rust_metadata_found = $'std::fs::metadata(&*!path)'

:= rust_metadata_ok (r : rust_metadata_found) : bool = $'!r.is_ok()'

:= rust_metadata_value (r : rust_metadata_found) : rust_metadata = $'!r.unwrap()'

:= rust_modified_of (m : rust_metadata) : rust_modified_found = $'!m.modified()'

:= rust_modified_ok (r : rust_modified_found) : bool = $'!r.is_ok()'

:= rust_modified_value (r : rust_modified_found) : rust_system_time = $'!r.unwrap()'

:= rust_since_epoch (t : rust_system_time) : rust_elapsed = $'!t.duration_since(std::time::UNIX_EPOCH).unwrap_or_defau\
    lt()'

:= rust_elapsed_ms (d : rust_elapsed) : u64 = ($'!d.as_secs()' : u64) * 1000u64 + conv ($'!d.subsec_millis()' : u32)

:= rust_last_write_ms (path : string) : u64 =
    := found = rust_metadata_of path
    ? rust_metadata_ok found |> not ?> 0u64
    |:
        := modified = found |> rust_metadata_value |> rust_modified_of
        ? rust_modified_ok modified ?> modified |> rust_modified_value |> rust_since_epoch |> rust_elapsed_ms |: 0u64

:= rust_metadata_len (m : rust_metadata) : u64 = $'!m.len()'

:= rust_symlink_metadata_of (path : string) : rust_metadata_found = $'std::fs::symlink_metadata(&*!path)'

:= rust_metadata_is_symlink (m : rust_metadata) : bool = $'!m.file_type().is_symlink()'

/// ### rust_file_length
:= rust_file_length (path : string) : i64 =
    := found = rust_metadata_of path
    ? rust_metadata_ok found |> not ?> 0i64 |: found |> rust_metadata_value |> rust_metadata_len |> conv

/// ### rust_is_symlink
:= rust_is_symlink (path : string) : bool =
    := found = rust_symlink_metadata_of path
    ? rust_metadata_ok found |> not ?> !- |: found |> rust_metadata_value |> rust_metadata_is_symlink

///> rust -d chrono
test rust_file_length_and_rust_is_symlink_read_one_path =
    := root, disposable = create_temp_dir ()
    ~~
        := file = root </> "a.txt"
        "abc" |> write_all_text file
        := target = root </> "target"
        target |> create_dir_all |> resultm.unwrap'
        := link = root </> "link"
        directory_create_symbolic_link target link
        := missing = root </> "missing.txt"
        := lengths = rust_file_length file, rust_file_length missing
        := links = rust_is_symlink file, rust_is_symlink link, rust_is_symlink missing
        (lengths, links) |> _assert_eq ((3i64, 0i64), (!-, !+, !-))
        disposable |> use |> ignore

:= rust_append_opened (path : string) : rust_file_opened = $'std::fs::OpenOptions::new().create(true).append(true).ope\
    n(&*!path)'

:= rust_file_opened_ok (r : rust_file_opened) : bool = $'!r.is_ok()'

:= rust_file_of (r : rust_file_opened) : rust_open_file = $'!r.unwrap()'

:= rust_written_all (f : rust_open_file) (text : string) : rust_io_done = $'std::io::Write::write_all(&mut !f, \
    (!text).as_bytes())'

:= rust_io_ok (r : rust_io_done) : bool = $'!r.is_ok()'

:= rust_append_text (path : string) (text : string) : () =
    := opened = rust_append_opened path
    ? rust_file_opened_ok opened |> not ?> failwith "file_system.append_all_text: the file could not be opened"
    := file = rust_file_of opened
    ? rust_written_all file text |> rust_io_ok |> not ?> failwith "file_system.append_all_text: the write failed"

/// ### last_write_ms
:~ last_write_ms (path : string) : u64 =
    run_target_args' path \|
        | Fsharp => \ path =>
            ? $'System.IO.File.Exists !path' : bool
            ?> $'uint64 ((System.IO.File.GetLastWriteTimeUtc !path) - System.DateTime.UnixEpoch).TotalMilliseconds' : u64
            |: 0u64
        | Rust => \ path =>
            rust_last_write_ms path
        | TypeScript => \ path =>
            global "import * as spiral_node_fs from 'node:fs';"
            ? $'spiral_node_fs.existsSync(!path)' : bool
            ?> $'BigInt(Math.trunc(spiral_node_fs.statSync(!path).mtimeMs))' : u64
            |: 0u64
        | Gleam => \ path =>
            file_system_gleam_stat ()
            gleam_mtime_ms path
        | _ => \ _ => null ()

///> rust
///> fsharp
test last_write_ms_is_zero_for_a_missing_path_and_positive_for_a_written_file =
    := missing = get_temp_path () </> "spiral-last-write-missing.txt"
    := probe = get_temp_path () </> "spiral-last-write-probe.txt"
    file_delete missing
    last_write_ms missing |> _assert_eq 0u64
    write_all_text probe "x"
    (last_write_ms probe > 0u64) |> _assert_eq !+
    file_delete probe

/// ### append_all_text
:= append_all_text (path : string) (text : string) : () =
    run_target_args' (path, text) \|
        | Fsharp => \ path, text =>
            $'System.IO.File.AppendAllText (!path, !text)'
        | Rust => \ path, text =>
            rust_append_text path text
        | Gleam => \ path, text =>
            file_system_gleam_paths ()
            gleam_append_text path text
        | Lua => \ path, text =>
            := file = lua_file_open path "a"
            lua_file_write file text
            lua_file_close file
        | _ => \ _ => ()

///> rust
///> fsharp
test append_all_text_adds_to_the_end_of_a_file =
    := probe = get_temp_path () </> "spiral-append-probe.txt"
    file_delete probe
    append_all_text probe "a"
    append_all_text probe "b"
    read_all_text probe |> _assert_eq "ab"
    file_delete probe

///> lua
test lua_files_write_read_append_and_delete =
    := path = "spiral-lua-file-probe.txt"
    file_delete path
    path |> file_exists |> _assert_eq !-
    write_all_text path "ab"
    path |> file_exists |> _assert_eq !+
    append_all_text path "c"
    path |> read_all_text |> _assert_eq "abc"
    file_delete path
    path |> file_exists |> _assert_eq !-

:= rust_try_append_text (path : string) (text : string) : result () string =
    := opened = rust_append_opened path
    ? rust_file_opened_ok opened |> not ?> Error "the file could not be opened"
    |:
        := file = rust_file_of opened
        ? rust_written_all file text |> rust_io_ok ?> Ok () |: Error "the write failed"

/// ### try_append_all_text
:= try_append_all_text (path : string) (text : string) : result () string =
    run_target_args' (path, text) \|
        | Rust => \ path, text => rust_try_append_text path text
        | _ => \ path, text =>
            append_all_text path text
            Ok ()

///> rust
test try_append_all_text_reports_instead_of_failing =
    := missing = get_temp_path () </> "eoie-no-such-folder-for-append" </> "x.txt"
    (try_append_all_text missing "a" = Error "the file could not be opened") |> _assert_eq !+
