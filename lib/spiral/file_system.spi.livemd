#### copy_list_canonicalize_and_remove_a_tree (test)

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":"///- --test --symbol\n///> rust -d chrono\n\n:= root, disposable = create_temp_directory ()\n~~\n    := tree = root </> \"tree\"\n    tree |> create_dir_all |> resultm::unwrap'\n    \"x\" |> write_all_text (tree </> \"a.txt\")\n    := copied = tree </> \"a.txt\" |> copy_file (tree </> \"b.txt\") |> resultm::unwrap'\n    := names = tree |> read_directory_names |> resultm::unwrap' |> am'::vec_len |> convert::i32\n    := canonical_ok = ?= tree |> canonicalize |> resultm::unbox ?| Ok _ => !+ | Error _ => !-\n    tree |> remove_dir_all |> resultm::unwrap'\n    (copied, names, canonical_ok, tree |> directory_exists) |> _assert_eq (1u64, 2i32, !+, !-)\n    disposable |> use |> ignore","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  ///- --test --symbol
  ///> rust -d chrono

  := root, disposable = create_temp_directory ()
  ~~
      := tree = root </> "tree"
      tree |> create_dir_all |> resultm::unwrap'
      "x" |> write_all_text (tree </> "a.txt")
      := copied = tree </> "a.txt" |> copy_file (tree </> "b.txt") |> resultm::unwrap'
      := names = tree |> read_directory_names |> resultm::unwrap' |> am'::vec_len |> convert::i32
      := canonical_ok = ?= tree |> canonicalize |> resultm::unbox ?| Ok _ => !+ | Error _ => !-
      tree |> remove_dir_all |> resultm::unwrap'
      (copied, names, canonical_ok, tree |> directory_exists) |> _assert_eq (1u64, 2i32, !+, !-)
      disposable |> use |> ignore
  """,
  timeout: 300_000
)
```

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":":! rust_metadata_found = $'std::io::Result<std::fs::Metadata>'\n\n:! rust_metadata = $'std::fs::Metadata'\n\n:! rust_modified_found = $'std::io::Result<std::time::SystemTime>'\n\n:! rust_system_time = $'std::time::SystemTime'\n\n:! rust_elapsed = $'std::time::Duration'\n\n:! rust_file_opened = $'std::io::Result<std::fs::File>'\n\n:! rust_open_file = $'std::fs::File'\n\n:! rust_io_done = $'std::io::Result<()>'\n\n:= rust_metadata_of (path : string) : rust_metadata_found = $'std::fs::metadata(&*!path)'\n\n:= rust_metadata_ok (r : rust_metadata_found) : bool = $'!r.is_ok()'\n\n:= rust_metadata_value (r : rust_metadata_found) : rust_metadata = $'!r.unwrap()'\n\n:= rust_modified_of (m : rust_metadata) : rust_modified_found = $'!m.modified()'\n\n:= rust_modified_ok (r : rust_modified_found) : bool = $'!r.is_ok()'\n\n:= rust_modified_value (r : rust_modified_found) : rust_system_time = $'!r.unwrap()'\n\n:= rust_since_epoch (t : rust_system_time) : rust_elapsed = $'!t.duration_since(std::time::UNIX_EPOCH).unwrap_or_defau\\\n    lt()'\n\n:= rust_elapsed_ms (d : rust_elapsed) : u64 = ($'!d.as_secs()' : u64) * 1000u64 + conv ($'!d.subsec_millis()' : u32)\n\n:= rust_last_write_ms (path : string) : u64 =\n    := found = rust_metadata_of path\n    ? rust_metadata_ok found |> not ?> 0u64\n    |:\n        := modified = found |> rust_metadata_value |> rust_modified_of\n        ? rust_modified_ok modified ?> modified |> rust_modified_value |> rust_since_epoch |> rust_elapsed_ms |: 0u64\n\n:= rust_metadata_len (m : rust_metadata) : u64 = $'!m.len()'\n\n:= rust_symlink_metadata_of (path : string) : rust_metadata_found = $'std::fs::symlink_metadata(&*!path)'\n\n:= rust_metadata_is_symlink (m : rust_metadata) : bool = $'!m.file_type().is_symlink()'\n\n:= rust_file_length (path : string) : i64 =\n    := found = rust_metadata_of path\n    ? rust_metadata_ok found |> not ?> 0i64 |: found |> rust_metadata_value |> rust_metadata_len |> conv\n\n:= rust_is_symlink (path : string) : bool =\n    := found = rust_symlink_metadata_of path\n    ? rust_metadata_ok found |> not ?> !- |: found |> rust_metadata_value |> rust_metadata_is_symlink","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  :! rust_metadata_found = $'std::io::Result<std::fs::Metadata>'

  :! rust_metadata = $'std::fs::Metadata'

  :! rust_modified_found = $'std::io::Result<std::time::SystemTime>'

  :! rust_system_time = $'std::time::SystemTime'

  :! rust_elapsed = $'std::time::Duration'

  :! rust_file_opened = $'std::io::Result<std::fs::File>'

  :! rust_open_file = $'std::fs::File'

  :! rust_io_done = $'std::io::Result<()>'

  := rust_metadata_of (path : string) : rust_metadata_found = $'std::fs::metadata(&*!path)'

  := rust_metadata_ok (r : rust_metadata_found) : bool = $'!r.is_ok()'

  := rust_metadata_value (r : rust_metadata_found) : rust_metadata = $'!r.unwrap()'

  := rust_modified_of (m : rust_metadata) : rust_modified_found = $'!m.modified()'

  := rust_modified_ok (r : rust_modified_found) : bool = $'!r.is_ok()'

  := rust_modified_value (r : rust_modified_found) : rust_system_time = $'!r.unwrap()'

  := rust_since_epoch (t : rust_system_time) : rust_elapsed = $'!t.duration_since(std::time::UNIX_EPOCH).unwrap_or_defau\
      lt()'

  := rust_elapsed_ms (d : rust_elapsed) : u64 = ($'!d.as_secs()' : u64) * 1000u64 + conv ($'!d.subsec_millis()' : u32)

  := rust_last_write_ms (path : string) : u64 =
      := found = rust_metadata_of path
      ? rust_metadata_ok found |> not ?> 0u64
      |:
          := modified = found |> rust_metadata_value |> rust_modified_of
          ? rust_modified_ok modified ?> modified |> rust_modified_value |> rust_since_epoch |> rust_elapsed_ms |: 0u64

  := rust_metadata_len (m : rust_metadata) : u64 = $'!m.len()'

  := rust_symlink_metadata_of (path : string) : rust_metadata_found = $'std::fs::symlink_metadata(&*!path)'

  := rust_metadata_is_symlink (m : rust_metadata) : bool = $'!m.file_type().is_symlink()'

  := rust_file_length (path : string) : i64 =
      := found = rust_metadata_of path
      ? rust_metadata_ok found |> not ?> 0i64 |: found |> rust_metadata_value |> rust_metadata_len |> conv

  := rust_is_symlink (path : string) : bool =
      := found = rust_symlink_metadata_of path
      ? rust_metadata_ok found |> not ?> !- |: found |> rust_metadata_value |> rust_metadata_is_symlink
  """,
  timeout: 300_000
)
```

#### rust_file_length_and_rust_is_symlink_read_one_path (test)

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":"///- --test --symbol\n///> rust -d chrono\n\n:= root, disposable = create_temp_directory ()\n~~\n    := file = root </> \"a.txt\"\n    \"abc\" |> write_all_text file\n    := target = root </> \"target\"\n    target |> create_dir_all |> resultm::unwrap'\n    := link = root </> \"link\"\n    directory_create_symbolic_link target link\n    := missing = root </> \"missing.txt\"\n    := lengths = rust_file_length file, rust_file_length missing\n    := links = rust_is_symlink file, rust_is_symlink link, rust_is_symlink missing\n    (lengths, links) |> _assert_eq ((3i64, 0i64), (!-, !+, !-))\n    disposable |> use |> ignore","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  ///- --test --symbol
  ///> rust -d chrono

  := root, disposable = create_temp_directory ()
  ~~
      := file = root </> "a.txt"
      "abc" |> write_all_text file
      := target = root </> "target"
      target |> create_dir_all |> resultm::unwrap'
      := link = root </> "link"
      directory_create_symbolic_link target link
      := missing = root </> "missing.txt"
      := lengths = rust_file_length file, rust_file_length missing
      := links = rust_is_symlink file, rust_is_symlink link, rust_is_symlink missing
      (lengths, links) |> _assert_eq ((3i64, 0i64), (!-, !+, !-))
      disposable |> use |> ignore
  """,
  timeout: 300_000
)
```

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":":= rust_append_opened (path : string) : rust_file_opened = $'std::fs::OpenOptions::new().create(true).append(true).ope\\\n    n(&*!path)'\n\n:= rust_file_opened_ok (r : rust_file_opened) : bool = $'!r.is_ok()'\n\n:= rust_file_of (r : rust_file_opened) : rust_open_file = $'!r.unwrap()'\n\n:= rust_written_all (f : rust_open_file) (text : string) : rust_io_done = $'std::io::Write::write_all(&mut !f, \\\n    (!text).as_bytes())'\n\n:= rust_io_ok (r : rust_io_done) : bool = $'!r.is_ok()'\n\n:= rust_append_text (path : string) (text : string) : () =\n    := opened = rust_append_opened path\n    ? rust_file_opened_ok opened |> not ?> failwith \"file_system.append_all_text: the file could not be opened\"\n    := file = rust_file_of opened\n    ? rust_written_all file text |> rust_io_ok |> not ?> failwith \"file_system.append_all_text: the write failed\"\n\n:~ last_write_ms (path : string) : u64 =\n    run_target_args' path \\|\n        | Fsharp => \\ path =>\n            ? $'System.IO.File.Exists !path' : bool\n            ?> $'uint64 ((System.IO.File.GetLastWriteTimeUtc !path) - System.DateTime.UnixEpoch).TotalMilliseconds' : u64\n            |: 0u64\n        | Rust => \\ path =>\n            rust_last_write_ms path\n        | TypeScript => \\ path =>\n            global \"import * as spiral_node_fs from 'node:fs';\"\n            ? $'spiral_node_fs.existsSync(!path)' : bool\n            ?> $'BigInt(Math.trunc(spiral_node_fs.statSync(!path).mtimeMs))' : u64\n            |: 0u64\n        | Gleam => \\ path =>\n            file_system_gleam_stat ()\n            gleam_mtime_ms path\n        | _ => \\ _ => null ()","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  := rust_append_opened (path : string) : rust_file_opened = $'std::fs::OpenOptions::new().create(true).append(true).ope\
      n(&*!path)'

  := rust_file_opened_ok (r : rust_file_opened) : bool = $'!r.is_ok()'

  := rust_file_of (r : rust_file_opened) : rust_open_file = $'!r.unwrap()'

  := rust_written_all (f : rust_open_file) (text : string) : rust_io_done = $'std::io::Write::write_all(&mut !f, \
      (!text).as_bytes())'

  := rust_io_ok (r : rust_io_done) : bool = $'!r.is_ok()'

  := rust_append_text (path : string) (text : string) : () =
      := opened = rust_append_opened path
      ? rust_file_opened_ok opened |> not ?> failwith "file_system.append_all_text: the file could not be opened"
      := file = rust_file_of opened
      ? rust_written_all file text |> rust_io_ok |> not ?> failwith "file_system.append_all_text: the write failed"

  :~ last_write_ms (path : string) : u64 =
      run_target_args' path \|
          | Fsharp => \ path =>
              ? $'System.IO.File.Exists !path' : bool
              ?> $'uint64 ((System.IO.File.GetLastWriteTimeUtc !path) - System.DateTime.UnixEpoch).TotalMilliseconds' : u64
              |: 0u64
          | Rust => \ path =>
              rust_last_write_ms path
          | TypeScript => \ path =>
              global "import * as spiral_node_fs from 'node:fs';"
              ? $'spiral_node_fs.existsSync(!path)' : bool
              ?> $'BigInt(Math.trunc(spiral_node_fs.statSync(!path).mtimeMs))' : u64
              |: 0u64
          | Gleam => \ path =>
              file_system_gleam_stat ()
              gleam_mtime_ms path
          | _ => \ _ => null ()
  """,
  timeout: 300_000
)
```

#### last_write_ms_is_zero_for_a_missing_path_and_positive_for_a_written_file (test)

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":"///- --test --symbol\n///> rust\n\n:= missing = get_temp_path () </> \"spiral-last-write-missing.txt\"\n:= probe = get_temp_path () </> \"spiral-last-write-probe.txt\"\nfile_delete missing\nlast_write_ms missing |> _assert_eq 0u64\nwrite_all_text probe \"x\"\n(last_write_ms probe > 0u64) |> _assert_eq !+\nfile_delete probe","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  ///- --test --symbol
  ///> rust

  := missing = get_temp_path () </> "spiral-last-write-missing.txt"
  := probe = get_temp_path () </> "spiral-last-write-probe.txt"
  file_delete missing
  last_write_ms missing |> _assert_eq 0u64
  write_all_text probe "x"
  (last_write_ms probe > 0u64) |> _assert_eq !+
  file_delete probe
  """,
  timeout: 300_000
)
```

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":":= append_all_text (path : string) (text : string) : () =\n    run_target_args' (path, text) \\|\n        | Fsharp => \\ path, text =>\n            $'System.IO.File.AppendAllText (!path, !text)'\n        | Rust => \\ path, text =>\n            rust_append_text path text\n        | Gleam => \\ path, text =>\n            file_system_gleam_paths ()\n            gleam_append_text path text\n        | Lua => \\ path, text =>\n            := file = lua_file_open path \"a\"\n            lua_file_write file text\n            lua_file_close file\n        | _ => \\ _ => ()\n\n:= appended_text () : string =\n    := probe = get_temp_path () </> \"spiral-append-probe.txt\"\n    file_delete probe\n    append_all_text probe \"a\"\n    append_all_text probe \"b\"\n    := text = read_all_text probe\n    file_delete probe\n    text","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  := append_all_text (path : string) (text : string) : () =
      run_target_args' (path, text) \|
          | Fsharp => \ path, text =>
              $'System.IO.File.AppendAllText (!path, !text)'
          | Rust => \ path, text =>
              rust_append_text path text
          | Gleam => \ path, text =>
              file_system_gleam_paths ()
              gleam_append_text path text
          | Lua => \ path, text =>
              := file = lua_file_open path "a"
              lua_file_write file text
              lua_file_close file
          | _ => \ _ => ()

  := appended_text () : string =
      := probe = get_temp_path () </> "spiral-append-probe.txt"
      file_delete probe
      append_all_text probe "a"
      append_all_text probe "b"
      := text = read_all_text probe
      file_delete probe
      text
  """,
  timeout: 300_000
)
```

