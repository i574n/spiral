<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":":= read_all_text (path : string) : string =\n    run_target \\|\n        | Zig => \\ () =>\n            global \"var spiral_io_threaded: std.Io.Threaded = .init_single_threaded;\"\n            $'(std.Io.Dir.cwd().readFileAlloc(spiral_io_threaded.io(), !path, spiral_gpa, .unlimited) catch \\\n                \\@panic(\"file_system.read_all_text failed\"))' : string\n        | Fsharp => \\ () =>\n            $'!path |> System.IO.File.ReadAllText'\n        | Gleam => \\ () =>\n            file_system_gleam_files ()\n            gleam_read_text path\n        | Rust => \\ () =>\n            path\n            |> read_all_bytes\n            |> sm'::string_from_utf8\n            |> resultm::unwrap'\n            |> sm'::from_std_string\n        | Lua => \\ () =>\n            := file = lua_file_open path \"r\"\n            := text = lua_file_read_all file\n            lua_file_close file\n            text\n        | Pascal => \\ () =>\n            := handle = $'FileOpen(!path, fmOpenRead)' : i64\n            ? handle = -1i64 ?> failwith \"file_system.read_all_text / cannot open the file\"\n            := size = $'FileSeek(!handle, 0, 2)' : i32\n            := start = $'FileSeek(!handle, 0, 0)' : i32\n            ? start <> 0i32 ?> failwith \"file_system.read_all_text / cannot rewind the file\"\n            := text = $'StringOfChar(Chr(0), !size)' : string\n            ? size > 0i32 ?>\n                := first = 1i32\n                := read = $'FileRead(!handle, (!text)[!first], !size)' : i32\n                ? read <> size ?> failwith \"file_system.read_all_text / short read\"\n            $'FileClose(!handle)' : ()\n            text\n        | _ => \\ () => null ()","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  := read_all_text (path : string) : string =
      run_target \|
          | Zig => \ () =>
              global "var spiral_io_threaded: std.Io.Threaded = .init_single_threaded;"
              $'(std.Io.Dir.cwd().readFileAlloc(spiral_io_threaded.io(), !path, spiral_gpa, .unlimited) catch \
                  \@panic("file_system.read_all_text failed"))' : string
          | Fsharp => \ () =>
              $'!path |> System.IO.File.ReadAllText'
          | Gleam => \ () =>
              file_system_gleam_files ()
              gleam_read_text path
          | Rust => \ () =>
              path
              |> read_all_bytes
              |> sm'::string_from_utf8
              |> resultm::unwrap'
              |> sm'::from_std_string
          | Lua => \ () =>
              := file = lua_file_open path "r"
              := text = lua_file_read_all file
              lua_file_close file
              text
          | Pascal => \ () =>
              := handle = $'FileOpen(!path, fmOpenRead)' : i64
              ? handle = -1i64 ?> failwith "file_system.read_all_text / cannot open the file"
              := size = $'FileSeek(!handle, 0, 2)' : i32
              := start = $'FileSeek(!handle, 0, 0)' : i32
              ? start <> 0i32 ?> failwith "file_system.read_all_text / cannot rewind the file"
              := text = $'StringOfChar(Chr(0), !size)' : string
              ? size > 0i32 ?>
                  := first = 1i32
                  := read = $'FileRead(!handle, (!text)[!first], !size)' : i32
                  ? read <> size ?> failwith "file_system.read_all_text / short read"
              $'FileClose(!handle)' : ()
              text
          | _ => \ () => null ()
  """,
  timeout: 300_000
)
```

