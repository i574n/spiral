<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":":~ read_link (path : string) : resultm::result' path_buf stream::io_error =\n    :~ run 루프 n error path' =\n        := name = path' |> get_file_name\n        := parent = path' |> directory_get_parent |> optionm'::unbox\n        := error'' = #?error\n        ?= parent ?|\n        | _ ?& n >= 11 =>\n            ($'$\"file_system.read_link / \"' : string)\n            ++# $'$\"path: {!path} / n: {!n} / path\\': {!path'} / name: {!name}\"'\n            |> stream::new_io_error\n            |> resultm::err\n        | Some parent ?& path' <>. \"\" =>\n            ?= 루프 (n + 1) parent |> resultm::map_error' sm'::format |> resultm::unbox ?|\n            | Ok parent' =>\n                (parent' |> path_buf_display |> convert::convert) </> name\n                |> sm'::to_std_string\n                |> new_path_buf\n                |> resultm::ok''\n            | Error error' =>\n                ($'$\"file_system.read_link / \"' : string)\n                ++# $'$\"error\\': {!error'} / error: {!error''} / name: {!name}\"'\n                |> stream::new_io_error\n                |> resultm::err\n        | _ =>\n            ($'$\"file_system.read_link / run / The file or directory is not a reparse point. / \"' : string)\n            ++# $'$\"path: {!path} / error: {!error''} / path\\': {!path'} / name: {!name}\"'\n            |> stream::new_io_error\n            |> resultm::err\n\n    run_target \\|\n        | Rust => \\ () =>\n            ? path |> directory_exists\n            ?> !\\\\(path, $'\"std::fs::read_link(&*$0)\"')\n            |:\n                :~ ^ 루프 \\* t {number}.\n                    (n : t)\n                    (path' : string)\n                    : resultm::result' path_buf stream::io_error\n                    =\n                    run_target \\|\n                        | Rust => \\ () =>\n                            := result : _ _ stream::io_error = !\\\\(path', $'\"std::fs::read_link(&*$0)\"')\n                            := result = result |> resultm::map_error' sm'::format |> resultm::unbox\n                            ?= result ?|\n                            | Ok x => x |> resultm::ok''\n                            | Error error => path' |> run 루프 n error\n                        | _ => \\ () => null ()\n                path |> 루프 0u8\n        | Fsharp _\n        | TypeScript _ => \\ () =>\n            :~ ^ 루프 \\* t {number}.\n                (n : t)\n                (path' : string)\n                : resultm::result' path_buf stream::io_error\n                =\n                := result =\n                    path'\n                    |> directory_info\n                    |> directory_info_attributes\n                    |> file_attributes_has_flag (file_attributes_reparse_point ())\n                ? result ?>\n                    path'\n                    |> file_info\n                    |> file_info_link_target\n                    |> convert::unbox\n                    |> resultm::ok''\n                |:\n                    := error =\n                        ($'$\"file_system.read_link / Fsharp / \"' : string)\n                        ++# $'$\"The file or directory is not a reparse point. / \"'\n                        ++# $'$\"path: {!path} / result: {!result} / path\\': {!path'} / n: {!n}\"'\n                        |> stream::new_io_error\n                    path' |> run 루프 n error\n            path |> 루프 0u8\n        | _ => \\ () => $'Unchecked.defaultof<_>'\n\n:~ normalize_path (path : string) : string =\n    ? path = \"\"\n    ?> \"\"\n    |:\n        := result =\n            ?= path |> read_link |> resultm::ok' |> optionm'::unbox ?|\n            | Some path_buf =>\n                path_buf\n                |> path_buf_display\n                |> convert::convert\n            | None => path\n        := result =\n            ? result = \"\"\n            ?> path\n            |: result\n        := result' =\n            ? result |> sm'::starts_with \"\\\\\\\\?\\\\\"\n            ?> result |> sm'::substring 4i32 ((sm'::length result : i32) - 4i32)\n            |: result\n        ? ##result' < 2\n        ?> path\n        |:\n            sm'::(++#)\n                (result' |> sm'::slice 0i32 0i32 |> sm'::to_lower)\n                (result' |> sm'::slice 1i32 ((sm'::length result' : i32) - 1i32))\n            |> sm'::replace \"\\\\\" \"/\"","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  :~ read_link (path : string) : resultm::result' path_buf stream::io_error =
      :~ run 루프 n error path' =
          := name = path' |> get_file_name
          := parent = path' |> directory_get_parent |> optionm'::unbox
          := error'' = #?error
          ?= parent ?|
          | _ ?& n >= 11 =>
              ($'$"file_system.read_link / "' : string)
              ++# $'$"path: {!path} / n: {!n} / path\': {!path'} / name: {!name}"'
              |> stream::new_io_error
              |> resultm::err
          | Some parent ?& path' <>. "" =>
              ?= 루프 (n + 1) parent |> resultm::map_error' sm'::format |> resultm::unbox ?|
              | Ok parent' =>
                  (parent' |> path_buf_display |> convert::convert) </> name
                  |> sm'::to_std_string
                  |> new_path_buf
                  |> resultm::ok''
              | Error error' =>
                  ($'$"file_system.read_link / "' : string)
                  ++# $'$"error\': {!error'} / error: {!error''} / name: {!name}"'
                  |> stream::new_io_error
                  |> resultm::err
          | _ =>
              ($'$"file_system.read_link / run / The file or directory is not a reparse point. / "' : string)
              ++# $'$"path: {!path} / error: {!error''} / path\': {!path'} / name: {!name}"'
              |> stream::new_io_error
              |> resultm::err

      run_target \|
          | Rust => \ () =>
              ? path |> directory_exists
              ?> !\\(path, $'"std::fs::read_link(&*$0)"')
              |:
                  :~ ^ 루프 \* t {number}.
                      (n : t)
                      (path' : string)
                      : resultm::result' path_buf stream::io_error
                      =
                      run_target \|
                          | Rust => \ () =>
                              := result : _ _ stream::io_error = !\\(path', $'"std::fs::read_link(&*$0)"')
                              := result = result |> resultm::map_error' sm'::format |> resultm::unbox
                              ?= result ?|
                              | Ok x => x |> resultm::ok''
                              | Error error => path' |> run 루프 n error
                          | _ => \ () => null ()
                  path |> 루프 0u8
          | Fsharp _
          | TypeScript _ => \ () =>
              :~ ^ 루프 \* t {number}.
                  (n : t)
                  (path' : string)
                  : resultm::result' path_buf stream::io_error
                  =
                  := result =
                      path'
                      |> directory_info
                      |> directory_info_attributes
                      |> file_attributes_has_flag (file_attributes_reparse_point ())
                  ? result ?>
                      path'
                      |> file_info
                      |> file_info_link_target
                      |> convert::unbox
                      |> resultm::ok''
                  |:
                      := error =
                          ($'$"file_system.read_link / Fsharp / "' : string)
                          ++# $'$"The file or directory is not a reparse point. / "'
                          ++# $'$"path: {!path} / result: {!result} / path\': {!path'} / n: {!n}"'
                          |> stream::new_io_error
                      path' |> run 루프 n error
              path |> 루프 0u8
          | _ => \ () => $'Unchecked.defaultof<_>'

  :~ normalize_path (path : string) : string =
      ? path = ""
      ?> ""
      |:
          := result =
              ?= path |> read_link |> resultm::ok' |> optionm'::unbox ?|
              | Some path_buf =>
                  path_buf
                  |> path_buf_display
                  |> convert::convert
              | None => path
          := result =
              ? result = ""
              ?> path
              |: result
          := result' =
              ? result |> sm'::starts_with "\\\\?\\"
              ?> result |> sm'::substring 4i32 ((sm'::length result : i32) - 4i32)
              |: result
          ? ##result' < 2
          ?> path
          |:
              sm'::(++#)
                  (result' |> sm'::slice 0i32 0i32 |> sm'::to_lower)
                  (result' |> sm'::slice 1i32 ((sm'::length result' : i32) - 1i32))
              |> sm'::replace "\\" "/"
  """,
  timeout: 300_000
)
```

