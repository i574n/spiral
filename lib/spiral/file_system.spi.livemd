<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":":~ get_full_path (path : string) : string =\n    run_target_args (\\ () => path) \\|\n        | Fsharp => \\ path =>\n            path |> $'System.IO.Path.GetFullPath'\n        | Rust => \\ path =>\n            := current_dir = get_current_directory ()\n            current_dir </> path\n            |> normalize_path\n            |> sm'::split \"/\"\n            |> \\ x =>\n                ((array x : array _), (0i32, (;[] : array _)))\n                ||> arraym::foldBack \\ x level, acc =>\n                    ?= x, level ?|\n                    | \"..\", _ => level + 1, acc\n                    | \".\", _ => level, acc\n                    | _, 0 ?& x |> sm'::ends_with \":\" =>\n                        := drive = current_dir |> sm'::slice 0i32 0i32\n                        := letter = x |> sm'::slice 0i32 0i32\n                        0, ;[ sm'::(++#) (? sm'::to_lower letter = sm'::to_lower drive ?> drive |: sm'::to_upper letter) \":\" ] ++ acc\n                    | _, 0 => 0, ;[ x ] ++ acc\n                    | _ => level - 1, acc\n            |> snd\n            |> seq::of_array'\n            |> sm'::concat (directory_separator_char () |> sm'::obj_to_string)\n        | Gleam => \\ path =>\n            file_system_gleam_paths ()\n            gleam_lexical_full_path path\n        | _ => \\ _ => null ()","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  :~ get_full_path (path : string) : string =
      run_target_args (\ () => path) \|
          | Fsharp => \ path =>
              path |> $'System.IO.Path.GetFullPath'
          | Rust => \ path =>
              := current_dir = get_current_directory ()
              current_dir </> path
              |> normalize_path
              |> sm'::split "/"
              |> \ x =>
                  ((array x : array _), (0i32, (;[] : array _)))
                  ||> arraym::foldBack \ x level, acc =>
                      ?= x, level ?|
                      | "..", _ => level + 1, acc
                      | ".", _ => level, acc
                      | _, 0 ?& x |> sm'::ends_with ":" =>
                          := drive = current_dir |> sm'::slice 0i32 0i32
                          := letter = x |> sm'::slice 0i32 0i32
                          0, ;[ sm'::(++#) (? sm'::to_lower letter = sm'::to_lower drive ?> drive |: sm'::to_upper letter) ":" ] ++ acc
                      | _, 0 => 0, ;[ x ] ++ acc
                      | _ => level - 1, acc
              |> snd
              |> seq::of_array'
              |> sm'::concat (directory_separator_char () |> sm'::obj_to_string)
          | Gleam => \ path =>
              file_system_gleam_paths ()
              gleam_lexical_full_path path
          | _ => \ _ => null ()
  """,
  timeout: 300_000
)
```

