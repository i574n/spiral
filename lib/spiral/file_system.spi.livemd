<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":":= create_temp_directory' (hash : string) =\n    := dir = hash |> guid::hash_guid |> create_temp_path'\n    dir, dir |> create_dir\n\n:~ link_directory target_path path =\n    ? target_path |> directory_exists |> not\n    ?> target_path |> create_dir |> ignore\n\n    := lib_dir_path = path |> directory_get_parent |> optionm'::default_value' \"\"\n    ? lib_dir_path |> directory_exists |> not\n    ?> lib_dir_path |> create_dir |> ignore\n\n    ? (path |> directory_exists)\n        && (path |> read_link |> resultm::is_err)\n    ?> path |> directory_delete !+\n\n    ? path |> directory_exists |> not\n    ?> path |> directory_create_symbolic_link target_path\n\n:~ link_file target_path path =\n    ? (path |> file_exists)\n        && (path |> read_link |> resultm::is_err)\n    ?> path |> file_delete\n\n    ? path |> file_exists |> not\n    ?> path |> file_create_symbolic_link target_path","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  := create_temp_directory' (hash : string) =
      := dir = hash |> guid::hash_guid |> create_temp_path'
      dir, dir |> create_dir

  :~ link_directory target_path path =
      ? target_path |> directory_exists |> not
      ?> target_path |> create_dir |> ignore

      := lib_dir_path = path |> directory_get_parent |> optionm'::default_value' ""
      ? lib_dir_path |> directory_exists |> not
      ?> lib_dir_path |> create_dir |> ignore

      ? (path |> directory_exists)
          && (path |> read_link |> resultm::is_err)
      ?> path |> directory_delete !+

      ? path |> directory_exists |> not
      ?> path |> directory_create_symbolic_link target_path

  :~ link_file target_path path =
      ? (path |> file_exists)
          && (path |> read_link |> resultm::is_err)
      ?> path |> file_delete

      ? path |> file_exists |> not
      ?> path |> file_create_symbolic_link target_path
  """,
  timeout: 300_000
)
```

#### link_file (test)

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":"///- --test --symbol\n///> rust -d sha2 regex\n\n:= file_name = \"LICENSE\"\n:= text = file_name\n\n:= test_hash =\n    #?*(file_name, text)\n    |> crypto::hash_text\n\n:= workspace_root = get_workspace_root ()\n:= test_dir = workspace_root </> \"target/test/file_system\" </> test_hash\n\n:= disposable = test_dir |> create_dir\ndisposable |> use |> ignore\n\n:= dir_path = test_dir </> \"dir1\"\n\n? dir_path |> directory_exists\n?> dir_path |> directory_delete !+\n\ndir_path |> create_dir |> ignore\n\n:= path = dir_path </> file_name\ntext |> write_all_text path\n\n:= dir_link_path = test_dir </> \"link1\"\n\ndir_link_path |> link_directory dir_path\n\n:= link_path = dir_link_path </> file_name\n\nlink_path\n|> read_all_text\n|> _assert_eq text\n\ndir_link_path\n|> read_link\n|> resultm::unwrap'\n|> path_buf_display\n|> convert::convert\n|> _assert sm'::ends_with \"dir1\"\n\nlink_path\n|> read_link\n|> resultm::unwrap'\n|> path_buf_display\n|> convert::convert\n|> _assert sm'::ends_with \"LICENSE\"\n\n:= link_name = \"LICENSE_\"\n\n:= link_path = dir_path </> link_name\n\nlink_path |> link_file path\n\n:= link_path' = dir_link_path </> link_name\n\nlink_path'\n|> read_all_text\n|> _assert_eq text\n\nlink_path\n|> read_link\n|> resultm::unwrap'\n|> path_buf_display\n|> convert::convert\n|> _assert sm'::ends_with \"LICENSE\"\n\nlink_path'\n|> read_link\n|> resultm::unwrap'\n|> path_buf_display\n|> convert::convert\n|> _assert sm'::ends_with \"LICENSE\"","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  ///- --test --symbol
  ///> rust -d sha2 regex

  := file_name = "LICENSE"
  := text = file_name

  := test_hash =
      #?*(file_name, text)
      |> crypto::hash_text

  := workspace_root = get_workspace_root ()
  := test_dir = workspace_root </> "target/test/file_system" </> test_hash

  := disposable = test_dir |> create_dir
  disposable |> use |> ignore

  := dir_path = test_dir </> "dir1"

  ? dir_path |> directory_exists
  ?> dir_path |> directory_delete !+

  dir_path |> create_dir |> ignore

  := path = dir_path </> file_name
  text |> write_all_text path

  := dir_link_path = test_dir </> "link1"

  dir_link_path |> link_directory dir_path

  := link_path = dir_link_path </> file_name

  link_path
  |> read_all_text
  |> _assert_eq text

  dir_link_path
  |> read_link
  |> resultm::unwrap'
  |> path_buf_display
  |> convert::convert
  |> _assert sm'::ends_with "dir1"

  link_path
  |> read_link
  |> resultm::unwrap'
  |> path_buf_display
  |> convert::convert
  |> _assert sm'::ends_with "LICENSE"

  := link_name = "LICENSE_"

  := link_path = dir_path </> link_name

  link_path |> link_file path

  := link_path' = dir_link_path </> link_name

  link_path'
  |> read_all_text
  |> _assert_eq text

  link_path
  |> read_link
  |> resultm::unwrap'
  |> path_buf_display
  |> convert::convert
  |> _assert sm'::ends_with "LICENSE"

  link_path'
  |> read_link
  |> resultm::unwrap'
  |> path_buf_display
  |> convert::convert
  |> _assert sm'::ends_with "LICENSE"
  """,
  timeout: 300_000
)
```

#### directory_create_junction_links_reads_and_refuses_a_taken_path (test)

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":"///- --test --symbol\n///> rust -d sha2 regex\n\n:= test_dir = get_workspace_root () </> \"target/test/file_system/junction\"\n? test_dir |> directory_exists ?> test_dir |> directory_delete !+\n:= target = test_dir </> \"target\"\ntarget |> create_dir |> ignore\n\"through the junction\" |> write_all_text (target </> \"hello.txt\")\n:= link = test_dir </> \"link\"\n:= first = directory_create_junction target link\n:= second = directory_create_junction target link\n:= read = (link </> \"hello.txt\") |> read_all_text\n(first = Ok (), second <> Ok (), read) |> _assert_eq (!+, !+, \"through the junction\")","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  ///- --test --symbol
  ///> rust -d sha2 regex

  := test_dir = get_workspace_root () </> "target/test/file_system/junction"
  ? test_dir |> directory_exists ?> test_dir |> directory_delete !+
  := target = test_dir </> "target"
  target |> create_dir |> ignore
  "through the junction" |> write_all_text (target </> "hello.txt")
  := link = test_dir </> "link"
  := first = directory_create_junction target link
  := second = directory_create_junction target link
  := read = (link </> "hello.txt") |> read_all_text
  (first = Ok (), second <> Ok (), read) |> _assert_eq (!+, !+, "through the junction")
  """,
  timeout: 300_000
)
```

#### file_read_only_round_trips (test)

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":"///- --test --symbol\n///> rust -d sha2 regex\n\n:= test_dir = get_workspace_root () </> \"target/test/file_system/read_only\"\ntest_dir |> create_dir |> ignore\n:= path = test_dir </> \"blob.txt\"\n? path |> file_exists ?> file_set_read_only !- path |> ignore\n\"blob\" |> write_all_text path\n:= before = file_is_read_only path\n:= locked = file_set_read_only !+ path\n:= after = file_is_read_only path\n:= unlocked = file_set_read_only !- path\n(before, locked, after, unlocked, file_is_read_only path) |> _assert_eq (!-, !+, !+, !+, !-)","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  ///- --test --symbol
  ///> rust -d sha2 regex

  := test_dir = get_workspace_root () </> "target/test/file_system/read_only"
  test_dir |> create_dir |> ignore
  := path = test_dir </> "blob.txt"
  ? path |> file_exists ?> file_set_read_only !- path |> ignore
  "blob" |> write_all_text path
  := before = file_is_read_only path
  := locked = file_set_read_only !+ path
  := after = file_is_read_only path
  := unlocked = file_set_read_only !- path
  (before, locked, after, unlocked, file_is_read_only path) |> _assert_eq (!-, !+, !+, !+, !-)
  """,
  timeout: 300_000
)
```

## rust

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":":~ file_exists_content path content : bool =\n    run_target \\|\n        | Rust => \\ () =>\n            ? path |> file_exists |> not\n            ?> !-\n            |:\n                := existing_content = path |> read_all_text\n                content = existing_content\n        | _ => \\ () => null ()\n\n:~ write_all_text_exists path contents =\n    := exists' = contents |> file_exists_content path\n    ? not exists' ?>\n        := dir = path |> directory_get_parent |> optionm'::default_value' \"\"\n        ? dir |> directory_exists |> not\n        ?> dir |> create_dir |> ignore\n        contents |> write_all_text path","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  :~ file_exists_content path content : bool =
      run_target \|
          | Rust => \ () =>
              ? path |> file_exists |> not
              ?> !-
              |:
                  := existing_content = path |> read_all_text
                  content = existing_content
          | _ => \ () => null ()

  :~ write_all_text_exists path contents =
      := exists' = contents |> file_exists_content path
      ? not exists' ?>
          := dir = path |> directory_get_parent |> optionm'::default_value' ""
          ? dir |> directory_exists |> not
          ?> dir |> create_dir |> ignore
          contents |> write_all_text path
  """,
  timeout: 300_000
)
```

## main

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":"///> fsharp\n\n:= main () =\n    init_trace_state None\n    $'let file_exists_content x = !file_exists_content x' : ()\n    $'let write_all_text_async x = !write_all_text_async x' : ()\n    $'let create_temp_path () = !create_temp_path ()' : ()\n    $'let create_temp_dir () = !create_temp_directory ()' : ()\n    $'let create_temp_dir\\' x = !create_temp_directory' x' : ()\n    $'let get_source_directory () = !get_source_directory ()' : ()\n    $'let normalize_path x = !normalize_path x' : ()\n    $'let get_full_path x = !get_full_path x' : ()\n    $'let standardize_path x = !standardize_path x' : ()\n    $'let new_file_uri x = !new_file_uri x' : ()\n    $'let get_workspace_root () = !get_workspace_root ()' : ()\n    $'let link_directory x = !link_directory x' : ()\n    := combine x = (</>) x\n    $'let (</>) x = !combine x' : ()\n\n:= remove_dir_all (path : string) : resultm::result' () stream::io_error =\n    ? delete_target_is_protected path\n    ?> \"file_system.remove_dir_all: refusing a drive root, profile, temp root or system folder: \" ++# path |> failwith\n    !\\\\(path, $'\"std::fs::remove_dir_all(&*$0)\"')\n\n:= copy_file (to : string) (path : string) : resultm::result' u64 stream::io_error =\n    !\\($'\"std::fs::copy(&*!path, &*!to)\"')\n\n:= canonicalize (path : string) : resultm::result' path_buf stream::io_error =\n    !\\\\(path, $'\"std::fs::canonicalize(&*$0)\"')\n\n:= set_current_dir (path : string) : resultm::result' () stream::io_error =\n    !\\\\(path, $'\"std::env::set_current_dir(&*$0)\"')\n\n:= get_current_dir () : resultm::result' path_buf stream::io_error =\n    !\\($'\"std::env::current_dir()\"')\n\n:= path_join_native (dir : string) (name : string) : string =\n    run_target_args' (dir, name) \\|\n        | Rust => \\ dir, name =>\n            := joined : sm'.std_string = !\\\\((dir, name), $'\"std::path::Path::new(&*$0).join(&*$1).display().to_string\\\n                ()\"')\n            sm'::from_std_string joined\n        | Fsharp => \\ dir, name => $'System.IO.Path.Combine (!dir, !name)' : string\n        | _ => \\ dir, name => dir </> name","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  ///> fsharp

  := main () =
      init_trace_state None
      $'let file_exists_content x = !file_exists_content x' : ()
      $'let write_all_text_async x = !write_all_text_async x' : ()
      $'let create_temp_path () = !create_temp_path ()' : ()
      $'let create_temp_dir () = !create_temp_directory ()' : ()
      $'let create_temp_dir\' x = !create_temp_directory' x' : ()
      $'let get_source_directory () = !get_source_directory ()' : ()
      $'let normalize_path x = !normalize_path x' : ()
      $'let get_full_path x = !get_full_path x' : ()
      $'let standardize_path x = !standardize_path x' : ()
      $'let new_file_uri x = !new_file_uri x' : ()
      $'let get_workspace_root () = !get_workspace_root ()' : ()
      $'let link_directory x = !link_directory x' : ()
      := combine x = (</>) x
      $'let (</>) x = !combine x' : ()

  := remove_dir_all (path : string) : resultm::result' () stream::io_error =
      ? delete_target_is_protected path
      ?> "file_system.remove_dir_all: refusing a drive root, profile, temp root or system folder: " ++# path |> failwith
      !\\(path, $'"std::fs::remove_dir_all(&*$0)"')

  := copy_file (to : string) (path : string) : resultm::result' u64 stream::io_error =
      !\($'"std::fs::copy(&*!path, &*!to)"')

  := canonicalize (path : string) : resultm::result' path_buf stream::io_error =
      !\\(path, $'"std::fs::canonicalize(&*$0)"')

  := set_current_dir (path : string) : resultm::result' () stream::io_error =
      !\\(path, $'"std::env::set_current_dir(&*$0)"')

  := get_current_dir () : resultm::result' path_buf stream::io_error =
      !\($'"std::env::current_dir()"')

  := path_join_native (dir : string) (name : string) : string =
      run_target_args' (dir, name) \|
          | Rust => \ dir, name =>
              := joined : sm'.std_string = !\\((dir, name), $'"std::path::Path::new(&*$0).join(&*$1).display().to_string\
                  ()"')
              sm'::from_std_string joined
          | Fsharp => \ dir, name => $'System.IO.Path.Combine (!dir, !name)' : string
          | _ => \ dir, name => dir </> name
  """,
  timeout: 300_000
)
```

