<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":":~ create_temp_path () =\n    run_target \\|\n        | _ => \\ () =>\n            date_time::now ()\n            |> date_time::new_guid_from_date_time\n            |> create_temp_path'\n\n:~ file_copy (new_path : string) (old_path : string) : () =\n    run_target_args' (old_path, new_path) \\|\n        | Fsharp => \\ old_path, new_path =>\n            $'System.IO.File.Copy (!old_path, !new_path, true)'\n        | Rust => \\ old_path, new_path =>\n            := result : _ _ stream::io_error = !\\\\((old_path, new_path), $'\"std::fs::copy(&*$0, &*$1)\"')\n            ?= result |> resultm::map_error' sm'::format' |> resultm::unbox ?|\n            | Ok (result : u64) =>\n                trace Debug\n                    \\ () => \"file_system.file_copy\"\n                    \\ () => { old_path new_path result }\n            | Error error =>\n                trace Warning\n                    \\ () => \"file_system.file_copy\"\n                    \\ () => { old_path new_path error }\n        | _ => \\ _ => ()\n\n:= file_system_gleam_files () =\n    global \"import gleam/bit_array\"\n    global \"import gleam/dynamic.{type Dynamic}\"\n    global \"import gleam/erlang/atom\"\n    global \"\"\"\n        @external(erlang, \"file\", \"read_file\")\n        fn spiral_fs_read_file(path: String) -> Result(BitArray, Dynamic)\n\n        @external(erlang, \"file\", \"write_file\")\n        fn spiral_fs_write_file(path: String, data: String) -> Dynamic\n\n        @external(erlang, \"filelib\", \"is_regular\")\n        fn spiral_fs_is_regular(path: String) -> Bool\n\n        @external(erlang, \"gleam_stdlib\", \"identity\")\n        fn spiral_fs_coerce(value: a) -> b\n\n        \"\"\"\n\n:! gleam_bytes = $'BitArray'\n\n:= gleam_read_text (path : string) : string =\n    file_system_gleam_files ()\n    ?= ($'spiral_fs_read_file(!path)' : resultm::result' gleam_bytes gleam_dynamic) |> resultm::unbox ?|\n    | Ok bytes =>\n        ?= ($'bit_array.to_string(!bytes)' : resultm::result' string ()) |> resultm::unbox ?|\n        | Ok text => text\n        | Error _ => failwith \"file_system.read_all_text: the file is not UTF-8\"\n    | Error _ => failwith \"file_system.read_all_text: file:read_file failed\"\n\n:= gleam_write_text (path : string) (text : string) : () =\n    file_system_gleam_files ()\n    := raw : gleam_dynamic = $'spiral_fs_write_file(!path, !text)'\n    := written : gleam_atom = $'spiral_fs_coerce(!raw)'\n    ? gleam_atoms_equal written (gleam_atom_named \"ok\") |> not\n    ?> failwith \"file_system.write_all_text: the write failed\"\n\n:! lua_file = $'any'\n\n:= lua_file_open (path : string) (mode : string) : lua_file = $'io.open(!path, !mode)' : lua_file\n\n:= lua_file_present (file : lua_file) : bool = $'(!file) ~= nil' : bool\n\n:= lua_file_write (file : lua_file) (text : string) : () = $'(!file):write(!text)' : ()\n\n:= lua_file_read_all (file : lua_file) : string = $'(!file):read(\"*a\")' : string\n\n:= lua_file_close (file : lua_file) : () = $'(!file):close()' : ()\n\n:= lua_file_remove (path : string) : () = $'os.remove(!path)' : ()\n\n:~ file_exists (path : string) : bool =\n    run_target_args' path \\|\n        | Zig => \\ _ =>\n            global \"var spiral_io_threaded: std.Io.Threaded = .init_single_threaded;\"\n            $'(if (std.Io.Dir.cwd().statFile(spiral_io_threaded.io(), !path, .{})) |s| s.kind == .file else |_| false)' : bool\n        | Fsharp => \\ path =>\n            path |> $'System.IO.File.Exists'\n        | Rust => \\ path =>\n            := path_buf = path |> sm'::to_std_string |> new_path_buf\n            path_buf_exists path_buf && path_buf_is_file path_buf\n        | Gleam => \\ path =>\n            file_system_gleam_files ()\n            $'spiral_fs_is_regular(!path)' : bool\n        | TypeScript => \\ path =>\n            global \"import * as spiral_node_fs from 'node:fs';\"\n            $'(spiral_node_fs.existsSync(!path) && spiral_node_fs.statSync(!path).isFile())' : bool\n        | Gleam _ => \\ path =>\n            global \"\"\"\n                @external(erlang, \"filelib\", \"is_regular\")\n                fn spiral_filelib_is_regular(path: String) -> Bool\n                \"\"\"\n            $'spiral_filelib_is_regular(!path)' : bool\n        | Lua => \\ path =>\n            := file = lua_file_open path \"r\"\n            ? lua_file_present file ?>\n                lua_file_close file\n                !+\n            |: !-\n        | Pascal => \\ path => $'FileExists(!path)' : bool\n        | _ => \\ _ => null ()\n\n:= write_all_text (path : string) (text : string) : () =\n    run_target_args' (path, text) \\|\n        | Zig => \\ _ =>\n            global \"var spiral_io_threaded: std.Io.Threaded = .init_single_threaded;\"\n            $'std.Io.Dir.cwd().writeFile(spiral_io_threaded.io(), .{ .sub_path = !path, .data = !text }) catch \\\n                \\@panic(\"file_system.write_all_text failed\")' : ()\n        | Fsharp => \\ path, text =>\n            $'System.IO.File.WriteAllText (!path, !text)'\n        | Rust => \\ path, text =>\n            !\\\\((path, text), $'\"std::fs::write(&*$0, &*$1).unwrap()\"')\n        | Gleam => \\ path, text =>\n            file_system_gleam_files ()\n            gleam_write_text path text\n        | Lua => \\ path, text =>\n            := file = lua_file_open path \"w\"\n            lua_file_write file text\n            lua_file_close file\n        | Pascal => \\ path, text =>\n            := handle = $'FileCreate(!path)' : i64\n            ? handle = -1i64 ?> failwith \"file_system.write_all_text / cannot create the file\"\n            := length = sm'::length text\n            ? length > 0i32 ?>\n                := first = 1i32\n                := written = $'FileWrite(!handle, (!text)[!first], !length)' : i32\n                ? written <> length ?> failwith \"file_system.write_all_text / short write\"\n            $'FileClose(!handle)' : ()\n        | _ => \\ _ => ()\n\n:= read_all_bytes (path : string) : am'::vec u8 =\n    run_target \\|\n        | Fsharp => \\ () =>\n            $'!path |> System.IO.File.ReadAllBytes'\n            |> am'::to_vec\n        | Rust => \\ () =>\n            path |> read |> resultm::unwrap'\n        | _ => \\ () => null ()\n\n:= c_read_file_global () : () =\n    global \"#include <stdint.h>\"\n    global \"#include <stdio.h>\"\n    global (\n        \"static long spiral_read_file(const char * path, uint8_t * dst, long cap) { FILE * f = fopen(path, \\\"rb\\\"); \"\n        ^^ \"if (!f) return -1; if (!dst) { fseek(f, 0, SEEK_END); long n = ftell(f); fclose(f); return n; } \"\n        ^^ \"long n = (long)fread(dst, 1, (size_t)cap, f); fclose(f); return n; }\"\n    )\n\n:= c_read_bytes (path : string) : array u8 =\n    c_read_file_global ()\n    := size : i32 = $'(int32_t)spiral_read_file(!path->ptr, NULL, 0)' : i32\n    ? size < 0 ?> failwith \"file_system.read_bytes / cannot open the file\"\n    := bytes : array u8 = create size\n    := read : i32 = $'(int32_t)spiral_read_file(!path->ptr, !bytes->ptr, !bytes->len)' : i32\n    ? read <> size ?> failwith \"file_system.read_bytes / short read\"\n    bytes\n\n:= zig_io () : () = global \"var spiral_io_threaded: std.Io.Threaded = .init_single_threaded;\"\n\n:= zig_read_bytes (path : string) : array u8 =\n    zig_io ()\n    $'(std.Io.Dir.cwd().readFileAlloc(spiral_io_threaded.io(), !path, spiral_gpa, .unlimited) catch \\\n        \\@panic(\"file_system.read_bytes failed\"))' : array u8\n\n:= read_bytes (path : string) : array u8 =\n    run_target \\|\n        | C => \\ () => c_read_bytes path\n        | Zig => \\ () => zig_read_bytes path\n        | _ => \\ () => am'::from_vec (read_all_bytes path)","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ":~ create_temp_path () =\n    run_target \\|\n        | _ => \\ () =>\n            date_time::now ()\n            |> date_time::new_guid_from_date_time\n            |> create_temp_path'\n\n:~ file_copy (new_path : string) (old_path : string) : () =\n    run_target_args' (old_path, new_path) \\|\n        | Fsharp => \\ old_path, new_path =>\n            $'System.IO.File.Copy (!old_path, !new_path, true)'\n        | Rust => \\ old_path, new_path =>\n            := result : _ _ stream::io_error = !\\\\((old_path, new_path), $'\"std::fs::copy(&*$0, &*$1)\"')\n            ?= result |> resultm::map_error' sm'::format' |> resultm::unbox ?|\n            | Ok (result : u64) =>\n                trace Debug\n                    \\ () => \"file_system.file_copy\"\n                    \\ () => { old_path new_path result }\n            | Error error =>\n                trace Warning\n                    \\ () => \"file_system.file_copy\"\n                    \\ () => { old_path new_path error }\n        | _ => \\ _ => ()\n\n:= file_system_gleam_files () =\n    global \"import gleam/bit_array\"\n    global \"import gleam/dynamic.{type Dynamic}\"\n    global \"import gleam/erlang/atom\"\n    global \"\"\"\n        @external(erlang, \"file\", \"read_file\")\n        fn spiral_fs_read_file(path: String) -> Result(BitArray, Dynamic)\n\n        @external(erlang, \"file\", \"write_file\")\n        fn spiral_fs_write_file(path: String, data: String) -> Dynamic\n\n        @external(erlang, \"filelib\", \"is_regular\")\n        fn spiral_fs_is_regular(path: String) -> Bool\n\n        @external(erlang, \"gleam_stdlib\", \"identity\")\n        fn spiral_fs_coerce(value: a) -> b\n\n        \"\"\"\n\n:! gleam_bytes = $'BitArray'\n\n:= gleam_read_text (path : string) : string =\n    file_system_gleam_files ()\n    ?= ($'spiral_fs_read_file(!path)' : resultm::result' gleam_bytes gleam_dynamic) |> resultm::unbox ?|\n    | Ok bytes =>\n        ?= ($'bit_array.to_string(!bytes)' : resultm::result' string ()) |> resultm::unbox ?|\n        | Ok text => text\n        | Error _ => failwith \"file_system.read_all_text: the file is not UTF-8\"\n    | Error _ => failwith \"file_system.read_all_text: file:read_file failed\"\n\n:= gleam_write_text (path : string) (text : string) : () =\n    file_system_gleam_files ()\n    := raw : gleam_dynamic = $'spiral_fs_write_file(!path, !text)'\n    := written : gleam_atom = $'spiral_fs_coerce(!raw)'\n    ? gleam_atoms_equal written (gleam_atom_named \"ok\") |> not\n    ?> failwith \"file_system.write_all_text: the write failed\"\n\n:! lua_file = $'any'\n\n:= lua_file_open (path : string) (mode : string) : lua_file = $'io.open(!path, !mode)' : lua_file\n\n:= lua_file_present (file : lua_file) : bool = $'(!file) ~= nil' : bool\n\n:= lua_file_write (file : lua_file) (text : string) : () = $'(!file):write(!text)' : ()\n\n:= lua_file_read_all (file : lua_file) : string = $'(!file):read(\"*a\")' : string\n\n:= lua_file_close (file : lua_file) : () = $'(!file):close()' : ()\n\n:= lua_file_remove (path : string) : () = $'os.remove(!path)' : ()\n\n:~ file_exists (path : string) : bool =\n    run_target_args' path \\|\n        | Zig => \\ _ =>\n            global \"var spiral_io_threaded: std.Io.Threaded = .init_single_threaded;\"\n            $'(if (std.Io.Dir.cwd().statFile(spiral_io_threaded.io(), !path, .{})) |s| s.kind == .file else |_| false)' : bool\n        | Fsharp => \\ path =>\n            path |> $'System.IO.File.Exists'\n        | Rust => \\ path =>\n            := path_buf = path |> sm'::to_std_string |> new_path_buf\n            path_buf_exists path_buf && path_buf_is_file path_buf\n        | Gleam => \\ path =>\n            file_system_gleam_files ()\n            $'spiral_fs_is_regular(!path)' : bool\n        | TypeScript => \\ path =>\n            global \"import * as spiral_node_fs from 'node:fs';\"\n            $'(spiral_node_fs.existsSync(!path) && spiral_node_fs.statSync(!path).isFile())' : bool\n        | Gleam _ => \\ path =>\n            global \"\"\"\n                @external(erlang, \"filelib\", \"is_regular\")\n                fn spiral_filelib_is_regular(path: String) -> Bool\n                \"\"\"\n            $'spiral_filelib_is_regular(!path)' : bool\n        | Lua => \\ path =>\n            := file = lua_file_open path \"r\"\n            ? lua_file_present file ?>\n                lua_file_close file\n                !+\n            |: !-\n        | Pascal => \\ path => $'FileExists(!path)' : bool\n        | _ => \\ _ => null ()\n\n:= write_all_text (path : string) (text : string) : () =\n    run_target_args' (path, text) \\|\n        | Zig => \\ _ =>\n            global \"var spiral_io_threaded: std.Io.Threaded = .init_single_threaded;\"\n            $'std.Io.Dir.cwd().writeFile(spiral_io_threaded.io(), .{ .sub_path = !path, .data = !text }) catch \\\n                \\@panic(\"file_system.write_all_text failed\")' : ()\n        | Fsharp => \\ path, text =>\n            $'System.IO.File.WriteAllText (!path, !text)'\n        | Rust => \\ path, text =>\n            !\\\\((path, text), $'\"std::fs::write(&*$0, &*$1).unwrap()\"')\n        | Gleam => \\ path, text =>\n            file_system_gleam_files ()\n            gleam_write_text path text\n        | Lua => \\ path, text =>\n            := file = lua_file_open path \"w\"\n            lua_file_write file text\n            lua_file_close file\n        | Pascal => \\ path, text =>\n            := handle = $'FileCreate(!path)' : i64\n            ? handle = -1i64 ?> failwith \"file_system.write_all_text / cannot create the file\"\n            := length = sm'::length text\n            ? length > 0i32 ?>\n                := first = 1i32\n                := written = $'FileWrite(!handle, (!text)[!first], !length)' : i32\n                ? written <> length ?> failwith \"file_system.write_all_text / short write\"\n            $'FileClose(!handle)' : ()\n        | _ => \\ _ => ()\n\n:= read_all_bytes (path : string) : am'::vec u8 =\n    run_target \\|\n        | Fsharp => \\ () =>\n            $'!path |> System.IO.File.ReadAllBytes'\n            |> am'::to_vec\n        | Rust => \\ () =>\n            path |> read |> resultm::unwrap'\n        | _ => \\ () => null ()\n\n:= c_read_file_global () : () =\n    global \"#include <stdint.h>\"\n    global \"#include <stdio.h>\"\n    global (\n        \"static long spiral_read_file(const char * path, uint8_t * dst, long cap) { FILE * f = fopen(path, \\\"rb\\\"); \"\n        ^^ \"if (!f) return -1; if (!dst) { fseek(f, 0, SEEK_END); long n = ftell(f); fclose(f); return n; } \"\n        ^^ \"long n = (long)fread(dst, 1, (size_t)cap, f); fclose(f); return n; }\"\n    )\n\n:= c_read_bytes (path : string) : array u8 =\n    c_read_file_global ()\n    := size : i32 = $'(int32_t)spiral_read_file(!path->ptr, NULL, 0)' : i32\n    ? size < 0 ?> failwith \"file_system.read_bytes / cannot open the file\"\n    := bytes : array u8 = create size\n    := read : i32 = $'(int32_t)spiral_read_file(!path->ptr, !bytes->ptr, !bytes->len)' : i32\n    ? read <> size ?> failwith \"file_system.read_bytes / short read\"\n    bytes\n\n:= zig_io () : () = global \"var spiral_io_threaded: std.Io.Threaded = .init_single_threaded;\"\n\n:= zig_read_bytes (path : string) : array u8 =\n    zig_io ()\n    $'(std.Io.Dir.cwd().readFileAlloc(spiral_io_threaded.io(), !path, spiral_gpa, .unlimited) catch \\\n        \\@panic(\"file_system.read_bytes failed\"))' : array u8\n\n:= read_bytes (path : string) : array u8 =\n    run_target \\|\n        | C => \\ () => c_read_bytes path\n        | Zig => \\ () => zig_read_bytes path\n        | _ => \\ () => am'::from_vec (read_all_bytes path)",
  timeout: 300_000
)
```

#### read_bytes_reads_a_file_on_c (test)

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":"///- --test --symbol\n///> c\n\n:= ~path = get_temp_path () ++# \"/spiral_read_bytes_c.bin\"\n$'{ FILE * f = fopen(!path->ptr, \"wb\"); fputs(\"AB\", f); fclose(f); }' : ()\n:= b = read_bytes path\n(length b, index b 0, index b 1) |> _assert_eq (2i32, 65u8, 66u8)","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  ///- --test --symbol
  ///> c

  := ~path = get_temp_path () ++# "/spiral_read_bytes_c.bin"
  $'{ FILE * f = fopen(!path->ptr, "wb"); fputs("AB", f); fclose(f); }' : ()
  := b = read_bytes path
  (length b, index b 0, index b 1) |> _assert_eq (2i32, 65u8, 66u8)
  """,
  timeout: 300_000
)
```

#### read_bytes_reads_a_written_text_file (test)

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":"///- --test --symbol\n///> rust\n///> zig\n\n:= ~path = get_temp_path () ++# \"/spiral_read_bytes_text.bin\"\nwrite_all_text path \"AB\"\n:= b = read_bytes path\n(length b, index b 0, index b 1) |> _assert_eq (2i32, 65u8, 66u8)","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  ///- --test --symbol
  ///> rust
  ///> zig

  := ~path = get_temp_path () ++# "/spiral_read_bytes_text.bin"
  write_all_text path "AB"
  := b = read_bytes path
  (length b, index b 0, index b 1) |> _assert_eq (2i32, 65u8, 66u8)
  """,
  timeout: 300_000
)
```

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":":= c_stdio () : () = global \"#include <stdio.h>\"\n\n:= c_open_at () : () =\n    c_stdio ()\n    global (\n        \"static FILE * spiral_open_at(const char * p, long at) { FILE * f = fopen(p, \\\"rb\\\"); \"\n        ^^ \"if (f && fseek(f, at, SEEK_SET)) { fclose(f); f = NULL; } return f; }\"\n    )\n\n:= c_read_open () : () =\n    c_stdio ()\n    global (\n        \"static long spiral_read_open(FILE * f, void * d, long n) { \"\n        ^^ \"long r = f ? (long)fread(d, 1, (size_t)n, f) : -1; if (f) fclose(f); return r; }\"\n    )\n\n:= c_read_region_global () : () =\n    c_open_at ()\n    c_read_open ()\n    global (\n        \"static long spiral_read_region(const char * p, long at, void * d, long n) { \"\n        ^^ \"return spiral_read_open(spiral_open_at(p, at), d, n); }\"\n    )\n\n:= c_read_region \\* el. (path : string) (at : i32) (out : array el) (bytes : i32) : i32 =\n    c_read_region_global ()\n    $'(int32_t)spiral_read_region(!path->ptr, !at, !out->ptr, !bytes)' : i32\n\n:= c_read_into \\* el. (path : string) (at : i32) (out : array el) (size : i32) : array el =\n    := bytes = size * length out\n    ? c_read_region path at out bytes <> bytes ?> failwith \"file_system.read_region / short read\"\n    out\n\n:~ ^ copy_prefix_from (b : array u8) (out : array u8) (i : i32) : () =\n    ? i < length out ?>\n        set out i (index b i)\n        copy_prefix_from b out (i + 1)\n\n:= read_prefix (path : string) (count : i32) : array u8 =\n    := out : array u8 = create count\n    run_target \\|\n        | C => \\ () => c_read_into path 0 out 1\n        | _ => \\ () =>\n            copy_prefix_from (read_bytes path) out 0\n            out\n\n:= u32_le_at (b : array u8) (at : i32) : u32 =\n    := byte (k : i32) : u32 = conv (index b (at + k))\n    byte 0 ||| (byte 1 <<< 8) ||| (byte 2 <<< 16) ||| (byte 3 <<< 24)\n\n:~ ^ f32s_from (b : array u8) (out : array f32) (offset : i32) (i : i32) : () =\n    ? i < length out ?>\n        set out i (convert::f32_of_bits (u32_le_at b (offset + 4 * i)))\n        f32s_from b out offset (i + 1)\n\n:= read_f32s (path : string) (at : i32) (count : i32) : array f32 =\n    := out : array f32 = create count\n    run_target \\|\n        | C => \\ () => c_read_into path at out 4\n        | _ => \\ () =>\n            f32s_from (read_bytes path) out at 0\n            out\n\n:= c_map_includes () : () =\n    global \"#include <stdint.h>\"\n    global (\n        \"#ifdef _WIN32\\n#include <windows.h>\\n#else\\n#include <sys/mman.h>\\n\"\n        ^^ \"#include <fcntl.h>\\n#include <unistd.h>\\n#endif\"\n    )\n\n:= c_open_win () : () =\n    global (\n        \"#ifdef _WIN32\\nstatic HANDLE spiral_open_win(const char * p) { \"\n        ^^ \"return CreateFileA(p, GENERIC_READ, FILE_SHARE_READ, NULL, OPEN_EXISTING, 0, NULL); }\\n#endif\"\n    )\n\n:= c_sized_win () : () =\n    global (\n        \"#ifdef _WIN32\\nstatic HANDLE spiral_sized_win(const char * p, long * n) { HANDLE f = spiral_open_win(p); \"\n        ^^ \"LARGE_INTEGER s; *n = GetFileSizeEx(f, &s) ? (long)s.QuadPart : -1; return f; }\\n#endif\"\n    )\n\n:= c_mapping_win () : () =\n    global (\n        \"#ifdef _WIN32\\nstatic HANDLE spiral_mapping_win(HANDLE f, long n) { HANDLE m = n < 0 ? NULL : \"\n        ^^ \"CreateFileMappingA(f, NULL, PAGE_WRITECOPY, 0, 0, NULL); CloseHandle(f); return m; }\\n#endif\"\n    )\n\n:= c_view_win () : () =\n    global (\n        \"#ifdef _WIN32\\nstatic char * spiral_view_win(HANDLE m) { \"\n        ^^ \"char * r = m ? (char *)MapViewOfFile(m, FILE_MAP_COPY, 0, 0, 0) : NULL; \"\n        ^^ \"if (m) CloseHandle(m); return r; }\\n#endif\"\n    )\n\n:= c_map_private_win () : () =\n    global (\n        \"#ifdef _WIN32\\nstatic char * spiral_map_private(const char * p, long * n) { \"\n        ^^ \"HANDLE f = spiral_sized_win(p, n); return spiral_view_win(spiral_mapping_win(f, *n)); }\\n#endif\"\n    )\n\n:= c_open_sized () : () =\n    global (\n        \"#ifndef _WIN32\\nstatic int spiral_open_sized(const char * p, long * n) { int fd = open(p, O_RDONLY); \"\n        ^^ \"if (fd >= 0) *n = (long)lseek(fd, 0, SEEK_END); return fd; }\\n#endif\"\n    )\n\n:= c_mmap () : () =\n    global (\n        \"#ifndef _WIN32\\nstatic char * spiral_mmap(int fd, long n) { void * r = mmap(NULL, n, PROT_READ | PROT_WRITE, \"\n        ^^ \"MAP_PRIVATE, fd, 0); close(fd); return r == MAP_FAILED ? NULL : (char *)r; }\\n#endif\"\n    )\n\n:= c_map_private_posix () : () =\n    global (\n        \"#ifndef _WIN32\\nstatic char * spiral_map_private(const char * p, long * n) { \"\n        ^^ \"int fd = spiral_open_sized(p, n); return fd < 0 ? NULL : spiral_mmap(fd, *n); }\\n#endif\"\n    )\n\n:= c_map_private_global () : () =\n    c_map_includes ()\n    c_open_win ()\n    c_sized_win ()\n    c_mapping_win ()\n    c_view_win ()\n    c_map_private_win ()\n    c_open_sized ()\n    c_mmap ()\n    c_map_private_posix ()\n\n:= c_pin_header () : () =\n    global (\n        \"static void * spiral_pin_header(char * h, long count) { \"\n        ^^ \"((int32_t *)h)[0] = 1 << 30; ((uint32_t *)h)[1] = (uint32_t)count; return h; }\"\n    )\n\n:= c_view_f32s () : () =\n    c_pin_header ()\n    global (\n        \"static void * spiral_view_f32s(char * m, long n, long at, long count) { \"\n        ^^ \"return !m || at < 8 || (at - 8) % 4 || at + 4 * count > n ? NULL : spiral_pin_header(m + at - 8, count); }\"\n    )\n\n:= c_map_f32s_global () : () =\n    global (\n        \"__attribute__((noinline)) static void * spiral_map_f32s(const char * p, long at, long count) { \"\n        ^^ \"long n = 0; char * m = spiral_map_private(p, &n); return spiral_view_f32s(m, n, at, count); }\"\n    )\n\n:= c_map_global () : () =\n    c_map_private_global ()\n    c_view_f32s ()\n    c_map_f32s_global ()\n\n:= c_map_header (path : string) (at : i32) (count : i32) : u64 =\n    c_map_global ()\n    := h : u64 = $'(uint64_t)(uintptr_t)spiral_map_f32s(!path->ptr, !at, !count)' : u64\n    ? h = 0u64 ?> failwith \"file_system.map_f32s / cannot map that range\"\n    h\n\n:= c_map_f32s (path : string) (at : i32) (count : i32) : array f32 =\n    := shape : array f32 = create 0\n    := h = c_map_header path at count\n    $'(__typeof__(!shape))(uintptr_t)!h' : array f32\n\n:= map_f32s (path : string) (offset : i32) (count : i32) : array f32 =\n    run_target \\|\n        | C => \\ () => c_map_f32s path offset count\n        | _ => \\ () => read_f32s path offset count\n\n:= c_write_bytes_global () : () =\n    c_stdio ()\n    global (\n        \"static void spiral_write_bytes(const char * p, const void * b, long n) { \"\n        ^^ \"FILE * f = fopen(p, \\\"wb\\\"); fwrite(b, 1, (size_t)n, f); fclose(f); }\"\n    )\n\n:= c_write_bytes (path : string) (b : array u8) : () =\n    c_write_bytes_global ()\n    $'spiral_write_bytes(!path->ptr, !b->ptr, !b->len)' : ()\n\n:= rust_write_bytes (path : string) (b : array u8) : () =\n    := v = b |> am'::base |> am'::to_vec\n    $'std::fs::write(&*!path, &*!v).unwrap()' : ()\n\n:= zig_write_bytes (path : string) (b : array u8) : () =\n    zig_io ()\n    $'std.Io.Dir.cwd().writeFile(spiral_io_threaded.io(), .{ .sub_path = !path, .data = !b }) catch \\\n        \\@panic(\"file_system.write_bytes failed\")' : ()\n\n:= fallback_write_bytes (path : string) (b : array u8) : () =\n    run_target \\|\n        | Zig => \\ () => zig_write_bytes path b\n        | _ => \\ () => failwith \"file_system.write_bytes / no arm for this backend\"\n\n:= write_bytes (path : string) (b : array u8) : () =\n    run_target \\|\n        | C => \\ () => c_write_bytes path b\n        | Rust => \\ () => rust_write_bytes path b\n        | _ => \\ () => fallback_write_bytes path b\n\n:= f32_bytes () : array u8 = ;[9u8; 9u8; 9u8; 9u8; 1u8; 0u8; 128u8; 63u8; 0u8; 0u8; 0u8; 192u8]\n\n:= map_bytes () : array u8 = ;[9u8; 9u8; 9u8; 9u8; 9u8; 9u8; 9u8; 9u8; 1u8; 0u8; 128u8; 63u8; 0u8; 0u8; 0u8; 192u8]","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  := c_stdio () : () = global "#include <stdio.h>"

  := c_open_at () : () =
      c_stdio ()
      global (
          "static FILE * spiral_open_at(const char * p, long at) { FILE * f = fopen(p, \"rb\"); "
          ^^ "if (f && fseek(f, at, SEEK_SET)) { fclose(f); f = NULL; } return f; }"
      )

  := c_read_open () : () =
      c_stdio ()
      global (
          "static long spiral_read_open(FILE * f, void * d, long n) { "
          ^^ "long r = f ? (long)fread(d, 1, (size_t)n, f) : -1; if (f) fclose(f); return r; }"
      )

  := c_read_region_global () : () =
      c_open_at ()
      c_read_open ()
      global (
          "static long spiral_read_region(const char * p, long at, void * d, long n) { "
          ^^ "return spiral_read_open(spiral_open_at(p, at), d, n); }"
      )

  := c_read_region \* el. (path : string) (at : i32) (out : array el) (bytes : i32) : i32 =
      c_read_region_global ()
      $'(int32_t)spiral_read_region(!path->ptr, !at, !out->ptr, !bytes)' : i32

  := c_read_into \* el. (path : string) (at : i32) (out : array el) (size : i32) : array el =
      := bytes = size * length out
      ? c_read_region path at out bytes <> bytes ?> failwith "file_system.read_region / short read"
      out

  :~ ^ copy_prefix_from (b : array u8) (out : array u8) (i : i32) : () =
      ? i < length out ?>
          set out i (index b i)
          copy_prefix_from b out (i + 1)

  := read_prefix (path : string) (count : i32) : array u8 =
      := out : array u8 = create count
      run_target \|
          | C => \ () => c_read_into path 0 out 1
          | _ => \ () =>
              copy_prefix_from (read_bytes path) out 0
              out

  := u32_le_at (b : array u8) (at : i32) : u32 =
      := byte (k : i32) : u32 = conv (index b (at + k))
      byte 0 ||| (byte 1 <<< 8) ||| (byte 2 <<< 16) ||| (byte 3 <<< 24)

  :~ ^ f32s_from (b : array u8) (out : array f32) (offset : i32) (i : i32) : () =
      ? i < length out ?>
          set out i (convert::f32_of_bits (u32_le_at b (offset + 4 * i)))
          f32s_from b out offset (i + 1)

  := read_f32s (path : string) (at : i32) (count : i32) : array f32 =
      := out : array f32 = create count
      run_target \|
          | C => \ () => c_read_into path at out 4
          | _ => \ () =>
              f32s_from (read_bytes path) out at 0
              out

  := c_map_includes () : () =
      global "#include <stdint.h>"
      global (
          "#ifdef _WIN32\n#include <windows.h>\n#else\n#include <sys/mman.h>\n"
          ^^ "#include <fcntl.h>\n#include <unistd.h>\n#endif"
      )

  := c_open_win () : () =
      global (
          "#ifdef _WIN32\nstatic HANDLE spiral_open_win(const char * p) { "
          ^^ "return CreateFileA(p, GENERIC_READ, FILE_SHARE_READ, NULL, OPEN_EXISTING, 0, NULL); }\n#endif"
      )

  := c_sized_win () : () =
      global (
          "#ifdef _WIN32\nstatic HANDLE spiral_sized_win(const char * p, long * n) { HANDLE f = spiral_open_win(p); "
          ^^ "LARGE_INTEGER s; *n = GetFileSizeEx(f, &s) ? (long)s.QuadPart : -1; return f; }\n#endif"
      )

  := c_mapping_win () : () =
      global (
          "#ifdef _WIN32\nstatic HANDLE spiral_mapping_win(HANDLE f, long n) { HANDLE m = n < 0 ? NULL : "
          ^^ "CreateFileMappingA(f, NULL, PAGE_WRITECOPY, 0, 0, NULL); CloseHandle(f); return m; }\n#endif"
      )

  := c_view_win () : () =
      global (
          "#ifdef _WIN32\nstatic char * spiral_view_win(HANDLE m) { "
          ^^ "char * r = m ? (char *)MapViewOfFile(m, FILE_MAP_COPY, 0, 0, 0) : NULL; "
          ^^ "if (m) CloseHandle(m); return r; }\n#endif"
      )

  := c_map_private_win () : () =
      global (
          "#ifdef _WIN32\nstatic char * spiral_map_private(const char * p, long * n) { "
          ^^ "HANDLE f = spiral_sized_win(p, n); return spiral_view_win(spiral_mapping_win(f, *n)); }\n#endif"
      )

  := c_open_sized () : () =
      global (
          "#ifndef _WIN32\nstatic int spiral_open_sized(const char * p, long * n) { int fd = open(p, O_RDONLY); "
          ^^ "if (fd >= 0) *n = (long)lseek(fd, 0, SEEK_END); return fd; }\n#endif"
      )

  := c_mmap () : () =
      global (
          "#ifndef _WIN32\nstatic char * spiral_mmap(int fd, long n) { void * r = mmap(NULL, n, PROT_READ | PROT_WRITE, "
          ^^ "MAP_PRIVATE, fd, 0); close(fd); return r == MAP_FAILED ? NULL : (char *)r; }\n#endif"
      )

  := c_map_private_posix () : () =
      global (
          "#ifndef _WIN32\nstatic char * spiral_map_private(const char * p, long * n) { "
          ^^ "int fd = spiral_open_sized(p, n); return fd < 0 ? NULL : spiral_mmap(fd, *n); }\n#endif"
      )

  := c_map_private_global () : () =
      c_map_includes ()
      c_open_win ()
      c_sized_win ()
      c_mapping_win ()
      c_view_win ()
      c_map_private_win ()
      c_open_sized ()
      c_mmap ()
      c_map_private_posix ()

  := c_pin_header () : () =
      global (
          "static void * spiral_pin_header(char * h, long count) { "
          ^^ "((int32_t *)h)[0] = 1 << 30; ((uint32_t *)h)[1] = (uint32_t)count; return h; }"
      )

  := c_view_f32s () : () =
      c_pin_header ()
      global (
          "static void * spiral_view_f32s(char * m, long n, long at, long count) { "
          ^^ "return !m || at < 8 || (at - 8) % 4 || at + 4 * count > n ? NULL : spiral_pin_header(m + at - 8, count); }"
      )

  := c_map_f32s_global () : () =
      global (
          "__attribute__((noinline)) static void * spiral_map_f32s(const char * p, long at, long count) { "
          ^^ "long n = 0; char * m = spiral_map_private(p, &n); return spiral_view_f32s(m, n, at, count); }"
      )

  := c_map_global () : () =
      c_map_private_global ()
      c_view_f32s ()
      c_map_f32s_global ()

  := c_map_header (path : string) (at : i32) (count : i32) : u64 =
      c_map_global ()
      := h : u64 = $'(uint64_t)(uintptr_t)spiral_map_f32s(!path->ptr, !at, !count)' : u64
      ? h = 0u64 ?> failwith "file_system.map_f32s / cannot map that range"
      h

  := c_map_f32s (path : string) (at : i32) (count : i32) : array f32 =
      := shape : array f32 = create 0
      := h = c_map_header path at count
      $'(__typeof__(!shape))(uintptr_t)!h' : array f32

  := map_f32s (path : string) (offset : i32) (count : i32) : array f32 =
      run_target \|
          | C => \ () => c_map_f32s path offset count
          | _ => \ () => read_f32s path offset count

  := c_write_bytes_global () : () =
      c_stdio ()
      global (
          "static void spiral_write_bytes(const char * p, const void * b, long n) { "
          ^^ "FILE * f = fopen(p, \"wb\"); fwrite(b, 1, (size_t)n, f); fclose(f); }"
      )

  := c_write_bytes (path : string) (b : array u8) : () =
      c_write_bytes_global ()
      $'spiral_write_bytes(!path->ptr, !b->ptr, !b->len)' : ()

  := rust_write_bytes (path : string) (b : array u8) : () =
      := v = b |> am'::base |> am'::to_vec
      $'std::fs::write(&*!path, &*!v).unwrap()' : ()

  := zig_write_bytes (path : string) (b : array u8) : () =
      zig_io ()
      $'std.Io.Dir.cwd().writeFile(spiral_io_threaded.io(), .{ .sub_path = !path, .data = !b }) catch \
          \@panic("file_system.write_bytes failed")' : ()

  := fallback_write_bytes (path : string) (b : array u8) : () =
      run_target \|
          | Zig => \ () => zig_write_bytes path b
          | _ => \ () => failwith "file_system.write_bytes / no arm for this backend"

  := write_bytes (path : string) (b : array u8) : () =
      run_target \|
          | C => \ () => c_write_bytes path b
          | Rust => \ () => rust_write_bytes path b
          | _ => \ () => fallback_write_bytes path b

  := f32_bytes () : array u8 = ;[9u8; 9u8; 9u8; 9u8; 1u8; 0u8; 128u8; 63u8; 0u8; 0u8; 0u8; 192u8]

  := map_bytes () : array u8 = ;[9u8; 9u8; 9u8; 9u8; 9u8; 9u8; 9u8; 9u8; 1u8; 0u8; 128u8; 63u8; 0u8; 0u8; 0u8; 192u8]
  """,
  timeout: 300_000
)
```

#### map_f32s_views_floats_after_an_8_byte_header (test)

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":"///- --test --symbol\n///> c\n///> rust\n///> zig\n\n:= ~path = get_temp_path () ++# \"/spiral_map_f32s.bin\"\nwrite_bytes path (map_bytes ())\n:= x = map_f32s path 8 2\n(length x, index x 0, index x 1) |> _assert_eq (2i32, 1.0000001f32, -2.0f32)","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  ///- --test --symbol
  ///> c
  ///> rust
  ///> zig

  := ~path = get_temp_path () ++# "/spiral_map_f32s.bin"
  write_bytes path (map_bytes ())
  := x = map_f32s path 8 2
  (length x, index x 0, index x 1) |> _assert_eq (2i32, 1.0000001f32, -2.0f32)
  """,
  timeout: 300_000
)
```

