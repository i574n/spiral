<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":"///- --test --symbol\n///> rust\n\n;[ Directory, \"workspace\"; File, \"README.md\" ]\n|> arraym::map \\ file_type, file =>\n    \\ () =>\n        ~~\n            get_current_directory ()\n            |> find_parent file_type file\n            |> resultm::get\n            |> sm'::to_std_string\n            |> new_path_buf\n            |> path_buf_file_name\n            |> optionm'::try'\n            |> sm'::from_os_str_ref\n            |> Some\n            |> optionm'::box\n    |> \\ x => x () |> optionm'::unbox\n    |> optionm'::default_value \"\"\n|> am'::distinct\n|> \\ result =>\n    result |> am'::length |> _assert_eq 1i32\n    index result 0i32 |> _assert_eq \"spiral\"","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  ///- --test --symbol
  ///> rust

  ;[ Directory, "workspace"; File, "README.md" ]
  |> arraym::map \ file_type, file =>
      \ () =>
          ~~
              get_current_directory ()
              |> find_parent file_type file
              |> resultm::get
              |> sm'::to_std_string
              |> new_path_buf
              |> path_buf_file_name
              |> optionm'::try'
              |> sm'::from_os_str_ref
              |> Some
              |> optionm'::box
      |> \ x => x () |> optionm'::unbox
      |> optionm'::default_value ""
  |> am'::distinct
  |> \ result =>
      result |> am'::length |> _assert_eq 1i32
      index result 0i32 |> _assert_eq "spiral"
  """,
  timeout: 300_000
)
```

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":":= file_delete (path : string) : () =\n    run_target \\|\n        | Zig => \\ () =>\n            global \"var spiral_io_threaded: std.Io.Threaded = .init_single_threaded;\"\n            $'std.Io.Dir.cwd().deleteFile(spiral_io_threaded.io(), !path) catch {}' : ()\n        | Fsharp => \\ () =>\n            path |> $'System.IO.File.Delete'\n        | Rust => \\ () =>\n            := result : resultm::result' () stream::io_error =\n                ? path |> file_exists\n                ?> !\\\\(path, $'\"std::fs::remove_file(&*$0)\"')\n                |: Ok () |> resultm::box\n            ?= result |> resultm::map_error' sm'::format |> resultm::unbox ?|\n            | Ok () => ()\n            | Error error' => console::write_error_line (sm'::(++#) \"file_system.file_delete: \" error')\n        | Gleam => \\ () =>\n            file_system_gleam_paths ()\n            $'spiral_fs_delete(!path)' : ()\n        | Lua => \\ () => lua_file_remove path\n        | _ => \\ () => ()\n\n:= written_then_deleted (path : string) : bool * bool =\n    write_all_text path \"x\"\n    := written = file_exists path\n    file_delete path\n    written, file_exists path","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  := file_delete (path : string) : () =
      run_target \|
          | Zig => \ () =>
              global "var spiral_io_threaded: std.Io.Threaded = .init_single_threaded;"
              $'std.Io.Dir.cwd().deleteFile(spiral_io_threaded.io(), !path) catch {}' : ()
          | Fsharp => \ () =>
              path |> $'System.IO.File.Delete'
          | Rust => \ () =>
              := result : resultm::result' () stream::io_error =
                  ? path |> file_exists
                  ?> !\\(path, $'"std::fs::remove_file(&*$0)"')
                  |: Ok () |> resultm::box
              ?= result |> resultm::map_error' sm'::format |> resultm::unbox ?|
              | Ok () => ()
              | Error error' => console::write_error_line (sm'::(++#) "file_system.file_delete: " error')
          | Gleam => \ () =>
              file_system_gleam_paths ()
              $'spiral_fs_delete(!path)' : ()
          | Lua => \ () => lua_file_remove path
          | _ => \ () => ()

  := written_then_deleted (path : string) : bool * bool =
      write_all_text path "x"
      := written = file_exists path
      file_delete path
      written, file_exists path
  """,
  timeout: 300_000
)
```

