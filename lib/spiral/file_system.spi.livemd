Spiral.Cells.eval!(
  ~S"""
  ///- --test --symbol
  ///> rust -d chrono

  := path, disposable = create_temp_directory ()
  ~~
      path
      |> directory_exists
      |> _assert_eq !+
      disposable |> use |> ignore
      path
      |> directory_exists
      |> _assert_eq !+
