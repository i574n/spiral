## file_system

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":":~ delete_comparable_path (path : string) : string =\n    path |> get_full_path |> sm'::replace \"\\\\\" \"/\" |> sm'::trim_end ['/'] |> sm'::to_lower\n\n:= delete_target_contains (target : string) (root : string) : bool =\n    root <> \"\" && (target = root || sm'::starts_with (target ++# \"/\") root)\n\n:~ delete_shape_protected (target : string) : bool =\n    := parts = sm'::split \"/\" target |> array\n    := count = am'::length parts\n    := part (at : i32) : string = ? at < count ?> am'::index at parts |: \"\"\n    := rooted_home = part 0i32 = \"\" && (count = 2i32 || (count = 3i32 && part 1i32 = \"home\"))\n    := app_data = part 3i32 = \"appdata\" && (count <= 5i32 || (count = 6i32 && part 4i32 = \"local\" && part 5i32 = \"temp\"))\n    := users = part 1i32 = \"users\" && (count <= 3i32 || app_data)\n    count <= 1i32 || rooted_home || users || (count = 2i32 && part 1i32 = \"windows\")\n\n:~ ^ delete_variable_protected (target : string) (names : list string) : bool =\n    ?= names ?|\n    | [] => !-\n    | name :: rest =>\n        := value = env::get_environment_variable name\n        ? value <> \"\" && delete_target_contains target (delete_comparable_path value) ?> !+\n        |: delete_variable_protected target rest\n\n:= delete_target_is_protected (path : string) : bool =\n    := variables = [\"USERPROFILE\"; \"HOME\"; \"TEMP\"; \"TMP\"; \"TMPDIR\"; \"LOCALAPPDATA\"; \"APPDATA\"; \"SystemRoot\"; \"ProgramData\"]\n    := target = delete_comparable_path path\n    path = \"\" || delete_shape_protected target || delete_variable_protected target variables","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  :~ delete_comparable_path (path : string) : string =
      path |> get_full_path |> sm'::replace "\\" "/" |> sm'::trim_end ['/'] |> sm'::to_lower

  := delete_target_contains (target : string) (root : string) : bool =
      root <> "" && (target = root || sm'::starts_with (target ++# "/") root)

  :~ delete_shape_protected (target : string) : bool =
      := parts = sm'::split "/" target |> array
      := count = am'::length parts
      := part (at : i32) : string = ? at < count ?> am'::index at parts |: ""
      := rooted_home = part 0i32 = "" && (count = 2i32 || (count = 3i32 && part 1i32 = "home"))
      := app_data = part 3i32 = "appdata" && (count <= 5i32 || (count = 6i32 && part 4i32 = "local" && part 5i32 = "temp"))
      := users = part 1i32 = "users" && (count <= 3i32 || app_data)
      count <= 1i32 || rooted_home || users || (count = 2i32 && part 1i32 = "windows")

  :~ ^ delete_variable_protected (target : string) (names : list string) : bool =
      ?= names ?|
      | [] => !-
      | name :: rest =>
          := value = env::get_environment_variable name
          ? value <> "" && delete_target_contains target (delete_comparable_path value) ?> !+
          |: delete_variable_protected target rest

  := delete_target_is_protected (path : string) : bool =
      := variables = ["USERPROFILE"; "HOME"; "TEMP"; "TMP"; "TMPDIR"; "LOCALAPPDATA"; "APPDATA"; "SystemRoot"; "ProgramData"]
      := target = delete_comparable_path path
      path = "" || delete_shape_protected target || delete_variable_protected target variables
  """,
  timeout: 300_000
)
```

