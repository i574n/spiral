<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":":~ directory_exists (path : string) : bool =\n    run_target_args' path \\|\n        | Zig => \\ _ =>\n            global \"var spiral_io_threaded: std.Io.Threaded = .init_single_threaded;\"\n            $'(if (std.Io.Dir.cwd().statFile(spiral_io_threaded.io(), !path, .{})) |s| s.kind == .directory else |_| \\\n                false)' : bool\n        | Fsharp => \\ path =>\n            path |> $'System.IO.Directory.Exists'\n        | Rust => \\ path =>\n            := path = path |> sm'::to_std_string |> new_path_buf\n            path_buf_exists path && path_buf_is_dir path\n        | TypeScript => \\ path =>\n            global \"import * as spiral_node_fs from 'node:fs';\"\n            $'(spiral_node_fs.existsSync(!path) && spiral_node_fs.statSync(!path).isDirectory())' : bool\n        | Gleam => \\ path =>\n            file_system_gleam_paths ()\n            $'spiral_fs_is_dir(!path)' : bool\n        | Pascal => \\ path => $'DirectoryExists(!path)' : bool\n        | _ => \\ _ => null ()\n\n:~ directory_get_parent (path : string) : optionm'::option' string =\n    run_target_args' path \\|\n        | Fsharp => \\ path =>\n            := parent : directory_info = path |> $'System.IO.Directory.GetParent'\n            ? parent =. null ()\n            ?> None\n            |: parent |> directory_info_full_name |> Some\n            |> optionm'::box\n        | Rust => \\ path =>\n            := path_buf = path |> sm'::to_std_string |> new_path_buf\n            := parent = path_buf |> path_buf_parent\n            parent\n            |> optionm'::map' (path_buf_display >> sm'::format' >> sm'::from_std_string)\n        | TypeScript _ => \\ path =>\n            global \"import * as spiral_node_path from 'node:path';\"\n            := parent = $'spiral_node_path.dirname(!path)' : string\n            ? parent = path\n            ?> None\n            |: parent |> Some\n            |> optionm'::box\n        | _ => \\ _ => optionm'::none' ()\n\n:= directory_parent (path : string) : option string =\n    run_target_args' path \\|\n        | Pascal => \\ path =>\n            := parent = $'ExtractFileDir(ExcludeTrailingPathDelimiter(!path))' : string\n            ? parent = path || parent = \"\" ?> None |: Some parent\n        | _ => \\ path => path |> directory_get_parent |> optionm'::unbox\n\n:= directory_create_all (path : string) : result () string =\n    run_target_args' path \\|\n        | Pascal => \\ path =>\n            ? $'ForceDirectories(!path)' : bool ?> Ok () |: Error (\"directory_create_all / cannot create \" ++# path)\n        | _ => \\ path => path |> create_dir_all |> resultm::map_error' sm'::format |> resultm::unbox","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  :~ directory_exists (path : string) : bool =
      run_target_args' path \|
          | Zig => \ _ =>
              global "var spiral_io_threaded: std.Io.Threaded = .init_single_threaded;"
              $'(if (std.Io.Dir.cwd().statFile(spiral_io_threaded.io(), !path, .{})) |s| s.kind == .directory else |_| \
                  false)' : bool
          | Fsharp => \ path =>
              path |> $'System.IO.Directory.Exists'
          | Rust => \ path =>
              := path = path |> sm'::to_std_string |> new_path_buf
              path_buf_exists path && path_buf_is_dir path
          | TypeScript => \ path =>
              global "import * as spiral_node_fs from 'node:fs';"
              $'(spiral_node_fs.existsSync(!path) && spiral_node_fs.statSync(!path).isDirectory())' : bool
          | Gleam => \ path =>
              file_system_gleam_paths ()
              $'spiral_fs_is_dir(!path)' : bool
          | Pascal => \ path => $'DirectoryExists(!path)' : bool
          | _ => \ _ => null ()

  :~ directory_get_parent (path : string) : optionm'::option' string =
      run_target_args' path \|
          | Fsharp => \ path =>
              := parent : directory_info = path |> $'System.IO.Directory.GetParent'
              ? parent =. null ()
              ?> None
              |: parent |> directory_info_full_name |> Some
              |> optionm'::box
          | Rust => \ path =>
              := path_buf = path |> sm'::to_std_string |> new_path_buf
              := parent = path_buf |> path_buf_parent
              parent
              |> optionm'::map' (path_buf_display >> sm'::format' >> sm'::from_std_string)
          | TypeScript _ => \ path =>
              global "import * as spiral_node_path from 'node:path';"
              := parent = $'spiral_node_path.dirname(!path)' : string
              ? parent = path
              ?> None
              |: parent |> Some
              |> optionm'::box
          | _ => \ _ => optionm'::none' ()

  := directory_parent (path : string) : option string =
      run_target_args' path \|
          | Pascal => \ path =>
              := parent = $'ExtractFileDir(ExcludeTrailingPathDelimiter(!path))' : string
              ? parent = path || parent = "" ?> None |: Some parent
          | _ => \ path => path |> directory_get_parent |> optionm'::unbox

  := directory_create_all (path : string) : result () string =
      run_target_args' path \|
          | Pascal => \ path =>
              ? $'ForceDirectories(!path)' : bool ?> Ok () |: Error ("directory_create_all / cannot create " ++# path)
          | _ => \ path => path |> create_dir_all |> resultm::map_error' sm'::format |> resultm::unbox
  """,
  timeout: 300_000
)
```

#### directory_create_all_makes_nested_directories (test)

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":"///- --test --symbol\n///> rust\n///> pascal\n\n:= path = get_current_directory () </> \"directory_create_all_test\" </> \"a\" </> \"b\"\n?= directory_create_all path ?|\n| Ok () => ? directory_exists path = !- ?> failwith \"the nested directory exists after directory_create_all\"\n| Error message => failwith message","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  ///- --test --symbol
  ///> rust
  ///> pascal

  := path = get_current_directory () </> "directory_create_all_test" </> "a" </> "b"
  ?= directory_create_all path ?|
  | Ok () => ? directory_exists path = !- ?> failwith "the nested directory exists after directory_create_all"
  | Error message => failwith message
  """,
  timeout: 300_000
)
```

