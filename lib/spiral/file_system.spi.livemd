## typescript

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":":= ts_path_join (b : string) (a : string) : string =\n    global \"import * as spiral_node_path from 'node:path';\"\n    $'spiral_node_path.join(!a, !b)' : string","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  := ts_path_join (b : string) (a : string) : string =
      global "import * as spiral_node_path from 'node:path';"
      $'spiral_node_path.join(!a, !b)' : string
  """,
  timeout: 300_000
)
```

## file_system

<!-- livebook:{"break_markdown":true} -->

### (< />)

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":":~ (</>) (a : string) (b : string) : string =\n    run_target_args (\\ () => a, b) \\|\n        | Rust => \\ a, b =>\n            a\n            |> sm'::to_std_string\n            |> new_path_buf\n            |> path_buf_join b\n            |> path_buf_display\n            |> sm'::format'\n            |> sm'::from_std_string\n        | TypeScript => \\ a, b =>\n            a |> ts_path_join b\n        | Fsharp => \\ a, b =>\n            $'System.IO.Path.Combine (!a, !b)'\n        | _ => \\ a, b =>\n            ? a = \"\" ?> b\n            |? (a |> sm'::ends_with \"/\") || (a |> sm'::ends_with \"\\\\\") ?> a ++# b\n            |: a ++# \"/\" ++# b","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  :~ (</>) (a : string) (b : string) : string =
      run_target_args (\ () => a, b) \|
          | Rust => \ a, b =>
              a
              |> sm'::to_std_string
              |> new_path_buf
              |> path_buf_join b
              |> path_buf_display
              |> sm'::format'
              |> sm'::from_std_string
          | TypeScript => \ a, b =>
              a |> ts_path_join b
          | Fsharp => \ a, b =>
              $'System.IO.Path.Combine (!a, !b)'
          | _ => \ a, b =>
              ? a = "" ?> b
              |? (a |> sm'::ends_with "/") || (a |> sm'::ends_with "\\") ?> a ++# b
              |: a ++# "/" ++# b
  """,
  timeout: 300_000
)
```

