<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":":= read_text_or_empty (path : string) : string =\n    run_target \\|\n        | Rust => \\ () =>\n            $'std::rc::Rc::<str>::from(std::fs::read_to_string(&*!path).unwrap_or_default().as_str())' : string\n        | Fsharp => \\ () =>\n            $'(try System.IO.File.ReadAllText(!path : string) with _ -> \"\")' : string\n        | _ => \\ () => no_arm \"file_system.read_text_or_empty\"\n\n:= read_text_or_empty_probe () : string =\n    := path = get_temp_path () </> \"spiral-read-text-or-empty.txt\"\n    write_all_text path \"kept\"\n    path","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  := read_text_or_empty (path : string) : string =
      run_target \|
          | Rust => \ () =>
              $'std::rc::Rc::<str>::from(std::fs::read_to_string(&*!path).unwrap_or_default().as_str())' : string
          | Fsharp => \ () =>
              $'(try System.IO.File.ReadAllText(!path : string) with _ -> "")' : string
          | _ => \ () => no_arm "file_system.read_text_or_empty"

  := read_text_or_empty_probe () : string =
      := path = get_temp_path () </> "spiral-read-text-or-empty.txt"
      write_all_text path "kept"
      path
  """,
  timeout: 300_000
)
```

