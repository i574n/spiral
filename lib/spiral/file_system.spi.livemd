<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":":= get_workspace_root () =\n    := repo_root = env::get_environment_variable \"SPIRAL_REPO_ROOT\"\n    ? repo_root <> \"\"\n    ?> repo_root |> normalize_path\n    |:\n        := dirs =\n            [ get_current_directory; get_source_directory; \\ () => \"/workspaces\" ]\n        :~ run dir =\n            dir\n            |> find_parent Directory (\"spiral\" </> \"workspace\")\n            |> \\|\n                | Ok dir => dir |> normalize_path |> Some\n                | Error error =>\n                    trace Warning\n                        \\ () => \"file_system.get_workspace_root\"\n                        \\ () => { dir error }\n                    None\n        := root =\n            (None, dirs)\n            ||> listm::fold \\ acc dir =>\n                ?= acc ?|\n                | Some dir => Some dir\n                | None => dir () |> run\n            |> optionm::value\n        deps_workspace_root root </> \"spiral\"\n\n:= get_workspace_root_external () =\n    := workspace_root = get_workspace_root ()\n    := current_dir = get_current_directory () |> sm'::to_lower\n    := workspace_root = workspace_root |> sm'::to_lower\n    ? current_dir |> sm'::starts_with workspace_root\n    ?> Error workspace_root\n    |: Ok workspace_root","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  := get_workspace_root () =
      := repo_root = env::get_environment_variable "SPIRAL_REPO_ROOT"
      ? repo_root <> ""
      ?> repo_root |> normalize_path
      |:
          := dirs =
              [ get_current_directory; get_source_directory; \ () => "/workspaces" ]
          :~ run dir =
              dir
              |> find_parent Directory ("spiral" </> "workspace")
              |> \|
                  | Ok dir => dir |> normalize_path |> Some
                  | Error error =>
                      trace Warning
                          \ () => "file_system.get_workspace_root"
                          \ () => { dir error }
                      None
          := root =
              (None, dirs)
              ||> listm::fold \ acc dir =>
                  ?= acc ?|
                  | Some dir => Some dir
                  | None => dir () |> run
              |> optionm::value
          deps_workspace_root root </> "spiral"

  := get_workspace_root_external () =
      := workspace_root = get_workspace_root ()
      := current_dir = get_current_directory () |> sm'::to_lower
      := workspace_root = workspace_root |> sm'::to_lower
      ? current_dir |> sm'::starts_with workspace_root
      ?> Error workspace_root
      |: Ok workspace_root
  """,
  timeout: 300_000
)
```

