/// # float_native

/// ## float_native

/// ### float_native_types
inl float_native_types () =
    backend_switch {
        Lua = fun () => ()
        Python = fun () => global "import math"
        C = fun () =>
            global "#include <stdio.h>"
            global "#include <stdlib.h>"
            global "#include <math.h>"
            global "static char spiral_format_buffer[64];"
    }

/// ### is_nan
inl is_nan forall t. (v : t) : bool =
    float_native_types ()
    backend_switch {
        Gleam = fun () => false
        Lua = fun () => $'!v ~= !v' : bool
        Fsharp = fun () => $'System.Double.IsNaN(float !v)' : bool
        Python = fun () => $'math.isnan(!v)' : bool
        Rust = fun () => $'!v.is_nan()' : bool
        TypeScript = fun () => $'Number.isNaN(!v)' : bool
        Zig = fun () => $'std.math.isNan(!v)' : bool
        Lean = fun () => $'(!v).isNaN' : bool
        Kotlin = fun () => $'(!v).isNaN()' : bool
        Swift = fun () => $'(!v).isNaN' : bool
        C = fun () => $'isnan(!v)' : bool
        Delphi = fun () => $'IsNan(!v)' : bool
    }

/// ### is_infinite
inl is_infinite forall t. (v : t) : bool =
    float_native_types ()
    backend_switch {
        Gleam = fun () => false
        Lua = fun () => $'math.abs(!v) == math.huge' : bool
        Fsharp = fun () => $'System.Double.IsInfinity(float !v)' : bool
        Python = fun () => $'math.isinf(!v)' : bool
        Rust = fun () => $'!v.is_infinite()' : bool
        TypeScript = fun () => $'Math.abs(!v) === Infinity' : bool
        Zig = fun () => $'std.math.isInf(!v)' : bool
        Lean = fun () => $'(!v).isInf' : bool
        Kotlin = fun () => $'(!v).isInfinite()' : bool
        Swift = fun () => $'(!v).isInfinite' : bool
        C = fun () => $'isinf(!v)' : bool
        Delphi = fun () => $'IsInfinite(!v)' : bool
    }

/// ### precision_format
inl precision_format (p : i32) : string =
    float_text.concat "%." (float_text.concat (float_text.digits_text p "") "g")

/// ### shortest_by_precision
inl shortest_by_precision forall t. (format_g : i32 -> string) (parse : string -> t) (v : t) : string =
    let rec search (p : i32) : string =
        inl s = format_g p
        if p >= 17i32 || parse s = v then s else search (p + 1i32)
    search 1i32

/// ### lua_format_g
inl lua_format_g forall t. (v : t) (p : i32) : string =
    inl format = precision_format p
    $'string.format(!format, !v)' : string

/// ### lua_parse
inl lua_parse forall t. (s : string) : t =
    $'tonumber(!s)' : t

/// ### c_format_g
inl c_format_g forall t. (v : t) (p : i32) : string =
    float_native_types ()
    inl count = $'snprintf(spiral_format_buffer, sizeof spiral_format_buffer, "%.*g", !p, !v)' : i32
    inl size = count + 1i32
    $'StringLit(!size, spiral_format_buffer)' : string

/// ### c_parse
inl c_parse forall t. (s : string) : t =
    float_native_types ()
    real
        typecase t with
        | f32 => $'strtof((!s)->ptr, NULL)' : f32
        | f64 => $'strtod((!s)->ptr, NULL)' : f64

/// ### delphi_format_g
inl delphi_format_g forall t. (v : t) (p : i32) : string =
    $'FloatToStrF(!v, ffGeneral, !p, 0)' : string

/// ### delphi_parse
inl delphi_parse forall t. (s : string) : t =
    $'StrToFloat(!s)' : t

/// ### decimal_point
inl decimal_point (s : string) : string =
    inl comma = float_text.position_of ',' s 0i32
    if comma < 0i32 then s
    else
        inl after = float_text.text_length s - comma - 1i32
        inl before = float_text.part s 0i32 comma
        float_text.concat before (float_text.concat "." (float_text.part s (comma + 1i32) after))

/// ### lean_widen
inl lean_widen forall t. (v : t) : f64 =
    real
        typecase t with
        | f32 => $'Float32.toFloat !v' : f64
        | f64 => v

/// ### lean_same
inl lean_narrowed forall t. (candidate : f64) (precision : t) : f64 =
    real
        typecase t with
        | f32 => $'Float32.toFloat (!candidate).toFloat32' : f64
        | f64 => candidate

/// ### lean_same
inl lean_same forall t. (candidate : f64) (v : t) : bool = lean_narrowed candidate v = lean_widen v

/// ### lean_floor_log10
inl lean_floor_log10 (a : f64) : i64 =
    $'(Float.floor (Float.log10 !a)).toInt64' : i64

/// ### lean_pow10
inl lean_pow10 (k : i64) : f64 =
    $'Float.pow 10 (Float.ofInt (!k).toInt)' : f64

/// ### lean_round
inl lean_round (x : f64) : u64 =
    $'(Float.round !x).toUInt64' : u64

/// ### lean_of_scientific
inl lean_of_scientific (n : u64) (negative : bool) (magnitude : i64) : f64 =
    $'Float.ofScientific (!n).toNat !negative (!magnitude).toInt.natAbs' : f64

/// ### lean_abs
inl lean_abs (a : f64) : f64 =
    $'Float.abs !a' : f64

/// ### lean_digits
inl lean_digits forall t. (n : t) : string =
    $'toString !n' : string

/// ### lean_scaled
inl lean_scaled (a : f64) (k : i64) : u64 =
    if k >= 0i64 then lean_round (a / lean_pow10 k) else lean_round (a * lean_pow10 (0i64 - k))

/// ### lean_shortest
inl lean_shortest forall t. (v : t) : string =
    inl wide = lean_widen v
    inl sign = if wide < 0f64 then "-" else ""
    inl a = lean_abs wide
    if a = 0f64 then (if 1f64 / wide < 0f64 then "-0.0" else "0.0")
    else
        inl e = lean_floor_log10 a
        let rec search (p : i64) : string =
            inl k = e - p + 1i64
            inl n = lean_scaled a k
            inl magnitude = if k < 0i64 then 0i64 - k else k
            if p >= 17i64 || lean_same (lean_of_scientific n (k < 0i64) magnitude) v
            then float_text.concat (lean_digits n) (float_text.concat "e" (lean_digits k))
            else search (p + 1i64)
        float_text.concat sign (search 1i64)

/// ### native_shortest
inl native_shortest forall t. (v : t) : string =
    backend_switch {
        Lua = fun () => shortest_by_precision (lua_format_g v) lua_parse v
        Fsharp = fun () => $'(!v).ToString("R", System.Globalization.CultureInfo.InvariantCulture)' : string
        Python = fun () => $'repr(float(!v))' : string
        Rust = fun () => $'Rc::<str>::from(format\!("{:?}", !v))' : string
        TypeScript = fun () => $'String(!v)' : string
        Zig = fun () => $'spiralFloatText(!v)' : string
        Lean = fun () => lean_shortest v
        Kotlin = fun () => $'(!v).toString()' : string
        Swift = fun () => $'(!v).description' : string
        C = fun () => shortest_by_precision (c_format_g v) c_parse v
        Delphi = fun () => shortest_by_precision (delphi_format_g v) delphi_parse v |> decimal_point
    }

/// ### is_positive
inl is_positive forall t {number}. (v : t) : bool = v > -v

/// ### shortest
inl shortest forall t {number}. (v : t) : string =
    if is_nan v then "NaN"
    elif is_infinite v then (if is_positive v then "Infinity" else "-Infinity")
    else native_shortest v
