///- --package .

:= concat (a : string) (b : string) : string = !!!!StaticStringConcat(a, b)

:= text_length (s : string) : i32 = sm.length s

:= char_at (s : string) (i : i32) : char = sm.index s i

:= part (s : string) (from : i32) (count : i32) : string =
    ? count <= 0i32 ?> "" |: sm.slice s { from to = from + count - 1i32 }

:~ ^ position_of (c : char) (s : string) (i : i32) : i32 =
    ? i >= text_length s ?> -1i32 |? char_at s i = c ?> i |: position_of c s (i + 1i32)

:~ ^ zeros_from (s : string) (i : i32) : i32 =
    ? i < text_length s && char_at s i = '0' ?> zeros_from s (i + 1i32) |: i

:~ ^ zeros_before (s : string) (i : i32) : i32 =
    ? i > 0i32 && char_at s (i - 1i32) = '0' ?> zeros_before s (i - 1i32) |: i

:~ ^ repeated_zeros (count : i32) (acc : string) : string =
    ? count <= 0i32 ?> acc |: repeated_zeros (count - 1i32) (concat acc "0")

:= digit_value (c : char) : i32 = position_of c "0123456789" 0i32

:~ ^ digits_value (s : string) (i : i32) (acc : i32) : i32 =
    ? i >= text_length s ?> acc |: digits_value s (i + 1i32) (acc * 10i32 + digit_value (char_at s i))

:= signed_value (s : string) : i32 =
    ? text_length s = 0i32 ?> 0i32
    |? char_at s 0i32 = '-' ?> 0i32 - digits_value s 1i32 0i32
    |? char_at s 0i32 = '+' ?> digits_value s 1i32 0i32
    |: digits_value s 0i32 0i32

:~ ^ digits_text (n : i32) (acc : string) : string =
    := digit = part "0123456789" (n % 10i32) 1i32
    ? n < 10i32 ?> concat digit acc |: digits_text (n / 10i32) (concat digit acc)

:= exponent_marker (s : string) : i32 =
    := lower = position_of 'e' s 0i32
    ? lower >= 0i32 ?> lower |: position_of 'E' s 0i32

:= laid_out (sign : string) (digits : string) (point : i32) : string =
    := count = text_length digits
    := decimal_exponent = point - 1i32
    ? -4i32 <= decimal_exponent && decimal_exponent < 16i32 ?>
        ? point <= 0i32 ?> concat sign (concat "0." (concat (repeated_zeros (0i32 - point) "") digits))
        |? count <= point ?> concat sign (concat digits (concat (repeated_zeros (point - count) "") ".0"))
        |: concat sign (concat (part digits 0i32 point) (concat "." (part digits point (count - point))))
    |:
        := tail = ? count > 1i32 ?> concat "." (part digits 1i32 (count - 1i32)) |: ""
        := magnitude = ? decimal_exponent < 0i32 ?> 0i32 - decimal_exponent |: decimal_exponent
        := padded = ? magnitude < 10i32 ?> concat "0" (digits_text magnitude "") |: digits_text magnitude ""
        := exponent_sign = ? decimal_exponent < 0i32 ?> "e-" |: "e+"
        concat sign (concat (part digits 0i32 1i32) (concat tail (concat exponent_sign padded)))

:= float_text_repr (text : string) : string =
    ? text = "NaN" || text = "Infinity" || text = "-Infinity" ?> text
    |:
        := negative = text_length text > 0i32 && char_at text 0i32 = '-'
        := sign = ? negative ?> "-" |: ""
        := unsigned = ? negative ?> part text 1i32 (text_length text - 1i32) |: text
        := marker = exponent_marker unsigned
        := mantissa = ? marker < 0i32 ?> unsigned |: part unsigned 0i32 marker
        := exponent =
            ? marker < 0i32 ?> 0i32
            |: signed_value (part unsigned (marker + 1i32) (text_length unsigned - marker - 1i32))
        := point_at = position_of '.' mantissa 0i32
        := whole = ? point_at < 0i32 ?> mantissa |: part mantissa 0i32 point_at
        := fraction =
            ? point_at < 0i32 ?> "" |: part mantissa (point_at + 1i32) (text_length mantissa - point_at - 1i32)
        := all_digits = concat whole fraction
        := first = zeros_from all_digits 0i32
        := last = zeros_before all_digits (text_length all_digits)
        ? first >= last ?> concat sign "0.0"
        |: laid_out sign (part all_digits first (last - first)) (text_length whole + exponent - first)
///> rust
///> fsharp
///> typescript
///> gleam
test float_text_repr_lays_out_any_shortest_text_like_python_repr =
    := check (given : string) (expected : string) =
        ? float_text_repr given <> expected ?> failwith (concat given (concat " -> " (float_text_repr given)))
    check "1e+02" "100.0"
    check "100.0" "100.0"
    check "1e2" "100.0"
    check "1e16" "1e+16"
    check "10000000000000000.0" "1e+16"
    check "1E+17" "1e+17"
    check "1.5e22" "1.5e+22"
    check "1e-7" "1e-07"
    check "0.0001" "0.0001"
    check "1e-04" "0.0001"
    check "0.00001" "1e-05"
    check "1E-05" "1e-05"
    check "123.45" "123.45"
    check "1e15" "1000000000000000.0"
    check "-2.5" "-2.5"
    check "0.1" "0.1"
    check "0.0" "0.0"
    check "-0.0" "-0.0"
    check "NaN" "NaN"
    check "-Infinity" "-Infinity"
    check "1.25e-05" "1.25e-05"
    check "6.02214076e23" "6.02214076e+23"
    check "1e100" "1e+100"
