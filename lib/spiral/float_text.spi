///- --package .

inl concat (a : string) (b : string) : string = !!!!StaticStringConcat(a, b)

inl text_length (s : string) : i32 = sm.length s

inl char_at (s : string) (i : i32) : char = sm.index s i

inl part (s : string) (from : i32) (count : i32) : string =
    if count <= 0i32 then "" else sm.slice s { from to = from + count - 1i32 }

let rec position_of (c : char) (s : string) (i : i32) : i32 =
    if i >= text_length s then -1i32 elif char_at s i = c then i else position_of c s (i + 1i32)

let rec zeros_from (s : string) (i : i32) : i32 =
    if i < text_length s && char_at s i = '0' then zeros_from s (i + 1i32) else i

let rec zeros_before (s : string) (i : i32) : i32 =
    if i > 0i32 && char_at s (i - 1i32) = '0' then zeros_before s (i - 1i32) else i

let rec repeated_zeros (count : i32) (acc : string) : string =
    if count <= 0i32 then acc else repeated_zeros (count - 1i32) (concat acc "0")

inl digit_value (c : char) : i32 = position_of c "0123456789" 0i32

let rec digits_value (s : string) (i : i32) (acc : i32) : i32 =
    if i >= text_length s then acc else digits_value s (i + 1i32) (acc * 10i32 + digit_value (char_at s i))

inl signed_value (s : string) : i32 =
    if text_length s = 0i32 then 0i32
    elif char_at s 0i32 = '-' then 0i32 - digits_value s 1i32 0i32
    elif char_at s 0i32 = '+' then digits_value s 1i32 0i32
    else digits_value s 0i32 0i32

let rec digits_text (n : i32) (acc : string) : string =
    inl digit = part "0123456789" (n % 10i32) 1i32
    if n < 10i32 then concat digit acc else digits_text (n / 10i32) (concat digit acc)

inl exponent_marker (s : string) : i32 =
    inl lower = position_of 'e' s 0i32
    if lower >= 0i32 then lower else position_of 'E' s 0i32

inl laid_out (sign : string) (digits : string) (point : i32) : string =
    inl count = text_length digits
    inl decimal_exponent = point - 1i32
    if -4i32 <= decimal_exponent && decimal_exponent < 16i32 then
        if point <= 0i32 then concat sign (concat "0." (concat (repeated_zeros (0i32 - point) "") digits))
        elif count <= point then concat sign (concat digits (concat (repeated_zeros (point - count) "") ".0"))
        else concat sign (concat (part digits 0i32 point) (concat "." (part digits point (count - point))))
    else
        inl tail = if count > 1i32 then concat "." (part digits 1i32 (count - 1i32)) else ""
        inl magnitude = if decimal_exponent < 0i32 then 0i32 - decimal_exponent else decimal_exponent
        inl padded = if magnitude < 10i32 then concat "0" (digits_text magnitude "") else digits_text magnitude ""
        inl exponent_sign = if decimal_exponent < 0i32 then "e-" else "e+"
        concat sign (concat (part digits 0i32 1i32) (concat tail (concat exponent_sign padded)))

inl float_text_repr (text : string) : string =
    if text = "NaN" || text = "Infinity" || text = "-Infinity" then text
    else
        inl negative = text_length text > 0i32 && char_at text 0i32 = '-'
        inl sign = if negative then "-" else ""
        inl unsigned = if negative then part text 1i32 (text_length text - 1i32) else text
        inl marker = exponent_marker unsigned
        inl mantissa = if marker < 0i32 then unsigned else part unsigned 0i32 marker
        inl exponent =
            if marker < 0i32 then 0i32
            else signed_value (part unsigned (marker + 1i32) (text_length unsigned - marker - 1i32))
        inl point_at = position_of '.' mantissa 0i32
        inl whole = if point_at < 0i32 then mantissa else part mantissa 0i32 point_at
        inl fraction =
            if point_at < 0i32 then "" else part mantissa (point_at + 1i32) (text_length mantissa - point_at - 1i32)
        inl all_digits = concat whole fraction
        inl first = zeros_from all_digits 0i32
        inl last = zeros_before all_digits (text_length all_digits)
        if first >= last then concat sign "0.0"
        else laid_out sign (part all_digits first (last - first)) (text_length whole + exponent - first)
///> rust
///> fsharp
///> typescript
///> gleam
test float_text_repr_lays_out_any_shortest_text_like_python_repr =
    inl check (given : string) (expected : string) =
        if float_text_repr given <> expected then failwith (concat given (concat " -> " (float_text_repr given)))
    check "1e+02" "100.0"
    check "100.0" "100.0"
    check "1e2" "100.0"
    check "1e16" "1e+16"
    check "10000000000000000.0" "1e+16"
    check "1E+17" "1e+17"
    check "1.5e22" "1.5e+22"
    check "1e-7" "1e-07"
    check "0.0001" "0.0001"
    check "1e-04" "0.0001"
    check "0.00001" "1e-05"
    check "1E-05" "1e-05"
    check "123.45" "123.45"
    check "1e15" "1000000000000000.0"
    check "-2.5" "-2.5"
    check "0.1" "0.1"
    check "0.0" "0.0"
    check "-0.0" "-0.0"
    check "NaN" "NaN"
    check "-Infinity" "-Infinity"
    check "1.25e-05" "1.25e-05"
    check "6.02214076e23" "6.02214076e+23"
    check "1e100" "1e+100"
