:< sm'_operators

:# guid static =
    :< testing

:! guid_python =
    `(
        global "import uuid"
        $'' : $'uuid.UUID'
    )
:== guid_switch =
    {
        Gleam : string
        Lua : string
        Fsharp : $'System.Guid'
        Python : guid_python
        Rust : $'Rc<str>'
        TypeScript : string
        Zig : string
    }
:! guid = $'backend_switch `(guid_switch)'

:= lower_guid (x : string) : guid =
    := lower = sm'::to_lower x
    $'!lower '

:= cuda_lower_guid (x : string) : guid =
    global "import uuid"
    lower_guid x

:= new_guid (x : string) : guid =
    run_target_args (\ () => x) \|
        | Zig => \ _ => $'(std.ascii.allocLowerString(spiral_gpa, !x) catch @@panic("out of memory"))' : guid
        | Gleam => \ x => lower_guid x
        | Lua => \ x => lower_guid x
        | Cuda => \ x => cuda_lower_guid x
        | Rust => \ x => $'Rc::<str>::from(!x.to_lowercase())'
        | TypeScript => \ x => $'!x.toLowerCase()'
        | _ => \ x => $'!x |> `guid '

:= to_string (x : guid) : string =
    run_target_args (\ () => x) \|
        | Fsharp => \ x => $'!x.ToString()' : string
        | _ => \ x => $'!x ' : string

:= zig_query_counter_global () : () =
    global """extern "kernel32" fn QueryPerformanceCounter(count: *i64) callconv(.winapi) c_int;"""

:= zig_random_global () : () =
    global """
        var spiral_random_state: u64 = 0;
        fn spiralRandomU64() u64 {
            if (spiral_random_state == 0) {
                var seed: u64 = 0;
                if (builtin.os.tag == .windows) {
                    var count: i64 = 0;
                    _ = QueryPerformanceCounter(&count);
                    seed = @bitCast(count);
                } else if (builtin.os.tag == .linux) {
                    var ts: std.os.linux.timespec = undefined;
                    _ = std.os.linux.clock_gettime(.MONOTONIC, &ts);
                    seed = @as(u64, @bitCast(@as(i64, ts.sec))) *% 1000000007 +% @as(u64, @bitCast(@as(i64, ts.nsec)));
                }
                spiral_random_state = (seed ^ @intFromPtr(&spiral_random_state)) | 1;
            }
            var x = spiral_random_state;
            x ^= x << 13;
            x ^= x >> 7;
            x ^= x << 17;
            spiral_random_state = x;
            return x;
        }
        """

:= zig_random_u64 () : u64 =
    zig_query_counter_global ()
    zig_random_global ()
    $'spiralRandomU64()' : u64

:~ ^ guid_hex_digits (left : i32) (rest : u64) (acc : string) : string =
    ? left <= 0i32
    ?> acc
    |:
        := digit : i32 = conv (rest &&& 15u64)
        guid_hex_digits (left - 1i32) (rest >>> 4i32) (sm'::slice digit digit "0123456789abcdef" ++# acc)

:= guid_hex (width : i32) (n : u64) : string = guid_hex_digits width n ""

:= guid_v4_head (a : u64) : string =
    guid_hex 8i32 (a &&& 4294967295u64)
    ++# "-" ++# guid_hex 4i32 ((a >>> 32i32) &&& 65535u64)
    ++# "-4" ++# guid_hex 3i32 ((a >>> 48i32) &&& 4095u64)

:= guid_v4_tail (b : u64) : string =
    guid_hex 4i32 ((b &&& 16383u64) ||| 32768u64) ++# "-" ++# guid_hex 12i32 ((b >>> 16i32) &&& 281474976710655u64)

:= guid_v4_text (a : u64) (b : u64) : string = guid_v4_head a ++# "-" ++# guid_v4_tail b

:! rust_hasher = $'std::collections::hash_map::DefaultHasher'

:= rust_hash_next (hasher : rust_hasher) (x : u64) : u64 =
    $'std::hash::Hasher::write_u64(&mut !hasher, !x)' : ()
    $'std::hash::Hasher::finish(&!hasher)' : u64

:= rust_new_hasher () : rust_hasher =
    $'std::hash::BuildHasher::build_hasher(&std::collections::hash_map::RandomState::new())' : rust_hasher

:= clock_seed () = unix_clock::nanos_count (unix_clock::unix_now_nanos ())

:= rust_random_pair () : u64 * u64 =
    := hasher = rust_new_hasher ()
    hasher |> rust::to_mut
    := nanos = clock_seed ()
    := a = rust_hash_next hasher nanos
    := b = rust_hash_next hasher a
    a, b

:= gleam_raw_guid () : guid =
    global "import gleam_uuid"
    $'gleam_uuid.v4_string ()' : guid

:= python_raw_guid () : guid =
    global "import uuid"
    $'uuid.uuid4()' : guid

:= zig_raw_guid () : guid =
    := a = zig_random_u64 ()
    := b = zig_random_u64 ()
    guid_v4_text a b |> new_guid

:= rust_raw_guid () : guid =
    := a, b = rust_random_pair ()
    guid_v4_text a b |> new_guid

:= new_raw_guid () : guid =
    backend_switch {
        Gleam = \ () => gleam_raw_guid ()
        Lua = \ () => $'""' : guid
        Fsharp = \ () => $'System.Guid.NewGuid' () : guid
        TypeScript = \ () => $'globalThis.crypto.randomUUID()' : guid
        Python = \ () => python_raw_guid ()
        Zig = \ () => zig_raw_guid ()
        Rust = \ () => rust_raw_guid ()
    }

:== hash_guid = guid

:= guid_slice (hash : string) (start : i32) (stop : i32) : string =
    hash |> sm'::range (am'::Start start) (am'::End \ _ => stop)

:= hash_guid_text (dash : string) (hash : string) : string =
    := hash = hash |> sm'::pad_left 32i32 '0'
    := head = guid_slice hash 0i32 8 ++# dash ++# guid_slice hash 8i32 12 ++# dash ++# guid_slice hash 12i32 16
    head ++# dash ++# guid_slice hash 16i32 20 ++# dash ++# guid_slice hash 20i32 32

:~ hash_guid (hash : string) : hash_guid =
    := body () =
        := dash = "-"
        ~~ hash_guid_text dash hash |> new_guid
    run_target \|
        | Zig => \ () => body ()
        | _ => body

///> gleam
///> cuda
///> rust
///> typescript
:# hash_guid =
    "" |> hash_guid |> _assert_eq' ("00000000-0000-0000-0000-000000000000" |> new_guid)

///> gleam
///> cuda
///> rust
///> typescript
:# hash_guid_takes_the_first_32_digits =
    "123456789012345678901234567890123"
    |> hash_guid
    |> _assert_eq' ("12345678-9012-3456-7890-123456789012" |> new_guid)

///> rust
///> zig
///> cuda
///> gleam
///> lua
:# to_string_is_lowercase_text =
    "6543210F-EDCB-A987-6543-210FEDCBA987"
    |> new_guid
    |> to_string
    |> _assert_eq "6543210f-edcb-a987-6543-210fedcba987"

///> rust
///> zig
:# new_raw_guid_has_the_v4_text_length =
    new_raw_guid () |> to_string |> sm'::length |> _assert_eq 36i32

///> fsharp

:= main () =
    $'let new_guid x = !new_guid x' : ()
    $'let hash_guid x = !hash_guid x' : ()
    $'let new_raw_guid x = !new_raw_guid x' : ()
