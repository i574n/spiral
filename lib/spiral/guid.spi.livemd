<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":":! guid_python =\n    `(\n        global \"import uuid\"\n        $'' : $'uuid.UUID'\n    )\n:== guid_switch =\n    {\n        Gleam : string\n        Lua : string\n        Fsharp : $'System.Guid'\n        Python : guid_python\n        Rust : $'Rc<str>'\n        TypeScript : string\n        Zig : string\n    }\n:! guid = $'backend_switch `(guid_switch)'\n\n:= new_guid (x : string) : guid =\n    run_target_args (\\ () => x) \\|\n        | Zig => \\ _ => $'(std.ascii.allocLowerString(spiral_gpa, !x) catch @@panic(\"out of memory\"))' : guid\n        | Gleam => \\ x =>\n            := lower = sm'::to_lower x\n            $'!lower '\n        | Lua => \\ x =>\n            := lower = sm'::to_lower x\n            $'!lower '\n        | Cuda => \\ x =>\n            global \"import uuid\"\n            := lower = sm'::to_lower x\n            $'!lower '\n        | Rust => \\ x => $'Rc::<str>::from(!x.to_lowercase())'\n        | TypeScript => \\ x => $'!x.toLowerCase()'\n        | _ => \\ x => $'!x |> `guid '\n\n:= to_string (x : guid) : string =\n    run_target_args (\\ () => x) \\|\n        | Fsharp => \\ x => $'!x.ToString()' : string\n        | _ => \\ x => $'!x ' : string\n\n:= zig_random_u64 () : u64 =\n    global \"\"\"extern \"kernel32\" fn QueryPerformanceCounter(count: *i64) callconv(.winapi) c_int;\"\"\"\n    global \"\"\"\n        var spiral_random_state: u64 = 0;\n        fn spiralRandomU64() u64 {\n            if (spiral_random_state == 0) {\n                var seed: u64 = 0;\n                if (builtin.os.tag == .windows) {\n                    var count: i64 = 0;\n                    _ = QueryPerformanceCounter(&count);\n                    seed = @bitCast(count);\n                } else if (builtin.os.tag == .linux) {\n                    var ts: std.os.linux.timespec = undefined;\n                    _ = std.os.linux.clock_gettime(.MONOTONIC, &ts);\n                    seed = @as(u64, @bitCast(@as(i64, ts.sec))) *% 1000000007 +% @as(u64, @bitCast(@as(i64, ts.nsec)));\n                }\n                spiral_random_state = (seed ^ @intFromPtr(&spiral_random_state)) | 1;\n            }\n            var x = spiral_random_state;\n            x ^= x << 13;\n            x ^= x >> 7;\n            x ^= x << 17;\n            spiral_random_state = x;\n            return x;\n        }\n        \"\"\"\n    $'spiralRandomU64()' : u64\n\n:= guid_hex (width : i32) (n : u64) : string =\n    :~ ^ go (left : i32) (rest : u64) (acc : string) : string =\n        ? left <= 0i32 ?> acc\n        |:\n            := digit : i32 = conv (rest &&& 15u64)\n            go (left - 1i32) (rest >>> 4i32) (sm'::slice digit digit \"0123456789abcdef\" ++# acc)\n    go width n \"\"\n\n:= guid_v4_text (a : u64) (b : u64) : string =\n    guid_hex 8i32 (a &&& 4294967295u64)\n    ++# \"-\" ++# guid_hex 4i32 ((a >>> 32i32) &&& 65535u64)\n    ++# \"-4\" ++# guid_hex 3i32 ((a >>> 48i32) &&& 4095u64)\n    ++# \"-\" ++# guid_hex 4i32 ((b &&& 16383u64) ||| 32768u64)\n    ++# \"-\" ++# guid_hex 12i32 ((b >>> 16i32) &&& 281474976710655u64)\n\n:! rust_hasher = $'std::collections::hash_map::DefaultHasher'\n\n:= rust_random_pair () : u64 * u64 =\n    := hasher = $'std::hash::BuildHasher::build_hasher(&std::collections::hash_map::RandomState::new())' : rust_hasher\n    hasher |> rust::to_mut\n    := nanos = unix_clock::nanos_count (unix_clock::unix_now_nanos ())\n    $'std::hash::Hasher::write_u64(&mut !hasher, !nanos)' : ()\n    := a = $'std::hash::Hasher::finish(&!hasher)' : u64\n    $'std::hash::Hasher::write_u64(&mut !hasher, !a)' : ()\n    := b = $'std::hash::Hasher::finish(&!hasher)' : u64\n    a, b\n\n:= new_raw_guid () : guid =\n    backend_switch {\n        Gleam = \\ () =>\n            global \"import gleam_uuid\"\n            $'gleam_uuid.v4_string ()' : guid\n        Lua = \\ () => $'\"\"' : guid\n        Fsharp = \\ () => $'System.Guid.NewGuid' () : guid\n        TypeScript = \\ () => $'globalThis.crypto.randomUUID()' : guid\n        Python = \\ () =>\n            global \"import uuid\"\n            $'uuid.uuid4()' : guid\n        Zig = \\ () =>\n            := a = zig_random_u64 ()\n            := b = zig_random_u64 ()\n            guid_v4_text a b |> new_guid\n        Rust = \\ () =>\n            := a, b = rust_random_pair ()\n            guid_v4_text a b |> new_guid\n    }\n\n:== hash_guid = guid\n\n:~ hash_guid (hash : string) : hash_guid =\n    := body () =\n        := dash = \"-\"\n        ~~\n            := hash = hash |> sm'::pad_left 32i32 '0'\n            := a = hash |> sm'::range (am'::Start 0i32) (am'::End \\ _ => 8)\n            := b = hash |> sm'::range (am'::Start 8i32) (am'::End \\ _ => 12)\n            := c = hash |> sm'::range (am'::Start 12i32) (am'::End \\ _ => 16)\n            := d = hash |> sm'::range (am'::Start 16i32) (am'::End \\ _ => 20)\n            := e = hash |> sm'::range (am'::Start 20i32) (am'::End \\ _ => 32)\n            a ++# dash ++# b ++# dash ++# c ++# dash ++# d ++# dash ++# e\n            |> new_guid\n    run_target \\|\n        | Zig => \\ () => body ()\n        | _ => body","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ":! guid_python =\n    `(\n        global \"import uuid\"\n        $'' : $'uuid.UUID'\n    )\n:== guid_switch =\n    {\n        Gleam : string\n        Lua : string\n        Fsharp : $'System.Guid'\n        Python : guid_python\n        Rust : $'Rc<str>'\n        TypeScript : string\n        Zig : string\n    }\n:! guid = $'backend_switch `(guid_switch)'\n\n:= new_guid (x : string) : guid =\n    run_target_args (\\ () => x) \\|\n        | Zig => \\ _ => $'(std.ascii.allocLowerString(spiral_gpa, !x) catch @@panic(\"out of memory\"))' : guid\n        | Gleam => \\ x =>\n            := lower = sm'::to_lower x\n            $'!lower '\n        | Lua => \\ x =>\n            := lower = sm'::to_lower x\n            $'!lower '\n        | Cuda => \\ x =>\n            global \"import uuid\"\n            := lower = sm'::to_lower x\n            $'!lower '\n        | Rust => \\ x => $'Rc::<str>::from(!x.to_lowercase())'\n        | TypeScript => \\ x => $'!x.toLowerCase()'\n        | _ => \\ x => $'!x |> `guid '\n\n:= to_string (x : guid) : string =\n    run_target_args (\\ () => x) \\|\n        | Fsharp => \\ x => $'!x.ToString()' : string\n        | _ => \\ x => $'!x ' : string\n\n:= zig_random_u64 () : u64 =\n    global \"\"\"extern \"kernel32\" fn QueryPerformanceCounter(count: *i64) callconv(.winapi) c_int;\"\"\"\n    global \"\"\"\n        var spiral_random_state: u64 = 0;\n        fn spiralRandomU64() u64 {\n            if (spiral_random_state == 0) {\n                var seed: u64 = 0;\n                if (builtin.os.tag == .windows) {\n                    var count: i64 = 0;\n                    _ = QueryPerformanceCounter(&count);\n                    seed = @bitCast(count);\n                } else if (builtin.os.tag == .linux) {\n                    var ts: std.os.linux.timespec = undefined;\n                    _ = std.os.linux.clock_gettime(.MONOTONIC, &ts);\n                    seed = @as(u64, @bitCast(@as(i64, ts.sec))) *% 1000000007 +% @as(u64, @bitCast(@as(i64, ts.nsec)));\n                }\n                spiral_random_state = (seed ^ @intFromPtr(&spiral_random_state)) | 1;\n            }\n            var x = spiral_random_state;\n            x ^= x << 13;\n            x ^= x >> 7;\n            x ^= x << 17;\n            spiral_random_state = x;\n            return x;\n        }\n        \"\"\"\n    $'spiralRandomU64()' : u64\n\n:= guid_hex (width : i32) (n : u64) : string =\n    :~ ^ go (left : i32) (rest : u64) (acc : string) : string =\n        ? left <= 0i32 ?> acc\n        |:\n            := digit : i32 = conv (rest &&& 15u64)\n            go (left - 1i32) (rest >>> 4i32) (sm'::slice digit digit \"0123456789abcdef\" ++# acc)\n    go width n \"\"\n\n:= guid_v4_text (a : u64) (b : u64) : string =\n    guid_hex 8i32 (a &&& 4294967295u64)\n    ++# \"-\" ++# guid_hex 4i32 ((a >>> 32i32) &&& 65535u64)\n    ++# \"-4\" ++# guid_hex 3i32 ((a >>> 48i32) &&& 4095u64)\n    ++# \"-\" ++# guid_hex 4i32 ((b &&& 16383u64) ||| 32768u64)\n    ++# \"-\" ++# guid_hex 12i32 ((b >>> 16i32) &&& 281474976710655u64)\n\n:! rust_hasher = $'std::collections::hash_map::DefaultHasher'\n\n:= rust_random_pair () : u64 * u64 =\n    := hasher = $'std::hash::BuildHasher::build_hasher(&std::collections::hash_map::RandomState::new())' : rust_hasher\n    hasher |> rust::to_mut\n    := nanos = unix_clock::nanos_count (unix_clock::unix_now_nanos ())\n    $'std::hash::Hasher::write_u64(&mut !hasher, !nanos)' : ()\n    := a = $'std::hash::Hasher::finish(&!hasher)' : u64\n    $'std::hash::Hasher::write_u64(&mut !hasher, !a)' : ()\n    := b = $'std::hash::Hasher::finish(&!hasher)' : u64\n    a, b\n\n:= new_raw_guid () : guid =\n    backend_switch {\n        Gleam = \\ () =>\n            global \"import gleam_uuid\"\n            $'gleam_uuid.v4_string ()' : guid\n        Lua = \\ () => $'\"\"' : guid\n        Fsharp = \\ () => $'System.Guid.NewGuid' () : guid\n        TypeScript = \\ () => $'globalThis.crypto.randomUUID()' : guid\n        Python = \\ () =>\n            global \"import uuid\"\n            $'uuid.uuid4()' : guid\n        Zig = \\ () =>\n            := a = zig_random_u64 ()\n            := b = zig_random_u64 ()\n            guid_v4_text a b |> new_guid\n        Rust = \\ () =>\n            := a, b = rust_random_pair ()\n            guid_v4_text a b |> new_guid\n    }\n\n:== hash_guid = guid\n\n:~ hash_guid (hash : string) : hash_guid =\n    := body () =\n        := dash = \"-\"\n        ~~\n            := hash = hash |> sm'::pad_left 32i32 '0'\n            := a = hash |> sm'::range (am'::Start 0i32) (am'::End \\ _ => 8)\n            := b = hash |> sm'::range (am'::Start 8i32) (am'::End \\ _ => 12)\n            := c = hash |> sm'::range (am'::Start 12i32) (am'::End \\ _ => 16)\n            := d = hash |> sm'::range (am'::Start 16i32) (am'::End \\ _ => 20)\n            := e = hash |> sm'::range (am'::Start 20i32) (am'::End \\ _ => 32)\n            a ++# dash ++# b ++# dash ++# c ++# dash ++# d ++# dash ++# e\n            |> new_guid\n    run_target \\|\n        | Zig => \\ () => body ()\n        | _ => body",
  timeout: 300_000
)
```

#### hash_guid (test)

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":"///- --test --symbol\n///> gleam\n///> cuda\n///> rust\n///> typescript\n\n\"\"\n|> hash_guid\n|> _assert_eq' (\"00000000-0000-0000-0000-000000000000\" |> new_guid)\n\n\"123456789012345678901234567890123\"\n|> hash_guid\n|> _assert_eq' (\"12345678-9012-3456-7890-123456789012\" |> new_guid)","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  ///- --test --symbol
  ///> gleam
  ///> cuda
  ///> rust
  ///> typescript

  ""
  |> hash_guid
  |> _assert_eq' ("00000000-0000-0000-0000-000000000000" |> new_guid)

  "123456789012345678901234567890123"
  |> hash_guid
  |> _assert_eq' ("12345678-9012-3456-7890-123456789012" |> new_guid)
  """,
  timeout: 300_000
)
```

#### to_string_is_lowercase_text (test)

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":"///- --test --symbol\n///> rust\n///> zig\n///> cuda\n///> gleam\n///> lua\n\n\"6543210F-EDCB-A987-6543-210FEDCBA987\"\n|> new_guid\n|> to_string\n|> _assert_eq \"6543210f-edcb-a987-6543-210fedcba987\"","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  ///- --test --symbol
  ///> rust
  ///> zig
  ///> cuda
  ///> gleam
  ///> lua

  "6543210F-EDCB-A987-6543-210FEDCBA987"
  |> new_guid
  |> to_string
  |> _assert_eq "6543210f-edcb-a987-6543-210fedcba987"
  """,
  timeout: 300_000
)
```

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":"///> fsharp\n\n:= main () =\n    $'let new_guid x = !new_guid x' : ()\n    $'let hash_guid x = !hash_guid x' : ()\n    $'let new_raw_guid x = !new_raw_guid x' : ()","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  ///> fsharp

  := main () =
      $'let new_guid x = !new_guid x' : ()
      $'let hash_guid x = !hash_guid x' : ()
      $'let new_raw_guid x = !new_raw_guid x' : ()
  """,
  timeout: 300_000
)
```
