:# iggy static =
    :< testing

:| event_body =
    | JobStarted : { job : string; label : string }
    | JobStep : { job : string; step : string; exit : i32; detail : string }
    | JobDone : { job : string; exit : i32 }
    | JobStop : { job : string; reason : string }
    | LeaseAcquired : { tree : string; owner : string }
    | LeaseReleased : { tree : string; owner : string }
    | SlotAdmitted : { slot : i32; owner : string }
    | SlotReleased : { slot : i32; owner : string }
    | Health : { cpu : i32; free_mem_mb : i32; free_disk_gb : i32 }
    | Toolchain : { tool : string; version : string; path : string; mtime : string }

:== event = { seq : u64; machine : string; body : event_body }

:~ cat (a : array u8) (b : array u8) : array u8 = a ++ b

:~ put_u32 (n : u32) : array u8 =
    ;[
        conv ((n >>> 24i32) &&& 255u32) : u8
        conv ((n >>> 16i32) &&& 255u32) : u8
        conv ((n >>> 8i32) &&& 255u32) : u8
        conv (n &&& 255u32) : u8
    ]

:~ put_u64 (n : u64) : array u8 = cat (put_u32 (conv (n >>> 32i32))) (put_u32 (conv (n &&& 4294967295u64)))

:~ put_i32 (n : i32) : array u8 = put_u32 (conv n)

:~ put_str (s : string) : array u8 =
    := bytes : array u8 = array (sm'::utf8_byte_list s |> listm'::to_array')
    cat (put_u32 (conv (am'::length bytes))) bytes

:~ body_tag (b : event_body) : u8 =
    := tag : i32 = ~> real_core::union_tag b
    conv tag

:~ body_bytes (b : event_body) : array u8 =
    ?= b ?|
    | JobStarted r => cat (put_str r::job) (put_str r::label)
    | JobStep r => cat (put_str r::job) (cat (put_str r::step) (cat (put_i32 r::exit) (put_str r::detail)))
    | JobDone r => cat (put_str r::job) (put_i32 r::exit)
    | JobStop r => cat (put_str r::job) (put_str r::reason)
    | LeaseAcquired r => cat (put_str r::tree) (put_str r::owner)
    | LeaseReleased r => cat (put_str r::tree) (put_str r::owner)
    | SlotAdmitted r => cat (put_i32 r::slot) (put_str r::owner)
    | SlotReleased r => cat (put_i32 r::slot) (put_str r::owner)
    | Health r => cat (put_i32 r::cpu) (cat (put_i32 r::free_mem_mb) (put_i32 r::free_disk_gb))
    | Toolchain r => cat (put_str r::tool) (cat (put_str r::version) (cat (put_str r::path) (put_str r::mtime)))

:~ wire_version () : u8 = 1u8

:~ encode (e : event) : array u8 =
    cat ;[ wire_version () ] (cat (put_u64 e::seq) (cat (put_str e::machine) (cat ;[ body_tag e::body ] (body_bytes e::body))))

:~ ^ hex_upper (a : array u8) (i : i32) (acc : string) : string =
    ? i < 0i32
    ?> acc
    |:
        := b : u64 = conv (am'::index i a)
        := digit (n : u64) = sm'::substring (conv n : i32) 1i32 "0123456789ABCDEF"
        hex_upper a (i - 1i32) (sm'::concat_list "" [ digit (b >>> 4i32); digit (b &&& 15u64); acc ])

///- --timeout 600000

///> rust
:# frozen_bytes_1 =
    := frozen (body : event_body) (expected : string) =
        := bytes = encode { seq = 1u64; machine = "node"; body }
        _assert_eq expected (hex_upper bytes ((conv (am'::length bytes) : i32) - 1i32) "")
    frozen
        (JobStarted { job = "j1"; label = "build" })
        "010000000000000001000000046E6F646500000000026A31000000056275696C64",
    frozen
        (JobStep { job = "j1"; step = "compile"; exit = 0i32; detail = "ok" })
        "010000000000000001000000046E6F646501000000026A3100000007636F6D70696C6500000000000000026F6B",
    frozen (JobDone { job = "j1"; exit = 0i32 }) "010000000000000001000000046E6F646502000000026A3100000000",
    frozen
        (JobStop { job = "j1"; reason = "memory" })
        "010000000000000001000000046E6F646503000000026A31000000066D656D6F7279",
    frozen
        (LeaseAcquired { tree = "kit"; owner = "compiler" })
        "010000000000000001000000046E6F646504000000036B697400000008636F6D70696C6572"

///- --timeout 600000

///> rust
:# frozen_bytes_2 =
    := frozen (body : event_body) (expected : string) =
        := bytes = encode { seq = 1u64; machine = "node"; body }
        _assert_eq expected (hex_upper bytes ((conv (am'::length bytes) : i32) - 1i32) "")
    frozen
        (LeaseReleased { tree = "kit"; owner = "compiler" })
        "010000000000000001000000046E6F646505000000036B697400000008636F6D70696C6572",
    frozen
        (SlotAdmitted { slot = 1i32; owner = "compiler" })
        "010000000000000001000000046E6F6465060000000100000008636F6D70696C6572",
    frozen
        (SlotReleased { slot = 1i32; owner = "compiler" })
        "010000000000000001000000046E6F6465070000000100000008636F6D70696C6572",
    frozen
        (Health { cpu = 63i32; free_mem_mb = 7500i32; free_disk_gb = 84i32 })
        "010000000000000001000000046E6F6465080000003F00001D4C00000054",
    frozen
        (Toolchain { tool = "perl"; version = "5.42.3"; path = "p"; mtime = "2026-10-26" })
        "010000000000000001000000046E6F646509000000047065726C00000006352E34322E3300000001700000000A323032362D31302D3236"

:~ read_u32 (a : array u8) (i : i32) : u32 =
    (conv (am'::index i a) <<< 24i32)
    ||| (conv (am'::index (i + 1i32) a) <<< 16i32)
    ||| (conv (am'::index (i + 2i32) a) <<< 8i32)
    ||| conv (am'::index (i + 3i32) a)

:~ read_u64 (a : array u8) (i : i32) : u64 =
    (conv (read_u32 a i) <<< 32i32) ||| conv (read_u32 a (i + 4i32))

:~ read_i32 (a : array u8) (i : i32) : i32 = conv (read_u32 a i)

:| rd t =
    | RD : t * i32
    | RTrunc
    | RUtf8

:| decode_result =
    | Decoded : event
    | Truncated
    | UnknownTag : u8
    | NotUtf8
    | TrailingBytes : i32
    | UnknownVersion : u8

:= need (i : i32) (w : i32) (len : i32) : bool =
    i >= 0i32 && w >= 0i32 && i <= len && w <= len - i

:~ rd_u64 (a : array u8) (i : i32) (len : i32) : rd u64 =
    ? need i 8i32 len ?> RD (read_u64 a i, i + 8i32) |: RTrunc

:~ rd_i32 (a : array u8) (i : i32) (len : i32) : rd i32 =
    ? need i 4i32 len ?> RD (read_i32 a i, i + 4i32) |: RTrunc

:~ rd_u8 (a : array u8) (i : i32) (len : i32) : rd u8 =
    ? need i 1i32 len ?> RD (am'::index i a, i + 1i32) |: RTrunc

:= rd_str_utf8_rust (a : array u8) (i : i32) (n : i32) : rd string =
    := bytes = am'::init_base (conv n) (\ j => am'::index (conv i + 4i32 + j) a) |> am'::to_vec
    ?= (sm'::string_from_utf8 bytes |> resultm::ok' |> optionm'::unbox) ?|
    | Some s => RD (sm'::from_std_string s, i + 4i32 + n)
    | None => RUtf8

:= iggy_gleam_bytes () =
    global "import gleam/bit_array"
    global """
        @external(erlang, "erlang", "list_to_binary")
        fn spiral_iggy_bytes(bytes: List(Int)) -> BitArray
        """

:= gleam_utf8 \* t. (bytes : t) : resultm::result' string () =
    iggy_gleam_bytes ()
    $'bit_array.to_string(spiral_iggy_bytes(!bytes))' : resultm::result' string ()

:= rd_str_utf8_gleam (a : array u8) (i : i32) (n : i32) : rd string =
    := bytes = am'::init_base (conv n) (\ j => am'::index (conv i + 4i32 + j) a) |> am'::to_list_base'
    ?= gleam_utf8 bytes |> resultm::unbox ?|
    | Ok s => RD (s, i + 4i32 + n)
    | Error _ => RUtf8

:~ rd_str_utf8 (a : array u8) (i : i32) (n : i32) : rd string =
    backend_switch {
        Rust = \ () => rd_str_utf8_rust a i n
        Gleam = \ () => rd_str_utf8_gleam a i n
    }

:~ rd_str (a : array u8) (i : i32) (len : i32) : rd string =
    := have_len = need i 4i32 len
    := n = ? have_len ?> conv (read_u32 a i) |: 0i32
    ? have_len && need (i + 4i32) n len ?> rd_str_utf8 a i n |: RTrunc

:~ rd_bind \* t u. (m : rd t) (f : t -> i32 -> rd u) : rd u =
    ?= m ?|
    | RTrunc => RTrunc
    | RUtf8 => RUtf8
    | RD (x, i) => f x i

:~ finish (e : event) (final : i32) (len : i32) : decode_result =
    ? final = len ?> Decoded e |: TrailingBytes (len - final)

:~ complete (seq : u64) (machine : string) (len : i32) (r : rd event_body) : decode_result =
    ?= r ?|
    | RTrunc => Truncated
    | RUtf8 => NotUtf8
    | RD (body, final) => finish { seq; machine; body } final len

:== slots = { t0 : string; t1 : string; t2 : string; t3 : string; n0 : i32; n1 : i32; n2 : i32 }

:~ empty_slots () : slots = { t0 = ""; t1 = ""; t2 = ""; t3 = ""; n0 = 0i32; n1 = 0i32; n2 = 0i32 }

:~ kinds_of (tag : i32) : string =
    ? tag = 0i32 || tag = 3i32 || tag = 4i32 || tag = 5i32 ?> "tt"
    |? tag = 1i32 ?> "ttnt"
    |? tag = 2i32 ?> "tn"
    |? tag = 6i32 || tag = 7i32 ?> "nt"
    |? tag = 8i32 ?> "nnn"
    |? tag = 9i32 ?> "tttt"
    |: ""

:~ with_text (r : slots) (k : i32) (s : string) : slots =
    ? k = 0i32 ?> { r ?| t0 = s } |? k = 1i32 ?> { r ?| t1 = s } |? k = 2i32 ?> { r ?| t2 = s } |: { r ?| t3 = s }

:~ with_number (r : slots) (k : i32) (n : i32) : slots =
    ? k = 0i32 ?> { r ?| n0 = n } |? k = 1i32 ?> { r ?| n1 = n } |: { r ?| n2 = n }

:~ ^ fill (a : array u8) (kinds : string) (p : i32) (i : i32) (len : i32) (r : slots) (tk : i32) (nk : i32) : rd slots =
    ? p >= sm'::length kinds ?> RD (r, i) |:
        ? sm'::index p kinds = 't' ?> fill_text a kinds p i len r tk nk |: fill_number a kinds p i len r tk nk

:& :~ fill_text (a : array u8) (kinds : string) (p : i32) (i : i32) (len : i32) (r : slots) (tk : i32) (nk : i32) : rd slots =
    ?= rd_str a i len ?|
    | RD (s, j) => fill a kinds (p + 1i32) j len (with_text r tk s) (tk + 1i32) nk
    | RTrunc => RTrunc
    | RUtf8 => RUtf8

:& :~ fill_number (a : array u8) (kinds : string) (p : i32) (i : i32) (len : i32) (r : slots) (tk : i32) (nk : i32) : rd slots =
    ?= rd_i32 a i len ?|
    | RD (n, j) => fill a kinds (p + 1i32) j len (with_number r nk n) tk (nk + 1i32)
    | RTrunc => RTrunc
    | RUtf8 => RUtf8

:~ body_of (tag : i32) (r : slots) : event_body =
    ? tag = 0i32 ?> JobStarted { job = r.t0; label = r.t1 }
    |? tag = 1i32 ?> JobStep { job = r.t0; step = r.t1; exit = r.n0; detail = r.t2 }
    |? tag = 2i32 ?> JobDone { job = r.t0; exit = r.n0 }
    |? tag = 3i32 ?> JobStop { job = r.t0; reason = r.t1 }
    |? tag = 4i32 ?> LeaseAcquired { tree = r.t0; owner = r.t1 }
    |? tag = 5i32 ?> LeaseReleased { tree = r.t0; owner = r.t1 }
    |? tag = 6i32 ?> SlotAdmitted { slot = r.n0; owner = r.t0 }
    |? tag = 7i32 ?> SlotReleased { slot = r.n0; owner = r.t0 }
    |? tag = 8i32 ?> Health { cpu = r.n0; free_mem_mb = r.n1; free_disk_gb = r.n2 }
    |: Toolchain { tool = r.t0; version = r.t1; path = r.t2; mtime = r.t3 }

:~ body_read (tag : i32) (r : rd slots) : rd event_body =
    ?= r ?|
    | RD (s, j) => RD (body_of tag s, j)
    | RTrunc => RTrunc
    | RUtf8 => RUtf8

:~ body_at (tag : u8) (a : array u8) (i : i32) (len : i32) : option (rd event_body) =
    := t = conv tag : i32
    := kinds = kinds_of t
    ? kinds = "" ?> None |: Some (body_read t (fill a kinds 0i32 i len (empty_slots ()) 0i32 0i32))

:~ header_at (a : array u8) (len : i32) : rd (u64 * string * u8) =
    rd_bind (rd_u64 a 1i32 len) \ seq i0 =>
        rd_bind (rd_str a i0 len) \ machine i1 => rd_bind (rd_u8 a i1 len) (\ tag i2 => RD ((seq, machine, tag), i2))

:~ tagged (a : array u8) (len : i32) (seq : u64) (machine : string) (tag : u8) (i : i32) : decode_result =
    ?= body_at tag a i len ?|
    | Some body => complete seq machine len body
    | None => UnknownTag tag

:~ decode_current (a : array u8) (len : i32) : decode_result =
    ?= header_at a len ?|
    | RTrunc => Truncated
    | RUtf8 => NotUtf8
    | RD ((seq, machine, tag), i) => tagged a len seq machine tag i

:~ decode (a : array u8) : decode_result =
    := len = conv (am'::length a) : i32
    ?= rd_u8 a 0i32 len ?|
    | RD (version, _) ?& version = wire_version () => decode_current a len
    | RD (version, _) => UnknownVersion version
    | _ => Truncated

///- --timeout 600000

///> rust
///> gleam
:# every_case_keeps_its_declaration_order_as_wire_tag =
    := ~s = "s"
    := ~n = 1i32
    [
        JobStarted { job = s; label = s }
        JobStep { job = s; step = s; exit = n; detail = s }
        JobDone { job = s; exit = n }
        JobStop { job = s; reason = s }
        LeaseAcquired { tree = s; owner = s }
        LeaseReleased { tree = s; owner = s }
        SlotAdmitted { slot = n; owner = s }
        SlotReleased { slot = n; owner = s }
        Health { cpu = n; free_mem_mb = n; free_disk_gb = n }
        Toolchain { tool = s; version = s; path = s; mtime = s }
    ]
    |> listm::map body_tag
    |> _assert_eq [ 0u8; 1u8; 2u8; 3u8; 4u8; 5u8; 6u8; 7u8; 8u8; 9u8 ]

///> rust
///> gleam
:# codec_round_trip_1 =
    := rt (ev : event) = _assert_eq (Decoded ev) (decode (encode ev))
    := ~e0 : event = { seq = 1u64; machine = "node"; body = JobStarted { job = "j1"; label = "build" } }
    := ~e1 : event =
        { seq = 1u64; machine = "node"; body = JobStep { job = "j1"; step = "compile"; exit = 0i32; detail = "ok" } }
    := ~e3 : event = { seq = 1u64; machine = "node"; body = JobStop { job = "j1"; reason = "memory" } }
    rt e0, rt e1, rt e3

///- --timeout 600000

///> rust
///> gleam
:# codec_round_trip_2 =
    := rt (ev : event) = _assert_eq (Decoded ev) (decode (encode ev))
    := ~e4 : event = { seq = 1u64; machine = "node"; body = LeaseAcquired { tree = "kit"; owner = "compiler" } }
    := ~e5 : event = { seq = 1u64; machine = "node"; body = LeaseReleased { tree = "kit"; owner = "compiler" } }
    := ~e6 : event = { seq = 1u64; machine = "node"; body = SlotAdmitted { slot = 1i32; owner = "compiler" } }
    (rt e4, rt e5, rt e6)

///- --timeout 600000

///> rust
///> gleam
:# codec_round_trip_3 =
    := rt (ev : event) = _assert_eq (Decoded ev) (decode (encode ev))
    := ~e7 : event = { seq = 1u64; machine = "node"; body = SlotReleased { slot = 1i32; owner = "compiler" } }
    := ~e8 : event =
        { seq = 1u64; machine = "node"; body = Health { cpu = 63i32; free_mem_mb = 7500i32; free_disk_gb = 84i32 } }
    := ~e9 : event =
        {
            seq = 1u64
            machine = "node"
            body = Toolchain { tool = "perl"; version = "5.42.3"; path = "p"; mtime = "2026-10-26" }
        }
    rt e7, rt e8, rt e9

///- --timeout 600000

///> rust
:# malformed_input_is_refused =
    := ~jd : event = { seq = 1u64; machine = "node"; body = JobDone { job = "j1"; exit = 0i32 } }
    := ~truncated : array u8 =
        ;[
            1u8
            0u8
            0u8
            0u8
            0u8
            0u8
            0u8
            0u8
            1u8
            0u8
            0u8
            0u8
            4u8
            110u8
            111u8
            100u8
            101u8
            2u8
            0u8
            0u8
            0u8
            2u8
            106u8
            49u8
            0u8
            0u8
            0u8
        ]
    := ~tagged : array u8 =
        ;[
            1u8
            0u8
            0u8
            0u8
            0u8
            0u8
            0u8
            0u8
            1u8
            0u8
            0u8
            0u8
            4u8
            110u8
            111u8
            100u8
            101u8
            42u8
            0u8
            0u8
            0u8
            2u8
            106u8
            49u8
            0u8
            0u8
            0u8
            0u8
        ]
    _assert_eq (Decoded jd) (decode (encode jd))
    _assert_eq Truncated (decode truncated)
    _assert_eq (TrailingBytes 1i32) (decode (encode jd ++ ;[ 0u8 ]))
    _assert_eq (UnknownTag 42u8) (decode tagged)

///- --timeout 600000

///> rust
///> gleam
:# a_string_that_is_not_utf8_is_refused =
    := ~bad : array u8 = ;[ 1u8; 0u8; 0u8; 0u8; 0u8; 0u8; 0u8; 0u8; 1u8; 0u8; 0u8; 0u8; 1u8; 255u8; 2u8; 0u8; 0u8; 0u8; 0u8 ]
    _assert_eq NotUtf8 (decode bad)

///> rust
///> gleam
:# an_unknown_wire_version_is_refused_before_the_header =
    _assert_eq (UnknownVersion 2u8) (decode ;[ 2u8; 0u8 ])
    _assert_eq Truncated (decode ;[])
