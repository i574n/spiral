<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":":= enumerate \\* t. (iter : into_iterator t) : into_iterator (pair convert::unativeint t) =\n    !\\($'\"!iter.enumerate()\"')\n\n:= into_iter \\* (t : * -> *) u. (x : t u) : into_iterator u =\n    !\\($'\"!x.into_iter()\"')\n\n:= iter \\* (t : * -> *) u. (x : t u) : into_iterator u =\n    !\\\\(x, $'\"$0.iter()\"')\n\n:= iter_ref \\* (t : * -> *) u. (x : t u) : into_iterator (rust::ref u) =\n    !\\\\(x, $'\"$0.iter()\"')\n\n:= iter_ref' \\* (t : * -> *) u. (x : rust::ref (t u)) : into_iterator (rust::ref u) =\n    !\\\\(x, $'\"$0.iter()\"')\n\n:= iter_ref'' \\* (t : * -> *) u (v : * -> *). (x : v (t u)) : into_iterator (rust::ref u) =\n    !\\\\(x, $'\"$0.iter()\"')\n\n:= iter_ref''' \\* (t : * -> *) u (v : * -> *) (w : * -> *). (x : w (v (t u))) : into_iterator (rust::ref u) =\n    !\\\\(x, $'\"$0.iter()\"')\n\n:= map \\* t u. (fn : t -> u) (iter : into_iterator t) : into_iterator u =\n    !\\\\(fn, $'\"!iter.map(|x| $0(x))\"')\n\n:= cloned \\* t. (iter : into_iterator (rust::ref t)) : into_iterator t =\n    !\\($'\"!iter.cloned()\"')\n\n:= for_each \\* t. (fn : t -> ()) (iter : into_iterator t) : () =\n    (!\\\\(fn, $'\"true; !iter.for_each(|x| $0(x))\"') : bool) |> ignore\n\n:= try_for_each \\* t. (fn : t -> rust::try ()) x : resultm::result' () string =\n    (!\\($'\"true; let mut !x = !x; let _iter_try_for_each = !x.try_for_each(|x| { //\"') : bool) |> ignore\n    (!\\\\(fn !\\($'\"x\"'), $'\"true; $0 }); //\"') : bool) |> ignore\n    !\\($'\"_iter_try_for_each.map_err(|x| x.into())\"')\n\n:= all \\* t. (fn : t -> bool) (x : rust::mut' (into_iterator t)) : bool =\n    x |> rust::to_mut\n    !\\\\(fn, $'$\"!x.all(|x| $0(x))\"')\n\n:= enumerate \\* t. (ar : array t) : array (convert::unativeint * t) =\n    := (array ar) = ar\n    ar\n    |> am'::to_vec\n    |> into_iter\n    |> enumerate\n    |> iter_collect\n    |> am'::vec_map' from_pair\n    |> am'::from_vec","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  := enumerate \* t. (iter : into_iterator t) : into_iterator (pair convert::unativeint t) =
      !\($'"!iter.enumerate()"')

  := into_iter \* (t : * -> *) u. (x : t u) : into_iterator u =
      !\($'"!x.into_iter()"')

  := iter \* (t : * -> *) u. (x : t u) : into_iterator u =
      !\\(x, $'"$0.iter()"')

  := iter_ref \* (t : * -> *) u. (x : t u) : into_iterator (rust::ref u) =
      !\\(x, $'"$0.iter()"')

  := iter_ref' \* (t : * -> *) u. (x : rust::ref (t u)) : into_iterator (rust::ref u) =
      !\\(x, $'"$0.iter()"')

  := iter_ref'' \* (t : * -> *) u (v : * -> *). (x : v (t u)) : into_iterator (rust::ref u) =
      !\\(x, $'"$0.iter()"')

  := iter_ref''' \* (t : * -> *) u (v : * -> *) (w : * -> *). (x : w (v (t u))) : into_iterator (rust::ref u) =
      !\\(x, $'"$0.iter()"')

  := map \* t u. (fn : t -> u) (iter : into_iterator t) : into_iterator u =
      !\\(fn, $'"!iter.map(|x| $0(x))"')

  := cloned \* t. (iter : into_iterator (rust::ref t)) : into_iterator t =
      !\($'"!iter.cloned()"')

  := for_each \* t. (fn : t -> ()) (iter : into_iterator t) : () =
      (!\\(fn, $'"true; !iter.for_each(|x| $0(x))"') : bool) |> ignore

  := try_for_each \* t. (fn : t -> rust::try ()) x : resultm::result' () string =
      (!\($'"true; let mut !x = !x; let _iter_try_for_each = !x.try_for_each(|x| { //"') : bool) |> ignore
      (!\\(fn !\($'"x"'), $'"true; $0 }); //"') : bool) |> ignore
      !\($'"_iter_try_for_each.map_err(|x| x.into())"')

  := all \* t. (fn : t -> bool) (x : rust::mut' (into_iterator t)) : bool =
      x |> rust::to_mut
      !\\(fn, $'$"!x.all(|x| $0(x))"')

  := enumerate \* t. (ar : array t) : array (convert::unativeint * t) =
      := (array ar) = ar
      ar
      |> am'::to_vec
      |> into_iter
      |> enumerate
      |> iter_collect
      |> am'::vec_map' from_pair
      |> am'::from_vec
  """,
  timeout: 300_000
)
```

#### enumerate (test)

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":"///- --test --symbol\n///> rust\n\nam'::init_series 0i32 2 1\n|> \\ x => array x : array _\n|> enumerate\n|> \\ (array x : array _) => x\n|> _assert_eq' (am'::base ;[ convert::convert 0i32, 0; convert::convert 1i32, 1; convert::convert 2i32, 2 ])","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  ///- --test --symbol
  ///> rust

  am'::init_series 0i32 2 1
  |> \ x => array x : array _
  |> enumerate
  |> \ (array x : array _) => x
  |> _assert_eq' (am'::base ;[ convert::convert 0i32, 0; convert::convert 1i32, 1; convert::convert 2i32, 2 ])
  """,
  timeout: 300_000
)
```
