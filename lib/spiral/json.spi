///> c
///> rust
:# json static =
    :< testing

:= decode \* t. (text : string) : t =
    ~> json_real::decode text `t

:= tool_schema \* t. (name : string) (_ : t) : string =
    ~> json_real::tool_schema name `t

:= hex_digit (d : i32) : string = sm'::slice d d "0123456789abcdef"

:= unicode_escape (c : i32) : string = sm'::concat_list "" [ "\\u00"; hex_digit (c / 16i32); hex_digit (c % 16i32) ]

:= short_escape (c : i32) : option string =
    ? c = 8i32 ?> Some "\\b" |? c = 9i32 ?> Some "\\t" |? c = 10i32 ?> Some "\\n"
    |? c = 12i32 ?> Some "\\f" |? c = 13i32 ?> Some "\\r" |: None

:= control_escape (c : i32) : string =
    ?= short_escape c ?|
    | Some e => e
    | None => unicode_escape c

:~ ^ controls_from (c : i32) (t : string) : string =
    ? c >= 32i32 ?> t |: controls_from (c + 1i32) (sm'::replace (unicode::char_of c) (control_escape c) t)

:= rust_quote (s : string) : string =
    global """
pub fn spiral_json_quote(s: &str) -> std::rc::Rc<str> {
    let (q, b) = (char::from(34u8), char::from(92u8));
    let mut out = String::from(q);
    for c in s.chars() {
        match c as u32 {
            34 | 92 => { out.push(b); out.push(c); }
            n @ (8 | 9 | 10 | 12 | 13) => { out.push(b); out.push(char::from(b"btn_fr"[(n - 8) as usize])); }
            n if n < 32 => out.push_str(&format!("{b}u{n:04x}")),
            _ => out.push(c),
        }
    }
    out.push(q);
    std::rc::Rc::from(out.as_str())
}
"""
    $'spiral_json_quote(&*!s)' : string

:= quote (s : string) : string =
    run_target \|
        | Rust => \ () => rust_quote s
        | _ => \ () =>
            := escaped = s |> sm'::replace "\\" "\\\\" |> sm'::replace "\"" "\\\"" |> controls_from 0i32
            sm'::concat_list "" [ "\""; escaped; "\"" ]

///> rust
///> gleam
:# quote_escapes_quote_and_backslash =
    quote "a\"b\\c" |> _assert_eq "\"a\\\"b\\\\c\""

///> rust
///> gleam
:# quote_uses_short_forms_for_common_controls =
    quote "x\ny\tz" |> _assert_eq "\"x\\ny\\tz\""

///> rust
///> gleam
:# quote_uses_short_forms_for_backspace_formfeed_and_return =
    quote (sm'::concat_list "" [ unicode::char_of 8i32; unicode::char_of 12i32; unicode::char_of 13i32 ]) |> _assert_eq "\"\\b\\f\\r\""

///> rust
///> gleam
:# quote_escapes_every_other_control_as_u00xx =
    quote (sm'::concat_list "" [ unicode::char_of 1i32; unicode::char_of 31i32 ]) |> _assert_eq "\"\\u0001\\u001f\""

:== weather_query = { location : string; days : i32; metric : bool }

///> c
///> rust
:# decode_reads_a_flat_record =
    := ~reply = "{\"location\":\"Cincinnati\",\"days\":3,\"metric\":true}"
    := q : weather_query = decode reply
    := bonus = ? q::metric ?> 100i32 |: 0i32
    q::days + bonus + sm::length q::location
    |> _assert_eq 113i32

:== city_query = { city : string; days : option i32; units : option string }

:= city_query_score (q : city_query) : i32 =
    := days = ?= q::days ?| | Some d => d | None => 0i32
    := units = ?= q::units ?| | Some _ => 100i32 | None => 50i32
    days + units + sm::length q::city

///> c
///> rust
:# decode_fills_missing_options_with_none =
    := ~reply = "{\"city\":\"Recife\",\"days\":4}"
    city_query_score (decode reply) |> _assert_eq 60i32

:== place = { city : string; days : i32 }
:== forecast_query = { days : i32; where : place; metric : bool }

:= forecast_score (args : forecast_query) : i32 =
    := bonus = ? args::metric ?> 100i32 |: 0i32
    args::days + bonus + args::where::days + sm::length args::where::city

///> c
///> rust
:# decode_reads_nested_records =
    := ~reply = "{\"days\":3,\"where\":{\"city\":\"Cincinnati\",\"days\":40},\"metric\":true}"
    forecast_score (decode reply) |> _assert_eq 153i32

///> c
///> rust
:# decode_matches_keys_at_their_own_depth =
    := ~reply =
        "{\"where\":{\"city\":\"Cincinnati\",\"days\":40},\"note\":\"\\\"days\\\":9\",\"days\":3,\"metric\":true}"
    forecast_score (decode reply) |> _assert_eq 153i32

:== tagged_order = { customer : string; quantities : array_base i32; tags : array_base string }

:= quantities_score (q : array i32) : i32 = length q * 1000i32 + index q 0i32 + index q 1i32 + index q 2i32

:= tags_score (t : array string) : i32 = sm::length (index t 0i32) * 10000i32 + sm::length (index t 1i32) * 100000i32

:= tagged_score (o : tagged_order) : i32 = quantities_score (array o::quantities) + tags_score (array o::tags)

///> c
///> rust
:# decode_reads_arrays_of_scalars =
    := ~reply = "{\"customer\":\"ana\",\"quantities\":[3, 40, 200],\"tags\":[\"a,b\", \"]x\"]}"
    tagged_score (decode reply) |> _assert_eq 233243i32

:== order_line = { sku : string; qty : i32 }
:== line_order = { customer : string; lines : array_base order_line }

:= lines_score (count : i32) (first : order_line) (second : order_line) : i32 =
    count * 1000i32 + first::qty + second::qty + sm::length first::sku * 100i32 + sm::length second::sku * 10000i32

:= line_score (o : line_order) : i32 =
    := lines : array order_line = array o::lines
    lines_score (length lines) (index lines 0i32) (index lines 1i32)

///> c
///> rust
:# decode_reads_arrays_of_records =
    := ~reply = "{\"customer\":\"ana\",\"lines\":[{\"sku\":\"p1\",\"qty\":2}, {\"sku\":\"p22\",\"qty\":30}]}"
    line_score (decode reply) |> _assert_eq 32232i32

:| units = Metric | Imperial
:| target = TargetCity : string | TargetHere | TargetGrid : { row : i32; col : i32 }
:== target_request = { units : units; where : target; other : target }

:= where_score (where : target) : i32 =
    ?= where ?| | TargetCity name => sm::length name * 10i32 | TargetHere => 0i32 | TargetGrid _ => 9i32

:= other_score (other : target) : i32 = ?= other ?| | TargetGrid g => g::row * 1000i32 + g::col * 100i32 | _ => 0i32

:= target_score (r : target_request) : i32 =
    := u = ?= r::units ?| | Metric => 1i32 | Imperial => 2i32
    u + where_score r::where + other_score r::other

///> c
///> rust
:# decode_reads_unions_by_case_name =
    := ~reply =
        "{\"units\":\"Imperial\",\"where\":{\"TargetCity\":\"Recife\"},\"other\":{\"TargetGrid\":{\"row\":4,\"col\""
        ^^ ":7}}}"
    target_score (decode reply) |> _assert_eq 4762i32

:| spot = SpotAt : i32 * i32 | SpotHere
:== span_request = { span : i32 * string; where : spot }

:= span_score (r : span_request) : i32 =
    := n, unit_name = r::span
    := w = ?= r::where ?| | SpotAt (x, y) => x * 1000i32 + y * 100i32 | SpotHere => 0i32
    n + sm::length unit_name * 10000i32 + w

///> c
///> rust
:# decode_reads_tuples_as_pairs =
    := ~reply = "{\"span\":[12, \"days\"],\"where\":{\"SpotAt\":[3, 9]}}"
    span_score (decode reply) |> _assert_eq 43912i32

:| region = RegionCity : string | RegionPoint : f64 * f64 | RegionHere
:== forecast_args = { where : region; days : option i32; units : units; hours : array_base i32 }

:= forecast_schema_head () : string =
    "{\"name\":\"getForecast\",\"parameters\":{\"type\":\"object\",\"properties\":{\"where\":{\"oneOf\":["

:= forecast_city_schema () : string =
    "{\"type\":\"object\",\"properties\":{\"RegionCity\":{\"type\":\"string\"}},"
    ^^ "\"required\":[\"RegionCity\"]},"

:= forecast_point_schema () : string =
    "{\"type\":\"object\",\"properties\":{\"RegionPoint\":{\"type\":\"array\","
    ^^ "\"prefixItems\":[{\"type\":\"number\"},{\"type\":\"number\"}]}},\"required\":[\"RegionPoint\"]},"

:= forecast_days_units_schema () : string =
    "{\"const\":\"RegionHere\"}]},\"days\":{\"type\":\"integer\"},\"units\":{\"type\":\"string\","
    ^^ "\"oneOf\":[{\"const\":\"Metric\"},{\"const\":\"Imperial\"}]},"

:= forecast_hours_schema () : string =
    "\"hours\":{\"type\":\"array\",\"items\":{\"type\":\"integer\"}}},\"required\":[\"where\",\"units\","
    ^^ "\"hours\"]}}"

:= forecast_schema () : string =
    := head = sm'::concat_list "" [ forecast_schema_head (); forecast_city_schema (); forecast_point_schema () ]
    sm'::concat_list "" [ head; forecast_days_units_schema (); forecast_hours_schema () ]

:= forecast_here () : forecast_args =
    { where = RegionHere; days = None; units = Metric; hours = am'::init_base 3i32 (\ _ => 0i32) }

///> c
///> rust
:# tool_schema_describes_records_unions_options_and_arrays =
    tool_schema "getForecast" (forecast_here ()) |> _assert_eq (forecast_schema ())

:== quote_query = { said : string; path : string; days : i32 }

:= quote_score (q : quote_query) : i32 =
    := exact = ? q::said = "say \"hi\"\n" && q::path = "a\\b" ?> 10000i32 |: 0i32
    exact + q::days + sm::length q::said * 10i32 + sm::length q::path * 1000i32

///> c
///> rust
:# decode_unescapes_strings =
    := ~reply = "{\"said\":\"say \\\"hi\\\"\\n\",\"path\":\"a\\\\b\",\"days\":7}"
    quote_score (decode reply) |> _assert_eq 13097i32

:== stamp = { span : i32 * string * i32; flag : bool }

///> c
///> rust
:# decode_reads_tuples_longer_than_two =
    := ~reply = "{\"span\":[12,\"days\",7],\"flag\":true}"
    := q : stamp = decode reply
    := a, b, c = q::span
    (a, b, c, q::flag) |> _assert_eq (12i32, "days", 7i32, !+)

///> rust
:# quote_escapes_a_json_string_literal =
    testing::expect (quote "plain" = "\"plain\"") "plain text is only wrapped"
    testing::expect (quote "a\"b\\c" = "\"a\\\"b\\\\c\"") "quotes and backslashes are escaped"
    testing::expect (quote "l1\nl2\tx" = "\"l1\\nl2\\tx\"") "newlines and tabs are escaped"
