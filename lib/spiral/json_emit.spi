:# json_emit static =
    :< testing

:< sm'_operators

:= member (acc : string) (name : string) (text : string) : string =
    ? acc = "" ?> name ++# ":" ++# text |: acc ++# "," ++# name ++# ":" ++# text

:= item (acc : string) (text : string) : string = ? acc = "" ?> text |: acc ++# "," ++# text

:= braced (members : string) : string = "{" ++# members ++# "}"

:= bracketed (items : string) : string = "[" ++# items ++# "]"

:= number_text \* t. (x : t) : string = sm'::obj_to_string x

:= bool_text (b : bool) : string = ? b ?> "true" |: "false"

:= nullable \* a. (f : a -> string) (x : option a) : string =
    ?= x ?|
    | Some v => f v
    | None => "null"

:= list_text \* a. (f : a -> string) (xs : list a) : string = xs |> listm::map f |> sm'::concat_list "," |> bracketed

:= array_text \* a. (f : a -> string) (xs : array_base a) : string =
    xs |> am'::map_base f |> array |> sm'::concat_array "," |> bracketed

:= tagged (name : string) (text : string) : string = braced (member "" name text)

///> rust
///> gleam
:# members_join_with_commas_inside_braces =
    braced (member (member "" "\"a\"" "1") "\"b\"" "true") |> _assert_eq "{\"a\":1,\"b\":true}"

///> rust
///> gleam
:# an_absent_value_is_null =
    (nullable number_text (None : option i32), nullable number_text (Some 7i32)) |> _assert_eq ("null", "7")

///> rust
///> gleam
:# lists_are_bracketed_and_comma_joined =
    (list_text number_text [ 1i32; 2i32; 3i32 ], list_text number_text ([] : list i32)) |> _assert_eq ("[1,2,3]", "[]")
