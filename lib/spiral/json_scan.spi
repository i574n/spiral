/// # json_scan

test json_scan static =
    open testing

let rec matches_at (s : string) (needle : string) (at : i32) (i : i32) (m : i32) : bool =
    if i >= m then true
    elif sm.index s (at + i) = sm.index needle i then matches_at s needle at (i + 1i32) m
    else false

let rec find_from (s : string) (needle : string) (at : i32) (n : i32) (m : i32) : i32 =
    if at + m > n then -1i32
    elif matches_at s needle at 0i32 m then at + m
    else find_from s needle (at + 1i32) n m

let rec find_top (s : string) (needle : string) (at : i32) (n : i32) (m : i32) (depth : i32) (in_text : bool) : i32 =
    if at + m > n then -1i32
    else
        inl c = sm.index s at
        if in_text then
            if c = '"' then find_top s needle (at + 1i32) n m depth false
            elif c = '\\' then find_top s needle (at + 2i32) n m depth true
            else find_top s needle (at + 1i32) n m depth true
        elif c = '"' then
            if depth = 1i32 && matches_at s needle at 0i32 m then at + m
            else find_top s needle (at + 1i32) n m depth true
        elif c = '{' || c = '[' then find_top s needle (at + 1i32) n m (depth + 1i32) false
        elif c = '}' || c = ']' then find_top s needle (at + 1i32) n m (depth - 1i32) false
        else find_top s needle (at + 1i32) n m depth false

let value_at (s : string) (key : string) : i32 =
    inl needle = !!!!StaticStringConcat(!!!!StaticStringConcat("\"", key), "\":")
    find_top s needle 0i32 (sm.length s) (sm.length needle) 0i32 false

let digit_of (c : char) : i32 =
    if c = '0'
    then 0i32
    elif c = '1'
    then 1i32
    elif c = '2'
    then 2i32
    elif c = '3'
    then 3i32
    elif c = '4'
    then 4i32
    elif c = '5'
    then 5i32
    elif c = '6'
    then 6i32
    elif c = '7'
    then 7i32
    elif c = '8'
    then 8i32
    elif c = '9'
    then 9i32
    else -1i32

let rec digits (s : string) (at : i32) (n : i32) (acc : i32) : i32 =
    if at >= n then acc
    else
        inl d = digit_of (sm.index s at)
        if d >= 0i32 then digits s (at + 1i32) n (acc * 10i32 + d)
        else acc

let parse_i32 (s : string) (at : i32) : i32 =
    if at < 0i32 then 0i32
    elif sm.index s at = '-' then 0i32 - digits s (at + 1i32) (sm.length s) 0i32
    else digits s at (sm.length s) 0i32

let rec closing_quote (s : string) (at : i32) (n : i32) : i32 =
    if at >= n then n
    else
        inl c = sm.index s at
        if c = '"' then at
        elif c = '\\' then closing_quote s (at + 2i32) n
        else closing_quote s (at + 1i32) n

let text_between (s : string) (from : i32) (until : i32) : string =
    if until <= from then "" else sm.slice s { from = from; to = until - 1i32 }

let hex_digit (c : char) : i32 =
    inl d = digit_of c
    if d >= 0i32 then d
    elif c = 'a' || c = 'A' then 10i32
    elif c = 'b' || c = 'B' then 11i32
    elif c = 'c' || c = 'C' then 12i32
    elif c = 'd' || c = 'D' then 13i32
    elif c = 'e' || c = 'E' then 14i32
    elif c = 'f' || c = 'F' then 15i32
    else -1i32

let hex4 (s : string) (at : i32) (n : i32) : i32 =
    if at + 4i32 > n then -1i32
    else
        inl a = hex_digit (sm.index s at)
        inl b = hex_digit (sm.index s (at + 1i32))
        inl c = hex_digit (sm.index s (at + 2i32))
        inl d = hex_digit (sm.index s (at + 3i32))
        if a < 0i32 || b < 0i32 || c < 0i32 || d < 0i32 then -1i32 else ((a * 16i32 + b) * 16i32 + c) * 16i32 + d

let unicode_escape (s : string) (at : i32) : string * i32 =
    inl n = sm.length s
    inl code = hex4 s (at + 1i32) n
    if code < 0i32 then text_between s (at - 1i32) (at + 1i32), 1i32
    elif code >= 55296i32 && code <= 56319i32 then
        inl paired = at + 11i32 <= n && sm.index s (at + 5i32) = '\\' && sm.index s (at + 6i32) = 'u'
        inl low = if paired then hex4 s (at + 7i32) n else -1i32
        if low >= 56320i32 && low <= 57343i32 then
            unicode.char_of (65536i32 + (code - 55296i32) * 1024i32 + (low - 56320i32)), 11i32
        else unicode.char_of 65533i32, 5i32
    elif code >= 56320i32 && code <= 57343i32 then unicode.char_of 65533i32, 5i32
    else unicode.char_of code, 5i32

let unescaped (s : string) (at : i32) : string * i32 =
    inl c = sm.index s at
    if c = 'n' then "\n", 1i32
    elif c = 't' then "\t", 1i32
    elif c = 'r' then "\r", 1i32
    elif c = '"' then "\"", 1i32
    elif c = '\\' then "\\", 1i32
    elif c = '/' then "/", 1i32
    elif c = 'b' then unicode.char_of 8i32, 1i32
    elif c = 'f' then unicode.char_of 12i32, 1i32
    elif c = 'u' then unicode_escape s at
    else text_between s (at - 1i32) (at + 1i32), 1i32

let rec unescape_from (s : string) (start : i32) (at : i32) (close : i32) (prefix : string) : string =
    if at >= close then !!!!StaticStringConcat(prefix, text_between s start close)
    elif sm.index s at = '\\' then
        inl kept = !!!!StaticStringConcat(prefix, text_between s start at)
        inl piece, width = unescaped s (at + 1i32)
        inl next = at + 1i32 + width
        unescape_from s next next close (!!!!StaticStringConcat(kept, piece))
    else unescape_from s start (at + 1i32) close prefix


let parse_string (s : string) (at : i32) : string =
    if at < 0i32 then ""
    else unescape_from s (at + 1i32) (at + 1i32) (closing_quote s (at + 1i32) (sm.length s)) ""

let parse_bool (s : string) (at : i32) : bool = at >= 0i32 && sm.index s at = 't'

let rec object_end (s : string) (at : i32) (n : i32) (depth : i32) (in_text : bool) : i32 =
    if at >= n then n - 1i32
    else
        inl c = sm.index s at
        if in_text then
            if c = '"' then object_end s (at + 1i32) n depth false
            elif c = '\\' then object_end s (at + 2i32) n depth true
            else object_end s (at + 1i32) n depth true
        elif c = '"' then object_end s (at + 1i32) n depth true
        elif c = '{' then object_end s (at + 1i32) n (depth + 1i32) false
        elif c = '}' then (if depth = 1i32 then at else object_end s (at + 1i32) n (depth - 1i32) false)
        else object_end s (at + 1i32) n depth false

let object_at (s : string) (at : i32) : string =
    if at < 0i32 then "{}"
    else sm.slice s { from = at; to = object_end s at (sm.length s) 0i32 false }

let record_start (starts : array_base i32) (count : i32) (position : i32) : () =
    inl capacity = !!!!ArrayLength(`i32, starts)
    if count < capacity then !!!!ArrayIndexSet(starts, count, position)

let rec item_starts
    (s : string) (at : i32) (n : i32) (depth : i32) (in_text : bool) (count : i32) (starts : array_base i32)
    : i32
    =
    if at >= n then count
    else
        inl c = sm.index s at
        inl next = at + 1i32
        if in_text then
            if c = '"' then item_starts s next n depth false count starts
            elif c = '\\' then item_starts s (at + 2i32) n depth true count starts
            else item_starts s next n depth true count starts
        elif c = '"' then item_starts s next n depth true count starts
        elif c = '[' || c = '{' then
            if depth = 0i32 && c = '[' then
                record_start starts count next
                item_starts s next n (depth + 1i32) false (count + 1i32) starts
            else item_starts s next n (depth + 1i32) false count starts
        elif c = ']' || c = '}' then
            if depth = 1i32 then count else item_starts s next n (depth - 1i32) false count starts
        elif c = ',' && depth = 1i32 then
            record_start starts count next
            item_starts s next n depth false (count + 1i32) starts
        else item_starts s next n depth false count starts

let rec skip_spaces (s : string) (at : i32) : i32 = if sm.index s at = ' ' then skip_spaces s (at + 1i32) else at

let item_positions (s : string) (at : i32) : array_base i32 =
    inl n = sm.length s
    if at < 0i32 then !!!!ArrayCreate(`i32, 0i32)
    elif sm.index s at <> '[' then !!!!ArrayCreate(`i32, 0i32)
    elif sm.index s (skip_spaces s (at + 1i32)) = ']' then !!!!ArrayCreate(`i32, 0i32)
    else
        inl probe : array_base i32 = !!!!ArrayCreate(`i32, 0i32)
        inl count = item_starts s at n 0i32 false 0i32 probe
        inl starts : array_base i32 = !!!!ArrayCreate(`i32, count)
        inl _ = item_starts s at n 0i32 false 0i32 starts
        starts

let parse_i32_array (s : string) (at : i32) : array_base i32 =
    inl starts = item_positions s at
    inl count = !!!!ArrayLength(`i32, starts)
    inl out : array_base i32 = !!!!ArrayCreate(`i32, count)
    let rec fill (i : i32) : () =
        if i < count then
            inl start = !!!!ArrayIndex(starts, i)
            inl value = parse_i32 s (skip_spaces s start)
            !!!!ArrayIndexSet(out, i, value)
            fill (i + 1i32)
    fill 0i32
    out

let parse_string_array (s : string) (at : i32) : array_base string =
    inl starts = item_positions s at
    inl count = !!!!ArrayLength(`i32, starts)
    inl out : array_base string = !!!!ArrayCreate(`string, count)
    let rec fill (i : i32) : () =
        if i < count then
            inl start = !!!!ArrayIndex(starts, i)
            inl value = parse_string s (skip_spaces s start)
            !!!!ArrayIndexSet(out, i, value)
            fill (i + 1i32)
    fill 0i32
    out

let item_count (s : string) (at : i32) : i32 =
    inl starts = item_positions s at
    !!!!ArrayLength(`i32, starts)

let item_start (s : string) (at : i32) (i : i32) : i32 =
    inl starts = item_positions s at
    inl start = !!!!ArrayIndex(starts, i)
    skip_spaces s start

inl fill_array forall el. (count : i32) (item : i32 -> el) : array_base el =
    inl out : array_base el = !!!!ArrayCreate(`el, count)
    let rec fill (i : i32) : () =
        if i < count then
            inl value = item i
            !!!!ArrayIndexSet(out, i, value)
            fill (i + 1i32)
    fill 0i32
    out

let union_case_name (s : string) (at : i32) : string =
    if at < 0i32 then ""
    elif sm.index s at = '"' then parse_string s at
    else
        inl key_at = skip_spaces s (at + 1i32)
        parse_string s key_at

let union_payload_at (s : string) (at : i32) : i32 =
    if at < 0i32 then -1i32
    elif sm.index s at = '"' then -1i32
    else
        inl key_at = skip_spaces s (at + 1i32)
        inl close = closing_quote s (key_at + 1i32) (sm.length s)
        skip_spaces s (close + 2i32)

///> rust
///> gleam
///> c
test parse_string_decodes_unicode_escapes =
    inl ~s = "\"caf\\u00e9 \\ud83d\\ude00 \\ud800 x\\n\""
    inl a = !!!!StaticStringConcat("caf", unicode.char_of 233i32)
    inl b = !!!!StaticStringConcat(!!!!StaticStringConcat(a, " "), unicode.char_of 128512i32)
    inl c = !!!!StaticStringConcat(!!!!StaticStringConcat(b, " "), unicode.char_of 65533i32)
    parse_string s 0i32 |> _assert_eq (!!!!StaticStringConcat(c, " x\n"))

///> rust
///> gleam
///> c
test parse_string_keeps_a_malformed_unicode_escape =
    inl ~s = "\"a\\u12zz\""
    parse_string s 0i32 |> _assert_eq "a\\u12zz"
