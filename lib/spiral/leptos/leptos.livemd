<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"inl action_input forall t u. (action : action (heap t) u) : rw_signal (optionm'.option' t) =\n    !\\\\(action, $'\"leptos::prelude::Action::input(&$0)\"')","print_code":false},"livebook_object":"smart_cell"} -->

