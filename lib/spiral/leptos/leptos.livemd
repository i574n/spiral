)
```

### use_url

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"inl use_url () =\n    inl location = use_location ()\n\n    fun () =>\n        inl url_pathname = location |> location_pathname |> signal_get |> sm'.from_std_string\n        inl url_search = location |> location_search |> signal_get |> sm'.from_std_string\n        inl url_search =\n            if url_search = \"\"\n            then \"\"\n            else \"?\" +. url_search\n        url_pathname +. url_search\n    |> new_arc_memo","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  inl use_url () =
      inl location = use_location ()

      fun () =>
          inl url_pathname = location |> location_pathname |> signal_get |> sm'.from_std_string
          inl url_search = location |> location_search |> signal_get |> sm'.from_std_string
          inl url_search =
              if url_search = ""
              then ""
              else "?" +. url_search
          url_pathname +. url_search
      |> new_arc_memo
  """,
  timeout: 300_000
)
```

### route

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"// leptos_router 0.8 types the route tree statically (`path!` of a literal, the routes a tuple of view! children): a\n// route is view! markup, put together with the others by routes and router into one view! call.\ninl route (path : string) (view : () -> view) : string =\n    tag_closed_raw \"leptos_router::components::Route\" [\n        $'\"path=leptos_router::path\\!(\\\\\\\"\" + !path + \"\\\\\\\")\"'\n        attr_fn \"view\" view\n    ]","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  // leptos_router 0.8 types the route tree statically (`path!` of a literal, the routes a tuple of view! children): a
  // route is view! markup, put together with the others by routes and router into one view! call.
  inl route (path : string) (view : () -> view) : string =
      tag_closed_raw "leptos_router::components::Route" [
          $'"path=leptos_router::path\!(\\\"" + !path + "\\\")"'
          attr_fn "view" view
      ]
  """,
  timeout: 300_000
)
```

