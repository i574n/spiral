### for

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"// For's items and closures must be Send (+ Clone): the items cross as SendWrapper<T> (one Rust value, so a tuple `t`\n// is unpacked in Spiral by send_wrapper_get).\ninl for forall t u (signal : * -> *).\n    (signal : signal (am'.vec t))\n    (key_fn : t -> u)\n    (children' : t -> fragment)\n    : view\n    =\n    signal |> typecheck_signal\n    // read through signal_get' (an arc_memo unwraps its SendWrapper there)\n    inl items = (fun () => signal_get' signal : am'.vec t) |> send_wrapper_new\n    inl key = (fun (x : send_wrapper t) => x |> send_wrapper_get |> key_fn) |> send_wrapper_new\n    inl child = (fun (x : send_wrapper t) => x |> send_wrapper_get |> children' |> fragment_to_view) |> send_wrapper_new\n    for [\n        $'\"each={ move || (*!items)().into_iter().map(leptos::__reexports::send_wrapper::SendWrapper::new).collect::<Vec<_>>() }\"'\n        $'\"key={ move |x: &leptos::__reexports::send_wrapper::SendWrapper<_>| (*!key)(x.clone()) }\"'\n        $'\"children={ move |x: leptos::__reexports::send_wrapper::SendWrapper<_>| (*!child)(x) }\"'\n    ]","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  // For's items and closures must be Send (+ Clone): the items cross as SendWrapper<T> (one Rust value, so a tuple `t`
  // is unpacked in Spiral by send_wrapper_get).
  inl for forall t u (signal : * -> *).
      (signal : signal (am'.vec t))
      (key_fn : t -> u)
      (children' : t -> fragment)
      : view
      =
      signal |> typecheck_signal
      // read through signal_get' (an arc_memo unwraps its SendWrapper there)
      inl items = (fun () => signal_get' signal : am'.vec t) |> send_wrapper_new
      inl key = (fun (x : send_wrapper t) => x |> send_wrapper_get |> key_fn) |> send_wrapper_new
      inl child = (fun (x : send_wrapper t) => x |> send_wrapper_get |> children' |> fragment_to_view) |> send_wrapper_new
      for [
          $'"each={ move || (*!items)().into_iter().map(leptos::__reexports::send_wrapper::SendWrapper::new).collect::<Vec<_>>() }"'
          $'"key={ move |x: &leptos::__reexports::send_wrapper::SendWrapper<_>| (*!key)(x.clone()) }"'
          $'"children={ move |x: leptos::__reexports::send_wrapper::SendWrapper<_>| (*!child)(x) }"'
      ]
  """,
  timeout: 300_000
)
```

