### new_arc_memo

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"// The value is wrapped (see arc_memo). Spiral's unions don't all implement PartialEq, so the change check compares\n// values whose type has PartialEq and treats the others as always changed (autoref dispatch on the concrete type at\n// each memo: a generic helper would always take the second impl).\ninl new_arc_memo forall t. (fn : () -> t) : arc_memo t =\n    global \"pub struct SpiralMemoChanged<'a, T>(pub Option<&'a T>, pub Option<&'a T>);\\npub trait SpiralMemoChangedEq { fn spiral_memo_changed(&self) -> bool; }\\nimpl<'a, T: PartialEq> SpiralMemoChangedEq for SpiralMemoChanged<'a, T> { fn spiral_memo_changed(&self) -> bool { self.0 != self.1 } }\\npub trait SpiralMemoChangedAny { fn spiral_memo_changed(&self) -> bool; }\\nimpl<'a, T> SpiralMemoChangedAny for &SpiralMemoChanged<'a, T> { fn spiral_memo_changed(&self) -> bool { true } }\"\n    // a closure of its own: its body may return early (`?`) with the plain value\n    inl fn = join fn\n    inl fn = (fun () => fn () |> send_wrapper_new) |> send_wrapper_new\n    $'leptos::prelude::ArcMemo::new_with_compare(move |_| (*!fn)(), |a: Option<&leptos::__reexports::send_wrapper::SendWrapper<`t>>, b: Option<&leptos::__reexports::send_wrapper::SendWrapper<`t>>| (&SpiralMemoChanged(a.map(|x| &**x), b.map(|x| &**x))).spiral_memo_changed())'","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  // The value is wrapped (see arc_memo). Spiral's unions don't all implement PartialEq, so the change check compares
  // values whose type has PartialEq and treats the others as always changed (autoref dispatch on the concrete type at
  // each memo: a generic helper would always take the second impl).
  inl new_arc_memo forall t. (fn : () -> t) : arc_memo t =
      global "pub struct SpiralMemoChanged<'a, T>(pub Option<&'a T>, pub Option<&'a T>);\npub trait SpiralMemoChangedEq { fn spiral_memo_changed(&self) -> bool; }\nimpl<'a, T: PartialEq> SpiralMemoChangedEq for SpiralMemoChanged<'a, T> { fn spiral_memo_changed(&self) -> bool { self.0 != self.1 } }\npub trait SpiralMemoChangedAny { fn spiral_memo_changed(&self) -> bool; }\nimpl<'a, T> SpiralMemoChangedAny for &SpiralMemoChanged<'a, T> { fn spiral_memo_changed(&self) -> bool { true } }"
      // a closure of its own: its body may return early (`?`) with the plain value
      inl fn = join fn
      inl fn = (fun () => fn () |> send_wrapper_new) |> send_wrapper_new
      $'leptos::prelude::ArcMemo::new_with_compare(move |_| (*!fn)(), |a: Option<&leptos::__reexports::send_wrapper::SendWrapper<`t>>, b: Option<&leptos::__reexports::send_wrapper::SendWrapper<`t>>| (&SpiralMemoChanged(a.map(|x| &**x), b.map(|x| &**x))).spiral_memo_changed())'
  """,
  timeout: 300_000
)
```

