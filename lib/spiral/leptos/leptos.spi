nominal dl = $'leptos::html::Dl'

/// ### dt
nominal dt = $'leptos::html::Dt'

/// ### footer
nominal footer = $'leptos::html::Footer'

/// ### header
nominal header = $'leptos::html::Header'

/// ### input
nominal input = $'leptos::html::Input'

/// ### label
nominal label = $'leptos::html::Label'

/// ### main
nominal main = $'leptos::html::Main'

/// ### nav
nominal nav = $'leptos::html::Nav'

/// ### option'
nominal option' = $'leptos::html::Option_'

/// ### pre
nominal pre = $'leptos::html::Pre'

/// ### select
nominal select = $'leptos::html::Select'

/// ### span
nominal span = $'leptos::html::Span'

/// ### summary
nominal summary = $'leptos::html::Summary'

/// ### table
nominal table = $'leptos::html::Table'

/// ### thead
nominal thead = $'leptos::html::Thead'

/// ### tbody
nominal tbody = $'leptos::html::Tbody'

/// ### tr
nominal tr = $'leptos::html::Tr'

/// ### th
nominal th = $'leptos::html::Th'

/// ### td
nominal td = $'leptos::html::Td'

/// ### svg
nominal svg = $'leptos::svg::Svg'

/// ### path
nominal path = $'leptos::svg::Path'

/// ### circle
nominal circle = $'leptos::svg::Circle'

/// ### rect
nominal rect = $'leptos::svg::Rect'

/// ### animate
nominal animate = $'leptos::svg::Animate'

/// ### action
nominal action t u = $'leptos::prelude::Action<`t, `u>'

/// ### arc_action
nominal arc_action t u = $'leptos::prelude::ArcAction<`t, `u>'

/// ### for
nominal for = $'leptos::prelude::For'

/// ### show
nominal show = $'leptos::prelude::Show'

/// ### fragment
// codegenRust moves (doesn't clone) values of the non-Clone leptos::prelude::Fragment, which it recognizes by this
// spelling.
nominal fragment = $'leptos::prelude::Fragment'

/// ### text
nominal text = $'leptos::tachys::renderer::dom::Text'

/// ### route
nominal route = $'leptos_router::Route'

/// ### nested_route
nominal nested_route = $'leptos_router::NestedRoute<_, _, _, _>'

/// ### route_definition
nominal route_definition = $'leptos_router::RouteDefinition'

/// ### router
nominal router = $'leptos_router::Router'

/// ### routes
nominal routes = $'leptos_router::Routes'

/// ### html_element
nominal html_element t = $'leptos::html::HtmlElement<`t, _, _>'

/// ### into_view
nominal into_view = $'leptos::IntoView'

/// ### location
nominal location = $'leptos_router::location::Location'

/// ### navigate_options
nominal navigate_options = $'leptos_router::NavigateOptions'

/// ### url
nominal url = $'leptos_router::location::Url'

/// ### memo
nominal memo t = $'leptos::prelude::Memo<`t>'

/// ### arc_memo
// Spiral values are Rc-based (not Send + Sync), and ArcMemo only has a SyncStorage constructor: the memo holds a
// SendWrapper of the value (wasm is single-threaded), unwrapped by signal_get/signal_get_untracked.
nominal arc_memo t = $'leptos::prelude::ArcMemo<leptos::__reexports::send_wrapper::SendWrapper<`t>>'

/// ### rw_signal
nominal rw_signal t = $'leptos::prelude::RwSignal<`t>'

/// ### arc_rw_signal
nominal arc_rw_signal t = $'leptos::prelude::ArcRwSignal<`t>'

/// ### signal
nominal signal t = $'leptos::prelude::Signal<`t>'

/// ### arc_signal
nominal arc_signal t = $'leptos::prelude::ArcSignal<`t>'

/// ### read_signal
nominal read_signal t = $'leptos::prelude::ReadSignal<`t>'

/// ### arc_read_signal
nominal arc_read_signal t = $'leptos::prelude::ArcReadSignal<`t>'

/// ### write_signal
nominal write_signal t = $'leptos::prelude::WriteSignal<`t>'

/// ### arc_write_signal
nominal arc_write_signal t = $'leptos::prelude::ArcWriteSignal<`t>'

/// ### resource
nominal resource t u = $'leptos::prelude::Resource<`t, `u>'

/// ### arc_resource
nominal arc_resource t u = $'leptos::prelude::ArcResource<`t, `u>'

/// ### local_resource
nominal local_resource t u = $'leptos::prelude::LocalResource<`t, `u>'

/// ### arc_local_resource
nominal arc_local_resource t = $'leptos::prelude::ArcLocalResource<`t>'

/// ### any_view
nominal any_view = $'leptos::prelude::AnyView'

/// ### view'
nominal view' t = $'leptos::prelude::View<`t>'

/// ### view
nominal view = $'leptos::prelude::AnyView'

/// ### keyboard_event
nominal keyboard_event = $'web_sys::KeyboardEvent'

/// ### signal_get
prototype signal_get signal t : signal t -> t

/// ### signal_get_untracked
prototype signal_get_untracked signal t : signal t -> t

/// ### signal_update
prototype signal_update signal t : (t -> t) -> signal t -> ()

/// ### signal_set
prototype signal_set signal t : t -> signal t -> ()

/// ### prelude
// The leptos traits (Get/Set/Update, ElementChild, ClassAttribute, ...) that view! and the trait calls below use.
inl prelude () =
    global "use leptos::prelude::*;"

/// ### send_wrapper
// leptos 0.8 takes Send closures and values (attributes, children, memos, For, Show, routes, context), and Spiral's
// are Rc-based: they cross behind a SendWrapper (wasm is single-threaded).
nominal send_wrapper t = $'leptos::__reexports::send_wrapper::SendWrapper<`t>'

/// ### send_wrapper_new
inl send_wrapper_new forall t. (x : t) : send_wrapper t =
    !\\(x, $'"leptos::__reexports::send_wrapper::SendWrapper::new($0)"')

/// ### send_wrapper_get
inl send_wrapper_get forall t. (x : send_wrapper t) : t =
    $'(*!x).clone()'

/// ### log_string
inl log_string (text : string) : () =
    $'leptos::logging::log\!("{}", !text)'

/// ### log
inl log (text : string) : () =
    $'leptos::logging::log\!("{}", !text)'

/// ### log_debug
inl log_debug (text : string) : () =
    $'leptos::logging::log\!("{:?}", !text)'

/// ### log_pretty
inl log_pretty (text : string) : () =
    $'leptos::logging::log\!("{:\#?}", !text)'

/// ### log_format
inl log_format fn obj =
    inl text = #?*obj |> fn |> sm'.ellipsis_end 200
    text |> log
    obj

/// ### mount_to_body
inl mount_to_body (view_fn : () -> view) : () =
    $'{ leptos::prelude::mount_to_body(move || (!view_fn)()); }'

/// ### view_vec_to_fragment
inl view_vec_to_fragment (view : am'.vec view) : fragment =
    !\\(view, $'"leptos::prelude::Fragment::new($0)"')

/// ### view_list_to_fragment
inl view_list_to_fragment (view : list view) : fragment =
    view
    |> am'.new_vec
    |> view_vec_to_fragment

/// ### element_to_view
inl element_to_view (view : view' (html_element _)) : view =
    !\\(view, $'"leptos::prelude::IntoAny::into_any($0)"')

/// ### view_to_fragment
inl view_to_fragment (view : view) : fragment =
    [ view ]
    |> view_list_to_fragment

/// ### fragment_to_view
inl fragment_to_view (fragment : fragment) : view =
    !\\(fragment, $'"leptos::prelude::AnyView::from($0)"')

/// ### element_to_fragment
inl element_to_fragment (view : view' (html_element _)) : fragment =
    view
    |> element_to_view
    |> view_to_fragment

/// ### (~:>) fragment
instance (~:>) fragment = fun x =>
    real
        typecase t with
        | array_base (view' (html_element ~el)) =>
            inl x = a x
            inl x = am.toList `a `int `(view' (html_element el)) x
            inl x = listm.map `(view' (html_element el)) `view (element_to_view `el) x
            view_list_to_fragment x
        | list (view' (html_element ~el)) =>
            inl x = listm.map `(view' (html_element el)) `view (element_to_view `el) x
            view_list_to_fragment x
        | list view =>
            view_list_to_fragment x
        | _ => x

/// ### (~:>) view
instance (~:>) view = fun x =>
    real
        typecase t with
        | view' (html_element _) => element_to_view x
        | _ => x

/// ### vec_to_view
inl vec_to_view (views : am'.vec view) : view =
    !\\(views, $'"leptos::prelude::IntoAny::into_any($0)"')

/// ### view_list_to_view
inl view_list_to_view (views : list view) : view =
    views
    |> am'.new_vec
    |> vec_to_view

/// ### text_to_view
inl text_to_view (text : string) : view =
    inl text = text |> sm'.to_std_string
    !\\(text, $'"leptos::prelude::IntoAny::into_any(leptos::prelude::IntoView::into_view($0))"')

/// ### text_to_fragment
inl text_to_fragment (text : string) : fragment =
    text
    |> text_to_view
    |> view_to_fragment

/// ### macro_to_view
// The view! leaves: `macro` is view! markup (tag_text, tag_raw, tag_closed_raw, route, routes, router).
inl macro_to_view (macro : string) : view =
    prelude ()
    !\($'"leptos::prelude::IntoAny::into_any(leptos::prelude::view\! { " + !macro + " })"')

/// ### macro_to_element
inl macro_to_element (macro : string) : view' (html_element _) =
    prelude ()
    !\($'"leptos::prelude::view\! { " + !macro + " }"')

/// ### into_any_view
inl into_any_view (view : view' _) : view =
    !\\(view, $'"leptos::prelude::IntoAny::into_any($0)"')

/// ### new_text
inl new_text (text : string) : text =
    !\\(text, $'"leptos::tachys::renderer::dom::Dom::create_text_node(&*$0)"')

/// ### text_view
inl text_view (text : string) : view =
    text
    |> text_to_view

/// ### text_fragment
inl text_fragment (text : string) : fragment =
    text
    |> text_view
    |> view_to_fragment

/// ### provide_meta_context
inl provide_meta_context () : () =
    $'leptos_meta::provide_meta_context()'

/// ### provide_context
// read back by use_context
inl provide_context forall t. (x : t) : () =
    inl x = x |> send_wrapper_new
    $'leptos::context::provide_context(!x)'

/// ### use_context
inl use_context forall t. () : optionm'.option' t =
    $'leptos::context::use_context::<leptos::__reexports::send_wrapper::SendWrapper<`t>>().map(|x| (*x).clone())'

/// ### create_signal
inl create_signal forall t. (value : t) : read_signal t * write_signal t =
    !\\(value, $'"leptos::prelude::signal($0)"')

/// ### new_rw_signal
inl new_rw_signal forall t. (value : t) : rw_signal t =
    !\\(value, $'"leptos::prelude::RwSignal::new($0)"')

/// ### new_arc_rw_signal
inl new_arc_rw_signal forall t. (value : t) : arc_rw_signal t =
    !\\(value, $'"leptos::prelude::ArcRwSignal::new($0)"')

/// ### read_only
inl read_only forall t. (value : rw_signal t) : read_signal t =
    !\\(value, $'"leptos::prelude::RwSignal::read_only(&$0)"')

/// ### write_only
inl write_only forall t. (value : rw_signal t) : write_signal t =
    !\\(value, $'"leptos::prelude::RwSignal::write_only(&$0)"')

/// ### typecheck_signal
inl typecheck_signal forall (t : * -> *) u. (signal : t u) : () =
    real
        typecase t with
        | signal => ()
        | arc_signal => ()
        | rw_signal => ()
        | arc_rw_signal => ()
        | read_signal => ()
        | arc_read_signal => ()
        | write_signal => ()
        | arc_write_signal => ()
        | memo => ()
        | arc_memo => ()
        | _ => error_type `(()) ("invalid signal", ``(t u))

/// ### is_arc_memo
// An arc_memo holds a SendWrapper of its value (see arc_memo).
inl is_arc_memo forall (t : * -> *) u. (signal : t u) : bool =
    real
        typecase t with
        | arc_memo => true
        | _ => false

/// ### memo_get'
inl memo_get' forall t. (memo : memo t) : t =
    !\\(memo, $'"$0()"')

/// ### signal_get'
inl signal_get' forall (t : * -> *) u. (signal : t u) : u =
    signal |> typecheck_signal
    prelude ()
    if is_arc_memo signal
    then $'leptos::prelude::Get::get(&!signal).take()' : u
    else $'leptos::prelude::Get::get(&!signal)' : u

/// ### signal_get signal
instance signal_get signal = signal_get'
instance signal_get arc_signal = signal_get'

/// ### signal_get rw_signal
instance signal_get rw_signal = signal_get'
instance signal_get arc_rw_signal = signal_get'

/// ### signal_get read_signal
instance signal_get read_signal = signal_get'
instance signal_get arc_read_signal = signal_get'

/// ### signal_get memo
instance signal_get memo = signal_get'
instance signal_get arc_memo = signal_get'

/// ### signal_update'
inl signal_update' forall (t : * -> *) u. (fn : u -> u) (signal : t u) : () =
    signal |> typecheck_signal
    prelude ()
    $'leptos::prelude::Update::update(&!signal, |x: &mut `u| { *x = (!fn)(x.clone()) })'

/// ### signal_update rw_signal
instance signal_update rw_signal = signal_update'
instance signal_update arc_rw_signal = signal_update'

/// ### signal_update write_signal
instance signal_update write_signal = signal_update'
instance signal_update arc_write_signal = signal_update'

/// ### signal_get_untracked'
inl signal_get_untracked' forall (t : * -> *) u. (signal : t u) : u =
    signal |> typecheck_signal
    prelude ()
    if is_arc_memo signal
    then $'leptos::prelude::GetUntracked::get_untracked(&!signal).take()' : u
    else $'leptos::prelude::GetUntracked::get_untracked(&!signal)' : u

/// ### signal_get_untracked rw_signal
instance signal_get_untracked rw_signal = signal_get_untracked'
instance signal_get_untracked arc_rw_signal = signal_get_untracked'

/// ### signal_get_untracked read_signal
instance signal_get_untracked read_signal = signal_get_untracked'
instance signal_get_untracked arc_read_signal = signal_get_untracked'

/// ### signal_get_untracked memo
instance signal_get_untracked memo = signal_get_untracked'
instance signal_get_untracked arc_memo = signal_get_untracked'

/// ### signal_set'
inl signal_set' forall (t : * -> *) u. (value : u) (signal : t u) : () =
    signal |> typecheck_signal
    prelude ()
    $'leptos::prelude::Set::set(&!signal, !value)'

/// ### signal_set rw_signal
instance signal_set rw_signal = signal_set'
instance signal_set arc_rw_signal = signal_set'

/// ### signal_set write_signal
instance signal_set write_signal = signal_set'
instance signal_set arc_write_signal = signal_set'

/// ### untrack
// `fn ()` without subscribing the running reactive closure to the signals it reads.
inl untrack forall t. (fn : () -> t) : t =
    !\\(fn, $'"leptos::prelude::untrack(move || $0())"')

/// ### new_memo
inl new_memo forall t. (fn : () -> t) : memo t =
    inl fn = fn |> send_wrapper_new
    $'leptos::prelude::Memo::new(move |_| (*!fn)())'

/// ### new_arc_memo
// The value is wrapped (see arc_memo). Spiral's unions don't all implement PartialEq, so the change check compares
// values whose type has PartialEq and treats the others as always changed (autoref dispatch on the concrete type at
// each memo: a generic helper would always take the second impl).
inl new_arc_memo forall t. (fn : () -> t) : arc_memo t =
    global "pub struct SpiralMemoChanged<'a, T>(pub Option<&'a T>, pub Option<&'a T>);\npub trait SpiralMemoChangedEq { fn spiral_memo_changed(&self) -> bool; }\nimpl<'a, T: PartialEq> SpiralMemoChangedEq for SpiralMemoChanged<'a, T> { fn spiral_memo_changed(&self) -> bool { self.0 != self.1 } }\npub trait SpiralMemoChangedAny { fn spiral_memo_changed(&self) -> bool; }\nimpl<'a, T> SpiralMemoChangedAny for &SpiralMemoChanged<'a, T> { fn spiral_memo_changed(&self) -> bool { true } }"
    // a closure of its own: its body may return early (`?`) with the plain value
    inl fn = join fn
    inl fn = (fun () => fn () |> send_wrapper_new) |> send_wrapper_new
    $'leptos::prelude::ArcMemo::new_with_compare(move |_| (*!fn)(), |a: Option<&leptos::__reexports::send_wrapper::SendWrapper<`t>>, b: Option<&leptos::__reexports::send_wrapper::SendWrapper<`t>>| (&SpiralMemoChanged(a.map(|x| &**x), b.map(|x| &**x))).spiral_memo_changed())'

/// ### new_arc_local_resource
// the fetcher returns a boxed future; local resources need no Send
inl new_arc_local_resource forall t.
    (fetcher : () -> async.future_pin t)
    : arc_local_resource t
    =
    !\\(fetcher, $'"leptos::prelude::ArcLocalResource::new(move || $0())"')

/// ### new_action
// action inputs and futures are Rc-based (not Send): the local constructor
inl new_action forall t u. (action_fn : t -> async.future_pin u) : action t u =
    !\\(action_fn, $'"leptos::prelude::Action::new_local(move |value: &`t| $0(value.clone()))"')

/// ### new_arc_action
inl new_arc_action forall t u. (action_fn : t -> async.future_pin u) : arc_action t u =
    !\\(action_fn, $'"leptos::prelude::ArcAction::new_unsync(move |value: &`t| $0(value.clone()))"')

/// ### action_dispatch
inl action_dispatch forall t u. (value : heap t) (action : action (heap t) u) : () =
    $'{ leptos::prelude::Action::dispatch_local(&!action, !value.clone()); }'

/// ### arc_action_dispatch
inl arc_action_dispatch forall t u. (value : heap t) (action : arc_action (heap t) u) : () =
    $'{ leptos::prelude::ArcAction::dispatch_local(&!action, !value.clone()); }'

/// ### action_input
inl action_input forall t u. (action : action (heap t) u) : rw_signal (optionm'.option' t) =
    !\\(action, $'"leptos::prelude::Action::input(&$0)"')

/// ### action_pending
inl action_pending forall t u. (action : action (heap t) u) : memo bool =
    !\\(action, $'"leptos::prelude::Action::pending(&$0)"')

/// ### arc_action_pending
// ArcAction::pending is an ArcMemo of the plain value: read into an arc_memo (see arc_memo)
inl arc_action_pending forall t u. (action : arc_action (heap t) u) : arc_memo bool =
    inl pending : $'leptos::prelude::ArcMemo<bool>' = !\\(action, $'"leptos::prelude::ArcAction::pending(&$0)"')
    new_arc_memo fun () => $'leptos::prelude::Get::get(&!pending)' : bool

/// ### arc_action_pending_fn
// A reader of the action's pending state. arc_action_pending makes a new memo, and one made inside a reactive closure
// is dropped when the closure returns (leptos subscribers hold their sources weakly), so that closure would never
// re-run: the memo is made once, outside the reader.
inl arc_action_pending_fn forall t u. (action : arc_action (heap t) u) : () -> bool =
    inl pending = action |> arc_action_pending
    fun () => pending |> signal_get

/// ### action_value
inl action_value forall t u. (action : action (heap t) u) : rw_signal (optionm'.option' u) =
    !\\(action, $'"leptos::prelude::Action::value(&$0)"')

/// ### arc_action_value
inl arc_action_value forall t u. (action : arc_action (heap t) u) : arc_rw_signal (optionm'.option' u) =
    !\\(action, $'"leptos::prelude::ArcAction::value(&$0)"')

/// ### arc_action_value_get
// leptos 0.8's ArcAction::value is an ArcMappedSignal, not the ArcRwSignal arc_action_value's type names: read in place.
inl arc_action_value_get forall t u. (action : arc_action (heap t) u) : optionm'.option' u =
    prelude ()
    $'leptos::prelude::Get::get(&leptos::prelude::ArcAction::value(&!action))'

/// ### new_arc_signal_derive
// A signal of `fn ()`, which leptos re-runs when a signal it reads changes.
inl new_arc_signal_derive forall t. (fn : () -> t) : arc_signal t =
    inl fn = fn |> send_wrapper_new
    $'leptos::prelude::ArcSignal::derive(move || (*!fn)())'

/// ### arc_local_resource_loading
// loading = no value yet
inl arc_local_resource_loading forall t. (resource : arc_local_resource t) : arc_signal bool =
    new_arc_signal_derive fun () =>
        $'leptos::prelude::ArcLocalResource::get(&!resource).is_none()' : bool

/// ### resource_get
inl resource_get forall t u. (resource : resource t u) : optionm'.option' u =
    !\\(resource, $'"leptos::prelude::Resource::get(&$0)"')

/// ### local_resource_get
inl local_resource_get forall t u. (resource : local_resource t u) : optionm'.option' u =
    !\\(resource, $'"leptos::prelude::LocalResource::get(&$0)"')

/// ### arc_local_resource_get
inl arc_local_resource_get forall t. (resource : arc_local_resource t) : optionm'.option' t =
    !\\(resource, $'"Option::map(leptos::prelude::ArcLocalResource::get(&$0), |x| x.clone())"')

/// ### resource_with
inl resource_with forall t u v. (resource : resource t u) (fn : optionm'.option' u -> v) : v =
    !\\((resource, fn), $'"leptos::prelude::SignalWith::with(&$0, |x| $1(x.clone()))"')

/// ### new_effect
inl new_effect (fn : () -> ()) : () =
    $'{ leptos::prelude::Effect::new(move |_| (!fn)()); }'

/// ### window
let window () : wasm.window =
    !\($'"leptos::prelude::window()"')

/// ### attr_fn
// A reactive attribute, property or class (`name={move || f()}`): leptos re-runs `fn` when a signal it reads changes.
// Text values must be std::string::String (leptos has no attribute impls for Rc<str>).
inl attr_fn forall t. (name : string) (fn : () -> t) : string =
    inl fn = fn |> send_wrapper_new
    $'"" + !name + "={ move || (*!fn)() }"'

/// ### class_fn
// A reactive class attribute: the fixed `classes` and the ones `fn` returns.
inl class_fn (classes : string) (fn : () -> string) : string =
    attr_fn "class" fun () => classes ++# fn () |> sm'.to_std_string

/// ### on_event
// An event handler (`on:<name>={move |event| f(event)}`).
inl on_event forall t. (name : string) (fn : t -> ()) : string =
    inl fn = fn |> send_wrapper_new
    $'"on:" + !name + "={ move |event| (*!fn)(event) }"'

/// ### on_click
inl on_click (fn : () -> ()) : string =
    inl fn = fn |> send_wrapper_new
    $'"on:click={ move |_| (*!fn)() }"'

/// ### event_target_value
inl event_target_value forall t. (event : t) : sm'.std_string =
    !\\(event, $'"leptos::prelude::event_target_value(&$0)"')

/// ### concat_props
inl concat_props props =
    ("", props)
    ||> listm.fold fun acc (x : string) =>
        $'" " + !x + !acc + ""'

/// ### concat_markup
// in order (concat_props reverses)
inl concat_markup (items : list string) : string =
    ("", items)
    ||> listm.fold fun acc (x : string) =>
        $'"" + !acc + !x + ""'

/// ### tag_text
// view! markup of an element whose children are markup too.
inl tag_text (tag : string) props (children : string) : string =
    inl props = props |> concat_props
    $'"<" + !tag + " " + !props + ">" + !children + "</" + !tag + ">"'

/// ### tag_raw
// The children view is built once and is a plain child (a closure would move it out of an FnMut, and isn't Send):
// children that read signals wrap those parts in reactive_view / reactive_fragment.
inl tag_raw tag props children : string =
    inl children = children () |> fragment_to_view
    tag_text tag props $'"{ !children }"'

/// ### reactive_view
// Tag children are built once (see tag_raw), so a signal read at a children's top level doesn't update the view.
// reactive_view makes `fn` a reactive child: leptos re-runs it when a signal it read changes. Its captures must be
// Clone (signals, memos, closures, strings), not views.
inl reactive_view (fn : () -> view) : view =
    inl fn = fn |> send_wrapper_new
    $'leptos::prelude::IntoAny::into_any(move || (*!fn)())'

/// ### reactive_fragment
inl reactive_fragment (fn : () -> fragment) : fragment =
    reactive_view (fun () => fn () |> fragment_to_view)
    |> view_to_fragment

/// ### tag_element
inl tag_element tag props children : view' (html_element _) =
    tag_raw tag props children
    |> macro_to_element

/// ### tag_closed_raw
inl tag_closed_raw tag props =
    inl tag : string = tag
    inl props = props |> concat_props
    $'"<" + !tag + " " + !props + " />"'

/// ### tag_closed
inl tag_closed tag props : view' (html_element _) =
    tag_closed_raw tag props
    |> macro_to_element

/// ### for
inl for props : view =
    tag_closed_raw "leptos::prelude::For" props
    |> macro_to_view

/// ### for
// For's items and closures must be Send (+ Clone): the items cross as SendWrapper<T> (one Rust value, so a tuple `t`
// is unpacked in Spiral by send_wrapper_get).
inl for forall t u (signal : * -> *).
    (signal : signal (am'.vec t))
    (key_fn : t -> u)
    (children' : t -> fragment)
    : view
    =
    signal |> typecheck_signal
    // read through signal_get' (an arc_memo unwraps its SendWrapper there)
    inl items = (fun () => signal_get' signal : am'.vec t) |> send_wrapper_new
    inl key = (fun (x : send_wrapper t) => x |> send_wrapper_get |> key_fn) |> send_wrapper_new
    inl child = (fun (x : send_wrapper t) => x |> send_wrapper_get |> children' |> fragment_to_view) |> send_wrapper_new
    for [
        $'"each={ move || (*!items)().into_iter().map(leptos::__reexports::send_wrapper::SendWrapper::new).collect::<Vec<_>>() }"'
        $'"key={ move |x: &leptos::__reexports::send_wrapper::SendWrapper<_>| (*!key)(x.clone()) }"'
        $'"children={ move |x: leptos::__reexports::send_wrapper::SendWrapper<_>| (*!child)(x) }"'
    ]

/// ### show
inl show props : view =
    tag_closed_raw "leptos::prelude::Show" props
    |> macro_to_view

/// ### show
inl show (when_fn : () -> bool) (fallback : () -> view) (children : () -> fragment) : view =
    inl children = children |> send_wrapper_new
    show [
        attr_fn "when" when_fn
        attr_fn "fallback" fallback
        $'"children=leptos::children::ToChildren::to_children(move || (*!children)())"'
    ]

/// ### use_location
inl use_location () : location =
    !\($'"leptos_router::hooks::use_location()"')

/// ### use_navigate
inl use_navigate () : string -> () =
    inl navigate : threading.arc (rust.dyn' (rust.action_fn2 (rust.ref sm'.str) navigate_options)) =
        !\($'"std::sync::Arc::new(leptos_router::hooks::use_navigate())"')
    fun url =>
        inl url = url |> sm'.as_str
        !\\((navigate, url), $'"$0($1, Default::default())"')

/// ### location_hash
inl location_hash (location : location) : memo sm'.std_string =
    !\\(location, $'"$0.hash"')

/// ### location_pathname
inl location_pathname (location : location) : memo sm'.std_string =
    !\\(location, $'"$0.pathname"')

/// ### location_search
inl location_search (location : location) : memo sm'.std_string =
    !\\(location, $'"$0.search"')

/// ### url_try_from
// leptos_router 0.8 parses through the browser's URL (relative to the page's origin); the error is a JsValue
inl url_try_from (s : rust.ref sm'.str) : resultm.result' url sm'.std_string =
    !\\(s, $'"<leptos_router::location::BrowserUrl as leptos_router::location::LocationProvider>::parse($0).map_err(|x| x.as_string().unwrap_or_default())"')

/// ### url_pathname
// leptos_router 0.8's Url keeps the path private: `path()`
inl url_pathname (url : url) : sm'.std_string =
    !\\(url, $'"$0.path().to_string()"')

/// ### use_url
inl use_url () =
    inl location = use_location ()

    fun () =>
        inl url_pathname = location |> location_pathname |> signal_get |> sm'.from_std_string
        inl url_search = location |> location_search |> signal_get |> sm'.from_std_string
        inl url_search =
            if url_search = ""
            then ""
            else "?" +. url_search
        url_pathname +. url_search
    |> new_arc_memo

/// ### route
// leptos_router 0.8 types the route tree statically (`path!` of a literal, the routes a tuple of view! children): a
// route is view! markup, put together with the others by routes and router into one view! call.
inl route (path : string) (view : () -> view) : string =
    tag_closed_raw "leptos_router::components::Route" [
        $'"path=leptos_router::path\!(\\\"" + !path + "\\\")"'
        attr_fn "view" view
    ]

/// ### routes
inl routes (fallback : () -> view) (routes : list string) : string =
    tag_text "leptos_router::components::Routes" [
        attr_fn "fallback" fallback
    ] (routes |> concat_markup)

/// ### router
inl router (routes : string) : view =
    tag_text "leptos_router::components::Router" [] routes
    |> macro_to_view

/// ### a'
inl a' props children : _ (_ a') =
    tag_element "a" props children

/// ### button
inl button props children : _ (_ button) =
    tag_element "button" props children

/// ### details
inl details props children : _ (_ details) =
    tag_element "details" props children

/// ### div
inl div props children : _ (_ div) =
    tag_element "div" props children

/// ### footer
inl footer props children : _ (_ footer) =
    tag_element "footer" props children

/// ### header
inl header props children : _ (_ header) =
    tag_element "header" props children

/// ### label
inl label props children : _ (_ label) =
    tag_element "label" props children

/// ### main
inl main props children : _ (_ main) =
    tag_element "main" props children

inl main' () = ()

/// ### nav
inl nav props children : _ (_ nav) =
    tag_element "nav" props children

/// ### option'
inl option' props children : _ (_ option') =
    tag_element "option" props children

/// ### option'
inl option' selected children : _ (_ option') =
    inl selected : () -> bool = join selected
    option' [
        $'"selected=!selected()"'
    ] fun () =>
        children |> text_to_fragment

/// ### pre
inl pre props children : _ (_ pre) =
    tag_element "pre" props children

/// ### select
inl select props children : _ (_ select) =
    tag_element "select" props children

/// ### span
inl span props children : _ (_ span) =
    tag_element "span" props children

/// ### summary
inl summary props children : _ (_ summary) =
    tag_element "summary" props children

/// ### table
inl table props children : _ (_ table) =
    tag_element "table" props children

/// ### thead
inl thead props children : _ (_ thead) =
    tag_element "thead" props children

/// ### tbody
inl tbody props children : _ (_ tbody) =
    tag_element "tbody" props children

/// ### tr
inl tr props children : _ (_ tr) =
    tag_element "tr" props children

/// ### th
inl th props children : _ (_ th) =
    tag_element "th" props children

/// ### td
inl td props children : _ (_ td) =
    tag_element "td" props children

/// ### svg
inl svg props children : _ (_ svg) =
    tag_element "svg" props children

/// ### path
inl path props : _ (_ path) =
    tag_element "path" props (fun () => [] |> view_list_to_fragment)

/// ### circle
inl circle props : _ (_ circle) =
    tag_element "circle" props (fun () => [] |> view_list_to_fragment)

/// ### rect
inl rect props children : _ (_ rect) =
    tag_element "rect" props children

/// ### animate
inl animate props : _ (_ animate) =
    tag_element "animate" props (fun () => [] |> view_list_to_fragment)

/// ### input
inl input props : _ (_ input) =
    tag_closed "input" props

/// ### dd
inl dd props children : _ (_ dd) =
    tag_element "dd" props children

/// ### dl
inl dl props children : _ (_ dl) =
    tag_element "dl" props children

/// ### dt
inl dt props children : _ (_ dt) =
    tag_element "dt" props children
