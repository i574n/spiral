/// # leptos
:< rust.rust_operators
:< rust
:< sm'_operators

/// ### a'
:! a' = $'leptos::html::A'

/// ### event
:! event = $'leptos::ev::Event'

/// ### mouse_event
:! mouse_event = $'leptos::ev::MouseEvent'

