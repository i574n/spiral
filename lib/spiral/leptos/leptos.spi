:! select = $'leptos::html::Select'

/// ### span
:! span = $'leptos::html::Span'

/// ### summary
:! summary = $'leptos::html::Summary'

/// ### table
:! table = $'leptos::html::Table'

/// ### thead
:! thead = $'leptos::html::Thead'

/// ### tbody
:! tbody = $'leptos::html::Tbody'

/// ### tr
:! tr = $'leptos::html::Tr'

/// ### th
:! th = $'leptos::html::Th'

