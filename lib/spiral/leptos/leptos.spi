/// # leptos
open rust.rust_operators
open rust
open sm'_operators

/// ### a'
nominal a' = $'leptos::html::A'

/// ### event
nominal event = $'leptos::ev::Event'

/// ### mouse_event
nominal mouse_event = $'leptos::ev::MouseEvent'

/// ### button
nominal button = $'leptos::html::Button'

/// ### details
nominal details = $'leptos::html::Details'

/// ### dd
nominal dd = $'leptos::html::Dd'

/// ### div
nominal div = $'leptos::html::Div'

