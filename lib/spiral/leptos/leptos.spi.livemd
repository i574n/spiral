Spiral.Cells.eval!(
  ":< rust_operators\n:< sm'_operators\n\n:! a' = $'leptos::html::A'\n\n:! event = $'leptos::ev::Event'\n\n:! mouse_event = $'leptos::ev::MouseEvent'\n\n:! button = $'leptos::html::Button'\n\n:! details = $'leptos::html::Details'\n\n:! dd = $'leptos::html::Dd'\n\n:! div = $'leptos::html::Div'\n\n:! dl = $'leptos::html::Dl'\n\n:! dt = $'leptos::html::Dt'\n\n:! footer = $'leptos::html::Footer'\n\n:! header = $'leptos::html::Header'\n\n:! input = $'leptos::html::Input'\n\n:! label = $'leptos::html::Label'\n\n:! main = $'leptos::html::Main'\n\n:! nav = $'leptos::html::Nav'\n\n:! option' = $'leptos::html::Option_'\n\n:! pre = $'leptos::html::Pre'\n\n:! select = $'leptos::html::Select'\n\n:! span = $'leptos::html::Span'\n\n:! summary = $'leptos::html::Summary'\n\n:! table = $'leptos::html::Table'\n\n:! thead = $'leptos::html::Thead'\n\n:! tbody = $'leptos::html::Tbody'\n\n:! tr = $'leptos::html::Tr'\n\n:! th = $'leptos::html::Th'\n\n:! td = $'leptos::html::Td'\n\n:! svg = $'leptos::svg::Svg'\n\n:! path = $'leptos::svg::Path'\n\n:! circle = $'leptos::svg::Circle'\n\n:! rect = $'leptos::svg::Rect'\n\n:! animate = $'leptos::svg::Animate'\n\n:! action t u = $'leptos::prelude::Action<`t, `u>'\n\n:! arc_action t u = $'leptos::prelude::ArcAction<`t, `u>'\n\n:! for = $'leptos::prelude::For'\n\n:! show = $'leptos::prelude::Show'\n\n:! fragment = $'leptos::prelude::Fragment'\n\n:! text = $'leptos::tachys::renderer::dom::Text'\n\n:! route = $'leptos_router::Route'\n\n:! nested_route = $'leptos_router::NestedRoute<_, _, _, _>'\n\n:! route_definition = $'leptos_router::RouteDefinition'\n\n:! router = $'leptos_router::Router'\n\n:! routes = $'leptos_router::Routes'\n\n:! html_element t = $'leptos::html::HtmlElement<`t, _, _>'\n\n:! into_view = $'leptos::IntoView'\n\n:! location = $'leptos_router::location::Location'\n\n:! navigate_options = $'leptos_router::NavigateOptions'\n\n:! url = $'leptos_router::location::Url'\n\n:! memo t = $'leptos::prelude::Memo<`t>'\n\n:! arc_memo t = $'lept