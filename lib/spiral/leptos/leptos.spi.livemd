d_signal => ()\n        | write_signal => ()\n        | arc_write_signal => ()\n        | memo => ()\n        | arc_memo => ()\n        | _ => error_type `(()) (\"invalid signal\", ``(t u))\n\n:= is_arc_memo \\* (t : * -> *) u. (signal : t u) : bool =\n    ~>\n        ?: t ?|\n        | arc_memo => !+\n        | _ => !-\n\n:= memo_get' \\* t. (memo : memo t) : t =\n    !\\\\(memo, $'\"$0()\"')\n\n:= signal_get' \\* (t : * -> *) u. (signal : t u) : u =\n    signal |> typecheck_signal\n    prelude ()\n    ? is_arc_memo signal\n    ?> $'leptos::prelude::Get::get(&!signal).take()' : u\n    |: $'leptos::prelude::Get::get(&!signal)' : u\n\n:+ signal_get signal = signal_get'\n:+ signal_get arc_signal = signal_get'\n\n:+ signal_get rw_signal = signal_get'\n:+ signal_get arc_rw_signal = signal_get'\n\n:+ signal_get read_signal = signal_get'\n:+ signal_get arc_read_signal = signal_get'\n\n:+ signal_get memo = signal_get'\n:+ signal_get arc_memo = signal_get'\n\n:= signal_update' \\* (t : * -> *) u. (fn : u -> u) (signal : t u) : () =\n    signal |> typecheck_signal\n    prelude ()\n    $'leptos::prelude::Update::update(&!signal, |x: &mut `u| { *x = (!fn)(x.clone()) })'\n\n:+ signal_update rw_signal = signal_update'\n:+ signal_update arc_rw_signal = signal_update'\n\n:+ signal_update write_signal = signal_update'\n:+ signal_update arc_write_signal = signal_update'\n\n:= signal_get_untracked' \\* (t : * -> *) u. (signal : t u) : u =\n    signal |> typecheck_signal\n    prelude ()\n    ? is_arc_memo signal\n    ?> $'leptos::prelude::GetUntracked::get_untracked(&!signal).take()' : u\n    |: $'leptos::prelude::GetUntracked::get_untracked(&!signal)' : u\n\n:+ signal_get_untracked rw_signal = signal_get_untracked'\n:+ signal_get_untracked arc_rw_signal = signal_get_untracked'\n\n:+ signal_get_untracked read_signal = signal_get_untracked'\n:+ signal_get_untracked arc_read_signal = signal_get_untracked'\n\n:+ signal_get_untracked memo = signal_get_untracked'\n:+ signal_get_untracked arc_memo = signal_get_untracked'\n\n:= signal_set' \\* (t : * -> *) u. (value : u) (signal : t u) : () =\n    signal |> typecheck_signal\n    prelude ()\n    $'leptos::prelude::Set::set(&!signal, !value)'\n\n:+ signal_set rw_signal = signal_set'\n:+ signal_set arc_rw_signal = signal_set'\n\n:+ signal_set write_signal = signal_set'\n:+ signal_set arc_write_signal = signal_set'\n\n:= untrack \\* t. (fn : () -> t) : t =\n    !\\\\(fn, $'\"leptos::prelude::untrack(move || $0())\"')\n\n:= new_memo \\* t. (fn : () -> t) : memo t =\n    := fn = fn |> send_wrapper_new\n    $'leptos::prelude::Memo::new(move |_| (*!fn)())'\n\n:= new_arc_memo \\* t. (fn : () -> t) : arc_memo t =\n    global \"\"\"\n        pub struct SpiralMemoChanged<'a, T>(pub Option<&'a T>, pub Option<&'a T>);\n        pub trait SpiralMemoChangedEq { fn spiral_memo_changed(&self) -> bool; }\n        impl<'a, T: PartialEq> SpiralMemoChangedEq for SpiralMemoChanged<'a, T> { fn spiral_memo_changed(&self) -> bool { self.0 != self.1 } }\n        pub trait SpiralMemoChangedAny { fn spiral_memo_changed(&self) -> bool; }\n        impl<'a, T> SpiralMemoChangedAny for &SpiralMemoChanged<'a, T> { fn spiral_memo_changed(&self) -> bool { true } }\n        \"\"\"\n    := fn = ~~ fn\n    := fn = (\\ () => fn () |> send_wrapper_new) |> send_wrapper_new\n    $'leptos::prelude::ArcMemo::new_with_compare(move |_| (*!fn)(), |a: \\\n        Option<&leptos::__reexports::send_wrapper::SendWrapper<`t>>, b: \\\n        Option<&leptos::__reexports::send_wrapper::SendWrapper<`t>>| (&SpiralMemoChanged(a.map(|x| &**x), b.map(|x| \\\n        &**x))).spiral_memo_changed())'\n\n:= new_arc_local_resource \\* t.\n    (fetcher : () -> async::future_pin t)\n    : arc_local_resource t\n    =\n    !\\\\(fetcher, $'\"leptos::prelude::ArcLocalResource::new(move || $0())\"')\n\n:= new_action \\* t u. (action_fn : t -> async::future_pin u) : action t u =\n    !\\\\(action_fn, $'\"leptos::prelude::Action::new_local(move |value: &`t| $0(value.clone()))\"')\n\n:= new_arc_action \\* t u. (action_fn : t -> async::future_pin u) : arc_action t u =\n    !\\\\(action_fn, $'\"leptos::prelude::ArcAction::new_unsync(move |value: &`t| $0(value.clone()))\"')\n\n:= action_dispatch \\* t u. (value : heap t) (action : action (heap t) u) : () =\n    $'{ leptos::prelude::Action::dispatch_local(&!action, !value.clone()); }'\n\n:= arc_action_dispatch \\* t u. (value : heap t) (action : arc_action (heap t) u) : () =\n    $'{ leptos::prelude::ArcAction::dispatch_local(&!action, !value.clone()); }'\n\n:= action_input \\* t u. (action : action (heap t) u) : rw_signal (optionm'::option' t) =\n    !\\\\(action, $'\"leptos::prelude::Action::input(&$0)\"')\n\n:= action_pending \\* t u. (action : action (heap t) u) : memo bool =\n    !\\\\(action, $'\"leptos::prelude::Action::pending(&$0)\"')\n\n:= arc_action_pending \\* t u. (action : arc_action (heap t) u) : arc_memo bool =\n    := pending : $'leptos::prelude::ArcMemo<bool>' = !\\\\(action, $'\"leptos::prelude::ArcAction::pending(&$0)\"')\n    new_arc_memo \\ () => $'leptos::prelude::Get::get(&!pending)' : bool\n\n:= arc_action_pending_fn \\* t u. (action : arc_action (heap t) u) : () -> bool =\n    := pending = action |> arc_action_pending\n    \\ () => pending |> signal_get\n\n:= action_value \\* t u. (action : action (heap t) u) : rw_signal (optionm'::option' u) =\n    !\\\\(action, $'\"leptos::prelude::Action::value(&$0)\"')\n\n:= arc_action_value \\* t u. (action : arc_action (heap t) u) : arc_rw_signal (optionm'::option' u) =\n    !\\\\(action, $'\"leptos::prelude::ArcAction::value(&$0)\"')\n\n:= arc_action_value_get \\* t u. (action : arc_action (heap t) u) : optionm'::option' u =\n    prelude ()\n    $'leptos::prelude::Get::get(&leptos::prelude::ArcAction::value(&!action))'\n\n:= new_arc_signal_derive \\* t. (fn : () -> t) : arc_signal t =\n    := fn = fn |> send_wrapper_new\n    $'leptos::prelude::ArcSignal::derive(move || (*!fn)())'\n\n:= arc_local_resource_loading \\* t. (resource : arc_local_resource t) : arc_signal bool =\n    new_arc_signal_derive \\ () =>\n        $'leptos::prelude::ArcLocalResource::get(&!resource).is_none()' : bool\n\n:= resource_get \\* t u. (resource : resource t u) : optionm'::option' u =\n    !\\\\(resource, $'\"leptos::prelude::Resource::get(&$0)\"')\n\n:= local_resource_get \\* t u. (resource : local_resource t u) : optionm'::option' u =\n    !\\\\(resource, $'\"leptos::prelude::LocalResource::get(&$0)\"')\n\n:= arc_local_resource_get \\* t. (resource : arc_local_resource t) : optionm'::option' t =\n    !\\\\(resource, $'\"Option::map(leptos::prelude::ArcLocalResource::get(&$0), |x| x.clone())\"')\n\n:= resource_with \\* t u v. (resource : resource t u) (fn : optionm'::option' u -> v) : v =\n    !\\\\((resource, fn), $'\"leptos::prelude::SignalWith::with(&$0, |x| $1(x.clone()))\"')\n\n:= new_effect (fn : () -> ()) : () =\n    $'{ leptos::prelude::Effect::new(move |_| (!fn)()); }'\n\n:~ window () : wasm::window =\n    !\\($'\"leptos::prelude::window()\"')\n\n:= attr_fn \\* t. (name : string) (fn : () -> t) : string =\n    := fn = fn |> send_wrapper_new\n    $'\"\" + !name + \"={ move || (*!fn)() }\"'\n\n:= class_fn (classes : string) (fn : () -> string) : string =\n    attr_fn \"class\" \\ () => classes ++# fn () |> sm'::to_std_string\n\n:= on_event \\* t. (name : string) (fn : t -> ()) : string =\n    := fn = fn |> send_wrapper_new\n    $'\"on:\" + !name + \"={ move |event| (*!fn)(event) }\"'\n\n:= on_click (fn : () -> ()) : string =\n    := fn = fn |> send_wrapper_new\n    $'\"on:click={ move |_| (*!fn)() }\"'\n\n:= event_target_value \\* t. (event : t) : sm'::std_string =\n    !\\\\(event, $'\"leptos::prelude::event_target_value(&$0)\"')\n\n:= concat_props props =\n    (\"\", props)\n    ||> listm::fold \\ acc (x : string) =>\n        $'\" \" + !x + !acc + \"\"'\n\n:= concat_markup (items : list string) : string =\n    (\"\", items)\n    ||> listm::fold \\ acc (x : string) =>\n        $'\"\" + !acc + !x + \"\"'\n\n:= tag_text (tag : string) props (children : string) : string =\n    := props = props |> concat_props\n    $'\"<\" + !tag + \" \" + !props + \">\" + !children + \"</\" + !tag + \">\"'\n\n:= tag_raw tag props children : string =\n    := children = children () |> fragment_to_view\n    tag_text tag props $'\"{ !children }\"'\n\n:= reactive_view (fn : () -> view) : view =\n    := fn = fn |> send_wrapper_new\n    $'leptos::prelude::IntoAny::into_any(move || (*!fn)())'\n\n:= reactive_fragment (fn : () -> fragment) : fragment =\n    reactive_view (\\ () => fn () |> fragment_to_view)\n    |> view_to_fragment\n\n:= tag_element tag props children : view' (html_element _) =\n    tag_raw tag props children\n    |> macro_to_element\n\n:= tag_closed_raw tag props =\n    := tag : string = tag\n    := props = props |> concat_props\n    $'\"<\" + !tag + \" \" + !props + \" />\"'\n\n:= tag_closed tag props : view' (html_element _) =\n    tag_closed_raw tag props\n    |> macro_to_element\n\n:= for props : view =\n    tag_closed_raw \"leptos::prelude::For\" props\n    |> macro_to_view\n\n:= for \\* t u (signal : * -> *).\n    (signal : signal (am'::vec t))\n    (key_fn : t -> u)\n    (children' : t -> fragment)\n    : view\n    =\n    signal |> typecheck_signal\n    := items = (\\ () => signal_get' signal : am'::vec t) |> send_wrapper_new\n    := key = (\\ (x : send_wrapper t) => x |> send_wrapper_get |> key_fn) |> send_wrapper_new\n    := child = (\\ (x : send_wrapper t) => x |> send_wrapper_get |> children' |> fragment_to_view) |> send_wrapper_new\n    for [\n        $'\"each={ move || (*!items)().into_iter().map(leptos::__reexports::send_wrapper::SendWrapper::new).collect::<V\\\n            ec<_>>() }\"'\n        $'\"key={ move |x: &leptos::__reexports::send_wrapper::SendWrapper<_>| (*!key)(x.clone()) }\"'\n        $'\"children={ move |x: leptos::__reexports::send_wrapper::SendWrapper<_>| (*!child)(x) }\"'\n    ]\n\n:= show props : view =\n    tag_closed_raw \"leptos::prelude::Show\" props\n    |> macro_to_view\n\n:= show (when_fn : () -> bool) (fallback : () -> view) (children : () -> fragment) : view =\n    := children = children |> send_wrapper_new\n    show [\n        attr_fn \"when\" when_fn\n        attr_fn \"fallback\" fallback\n        $'\"children=leptos::children::ToChildren::to_children(move || (*!children)())\"'\n    ]\n\n:= use_location () : location =\n    !\\($'\"leptos_router::hooks::use_location()\"')\n\n:= use_navigate () : string -> () =\n    := navigate : threading::arc (rust::dyn' (rust::action_fn2 (rust::ref sm'::str) navigate_options)) =\n        !\\($'\"std::sync::Arc::new(leptos_router::hooks::use_navigate())\"')\n    \\ url =>\n        := url = url |> sm'::as_str\n        !\\\\((navigate, url), $'\"$0($1, Default::default())\"')\n\n:= location_hash (location : location) : memo sm'::std_string =\n    !\\\\(location, $'\"$0.hash\"')\n\n:= location_pathname (location : location) : memo sm'::std_string =\n    !\\\\(location, $'\"$0.pathname\"')\n\n:= location_search (location : location) : memo sm'::std_string =\n    !\\\\(location, $'\"$0.search\"')\n\n:= url_try_from (s : rust::ref sm'::str) : resultm::result' url sm'::std_string =\n    !\\\\(s, $'\"<leptos_router::location::BrowserUrl as leptos_router::location::LocationProvider>::parse($0).map_err(|x\\\n        | x.as_string().unwrap_or_default())\"')\n\n:= url_pathname (url : url) : sm'::std_string =\n    !\\\\(url, $'\"$0.path().to_string()\"')\n\n:= use_url () =\n    := location = use_location ()\n\n    \\ () =>\n        := url_pathname = location |> location_pathname |> signal_get |> sm'::from_std_string\n        := url_search = location |> location_search |> signal_get |> sm'::from_std_string\n        := url_search =\n            ? url_search = \"\"\n            ?> \"\"\n            |: \"?\" ++# url_search\n        url_pathname ++# url_search\n    |> new_arc_memo\n\n:= route (path : string) (view : () -> view) : string =\n    tag_closed_raw \"leptos_router::components::Route\" [\n        $'\"path=leptos_router::path\\!(\\\\\\\"\" + !path + \"\\\\\\\")\"'\n        attr_fn \"view\" view\n    ]\n\n:= routes (fallback : () -> view) (routes : list string) : string =\n    tag_text \"leptos_router::components::Routes\" [\n        attr_fn \"fallback\" fallback\n    ] (routes |> concat_markup)\n\n:= router (routes : string) : view =\n    tag_text \"leptos_router::components::Router\" [] routes\n    |> macro_to_view\n\n:= a' props children : _ (_ a') =\n    tag_element \"a\" props children\n\n:= button props children : _ (_ button) =\n    tag_element \"button\" props children\n\n:= details props children : _ (_ details) =\n    tag_element \"details\" props children\n\n:= div props children : _ (_ div) =\n    tag_element \"div\" props children\n\n:= footer props children : _ (_ footer) =\n    tag_element \"footer\" props children\n\n:= header props children : _ (_ header) =\n    tag_element \"header\" props children\n\n:= label props children : _ (_ label) =\n    tag_element \"label\" props children\n\n:= main props children : _ (_ main) =\n    tag_element \"main\" props children\n\n:= main' () = ()\n\n:= nav props children : _ (_ nav) =\n    tag_element \"nav\" props children\n\n:= option' props children : _ (_ option') =\n    tag_element \"option\" props children\n\n:= option' selected children : _ (_ option') =\n    := selected : () -> bool = ~~ selected\n    option' [\n        $'\"selected=!selected()\"'\n    ] \\ () =>\n        children |> text_to_fragment\n\n:= pre props children : _ (_ pre) =\n    tag_element \"pre\" props children\n\n:= select props children : _ (_ select) =\n    tag_element \"select\" props children\n\n:= span props children : _ (_ span) =\n    tag_element \"span\" props children\n\n:= summary props children : _ (_ summary) =\n    tag_element \"summary\" props children\n\n:= table props children : _ (_ table) =\n    tag_element \"table\" props children\n\n:= thead props children : _ (_ thead) =\n    tag_element \"thead\" props children\n\n:= tbody props children : _ (_ tbody) =\n    tag_element \"tbody\" props children\n\n:= tr props children : _ (_ tr) =\n    tag_element \"tr\" props children\n\n:= th props children : _ (_ th) =\n    tag_element \"th\" props children\n\n:= td props children : _ (_ td) =\n    tag_element \"td\" props children\n\n:= svg props children : _ (_ svg) =\n    tag_element \"svg\" props children\n\n:= path props : _ (_ path) =\n    tag_element \"path\" props (\\ () => [] |> view_list_to_fragment)\n\n:= circle props : _ (_ circle) =\n    tag_element \"circle\" props (\\ () => [] |> view_list_to_fragment)\n\n:= rect props children : _ (_ rect) =\n    tag_element \"rect\" props children\n\n:= animate props : _ (_ animate) =\n    tag_element \"animate\" props (\\ () => [] |> view_list_to_fragment)\n\n:= input props : _ (_ input) =\n    tag_closed \"input\" props\n\n:= dd props children : _ (_ dd) =\n    tag_element \"dd\" props children\n\n:= dl props children : _ (_ dl) =\n    tag_element \"dl\" props children\n\n:= dt props children : _ (_ dt) =\n    tag_element \"dt\" props children",
  timeout: 300_000
)
