open sm'_operators
open svg
open leptos
open rust

type props =
    {
        title : () -> string
        open' : () -> bool
        right_element : option view
        details_class : () -> string
        summary_class : () -> string
    }

inl props () : props =
    {
        title = fun () => ""
        open' = fun () => true
        right_element = None
        details_class = fun () => ""
        summary_class = fun () => ""
    }

inl render props_fn children : _ (_ div) =
    inl props : props = props () |> props_fn
    // tested here: the summary's class closure can't capture right_element (a view isn't Clone)
    inl right_element_none = props.right_element = None
    // bound outside the closure: a closure that reads a field of `props` captures all of it, the view too
    inl summary_class = props.summary_class
    inl right_element' =
        props.right_element
        |> optionm'.default_value ([] |> view_list_to_view)

    div [
        $'"class=\\\"flex flex-col [position:relative]\\\""'
    ] fun () =>
        :>[
            div [
                $'"class=\\\"[position:absolute] [right:0] [top:0]\\\""'
            ] fun () =>
                right_element'
                |> view_to_fragment
            |> element_to_view

            details [
                class_fn "flex flex-1 [&_summary::-webkit-details-marker]:hidden [&>summary>span]:open:-rotate-180 " props.details_class
                attr_fn "open" props.open'
            ] fun () =>
                :>[
                    summary [
                        class_fn "flex flex-1 items-center justify-between px-4 cursor-pointer text-gray-600 hover:text-gray-700 bg-gray-300 hover:bg-gray-200 " fun () =>
                            (if right_element_none then "" else "[margin-right:40px]")
                            ++# " " ++# summary_class ()
                    ] fun () =>
                        :>[
                            div [
                                $'"class=\\\"flex items-center gap-2\\\""'
                            ] fun () =>
                                // not a join point (its arguments would include the right_element view)
                                inl title = props.title
                                span [
                                    $'"class=\\\"[font-size:14px] [line-height:21px] [padding-right:11px]\\\""'
                                ] fun () =>
                                    // reactive: a title can read signals, like dropdown's selected item
                                    leptos.reactive_fragment fun () =>
                                        title ()
                                        |> text_fragment
                                |> element_to_fragment
                            |> element_to_view

                            span [
                                $'"class=\\\"shrink-0 transition duration-300 pt-[2px]\\\""'
                            ] fun () =>
                                arrow_down.render (fun () => "h-5 w-5") []
                                |> element_to_fragment
                            |> element_to_view
                        ]
                    |> element_to_view

                    div [
                        $'"class=\\\"flex flex-1 flex-col\\\""'
                    ] fun () =>
                        children ()
                    |> element_to_view
                ]
            |> element_to_view
        ]
