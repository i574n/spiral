open sm'_operators
open leptos
open rust

inl render icon (class : () -> string) props : _ (_ button) =
    button
        ([
            class_fn "inline-flex shrink-0 items-center [justify-content:center] pb-[8px] pt-[8px] px-[12px] " class
        ] ++ props)
        fun () =>
            :>[
                icon |> element_to_view
            ]
