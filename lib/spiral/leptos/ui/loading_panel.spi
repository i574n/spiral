:< svg
:< leptos

:= render () =
    leptos.div [
        $'"class=\\\"grid place-content-center py-[10vh]\\\""'
    ] \ () =>
        leptos.div [
            $'"class=\\\"flex flex-1 [gap:4px] items-center\\\""'
        ] \ () => :>[
            loading.render (\ () => "[width:24px] [height:30px]") |> leptos.element_to_view
            $'"Loading..."' |> leptos.text_view
        ]
        |> leptos.element_to_fragment
