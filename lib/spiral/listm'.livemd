### to_array'

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"inl to_array' forall t. (items : list' t) : array_base t =\n    backend_switch {\n        Gleam = fun () =>\n            inl d = real defaultof `t ()\n            $'!items |> array.from_list(default: !d)' : array_base t\n        Lua = fun () =>\n            inl len = $'##(!items)' : i32\n            inl d = real defaultof `t ()\n            inl result : a _ t = am.init len (fun _ => d)\n            let rec 루프 i =\n                if i >= len then\n                    inl (a result) = result\n                    result\n                else\n                    set result i $'!items[!i + 1]'\n                    루프 (i + 1i32)\n            루프 0i32\n        Fsharp = fun () => items |> $'List.toArray' : array_base t\n        Python = fun () =>\n            inl len = $'len(!items)' : i32\n            // CuPy arrays hold primitives only; a numpy object array holds any element (strings, tuples).\n            inl result : a _ t = a ($'__import__(\"numpy\").empty(!len, dtype=object)' : array_base t)\n            let rec 루프 i =\n                if i >= len then\n                    inl (a result) = result\n                    result\n                else\n                    set result i $'!items[!i]'\n                    루프 (i + 1i32)\n            루프 0i32\n        Rust = fun () => $'Rc::new(RefCell::new((!items).as_ref().clone()))' : array_base t\n    }","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  inl to_array' forall t. (items : list' t) : array_base t =
      backend_switch {
          Gleam = fun () =>
              inl d = real defaultof `t ()
              $'!items |> array.from_list(default: !d)' : array_base t
          Lua = fun () =>
              inl len = $'##(!items)' : i32
              inl d = real defaultof `t ()
              inl result : a _ t = am.init len (fun _ => d)
              let rec 루프 i =
                  if i >= len then
                      inl (a result) = result
                      result
                  else
                      set result i $'!items[!i + 1]'
                      루프 (i + 1i32)
              루프 0i32
          Fsharp = fun () => items |> $'List.toArray' : array_base t
          Python = fun () =>
              inl len = $'len(!items)' : i32
              // CuPy arrays hold primitives only; a numpy object array holds any element (strings, tuples).
              inl result : a _ t = a ($'__import__("numpy").empty(!len, dtype=object)' : array_base t)
              let rec 루프 i =
                  if i >= len then
                      inl (a result) = result
                      result
                  else
                      set result i $'!items[!i]'
                      루프 (i + 1i32)
              루프 0i32
          Rust = fun () => $'Rc::new(RefCell::new((!items).as_ref().clone()))' : array_base t
      }
  """,
  timeout: 300_000
)
```

