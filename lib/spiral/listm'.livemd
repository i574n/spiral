### distinct'

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"inl distinct' forall t. (list : list' t) : list' t =\n    list'_types ()\n    backend_switch {\n        Gleam = fun () => $'!list |> list.unique' : list' t\n        Lua = fun () =>\n            inl result : mut (list' t) = empty' () |> mut\n            inl len = $'##(!list)' : i32\n            inl seen : mut (list t) = [] |> mut\n            let rec 루프 i =\n                if i >= len\n                then *result\n                else\n                    inl item = $'!list[!i + 1]' : t\n                    if exists' (fun x => x = item) (*seen)\n                    then 루프 (i + 1i32)\n                    else\n                        seen <- item :: *seen\n                        result <- cons' item (*result)\n                        루프 (i + 1i32)\n            루프 0i32\n        Fsharp = fun () => list |> $'List.distinct' : list' t\n        Python = fun () =>\n            $'x = list(set(!list))'\n            $'x.sort(key=!list.index)'\n            $'x' : list' t\n        Rust = fun () =>\n            inl len : i32 = $'(!list).len() as i32'\n            let rec 루프 (i : i32) (seen : list t) : list t =\n                if i >= len then seen\n                else\n                    inl item : t = $'(!list)[!i as usize].clone()'\n                    루프 (i + 1i32) (if exists' (fun x => x = item) seen then seen else Cons (item, seen))\n            루프 0i32 Nil |> box |> rev'\n    }","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  inl distinct' forall t. (list : list' t) : list' t =
      list'_types ()
      backend_switch {
          Gleam = fun () => $'!list |> list.unique' : list' t
          Lua = fun () =>
              inl result : mut (list' t) = empty' () |> mut
              inl len = $'##(!list)' : i32
              inl seen : mut (list t) = [] |> mut
              let rec 루프 i =
                  if i >= len
                  then *result
                  else
                      inl item = $'!list[!i + 1]' : t
                      if exists' (fun x => x = item) (*seen)
                      then 루프 (i + 1i32)
                      else
                          seen <- item :: *seen
                          result <- cons' item (*result)
                          루프 (i + 1i32)
              루프 0i32
          Fsharp = fun () => list |> $'List.distinct' : list' t
          Python = fun () =>
              $'x = list(set(!list))'
              $'x.sort(key=!list.index)'
              $'x' : list' t
          Rust = fun () =>
              inl len : i32 = $'(!list).len() as i32'
              let rec 루프 (i : i32) (seen : list t) : list t =
                  if i >= len then seen
                  else
                      inl item : t = $'(!list)[!i as usize].clone()'
                      루프 (i + 1i32) (if exists' (fun x => x = item) seen then seen else Cons (item, seen))
              루프 0i32 Nil |> box |> rev'
      }
  """,
  timeout: 300_000
)
```

