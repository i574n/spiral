### list'

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"inl list'_types () =\n    backend_switch {\n        Gleam = fun () => global \"import gleam/list\"\n        Rust = fun () => ()\n    }\ntype list'_switch t =\n    {\n        Gleam : $'List(`t)'\n        Fsharp : $'`t list'\n        Python : $'list'\n        Rust : $'Rc<Vec<`t>>'\n    }\nnominal list' t = $'backend_switch `(list'_switch t)'","print_code":false},"livebook_object":"smart_cell"} -->

