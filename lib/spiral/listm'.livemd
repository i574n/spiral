### exists'

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"inl exists' f x =\n    inl rec body f = function\n        | [] => false\n        | x :: xs =>\n            if f x\n            then true\n            else 루프 xs\n    and inl 루프 list =\n        if var_is list |> not\n        then body f list\n        else\n            inl f = join f\n            inl list = dyn list\n            join body f list\n    루프 x","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  inl exists' f x =
      inl rec body f = function
          | [] => false
          | x :: xs =>
              if f x
              then true
              else 루프 xs
      and inl 루프 list =
          if var_is list |> not
          then body f list
          else
              inl f = join f
              inl list = dyn list
              join body f list
      루프 x
  """,
  timeout: 300_000
)
```

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"///- --test --print-code\n///> gleam\n///> fsharp\n///> cuda\n////> rust // can't compare `()` with `char`\n///> typescript\n///> cuda\n\n[ 'a'; 'b'; 'c' ]\n|> exists' fun x => x = 'b'\n|> _assert_eq true\n\n[ 'a'; 'b' ]\n|> exists' fun x => x = 'c'\n|> _assert_eq false\n\n[]\n|> exists' fun x => x = 'a'\n|> _assert_eq false","print_code":true},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  ///- --test --print-code
  ///> gleam
  ///> fsharp
  ///> cuda
  ////> rust // can't compare `()` with `char`
  ///> typescript
  ///> cuda

  [ 'a'; 'b'; 'c' ]
  |> exists' fun x => x = 'b'
  |> _assert_eq true

  [ 'a'; 'b' ]
  |> exists' fun x => x = 'c'
  |> _assert_eq false

  []
  |> exists' fun x => x = 'a'
  |> _assert_eq false
  """,
  timeout: 300_000,
  print_code: true
)
```

