### fold'

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"inl fold' forall t u. (fn : t -> u) (init : list u) (list : list' t) : list u =\n    backend_switch {\n        Gleam = fun () =>\n            $'let listm_fold = !list |> list.fold (!init, fn (acc, x) {'\n            $'!(Cons (fn $'x', $'acc'))' : ()\n            $'})' : ()\n            $'listm_fold' : list u\n        Lua = fun () =>\n            inl result : mut (list u) = init |> mut\n            inl len = $'##(!list)' : i32\n            let rec 루프 i =\n                if i < 0i32\n                then *result\n                else\n                    result <- $'!fn(!list[!i + 1])' :: *result\n                    루프 (i - 1i32)\n            루프 (len - 1i32)\n        Fsharp = fun () =>\n            (init, list)\n            ||> $'List.fold' join fun acc x => Cons (fn x, acc)\n            : list u\n        Python = fun () =>\n            inl init = init |> box\n            $'r = !init '\n            inl list = list |> rev'\n            $'for x in !list: r = [!fn(x)] + r'\n            inl init : list u = Nil\n            inl cons (a : u) b = Cons (a, b)\n            $'r_ = !init '\n            $'for x in r: r_ = !cons (x)(r_)'\n            $'r_' : list u\n        Rust = fun () =>\n            inl len : i32 = $'(!list).len() as i32'\n            let rec 루프 (i : i32) (acc : list u) : list u =\n                if i >= len then acc\n                else\n                    inl item : t = $'(!list)[!i as usize].clone()'\n                    루프 (i + 1i32) (Cons (fn item, acc))\n            루프 0i32 init\n    }","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  inl fold' forall t u. (fn : t -> u) (init : list u) (list : list' t) : list u =
      backend_switch {
          Gleam = fun () =>
              $'let listm_fold = !list |> list.fold (!init, fn (acc, x) {'
              $'!(Cons (fn $'x', $'acc'))' : ()
              $'})' : ()
              $'listm_fold' : list u
          Lua = fun () =>
              inl result : mut (list u) = init |> mut
              inl len = $'##(!list)' : i32
              let rec 루프 i =
                  if i < 0i32
                  then *result
                  else
                      result <- $'!fn(!list[!i + 1])' :: *result
                      루프 (i - 1i32)
              루프 (len - 1i32)
          Fsharp = fun () =>
              (init, list)
              ||> $'List.fold' join fun acc x => Cons (fn x, acc)
              : list u
          Python = fun () =>
              inl init = init |> box
              $'r = !init '
              inl list = list |> rev'
              $'for x in !list: r = [!fn(x)] + r'
              inl init : list u = Nil
              inl cons (a : u) b = Cons (a, b)
              $'r_ = !init '
              $'for x in r: r_ = !cons (x)(r_)'
              $'r_' : list u
          Rust = fun () =>
              inl len : i32 = $'(!list).len() as i32'
              let rec 루프 (i : i32) (acc : list u) : list u =
                  if i >= len then acc
                  else
                      inl item : t = $'(!list)[!i as usize].clone()'
                      루프 (i + 1i32) (Cons (fn item, acc))
              루프 0i32 init
      }
  """,
  timeout: 300_000
)
```

