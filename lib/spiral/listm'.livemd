<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"inl cons' forall t. (head : t) (tail : list' t) : list' t =\n    backend_switch {\n        Gleam = fun () => $'[ !head, ..!tail ]' : list' t\n        Lua = fun () =>\n            $'table.insert(!tail, 1, !head)'\n            $'!tail ' : list' t\n        Fsharp = fun () => $'!head :: !tail ' : list' t\n        Python = fun () =>\n            $'!tail.insert(0, !head)'\n            $'!tail ' : list' t\n        Rust = fun () => $'Rc::new({ let mut v = (!tail).as_ref().clone(); v.insert(0, !head); v })' : list' t\n    }","print_code":false},"livebook_object":"smart_cell"} -->

