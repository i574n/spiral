### unzip

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"inl unzip list =\n    (([], []), list)\n    ||> listm.fold fun (acc_x, acc_y) (x, y) =>\n        x :: acc_x, y :: acc_y\n    |> fun x, y =>\n        x |> listm.rev, y |> listm.rev","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  inl unzip list =
      (([], []), list)
      ||> listm.fold fun (acc_x, acc_y) (x, y) =>
          x :: acc_x, y :: acc_y
      |> fun x, y =>
          x |> listm.rev, y |> listm.rev
  """,
  timeout: 300_000
)
```

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"///- --test\n\nlistm.init 10i32 id\n|> listm.map (fun x => x, x)\n|> unzip\n|> fun x, y =>\n    x |> sum\n    |> _assert_eq 45\n\n    y |> sum\n    |> _assert_eq 45","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  ///- --test

  listm.init 10i32 id
  |> listm.map (fun x => x, x)
  |> unzip
  |> fun x, y =>
      x |> sum
      |> _assert_eq 45

      y |> sum
      |> _assert_eq 45
  """,
  timeout: 300_000
)
```

### try_index_of

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"// inl try_index_of item list =\ninl try_index_of forall b c {number}. (item : b) (list : list b) : option c =\n    // inl rec 루프 i = function\n    inl rec 루프 forall a {number}. (i : a) : list b -> option a = function\n        | [] => None\n        | x :: xs =>\n            if x = item\n            then Some i\n            else 루프 (i + 1) xs\n    루프 0 list\n\ninl index_of item =\n    try_index_of item >> optionm.value\n\n// inl try_index_of_ item list =\ninl try_index_of_ forall b c {number}. (item : b) (list : list b) : option c =\n    // let rec 루프 i = function\n    let rec 루프 forall a {number}. (i : a) : list b -> option a = function\n        | [] => None\n        | x :: xs =>\n            if x = item\n            then Some i\n            else 루프 (i + 1) xs\n    루프 0 list\n\ninl index_of_ item =\n    try_index_of_ item >> optionm.value\n\ninl try_index_of__ item list =\n    inl i = mut 0\n    inl list = mut list\n    inl result = mut None\n    let rec 루프 () =\n        match *list with\n        | [] => result <- None\n        | x :: xs =>\n            if x = item\n            then result <- Some *i\n            else\n                i <- *i + 1\n                list <- xs\n                루프 ()\n    루프 ()\n    *result\n\ninl index_of__ item =\n    try_index_of__ item >> optionm.value","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  // inl try_index_of item list =
  inl try_index_of forall b c {number}. (item : b) (list : list b) : option c =
      // inl rec 루프 i = function
      inl rec 루프 forall a {number}. (i : a) : list b -> option a = function
          | [] => None
          | x :: xs =>
              if x = item
              then Some i
              else 루프 (i + 1) xs
      루프 0 list

  inl index_of item =
      try_index_of item >> optionm.value

  // inl try_index_of_ item list =
  inl try_index_of_ forall b c {number}. (item : b) (list : list b) : option c =
      // let rec 루프 i = function
      let rec 루프 forall a {number}. (i : a) : list b -> option a = function
          | [] => None
          | x :: xs =>
              if x = item
              then Some i
              else 루프 (i + 1) xs
      루프 0 list

  inl index_of_ item =
      try_index_of_ item >> optionm.value

  inl try_index_of__ item list =
      inl i = mut 0
      inl list = mut list
      inl result = mut None
      let rec 루프 () =
          match *list with
          | [] => result <- None
          | x :: xs =>
              if x = item
              then result <- Some *i
              else
                  i <- *i + 1
                  list <- xs
                  루프 ()
      루프 ()
      *result

  inl index_of__ item =
      try_index_of__ item >> optionm.value
  """,
  timeout: 300_000
)
```

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"///- --test\n\nlistm.init 10i32 id\n|> index_of 5i32\n|> _assert_eq 5i32","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  ///- --test

  listm.init 10i32 id
  |> index_of 5i32
  |> _assert_eq 5i32
  """,
  timeout: 300_000
)
```

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"///- --test\n\nlistm.init 10i32 id\n|> try_index_of 10i32\n|> _assert_eq (None : option i32)","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
