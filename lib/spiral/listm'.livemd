  ///- --test

  listm.init 10i32 id
  |> try_index_of 10i32
  |> _assert_eq (None : option i32)
  """,
  timeout: 300_000
)
```

### try_find

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"inl try_find fn list =\n    inl rec 루프 = function\n        | [] => None\n        | x :: xs =>\n            if fn x\n            then Some x\n            else 루프 xs\n    루프 list\n\ninl try_find_ fn list =\n    let rec 루프 = function\n        | [] => None\n        | x :: xs =>\n            if fn x\n            then Some x\n            else 루프 xs\n    루프 list","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  inl try_find fn list =
      inl rec 루프 = function
          | [] => None
          | x :: xs =>
              if fn x
              then Some x
              else 루프 xs
      루프 list

  inl try_find_ fn list =
      let rec 루프 = function
          | [] => None
          | x :: xs =>
              if fn x
              then Some x
              else 루프 xs
      루프 list
  """,
  timeout: 300_000
)
```

