### zip_with

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"inl zip_with fn xs ys =\n    inl rec 루프 acc xs ys =\n        match xs, ys with\n        | Cons (x, xs), Cons (y, ys) =>\n            루프 (fn x y :: acc) xs ys\n        | _ => listm.rev acc\n    루프 [] xs ys\n\ninl zip_with_ fn xs ys =\n    let rec 루프 acc xs ys =\n        match xs, ys with\n        | Cons (x, xs), Cons (y, ys) =>\n            루프 (fn x y :: acc) xs ys\n        | _ => listm.rev acc\n    루프 [] xs ys","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  inl zip_with fn xs ys =
      inl rec 루프 acc xs ys =
          match xs, ys with
          | Cons (x, xs), Cons (y, ys) =>
              루프 (fn x y :: acc) xs ys
          | _ => listm.rev acc
      루프 [] xs ys

  inl zip_with_ fn xs ys =
      let rec 루프 acc xs ys =
          match xs, ys with
          | Cons (x, xs), Cons (y, ys) =>
              루프 (fn x y :: acc) xs ys
          | _ => listm.rev acc
      루프 [] xs ys
  """,
  timeout: 300_000
)
```

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"///- --test\n\n([ 1i32; 2; 3 ], [ 4; 5; 6 ])\n||> zip_with (+)\n|> _assert_eq [ 5; 7; 9 ]","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  ///- --test

  ([ 1i32; 2; 3 ], [ 4; 5; 6 ])
  ||> zip_with (+)
  |> _assert_eq [ 5; 7; 9 ]
  """,
  timeout: 300_000
)
```

