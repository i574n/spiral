### filter'

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"inl filter' forall t. (fn : t -> bool) (list : list' t) : list' t =\n    backend_switch {\n        Gleam = fun () => $'!list |> list.filter(!fn)' : list' t\n        Lua = fun () =>\n            inl result : mut (list' t) = empty' () |> mut\n            inl len = $'##(!list)' : i32\n            let rec 루프 i =\n                if i >= len\n                then *result\n                else\n                    inl item = $'!list[!i + 1]' : t\n                    if fn item\n                    then\n                        result <- cons' item (*result)\n                        루프 (i + 1i32)\n                    else 루프 (i + 1i32)\n            루프 0i32\n        Fsharp = fun () => list |> $'\"List.filter !fn\"' : list' t\n        Python = fun () => $'list(filter(!fn, !list))' : list' t\n        Rust = fun () =>\n            inl len : i32 = $'(!list).len() as i32'\n            let rec 루프 (i : i32) (acc : list t) : list t =\n                if i < 0i32 then acc\n                else\n                    inl item : t = $'(!list)[!i as usize].clone()'\n                    루프 (i - 1i32) (if fn item then Cons (item, acc) else acc)\n            루프 (len - 1i32) Nil |> box\n    }","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  inl filter' forall t. (fn : t -> bool) (list : list' t) : list' t =
      backend_switch {
          Gleam = fun () => $'!list |> list.filter(!fn)' : list' t
          Lua = fun () =>
              inl result : mut (list' t) = empty' () |> mut
              inl len = $'##(!list)' : i32
              let rec 루프 i =
                  if i >= len
                  then *result
                  else
                      inl item = $'!list[!i + 1]' : t
                      if fn item
                      then
                          result <- cons' item (*result)
                          루프 (i + 1i32)
                      else 루프 (i + 1i32)
              루프 0i32
          Fsharp = fun () => list |> $'"List.filter !fn"' : list' t
          Python = fun () => $'list(filter(!fn, !list))' : list' t
          Rust = fun () =>
              inl len : i32 = $'(!list).len() as i32'
              let rec 루프 (i : i32) (acc : list t) : list t =
                  if i < 0i32 then acc
                  else
                      inl item : t = $'(!list)[!i as usize].clone()'
                      루프 (i - 1i32) (if fn item then Cons (item, acc) else acc)
              루프 (len - 1i32) Nil |> box
      }
  """,
  timeout: 300_000
)
```

