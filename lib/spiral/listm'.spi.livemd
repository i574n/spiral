<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":":= filter' \\* t. (fn : t -> bool) (list : list' t) : list' t =\n    backend_switch {\n        Gleam = \\ () => $'!list |> list.filter(!fn)' : list' t\n        Lua = \\ () =>\n            := result : mut (list' t) = empty' () |> mut\n            := len = $'##(!list)' : i32\n            :~ ^ 루프 i =\n                ? i < 0i32\n                ?> *result\n                |:\n                    := item = lua_list_item i list\n                    ? fn item ?>\n                        result <- cons' item (*result)\n                        루프 (i - 1i32)\n                    |: 루프 (i - 1i32)\n            루프 (len - 1i32)\n        Fsharp = \\ () => list |> $'\"List.filter !fn\"' : list' t\n        Python = \\ () => $'list(filter(!fn, !list))' : list' t\n        Rust = \\ () =>\n            := len : i32 = rust_list_count list\n            :~ ^ 루프 (i : i32) (acc : list t) : list t =\n                ? i < 0i32 ?> acc\n                |:\n                    := item : t = rust_list_item i list\n                    루프 (i - 1i32) (? fn item ?> (item :: acc) |: acc)\n            루프 (len - 1i32) [] |> box\n        TypeScript = \\ () =>\n            := len : i32 = $'!list.length'\n            :~ ^ 루프 (i : i32) (acc : list t) : list t =\n                ? i < 0i32 ?> acc\n                |:\n                    := item : t = $'!list[!i]'\n                    루프 (i - 1i32) (? fn item ?> (item :: acc) |: acc)\n            루프 (len - 1i32) [] |> box\n        Zig = \\ () =>\n            := len : i32 = $'@@as(i32, @@intCast(!list.len))'\n            :~ ^ 루프 (i : i32) (acc : list t) : list t =\n                ? i < 0i32 ?> acc\n                |:\n                    := item : t = $'!list[@@intCast(!i)]'\n                    루프 (i - 1i32) (? fn item ?> (item :: acc) |: acc)\n            루프 (len - 1i32) [] |> box\n    }\n\n:= map \\* t u. (fn : t -> u) (list : list' t) : list' u =\n    list'_types ()\n    backend_switch {\n        Gleam = \\ () => $'!list |> list.map(!fn)' : list' u\n        Lua = \\ () =>\n            := result : mut (list' u) = empty' () |> mut\n            := len = $'##(!list)' : i32\n            :~ ^ 루프 i =\n                ? i < 0i32\n                ?> *result\n                |:\n                    result <- cons' (fn (lua_list_item i list)) (*result)\n                    루프 (i - 1i32)\n            루프 (len - 1i32)\n        Fsharp = \\ () => list |> $'List.map' fn : list' u\n        Python = \\ () => $'list(map(!fn, !list))' : list' u\n        Rust = \\ () => fold_back' fn list [] |> box\n        TypeScript = \\ () => fold_back' fn list [] |> box\n        Zig = \\ () => fold_back' fn list [] |> box\n    }\n\n:= unbox \\* t. (list : list' t) : list t =\n    (list, [])\n    ||> fold_back' id\n\n:= distinct' \\* t. (list : list' t) : list' t =\n    list'_types ()\n    backend_switch {\n        Gleam = \\ () => $'!list |> list.unique' : list' t\n        Lua = \\ () =>\n            := result : mut (list' t) = empty' () |> mut\n            := len = $'##(!list)' : i32\n            := seen : mut (list t) = [] |> mut\n            :~ ^ 루프 i =\n                ? i >= len\n                ?> rev' *result\n                |:\n                    := item = lua_list_item i list\n                    ? exists' (\\ x => x = item) (*seen)\n                    ?> 루프 (i + 1i32)\n                    |:\n                        seen <- item :: *seen\n                        result <- cons' item (*result)\n                        루프 (i + 1i32)\n            루프 0i32\n        Fsharp = \\ () => list |> $'List.distinct' : list' t\n        Python = \\ () =>\n            $'x = list(set(!list))'\n            $'x.sort(key=!list.index)'\n            $'x' : list' t\n        Rust = \\ () =>\n            := len : i32 = rust_list_count list\n            :~ ^ 루프 (i : i32) (seen : list t) : list t =\n                ? i >= len ?> seen\n                |:\n                    := item : t = rust_list_item i list\n                    루프 (i + 1i32) (? exists' (\\ x => x = item) seen ?> seen |: (item :: seen))\n            루프 0i32 [] |> box |> rev'\n        TypeScript = \\ () =>\n            := len : i32 = $'!list.length'\n            :~ ^ 루프 (i : i32) (seen : list t) : list t =\n                ? i >= len ?> seen\n                |:\n                    := item : t = $'!list[!i]'\n                    루프 (i + 1i32) (? exists' (\\ x => x = item) seen ?> seen |: (item :: seen))\n            루프 0i32 [] |> box |> rev'\n        Zig = \\ () =>\n            := len : i32 = $'@@as(i32, @@intCast(!list.len))'\n            :~ ^ 루프 (i : i32) (seen : list t) : list t =\n                ? i >= len ?> seen\n                |:\n                    := item : t = $'!list[@@intCast(!i)]'\n                    루프 (i + 1i32) (? exists' (\\ x => x = item) seen ?> seen |: (item :: seen))\n            루프 0i32 [] |> box |> rev'\n    }","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  := filter' \* t. (fn : t -> bool) (list : list' t) : list' t =
      backend_switch {
          Gleam = \ () => $'!list |> list.filter(!fn)' : list' t
          Lua = \ () =>
              := result : mut (list' t) = empty' () |> mut
              := len = $'##(!list)' : i32
              :~ ^ 루프 i =
                  ? i < 0i32
                  ?> *result
                  |:
                      := item = lua_list_item i list
                      ? fn item ?>
                          result <- cons' item (*result)
                          루프 (i - 1i32)
                      |: 루프 (i - 1i32)
              루프 (len - 1i32)
          Fsharp = \ () => list |> $'"List.filter !fn"' : list' t
          Python = \ () => $'list(filter(!fn, !list))' : list' t
          Rust = \ () =>
              := len : i32 = rust_list_count list
              :~ ^ 루프 (i : i32) (acc : list t) : list t =
                  ? i < 0i32 ?> acc
                  |:
                      := item : t = rust_list_item i list
                      루프 (i - 1i32) (? fn item ?> (item :: acc) |: acc)
              루프 (len - 1i32) [] |> box
          TypeScript = \ () =>
              := len : i32 = $'!list.length'
              :~ ^ 루프 (i : i32) (acc : list t) : list t =
                  ? i < 0i32 ?> acc
                  |:
                      := item : t = $'!list[!i]'
                      루프 (i - 1i32) (? fn item ?> (item :: acc) |: acc)
              루프 (len - 1i32) [] |> box
          Zig = \ () =>
              := len : i32 = $'@@as(i32, @@intCast(!list.len))'
              :~ ^ 루프 (i : i32) (acc : list t) : list t =
                  ? i < 0i32 ?> acc
                  |:
                      := item : t = $'!list[@@intCast(!i)]'
                      루프 (i - 1i32) (? fn item ?> (item :: acc) |: acc)
              루프 (len - 1i32) [] |> box
      }

  := map \* t u. (fn : t -> u) (list : list' t) : list' u =
      list'_types ()
      backend_switch {
          Gleam = \ () => $'!list |> list.map(!fn)' : list' u
          Lua = \ () =>
              := result : mut (list' u) = empty' () |> mut
              := len = $'##(!list)' : i32
              :~ ^ 루프 i =
                  ? i < 0i32
                  ?> *result
                  |:
                      result <- cons' (fn (lua_list_item i list)) (*result)
                      루프 (i - 1i32)
              루프 (len - 1i32)
          Fsharp = \ () => list |> $'List.map' fn : list' u
          Python = \ () => $'list(map(!fn, !list))' : list' u
          Rust = \ () => fold_back' fn list [] |> box
          TypeScript = \ () => fold_back' fn list [] |> box
          Zig = \ () => fold_back' fn list [] |> box
      }

  := unbox \* t. (list : list' t) : list t =
      (list, [])
      ||> fold_back' id

  := distinct' \* t. (list : list' t) : list' t =
      list'_types ()
      backend_switch {
          Gleam = \ () => $'!list |> list.unique' : list' t
          Lua = \ () =>
              := result : mut (list' t) = empty' () |> mut
              := len = $'##(!list)' : i32
              := seen : mut (list t) = [] |> mut
              :~ ^ 루프 i =
                  ? i >= len
                  ?> rev' *result
                  |:
                      := item = lua_list_item i list
                      ? exists' (\ x => x = item) (*seen)
                      ?> 루프 (i + 1i32)
                      |:
                          seen <- item :: *seen
                          result <- cons' item (*result)
                          루프 (i + 1i32)
              루프 0i32
          Fsharp = \ () => list |> $'List.distinct' : list' t
          Python = \ () =>
              $'x = list(set(!list))'
              $'x.sort(key=!list.index)'
              $'x' : list' t
          Rust = \ () =>
              := len : i32 = rust_list_count list
              :~ ^ 루프 (i : i32) (seen : list t) : list t =
                  ? i >= len ?> seen
                  |:
                      := item : t = rust_list_item i list
                      루프 (i + 1i32) (? exists' (\ x => x = item) seen ?> seen |: (item :: seen))
              루프 0i32 [] |> box |> rev'
          TypeScript = \ () =>
              := len : i32 = $'!list.length'
              :~ ^ 루프 (i : i32) (seen : list t) : list t =
                  ? i >= len ?> seen
                  |:
                      := item : t = $'!list[!i]'
                      루프 (i + 1i32) (? exists' (\ x => x = item) seen ?> seen |: (item :: seen))
              루프 0i32 [] |> box |> rev'
          Zig = \ () =>
              := len : i32 = $'@@as(i32, @@intCast(!list.len))'
              :~ ^ 루프 (i : i32) (seen : list t) : list t =
                  ? i >= len ?> seen
                  |:
                      := item : t = $'!list[@@intCast(!i)]'
                      루프 (i + 1i32) (? exists' (\ x => x = item) seen ?> seen |: (item :: seen))
              루프 0i32 [] |> box |> rev'
      }
  """,
  timeout: 300_000
)
```

