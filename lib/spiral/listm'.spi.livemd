<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":":= collect \\* t r. (fn : t -> list r) (items : list t) : list r =\n    listm::foldBack (\\ x acc => listm::append (fn x) acc) items []\n\n:= replicate count x =\n    listm::init count \\ _ => x\n\n:= map4 f l1 l2 l3 l4 =\n    := ^ 루프 l1 l2 l3 l4 acc =\n        ?= l1, l2, l3, l4 ?|\n        | (x1 :: xs1), (x2 :: xs2), (x3 :: xs3), (x4 :: xs4) =>\n            루프 xs1 xs2 xs3 xs4 (f x1 x2 x3 x4 :: acc)\n        | _ => listm::rev acc\n    루프 l1 l2 l3 l4 []\n\n:= map4_ f l1 l2 l3 l4 =\n    :~ ^ 루프 l1 l2 l3 l4 acc =\n        ?= l1, l2, l3, l4 ?|\n        | (x1 :: xs1), (x2 :: xs2), (x3 :: xs3), (x4 :: xs4) =>\n            루프 xs1 xs2 xs3 xs4 (f x1 x2 x3 x4 :: acc)\n        | _ => acc |> listm::rev\n    루프 l1 l2 l3 l4 []","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  := collect \* t r. (fn : t -> list r) (items : list t) : list r =
      listm::foldBack (\ x acc => listm::append (fn x) acc) items []

  := replicate count x =
      listm::init count \ _ => x

  := map4 f l1 l2 l3 l4 =
      := ^ 루프 l1 l2 l3 l4 acc =
          ?= l1, l2, l3, l4 ?|
          | (x1 :: xs1), (x2 :: xs2), (x3 :: xs3), (x4 :: xs4) =>
              루프 xs1 xs2 xs3 xs4 (f x1 x2 x3 x4 :: acc)
          | _ => listm::rev acc
      루프 l1 l2 l3 l4 []

  := map4_ f l1 l2 l3 l4 =
      :~ ^ 루프 l1 l2 l3 l4 acc =
          ?= l1, l2, l3, l4 ?|
          | (x1 :: xs1), (x2 :: xs2), (x3 :: xs3), (x4 :: xs4) =>
              루프 xs1 xs2 xs3 xs4 (f x1 x2 x3 x4 :: acc)
          | _ => acc |> listm::rev
      루프 l1 l2 l3 l4 []
  """,
  timeout: 300_000
)
```

