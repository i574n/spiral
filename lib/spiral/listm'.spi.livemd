<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":":= group_by fn list =\n    (list, [])\n    ||> listm::foldBack \\ x acc =>\n        := xk = fn x\n        := found, new_acc =\n            ((!-, []), acc)\n            ||> listm::fold \\ (found, acc') (k, xs) =>\n                ? k = xk\n                ?> !+, (k, x :: xs) :: acc'\n                |: found, (k, xs) :: acc'\n        ? found\n        ?> new_acc\n        |: (xk, [ x ]) :: new_acc","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  := group_by fn list =
      (list, [])
      ||> listm::foldBack \ x acc =>
          := xk = fn x
          := found, new_acc =
              ((!-, []), acc)
              ||> listm::fold \ (found, acc') (k, xs) =>
                  ? k = xk
                  ?> !+, (k, x :: xs) :: acc'
                  |: found, (k, xs) :: acc'
          ? found
          ?> new_acc
          |: (xk, [ x ]) :: new_acc
  """,
  timeout: 300_000
)
```

