<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":":= exists' f x =\n    := ^ body f = \\|\n        | [] => !-\n        | x :: xs =>\n            ? f x\n            ?> !+\n            |: 루프 xs\n    :& := 루프 list =\n        ? var_is list |> not\n        ?> body f list\n        |:\n            := f = ~~ f\n            := list = dyn list\n            ~~ body f list\n    루프 x","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  := exists' f x =
      := ^ body f = \|
          | [] => !-
          | x :: xs =>
              ? f x
              ?> !+
              |: 루프 xs
      :& := 루프 list =
          ? var_is list |> not
          ?> body f list
          |:
              := f = ~~ f
              := list = dyn list
              ~~ body f list
      루프 x
  """,
  timeout: 300_000
)
```

#### exists (test)

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":"///- --test --print-code --symbol\n///> rust\n///> gleam\n///> cuda\n///> typescript\n\n[ 'a'; 'b'; 'c' ]\n|> exists' \\ x => x = 'b'\n|> _assert_eq !+\n\n[ 'a'; 'b' ]\n|> exists' \\ x => x = 'c'\n|> _assert_eq !-\n\n[] |> exists' (\\ x => x = 'a') |> _assert_eq !-","print_code":true},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  ///- --test --print-code --symbol
  ///> rust
  ///> gleam
  ///> cuda
  ///> typescript

  [ 'a'; 'b'; 'c' ]
  |> exists' \ x => x = 'b'
  |> _assert_eq !+

  [ 'a'; 'b' ]
  |> exists' \ x => x = 'c'
  |> _assert_eq !-

  [] |> exists' (\ x => x = 'a') |> _assert_eq !-
  """,
  timeout: 300_000,
  print_code: true
)
```

## fsharp

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":":= list'_types () =\n    backend_switch {\n        Gleam = \\ () => global \"import gleam/list\"\n        Lua = \\ () => ()\n        Rust = \\ () => ()\n    }\n:== list'_switch t =\n    {\n        Gleam : $'List(`t)'\n        Fsharp : $'`t list'\n        Python : $'list'\n        Rust : $'Rc<Vec<`t>>'\n        TypeScript : $'Array<`t>'\n        Zig : $'[]const `(t)'\n    }\n:! list' t = $'backend_switch `(list'_switch t)'\n\n:= empty' \\* t. () : list' t =\n    backend_switch {\n        Gleam = \\ () => $'[]' : list' t\n        Lua = \\ () => $'{}' : list' t\n        Fsharp = \\ () => $'[]' : list' t\n        Python = \\ () => $'[]' : list' t\n        Rust = \\ () => $'Rc::new(<Vec<`t>>::new())' : list' t\n        TypeScript = \\ () => $'[]' : list' t\n        Zig = \\ () => $'spiralNewArray(`t, 0)' : list' t\n    }\n\n:= cons' \\* t. (head : t) (tail : list' t) : list' t =\n    backend_switch {\n        Gleam = \\ () => $'[ !head, ..!tail ]' : list' t\n        Lua = \\ () =>\n            := len = $'##(!tail)' : i32\n            := r : array t = arraym::init (len + 1i32) \\ i => ? i = 0i32 ?> head |: $'!tail[!i]' : t\n            := (array r) = r\n            $'!r ' : list' t\n        Fsharp = \\ () => $'!head :: !tail ' : list' t\n        Python = \\ () => $'([!head] + !tail)' : list' t\n        Rust = \\ () => $'Rc::new({ let mut v = (!tail).as_ref().clone(); v.insert(0, !head); v })' : list' t\n        TypeScript = \\ () => $'[!head, ...!tail]' : list' t\n        Zig = \\ () =>\n            := len : i32 = $'@@as(i32, @@intCast(!tail.len))'\n            := r : array t = arraym::init (len + 1i32) \\ i =>\n                ? i = 0i32\n                ?> head\n                |: $'!tail[@@intCast(!i - 1)]' : t\n            := (array r) = r\n            $'!r ' : list' t\n    }\n\n:= box \\* t. (list : list t) : list' t =\n    run_target \\|\n        | Zig => \\ () =>\n            (list, empty' ()) ||> listm::foldBack cons'\n        | Rust => \\ () =>\n            := acc : $'Rc<RefCell<Vec<`t>>>' = $'Rc::new(RefCell::new(Vec::new()))'\n            := _ : i32 = (0i32, list) ||> listm::fold \\ n (x : t) =>\n                $'!acc.borrow_mut().push(!x)' : ()\n                n + 1\n            $'Rc::new(!acc.borrow().clone())' : list' t\n        | _ => \\ () => (list, empty' ()) ||> listm::foldBack cons'\n\n:= rust_list_count \\* t. (list : list' t) : i32 =\n    ($'(!list).len()' : convert::unativeint) |> convert::convert\n\n:= rust_list_item \\* t. (i : i32) (list : list' t) : t =\n    := at : convert::unativeint = convert::convert i\n    $'(!list)[!at].clone()' : t\n\n:= lua_list_item \\* t. (i : i32) (list : list' t) : t =\n    := at = i + 1i32\n    $'!list[!at]' : t\n\n:= rev' \\* t. (items : list' t) : list' t =\n    backend_switch {\n        Gleam = \\ () => $'!items |> list.reverse' : list' t\n        Lua = \\ () =>\n            := result : mut (list' t) = empty' () |> mut\n            := len = $'##(!items)' : i32\n            :~ ^ 루프 i =\n                ? i >= len\n                ?> *result\n                |:\n                    result <- cons' (lua_list_item i items) (*result)\n                    루프 (i + 1i32)\n            루프 0i32\n        Fsharp = \\ () => items |> $'List.rev' : list' t\n        Python = \\ () => $'list(reversed(!items))' : list' t\n        Rust = \\ () => $'Rc::new((!items).as_ref().iter().rev().cloned().collect::<Vec<_>>())' : list' t\n        TypeScript = \\ () => $'[...!items].reverse()' : list' t\n        Zig = fun () => $'blk: { const r = spiral_gpa.dupe(`t, !items) catch \\@panic(\"out of memory\"); \\\n            std.mem.reverse(`t, r); break :blk r; }' : list' t\n    }\n\n:= fold' \\* t u. (fn : t -> u) (init : list u) (list : list' t) : list u =\n    backend_switch {\n        Gleam = \\ () =>\n            global \"import gleam/list\"\n            $'let listm_fold = !list |> list.fold (!init, fn (acc, x) {'\n            $'!((fn $'x' :: $'acc'))' : ()\n            $'})' : ()\n            $'listm_fold' : list u\n        Lua = \\ () =>\n            := result : mut (list u) = init |> mut\n            := len = $'##(!list)' : i32\n            :~ ^ 루프 i =\n                ? i >= len\n                ?> *result\n                |:\n                    result <- fn (lua_list_item i list) :: *result\n                    루프 (i + 1i32)\n            루프 0i32\n        Fsharp = \\ () =>\n            (init, list)\n            ||> $'List.fold' ~~ \\ acc x => (fn x :: acc)\n            : list u\n        Python = \\ () =>\n            := len : i32 = $'len(!list)'\n            :~ ^ 루프 (i : i32) (acc : list u) : list u =\n                ? i >= len ?> acc\n                |:\n                    := item : t = $'!list[!i]'\n                    루프 (i + 1i32) ((fn item :: acc))\n            루프 0i32 init\n        Rust = \\ () =>\n            := len : i32 = rust_list_count list\n            :~ ^ 루프 (i : i32) (acc : list u) : list u =\n                ? i >= len ?> acc\n                |:\n                    := item : t = rust_list_item i list\n                    루프 (i + 1i32) ((fn item :: acc))\n            루프 0i32 init\n        TypeScript = \\ () =>\n            := len : i32 = $'!list.length'\n            :~ ^ 루프 (i : i32) (acc : list u) : list u =\n                ? i >= len ?> acc\n                |:\n                    := item : t = $'!list[!i]'\n                    루프 (i + 1i32) ((fn item :: acc))\n            루프 0i32 init\n        Zig = \\ () =>\n            := len : i32 = $'@@as(i32, @@intCast(!list.len))'\n            :~ ^ 루프 (i : i32) (acc : list u) : list u =\n                ? i >= len ?> acc\n                |:\n                    := item : t = $'!list[@@intCast(!i)]'\n                    루프 (i + 1i32) ((fn item :: acc))\n            루프 0i32 init\n    }","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  := list'_types () =
      backend_switch {
          Gleam = \ () => global "import gleam/list"
          Lua = \ () => ()
          Rust = \ () => ()
      }
  :== list'_switch t =
      {
          Gleam : $'List(`t)'
          Fsharp : $'`t list'
          Python : $'list'
          Rust : $'Rc<Vec<`t>>'
          TypeScript : $'Array<`t>'
          Zig : $'[]const `(t)'
      }
  :! list' t = $'backend_switch `(list'_switch t)'

  := empty' \* t. () : list' t =
      backend_switch {
          Gleam = \ () => $'[]' : list' t
          Lua = \ () => $'{}' : list' t
          Fsharp = \ () => $'[]' : list' t
          Python = \ () => $'[]' : list' t
          Rust = \ () => $'Rc::new(<Vec<`t>>::new())' : list' t
          TypeScript = \ () => $'[]' : list' t
          Zig = \ () => $'spiralNewArray(`t, 0)' : list' t
      }

  := cons' \* t. (head : t) (tail : list' t) : list' t =
      backend_switch {
          Gleam = \ () => $'[ !head, ..!tail ]' : list' t
          Lua = \ () =>
              := len = $'##(!tail)' : i32
              := r : array t = arraym::init (len + 1i32) \ i => ? i = 0i32 ?> head |: $'!tail[!i]' : t
              := (array r) = r
              $'!r ' : list' t
          Fsharp = \ () => $'!head :: !tail ' : list' t
          Python = \ () => $'([!head] + !tail)' : list' t
          Rust = \ () => $'Rc::new({ let mut v = (!tail).as_ref().clone(); v.insert(0, !head); v })' : list' t
          TypeScript = \ () => $'[!head, ...!tail]' : list' t
          Zig = \ () =>
              := len : i32 = $'@@as(i32, @@intCast(!tail.len))'
              := r : array t = arraym::init (len + 1i32) \ i =>
                  ? i = 0i32
                  ?> head
                  |: $'!tail[@@intCast(!i - 1)]' : t
              := (array r) = r
              $'!r ' : list' t
      }

  := box \* t. (list : list t) : list' t =
      run_target \|
          | Zig => \ () =>
              (list, empty' ()) ||> listm::foldBack cons'
          | Rust => \ () =>
              := acc : $'Rc<RefCell<Vec<`t>>>' = $'Rc::new(RefCell::new(Vec::new()))'
              := _ : i32 = (0i32, list) ||> listm::fold \ n (x : t) =>
                  $'!acc.borrow_mut().push(!x)' : ()
                  n + 1
              $'Rc::new(!acc.borrow().clone())' : list' t
          | _ => \ () => (list, empty' ()) ||> listm::foldBack cons'

  := rust_list_count \* t. (list : list' t) : i32 =
      ($'(!list).len()' : convert::unativeint) |> convert::convert

  := rust_list_item \* t. (i : i32) (list : list' t) : t =
      := at : convert::unativeint = convert::convert i
      $'(!list)[!at].clone()' : t

  := lua_list_item \* t. (i : i32) (list : list' t) : t =
      := at = i + 1i32
      $'!list[!at]' : t

  := rev' \* t. (items : list' t) : list' t =
      backend_switch {
          Gleam = \ () => $'!items |> list.reverse' : list' t
          Lua = \ () =>
              := result : mut (list' t) = empty' () |> mut
              := len = $'##(!items)' : i32
              :~ ^ 루프 i =
                  ? i >= len
                  ?> *result
                  |:
                      result <- cons' (lua_list_item i items) (*result)
                      루프 (i + 1i32)
              루프 0i32
          Fsharp = \ () => items |> $'List.rev' : list' t
          Python = \ () => $'list(reversed(!items))' : list' t
          Rust = \ () => $'Rc::new((!items).as_ref().iter().rev().cloned().collect::<Vec<_>>())' : list' t
          TypeScript = \ () => $'[...!items].reverse()' : list' t
          Zig = fun () => $'blk: { const r = spiral_gpa.dupe(`t, !items) catch \@panic("out of memory"); \
              std.mem.reverse(`t, r); break :blk r; }' : list' t
      }

  := fold' \* t u. (fn : t -> u) (init : list u) (list : list' t) : list u =
      backend_switch {
          Gleam = \ () =>
              global "import gleam/list"
              $'let listm_fold = !list |> list.fold (!init, fn (acc, x) {'
              $'!((fn $'x' :: $'acc'))' : ()
              $'})' : ()
              $'listm_fold' : list u
          Lua = \ () =>
              := result : mut (list u) = init |> mut
              := len = $'##(!list)' : i32
              :~ ^ 루프 i =
                  ? i >= len
                  ?> *result
                  |:
                      result <- fn (lua_list_item i list) :: *result
                      루프 (i + 1i32)
              루프 0i32
          Fsharp = \ () =>
              (init, list)
              ||> $'List.fold' ~~ \ acc x => (fn x :: acc)
              : list u
          Python = \ () =>
              := len : i32 = $'len(!list)'
              :~ ^ 루프 (i : i32) (acc : list u) : list u =
                  ? i >= len ?> acc
                  |:
                      := item : t = $'!list[!i]'
                      루프 (i + 1i32) ((fn item :: acc))
              루프 0i32 init
          Rust = \ () =>
              := len : i32 = rust_list_count list
              :~ ^ 루프 (i : i32) (acc : list u) : list u =
                  ? i >= len ?> acc
                  |:
                      := item : t = rust_list_item i list
                      루프 (i + 1i32) ((fn item :: acc))
              루프 0i32 init
          TypeScript = \ () =>
              := len : i32 = $'!list.length'
              :~ ^ 루프 (i : i32) (acc : list u) : list u =
                  ? i >= len ?> acc
                  |:
                      := item : t = $'!list[!i]'
                      루프 (i + 1i32) ((fn item :: acc))
              루프 0i32 init
          Zig = \ () =>
              := len : i32 = $'@@as(i32, @@intCast(!list.len))'
              :~ ^ 루프 (i : i32) (acc : list u) : list u =
                  ? i >= len ?> acc
                  |:
                      := item : t = $'!list[@@intCast(!i)]'
                      루프 (i + 1i32) ((fn item :: acc))
              루프 0i32 init
      }
  """,
  timeout: 300_000
)
```

