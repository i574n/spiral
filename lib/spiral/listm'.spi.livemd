<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":":= fold_back' \\* t u. (fn : t -> u) (list : list' t) (init : list u) : list u =\n    backend_switch {\n        Gleam = \\ () =>\n            global \"import gleam/list\"\n            $'let listm_fold_back = !list |> list.fold_right (!init, fn (acc, x) {'\n            $'!((fn $'x' :: $'acc'))' : ()\n            $'})' : ()\n            $'listm_fold_back' : list u\n        Lua = \\ () =>\n            list\n            |> rev'\n            |> fold' fn init\n        Fsharp = \\ () =>\n            (list, init)\n            ||> $'List.foldBack' ~~ \\ x acc => (fn x :: acc)\n            : list u\n        Python = \\ () =>\n            list\n            |> rev'\n            |> fold' fn init\n        Rust = \\ () =>\n            := len : i32 = rust_list_count list\n            :~ ^ 루프 (i : i32) (acc : list u) : list u =\n                ? i < 0i32 ?> acc\n                |:\n                    := item : t = rust_list_item i list\n                    루프 (i - 1i32) ((fn item :: acc))\n            루프 (len - 1i32) init\n        TypeScript = \\ () =>\n            := len : i32 = $'!list.length'\n            :~ ^ 루프 (i : i32) (acc : list u) : list u =\n                ? i < 0i32 ?> acc\n                |:\n                    := item : t = $'!list[!i]'\n                    루프 (i - 1i32) ((fn item :: acc))\n            루프 (len - 1i32) init\n        Zig = \\ () =>\n            := len : i32 = $'@@as(i32, @@intCast(!list.len))'\n            :~ ^ 루프 (i : i32) (acc : list u) : list u =\n                ? i < 0i32 ?> acc\n                |:\n                    := item : t = $'!list[@@intCast(!i)]'\n                    루프 (i - 1i32) ((fn item :: acc))\n            루프 (len - 1i32) init\n    }\n\n:= shared_tail_folds () =\n    := tail = box [ 2i32 ]\n    := first = cons' 1i32 tail\n    := second = cons' 9i32 tail\n    (fold_back' id first [], fold_back' id second [], fold_back' id tail [])","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  := fold_back' \* t u. (fn : t -> u) (list : list' t) (init : list u) : list u =
      backend_switch {
          Gleam = \ () =>
              global "import gleam/list"
              $'let listm_fold_back = !list |> list.fold_right (!init, fn (acc, x) {'
              $'!((fn $'x' :: $'acc'))' : ()
              $'})' : ()
              $'listm_fold_back' : list u
          Lua = \ () =>
              list
              |> rev'
              |> fold' fn init
          Fsharp = \ () =>
              (list, init)
              ||> $'List.foldBack' ~~ \ x acc => (fn x :: acc)
              : list u
          Python = \ () =>
              list
              |> rev'
              |> fold' fn init
          Rust = \ () =>
              := len : i32 = rust_list_count list
              :~ ^ 루프 (i : i32) (acc : list u) : list u =
                  ? i < 0i32 ?> acc
                  |:
                      := item : t = rust_list_item i list
                      루프 (i - 1i32) ((fn item :: acc))
              루프 (len - 1i32) init
          TypeScript = \ () =>
              := len : i32 = $'!list.length'
              :~ ^ 루프 (i : i32) (acc : list u) : list u =
                  ? i < 0i32 ?> acc
                  |:
                      := item : t = $'!list[!i]'
                      루프 (i - 1i32) ((fn item :: acc))
              루프 (len - 1i32) init
          Zig = \ () =>
              := len : i32 = $'@@as(i32, @@intCast(!list.len))'
              :~ ^ 루프 (i : i32) (acc : list u) : list u =
                  ? i < 0i32 ?> acc
                  |:
                      := item : t = $'!list[@@intCast(!i)]'
                      루프 (i - 1i32) ((fn item :: acc))
              루프 (len - 1i32) init
      }

  := shared_tail_folds () =
      := tail = box [ 2i32 ]
      := first = cons' 1i32 tail
      := second = cons' 9i32 tail
      (fold_back' id first [], fold_back' id second [], fold_back' id tail [])
  """,
  timeout: 300_000
)
```

