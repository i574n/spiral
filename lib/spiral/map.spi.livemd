<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":":! hash_map k v =\n    `(\n        rust::rust_type\n            `($'std_collections_HashMap<`k, `v>')\n            `($'std::collections::HashMap<`k, `v>')\n            \"type std_collections_HashMap<'K, 'V> = class end\"\n    )\n\n:! b_tree_map k v =\n    `(\n        rust::rust_type\n            `($'std_collections_BTreeMap<`k, `v>')\n            `($'std::collections::BTreeMap<`k, `v>')\n            \"type std_collections_BTreeMap<'K, 'V> = class end\"\n    )\n\n:= new_hash_map () : hash_map _ _ =\n    !\\($'\"std::collections::HashMap::new()\"')\n\n:= new_b_tree_map () : b_tree_map _ _ =\n    !\\($'\"std::collections::BTreeMap::new()\"')\n\n:= get \\* k v. (key : k) (map : hash_map k v) : optionm'::option' v =\n    := key = ~~ key\n    !\\\\(map, $'\"std::collections::HashMap::get(&$0, &!key).map(|x| x).cloned()\"')\n\n:= insert \\* k v. (key : k) (value : v) (map : hash_map k v) : optionm'::option' v =\n    := key = ~~ key\n    !\\($'\"let mut !map = !map\"')\n    !\\($'\"std::collections::HashMap::insert(&mut !map, !key, !value)\"')\n\n:= map' \\* k v w. (fn : v -> w) (map : hash_map k v) : hash_map k w =\n    !\\\\((map, fn), $'\"$0.into_iter().map(|(k, v)| (k, $1(v))).collect()\"')\n\n:= hash_map_count \\* k v. (map : hash_map k v) : i32 =\n    !\\\\(map, $'\"$0.count()\"')\n\n:= from_vec \\* k v. (vec : am'::vec (k * v)) : hash_map k v =\n    !\\($'\"std::collections::HashMap::from_iter(!vec)\"')\n\n:= from_vec_pairs \\* k v. (vec : am'::vec (pair k v)) : hash_map k v =\n    !\\($'\"std::collections::HashMap::from_iter(!vec.iter().map(|&(ref k, ref v)| (k.clone(), v.clone())))\"')\n\n:= b_tree_map_from_vec_pairs \\* k v. (vec : am'::vec (pair k v)) : b_tree_map k v =\n    !\\($'\"std::collections::BTreeMap::from_iter(!vec.iter().map(|&(ref k, ref v)| (k.clone(), v.clone())))\"')\n\n:= from_array \\* k v. (array : array_base (k * v)) : hash_map k v =\n    array |> am'::to_vec |> from_vec\n\n:= from_list \\* k v. (list : list (k * v)) : hash_map k v =\n    := (array list) : array _ = list |> arraym::fromList\n    list |> am'::to_vec |> from_vec\n\n:= to_vec \\* k v. (map : hash_map k v) : am'::vec (k * v) =\n    !\\\\(map, $'\"$0.into_iter().map(|(k, v)| (k, v)).collect::<Vec<_>>()\"')","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  :! hash_map k v =
      `(
          rust::rust_type
              `($'std_collections_HashMap<`k, `v>')
              `($'std::collections::HashMap<`k, `v>')
              "type std_collections_HashMap<'K, 'V> = class end"
      )

  :! b_tree_map k v =
      `(
          rust::rust_type
              `($'std_collections_BTreeMap<`k, `v>')
              `($'std::collections::BTreeMap<`k, `v>')
              "type std_collections_BTreeMap<'K, 'V> = class end"
      )

  := new_hash_map () : hash_map _ _ =
      !\($'"std::collections::HashMap::new()"')

  := new_b_tree_map () : b_tree_map _ _ =
      !\($'"std::collections::BTreeMap::new()"')

  := get \* k v. (key : k) (map : hash_map k v) : optionm'::option' v =
      := key = ~~ key
      !\\(map, $'"std::collections::HashMap::get(&$0, &!key).map(|x| x).cloned()"')

  := insert \* k v. (key : k) (value : v) (map : hash_map k v) : optionm'::option' v =
      := key = ~~ key
      !\($'"let mut !map = !map"')
      !\($'"std::collections::HashMap::insert(&mut !map, !key, !value)"')

  := map' \* k v w. (fn : v -> w) (map : hash_map k v) : hash_map k w =
      !\\((map, fn), $'"$0.into_iter().map(|(k, v)| (k, $1(v))).collect()"')

  := hash_map_count \* k v. (map : hash_map k v) : i32 =
      !\\(map, $'"$0.count()"')

  := from_vec \* k v. (vec : am'::vec (k * v)) : hash_map k v =
      !\($'"std::collections::HashMap::from_iter(!vec)"')

  := from_vec_pairs \* k v. (vec : am'::vec (pair k v)) : hash_map k v =
      !\($'"std::collections::HashMap::from_iter(!vec.iter().map(|&(ref k, ref v)| (k.clone(), v.clone())))"')

  := b_tree_map_from_vec_pairs \* k v. (vec : am'::vec (pair k v)) : b_tree_map k v =
      !\($'"std::collections::BTreeMap::from_iter(!vec.iter().map(|&(ref k, ref v)| (k.clone(), v.clone())))"')

  := from_array \* k v. (array : array_base (k * v)) : hash_map k v =
      array |> am'::to_vec |> from_vec

  := from_list \* k v. (list : list (k * v)) : hash_map k v =
      := (array list) : array _ = list |> arraym::fromList
      list |> am'::to_vec |> from_vec

  := to_vec \* k v. (map : hash_map k v) : am'::vec (k * v) =
      !\\(map, $'"$0.into_iter().map(|(k, v)| (k, v)).collect::<Vec<_>>()"')
  """,
  timeout: 300_000
)
```

## fsharp

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":":! map k v = $'Map<`k, `v>'\n\n:= item \\* k v. (k : k) (map : map k v) : v =\n    $'!map.[!k]'\n\n:= of_array \\* k v. (array : array (k * v)) : map k v =\n    $'!array |> Array.map (fun (struct (a, b)) -> a, b) |> Map.ofArray'","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  :! map k v = $'Map<`k, `v>'

  := item \* k v. (k : k) (map : map k v) : v =
      $'!map.[!k]'

  := of_array \* k v. (array : array (k * v)) : map k v =
      $'!array |> Array.map (fun (struct (a, b)) -> a, b) |> Map.ofArray'
  """,
  timeout: 300_000
)
```
