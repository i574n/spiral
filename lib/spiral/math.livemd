## fsharp

<!-- livebook:{"break_markdown":true} -->

### atan2

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"inl atan2 (y : f64) (x : f64) : f64 =\n    backend_switch {\n        Gleam = fun () =>\n            global \"import gleam_community/maths\"\n            $'maths.atan2(!y, !x)' : float\n        Lua = fun () => $'math.atan2(!y, !x)' : float\n        Fsharp = fun () => $'System.Math.Atan2 (!y, !x)' : float\n        Python = fun () => \n            global \"import math\"\n            $'math.atan2(!y, !x)' : float\n        Rust = fun () => $'(!y).atan2(!x)' : float\n        Zig = fun () => $'std.math.atan2(!y, !x)' : float\n        Lean = fun () => $'Float.atan2 !y !x ' : float\n        C = fun () =>\n            global \"#include <tgmath.h>\"\n            $'atan2(!y, !x)' : float\n        Cpp = fun () =>\n            global \"#include <cmath>\"\n            $'std::atan2(!y, !x)' : float\n        Delphi = fun () => $'ArcTan2(!y, !x)' : float\n        Wasm = fun () => $'(call $math_atan2 !y !x)' : float\n        TypeScript = fun () => $'Math.atan2(!y, !x)' : float\n    }","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  inl atan2 (y : f64) (x : f64) : f64 =
      backend_switch {
          Gleam = fun () =>
              global "import gleam_community/maths"
              $'maths.atan2(!y, !x)' : float
          Lua = fun () => $'math.atan2(!y, !x)' : float
          Fsharp = fun () => $'System.Math.Atan2 (!y, !x)' : float
          Python = fun () => 
              global "import math"
              $'math.atan2(!y, !x)' : float
          Rust = fun () => $'(!y).atan2(!x)' : float
          Zig = fun () => $'std.math.atan2(!y, !x)' : float
          Lean = fun () => $'Float.atan2 !y !x ' : float
          C = fun () =>
              global "#include <tgmath.h>"
              $'atan2(!y, !x)' : float
          Cpp = fun () =>
              global "#include <cmath>"
              $'std::atan2(!y, !x)' : float
          Delphi = fun () => $'ArcTan2(!y, !x)' : float
          Wasm = fun () => $'(call $math_atan2 !y !x)' : float
          TypeScript = fun () => $'Math.atan2(!y, !x)' : float
      }
  """,
  timeout: 300_000
)
```

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"///- --test\n///> gleam -d gleam_community_maths=\\\">=2.0.0\\\"\n///> lua\n///> fsharp\n///> cuda\n\n0 |> atan2 1\n|> _assert_eq 1.5707963267948966","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  ///- --test
  ///> gleam -d gleam_community_maths=\">=2.0.0\"
  ///> lua
  ///> fsharp
  ///> cuda

  0 |> atan2 1
  |> _assert_eq 1.5707963267948966
  """,
  timeout: 300_000
)
```

## floor

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"inl floor forall t {float}. (n : t) : t =\n    backend_switch {\n        Gleam = fun () =>\n            global \"import gleam/float\"\n            n |> $'float.floor' : t\n        Lua = fun () => n |> $'math.floor' : t\n        Fsharp = fun () => n |> $'floor' : t\n        Python = fun () => \n            global \"import math\"\n            $'math.floor(!n)' : t\n        Rust = fun () => $'!n.floor()' : t\n        Zig = fun () => $'\\@floor(!n)' : t\n        Lean = fun () => $'(!n).floor' : t\n        C = fun () =>\n            global \"#include <tgmath.h>\"\n            $'floor(!n)' : t\n        Cpp = fun () =>\n            global \"#include <cmath>\"\n            $'std::floor(!n)' : t\n        Delphi = fun () => $'Int(!n) - Ord(Frac(!n) < 0)' : t\n        Wasm = fun () => $'(`t.floor !n)' : t\n        TypeScript = fun () => $'Math.floor(!n)' : t\n    }","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  inl floor forall t {float}. (n : t) : t =
      backend_switch {
          Gleam = fun () =>
              global "import gleam/float"
              n |> $'float.floor' : t
          Lua = fun () => n |> $'math.floor' : t
          Fsharp = fun () => n |> $'floor' : t
          Python = fun () => 
              global "import math"
              $'math.floor(!n)' : t
          Rust = fun () => $'!n.floor()' : t
          Zig = fun () => $'\@floor(!n)' : t
          Lean = fun () => $'(!n).floor' : t
          C = fun () =>
              global "#include <tgmath.h>"
              $'floor(!n)' : t
          Cpp = fun () =>
              global "#include <cmath>"
              $'std::floor(!n)' : t
          Delphi = fun () => $'Int(!n) - Ord(Frac(!n) < 0)' : t
          Wasm = fun () => $'(`t.floor !n)' : t
          TypeScript = fun () => $'Math.floor(!n)' : t
      }
  """,
  timeout: 300_000
)
```

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"///- --test\n///> gleam\n///> lua\n///> fsharp\n///> cuda\n\n0.6 |> floor\n|> _assert_eq 0f64","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  ///- --test
  ///> gleam
  ///> lua
  ///> fsharp
  ///> cuda

  0.6 |> floor
  |> _assert_eq 0f64
  """,
  timeout: 300_000
)
```

## ceil

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"inl ceil forall t {float}. (n : t) : t =\n    backend_switch {\n        Gleam = fun () =>\n            global \"import gleam/float\"\n            n |> $'float.ceiling' : t\n        Lua = fun () => n |> $'math.ceil' : t\n        Fsharp = fun () => n |> $'ceil' : t\n        Python = fun () =>\n            global \"import math\"\n            n |> $'math.ceil' : t\n        Rust = fun () => $'!n.ceil()' : t\n        Zig = fun () => $'\\@ceil(!n)' : t\n        Lean = fun () => $'(!n).ceil' : t\n        C = fun () =>\n            global \"#include <tgmath.h>\"\n            $'ceil(!n)' : t\n        Cpp = fun () =>\n            global \"#include <cmath>\"\n            $'std::ceil(!n)' : t\n        Delphi = fun () => $'Int(!n) + Ord(Frac(!n) > 0)' : t\n        Wasm = fun () => $'(`t.ceil !n)' : t\n        TypeScript = fun () => $'Math.ceil(!n)' : t\n    }","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  inl ceil forall t {float}. (n : t) : t =
      backend_switch {
          Gleam = fun () =>
              global "import gleam/float"
              n |> $'float.ceiling' : t
          Lua = fun () => n |> $'math.ceil' : t
          Fsharp = fun () => n |> $'ceil' : t
          Python = fun () =>
              global "import math"
              n |> $'math.ceil' : t
          Rust = fun () => $'!n.ceil()' : t
          Zig = fun () => $'\@ceil(!n)' : t
          Lean = fun () => $'(!n).ceil' : t
          C = fun () =>
              global "#include <tgmath.h>"
              $'ceil(!n)' : t
          Cpp = fun () =>
              global "#include <cmath>"
              $'std::ceil(!n)' : t
          Delphi = fun () => $'Int(!n) + Ord(Frac(!n) > 0)' : t
          Wasm = fun () => $'(`t.ceil !n)' : t
          TypeScript = fun () => $'Math.ceil(!n)' : t
      }
  """,
  timeout: 300_000
)
```

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"///- --test\n///> gleam\n///> lua\n///> fsharp\n///> cuda\n\n0.6 |> ceil\n|> _assert_eq 1f64","print_code":false},"livebook_object":"smart_cell"} -->

