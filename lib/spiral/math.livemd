## round

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"inl round forall t {number; float}. (x : t) : t =\n    inl round_half_to_even () =\n        inl lower = floor x\n        inl difference = x - lower\n        if difference > 0.5 then lower + 1\n        elif difference < 0.5 then lower\n        elif floor (lower / 2) * 2 = lower then lower\n        else lower + 1\n    backend_switch {\n        Gleam = round_half_to_even\n        Lua = round_half_to_even\n        Fsharp = fun () => x |> $'round' : t\n        Python = fun () => x |> $'round' : t\n        Rust = fun () => $'(!x).round_ties_even()' : t\n        Zig = round_half_to_even\n        Lean = round_half_to_even\n        C = round_half_to_even\n        Cpp = round_half_to_even\n        Delphi = round_half_to_even\n        TypeScript = round_half_to_even\n        Wasm = fun () => $'(`t.nearest !x)' : t\n    }","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  inl round forall t {number; float}. (x : t) : t =
      inl round_half_to_even () =
          inl lower = floor x
          inl difference = x - lower
          if difference > 0.5 then lower + 1
          elif difference < 0.5 then lower
          elif floor (lower / 2) * 2 = lower then lower
          else lower + 1
      backend_switch {
          Gleam = round_half_to_even
          Lua = round_half_to_even
          Fsharp = fun () => x |> $'round' : t
          Python = fun () => x |> $'round' : t
          Rust = fun () => $'(!x).round_ties_even()' : t
          Zig = round_half_to_even
          Lean = round_half_to_even
          C = round_half_to_even
          Cpp = round_half_to_even
          Delphi = round_half_to_even
          TypeScript = round_half_to_even
          Wasm = fun () => $'(`t.nearest !x)' : t
      }
  """,
  timeout: 300_000
)
```

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"///- --test\n///> gleam\n///> lua\n///> fsharp\n///> cuda\n\n0.5 |> round\n|> _assert_eq 0f64\n\n0.6 |> round\n|> _assert_eq 1f64\n\n1.5 |> round\n|> _assert_eq 2f64\n\n2.5 |> round\n|> _assert_eq 2f64\n\n3.5 |> round\n|> _assert_eq 4f64","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  ///- --test
  ///> gleam
  ///> lua
  ///> fsharp
  ///> cuda

  0.5 |> round
  |> _assert_eq 0f64

  0.6 |> round
  |> _assert_eq 1f64

  1.5 |> round
  |> _assert_eq 2f64

  2.5 |> round
  |> _assert_eq 2f64

  3.5 |> round
  |> _assert_eq 4f64
  """,
  timeout: 300_000
)
```

## log_base

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"inl log_base (new_base : f64) (a : f64) : f64 =\n    backend_switch {\n        Gleam = fun () => log a / log new_base\n        Lua = fun () => log a / log new_base\n        Fsharp = fun () => $'System.Math.Log (!a, !new_base)' : f64\n        Python = fun () => log a / log new_base\n        Rust = fun () => $'(!a).log(!new_base)' : f64\n        TypeScript = fun () => log a / log new_base\n        Zig = fun () => log a / log new_base\n        Lean = fun () => log a / log new_base\n    }","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  inl log_base (new_base : f64) (a : f64) : f64 =
      backend_switch {
          Gleam = fun () => log a / log new_base
          Lua = fun () => log a / log new_base
          Fsharp = fun () => $'System.Math.Log (!a, !new_base)' : f64
          Python = fun () => log a / log new_base
          Rust = fun () => $'(!a).log(!new_base)' : f64
          TypeScript = fun () => log a / log new_base
          Zig = fun () => log a / log new_base
          Lean = fun () => log a / log new_base
      }
  """,
  timeout: 300_000
)
```

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"///- --test\n\n100 |> log_base 10\n|> _assert_eq 2","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
