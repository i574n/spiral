## round

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"inl round forall t {number; float}. (x : t) : t =\n    backend_switch {\n        Gleam = fun () =>\n            if x < 1\n            then x - 0.5 |> ceil\n            else\n                inl result = x + 1 |> floor |> convert.i32\n                if result % 2 = 0\n                then result\n                else result - 1\n                |> convert.convert\n        Lua = fun () =>\n            if x < 1\n            then x - 0.5 |> ceil\n            else\n                inl result = x + 1 |> floor\n                if result % 2 = 0\n                then result\n                else result - 1\n        Fsharp = fun () => x |> $'round' : t\n        Python = fun () => x |> $'round' : t\n        // F#'s round (Math.Round) rounds half to even\n        Rust = fun () => $'(!x).round_ties_even()' : t\n    }","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  inl round forall t {number; float}. (x : t) : t =
      backend_switch {
          Gleam = fun () =>
              if x < 1
              then x - 0.5 |> ceil
              else
                  inl result = x + 1 |> floor |> convert.i32
                  if result % 2 = 0
                  then result
                  else result - 1
                  |> convert.convert
          Lua = fun () =>
              if x < 1
              then x - 0.5 |> ceil
              else
                  inl result = x + 1 |> floor
                  if result % 2 = 0
                  then result
                  else result - 1
          Fsharp = fun () => x |> $'round' : t
          Python = fun () => x |> $'round' : t
          // F#'s round (Math.Round) rounds half to even
          Rust = fun () => $'(!x).round_ties_even()' : t
      }
  """,
  timeout: 300_000
)
```

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"///- --test\n///> gleam\n///> lua\n///> fsharp\n///> cuda\n\n0.5 |> round\n|> _assert_eq 0f64\n\n0.6 |> round\n|> _assert_eq 1f64\n\n1.5 |> round\n|> _assert_eq 2f64\n\n2.5 |> round\n|> _assert_eq 2f64\n\n3.5 |> round\n|> _assert_eq 4f64","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  ///- --test
  ///> gleam
  ///> lua
  ///> fsharp
  ///> cuda

  0.5 |> round
  |> _assert_eq 0f64

  0.6 |> round
  |> _assert_eq 1f64

  1.5 |> round
  |> _assert_eq 2f64

  2.5 |> round
  |> _assert_eq 2f64

  3.5 |> round
  |> _assert_eq 4f64
  """,
  timeout: 300_000
)
```

## log_base

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"inl log_base (new_base : f64) (a : f64) : f64 =\n    if rust.rust.is_native ()\n    then $'(!a).log(!new_base)'\n    else $'System.Math.Log (!a, !new_base)'","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  inl log_base (new_base : f64) (a : f64) : f64 =
      if rust.rust.is_native ()
      then $'(!a).log(!new_base)'
      else $'System.Math.Log (!a, !new_base)'
  """,
  timeout: 300_000
)
```

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"///- --test\n\n100 |> log_base 10\n|> _assert_eq 2","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  ///- --test

  100 |> log_base 10
  |> _assert_eq 2
  """,
  timeout: 300_000
)
```
