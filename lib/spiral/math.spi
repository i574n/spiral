:# math static =
    :< testing

/// ## math
:= e () =
    exp 1f64

/// ## square
:= square x =
    x ** 2

///> zig
:# square =
    5f64
    |> sqrt
    |> square
    |> _assert_approx_eq None 5

///> zig
:# square_2 =
    e () |> square
    |> _assert_approx_eq None 7.3890560989306495

///> zig
:# square_3 =
    2 * 2 / 0.4f64 |> sqrt
    |> _assert_approx_eq None 3.1622776601683795

///> zig
:# square_4 =
    2f64 / 3
    |> _assert_approx_eq None 0.6666666666666666

///> zig
:# square_5 =
    2f64 |> log
    |> _assert_approx_eq None 0.6931471805599453

///> zig
:# square_6 =
    pi
    |> _assert_approx_eq None 3.141592653589793f64

///> zig
:# square_7 =
    pi |> cos
    |> _assert_eq -1f64

///> zig
:# square_8 =
    pi
    |> cos
    |> \ n => n / 2f64
    |> _assert_approx_eq None -0.5

///> zig
:# square_9 =
    pi / 2 |> cos
    |> _assert_approx_eq None 0.00000000000000006123233995736766f64

:= gleam_atan2 (y : f64) (x : f64) : f64 =
    global """
        @external(erlang, "math", "atan2")
        fn spiral_math_atan2(y: Float, x: Float) -> Float
        """
    $'spiral_math_atan2(!y, !x)' : float

:= python_atan2 (y : f64) (x : f64) : f64 =
    global "import math"
    $'math.atan2(!y, !x)' : float

:= c_atan2 (y : f64) (x : f64) : f64 =
    global "#include <tgmath.h>"
    $'atan2(!y, !x)' : float

:= cpp_atan2 (y : f64) (x : f64) : f64 =
    global "#include <cmath>"
    $'std::atan2(!y, !x)' : float

/// ## fsharp
:= atan2 (y : f64) (x : f64) : f64 =
    backend_switch {
        Gleam = \ () => (gleam_atan2 y x : f64)
        Lua = \ () => $'math.atan2(!y, !x)' : float
        Fsharp = \ () => $'System.Math.Atan2 (!y, !x)' : float
        Python = \ () => (python_atan2 y x : f64)
        Rust = \ () => $'(!y).atan2(!x)' : float
        Zig = \ () => $'std.math.atan2(!y, !x)' : float
        Lean = \ () => $'Float.atan2 !y !x ' : float
        C = \ () => (c_atan2 y x : f64)
        Cpp = \ () => (cpp_atan2 y x : f64)
        Pascal = \ () => $'ArcTan2(!y, !x)' : float
        Wasm = \ () => $'(call $math_atan2 !y !x)' : float
        TypeScript = \ () => $'Math.atan2(!y, !x)' : float
        Kotlin = \ () => $'kotlin.math.atan2(!y, !x)' : float
        Swift = \ () => $'atan2(!y, !x)' : float
    }

///> rust
///> gleam
///> lua
///> cuda
:# atan2 =
    0 |> atan2 1
    |> _assert_eq 1.5707963267948966

:= gleam_floor \* t {float}. (n : t) : t =
    global "import gleam/float"
    n |> $'float.floor' : t

:= python_floor \* t {float}. (n : t) : t =
    global "import math"
    $'math.floor(!n)' : t

:= c_floor \* t {float}. (n : t) : t =
    global "#include <tgmath.h>"
    $'floor(!n)' : t

:= cpp_floor \* t {float}. (n : t) : t =
    global "#include <cmath>"
    $'std::floor(!n)' : t

/// ## floor
:= floor \* t {float}. (n : t) : t =
    backend_switch {
        Gleam = \ () => (gleam_floor n : t)
        Lua = \ () => n |> $'math.floor' : t
        Fsharp = \ () => n |> $'floor' : t
        Python = \ () => (python_floor n : t)
        Rust = \ () => $'(!n).floor()' : t
        Zig = \ () => $'@@floor(!n)' : t
        Lean = \ () => $'(!n).floor' : t
        C = \ () => (c_floor n : t)
        Cpp = \ () => (cpp_floor n : t)
        Pascal = \ () => $'Int(!n) - Ord(Frac(!n) < 0)' : t
        Wasm = \ () => $'(`t.floor !n)' : t
        TypeScript = \ () => $'Math.floor(!n)' : t
        Kotlin = \ () => $'kotlin.math.floor(!n)' : t
        Swift = \ () => $'(!n).rounded(.down)' : t
    }

///> rust
///> gleam
///> lua
///> cuda
:# floor =
    0.6 |> floor
    |> _assert_eq 0f64

:= gleam_ceil \* t {float}. (n : t) : t =
    global "import gleam/float"
    n |> $'float.ceiling' : t

:= python_ceil \* t {float}. (n : t) : t =
    global "import math"
    n |> $'math.ceil' : t

:= c_ceil \* t {float}. (n : t) : t =
    global "#include <tgmath.h>"
    $'ceil(!n)' : t

:= cpp_ceil \* t {float}. (n : t) : t =
    global "#include <cmath>"
    $'std::ceil(!n)' : t

/// ## ceil
:= ceil \* t {float}. (n : t) : t =
    backend_switch {
        Gleam = \ () => (gleam_ceil n : t)
        Lua = \ () => n |> $'math.ceil' : t
        Fsharp = \ () => n |> $'ceil' : t
        Python = \ () => (python_ceil n : t)
        Rust = \ () => $'(!n).ceil()' : t
        Zig = \ () => $'@@ceil(!n)' : t
        Lean = \ () => $'(!n).ceil' : t
        C = \ () => (c_ceil n : t)
        Cpp = \ () => (cpp_ceil n : t)
        Pascal = \ () => $'Int(!n) + Ord(Frac(!n) > 0)' : t
        Wasm = \ () => $'(`t.ceil !n)' : t
        TypeScript = \ () => $'Math.ceil(!n)' : t
        Kotlin = \ () => $'kotlin.math.ceil(!n)' : t
        Swift = \ () => $'(!n).rounded(.up)' : t
    }

///> rust
///> gleam
///> lua
///> cuda
:# ceil =
    0.6 |> ceil
    |> _assert_eq 1f64

/// ## round
:= round \* t {number; float}. (x : t) : t =
    := round_half_to_even () =
        := lower = floor x
        := difference = x - lower
        ? difference > 0.5
        ?> lower + 1
        |? difference < 0.5
        ?> lower
        |? floor (lower / 2) * 2 = lower
        ?> lower
        |: lower + 1
    backend_switch {
        Gleam = round_half_to_even
        Lua = round_half_to_even
        Fsharp = \ () => x |> $'round' : t
        Python = \ () => x |> $'round' : t
        Rust = \ () => $'(!x).round_ties_even()' : t
        Zig = round_half_to_even
        Lean = round_half_to_even
        C = round_half_to_even
        Cpp = round_half_to_even
        Pascal = round_half_to_even
        TypeScript = round_half_to_even
        Wasm = \ () => $'(`t.nearest !x)' : t
        Kotlin = \ () => $'kotlin.math.round(!x)' : t
        Swift = \ () => $'(!x).rounded(.toNearestOrEven)' : t
    }

///> rust
///> gleam
///> lua
///> cuda
:# round =
    0.5 |> round
    |> _assert_eq 0f64

    0.6 |> round
    |> _assert_eq 1f64

    1.5 |> round
    |> _assert_eq 2f64

    2.5 |> round
    |> _assert_eq 2f64

    3.5 |> round
    |> _assert_eq 4f64

/// ## log_base
:= log_base (new_base : f64) (a : f64) : f64 =
    backend_switch {
        Gleam = \ () => log a / log new_base
        Lua = \ () => log a / log new_base
        Fsharp = \ () => $'System.Math.Log (!a, !new_base)' : f64
        Python = \ () => log a / log new_base
        Rust = \ () => $'(!a).log(!new_base)' : f64
        TypeScript = \ () => log a / log new_base
        Zig = \ () => log a / log new_base
        Lean = \ () => log a / log new_base
        Kotlin = \ () => log a / log new_base
        Swift = \ () => log a / log new_base
    }

///> zig
:# log_base =
    100 |> log_base 10
    |> _assert_eq 2

:= is_negative (x : f64) : bool = x < 0f64 || (x = 0f64 && 1f64 / x < 0f64)

:= copysign (magnitude : f64) (sign : f64) : f64 =
    := m = ? is_negative magnitude ?> -magnitude |: magnitude
    ? is_negative sign ?> -m |: m

:= round_half_even (x : f64) : f64 =
    := r = floor x
    := d = x - r
    ? d > 0.5f64 ?> r + 1f64 |: (? d < 0.5f64 ?> r |: (? floor (r / 2f64) * 2f64 = r ?> r |: r + 1f64))

:= remainder_nearest (x : f64) (y : f64) : f64 = x - y * round_half_even (x / y)

:= hypot (x : f64) (y : f64) : f64 =
    := ax = abs x
    := ay = abs y
    := big = max ax ay
    := small = min ax ay
    ? big = 0f64 ?> 0f64 |: big * sqrt (1f64 + (small / big) * (small / big))

:= cbrt (x : f64) : f64 = ? x < 0f64 ?> -((-x) ** (1f64 / 3f64)) |: x ** (1f64 / 3f64)

:= two_sum (u : f64) (v : f64) : f64 * f64 =
    := s = u + v
    := up = s - v
    := vpp = s - up
    s, -((up - u) + (vpp - v))

:= sine_series (sinx : f64) (cosx : f64) (highest_first : list f64) : f64 =
    := ar = 2f64 * (cosx - sinx) * (cosx + sinx)
    := b1, _ = listm::fold (\ (y0, y1) c => (ar * y0 - y1 + c, y0)) (0f64, 0f64) highest_first
    2f64 * sinx * cosx * b1

///> rust
///> zig
:# copysign_keeps_the_sign_of_zero =
    (copysign 3f64 -0f64, copysign -2f64 1f64, copysign 0f64 -1f64 < 0f64 || 1f64 / copysign 0f64 -1f64 < 0f64)
    |> _assert_eq (-3f64, 2f64, !+)

///> rust
///> zig
:# round_half_even_breaks_ties_to_even =
    (round_half_even 2.5f64, round_half_even 3.5f64, round_half_even -2.5f64, round_half_even 0.49999999999999994f64)
    |> _assert_eq (2f64, 4f64, -2f64, 0f64)

///> rust
///> zig
:# remainder_nearest_is_the_ieee_remainder =
    (remainder_nearest 190f64 360f64, remainder_nearest 540f64 360f64, remainder_nearest -190f64 360f64)
    |> _assert_eq (-170f64, -180f64, 170f64)

///> rust
:# hypot_neither_overflows_nor_underflows =
    hypot 3f64 4f64 |> _assert_eq 5f64
    hypot (10f64 ** 200f64) (10f64 ** 200f64) / (10f64 ** 200f64) |> _assert_approx_eq None 1.4142135623730951f64
    hypot (10f64 ** -200f64) 0f64 / (10f64 ** -200f64) |> _assert_approx_eq None 1f64

///> rust
:# cbrt_takes_negative_numbers =
    cbrt -27f64 |> _assert_approx_eq None -3f64
    cbrt 8f64 |> _assert_approx_eq None 2f64

///> rust
///> zig
:# floor_and_ceil_of_a_negative_constant_round_away_from_truncation =
    (floor -0.5f64, ceil -1.5f64, floor (-190f64 / 360f64)) |> _assert_eq (-1f64, -1f64, -1f64)

///> rust
///> zig
:# two_sum_returns_the_rounding_error =
    two_sum 1f64 (2f64 ** -60f64) |> _assert_eq (1f64, 2f64 ** -60f64)

///> rust
:# sine_series_sums_by_clenshaw =
    := x = pi / 8f64
    sine_series (sin x) (cos x) [ 0.25f64; 2f64 ]
    |> _assert_approx_eq None (2f64 * sin (2f64 * x) + 0.25f64 * sin (4f64 * x))
