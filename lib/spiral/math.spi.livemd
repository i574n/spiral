## fsharp

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":":= atan2 (y : f64) (x : f64) : f64 =\n    backend_switch {\n        Gleam = \\ () =>\n            global \"\"\"\n                @external(erlang, \"math\", \"atan2\")\n                fn spiral_math_atan2(y: Float, x: Float) -> Float\n                \"\"\"\n            $'spiral_math_atan2(!y, !x)' : float\n        Lua = \\ () => $'math.atan2(!y, !x)' : float\n        Fsharp = \\ () => $'System.Math.Atan2 (!y, !x)' : float\n        Python = \\ () =>\n            global \"import math\"\n            $'math.atan2(!y, !x)' : float\n        Rust = \\ () => $'(!y).atan2(!x)' : float\n        Zig = \\ () => $'std.math.atan2(!y, !x)' : float\n        Lean = \\ () => $'Float.atan2 !y !x ' : float\n        C = \\ () =>\n            global \"#include <tgmath.h>\"\n            $'atan2(!y, !x)' : float\n        Cpp = \\ () =>\n            global \"#include <cmath>\"\n            $'std::atan2(!y, !x)' : float\n        Pascal = \\ () => $'ArcTan2(!y, !x)' : float\n        Wasm = \\ () => $'(call $math_atan2 !y !x)' : float\n        TypeScript = \\ () => $'Math.atan2(!y, !x)' : float\n        Kotlin = \\ () => $'kotlin.math.atan2(!y, !x)' : float\n        Swift = \\ () => $'atan2(!y, !x)' : float\n    }","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ":= atan2 (y : f64) (x : f64) : f64 =\n    backend_switch {\n        Gleam = \\ () =>\n            global \"\"\"\n                @external(erlang, \"math\", \"atan2\")\n                fn spiral_math_atan2(y: Float, x: Float) -> Float\n                \"\"\"\n            $'spiral_math_atan2(!y, !x)' : float\n        Lua = \\ () => $'math.atan2(!y, !x)' : float\n        Fsharp = \\ () => $'System.Math.Atan2 (!y, !x)' : float\n        Python = \\ () =>\n            global \"import math\"\n            $'math.atan2(!y, !x)' : float\n        Rust = \\ () => $'(!y).atan2(!x)' : float\n        Zig = \\ () => $'std.math.atan2(!y, !x)' : float\n        Lean = \\ () => $'Float.atan2 !y !x ' : float\n        C = \\ () =>\n            global \"#include <tgmath.h>\"\n            $'atan2(!y, !x)' : float\n        Cpp = \\ () =>\n            global \"#include <cmath>\"\n            $'std::atan2(!y, !x)' : float\n        Pascal = \\ () => $'ArcTan2(!y, !x)' : float\n        Wasm = \\ () => $'(call $math_atan2 !y !x)' : float\n        TypeScript = \\ () => $'Math.atan2(!y, !x)' : float\n        Kotlin = \\ () => $'kotlin.math.atan2(!y, !x)' : float\n        Swift = \\ () => $'atan2(!y, !x)' : float\n    }",
  timeout: 300_000
)
```

