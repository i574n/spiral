## floor

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":":= floor \\* t {float}. (n : t) : t =\n    backend_switch {\n        Gleam = \\ () =>\n            global \"import gleam/float\"\n            n |> $'float.floor' : t\n        Lua = \\ () => n |> $'math.floor' : t\n        Fsharp = \\ () => n |> $'floor' : t\n        Python = \\ () =>\n            global \"import math\"\n            $'math.floor(!n)' : t\n        Rust = \\ () => $'!n.floor()' : t\n        Zig = \\ () => $'@@floor(!n)' : t\n        Lean = \\ () => $'(!n).floor' : t\n        C = \\ () =>\n            global \"#include <tgmath.h>\"\n            $'floor(!n)' : t\n        Cpp = \\ () =>\n            global \"#include <cmath>\"\n            $'std::floor(!n)' : t\n        Pascal = \\ () => $'Int(!n) - Ord(Frac(!n) < 0)' : t\n        Wasm = \\ () => $'(`t.floor !n)' : t\n        TypeScript = \\ () => $'Math.floor(!n)' : t\n        Kotlin = \\ () => $'kotlin.math.floor(!n)' : t\n        Swift = \\ () => $'(!n).rounded(.down)' : t\n    }","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  := floor \* t {float}. (n : t) : t =
      backend_switch {
          Gleam = \ () =>
              global "import gleam/float"
              n |> $'float.floor' : t
          Lua = \ () => n |> $'math.floor' : t
          Fsharp = \ () => n |> $'floor' : t
          Python = \ () =>
              global "import math"
              $'math.floor(!n)' : t
          Rust = \ () => $'!n.floor()' : t
          Zig = \ () => $'@@floor(!n)' : t
          Lean = \ () => $'(!n).floor' : t
          C = \ () =>
              global "#include <tgmath.h>"
              $'floor(!n)' : t
          Cpp = \ () =>
              global "#include <cmath>"
              $'std::floor(!n)' : t
          Pascal = \ () => $'Int(!n) - Ord(Frac(!n) < 0)' : t
          Wasm = \ () => $'(`t.floor !n)' : t
          TypeScript = \ () => $'Math.floor(!n)' : t
          Kotlin = \ () => $'kotlin.math.floor(!n)' : t
          Swift = \ () => $'(!n).rounded(.down)' : t
      }
  """,
  timeout: 300_000
)
```

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":"///- --test --symbol\n///> rust\n///> gleam\n///> lua\n///> cuda\n\n0.6 |> floor\n|> _assert_eq 0f64","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  ///- --test --symbol
  ///> rust
  ///> gleam
  ///> lua
  ///> cuda

  0.6 |> floor
  |> _assert_eq 0f64
  """,
  timeout: 300_000
)
```

## ceil

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":":= ceil \\* t {float}. (n : t) : t =\n    backend_switch {\n        Gleam = \\ () =>\n            global \"import gleam/float\"\n            n |> $'float.ceiling' : t\n        Lua = \\ () => n |> $'math.ceil' : t\n        Fsharp = \\ () => n |> $'ceil' : t\n        Python = \\ () =>\n            global \"import math\"\n            n |> $'math.ceil' : t\n        Rust = \\ () => $'!n.ceil()' : t\n        Zig = \\ () => $'@@ceil(!n)' : t\n        Lean = \\ () => $'(!n).ceil' : t\n        C = \\ () =>\n            global \"#include <tgmath.h>\"\n            $'ceil(!n)' : t\n        Cpp = \\ () =>\n            global \"#include <cmath>\"\n            $'std::ceil(!n)' : t\n        Pascal = \\ () => $'Int(!n) + Ord(Frac(!n) > 0)' : t\n        Wasm = \\ () => $'(`t.ceil !n)' : t\n        TypeScript = \\ () => $'Math.ceil(!n)' : t\n        Kotlin = \\ () => $'kotlin.math.ceil(!n)' : t\n        Swift = \\ () => $'(!n).rounded(.up)' : t\n    }","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  := ceil \* t {float}. (n : t) : t =
      backend_switch {
          Gleam = \ () =>
              global "import gleam/float"
              n |> $'float.ceiling' : t
          Lua = \ () => n |> $'math.ceil' : t
          Fsharp = \ () => n |> $'ceil' : t
          Python = \ () =>
              global "import math"
              n |> $'math.ceil' : t
          Rust = \ () => $'!n.ceil()' : t
          Zig = \ () => $'@@ceil(!n)' : t
          Lean = \ () => $'(!n).ceil' : t
          C = \ () =>
              global "#include <tgmath.h>"
              $'ceil(!n)' : t
          Cpp = \ () =>
              global "#include <cmath>"
              $'std::ceil(!n)' : t
          Pascal = \ () => $'Int(!n) + Ord(Frac(!n) > 0)' : t
          Wasm = \ () => $'(`t.ceil !n)' : t
          TypeScript = \ () => $'Math.ceil(!n)' : t
          Kotlin = \ () => $'kotlin.math.ceil(!n)' : t
          Swift = \ () => $'(!n).rounded(.up)' : t
      }
  """,
  timeout: 300_000
)
```

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":"///- --test --symbol\n///> rust\n///> gleam\n///> lua\n///> cuda\n\n0.6 |> ceil\n|> _assert_eq 1f64","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  ///- --test --symbol
  ///> rust
  ///> gleam
  ///> lua
  ///> cuda

  0.6 |> ceil
  |> _assert_eq 1f64
  """,
  timeout: 300_000
)
```

## round

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":":= round \\* t {number; float}. (x : t) : t =\n    := round_half_to_even () =\n        := lower = floor x\n        := difference = x - lower\n        ? difference > 0.5 ?> lower + 1\n        |? difference < 0.5 ?> lower\n        |? floor (lower / 2) * 2 = lower ?> lower\n        |: lower + 1\n    backend_switch {\n        Gleam = round_half_to_even\n        Lua = round_half_to_even\n        Fsharp = \\ () => x |> $'round' : t\n        Python = \\ () => x |> $'round' : t\n        Rust = \\ () => $'(!x).round_ties_even()' : t\n        Zig = round_half_to_even\n        Lean = round_half_to_even\n        C = round_half_to_even\n        Cpp = round_half_to_even\n        Pascal = round_half_to_even\n        TypeScript = round_half_to_even\n        Wasm = \\ () => $'(`t.nearest !x)' : t\n        Kotlin = \\ () => $'kotlin.math.round(!x)' : t\n        Swift = \\ () => $'(!x).rounded(.toNearestOrEven)' : t\n    }","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  := round \* t {number; float}. (x : t) : t =
      := round_half_to_even () =
          := lower = floor x
          := difference = x - lower
          ? difference > 0.5 ?> lower + 1
          |? difference < 0.5 ?> lower
          |? floor (lower / 2) * 2 = lower ?> lower
          |: lower + 1
      backend_switch {
          Gleam = round_half_to_even
          Lua = round_half_to_even
          Fsharp = \ () => x |> $'round' : t
          Python = \ () => x |> $'round' : t
          Rust = \ () => $'(!x).round_ties_even()' : t
          Zig = round_half_to_even
          Lean = round_half_to_even
          C = round_half_to_even
          Cpp = round_half_to_even
          Pascal = round_half_to_even
          TypeScript = round_half_to_even
          Wasm = \ () => $'(`t.nearest !x)' : t
          Kotlin = \ () => $'kotlin.math.round(!x)' : t
          Swift = \ () => $'(!x).rounded(.toNearestOrEven)' : t
      }
  """,
  timeout: 300_000
)
```

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":"///- --test --symbol\n///> rust\n///> gleam\n///> lua\n///> cuda\n\n0.5 |> round\n|> _assert_eq 0f64\n\n0.6 |> round\n|> _assert_eq 1f64\n\n1.5 |> round\n|> _assert_eq 2f64\n\n2.5 |> round\n|> _assert_eq 2f64\n\n3.5 |> round\n|> _assert_eq 4f64","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  ///- --test --symbol
  ///> rust
  ///> gleam
  ///> lua
  ///> cuda

  0.5 |> round
  |> _assert_eq 0f64

  0.6 |> round
  |> _assert_eq 1f64

  1.5 |> round
  |> _assert_eq 2f64

  2.5 |> round
  |> _assert_eq 2f64

  3.5 |> round
  |> _assert_eq 4f64
  """,
  timeout: 300_000
)
```

## log_base

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":":= log_base (new_base : f64) (a : f64) : f64 =\n    backend_switch {\n        Gleam = \\ () => log a / log new_base\n        Lua = \\ () => log a / log new_base\n        Fsharp = \\ () => $'System.Math.Log (!a, !new_base)' : f64\n        Python = \\ () => log a / log new_base\n        Rust = \\ () => $'(!a).log(!new_base)' : f64\n        TypeScript = \\ () => log a / log new_base\n        Zig = \\ () => log a / log new_base\n        Lean = \\ () => log a / log new_base\n        Kotlin = \\ () => log a / log new_base\n        Swift = \\ () => log a / log new_base\n    }","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  := log_base (new_base : f64) (a : f64) : f64 =
      backend_switch {
          Gleam = \ () => log a / log new_base
          Lua = \ () => log a / log new_base
          Fsharp = \ () => $'System.Math.Log (!a, !new_base)' : f64
          Python = \ () => log a / log new_base
          Rust = \ () => $'(!a).log(!new_base)' : f64
          TypeScript = \ () => log a / log new_base
          Zig = \ () => log a / log new_base
          Lean = \ () => log a / log new_base
          Kotlin = \ () => log a / log new_base
          Swift = \ () => log a / log new_base
      }
  """,
  timeout: 300_000
)
```

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":"///- --test --symbol\n\n100 |> log_base 10\n|> _assert_eq 2","print_code":false},"livebook_object":"smart_cell"} -->

