:< testing
:< sm'_operators

:! ms = ()
:! bytes = ()
:! count = ()

:! quantity u = f64

:| backend_name =
    | BackendC
    | BackendRust
    | BackendZig
    | BackendGleam
    | BackendFsharp
    | BackendLua
    | BackendWasm
    | BackendPascal
    | BackendPython
    | BackendCpp
    | BackendOpenQasm

:| suite =
    | Examples
    | Contracts
    | Frontier
    | Mega

:| ^ metric u =
    | CompileSeconds :: metric ms
    | NativeSeconds :: metric ms
    | RunSeconds :: metric ms
    | PeakBytes :: metric bytes
    | OracleAgree :: metric count

:= metric_name \* u. (m : metric u) : string =
    ?= m ?|
    | CompileSeconds => "spiral_backend_compile_seconds"
    | NativeSeconds => "spiral_backend_native_seconds"
    | RunSeconds => "spiral_backend_run_seconds"
    | PeakBytes => "spiral_backend_peak_bytes"
    | OracleAgree => "spiral_backend_oracle_agree"

:= backend_label (b : backend_name) : string =
    ?= b ?|
    | BackendC => "c"
    | BackendRust => "rust"
    | BackendZig => "zig"
    | BackendGleam => "gleam"
    | BackendFsharp => "fsharp"
    | BackendLua => "lua"
    | BackendWasm => "wasm"
    | BackendPascal => "pascal"
    | BackendPython => "python"
    | BackendCpp => "cpp"
    | BackendOpenQasm => "openqasm"

:= suite_label (s : suite) : string = sm'::to_lower (reflection::case_name s)

:! sample u = { metric : metric u; backend : backend_name; suite : suite; id : string; value : quantity u }

:= exposition \* u. (s : sample u) : string =
    metric_name s::metric
    ++# "{backend=\"" ++# backend_label s::backend
    ++# "\",suite=\"" ++# suite_label s::suite
    ++# "\",id=\"" ++# s::id
    ++# "\"} " ++# sm'::obj_to_string s::value

///> rust
///> gleam
:# exposition_renders_one_prometheus_line =
    {
        metric = CompileSeconds
        backend = BackendRust
        suite = Examples
        id = "samples/hello"
        value = 1.5f64 |> quantity
    }
    |> sample
    |> exposition
    |> _assert_eq "spiral_backend_compile_seconds{backend=\"rust\",suite=\"examples\",id=\"samples/hello\"} 1.5"

:= backend_of (name : string) : option backend_name =
    ?= name ?|
    | "C" => Some BackendC
    | "Rust" => Some BackendRust
    | "Zig" => Some BackendZig
    | "Gleam" => Some BackendGleam
    | "Fsharp" => Some BackendFsharp
    | "Lua" => Some BackendLua
    | "Wasm" => Some BackendWasm
    | "Delphi" => Some BackendPascal
    | "Pascal" => Some BackendPascal
    | "Python" => Some BackendPython
    | "Cpp" => Some BackendCpp
    | "OpenQasm" => Some BackendOpenQasm
    | _ => None

:= suite_of (name : string) : option suite = reflection::union_cases_find (\ (s : suite) => suite_label s = name)

:= fields_of (line : string) : array string = sm'::split "\t" line |> array

:= millis_at (fields : array string) (i : i32) : f64 =
    (am'::index i fields |> convert::convert_i32 |> convert::f64) / 1000f64

:= sample_at \* u. (m : metric u) (fields : array string) (value : () -> f64) : option (sample u) =
    ?= backend_of (am'::index 1i32 fields), suite_of (am'::index 2i32 fields) ?|
    | Some backend, Some suite =>
        Some ({ metric = m; backend; suite; id = am'::index 0i32 fields; value = value () |> quantity } |> sample)
    | _ => None

:= compile_sample (line : string) : option (sample ms) =
    := fields = fields_of line
    ? am'::length fields < 5i32 ?> None |: sample_at CompileSeconds fields (\ () => millis_at fields 4i32)

:= rendered (s : option (sample ms)) : string =
    ?= s ?|
    | Some s => exposition s
    | None => "none"

///> rust
///> gleam
:# compile_sample_reads_a_results_row =
    "samples/abi_external\tC\texamples\tok\t794\t9a0e2f8c9c596b8c"
    |> compile_sample
    |> rendered
    |> _assert_eq "spiral_backend_compile_seconds{backend=\"c\",suite=\"examples\",id=\"samples/abi_external\"} 0.794"

///> rust
///> gleam
:# compile_sample_skips_unknown_backends =
    "samples/abi_external\tNotABackend\texamples\tok\t794"
    |> compile_sample
    |> rendered
    |> _assert_eq "none"

:= results_rows (text : string) : array string =
    sm'::lines text

:= results_exposition (text : string) : array string =
    results_rows text
    |> am'::choose compile_sample
    |> am'::map' exposition

///> rust
///> gleam
:# results_exposition_keeps_known_rows =
    "id\tbackend\tsuite\tcompile\tcompile_ms\nsamples/a\tC\texamples\tok\t10\nsamples/b\tZig\tcontracts\terror\t2000\nsamples/c\tNope\texamples\tok\t5"
    |> results_exposition
    |> am'::length
    |> _assert_eq 2i32

:= native_sample (line : string) : option (sample ms) =
    := fields = fields_of line
    ? am'::length fields < 8i32
    ?> None
    |? am'::index 6i32 fields <> "ran"
    ?> None
    |: sample_at NativeSeconds fields (\ () => millis_at fields 7i32)

:= verdict_value (verdict : string) : option f64 =
    ? verdict = "agree"
    ?> Some 1f64
    |? verdict = "DISAGREE"
    ?> Some 0f64
    |: None

:= oracle_sample (line : string) : option (sample count) =
    := fields = fields_of line
    ? am'::length fields < 11i32
    ?> None
    |:
        ?= verdict_value (am'::index 10i32 fields) ?|
        | Some v => sample_at OracleAgree fields (\ () => v)
        | None => None

:= results_oracle_samples (text : string) : array (sample count) =
    results_rows text
    |> am'::choose oracle_sample

///> rust
///> gleam
:# native_sample_reads_ran_rows =
    "samples/a\tC\texamples\tok\t10\tdeadbeef\tran\t250\t0\te3\tagree"
    |> native_sample
    |> rendered
    |> _assert_eq "spiral_backend_native_seconds{backend=\"c\",suite=\"examples\",id=\"samples/a\"} 0.25"

:= results_file_exposition (path : string) : array string =
    file_system::read_all_text path |> results_exposition

///> rust
///> gleam
:# results_file_exposition_reads_a_results_file =
    := path = file_system::get_temp_path () ++# "/spiral-metrics-results.tsv"
    file_system::write_all_text path "id\tbackend\tsuite\tcompile\tcompile_ms\nsamples/a\tC\texamples\tok\t10"
    path
    |> results_file_exposition
    |> am'::length
    |> _assert_eq 1i32

///> rust
///> gleam
:# oracle_samples_skip_rows_without_a_verdict =
    "id\tbackend\tsuite\tcompile\tcompile_ms\tresidual\tnative\tnative_ms\texit\tstdout\toracle\nsamples/a\tC\texamples\tok\t10\th\tran\t5\t0\ts\tagree\nsamples/b\tRust\texamples\tok\t10\th\tran\t5\t1\ts\tDISAGREE\nsamples/c\tZig\texamples\tok\t10\th\tran\t5\t0\ts\tno-zig"
    |> results_oracle_samples
    |> am'::length
    |> _assert_eq 2i32

:= backends () : array backend_name =
    ;[BackendC; BackendRust; BackendZig; BackendGleam; BackendFsharp; BackendLua
      BackendWasm; BackendPascal; BackendPython; BackendCpp; BackendOpenQasm]

:= sample_value \* u. (s : sample u) : f64 =
    s::value |> \ (quantity v) => v

:= backend_value \* u. (b : backend_name) (s : sample u) : option f64 =
    ? backend_label s::backend = backend_label b
    ?> Some (sample_value s)
    |: None

:= backend_total \* u. (b : backend_name) (samples : array (sample u)) : f64 =
    := values : array f64 = samples |> am'::choose (\ (s : sample u) => backend_value b s)
    values |> arraym::fold (+) 0f64

:= heavier \* u. (samples : array (sample u)) (best : option backend_name) (b : backend_name) : option backend_name =
    ?= best ?|
    | Some c => ? backend_total c samples >= backend_total b samples ?> best |: Some b
    | None => ? backend_total b samples > 0f64 ?> Some b |: None

:= heaviest \* u. (candidates : array backend_name) (samples : array (sample u)) : option backend_name =
    candidates |> arraym::fold (heavier samples) None

:= total_line \* u. (m : metric u) (samples : array (sample u)) (b : backend_name) : string =
    metric_name m
    ++# "_total{backend=\"" ++# backend_label b
    ++# "\"} " ++# sm'::obj_to_string (backend_total b samples)

:= compile_total_line (samples : array (sample ms)) (b : backend_name) : option string =
    ? backend_total b samples > 0f64
    ?> Some (total_line CompileSeconds samples b)
    |: None

:= results_totals (text : string) : array string =
    := samples = results_rows text |> am'::choose compile_sample
    backends ()
    |> am'::choose (\ (b : backend_name) => compile_total_line samples b)

:= results_heaviest (text : string) : option backend_name =
    results_rows text
    |> am'::choose compile_sample
    |> heaviest (backends ())

:= heaviest_label (b : option backend_name) : string =
    ?= b ?|
    | Some b => backend_label b
    | None => "none"

:= value_for \* u. (b : backend_name) (id : string) (samples : array (sample u)) : option f64 =
    := hits : array f64 =
        samples
        |> am'::choose \ (s : sample u) =>
            ? backend_label s::backend = backend_label b && s::id = id
            ?> Some (sample_value s)
            |: None
    ? am'::length hits = 0i32 ?> None |: Some (am'::index 0i32 hits)

:= beats \* u. (b : backend_name) (samples : array (sample u)) (s : sample u) : option bool =
    ?= value_for b s::id samples ?|
    | Some other => Some (sample_value s < other)
    | None => None

:= wins_of (pairs : array bool) : array bool = pairs |> am'::choose (\ (w : bool) => ? w ?> Some w |: None)

:= head_to_head \* u. (a : backend_name) (b : backend_name) (samples : array (sample u)) : i32 * i32 =
    := pairs : array bool =
        samples
        |> am'::choose \ (s : sample u) => ? backend_label s::backend = backend_label a ?> beats b samples s |: None
    am'::length (wins_of pairs), am'::length pairs

:= results_head_to_head (a : backend_name) (b : backend_name) (text : string) : i32 * i32 =
    results_rows text
    |> am'::choose compile_sample
    |> head_to_head a b

:= results_native_head_to_head (a : backend_name) (b : backend_name) (text : string) : i32 * i32 =
    results_rows text
    |> am'::choose native_sample
    |> head_to_head a b

:= run_sample (line : string) : option (sample ms) =
    := fields = fields_of line
    ? am'::length fields < 14i32
    ?> None
    |? am'::index 6i32 fields <> "ran"
    ?> None
    |? am'::index 13i32 fields = ""
    ?> None
    |: sample_at RunSeconds fields (\ () => millis_at fields 13i32)

:= results_run_head_to_head (a : backend_name) (b : backend_name) (text : string) : i32 * i32 =
    results_rows text
    |> am'::choose run_sample
    |> head_to_head a b

///> rust
///> gleam
:# run_head_to_head_reads_the_run_column =
    := wins, shared =
        "id\tbackend\tsuite\tcompile\tcompile_ms\tresidual\tnative\tnative_ms\texit\tstdout\toracle\tbaseline\tdetail\trun_ms\nsamples/a\tC\texamples\tok\t10\th\tran\t900\t0\ts\tagree\tparity\t\t40\nsamples/a\tZig\texamples\tok\t10\th\tran\t1500\t0\ts\tagree\tparity\t\t30\nsamples/b\tC\texamples\tok\t10\th\tran\t900\t0\ts\tagree\tparity\t\t20\nsamples/b\tZig\texamples\tok\t10\th\tran\t1500\t0\ts\tagree\tparity\t\t"
        |> results_run_head_to_head BackendZig BackendC
    wins |> _assert_eq 1i32
    shared |> _assert_eq 1i32

///> rust
///> gleam
:# native_head_to_head_counts_ran_rows_only =
    := wins, shared =
        "id\tbackend\tsuite\tcompile\tcompile_ms\tresidual\tnative\tnative_ms\nsamples/a\tC\texamples\tok\t10\th\tran\t300\nsamples/a\tZig\texamples\tok\t10\th\tran\t200\nsamples/b\tC\texamples\tok\t10\th\tran\t100\nsamples/b\tZig\texamples\tok\t10\th\tbuild-fail\t50"
        |> results_native_head_to_head BackendZig BackendC
    wins |> _assert_eq 1i32
    shared |> _assert_eq 1i32

///> rust
///> gleam
:# head_to_head_counts_shared_samples_only =
    := wins, shared =
        "id\tbackend\tsuite\tcompile\tcompile_ms\nsamples/a\tC\texamples\tok\t10\nsamples/a\tZig\texamples\tok\t20\nsamples/b\tC\texamples\tok\t30\nsamples/b\tZig\texamples\tok\t5\nsamples/c\tC\texamples\tok\t7"
        |> results_head_to_head BackendC BackendZig
    wins |> _assert_eq 1i32
    shared |> _assert_eq 2i32

///> rust
///> gleam
:# results_totals_sum_compile_seconds_per_backend =
    := totals =
        "id\tbackend\tsuite\tcompile\tcompile_ms\nsamples/a\tC\texamples\tok\t1500\nsamples/b\tC\tcontracts\tok\t750\nsamples/c\tZig\texamples\tok\t2000"
        |> results_totals
    am'::length totals |> _assert_eq 2i32
    am'::index 0i32 totals |> _assert_eq "spiral_backend_compile_seconds_total{backend=\"c\"} 2.25"

///> rust
///> gleam
:# results_heaviest_names_the_backend_that_drains_most =
    "id\tbackend\tsuite\tcompile\tcompile_ms\nsamples/a\tC\texamples\tok\t1500\nsamples/b\tC\tcontracts\tok\t750\nsamples/c\tZig\texamples\tok\t2000"
    |> results_heaviest
    |> heaviest_label
    |> _assert_eq "c"

///> rust
///> gleam
:# results_totals_cover_python_cpp_and_openqasm =
    "id\tbackend\tsuite\tcompile\tcompile_ms\nsamples/a\tPython\texamples\tok\t1500\nsamples/b\tCpp\texamples\tok\t250\nsamples/c\tOpenQasm\texamples\tok\t500"
    |> results_totals
    |> am'::length
    |> _assert_eq 3i32

///> rust
///> gleam
:# results_heaviest_is_none_without_rows =
    "id\tbackend\tsuite\tcompile\tcompile_ms"
    |> results_heaviest
    |> heaviest_label
    |> _assert_eq "none"
