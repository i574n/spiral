/// # near_wallet

/// ## near_wallet
:< lustre

/// ### model
:== model = int

/// ### init
:= init initial_count : model =
    ? initial_count < 0
    ?> 0
    |: initial_count

/// ### msg
:| msg =
    | Incr
    | Decr

/// ### update
:= update n (model, msg) =
    ?= msg ?|
    | Incr => model + n
    | Decr => model - n

/// ### view
:= view model =
    div [
        style [
            "display", "flex"
        ]
    ] [
        div [
            style [
                "display", "flex"
                "flex-direction", "column"
            ]
        ] [
            button [
                on_click Incr
            ] [
                text "+"
            ]
            p [
                style [
                    "text-align", "center"
                ]
            ] [
                model |> sm'.obj_to_string |> text
            ]
            button [
                on_click Decr
            ] [
                text "-"
            ]
        ]
    ]

/// ## tests
///> gleam -t javascript -d lustre=\">=4.6.0\" lustre_ui=\"1.0.0-rc.1\" gleam_json=\">=2.0.0\"
test tests =
    := model = init (dyn -3i32)
    := model = update 1i32 (model, Incr)
    := model = update 1i32 (model, Incr)
    := model = update 1i32 (model, Decr)
    model
    |> view
    |> to_html
    |> expect_html (
        "<div style=\"display:flex;\"><div style=\"display:flex;flex-direction:column;\"><button "
        ^^ "role=\"button\" tabindex=\"0\" class=\"lustre-ui-button\">+</button><p "
        ^^ "style=\"text-align:center;\">1</p><button role=\"button\" tabindex=\"0\" "
        ^^ "class=\"lustre-ui-button\">-</button></div></div>"
    )

///> gleam -t javascript -d lustre=\">=4.6.0\" lustre_ui=\"1.0.0-rc.1\" gleam_json=\">=2.0.0\"
test tests_2 =
    := model = init (dyn 5i32)
    := model = update 2i32 (model, Decr)
    model
    |> view
    |> to_html
    |> expect_html (
        "<div style=\"display:flex;\"><div style=\"display:flex;flex-direction:column;\"><button "
        ^^ "role=\"button\" tabindex=\"0\" class=\"lustre-ui-button\">+</button><p "
        ^^ "style=\"text-align:center;\">3</p><button role=\"button\" tabindex=\"0\" "
        ^^ "class=\"lustre-ui-button\">-</button></div></div>"
    )

/// ## main
///> _

:= main' (n : int) =
    simple init (update 1) view
    |> start "#app_"

:= main () =
    $'!main' (0)' : ()
