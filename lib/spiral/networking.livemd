### request_header

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"inl request_header (key : string) (value : string) (request : request_builder) : request_builder =\n    inl request = join request\n    inl key = key |> sm'.to_std_string\n    inl value = value |> sm'.to_std_string\n    !\\\\((key, value), $'\"reqwest_wasm::RequestBuilder::header(!request, $0, $1)\"')","print_code":false},"livebook_object":"smart_cell"} -->

