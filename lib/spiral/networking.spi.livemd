<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":":< rust_operators\n\n:! reqwest_response =\n    `(\n        rust::rust_type\n            `($'reqwest_Response')\n            `($'reqwest_wasm::Response')\n            \"type reqwest_Response = class end\"\n    )\n\n:! reqwest_error =\n    `(\n        rust::rust_type\n            `($'reqwest_Error')\n            `($'reqwest_wasm::Error')\n            \"type reqwest_Error = class end\"\n    )\n\n:== request_builder_switch =\n    {\n        Gleam : $'reqwest_RequestBuilder'\n        Lua : $'reqwest_RequestBuilder'\n        Fsharp : $'reqwest_RequestBuilder'\n        Python : $'reqwest_RequestBuilder'\n        TypeScript : $'reqwest_RequestBuilder'\n        Cpp : $'reqwest_RequestBuilder'\n        CppHost : $'reqwest_RequestBuilder'\n        Pascal : $'reqwest_RequestBuilder'\n        Cuda : $'reqwest_RequestBuilder'\n        C : $'reqwest_RequestBuilder'\n        Rust : $'reqwest_wasm::RequestBuilder'\n    }\n:! request_builder =\n    `(\n        rust::fsharp_global \"type reqwest_RequestBuilder = class end\"\n        $'' : $'backend_switch `(request_builder_switch)'\n    )\n\n:| request_type =\n    | Get\n    | Post\n\n:== request =\n    {\n        url : string\n        request_type : request_type\n        body : string\n        json : bool\n        auto_refresh : bool\n    }\n\n:= new_request_get (url : string) : request_builder =\n    := url = ~~ url\n    := url = url |> sm'::to_std_string\n    := url = ~~ url\n    !\\($'\"reqwest_wasm::Client::builder().build().map_err(|err| err.to_string())?.get(!url)\"')\n\n:= new_request_post (url : string) : request_builder =\n    := url = ~~ url\n    := url = url |> sm'::to_std_string\n    := url = ~~ url\n    !\\($'\"reqwest_wasm::Client::builder().build().map_err(|err| err.to_string())?.post(!url)\"')\n\n:= request_send (request : request_builder) : async::future_pin (resultm::result' reqwest_response reqwest_error) =\n    := request = ~~ request\n    !\\($'\"Box::pin(reqwest_wasm::RequestBuilder::send(!request))\"')\n\n:= request_body (body : string) (request : request_builder) : request_builder =\n    := body = body |> sm'::to_std_string\n    !\\\\(body, $'\"reqwest_wasm::RequestBuilder::body(!request, $0)\"')\n\n:= request_header (key : string) (value : string) (request : request_builder) : request_builder =\n    := request = ~~ request\n    := key = key |> sm'::to_std_string\n    := value = value |> sm'::to_std_string\n    !\\\\((key, value), $'\"reqwest_wasm::RequestBuilder::header(!request, $0, $1)\"')\n\n:= request_json \\* t. (obj : t) (request : request_builder) : request_builder =\n    !\\($'\"reqwest_wasm::RequestBuilder::json(!request, &!obj)\"')\n\n:= response_text (response : reqwest_response) : async::future_pin (resultm::result' sm'::std_string reqwest_error) =\n    !\\($'\"Box::pin(reqwest_wasm::Response::text(!response))\"')\n\n:! tcp_client =\n    `(\n        backend_switch `(()) `({}) {\n            Fsharp = (\\ () =>\n                global \"\"\"\n                    type System_Net_Sockets_TcpClient = System.Net.Sockets.TcpClient\n\n                    \"\"\"\n                        ) : () -> ()\n        }\n        $'' : $'System_Net_Sockets_TcpClient'\n    )\n\n:= new_tcp_client () : tcp_client =\n    run_target \\|\n        | Fsharp => \\ () => $'new `tcp_client ()'\n        | _ => \\ () => null ()\n\n:! ip_address = $'System.Net.IPAddress'\n\n:= ip_address_parse (s : string) : ip_address =\n    s |> $'`ip_address.Parse'\n\n:! tcp_listener = $'System.Net.Sockets.TcpListener'\n\n:= new_tcp_listener (ip_address : ip_address) (port : i32) : tcp_listener =\n    $'new `tcp_listener (!ip_address, !port)'\n\n:= listener_start (listener : tcp_listener) : () =\n    listener |> $'_.Start()'\n\n:= listener_stop (listener : tcp_listener) : () =\n    listener |> $'_.Stop()'\n\n:= client_connect_async\n    (host : string)\n    (port : i32)\n    (ct : threading::cancellation_token)\n    (client : tcp_client)\n    : async::value_task\n    =\n    run_target \\|\n        | Fsharp => \\ () => $'!client.ConnectAsync (!host, !port, !ct)'\n        | _ => \\ () => null ()\n\n:= main () =\n    init_trace_state None","print_code":false},"livebook_object":"smart_cell"} -->

