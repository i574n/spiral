### default_value'

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"inl default_value' forall t. (value : t) (x : option' t) : t =\n    backend_switch {\n        Gleam = fun () => $'!x |> option.unwrap(!value)' : t\n        Lua = fun () => $'(function() if !x ~= nil then return !x else return !value end end)()' : t\n        Fsharp = fun () => $'!x |> Option.defaultValue !value ' : t\n        Python = fun () => $'(!value if !x is None else !x)' : t\n        Rust = fun () => $'!x.unwrap_or(!value)' : t\n        TypeScript = fun () => $'(!x === undefined ? !value : !x)' : t\n    }","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  inl default_value' forall t. (value : t) (x : option' t) : t =
      backend_switch {
          Gleam = fun () => $'!x |> option.unwrap(!value)' : t
          Lua = fun () => $'(function() if !x ~= nil then return !x else return !value end end)()' : t
          Fsharp = fun () => $'!x |> Option.defaultValue !value ' : t
          Python = fun () => $'(!value if !x is None else !x)' : t
          Rust = fun () => $'!x.unwrap_or(!value)' : t
          TypeScript = fun () => $'(!x === undefined ? !value : !x)' : t
      }
  """,
  timeout: 300_000
)
```

### get'

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"inl get' forall t. (x : option' t) : t =\n    backend_switch {\n        Gleam = fun () =>\n            option'_types ()\n            $'!x |> option.unwrap (Nil)' : t\n        Lua = fun () => $'!x ' : t\n        Fsharp = fun () => $'!x |> Option.get' : t\n        Python = fun () => $'!x ' : t\n        Rust = fun () => $'!x.unwrap()' : t\n        TypeScript = fun () => $'!x ' : t\n    }","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  inl get' forall t. (x : option' t) : t =
      backend_switch {
          Gleam = fun () =>
              option'_types ()
              $'!x |> option.unwrap (Nil)' : t
          Lua = fun () => $'!x ' : t
          Fsharp = fun () => $'!x |> Option.get' : t
          Python = fun () => $'!x ' : t
          Rust = fun () => $'!x.unwrap()' : t
          TypeScript = fun () => $'!x ' : t
      }
  """,
  timeout: 300_000
)
```

### box

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"inl box forall t. (x : option t) : option' t =\n    // x\n    // |> optionm.map some'\n    // |> default_with none'\n    match x with\n    | Some x => some' x\n    | None => none' ()","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  inl box forall t. (x : option t) : option' t =
      // x
      // |> optionm.map some'
      // |> default_with none'
      match x with
      | Some x => some' x
      | None => none' ()
  """,
  timeout: 300_000
)
```

### map

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"inl map forall t u. (fn : t -> u) (x : option' t) : option' u =\n    backend_switch {\n        Gleam = fun () =>\n            option'_types ()\n            // inl fn = join fn\n            $'!x |> option.map(!fn)' : option' u\n        Lua = fun () =>\n            if x =. none' ()\n            then none' ()\n            else fn $'!x ' |> fun x => $'!x ' : option' u\n        Fsharp = fun () =>\n            inl fn = join fn\n            $'!x |> Option.map !fn ' : option' u\n        Python = fun () =>\n            if x =. none' ()\n            then none' ()\n            else fn $'!x ' |> fun x => $'!x ' : option' u\n        Rust = fun () =>\n            // a tuple payload is one Rust value: see rust.one_param_fn\n            inl fn = rust.one_param_fn fn\n            // `map` consumes the option: a join point's argument is the codegen's copy (`.clone()`, or a move for a\n            // type without Clone), so a value used again or captured by an `Fn` closure stays usable.\n            inl x = join x\n            $'!x.map(|x| !fn(x))' : option' u\n        TypeScript = fun () =>\n            if $'!x === undefined' : bool\n            then none' ()\n            else fn $'!x ' |> fun x => $'!x ' : option' u\n    }","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  inl map forall t u. (fn : t -> u) (x : option' t) : option' u =
      backend_switch {
          Gleam = fun () =>
              option'_types ()
              // inl fn = join fn
              $'!x |> option.map(!fn)' : option' u
          Lua = fun () =>
              if x =. none' ()
              then none' ()
              else fn $'!x ' |> fun x => $'!x ' : option' u
          Fsharp = fun () =>
              inl fn = join fn
              $'!x |> Option.map !fn ' : option' u
          Python = fun () =>
              if x =. none' ()
              then none' ()
              else fn $'!x ' |> fun x => $'!x ' : option' u
          Rust = fun () =>
              // a tuple payload is one Rust value: see rust.one_param_fn
              inl fn = rust.one_param_fn fn
              // `map` consumes the option: a join point's argument is the codegen's copy (`.clone()`, or a move for a
              // type without Clone), so a value used again or captured by an `Fn` closure stays usable.
              inl x = join x
              $'!x.map(|x| !fn(x))' : option' u
          TypeScript = fun () =>
              if $'!x === undefined' : bool
              then none' ()
              else fn $'!x ' |> fun x => $'!x ' : option' u
      }
  """,
  timeout: 300_000
)
```

