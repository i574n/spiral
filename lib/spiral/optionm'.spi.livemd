<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":":= flatten x =\n    ?= x ?|\n    | Some (Some x) => Some x\n    | _ => None\n\n:= option'_types () : () =\n    backend_switch {\n        Gleam = \\ () => global \"import gleam/option\"\n    }\n:! option'_gleam t =\n    `(\n        option'_types ()\n        $'' : $'option.Option(`t)'\n    )\n:== option'_switch t =\n    {\n        Gleam : option'_gleam t\n        Lua : t\n        Fsharp : $\"`t option\"\n        Python : t\n        Rust : $'Option<`t>'\n        TypeScript : t\n        Zig : $'?`(t)'\n        Lean : $'(Option `t)'\n    }\n:! option' t = $'backend_switch `(option'_switch t)'\n\n:= none' \\* t. () : option' t =\n    backend_switch {\n        Gleam = \\ () => $'option.None' : option' t\n        Lua = \\ () => $'nil' : option' t\n        Fsharp = \\ () => $'None' : option' t\n        Python = \\ () => $'None' : option' t\n        Rust = \\ () => $'None' : option' t\n        TypeScript = \\ () => $'undefined' : option' t\n        Zig = \\ () => $'null' : option' t\n        Lean = \\ () => $'none' : option' t\n    }\n\n:= some' \\* t. (x : t) : option' t =\n    backend_switch {\n        Gleam = \\ () => $'!x |> option.Some' : option' t\n        Lua = \\ () => $'!x ' : option' t\n        Fsharp = \\ () => $'Some !x ' : option' t\n        Python = \\ () => $'!x ## some\\' ' : option' t\n        Rust = \\ () => $'Some(!x.clone())' : option' t\n        TypeScript = \\ () => $'!x ' : option' t\n        Zig = \\ () => $'!x ' : option' t\n        Lean = \\ () => $'(some !x)' : option' t\n    }\n\n:= is_none' \\* t. (x : option' t) : bool =\n    backend_switch {\n        Lua = \\ () => $'!x == nil' : bool\n        Python = \\ () => $'!x is None' : bool\n        Rust = \\ () => $'!x.is_none()' : bool\n        TypeScript = \\ () => $'!x === undefined' : bool\n    }\n\n:= nullable_value' \\* t. (x : option' t) : t =\n    $'!x' : t\n\n:= default_value' \\* t. (value : t) (x : option' t) : t =\n    backend_switch {\n        Gleam = \\ () => $'!x |> option.unwrap(!value)' : t\n        Lua = \\ () => ? is_none' x ?> value |: nullable_value' x\n        Fsharp = \\ () => $'!x |> Option.defaultValue !value ' : t\n        Python = \\ () => ? is_none' x ?> value |: nullable_value' x\n        Rust = \\ () =>\n            := value = rust::clone value\n            $'!x.unwrap_or(!value)' : t\n        TypeScript = \\ () => ? is_none' x ?> value |: nullable_value' x\n        Zig = \\ () => $'(!x orelse !value)' : t\n        Lean = \\ () => $'((!x).getD !value)' : t\n    }\n\n:= get' \\* t. (x : option' t) : t =\n    backend_switch {\n        Gleam = \\ () =>\n            option'_types ()\n            $'!x |> option.unwrap (Nil)' : t\n        Lua = \\ () => $'!x ' : t\n        Fsharp = \\ () => $'!x |> Option.get' : t\n        Python = \\ () => $'!x ' : t\n        Rust = \\ () => $'!x.unwrap()' : t\n        TypeScript = \\ () => $'!x ' : t\n        Zig = \\ () => $'!x.?' : t\n        Lean = \\ () => $'(!x).get\\!' : t\n    }\n\n:= box \\* t. (x : option t) : option' t =\n    ?= x ?|\n    | Some x => some' x\n    | None => none' ()\n\n:= map \\* t u. (fn : t -> u) (x : option' t) : option' u =\n    backend_switch {\n        Gleam = \\ () =>\n            option'_types ()\n            $'!x |> option.map(!fn)' : option' u\n        Lua = \\ () =>\n            ? x =. none' ()\n            ?> none' ()\n            |: fn $'!x ' |> \\ x => $'!x ' : option' u\n        Fsharp = \\ () =>\n            := fn = ~~ fn\n            $'!x |> Option.map !fn ' : option' u\n        Python = \\ () =>\n            ? x =. none' ()\n            ?> none' ()\n            |: fn $'!x ' |> \\ x => $'!x ' : option' u\n        Rust = \\ () =>\n            := fn = rust::one_param_fn fn\n            := x = ~~ x\n            $'!x.map(|x| !fn(x))' : option' u\n        TypeScript = \\ () =>\n            ? $'!x === undefined' : bool\n            ?> none' ()\n            |: fn $'!x ' |> \\ x => $'!x ' : option' u\n        Zig = \\ () =>\n            ? $'(!x == null)' : bool\n            ?> none' ()\n            |: x |> get' |> fn |> some'\n        Lean = \\ () =>\n            ? $'(!x).isNone' : bool\n            ?> none' ()\n            |: x |> get' |> fn |> some'\n    }\n\n:= map'' \\* t u. (fn : t -> u) (x : option' t) : option' u =\n    x |> map fn\n\n:= unbox \\* t. (x : option' t) : option t =\n    x |> map'' Some |> default_value' None","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  := flatten x =
      ?= x ?|
      | Some (Some x) => Some x
      | _ => None

  := option'_types () : () =
      backend_switch {
          Gleam = \ () => global "import gleam/option"
      }
  :! option'_gleam t =
      `(
          option'_types ()
          $'' : $'option.Option(`t)'
      )
  :== option'_switch t =
      {
          Gleam : option'_gleam t
          Lua : t
          Fsharp : $"`t option"
          Python : t
          Rust : $'Option<`t>'
          TypeScript : t
          Zig : $'?`(t)'
          Lean : $'(Option `t)'
      }
  :! option' t = $'backend_switch `(option'_switch t)'

  := none' \* t. () : option' t =
      backend_switch {
          Gleam = \ () => $'option.None' : option' t
          Lua = \ () => $'nil' : option' t
          Fsharp = \ () => $'None' : option' t
          Python = \ () => $'None' : option' t
          Rust = \ () => $'None' : option' t
          TypeScript = \ () => $'undefined' : option' t
          Zig = \ () => $'null' : option' t
          Lean = \ () => $'none' : option' t
      }

  := some' \* t. (x : t) : option' t =
      backend_switch {
          Gleam = \ () => $'!x |> option.Some' : option' t
          Lua = \ () => $'!x ' : option' t
          Fsharp = \ () => $'Some !x ' : option' t
          Python = \ () => $'!x ## some\' ' : option' t
          Rust = \ () => $'Some(!x.clone())' : option' t
          TypeScript = \ () => $'!x ' : option' t
          Zig = \ () => $'!x ' : option' t
          Lean = \ () => $'(some !x)' : option' t
      }

  := is_none' \* t. (x : option' t) : bool =
      backend_switch {
          Lua = \ () => $'!x == nil' : bool
          Python = \ () => $'!x is None' : bool
          Rust = \ () => $'!x.is_none()' : bool
          TypeScript = \ () => $'!x === undefined' : bool
      }

  := nullable_value' \* t. (x : option' t) : t =
      $'!x' : t

  := default_value' \* t. (value : t) (x : option' t) : t =
      backend_switch {
          Gleam = \ () => $'!x |> option.unwrap(!value)' : t
          Lua = \ () => ? is_none' x ?> value |: nullable_value' x
          Fsharp = \ () => $'!x |> Option.defaultValue !value ' : t
          Python = \ () => ? is_none' x ?> value |: nullable_value' x
          Rust = \ () =>
              := value = rust::clone value
              $'!x.unwrap_or(!value)' : t
          TypeScript = \ () => ? is_none' x ?> value |: nullable_value' x
          Zig = \ () => $'(!x orelse !value)' : t
          Lean = \ () => $'((!x).getD !value)' : t
      }

  := get' \* t. (x : option' t) : t =
      backend_switch {
          Gleam = \ () =>
              option'_types ()
              $'!x |> option.unwrap (Nil)' : t
          Lua = \ () => $'!x ' : t
          Fsharp = \ () => $'!x |> Option.get' : t
          Python = \ () => $'!x ' : t
          Rust = \ () => $'!x.unwrap()' : t
          TypeScript = \ () => $'!x ' : t
          Zig = \ () => $'!x.?' : t
          Lean = \ () => $'(!x).get\!' : t
      }

  := box \* t. (x : option t) : option' t =
      ?= x ?|
      | Some x => some' x
      | None => none' ()

  := map \* t u. (fn : t -> u) (x : option' t) : option' u =
      backend_switch {
          Gleam = \ () =>
              option'_types ()
              $'!x |> option.map(!fn)' : option' u
          Lua = \ () =>
              ? x =. none' ()
              ?> none' ()
              |: fn $'!x ' |> \ x => $'!x ' : option' u
          Fsharp = \ () =>
              := fn = ~~ fn
              $'!x |> Option.map !fn ' : option' u
          Python = \ () =>
              ? x =. none' ()
              ?> none' ()
              |: fn $'!x ' |> \ x => $'!x ' : option' u
          Rust = \ () =>
              := fn = rust::one_param_fn fn
              := x = ~~ x
              $'!x.map(|x| !fn(x))' : option' u
          TypeScript = \ () =>
              ? $'!x === undefined' : bool
              ?> none' ()
              |: fn $'!x ' |> \ x => $'!x ' : option' u
          Zig = \ () =>
              ? $'(!x == null)' : bool
              ?> none' ()
              |: x |> get' |> fn |> some'
          Lean = \ () =>
              ? $'(!x).isNone' : bool
              ?> none' ()
              |: x |> get' |> fn |> some'
      }

  := map'' \* t u. (fn : t -> u) (x : option' t) : option' u =
      x |> map fn

  := unbox \* t. (x : option' t) : option t =
      x |> map'' Some |> default_value' None
  """,
  timeout: 300_000
)
```

#### unbox (test)

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":"///- --test --symbol\n///> gleam\n///> cuda\n///> rust\n///> typescript\n\n:= x = Some 3i32\n:= y : option i32 = None\n:= x' = x |> box |> unbox\n:= y' = y |> box |> map id |> unbox\n(x', y') |> _assert_eq' (x, y)","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  ///- --test --symbol
  ///> gleam
  ///> cuda
  ///> rust
  ///> typescript

  := x = Some 3i32
  := y : option i32 = None
  := x' = x |> box |> unbox
  := y' = y |> box |> map id |> unbox
  (x', y') |> _assert_eq' (x, y)
  """,
  timeout: 300_000
)
```

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":":= of_obj \\* t. (x : t) : option' t =\n    backend_switch {\n        Gleam = \\ () =>\n            option'_types ()\n            $'!x |> option.Some' : option' t\n        Lua = \\ () =>\n            $'!x ' : option' t\n        Fsharp = \\ () => (x |> $'Option.ofObj') : option' t\n        Python = \\ () =>\n            $'!x ' : option' t\n        Rust = \\ () => $'Some(!x.clone())' : option' t\n        TypeScript = \\ () => $'(!x ?? undefined)' : option' t\n        Zig = \\ () => $'!x ' : option' t\n    }","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  := of_obj \* t. (x : t) : option' t =
      backend_switch {
          Gleam = \ () =>
              option'_types ()
              $'!x |> option.Some' : option' t
          Lua = \ () =>
              $'!x ' : option' t
          Fsharp = \ () => (x |> $'Option.ofObj') : option' t
          Python = \ () =>
              $'!x ' : option' t
          Rust = \ () => $'Some(!x.clone())' : option' t
          TypeScript = \ () => $'(!x ?? undefined)' : option' t
          Zig = \ () => $'!x ' : option' t
      }
  """,
  timeout: 300_000
)
```

