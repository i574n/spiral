/// # otp_actor
:< sm'_operators

test otp_actor static =
    :< testing

:= otp_actor_imports () =
    global "import gleam/erlang/process"
    global "import gleam/otp/actor"
    global "import gleam/result"

:! builder s m r = $'actor.Builder(`s, `m, `r)'
:! next s m = $'actor.Next(`s, `m)'
:! started d = $'actor.Started(`d)'
:! start_result d = $'Result(actor.Started(`d), actor.StartError)'

/// ### new
:= new \* s m. (state : s) : builder s m (erlang_process.subject m) =
    otp_actor_imports ()
    $'actor.new(!state)'

/// ### new_with_init
:= new_with_init \* s m. (timeout_ms : i32) (init : () -> s) : builder s m (erlang_process.subject m) =
    otp_actor_imports ()
    $'actor.new_with_initialiser(!timeout_ms, fn(subject) { Ok(actor.initialised(!init(Nil)) |> \
        actor.returning(subject)) })'

/// ### new_with_self
:= new_with_self \* s m.
    (timeout_ms : i32) (init : erlang_process.subject m -> s)
    : builder s m (erlang_process.subject m)
    =
    otp_actor_imports ()
    $'actor.new_with_initialiser(!timeout_ms, fn(subject) { Ok(actor.initialised(!init(subject)) |> \
        actor.returning(subject)) })'

/// ### on_message
:= on_message \* s m r. (handler : s -> m -> next s m) (spec : builder s m r) : builder s m r =
    otp_actor_imports ()
    $'actor.on_message(!spec, fn(state, message) { !handler(state)(message) })'

/// ### continue
:= continue \* s m. (state : s) : next s m =
    otp_actor_imports ()
    $'actor.continue(!state)'

/// ### stop
:= stop \* s m. () : next s m =
    otp_actor_imports ()
    $'actor.stop()'

/// ### stop_abnormal
:= stop_abnormal \* s m. (reason : string) : next s m =
    otp_actor_imports ()
    $'actor.stop_abnormal(!reason)'

/// ### start
:= start \* s m r. (spec : builder s m r) : start_result r =
    otp_actor_imports ()
    $'actor.start(!spec)'

/// ### started_data
:= started_data \* d. (outcome : start_result d) : option d =
    ? $'result.is_ok(!outcome)' : bool
    ?> Some ($'result.lazy_unwrap(!outcome, fn() { panic }).data' : d)
    |: None

/// ### call
:= call \* m reply.
    (to : erlang_process.subject m) (timeout_ms : i32) (request : erlang_process.subject reply -> m)
    : reply
    =
    otp_actor_imports ()
    $'actor.call(!to, !timeout_ms, !request)'

/// ### send
:= send \* m. (to : erlang_process.subject m) (message : m) : () =
    otp_actor_imports ()
    $'actor.send(!to, !message)'

:| counter_message =
    | Add : i32
    | Read : erlang_process.subject i32

///> gleam
test counter_actor_counts =
    := counter =
        new 0i32
        |> on_message \ total message =>
            ?= message ?|
            | Add n => continue (total + n)
            | Read reply =>
                erlang_process.send reply total
                continue total
        |> start
        |> started_data
    ?= counter ?|
    | Some inbox =>
        send inbox (Add 3i32)
        send inbox (Add 4i32)
        call inbox 10000i32 Read
        |> _assert_eq 7i32
    | None => failwith "counter actor did not start"

///> gleam
test array_state_is_built_inside_the_actor =
    := started =
        new_with_init 10000i32 (\ () => ;[ 4i32; 5; 6 ])
        |> on_message (\ (items : array i32) (reply_to : erlang_process.subject i32) =>
            erlang_process.send reply_to (length items : i32)
            continue items)
        |> start
        |> started_data
    ?= started ?|
    | Some subject => call subject 10000i32 (\ (reply_to : erlang_process.subject i32) => reply_to) |> _assert_eq 3i32
    | None => failwith "the actor did not start"

///> gleam
test the_initialiser_receives_the_actors_own_subject =
    := started =
        new_with_self 10000i32 (\ (me : erlang_process.subject (erlang_process.subject i32)) => me)
        |> on_message
            \ (me : erlang_process.subject (erlang_process.subject i32)) (reply_to : erlang_process.subject i32) =>
                erlang_process.send reply_to 9i32
                continue me
        |> start
        |> started_data
    ?= started ?|
    | Some subject => call subject 10000i32 (\ (reply_to : erlang_process.subject i32) => reply_to) |> _assert_eq 9i32
    | None => failwith "the actor did not start"
