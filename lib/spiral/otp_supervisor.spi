:< sm'_operators

:# otp_supervisor static =
    :< testing

:= otp_supervisor_imports () =
    global "import gleam/otp/static_supervisor"
    global "import gleam/otp/supervision"

:! supervisor_builder = $'static_supervisor.Builder'
:! supervisor = $'static_supervisor.Supervisor'
:! child d = $'supervision.ChildSpecification(`d)'
:! strategy_term = $'static_supervisor.Strategy'
:! restart_term = $'supervision.Restart'

:| strategy =
    | OneForOne
    | OneForAll
    | RestForOne

:| restart =
    | Permanent
    | Transient
    | Temporary

:= strategy_of (s : strategy) : strategy_term =
    otp_supervisor_imports ()
    ?= s ?|
    | OneForOne => $'static_supervisor.OneForOne'
    | OneForAll => $'static_supervisor.OneForAll'
    | RestForOne => $'static_supervisor.RestForOne'

:= new (choice : strategy) : supervisor_builder =
    otp_supervisor_imports ()
    := term = strategy_of choice
    $'static_supervisor.new(!term)'

:= restart_tolerance (intensity : i32) (period_s : i32) (spec : supervisor_builder) : supervisor_builder =
    otp_supervisor_imports ()
    $'static_supervisor.restart_tolerance(!spec, !intensity, !period_s)'

:= add \* d. (worker : child d) (spec : supervisor_builder) : supervisor_builder =
    otp_supervisor_imports ()
    $'static_supervisor.add(!spec, !worker)'

:= start (spec : supervisor_builder) : otp_actor::start_result supervisor =
    otp_supervisor_imports ()
    $'static_supervisor.start(!spec)'

:= supervised (spec : supervisor_builder) : child supervisor =
    otp_supervisor_imports ()
    $'static_supervisor.supervised(!spec)'

:= worker \* d. (run : () -> otp_actor::start_result d) : child d =
    otp_supervisor_imports ()
    $'supervision.worker(fn() { !run(Nil) })'

:= restart_of (choice : restart) : restart_term =
    otp_supervisor_imports ()
    ?= choice ?|
    | Permanent => $'supervision.Permanent'
    | Transient => $'supervision.Transient'
    | Temporary => $'supervision.Temporary'

:= with_restart \* d. (choice : restart) (spec : child d) : child d =
    otp_supervisor_imports ()
    := term = restart_of choice
    $'supervision.restart(!spec, !term)'

:= with_shutdown \* d. (shutdown_ms : i32) (spec : child d) : child d =
    otp_supervisor_imports ()
    $'supervision.timeout(!spec, !shutdown_ms)'

:= counting_worker () =
    worker \ () =>
        otp_actor::new 0i32
        |> otp_actor::on_message (\ total (_ : i32) => otp_actor::continue total)
        |> otp_actor::start

:= restarting_worker () = counting_worker () |> with_restart Transient

///> gleam
:# supervisor_starts_a_worker =
    new OneForOne
    |> restart_tolerance 3i32 5i32
    |> add (restarting_worker ())
    |> start
    |> otp_actor::started_data
    |> \|
        | Some _ => !+
        | None => !-
    |> _assert_eq !+

:| restart_msg =
    | Bump
    | Crash
    | Ask : erlang_process::subject i32

:= answer (total : i32) (reply : erlang_process::subject i32) : otp_actor::next i32 restart_msg =
    otp_actor::send reply total
    otp_actor::continue total

:= restart_step (total : i32) (message : restart_msg) : otp_actor::next i32 restart_msg =
    ?= message ?|
    | Bump => otp_actor::continue (total + 1i32)
    | Crash => otp_actor::stop_abnormal "crash on request"
    | Ask reply => answer total reply

:== restart_name = erlang_process::name restart_msg

:== restart_inbox = erlang_process::subject restart_msg

:= named_worker (address : restart_name) : child restart_inbox =
    worker \ () => otp_actor::new 0i32 |> otp_actor::named address |> otp_actor::on_message restart_step |> otp_actor::start

:= supervise_named (address : restart_name) : () =
    new OneForOne |> restart_tolerance 3i32 5i32 |> add (named_worker address |> with_restart Transient) |> start |> ignore

:= pause (ms : i32) : () = erlang_term::apply "timer" "sleep" [ erlang_term::of ms ] |> ignore

:= count_after_bumps (inbox : restart_inbox) : i32 =
    otp_actor::send inbox Bump
    otp_actor::send inbox Bump
    otp_actor::call inbox 5000i32 Ask

:= count_after_crash (inbox : restart_inbox) : i32 =
    otp_actor::send inbox Crash
    pause 300i32
    otp_actor::call inbox 5000i32 Ask

:= restart_counts (address : restart_name) : i32 * i32 =
    supervise_named address
    := inbox = erlang_process::named_subject address
    := before = count_after_bumps inbox
    before, count_after_crash inbox

///> gleam
:# a_crashed_transient_worker_is_restarted_with_fresh_state =
    restart_counts (erlang_process::new_name "org2-restart") |> _assert_eq (2i32, 0i32)
