/// # otp_supervisor
:< sm'_operators

test otp_supervisor static =
    :< testing

:= otp_supervisor_imports () =
    global "import gleam/otp/static_supervisor"
    global "import gleam/otp/supervision"

:! supervisor_builder = $'static_supervisor.Builder'
:! supervisor = $'static_supervisor.Supervisor'
:! child d = $'supervision.ChildSpecification(`d)'

:| strategy =
    | OneForOne
    | OneForAll
    | RestForOne

:| restart =
    | Permanent
    | Transient
    | Temporary

/// ### new
:= new (choice : strategy) : supervisor_builder =
    otp_supervisor_imports ()
    ?= choice ?|
    | OneForOne => $'static_supervisor.new(static_supervisor.OneForOne)'
    | OneForAll => $'static_supervisor.new(static_supervisor.OneForAll)'
    | RestForOne => $'static_supervisor.new(static_supervisor.RestForOne)'

/// ### restart_tolerance
:= restart_tolerance (intensity : i32) (period_s : i32) (spec : supervisor_builder) : supervisor_builder =
    otp_supervisor_imports ()
    $'static_supervisor.restart_tolerance(!spec, !intensity, !period_s)'

/// ### add
:= add \* d. (worker : child d) (spec : supervisor_builder) : supervisor_builder =
    otp_supervisor_imports ()
    $'static_supervisor.add(!spec, !worker)'

/// ### start
:= start (spec : supervisor_builder) : otp_actor.start_result supervisor =
    otp_supervisor_imports ()
    $'static_supervisor.start(!spec)'

/// ### supervised
:= supervised (spec : supervisor_builder) : child supervisor =
    otp_supervisor_imports ()
    $'static_supervisor.supervised(!spec)'

/// ### worker
:= worker \* d. (run : () -> otp_actor.start_result d) : child d =
    otp_supervisor_imports ()
    $'supervision.worker(fn() { !run(Nil) })'

/// ### with_restart
:= with_restart \* d. (choice : restart) (spec : child d) : child d =
    otp_supervisor_imports ()
    ?= choice ?|
    | Permanent => $'supervision.restart(!spec, supervision.Permanent)'
    | Transient => $'supervision.restart(!spec, supervision.Transient)'
    | Temporary => $'supervision.restart(!spec, supervision.Temporary)'

/// ### with_shutdown
:= with_shutdown \* d. (shutdown_ms : i32) (spec : child d) : child d =
    otp_supervisor_imports ()
    $'supervision.timeout(!spec, !shutdown_ms)'

///> gleam
test supervisor_starts_a_worker =
    := worker_spec = worker \ () =>
        otp_actor.new 0i32 |> otp_actor.on_message (\ total (_ : i32) => otp_actor.continue total) |> otp_actor.start
    new OneForOne
    |> restart_tolerance 3i32 5i32
    |> add worker_spec
    |> start
    |> otp_actor.started_data
    |> \|
        | Some _ => !+
        | None => !-
    |> _assert_eq !+
