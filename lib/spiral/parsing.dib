|> resultm.map_error eval
|> _assert_eq (Error "parsing.p_char / { expected = b; line = 1; col = 1 }\ncba\n^\n")

#!markdown

### concat_rev

#!spiral

inl concat_rev (acc : list string) : string =
    let rec pass (rev : bool) (xs : list string) (out : list string) : list string =
        match xs with
        | a :: rest =>
            match rest with
            | b :: rest' => pass rev rest' ((if rev then b ++# a else a ++# b) :: out)
            | [] => a :: out
        | [] => out
    let rec 루프 (rev : bool) (xs : list string) : string =
        match xs with
        | [] => ""
        | x :: rest =>
            match rest with
            | [] => x
            | _ => 루프 (not rev) (pass rev xs [])
    if rust.rust.is_native () then
        match acc with
        | _ :: _ :: _ :: _ =>
            // Native Rust: one buffer of the total length, each piece copied to its place from the end (the list is
            // last-first): three allocations instead of a string and a list node per pair and pass.
            inl total : i32 = (0i32, acc) ||> listm.fold fun n (x : string) => n + ##x
            inl buf : $'Rc<RefCell<Vec<u8>>>' = $'Rc::new(RefCell::new(vec\![0u8; !total as usize]))'
            inl _ : i32 = (total, acc) ||> listm.fold fun end (x : string) =>
                inl start = end - ##x
                $'!buf.borrow_mut()[!start as usize..!end as usize].copy_from_slice(!x.as_bytes())' : ()
                start
            $'unsafe { Rc::<str>::from(std::str::from_utf8_unchecked(&!buf.borrow())) }' : string
        | _ => 루프 true acc
    else 루프 true acc

#!markdown

### string_of

#!spiral

// `#?` for the many*_strings element results, except that a string is returned as is (the generic formatter copies it
// through a string builder: several allocations per element on native Rust).
inl string_of forall t. (x : t) : string =
    real
        match x with
        | (_ : string) => x
        | _ => sm'_real.format_real `t x

#!markdown

### many1_strings

#!spiral

inl many1_strings (p : parser _) : parser string = fun t, i, s =>
    trace_entry "parsing.many1_strings" fun () => { t_len = ##t }
    match p (t, i, s) with
    | Error e => e |> Error
    | Ok (r, i', s') =>
        inl first = string_of r
        // `acc`: the elements after the first, last first (one element, the common case, builds no list)
        let rec 루프 (acc : list string) (i'' : int) s'' : result (string * int * _) _ =
            match p (t, i'', s'') with
            | Error _ =>
                inl r =
                    match acc with
                    | [] => first
                    | _ => first ++# (acc |> concat_rev)
                Ok (r, i'', s'')
            | Ok (r', i''', s''') when i''' > i'' => s''' |> 루프 (string_of r' :: acc) i'''
            | Ok _ => fail (fun _ => "parsing.many1_strings / inner parser succeeded without consuming text") i'' s''
        s' |> 루프 [] i'

#!spiral

///- --test
///> gleam
///> fsharp
///> cuda
///> typescript

"aaabbc"
|> run_parser (many1_strings (p_char 'a' <|> p_char 'b'))
|> unwrap_format
|> _assert_eq #?*("aaabb", "c", new_parser_state 0 1 6 6)

#!markdown

### many_strings

#!spiral

inl many_strings (p : parser _) : parser string = fun t, i, s =>
    trace_entry "parsing.many_strings" fun () => { t_len = ##t }
    match p (t, i, s) with
    | Error _ => Ok ("", i, s)
    | Ok (_, i', _) when i' = i => fail (fun _ => "parsing.many_strings / first inner parser consumed no text") i s
    | Ok (r, i', s') when rust.rust.is_native () =>
        // Native Rust: the elements go straight into one growing buffer (no list node per element and no concat_rev
        // pass); 2-3x faster on bench/parsing's quoted and CLI cases, where an element is often a single char.
        inl buf : $'Rc<RefCell<std::string::String>>' = $'Rc::new(RefCell::new(std::string::String::new()))'
        inl push (x : string) : () = $'!buf.borrow_mut().push_str(&*!x)'
        inl first = string_of r
        let rec 루프 (n : int) (i' : int) s' : result (string * int * _) _ =
            match p (t, i', s') with
            | Error _ =>
                inl r = if n = 0 then first else $'Rc::<str>::from(!buf.borrow().as_str())' : string
                Ok (r, i', s')
            | Ok (r', i'', s'') when i'' > i' =>
                if n = 0 then push first
                push (string_of r')
                s'' |> 루프 (n + 1) i''
            | Ok _ => fail (fun _ => "parsing.many_strings / inner parser succeeded without consuming text") i' s'
        s' |> 루프 0 i'
    | Ok (r, i', s') =>
        let rec 루프 (acc : list string) (i' : int) s' : result (string * int * _) _ =
            match p (t, i', s') with
            | Error _ =>
                // one element: the string itself (`++# ""` copies it on native Rust)
                inl r = string_of r
                inl r =
                    match acc with
                    | [] => r
                    | _ => r ++# (acc |> concat_rev)
                Ok (r, i', s')
            | Ok (r', i'', s'') when i'' > i' => s'' |> 루프 (string_of r' :: acc) i''
            | Ok _ => fail (fun _ => "parsing.many_strings / inner parser succeeded without consuming text") i' s'
        s' |> 루프 [] i'

#!markdown

### choice

#!spiral

// A right fold into nested `<|>`: a compile-time list of parsers is unrolled (no runtime list of closures is built per
// call, which on native Rust cost one allocation per element, list node and the empty list on every call).
inl choice forall t. (ps : list (parser t)) : parser t =
    inl none : parser t = fun _, i, s =>
        fail (fun _ => "parsing.choice / no parsers succeeded") i s
    (ps, none) ||> listm.foldBack (<|>)

#!spiral

///- --test
///> gleam
///> fsharp
///> cuda
///> typescript

"bca"
|> run_parser (choice [ p_char 'a'; p_char 'b'; p_char 'c' ])
|> unwrap_format
|> _assert_eq #?*('b', "ca", new_parser_state 0 1 2 3)

"cba"
|> run_parser (choice [ p_char 'a'; p_char 'b'; p_char 'c' ])
|> unwrap_format
|> _assert_eq #?*('c', "ba", new_parser_state 0 1 2 3)

#!markdown

### between

#!spiral

inl between p_open p_close p_content : parser _ = fun t, i, s =>
    trace_entry "parsing.between" fun () => { t_len = ##t; i s }
    match p_open (t, i, s) with
    | Ok (_, i', s') =>
        match p_content (t, i', s') with
        | Ok (result, i'', s'') =>
            match p_close (t, i'', s'') with
            | Ok (_, i''', s''') => Ok (result, i''', s''')
            | Error e' =>
                // the only failure that keeps run-time data (the inner error and both positions): allocates
                fail
                    fun t, _, _ =>
                        inl e = fun () => e' |> error_message t
                        inl t_len = ##t
                        inl end' = (i' + get_max_context ()) |> min t_len
                        inl end'' = (i'' + get_max_context ()) |> min t_len
                        inl rest' = t |> slice i' end'
                        inl rest'' = t |> slice i'' end''
                        "parsing.between / expected closing delimiter / " ++#? { e t rest' rest'' }
                    i'' s''
        | Error _ =>
            match p_close (t, i', s') with
            | Ok (_, i''', s''') => Ok ("", i''', s''')
            | Error _ =>
                fail
                    fun t, i', _ =>
                        inl end' = (i' + get_max_context ()) |> min ##t
                        inl rest' = t |> slice i' end'
                        "parsing.between / expected content or closing delimiter / " ++#? { rest' }
                    i' s'
    | Error e => e |> Error

#!spiral

