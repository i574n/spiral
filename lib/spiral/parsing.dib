///- --test

"abc\ndef\nghi"
|> parse_ (skip_any_string_ 5 >>.$ p_char_ 'a')
|> resultm.unwrap_err
|> sm'.obj_to_string
|> sm'.replace "\r\n" "\n"
|> _assert_eq "(Error in Ln: 2 Col: 2\ndef\n ^\nExpecting: 'a'\n, Error in Ln: 2 Col: 2\nExpecting: 'a'\n)"

#!markdown

### none_of

#!spiral

inl none_of (chars : list char) : parser char = fun t, i, (parser_state s' as s) =>
    inl chars' () =
        chars |> listm'.box |> listm'.to_array' |> sm'.format
    if i >= s'.text_length then
        fail (fun _, _, s => "parsing.none_of / unexpected end of text / " ++#? { chars' = chars' (); s }) i s
    else
        inl ch = t |> sm'.index i
        if chars |> listm'.exists' ((=) ch) |> not
        then Ok (ch, i + 1, ch |> update_char s)
        else
            fail
                fun t, i, s =>
                    "parsing.none_of / unexpected char / "
                    ++#? { first_char = t |> sm'.index i; chars' = chars' (); s }
                i s

#!spiral

///- --test
///> gleam
///> fsharp
///> cuda
///> typescript

"abc"
|> run_parser (none_of ['a'; 'b'; 'c'])
|> resultm.map_error eval
|> _assert_eq (
    backend_switch {
        Gleam = fun () =>
            "parsing.none_of / unexpected char / "
            ++# "{ first_char = a; chars' = [\"a\", \"b\", \"c\"]; s = #(0, 1, 1, 3) }"
        Lua = fun () =>
            "parsing.none_of / unexpected char / "
            ++# "{ first_char = a; chars' = [\"a\", \"b\", \"c\"]; s = #(0, 1, 1, 3) }"
        Fsharp = fun () =>
            run_target function
            | TypeScript _ => fun () =>
                join
                    "parsing.none_of / unexpected char / "
                    ++# "{ first_char = a; chars' = a,b,c; s = 0,1,1,3 }"
            | _ => fun () =>
                join
                    "parsing.none_of / unexpected char / "
                    ++# "{ first_char = a; chars' = [|'a'; 'b'; 'c'|]; s = struct (0, 1, 1, 3) }"
        Python = fun () =>
            "parsing.none_of / unexpected char / "
            ++# "{ first_char = a; chars' = ['a' 'b' 'c']; s = (0, 1, 1, 3) }"
    }
    |> Error
)

"def"
|> run_parser (none_of ['a'; 'b'; 'c'])
|> unwrap_format
|> _assert_eq #?*('d', "ef", new_parser_state 0 1 2 3)

