### sep_by

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"inl sep_by forall b. p sep : parser (list b) = fun t, i, s =>\n    trace_entry \"parsing.sep_by\" fun () => { t_len = ##t; i s }\n    match p (t, i, s) with\n    | Error _ => Ok ([], i, s)\n    | Ok (first, i', s') =>\n        let rec 루프 (acc : list b) (i'' : int) s'' : result (list b * int * parser_state) _ =\n            match sep (t, i'', s'') with\n            | Error _ => Ok (acc |> listm.rev, i'', s'')\n            | Ok (_, i''', s''') =>\n                if i''' = i'' then\n                    fail (fun _ => \"parsing.sep_by / separator consumed no text\") i'' s''\n                else\n                    match p (t, i''', s''') with\n                    | Ok (x, i'''', s'''') => s'''' |> 루프 (x :: acc) i''''\n                    | Error _ => Ok (acc |> listm.rev, i'', s'')\n        s' |> 루프 [ first ] i'","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  inl sep_by forall b. p sep : parser (list b) = fun t, i, s =>
      trace_entry "parsing.sep_by" fun () => { t_len = ##t; i s }
      match p (t, i, s) with
      | Error _ => Ok ([], i, s)
      | Ok (first, i', s') =>
          let rec 루프 (acc : list b) (i'' : int) s'' : result (list b * int * parser_state) _ =
              match sep (t, i'', s'') with
              | Error _ => Ok (acc |> listm.rev, i'', s'')
              | Ok (_, i''', s''') =>
                  if i''' = i'' then
                      fail (fun _ => "parsing.sep_by / separator consumed no text") i'' s''
                  else
                      match p (t, i''', s''') with
                      | Ok (x, i'''', s'''') => s'''' |> 루프 (x :: acc) i''''
                      | Error _ => Ok (acc |> listm.rev, i'', s'')
          s' |> 루프 [ first ] i'
  """,
  timeout: 300_000
)
```

### sep_end_by

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"inl sep_end_by forall b. p sep : parser (list b) = fun t, i, s =>\n    trace_entry \"parsing.sep_end_by\" fun () => { t_len = ##t; i s }\n    let rec 루프 acc i' s' =\n        match p (t, i', s') with\n        | Error _ => Ok (acc |> listm.rev, i', s')\n        | Ok (x, i'', s'') =>\n            if i'' = i' then\n                fail (fun _ => \"parsing.sep_end_by / element parser consumed no text\") i' s'\n            else\n                inl acc' = x :: acc\n                match sep (t, i'', s'') with\n                | Error _ => Ok (acc' |> listm.rev, i'', s'')\n                | Ok (_, i''', s''') =>\n                    if i''' <> i''\n                    then s''' |> 루프 acc' i'''\n                    else fail (fun _ => \"parsing.sep_end_by / separator consumed no text\") i'' s''\n    s |> 루프 [] i","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  inl sep_end_by forall b. p sep : parser (list b) = fun t, i, s =>
      trace_entry "parsing.sep_end_by" fun () => { t_len = ##t; i s }
      let rec 루프 acc i' s' =
          match p (t, i', s') with
          | Error _ => Ok (acc |> listm.rev, i', s')
          | Ok (x, i'', s'') =>
              if i'' = i' then
                  fail (fun _ => "parsing.sep_end_by / element parser consumed no text") i' s'
              else
                  inl acc' = x :: acc
                  match sep (t, i'', s'') with
                  | Error _ => Ok (acc' |> listm.rev, i'', s'')
                  | Ok (_, i''', s''') =>
                      if i''' <> i''
                      then s''' |> 루프 acc' i'''
                      else fail (fun _ => "parsing.sep_end_by / separator consumed no text") i'' s''
      s |> 루프 [] i
  """,
  timeout: 300_000
)
```

