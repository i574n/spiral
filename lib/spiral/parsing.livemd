### parse

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"inl parse forall t.\n    (p : parser t)\n    (t : string)\n    (s : parser_state)\n    : result ((() -> t) * (() -> string) * parser_state) (() -> string)\n    =\n    p (t, 0, s)\n    |> resultm.map fun result, i, (parser_state s' as s) =>\n        (fun () => result),\n        (fun () => t |> slice i s'.text_length),\n        s\n    |> resultm.map_error fun e =>\n        fun () => e |> error_message t","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  inl parse forall t.
      (p : parser t)
      (t : string)
      (s : parser_state)
      : result ((() -> t) * (() -> string) * parser_state) (() -> string)
      =
      p (t, 0, s)
      |> resultm.map fun result, i, (parser_state s' as s) =>
          (fun () => result),
          (fun () => t |> slice i s'.text_length),
          s
      |> resultm.map_error fun e =>
          fun () => e |> error_message t
  """,
  timeout: 300_000
)
```

### update_char

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"inl update_char (parser_state s) (c : char) : parser_state =\n    match c with\n    | '\\n' =>\n        { s with\n            line_start = s.line_start + s.position.col\n            position = { line = s.position.line + 1; col = 1 }\n        }\n    | _ =>\n        { s with\n            position = { line = s.position.line; col = s.position.col + 1 }\n        }\n    |> parser_state","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  inl update_char (parser_state s) (c : char) : parser_state =
      match c with
      | '\n' =>
          { s with
              line_start = s.line_start + s.position.col
              position = { line = s.position.line + 1; col = 1 }
          }
      | _ =>
          { s with
              position = { line = s.position.line; col = s.position.col + 1 }
          }
      |> parser_state
  """,
  timeout: 300_000
)
```

### update_span

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"inl update_span (t : string) (i : int) (len : int) (parser_state s' as s) : parser_state =\n    inl endi = i + len\n    let rec 루프 (i' : int) (last_nl : int) (count : int) =\n        if i' >= endi\n        then last_nl, count\n        else\n            match t |> sm'.index i' with\n            | '\\n' => 루프 (i' + 1) i' (count + 1)\n            | _ => 루프 (i' + 1) last_nl count\n    inl last_nl, n = 루프 i -1 0\n    if n = 0\n    then { s' with position = { line = s'.position.line; col = s'.position.col + len } }\n    else\n        { s' with\n            line_start = last_nl + 1\n            position =\n                {\n                    line = s'.position.line + n\n                    col = endi - last_nl\n                }\n            text_length = s'.text_length\n        }\n    |> parser_state","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  inl update_span (t : string) (i : int) (len : int) (parser_state s' as s) : parser_state =
      inl endi = i + len
      let rec 루프 (i' : int) (last_nl : int) (count : int) =
          if i' >= endi
          then last_nl, count
          else
              match t |> sm'.index i' with
              | '\n' => 루프 (i' + 1) i' (count + 1)
              | _ => 루프 (i' + 1) last_nl count
      inl last_nl, n = 루프 i -1 0
      if n = 0
      then { s' with position = { line = s'.position.line; col = s'.position.col + len } }
      else
          { s' with
              line_start = last_nl + 1
              position =
                  {
                      line = s'.position.line + n
                      col = endi - last_nl
                  }
              text_length = s'.text_length
          }
      |> parser_state
  """,
  timeout: 300_000
)
```

