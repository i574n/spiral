### between

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"inl between p_open p_close p_content : parser _ = fun t, i, s =>\n    trace_entry \"parsing.between\" fun () => { t_len = ##t; i s }\n    match p_open (t, i, s) with\n    | Ok (_, i', s') =>\n        match p_content (t, i', s') with\n        | Ok (result, i'', s'') =>\n            match p_close (t, i'', s'') with\n            | Ok (_, i''', s''') => Ok (result, i''', s''')\n            | Error e' =>\n                fail\n                    fun t, _, _ =>\n                        inl e = fun () => e' |> error_message t\n                        inl t_len = ##t\n                        inl end' = (i' + get_max_context ()) |> min t_len\n                        inl end'' = (i'' + get_max_context ()) |> min t_len\n                        inl rest' = t |> slice i' end'\n                        inl rest'' = t |> slice i'' end''\n                        \"parsing.between / expected closing delimiter / \" ++#? { e t rest' rest'' }\n                    i'' s''\n        | Error _ =>\n            match p_close (t, i', s') with\n            | Ok (_, i''', s''') => Ok (\"\", i''', s''')\n            | Error _ =>\n                fail\n                    fun t, i', _ =>\n                        inl end' = (i' + get_max_context ()) |> min ##t\n                        inl rest' = t |> slice i' end'\n                        \"parsing.between / expected content or closing delimiter / \" ++#? { rest' }\n                    i' s'\n    | Error e => e |> Error","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  inl between p_open p_close p_content : parser _ = fun t, i, s =>
      trace_entry "parsing.between" fun () => { t_len = ##t; i s }
      match p_open (t, i, s) with
      | Ok (_, i', s') =>
          match p_content (t, i', s') with
          | Ok (result, i'', s'') =>
              match p_close (t, i'', s'') with
              | Ok (_, i''', s''') => Ok (result, i''', s''')
              | Error e' =>
                  fail
                      fun t, _, _ =>
                          inl e = fun () => e' |> error_message t
                          inl t_len = ##t
                          inl end' = (i' + get_max_context ()) |> min t_len
                          inl end'' = (i'' + get_max_context ()) |> min t_len
                          inl rest' = t |> slice i' end'
                          inl rest'' = t |> slice i'' end''
                          "parsing.between / expected closing delimiter / " ++#? { e t rest' rest'' }
                      i'' s''
          | Error _ =>
              match p_close (t, i', s') with
              | Ok (_, i''', s''') => Ok ("", i''', s''')
              | Error _ =>
                  fail
                      fun t, i', _ =>
                          inl end' = (i' + get_max_context ()) |> min ##t
                          inl rest' = t |> slice i' end'
                          "parsing.between / expected content or closing delimiter / " ++#? { rest' }
                      i' s'
      | Error e => e |> Error
  """,
  timeout: 300_000
)
```

