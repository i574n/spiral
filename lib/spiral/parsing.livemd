### many1_strings

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"inl many1_strings (p : parser _) : parser string = fun t, i, s =>\n    trace_entry \"parsing.many1_strings\" fun () => { t_len = ##t }\n    match p (t, i, s) with\n    | Error e => e |> Error\n    | Ok (r, i', s') =>\n        inl first = string_of r\n        let rec 루프 (acc : list string) (i'' : int) s'' : result (string * int * _) _ =\n            match p (t, i'', s'') with\n            | Error _ =>\n                inl r =\n                    match acc with\n                    | [] => first\n                    | _ => first ++# (acc |> concat_rev)\n                Ok (r, i'', s'')\n            | Ok (r', i''', s''') when i''' > i'' => s''' |> 루프 (string_of r' :: acc) i'''\n            | Ok _ => fail (fun _ => \"parsing.many1_strings / inner parser succeeded without consuming text\") i'' s''\n        s' |> 루프 [] i'","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  inl many1_strings (p : parser _) : parser string = fun t, i, s =>
      trace_entry "parsing.many1_strings" fun () => { t_len = ##t }
      match p (t, i, s) with
      | Error e => e |> Error
      | Ok (r, i', s') =>
          inl first = string_of r
          let rec 루프 (acc : list string) (i'' : int) s'' : result (string * int * _) _ =
              match p (t, i'', s'') with
              | Error _ =>
                  inl r =
                      match acc with
                      | [] => first
                      | _ => first ++# (acc |> concat_rev)
                  Ok (r, i'', s'')
              | Ok (r', i''', s''') when i''' > i'' => s''' |> 루프 (string_of r' :: acc) i'''
              | Ok _ => fail (fun _ => "parsing.many1_strings / inner parser succeeded without consuming text") i'' s''
          s' |> 루프 [] i'
  """,
  timeout: 300_000
)
```

