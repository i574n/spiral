### many_strings

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"inl many_strings (p : parser _) : parser string = fun t, i, s =>\n    trace_entry \"parsing.many_strings\" fun () => { t_len = ##t }\n    match p (t, i, s) with\n    | Error _ => Ok (\"\", i, s)\n    | Ok (_, i', _) when i' = i => fail (fun _ => \"parsing.many_strings / first inner parser consumed no text\") i s\n    | Ok (r, i', s') when is_rust () =>\n        inl buf : $'Rc<RefCell<std::string::String>>' = $'Rc::new(RefCell::new(std::string::String::new()))'\n        inl push (x : string) : () = $'!buf.borrow_mut().push_str(&*!x)'\n        inl first = string_of r\n        let rec 루프 (n : int) (i' : int) s' : result (string * int * _) _ =\n            match p (t, i', s') with\n            | Error _ =>\n                inl r = if n = 0 then first else $'Rc::<str>::from(!buf.borrow().as_str())' : string\n                Ok (r, i', s')\n            | Ok (r', i'', s'') when i'' > i' =>\n                if n = 0 then push first\n                push (string_of r')\n                s'' |> 루프 (n + 1) i''\n            | Ok _ => fail (fun _ => \"parsing.many_strings / inner parser succeeded without consuming text\") i' s'\n        s' |> 루프 0 i'\n    | Ok (r, i', s') =>\n        let rec 루프 (acc : list string) (i' : int) s' : result (string * int * _) _ =\n            match p (t, i', s') with\n            | Error _ =>\n                inl r = string_of r\n                inl r =\n                    match acc with\n                    | [] => r\n                    | _ => r ++# (acc |> concat_rev)\n                Ok (r, i', s')\n            | Ok (r', i'', s'') when i'' > i' => s'' |> 루프 (string_of r' :: acc) i''\n            | Ok _ => fail (fun _ => \"parsing.many_strings / inner parser succeeded without consuming text\") i' s'\n        s' |> 루프 [] i'","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  inl many_strings (p : parser _) : parser string = fun t, i, s =>
      trace_entry "parsing.many_strings" fun () => { t_len = ##t }
      match p (t, i, s) with
      | Error _ => Ok ("", i, s)
      | Ok (_, i', _) when i' = i => fail (fun _ => "parsing.many_strings / first inner parser consumed no text") i s
      | Ok (r, i', s') when is_rust () =>
          inl buf : $'Rc<RefCell<std::string::String>>' = $'Rc::new(RefCell::new(std::string::String::new()))'
          inl push (x : string) : () = $'!buf.borrow_mut().push_str(&*!x)'
          inl first = string_of r
          let rec 루프 (n : int) (i' : int) s' : result (string * int * _) _ =
              match p (t, i', s') with
              | Error _ =>
                  inl r = if n = 0 then first else $'Rc::<str>::from(!buf.borrow().as_str())' : string
                  Ok (r, i', s')
              | Ok (r', i'', s'') when i'' > i' =>
                  if n = 0 then push first
                  push (string_of r')
                  s'' |> 루프 (n + 1) i''
              | Ok _ => fail (fun _ => "parsing.many_strings / inner parser succeeded without consuming text") i' s'
          s' |> 루프 0 i'
      | Ok (r, i', s') =>
          let rec 루프 (acc : list string) (i' : int) s' : result (string * int * _) _ =
              match p (t, i', s') with
              | Error _ =>
                  inl r = string_of r
                  inl r =
                      match acc with
                      | [] => r
                      | _ => r ++# (acc |> concat_rev)
                  Ok (r, i', s')
              | Ok (r', i'', s'') when i'' > i' => s'' |> 루프 (string_of r' :: acc) i''
              | Ok _ => fail (fun _ => "parsing.many_strings / inner parser succeeded without consuming text") i' s'
          s' |> 루프 [] i'
  """,
  timeout: 300_000
)
```

