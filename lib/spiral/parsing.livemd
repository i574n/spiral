### p_string

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"inl p_string (str : string) : parser string = fun t, i, (parser_state s' as s) =>\n    inl len = ##str\n    if s'.text_length - i < len then\n        fail (fun _, _, s => \"parsing.p_string / unexpected end of text / \" ++#? { expected = str; s }) i s\n    else\n        let rec eq k =\n            if k >= len\n            then true\n            else t |> sm'.index (i + k) = str |> sm'.index k && eq (k + 1)\n        if eq 0\n        then Ok (t |> slice i (i + len), i + len, s |> update_span t i len)\n        else\n            fail\n                fun t, i, (parser_state s' as s) =>\n                    inl preview_end = (i + get_max_context ()) |> min s'.text_length\n                    inl rest = t |> slice i preview_end\n                    inl got = t |> slice i (i + len)\n                    \"parsing.p_string / unexpected string / \"\n                    ++#? { expected = str; got rest s }\n                i s","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  inl p_string (str : string) : parser string = fun t, i, (parser_state s' as s) =>
      inl len = ##str
      if s'.text_length - i < len then
          fail (fun _, _, s => "parsing.p_string / unexpected end of text / " ++#? { expected = str; s }) i s
      else
          let rec eq k =
              if k >= len
              then true
              else t |> sm'.index (i + k) = str |> sm'.index k && eq (k + 1)
          if eq 0
          then Ok (t |> slice i (i + len), i + len, s |> update_span t i len)
          else
              fail
                  fun t, i, (parser_state s' as s) =>
                      inl preview_end = (i + get_max_context ()) |> min s'.text_length
                      inl rest = t |> slice i preview_end
                      inl got = t |> slice i (i + len)
                      "parsing.p_string / unexpected string / "
                      ++#? { expected = str; got rest s }
                  i s
  """,
  timeout: 300_000
)
```

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"///- --test\n\n\"hello world\"\n|> run_parser (p_string \"hello\")\n|> unwrap_format\n|> _assert_eq #?*(\"hello\", \" world\", new_parser_state 0 1 6 11)","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  ///- --test

  "hello world"
  |> run_parser (p_string "hello")
  |> unwrap_format
  |> _assert_eq #?*("hello", " world", new_parser_state 0 1 6 11)
  """,
  timeout: 300_000
)
```

### new_line

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"inl new_line () : parser char = fun t, i, (parser_state s' as s) =>\n    if i >= s'.text_length then\n        fail (fun _, _, s => \"parsing.new_line / unexpected end of text / \" ++#? { s }) i s\n    else\n        inl c = t |> sm'.index i\n        if c = '\\n'\n        then Ok (c, i + 1, c |> update_char s)\n        else\n            fail\n                fun t, i, (parser_state s' as s) =>\n                    inl preview_end = (i + get_max_context ()) |> min s'.text_length\n                    inl rest = t |> slice i preview_end\n                    \"parsing.new_line / expected new line char / \"\n                    ++#? { first_char = t |> sm'.index i; rest s }\n                i s","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  inl new_line () : parser char = fun t, i, (parser_state s' as s) =>
      if i >= s'.text_length then
          fail (fun _, _, s => "parsing.new_line / unexpected end of text / " ++#? { s }) i s
      else
          inl c = t |> sm'.index i
          if c = '\n'
          then Ok (c, i + 1, c |> update_char s)
          else
              fail
                  fun t, i, (parser_state s' as s) =>
                      inl preview_end = (i + get_max_context ()) |> min s'.text_length
                      inl rest = t |> slice i preview_end
                      "parsing.new_line / expected new line char / "
                      ++#? { first_char = t |> sm'.index i; rest s }
                  i s
  """,
  timeout: 300_000
)
```

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"///- --test\n\n\"hello\\nworld\"\n|> run_parser (many_chars_till (any_char ()) (new_line ()))\n|> unwrap_format\n|> _assert_eq #?*(\"hello\", \"\\nworld\", new_parser_state 0 1 6 11)","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  ///- --test

  "hello\nworld"
  |> run_parser (many_chars_till (any_char ()) (new_line ()))
  |> unwrap_format
  |> _assert_eq #?*("hello", "\nworld", new_parser_state 0 1 6 11)
  """,
  timeout: 300_000
)
```

### many_till

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"inl many_till forall b c. (p : parser b) (end_p : parser c) : parser _ = fun t, i, s =>\n    trace_entry \"parsing.many_till\" fun () => { i t_len = ##t }\n    let rec 루프 (acc : list b) (i' : int) s' : result (_ * int * parser_state) _ =\n        match end_p (t, i', s') with\n        | Ok (_, i'', s'') => Ok (acc |> listm.rev, i'', s'')\n        | Error _ =>\n            match p (t, i', s') with\n            | Ok (x, i'', s'') =>\n                if i'' <> i'\n                then s'' |> 루프 (x :: acc) i''\n                else fail (fun _ => \"parsing.many_till / inner parser succeeded without consuming text\") i' s'\n            | Error e => e |> Error\n    s |> 루프 [] i","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  inl many_till forall b c. (p : parser b) (end_p : parser c) : parser _ = fun t, i, s =>
      trace_entry "parsing.many_till" fun () => { i t_len = ##t }
      let rec 루프 (acc : list b) (i' : int) s' : result (_ * int * parser_state) _ =
          match end_p (t, i', s') with
          | Ok (_, i'', s'') => Ok (acc |> listm.rev, i'', s'')
          | Error _ =>
              match p (t, i', s') with
              | Ok (x, i'', s'') =>
                  if i'' <> i'
                  then s'' |> 루프 (x :: acc) i''
                  else fail (fun _ => "parsing.many_till / inner parser succeeded without consuming text") i' s'
              | Error e => e |> Error
      s |> 루프 [] i
  """,
  timeout: 300_000
)
```

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"///- --test\n\n\"hello\\nworld\"\n|> run_parser (many_till (any_char ()) (new_line ()))\n|> unwrap_format\n|> _assert_eq #?*(['h'; 'e'; 'l'; 'l'; 'o'], \"world\", new_parser_state 6 2 1 11)","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  ///- --test

  "hello\nworld"
  |> run_parser (many_till (any_char ()) (new_line ()))
  |> unwrap_format
  |> _assert_eq #?*(['h'; 'e'; 'l'; 'l'; 'o'], "world", new_parser_state 6 2 1 11)
  """,
  timeout: 300_000
)
```

