### p_char

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"inl p_char (c : char) : parser char =\n    fun t, i, (parser_state ({ line_start position = { line col } } as s') as s) =>\n        if i >= s'.text_length then\n            fail (fun _, _, (parser_state s') => \"parsing.p_char / unexpected end of text / \" ++#? { c s' }) i s\n        else\n            inl got = t |> sm'.index i\n            if got = c\n            then Ok (c, i + 1, got |> update_char s)\n            else\n                fail\n                    fun t, i, (parser_state { line_start position = { line col } }) =>\n                        inl line_end = i |> sm'.span_from ((<>) '\\n') t\n                        inl end = (i + get_max_context ()) |> min line_end\n                        inl line_slice = t |> slice line_start end\n                        inl new_line =\n                            inl len = ##line_slice\n                            if len > 0 && (line_slice |> sm'.index (len - 1)) = '\\n' then \"\" else \"\\n\"\n                        inl pointer_line = (\" \" |> sm'.replicate (col - 1)) ++# \"^\"\n                        \"parsing.p_char / \"\n                        ++#? { expected = c; line col }\n                        ++# \"\\n\" ++# line_slice\n                        ++# new_line\n                        ++# pointer_line ++# \"\\n\"\n                    i s","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  inl p_char (c : char) : parser char =
      fun t, i, (parser_state ({ line_start position = { line col } } as s') as s) =>
          if i >= s'.text_length then
              fail (fun _, _, (parser_state s') => "parsing.p_char / unexpected end of text / " ++#? { c s' }) i s
          else
              inl got = t |> sm'.index i
              if got = c
              then Ok (c, i + 1, got |> update_char s)
              else
                  fail
                      fun t, i, (parser_state { line_start position = { line col } }) =>
                          inl line_end = i |> sm'.span_from ((<>) '\n') t
                          inl end = (i + get_max_context ()) |> min line_end
                          inl line_slice = t |> slice line_start end
                          inl new_line =
                              inl len = ##line_slice
                              if len > 0 && (line_slice |> sm'.index (len - 1)) = '\n' then "" else "\n"
                          inl pointer_line = (" " |> sm'.replicate (col - 1)) ++# "^"
                          "parsing.p_char / "
                          ++#? { expected = c; line col }
                          ++# "\n" ++# line_slice
                          ++# new_line
                          ++# pointer_line ++# "\n"
                      i s
  """,
  timeout: 300_000
)
```

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"///- --test\n///> gleam\n///> fsharp\n///> cuda\n///> typescript\n\n\"abc\"\n|> run_parser (p_char 'a')\n|> unwrap_format\n|> _assert_eq #?*('a', \"bc\", new_parser_state 0 1 2 3)","print_code":false},"livebook_object":"smart_cell"} -->

