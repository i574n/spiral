### concat_rev

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"inl concat_rev (acc : list string) : string =\n    let rec pass (rev : bool) (xs : list string) (out : list string) : list string =\n        match xs with\n        | a :: rest =>\n            match rest with\n            | b :: rest' => pass rev rest' ((if rev then b ++# a else a ++# b) :: out)\n            | [] => a :: out\n        | [] => out\n    let rec 루프 (rev : bool) (xs : list string) : string =\n        match xs with\n        | [] => \"\"\n        | x :: rest =>\n            match rest with\n            | [] => x\n            | _ => 루프 (not rev) (pass rev xs [])\n    if is_rust () then\n        match acc with\n        | _ :: _ :: _ :: _ =>\n            inl total : i32 = (0i32, acc) ||> listm.fold fun n (x : string) => n + ##x\n            inl buf : $'Rc<RefCell<Vec<u8>>>' = $'Rc::new(RefCell::new(vec\\![0u8; !total as usize]))'\n            inl _ : i32 = (total, acc) ||> listm.fold fun end (x : string) =>\n                inl start = end - ##x\n                $'!buf.borrow_mut()[!start as usize..!end as usize].copy_from_slice(!x.as_bytes())' : ()\n                start\n            $'unsafe { Rc::<str>::from(std::str::from_utf8_unchecked(&!buf.borrow())) }' : string\n        | _ => 루프 true acc\n    else 루프 true acc","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  inl concat_rev (acc : list string) : string =
      let rec pass (rev : bool) (xs : list string) (out : list string) : list string =
          match xs with
          | a :: rest =>
              match rest with
              | b :: rest' => pass rev rest' ((if rev then b ++# a else a ++# b) :: out)
              | [] => a :: out
          | [] => out
      let rec 루프 (rev : bool) (xs : list string) : string =
          match xs with
          | [] => ""
          | x :: rest =>
              match rest with
              | [] => x
              | _ => 루프 (not rev) (pass rev xs [])
      if is_rust () then
          match acc with
          | _ :: _ :: _ :: _ =>
              inl total : i32 = (0i32, acc) ||> listm.fold fun n (x : string) => n + ##x
              inl buf : $'Rc<RefCell<Vec<u8>>>' = $'Rc::new(RefCell::new(vec\![0u8; !total as usize]))'
              inl _ : i32 = (total, acc) ||> listm.fold fun end (x : string) =>
                  inl start = end - ##x
                  $'!buf.borrow_mut()[!start as usize..!end as usize].copy_from_slice(!x.as_bytes())' : ()
                  start
              $'unsafe { Rc::<str>::from(std::str::from_utf8_unchecked(&!buf.borrow())) }' : string
          | _ => 루프 true acc
      else 루프 true acc
  """,
  timeout: 300_000
)
```

