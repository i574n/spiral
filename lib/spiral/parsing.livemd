<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"inl new_lines1 () : parser () = fun t, i, (parser_state s' as s) =>\n    inl i', s'' = s |> advance_newlines t i\n    if i' <> i\n    then Ok ((), i', s'')\n    else\n        fail\n            fun t, i, (parser_state s') =>\n                inl preview_end = i + get_max_context () |> min s'.text_length\n                \"parsing.new_lines1 / expected at least one new line / \"\n                ++#? { rest = t |> slice i preview_end }\n            i s","print_code":false},"livebook_object":"smart_cell"} -->

