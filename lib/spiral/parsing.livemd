### advance_while_no_nl

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"inl advance_while_no_nl (fn : char -> bool) (t : string) (i : int) (parser_state s' as s)\n    : int * parser_state\n    =\n    if i >= s'.text_length\n    then i, s\n    else\n        inl i' = i |> sm'.span_from fn t\n        inl i' =\n            if i' > s'.text_length\n            then s'.text_length\n            else i'\n        inl consumed = i' - i\n        if consumed = 0\n        then i, s\n        else\n            i',\n            { s' with position = { line = s'.position.line; col = s'.position.col + consumed } }\n            |> parser_state","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  inl advance_while_no_nl (fn : char -> bool) (t : string) (i : int) (parser_state s' as s)
      : int * parser_state
      =
      if i >= s'.text_length
      then i, s
      else
          inl i' = i |> sm'.span_from fn t
          inl i' =
              if i' > s'.text_length
              then s'.text_length
              else i'
          inl consumed = i' - i
          if consumed = 0
          then i, s
          else
              i',
              { s' with position = { line = s'.position.line; col = s'.position.col + consumed } }
              |> parser_state
  """,
  timeout: 300_000
)
```

### advance_newlines

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"inl advance_newlines (t : string) (i : int) (parser_state s' as s)\n    : int * parser_state\n    =\n    if i >= s'.text_length\n    then i, s\n    else\n        inl i' = i |> sm'.span_from ((=) '\\n') t\n        inl i' =\n            if i' > s'.text_length\n            then s'.text_length\n            else i'\n        inl consumed = i' - i\n        if consumed = 0\n        then i, s\n        else\n            i',\n            { s' with\n                line_start = i'\n                position = { line = s'.position.line + consumed; col = 1 }\n            }\n            |> parser_state","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  inl advance_newlines (t : string) (i : int) (parser_state s' as s)
      : int * parser_state
      =
      if i >= s'.text_length
      then i, s
      else
          inl i' = i |> sm'.span_from ((=) '\n') t
          inl i' =
              if i' > s'.text_length
              then s'.text_length
              else i'
          inl consumed = i' - i
          if consumed = 0
          then i, s
          else
              i',
              { s' with
                  line_start = i'
                  position = { line = s'.position.line + consumed; col = 1 }
              }
              |> parser_state
  """,
  timeout: 300_000
)
```

### many_chars_till

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"inl many_chars_till (p : parser char) (end_p : parser _) = fun t, i, (parser_state s' as s) =>\n    trace_entry \"parsing.many_chars_till\" fun () => { t_len = ##t; i s }\n    let rec 루프 (i' : int) (s'' : parser_state) : result (string * int * parser_state) parser_error =\n        if i' >= s'.text_length\n        then Ok ((if i' > i then t |> slice i i' else \"\"), i', s'')\n        else\n            inl i'', s''' = s'' |> advance_while_no_nl (fun c => c <> '\\n') t i'\n            if i'' >= s'.text_length\n            then Ok ((if i'' > i then t |> slice i i'' else \"\"), i'', s''')\n            else\n                match end_p (t, i'', s''') with\n                | Ok _ => Ok ((if i'' > i then t |> slice i i'' else \"\"), i'', s''')\n                | Error _ =>\n                    match p (t, i'', s''') with\n                    | Error _ => Ok ((if i'' > i then t |> slice i i'' else \"\"), i'', s''')\n                    | Ok (_, i''', s'''') when i''' > i'' => s'''' |> 루프 i'''\n                    | Ok _ =>\n                        fail (fun _ => \"parsing.many_chars_till / inner parser succeeded without consuming text\") i'' s'''\n    s |> 루프 i","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  inl many_chars_till (p : parser char) (end_p : parser _) = fun t, i, (parser_state s' as s) =>
      trace_entry "parsing.many_chars_till" fun () => { t_len = ##t; i s }
      let rec 루프 (i' : int) (s'' : parser_state) : result (string * int * parser_state) parser_error =
          if i' >= s'.text_length
          then Ok ((if i' > i then t |> slice i i' else ""), i', s'')
          else
              inl i'', s''' = s'' |> advance_while_no_nl (fun c => c <> '\n') t i'
              if i'' >= s'.text_length
              then Ok ((if i'' > i then t |> slice i i'' else ""), i'', s''')
              else
                  match end_p (t, i'', s''') with
                  | Ok _ => Ok ((if i'' > i then t |> slice i i'' else ""), i'', s''')
                  | Error _ =>
                      match p (t, i'', s''') with
                      | Error _ => Ok ((if i'' > i then t |> slice i i'' else ""), i'', s''')
                      | Ok (_, i''', s'''') when i''' > i'' => s'''' |> 루프 i'''
                      | Ok _ =>
                          fail (fun _ => "parsing.many_chars_till / inner parser succeeded without consuming text") i'' s'''
      s |> 루프 i
  """,
  timeout: 300_000
)
```

