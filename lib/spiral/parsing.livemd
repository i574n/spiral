### none_of

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"inl none_of (chars : list char) : parser char = fun t, i, (parser_state s' as s) =>\n    inl chars' () =\n        chars |> listm'.box |> listm'.to_array' |> sm'.format\n    if i >= s'.text_length then\n        fail (fun _, _, s => \"parsing.none_of / unexpected end of text / \" ++#? { chars' = chars' (); s }) i s\n    else\n        inl ch = t |> sm'.index i\n        if chars |> listm'.exists' ((=) ch) |> not\n        then Ok (ch, i + 1, ch |> update_char s)\n        else\n            fail\n                fun t, i, s =>\n                    \"parsing.none_of / unexpected char / \"\n                    ++#? { first_char = t |> sm'.index i; chars' = chars' (); s }\n                i s","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  inl none_of (chars : list char) : parser char = fun t, i, (parser_state s' as s) =>
      inl chars' () =
          chars |> listm'.box |> listm'.to_array' |> sm'.format
      if i >= s'.text_length then
          fail (fun _, _, s => "parsing.none_of / unexpected end of text / " ++#? { chars' = chars' (); s }) i s
      else
          inl ch = t |> sm'.index i
          if chars |> listm'.exists' ((=) ch) |> not
          then Ok (ch, i + 1, ch |> update_char s)
          else
              fail
                  fun t, i, s =>
                      "parsing.none_of / unexpected char / "
                      ++#? { first_char = t |> sm'.index i; chars' = chars' (); s }
                  i s
  """,
  timeout: 300_000
)
```

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"///- --test\n///> gleam\n///> fsharp\n///> cuda\n///> typescript\n\n\"abc\"\n|> run_parser (none_of ['a'; 'b'; 'c'])\n|> resultm.map_error eval\n|> _assert_eq (\n    backend_switch {\n        Gleam = fun () =>\n            \"parsing.none_of / unexpected char / \"\n            ++# \"{ first_char = a; chars' = [\\\"a\\\", \\\"b\\\", \\\"c\\\"]; s = #(0, 1, 1, 3) }\"\n        Lua = fun () =>\n            \"parsing.none_of / unexpected char / \"\n            ++# \"{ first_char = a; chars' = [\\\"a\\\", \\\"b\\\", \\\"c\\\"]; s = #(0, 1, 1, 3) }\"\n        Fsharp = fun () =>\n            join\n                \"parsing.none_of / unexpected char / \"\n                ++# \"{ first_char = a; chars' = [|'a'; 'b'; 'c'|]; s = struct (0, 1, 1, 3) }\"\n        TypeScript = fun () =>\n            join\n                \"parsing.none_of / unexpected char / \"\n                ++# \"{ first_char = a; chars' = ['a', 'b', 'c']; s = { line_start = 0; position = { line = 1; col = 1 }; text_length = 3 } }\"\n        Python = fun () =>\n            \"parsing.none_of / unexpected char / \"\n            ++# \"{ first_char = a; chars' = ['a' 'b' 'c']; s = (0, 1, 1, 3) }\"\n    }\n    |> Error\n)\n\n\"def\"\n|> run_parser (none_of ['a'; 'b'; 'c'])\n|> unwrap_format\n|> _assert_eq #?*('d', \"ef\", new_parser_state 0 1 2 3)","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  ///- --test
  ///> gleam
  ///> fsharp
  ///> cuda
  ///> typescript

  "abc"
  |> run_parser (none_of ['a'; 'b'; 'c'])
  |> resultm.map_error eval
  |> _assert_eq (
      backend_switch {
          Gleam = fun () =>
              "parsing.none_of / unexpected char / "
              ++# "{ first_char = a; chars' = [\"a\", \"b\", \"c\"]; s = #(0, 1, 1, 3) }"
          Lua = fun () =>
              "parsing.none_of / unexpected char / "
              ++# "{ first_char = a; chars' = [\"a\", \"b\", \"c\"]; s = #(0, 1, 1, 3) }"
          Fsharp = fun () =>
              join
                  "parsing.none_of / unexpected char / "
                  ++# "{ first_char = a; chars' = [|'a'; 'b'; 'c'|]; s = struct (0, 1, 1, 3) }"
          TypeScript = fun () =>
              join
                  "parsing.none_of / unexpected char / "
                  ++# "{ first_char = a; chars' = ['a', 'b', 'c']; s = { line_start = 0; position = { line = 1; col = 1 }; text_length = 3 } }"
          Python = fun () =>
              "parsing.none_of / unexpected char / "
              ++# "{ first_char = a; chars' = ['a' 'b' 'c']; s = (0, 1, 1, 3) }"
      }
      |> Error
  )

  "def"
  |> run_parser (none_of ['a'; 'b'; 'c'])
  |> unwrap_format
  |> _assert_eq #?*('d', "ef", new_parser_state 0 1 2 3)
  """,
  timeout: 300_000
)
```

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"///- --test\n///> fsharp\n\n\"abc\"\n|> parse_ (none_of_ ['a'; 'b'; 'c'])\n|> resultm.unwrap_err\n|> sm'.obj_to_string\n|> sm'.replace \"\\r\\n\" \"\\n\"\n|> _assert_eq ($'\"(Error in Ln: 1 Col: 1\\nabc\\n^\\nExpecting: any char not in ‘abc’\\n, Error in Ln: 1 Col: 1\\nExpecting: any char not in ‘abc’\\n)\"')\n\n\"def\"\n|> parse_ (none_of_ ['a'; 'b'; 'c'])\n|> unwrap_format\n|> _assert_eq' #?*('d', ($'FParsec.Position (null, 0, 1, 2)' : position_))","print_code":false},"livebook_object":"smart_cell"} -->

