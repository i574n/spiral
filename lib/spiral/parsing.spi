///> cuda
///> typescript
test none_of_3 =
    "abc"
    |> run_parser (p_char 'a' <|> p_char 'b')
    |> resultm.get
    |> sm'.show
    |> _assert_eq (sm'.show ('a', "bc", new_parser_state 0 1 2 3))

    "cba"
    |> run_parser (p_char 'a' <|> p_char 'b')
    |> resultm.map_error eval
    |> _assert_eq (Error "parsing.p_char / { expected = b; line = 1; col = 1 }\ncba\n^\n")

/// ### (|>>)
inl (|>>) p f : parser _ =
    p >> resultm.map fun r, i', s' =>
        f (fun () => r) (), i', s'

///> gleam
///> fsharp
///> cuda
///> typescript
test none_of_4 =
    "abc"
    |> run_parser (p_char 'a' |>> fun c => fun () => c () |> sm'.char_to_upper)
    |> resultm.get
    |> sm'.show
    |> _assert_eq (sm'.show ('A', "bc", new_parser_state 0 1 2 3))

/// ### many
inl many forall b c.
    (p : _ * _ * _ -> _ (b * _ * _) c)
    : parser (list _)
    =
    fun t, i, s =>
        trace_entry "parsing.many" fun () => { t_len = ##t }
        let rec 루프 (acc : list b) (i' : int) (s' : parser_state)
            : result (list b * int * parser_state) _
            =
            match p (t, i', s') with
            | Error _ => Ok (acc |> listm.rev, i', s')
            | Ok (x, i'', s'') when i'' > i' => s'' |> 루프 (x :: acc) i''
            | Ok _ => fail (fun _ => "parsing.many / inner parser succeeded without consuming text") i' s'
        s |> 루프 [] i

///> gleam
///> fsharp
///> cuda
///> typescript
test many =
    "aaabbc"
    |> run_parser (many (p_char 'a' <|> p_char 'b'))
    |> resultm.get
    |> sm'.show
    |> _assert_eq (sm'.show (['a'; 'a'; 'a'; 'b'; 'b'], "c", new_parser_state 0 1 6 6))

/// ### many1_chars
inl many1_chars (p : parser char) : parser string = fun t, i, s =>
    trace_entry "parsing.many1_chars" fun () => { t_len = ##t; i s }
    match p (t, i, s) with
    | Error e => e |> Error
    | Ok (_, i', s') =>
        let rec 루프 (i'' : int) (s'' : parser_state) : result (string * int * parser_state) _ =
            match p (t, i'', s'') with
            | Error _ => Ok (t |> slice i i'', i'', s'')
            | Ok (_, i''', s''') =>
                if i''' <> i''
                then s''' |> 루프 i'''
                else fail (fun _ => "parsing.many1_chars / inner parser succeeded without consuming text") i'' s''
        s' |> 루프 i'

///> gleam
///> fsharp
///> cuda
///> typescript
test many1_chars =
    "aaabbc"
    |> run_parser (many1_chars (p_char 'a' <|> p_char 'b'))
    |> resultm.get
    |> sm'.show
    |> _assert_eq (sm'.show ("aaabb", "c", new_parser_state 0 1 6 6))

/// ### many1_satisfy
inl many1_satisfy (fn : char -> bool) : parser string = fun t, i, (parser_state s' as s) =>
    let rec 루프 (i' : int) (s'' : parser_state) : int * parser_state =
        if i' >= s'.text_length
        then i', s''
        else
            inl c = t |> sm'.index i'
            if fn c
            then 루프 (i' + 1) (c |> update_char s'')
            else i', s''
    inl i', s'' = 루프 i s
    if i' > i
    then Ok (t |> slice i i', i', s'')
    else
        fail (fun _, i, s => "parsing.many1_satisfy / no matching char / " ++# sm'.show { i s }) i s

/// ### many1_none_of
inl many1_none_of (chars : list char) : parser string =
    many1_satisfy fun c => chars |> listm'.exists' ((=) c) |> not

/// ### many_chars
inl many_chars (p : parser char) : parser string = fun t, i, s =>
    trace_entry "parsing.many_chars" fun () => { t_len = ##t; i s }
    match many1_chars p (t, i, s) with
    | Ok (res, i', s') => Ok (res, i', s')
    | Error _ => Ok ("", i, s)

/// ### advance_while_no_nl
inl advance_while_no_nl (fn : char -> bool) (t : string) (i : int) (parser_state s' as s)
    : int * parser_state
    =
    if i >= s'.text_length
    then i, s
    else
        inl i' = i |> sm'.span_from fn t
        inl i' =
            if i' > s'.text_length
            then s'.text_length
            else i'
        inl consumed = i' - i
        if consumed = 0
        then i, s
        else
            i',
            { s' with position = { line = s'.position.line; col = s'.position.col + consumed } }
            |> parser_state

/// ### advance_newlines
inl advance_newlines (t : string) (i : int) (parser_state s' as s)
    : int * parser_state
    =
    if i >= s'.text_length
    then i, s
    else
        inl i' = i |> sm'.span_from ((=) '\n') t
        inl i' =
            if i' > s'.text_length
            then s'.text_length
            else i'
        inl consumed = i' - i
        if consumed = 0
        then i, s
        else
            i',
            { s' with
                line_start = i'
                position = { line = s'.position.line + consumed; col = 1 }
            }
            |> parser_state

/// ### many_chars_till
inl many_chars_till (p : parser char) (end_p : parser _) = fun t, i, (parser_state s' as s) =>
    trace_entry "parsing.many_chars_till" fun () => { t_len = ##t; i s }
    let rec 루프 (i' : int) (s'' : parser_state) : result (string * int * parser_state) parser_error =
        if i' >= s'.text_length
        then Ok ((if i' > i then t |> slice i i' else ""), i', s'')
        else
            inl i'', s''' = s'' |> advance_while_no_nl (fun c => c <> '\n') t i'
            if i'' >= s'.text_length
            then Ok ((if i'' > i then t |> slice i i'' else ""), i'', s''')
            else
                match end_p (t, i'', s''') with
                | Ok _ => Ok ((if i'' > i then t |> slice i i'' else ""), i'', s''')
                | Error _ =>
                    match p (t, i'', s''') with
                    | Error _ => Ok ((if i'' > i then t |> slice i i'' else ""), i'', s''')
                    | Ok (_, i''', s'''') when i''' > i'' => s'''' |> 루프 i'''
                    | Ok _ =>
                        fail (fun _ => "parsing.many_chars_till / inner parser succeeded without consuming text") i'' s'''
    s |> 루프 i

/// ### many1
inl many1 (p : parser _) : parser (list _) = fun t, i, s =>
    trace_entry "parsing.many1" fun () => { t_len = ##t; i s }
    match p (t, i, s) with
    | Error e => e |> Error
    | Ok (first, i', s') =>
        let rec 루프 acc (i'' : int) s'' : result (list _ * int * parser_state) _ =
            match p (t, i'', s'') with
            | Error _ => Ok (acc |> listm.rev, i'', s'')
            | Ok (x, i''', s''') when i''' > i'' => s''' |> 루프 (x :: acc) i'''
            | Ok _ => fail (fun _ => "parsing.many1 / inner parser succeeded without consuming text") i'' s''
        s' |> 루프 [ first ] i'

///> gleam
///> fsharp
///> cuda
