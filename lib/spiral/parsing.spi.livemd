 char t =\n    x |> $'FParsec.CharParsers.satisfy'\n\n:= none_of_ (x : list char) : parser_ char () =\n    x\n    |> listm'::box\n    |> listm'::to_array'\n    |> $'FParsec.CharParsers.noneOf'\n\n:= any_of_ (x : list char) : parser_ char () =\n    x\n    |> listm'::box\n    |> listm'::to_array'\n    |> $'FParsec.CharParsers.anyOf'\n\n:= skip_any_of_ (x : list char) : parser_ () () =\n    x\n    |> listm'::box\n    |> listm'::to_array'\n    |> $'FParsec.CharParsers.skipAnyOf'\n\n:= between_ \\* t u v x. (a : parser_ t x) (b : parser_ u x) (c : parser_ v x) : parser_ v x =\n    c |> $'FParsec.Primitives.between' a b\n\n:= many_chars_ \\* t. (x : parser_ char t) : parser_ string t =\n    x |> $'FParsec.CharParsers.manyChars'\n\n:= many1_chars_ \\* t. (x : parser_ char t) : parser_ string t =\n    x |> $'FParsec.CharParsers.many1Chars'\n\n:= many_strings_ \\* t. (x : parser_ string t) : parser_ string t =\n    x |> $'FParsec.CharParsers.manyStrings'\n\n:= skip_any_string_ \\* t. (n : int) : parser_ () t =\n    n |> $'FParsec.CharParsers.skipAnyString'\n\n:= many1_strings_ \\* t. (x : parser_ string t) : parser_ string t =\n    x |> $'FParsec.CharParsers.many1Strings'\n\n:= opt_ \\* t u. (a : parser_ t u) : parser_ (optionm'::option' t) u =\n    a |> $'FParsec.Primitives.opt'\n\n:= choice_ \\* t u. (a : list (parser_ t u)) : parser_ t u =\n    a\n    |> listm'::box\n    |> seq::of_list'\n    |> $'FParsec.Primitives.choice'\n\n:= delay_ \\* t u. (fn : () -> parser_ t u) : parser_ t u =\n    fn |> $'FParsec.Primitives.parse.Delay'\n\n:= peek_ \\* t u. (a : parser_ t u) : parser_ char u =\n    $'!a.Peek ()'\n\n:= not_followed_by_ \\* t u. (a : parser_ t u) : parser_ () u =\n    a |> $'FParsec.Primitives.notFollowedBy'\n\n:= sep_by_ \\* t u v. (a : parser_ t v) (b : parser_ u v) : parser_ (listm'::list' t) v =\n    b |> $'FParsec.Primitives.sepBy' a\n\n:= sep_by1_ \\* t u v. (a : parser_ t v) (b : parser_ u v) : parser_ (listm'::list' t) v =\n    b |> $'FParsec.Primitives.sepBy1' a\n\n:= sep_end_by_ \\* t u v. (a : parser_ t v) (b : parser_ u v) : parser_ (listm'::list' t) v =\n    b |> $'FParsec.Primitives.sepEndBy' a\n\n:= many_ \\* t u. (a : parser_ t u) : parser_ (listm'::list' t) u =\n    a |> $'FParsec.Primitives.many'\n\n:= many1_ \\* t u. (a : parser_ t u) : parser_ (listm'::list' t) u =\n    a |> $'FParsec.Primitives.many1'\n\n:= many1_satisfy_ \\* t. (x : char -> bool) : parser_ string t =\n    x |> $'FParsec.CharParsers.many1Satisfy'\n\n:! parser_result'_ t u = $'FParsec.CharParsers.ParserResult<`t, `u>'\n\n:= run_ \\* t. (parser : parser_ t ()) (x : string) : parser_result'_ t () =\n    global \"#r \\\"nuget: FParsec, 2.0.0-beta2\\\"\"\n    x |> $'FParsec.CharParsers.run' parser\n\n:| parser_result_ t u =\n    | Success : t * u * position_\n    | Failure : string * parser_error_ * u\n\n:= parser_result_ \\* t u. = \\|\n    | Success (a, b, c) => $'`(parser_result'_ t u).Success (!a, !b, !c)' : parser_result'_ t u\n    | Failure (a, b, c) => $'`(parser_result'_ t u).Failure (!a, !b, !c)' : parser_result'_ t u\n\n:= parser_result'_ \\* t u. (x : parser_result'_ t u) : parser_result_ t u =\n    $'let mutable _!x = None '\n    $'match !x with'\n    $'| FParsec.CharParsers.Success (a, b, c) -> (' : ()\n    $'(fun () ->'\n    $'(fun () ->'\n    (Success ((dyn $'a'), dyn $'b', dyn $'c') : _ t u) |> emit_unit\n    $')'\n    $'|> fun x -> x ()'\n    $') () ) | FParsec.CharParsers.Failure (a, b, c) -> (' : ()\n    $'(fun () ->'\n    $'(fun () ->'\n    (Failure ((dyn $'a'), dyn $'b', dyn $'c') : _ t u) |> emit_unit\n    $')'\n    $'|> fun x -> x ()'\n    $') () )' : ()\n    $'|> fun x -> _!x <- Some x'\n    $'match _!x with Some x -> x | None -> failwith \"??? / _!x=None\"'\n\n:= parse_ parser input : result _ _ =\n    ?= input |> run_ parser |> parser_result'_ ?|\n    | Success (result, b, c) => Ok (result, c)\n    | Failure (error_msg, b, c) => Error (error_msg, b)","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  ///- --test static --symbol

  :! position_ = $'FParsec.Position'
  :! parser_error_ = $'FParsec.Error.ParserError'

  :! reply_ t = $'FParsec.Reply<`t>'

  :! char_stream_ t = $'FParsec.CharStream<`t>'

  :! parser_ t u = $'FParsec.Primitives.Parser<`t, `u>'

  := p_char_ \* t. (x : char) : parser_ char t =
      x |> $'FParsec.CharParsers.pchar'

  := p_string_ \* t. (x : string) : parser_ string t =
      x |> $'FParsec.CharParsers.pstring'

  := (>>.$) \* t u v. (a : parser_ t v) (b : parser_ u v) : parser_ u v =
      b |> $'FParsec.Primitives.(>>.)' a

  := (.>>$) \* t u v. (a : parser_ t v) (b : parser_ u v) : parser_ t v =
      b |> $'FParsec.Primitives.(.>>)' a

  := (.>>.$) \* t u v. (a : parser_ t v) (b : parser_ u v) : parser_ (pair t u) v =
      b |> $'FParsec.Primitives.(.>>.)' a

  := (>>%$) \* t u v. (a : parser_ t v) (b : u) : parser_ u v =
      b |> $'FParsec.Primitives.(>>%)' a

  := (>>=$) \* t u v. (a : parser_ t v) (b : t -> parser_ u v) : parser_ u v =
      b |> $'FParsec.Primitives.(>>=)' a

  := (|>>$) \* t u v. (a : parser_ t v) (b : t -> u) : parser_ u v =
      := b = \ x => x |> b
      b |> $'FParsec.Primitives.(|>>)' a

  := any_char_ () : parser_ char _ =
      $'FParsec.CharParsers.anyChar'

  := any_string_ () : parser_ string _ =
      $'FParsec.CharParsers.anyString'

  := any_string__ (n : int) : parser_ string _ =
      n |> $'FParsec.CharParsers.anyString'

  := eof_ () : parser_ () _ =
      $'FParsec.CharParsers.eof'

  := spaces_ () : parser_ () () =
      $'FParsec.CharParsers.spaces'

  := spaces1_ () : parser_ () () =
      $'FParsec.CharParsers.spaces1'

  := (<|>$) \* t u. (a : parser_ t u) (b : parser_ t u) : parser_ t u =
      b |> $'FParsec.Primitives.(<|>)' a

  := many_satisfy_ \* t. (x : char -> bool) : parser_ string t =
      x |> $'FParsec.CharParsers.manySatisfy'

  := satisfy_ \* t. (x : char -> bool) : parser_ char t =
      x |> $'FParsec.CharParsers.satisfy'

  := none_of_ (x : list char) : parser_ char () =
      x
      |> listm'::box
      |> listm'::to_array'
      |> $'FParsec.CharParsers.noneOf'

  := any_of_ (x : list char) : parser_ char () =
      x
      |> listm'::box
      |> listm'::to_array'
      |> $'FParsec.CharParsers.anyOf'

  := skip_any_of_ (x : list char) : parser_ () () =
      x
      |> listm'::box
      |> listm'::to_array'
      |> $'FParsec.CharParsers.skipAnyOf'

  := between_ \* t u v x. (a : parser_ t x) (b : parser_ u x) (c : parser_ v x) : parser_ v x =
      c |> $'FParsec.Primitives.between' a b

  := many_chars_ \* t. (x : parser_ char t) : parser_ string t =
      x |> $'FParsec.CharParsers.manyChars'

  := many1_chars_ \* t. (x : parser_ char t) : parser_ string t =
      x |> $'FParsec.CharParsers.many1Chars'

  := many_strings_ \* t. (x : parser_ string t) : parser_ string t =
      x |> $'FParsec.CharParsers.manyStrings'

  := skip_any_string_ \* t. (n : int) : parser_ () t =
      n |> $'FParsec.CharParsers.skipAnyString'

  := many1_strings_ \* t. (x : parser_ string t) : parser_ string t =
      x |> $'FParsec.CharParsers.many1Strings'

  := opt_ \* t u. (a : parser_ t u) : parser_ (optionm'::option' t) u =
      a |> $'FParsec.Primitives.opt'

  := choice_ \* t u. (a : list (parser_ t u)) : parser_ t u =
      a
      |> listm'::box
      |> seq::of_list'
      |> $'FParsec.Primitives.choice'

  := delay_ \* t u. (fn : () -> parser_ t u) : parser_ t u =
      fn |> $'FParsec.Primitives.parse.Delay'

  := peek_ \* t u. (a : parser_ t u) : parser_ char u =
      $'!a.Peek ()'

  := not_followed_by_ \* t u. (a : parser_ t u) : parser_ () u =
      a |> $'FParsec.Primitives.notFollowedBy'

  := sep_by_ \* t u v. (a : parser_ t v) (b : parser_ u v) : parser_ (listm'::list' t) v =
      b |> $'FParsec.Primitives.sepBy' a

  := sep_by1_ \* t u v. (a : parser_ t v) (b : parser_ u v) : parser_ (listm'::list' t) v =
      b |> $'FParsec.Primitives.sepBy1' a

  := sep_end_by_ \* t u v. (a : parser_ t v) (b : parser_ u v) : parser_ (listm'::list' t) v =
      b |> $'FParsec.Primitives.sepEndBy' a

  := many_ \* t u. (a : parser_ t u) : parser_ (listm'::list' t) u =
      a |> $'FParsec.Primitives.many'

  := many1_ \* t u. (a : parser_ t u) : parser_ (listm'::list' t) u =
      a |> $'FParsec.Primitives.many1'

  := many1_satisfy_ \* t. (x : char -> bool) : parser_ string t =
      x |> $'FParsec.CharParsers.many1Satisfy'

  :! parser_result'_ t u = $'FParsec.CharParsers.ParserResult<`t, `u>'

  := run_ \* t. (parser : parser_ t ()) (x : string) : parser_result'_ t () =
      global "#r \"nuget: FParsec, 2.0.0-beta2\""
      x |> $'FParsec.CharParsers.run' parser

  :| parser_result_ t u =
      | Success : t * u * position_
      | Failure : string * parser_error_ * u

  := parser_result_ \* t u. = \|
      | Success (a, b, c) => $'`(parser_result'_ t u).Success (!a, !b, !c)' : parser_result'_ t u
      | Failure (a, b, c) => $'`(parser_result'_ t u).Failure (!a, !b, !c)' : parser_result'_ t u

  := parser_result'_ \* t u. (x : parser_result'_ t u) : parser_result_ t u =
      $'let mutable _!x = None '
      $'match !x with'
      $'| FParsec.CharParsers.Success (a, b, c) -> (' : ()
      $'(fun () ->'
      $'(fun () ->'
      (Success ((dyn $'a'), dyn $'b', dyn $'c') : _ t u) |> emit_unit
      $')'
      $'|> fun x -> x ()'
      $') () ) | FParsec.CharParsers.Failure (a, b, c) -> (' : ()
      $'(fun () ->'
      $'(fun () ->'
      (Failure ((dyn $'a'), dyn $'b', dyn $'c') : _ t u) |> emit_unit
      $')'
      $'|> fun x -> x ()'
      $') () )' : ()
      $'|> fun x -> _!x <- Some x'
      $'match _!x with Some x -> x | None -> failwith "??? / _!x=None"'

  := parse_ parser input : result _ _ =
      ?= input |> run_ parser |> parser_result'_ ?|
      | Success (result, b, c) => Ok (result, c)
      | Failure (error_msg, b, c) => Error (error_msg, b)
  """,
  timeout: 300_000
)
```

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":"///- --test --symbol\n///> fsharp\n\n:= split_args (args : string) : result (array_base (string * position_)) (string * parser_error_) =\n    := esc = [ '\\\\'; '`' ]\n    := quotes = [ '\"' ]\n    := special = esc ++ quotes\n    := p_esc_char c =\n        p_char_ c >>.$ any_char_ () |>>$ \\ c' => $'$\"{!c}{!c'}\"'\n    := p_word = special |> none_of_ |>>$ sm'::obj_to_string\n    := p_plain = special ++ [ ' ' ] |> none_of_ |> many1_chars_\n    := p_text = p_word |> many1_strings_\n    := p_esc = esc |> listm::map p_esc_char |> choice_\n    := p_quoted = (p_word <|>$ p_esc) |> many_ |>>$ (seq::of_list' >> sm'::concat \"\")\n    := p_quoted_all = p_quoted |> between_ (p_char_ '\"') (p_char_ '\"')\n    := p_esc_root = (p_esc |>>$ (\\ _ => \"\")) >>.$ (p_word |> many_) |>>$ (seq::of_list' >> sm'::concat \"\")\n    := p_content = p_plain <|>$ p_quoted_all <|>$ p_esc_root\n    := p_args = spaces1_ () |> sep_by_ p_content\n    args\n    |> parse_ p_args\n    |> resultm::map \\ (a', b') =>\n        (\n            (\n                a'\n                |> listm'::to_array'\n                |> array\n                |> arraym::map \\ x => x, b'\n                |> \\ (array x : array _) => x\n            )\n        )\n\n[\n    \"a b c\",\n    ;[ \"a\"; \"b\"; \"c\" ]\n\n    \"e f \\\"g h\\\" i\",\n    ;[ \"e\"; \"f\"; \"g h\"; \"i\" ]\n\n    \"\\\"j k\\\" \\\"l\\\" \\\"m\\\"\",\n    ;[ \"j k\"; \"l\"; \"m\" ]\n\n    \"s -t \\\"u \\`\\\"v\\`\\\" w\\\"\",\n    ;[ \"s\"; \"-t\"; \"u \\`\\\"v\\`\\\" w\" ]\n\n    \"n -o \\\"p \\\\\\\"q\\\\\\\" r\\\"\",\n    ;[ \"n\"; \"-o\"; \"p \\\\\\\"q\\\\\\\" r\" ]\n\n    \"r -s \\\"t \\\\\\\"u\\\\\\\"\\\"\",\n    ;[ \"r\"; \"-s\"; \"t \\\\\\\"u\\\\\\\"\" ]\n\n    $'$\"x -y \\\\\\\"$z -a \\'(b=\\\\\\\\\\\\\"c-id=)[a-fA-F0-9]{{8}}\\', {{ \\`$_[1] + \\`$d++ }}\\\\\\\"\"',\n    ;[ \"x\"; \"-y\"; \"$z -a '(b=\\\\\\\"c-id=)[a-fA-F0-9]{8}', { `$_[1] + `$d++ }\" ]\n\n    \"e -f \\\"$g -h '(i=`\\\"j-id=)[a-fA-F0-9]{8}', { `$_[1] + `$k++ }\\\"\",\n    ;[ \"e\"; \"-f\"; \"$g -h '(i=`\\\"j-id=)[a-fA-F0-9]{8}', { `$_[1] + `$k++ }\" ]\n\n    $'$\"--l \\\\\\\\\\\\\"\\'\\'\\' m \\'\\'\\'\\\\\\\\\\\\\" \"',\n    ;[ \"--l\"; \"''' m '''\" ]\n\n    $'$\"n --o --p q --r \\\\\\\"s:/t u/v.w\\\\\\\" --x \\\\\\\"y:/z.a\\\\\\\" --b c.d \\\\\\\"\\\\\\\\e{{f-g}}\\\\\\\" h.i \\\\\\\"j (k)\\\\\\\"\"',\n    ;[ \"n\"; \"--o\"; \"--p\"; \"q\"; \"--r\"; \"s:/t u/v.w\"; \"--x\"; \"y:/z.a\"; \"--b\"; \"c.d\"; \"\\\\e{f-g}\"; \"h.i\"; \"j (k)\" ]\n\n    $'@@$\"l \"\"m n:\\\\o.p\"\"\"',\n    ;[ \"l\"; \"m n:\\\\o.p\" ]\n]\n|> listm::rev\n|> listm::map \\ input, expected =>\n    input\n    |> split_args\n    |> \\ x =>\n        try\n            \\ () =>\n                ($'$\"\\ninput: {!input}\"' : string)\n                |> console::write_line\n                x\n                |> resultm::get\n                |> am'::map_base fst\n                |> _assert_eq' (am'::base expected)\n                !-\n            \\ ex =>\n                ($'$\"error / expected: %A{!expected} / ex: %A{!ex}\"' : string)\n                |> console::write_line\n                Some !+\n        |> optionm::value\n|> listm'::filter id\n|> \\|\n    | [] => ()\n    | x => failwith $'$\"{!x}\"'","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  "///- --test --symbol\n///> fsharp\n\n:= split_args (args : string) : result (array_base (string * position_)) (string * parser_error_) =\n    := esc = [ '\\\\'; '`' ]\n    := quotes = [ '\"' ]\n    := special = esc ++ quotes\n    := p_esc_char c =\n        p_char_ c >>.$ any_char_ () |>>$ \\ c' => $'$\"{!c}{!c'}\"'\n    := p_word = special |> none_of_ |>>$ sm'::obj_to_string\n    := p_plain = special ++ [ ' ' ] |> none_of_ |> many1_chars_\n    := p_text = p_word |> many1_strings_\n    := p_esc = esc |> listm::map p_esc_char |> choice_\n    := p_quoted = (p_word <|>$ p_esc) |> many_ |>>$ (seq::of_list' >> sm'::concat \"\")\n    := p_quoted_all = p_quoted |> between_ (p_char_ '\"') (p_char_ '\"')\n    := p_esc_root = (p_esc |>>$ (\\ _ => \"\")) >>.$ (p_word |> many_) |>>$ (seq::of_list' >> sm'::concat \"\")\n    := p_content = p_plain <|>$ p_quoted_all <|>$ p_esc_root\n    := p_args = spaces1_ () |> sep_by_ p_content\n    args\n    |> parse_ p_args\n    |> resultm::map \\ (a', b') =>\n        (\n            (\n                a'\n                |> listm'::to_array'\n                |> array\n                |> arraym::map \\ x => x, b'\n                |> \\ (array x : array _) => x\n            )\n        )\n\n[\n    \"a b c\",\n    ;[ \"a\"; \"b\"; \"c\" ]\n\n    \"e f \\\"g h\\\" i\",\n    ;[ \"e\"; \"f\"; \"g h\"; \"i\" ]\n\n    \"\\\"j k\\\" \\\"l\\\" \\\"m\\\"\",\n    ;[ \"j k\"; \"l\"; \"m\" ]\n\n    \"s -t \\\"u \\`\\\"v\\`\\\" w\\\"\",\n    ;[ \"s\"; \"-t\"; \"u \\`\\\"v\\`\\\" w\" ]\n\n    \"n -o \\\"p \\\\\\\"q\\\\\\\" r\\\"\",\n    ;[ \"n\"; \"-o\"; \"p \\\\\\\"q\\\\\\\" r\" ]\n\n    \"r -s \\\"t \\\\\\\"u\\\\\\\"\\\"\",\n    ;[ \"r\"; \"-s\"; \"t \\\\\\\"u\\\\\\\"\" ]\n\n    $'$\"x -y \\\\\\\"$z -a \\'(b=\\\\\\\\\\\\\"c-id=)[a-fA-F0-9]{{8}}\\', {{ \\`$_[1] + \\`$d++ }}\\\\\\\"\"',\n    ;[ \"x\"; \"-y\"; \"$z -a '(b=\\\\\\\"c-id=)[a-fA-F0-9]{8}', { `$_[1] + `$d++ }\" ]\n\n    \"e -f \\\"$g -h '(i=`\\\"j-id=)[a-fA-F0-9]{8}', { `$_[1] + `$k++ }\\\"\",\n    ;[ \"e\"; \"-f\"; \"$g -h '(i=`\\\"j-id=)[a-fA-F0-9]{8}', { `$_[1] + `$k++ }\" ]\n\n    $'$\"--l \\\\\\\\\\\\\"\\'\\'\\' m \\'\\'\\'\\\\\\\\\\\\\" \"',\n    ;[ \"--l\"; \"''' m '''\" ]\n\n    $'$\"n --o --p q --r \\\\\\\"s:/t u/v.w\\\\\\\" --x \\\\\\\"y:/z.a\\\\\\\" --b c.d \\\\\\\"\\\\\\\\e{{f-g}}\\\\\\\" h.i \\\\\\\"j (k)\\\\\\\"\"',\n    ;[ \"n\"; \"--o\"; \"--p\"; \"q\"; \"--r\"; \"s:/t u/v.w\"; \"--x\"; \"y:/z.a\"; \"--b\"; \"c.d\"; \"\\\\e{f-g}\"; \"h.i\"; \"j (k)\" ]\n\n    $'@@$\"l \"\"m n:\\\\o.p\"\"\"',\n    ;[ \"l\"; \"m n:\\\\o.p\" ]\n]\n|> listm::rev\n|> listm::map \\ input, expected =>\n    input\n    |> split_args\n    |> \\ x =>\n        try\n            \\ () =>\n                ($'$\"\\ninput: {!input}\"' : string)\n                |> console::write_line\n                x\n                |> resultm::get\n                |> am'::map_base fst\n                |> _assert_eq' (am'::base expected)\n                !-\n            \\ ex =>\n                ($'$\"error / expected: %A{!expected} / ex: %A{!ex}\"' : string)\n                |> console::write_line\n                Some !+\n        |> optionm::value\n|> listm'::filter id\n|> \\|\n    | [] => ()\n    | x => failwith $'$\"{!x}\"'",
  timeout: 300_000
)
```

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":":== range =\n    {\n        from : int\n        to : int\n    }\n\n:== position =\n    {\n        line : int\n        col : int\n    }\n\n:! parser_state =\n    {\n        line_start : int\n        position : position\n        text_length : int\n    }\n\n:= new_parser_state (line_start : i32) (line : i32) (col : i32) (text_length : i32) =\n    { line_start position = { line col }; text_length }\n\n:= new_parser_state' text_length =\n    new_parser_state 0 1 1 text_length |> parser_state\n\n:== parser_error =\n    {\n        format : string * int * parser_state -> string\n        i : int\n        s : parser_state\n    }\n\n:== parser t = string * int * parser_state -> result (t * int * parser_state) parser_error\n\n:= fail (format : string * int * parser_state -> string) (i : int) (s : parser_state) : result _ parser_error =\n    Error { format i s }\n\n:= error_message (t : string) (e : parser_error) : string =\n    e::format (t, e::i, e::s)\n\n:= trace_entry_enabled () =\n    !-\n\n:= trace_entry (name : string) (locals : () -> _) : () =\n    ? trace_entry_enabled () ?>\n        := name = dyn name\n        := locals : () -> string = dyn \\ () => locals () |> sm'::format\n        ~~ trace Verbose (\\ () => name) locals\n\n:= slice (start : int) (end : int) (t : string) : string =\n    := t = dyn t\n    ? start >= end ?> \"\"\n    |:\n        t\n        |> sm'::range (am'::Start start) (am'::End \\ _ => end)\n\n:= parse \\* t.\n    (p : parser t)\n    (t : string)\n    (s : parser_state)\n    : result ((() -> t) * (() -> string) * parser_state) (() -> string)\n    =\n    p (t, 0, s)\n    |> resultm::map \\ result, i, (parser_state s' &= s) =>\n        (\\ () => result),\n        (\\ () => t |> slice i s'::text_length),\n        s\n    |> resultm::map_error \\ e =>\n        \\ () => e |> error_message t\n\n:= update_char (parser_state s) (c : char) : parser_state =\n    ?= c ?|\n    | '\\n' =>\n        { s ?|\n            line_start = s::line_start + s::position::col\n            position = { line = s::position::line + 1; col = 1 }\n        }\n    | _ =>\n        { s ?|\n            position = { line = s::position::line; col = s::position::col + 1 }\n        }\n    |> parser_state\n\n:= update_span (t : string) (i : int) (len : int) (parser_state s' &= s) : parser_state =\n    := endi = i + len\n    :~ ^ 루프 (i' : int) (last_nl : int) (count : int) =\n        ? i' >= endi\n        ?> last_nl, count\n        |:\n            ?= t |> sm'::index i' ?|\n            | '\\n' => 루프 (i' + 1) i' (count + 1)\n            | _ => 루프 (i' + 1) last_nl count\n    := last_nl, n = 루프 i -1 0\n    ? n = 0\n    ?> { s' ?| position = { line = s'::position::line; col = s'::position::col + len } }\n    |:\n        { s' ?|\n            line_start = last_nl + 1\n            position =\n                {\n                    line = s'::position::line + n\n                    col = endi - last_nl\n                }\n            text_length = s'::text_length\n        }\n    |> parser_state\n\n:= update t s =\n    s\n    |> update_span t 0 ##t\n\n:= advance_while (fn : char -> bool) (t : string) (i : int) (parser_state s' &= s)\n    : int * parser_state\n    =\n    ? i >= s'::text_length\n    ?> i, s\n    |:\n        := i' = i |> sm'::span_from fn t\n        := i' =\n            ? i' > s'::text_length\n            ?> s'::text_length\n            |: i'\n        := consumed = i' - i\n        ? consumed = 0\n        ?> i, s\n        |: i', s |> update_span t i consumed\n\n:= run_parser p t =\n    ?= p (t, 0, ##t |> new_parser_state') ?|\n    | Ok (result, i, (parser_state s' &= s)) => Ok (result, t |> slice i s'::text_length, s)\n    | Error e => (\\ () => e |> error_message t) |> Error\n\n:= any_char () : parser char = \\ t, i, (parser_state s' &= s) =>\n    ? i >= s'::text_length ?>\n        fail (\\ _, _, s => \"parsing.any_char / unexpected end of t / \" ++# sm'::show { s }) i s\n    |:\n        := c = t |> sm'::index i\n        Ok (c, i + 1, c |> update_char s)","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  :== range =
      {
          from : int
          to : int
      }

  :== position =
      {
          line : int
          col : int
      }

  :! parser_state =
      {
          line_start : int
          position : position
          text_length : int
      }

  := new_parser_state (line_start : i32) (line : i32) (col : i32) (text_length : i32) =
      { line_start position = { line col }; text_length }

  := new_parser_state' text_length =
      new_parser_state 0 1 1 text_length |> parser_state

  :== parser_error =
      {
          format : string * int * parser_state -> string
          i : int
          s : parser_state
      }

  :== parser t = string * int * parser_state -> result (t * int * parser_state) parser_error

  := fail (format : string * int * parser_state -> string) (i : int) (s : parser_state) : result _ parser_error =
      Error { format i s }

  := error_message (t : string) (e : parser_error) : string =
      e::format (t, e::i, e::s)

  := trace_entry_enabled () =
      !-

  := trace_entry (name : string) (locals : () -> _) : () =
      ? trace_entry_enabled () ?>
          := name = dyn name
          := locals : () -> string = dyn \ () => locals () |> sm'::format
          ~~ trace Verbose (\ () => name) locals

  := slice (start : int) (end : int) (t : string) : string =
      := t = dyn t
      ? start >= end ?> ""
      |:
          t
          |> sm'::range (am'::Start start) (am'::End \ _ => end)

  := parse \* t.
      (p : parser t)
      (t : string)
      (s : parser_state)
      : result ((() -> t) * (() -> string) * parser_state) (() -> string)
      =
      p (t, 0, s)
      |> resultm::map \ result, i, (parser_state s' &= s) =>
          (\ () => result),
          (\ () => t |> slice i s'::text_length),
          s
      |> resultm::map_error \ e =>
          \ () => e |> error_message t

  := update_char (parser_state s) (c : char) : parser_state =
      ?= c ?|
      | '\n' =>
          { s ?|
              line_start = s::line_start + s::position::col
              position = { line = s::position::line + 1; col = 1 }
          }
      | _ =>
          { s ?|
              position = { line = s::position::line; col = s::position::col + 1 }
          }
      |> parser_state

  := update_span (t : string) (i : int) (len : int) (parser_state s' &= s) : parser_state =
      := endi = i + len
      :~ ^ 루프 (i' : int) (last_nl : int) (count : int) =
          ? i' >= endi
          ?> last_nl, count
          |:
              ?= t |> sm'::index i' ?|
              | '\n' => 루프 (i' + 1) i' (count + 1)
              | _ => 루프 (i' + 1) last_nl count
      := last_nl, n = 루프 i -1 0
      ? n = 0
      ?> { s' ?| position = { line = s'::position::line; col = s'::position::col + len } }
      |:
          { s' ?|
              line_start = last_nl + 1
              position =
                  {
                      line = s'::position::line + n
                      col = endi - last_nl
                  }
              text_length = s'::text_length
          }
      |> parser_state

  := update t s =
      s
      |> update_span t 0 ##t

  := advance_while (fn : char -> bool) (t : string) (i : int) (parser_state s' &= s)
      : int * parser_state
      =
      ? i >= s'::text_length
      ?> i, s
      |:
          := i' = i |> sm'::span_from fn t
          := i' =
              ? i' > s'::text_length
              ?> s'::text_length
              |: i'
          := consumed = i' - i
          ? consumed = 0
          ?> i, s
          |: i', s |> update_span t i consumed

  := run_parser p t =
      ?= p (t, 0, ##t |> new_parser_state') ?|
      | Ok (result, i, (parser_state s' &= s)) => Ok (result, t |> slice i s'::text_length, s)
      | Error e => (\ () => e |> error_message t) |> Error

  := any_char () : parser char = \ t, i, (parser_state s' &= s) =>
      ? i >= s'::text_length ?>
          fail (\ _, _, s => "parsing.any_char / unexpected end of t / " ++# sm'::show { s }) i s
      |:
          := c = t |> sm'::index i
          Ok (c, i + 1, c |> update_char s)
  """,
  timeout: 300_000
)
```

