  |> run_parser (none_of [ 'a'; 'b'; 'c' ])
  |> resultm::map_error eval
  |> _assert_eq (
      "parsing.none_of / unexpected char / "
      ++# (
          "{ first_char = a; chars' = [a, b, c]; s = { line_start = 0; position = { line = 1; col = 1 }; "
          ^^ "text_length = 3 } }"
      )
      |> Error
  )

  "def"
  |> run_parser (none_of [ 'a'; 'b'; 'c' ])
  |> resultm::get
  |> sm'::show
  |> _assert_eq (sm'::show ('d', "ef", new_parser_state 0 1 2 3))
  """,
  timeout: 300_000
)
```

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":"///- --test --symbol\n///> fsharp\n\n\"abc\"\n|> parse_ (none_of_ [ 'a'; 'b'; 'c' ])\n|> resultm::unwrap_err\n|> sm'::obj_to_string\n|> sm'::replace \"\\r\\n\" \"\\n\"\n|> _assert_eq ($'\"(Error in Ln: 1 Col: 1\\nabc\\n^\\nExpecting: any char not in ‘abc’\\n, Error in Ln: 1 Col: \\\n    1\\nExpecting: any char not in ‘abc’\\n)\"')\n\n\"def\"\n|> parse_ (none_of_ [ 'a'; 'b'; 'c' ])\n|> unwrap_format\n|> _assert_eq' #?*('d', ($'FParsec.Position (null, 0, 1, 2)' : position_))","print_code":false},"livebook_object":"smart_cell"} -->

