```elixir
Spiral.Cells.eval!(
  ~S"""
  := new_line () : parser char = \ t, i, (parser_state s' &= s) =>
      ? i >= s'::text_length ?>
          fail (\ _, _, s => "parsing.new_line / unexpected end of text / " ++# sm'::show { s }) i s
      |:
          := c = t |> sm'::index i
          ? c = '\n'
          ?> Ok (c, i + 1, c |> update_char s)
          |:
              fail
                  \ t, i, (parser_state s' &= s) =>
                      := preview_end = (i + get_max_context ()) |> min s'::text_length
                      := rest = t |> slice i preview_end
                      "parsing.new_line / expected new line char / "
                      ++# sm'::show { first_char = t |> sm'::index i; rest s }
                  i s
  """,
  timeout: 300_000
)
