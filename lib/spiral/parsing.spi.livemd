<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":":= get_max_context () =\n    80\n\n:= p_char (c : char) : parser char =\n    \\ t, i, (parser_state ({ line_start position = { line col } } &= s') &= s) =>\n        ? i >= s'::text_length ?>\n            fail (\\ _, _, (parser_state s') => \"parsing.p_char / unexpected end of text / \" ++# sm'::show { c s' }) i s\n        |:\n            := got = t |> sm'::index i\n            ? got = c\n            ?> Ok (c, i + 1, got |> update_char s)\n            |:\n                fail\n                    \\ t, i, (parser_state { line_start position = { line col } }) =>\n                        := line_end = i |> sm'::span_from ((<>) '\\n') t\n                        := end = (i + get_max_context ()) |> min line_end\n                        := line_slice = t |> slice line_start end\n                        := new_line =\n                            := len = ##line_slice\n                            ? len > 0 && (line_slice |> sm'::index (len - 1)) = '\\n' ?> \"\" |: \"\\n\"\n                        := pointer_line = (\" \" |> sm'::replicate (col - 1)) ++# \"^\"\n                        \"parsing.p_char / \"\n                        ++# sm'::show { expected = c; line col }\n                        ++# \"\\n\" ++# line_slice\n                        ++# new_line\n                        ++# pointer_line ++# \"\\n\"\n                    i s","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  := get_max_context () =
      80

  := p_char (c : char) : parser char =
      \ t, i, (parser_state ({ line_start position = { line col } } &= s') &= s) =>
          ? i >= s'::text_length ?>
              fail (\ _, _, (parser_state s') => "parsing.p_char / unexpected end of text / " ++# sm'::show { c s' }) i s
          |:
              := got = t |> sm'::index i
              ? got = c
              ?> Ok (c, i + 1, got |> update_char s)
              |:
                  fail
                      \ t, i, (parser_state { line_start position = { line col } }) =>
                          := line_end = i |> sm'::span_from ((<>) '\n') t
                          := end = (i + get_max_context ()) |> min line_end
                          := line_slice = t |> slice line_start end
                          := new_line =
                              := len = ##line_slice
                              ? len > 0 && (line_slice |> sm'::index (len - 1)) = '\n' ?> "" |: "\n"
                          := pointer_line = (" " |> sm'::replicate (col - 1)) ++# "^"
                          "parsing.p_char / "
                          ++# sm'::show { expected = c; line col }
                          ++# "\n" ++# line_slice
                          ++# new_line
                          ++# pointer_line ++# "\n"
                      i s
  """,
  timeout: 300_000
)
```

