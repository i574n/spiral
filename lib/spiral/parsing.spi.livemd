<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":":= many1_chars (p : parser char) : parser string = \\ t, i, s =>\n    trace_entry \"parsing.many1_chars\" \\ () => { t_len = ##t; i s }\n    ?= p (t, i, s) ?|\n    | Error e => e |> Error\n    | Ok (_, i', s') =>\n        :~ ^ 루프 (i'' : int) (s'' : parser_state) : result (string * int * parser_state) _ =\n            ?= p (t, i'', s'') ?|\n            | Error _ => Ok (t |> slice i i'', i'', s'')\n            | Ok (_, i''', s''') =>\n                ? i''' <> i''\n                ?> s''' |> 루프 i'''\n                |: fail (\\ _ => \"parsing.many1_chars / inner parser succeeded without consuming text\") i'' s''\n        s' |> 루프 i'","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  := many1_chars (p : parser char) : parser string = \ t, i, s =>
      trace_entry "parsing.many1_chars" \ () => { t_len = ##t; i s }
      ?= p (t, i, s) ?|
      | Error e => e |> Error
      | Ok (_, i', s') =>
          :~ ^ 루프 (i'' : int) (s'' : parser_state) : result (string * int * parser_state) _ =
              ?= p (t, i'', s'') ?|
              | Error _ => Ok (t |> slice i i'', i'', s'')
              | Ok (_, i''', s''') =>
                  ? i''' <> i''
                  ?> s''' |> 루프 i'''
                  |: fail (\ _ => "parsing.many1_chars / inner parser succeeded without consuming text") i'' s''
          s' |> 루프 i'
  """,
  timeout: 300_000
)
```

#### many1_chars (test)

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":"///- --test --symbol\n///> gleam\n///> fsharp\n///> cuda\n///> typescript\n\n\"aaabbc\"\n|> run_parser (many1_chars (p_char 'a' <|> p_char 'b'))\n|> resultm::get\n|> sm'::show\n|> _assert_eq (sm'::show (\"aaabb\", \"c\", new_parser_state 0 1 6 6))","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  ///- --test --symbol
  ///> gleam
  ///> fsharp
  ///> cuda
  ///> typescript

  "aaabbc"
  |> run_parser (many1_chars (p_char 'a' <|> p_char 'b'))
  |> resultm::get
  |> sm'::show
  |> _assert_eq (sm'::show ("aaabb", "c", new_parser_state 0 1 6 6))
  """,
  timeout: 300_000
)
```

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":":= many1_satisfy (fn : char -> bool) : parser string = \\ t, i, (parser_state s' &= s) =>\n    :~ ^ 루프 (i' : int) (s'' : parser_state) : int * parser_state =\n        ? i' >= s'::text_length\n        ?> i', s''\n        |:\n            := c = t |> sm'::index i'\n            ? fn c\n            ?> 루프 (i' + 1) (c |> update_char s'')\n            |: i', s''\n    := i', s'' = 루프 i s\n    ? i' > i\n    ?> Ok (t |> slice i i', i', s'')\n    |:\n        fail (\\ _, i, s => \"parsing.many1_satisfy / no matching char / \" ++# sm'::show { i s }) i s\n\n:= many1_none_of (chars : list char) : parser string =\n    many1_satisfy \\ c => chars |> listm'::exists' ((=) c) |> not\n\n:= many_chars (p : parser char) : parser string = \\ t, i, s =>\n    trace_entry \"parsing.many_chars\" \\ () => { t_len = ##t; i s }\n    ?= many1_chars p (t, i, s) ?|\n    | Ok (res, i', s') => Ok (res, i', s')\n    | Error _ => Ok (\"\", i, s)\n\n:= advance_while_no_nl (fn : char -> bool) (t : string) (i : int) (parser_state s' &= s)\n    : int * parser_state\n    =\n    ? i >= s'::text_length\n    ?> i, s\n    |:\n        := i' = i |> sm'::span_from fn t\n        := i' =\n            ? i' > s'::text_length\n            ?> s'::text_length\n            |: i'\n        := consumed = i' - i\n        ? consumed = 0\n        ?> i, s\n        |:\n            i',\n            { s' ?| position = { line = s'::position::line; col = s'::position::col + consumed } }\n            |> parser_state\n\n:= advance_newlines (t : string) (i : int) (parser_state s' &= s)\n    : int * parser_state\n    =\n    ? i >= s'::text_length\n    ?> i, s\n    |:\n        := i' = i |> sm'::span_from ((=) '\\n') t\n        := i' =\n            ? i' > s'::text_length\n            ?> s'::text_length\n            |: i'\n        := consumed = i' - i\n        ? consumed = 0\n        ?> i, s\n        |:\n            i',\n            { s' ?|\n                line_start = i'\n                position = { line = s'::position::line + consumed; col = 1 }\n            }\n            |> parser_state\n\n:= many_chars_till (p : parser char) (end_p : parser _) =\n    \\ t, i, (parser_state s' &= s) =>\n        trace_entry \"parsing.many_chars_till\" \\ () => { t_len = ##t; i s }\n        :~ ^ 루프 (i' : int) (s'' : parser_state) : result (string * int * parser_state) parser_error =\n            ? i' >= s'::text_length\n            ?> Ok ((? i' > i ?> t |> slice i i' |: \"\"), i', s'')\n            |:\n                := i'', s''' = s'' |> advance_while_no_nl (\\ c => c <> '\\n') t i'\n                ? i'' >= s'::text_length\n                ?> Ok ((? i'' > i ?> t |> slice i i'' |: \"\"), i'', s''')\n                |:\n                    ?= end_p (t, i'', s''') ?|\n                    | Ok _ => Ok ((? i'' > i ?> t |> slice i i'' |: \"\"), i'', s''')\n                    | Error _ =>\n                        ?= p (t, i'', s''') ?|\n                        | Error _ => Ok ((? i'' > i ?> t |> slice i i'' |: \"\"), i'', s''')\n                        | Ok (_, i''', s'''') ?& i''' > i'' => s'''' |> 루프 i'''\n                        | Ok _ =>\n                            fail\n                                \\ _ => \"parsing.many_chars_till / inner parser succeeded without consuming text\"\n                                i''\n                                s'''\n        s |> 루프 i\n\n:= many1 (p : parser _) : parser (list _) = \\ t, i, s =>\n    trace_entry \"parsing.many1\" \\ () => { t_len = ##t; i s }\n    ?= p (t, i, s) ?|\n    | Error e => e |> Error\n    | Ok (first, i', s') =>\n        :~ ^ 루프 acc (i'' : int) s'' : result (list _ * int * parser_state) _ =\n            ?= p (t, i'', s'') ?|\n            | Error _ => Ok (acc |> listm::rev, i'', s'')\n            | Ok (x, i''', s''') ?& i''' > i'' => s''' |> 루프 (x :: acc) i'''\n            | Ok _ => fail (\\ _ => \"parsing.many1 / inner parser succeeded without consuming text\") i'' s''\n        s' |> 루프 [ first ] i'","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  := many1_satisfy (fn : char -> bool) : parser string = \ t, i, (parser_state s' &= s) =>
      :~ ^ 루프 (i' : int) (s'' : parser_state) : int * parser_state =
          ? i' >= s'::text_length
          ?> i', s''
          |:
              := c = t |> sm'::index i'
              ? fn c
              ?> 루프 (i' + 1) (c |> update_char s'')
              |: i', s''
      := i', s'' = 루프 i s
      ? i' > i
      ?> Ok (t |> slice i i', i', s'')
      |:
          fail (\ _, i, s => "parsing.many1_satisfy / no matching char / " ++# sm'::show { i s }) i s

  := many1_none_of (chars : list char) : parser string =
      many1_satisfy \ c => chars |> listm'::exists' ((=) c) |> not

  := many_chars (p : parser char) : parser string = \ t, i, s =>
      trace_entry "parsing.many_chars" \ () => { t_len = ##t; i s }
      ?= many1_chars p (t, i, s) ?|
      | Ok (res, i', s') => Ok (res, i', s')
      | Error _ => Ok ("", i, s)

  := advance_while_no_nl (fn : char -> bool) (t : string) (i : int) (parser_state s' &= s)
      : int * parser_state
      =
      ? i >= s'::text_length
      ?> i, s
      |:
          := i' = i |> sm'::span_from fn t
          := i' =
              ? i' > s'::text_length
              ?> s'::text_length
              |: i'
          := consumed = i' - i
          ? consumed = 0
          ?> i, s
          |:
              i',
              { s' ?| position = { line = s'::position::line; col = s'::position::col + consumed } }
              |> parser_state

  := advance_newlines (t : string) (i : int) (parser_state s' &= s)
      : int * parser_state
      =
      ? i >= s'::text_length
      ?> i, s
      |:
          := i' = i |> sm'::span_from ((=) '\n') t
          := i' =
              ? i' > s'::text_length
              ?> s'::text_length
              |: i'
          := consumed = i' - i
          ? consumed = 0
          ?> i, s
          |:
              i',
              { s' ?|
                  line_start = i'
                  position = { line = s'::position::line + consumed; col = 1 }
              }
              |> parser_state

  := many_chars_till (p : parser char) (end_p : parser _) =
      \ t, i, (parser_state s' &= s) =>
          trace_entry "parsing.many_chars_till" \ () => { t_len = ##t; i s }
          :~ ^ 루프 (i' : int) (s'' : parser_state) : result (string * int * parser_state) parser_error =
              ? i' >= s'::text_length
              ?> Ok ((? i' > i ?> t |> slice i i' |: ""), i', s'')
              |:
                  := i'', s''' = s'' |> advance_while_no_nl (\ c => c <> '\n') t i'
                  ? i'' >= s'::text_length
                  ?> Ok ((? i'' > i ?> t |> slice i i'' |: ""), i'', s''')
                  |:
                      ?= end_p (t, i'', s''') ?|
                      | Ok _ => Ok ((? i'' > i ?> t |> slice i i'' |: ""), i'', s''')
                      | Error _ =>
                          ?= p (t, i'', s''') ?|
                          | Error _ => Ok ((? i'' > i ?> t |> slice i i'' |: ""), i'', s''')
                          | Ok (_, i''', s'''') ?& i''' > i'' => s'''' |> 루프 i'''
                          | Ok _ =>
                              fail
                                  \ _ => "parsing.many_chars_till / inner parser succeeded without consuming text"
                                  i''
                                  s'''
          s |> 루프 i

  := many1 (p : parser _) : parser (list _) = \ t, i, s =>
      trace_entry "parsing.many1" \ () => { t_len = ##t; i s }
      ?= p (t, i, s) ?|
      | Error e => e |> Error
      | Ok (first, i', s') =>
          :~ ^ 루프 acc (i'' : int) s'' : result (list _ * int * parser_state) _ =
              ?= p (t, i'', s'') ?|
              | Error _ => Ok (acc |> listm::rev, i'', s'')
              | Ok (x, i''', s''') ?& i''' > i'' => s''' |> 루프 (x :: acc) i'''
              | Ok _ => fail (\ _ => "parsing.many1 / inner parser succeeded without consuming text") i'' s''
          s' |> 루프 [ first ] i'
  """,
  timeout: 300_000
)
```

#### many1 (test)

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":"///- --test --symbol\n///> gleam\n///> fsharp\n///> cuda\n///> typescript\n\n\"aaabbc\"\n|> run_parser (many1 (p_char 'a' <|> p_char 'b'))\n|> resultm::get\n|> sm'::show\n|> _assert_eq (sm'::show ([ 'a'; 'a'; 'a'; 'b'; 'b' ], \"c\", new_parser_state 0 1 6 6))\n\n\"bcc\"\n|> run_parser (many1 (p_char 'a' <|> p_char 'b'))\n|> resultm::get\n|> sm'::show\n|> _assert_eq (sm'::show ([ 'b' ], \"cc\", new_parser_state 0 1 2 3))\n\n\"cba\"\n|> run_parser (many1 (p_char 'a' <|> p_char 'b'))\n|> resultm::map_error eval\n|> _assert_eq (Error \"parsing.p_char / { expected = b; line = 1; col = 1 }\\ncba\\n^\\n\")","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  ///- --test --symbol
  ///> gleam
  ///> fsharp
  ///> cuda
  ///> typescript

  "aaabbc"
  |> run_parser (many1 (p_char 'a' <|> p_char 'b'))
  |> resultm::get
  |> sm'::show
  |> _assert_eq (sm'::show ([ 'a'; 'a'; 'a'; 'b'; 'b' ], "c", new_parser_state 0 1 6 6))

  "bcc"
  |> run_parser (many1 (p_char 'a' <|> p_char 'b'))
  |> resultm::get
  |> sm'::show
  |> _assert_eq (sm'::show ([ 'b' ], "cc", new_parser_state 0 1 2 3))

  "cba"
  |> run_parser (many1 (p_char 'a' <|> p_char 'b'))
  |> resultm::map_error eval
  |> _assert_eq (Error "parsing.p_char / { expected = b; line = 1; col = 1 }\ncba\n^\n")
  """,
  timeout: 300_000
)
```

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":":= concat_rev (acc : list string) : string =\n    :~ ^ pass (rev : bool) (xs : list string) (out : list string) : list string =\n        ?= xs ?|\n        | a :: rest =>\n            ?= rest ?|\n            | b :: rest' => pass rev rest' ((? rev ?> b ++# a |: a ++# b) :: out)\n            | [] => a :: out\n        | [] => out\n    :~ ^ 루프 (rev : bool) (xs : list string) : string =\n        ?= xs ?|\n        | [] => \"\"\n        | x :: rest =>\n            ?= rest ?|\n            | [] => x\n            | _ => 루프 (not rev) (pass rev xs [])\n    ? is_rust () ?>\n        ?= acc ?|\n        | _ :: _ :: _ :: _ =>\n            := total : i32 = (0i32, acc) ||> listm::fold \\ n (x : string) => n + ##x\n            := size : convert::unativeint = convert::convert total\n            := buf : $'Rc<RefCell<Vec<u8>>>' = $'Rc::new(RefCell::new(vec\\![0u8; !size]))'\n            := _ : i32 = (total, acc) ||> listm::fold \\ end (x : string) =>\n                := start = end - ##x\n                := from : convert::unativeint = convert::convert start\n                := upto : convert::unativeint = convert::convert end\n                $'!buf.borrow_mut()[!from..!upto].copy_from_slice(!x.as_bytes())' : ()\n                start\n            $'unsafe { Rc::<str>::from(std::str::from_utf8_unchecked(&!buf.borrow())) }' : string\n        | _ => 루프 !+ acc\n    |: 루프 !+ acc","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  := concat_rev (acc : list string) : string =
      :~ ^ pass (rev : bool) (xs : list string) (out : list string) : list string =
          ?= xs ?|
          | a :: rest =>
              ?= rest ?|
              | b :: rest' => pass rev rest' ((? rev ?> b ++# a |: a ++# b) :: out)
              | [] => a :: out
          | [] => out
      :~ ^ 루프 (rev : bool) (xs : list string) : string =
          ?= xs ?|
          | [] => ""
          | x :: rest =>
              ?= rest ?|
              | [] => x
              | _ => 루프 (not rev) (pass rev xs [])
      ? is_rust () ?>
          ?= acc ?|
          | _ :: _ :: _ :: _ =>
              := total : i32 = (0i32, acc) ||> listm::fold \ n (x : string) => n + ##x
              := size : convert::unativeint = convert::convert total
              := buf : $'Rc<RefCell<Vec<u8>>>' = $'Rc::new(RefCell::new(vec\![0u8; !size]))'
              := _ : i32 = (total, acc) ||> listm::fold \ end (x : string) =>
                  := start = end - ##x
                  := from : convert::unativeint = convert::convert start
                  := upto : convert::unativeint = convert::convert end
                  $'!buf.borrow_mut()[!from..!upto].copy_from_slice(!x.as_bytes())' : ()
                  start
              $'unsafe { Rc::<str>::from(std::str::from_utf8_unchecked(&!buf.borrow())) }' : string
          | _ => 루프 !+ acc
      |: 루프 !+ acc
  """,
  timeout: 300_000
)
```

