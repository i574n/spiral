<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":":= opt p : parser (option _) = \\ t, i, s =>\n    ?= p (t, i, s) ?|\n    | Ok (r, i', s') => Ok (Some (\\ () => r), i', s')\n    | Error _ => Ok (None, i, s)\n\n:= rest_of_line () : parser string = \\ t, i, s =>\n    := i'', s' = s |> advance_while_no_nl ((<>) '\\n') t i\n    Ok (t |> slice i i'', i'', s')\n\n:= eof () : parser () = \\ t, i, (parser_state s' &= s) =>\n    ? s'::text_length = i\n    ?> Ok ((), i, s)\n    |:\n        fail\n            \\ t, i, (parser_state s') =>\n                \"parsing.eof / expected end of text / \"\n                ++# sm'::show { rest = t |> slice i s'::text_length }\n            i s\n\n:= p_string (str : string) : parser string = \\ t, i, (parser_state s' &= s) =>\n    := len = ##str\n    ? s'::text_length - i < len ?>\n        fail (\\ _, _, s => \"parsing.p_string / unexpected end of text / \" ++# sm'::show { expected = str; s }) i s\n    |:\n        :~ ^ eq k =\n            ? k >= len\n            ?> !+\n            |: t |> sm'::index (i + k) = str |> sm'::index k && eq (k + 1)\n        ? eq 0\n        ?> Ok (t |> slice i (i + len), i + len, s |> update_span t i len)\n        |:\n            fail\n                \\ t, i, (parser_state s' &= s) =>\n                    := preview_end = (i + get_max_context ()) |> min s'::text_length\n                    := rest = t |> slice i preview_end\n                    := got = t |> slice i (i + len)\n                    \"parsing.p_string / unexpected string / \"\n                    ++# sm'::show { expected = str; got rest s }\n                i s","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  := opt p : parser (option _) = \ t, i, s =>
      ?= p (t, i, s) ?|
      | Ok (r, i', s') => Ok (Some (\ () => r), i', s')
      | Error _ => Ok (None, i, s)

  := rest_of_line () : parser string = \ t, i, s =>
      := i'', s' = s |> advance_while_no_nl ((<>) '\n') t i
      Ok (t |> slice i i'', i'', s')

  := eof () : parser () = \ t, i, (parser_state s' &= s) =>
      ? s'::text_length = i
      ?> Ok ((), i, s)
      |:
          fail
              \ t, i, (parser_state s') =>
                  "parsing.eof / expected end of text / "
                  ++# sm'::show { rest = t |> slice i s'::text_length }
              i s

  := p_string (str : string) : parser string = \ t, i, (parser_state s' &= s) =>
      := len = ##str
      ? s'::text_length - i < len ?>
          fail (\ _, _, s => "parsing.p_string / unexpected end of text / " ++# sm'::show { expected = str; s }) i s
      |:
          :~ ^ eq k =
              ? k >= len
              ?> !+
              |: t |> sm'::index (i + k) = str |> sm'::index k && eq (k + 1)
          ? eq 0
          ?> Ok (t |> slice i (i + len), i + len, s |> update_span t i len)
          |:
              fail
                  \ t, i, (parser_state s' &= s) =>
                      := preview_end = (i + get_max_context ()) |> min s'::text_length
                      := rest = t |> slice i preview_end
                      := got = t |> slice i (i + len)
                      "parsing.p_string / unexpected string / "
                      ++# sm'::show { expected = str; got rest s }
                  i s
  """,
  timeout: 300_000
)
```

