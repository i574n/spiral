### velocity_ftv

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"inl newton_second_tv m fs (t, v0) =\n    inl f_net = fs |> listm.map (fun f => f (t, v0)) |> listm'.sum\n    inl acc = f_net / m\n    1, acc\n\ninl update_tv dt m fs (t, v0) =\n    inl dtdt, dvdt = newton_second_tv m fs (t, v0)\n    t + dtdt * dt, v0 + dvdt * dt\n\ninl velocity_ftv dt m tv0 fs t =\n    stream.iterate (join update_tv dt m fs) tv0\n    |> stream.try_item (t / dt |> math.round |> abs)\n    |> optionm.map snd\n    |> optionm'.default_value 0","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  inl newton_second_tv m fs (t, v0) =
      inl f_net = fs |> listm.map (fun f => f (t, v0)) |> listm'.sum
      inl acc = f_net / m
      1, acc

  inl update_tv dt m fs (t, v0) =
      inl dtdt, dvdt = newton_second_tv m fs (t, v0)
      t + dtdt * dt, v0 + dvdt * dt

  inl velocity_ftv dt m tv0 fs t =
      stream.iterate (join update_tv dt m fs) tv0
      |> stream.try_item (t / dt |> math.round |> abs)
      |> optionm.map snd
      |> optionm'.default_value 0
  """,
  timeout: 300_000
)
```

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"///- --test\n\ninl x = am'.init_series 0 100 0.1\ninl y =\n    x\n    |> am'.map_base (\n        velocity_ftv 0.1 20 (dyn (0, 0)) [ fun (t, _) => pedal_coast t; fun (_, v) => f_air 2 1.225 0.5 v ]\n    )\n\"pedaling and coasting with air\", \"time (s)\", \"\", ;[ \"velocity of bike (m/s)\", x, y ]","print_code":false},"livebook_object":"smart_cell"} -->

