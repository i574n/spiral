  |> _assert_approx_eq None 0.33332500000000004
  """,
  timeout: 300_000
)
```

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"inl integral' dt : integration =\n    fun f a b =>\n        listm'.init_series (a + dt / 2) (b - dt / 2) dt\n        |> listm.map (f >> (*) dt)\n        |> listm'.sum","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  inl integral' dt : integration =
      fun f a b =>
          listm'.init_series (a + dt / 2) (b - dt / 2) dt
          |> listm.map (f >> (*) dt)
          |> listm'.sum
  """,
  timeout: 300_000
)
```

