### relativity_ps

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"inl relativity_ps fs (st : particle_state) =\n    inl f_net = fs |> listm.map (fun f => f st) |> sum_vec\n    inl c = 299792458\n    inl u = st.velocity ^/ c\n    inl acc = sqrt (1 - (u <.> u)) *^ (f_net ^-^ (f_net <.> u) *^ u) ^/ st.mass\n    d_particle_state {\n        dmdt = 0\n        dqdt = 0\n        dtdt = 1\n        drdt = st.velocity\n        dvdt = acc\n    }","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  inl relativity_ps fs (st : particle_state) =
      inl f_net = fs |> listm.map (fun f => f st) |> sum_vec
      inl c = 299792458
      inl u = st.velocity ^/ c
      inl acc = sqrt (1 - (u <.> u)) *^ (f_net ^-^ (f_net <.> u) *^ u) ^/ st.mass
      d_particle_state {
          dmdt = 0
          dqdt = 0
          dtdt = 1
          drdt = st.velocity
          dvdt = acc
      }
  """,
  timeout: 300_000
)
