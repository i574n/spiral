<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"///- --test\n\ninl c : f64 = 299792458\ninl ~method = runge_kutta_4 0.000000001\ninl forces = [ uniform_lorentz_force (zero_vec ()) (k_hat ()) ]\ninl (particle_state default_particle_state') = default_particle_state ()\ninl initial_state =\n    particle_state { default_particle_state' with\n        mass = 0.000000000000000000000000001672621898\n        charge = 0.0000000000000000001602176621\n        velocity = 0.8 *^ (c *^ j_hat ())\n    }\n\ninl newton_states = solver_ method (newton_second_ps forces) initial_state\ninl relativity_states = solver_ method (relativity_ps forces) initial_state\n\ninl newton_x, newton_y =\n    newton_states\n    >> Some\n    |> seq.take_while_ (fun (particle_state st) i => i < 100i32)\n    |> listm.map (fun (particle_state st) => st.pos_vec.x, st.pos_vec.y)\n    |> listm'.unzip\n\ninl relativity_x, relativity_y =\n    relativity_states\n    >> Some\n    |> seq.take_while_ (fun (particle_state st) i => i < 165i32)\n    |> listm.map (fun (particle_state st) => st.pos_vec.x, st.pos_vec.y)\n    |> listm'.unzip\n\ninl newton_x = newton_x |> listm'.box |> listm'.to_array'\ninl newton_y = newton_y |> listm'.box |> listm'.to_array'\n\ninl relativity_x = relativity_x |> listm'.box |> listm'.to_array'\ninl relativity_y = relativity_y |> listm'.box |> listm'.to_array'\n\n\"proton in a 1-t magnetic field\",\n\"x (m)\",\n\"y (m)\",\n;[\n    \"newtonian\", newton_x, newton_y\n    \"relativistic\", relativity_x, relativity_y\n]","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  ///- --test

  inl c : f64 = 299792458
  inl ~method = runge_kutta_4 0.000000001
  inl forces = [ uniform_lorentz_force (zero_vec ()) (k_hat ()) ]
  inl (particle_state default_particle_state') = default_particle_state ()
  inl initial_state =
      particle_state { default_particle_state' with
          mass = 0.000000000000000000000000001672621898
          charge = 0.0000000000000000001602176621
          velocity = 0.8 *^ (c *^ j_hat ())
      }

  inl newton_states = solver_ method (newton_second_ps forces) initial_state
  inl relativity_states = solver_ method (relativity_ps forces) initial_state

  inl newton_x, newton_y =
      newton_states
      >> Some
      |> seq.take_while_ (fun (particle_state st) i => i < 100i32)
      |> listm.map (fun (particle_state st) => st.pos_vec.x, st.pos_vec.y)
      |> listm'.unzip

  inl relativity_x, relativity_y =
      relativity_states
      >> Some
      |> seq.take_while_ (fun (particle_state st) i => i < 165i32)
      |> listm.map (fun (particle_state st) => st.pos_vec.x, st.pos_vec.y)
      |> listm'.unzip

  inl newton_x = newton_x |> listm'.box |> listm'.to_array'
  inl newton_y = newton_y |> listm'.box |> listm'.to_array'

  inl relativity_x = relativity_x |> listm'.box |> listm'.to_array'
  inl relativity_y = relativity_y |> listm'.box |> listm'.to_array'

  "proton in a 1-t magnetic field",
  "x (m)",
  "y (m)",
  ;[
      "newtonian", newton_x, newton_y
      "relativistic", relativity_x, relativity_y
  ]
  """,
  timeout: 300_000
)
```

#### system kinetic energy versus time 1

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"///- --test static\n\ntype force_vector = vec\ntype two_body_force = particle_state -> particle_state -> force_vector\n\nunion force =\n    | ExternalForce : i32 * one_body_force\n    | InternalForce : i32 * i32 * two_body_force\n\nnominal multi_particle_state_l = list particle_state\n\nnominal d_multi_particle_state_l = list d_particle_state\n\ninl force_on n sts force =\n    match force with\n    | ExternalForce (n0, f_one_body) =>\n        if n = n0\n        then f_one_body\n        else fun _ => zero_vec ()\n    | InternalForce (n0, n1, f_two_body) =>\n        if n = n0\n        then f_two_body (sts |> listm'.item n1)\n        elif n = n1\n        then f_two_body (sts |> listm'.item n0)\n        else fun _ => zero_vec ()\n\ninl forces_on n (multi_particle_state_l sts) fs =\n    fs |> listm.map (force_on n sts)\n\ninl newton_second_mps fs (multi_particle_state_l sts) : d_multi_particle_state_l =\n    inl deriv (n, st) =\n        newton_second_ps (forces_on n (multi_particle_state_l sts) fs) st\n    sts |> listm'.indexed |> listm.map deriv |> d_multi_particle_state_l\n\ninl update_mps_l (method : numerical_method multi_particle_state_l d_multi_particle_state_l) =\n    newton_second_mps >> method\n\ninstance (+++) d_multi_particle_state_l = fun (d_multi_particle_state_l dsts1) (d_multi_particle_state_l dsts2) =>\n    d_multi_particle_state_l (listm'.zip_with_ (+++) dsts1 dsts2)\n\ninstance shift multi_particle_state_l = fun dt dsts (multi_particle_state_l sts) =>\n    inl (d_multi_particle_state_l dsts) =\n        real\n            match dsts with\n            | d_multi_particle_state_l _ => dsts\n    listm'.zip_with_ (shift dt) dsts sts |> multi_particle_state_l","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  ///- --test static

  type force_vector = vec
  type two_body_force = particle_state -> particle_state -> force_vector

  union force =
      | ExternalForce : i32 * one_body_force
      | InternalForce : i32 * i32 * two_body_force

  nominal multi_particle_state_l = list particle_state

  nominal d_multi_particle_state_l = list d_particle_state

  inl force_on n sts force =
      match force with
      | ExternalForce (n0, f_one_body) =>
          if n = n0
          then f_one_body
          else fun _ => zero_vec ()
      | InternalForce (n0, n1, f_two_body) =>
          if n = n0
          then f_two_body (sts |> listm'.item n1)
          elif n = n1
          then f_two_body (sts |> listm'.item n0)
          else fun _ => zero_vec ()

  inl forces_on n (multi_particle_state_l sts) fs =
      fs |> listm.map (force_on n sts)

  inl newton_second_mps fs (multi_particle_state_l sts) : d_multi_particle_state_l =
      inl deriv (n, st) =
          newton_second_ps (forces_on n (multi_particle_state_l sts) fs) st
      sts |> listm'.indexed |> listm.map deriv |> d_multi_particle_state_l

  inl update_mps_l (method : numerical_method multi_particle_state_l d_multi_particle_state_l) =
      newton_second_mps >> method

  instance (+++) d_multi_particle_state_l = fun (d_multi_particle_state_l dsts1) (d_multi_particle_state_l dsts2) =>
      d_multi_particle_state_l (listm'.zip_with_ (+++) dsts1 dsts2)

  instance shift multi_particle_state_l = fun dt dsts (multi_particle_state_l sts) =>
      inl (d_multi_particle_state_l dsts) =
          real
              match dsts with
              | d_multi_particle_state_l _ => dsts
      listm'.zip_with_ (shift dt) dsts sts |> multi_particle_state_l
  """,
  timeout: 300_000
)
```

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"///- --test\n\ninl central_force f (particle_state st1) (particle_state st2) =\n    inl r1 = st1.pos_vec\n    inl r2 = st2.pos_vec\n    inl r21 = r2 ^-^ r1\n    inl r21mag = magnitude r21\n    f r21mag *^ r21 ^/ r21mag\n\ninl billiard_force k re =\n    inl f r =\n        if r >= re\n        then 0\n        else -k * (r - re)\n    central_force f\n\ninstance scale d_multi_particle_state_l = fun w (d_multi_particle_state_l dsts) =>\n    d_multi_particle_state_l (dsts |> listm.map (scale w))\n\ninl euler_cromer_mps dt : numerical_method multi_particle_state_l d_multi_particle_state_l =\n    fun deriv mpst0 =>\n        inl mpst1 = euler dt deriv mpst0\n        inl (multi_particle_state_l sts0) = mpst0\n        inl (multi_particle_state_l sts1) = mpst1\n        sts1\n        |> listm'.zip_ sts0\n        |> listm.map (fun ((particle_state st0), (particle_state st1)) =>\n            particle_state {\n                st1 with\n                    pos_vec = st0.pos_vec ^+^ st1.velocity ^* dt\n            }\n        )\n        |> multi_particle_state_l\n\ninl states_mps (method : numerical_method multi_particle_state_l d_multi_particle_state_l) =\n    newton_second_mps >> method >> seq.iterate_\n\ninl kinetic_energy (particle_state st) =\n    inl m = st.mass\n    inl v = magnitude st.velocity\n    0.5 * m * v ** 2\n\ninl system_ke (multi_particle_state_l sts) =\n    sts |> listm.map kinetic_energy |> listm'.sum\n\ninl linear_spring_pe k re (particle_state st1) (particle_state st2) =\n    inl r1 = st1.pos_vec\n    inl r2 = st2.pos_vec\n    inl r21 = r2 ^-^ r1\n    inl r21mag = magnitude r21\n    k * (r21mag - re) ** 2 / 2\n\ninl earth_surface_gravity_pe (particle_state st) =\n    inl g = 9.80665\n    inl m = st.mass\n    inl z = st.pos_vec.z\n    m * g * z\n\ninl two_springs_pe (multi_particle_state_l sts) =\n    inl st0 = sts |> listm'.item 0i32\n    inl st1 = sts |> listm'.item 1i32\n    linear_spring_pe 100 0.5 (default_particle_state ()) st0\n    + linear_spring_pe 100 0.5 st0 st1\n    + earth_surface_gravity_pe st0\n    + earth_surface_gravity_pe st1\n\ninl two_springs_me mpst =\n    system_ke mpst + two_springs_pe mpst\n\ninl ball_radius () = 0.03\n\ninl billiard_forces k =\n    [ InternalForce (0, 1, billiard_force k (2 * ball_radius ())) ]\n\ninl billiard_update n_method k dt =\n    update_mps_l (n_method dt) (billiard_forces k)\n\ninl billiard_initial () =\n    inl ball_mass = 0.160\n    inl (particle_state default_particle_state') = default_particle_state ()\n    multi_particle_state_l [\n        particle_state {\n            default_particle_state' with\n                mass = ball_mass\n                pos_vec = zero_vec ()\n                velocity = 0.2 *^ i_hat ()\n        }\n        particle_state {\n            default_particle_state' with\n                mass = ball_mass\n                pos_vec = i_hat () ^+^ 0.02 *^ j_hat ()\n                velocity = zero_vec ()\n        }\n    ]\n\ninl billiard_states ~n_method k dt =\n    states_mps (n_method dt) (billiard_forces k) (billiard_initial ())\n\ninl billiard_states_finite n_method k dt =\n    billiard_states n_method k dt\n    >> Some\n    |> seq.take_while_ (fun (multi_particle_state_l mpst) (_ : i32) =>\n        (mpst |> listm'.item 0i32).time <= 10\n    )\n\ninl momentum (particle_state st) =\n    inl m = st.mass\n    inl v = st.velocity\n    m *^ v\n\ninl system_p (multi_particle_state_l sts) =\n    sts |> listm.map momentum |> sum_vec\n\n\ninl time_ke_ec_x, time_ke_ec_y =\n    billiard_states_finite euler_cromer_mps 30 0.03\n    |> listm.map (fun (multi_particle_state_l mpst) =>\n        (mpst |> listm'.item 0i32).time, system_ke (multi_particle_state_l mpst)\n    )\n    |> listm'.unzip\n\ninl time_ke_rk4_x, time_ke_rk4_y =\n    billiard_states_finite runge_kutta_4 30 0.03\n    |> listm.map (fun (multi_particle_state_l mpst) =>\n        (mpst |> listm'.item 0i32).time, system_ke (multi_particle_state_l mpst)\n    )\n    |> listm'.unzip\n\ninl time_ke_ec_x = time_ke_ec_x |> listm'.box |> listm'.to_array'\ninl time_ke_ec_y = time_ke_ec_y |> listm'.box |> listm'.to_array'\n\ninl time_ke_rk4_x = time_ke_rk4_x |> listm'.box |> listm'.to_array'\ninl time_ke_rk4_y = time_ke_rk4_y |> listm'.box |> listm'.to_array'\n\n\"system kinetic energy versus time\",\n\"time (s)\",\n\"system kinetic energy (j)\",\n;[\n    \"euler-cromer\", time_ke_ec_x, time_ke_ec_y\n    \"runge-kutta 4\", time_ke_rk4_x, time_ke_rk4_y\n]","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  ///- --test

  inl central_force f (particle_state st1) (particle_state st2) =
      inl r1 = st1.pos_vec
      inl r2 = st2.pos_vec
      inl r21 = r2 ^-^ r1
      inl r21mag = magnitude r21
      f r21mag *^ r21 ^/ r21mag

  inl billiard_force k re =
      inl f r =
          if r >= re
          then 0
          else -k * (r - re)
      central_force f

  instance scale d_multi_particle_state_l = fun w (d_multi_particle_state_l dsts) =>
      d_multi_particle_state_l (dsts |> listm.map (scale w))

  inl euler_cromer_mps dt : numerical_method multi_particle_state_l d_multi_particle_state_l =
      fun deriv mpst0 =>
          inl mpst1 = euler dt deriv mpst0
          inl (multi_particle_state_l sts0) = mpst0
          inl (multi_particle_state_l sts1) = mpst1
          sts1
          |> listm'.zip_ sts0
          |> listm.map (fun ((particle_state st0), (particle_state st1)) =>
              particle_state {
                  st1 with
                      pos_vec = st0.pos_vec ^+^ st1.velocity ^* dt
              }
          )
          |> multi_particle_state_l

  inl states_mps (method : numerical_method multi_particle_state_l d_multi_particle_state_l) =
      newton_second_mps >> method >> seq.iterate_

  inl kinetic_energy (particle_state st) =
      inl m = st.mass
      inl v = magnitude st.velocity
      0.5 * m * v ** 2

  inl system_ke (multi_particle_state_l sts) =
      sts |> listm.map kinetic_energy |> listm'.sum

  inl linear_spring_pe k re (particle_state st1) (particle_state st2) =
      inl r1 = st1.pos_vec
      inl r2 = st2.pos_vec
      inl r21 = r2 ^-^ r1
      inl r21mag = magnitude r21
      k * (r21mag - re) ** 2 / 2

  inl earth_surface_gravity_pe (particle_state st) =
      inl g = 9.80665
      inl m = st.mass
      inl z = st.pos_vec.z
      m * g * z

  inl two_springs_pe (multi_particle_state_l sts) =
      inl st0 = sts |> listm'.item 0i32
      inl st1 = sts |> listm'.item 1i32
      linear_spring_pe 100 0.5 (default_particle_state ()) st0
      + linear_spring_pe 100 0.5 st0 st1
      + earth_surface_gravity_pe st0
      + earth_surface_gravity_pe st1

  inl two_springs_me mpst =
      system_ke mpst + two_springs_pe mpst

  inl ball_radius () = 0.03

  inl billiard_forces k =
      [ InternalForce (0, 1, billiard_force k (2 * ball_radius ())) ]

  inl billiard_update n_method k dt =
      update_mps_l (n_method dt) (billiard_forces k)

  inl billiard_initial () =
      inl ball_mass = 0.160
      inl (particle_state default_particle_state') = default_particle_state ()
      multi_particle_state_l [
          particle_state {
              default_particle_state' with
                  mass = ball_mass
                  pos_vec = zero_vec ()
                  velocity = 0.2 *^ i_hat ()
          }
          particle_state {
              default_particle_state' with
                  mass = ball_mass
                  pos_vec = i_hat () ^+^ 0.02 *^ j_hat ()
                  velocity = zero_vec ()
          }
      ]

  inl billiard_states ~n_method k dt =
      states_mps (n_method dt) (billiard_forces k) (billiard_initial ())

  inl billiard_states_finite n_method k dt =
      billiard_states n_method k dt
      >> Some
      |> seq.take_while_ (fun (multi_particle_state_l mpst) (_ : i32) =>
          (mpst |> listm'.item 0i32).time <= 10
      )

  inl momentum (particle_state st) =
      inl m = st.mass
      inl v = st.velocity
      m *^ v

  inl system_p (multi_particle_state_l sts) =
      sts |> listm.map momentum |> sum_vec


  inl time_ke_ec_x, time_ke_ec_y =
      billiard_states_finite euler_cromer_mps 30 0.03
      |> listm.map (fun (multi_particle_state_l mpst) =>
          (mpst |> listm'.item 0i32).time, system_ke (multi_particle_state_l mpst)
      )
      |> listm'.unzip

  inl time_ke_rk4_x, time_ke_rk4_y =
      billiard_states_finite runge_kutta_4 30 0.03
      |> listm.map (fun (multi_particle_state_l mpst) =>
          (mpst |> listm'.item 0i32).time, system_ke (multi_particle_state_l mpst)
      )
      |> listm'.unzip

  inl time_ke_ec_x = time_ke_ec_x |> listm'.box |> listm'.to_array'
  inl time_ke_ec_y = time_ke_ec_y |> listm'.box |> listm'.to_array'

  inl time_ke_rk4_x = time_ke_rk4_x |> listm'.box |> listm'.to_array'
  inl time_ke_rk4_y = time_ke_rk4_y |> listm'.box |> listm'.to_array'

  "system kinetic energy versus time",
  "time (s)",
  "system kinetic energy (j)",
  ;[
      "euler-cromer", time_ke_ec_x, time_ke_ec_y
      "runge-kutta 4", time_ke_rk4_x, time_ke_rk4_y
  ]
  """,
  timeout: 300_000
)
```

#### wave 1

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"///- --test\n\ninl linear_spring k re (particle_state st1) (particle_state st2) =\n    inl r1 = st1.pos_vec\n    inl r2 = st2.pos_vec\n    inl r21 = r2 ^-^ r1\n    inl r21mag = magnitude r21\n    -k * (r21mag - re) *^ r21 ^/ r21mag\n\ninl fixed_linear_spring k re r1 =\n    inl (particle_state default_particle_state') = default_particle_state ()\n    linear_spring k re (particle_state { default_particle_state' with pos_vec = r1 })\n\ninl forces_string_l () =\n    [\n        ExternalForce (0, fixed_linear_spring 5384 0 (zero_vec ()))\n        ExternalForce (63, fixed_linear_spring 5384 0 (0.65 *^ i_hat ()))\n    ] ++ (\n        listm'.init_series 0 59 1\n        |> listm.map (fun n => InternalForce (n, n + 1, linear_spring 5384 0))\n    )\n\ninl string_update_l dt =\n    update_mps_l (runge_kutta_4 dt) (forces_string_l ())\n\ninl string_initial_overtone_l n =\n    inl ball_mass = 0.0008293 * 0.65 / 64\n    inl (particle_state default_particle_state') = default_particle_state ()\n    listm'.init_series 0.01 0.64 0.01\n    |> listm.map (fun x =>\n        inl y = 0.005 * sin (conv n * pi * x / 0.65)\n        particle_state {\n            default_particle_state' with\n                mass = ball_mass\n                pos_vec = x *^ i_hat () ^+^ y *^ j_hat ()\n                velocity = zero_vec ()\n        }\n    )\n    |> multi_particle_state_l\n\ninl string_initial_pluck_l () =\n    inl ball_mass = 0.0008293 * 0.65 / 64\n    inl (particle_state default_particle_state') = default_particle_state ()\n    listm'.init_series 0.01 0.64 0.01\n    |> listm.map (fun x =>\n        inl y =\n            inl n = if x <= 0.51 then 0 else 0.65\n            0.005 / (0.51 - n) * (x - n)\n        particle_state {\n            default_particle_state' with\n                mass = ball_mass\n                pos_vec = x *^ i_hat () ^+^ y *^ j_hat ()\n                velocity = zero_vec ()\n        }\n    )\n    |> multi_particle_state_l\n\nlet main () =\n    inl ~frames = listm'.init_series 0 9 1f64\n    inl initial_state = string_initial_overtone_l 3i32\n    inl frames =\n        frames\n        |> listm.map (fun n =>\n            inl (multi_particle_state_l sts) =\n                seq.iterate' (string_update_l 0.000025) initial_state |> fun f => f 0f64\n            inl rs =\n                [ zero_vec () ]\n                ++ (sts |> listm.map (fun (particle_state st) => st.pos_vec))\n                ++ [ 0.65 *^ i_hat () ]\n            inl x, y =\n                rs\n                |> listm.map (fun r => r.x, r.y)\n                |> listm'.unzip\n            inl x = x |> listm'.box |> listm'.to_array'\n            inl y = y |> listm'.box |> listm'.to_array'\n            x, y\n        )\n        |> listm'.box |> listm'.to_array'\n\n    inl n = 0i32\n\n    inl x, y = a frames |> am'.index n\n\n    \"wave\",\n    \"position (m)\",\n    \"displacement (m)\",\n    ;[\n        ($'$\"{!n}\"' : string), x, y\n    ]","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  ///- --test

  inl linear_spring k re (particle_state st1) (particle_state st2) =
      inl r1 = st1.pos_vec
      inl r2 = st2.pos_vec
      inl r21 = r2 ^-^ r1
      inl r21mag = magnitude r21
      -k * (r21mag - re) *^ r21 ^/ r21mag

  inl fixed_linear_spring k re r1 =
      inl (particle_state default_particle_state') = default_particle_state ()
      linear_spring k re (particle_state { default_particle_state' with pos_vec = r1 })

  inl forces_string_l () =
      [
          ExternalForce (0, fixed_linear_spring 5384 0 (zero_vec ()))
          ExternalForce (63, fixed_linear_spring 5384 0 (0.65 *^ i_hat ()))
      ] ++ (
          listm'.init_series 0 59 1
          |> listm.map (fun n => InternalForce (n, n + 1, linear_spring 5384 0))
      )

  inl string_update_l dt =
      update_mps_l (runge_kutta_4 dt) (forces_string_l ())

  inl string_initial_overtone_l n =
      inl ball_mass = 0.0008293 * 0.65 / 64
      inl (particle_state default_particle_state') = default_particle_state ()
      listm'.init_series 0.01 0.64 0.01
      |> listm.map (fun x =>
          inl y = 0.005 * sin (conv n * pi * x / 0.65)
          particle_state {
              default_particle_state' with
                  mass = ball_mass
                  pos_vec = x *^ i_hat () ^+^ y *^ j_hat ()
                  velocity = zero_vec ()
          }
      )
      |> multi_particle_state_l

  inl string_initial_pluck_l () =
      inl ball_mass = 0.0008293 * 0.65 / 64
      inl (particle_state default_particle_state') = default_particle_state ()
      listm'.init_series 0.01 0.64 0.01
      |> listm.map (fun x =>
          inl y =
              inl n = if x <= 0.51 then 0 else 0.65
              0.005 / (0.51 - n) * (x - n)
          particle_state {
              default_particle_state' with
                  mass = ball_mass
                  pos_vec = x *^ i_hat () ^+^ y *^ j_hat ()
                  velocity = zero_vec ()
          }
      )
      |> multi_particle_state_l

  let main () =
      inl ~frames = listm'.init_series 0 9 1f64
      inl initial_state = string_initial_overtone_l 3i32
      inl frames =
          frames
          |> listm.map (fun n =>
              inl (multi_particle_state_l sts) =
                  seq.iterate' (string_update_l 0.000025) initial_state |> fun f => f 0f64
              inl rs =
                  [ zero_vec () ]
                  ++ (sts |> listm.map (fun (particle_state st) => st.pos_vec))
                  ++ [ 0.65 *^ i_hat () ]
              inl x, y =
                  rs
                  |> listm.map (fun r => r.x, r.y)
                  |> listm'.unzip
              inl x = x |> listm'.box |> listm'.to_array'
              inl y = y |> listm'.box |> listm'.to_array'
              x, y
          )
          |> listm'.box |> listm'.to_array'

      inl n = 0i32

      inl x, y = a frames |> am'.index n

      "wave",
      "position (m)",
      "displacement (m)",
      ;[
          ($'$"{!n}"' : string), x, y
      ]
  """,
  timeout: 300_000
)
```

#### system kinetic energy versus time 2

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"///- --test static\n\nnominal multi_particle_state_s = stream.stream particle_state\n\nnominal d_multi_particle_state_s = stream.stream d_particle_state\n\ninl force_on n s force =\n    match force with\n    | ExternalForce (n0, f_one_body) =>\n        if n = n0\n        then f_one_body\n        else fun _ => zero_vec ()\n    | InternalForce (n0, n1, f_two_body) =>\n        if n = n0\n        then s |> stream.try_item n1 |> optionm.map f_two_body\n        elif n = n1\n        then s |> stream.try_item n0 |> optionm.map f_two_body\n        else None\n        |> optionm'.default_value (fun _ => zero_vec ())\n\ninl forces_on n (multi_particle_state_s sts) fs =\n    fs\n    |> listm.map (force_on n sts)\n\ninl newton_second_mps fs ((multi_particle_state_s sts) as mpst) =\n    inl deriv (n, st) =\n        newton_second_ps (forces_on n mpst fs) st\n    sts |> stream.indexed |> stream.map deriv |> d_multi_particle_state_s\n\ninl update_mps_s (method : numerical_method multi_particle_state_s d_multi_particle_state_s) =\n    newton_second_mps >> method\n\ninstance shift multi_particle_state_s = fun dt dsts (multi_particle_state_s sts) =>\n    inl (d_multi_particle_state_s dsts) =\n        real\n            match dsts with\n            | d_multi_particle_state_s _ => dsts\n    (dsts, sts)\n    ||> stream.zip_with (shift dt)\n    |> stream.memoize\n    |> fun x => x ()\n    |> multi_particle_state_s\n\ninstance (+++) d_multi_particle_state_s =\n    fun (d_multi_particle_state_s dsts1) (d_multi_particle_state_s dsts2) =>\n        (dsts1, dsts2)\n        ||> stream.zip_with (+++)\n        |> d_multi_particle_state_s","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  ///- --test static

  nominal multi_particle_state_s = stream.stream particle_state

  nominal d_multi_particle_state_s = stream.stream d_particle_state

  inl force_on n s force =
      match force with
      | ExternalForce (n0, f_one_body) =>
          if n = n0
          then f_one_body
          else fun _ => zero_vec ()
      | InternalForce (n0, n1, f_two_body) =>
          if n = n0
          then s |> stream.try_item n1 |> optionm.map f_two_body
          elif n = n1
          then s |> stream.try_item n0 |> optionm.map f_two_body
          else None
          |> optionm'.default_value (fun _ => zero_vec ())

  inl forces_on n (multi_particle_state_s sts) fs =
      fs
      |> listm.map (force_on n sts)

  inl newton_second_mps fs ((multi_particle_state_s sts) as mpst) =
      inl deriv (n, st) =
          newton_second_ps (forces_on n mpst fs) st
      sts |> stream.indexed |> stream.map deriv |> d_multi_particle_state_s

  inl update_mps_s (method : numerical_method multi_particle_state_s d_multi_particle_state_s) =
      newton_second_mps >> method

  instance shift multi_particle_state_s = fun dt dsts (multi_particle_state_s sts) =>
      inl (d_multi_particle_state_s dsts) =
          real
              match dsts with
              | d_multi_particle_state_s _ => dsts
      (dsts, sts)
      ||> stream.zip_with (shift dt)
      |> stream.memoize
      |> fun x => x ()
      |> multi_particle_state_s

  instance (+++) d_multi_particle_state_s =
      fun (d_multi_particle_state_s dsts1) (d_multi_particle_state_s dsts2) =>
          (dsts1, dsts2)
          ||> stream.zip_with (+++)
          |> d_multi_particle_state_s
  """,
  timeout: 300_000
)
```

