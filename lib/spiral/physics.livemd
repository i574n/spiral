### velocity_cf

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"type mass = f64\ntype time = f64\ntype position = f64\ntype velocity = f64\ntype force = f64\n\ntype velocity_cf = mass -> velocity -> list force -> (time -> velocity)\n\ninl velocity_cf m v0 fs =\n    inl f_net = fs |> listm'.sum\n    inl a0 = f_net / m\n    inl v t = v0 + a0 * t\n    v","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  type mass = f64
  type time = f64
  type position = f64
  type velocity = f64
  type force = f64

  type velocity_cf = mass -> velocity -> list force -> (time -> velocity)

  inl velocity_cf m v0 fs =
      inl f_net = fs |> listm'.sum
      inl a0 = f_net / m
      inl v t = v0 + a0 * t
      v
  """,
  timeout: 300_000
)
```

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"///- --test\n\nvelocity_cf 0.1f64 0.6 [ 0.04; -0.08 ] 0\n|> _assert_eq 0.6\n\nvelocity_cf 0.1f64 0.6 [ 0.04; -0.08 ] 1\n|> _assert_eq 0.2","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  ///- --test

  velocity_cf 0.1f64 0.6 [ 0.04; -0.08 ] 0
  |> _assert_eq 0.6

  velocity_cf 0.1f64 0.6 [ 0.04; -0.08 ] 1
  |> _assert_eq 0.2
  """,
  timeout: 300_000
)
```

