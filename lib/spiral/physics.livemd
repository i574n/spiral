```elixir
Spiral.Kino.eval!(
  ~S"""
  type derivative = (f64 -> f64) -> f64 -> f64

  inl derivative dt : derivative =
      fun x t =>
          (x (t + dt / 2) - x (t - dt / 2)) / dt
  """,
  timeout: 300_000
)
```

