### anti_derivative

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"inl anti_derivative dt v0 a t =\n    v0 + integral' dt a 0 t","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  inl anti_derivative dt v0 a t =
      v0 + integral' dt a 0 t
  """,
  timeout: 300_000
)
```

### velocity_ft

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"type velocity_ft = mass -> velocity -> list (time -> force) -> (time -> velocity)\n\ninl velocity_ft dt : velocity_ft =\n    fun m v0 fs =>\n        inl f_net t = fs |> listm.map (fun f => f t) |> listm'.sum\n        inl a t = f_net t / m\n        anti_derivative dt v0 a","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  type velocity_ft = mass -> velocity -> list (time -> force) -> (time -> velocity)

  inl velocity_ft dt : velocity_ft =
      fun m v0 fs =>
          inl f_net t = fs |> listm.map (fun f => f t) |> listm'.sum
          inl a t = f_net t / m
          anti_derivative dt v0 a
  """,
  timeout: 300_000
)
```

### position_ft

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"type position_ft = mass -> position -> velocity -> list (time -> force) -> (time -> position)\n\ninl position_ft dt : position_ft =\n    fun m x0 v0 fs =>\n        velocity_ft dt m v0 fs\n        |> anti_derivative dt x0","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  type position_ft = mass -> position -> velocity -> list (time -> force) -> (time -> position)

  inl position_ft dt : position_ft =
      fun m x0 v0 fs =>
          velocity_ft dt m v0 fs
          |> anti_derivative dt x0
  """,
  timeout: 300_000
)
```

