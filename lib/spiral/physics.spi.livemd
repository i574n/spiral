<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":":== force_vector = vec\n:== two_body_force = particle_state -> particle_state -> force_vector\n\n:| force =\n    | ExternalForce : i32 * one_body_force\n    | InternalForce : i32 * i32 * two_body_force\n\n:! multi_particle_state_l = list particle_state\n\n:! d_multi_particle_state_l = list d_particle_state\n\n:= internal_force_on n sts n0 n1 f_two_body =\n    ? n = n0\n    ?> f_two_body (sts |> listm'::item n1)\n    |? n = n1\n    ?> f_two_body (sts |> listm'::item n0)\n    |: \\ _ => zero_vec ()\n\n:= force_on n sts force =\n    ?= force ?|\n    | ExternalForce (n0, f_one_body) =>\n        ? n = n0\n        ?> f_one_body\n        |: \\ _ => zero_vec ()\n    | InternalForce (n0, n1, f_two_body) => internal_force_on n sts n0 n1 f_two_body\n\n:= forces_on n (multi_particle_state_l sts) fs =\n    fs |> listm::map (force_on n sts)\n\n:= newton_second_mps fs (multi_particle_state_l sts) : d_multi_particle_state_l =\n    := deriv (n, st) =\n        newton_second_ps (forces_on n (multi_particle_state_l sts) fs) st\n    sts |> listm'::indexed |> listm::map deriv |> d_multi_particle_state_l\n\n:= update_mps_l (method : numerical_method multi_particle_state_l d_multi_particle_state_l) =\n    newton_second_mps >> method\n\n:+ (+++) d_multi_particle_state_l = \\ (d_multi_particle_state_l dsts1) (d_multi_particle_state_l dsts2) =>\n    d_multi_particle_state_l (listm'::zip_with_ (+++) dsts1 dsts2)\n\n:+ shift multi_particle_state_l = \\ dt dsts (multi_particle_state_l sts) =>\n    := (d_multi_particle_state_l dsts) =\n        ~>\n            ?= dsts ?|\n            | d_multi_particle_state_l _ => dsts\n    listm'::zip_with_ (shift dt) dsts sts |> multi_particle_state_l\n\n:= central_force f (particle_state st1) (particle_state st2) =\n    := r1 = st1::pos_vec\n    := r2 = st2::pos_vec\n    := r21 = r2 ^-^ r1\n    := r21mag = magnitude r21\n    f r21mag *^ r21 ^/ r21mag\n\n:= billiard_force k re =\n    := f r =\n        ? r >= re\n        ?> 0\n        |: -k * (r - re)\n    central_force f\n\n:+ scale d_multi_particle_state_l = \\ w (d_multi_particle_state_l dsts) =>\n    d_multi_particle_state_l (dsts |> listm::map (scale w))\n\n:= cromer_position dt ((particle_state st0), (particle_state st1)) =\n    particle_state { st1 ?| pos_vec = st0::pos_vec ^+^ st1::velocity ^* dt }\n\n:== mps_method_l = numerical_method multi_particle_state_l d_multi_particle_state_l\n\n:= euler_cromer_mps_l dt : mps_method_l =\n    \\ deriv mpst0 =>\n        := (multi_particle_state_l sts0) = mpst0\n        := (multi_particle_state_l sts1) = euler dt deriv mpst0\n        sts1 |> listm'::zip_ sts0 |> listm::map (cromer_position dt) |> multi_particle_state_l\n\n:= states_mps_l (method : numerical_method multi_particle_state_l d_multi_particle_state_l) =\n    newton_second_mps >> method >> seq::iterate_\n\n:= kinetic_energy (particle_state st) =\n    := m = st::mass\n    := v = magnitude st::velocity\n    0.5 * m * v ** 2\n\n:= system_ke_l (multi_particle_state_l sts) =\n    sts |> listm::map kinetic_energy |> listm'::sum\n\n:= linear_spring_pe k re (particle_state st1) (particle_state st2) =\n    := r1 = st1::pos_vec\n    := r2 = st2::pos_vec\n    := r21 = r2 ^-^ r1\n    := r21mag = magnitude r21\n    k * (r21mag - re) ** 2 / 2\n\n:= earth_surface_gravity_pe (particle_state st) =\n    := g = 9.80665\n    := m = st::mass\n    := z = st::pos_vec::z\n    m * g * z\n\n:= spring_pair_pe st0 st1 = linear_spring_pe 100 0.5 (default_particle_state ()) st0 + linear_spring_pe 100 0.5 st0 st1\n\n:= two_springs_pe (multi_particle_state_l sts) =\n    := st0 = sts |> listm'::item 0i32\n    := st1 = sts |> listm'::item 1i32\n    spring_pair_pe st0 st1 + earth_surface_gravity_pe st0 + earth_surface_gravity_pe st1\n\n:= two_springs_me mpst =\n    system_ke_l mpst + two_springs_pe mpst\n\n:= ball_radius () = 0.03\n\n:= billiard_forces_l k =\n    [ InternalForce (0, 1, billiard_force k (2 * ball_radius ())) ]\n\n:= billiard_update n_method k dt =\n    update_mps_l (n_method dt) (billiard_forces_l k)\n\n:= billiard_ball (at : vec) (velocity : vec) : particle_state =\n    := (particle_state st) = default_particle_state ()\n    particle_state { st ?| mass = 0.160; pos_vec = at; velocity = velocity }\n\n:= billiard_balls () : list particle_state =\n    [ billiard_ball (zero_vec ()) (0.2 *^ i_hat ()); billiard_ball (i_hat () ^+^ 0.02 *^ j_hat ()) (zero_vec ()) ]\n\n:= billiard_initial_l () = multi_particle_state_l (billiard_balls ())\n\n:= billiard_states_l ~n_method k dt =\n    states_mps_l (n_method dt) (billiard_forces_l k) (billiard_initial_l ())\n\n:= billiard_states_finite_l n_method k dt =\n    billiard_states_l n_method k dt\n    >> Some\n    |> seq::take_while_ (\\ (multi_particle_state_l mpst) (_ : i32) =>\n        (mpst |> listm'::item 0i32)::time <= 10\n    )\n\n:= momentum (particle_state st) =\n    := m = st::mass\n    := v = st::velocity\n    m *^ v\n\n:= system_p_l (multi_particle_state_l sts) =\n    sts |> listm::map momentum |> sum_vec\n\n:= ke_chart ec_x ec_y rk4_x rk4_y =\n    \"system kinetic energy versus time\",\n    \"time (s)\",\n    \"system kinetic energy (j)\",\n    ;[\n        \"euler-cromer\", ec_x, ec_y\n        \"runge-kutta 4\", rk4_x, rk4_y\n    ]\n\n:= ke_point_l (mpst : list particle_state) = (mpst |> listm'::item 0i32)::time, system_ke_l (multi_particle_state_l mpst)\n\n:= ke_curve_l n_method =\n    billiard_states_finite_l n_method 30 0.03\n    |> listm::map \\ (multi_particle_state_l mpst) => ke_point_l mpst\n    |> listm'::unzip\n    |> curve_arrays","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  :== force_vector = vec
  :== two_body_force = particle_state -> particle_state -> force_vector

  :| force =
      | ExternalForce : i32 * one_body_force
      | InternalForce : i32 * i32 * two_body_force

  :! multi_particle_state_l = list particle_state

  :! d_multi_particle_state_l = list d_particle_state

  := internal_force_on n sts n0 n1 f_two_body =
      ? n = n0
      ?> f_two_body (sts |> listm'::item n1)
      |? n = n1
      ?> f_two_body (sts |> listm'::item n0)
      |: \ _ => zero_vec ()

  := force_on n sts force =
      ?= force ?|
      | ExternalForce (n0, f_one_body) =>
          ? n = n0
          ?> f_one_body
          |: \ _ => zero_vec ()
      | InternalForce (n0, n1, f_two_body) => internal_force_on n sts n0 n1 f_two_body

  := forces_on n (multi_particle_state_l sts) fs =
      fs |> listm::map (force_on n sts)

  := newton_second_mps fs (multi_particle_state_l sts) : d_multi_particle_state_l =
      := deriv (n, st) =
          newton_second_ps (forces_on n (multi_particle_state_l sts) fs) st
      sts |> listm'::indexed |> listm::map deriv |> d_multi_particle_state_l

  := update_mps_l (method : numerical_method multi_particle_state_l d_multi_particle_state_l) =
      newton_second_mps >> method

  :+ (+++) d_multi_particle_state_l = \ (d_multi_particle_state_l dsts1) (d_multi_particle_state_l dsts2) =>
      d_multi_particle_state_l (listm'::zip_with_ (+++) dsts1 dsts2)

  :+ shift multi_particle_state_l = \ dt dsts (multi_particle_state_l sts) =>
      := (d_multi_particle_state_l dsts) =
          ~>
              ?= dsts ?|
              | d_multi_particle_state_l _ => dsts
      listm'::zip_with_ (shift dt) dsts sts |> multi_particle_state_l

  := central_force f (particle_state st1) (particle_state st2) =
      := r1 = st1::pos_vec
      := r2 = st2::pos_vec
      := r21 = r2 ^-^ r1
      := r21mag = magnitude r21
      f r21mag *^ r21 ^/ r21mag

  := billiard_force k re =
      := f r =
          ? r >= re
          ?> 0
          |: -k * (r - re)
      central_force f

  :+ scale d_multi_particle_state_l = \ w (d_multi_particle_state_l dsts) =>
      d_multi_particle_state_l (dsts |> listm::map (scale w))

  := cromer_position dt ((particle_state st0), (particle_state st1)) =
      particle_state { st1 ?| pos_vec = st0::pos_vec ^+^ st1::velocity ^* dt }

  :== mps_method_l = numerical_method multi_particle_state_l d_multi_particle_state_l

  := euler_cromer_mps_l dt : mps_method_l =
      \ deriv mpst0 =>
          := (multi_particle_state_l sts0) = mpst0
          := (multi_particle_state_l sts1) = euler dt deriv mpst0
          sts1 |> listm'::zip_ sts0 |> listm::map (cromer_position dt) |> multi_particle_state_l

  := states_mps_l (method : numerical_method multi_particle_state_l d_multi_particle_state_l) =
      newton_second_mps >> method >> seq::iterate_

  := kinetic_energy (particle_state st) =
      := m = st::mass
      := v = magnitude st::velocity
      0.5 * m * v ** 2

  := system_ke_l (multi_particle_state_l sts) =
      sts |> listm::map kinetic_energy |> listm'::sum

  := linear_spring_pe k re (particle_state st1) (particle_state st2) =
      := r1 = st1::pos_vec
      := r2 = st2::pos_vec
      := r21 = r2 ^-^ r1
      := r21mag = magnitude r21
      k * (r21mag - re) ** 2 / 2

  := earth_surface_gravity_pe (particle_state st) =
      := g = 9.80665
      := m = st::mass
      := z = st::pos_vec::z
      m * g * z

  := spring_pair_pe st0 st1 = linear_spring_pe 100 0.5 (default_particle_state ()) st0 + linear_spring_pe 100 0.5 st0 st1

  := two_springs_pe (multi_particle_state_l sts) =
      := st0 = sts |> listm'::item 0i32
      := st1 = sts |> listm'::item 1i32
      spring_pair_pe st0 st1 + earth_surface_gravity_pe st0 + earth_surface_gravity_pe st1

  := two_springs_me mpst =
      system_ke_l mpst + two_springs_pe mpst

  := ball_radius () = 0.03

  := billiard_forces_l k =
      [ InternalForce (0, 1, billiard_force k (2 * ball_radius ())) ]

  := billiard_update n_method k dt =
      update_mps_l (n_method dt) (billiard_forces_l k)

  := billiard_ball (at : vec) (velocity : vec) : particle_state =
      := (particle_state st) = default_particle_state ()
      particle_state { st ?| mass = 0.160; pos_vec = at; velocity = velocity }

  := billiard_balls () : list particle_state =
      [ billiard_ball (zero_vec ()) (0.2 *^ i_hat ()); billiard_ball (i_hat () ^+^ 0.02 *^ j_hat ()) (zero_vec ()) ]

  := billiard_initial_l () = multi_particle_state_l (billiard_balls ())

  := billiard_states_l ~n_method k dt =
      states_mps_l (n_method dt) (billiard_forces_l k) (billiard_initial_l ())

  := billiard_states_finite_l n_method k dt =
      billiard_states_l n_method k dt
      >> Some
      |> seq::take_while_ (\ (multi_particle_state_l mpst) (_ : i32) =>
          (mpst |> listm'::item 0i32)::time <= 10
      )

  := momentum (particle_state st) =
      := m = st::mass
      := v = st::velocity
      m *^ v

  := system_p_l (multi_particle_state_l sts) =
      sts |> listm::map momentum |> sum_vec

  := ke_chart ec_x ec_y rk4_x rk4_y =
      "system kinetic energy versus time",
      "time (s)",
      "system kinetic energy (j)",
      ;[
          "euler-cromer", ec_x, ec_y
          "runge-kutta 4", rk4_x, rk4_y
      ]

  := ke_point_l (mpst : list particle_state) = (mpst |> listm'::item 0i32)::time, system_ke_l (multi_particle_state_l mpst)

  := ke_curve_l n_method =
      billiard_states_finite_l n_method 30 0.03
      |> listm::map \ (multi_particle_state_l mpst) => ke_point_l mpst
      |> listm'::unzip
      |> curve_arrays
  """,
  timeout: 300_000
)
```

#### system_kinetic_energy_versus_time_1_2 (test)

