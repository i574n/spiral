<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":":= relativity_ps fs (st : particle_state) =\n    := f_net = net_force fs st\n    := u = st::velocity ^/ 299792458\n    rate_with st (sqrt (1 - (u <.> u)) *^ (f_net ^-^ (f_net <.> u) *^ u) ^/ st::mass)\n\n:= curve_arrays (xs, ys) = (xs |> listm'::box |> listm'::to_array'), (ys |> listm'::box |> listm'::to_array')\n\n:= seconds_per_year () = 365.25 * 24 * 60 * 60\n\n:= year_points states =\n    := year = seconds_per_year ()\n    states >> Some\n    |> seq::take_while_ \\ (particle_state st) (_ : i32) => st::time <= year\n    |> listm::map \\ (particle_state st) => st::time / year, st::velocity::x / 299792458\n    |> listm'::unzip\n\n:= constant_force_start () =\n    := (particle_state st) = default_particle_state ()\n    particle_state { st ?| mass = 1 }\n\n:= year_curve method deriv = solver_ method deriv (constant_force_start ()) |> year_points |> curve_arrays\n\n:~ ^ numbers_from (xs : array_base f64) (i : i32) : list string =\n    ? i >= am'::length_base xs ?> [] |: sm'::format_debug (am'::index_base i xs) :: numbers_from xs (i + 1i32)\n\n:= numbers_json (xs : array_base f64) : string =\n    sm'::concat_list \"\" [ \"[\"; numbers_from xs 0i32 |> sm'::concat_list \", \"; \"]\" ]\n\n:= series_json ((label, xs, ys) : string * array_base f64 * array_base f64) : string =\n    sm'::concat_list \"\" [ \"[\"; json::quote label; \", \"; numbers_json xs; \", \"; numbers_json ys; \"]\" ]\n\n:== chart = string * string * string * array (string * array_base f64 * array_base f64)\n\n:= chart_json ((caption, x, y, series) : chart) : string =\n    sm'::concat_list \"\" [\n        \"[\"; json::quote caption; \", \"; json::quote x; \", \"; json::quote y; \", [\"\n        series |> am'::map' series_json |> sm'::join' \", \"\n        \"]]\"\n    ]\n\n:= show_chart chart : () =\n    console::write_line (\n        sm'::concat_list \"\" [\n            \"SPIRAL_CELLS_DISPLAY_BEGIN\\napplication/vnd.spiral.plot+json\\n\"\n            chart_json chart\n            \"\\nSPIRAL_CELLS_DISPLAY_END\"\n        ]\n    )\n\n:~ ^ charts_from (cs : array_base chart) (i : i32)\n    : list string\n    =\n    ? i >= am'::length_base cs ?> [] |: chart_json (am'::index_base i cs) :: charts_from cs (i + 1i32)\n\n:= show_frames (charts : array_base chart) : () =\n    console::write_line (\n        sm'::concat_list \"\" [\n            \"SPIRAL_CELLS_DISPLAY_BEGIN\\napplication/vnd.spiral.plot-frames+json\\n[\"\n            charts_from charts 0i32 |> sm'::concat_list \", \"\n            \"]\\nSPIRAL_CELLS_DISPLAY_END\"\n        ]\n    )\n\n:= constant_force_chart newton_x newton_y relativity_y =\n    \"response to a constant force\",\n    \"time (years)\",\n    \"velocity (multiples of c)\",\n    ;[\n        \"newtonian\", newton_x, newton_y\n        \"relativistic\", newton_x, relativity_y\n    ]\n\n:= constant_force_chart_of method forces =\n    := newton_x, newton_y = year_curve method (newton_second_ps forces)\n    := _, relativity_y = year_curve method (relativity_ps forces)\n    constant_force_chart newton_x newton_y relativity_y","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  := relativity_ps fs (st : particle_state) =
      := f_net = net_force fs st
      := u = st::velocity ^/ 299792458
      rate_with st (sqrt (1 - (u <.> u)) *^ (f_net ^-^ (f_net <.> u) *^ u) ^/ st::mass)

  := curve_arrays (xs, ys) = (xs |> listm'::box |> listm'::to_array'), (ys |> listm'::box |> listm'::to_array')

  := seconds_per_year () = 365.25 * 24 * 60 * 60

  := year_points states =
      := year = seconds_per_year ()
      states >> Some
      |> seq::take_while_ \ (particle_state st) (_ : i32) => st::time <= year
      |> listm::map \ (particle_state st) => st::time / year, st::velocity::x / 299792458
      |> listm'::unzip

  := constant_force_start () =
      := (particle_state st) = default_particle_state ()
      particle_state { st ?| mass = 1 }

  := year_curve method deriv = solver_ method deriv (constant_force_start ()) |> year_points |> curve_arrays

  :~ ^ numbers_from (xs : array_base f64) (i : i32) : list string =
      ? i >= am'::length_base xs ?> [] |: sm'::format_debug (am'::index_base i xs) :: numbers_from xs (i + 1i32)

  := numbers_json (xs : array_base f64) : string =
      sm'::concat_list "" [ "["; numbers_from xs 0i32 |> sm'::concat_list ", "; "]" ]

  := series_json ((label, xs, ys) : string * array_base f64 * array_base f64) : string =
      sm'::concat_list "" [ "["; json::quote label; ", "; numbers_json xs; ", "; numbers_json ys; "]" ]

  :== chart = string * string * string * array (string * array_base f64 * array_base f64)

  := chart_json ((caption, x, y, series) : chart) : string =
      sm'::concat_list "" [
          "["; json::quote caption; ", "; json::quote x; ", "; json::quote y; ", ["
          series |> am'::map' series_json |> sm'::join' ", "
          "]]"
      ]

  := show_chart chart : () =
      console::write_line (
          sm'::concat_list "" [
              "SPIRAL_CELLS_DISPLAY_BEGIN\napplication/vnd.spiral.plot+json\n"
              chart_json chart
              "\nSPIRAL_CELLS_DISPLAY_END"
          ]
      )

  :~ ^ charts_from (cs : array_base chart) (i : i32)
      : list string
      =
      ? i >= am'::length_base cs ?> [] |: chart_json (am'::index_base i cs) :: charts_from cs (i + 1i32)

  := show_frames (charts : array_base chart) : () =
      console::write_line (
          sm'::concat_list "" [
              "SPIRAL_CELLS_DISPLAY_BEGIN\napplication/vnd.spiral.plot-frames+json\n["
              charts_from charts 0i32 |> sm'::concat_list ", "
              "]\nSPIRAL_CELLS_DISPLAY_END"
          ]
      )

  := constant_force_chart newton_x newton_y relativity_y =
      "response to a constant force",
      "time (years)",
      "velocity (multiples of c)",
      ;[
          "newtonian", newton_x, newton_y
          "relativistic", newton_x, relativity_y
      ]

  := constant_force_chart_of method forces =
      := newton_x, newton_y = year_curve method (newton_second_ps forces)
      := _, relativity_y = year_curve method (relativity_ps forces)
      constant_force_chart newton_x newton_y relativity_y
  """,
  timeout: 300_000
)
```

#### relativity_ps (test)

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":"///- --test --symbol\n\n:= ~method = runge_kutta_4 100000\nconstant_force_chart_of method [ \\ _ => 10 *^ i_hat () ] |> show_chart","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  ///- --test --symbol

  := ~method = runge_kutta_4 100000
  constant_force_chart_of method [ \ _ => 10 *^ i_hat () ] |> show_chart
  """,
  timeout: 300_000
)
```

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":":= uniform_lorentz_force v_e v_b (st : particle_state) =\n    st::charge *^ (v_e ^+^ st::velocity >< v_b)\n\n:= proton_start () =\n    := (particle_state st) = default_particle_state ()\n    particle_state { st ?|\n        mass = 0.000000000000000000000000001672621898\n        charge = 0.0000000000000000001602176621\n        velocity = 0.8 *^ (299792458f64 *^ j_hat ())\n    }\n\n:= orbit_points (steps : i32) states =\n    states >> Some\n    |> seq::take_while_ \\ (particle_state st) i => i < steps\n    |> listm::map \\ (particle_state st) => st::pos_vec::x, st::pos_vec::y\n    |> listm'::unzip\n    |> curve_arrays\n\n:= proton_curve method deriv (steps : i32) = solver_ method deriv (proton_start ()) |> orbit_points steps\n\n:= proton_chart newton_x newton_y relativity_x relativity_y =\n    \"proton in a 1-t magnetic field\",\n    \"x (m)\",\n    \"y (m)\",\n    ;[\n        \"newtonian\", newton_x, newton_y\n        \"relativistic\", relativity_x, relativity_y\n    ]\n\n:= proton_chart_of method forces =\n    := newton_x, newton_y = proton_curve method (newton_second_ps forces) 100i32\n    := relativity_x, relativity_y = proton_curve method (relativity_ps forces) 165i32\n    proton_chart newton_x newton_y relativity_x relativity_y","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  := uniform_lorentz_force v_e v_b (st : particle_state) =
      st::charge *^ (v_e ^+^ st::velocity >< v_b)

  := proton_start () =
      := (particle_state st) = default_particle_state ()
      particle_state { st ?|
          mass = 0.000000000000000000000000001672621898
          charge = 0.0000000000000000001602176621
          velocity = 0.8 *^ (299792458f64 *^ j_hat ())
      }

  := orbit_points (steps : i32) states =
      states >> Some
      |> seq::take_while_ \ (particle_state st) i => i < steps
      |> listm::map \ (particle_state st) => st::pos_vec::x, st::pos_vec::y
      |> listm'::unzip
      |> curve_arrays

  := proton_curve method deriv (steps : i32) = solver_ method deriv (proton_start ()) |> orbit_points steps

  := proton_chart newton_x newton_y relativity_x relativity_y =
      "proton in a 1-t magnetic field",
      "x (m)",
      "y (m)",
      ;[
          "newtonian", newton_x, newton_y
          "relativistic", relativity_x, relativity_y
      ]

  := proton_chart_of method forces =
      := newton_x, newton_y = proton_curve method (newton_second_ps forces) 100i32
      := relativity_x, relativity_y = proton_curve method (relativity_ps forces) 165i32
      proton_chart newton_x newton_y relativity_x relativity_y
  """,
  timeout: 300_000
)
```

