<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":":== update_function s = s -> s\n\n:== differential_equation s ds = s -> ds\n\n:== numerical_method s ds = differential_equation s ds -> update_function s\n\n:= solver method =\n    method >> seq::iterate\n\n:= solver' method =\n    method >> seq::iterate'\n\n:= solver_ method =\n    method >> seq::iterate_\n\n:= euler_cromer_1d dt deriv (state_1d (t0, x0, v0) &= t) =\n    := (rrr (_, _, dvdt)) = deriv t\n    := t1 = t0 + dt\n    := v1 = v0 + dvdt * dt\n    := x1 = x0 + v1 * dt\n    state_1d (t1, x1, v1)\n\n:= update_txv_ec dt m fs =\n    euler_cromer_1d dt (newton_second_1d m fs)\n\n:? (+++) ds : ds -> ds -> ds\n:? scale ds : f64 -> ds -> ds\n\n:+ (+++) rrr = \\ (rrr (dtdt0, dxdt0, dvdt0)) (rrr (dtdt1, dxdt1, dvdt1)) =>\n    rrr (dtdt0 + dtdt1, dxdt0 + dxdt1, dvdt0 + dvdt1)\n\n:+ scale rrr = \\ w (rrr (dtdt0, dxdt0, dvdt0)) =>\n    rrr (w * dtdt0, w * dxdt0, w * dvdt0)\n\n:? shift s : \\* ds. f64 -> ds -> s -> s\n\n:+ shift state_1d = \\ dt ds (state_1d (t, x, v)) =>\n    := dtdt, dxdt, dvdt =\n        ~>\n            ?= ds ?|\n            | rrr x => x\n            | state_1d x => x\n    state_1d (t + dtdt * dt, x + dxdt * dt, v + dvdt * dt)\n\n:= euler dt deriv st0 =\n    shift dt (deriv st0) st0\n\n:= runge_kutta_4 dt deriv st0 =\n    := m0 = deriv st0\n    := m1 = deriv (shift (dt / 2) m0 st0)\n    := m2 = deriv (shift (dt / 2) m1 st0)\n    := m3 = deriv (shift dt m2 st0)\n    shift (dt / 6) (m0 +++ m1 +++ m1 +++ m2 +++ m2 +++ m3) st0\n\n:= exponential (_, x0, v0) =\n    1f64, v0, x0\n\n:= of_state_1d (state_1d (t, x, v)) =\n    t, x, v","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  :== update_function s = s -> s

  :== differential_equation s ds = s -> ds

  :== numerical_method s ds = differential_equation s ds -> update_function s

  := solver method =
      method >> seq::iterate

  := solver' method =
      method >> seq::iterate'

  := solver_ method =
      method >> seq::iterate_

  := euler_cromer_1d dt deriv (state_1d (t0, x0, v0) &= t) =
      := (rrr (_, _, dvdt)) = deriv t
      := t1 = t0 + dt
      := v1 = v0 + dvdt * dt
      := x1 = x0 + v1 * dt
      state_1d (t1, x1, v1)

  := update_txv_ec dt m fs =
      euler_cromer_1d dt (newton_second_1d m fs)

  :? (+++) ds : ds -> ds -> ds
  :? scale ds : f64 -> ds -> ds

  :+ (+++) rrr = \ (rrr (dtdt0, dxdt0, dvdt0)) (rrr (dtdt1, dxdt1, dvdt1)) =>
      rrr (dtdt0 + dtdt1, dxdt0 + dxdt1, dvdt0 + dvdt1)

  :+ scale rrr = \ w (rrr (dtdt0, dxdt0, dvdt0)) =>
      rrr (w * dtdt0, w * dxdt0, w * dvdt0)

  :? shift s : \* ds. f64 -> ds -> s -> s

  :+ shift state_1d = \ dt ds (state_1d (t, x, v)) =>
      := dtdt, dxdt, dvdt =
          ~>
              ?= ds ?|
              | rrr x => x
              | state_1d x => x
      state_1d (t + dtdt * dt, x + dxdt * dt, v + dvdt * dt)

  := euler dt deriv st0 =
      shift dt (deriv st0) st0

  := runge_kutta_4 dt deriv st0 =
      := m0 = deriv st0
      := m1 = deriv (shift (dt / 2) m0 st0)
      := m2 = deriv (shift (dt / 2) m1 st0)
      := m3 = deriv (shift dt m2 st0)
      shift (dt / 6) (m0 +++ m1 +++ m1 +++ m2 +++ m2 +++ m3) st0

  := exponential (_, x0, v0) =
      1f64, v0, x0

  := of_state_1d (state_1d (t, x, v)) =
      t, x, v
  """,
  timeout: 300_000
)
```

