<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":":! particle_state =\n    {\n        mass : f64\n        charge : f64\n        time : f64\n        pos_vec : vec\n        velocity : vec\n    }\n\n:= default_particle_state () : particle_state =\n    particle_state {\n        mass = 1\n        charge = 0\n        time = 0\n        pos_vec = zero_vec ()\n        velocity = zero_vec ()\n    }\n\n:== one_body_force = particle_state -> vec\n\n:! d_particle_state =\n    {\n        dmdt : f64\n        dqdt : f64\n        dtdt : f64\n        drdt : vec\n        dvdt : vec\n    }\n\n:= net_force (fs : list one_body_force) (st : particle_state) : vec = fs |> listm::map (\\ f => f st) |> sum_vec\n\n:= rate_with (st : particle_state) (dvdt : vec) : d_particle_state =\n    d_particle_state {\n        dmdt = 0\n        dqdt = 0\n        dtdt = 1\n        drdt = st::velocity\n        dvdt = dvdt\n    }\n\n:= newton_second_ps (fs : list one_body_force) (st : particle_state) : d_particle_state =\n    rate_with st (net_force fs st ^/ st::mass)\n\n:= earth_surface_gravity (st : particle_state) =\n    := g = 9.80665\n    -st::mass * g *^ k_hat ()\n\n:= air_resistance drag rho area (st : particle_state) =\n    -0.5 * drag * rho * area * magnitude st::velocity *^ st::velocity\n\n:= cromer_moved dt (v' : vec) (particle_state st) : particle_state =\n    particle_state { st ?| time = st::time + dt; pos_vec = st::pos_vec ^+^ v' ^* dt; velocity = v' }\n\n:= euler_cromer_ps dt (deriv : particle_state -> d_particle_state) (particle_state st) =\n    := dst : d_particle_state = deriv (particle_state st)\n    cromer_moved dt (st::velocity ^+^ dst::dvdt ^* dt) (particle_state st)\n\n:+ (+++) d_particle_state = \\ (a : d_particle_state) b =>\n    d_particle_state {\n        dmdt = a::dmdt + b::dmdt\n        dqdt = a::dqdt + b::dqdt\n        dtdt = a::dtdt + b::dtdt\n        drdt = a::drdt ^+^ b::drdt\n        dvdt = a::dvdt ^+^ b::dvdt\n    }\n\n:+ scale d_particle_state = \\ w (dps : d_particle_state) =>\n    d_particle_state {\n        dmdt = w * dps::dmdt\n        dqdt = w * dps::dqdt\n        dtdt = w * dps::dtdt\n        drdt = w *^ dps::drdt\n        dvdt = w *^ dps::dvdt\n    }\n\n:= shifted dt (dps : d_particle_state) (particle_state st) : particle_state =\n    particle_state { st ?|\n        time = st::time + dps::dtdt * dt\n        pos_vec = st::pos_vec ^+^ dps::drdt ^* dt\n        velocity = st::velocity ^+^ dps::dvdt ^* dt\n    }\n\n:+ shift particle_state = \\ dt dps (particle_state st) =>\n    := (d_particle_state dps) =\n        ~>\n            ?= dps ?|\n            | d_particle_state _ => dps\n    shifted dt (d_particle_state dps) (particle_state st)\n\n:= states_ps (method : numerical_method particle_state d_particle_state) : _ -> _ -> i32 -> particle_state =\n    newton_second_ps >> method >> seq::iterate_\n\n:= z_ge0 sts =\n    sts\n    |> seq::take_while_ \\ (particle_state st) _ => st::pos_vec::z >= 0\n\n:= trajectory sts =\n    sts |> listm::map \\ (particle_state st) => st::pos_vec::y, st::pos_vec::z\n\n:= update_ps (method : numerical_method particle_state d_particle_state) =\n    newton_second_ps >> method\n\n:= step_count (states : i32 -> particle_state) t =\n    := dt = (states 1)::time - (states 0)::time\n    t / dt |> math::round |> abs\n\n:= position_ps (method : numerical_method particle_state d_particle_state) fs st t =\n    := st1 = solver' method (newton_second_ps fs) st (step_count (states_ps method fs st) t)\n    st1::pos_vec\n\n:= sun_gravity (st : particle_state) : vec =\n    := big_g = 0.0000000000667408\n    := sun_mass = 1988480000000000000000000000000\n    -big_g * sun_mass * st::mass *^ st::pos_vec ^/ magnitude st::pos_vec ** 3\n\n:= wind_force v_wind drag rho area (st : particle_state) =\n    := v_rel = st::velocity ^-^ v_wind\n    -0.5 * drag * rho * area * magnitude v_rel *^ v_rel\n\n:= rock_state () =\n    := (particle_state default_particle_state') = default_particle_state ()\n    particle_state { default_particle_state' ?|\n        mass = 2\n        velocity = vec 3 0 4\n    }\n\n:= halley_update dt =\n    update_ps (euler_cromer_ps dt) [ sun_gravity ]\n\n:= halley_initial () =\n    := (particle_state default_particle_state') = default_particle_state ()\n    particle_state { default_particle_state' ?|\n        mass = 220000000000000\n        pos_vec = 87660000000 *^ i_hat ()\n        velocity = 54569 *^ j_hat ()\n    }\n\n:= baseball_forces () =\n    := area = pi * (0.074 / 2) ** 2\n    [\n        earth_surface_gravity\n        air_resistance 0.3 1.225 area\n    ]\n\n:= baseball_initial v0 theta_deg =\n    := theta_rad = theta_deg * pi / 180\n    particle_state {\n        mass = 0.145\n        charge = 0\n        time = 0\n        pos_vec = zero_vec ()\n        velocity = vec 0 (v0 * cos theta_rad) (v0 * sin theta_rad)\n    }\n\n:= baseball_trajectory dt v0 theta_deg =\n    states_ps (euler_cromer_ps dt) (baseball_forces ()) (baseball_initial v0 theta_deg)\n    >> Some\n    |> z_ge0\n    |> trajectory\n\n:= baseball_range dt v0 theta_deg =\n    baseball_trajectory dt v0 theta_deg\n    |> listm::fold (\\ _ (y, _) => y) 0","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  :! particle_state =
      {
          mass : f64
          charge : f64
          time : f64
          pos_vec : vec
          velocity : vec
      }

  := default_particle_state () : particle_state =
      particle_state {
          mass = 1
          charge = 0
          time = 0
          pos_vec = zero_vec ()
          velocity = zero_vec ()
      }

  :== one_body_force = particle_state -> vec

  :! d_particle_state =
      {
          dmdt : f64
          dqdt : f64
          dtdt : f64
          drdt : vec
          dvdt : vec
      }

  := net_force (fs : list one_body_force) (st : particle_state) : vec = fs |> listm::map (\ f => f st) |> sum_vec

  := rate_with (st : particle_state) (dvdt : vec) : d_particle_state =
      d_particle_state {
          dmdt = 0
          dqdt = 0
          dtdt = 1
          drdt = st::velocity
          dvdt = dvdt
      }

  := newton_second_ps (fs : list one_body_force) (st : particle_state) : d_particle_state =
      rate_with st (net_force fs st ^/ st::mass)

  := earth_surface_gravity (st : particle_state) =
      := g = 9.80665
      -st::mass * g *^ k_hat ()

  := air_resistance drag rho area (st : particle_state) =
      -0.5 * drag * rho * area * magnitude st::velocity *^ st::velocity

  := cromer_moved dt (v' : vec) (particle_state st) : particle_state =
      particle_state { st ?| time = st::time + dt; pos_vec = st::pos_vec ^+^ v' ^* dt; velocity = v' }

  := euler_cromer_ps dt (deriv : particle_state -> d_particle_state) (particle_state st) =
      := dst : d_particle_state = deriv (particle_state st)
      cromer_moved dt (st::velocity ^+^ dst::dvdt ^* dt) (particle_state st)

  :+ (+++) d_particle_state = \ (a : d_particle_state) b =>
      d_particle_state {
          dmdt = a::dmdt + b::dmdt
          dqdt = a::dqdt + b::dqdt
          dtdt = a::dtdt + b::dtdt
          drdt = a::drdt ^+^ b::drdt
          dvdt = a::dvdt ^+^ b::dvdt
      }

  :+ scale d_particle_state = \ w (dps : d_particle_state) =>
      d_particle_state {
          dmdt = w * dps::dmdt
          dqdt = w * dps::dqdt
          dtdt = w * dps::dtdt
          drdt = w *^ dps::drdt
          dvdt = w *^ dps::dvdt
      }

  := shifted dt (dps : d_particle_state) (particle_state st) : particle_state =
      particle_state { st ?|
          time = st::time + dps::dtdt * dt
          pos_vec = st::pos_vec ^+^ dps::drdt ^* dt
          velocity = st::velocity ^+^ dps::dvdt ^* dt
      }

  :+ shift particle_state = \ dt dps (particle_state st) =>
      := (d_particle_state dps) =
          ~>
              ?= dps ?|
              | d_particle_state _ => dps
      shifted dt (d_particle_state dps) (particle_state st)

  := states_ps (method : numerical_method particle_state d_particle_state) : _ -> _ -> i32 -> particle_state =
      newton_second_ps >> method >> seq::iterate_

  := z_ge0 sts =
      sts
      |> seq::take_while_ \ (particle_state st) _ => st::pos_vec::z >= 0

  := trajectory sts =
      sts |> listm::map \ (particle_state st) => st::pos_vec::y, st::pos_vec::z

  := update_ps (method : numerical_method particle_state d_particle_state) =
      newton_second_ps >> method

  := step_count (states : i32 -> particle_state) t =
      := dt = (states 1)::time - (states 0)::time
      t / dt |> math::round |> abs

  := position_ps (method : numerical_method particle_state d_particle_state) fs st t =
      := st1 = solver' method (newton_second_ps fs) st (step_count (states_ps method fs st) t)
      st1::pos_vec

  := sun_gravity (st : particle_state) : vec =
      := big_g = 0.0000000000667408
      := sun_mass = 1988480000000000000000000000000
      -big_g * sun_mass * st::mass *^ st::pos_vec ^/ magnitude st::pos_vec ** 3

  := wind_force v_wind drag rho area (st : particle_state) =
      := v_rel = st::velocity ^-^ v_wind
      -0.5 * drag * rho * area * magnitude v_rel *^ v_rel

  := rock_state () =
      := (particle_state default_particle_state') = default_particle_state ()
      particle_state { default_particle_state' ?|
          mass = 2
          velocity = vec 3 0 4
      }

  := halley_update dt =
      update_ps (euler_cromer_ps dt) [ sun_gravity ]

  := halley_initial () =
      := (particle_state default_particle_state') = default_particle_state ()
      particle_state { default_particle_state' ?|
          mass = 220000000000000
          pos_vec = 87660000000 *^ i_hat ()
          velocity = 54569 *^ j_hat ()
      }

  := baseball_forces () =
      := area = pi * (0.074 / 2) ** 2
      [
          earth_surface_gravity
          air_resistance 0.3 1.225 area
      ]

  := baseball_initial v0 theta_deg =
      := theta_rad = theta_deg * pi / 180
      particle_state {
          mass = 0.145
          charge = 0
          time = 0
          pos_vec = zero_vec ()
          velocity = vec 0 (v0 * cos theta_rad) (v0 * sin theta_rad)
      }

  := baseball_trajectory dt v0 theta_deg =
      states_ps (euler_cromer_ps dt) (baseball_forces ()) (baseball_initial v0 theta_deg)
      >> Some
      |> z_ge0
      |> trajectory

  := baseball_range dt v0 theta_deg =
      baseball_trajectory dt v0 theta_deg
      |> listm::fold (\ _ (y, _) => y) 0
  """,
  timeout: 300_000
)
```

