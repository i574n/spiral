```elixir
Spiral.Cells.eval!(
  ~S"""
  ///- --test --symbol

  := ec_x, ec_y = ke_curve_l euler_cromer_mps_l
  := rk4_x, rk4_y = ke_curve_l runge_kutta_4
  ke_chart ec_x ec_y rk4_x rk4_y |> show_chart
  """,
  timeout: 300_000
)
```

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":":= linear_spring k re (particle_state st1) (particle_state st2) =\n    := r1 = st1::pos_vec\n    := r2 = st2::pos_vec\n    := r21 = r2 ^-^ r1\n    := r21mag = magnitude r21\n    -k * (r21mag - re) *^ r21 ^/ r21mag\n\n:= fixed_linear_spring k re r1 =\n    := (particle_state default_particle_state') = default_particle_state ()\n    linear_spring k re (particle_state { default_particle_state' ?| pos_vec = r1 })\n\n:= string_springs () =\n    listm'::init_series 0 59 1 |> listm::map \\ n => InternalForce (n, n + 1, linear_spring 5384 0)\n\n:= forces_string_l () =\n    [\n        ExternalForce (0, fixed_linear_spring 5384 0 (zero_vec ()))\n        ExternalForce (63, fixed_linear_spring 5384 0 (0.65 *^ i_hat ()))\n    ]\n    ++ string_springs ()\n\n:= string_update_l dt =\n    update_mps_l (runge_kutta_4 dt) (forces_string_l ())\n\n:= string_ball (x : f64) (y : f64) : particle_state =\n    := (particle_state st) = default_particle_state ()\n    particle_state { st ?|\n        mass = 0.0008293 * 0.65 / 64\n        pos_vec = x *^ i_hat () ^+^ y *^ j_hat ()\n        velocity = zero_vec ()\n    }\n\n:= overtone_y (n : i32) (x : f64) : f64 = 0.005 * sin (conv n * pi * x / 0.65)\n\n:= string_initial_overtone_l n =\n    listm'::init_series 0.01 0.64 0.01\n    |> listm::map \\ x => string_ball x (overtone_y n x)\n    |> multi_particle_state_l\n\n:= pluck_y (x : f64) : f64 =\n    := n = ? x <= 0.51 ?> 0 |: 0.65\n    0.005 / (0.51 - n) * (x - n)\n\n:= string_initial_pluck_l () =\n    listm'::init_series 0.01 0.64 0.01\n    |> listm::map \\ x => string_ball x (pluck_y x)\n    |> multi_particle_state_l\n\n:= string_positions_l sts =\n    [ zero_vec () ] ++ (sts |> listm::map (\\ (particle_state st) => st::pos_vec)) ++ [ 0.65 *^ i_hat () ]\n\n:= string_frame_l initial_state (_ : f64) =\n    := (multi_particle_state_l sts) = seq::iterate' (string_update_l 0.000025) initial_state |> \\ f => f 0f64\n    string_positions_l sts |> listm::map (\\ r => r::x, r::y) |> listm'::unzip |> curve_arrays\n\n:= string_frames_l () =\n    := ~frames = listm'::init_series 0 9 1f64\n    := initial_state = string_initial_overtone_l 3i32\n    frames |> listm::map (string_frame_l initial_state) |> listm'::box |> listm'::to_array'","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  := linear_spring k re (particle_state st1) (particle_state st2) =
      := r1 = st1::pos_vec
      := r2 = st2::pos_vec
      := r21 = r2 ^-^ r1
      := r21mag = magnitude r21
      -k * (r21mag - re) *^ r21 ^/ r21mag

  := fixed_linear_spring k re r1 =
      := (particle_state default_particle_state') = default_particle_state ()
      linear_spring k re (particle_state { default_particle_state' ?| pos_vec = r1 })

  := string_springs () =
      listm'::init_series 0 59 1 |> listm::map \ n => InternalForce (n, n + 1, linear_spring 5384 0)

  := forces_string_l () =
      [
          ExternalForce (0, fixed_linear_spring 5384 0 (zero_vec ()))
          ExternalForce (63, fixed_linear_spring 5384 0 (0.65 *^ i_hat ()))
      ]
      ++ string_springs ()

  := string_update_l dt =
      update_mps_l (runge_kutta_4 dt) (forces_string_l ())

  := string_ball (x : f64) (y : f64) : particle_state =
      := (particle_state st) = default_particle_state ()
      particle_state { st ?|
          mass = 0.0008293 * 0.65 / 64
          pos_vec = x *^ i_hat () ^+^ y *^ j_hat ()
          velocity = zero_vec ()
      }

  := overtone_y (n : i32) (x : f64) : f64 = 0.005 * sin (conv n * pi * x / 0.65)

  := string_initial_overtone_l n =
      listm'::init_series 0.01 0.64 0.01
      |> listm::map \ x => string_ball x (overtone_y n x)
      |> multi_particle_state_l

  := pluck_y (x : f64) : f64 =
      := n = ? x <= 0.51 ?> 0 |: 0.65
      0.005 / (0.51 - n) * (x - n)

  := string_initial_pluck_l () =
      listm'::init_series 0.01 0.64 0.01
      |> listm::map \ x => string_ball x (pluck_y x)
      |> multi_particle_state_l

  := string_positions_l sts =
      [ zero_vec () ] ++ (sts |> listm::map (\ (particle_state st) => st::pos_vec)) ++ [ 0.65 *^ i_hat () ]

  := string_frame_l initial_state (_ : f64) =
      := (multi_particle_state_l sts) = seq::iterate' (string_update_l 0.000025) initial_state |> \ f => f 0f64
      string_positions_l sts |> listm::map (\ r => r::x, r::y) |> listm'::unzip |> curve_arrays

  := string_frames_l () =
      := ~frames = listm'::init_series 0 9 1f64
      := initial_state = string_initial_overtone_l 3i32
      frames |> listm::map (string_frame_l initial_state) |> listm'::box |> listm'::to_array'
  """,
  timeout: 300_000
)
```

#### wave_1 (test)

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":"///- --test --symbol\n\n:= n = 0i32\n:= x, y = array (string_frames_l ()) |> am'::index n\n(\"wave\", \"position (m)\", \"displacement (m)\", ;[ sm'::format n, x, y ]) |> show_chart","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  ///- --test --symbol

  := n = 0i32
  := x, y = array (string_frames_l ()) |> am'::index n
  ("wave", "position (m)", "displacement (m)", ;[ sm'::format n, x, y ]) |> show_chart
  """,
  timeout: 300_000
)
```

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":":! multi_particle_state_s = stream::stream particle_state\n\n:! d_multi_particle_state_s = stream::stream d_particle_state\n\n:= internal_force_on_s n s n0 n1 f_two_body =\n    ? n = n0\n    ?> s |> stream::try_item n1 |> optionm::map f_two_body\n    |? n = n1\n    ?> s |> stream::try_item n0 |> optionm::map f_two_body\n    |: None\n    |> optionm'::default_value \\ _ => zero_vec ()\n\n:= force_on_s n s force =\n    ?= force ?|\n    | ExternalForce (n0, f_one_body) =>\n        ? n = n0\n        ?> f_one_body\n        |: \\ _ => zero_vec ()\n    | InternalForce (n0, n1, f_two_body) => internal_force_on_s n s n0 n1 f_two_body\n\n:= forces_on_s n (multi_particle_state_s sts) fs =\n    fs\n    |> listm::map (force_on_s n sts)\n\n:= newton_second_mps_s fs ((multi_particle_state_s sts) &= mpst) =\n    := deriv (n, st) =\n        newton_second_ps (forces_on_s n mpst fs) st\n    sts |> stream::indexed |> stream::map deriv |> d_multi_particle_state_s\n\n:= update_mps_s (method : numerical_method multi_particle_state_s d_multi_particle_state_s) =\n    newton_second_mps_s >> method\n\n:= stream_shifted dt (dsts : stream::stream d_particle_state) (sts : stream::stream particle_state) =\n    (dsts, sts)\n    ||> stream::zip_with (shift dt)\n    |> stream::memoize\n    |> \\ x => x ()\n    |> multi_particle_state_s\n\n:+ shift multi_particle_state_s = \\ dt dsts (multi_particle_state_s sts) =>\n    := (d_multi_particle_state_s dsts) =\n        ~>\n            ?= dsts ?|\n            | d_multi_particle_state_s _ => dsts\n    stream_shifted dt dsts sts\n\n:+ (+++) d_multi_particle_state_s =\n    \\ (d_multi_particle_state_s dsts1) (d_multi_particle_state_s dsts2) =>\n        (dsts1, dsts2)\n        ||> stream::zip_with (+++)\n        |> d_multi_particle_state_s\n\n:+ scale d_multi_particle_state_s = \\ w (d_multi_particle_state_s dsts) =>\n    dsts\n    |> stream::map (scale w)\n    |> d_multi_particle_state_s\n\n:== mps_method_s = numerical_method multi_particle_state_s d_multi_particle_state_s\n\n:= euler_cromer_mps_s dt : mps_method_s =\n    \\ deriv ((multi_particle_state_s sts0) &= mpst0) =>\n        := (multi_particle_state_s sts1) = euler dt deriv mpst0\n        (sts0, sts1) ||> stream::zip |> stream::map (cromer_position dt) |> multi_particle_state_s\n\n:= memoized_into next (multi_particle_state_s y) =\n    y |> stream::memoize |> (\\ thunk => thunk ()) |> multi_particle_state_s |> next\n\n:= states_mps_s (method : numerical_method multi_particle_state_s d_multi_particle_state_s) =\n    newton_second_mps_s >> method >> memoized_into >> seq::iterate'\n\n:= system_ke_s (multi_particle_state_s sts) =\n    sts\n    |> stream::map kinetic_energy\n    |> stream::sum\n\n:= billiard_forces_s k =\n    [ InternalForce (0i32, 1, billiard_force k (2 * ball_radius ())) ]\n\n:= billiard_initial_s () = billiard_balls () |> stream::from_list |> multi_particle_state_s\n\n:= billiard_states_s ~n_method k dt =\n    states_mps_s (n_method dt) (billiard_forces_s k) (billiard_initial_s ())\n\n:= early_billiards_s (multi_particle_state_s mpst) (_ : i32) : bool =\n    ?= mpst |> stream::try_item 0i32 ?|\n    | Some st => st::time <= 10\n    | None => !-\n\n:= billiard_states_finite_s n_method k dt =\n    billiard_states_s n_method k dt >> Some |> seq::take_while_ early_billiards_s\n\n:= system_p_s (multi_particle_state_s sts) =\n    sts\n    |> stream::map momentum\n    |> stream::fold (^+^) (zero_vec ())\n\n:= ke_point_s (mpst : stream::stream particle_state) =\n    mpst |> stream::try_item 0i32 |> optionm::map \\ st => st::time, system_ke_s (multi_particle_state_s mpst)\n\n:= ke_curve_s n_method =\n    billiard_states_finite_s n_method 30 0.03\n    |> listm::map \\ (multi_particle_state_s mpst) => ke_point_s mpst\n    |> listm'::choose id\n    |> listm'::unzip\n    |> curve_arrays","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  :! multi_particle_state_s = stream::stream particle_state

  :! d_multi_particle_state_s = stream::stream d_particle_state

  := internal_force_on_s n s n0 n1 f_two_body =
      ? n = n0
      ?> s |> stream::try_item n1 |> optionm::map f_two_body
      |? n = n1
      ?> s |> stream::try_item n0 |> optionm::map f_two_body
      |: None
      |> optionm'::default_value \ _ => zero_vec ()

  := force_on_s n s force =
      ?= force ?|
      | ExternalForce (n0, f_one_body) =>
          ? n = n0
          ?> f_one_body
          |: \ _ => zero_vec ()
      | InternalForce (n0, n1, f_two_body) => internal_force_on_s n s n0 n1 f_two_body

  := forces_on_s n (multi_particle_state_s sts) fs =
      fs
      |> listm::map (force_on_s n sts)

  := newton_second_mps_s fs ((multi_particle_state_s sts) &= mpst) =
      := deriv (n, st) =
          newton_second_ps (forces_on_s n mpst fs) st
      sts |> stream::indexed |> stream::map deriv |> d_multi_particle_state_s

  := update_mps_s (method : numerical_method multi_particle_state_s d_multi_particle_state_s) =
      newton_second_mps_s >> method

  := stream_shifted dt (dsts : stream::stream d_particle_state) (sts : stream::stream particle_state) =
      (dsts, sts)
      ||> stream::zip_with (shift dt)
      |> stream::memoize
      |> \ x => x ()
      |> multi_particle_state_s

  :+ shift multi_particle_state_s = \ dt dsts (multi_particle_state_s sts) =>
      := (d_multi_particle_state_s dsts) =
          ~>
              ?= dsts ?|
              | d_multi_particle_state_s _ => dsts
      stream_shifted dt dsts sts

  :+ (+++) d_multi_particle_state_s =
      \ (d_multi_particle_state_s dsts1) (d_multi_particle_state_s dsts2) =>
          (dsts1, dsts2)
          ||> stream::zip_with (+++)
          |> d_multi_particle_state_s

  :+ scale d_multi_particle_state_s = \ w (d_multi_particle_state_s dsts) =>
      dsts
      |> stream::map (scale w)
      |> d_multi_particle_state_s

  :== mps_method_s = numerical_method multi_particle_state_s d_multi_particle_state_s

  := euler_cromer_mps_s dt : mps_method_s =
      \ deriv ((multi_particle_state_s sts0) &= mpst0) =>
          := (multi_particle_state_s sts1) = euler dt deriv mpst0
          (sts0, sts1) ||> stream::zip |> stream::map (cromer_position dt) |> multi_particle_state_s

  := memoized_into next (multi_particle_state_s y) =
      y |> stream::memoize |> (\ thunk => thunk ()) |> multi_particle_state_s |> next

  := states_mps_s (method : numerical_method multi_particle_state_s d_multi_particle_state_s) =
      newton_second_mps_s >> method >> memoized_into >> seq::iterate'

  := system_ke_s (multi_particle_state_s sts) =
      sts
      |> stream::map kinetic_energy
      |> stream::sum

  := billiard_forces_s k =
      [ InternalForce (0i32, 1, billiard_force k (2 * ball_radius ())) ]

  := billiard_initial_s () = billiard_balls () |> stream::from_list |> multi_particle_state_s

  := billiard_states_s ~n_method k dt =
      states_mps_s (n_method dt) (billiard_forces_s k) (billiard_initial_s ())

  := early_billiards_s (multi_particle_state_s mpst) (_ : i32) : bool =
      ?= mpst |> stream::try_item 0i32 ?|
      | Some st => st::time <= 10
      | None => !-

  := billiard_states_finite_s n_method k dt =
      billiard_states_s n_method k dt >> Some |> seq::take_while_ early_billiards_s

  := system_p_s (multi_particle_state_s sts) =
      sts
      |> stream::map momentum
      |> stream::fold (^+^) (zero_vec ())

  := ke_point_s (mpst : stream::stream particle_state) =
      mpst |> stream::try_item 0i32 |> optionm::map \ st => st::time, system_ke_s (multi_particle_state_s mpst)

  := ke_curve_s n_method =
      billiard_states_finite_s n_method 30 0.03
      |> listm::map \ (multi_particle_state_s mpst) => ke_point_s mpst
      |> listm'::choose id
      |> listm'::unzip
      |> curve_arrays
  """,
  timeout: 300_000
)
```

#### system_kinetic_energy_versus_time_2_2 (test)

