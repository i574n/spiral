<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":":== mass = f64\n:== time = f64\n:== position = f64\n:== velocity = f64\n:== scalar_force = f64\n\n:== velocity_cf = mass -> velocity -> list scalar_force -> (time -> velocity)\n\n:= velocity_cf m v0 fs =\n    := f_net = fs |> listm'::sum\n    := a0 = f_net / m\n    := v t = v0 + a0 * t\n    v","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  :== mass = f64
  :== time = f64
  :== position = f64
  :== velocity = f64
  :== scalar_force = f64

  :== velocity_cf = mass -> velocity -> list scalar_force -> (time -> velocity)

  := velocity_cf m v0 fs =
      := f_net = fs |> listm'::sum
      := a0 = f_net / m
      := v t = v0 + a0 * t
      v
  """,
  timeout: 300_000
)
```

