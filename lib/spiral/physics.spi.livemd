<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":":= anti_derivative dt v0 a t =\n    v0 + integral' dt a 0 t\n\n:== velocity_ft = mass -> velocity -> list (time -> scalar_force) -> (time -> velocity)\n\n:= velocity_ft dt : velocity_ft =\n    \\ m v0 fs =>\n        := f_net t = fs |> listm::map (\\ f => f t) |> listm'::sum\n        := a t = f_net t / m\n        anti_derivative dt v0 a\n\n:== position_ft = mass -> position -> velocity -> list (time -> scalar_force) -> (time -> position)\n\n:= position_ft dt : position_ft =\n    \\ m x0 v0 fs =>\n        velocity_ft dt m v0 fs\n        |> anti_derivative dt x0\n\n:= pedal_coast (t : time) : scalar_force =\n    := t_cycle = 20\n    := n_complete : i32 = t / t_cycle |> conv\n    := remainder = t - conv n_complete * t_cycle\n    ? remainder > 0 && remainder < 10\n    ?> 10\n    |: 0","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  := anti_derivative dt v0 a t =
      v0 + integral' dt a 0 t

  :== velocity_ft = mass -> velocity -> list (time -> scalar_force) -> (time -> velocity)

  := velocity_ft dt : velocity_ft =
      \ m v0 fs =>
          := f_net t = fs |> listm::map (\ f => f t) |> listm'::sum
          := a t = f_net t / m
          anti_derivative dt v0 a

  :== position_ft = mass -> position -> velocity -> list (time -> scalar_force) -> (time -> position)

  := position_ft dt : position_ft =
      \ m x0 v0 fs =>
          velocity_ft dt m v0 fs
          |> anti_derivative dt x0

  := pedal_coast (t : time) : scalar_force =
      := t_cycle = 20
      := n_complete : i32 = t / t_cycle |> conv
      := remainder = t - conv n_complete * t_cycle
      ? remainder > 0 && remainder < 10
      ?> 10
      |: 0
  """,
  timeout: 300_000
)
```

