<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":":! state_1d = time * position * velocity\n:! rrr = f64 * f64 * f64\n\n:= newton_second_1d m fs (state_1d (t, x0, v0)) =\n    := f_net = fs |> listm::map (\\ f => f (state_1d (t, x0, v0))) |> listm'::sum\n    := acc = f_net / m\n    rrr (1f64, v0, acc)\n\n:= euler_1d dt deriv (state_1d (t0, x0, v0) &= t) =\n    := (rrr (_, _, dvdt)) = deriv t\n    := t1 = t0 + dt\n    := x1 = x0 + v0 * dt\n    := v1 = v0 + dvdt * dt\n    state_1d (t1, x1, v1)\n\n:= update_txv dt m fs =\n    newton_second_1d m fs |> euler_1d dt\n\n:= states_txv dt m txv0 fs =\n    seq::iterate_ (update_txv dt m fs) txv0\n\n:= velocity_1d sts t =\n    := (state_1d (t0, _, _)) = sts 0\n    := (state_1d (t1, _, _)) = sts 1\n    := dt = t1 - t0\n    := num_steps = t / dt |> math::round |> abs\n    := (state_1d (_, _, v0)) = sts num_steps\n    v0\n\n:= velocity_ftxv dt m txv0 fs =\n    states_txv dt m txv0 fs |> velocity_1d\n\n:= position_1d sts t =\n    := (state_1d (t0, _, _)) = sts 0\n    := (state_1d (t1, _, _)) = sts 1\n    := dt = t1 - t0\n    := num_steps = t / dt |> math::round |> abs\n    := (state_1d (_, x0, _)) = sts num_steps\n    x0\n\n:= position_ftxv dt m txv0 fs =\n    states_txv dt m txv0 fs |> position_1d\n\n:= spring_force k (state_1d (_, x0, _)) =\n    -k * x0\n\n:= damped_ho_forces () =\n    [\n        spring_force 0.8\n        \\ (state_1d (_, _, v0)) => f_air 2 1.225 (pi * math::square 0.02) v0\n        \\ _ => -0.0027 * 9.80665\n    ]\n\n:= pingpong_position t = position_ftxv 0.001 0.0027 (state_1d (0, 0.1, 0)) (damped_ho_forces ()) t","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  :! state_1d = time * position * velocity
  :! rrr = f64 * f64 * f64

  := newton_second_1d m fs (state_1d (t, x0, v0)) =
      := f_net = fs |> listm::map (\ f => f (state_1d (t, x0, v0))) |> listm'::sum
      := acc = f_net / m
      rrr (1f64, v0, acc)

  := euler_1d dt deriv (state_1d (t0, x0, v0) &= t) =
      := (rrr (_, _, dvdt)) = deriv t
      := t1 = t0 + dt
      := x1 = x0 + v0 * dt
      := v1 = v0 + dvdt * dt
      state_1d (t1, x1, v1)

  := update_txv dt m fs =
      newton_second_1d m fs |> euler_1d dt

  := states_txv dt m txv0 fs =
      seq::iterate_ (update_txv dt m fs) txv0

  := velocity_1d sts t =
      := (state_1d (t0, _, _)) = sts 0
      := (state_1d (t1, _, _)) = sts 1
      := dt = t1 - t0
      := num_steps = t / dt |> math::round |> abs
      := (state_1d (_, _, v0)) = sts num_steps
      v0

  := velocity_ftxv dt m txv0 fs =
      states_txv dt m txv0 fs |> velocity_1d

  := position_1d sts t =
      := (state_1d (t0, _, _)) = sts 0
      := (state_1d (t1, _, _)) = sts 1
      := dt = t1 - t0
      := num_steps = t / dt |> math::round |> abs
      := (state_1d (_, x0, _)) = sts num_steps
      x0

  := position_ftxv dt m txv0 fs =
      states_txv dt m txv0 fs |> position_1d

  := spring_force k (state_1d (_, x0, _)) =
      -k * x0

  := damped_ho_forces () =
      [
          spring_force 0.8
          \ (state_1d (_, _, v0)) => f_air 2 1.225 (pi * math::square 0.02) v0
          \ _ => -0.0027 * 9.80665
      ]

  := pingpong_position t = position_ftxv 0.001 0.0027 (state_1d (0, 0.1, 0)) (damped_ho_forces ()) t
  """,
  timeout: 300_000
)
```

