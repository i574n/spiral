<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":":= forces_string_s () =\n    [\n        ExternalForce (0i32, fixed_linear_spring 5384 0 (zero_vec ()))\n        ExternalForce (63, fixed_linear_spring 5384 0 (0.65 *^ i_hat ()))\n    ]\n    ++ string_springs ()\n\n:= string_update_s dt =\n    update_mps_s (~~ runge_kutta_4 dt) (~~ forces_string_s ())\n\n:= string_initial_overtone_s n =\n    listm'::init_series 0.01 0.64 0.01\n    |> listm::map \\ x => string_ball x (overtone_y n x)\n    |> stream::from_list\n    |> multi_particle_state_s\n\n:= string_points_s sts =\n    [ zero_vec () ]\n    ++ (sts |> stream::map (\\ (particle_state st) => st::pos_vec) |> stream::to_list)\n    ++ [ 0.65 *^ i_hat () ]\n    |> listm::map \\ r => r::x, r::y\n\n:= stream_arrays (xs, ys) =\n    (xs |> stream::to_list |> listm'::box |> listm'::to_array'), (ys |> stream::to_list |> listm'::box |> listm'::to_array')\n\n:= string_frame_s initial_state n =\n    := (multi_particle_state_s sts) = stream::iterate (string_update_s 0.000025) initial_state |> stream::item n\n    string_points_s sts |> stream::from_list |> stream::unzip |> stream_arrays\n\n:= wave_plot (n : i32) x y = \"wave\", \"position (m)\", \"displacement (m)\", ;[ sm'::format n, x, y ]\n\n:= string_frames_s () =\n    := ~frames = listm'::init_series 0 65 1f64 |> stream::from_list\n    := ~initial_state = string_initial_overtone_s 3i32\n    frames |> stream::map (string_frame_s initial_state)","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  := forces_string_s () =
      [
          ExternalForce (0i32, fixed_linear_spring 5384 0 (zero_vec ()))
          ExternalForce (63, fixed_linear_spring 5384 0 (0.65 *^ i_hat ()))
      ]
      ++ string_springs ()

  := string_update_s dt =
      update_mps_s (~~ runge_kutta_4 dt) (~~ forces_string_s ())

  := string_initial_overtone_s n =
      listm'::init_series 0.01 0.64 0.01
      |> listm::map \ x => string_ball x (overtone_y n x)
      |> stream::from_list
      |> multi_particle_state_s

  := string_points_s sts =
      [ zero_vec () ]
      ++ (sts |> stream::map (\ (particle_state st) => st::pos_vec) |> stream::to_list)
      ++ [ 0.65 *^ i_hat () ]
      |> listm::map \ r => r::x, r::y

  := stream_arrays (xs, ys) =
      (xs |> stream::to_list |> listm'::box |> listm'::to_array'), (ys |> stream::to_list |> listm'::box |> listm'::to_array')

  := string_frame_s initial_state n =
      := (multi_particle_state_s sts) = stream::iterate (string_update_s 0.000025) initial_state |> stream::item n
      string_points_s sts |> stream::from_list |> stream::unzip |> stream_arrays

  := wave_plot (n : i32) x y = "wave", "position (m)", "displacement (m)", ;[ sm'::format n, x, y ]

  := string_frames_s () =
      := ~frames = listm'::init_series 0 65 1f64 |> stream::from_list
      := ~initial_state = string_initial_overtone_s 3i32
      frames |> stream::map (string_frame_s initial_state)
  """,
  timeout: 300_000
)
```

