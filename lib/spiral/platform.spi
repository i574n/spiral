/// # platform
test platform static =
    :< testing

:< rust.rust_operators

/// ## fsharp

/// ### os_platform
:! os_platform' = $'System.Runtime.InteropServices.OSPlatform'

:| os_platform =
    | FreeBSD
    | Linux
    | OSX
    | Windows

:= os_platform = \|
    | FreeBSD => $'`os_platform'.FreeBSD' : os_platform'
    | Linux => $'`os_platform'.Linux' : os_platform'
    | OSX => $'`os_platform'.OSX' : os_platform'
    | Windows => $'`os_platform'.Windows' : os_platform'

/// ### run_platform
:= run_platform \* t. (fn : os_platform -> (() -> t)) : t =
    := result = dyn !+
    $'let mutable _run_platform_!result : `t option = None '
    $'\n\#if _FREEBSD'
    fn FreeBSD () |> emit_unit
    $'\#endif\n\#if _LINUX'
    fn Linux () |> emit_unit
    $'\#endif\n\#if _OSX'
    fn OSX () |> emit_unit
    $'\#endif\n\#if _WINDOWS'
    fn Windows () |> emit_unit
    $'\#endif'
    $'|> fun x -> _run_platform_!result <- Some x'
    $'match _run_platform_!result with Some x -> x | None -> failwith "runtime.run_platform / \
        _run_platform_!result=None"'

/// ### is_os_platform
:= is_os_platform (x : os_platform') : bool =
    x |> $'System.Runtime.InteropServices.RuntimeInformation.IsOSPlatform'

/// ### is_windows'
:= is_windows' () : bool =
    run_platform \|
        | Windows => \ () => !+
        | _ => \ () => !-

/// ## platform

/// ### is_windows
:= is_windows () : bool =
    run_target \|
        | Rust => \ () => $'cfg\!(windows)' : bool
        | Fsharp => \ () => Windows |> os_platform |> is_os_platform
        | Gleam => \ () =>
            backend_switch {
                Gleam = \ () =>
                    global "import gleam/erlang/atom"
                    global "@external(erlang, \"os\", \"type\") fn platform_os_type() -> #(atom.Atom, atom.Atom)"
            }
            $'atom.to_string(platform_os_type().0) == "win32"' : bool
        | Zig => \ () => $'(\@import("builtin").os.tag == .windows)' : bool
        | _ => \ () => failwith "platform.is_windows / no arm for this target"

/// ### get_executable_suffix
:= get_executable_suffix () =
    ? is_windows ()
    ?> ".exe"
    |: ""

test get_executable_suffix =
    get_executable_suffix ()

/// ### os_command_output
:= os_command_output (command : string) : string =
    run_target \|
        | Gleam => \ () =>
            := output = erlang_term.apply "os" "cmd" [ erlang_term.charlist command ]
            erlang_term.apply "unicode" "characters_to_binary" [ output ] |> erlang_term.cast
        | _ => \ () => failwith "os_command_output: no arm for this backend"

///> gleam
test an_os_command_returns_its_output =
    os_command_output "echo spiral" |> sm'.trim |> _assert_eq "spiral"

/// ## main
///> fsharp

:= main () =
    $'let is_windows () = !is_windows ()' : ()
    $'let get_executable_suffix () = !get_executable_suffix ()' : ()
