/// # reactors
///> c
///> rust
test reactors static =
    :< testing

/// ### signal
:| signal t =
    | Present : t
    | Absent

/// ### tag
:== tag = { time : i64; micro : i32 }

/// ### reactor
:== reactor s i o = { init : s; react : s -> tag -> i -> s * o }

/// ### chain
:= chain \* sa sb i m o. (a : reactor sa i m) (b : reactor sb m o) : reactor (sa * sb) i o =
    {
        init = a.init, b.init
        react = \ (sa, sb) now x =>
            := sa, mid = a.react sa now x
            := sb, y = b.react sb now mid
            (sa, sb), y
    }

/// ### both
:= both \* sa sb i oa ob. (a : reactor sa i oa) (b : reactor sb i ob) : reactor (sa * sb) i (oa * ob) =
    {
        init = a.init, b.init
        react = \ (sa, sb) now x =>
            := sa, ya = a.react sa now x
            := sb, yb = b.react sb now x
            (sa, sb), (ya, yb)
    }

/// ### with_deadline
:= with_deadline \* s o.
    (deadline : i64) (body : reactor s i64 o) (on_violation : s -> tag -> s * o)
    : reactor s i64 o
    =
    {
        init = body.init
        react = \ state now lag =>
            ? lag > deadline ?> on_violation state now |: body.react state now lag
    }

/// ### modal
:| mode_entry =
    | Reset
    | History

:| reactor_mode =
    | FirstMode
    | SecondMode

:= modal \* sa sb i o.
    (entry : mode_entry) (first : reactor sa i o) (second : reactor sb i o) (leave : o -> bool)
    : reactor (reactor_mode * sa * sb) i o
    =
    := entered_second sb = ?= entry ?| | Reset => second.init | History => sb
    := entered_first sa = ?= entry ?| | Reset => first.init | History => sa
    {
        init = FirstMode, first.init, second.init
        react = \ (mode, sa, sb) now x =>
            ?= mode ?|
            | FirstMode =>
                := sa, y = first.react sa now x
                ? leave y ?> (SecondMode, sa, entered_second sb), y |: (FirstMode, sa, sb), y
            | SecondMode =>
                := sb, y = second.react sb now x
                ? leave y ?> (FirstMode, entered_first sa, sb), y |: (SecondMode, sa, sb), y
    }

/// ### run_ticks
:= run_ticks \* s i o. (program : reactor s i o) (input : tag -> i) (ticks : i64) : s =
    :~ ^ loop (state : s) (time : i64) : s =
        ? time >= ticks ?> state
        |:
            := now = { time = time; micro = 0i32 }
            := state, _ = program.react state now (input now)
            loop state (time + 1i64)
    loop program.init 0i64

/// ### run_micro
:= run_micro \* s i o acc.
    (program : reactor s i (signal o)) (input : tag -> i) (ticks : i64) (cap : i32) (step : acc -> o -> acc)
    (initial : acc)
    : acc * i64
    =
    :~ ^ loop (state : s) (time : i64) (micro : i32) (total : acc) (microsteps : i64) : acc * i64 =
        ? time >= ticks ?> total, microsteps
        |? micro >= cap ?> loop state (time + 1i64) 0i32 total microsteps
        |:
            := now = { time = time; micro = micro }
            := state, out = program.react state now (input now)
            ?= out ?|
            | Present v => loop state time (micro + 1i32) (step total v) (microsteps + 1i64)
            | Absent => loop state (time + 1i64) 0i32 total microsteps
    loop program.init 0i64 0i32 initial 0i64

:= timer (period : i64) : reactor i64 () (signal i64) =
    {
        init = 0i64
        react = \ count now () =>
            ? now.time % period = 0i64 ?> count + 1i64, Present (count + 1i64) |: count, Absent
    }

:= scale (k : i64) : reactor () (signal i64) (signal i64) =
    {
        init = ()
        react = \ () _ x =>
            ?= x ?|
            | Present v => (), Present (v * k)
            | Absent => (), Absent
    }

:= sink () : reactor (i64 * i64) (signal i64) (signal i64) =
    {
        init = 0i64, 0i64
        react = \ (sum, seen) _ x =>
            ?= x ?|
            | Present v => (sum + v, seen + 1i64), Present (sum + v)
            | Absent => (sum, seen), Absent
    }

test chain_delays_one_tick =
    := after : reactor (signal i64) (signal i64) (signal i64) = { init = Absent; react = \ held _ x => x, held }
    := program = chain (chain (chain (timer 4i64) (scale 3i64)) after) (sink ())
    := _, total = run_ticks program (\ _ => ()) 20i64
    total |> _assert_eq (45i64, 5i64)

test both_fans_out_and_joins =
    := add (a : signal i64) (b : signal i64) : signal i64 =
        ?= a, b ?|
        | Present x, Present y => Present (x + y)
        | Present x, Absent => Present x
        | Absent, Present y => Present y
        | Absent, Absent => Absent
    := merge4 : reactor () ((signal i64 * signal i64) * (signal i64 * signal i64)) (signal i64) =
        { init = (); react = \ () _ ((a, b), (c, d)) => (), add (add a b) (add c d) }
    := bank = both (both (scale 1i64) (scale 2i64)) (both (scale 3i64) (scale 4i64))
    := _, total = run_ticks (chain (chain (chain (timer 3i64) bank) merge4) (sink ())) (\ _ => ()) 12i64
    total |> _assert_eq (100i64, 4i64)

:= countdown (period : i64) (burst : i32) : reactor i32 () (signal i32) =
    {
        init = 0i32
        react = \ left now () =>
            ? now.micro = 0i32 ?>
                ? now.time % period = 0i64 ?> burst - 1i32, Present burst |: 0i32, Absent
            |? left > 0i32 ?> left - 1i32, Present left
            |: 0i32, Absent
    }

test microsteps_run_until_absent =
    run_micro (countdown 5i64 3i32) (\ _ => ()) 10i64 100i32 (\ (sum : i64) (v : i32) => sum + conv v) 0i64
    |> _assert_eq (12i64, 6i64)

test microsteps_share_the_tag_through_a_chain =
    := stamp : reactor () (signal i32) (signal i64) =
        {
            init = ()
            react = \ () now x =>
                ?= x ?|
                | Present v => (), Present (now.time * 1000i64 + conv now.micro * 10i64 + conv v)
                | Absent => (), Absent
        }
    := program = chain (chain (countdown 5i64 3i32) stamp) (sink ())
    run_micro program (\ _ => ()) 10i64 100i32 (\ _ (v : i64) => v) 0i64
    |> _assert_eq (15072i64, 6i64)

test deadlines_run_the_violation_handler =
    := sampler : reactor i64 i64 (signal i64) =
        {
            init = 0i64
            react = \ count now _ => count + 1i64, Present (now.time * 10i64)
        }
    := guarded = with_deadline 5i64 sampler (\ count _ => count, Present -1i64)
    := tally : reactor (i64 * i64) (signal i64) (signal i64) =
        {
            init = 0i64, 0i64
            react = \ (sum, violations) _ x =>
                ?= x ?|
                | Present v => ? v < 0i64 ?> (sum, violations + 1i64), x |: (sum + v, violations), x
                | Absent => (sum, violations), x
        }
    := lag (now : tag) : i64 = ? now.time % 4i64 = 3i64 ?> 9i64 |: now.time % 3i64
    := _, result = run_ticks (chain guarded tally) lag 12i64
    result |> _assert_eq (450i64, 3i64)

test array_bank_keeps_member_state =
    := members = 4i32
    := states : array i64 = arraym.init members (\ _ => 0i64)
    := step (input : i64) : i64 =
        :~ ^ go (i : i32) (acc : i64) : i64 =
            ? i >= members ?> acc
            |:
                := next = index states i + input * conv (i + 1i32)
                set states i next
                go (i + 1i32) (acc + next)
        go 0i32 0i64
    :~ ^ run (time : i64) (total : i64) : i64 =
        ? time >= 5i64 ?> total |: run (time + 1i64) (total + step (time + 1i64))
    run 0i64 0i64 |> _assert_eq 350i64

test modal_reset_restarts_history_resumes =
    := every_third (y : signal i64) : bool =
        ?= y ?|
        | Present v => v % 3i64 = 0i64
        | Absent => !-
    := total entry =
        := _, totals =
            run_ticks
                (chain (modal entry (timer 1i64) (chain (timer 1i64) (scale 10i64)) every_third) (sink ()))
                \ _ => ()
                9i64
        := sum, _ = totals
        sum
    (total Reset, total History) |> _assert_eq (72i64, 81i64)

/// ### physical_micros
:= physical_micros () : i64 =
    backend_switch {
        C = \ () =>
            global "#include <stdint.h>"
            global (
                "#ifdef _WIN32\n__declspec(dllimport) void __stdcall GetSystemTimePreciseAsFileTime(unsigned long "
                ^^ "long *);\nstatic int64_t spiral_physical_micros(void) { unsigned long long t; "
                ^^ "GetSystemTimePreciseAsFileTime(&t); return (int64_t)(t / 10ULL) - 11644473600000000LL; }\n#else\n"
                ^^ "#include <time.h>\nstatic int64_t spiral_physical_micros(void) { struct timespec ts; "
                ^^ "clock_gettime(CLOCK_REALTIME, &ts); return (int64_t)ts.tv_sec * 1000000 + ts.tv_nsec / 1000; }\n"
                ^^ "#endif"
            )
            $'spiral_physical_micros()' : i64
        Rust = \ () =>
            $'(std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).unwrap().as_micros() as i64)' : i64
        Zig = \ () => date_time.zig_micros_now ()
    }

///> c
///> rust
///> zig
test physical_micros_reads_a_real_clock_that_moves_forward =
    := first = physical_micros ()
    := second = physical_micros ()
    (first > 1700000000000000i64 && second >= first) |> _assert_eq !+
