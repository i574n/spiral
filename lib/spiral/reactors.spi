/// # reactors
///> c
///> rust
test reactors static =
    :< testing

/// ### signal
:| signal t =
    | Present : t
    | Absent

/// ### tag
:== tag = { time : i64; micro : i32 }

/// ### reactor
:== reactor s i o = { init : s; react : s -> tag -> i -> s * o }

:= chain_react \* sa sb i m o.
    (a : reactor sa i m) (b : reactor sb m o) (state : sa * sb) (now : tag) (x : i)
    : (sa * sb) * o
    =
    := sa, sb = state
    := sa, mid = a.react sa now x
    := sb, y = b.react sb now mid
    (sa, sb), y

/// ### chain
:= chain \* sa sb i m o. (a : reactor sa i m) (b : reactor sb m o) : reactor (sa * sb) i o =
    { init = (a.init, b.init); react = chain_react a b }

:= both_react \* sa sb i oa ob.
    (a : reactor sa i oa) (b : reactor sb i ob) (state : sa * sb) (now : tag) (x : i)
    : (sa * sb) * (oa * ob)
    =
    := sa, sb = state
    := sa, ya = a.react sa now x
    := sb, yb = b.react sb now x
    (sa, sb), (ya, yb)

/// ### both
:= both \* sa sb i oa ob. (a : reactor sa i oa) (b : reactor sb i ob) : reactor (sa * sb) i (oa * ob) =
    { init = (a.init, b.init); react = both_react a b }

:= deadline_react \* s o.
    (deadline : i64) (body : reactor s i64 o) (on_violation : s -> tag -> s * o) (state : s) (now : tag) (lag : i64)
    : s * o
    =
    ? lag > deadline ?> on_violation state now |: body.react state now lag

/// ### with_deadline
:= with_deadline \* s o.
    (deadline : i64) (body : reactor s i64 o) (on_violation : s -> tag -> s * o)
    : reactor s i64 o
    =
    { init = body.init; react = deadline_react deadline body on_violation }

/// ### modal
:| mode_entry =
    | Reset
    | History

:| reactor_mode =
    | FirstMode
    | SecondMode

:== modal_spec sa sb i o = { entry : mode_entry; first : reactor sa i o; second : reactor sb i o; leave : o -> bool }

:== modal_state sa sb = reactor_mode * sa * sb

:== modal_reactor sa sb i o = reactor (modal_state sa sb) i o

:= entered \* s. (entry : mode_entry) (init : s) (kept : s) : s = ?= entry ?| | Reset => init | History => kept

:= in_first \* sa sb i o. (m : modal_spec sa sb i o) (sa : sa) (sb : sb) (now : tag) (x : i) : modal_state sa sb * o =
    := sa, y = m.first.react sa now x
    ? m.leave y ?> (SecondMode, sa, entered m.entry m.second.init sb), y |: (FirstMode, sa, sb), y

:= in_second \* sa sb i o. (m : modal_spec sa sb i o) (sa : sa) (sb : sb) (now : tag) (x : i) : modal_state sa sb * o =
    := sb, y = m.second.react sb now x
    ? m.leave y ?> (FirstMode, entered m.entry m.first.init sa, sb), y |: (SecondMode, sa, sb), y

:= modal_react \* sa sb i o.
    (m : modal_spec sa sb i o) (state : modal_state sa sb) (now : tag) (x : i)
    : modal_state sa sb * o
    =
    := mode, sa, sb = state
    ?= mode ?| | FirstMode => in_first m sa sb now x | SecondMode => in_second m sa sb now x

:= modal_of \* sa sb i o. (m : modal_spec sa sb i o) : modal_reactor sa sb i o =
    { init = (FirstMode, m.first.init, m.second.init); react = modal_react m }

:= modal \* sa sb i o.
    (entry : mode_entry) (first : reactor sa i o) (second : reactor sb i o) (leave : o -> bool)
    : modal_reactor sa sb i o
    =
    modal_of { entry = entry; first = first; second = second; leave = leave }

:= tick \* s i o. (program : reactor s i o) (input : tag -> i) (state : s) (time : i64) : s =
    := now = { time = time; micro = 0i32 }
    := state, _ = program.react state now (input now)
    state

/// ### run_ticks
:= run_ticks \* s i o. (program : reactor s i o) (input : tag -> i) (ticks : i64) : s =
    :~ ^ loop (state : s) (time : i64) : s =
        ? time >= ticks ?> state |: loop (tick program input state time) (time + 1i64)
    loop program.init 0i64

:== micro_run s i o acc =
    {
        program : reactor s i (signal o)
        input : tag -> i
        ticks : i64
        cap : i32
        step : acc -> o -> acc
    }

:== micro_at s acc = { state : s; time : i64; micro : i32; total : acc; steps : i64 }

:= micro_start \* s acc. (state : s) (total : acc) : micro_at s acc =
    { state = state; time = 0i64; micro = 0i32; total = total; steps = 0i64 }

:= micro_tick \* s acc. (m : micro_at s acc) (state : s) : micro_at s acc =
    { state = state; time = m.time + 1i64; micro = 0i32; total = m.total; steps = m.steps }

:= micro_fired \* s acc. (m : micro_at s acc) (state : s) (total : acc) : micro_at s acc =
    { state = state; time = m.time; micro = m.micro + 1i32; total = total; steps = m.steps + 1i64 }

:= micro_react \* s i o acc. (r : micro_run s i o acc) (m : micro_at s acc) : s * signal o =
    := now = { time = m.time; micro = m.micro }
    r.program.react m.state now (r.input now)

:= micro_reacted \* s i o acc. (r : micro_run s i o acc) (m : micro_at s acc) : micro_at s acc =
    := state, out = micro_react r m
    ?= out ?|
    | Present v => micro_fired m state (r.step m.total v)
    | Absent => micro_tick m state

:= micro_next \* s i o acc. (r : micro_run s i o acc) (m : micro_at s acc) : micro_at s acc =
    ? m.micro >= r.cap ?> micro_tick m m.state |: micro_reacted r m

:~ ^ micro_loop \* s i o acc. (r : micro_run s i o acc) (m : micro_at s acc) : acc * i64 =
    ? m.time >= r.ticks ?> m.total, m.steps |: micro_loop r (micro_next r m)

:= micro_of \* s i o acc. (r : micro_run s i o acc) (initial : acc) : acc * i64 =
    micro_loop r (micro_start r.program.init initial)

/// ### run_micro
:= run_micro \* s i o acc.
    (program : reactor s i (signal o)) (input : tag -> i) (ticks : i64) (cap : i32) (step : acc -> o -> acc)
    (initial : acc)
    : acc * i64
    =
    micro_of { program; input; ticks; cap; step } initial

:= timer (period : i64) : reactor i64 () (signal i64) =
    {
        init = 0i64
        react = \ count now () =>
            ? now.time % period = 0i64 ?> count + 1i64, Present (count + 1i64) |: count, Absent
    }

:= scale (k : i64) : reactor () (signal i64) (signal i64) =
    {
        init = ()
        react = \ () _ x =>
            ?= x ?|
            | Present v => (), Present (v * k)
            | Absent => (), Absent
    }

:= sink () : reactor (i64 * i64) (signal i64) (signal i64) =
    {
        init = 0i64, 0i64
        react = \ (sum, seen) _ x =>
            ?= x ?|
            | Present v => (sum + v, seen + 1i64), Present (sum + v)
            | Absent => (sum, seen), Absent
    }

:= held_one_tick () : reactor (signal i64) (signal i64) (signal i64) = { init = Absent; react = \ held _ x => x, held }

test chain_delays_one_tick =
    := program = chain (chain (chain (timer 4i64) (scale 3i64)) (held_one_tick ())) (sink ())
    := _, total = run_ticks program (\ _ => ()) 20i64
    total |> _assert_eq (45i64, 5i64)

:= add_signals (a : signal i64) (b : signal i64) : signal i64 =
    ?= a, b ?|
    | Present x, Present y => Present (x + y)
    | Present x, Absent => Present x
    | Absent, Present y => Present y
    | Absent, Absent => Absent

:== four_signals = (signal i64 * signal i64) * (signal i64 * signal i64)

:= merge_four () : reactor () four_signals (signal i64) =
    { init = (); react = \ () _ ((a, b), (c, d)) => (), add_signals (add_signals a b) (add_signals c d) }

test both_fans_out_and_joins =
    := bank = both (both (scale 1i64) (scale 2i64)) (both (scale 3i64) (scale 4i64))
    := _, total = run_ticks (chain (chain (chain (timer 3i64) bank) (merge_four ())) (sink ())) (\ _ => ()) 12i64
    total |> _assert_eq (100i64, 4i64)

:= burst_start (period : i64) (burst : i32) (now : tag) : i32 * signal i32 =
    ? now.time % period = 0i64 ?> burst - 1i32, Present burst |: 0i32, Absent

:= countdown_step (period : i64) (burst : i32) (left : i32) (now : tag) (_ : ()) : i32 * signal i32 =
    ? now.micro = 0i32 ?> burst_start period burst now
    |? left > 0i32 ?> left - 1i32, Present left
    |: 0i32, Absent

:= countdown (period : i64) (burst : i32) : reactor i32 () (signal i32) =
    { init = 0i32; react = countdown_step period burst }

test microsteps_run_until_absent =
    run_micro (countdown 5i64 3i32) (\ _ => ()) 10i64 100i32 (\ (sum : i64) (v : i32) => sum + conv v) 0i64
    |> _assert_eq (12i64, 6i64)

:= stamped (now : tag) (v : i32) : i64 = now.time * 1000i64 + conv now.micro * 10i64 + conv v

:= tick_stamp () : reactor () (signal i32) (signal i64) =
    { init = (); react = \ () now x => ?= x ?| | Present v => (), Present (stamped now v) | Absent => (), Absent }

test microsteps_share_the_tag_through_a_chain =
    := program = chain (chain (countdown 5i64 3i32) (tick_stamp ())) (sink ())
    run_micro program (\ _ => ()) 10i64 100i32 (\ _ (v : i64) => v) 0i64
    |> _assert_eq (15072i64, 6i64)

:= sampling_tens () : reactor i64 i64 (signal i64) =
    { init = 0i64; react = \ count now _ => count + 1i64, Present (now.time * 10i64) }

:= tally_step (state : i64 * i64) (_ : tag) (x : signal i64) : (i64 * i64) * signal i64 =
    := sum, violations = state
    ?= x ?|
    | Present v => ? v < 0i64 ?> (sum, violations + 1i64), x |: (sum + v, violations), x
    | Absent => (sum, violations), x

:= violation_tally () : reactor (i64 * i64) (signal i64) (signal i64) = { init = (0i64, 0i64); react = tally_step }

:= lag_pattern (now : tag) : i64 = ? now.time % 4i64 = 3i64 ?> 9i64 |: now.time % 3i64

test deadlines_run_the_violation_handler =
    := guarded = with_deadline 5i64 (sampling_tens ()) (\ count _ => count, Present -1i64)
    := _, result = run_ticks (chain guarded (violation_tally ())) lag_pattern 12i64
    result |> _assert_eq (450i64, 3i64)

:= bump_member (states : array i64) (i : i32) (input : i64) : i64 =
    := next = index states i + input * conv (i + 1i32)
    set states i next
    next

:= bank_step (states : array i64) (members : i32) (input : i64) : i64 =
    :~ ^ go (i : i32) (acc : i64) : i64 = ? i >= members ?> acc |: go (i + 1i32) (acc + bump_member states i input)
    go 0i32 0i64

:= bank_total (states : array i64) (members : i32) : i64 =
    :~ ^ run (time : i64) (total : i64) : i64 =
        ? time >= 5i64 ?> total |: run (time + 1i64) (total + bank_step states members (time + 1i64))
    run 0i64 0i64

test array_bank_keeps_member_state =
    := members = 4i32
    := states : array i64 = arraym.init members (\ _ => 0i64)
    bank_total states members |> _assert_eq 350i64

:= every_third (y : signal i64) : bool =
    ?= y ?|
    | Present v => v % 3i64 = 0i64
    | Absent => !-

:= modal_total (entry : mode_entry) : i64 =
    := program = chain (modal entry (timer 1i64) (chain (timer 1i64) (scale 10i64)) every_third) (sink ())
    := _, totals = run_ticks program (\ _ => ()) 9i64
    := sum, _ = totals
    sum

test modal_reset_restarts_history_resumes =
    (modal_total Reset, modal_total History) |> _assert_eq (72i64, 81i64)

:= c_windows_precise_time_import () =
    global (
        "#ifdef _WIN32\n__declspec(dllimport) void __stdcall GetSystemTimePreciseAsFileTime(unsigned long long *);\n"
        ^^ "#endif"
    )

:= c_windows_physical_micros () =
    global (
        "#ifdef _WIN32\nstatic int64_t spiral_physical_micros(void) { unsigned long long t; "
        ^^ "GetSystemTimePreciseAsFileTime(&t); return (int64_t)(t / 10ULL) - 11644473600000000LL; }\n#endif"
    )

:= c_posix_time_include () = global "#ifndef _WIN32\n#include <time.h>\n#endif"

:= c_posix_physical_micros () =
    global (
        "#ifndef _WIN32\nstatic int64_t spiral_physical_micros(void) { struct timespec ts; "
        ^^ "clock_gettime(CLOCK_REALTIME, &ts); return (int64_t)ts.tv_sec * 1000000 + ts.tv_nsec / 1000; }\n#endif"
    )

:= c_physical_micros () : i64 =
    global "#include <stdint.h>"
    c_windows_precise_time_import ()
    c_windows_physical_micros ()
    c_posix_time_include ()
    c_posix_physical_micros ()
    $'spiral_physical_micros()' : i64

:= rust_physical_micros () : i64 =
    $'(std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).unwrap().as_micros() as i64)' : i64

/// ### physical_micros
:= physical_micros () : i64 =
    backend_switch {
        C = \ () => c_physical_micros ()
        Rust = \ () => rust_physical_micros ()
        Zig = \ () => date_time.zig_micros_now ()
    }

///> c
///> rust
///> zig
test physical_micros_reads_a_real_clock_that_moves_forward =
    := first = physical_micros ()
    := second = physical_micros ()
    (first > 1700000000000000i64 && second >= first) |> _assert_eq !+
