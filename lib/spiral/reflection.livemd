### union_to_string

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"inl union_to_string forall t. (x : t) : string =\n    real get_union_fields_untag `t ()\n    |> listm'.try_pick fun key, x' =>\n        if x' = x\n        then Some key\n        else\n            inl has_case =\n                real\n                    real_core.union_to_record\n                        `t\n                        forall union_record_type. =>\n                            real_core.record_type_fold_back\n                                fun _key =>\n                                    forall value. acc =>\n                                        if acc\n                                        then acc\n                                        else\n                                            typecase value with\n                                            | () => false\n                                            | _ => true\n                                `union_record_type\n                                false\n            if has_case |> not\n            then None\n            else\n                inl separator =\n                    backend_switch {\n                        Gleam = fun () => \"(\"\n                        Lua = fun () => \"(\"\n                        Fsharp = fun () =>\n                            run_target function\n                                | RustNative => fun () => join \"(\"\n                                | _ => fun () => join \" \"\n                        Python = fun () => \"(\"\n                        // Native Debug prints a union case as `US0_1(..)`.\n                        Rust = fun () => \"(\"\n                    }\n                inl x' = #?x' |> sm'.split separator |> am'.index_base 0\n                if #?x |> sm'.starts_with x'\n                then Some key\n                else None\n    |> optionm.value","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  inl union_to_string forall t. (x : t) : string =
      real get_union_fields_untag `t ()
      |> listm'.try_pick fun key, x' =>
          if x' = x
          then Some key
          else
              inl has_case =
                  real
                      real_core.union_to_record
                          `t
                          forall union_record_type. =>
                              real_core.record_type_fold_back
                                  fun _key =>
                                      forall value. acc =>
                                          if acc
                                          then acc
                                          else
                                              typecase value with
                                              | () => false
                                              | _ => true
                                  `union_record_type
                                  false
              if has_case |> not
              then None
              else
                  inl separator =
                      backend_switch {
                          Gleam = fun () => "("
                          Lua = fun () => "("
                          Fsharp = fun () =>
                              run_target function
                                  | RustNative => fun () => join "("
                                  | _ => fun () => join " "
                          Python = fun () => "("
                          // Native Debug prints a union case as `US0_1(..)`.
                          Rust = fun () => "("
                      }
                  inl x' = #?x' |> sm'.split separator |> am'.index_base 0
                  if #?x |> sm'.starts_with x'
                  then Some key
                  else None
      |> optionm.value
  """,
  timeout: 300_000
)
```

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"///- --test\n///> fsharp\n///> cuda\n///> rust\n///> typescript\n\nSome true\n|> union_to_string\n|> _assert_eq' \"Some\"","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  ///- --test
  ///> fsharp
  ///> cuda
  ///> rust
  ///> typescript

  Some true
  |> union_to_string
  |> _assert_eq' "Some"
  """,
  timeout: 300_000
)
```

