/// # reflection
test reflection static =
    :< testing

:< sm'_operators

/// ## reflection

/// ### get_union_fields
:= get_union_fields \* union_type. () : list (string * union_type) =
    ~>
        real_core.union_type_to_record
            `union_type
            \* union_record_type. =>
                real_core.record_type_fold
                    \ acc key =>
                        \* value. =>
                            := value =
                                ?: value ?|
                                | () => $'' : value
                                | _ =>
                                    backend_switch `value `({}) {
                                        Gleam =
                                            (\ () =>
                                                $'Nil' : value
                                            ) : () -> value
                                        Lua =
                                            (\ () =>
                                                $'nil' : value
                                            ) : () -> value
                                        Fsharp =
                                            (\ () =>
                                                $'Unchecked.defaultof<_>' : value
                                            ) : () -> value
                                        Python =
                                            (\ () =>
                                                := is_python =
                                                    backend_switch `bool `({}) {
                                                        Gleam = (\ () => !-) : () -> bool
                                                        Lua = (\ () => !-) : () -> bool
                                                        Fsharp = (\ () => !-) : () -> bool
                                                        Python = (\ () => !+) : () -> bool
                                                    }
                                                ? is_python ?>
                                                    ?: value ?|
                                                    | i8 => 0i8
                                                    | i16 => 0i16
                                                    | i32 => 0i32
                                                    | i64 => 0i64
                                                    | u8 => 0u8
                                                    | u16 => 0u16
                                                    | u32 => 0u32
                                                    | u64 => 0u64
                                                    | f32 => 0.0f32
                                                    | f64 => 0.0f64
                                                    | bool => !-
                                                    | char => '\0'
                                                    | _ => $'None' : value
                                                |: $'None' : value
                                            ) : () -> value
                                        Rust =
                                            (\ () =>
                                                $'Default::default()' : value
                                            ) : () -> value
                                        Zig =
                                            (\ () =>
                                                $'std.mem.zeroes(`value)' : value
                                            ) : () -> value
                                        TypeScript =
                                            (\ () =>
                                                ?: value ?|
                                                | i8 => 0i8
                                                | i16 => 0i16
                                                | i32 => 0i32
                                                | i64 => 0i64
                                                | u8 => 0u8
                                                | u16 => 0u16
                                                | u32 => 0u32
                                                | u64 => 0u64
                                                | f32 => 0.0f32
                                                | f64 => 0.0f64
                                                | bool => !-
                                                | char => '\0'
                                                | _ => $'undefined' : value
                                            ) : () -> value
                                    }
                            := item = real_core.nominal_create `union_type (key, value)
                            := key' = sm'_real.symbol_to_string_real `(`key)
                            (::) `(string * union_type) (key', item) acc
                    (Nil `(string * union_type))
                    `union_record_type
:| reflection_test_target = Wasm | Contract

///> fsharp
///> rust
///> typescript
///> cuda
test get_union_fields =
    get_union_fields ()
    |> listm'.box
    |> listm'.to_array'
    |> array
    |> am'.sort_by snd
    |> \ (array x : array _) => x
    |> _assert_eq' (am'.base ;[ "Wasm", Wasm; "Contract", Contract ])
    get_union_fields ()
    |> listm'.box
    |> listm'.to_array'
    |> array
    |> am'.sort_by snd
    |> \ (array x : array _) => x
    |> _assert_eq' (am'.base ;[ "Some", Some 0i32; "None", None ])

/// ### get_union_fields_untag
:= get_union_fields_untag \* union_type. () : list (string * union_type) =
    ~>
        real_core.union_type_to_record
            `union_type
            \* union_record_type. =>
                := result =
                    real_core.record_type_fold_back
                        \ _key =>
                            \* value. (acc, (i : i32)) =>
                                := key, item : (string * union_type) =
                                    real_core.union_untag `union_type i
                                        (\ key => \* value. =>
                                            := key' = sm'_real.symbol_to_string_real `(`key)
                                            := value =
                                                ?: value ?|
                                                | () => $'' : value
                                                | _ =>
                                                    backend_switch `value `({}) {
                                                        Gleam =
                                                            (\ () =>
                                                                $'Nil' : value
                                                            ) : () -> value
                                                        Lua =
                                                            (\ () =>
                                                                $'nil' : value
                                                            ) : () -> value
                                                        Fsharp =
                                                            (\ () =>
                                                                $'Unchecked.defaultof<_>' : value
                                                            ) : () -> value
                                                        Python =
                                                            (\ () =>
                                                                $'None' : value
                                                            ) : () -> value
                                                        Rust =
                                                            (\ () =>
                                                                $'Default::default()' : value
                                                            ) : () -> value
                                                        TypeScript =
                                                            (\ () =>
                                                                $'undefined' : value
                                                            ) : () -> value
                                                        Zig =
                                                            (\ () =>
                                                                $'std.mem.zeroes(`value)' : value
                                                            ) : () -> value
                                                    }
                                            := item = real_core.nominal_create `union_type (key, value)
                                            key', item
                                        )
                                        (\ _ =>
                                            failwith
                                                `(string * union_type)
                                                "reflection.get_union_fields_untag / invalid tag"
                                        )
                                (::) `(string * union_type) (key, item) acc, (+) `i32 i 1
                        `union_record_type
                        (Nil `(string * union_type), 0i32)
                := result = fst `(list (string * union_type)) `i32 result
                listm.rev `(string * union_type) result

///> gleam
///> lua
///> fsharp
///> cuda
///> rust
///> typescript
test get_union_fields_untag =
    get_union_fields_untag ()
    |> _assert_eq' [ "Wasm", Wasm; "Contract", Contract ]

    get_union_fields_untag ()
    |> _assert_eq' [ "Some", Some (); "None", None ]

/// ### union_try_pick
:= union_try_pick \* t. (key : string) : option t =
    := fields = ~> get_union_fields_untag `t ()
    fields
    ++ (
        fields
        |> listm.map \ key', x =>
            key' |> sm'.to_lower, x
    )
    |> listm'.box
    |> listm'.to_array'
    |> \ x => array x : array _
    |> am'.try_pick \ key', x =>
        ? key' =. key
        ?> Some x
        |: None

///> gleam
///> lua
///> fsharp
///> cuda
///> rust
///> typescript
test union_try_pick =
    "wasm"
    |> union_try_pick
    |> _assert_eq (Some Wasm)

    "Wasm"
    |> union_try_pick
    |> _assert_eq (Some Wasm)

/// ### union_try_pick'
:= union_try_pick' \* t. (key : string) : option t =
    := fields = ~> get_union_fields_untag `t ()
    fields
    ++ (
        fields
        |> listm.map \ key', x =>
            key' |> sm'.to_lower, x
    )
    |> listm'.try_pick \ key', x =>
        ? key' =. key
        ?> x |> Some
        |: None

///> gleam
///> lua
///> fsharp
///> cuda
///> rust
///> typescript
test union_try_pick_2 =
    "wasm"
    |> union_try_pick'
    |> _assert_eq (Some Wasm)

    "Wasm"
    |> union_try_pick'
    |> _assert_eq (Some Wasm)

/// ### union_cases_fold
:= union_cases_fold \* union_type state. (step : state -> union_type -> state) (initial : state) : state =
    ~>
        real_core.union_type_to_record `union_type \* union_record_type. =>
            real_core.record_type_fold
                \ acc key => \* value. => step acc (real_core.nominal_create `union_type (key, ()))
                initial
                `union_record_type

///> gleam
///> lua
///> fsharp
///> cuda
///> rust
///> typescript
test union_cases_fold =
    union_cases_fold (\ count (_ : reflection_test_target) => count + 1i32) 0i32
    |> _assert_eq 2i32

    union_cases_fold (\ found (target : reflection_test_target) => ? target = Contract ?> !+ |: found) !-
    |> _assert_eq !+

/// ### union_cases_find
:= union_cases_find \* union_type. (matches : union_type -> bool) : option union_type =
    :~ ^ search (cases : list union_type) : option union_type =
        ?= cases ?|
        | case :: rest => ? matches case ?> Some case |: search rest
        | [] => None
    search (union_cases_fold (\ acc (case : union_type) => case :: acc) [] |> dyn)

///> gleam
///> lua
///> fsharp
///> cuda
///> rust
///> typescript
test union_cases_find =
    union_cases_find (\ (target : reflection_test_target) => target = Contract)
    |> _assert_eq (Some Contract)

    union_cases_find (\ (_ : reflection_test_target) => !-)
    |> _assert_eq None

/// ### union_to_string
:= union_to_string \* t. (x : t) : string =
    ~> get_union_fields_untag `t ()
    |> listm'.try_pick \ key, x' =>
        ? x' = x
        ?> Some key
        |:
            := has_case =
                ~>
                    real_core.union_type_to_record
                        `t
                        \* union_record_type. =>
                            real_core.record_type_fold_back
                                \ _key =>
                                    \* value. acc =>
                                        ? acc
                                        ?> acc
                                        |:
                                            ?: value ?|
                                            | () => !-
                                            | _ => !+
                                `union_record_type
                                !-
            ? has_case |> not
            ?> None
            |:
                := x' = #?x' |> sm'.split "(" |> am'.index_base 0

                ? #?x |> sm'.starts_with x'
                ?> Some key
                |: None
    |> optionm.value

///> fsharp
///> cuda
///> rust
///> typescript
test union_to_string =
    Some !+
    |> union_to_string
    |> _assert_eq' "Some"

/// ### nameof
:= nameof \* t. (x : t) : string =
    ~>
        real_core.record_type_fold_back
            \ key =>
                \* value. _ =>
                    sm'_real.symbol_to_string_real `(`key)
            `t
            ""

test nameof =
    { test1 = ""; test2 = "" }
    |> nameof
    |> _assert_eq' "test1"

/// ### get_record_fields
:= get_record_fields \* t u. (x : t) : list (string * u) =
    ~>
        real_core.record_type_fold_back
            \ key =>
                \* u'. acc =>
                    := k = sm'_real.symbol_to_string_real `(`key)
                    := v = x key
                    (::) `(string * u') (k, v) acc
            `t
            (Nil `(string * u))

test get_record_fields =
    { a = "1"; b = "2" }
    |> get_record_fields
    |> _assert_eq' [ "a", "1"; "b", "2" ]

/// ### get_functions_types
:= get_functions_types \* t {record}. (fns : t) =
    ~>
        := get_function_type \* t. =
            := args \* t {record}. : list (string * string) =
                real_core.record_type_fold_back
                    \ key =>
                        \* v. acc =>
                            := k = sm'_real.symbol_to_string_real `(`key)
                            := v = $'"`v"' : string
                            (::) `(string * string) (k, v) acc
                    `t
                    (Nil `(string * string))

            ?: t ?|
            | ~t -> ~u => args `t, ($'"`u"' : string)

        real_core.record_type_fold_back
            \ key =>
                \* v. acc =>
                    := k = sm'_real.symbol_to_string_real `(`key)
                    := args, result = get_function_type `v
                    (::) `(string * (list (string * string) * string)) (k, (args, result)) acc
            `(`fns)
            (Nil `(string * (list (string * string) * string)))
    |> \ x => x : list (string * (list (string * string) * string))

///> fsharp
test get_functions_types =
    := one ({ a } : { a : i32 }) : i32 = a + 1
    := two ({ a b } : { a : i32; b : i32 }) : i32 = a + b + 2
    := fns = { one two }

    fns
    |> get_functions_types
    |> listm.map \ (name, args, result) => name, (args |> listm'.box |> listm'.to_array', result)
    |> listm'.box
    |> listm'.to_array'
    |> sm'.format
    |> _assert_eq' (
        [
            "one", [ "a", "int32" ], "int32"
            "two", [ "a", "int32"; "b", "int32" ], "int32"
        ]
        |> listm.map \ (name, args, result) => name, (args |> listm'.box |> listm'.to_array', result)
        |> listm'.box
        |> listm'.to_array'
        |> sm'.format
    )
