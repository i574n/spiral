:# union_try_pick_2 =
    "Browser"
    |> union_try_pick'
    |> _assert_eq (Some Browser)

    "Browser"
    |> union_try_pick'
    |> _assert_eq (Some Browser)

:= union_cases_fold \* union_type state. (step : state -> union_type -> state) (initial : state) : state =
    ~>
        real_core::union_type_to_record `union_type \* union_record_type. =>
            real_core::record_type_fold
                \ acc key => \* value. => step acc (real_core::nominal_create `union_type (key, ()))
                initial
                `union_record_type

///- --timeout 900000

///> gleam
///> lua
///> cuda
///> rust
///> typescript
:# union_cases_fold =
    union_cases_fold (\ count (_ : reflection_test_target) => count + 1i32) 0i32
    |> _assert_eq 2i32

    union_cases_fold (\ found (target : reflection_test_target) => ? target = Contract ?> !+ |: found) !-
    |> _assert_eq !+

:= union_cases_find \* union_type. (matches : union_type -> bool) : option union_type =
    :~ ^ search (cases : list union_type) : option union_type =
        ?= cases ?|
        | case :: rest => ? matches case ?> Some case |: search rest
        | [] => None
    search (union_cases_fold (\ acc (case : union_type) => case :: acc) [] |> dyn)

///- --timeout 900000

///> gleam
///> lua
///> cuda
///> rust
///> typescript
:# union_cases_find =
    union_cases_find \ (target : reflection_test_target) => target = Contract
    |> _assert_eq (Some Contract)

    union_cases_find \ (_ : reflection_test_target) => !-
    |> _assert_eq None

:= union_to_string \* t. (x : t) : string =
    ~> get_union_fields_untag `t ()
    |> listm'::try_pick \ key, x' =>
        ? x' = x
        ?> Some key
        |:
            := has_case =
                ~>
                    real_core::union_type_to_record
                        `t
                        \* union_record_type. =>
                            real_core::record_type_fold_back
                                \ _key =>
                                    \* value. acc =>
                                        ? acc
                                        ?> acc
                                        |:
                                            ?: value ?|
                                            | () => !-
                                            | _ => !+
                                `union_record_type
                                !-
            ? has_case |> not
            ?> None
            |:
                := x' = #?x' |> sm'::split "(" |> am'::index_base 0

                ? #?x |> sm'::starts_with x'
                ?> Some key
                |: None
    |> optionm::value

///- --timeout 900000

///> cuda
///> rust
///> typescript
:# union_to_string =
    Some !+
    |> union_to_string
    |> _assert_eq' "Some"

/// ### case_name
:= case_name \* t. (x : t) : string = !!!!UnionCaseName(x)

/// ### case_name_styles
:= case_name_lower \* t. (x : t) : string = !!!!UnionCaseName(x, "lower")
:= case_name_snake \* t. (x : t) : string = !!!!UnionCaseName(x, "snake")
:= case_name_kebab \* t. (x : t) : string = !!!!UnionCaseName(x, "kebab")

/// ### case_of_name
:= case_of_name \* t. (text : string) : option t =
    ~> get_union_fields_untag `t ()
    |> listm'::try_pick \ key, case => ? key =. text ?> Some case |: None

/// ### typed_name
:! typed_name t = string

:= typed_case_name \* t. (x : t) : typed_name t = typed_name (case_name x)
:= case_qualified_name \* t. (x : t) : string = !!!!NominalName(`t) ++# "::" ++# case_name x

:= typed_name_text \* t. ((typed_name text) : typed_name t) : string = text

:= case_of_typed_name \* t. ((typed_name text) : typed_name t) : option t = case_of_name text

:= styled_step (separator : string) (acc : list string) (c : char) : list string =
    := s = sm'::of_char c
    := lower = sm'::to_lower s
    ? lower <> s && listm::length acc > 0i32 ?> lower :: separator :: acc |: lower :: acc

:= styled_name (separator : string) (text : string) : string =
    sm'::to_char_list text |> listm::fold (styled_step separator) [] |> listm::rev |> sm'::concat_list ""

:= typed_name_snake \* t. ((typed_name text) : typed_name t) : string = styled_name "_" text

:= typed_name_kebab \* t. ((typed_name text) : typed_name t) : string = styled_name "-" text

:= typed_name_lower \* t. ((typed_name text) : typed_name t) : string = sm'::to_lower text

