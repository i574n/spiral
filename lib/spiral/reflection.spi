///> cuda
///> rust
///> typescript
:# case_name =
    Contract
    |> case_name
    |> _assert_eq' "Contract"

    Some 3i32
    |> case_name
    |> _assert_eq' "Some"

    := ~payload : option i32 = None
    payload
    |> case_name
    |> _assert_eq' "None"

    "Browser"
    |> case_of_name
    |> _assert_eq (Some Browser)

    "browser"
    |> case_of_name
    |> _assert_eq (None : option reflection_test_target)

:= nameof \* t. (x : t) : string =
    ~>
        real_core::record_type_fold_back
            \ key =>
                \* value. _ =>
                    sm'_real::symbol_to_string_real `(`key)
            `t
            ""

:# nameof =
    { test1 = ""; test2 = "" }
    |> nameof
    |> _assert_eq' "test1"

:= get_record_fields \* t u. (x : t) : list (string * u) =
    ~>
        real_core::record_type_fold_back
            \ key =>
                \* u'. acc =>
                    := k = sm'_real::symbol_to_string_real `(`key)
                    := v = x key
                    (::) `(string * u') (k, v) acc
            `t
            (Nil `(string * u))

:# get_record_fields =
    { a = "1"; b = "2" }
    |> get_record_fields
    |> _assert_eq' [ "a", "1"; "b", "2" ]

:= get_functions_types \* t {record}. (fns : t) =
    ~>
        := get_function_type \* t. =
            := args \* t {record}. : list (string * string) =
                real_core::record_type_fold_back
                    \ key =>
                        \* v. acc =>
                            := k = sm'_real::symbol_to_string_real `(`key)
                            := v = $'"`v"' : string
                            (::) `(string * string) (k, v) acc
                    `t
                    (Nil `(string * string))

            ?: t ?|
            | ~t -> ~u => args `t, ($'"`u"' : string)

        real_core::record_type_fold_back
            \ key =>
                \* v. acc =>
                    := k = sm'_real::symbol_to_string_real `(`key)
                    := args, result = get_function_type `v
                    (::) `(string * (list (string * string) * string)) (k, (args, result)) acc
            `(`fns)
            (Nil `(string * (list (string * string) * string)))
    |> \ x => x : list (string * (list (string * string) * string))

///> fsharp
///> rust
:# get_functions_types no_agree "type names are backend-specific" =
    := one ({ a } : { a : i32 }) : i32 = a + 1
    := two ({ a b } : { a : i32; b : i32 }) : i32 = a + b + 2
    := fns = { one two }
    := i32_name = run_target \| | Fsharp _ => \ () => ~~ "int32" | _ => \ () => "i32"

    fns
    |> get_functions_types
    |> listm::map \ (name, args, result) => name, (args |> listm'::box |> listm'::to_array', result)
    |> listm'::box
    |> listm'::to_array'
    |> sm'::format
    |> _assert_eq' (
        [
            "one", [ "a", i32_name ], i32_name
            "two", [ "a", i32_name; "b", i32_name ], i32_name
        ]
        |> listm::map \ (name, args, result) => name, (args |> listm'::box |> listm'::to_array', result)
        |> listm'::box
        |> listm'::to_array'
        |> sm'::format
    )

:| nameof_probe =
    | Alpha
    | Beta
    | Gamma
    | Delta
    | Epsilon

///- --timeout 900000

///> rust
///> gleam
///> lua
///> typescript
///> fsharp
:# nameof_cases_round_trip =
    Alpha |> case_name |> case_of_name |> _assert_eq (Some Alpha)
    Beta |> case_name |> case_of_name |> _assert_eq (Some Beta)
    Gamma |> case_name |> case_of_name |> _assert_eq (Some Gamma)
    Delta |> case_name |> _assert_eq' "Delta"
    Epsilon |> case_name |> case_of_name |> _assert_eq (Some Epsilon)
    "epsilon" |> case_of_name |> _assert_eq (None : option nameof_probe)

///- --timeout 900000

///> gleam
///> lua
///> rust
///> typescript
:# typed_case_name_round_trips =
    := name = typed_case_name Contract
    typed_name_text name |> _assert_eq' "Contract"
    case_of_typed_name name |> _assert_eq (Some Contract)

///- --timeout 900000

///> gleam
///> rust
:# typed_name_styles =
    styled_name "_" "HostMacro" |> _assert_eq' "host_macro"
    styled_name "-" "GadtCase" |> _assert_eq' "gadt-case"
    styled_name "_" "Contract" |> _assert_eq' "contract"
    := name = typed_case_name Browser
    typed_name_kebab name |> _assert_eq' "browser"
    typed_name_lower name |> _assert_eq' "browser"

:| case_style_probe =
    | HostMacro
    | GadtCase

///- --timeout 900000

///> gleam
///> lua
///> rust
///> typescript
:# case_name_styles =
    := ~macro : case_style_probe = HostMacro
    macro |> case_name_snake |> _assert_eq' "host_macro"
    macro |> case_name_lower |> _assert_eq' "hostmacro"
    GadtCase |> case_name_kebab |> _assert_eq' "gadt-case"
    GadtCase |> case_name_snake |> _assert_eq' "gadt_case"

///- --timeout 900000

///> gleam
///> rust
:# case_qualified_name =
    case_qualified_name Contract |> _assert_eq' "reflection_test_target::Contract"
    case_qualified_name Browser |> _assert_eq' "reflection_test_target::Browser"
