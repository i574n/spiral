:# reflection static =
    :< testing

:< sm'_operators

/// ## reflection
:= get_union_fields \* union_type. () : list (string * union_type) =
    ~>
        real_core::union_type_to_record
            `union_type
            \* union_record_type. =>
                real_core::record_type_fold
                    \ acc key =>
                        \* value. =>
                            := value =
                                ?: value ?|
                                | () => $'' : value
                                | _ =>
                                    backend_switch `value `({}) {
                                        Gleam =
                                            (\ () =>
                                                $'Nil' : value
                                            ) : () -> value
                                        Lua =
                                            (\ () =>
                                                $'nil' : value
                                            ) : () -> value
                                        Fsharp =
                                            (\ () =>
                                                $'Unchecked.defaultof<_>' : value
                                            ) : () -> value
                                        Python =
                                            (\ () =>
                                                := is_python =
                                                    backend_switch `bool `({}) {
                                                        Gleam = (\ () => !-) : () -> bool
                                                        Lua = (\ () => !-) : () -> bool
                                                        Fsharp = (\ () => !-) : () -> bool
                                                        Python = (\ () => !+) : () -> bool
                                                    }
                                                ? is_python ?>
                                                    ?: value ?|
                                                    | i8 => 0i8
                                                    | i16 => 0i16
                                                    | i32 => 0i32
                                                    | i64 => 0i64
                                                    | u8 => 0u8
                                                    | u16 => 0u16
                                                    | u32 => 0u32
                                                    | u64 => 0u64
                                                    | f32 => 0.0f32
                                                    | f64 => 0.0f64
                                                    | bool => !-
                                                    | char => '\0'
                                                    | _ => $'None' : value
                                                |: $'None' : value
                                            ) : () -> value
                                        Rust =
                                            (\ () =>
                                                $'Default::default()' : value
                                            ) : () -> value
                                        Zig =
                                            (\ () =>
                                                $'std.mem.zeroes(`value)' : value
                                            ) : () -> value
                                        TypeScript =
                                            (\ () =>
                                                ?: value ?|
                                                | i8 => 0i8
                                                | i16 => 0i16
                                                | i32 => 0i32
                                                | i64 => 0i64
                                                | u8 => 0u8
                                                | u16 => 0u16
                                                | u32 => 0u32
                                                | u64 => 0u64
                                                | f32 => 0.0f32
                                                | f64 => 0.0f64
                                                | bool => !-
                                                | char => '\0'
                                                | _ => $'undefined' : value
                                            ) : () -> value
                                    }
                            := item = real_core::nominal_create `union_type (key, value)
                            := key' = sm'_real::symbol_to_string_real `(`key)
                            (::) `(string * union_type) (key', item) acc
                    (Nil `(string * union_type))
                    `union_record_type
:| reflection_test_target = Browser | Contract

///- --timeout 900000

///> rust
///> typescript
///> cuda
:# get_union_fields =
    get_union_fields ()
    |> listm'::box
    |> listm'::to_array'
    |> array
    |> am'::sort_by snd
    |> \ (array x : array _) => x
    |> _assert_eq' (am'::base ;[ "Browser", Browser; "Contract", Contract ])
    get_union_fields ()
    |> listm'::box
    |> listm'::to_array'
    |> array
    |> am'::sort_by snd
    |> \ (array x : array _) => x
    |> _assert_eq' (am'::base ;[ "Some", Some 0i32; "None", None ])

:= get_union_fields_untag \* union_type. () : list (string * union_type) =
    ~>
        real_core::union_type_to_record
            `union_type
            \* union_record_type. =>
                := result =
                    real_core::record_type_fold_back
                        \ _key =>
                            \* value. (acc, (i : i32)) =>
                                := key, item : (string * union_type) =
                                    real_core::union_untag `union_type i
                                        (\ key => \* value. =>
                                            := key' = sm'_real::symbol_to_string_real `(`key)
                                            := value =
                                                ?: value ?|
                                                | () => $'' : value
                                                | _ =>
                                                    backend_switch `value `({}) {
                                                        Gleam =
                                                            (\ () =>
                                                                $'Nil' : value
                                                            ) : () -> value
                                                        Lua =
                                                            (\ () =>
                                                                $'nil' : value
                                                            ) : () -> value
                                                        Fsharp =
                                                            (\ () =>
                                                                $'Unchecked.defaultof<_>' : value
                                                            ) : () -> value
                                                        Python =
                                                            (\ () =>
                                                                $'None' : value
                                                            ) : () -> value
                                                        Rust =
                                                            (\ () =>
                                                                $'Default::default()' : value
                                                            ) : () -> value
                                                        TypeScript =
                                                            (\ () =>
                                                                $'undefined' : value
                                                            ) : () -> value
                                                        Zig =
                                                            (\ () =>
                                                                $'std.mem.zeroes(`value)' : value
                                                            ) : () -> value
                                                    }
                                            := item = real_core::nominal_create `union_type (key, value)
                                            key', item
                                        )
                                        (\ _ =>
                                            failwith
                                                `(string * union_type)
                                                "reflection.get_union_fields_untag / invalid tag"
                                        )
                                (::) `(string * union_type) (key, item) acc, (+) `i32 i 1
                        `union_record_type
                        (Nil `(string * union_type), 0i32)
                := result = fst `(list (string * union_type)) `i32 result
                listm::rev `(string * union_type) result

