:# get_union_fields_untag =
    get_union_fields_untag ()
    |> _assert_eq' [ "Browser", Browser; "Contract", Contract ]

    get_union_fields_untag ()
    |> _assert_eq' [ "Some", Some (); "None", None ]

:= union_try_pick \* t. (key : string) : option t =
    := fields = ~> get_union_fields_untag `t ()
    fields
    ++ (
        fields
        |> listm::map \ key', x =>
            key' |> sm'::to_lower, x
    )
    |> listm'::box
    |> listm'::to_array'
    |> \ x => array x : array _
    |> am'::try_pick \ key', x =>
        ? key' =. key
        ?> Some x
        |: None

///- --timeout 900000

///> gleam
///> lua
///> cuda
///> rust
///> typescript
:# union_try_pick =
    "Browser"
    |> union_try_pick
    |> _assert_eq (Some Browser)

    "Browser"
    |> union_try_pick
    |> _assert_eq (Some Browser)

:= union_try_pick' \* t. (key : string) : option t =
    := fields = ~> get_union_fields_untag `t ()
    fields
    ++ (
        fields
        |> listm::map \ key', x =>
            key' |> sm'::to_lower, x
    )
    |> listm'::try_pick \ key', x =>
        ? key' =. key
        ?> x |> Some
        |: None

