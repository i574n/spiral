### typed_name

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":":! typed_name t = string\n\n:= typed_case_name \\* t. (x : t) : typed_name t = typed_name (case_name x)\n:= case_qualified_name \\* t. (x : t) : string = !!!!NominalName(`t) ++# \"::\" ++# case_name x\n\n:= typed_name_text \\* t. ((typed_name text) : typed_name t) : string = text\n\n:= case_of_typed_name \\* t. ((typed_name text) : typed_name t) : option t = case_of_name text\n\n:= styled_step (separator : string) (acc : list string) (c : char) : list string =\n    := s = sm'::of_char c\n    := lower = sm'::to_lower s\n    ? lower <> s && listm::length acc > 0i32 ?> lower :: separator :: acc |: lower :: acc\n\n:= styled_name (separator : string) (text : string) : string =\n    sm'::to_char_list text |> listm::fold (styled_step separator) [] |> listm::rev |> sm'::concat_list \"\"\n\n:= typed_name_snake \\* t. ((typed_name text) : typed_name t) : string = styled_name \"_\" text\n\n:= typed_name_kebab \\* t. ((typed_name text) : typed_name t) : string = styled_name \"-\" text\n\n:= typed_name_lower \\* t. ((typed_name text) : typed_name t) : string = sm'::to_lower text\n\n///- --timeout 900000","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  :! typed_name t = string

  := typed_case_name \* t. (x : t) : typed_name t = typed_name (case_name x)
  := case_qualified_name \* t. (x : t) : string = !!!!NominalName(`t) ++# "::" ++# case_name x

  := typed_name_text \* t. ((typed_name text) : typed_name t) : string = text

  := case_of_typed_name \* t. ((typed_name text) : typed_name t) : option t = case_of_name text

  := styled_step (separator : string) (acc : list string) (c : char) : list string =
      := s = sm'::of_char c
      := lower = sm'::to_lower s
      ? lower <> s && listm::length acc > 0i32 ?> lower :: separator :: acc |: lower :: acc

  := styled_name (separator : string) (text : string) : string =
      sm'::to_char_list text |> listm::fold (styled_step separator) [] |> listm::rev |> sm'::concat_list ""

  := typed_name_snake \* t. ((typed_name text) : typed_name t) : string = styled_name "_" text

  := typed_name_kebab \* t. ((typed_name text) : typed_name t) : string = styled_name "-" text

  := typed_name_lower \* t. ((typed_name text) : typed_name t) : string = sm'::to_lower text

  ///- --timeout 900000
  """,
  timeout: 300_000
)
```

#### case_name (test)

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":"///- --test --symbol\n///> gleam\n///> lua\n///> cuda\n///> rust\n///> typescript\n\nContract\n|> case_name\n|> _assert_eq' \"Contract\"\n\nSome 3i32\n|> case_name\n|> _assert_eq' \"Some\"\n\n:= ~payload : option i32 = None\npayload\n|> case_name\n|> _assert_eq' \"None\"\n\n\"Browser\"\n|> case_of_name\n|> _assert_eq (Some Browser)\n\n\"browser\"\n|> case_of_name\n|> _assert_eq (None : option reflection_test_target)","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  ///- --test --symbol
  ///> gleam
  ///> lua
  ///> cuda
  ///> rust
  ///> typescript

  Contract
  |> case_name
  |> _assert_eq' "Contract"

  Some 3i32
  |> case_name
  |> _assert_eq' "Some"

  := ~payload : option i32 = None
  payload
  |> case_name
  |> _assert_eq' "None"

  "Browser"
  |> case_of_name
  |> _assert_eq (Some Browser)

  "browser"
  |> case_of_name
  |> _assert_eq (None : option reflection_test_target)
  """,
  timeout: 300_000
)
```

