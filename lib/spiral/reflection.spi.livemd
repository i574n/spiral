)
```

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":":= union_to_string \\* t. (x : t) : string =\n    ~> get_union_fields_untag `t ()\n    |> listm'::try_pick \\ key, x' =>\n        ? x' = x\n        ?> Some key\n        |:\n            := has_case =\n                ~>\n                    real_core::union_type_to_record\n                        `t\n                        \\* union_record_type. =>\n                            real_core::record_type_fold_back\n                                \\ _key =>\n                                    \\* value. acc =>\n                                        ? acc\n                                        ?> acc\n                                        |:\n                                            ?: value ?|\n                                            | () => !-\n                                            | _ => !+\n                                `union_record_type\n                                !-\n            ? has_case |> not\n            ?> None\n            |:\n                := x' = #?x' |> sm'::split \"(\" |> am'::index_base 0\n\n                ? #?x |> sm'::starts_with x'\n                ?> Some key\n                |: None\n    |> optionm::value\n\n///- --timeout 900000","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  := union_to_string \* t. (x : t) : string =
      ~> get_union_fields_untag `t ()
      |> listm'::try_pick \ key, x' =>
          ? x' = x
          ?> Some key
          |:
              := has_case =
                  ~>
                      real_core::union_type_to_record
                          `t
                          \* union_record_type. =>
                              real_core::record_type_fold_back
                                  \ _key =>
                                      \* value. acc =>
                                          ? acc
                                          ?> acc
                                          |:
                                              ?: value ?|
                                              | () => !-
                                              | _ => !+
                                  `union_record_type
                                  !-
              ? has_case |> not
              ?> None
              |:
                  := x' = #?x' |> sm'::split "(" |> am'::index_base 0

                  ? #?x |> sm'::starts_with x'
                  ?> Some key
                  |: None
      |> optionm::value

  ///- --timeout 900000
  """,
  timeout: 300_000
)
```

