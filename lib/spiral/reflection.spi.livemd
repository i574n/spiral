#### nameof_cases_round_trip (test)

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":"///- --test --symbol\n///> rust\n///> gleam\n///> lua\n///> typescript\n///> fsharp\n\nAlpha |> case_name |> case_of_name |> _assert_eq (Some Alpha)\nBeta |> case_name |> case_of_name |> _assert_eq (Some Beta)\nGamma |> case_name |> case_of_name |> _assert_eq (Some Gamma)\nDelta |> case_name |> _assert_eq' \"Delta\"\nEpsilon |> case_name |> case_of_name |> _assert_eq (Some Epsilon)\n\"epsilon\" |> case_of_name |> _assert_eq (None : option nameof_probe)","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  ///- --test --symbol
  ///> rust
  ///> gleam
  ///> lua
  ///> typescript
  ///> fsharp

  Alpha |> case_name |> case_of_name |> _assert_eq (Some Alpha)
  Beta |> case_name |> case_of_name |> _assert_eq (Some Beta)
  Gamma |> case_name |> case_of_name |> _assert_eq (Some Gamma)
  Delta |> case_name |> _assert_eq' "Delta"
  Epsilon |> case_name |> case_of_name |> _assert_eq (Some Epsilon)
  "epsilon" |> case_of_name |> _assert_eq (None : option nameof_probe)
  """,
  timeout: 300_000
)
