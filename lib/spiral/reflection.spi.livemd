## reflection

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":":= get_union_fields \\* union_type. () : list (string * union_type) =\n    ~>\n        real_core::union_type_to_record\n            `union_type\n            \\* union_record_type. =>\n                real_core::record_type_fold\n                    \\ acc key =>\n                        \\* value. =>\n                            := value =\n                                ?: value ?|\n                                | () => $'' : value\n                                | _ =>\n                                    backend_switch `value `({}) {\n                                        Gleam =\n                                            (\\ () =>\n                                                $'Nil' : value\n                                            ) : () -> value\n                                        Lua =\n                                            (\\ () =>\n                                                $'nil' : value\n                                            ) : () -> value\n                                        Fsharp =\n                                            (\\ () =>\n                                                $'Unchecked.defaultof<_>' : value\n                                            ) : () -> value\n                                        Python =\n                                            (\\ () =>\n                                                := is_python =\n                                                    backend_switch `bool `({}) {\n                                                        Gleam = (\\ () => !-) : () -> bool\n                                                        Lua = (\\ () => !-) : () -> bool\n                                                        Fsharp = (\\ () => !-) : () -> bool\n                                                        Python = (\\ () => !+) : () -> bool\n                                                    }\n                                                ? is_python ?>\n                                                    ?: value ?|\n                                                    | i8 => 0i8\n                                                    | i16 => 0i16\n                                                    | i32 => 0i32\n                                                    | i64 => 0i64\n                                                    | u8 => 0u8\n                                                    | u16 => 0u16\n                                                    | u32 => 0u32\n                                                    | u64 => 0u64\n                                                    | f32 => 0.0f32\n                                                    | f64 => 0.0f64\n                                                    | bool => !-\n                                                    | char => '\\0'\n                                                    | _ => $'None' : value\n                                                |: $'None' : value\n                                            ) : () -> value\n                                        Rust =\n                                            (\\ () =>\n                                                $'Default::default()' : value\n                                            ) : () -> value\n                                        Zig =\n                                            (\\ () =>\n                                                $'std.mem.zeroes(`value)' : value\n                                            ) : () -> value\n                                        TypeScript =\n                                            (\\ () =>\n                                                ?: value ?|\n                                                | i8 => 0i8\n                                                | i16 => 0i16\n                                                | i32 => 0i32\n                                                | i64 => 0i64\n                                                | u8 => 0u8\n                                                | u16 => 0u16\n                                                | u32 => 0u32\n                                                | u64 => 0u64\n                                                | f32 => 0.0f32\n                                                | f64 => 0.0f64\n                                                | bool => !-\n                                                | char => '\\0'\n                                                | _ => $'undefined' : value\n                                            ) : () -> value\n                                    }\n                            := item = real_core::nominal_create `union_type (key, value)\n                            := key' = sm'_real::symbol_to_string_real `(`key)\n                            (::) `(string * union_type) (key', item) acc\n                    (Nil `(string * union_type))\n                    `union_record_type\n:| reflection_test_target = Browser | Contract\n\n///- --timeout 900000","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  := get_union_fields \* union_type. () : list (string * union_type) =
      ~>
          real_core::union_type_to_record
              `union_type
              \* union_record_type. =>
                  real_core::record_type_fold
                      \ acc key =>
                          \* value. =>
                              := value =
                                  ?: value ?|
                                  | () => $'' : value
                                  | _ =>
                                      backend_switch `value `({}) {
                                          Gleam =
                                              (\ () =>
                                                  $'Nil' : value
                                              ) : () -> value
                                          Lua =
                                              (\ () =>
                                                  $'nil' : value
                                              ) : () -> value
                                          Fsharp =
                                              (\ () =>
                                                  $'Unchecked.defaultof<_>' : value
                                              ) : () -> value
                                          Python =
                                              (\ () =>
                                                  := is_python =
                                                      backend_switch `bool `({}) {
                                                          Gleam = (\ () => !-) : () -> bool
                                                          Lua = (\ () => !-) : () -> bool
                                                          Fsharp = (\ () => !-) : () -> bool
                                                          Python = (\ () => !+) : () -> bool
                                                      }
                                                  ? is_python ?>
                                                      ?: value ?|
                                                      | i8 => 0i8
                                                      | i16 => 0i16
                                                      | i32 => 0i32
                                                      | i64 => 0i64
                                                      | u8 => 0u8
                                                      | u16 => 0u16
                                                      | u32 => 0u32
                                                      | u64 => 0u64
                                                      | f32 => 0.0f32
                                                      | f64 => 0.0f64
                                                      | bool => !-
                                                      | char => '\0'
                                                      | _ => $'None' : value
                                                  |: $'None' : value
                                              ) : () -> value
                                          Rust =
                                              (\ () =>
                                                  $'Default::default()' : value
                                              ) : () -> value
                                          Zig =
                                              (\ () =>
                                                  $'std.mem.zeroes(`value)' : value
                                              ) : () -> value
                                          TypeScript =
                                              (\ () =>
                                                  ?: value ?|
                                                  | i8 => 0i8
                                                  | i16 => 0i16
                                                  | i32 => 0i32
                                                  | i64 => 0i64
                                                  | u8 => 0u8
                                                  | u16 => 0u16
                                                  | u32 => 0u32
                                                  | u64 => 0u64
                                                  | f32 => 0.0f32
                                                  | f64 => 0.0f64
                                                  | bool => !-
                                                  | char => '\0'
                                                  | _ => $'undefined' : value
                                              ) : () -> value
                                      }
                              := item = real_core::nominal_create `union_type (key, value)
                              := key' = sm'_real::symbol_to_string_real `(`key)
                              (::) `(string * union_type) (key', item) acc
                      (Nil `(string * union_type))
                      `union_record_type
  :| reflection_test_target = Browser | Contract

  ///- --timeout 900000
  """,
  timeout: 300_000
)
```

#### get_union_fields (test)

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":"///- --test --symbol\n///> rust\n///> typescript\n///> cuda\n\nget_union_fields ()\n|> listm'::box\n|> listm'::to_array'\n|> array\n|> am'::sort_by snd\n|> \\ (array x : array _) => x\n|> _assert_eq' (am'::base ;[ \"Browser\", Browser; \"Contract\", Contract ])\nget_union_fields ()\n|> listm'::box\n|> listm'::to_array'\n|> array\n|> am'::sort_by snd\n|> \\ (array x : array _) => x\n|> _assert_eq' (am'::base ;[ \"Some\", Some 0i32; \"None\", None ])","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  ///- --test --symbol
  ///> rust
  ///> typescript
  ///> cuda

  get_union_fields ()
  |> listm'::box
  |> listm'::to_array'
  |> array
  |> am'::sort_by snd
  |> \ (array x : array _) => x
  |> _assert_eq' (am'::base ;[ "Browser", Browser; "Contract", Contract ])
  get_union_fields ()
  |> listm'::box
  |> listm'::to_array'
  |> array
  |> am'::sort_by snd
  |> \ (array x : array _) => x
  |> _assert_eq' (am'::base ;[ "Some", Some 0i32; "None", None ])
  """,
  timeout: 300_000
)
```

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":":= get_union_fields_untag \\* union_type. () : list (string * union_type) =\n    ~>\n        real_core::union_type_to_record\n            `union_type\n            \\* union_record_type. =>\n                := result =\n                    real_core::record_type_fold_back\n                        \\ _key =>\n                            \\* value. (acc, (i : i32)) =>\n                                := key, item : (string * union_type) =\n                                    real_core::union_untag `union_type i\n                                        (\\ key => \\* value. =>\n                                            := key' = sm'_real::symbol_to_string_real `(`key)\n                                            := value =\n                                                ?: value ?|\n                                                | () => $'' : value\n                                                | _ =>\n                                                    backend_switch `value `({}) {\n                                                        Gleam =\n                                                            (\\ () =>\n                                                                $'Nil' : value\n                                                            ) : () -> value\n                                                        Lua =\n                                                            (\\ () =>\n                                                                $'nil' : value\n                                                            ) : () -> value\n                                                        Fsharp =\n                                                            (\\ () =>\n                                                                $'Unchecked.defaultof<_>' : value\n                                                            ) : () -> value\n                                                        Python =\n                                                            (\\ () =>\n                                                                $'None' : value\n                                                            ) : () -> value\n                                                        Rust =\n                                                            (\\ () =>\n                                                                $'Default::default()' : value\n                                                            ) : () -> value\n                                                        TypeScript =\n                                                            (\\ () =>\n                                                                $'undefined' : value\n                                                            ) : () -> value\n                                                        Zig =\n                                                            (\\ () =>\n                                                                $'std.mem.zeroes(`value)' : value\n                                                            ) : () -> value\n                                                    }\n                                            := item = real_core::nominal_create `union_type (key, value)\n                                            key', item\n                                        )\n                                        (\\ _ =>\n                                            failwith\n                                                `(string * union_type)\n                                                \"reflection.get_union_fields_untag / invalid tag\"\n                                        )\n                                (::) `(string * union_type) (key, item) acc, (+) `i32 i 1\n                        `union_record_type\n                        (Nil `(string * union_type), 0i32)\n                := result = fst `(list (string * union_type)) `i32 result\n                listm::rev `(string * union_type) result\n\n///- --timeout 900000","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  := get_union_fields_untag \* union_type. () : list (string * union_type) =
      ~>
          real_core::union_type_to_record
              `union_type
              \* union_record_type. =>
                  := result =
                      real_core::record_type_fold_back
                          \ _key =>
                              \* value. (acc, (i : i32)) =>
                                  := key, item : (string * union_type) =
                                      real_core::union_untag `union_type i
                                          (\ key => \* value. =>
                                              := key' = sm'_real::symbol_to_string_real `(`key)
                                              := value =
                                                  ?: value ?|
                                                  | () => $'' : value
                                                  | _ =>
                                                      backend_switch `value `({}) {
                                                          Gleam =
                                                              (\ () =>
                                                                  $'Nil' : value
                                                              ) : () -> value
                                                          Lua =
                                                              (\ () =>
                                                                  $'nil' : value
                                                              ) : () -> value
                                                          Fsharp =
                                                              (\ () =>
                                                                  $'Unchecked.defaultof<_>' : value
                                                              ) : () -> value
                                                          Python =
                                                              (\ () =>
                                                                  $'None' : value
                                                              ) : () -> value
                                                          Rust =
                                                              (\ () =>
                                                                  $'Default::default()' : value
                                                              ) : () -> value
                                                          TypeScript =
                                                              (\ () =>
                                                                  $'undefined' : value
                                                              ) : () -> value
                                                          Zig =
                                                              (\ () =>
                                                                  $'std.mem.zeroes(`value)' : value
                                                              ) : () -> value
                                                      }
                                              := item = real_core::nominal_create `union_type (key, value)
                                              key', item
                                          )
                                          (\ _ =>
                                              failwith
                                                  `(string * union_type)
                                                  "reflection.get_union_fields_untag / invalid tag"
                                          )
                                  (::) `(string * union_type) (key, item) acc, (+) `i32 i 1
                          `union_record_type
                          (Nil `(string * union_type), 0i32)
                  := result = fst `(list (string * union_type)) `i32 result
                  listm::rev `(string * union_type) result

  ///- --timeout 900000
  """,
  timeout: 300_000
)
```

#### get_union_fields_untag (test)

