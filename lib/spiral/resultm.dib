## rust

#!markdown

### anyhow_result

#!spiral

nominal anyhow_result t =
    `(
        global "#if FABLE_COMPILER\n[<Fable.Core.Erase; Fable.Core.Emit(\"anyhow::Result<$0>\")>]\n#endif\ntype anyhow_Result<'T> = class end"
        $'' : $'anyhow_Result<`t>'
    )

#!markdown

### anyhow_error

#!spiral

nominal anyhow_error =
    `(
        global "#if FABLE_COMPILER\n[<Fable.Core.Erase; Fable.Core.Emit(\"anyhow::Error\")>]\n#endif\ntype anyhow_Error = class end"
        $'' : $'anyhow_Error'
    )

inl anyhow_error error : anyhow_error =
    inl fable () : anyhow_error =
        !\\(error, $'"anyhow::anyhow\!($0)"')
    backend_switch {
        Gleam = fun () => fable ()
        Lua = fun () => fable ()
        Fsharp = fun () => fable ()
        Python = fun () => fable ()
        TypeScript = fun () => fable ()
        Cpp = fun () => fable ()
        CppHost = fun () => fable ()
        Delphi = fun () => fable ()
        Cuda = fun () => fable ()
        // Native strings are `Rc<str>` (not Send + Sync): anyhow takes them through a format string.
        Rust = fun () => !\\(error, $'"anyhow::anyhow\!(\\\"{}\\\", $0)"') : anyhow_error
    }

#!markdown

### try'

#!spiral

inl try' forall t u. (x : result' t u) : t =
    inl is_unit =
        real
            typecase t with
            | () => true
            | _ => false
    // native Python has no `?`: an Error raises, as unwrap'' does
    if result'_union ()
    then
        match unbox x with
        | Ok x => x
        | Error e =>
            inl msg : string =
                if result'_python ()
                then $'f"resultm.try\' / e: {!e}"'
                else $'"resultm.try\' / e: " .. tostring(!e)'
            failwith msg
    elif is_unit
    then (!\\(x, $'"true; $0?"') : bool) |> fun _ => $''
    else !\\(x, $'"$0?"')

#!markdown

### to_try

#!spiral

inl to_try forall t u. (x : result' t u) : rust.try t =
    !\\(x, $'"$0"')

#!markdown

### unwrap'

#!spiral

inl unwrap' forall t u. (x : result' t u) : t =
    if result'_union ()
    then
        match unbox x with
        | Ok x => x
        | Error e =>
            inl msg : string =
                if result'_python ()
                then $'f"resultm.unwrap\' / e: {!e}"'
                else $'"resultm.unwrap\' / e: " .. tostring(!e)'
            failwith msg
    else !\\(x, $'"$0.unwrap()"')

#!markdown

### unwrap''

#!spiral

inl unwrap'' forall t u. (x : result' t u) : t =
    if result'_union ()
    then
        match unbox x with
        | Ok x => x
        | Error e =>
            inl msg : string =
                if result'_python ()
                then $'f"resultm.unwrap\'\' / e: {!e}"'
                else $'"resultm.unwrap\'\' / e: " .. tostring(!e)'
            failwith msg
    else
        run_target function
            | Rust _ | RustNative => fun () => x |> unwrap'
            | _ => fun () => $'match !x with Ok x -> x | Error e -> failwith $"resultm.unwrap\'\' / e: {e}"'

#!markdown

### unwrap_err'

#!spiral

inl unwrap_err' forall t u. (x : result' t u) : u =
    if result'_union ()
    then
        match unbox x with
        | Ok x =>
            inl msg : string =
                if result'_python ()
                then $'f"resultm.unwrap_err\' / x: {!x}"'
                else $'"resultm.unwrap_err\' / x: " .. tostring(!x)'
            failwith msg
        | Error x => x
    else $'match !x with Ok x -> failwith $"resultm.unwrap_err\' / x: %A{x}" | Error x -> x'

#!markdown

### unbox'

#!spiral

inl unbox' forall t u. (x : result' t u) : result t u =
    // Natively a unit closure takes no argument (`$0(())` doesn't build), so the native backend uses unbox's Rust arm.
    if rust.is_native () || result'_union ()
    then unbox x
    else
        inl ok x : result t u = Ok x
        inl ok = join ok
        inl error x : result t u = Error x
        inl error = join error
        real
            typecase t with
            | () =>
                (~!\\)
                    `((result' t u -> result t u) * (result' t u -> result t u))
                    `(result t u)
                    ((ok, error, x), ($'"match $2 { Ok(()) => $0(()), Err(e) => $1(e) }"' : string))
            | _ =>
                (~!\\)
                    `((result' t u -> result t u) * (result' t u -> result t u))
                    `(result t u)
                    ((ok, error, x), ($'"match $2 { Ok(x) => $0(x), Err(e) => $1(e) }"' : string))

