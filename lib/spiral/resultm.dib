## fsharp

#!markdown

### result'

#!spiral

inl result'_types () =
    backend_switch {
        Gleam = fun () => global "import gleam/result"
    }
type result'_switch t u =
    {
        Gleam : $'Result(`t, `u)'
        // Lua: the union too (see result'_union)
        Lua : result t u
        Fsharp : $'Result<`t, `u>'
        // native Python: result' is the `result t u` union itself (Ok is tag 0, Error tag 1), so Ok and Error stay
        // apart as in F# (a bare value can't tell `Error e` from `Ok e`)
        Python : result t u
        Rust : $'Result<`t, `u>'
    }
nominal result' t u = $'backend_switch `(result'_switch t u)'

// Lua and native Python: result' is the `result t u` union itself (Ok is tag 0, Error tag 1); a bare value can't tell
// `Error e` from `Ok e`
inl result'_union () : bool =
    backend_switch {
        Gleam = fun () => false
        Lua = fun () => true
        Fsharp = fun () => false
        Python = fun () => true
        TypeScript = fun () => false
        Cpp = fun () => false
        CppHost = fun () => false
        Delphi = fun () => false
        Cuda = fun () => false
        Rust = fun () => false
    }

inl result'_python () : bool =
    backend_switch {
        Gleam = fun () => false
        Lua = fun () => false
        Fsharp = fun () => false
        Python = fun () => true
        TypeScript = fun () => false
        Cpp = fun () => false
        CppHost = fun () => false
        Delphi = fun () => false
        Cuda = fun () => false
        Rust = fun () => false
    }

#!markdown

### unbox

#!spiral

inl unbox forall t u. (x : result' t u) : result t u =
    // native Python: result' already is the union (see result'_switch)
    if result'_union ()
    then $'!x ' : result t u
    else
        inl ok x : result t u = Ok x
        inl error x : result t u = Error x
        inl ok = join ok
        inl error = join error
        backend_switch {
            Gleam = fun () =>
                $'case !x { Ok(x) -> !ok(x) Error(x) -> !error(x) }' : result t u
            Lua = fun () =>
                $'local resultm_ok = !ok '
                $'local resultm_error = !error '
                $'local r = nil'
                $'if !x ~= nil then'
                $'    r = resultm_ok(!x)'
                $'else'
                $'    r = resultm_error(!x)'
                $'end'
                $'r' : result t u
            Fsharp = fun () =>
                real
                    typecase t with
                    | () => $'match !x with Ok () -> !ok () | Error x -> !error x' : result t u
                    | _ => $'match !x with Ok x -> !ok x | Error x -> !error x' : result t u
                : result t u
            // unused (Python takes the branch above); kept so the other backends' output stays unchanged
            Python = fun () =>
                $'ok = !ok '
                $'error = !error '
                $'r = None'
                $'if !x is not None:'
                $'    r = ok(!x)'
                $'else:'
                $'    r = error(!x)'
                $'r' : result t u
            Rust = fun () =>
                real
                    typecase t with
                    | () => $'match !x { Ok(()) => !ok(), Err(e) => !error(e) }' : result t u
                    | _ => $'match !x { Ok(x) => !ok(x), Err(e) => !error(e) }' : result t u
                : result t u
        }

#!markdown

### box

#!spiral

inl box forall t u. (x : result t u) : result' t u =
    // native Python: the union value itself (a known case becomes a US constructor call)
    if result'_union ()
    then x |> dyn |> fun x => $'!x ' : result' t u
    else
        match x with
        | Ok x =>
            backend_switch {
                Gleam = fun () => $'Ok(!x)' : result' t u
                Lua = fun () => $'!x ' : result' t u
                Fsharp = fun () => $'Ok !x ' : result' t u
                // unused (Python takes the branch above); kept so the other backends' output stays unchanged
                Python = fun () => $'!x ' : result' t u
                Rust = fun () => $'Ok::<`t, `u>(!x)' : result' t u
            }
        | Error err =>
            backend_switch {
                Gleam = fun () => $'Error(!err)' : result' t u
                Lua = fun () => $'!err ' : result' t u
                Fsharp = fun () => $'Error !err ' : result' t u
                Python = fun () => $'!err ' : result' t u
                Rust = fun () => $'Err::<`t, `u>(!err)' : result' t u
            }

#!markdown

### map'''

#!spiral

inl map''' forall t u e. (fn : t -> u) (x : result' t e) : result' u e =
    // native Python: map through the union, as the native Rust arm does
    if result'_union ()
    then x |> unbox |> map fn |> box
    else
        backend_switch {
            Gleam = fun () =>
                result'_types ()
                // inl fn = join fn
                $'!x |> result.map(!fn)' : result' u e
            Lua = fun () =>
                if x =. $'nil'
                then $'!x '
                else fn $'!x ' |> fun x => $'!x ' : result' u e
            Fsharp = fun () =>
                inl fn = join fn
                $'!x |> Result.map !fn ' : result' u e
            // unused (Python takes the branch above); kept so the other backends' output stays unchanged
            Python = fun () =>
                if x =. $'None'
                then $'!x '
                else fn $'!x ' |> fun x => $'!x ' : result' u e
            // native Rust: result' is Result<T, E>; map through the union (unbox/box carry the native arms)
            Rust = fun () =>
                inl r : result u e =
                    match unbox x with
                    | Ok v => Ok (fn v)
                    | Error e => Error e
                box r
        }

#!spiral

///- --test
///> gleam
///> lua
///> fsharp
///> cuda
///> rust
///> typescript

inl x : _ _ string = Ok 3i32
inl y : _ i32 _ = Error "error1"
inl x' = x |> box |> unbox
inl y' = y |> box |> map''' id |> unbox
(x', y') |> _assert_eq' (x, y)

