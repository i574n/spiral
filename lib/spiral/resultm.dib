### unwrap_or'

#!spiral

inl unwrap_or' forall t u. (default : t) (x : result' t u) : t =
    if result'_union ()
    then
        match unbox x with
        | Ok x => x
        | Error _ => default
    else !\\((x, default), $'"$0.unwrap_or($1)"')

#!markdown

### expect

#!spiral

inl expect forall t u. (error : rust.ref string) (x : result' t u) : t =
    !\($'"!x.expect(&!error)"')

#!markdown

### is_err

#!spiral

inl is_err forall t u. (x : result' t u) : bool =
    // native Python tells the cases apart (the `_` arm below is a stub that answers true for Ok too)
    if result'_union ()
    then
        match unbox x with
        | Ok _ => false
        | Error _ => true
    else
        run_target function
            | Rust _ | RustNative => fun () => !\\(x, $'"$0.is_err()"')
            | _ => fun () => true

#!markdown

### ok'

#!spiral

inl ok' forall t. (x : result' t _) : optionm'.option' t =
    if result'_union ()
    then x |> unbox |> ok |> optionm'.box
    else
        run_target function
            | Rust _ | RustNative => fun () => !\\(x, $'"$0.ok()"')
            | _ => fun () => $'match !x with Ok x -> Some x | Error _ -> None'

#!markdown

### err

#!spiral

inl err forall t u. (x : u) : result' t u =
    if result'_union ()
    then (Error x : result t u) |> box
    else
        run_target function
            | Rust _ | RustNative => fun () => !\\(x, $'"Err($0)"')
            | _ => fun () => $'!x |> Error'

#!markdown

### ok''

#!spiral

inl ok'' forall t u. (x : t) : result' t u =
    if result'_union ()
    then (Ok x : result t u) |> box
    else
        run_target function
            | Rust _ | RustNative => fun () => !\\(x, $'"Ok($0)"')
            | _ => fun () => $'!x |> Ok'

#!markdown

### transpose

#!spiral

inl transpose forall t u. (x : optionm'.option' (result' t u)) : result' (optionm'.option' t) u =
    if result'_union ()
    then
        inl r : result (optionm'.option' t) u =
            match optionm'.unbox x with
            | Some x =>
                match unbox x with
                | Ok x => Ok (optionm'.some' x)
                | Error e => Error e
            | None => Ok (optionm'.none' ())
        box r
    else !\\(x, $'"$0.transpose()"')

