### anyhow_error

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"nominal anyhow_error =\n    `(\n        rust_type\n            `($'anyhow_Error')\n            `($'anyhow::Error')\n            \"type anyhow_Error = class end\"\n    )\n\ninl anyhow_error error : anyhow_error =\n    backend_switch {\n        // Native strings are `Rc<str>` (not Send + Sync): anyhow takes them through a format string.\n        Rust = fun () => !\\\\(error, $'\"anyhow::anyhow\\!(\\\\\\\"{}\\\\\\\", $0)\"') : anyhow_error\n    }","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  nominal anyhow_error =
      `(
          rust_type
              `($'anyhow_Error')
              `($'anyhow::Error')
              "type anyhow_Error = class end"
      )

  inl anyhow_error error : anyhow_error =
      backend_switch {
          // Native strings are `Rc<str>` (not Send + Sync): anyhow takes them through a format string.
          Rust = fun () => !\\(error, $'"anyhow::anyhow\!(\\\"{}\\\", $0)"') : anyhow_error
      }
  """,
  timeout: 300_000
)
```

### try'

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"inl try' forall t u. (x : result' t u) : t =\n    inl is_unit =\n        real\n            typecase t with\n            | () => true\n            | _ => false\n    // Python has no `?`: an Error raises, as unwrap'' does\n    if result'_union ()\n    then\n        match unbox x with\n        | Ok x => x\n        | Error e =>\n            inl msg : string =\n                if result'_python ()\n                then $'f\"resultm.try\\' / e: {!e}\"'\n                else $'\"resultm.try\\' / e: \" .. tostring(!e)'\n            failwith msg\n    elif is_unit\n    then (!\\\\(x, $'\"true; $0?\"') : bool) |> fun _ => $''\n    else !\\\\(x, $'\"$0?\"')","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  inl try' forall t u. (x : result' t u) : t =
      inl is_unit =
          real
              typecase t with
              | () => true
              | _ => false
      // Python has no `?`: an Error raises, as unwrap'' does
      if result'_union ()
      then
          match unbox x with
          | Ok x => x
          | Error e =>
              inl msg : string =
                  if result'_python ()
                  then $'f"resultm.try\' / e: {!e}"'
                  else $'"resultm.try\' / e: " .. tostring(!e)'
              failwith msg
      elif is_unit
      then (!\\(x, $'"true; $0?"') : bool) |> fun _ => $''
      else !\\(x, $'"$0?"')
  """,
  timeout: 300_000
)
```

