### unwrap''

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"inl unwrap'' forall t u. (x : result' t u) : t =\n    if result'_union ()\n    then\n        match unbox x with\n        | Ok x => x\n        | Error e =>\n            inl msg : string =\n                if result'_python ()\n                then $'f\"resultm.unwrap\\'\\' / e: {!e}\"'\n                else $'\"resultm.unwrap\\'\\' / e: \" .. tostring(!e)'\n            failwith msg\n    else\n        run_target function\n            | Rust => fun () => x |> unwrap'\n            | _ => fun () => $'match !x with Ok x -> x | Error e -> failwith $\"resultm.unwrap\\'\\' / e: {e}\"'","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  inl unwrap'' forall t u. (x : result' t u) : t =
      if result'_union ()
      then
          match unbox x with
          | Ok x => x
          | Error e =>
              inl msg : string =
                  if result'_python ()
                  then $'f"resultm.unwrap\'\' / e: {!e}"'
                  else $'"resultm.unwrap\'\' / e: " .. tostring(!e)'
              failwith msg
      else
          run_target function
              | Rust => fun () => x |> unwrap'
              | _ => fun () => $'match !x with Ok x -> x | Error e -> failwith $"resultm.unwrap\'\' / e: {e}"'
  """,
  timeout: 300_000
)
```

### unwrap_err'

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"inl unwrap_err' forall t u. (x : result' t u) : u =\n    if result'_union ()\n    then\n        match unbox x with\n        | Ok x =>\n            inl msg : string =\n                if result'_python ()\n                then $'f\"resultm.unwrap_err\\' / x: {!x}\"'\n                else $'\"resultm.unwrap_err\\' / x: \" .. tostring(!x)'\n            failwith msg\n        | Error x => x\n    else $'match !x with Ok x -> failwith $\"resultm.unwrap_err\\' / x: %A{x}\" | Error x -> x'","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  inl unwrap_err' forall t u. (x : result' t u) : u =
      if result'_union ()
      then
          match unbox x with
          | Ok x =>
              inl msg : string =
                  if result'_python ()
                  then $'f"resultm.unwrap_err\' / x: {!x}"'
                  else $'"resultm.unwrap_err\' / x: " .. tostring(!x)'
              failwith msg
          | Error x => x
      else $'match !x with Ok x -> failwith $"resultm.unwrap_err\' / x: %A{x}" | Error x -> x'
  """,
