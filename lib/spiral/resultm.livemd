## fsharp

<!-- livebook:{"break_markdown":true} -->

### result'

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"inl result'_types () =\n    backend_switch {\n        Gleam = fun () => global \"import gleam/result\"\n    }\ntype result'_switch t u =\n    {\n        Gleam : $'Result(`t, `u)'\n        // Lua: the union too (see result'_union)\n        Lua : result t u\n        Fsharp : $'Result<`t, `u>'\n        // Python: result' is the `result t u` union itself (Ok is tag 0, Error tag 1), so Ok and Error stay\n        // apart as in F# (a bare value can't tell `Error e` from `Ok e`)\n        Python : result t u\n        Rust : $'Result<`t, `u>'\n    }\nnominal result' t u = $'backend_switch `(result'_switch t u)'\n\n// Lua and Python: result' is the `result t u` union itself (Ok is tag 0, Error tag 1); a bare value can't tell\n// `Error e` from `Ok e`\ninl result'_union () : bool =\n    backend_switch {\n        Gleam = fun () => false\n        Lua = fun () => true\n        Fsharp = fun () => false\n        Python = fun () => true\n        TypeScript = fun () => false\n        Cpp = fun () => false\n        CppHost = fun () => false\n        Delphi = fun () => false\n        Cuda = fun () => false\n        Rust = fun () => false\n    }\n\ninl result'_python () : bool =\n    backend_switch {\n        Gleam = fun () => false\n        Lua = fun () => false\n        Fsharp = fun () => false\n        Python = fun () => true\n        TypeScript = fun () => false\n        Cpp = fun () => false\n        CppHost = fun () => false\n        Delphi = fun () => false\n        Cuda = fun () => false\n        Rust = fun () => false\n    }","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  inl result'_types () =
      backend_switch {
          Gleam = fun () => global "import gleam/result"
      }
  type result'_switch t u =
      {
          Gleam : $'Result(`t, `u)'
          // Lua: the union too (see result'_union)
          Lua : result t u
          Fsharp : $'Result<`t, `u>'
          // Python: result' is the `result t u` union itself (Ok is tag 0, Error tag 1), so Ok and Error stay
          // apart as in F# (a bare value can't tell `Error e` from `Ok e`)
          Python : result t u
          Rust : $'Result<`t, `u>'
      }
  nominal result' t u = $'backend_switch `(result'_switch t u)'

  // Lua and Python: result' is the `result t u` union itself (Ok is tag 0, Error tag 1); a bare value can't tell
  // `Error e` from `Ok e`
  inl result'_union () : bool =
      backend_switch {
          Gleam = fun () => false
          Lua = fun () => true
          Fsharp = fun () => false
          Python = fun () => true
          TypeScript = fun () => false
          Cpp = fun () => false
          CppHost = fun () => false
          Delphi = fun () => false
          Cuda = fun () => false
          Rust = fun () => false
      }

  inl result'_python () : bool =
      backend_switch {
          Gleam = fun () => false
          Lua = fun () => false
          Fsharp = fun () => false
          Python = fun () => true
          TypeScript = fun () => false
          Cpp = fun () => false
          CppHost = fun () => false
          Delphi = fun () => false
          Cuda = fun () => false
          Rust = fun () => false
      }
  """,
  timeout: 300_000
)
```

### unbox

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"inl unbox forall t u. (x : result' t u) : result t u =\n    // Python: result' already is the union (see result'_switch)\n    if result'_union ()\n    then $'!x ' : result t u\n    else\n        inl ok x : result t u = Ok x\n        inl error x : result t u = Error x\n        inl ok = join ok\n        inl error = join error\n        backend_switch {\n            Gleam = fun () =>\n                $'case !x { Ok(x) -> !ok(x) Error(x) -> !error(x) }' : result t u\n            Lua = fun () =>\n                $'local resultm_ok = !ok '\n                $'local resultm_error = !error '\n                $'local r = nil'\n                $'if !x ~= nil then'\n                $'    r = resultm_ok(!x)'\n                $'else'\n                $'    r = resultm_error(!x)'\n                $'end'\n                $'r' : result t u\n            Fsharp = fun () =>\n                real\n                    typecase t with\n                    | () => $'match !x with Ok () -> !ok () | Error x -> !error x' : result t u\n                    | _ => $'match !x with Ok x -> !ok x | Error x -> !error x' : result t u\n                : result t u\n            // unused (Python takes the branch above); kept so the other backends' output stays unchanged\n            Python = fun () =>\n                $'ok = !ok '\n                $'error = !error '\n                $'r = None'\n                $'if !x is not None:'\n                $'    r = ok(!x)'\n                $'else:'\n                $'    r = error(!x)'\n                $'r' : result t u\n            Rust = fun () =>\n                real\n                    typecase t with\n                    | () => $'match !x { Ok(()) => !ok(), Err(e) => !error(e) }' : result t u\n                    | _ => $'match !x { Ok(x) => !ok(x), Err(e) => !error(e) }' : result t u\n                : result t u\n        }","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  inl unbox forall t u. (x : result' t u) : result t u =
      // Python: result' already is the union (see result'_switch)
      if result'_union ()
      then $'!x ' : result t u
      else
          inl ok x : result t u = Ok x
          inl error x : result t u = Error x
          inl ok = join ok
          inl error = join error
          backend_switch {
              Gleam = fun () =>
                  $'case !x { Ok(x) -> !ok(x) Error(x) -> !error(x) }' : result t u
              Lua = fun () =>
                  $'local resultm_ok = !ok '
                  $'local resultm_error = !error '
                  $'local r = nil'
                  $'if !x ~= nil then'
                  $'    r = resultm_ok(!x)'
                  $'else'
                  $'    r = resultm_error(!x)'
                  $'end'
                  $'r' : result t u
              Fsharp = fun () =>
                  real
                      typecase t with
                      | () => $'match !x with Ok () -> !ok () | Error x -> !error x' : result t u
                      | _ => $'match !x with Ok x -> !ok x | Error x -> !error x' : result t u
                  : result t u
              // unused (Python takes the branch above); kept so the other backends' output stays unchanged
              Python = fun () =>
                  $'ok = !ok '
                  $'error = !error '
                  $'r = None'
                  $'if !x is not None:'
                  $'    r = ok(!x)'
                  $'else:'
                  $'    r = error(!x)'
                  $'r' : result t u
              Rust = fun () =>
                  real
                      typecase t with
                      | () => $'match !x { Ok(()) => !ok(), Err(e) => !error(e) }' : result t u
                      | _ => $'match !x { Ok(x) => !ok(x), Err(e) => !error(e) }' : result t u
                  : result t u
          }
  """,
  timeout: 300_000
)
```

### box

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"inl box forall t u. (x : result t u) : result' t u =\n    // Python: the union value itself (a known case becomes a US constructor call)\n    if result'_union ()\n    then x |> dyn |> fun x => $'!x ' : result' t u\n    else\n        match x with\n        | Ok x =>\n            backend_switch {\n                Gleam = fun () => $'Ok(!x)' : result' t u\n                Lua = fun () => $'!x ' : result' t u\n                Fsharp = fun () => $'Ok !x ' : result' t u\n                // unused (Python takes the branch above); kept so the other backends' output stays unchanged\n                Python = fun () => $'!x ' : result' t u\n                Rust = fun () => $'Ok::<`t, `u>(!x)' : result' t u\n            }\n        | Error err =>\n            backend_switch {\n                Gleam = fun () => $'Error(!err)' : result' t u\n                Lua = fun () => $'!err ' : result' t u\n                Fsharp = fun () => $'Error !err ' : result' t u\n                Python = fun () => $'!err ' : result' t u\n                Rust = fun () => $'Err::<`t, `u>(!err)' : result' t u\n            }","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  inl box forall t u. (x : result t u) : result' t u =
      // Python: the union value itself (a known case becomes a US constructor call)
      if result'_union ()
      then x |> dyn |> fun x => $'!x ' : result' t u
      else
          match x with
          | Ok x =>
              backend_switch {
                  Gleam = fun () => $'Ok(!x)' : result' t u
                  Lua = fun () => $'!x ' : result' t u
                  Fsharp = fun () => $'Ok !x ' : result' t u
                  // unused (Python takes the branch above); kept so the other backends' output stays unchanged
                  Python = fun () => $'!x ' : result' t u
                  Rust = fun () => $'Ok::<`t, `u>(!x)' : result' t u
              }
          | Error err =>
              backend_switch {
                  Gleam = fun () => $'Error(!err)' : result' t u
                  Lua = fun () => $'!err ' : result' t u
                  Fsharp = fun () => $'Error !err ' : result' t u
                  Python = fun () => $'!err ' : result' t u
                  Rust = fun () => $'Err::<`t, `u>(!err)' : result' t u
              }
  """,
  timeout: 300_000
)
```

### map'''

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"inl map''' forall t u e. (fn : t -> u) (x : result' t e) : result' u e =\n    // every backend maps through the union (unbox/box carry the backend arms)\n    x |> unbox |> map fn |> box","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  inl map''' forall t u e. (fn : t -> u) (x : result' t e) : result' u e =
      // every backend maps through the union (unbox/box carry the backend arms)
      x |> unbox |> map fn |> box
  """,
  timeout: 300_000
)
```

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"///- --test\n///> gleam\n///> lua\n///> fsharp\n///> cuda\n///> rust\n///> typescript\n\ninl x : _ _ string = Ok 3i32\ninl y : _ i32 _ = Error \"error1\"\ninl x' = x |> box |> unbox\ninl y' = y |> box |> map''' id |> unbox\n(x', y') |> _assert_eq' (x, y)","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  ///- --test
  ///> gleam
  ///> lua
  ///> fsharp
  ///> cuda
  ///> rust
  ///> typescript

  inl x : _ _ string = Ok 3i32
  inl y : _ i32 _ = Error "error1"
  inl x' = x |> box |> unbox
  inl y' = y |> box |> map''' id |> unbox
  (x', y') |> _assert_eq' (x, y)
  """,
  timeout: 300_000
)
```

## rust

<!-- livebook:{"break_markdown":true} -->

### anyhow_result

