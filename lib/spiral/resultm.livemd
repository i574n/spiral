### from_try

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"inl from_try forall t. (fn : () -> t) (ex_fn : (() -> exn) -> exn) : result t exn =\n    inl ok x = x |> Ok : result t exn\n    inl error (e : exn) = e |> Error : result t exn\n    backend_switch {\n        Lua = fun () =>\n            $'local resultm_fn = !fn '\n            $'local resultm_ok = !ok '\n            $'local resultm_error = !error '\n            $'local resultm_ex_fn = !ex_fn '\n            $'local status, result = pcall(resultm_fn)'\n            $'local r = nil'\n            $'if status then'\n            $'    r = resultm_ok(result)'\n            $'else'\n            $'    r = resultm_error(resultm_ex_fn(function() return result end))'\n            $'end'\n            $'r' : result t exn\n        Fsharp = fun () =>\n            join $'try !fn () |> !ok with ex -> (fun () -> ex) |> !ex_fn |> !error ' : result t exn\n        Python = fun () =>\n            $'fn = !fn '\n            $'ok = !ok '\n            $'error = !error '\n            $'ex_fn = !ex_fn '\n            $'try: x = ok(fn()) '\n            $'except Exception as ex: x = error(ex_fn(lambda: ex))'\n            $'x' : result t exn\n    }","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  inl from_try forall t. (fn : () -> t) (ex_fn : (() -> exn) -> exn) : result t exn =
      inl ok x = x |> Ok : result t exn
      inl error (e : exn) = e |> Error : result t exn
      backend_switch {
          Lua = fun () =>
              $'local resultm_fn = !fn '
              $'local resultm_ok = !ok '
              $'local resultm_error = !error '
              $'local resultm_ex_fn = !ex_fn '
              $'local status, result = pcall(resultm_fn)'
              $'local r = nil'
              $'if status then'
              $'    r = resultm_ok(result)'
              $'else'
              $'    r = resultm_error(resultm_ex_fn(function() return result end))'
              $'end'
              $'r' : result t exn
          Fsharp = fun () =>
              join $'try !fn () |> !ok with ex -> (fun () -> ex) |> !ex_fn |> !error ' : result t exn
          Python = fun () =>
              $'fn = !fn '
              $'ok = !ok '
              $'error = !error '
              $'ex_fn = !ex_fn '
              $'try: x = ok(fn()) '
              $'except Exception as ex: x = error(ex_fn(lambda: ex))'
              $'x' : result t exn
      }
  """,
  timeout: 300_000
)
```

### get

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"inl get forall t e. (source : result t e) : t =\n    match source with\n    | Ok x => x\n    | Error x =>\n        backend_switch {\n            Gleam = fun () =>\n                global \"import gleam/string\"\n                $'\"resultm.get / Error x: \" <> string.inspect(!x)' : string\n            Lua = fun () => $'\"resultm.get / Error x: \" .. tostring(!x)' : string\n            Fsharp = fun () => $'$\"resultm.get / Error x: {!x}\"' : string\n            Python = fun () => $'f\"resultm.get / Error x: {!x}\"' : string\n            Rust = fun () => $'Rc::<str>::from({ struct SpiralDebug<T>(T); trait SpiralDebugShow { fn show(&self) -> String; } impl<T: std::fmt::Debug> SpiralDebugShow for SpiralDebug<T> { fn show(&self) -> String { format\\!(\"{:?}\", self.0) } } trait SpiralTypeShow { fn show(&self) -> String; } impl<T> SpiralTypeShow for &SpiralDebug<T> { fn show(&self) -> String { String::from(std::any::type_name::<T>()) } } format\\!(\"resultm.get / Error x: {}\", (&SpiralDebug(&!x)).show()) })' : string\n        }\n        |> failwith","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  inl get forall t e. (source : result t e) : t =
      match source with
      | Ok x => x
      | Error x =>
          backend_switch {
              Gleam = fun () =>
                  global "import gleam/string"
                  $'"resultm.get / Error x: " <> string.inspect(!x)' : string
              Lua = fun () => $'"resultm.get / Error x: " .. tostring(!x)' : string
              Fsharp = fun () => $'$"resultm.get / Error x: {!x}"' : string
              Python = fun () => $'f"resultm.get / Error x: {!x}"' : string
              Rust = fun () => $'Rc::<str>::from({ struct SpiralDebug<T>(T); trait SpiralDebugShow { fn show(&self) -> String; } impl<T: std::fmt::Debug> SpiralDebugShow for SpiralDebug<T> { fn show(&self) -> String { format\!("{:?}", self.0) } } trait SpiralTypeShow { fn show(&self) -> String; } impl<T> SpiralTypeShow for &SpiralDebug<T> { fn show(&self) -> String { String::from(std::any::type_name::<T>()) } } format\!("resultm.get / Error x: {}", (&SpiralDebug(&!x)).show()) })' : string
          }
          |> failwith
  """,
  timeout: 300_000
)
```

