<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":":= get \\* t e. (source : result t e) : t =\n    ?= source ?|\n    | Ok x => x\n    | Error x =>\n        backend_switch {\n            Gleam = \\ () =>\n                global \"import gleam/string\"\n                $'\"resultm.get / Error x: \" <> string.inspect(!x)' : string\n            Lua = \\ () => $'\"resultm.get / Error x: \" .. tostring(!x)' : string\n            Fsharp = \\ () => $'$\"resultm.get / Error x: {!x}\"' : string\n            Python = \\ () => $'f\"resultm.get / Error x: {!x}\"' : string\n            TypeScript = \\ () => $'\"resultm.get / Error x: \" + String(!x)' : string\n            Rust = \\ () => rust_debug_message \"resultm.get / Error x: \" x\n            Zig = fun () => $'(std.fmt.allocPrint(spiral_gpa, \"resultm.get / Error x: {any}\", .{ !x }) catch \\\n                \\@panic(\"out of memory\"))' : string\n        }\n        |> failwith\n\n:= map \\* t e u. (fn : t -> u) (source : result t e) : result u e =\n    ?= source ?|\n    | Ok x => x |> fn |> Ok\n    | Error x => Error x\n\n:= map_error \\* t e u. (fn : e -> u) (source : result t e) : result t u =\n    ?= source ?|\n    | Ok x => Ok x\n    | Error x => x |> fn |> Error\n\n:= collect_list \\* t e. (items : list (result t e)) : result (list t) e =\n    :~ ^ collected (items : list (result t e)) (acc : list t) : result (list t) e =\n        ?= items ?|\n        | [] => Ok (listm::rev acc)\n        | Error e :: _ => Error e\n        | Ok x :: rest => collected rest (x :: acc)\n    collected items []","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  := get \* t e. (source : result t e) : t =
      ?= source ?|
      | Ok x => x
      | Error x =>
          backend_switch {
              Gleam = \ () =>
                  global "import gleam/string"
                  $'"resultm.get / Error x: " <> string.inspect(!x)' : string
              Lua = \ () => $'"resultm.get / Error x: " .. tostring(!x)' : string
              Fsharp = \ () => $'$"resultm.get / Error x: {!x}"' : string
              Python = \ () => $'f"resultm.get / Error x: {!x}"' : string
              TypeScript = \ () => $'"resultm.get / Error x: " + String(!x)' : string
              Rust = \ () => rust_debug_message "resultm.get / Error x: " x
              Zig = fun () => $'(std.fmt.allocPrint(spiral_gpa, "resultm.get / Error x: {any}", .{ !x }) catch \
                  \@panic("out of memory"))' : string
          }
          |> failwith

  := map \* t e u. (fn : t -> u) (source : result t e) : result u e =
      ?= source ?|
      | Ok x => x |> fn |> Ok
      | Error x => Error x

  := map_error \* t e u. (fn : e -> u) (source : result t e) : result t u =
      ?= source ?|
      | Ok x => Ok x
      | Error x => x |> fn |> Error

  := collect_list \* t e. (items : list (result t e)) : result (list t) e =
      :~ ^ collected (items : list (result t e)) (acc : list t) : result (list t) e =
          ?= items ?|
          | [] => Ok (listm::rev acc)
          | Error e :: _ => Error e
          | Ok x :: rest => collected rest (x :: acc)
      collected items []
  """,
  timeout: 300_000
)
```

#### collect_list_keeps_order_and_stops_at_the_first_error (test)

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":"///- --test --symbol\n///> rust\n///> gleam\n\n:= ~bad = \"bad\"\n(collect_list ([ Ok 1i32; Ok 2 ] : list (result i32 string)), collect_list [ Ok 1i32; Error bad; Error \"later\" ])\n|> _assert_eq (Ok [ 1i32; 2 ], Error \"bad\")","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  ///- --test --symbol
  ///> rust
  ///> gleam

  := ~bad = "bad"
  (collect_list ([ Ok 1i32; Ok 2 ] : list (result i32 string)), collect_list [ Ok 1i32; Error bad; Error "later" ])
  |> _assert_eq (Ok [ 1i32; 2 ], Error "bad")
  """,
  timeout: 300_000
)
```

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":":= unwrap_err \\* t u. (x : result t u) : u =\n    ?= x ?|\n    | Ok x =>\n        backend_switch {\n            Gleam = \\ () =>\n                global \"import gleam/string\"\n                $'\"resultm.unwrap_err / Ok x: \" <> string.inspect(!x)' : string\n            Lua = \\ () => $'\"resultm.unwrap_err / Ok x: \" .. tostring(!x)' : string\n            Fsharp = \\ () => $'$\"resultm.unwrap_err / Ok x: {!x}\"' : string\n            Python = \\ () => $'f\"resultm.unwrap_err / Ok x: {!x}\"' : string\n            TypeScript = \\ () => $'\"resultm.unwrap_err / Ok x: \" + String(!x)' : string\n            Rust = \\ () => rust_debug_message \"resultm.unwrap_err / Ok x: \" x\n            Zig = fun () => $'(std.fmt.allocPrint(spiral_gpa, \"resultm.unwrap_err / Ok x: {any}\", .{ !x }) catch \\\n                \\@panic(\"out of memory\"))' : string\n        }\n        |> failwith\n    | Error x => x\n\n:= ok \\* t. (x : result t _) : option t =\n    ?= x ?|\n    | Ok x => Some x\n    | Error _ => None","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  := unwrap_err \* t u. (x : result t u) : u =
      ?= x ?|
      | Ok x =>
          backend_switch {
              Gleam = \ () =>
                  global "import gleam/string"
                  $'"resultm.unwrap_err / Ok x: " <> string.inspect(!x)' : string
              Lua = \ () => $'"resultm.unwrap_err / Ok x: " .. tostring(!x)' : string
              Fsharp = \ () => $'$"resultm.unwrap_err / Ok x: {!x}"' : string
              Python = \ () => $'f"resultm.unwrap_err / Ok x: {!x}"' : string
              TypeScript = \ () => $'"resultm.unwrap_err / Ok x: " + String(!x)' : string
              Rust = \ () => rust_debug_message "resultm.unwrap_err / Ok x: " x
              Zig = fun () => $'(std.fmt.allocPrint(spiral_gpa, "resultm.unwrap_err / Ok x: {any}", .{ !x }) catch \
                  \@panic("out of memory"))' : string
          }
          |> failwith
      | Error x => x

  := ok \* t. (x : result t _) : option t =
      ?= x ?|
      | Ok x => Some x
      | Error _ => None
  """,
  timeout: 300_000
)
```

## fsharp

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":":= result'_types () =\n    backend_switch {\n        Gleam = \\ () => global \"import gleam/result\"\n    }\n:== result'_switch t u =\n    {\n        Gleam : $'Result(`t, `u)'\n        Lua : result t u\n        Fsharp : $'Result<`t, `u>'\n        Python : result t u\n        Rust : $'Result<`t, `u>'\n        TypeScript : result t u\n        Zig : result t u\n    }\n:! result' t u = $'backend_switch `(result'_switch t u)'\n\n:= result'_union () : bool =\n    backend_switch {\n        Gleam = \\ () => !-\n        Lua = \\ () => !+\n        Fsharp = \\ () => !-\n        Python = \\ () => !+\n        TypeScript = \\ () => !+\n        Cpp = \\ () => !-\n        CppHost = \\ () => !-\n        Pascal = \\ () => !-\n        Cuda = \\ () => !-\n        Rust = \\ () => !-\n        Zig = \\ () => !+\n    }\n\n:= result'_python () : bool =\n    backend_switch {\n        Gleam = \\ () => !-\n        Lua = \\ () => !-\n        Fsharp = \\ () => !-\n        Python = \\ () => !+\n        TypeScript = \\ () => !-\n        Cpp = \\ () => !-\n        CppHost = \\ () => !-\n        Pascal = \\ () => !-\n        Cuda = \\ () => !-\n        Rust = \\ () => !-\n        Zig = \\ () => !-\n    }\n\n:= result'_zig () : bool =\n    backend_switch {\n        Gleam = \\ () => !-\n        Lua = \\ () => !-\n        Fsharp = \\ () => !-\n        Python = \\ () => !-\n        TypeScript = \\ () => !-\n        Cpp = \\ () => !-\n        CppHost = \\ () => !-\n        Pascal = \\ () => !-\n        Cuda = \\ () => !-\n        Rust = \\ () => !-\n        Zig = \\ () => !+\n        Lean = \\ () => !-\n        C = \\ () => !-\n        Wasm = \\ () => !-\n        Bend = \\ () => !-\n    }\n\n:= result'_error_text \\* e. (prefix : string) (e : e) : string =\n    $'(std.fmt.allocPrint(spiral_gpa, \"{s}{any}\", .{ !prefix, !e }) catch @@panic(\"out of memory\"))'\n\n:= unbox \\* t u. (x : result' t u) : result t u =\n    ? result'_union ()\n    ?> $'!x ' : result t u\n    |:\n        := ok x : result t u = Ok x\n        := error x : result t u = Error x\n        := ok = ~~ ok\n        := error = ~~ error\n        backend_switch {\n            Gleam = \\ () =>\n                $'case !x { Ok(x) -> !ok(x) Error(x) -> !error(x) }' : result t u\n\n            Fsharp = \\ () =>\n                ~>\n                    ?: t ?|\n                    | () => $'match !x with Ok () -> !ok () | Error x -> !error x' : result t u\n                    | _ => $'match !x with Ok x -> !ok x | Error x -> !error x' : result t u\n                : result t u\n\n            Rust = \\ () =>\n                ~>\n                    ?: t ?|\n                    | () => $'match !x { Ok(()) => !ok(), Err(e) => !error(e) }' : result t u\n                    | _ => $'match !x { Ok(x) => !ok(x), Err(e) => !error(e) }' : result t u\n                : result t u\n        }\n\n:= box \\* t u. (x : result t u) : result' t u =\n    ? result'_union ()\n    ?> x |> dyn |> \\ x => $'!x ' : result' t u\n    |:\n        ?= x ?|\n        | Ok x =>\n            backend_switch {\n                Gleam = \\ () => $'Ok(!x)' : result' t u\n                Fsharp = \\ () => $'Ok !x ' : result' t u\n                Rust = \\ () => $'Ok::<`t, `u>(!x)' : result' t u\n            }\n        | Error err =>\n            backend_switch {\n                Gleam = \\ () => $'Error(!err)' : result' t u\n                Fsharp = \\ () => $'Error !err ' : result' t u\n                Rust = \\ () => $'Err::<`t, `u>(!err)' : result' t u\n            }\n\n:= map''' \\* t u e. (fn : t -> u) (x : result' t e) : result' u e =\n    x |> unbox |> map fn |> box","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  := result'_types () =
      backend_switch {
          Gleam = \ () => global "import gleam/result"
      }
  :== result'_switch t u =
      {
          Gleam : $'Result(`t, `u)'
          Lua : result t u
          Fsharp : $'Result<`t, `u>'
          Python : result t u
          Rust : $'Result<`t, `u>'
          TypeScript : result t u
          Zig : result t u
      }
  :! result' t u = $'backend_switch `(result'_switch t u)'

  := result'_union () : bool =
      backend_switch {
          Gleam = \ () => !-
          Lua = \ () => !+
          Fsharp = \ () => !-
          Python = \ () => !+
          TypeScript = \ () => !+
          Cpp = \ () => !-
          CppHost = \ () => !-
          Pascal = \ () => !-
          Cuda = \ () => !-
          Rust = \ () => !-
          Zig = \ () => !+
      }

  := result'_python () : bool =
      backend_switch {
          Gleam = \ () => !-
          Lua = \ () => !-
          Fsharp = \ () => !-
          Python = \ () => !+
          TypeScript = \ () => !-
          Cpp = \ () => !-
          CppHost = \ () => !-
          Pascal = \ () => !-
          Cuda = \ () => !-
          Rust = \ () => !-
          Zig = \ () => !-
      }

  := result'_zig () : bool =
      backend_switch {
          Gleam = \ () => !-
          Lua = \ () => !-
          Fsharp = \ () => !-
          Python = \ () => !-
          TypeScript = \ () => !-
          Cpp = \ () => !-
          CppHost = \ () => !-
          Pascal = \ () => !-
          Cuda = \ () => !-
          Rust = \ () => !-
          Zig = \ () => !+
          Lean = \ () => !-
          C = \ () => !-
          Wasm = \ () => !-
          Bend = \ () => !-
      }

  := result'_error_text \* e. (prefix : string) (e : e) : string =
      $'(std.fmt.allocPrint(spiral_gpa, "{s}{any}", .{ !prefix, !e }) catch @@panic("out of memory"))'

  := unbox \* t u. (x : result' t u) : result t u =
      ? result'_union ()
      ?> $'!x ' : result t u
      |:
          := ok x : result t u = Ok x
          := error x : result t u = Error x
          := ok = ~~ ok
          := error = ~~ error
          backend_switch {
              Gleam = \ () =>
                  $'case !x { Ok(x) -> !ok(x) Error(x) -> !error(x) }' : result t u

              Fsharp = \ () =>
                  ~>
                      ?: t ?|
                      | () => $'match !x with Ok () -> !ok () | Error x -> !error x' : result t u
                      | _ => $'match !x with Ok x -> !ok x | Error x -> !error x' : result t u
                  : result t u

              Rust = \ () =>
                  ~>
                      ?: t ?|
                      | () => $'match !x { Ok(()) => !ok(), Err(e) => !error(e) }' : result t u
                      | _ => $'match !x { Ok(x) => !ok(x), Err(e) => !error(e) }' : result t u
                  : result t u
          }

  := box \* t u. (x : result t u) : result' t u =
      ? result'_union ()
      ?> x |> dyn |> \ x => $'!x ' : result' t u
      |:
          ?= x ?|
          | Ok x =>
              backend_switch {
                  Gleam = \ () => $'Ok(!x)' : result' t u
                  Fsharp = \ () => $'Ok !x ' : result' t u
                  Rust = \ () => $'Ok::<`t, `u>(!x)' : result' t u
              }
          | Error err =>
              backend_switch {
                  Gleam = \ () => $'Error(!err)' : result' t u
                  Fsharp = \ () => $'Error !err ' : result' t u
                  Rust = \ () => $'Err::<`t, `u>(!err)' : result' t u
              }

  := map''' \* t u e. (fn : t -> u) (x : result' t e) : result' u e =
      x |> unbox |> map fn |> box
  """,
  timeout: 300_000
)
```

#### map (test)

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":"///- --test --symbol\n///> gleam\n///> lua\n///> cuda\n///> rust\n///> typescript\n\n:= x : _ _ string = Ok 3i32\n:= y : _ i32 _ = Error \"error1\"\n:= x' = x |> box |> unbox\n:= y' = y |> box |> map''' id |> unbox\n(x', y') |> _assert_eq' (x, y)","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  ///- --test --symbol
  ///> gleam
  ///> lua
  ///> cuda
  ///> rust
  ///> typescript

  := x : _ _ string = Ok 3i32
  := y : _ i32 _ = Error "error1"
  := x' = x |> box |> unbox
  := y' = y |> box |> map''' id |> unbox
  (x', y') |> _assert_eq' (x, y)
  """,
  timeout: 300_000
)
```

