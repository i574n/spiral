Spiral.Cells.eval!(
  ~S"""
  := caught \* t. (fn : () -> t) : result t string =
      := ok (x : t) : result t string = Ok x
      := error (e : string) : result t string = Error e
      backend_switch {
          Gleam = \ () =>
              global "@external(erlang, \"SPIRAL_FFI\", \"try_call\")\nfn spiral_try_call(f: fn(Nil) -> a) -> Result(a, String)"
              $'case spiral_try_call(!fn) { Ok(v) -> !ok(v) Error(e) -> !error(e) }' : result t string
      }
  """,
  timeout: 300_000
)
