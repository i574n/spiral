## resultm

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":":= from_option_error error opt =\n    ?= opt ?|\n    | Some x => Ok x\n    | None => Error error\n\n:= from_option opt =\n    opt |> from_option_error \"resultm.from_option / Option does not have a value.\"\n\n:= flatten_option \\* t u. (x : option (result (option t) u)) : result (option t) u =\n    ?= x ?|\n    | Some (Error x) => Error x\n    | Some (Ok (Some x)) => Ok (Some x)\n    | _ => Ok None\n\n:= flatten \\* t u. (x : result (result t u) u) : result t u =\n    ?= x ?|\n    | Ok x => x\n    | Error x => Error x\n\n:= from_try \\* t. (fn : () -> t) (ex_fn : (() -> exn) -> exn) : result t exn =\n    := ok x = x |> Ok : result t exn\n    := error (e : exn) = e |> Error : result t exn\n    backend_switch {\n        Lua = \\ () =>\n            := caught (ex : exn) : option (result t exn) = Some (Error (ex_fn \\ () => ex))\n            try (\\ () => Ok (fn ()) : result t exn) caught |> optionm::value\n        Fsharp = \\ () =>\n            ~~ $'try !fn () |> !ok with ex -> (fun () -> ex) |> !ex_fn |> !error ' : result t exn\n        Python = \\ () =>\n            $'fn = !fn '\n            $'ok = !ok '\n            $'error = !error '\n            $'ex_fn = !ex_fn '\n            $'try: x = ok(fn()) '\n            $'except Exception as ex: x = error(ex_fn(lambda: ex))'\n            $'x' : result t exn\n        TypeScript = \\ () =>\n            $'(() => { try { return !ok(!fn()); } catch (ex) { return !error(!ex_fn(() => ex)); } })()' : result t exn\n        Rust = \\ () =>\n            := caught (ex : exn) : option (result t exn) = Some (Error (ex_fn \\ () => ex))\n            try (\\ () => Ok (fn ()) : result t exn) caught |> optionm::value\n        Zig = \\ () => fn () |> ok\n        C = \\ () => fn () |> ok\n    }","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  := from_option_error error opt =
      ?= opt ?|
      | Some x => Ok x
      | None => Error error

  := from_option opt =
      opt |> from_option_error "resultm.from_option / Option does not have a value."

  := flatten_option \* t u. (x : option (result (option t) u)) : result (option t) u =
      ?= x ?|
      | Some (Error x) => Error x
      | Some (Ok (Some x)) => Ok (Some x)
      | _ => Ok None

  := flatten \* t u. (x : result (result t u) u) : result t u =
      ?= x ?|
      | Ok x => x
      | Error x => Error x

  := from_try \* t. (fn : () -> t) (ex_fn : (() -> exn) -> exn) : result t exn =
      := ok x = x |> Ok : result t exn
      := error (e : exn) = e |> Error : result t exn
      backend_switch {
          Lua = \ () =>
              := caught (ex : exn) : option (result t exn) = Some (Error (ex_fn \ () => ex))
              try (\ () => Ok (fn ()) : result t exn) caught |> optionm::value
          Fsharp = \ () =>
              ~~ $'try !fn () |> !ok with ex -> (fun () -> ex) |> !ex_fn |> !error ' : result t exn
          Python = \ () =>
              $'fn = !fn '
              $'ok = !ok '
              $'error = !error '
              $'ex_fn = !ex_fn '
              $'try: x = ok(fn()) '
              $'except Exception as ex: x = error(ex_fn(lambda: ex))'
              $'x' : result t exn
          TypeScript = \ () =>
              $'(() => { try { return !ok(!fn()); } catch (ex) { return !error(!ex_fn(() => ex)); } })()' : result t exn
          Rust = \ () =>
              := caught (ex : exn) : option (result t exn) = Some (Error (ex_fn \ () => ex))
              try (\ () => Ok (fn ()) : result t exn) caught |> optionm::value
          Zig = \ () => fn () |> ok
          C = \ () => fn () |> ok
      }
  """,
  timeout: 300_000
)
```

#### from_try_keeps_values_and_catches_failures (test)

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":"///- --test --symbol\n///> lua\n///> fsharp\n///> cuda\n///> rust\n///> typescript\n\n:= settled (r : result i32 exn) : i32 =\n    ?= r ?|\n    | Ok x => x\n    | Error _ => 0i32\n:= ~n = 5i32\n(from_try (\\ () => n) eval |> settled, from_try (\\ () => failwith \"boom\" : i32) eval |> settled)\n|> _assert_eq (5i32, 0i32)","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  ///- --test --symbol
  ///> lua
  ///> fsharp
  ///> cuda
  ///> rust
  ///> typescript

  := settled (r : result i32 exn) : i32 =
      ?= r ?|
      | Ok x => x
      | Error _ => 0i32
  := ~n = 5i32
  (from_try (\ () => n) eval |> settled, from_try (\ () => failwith "boom" : i32) eval |> settled)
  |> _assert_eq (5i32, 0i32)
  """,
  timeout: 300_000
)
```

