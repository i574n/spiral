<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":":! anyhow_result t =\n    `(\n        rust::rust_type\n            `($'anyhow_Result<`t>')\n            `($'anyhow::Result<`t>')\n            \"type anyhow_Result<'T> = class end\"\n    )\n\n:! anyhow_error =\n    `(\n        rust::rust_type\n            `($'anyhow_Error')\n            `($'anyhow::Error')\n            \"type anyhow_Error = class end\"\n    )\n\n:= anyhow_error error : anyhow_error =\n    backend_switch {\n        Rust = \\ () => !\\\\(error, $'\"anyhow::anyhow\\!(\\\\\\\"{}\\\\\\\", $0)\"') : anyhow_error\n    }\n\n:= try' \\* t u. (x : result' t u) : t =\n    := is_unit =\n        ~>\n            ?: t ?|\n            | () => !+\n            | _ => !-\n    ? result'_union () ?>\n        ?= unbox x ?|\n        | Ok x => x\n        | Error e =>\n            := msg : string =\n                ? result'_zig ()\n                ?> result'_error_text \"resultm.try' / e: \" e\n                |? result'_python ()\n                ?> $'f\"resultm.try\\' / e: {!e}\"'\n                |: $'\"resultm.try\\' / e: \" .. tostring(!e)'\n            failwith msg\n    |? is_unit\n    ?> (!\\\\(x, $'\"true; $0?\"') : bool) |> \\ _ => $''\n    |: !\\\\(x, $'\"$0?\"')\n\n:= to_try \\* t u. (x : result' t u) : rust::try t =\n    !\\\\(x, $'\"$0\"')\n\n:= unwrap' \\* t u. (x : result' t u) : t =\n    ? result'_union () ?>\n        ?= unbox x ?|\n        | Ok x => x\n        | Error e =>\n            := msg : string =\n                ? result'_zig ()\n                ?> result'_error_text \"resultm.unwrap' / e: \" e\n                |? result'_python ()\n                ?> $'f\"resultm.unwrap\\' / e: {!e}\"'\n                |: $'\"resultm.unwrap\\' / e: \" .. tostring(!e)'\n            failwith msg\n    |: !\\\\(x, $'\"$0.unwrap()\"')\n\n:= unwrap'' \\* t u. (x : result' t u) : t =\n    ? result'_union () ?>\n        ?= unbox x ?|\n        | Ok x => x\n        | Error e =>\n            := msg : string =\n                ? result'_zig ()\n                ?> result'_error_text \"resultm.unwrap'' / e: \" e\n                |? result'_python ()\n                ?> $'f\"resultm.unwrap\\'\\' / e: {!e}\"'\n                |: $'\"resultm.unwrap\\'\\' / e: \" .. tostring(!e)'\n            failwith msg\n    |:\n        run_target \\|\n            | Rust => \\ () => x |> unwrap'\n            | _ => \\ () => $'match !x with Ok x -> x | Error e -> failwith $\"resultm.unwrap\\'\\' / e: {e}\"'\n\n:= unwrap_err' \\* t u. (x : result' t u) : u =\n    ? result'_union () ?>\n        ?= unbox x ?|\n        | Ok x =>\n            := msg : string =\n                ? result'_zig ()\n                ?> result'_error_text \"resultm.unwrap_err' / x: \" x\n                |? result'_python ()\n                ?> $'f\"resultm.unwrap_err\\' / x: {!x}\"'\n                |: $'\"resultm.unwrap_err\\' / x: \" .. tostring(!x)'\n            failwith msg\n        | Error x => x\n    |: $'match !x with Ok x -> failwith $\"resultm.unwrap_err\\' / x: %A{x}\" | Error x -> x'\n\n:= unbox' \\* t u. (x : result' t u) : result t u =\n    unbox x\n\n:= map' \\* t e u. (fn : t -> u) (source : result' t e) : result' u e =\n    ? result'_union ()\n    ?> source |> unbox |> map fn |> box\n    |:\n        (!\\\\(source, $'\"true; let _result_map_ = $0.map(|x| { //\"') : bool) |> ignore\n        (!\\\\(fn !\\($'\"x\"'), $'\"true; $0 })\"') : bool) |> ignore\n        !\\($'\"_result_map_\"')\n\n:= map'' \\* t e u. (fn : t -> u) (source : result' t e) : result' u e =\n    ? result'_union ()\n    ?> source |> unbox |> map fn |> box\n    |:\n        := fn = ~~ fn\n        := source = ~~ source\n        !\\($'\"!source.map(|x| !fn(x))\"')\n\n:= map_error' \\* t e u. (fn : e -> u) (source : result' t e) : result' t u =\n    ? is_rust () ?>\n        := fn = ~~ fn\n        !\\\\((source, fn), $'\"$0.map_err(|x| $1(x))\"')\n    |: source |> unbox |> map_error fn |> box\n\n:= map_error'' \\* t e u. (fn : e -> u) (source : result' t e) : result' t u =\n    ? result'_union ()\n    ?> source |> unbox |> map_error fn |> box\n    |:\n        (!\\\\(source, $'\"true; let _result_map_error__ = $0.map_err(|x| { //\"') : bool) |> ignore\n        (!\\\\(fn !\\($'\"x\"'), $'\"true; $0 })\"') : bool) |> ignore\n        !\\($'\"_result_map_error__\"')\n\n:= map_error''' \\* t e u. (fn : e -> u) (source : result' t e) : result' t u =\n    ? result'_union ()\n    ?> source |> unbox |> map_error fn |> box\n    |: !\\\\((source, fn), $'\"$0.map_err(|x| $1(x))\"')\n\n:= option_ok_or \\* t e. (e : e) (source : optionm'::option' t) : result' t e =\n    ? result'_union ()\n    ?> source |> optionm'::unbox |> from_option_error e |> box\n    |: !\\\\(source, $'\"$0.ok_or(!e)\"')\n\n:= unwrap_or_else \\* t e u. (fn : e -> u) (source : result' t e) : u =\n    (!\\\\(source, $'\"true; let _result_unwrap_or_else = $0.unwrap_or_else(|x| { //\"') : bool) |> ignore\n    (!\\\\(fn !\\($'\"x\"'), $'\"true; $0 })\"') : bool) |> ignore\n    !\\($'\"_result_unwrap_or_else\"')\n\n:= map_or_else \\* t e u v. (fn : e -> v) (fn2 : u -> v) (source : result' t e) : v =\n    (!\\\\(source, $'\"true; let _result_map_or_else = $0.map_or_else(|x| { //\"') : bool) |> ignore\n    (!\\\\(fn !\\($'\"x\"'), $'\"true; $0 }, |x| { //\"') : bool) |> ignore\n    (!\\\\(fn2 !\\($'\"x\"'), $'\"true; $0 })\"') : bool) |> ignore\n    !\\($'\"_result_map_or_else\"')\n\n:= as_ref \\* t e. (source : result' t e) : result' (rust::ref t) (rust::ref e) =\n    !\\($'\"!source.as_ref()\"')\n\n:= as_ref' \\* t e. (source : rust::ref (result' t e)) : result' (rust::ref t) (rust::ref e) =\n    !\\($'\"!source.as_ref()\"')\n\n:= unwrap_or' \\* t u. (default : t) (x : result' t u) : t =\n    ? result'_union () ?>\n        ?= unbox x ?|\n        | Ok x => x\n        | Error _ => default\n    |: !\\\\((x, default), $'\"$0.unwrap_or($1)\"')\n\n:= expect \\* t u. (error : rust::ref string) (x : result' t u) : t =\n    !\\($'\"!x.expect(&!error)\"')\n\n:= is_err \\* t u. (x : result' t u) : bool =\n    ? is_rust ()\n    ?> !\\\\(x, $'\"$0.is_err()\"')\n    |:\n        ?= unbox x ?|\n        | Ok _ => !-\n        | Error _ => !+\n\n:= ok' \\* t. (x : result' t _) : optionm'::option' t =\n    ? is_rust ()\n    ?> !\\\\(x, $'\"$0.ok()\"')\n    |: x |> unbox |> ok |> optionm'::box\n\n:= err \\* t u. (x : u) : result' t u =\n    ? is_rust ()\n    ?> !\\\\(x, $'\"Err($0)\"')\n    |: (Error x : result t u) |> box\n\n:= ok'' \\* t u. (x : t) : result' t u =\n    ? is_rust ()\n    ?> !\\\\(x, $'\"Ok($0)\"')\n    |: (Ok x : result t u) |> box\n\n:= transpose \\* t u. (x : optionm'::option' (result' t u)) : result' (optionm'::option' t) u =\n    ? result'_union () ?>\n        := r : result (optionm'::option' t) u =\n            ?= optionm'::unbox x ?|\n            | Some x =>\n                ?= unbox x ?|\n                | Ok x => Ok (optionm'::some' x)\n                | Error e => Error e\n            | None => Ok (optionm'::none' ())\n        box r\n    |: !\\\\(x, $'\"$0.transpose()\"')\n\n:= rc_try_unwrap \\* t. (x : rust::rc t) : result' t (rust::rc t) =\n    !\\\\(x, $'\"std::rc::Rc::try_unwrap($0)\"')","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  :! anyhow_result t =
      `(
          rust::rust_type
              `($'anyhow_Result<`t>')
              `($'anyhow::Result<`t>')
              "type anyhow_Result<'T> = class end"
      )

  :! anyhow_error =
      `(
          rust::rust_type
              `($'anyhow_Error')
              `($'anyhow::Error')
              "type anyhow_Error = class end"
      )

  := anyhow_error error : anyhow_error =
      backend_switch {
          Rust = \ () => !\\(error, $'"anyhow::anyhow\!(\\\"{}\\\", $0)"') : anyhow_error
      }

  := try' \* t u. (x : result' t u) : t =
      := is_unit =
          ~>
              ?: t ?|
              | () => !+
              | _ => !-
      ? result'_union () ?>
          ?= unbox x ?|
          | Ok x => x
          | Error e =>
              := msg : string =
                  ? result'_zig ()
                  ?> result'_error_text "resultm.try' / e: " e
                  |? result'_python ()
                  ?> $'f"resultm.try\' / e: {!e}"'
                  |: $'"resultm.try\' / e: " .. tostring(!e)'
              failwith msg
      |? is_unit
      ?> (!\\(x, $'"true; $0?"') : bool) |> \ _ => $''
      |: !\\(x, $'"$0?"')

  := to_try \* t u. (x : result' t u) : rust::try t =
      !\\(x, $'"$0"')

  := unwrap' \* t u. (x : result' t u) : t =
      ? result'_union () ?>
          ?= unbox x ?|
          | Ok x => x
          | Error e =>
              := msg : string =
                  ? result'_zig ()
                  ?> result'_error_text "resultm.unwrap' / e: " e
                  |? result'_python ()
                  ?> $'f"resultm.unwrap\' / e: {!e}"'
                  |: $'"resultm.unwrap\' / e: " .. tostring(!e)'
              failwith msg
      |: !\\(x, $'"$0.unwrap()"')

  := unwrap'' \* t u. (x : result' t u) : t =
      ? result'_union () ?>
          ?= unbox x ?|
          | Ok x => x
          | Error e =>
              := msg : string =
                  ? result'_zig ()
                  ?> result'_error_text "resultm.unwrap'' / e: " e
                  |? result'_python ()
                  ?> $'f"resultm.unwrap\'\' / e: {!e}"'
                  |: $'"resultm.unwrap\'\' / e: " .. tostring(!e)'
              failwith msg
      |:
          run_target \|
              | Rust => \ () => x |> unwrap'
              | _ => \ () => $'match !x with Ok x -> x | Error e -> failwith $"resultm.unwrap\'\' / e: {e}"'

  := unwrap_err' \* t u. (x : result' t u) : u =
      ? result'_union () ?>
          ?= unbox x ?|
          | Ok x =>
              := msg : string =
                  ? result'_zig ()
                  ?> result'_error_text "resultm.unwrap_err' / x: " x
                  |? result'_python ()
                  ?> $'f"resultm.unwrap_err\' / x: {!x}"'
                  |: $'"resultm.unwrap_err\' / x: " .. tostring(!x)'
              failwith msg
          | Error x => x
      |: $'match !x with Ok x -> failwith $"resultm.unwrap_err\' / x: %A{x}" | Error x -> x'

  := unbox' \* t u. (x : result' t u) : result t u =
      unbox x

  := map' \* t e u. (fn : t -> u) (source : result' t e) : result' u e =
      ? result'_union ()
      ?> source |> unbox |> map fn |> box
      |:
          (!\\(source, $'"true; let _result_map_ = $0.map(|x| { //"') : bool) |> ignore
          (!\\(fn !\($'"x"'), $'"true; $0 })"') : bool) |> ignore
          !\($'"_result_map_"')

  := map'' \* t e u. (fn : t -> u) (source : result' t e) : result' u e =
      ? result'_union ()
      ?> source |> unbox |> map fn |> box
      |:
          := fn = ~~ fn
          := source = ~~ source
          !\($'"!source.map(|x| !fn(x))"')

  := map_error' \* t e u. (fn : e -> u) (source : result' t e) : result' t u =
      ? is_rust () ?>
          := fn = ~~ fn
          !\\((source, fn), $'"$0.map_err(|x| $1(x))"')
      |: source |> unbox |> map_error fn |> box

  := map_error'' \* t e u. (fn : e -> u) (source : result' t e) : result' t u =
      ? result'_union ()
      ?> source |> unbox |> map_error fn |> box
      |:
          (!\\(source, $'"true; let _result_map_error__ = $0.map_err(|x| { //"') : bool) |> ignore
          (!\\(fn !\($'"x"'), $'"true; $0 })"') : bool) |> ignore
          !\($'"_result_map_error__"')

  := map_error''' \* t e u. (fn : e -> u) (source : result' t e) : result' t u =
      ? result'_union ()
      ?> source |> unbox |> map_error fn |> box
      |: !\\((source, fn), $'"$0.map_err(|x| $1(x))"')

  := option_ok_or \* t e. (e : e) (source : optionm'::option' t) : result' t e =
      ? result'_union ()
      ?> source |> optionm'::unbox |> from_option_error e |> box
      |: !\\(source, $'"$0.ok_or(!e)"')

  := unwrap_or_else \* t e u. (fn : e -> u) (source : result' t e) : u =
      (!\\(source, $'"true; let _result_unwrap_or_else = $0.unwrap_or_else(|x| { //"') : bool) |> ignore
      (!\\(fn !\($'"x"'), $'"true; $0 })"') : bool) |> ignore
      !\($'"_result_unwrap_or_else"')

  := map_or_else \* t e u v. (fn : e -> v) (fn2 : u -> v) (source : result' t e) : v =
      (!\\(source, $'"true; let _result_map_or_else = $0.map_or_else(|x| { //"') : bool) |> ignore
      (!\\(fn !\($'"x"'), $'"true; $0 }, |x| { //"') : bool) |> ignore
      (!\\(fn2 !\($'"x"'), $'"true; $0 })"') : bool) |> ignore
      !\($'"_result_map_or_else"')

  := as_ref \* t e. (source : result' t e) : result' (rust::ref t) (rust::ref e) =
      !\($'"!source.as_ref()"')

  := as_ref' \* t e. (source : rust::ref (result' t e)) : result' (rust::ref t) (rust::ref e) =
      !\($'"!source.as_ref()"')

  := unwrap_or' \* t u. (default : t) (x : result' t u) : t =
      ? result'_union () ?>
          ?= unbox x ?|
          | Ok x => x
          | Error _ => default
      |: !\\((x, default), $'"$0.unwrap_or($1)"')

  := expect \* t u. (error : rust::ref string) (x : result' t u) : t =
      !\($'"!x.expect(&!error)"')

  := is_err \* t u. (x : result' t u) : bool =
      ? is_rust ()
      ?> !\\(x, $'"$0.is_err()"')
      |:
          ?= unbox x ?|
          | Ok _ => !-
          | Error _ => !+

  := ok' \* t. (x : result' t _) : optionm'::option' t =
      ? is_rust ()
      ?> !\\(x, $'"$0.ok()"')
      |: x |> unbox |> ok |> optionm'::box

  := err \* t u. (x : u) : result' t u =
      ? is_rust ()
      ?> !\\(x, $'"Err($0)"')
      |: (Error x : result t u) |> box

  := ok'' \* t u. (x : t) : result' t u =
      ? is_rust ()
      ?> !\\(x, $'"Ok($0)"')
      |: (Ok x : result t u) |> box

  := transpose \* t u. (x : optionm'::option' (result' t u)) : result' (optionm'::option' t) u =
      ? result'_union () ?>
          := r : result (optionm'::option' t) u =
              ?= optionm'::unbox x ?|
              | Some x =>
                  ?= unbox x ?|
                  | Ok x => Ok (optionm'::some' x)
                  | Error e => Error e
              | None => Ok (optionm'::none' ())
          box r
      |: !\\(x, $'"$0.transpose()"')

  := rc_try_unwrap \* t. (x : rust::rc t) : result' t (rust::rc t) =
      !\\(x, $'"std::rc::Rc::try_unwrap($0)"')
  """,
  timeout: 300_000
)
```

#### rc_try_unwrap (test)

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":"///- --test --symbol\n///> rust\n\nrust::new_rc !+\n|> rc_try_unwrap\n|> unbox\n|> _assert_eq (Ok !+)","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  ///- --test --symbol
  ///> rust

  rust::new_rc !+
  |> rc_try_unwrap
  |> unbox
  |> _assert_eq (Ok !+)
  """,
  timeout: 300_000
)
```

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":":= bind \\* a b e. (f : a -> result b e) (r : result a e) : result b e =\n    ?= r ?|\n    | Ok x => f x\n    | Error e => Error e\n\n:= resultm_halved (n : i32) : result i32 string = ? n % 2i32 = 0i32 ?> Ok (n / 2i32) |: Error \"odd\"","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  := bind \* a b e. (f : a -> result b e) (r : result a e) : result b e =
      ?= r ?|
      | Ok x => f x
      | Error e => Error e

  := resultm_halved (n : i32) : result i32 string = ? n % 2i32 = 0i32 ?> Ok (n / 2i32) |: Error "odd"
  """,
  timeout: 300_000
)
```

#### bind_chains_until_the_first_error (test)

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":"///- --test --symbol\n///> rust\n///> gleam\n\n:= ~n = 8i32\n(Ok n |> bind resultm_halved |> bind resultm_halved, Ok 6i32 |> bind resultm_halved |> bind resultm_halved)\n|> _assert_eq (Ok 2i32, Error \"odd\")","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  ///- --test --symbol
  ///> rust
  ///> gleam

  := ~n = 8i32
  (Ok n |> bind resultm_halved |> bind resultm_halved, Ok 6i32 |> bind resultm_halved |> bind resultm_halved)
  |> _assert_eq (Ok 2i32, Error "odd")
  """,
  timeout: 300_000
)
```
