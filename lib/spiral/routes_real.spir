/// # routes
///- --real

:< real_core

:= (++) a b = !!!!StaticStringConcat(a, b)

:= ^ colon_count (s : string) (i : i32) (n : i32) (acc : i32) : i32 =
    ? i >= n ?> acc
    |? !!!!StringIndex(s, i) = ':' ?> colon_count s (i + 1i32) n (acc + 1i32)
    |: colon_count s (i + 1i32) n acc

:= ^ has_param (s : string) (needle : string) (i : i32) (n : i32) (m : i32) : bool =
    ? i + m > n ?> !-
    |? !!!!StringSlice(s, i, i + m - 1i32) = needle ?>
        ? i + m = n ?> !+
        |? !!!!StringIndex(s, i + m) = '/' ?> !+
        |: has_param s needle (i + 1i32) n m
    |: has_param s needle (i + 1i32) n m

:= route path = \* params. =>
    := n = !!!!StringLength(`i32, path)
    := fields, all_present =
        record_type_fold
            \ (fields, all_present) key =>
                \* value. =>
                    := needle = ":" ++ !!!!SymbolToString(key)
                    fields + 1i32, all_present && has_param path needle 0i32 n !!!!StringLength(`i32, needle)
            (0i32, !+)
            `params
    ? all_present && fields = colon_count path 0i32 n 0i32 ?> path
    |: error_type ("the route " ++ path ++ " does not name exactly the handler's parameter fields")

/// ### route
