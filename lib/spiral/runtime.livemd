### split_args

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"let split_args (args : string) : result (array_base string) _ =\n    open parsing\n    inl esc = [ '\\\\'; '`' ]\n    inl quotes = [ '\"' ]\n    inl special = esc ++ quotes\n    // An escape and the char after it, as written: a slice of the input (formatting the two chars into a string costs\n    // several allocations on Rust).\n    inl p_esc_pair (p : parser _) : parser string = fun t, i, s =>\n        match p (t, i, s) with\n        | Ok (_, i', s') => Ok (t |> slice i i', i', s')\n        | Error e => Error e\n    inl p_esc_char c = p_char c >>. any_char () |> p_esc_pair\n    inl p_word = special |> none_of |>> fun c => fun () => c () |> sm'.obj_to_string\n    inl p_plain = special ++ [ ' ' ] |> many1_none_of\n    inl p_esc = esc |> listm.map p_esc_char |> choice\n    inl p_chunk = special |> many1_none_of\n    inl p_quoted = (p_chunk <|> p_esc) |> many_strings\n    inl p_quoted_all = p_quoted |> between (p_char '\"') (p_char '\"')\n    inl p_esc_root = p_esc >>% \"\" >>. p_word |> many |>> fun s => fun () => s () |> sm'.concat_list \"\"\n    inl p_esc_quote_delim =\n        esc\n        |> listm.map fun c => p_char c >>. p_char '\"' >>% '\"'\n        |> choice\n    inl p_esc_char_noquote c = p_char c >>. none_of [ '\"' ] |> p_esc_pair\n    inl p_esc_noquote = esc |> listm.map p_esc_char_noquote |> choice\n    inl p_quoted_esc = (p_chunk <|> p_esc_noquote) |> many_strings\n    inl p_quoted_all_esc = p_quoted_esc |> between p_esc_quote_delim p_esc_quote_delim\n    inl ensure_progress p : parser _ = fun input, i, s =>\n        match p (input, i, s) with\n        | Ok (r, i', s') when i' = i =>\n            fail (fun _ => \"runtime.split_args / segment zero-length success\") i s\n        | other => other\n    inl p_segment = ensure_progress (p_quoted_all_esc <|> p_quoted_all <|> p_plain <|> p_esc_root)\n    inl p_content = p_segment |> many1_strings\n    inl p_args = spaces1 () |> sep_by p_content\n    args\n    |> run_parser p_args\n    |> resultm.map (fst >> fun (args : list string) =>\n        if is_rust () then\n            // one Vec of the right size (`listm'.box >> listm'.to_array'` fills and then copies it twice)\n            inl n = (0i32, args) ||> listm.fold fun n _ => n + 1\n            inl acc : array_base string = $'Rc::new(RefCell::new(Vec::with_capacity(!n as usize)))'\n            inl _ : i32 = (0i32, args) ||> listm.fold fun n (x : string) =>\n                $'!acc.borrow_mut().push(!x)' : ()\n                n + 1\n            acc\n        else args |> listm'.box |> listm'.to_array'\n    )\n    |> resultm.map_error eval","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  let split_args (args : string) : result (array_base string) _ =
      open parsing
      inl esc = [ '\\'; '`' ]
      inl quotes = [ '"' ]
      inl special = esc ++ quotes
      // An escape and the char after it, as written: a slice of the input (formatting the two chars into a string costs
      // several allocations on Rust).
      inl p_esc_pair (p : parser _) : parser string = fun t, i, s =>
          match p (t, i, s) with
          | Ok (_, i', s') => Ok (t |> slice i i', i', s')
          | Error e => Error e
      inl p_esc_char c = p_char c >>. any_char () |> p_esc_pair
      inl p_word = special |> none_of |>> fun c => fun () => c () |> sm'.obj_to_string
      inl p_plain = special ++ [ ' ' ] |> many1_none_of
      inl p_esc = esc |> listm.map p_esc_char |> choice
      inl p_chunk = special |> many1_none_of
      inl p_quoted = (p_chunk <|> p_esc) |> many_strings
      inl p_quoted_all = p_quoted |> between (p_char '"') (p_char '"')
      inl p_esc_root = p_esc >>% "" >>. p_word |> many |>> fun s => fun () => s () |> sm'.concat_list ""
      inl p_esc_quote_delim =
          esc
          |> listm.map fun c => p_char c >>. p_char '"' >>% '"'
          |> choice
      inl p_esc_char_noquote c = p_char c >>. none_of [ '"' ] |> p_esc_pair
      inl p_esc_noquote = esc |> listm.map p_esc_char_noquote |> choice
      inl p_quoted_esc = (p_chunk <|> p_esc_noquote) |> many_strings
      inl p_quoted_all_esc = p_quoted_esc |> between p_esc_quote_delim p_esc_quote_delim
      inl ensure_progress p : parser _ = fun input, i, s =>
          match p (input, i, s) with
          | Ok (r, i', s') when i' = i =>
              fail (fun _ => "runtime.split_args / segment zero-length success") i s
          | other => other
      inl p_segment = ensure_progress (p_quoted_all_esc <|> p_quoted_all <|> p_plain <|> p_esc_root)
      inl p_content = p_segment |> many1_strings
      inl p_args = spaces1 () |> sep_by p_content
      args
      |> run_parser p_args
      |> resultm.map (fst >> fun (args : list string) =>
          if is_rust () then
              // one Vec of the right size (`listm'.box >> listm'.to_array'` fills and then copies it twice)
              inl n = (0i32, args) ||> listm.fold fun n _ => n + 1
              inl acc : array_base string = $'Rc::new(RefCell::new(Vec::with_capacity(!n as usize)))'
              inl _ : i32 = (0i32, args) ||> listm.fold fun n (x : string) =>
                  $'!acc.borrow_mut().push(!x)' : ()
                  n + 1
              acc
          else args |> listm'.box |> listm'.to_array'
      )
      |> resultm.map_error eval
  """,
  timeout: 300_000
)
```

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"///- --test\n///> gleam\n///> fsharp\n///> cuda\n///> rust\n///> typescript\n\nDebug |> set_trace_level\n[\n    \"a b c\",\n    ;[ \"a\"; \"b\"; \"c\" ]\n\n    \"e f \\\"g h\\\" i\",\n    ;[ \"e\"; \"f\"; \"g h\"; \"i\" ]\n\n    \"\\\"j k\\\" \\\"l\\\" \\\"m\\\"\",\n    ;[ \"j k\"; \"l\"; \"m\" ]\n\n    \"s -t \\\"u \\`\\\"v\\`\\\" w\\\"\",\n    ;[ \"s\"; \"-t\"; \"u \\`\\\"v\\`\\\" w\" ]\n\n    \"n -o \\\"p \\\\\\\"q\\\\\\\" r\\\"\",\n    ;[ \"n\"; \"-o\"; \"p \\\\\\\"q\\\\\\\" r\" ]\n\n    \"r -s \\\"t \\\\\\\"u\\\\\\\"\\\"\",\n    ;[ \"r\"; \"-s\"; \"t \\\\\\\"u\\\\\\\"\" ]\n\n    $'\"x -y \\\\\\\"$z -a \\'(b=\\\\\\\\\\\\\"c-id=)[a-fA-F0-9]{8}\\', { \\`$_[1] + \\`$d++ }\\\\\\\"\"',\n    ;[ \"x\"; \"-y\"; \"$z -a '(b=\\\\\\\"c-id=)[a-fA-F0-9]{8}', { `$_[1] + `$d++ }\" ]\n\n    \"e -f \\\"$g -h '(i=`\\\"j-id=)[a-fA-F0-9]{8}', { `$_[1] + `$k++ }\\\"\",\n    ;[ \"e\"; \"-f\"; \"$g -h '(i=`\\\"j-id=)[a-fA-F0-9]{8}', { `$_[1] + `$k++ }\" ]\n\n    $'\"--l \\\\\\\\\\\\\"\\'\\'\\' m \\'\\'\\'\\\\\\\\\\\\\" \"',\n    ;[ \"--l\"; \"''' m '''\" ]\n\n    $'\"n --o --p q --r \\\\\\\"s:/t u/v.w\\\\\\\" --x \\\\\\\"y:/z.a\\\\\\\" --b c.d \\\\\\\"\\\\\\\\e{f-g}\\\\\\\" h.i \\\\\\\"j (k)\\\\\\\"\"',\n    ;[\n        \"n\"; \"--o\"; \"--p\"; \"q\"; \"--r\"; \"s:/t u/v.w\"; \"--x\"; \"y:/z.a\"; \"--b\"; \"c.d\"; \"\\\\e{f-g}\"; \"h.i\"; \"j (k)\"\n    ]\n\n    $'\"l \\\\\\\"m n:\\\\\\\\o.p\\\\\\\"\"',\n    ;[ \"l\"; \"m n:\\\\o.p\" ]\n\n    $'\"--r s \\\\\\\\\\\\\"\\' t \\'\\\\\\\\\\\\\" u v w \\\\\\\\\\\\\"x y\\\\\\\\\\\\\"\"',\n    ;[ \"--r\"; \"s\"; \"' t '\"; \"u\"; \"v\"; \"w\"; \"x y\" ]\n]\n|> _assert_fn split_args","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  ///- --test
  ///> gleam
  ///> fsharp
  ///> cuda
  ///> rust
  ///> typescript

  Debug |> set_trace_level
  [
      "a b c",
      ;[ "a"; "b"; "c" ]

      "e f \"g h\" i",
      ;[ "e"; "f"; "g h"; "i" ]

      "\"j k\" \"l\" \"m\"",
      ;[ "j k"; "l"; "m" ]

      "s -t \"u \`\"v\`\" w\"",
      ;[ "s"; "-t"; "u \`\"v\`\" w" ]

      "n -o \"p \\\"q\\\" r\"",
      ;[ "n"; "-o"; "p \\\"q\\\" r" ]

      "r -s \"t \\\"u\\\"\"",
      ;[ "r"; "-s"; "t \\\"u\\\"" ]

      $'"x -y \\\"$z -a \'(b=\\\\\\"c-id=)[a-fA-F0-9]{8}\', { \`$_[1] + \`$d++ }\\\""',
      ;[ "x"; "-y"; "$z -a '(b=\\\"c-id=)[a-fA-F0-9]{8}', { `$_[1] + `$d++ }" ]

      "e -f \"$g -h '(i=`\"j-id=)[a-fA-F0-9]{8}', { `$_[1] + `$k++ }\"",
      ;[ "e"; "-f"; "$g -h '(i=`\"j-id=)[a-fA-F0-9]{8}', { `$_[1] + `$k++ }" ]

      $'"--l \\\\\\"\'\'\' m \'\'\'\\\\\\" "',
      ;[ "--l"; "''' m '''" ]

      $'"n --o --p q --r \\\"s:/t u/v.w\\\" --x \\\"y:/z.a\\\" --b c.d \\\"\\\\e{f-g}\\\" h.i \\\"j (k)\\\""',
      ;[
          "n"; "--o"; "--p"; "q"; "--r"; "s:/t u/v.w"; "--x"; "y:/z.a"; "--b"; "c.d"; "\\e{f-g}"; "h.i"; "j (k)"
      ]

      $'"l \\\"m n:\\\\o.p\\\""',
      ;[ "l"; "m n:\\o.p" ]

      $'"--r s \\\\\\"\' t \'\\\\\\" u v w \\\\\\"x y\\\\\\""',
      ;[ "--r"; "s"; "' t '"; "u"; "v"; "w"; "x y" ]
  ]
  |> _assert_fn split_args
  """,
  timeout: 300_000
)
```

### split_command

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"let split_command (command : string) : result (string * option string) _ =\n    open parsing\n    inl quotes = [ '\"'; '\\'' ]\n    inl p_quoted_char = quotes |> listm.map p_char |> choice\n    inl normalize = fun s => fun () => s () |> sm'.replace \"\\\\\" \"/\"\n    inl p_quoted = quotes |> none_of |> many_chars |> between p_quoted_char p_quoted_char |>> normalize\n    inl p_unquoted = quotes ++ [ ' ' ] |> none_of |> many1_chars |>> normalize\n    inl p_path = p_quoted <|> p_unquoted <|> (eof () >>% \"\")\n    inl p_args = spaces1 () >>. rest_of_line ()\n    inl p_command = p_path .>>. (p_args |> opt)\n    command\n    |> run_parser p_command\n    |> resultm.map (fst >> fun path, args => path (), args () |> optionm.map eval)\n    |> resultm.map_error eval","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  let split_command (command : string) : result (string * option string) _ =
      open parsing
      inl quotes = [ '"'; '\'' ]
      inl p_quoted_char = quotes |> listm.map p_char |> choice
      inl normalize = fun s => fun () => s () |> sm'.replace "\\" "/"
      inl p_quoted = quotes |> none_of |> many_chars |> between p_quoted_char p_quoted_char |>> normalize
      inl p_unquoted = quotes ++ [ ' ' ] |> none_of |> many1_chars |>> normalize
      inl p_path = p_quoted <|> p_unquoted <|> (eof () >>% "")
      inl p_args = spaces1 () >>. rest_of_line ()
      inl p_command = p_path .>>. (p_args |> opt)
      command
      |> run_parser p_command
      |> resultm.map (fst >> fun path, args => path (), args () |> optionm.map eval)
      |> resultm.map_error eval
  """,
  timeout: 300_000
)
```

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"///- --test\n///> gleam\n///> fsharp\n///> cuda\n///> rust\n///> typescript\n\nDebug |> set_trace_level\n[\n    \"\",\n    (\"\", None)\n\n    \"/a/b/c\",\n    (\"/a/b/c\", None)\n\n    \"d e.f\",\n    (\"d\", \"e.f\" |> Some)\n\n    \"..\\\\..\\\\g.h i.j k.l\",\n    (\"../../g.h\", \"i.j k.l\" |> Some)\n\n    \"m:\\\\n\\\\o.p \\\"q.r s.t\\\"\",\n    (\"m:/n/o.p\", \"\\\"q.r s.t\\\"\" |> Some)\n\n    \"\\\"..\\\\..\\\\u v\\\\w.x\\\" \\\"y z.a\\\" b.c\",\n    (\"../../u v/w.x\", \"\\\"y z.a\\\" b.c\" |> Some)\n\n    \"\\\"..\\\\..\\\\d e.f\\\" -g \\\\\\\\\\\"h i\\\\\\\\\\\"\",\n    (\"../../d e.f\", \"-g \\\\\\\\\\\"h i\\\\\\\\\\\"\" |> Some)\n\n    \"..\\\\..\\\\j k.l -m \\\\\\\\\\\"n o\\\\\\\\\\\"\",\n    (\"../../j\", \"k.l -m \\\\\\\\\\\"n o\\\\\\\\\\\"\" |> Some)\n]\n|> _assert_fn split_command","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  ///- --test
  ///> gleam
  ///> fsharp
  ///> cuda
  ///> rust
  ///> typescript

  Debug |> set_trace_level
  [
      "",
      ("", None)

      "/a/b/c",
      ("/a/b/c", None)

      "d e.f",
      ("d", "e.f" |> Some)

      "..\\..\\g.h i.j k.l",
      ("../../g.h", "i.j k.l" |> Some)

      "m:\\n\\o.p \"q.r s.t\"",
      ("m:/n/o.p", "\"q.r s.t\"" |> Some)

      "\"..\\..\\u v\\w.x\" \"y z.a\" b.c",
      ("../../u v/w.x", "\"y z.a\" b.c" |> Some)

      "\"..\\..\\d e.f\" -g \\\\\"h i\\\\\"",
      ("../../d e.f", "-g \\\\\"h i\\\\\"" |> Some)

      "..\\..\\j k.l -m \\\\\"n o\\\\\"",
      ("../../j", "k.l -m \\\\\"n o\\\\\"" |> Some)
  ]
  |> _assert_fn split_command
  """,
  timeout: 300_000
)
```

