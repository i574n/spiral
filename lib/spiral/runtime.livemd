### execute_with_options

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"let execute_with_options (options : execution_options) : i32 * string =\n    backend_switch {\n        Fsharp = fun () => execute_with_options_fsharp options\n        Rust = fun () => execute_with_options_rust options\n    }","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  let execute_with_options (options : execution_options) : i32 * string =
      backend_switch {
          Fsharp = fun () => execute_with_options_fsharp options
          Rust = fun () => execute_with_options_rust options
      }
  """,
  timeout: 300_000
)
```

#### execute

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"let execute command =\n    execution_options fun x => { x with\n        command = command\n    }\n    |> execute_with_options","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  let execute command =
      execution_options fun x => { x with
          command = command
      }
      |> execute_with_options
  """,
  timeout: 300_000
)
```

#### tests

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"///- --test\n///> rust -d chrono encoding_rs encoding_rs_io regex sha2\n\ninl content = \"╭─[ 你好，世界！こんにちは世界！ ]─╮\"\n\ninl file_name = join \"test.txt\"\ninl temp_dir, disposable =\n    #?*(file_name, content)\n    |> crypto.hash_text\n    |> file_system.create_temp_dir'\ndisposable |> use |> ignore\ninl path = temp_dir </> file_name |> file_system.normalize_path\ninl exit_code, result =\n    execute (\"pwsh -c \\\"[IO.File]::ReadAllText('\" ++# path ++# \"')\\\"\")\nexit_code |> _assert_eq 1\nresult |> _assert sm'.contains \"not find file\"\n\ncontent |> file_system.write_all_text path\n\ninl exit_code, output =\n    execution_options fun x => { x with\n        command = \"pwsh -c \\\"[System.Console]::OutputEncoding = [System.Text.Encoding]::UTF8; [IO.File]::ReadAllText('\" ++# file_name ++# \"')\\\"\"\n        working_directory = Some temp_dir |> optionm'.box\n    }\n    |> execute_with_options\n\nexit_code |> _assert_eq 0i32\noutput |> _assert_eq content","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  ///- --test
  ///> rust -d chrono encoding_rs encoding_rs_io regex sha2

  inl content = "╭─[ 你好，世界！こんにちは世界！ ]─╮"

  inl file_name = join "test.txt"
  inl temp_dir, disposable =
      #?*(file_name, content)
      |> crypto.hash_text
      |> file_system.create_temp_dir'
  disposable |> use |> ignore
  inl path = temp_dir </> file_name |> file_system.normalize_path
  inl exit_code, result =
      execute ("pwsh -c \"[IO.File]::ReadAllText('" ++# path ++# "')\"")
  exit_code |> _assert_eq 1
  result |> _assert sm'.contains "not find file"

  content |> file_system.write_all_text path

  inl exit_code, output =
      execution_options fun x => { x with
          command = "pwsh -c \"[System.Console]::OutputEncoding = [System.Text.Encoding]::UTF8; [IO.File]::ReadAllText('" ++# file_name ++# "')\""
          working_directory = Some temp_dir |> optionm'.box
      }
      |> execute_with_options

  exit_code |> _assert_eq 0i32
  output |> _assert_eq content
  """,
  timeout: 300_000
)
```

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"///- --test\n///> rust -d chrono encoding_rs encoding_rs_io regex sha2\n\n/// task: write a script to test the real time capabilities of std capturing\n\ninl exit_code, output =\n    execution_options fun x => { x with\n        command = \"pwsh -c \\\"[System.Console]::OutputEncoding = [System.Text.Encoding]::UTF8; for ($i = 0; $i -lt 5; $i++) { Write-Output `\\\"Line$i`\\\"; Start-Sleep -Milliseconds 200 }\\\"\"\n        // trace = true\n    }\n    |> execute_with_options\nexit_code |> _assert_eq 0i32\noutput |> _assert sm'.contains \"Line4\"","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  ///- --test
  ///> rust -d chrono encoding_rs encoding_rs_io regex sha2

  /// task: write a script to test the real time capabilities of std capturing

  inl exit_code, output =
      execution_options fun x => { x with
          command = "pwsh -c \"[System.Console]::OutputEncoding = [System.Text.Encoding]::UTF8; for ($i = 0; $i -lt 5; $i++) { Write-Output `\"Line$i`\"; Start-Sleep -Milliseconds 200 }\""
          // trace = true
      }
      |> execute_with_options
  exit_code |> _assert_eq 0i32
  output |> _assert sm'.contains "Line4"
  """,
  timeout: 300_000
)
```

### execute_retry

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"let execute_retry retries options =\n    fun () =>\n        inl exit_code, result = options |> execute_with_options\n        if exit_code = 0\n        then Ok (exit_code, result)\n        else Error (exit_code, result)\n    |> retry_fn' retries","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  let execute_retry retries options =
      fun () =>
          inl exit_code, result = options |> execute_with_options
          if exit_code = 0
          then Ok (exit_code, result)
          else Error (exit_code, result)
      |> retry_fn' retries
  """,
  timeout: 300_000
)
```

## main

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"///> fsharp\n\ninl main () =\n    init_trace_state None\n    $'let current_process_kill () = !current_process_kill ()' : ()\n    inl execution_options fn =\n        execution_options fun x =>\n            x\n            |> heap\n            |> fn\n            |> fun x => !x\n    $'let execution_options x = !execution_options x' : ()\n    inl split_args x = x |> split_args |> resultm.box\n    $'let split_args x = !split_args x' : ()","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  ///> fsharp

  inl main () =
      init_trace_state None
      $'let current_process_kill () = !current_process_kill ()' : ()
      inl execution_options fn =
          execution_options fun x =>
              x
              |> heap
              |> fn
              |> fun x => !x
      $'let execution_options x = !execution_options x' : ()
      inl split_args x = x |> split_args |> resultm.box
      $'let split_args x = !split_args x' : ()
  """,
  timeout: 300_000
)
```
