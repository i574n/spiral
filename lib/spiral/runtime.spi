/// # runtime
:< rust
:< rust_operators
:< sm'_operators

test runtime static =
    :< testing
    :< file_system_operators

/// ## runtime

/// ### split_args
:~ split_args (args : string) : result (array_base string) _ =
    :< parsing
    := esc = [ '\\'; '`' ]
    := quotes = [ '"' ]
    := special = esc ++ quotes
    := p_esc_pair (p : parser _) : parser string = \ t, i, s =>
        ?= p (t, i, s) ?|
        | Ok (_, i', s') => Ok (t |> slice i i', i', s')
        | Error e => Error e
    := p_esc_char c = p_char c >>. any_char () |> p_esc_pair
    := p_word = special |> none_of |>> \ c => \ () => c () |> sm'.obj_to_string
    := p_plain = special ++ [ ' ' ] |> many1_none_of
    := p_esc = esc |> listm.map p_esc_char |> choice
    := p_chunk = special |> many1_none_of
    := p_quoted = (p_chunk <|> p_esc) |> many_strings
    := p_quoted_all = p_quoted |> between (p_char '"') (p_char '"')
    := p_esc_root = p_esc >>% "" >>. p_word |> many |>> \ s => \ () => s () |> sm'.concat_list ""
    := p_esc_quote_delim =
        esc
        |> listm.map \ c => p_char c >>. p_char '"' >>% '"'
        |> choice
    := p_esc_char_noquote c = p_char c >>. none_of [ '"' ] |> p_esc_pair
    := p_esc_noquote = esc |> listm.map p_esc_char_noquote |> choice
    := p_quoted_esc = (p_chunk <|> p_esc_noquote) |> many_strings
    := p_quoted_all_esc = p_quoted_esc |> between p_esc_quote_delim p_esc_quote_delim
    := ensure_progress p : parser _ = \ input, i, s =>
        ?= p (input, i, s) ?|
        | Ok (r, i', s') ?& i' = i =>
            fail (\ _ => "runtime.split_args / segment zero-length success") i s
        | other => other
    := p_segment = ensure_progress (p_quoted_all_esc <|> p_quoted_all <|> p_plain <|> p_esc_root)
    := p_content = p_segment |> many1_strings
    := p_args = spaces1 () |> sep_by p_content
    args
    |> run_parser p_args
    |> resultm.map (fst >> \ (args : list string) =>
        ? is_rust () ?>
            := n = (0i32, args) ||> listm.fold \ n _ => n + 1
            := acc : array_base string = $'Rc::new(RefCell::new(Vec::with_capacity(!n as usize)))'
            := _ : i32 = (0i32, args) ||> listm.fold \ n (x : string) =>
                $'!acc.borrow_mut().push(!x)' : ()
                n + 1
            acc
        |: args |> listm'.box |> listm'.to_array'
    )
    |> resultm.map_error eval

///> gleam
///> fsharp
///> cuda
///> rust
///> typescript
test split_args =
    Debug |> set_trace_level
    [
        "a b c",
        ;[ "a"; "b"; "c" ]

        "e f \"g h\" i",
        ;[ "e"; "f"; "g h"; "i" ]

        "\"j k\" \"l\" \"m\"",
        ;[ "j k"; "l"; "m" ]

        "s -t \"u \`\"v\`\" w\"",
        ;[ "s"; "-t"; "u \`\"v\`\" w" ]

        "n -o \"p \\\"q\\\" r\"",
        ;[ "n"; "-o"; "p \\\"q\\\" r" ]

        "r -s \"t \\\"u\\\"\"",
        ;[ "r"; "-s"; "t \\\"u\\\"" ]

        $'"x -y \\\"$z -a \'(b=\\\\\\"c-id=)[a-fA-F0-9]{8}\', { \`$_[1] + \`$d++ }\\\""',
        ;[ "x"; "-y"; "$z -a '(b=\\\"c-id=)[a-fA-F0-9]{8}', { `$_[1] + `$d++ }" ]

        "e -f \"$g -h '(i=`\"j-id=)[a-fA-F0-9]{8}', { `$_[1] + `$k++ }\"",
        ;[ "e"; "-f"; "$g -h '(i=`\"j-id=)[a-fA-F0-9]{8}', { `$_[1] + `$k++ }" ]

        $'"--l \\\\\\"\'\'\' m \'\'\'\\\\\\" "',
        ;[ "--l"; "''' m '''" ]

        $'"n --o --p q --r \\\"s:/t u/v.w\\\" --x \\\"y:/z.a\\\" --b c.d \\\"\\\\e{f-g}\\\" h.i \\\"j (k)\\\""',
        ;[
            "n"; "--o"; "--p"; "q"; "--r"; "s:/t u/v.w"; "--x"; "y:/z.a"; "--b"; "c.d"; "\\e{f-g}"; "h.i"; "j (k)"
        ]

        $'"l \\\"m n:\\\\o.p\\\""',
        ;[ "l"; "m n:\\o.p" ]

        $'"--r s \\\\\\"\' t \'\\\\\\" u v w \\\\\\"x y\\\\\\""',
        ;[ "--r"; "s"; "' t '"; "u"; "v"; "w"; "x y" ]
    ]
    |> _assert_fn split_args

/// ### split_command
:~ split_command (command : string) : result (string * option string) _ =
    :< parsing
    := quotes = [ '"'; '\'' ]
    := p_quoted_char = quotes |> listm.map p_char |> choice
    := normalize = \ s => \ () => s () |> sm'.replace "\\" "/"
    := p_quoted = quotes |> none_of |> many_chars |> between p_quoted_char p_quoted_char |>> normalize
    := p_unquoted = quotes ++ [ ' ' ] |> none_of |> many1_chars |>> normalize
    := p_path = p_quoted <|> p_unquoted <|> (eof () >>% "")
    := p_args = spaces1 () >>. rest_of_line ()
    := p_command = p_path .>>. (p_args |> opt)
    command
    |> run_parser p_command
    |> resultm.map (fst >> \ path, args => path (), args () |> optionm.map eval)
    |> resultm.map_error eval

///> gleam
///> fsharp
///> cuda
///> rust
///> typescript
test split_command =
    Debug |> set_trace_level
    [
        "",
        ("", None)

        "/a/b/c",
        ("/a/b/c", None)

        "d e.f",
        ("d", "e.f" |> Some)

        "..\\..\\g.h i.j k.l",
        ("../../g.h", "i.j k.l" |> Some)

        "m:\\n\\o.p \"q.r s.t\"",
        ("m:/n/o.p", "\"q.r s.t\"" |> Some)

        "\"..\\..\\u v\\w.x\" \"y z.a\" b.c",
        ("../../u v/w.x", "\"y z.a\" b.c" |> Some)

        "\"..\\..\\d e.f\" -g \\\\\"h i\\\\\"",
        ("../../d e.f", "-g \\\\\"h i\\\\\"" |> Some)

        "..\\..\\j k.l -m \\\\\"n o\\\\\"",
        ("../../j", "k.l -m \\\\\"n o\\\\\"" |> Some)
    ]
    |> _assert_fn split_command

/// ### execution_line
:== execution_line =
    {
        process_id : int
        line : string
        error : bool
    }

/// ## rust

/// ### process_child
:! process_child =
    `(
        rust.rust_type
            `($'std_process_Child')
            `($'std::process::Child')
            "type std_process_Child = class end"
    )

/// ### process_child_stdin
:! process_child_stdin =
    `(
        rust.rust_type
            `($'std_process_ChildStdin')
            `($'std::process::ChildStdin')
            "type std_process_ChildStdin = class end"
    )

:= process_child_stdin
    (child : rust.ref (rust.mut' process_child))
    : rust.ref (rust.mut' (optionm'.option' process_child_stdin))
    =
    !\\(child, $'"&mut $0.stdin"')

/// ## runtime

/// ### execution_options
:== execution_options =
    {
        command : string
        cancellation_token : optionm'.option' threading.cancellation_token
        environment_variables : array_base (string * string)
        on_line : optionm'.option' (execution_line -> async.async ())
        stdin : optionm'.option' (threading.arc (threading.mutex process_child_stdin) -> ())
        trace : bool
        working_directory : optionm'.option' string
        stderr : bool
    }

:= execution_options (fn : execution_options -> execution_options) : execution_options =
    {
        command = ""
        cancellation_token = None |> optionm'.box
        environment_variables = am'.base ;[]
        on_line = None |> optionm'.box
        stdin = None |> optionm'.box
        trace = !+
        working_directory = None |> optionm'.box
        stderr = !+
    }
    |> fn

