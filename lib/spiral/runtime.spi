        rust.rust_type
            `($'clap_Arg')
            `($'clap::Arg')
            "type clap_Arg = class end"
    )

/// ### new_arg
:= new_arg (s : rust.static_ref sm'.str) : arg =
    !\\(s, $'"clap::Arg::new($0)"')

///> rust -d clap
test new_arg =
    ###"arg"
    |> new_arg
    |> sm'.format_pretty
    |> _assert sm'.contains "\"arg\""

/// ### command_arg
:= command_arg (arg : arg) (command : command) : command =
    !\\((command, arg), $'"clap::Command::arg($0, $1)"')

/// ### arg_required
:= arg_required (value : bool) (arg : arg) : arg =
    !\\((arg, value), $'"$0.required($1)"')

/// ### arg_require_equals
:= arg_require_equals (value : bool) (arg : arg) : arg =
    !\\((arg, value), $'"$0.require_equals($1)"')

/// ### arg_default_value
:= arg_default_value (value : string) (arg : arg) : arg =
    := value = #value
    !\\((arg, value), $'"$0.default_value(&*Box::leak(String::from($1).into_boxed_str()))"')

/// ### arg_default_missing_value
:= arg_default_missing_value (value : string) (arg : arg) : arg =
    := value = #value
    backend_switch {
        Rust = fun () => !\\((arg, value), $'"$0.default_missing_value(&*Box::leak(String::from($1).into_boxed_str()))\
            "') : arg
    }

/// ### arg_short
:= arg_short (value : char) (arg : arg) : arg =
    !\\((arg, value), $'"$0.short($1 as char)"')

/// ### arg_long
:= arg_long (value : rust.static_ref sm'.str) (arg : arg) : arg =
    !\\((arg, value), $'"$0.long($1)"')

/// ### arg_value_names
:= arg_value_names (values : array_base (rust.static_ref sm'.str)) (arg : arg) : arg =
    := values = values |> am'.to_vec
    !\\((arg, values), $'"$0.value_names($1)"')

/// ### value_range
:! value_range =
    `(
        rust.rust_type
            `($'clap_builder_ValueRange')
            `($'clap::builder::ValueRange')
            "type clap_builder_ValueRange = class end"
    )

/// ### new_value_range
:= new_value_range \* t. inclusive (start : _ t) (end : _ t) : value_range =
    := len () =
        0i32 |> convert.convert
    := start, end =
        :< am'
        ?= start, end ?|
        | Start start, End fn =>
            start, len |> fn
        | End start_fn, End end_fn =>
            start_fn len, end_fn len
    := inclusive =
        ? inclusive
        ?> "="
        |: ""
    ?= start, end ?|
    | start, end ?& end =. len () => !\\(start, $'"clap::builder::ValueRange::new($0..)"')
    | start, end => !\\((start, end), $'"clap::builder::ValueRange::new($0.." + !inclusive + "$1)"')

/// ### arg_num_args_range
:= arg_num_args_range (value : value_range) (arg : arg) : arg =
    !\\((arg, value), $'"$0.num_args($1)"')

/// ### value_parser
:! value_parser =
    `(
        rust.rust_type
            `($'clap_builder_ValueParser')
            `($'clap::builder::ValueParser')
            "type clap_builder_ValueParser = class end"
    )

/// ### possible_value
:! possible_value =
    `(
        rust.rust_type
            `($'clap_builder_PossibleValue')
            `($'clap::builder::PossibleValue')
            "type clap_builder_PossibleValue = class end"
    )

/// ### new_possible_value
:= new_possible_value \* t. (x : t) : possible_value =
    !\\(x, $'"clap::builder::PossibleValue::new(&**$0)"')

/// ### arg_value_parser
:= arg_value_parser (values : value_parser) (arg : arg) : arg =
    !\\((arg, values), $'"$0.value_parser($1)"')

/// ### arg_action
:! arg_action' =
    `(
        rust.rust_type
            `($'clap_ArgAction')
            `($'clap::ArgAction')
            "type clap_ArgAction = class end"
    )

:| arg_action =
    | Set
    | Append
    | SetTrue
    | SetFalse
    | Count
    | Help
    | HelpShort
    | HelpLong
    | Version

:= arg_action = \|
    | Set => !\($'"clap::ArgAction::Set"') : arg_action'
    | Append => !\($'"clap::ArgAction::Append"') : arg_action'
    | SetTrue => !\($'"clap::ArgAction::SetTrue"') : arg_action'
    | SetFalse => !\($'"clap::ArgAction::SetFalse"') : arg_action'
    | Count => !\($'"clap::ArgAction::Count"') : arg_action'
    | Help => !\($'"clap::ArgAction::Help"') : arg_action'
    | HelpShort => !\($'"clap::ArgAction::HelpShort"') : arg_action'
    | HelpLong => !\($'"clap::ArgAction::HelpLong"') : arg_action'
    | Version => !\($'"clap::ArgAction::Version"') : arg_action'

:= arg_action (value : arg_action) (arg : arg) : arg =
    := value = value |> arg_action
    !\\((arg, value), $'"$0.action($1)"')

/// ### arg_index
:= arg_index (value : i32) (arg : arg) : arg =
    := index : convert.unativeint =
        ? is_rust ()
        ?> $'(!value as usize)'
        |: $'!value |> `(convert.unativeint) '
    !\\((arg, index), $'"$0.index($1)"')

/// ### arg_matches
:! arg_matches =
    `(
        rust.rust_type
            `($'clap_ArgMatches')
            `($'clap::ArgMatches')
            "type clap_ArgMatches = class end"
    )

/// ### command_get_matches
:= command_get_matches (command : command) : arg_matches =
    !\\(command, $'"clap::Command::get_matches($0)"')

/// ### command_get_matches_from
:= command_get_matches_from (args : array_base string) (command : command) : arg_matches =
    := args = args |> am'.to_vec |> am'.vec_map sm'.to_std_string
    !\\(command, $'"clap::Command::get_matches_from($0, !args)"')

/// ### command_args_override_self
:= command_args_override_self (yes : bool) (command : command) : command =
    !\\(command, $'"clap::Command::args_override_self($0, !yes)"')

/// ### command_init_arg
:= command_init_arg (long, short) fn command =
    command
    |> command_arg (
        ###long
        |> new_arg
        |> arg_short short
        |> arg_long ###long
        |> fn
    )

/// ### matches_get_one
:= matches_get_one \* t. (x : string) (matches : arg_matches) : optionm'.option' t =
    := x = ~~ x
    := x = x |> sm'.as_str
    !\\((matches, x), $'"clap::ArgMatches::get_one(&$0, $1).cloned()"')

/// ### matches_get_flag
:= matches_get_flag (x : string) (matches : arg_matches) : bool =
    := x = ~~ x
    := x = x |> sm'.as_str
    !\\((matches, x), $'"clap::ArgMatches::get_flag(&$0, $1)"')

/// ### matches_get_many
:= matches_get_many \* t. (x : string) (matches : arg_matches) : optionm'.option' (am'.vec t) =
    := x = ~~ x
    := x = x |> sm'.as_str
    !\\((matches, x), $'"clap::ArgMatches::get_many(&$0, $1).map(|x| x.cloned().into_iter().collect())"')

/// ### matches_subcommand
:= matches_subcommand (matches : arg_matches) : optionm'.option' (sm'.std_string * arg_matches) =
    !\\((matches, sm'.ref_to_std_string), $'"clap::ArgMatches::subcommand(Box::leak(Box::new($0))).map(|(a, b)| \
        ($1(a), b.clone()))"')

/// ### command_subcommand_required
:= command_subcommand_required (value : bool) (command : command) : command =
    !\\(command, $'"clap::Command::subcommand_required($0, !value)"')

/// ### command_subcommand
:= command_subcommand (subcommand : command) (command : command) : command =
    !\\(command, $'"clap::Command::subcommand($0, !subcommand)"')

/// ### value_parser_possible_values
:= value_parser_possible_values (values : array_base string) : value_parser =
    := values =
        values
        |> am'.to_vec
        |> am'.vec_map (sm'.to_std_string >> rust.new_box >> rust.box_leak >> new_possible_value)
    !\\(values, $'"Into::<clap::builder::ValueParser>::into(clap::builder::PossibleValuesParser::new($0))"')

/// ### arg_union
:= arg_union \* union_type. (fn : union_type -> ()) (arg : arg) : arg =
    arg
    |> arg_value_parser (
        ~> reflection.get_union_fields_untag `union_type ()
        |> \ x => x : _ (string * union_type)
        |> listm.map (fst >> sm'.to_lower)
        |> listm'.box
        |> listm'.to_array'
        |> value_parser_possible_values
    )

///> rust -d clap
test arg_union =
    ###"command"
    |> new_command
    |> command_init_arg ("trace-level", 't') (
        ~> arg_union `trace_level ignore
    )
    |> command_get_matches_from (am'.base ;[ "_"; "--trace-level"; "critical" ])
    |> matches_get_one "trace-level"
    |> optionm'.unwrap
    |> sm'.from_std_string
    |> reflection.union_try_pick
    |> optionm.value
    |> _assert_eq Critical

/// ### command_debug_assert
:= command_debug_assert (command : command) : () =
    !\\(command, $'"clap::Command::debug_assert($0)"')

/// ## fsharp

/// ### process
:! process = $'System.Diagnostics.Process'

/// ### process_start_info
:! process_start_info = $'System.Diagnostics.ProcessStartInfo'

/// ### data_received_event_args
:! data_received_event_args = $'System.Diagnostics.DataReceivedEventArgs'

/// ### process_id
:~ process_id (process : process) : i32 =
    run_target \|
        | Fsharp => \ () => process |> $'_.Id'
        | _ => \ () => null ()

/// ### current_process_kill
:~ current_process_kill () =
    run_target \|
        | Fsharp => \ () =>
            := fn () =
                run_target \|
                    | Fsharp => \ () =>
                        trace Warning (\ () => "runtime.current_process_kill / exiting... 3") id
                        $'System.Threading.Thread.Sleep 500'
                        trace Warning (\ () => "runtime.current_process_kill / exiting... 2") id
                        $'System.Console.Out.Flush ()'
                        $'System.Threading.Thread.Sleep 1000'
                        trace Warning (\ () => "runtime.current_process_kill / exiting... 1") id
                        $'System.Console.Error.Flush ()'
                        $'System.Environment.Exit 1' : ()
                    | _ => \ () => ()
            := thread : threading.thread = $'new System.Threading.Thread (!fn)'
            thread |> $'_.Start()' : ()
        | _ => \ () => ()

/// ### gc_collect
:= gc_collect () =
    run_target \|
        | Fsharp _ => \ () => $'System.GC.Collect' () : ()
        | _ => \ () => ()

/// ## runtime

/// ### execute_with_options_fsharp
:= execute_with_options_fsharp (options : execution_options) : i32 * string =
    := command = ~~ options.command
    := file_name, arguments = command |> split_command |> resultm.get
    := arguments =
        arguments
        |> optionm'.default_value ""
        |> split_args
        |> resultm.get
        |> am'.to_vec
        |> am'.vec_map sm'.to_std_string
    trace Debug
        \ () => "runtime.execute_with_options"
        \ () => { file_name arguments = #?*arguments; options }
    \ () =>
        \ () =>
            file_name
            |> new_process_command
            |> process_command_args arguments
            |> process_command_stdout (process_stdio_piped ())
            |> process_command_stderr (process_stdio_piped ())
            |> process_command_stdin (process_stdio_piped ())
            |> \ command =>
                ?= options.working_directory |> optionm'.unbox ?|
                | Some working_directory => command |> process_command_current_dir working_directory
                | None => !\($'$"!command"') |> rust.emit
            |> \ command =>
                ?= options.environment_variables ?|
                | ;[] => command
                | vars =>
                    (command, vars |> am'.to_vec)
                    ||> am'.vec_fold' \ command (key, value) =>
                        command |> process_command_env key value
            |> process_command_spawn
            |> resultm.map_error'' sm'.format'
            |> resultm.map' (rust.emit >> optionm'.some' >> rust.emit >> threading.new_arc_mutex)
            |> resultm.unbox'
            |> \|
                | Ok child =>
                    := stdout =
                        \ () =>
                            child
                            |> threading.arc_mutex_lock
                            |> resultm.unwrap'
                            |> threading.mutex_guard_ref_mut''
                            |> optionm'.as_mut
                            |> optionm'.unwrap
                            |> process_child_stdout
                            |> optionm'.take_ref_mut
                            |> optionm'.unwrap
                        |> rust.capture
                    := stderr =
                        \ () =>
                            child
                            |> threading.arc_mutex_lock
                            |> resultm.unwrap'
                            |> threading.mutex_guard_ref_mut''
                            |> optionm'.as_mut
                            |> optionm'.unwrap
                            |> process_child_stderr
                            |> optionm'.take_ref_mut
                            |> optionm'.unwrap
                        |> rust.capture
                    := stdin =
                        \ () =>
                            child
                            |> threading.arc_mutex_lock
                            |> resultm.unwrap'
                            |> threading.mutex_guard_ref_mut''
                            |> optionm'.as_mut
                            |> optionm'.unwrap
                            |> process_child_stdin
                            |> optionm'.take_ref_mut
                            |> optionm'.unwrap
                            |> optionm'.some'
                            |> rust.emit
                            |> threading.new_arc_mutex
                        |> rust.capture
                    := channel_sender, channel_receiver = threading.new_channel ()
                    := channel_sender'' = channel_sender |> rust.emit |> threading.new_arc_mutex
                    := channel_sender' = channel_sender |> rust.emit |> threading.new_arc_mutex
                    := channel_receiver' = channel_receiver |> rust.emit |> threading.new_arc_mutex
                    := stdout_handle =
                        \ () =>
                            stdout
                            |> stream.decode_reader_bytes_build
                            |> stream.new_buf_reader
                            |> stream.buf_read_lines
                            |> iter.try_for_each \ lines =>
                                := channel_sender'' = channel_sender'' |> rust.clone
                                lines
                                |> stdio_line (Ok ()) options.trace channel_sender''
                                |> resultm.to_try
                        |> threading.spawn (1, 0) 1
                    := stderr_handle =
                        \ () =>
                            stderr
                            |> stream.decode_reader_bytes_build
                            |> stream.new_buf_reader
                            |> stream.buf_read_lines
                            |> iter.try_for_each \ lines =>
                                ? options.stderr |> not
                                ?> Ok () |> resultm.box
                                |:
                                    := channel_sender' = channel_sender' |> rust.clone
                                    lines
                                    |> stdio_line (Error ()) options.trace channel_sender'
                                |> resultm.to_try
                        |> threading.spawn (1, 0) 1
                    ?= options.stdin |> optionm'.unbox ?|
                    | Some stdin' =>
                        stdin
                        |> threading.arc_mutex_lock
                        |> resultm.unwrap'
                        |> threading.mutex_guard_ref_mut''
                        |> optionm'.take_ref_mut
                        |> optionm'.map' threading.new_arc_mutex
                        |> optionm'.unbox
                        |> \|
                            | Some stdin =>
                                stdin |> stdin'
                                stdin
                                |> threading.arc_mutex_lock'
                                |> resultm.unwrap'
                                |> stdin_flush
                            | None => ()
                    | None => ()
                    := output =
                        child
                        |> threading.arc_mutex_lock'
                        |> resultm.unwrap'
                        |> threading.mutex_guard_ref_mut''
                        |> optionm'.take_ref_mut
                        |> optionm'.unwrap
                        |> child_wait_with_output
                        |> resultm.map_error'' sm'.format'
                    [ stdout_handle; stderr_handle ]
                    |> am'.new_vec
                    |> am'.vec_for_each' (threading.join' >> resultm.unwrap' >> resultm.unwrap')
                    ?= output |> resultm.unbox ?|
                    | Ok output =>
                        := exit_code =
                            output
                            |> process_output_status
                            |> process_exit_status_code
                            |> optionm'.unbox
                        ?= exit_code ?|
                        | Some exit_code =>
                            := stdout =
                                output
                                |> process_output_stdout
                                |> sm'.string_from_utf8
                                |> resultm.unwrap'
                            := stderr =
                                output
                                |> process_output_stderr
                                |> sm'.string_from_utf8
                                |> resultm.unwrap'
                            := output =
                                [ stdout; stderr ]
                                |> listm.map (sm'.from_std_string >> sm'.trim)
                                |> listm'.filter (sm'.is_empty >> not)
                                |> sm'.concat_list "\n"
                                |> sm'.to_std_string
                                |> Some
                            exit_code, output, Some channel_receiver'
                        | None =>
                            -1,
                            ("runtime.execute_with_options / exit_code=None"
                                |> sm'.to_std_string
                                |> Some),
                            Some channel_receiver'
                    | Error error =>
                        trace Critical
                            \ () => "runtime.execute_with_options / output error"
                            \ () => { error file_name arguments = #?*arguments; options }
                        -2i32, error |> Some, None
                | Error error =>
                    trace Critical
                        \ () => "runtime.execute_with_options / child error"
                        \ () => { error file_name arguments = #?*arguments; options }
                    -1i32, error |> Some, None
            |> \|
                | exit_code, std_trace, channel_receiver =>
                    := std_trace =
                        channel_receiver
                        |> optionm'.box
                        |> optionm'.map' \ channel_receiver =>
                            channel_receiver
                            |> threading.arc_mutex_lock'
                            |> resultm.unwrap'
                            |> iter.iter
                            |> iter_collect''
                            |> am'.vec_map sm'.from_std_string
                            |> am'.from_vec
                            |> \ x => x : array _
                            |> seq.of_array
                            |> sm'.concat "\n"
                        |> optionm'.unbox
                        |> optionm.map (sm'.trim >> sm'.to_option)
                        |> optionm'.flatten
                        |> optionm'.default_value (
                            std_trace
                            |> optionm.map sm'.from_std_string
                            |> optionm'.default_value ""
                        )
                    trace Verbose
                        \ () => "runtime.execute_with_options / result"
                        \ () => { file_name exit_code std_trace_len = ##std_trace }
                    new_pair exit_code std_trace
        |> capture
    |> \ x => x ()
    |> from_pair

/// ### execute_with_options_rust
:= execute_with_options_rust (options : execution_options) : i32 * string =
    := command = ~~ options.command
    := file_name, arguments = command |> split_command |> resultm.get
    := arguments =
        arguments
        |> optionm'.default_value ""
        |> split_args
        |> resultm.get
        |> am'.to_vec
        |> am'.vec_map sm'.to_std_string
    trace Debug
        \ () => "runtime.execute_with_options"
        \ () => { file_name arguments = #?*arguments }
    := trace' = options.trace
    := on_stdout (line : resultm.result' sm'.std_string sm'.std_string) : sm'.std_string =
        line |> stdio_line_rust (Ok ()) trace'
    := on_stderr (line : resultm.result' sm'.std_string sm'.std_string) : sm'.std_string =
        line |> stdio_line_rust (Error ()) trace'
    := kind, exit_code, error, lines =
        !\\(
            (
                file_name,
                arguments,
                options.working_directory,
                options.environment_variables,
                options.stdin,
                options.cancellation_token,
                options.stderr,
                on_stdout,
                on_stderr
            ),
            $'"{ let wd: Option<std::rc::Rc<str>> = $2.clone(); let stdin_fn: Option<std::rc::Rc<dyn \
                Fn(std::sync::Arc<std::sync::Mutex<std::process::ChildStdin>>)>> = $4.clone(); let token: \
                Option<std::sync::Arc<std::sync::atomic::AtomicBool>> = $5.clone(); let stderr_on: bool = $6; let mut \
                c = std::process::Command::new(&*$0); c.args(&*$1); c.stdout(std::process::Stdio::piped()); \
                c.stderr(std::process::Stdio::piped()); c.stdin(std::process::Stdio::piped()); if let Some(d) = &wd { \
                c.current_dir(&**d); } for (k, v) in $3.borrow().iter() { c.env(&**k, &**v); } match c.spawn() { \
                Err(e) => (1i32, None, Some(format\!(\\\"{}\\\", e)), Vec::new()), Ok(mut child) => { let out = \
                child.stdout.take().unwrap(); let err = child.stderr.take().unwrap(); let (tx, rx) = \
                std::sync::mpsc::channel::<(bool, Result<std::string::String, std::string::String>)>(); let tx2 = \
                tx.clone(); let h1 = std::thread::spawn(move || { for l in \
                std::io::BufRead::lines(std::io::BufReader::new(encoding_rs_io::DecodeReaderBytesBuilder::new().utf8_p\
                assthru(true).build(out))) { if tx.send((false, l.map_err(|e| format\!(\\\"{}\\\", e)))).is_err() { \
                break; } } }); let h2 = std::thread::spawn(move || { for l in \
                std::io::BufRead::lines(std::io::BufReader::new(encoding_rs_io::DecodeReaderBytesBuilder::new().utf8_p\
                assthru(true).build(err))) { if stderr_on && tx2.send((true, l.map_err(|e| format\!(\\\"{}\\\", \
                e)))).is_err() { break; } } }); if let (Some(f), Some(s)) = (&stdin_fn, child.stdin.take()) { let a = \
                std::sync::Arc::new(std::sync::Mutex::new(s)); f(a.clone()); let _ = std::io::Write::flush(&mut \
                *a.lock().unwrap()); } let mut lines: Vec<std::string::String> = Vec::new(); let mut cancelled = \
                false; loop { if let Some(t) = &token { if t.load(std::sync::atomic::Ordering::SeqCst) { let _ = \
                child.kill(); cancelled = true; break; } } match rx.recv_timeout(std::time::Duration::from_millis(100)\
                ) { Ok((false, l)) => lines.push($7(l)), Ok((true, l)) => lines.push($8(l)), \
                Err(std::sync::mpsc::RecvTimeoutError::Timeout) => {}, \
                Err(std::sync::mpsc::RecvTimeoutError::Disconnected) => break } } if \!cancelled { let _ = h1.join(); \
                let _ = h2.join(); } match child.wait() { Ok(s) => (0i32, s.code(), None, lines), Err(e) => (2i32, \
                None, Some(format\!(\\\"{}\\\", e)), lines) } } } }"'
        ) : i32 * optionm'.option' i32 * optionm'.option' sm'.std_string * am'.vec sm'.std_string
    := error = error |> optionm'.default_value' (sm'.to_std_string "") |> sm'.from_std_string
    := exit_code, std_trace =
        ? kind = 1 ?>
            trace Critical
                \ () => "runtime.execute_with_options / child error"
                \ () => { error file_name arguments = #?*arguments }
            -1i32, error
        |? kind = 2 ?>
            trace Critical
                \ () => "runtime.execute_with_options / output error"
                \ () => { error file_name arguments = #?*arguments }
            -2i32, error
        |:
            := exit_code, fallback =
                ?= exit_code |> optionm'.unbox ?|
                | Some exit_code => exit_code, ""
                | None => -1i32, "runtime.execute_with_options / exit_code=None"
            := text =
                lines
                |> am'.vec_map sm'.from_std_string
                |> am'.from_vec
                |> \ x => x : array _
                |> seq.of_array
                |> sm'.concat "\n"
                |> sm'.trim
            exit_code, (? text = "" ?> fallback |: text)
    trace Verbose
        \ () => "runtime.execute_with_options / result"
        \ () => { file_name exit_code std_trace_len = ##std_trace }
    exit_code, std_trace

/// ### execute_with_options
:~ execute_with_options (options : execution_options) : i32 * string =
    backend_switch {
        Fsharp = \ () => execute_with_options_fsharp options
        Rust = \ () => execute_with_options_rust options
    }

/// #### execute
:~ execute command =
    execution_options \ x => { x ?|
        command = command
    }
    |> execute_with_options

/// #### tests
///> rust -d chrono encoding_rs encoding_rs_io regex sha2
test tests =
    := content = "╭─[ 你好，世界！こんにちは世界！ ]─╮"

    := file_name = ~~ "test.txt"
    := temp_dir, disposable =
        #?*(file_name, content)
        |> crypto.hash_text
        |> file_system.create_temp_dir'
    disposable |> use |> ignore
    := path = temp_dir </> file_name |> file_system.normalize_path
    := exit_code, result =
        execute ("pwsh -c \"[IO.File]::ReadAllText('" ++# path ++# "')\"")
    exit_code |> _assert_eq 1
    result |> _assert sm'.contains "not find file"

    content |> file_system.write_all_text path

    := exit_code, output =
        execution_options \ x =>
            { x ?|
                command =
                    (
                        "pwsh -c \"[System.Console]::OutputEncoding = [System.Text.Encoding]::UTF8; "
                        ^^ "[IO.File]::ReadAllText('"
                    )
                    ++# file_name
                    ++# "')\""
                working_directory = Some temp_dir |> optionm'.box
            }
        |> execute_with_options

    exit_code |> _assert_eq 0i32
    output |> _assert_eq content

///> rust -d chrono encoding_rs encoding_rs_io regex sha2
test tests_2 =
    := exit_code, output =
        execution_options \ x =>
            { x ?|
                command =
                    "pwsh -c \"[System.Console]::OutputEncoding = [System.Text.Encoding]::UTF8; for ($i = 0; $i "
                    ^^ "-lt 5; $i++) { Write-Output `\"Line$i`\"; Start-Sleep -Milliseconds 200 }\""
            }
        |> execute_with_options
    exit_code |> _assert_eq 0i32
    output |> _assert sm'.contains "Line4"

/// ## main
///> fsharp

:= main () =
    init_trace_state None
    $'let current_process_kill () = !current_process_kill ()' : ()
    := execution_options fn =
        execution_options \ x =>
            x
            |> heap
            |> fn
            |> \ x => !x
    $'let execution_options x = !execution_options x' : ()
    := split_args x = x |> split_args |> resultm.box
    $'let split_args x = !split_args x' : ()
