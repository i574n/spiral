/// ### stdin_write_all
:= stdin_write_all (stdin : threading.mutex_guard process_child_stdin) (text : string) : () =
    backend_switch {
        Fsharp = \ () =>
            := stream = text |> sm'.as_bytes
            := stdin = ~~ stdin
            (!\($'"true; let mut !stdin = !stdin"') : bool) |> ignore
            (!\\(stdin, $'"true; std::io::Write::write_all(&mut *$0, !stream).unwrap()"') : bool) |> ignore
        Rust = \ () =>
            := stream = text |> sm'.as_bytes
            (!\\((stdin, stream), $'"true; std::io::Write::write_all(&mut *$0, $1).unwrap()"') : bool) |> ignore
    }

/// ### stdin_flush
:= stdin_flush (stdin : threading.mutex_guard process_child_stdin) : () =
    backend_switch {
        Fsharp = \ () =>
            := stdin = ~~ stdin
            (!\($'"true; let mut !stdin = !stdin"') : bool) |> ignore
            (!\\(stdin, $'"true; std::io::Write::flush(&mut *$0).unwrap()"') : bool) |> ignore
        Rust = \ () =>
            (!\\(stdin, $'"true; std::io::Write::flush(&mut *$0).unwrap()"') : bool) |> ignore
    }

/// ### new_process_command
:= new_process_command (file_name : string) : process_command =
    !\\(file_name, $'"std::process::Command::new(&*$0)"')

/// ### process_stdio_piped
:= process_stdio_piped () : process_stdio =
    !\($'"std::process::Stdio::piped()"')

/// ### process_command_args
:= process_command_args (args : am'.vec sm'.std_string) (c : process_command) : process_command =
    (!\($'"true; let mut !c = !c"') : bool) |> ignore
    (!\\(args, $'"true; std::process::Command::args(&mut !c, &*$0)"') : bool) |> ignore
    c |> rust.emit

/// ### process_command_stdout
:= process_command_stdout (stdio : process_stdio) (c : process_command) : process_command =
    (!\($'"true; let mut !c = !c"') : bool) |> ignore
    (!\($'"true; std::process::Command::stdout(&mut !c, std::process::Stdio::piped())"') : bool) |> ignore
    c |> rust.emit

/// ### process_command_stderr
:= process_command_stderr (stdio : process_stdio) (c : process_command) : process_command =
    (!\($'"true; let mut !c = !c"') : bool) |> ignore
    (!\($'"true; std::process::Command::stderr(&mut !c, std::process::Stdio::piped())"') : bool) |> ignore
    c |> rust.emit

/// ### process_command_stdin
:= process_command_stdin (stdio : process_stdio) (c : process_command) : process_command =
    (!\($'"true; let mut !c = !c"') : bool) |> ignore
    (!\($'"true; std::process::Command::stdin(&mut !c, std::process::Stdio::piped())"') : bool) |> ignore
    c |> rust.emit

/// ### process_command_current_dir
:= process_command_current_dir (dir : string) (c : process_command) : process_command =
    (!\($'"true; let mut !c = !c"') : bool) |> ignore
    (!\\(dir, $'"true; std::process::Command::current_dir(&mut !c, &*$0)"') : bool) |> ignore
    !\($'$"!c"')

/// ### process_command_env
:= process_command_env (key : string) (value : string) (c : process_command) : process_command =
    (!\($'"true; let mut !c = !c"') : bool) |> ignore
    (!\\((key, value), $'"true; std::process::Command::env(&mut !c, &*$0, &*$1)"') : bool) |> ignore
    c |> rust.emit

/// ### process_command_spawn
:= process_command_spawn
    (c : process_command)
    : resultm.result' process_child stream.io_error
    =
    (!\($'"true; let mut !c = !c"') : bool) |> ignore
    !\($'"std::process::Command::spawn(&mut !c)"')

/// ### child_wait_with_output
:= child_wait_with_output
    (child : process_child)
    : resultm.result' process_output stream.io_error
    =
    !\\(child, $'"$0.wait_with_output()"')

/// ### stdio_line
:= stdio_line
    (stdio : result () ())
    (trace' : bool)
    (channel_sender : threading.arc (threading.mutex (threading.channel_sender sm'.std_string)))
    (line : resultm.result' sm'.std_string stream.io_error)
    : resultm.result' () sm'.std_string
    =
    := highlight text =
        $'$"\\u001b[4;7m{!text}\\u001b[0m"'
    := line =
        ?=
            line
            |> resultm.map_error'' sm'.format'
            |> resultm.unbox'
        ?|
        | Ok line =>
            := line =
                line
                |> sm'.from_std_string
                |> sm'.encoding_encode' (sm'.encoding_utf8' ())
                |> rust.cow_as_ref
                |> sm'.str_from_utf8
                |> resultm.unwrap'
                |> sm'.ref_to_std_string
            := line_log = line |> sm'.from_std_string
            := text =
                ?= stdio ?|
                | Ok () => $'$"> {!line_log}"'
                | Error () => $'$"\! {!line_log}"'
            ? trace'
            ?> trace Verbose (\ () => text) id
            |: text |> console.write_line
            ?= stdio ?|
            | Ok () => line
            | Error () => line |> highlight |> sm'.to_std_string
        | Error e =>
            trace Critical
                \ () => "runtime.stdio_line"
                \ () => { trace' e }
            e |> highlight |> sm'.to_std_string
    channel_sender
    |> threading.arc_mutex_lock
    |> resultm.unwrap'
    |> threading.mutex_guard_ref
    |> threading.channel_send line
    |> resultm.map_error'' sm'.format'

/// ### stdio_line_rust
:= stdio_line_rust
    (stdio : result () ())
    (trace' : bool)
    (line : resultm.result' sm'.std_string sm'.std_string)
    : sm'.std_string
    =
    := highlight text =
        $'$"\\u001b[4;7m{!text}\\u001b[0m"'
    ?= line |> resultm.unbox' ?|
    | Ok line =>
        := line_log = line |> rust.clone |> sm'.from_std_string
        := text =
            ?= stdio ?|
            | Ok () => $'$"> {!line_log}"'
            | Error () => $'$"\! {!line_log}"'
        ? trace'
        ?> trace Verbose (\ () => text) id
        |: text |> console.write_line
        ?= stdio ?|
        | Ok () => line
        | Error () => line |> highlight |> sm'.to_std_string
    | Error e =>
        trace Critical
            \ () => "runtime.stdio_line"
            \ () => { trace' e }
        e |> highlight |> sm'.to_std_string

/// ### command
:! command =
    `(
        rust.rust_type
            `($'clap_Command')
            `($'clap::Command')
            "type clap_Command = class end"
    )

/// ### new_command
:= new_command (s : rust.static_ref sm'.str) : command =
    !\\(s, $'"clap::Command::new($0)"')

///> rust -d clap
test new_command =
    ###"command"
    |> new_command
    |> sm'.format_pretty
    |> _assert sm'.contains "\"command\""

/// ### arg
:! arg =
