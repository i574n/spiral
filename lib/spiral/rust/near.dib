## near

#!markdown

### vector

#!spiral

type vector_switch t =
    {
        Gleam : $'near_sdk_store_vec_Vector<`t>'
        Lua : $'near_sdk_store_vec_Vector<`t>'
        Fsharp : $'near_sdk_store_vec_Vector<`t>'
        Python : $'near_sdk_store_vec_Vector<`t>'
        TypeScript : $'near_sdk_store_vec_Vector<`t>'
        Cpp : $'near_sdk_store_vec_Vector<`t>'
        CppHost : $'near_sdk_store_vec_Vector<`t>'
        Delphi : $'near_sdk_store_vec_Vector<`t>'
        Cuda : $'near_sdk_store_vec_Vector<`t>'
        Rust : $'SpiralNearVec<`t>'
    }
nominal vector t =
    `(
        global "#if FABLE_COMPILER\n[<Fable.Core.Erase; Fable.Core.Emit(\"near_sdk::store::vec::Vector<$0>\")>]\n#endif\ntype near_sdk_store_vec_Vector<'T> = class end"
        backend_switch `(()) `({}) {
            Rust = (fun () => global "#[cfg(target_arch = \"wasm32\")]\ntype SpiralNearVec<T> = near_sdk::store::vec::Vector<T>;\n#[cfg(not(target_arch = \"wasm32\"))]\nstruct SpiralNearVec<T>(std::vec::Vec<T>);\n#[cfg(not(target_arch = \"wasm32\"))]\nimpl<T> SpiralNearVec<T> {\n    fn len(&self) -> usize { self.0.len() }\n    fn extend<I: IntoIterator<Item = T>>(&mut self, iter: I) { self.0.extend(iter); }\n    fn drain(&mut self, range: std::ops::Range<u32>) -> std::vec::Drain<'_, T> {\n        self.0.drain((range.start as usize)..(range.end as usize))\n    }\n    fn iter(&self) -> std::slice::Iter<'_, T> { self.0.iter() }\n}\n") : () -> ()
            Gleam = (fun () => ()) : () -> ()
            Lua = (fun () => ()) : () -> ()
            Fsharp = (fun () => ()) : () -> ()
            Python = (fun () => ()) : () -> ()
            TypeScript = (fun () => ()) : () -> ()
            Cpp = (fun () => ()) : () -> ()
            CppHost = (fun () => ()) : () -> ()
            Delphi = (fun () => ()) : () -> ()
            Cuda = (fun () => ()) : () -> ()
        }
        $'' : $'backend_switch `(vector_switch t)'
    )

