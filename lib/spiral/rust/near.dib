### as_yoctonear

#!spiral

inl as_yoctonear forall t. (gas : t) : rust.u128 =
    inl fable () : rust.u128 =
        !\\(gas, $'"$0.as_yoctonear()"')
    backend_switch {
        Gleam = fun () => fable ()
        Lua = fun () => fable ()
        Fsharp = fun () => fable ()
        Python = fun () => fable ()
        TypeScript = fun () => fable ()
        Cpp = fun () => fable ()
        CppHost = fun () => fable ()
        Delphi = fun () => fable ()
        Cuda = fun () => fable ()
        Rust = fun () => $'(!gas)' : rust.u128
    }

#!markdown

### near_price_in_usd

#!spiral

inl near_price_in_usd () =
    6.68f64

#!markdown

### gas_to_usd

#!spiral

inl gas_to_usd (gas : u64) =
    (gas |> convert.f64) / 10_000_000_000_000_000 * near_price_in_usd ()

#!markdown

### tokens_to_usd

#!spiral

inl tokens_to_usd (tokens : rust.u128) =
    (tokens |> rust.f64) / 1_000_000_000_000_000_000_000_000 * near_price_in_usd ()
