### new_lookup_map

#!spiral

inl new_lookup_map prefix =
    !\($'"near_sdk::store::LookupMap::new(!prefix)"')

#!markdown

### new_iterable_set

#!spiral

inl new_iterable_set prefix =
    !\($'"near_sdk::store::IterableSet::new(!prefix)"')

#!markdown

### new_vector

#!spiral

inl new_vector (prefix : rust.ref (am'.slice u8)) : vector u8 =
    inl fable () : vector u8 =
        !\\(prefix, $'"near_sdk::store::vec::Vector::new($0)"')
    backend_switch {
        Gleam = fun () => fable ()
        Lua = fun () => fable ()
        Fsharp = fun () => fable ()
        Python = fun () => fable ()
        TypeScript = fun () => fable ()
        Cpp = fun () => fable ()
        CppHost = fun () => fable ()
        Delphi = fun () => fable ()
        Cuda = fun () => fable ()
        Rust = fun () => $'{ \#[cfg(target_arch = "wasm32")] let v = near_sdk::store::vec::Vector::new(!prefix); \#[cfg(not(target_arch = "wasm32"))] let v = SpiralNearVec(<std::vec::Vec<u8>>::new()); v }' : vector u8
    }

#!markdown

### vector_extend

#!spiral

inl vector_extend forall t. (vec : am'.vec t) (vector : rust.ref (rust.mut' (vector t))) : () =
    inl fable () : () =
        (!\\(vec, $'"true; !vector.extend($0); //"') : bool) |> ignore
    backend_switch {
        Gleam = fun () => fable ()
        Lua = fun () => fable ()
        Fsharp = fun () => fable ()
        Python = fun () => fable ()
        TypeScript = fun () => fable ()
        Cpp = fun () => fable ()
        CppHost = fun () => fable ()
        Delphi = fun () => fable ()
        Cuda = fun () => fable ()
        Rust = fun () => $'{ (!vector).extend((!vec).clone()); }' : ()
    }

#!markdown

### vector_to_vec

#!spiral

inl vector_to_vec forall (t : * -> *) u. (vector : t (vector u)) : am'.vec u =
    inl fable () : am'.vec u =
        !\($'$"!vector.iter().map(|x| *x).collect::<Vec<_>>()"')
    backend_switch {
        Gleam = fun () => fable ()
        Lua = fun () => fable ()
        Fsharp = fun () => fable ()
        Python = fun () => fable ()
        TypeScript = fun () => fable ()
        Cpp = fun () => fable ()
        CppHost = fun () => fable ()
        Delphi = fun () => fable ()
        Cuda = fun () => fable ()
        Rust = fun () => $'(!vector).iter().cloned().collect::<std::vec::Vec<_>>()' : am'.vec u
    }

