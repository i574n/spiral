### vector

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"type vector_switch t =\n    {\n        Gleam : $'near_sdk_store_vec_Vector<`t>'\n        Lua : $'near_sdk_store_vec_Vector<`t>'\n        Fsharp : $'near_sdk_store_vec_Vector<`t>'\n        Python : $'near_sdk_store_vec_Vector<`t>'\n        TypeScript : $'near_sdk_store_vec_Vector<`t>'\n        Cpp : $'near_sdk_store_vec_Vector<`t>'\n        CppHost : $'near_sdk_store_vec_Vector<`t>'\n        Delphi : $'near_sdk_store_vec_Vector<`t>'\n        Cuda : $'near_sdk_store_vec_Vector<`t>'\n        Rust : $'SpiralNearVec<`t>'\n    }\nnominal vector t =\n    `(\n        fsharp_global \"type near_sdk_store_vec_Vector<'T> = class end\"\n        backend_switch `(()) `({}) {\n            Rust = (fun () => global \"#[cfg(target_arch = \\\"wasm32\\\")]\\ntype SpiralNearVec<T> = near_sdk::store::vec::Vector<T>;\\n#[cfg(not(target_arch = \\\"wasm32\\\"))]\\nstruct SpiralNearVec<T>(std::vec::Vec<T>);\\n#[cfg(not(target_arch = \\\"wasm32\\\"))]\\nimpl<T> SpiralNearVec<T> {\\n    fn len(&self) -> usize { self.0.len() }\\n    fn extend<I: IntoIterator<Item = T>>(&mut self, iter: I) { self.0.extend(iter); }\\n    fn drain(&mut self, range: std::ops::Range<u32>) -> std::vec::Drain<'_, T> {\\n        self.0.drain((range.start as usize)..(range.end as usize))\\n    }\\n    fn iter(&self) -> std::slice::Iter<'_, T> { self.0.iter() }\\n}\\n\") : () -> ()\n            Gleam = (fun () => ()) : () -> ()\n            Lua = (fun () => ()) : () -> ()\n            Fsharp = (fun () => ()) : () -> ()\n            Python = (fun () => ()) : () -> ()\n            TypeScript = (fun () => ()) : () -> ()\n            Cpp = (fun () => ()) : () -> ()\n            CppHost = (fun () => ()) : () -> ()\n            Delphi = (fun () => ()) : () -> ()\n            Cuda = (fun () => ()) : () -> ()\n        }\n        $'' : $'backend_switch `(vector_switch t)'\n    )","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  type vector_switch t =
      {
          Gleam : $'near_sdk_store_vec_Vector<`t>'
          Lua : $'near_sdk_store_vec_Vector<`t>'
          Fsharp : $'near_sdk_store_vec_Vector<`t>'
          Python : $'near_sdk_store_vec_Vector<`t>'
          TypeScript : $'near_sdk_store_vec_Vector<`t>'
          Cpp : $'near_sdk_store_vec_Vector<`t>'
          CppHost : $'near_sdk_store_vec_Vector<`t>'
          Delphi : $'near_sdk_store_vec_Vector<`t>'
          Cuda : $'near_sdk_store_vec_Vector<`t>'
          Rust : $'SpiralNearVec<`t>'
      }
  nominal vector t =
      `(
          fsharp_global "type near_sdk_store_vec_Vector<'T> = class end"
          backend_switch `(()) `({}) {
              Rust = (fun () => global "#[cfg(target_arch = \"wasm32\")]\ntype SpiralNearVec<T> = near_sdk::store::vec::Vector<T>;\n#[cfg(not(target_arch = \"wasm32\"))]\nstruct SpiralNearVec<T>(std::vec::Vec<T>);\n#[cfg(not(target_arch = \"wasm32\"))]\nimpl<T> SpiralNearVec<T> {\n    fn len(&self) -> usize { self.0.len() }\n    fn extend<I: IntoIterator<Item = T>>(&mut self, iter: I) { self.0.extend(iter); }\n    fn drain(&mut self, range: std::ops::Range<u32>) -> std::vec::Drain<'_, T> {\n        self.0.drain((range.start as usize)..(range.end as usize))\n    }\n    fn iter(&self) -> std::slice::Iter<'_, T> { self.0.iter() }\n}\n") : () -> ()
              Gleam = (fun () => ()) : () -> ()
              Lua = (fun () => ()) : () -> ()
              Fsharp = (fun () => ()) : () -> ()
              Python = (fun () => ()) : () -> ()
              TypeScript = (fun () => ()) : () -> ()
              Cpp = (fun () => ()) : () -> ()
              CppHost = (fun () => ()) : () -> ()
              Delphi = (fun () => ()) : () -> ()
              Cuda = (fun () => ()) : () -> ()
          }
          $'' : $'backend_switch `(vector_switch t)'
      )
  """,
  timeout: 300_000
)
```

