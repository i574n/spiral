### emit_expr

#!spiral

inl emit_expr forall a t. (args : a) (code : string) : t =
    $'Fable.Core.RustInterop.emitRustExpr !args !code '

#!markdown

### (~!\\)

#!spiral

inl (~!\) forall t. (code : string) : t =
    emit_expr () code

#!markdown

### (~!\\\\)

#!spiral

inl (~!\\) forall t u. ((args : t), (code : string)) : u =
    emit_expr args code

