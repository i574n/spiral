### fix_closure'

#!spiral

inl fix_closure' forall t. (depth : u8 * u8) (x : t) : string =
    inl rec 루프 forall u {number}. (text : string) (acc : string) (n : u) : string =
        if n <= 0
        then acc
        else 루프 text (acc +. text) (n - 1)
    inl a = depth |> fst |> 루프 "}" ""
    inl b = depth |> snd |> 루프 "{" ""
    inl is_unit : bool =
        real
            typecase t with
            | () => true
            | _ => false
    $'let x = !x //' : ()
    inl x : infer = $'x'
    inl result' : unit = $'()'
    run_target_args (fun () => x) function
        | Rust _ | RustNative => fun x =>
            if is_unit
            then false
            else
                (!\\(x, $'$"true; let _fix_closure_!result' = $0"') : bool) |> ignore
                true
        | _ => fun x' => false
    |> ignore
    $'$"true; _fix_closure_!result' " + !a + "); " + !b + " // rust.fix_closure\'"'

#!spiral

///- --test --print-code

fix_closure' (3, 2) 0i32
|> _assert_eq "true; _fix_closure_v9 }}}); {{ // rust.fix_closure'"

#!spiral

///- --test --print-code

fix_closure' (0, 0) ()
|> _assert_eq "true; _fix_closure_v1 );  // rust.fix_closure'"

#!markdown

### fix_closure

#!spiral

inl fix_closure forall t. depth (x : t) =
    inl fable () =
        inl code = fix_closure' depth x
        (!\code : bool) |> ignore
    backend_switch {
        Gleam = fable
        Lua = fable
        Fsharp = fable
        Python = fable
        Cpp = fable
        CppHost = fable
        Delphi = fable
        Cuda = fable
        TypeScript = fable
        Rust = fun () =>
            // Native Rust emits the caller's statements flat, in the block that opened the closure
            // (`attach(|py| { //`, `spawn(|| { //`, `Box::pin(async { /*`): one `}` and one `)` close it, whatever
            // `depth` Fable's nesting needed. The text must be a literal (codegenRust inlines literal emits only).
            // `(!x)` (not a `$0` argument, which is only the first variable of a tuple) returns a tuple whole.
            inl is_unit : bool =
                real
                    typecase t with
                    | () => true
                    | _ => false
            if is_unit
            then (!\($'"true; () }); //"') : bool) |> ignore
            else ($'true; (!x) }); //' : bool) |> ignore
    }

