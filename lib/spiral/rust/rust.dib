#!markdown

### is_native

#!spiral

// True only in the native Rust backend (codegenRust). Partial evaluation runs every arm of a value-level
// backend_switch in every build, so a switch whose arms inline the caller's closures (`Fsharp = fable; Lua = fable;
// ...`) evaluates them once per key, and nested switches multiply (8 keys, 8^depth: dice_ui never finished). This
// switch's arms are literals, so the `if is_native () then native else fable ()` that uses it evaluates one branch.
inl is_native () : bool =
    backend_switch {
        Gleam = fun () => false
        Lua = fun () => false
        Fsharp = fun () => false
        Python = fun () => false
        TypeScript = fun () => false
        Cpp = fun () => false
        CppHost = fun () => false
        Delphi = fun () => false
        Cuda = fun () => false
        Rust = fun () => true
    }

#!markdown

### one_param_fn

#!spiral

// Native Rust: a Spiral closure over a tuple takes its fields as separate Rust parameters, while the closures that
// Rust iterators and Option call pass one value (`|x| f(x)`). The wrapper takes the value as one Rust parameter (a
// macro type spelling the Rust type of `t`) and unpacks it in Spiral; other types pass through unchanged.
nominal one_param t = $'(`t)'
inl one_param_fn forall t u. (fn : t -> u) : one_param t -> u =
    fun (x : one_param t) =>
        inl x : t = $'(!x)'
        fn x

