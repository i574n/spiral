### func1_move

#!spiral

inl func1_move forall t u. (x : t) (fn : func1 t u) : u =
    inl fable () : u =
        inl fn = join fn
        inl is_unit : bool =
            real
                typecase t with
                | () => true
                | _ => false
        inl result =
            if is_unit
            then !\($'"(move || !fn())()"') : u
            else
                $'let func1_move_x = !x //' : ()
                inl func1_move_x : infer = $'func1_move_x'
                !\\(func1_move_x, $'"(move |x| !fn(x))($0)"') : u
        result
    if is_native ()
    then
        // Natively `func1 t u` is Spiral's `t -> u` closure: coerce it back and let Spiral make the call.
        inl fn : t -> u = $'!fn.clone()'
        fn x
    else fable ()

