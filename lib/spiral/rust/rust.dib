### send

#!spiral

nominal send_fable t =
    `(
        backend_switch `(()) `({}) {
            Fsharp = (fun () => global "#if FABLE_COMPILER\n[<Fable.Core.Erase; Fable.Core.Emit(\"Send\")>]\n#endif\ntype Send<'T> = class end") : () -> ()
            Rust = (fun () => global "#if FABLE_COMPILER\n[<Fable.Core.Erase; Fable.Core.Emit(\"Send\")>]\n#endif\ntype Send<'T> = class end") : () -> ()
        }
        $'' : lifetime_join t $'Send<`t>'
    )
// Native Rust values are Rc-based and never Send: the bound is dropped (code that must cross threads moves plain data
// instead, as runtime.execute_with_options's native arm does).
type send_switch t =
    {
        Fsharp : send_fable t
        Rust : t
    }
nominal send t = $'backend_switch `(send_switch t)'

