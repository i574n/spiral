#!markdown

### clone_native

#!spiral

inl clone_native forall t. (x : t) : t =
    // Native Rust only (other backends: `x` itself, no code): a copy for a macro that consumes its argument
    // (`self` methods, `match`) when the value is used again.
    backend_switch {
        Gleam = fun () => x
        Lua = fun () => x
        Fsharp = fun () => x
        Python = fun () => x
        TypeScript = fun () => x
        Cpp = fun () => x
        CppHost = fun () => x
        Delphi = fun () => x
        Cuda = fun () => x
        Rust = fun () => clone x
    }

