#!markdown

### len

#!spiral

inl len forall t u {uint; int}. (x : t) : u =
    inl fable () : u =
        !\($'$"!x.len()"')
    backend_switch {
        Gleam = fun () => fable ()
        Lua = fun () => fable ()
        Fsharp = fun () => fable ()
        Python = fun () => fable ()
        TypeScript = fun () => fable ()
        Cpp = fun () => fable ()
        CppHost = fun () => fable ()
        Delphi = fun () => fable ()
        Cuda = fun () => fable ()
        Rust = fun () => $'((!x).len() as `u)' : u
    }

#!markdown

### len'

#!spiral

inl len' forall t u {uint; int}. (x : t) : u =
    !\\(x, $'$"$0.len()"')

