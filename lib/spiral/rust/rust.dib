#!markdown

### func0

#!spiral

// Fable's `Func0<T>`/`Func1<A, B>` wrappers; native Rust uses Spiral's own closure type (`Rc<dyn Fn(..) -> ..>`, a
// tuple argument spread into parameters), so the helpers below are coercions there.
nominal func0_fable t =
    `(
        backend_switch `(()) `({}) {
            Fsharp = (fun () => global "#if FABLE_COMPILER\n[<Fable.Core.Erase; Fable.Core.Emit(\"Func0<$0>\")>]\n#endif\ntype Func0<'T> = class end") : () -> ()
            Rust = (fun () => global "#if FABLE_COMPILER\n[<Fable.Core.Erase; Fable.Core.Emit(\"Func0<$0>\")>]\n#endif\ntype Func0<'T> = class end") : () -> ()
        }
        $'' : $'Func0<`t>'
    )
type func0_switch t =
    {
        Fsharp : func0_fable t
        Rust : () -> t
    }
nominal func0 t = $'backend_switch `(func0_switch t)'

#!markdown

### func1

#!spiral

nominal func1_fable t u =
    `(
        backend_switch `(()) `({}) {
            Fsharp = (fun () => global "#if FABLE_COMPILER\n[<Fable.Core.Erase; Fable.Core.Emit(\"Func1<$0, $1>\")>]\n#endif\ntype Func0<'T, 'U> = class end") : () -> ()
            Rust = (fun () => global "#if FABLE_COMPILER\n[<Fable.Core.Erase; Fable.Core.Emit(\"Func1<$0, $1>\")>]\n#endif\ntype Func0<'T, 'U> = class end") : () -> ()
        }
        $'' : $'Func0<`t, `u>'
    )
type func1_switch t u =
    {
        Fsharp : func1_fable t u
        Rust : t -> u
    }
nominal func1 t u =
    `(
        typecase t with
        | () => `func0 `u
        | _ => $'' : $'backend_switch `(func1_switch t u)'
    )

