/// ### ref
nominal ref t =
    `(
        rust_type
            `($'Ref<`t>')
            `($'&`(t)')
            "type Ref<'T> = 'T"
    )

/// ### static_ref
nominal static_ref t = ref (lifetime static_lifetime t)

