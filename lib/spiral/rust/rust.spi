/// # rust

/// ## rust

/// ### any_base
type any_base = any

/// ### any
nominal any =
    `(
        rust_type
            `($'core_any_Any')
            `($'core::any::Any')
            "type core_any_Any = obj"
    )

/// ### try
nominal try t =
    `(
        rust_type
            `($'core_ops_Try<`t>')
            `($'_')
            "type core_ops_Try<'T> = class end"
    )

/// ### cow
nominal cow t =
    `(
        rust_type
            `($'std_borrow_Cow<`t>')
            `($'std::borrow::Cow<`t>')
            "type std_borrow_Cow<'T> = class end"
    )

