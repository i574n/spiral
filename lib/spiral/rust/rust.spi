/// ### lifetime_join
nominal lifetime_join t u =
    `(
        rust_type
            `($'LifetimeJoin<`t, `u>')
            `($'`t + `(u)')
            "type LifetimeJoin<'T, 'U> = class end"
    )

/// ### lifetime
nominal lifetime t u =
    `(
        rust_type
            `($'Lifetime<`t, `u>')
            `($'`t `(u)')
            "type Lifetime<'T, 'U> = class end"
    )

/// ### static_lifetime
nominal static_lifetime =
