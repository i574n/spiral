/// ### send
// Rust values are Rc-based and never Send: the bound is dropped (code that must cross threads moves plain data
// instead, as runtime.execute_with_options's Rust arm does). A nominal (not `type send t = t`): threading passes `send` as a type constructor, and an identity
// type-level lambda crashes the single-flight compiler's fill (TyInl(t, TyVar t)). The macro interpolates `(t): a bare backtick-t before the closing quote would lex as the type
// variable t'.
nominal send t = $'`(t)'

/// ### emit_expr
inl emit_expr forall a t. (args : a) (code : string) : t =
    $'__spiral_emit_rust !args !code '

/// ### (~!\\)
inl (~!\) forall t. (code : string) : t =
    emit_expr () code

/// ### (~!\\\\)
inl (~!\\) forall t u. ((args : t), (code : string)) : u =
    emit_expr args code

/// ### ptr
nominal ptr t =
    `(
        rust_type
            `($'Ptr<`t>')
            `($'*const `(t)')
            "type Ptr<'T> = class end"
    )

/// ### ptr_read
inl ptr_read forall t. (x : ptr t) : t =
    !\\(x, $'"std::ptr::read($0)"')

/// ### u128
nominal u128 =
    `(
        rust_type
            `($'u128')
            `($'u128')
            "type u128 = class end"
    )

inl u128 forall t. (x : t) : u128 =
    !\\(x, $'"$0 as u128"')

/// ### f64
inl f64 forall t. (x : t) : f64 =
    !\\(x, $'"$0 as f64"')

/// ### unwrap_0
inl unwrap_0 forall (t : * -> *) u. (x : t u) : u =
    !\\(x, $'"$0.0"')

/// ### unwrap_0_ref
inl unwrap_0_ref forall (t : * -> *) u. (x : ref (t u)) : ref u =
    !\\(x, $'"&$0.0"')

/// ### len
inl len forall t u {uint; int}. (x : t) : u =
    backend_switch {
        Rust = fun () => $'((!x).len() as `u)' : u
    }

/// ### len'
inl len' forall t u {uint; int}. (x : t) : u =
    !\\(x, $'$"$0.len()"')

/// ### emit
inl emit forall t. (x : t) : t =
    !\\(x, $'"$0"')

/// ### emit'
inl emit' forall t. (x : t) : t =
    (!\\(x, $'$"true; let !x = $0"') : bool) |> ignore
    x

/// ### clone
inl clone forall t. (x : t) : t =
    !\\(x, $'"$0.clone()"')

/// ### clone_rust
inl clone_rust forall t. (x : t) : t =
    // Rust only (other backends: `x` itself, no code): a copy for a macro that consumes its argument
    // (`self` methods, `match`) when the value is used again.
    backend_switch {
        Gleam = fun () => x
        Lua = fun () => x
        Fsharp = fun () => x
        Python = fun () => x
        TypeScript = fun () => x
        Cpp = fun () => x
        CppHost = fun () => x
        Delphi = fun () => x
        Cuda = fun () => x
        Rust = fun () => clone x
    }

/// ### dbg
inl dbg forall t. (x : t) : t =
    !\\(x, $'"dbg\!($0)"')

/// ### new_box
inl new_box forall t. (x : t) : box t =
    !\\(x, $'"Box::new($0)"')

/// ### new_rc
inl new_rc forall t. (x : t) : rc t =
    !\\(x, $'"std::rc::Rc::new($0)"')

/// ### rc_clone
inl rc_clone forall t. (x : rc t) : rc t =
    !\\(x, $'"std::rc::Rc::clone(&$0)"')

/// ### rc_unwrap_or_clone
inl rc_unwrap_or_clone forall t. (x : rc t) : t =
    !\\(x, $'"std::rc::Rc::unwrap_or_clone($0)"')

/// ### rc_downgrade
inl rc_downgrade forall t. (x : rc t) : weak_rc t =
    !\\(x, $'"std::rc::Rc::downgrade(&$0)"')

/// ### new_ref_cell
inl new_ref_cell forall t. (x : t) : ref_cell t =
    !\($'"std::cell::RefCell::new(!x)"')

/// ### ref_cell_borrow
inl ref_cell_borrow forall t. (x : rc (ref_cell t)) : cell_ref t =
    !\\(x, $'"std::cell::RefCell::borrow(&std::rc::Rc::clone(&$0))"')

/// ### ref_cell_borrow_mut
inl ref_cell_borrow_mut forall t. (x : rc (ref_cell t)) : mut' t =
    !\\(x, $'"std::cell::RefCell::borrow_mut(&std::rc::Rc::clone(&$0))"')

/// ### ref_leak
inl ref_leak forall t. (x : cell_ref t) : ref t =
    !\\(x, $'"std::cell::Ref::leak($0)"')

/// ### to_mut
inl to_mut forall t. (x : t) : () =
    (!\($'"true; // 1"') : bool) |> ignore
    !\($'"let mut !x = !x"') : ()
    // (!\($'"true; !x"') : bool) |> ignore
    // !\($'"!x"')
    // inl result = !\($'"!x"') : mut' t
    // !\($'"!result"')
    // inl result = !\($'"*/ // a"') : mut' t
    // inl result = !\($'"!x"') : mut' t
    // result |> fun x => $'!x |> unbox // b'

/// ### to_ref
inl to_ref forall t. (x : t) : ref t =
    !\\(x, $'"&$0"')

/// ### to_ref_mut
inl to_ref_mut forall t. (x : t) : ref (mut' t) =
    backend_switch {
        Rust = fun () => !\\(x, $'"&mut $0"') : ref (mut' t)
    }

/// ### to_ref_mut'
inl to_ref_mut' forall t. (x : ref_mut (ref (mut' t))) : ref (mut' t) =
    x |> to_mut
    !\\(x, $'"&mut $0"')

/// ### ref_cell_borrow_mut'
inl ref_cell_borrow_mut' forall t. (x : rc (ref_cell (ref (mut' t)))) : ref (mut' t) =
    inl x = x |> rc_clone
    inl x : ref_mut (ref (mut' t)) = !\\(x, $'"std::cell::RefCell::borrow_mut(&$0)"')
    x |> to_ref_mut'

/// ### ref_map
inl ref_map forall t u. (fn : t -> u) (x : ref t) : ref u =
    !\($'"!fn(!x)"')

/// ### ref_eval
inl ref_eval forall t u. (fn : t -> u) (ref : ref t) : u =
    !\\(fn, $'"$0(!ref.clone())"')

/// ### cow_as_ref
inl cow_as_ref forall t. (s : cow t) : ref t =
    !\\(s, $'"$0.as_ref()"')

/// ### from_mut
inl from_mut forall t. (x : mut' t) : t =
    !\\(x, $'"$0"')

/// ### box_fn
inl box_fn forall t. (x : () -> ()) : box t =
    inl x = join x
    !\($'"Box::new(move || !x())"')

/// ### box_pin
inl box_pin forall t. (x : t) : pin (box t) =
    !\\(x, $'"Box::pin($0)"')

/// ### deref
inl deref forall t. (ref : ref t) : t =
    !\\(ref, $'"*$0"')

/// ### deref_mut
inl deref_mut forall t. (x : ref (mut' t)) : t =
    !\\(x, $'"*$0"')

/// ### clone_deref
inl clone_deref forall t. (ref : ref t) : t =
    !\\(ref, $'"$0.clone()"')

/// ### from_ref
inl from_ref forall t. (ref : ref t) : t =
    !\($'"!ref"')

/// ### from_ref_mut
inl from_ref_mut forall t. (ref : ref (mut' t)) : t =
    !\($'"!ref"')

/// ### reref
inl reref forall t (u : * -> *). (x : ref (u t)) : ref t =
    backend_switch {
        Rust = fun () => !\\(x, $'"&*$0"') : ref t
    }

/// ### into
inl into forall t u. (x : t) : u =
    !\($'"!x.into()"')

/// ### ops_deref
inl ops_deref forall t. (ref : t) : t =
    !\\(ref, $'"core::ops::Deref::deref(&$0)"')

/// ### one_param_fn
// Rust: a Spiral closure over a tuple takes its fields as separate Rust parameters, while the closures that
// Rust iterators and Option call pass one value (`|x| f(x)`). The wrapper takes the value as one Rust parameter (a
// macro type spelling the Rust type of `t`) and unpacks it in Spiral; other types pass through unchanged.
nominal one_param t = $'(`t)'
inl one_param_fn forall t u. (fn : t -> u) : one_param t -> u =
    fun (x : one_param t) =>
        inl x : t = $'(!x)'
        fn x

/// ### box_leak
inl box_leak forall t. (x : box t) : static_ref (mut' t) =
    !\\(x, $'"Box::leak($0)"')

/// ### drop
inl drop forall t. (x : t) : () =
    (!\\(x, $'"true; drop($0)"') : bool) |> ignore

/// ### break
inl break x : () =
    (!\($'"true; break !x"') : bool) |> ignore

/// ### fix_closure
inl fix_closure forall t. (depth : u8 * u8) (x : t) =
    backend_switch {
        Rust = fun () =>
            // Rust emits the caller's statements flat, in the block that opened the closure
            // (`attach(|py| { //`, `spawn(|| { //`, `Box::pin(async { /*`): one `}` and one `)` close it, whatever
            // `depth` says. The text must be a literal (codegenRust inlines literal emits only).
            // `(!x)` (not a `$0` argument, which is only the first variable of a tuple) returns a tuple whole.
            inl is_unit : bool =
                real
                    typecase t with
                    | () => true
                    | _ => false
            if is_unit
            then (!\($'"true; () }); //"') : bool) |> ignore
            else ($'true; (!x) }); //' : bool) |> ignore
    }

/// ### loop
inl loop (depth : i32) (fn : () -> ()) : () =
    (!\($'"true; loop { // rust.loop 1"') : bool) |> ignore
    fn ()

    listm.init depth id
    |> listm.iter fun n =>
        (!\($'"true; } // rust.loop 2 / n: {!n}"') : bool) |> ignore

    (!\($'"true; } // rust.loop 3"') : bool) |> ignore

    listm.init depth id
    |> listm.iter fun n =>
        (!\($'"true; { // rust.loop 4 / n: {!n}"') : bool) |> ignore

/// ### capture
inl capture forall t. (fn : () -> t) : t =
    (!\($'"true; let _capture = (|| { //"') : bool) |> ignore
    (!\\(fn (), $'"true; $0 })()"') : bool) |> ignore
    !\($'"_capture"')

/// ### capture_move
inl capture_move forall t. (fn : () -> t) : t =
    (!\($'"true; let _capture_move = (move || { //"') : bool) |> ignore
    (!\\(fn (), $'"true; $0 })()"') : bool) |> ignore
    !\($'"_capture_move"')

/// ### type_emit
nominal type_emit t =
    `(
        rust_type
            `($'TypeEmit<`t>')
            `($'*/ `t /*')
            "type TypeEmit<'T> = class end"
    )

/// ### partial_eq_wrapper
nominal partial_eq_wrapper t =
    `(
        rust_type
            `($'PartialEqWrapper<`t>')
            `($'PartialEqWrapper<`t>')
            "type PartialEqWrapper<'T> = class end"
    )

/// ### new_partial_eq_wrapper
inl new_partial_eq_wrapper forall t.
    (eq_fn : ref (partial_eq_wrapper t) -> ref (partial_eq_wrapper t) -> bool)
    (x : t)
    : partial_eq_wrapper t
    =
    // Rust: real top-level items (Rust-only globals, kept by codegenRust). `eq_fn` is not called: an `impl`
    // can't capture Spiral code, so the wrapper compares `Arc`s by pointer, which is what its only caller
    // (threading.new_partial_eq_wrapper_arc / partial_eq_wrapper_arc_eq) does. Other `t` get no PartialEq.
    global "#[derive(Debug, Clone)]\npub struct PartialEqWrapper<T>(pub T);\nimpl<T: ?Sized> PartialEq for PartialEqWrapper<std::sync::Arc<T>> {\n    fn eq(&self, other: &Self) -> bool { std::sync::Arc::ptr_eq(&self.0, &other.0) }\n}"
    $'PartialEqWrapper(!x.clone())' : partial_eq_wrapper t

/// ### concat
inl concat forall (t : * -> *) u. (x : t (t u)) : t u =
    backend_switch {
        Rust = fun () => $'(!x).concat()' : t u
    }
