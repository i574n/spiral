/// # rust/testing
test rust_testing static =
    :< testing

:< rust.rust_operators

/// ### run_tests'
:= run_tests' tests =
    := fields = reflection.get_record_fields tests
    ? is_rust () ?>
        global (
            "thread_local! { static SPIRAL_TEST: std::cell::RefCell<Option<&'static str>> = const { "
            ^^ "std::cell::RefCell::new(None) }; }"
        )
    fields
    |> listm.iter \ name, (fn : string -> ()) =>
        := (++) (a : string) (b : string) : string = a ^^ b
        ? is_rust () ?>
            global (
                "#[test] fn "
                ++ name
                ++ (
                    "() { std::thread::Builder::new().stack_size(1 << 30).spawn(|| { SPIRAL_TEST.with(|t| "
                    ^^ "*t.borrow_mut() = Some(\""
                )
                ++ name
                ++ "\")); spiral_main() }).unwrap().join().unwrap(); }"
            )
        ? $'SPIRAL_TEST.with(|t| t.borrow().map_or(false, |s| s == (&*!name)))' ?>
            fn name

test run_tests static =
    := run test =
        ? env.get_environment_variable "TEST" = "1" ?>
            ? is_rust () ?> test () |: ()
        |:
            runtime.execution_options \ x => { x ?|
                command = "cargo +nightly-2026-10-18 test --timings -- --show-output"
                working_directory = file_system.get_source_directory () |> Some |> optionm'.box
                environment_variables = am'.base ;[ "TEST", "1" ]
            }
            |> runtime.execute_with_options
            |> \ exit_code, result =>
                exit_code |> _assert_eq 0i32
                result |> _assert sm'.contains "test result: ok. 1 passed; 0 failed; 0 ignored;"

        ? is_rust () |> not ?>
            $'let tests () = !test ()' : ()

///> rust -d encoding_rs encoding_rs_io
test run_tests_2 =
    \ () =>
        run_tests' {
            a = _assert_eq "a"
        }
    |> run

/// ### run_tests
:= run_tests tests : () =
    ~>
        := tests =
            real_core.record_map
                \ { key value } =>
                    (\ _ => value ()) : string -> ()
                tests
        run_tests' `(`tests) tests

///> rust -d encoding_rs encoding_rs_io
test run_tests_3 =
    \ () =>
        run_tests {
            a = \ () => "a" |> _assert_eq "a"
        }
    |> run

/// ### run_tests_log
:= run_tests_log tests : () =
    ~>
        := tests =
            real_core.record_map
                \ { key value } =>
                    (\ _ => value !-) : () -> ()
                tests
        run_tests `(`tests) tests

///> rust -d encoding_rs encoding_rs_io
test run_tests_log =
    \ () =>
        run_tests_log {
            a = _assert_eq !-
        }
    |> run
