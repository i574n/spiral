<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":":< rust_operators\n\n:= run_tests' tests =\n    := fields = reflection::get_record_fields tests\n    ? is_rust () ?>\n        global (\n            \"thread_local! { static SPIRAL_TEST: std::cell::RefCell<Option<&'static str>> = const { \"\n            ^^ \"std::cell::RefCell::new(None) }; }\"\n        )\n    fields\n    |> listm::iter \\ name, (fn : string -> ()) =>\n        := (++) (a : string) (b : string) : string = a ^^ b\n        ? is_rust () ?>\n            global (\n                \"#[test] fn \"\n                ++ name\n                ++ (\n                    \"() { std::thread::Builder::new().stack_size(1 << 30).spawn(|| { SPIRAL_TEST.with(|t| \"\n                    ^^ \"*t.borrow_mut() = Some(\\\"\"\n                )\n                ++ name\n                ++ \"\\\")); spiral_main() }).unwrap().join().unwrap(); }\"\n            )\n        ? $'SPIRAL_TEST.with(|t| t.borrow().map_or(false, |s| s == (&*!name)))' ?>\n            fn name","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  :< rust_operators

  := run_tests' tests =
      := fields = reflection::get_record_fields tests
      ? is_rust () ?>
          global (
              "thread_local! { static SPIRAL_TEST: std::cell::RefCell<Option<&'static str>> = const { "
              ^^ "std::cell::RefCell::new(None) }; }"
          )
      fields
      |> listm::iter \ name, (fn : string -> ()) =>
          := (++) (a : string) (b : string) : string = a ^^ b
          ? is_rust () ?>
              global (
                  "#[test] fn "
                  ++ name
                  ++ (
                      "() { std::thread::Builder::new().stack_size(1 << 30).spawn(|| { SPIRAL_TEST.with(|t| "
                      ^^ "*t.borrow_mut() = Some(\""
                  )
                  ++ name
                  ++ "\")); spiral_main() }).unwrap().join().unwrap(); }"
              )
          ? $'SPIRAL_TEST.with(|t| t.borrow().map_or(false, |s| s == (&*!name)))' ?>
              fn name
  """,
  timeout: 300_000
)
```

#### run_tests (test)

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":"///- --test static --symbol\n\n:= run test =\n    ? env::get_environment_variable \"TEST\" = \"1\" ?>\n        ? is_rust () ?> test () |: ()\n    |:\n        process::execution_options \\ x => { x ?|\n            command = \"cargo +nightly-2026-10-18 test --timings -- --show-output\"\n            working_directory = file_system::get_source_directory () |> Some |> optionm'::box\n            environment_variables = am'::base ;[ \"TEST\", \"1\" ]\n        }\n        |> process::execute_with_options\n        |> \\ exit_code, result =>\n            exit_code |> _assert_eq 0i32\n            result |> _assert sm'::contains \"test result: ok. 1 passed; 0 failed; 0 ignored;\"\n\n    ? is_rust () |> not ?>\n        $'let tests () = !test ()' : ()","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  ///- --test static --symbol

  := run test =
      ? env::get_environment_variable "TEST" = "1" ?>
          ? is_rust () ?> test () |: ()
      |:
          process::execution_options \ x => { x ?|
              command = "cargo +nightly-2026-10-18 test --timings -- --show-output"
              working_directory = file_system::get_source_directory () |> Some |> optionm'::box
              environment_variables = am'::base ;[ "TEST", "1" ]
          }
          |> process::execute_with_options
          |> \ exit_code, result =>
              exit_code |> _assert_eq 0i32
              result |> _assert sm'::contains "test result: ok. 1 passed; 0 failed; 0 ignored;"

      ? is_rust () |> not ?>
          $'let tests () = !test ()' : ()
  """,
  timeout: 300_000
)
```

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":"///- --test --symbol\n///> rust -d encoding_rs encoding_rs_io\n\n\\ () =>\n    run_tests' {\n        a = _assert_eq \"a\"\n    }\n|> run","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  ///- --test --symbol
  ///> rust -d encoding_rs encoding_rs_io

  \ () =>
      run_tests' {
          a = _assert_eq "a"
      }
  |> run
  """,
  timeout: 300_000
)
```

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":":= run_tests tests : () =\n    ~>\n        := tests =\n            real_core::record_map\n                \\ { key value } =>\n                    (\\ _ => value ()) : string -> ()\n                tests\n        run_tests' `(`tests) tests","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  := run_tests tests : () =
      ~>
          := tests =
              real_core::record_map
                  \ { key value } =>
                      (\ _ => value ()) : string -> ()
                  tests
          run_tests' `(`tests) tests
  """,
  timeout: 300_000
)
```

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":"///- --test --symbol\n///> rust -d encoding_rs encoding_rs_io\n\n\\ () =>\n    run_tests {\n        a = \\ () => \"a\" |> _assert_eq \"a\"\n    }\n|> run","print_code":false},"livebook_object":"smart_cell"} -->

