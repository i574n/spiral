<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":":= run_tests_log tests : () =\n    ~>\n        := tests =\n            real_core::record_map\n                \\ { key value } =>\n                    (\\ _ => value !-) : () -> ()\n                tests\n        run_tests `(`tests) tests","print_code":false},"livebook_object":"smart_cell"} -->

