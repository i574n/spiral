///- --package .
open sm'_operators
open xml

union severity =
    | Fatal
    | Warning
    | Information

type assertion =
    {
        id : string
        severity : severity
        reports : bool
        test : xpath.xpath
        source : string
        message : string
    }

type rule = { context : xpath.xpath; context_source : string; assertions : list assertion }

type pattern = { id : string; rules : list rule }

inl attribute_or (key : string) (attributes : list (string * string)) : string =
    match xml.attribute_of key attributes with
    | Some value => value
    | None => ""

inl severity_of (flag : string) : severity =
    if flag = "fatal" || flag = "error" then Fatal elif flag = "warning" then Warning else Information

inl is_assertion (name : string) : bool = local_name name = "assert" || local_name name = "report"

let rec assertions_in (nodes : list xml_node) (acc : list assertion) : list assertion =
    match nodes with
    | Cons (XmlElement (name, attributes, children), rest) when is_assertion name =>
        inl source = attribute_or "test" attributes
        inl assertion =
            {
                id = attribute_or "id" attributes
                severity = severity_of (attribute_or "flag" attributes)
                reports = xml.local_name name = "report"
                test = xpath.lift_code_lists (xpath.parse source)
                source = source
                message = sm'.trim (xml.text_in children)
            }
        assertions_in rest (Cons (assertion, acc))
    | Cons (_, rest) => assertions_in rest acc
    | Nil => listm.rev acc

let rec rules_in (nodes : list xml_node) (acc : list rule) : list rule =
    match nodes with
    | Cons (XmlElement (name, attributes, children), rest) when xml.local_name name = "rule" =>
        inl source = attribute_or "context" attributes
        inl parsed = { context = xpath.parse source; context_source = source; assertions = assertions_in children Nil }
        rules_in rest (Cons (parsed, acc))
    | Cons (_, rest) => rules_in rest acc
    | Nil => listm.rev acc

let rec patterns_in (nodes : list xml_node) (acc : list pattern) : list pattern =
    match nodes with
    | Cons (XmlElement (name, attributes, children), rest) when xml.local_name name = "pattern" =>
        patterns_in rest (Cons ({ id = attribute_or "id" attributes; rules = rules_in children Nil }, acc))
    | Cons (_, rest) => patterns_in rest acc
    | Nil => listm.rev acc

inl read_schematron (text : string) : list pattern =
    match xml.single_root (xml.read_xml text) with
    | Some root => patterns_in root.children Nil
    | None => Nil

type census = { rules : i32; assertions : i32; fatal : i32; invalid : i32; members : i32 }

inl empty_census () : census = { rules = 0i32; assertions = 0i32; fatal = 0i32; invalid = 0i32; members = 0i32 }

let rec assertions_census (assertions : list assertion) (acc : census) : census =
    match assertions with
    | Cons (a, rest) =>
        inl fatal = match a.severity with Fatal => 1i32 | _ => 0i32
        inl invalid = xpath.invalid_count a.test
        inl acc = { acc with assertions = acc.assertions + 1i32; fatal = acc.fatal + fatal }
        inl acc = { acc with invalid = acc.invalid + invalid; members = acc.members + xpath.member_count a.test }
        assertions_census rest acc
    | Nil => acc

let rec rules_census (rules : list rule) (acc : census) : census =
    match rules with
    | Cons (r, rest) =>
        inl acc = { acc with rules = acc.rules + 1i32; invalid = acc.invalid + xpath.invalid_count r.context }
        rules_census rest (assertions_census r.assertions acc)
    | Nil => acc

let rec schematron_census (patterns : list pattern) (acc : census) : census =
    match patterns with
    | Cons (p, rest) => schematron_census rest (rules_census p.rules acc)
    | Nil => acc
///> rust
test reads_rules_and_typed_assertions =
    inl source =
        "<schema xmlns=\"http://purl.oclc.org/dsdl/schematron\" queryBinding=\"xslt2\"><pattern id=\"model\">"
        ++# "<rule context=\"cac:InvoiceLine\">"
        ++# "<assert id=\"BR-21\" flag=\"fatal\" test=\"exists(cbc:ID)\">[BR-21] line id</assert>"
        ++# "<assert id=\"BR-X\" flag=\"warning\" test=\"cbc:Note != ''\">note</assert></rule></pattern></schema>"
    match read_schematron source with
    | Cons (p, Nil) =>
        if p.id <> "model" then failwith "pattern id"
        match p.rules with
        | Cons (r, Nil) =>
            if xpath.xpath_text r.context <> "(child::cac:InvoiceLine .)" then failwith "rule context"
            match r.assertions with
            | Cons (first, Cons (second, Nil)) =>
                if first.id <> "BR-21" || first.message <> "[BR-21] line id" then failwith "first assertion"
                if xpath.xpath_text first.test <> "(exists (child::cbc:ID .))" then failwith "parsed test"
                match second.severity with Warning => () | _ => failwith "warning flag"
            | _ => failwith "two assertions"
        | _ => failwith "one rule"
    | _ => failwith "one pattern"
    inl totals = schematron_census (read_schematron source) (empty_census ())
    if totals.rules <> 1i32 || totals.assertions <> 2i32 then failwith "census counts"
    if totals.fatal <> 1i32 || totals.invalid <> 0i32 then failwith "census fatal and invalid"
