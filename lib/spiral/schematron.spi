///- --package .
:< sm'_operators
:< xml

:| severity =
    | Fatal
    | Warning
    | Information

:! rule_id = string

:! pattern_id = string

:| assertion_kind =
    | Asserts
    | Reports

:= rule_text (rule_id text) : string = text

:= pattern_text (pattern_id text) : string = text

:== assertion =
    {
        id : rule_id
        severity : severity
        kind : assertion_kind
        test : xpath::xpath
        source : string
        message : string
    }

:== binding = { name : string; value : xpath::xpath }

:== rule =
    {
        context : xpath::xpath
        context_source : string
        lets : list binding
        assertions : list assertion
    }

:== pattern = { id : pattern_id; lets : list binding; rules : list rule; namespaces : list (string * string) }

:= attribute_or (key : string) (attributes : list (string * string)) : string =
    ?= xml::attribute_of key attributes ?|
    | Some value => value
    | None => ""

:= severity_of (flag : string) : severity =
    ? flag = "fatal" || flag = "error" ?> Fatal |? flag = "warning" ?> Warning |: Information

:= severity_or (default : severity) (flag : string) : severity = ? flag = "" ?> default |: severity_of flag

:= is_assertion (name : string) : bool = local_name name = "assert" || local_name name = "report"

:= schematron_assertion
    (id : rule_id) (severity : severity) (kind : assertion_kind) (source : string) (message : string)
    : assertion
    =
    { id = id; severity = severity; kind = kind; test = xpath::lift_code_lists (xpath::parse source); source = source; message = message }

:= schematron_assertion_id (named : string) (message : string) : rule_id = rule_id (? named = "" ?> message |: named)

:= schematron_assertion_kind (name : string) : assertion_kind = ? xml::local_name name = "report" ?> Reports |: Asserts

:= schematron_assertion_of
    (default : severity) (name : string) (attributes : list (string * string)) (message : string)
    : assertion
    =
    := id = schematron_assertion_id (attribute_or "id" attributes) message
    := severity = severity_or default (attribute_or "flag" attributes)
    schematron_assertion id severity (schematron_assertion_kind name) (attribute_or "test" attributes) message

:= schematron_assertion_into (default : severity) (node : xml_node) (acc : list assertion) : list assertion =
    ?= node ?|
    | XmlElement (name, attributes, children) ?& is_assertion name =>
        schematron_assertion_of default name attributes (sm'::trim (xml::text_in children)) :: acc
    | _ => acc

:~ ^ assertions_in (default : severity) (nodes : list xml_node) (acc : list assertion) : list assertion =
    ?= nodes ?|
    | node :: rest => assertions_in default rest (schematron_assertion_into default node acc)
    | [] => listm::rev acc

:= schematron_binding (key : string) (attributes : list (string * string)) : binding =
    := value = xpath::lift_code_lists (xpath::parse (attribute_or key attributes))
    { name = attribute_or "name" attributes; value = value }

:~ ^ lets_in (nodes : list xml_node) (acc : list binding) : list binding =
    ?= nodes ?|
    | XmlElement (name, attributes, _) :: rest ?& xml::local_name name = "let" =>
        lets_in rest (schematron_binding "value" attributes :: acc)
    | _ :: rest => lets_in rest acc
    | [] => listm::rev acc

:== abstract_rule = { id : string; children : list xml_node }

:= is_abstract_rule (name : string) (attributes : list (string * string)) : bool =
    xml::local_name name = "rule" && attribute_or "abstract" attributes = "true"

:= is_concrete_rule (name : string) (attributes : list (string * string)) : bool =
    xml::local_name name = "rule" && is_abstract_rule name attributes = !-

:~ ^ abstract_rules_in (nodes : list xml_node) (acc : list abstract_rule) : list abstract_rule =
    ?= nodes ?|
    | XmlElement (name, attributes, children) :: rest => schematron_abstract_rules_of name attributes children rest acc
    | _ :: rest => abstract_rules_in rest acc
    | [] => acc

:& :~ schematron_abstract_rules_of
    (name : string) (attributes : list (string * string)) (children : list xml_node) (rest : list xml_node)
    (acc : list abstract_rule)
    : list abstract_rule
    =
    ? is_abstract_rule name attributes
    ?> abstract_rules_in rest ({ id = attribute_or "id" attributes; children = children } :: acc)
    |? xml::local_name name = "rule" ?> abstract_rules_in rest acc
    |: abstract_rules_in rest (abstract_rules_in children acc)

:~ ^ abstract_children (id : string) (abstracts : list abstract_rule) : list xml_node =
    ?= abstracts ?|
    | candidate :: rest => ? candidate::id = id ?> candidate::children |: abstract_children id rest
    | [] => []

:~ ^ extended_children
    (abstracts : list abstract_rule) (depth : i32) (nodes : list xml_node)
    : list xml_node
    =
    ?= nodes ?|
    | XmlElement (name, attributes, _) :: rest ?& xml::local_name name = "extends" && depth < 16i32 =>
        schematron_extended_include abstracts depth attributes rest
    | node :: rest => node :: extended_children abstracts depth rest
    | [] => []

:& :~ schematron_extended_include
    (abstracts : list abstract_rule) (depth : i32) (attributes : list (string * string)) (rest : list xml_node)
    : list xml_node
    =
    := inherited = abstract_children (attribute_or "rule" attributes) abstracts
    listm::append (extended_children abstracts (depth + 1i32) inherited) (extended_children abstracts depth rest)

:= schematron_rule_of
    (default : severity) (abstracts : list abstract_rule) (attributes : list (string * string)) (children : list xml_node)
    : rule
    =
    := source = attribute_or "context" attributes
    := content = extended_children abstracts 0i32 children
    { context = xpath::parse source; context_source = source; lets = lets_in content []; assertions = assertions_in default content [] }

:= schematron_rule_into
    (default : severity) (abstracts : list abstract_rule) (node : xml_node) (acc : list rule)
    : list rule
    =
    ?= node ?|
    | XmlElement (name, attributes, children) ?& is_concrete_rule name attributes =>
        schematron_rule_of default abstracts attributes children :: acc
    | _ => acc

:~ ^ rules_in
    (default : severity) (abstracts : list abstract_rule) (nodes : list xml_node) (acc : list rule)
    : list rule
    =
    ?= nodes ?|
    | node :: rest => rules_in default abstracts rest (schematron_rule_into default abstracts node acc)
    | [] => listm::rev acc

:= schematron_pattern_of
    (default : severity) (abstracts : list abstract_rule) (attributes : list (string * string)) (children : list xml_node)
    : pattern
    =
    := id = pattern_id (attribute_or "id" attributes)
    { id = id; lets = lets_in children []; rules = rules_in default abstracts children []; namespaces = [] }

:= schematron_pattern_into
    (default : severity) (abstracts : list abstract_rule) (node : xml_node) (acc : list pattern)
    : list pattern
    =
    ?= node ?|
    | XmlElement (name, attributes, children) ?& xml::local_name name = "pattern" =>
        schematron_pattern_of default abstracts attributes children :: acc
    | _ => acc

:~ ^ patterns_in
    (default : severity) (abstracts : list abstract_rule) (nodes : list xml_node) (acc : list pattern)
    : list pattern
    =
    ?= nodes ?|
    | node :: rest => patterns_in default abstracts rest (schematron_pattern_into default abstracts node acc)
    | [] => listm::rev acc

:= patterns_of_children (default : severity) (children : list xml_node) : list pattern =
    := schema_lets = lets_in children []
    := abstracts = abstract_rules_in children []
    listm::map (\ (p : pattern) => { p ?| lets = listm::append schema_lets p::lets }) (patterns_in default abstracts children [])

:= read_schematron_with (default : severity) (text : string) : list pattern =
    ?= xml::single_root (xml::read_xml text) ?|
    | Some root => patterns_of_children default root::children
    | None => []

:= read_schematron (text : string) : list pattern = read_schematron_with Information text

:= include_directory (path : string) : string =
    := slash = sm'::last_index_of "/" path
    ? slash < 0i32 ?> "" |: sm'::substring 0i32 (slash + 1i32) path

:= href_parts (href : string) : string * string =
    := hash = sm'::index_of "#" href
    ? hash < 0i32 ?> (href, "")
    |: (sm'::substring 0i32 hash href, sm'::substring (hash + 1i32) (sm'::length href - hash - 1i32) href)

:~ ^ element_with_id (id : string) (nodes : list xml_node) : option xml_node =
    ?= nodes ?|
    | XmlElement (name, attributes, children) :: rest => schematron_element_in id name attributes children rest
    | _ :: rest => element_with_id id rest
    | [] => None

:& :~ schematron_element_in
    (id : string) (name : string) (attributes : list (string * string)) (children : list xml_node) (rest : list xml_node)
    : option xml_node
    =
    ? attribute_or "id" attributes = id ?> Some (XmlElement (name, attributes, children))
    |:
        ?= element_with_id id children ?|
        | Some found => Some found
        | None => element_with_id id rest

:~ ^ expanded
    (load : string -> option string) (base : string) (depth : i32) (nodes : list xml_node)
    : list xml_node
    =
    ?= nodes ?|
    | XmlElement (name, attributes, _) :: rest ?& xml::local_name name = "include" && depth < 16i32 =>
        schematron_expanded_include load base depth attributes rest
    | node :: rest => node :: expanded load base depth rest
    | [] => []

:& :~ schematron_expanded_include
    (load : string -> option string) (base : string) (depth : i32) (attributes : list (string * string))
    (rest : list xml_node)
    : list xml_node
    =
    := file, fragment = href_parts (attribute_or "href" attributes)
    := path = include_directory base ++# file
    := included = schematron_included load path depth fragment
    listm::append included (expanded load base depth rest)

:& :~ schematron_included
    (load : string -> option string) (path : string) (depth : i32) (fragment : string)
    : list xml_node
    =
    ?= load path ?|
    | Some text => schematron_included_text load path depth fragment text
    | None => []

:& :~ schematron_included_text
    (load : string -> option string) (path : string) (depth : i32) (fragment : string) (text : string)
    : list xml_node
    =
    ?= xml::single_root (xml::read_xml text) ?|
    | Some root => schematron_included_root load path depth fragment root
    | None => []

:& :~ schematron_included_root
    (load : string -> option string) (path : string) (depth : i32) (fragment : string) (root : root_view)
    : list xml_node
    =
    := whole = XmlElement (root::name, root::attributes, root::children)
    schematron_included_node load path depth (? fragment = "" ?> Some whole |: element_with_id fragment (whole :: []))

:& :~ schematron_included_node
    (load : string -> option string) (path : string) (depth : i32) (found : option xml_node)
    : list xml_node
    =
    ?= found ?|
    | Some (XmlElement (n, _, c)) ?& xml::local_name n = "schema" => expanded load path (depth + 1i32) c
    | Some (XmlElement (n, a, c)) => XmlElement (n, a, expanded load path (depth + 1i32) c) :: []
    | _ => []

:= schematron_resolved_pattern
    (default : severity) (load : string -> option string) (path : string) (root : root_view)
    : list pattern
    =
    := fragment = XmlElement (root::name, root::attributes, expanded load path 0i32 root::children)
    patterns_of_children default (fragment :: [])

:= schematron_resolved_text
    (default : severity) (load : string -> option string) (path : string) (text : string)
    : list pattern
    =
    ?= xml::single_root (xml::read_xml text) ?|
    | Some root ?& xml::local_name root::name = "pattern" => schematron_resolved_pattern default load path root
    | Some root => patterns_of_children default (expanded load path 0i32 root::children)
    | None => []

:= read_schematron_resolved_with (default : severity) (load : string -> option string) (path : string) : list pattern =
    ?= load path ?|
    | Some text => schematron_resolved_text default load path text
    | None => []

:= read_schematron_resolved (load : string -> option string) (path : string) : list pattern =
    read_schematron_resolved_with Information load path

:== census = { rules : i32; assertions : i32; fatal : i32; invalid : i32; members : i32 }

:= empty_census () : census = { rules = 0i32; assertions = 0i32; fatal = 0i32; invalid = 0i32; members = 0i32 }

:= schematron_fatal_count (severity : severity) : i32 = ?= severity ?| Fatal => 1i32 | _ => 0i32

:= schematron_count_assertion (a : assertion) (acc : census) : census =
    { acc ?| assertions = acc::assertions + 1i32; fatal = acc::fatal + schematron_fatal_count a::severity }

:= schematron_count_members (a : assertion) (acc : census) : census =
    { acc ?| invalid = acc::invalid + xpath::invalid_count a::test; members = acc::members + xpath::member_count a::test }

:~ ^ assertions_census (assertions : list assertion) (acc : census) : census =
    ?= assertions ?|
    | a :: rest => assertions_census rest (schematron_count_members a (schematron_count_assertion a acc))
    | [] => acc

:~ ^ rules_census (rules : list rule) (acc : census) : census =
    ?= rules ?|
    | r :: rest =>
        := acc = { acc ?| rules = acc::rules + 1i32; invalid = acc::invalid + xpath::invalid_count r::context }
        rules_census rest (assertions_census r::assertions acc)
    | [] => acc

:~ ^ schematron_census (patterns : list pattern) (acc : census) : census =
    ?= patterns ?|
    | p :: rest => schematron_census rest (rules_census p::rules acc)
    | [] => acc

:= is_compiled_rule (name : string) (attributes : list (string * string)) : bool =
    := priority = attribute_or "priority" attributes
    xml::local_name name = "template"
    && sm'::index_of "M" (attribute_or "mode" attributes) = 0i32
    && priority <> ""
    && sm'::index_of "-" priority <> 0i32

:= schematron_value_of (attributes : list (string * string)) : string = "{" ++# attribute_or "select" attributes ++# "}"

:= schematron_message_piece (node : xml_node) (acc : string) : string =
    ?= node ?|
    | XmlElement (name, _, children) ?& xml::local_name name = "text" => acc ++# xml::text_in children
    | XmlElement (name, attributes, _) ?& xml::local_name name = "value-of" => acc ++# schematron_value_of attributes
    | _ => acc

:~ ^ message_text (nodes : list xml_node) (acc : string) : string =
    ?= nodes ?|
    | node :: rest => message_text rest (schematron_message_piece node acc)
    | [] => acc

:= schematron_after_label (text : string) (label : string) : string =
    sm'::trim (sm'::substring (sm'::length label) (sm'::length text - sm'::length label) text)

:= labelled (default : severity) (text : string) : severity * string =
    ? sm'::index_of "Fatal:" text = 0i32 ?> (Fatal, schematron_after_label text "Fatal:")
    |? sm'::index_of "Warning:" text = 0i32 ?> (Warning, schematron_after_label text "Warning:")
    |: (default, text)

:= schematron_compiled_message (default : severity) (test_branch : xml_node) (message : xml_node) : assertion =
    := severity, text = labelled default (sm'::trim (message_text (xml::element_children message) ""))
    := source = attribute_or "test" (xml::element_attributes test_branch)
    schematron_assertion (rule_id text) severity Asserts source text

:= schematron_compiled_otherwise (default : severity) (test_branch : xml_node) (otherwise : xml_node) : option assertion =
    ?= xml::first_child "message" (xml::element_children otherwise) ?|
    | Some message => Some (schematron_compiled_message default test_branch message)
    | None => None

:= schematron_compiled_when (default : severity) (branches : list xml_node) (test_branch : xml_node) : option assertion =
    ?= xml::first_child "otherwise" branches ?|
    | Some otherwise => schematron_compiled_otherwise default test_branch otherwise
    | None => None

:= compiled_assertion (default : severity) (branches : list xml_node) : option assertion =
    ?= xml::first_child "when" branches ?|
    | Some test_branch => schematron_compiled_when default branches test_branch
    | None => None

:= schematron_with_found (candidate : option assertion) (acc : list assertion) : list assertion =
    ?= candidate ?|
    | Some found => found :: acc
    | None => acc

:= schematron_compiled_into (default : severity) (node : xml_node) (acc : list assertion) : list assertion =
    ?= node ?|
    | XmlElement (name, _, children) ?& xml::local_name name = "choose" =>
        schematron_with_found (compiled_assertion default children) acc
    | _ => acc

:~ ^ compiled_assertions (default : severity) (nodes : list xml_node) (acc : list assertion) : list assertion =
    ?= nodes ?|
    | node :: rest => compiled_assertions default rest (schematron_compiled_into default node acc)
    | [] => listm::rev acc

:= is_select_variable (name : string) (attributes : list (string * string)) : bool =
    xml::local_name name = "variable" && attribute_or "select" attributes <> ""

:~ ^ compiled_lets (nodes : list xml_node) (acc : list binding) : list binding =
    ?= nodes ?|
    | XmlElement (name, attributes, _) :: rest ?& is_select_variable name attributes =>
        compiled_lets rest (schematron_binding "select" attributes :: acc)
    | _ :: rest => compiled_lets rest acc
    | [] => listm::rev acc

:~ ^ with_compiled_rule (mode : string) (r : rule) (groups : list (string * list rule)) : list (string * list rule) =
    ?= groups ?|
    | (m, rules) :: rest ?& m = mode => (m, (r :: rules)) :: rest
    | group :: rest => group :: with_compiled_rule mode r rest
    | [] => [ (mode, [ r ]) ]

:= schematron_compiled_rule (default : severity) (attributes : list (string * string)) (children : list xml_node) : rule =
    := source = attribute_or "match" attributes
    { context = xpath::parse source; context_source = source; lets = compiled_lets children []; assertions = compiled_assertions default children [] }

:= schematron_grouped
    (default : severity) (node : xml_node) (acc : list (string * list rule))
    : list (string * list rule)
    =
    ?= node ?|
    | XmlElement (name, attributes, children) ?& is_compiled_rule name attributes =>
        with_compiled_rule (attribute_or "mode" attributes) (schematron_compiled_rule default attributes children) acc
    | _ => acc

:~ ^ compiled_rule_groups
    (default : severity) (nodes : list xml_node) (acc : list (string * list rule))
    : list (string * list rule)
    =
    ?= nodes ?|
    | node :: rest => compiled_rule_groups default rest (schematron_grouped default node acc)
    | [] => acc

:~ ^ declared_namespaces (attributes : list (string * string)) (acc : list (string * string)) : list (string * string) =
    ?= attributes ?|
    | (key, uri) :: rest ?& sm'::index_of "xmlns:" key = 0i32 =>
        declared_namespaces rest ((sm'::substring 6i32 (sm'::length key - 6i32) key, uri) :: acc)
    | _ :: rest => declared_namespaces rest acc
    | [] => listm::rev acc

:= schematron_compiled_pattern (namespaces : list (string * string)) (group : string * list rule) : pattern =
    := mode, rules = group
    { id = pattern_id mode; lets = []; rules = listm::rev rules; namespaces = namespaces }

:= read_compiled_schematron_with (default : severity) (text : string) : list pattern =
    ?= xml::single_root (xml::read_xml text) ?|
    | Some root =>
        := namespaces = declared_namespaces root::attributes []
        listm::map (schematron_compiled_pattern namespaces) (compiled_rule_groups default root::children [])
    | None => []

:= read_compiled_schematron (text : string) : list pattern = read_compiled_schematron_with Information text

///> rust
:# reads_rules_and_typed_assertions =
    := source =
        "<schema xmlns=\"http://purl.oclc.org/dsdl/schematron\" queryBinding=\"xslt2\"><pattern id=\"model\">"
        ++# "<rule context=\"cac:InvoiceLine\">"
        ++# "<assert id=\"BR-21\" flag=\"fatal\" test=\"exists(cbc:ID)\">[BR-21] line id</assert>"
        ++# "<assert id=\"BR-X\" flag=\"warning\" test=\"cbc:Note != ''\">note</assert></rule></pattern></schema>"
    ?= read_schematron source ?|
    | p :: [] =>
        ? pattern_text p::id <> "model" ?> failwith "pattern id"
        ?= p::rules ?|
        | r :: [] =>
            ? xpath::xpath_text r::context <> "(child::cac:InvoiceLine .)" ?> failwith "rule context"
            ?= r::assertions ?|
            | first :: second :: [] =>
                ? rule_text first::id <> "BR-21" || first::message <> "[BR-21] line id" ?> failwith "first assertion"
                ? xpath::xpath_text first::test <> "(exists (child::cbc:ID .))" ?> failwith "parsed test"
                ?= second::severity ?| Warning => () | _ => failwith "warning flag"
            | _ => failwith "two assertions"
        | _ => failwith "one rule"
    | _ => failwith "one pattern"
    := totals = schematron_census (read_schematron source) (empty_census ())
    ? totals::rules <> 1i32 || totals::assertions <> 2i32 ?> failwith "census counts"
    ? totals::fatal <> 1i32 || totals::invalid <> 0i32 ?> failwith "census fatal and invalid"
    := unnamed =
        "<schema><pattern><rule context=\"x\"><assert test=\"true()\"> an unnamed rule </assert></rule>"
        ++# "</pattern></schema>"
    := ids_of (r : rule) = listm::map (\ (a : assertion) => rule_text a::id) r::assertions
    ?= listm::map (\ (p : pattern) => listm::map ids_of p::rules) (read_schematron unnamed) ?|
    | ((id :: []) :: []) :: [] =>
        ? id <> "an unnamed rule" ?> failwith "an assert without an id is named by its message, as SVRL reports it"
    | _ => failwith "one unnamed assertion"

///> rust
:# concrete_rules_inherit_the_abstract_rules_they_extend =
    := source =
        "<schema xmlns=\"http://purl.oclc.org/dsdl/schematron\"><pattern id=\"common\">"
        ++# "<rule abstract=\"true\" id=\"HeaderCheck\">"
        ++# "<assert id=\"TR-1\" flag=\"fatal\" test=\"exists(cbc:ID)\">id</assert>"
        ++# "<extends rule=\"NoteCheck\"/></rule>"
        ++# "<rule abstract=\"true\" id=\"NoteCheck\"><assert id=\"TR-2\" test=\"cbc:Note != ''\">note</assert></rule>"
        ++# "</pattern><pattern id=\"main\"><rule context=\"/Invoice\"><extends rule=\"HeaderCheck\"/></rule>"
        ++# "</pattern></schema>"
    := patterns = read_schematron source
    := rules = listm::concat (listm::map (\ (p : pattern) => p::rules) patterns)
    ?= rules ?|
    | r :: [] =>
        ? r::context_source <> "/Invoice" ?> failwith "only the concrete rule is read as a rule"
        := ids = sm'::concat_balanced "," (listm::map (\ (a : assertion) => rule_text a::id) r::assertions)
        ? ids <> "TR-1,TR-2" ?> failwith ("the concrete rule inherits its abstract rules' assertions in order: " ++# ids)
    | _ => failwith "abstract rules are not rules of their own"
    := totals = schematron_census patterns (empty_census ())
    ? totals::rules <> 1i32 || totals::assertions <> 2i32 ?> failwith "the census counts the concrete rule"
    ? totals::invalid <> 0i32 ?> failwith "an abstract rule's missing context is not an invalid expression"

///> rust
:# an_include_with_a_fragment_brings_in_only_that_element =
    := main =
        "<schema xmlns=\"http://purl.oclc.org/dsdl/schematron\"><include href=\"common.sch#abstracts\"/>"
        ++# "<pattern id=\"main\"><rule context=\"/Invoice\"><extends rule=\"HeaderCheck\"/></rule></pattern></schema>"
    := common =
        "<schema xmlns=\"http://purl.oclc.org/dsdl/schematron\"><pattern id=\"other\"><rule context=\"x\">"
        ++# "<assert id=\"OTHER\" test=\"true()\">other</assert></rule></pattern>"
        ++# "<pattern id=\"abstracts\"><rule abstract=\"true\" id=\"HeaderCheck\">"
        ++# "<assert id=\"TR-1\" test=\"exists(cbc:ID)\">id</assert></rule></pattern></schema>"
    := load path = ? path = "dir/main.sch" ?> Some main |? path = "dir/common.sch" ?> Some common |: None
    := totals = schematron_census (read_schematron_resolved load "dir/main.sch") (empty_census ())
    ? totals::rules <> 1i32 ?> failwith "only the main rule is read: the other pattern of common.sch is not included"
    ? totals::assertions <> 1i32 ?> failwith "the extends reaches the abstract rule inside the included fragment"

///> rust
:# a_compiled_schematron_reads_back_into_its_rules =
    := source =
        "<xsl:stylesheet xmlns:xsl=\"http://www.w3.org/1999/XSL/Transform\" xmlns:cbc=\"urn:cbc\" version=\"3.0\">"
        ++# "<xsl:variable name=\"document-uri\" select=\"document-uri(/)\"/>"
        ++# "<xsl:template match=\"/\" mode=\"generate-id-2\" priority=\"101\"><xsl:text>U</xsl:text></xsl:template>"
        ++# "<xsl:template match=\"cac:InvoiceLine\" priority=\"1001\" mode=\"M7\">"
        ++# "<xsl:variable name=\"total\" select=\"sum(cbc:Amount)\"/>"
        ++# "<xsl:choose><xsl:when test=\"exists(cbc:ID)\"/><xsl:otherwise><xsl:message>"
        ++# "<xsl:text>Fatal:</xsl:text><xsl:text>[BR-21] line id</xsl:text></xsl:message>"
        ++# "</xsl:otherwise></xsl:choose>"
        ++# "<xsl:choose><xsl:when test=\"$total &gt;= 0\"/><xsl:otherwise><xsl:message>"
        ++# "<xsl:text>Warning:</xsl:text><xsl:value-of select=\"'[BR-X]'\"/><xsl:text>-negative</xsl:text>"
        ++# "</xsl:message></xsl:otherwise></xsl:choose>"
        ++# "<xsl:apply-templates select=\"@*|node()\" mode=\"M7\"/></xsl:template>"
        ++# "<xsl:template match=\"*\" priority=\"1000\" mode=\"M7\"><xsl:choose><xsl:when test=\"true()\"/>"
        ++# "<xsl:otherwise><xsl:message><xsl:text>Fatal:</xsl:text><xsl:text>any</xsl:text></xsl:message>"
        ++# "</xsl:otherwise></xsl:choose></xsl:template>"
        ++# "<xsl:template match=\"text()\" priority=\"-1\" mode=\"M7\"/>"
        ++# "<xsl:template match=\"cbc:Note\" priority=\"1000\" mode=\"M8\"/></xsl:stylesheet>"
    := patterns = read_compiled_schematron source
    := modes = sm'::concat_balanced "," (listm::map (\ (p : pattern) => pattern_text p::id) patterns)
    ? modes <> "M7,M8" ?> failwith ("one pattern per skeleton mode, without generate-id or text(): " ++# modes)
    ?= patterns ?|
    | first :: _ =>
        := declared = sm'::concat_balanced "," (listm::map (\ (p, uri) => p ++# "=" ++# uri) first::namespaces)
        ? sm'::contains "cbc=urn:cbc" declared = !-
        ?> failwith ("the stylesheet's xmlns map rides on each pattern: " ++# declared)
        ?= first::rules ?|
        | line :: any :: [] =>
            := order = line::context_source ++# "," ++# any::context_source
            ? order <> "cac:InvoiceLine,*" ?> failwith ("rules keep the skeleton's priority order: " ++# order)
            := lets = sm'::concat_balanced "," (listm::map (\ (b : binding) => b::name) line::lets)
            ? lets <> "total" ?> failwith "rule variables become its lets"
            ?= line::assertions ?|
            | named :: total :: [] =>
                ? rule_text named::id <> "[BR-21] line id" ?> failwith "a static message names its assertion"
                ?= named::severity ?| Fatal => () | _ => failwith "the Fatal: label is the severity"
                ? xpath::xpath_text named::test <> "(exists (child::cbc:ID .))" ?> failwith "the when test is the test"
                := shown = total::message
                ? shown <> "{'[BR-X]'}-negative" ?> failwith ("a value-of shows its expression: " ++# shown)
                ?= total::severity ?| Warning => () | _ => failwith "the Warning: label is the severity"
            | _ => failwith "one assertion per choose"
        | _ => failwith "two rules in M7"
    | [] => failwith "patterns"
    := totals = schematron_census patterns (empty_census ())
    ? totals::rules <> 3i32 || totals::assertions <> 3i32 || totals::fatal <> 2i32 ?> failwith "compiled rules census"
