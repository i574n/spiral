///- --package .
open sm'_operators
open xml
open xpath_eval
open schematron

type failure = { id : string; severity : severity; path : list i32; detail : string }

inl context_query (source : string) : xpath.xpath =
    inl trimmed = sm'.trim source
    xpath.lift_code_lists (xpath.parse (if sm'.starts_with "/" trimmed then trimmed else "//(" ++# trimmed ++# ")"))

let rec without_fired (items : list located) (fired : list located) (acc : list located) : list located =
    match items with
    | item :: rest => without_fired rest fired (if has_located item fired then acc else item :: acc)
    | Nil => listm.rev acc

let rec check_assertions (s : scope) (assertions : list assertion) (acc : list failure) : list failure =
    match assertions with
    | a :: rest =>
        inl acc =
            match eval s a.test with
            | VError reason =>
                { id = a.id; severity = a.severity; path = s.context.path; detail = "error: " ++# reason } :: acc
            | value =>
                inl holds = effective_boolean value
                if holds = a.reports
                then { id = a.id; severity = a.severity; path = s.context.path; detail = "" } :: acc
                else acc
        check_assertions s rest acc
    | Nil => acc

let rec check_contexts
    (s : scope) (contexts : list located) (assertions : list assertion) (acc : list failure)
    : list failure
    =
    match contexts with
    | context :: rest =>
        check_contexts s rest assertions (check_assertions { s with context = context } assertions acc)
    | Nil => acc

let rec check_rules (s : scope) (rules : list rule) (fired : list located) (acc : list failure) : list failure =
    match rules with
    | r :: rest =>
        match eval s (context_query r.context_source) with
        | VNodes found =>
            inl contexts = without_fired found fired Nil
            check_rules s rest (listm.append fired contexts) (check_contexts s contexts r.assertions acc)
        | VError reason =>
            check_rules s rest fired (
                Cons (
                    { id = "context"; severity = Fatal; path = Nil; detail = r.context_source ++# ": " ++# reason },
                    acc
                )
            )
        | _ => check_rules s rest fired acc
    | Nil => acc

let rec check_patterns (s : scope) (patterns : list pattern) (acc : list failure) : list failure =
    match patterns with
    | p :: rest => check_patterns s rest (check_rules s p.rules Nil acc)
    | Nil => listm.rev acc

inl validate (patterns : list pattern) (document : xml_node) : list failure =
    inl root = document_root document
    check_patterns { context = root; root = root; variables = Nil } patterns Nil

let rec fatal_count (failures : list failure) (acc : i32) : i32 =
    match failures with
    | f :: rest => fatal_count rest (match f.severity with Fatal => acc + 1i32 | _ => acc)
    | Nil => acc
///> rust
test fires_the_first_matching_rule_per_pattern =
    inl rules =
        "<schema><pattern id=\"p\">"
        ++# (
            "<rule context=\"line[@kind = 'charge']\"><assert id=\"C\" flag=\"fatal\" test=\"amount > "
            ^^ "0\">charge</assert></rule>"
        )
        ++# "<rule context=\"line\"><assert id=\"L\" flag=\"fatal\" test=\"exists(amount)\">line</assert></rule>"
        ++# "</pattern></schema>"
    inl document = "<doc><line kind=\"charge\"><amount>0</amount></line><line><amount>5</amount></line><line/></doc>"
    match read_xml document with
    | root :: Nil =>
        inl failures = validate (read_schematron rules) root
        if listm.length failures <> 2i32 then failwith "the zero charge and the line without amount fail, nothing else"
        if fatal_count failures 0i32 <> 2i32 then failwith "both are fatal"
    | _ => failwith "one document"
