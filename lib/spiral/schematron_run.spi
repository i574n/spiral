///- --package .
:< sm'_operators
:< xml
:< xpath_eval
:< schematron

:== failure = { id : rule_id; severity : severity; path : list i32; detail : string }

:= context_query (source : string) : xpath::xpath =
    := trimmed = sm'::trim source
    xpath::lift_code_lists (xpath::parse (? sm'::starts_with "/" trimmed ?> trimmed |: "//(" ++# trimmed ++# ")"))

:~ ^ without_fired (items : list located) (fired : list located) (acc : list located) : list located =
    ?= items ?|
    | item :: rest => without_fired rest fired (? has_located item fired ?> acc |: item :: acc)
    | [] => listm::rev acc

:~ ^ bound (s : scope) (lets : list binding) : scope =
    ?= lets ?|
    | b :: rest => bound { s ?| variables = ((b::name, eval s b::value) :: s::variables) } rest
    | [] => s

:= assertion_fires (a : assertion) (holds : bool) : bool = ?= a::kind ?| Asserts => holds = !- | Reports => holds

:= fired_failure (s : scope) (a : assertion) (detail : string) : failure =
    { id = a::id; severity = a::severity; path = s::context::path; detail = detail }

:= assertion_failure (s : scope) (a : assertion) : option failure =
    ?= test_outcome s a::test ?|
    | Broken reason => Some (fired_failure s a ("error: " ++# reason))
    | Evaluated holds => ? assertion_fires a holds ?> Some (fired_failure s a "") |: None

:~ ^ check_assertions (s : scope) (assertions : list assertion) (acc : list failure) : list failure =
    ?= assertions ?|
    | a :: rest => check_assertions s rest (?= assertion_failure s a ?| Some f => f :: acc | None => acc)
    | [] => acc

:~ ^ check_contexts
    (s : scope) (contexts : list located) (lets : list binding) (assertions : list assertion)
    (acc : list failure)
    : list failure
    =
    ?= contexts ?|
    | context :: rest =>
        := at = bound { s ?| context = context; current = context } lets
        check_contexts s rest lets assertions (check_assertions at assertions acc)
    | [] => acc

:= context_failure (r : rule) (reason : string) : failure =
    { id = rule_id "context"; severity = Fatal; path = []; detail = r::context_source ++# ": " ++# reason }

:= rule_failures (s : scope) (r : rule) (contexts : list located) (acc : list failure) : list failure =
    check_contexts s contexts r::lets r::assertions acc

:= nodes_step
    (s : scope) (r : rule) (found : list located) (fired : list located) (acc : list failure)
    : list located * list failure
    =
    := contexts = without_fired found fired []
    listm::append fired contexts, rule_failures s r contexts acc

:= rule_step (s : scope) (r : rule) (fired : list located) (acc : list failure) : list located * list failure =
    ?= eval s (context_query r::context_source) ?|
    | VNodes found => nodes_step s r found fired acc
    | VError reason => fired, context_failure r reason :: acc
    | _ => fired, acc

:~ ^ check_rules (s : scope) (rules : list rule) (fired : list located) (acc : list failure) : list failure =
    ?= rules ?|
    | r :: rest =>
        := next_fired, next_acc = rule_step s r fired acc
        check_rules s rest next_fired next_acc
    | [] => acc

:~ ^ check_patterns (s : scope) (patterns : list pattern) (acc : list failure) : list failure =
    ?= patterns ?|
    | p :: rest => check_patterns s rest (check_rules (bound s p::lets) p::rules [] acc)
    | [] => listm::rev acc

:~ ^ is_bound (name : string) (lets : list binding) : bool =
    ?= lets ?|
    | b :: rest => ? b::name = name ?> !+ |: is_bound name rest
    | [] => !-

:~ ^ unseen (lets : list binding) (acc : list binding) : list binding =
    ?= lets ?|
    | b :: rest => unseen rest (? is_bound b::name acc ?> acc |: b :: acc)
    | [] => acc

:~ ^ shared_lets (patterns : list pattern) (acc : list binding) : list binding =
    ?= patterns ?|
    | p :: rest => shared_lets rest (unseen p::lets acc)
    | [] => listm::rev acc

:= pattern_namespaces (patterns : list pattern) : list (string * string) =
    listm::concat (listm::map (\ (p : pattern) => p::namespaces) patterns)

:= start_scope (today : string) (patterns : list pattern) (document : xml_node) : scope =
    := root = document_root document
    := ns = pattern_namespaces patterns
    { context = root; current = root; root = root; variables = []; today = today; namespaces = ns }

:= validate_on (today : string) (patterns : list pattern) (document : xml_node) : list failure =
    := start = start_scope today patterns document
    check_patterns (bound start (shared_lets patterns [])) patterns []

:= validate (patterns : list pattern) (document : xml_node) : list failure = validate_on "" patterns document

:~ ^ fatal_count (failures : list failure) (acc : i32) : i32 =
    ?= failures ?|
    | f :: rest => fatal_count rest (?= f::severity ?| Fatal => acc + 1i32 | _ => acc)
    | [] => acc

///- --timeout 900000

///> rust
:# fires_the_first_matching_rule_per_pattern =
    := rules =
        "<schema><pattern id=\"p\">"
        ++# (
            "<rule context=\"line[@kind = 'charge']\"><assert id=\"C\" flag=\"fatal\" test=\"amount > "
            ^^ "0\">charge</assert></rule>"
        )
        ++# "<rule context=\"line\"><assert id=\"L\" flag=\"fatal\" test=\"exists(amount)\">line</assert></rule>"
        ++# "</pattern></schema>"
    := document = "<doc><line kind=\"charge\"><amount>0</amount></line><line><amount>5</amount></line><line/></doc>"
    ?= read_xml document ?|
    | root :: [] =>
        := failures = validate (read_schematron rules) root
        ? listm::length failures <> 2i32 ?> failwith "the zero charge and the line without amount fail, nothing else"
        ? fatal_count failures 0i32 <> 2i32 ?> failwith "both are fatal"
    | _ => failwith "one document"

///- --timeout 900000

///> rust
:# current_is_each_rule_context_node =
    := rules =
        "<schema><pattern id=\"p\"><rule context=\"line\">"
        ++# "<assert id=\"U\" flag=\"fatal\" test=\"not(../(* except current())[@code = current()/@code])\">"
        ++# "unique</assert></rule></pattern></schema>"
    := document = "<doc><line code=\"a\"/><line code=\"b\"/><line code=\"a\"/></doc>"
    ?= read_xml document ?|
    | root :: [] =>
        := failures = validate (read_schematron rules) root
        ? listm::length failures <> 2i32 ?> failwith "the two lines sharing code a fail, the line with code b holds"
    | _ => failwith "one document"

///- --timeout 900000

///> rust
:# compiled_rules_match_names_by_namespace =
    := xsl =
        "<xsl:stylesheet xmlns:xsl=\"http://www.w3.org/1999/XSL/Transform\" xmlns:cbc=\"urn:cbc\" version=\"3.0\">"
        ++# "<xsl:template match=\"cbc:Reference\" priority=\"1000\" mode=\"M1\">"
        ++# "<xsl:choose><xsl:when test=\"false()\"/>"
        ++# "<xsl:otherwise><xsl:message><xsl:text>Fatal:</xsl:text><xsl:text>seen</xsl:text></xsl:message>"
        ++# "</xsl:otherwise></xsl:choose></xsl:template></xsl:stylesheet>"
    := document = "<doc xmlns:cbc=\"urn:cbc\" xmlns:ds=\"urn:ds\"><cbc:Reference/><ds:Reference/><ds:Reference/></doc>"
    ?= read_xml document ?|
    | root :: [] =>
        := failures = validate (read_compiled_schematron xsl) root
        ? listm::length failures <> 1i32
        ?> failwith "only the urn:cbc Reference is a cbc:Reference; both ds:Reference stay out"
    | _ => failwith "one document"

///- --timeout 900000

///> rust
:# lets_and_includes_assemble_the_schema =
    := rules =
        "<schema><let name=\"limit\" value=\"3\"/><pattern id=\"p\"><let name=\"floor\" value=\"0\"/>"
        ++# "<rule context=\"line\"><let name=\"a\" value=\"number(amount)\"/>"
        ++# "<assert id=\"R\" flag=\"fatal\" test=\"$a &gt; $floor and $a &lt; $limit\">range</assert></rule>"
        ++# "</pattern></schema>"
    := document =
        "<doc><line><amount>1</amount></line><line><amount>5</amount></line><line><amount>0</amount></line></doc>"
    ?= read_xml document ?|
    | root :: [] =>
        := failures = validate (read_schematron rules) root
        ? listm::length failures <> 2i32
        ?> failwith "the amounts outside the let-bound range fail, the one inside holds"
        := main = "<schema><include href=\"part/rules.sch\"/></schema>"
        := part =
            "<?xml version=\"1.0\"?><pattern id=\"q\"><rule context=\"line\">"
            ++# "<assert id=\"A\" flag=\"fatal\" test=\"exists(amount)\">amount</assert></rule></pattern>"
        := load path = ? path = "dir/main.sch" ?> Some main |? path = "dir/part/rules.sch" ?> Some part |: None
        := resolved = read_schematron_resolved load "dir/main.sch"
        ? listm::length resolved <> 1i32 ?> failwith "the include brings in its pattern-rooted fragment"
        ? listm::length (read_schematron main) <> 0i32 ?> failwith "the plain reader leaves the include unresolved"
        ? listm::length (read_schematron_resolved load "dir/part/rules.sch") <> 1i32
        ?> failwith "a fragment reads alone"
        := unflagged =
            "<schema><pattern><rule context=\"line\"><assert test=\"exists(amount)\">a</assert></rule>"
            ++# "</pattern></schema>"
        ?= read_xml "<doc><line/></doc>" ?|
        | bare :: [] =>
            ? listm::length (validate resolved bare) <> 1i32
            ?> failwith "the included rule checks the line without amount"
            ? fatal_count (validate (read_schematron unflagged) bare) 0i32 <> 0i32
            ?> failwith "an unflagged assert defaults to information"
            ? fatal_count (validate (read_schematron_with Fatal unflagged) bare) 0i32 <> 1i32
            ?> failwith "a profile can make unflagged asserts fatal, as GIB requires"
        | _ => failwith "one bare document"
    | _ => failwith "one document"

///- --timeout 900000

///> rust
:# pattern_lets_reach_every_pattern =
    := kind_in (id : string) =
        "<assert id=\"" ++# id ++# "\" flag=\"fatal\" test=\"contains($kinds, concat(',', @kind, ','))\">k</assert>"
    := rules =
        "<schema><pattern id=\"codes\"><let name=\"kinds\" value=\"',A,B,'\"/></pattern>"
        ++# "<pattern id=\"shared\"><rule context=\"line\">" ++# kind_in "S" ++# "</rule></pattern>"
        ++# "<pattern id=\"own\"><let name=\"kinds\" value=\"',C,'\"/><rule context=\"line\">" ++# kind_in "O"
        ++# "</rule></pattern></schema>"
    ?= read_xml "<doc><line kind=\"A\"/><line kind=\"C\"/></doc>" ?|
    | root :: [] =>
        := failures = validate (read_schematron rules) root
        ? listm::length failures <> 2i32 ?> failwith "the shared list rejects C, the pattern's own list rejects A"
        listm::iter (\ (f : failure) => ? f::detail <> "" ?> failwith ("no unbound variable: " ++# f::detail)) failures
    | _ => failwith "one document"
