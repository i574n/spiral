          Python = fun () => $'[item for item in !items]' : seq' t
          Rust = fun () => $'Rc::new(!items.borrow().clone())' : seq' t
          TypeScript = fun () => $'[...!items]' : seq' t
      }
  """,
  timeout: 300_000
)
