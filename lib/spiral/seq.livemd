### memoize

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"inl memoize seq =\n    inl state = mut []\n    fun n =>\n        match *state |> listm'.try_find (fun (n', _) => n' = n) with\n        | Some (_, v) => v\n        | None =>\n            inl new_state = seq n\n            state <- (n, new_state) :: *state\n            new_state\n\ninl memoize_ seq =\n    inl state = mut []\n    fun n =>\n        match *state |> listm'.try_find_ (fun (n', _) => n' = n) with\n        | Some (_, v) => v\n        | None =>\n            inl new_state = seq n\n            state <- (n, new_state) :: *state\n            new_state","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  inl memoize seq =
      inl state = mut []
      fun n =>
          match *state |> listm'.try_find (fun (n', _) => n' = n) with
          | Some (_, v) => v
          | None =>
              inl new_state = seq n
              state <- (n, new_state) :: *state
              new_state

  inl memoize_ seq =
      inl state = mut []
      fun n =>
          match *state |> listm'.try_find_ (fun (n', _) => n' = n) with
          | Some (_, v) => v
          | None =>
              inl new_state = seq n
              state <- (n, new_state) :: *state
              new_state
  """,
  timeout: 300_000
)
```

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"///- --test\n\ninl seq =\n    fun n =>\n        n |> print_and_return |> Some\n    |> memoize_\n\nseq\n|> take_while_ (fun n (_ : i32) => n < 5)\n|> listm'.sum\n|> _assert_eq 10\n\nseq\n|> take_while_ (fun n _ => n < 5)\n|> listm'.sum\n|> _assert_eq 10","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  ///- --test

  inl seq =
      fun n =>
          n |> print_and_return |> Some
      |> memoize_

  seq
  |> take_while_ (fun n (_ : i32) => n < 5)
  |> listm'.sum
  |> _assert_eq 10

  seq
  |> take_while_ (fun n _ => n < 5)
  |> listm'.sum
  |> _assert_eq 10
  """,
  timeout: 300_000
)
```

