<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"// inl iterate f x0 num_steps =\ninl iterate forall a b {number}. (f : a -> a) (x0 : a) (num_steps : b) : a =\n    // inl rec 루프 x n =\n    inl rec 루프 forall c {number}. (x : a) (n : c) : a =\n        if n <= 0\n        then x\n        else 루프 (f x) (n - 1)\n    루프 x0 num_steps","print_code":false},"livebook_object":"smart_cell"} -->

