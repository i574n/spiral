<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":":= to_array seq =\n    := ar = ;[] |> mut\n    ((), seq)\n    ||> fold \\ _ x =>\n        ar <- *ar ++ ;[x]\n    *ar\n\n:= to_array_ seq =\n    := ar = ;[] |> mut\n    ((), seq)\n    ||> fold_ \\ _ x =>\n        ar <- *ar ++ ;[x]\n    *ar","print_code":false},"livebook_object":"smart_cell"} -->

