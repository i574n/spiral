<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":":= of_list' \\* t. (items : listm'::list' t) : seq' t =\n    backend_switch {\n        Gleam = \\ () => $'!items ' : seq' t\n        Fsharp = \\ () =>\n            \\ () =>\n                items |> yield_from\n            |> new_seq\n            |> \\ x => x : seq' t\n        Python = \\ () => $'!items ' : seq' t\n        Rust = \\ () => $'(!items).clone()' : seq' t\n        TypeScript = \\ () => $'[...!items]' : seq' t\n        Zig = \\ () => $'!items ' : seq' t\n    }\n\n:= cast' \\* t u. (items : u) : seq' t =\n    backend_switch {\n        Gleam = \\ () => $'!items ' : seq' t\n        Fsharp = \\ () => items |> $'Seq.cast' : seq' t\n        Python = \\ () => $'list(!items)' : seq' t\n        Rust = \\ () =>\n            := x : seq' t =\n                ~>\n                    ?: u ?|\n                    | seq' ~x => $'(!items).clone()' : seq' t\n                    | listm'::list' ~x => $'(!items).clone()' : seq' t\n                    | array_base ~x => $'Rc::new(!items.borrow().clone())' : seq' t\n                    | array ~x => $'Rc::new(!items.borrow().clone())' : seq' t\n                    | _ => $'Rc::new(IntoIterator::into_iter(!items).collect::<Vec<`t>>())' : seq' t\n            x\n        TypeScript = \\ () => $'Array.from(!items)' : seq' t\n        Zig = \\ () => $'!items ' : seq' t\n    }\n\n:= rev'' \\* t. (items : seq' t) : seq' t =\n    backend_switch {\n        Gleam = \\ () =>\n            global \"import gleam/list\"\n            $'!items |> list.reverse' : seq' t\n        Fsharp = \\ () => items |> $'Seq.rev' : seq' t\n        Python = \\ () => $'list(reversed(!items))' : seq' t\n        Rust = \\ () => $'Rc::new((!items).as_ref().iter().rev().cloned().collect::<Vec<_>>())' : seq' t\n        TypeScript = \\ () => $'[...!items].reverse()' : seq' t\n        Zig = fun () => $'blk: { const r = spiral_gpa.dupe(`t, !items) catch \\@panic(\"out of memory\"); \\\n            std.mem.reverse(`t, r); break :blk r; }' : seq' t\n    }","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  := of_list' \* t. (items : listm'::list' t) : seq' t =
      backend_switch {
          Gleam = \ () => $'!items ' : seq' t
          Fsharp = \ () =>
              \ () =>
                  items |> yield_from
              |> new_seq
              |> \ x => x : seq' t
          Python = \ () => $'!items ' : seq' t
          Rust = \ () => $'(!items).clone()' : seq' t
          TypeScript = \ () => $'[...!items]' : seq' t
          Zig = \ () => $'!items ' : seq' t
      }

  := cast' \* t u. (items : u) : seq' t =
      backend_switch {
          Gleam = \ () => $'!items ' : seq' t
          Fsharp = \ () => items |> $'Seq.cast' : seq' t
          Python = \ () => $'list(!items)' : seq' t
          Rust = \ () =>
              := x : seq' t =
                  ~>
                      ?: u ?|
                      | seq' ~x => $'(!items).clone()' : seq' t
                      | listm'::list' ~x => $'(!items).clone()' : seq' t
                      | array_base ~x => $'Rc::new(!items.borrow().clone())' : seq' t
                      | array ~x => $'Rc::new(!items.borrow().clone())' : seq' t
                      | _ => $'Rc::new(IntoIterator::into_iter(!items).collect::<Vec<`t>>())' : seq' t
              x
          TypeScript = \ () => $'Array.from(!items)' : seq' t
          Zig = \ () => $'!items ' : seq' t
      }

  := rev'' \* t. (items : seq' t) : seq' t =
      backend_switch {
          Gleam = \ () =>
              global "import gleam/list"
              $'!items |> list.reverse' : seq' t
          Fsharp = \ () => items |> $'Seq.rev' : seq' t
          Python = \ () => $'list(reversed(!items))' : seq' t
          Rust = \ () => $'Rc::new((!items).as_ref().iter().rev().cloned().collect::<Vec<_>>())' : seq' t
          TypeScript = \ () => $'[...!items].reverse()' : seq' t
          Zig = fun () => $'blk: { const r = spiral_gpa.dupe(`t, !items) catch \@panic("out of memory"); \
              std.mem.reverse(`t, r); break :blk r; }' : seq' t
      }
  """,
  timeout: 300_000
)
```

