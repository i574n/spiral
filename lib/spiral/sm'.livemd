```

### index_of_char_from

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"inl index_of_char_from (from : i32) (c : char) (s : string) : i32 =\n    inl len = s |> length\n    inl rec body i =\n        if i >= len\n        then -1i32\n        elif c = (s |> index i)\n        then i - from\n        else 루프 (i + 1i32)\n    and inl 루프 i = join_body_unit body (if var_is i then i else len) i\n    from |> 루프","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  inl index_of_char_from (from : i32) (c : char) (s : string) : i32 =
      inl len = s |> length
      inl rec body i =
          if i >= len
          then -1i32
          elif c = (s |> index i)
          then i - from
          else 루프 (i + 1i32)
      and inl 루프 i = join_body_unit body (if var_is i then i else len) i
      from |> 루프
  """,
  timeout: 300_000
)
```

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"///- --test\n\n\"abcdefabc\"\n|> index_of_char_from 2i32 'a'\n|> _assert_eq 4i32","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  ///- --test

  "abcdefabc"
  |> index_of_char_from 2i32 'a'
  |> _assert_eq 4i32
  """,
  timeout: 300_000
)
```

### index_of

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"inl index_of (search : string) (s : string) : int =\n    backend_switch {\n        Gleam = fun () =>\n            global \"import gleam/list\"\n            global \"import gleam/option\"\n            global \"import gleam/string\"\n            inl g : list string =\n                $'!s |> string.to_graphemes'\n            $'let search = !search ' : ()\n            $'let x = !g |> list.index_fold (option.None, fn(acc, item, index) {' : ()\n            $'  case acc {' : ()\n            $'    option.None if item == search -> option.Some(index)' : ()\n            $'    _ -> acc' : ()\n            $'  }' : ()\n            $'})' : ()\n            $'x |> option.unwrap(-1)' : int\n        Lua = fun () => $'string.find(!s, !search) - 1' : int\n        Fsharp = fun () => $'!s.IndexOf !search ' : int\n        Python = fun () => $'!s.find(!search)' : int\n        Rust = fun () => $'!s.find(&*!search).map(|i| i as `int).unwrap_or(-1)' : int\n        TypeScript = fun () => $'!s.indexOf(!search)' : int\n        Zig = fun () => $'(if (std.mem.indexOf(u8, !s, !search)) |i| \\@as(`int, \\@intCast(i)) else -1)' : int\n        Lean = fun () => $'(if (!search).isEmpty then 0 else match (!s).splitOn !search with | [_] => -1 | p :: _ => `int.ofNat p.utf8ByteSize | [] => -1)' : int\n    }","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  inl index_of (search : string) (s : string) : int =
      backend_switch {
          Gleam = fun () =>
              global "import gleam/list"
              global "import gleam/option"
              global "import gleam/string"
              inl g : list string =
                  $'!s |> string.to_graphemes'
              $'let search = !search ' : ()
              $'let x = !g |> list.index_fold (option.None, fn(acc, item, index) {' : ()
              $'  case acc {' : ()
              $'    option.None if item == search -> option.Some(index)' : ()
              $'    _ -> acc' : ()
              $'  }' : ()
              $'})' : ()
              $'x |> option.unwrap(-1)' : int
          Lua = fun () => $'string.find(!s, !search) - 1' : int
          Fsharp = fun () => $'!s.IndexOf !search ' : int
          Python = fun () => $'!s.find(!search)' : int
          Rust = fun () => $'!s.find(&*!search).map(|i| i as `int).unwrap_or(-1)' : int
          TypeScript = fun () => $'!s.indexOf(!search)' : int
          Zig = fun () => $'(if (std.mem.indexOf(u8, !s, !search)) |i| \@as(`int, \@intCast(i)) else -1)' : int
          Lean = fun () => $'(if (!search).isEmpty then 0 else match (!s).splitOn !search with | [_] => -1 | p :: _ => `int.ofNat p.utf8ByteSize | [] => -1)' : int
      }
  """,
  timeout: 300_000
)
```

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"///- --test\n///> gleam\n///> fsharp\n///> cuda\n///> rust\n///> typescript\n\n\"123\"\n|> index_of \"2\"\n|> _assert_eq 1","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  ///- --test
  ///> gleam
  ///> fsharp
  ///> cuda
  ///> rust
  ///> typescript

  "123"
  |> index_of "2"
  |> _assert_eq 1
  """,
  timeout: 300_000
)
```

### replicate

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"inl replicate (n : int) (s : string) : string =\n    inl rec body i acc =\n        if i >= n\n        then acc\n        else 루프 (i + 1) (acc ++# s)\n    and inl 루프 i = join_body_unit body n i\n    루프 0 \"\"","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  inl replicate (n : int) (s : string) : string =
      inl rec body i acc =
          if i >= n
          then acc
          else 루프 (i + 1) (acc ++# s)
      and inl 루프 i = join_body_unit body n i
      루프 0 ""
  """,
  timeout: 300_000
)
```

