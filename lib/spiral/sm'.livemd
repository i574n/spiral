### replace_regex

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"let replace_regex (pattern : string) (replacement : string) (s : string) : string =\n    run_target_args (fun () => s, pattern, replacement) function\n        | Fsharp => fun s, pattern, replacement =>\n            $'System.Text.RegularExpressions.Regex.Replace (!s, !pattern, !replacement)'\n        | Rust => fun s, pattern, replacement =>\n            inl regex = pattern |> new_regex |> resultm.unwrap'\n            inl s = join s\n            !\\\\((regex, s, replacement), $'$\"$0.replace_all(&*$1, &*$2)\"')\n            |> cow_to_std_string\n            |> from_std_string\n        | Gleam => fun s, pattern, replacement =>\n            global \"import gleam/regexp\"\n            $'let assert Ok(re) = !pattern |> regexp.from_string'\n            $'re |> regexp.replace(!s, !replacement)' : string\n        | _ => fun _ => join \"\"","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  let replace_regex (pattern : string) (replacement : string) (s : string) : string =
      run_target_args (fun () => s, pattern, replacement) function
          | Fsharp => fun s, pattern, replacement =>
              $'System.Text.RegularExpressions.Regex.Replace (!s, !pattern, !replacement)'
          | Rust => fun s, pattern, replacement =>
              inl regex = pattern |> new_regex |> resultm.unwrap'
              inl s = join s
              !\\((regex, s, replacement), $'$"$0.replace_all(&*$1, &*$2)"')
              |> cow_to_std_string
              |> from_std_string
          | Gleam => fun s, pattern, replacement =>
              global "import gleam/regexp"
              $'let assert Ok(re) = !pattern |> regexp.from_string'
              $'re |> regexp.replace(!s, !replacement)' : string
          | _ => fun _ => join ""
  """,
  timeout: 300_000
)
```

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"///- --test\n///> fsharp\n///> gleam\n///> rust -d regex\n\n\" 123\"\n|> replace_regex \"\\\\s\\\\w2\" \"\"\n|> _assert_eq \"3\"","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  ///- --test
  ///> fsharp
  ///> gleam
  ///> rust -d regex

  " 123"
  |> replace_regex "\\s\\w2" ""
  |> _assert_eq "3"
  """,
  timeout: 300_000
)
```

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"///- --test\n///> rust -d regex\n\n\"    let main args =\\n        ()\\n\"\n|> replace_regex \"(?P<a> *)(?P<b>let\\\\s+main\\\\s+.*?\\\\s*=)\" \"$a[<EntryPoint>]\\n$a$b\"\n|> _assert_eq \"    [<EntryPoint>]\\n    let main args =\\n        ()\\n\"","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  ///- --test
  ///> rust -d regex

  "    let main args =\n        ()\n"
  |> replace_regex "(?P<a> *)(?P<b>let\\s+main\\s+.*?\\s*=)" "$a[<EntryPoint>]\n$a$b"
  |> _assert_eq "    [<EntryPoint>]\n    let main args =\n        ()\n"
  """,
  timeout: 300_000
)
```

## main

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"///> fsharp\n\ninl main () =\n    $'let contains x = !contains x' : ()\n    $'let ends_with x = !ends_with x' : ()\n    $'let pad_left x = !pad_left x' : ()\n    $'let pad_right x = !pad_right x' : ()\n    $'let replace x = !replace x' : ()\n    $'let replace_regex x = !replace_regex x' : ()\n    inl slice (a : i32) (b : i32) c = slice a b c\n    $'let slice x = !slice x' : ()\n    $'let split x = !split x' : ()\n    $'let split_string x = !split_string x' : ()\n    $'let starts_with x = !starts_with x' : ()\n    $'let substring x = !substring x' : ()\n    $'let to_lower x = !to_lower x' : ()\n    $'let to_upper x = !to_upper x' : ()\n    $'let trim x = !trim x' : ()\n    $'let ellipsis x = !ellipsis x' : ()\n    $'let ellipsis_end x = !ellipsis_end x' : ()\n    $'let format_exception x = !format_exception x' : ()\n    $'let concat_array x = !concat_array x' : ()\n    inl concat a (b : seq.seq' string) = concat a b\n    $'let concat x = !concat x' : ()\n    $'let join\\' x = !join' x' : ()\n    $'let to_char_array x = !to_char_array x' : ()","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  ///> fsharp

  inl main () =
      $'let contains x = !contains x' : ()
      $'let ends_with x = !ends_with x' : ()
      $'let pad_left x = !pad_left x' : ()
      $'let pad_right x = !pad_right x' : ()
      $'let replace x = !replace x' : ()
      $'let replace_regex x = !replace_regex x' : ()
      inl slice (a : i32) (b : i32) c = slice a b c
      $'let slice x = !slice x' : ()
      $'let split x = !split x' : ()
      $'let split_string x = !split_string x' : ()
      $'let starts_with x = !starts_with x' : ()
      $'let substring x = !substring x' : ()
      $'let to_lower x = !to_lower x' : ()
      $'let to_upper x = !to_upper x' : ()
      $'let trim x = !trim x' : ()
      $'let ellipsis x = !ellipsis x' : ()
      $'let ellipsis_end x = !ellipsis_end x' : ()
      $'let format_exception x = !format_exception x' : ()
      $'let concat_array x = !concat_array x' : ()
      inl concat a (b : seq.seq' string) = concat a b
      $'let concat x = !concat x' : ()
      $'let join\' x = !join' x' : ()
      $'let to_char_array x = !to_char_array x' : ()
  """,
  timeout: 300_000
)
```

