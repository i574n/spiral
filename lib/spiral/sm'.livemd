### format_debug_real

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"///- --real\n\ninl rec format_debug_real forall t. (x : t) : string =\n    typecase t with\n    | string => x\n    | _ =>\n        backend_switch `string `({}) {\n            Gleam =\n                (fun () =>\n                    typecase t with\n                    | char => convert.to `(`x) `string x\n                    | string_builder_real => convert.to `(`x) `string x\n                    | _ =>\n                        global \"import gleam/string\"\n                        inl x =\n                            typecase t with\n                            | array_base _ => $'!x |> array.to_list' : t\n                            | _ => x\n                        $'string.inspect(!x)' : string\n                    ) : () -> string\n            Lua =\n                (fun () =>\n                    typecase t with\n                    | ~a * ~b =>\n                        inl a, b =\n                            if not (var_is `t x)\n                            then x\n                            else ($'__v[1]._1' : a), ($'__v[1]._2' : b)\n                        inl head_str = format_debug_real `a a\n                        inl tail_str = format_debug_real `b b\n                        (++#*) head_str ((++#*) \", \" tail_str)\n                    | {} => $'table.concat(!x, \", \")   ' : string\n                    | array_base _ =>\n                        (++#*) ((++#*) \"[\" ($'table.concat(!x, \", \")' : string)) \"]\"\n                    | t =>\n                        if real_core.union_type_is `t\n                        then serialize_union `t x\n                        else $'tostring(!x)       ' : string\n                ) : () -> string\n            Fsharp = (fun () => $'$\"%A{!x}\"' : string) : () -> string\n            Python =\n                (fun () =>\n                    $'f\"{!x}\"' : string\n                ) : () -> string\n            Rust =\n                (fun () =>\n                    typecase t with\n                    | char => $'Rc::<str>::from(format\\!(\"{:?}\", !x as char))' : string\n                    | optionm'.option' ~a =>\n                        if real_core.prim_type_is `a\n                        then $'Rc::<str>::from(match &!x { Some(v) => format\\!(\"Some {:?}\", v), None => String::from(\"None\") })' : string\n                        else\n                            inl x = $'Rc::new(RefCell::new(!x.clone().into_iter().collect::<Vec<_>>()))' : array_base a\n                            if !!!!EQ(!!!!ArrayLength(`u64, x), 0u64) then \"None\"\n                            else (++#*) \"Some \" (format_debug_element_rust `a !!!!ArrayIndex(x, 0u64))\n                    | () * ~b =>\n                        inl _, b = x\n                        format_debug_real `b b\n                    | ~a * ~b =>\n                        inl a, b = x\n                        (++#*) (format_debug_real `a a) ((++#*) \", \" (format_debug_real `b b))\n                    | array_base ~el =>\n                        if real_core.prim_type_is `el\n                        then $'Rc::<str>::from(format\\!(\"{:?}\", !x.borrow()))' : string\n                        else format_debug_elements_rust `el x\n                    | listm'.list' ~el =>\n                        if real_core.prim_type_is `el\n                        then format_debug_other_rust `t x\n                        else format_debug_elements_rust `el ($'Rc::new(RefCell::new((*!x).clone()))' : array_base el)\n                    | seq.seq' ~el =>\n                        if real_core.prim_type_is `el\n                        then format_debug_other_rust `t x\n                        else format_debug_elements_rust `el ($'Rc::new(RefCell::new((*!x).clone()))' : array_base el)\n                    | {} =>\n                        inl _, fields =\n                            real_core.record_fold\n                                fun { state = separator, acc key value } =>\n                                    \"; \", acc ++#* separator ++#* symbol_to_string_real `(`key) ++#* \" = \" ++#* format_debug_real `(`value) value\n                                (\"\", \"\") x\n                        \"{ \" ++#* fields ++#* \" }\"\n                    | _ => format_debug_other_rust `t x\n                ) : () -> string\n            TypeScript =\n                (fun () =>\n                    typecase t with\n                    | char => $'\"\\'\" + String.fromCharCode(!x) + \"\\'\"' : string\n                    | optionm'.option' ~a =>\n                        if $'!x === undefined' : bool\n                        then \"None\"\n                        else (++#*) \"Some \" (format_debug_real `a ($'!x ' : a))\n                    | () * ~b =>\n                        inl _, b = x\n                        format_debug_real `b b\n                    | ~a * ~b =>\n                        inl a, b = x\n                        (++#*) (format_debug_real `a a) ((++#*) \", \" (format_debug_real `b b))\n                    | array_base ~el =>\n                        if (typecase el with char => true | _ => false)\n                        then $'\"[\" + !x.map((c: number) => \"\\'\" + String.fromCharCode(c) + \"\\'\").join(\", \") + \"]\"' : string\n                        elif real_core.prim_type_is `el\n                        then $'\"[\" + !x.join(\", \") + \"]\"' : string\n                        else $'String(!x)' : string\n                    | {} =>\n                        inl _, fields =\n                            real_core.record_fold\n                                fun { state = separator, acc key value } =>\n                                    \"; \", acc ++#* separator ++#* symbol_to_string_real `(`key) ++#* \" = \" ++#* format_debug_real `(`value) value\n                                (\"\", \"\") x\n                        \"{ \" ++#* fields ++#* \" }\"\n                    | _ =>\n                        if real_core.union_type_is `t\n                        then serialize_union_rust `t x\n                        elif real_core.nominal_type_is `t\n                        then\n                            inl y = real_core.nominal_strip x\n                            format_debug_real `(`y) y\n                        else $'String(!x)' : string\n                ) : () -> string\n            Zig =\n                (fun () =>\n                    typecase t with\n                    | char => $'(std.fmt.allocPrint(spiral_gpa, \"\\'{c}\\'\", .{ !x }) catch \\@panic(\"out of memory\"))' : string\n                    | bool => $'(if (!x) \"true\" else \"false\")' : string\n                    | () * ~b =>\n                        inl _, b = x\n                        format_debug_real `b b\n                    | ~a * ~b =>\n                        inl a, b = x\n                        (++#*) (format_debug_real `a a) ((++#*) \", \" (format_debug_real `b b))\n                    | {} =>\n                        inl _, fields =\n                            real_core.record_fold\n                                fun { state = separator, acc key value } =>\n                                    \"; \", acc ++#* separator ++#* symbol_to_string_real `(`key) ++#* \" = \" ++#* format_debug_real `(`value) value\n                                (\"\", \"\") x\n                        \"{ \" ++#* fields ++#* \" }\"\n                    | _ =>\n                        if real_core.union_type_is `t\n                        then serialize_union_rust `t x\n                        elif real_core.nominal_type_is `t\n                        then\n                            inl y = real_core.nominal_strip x\n                            format_debug_real `(`y) y\n                        elif real_core.prim_type_is `t\n                        then $'(std.fmt.allocPrint(spiral_gpa, \"{d}\", .{ !x }) catch \\@panic(\"out of memory\"))' : string\n                        else $'(std.fmt.allocPrint(spiral_gpa, \"{any}\", .{ !x }) catch \\@panic(\"out of memory\"))' : string\n                ) : () -> string\n            Lean =\n                (fun () =>\n                    typecase t with\n                    | char => $'(\"\\'\" ++ toString !x ++ \"\\'\")' : string\n                    | () * ~b =>\n                        inl _, b = x\n                        format_debug_real `b b\n                    | ~a * ~b =>\n                        inl a, b = x\n                        (++#*) (format_debug_real `a a) ((++#*) \", \" (format_debug_real `b b))\n                    | {} =>\n                        inl _, fields =\n                            real_core.record_fold\n                                fun { state = separator, acc key value } =>\n                                    \"; \", acc ++#* separator ++#* symbol_to_string_real `(`key) ++#* \" = \" ++#* format_debug_real `(`value) value\n                                (\"\", \"\") x\n                        \"{ \" ++#* fields ++#* \" }\"\n                    | _ =>\n                        if real_core.union_type_is `t\n                        then serialize_union_rust `t x\n                        elif real_core.nominal_type_is `t\n                        then\n                            inl y = real_core.nominal_strip x\n                            format_debug_real `(`y) y\n                        else $'toString !x ' : string\n                ) : () -> string\n        }\nand inl format_debug_other_rust forall t. (x : t) : string =\n    if real_core.prim_type_is `t\n    then $'Rc::<str>::from(format\\!(\"{:?}\", !x))' : string\n    elif real_core.union_type_is `t\n    then serialize_union_rust `t x\n    elif real_core.nominal_type_is `t\n    then\n        inl payload forall u. (y : u) : string =\n            typecase u with\n            | {} => format_debug_real `u y\n            | ~a -> ~b => $'Rc::<str>::from(\"<`t>\")' : string\n            | ~a * ~b => format_debug_real `u y\n            | array_base _ => format_debug_real `u y\n            | _ =>\n                if real_core.prim_type_is `u || real_core.union_type_is `u || real_core.nominal_type_is `u\n                then format_debug_real `u y\n                else $'Rc::<str>::from({ struct W<T>(T); trait D { fn s(&self) -> String; } impl<T: std::fmt::Debug> D for &W<T> { fn s(&self) -> String { format\\!(\"{:?}\", self.0) } } trait P { fn s(&self) -> String; } impl<T> P for W<T> { fn s(&self) -> String { String::from(\"<`t>\") } } (&&W(&!y)).s() })' : string\n        inl y = real_core.nominal_strip x\n        payload `(`y) y\n    else $'Rc::<str>::from(\"<`t>\")' : string\nand inl format_debug_elements_rust forall el. (x : array_base el) : string =\n    join\n        inl n = !!!!ArrayLength(`u64, x)\n        inl i = mut `u64 (real_core.dyn 0u64)\n        inl s = mut `string (real_core.dyn \"\")\n        loopw.while (fun () => !!!!LT(!!!!LayoutIndex(i), n)) fun () =>\n            inl j = !!!!LayoutIndex(i)\n            inl e = format_debug_element_rust `el !!!!ArrayIndex(x, j)\n            s <- (if !!!!EQ(j, 0u64) then e else !!!!LayoutIndex(s) ++#* \", \" ++#* e)\n            i <- !!!!Add(j, 1u64)\n        \"[\" ++#* !!!!LayoutIndex(s) ++#* \"]\"\n    : string\nand inl format_debug_element_rust forall el. (x : el) : string =\n    typecase el with\n    | ~a * ~b => \"(\" ++#* format_debug_real `el x ++#* \")\"\n    | _ => format_debug_real `el x\nand inl serialize_union forall t. (x : t) : string =\n    join\n        $'if type(v0) ~= \"table\" then return tostring(v0) end' : ()\n        real_core.unbox x fun k, v =>\n            inl tag : string = $'__v[1].tag'\n            typecase `v with\n            | () => tag\n            | ~a * ~b =>\n                typecase a with\n                | ~c * ~d =>\n                    inl head_str = format_debug_real `c ($'__v[1]._1 ' : c)\n                    inl tail_str = format_debug_real `d ($'__v[1]._2  ' : d)\n                    inl x = format_debug_real `b ($'__v[1]._3   ' : b)\n                    tag ++#* \"(\" ++#* head_str ++#* \", \" ++#* tail_str ++#* \", \" ++#* x ++#* \")\"\n                | _ =>\n                    inl head_str = format_debug_real `a ($'__v[1]._1    ' : a)\n                    inl tail_str = format_debug_real `b ($'__v[1]._2     ' : b)\n                    (++#*) tag ((++#*) \"(\" ((++#*) head_str ((++#*) \", \" ((++#*) tail_str \")\"))))\n            | ~a =>\n                inl arg_str = format_debug_real `a ($'__v[1]._1' : a)\n                (++#*) tag ((++#*) \"(\" ((++#*) arg_str \")\"))\n    : string\nand inl serialize_union_rust forall t. (x : t) : string =\n    join\n        real_core.unbox x fun k, v =>\n            inl name = symbol_to_string_real `(`k)\n            typecase `v with\n            | () => name\n            | _ => (++#*) name ((++#*) \"(\" ((++#*) (format_debug_real `(`v) v) \")\"))\n    : string\n\ninl obj_to_string_rust_inner_real forall t. (x : t) : string =\n    typecase t with\n    | {} => format_debug_real `t x\n    | ~a * ~b => format_debug_real `t x\n    | ~a -> ~b => format_debug_real `t x\n    | array_base _ => format_debug_real `t x\n    | ~f ~a => format_debug_real `t x\n    | _ =>\n        if real_core.prim_type_is `t || real_core.union_type_is `t || real_core.nominal_type_is `t\n        then format_debug_real `t x\n        else $'Rc::<str>::from(format\\!(\"{}\", !x))' : string\n\ninl obj_to_string_rust_real forall t. (x : t) : string =\n    typecase t with\n    | char => $'Rc::<str>::from((!x as char).encode_utf8(&mut [0u8; 4]) as &str)' : string\n    | string => x\n    | ~f ~a => format_debug_real `t x\n    | _ =>\n        if real_core.nominal_type_is `t\n        then\n            inl x = real_core.nominal_strip x\n            obj_to_string_rust_inner_real `(`x) x\n        else format_debug_real `t x","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  ///- --real

  inl rec format_debug_real forall t. (x : t) : string =
      typecase t with
      | string => x
      | _ =>
          backend_switch `string `({}) {
              Gleam =
                  (fun () =>
                      typecase t with
                      | char => convert.to `(`x) `string x
                      | string_builder_real => convert.to `(`x) `string x
                      | _ =>
                          global "import gleam/string"
                          inl x =
                              typecase t with
                              | array_base _ => $'!x |> array.to_list' : t
                              | _ => x
                          $'string.inspect(!x)' : string
                      ) : () -> string
              Lua =
                  (fun () =>
                      typecase t with
                      | ~a * ~b =>
                          inl a, b =
                              if not (var_is `t x)
                              then x
                              else ($'__v[1]._1' : a), ($'__v[1]._2' : b)
                          inl head_str = format_debug_real `a a
                          inl tail_str = format_debug_real `b b
                          (++#*) head_str ((++#*) ", " tail_str)
                      | {} => $'table.concat(!x, ", ")   ' : string
                      | array_base _ =>
                          (++#*) ((++#*) "[" ($'table.concat(!x, ", ")' : string)) "]"
                      | t =>
                          if real_core.union_type_is `t
                          then serialize_union `t x
                          else $'tostring(!x)       ' : string
                  ) : () -> string
              Fsharp = (fun () => $'$"%A{!x}"' : string) : () -> string
              Python =
                  (fun () =>
                      $'f"{!x}"' : string
                  ) : () -> string
              Rust =
                  (fun () =>
                      typecase t with
                      | char => $'Rc::<str>::from(format\!("{:?}", !x as char))' : string
                      | optionm'.option' ~a =>
                          if real_core.prim_type_is `a
                          then $'Rc::<str>::from(match &!x { Some(v) => format\!("Some {:?}", v), None => String::from("None") })' : string
                          else
                              inl x = $'Rc::new(RefCell::new(!x.clone().into_iter().collect::<Vec<_>>()))' : array_base a
                              if !!!!EQ(!!!!ArrayLength(`u64, x), 0u64) then "None"
                              else (++#*) "Some " (format_debug_element_rust `a !!!!ArrayIndex(x, 0u64))
                      | () * ~b =>
                          inl _, b = x
                          format_debug_real `b b
                      | ~a * ~b =>
                          inl a, b = x
                          (++#*) (format_debug_real `a a) ((++#*) ", " (format_debug_real `b b))
                      | array_base ~el =>
                          if real_core.prim_type_is `el
                          then $'Rc::<str>::from(format\!("{:?}", !x.borrow()))' : string
                          else format_debug_elements_rust `el x
                      | listm'.list' ~el =>
                          if real_core.prim_type_is `el
                          then format_debug_other_rust `t x
                          else format_debug_elements_rust `el ($'Rc::new(RefCell::new((*!x).clone()))' : array_base el)
                      | seq.seq' ~el =>
                          if real_core.prim_type_is `el
                          then format_debug_other_rust `t x
                          else format_debug_elements_rust `el ($'Rc::new(RefCell::new((*!x).clone()))' : array_base el)
                      | {} =>
                          inl _, fields =
                              real_core.record_fold
                                  fun { state = separator, acc key value } =>
                                      "; ", acc ++#* separator ++#* symbol_to_string_real `(`key) ++#* " = " ++#* format_debug_real `(`value) value
                                  ("", "") x
                          "{ " ++#* fields ++#* " }"
                      | _ => format_debug_other_rust `t x
                  ) : () -> string
              TypeScript =
                  (fun () =>
                      typecase t with
                      | char => $'"\'" + String.fromCharCode(!x) + "\'"' : string
                      | optionm'.option' ~a =>
                          if $'!x === undefined' : bool
                          then "None"
                          else (++#*) "Some " (format_debug_real `a ($'!x ' : a))
                      | () * ~b =>
                          inl _, b = x
                          format_debug_real `b b
                      | ~a * ~b =>
                          inl a, b = x
                          (++#*) (format_debug_real `a a) ((++#*) ", " (format_debug_real `b b))
                      | array_base ~el =>
                          if (typecase el with char => true | _ => false)
                          then $'"[" + !x.map((c: number) => "\'" + String.fromCharCode(c) + "\'").join(", ") + "]"' : string
                          elif real_core.prim_type_is `el
                          then $'"[" + !x.join(", ") + "]"' : string
                          else $'String(!x)' : string
                      | {} =>
                          inl _, fields =
                              real_core.record_fold
                                  fun { state = separator, acc key value } =>
                                      "; ", acc ++#* separator ++#* symbol_to_string_real `(`key) ++#* " = " ++#* format_debug_real `(`value) value
                                  ("", "") x
                          "{ " ++#* fields ++#* " }"
                      | _ =>
                          if real_core.union_type_is `t
                          then serialize_union_rust `t x
                          elif real_core.nominal_type_is `t
                          then
                              inl y = real_core.nominal_strip x
                              format_debug_real `(`y) y
                          else $'String(!x)' : string
                  ) : () -> string
              Zig =
                  (fun () =>
                      typecase t with
                      | char => $'(std.fmt.allocPrint(spiral_gpa, "\'{c}\'", .{ !x }) catch \@panic("out of memory"))' : string
                      | bool => $'(if (!x) "true" else "false")' : string
                      | () * ~b =>
                          inl _, b = x
                          format_debug_real `b b
                      | ~a * ~b =>
                          inl a, b = x
                          (++#*) (format_debug_real `a a) ((++#*) ", " (format_debug_real `b b))
                      | {} =>
                          inl _, fields =
                              real_core.record_fold
                                  fun { state = separator, acc key value } =>
                                      "; ", acc ++#* separator ++#* symbol_to_string_real `(`key) ++#* " = " ++#* format_debug_real `(`value) value
                                  ("", "") x
                          "{ " ++#* fields ++#* " }"
                      | _ =>
                          if real_core.union_type_is `t
                          then serialize_union_rust `t x
                          elif real_core.nominal_type_is `t
                          then
                              inl y = real_core.nominal_strip x
                              format_debug_real `(`y) y
                          elif real_core.prim_type_is `t
                          then $'(std.fmt.allocPrint(spiral_gpa, "{d}", .{ !x }) catch \@panic("out of memory"))' : string
                          else $'(std.fmt.allocPrint(spiral_gpa, "{any}", .{ !x }) catch \@panic("out of memory"))' : string
                  ) : () -> string
              Lean =
                  (fun () =>
                      typecase t with
                      | char => $'("\'" ++ toString !x ++ "\'")' : string
                      | () * ~b =>
                          inl _, b = x
                          format_debug_real `b b
                      | ~a * ~b =>
                          inl a, b = x
                          (++#*) (format_debug_real `a a) ((++#*) ", " (format_debug_real `b b))
                      | {} =>
                          inl _, fields =
                              real_core.record_fold
                                  fun { state = separator, acc key value } =>
                                      "; ", acc ++#* separator ++#* symbol_to_string_real `(`key) ++#* " = " ++#* format_debug_real `(`value) value
                                  ("", "") x
                          "{ " ++#* fields ++#* " }"
                      | _ =>
                          if real_core.union_type_is `t
                          then serialize_union_rust `t x
                          elif real_core.nominal_type_is `t
                          then
                              inl y = real_core.nominal_strip x
                              format_debug_real `(`y) y
                          else $'toString !x ' : string
                  ) : () -> string
          }
  and inl format_debug_other_rust forall t. (x : t) : string =
      if real_core.prim_type_is `t
      then $'Rc::<str>::from(format\!("{:?}", !x))' : string
      elif real_core.union_type_is `t
      then serialize_union_rust `t x
      elif real_core.nominal_type_is `t
      then
          inl payload forall u. (y : u) : string =
              typecase u with
              | {} => format_debug_real `u y
              | ~a -> ~b => $'Rc::<str>::from("<`t>")' : string
              | ~a * ~b => format_debug_real `u y
              | array_base _ => format_debug_real `u y
              | _ =>
                  if real_core.prim_type_is `u || real_core.union_type_is `u || real_core.nominal_type_is `u
                  then format_debug_real `u y
                  else $'Rc::<str>::from({ struct W<T>(T); trait D { fn s(&self) -> String; } impl<T: std::fmt::Debug> D for &W<T> { fn s(&self) -> String { format\!("{:?}", self.0) } } trait P { fn s(&self) -> String; } impl<T> P for W<T> { fn s(&self) -> String { String::from("<`t>") } } (&&W(&!y)).s() })' : string
          inl y = real_core.nominal_strip x
          payload `(`y) y
      else $'Rc::<str>::from("<`t>")' : string
  and inl format_debug_elements_rust forall el. (x : array_base el) : string =
      join
          inl n = !!!!ArrayLength(`u64, x)
          inl i = mut `u64 (real_core.dyn 0u64)
          inl s = mut `string (real_core.dyn "")
          loopw.while (fun () => !!!!LT(!!!!LayoutIndex(i), n)) fun () =>
              inl j = !!!!LayoutIndex(i)
              inl e = format_debug_element_rust `el !!!!ArrayIndex(x, j)
              s <- (if !!!!EQ(j, 0u64) then e else !!!!LayoutIndex(s) ++#* ", " ++#* e)
              i <- !!!!Add(j, 1u64)
          "[" ++#* !!!!LayoutIndex(s) ++#* "]"
      : string
  and inl format_debug_element_rust forall el. (x : el) : string =
      typecase el with
      | ~a * ~b => "(" ++#* format_debug_real `el x ++#* ")"
      | _ => format_debug_real `el x
  and inl serialize_union forall t. (x : t) : string =
      join
          $'if type(v0) ~= "table" then return tostring(v0) end' : ()
          real_core.unbox x fun k, v =>
              inl tag : string = $'__v[1].tag'
              typecase `v with
              | () => tag
              | ~a * ~b =>
                  typecase a with
                  | ~c * ~d =>
                      inl head_str = format_debug_real `c ($'__v[1]._1 ' : c)
                      inl tail_str = format_debug_real `d ($'__v[1]._2  ' : d)
                      inl x = format_debug_real `b ($'__v[1]._3   ' : b)
                      tag ++#* "(" ++#* head_str ++#* ", " ++#* tail_str ++#* ", " ++#* x ++#* ")"
                  | _ =>
                      inl head_str = format_debug_real `a ($'__v[1]._1    ' : a)
                      inl tail_str = format_debug_real `b ($'__v[1]._2     ' : b)
                      (++#*) tag ((++#*) "(" ((++#*) head_str ((++#*) ", " ((++#*) tail_str ")"))))
              | ~a =>
                  inl arg_str = format_debug_real `a ($'__v[1]._1' : a)
                  (++#*) tag ((++#*) "(" ((++#*) arg_str ")"))
      : string
  and inl serialize_union_rust forall t. (x : t) : string =
      join
          real_core.unbox x fun k, v =>
              inl name = symbol_to_string_real `(`k)
              typecase `v with
              | () => name
              | _ => (++#*) name ((++#*) "(" ((++#*) (format_debug_real `(`v) v) ")"))
      : string

  inl obj_to_string_rust_inner_real forall t. (x : t) : string =
      typecase t with
      | {} => format_debug_real `t x
      | ~a * ~b => format_debug_real `t x
      | ~a -> ~b => format_debug_real `t x
      | array_base _ => format_debug_real `t x
      | ~f ~a => format_debug_real `t x
      | _ =>
          if real_core.prim_type_is `t || real_core.union_type_is `t || real_core.nominal_type_is `t
          then format_debug_real `t x
          else $'Rc::<str>::from(format\!("{}", !x))' : string

  inl obj_to_string_rust_real forall t. (x : t) : string =
      typecase t with
      | char => $'Rc::<str>::from((!x as char).encode_utf8(&mut [0u8; 4]) as &str)' : string
      | string => x
      | ~f ~a => format_debug_real `t x
      | _ =>
          if real_core.nominal_type_is `t
          then
              inl x = real_core.nominal_strip x
              obj_to_string_rust_inner_real `(`x) x
          else format_debug_real `t x
  """,
  timeout: 300_000
)
```

### format_debug

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"inl format_debug forall t. (x : t) : string =\n    real format_debug_real `t x\n\ninl obj_to_string_rust forall t. (x : t) : string =\n    real obj_to_string_rust_real `t x\ninl obj_to_string_typescript forall t. (x : t) : string =\n    if (real typecase t with char => true | _ => false)\n    then $'String.fromCharCode(!x)' : string\n    else $'String(!x)' : string\ninl obj_to_string_zig forall t. (x : t) : string =\n    if (real typecase t with string => true | _ => false) then $'!x ' : string\n    elif (real typecase t with char => true | _ => false) then $'(std.fmt.allocPrint(spiral_gpa, \"{c}\", .{ !x }) catch \\@panic(\"out of memory\"))' : string\n    elif (real typecase t with bool => true | _ => false) then $'(if (!x) \"true\" else \"false\")' : string\n    elif (real typecase t with f32 => true | f64 => true | i8 => true | i16 => true | i32 => true | i64 => true | u8 => true | u16 => true | u32 => true | u64 => true | _ => false)\n    then $'(std.fmt.allocPrint(spiral_gpa, \"{d}\", .{ !x }) catch \\@panic(\"out of memory\"))' : string\n    else $'(std.fmt.allocPrint(spiral_gpa, \"{any}\", .{ !x }) catch \\@panic(\"out of memory\"))' : string","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  inl format_debug forall t. (x : t) : string =
      real format_debug_real `t x

  inl obj_to_string_rust forall t. (x : t) : string =
      real obj_to_string_rust_real `t x
  inl obj_to_string_typescript forall t. (x : t) : string =
      if (real typecase t with char => true | _ => false)
      then $'String.fromCharCode(!x)' : string
      else $'String(!x)' : string
  inl obj_to_string_zig forall t. (x : t) : string =
      if (real typecase t with string => true | _ => false) then $'!x ' : string
      elif (real typecase t with char => true | _ => false) then $'(std.fmt.allocPrint(spiral_gpa, "{c}", .{ !x }) catch \@panic("out of memory"))' : string
      elif (real typecase t with bool => true | _ => false) then $'(if (!x) "true" else "false")' : string
      elif (real typecase t with f32 => true | f64 => true | i8 => true | i16 => true | i32 => true | i64 => true | u8 => true | u16 => true | u32 => true | u64 => true | _ => false)
      then $'(std.fmt.allocPrint(spiral_gpa, "{d}", .{ !x }) catch \@panic("out of memory"))' : string
      else $'(std.fmt.allocPrint(spiral_gpa, "{any}", .{ !x }) catch \@panic("out of memory"))' : string
  """,
  timeout: 300_000
)
```

