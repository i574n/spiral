### range

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"inl range forall t. (start : am'.range t) (end : am'.range t) s =\n    inl is_start, start, end =\n        inl len () : int =\n            real\n                typecase t with\n                | int => length `t s\n                | _ => length' `t s\n        match start, end with\n        | Start start, End fn => true, start, len >> convert.to |> fn\n        | End start_fn, End end_fn => false, start_fn (len >> convert.to), end_fn (len >> convert.to)\n    inl start' = start |> convert.try_convert |> optionm.value : int\n    inl end' = end |> convert.try_convert |> optionm.value : int\n    inl start_is_var = start |> var_is\n    inl same_fixed = start = end && (start_is_var |> not) && (end |> var_is |> not)\n    inl start_var_s_fixed = start_is_var && (s |> var_is |> not)\n    inl trace () =\n        [\n            \"sm'.range\"\n            \" / (s |> var_is): \"; s |> var_is |> obj_to_string\n            \" // start: \"; start |> obj_to_string\n            \" / (start |> var_is): \"; start_is_var |> obj_to_string\n            \" // end: \"; end |> obj_to_string\n            \" / (end |> var_is): \"; end |> var_is |> obj_to_string\n            \" // same_fixed: \"; same_fixed |> obj_to_string\n            \" / start_var_s_fixed: \"; start_var_s_fixed |> obj_to_string\n        ]\n        |> concat_list \"\"\n    backend_switch {\n        Gleam = fun () =>\n            ()\n        Lua = id : () -> ()\n        Fsharp = id : () -> ()\n        Python = id : () -> ()\n        Rust = id : () -> ()\n        TypeScript = id : () -> ()\n        Zig = id : () -> ()\n    }\n    s |> slice start' (end' - (if is_start && (same_fixed || start_var_s_fixed) then 0 else 1))","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  inl range forall t. (start : am'.range t) (end : am'.range t) s =
      inl is_start, start, end =
          inl len () : int =
              real
                  typecase t with
                  | int => length `t s
                  | _ => length' `t s
          match start, end with
          | Start start, End fn => true, start, len >> convert.to |> fn
          | End start_fn, End end_fn => false, start_fn (len >> convert.to), end_fn (len >> convert.to)
      inl start' = start |> convert.try_convert |> optionm.value : int
      inl end' = end |> convert.try_convert |> optionm.value : int
      inl start_is_var = start |> var_is
      inl same_fixed = start = end && (start_is_var |> not) && (end |> var_is |> not)
      inl start_var_s_fixed = start_is_var && (s |> var_is |> not)
      inl trace () =
          [
              "sm'.range"
              " / (s |> var_is): "; s |> var_is |> obj_to_string
              " // start: "; start |> obj_to_string
              " / (start |> var_is): "; start_is_var |> obj_to_string
              " // end: "; end |> obj_to_string
              " / (end |> var_is): "; end |> var_is |> obj_to_string
              " // same_fixed: "; same_fixed |> obj_to_string
              " / start_var_s_fixed: "; start_var_s_fixed |> obj_to_string
          ]
          |> concat_list ""
      backend_switch {
          Gleam = fun () =>
              ()
          Lua = id : () -> ()
          Fsharp = id : () -> ()
          Python = id : () -> ()
          Rust = id : () -> ()
          TypeScript = id : () -> ()
          Zig = id : () -> ()
      }
      s |> slice start' (end' - (if is_start && (same_fixed || start_var_s_fixed) then 0 else 1))
  """,
  timeout: 300_000
)
```

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"///- --test\n///> gleam\n///> fsharp\n///> cuda\n///> rust\n///> typescript\n\n\"abcde\"\n|> range (am'.Start 0i32) (am'.End eval)\n|> _assert_eq \"abcde\"\n\n(join \"fghij\")\n|> range (am'.Start 1i32) (am'.End eval)\n|> _assert_eq \"ghij\"\n\n(join \"klmno\")\n|> range (am'.Start 1i32) (am'.End fun _ => 1)\n|> _assert_eq \"l\"\n\n\"pqrst\"\n|> range (am'.Start 1i32) (am'.End fun _ => 1)\n|> _assert_eq \"q\"\n\n\"uvwxy\"\n|> range (am'.Start (join 1i32)) (am'.End fun _ => 1)\n|> _assert_eq \"v\"\n\n\"zabcd\"\n|> range (am'.Start (join 1i32)) (am'.End fun _ => join 1)\n|> _assert_eq \"a\"\n\n(join \"efghi\")\n|> range (am'.Start 1i32) (am'.End fun _ => 5)\n|> _assert_eq \"fghi\"\n\n\"jklmn\"\n|> range (am'.End fun x => 1i32) (am'.End fun _ => join 5)\n|> _assert_eq \"klmn\"\n\n\"opqrs\"\n|> range (am'.End fun x => x () - 4i32) (am'.End fun x => x () - 1i32)\n|> _assert_eq \"pqr\"\n\n(join \"stuvw\")\n|> range (am'.End fun x => x () - 4i32) (am'.End fun x => x () - 1)\n|> _assert_eq \"tuv\"\n\n(join \"wxyza\")\n|> range (am'.Start (join 2i32)) (am'.End fun x => x () - 2)\n|> _assert_eq \"y\"\n\n(join \"bcdef\")\n|> range (am'.Start (join 2i32)) (am'.End fun x => x () - 3)\n|> _assert_eq \"\"\n\n(join \"ghijk\")\n|> range (am'.Start (join 1i32)) (am'.End fun x => x () - 3)\n|> _assert_eq \"h\"\n\n(join \"lmnop\")\n|> range (am'.Start (join 1i32)) (am'.End fun x => x () - 4)\n|> _assert_eq \"\"\n\n(join \"qrstu\")\n|> range (am'.End fun x => x () - 4i32) (am'.End fun _ => 4)\n|> _assert_eq \"rst\"\n\n\"vwxyz\"\n|> range (am'.End fun x => join x () - 4i32) (am'.End fun _ => 4)\n|> _assert_eq \"wxy\"","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  ///- --test
  ///> gleam
  ///> fsharp
  ///> cuda
  ///> rust
  ///> typescript

  "abcde"
  |> range (am'.Start 0i32) (am'.End eval)
  |> _assert_eq "abcde"

  (join "fghij")
  |> range (am'.Start 1i32) (am'.End eval)
  |> _assert_eq "ghij"

  (join "klmno")
  |> range (am'.Start 1i32) (am'.End fun _ => 1)
  |> _assert_eq "l"

  "pqrst"
  |> range (am'.Start 1i32) (am'.End fun _ => 1)
  |> _assert_eq "q"

  "uvwxy"
  |> range (am'.Start (join 1i32)) (am'.End fun _ => 1)
  |> _assert_eq "v"

  "zabcd"
  |> range (am'.Start (join 1i32)) (am'.End fun _ => join 1)
  |> _assert_eq "a"

  (join "efghi")
  |> range (am'.Start 1i32) (am'.End fun _ => 5)
  |> _assert_eq "fghi"

  "jklmn"
  |> range (am'.End fun x => 1i32) (am'.End fun _ => join 5)
  |> _assert_eq "klmn"

  "opqrs"
  |> range (am'.End fun x => x () - 4i32) (am'.End fun x => x () - 1i32)
  |> _assert_eq "pqr"

  (join "stuvw")
  |> range (am'.End fun x => x () - 4i32) (am'.End fun x => x () - 1)
  |> _assert_eq "tuv"

  (join "wxyza")
  |> range (am'.Start (join 2i32)) (am'.End fun x => x () - 2)
  |> _assert_eq "y"

  (join "bcdef")
  |> range (am'.Start (join 2i32)) (am'.End fun x => x () - 3)
  |> _assert_eq ""

  (join "ghijk")
  |> range (am'.Start (join 1i32)) (am'.End fun x => x () - 3)
  |> _assert_eq "h"

  (join "lmnop")
  |> range (am'.Start (join 1i32)) (am'.End fun x => x () - 4)
  |> _assert_eq ""

  (join "qrstu")
  |> range (am'.End fun x => x () - 4i32) (am'.End fun _ => 4)
  |> _assert_eq "rst"

  "vwxyz"
  |> range (am'.End fun x => join x () - 4i32) (am'.End fun _ => 4)
  |> _assert_eq "wxy"
  """,
  timeout: 300_000
)
```

### ellipsis_end

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"let ellipsis_end (max : i64) (s : string) =\n    inl len = s |> length\n    if len <= max\n    then s\n    else\n        inl half = (max |> convert.f64) / 2\n        inl start_half = half |> math.ceil |> convert.i64\n        inl end_half = half |> math.floor |> convert.i64\n        inl start = s |> slice 0 (start_half - 1)\n        inl end = s |> slice (len - end_half) (len - 1)\n        [ start; \"...\"; end ]\n        |> concat_list \"\"","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  let ellipsis_end (max : i64) (s : string) =
      inl len = s |> length
      if len <= max
      then s
      else
          inl half = (max |> convert.f64) / 2
          inl start_half = half |> math.ceil |> convert.i64
          inl end_half = half |> math.floor |> convert.i64
          inl start = s |> slice 0 (start_half - 1)
          inl end = s |> slice (len - end_half) (len - 1)
          [ start; "..."; end ]
          |> concat_list ""
  """,
  timeout: 300_000
)
```

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"///- --test\n///> gleam\n///> lua\n///> fsharp\n\n\"12345\"\n|> ellipsis_end 2\n|> _assert_eq \"1...5\"\n\n\"12345\"\n|> ellipsis_end 3\n|> _assert_eq \"12...5\"\n\n\"1234567\"\n|> ellipsis_end 4\n|> _assert_eq \"12...67\"","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  ///- --test
  ///> gleam
  ///> lua
  ///> fsharp

  "12345"
  |> ellipsis_end 2
  |> _assert_eq "1...5"

  "12345"
  |> ellipsis_end 3
  |> _assert_eq "12...5"

  "1234567"
  |> ellipsis_end 4
  |> _assert_eq "12...67"
  """,
  timeout: 300_000
)
```

