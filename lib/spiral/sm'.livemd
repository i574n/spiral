### replace

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"inl replace (old : string) (new : string) (s : string) : string =\n    backend_switch {\n        Gleam = fun () =>\n            global \"import gleam/string\"\n            $'!s |> string.replace(!old, !new)' : string\n        Lua = fun () =>\n            $'string.gsub(!s, !old, !new)' : string\n        Fsharp = fun () =>\n            $'!s.Replace (!old, !new)' : string\n        Python = fun () =>\n            $'!s.replace(!old, !new)' : string\n        Rust = fun () =>\n            $'Rc::<str>::from(!s.replace(&*!old, &*!new))' : string\n        TypeScript = fun () =>\n            $'!s.split(!old).join(!new)' : string\n        Zig = fun () =>\n            $'(std.mem.replaceOwned(u8, spiral_gpa, !s, !old, !new) catch \\@panic(\"out of memory\"))' : string\n        Lean = fun () =>\n            $'(!s).replace !old !new ' : string\n    }","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  inl replace (old : string) (new : string) (s : string) : string =
      backend_switch {
          Gleam = fun () =>
              global "import gleam/string"
              $'!s |> string.replace(!old, !new)' : string
          Lua = fun () =>
              $'string.gsub(!s, !old, !new)' : string
          Fsharp = fun () =>
              $'!s.Replace (!old, !new)' : string
          Python = fun () =>
              $'!s.replace(!old, !new)' : string
          Rust = fun () =>
              $'Rc::<str>::from(!s.replace(&*!old, &*!new))' : string
          TypeScript = fun () =>
              $'!s.split(!old).join(!new)' : string
          Zig = fun () =>
              $'(std.mem.replaceOwned(u8, spiral_gpa, !s, !old, !new) catch \@panic("out of memory"))' : string
          Lean = fun () =>
              $'(!s).replace !old !new ' : string
      }
  """,
  timeout: 300_000
)
```

### split

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"inl split (separator : string) (str : string) : array_base string =\n    backend_switch {\n        Gleam = fun () =>\n            global \"import gleam/string\"\n            ($'!str |> string.split(!separator)' : listm'.list' string)\n            |> listm'.to_array'\n        Fsharp = fun () => $'!str.Split !separator ' : array_base string\n        Python = fun () => $'!str.split(!separator)' : array_base string\n        Rust = fun () =>\n            $'Rc::new(RefCell::new(!str.split(&*!separator).map(|x| Rc::<str>::from(x)).collect::<Vec<Rc<str>>>()))'\n            : array_base string\n        TypeScript = fun () => $'!str.split(!separator)' : array_base string\n    }","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  inl split (separator : string) (str : string) : array_base string =
      backend_switch {
          Gleam = fun () =>
              global "import gleam/string"
              ($'!str |> string.split(!separator)' : listm'.list' string)
              |> listm'.to_array'
          Fsharp = fun () => $'!str.Split !separator ' : array_base string
          Python = fun () => $'!str.split(!separator)' : array_base string
          Rust = fun () =>
              $'Rc::new(RefCell::new(!str.split(&*!separator).map(|x| Rc::<str>::from(x)).collect::<Vec<Rc<str>>>()))'
              : array_base string
          TypeScript = fun () => $'!str.split(!separator)' : array_base string
      }
  """,
  timeout: 300_000
)
```

### split_string

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"inl split_string (separator : array_base string) (str : string) : array_base string =\n    run_target_args (fun () => str, separator) function\n        | Fsharp => fun str, separator => $'!str.Split (!separator, System.StringSplitOptions.None)'\n        | _ => fun str, separator => str |> split ((a separator : _ int _) |> seq.of_array |> concat (join \"\"))","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  inl split_string (separator : array_base string) (str : string) : array_base string =
      run_target_args (fun () => str, separator) function
          | Fsharp => fun str, separator => $'!str.Split (!separator, System.StringSplitOptions.None)'
          | _ => fun str, separator => str |> split ((a separator : _ int _) |> seq.of_array |> concat (join ""))
  """,
  timeout: 300_000
)
```

