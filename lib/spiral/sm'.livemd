### slice

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"inl slice forall t {number; int}. (from : t) (to : t) s : string =\n    inl to_py () =\n        if (s |> var_is) || (to |> var_is) || (from |> var_is) then to + 1 else to\n    inl trace () =\n        [\n            \"sm'.slice\"\n            \" / from: \"; from |> obj_to_string\n            \" / to: \"; to |> obj_to_string\n            \" / s |> var_is: \"; s |> var_is |> obj_to_string\n            \" / from |> var_is: \"; from |> var_is |> obj_to_string\n            \" / to |> var_is: \"; to |> var_is |> obj_to_string\n            \" / to_py (): \"; to_py () |> obj_to_string\n            \" / to_py () |> var_is: \"; to_py () |> var_is |> obj_to_string\n        ]\n        |> concat_list \"\"\n    backend_switch {\n        Gleam = fun () =>\n            sm.slice s { from to } : string\n        Lua = fun () => sm.slice s { from to } : string\n        Fsharp = fun () => sm.slice s { from to } : string\n        Python = fun () => sm.slice s { from to = to_py () } : string\n        Rust = fun () => sm.slice s { from to } : string\n        TypeScript = fun () => sm.slice s { from to } : string\n        Zig = fun () => sm.slice s { from to } : string\n        Lean = fun () => sm.slice s { from to } : string\n    }","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  inl slice forall t {number; int}. (from : t) (to : t) s : string =
      inl to_py () =
          if (s |> var_is) || (to |> var_is) || (from |> var_is) then to + 1 else to
      inl trace () =
          [
              "sm'.slice"
              " / from: "; from |> obj_to_string
              " / to: "; to |> obj_to_string
              " / s |> var_is: "; s |> var_is |> obj_to_string
              " / from |> var_is: "; from |> var_is |> obj_to_string
              " / to |> var_is: "; to |> var_is |> obj_to_string
              " / to_py (): "; to_py () |> obj_to_string
              " / to_py () |> var_is: "; to_py () |> var_is |> obj_to_string
          ]
          |> concat_list ""
      backend_switch {
          Gleam = fun () =>
              sm.slice s { from to } : string
          Lua = fun () => sm.slice s { from to } : string
          Fsharp = fun () => sm.slice s { from to } : string
          Python = fun () => sm.slice s { from to = to_py () } : string
          Rust = fun () => sm.slice s { from to } : string
          TypeScript = fun () => sm.slice s { from to } : string
          Zig = fun () => sm.slice s { from to } : string
          Lean = fun () => sm.slice s { from to } : string
      }
  """,
  timeout: 300_000
)
```

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"///- --test --print-code\n///> fsharp\n\n\"abcdef\"\n|> slice 3i32 3i32\n|> _assert_eq \"d\"\n\n\"abcdef\"\n|> slice 1i32 3i32\n|> slice 2i32 2i32\n|> _assert_eq \"d\"\n\n\"abcdef\"\n|> slice 1i32 4i32\n|> slice 2i32 3i32\n|> slice 1i32 1i32\n|> _assert_eq \"e\"","print_code":true},"livebook_object":"smart_cell"} -->

