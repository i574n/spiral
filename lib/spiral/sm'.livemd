### format_real

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"///- --real\n\nlet format_real forall t. (x : t) : string =\n    inl empty : string =\n        backend_switch `string `({}) {\n            Gleam =\n                (fun () =>\n                    \"\"\n                ) : () -> string\n            Lua =\n                (fun () =>\n                    \"\"\n                ) : () -> string\n            Fsharp =\n                (fun () =>\n                    join \"\"\n                ) : () -> string\n            Python =\n                (fun () =>\n                    \"\"\n                ) : () -> string\n            Rust =\n                (fun () =>\n                    \"\"\n                ) : () -> string\n            TypeScript =\n                (fun () =>\n                    \"\"\n                ) : () -> string\n            Zig =\n                (fun () =>\n                    \"\"\n                ) : () -> string\n            Lean =\n                (fun () =>\n                    \"\"\n                ) : () -> string\n        }\n    inl result = mut `string empty\n    inl rec write x =\n        inl p ((a : string), b) =\n            inl s : string =\n                backend_switch `string `({}) {\n                    Gleam =\n                        (fun () =>\n                            match b with\n                            | (_ : string) => b : string\n                            | _ => format_debug_real `(`b) b\n                        ) : () -> string\n                    Lua =\n                        (fun () =>\n                            match b with\n                            | (_ : string) => b : string\n                            | _ => format_debug_real `(`b) b\n                        ) : () -> string\n                    Fsharp =\n                        (fun () =>\n                            match b with\n                            | (_ : f32) | (_ : f64) => $'$\"%+.6f{!b}\"' : string\n                            | (_ : string) => b : string\n                            | _ => $'$\"{!b}\"' : string\n                        ) : () -> string\n                    Python =\n                        (fun () =>\n                            match b with\n                            | (_ : f32) | (_ : f64) => $'\"{:.6f}\".format(!b)' : string\n                            | (_ : string) => b : string\n                            | _ => $'f\"{!b}\"' : string\n                        ) : () -> string\n                    Rust =\n                        (fun () =>\n                            match b with\n                            | (_ : f32) | (_ : f64) => $'Rc::<str>::from({ let v = !b; if v.is_finite() { format\\!(\"{:+.6}\", v) } else if v.is_nan() { String::from(\"NaN\") } else if v > 0.0 { String::from(\"Infinity\") } else { String::from(\"-Infinity\") } })' : string\n                            | (_ : string) => b : string\n                            | (_ : char) => $'Rc::<str>::from(format\\!(\"{}\", !b as char))' : string\n                            | _ => $'Rc::<str>::from(format\\!(\"{}\", !b))' : string\n                        ) : () -> string\n                    TypeScript =\n                        (fun () =>\n                            match b with\n                            | (_ : f32) | (_ : f64) => $'(() => { const v = !b; return Number.isFinite(v) ? (v >= 0 ? \"+\" : \"\") + v.toFixed(6) : Number.isNaN(v) ? \"NaN\" : v > 0 ? \"Infinity\" : \"-Infinity\"; })()' : string\n                            | (_ : string) => b : string\n                            | (_ : char) => $'String.fromCharCode(!b)' : string\n                            | _ => $'String(!b)' : string\n                        ) : () -> string\n                    Zig =\n                        (fun () =>\n                            match b with\n                            | (_ : f32) | (_ : f64) => $'(if (std.math.isNan(!b)) \"NaN\" else if (std.math.isInf(!b)) (if (!b > 0) \"Infinity\" else \"-Infinity\") else (std.fmt.allocPrint(spiral_gpa, \"{s}{d:.6}\", .{ if (!b >= 0) \"+\" else \"\", !b }) catch \\@panic(\"out of memory\")))' : string\n                            | (_ : string) => b : string\n                            | (_ : char) => $'(std.fmt.allocPrint(spiral_gpa, \"{c}\", .{ !b }) catch \\@panic(\"out of memory\"))' : string\n                            | (_ : bool) => $'(if (!b) \"true\" else \"false\")' : string\n                            | _ => $'(std.fmt.allocPrint(spiral_gpa, \"{d}\", .{ !b }) catch \\@panic(\"out of memory\"))' : string\n                        ) : () -> string\n                    Lean =\n                        (fun () =>\n                            match b with\n                            | (_ : f32) | (_ : f64) => $'(if (!b).isNaN then \"NaN\" else if (!b).isInf then (if !b > 0 then \"Infinity\" else \"-Infinity\") else (if !b >= 0 then \"+\" else \"\") ++ toString !b)' : string\n                            | (_ : string) => b : string\n                            | _ => $'toString !b ' : string\n                        ) : () -> string\n                }\n            backend_switch `(()) `({}) {\n                Gleam =\n                    (fun () =>\n                        exec_unit ((fun () => result <- append_real s ((~*) `string result)) : () -> ())\n                    ) : () -> ()\n                Lua =\n                    (fun () =>\n                        exec_unit ((fun () => result <- append_real s ((~*) `string result)) : () -> ())\n                    ) : () -> ()\n                Fsharp =\n                    (fun () =>\n                        join\n                            result <- append_real s ((~*) `string result)\n                    ) : () -> ()\n                Python =\n                    (fun () =>\n                        join\n                            result <- append_real s ((~*) `string result)\n                    ) : () -> ()\n                Rust =\n                    (fun () =>\n                        join\n                            result <- append_real s ((~*) `string result)\n                    ) : () -> ()\n                TypeScript =\n                    (fun () =>\n                        join\n                            result <- append_real s ((~*) `string result)\n                    ) : () -> ()\n                Zig =\n                    (fun () =>\n                        join\n                            result <- append_real s ((~*) `string result)\n                    ) : () -> ()\n                Lean =\n                    (fun () =>\n                        join\n                            result <- append_real s ((~*) `string result)\n                    ) : () -> ()\n            }\n\n        match x with\n        | () => ()\n        | (x : i8) | (x : i16) | (x : i32) | (x : i64) => p (\"%d\", x)\n        | (x : u8) | (x : u16) | (x : u32) | (x : u64) => p (\"%u\", x)\n        | (x : f32) | (x : f64) => p (\"%f\", x)\n        | (x : string) => p (\"%s\", x)\n        | (x : char) => p (\"%c\", x)\n        | (x : bool) => p (\"%s\", if x then \"true\" else \"false\")\n        | (a,b) => write a . write \", \" . write b\n        | {} as x =>\n            write \"{ \"\n            inl _result =\n                real_core.record_fold\n                    fun { state = separator key value } =>\n                        write separator\n                        write (symbol_to_string_real `(`key)) . write \" = \" . write value\n                        \"; \"\n                    () x\n            write \" }\"\n        | x when real_core.symbol_is x => write (symbol_to_string_real `(`x))\n        | x when real_core.function_is x => write (x ())\n        | x when real_core.union_is x =>\n            if real_core.prototype_has `(`x) printable then printable `(`x) x\n            else\n                inl temp () =\n                    real_core.unbox x (fun (k, v) =>\n                        write k\n                        match v with\n                        | () => ()\n                        | _ => (join write \"(\" . write v . write \")\") : ()\n                        )\n                write (format_debug_real `(`x) x)\n        | x when real_core.nominal_is x =>\n            if real_core.prototype_has `(`x) printable then printable `(`x) x\n            else write (format_pretty_real `(`x) x)\n        | x => write (format_debug_real `(`x) x)\n    write x\n    (~*) `string result","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  ///- --real

  let format_real forall t. (x : t) : string =
      inl empty : string =
          backend_switch `string `({}) {
              Gleam =
                  (fun () =>
                      ""
                  ) : () -> string
              Lua =
                  (fun () =>
                      ""
                  ) : () -> string
              Fsharp =
                  (fun () =>
                      join ""
                  ) : () -> string
              Python =
                  (fun () =>
                      ""
                  ) : () -> string
              Rust =
                  (fun () =>
                      ""
                  ) : () -> string
              TypeScript =
                  (fun () =>
                      ""
                  ) : () -> string
              Zig =
                  (fun () =>
                      ""
                  ) : () -> string
              Lean =
                  (fun () =>
                      ""
                  ) : () -> string
          }
      inl result = mut `string empty
      inl rec write x =
          inl p ((a : string), b) =
              inl s : string =
                  backend_switch `string `({}) {
                      Gleam =
                          (fun () =>
                              match b with
                              | (_ : string) => b : string
                              | _ => format_debug_real `(`b) b
                          ) : () -> string
                      Lua =
                          (fun () =>
                              match b with
                              | (_ : string) => b : string
                              | _ => format_debug_real `(`b) b
                          ) : () -> string
                      Fsharp =
                          (fun () =>
                              match b with
                              | (_ : f32) | (_ : f64) => $'$"%+.6f{!b}"' : string
                              | (_ : string) => b : string
                              | _ => $'$"{!b}"' : string
                          ) : () -> string
                      Python =
                          (fun () =>
                              match b with
                              | (_ : f32) | (_ : f64) => $'"{:.6f}".format(!b)' : string
                              | (_ : string) => b : string
                              | _ => $'f"{!b}"' : string
                          ) : () -> string
                      Rust =
                          (fun () =>
                              match b with
                              | (_ : f32) | (_ : f64) => $'Rc::<str>::from({ let v = !b; if v.is_finite() { format\!("{:+.6}", v) } else if v.is_nan() { String::from("NaN") } else if v > 0.0 { String::from("Infinity") } else { String::from("-Infinity") } })' : string
                              | (_ : string) => b : string
                              | (_ : char) => $'Rc::<str>::from(format\!("{}", !b as char))' : string
                              | _ => $'Rc::<str>::from(format\!("{}", !b))' : string
                          ) : () -> string
                      TypeScript =
                          (fun () =>
                              match b with
                              | (_ : f32) | (_ : f64) => $'(() => { const v = !b; return Number.isFinite(v) ? (v >= 0 ? "+" : "") + v.toFixed(6) : Number.isNaN(v) ? "NaN" : v > 0 ? "Infinity" : "-Infinity"; })()' : string
                              | (_ : string) => b : string
                              | (_ : char) => $'String.fromCharCode(!b)' : string
                              | _ => $'String(!b)' : string
                          ) : () -> string
                      Zig =
                          (fun () =>
                              match b with
                              | (_ : f32) | (_ : f64) => $'(if (std.math.isNan(!b)) "NaN" else if (std.math.isInf(!b)) (if (!b > 0) "Infinity" else "-Infinity") else (std.fmt.allocPrint(spiral_gpa, "{s}{d:.6}", .{ if (!b >= 0) "+" else "", !b }) catch \@panic("out of memory")))' : string
                              | (_ : string) => b : string
                              | (_ : char) => $'(std.fmt.allocPrint(spiral_gpa, "{c}", .{ !b }) catch \@panic("out of memory"))' : string
                              | (_ : bool) => $'(if (!b) "true" else "false")' : string
                              | _ => $'(std.fmt.allocPrint(spiral_gpa, "{d}", .{ !b }) catch \@panic("out of memory"))' : string
                          ) : () -> string
                      Lean =
                          (fun () =>
                              match b with
                              | (_ : f32) | (_ : f64) => $'(if (!b).isNaN then "NaN" else if (!b).isInf then (if !b > 0 then "Infinity" else "-Infinity") else (if !b >= 0 then "+" else "") ++ toString !b)' : string
                              | (_ : string) => b : string
                              | _ => $'toString !b ' : string
                          ) : () -> string
                  }
              backend_switch `(()) `({}) {
                  Gleam =
                      (fun () =>
                          exec_unit ((fun () => result <- append_real s ((~*) `string result)) : () -> ())
                      ) : () -> ()
                  Lua =
                      (fun () =>
                          exec_unit ((fun () => result <- append_real s ((~*) `string result)) : () -> ())
                      ) : () -> ()
                  Fsharp =
                      (fun () =>
                          join
                              result <- append_real s ((~*) `string result)
                      ) : () -> ()
                  Python =
                      (fun () =>
                          join
                              result <- append_real s ((~*) `string result)
                      ) : () -> ()
                  Rust =
                      (fun () =>
                          join
                              result <- append_real s ((~*) `string result)
                      ) : () -> ()
                  TypeScript =
                      (fun () =>
                          join
                              result <- append_real s ((~*) `string result)
                      ) : () -> ()
                  Zig =
                      (fun () =>
                          join
                              result <- append_real s ((~*) `string result)
                      ) : () -> ()
                  Lean =
                      (fun () =>
                          join
                              result <- append_real s ((~*) `string result)
                      ) : () -> ()
              }

          match x with
          | () => ()
          | (x : i8) | (x : i16) | (x : i32) | (x : i64) => p ("%d", x)
          | (x : u8) | (x : u16) | (x : u32) | (x : u64) => p ("%u", x)
          | (x : f32) | (x : f64) => p ("%f", x)
          | (x : string) => p ("%s", x)
          | (x : char) => p ("%c", x)
          | (x : bool) => p ("%s", if x then "true" else "false")
          | (a,b) => write a . write ", " . write b
          | {} as x =>
              write "{ "
              inl _result =
                  real_core.record_fold
                      fun { state = separator key value } =>
                          write separator
                          write (symbol_to_string_real `(`key)) . write " = " . write value
                          "; "
                      () x
              write " }"
          | x when real_core.symbol_is x => write (symbol_to_string_real `(`x))
          | x when real_core.function_is x => write (x ())
          | x when real_core.union_is x =>
              if real_core.prototype_has `(`x) printable then printable `(`x) x
              else
                  inl temp () =
                      real_core.unbox x (fun (k, v) =>
                          write k
                          match v with
                          | () => ()
                          | _ => (join write "(" . write v . write ")") : ()
                          )
                  write (format_debug_real `(`x) x)
          | x when real_core.nominal_is x =>
              if real_core.prototype_has `(`x) printable then printable `(`x) x
              else write (format_pretty_real `(`x) x)
          | x => write (format_debug_real `(`x) x)
      write x
      (~*) `string result
  """,
  timeout: 300_000
)
```

### format

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"inl format forall t. (x : t) : string =\n    real format_real `t x","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  inl format forall t. (x : t) : string =
      real format_real `t x
  """,
  timeout: 300_000
)
```

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"///- --test\n///> gleam\n///> lua\n///> fsharp\n///> cuda\n///> rust\n///> typescript\n\n(\"1\", \"2\", [\"3\"; \"4\"], { b = \"5\"; c = \"6\"; a = fun () => \"7\" }, ;[ 8i32 ])\n|> format\n|> _assert_eq (\n    backend_switch {\n        Gleam = fun () => \"1, 2, Uh0i1(\\\"3\\\", Uh0i1(\\\"4\\\", Uh0i0)), { b = 5; c = 6; a = 7 }, [8]\" : string\n        Lua = fun () => \"1, 2, Uh0i1(3, Uh0i1(4, Uh0i0)), { b = 5; c = 6; a = 7 }, [8]\" : string\n        Fsharp = fun () =>\n            run_target function\n                | _ => fun () => join \"1, 2, UH0_1 (\\\"3\\\", UH0_1 (\\\"4\\\", UH0_0)), { b = 5; c = 6; a = 7 }, [|8|]\"\n            : string\n        Python = fun () => \"1, 2, UH0_1(v0='3', v1=UH0_1(v0='4', v1=UH0_0())), { b = 5; c = 6; a = 7 }, [8]\" : string\n        Rust = fun () => \"1, 2, Cons(3, Cons(4, Nil)), { b = 5; c = 6; a = 7 }, [8]\" : string\n        TypeScript = fun () => \"1, 2, Cons(3, Cons(4, Nil)), { b = 5; c = 6; a = 7 }, [8]\" : string\n    }\n)","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  ///- --test
  ///> gleam
  ///> lua
  ///> fsharp
  ///> cuda
  ///> rust
  ///> typescript

  ("1", "2", ["3"; "4"], { b = "5"; c = "6"; a = fun () => "7" }, ;[ 8i32 ])
  |> format
  |> _assert_eq (
      backend_switch {
          Gleam = fun () => "1, 2, Uh0i1(\"3\", Uh0i1(\"4\", Uh0i0)), { b = 5; c = 6; a = 7 }, [8]" : string
          Lua = fun () => "1, 2, Uh0i1(3, Uh0i1(4, Uh0i0)), { b = 5; c = 6; a = 7 }, [8]" : string
          Fsharp = fun () =>
              run_target function
                  | _ => fun () => join "1, 2, UH0_1 (\"3\", UH0_1 (\"4\", UH0_0)), { b = 5; c = 6; a = 7 }, [|8|]"
              : string
          Python = fun () => "1, 2, UH0_1(v0='3', v1=UH0_1(v0='4', v1=UH0_0())), { b = 5; c = 6; a = 7 }, [8]" : string
          Rust = fun () => "1, 2, Cons(3, Cons(4, Nil)), { b = 5; c = 6; a = 7 }, [8]" : string
          TypeScript = fun () => "1, 2, Cons(3, Cons(4, Nil)), { b = 5; c = 6; a = 7 }, [8]" : string
      }
  )
  """,
  timeout: 300_000
)
```

