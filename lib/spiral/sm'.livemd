  |> trim_start []
  |> _assert_eq "abc  "

  "abcde"
  |> trim_start []
  |> _assert_eq "abcde"

  "abcde"
  |> trim_start [ 'a' ]
  |> _assert_eq "bcde"

  "abcde"
  |> trim_start [ 'b'; 'a' ]
  |> _assert_eq "cde"

