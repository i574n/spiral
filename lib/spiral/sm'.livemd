### trim_end

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"inl trim_end (chars : list char) (input : string) : string =\n    inl chars = if chars = [] then trim_chars () else chars\n    inl len = input |> length\n    let rec 루프 (i : int) =\n        if i <= 0\n        then -1\n        elif input |> index (i - 1) |> char_contains chars\n        then 루프 (i - 1)\n        else i - 1\n    input |> slice 0 (루프 len)","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  inl trim_end (chars : list char) (input : string) : string =
      inl chars = if chars = [] then trim_chars () else chars
      inl len = input |> length
      let rec 루프 (i : int) =
          if i <= 0
          then -1
          elif input |> index (i - 1) |> char_contains chars
          then 루프 (i - 1)
          else i - 1
      input |> slice 0 (루프 len)
  """,
  timeout: 300_000
)
```

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"///- --test\n///> gleam\n///> fsharp\n///> cuda\n\n\"  def  \"\n|> trim_end []\n|> _assert_eq \"  def\"\n\n\"abcde\"\n|> trim_end []\n|> _assert_eq \"abcde\"\n\n\"abcde\"\n|> trim_end [ 'e' ]\n|> _assert_eq \"abcd\"\n\n\"abcde\"\n|> trim_end [ 'e'; 'd' ]\n|> _assert_eq \"abc\"\n\n\"abcde\"\n|> trim_end [ 'e'; 'd'; 'c' ]\n|> _assert_eq \"ab\"","print_code":false},"livebook_object":"smart_cell"} -->

