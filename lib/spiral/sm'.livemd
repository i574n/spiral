### contains

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"inl contains (value : string) (s : string) : bool =\n    backend_switch {\n        Gleam = fun () =>\n            global \"import gleam/string\"\n            $'!s |> string.contains(!value)' : bool\n        Lua = fun () => $'string.find(!s, !value, 1, true) ~= nil ' : bool\n        Fsharp = fun () => $'!s.Contains !value ' : bool\n        Python = fun () => $'!value in !s ' : bool\n        Rust = fun () => $'!s.contains(&*!value)' : bool\n        TypeScript = fun () => $'!s.includes(!value)' : bool\n        Zig = fun () => $'(std.mem.indexOf(u8, !s, !value) \\!= null)' : bool\n        Lean = fun () => $'(!s).contains !value ' : bool\n    }","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  inl contains (value : string) (s : string) : bool =
      backend_switch {
          Gleam = fun () =>
              global "import gleam/string"
              $'!s |> string.contains(!value)' : bool
          Lua = fun () => $'string.find(!s, !value, 1, true) ~= nil ' : bool
          Fsharp = fun () => $'!s.Contains !value ' : bool
          Python = fun () => $'!value in !s ' : bool
          Rust = fun () => $'!s.contains(&*!value)' : bool
          TypeScript = fun () => $'!s.includes(!value)' : bool
          Zig = fun () => $'(std.mem.indexOf(u8, !s, !value) \!= null)' : bool
          Lean = fun () => $'(!s).contains !value ' : bool
      }
  """,
  timeout: 300_000
)
```

### to_string result t u

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"instance to_string result t u = fun x =>\n    real\n        open rust\n        typecase (t * u) with\n        | string * string =>\n            match x with\n            | Ok x => x\n            | Error x => \"sm'.to_string result / Error: \" ++# x\n        | std_string * std_string =>\n            match x with\n            | Ok x => from_std_string x\n            | Error x => \"sm'.to_string result / Error: \" ++# from_std_string x\n        | _ => obj_to_string `u x","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  instance to_string result t u = fun x =>
      real
          open rust
          typecase (t * u) with
          | string * string =>
              match x with
              | Ok x => x
              | Error x => "sm'.to_string result / Error: " ++# x
          | std_string * std_string =>
              match x with
              | Ok x => from_std_string x
              | Error x => "sm'.to_string result / Error: " ++# from_std_string x
          | _ => obj_to_string `u x
  """,
  timeout: 300_000
)
```

