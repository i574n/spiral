)
```

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"///- --test\n///> gleam\n///> fsharp\n///> cuda\n///> rust\n///> typescript\n\n\"12345\"\n|> ellipsis 2\n|> _assert_eq \"12...\"\n\n\"12345\"\n|> ellipsis 4\n|> _assert_eq \"1234...\"","print_code":false},"livebook_object":"smart_cell"} -->

