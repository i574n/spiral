### format_pretty_real

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"///- --real\n\ninl format_pretty_real forall t. (x : t) : string =\n    run_target_args `string `t (fun () => x) function\n        | Rust => fun x =>\n            inl rec structural forall u. () : bool =\n                typecase u with\n                | optionm'.option' ~a => if real_core.prim_type_is `a then false else true\n                | listm'.list' ~a => if real_core.prim_type_is `a then false else true\n                | seq.seq' ~a => if real_core.prim_type_is `a then false else true\n                | array_base ~a => if real_core.prim_type_is `a then false else true\n                | ~a * ~b => if structural `a () then true else structural `b ()\n                | {} => real_core.record_type_fold (fun acc key => forall v. => if acc then true else structural `v ()) false `u\n                | _ => real_core.union_type_is `u\n            if structural `t ()\n            then format_debug_real `t x\n            else\n                open rust\n                inl result = rust.emit_expr `t `std_string_real x ($'\"format\\!(\\\\\\\"{:\\#?}\\\\\\\", $0)\"' : string)\n                from_std_string_real result\n        | _ => fun _ => format_debug_real `t x","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  ///- --real

  inl format_pretty_real forall t. (x : t) : string =
      run_target_args `string `t (fun () => x) function
          | Rust => fun x =>
              inl rec structural forall u. () : bool =
                  typecase u with
                  | optionm'.option' ~a => if real_core.prim_type_is `a then false else true
                  | listm'.list' ~a => if real_core.prim_type_is `a then false else true
                  | seq.seq' ~a => if real_core.prim_type_is `a then false else true
                  | array_base ~a => if real_core.prim_type_is `a then false else true
                  | ~a * ~b => if structural `a () then true else structural `b ()
                  | {} => real_core.record_type_fold (fun acc key => forall v. => if acc then true else structural `v ()) false `u
                  | _ => real_core.union_type_is `u
              if structural `t ()
              then format_debug_real `t x
              else
                  open rust
                  inl result = rust.emit_expr `t `std_string_real x ($'"format\!(\\\"{:\#?}\\\", $0)"' : string)
                  from_std_string_real result
          | _ => fun _ => format_debug_real `t x
  """,
  timeout: 300_000
)
```

