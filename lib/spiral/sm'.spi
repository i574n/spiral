    #?*{ c = "1"; a = "2"; b = "3" }
    |> _assert_eq (
        backend_switch {
            Gleam = \ () => "#(\"1\", \"2\", \"3\")" : string
            Lua = \ () => "1, 2, 3" : string
            Fsharp = \ () => "struct (\"1\", \"2\", \"3\")" : string
            Python = \ () => "('1', '2', '3')" : string
        }
    )

/// ### unwrap_format
:+ unwrap_format option t = \ x =>
    x
    |> optionm.value
    |> format_debug

:+ unwrap_format result t u = \ x =>
    x
    |> resultm.get
    |> format_debug

/// ### obj_to_string
:= obj_to_string \* t. (x : t) : string =
    ? ~> show_composite_real `t () ?> ~> show_real `t x
    |:
        backend_switch {
            Gleam = \ () => #?*x : string
            Lua = \ () => #?*x : string
            Fsharp = \ () => obj_to_string_fsharp x
            Python = \ () => obj_to_string_python x
            Rust = \ () => obj_to_string_rust x
            TypeScript = \ () => obj_to_string_typescript x
            Zig = \ () => obj_to_string_zig x
            Lean = \ () => $'toString !x ' : string
            Wasm = \ () => obj_to_string_wasm x
        }

///> fsharp
///> cuda
///> rust
///> zig
test obj_to_string_prints_bools_lowercase =
    (obj_to_string (dyn !+), obj_to_string (dyn !-)) |> _assert_eq ("true", "false")

/// ### (~#?**)
:= (~#?**) s =
    s |> obj_to_string

/// ### concat_list
:~ ^ concat_pass (separator : string) (input : list string) (paired : list string) : list string =
    ?= input ?|
    | left :: right :: rest => concat_pass separator rest (left ++# separator ++# right :: paired)
    | last :: Nil => listm.rev (last :: paired)
    | Nil => listm.rev paired

:~ ^ concat_balanced (separator : string) (input : list string) : string =
    ?= input ?|
    | Nil => ""
    | only :: Nil => only
    | _ => concat_balanced separator (concat_pass separator input Nil)

:= concat_right_fold separator input =
    (input, { acc = ""; sep = "" })
    ||> listm.foldBack \ (x : string) { acc sep } => {
        acc = x ++# sep ++# acc
        sep = separator
    }
    |> \ { acc } => acc

:= concat_list separator input : string =
    backend_switch {
        Gleam = \ () => concat_balanced separator input
        Lua = \ () => concat_right_fold separator input
        Fsharp = \ () => concat_right_fold separator input
        Python = \ () => concat_right_fold separator input
        Cpp = \ () => concat_right_fold separator input
        CppHost = \ () => concat_right_fold separator input
        Rust = \ () => concat_right_fold separator input
        TypeScript = \ () => concat_right_fold separator input
        Zig = \ () => concat_right_fold separator input
        Lean = \ () => concat_right_fold separator input
        C = \ () => concat_right_fold separator input
        Delphi = \ () => concat_right_fold separator input
        Wasm = \ () => concat_right_fold separator input
        Bend = \ () => concat_right_fold separator input
        Kotlin = \ () => concat_right_fold separator input
        Swift = \ () => concat_right_fold separator input
    }

///> gleam
///> fsharp
///> cuda
///> rust
///> typescript
test concat_list print_code =
    [
        "1"
        "2"
        "3"
    ]
    |> \ x =>
        := code = (x : _) |> concat_list "\n"
        code
        |> _assert_eq """
            1
            2
            3
            """

/// ### slice
:= slice \* t {number; int}. (from : t) (to : t) s : string =
    backend_switch {
        Gleam = \ () =>
            sm.slice s { from to } : string
        Lua = \ () => sm.slice s { from to } : string
        C = \ () => sm.slice s { from to } : string
        Fsharp = \ () => sm.slice s { from to } : string
        Python = \ () => sm.slice s { from to } : string
        Rust = \ () => sm.slice s { from to } : string
        TypeScript = \ () => sm.slice s { from to } : string
        Zig = \ () => sm.slice s { from to } : string
        Lean = \ () => sm.slice s { from to } : string
    }

///> fsharp
test slice print_code =
    "abcdef"
    |> slice 3i32 3i32
    |> _assert_eq "d"

    "abcdef"
    |> slice 1i32 3i32
    |> slice 2i32 2i32
    |> _assert_eq "d"

    "abcdef"
    |> slice 1i32 4i32
    |> slice 2i32 3i32
    |> slice 1i32 1i32
    |> _assert_eq "e"

///> gleam
///> lua
///> fsharp
///> cuda
test slice_2 =
    "abcdef"
    |> slice 1i32 3i32
    |> _assert_eq "bcd"

    (~~ "fghij")
    |> slice 1i32 3i32
    |> _assert_eq "ghi"

    "klmno"
    |> slice 1i32 (~~ 3i32)
    |> _assert_eq "lmn"

    (~~ "pqrst")
    |> slice 1i32 (~~ 3i32)
    |> _assert_eq "qrs"

    "uvwxy"
    |> slice (~~ 1i32) 3i32
    |> _assert_eq "vwx"

    (~~ "zabcd")
    |> slice (~~ 1i32) 3i32
    |> _assert_eq "abc"

    "efghi"
    |> slice (~~ 1i32) (~~ 3i32)
    |> _assert_eq "fgh"

    (~~ "efghi")
    |> slice (~~ 1i32) (~~ 3i32)
    |> _assert_eq "fgh"

    "abcdef"
    |> slice 3i32 4i32
    |> _assert_eq "de"

    (~~ "efghi")
    |> slice (~~ 3i32) (~~ 4i32)
    |> _assert_eq "hi"

    "bcde"
    |> slice (~~ 0i32) 0i32
    |> _assert_eq "b"

/// ### format_pretty_real

/// ### format_pretty
:= format_pretty \* t. (x : t) : string =
    ~> format_pretty_real `t x

/// ### prim
:= prim x = ~>
    ?= x ?|
    | (x : i8) | (x : i16) | (x : i32) | (x : i64) => "%d", x
    | (x : u8) | (x : u16) | (x : u32) | (x : u64) => "%u", x
    | (x : f32) | (x : f64) => "%f", x
    | (x : string) => "%s", x
    | (x : char) => "%c", x

/// ### printable

/// ### format_real

/// ### format
:= format \* t. (x : t) : string =
    ~> show_real `t x

///> gleam
///> lua
///> fsharp
///> cuda
///> rust
///> typescript
///> c
test format =
    ("1", "2", [ "3"; "4" ], { b = "5"; c = "6"; a = \ () => "7" }, ;[ 8i32 ])
    |> format
    |> _assert_eq "(1, 2, Cons(3, Cons(4, Nil)), { b = 5; c = 6; a = 7 }, [8])"

/// ### format_fixed_digits
:= format_fixed_digits (decimals : i32) (x : f64) : string =
    := negative = x < 0.0
    := magnitude = ? negative ?> 0.0 - x |: x
    :~ ^ up (v : f64) (e : i32) : f64 * i32 =
        ? v > 0.0 && v < 4503599627370496.0 ?> up (v * 2.0) (e - 1) |: v, e
    :~ ^ down (v : f64) (e : i32) : f64 * i32 =
        ? v >= 9007199254740992.0 ?> down (v / 2.0) (e + 1) |: v, e
    := raised, raised_by = up magnitude 0
    := mantissa, exponent = down raised raised_by
    := digits : array i32 = create 1200
    :~ ^ clear (i : i32) : () =
        ? i < 1200 ?>
            set digits i 0
            clear (i + 1)
    clear 0
    :~ ^ put (m : u64) (i : i32) : i32 =
        ? m = 0u64
        ?> i
        |:
            set digits i (conv (m % 10u64))
            put (m / 10u64) (i + 1)
    := scale_by (factor : i32) (length : i32) : i32 =
        :~ ^ spill (j : i32) (carry : i32) : i32 =
            ? carry = 0
            ?> j
            |:
                set digits j (carry % 10)
                spill (j + 1) (carry / 10)
        :~ ^ go (i : i32) (carry : i32) : i32 =
            ? i < length
            ?>
                := t = am'.index i digits * factor + carry
                set digits i (t % 10)
                go (i + 1) (t / 10)
            |: spill length carry
        go 0 0
    :~ ^ repeat (times : i32) (factor : i32) (length : i32) : i32 =
        ? times <= 0 ?> length |: repeat (times - 1) factor (scale_by factor length)
    := started = put (conv mantissa) 0
    := scaled = repeat decimals 10 started
    := length, drop =
        ? exponent >= 0 ?> repeat exponent 2 scaled, 0 |: repeat (0 - exponent) 5 scaled, 0 - exponent
    :~ ^ lower_nonzero (i : i32) : bool =
        ? i < 0 ?> !- |? am'.index i digits <> 0 ?> !+ |: lower_nonzero (i - 1)
    := rounds_up =
        ? drop <= 0
        ?> !-
        |:
            := top = am'.index (drop - 1) digits
            := odd = drop < length && am'.index drop digits % 2 = 1
            top > 5 || top = 5 && (lower_nonzero (drop - 2) || odd)
    :~ ^ carry_from (i : i32) (length : i32) : i32 =
        := t = am'.index i digits + 1
        set digits i (t % 10)
        := grown = ? i >= length ?> i + 1 |: length
        ? t < 10 ?> grown |: carry_from (i + 1) grown
    := final = ? rounds_up ?> carry_from drop length |: length
    := top = ? final - drop > decimals + 1 ?> final - 1 |: drop + decimals
    :~ ^ leading (i : i32) : i32 =
        ? i > drop + decimals && am'.index i digits = 0 ?> leading (i - 1) |: i
    := first = leading top
    := digit_text (d : i32) : string =
        ? d = 0 ?> "0" |? d = 1 ?> "1" |? d = 2 ?> "2" |? d = 3 ?> "3" |? d = 4 ?> "4"
        |? d = 5 ?> "5" |? d = 6 ?> "6" |? d = 7 ?> "7" |? d = 8 ?> "8" |: "9"
    :~ ^ text (i : i32) (acc : string) : string =
        ? i < drop
        ?> acc
        |:
            := point = ? decimals > 0 && i = drop + decimals - 1 ?> "." |: ""
            text (i - 1) (acc ++# point ++# digit_text (am'.index i digits))
    (? negative ?> "-" |: "") ++# text first ""

/// ### format_fixed
:= format_fixed (decimals : i32) (x : f64) : string =
    backend_switch {
        Fsharp = \ () =>
            $'(!x).ToString("F" + string !decimals, System.Globalization.CultureInfo.InvariantCulture)' : string
        Lua = \ () => $'string.format("%." .. !decimals .. "f", !x)' : string
        Python = \ () => $'format(!x, "." + str(!decimals) + "f")' : string
        Rust = \ () => $'Rc::<str>::from(format\!("{:.*}", !decimals as usize, !x).as_str())' : string
        TypeScript = \ () => $'(!x).toFixed(!decimals)' : string
        C = \ () => format_fixed_digits decimals x
        Gleam = \ () => format_fixed_digits decimals x
        Zig = \ () => format_fixed_digits decimals x
    }

///> rust
///> fsharp
///> lua
///> python
///> typescript
///> c
///> gleam
///> zig
test format_fixed_avoids_ties =
    (
        2.0 / 3.0 |> format_fixed 3,
        0.0 - 1.0 / 3.0 |> format_fixed 1,
        12.0 |> format_fixed 0,
        0.000000001 |> format_fixed 3,
        1234.5678 |> format_fixed 2
    )
    |> _assert_eq ("0.667", "-0.3", "12", "0.000", "1234.57")

///> c
///> gleam
///> zig
test format_fixed_digits_rounds_exact_ties_to_even =
    (
        0.125 |> format_fixed 2,
        2.5 |> format_fixed 0,
        2.675 |> format_fixed 2,
        9.995 |> format_fixed 2,
        0.0 - 0.04 |> format_fixed 1,
        10000000000000000000000.0 |> format_fixed 2
    )
    |> _assert_eq ("0.12", "2", "2.67", "9.99", "-0.0", "10000000000000000000000.00")

