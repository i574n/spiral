    "abc"
    |> to_char_array
    |> format
    |> _assert_eq #?(;[ 'a'; 'b'; 'c' ])

/// ### concat_array
inl concat_array (separator : string) (input : array string) : string =
    run_target function
        | Rust => fun () =>
            $'Rc::<str>::from((*!input).borrow().iter().map(|x| &**x).collect::<Vec<&str>>().join(&*!separator).as_str\
                ())'
            : string
        | _ => fun () =>
            ({ acc = ""; sep = "" }, input)
            ||> arraym.fold fun { acc sep } (x : string) =>
                    { acc = acc ++# sep ++# x; sep = separator }
            |> fun { acc } => acc

///> fsharp
///> rust
///> typescript
///> cuda
test concat_array print_code =
    ;[
        "1"
        "2"
        "3"
    ]
    |> fun x =>
        inl code = x |> concat_array "\n"
        code
        |> _assert_eq """
            1
            2
            3
            """

///> rust
test a_growable_array_joins_in_one_pass =
    inl items : array string = am'.growable ()
    am'.push_back "a" items
    am'.push_back "" items
    am'.push_back "b" items
    items |> concat_array "\n" |> _assert_eq "a\n\nb"
    (am'.growable () : array string) |> concat_array "," |> _assert_eq ""

/// ### ellipsis
inl ellipsis (max : i32) (s : string) =
    if sm.length s <= max
    then s
    else s |> slice 0 (max - 1) |> append "..."

///> gleam
///> fsharp
///> cuda
///> rust
///> typescript
test ellipsis =
    "12345"
    |> ellipsis 2
    |> _assert_eq "12..."

    "12345"
    |> ellipsis 4
    |> _assert_eq "1234..."

/// ## fsharp

/// ### gleam_dynamic
nominal gleam_dynamic = $'Dynamic'

/// ### last_index_of_gleam
inl last_index_of_gleam () =
    global "import gleam/bit_array"
    global "import gleam/dynamic.{type Dynamic}"
    global "import gleam/erlang/atom"
    global """
        @external(erlang, "string", "find")
        fn spiral_sm_find_trailing(text: String, search: String, direction: atom.Atom) -> Dynamic

        @external(erlang, "gleam_stdlib", "identity")
        fn spiral_sm_coerce(value: a) -> b
        """

/// ### gleam_byte_size
inl gleam_byte_size (s : string) : i32 =
    last_index_of_gleam ()
    $'bit_array.byte_size(bit_array.from_string(!s))' : i32

/// ### gleam_find_trailing
inl gleam_find_trailing (search : string) (s : string) : gleam_dynamic =
    last_index_of_gleam ()
    $'spiral_sm_find_trailing(!s, !search, atom.create("trailing"))' : gleam_dynamic

/// ### gleam_is_nomatch
inl gleam_is_nomatch (found : gleam_dynamic) : bool =
    $'!found == spiral_sm_coerce(atom.create("nomatch"))' : bool

/// ### gleam_dynamic_text
inl gleam_dynamic_text (found : gleam_dynamic) : string =
    $'spiral_sm_coerce(!found)' : string

/// ### last_index_of
inl last_index_of (search : string) (s : string) : i32 =
    inl search = dyn search
    run_target function
        | Zig => fun () =>
            ($'std.mem.lastIndexOf(u8, !s, !search)' : optionm'.option' convert.unativeint)
            |> optionm'.map (fun i => convert.convert i)
            |> optionm'.unwrap_or -1i32
        | Rust => fun () =>
            ($'!s.rfind(&*!search)' : optionm'.option' convert.unativeint)
            |> optionm'.map (fun i => convert.convert i)
            |> optionm'.unwrap_or -1i32
        | Gleam => fun () =>
            if search = "" then gleam_byte_size s
            else
                inl found = gleam_find_trailing search s
                if gleam_is_nomatch found then -1i32 else gleam_byte_size s - gleam_byte_size (gleam_dynamic_text found)
        | _ => fun () => $'!s.LastIndexOf !search ' : i32

///> rust
///> gleam
test last_index_of_finds_the_last_match_in_bytes =
    inl ~s = "abcabc"
    (last_index_of "bc" s, last_index_of "x" s, last_index_of "" s) |> _assert_eq (4i32, -1i32, 6i32)

/// ### index_of_char_from
inl index_of_char_from (from : i32) (c : char) (s : string) : i32 =
    inl len = s |> length
    inl rec body i =
        if i >= len
        then -1i32
        elif c = (s |> index i)
        then i - from
        else 루프 (i + 1i32)
    and inl 루프 i = join_body_unit body (if var_is i then i else len) i
    from |> 루프

test index_of_char_from =
    "abcdefabc"
    |> index_of_char_from 2i32 'a'
    |> _assert_eq 4i32

/// ### portable_matches_at
inl portable_matches_at (search : string) (s : string) (at : i32) : bool =
    inl m : i32 = sm.length search
    let rec same (k : i32) : bool =
        if k >= m then true
        elif sm.index s (at + k) = sm.index search k then same (k + 1)
        else false
    same 0

/// ### portable_index_of
inl portable_index_of (search : string) (s : string) : i32 =
    inl n : i32 = sm.length s
    inl m : i32 = sm.length search
    let rec scan (at : i32) : i32 =
        if at + m > n then -1i32
        elif portable_matches_at search s at then at
        else scan (at + 1)
    scan 0

/// ### gleam_split_once_head
inl gleam_split_once_head (search : string) (s : string) : optionm'.option' string =
    global "import gleam/pair"
    global "import gleam/result"
    global "import gleam/string"
    $'option.from_result(result.map(string.split_once(!s, !search), pair.first))' : optionm'.option' string

/// ### index_of
inl index_of (search : string) (s : string) : int =
    backend_switch {
        Gleam = fun () =>
            if search = "" then 0
            else
                match gleam_split_once_head search s |> optionm'.unbox with
                | Some head => gleam_byte_size head
                | None => -1
        Lua = fun () =>
            inl found = $'string.find(!s, !search, 1, true)' : optionm'.option' int
            optionm'.default_value' 0 found - 1
        Fsharp = fun () => $'(!s).IndexOf(!search, System.StringComparison.Ordinal)' : int
        Python = fun () =>
            inl found = $'(!s).find(!search)' : int
            if found < 0 then -1 else $'len((!s)[:!found].encode("utf-8", "surrogateescape"))' : int
        Rust = fun () =>
            ($'!s.find(&*!search)' : optionm'.option' convert.unativeint)
            |> optionm'.map (fun i => convert.convert i)
            |> optionm'.unwrap_or -1
        C = fun () => conv (portable_index_of search s) : int
        TypeScript = fun () => $'!s.indexOf(!search)' : int
        Zig = fun () =>
            ($'std.mem.indexOf(u8, !s, !search)' : optionm'.option' convert.unativeint)
            |> optionm'.map (fun i => convert.convert i)
            |> optionm'.unwrap_or -1
        Lean = fun () =>
            if search = "" then 0
            else
                inl pieces = $'`int.ofNat ((!s).splitOn !search).length' : int
                inl head = $'((!s).splitOn !search).headD ""' : string
                if pieces <= 1 then -1 else $'`int.ofNat (!head).utf8ByteSize' : int
    }

///> gleam
///> fsharp
///> cuda
///> rust
///> typescript
test index_of =
    "123"
    |> index_of "2"
    |> _assert_eq 1

///> gleam
///> rust
///> cuda
///> lua
test index_of_counts_utf8_bytes_and_whole_needles =
    ("é/x" |> index_of "/", "abcabc" |> index_of "ca", "abc" |> index_of "z")
    |> _assert_eq (2, 2, -1)

/// ### replicate
inl replicate (n : int) (s : string) : string =
    inl rec body i acc =
        if i >= n
        then acc
        else 루프 (i + 1) (acc ++# s)
    and inl 루프 i = join_body_unit body n i
    루프 0 ""

///> gleam
///> fsharp
test replicate =
    "12"
    |> replicate (join 3)
    |> _assert_eq "121212"

///> gleam
///> fsharp
test replicate_2 print_code =
    "12"
    |> replicate 3
    |> _assert_eq "121212"

///> gleam
///> fsharp
///> cuda
///> rust
///> typescript
test replicate_3 =
    "12"
    |> replicate 3
    |> _assert_eq "121212"

/// ### pad_left
inl pad_left (total_width : int) (padding_char : char) (s : string) : string =
    inl padding = padding_char |> obj_to_string |> replicate (total_width - length s)
    padding ++# s

/// ### pad_right
inl pad_right (total_width : int) (padding_char : char) (s : string) : string =
    inl padding = padding_char |> obj_to_string |> replicate (total_width - length s)
    s ++# padding

