///> fsharp
///> cuda
test symbol_to_string =
    .test
    |> symbol_to_string
    |> _assert_eq "test"

/// ### index
inl index i (str : string) : char =
    i |> sm.index str

/// ### length
inl length forall dim {int}. (input : string) : dim =
    input |> sm.length

///> gleam
///> fsharp
///> cuda
test length =
    "abc"
    |> length
    |> _assert_eq 3i32

/// ### (~##)
inl (~##) s : int =
    s |> length

/// ### to_char_list
inl to_char_list (str : string) : list char =
    listm.init (str |> length) (fun (i : i64) => str |> index i)

///> gleam
///> fsharp
///> cuda
test to_char_list =
    "abc"
    |> to_char_list
    |> _assert_eq [ 'a'; 'b'; 'c' ]

/// ### to_char_array
inl to_char_array (str : string) : array_base char =
    am'.init_base (str |> length) (fun i => str |> index i)

///> lua
///> gleam
///> fsharp
///> cuda
test to_char_array =
    "abc"
    |> to_char_array
    |> fun x => array x : array _
    |> am'.to_list'
    |> listm'.unbox
    |> _assert_eq [ 'a'; 'b'; 'c' ]

/// ### is_empty
inl is_empty (input : string) : bool =
    (input |> length) = 0i32

/// ### to_option
inl to_option s =
    if s |> is_empty
    then None
    else s |> Some

/// ### string_builder_real

/// ### string_builder
type string_builder = string_builder_real

inl string_builder (initial : string) : string_builder =
    inl initial =
        if initial = ""
        then join initial
        else initial

    backend_switch {
        Gleam = fun () => $'!initial ' : string_builder
        Lua = fun () => $'!initial ' : string_builder
        Fsharp = fun () => initial |> $'`string_builder ' : string_builder
        Python = fun () =>
            global "import io"
            global """
                class CustomStringIO(io.StringIO):
                    def __init__(self, init=''):
                        super().__init__()
                        if init != '': self.write(init)
                    def __str__(self): return self.getvalue()
                    def __repr__(self): return self.getvalue()
                """
            $'CustomStringIO(!initial)' : string_builder
        Rust = fun () => $'String::from(&*!initial)' : string_builder
        TypeScript = fun () => $'!initial ' : string_builder
        Zig = fun () => $'!initial ' : string_builder
    }

/// ### append_real

/// ### append
inl append (x : string) (s : string) : string =
    real append_real x s

/// ### (++#*)

/// ### (++#)
inl (++#) (a : string) (b : string) : string =
    real (++#*) a b

/// ### (++\\\\#)
inl (++\\#) a b =
    a ++# "\\n" ++# b

/// ### (++\\#)
inl (++\#) a b =
    a ++# "\n" ++# b

/// ### format_debug_real

/// ### format_debug
inl format_debug forall t. (x : t) : string =
    real format_debug_real `t x

inl obj_to_string_rust forall t. (x : t) : string =
    real obj_to_string_rust_real `t x
inl obj_to_string_fsharp forall t. (x : t) : string =
    if (real typecase t with bool => true | _ => false)
    then $'(if !x then "true" else "false")' : string
    else $'!x |> _.ToString()' : string
inl obj_to_string_python forall t. (x : t) : string =
    if (real typecase t with bool => true | _ => false)
    then $'("true" if !x else "false")' : string
    else $'str(!x)' : string
inl obj_to_string_typescript forall t. (x : t) : string =
    if (real typecase t with char => true | _ => false)
    then $'String.fromCharCode(!x)' : string
    else $'String(!x)' : string
inl obj_to_string_wasm forall t. (x : t) : string =
    if (real typecase t with string => true | _ => false) then $'!x ' : string
    elif (real typecase t with bool => true | _ => false) then $'(call $bool_to_str !x)' : string
    elif (real typecase t with char => true | _ => false) then $'(call $char_to_str !x)' : string
    elif (real typecase t with i64 => true | _ => false) then $'(call $i64_to_str !x)' : string
    elif (real typecase t with u64 => true | _ => false) then $'(call $u64_to_str !x)' : string
    elif (real typecase t with i8 => true | i16 => true | i32 => true | _ => false) then $'(call $i64_to_str \
        (i64.extend_i32_s !x))' : string
    elif (real typecase t with u8 => true | u16 => true | u32 => true | _ => false) then $'(call $u64_to_str \
        (i64.extend_i32_u !x))' : string
    else $'backend_switch_has_no_Wasm_arm_in_lib_spiral' : string
inl obj_to_string_zig forall t. (x : t) : string =
    if (real typecase t with string => true | string_builder_real => true | _ => false)
    then $'!x ' : string
    elif (real typecase t with char => true | _ => false)
    then $'(std.fmt.allocPrint(spiral_gpa, "{c}", .{ !x }) catch \@panic("out of memory"))' : string
    elif (real typecase t with bool => true | _ => false)
    then $'(if (!x) "true" else "false")' : string
    elif
        real
            typecase t with
            | f32 => true
            | f64 => true
            | i8 => true
            | i16 => true
            | i32 => true
            | i64 => true
            | u8 => true
            | u16 => true
            | u32 => true
            | u64 => true
            | _ => false
    then $'(std.fmt.allocPrint(spiral_gpa, "{d}", .{ !x }) catch \@panic("out of memory"))' : string
    else $'(std.fmt.allocPrint(spiral_gpa, "{any}", .{ !x }) catch \@panic("out of memory"))' : string

/// ### (~#?*)
inl (~#?*) s =
    s |> format_debug

