    !\\(s, $'"std::ffi::CString::new($0).unwrap()"')

/// ### os_to_str
inl os_to_str (s : os_string) : optionm'.option' (rust.ref str) =
    !\\(s, $'"$0.to_str()"')

/// ### from_os_str_ref
inl from_os_str_ref s =
    s
    |> to_os_string
    |> os_to_str
    |> optionm'.unwrap
    |> ref_to_std_string
    |> from_std_string

/// ### format_custom'
inl format_custom' (f : string) x : std_string =
    run_target function
        | Rust => fun () =>
            !\\(x, $'"format\!(\\\"" + !f + "\\\", $0)"')
        | _ => fun () => null ()

/// ### format_debug'
inl format_debug' x : std_string =
    run_target function
        | Rust => fun () =>
            !\\(x, $'"format\!(\\\"{:?}\\\", $0)"')
        | _ => fun () => null ()

/// ### format'
inl format' x : std_string =
    run_target_args (fun () => x) function
        | Rust => fun x =>
            !\\(x, $'"format\!(\\\"{}\\\", $0)"')
        | _ => fun _ => null ()

/// ### format_hex'
inl format_hex' x : std_string =
    !\\(x, $'"format\!(\\\"{:02x}\\\", $0)"')

/// ### format''
inl format'' (format : string) : std_string =
    !\($'@@$"format\!(" + !format + ")"')

