/// ### format_fixed_digits
inl format_fixed_digits (decimals : i32) (x : f64) : string =
    inl negative = x < 0.0
    inl magnitude = if negative then 0.0 - x else x
    let rec up (v : f64) (e : i32) : f64 * i32 =
        if v > 0.0 && v < 4503599627370496.0 then up (v * 2.0) (e - 1) else v, e
    let rec down (v : f64) (e : i32) : f64 * i32 =
        if v >= 9007199254740992.0 then down (v / 2.0) (e + 1) else v, e
    inl raised, raised_by = up magnitude 0
    inl mantissa, exponent = down raised raised_by
    inl digits : array i32 = create 1200
    let rec clear (i : i32) : () =
        if i < 1200 then
            set digits i 0
            clear (i + 1)
    clear 0
    let rec put (m : u64) (i : i32) : i32 =
        if m = 0u64
        then i
        else
            set digits i (conv (m % 10u64))
            put (m / 10u64) (i + 1)
    inl scale_by (factor : i32) (length : i32) : i32 =
        let rec spill (j : i32) (carry : i32) : i32 =
            if carry = 0
            then j
            else
                set digits j (carry % 10)
                spill (j + 1) (carry / 10)
        let rec go (i : i32) (carry : i32) : i32 =
            if i < length
            then
                inl t = am'.index i digits * factor + carry
                set digits i (t % 10)
                go (i + 1) (t / 10)
            else spill length carry
        go 0 0
    let rec repeat (times : i32) (factor : i32) (length : i32) : i32 =
        if times <= 0 then length else repeat (times - 1) factor (scale_by factor length)
    inl started = put (conv mantissa) 0
    inl scaled = repeat decimals 10 started
    inl length, drop =
        if exponent >= 0 then repeat exponent 2 scaled, 0 else repeat (0 - exponent) 5 scaled, 0 - exponent
    let rec lower_nonzero (i : i32) : bool =
        if i < 0 then false elif am'.index i digits <> 0 then true else lower_nonzero (i - 1)
    inl rounds_up =
        if drop <= 0
        then false
        else
            inl top = am'.index (drop - 1) digits
            inl odd = drop < length && am'.index drop digits % 2 = 1
            top > 5 || top = 5 && (lower_nonzero (drop - 2) || odd)
    let rec carry_from (i : i32) (length : i32) : i32 =
        inl t = am'.index i digits + 1
        set digits i (t % 10)
        inl grown = if i >= length then i + 1 else length
        if t < 10 then grown else carry_from (i + 1) grown
    inl final = if rounds_up then carry_from drop length else length
    inl top = if final - drop > decimals + 1 then final - 1 else drop + decimals
    let rec leading (i : i32) : i32 =
        if i > drop + decimals && am'.index i digits = 0 then leading (i - 1) else i
    inl first = leading top
    inl digit_text (d : i32) : string =
        if d = 0 then "0" elif d = 1 then "1" elif d = 2 then "2" elif d = 3 then "3" elif d = 4 then "4"
        elif d = 5 then "5" elif d = 6 then "6" elif d = 7 then "7" elif d = 8 then "8" else "9"
    let rec text (i : i32) (acc : string) : string =
        if i < drop
        then acc
        else
            inl point = if decimals > 0 && i = drop + decimals - 1 then "." else ""
            text (i - 1) (acc ++# point ++# digit_text (am'.index i digits))
    (if negative then "-" else "") ++# text first ""

/// ### format_fixed
inl format_fixed (decimals : i32) (x : f64) : string =
    backend_switch {
        Fsharp = fun () =>
            $'(!x).ToString("F" + string !decimals, System.Globalization.CultureInfo.InvariantCulture)' : string
        Lua = fun () => $'string.format("%." .. !decimals .. "f", !x)' : string
        Python = fun () => $'format(!x, "." + str(!decimals) + "f")' : string
        Rust = fun () => $'Rc::<str>::from(format\!("{:.*}", !decimals as usize, !x).as_str())' : string
        TypeScript = fun () => $'(!x).toFixed(!decimals)' : string
        C = fun () => format_fixed_digits decimals x
        Gleam = fun () => format_fixed_digits decimals x
        Zig = fun () => format_fixed_digits decimals x
    }

///> rust
///> fsharp
///> lua
///> python
///> typescript
///> c
///> gleam
///> zig
test format_fixed_avoids_ties =
    (
        2.0 / 3.0 |> format_fixed 3,
        0.0 - 1.0 / 3.0 |> format_fixed 1,
        12.0 |> format_fixed 0,
        0.000000001 |> format_fixed 3,
        1234.5678 |> format_fixed 2
    )
    |> _assert_eq ("0.667", "-0.3", "12", "0.000", "1234.57")

///> c
///> gleam
///> zig
test format_fixed_digits_rounds_exact_ties_to_even =
    (
        0.125 |> format_fixed 2,
        2.5 |> format_fixed 0,
        2.675 |> format_fixed 2,
        9.995 |> format_fixed 2,
        0.0 - 0.04 |> format_fixed 1,
        10000000000000000000000.0 |> format_fixed 2
    )
    |> _assert_eq ("0.12", "2", "2.67", "9.99", "-0.0", "10000000000000000000000.00")

