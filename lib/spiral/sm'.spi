    #?*("1", "2", "3")
    |> _assert_eq (
        backend_switch {
            Gleam = \ () => "#(\"1\", \"2\", \"3\")" : string
            Lua = \ () => "1, 2, 3" : string
            Fsharp = \ () => "struct (\"1\", \"2\", \"3\")" : string
            Python = \ () => "('1', '2', '3')" : string
        }
    )

