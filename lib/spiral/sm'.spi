test builder_append =
    "ab"
    |> string_builder
    |> builder_append "cd"
    |> builder_append "ef"
    |> obj_to_string
    |> _assert_eq "abcdef"

/// ### builder_append_line
inl builder_append_line (sb : string_builder) : string_builder =
