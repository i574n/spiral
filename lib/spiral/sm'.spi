/// ### raw_string_literal
:= raw_string_literal (s : string) : rust.ref str =
    backend_switch {
        Fsharp = \ () => !\($'"r\#\\"" + !s + "\\"\#"') : rust.ref str
        Rust = \ () => $'(&*!s)' : rust.ref str
    }

/// ### raw_string_literal_static
:= raw_string_literal_static (s : string) : rust.static_ref str =
    backend_switch {
        Fsharp = \ () => !\($'"r\#\\"" + !s + "\\"\#"') : rust.static_ref str
        Rust = \ () => $'Box::leak(String::from(&*!s).into_boxed_str())' : rust.static_ref str
    }

/// ### (~#)
:= (~#) s =
    s |> raw_string_literal

/// ### (~###)
:= (~###) s =
    s |> raw_string_literal_static

/// ### include_str
:= include_str (path : string) : rust.ref str =
    !\($'"include_str\!(\\\"" + !path + "\\\")"')

/// ### as_str
:= as_str (s : string) : rust.ref str =
    run_target_args (\ () => s) \|
        | Rust => \ s => !\\(s, $'"&*$0"')
        | _ => convert.unbox

/// ### from_iter
:= from_iter \* (t : * -> *). (s : t char) : std_string =
    !\\(s, $'"String::from_iter($0)"')

/// ### ref_to_std_string
:= ref_to_std_string (str : rust.ref str) : std_string =
    run_target_args (\ () => str) \|
        | Rust => \ str => !\\(str, $'"String::from($0)"')
        | _ => convert.unbox

/// ### cow_to_std_string
:= cow_to_std_string (str : rust.cow str) : std_string =
    !\\(str, $'"String::from($0)"')

/// ### to_std_string
:= to_std_string (s : string) : std_string =
    s |> as_str |> ref_to_std_string

/// ### as_str_std
:= as_str_std (s : std_string) : rust.ref str =
    !\\(s, $'"$0.as_str()"')

/// ### into_boxed_str
:= into_boxed_str (s : std_string) : rust.box str =
    !\\(s, $'"$0.into_boxed_str()"')

/// ### to_os_string
:= to_os_string (s : rust.ref os_str) : os_string =
    !\\(s, $'"$0.to_os_string()"')

/// ### new_c_string
:= new_c_string (s : std_string) : c_string =
    !\\(s, $'"std::ffi::CString::new($0).unwrap()"')

/// ### os_to_str
:= os_to_str (s : os_string) : optionm'.option' (rust.ref str) =
    !\\(s, $'"$0.to_str()"')

/// ### from_os_str_ref
:= from_os_str_ref s =
    s
    |> to_os_string
    |> os_to_str
    |> optionm'.unwrap
    |> ref_to_std_string
    |> from_std_string

/// ### format_custom'
:= format_custom' (f : string) x : std_string =
    run_target \|
        | Rust => \ () =>
            !\\(x, $'"format\!(\\\"" + !f + "\\\", $0)"')
        | _ => \ () => null ()

/// ### format_debug'
:= format_debug' x : std_string =
    run_target \|
        | Rust => \ () =>
            !\\(x, $'"format\!(\\\"{:?}\\\", $0)"')
        | _ => \ () => null ()

/// ### format'
:= format' x : std_string =
    run_target_args (\ () => x) \|
        | Rust => \ x =>
            !\\(x, $'"format\!(\\\"{}\\\", $0)"')
        | _ => \ _ => null ()

/// ### format_hex'
:= format_hex' x : std_string =
    !\\(x, $'"format\!(\\\"{:02x}\\\", $0)"')

/// ### format''
:= format'' (format : string) : std_string =
    !\($'@@$"format\!(" + !format + ")"')

/// ### regex
:! regex =
    `(
        rust.rust_type
            `($'regex_Regex')
            `($'regex::Regex')
            "type regex_Regex = class end"
    )

/// ### regex_error
:! regex_error =
    `(
        rust.rust_type
            `($'regex_Error')
            `($'regex::Error')
            "type regex_Error = class end"
    )

/// ### new_regex
:= new_regex (pattern : string) : resultm.result' regex regex_error =
    !\\(pattern, $'$"regex::Regex::new(&$0)"')

/// ### captures
:! regex_captures t =
    `(
        rust.rust_type
            `($'regex_Captures<`t>')
            `($'regex::Captures<`t>')
            "type regex_Captures<'T> = class end"
    )

/// ### regex_capture_matches
:! regex_capture_matches =
    `(
        rust.rust_type
            `($'regex_CaptureMatches')
            `($'regex::CaptureMatches')
            "type regex_CaptureMatches = class end"
    )

/// ### regex_capture_names
:! regex_capture_names =
    `(
        rust.rust_type
            `($'regex_CaptureNames')
            `($'regex::CaptureNames')
            "type regex_CaptureNames = class end"
    )

:= regex_capture_names (regex : regex) : regex_capture_names =
    !\\(regex, $'$"$0.capture_names()"')

/// ### match'
:! match' =
    `(
        rust.rust_type
            `($'regex_Match')
            `($'regex::Match')
            "type regex_Match = class end"
    )

/// ### regex_captures_iter
:= regex_captures_iter (s : rust.static_ref (rust.mut' std_string)) (regex : regex) : regex_capture_matches =
    := regex = regex |> rust.emit
    !\\(regex, $'$"$0.captures_iter(!s)"')

/// ### regex_captures
:~ regex_captures (s : string) (regex : regex) : am'.vec (mapm.hash_map string string) =

    := s = s |> to_std_string
    \ () =>
        := matches =
            := s = s |> rust.new_box |> rust.box_leak
            regex |> regex_captures_iter s

        (!\($'"true; let _regex_captures : Vec<_> = !matches.map(|x| { //"') : bool) |> ignore

        := fn
            (match' : rust.static_ref (rust.mut' (regex_captures rust.static_lifetime)))
            : mapm.hash_map string string
            =

            := names = regex |> regex_capture_names

            (!\($'"true; let _regex_captures : std::collections::HashMap<_, _> = !names.map(|x| { //"') : bool)
            |> ignore

            := fn (n : string) : pair string string =
                := n' = n |> rust.clone

                new_pair n' !\\(n, $'$"!match'.name(&$0).map(|x| x.as_str()).unwrap_or(\\\"\\\").to_string().into()"')

            (!\\(fn !\($'"x.unwrap_or(\\\"\\\").to_string().into()"'), $'"true; $0 }).collect()"') : bool) |> ignore

            !\($'"_regex_captures"')

        := x =
            !\($'$"x"')
            |> rust.new_box
            |> rust.box_leak

        (!\\(fn x, $'"true; $0 }).collect::<Vec<_>>()"') : bool) |> ignore

        !\($'"_regex_captures"')

    |> rust.capture_move

///> rust -d regex
test regex_captures =
    "fable-library-ts\\.(?<a>[\\d.]+)$"
    |> new_regex
    |> resultm.unwrap'
    |> regex_captures "fable_modules/fable-library-ts.4.17.0"
    |> am'.vec_map (mapm.to_vec >> am'.vec_sort_by_key id)
    |> format_debug
    |> _assert_eq (
        am'.base ;[
            am'.base ;[ "", ""; "a", "4.17.0" ]
            |> am'.to_vec
        ]
        |> am'.to_vec
        |> format_debug
    )

/// ### serialize
:= serialize \* t. (x : t) : resultm.result' std_string json_error =
    !\($'"serde_json::to_string(&!x)"')

/// ### deserialize
:= deserialize \* t. (json : string) : resultm.result' t std_string =
    := json = ~~ json
    := json = json |> as_str
    !\\(json, $'"serde_json::from_str(&$0)"')
    |> resultm.map_error' \ (x : json_error) => x |> format'

/// ### borsh_serialize
:= borsh_serialize \* t. (data : t) : am'.vec u8 =
    (!\($'"true; let mut data = Vec::new()"') : bool) |> ignore
    (!\\(data, $'"true; borsh::BorshSerialize::serialize(&$0, &mut data).unwrap()"') : bool) |> ignore
    !\($'"data"')

/// ### borsh_deserialize
:= borsh_deserialize \* t. (data : array_base u8) : resultm.result' t std_string =
    := data = data |> am'.as_slice
    (!\($'"true; let mut !data = !data"') : bool) |> ignore
    := result = !\($'"borsh::BorshDeserialize::deserialize(&mut !data)"')
    result
    |> resultm.map_error' \ (x : borsh_io_error) => x |> format'

/// ### deserialize_vec
:= deserialize_vec (value : json_value) : resultm.result' (am'.vec u8) std_string =
    := value = ~~ value
    !\($'"serde_json::from_value(!value)"')
    |> resultm.map_error' \ (x : json_error) => x |> format'

/// ### encode_uri_component
:= encode_uri_component (s : std_string) : js_string =
    !\($'"js_sys::encode_uri_component(&!s)"')

/// ### percent_encode_gleam
:= percent_encode_gleam () =
    global """
        @external(erlang, "binary", "bin_to_list")
        fn spiral_sm_utf8_bytes(text: String) -> List(Int)
        """

/// ### utf8_byte_list
:= utf8_byte_list (s : string) : listm'.list' u8 =
    backend_switch {
        Gleam = \ () =>
            percent_encode_gleam ()
            $'spiral_sm_utf8_bytes(!s)' : listm'.list' u8
        Rust = \ () => $'Rc::new(!s.bytes().collect())' : listm'.list' u8
    }

/// ### percent_unreserved
:= percent_unreserved (b : u8) : bool =
    (b >= 48u8 && b <= 57u8) || (b >= 65u8 && b <= 90u8) || (b >= 97u8 && b <= 122u8)
    || b = 45u8 || b = 46u8 || b = 95u8 || b = 126u8

/// ### ascii_text
:= ascii_text (b : u8) : string =
    := position : int = conv b - 32
    := upper = " !\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ"
    := table = upper ++# "[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~"
    slice position position table

/// ### hex_digit
:= hex_digit (n : u8) : string =
    := position : int = conv n
    slice position position "0123456789ABCDEF"

/// ### percent_byte
:= percent_byte (b : u8) : string =
    ? percent_unreserved b ?> ascii_text b |: "%" ++# hex_digit (b >>> 4i32) ++# hex_digit (b &&& 15u8)

/// ### percent_encode
:= percent_encode (s : string) : string =
    s
    |> utf8_byte_list
    |> listm'.fold' percent_byte Nil
    |> listm.fold (\ acc piece => piece ++# acc) ""

///> rust
///> gleam
test percent_encode_keeps_only_unreserved =
    := ~text = "a b+c,d!~-._/é"
    percent_encode text |> _assert_eq "a%20b%2Bc%2Cd%21~-._%2F%C3%A9"

/// ### strip_prefix
:= strip_prefix (prefix : char) (s : std_string) : optionm'.option' (rust.ref str) =
    := s = ~~ s
    !\($'"!s.strip_prefix((!prefix) as char)"')

/// ### str_from_utf8
:= str_from_utf8 (bytes : rust.ref (am'.slice u8)) : resultm.result' (rust.ref str) utf8_error =
    !\\(bytes, $'"std::str::from_utf8($0)"')

/// ### string_from_utf8
:= string_from_utf8 (bytes : am'.vec u8) : resultm.result' std_string from_utf8_error =
    := bytes = ~~ bytes
    !\\(bytes, $'"std::string::String::from_utf8($0)"')

/// ### encoding'
:! encoding' =
    `(
        rust.rust_type
            `($'encoding_rs_Encoding')
            `($'encoding_rs::Encoding')
            "type encoding_rs_Encoding = class end"
    )

/// ### encoding_utf8'
:= encoding_utf8' () : rust.ref encoding' =
    !\($'"encoding_rs::UTF_8"')

/// ### encoding_1252
:= encoding_1252' () : rust.ref encoding' =
    !\($'"encoding_rs::WINDOWS_1252"')

/// ### encoding_encode
:= encoding_encode' (encoding : rust.ref encoding') (text : string) : rust.cow (am'.slice u8) =
    !\\((encoding, text), $'"$0.encode(&*$1).0"')

/// ### windows
:! windows t =
    `(
        rust.rust_type
            `($'std_slice_Windows<`t>')
            `($'std::slice::Windows<`t>')
            "type std_slice_Windows<'T> = class end"
    )

:= windows (len : convert.unativeint) (source : am'.vec u8) : windows u8 =
    := source = source |> rust.new_box |> rust.box_leak
    := result = !\\(len, $'"<[_]>::windows(!source, $0)"')
    result

/// ### any
:= any \* t. (fn : string -> bool) (source : windows t) : bool =
    (!\($'"true; let mut !source = !source"') : bool) |> ignore
    := fn' x =
        x
        |> str_from_utf8
        |> resultm.unwrap_or' #""
        |> ref_to_std_string
        |> from_std_string
        |> fn
    !\\(fn', $'"!source.any(move |x| $0(x))"')

/// ### slice_contains
:= slice_contains (text : string) (source : am'.vec u8) : bool =
    \ () =>
        := source = ~~ source
        source
        |> windows (text |> length |> (\ x => x : i32) |> convert.convert)
        |> any ((=.) text)
    |> \ x => ~~ x ()

/// ### as_bytes
:= as_bytes (text : string) : rust.ref (am'.slice u8) =
    := text = ~~ text
    !\($'"!text.as_bytes()"')

/// ### into_bytes
:= into_bytes (x : std_string) : am'.vec u8 =
    backend_switch {
        Rust = \ () => $'(!x).as_bytes().to_vec()' : am'.vec u8
    }

/// ## python

/// ### encode_utf8
:= encode_utf8 (s : string) : string =
    := encoding = "utf-8"
    backend_switch {
        Python = \ () =>
            $'!s.encode(!encoding)' : string
    }

/// ## sm'

/// ### contains
:= contains (value : string) (s : string) : bool =
    backend_switch {
        Gleam = \ () =>
            global "import gleam/string"
            $'!s |> string.contains(!value)' : bool
        Lua = \ () => $'string.find(!s, !value, 1, true) ~= nil ' : bool
        Fsharp = \ () => $'!s.Contains !value ' : bool
        Python = \ () => $'!value in !s ' : bool
        Rust = \ () => $'!s.contains(&*!value)' : bool
        TypeScript = \ () => $'!s.includes(!value)' : bool
        Zig = \ () => $'(std.mem.indexOf(u8, !s, !value) \!= null)' : bool
        C = \ () => portable_index_of value s >= 0i32
        Lean = \ () => $'(!s).contains !value ' : bool
    }

///> c
///> gleam
///> rust
test searches_agree_on_c =
    (
        "a.b%c" |> index_of ".",
        "a.b%c" |> index_of "%",
        "a.b%c" |> index_of "y",
        "a.b%c" |> index_of "",
        "a.b%c" |> index_of "b%c"
    )
    |> _assert_eq (1, 3, -1, 0, 2)
    (
        "a.b%c" |> contains "%c",
        "a.b%c" |> contains "x",
        "a.b%c" |> starts_with "a.",
        "a.b%c" |> starts_with "b",
        "a.b%c" |> ends_with "%c",
        "a.b%c" |> ends_with "a",
        "" |> ends_with ""
    )
    |> _assert_eq (!+, !-, !+, !-, !+, !-, !+)

/// ### to_string result t u
:+ to_string result t u = \ x =>
    ~>
        :< rust
        ?: (t * u) ?|
        | string * string =>
            ?= x ?|
            | Ok x => x
            | Error x => "sm'.to_string result / Error: " ++# x
        | std_string * std_string =>
            ?= x ?|
            | Ok x => from_std_string x
            | Error x => "sm'.to_string result / Error: " ++# from_std_string x
        | _ => obj_to_string `u x

/// ### format_exception
:= format_exception (ex : exn) : string =
    run_target \|
        | Zig => \ () =>
            $'!ex ' : string
        | Fsharp => \ () => $'$"{!ex.GetType ()}: {!ex.Message}"'
        | Rust => \ () => $'!ex ' : string
        | TypeScript => \ () => $'String(!ex)' : string
        | _ => \ () => ex |> format_debug

///> fsharp
///> cuda
///> rust
///> typescript
test format_exception no_agree "exception text is backend-specific" =
    \ () => failwith "test"
    |> _throws
    |> optionm.value
    |> format_exception
    |> _assert_eq (run_target \|
        | Fsharp _ => \ () => ~~ "System.Exception: test"
        | Cuda _ => \ () => "test"
        | Rust => \ () => "test"
        | TypeScript _ => \ () => "Error: test"
        | _ => \ () => null ()
    )

/// ### range
:= range \* t. (start : am'.range t) (end : am'.range t) s =
    := is_start, start, end =
        := len () : int =
            ~>
                ?: t ?|
                | int => length `t s
                | _ => length' `t s
        ?= start, end ?|
        | Start start, End fn => !+, start, len >> convert.to |> fn
        | End start_fn, End end_fn => !-, start_fn (len >> convert.to), end_fn (len >> convert.to)
    := start' = start |> convert.try_convert |> optionm.value : int
    := end' = end |> convert.try_convert |> optionm.value : int
    := start_is_var = start |> var_is
    := same_fixed = start = end && (start_is_var |> not) && (end |> var_is |> not)
    := start_var_s_fixed = start_is_var && (s |> var_is |> not)
    := trace () =
        [
            "sm'.range"
            " / (s |> var_is): "; s |> var_is |> obj_to_string
            " // start: "; start |> obj_to_string
            " / (start |> var_is): "; start_is_var |> obj_to_string
            " // end: "; end |> obj_to_string
            " / (end |> var_is): "; end |> var_is |> obj_to_string
            " // same_fixed: "; same_fixed |> obj_to_string
            " / start_var_s_fixed: "; start_var_s_fixed |> obj_to_string
        ]
        |> concat_list ""
    backend_switch {
        Gleam = \ () =>
            ()
        Lua = id : () -> ()
        Fsharp = id : () -> ()
        Python = id : () -> ()
        Rust = id : () -> ()
        TypeScript = id : () -> ()
        Zig = id : () -> ()
    }
    s |> slice start' (end' - (? is_start && (same_fixed || start_var_s_fixed) ?> 0 |: 1))

///> gleam
///> fsharp
///> cuda
///> rust
///> typescript
test range =
    "abcde"
    |> range (am'.Start 0i32) (am'.End eval)
    |> _assert_eq "abcde"

    (~~ "fghij")
    |> range (am'.Start 1i32) (am'.End eval)
    |> _assert_eq "ghij"

    (~~ "klmno")
    |> range (am'.Start 1i32) (am'.End \ _ => 1)
    |> _assert_eq "l"

    "pqrst"
    |> range (am'.Start 1i32) (am'.End \ _ => 1)
    |> _assert_eq "q"

    "uvwxy"
    |> range (am'.Start (~~ 1i32)) (am'.End \ _ => 1)
    |> _assert_eq "v"

    "zabcd"
    |> range (am'.Start (~~ 1i32)) (am'.End \ _ => ~~ 1)
    |> _assert_eq "a"

    (~~ "efghi")
    |> range (am'.Start 1i32) (am'.End \ _ => 5)
    |> _assert_eq "fghi"

    "jklmn"
    |> range (am'.End \ x => 1i32) (am'.End \ _ => ~~ 5)
    |> _assert_eq "klmn"

    "opqrs"
    |> range (am'.End \ x => x () - 4i32) (am'.End \ x => x () - 1i32)
    |> _assert_eq "pqr"

    (~~ "stuvw")
    |> range (am'.End \ x => x () - 4i32) (am'.End \ x => x () - 1)
    |> _assert_eq "tuv"

    (~~ "wxyza")
    |> range (am'.Start (~~ 2i32)) (am'.End \ x => x () - 2)
    |> _assert_eq "y"

    (~~ "bcdef")
    |> range (am'.Start (~~ 2i32)) (am'.End \ x => x () - 3)
    |> _assert_eq ""

    (~~ "ghijk")
    |> range (am'.Start (~~ 1i32)) (am'.End \ x => x () - 3)
    |> _assert_eq "h"

    (~~ "lmnop")
    |> range (am'.Start (~~ 1i32)) (am'.End \ x => x () - 4)
    |> _assert_eq ""

    (~~ "qrstu")
    |> range (am'.End \ x => x () - 4i32) (am'.End \ _ => 4)
    |> _assert_eq "rst"

    "vwxyz"
    |> range (am'.End \ x => ~~ x () - 4i32) (am'.End \ _ => 4)
    |> _assert_eq "wxy"

/// ### ellipsis_end
:~ ellipsis_end (max : i64) (s : string) =
    := len = s |> length
    ? len <= max
    ?> s
    |:
        := half = (max |> convert.f64) / 2
        := start_half = half |> math.ceil |> convert.i64
        := end_half = half |> math.floor |> convert.i64
        := start = s |> slice 0 (start_half - 1)
        := end = s |> slice (len - end_half) (len - 1)
        [ start; "..."; end ]
        |> concat_list ""

///> gleam
///> lua
///> fsharp
test ellipsis_end =
    "12345"
    |> ellipsis_end 2
    |> _assert_eq "1...5"

    "12345"
    |> ellipsis_end 3
    |> _assert_eq "12...5"

    "1234567"
    |> ellipsis_end 4
    |> _assert_eq "12...67"

/// ### format_ellipsis
:= format_ellipsis s =
    s
    |> format_debug
    |> ellipsis_end 400

/// ### replace_regex
:~ replace_regex (pattern : string) (replacement : string) (s : string) : string =
    run_target_args (\ () => s, pattern, replacement) \|
        | Fsharp => \ s, pattern, replacement =>
            $'System.Text.RegularExpressions.Regex.Replace (!s, !pattern, !replacement)'
        | Rust => \ s, pattern, replacement =>
            := regex = pattern |> new_regex |> resultm.unwrap'
            := s = ~~ s
            !\\((regex, s, replacement), $'$"$0.replace_all(&*$1, &*$2)"')
            |> cow_to_std_string
            |> from_std_string
        | Gleam => \ s, pattern, replacement =>
            global "import gleam/regexp"
            $'let assert Ok(re) = !pattern |> regexp.from_string'
            $'re |> regexp.replace(!s, !replacement)' : string
        | _ => \ _ => ~~ ""

///> fsharp
///> gleam -d gleam_regexp=">= 1.1.0 and < 2.0.0"
///> rust -d regex
test replace_regex =
    " 123"
    |> replace_regex "\\s\\w2" ""
    |> _assert_eq "3"

///> rust -d regex
test replace_regex_2 =
    """
            let main args =
                ()

        """
    |> replace_regex "(?P<a> *)(?P<b>let\\s+main\\s+.*?\\s*=)" "$a[<EntryPoint>]\n$a$b"
    |> _assert_eq """
            [<EntryPoint>]
            let main args =
                ()

        """

/// ## main
///> fsharp

:= main () =
    $'let contains x = !contains x' : ()
    $'let ends_with x = !ends_with x' : ()
    $'let pad_left x = !pad_left x' : ()
    $'let pad_right x = !pad_right x' : ()
    $'let replace x = !replace x' : ()
    $'let replace_regex x = !replace_regex x' : ()
    := slice (a : i32) (b : i32) c = slice a b c
    $'let slice x = !slice x' : ()
    $'let split x = !split x' : ()
    $'let split_string x = !split_string x' : ()
    $'let starts_with x = !starts_with x' : ()
    $'let substring x = !substring x' : ()
    $'let to_lower x = !to_lower x' : ()
    $'let to_upper x = !to_upper x' : ()
    $'let trim x = !trim x' : ()
    $'let ellipsis x = !ellipsis x' : ()
    $'let ellipsis_end x = !ellipsis_end x' : ()
    $'let format_exception x = !format_exception x' : ()
    $'let concat_array x = !concat_array x' : ()
    := concat a (b : seq.seq' string) = concat a b
    $'let concat x = !concat x' : ()
    $'let join\' x = !join' x' : ()
    $'let to_char_array x = !to_char_array x' : ()

/// ## rust

/// ### to_string std_string
:< rust
:+ to_string std_string = from_std_string

/// ### split_list
:~ ^ split_list (separator : string) (s : string) : list string =
    := at : i32 = index_of separator s
    := width : i32 = length separator
    ? at < 0i32 || width = 0i32 ?> [ s ]
    |: substring 0i32 at s :: split_list separator (substring (at + width) (length s - at - width) s)

///> rust
///> gleam
test split_list_uses_the_whole_separator =
    := ~s = "a::b::::c"
    (
        split_list "::" s |> concat_list "|",
        split_list "," "x" |> concat_list "|",
        split_list "," "a," |> concat_list "|"
    )
    |> _assert_eq ("a|b||c", "x", "a|")

/// ### decimal_i32
:~ ^ decimal_from (text : string) (i : i32) (n : i32) : option i32 =
    ? i >= length text ?> Some n
    |:
        := d : i32 = index_of (substring i 1i32 text) "0123456789"
        := overflows = n > 214748364i32 || (n = 214748364i32 && d > 7i32)
        ? d < 0i32 || overflows ?> None |: decimal_from text (i + 1i32) (n * 10i32 + d)

:= decimal_i32 (text : string) : option i32 = ? text = "" ?> None |: decimal_from text 0i32 0i32

///> rust
///> gleam
test decimal_text_is_strict =
    := ~t = "2147483647"
    (decimal_i32 t, decimal_i32 "12", decimal_i32 "", decimal_i32 "-1", decimal_i32 "1x", decimal_i32 "2147483648")
    |> _assert_eq (Some 2147483647i32, Some 12i32, None, None, None, None)

///> rust -d regex
test default_value_inside_a_fold_closure_keeps_the_captured_seed =
    := pattern = new_regex "(?<a>x+)" |> resultm.unwrap'
    regex_captures "yxx" pattern
    |> am'.vec_fold' \ found captures =>
            ? found <> "" ?> found |: optionm'.default_value' "" (mapm.get "a" captures)
        ""
    |> _assert_eq "xx"
