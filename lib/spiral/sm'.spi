///> cuda
///> rust
///> zig
test obj_to_string_prints_bools_lowercase =
    (obj_to_string (dyn true), obj_to_string (dyn false)) |> _assert_eq ("true", "false")

/// ### (~#?**)
inl (~#?**) s =
    s |> obj_to_string

/// ### concat_list
let rec concat_pass (separator : string) (input : list string) (paired : list string) : list string =
    match input with
    | left :: right :: rest => concat_pass separator rest (left ++# separator ++# right :: paired)
    | last :: Nil => listm.rev (last :: paired)
    | Nil => listm.rev paired

let rec concat_balanced (separator : string) (input : list string) : string =
    match input with
    | Nil => ""
    | only :: Nil => only
    | _ => concat_balanced separator (concat_pass separator input Nil)

inl concat_right_fold separator input =
    (input, { acc = ""; sep = "" })
    ||> listm.foldBack fun (x : string) { acc sep } => {
        acc = x ++# sep ++# acc
        sep = separator
    }
    |> fun { acc } => acc

inl concat_list separator input : string =
    backend_switch {
        Gleam = fun () => concat_balanced separator input
        Lua = fun () => concat_right_fold separator input
        Fsharp = fun () => concat_right_fold separator input
        Python = fun () => concat_right_fold separator input
        Cpp = fun () => concat_right_fold separator input
        CppHost = fun () => concat_right_fold separator input
        Rust = fun () => concat_right_fold separator input
        TypeScript = fun () => concat_right_fold separator input
        Zig = fun () => concat_right_fold separator input
        Lean = fun () => concat_right_fold separator input
        C = fun () => concat_right_fold separator input
        Delphi = fun () => concat_right_fold separator input
        Wasm = fun () => concat_right_fold separator input
        Bend = fun () => concat_right_fold separator input
        Kotlin = fun () => concat_right_fold separator input
        Swift = fun () => concat_right_fold separator input
    }

///> gleam
///> fsharp
///> cuda
///> rust
///> typescript
test concat_list print_code =
    [
        "1"
        "2"
        "3"
    ]
    |> fun x =>
        inl code = (x : _) |> concat_list "\n"
        code
        |> _assert_eq """
            1
            2
            3
            """

/// ### slice
inl slice forall t {number; int}. (from : t) (to : t) s : string =
    backend_switch {
        Gleam = fun () =>
            sm.slice s { from to } : string
        Lua = fun () => sm.slice s { from to } : string
        C = fun () => sm.slice s { from to } : string
        Fsharp = fun () => sm.slice s { from to } : string
        Python = fun () => sm.slice s { from to } : string
        Rust = fun () => sm.slice s { from to } : string
        TypeScript = fun () => sm.slice s { from to } : string
        Zig = fun () => sm.slice s { from to } : string
        Lean = fun () => sm.slice s { from to } : string
    }

///> fsharp
test slice print_code =
    "abcdef"
    |> slice 3i32 3i32
    |> _assert_eq "d"

    "abcdef"
    |> slice 1i32 3i32
    |> slice 2i32 2i32
    |> _assert_eq "d"

    "abcdef"
    |> slice 1i32 4i32
    |> slice 2i32 3i32
    |> slice 1i32 1i32
    |> _assert_eq "e"

