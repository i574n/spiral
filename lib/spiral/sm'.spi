test show =
    show ("1", 2i32, ["3"; "4"], { b = "5"; c = (6i32, Some 'x') }, ;[ ("7", 8i32) ])
    |> _assert_eq "(1, 2, Cons(3, Cons(4, Nil)), { b = 5; c = (6, Some(x)) }, [(7, 8)])"

