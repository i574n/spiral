///> fsharp
///> cuda
test builder_insert =
    "ab"
    |> string_builder
    |> builder_insert 1 "gh"
    |> obj_to_string
    |> _assert_eq "aghb"

/// ### span_from
inl span_from pred str i0 =
    inl len = str |> length
    inl rec body (i : int) =
        if i >= len
        then i
        elif str |> index i |> pred
        then 루프 (i + 1)
        else i
    and inl 루프 i = join_body_unit body (if var_is i then i else len) i
    i0 |> 루프

/// ### char_contains
inl char_contains (chars : list char) (c : char) : bool =
    chars |> listm'.exists' ((=) c)

/// ### trim_chars
inl trim_chars () =
    [ ' '; '\t'; '\r'; '\n' ]

/// ### trim_start
inl trim_start (chars : list char) (input : string) : string =
    inl chars = if chars = [] then trim_chars () else chars
    inl len = input |> length
    let rec 루프 (i : int) =
        if i >= len
        then len
        elif input |> index i |> char_contains chars
        then 루프 (i + 1)
        else i
    input |> slice (루프 0) (len - 1)

///> gleam
///> fsharp
///> cuda
test trim_start =
    "  abc  "
    |> trim_start []
    |> _assert_eq "abc  "

    "abcde"
    |> trim_start []
    |> _assert_eq "abcde"

    "abcde"
    |> trim_start [ 'a' ]
    |> _assert_eq "bcde"

    "abcde"
    |> trim_start [ 'b'; 'a' ]
    |> _assert_eq "cde"

    "abcde"
    |> trim_start [ 'c'; 'b'; 'a' ]
    |> _assert_eq "de"

/// ### trim_end
inl trim_end (chars : list char) (input : string) : string =
    inl chars = if chars = [] then trim_chars () else chars
    inl len = input |> length
    let rec 루프 (i : int) =
        if i <= 0
        then -1
        elif input |> index (i - 1) |> char_contains chars
        then 루프 (i - 1)
        else i - 1
    input |> slice 0 (루프 len)

///> gleam
///> fsharp
///> cuda
test trim_end =
    "  def  "
    |> trim_end []
    |> _assert_eq "  def"

    "abcde"
    |> trim_end []
    |> _assert_eq "abcde"

    "abcde"
    |> trim_end [ 'e' ]
    |> _assert_eq "abcd"

    "abcde"
    |> trim_end [ 'e'; 'd' ]
    |> _assert_eq "abc"

    "abcde"
    |> trim_end [ 'e'; 'd'; 'c' ]
    |> _assert_eq "ab"

/// ### trim_with
inl trim_with (chars : list char) (input : string) : string =
    input
    |> trim_start chars
    |> trim_end chars

test trim_with =
    "  jkl  "
    |> trim_with [ ' '; '\t'; '\n' ]
    |> _assert_eq "jkl"

/// ### trim_end_suffix
inl trim_end_suffix (suffix : string) (input : string) : string =
    inl suffix_length : int = suffix |> length
    let rec loop (text : string) : string =
        if suffix_length > 0 && (text |> ends_with suffix)
        then text |> slice 0 ((text |> length) - suffix_length - 1) |> loop
        else text
    loop input

///> rust
///> fsharp
///> gleam
test trim_end_suffix_removes_every_trailing_copy =
    (
        "a.spi.spi" |> trim_end_suffix ".spi",
        "a.spi" |> trim_end_suffix ".rs",
        "abc" |> trim_end_suffix "",
        ".spi" |> trim_end_suffix ".spi"
    )
    |> _assert_eq ("a", "a.spi", "abc", "")

/// ### trim
inl trim (input : string) : string =
    input |> trim_with []

test trim =
    "  ghi  "
    |> trim
    |> _assert_eq "ghi"

/// ### concat
inl concat (a : string) (b : seq.seq' string) : string =
    backend_switch {
        Gleam = fun () =>
            global "import gleam/string"
            $'!b |> string.join(!a)' : string
        Lua = fun () => $'table.concat(!b, !a)' : string
        Fsharp = fun () =>
            inl a =
                if a = "\n"
                then join a
                else a
            b |> $'String.concat' a : string
        Python = fun () =>
            $'!a.join(!b)' : string
        Rust = fun () => $'Rc::<str>::from(!b.iter().map(|x| x.to_string()).collect::<Vec<_>>().join(&*!a))' : string
        TypeScript = fun () => $'!b.join(!a)' : string
        Zig = fun () => $'(std.mem.join(spiral_gpa, !a, !b) catch \@panic("out of memory"))' : string
    }

/// ### length'
inl length' forall dim. (input : string) : dim =
    backend_switch {
        Gleam = fun () =>
            global "import gleam/bit_array"
            $'bit_array.byte_size(bit_array.from_string(!input))' : dim
        Lua = fun () => $'##!input ' : dim
        Fsharp = fun () => input |> $'String.length' : dim
        Python = fun () => $'len((!input).encode("utf-8", "surrogateescape"))' : dim
        Rust = fun () => $'(!input.len() as `dim)' : dim
        Zig = fun () => $'\@as(`dim, \@intCast(!input.len))' : dim
        Lean = fun () => $'(`dim.ofNat (!input).utf8ByteSize)' : dim
    }

///> fsharp
///> cuda
