/// # sm'
test sm static =
    :< testing

:< rust
:< rust_operators

///- --static

:< sm'_real

/// ## rust

/// ### std_string_real

/// ### std_string
:== std_string = std_string_real

/// ### to_string'
:= to_string' \* t. (x : t) : std_string =
    !\($'$"!x.to_string()"')

/// ### from_std_string_real

/// ### from_std_string
:= from_std_string (str : std_string) : string =
    backend_switch {
        Rust = \ () => !\\(str, $'"Rc::<str>::from(String::as_str(&$0))"') : string
    }

/// ## sm'

/// ### symbol_to_string_real

/// ### symbol_to_string
:= symbol_to_string \* t {symbol}. (x : t) : string =
    ~> symbol_to_string_real `t

///> gleam
///> lua
///> fsharp
///> cuda
test symbol_to_string =
    .test
    |> symbol_to_string
    |> _assert_eq "test"

/// ### index
:= index i (str : string) : char =
    i |> sm.index str

/// ### length
:= length \* dim {int}. (input : string) : dim =
    input |> sm.length

///> gleam
///> fsharp
///> cuda
test length =
    "abc"
    |> length
    |> _assert_eq 3i32

/// ### (~##)
:= (~##) s : int =
    s |> length

/// ### to_char_list
:= to_char_list (str : string) : list char =
    listm.init (str |> length) (\ (i : i64) => str |> index i)

///> gleam
///> fsharp
///> cuda
test to_char_list =
    "abc"
    |> to_char_list
    |> _assert_eq [ 'a'; 'b'; 'c' ]

/// ### to_char_array
:= to_char_array (str : string) : array_base char =
    am'.init_base (str |> length) (\ i => str |> index i)

///> lua
///> gleam
///> fsharp
///> cuda
test to_char_array =
    "abc"
    |> to_char_array
    |> \ x => array x : array _
    |> am'.to_list'
    |> listm'.unbox
    |> _assert_eq [ 'a'; 'b'; 'c' ]

/// ### is_empty
:= is_empty (input : string) : bool =
    (input |> length) = 0i32

/// ### to_option
:= to_option s =
    ? s |> is_empty
    ?> None
    |: s |> Some

/// ### string_builder_real

/// ### string_builder
:== string_builder = string_builder_real

:= string_builder (initial : string) : string_builder =
    := initial =
        ? initial = ""
        ?> ~~ initial
        |: initial

    backend_switch {
        Gleam = \ () => $'!initial ' : string_builder
        Lua = \ () => $'!initial ' : string_builder
        Fsharp = \ () => initial |> $'`string_builder ' : string_builder
        Python = \ () =>
            global "import io"
            global """
                class CustomStringIO(io.StringIO):
                    def __init__(self, init=''):
                        super().__init__()
                        if init != '': self.write(init)
                    def __str__(self): return self.getvalue()
                    def __repr__(self): return self.getvalue()
                """
            $'CustomStringIO(!initial)' : string_builder
        Rust = \ () => $'String::from(&*!initial)' : string_builder
        TypeScript = \ () => $'!initial ' : string_builder
        Zig = \ () => $'!initial ' : string_builder
    }

/// ### append_real

/// ### append
:= append (x : string) (s : string) : string =
    ~> append_real x s

/// ### (++#*)

/// ### (++#)
:= (++#) (a : string) (b : string) : string =
    ~> (++#*) a b

/// ### (++\\\\#)
:= (++\\#) a b =
    a ++# "\\n" ++# b

/// ### (++\\#)
:= (++\#) a b =
    a ++# "\n" ++# b

/// ### format_debug_real

/// ### format_debug
:= format_debug \* t. (x : t) : string =
    ~> format_debug_real `t x

:= obj_to_string_rust \* t. (x : t) : string =
    ~> obj_to_string_rust_real `t x
:= obj_to_string_fsharp \* t. (x : t) : string =
    ? (~> ?: t ?| bool => !+ | _ => !-)
    ?> $'(if !x then "true" else "false")' : string
    |: $'!x |> _.ToString()' : string
:= obj_to_string_python \* t. (x : t) : string =
    ? (~> ?: t ?| bool => !+ | _ => !-)
    ?> $'("true" if !x else "false")' : string
    |: $'str(!x)' : string
:= obj_to_string_typescript \* t. (x : t) : string =
    ? (~> ?: t ?| char => !+ | _ => !-)
    ?> $'String.fromCharCode(!x)' : string
    |: $'String(!x)' : string
:= obj_to_string_wasm \* t. (x : t) : string =
    ? (~> ?: t ?| string => !+ | _ => !-) ?> $'!x ' : string
    |? (~> ?: t ?| bool => !+ | _ => !-) ?> $'(call $bool_to_str !x)' : string
    |? (~> ?: t ?| char => !+ | _ => !-) ?> $'(call $char_to_str !x)' : string
    |? (~> ?: t ?| i64 => !+ | _ => !-) ?> $'(call $i64_to_str !x)' : string
    |? (~> ?: t ?| u64 => !+ | _ => !-) ?> $'(call $u64_to_str !x)' : string
    elif (real typecase t with i8 => true | i16 => true | i32 => true | _ => false) then $'(call $i64_to_str \
        (i64.extend_i32_s !x))' : string
    elif (real typecase t with u8 => true | u16 => true | u32 => true | _ => false) then $'(call $u64_to_str \
        (i64.extend_i32_u !x))' : string
    |: $'backend_switch_has_no_Wasm_arm_in_lib_spiral' : string
:= obj_to_string_zig \* t. (x : t) : string =
    ? (~> ?: t ?| string => !+ | string_builder_real => !+ | _ => !-)
    ?> $'!x ' : string
    |? (~> ?: t ?| char => !+ | _ => !-)
    ?> $'(std.fmt.allocPrint(spiral_gpa, "{c}", .{ !x }) catch \@panic("out of memory"))' : string
    |? (~> ?: t ?| bool => !+ | _ => !-)
    ?> $'(if (!x) "true" else "false")' : string
    |?
        ~>
            ?: t ?|
            | f32 => !+
            | f64 => !+
            | i8 => !+
            | i16 => !+
            | i32 => !+
            | i64 => !+
            | u8 => !+
            | u16 => !+
            | u32 => !+
            | u64 => !+
            | _ => !-
    ?> $'(std.fmt.allocPrint(spiral_gpa, "{d}", .{ !x }) catch \@panic("out of memory"))' : string
    |: $'(std.fmt.allocPrint(spiral_gpa, "{any}", .{ !x }) catch \@panic("out of memory"))' : string

/// ### (~#?*)
:= (~#?*) s =
    s |> format_debug

