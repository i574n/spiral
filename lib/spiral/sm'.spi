    |> slice (join 1i32) 3i32
    |> _assert_eq "vwx"

    (join "zabcd")
    |> slice (join 1i32) 3i32
    |> _assert_eq "abc"

    "efghi"
    |> slice (join 1i32) (join 3i32)
    |> _assert_eq "fgh"

    (join "efghi")
    |> slice (join 1i32) (join 3i32)
    |> _assert_eq "fgh"

    "abcdef"
    |> slice 3i32 4i32
    |> _assert_eq "de"

    (join "efghi")
    |> slice (join 3i32) (join 4i32)
    |> _assert_eq "hi"

    "bcde"
    |> slice (join 0i32) 0i32
    |> _assert_eq "b"

/// ### format_pretty_real

/// ### format_pretty
inl format_pretty forall t. (x : t) : string =
    real format_pretty_real `t x

/// ### prim
inl prim x = real
    match x with
    | (x : i8) | (x : i16) | (x : i32) | (x : i64) => "%d", x
    | (x : u8) | (x : u16) | (x : u32) | (x : u64) => "%u", x
    | (x : f32) | (x : f64) => "%f", x
    | (x : string) => "%s", x
    | (x : char) => "%c", x

/// ### printable

