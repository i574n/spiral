/// ### regex_captures_iter
inl regex_captures_iter (s : rust.static_ref (rust.mut' std_string)) (regex : regex) : regex_capture_matches =
    inl regex = regex |> rust.emit
    !\\(regex, $'$"$0.captures_iter(!s)"')

/// ### regex_captures
let regex_captures (s : string) (regex : regex) : am'.vec (mapm.hash_map string string) =

    inl s = s |> to_std_string
    fun () =>
        inl matches =
            inl s = s |> rust.new_box |> rust.box_leak
            regex |> regex_captures_iter s

        (!\($'"true; let _regex_captures : Vec<_> = !matches.map(|x| { //"') : bool) |> ignore

        inl fn
            (match' : rust.static_ref (rust.mut' (regex_captures rust.static_lifetime)))
            : mapm.hash_map string string
            =

            inl names = regex |> regex_capture_names

            (!\($'"true; let _regex_captures : std::collections::HashMap<_, _> = !names.map(|x| { //"') : bool)
            |> ignore

            inl fn (n : string) : pair string string =
                inl n' = n |> rust.clone

                new_pair n' !\\(n, $'$"!match'.name(&$0).map(|x| x.as_str()).unwrap_or(\\\"\\\").to_string().into()"')

            (!\\(fn !\($'"x.unwrap_or(\\\"\\\").to_string().into()"'), $'"true; $0 }).collect()"') : bool) |> ignore

            !\($'"_regex_captures"')

        inl x =
            !\($'$"x"')
            |> rust.new_box
            |> rust.box_leak

        (!\\(fn x, $'"true; $0 }).collect::<Vec<_>>()"') : bool) |> ignore

        !\($'"_regex_captures"')

    |> rust.capture_move

///> rust -d regex
test regex_captures =
    "fable-library-ts\\.(?<a>[\\d.]+)$"
    |> new_regex
    |> resultm.unwrap'
    |> regex_captures "fable_modules/fable-library-ts.4.17.0"
    |> am'.vec_map (mapm.to_vec >> am'.vec_sort_by_key id)
    |> format_debug
    |> _assert_eq (
        am'.base ;[
            am'.base ;[ "", ""; "a", "4.17.0" ]
            |> am'.to_vec
        ]
        |> am'.to_vec
        |> format_debug
    )

/// ### serialize
inl serialize forall t. (x : t) : resultm.result' std_string json_error =
    !\($'"serde_json::to_string(&!x)"')

/// ### deserialize
inl deserialize forall t. (json : string) : resultm.result' t std_string =
    inl json = join json
    inl json = json |> as_str
    !\\(json, $'"serde_json::from_str(&$0)"')
    |> resultm.map_error' fun (x : json_error) => x |> format'

/// ### borsh_serialize
inl borsh_serialize forall t. (data : t) : am'.vec u8 =
    (!\($'"true; let mut data = Vec::new()"') : bool) |> ignore
    (!\\(data, $'"true; borsh::BorshSerialize::serialize(&$0, &mut data).unwrap()"') : bool) |> ignore
    !\($'"data"')

/// ### borsh_deserialize
inl borsh_deserialize forall t. (data : array_base u8) : resultm.result' t std_string =
    inl data = data |> am'.as_slice
    (!\($'"true; let mut !data = !data"') : bool) |> ignore
    inl result = !\($'"borsh::BorshDeserialize::deserialize(&mut !data)"')
    result
    |> resultm.map_error' fun (x : borsh_io_error) => x |> format'

/// ### deserialize_vec
inl deserialize_vec (value : json_value) : resultm.result' (am'.vec u8) std_string =
    inl value = join value
    !\($'"serde_json::from_value(!value)"')
    |> resultm.map_error' fun (x : json_error) => x |> format'

/// ### encode_uri_component
inl encode_uri_component (s : std_string) : js_string =
    !\($'"js_sys::encode_uri_component(&!s)"')

/// ### percent_encode_gleam
inl percent_encode_gleam () =
    global """
        @external(erlang, "binary", "bin_to_list")
        fn spiral_sm_utf8_bytes(text: String) -> List(Int)
        """

/// ### utf8_byte_list
inl utf8_byte_list (s : string) : listm'.list' u8 =
    backend_switch {
        Gleam = fun () =>
            percent_encode_gleam ()
            $'spiral_sm_utf8_bytes(!s)' : listm'.list' u8
        Rust = fun () => $'Rc::new(!s.bytes().collect())' : listm'.list' u8
    }

/// ### percent_unreserved
inl percent_unreserved (b : u8) : bool =
    (b >= 48u8 && b <= 57u8) || (b >= 65u8 && b <= 90u8) || (b >= 97u8 && b <= 122u8)
    || b = 45u8 || b = 46u8 || b = 95u8 || b = 126u8

/// ### ascii_text
inl ascii_text (b : u8) : string =
    inl position : int = conv b - 32
    inl upper = " !\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ"
    inl table = upper ++# "[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~"
    slice position position table

/// ### hex_digit
inl hex_digit (n : u8) : string =
    inl position : int = conv n
    slice position position "0123456789ABCDEF"

/// ### percent_byte
inl percent_byte (b : u8) : string =
    if percent_unreserved b then ascii_text b else "%" ++# hex_digit (b >>> 4i32) ++# hex_digit (b &&& 15u8)

/// ### percent_encode
inl percent_encode (s : string) : string =
    s
    |> utf8_byte_list
    |> listm'.fold' percent_byte Nil
    |> listm.fold (fun acc piece => piece ++# acc) ""

///> rust
///> gleam
test percent_encode_keeps_only_unreserved =
    inl ~text = "a b+c,d!~-._/é"
    percent_encode text |> _assert_eq "a%20b%2Bc%2Cd%21~-._%2F%C3%A9"

/// ### strip_prefix
inl strip_prefix (prefix : char) (s : std_string) : optionm'.option' (rust.ref str) =
    inl s = join s
    !\($'"!s.strip_prefix((!prefix) as char)"')

