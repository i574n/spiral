    "abc"
    |> length'
    |> _assert_eq 3i32

///> gleam
///> rust
///> cuda
test length_counts_utf8_bytes =
    "é😀"
    |> length'
    |> _assert_eq 6i32

/// ### to_string any
instance to_string any =
    obj_to_string

/// ### replace
inl replace (old : string) (new : string) (s : string) : string =
    backend_switch {
        Gleam = fun () =>
            global "import gleam/string"
            $'!s |> string.replace(!old, !new)' : string
        Lua = fun () =>
            $'((!s):gsub(((!old):gsub("%p", "%%%0")), ((!new):gsub("%%", "%%%%"))))' : string
        Fsharp = fun () =>
            $'(!s).Replace(!old, !new, System.StringComparison.Ordinal)' : string
        Python = fun () =>
            $'!s.replace(!old, !new)' : string
        Rust = fun () =>
            $'Rc::<str>::from(!s.replace(&*!old, &*!new))' : string
        TypeScript = fun () =>
            $'!s.split(!old).join(!new)' : string
        Zig = fun () =>
            $'(std.mem.replaceOwned(u8, spiral_gpa, !s, !old, !new) catch \@panic("out of memory"))' : string
        Lean = fun () =>
            $'(!s).replace !old !new ' : string
    }

///> lua
///> fsharp
///> rust
///> gleam
test search_and_replace_treat_text_literally =
    (
        "a.b%c" |> index_of ".",
        "a.b%c" |> index_of "%",
        "x" |> index_of "y",
        "a.b.c" |> replace "." "%",
        "a.b" |> starts_with "a."
    )
    |> _assert_eq (1, 3, -1, "a%b%c", true)

/// ### split
inl split (separator : string) (str : string) : array_base string =
    backend_switch {
        Gleam = fun () =>
            global "import gleam/string"
            ($'!str |> string.split(!separator)' : listm'.list' string)
            |> listm'.to_array'
        Fsharp = fun () => $'!str.Split !separator ' : array_base string
        Lua = fun () =>
            $'(function(s, sep) if sep == "" then return {s} end local parts, from = {}, 1 while true do local at = \
            string.find(s, sep, from, true) if not at then parts[##parts + 1] = string.sub(s, from) return parts end \
            parts[##parts + 1] = string.sub(s, from, at - 1) from = at + ##sep end end)(!str, !separator)'
            : array_base string
        C = fun () =>
            inl n : i32 = sm.length str
            inl m : i32 = sm.length separator
            inl matches_at (at : i32) : bool =
                let rec same (k : i32) : bool =
                    if k >= m then true
                    elif sm.index str (at + k) = sm.index separator k then same (k + 1)
                    else false
                same 0
            let rec next_from (at : i32) : i32 =
                if at + m > n then n
                elif matches_at at then at
                else next_from (at + 1)
            let rec count (at : i32) (parts : i32) : i32 =
                inl hit = next_from at
                if hit >= n then parts else count (hit + m) (parts + 1)
            let rec start_of (part : i32) (at : i32) : i32 =
                if part = 0 then at else start_of (part - 1) (next_from at + m)
            if m = 0
            then am'.init_base 1i32 fun _ => str
            else
                am'.init_base (count 0 1) fun (part : i32) =>
                    inl from = start_of part 0
                    sm.slice str { from = from; to = next_from from - 1 }
        Python = fun () => $'!str.split(!separator)' : array_base string
        Rust = fun () =>
            $'Rc::new(RefCell::new(!str.split(&*!separator).map(|x| Rc::<str>::from(x)).collect::<Vec<Rc<str>>>()))'
            : array_base string
        TypeScript = fun () => $'!str.split(!separator)' : array_base string
        Zig = fun () => $'blk: { var parts: std.ArrayList([]const u8) = .empty; var it = std.mem.splitSequence(u8, \
            !str, !separator); while (it.next()) |p| parts.append(spiral_gpa, p) catch \@panic("out of memory"); \
            break :blk parts.items; }' : array_base string
    }

///> rust
///> fsharp
///> lua
///> c
test split_keeps_empty_and_edge_parts =
    inl parts = "a,,c" |> split "," |> array
    inl edges = ",a," |> split "," |> array
    inl pattern_like = "a%b.c" |> split "%" |> array
    (
        am'.length parts,
        am'.index 0 parts,
        am'.index 1 parts,
        am'.index 2 parts,
        am'.length edges,
        am'.index 1 edges,
        am'.index 1 pattern_like
    )
    |> _assert_eq (3, "a", "", "c", 3, "a", "b.c")

/// ### line_parts
inl line_parts (text : string) : array_base string =
    split "\n" text

/// ### line_part_count
inl line_part_count (parts : array_base string) : int =
    inl n : int = parts |> array |> am'.length
    if n > 0 && am'.index_base (n - 1) parts = "" then n - 1 else n

/// ### line_without_return
inl line_without_return (line : string) : string =
    inl n : int = length line
    if ends_with "\r" line |> not then line
    elif n = 1 then ""
    else slice 0 (n - 2) line

/// ### nonempty_line_fold
inl nonempty_line_fold forall s. (f : s -> string -> s) (init : s) (text : string) : s =
    inl parts = line_parts text
    inl count = line_part_count parts
    let rec go (i : int) (acc : s) : s =
        if i >= count then acc
        else
            inl line = parts |> am'.index_base i |> line_without_return
            go (i + 1) (if line = "" then acc else f acc line)
    go 0 init

/// ### lines
inl lines (text : string) : array string =
    run_target function
        | Rust => fun () =>
            inl parts = line_parts text
            inl count = line_part_count parts
            let rec go (i : int) (acc : am'.vec string) : am'.vec string =
                if i >= count then acc
                else go (i + 1) (acc |> am'.vec_push (parts |> am'.index_base i |> line_without_return))
            go 0 (am'.new_vec []) |> am'.from_vec
        | _ => fun () => failwith "lines: no arm for this backend"

/// ### nonempty_lines
inl nonempty_lines (text : string) : array string =
    run_target function
        | Rust => fun () =>
            nonempty_line_fold (fun acc line => acc |> am'.vec_push line) (am'.new_vec []) text |> am'.from_vec
        | _ => fun () => failwith "nonempty_lines: no arm for this backend"

///> rust
test lines_follow_rust_line_rules =
    inl text = "a\r\n\nb\n"
    (am'.length (lines text) : int) |> _assert_eq 3
    (am'.length (nonempty_lines text) : int) |> _assert_eq 2
    am'.index 0 (lines text) |> _assert_eq "a"
    am'.index 1 (nonempty_lines text) |> _assert_eq "b"
    (am'.length (lines "") : int) |> _assert_eq 0

/// ### line_count
inl line_count (text : string) : int =
    text |> line_parts |> line_part_count

/// ### nonempty_line_count
inl nonempty_line_count (text : string) : int =
    nonempty_line_fold (fun n _ => n + 1) 0 text

/// ### line_at
inl line_at (index : int) (text : string) : string =
    inl parts = line_parts text
    if index >= 0 && index < line_part_count parts then parts |> am'.index_base index |> line_without_return else ""

/// ### nonempty_line_at
inl nonempty_line_at (index : int) (text : string) : string =
    inl _, found =
        nonempty_line_fold (fun (seen, found) line => seen + 1, (if seen = index then line else found)) (0, "") text
    found

///> rust
///> gleam
test line_counts_and_picks_scan_without_splitting =
    inl text = "a\r\n\nb\n"
    line_count text |> _assert_eq 3
    nonempty_line_count text |> _assert_eq 2
    line_at 0 text |> _assert_eq "a"
    line_at 1 text |> _assert_eq ""
    nonempty_line_at 1 text |> _assert_eq "b"
    line_at 9 text |> _assert_eq ""

/// ### listed
inl listed (separator : string) (item : string) (input : string) : bool =
    input |> split separator |> am'.any (fun part => trim part = item)

///> rust
///> fsharp
///> gleam
test listed_compares_trimmed_parts =
    (
        "a | b | c" |> listed "|" "b",
        "a|bc" |> listed "|" "b",
        "" |> listed "|" "b",
        "b" |> listed "|" "b"
    )
    |> _assert_eq (true, false, false, true)

/// ### split_string
inl split_string (separator : array_base string) (str : string) : array_base string =
    run_target_args (fun () => str, separator) function
        | Fsharp => fun str, separator => $'!str.Split (!separator, System.StringSplitOptions.None)'
        | _ => fun str, separator => str |> split ((array separator : array _) |> seq.of_array |> concat (join ""))

/// ### join'
inl join' (concat : string) (s : array string) : string =
    $'System.String.Join (!concat, !s)'

/// ### encoding
nominal encoding = $'System.Text.Encoding'

/// ### encoding_utf8
inl encoding_utf8 () : encoding =
    $'`encoding.UTF8'

/// ### utf8_get_bytes
inl utf8_get_bytes (s : string) : array u8 =
    run_target function
        | Rust => fun () => $'Rc::new(RefCell::new(!s.as_bytes().to_vec()))' : array u8
        | _ => fun () => s |> (encoding_utf8 () |> $'_.GetBytes') : array u8

/// ### byte_to_string
inl byte_to_string (format : string) (x : u8) : string =
    $'!x.ToString' format

