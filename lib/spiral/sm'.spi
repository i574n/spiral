/// ### to_char_array
:= to_char_array (str : string) : array_base char =
    arraym.init (str |> length) (\ i => str |> index i)
    |> \ (array x : array _) => x

///> fsharp
///> cuda
test to_char_array_2 =
    "abc"
    |> to_char_array
    |> format
    |> _assert_eq #?(;[ 'a'; 'b'; 'c' ])

/// ### concat_array
:= concat_array (separator : string) (input : array string) : string =
    run_target \|
        | Rust => \ () =>
            $'Rc::<str>::from((*!input).borrow().iter().map(|x| &**x).collect::<Vec<&str>>().join(&*!separator).as_str\
                ())'
            : string
        | _ => \ () =>
            ({ acc = ""; sep = "" }, input)
            ||> arraym.fold \ { acc sep } (x : string) =>
                    { acc = acc ++# sep ++# x; sep = separator }
            |> \ { acc } => acc

///> fsharp
///> rust
///> typescript
///> cuda
test concat_array print_code =
    ;[
        "1"
        "2"
        "3"
    ]
    |> \ x =>
        := code = x |> concat_array "\n"
        code
        |> _assert_eq """
            1
            2
            3
            """

///> rust
test a_growable_array_joins_in_one_pass =
    := items : array string = am'.growable ()
    am'.push_back "a" items
    am'.push_back "" items
    am'.push_back "b" items
    items |> concat_array "\n" |> _assert_eq "a\n\nb"
    (am'.growable () : array string) |> concat_array "," |> _assert_eq ""

/// ### ellipsis
:= ellipsis (max : i32) (s : string) =
    ? sm.length s <= max
    ?> s
    |: s |> slice 0 (max - 1) |> append "..."

///> gleam
///> fsharp
///> cuda
///> rust
///> typescript
test ellipsis =
    "12345"
    |> ellipsis 2
    |> _assert_eq "12..."

    "12345"
    |> ellipsis 4
    |> _assert_eq "1234..."

/// ## fsharp

/// ### gleam_dynamic
:! gleam_dynamic = $'Dynamic'

/// ### last_index_of_gleam
:= last_index_of_gleam () =
    global "import gleam/bit_array"
    global "import gleam/dynamic.{type Dynamic}"
    global "import gleam/erlang/atom"
    global """
        @external(erlang, "string", "find")
        fn spiral_sm_find_trailing(text: String, search: String, direction: atom.Atom) -> Dynamic

        @external(erlang, "gleam_stdlib", "identity")
        fn spiral_sm_coerce(value: a) -> b
        """

/// ### gleam_byte_size
:= gleam_byte_size (s : string) : i32 =
    last_index_of_gleam ()
    $'bit_array.byte_size(bit_array.from_string(!s))' : i32

/// ### gleam_find_trailing
:= gleam_find_trailing (search : string) (s : string) : gleam_dynamic =
    last_index_of_gleam ()
    $'spiral_sm_find_trailing(!s, !search, atom.create("trailing"))' : gleam_dynamic

/// ### gleam_is_nomatch
:= gleam_is_nomatch (found : gleam_dynamic) : bool =
    $'!found == spiral_sm_coerce(atom.create("nomatch"))' : bool

/// ### gleam_dynamic_text
:= gleam_dynamic_text (found : gleam_dynamic) : string =
    $'spiral_sm_coerce(!found)' : string

/// ### last_index_of
:= last_index_of (search : string) (s : string) : i32 =
    := search = dyn search
    run_target \|
        | Zig => \ () =>
            ($'std.mem.lastIndexOf(u8, !s, !search)' : optionm'.option' convert.unativeint)
            |> optionm'.map (\ i => convert.convert i)
            |> optionm'.unwrap_or -1i32
        | Rust => \ () =>
            ($'!s.rfind(&*!search)' : optionm'.option' convert.unativeint)
            |> optionm'.map (\ i => convert.convert i)
            |> optionm'.unwrap_or -1i32
        | Gleam => \ () =>
            ? search = "" ?> gleam_byte_size s
            |:
                := found = gleam_find_trailing search s
                ? gleam_is_nomatch found ?> -1i32 |: gleam_byte_size s - gleam_byte_size (gleam_dynamic_text found)
        | _ => \ () => $'!s.LastIndexOf !search ' : i32

///> rust
///> gleam
test last_index_of_finds_the_last_match_in_bytes =
    := ~s = "abcabc"
    (last_index_of "bc" s, last_index_of "x" s, last_index_of "" s) |> _assert_eq (4i32, -1i32, 6i32)

/// ### index_of_char_from
:= index_of_char_from (from : i32) (c : char) (s : string) : i32 =
    := len = s |> length
    := ^ body i =
        ? i >= len
        ?> -1i32
        |? c = (s |> index i)
        ?> i - from
        |: 루프 (i + 1i32)
    :& := 루프 i = join_body_unit body (? var_is i ?> i |: len) i
    from |> 루프

test index_of_char_from =
    "abcdefabc"
    |> index_of_char_from 2i32 'a'
    |> _assert_eq 4i32

/// ### portable_matches_at
:= portable_matches_at (search : string) (s : string) (at : i32) : bool =
    := m : i32 = sm.length search
    :~ ^ same (k : i32) : bool =
        ? k >= m ?> !+
        |? sm.index s (at + k) = sm.index search k ?> same (k + 1)
        |: !-
    same 0

/// ### portable_index_of
:= portable_index_of (search : string) (s : string) : i32 =
    := n : i32 = sm.length s
    := m : i32 = sm.length search
    :~ ^ scan (at : i32) : i32 =
        ? at + m > n ?> -1i32
        |? portable_matches_at search s at ?> at
        |: scan (at + 1)
    scan 0

/// ### gleam_split_once_head
:= gleam_split_once_head (search : string) (s : string) : optionm'.option' string =
    global "import gleam/pair"
    global "import gleam/result"
    global "import gleam/string"
    $'option.from_result(result.map(string.split_once(!s, !search), pair.first))' : optionm'.option' string

/// ### index_of
:= index_of (search : string) (s : string) : int =
    backend_switch {
        Gleam = \ () =>
            ? search = "" ?> 0
            |:
                ?= gleam_split_once_head search s |> optionm'.unbox ?|
                | Some head => gleam_byte_size head
                | None => -1
        Lua = \ () =>
            := found = $'string.find(!s, !search, 1, true)' : optionm'.option' int
            optionm'.default_value' 0 found - 1
        Fsharp = \ () => $'(!s).IndexOf(!search, System.StringComparison.Ordinal)' : int
        Python = \ () =>
            := found = $'(!s).find(!search)' : int
            ? found < 0 ?> -1 |: $'len((!s)[:!found].encode("utf-8", "surrogateescape"))' : int
        Rust = \ () =>
            ($'!s.find(&*!search)' : optionm'.option' convert.unativeint)
            |> optionm'.map (\ i => convert.convert i)
            |> optionm'.unwrap_or -1
        C = \ () => conv (portable_index_of search s) : int
        TypeScript = \ () => $'!s.indexOf(!search)' : int
        Zig = \ () =>
            ($'std.mem.indexOf(u8, !s, !search)' : optionm'.option' convert.unativeint)
            |> optionm'.map (\ i => convert.convert i)
            |> optionm'.unwrap_or -1
        Lean = \ () =>
            ? search = "" ?> 0
            |:
                := pieces = $'`int.ofNat ((!s).splitOn !search).length' : int
                := head = $'((!s).splitOn !search).headD ""' : string
                ? pieces <= 1 ?> -1 |: $'`int.ofNat (!head).utf8ByteSize' : int
    }

///> gleam
///> fsharp
///> cuda
///> rust
///> typescript
test index_of =
    "123"
    |> index_of "2"
    |> _assert_eq 1

///> gleam
///> rust
///> cuda
///> lua
test index_of_counts_utf8_bytes_and_whole_needles =
    ("é/x" |> index_of "/", "abcabc" |> index_of "ca", "abc" |> index_of "z")
    |> _assert_eq (2, 2, -1)

/// ### replicate
:= replicate (n : int) (s : string) : string =
    := ^ body i acc =
        ? i >= n
        ?> acc
        |: 루프 (i + 1) (acc ++# s)
    :& := 루프 i = join_body_unit body n i
    루프 0 ""

///> gleam
///> fsharp
test replicate =
    "12"
    |> replicate (~~ 3)
    |> _assert_eq "121212"

///> gleam
///> fsharp
test replicate_2 print_code =
    "12"
    |> replicate 3
    |> _assert_eq "121212"

///> gleam
///> fsharp
///> cuda
///> rust
///> typescript
test replicate_3 =
    "12"
    |> replicate 3
    |> _assert_eq "121212"

/// ### pad_left
:= pad_left (total_width : int) (padding_char : char) (s : string) : string =
    := padding = padding_char |> obj_to_string |> replicate (total_width - length s)
    padding ++# s

/// ### pad_right
:= pad_right (total_width : int) (padding_char : char) (s : string) : string =
    := padding = padding_char |> obj_to_string |> replicate (total_width - length s)
    s ++# padding

///> gleam
///> fsharp
///> cuda
///> rust
///> typescript
test pad_right =
    "123"
    |> pad_right 6 ' '
    |> _assert_eq "123   "

/// ### convert_to_utf32
:= convert_to_utf32 (c : char) : int =
    backend_switch {
        Gleam = \ () => c |> convert.i32
        Lua = \ () => c |> convert.i32
        Fsharp = \ () =>
            run_target_args' c \|
            | Fsharp => \ c => $'System.Char.ConvertToUtf32 (string !c, 0)' : int
            | _ => \ c => c |> convert.i32
        Python = \ () => $'ord(!c)' : int
        Rust = \ () => $'(!c as `int)' : int
        TypeScript = \ () => $'(!c)' : int
        Zig = \ () => $'\@as(`int, !c)' : int
    }

/// ### ends_with
:= ends_with (value : string) (s : string) : bool =
    backend_switch {
        Gleam = \ () =>
            global "import gleam/string"
            $'!s |> string.ends_with(!value)' : bool
        Fsharp = \ () => $'!s.EndsWith (!value, false, null)' : bool
        Python = \ () => $'!s.endswith(!value)' : bool
        Rust = \ () => $'!s.ends_with(&*!value)' : bool
        TypeScript = \ () => $'!s.endsWith(!value)' : bool
        Lua = \ () => $'!value == "" or !s:sub(-##!value) == !value ' : bool
        Zig = \ () => $'std.mem.endsWith(u8, !s, !value)' : bool
        C = \ () =>
            := n : i32 = sm.length s
            := m : i32 = sm.length value
            m <= n && portable_matches_at value s (n - m)
        Lean = \ () => $'(!s).endsWith !value ' : bool
    }

/// ### starts_with
:= starts_with (value : string) (s : string) : bool =
    backend_switch {
        Gleam = \ () =>
            global "import gleam/string"
            $'!s |> string.starts_with(!value)' : bool
        Lua = \ () => $'!value == "" or !s:sub(1, ##!value) == !value ' : bool
        Fsharp = \ () => $'(!s).StartsWith(!value, System.StringComparison.Ordinal)' : bool
        Python = \ () => $'!s.startswith(!value)' : bool
        Rust = \ () => $'!s.starts_with(&*!value)' : bool
        TypeScript = \ () => $'!s.startsWith(!value)' : bool
        Zig = \ () => $'std.mem.startsWith(u8, !s, !value)' : bool
        C = \ () =>
            := n : i32 = sm.length s
            := m : i32 = sm.length value
            m <= n && portable_matches_at value s 0
        Lean = \ () => $'(!s).startsWith !value ' : bool
    }

/// ### substring
:= substring (start : i32) (len : i32) (str : string) : string =
    run_target \|
        | Rust => \ () =>
            := from : convert.unativeint = convert.convert start
            := until : convert.unativeint = convert.convert (start + len)
            $'Rc::<str>::from(&(!str)[!from..!until])' : string
        | Zig => \ () =>
            := until = start + len
            $'(!str)[\@intCast(!start)..\@intCast(!until)]' : string
        | Gleam => \ () => sm.slice str { from = start; to = start + len - 1 }
        | Lua => \ () =>
            := from = start + 1i32
            := until = start + len
            $'string.sub(!str, !from, !until)' : string
        | _ => \ () => $'!str.Substring (!start, !len)'

///> gleam
///> rust
///> fsharp
test substring_cuts_by_start_and_length =
    := before_slash (s : string) = s |> substring 0 (s |> index_of "/")
    (
        "spiral" |> substring 1 3,
        "spiral" |> substring 0 0,
        "spiral" |> substring 6 0,
        before_slash "é/x",
        before_slash "a’😀/b"
    )
    |> _assert_eq ("pir", "", "", "é", "a’😀")

/// ### to_lower
:= to_lower (input : string) : string =
    backend_switch {
        Gleam = \ () =>
            global "import gleam/string"
            $'!input |> string.lowercase' : string
        Lua = \ () => $'string.lower(!input)' : string
        Fsharp = \ () => $'!input.ToLower' () : string
        Python = \ () => $'!input.lower()' : string
        Rust = \ () => $'Rc::<str>::from(!input.to_lowercase())' : string
        TypeScript = \ () => $'!input.toLowerCase()' : string
        Zig = \ () => $'(std.ascii.allocLowerString(spiral_gpa, !input) catch \@panic("out of memory"))' : string
        Lean = \ () => $'(!input).toLower' : string
    }

/// ### to_upper
:= to_upper (input : string) : string =
    backend_switch {
        Gleam = \ () =>
            global "import gleam/string"
            $'!input |> string.uppercase' : string
        Lua = \ () => $'string.upper(!input)' : string
        Fsharp = \ () => $'!input.ToUpper' () : string
        Python = \ () => $'!input.upper()' : string
        Rust = \ () => $'Rc::<str>::from(!input.to_uppercase())' : string
        TypeScript = \ () => $'!input.toUpperCase()' : string
        Zig = \ () => $'(std.ascii.allocUpperString(spiral_gpa, !input) catch \@panic("out of memory"))' : string
        Lean = \ () => $'(!input).toUpper' : string
    }

/// ### char_to_upper
:= char_to_upper (input : char) : char =
    backend_switch {
        Gleam = \ () =>
            global "import gleam/string"
            $'!input |> string.uppercase' : char
        Lua = \ () => $'string.upper(!input)' : char
        Fsharp = \ () => $'System.Char.ToUpper !input ' : char
        Python = \ () => $'!input.upper()' : char
        Rust = \ () => $'!input.to_ascii_uppercase()' : char
        TypeScript = \ () => $'String.fromCharCode(!input).toUpperCase().charCodeAt(0)' : char
        Zig = \ () => $'std.ascii.toUpper(!input)' : char
        Lean = \ () => $'(!input).toUpper' : char
    }

/// ### builder_append
:= builder_append (item : string) (sb : string_builder) : string_builder =
    backend_switch {
        Gleam = \ () =>
            $'!sb <> !item ' : string_builder
        Lua = \ () =>
            $'!sb .. !item ' : string_builder
        Fsharp = \ () =>
            ($'!sb.Append' item : string_builder) |> ignore
            sb
        Python = \ () =>
            ($'!sb.write(!item)' : int) |> ignore
            sb
        Rust = \ () => $'{ let mut r = !sb.clone(); r.push_str(&*!item); r }' : string_builder
        TypeScript = \ () => $'!sb + !item ' : string_builder
        Zig = \ () => $'spiralConcat(!sb, !item)' : string_builder
    }

///> gleam
///> fsharp
///> cuda
///> rust
///> typescript
test builder_append =
    "ab"
    |> string_builder
    |> builder_append "cd"
    |> builder_append "ef"
    |> obj_to_string
    |> _assert_eq "abcdef"

/// ### builder_replace
:= builder_replace (old : string) (new : string) (sb : string_builder) : string_builder =
    backend_switch {
        Gleam = \ () =>
            global "import gleam/string"
            $'!sb |> string.replace(!old, !new)' : string_builder
        Lua = \ () =>
            $'string.gsub(!sb, !old, !new)' : string_builder
        Fsharp = \ () =>
            ($'!sb.Replace (!old, !new)' : string_builder) |> ignore
            sb
        Python = \ () => ($'!sb.getvalue().replace(!old, !new)' : string) |> string_builder
        Rust = \ () => $'!sb.replace(&*!old, &*!new)' : string_builder
        TypeScript = \ () => $'!sb.split(!old).join(!new)' : string_builder
        Zig = \ () =>
            $'(std.mem.replaceOwned(u8, spiral_gpa, !sb, !old, !new) catch \@panic("out of memory"))' : string_builder
    }

///> gleam
///> fsharp
///> cuda
///> rust
///> typescript
test builder_replace =
    "ab"
    |> string_builder
    |> builder_append "cd"
    |> builder_replace "cd" "ef"
    |> builder_append "gh"
    |> obj_to_string
    |> _assert_eq "abefgh"

/// ### builder_clear
:= builder_clear (sb : string_builder) : string_builder =
    backend_switch {
        Gleam = \ () =>
            $'let !sb = ""'
            sb
        Lua = \ () =>
            $'!sb = ""'
            sb
        Fsharp = \ () =>
            ($'!sb.Clear' () : string_builder) |> ignore
            sb
        Python = \ () =>
            ($'!sb.truncate(0)' : int) |> ignore
            ($'!sb.seek(0)' : int) |> ignore
            sb
        Rust = \ () => $'String::new()' : string_builder
        TypeScript = \ () => $'""' : string_builder
        Zig = \ () => $'""' : string_builder
    }

///> gleam
///> fsharp
///> cuda
///> rust
///> typescript
test builder_clear =
    "ab"
    |> string_builder
    |> builder_append "cd"
    |> builder_clear
    |> builder_append "gh"
    |> obj_to_string
    |> _assert_eq "gh"

/// ### builder_insert
:= builder_insert (i : int) (s : string) (sb : string_builder) : string_builder =
    backend_switch {
        Gleam = \ () =>
            := sb = #?sb
            := a = sb |> slice 0 (i - 1)
            := b = sb |> slice i (length sb - 1)
            [ a; s; b ] |> concat_list "" |> string_builder
        Lua = \ () =>
            := sb = #?sb
            := a = sb |> slice 0 (i - 1)
            := b = sb |> slice i (length sb - 1)
            [ a; s; b ] |> concat_list "" |> string_builder
        Fsharp = \ () =>
            ($'!sb.Insert (!i, !s)' : string_builder) |> ignore
            sb
        Python = \ () =>
            := sb = sb |> obj_to_string
            $'"".join([!sb[:!i], !s, !sb[!i:]])' |> string_builder
        Rust = fun () => $'{ let mut r = !sb.clone(); let at = r.char_indices().nth(!i as usize).map(|(b, _)| \
            b).unwrap_or(r.len()); r.insert_str(at, &*!s); r }' : string_builder
        Zig = fun () => $'(std.mem.concat(spiral_gpa, u8, &.{ (!sb)[0..\@intCast(!i)], !s, (!sb)[\@intCast(!i)..] }) \
            catch \@panic("out of memory"))' : string_builder
    }

///> gleam
///> fsharp
///> cuda
test builder_insert =
    "ab"
    |> string_builder
    |> builder_insert 1 "gh"
    |> obj_to_string
    |> _assert_eq "aghb"

/// ### span_from
:= span_from pred str i0 =
    := len = str |> length
    := ^ body (i : int) =
        ? i >= len
        ?> i
        |? str |> index i |> pred
        ?> 루프 (i + 1)
        |: i
    :& := 루프 i = join_body_unit body (? var_is i ?> i |: len) i
    i0 |> 루프

/// ### char_contains
:= char_contains (chars : list char) (c : char) : bool =
    chars |> listm'.exists' ((=) c)

/// ### trim_chars
:= trim_chars () =
    [ ' '; '\t'; '\r'; '\n' ]

/// ### trim_start
:= trim_start (chars : list char) (input : string) : string =
    := chars = ? chars = [] ?> trim_chars () |: chars
    := len = input |> length
    :~ ^ 루프 (i : int) =
        ? i >= len
        ?> len
        |? input |> index i |> char_contains chars
        ?> 루프 (i + 1)
        |: i
    input |> slice (루프 0) (len - 1)

///> gleam
///> fsharp
///> cuda
test trim_start =
    "  abc  "
    |> trim_start []
    |> _assert_eq "abc  "

    "abcde"
    |> trim_start []
    |> _assert_eq "abcde"

    "abcde"
    |> trim_start [ 'a' ]
    |> _assert_eq "bcde"

    "abcde"
    |> trim_start [ 'b'; 'a' ]
    |> _assert_eq "cde"

    "abcde"
    |> trim_start [ 'c'; 'b'; 'a' ]
    |> _assert_eq "de"

/// ### trim_end
:= trim_end (chars : list char) (input : string) : string =
    := chars = ? chars = [] ?> trim_chars () |: chars
    := len = input |> length
    :~ ^ 루프 (i : int) =
        ? i <= 0
        ?> -1
        |? input |> index (i - 1) |> char_contains chars
        ?> 루프 (i - 1)
        |: i - 1
    input |> slice 0 (루프 len)

///> gleam
///> fsharp
///> cuda
test trim_end =
    "  def  "
    |> trim_end []
    |> _assert_eq "  def"

    "abcde"
    |> trim_end []
    |> _assert_eq "abcde"

    "abcde"
    |> trim_end [ 'e' ]
    |> _assert_eq "abcd"

    "abcde"
    |> trim_end [ 'e'; 'd' ]
    |> _assert_eq "abc"

    "abcde"
    |> trim_end [ 'e'; 'd'; 'c' ]
    |> _assert_eq "ab"

/// ### trim_with
:= trim_with (chars : list char) (input : string) : string =
    input
    |> trim_start chars
    |> trim_end chars

test trim_with =
    "  jkl  "
    |> trim_with [ ' '; '\t'; '\n' ]
    |> _assert_eq "jkl"

/// ### trim_end_suffix
:= trim_end_suffix (suffix : string) (input : string) : string =
    := suffix_length : int = suffix |> length
    :~ ^ loop (text : string) : string =
        ? suffix_length > 0 && (text |> ends_with suffix)
        ?> text |> slice 0 ((text |> length) - suffix_length - 1) |> loop
        |: text
    loop input

///> rust
///> fsharp
///> gleam
test trim_end_suffix_removes_every_trailing_copy =
    (
        "a.spi.spi" |> trim_end_suffix ".spi",
        "a.spi" |> trim_end_suffix ".rs",
        "abc" |> trim_end_suffix "",
        ".spi" |> trim_end_suffix ".spi"
    )
    |> _assert_eq ("a", "a.spi", "abc", "")

/// ### trim
:= trim (input : string) : string =
    input |> trim_with []

test trim =
    "  ghi  "
    |> trim
    |> _assert_eq "ghi"

/// ### concat
:= concat (a : string) (b : seq.seq' string) : string =
    backend_switch {
        Gleam = \ () =>
            global "import gleam/string"
            $'!b |> string.join(!a)' : string
        Lua = \ () => $'table.concat(!b, !a)' : string
        Fsharp = \ () =>
            := a =
                ? a = "\n"
                ?> ~~ a
                |: a
            b |> $'String.concat' a : string
        Python = \ () =>
            $'!a.join(!b)' : string
        Rust = \ () => $'Rc::<str>::from(!b.iter().map(|x| x.to_string()).collect::<Vec<_>>().join(&*!a))' : string
        TypeScript = \ () => $'!b.join(!a)' : string
        Zig = \ () => $'(std.mem.join(spiral_gpa, !a, !b) catch \@panic("out of memory"))' : string
    }

/// ### length'
:= length' \* dim. (input : string) : dim =
    backend_switch {
        Gleam = \ () =>
            global "import gleam/bit_array"
            $'bit_array.byte_size(bit_array.from_string(!input))' : dim
        Lua = \ () => $'##!input ' : dim
        Fsharp = \ () => input |> $'String.length' : dim
        Python = \ () => $'len((!input).encode("utf-8", "surrogateescape"))' : dim
        Rust = \ () => $'(!input.len() as `dim)' : dim
        Zig = \ () => $'\@as(`dim, \@intCast(!input.len))' : dim
        Lean = \ () => $'(`dim.ofNat (!input).utf8ByteSize)' : dim
    }

///> fsharp
///> cuda
test length_2 =
    "abc"
    |> length'
    |> _assert_eq 3i32

///> gleam
///> rust
///> cuda
test length_counts_utf8_bytes =
    "é😀"
    |> length'
    |> _assert_eq 6i32

/// ### to_string any
:+ to_string any =
    obj_to_string

/// ### replace
:= replace (old : string) (new : string) (s : string) : string =
    backend_switch {
        Gleam = \ () =>
            global "import gleam/string"
            $'!s |> string.replace(!old, !new)' : string
        Lua = \ () =>
            $'((!s):gsub(((!old):gsub("%p", "%%%0")), ((!new):gsub("%%", "%%%%"))))' : string
        Fsharp = \ () =>
            $'(!s).Replace(!old, !new, System.StringComparison.Ordinal)' : string
        Python = \ () =>
            $'!s.replace(!old, !new)' : string
        Rust = \ () =>
            $'Rc::<str>::from(!s.replace(&*!old, &*!new))' : string
        TypeScript = \ () =>
            $'!s.split(!old).join(!new)' : string
        Zig = \ () =>
            $'(std.mem.replaceOwned(u8, spiral_gpa, !s, !old, !new) catch \@panic("out of memory"))' : string
        Lean = \ () =>
            $'(!s).replace !old !new ' : string
    }

///> lua
///> fsharp
///> rust
///> gleam
test search_and_replace_treat_text_literally =
    (
        "a.b%c" |> index_of ".",
        "a.b%c" |> index_of "%",
        "x" |> index_of "y",
        "a.b.c" |> replace "." "%",
        "a.b" |> starts_with "a."
    )
    |> _assert_eq (1, 3, -1, "a%b%c", !+)

/// ### split
:= split (separator : string) (str : string) : array_base string =
    backend_switch {
        Gleam = \ () =>
            global "import gleam/string"
            ($'!str |> string.split(!separator)' : listm'.list' string)
            |> listm'.to_array'
        Fsharp = \ () => $'!str.Split !separator ' : array_base string
        Lua = \ () =>
            $'(function(s, sep) if sep == "" then return {s} end local parts, from = {}, 1 while true do local at = \
            string.find(s, sep, from, true) if not at then parts[##parts + 1] = string.sub(s, from) return parts end \
            parts[##parts + 1] = string.sub(s, from, at - 1) from = at + ##sep end end)(!str, !separator)'
            : array_base string
        C = \ () =>
            := n : i32 = sm.length str
            := m : i32 = sm.length separator
            := matches_at (at : i32) : bool =
                :~ ^ same (k : i32) : bool =
                    ? k >= m ?> !+
                    |? sm.index str (at + k) = sm.index separator k ?> same (k + 1)
                    |: !-
                same 0
            :~ ^ next_from (at : i32) : i32 =
                ? at + m > n ?> n
                |? matches_at at ?> at
                |: next_from (at + 1)
            :~ ^ count (at : i32) (parts : i32) : i32 =
                := hit = next_from at
                ? hit >= n ?> parts |: count (hit + m) (parts + 1)
            :~ ^ start_of (part : i32) (at : i32) : i32 =
                ? part = 0 ?> at |: start_of (part - 1) (next_from at + m)
            ? m = 0
            ?> am'.init_base 1i32 \ _ => str
            |:
                am'.init_base (count 0 1) \ (part : i32) =>
                    := from = start_of part 0
                    sm.slice str { from = from; to = next_from from - 1 }
        Python = \ () => $'!str.split(!separator)' : array_base string
        Rust = \ () =>
            $'Rc::new(RefCell::new(!str.split(&*!separator).map(|x| Rc::<str>::from(x)).collect::<Vec<Rc<str>>>()))'
            : array_base string
        TypeScript = \ () => $'!str.split(!separator)' : array_base string
        Zig = fun () => $'blk: { var parts: std.ArrayList([]const u8) = .empty; var it = std.mem.splitSequence(u8, \
            !str, !separator); while (it.next()) |p| parts.append(spiral_gpa, p) catch \@panic("out of memory"); \
            break :blk parts.items; }' : array_base string
    }

///> rust
///> fsharp
///> lua
///> c
test split_keeps_empty_and_edge_parts =
    := parts = "a,,c" |> split "," |> array
    := edges = ",a," |> split "," |> array
    := pattern_like = "a%b.c" |> split "%" |> array
    (
        am'.length parts,
        am'.index 0 parts,
        am'.index 1 parts,
        am'.index 2 parts,
        am'.length edges,
        am'.index 1 edges,
        am'.index 1 pattern_like
    )
    |> _assert_eq (3, "a", "", "c", 3, "a", "b.c")

/// ### line_parts
:= line_parts (text : string) : array_base string =
    split "\n" text

/// ### line_part_count
:= line_part_count (parts : array_base string) : int =
    := n : int = parts |> array |> am'.length
    ? n > 0 && am'.index_base (n - 1) parts = "" ?> n - 1 |: n

/// ### line_without_return
:= line_without_return (line : string) : string =
    := n : int = length line
    ? ends_with "\r" line |> not ?> line
    |? n = 1 ?> ""
    |: slice 0 (n - 2) line

/// ### nonempty_line_fold
:= nonempty_line_fold \* s. (f : s -> string -> s) (init : s) (text : string) : s =
    := parts = line_parts text
    := count = line_part_count parts
    :~ ^ go (i : int) (acc : s) : s =
        ? i >= count ?> acc
        |:
            := line = parts |> am'.index_base i |> line_without_return
            go (i + 1) (? line = "" ?> acc |: f acc line)
    go 0 init

/// ### lines
:= lines (text : string) : array string =
    run_target \|
        | Rust => \ () =>
            := parts = line_parts text
            := count = line_part_count parts
            :~ ^ go (i : int) (acc : am'.vec string) : am'.vec string =
                ? i >= count ?> acc
                |: go (i + 1) (acc |> am'.vec_push (parts |> am'.index_base i |> line_without_return))
            go 0 (am'.new_vec []) |> am'.from_vec
        | _ => \ () => failwith "lines: no arm for this backend"

/// ### nonempty_lines
:= nonempty_lines (text : string) : array string =
    run_target \|
        | Rust => \ () =>
            nonempty_line_fold (\ acc line => acc |> am'.vec_push line) (am'.new_vec []) text |> am'.from_vec
        | _ => \ () => failwith "nonempty_lines: no arm for this backend"

///> rust
test lines_follow_rust_line_rules =
    := text = "a\r\n\nb\n"
    (am'.length (lines text) : int) |> _assert_eq 3
    (am'.length (nonempty_lines text) : int) |> _assert_eq 2
    am'.index 0 (lines text) |> _assert_eq "a"
    am'.index 1 (nonempty_lines text) |> _assert_eq "b"
    (am'.length (lines "") : int) |> _assert_eq 0

/// ### line_count
:= line_count (text : string) : int =
    text |> line_parts |> line_part_count

/// ### nonempty_line_count
:= nonempty_line_count (text : string) : int =
    nonempty_line_fold (\ n _ => n + 1) 0 text

/// ### line_at
:= line_at (index : int) (text : string) : string =
    := parts = line_parts text
    ? index >= 0 && index < line_part_count parts ?> parts |> am'.index_base index |> line_without_return |: ""

/// ### nonempty_line_at
:= nonempty_line_at (index : int) (text : string) : string =
    := _, found =
        nonempty_line_fold (\ (seen, found) line => seen + 1, (? seen = index ?> line |: found)) (0, "") text
    found

///> rust
///> gleam
test line_counts_and_picks_scan_without_splitting =
    := text = "a\r\n\nb\n"
    line_count text |> _assert_eq 3
    nonempty_line_count text |> _assert_eq 2
    line_at 0 text |> _assert_eq "a"
    line_at 1 text |> _assert_eq ""
    nonempty_line_at 1 text |> _assert_eq "b"
    line_at 9 text |> _assert_eq ""

/// ### listed
:= listed (separator : string) (item : string) (input : string) : bool =
    input |> split separator |> am'.any (\ part => trim part = item)

///> rust
///> fsharp
///> gleam
test listed_compares_trimmed_parts =
    (
        "a | b | c" |> listed "|" "b",
        "a|bc" |> listed "|" "b",
        "" |> listed "|" "b",
        "b" |> listed "|" "b"
    )
    |> _assert_eq (!+, !-, !-, !+)

/// ### split_string
:= split_string (separator : array_base string) (str : string) : array_base string =
    run_target_args (\ () => str, separator) \|
        | Fsharp => \ str, separator => $'!str.Split (!separator, System.StringSplitOptions.None)'
        | _ => \ str, separator => str |> split ((array separator : array _) |> seq.of_array |> concat (~~ ""))

/// ### join'
:= join' (concat : string) (s : array string) : string =
    $'System.String.Join (!concat, !s)'

/// ### encoding
:! encoding = $'System.Text.Encoding'

/// ### encoding_utf8
:= encoding_utf8 () : encoding =
    $'`encoding.UTF8'

/// ### utf8_get_bytes
:= utf8_get_bytes (s : string) : array u8 =
    run_target \|
        | Rust => \ () => $'Rc::new(RefCell::new(!s.as_bytes().to_vec()))' : array u8
        | _ => \ () => s |> (encoding_utf8 () |> $'_.GetBytes') : array u8

/// ### byte_to_string
:= byte_to_string (format : string) (x : u8) : string =
    $'!x.ToString' format

