<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":":= rust_char_offset (text : string) (i : int) : int =\n    $'(!text.char_indices().nth(!i as usize).map_or(!text.len(), |(at, _)| at) as `int)' : int\n\n:= builder_insert (i : int) (s : string) (sb : string_builder) : string_builder =\n    backend_switch {\n        Gleam = \\ () =>\n            := sb = #?sb\n            := a = sb |> slice 0 (i - 1)\n            := b = sb |> slice i (length sb - 1)\n            [ a; s; b ] |> concat_list \"\" |> string_builder\n        Lua = \\ () =>\n            := sb = #?sb\n            := a = sb |> slice 0 (i - 1)\n            := b = sb |> slice i (length sb - 1)\n            [ a; s; b ] |> concat_list \"\" |> string_builder\n        Fsharp = \\ () =>\n            ($'!sb.Insert (!i, !s)' : string_builder) |> ignore\n            sb\n        Python = \\ () =>\n            := sb = sb |> obj_to_string\n            $'\"\".join([!sb[:!i], !s, !sb[!i:]])' |> string_builder\n        Rust = \\ () =>\n            := text = sb |> obj_to_string\n            := at = rust_char_offset text i\n            [ text |> slice 0 (at - 1); s; text |> slice at (length text - 1) ] |> concat_list \"\" |> string_builder\n        Zig = fun () => $'(std.mem.concat(spiral_gpa, u8, &.{ (!sb)[0..\\@intCast(!i)], !s, (!sb)[\\@intCast(!i)..] }) \\\n            catch \\@panic(\"out of memory\"))' : string_builder\n    }","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  := rust_char_offset (text : string) (i : int) : int =
      $'(!text.char_indices().nth(!i as usize).map_or(!text.len(), |(at, _)| at) as `int)' : int

  := builder_insert (i : int) (s : string) (sb : string_builder) : string_builder =
      backend_switch {
          Gleam = \ () =>
              := sb = #?sb
              := a = sb |> slice 0 (i - 1)
              := b = sb |> slice i (length sb - 1)
              [ a; s; b ] |> concat_list "" |> string_builder
          Lua = \ () =>
              := sb = #?sb
              := a = sb |> slice 0 (i - 1)
              := b = sb |> slice i (length sb - 1)
              [ a; s; b ] |> concat_list "" |> string_builder
          Fsharp = \ () =>
              ($'!sb.Insert (!i, !s)' : string_builder) |> ignore
              sb
          Python = \ () =>
              := sb = sb |> obj_to_string
              $'"".join([!sb[:!i], !s, !sb[!i:]])' |> string_builder
          Rust = \ () =>
              := text = sb |> obj_to_string
              := at = rust_char_offset text i
              [ text |> slice 0 (at - 1); s; text |> slice at (length text - 1) ] |> concat_list "" |> string_builder
          Zig = fun () => $'(std.mem.concat(spiral_gpa, u8, &.{ (!sb)[0..\@intCast(!i)], !s, (!sb)[\@intCast(!i)..] }) \
              catch \@panic("out of memory"))' : string_builder
      }
  """,
  timeout: 300_000
)
```

