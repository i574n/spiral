### concat_list

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":":~ ^ concat_pass (separator : string) (input : list string) (paired : list string) : list string =\n    ?= input ?|\n    | left :: right :: rest => concat_pass separator rest (left ++# separator ++# right :: paired)\n    | [ last ] => listm::rev (last :: paired)\n    | [] => listm::rev paired\n\n:~ ^ concat_balanced (separator : string) (input : list string) : string =\n    ?= input ?|\n    | [] => \"\"\n    | [ only ] => only\n    | _ => concat_balanced separator (concat_pass separator input [])\n\n:= concat_right_fold separator input =\n    (input, { acc = \"\"; sep = \"\" })\n    ||> listm::foldBack \\ (x : string) { acc sep } => {\n        acc = x ++# sep ++# acc\n        sep = separator\n    }\n    |> \\ { acc } => acc\n\n:= concat_list separator input : string =\n    backend_switch {\n        Gleam = \\ () => concat_balanced separator input\n        Lua = \\ () => concat_right_fold separator input\n        Fsharp = \\ () => concat_right_fold separator input\n        Python = \\ () => concat_right_fold separator input\n        Cpp = \\ () => concat_right_fold separator input\n        CppHost = \\ () => concat_right_fold separator input\n        Rust = \\ () =>\n            := items : array_base string = input |> listm'::box |> listm'::to_array'\n            $'Rc::<str>::from((*!items.borrow()).join(&*!separator))' : string\n        TypeScript = \\ () => concat_right_fold separator input\n        Zig = \\ () => concat_right_fold separator input\n        Lean = \\ () => concat_right_fold separator input\n        C = \\ () => concat_right_fold separator input\n        Pascal = \\ () => concat_right_fold separator input\n        Wasm = \\ () => concat_right_fold separator input\n        Bend = \\ () => concat_right_fold separator input\n        Kotlin = \\ () => concat_right_fold separator input\n        Swift = \\ () => concat_right_fold separator input\n    }","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  :~ ^ concat_pass (separator : string) (input : list string) (paired : list string) : list string =
      ?= input ?|
      | left :: right :: rest => concat_pass separator rest (left ++# separator ++# right :: paired)
      | [ last ] => listm::rev (last :: paired)
      | [] => listm::rev paired

  :~ ^ concat_balanced (separator : string) (input : list string) : string =
      ?= input ?|
      | [] => ""
      | [ only ] => only
      | _ => concat_balanced separator (concat_pass separator input [])

  := concat_right_fold separator input =
      (input, { acc = ""; sep = "" })
      ||> listm::foldBack \ (x : string) { acc sep } => {
          acc = x ++# sep ++# acc
          sep = separator
      }
      |> \ { acc } => acc

  := concat_list separator input : string =
      backend_switch {
          Gleam = \ () => concat_balanced separator input
          Lua = \ () => concat_right_fold separator input
          Fsharp = \ () => concat_right_fold separator input
          Python = \ () => concat_right_fold separator input
          Cpp = \ () => concat_right_fold separator input
          CppHost = \ () => concat_right_fold separator input
          Rust = \ () =>
              := items : array_base string = input |> listm'::box |> listm'::to_array'
              $'Rc::<str>::from((*!items.borrow()).join(&*!separator))' : string
          TypeScript = \ () => concat_right_fold separator input
          Zig = \ () => concat_right_fold separator input
          Lean = \ () => concat_right_fold separator input
          C = \ () => concat_right_fold separator input
          Pascal = \ () => concat_right_fold separator input
          Wasm = \ () => concat_right_fold separator input
          Bend = \ () => concat_right_fold separator input
          Kotlin = \ () => concat_right_fold separator input
          Swift = \ () => concat_right_fold separator input
      }
  """,
  timeout: 300_000
)
```

