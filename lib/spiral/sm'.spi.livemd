  ~S"""
  :== std_string = std_string_real

  := to_string' \* t. (x : t) : std_string =
      !\($'$"!x.to_string()"')
  """,
  timeout: 300_000
)
```

### from_std_string_real

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":"///- --real\n\n:= from_std_string_real (str : std_string_real) : string =\n    rust::emit_expr `std_string_real `string str ($'\"Rc::<str>::from($0)\"' : string)","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  ///- --real

  := from_std_string_real (str : std_string_real) : string =
      rust::emit_expr `std_string_real `string str ($'"Rc::<str>::from($0)"' : string)
  """,
  timeout: 300_000
)
```

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":":= from_std_string (str : std_string) : string =\n    backend_switch {\n        Rust = \\ () => !\\\\(str, $'\"Rc::<str>::from(String::as_str(&$0))\"') : string\n    }","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  := from_std_string (str : std_string) : string =
      backend_switch {
          Rust = \ () => !\\(str, $'"Rc::<str>::from(String::as_str(&$0))"') : string
      }
  """,
  timeout: 300_000
)
```

