### format_real

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":"///- --real\n\n:~ format_real \\* t. (x : t) : string =\n    := empty : string =\n        backend_switch `string `({}) {\n            Gleam =\n                (\\ () =>\n                    \"\"\n                ) : () -> string\n            Lua =\n                (\\ () =>\n                    \"\"\n                ) : () -> string\n            Fsharp =\n                (\\ () =>\n                    ~~ \"\"\n                ) : () -> string\n            Python =\n                (\\ () =>\n                    \"\"\n                ) : () -> string\n            Rust =\n                (\\ () =>\n                    \"\"\n                ) : () -> string\n            TypeScript =\n                (\\ () =>\n                    \"\"\n                ) : () -> string\n            Zig =\n                (\\ () =>\n                    \"\"\n                ) : () -> string\n            Lean =\n                (\\ () =>\n                    \"\"\n                ) : () -> string\n            Kotlin =\n                (\\ () =>\n                    \"\"\n                ) : () -> string\n            Swift =\n                (\\ () =>\n                    \"\"\n                ) : () -> string\n            C =\n                (\\ () =>\n                    \"\"\n                ) : () -> string\n            Pascal =\n                (\\ () =>\n                    \"\"\n                ) : () -> string\n        }\n    := result = mut `string empty\n    := ^ write x =\n        := p ((a : string), b) =\n            := s : string =\n                backend_switch `string `({}) {\n                    Gleam =\n                        (\\ () =>\n                            ?= b ?|\n                            | (_ : string) => b : string\n                            | _ => format_debug_real `(`b) b\n                        ) : () -> string\n                    Lua =\n            