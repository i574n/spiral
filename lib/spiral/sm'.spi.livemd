### to_string any

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":":+ to_string any =\n    obj_to_string\n\n:= replace (old : string) (new : string) (s : string) : string =\n    backend_switch {\n        Gleam = \\ () =>\n            global \"import gleam/string\"\n            $'!s |> string.replace(!old, !new)' : string\n        Lua = \\ () =>\n            $'((!s):gsub(((!old):gsub(\"%p\", \"%%%0\")), ((!new):gsub(\"%%\", \"%%%%\"))))' : string\n        Fsharp = \\ () =>\n            $'(!s).Replace(!old, !new, System.StringComparison.Ordinal)' : string\n        Kotlin = \\ () =>\n            $'(!s).replace(!old, !new)' : string\n        Python = \\ () =>\n            $'!s.replace(!old, !new)' : string\n        Rust = \\ () =>\n            $'Rc::<str>::from(!s.replace(&*!old, &*!new))' : string\n        TypeScript = \\ () =>\n            $'!s.split(!old).join(!new)' : string\n        Zig = \\ () =>\n            $'(std.mem.replaceOwned(u8, spiral_gpa, !s, !old, !new) catch @@panic(\"out of memory\"))' : string\n        Pascal = \\ () =>\n            $'StringReplace(!s, !old, !new, [rfReplaceAll])' : string\n        Lean = \\ () =>\n            $'(!s).replace !old !new ' : string\n        C = \\ () => portable_replace old new s\n    }","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  :+ to_string any =
      obj_to_string

  := replace (old : string) (new : string) (s : string) : string =
      backend_switch {
          Gleam = \ () =>
              global "import gleam/string"
              $'!s |> string.replace(!old, !new)' : string
          Lua = \ () =>
              $'((!s):gsub(((!old):gsub("%p", "%%%0")), ((!new):gsub("%%", "%%%%"))))' : string
          Fsharp = \ () =>
              $'(!s).Replace(!old, !new, System.StringComparison.Ordinal)' : string
          Kotlin = \ () =>
              $'(!s).replace(!old, !new)' : string
          Python = \ () =>
              $'!s.replace(!old, !new)' : string
          Rust = \ () =>
              $'Rc::<str>::from(!s.replace(&*!old, &*!new))' : string
          TypeScript = \ () =>
              $'!s.split(!old).join(!new)' : string
          Zig = \ () =>
              $'(std.mem.replaceOwned(u8, spiral_gpa, !s, !old, !new) catch @@panic("out of memory"))' : string
          Pascal = \ () =>
              $'StringReplace(!s, !old, !new, [rfReplaceAll])' : string
          Lean = \ () =>
              $'(!s).replace !old !new ' : string
          C = \ () => portable_replace old new s
      }
  """,
  timeout: 300_000
)
```

