<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":":= concat (a : string) (b : seq::seq' string) : string =\n    backend_switch {\n        Gleam = \\ () =>\n            global \"import gleam/string\"\n            $'!b |> string.join(!a)' : string\n        Lua = \\ () => $'table.concat(!b, !a)' : string\n        Fsharp = \\ () =>\n            := a =\n                ? a = \"\\n\"\n                ?> ~~ a\n                |: a\n            b |> $'String.concat' a : string\n        Python = \\ () =>\n            $'!a.join(!b)' : string\n        Rust = \\ () => $'Rc::<str>::from(!b.iter().map(|x| x.to_string()).collect::<Vec<_>>().join(&*!a))' : string\n        TypeScript = \\ () => $'!b.join(!a)' : string\n        Zig = \\ () => $'(std.mem.join(spiral_gpa, !a, !b) catch @@panic(\"out of memory\"))' : string\n    }\n\n:= length' \\* dim. (input : string) : dim =\n    backend_switch {\n        Gleam = \\ () =>\n            global \"import gleam/bit_array\"\n            $'bit_array.byte_size(bit_array.from_string(!input))' : dim\n        Lua = \\ () => $'##!input ' : dim\n        Fsharp = \\ () => input |> $'String.length' : dim\n        Python = \\ () => $'len((!input).encode(\"utf-8\", \"surrogateescape\"))' : dim\n        Rust = \\ () => $'(!input.len() as `dim)' : dim\n        Zig = \\ () => $'@@as(`dim, @@intCast(!input.len))' : dim\n        Lean = \\ () => $'(`dim.ofNat (!input).utf8ByteSize)' : dim\n    }","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  := concat (a : string) (b : seq::seq' string) : string =
      backend_switch {
          Gleam = \ () =>
              global "import gleam/string"
              $'!b |> string.join(!a)' : string
          Lua = \ () => $'table.concat(!b, !a)' : string
          Fsharp = \ () =>
              := a =
                  ? a = "\n"
                  ?> ~~ a
                  |: a
              b |> $'String.concat' a : string
          Python = \ () =>
              $'!a.join(!b)' : string
          Rust = \ () => $'Rc::<str>::from(!b.iter().map(|x| x.to_string()).collect::<Vec<_>>().join(&*!a))' : string
          TypeScript = \ () => $'!b.join(!a)' : string
          Zig = \ () => $'(std.mem.join(spiral_gpa, !a, !b) catch @@panic("out of memory"))' : string
      }

  := length' \* dim. (input : string) : dim =
      backend_switch {
          Gleam = \ () =>
              global "import gleam/bit_array"
              $'bit_array.byte_size(bit_array.from_string(!input))' : dim
          Lua = \ () => $'##!input ' : dim
          Fsharp = \ () => input |> $'String.length' : dim
          Python = \ () => $'len((!input).encode("utf-8", "surrogateescape"))' : dim
          Rust = \ () => $'(!input.len() as `dim)' : dim
          Zig = \ () => $'@@as(`dim, @@intCast(!input.len))' : dim
          Lean = \ () => $'(`dim.ofNat (!input).utf8ByteSize)' : dim
      }
  """,
  timeout: 300_000
)
```

