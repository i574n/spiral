           global \"\"\"static inline uint32_t spiral_format_f32(float x) { int n = 0; for (int p = 1; p <= 9; p++) { n = snprintf(spiral_format_buffer, sizeof spiral_format_buffer, \"%.*g\", p, (double)x); if (strtof(spiral_format_buffer, NULL) == x) break; } return spiral_format_decimal_point(n); }\"\"\"\n                        $'StringLit(spiral_format_f32(!x), spiral_format_buffer)' : string\n                    ?: t ?|\n                    | char =>\n                        buffer ()\n                        global \"\"\"static inline uint32_t spiral_format_char(int32_t x) { return (uint32_t)snprintf(spiral_format_buffer, sizeof spiral_format_buffer, \"'%c'\", (int)x) + 1u; }\"\"\"\n                        $'StringLit(spiral_format_char(!x), spiral_format_buffer)' : string\n                    | bool => ? x ?> \"true\" |: \"false\"\n                    | f64 => float64 x\n                    | f32 => float32 x\n                    | i8 => signed x\n                    | i16 => signed x\n                    | i32 => signed x\n                    | i64 => signed x\n                    | u8 => unsigned x\n                    | u16 => unsigned x\n                    | u32 => unsigned x\n                    | u64 => unsigned x\n                    | array_base ~el => format_debug_elements_rust `el x\n                    | () * ~b =>\n                        := _, b = x\n                        format_debug_real `b b\n                    | ~a * ~b =>\n                        := a, b = x\n                        (++#*) (format_debug_real `a a) ((++#*) \", \" (format_debug_real `b b))\n                    | {} =>\n                        := _, fields =\n                            real_core::record_fold\n                                \\ { state = separator, acc key value } =>\n                                    \"; \", acc ++#* separator ++#* symbol_to_string_real `(`key) ++#* \" = \" ++#* format_debug_real `(`value) value\n                                (\"\", \"\") x\n                        \"{ \" ++#* fields ++#* \" }\"\n                    | _ =>\n                        ? real_core::union_type_is `t\n                        ?> serialize_union_rust `t x\n                        |? real_core::nominal_type_is `t\n                        ?>\n                            := y = real_core::nominal_strip x\n                            format_debug_real `(`y) y\n                        |: $'StringLit(sizeof(\"<`t>\"), \"<`t>\")' : string\n                ) : () -> string\n        }\n:& := format_debug_other_rust \\* t. (x : t) : string =\n    ? real_core::prim_type_is `t\n    ?> $'Rc::<str>::from(format\\!(\"{:?}\", !x))' : string\n    |? real_core::union_type_is `t\n    ?> serialize_union_rust `t x\n    |? real_core::nominal_type_is `t\n    ?>\n        := payload \\* u. (y : u) : string =\n            ?: u ?|\n            | {} => format_debug_real `u y\n            | ~a -> ~b => $'Rc::<str>::from(\"<`t>\")' : string\n            | ~a * ~b => format_debug_real `u y\n            | array_base _ => format_debug_real `u y\n            | _ =>\n                ? real_core::prim_type_is `u || real_core::union_type_is `u || real_core::nominal_type_is `u\n                ?> format_debug_real `u y\n                |:\n                    $'Rc::<str>::from({ struct W<T>(T); trait D { fn s(&self) -> String; } impl<T: std::fmt::Debug> D \\\n                        for &W<T> { fn s(&self) -> String { format\\!(\"{:?}\", self.0) } } trait P { fn s(&self) -> \\\n                        String; } impl<T> P for W<T> { fn s(&self) -> String { String::from(\"<`t>\") } } \\\n                        (&&W(&!y)).s() })'\n                    : string\n        := y = real_core::nominal_strip x\n        payload `(`y) y\n    |: $'Rc::<str>::from(\"<`t>\")' : string\n:& := format_debug_elements_rust \\* el. (x : array_base el) : string =\n    ~~\n        := n = !!!!ArrayLength(`u64, x)\n        := i = mut `u64 (real_core::dyn 0u64)\n        := s = mut `string (real_core::dyn \"\")\n        loop::while' (\\ () => !!!!LT(!!!!LayoutIndex(i), n)) \\ () =>\n            := j = !!!!LayoutIndex(i)\n            := e = format_debug_element_rust `el !!!!ArrayIndex(x, j)\n            s <- (? !!!!EQ(j, 0u64) ?> e |: !!!!LayoutIndex(s) ++#* \", \" ++#* e)\n            i <- !!!!Add(j, 1u64)\n        \"[\" ++#* !!!!LayoutIndex(s) ++#* \"]\"\n    : string\n:& := format_debug_element_rust \\* el. (x : el) : string =\n    ?: el ?|\n    | ~a * ~b => \"(\" ++#* format_debug_real `el x ++#* \")\"\n    | _ => format_debug_real `el x\n:& := serialize_union \\* t. (x : t) : string =\n    ~~\n        $'if type(v0) ~= \"table\" then return tostring(v0) end' : ()\n        real_core::unbox x \\ k, v =>\n            := tag : string = $'__v[1].tag'\n            ?: `v ?|\n            | () => tag\n            | ~a * ~b =>\n                ?: a ?|\n                | ~c * ~d =>\n                    := head_str = format_debug_real `c ($'__v[1]._1 ' : c)\n                    := tail_str = format_debug_real `d ($'__v[1]._2  ' : d)\n                    := x = format_debug_real `b ($'__v[1]._3   ' : b)\n                    tag ++#* \"(\" ++#* head_str ++#* \", \" ++#* tail_str ++#* \", \" ++#* x ++#* \")\"\n                | _ =>\n                    := head_str = format_debug_real `a ($'__v[1]._1    ' : a)\n                    := tail_str = format_debug_real `b ($'__v[1]._2     ' : b)\n                    (++#*) tag ((++#*) \"(\" ((++#*) head_str ((++#*) \", \" ((++#*) tail_str \")\"))))\n            | ~a =>\n                := arg_str = format_debug_real `a ($'__v[1]._1' : a)\n                (++#*) tag ((++#*) \"(\" ((++#*) arg_str \")\"))\n    : string\n:& := serialize_union_rust \\* t. (x : t) : string =\n    ~~\n        real_core::unbox x \\ k, v =>\n            := name = symbol_to_string_real `(`k)\n            ?: `v ?|\n            | () => name\n            | _ => (++#*) name ((++#*) \"(\" ((++#*) (format_debug_real `(`v) v) \")\"))\n    : string\n