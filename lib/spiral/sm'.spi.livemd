<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":"///- --test --symbol\n///> gleam\n///> rust\n\n:= before_slash (s : string) = s |> substring 0 (s |> index_of \"/\")\n(\n    \"spiral\" |> substring 1 3,\n    \"spiral\" |> substring 0 0,\n    \"spiral\" |> substring 6 0,\n    before_slash \"é/x\",\n    before_slash \"a’😀/b\"\n)\n|> _assert_eq (\"pir\", \"\", \"\", \"é\", \"a’😀\")","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  ///- --test --symbol
  ///> gleam
  ///> rust

  := before_slash (s : string) = s |> substring 0 (s |> index_of "/")
  (
      "spiral" |> substring 1 3,
      "spiral" |> substring 0 0,
      "spiral" |> substring 6 0,
      before_slash "é/x",
      before_slash "a’😀/b"
  )
  |> _assert_eq ("pir", "", "", "é", "a’😀")
  """,
  timeout: 300_000
)
```

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":":~ ^ ascii_case_runs (upper : bool) (s : string) (n : i32) (start : i32) (i : i32) (acc : list string) : list string =\n    ? i >= n ?> (? start < n ?> slice start (n - 1i32) s :: acc |: acc)\n    |:\n        := b : u8 = convert::u8 (index i s)\n        := hit = ? upper ?> 97u8 <= b && b <= 122u8 |: 65u8 <= b && b <= 90u8\n        ? hit ?>\n            := run = ? start < i ?> slice start (i - 1i32) s :: acc |: acc\n            := at : i32 = convert::i32 (? upper ?> b - 97u8 |: b - 65u8)\n            := letter = ? upper ?> slice at at \"ABCDEFGHIJKLMNOPQRSTUVWXYZ\" |: slice at at \"abcdefghijklmnopqrstuvwxyz\"\n            ascii_case_runs upper s n (i + 1i32) (i + 1i32) (letter :: run)\n        |: ascii_case_runs upper s n start (i + 1i32) acc\n\n:= ascii_case (upper : bool) (s : string) : string =\n    := n : i32 = length s\n    ascii_case_runs upper s n 0i32 0i32 [] |> listm::rev |> concat_list \"\"\n\n:= to_lower (input : string) : string =\n    backend_switch {\n        Gleam = \\ () =>\n            global \"import gleam/string\"\n            $'!input |> string.lowercase' : string\n        Lua = \\ () => $'string.lower(!input)' : string\n        Fsharp = \\ () => $'!input.ToLower' () : string\n        Python = \\ () => $'!input.lower()' : string\n        Rust = \\ () => $'Rc::<str>::from(!input.to_lowercase())' : string\n        TypeScript = \\ () => $'!input.toLowerCase()' : string\n        Zig = \\ () => $'(std.ascii.allocLowerString(spiral_gpa, !input) catch @@panic(\"out of memory\"))' : string\n        Lean = \\ () => $'(!input).toLower' : string\n        Pascal = \\ () => $'LowerCase(!input)' : string\n        C = \\ () => ascii_case !- input\n    }\n\n:~ ^ kebab_from (text : string) (size : i32) (at : i32) (out : string) : string =\n    ? at >= size ?> out\n    |:\n        := letter = substring at 1i32 text\n        := lower = to_lower letter\n        := dash = ? at > 0i32 && letter <> lower ?> \"-\" |: \"\"\n        kebab_from text size (at + 1i32) (out ++# dash ++# lower)\n\n:= kebab_of (text : string) : string = kebab_from text (length text) 0i32 \"\"","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  :~ ^ ascii_case_runs (upper : bool) (s : string) (n : i32) (start : i32) (i : i32) (acc : list string) : list string =
      ? i >= n ?> (? start < n ?> slice start (n - 1i32) s :: acc |: acc)
      |:
          := b : u8 = convert::u8 (index i s)
          := hit = ? upper ?> 97u8 <= b && b <= 122u8 |: 65u8 <= b && b <= 90u8
          ? hit ?>
              := run = ? start < i ?> slice start (i - 1i32) s :: acc |: acc
              := at : i32 = convert::i32 (? upper ?> b - 97u8 |: b - 65u8)
              := letter = ? upper ?> slice at at "ABCDEFGHIJKLMNOPQRSTUVWXYZ" |: slice at at "abcdefghijklmnopqrstuvwxyz"
              ascii_case_runs upper s n (i + 1i32) (i + 1i32) (letter :: run)
          |: ascii_case_runs upper s n start (i + 1i32) acc

  := ascii_case (upper : bool) (s : string) : string =
      := n : i32 = length s
      ascii_case_runs upper s n 0i32 0i32 [] |> listm::rev |> concat_list ""

  := to_lower (input : string) : string =
      backend_switch {
          Gleam = \ () =>
              global "import gleam/string"
              $'!input |> string.lowercase' : string
          Lua = \ () => $'string.lower(!input)' : string
          Fsharp = \ () => $'!input.ToLower' () : string
          Python = \ () => $'!input.lower()' : string
          Rust = \ () => $'Rc::<str>::from(!input.to_lowercase())' : string
          TypeScript = \ () => $'!input.toLowerCase()' : string
          Zig = \ () => $'(std.ascii.allocLowerString(spiral_gpa, !input) catch @@panic("out of memory"))' : string
          Lean = \ () => $'(!input).toLower' : string
          Pascal = \ () => $'LowerCase(!input)' : string
          C = \ () => ascii_case !- input
      }

  :~ ^ kebab_from (text : string) (size : i32) (at : i32) (out : string) : string =
      ? at >= size ?> out
      |:
          := letter = substring at 1i32 text
          := lower = to_lower letter
          := dash = ? at > 0i32 && letter <> lower ?> "-" |: ""
          kebab_from text size (at + 1i32) (out ++# dash ++# lower)

  := kebab_of (text : string) : string = kebab_from text (length text) 0i32 ""
  """,
  timeout: 300_000
)
```

