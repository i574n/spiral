<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":":= format_debug \\* t. (x : t) : string =\n    ~> format_debug_real `t x\n\n:= obj_to_string_rust \\* t. (x : t) : string =\n    ~> obj_to_string_rust_real `t x\n:= obj_to_string_fsharp \\* t. (x : t) : string =\n    $'!x |> _.ToString()' : string\n:= obj_to_string_python \\* t. (x : t) : string =\n    $'str(!x)' : string\n:= obj_to_string_typescript \\* t. (x : t) : string =\n    $'String(!x)' : string\n:= obj_to_string_wasm \\* t. (x : t) : string =\n    ? (~> ?: t ?| string => !+ | _ => !-) ?> $'!x ' : string\n    |: $'backend_switch_has_no_Wasm_arm_in_lib_spiral' : string\n:= obj_to_string_zig \\* t. (x : t) : string =\n    ? (~> ?: t ?| string => !+ | string_builder_real => !+ | _ => !-)\n    ?> $'!x ' : string\n    |? (~> ?: t ?| f32 => !+ | f64 => !+ | _ => !-)\n    ?> $'(std.fmt.allocPrint(spiral_gpa, \"{d}\", .{ !x }) catch @@panic(\"out of memory\"))' : string\n    |: $'(std.fmt.allocPrint(spiral_gpa, \"{any}\", .{ !x }) catch @@panic(\"out of memory\"))' : string\n\n:= obj_to_string_prim \\* t. (x : t) (otherwise : () -> string) : string =\n    ?\n        ~>\n            ?: t ?|\n            | bool => !+\n            | char => !+\n            | i8 => !+\n            | i16 => !+\n            | i32 => !+\n            | i64 => !+\n            | u8 => !+\n            | u16 => !+\n            | u32 => !+\n            | u64 => !+\n            | _ => !-\n    ?> !!!!PrimToString(x)\n    |: otherwise ()\n\n:= (~#?*) s =\n    s |> format_debug","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  := format_debug \* t. (x : t) : string =
      ~> format_debug_real `t x

  := obj_to_string_rust \* t. (x : t) : string =
      ~> obj_to_string_rust_real `t x
  := obj_to_string_fsharp \* t. (x : t) : string =
      $'!x |> _.ToString()' : string
  := obj_to_string_python \* t. (x : t) : string =
      $'str(!x)' : string
  := obj_to_string_typescript \* t. (x : t) : string =
      $'String(!x)' : string
  := obj_to_string_wasm \* t. (x : t) : string =
      ? (~> ?: t ?| string => !+ | _ => !-) ?> $'!x ' : string
      |: $'backend_switch_has_no_Wasm_arm_in_lib_spiral' : string
  := obj_to_string_zig \* t. (x : t) : string =
      ? (~> ?: t ?| string => !+ | string_builder_real => !+ | _ => !-)
      ?> $'!x ' : string
      |? (~> ?: t ?| f32 => !+ | f64 => !+ | _ => !-)
      ?> $'(std.fmt.allocPrint(spiral_gpa, "{d}", .{ !x }) catch @@panic("out of memory"))' : string
      |: $'(std.fmt.allocPrint(spiral_gpa, "{any}", .{ !x }) catch @@panic("out of memory"))' : string

  := obj_to_string_prim \* t. (x : t) (otherwise : () -> string) : string =
      ?
          ~>
              ?: t ?|
              | bool => !+
              | char => !+
              | i8 => !+
              | i16 => !+
              | i32 => !+
              | i64 => !+
              | u8 => !+
              | u16 => !+
              | u32 => !+
              | u64 => !+
              | _ => !-
      ?> !!!!PrimToString(x)
      |: otherwise ()

  := (~#?*) s =
      s |> format_debug
  """,
  timeout: 300_000
)
```

#### format_debug (test)

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":"///- --test --no-agree \"tests each backend's native rendering\" --symbol\n///> gleam\n///> lua\n///> fsharp\n///> cuda\n///> rust\n\n#?*(\"1\", \"2\", \"3\")\n|> _assert_eq (\n    backend_switch {\n        Gleam = \\ () => \"#(\\\"1\\\", \\\"2\\\", \\\"3\\\")\" : string\n        Lua = \\ () => \"1, 2, 3\" : string\n        Fsharp = \\ () => \"struct (\\\"1\\\", \\\"2\\\", \\\"3\\\")\" : string\n        Python = \\ () => \"('1', '2', '3')\" : string\n        Rust = \\ () => \"1, 2, 3\" : string\n    }\n)","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  ///- --test --no-agree "tests each backend's native rendering" --symbol
  ///> gleam
  ///> lua
  ///> fsharp
  ///> cuda
  ///> rust

  #?*("1", "2", "3")
  |> _assert_eq (
      backend_switch {
          Gleam = \ () => "#(\"1\", \"2\", \"3\")" : string
          Lua = \ () => "1, 2, 3" : string
          Fsharp = \ () => "struct (\"1\", \"2\", \"3\")" : string
          Python = \ () => "('1', '2', '3')" : string
          Rust = \ () => "1, 2, 3" : string
      }
  )
  """,
  timeout: 300_000
)
```

#### format_debug_lua_record_fields (test)

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":"///- --test --symbol\n///> lua\n\n:= ~a = 5i64\n{ a } |> format_debug |> _assert_eq \"5\"\n:= ~w = -9223372036854775807i64\n:= ~u = 18446744073709551615u64\n{ w; u } |> format_debug |> _assert_eq \"-9223372036854775807, 18446744073709551615\"","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  ///- --test --symbol
  ///> lua

  := ~a = 5i64
  { a } |> format_debug |> _assert_eq "5"
  := ~w = -9223372036854775807i64
  := ~u = 18446744073709551615u64
  { w; u } |> format_debug |> _assert_eq "-9223372036854775807, 18446744073709551615"
  """,
  timeout: 300_000
)
```

#### format_debug_2 (test)

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":"///- --test --no-agree \"tests each backend's native rendering\" --symbol\n///> gleam\n///> lua\n///> fsharp\n///> cuda\n///> rust\n\n#?*{ c = \"1\"; a = \"2\"; b = \"3\" }\n|> _assert_eq (\n    backend_switch {\n        Gleam = \\ () => \"#(\\\"1\\\", \\\"2\\\", \\\"3\\\")\" : string\n        Lua = \\ () => \"1, 2, 3\" : string\n        Fsharp = \\ () => \"struct (\\\"1\\\", \\\"2\\\", \\\"3\\\")\" : string\n        Python = \\ () => \"('1', '2', '3')\" : string\n        Rust = \\ () => \"{ c = 1; a = 2; b = 3 }\" : string\n    }\n)","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  ///- --test --no-agree "tests each backend's native rendering" --symbol
  ///> gleam
  ///> lua
  ///> fsharp
  ///> cuda
  ///> rust

  #?*{ c = "1"; a = "2"; b = "3" }
  |> _assert_eq (
      backend_switch {
          Gleam = \ () => "#(\"1\", \"2\", \"3\")" : string
          Lua = \ () => "1, 2, 3" : string
          Fsharp = \ () => "struct (\"1\", \"2\", \"3\")" : string
          Python = \ () => "('1', '2', '3')" : string
          Rust = \ () => "{ c = 1; a = 2; b = 3 }" : string
      }
  )
  """,
  timeout: 300_000
)
```

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":":+ unwrap_format option t = \\ x =>\n    x\n    |> optionm::value\n    |> format_debug\n\n:+ unwrap_format result t u = \\ x =>\n    x\n    |> resultm::get\n    |> format_debug\n\n:= obj_to_string \\* t. (x : t) : string =\n    ? ~> show_composite_real `t () ?> ~> show_real `t x\n    |:\n        backend_switch {\n            Gleam = \\ () => obj_to_string_prim x (\\ () => #?*x : string)\n            Lua = \\ () => obj_to_string_prim x (\\ () => #?*x : string)\n            Fsharp = \\ () => obj_to_string_prim x (\\ () => obj_to_string_fsharp x)\n            Python = \\ () => obj_to_string_prim x (\\ () => obj_to_string_python x)\n            Rust = \\ () => obj_to_string_prim x (\\ () => obj_to_string_rust x)\n            TypeScript = \\ () => obj_to_string_prim x (\\ () => obj_to_string_typescript x)\n            Zig = \\ () => obj_to_string_prim x (\\ () => obj_to_string_zig x)\n            Lean = \\ () => obj_to_string_prim x (\\ () => $'toString !x ' : string)\n            Wasm = \\ () => obj_to_string_prim x (\\ () => obj_to_string_wasm x)\n            C = \\ () => obj_to_string_prim x (\\ () => failwith \"sm'.obj_to_string / the C backend prints integers, bools and chars only\")\n            Pascal = \\ () => obj_to_string_prim x (\\ () => failwith \"sm'.obj_to_string / the Pascal backend prints integers, bools and chars only\")\n        }","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  :+ unwrap_format option t = \ x =>
      x
      |> optionm::value
      |> format_debug

  :+ unwrap_format result t u = \ x =>
      x
      |> resultm::get
      |> format_debug

  := obj_to_string \* t. (x : t) : string =
      ? ~> show_composite_real `t () ?> ~> show_real `t x
      |:
          backend_switch {
              Gleam = \ () => obj_to_string_prim x (\ () => #?*x : string)
              Lua = \ () => obj_to_string_prim x (\ () => #?*x : string)
              Fsharp = \ () => obj_to_string_prim x (\ () => obj_to_string_fsharp x)
              Python = \ () => obj_to_string_prim x (\ () => obj_to_string_python x)
              Rust = \ () => obj_to_string_prim x (\ () => obj_to_string_rust x)
              TypeScript = \ () => obj_to_string_prim x (\ () => obj_to_string_typescript x)
              Zig = \ () => obj_to_string_prim x (\ () => obj_to_string_zig x)
              Lean = \ () => obj_to_string_prim x (\ () => $'toString !x ' : string)
              Wasm = \ () => obj_to_string_prim x (\ () => obj_to_string_wasm x)
              C = \ () => obj_to_string_prim x (\ () => failwith "sm'.obj_to_string / the C backend prints integers, bools and chars only")
              Pascal = \ () => obj_to_string_prim x (\ () => failwith "sm'.obj_to_string / the Pascal backend prints integers, bools and chars only")
          }
  """,
  timeout: 300_000
)
```

