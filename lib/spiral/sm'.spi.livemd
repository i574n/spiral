)
```

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":":= line_parts (text : string) : array_base string =\n    split \"\\n\" text\n\n:= line_part_count (parts : array_base string) : int =\n    := n : int = parts |> array |> am'::length\n    ? n > 0 && am'::index_base (n - 1) parts = \"\" ?> n - 1 |: n\n\n:= line_without_return (line : string) : string =\n    := n : int = length line\n    ? ends_with \"\\r\" line |> not ?> line\n    |? n = 1 ?> \"\"\n    |: slice 0 (n - 2) line\n\n:= nonempty_line_fold \\* s. (f : s -> string -> s) (init : s) (text : string) : s =\n    := parts = line_parts text\n    := count = line_part_count parts\n    :~ ^ go (i : int) (acc : s) : s =\n        ? i >= count ?> acc\n        |:\n            := line = parts |> am'::index_base i |> line_without_return\n            go (i + 1) (? line = \"\" ?> acc |: f acc line)\n    go 0 init\n\n:= lines (text : string) : array string =\n    run_target \\|\n        | Rust => \\ () =>\n            $'Rc::new(RefCell::new(!text.lines().map(Rc::<str>::from).collect::<Vec<Rc<str>>>()))' : array string\n        | _ => \\ () =>\n            := parts = line_parts text\n            (arraym::init (line_part_count parts) (\\ i => parts |> am'::index_base i |> line_without_return) : array string)\n\n:= nonempty_lines (text : string) : array string =\n    run_target \\|\n        | Rust => \\ () =>\n            nonempty_line_fold (\\ acc line => acc |> am'::vec_push line) (am'::new_vec []) text |> am'::from_vec\n        | _ => \\ () =>\n            := parts = line_parts text\n            (arraym::init (line_part_count parts) (\\ i => parts |> am'::index_base i |> line_without_return) : array string)\n            |> arraym::filter (\\ line => line <> \"\")","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  := line_parts (text : string) : array_base string =
      split "\n" text

  := line_part_count (parts : array_base string) : int =
      := n : int = parts |> array |> am'::length
      ? n > 0 && am'::index_base (n - 1) parts = "" ?> n - 1 |: n

  := line_without_return (line : string) : string =
      := n : int = length line
      ? ends_with "\r" line |> not ?> line
      |? n = 1 ?> ""
      |: slice 0 (n - 2) line

  := nonempty_line_fold \* s. (f : s -> string -> s) (init : s) (text : string) : s =
      := parts = line_parts text
      := count = line_part_count parts
      :~ ^ go (i : int) (acc : s) : s =
          ? i >= count ?> acc
          |:
              := line = parts |> am'::index_base i |> line_without_return
              go (i + 1) (? line = "" ?> acc |: f acc line)
      go 0 init

  := lines (text : string) : array string =
      run_target \|
          | Rust => \ () =>
              $'Rc::new(RefCell::new(!text.lines().map(Rc::<str>::from).collect::<Vec<Rc<str>>>()))' : array string
          | _ => \ () =>
              := parts = line_parts text
              (arraym::init (line_part_count parts) (\ i => parts |> am'::index_base i |> line_without_return) : array string)

  := nonempty_lines (text : string) : array string =
      run_target \|
          | Rust => \ () =>
              nonempty_line_fold (\ acc line => acc |> am'::vec_push line) (am'::new_vec []) text |> am'::from_vec
          | _ => \ () =>
              := parts = line_parts text
              (arraym::init (line_part_count parts) (\ i => parts |> am'::index_base i |> line_without_return) : array string)
              |> arraym::filter (\ line => line <> "")
  """,
  timeout: 300_000
)
```

#### lines_follow_rust_line_rules (test)

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":"///- --test --symbol\n///> rust\n///> gleam\n///> c\n\n:= text = \"a\\r\\n\\nb\\n\"\n(am'::length (lines text) : int) |> _assert_eq 3\n(am'::length (nonempty_lines text) : int) |> _assert_eq 2\nam'::index 0 (lines text) |> _assert_eq \"a\"\nam'::index 1 (nonempty_lines text) |> _assert_eq \"b\"\n(am'::length (lines \"\") : int) |> _assert_eq 0","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  ///- --test --symbol
  ///> rust
  ///> gleam
  ///> c

  := text = "a\r\n\nb\n"
  (am'::length (lines text) : int) |> _assert_eq 3
  (am'::length (nonempty_lines text) : int) |> _assert_eq 2
  am'::index 0 (lines text) |> _assert_eq "a"
  am'::index 1 (nonempty_lines text) |> _assert_eq "b"
  (am'::length (lines "") : int) |> _assert_eq 0
  """,
  timeout: 300_000
)
```

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":":= line_count (text : string) : int =\n    text |> line_parts |> line_part_count\n\n:= nonempty_line_count (text : string) : int =\n    nonempty_line_fold (\\ n _ => n + 1) 0 text\n\n:= line_at (index : int) (text : string) : string =\n    := parts = line_parts text\n    ? index >= 0 && index < line_part_count parts ?> parts |> am'::index_base index |> line_without_return |: \"\"\n\n:= nonempty_line_at (index : int) (text : string) : string =\n    := _, found =\n        nonempty_line_fold (\\ (seen, found) line => seen + 1, (? seen = index ?> line |: found)) (0, \"\") text\n    found","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  := line_count (text : string) : int =
      text |> line_parts |> line_part_count

  := nonempty_line_count (text : string) : int =
      nonempty_line_fold (\ n _ => n + 1) 0 text

  := line_at (index : int) (text : string) : string =
      := parts = line_parts text
      ? index >= 0 && index < line_part_count parts ?> parts |> am'::index_base index |> line_without_return |: ""

  := nonempty_line_at (index : int) (text : string) : string =
      := _, found =
          nonempty_line_fold (\ (seen, found) line => seen + 1, (? seen = index ?> line |: found)) (0, "") text
      found
  """,
  timeout: 300_000
)
```

