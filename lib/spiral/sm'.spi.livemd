)
```

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":":= convert_to_utf32 (c : char) : int =\n    backend_switch {\n        Gleam = \\ () => c |> convert::i32\n        Lua = \\ () => c |> convert::i32\n        Fsharp = \\ () =>\n            run_target_args' c \\|\n            | Fsharp => \\ c => $'System.Char.ConvertToUtf32 (string !c, 0)' : int\n            | _ => \\ c => c |> convert::i32\n        Python = \\ () => $'ord(!c)' : int\n        Rust = \\ () => $'(!c as `int)' : int\n        TypeScript = \\ () => $'(!c)' : int\n        Zig = \\ () => $'@@as(`int, !c)' : int\n    }\n\n:= ends_with (value : string) (s : string) : bool =\n    backend_switch {\n        Gleam = \\ () =>\n            global \"import gleam/string\"\n            $'!s |> string.ends_with(!value)' : bool\n        Fsharp = \\ () => $'!s.EndsWith (!value, false, null)' : bool\n        Python = \\ () => $'!s.endswith(!value)' : bool\n        Rust = \\ () => $'!s.ends_with(&*!value)' : bool\n        TypeScript = \\ () => $'!s.endsWith(!value)' : bool\n        Lua = \\ () => $'!value == \"\" or !s:sub(-##!value) == !value ' : bool\n        Zig = \\ () => $'std.mem.endsWith(u8, !s, !value)' : bool\n        C = \\ () => portable_ends_with value s\n        Pascal = \\ () => portable_ends_with value s\n        Kotlin = \\ () => $'(!s).endsWith(!value)' : bool\n        Lean = \\ () => $'(!s).endsWith !value ' : bool\n    }\n\n:= starts_with (value : string) (s : string) : bool =\n    backend_switch {\n        Gleam = \\ () =>\n            global \"import gleam/string\"\n            $'!s |> string.starts_with(!value)' : bool\n        Lua = \\ () => $'!value == \"\" or !s:sub(1, ##!value) == !value ' : bool\n        Fsharp = \\ () => $'(!s).StartsWith(!value, System.StringComparison.Ordinal)' : bool\n        Python = \\ () => $'!s.startswith(!value)' : bool\n        Rust = \\ () => $'!s.starts_with(&*!value)' : bool\n        TypeScript = \\ () => $'!s.startsWith(!value)' : bool\n        Zig = \\ () => $'std.mem.startsWith(u8, !s, !value)' : bool\n        C = \\ () => portable_starts_with value s\n        Pascal = \\ () => portable_starts_with value s\n        Kotlin = \\ () => $'(!s).startsWith(!value)' : bool\n        Lean = \\ () => $'(!s).startsWith !value ' : bool\n    }\n\n:= substring (start : i32) (len : i32) (str : string) : string =\n    run_target \\|\n        | Rust => \\ () =>\n            := from : convert::unativeint = convert::convert start\n            := until : convert::unativeint = convert::convert (start + len)\n            $'Rc::<str>::from(&(!str)[!from..!until])' : string\n        | Zig => \\ () =>\n            := until = start + len\n            $'(!str)[@@intCast(!start)..@@intCast(!until)]' : string\n        | Gleam => \\ () => sm::slice str { from = start; to = start + len - 1 }\n        | Lua => \\ () =>\n            := from = start + 1i32\n            := until = start + len\n            $'string.sub(!str, !from, !until)' : string\n        | Pascal => \\ () =>\n            := from = start + 1i32\n            $'Copy(!str, !from, !len)' : string\n        | _ => \\ () => $'!str.Substring (!start, !len)'","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  := convert_to_utf32 (c : char) : int =
      backend_switch {
          Gleam = \ () => c |> convert::i32
          Lua = \ () => c |> convert::i32
          Fsharp = \ () =>
              run_target_args' c \|
              | Fsharp => \ c => $'System.Char.ConvertToUtf32 (string !c, 0)' : int
              | _ => \ c => c |> convert::i32
          Python = \ () => $'ord(!c)' : int
          Rust = \ () => $'(!c as `int)' : int
          TypeScript = \ () => $'(!c)' : int
          Zig = \ () => $'@@as(`int, !c)' : int
      }

  := ends_with (value : string) (s : string) : bool =
      backend_switch {
          Gleam = \ () =>
              global "import gleam/string"
              $'!s |> string.ends_with(!value)' : bool
          Fsharp = \ () => $'!s.EndsWith (!value, false, null)' : bool
          Python = \ () => $'!s.endswith(!value)' : bool
          Rust = \ () => $'!s.ends_with(&*!value)' : bool
          TypeScript = \ () => $'!s.endsWith(!value)' : bool
          Lua = \ () => $'!value == "" or !s:sub(-##!value) == !value ' : bool
          Zig = \ () => $'std.mem.endsWith(u8, !s, !value)' : bool
          C = \ () => portable_ends_with value s
          Pascal = \ () => portable_ends_with value s
          Kotlin = \ () => $'(!s).endsWith(!value)' : bool
          Lean = \ () => $'(!s).endsWith !value ' : bool
      }

  := starts_with (value : string) (s : string) : bool =
      backend_switch {
          Gleam = \ () =>
              global "import gleam/string"
              $'!s |> string.starts_with(!value)' : bool
          Lua = \ () => $'!value == "" or !s:sub(1, ##!value) == !value ' : bool
          Fsharp = \ () => $'(!s).StartsWith(!value, System.StringComparison.Ordinal)' : bool
          Python = \ () => $'!s.startswith(!value)' : bool
          Rust = \ () => $'!s.starts_with(&*!value)' : bool
          TypeScript = \ () => $'!s.startsWith(!value)' : bool
          Zig = \ () => $'std.mem.startsWith(u8, !s, !value)' : bool
          C = \ () => portable_starts_with value s
          Pascal = \ () => portable_starts_with value s
          Kotlin = \ () => $'(!s).startsWith(!value)' : bool
          Lean = \ () => $'(!s).startsWith !value ' : bool
      }

  := substring (start : i32) (len : i32) (str : string) : string =
      run_target \|
          | Rust => \ () =>
              := from : convert::unativeint = convert::convert start
              := until : convert::unativeint = convert::convert (start + len)
              $'Rc::<str>::from(&(!str)[!from..!until])' : string
          | Zig => \ () =>
              := until = start + len
              $'(!str)[@@intCast(!start)..@@intCast(!until)]' : string
          | Gleam => \ () => sm::slice str { from = start; to = start + len - 1 }
          | Lua => \ () =>
              := from = start + 1i32
              := until = start + len
              $'string.sub(!str, !from, !until)' : string
          | Pascal => \ () =>
              := from = start + 1i32
              $'Copy(!str, !from, !len)' : string
          | _ => \ () => $'!str.Substring (!start, !len)'
  """,
  timeout: 300_000
)
```

