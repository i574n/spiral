<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":"///- --test --symbol\n///> gleam\n///> cuda\n///> rust\n///> typescript\n\n\"123\"\n|> pad_right 6 ' '\n|> _assert_eq \"123   \"","print_code":false},"livebook_object":"smart_cell"} -->

