<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":":= serialize \\* t. (x : t) : resultm::result' std_string json_error =\n    !\\($'\"serde_json::to_string(&!x)\"')\n\n:= deserialize \\* t. (json : string) : resultm::result' t std_string =\n    := json = ~~ json\n    := json = json |> as_str\n    !\\\\(json, $'\"serde_json::from_str(&$0)\"')\n    |> resultm::map_error' \\ (x : json_error) => x |> format'\n\n:= borsh_serialize \\* t. (data : t) : am'::vec u8 =\n    (!\\($'\"true; let mut data = Vec::new()\"') : bool) |> ignore\n    (!\\\\(data, $'\"true; borsh::BorshSerialize::serialize(&$0, &mut data).unwrap()\"') : bool) |> ignore\n    !\\($'\"data\"')\n\n:= borsh_deserialize \\* t. (data : array_base u8) : resultm::result' t std_string =\n    := data = data |> am'::as_slice\n    (!\\($'\"true; let mut !data = !data\"') : bool) |> ignore\n    := result = !\\($'\"borsh::BorshDeserialize::deserialize(&mut !data)\"')\n    result\n    |> resultm::map_error' \\ (x : borsh_io_error) => x |> format'\n\n:= deserialize_vec (value : json_value) : resultm::result' (am'::vec u8) std_string =\n    := value = ~~ value\n    !\\($'\"serde_json::from_value(!value)\"')\n    |> resultm::map_error' \\ (x : json_error) => x |> format'\n\n:= encode_uri_component (s : std_string) : js_string =\n    !\\($'\"js_sys::encode_uri_component(&!s)\"')\n\n:= percent_encode_gleam () =\n    global \"\"\"\n        @external(erlang, \"binary\", \"bin_to_list\")\n        fn spiral_sm_utf8_bytes(text: String) -> List(Int)\n        \"\"\"\n\n:= utf8_byte_list (s : string) : listm'::list' u8 =\n    backend_switch {\n        Gleam = \\ () =>\n            percent_encode_gleam ()\n            $'spiral_sm_utf8_bytes(!s)' : listm'::list' u8\n        Rust = \\ () => $'Rc::new(!s.bytes().collect())' : listm'::list' u8\n    }\n\n:= percent_unreserved (b : u8) : bool =\n    (b >= 48u8 && b <= 57u8) || (b >= 65u8 && b <= 90u8) || (b >= 97u8 && b <= 122u8)\n    || b = 45u8 || b = 46u8 || b = 95u8 || b = 126u8\n\n:= ascii_text (b : u8) : string =\n    := position : int = conv b - 32\n    := upper = \" !\\\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ\"\n    := table = upper ++# \"[\\\\]^_`abcdefghijklmnopqrstuvwxyz{|}~\"\n    slice position position table\n\n:= hex_digit (n : u8) : string =\n    := position : int = conv n\n    slice position position \"0123456789ABCDEF\"\n\n:= percent_byte (b : u8) : string =\n    ? percent_unreserved b ?> ascii_text b |: \"%\" ++# hex_digit (b >>> 4i32) ++# hex_digit (b &&& 15u8)\n\n:= percent_encode (s : string) : string =\n    s\n    |> utf8_byte_list\n    |> listm'::fold' percent_byte []\n    |> listm::fold (\\ acc piece => piece ++# acc) \"\"","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ":= serialize \\* t. (x : t) : resultm::result' std_string json_error =\n    !\\($'\"serde_json::to_string(&!x)\"')\n\n:= deserialize \\* t. (json : string) : resultm::result' t std_string =\n    := json = ~~ json\n    := json = json |> as_str\n    !\\\\(json, $'\"serde_json::from_str(&$0)\"')\n    |> resultm::map_error' \\ (x : json_error) => x |> format'\n\n:= borsh_serialize \\* t. (data : t) : am'::vec u8 =\n    (!\\($'\"true; let mut data = Vec::new()\"') : bool) |> ignore\n    (!\\\\(data, $'\"true; borsh::BorshSerialize::serialize(&$0, &mut data).unwrap()\"') : bool) |> ignore\n    !\\($'\"data\"')\n\n:= borsh_deserialize \\* t. (data : array_base u8) : resultm::result' t std_string =\n    := data = data |> am'::as_slice\n    (!\\($'\"true; let mut !data = !data\"') : bool) |> ignore\n    := result = !\\($'\"borsh::BorshDeserialize::deserialize(&mut !data)\"')\n    result\n    |> resultm::map_error' \\ (x : borsh_io_error) => x |> format'\n\n:= deserialize_vec (value : json_value) : resultm::result' (am'::vec u8) std_string =\n    := value = ~~ value\n    !\\($'\"serde_json::from_value(!value)\"')\n    |> resultm::map_error' \\ (x : json_error) => x |> format'\n\n:= encode_uri_component (s : std_string) : js_string =\n    !\\($'\"js_sys::encode_uri_component(&!s)\"')\n\n:= percent_encode_gleam () =\n    global \"\"\"\n        @external(erlang, \"binary\", \"bin_to_list\")\n        fn spiral_sm_utf8_bytes(text: String) -> List(Int)\n        \"\"\"\n\n:= utf8_byte_list (s : string) : listm'::list' u8 =\n    backend_switch {\n        Gleam = \\ () =>\n            percent_encode_gleam ()\n            $'spiral_sm_utf8_bytes(!s)' : listm'::list' u8\n        Rust = \\ () => $'Rc::new(!s.bytes().collect())' : listm'::list' u8\n    }\n\n:= percent_unreserved (b : u8) : bool =\n    (b >= 48u8 && b <= 57u8) || (b >= 65u8 && b <= 90u8) || (b >= 97u8 && b <= 122u8)\n    || b = 45u8 || b = 46u8 || b = 95u8 || b = 126u8\n\n:= ascii_text (b : u8) : string =\n    := position : int = conv b - 32\n    := upper = \" !\\\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ\"\n    := table = upper ++# \"[\\\\]^_`abcdefghijklmnopqrstuvwxyz{|}~\"\n    slice position position table\n\n:= hex_digit (n : u8) : string =\n    := position : int = conv n\n    slice position position \"0123456789ABCDEF\"\n\n:= percent_byte (b : u8) : string =\n    ? percent_unreserved b ?> ascii_text b |: \"%\" ++# hex_digit (b >>> 4i32) ++# hex_digit (b &&& 15u8)\n\n:= percent_encode (s : string) : string =\n    s\n    |> utf8_byte_list\n    |> listm'::fold' percent_byte []\n    |> listm::fold (\\ acc piece => piece ++# acc) \"\"",
  timeout: 300_000
)
