<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":":= to_upper (input : string) : string =\n    backend_switch {\n        Gleam = \\ () =>\n            global \"import gleam/string\"\n            $'!input |> string.uppercase' : string\n        Lua = \\ () => $'string.upper(!input)' : string\n        Fsharp = \\ () => $'!input.ToUpper' () : string\n        Python = \\ () => $'!input.upper()' : string\n        Rust = \\ () => $'Rc::<str>::from(!input.to_uppercase())' : string\n        TypeScript = \\ () => $'!input.toUpperCase()' : string\n        Zig = \\ () => $'(std.ascii.allocUpperString(spiral_gpa, !input) catch @@panic(\"out of memory\"))' : string\n        Lean = \\ () => $'(!input).toUpper' : string\n        Pascal = \\ () => $'UpperCase(!input)' : string\n        C = \\ () => ascii_case !+ input\n    }\n\n:= char_to_upper (input : char) : char =\n    backend_switch {\n        Gleam = \\ () =>\n            global \"import gleam/string\"\n            $'!input |> string.uppercase' : char\n        Lua = \\ () => $'string.upper(!input)' : char\n        Fsharp = \\ () => $'System.Char.ToUpper !input ' : char\n        Python = \\ () => $'!input.upper()' : char\n        Rust = \\ () => $'!input.to_ascii_uppercase()' : char\n        TypeScript = \\ () => $'String.fromCharCode(!input).toUpperCase().charCodeAt(0)' : char\n        Zig = \\ () => $'std.ascii.toUpper(!input)' : char\n        Lean = \\ () => $'(!input).toUpper' : char\n        C = \\ () => $'((!input >= 97 && !input <= 122) ? (char)(!input - 32) : !input)' : char\n        Pascal = \\ () => $'UpCase(!input)' : char\n    }","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  := to_upper (input : string) : string =
      backend_switch {
          Gleam = \ () =>
              global "import gleam/string"
              $'!input |> string.uppercase' : string
          Lua = \ () => $'string.upper(!input)' : string
          Fsharp = \ () => $'!input.ToUpper' () : string
          Python = \ () => $'!input.upper()' : string
          Rust = \ () => $'Rc::<str>::from(!input.to_uppercase())' : string
          TypeScript = \ () => $'!input.toUpperCase()' : string
          Zig = \ () => $'(std.ascii.allocUpperString(spiral_gpa, !input) catch @@panic("out of memory"))' : string
          Lean = \ () => $'(!input).toUpper' : string
          Pascal = \ () => $'UpperCase(!input)' : string
          C = \ () => ascii_case !+ input
      }

  := char_to_upper (input : char) : char =
      backend_switch {
          Gleam = \ () =>
              global "import gleam/string"
              $'!input |> string.uppercase' : char
          Lua = \ () => $'string.upper(!input)' : char
          Fsharp = \ () => $'System.Char.ToUpper !input ' : char
          Python = \ () => $'!input.upper()' : char
          Rust = \ () => $'!input.to_ascii_uppercase()' : char
          TypeScript = \ () => $'String.fromCharCode(!input).toUpperCase().charCodeAt(0)' : char
          Zig = \ () => $'std.ascii.toUpper(!input)' : char
          Lean = \ () => $'(!input).toUpper' : char
          C = \ () => $'((!input >= 97 && !input <= 122) ? (char)(!input - 32) : !input)' : char
          Pascal = \ () => $'UpCase(!input)' : char
      }
  """,
  timeout: 300_000
)
```

