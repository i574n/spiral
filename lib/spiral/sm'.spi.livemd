<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":":= char_code (input : char) : u32 =\n    backend_switch {\n        Fsharp = \\ () => $'uint32 !input ' : u32\n        Python = \\ () => $'ord(!input)' : u32\n        Rust = \\ () => $'u32::from(!input)' : u32\n        TypeScript = \\ () => $'!input' : u32\n        Lua = \\ () =>\n            := byte (at : i32) : u32 = $'string.byte(!input, !at)' : u32\n            := lead = byte 1i32\n            ? lead < 128u32 ?> lead\n            |? lead < 224u32 ?> (lead % 32u32) * 64u32 + byte 2i32 % 64u32\n            |? lead < 240u32 ?> (lead % 16u32) * 4096u32 + (byte 2i32 % 64u32) * 64u32 + byte 3i32 % 64u32\n            |: (lead % 8u32) * 262144u32 + (byte 2i32 % 64u32) * 4096u32 + (byte 3i32 % 64u32) * 64u32 + byte 4i32 % 64u32\n        C = \\ () => $'((uint32_t)(unsigned char)!input)' : u32\n        Zig = \\ () => $'@@as(u32, !input)' : u32\n        Pascal = \\ () => $'LongWord(Ord(!input))' : u32\n        Gleam = \\ () =>\n            global \"import gleam/string\"\n            $'case string.to_utf_codepoints(!input) { [c, ..] -> string.utf_codepoint_to_int(c) _ -> 0 }' : u32\n    }\n\n:| ascii_class =\n    | AsciiLetter\n    | AsciiDigit\n    | AsciiSpace\n    | AsciiOther\n\n:= ascii_class_of (input : char) : ascii_class =\n    := c : u32 = char_code input\n    ? (65u32 <= c && c <= 90u32) || (97u32 <= c && c <= 122u32) ?> AsciiLetter\n    |? 48u32 <= c && c <= 57u32 ?> AsciiDigit\n    |? c = 32u32 || (9u32 <= c && c <= 13u32) ?> AsciiSpace\n    |: AsciiOther\n\n:= is_ascii_letter (input : char) : bool = ?= ascii_class_of input ?| AsciiLetter => !+ | _ => !-\n\n:= is_ascii_digit (input : char) : bool = ?= ascii_class_of input ?| AsciiDigit => !+ | _ => !-\n\n:= is_ascii_space (input : char) : bool = ?= ascii_class_of input ?| AsciiSpace => !+ | _ => !-\n\n:= of_char (input : char) : string =\n    backend_switch {\n        Fsharp = \\ () => $'string !input ' : string\n        Python = \\ () => $'!input' : string\n        Rust = \\ () =>\n            := text = $'char::from(!input).to_string()' : std_string\n            from_std_string text\n        TypeScript = \\ () => $'String.fromCharCode(!input)' : string\n        Lua = \\ () => $'!input' : string\n        Gleam = \\ () => $'!input' : string\n        C = \\ () => !!!!PrimToString(input) : string\n    }","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  := char_code (input : char) : u32 =
      backend_switch {
          Fsharp = \ () => $'uint32 !input ' : u32
          Python = \ () => $'ord(!input)' : u32
          Rust = \ () => $'u32::from(!input)' : u32
          TypeScript = \ () => $'!input' : u32
          Lua = \ () =>
              := byte (at : i32) : u32 = $'string.byte(!input, !at)' : u32
              := lead = byte 1i32
              ? lead < 128u32 ?> lead
              |? lead < 224u32 ?> (lead % 32u32) * 64u32 + byte 2i32 % 64u32
              |? lead < 240u32 ?> (lead % 16u32) * 4096u32 + (byte 2i32 % 64u32) * 64u32 + byte 3i32 % 64u32
              |: (lead % 8u32) * 262144u32 + (byte 2i32 % 64u32) * 4096u32 + (byte 3i32 % 64u32) * 64u32 + byte 4i32 % 64u32
          C = \ () => $'((uint32_t)(unsigned char)!input)' : u32
          Zig = \ () => $'@@as(u32, !input)' : u32
          Pascal = \ () => $'LongWord(Ord(!input))' : u32
          Gleam = \ () =>
              global "import gleam/string"
              $'case string.to_utf_codepoints(!input) { [c, ..] -> string.utf_codepoint_to_int(c) _ -> 0 }' : u32
      }

  :| ascii_class =
      | AsciiLetter
      | AsciiDigit
      | AsciiSpace
      | AsciiOther

  := ascii_class_of (input : char) : ascii_class =
      := c : u32 = char_code input
      ? (65u32 <= c && c <= 90u32) || (97u32 <= c && c <= 122u32) ?> AsciiLetter
      |? 48u32 <= c && c <= 57u32 ?> AsciiDigit
      |? c = 32u32 || (9u32 <= c && c <= 13u32) ?> AsciiSpace
      |: AsciiOther

  := is_ascii_letter (input : char) : bool = ?= ascii_class_of input ?| AsciiLetter => !+ | _ => !-

  := is_ascii_digit (input : char) : bool = ?= ascii_class_of input ?| AsciiDigit => !+ | _ => !-

  := is_ascii_space (input : char) : bool = ?= ascii_class_of input ?| AsciiSpace => !+ | _ => !-

  := of_char (input : char) : string =
      backend_switch {
          Fsharp = \ () => $'string !input ' : string
          Python = \ () => $'!input' : string
          Rust = \ () =>
              := text = $'char::from(!input).to_string()' : std_string
              from_std_string text
          TypeScript = \ () => $'String.fromCharCode(!input)' : string
          Lua = \ () => $'!input' : string
          Gleam = \ () => $'!input' : string
          C = \ () => !!!!PrimToString(input) : string
      }
  """,
  timeout: 300_000
)
```

