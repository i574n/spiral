### show_real

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":"///- --real\n\n:= ^ show_real \\* t. (x : t) : string =\n    ?: t ?|\n    | string => x\n    | ~a * ~b => \"(\" ++#* show_items_real `t x ++#* \")\"\n    | {} =>\n        := _, fields =\n            real_core::record_fold\n                \\ { state = separator, acc key value } =>\n                    \"; \",\n                    acc ++#* separator ++#* symbol_to_string_real `(`key) ++#* \" = \" ++#* show_real `(`value) value\n                (\"\", \"\")\n                x\n        \"{ \" ++#* fields ++#* \" }\"\n    | array_base ~el => show_elements_real `el x\n    | _ =>\n        ? real_core::union_type_is `t\n        ?> show_union_real `t x\n        |? real_core::nominal_type_is `t\n        ?> show_nominal_real `t x\n        |: format_real `t x\n:& := show_items_real \\* t. (x : t) : string =\n    ?: t ?|\n    | () * ~b =>\n        := _, b = x\n        show_items_real `b b\n    | ~a * ~b =>\n        := a, b = x\n        show_real `a a ++#* \", \" ++#* show_items_real `b b\n    | _ => show_real `t x\n:& := show_union_real \\* t. (x : t) : string =\n    ~~\n        real_core::unbox x \\ k, v =>\n            := name = symbol_to_string_real `(`k)\n            ?: `v ?|\n            | () => name\n            | _ => name ++#* \"(\" ++#* show_items_real `(`v) v ++#* \")\"\n    : string\n:& := show_nominal_real \\* t. (x : t) : string =\n    := y = real_core::nominal_strip x\n    ? real_core::prototype_has `t show_as\n    ?> show_as `t x\n    |? real_core::prototype_has `t printable\n    ?> format_real `t x\n    |? show_structural_real `(`y) ()\n    ?> show_real `(`y) y\n    |: format_debug_real `t x\n:& := show_structural_real \\* u. () : bool =\n    ?: u ?|\n    | string => !+\n    | ~a * ~b => !+\n    | {} => !+\n    | array_base _ => !+\n    | _ => real_core::prim_type_is `u || real_core::union_type_is `u || real_core::nominal_type_is `u\n:& := show_elements_real \\* el. (x : array_base el) : string =\n    ~~\n        := n = !!!!ArrayLength(`u64, x)\n        := i = mut `u64 (real_core::dyn 0u64)\n        := s = mut `string (real_core::dyn \"\")\n        loop::while' (\\ () => !!!!LT(!!!!LayoutIndex(i), n)) \\ () =>\n            := j = !!!!LayoutIndex(i)\n            := e = show_real `el !!!!ArrayIndex(x, j)\n            s <- (? !!!!EQ(j, 0u64) ?> e |: !!!!LayoutIndex(s) ++#* \", \" ++#* e)\n            i <- !!!!Add(j, 1u64)\n        \"[\" ++#* !!!!LayoutIndex(s) ++#* \"]\"\n    : string\n\n:= show_composite_real \\* t. () : bool =\n    ?: t ?|\n    | string => !-\n    | ~a * ~b => !+\n    | {} => !+\n    | array_base _ => !+\n    | _ => real_core::union_type_is `t","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  ///- --real

  := ^ show_real \* t. (x : t) : string =
      ?: t ?|
      | string => x
      | ~a * ~b => "(" ++#* show_items_real `t x ++#* ")"
      | {} =>
          := _, fields =
              real_core::record_fold
                  \ { state = separator, acc key value } =>
                      "; ",
                      acc ++#* separator ++#* symbol_to_string_real `(`key) ++#* " = " ++#* show_real `(`value) value
                  ("", "")
                  x
          "{ " ++#* fields ++#* " }"
      | array_base ~el => show_elements_real `el x
      | _ =>
          ? real_core::union_type_is `t
          ?> show_union_real `t x
          |? real_core::nominal_type_is `t
          ?> show_nominal_real `t x
          |: format_real `t x
  :& := show_items_real \* t. (x : t) : string =
      ?: t ?|
      | () * ~b =>
          := _, b = x
          show_items_real `b b
      | ~a * ~b =>
          := a, b = x
          show_real `a a ++#* ", " ++#* show_items_real `b b
      | _ => show_real `t x
  :& := show_union_real \* t. (x : t) : string =
      ~~
          real_core::unbox x \ k, v =>
              := name = symbol_to_string_real `(`k)
              ?: `v ?|
              | () => name
              | _ => name ++#* "(" ++#* show_items_real `(`v) v ++#* ")"
      : string
  :& := show_nominal_real \* t. (x : t) : string =
      := y = real_core::nominal_strip x
      ? real_core::prototype_has `t show_as
      ?> show_as `t x
      |? real_core::prototype_has `t printable
      ?> format_real `t x
      |? show_structural_real `(`y) ()
      ?> show_real `(`y) y
      |: format_debug_real `t x
  :& := show_structural_real \* u. () : bool =
      ?: u ?|
      | string => !+
      | ~a * ~b => !+
      | {} => !+
      | array_base _ => !+
      | _ => real_core::prim_type_is `u || real_core::union_type_is `u || real_core::nominal_type_is `u
  :& := show_elements_real \* el. (x : array_base el) : string =
      ~~
          := n = !!!!ArrayLength(`u64, x)
          := i = mut `u64 (real_core::dyn 0u64)
          := s = mut `string (real_core::dyn "")
          loop::while' (\ () => !!!!LT(!!!!LayoutIndex(i), n)) \ () =>
              := j = !!!!LayoutIndex(i)
              := e = show_real `el !!!!ArrayIndex(x, j)
              s <- (? !!!!EQ(j, 0u64) ?> e |: !!!!LayoutIndex(s) ++#* ", " ++#* e)
              i <- !!!!Add(j, 1u64)
          "[" ++#* !!!!LayoutIndex(s) ++#* "]"
      : string

  := show_composite_real \* t. () : bool =
      ?: t ?|
      | string => !-
      | ~a * ~b => !+
      | {} => !+
      | array_base _ => !+
      | _ => real_core::union_type_is `t
  """,
  timeout: 300_000
)
```

