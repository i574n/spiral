<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":":= builder_clear (sb : string_builder) : string_builder =\n    backend_switch {\n        Gleam = \\ () =>\n            $'let !sb = \"\"'\n            sb\n        Lua = \\ () =>\n            $'!sb = \"\"'\n            sb\n        Fsharp = \\ () =>\n            ($'!sb.Clear' () : string_builder) |> ignore\n            sb\n        Python = \\ () =>\n            ($'!sb.truncate(0)' : int) |> ignore\n            ($'!sb.seek(0)' : int) |> ignore\n            sb\n        Rust = \\ () => $'String::new()' : string_builder\n        TypeScript = \\ () => $'\"\"' : string_builder\n        Zig = \\ () => $'\"\"' : string_builder\n    }","print_code":false},"livebook_object":"smart_cell"} -->

