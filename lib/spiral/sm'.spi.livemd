<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":":= strip_prefix (prefix : char) (s : std_string) : optionm'::option' (rust::ref str) =\n    := s = ~~ s\n    $'!s.strip_prefix(char::from(!prefix))' : optionm'::option' (rust::ref str)\n\n:= str_from_utf8 (bytes : rust::ref (am'::slice u8)) : resultm::result' (rust::ref str) utf8_error =\n    !\\\\(bytes, $'\"std::str::from_utf8($0)\"')\n\n:= string_from_utf8 (bytes : am'::vec u8) : resultm::result' std_string from_utf8_error =\n    := bytes = ~~ bytes\n    !\\\\(bytes, $'\"std::string::String::from_utf8($0)\"')\n\n:! encoding' =\n    `(\n        rust::rust_type\n            `($'encoding_rs_Encoding')\n            `($'encoding_rs::Encoding')\n            \"type encoding_rs_Encoding = class end\"\n    )\n\n:= encoding_utf8' () : rust::ref encoding' =\n    !\\($'\"encoding_rs::UTF_8\"')","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  := strip_prefix (prefix : char) (s : std_string) : optionm'::option' (rust::ref str) =
      := s = ~~ s
      $'!s.strip_prefix(char::from(!prefix))' : optionm'::option' (rust::ref str)

  := str_from_utf8 (bytes : rust::ref (am'::slice u8)) : resultm::result' (rust::ref str) utf8_error =
      !\\(bytes, $'"std::str::from_utf8($0)"')

  := string_from_utf8 (bytes : am'::vec u8) : resultm::result' std_string from_utf8_error =
      := bytes = ~~ bytes
      !\\(bytes, $'"std::string::String::from_utf8($0)"')

  :! encoding' =
      `(
          rust::rust_type
              `($'encoding_rs_Encoding')
              `($'encoding_rs::Encoding')
              "type encoding_rs_Encoding = class end"
      )

  := encoding_utf8' () : rust::ref encoding' =
      !\($'"encoding_rs::UTF_8"')
  """,
  timeout: 300_000
)
