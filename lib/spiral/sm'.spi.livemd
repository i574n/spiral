  ~S"""
  ///- --test --symbol
  ///> rust
  ///> lua
  ///> c
  ///> pascal

  := parts = "a,,c" |> split "," |> array
  := edges = ",a," |> split "," |> array
  := pattern_like = "a%b.c" |> split "%" |> array
  (
      am'::length parts,
      am'::index 0 parts,
      am'::index 1 parts,
      am'::index 2 parts,
      am'::length edges,
      am'::index 1 edges,
      am'::index 1 pattern_like
  )
  |> _assert_eq (3, "a", "", "c", 3, "a", "b.c")
