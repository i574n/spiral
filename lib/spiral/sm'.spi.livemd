<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":"///- --test --symbol\n///> gleam\n///> lua\n///> fsharp\n///> cuda\n///> pascal\n\n\"abcdef\"\n|> slice 1i32 3i32\n|> _assert_eq \"bcd\"\n\n(~~ \"fghij\")\n|> slice 1i32 3i32\n|> _assert_eq \"ghi\"\n\n\"klmno\"\n|> slice 1i32 (~~ 3i32)\n|> _assert_eq \"lmn\"\n\n(~~ \"pqrst\")\n|> slice 1i32 (~~ 3i32)\n|> _assert_eq \"qrs\"\n\n\"uvwxy\"\n|> slice (~~ 1i32) 3i32\n|> _assert_eq \"vwx\"\n\n(~~ \"zabcd\")\n|> slice (~~ 1i32) 3i32\n|> _assert_eq \"abc\"\n\n\"efghi\"\n|> slice (~~ 1i32) (~~ 3i32)\n|> _assert_eq \"fgh\"\n\n(~~ \"efghi\")\n|> slice (~~ 1i32) (~~ 3i32)\n|> _assert_eq \"fgh\"\n\n\"abcdef\"\n|> slice 3i32 4i32\n|> _assert_eq \"de\"\n\n(~~ \"efghi\")\n|> slice (~~ 3i32) (~~ 4i32)\n|> _assert_eq \"hi\"\n\n\"bcde\"\n|> slice (~~ 0i32) 0i32\n|> _assert_eq \"b\"","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  ///- --test --symbol
  ///> gleam
  ///> lua
  ///> fsharp
  ///> cuda
  ///> pascal

  "abcdef"
  |> slice 1i32 3i32
  |> _assert_eq "bcd"

  (~~ "fghij")
  |> slice 1i32 3i32
  |> _assert_eq "ghi"

  "klmno"
  |> slice 1i32 (~~ 3i32)
  |> _assert_eq "lmn"

  (~~ "pqrst")
  |> slice 1i32 (~~ 3i32)
  |> _assert_eq "qrs"

  "uvwxy"
  |> slice (~~ 1i32) 3i32
  |> _assert_eq "vwx"

  (~~ "zabcd")
  |> slice (~~ 1i32) 3i32
  |> _assert_eq "abc"

  "efghi"
  |> slice (~~ 1i32) (~~ 3i32)
  |> _assert_eq "fgh"

  (~~ "efghi")
  |> slice (~~ 1i32) (~~ 3i32)
  |> _assert_eq "fgh"

  "abcdef"
  |> slice 3i32 4i32
  |> _assert_eq "de"

  (~~ "efghi")
  |> slice (~~ 3i32) (~~ 4i32)
  |> _assert_eq "hi"

  "bcde"
  |> slice (~~ 0i32) 0i32
  |> _assert_eq "b"
  """,
  timeout: 300_000
)
