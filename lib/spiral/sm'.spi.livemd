## main

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":"///> fsharp\n\n:= main () =\n    $'let contains x = !contains x' : ()\n    $'let ends_with x = !ends_with x' : ()\n    $'let pad_left x = !pad_left x' : ()\n    $'let pad_right x = !pad_right x' : ()\n    $'let replace x = !replace x' : ()\n    $'let replace_regex x = !replace_regex x' : ()\n    := slice (a : i32) (b : i32) c = slice a b c\n    $'let slice x = !slice x' : ()\n    $'let split x = !split x' : ()\n    $'let split_string x = !split_string x' : ()\n    $'let starts_with x = !starts_with x' : ()\n    $'let substring x = !substring x' : ()\n    $'let to_lower x = !to_lower x' : ()\n    $'let to_upper x = !to_upper x' : ()\n    $'let trim x = !trim x' : ()\n    $'let ellipsis x = !ellipsis x' : ()\n    $'let ellipsis_end x = !ellipsis_end x' : ()\n    $'let format_exception x = !format_exception x' : ()\n    $'let concat_array x = !concat_array x' : ()\n    := concat a (b : seq::seq' string) = concat a b\n    $'let concat x = !concat x' : ()\n    $'let join\\' x = !join' x' : ()\n    $'let to_char_array x = !to_char_array x' : ()","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  ///> fsharp

  := main () =
      $'let contains x = !contains x' : ()
      $'let ends_with x = !ends_with x' : ()
      $'let pad_left x = !pad_left x' : ()
      $'let pad_right x = !pad_right x' : ()
      $'let replace x = !replace x' : ()
      $'let replace_regex x = !replace_regex x' : ()
      := slice (a : i32) (b : i32) c = slice a b c
      $'let slice x = !slice x' : ()
      $'let split x = !split x' : ()
      $'let split_string x = !split_string x' : ()
      $'let starts_with x = !starts_with x' : ()
      $'let substring x = !substring x' : ()
      $'let to_lower x = !to_lower x' : ()
      $'let to_upper x = !to_upper x' : ()
      $'let trim x = !trim x' : ()
      $'let ellipsis x = !ellipsis x' : ()
      $'let ellipsis_end x = !ellipsis_end x' : ()
      $'let format_exception x = !format_exception x' : ()
      $'let concat_array x = !concat_array x' : ()
      := concat a (b : seq::seq' string) = concat a b
      $'let concat x = !concat x' : ()
      $'let join\' x = !join' x' : ()
      $'let to_char_array x = !to_char_array x' : ()
  """,
  timeout: 300_000
)
```

## rust

<!-- livebook:{"break_markdown":true} -->

### to_string std_string

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":":+ to_string std_string = from_std_string\n\n:~ split_list (separator : string) (s : string) : list string =\n    ? length separator = 0i32 ?> [ s ]\n    |: arraym::fold (\\ acc (part : string) => part :: acc) [] (split separator s |> array) |> listm::rev\n\n:= split_joined (separator : string) (s : string) : string = split_list separator s |> concat_list \"|\"","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  :+ to_string std_string = from_std_string

  :~ split_list (separator : string) (s : string) : list string =
      ? length separator = 0i32 ?> [ s ]
      |: arraym::fold (\ acc (part : string) => part :: acc) [] (split separator s |> array) |> listm::rev

  := split_joined (separator : string) (s : string) : string = split_list separator s |> concat_list "|"
  """,
  timeout: 300_000
)
```

