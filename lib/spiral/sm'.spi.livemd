### portable_index_of

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":":= portable_ends_with (value : string) (s : string) : bool =\n    := n : i32 = sm::length s\n    := m : i32 = sm::length value\n    m <= n && portable_matches_at value s (n - m)\n\n:= portable_starts_with (value : string) (s : string) : bool =\n    := n : i32 = sm::length s\n    := m : i32 = sm::length value\n    m <= n && portable_matches_at value s 0\n\n:= portable_index_of (search : string) (s : string) : i32 =\n    := n : i32 = sm::length s\n    := m : i32 = sm::length search\n    :~ ^ scan (at : i32) : i32 =\n        ? at + m > n ?> -1i32\n        |? portable_matches_at search s at ?> at\n        |: scan (at + 1)\n    scan 0\n\n:~ ^ portable_replace_runs (old : string) (new : string) (s : string) (n : i32) (m : i32) (start : i32) (at : i32) (acc : list string) : list string =\n    ? at + m > n ?> (? start < n ?> slice start (n - 1i32) s :: acc |: acc)\n    |? portable_matches_at old s at ?>\n        := run = ? start < at ?> slice start (at - 1i32) s :: acc |: acc\n        portable_replace_runs old new s n m (at + m) (at + m) (new :: run)\n    |: portable_replace_runs old new s n m start (at + 1i32) acc\n\n:= portable_replace (old : string) (new : string) (s : string) : string =\n    := n : i32 = sm::length s\n    := m : i32 = sm::length old\n    ? m = 0i32 ?> s\n    |: portable_replace_runs old new s n m 0i32 0i32 [] |> listm::rev |> concat_list \"\"\n\n:= gleam_split_once_head (search : string) (s : string) : optionm'::option' string =\n    global \"import gleam/pair\"\n    global \"import gleam/result\"\n    global \"import gleam/string\"\n    $'option.from_result(result.map(string.split_once(!s, !search), pair.first))' : optionm'::option' string\n\n:= index_of (search : string) (s : string) : int =\n    backend_switch {\n        Gleam = \\ () =>\n            ? search = \"\" ?> 0\n            |:\n                ?= gleam_split_once_head search s |> optionm'::unbox ?|\n                | Some head => gleam_byte_size head\n                | None => -1\n        Lua = \\ () =>\n            := found = $'string.find(!s, !search, 1, true)' : optionm'::option' int\n            optionm'::default_value' 0 found - 1\n        Fsharp = \\ () => $'(!s).IndexOf(!search, System.StringComparison.Ordinal)' : int\n        Python = \\ () =>\n            := found = $'(!s).find(!search)' : int\n            ? found < 0 ?> -1 |: $'len((!s)[:!found].encode(\"utf-8\", \"surrogateescape\"))' : int\n        Rust = \\ () =>\n            ($'!s.find(&*!search)' : optionm'::option' convert::unativeint)\n            |> optionm'::map \\ i => convert::convert i\n            |> optionm'::unwrap_or -1\n        C = \\ () => conv (portable_index_of search s) : int\n        Pascal = \\ () => conv (portable_index_of search s) : int\n        Kotlin = \\ () => $'(!s).indexOf(!search).let { i -> if (i < 0) -1 else (!s).substring(0, i).toByteArray(Charsets.UTF_8).size }' : int\n        TypeScript = \\ () => $'!s.indexOf(!search)' : int\n        Zig = \\ () => $'(if (std.mem.indexOf(u8, !s, !search)) |i| @@as(`int, @@intCast(i)) else -1)' : int\n        Lean = \\ () =>\n            ? search = \"\" ?> 0\n            |:\n                := pieces = $'`int.ofNat ((!s).splitOn !search).length' : int\n                := head = $'((!s).splitOn !search).headD \"\"' : string\n                ? pieces <= 1 ?> -1 |: $'`int.ofNat (!head).utf8ByteSize' : int\n    }","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  := portable_ends_with (value : string) (s : string) : bool =
      := n : i32 = sm::length s
      := m : i32 = sm::length value
      m <= n && portable_matches_at value s (n - m)

  := portable_starts_with (value : string) (s : string) : bool =
      := n : i32 = sm::length s
      := m : i32 = sm::length value
      m <= n && portable_matches_at value s 0

  := portable_index_of (search : string) (s : string) : i32 =
      := n : i32 = sm::length s
      := m : i32 = sm::length search
      :~ ^ scan (at : i32) : i32 =
          ? at + m > n ?> -1i32
          |? portable_matches_at search s at ?> at
          |: scan (at + 1)
      scan 0

  :~ ^ portable_replace_runs (old : string) (new : string) (s : string) (n : i32) (m : i32) (start : i32) (at : i32) (acc : list string) : list string =
      ? at + m > n ?> (? start < n ?> slice start (n - 1i32) s :: acc |: acc)
      |? portable_matches_at old s at ?>
          := run = ? start < at ?> slice start (at - 1i32) s :: acc |: acc
          portable_replace_runs old new s n m (at + m) (at + m) (new :: run)
      |: portable_replace_runs old new s n m start (at + 1i32) acc

  := portable_replace (old : string) (new : string) (s : string) : string =
      := n : i32 = sm::length s
      := m : i32 = sm::length old
      ? m = 0i32 ?> s
      |: portable_replace_runs old new s n m 0i32 0i32 [] |> listm::rev |> concat_list ""

  := gleam_split_once_head (search : string) (s : string) : optionm'::option' string =
      global "import gleam/pair"
      global "import gleam/result"
      global "import gleam/string"
      $'option.from_result(result.map(string.split_once(!s, !search), pair.first))' : optionm'::option' string

  := index_of (search : string) (s : string) : int =
      backend_switch {
          Gleam = \ () =>
              ? search = "" ?> 0
              |:
                  ?= gleam_split_once_head search s |> optionm'::unbox ?|
                  | Some head => gleam_byte_size head
                  | None => -1
          Lua = \ () =>
              := found = $'string.find(!s, !search, 1, true)' : optionm'::option' int
              optionm'::default_value' 0 found - 1
          Fsharp = \ () => $'(!s).IndexOf(!search, System.StringComparison.Ordinal)' : int
          Python = \ () =>
              := found = $'(!s).find(!search)' : int
              ? found < 0 ?> -1 |: $'len((!s)[:!found].encode("utf-8", "surrogateescape"))' : int
          Rust = \ () =>
              ($'!s.find(&*!search)' : optionm'::option' convert::unativeint)
              |> optionm'::map \ i => convert::convert i
              |> optionm'::unwrap_or -1
          C = \ () => conv (portable_index_of search s) : int
          Pascal = \ () => conv (portable_index_of search s) : int
          Kotlin = \ () => $'(!s).indexOf(!search).let { i -> if (i < 0) -1 else (!s).substring(0, i).toByteArray(Charsets.UTF_8).size }' : int
          TypeScript = \ () => $'!s.indexOf(!search)' : int
          Zig = \ () => $'(if (std.mem.indexOf(u8, !s, !search)) |i| @@as(`int, @@intCast(i)) else -1)' : int
          Lean = \ () =>
              ? search = "" ?> 0
              |:
                  := pieces = $'`int.ofNat ((!s).splitOn !search).length' : int
                  := head = $'((!s).splitOn !search).headD ""' : string
                  ? pieces <= 1 ?> -1 |: $'`int.ofNat (!head).utf8ByteSize' : int
      }
  """,
  timeout: 300_000
)
```

