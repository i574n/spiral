### format_pretty_real

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":"///- --real\n\n:= format_pretty_real \\* t. (x : t) : string =\n    run_target_args `string `t (\\ () => x) \\|\n        | Rust => \\ x =>\n            := ^ structural \\* u. () : bool =\n                ?: u ?|\n                | optionm'::option' ~a =>\n                    ? real_core::prim_type_is `a\n                    ?> !-\n                    |: !+\n                | listm'::list' ~a =>\n                    ? real_core::prim_type_is `a\n                    ?> !-\n                    |: !+\n                | seq::seq' ~a =>\n                    ? real_core::prim_type_is `a\n                    ?> !-\n                    |: !+\n                | array_base ~a =>\n                    ? real_core::prim_type_is `a\n                    ?> !-\n                    |: !+\n                | ~a * ~b =>\n                    ? structural `a ()\n                    ?> !+\n                    |: structural `b ()\n                | {} =>\n                    real_core::record_type_fold\n                        \\ acc key => \\* v. => ? acc ?> !+ |: structural `v ()\n                        !-\n                        `u\n                | _ => real_core::union_type_is `u\n            ? structural `t ()\n            ?> format_debug_real `t x\n            |:\n                := result = rust::emit_expr `t `std_string_real x ($'\"format\\!(\\\\\\\"{:##?}\\\\\\\", $0)\"' : string)\n                from_std_string_real result\n        | _ => \\ _ => format_debug_real `t x","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  ///- --real

  := format_pretty_real \* t. (x : t) : string =
      run_target_args `string `t (\ () => x) \|
          | Rust => \ x =>
              := ^ structural \* u. () : bool =
                  ?: u ?|
                  | optionm'::option' ~a =>
                      ? real_core::prim_type_is `a
                      ?> !-
                      |: !+
                  | listm'::list' ~a =>
                      ? real_core::prim_type_is `a
                      ?> !-
                      |: !+
                  | seq::seq' ~a =>
                      ? real_core::prim_type_is `a
                      ?> !-
                      |: !+
                  | array_base ~a =>
                      ? real_core::prim_type_is `a
                      ?> !-
                      |: !+
                  | ~a * ~b =>
                      ? structural `a ()
                      ?> !+
                      |: structural `b ()
                  | {} =>
                      real_core::record_type_fold
                          \ acc key => \* v. => ? acc ?> !+ |: structural `v ()
                          !-
                          `u
                  | _ => real_core::union_type_is `u
              ? structural `t ()
              ?> format_debug_real `t x
              |:
                  := result = rust::emit_expr `t `std_string_real x ($'"format\!(\\\"{:##?}\\\", $0)"' : string)
                  from_std_string_real result
          | _ => \ _ => format_debug_real `t x
  """,
  timeout: 300_000
)
```

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":":= format_pretty \\* t. (x : t) : string =\n    ~> format_pretty_real `t x\n\n:= prim x = ~>\n    ?= x ?|\n    | (x : i8) | (x : i16) | (x : i32) | (x : i64) => \"%d\", x\n    | (x : u8) | (x : u16) | (x : u32) | (x : u64) => \"%u\", x\n    | (x : f32) | (x : f64) => \"%f\", x\n    | (x : string) => \"%s\", x\n    | (x : char) => \"%c\", x","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  := format_pretty \* t. (x : t) : string =
      ~> format_pretty_real `t x

  := prim x = ~>
      ?= x ?|
      | (x : i8) | (x : i16) | (x : i32) | (x : i64) => "%d", x
      | (x : u8) | (x : u16) | (x : u32) | (x : u64) => "%u", x
      | (x : f32) | (x : f64) => "%f", x
      | (x : string) => "%s", x
      | (x : char) => "%c", x
  """,
  timeout: 300_000
)
```

