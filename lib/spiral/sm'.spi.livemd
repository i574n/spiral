#### decimal_text_and_char_text_render_numbers_and_control_characters (test)

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":"///- --test --symbol\n///> rust\n\n42i32 |> decimal_text |> _assert_eq \"42\"\n18446744073709551615u64 |> decimal_text |> _assert_eq \"18446744073709551615\"\n31u8 |> char_text |> length |> _assert_eq 1i32\n65u8 |> char_text |> _assert_eq \"A\"","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  ///- --test --symbol
  ///> rust

  42i32 |> decimal_text |> _assert_eq "42"
  18446744073709551615u64 |> decimal_text |> _assert_eq "18446744073709551615"
  31u8 |> char_text |> length |> _assert_eq 1i32
  65u8 |> char_text |> _assert_eq "A"
  """,
  timeout: 300_000
)
```

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":":= first_line (text : string) : string =\n    run_target \\|\n        | Rust => \\ () => $'std::rc::Rc::<str>::from((!text).split(char::from(10u8)).next().unwrap_or(\"\"))' : string\n        | Fsharp => \\ () =>\n            := at = $'(!text).IndexOf(char 10)' : i32\n            ? at < 0i32 ?> text |: $'(!text).Substring(0, !at)' : string\n        | _ => \\ () =>\n            := at = index_of \"\\n\" text\n            ? at < 0 ?> text |: text |> slice 0 (at - 1)\n\n:= after_first_line (text : string) : string =\n    run_target \\|\n        | Rust => \\ () =>\n            $'std::rc::Rc::<str>::from((!text).split_once(char::from(10u8)).map(|(_, rest)| rest).unwrap_or(\"\"))' : string\n        | Fsharp => \\ () =>\n            := at = $'(!text).IndexOf(char 10)' : i32\n            := rest = at + 1i32\n            ? at < 0i32 ?> \"\" |: $'(!text).Substring(!rest)' : string\n        | _ => \\ () =>\n            := at = index_of \"\\n\" text\n            ? at < 0 ?> \"\" |: text |> slice (at + 1) (length text - 1)","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  := first_line (text : string) : string =
      run_target \|
          | Rust => \ () => $'std::rc::Rc::<str>::from((!text).split(char::from(10u8)).next().unwrap_or(""))' : string
          | Fsharp => \ () =>
              := at = $'(!text).IndexOf(char 10)' : i32
              ? at < 0i32 ?> text |: $'(!text).Substring(0, !at)' : string
          | _ => \ () =>
              := at = index_of "\n" text
              ? at < 0 ?> text |: text |> slice 0 (at - 1)

  := after_first_line (text : string) : string =
      run_target \|
          | Rust => \ () =>
              $'std::rc::Rc::<str>::from((!text).split_once(char::from(10u8)).map(|(_, rest)| rest).unwrap_or(""))' : string
          | Fsharp => \ () =>
              := at = $'(!text).IndexOf(char 10)' : i32
              := rest = at + 1i32
              ? at < 0i32 ?> "" |: $'(!text).Substring(!rest)' : string
          | _ => \ () =>
              := at = index_of "\n" text
              ? at < 0 ?> "" |: text |> slice (at + 1) (length text - 1)
  """,
  timeout: 300_000
)
```

#### first_line_and_after_first_line_split_at_the_first_newline (test)

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":"///- --test --symbol\n///> fsharp\n///> rust\n\n\"é1\\nb\\nc\" |> first_line |> _assert_eq \"é1\"\n\"é1\\nb\\nc\" |> after_first_line |> _assert_eq \"b\\nc\"\n\"only\" |> first_line |> _assert_eq \"only\"\n\"only\" |> after_first_line |> _assert_eq \"\"\n\"end\\n\" |> after_first_line |> _assert_eq \"\"\n\"\\nx\" |> first_line |> _assert_eq \"\"","print_code":false},"livebook_object":"smart_cell"} -->

