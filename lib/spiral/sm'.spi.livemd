### encoding_encode

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":":= encoding_encode' (encoding : rust::ref encoding') (text : string) : rust::cow (am'::slice u8) =\n    !\\\\((encoding, text), $'\"$0.encode(&*$1).0\"')\n\n:! windows t =\n    `(\n        rust::rust_type\n            `($'std_slice_Windows<`t>')\n            `($'std::slice::Windows<`t>')\n            \"type std_slice_Windows<'T> = class end\"\n    )\n\n:= windows (len : convert::unativeint) (source : am'::vec u8) : windows u8 =\n    := source = source |> rust::new_box |> rust::box_leak\n    := result = !\\\\(len, $'\"<[_]>::windows(!source, $0)\"')\n    result\n\n:= any \\* t. (fn : string -> bool) (source : windows t) : bool =\n    (!\\($'\"true; let mut !source = !source\"') : bool) |> ignore\n    := fn' x =\n        x\n        |> str_from_utf8\n        |> resultm::unwrap_or' #\"\"\n        |> ref_to_std_string\n        |> from_std_string\n        |> fn\n    !\\\\(fn', $'\"!source.any(move |x| $0(x))\"')\n\n:= slice_contains (text : string) (source : am'::vec u8) : bool =\n    \\ () =>\n        := source = ~~ source\n        source\n        |> windows (text |> length |> (\\ x => x : i32) |> convert::convert)\n        |> any ((=.) text)\n    |> \\ x => ~~ x ()\n\n:= as_bytes (text : string) : rust::ref (am'::slice u8) =\n    := text = ~~ text\n    !\\($'\"!text.as_bytes()\"')\n\n:= into_bytes (x : std_string) : am'::vec u8 =\n    backend_switch {\n        Rust = \\ () => $'(!x).as_bytes().to_vec()' : am'::vec u8\n    }","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  := encoding_encode' (encoding : rust::ref encoding') (text : string) : rust::cow (am'::slice u8) =
      !\\((encoding, text), $'"$0.encode(&*$1).0"')

  :! windows t =
      `(
          rust::rust_type
              `($'std_slice_Windows<`t>')
              `($'std::slice::Windows<`t>')
              "type std_slice_Windows<'T> = class end"
      )

  := windows (len : convert::unativeint) (source : am'::vec u8) : windows u8 =
      := source = source |> rust::new_box |> rust::box_leak
      := result = !\\(len, $'"<[_]>::windows(!source, $0)"')
      result

  := any \* t. (fn : string -> bool) (source : windows t) : bool =
      (!\($'"true; let mut !source = !source"') : bool) |> ignore
      := fn' x =
          x
          |> str_from_utf8
          |> resultm::unwrap_or' #""
          |> ref_to_std_string
          |> from_std_string
          |> fn
      !\\(fn', $'"!source.any(move |x| $0(x))"')

  := slice_contains (text : string) (source : am'::vec u8) : bool =
      \ () =>
          := source = ~~ source
          source
          |> windows (text |> length |> (\ x => x : i32) |> convert::convert)
          |> any ((=.) text)
      |> \ x => ~~ x ()

  := as_bytes (text : string) : rust::ref (am'::slice u8) =
      := text = ~~ text
      !\($'"!text.as_bytes()"')

  := into_bytes (x : std_string) : am'::vec u8 =
      backend_switch {
          Rust = \ () => $'(!x).as_bytes().to_vec()' : am'::vec u8
      }
  """,
  timeout: 300_000
)
```

