<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":":! display t =\n    `(\n        rust::rust_type\n            `($'std_fmt_Display<`t>')\n            `($'std::fmt::Display<`t>')\n            \"type std_fmt_Display<'T> = class end\"\n    )\n\n:! base64_decode_error =\n    `(\n        rust::rust_type\n            `($'base64_DecodeError')\n            `($'base64::DecodeError')\n            \"type base64_DecodeError = class end\"\n    )\n\n:! borsh_io_error =\n    `(\n        rust::rust_type\n            `($'borsh_io_Error')\n            `($'borsh::io::Error')\n            \"type borsh_io_Error = class end\"\n    )\n\n:! utf8_error =\n    `(\n        rust::rust_type\n            `($'std_str_Utf8Error')\n            `($'std::str::Utf8Error')\n            \"type std_str_Utf8Error = class end\"\n    )\n\n:! from_utf8_error =\n    `(\n        rust::rust_type\n            `($'std_string_FromUtf8Error')\n            `($'std::string::FromUtf8Error')\n            \"type std_string_FromUtf8Error = class end\"\n    )\n\n:! json_value =\n    `(\n        rust::rust_type\n            `($'serde_json_Value')\n            `($'serde_json::Value')\n            \"type serde_json_Value = class end\"\n    )\n\n:! json_error =\n    `(\n        rust::rust_type\n            `($'serde_json_Error')\n            `($'serde_json::Error')\n            \"type serde_json_Error = class end\"\n    )\n\n:! serde_wasm_bindgen_error =\n    `(\n        rust::rust_type\n            `($'serde_wasm_bindgen_Error')\n            `($'serde_wasm_bindgen::Error')\n            \"type serde_wasm_bindgen_Error = class end\"\n    )\n\n:! js_string =\n    `(\n        rust::rust_type\n            `($'js_sys_JsString')\n            `($'js_sys::JsString')\n            \"type js_sys_JsString = class end\"\n    )\n\n:! os_str =\n    `(\n        rust::rust_type\n            `($'std_ffi_OsStr')\n            `($'std::ffi::OsStr')\n            \"type std_ffi_OsStr = class end\"\n    )\n\n:! c_str =\n    `(\n        rust::rust_type\n            `($'std_ffi_CStr')\n            `($'std::ffi::CStr')\n            \"type std_ffi_CStr = class end\"\n    )\n\n:! c_string =\n    `(\n        rust::rust_type\n            `($'std_ffi_CString')\n            `($'std::ffi::CString')\n            \"type std_ffi_CString = class end\"\n    )\n\n:! os_string =\n    `(\n        rust::rust_type\n            `($'std_ffi_OsString')\n            `($'std::ffi::OsString')\n            \"type std_ffi_OsString = class end\"\n    )\n\n:= raw_string_literal (s : string) : rust::ref str =\n    backend_switch {\n        Fsharp = \\ () => !\\($'\"r##\\\\\"\" + !s + \"\\\\\"##\"') : rust::ref str\n        Rust = \\ () => $'(&*!s)' : rust::ref str\n    }\n\n:= raw_string_literal_static (s : string) : rust::static_ref str =\n    backend_switch {\n        Fsharp = \\ () => !\\($'\"r##\\\\\"\" + !s + \"\\\\\"##\"') : rust::static_ref str\n        Rust = \\ () => $'Box::leak(String::from(&*!s).into_boxed_str())' : rust::static_ref str\n    }\n\n:= (~#) s =\n    s |> raw_string_literal\n\n:= (~###) s =\n    s |> raw_string_literal_static\n\n:= include_str (path : string) : rust::ref str =\n    !\\($'\"include_str\\!(\\\\\\\"\" + !path + \"\\\\\\\")\"')\n\n:= as_str (s : string) : rust::ref str =\n    run_target_args (\\ () => s) \\|\n        | Rust => \\ s => !\\\\(s, $'\"&*$0\"')\n        | _ => convert::unbox\n\n:= from_iter \\* (t : * -> *). (s : t char) : std_string =\n    !\\\\(s, $'\"String::from_iter($0)\"')\n\n:= ref_to_std_string (str : rust::ref str) : std_string =\n    run_target_args (\\ () => str) \\|\n        | Rust => \\ str => !\\\\(str, $'\"String::from($0)\"')\n        | _ => convert::unbox\n\n:= cow_to_std_string (str : rust::cow str) : std_string =\n    !\\\\(str, $'\"String::from($0)\"')\n\n:= to_std_string (s : string) : std_string =\n    s |> as_str |> ref_to_std_string\n\n:= as_str_std (s : std_string) : rust::ref str =\n    !\\\\(s, $'\"$0.as_str()\"')\n\n:= into_boxed_str (s : std_string) : rust::box str =\n    !\\\\(s, $'\"$0.into_boxed_str()\"')\n\n:= to_os_string (s : rust::ref os_str) : os_string =\n    !\\\\(s, $'\"$0.to_os_string()\"')\n\n:= new_c_string (s : std_string) : c_string =\n    !\\\\(s, $'\"std::ffi::CString::new($0).unwrap()\"')\n\n:= os_to_str (s : os_string) : optionm'::option' (rust::ref str) =\n    !\\\\(s, $'\"$0.to_str()\"')\n\n:= from_os_str_ref s =\n    s\n    |> to_os_string\n    |> os_to_str\n    |> optionm'::unwrap\n    |> ref_to_std_string\n    |> from_std_string\n\n:= format_custom' (f : string) x : std_string =\n    run_target \\|\n        | Rust => \\ () =>\n            !\\\\(x, $'\"format\\!(\\\\\\\"\" + !f + \"\\\\\\\", $0)\"')\n        | _ => \\ () => null ()\n\n:= format_debug' x : std_string =\n    run_target \\|\n        | Rust => \\ () =>\n            !\\\\(x, $'\"format\\!(\\\\\\\"{:?}\\\\\\\", $0)\"')\n        | _ => \\ () => null ()\n\n:= format' x : std_string =\n    run_target_args (\\ () => x) \\|\n        | Rust => \\ x =>\n            !\\\\(x, $'\"format\\!(\\\\\\\"{}\\\\\\\", $0)\"')\n        | _ => \\ _ => null ()\n\n:= format_hex' x : std_string =\n    !\\\\(x, $'\"format\\!(\\\\\\\"{:02x}\\\\\\\", $0)\"')\n\n:= format'' (format : string) : std_string =\n    !\\($'@@$\"format\\!(\" + !format + \")\"')\n\n:! regex =\n    `(\n        rust::rust_type\n            `($'regex_Regex')\n            `($'regex::Regex')\n            \"type regex_Regex = class end\"\n    )\n\n:! regex_error =\n    `(\n        rust::rust_type\n            `($'regex_Error')\n            `($'regex::Error')\n            \"type regex_Error = class end\"\n    )\n\n:= new_regex (pattern : string) : resultm::result' regex regex_error =\n    !\\\\(pattern, $'$\"regex::Regex::new(&$0)\"')","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  :! display t =
      `(
          rust::rust_type
              `($'std_fmt_Display<`t>')
              `($'std::fmt::Display<`t>')
              "type std_fmt_Display<'T> = class end"
      )

  :! base64_decode_error =
      `(
          rust::rust_type
              `($'base64_DecodeError')
              `($'base64::DecodeError')
              "type base64_DecodeError = class end"
      )

  :! borsh_io_error =
      `(
          rust::rust_type
              `($'borsh_io_Error')
              `($'borsh::io::Error')
              "type borsh_io_Error = class end"
      )

  :! utf8_error =
      `(
          rust::rust_type
              `($'std_str_Utf8Error')
              `($'std::str::Utf8Error')
              "type std_str_Utf8Error = class end"
      )

  :! from_utf8_error =
      `(
          rust::rust_type
              `($'std_string_FromUtf8Error')
              `($'std::string::FromUtf8Error')
              "type std_string_FromUtf8Error = class end"
      )

  :! json_value =
      `(
          rust::rust_type
              `($'serde_json_Value')
              `($'serde_json::Value')
              "type serde_json_Value = class end"
      )

  :! json_error =
      `(
          rust::rust_type
              `($'serde_json_Error')
              `($'serde_json::Error')
              "type serde_json_Error = class end"
      )

  :! serde_wasm_bindgen_error =
      `(
          rust::rust_type
              `($'serde_wasm_bindgen_Error')
              `($'serde_wasm_bindgen::Error')
              "type serde_wasm_bindgen_Error = class end"
      )

  :! js_string =
      `(
          rust::rust_type
              `($'js_sys_JsString')
              `($'js_sys::JsString')
              "type js_sys_JsString = class end"
      )

  :! os_str =
      `(
          rust::rust_type
              `($'std_ffi_OsStr')
              `($'std::ffi::OsStr')
              "type std_ffi_OsStr = class end"
      )

  :! c_str =
      `(
          rust::rust_type
              `($'std_ffi_CStr')
              `($'std::ffi::CStr')
              "type std_ffi_CStr = class end"
      )

  :! c_string =
      `(
          rust::rust_type
              `($'std_ffi_CString')
              `($'std::ffi::CString')
              "type std_ffi_CString = class end"
      )

  :! os_string =
      `(
          rust::rust_type
              `($'std_ffi_OsString')
              `($'std::ffi::OsString')
              "type std_ffi_OsString = class end"
      )

  := raw_string_literal (s : string) : rust::ref str =
      backend_switch {
          Fsharp = \ () => !\($'"r##\\"" + !s + "\\"##"') : rust::ref str
          Rust = \ () => $'(&*!s)' : rust::ref str
      }

  := raw_string_literal_static (s : string) : rust::static_ref str =
      backend_switch {
          Fsharp = \ () => !\($'"r##\\"" + !s + "\\"##"') : rust::static_ref str
          Rust = \ () => $'Box::leak(String::from(&*!s).into_boxed_str())' : rust::static_ref str
      }

  := (~#) s =
      s |> raw_string_literal

  := (~###) s =
      s |> raw_string_literal_static

  := include_str (path : string) : rust::ref str =
      !\($'"include_str\!(\\\"" + !path + "\\\")"')

  := as_str (s : string) : rust::ref str =
      run_target_args (\ () => s) \|
          | Rust => \ s => !\\(s, $'"&*$0"')
          | _ => convert::unbox

  := from_iter \* (t : * -> *). (s : t char) : std_string =
      !\\(s, $'"String::from_iter($0)"')

  := ref_to_std_string (str : rust::ref str) : std_string =
      run_target_args (\ () => str) \|
          | Rust => \ str => !\\(str, $'"String::from($0)"')
          | _ => convert::unbox

  := cow_to_std_string (str : rust::cow str) : std_string =
      !\\(str, $'"String::from($0)"')

  := to_std_string (s : string) : std_string =
      s |> as_str |> ref_to_std_string

  := as_str_std (s : std_string) : rust::ref str =
      !\\(s, $'"$0.as_str()"')

  := into_boxed_str (s : std_string) : rust::box str =
      !\\(s, $'"$0.into_boxed_str()"')

  := to_os_string (s : rust::ref os_str) : os_string =
      !\\(s, $'"$0.to_os_string()"')

  := new_c_string (s : std_string) : c_string =
      !\\(s, $'"std::ffi::CString::new($0).unwrap()"')

  := os_to_str (s : os_string) : optionm'::option' (rust::ref str) =
      !\\(s, $'"$0.to_str()"')

  := from_os_str_ref s =
      s
      |> to_os_string
      |> os_to_str
      |> optionm'::unwrap
      |> ref_to_std_string
      |> from_std_string

  := format_custom' (f : string) x : std_string =
      run_target \|
          | Rust => \ () =>
              !\\(x, $'"format\!(\\\"" + !f + "\\\", $0)"')
          | _ => \ () => null ()

  := format_debug' x : std_string =
      run_target \|
          | Rust => \ () =>
              !\\(x, $'"format\!(\\\"{:?}\\\", $0)"')
          | _ => \ () => null ()

  := format' x : std_string =
      run_target_args (\ () => x) \|
          | Rust => \ x =>
              !\\(x, $'"format\!(\\\"{}\\\", $0)"')
          | _ => \ _ => null ()

  := format_hex' x : std_string =
      !\\(x, $'"format\!(\\\"{:02x}\\\", $0)"')

  := format'' (format : string) : std_string =
      !\($'@@$"format\!(" + !format + ")"')

  :! regex =
      `(
          rust::rust_type
              `($'regex_Regex')
              `($'regex::Regex')
              "type regex_Regex = class end"
      )

  :! regex_error =
      `(
          rust::rust_type
              `($'regex_Error')
              `($'regex::Error')
              "type regex_Error = class end"
      )

  := new_regex (pattern : string) : resultm::result' regex regex_error =
      !\\(pattern, $'$"regex::Regex::new(&$0)"')
  """,
  timeout: 300_000
)
```

### captures

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":":! regex_captures t =\n    `(\n        rust::rust_type\n            `($'regex_Captures<`t>')\n            `($'regex::Captures<`t>')\n            \"type regex_Captures<'T> = class end\"\n    )\n\n:! regex_capture_matches =\n    `(\n        rust::rust_type\n            `($'regex_CaptureMatches')\n            `($'regex::CaptureMatches')\n            \"type regex_CaptureMatches = class end\"\n    )\n\n:! regex_capture_names =\n    `(\n        rust::rust_type\n            `($'regex_CaptureNames')\n            `($'regex::CaptureNames')\n            \"type regex_CaptureNames = class end\"\n    )\n\n:= regex_capture_names (regex : regex) : regex_capture_names =\n    !\\\\(regex, $'$\"$0.capture_names()\"')\n\n:! match' =\n    `(\n        rust::rust_type\n            `($'regex_Match')\n            `($'regex::Match')\n            \"type regex_Match = class end\"\n    )\n\n:= regex_captures_iter (s : rust::static_ref (rust::mut' std_string)) (regex : regex) : regex_capture_matches =\n    := regex = regex |> rust::emit\n    !\\\\(regex, $'$\"$0.captures_iter(!s)\"')\n\n:~ regex_captures (s : string) (regex : regex) : am'::vec (map::hash_map string string) =\n\n    := s = s |> to_std_string\n    \\ () =>\n        := matches =\n            := s = s |> rust::new_box |> rust::box_leak\n            regex |> regex_captures_iter s\n\n        (!\\($'\"true; let _regex_captures : Vec<_> = !matches.map(|x| { //\"') : bool) |> ignore\n\n        := fn\n            (match' : rust::static_ref (rust::mut' (regex_captures rust::static_lifetime)))\n            : map::hash_map string string\n            =\n\n            := names = regex |> regex_capture_names\n\n            (!\\($'\"true; let _regex_captures : std::collections::HashMap<_, _> = !names.map(|x| { //\"') : bool)\n            |> ignore\n\n            := fn (n : string) : pair string string =\n                := n' = n |> rust::clone\n\n                new_pair n' !\\\\(n, $'$\"!match'.name(&$0).map(|x| x.as_str()).unwrap_or(\\\\\\\"\\\\\\\").to_string().into()\"')\n\n            (!\\\\(fn !\\($'\"x.unwrap_or(\\\\\\\"\\\\\\\").to_string().into()\"'), $'\"true; $0 }).collect()\"') : bool) |> ignore\n\n            !\\($'\"_regex_captures\"')\n\n        := x =\n            !\\($'$\"x\"')\n            |> rust::new_box\n            |> rust::box_leak\n\n        (!\\\\(fn x, $'\"true; $0 }).collect::<Vec<_>>()\"') : bool) |> ignore\n\n        !\\($'\"_regex_captures\"')\n\n    |> rust::capture_move","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  :! regex_captures t =
      `(
          rust::rust_type
              `($'regex_Captures<`t>')
              `($'regex::Captures<`t>')
              "type regex_Captures<'T> = class end"
      )

  :! regex_capture_matches =
      `(
          rust::rust_type
              `($'regex_CaptureMatches')
              `($'regex::CaptureMatches')
              "type regex_CaptureMatches = class end"
      )

  :! regex_capture_names =
      `(
          rust::rust_type
              `($'regex_CaptureNames')
              `($'regex::CaptureNames')
              "type regex_CaptureNames = class end"
      )

  := regex_capture_names (regex : regex) : regex_capture_names =
      !\\(regex, $'$"$0.capture_names()"')

  :! match' =
      `(
          rust::rust_type
              `($'regex_Match')
              `($'regex::Match')
              "type regex_Match = class end"
      )

  := regex_captures_iter (s : rust::static_ref (rust::mut' std_string)) (regex : regex) : regex_capture_matches =
      := regex = regex |> rust::emit
      !\\(regex, $'$"$0.captures_iter(!s)"')

  :~ regex_captures (s : string) (regex : regex) : am'::vec (map::hash_map string string) =

      := s = s |> to_std_string
      \ () =>
          := matches =
              := s = s |> rust::new_box |> rust::box_leak
              regex |> regex_captures_iter s

          (!\($'"true; let _regex_captures : Vec<_> = !matches.map(|x| { //"') : bool) |> ignore

          := fn
              (match' : rust::static_ref (rust::mut' (regex_captures rust::static_lifetime)))
              : map::hash_map string string
              =

              := names = regex |> regex_capture_names

              (!\($'"true; let _regex_captures : std::collections::HashMap<_, _> = !names.map(|x| { //"') : bool)
              |> ignore

              := fn (n : string) : pair string string =
                  := n' = n |> rust::clone

                  new_pair n' !\\(n, $'$"!match'.name(&$0).map(|x| x.as_str()).unwrap_or(\\\"\\\").to_string().into()"')

              (!\\(fn !\($'"x.unwrap_or(\\\"\\\").to_string().into()"'), $'"true; $0 }).collect()"') : bool) |> ignore

              !\($'"_regex_captures"')

          := x =
              !\($'$"x"')
              |> rust::new_box
              |> rust::box_leak

          (!\\(fn x, $'"true; $0 }).collect::<Vec<_>>()"') : bool) |> ignore

          !\($'"_regex_captures"')

      |> rust::capture_move
  """,
  timeout: 300_000
)
```

