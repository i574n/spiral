## sm'

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":":= contains (value : string) (s : string) : bool =\n    backend_switch {\n        Gleam = \\ () =>\n            global \"import gleam/string\"\n            $'!s |> string.contains(!value)' : bool\n        Lua = \\ () => $'string.find(!s, !value, 1, true) ~= nil ' : bool\n        Fsharp = \\ () => $'!s.Contains !value ' : bool\n        Python = \\ () => $'!value in !s ' : bool\n        Rust = \\ () => $'!s.contains(&*!value)' : bool\n        TypeScript = \\ () => $'!s.includes(!value)' : bool\n        Zig = \\ () => $'(std.mem.indexOf(u8, !s, !value) \\!= null)' : bool\n        C = \\ () => portable_index_of value s >= 0i32\n        Pascal = \\ () => portable_index_of value s >= 0i32\n        Kotlin = \\ () => $'(!s).contains(!value)' : bool\n        Lean = \\ () => $'(!s).contains !value ' : bool\n    }","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  := contains (value : string) (s : string) : bool =
      backend_switch {
          Gleam = \ () =>
              global "import gleam/string"
              $'!s |> string.contains(!value)' : bool
          Lua = \ () => $'string.find(!s, !value, 1, true) ~= nil ' : bool
          Fsharp = \ () => $'!s.Contains !value ' : bool
          Python = \ () => $'!value in !s ' : bool
          Rust = \ () => $'!s.contains(&*!value)' : bool
          TypeScript = \ () => $'!s.includes(!value)' : bool
          Zig = \ () => $'(std.mem.indexOf(u8, !s, !value) \!= null)' : bool
          C = \ () => portable_index_of value s >= 0i32
          Pascal = \ () => portable_index_of value s >= 0i32
          Kotlin = \ () => $'(!s).contains(!value)' : bool
          Lean = \ () => $'(!s).contains !value ' : bool
      }
  """,
  timeout: 300_000
)
```

#### searches_agree_on_c (test)

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":"///- --test --symbol\n///> c\n///> gleam\n///> rust\n///> pascal\n///> zig\n\n(\n    \"a.b%c\" |> index_of \".\",\n    \"a.b%c\" |> index_of \"%\",\n    \"a.b%c\" |> index_of \"y\",\n    \"a.b%c\" |> index_of \"\",\n    \"a.b%c\" |> index_of \"b%c\"\n)\n|> _assert_eq (1, 3, -1, 0, 2)\n(\n    \"a.b%c\" |> contains \"%c\",\n    \"a.b%c\" |> contains \"x\",\n    \"a.b%c\" |> starts_with \"a.\",\n    \"a.b%c\" |> starts_with \"b\",\n    \"a.b%c\" |> ends_with \"%c\",\n    \"a.b%c\" |> ends_with \"a\",\n    \"\" |> ends_with \"\"\n)\n|> _assert_eq (!+, !-, !+, !-, !+, !-, !+)","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  ///- --test --symbol
  ///> c
  ///> gleam
  ///> rust
  ///> pascal
  ///> zig

  (
      "a.b%c" |> index_of ".",
      "a.b%c" |> index_of "%",
      "a.b%c" |> index_of "y",
      "a.b%c" |> index_of "",
      "a.b%c" |> index_of "b%c"
  )
  |> _assert_eq (1, 3, -1, 0, 2)
  (
      "a.b%c" |> contains "%c",
      "a.b%c" |> contains "x",
      "a.b%c" |> starts_with "a.",
      "a.b%c" |> starts_with "b",
      "a.b%c" |> ends_with "%c",
      "a.b%c" |> ends_with "a",
      "" |> ends_with ""
  )
  |> _assert_eq (!+, !-, !+, !-, !+, !-, !+)
  """,
  timeout: 300_000
)
```

### to_string result t u

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":":+ to_string result t u = \\ x =>\n    ~>\n        ?: (t * u) ?|\n        | string * string =>\n            ?= x ?|\n            | Ok x => x\n            | Error x => \"sm'.to_string result / Error: \" ++# x\n        | std_string * std_string =>\n            ?= x ?|\n            | Ok x => from_std_string x\n            | Error x => \"sm'.to_string result / Error: \" ++# from_std_string x\n        | _ => obj_to_string `u x\n\n:= format_exception (ex : exn) : string =\n    run_target \\|\n        | Zig => \\ () =>\n            $'!ex ' : string\n        | Fsharp => \\ () => $'$\"{!ex.GetType ()}: {!ex.Message}\"'\n        | Rust => \\ () => $'!ex ' : string\n        | TypeScript => \\ () => $'String(!ex)' : string\n        | _ => \\ () => ex |> format_debug","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  :+ to_string result t u = \ x =>
      ~>
          ?: (t * u) ?|
          | string * string =>
              ?= x ?|
              | Ok x => x
              | Error x => "sm'.to_string result / Error: " ++# x
          | std_string * std_string =>
              ?= x ?|
              | Ok x => from_std_string x
              | Error x => "sm'.to_string result / Error: " ++# from_std_string x
          | _ => obj_to_string `u x

  := format_exception (ex : exn) : string =
      run_target \|
          | Zig => \ () =>
              $'!ex ' : string
          | Fsharp => \ () => $'$"{!ex.GetType ()}: {!ex.Message}"'
          | Rust => \ () => $'!ex ' : string
          | TypeScript => \ () => $'String(!ex)' : string
          | _ => \ () => ex |> format_debug
  """,
  timeout: 300_000
)
```

#### format_exception (test)

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":"///- --test --no-agree \"exception text is backend-specific\" --symbol\n///> cuda\n///> rust\n///> typescript\n\n\\ () => failwith \"test\"\n|> _throws\n|> optionm::value\n|> format_exception\n|> _assert_eq (run_target \\|\n    | Fsharp _ => \\ () => ~~ \"System.Exception: test\"\n    | Cuda _ => \\ () => \"test\"\n    | Rust => \\ () => \"test\"\n    | TypeScript _ => \\ () => \"Error: test\"\n    | _ => \\ () => null ()\n)","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  ///- --test --no-agree "exception text is backend-specific" --symbol
  ///> cuda
  ///> rust
  ///> typescript

  \ () => failwith "test"
  |> _throws
  |> optionm::value
  |> format_exception
  |> _assert_eq (run_target \|
      | Fsharp _ => \ () => ~~ "System.Exception: test"
      | Cuda _ => \ () => "test"
      | Rust => \ () => "test"
      | TypeScript _ => \ () => "Error: test"
      | _ => \ () => null ()
  )
  """,
  timeout: 300_000
)
```

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":":= range \\* t. (start : am'::range t) (end : am'::range t) s =\n    := is_start, start, end =\n        := len () : int =\n            ~>\n                ?: t ?|\n                | int => length `t s\n                | _ => length' `t s\n        ?= start, end ?|\n        | Start start, End fn => !+, start, len >> convert::to |> fn\n        | End start_fn, End end_fn => !-, start_fn (len >> convert::to), end_fn (len >> convert::to)\n    := start' = start |> convert::try_convert |> optionm::value : int\n    := end' = end |> convert::try_convert |> optionm::value : int\n    := start_is_var = start |> var_is\n    := same_fixed = start = end && (start_is_var |> not) && (end |> var_is |> not)\n    := start_var_s_fixed = start_is_var && (s |> var_is |> not)\n    := trace () =\n        [\n            \"sm'.range\"\n            \" / (s |> var_is): \"; s |> var_is |> obj_to_string\n            \" // start: \"; start |> obj_to_string\n            \" / (start |> var_is): \"; start_is_var |> obj_to_string\n            \" // end: \"; end |> obj_to_string\n            \" / (end |> var_is): \"; end |> var_is |> obj_to_string\n            \" // same_fixed: \"; same_fixed |> obj_to_string\n            \" / start_var_s_fixed: \"; start_var_s_fixed |> obj_to_string\n        ]\n        |> concat_list \"\"\n    backend_switch {\n        Gleam = \\ () =>\n            ()\n        Lua = id : () -> ()\n        Fsharp = id : () -> ()\n        Python = id : () -> ()\n        Rust = id : () -> ()\n        TypeScript = id : () -> ()\n        Zig = id : () -> ()\n    }\n    s |> slice start' (end' - (? is_start && (same_fixed || start_var_s_fixed) ?> 0 |: 1))","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  := range \* t. (start : am'::range t) (end : am'::range t) s =
      := is_start, start, end =
          := len () : int =
              ~>
                  ?: t ?|
                  | int => length `t s
                  | _ => length' `t s
          ?= start, end ?|
          | Start start, End fn => !+, start, len >> convert::to |> fn
          | End start_fn, End end_fn => !-, start_fn (len >> convert::to), end_fn (len >> convert::to)
      := start' = start |> convert::try_convert |> optionm::value : int
      := end' = end |> convert::try_convert |> optionm::value : int
      := start_is_var = start |> var_is
      := same_fixed = start = end && (start_is_var |> not) && (end |> var_is |> not)
      := start_var_s_fixed = start_is_var && (s |> var_is |> not)
      := trace () =
          [
              "sm'.range"
              " / (s |> var_is): "; s |> var_is |> obj_to_string
              " // start: "; start |> obj_to_string
              " / (start |> var_is): "; start_is_var |> obj_to_string
              " // end: "; end |> obj_to_string
              " / (end |> var_is): "; end |> var_is |> obj_to_string
              " // same_fixed: "; same_fixed |> obj_to_string
              " / start_var_s_fixed: "; start_var_s_fixed |> obj_to_string
          ]
          |> concat_list ""
      backend_switch {
          Gleam = \ () =>
              ()
          Lua = id : () -> ()
          Fsharp = id : () -> ()
          Python = id : () -> ()
          Rust = id : () -> ()
          TypeScript = id : () -> ()
          Zig = id : () -> ()
      }
      s |> slice start' (end' - (? is_start && (same_fixed || start_var_s_fixed) ?> 0 |: 1))
  """,
  timeout: 300_000
)
```

#### range (test)

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":"///- --test --symbol\n///> gleam\n///> fsharp\n///> cuda\n///> rust\n///> typescript\n\n\"abcde\"\n|> range (am'::Start 0i32) (am'::End eval)\n|> _assert_eq \"abcde\"\n\n(~~ \"fghij\")\n|> range (am'::Start 1i32) (am'::End eval)\n|> _assert_eq \"ghij\"\n\n(~~ \"klmno\")\n|> range (am'::Start 1i32) (am'::End \\ _ => 1)\n|> _assert_eq \"l\"\n\n\"pqrst\"\n|> range (am'::Start 1i32) (am'::End \\ _ => 1)\n|> _assert_eq \"q\"\n\n\"uvwxy\"\n|> range (am'::Start (~~ 1i32)) (am'::End \\ _ => 1)\n|> _assert_eq \"v\"\n\n\"zabcd\"\n|> range (am'::Start (~~ 1i32)) (am'::End \\ _ => ~~ 1)\n|> _assert_eq \"a\"\n\n(~~ \"efghi\")\n|> range (am'::Start 1i32) (am'::End \\ _ => 5)\n|> _assert_eq \"fghi\"\n\n\"jklmn\"\n|> range (am'::End \\ x => 1i32) (am'::End \\ _ => ~~ 5)\n|> _assert_eq \"klmn\"\n\n\"opqrs\"\n|> range (am'::End \\ x => x () - 4i32) (am'::End \\ x => x () - 1i32)\n|> _assert_eq \"pqr\"\n\n(~~ \"stuvw\")\n|> range (am'::End \\ x => x () - 4i32) (am'::End \\ x => x () - 1)\n|> _assert_eq \"tuv\"\n\n(~~ \"wxyza\")\n|> range (am'::Start (~~ 2i32)) (am'::End \\ x => x () - 2)\n|> _assert_eq \"y\"\n\n(~~ \"bcdef\")\n|> range (am'::Start (~~ 2i32)) (am'::End \\ x => x () - 3)\n|> _assert_eq \"\"\n\n(~~ \"ghijk\")\n|> range (am'::Start (~~ 1i32)) (am'::End \\ x => x () - 3)\n|> _assert_eq \"h\"\n\n(~~ \"lmnop\")\n|> range (am'::Start (~~ 1i32)) (am'::End \\ x => x () - 4)\n|> _assert_eq \"\"\n\n(~~ \"qrstu\")\n|> range (am'::End \\ x => x () - 4i32) (am'::End \\ _ => 4)\n|> _assert_eq \"rst\"\n\n\"vwxyz\"\n|> range (am'::End \\ x => ~~ x () - 4i32) (am'::End \\ _ => 4)\n|> _assert_eq \"wxy\"","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  ///- --test --symbol
  ///> gleam
  ///> fsharp
  ///> cuda
  ///> rust
  ///> typescript

  "abcde"
  |> range (am'::Start 0i32) (am'::End eval)
  |> _assert_eq "abcde"

  (~~ "fghij")
  |> range (am'::Start 1i32) (am'::End eval)
  |> _assert_eq "ghij"

  (~~ "klmno")
  |> range (am'::Start 1i32) (am'::End \ _ => 1)
  |> _assert_eq "l"

  "pqrst"
  |> range (am'::Start 1i32) (am'::End \ _ => 1)
  |> _assert_eq "q"

  "uvwxy"
  |> range (am'::Start (~~ 1i32)) (am'::End \ _ => 1)
  |> _assert_eq "v"

  "zabcd"
  |> range (am'::Start (~~ 1i32)) (am'::End \ _ => ~~ 1)
  |> _assert_eq "a"

  (~~ "efghi")
  |> range (am'::Start 1i32) (am'::End \ _ => 5)
  |> _assert_eq "fghi"

  "jklmn"
  |> range (am'::End \ x => 1i32) (am'::End \ _ => ~~ 5)
  |> _assert_eq "klmn"

  "opqrs"
  |> range (am'::End \ x => x () - 4i32) (am'::End \ x => x () - 1i32)
  |> _assert_eq "pqr"

  (~~ "stuvw")
  |> range (am'::End \ x => x () - 4i32) (am'::End \ x => x () - 1)
  |> _assert_eq "tuv"

  (~~ "wxyza")
  |> range (am'::Start (~~ 2i32)) (am'::End \ x => x () - 2)
  |> _assert_eq "y"

  (~~ "bcdef")
  |> range (am'::Start (~~ 2i32)) (am'::End \ x => x () - 3)
  |> _assert_eq ""

  (~~ "ghijk")
  |> range (am'::Start (~~ 1i32)) (am'::End \ x => x () - 3)
  |> _assert_eq "h"

  (~~ "lmnop")
  |> range (am'::Start (~~ 1i32)) (am'::End \ x => x () - 4)
  |> _assert_eq ""

  (~~ "qrstu")
  |> range (am'::End \ x => x () - 4i32) (am'::End \ _ => 4)
  |> _assert_eq "rst"

  "vwxyz"
  |> range (am'::End \ x => ~~ x () - 4i32) (am'::End \ _ => 4)
  |> _assert_eq "wxy"
  """,
  timeout: 300_000
)
```

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":":= decimal_text \\* t {number}. (x : t) : string =\n    run_target \\|\n        | Rust => \\ () => $'std::rc::Rc::<str>::from((!x).to_string())' : string\n        | _ => \\ () => format x\n\n:= char_text (code : u8) : string =\n    run_target \\|\n        | Rust => \\ () => $'std::rc::Rc::<str>::from(char::from(!code).to_string())' : string\n        | Fsharp => \\ () => $'string (char !code)' : string\n        | _ => \\ () => no_arm \"sm'.char_text\"\n\n:= bytes_between (start : i32) (stop : i32) (text : string) : string =\n    run_target \\|\n        | Rust => \\ () =>\n            $'std::rc::Rc::<str>::from((!text).get(!start as usize..!stop as usize).unwrap_or(\"\"))' : string\n        | Fsharp => \\ () =>\n            $'(let b = System.Text.Encoding.UTF8.GetBytes(!text : string) in \\\n                let edge i = i = b.Length || (b.[i] &&& 0xC0uy) <> 0x80uy in \\\n                if !start < 0 || !start > !stop || !stop > b.Length || not (edge !start) || not (edge !stop) then \"\" \\\n                else System.Text.Encoding.UTF8.GetString(b, !start, !stop - !start))' : string\n        | _ => \\ () => no_arm \"sm'.bytes_between\"","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  := decimal_text \* t {number}. (x : t) : string =
      run_target \|
          | Rust => \ () => $'std::rc::Rc::<str>::from((!x).to_string())' : string
          | _ => \ () => format x

  := char_text (code : u8) : string =
      run_target \|
          | Rust => \ () => $'std::rc::Rc::<str>::from(char::from(!code).to_string())' : string
          | Fsharp => \ () => $'string (char !code)' : string
          | _ => \ () => no_arm "sm'.char_text"

  := bytes_between (start : i32) (stop : i32) (text : string) : string =
      run_target \|
          | Rust => \ () =>
              $'std::rc::Rc::<str>::from((!text).get(!start as usize..!stop as usize).unwrap_or(""))' : string
          | Fsharp => \ () =>
              $'(let b = System.Text.Encoding.UTF8.GetBytes(!text : string) in \
                  let edge i = i = b.Length || (b.[i] &&& 0xC0uy) <> 0x80uy in \
                  if !start < 0 || !start > !stop || !stop > b.Length || not (edge !start) || not (edge !stop) then "" \
                  else System.Text.Encoding.UTF8.GetString(b, !start, !stop - !start))' : string
          | _ => \ () => no_arm "sm'.bytes_between"
  """,
  timeout: 300_000
)
```

#### bytes_between_slices_utf8_bytes_or_gives_empty (test)

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":"///- --test --symbol\n///> fsharp\n///> rust\n\n\"aéb\" |> bytes_between 1i32 3i32 |> _assert_eq \"é\"\n\"aéb\" |> bytes_between 3i32 4i32 |> _assert_eq \"b\"\n\"aéb\" |> bytes_between 1i32 2i32 |> _assert_eq \"\"\n\"aéb\" |> bytes_between 0i32 9i32 |> _assert_eq \"\"\n\"aéb\" |> bytes_between (-1i32) 2i32 |> _assert_eq \"\"\n\"aéb\" |> bytes_between 2i32 1i32 |> _assert_eq \"\"","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  ///- --test --symbol
  ///> fsharp
  ///> rust

  "aéb" |> bytes_between 1i32 3i32 |> _assert_eq "é"
  "aéb" |> bytes_between 3i32 4i32 |> _assert_eq "b"
  "aéb" |> bytes_between 1i32 2i32 |> _assert_eq ""
  "aéb" |> bytes_between 0i32 9i32 |> _assert_eq ""
  "aéb" |> bytes_between (-1i32) 2i32 |> _assert_eq ""
  "aéb" |> bytes_between 2i32 1i32 |> _assert_eq ""
  """,
  timeout: 300_000
)
```

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":":= all_digits (text : string) : bool =\n    run_target \\|\n        | Rust => \\ () => $'\\!!text.is_empty() && !text.bytes().all(|byte| byte.is_ascii_digit())' : bool\n        | Fsharp => \\ () => $'(!text <> \"\" && String.forall (fun c -> c >= \\'0\\' && c <= \\'9\\') !text)' : bool\n        | _ => \\ () => no_arm \"sm'.all_digits\"","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  := all_digits (text : string) : bool =
      run_target \|
          | Rust => \ () => $'\!!text.is_empty() && !text.bytes().all(|byte| byte.is_ascii_digit())' : bool
          | Fsharp => \ () => $'(!text <> "" && String.forall (fun c -> c >= \'0\' && c <= \'9\') !text)' : bool
          | _ => \ () => no_arm "sm'.all_digits"
  """,
  timeout: 300_000
)
```

