## fsharp

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":":! gleam_dynamic = $'Dynamic'\n\n:= last_index_of_gleam () =\n    global \"import gleam/bit_array\"\n    global \"import gleam/dynamic.{type Dynamic}\"\n    global \"import gleam/erlang/atom\"\n    global \"\"\"\n        @external(erlang, \"string\", \"find\")\n        fn spiral_sm_find_trailing(text: String, search: String, direction: atom.Atom) -> Dynamic\n\n        @external(erlang, \"gleam_stdlib\", \"identity\")\n        fn spiral_sm_coerce(value: a) -> b\n        \"\"\"\n\n:= gleam_byte_size (s : string) : i32 =\n    last_index_of_gleam ()\n    $'bit_array.byte_size(bit_array.from_string(!s))' : i32\n\n:= gleam_find_trailing (search : string) (s : string) : gleam_dynamic =\n    last_index_of_gleam ()\n    $'spiral_sm_find_trailing(!s, !search, atom.create(\"trailing\"))' : gleam_dynamic\n\n:= gleam_is_nomatch (found : gleam_dynamic) : bool =\n    $'!found == spiral_sm_coerce(atom.create(\"nomatch\"))' : bool\n\n:= gleam_dynamic_text (found : gleam_dynamic) : string =\n    $'spiral_sm_coerce(!found)' : string\n\n:= last_index_of (search : string) (s : string) : i32 =\n    := search = dyn search\n    run_target \\|\n        | Zig => \\ () => $'(if (std.mem.lastIndexOf(u8, !s, !search)) |i| @@as(i32, @@intCast(i)) else -1)' : i32\n        | Rust => \\ () =>\n            ($'!s.rfind(&*!search)' : optionm'::option' convert::unativeint)\n            |> optionm'::map \\ i => convert::convert i\n            |> optionm'::unwrap_or -1i32\n        | Gleam => \\ () =>\n            ? search = \"\" ?> gleam_byte_size s\n            |:\n                := found = gleam_find_trailing search s\n                ? gleam_is_nomatch found ?> -1i32 |: gleam_byte_size s - gleam_byte_size (gleam_dynamic_text found)\n        | _ => \\ () => $'!s.LastIndexOf !search ' : i32","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ":! gleam_dynamic = $'Dynamic'\n\n:= last_index_of_gleam () =\n    global \"import gleam/bit_array\"\n    global \"import gleam/dynamic.{type Dynamic}\"\n    global \"import gleam/erlang/atom\"\n    global \"\"\"\n        @external(erlang, \"string\", \"find\")\n        fn spiral_sm_find_trailing(text: String, search: String, direction: atom.Atom) -> Dynamic\n\n        @external(erlang, \"gleam_stdlib\", \"identity\")\n        fn spiral_sm_coerce(value: a) -> b\n        \"\"\"\n\n:= gleam_byte_size (s : string) : i32 =\n    last_index_of_gleam ()\n    $'bit_array.byte_size(bit_array.from_string(!s))' : i32\n\n:= gleam_find_trailing (search : string) (s : string) : gleam_dynamic =\n    last_index_of_gleam ()\n    $'spiral_sm_find_trailing(!s, !search, atom.create(\"trailing\"))' : gleam_dynamic\n\n:= gleam_is_nomatch (found : gleam_dynamic) : bool =\n    $'!found == spiral_sm_coerce(atom.create(\"nomatch\"))' : bool\n\n:= gleam_dynamic_text (found : gleam_dynamic) : string =\n    $'spiral_sm_coerce(!found)' : string\n\n:= last_index_of (search : string) (s : string) : i32 =\n    := search = dyn search\n    run_target \\|\n        | Zig => \\ () => $'(if (std.mem.lastIndexOf(u8, !s, !search)) |i| @@as(i32, @@intCast(i)) else -1)' : i32\n        | Rust => \\ () =>\n            ($'!s.rfind(&*!search)' : optionm'::option' convert::unativeint)\n            |> optionm'::map \\ i => convert::convert i\n            |> optionm'::unwrap_or -1i32\n        | Gleam => \\ () =>\n            ? search = \"\" ?> gleam_byte_size s\n            |:\n                := found = gleam_find_trailing search s\n                ? gleam_is_nomatch found ?> -1i32 |: gleam_byte_size s - gleam_byte_size (gleam_dynamic_text found)\n        | _ => \\ () => $'!s.LastIndexOf !search ' : i32",
  timeout: 300_000
)
```

