<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":":= format \\* t. (x : t) : string =\n    ~> show_real `t x","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  := format \* t. (x : t) : string =
      ~> show_real `t x
  """,
  timeout: 300_000
)
```

#### format (test)

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":"///- --test --symbol\n///> gleam\n///> lua\n///> cuda\n///> rust\n///> typescript\n///> c\n\n(\"1\", \"2\", [ \"3\"; \"4\" ], { b = \"5\"; c = \"6\"; a = \\ () => \"7\" }, ;[ 8i32 ])\n|> format\n|> _assert_eq \"(1, 2, Cons(3, Cons(4, Nil)), { b = 5; c = 6; a = 7 }, [8])\"","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  ///- --test --symbol
  ///> gleam
  ///> lua
  ///> cuda
  ///> rust
  ///> typescript
  ///> c

  ("1", "2", [ "3"; "4" ], { b = "5"; c = "6"; a = \ () => "7" }, ;[ 8i32 ])
  |> format
  |> _assert_eq "(1, 2, Cons(3, Cons(4, Nil)), { b = 5; c = 6; a = 7 }, [8])"
  """,
  timeout: 300_000
)
```

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":":= format_fixed_digits (decimals : i32) (x : f64) : string =\n    := negative = x < 0.0\n    := magnitude = ? negative ?> 0.0 - x |: x\n    :~ ^ up (v : f64) (e : i32) : f64 * i32 =\n        ? v > 0.0 && v < 4503599627370496.0 ?> up (v * 2.0) (e - 1) |: v, e\n    :~ ^ down (v : f64) (e : i32) : f64 * i32 =\n        ? v >= 9007199254740992.0 ?> down (v / 2.0) (e + 1) |: v, e\n    := raised, raised_by = up magnitude 0\n    := mantissa, exponent = down raised raised_by\n    := digits : array i32 = create 1200\n    :~ ^ clear (i : i32) : () =\n        ? i < 1200 ?>\n            set digits i 0\n            clear (i + 1)\n    clear 0\n    :~ ^ put (m : u64) (i : i32) : i32 =\n        ? m = 0u64\n        ?> i\n        |:\n            set digits i (conv (m % 10u64))\n            put (m / 10u64) (i + 1)\n    := scale_by (factor : i32) (length : i32) : i32 =\n        :~ ^ spill (j : i32) (carry : i32) : i32 =\n            ? carry = 0\n            ?> j\n            |:\n                set digits j (carry % 10)\n                spill (j + 1) (carry / 10)\n        :~ ^ go (i : i32) (carry : i32) : i32 =\n            ? i < length\n            ?>\n                := t = am'::index i digits * factor + carry\n                set digits i (t % 10)\n                go (i + 1) (t / 10)\n            |: spill length carry\n        go 0 0\n    :~ ^ repeat (times : i32) (factor : i32) (length : i32) : i32 =\n        ? times <= 0 ?> length |: repeat (times - 1) factor (scale_by factor length)\n    := started = put (conv mantissa) 0\n    := scaled = repeat decimals 10 started\n    := length, drop =\n        ? exponent >= 0 ?> repeat exponent 2 scaled, 0 |: repeat (0 - exponent) 5 scaled, 0 - exponent\n    :~ ^ lower_nonzero (i : i32) : bool =\n        ? i < 0 ?> !- |? am'::index i digits <> 0 ?> !+ |: lower_nonzero (i - 1)\n    := rounds_up =\n        ? drop <= 0\n        ?> !-\n        |:\n            := top = am'::index (drop - 1) digits\n            := odd = drop < length && am'::index drop digits % 2 = 1\n            top > 5 || top = 5 && (lower_nonzero (drop - 2) || odd)\n    :~ ^ carry_from (i : i32) (length : i32) : i32 =\n        := t = am'::index i digits + 1\n        set digits i (t % 10)\n        := grown = ? i >= length ?> i + 1 |: length\n        ? t < 10 ?> grown |: carry_from (i + 1) grown\n    := final = ? rounds_up ?> carry_from drop length |: length\n    := top = ? final - drop > decimals + 1 ?> final - 1 |: drop + decimals\n    :~ ^ leading (i : i32) : i32 =\n        ? i > drop + decimals && am'::index i digits = 0 ?> leading (i - 1) |: i\n    := first = leading top\n    := digit_text (d : i32) : string =\n        ? d = 0 ?> \"0\" |? d = 1 ?> \"1\" |? d = 2 ?> \"2\" |? d = 3 ?> \"3\" |? d = 4 ?> \"4\"\n        |? d = 5 ?> \"5\" |? d = 6 ?> \"6\" |? d = 7 ?> \"7\" |? d = 8 ?> \"8\" |: \"9\"\n    :~ ^ text (i : i32) (acc : string) : string =\n        ? i < drop\n        ?> acc\n        |:\n            := point = ? decimals > 0 && i = drop + decimals - 1 ?> \".\" |: \"\"\n            text (i - 1) (acc ++# point ++# digit_text (am'::index i digits))\n    (? negative ?> \"-\" |: \"\") ++# text first \"\"\n\n:= format_fixed (decimals : i32) (x : f64) : string =\n    backend_switch {\n        Fsharp = \\ () =>\n            $'(!x).ToString(\"F\" + string !decimals, System.Globalization.CultureInfo.InvariantCulture)' : string\n        Lua = \\ () => $'string.format(\"%.\" .. !decimals .. \"f\", !x)' : string\n        Python = \\ () => $'format(!x, \".\" + str(!decimals) + \"f\")' : string\n        Rust = \\ () =>\n            := precision : convert::unativeint = convert::convert decimals\n            $'Rc::<str>::from(format\\!(\"{:.*}\", !precision, !x).as_str())' : string\n        TypeScript = \\ () => $'(!x).toFixed(!decimals)' : string\n        C = \\ () => format_fixed_digits decimals x\n        Gleam = \\ () => format_fixed_digits decimals x\n        Zig = \\ () => format_fixed_digits decimals x\n    }","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  := format_fixed_digits (decimals : i32) (x : f64) : string =
      := negative = x < 0.0
      := magnitude = ? negative ?> 0.0 - x |: x
      :~ ^ up (v : f64) (e : i32) : f64 * i32 =
          ? v > 0.0 && v < 4503599627370496.0 ?> up (v * 2.0) (e - 1) |: v, e
      :~ ^ down (v : f64) (e : i32) : f64 * i32 =
          ? v >= 9007199254740992.0 ?> down (v / 2.0) (e + 1) |: v, e
      := raised, raised_by = up magnitude 0
      := mantissa, exponent = down raised raised_by
      := digits : array i32 = create 1200
      :~ ^ clear (i : i32) : () =
          ? i < 1200 ?>
              set digits i 0
              clear (i + 1)
      clear 0
      :~ ^ put (m : u64) (i : i32) : i32 =
          ? m = 0u64
          ?> i
          |:
              set digits i (conv (m % 10u64))
              put (m / 10u64) (i + 1)
      := scale_by (factor : i32) (length : i32) : i32 =
          :~ ^ spill (j : i32) (carry : i32) : i32 =
              ? carry = 0
              ?> j
              |:
                  set digits j (carry % 10)
                  spill (j + 1) (carry / 10)
          :~ ^ go (i : i32) (carry : i32) : i32 =
              ? i < length
              ?>
                  := t = am'::index i digits * factor + carry
                  set digits i (t % 10)
                  go (i + 1) (t / 10)
              |: spill length carry
          go 0 0
      :~ ^ repeat (times : i32) (factor : i32) (length : i32) : i32 =
          ? times <= 0 ?> length |: repeat (times - 1) factor (scale_by factor length)
      := started = put (conv mantissa) 0
      := scaled = repeat decimals 10 started
      := length, drop =
          ? exponent >= 0 ?> repeat exponent 2 scaled, 0 |: repeat (0 - exponent) 5 scaled, 0 - exponent
      :~ ^ lower_nonzero (i : i32) : bool =
          ? i < 0 ?> !- |? am'::index i digits <> 0 ?> !+ |: lower_nonzero (i - 1)
      := rounds_up =
          ? drop <= 0
          ?> !-
          |:
              := top = am'::index (drop - 1) digits
              := odd = drop < length && am'::index drop digits % 2 = 1
              top > 5 || top = 5 && (lower_nonzero (drop - 2) || odd)
      :~ ^ carry_from (i : i32) (length : i32) : i32 =
          := t = am'::index i digits + 1
          set digits i (t % 10)
          := grown = ? i >= length ?> i + 1 |: length
          ? t < 10 ?> grown |: carry_from (i + 1) grown
      := final = ? rounds_up ?> carry_from drop length |: length
      := top = ? final - drop > decimals + 1 ?> final - 1 |: drop + decimals
      :~ ^ leading (i : i32) : i32 =
          ? i > drop + decimals && am'::index i digits = 0 ?> leading (i - 1) |: i
      := first = leading top
      := digit_text (d : i32) : string =
          ? d = 0 ?> "0" |? d = 1 ?> "1" |? d = 2 ?> "2" |? d = 3 ?> "3" |? d = 4 ?> "4"
          |? d = 5 ?> "5" |? d = 6 ?> "6" |? d = 7 ?> "7" |? d = 8 ?> "8" |: "9"
      :~ ^ text (i : i32) (acc : string) : string =
          ? i < drop
          ?> acc
          |:
              := point = ? decimals > 0 && i = drop + decimals - 1 ?> "." |: ""
              text (i - 1) (acc ++# point ++# digit_text (am'::index i digits))
      (? negative ?> "-" |: "") ++# text first ""

  := format_fixed (decimals : i32) (x : f64) : string =
      backend_switch {
          Fsharp = \ () =>
              $'(!x).ToString("F" + string !decimals, System.Globalization.CultureInfo.InvariantCulture)' : string
          Lua = \ () => $'string.format("%." .. !decimals .. "f", !x)' : string
          Python = \ () => $'format(!x, "." + str(!decimals) + "f")' : string
          Rust = \ () =>
              := precision : convert::unativeint = convert::convert decimals
              $'Rc::<str>::from(format\!("{:.*}", !precision, !x).as_str())' : string
          TypeScript = \ () => $'(!x).toFixed(!decimals)' : string
          C = \ () => format_fixed_digits decimals x
          Gleam = \ () => format_fixed_digits decimals x
          Zig = \ () => format_fixed_digits decimals x
      }
  """,
  timeout: 300_000
)
```

