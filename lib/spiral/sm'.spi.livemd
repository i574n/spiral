### (++#*)

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":"///- --real\n\n:= (++#*) (a : string) (b : string) : string =\n    append_real b a","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  ///- --real

  := (++#*) (a : string) (b : string) : string =
      append_real b a
  """,
  timeout: 300_000
)
```

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":":= (++#) (a : string) (b : string) : string =\n    ~> (++#*) a b\n\n:= (++\\\\#) a b =\n    a ++# \"\\\\n\" ++# b\n\n:= (++\\#) a b =\n    a ++# \"\\n\" ++# b","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  := (++#) (a : string) (b : string) : string =
      ~> (++#*) a b

  := (++\\#) a b =
      a ++# "\\n" ++# b

  := (++\#) a b =
      a ++# "\n" ++# b
  """,
  timeout: 300_000
)
```

### format_debug_real

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":"///- --real\n\n:= ^ format_debug_real \\* t. (x : t) : string =\n    ?: t ?|\n    | string => x\n    | _ =>\n        backend_switch `string `({}) {\n            Gleam =\n                (\\ () =>\n                    ?: t ?|\n                    | char => convert::to `(`x) `string x\n                    | string_builder_real => convert::to `(`x) `string x\n                    | _ =>\n                        global \"import gleam/string\"\n                        := x =\n                            ?: t ?|\n                            | array_base _ => $'!x |> spiral_array_to_list' : t\n                            | _ => x\n                        $'string.inspect(!x)' : string\n                    ) : () -> string\n            Lua =\n                (\\ () =>\n                    ?: t ?|\n                    | ~a * ~b =>\n                        := a, b =\n                            ? not (var_is `t x)\n                            ?> x\n                            |: ($'__v[1]._1' : a), ($'__v[1]._2' : b)\n                        := head_str = format_debug_real `a a\n                        := tail_str = format_debug_real `b b\n                        (++#*) head_str ((++#*) \", \" tail_str)\n                    | {} =>\n                        := _, fields =\n                            real_core::record_fold\n                                \\ { state = separator, acc key value } =>\n                                    \", \", acc ++#* separator ++#* format_debug_real `(`value) value\n                                (\"\", \"\") x\n                        fields\n                    | array_base _ =>\n                        (++#*) ((++#*) \"[\" ($'table.concat(!x, \", \")' : string)) \"]\"\n                    | i64 => $'spiral_w64.tostring(!x, true)' : string\n                    | u64 => $'spiral_w64.tostring(!x, false)' : string\n                    | t =>\n                        ? real_core::union_type_is `t\n                        ?> serialize_union `t x\n                        |: $'tostring(!x)       ' : string\n                ) : () -> string\n            Fsharp = (\\ () => $'$\"%A{!x}\"' : string) : () -> string\n            Python =\n                (\\ () =>\n                    $'f\"{!x}\"' : string\n                ) : () -> string\n            Rust =\n                (\\ () =>\n                    ?: t ?|\n                    | char => $'Rc::<str>::from(format\\!(\"{:?}\", !x as char))' : string\n                    | optionm'::option' ~a =>\n                        ? real_core::prim_type_is `a\n                        ?> $'Rc::<str>::from(match &!x { Some(v) => format\\!(\"Some {:?}\", v), None => String::from(\"None\") })' : string\n                        |:\n                            := x = $'Rc::new(RefCell::new(!x.clone().into_iter().collect::<Vec<_>>()))' : array_base a\n                            ? !!!!EQ(!!!!ArrayLength(`u64, x), 0u64) ?> \"None\"\n                            |: (++#*) \"Some \" (format_debug_element_rust `a !!!!ArrayIndex(x, 0u64))\n                    | () * ~b =>\n                        := _, b = x\n                        format_debug_real `b b\n                    | ~a * ~b =>\n                        := a, b = x\n                        (++#*) (format_debug_real `a a) ((++#*) \", \" (format_debug_real `b b))\n                    | array_base ~el =>\n                        ? real_core::prim_type_is `el\n                        ?> $'Rc::<str>::from(format\\!(\"{:?}\", !x.borrow()))' : string\n                        |: format_debug_elements_rust `el x\n                    | listm'::list' ~el =>\n                        ? real_core::prim_type_is `el\n                        ?> format_debug_other_rust `t x\n                        |: format_debug_elements_rust `el ($'Rc::new(RefCell::new((*!x).clone()))' : array_base el)\n                    | seq::seq' ~el =>\n             