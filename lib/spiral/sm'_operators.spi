:= (~#?) s =
    s |> sm'.(~#?)

:= (~#?*) s =
    s |> sm'.(~#?*)

:= (~#?**) s =
    s |> sm'.(~#?**)

:= (~#) s =
    s |> sm'.(~#)

:= (~##) s =
    s |> sm'.(~##)

:= (~###) s =
    s |> sm'.(~###)

:= (++#) a b =
    sm'.(++#) a b

:= (++#?) a b =
    sm'.(++#?) a b

:= (++\\#) a b =
    sm'.(++\\#) a b

:= (++\#) a b =
    sm'.(++\#) a b
