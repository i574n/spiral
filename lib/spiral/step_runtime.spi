/// # step_runtime
:< sm'_operators

test step_runtime static =
    :< testing

:| step s =
    | Continue : s
    | Stop

:== actor s m = { init : () -> s; handle : s -> m -> step s }

:== step_handle s m =
    {
        state : mut (option s)
        mailbox : mut (list m)
        draining : mut bool
        handle : s -> m -> step s
    }

:== reply_cell t = mut (option t)

/// ### spawn
:= spawn \* s m. (spec : actor s m) : step_handle s m =
    { state = mut (Some (spec.init ())); mailbox = mut []; draining = mut !-; handle = spec.handle }

/// ### drain
:= drain \* s m. (target : step_handle s m) : () =
    := draining = target.draining
    := mailbox = target.mailbox
    := state = target.state
    ? *draining |> not ?>
        draining <- !+
        :~ ^ 루프 () : () =
            ?= *mailbox ?|
            | [] => ()
            | message :: rest =>
                mailbox <- rest
                ?= *state ?|
                | Some current =>
                    ?= target.handle current message ?|
                    | Continue next => state <- Some next
                    | Stop => state <- None
                | None => ()
                루프 ()
        루프 ()
        draining <- !-

/// ### send
:= send \* s m. (target : step_handle s m) (message : m) : () =
    := mailbox = target.mailbox
    mailbox <- *mailbox ++ [ message ]
    drain target

/// ### reply
:= reply \* t. (cell : reply_cell t) (value : t) : () =
    cell <- Some value

/// ### call
:= call \* s m t. (target : step_handle s m) (request : reply_cell t -> m) : t =
    := cell : reply_cell t = mut None
    send target (request cell)
    ?= *cell ?|
    | Some value => value
    | None => failwith "step_runtime.call: the actor stopped without replying"

:| counter_message r =
    | Add : i32
    | Read : r

:= counter_actor \* r. (answer : r -> i32 -> ()) : actor i32 (counter_message r) =
    {
        init = \ () => 0i32
        handle = \ total message =>
            ?= message ?|
            | Add n => Continue (total + n)
            | Read to =>
                answer to total
                Continue total
    }

:= counter_total \* h r.
    (start : actor i32 (counter_message r) -> h)
    (post : h -> counter_message r -> ())
    (ask : h -> (r -> counter_message r) -> i32)
    (answer : r -> i32 -> ())
    : i32
    =
    := counter = start (counter_actor answer)
    post counter (Add 3i32)
    post counter (Add 4i32)
    ask counter Read

:= otp_start \* s m. (spec : actor s m) : erlang_process.subject m =
    otp_actor.new_with_init 10000i32 spec.init
    |> otp_actor.on_message \ state message =>
        ?= spec.handle state message ?|
        | Continue next => otp_actor.continue next
        | Stop => otp_actor.stop ()
    |> otp_actor.start
    |> otp_actor.started_data
    |> \|
        | Some inbox => inbox
        | None => failwith "step_runtime.otp_start: the actor did not start"

///> gleam
///> rust
///> c
test counter_counts_on_every_backend =
    run_target \|
        | Gleam => \ () =>
            counter_total otp_start otp_actor.send
                \ inbox request => otp_actor.call inbox 10000i32 request
                erlang_process.send
        | _ => \ () => counter_total spawn send call reply
    |> _assert_eq 7i32

test stopped_actor_ignores_later_messages =
    := counter =
        spawn {
            init = \ () => 0i32
            handle = \ total n => ? n < 0i32 ?> Stop |: Continue (total + n)
        }
    send counter 5i32
    send counter -1i32
    send counter 9i32
    *counter.state
    |> _assert_eq None

/// ### reactor_actor
:= reactor_actor \* s i o. (program : reactors.reactor s i o) (clock : () -> i64) (emit : o -> ()) : actor s i =
    := react_once (state : s) (message : i) : step s =
        := next, out = program.react state { time = clock (); micro = 0i32 } message
        emit out
        Continue next
    { init = \ () => program.init; handle = react_once }

///> c
///> rust
test reactor_actor_steps_each_message_at_the_clock_tag =
    :< reactors
    := last = mut (-1i64)
    := emit (out : signal i64) : () =
        ?= out ?|
        | Present v => last <- v
        | Absent => ()
    := counter = spawn (reactor_actor (sink ()) (\ () => 0i64) emit)
    send counter (Present 3i64)
    send counter Absent
    send counter (Present 4i64)
    *last |> _assert_eq 7i64
