:< sm'_operators

:# step_runtime static =
    :< testing

:| step s =
    | Continue : s
    | Stop
    | Fail : string

:== actor s m = { init : () -> s; handle : s -> m -> step s }

:| restart_policy =
    | RestartAlways
    | RestartOnCrash
    | RestartNever

:| exit_reason =
    | Normal
    | Abnormal : string

:== step_handle s m =
    {
        state : mut (option s)
        mailbox : mut (list m)
        draining : mut bool
        handle : s -> m -> step s
        init : () -> s
        policy : restart_policy
        budget : mut i32
        gave_up : mut bool
    }

:== reply_cell t = mut (option t)

:= supervise \* s m. (policy : restart_policy) (intensity : i32) (spec : actor s m) : step_handle s m =
    {
        state = mut (Some (spec::init ()))
        mailbox = mut []
        draining = mut !-
        handle = spec::handle
        init = spec::init
        policy = policy
        budget = mut intensity
        gave_up = mut !-
    }

:= spawn \* s m. (spec : actor s m) : step_handle s m = supervise RestartNever 0i32 spec

:= restarts (policy : restart_policy) (reason : exit_reason) : bool =
    ?= policy ?|
    | RestartAlways => !+
    | RestartOnCrash => ?= reason ?| Abnormal _ => !+ | Normal => !-
    | RestartNever => !-

:= exited \* s m. (target : step_handle s m) (reason : exit_reason) : () =
    := state = target::state
    := budget = target::budget
    := gave_up = target::gave_up
    ? restarts target::policy reason |> not
    ?> state <- None
    |? *budget > 0i32
    ?>
        budget <- *budget - 1i32
        state <- Some (target::init ())
    |:
        state <- None
        gave_up <- !+

:= settle \* s m. (target : step_handle s m) (outcome : step s) : () =
    := state = target::state
    ?= outcome ?|
    | Continue next => state <- Some next
    | Stop => exited target Normal
    | Fail why => exited target (Abnormal why)

:= deliver \* s m. (target : step_handle s m) (message : m) : () =
    := state = target::state
    ?= *state ?|
    | Some current => settle target (target::handle current message)
    | None => ()

:= drain_mailbox \* m. (mailbox : mut (list m)) (handle : m -> ()) : () =
    :~ ^ 루프 () : () =
        ?= *mailbox ?|
        | [] => ()
        | message :: rest =>
            mailbox <- rest
            handle message
            루프 ()
    루프 ()

:= drain \* s m. (target : step_handle s m) : () =
    := draining = target::draining
    ? *draining |> not ?>
        draining <- !+
        drain_mailbox target::mailbox (deliver target)
        draining <- !-

:= send \* s m. (target : step_handle s m) (message : m) : () =
    := mailbox = target::mailbox
    mailbox <- *mailbox ++ [ message ]
    drain target

:= reply \* t. (cell : reply_cell t) (value : t) : () =
    cell <- Some value

:= replied \* t. (cell : reply_cell t) : t =
    ?= *cell ?|
    | Some value => value
    | None => failwith "step_runtime.call: the actor stopped without replying"

:= call \* s m t. (target : step_handle s m) (request : reply_cell t -> m) : t =
    := cell : reply_cell t = mut None
    send target (request cell)
    replied cell

:| counter_message r =
    | Add : i32
    | Read : r

:= counter_step \* r. (answer : r -> i32 -> ()) (total : i32) (message : counter_message r) : step i32 =
    ?= message ?|
    | Add n => Continue (total + n)
    | Read to =>
        answer to total
        Continue total

:= counter_actor \* r. (answer : r -> i32 -> ()) : actor i32 (counter_message r) =
    { init = \ () => 0i32; handle = counter_step answer }

:= counter_total \* h r.
    (counter : h) (post : h -> counter_message r -> ()) (ask : h -> (r -> counter_message r) -> i32)
    : i32
    =
    post counter (Add 3i32)
    post counter (Add 4i32)
    ask counter Read

:= otp_next \* s m. (spec : actor s m) (state : s) (message : m) : otp_actor::next s m =
    ?= spec::handle state message ?|
    | Continue next => otp_actor::continue next
    | Stop => otp_actor::stop ()
    | Fail why => otp_actor::stop_abnormal why

:= started_inbox \* m. (started : option (erlang_process::subject m)) : erlang_process::subject m =
    ?= started ?|
    | Some inbox => inbox
    | None => failwith "step_runtime.otp_start: the actor did not start"

:= otp_start \* s m. (spec : actor s m) : erlang_process::subject m =
    otp_actor::new_with_init 10000i32 spec::init
    |> otp_actor::on_message (otp_next spec)
    |> otp_actor::start
    |> otp_actor::started_data
    |> started_inbox

:= otp_counter_total () : i32 =
    := counter = otp_start (counter_actor erlang_process::send)
    counter_total counter otp_actor::send (\ inbox request => otp_actor::call inbox 10000i32 request)

///> gleam
///> rust
///> c
:# counter_counts_on_every_backend =
    run_target \|
        | Gleam => \ () => otp_counter_total ()
        | _ => \ () => counter_total (spawn (counter_actor reply)) send call
    |> _assert_eq 7i32

:= stops_on_negative () : actor i32 i32 =
    {
        init = \ () => 0i32
        handle = \ total n => ? n < 0i32 ?> Stop |: Continue (total + n)
    }

///> zig
:# stopped_actor_ignores_later_messages =
    := counter = spawn (stops_on_negative ())
    send counter 5i32
    send counter -1i32
    send counter 9i32
    *counter::state
    |> _assert_eq None

:= react_step \* s i o.
    (program : reactors::reactor s i o) (clock : () -> i64) (emit : o -> ()) (state : s) (message : i)
    : step s
    =
    := next, out = program::react state { time = clock (); micro = 0i32 } message
    emit out
    Continue next

:= reactor_actor \* s i o. (program : reactors::reactor s i o) (clock : () -> i64) (emit : o -> ()) : actor s i =
    { init = \ () => program::init; handle = react_step program clock emit }

:= keep_present (last : mut i64) (out : reactors::signal i64) : () =
    ?= out ?|
    | Present v => last <- v
    | Absent => ()

:= feed_sink (last : mut i64) : () =
    :< reactors
    := counter = spawn (reactor_actor (sink ()) (\ () => 0i64) (keep_present last))
    send counter (Present 3i64)
    send counter Absent
    send counter (Present 4i64)

///> c
///> rust
:# reactor_actor_steps_each_message_at_the_clock_tag =
    := last = mut (-1i64)
    feed_sink last
    *last |> _assert_eq 7i64

:| fragile_message =
    | Bump
    | Boom
    | Quit
    | Peek : reply_cell i32

:= fragile_step (total : i32) (message : fragile_message) : step i32 =
    ?= message ?|
    | Bump => Continue (total + 1i32)
    | Boom => Fail "boom on request"
    | Quit => Stop
    | Peek cell =>
        reply cell total
        Continue total

:= fragile () : actor i32 fragile_message = { init = \ () => 0i32; handle = fragile_step }

:= crashed_and_restarted (child : step_handle i32 fragile_message) : i32 * i32 =
    send child Bump
    send child Bump
    := before = call child Peek
    send child Boom
    before, call child Peek

///> rust
///> c
:# a_crashed_child_restarts_with_fresh_state_until_its_intensity_runs_out =
    := child = supervise RestartOnCrash 1i32 (fragile ())
    := before, after = crashed_and_restarted child
    send child Boom
    := state = child::state
    := gave_up = child::gave_up
    (before, after, *state, *gave_up) |> _assert_eq (2i32, 0i32, None, !+)

///> rust
///> c
:# a_crash_only_child_stays_down_after_a_normal_stop =
    := child = supervise RestartOnCrash 3i32 (fragile ())
    send child Bump
    send child Quit
    := state = child::state
    := budget = child::budget
    := gave_up = child::gave_up
    (*state, *budget, *gave_up) |> _assert_eq (None, 3i32, !-)
