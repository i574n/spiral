:< rust.rust_operators
:< rust

:= storage_get \* t. (key : string) (storage : wasm.storage) : result (option t) wasm.js_value =
    := storage = ~~ storage
    := key = ~~ key
    := key = key |> sm'.as_str
    := result = !\\(key, $'$"web_sys::Storage::get_item(&!storage, $0)"')
    := result : result (optionm'.option' sm'.std_string) wasm.js_value = result |> resultm.unbox
    result |> resultm.map \ result =>
        := result = ~~ result
        := result = !\($'"serde_json::from_value(!result.into()).unwrap()"')
        result |> optionm'.unbox

:= storage_set \* t. (key : string) (value : t) (storage : wasm.storage) =
    := storage = ~~ storage
    := key = ~~ key
    := key = key |> sm'.as_str
    := value = ~~ value
    := value : sm'.std_string = !\($'"serde_json::json!!(!value).to_string()"')
    := value = value |> sm'.as_str_std
    (!\\(key, $'$"true; web_sys::Storage::set(&!storage, $0, !value).unwrap()"') : bool) |> ignore

:~ local_storage (window : wasm.window) : resultm.result' (optionm'.option' wasm.storage) wasm.js_value =
    !\\(window, $'"$0.local_storage()"')

:= store_get \* t. (key : string) (store : wasm.rexie_store) : async.future_pin t =
    := key = ~~ key
    := key = key |> sm'.as_str
    := key : wasm.js_value = !\\(key, $'"wasm_bindgen::JsValue::from_str($0)"')
    !\($'$"Box::pin(rexie::Store::get(&!store, !key))"')

:= transaction_read_only \* (t : * -> *).
    (store_names : array_base string) (rexie : t wasm.rexie)
    : resultm.result' wasm.rexie_transaction sm'.std_string
    =
    := store_names =
        store_names
        |> am'.to_vec
        |> am'.vec_map' sm'.to_std_string
    := rexie = ~~ rexie
    !\\(rexie, $'"$0.transaction(&!store_names, rexie::TransactionMode::ReadOnly)"')
    |> resultm.map_error' \ (x : wasm.rexie_error) => x |> sm'.format'

:= transaction_store
    (store_name : string) (transaction : wasm.rexie_transaction)
    : resultm.result' wasm.rexie_store sm'.std_string
    =
    := store_name = ~~ store_name
    := store_name = store_name |> sm'.as_str
    !\\(store_name, $'"!transaction.store($0)"')
    |> resultm.map_error' \ (x : wasm.rexie_error) => x |> sm'.format'
