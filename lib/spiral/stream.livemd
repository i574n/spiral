  ///- --test

  listm.init 10i32 id
  |> from_list
  |> item 9i32
  |> _assert_eq 9
  """,
  timeout: 300_000
)
```

### new_infinite_stream

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"inl new_infinite_stream fn =\n    inl rec 루프 n =\n        StreamCons (fn n, fun () => 루프 (n + 1))\n    루프 0\n\ninl new_infinite_stream_ fn =\n    let rec 루프 n =\n        StreamCons (fn n, fun () => 루프 (n + 1))\n    루프 0","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  inl new_infinite_stream fn =
      inl rec 루프 n =
          StreamCons (fn n, fun () => 루프 (n + 1))
      루프 0

  inl new_infinite_stream_ fn =
      let rec 루프 n =
          StreamCons (fn n, fun () => 루프 (n + 1))
      루프 0
  """,
  timeout: 300_000
)
```

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"///- --test\n\nnew_infinite_stream print_and_return\n|> item 4i32\n|> _assert_eq 4i32","print_code":false},"livebook_object":"smart_cell"} -->

