### take_while

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"inl take_while cond s =\n    inl rec body i = function\n        | StreamCons (st, fn) when cond st i => StreamCons (st, fun () => 루프 (i + 1) (fn ()))\n        | _ => StreamNil\n    and inl 루프 i = join_body body i\n    루프 0 s","print_code":false},"livebook_object":"smart_cell"} -->

