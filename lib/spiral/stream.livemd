)
```

### new_finite_stream

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"inl new_finite_stream fn max =\n    inl rec 루프 n =\n        if n >= max\n        then StreamNil\n        else StreamCons (fn n, fun () => 루프 (n + 1))\n    루프 0","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  inl new_finite_stream fn max =
      inl rec 루프 n =
          if n >= max
          then StreamNil
          else StreamCons (fn n, fun () => 루프 (n + 1))
      루프 0
  """,
  timeout: 300_000
)
```

### memoize

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"union memoized_stream t =\n    | NotComputed : () -> stream t\n    | Computed : stream t\n\ninl memoize s =\n    inl rec body forall t. (s : () -> stream t) : () -> stream t =\n        inl state = mut (NotComputed s)\n        fun () =>\n            match *state with\n            | Computed x => x\n            | NotComputed fn =>\n                inl new_state =\n                    match fn () with\n                    | StreamNil => StreamNil\n                    | StreamCons (x, fn) => StreamCons (x, 루프 fn)\n                state <- Computed new_state\n                new_state\n    and inl 루프 forall t. (s' : () -> stream t) : () -> stream t =\n        join_body_unit body s s'\n    루프 (fun () => s)","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  union memoized_stream t =
      | NotComputed : () -> stream t
      | Computed : stream t

  inl memoize s =
      inl rec body forall t. (s : () -> stream t) : () -> stream t =
          inl state = mut (NotComputed s)
          fun () =>
              match *state with
              | Computed x => x
              | NotComputed fn =>
                  inl new_state =
                      match fn () with
                      | StreamNil => StreamNil
                      | StreamCons (x, fn) => StreamCons (x, 루프 fn)
                  state <- Computed new_state
                  new_state
      and inl 루프 forall t. (s' : () -> stream t) : () -> stream t =
          join_body_unit body s s'
      루프 (fun () => s)
  """,
  timeout: 300_000
)
```

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"///- --test\n\ninl memo_stream = new_finite_stream print_and_return 10 |> memoize\n\nmemo_stream ()\n|> item 3i32\n|> _assert_eq 3i32\n\nmemo_stream ()\n|> item 5i32\n|> _assert_eq 5i32","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  ///- --test

  inl memo_stream = new_finite_stream print_and_return 10 |> memoize

  memo_stream ()
  |> item 3i32
  |> _assert_eq 3i32

  memo_stream ()
  |> item 5i32
  |> _assert_eq 5i32
  """,
  timeout: 300_000
)
```

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"///- --test\n\ninl memo_stream = new_infinite_stream_ print_and_return |> memoize\n\nmemo_stream ()\n|> item 3i32\n|> _assert_eq 3i32\n\nmemo_stream ()\n|> item 5i32\n|> _assert_eq 5i32","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
