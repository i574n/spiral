### zip_with

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"inl zip_with fn s1 s2 =\n    inl rec 루프 s1 s2 =\n        match s1, s2 with\n        | StreamCons (st1, fn1), StreamCons (st2, fn2) =>\n            StreamCons (fn st1 st2, fun () => 루프 (fn1 ()) (fn2 ()))\n        | StreamNil, _ | _, StreamNil => StreamNil\n    루프 s1 s2\n\ninl zip_with_ fn s1 s2 =\n    let rec 루프 s1 s2 =\n        match s1, s2 with\n        | StreamCons (st1, fn1), StreamCons (st2, fn2) =>\n            StreamCons (fn st1 st2, fun () => 루프 (fn1 ()) (fn2 ()))\n        | StreamNil, _ | _, StreamNil => StreamNil\n    루프 s1 s2","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  inl zip_with fn s1 s2 =
      inl rec 루프 s1 s2 =
          match s1, s2 with
          | StreamCons (st1, fn1), StreamCons (st2, fn2) =>
              StreamCons (fn st1 st2, fun () => 루프 (fn1 ()) (fn2 ()))
          | StreamNil, _ | _, StreamNil => StreamNil
      루프 s1 s2

  inl zip_with_ fn s1 s2 =
      let rec 루프 s1 s2 =
          match s1, s2 with
          | StreamCons (st1, fn1), StreamCons (st2, fn2) =>
              StreamCons (fn st1 st2, fun () => 루프 (fn1 ()) (fn2 ()))
          | StreamNil, _ | _, StreamNil => StreamNil
      루프 s1 s2
  """,
  timeout: 300_000
)
```

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"///- --test\n\n((listm.init 10i32 id |> from_list), (listm.init 10i32 ((*) 2) |> from_list))\n||> zip_with (+)\n|> item 2i32\n|> _assert_eq 6","print_code":false},"livebook_object":"smart_cell"} -->

