### stream

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"union rec stream t =\n    | StreamCons : t * (() -> stream t)\n    | StreamNil","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  union rec stream t =
      | StreamCons : t * (() -> stream t)
      | StreamNil
  """,
  timeout: 300_000
)
```

### fold

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"inl fold fn init s =\n    inl rec body acc = function\n        | StreamCons (st, fn') => 루프 (fn acc st) (fn' ())\n        | StreamNil => acc\n    and inl 루프 acc = join_body body acc\n    루프 init s","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  inl fold fn init s =
      inl rec body acc = function
          | StreamCons (st, fn') => 루프 (fn acc st) (fn' ())
          | StreamNil => acc
      and inl 루프 acc = join_body body acc
      루프 init s
  """,
  timeout: 300_000
)
```

### fold_back

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"inl fold_back fn s init =\n    inl rec body acc = function\n        | StreamCons (st, fn') => fn st (루프 acc (fn' ()))\n        | StreamNil => acc\n    and inl 루프 acc = join_body body acc\n    루프 init s","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  inl fold_back fn s init =
      inl rec body acc = function
          | StreamCons (st, fn') => fn st (루프 acc (fn' ()))
          | StreamNil => acc
      and inl 루프 acc = join_body body acc
      루프 init s
  """,
  timeout: 300_000
)
```

