/// # stream
test stream static =
    :< testing

:< rust.rust_operators

/// ## stream

/// ### stream
:| ^ stream t =
    | StreamCons : t * (() -> stream t)
    | StreamNil

/// ### fold
:= fold fn init s =
    := ^ body acc = \|
        | StreamCons (st, fn') => 루프 (fn acc st) (fn' ())
        | StreamNil => acc
    :& := 루프 acc = join_body body acc
    루프 init s

/// ### fold_back
:= fold_back fn s init =
    := ^ body acc = \|
        | StreamCons (st, fn') => fn st (루프 acc (fn' ()))
        | StreamNil => acc
    :& := 루프 acc = join_body body acc
    루프 init s

/// ### to_list
:= to_list s =
    (s, [])
    ||> fold_back \ x acc =>
        x :: acc

/// ### rev
:= rev s =
    (StreamNil, s)
    ||> fold \ s x =>
        StreamCons (x, \ () => s)

/// ### from_list
:= from_list list =
    (list, StreamNil)
    ||> listm.foldBack \ x acc =>
        StreamCons (x, \ () => acc)

test from_list =
    listm.init 3i32 id
    |> from_list
    |> rev
    |> to_list
    |> _assert_eq [ 2; 1; 0 ]

/// ### try_item
:= try_item i s =
    := ^ body \* a {number} b. (i : a) : stream b -> option b = \|
        | StreamCons (x, _) ?& i <= 0 => Some x
        | StreamCons (_, fn) => 루프 (i - 1) (fn ())
        | StreamNil => None
    :& := 루프 \* a {number} b. (acc : a) (s' : stream b) : option b =
        ?= var_is acc, var_is s' ?|
        | !-, !- => body acc s'
        | _ =>
            := acc = dyn acc
            := s' = dyn s'
            ~~ body acc s'
    루프 i s

:= item i =
    try_item i >> optionm.value

test try_item =
    listm.init 10i32 id
    |> from_list
    |> item 9i32
    |> _assert_eq 9

/// ### new_infinite_stream
:= new_infinite_stream fn =
    := ^ 루프 n =
        StreamCons (fn n, \ () => 루프 (n + 1))
    루프 0

:= new_infinite_stream_ fn =
    :~ ^ 루프 n =
        StreamCons (fn n, \ () => 루프 (n + 1))
    루프 0

test new_infinite_stream =
    new_infinite_stream print_and_return
    |> item 4i32
    |> _assert_eq 4i32

/// ### new_finite_stream
:= new_finite_stream fn max =
    := ^ 루프 n =
        ? n >= max
        ?> StreamNil
        |: StreamCons (fn n, \ () => 루프 (n + 1))
    루프 0

/// ### memoize
:| memoized_stream t =
    | NotComputed : () -> stream t
    | Computed : stream t

:= memoize s =
    := ^ body \* t. (s : () -> stream t) : () -> stream t =
        := state = mut (NotComputed s)
        \ () =>
            ?= *state ?|
            | Computed x => x
            | NotComputed fn =>
                := new_state =
                    ?= fn () ?|
                    | StreamNil => StreamNil
                    | StreamCons (x, fn) => StreamCons (x, 루프 fn)
                state <- Computed new_state
                new_state
    :& := 루프 \* t. (s' : () -> stream t) : () -> stream t =
        join_body_unit body s s'
    루프 (\ () => s)

test memoize =
    := memo_stream = new_finite_stream print_and_return 10 |> memoize

    memo_stream ()
    |> item 3i32
    |> _assert_eq 3i32

    memo_stream ()
    |> item 5i32
    |> _assert_eq 5i32

test memoize_2 =
    := memo_stream = new_infinite_stream_ print_and_return |> memoize

    memo_stream ()
    |> item 3i32
    |> _assert_eq 3i32

    memo_stream ()
    |> item 5i32
    |> _assert_eq 5i32

/// ### unfold
:= unfold f x0 =
    := ^ body x =
        ?= f x ?|
        | Some (x', y) => StreamCons (x', \ () => 루프 y)
        | None => StreamNil
    :& := 루프 x = join_body_unit body x0 x
    루프 x0

/// ### iterate
:= iterate f =
    \ x => Some (x, f x)
    |> unfold

test iterate =
    iterate ((*) 2) 1i32
    |> item 10i32
    |> _assert_eq 1024

/// ### iterate'
:= iterate_map f m =
    \ x =>
        m x
        |> optionm.map \ x =>
            x, f x
    |> unfold

test iterate_2 =
    iterate_map ((*) 2) Some 1i32
    |> item 10i32
    |> _assert_eq 1024

/// ### take_while
:= take_while cond s =
    := ^ body i = \|
        | StreamCons (st, fn) ?& cond st i => StreamCons (st, \ () => 루프 (i + 1) (fn ()))
        | _ => StreamNil
    :& := 루프 i = join_body body i
    루프 0 s

/// ### sum
:= sum seq =
    seq |> fold (+) 0

test sum =
    listm.init 10i32 id
    |> from_list
    |> sum
    |> _assert_eq 45

test sum_2 =
    new_finite_stream print_and_return 10i32
    |> take_while (\ n (_ : i32) => n < 5)
    |> sum
    |> _assert_eq 10

test sum_3 =
    new_infinite_stream print_and_return
    |> take_while (\ n (_ : i32) => n < 5i32)
    |> sum
    |> _assert_eq 10

test sum_4 =
    iterate ((*) 6) 1i32
    |> take_while (\ _ i => i <= 7i32)
    |> to_list
    |> _assert_eq [ 1i32; 6; 36; 216; 1296; 7776; 46656; 279936 ]

/// ### indexed
:= indexed s =
    ((StreamNil, 0), s)
    ||> fold \ (acc, i) x =>
        StreamCons ((i, x), \ () => acc), i + 1
    |> fst
    |> rev

test indexed =
    listm.init 10i32 ((*) 2)
    |> from_list
    |> indexed
    |> item 5i32
    |> _assert_eq (5i32, 10i32)

/// ### map
:= map fn s =
    (s, StreamNil)
    ||> fold_back \ x acc =>
        StreamCons (fn x, \ () => acc)

test map =
    listm.init 10i32 id
    |> from_list
    |> map ((*) 2)
    |> item 5i32
    |> _assert_eq 10i32

/// ### zip_with
:= zip_with fn s1 s2 =
    := ^ 루프 s1 s2 =
        ?= s1, s2 ?|
        | StreamCons (st1, fn1), StreamCons (st2, fn2) =>
            StreamCons (fn st1 st2, \ () => 루프 (fn1 ()) (fn2 ()))
        | StreamNil, _ | _, StreamNil => StreamNil
    루프 s1 s2

:= zip_with_ fn s1 s2 =
    :~ ^ 루프 s1 s2 =
        ?= s1, s2 ?|
        | StreamCons (st1, fn1), StreamCons (st2, fn2) =>
            StreamCons (fn st1 st2, \ () => 루프 (fn1 ()) (fn2 ()))
        | StreamNil, _ | _, StreamNil => StreamNil
    루프 s1 s2

test zip_with =
    ((listm.init 10i32 id |> from_list), (listm.init 10i32 ((*) 2) |> from_list))
    ||> zip_with (+)
    |> item 2i32
    |> _assert_eq 6

/// ### zip
:= zip s1 s2 =
    zip_with pair s1 s2

:= zip_ s1 s2 =
    zip_with_ pair s1 s2

test zip =
    ((listm.init 10i32 id |> from_list), (listm.init 10i32 ((*) 2) |> from_list))
    ||> zip
    |> item 5i32
    |> _assert_eq (5, 10)

/// ### unzip
:= unzip s =
    := ^ body \* a b. (s : stream (a * b)) : stream a * stream b =
        ?= s ?|
        | StreamCons ((x, y), fn) =>
            := xs, ys = 루프 (fn ())
            StreamCons (x, \ () => xs), StreamCons (y, \ () => ys)
        | StreamNil => pair StreamNil StreamNil
    :& := 루프 \* a b. (x : stream (a * b)) : stream a * stream b =
        ? var_is x |> not
        ?> body x
        |:
            := x = dyn x
            ~~ body x
    루프 s

test unzip =
    listm.init 10i32 id
    |> listm.map (\ x => x, x)
    |> from_list
    |> unzip
    |> \ x, y =>
        x |> sum
        |> _assert_eq 45

        y |> sum
        |> _assert_eq 45

/// ## rust

/// ### io_error
:! io_error =
    `(
        rust.rust_type
            `($'std_io_Error')
            `($'std::io::Error')
            "type std_io_Error = string"
    )

/// ### new_io_error
:= new_io_error (text : string) : io_error =
    run_target_args (\ () => text) \|
        | Rust => \ text =>
            !\\(text, $'"std::io::Error::new(std::io::ErrorKind::Other, &*$0)"')
        | _ => \ text => text |> convert.unbox

/// ### buf_reader
:! buf_reader t =
    `(
        rust.rust_type
            `($'std_io_BufReader<`t>')
            `($'std::io::BufReader<`t>')
            "type std_io_BufReader<'T> = class end"
    )

/// ### cursor
:! cursor t =
    `(
        rust.rust_type
            `($'std_io_Cursor<`t>')
            `($'std::io::Cursor<`t>')
            "type std_io_Cursor<'T> = class end"
    )

/// ### buf_reader_tokio
:! buf_reader_tokio t =
    `(
        rust.rust_type
            `($'tokio_io_BufReader<`t>')
            `($'tokio::io::BufReader<`t>')
            "type tokio_io_BufReader<'T> = class end"
    )

/// ### new_buf_reader
:= new_buf_reader \* t. (x : t) : buf_reader t =
    !\\(x, $'"std::io::BufReader::new($0)"')

/// ### new_cursor
:= new_cursor \* t. (x : t) : cursor t =
    !\($'"std::io::Cursor::new(!x)"')

/// ### lines
:! lines t =
    `(
        rust.rust_type
            `($'std_io_Lines<`t>')
            `($'std::io::Lines<`t>')
            "type std_io_Lines<'T> = class end"
    )

/// ### buf_read_lines
:= buf_read_lines \* t. (buf_reader : buf_reader t) : lines (buf_reader t) =
    !\($'"std::io::BufRead::lines(!buf_reader)"')

/// ### decode_reader_bytes
:! decode_reader_bytes t u =
    `(
        rust.rust_type
            `($'encoding_rs_io_DecodeReaderBytes<`t, `u>')
            `($'encoding_rs_io::DecodeReaderBytes<`t, `u>')
            "type encoding_rs_io_DecodeReaderBytes<'T, 'U> = class end"
    )

/// ### decode_reader_bytes_build
:= decode_reader_bytes_build \* t. (x : t) : decode_reader_bytes t (am'.vec u8) =
    !\\(x, $'"encoding_rs_io::DecodeReaderBytesBuilder::new().utf8_passthru(true).build($0)"')

/// ### buf_reader_read
:= buf_reader_read \* el dim.
    (slice : am'.slice' el dim) (buf_reader : buf_reader el) : resultm.result' convert.unativeint io_error
    =
    (!\($'"true; let mut !slice = !slice"') : bool) |> ignore
    !\($'"std::io::Read::read(&mut !buf_reader, &mut !slice)"')

/// ### io_read_by_ref
:= io_read_by_ref \* t. (lines : lines t) : lines t =
    !\\(lines, $'"std::io::Read::by_ref($0)"')
