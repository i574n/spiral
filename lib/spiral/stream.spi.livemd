#### new_infinite_stream (test)

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":"///- --test --symbol\n\nnew_infinite_stream print_and_return\n|> item 4i32\n|> _assert_eq 4i32","print_code":false},"livebook_object":"smart_cell"} -->

