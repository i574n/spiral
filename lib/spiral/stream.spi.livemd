<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":":< rust_operators\n\n:| ^ stream t =\n    | StreamCons : t * (() -> stream t)\n    | StreamNil\n\n:= fold fn init s =\n    := ^ body acc = \\|\n        | StreamCons (st, fn') => 루프 (fn acc st) (fn' ())\n        | StreamNil => acc\n    :& := 루프 acc = join_body body acc\n    루프 init s\n\n:= fold_back fn s init =\n    := ^ body acc = \\|\n        | StreamCons (st, fn') => fn st (루프 acc (fn' ()))\n        | StreamNil => acc\n    :& := 루프 acc = join_body body acc\n    루프 init s\n\n:= to_list s =\n    (s, [])\n    ||> fold_back \\ x acc =>\n        x :: acc\n\n:= rev s =\n    (StreamNil, s)\n    ||> fold \\ s x =>\n        StreamCons (x, \\ () => s)\n\n:= from_list list =\n    (list, StreamNil)\n    ||> listm::foldBack \\ x acc =>\n        StreamCons (x, \\ () => acc)","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  :< rust_operators

  :| ^ stream t =
      | StreamCons : t * (() -> stream t)
      | StreamNil

  := fold fn init s =
      := ^ body acc = \|
          | StreamCons (st, fn') => 루프 (fn acc st) (fn' ())
          | StreamNil => acc
      :& := 루프 acc = join_body body acc
      루프 init s

  := fold_back fn s init =
      := ^ body acc = \|
          | StreamCons (st, fn') => fn st (루프 acc (fn' ()))
          | StreamNil => acc
      :& := 루프 acc = join_body body acc
      루프 init s

  := to_list s =
      (s, [])
      ||> fold_back \ x acc =>
          x :: acc

  := rev s =
      (StreamNil, s)
      ||> fold \ s x =>
          StreamCons (x, \ () => s)

  := from_list list =
      (list, StreamNil)
      ||> listm::foldBack \ x acc =>
          StreamCons (x, \ () => acc)
  """,
  timeout: 300_000
)
```

