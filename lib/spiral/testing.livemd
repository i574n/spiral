### testing_trace

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"union testing_trace =\n    | Console\n    | Trace\n    | TraceRaw\n    | Silent","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  union testing_trace =
      | Console
      | Trace
      | TraceRaw
      | Silent
  """,
  timeout: 300_000
)
```

### __expect

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"inl rec __expect\n    (fn : _ -> _ -> bool)\n    (trace' : testing_trace)\n    (name : string)\n    (b : _)\n    (a : _)\n    : ()\n    =\n    inl result = fn a b\n    inl get_data () =\n        if result\n        then #?{ expected = b }\n        else #?{ actual = a; expected = b }\n    inl get_raw_text () =\n        inl data = get_data ()\n        name ++# \" \" ++# get_data ()\n    inl result =\n        result || join result\n    match trace' with\n    | Console =>\n        inl text = get_raw_text ()\n        text |> console.write_line\n        text\n    | Trace =>\n        trace Info (fun () => name) get_data\n        get_raw_text ()\n    | TraceRaw =>\n        inl text = get_raw_text ()\n        trace_raw Info fun () => text\n        text\n    | Silent => reflection.nameof { __expect }\n    |> assert result","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  inl rec __expect
      (fn : _ -> _ -> bool)
      (trace' : testing_trace)
      (name : string)
      (b : _)
      (a : _)
      : ()
      =
      inl result = fn a b
      inl get_data () =
          if result
          then #?{ expected = b }
          else #?{ actual = a; expected = b }
      inl get_raw_text () =
          inl data = get_data ()
          name ++# " " ++# get_data ()
      inl result =
          result || join result
      match trace' with
      | Console =>
          inl text = get_raw_text ()
          text |> console.write_line
          text
      | Trace =>
          trace Info (fun () => name) get_data
          get_raw_text ()
      | TraceRaw =>
          inl text = get_raw_text ()
          trace_raw Info fun () => text
          text
      | Silent => reflection.nameof { __expect }
      |> assert result
  """,
  timeout: 300_000
)
```

### __assert_approx_eq

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"inl rec __assert_approx_eq trace e b a =\n    __expect\n        (fun a b => abs (b - a) < (e |> optionm.defaultWith 0.00000001))\n        trace\n        (reflection.nameof { __assert_approx_eq })\n        b\n        a\n\ninl _assert_approx_eq e b a =\n    __assert_approx_eq Console e b a","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  inl rec __assert_approx_eq trace e b a =
      __expect
          (fun a b => abs (b - a) < (e |> optionm.defaultWith 0.00000001))
          trace
          (reflection.nameof { __assert_approx_eq })
          b
          a

  inl _assert_approx_eq e b a =
      __assert_approx_eq Console e b a
  """,
  timeout: 300_000
)
```

