### __assert_between

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"inl rec __assert_between trace a b actual =\n    inl assert_between actual (a, b) =\n        __assert_ge Silent a actual\n        __assert_le Silent b actual\n        true\n    __expect assert_between trace (reflection.nameof { __assert_between }) (a, b) actual\n\ninl _assert_between a b actual =\n    __assert_between Console a b actual","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  inl rec __assert_between trace a b actual =
      inl assert_between actual (a, b) =
          __assert_ge Silent a actual
          __assert_le Silent b actual
          true
      __expect assert_between trace (reflection.nameof { __assert_between }) (a, b) actual

  inl _assert_between a b actual =
      __assert_between Console a b actual
  """,
  timeout: 300_000
)
```

### _assert_fn

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"inl rec _assert_fn fn list =\n    list\n    |> listm.rev\n    |> listm.map fun input, expected => join\n        input\n        |> fn\n        |> resultm.get\n        |> fun x =>\n            inl expected' = join expected\n            inl name = reflection.nameof { _assert_fn }\n            try\n                fun () =>\n                    console.write_line \"\"\n                    trace Verbose\n                        fun () => name\n                        fun () => { input }\n                    #?x\n                    |> _assert_eq #?expected'\n                    true\n                fun ex =>\n                    trace Critical\n                        fun () => name ++# \" / error\"\n                        fun () => { ex expected }\n                    Some false\n            |> optionm.value\n    |> listm'.filter not\n    |> function\n        | [] => ()\n        | x => #?*x |> failwith","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  inl rec _assert_fn fn list =
      list
      |> listm.rev
      |> listm.map fun input, expected => join
          input
          |> fn
          |> resultm.get
          |> fun x =>
              inl expected' = join expected
              inl name = reflection.nameof { _assert_fn }
              try
                  fun () =>
                      console.write_line ""
                      trace Verbose
                          fun () => name
                          fun () => { input }
                      #?x
                      |> _assert_eq #?expected'
                      true
                  fun ex =>
                      trace Critical
                          fun () => name ++# " / error"
                          fun () => { ex expected }
                      Some false
              |> optionm.value
      |> listm'.filter not
      |> function
          | [] => ()
          | x => #?*x |> failwith
  """,
  timeout: 300_000
)
```

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"///- --test\n///> gleam\n///> fsharp\n///> cuda\n///> rust\n///> typescript\n\n[\n    3i32,\n    2i32\n\n    2,\n    1\n]\n|> _assert_fn fun x =>\n    x - 1\n    |> Ok\n    |> fun x => x : _ _ ()","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  ///- --test
  ///> gleam
  ///> fsharp
  ///> cuda
  ///> rust
  ///> typescript

  [
      3i32,
      2i32

      2,
      1
  ]
  |> _assert_fn fun x =>
      x - 1
      |> Ok
      |> fun x => x : _ _ ()
  """,
  timeout: 300_000
)
```

### _assert_in

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"inl _assert_in items x =\n    (None, items)\n    ||> listm.fold fun acc x' =>\n        match acc with\n        | Some x => Some x\n        | None =>\n            if x' <>. x\n            then None\n            else\n                trace Debug (fun () => \"_assert_in\") fun () => { x x' }\n                Some ()\n    |> function\n        | Some _ => ()\n        | None =>\n            \"_assert_in / \" ++#? { x items } |> failwith","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  inl _assert_in items x =
      (None, items)
      ||> listm.fold fun acc x' =>
          match acc with
          | Some x => Some x
          | None =>
              if x' <>. x
              then None
              else
                  trace Debug (fun () => "_assert_in") fun () => { x x' }
                  Some ()
      |> function
          | Some _ => ()
          | None =>
              "_assert_in / " ++#? { x items } |> failwith
  """,
  timeout: 300_000
)
```

## fsharp

