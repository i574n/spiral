### _throws

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"inl _throws (fn : () -> ()) : option exn =\n    inl none = None : option exn\n    inl some (s : exn) = Some s\n    inl native =\n        backend_switch {\n            Gleam = fun () => false\n            Lua = fun () => false\n            Fsharp = fun () => false\n            Python = fun () => false\n            TypeScript = fun () => false\n            Cpp = fun () => false\n            CppHost = fun () => false\n            Delphi = fun () => false\n            Cuda = fun () => false\n            Rust = fun () => true\n        }\n    if native\n    then\n        // Native Rust: a panic is the exception (base.catch_unwind_native: its panic report is suppressed).\n        catch_unwind_native\n            fun () =>\n                fn ()\n                none\n            some\n    else\n        backend_switch {\n            Fsharp = fun () =>\n                $'try !fn (); !none with ex -> ex |> !some ' : option exn\n            Python = fun () =>\n                $'fn = !fn '\n                $'none = !none '\n                $'some = !some '\n                $'try: fn(); x = none '\n                $'except Exception as ex: x = some(ex)'\n                $'x' : option exn\n            TypeScript = fun () =>\n                $'(() => { try { !fn(); return !none; } catch (ex) { return !some(ex); } })()' : option exn\n        }","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  inl _throws (fn : () -> ()) : option exn =
      inl none = None : option exn
      inl some (s : exn) = Some s
      inl native =
          backend_switch {
              Gleam = fun () => false
              Lua = fun () => false
              Fsharp = fun () => false
              Python = fun () => false
              TypeScript = fun () => false
              Cpp = fun () => false
              CppHost = fun () => false
              Delphi = fun () => false
              Cuda = fun () => false
              Rust = fun () => true
          }
      if native
      then
          // Native Rust: a panic is the exception (base.catch_unwind_native: its panic report is suppressed).
          catch_unwind_native
              fun () =>
                  fn ()
                  none
              some
      else
          backend_switch {
              Fsharp = fun () =>
                  $'try !fn (); !none with ex -> ex |> !some ' : option exn
              Python = fun () =>
                  $'fn = !fn '
                  $'none = !none '
                  $'some = !some '
                  $'try: fn(); x = none '
                  $'except Exception as ex: x = some(ex)'
                  $'x' : option exn
              TypeScript = fun () =>
                  $'(() => { try { !fn(); return !none; } catch (ex) { return !some(ex); } })()' : option exn
          }
  """,
  timeout: 300_000
)
```

### print_and_return

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"inl rec print_and_return x =\n    inl name = reflection.nameof { print_and_return }\n    name ++#? { x }\n    |> console.write_line\n    x","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  inl rec print_and_return x =
      inl name = reflection.nameof { print_and_return }
      name ++#? { x }
      |> console.write_line
      x
  """,
  timeout: 300_000
)
```
