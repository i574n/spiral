### __assert_contains

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"inl rec __assert_contains forall t u. (trace : testing_trace) (b : t) (a : u) : () =\n    inl native =\n        backend_switch {\n            Gleam = fun () => false\n            Lua = fun () => false\n            Fsharp = fun () => false\n            Python = fun () => false\n            TypeScript = fun () => false\n            Cpp = fun () => false\n            CppHost = fun () => false\n            Delphi = fun () => false\n            Cuda = fun () => false\n            Rust = fun () => true\n        }\n    __expect\n        fun a b =>\n            if native\n            then\n                // native Rust: a string contains a char, an array (`Rc<RefCell<Vec<T>>>`) or a list/seq (`Rc<Vec<T>>`) an\n                // element equal to it (the element type's PartialEq)\n                real\n                    typecase u with\n                    | string =>\n                        // a native char is a `u8`; a string in a string: a substring\n                        typecase t with\n                        | char => $'!a.contains(!b as char)' : bool\n                        | _ => $'!a.contains(&*!b)' : bool\n                    | array_base _ => $'!a.borrow().contains(&!b)' : bool\n                    | _ => $'!a.iter().any(|x| *x == !b)' : bool\n            else\n                a\n                |> $'List.ofSeq'\n                |> fun x => x : listm'.list' t\n                |> $'List.tryFind' ((=) b)\n                |> optionm'.unbox\n                |> fun (x : option t) => x <> None\n        trace\n        // TODO: forall nameof (Cannot dyn a forall into a runtime var.)\n        // Metavars that are not part of the enclosing function's signature are not allowed. They need to be values.\n        // Got: {__assert_contains : testing_trace -> _ -> _ -> ()} -> string\n        // (reflection.nameof { __assert_contains })\n        \"__assert_contains\"\n        b\n        a\n\ninl _assert_contains b a =\n    __assert_contains Console b a","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  inl rec __assert_contains forall t u. (trace : testing_trace) (b : t) (a : u) : () =
      inl native =
          backend_switch {
              Gleam = fun () => false
              Lua = fun () => false
              Fsharp = fun () => false
              Python = fun () => false
              TypeScript = fun () => false
              Cpp = fun () => false
              CppHost = fun () => false
              Delphi = fun () => false
              Cuda = fun () => false
              Rust = fun () => true
          }
      __expect
          fun a b =>
              if native
              then
                  // native Rust: a string contains a char, an array (`Rc<RefCell<Vec<T>>>`) or a list/seq (`Rc<Vec<T>>`) an
                  // element equal to it (the element type's PartialEq)
                  real
                      typecase u with
                      | string =>
                          // a native char is a `u8`; a string in a string: a substring
                          typecase t with
                          | char => $'!a.contains(!b as char)' : bool
                          | _ => $'!a.contains(&*!b)' : bool
                      | array_base _ => $'!a.borrow().contains(&!b)' : bool
                      | _ => $'!a.iter().any(|x| *x == !b)' : bool
              else
                  a
                  |> $'List.ofSeq'
                  |> fun x => x : listm'.list' t
                  |> $'List.tryFind' ((=) b)
                  |> optionm'.unbox
                  |> fun (x : option t) => x <> None
          trace
          // TODO: forall nameof (Cannot dyn a forall into a runtime var.)
          // Metavars that are not part of the enclosing function's signature are not allowed. They need to be values.
          // Got: {__assert_contains : testing_trace -> _ -> _ -> ()} -> string
          // (reflection.nameof { __assert_contains })
          "__assert_contains"
          b
          a

  inl _assert_contains b a =
      __assert_contains Console b a
  """,
  timeout: 300_000
)
```

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"///- --test\n\n;[ \"a\"; \"b\"; \"c\" ]\n|> _assert_contains \"b\"","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  ///- --test

  ;[ "a"; "b"; "c" ]
  |> _assert_contains "b"
  """,
  timeout: 300_000
)
```

