:< sm'_operators

:| testing_trace =
    | Console
    | Trace
    | TraceRaw
    | Silent

:= __expect_data (result : bool) b a () : string =
    ? result
    ?> sm'::show { expected = b }
    |: sm'::show { actual = a; expected = b }

:= __expect_text (name : string) (get_data : () -> string) : string =
    := data = get_data ()
    name ++# " " ++# get_data ()

:= __expect_console (text : string) : string =
    text |> console::write_line
    text

:= __expect_traced (name : string) (get_data : () -> string) : string =
    trace Info (\ () => name) get_data
    __expect_text name get_data

:= __expect_raw (text : string) : string =
    trace_raw Info \ () => text
    text

:= __expect_report (trace' : testing_trace) (name : string) (silent : string) (get_data : () -> string) : string =
    ?= trace' ?|
    | Console => __expect_console (__expect_text name get_data)
    | Trace => __expect_traced name get_data
    | TraceRaw => __expect_raw (__expect_text name get_data)
    | Silent => silent

:= ^ __expect
    (fn : _ -> _ -> bool)
    (trace' : testing_trace)
    (name : string)
    (b : _)
    (a : _)
    : ()
    =
    := result = fn a b
    := get_data () = __expect_data result b a ()
    := result =
        result || ~~ result
    __expect_report trace' name (reflection::nameof { __expect }) get_data
    |> assert result

:= ^ __assert_approx_eq trace e b a =
    __expect
        \ a b => abs (b - a) < (e |> optionm::defaultWith 0.00000001)
        trace
        (reflection::nameof { __assert_approx_eq })
        b
        a

:= _assert_approx_eq e b a =
    __assert_approx_eq Console e b a

///> gleam
///> cuda
///> rust
///> typescript
:# assert_approx_eq =
    12.345f64
    |> _assert_approx_eq (Some 0.0001f64) 12.345f64

///> zig
:# assert_approx_eq_2 print_code =
    1f64
    |> __assert_approx_eq Console (Some 3) 2

///> zig
:# assert_approx_eq_3 print_code =
    (dyn 1f64)
    |> _assert_approx_eq (Some 3) 2

:= ^ __assert_eq trace b a =
    __expect (=) trace (reflection::nameof { __assert_eq }) b a

:= _assert_eq b a =
    __assert_eq Console b a

:= ^ __assert_eq' \* t. (trace : testing_trace) (b : t) (a : t) : () =
    __expect
        \ a b => #?a = #?b
        trace
        (reflection::nameof { __assert_eq' = __assert_eq' : _ -> t -> t -> () })
        b
        a

:= _assert_eq' b a =
    __assert_eq' Console b a

:= ^ __assert_eq'' trace b a =
    __expect (=.) trace (reflection::nameof { __assert_eq'' }) b a

:= _assert_eq'' b a =
    __assert_eq'' Console b a

:= ^ __assert_ne trace b a =
    __expect (<>.) trace (reflection::nameof { __assert_ne }) b a

:= _assert_ne b a =
    __assert_ne Console b a

:= ^ __assert_gt trace b a =
    __expect (>) trace (reflection::nameof { __assert_gt }) b a

:= _assert_gt b a =
    __assert_gt Console b a

:= ^ __assert_ge trace b a =
    __expect (>=) trace (reflection::nameof { __assert_ge }) b a

:= _assert_ge b a =
    __assert_ge Console b a

:= ^ __assert_lt trace b a =
    __expect (<) trace (reflection::nameof { __assert_lt }) b a

:= _assert_lt b a =
    __assert_lt Console b a

:= ^ __assert_le trace b a =
    __expect (<=) trace (reflection::nameof { __assert_le }) b a

:= _assert_le b a =
    __assert_le Console b a

:= ^ __assert fn trace b a =
    __expect fn trace (reflection::nameof { __assert }) a b

:= _assert fn b a =
    __assert fn Console b a

:= ^ __assert_between trace a b actual =
    := assert_between actual (a, b) =
        __assert_ge Silent a actual
        __assert_le Silent b actual
        !+
    __expect assert_between trace (reflection::nameof { __assert_between }) (a, b) actual

:= _assert_between a b actual =
    __assert_between Console a b actual

:= __assert_fn_ok (name : string) input expected' x () =
    console::write_line ""
    trace Verbose
        \ () => name
        \ () => { input }
    sm'::show x
    |> _assert_eq (sm'::show expected')
    !+

:= __assert_fn_error (name : string) expected ex =
    trace Critical
        \ () => name ++# " / error"
        \ () => { ex expected }
    Some !-

:= __assert_fn_check (name : string) input expected expected' x =
    try (\ () => __assert_fn_ok name input expected' x ()) (\ ex => __assert_fn_error name expected ex)
    |> optionm::value

:= __assert_fn_failures results =
    ?= results |> listm'::filter not ?|
    | [] => ()
    | x => #?*x |> failwith

:= ^ _assert_fn fn list =
    := name = reflection::nameof { _assert_fn }
    list
    |> listm::rev
    |> listm::map \ input, expected => ~~
        input |> fn |> resultm::get |> __assert_fn_check name input expected (~~ expected)
    |> \ results => __assert_fn_failures results

///> gleam
///> cuda
///> rust
///> typescript
:# assert_fn =
    [
        3i32,
        2i32

        2,
        1
    ]
    |> _assert_fn \ x =>
        x - 1
        |> Ok
        |> \ x => x : _ _ ()

:= __assert_in_step x acc x' =
    ?= acc ?|
    | Some x => Some x
    | None =>
        ? x' <>. x
        ?> None
        |:
            trace Debug (\ () => "_assert_in") \ () => { x x' }
            Some ()

:= _assert_in items x =
    (None, items)
    ||> listm::fold \ acc x' => __assert_in_step x acc x'
    |> \|
        | Some _ => ()
        | None =>
            "_assert_in / " ++#? { x items } |> failwith

:= __contains_rust_text \* t u. (a : u) (b : t) : bool =
    ~>
        ?: t ?|
        | char => $'!a.contains(char::from(!b))' : bool
        | _ => $'!a.contains(&*!b)' : bool

:= __contains_rust_items \* t u. (a : u) (b : t) : bool =
    ~>
        ?: u ?|
        | array_base _ => $'!a.borrow().contains(&!b)' : bool
        | _ => $'!a.iter().any(|x| *x == !b)' : bool

:= __contains_rust \* t u. (a : u) (b : t) : bool =
    ? (~> ?: u ?| string => !+ | _ => !-) ?> __contains_rust_text a b |: __contains_rust_items a b

:= __contains_zig_same \* t. (b : t) (item : t) : bool =
    ? (~> ?: t ?| string => !+ | _ => !-)
    ?> $'std.mem.eql(u8, !item, !b)' : bool
    |: $'(!item == !b)' : bool

:= __contains_zig_scan \* t u. (a : u) (b : t) : bool =
    := len : i32 = $'@@as(i32, @@intCast(!a.len))'
    :~ ^ scan (i : i32) : bool =
        ? i >= len
        ?> !-
        |? __contains_zig_same b ($'!a[@@intCast(!i)]' : t)
        ?> !+
        |: scan (i + 1i32)
    scan 0i32

:= __contains_zig \* t u. (a : u) (b : t) : bool =
    ? (~> ?: u ?| string => !+ | _ => !-) ?>
        ~>
            ?: t ?|
            | char => $'(std.mem.indexOfScalar(u8, !a, !b) \!= null)' : bool
            | _ => $'(std.mem.indexOf(u8, !a, !b) \!= null)' : bool
    |: __contains_zig_scan a b

:= __contains_seq \* t u. (a : u) (b : t) : bool =
    a
    |> $'List.ofSeq'
    |> \ x => x : listm'::list' t
    |> $'List.tryFind' ((=) b)
    |> optionm'::unbox
    |> \ (x : option t) => x <> None

:= ^ __assert_contains \* t u. (trace : testing_trace) (b : t) (a : u) : () =
    __expect
        \ a b =>
            run_target \|
                | Rust => \ () => __contains_rust a b
                | Zig => \ () => __contains_zig a b
                | _ => \ () => __contains_seq a b
        trace
        "__assert_contains"
        b
        a

:= _assert_contains b a =
    __assert_contains Console b a

///> zig
:# assert_contains =
    ;[ "a"; "b"; "c" ]
    |> _assert_contains "b"

///> zig
///> rust
:# assert_contains_2 =
    "abcd"
    |> _assert_contains 'b'

:= _throws (fn : () -> ()) : option exn =
    := none = None : option exn
    := caught (ex : exn) : option (option exn) = Some (Some ex)
    try
        \ () =>
            fn ()
            none
        caught
    |> optionm::value

:= ^ print_and_return x =
    := name = reflection::nameof { print_and_return }
    name ++#? { x }
    |> console::write_line
    x

:~ ^ counterexamples_scan (hi : i64) (reference : i64 -> i64) (candidate : i64 -> i64) (x : i64) (left : i32) (found : list i64) : list i64 =
    ? x > hi
    ?> found
    |? left <= 0i32
    ?> found
    |? reference x = candidate x
    ?> counterexamples_scan hi reference candidate (x + 1i64) left found
    |: counterexamples_scan hi reference candidate (x + 1i64) (left - 1i32) (x :: found)

:= counterexamples (limit : i32) (lo : i64) (hi : i64) (reference : i64 -> i64) (candidate : i64 -> i64) : list i64 =
    counterexamples_scan hi reference candidate lo limit [] |> listm::rev

:= __counterexamples_of_multiply_shift (limit : i32) (hi : i64) : list i64 =
    counterexamples limit 0i64 hi (\ x => x / 3i64) (\ x => (x * 43691i64) >>> 17i32)

///> zig
:# counterexamples_find_where_multiply_shift_stops_dividing_by_three =
    __counterexamples_of_multiply_shift 3i32 65535i64 |> listm::length |> _assert_eq 0i32

///> zig
:# counterexamples_list_the_first_two_misses_above_65535 =
    __counterexamples_of_multiply_shift 2i32 200000i64
    |> listm::fold (\ packed x => packed * 1000000i64 + x) 0i64
    |> \ packed => (packed = 131072131075i64) |> _assert_eq !+

:= expect (condition : bool) (detail : string) : () = ? condition ?> () |: failwith detail

///> rust
:# expect_is_silent_when_its_condition_holds =
    expect (1i32 + 1i32 = 2i32) "arithmetic"
    expect ("ab" <> "") "a non-empty string"
