<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":":= ^ __assert_eq trace b a =\n    __expect (=) trace (reflection::nameof { __assert_eq }) b a\n\n:= _assert_eq b a =\n    __assert_eq Console b a\n\n:= ^ __assert_eq' \\* t. (trace : testing_trace) (b : t) (a : t) : () =\n    __expect\n        \\ a b => #?a = #?b\n        trace\n        (reflection::nameof { __assert_eq' = __assert_eq' : _ -> t -> t -> () })\n        b\n        a\n\n:= _assert_eq' b a =\n    __assert_eq' Console b a\n\n:= ^ __assert_eq'' trace b a =\n    __expect (=.) trace (reflection::nameof { __assert_eq'' }) b a\n\n:= _assert_eq'' b a =\n    __assert_eq'' Console b a\n\n:= ^ __assert_ne trace b a =\n    __expect (<>.) trace (reflection::nameof { __assert_ne }) b a\n\n:= _assert_ne b a =\n    __assert_ne Console b a\n\n:= ^ __assert_gt trace b a =\n    __expect (>) trace (reflection::nameof { __assert_gt }) b a\n\n:= _assert_gt b a =\n    __assert_gt Console b a\n\n:= ^ __assert_ge trace b a =\n    __expect (>=) trace (reflection::nameof { __assert_ge }) b a\n\n:= _assert_ge b a =\n    __assert_ge Console b a\n\n:= ^ __assert_lt trace b a =\n    __expect (<) trace (reflection::nameof { __assert_lt }) b a\n\n:= _assert_lt b a =\n    __assert_lt Console b a\n\n:= ^ __assert_le trace b a =\n    __expect (<=) trace (reflection::nameof { __assert_le }) b a\n\n:= _assert_le b a =\n    __assert_le Console b a\n\n:= ^ __assert fn trace b a =\n    __expect fn trace (reflection::nameof { __assert }) a b\n\n:= _assert fn b a =\n    __assert fn Console b a\n\n:= ^ __assert_between trace a b actual =\n    := assert_between actual (a, b) =\n        __assert_ge Silent a actual\n        __assert_le Silent b actual\n        !+\n    __expect assert_between trace (reflection::nameof { __assert_between }) (a, b) actual\n\n:= _assert_between a b actual =\n    __assert_between Console a b actual\n\n:= ^ _assert_fn fn list =\n    list\n    |> listm::rev\n    |> listm::map \\ input, expected => ~~\n        input\n        |> fn\n        |> resultm::get\n        |> \\ x =>\n            := expected' = ~~ expected\n            := name = reflection::nameof { _assert_fn }\n            try\n                \\ () =>\n                    console::write_line \"\"\n                    trace Verbose\n                        \\ () => name\n                        \\ () => { input }\n                    sm'::show x\n                    |> _assert_eq (sm'::show expected')\n                    !+\n                \\ ex =>\n                    trace Critical\n                        \\ () => name ++# \" / error\"\n                        \\ () => { ex expected }\n                    Some !-\n            |> optionm::value\n    |> listm'::filter not\n    |> \\|\n        | [] => ()\n        | x => #?*x |> failwith","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  := ^ __assert_eq trace b a =
      __expect (=) trace (reflection::nameof { __assert_eq }) b a

  := _assert_eq b a =
      __assert_eq Console b a

  := ^ __assert_eq' \* t. (trace : testing_trace) (b : t) (a : t) : () =
      __expect
          \ a b => #?a = #?b
          trace
          (reflection::nameof { __assert_eq' = __assert_eq' : _ -> t -> t -> () })
          b
          a

  := _assert_eq' b a =
      __assert_eq' Console b a

  := ^ __assert_eq'' trace b a =
      __expect (=.) trace (reflection::nameof { __assert_eq'' }) b a

  := _assert_eq'' b a =
      __assert_eq'' Console b a

  := ^ __assert_ne trace b a =
      __expect (<>.) trace (reflection::nameof { __assert_ne }) b a

  := _assert_ne b a =
      __assert_ne Console b a

  := ^ __assert_gt trace b a =
      __expect (>) trace (reflection::nameof { __assert_gt }) b a

  := _assert_gt b a =
      __assert_gt Console b a

  := ^ __assert_ge trace b a =
      __expect (>=) trace (reflection::nameof { __assert_ge }) b a

  := _assert_ge b a =
      __assert_ge Console b a

  := ^ __assert_lt trace b a =
      __expect (<) trace (reflection::nameof { __assert_lt }) b a

  := _assert_lt b a =
      __assert_lt Console b a

  := ^ __assert_le trace b a =
      __expect (<=) trace (reflection::nameof { __assert_le }) b a

  := _assert_le b a =
      __assert_le Console b a

  := ^ __assert fn trace b a =
      __expect fn trace (reflection::nameof { __assert }) a b

  := _assert fn b a =
      __assert fn Console b a

  := ^ __assert_between trace a b actual =
      := assert_between actual (a, b) =
          __assert_ge Silent a actual
          __assert_le Silent b actual
          !+
      __expect assert_between trace (reflection::nameof { __assert_between }) (a, b) actual

  := _assert_between a b actual =
      __assert_between Console a b actual

  := ^ _assert_fn fn list =
      list
      |> listm::rev
      |> listm::map \ input, expected => ~~
          input
          |> fn
          |> resultm::get
          |> \ x =>
              := expected' = ~~ expected
              := name = reflection::nameof { _assert_fn }
              try
                  \ () =>
                      console::write_line ""
                      trace Verbose
                          \ () => name
                          \ () => { input }
                      sm'::show x
                      |> _assert_eq (sm'::show expected')
                      !+
                  \ ex =>
                      trace Critical
                          \ () => name ++# " / error"
                          \ () => { ex expected }
                      Some !-
              |> optionm::value
      |> listm'::filter not
      |> \|
          | [] => ()
          | x => #?*x |> failwith
  """,
  timeout: 300_000
)
```

