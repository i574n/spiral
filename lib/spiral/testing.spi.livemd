<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":":= _assert_in items x =\n    (None, items)\n    ||> listm::fold \\ acc x' =>\n        ?= acc ?|\n        | Some x => Some x\n        | None =>\n            ? x' <>. x\n            ?> None\n            |:\n                trace Debug (\\ () => \"_assert_in\") \\ () => { x x' }\n                Some ()\n    |> \\|\n        | Some _ => ()\n        | None =>\n            \"_assert_in / \" ++#? { x items } |> failwith\n\n:= ^ __assert_contains \\* t u. (trace : testing_trace) (b : t) (a : u) : () =\n    __expect\n        \\ a b =>\n            run_target \\|\n                | Rust => \\ () =>\n                    := found : bool =\n                        ~>\n                            ?: u ?|\n                            | string =>\n                                ?: t ?|\n                                | char => $'!a.contains(char::from(!b))' : bool\n                                | _ => $'!a.contains(&*!b)' : bool\n                            | array_base _ => $'!a.borrow().contains(&!b)' : bool\n                            | _ => $'!a.iter().any(|x| *x == !b)' : bool\n                    found\n                | Zig => \\ () =>\n                    ? (~> ?: u ?| string => !+ | _ => !-)\n                    ?>\n                        ~>\n                            ?: t ?|\n                            | char => $'(std.mem.indexOfScalar(u8, !a, !b) \\!= null)' : bool\n                            | _ => $'(std.mem.indexOf(u8, !a, !b) \\!= null)' : bool\n                    |:\n                        := len : i32 = $'@@as(i32, @@intCast(!a.len))'\n                        := same (item : t) : bool =\n                            ? (~> ?: t ?| string => !+ | _ => !-)\n                            ?> $'std.mem.eql(u8, !item, !b)' : bool\n                            |: $'(!item == !b)' : bool\n                        :~ ^ scan (i : i32) : bool =\n                            ? i >= len ?> !-\n                            |? same ($'!a[@@intCast(!i)]' : t) ?> !+\n                            |: scan (i + 1i32)\n                        scan 0i32\n                | _ => \\ () =>\n                    a\n                    |> $'List.ofSeq'\n                    |> \\ x => x : listm'::list' t\n                    |> $'List.tryFind' ((=) b)\n                    |> optionm'::unbox\n                    |> \\ (x : option t) => x <> None\n        trace\n        \"__assert_contains\"\n        b\n        a\n\n:= _assert_contains b a =\n    __assert_contains Console b a","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  := _assert_in items x =
      (None, items)
      ||> listm::fold \ acc x' =>
          ?= acc ?|
          | Some x => Some x
          | None =>
              ? x' <>. x
              ?> None
              |:
                  trace Debug (\ () => "_assert_in") \ () => { x x' }
                  Some ()
      |> \|
          | Some _ => ()
          | None =>
              "_assert_in / " ++#? { x items } |> failwith

  := ^ __assert_contains \* t u. (trace : testing_trace) (b : t) (a : u) : () =
      __expect
          \ a b =>
              run_target \|
                  | Rust => \ () =>
                      := found : bool =
                          ~>
                              ?: u ?|
                              | string =>
                                  ?: t ?|
                                  | char => $'!a.contains(char::from(!b))' : bool
                                  | _ => $'!a.contains(&*!b)' : bool
                              | array_base _ => $'!a.borrow().contains(&!b)' : bool
                              | _ => $'!a.iter().any(|x| *x == !b)' : bool
                      found
                  | Zig => \ () =>
                      ? (~> ?: u ?| string => !+ | _ => !-)
                      ?>
                          ~>
                              ?: t ?|
                              | char => $'(std.mem.indexOfScalar(u8, !a, !b) \!= null)' : bool
                              | _ => $'(std.mem.indexOf(u8, !a, !b) \!= null)' : bool
                      |:
                          := len : i32 = $'@@as(i32, @@intCast(!a.len))'
                          := same (item : t) : bool =
                              ? (~> ?: t ?| string => !+ | _ => !-)
                              ?> $'std.mem.eql(u8, !item, !b)' : bool
                              |: $'(!item == !b)' : bool
                          :~ ^ scan (i : i32) : bool =
                              ? i >= len ?> !-
                              |? same ($'!a[@@intCast(!i)]' : t) ?> !+
                              |: scan (i + 1i32)
                          scan 0i32
                  | _ => \ () =>
                      a
                      |> $'List.ofSeq'
                      |> \ x => x : listm'::list' t
                      |> $'List.tryFind' ((=) b)
                      |> optionm'::unbox
                      |> \ (x : option t) => x <> None
          trace
          "__assert_contains"
          b
          a

  := _assert_contains b a =
      __assert_contains Console b a
  """,
  timeout: 300_000
)
```

