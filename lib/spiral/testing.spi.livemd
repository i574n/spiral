<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":":< sm'_operators\n\n:| testing_trace =\n    | Console\n    | Trace\n    | TraceRaw\n    | Silent\n\n:= ^ __expect\n    (fn : _ -> _ -> bool)\n    (trace' : testing_trace)\n    (name : string)\n    (b : _)\n    (a : _)\n    : ()\n    =\n    := result = fn a b\n    := get_data () =\n        ? result\n        ?> sm'::show { expected = b }\n        |: sm'::show { actual = a; expected = b }\n    := get_raw_text () =\n        := data = get_data ()\n        name ++# \" \" ++# get_data ()\n    := result =\n        result || ~~ result\n    ?= trace' ?|\n    | Console =>\n        := text = get_raw_text ()\n        text |> console::write_line\n        text\n    | Trace =>\n        trace Info (\\ () => name) get_data\n        get_raw_text ()\n    | TraceRaw =>\n        := text = get_raw_text ()\n        trace_raw Info \\ () => text\n        text\n    | Silent => reflection::nameof { __expect }\n    |> assert result\n\n:= ^ __assert_approx_eq trace e b a =\n    __expect\n        \\ a b => abs (b - a) < (e |> optionm::defaultWith 0.00000001)\n        trace\n        (reflection::nameof { __assert_approx_eq })\n        b\n        a\n\n:= _assert_approx_eq e b a =\n    __assert_approx_eq Console e b a","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  :< sm'_operators

  :| testing_trace =
      | Console
      | Trace
      | TraceRaw
      | Silent

  := ^ __expect
      (fn : _ -> _ -> bool)
      (trace' : testing_trace)
      (name : string)
      (b : _)
      (a : _)
      : ()
      =
      := result = fn a b
      := get_data () =
          ? result
          ?> sm'::show { expected = b }
          |: sm'::show { actual = a; expected = b }
      := get_raw_text () =
          := data = get_data ()
          name ++# " " ++# get_data ()
      := result =
          result || ~~ result
      ?= trace' ?|
      | Console =>
          := text = get_raw_text ()
          text |> console::write_line
          text
      | Trace =>
          trace Info (\ () => name) get_data
          get_raw_text ()
      | TraceRaw =>
          := text = get_raw_text ()
          trace_raw Info \ () => text
          text
      | Silent => reflection::nameof { __expect }
      |> assert result

  := ^ __assert_approx_eq trace e b a =
      __expect
          \ a b => abs (b - a) < (e |> optionm::defaultWith 0.00000001)
          trace
          (reflection::nameof { __assert_approx_eq })
          b
          a

  := _assert_approx_eq e b a =
      __assert_approx_eq Console e b a
  """,
  timeout: 300_000
)
```

