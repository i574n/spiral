### join_handle

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"nominal join_handle t =\n    `(\n        rust_type\n            `($'std_thread_JoinHandle<`t>')\n            `($'std::thread::JoinHandle<`t>')\n            \"type std_thread_JoinHandle<'T> = class end\"\n    )","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  nominal join_handle t =
      `(
          rust_type
              `($'std_thread_JoinHandle<`t>')
              `($'std::thread::JoinHandle<`t>')
              "type std_thread_JoinHandle<'T> = class end"
      )
  """,
  timeout: 300_000
)
```

### spawn

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"inl spawn forall t. depth flag (x : () -> t) : join_handle t =\n    if flag = 1u8\n    then (!\\($'\"true; let __spawn = std::thread::spawn(move || { //\"') : bool) |> ignore\n    else (!\\($'\"true; let __spawn = std::thread::spawn(|| { //\"') : bool) |> ignore\n\n    let x' = x ()\n    inl x' = join x'\n\n    x' |> rust.fix_closure depth\n\n    !\\($'\"__spawn\"')","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  inl spawn forall t. depth flag (x : () -> t) : join_handle t =
      if flag = 1u8
      then (!\($'"true; let __spawn = std::thread::spawn(move || { //"') : bool) |> ignore
      else (!\($'"true; let __spawn = std::thread::spawn(|| { //"') : bool) |> ignore

      let x' = x ()
      inl x' = join x'

      x' |> rust.fix_closure depth

      !\($'"__spawn"')
  """,
  timeout: 300_000
)
```

### join'

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"inl join' forall t.\n    (x : join_handle t)\n    : resultm.result'\n        t\n        (\n            rust.box (\n                rust.lifetime_ref\n                    rust.dyn'\n                    (\n                        rust.lifetime_join\n                            rust.any\n                            (\n                                rust.lifetime_ref\n                                    rust.send\n                                    rust.static_lifetime\n                            )\n                    )\n            )\n        ) =\n    !\\\\(x, $'\"std::thread::JoinHandle::join($0)\"')","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  inl join' forall t.
      (x : join_handle t)
      : resultm.result'
          t
          (
              rust.box (
                  rust.lifetime_ref
                      rust.dyn'
                      (
                          rust.lifetime_join
                              rust.any
                              (
                                  rust.lifetime_ref
                                      rust.send
                                      rust.static_lifetime
                              )
                      )
              )
          ) =
      !\\(x, $'"std::thread::JoinHandle::join($0)"')
  """,
  timeout: 300_000
)
```

