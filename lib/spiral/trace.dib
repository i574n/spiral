#!markdown

# trace

#!spiral

///- --test static

open testing

#!spiral

open sm'_operators

#!markdown

## trace

#!markdown

### trace_level

#!spiral

union trace_level =
    | Verbose
    | Debug
    | Info
    | Warning
    | Critical

#!markdown

### severity

#!spiral

inl severity = function
    | Verbose => 10
    | Debug => 20
    | Info => 30
    | Warning => 40
    | Critical => 50

#!markdown

### read_state

#!spiral

inl read_state () =
    run_target function
        | Rust (Some (Wasm)) => fun () =>
            {
                trace_level = None
                repl_start = None
            }
        | Rust (Some (Contract)) => fun () =>
            {
                trace_level = None
                repl_start =
                    open rust.rust_operators
                    inl automation = env.get_environment_variable_comptime "AUTOMATION"
                    if automation <>. "True"
                    then None
                    else
                        inl timestamp : u64 = !\($'$"near_sdk::env::block_timestamp()"')
                        timestamp |> convert.i64 |> Some
            }
        | Rust _ => fun () =>
            {
                trace_level = None
                repl_start = None
            }
        // Native binaries honor TRACE_LEVEL like the F# and Python ones (None meant Verbose: every lib trace printed).
        | RustNative => fun () =>
            {
                trace_level = "TRACE_LEVEL" |> env.get_environment_variable |> reflection.union_try_pick
                repl_start = None
            }
        | TypeScript when typescript.is_native () => fun () =>
            {
                trace_level = "TRACE_LEVEL" |> env.get_environment_variable |> reflection.union_try_pick'
                repl_start = None
            }
        | _ => fun () =>
            join
                {
                    trace_level =
                        inl get_result () =
                            "TRACE_LEVEL"
                            |> env.get_environment_variable
                            |> reflection.union_try_pick
                        backend_switch {
                            Gleam = get_result : () -> option trace_level
                            Lua = fun () => None : option trace_level
                            Fsharp = get_result : () -> option trace_level
                            Python = get_result : () -> option trace_level
                        }
                    repl_start =
                        inl automation = env.get_environment_variable "AUTOMATION"
                        if automation <>. "True"
                        then None
                        else
                            date_time.now ()
                            |> date_time.ticks
                            |> fun (date_time.timestamp x) => x |> convert.convert
                            |> fun (x : i64) =>
                                backend_switch {
                                    Gleam = fun () =>
                                        global "import gleam/float"
                                        global "import gleam/time/timestamp"
                                        $'!x |> timestamp.to_unix_seconds |> float.round' : i64
                                    Lua = fun () => x
                                    Fsharp = fun () => x
                                    Python = fun () => x
                                }
                            |> Some
                }

#!markdown

### trace_state

#!spiral

type trace_state =
    {
        count : mut i64
        trace_file : mut (string -> ())
        enabled : mut bool
        acc : mut string
        level : mut trace_level
        repl_start : optionm'.option' i64
    }

#!markdown

### new_trace_state

#!spiral

let new_trace_state trace_level' =
    inl { repl_start trace_level } = read_state ()
    {
        count = mut 1i64
        trace_file = mut ignore
        enabled = mut true
        acc = mut ""
        level = trace_level |> optionm'.default_value trace_level' |> mut
        repl_start = repl_start |> optionm'.box
    } : trace_state

#!markdown

### init_trace_state

#!spiral

inl init_trace_state trace_level : () =
    inl trace_level = trace_level |> optionm'.default_value Verbose
    backend_switch {
        Gleam = fun () =>
            global "fn trace_state () { option.None }"
            $'let new_trace_state = !new_trace_state ' : ()
            $'let trace_level = !trace_level ' : ()
            $'let trace_state = fn () {' : ()
            $'  case trace_state () {' : ()
            $'    option.None -> new_trace_state(trace_level) |> option.Some' : ()
            $'    x -> x' : ()
            $'  }' : ()
            $'}' : ()
        Lua = fun () =>
            global "_G.trace_state = nil"
            $'if _G.trace_state == nil then _G.trace_state = !new_trace_state(!trace_level) end' : ()
        Fsharp = fun () =>
            backend_switch {
                Fsharp = fun () =>
                    global "module TraceState = let mutable trace_state = None"
            }
            fun () =>
                if $'TraceState.trace_state.IsNone' then
                    inl trace_state = new_trace_state trace_level |> optionm'.some'
                    $'TraceState.trace_state <- !trace_state ' : ()
            |> exec_unit
        Python = fun () =>
            global "class TraceState: trace_state = None"
            $'if TraceState.trace_state is None: TraceState.trace_state = !new_trace_state(!trace_level)' : ()
        TypeScript = fun () =>
            global "let spiral_trace_state: any = undefined;"
            $'if (spiral_trace_state === undefined) spiral_trace_state = !new_trace_state(!trace_level)' : ()
        Rust = fun () =>
            global "fn spiral_trace_hold<T: Clone>(fresh: &std::rc::Rc<dyn Fn() -> T>) -> T {\n    use std::sync::OnceLock;\n    static SLOT: OnceLock<usize> = OnceLock::new();\n    let raw = *SLOT.get_or_init(|| Box::into_raw(Box::new((*fresh)())) as usize);\n    unsafe { (*(raw as *const T)).clone() }\n}"
            inl fresh = fun () => new_trace_state trace_level
            open rust.rust_operators
            !\\(fresh, $'"{ let _ = spiral_trace_hold(&$0); }"') : ()
    }

#!markdown

### get_trace_state_or_init

#!spiral

inl get_trace_state_or_init trace_level : trace_state =
    init_trace_state trace_level
    backend_switch {
        Gleam = fun () =>
            inl trace_level = trace_level |> optionm'.default_value Verbose
            $'trace_state () |> option.lazy_unwrap(fn () { !new_trace_state(!trace_level) })' : trace_state
        Lua = fun () =>
            $'_G.trace_state' : trace_state
        Fsharp = fun () =>
            $'TraceState.trace_state.Value' : trace_state
        Python = fun () =>
            $'TraceState.trace_state' : trace_state
        TypeScript = fun () =>
            $'spiral_trace_state' : trace_state
        Rust = fun () =>
            global "fn spiral_trace_hold<T: Clone>(fresh: &std::rc::Rc<dyn Fn() -> T>) -> T {\n    use std::sync::OnceLock;\n    static SLOT: OnceLock<usize> = OnceLock::new();\n    let raw = *SLOT.get_or_init(|| Box::into_raw(Box::new((*fresh)())) as usize);\n    unsafe { (*(raw as *const T)).clone() }\n}"
            inl level' = trace_level |> optionm'.default_value Verbose
            inl fresh = fun () => new_trace_state level'
            open rust.rust_operators
            !\\(fresh, $'"{ spiral_trace_hold(&$0) }"') : trace_state
    }

#!markdown

### set_trace_level

#!spiral

inl set_trace_level new_level =
    inl ({ level } & trace_state) = get_trace_state_or_init None
    level <- new_level
    backend_switch {
        Gleam = fun () => $'let trace_state = fn () { !(trace_state |> optionm'.some') }' : ()
        Lua = id : () -> ()
        Fsharp = id : () -> ()
        Python = id : () -> ()
        // The native state is one shared mutable cell (spiral_trace_hold): the assignment above is enough.
        Rust = id : () -> ()
        TypeScript = id : () -> ()
    }

#!markdown

### test_trace_level

#!spiral

inl test_trace_level level : bool =
    inl state = get_trace_state_or_init None
    inl level' = *state.level
    inl a : int = level |> severity
    inl b : int = level' |> severity
    if *state.enabled |> not
    then false
    else a >= b

#!spiral

///- --test
///> lua
///> gleam
///> fsharp
///> cuda
///> rust
///> typescript

test_trace_level Critical |> _assert_eq true
test_trace_level Verbose |> _assert_eq true
Debug |> set_trace_level
test_trace_level Verbose |> _assert_eq false
Verbose |> set_trace_level
test_trace_level Verbose |> _assert_eq true

#!markdown

### trace_raw

#!spiral

inl trace_raw level fn =
    fun () =>
        inl trace_state =
            if level |> test_trace_level |> not
            then None
            else
                inl text = fn ()
                inl ({ count acc } & trace_state) = get_trace_state_or_init None
                fun () =>
                    count <- *count + 1
                |> exec_unit
                open rust
                open rust.rust_operators
                run_target_args (fun () => text, console.write_line) function
                    | Rust (Some (Contract)) => fun text, _ =>
                        inl new_acc =
                            if *acc = ""
                            then text
                            elif text = ""
                            then *acc
                            else *acc ++\# text
                        inl chunks =
                            new_acc
                            |> sm'.as_str
                            |> sm'.chars
                            |> rust.from_mut
                            |> iter_collect
                            |> am'.vec_chunks 15000
                            |> am'.vec_map sm'.from_iter
                            |> am'.from_vec
                        inl chunks_len = chunks |> am'.length
                        if text <>. "" && chunks_len <= 1i32
                        then acc <- new_acc
                        else
                            acc <- ""
                            chunks
                            |> am.iter near.log
                    | Rust _ => fun text, _ =>
                        !\\(text, $'"println\!(\\\"{}\\\", $0)"')
                    // In a NEAR contract (wasm32) stdout goes nowhere: the trace goes to the contract's logs instead,
                    // gathered as in the Contract arm above (a call's lines become one log, in 15000-char chunks, when
                    // its trailing empty trace runs), since NEAR fails a receipt with more than 100 logs or more than
                    // 16384 bytes of logs: spiral_trace_near_log's counter (one wasm instance per receipt) caps them at
                    // 16000 bytes.
                    | RustNative => fun text, _ =>
                        global "#[cfg(target_arch = \"wasm32\")]\nfn spiral_trace_near_log(text: &str) {\n    use std::sync::atomic::{AtomicUsize, Ordering};\n    static LOGGED: AtomicUsize = AtomicUsize::new(0);\n    let cs: Vec<char> = text.chars().collect();\n    for c in cs.chunks(15000) {\n        let s: String = c.iter().collect();\n        let used = LOGGED.load(Ordering::Relaxed);\n        let budget = 16000usize.saturating_sub(used);\n        if budget < 13 {\n            break;\n        }\n        let s = if s.len() <= budget {\n            s\n        } else {\n            let mut end = budget - 12;\n            while !s.is_char_boundary(end) {\n                end -= 1;\n            }\n            format!(\"{} [truncated]\", &s[..end])\n        };\n        LOGGED.store(used + s.len(), Ordering::Relaxed);\n        near_sdk::env::log_str(&s);\n    }\n}"
                        if $'cfg\!(target_arch = "wasm32")' : bool
                        then
                            inl new_acc =
                                if *acc = ""
                                then text
                                elif text = ""
                                then *acc
                                else *acc ++\# text
                            inl chunks_len : i32 = !\\(new_acc, $'"(($0.chars().count() + 14999) / 15000) as i32"')
                            if text <>. "" && chunks_len <= 1i32
                            then acc <- new_acc
                            else
                                acc <- ""
                                !\\(new_acc, $'"{ \#[cfg(target_arch = \\\"wasm32\\\")] spiral_trace_near_log(&$0); }"')
                        else !\\(text, $'"println\!(\\\"{}\\\", $0)"')
                    | _ => fun text, write_line =>
                        text |> write_line
                text |> *trace_state.trace_file
                trace_state |> Some
        backend_switch {
            Gleam = fun () => $'let trace_state = fn () { !(trace_state |> optionm'.box) }' : ()
            Lua = id : () -> ()
            Fsharp = id : () -> ()
            Python = id : () -> ()
            Rust = id : () -> ()
            TypeScript = id : () -> ()
        }
    |> exec_unit

#!markdown

### trace

#!spiral

inl trace (level : trace_level) (text_fn : () -> string) (locals : () -> _) =
    fun () =>
        inl trace_state = get_trace_state_or_init None
        inl time =
            join
                run_target fun target =>
                    match target with
                    | Rust (Some (Contract)) => fun () =>
                        open rust.rust_operators
                        open rust
                        inl timestamp = near.block_timestamp ()
                        inl timestamp =
                            match trace_state.repl_start |> optionm'.unbox with
                            | Some repl_start => timestamp - convert.u64 repl_start
                            | None => timestamp
                        inl timestamp_s = timestamp / 1_000_000_000
                        inl s = timestamp_s % 60
                        inl m = (timestamp_s / 60) % 60
                        inl h = (timestamp_s / 3600) % 24
                        inl str : sm'.std_string =
                            !\\((h, m, s), $'$"format\!(\\\"{{:02}}:{{:02}}:{{:02}}\\\", $0, $1, $2)"')
                        str |> sm'.from_std_string
                    // A wasm build runs as a NEAR contract (`///> rust -c` / `-w`), where std's clock panics ("time not
                    // implemented on this platform"): it reads the block timestamp instead, like the Fable contract arm.
                    // Elsewhere local time, as F#'s DateTime.Now, without a dependency: GetLocalTime on Windows,
                    // localtime_r (libc) on Unix.
                    | RustNative => fun () =>
                        open rust.rust_operators
                        !\\((), $'"{ \#[cfg(target_arch = \\\"wasm32\\\")] let (h, m, s) = { let secs = near_sdk::env::block_timestamp() / 1_000_000_000; ((secs / 3600) % 24, (secs / 60) % 60, secs % 60) }; \#[cfg(all(windows, not(target_arch = \\\"wasm32\\\")))] let (h, m, s) = { \#[repr(C)] struct St([u16; 8]); unsafe extern \\\"system\\\" { fn GetLocalTime(t: *mut St); } let mut t = St([0; 8]); unsafe { GetLocalTime(&mut t) }; (t.0[4] as u64, t.0[5] as u64, t.0[6] as u64) }; \#[cfg(all(unix, not(target_arch = \\\"wasm32\\\")))] let (h, m, s) = { \#[repr(C, align(8))] struct Tm([i32; 16]); unsafe extern \\\"C\\\" { fn localtime_r(t: *const std::os::raw::c_long, tm: *mut Tm) -> *mut Tm; } let secs = std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).map(|d| d.as_secs()).unwrap_or(0) as std::os::raw::c_long; let mut tm = Tm([0; 16]); unsafe { localtime_r(&secs, &mut tm) }; (tm.0[2] as u64, tm.0[1] as u64, tm.0[0] as u64) }; \#[cfg(not(any(windows, unix, target_arch = \\\"wasm32\\\")))] let (h, m, s) = { let secs = std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).map(|d| d.as_secs()).unwrap_or(0); ((secs / 3600) % 24, (secs / 60) % 60, secs % 60) }; let mut buf = String::new(); let push = |buf: &mut String, n: u64| { if n < 10 { buf.push(char::from(48)); } buf.push_str(&n.to_string()); }; push(&mut buf, h); buf.push(char::from(58)); push(&mut buf, m); buf.push(char::from(58)); push(&mut buf, s); Rc::<str>::from(buf) }"') : string
                    | TypeScript when typescript.is_native () => fun () =>
                        $'(() => { const d = new Date(); const p = (n: number) => String(n).padStart(2, "0"); return p(d.getHours()) + ":" + p(d.getMinutes()) + ":" + p(d.getSeconds()); })()' : string
                    | _ => fun () =>
                        match trace_state.repl_start |> optionm'.unbox with
                        | Some repl_start =>
                            inl t =
                                date_time.now ()
                                |> date_time.ticks
                                |> fun (date_time.timestamp x) => x |> convert.convert
                                |> fun (x : i64) =>
                                    backend_switch {
                                        Gleam = fun () =>
                                            global "import gleam/float"
                                            global "import gleam/time/timestamp"
                                            $'!x |> timestamp.to_unix_seconds |> float.round' : i64
                                        Lua = fun () => x
                                        Fsharp = fun () => x
                                        Python = fun () => x
                                    }
                                |> flip (-) repl_start
                                |> date_time.time_span
                            date_time.date_time_milliseconds
                                1i32 1i32 1i32
                                (t |> date_time.hours)
                                (t |> date_time.minutes)
                                (t |> date_time.seconds)
                                (t |> date_time.milliseconds)
                        | None => date_time.now ()
                        |> date_time.format (
                            backend_switch {
                                Gleam = fun () => "HH:mm:ss"
                                Lua = fun () => "%H:%M:%S"
                                Fsharp = fun () =>
                                    match target with
                                    | Rust _ | RustNative => join "hh:mm:ss"
                                    | _ => join "HH:mm:ss"
                                Python = fun () => "%H:%M:%S"
                            }
                        )
        inl level_str =
            join
                inl color =
                    match level with
                    | Verbose => console.color_bright_black ()
                    | Debug => console.color_bright_blue ()
                    | Info => console.color_bright_green ()
                    | Warning => console.color_yellow ()
                    | Critical => console.color_bright_red ()
                inl level_str =
                    level
                    |> reflection.union_to_string
                    |> sm'.to_lower
                    |> sm'.index 0i32
                    |> sm'.format
                color ++# level_str ++# console.color_reset ()
        inl text = text_fn ()
        if text = ""
        then ""
        else
            inl locals = locals ()
            join
                inl count = *trace_state.count
                time ++# " "  ++#? count ++# level_str ++# " " ++# text ++# " / " ++#? locals
                |> fun x =>
                    join
                        x
                        |> sm'.trim_start []
                        |> sm'.trim_end [ ' '; '/' ]
    |> trace_raw level

#!spiral

///- --test
///> gleam
///> lua
///> fsharp
///> cuda
///> rust
///> typescript

trace Debug (fun () => "test1") id
trace Debug (fun () => "test2") id
get_trace_state_or_init None .count
|> fun x => *x
|> _assert_eq 3

#!markdown

### trace_format

#!spiral

inl trace_format level fn obj =
    inl text, locals = fn obj
    inl locals = #?locals |> sm'.ellipsis_end 200
    trace level (fun () => text) (fun () => locals)
    obj

#!markdown

## main

#!spiral

inl main () =
    init_trace_state None
    inl trace level text_fn (locals : () -> string) = trace level text_fn locals
    $'let trace x = !trace x' : ()
