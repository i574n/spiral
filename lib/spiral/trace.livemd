### new_trace_state

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"let new_trace_state trace_level' =\n    inl { repl_start trace_level } = read_state ()\n    {\n        count = mut 1i64\n        trace_file = mut ignore\n        enabled = mut true\n        acc = mut \"\"\n        level = trace_level |> optionm'.default_value trace_level' |> mut\n        repl_start = repl_start |> optionm'.box\n    } : trace_state","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  let new_trace_state trace_level' =
      inl { repl_start trace_level } = read_state ()
      {
          count = mut 1i64
          trace_file = mut ignore
          enabled = mut true
          acc = mut ""
          level = trace_level |> optionm'.default_value trace_level' |> mut
          repl_start = repl_start |> optionm'.box
      } : trace_state
  """,
  timeout: 300_000
)
```

### init_trace_state

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"inl init_trace_state trace_level : () =\n    inl trace_level = trace_level |> optionm'.default_value Verbose\n    backend_switch {\n        Gleam = fun () =>\n            global \"fn trace_state () { option.None }\"\n            $'let new_trace_state = !new_trace_state ' : ()\n            $'let trace_level = !trace_level ' : ()\n            $'let trace_state = fn () {' : ()\n            $'  case trace_state () {' : ()\n            $'    option.None -> new_trace_state(trace_level) |> option.Some' : ()\n            $'    x -> x' : ()\n            $'  }' : ()\n            $'}' : ()\n        Lua = fun () =>\n            global \"_G.trace_state = nil\"\n            $'if _G.trace_state == nil then _G.trace_state = !new_trace_state(!trace_level) end' : ()\n        Fsharp = fun () =>\n            backend_switch {\n                Fsharp = fun () =>\n                    global \"module TraceState = let mutable trace_state = None\"\n            }\n            fun () =>\n                if $'TraceState.trace_state.IsNone' then\n                    inl trace_state = new_trace_state trace_level |> optionm'.some'\n                    $'TraceState.trace_state <- !trace_state ' : ()\n            |> exec_unit\n        Python = fun () =>\n            global \"class TraceState: trace_state = None\"\n            $'if TraceState.trace_state is None: TraceState.trace_state = !new_trace_state(!trace_level)' : ()\n        TypeScript = fun () =>\n            global \"let spiral_trace_state: any = undefined;\"\n            $'if (spiral_trace_state === undefined) spiral_trace_state = !new_trace_state(!trace_level)' : ()\n        Rust = fun () =>\n            global \"fn spiral_trace_hold<T: Clone>(fresh: &std::rc::Rc<dyn Fn() -> T>) -> T {\\n    use std::sync::OnceLock;\\n    static SLOT: OnceLock<usize> = OnceLock::new();\\n    let raw = *SLOT.get_or_init(|| Box::into_raw(Box::new((*fresh)())) as usize);\\n    unsafe { (*(raw as *const T)).clone() }\\n}\"\n            inl fresh = fun () => new_trace_state trace_level\n            open rust.rust_operators\n            !\\\\(fresh, $'\"{ let _ = spiral_trace_hold(&$0); }\"') : ()\n    }","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  inl init_trace_state trace_level : () =
      inl trace_level = trace_level |> optionm'.default_value Verbose
      backend_switch {
          Gleam = fun () =>
              global "fn trace_state () { option.None }"
              $'let new_trace_state = !new_trace_state ' : ()
              $'let trace_level = !trace_level ' : ()
              $'let trace_state = fn () {' : ()
              $'  case trace_state () {' : ()
              $'    option.None -> new_trace_state(trace_level) |> option.Some' : ()
              $'    x -> x' : ()
              $'  }' : ()
              $'}' : ()
          Lua = fun () =>
              global "_G.trace_state = nil"
              $'if _G.trace_state == nil then _G.trace_state = !new_trace_state(!trace_level) end' : ()
          Fsharp = fun () =>
              backend_switch {
                  Fsharp = fun () =>
                      global "module TraceState = let mutable trace_state = None"
              }
              fun () =>
                  if $'TraceState.trace_state.IsNone' then
                      inl trace_state = new_trace_state trace_level |> optionm'.some'
                      $'TraceState.trace_state <- !trace_state ' : ()
              |> exec_unit
          Python = fun () =>
              global "class TraceState: trace_state = None"
              $'if TraceState.trace_state is None: TraceState.trace_state = !new_trace_state(!trace_level)' : ()
          TypeScript = fun () =>
              global "let spiral_trace_state: any = undefined;"
              $'if (spiral_trace_state === undefined) spiral_trace_state = !new_trace_state(!trace_level)' : ()
          Rust = fun () =>
              global "fn spiral_trace_hold<T: Clone>(fresh: &std::rc::Rc<dyn Fn() -> T>) -> T {\n    use std::sync::OnceLock;\n    static SLOT: OnceLock<usize> = OnceLock::new();\n    let raw = *SLOT.get_or_init(|| Box::into_raw(Box::new((*fresh)())) as usize);\n    unsafe { (*(raw as *const T)).clone() }\n}"
              inl fresh = fun () => new_trace_state trace_level
              open rust.rust_operators
              !\\(fresh, $'"{ let _ = spiral_trace_hold(&$0); }"') : ()
      }
  """,
  timeout: 300_000
)
```

### get_trace_state_or_init

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"inl get_trace_state_or_init trace_level : trace_state =\n    init_trace_state trace_level\n    backend_switch {\n        Gleam = fun () =>\n            inl trace_level = trace_level |> optionm'.default_value Verbose\n            $'trace_state () |> option.lazy_unwrap(fn () { !new_trace_state(!trace_level) })' : trace_state\n        Lua = fun () =>\n            $'_G.trace_state' : trace_state\n        Fsharp = fun () =>\n            $'TraceState.trace_state.Value' : trace_state\n        Python = fun () =>\n            $'TraceState.trace_state' : trace_state\n        TypeScript = fun () =>\n            $'spiral_trace_state' : trace_state\n        Rust = fun () =>\n            global \"fn spiral_trace_hold<T: Clone>(fresh: &std::rc::Rc<dyn Fn() -> T>) -> T {\\n    use std::sync::OnceLock;\\n    static SLOT: OnceLock<usize> = OnceLock::new();\\n    let raw = *SLOT.get_or_init(|| Box::into_raw(Box::new((*fresh)())) as usize);\\n    unsafe { (*(raw as *const T)).clone() }\\n}\"\n            inl level' = trace_level |> optionm'.default_value Verbose\n            inl fresh = fun () => new_trace_state level'\n            open rust.rust_operators\n            !\\\\(fresh, $'\"{ spiral_trace_hold(&$0) }\"') : trace_state\n    }","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  inl get_trace_state_or_init trace_level : trace_state =
      init_trace_state trace_level
      backend_switch {
          Gleam = fun () =>
              inl trace_level = trace_level |> optionm'.default_value Verbose
              $'trace_state () |> option.lazy_unwrap(fn () { !new_trace_state(!trace_level) })' : trace_state
          Lua = fun () =>
              $'_G.trace_state' : trace_state
          Fsharp = fun () =>
              $'TraceState.trace_state.Value' : trace_state
          Python = fun () =>
              $'TraceState.trace_state' : trace_state
          TypeScript = fun () =>
              $'spiral_trace_state' : trace_state
          Rust = fun () =>
              global "fn spiral_trace_hold<T: Clone>(fresh: &std::rc::Rc<dyn Fn() -> T>) -> T {\n    use std::sync::OnceLock;\n    static SLOT: OnceLock<usize> = OnceLock::new();\n    let raw = *SLOT.get_or_init(|| Box::into_raw(Box::new((*fresh)())) as usize);\n    unsafe { (*(raw as *const T)).clone() }\n}"
              inl level' = trace_level |> optionm'.default_value Verbose
              inl fresh = fun () => new_trace_state level'
              open rust.rust_operators
              !\\(fresh, $'"{ spiral_trace_hold(&$0) }"') : trace_state
      }
  """,
  timeout: 300_000
)
```

### set_trace_level

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"inl set_trace_level new_level =\n    inl ({ level } & trace_state) = get_trace_state_or_init None\n    level <- new_level\n    backend_switch {\n        Gleam = fun () => $'let trace_state = fn () { !(trace_state |> optionm'.some') }' : ()\n        Lua = id : () -> ()\n        Fsharp = id : () -> ()\n        Python = id : () -> ()\n        Rust = id : () -> ()\n        TypeScript = id : () -> ()\n    }","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  inl set_trace_level new_level =
      inl ({ level } & trace_state) = get_trace_state_or_init None
      level <- new_level
      backend_switch {
          Gleam = fun () => $'let trace_state = fn () { !(trace_state |> optionm'.some') }' : ()
          Lua = id : () -> ()
          Fsharp = id : () -> ()
          Python = id : () -> ()
          Rust = id : () -> ()
          TypeScript = id : () -> ()
      }
  """,
  timeout: 300_000
)
```

### test_trace_level

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"inl test_trace_level level : bool =\n    inl state = get_trace_state_or_init None\n    inl level' = *state.level\n    inl a : int = level |> severity\n    inl b : int = level' |> severity\n    if *state.enabled |> not\n    then false\n    else a >= b","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  inl test_trace_level level : bool =
      inl state = get_trace_state_or_init None
      inl level' = *state.level
      inl a : int = level |> severity
      inl b : int = level' |> severity
      if *state.enabled |> not
      then false
      else a >= b
  """,
  timeout: 300_000
)
```

