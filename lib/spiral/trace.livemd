### read_state

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"inl read_state () =\n    run_target function\n        | Rust => fun () =>\n            {\n                trace_level = \"TRACE_LEVEL\" |> env.get_environment_variable |> reflection.union_try_pick\n                repl_start = None\n            }\n        | TypeScript => fun () =>\n            {\n                trace_level = \"TRACE_LEVEL\" |> env.get_environment_variable |> reflection.union_try_pick'\n                repl_start = None\n            }\n        | _ => fun () =>\n            join\n                {\n                    trace_level =\n                        inl get_result () =\n                            \"TRACE_LEVEL\"\n                            |> env.get_environment_variable\n                            |> reflection.union_try_pick\n                        backend_switch {\n                            Gleam = get_result : () -> option trace_level\n                            Lua = fun () => None : option trace_level\n                            Fsharp = get_result : () -> option trace_level\n                            Python = get_result : () -> option trace_level\n                        }\n                    repl_start =\n                        inl automation = env.get_environment_variable \"AUTOMATION\"\n                        if automation <>. \"True\"\n                        then None\n                        else\n                            date_time.now ()\n                            |> date_time.ticks\n                            |> fun (date_time.timestamp x) => x |> convert.convert\n                            |> fun (x : i64) =>\n                                backend_switch {\n                                    Gleam = fun () =>\n                                        global \"import gleam/float\"\n                                        global \"import gleam/time/timestamp\"\n                                        $'!x |> timestamp.to_unix_seconds |> float.round' : i64\n                                    Lua = fun () => x\n                                    Fsharp = fun () => x\n                                    Python = fun () => x\n                                }\n                            |> Some\n                }","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  inl read_state () =
      run_target function
          | Rust => fun () =>
              {
                  trace_level = "TRACE_LEVEL" |> env.get_environment_variable |> reflection.union_try_pick
                  repl_start = None
              }
          | TypeScript => fun () =>
              {
                  trace_level = "TRACE_LEVEL" |> env.get_environment_variable |> reflection.union_try_pick'
                  repl_start = None
              }
          | _ => fun () =>
              join
                  {
                      trace_level =
                          inl get_result () =
                              "TRACE_LEVEL"
                              |> env.get_environment_variable
                              |> reflection.union_try_pick
                          backend_switch {
                              Gleam = get_result : () -> option trace_level
                              Lua = fun () => None : option trace_level
                              Fsharp = get_result : () -> option trace_level
                              Python = get_result : () -> option trace_level
                          }
                      repl_start =
                          inl automation = env.get_environment_variable "AUTOMATION"
                          if automation <>. "True"
                          then None
                          else
                              date_time.now ()
                              |> date_time.ticks
                              |> fun (date_time.timestamp x) => x |> convert.convert
                              |> fun (x : i64) =>
                                  backend_switch {
                                      Gleam = fun () =>
                                          global "import gleam/float"
                                          global "import gleam/time/timestamp"
                                          $'!x |> timestamp.to_unix_seconds |> float.round' : i64
                                      Lua = fun () => x
                                      Fsharp = fun () => x
                                      Python = fun () => x
                                  }
                              |> Some
                  }
  """,
  timeout: 300_000
)
```

