<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":":< sm'_operators\n\n:| trace_level =\n    | Verbose\n    | Debug\n    | Info\n    | Warning\n    | Critical\n\n:= severity = \\|\n    | Verbose => 10\n    | Debug => 20\n    | Info => 30\n    | Warning => 40\n    | Critical => 50\n\n:= read_state () =\n    run_target \\|\n        | Zig => \\ () =>\n            {\n                trace_level =\n                    \"TRACE_LEVEL\" |> env::get_environment_variable |> reflection::union_try_pick : option trace_level\n                repl_start = None : option i64\n            }\n        | Rust => \\ () =>\n            {\n                trace_level = \"TRACE_LEVEL\" |> env::get_environment_variable |> reflection::union_try_pick\n                repl_start = None\n            }\n        | TypeScript => \\ () =>\n            {\n                trace_level = \"TRACE_LEVEL\" |> env::get_environment_variable |> reflection::union_try_pick'\n                repl_start = None\n            }\n        | _ => \\ () =>\n            ~~\n                {\n                    trace_level =\n                        := get_result () =\n                            \"TRACE_LEVEL\"\n                            |> env::get_environment_variable\n                            |> reflection::union_try_pick\n                        backend_switch {\n                            Gleam = get_result : () -> option trace_level\n                            Lua = \\ () => None : option trace_level\n                            Fsharp = get_result : () -> option trace_level\n                            Python = get_result : () -> option trace_level\n                        }\n                    repl_start =\n                        := automation = env::get_environment_variable \"AUTOMATION\"\n                        ? automation <>. \"True\"\n                        ?> None\n                        |:\n                            date_time::now ()\n                            |> date_time::to_timestamp\n                            |> \\ (date_time::timestamp x) => x\n                            |> Some\n                }\n\n:== trace_state =\n    {\n        count : mut i64\n        trace_file : mut (string -> ())\n        enabled : mut bool\n        acc : mut string\n        level : mut trace_level\n        repl_start : optionm'::option' i64\n    }\n\n:~ new_trace_state trace_level' =\n    := { repl_start trace_level } = read_state ()\n    {\n        count = mut 1i64\n        trace_file = mut ignore\n        enabled = mut !+\n        acc = mut \"\"\n        level = trace_level |> optionm'::default_value trace_level' |> mut\n        repl_start = repl_start |> optionm'::box\n    } : trace_state\n\n:= init_trace_state trace_level : () =\n    := trace_level = trace_level |> optionm'::default_value Verbose\n    backend_switch {\n        Gleam = \\ () =>\n            global \"fn trace_state () { option.None }\"\n            $'let new_trace_state = !new_trace_state ' : ()\n            $'let trace_level = !trace_level ' : ()\n            $'let trace_state = fn () {' : ()\n            $'  case trace_state () {' : ()\n            $'    option.None -> new_trace_state(trace_level) |> option.Some' : ()\n            $'    x -> x' : ()\n            $'  }' : ()\n            $'}' : ()\n        Lua = \\ () =>\n            global \"_G.trace_state = nil\"\n            \\ () =>\n                ? $'_G.trace_state == nil' : bool ?>\n                    := trace_state = new_trace_state trace_level\n                    $'_G.trace_state = !trace_state ' : ()\n            |> exec_unit\n        Fsharp = \\ () =>\n            backend_switch {\n                Fsharp = \\ () =>\n                    global \"module TraceState = let mutable trace_state = None\"\n            }\n            \\ () =>\n                ? $'TraceState.trace_state.IsNone' ?>\n                    := trace_state = new_trace_state trace_level |> optionm'::some'\n                    $'TraceState.trace_state <- !trace_state ' : ()\n            |> exec_unit\n        Python = \\ () =>\n            global \"class TraceState: trace_state = None\"\n            \\ () =>\n                ? $'TraceState.trace_state is None' : bool ?>\n                    := trace_state = new_trace_state trace_level\n                    $'TraceState.trace_state = !trace_state ' : ()\n            |> exec_unit\n        TypeScript = \\ () =>\n            global \"let spiral_trace_state: any = undefined;\"\n            \\ () =>\n                ? $'spiral_trace_state === undefined' : bool ?>\n                    := trace_state = new_trace_state trace_level\n                    $'spiral_trace_state = !trace_state ' : ()\n            |> exec_unit\n        Rust = \\ () =>\n            global \"\"\"\n                fn spiral_trace_hold<T: Clone>(fresh: &std::rc::Rc<dyn Fn() -> T>) -> T {\n                    use std::sync::OnceLock;\n                    static SLOT: OnceLock<usize> = OnceLock::new();\n                    let raw = *SLOT.get_or_init(|| Box::into_raw(Box::new((*fresh)())) as usize);\n                    unsafe { (*(raw as *const T)).clone() }\n                }\n                \"\"\"\n            := fresh = \\ () => new_trace_state trace_level\n            :< rust_operators\n            !\\\\(fresh, $'\"{ let _ = spiral_trace_hold(&$0); }\"') : ()\n        Zig = \\ () => ()\n    }\n\n:= get_trace_state_or_init trace_level : trace_state =\n    init_trace_state trace_level\n    backend_switch {\n        Gleam = \\ () =>\n            := trace_level = trace_level |> optionm'::default_value Verbose\n            $'trace_state () |> option.lazy_unwrap(fn () { !new_trace_state(!trace_level) })' : trace_state\n        Lua = \\ () =>\n            $'_G.trace_state' : trace_state\n        Fsharp = \\ () =>\n            $'TraceState.trace_state.Value' : trace_state\n        Python = \\ () =>\n            $'TraceState.trace_state' : trace_state\n        TypeScript = \\ () =>\n            $'spiral_trace_state' : trace_state\n        Rust = \\ () =>\n            global \"\"\"\n                fn spiral_trace_hold<T: Clone>(fresh: &std::rc::Rc<dyn Fn() -> T>) -> T {\n                    use std::sync::OnceLock;\n                    static SLOT: OnceLock<usize> = OnceLock::new();\n                    let raw = *SLOT.get_or_init(|| Box::into_raw(Box::new((*fresh)())) as usize);\n                    unsafe { (*(raw as *const T)).clone() }\n                }\n                \"\"\"\n            := level' = trace_level |> optionm'::default_value Verbose\n            := fresh = \\ () => new_trace_state level'\n            :< rust_operators\n            !\\\\(fresh, $'\"spiral_trace_hold(&$0)\"') : trace_state\n        Zig = \\ () =>\n            global \"\"\"\n                fn spiralHold(comptime T: type, fresh: anytype) T {\n                    const S = struct {\n                        var slot: ?T = null;\n                    };\n                    if (S.slot == null) S.slot = fresh.call(fresh.ctx);\n                    return S.slot.?;\n                }\n                \"\"\"\n            := level' = trace_level |> optionm'::default_value Verbose\n            := fresh = dyn \\ () => new_trace_state level'\n            $'spiralHold(`trace_state, !fresh)' : trace_state\n    }\n\n:= set_trace_level new_level =\n    := ({ level } & trace_state) = get_trace_state_or_init None\n    level <- new_level\n    backend_switch {\n        Gleam = \\ () => $'let trace_state = fn () { !(trace_state |> optionm'.some') }' : ()\n        Lua = id : () -> ()\n        Fsharp = id : () -> ()\n        Python = id : () -> ()\n        Rust = id : () -> ()\n        TypeScript = id : () -> ()\n        Zig = id : () -> ()\n    }\n\n:= test_trace_level level : bool =\n    := state = get_trace_state_or_init None\n    := level' = *state::level\n    := a : int = level |> severity\n    := b : int = level' |> severity\n    ? *state::enabled |> not\n    ?> !-\n    |: a >= b","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ":< sm'_operators\n\n:| trace_level =\n    | Verbose\n    | Debug\n    | Info\n    | Warning\n    | Critical\n\n:= severity = \\|\n    | Verbose => 10\n    | Debug => 20\n    | Info => 30\n    | Warning => 40\n    | Critical => 50\n\n:= read_state () =\n    run_target \\|\n        | Zig => \\ () =>\n            {\n                trace_level =\n                    \"TRACE_LEVEL\" |> env::get_environment_variable |> reflection::union_try_pick : option trace_level\n                repl_start = None : option i64\n            }\n        | Rust => \\ () =>\n            {\n                trace_level = \"TRACE_LEVEL\" |> env::get_environment_variable |> reflection::union_try_pick\n                repl_start = None\n            }\n        | TypeScript => \\ () =>\n            {\n                trace_level = \"TRACE_LEVEL\" |> env::get_environment_variable |> reflection::union_try_pick'\n                repl_start = None\n            }\n        | _ => \\ () =>\n            ~~\n                {\n                    trace_level =\n                        := get_result () =\n                            \"TRACE_LEVEL\"\n                            |> env::get_environment_variable\n                            |> reflection::union_try_pick\n                        backend_switch {\n                            Gleam = get_result : () -> option trace_level\n                            Lua = \\ () => None : option trace_level\n                            Fsharp = get_result : () -> option trace_level\n                            Python = get_result : () -> option trace_level\n                        }\n                    repl_start =\n                        := automation = env::get_environment_variable \"AUTOMATION\"\n                        ? automation <>. \"True\"\n                        ?> None\n                        |:\n                            date_time::now ()\n                            |> date_time::to_timestamp\n                            |> \\ (date_time::timestamp x) => x\n                            |> Some\n                }\n\n:== trace_state =\n    {\n        count : mut i64\n        trace_file : mut (string -> ())\n        enabled : mut bool\n        acc : mut string\n        level : mut trace_level\n        repl_start : optionm'::option' i64\n    }\n\n:~ new_trace_state trace_level' =\n    := { repl_start trace_level } = read_state ()\n    {\n        count = mut 1i64\n        trace_file = mut ignore\n        enabled = mut !+\n        acc = mut \"\"\n        level = trace_level |> optionm'::default_value trace_level' |> mut\n        repl_start = repl_start |> optionm'::box\n    } : trace_state\n\n:= init_trace_state trace_level : () =\n    := trace_level = trace_level |> optionm'::default_value Verbose\n    backend_switch {\n        Gleam = \\ () =>\n            global \"fn trace_state () { option.None }\"\n            $'let new_trace_state = !new_trace_state ' : ()\n            $'let trace_level = !trace_level ' : ()\n            $'let trace_state = fn () {' : ()\n            $'  case trace_state () {' : ()\n            $'    option.None -> new_trace_state(trace_level) |> option.Some' : ()\n            $'    x -> x' : ()\n            $'  }' : ()\n            $'}' : ()\n        Lua = \\ () =>\n            global \"_G.trace_state = nil\"\n            \\ () =>\n                ? $'_G.trace_state == nil' : bool ?>\n                    := trace_state = new_trace_state trace_level\n                    $'_G.trace_state = !trace_state ' : ()\n            |> exec_unit\n        Fsharp = \\ () =>\n            backend_switch {\n                Fsharp = \\ () =>\n                    global \"module TraceState = let mutable trace_state = None\"\n            }\n            \\ () =>\n                ? $'TraceState.trace_state.IsNone' ?>\n                    := trace_state = new_trace_state trace_level |> optionm'::some'\n                    $'TraceState.trace_state <- !trace_state ' : ()\n            |> exec_unit\n        Python = \\ () =>\n            global \"class TraceState: trace_state = None\"\n            \\ () =>\n                ? $'TraceState.trace_state is None' : bool ?>\n                    := trace_state = new_trace_state trace_level\n                    $'TraceState.trace_state = !trace_state ' : ()\n            |> exec_unit\n        TypeScript = \\ () =>\n            global \"let spiral_trace_state: any = undefined;\"\n            \\ () =>\n                ? $'spiral_trace_state === undefined' : bool ?>\n                    := trace_state = new_trace_state trace_level\n                    $'spiral_trace_state = !trace_state ' : ()\n            |> exec_unit\n        Rust = \\ () =>\n            global \"\"\"\n                fn spiral_trace_hold<T: Clone>(fresh: &std::rc::Rc<dyn Fn() -> T>) -> T {\n                    use std::sync::OnceLock;\n                    static SLOT: OnceLock<usize> = OnceLock::new();\n                    let raw = *SLOT.get_or_init(|| Box::into_raw(Box::new((*fresh)())) as usize);\n                    unsafe { (*(raw as *const T)).clone() }\n                }\n                \"\"\"\n            := fresh = \\ () => new_trace_state trace_level\n            :< rust_operators\n            !\\\\(fresh, $'\"{ let _ = spiral_trace_hold(&$0); }\"') : ()\n        Zig = \\ () => ()\n    }\n\n:= get_trace_state_or_init trace_level : trace_state =\n    init_trace_state trace_level\n    backend_switch {\n        Gleam = \\ () =>\n            := trace_level = trace_level |> optionm'::default_value Verbose\n            $'trace_state () |> option.lazy_unwrap(fn () { !new_trace_state(!trace_level) })' : trace_state\n        Lua = \\ () =>\n            $'_G.trace_state' : trace_state\n        Fsharp = \\ () =>\n            $'TraceState.trace_state.Value' : trace_state\n        Python = \\ () =>\n            $'TraceState.trace_state' : trace_state\n        TypeScript = \\ () =>\n            $'spiral_trace_state' : trace_state\n        Rust = \\ () =>\n            global \"\"\"\n                fn spiral_trace_hold<T: Clone>(fresh: &std::rc::Rc<dyn Fn() -> T>) -> T {\n                    use std::sync::OnceLock;\n                    static SLOT: OnceLock<usize> = OnceLock::new();\n                    let raw = *SLOT.get_or_init(|| Box::into_raw(Box::new((*fresh)())) as usize);\n                    unsafe { (*(raw as *const T)).clone() }\n                }\n                \"\"\"\n            := level' = trace_level |> optionm'::default_value Verbose\n            := fresh = \\ () => new_trace_state level'\n            :< rust_operators\n            !\\\\(fresh, $'\"spiral_trace_hold(&$0)\"') : trace_state\n        Zig = \\ () =>\n            global \"\"\"\n                fn spiralHold(comptime T: type, fresh: anytype) T {\n                    const S = struct {\n                        var slot: ?T = null;\n                    };\n                    if (S.slot == null) S.slot = fresh.call(fresh.ctx);\n                    return S.slot.?;\n                }\n                \"\"\"\n            := level' = trace_level |> optionm'::default_value Verbose\n            := fresh = dyn \\ () => new_trace_state level'\n            $'spiralHold(`trace_state, !fresh)' : trace_state\n    }\n\n:= set_trace_level new_level =\n    := ({ level } & trace_state) = get_trace_state_or_init None\n    level <- new_level\n    backend_switch {\n        Gleam = \\ () => $'let trace_state = fn () { !(trace_state |> optionm'.some') }' : ()\n        Lua = id : () -> ()\n        Fsharp = id : () -> ()\n        Python = id : () -> ()\n        Rust = id : () -> ()\n        TypeScript = id : () -> ()\n        Zig = id : () -> ()\n    }\n\n:= test_trace_level level : bool =\n    := state = get_trace_state_or_init None\n    := level' = *state::level\n    := a : int = level |> severity\n    := b : int = level' |> severity\n    ? *state::enabled |> not\n    ?> !-\n    |: a >= b",
  timeout: 300_000
)
```

#### test_trace_level (test)

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":"///- --test --symbol\n///> lua\n///> gleam\n///> cuda\n///> rust\n///> typescript\n\ntest_trace_level Critical |> _assert_eq !+\ntest_trace_level Verbose |> _assert_eq !+\nDebug |> set_trace_level\ntest_trace_level Verbose |> _assert_eq !-\nVerbose |> set_trace_level\ntest_trace_level Verbose |> _assert_eq !+","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  ///- --test --symbol
  ///> lua
  ///> gleam
  ///> cuda
  ///> rust
  ///> typescript

  test_trace_level Critical |> _assert_eq !+
  test_trace_level Verbose |> _assert_eq !+
  Debug |> set_trace_level
  test_trace_level Verbose |> _assert_eq !-
  Verbose |> set_trace_level
  test_trace_level Verbose |> _assert_eq !+
  """,
  timeout: 300_000
)
```

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":":= compiled_out (level : trace_level) : bool =\n    run_target \\|\n        | Rust => \\ () =>\n            ?= level ?|\n            | Verbose => $'matches\\!(option_env\\!(\"SPIRAL_TRACE_FLOOR\"), Some(\"Debug\" | \"Info\" | \"Warning\" | \"Critical\"))' : bool\n            | Debug => $'matches\\!(option_env\\!(\"SPIRAL_TRACE_FLOOR\"), Some(\"Info\" | \"Warning\" | \"Critical\"))' : bool\n            | Info => $'matches\\!(option_env\\!(\"SPIRAL_TRACE_FLOOR\"), Some(\"Warning\" | \"Critical\"))' : bool\n            | Warning => $'matches\\!(option_env\\!(\"SPIRAL_TRACE_FLOOR\"), Some(\"Critical\"))' : bool\n            | Critical => !-\n        | _ => \\ () => !-\n\n:= trace_raw level fn =\n    \\ () =>\n        := trace_state =\n            ? compiled_out level || (level |> test_trace_level |> not)\n            ?> None\n            |:\n                := text = fn ()\n                := ({ count acc } & trace_state) = get_trace_state_or_init None\n                \\ () =>\n                    count <- *count + 1\n                |> exec_unit\n                :< rust_operators\n                run_target_args (\\ () => text, console::write_line) \\|\n                    | Zig => \\ _ => text |> console::write_line\n                    | Rust => \\ text, _ =>\n                        global \"\"\"\n                            #[cfg(target_arch = \"wasm32\")]\n                            fn spiral_trace_near_log(text: &str) {\n                                use std::sync::atomic::{AtomicUsize, Ordering};\n                                static LOGGED: AtomicUsize = AtomicUsize::new(0);\n                                let mut rest = text;\n                                while !rest.is_empty() {\n                                    let used = LOGGED.load(Ordering::Relaxed);\n                                    let budget = 16000usize.saturating_sub(used);\n                                    if budget < 13 {\n                                        break;\n                                    }\n                                    let mut end = rest.len().min(15000);\n                                    while !rest.is_char_boundary(end) {\n                                        end -= 1;\n                                    }\n                                    let (chunk, tail) = rest.split_at(end);\n                                    if chunk.len() <= budget {\n                                        LOGGED.store(used + chunk.len(), Ordering::Relaxed);\n                                        near_sdk::env::log_str(chunk);\n                                        rest = tail;\n                                    } else {\n                                        let mut cut = budget - 12;\n                                        while !chunk.is_char_boundary(cut) {\n                                            cut -= 1;\n                                        }\n                                        let s = format!(\"{} [truncated]\", &chunk[..cut]);\n                                        LOGGED.store(used + s.len(), Ordering::Relaxed);\n                                        near_sdk::env::log_str(&s);\n                                        break;\n                                    }\n                                }\n                            }\n                            \"\"\"\n                        ? $'cfg\\!(target_arch = \"wasm32\")' : bool\n                        ?>\n                            := new_acc =\n                                ? *acc = \"\"\n                                ?> text\n                                |? text = \"\"\n                                ?> *acc\n                                |: *acc ++\\# text\n                            := byte_count : convert::unativeint = !\\\\(new_acc, $'\"$0.len()\"')\n                            := chunks_len : i32 = ((convert::convert byte_count : i32) + 14999i32) / 15000i32\n                            ? text <>. \"\" && chunks_len <= 1i32\n                            ?> acc <- new_acc\n                            |:\n                                acc <- \"\"\n                                !\\\\(new_acc, $'\"{ ##[cfg(target_arch = \\\\\\\"wasm32\\\\\\\")] spiral_trace_near_log(&$0); }\"')\n                        |: !\\\\(text, $'\"println\\!(\\\\\\\"{}\\\\\\\", $0)\"')\n                    | _ => \\ text, write_line =>\n                        text |> write_line\n                text |> *trace_state::trace_file\n                trace_state |> Some\n        backend_switch {\n            Gleam = \\ () => $'let trace_state = fn () { !(trace_state |> optionm'.box) }' : ()\n            Lua = id : () -> ()\n            Fsharp = id : () -> ()\n            Python = id : () -> ()\n            Rust = id : () -> ()\n            TypeScript = id : () -> ()\n            Zig = id : () -> ()\n        }\n    |> exec_unit\n\n:= clock_two_digits (n : i32) : string =\n    (? n < 10i32 ?> \"0\" |: \"\") ++# sm'::obj_to_string n\n\n:! rust_clock_fields = $'[i64; 3]'\n\n:= rust_clock_shims () : () =\n    global \"\"\"\n        #[cfg(target_arch = \"wasm32\")]\n        fn spiral_cfg_local_clock() -> Option<[i64; 3]> { None }\n        #[cfg(all(windows, not(target_arch = \"wasm32\")))]\n        fn spiral_cfg_local_clock() -> Option<[i64; 3]> {\n            #[repr(C)] struct St([u16; 8]);\n            unsafe extern \"system\" { fn GetLocalTime(t: *mut St); }\n            let mut t = St([0; 8]);\n            unsafe { GetLocalTime(&mut t) };\n            Some([i64::from(t.0[4]), i64::from(t.0[5]), i64::from(t.0[6])])\n        }\n        #[cfg(all(unix, not(target_arch = \"wasm32\")))]\n        fn spiral_cfg_local_clock() -> Option<[i64; 3]> {\n            #[repr(C, align(8))] struct Tm([i32; 16]);\n            unsafe extern \"C\" { fn localtime_r(t: *const std::os::raw::c_long, tm: *mut Tm) -> *mut Tm; }\n            let now = std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).map(|d| d.as_secs());\n            let secs = std::os::raw::c_long::try_from(now.unwrap_or(0)).unwrap_or(0);\n            let mut tm = Tm([0; 16]);\n            unsafe { localtime_r(&secs, &mut tm) };\n            Some([i64::from(tm.0[2]), i64::from(tm.0[1]), i64::from(tm.0[0])])\n        }\n        #[cfg(not(any(windows, unix, target_arch = \"wasm32\")))]\n        fn spiral_cfg_local_clock() -> Option<[i64; 3]> { None }\n        #[cfg(target_arch = \"wasm32\")]\n        fn spiral_cfg_epoch_nanos() -> u64 { near_sdk::env::block_timestamp() }\n        #[cfg(not(target_arch = \"wasm32\"))]\n        fn spiral_cfg_epoch_nanos() -> u64 {\n            let since = std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH);\n            since.map(|d| u64::try_from(d.as_nanos()).unwrap_or(0)).unwrap_or(0)\n        }\n        \"\"\"\n\n:= rust_local_clock () : optionm'::option' rust_clock_fields =\n    rust_clock_shims ()\n    $'spiral_cfg_local_clock()' : optionm'::option' rust_clock_fields\n\n:= rust_epoch_nanos () : u64 =\n    rust_clock_shims ()\n    $'spiral_cfg_epoch_nanos()' : u64\n\n:= rust_clock_hour (fields : rust_clock_fields) : i64 = $'!fields[0]' : i64\n\n:= rust_clock_minute (fields : rust_clock_fields) : i64 = $'!fields[1]' : i64\n\n:= rust_clock_second (fields : rust_clock_fields) : i64 = $'!fields[2]' : i64\n\n:= local_seconds_of_day () : u64 =\n    ?= rust_local_clock () |> optionm'::unbox ?|\n    | Some fields =>\n        conv (rust_clock_hour fields * 3600i64 + rust_clock_minute fields * 60i64 + rust_clock_second fields)\n    | None => rust_epoch_nanos () / 1000000000u64 % 86400u64","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ":= compiled_out (level : trace_level) : bool =\n    run_target \\|\n        | Rust => \\ () =>\n            ?= level ?|\n            | Verbose => $'matches\\!(option_env\\!(\"SPIRAL_TRACE_FLOOR\"), Some(\"Debug\" | \"Info\" | \"Warning\" | \"Critical\"))' : bool\n            | Debug => $'matches\\!(option_env\\!(\"SPIRAL_TRACE_FLOOR\"), Some(\"Info\" | \"Warning\" | \"Critical\"))' : bool\n            | Info => $'matches\\!(option_env\\!(\"SPIRAL_TRACE_FLOOR\"), Some(\"Warning\" | \"Critical\"))' : bool\n            | Warning => $'matches\\!(option_env\\!(\"SPIRAL_TRACE_FLOOR\"), Some(\"Critical\"))' : bool\n            | Critical => !-\n        | _ => \\ () => !-\n\n:= trace_raw level fn =\n    \\ () =>\n        := trace_state =\n            ? compiled_out level || (level |> test_trace_level |> not)\n            ?> None\n            |:\n                := text = fn ()\n                := ({ count acc } & trace_state) = get_trace_state_or_init None\n                \\ () =>\n                    count <- *count + 1\n                |> exec_unit\n                :< rust_operators\n                run_target_args (\\ () => text, console::write_line) \\|\n                    | Zig => \\ _ => text |> console::write_line\n                    | Rust => \\ text, _ =>\n                        global \"\"\"\n                            #[cfg(target_arch = \"wasm32\")]\n                            fn spiral_trace_near_log(text: &str) {\n                                use std::sync::atomic::{AtomicUsize, Ordering};\n                                static LOGGED: AtomicUsize = AtomicUsize::new(0);\n                                let mut rest = text;\n                                while !rest.is_empty() {\n                                    let used = LOGGED.load(Ordering::Relaxed);\n                                    let budget = 16000usize.saturating_sub(used);\n                                    if budget < 13 {\n                                        break;\n                                    }\n                                    let mut end = rest.len().min(15000);\n                                    while !rest.is_char_boundary(end) {\n                                        end -= 1;\n                                    }\n                                    let (chunk, tail) = rest.split_at(end);\n                                    if chunk.len() <= budget {\n                                        LOGGED.store(used + chunk.len(), Ordering::Relaxed);\n                                        near_sdk::env::log_str(chunk);\n                                        rest = tail;\n                                    } else {\n                                        let mut cut = budget - 12;\n                                        while !chunk.is_char_boundary(cut) {\n                                            cut -= 1;\n                                        }\n                                        let s = format!(\"{} [truncated]\", &chunk[..cut]);\n                                        LOGGED.store(used + s.len(), Ordering::Relaxed);\n                                        near_sdk::env::log_str(&s);\n                                        break;\n                                    }\n                                }\n                            }\n                            \"\"\"\n                        ? $'cfg\\!(target_arch = \"wasm32\")' : bool\n                        ?>\n                            := new_acc =\n                                ? *acc = \"\"\n                                ?> text\n                                |? text = \"\"\n                                ?> *acc\n                                |: *acc ++\\# text\n                            := byte_count : convert::unativeint = !\\\\(new_acc, $'\"$0.len()\"')\n                            := chunks_len : i32 = ((convert::convert byte_count : i32) + 14999i32) / 15000i32\n                            ? text <>. \"\" && chunks_len <= 1i32\n                            ?> acc <- new_acc\n                            |:\n                                acc <- \"\"\n                                !\\\\(new_acc, $'\"{ ##[cfg(target_arch = \\\\\\\"wasm32\\\\\\\")] spiral_trace_near_log(&$0); }\"')\n                        |: !\\\\(text, $'\"println\\!(\\\\\\\"{}\\\\\\\", $0)\"')\n                    | _ => \\ text, write_line =>\n                        text |> write_line\n                text |> *trace_state::trace_file\n                trace_state |> Some\n        backend_switch {\n            Gleam = \\ () => $'let trace_state = fn () { !(trace_state |> optionm'.box) }' : ()\n            Lua = id : () -> ()\n            Fsharp = id : () -> ()\n            Python = id : () -> ()\n            Rust = id : () -> ()\n            TypeScript = id : () -> ()\n            Zig = id : () -> ()\n        }\n    |> exec_unit\n\n:= clock_two_digits (n : i32) : string =\n    (? n < 10i32 ?> \"0\" |: \"\") ++# sm'::obj_to_string n\n\n:! rust_clock_fields = $'[i64; 3]'\n\n:= rust_clock_shims () : () =\n    global \"\"\"\n        #[cfg(target_arch = \"wasm32\")]\n        fn spiral_cfg_local_clock() -> Option<[i64; 3]> { None }\n        #[cfg(all(windows, not(target_arch = \"wasm32\")))]\n        fn spiral_cfg_local_clock() -> Option<[i64; 3]> {\n            #[repr(C)] struct St([u16; 8]);\n            unsafe extern \"system\" { fn GetLocalTime(t: *mut St); }\n            let mut t = St([0; 8]);\n            unsafe { GetLocalTime(&mut t) };\n            Some([i64::from(t.0[4]), i64::from(t.0[5]), i64::from(t.0[6])])\n        }\n        #[cfg(all(unix, not(target_arch = \"wasm32\")))]\n        fn spiral_cfg_local_clock() -> Option<[i64; 3]> {\n            #[repr(C, align(8))] struct Tm([i32; 16]);\n            unsafe extern \"C\" { fn localtime_r(t: *const std::os::raw::c_long, tm: *mut Tm) -> *mut Tm; }\n            let now = std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).map(|d| d.as_secs());\n            let secs = std::os::raw::c_long::try_from(now.unwrap_or(0)).unwrap_or(0);\n            let mut tm = Tm([0; 16]);\n            unsafe { localtime_r(&secs, &mut tm) };\n            Some([i64::from(tm.0[2]), i64::from(tm.0[1]), i64::from(tm.0[0])])\n        }\n        #[cfg(not(any(windows, unix, target_arch = \"wasm32\")))]\n        fn spiral_cfg_local_clock() -> Option<[i64; 3]> { None }\n        #[cfg(target_arch = \"wasm32\")]\n        fn spiral_cfg_epoch_nanos() -> u64 { near_sdk::env::block_timestamp() }\n        #[cfg(not(target_arch = \"wasm32\"))]\n        fn spiral_cfg_epoch_nanos() -> u64 {\n            let since = std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH);\n            since.map(|d| u64::try_from(d.as_nanos()).unwrap_or(0)).unwrap_or(0)\n        }\n        \"\"\"\n\n:= rust_local_clock () : optionm'::option' rust_clock_fields =\n    rust_clock_shims ()\n    $'spiral_cfg_local_clock()' : optionm'::option' rust_clock_fields\n\n:= rust_epoch_nanos () : u64 =\n    rust_clock_shims ()\n    $'spiral_cfg_epoch_nanos()' : u64\n\n:= rust_clock_hour (fields : rust_clock_fields) : i64 = $'!fields[0]' : i64\n\n:= rust_clock_minute (fields : rust_clock_fields) : i64 = $'!fields[1]' : i64\n\n:= rust_clock_second (fields : rust_clock_fields) : i64 = $'!fields[2]' : i64\n\n:= local_seconds_of_day () : u64 =\n    ?= rust_local_clock () |> optionm'::unbox ?|\n    | Some fields =>\n        conv (rust_clock_hour fields * 3600i64 + rust_clock_minute fields * 60i64 + rust_clock_second fields)\n    | None => rust_epoch_nanos () / 1000000000u64 % 86400u64",
  timeout: 300_000
)
```

#### local_seconds_of_day_is_within_a_day (test)

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":"///- --test --symbol\n///> rust\n\n(local_seconds_of_day () < 86400u64) |> _assert_eq !+","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  ///- --test --symbol
  ///> rust

  (local_seconds_of_day () < 86400u64) |> _assert_eq !+
  """,
  timeout: 300_000
)
```

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":":= clock_text_of_seconds (seconds : u64) : string =\n    := two_digits (n : u64) : string = (? n < 10u64 ?> \"0\" |: \"\") ++# sm'::obj_to_string n\n    := hours_minutes = two_digits ((seconds / 3600u64) % 24u64) ++# \":\" ++# two_digits ((seconds / 60u64) % 60u64)\n    hours_minutes ++# \":\" ++# two_digits (seconds % 60u64)\n\n:= trace (level : trace_level) (text_fn : () -> string) (locals : () -> _) =\n    \\ () =>\n        := trace_state = get_trace_state_or_init None\n        := time =\n            ~~\n                run_target \\|\n                    | Zig => \\ () =>\n                        global \"\"\"extern \"kernel32\" fn GetLocalTime(t: *[8]u16) callconv(.winapi) void;\"\"\"\n                        global \"\"\"fn spiralClockSeconds() u64 {\n    var secs: u64 = 0;\n    if (builtin.os.tag == .windows) {\n        var t: [8]u16 = undefined;\n        GetLocalTime(&t);\n        secs = @as(u64, t[4]) * 3600 + @as(u64, t[5]) * 60 + @as(u64, t[6]);\n    } else if (builtin.os.tag == .linux) {\n        var ts: std.os.linux.timespec = undefined;\n        _ = std.os.linux.clock_gettime(.REALTIME, &ts);\n        secs = @intCast(ts.sec);\n    }\n    return secs;\n}\"\"\"\n                        := seconds : u64 = $'spiralClockSeconds()'\n                        clock_text_of_seconds seconds\n                    | _ => \\ () =>\n                        run_target \\ target =>\n                            ?= target ?|\n                            | Rust => \\ () =>\n                                :< rust_operators\n                                local_seconds_of_day () |> clock_text_of_seconds\n                            | TypeScript => \\ () =>\n                                := now = $'new Date()' : $'Date'\n                                := hours = $'!now.getHours()' : i32\n                                := minutes = $'!now.getMinutes()' : i32\n                                := seconds = $'!now.getSeconds()' : i32\n                                := hours_minutes = clock_two_digits hours ++# \":\" ++# clock_two_digits minutes\n                                hours_minutes ++# \":\" ++# clock_two_digits seconds\n                            | _ => \\ () =>\n                                ?= trace_state::repl_start |> optionm'::unbox ?|\n                                | Some repl_start =>\n                                    := t =\n                                        date_time::now ()\n                                        |> date_time::to_timestamp\n                                        |> \\ (date_time::timestamp x) => x\n                                        |> flip (-) repl_start\n                                        |> date_time::time_span_of_micros\n                                    date_time::date_time_milliseconds\n                                        1i32 1i32 1i32\n                                        (t |> date_time::hours)\n                                        (t |> date_time::minutes)\n                                        (t |> date_time::seconds)\n                                        (t |> date_time::milliseconds)\n                                | None => date_time::now ()\n                                |> date_time::format (\n                                    backend_switch {\n                                        Gleam = \\ () => \"HH:mm:ss\"\n                                        Lua = \\ () => \"%H:%M:%S\"\n                                        Fsharp = \\ () =>\n                                            ?= target ?|\n                                            | Rust => ~~ \"hh:mm:ss\"\n                                            | _ => ~~ \"HH:mm:ss\"\n                                        Python = \\ () => \"%H:%M:%S\"\n                                    }\n                                )\n        := level_str =\n            ~~\n                := color =\n                    ?= level ?|\n                    | Verbose => console::color_bright_black ()\n                    | Debug => console::color_bright_blue ()\n                    | Info => console::color_bright_green ()\n                    | Warning => console::color_yellow ()\n                    | Critical => console::color_bright_red ()\n                := level_str =\n                    level\n                    |> reflection::union_to_string\n                    |> sm'::to_lower\n                    |> sm'::index 0i32\n                    |> sm'::format\n                color ++# level_str ++# console::color_reset ()\n        := text = text_fn ()\n        ? text = \"\"\n        ?> \"\"\n        |:\n            := locals = locals ()\n            ~~\n                := count = *trace_state::count\n                time ++# \" \" ++#? count ++# level_str ++# \" \" ++# text ++# \" / \" ++#? locals\n                |> \\ x =>\n                    ~~\n                        x\n                        |> sm'::trim_start []\n                        |> sm'::trim_end [ ' '; '/' ]\n    |> trace_raw level","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ":= clock_text_of_seconds (seconds : u64) : string =\n    := two_digits (n : u64) : string = (? n < 10u64 ?> \"0\" |: \"\") ++# sm'::obj_to_string n\n    := hours_minutes = two_digits ((seconds / 3600u64) % 24u64) ++# \":\" ++# two_digits ((seconds / 60u64) % 60u64)\n    hours_minutes ++# \":\" ++# two_digits (seconds % 60u64)\n\n:= trace (level : trace_level) (text_fn : () -> string) (locals : () -> _) =\n    \\ () =>\n        := trace_state = get_trace_state_or_init None\n        := time =\n            ~~\n                run_target \\|\n                    | Zig => \\ () =>\n                        global \"\"\"extern \"kernel32\" fn GetLocalTime(t: *[8]u16) callconv(.winapi) void;\"\"\"\n                        global \"\"\"fn spiralClockSeconds() u64 {\n    var secs: u64 = 0;\n    if (builtin.os.tag == .windows) {\n        var t: [8]u16 = undefined;\n        GetLocalTime(&t);\n        secs = @as(u64, t[4]) * 3600 + @as(u64, t[5]) * 60 + @as(u64, t[6]);\n    } else if (builtin.os.tag == .linux) {\n        var ts: std.os.linux.timespec = undefined;\n        _ = std.os.linux.clock_gettime(.REALTIME, &ts);\n        secs = @intCast(ts.sec);\n    }\n    return secs;\n}\"\"\"\n                        := seconds : u64 = $'spiralClockSeconds()'\n                        clock_text_of_seconds seconds\n                    | _ => \\ () =>\n                        run_target \\ target =>\n                            ?= target ?|\n                            | Rust => \\ () =>\n                                :< rust_operators\n                                local_seconds_of_day () |> clock_text_of_seconds\n                            | TypeScript => \\ () =>\n                                := now = $'new Date()' : $'Date'\n                                := hours = $'!now.getHours()' : i32\n                                := minutes = $'!now.getMinutes()' : i32\n                                := seconds = $'!now.getSeconds()' : i32\n                                := hours_minutes = clock_two_digits hours ++# \":\" ++# clock_two_digits minutes\n                                hours_minutes ++# \":\" ++# clock_two_digits seconds\n                            | _ => \\ () =>\n                                ?= trace_state::repl_start |> optionm'::unbox ?|\n                                | Some repl_start =>\n                                    := t =\n                                        date_time::now ()\n                                        |> date_time::to_timestamp\n                                        |> \\ (date_time::timestamp x) => x\n                                        |> flip (-) repl_start\n                                        |> date_time::time_span_of_micros\n                                    date_time::date_time_milliseconds\n                                        1i32 1i32 1i32\n                                        (t |> date_time::hours)\n                                        (t |> date_time::minutes)\n                                        (t |> date_time::seconds)\n                                        (t |> date_time::milliseconds)\n                                | None => date_time::now ()\n                                |> date_time::format (\n                                    backend_switch {\n                                        Gleam = \\ () => \"HH:mm:ss\"\n                                        Lua = \\ () => \"%H:%M:%S\"\n                                        Fsharp = \\ () =>\n                                            ?= target ?|\n                                            | Rust => ~~ \"hh:mm:ss\"\n                                            | _ => ~~ \"HH:mm:ss\"\n                                        Python = \\ () => \"%H:%M:%S\"\n                                    }\n                                )\n        := level_str =\n            ~~\n                := color =\n                    ?= level ?|\n                    | Verbose => console::color_bright_black ()\n                    | Debug => console::color_bright_blue ()\n                    | Info => console::color_bright_green ()\n                    | Warning => console::color_yellow ()\n                    | Critical => console::color_bright_red ()\n                := level_str =\n                    level\n                    |> reflection::union_to_string\n                    |> sm'::to_lower\n                    |> sm'::index 0i32\n                    |> sm'::format\n                color ++# level_str ++# console::color_reset ()\n        := text = text_fn ()\n        ? text = \"\"\n        ?> \"\"\n        |:\n            := locals = locals ()\n            ~~\n                := count = *trace_state::count\n                time ++# \" \" ++#? count ++# level_str ++# \" \" ++# text ++# \" / \" ++#? locals\n                |> \\ x =>\n                    ~~\n                        x\n                        |> sm'::trim_start []\n                        |> sm'::trim_end [ ' '; '/' ]\n    |> trace_raw level",
  timeout: 300_000
)
```

#### trace_2 (test)

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":"///- --test --symbol\n///> gleam\n///> lua\n///> cuda\n///> rust\n///> typescript\n\ntrace Debug (\\ () => \"test1\") id\ntrace Debug (\\ () => \"test2\") id\nget_trace_state_or_init None ::count\n|> \\ x => *x\n|> _assert_eq 3","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  ///- --test --symbol
  ///> gleam
  ///> lua
  ///> cuda
  ///> rust
  ///> typescript

  trace Debug (\ () => "test1") id
  trace Debug (\ () => "test2") id
  get_trace_state_or_init None ::count
  |> \ x => *x
  |> _assert_eq 3
  """,
  timeout: 300_000
)
```

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Cells.SmartCell","attrs":{"timeout":300,"source":":= trace_format level fn obj =\n    := text, locals = fn obj\n    := locals = #?locals |> sm'::ellipsis_end 200\n    trace level (\\ () => text) \\ () => locals\n    obj\n\n///> fsharp\n\n:= main () =\n    init_trace_state None\n    := trace level text_fn (locals : () -> string) = trace level text_fn locals\n    $'let trace x = !trace x' : ()","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Cells.eval!(
  ~S"""
  := trace_format level fn obj =
      := text, locals = fn obj
      := locals = #?locals |> sm'::ellipsis_end 200
      trace level (\ () => text) \ () => locals
      obj

  ///> fsharp

  := main () =
      init_trace_state None
      := trace level text_fn (locals : () -> string) = trace level text_fn locals
      $'let trace x = !trace x' : ()
  """,
  timeout: 300_000
)
```
