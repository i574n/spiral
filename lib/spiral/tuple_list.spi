:# tuple_list static =
    :< testing

/// ## tuple_list
:! tuple_list n el =
    `(
        := ^ loop i = ? real_core::(>) i 0 ?> ``el, loop (real_core::(-) i 1) |: ``(())
        loop (real_core::type_lit_to_lit `n)
    )

:= tuple_length \* n el. (_ : tuple_list n el) : i32 = ~> real_core::type_lit_to_lit `n

:= tuple_bound_ok \* n el. (i : i32) (_ : tuple_list n el) : bool =
    ~> real_core::lit_is i && real_core::(>) (real_core::type_lit_to_lit `n) i && real_core::(>) (real_core::(+) i 1) 0

:= tuple_walk \* n el. (i : i32) (t : tuple_list n el) : el =
    ~>
        := ^ go j x = ? real_core::(>) j 0 ?> (:= _, rest = x ;; go (real_core::(-) j 1) rest) |: (:= v, _ = x ;; v)
        go i (real_core::nominal_strip t)

:= tuple_item \* n el. (i : i32) (t : tuple_list n el) : el =
    ? tuple_bound_ok i t ?> tuple_walk i t |: error_type "tuple_item: the index must be a literal in bounds"

:= tens () : tuple_list 3 i32 = ~> real_core::nominal_create `(tuple_list 3 i32) (10i32, 20i32, 30i32, ())

///> c
///> rust
///> lua
:# a_tuple_list_of_3_holds_3_items_in_order =
    (tuple_length (tens ()), tuple_item 0 (tens ()), tuple_item 2 (tens ())) |> _assert_eq (3i32, 10i32, 30i32)

///> c
:# an_index_past_the_end_is_a_compile_error fails "tuple_item: the index must be a literal in bounds" =
    tuple_item 3 (tens ()) |> _assert_eq 30i32
