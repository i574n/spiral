<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"inl (~!\\) forall t. (code : string) : t =\n    emit_expr () code","print_code":false},"livebook_object":"smart_cell"} -->

