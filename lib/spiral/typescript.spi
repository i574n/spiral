/// # typescript

/// ### emit_expr
inl emit_expr forall a t. (args : a) (code : string) : t =
    real
        $'Fable.Core.JsInterop.emitJsExpr !args !code ' : t

/// ###
inl (~!\) forall t. (code : string) : t =
    emit_expr () code

/// ###
inl (~!\\) forall t u. ((args : t), (code : string)) : u =
    emit_expr args code

/// ###
inl import_all forall t. (file : string) : t =
    real
        $'Fable.Core.JsInterop.importAll !file ' : t

/// ###
inl import forall t. (name : string) (file : string) : t =
    real
        $'Fable.Core.JsInterop.import !name !file ' : t

/// ### is_native
// The native TypeScript backend (codegenTypescript, `--backend TypeScript`); false in the F# build, whose `TypeScript`
// run_target arms are Fable's (F# text).
inl is_native () : bool =
    backend_switch {
        Gleam = fun () => false
        Lua = fun () => false
        Fsharp = fun () => false
        Python = fun () => false
        TypeScript = fun () => true
        Cpp = fun () => false
        CppHost = fun () => false
        Delphi = fun () => false
        Cuda = fun () => false
        Rust = fun () => false
    }
