/// # unicode
open sm'_operators

test unicode static =
    open testing

/// ## unicode

/// ### char_of
inl char_of (n : i32) : string =
    run_target function
        | Gleam => fun () =>
            global "import gleam/string"
            $'case string.utf_codepoint(!n) { Ok(c) -> string.from_utf_codepoints([c]) Error(_) -> "" }' : string
        | Rust => fun () =>
            $'Rc::<str>::from(char::from_u32(!n as u32).map(|c| c.to_string()).unwrap_or_default())' : string
        | C => fun () =>
            $'({ uint32_t spiral_c = (uint32_t)(!n); char spiral_b[5]; uint32_t spiral_k = 0; \
                if (spiral_c < 0x80u) { spiral_b[0] = (char)spiral_c; spiral_k = 1; } \
                else if (spiral_c < 0x800u) { spiral_b[0] = (char)(0xC0u | (spiral_c >> 6)); \
                    spiral_b[1] = (char)(0x80u | (spiral_c & 0x3Fu)); spiral_k = 2; } \
                else if (spiral_c >= 0xD800u && spiral_c <= 0xDFFFu) { spiral_k = 0; } \
                else if (spiral_c < 0x10000u) { spiral_b[0] = (char)(0xE0u | (spiral_c >> 12)); \
                    spiral_b[1] = (char)(0x80u | ((spiral_c >> 6) & 0x3Fu)); \
                    spiral_b[2] = (char)(0x80u | (spiral_c & 0x3Fu)); spiral_k = 3; } \
                else if (spiral_c < 0x110000u) { spiral_b[0] = (char)(0xF0u | (spiral_c >> 18)); \
                    spiral_b[1] = (char)(0x80u | ((spiral_c >> 12) & 0x3Fu)); \
                    spiral_b[2] = (char)(0x80u | ((spiral_c >> 6) & 0x3Fu)); \
                    spiral_b[3] = (char)(0x80u | (spiral_c & 0x3Fu)); spiral_k = 4; } \
                spiral_b[spiral_k] = 0; StringLit(spiral_k + 1, spiral_b); })' : string
        | Fsharp => fun () =>
            $'(if !n >= 0 && !n <= 0x10FFFF && (!n < 0xD800 || !n > 0xDFFF) \
                then System.Char.ConvertFromUtf32 !n else "")' : string
        | TypeScript => fun () =>
            $'((!n >= 0 && !n <= 0x10FFFF && (!n < 0xD800 || !n > 0xDFFF)) ? String.fromCodePoint(!n) : "")' : string
        | _ => fun () => failwith "unicode.char_of: no arm for this backend"

/// ### graphemes
inl graphemes (s : string) : list string =
    inl prepended = fun (acc : list string) (g : string) => Cons (g, acc)
    inl none : list string = Nil
    backend_switch {
        Gleam = fun () =>
            global "import gleam/list"
            global "import gleam/string"
            $'list.fold(list.reverse(string.to_graphemes(!s)), !none, fn(acc, g) { !prepended(acc)(g) })' : list string
        Rust = fun () =>
            $'unicode_segmentation::UnicodeSegmentation::graphemes(&*!s, true).rev().fold(!none, |acc, g| \
                (!prepended)(acc)(Rc::<str>::from(g)))' : list string
    }

/// ### first_code_point
inl first_code_point (s : string) : i32 =
    backend_switch {
        Gleam = fun () =>
            global "import gleam/string"
            $'case string.to_utf_codepoints(!s) { [c, ..] -> string.utf_codepoint_to_int(c) [] -> 0 }' : i32
        Rust = fun () => $'(&*!s).chars().next().map_or(0, |c| c as i32)' : i32
    }

/// ### code_point_count
inl code_point_count (s : string) : i32 =
    backend_switch {
        Gleam = fun () =>
            global "import gleam/list"
            global "import gleam/string"
            $'list.length(string.to_utf_codepoints(!s))' : i32
        Rust = fun () => $'(&*!s).chars().count() as i32' : i32
    }

/// ### nfc
inl nfc (s : string) : string =
    backend_switch {
        Gleam = fun () =>
            global """
                @ external(erlang, "unicode", "characters_to_nfc_binary")
                fn unicode_erlang_nfc(s: String) -> String
                """
            $'unicode_erlang_nfc(!s)' : string
        Rust = fun () =>
            $'Rc::<str>::from(unicode_normalization::UnicodeNormalization::nfc(&*!s).collect::<String>())' : string
    }

inl unicode_decomposed_e () : string = "e" ++# char_of 769i32

inl unicode_thumb_with_tone () : string = char_of 128077i32 ++# char_of 127997i32

inl unicode_first (l : list string) : string =
    match l with
    | Cons (g, _) => g
    | Nil => ""

///> rust -d unicode-segmentation
///> gleam
test graphemes_hold_clusters =
    inl ~s = "a" ++# unicode_decomposed_e () ++# " " ++# unicode_thumb_with_tone () ++# "."
    ((listm.length (graphemes s) : i32), (listm.length (graphemes "") : i32), unicode_first (graphemes s))
    |> _assert_eq (5i32, 0i32, "a")

///> rust
///> gleam
test code_points_count_scalars_not_bytes =
    inl ~s = unicode_thumb_with_tone ()
    (code_point_count s, first_code_point s, code_point_count (unicode_decomposed_e ()), first_code_point "")
    |> _assert_eq (2i32, 128077i32, 2i32, 0i32)

///> rust
///> gleam
///> c
test char_of_encodes_utf8_and_rejects_surrogates =
    inl ~e = 233i32
    (sm.length (char_of e), sm.length (char_of 128512i32), sm.length (char_of 55296i32))
    |> _assert_eq (2i32, 4i32, 0i32)

///> rust -d unicode-normalization
///> gleam
test nfc_composes =
    inl ~s = unicode_decomposed_e ()
    nfc s |> _assert_eq (char_of 233i32)
