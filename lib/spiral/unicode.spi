:< sm'_operators
:< unsupported

:# unicode static =
    :< testing

/// ## unicode
:= unicode_types () =
    backend_switch {
        Gleam = \ () =>
            global "import gleam/list"
            global "import gleam/string"
            global "import gleam/result"
        Rust = \ () => ()
        Pascal = \ () => ()
    }

:= is_scalar_value (n : i32) : bool = n >= 0i32 && n <= 1114111i32 && (n < 55296i32 || n > 57343i32)

:= utf8_lead (byte_text : u8 -> string) (mark : u32) (shift : i32) (c : u32) : string =
    byte_text (conv (mark ||| (c >>> shift)))

:= utf8_continuation (byte_text : u8 -> string) (shift : i32) (c : u32) : string =
    byte_text (conv (128u32 ||| ((c >>> shift) &&& 63u32)))

:= utf8_text (byte_text : u8 -> string) (n : i32) : string =
    := c : u32 = conv n
    := lead mark shift = utf8_lead byte_text mark shift c
    := continuation shift = utf8_continuation byte_text shift c
    ? c < 128u32
    ?> byte_text (conv c)
    |? c < 2048u32
    ?> lead 192u32 6i32 ++# continuation 0i32
    |? c < 65536u32
    ?> lead 224u32 12i32 ++# continuation 6i32 ++# continuation 0i32
    |: lead 240u32 18i32 ++# continuation 12i32 ++# continuation 6i32 ++# continuation 0i32

:= c_byte_text (b : u8) : string =
    $'StringLit(2, (char[]){ !b, 0 })' : string

:= pascal_byte_text (b : u8) : string =
    $'AnsiString(AnsiChar(!b))' : string

:= zig_byte_text (b : u8) : string =
    $'(spiral_gpa.dupe(u8, &[_]u8{ !b }) catch @@panic("out of memory"))' : string

:! rust_scalar = $'char'

:= rust_char_of_u32 (c : u32) : optionm'::option' rust_scalar =
    $'char::from_u32(!c)' : optionm'::option' rust_scalar

:= rust_char_code (c : rust_scalar) : u32 =
    $'u32::from(!c)' : u32

:= gleam_erlang_characters () =
    global """
        @ external(erlang, "unicode", "characters_to_binary")
        fn unicode_erlang_characters_to_binary(chars: List(Int)) -> String
        """

:= scalar_text (n : i32) : string =
    run_target \|
        | Gleam => \ () =>
            gleam_erlang_characters ()
            $'unicode_erlang_characters_to_binary([!n])' : string
        | Rust => \ () => (conv n : u32) |> rust_char_of_u32 |> optionm'::unwrap |> sm'::obj_to_string
        | C => \ () => utf8_text c_byte_text n
        | Pascal => \ () => utf8_text pascal_byte_text n
        | Zig => \ () => utf8_text zig_byte_text n
        | Fsharp => \ () => $'System.Char.ConvertFromUtf32 !n' : string
        | TypeScript => \ () => $'String.fromCodePoint(!n)' : string
        | _ => \ () => no_arm "unicode.scalar_text"

:= char_of (n : i32) : string =
    ? is_scalar_value n ?> scalar_text n |: ""

:= grapheme_list (s : string) : listm'::list' string =
    unicode_types ()
    backend_switch {
        Gleam = \ () => $'string.to_graphemes(!s)' : listm'::list' string
        Rust = \ () =>
            $'Rc::new(unicode_segmentation::UnicodeSegmentation::graphemes(&*!s, true).map(Rc::<str>::from).collect())'
            : listm'::list' string
    }

:= graphemes (s : string) : list string =
    s |> grapheme_list |> listm'::rev' |> listm'::fold' id []

:= first_scalar (s : string) : optionm'::option' u32 =
    unicode_types ()
    backend_switch {
        Gleam = \ () =>
            $'option.from_result(result.map(list.first(string.to_utf_codepoints(!s)), string.utf_codepoint_to_int))'
            : optionm'::option' u32
        Rust = \ () => ($'(&*!s).chars().next()' : optionm'::option' rust_scalar) |> optionm'::map rust_char_code
    }

:= first_code_point (s : string) : i32 =
    s |> first_scalar |> optionm'::map (\ c => conv c) |> optionm'::default_value' 0i32

:~ ^ pascal_code_point_count_from (s : string) (i : i32) (acc : i32) : i32 =
    ? i >= sm'::length s
    ?> acc
    |:
        := byte = $'Ord((!s)[!i + 1])' : i32
        pascal_code_point_count_from s (i + 1i32) (? byte >= 128i32 && byte < 192i32 ?> acc |: acc + 1i32)

:= code_point_count (s : string) : i32 =
    unicode_types ()
    backend_switch {
        Gleam = \ () => $'list.length(string.to_utf_codepoints(!s))' : i32
        Rust = \ () => ($'(&*!s).chars().count()' : convert::unativeint) |> convert::convert : i32
        Zig = \ () =>
            := count : u64 = $'std.unicode.utf8CountCodepoints(!s) catch 0'
            conv count : i32
        Pascal = \ () => pascal_code_point_count_from s 0i32 0i32
    }

:! gleam_codepoint = $'string.UtfCodepoint'

:= gleam_codepoints (s : string) : listm'::list' gleam_codepoint =
    unicode_types ()
    $'string.to_utf_codepoints(!s)' : listm'::list' gleam_codepoint

:= gleam_codepoint_code (c : gleam_codepoint) : i32 =
    unicode_types ()
    $'string.utf_codepoint_to_int(!c)' : i32

:= rust_scalars (s : string) : listm'::list' rust_scalar =
    $'Rc::new((&*!s).chars().collect())' : listm'::list' rust_scalar

:= code_points (s : string) : list i32 =
    backend_switch {
        Gleam = \ () => s |> gleam_codepoints |> listm'::rev' |> listm'::fold' gleam_codepoint_code []
        Rust = \ () => s |> rust_scalars |> listm'::rev' |> listm'::fold' (\ c => (conv (rust_char_code c) : i32)) []
    }

:= is_white_space (c : i32) : bool =
    (c >= 9i32 && c <= 13i32) || c = 32i32 || c = 133i32 || c = 160i32 || c = 5760i32 || (c >= 8192i32 && c <= 8202i32)
    || c = 8232i32 || c = 8233i32 || c = 8239i32 || c = 8287i32 || c = 12288i32

///> rust
///> gleam
:# code_points_list_scalars_in_order =
    "a" ++# char_of 228i32 ++# char_of 128077i32 |> code_points |> _assert_eq [ 97i32; 228i32; 128077i32 ]

///> rust
///> gleam
:# white_space_is_the_unicode_property =
    [ 32i32; 9i32; 12288i32; 8203i32; 65i32 ] |> listm::map is_white_space |> _assert_eq [ !+; !+; !+; !-; !- ]

:= rust_scalar_is_alphanumeric (c : rust_scalar) : bool = $'!c.is_alphanumeric()' : bool

:= rust_is_alphanumeric (c : i32) : bool =
    (conv c : u32) |> rust_char_of_u32 |> optionm'::map rust_scalar_is_alphanumeric |> optionm'::default_value' !-

:= is_alphanumeric (c : i32) : bool =
    run_target \|
        | Rust => \ () => rust_is_alphanumeric c
        | _ => \ () => no_arm "unicode.is_alphanumeric"

///> rust
:# is_alphanumeric_is_the_unicode_property_of_code_points =
    [ 97i32; 55i32; 233i32; 1488i32; 45i32; 8203i32; 55296i32 ]
    |> listm::map is_alphanumeric
    |> _assert_eq [ !+; !+; !+; !+; !-; !-; !- ]

///> rust
:# is_alphanumeric_reads_every_scalar_of_a_text =
    "a7" ++# char_of 233i32 ++# char_of 1488i32
    |> code_points
    |> listm::map is_alphanumeric
    |> _assert_eq [ !+; !+; !+; !+ ]

:= nfc (s : string) : string =
    backend_switch {
        Gleam = \ () =>
            global """
                @ external(erlang, "unicode", "characters_to_nfc_binary")
                fn unicode_erlang_nfc(s: String) -> String
                """
            $'unicode_erlang_nfc(!s)' : string
        Rust = \ () =>
            $'Rc::<str>::from(unicode_normalization::UnicodeNormalization::nfc(&*!s).collect::<String>())' : string
    }

:= unicode_decomposed_e () : string = "e" ++# char_of 769i32

:= unicode_thumb_with_tone () : string = char_of 128077i32 ++# char_of 127997i32

:= unicode_first (l : list string) : string =
    ?= l ?|
    | g :: _ => g
    | [] => ""

///> rust -d unicode-segmentation
///> gleam
:# graphemes_hold_clusters =
    := ~s = "a" ++# unicode_decomposed_e () ++# " " ++# unicode_thumb_with_tone () ++# "."
    ((listm::length (graphemes s) : i32), (listm::length (graphemes "") : i32), unicode_first (graphemes s))
    |> _assert_eq (5i32, 0i32, "a")

///> rust
///> gleam
:# code_points_count_scalars_not_bytes =
    := ~s = unicode_thumb_with_tone ()
    (code_point_count s, first_code_point s, code_point_count (unicode_decomposed_e ()), first_code_point "")
    |> _assert_eq (2i32, 128077i32, 2i32, 0i32)

///> rust
///> gleam
///> c
///> pascal
///> zig
:# char_of_encodes_utf8_and_rejects_surrogates =
    := ~e = 233i32
    (sm::length (char_of e), sm::length (char_of 128512i32), sm::length (char_of 55296i32))
    |> _assert_eq (2i32, 4i32, 0i32)

///> rust
///> gleam
///> c
///> zig
:# char_of_covers_every_utf8_width =
    := ~a = 65i32
    (
        sm::length (char_of a),
        sm::length (char_of 2047i32),
        sm::length (char_of 65535i32),
        sm::length (char_of 1114111i32)
    )
    |> _assert_eq (1i32, 2i32, 3i32, 4i32)

///> rust -d unicode-normalization
///> gleam
:# nfc_composes =
    := ~s = unicode_decomposed_e ()
    nfc s |> _assert_eq (char_of 233i32)

:~ ^ spaces_of (k : i32) (acc : string) : string = ? k <= 0i32 ?> acc |: spaces_of (k - 1i32) (acc ++# " ")

:= pad_points_right (width : i32) (text : string) : string =
    text ++# spaces_of (width - listm::length (code_points text)) ""

///> rust
:# a_pad_counts_code_points_not_bytes =
    (pad_points_right 4i32 "ab", pad_points_right 3i32 "é", pad_points_right 1i32 "abc")
    |> _assert_eq ("ab  ", "é  ", "abc")

:= unicode_byte_ffi () : () =
    global """
        @external(erlang, "erlang", "byte_size")
        fn spiral_unicode_byte_count(text: String) -> Int
        """
    global """
        @external(erlang, "binary", "part")
        fn spiral_unicode_byte_part(text: String, at: Int, len: Int) -> String
        """
    global """
        @external(erlang, "binary", "at")
        fn spiral_unicode_byte_at(text: String, at: Int) -> Int
        """
    global """
        @external(erlang, "binary", "split")
        fn spiral_unicode_byte_split(text: String, pat: String) -> List(String)
        """
    global """
        fn spiral_unicode_byte_find(text: String, pat: String) -> Int {
          case spiral_unicode_byte_split(text, pat) {
            [before, _] -> spiral_unicode_byte_count(before)
            _ -> -1
          }
        }
        """

:= byte_count (s : string) : i32 =
    backend_switch {
        Gleam = \ () =>
            unicode_byte_ffi ()
            $'spiral_unicode_byte_count(!s)' : i32
        Rust = \ () => $'!s.len() as i32' : i32
    }

:= raw_byte_part (s : string) (at : i32) (n : i32) : string =
    backend_switch {
        Gleam = \ () =>
            unicode_byte_ffi ()
            $'spiral_unicode_byte_part(!s, !at, !n)' : string
        Rust = \ () => $'Rc::<str>::from(String::from_utf8_lossy(&!s.as_bytes()[(!at as usize)..((!at + !n) as usize)]).as_ref())' : string
    }

:= byte_part (s : string) (at : i32) (n : i32) : string =
    := size = byte_count s
    ? at < 0i32 || n <= 0i32 || at >= size ?> "" |: raw_byte_part s at (? at + n > size ?> size - at |: n)

:= raw_byte_at (s : string) (i : i32) : i32 =
    backend_switch {
        Gleam = \ () =>
            unicode_byte_ffi ()
            $'spiral_unicode_byte_at(!s, !i)' : i32
        Rust = \ () => $'!s.as_bytes()[!i as usize] as i32' : i32
    }

:= byte_at (s : string) (i : i32) : i32 = ? i < 0i32 || i >= byte_count s ?> -1i32 |: raw_byte_at s i

:= raw_byte_find (pat : string) (s : string) : i32 =
    backend_switch {
        Gleam = \ () =>
            unicode_byte_ffi ()
            $'spiral_unicode_byte_find(!s, !pat)' : i32
        Rust = \ () => $'!s.as_bytes().windows(!pat.len()).position(|w| w == !pat.as_bytes()).map(|i| i as i32).unwrap_or(-1)' : i32
    }

:= byte_find (pat : string) (s : string) (from : i32) : i32 =
    := at = ? from < 0i32 ?> 0i32 |: from
    := size = byte_count s
    ? byte_count pat = 0i32 ?> at
    |? at + byte_count pat > size ?> -1i32
    |:
        := found = raw_byte_find pat (byte_part s at (size - at))
        ? found < 0i32 ?> -1i32 |: at + found

///> rust
///> gleam
:# byte_text_counts_and_cuts_utf8_bytes =
    := ~s = "a" ++# char_of 233i32 ++# "b"
    (byte_count s, byte_at s 1i32, byte_at s 3i32, byte_at s 4i32, byte_part s 3i32 5i32, byte_part s 0i32 1i32, byte_part s 9i32 1i32)
    |> _assert_eq (4i32, 195i32, 98i32, -1i32, "b", "a", "")

///> rust
///> gleam
:# byte_find_returns_byte_offsets_past_multibyte_text =
    := ~s = char_of 233i32 ++# "x=" ++# char_of 233i32 ++# "x="
    (byte_find "x=" s 0i32, byte_find "x=" s 3i32, byte_find "zz" s 0i32, byte_find "x=" s 7i32, byte_find "" s 5i32)
    |> _assert_eq (2i32, 6i32, -1i32, -1i32, 5i32)

:= grapheme_ffi () : () =
    unicode_types ()
    global """
        fn spiral_unicode_first_grapheme(text: String) -> String {
          case string.pop_grapheme(text) {
            Ok(#(first, _)) -> first
            Error(_) -> ""
          }
        }
        """
    global """
        fn spiral_unicode_rest_graphemes(text: String) -> String {
          case string.pop_grapheme(text) {
            Ok(#(_, rest)) -> rest
            Error(_) -> ""
          }
        }
        """

:= grapheme_count (s : string) : i32 =
    backend_switch {
        Gleam = \ () =>
            grapheme_ffi ()
            $'string.length(!s)' : i32
        Rust = \ () => $'unicode_segmentation::UnicodeSegmentation::graphemes(&*!s, true).count() as i32' : i32
    }

:= first_grapheme (s : string) : string =
    backend_switch {
        Gleam = \ () =>
            grapheme_ffi ()
            $'spiral_unicode_first_grapheme(!s)' : string
        Rust = \ () => $'Rc::<str>::from(unicode_segmentation::UnicodeSegmentation::graphemes(&*!s, true).next().unwrap_or(""))' : string
    }

:= rest_graphemes (s : string) : string =
    backend_switch {
        Gleam = \ () =>
            grapheme_ffi ()
            $'spiral_unicode_rest_graphemes(!s)' : string
        Rust = \ () => $'Rc::<str>::from(unicode_segmentation::UnicodeSegmentation::graphemes(&*!s, true).skip(1).collect::<String>().as_str())' : string
    }

:= raw_grapheme_slice (s : string) (at : i32) (n : i32) : string =
    backend_switch {
        Gleam = \ () =>
            grapheme_ffi ()
            $'string.slice(!s, !at, !n)' : string
        Rust = \ () => $'Rc::<str>::from(unicode_segmentation::UnicodeSegmentation::graphemes(&*!s, true).skip(!at as usize).take(!n as usize).collect::<String>().as_str())' : string
    }

:= grapheme_slice (s : string) (at : i32) (n : i32) : string = ? at < 0i32 || n <= 0i32 ?> "" |: raw_grapheme_slice s at n

///> rust -d unicode-segmentation
///> gleam
:# grapheme_stepping_keeps_clusters_whole =
    := ~s = unicode_decomposed_e () ++# "b" ++# unicode_thumb_with_tone ()
    (
        grapheme_count s,
        first_grapheme s = unicode_decomposed_e (),
        rest_graphemes s = "b" ++# unicode_thumb_with_tone (),
        grapheme_slice s 1i32 1i32,
        grapheme_slice s 2i32 5i32 = unicode_thumb_with_tone (),
        first_grapheme "",
        rest_graphemes "",
        grapheme_slice s (-1i32) 1i32
    )
    |> _assert_eq (3i32, !+, !+, "b", !+, "", "", "")
