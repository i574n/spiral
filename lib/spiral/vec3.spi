:# vec3 static =
    :< testing

:< math

:== vec = { x : f64; y : f64; z : f64 }

:= vec (x : f64) (y : f64) (z : f64) : vec = { x y z }

:= i_hat () : vec = vec 1f64 0f64 0f64

:= j_hat () : vec = vec 0f64 1f64 0f64

:= k_hat () : vec = vec 0f64 0f64 1f64

:= zero_vec () : vec = vec 0f64 0f64 0f64

:= (^+^) (a : vec) (b : vec) : vec = vec (a::x + b::x) (a::y + b::y) (a::z + b::z)

:= sum_vec (vs : list vec) : vec = vs |> listm::fold (^+^) (zero_vec ())

:= (*^) (c : f64) ({ x y z } : vec) : vec = vec (c * x) (c * y) (c * z)

:= (^*) (v : vec) (c : f64) : vec = c *^ v

:= (^/) ({ x y z } : vec) (c : f64) : vec = vec (x / c) (y / c) (z / c)

:= negate_vec (v : vec) : vec = v ^* -1f64

:= (^-^) (a : vec) (b : vec) : vec = a ^+^ negate_vec b

:= (<.>) ({ x = ax y = ay z = az } : vec) ({ x = bx y = by z = bz } : vec) : f64 = ax * bx + ay * by + az * bz

:= (><) (a : vec) (b : vec) : vec =
    vec (a::y * b::z - a::z * b::y) (a::z * b::x - a::x * b::z) (a::x * b::y - a::y * b::x)

:= magnitude (v : vec) : f64 = sqrt (v <.> v)

:= normalized_above (floor : f64) (v : vec) : option vec =
    := m = magnitude v
    ? m <= floor ?> None |: Some (v ^/ m)

:= normalized (v : vec) : option vec = normalized_above 0f64 v

:= angle_between (a : vec) (b : vec) : f64 = atan2 (magnitude (a >< b)) (a <.> b)

///> rust
///> zig
:# vec3_arithmetic =
    (vec 1f64 2f64 3f64 ^+^ vec 4f64 5f64 6f64, 5f64 *^ vec 1f64 2f64 3f64, vec 1f64 2f64 3f64 ^-^ vec 4f64 5f64 6f64)
    |> _assert_eq (vec 5f64 7f64 9f64, vec 5f64 10f64 15f64, vec -3f64 -3f64 -3f64)

///> rust
///> zig
:# vec3_products =
    (vec 1f64 2f64 3f64 <.> vec 4f64 5f64 6f64, vec 1f64 2f64 3f64 >< vec 4f64 5f64 6f64)
    |> _assert_eq (32f64, vec -3f64 6f64 -3f64)

///> rust
:# the_zero_vector_has_no_direction =
    (normalized (zero_vec ()), normalized_above 0.1f64 (vec 0.05f64 0f64 0f64), normalized (vec 0f64 3f64 4f64))
    |> _assert_eq (None, None, Some (vec 0f64 0.6f64 0.8f64))

///> rust
:# a_nanoradian_angle_survives_between_vectors =
    angle_between (vec 1f64 0f64 0f64) (vec 1f64 0.000000001f64 0f64)
    |> _assert_approx_eq (Some 0.000000000000001f64) 0.000000001f64
