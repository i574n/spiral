### set_inner_html

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"inl set_inner_html (html : string) (el : html_element) =\n    inl html = join html\n    inl html = html |> sm'.as_str\n    inl el = join el\n    !\\\\(html, $'\"!el.set_inner_html($0)\"')","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  inl set_inner_html (html : string) (el : html_element) =
      inl html = join html
      inl html = html |> sm'.as_str
      inl el = join el
      !\\(html, $'"!el.set_inner_html($0)"')
  """,
  timeout: 300_000
)
```

### from_js_value

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"inl from_js_value (value : js_value) : resultm.result' (optionm'.option' sm'.json_value) sm'.std_string =\n    inl value = join value\n    !\\($'\"serde_wasm_bindgen::from_value(!value)\"')\n    |> resultm.map_error' fun (x : sm'.serde_wasm_bindgen_error) => x |> sm'.format'","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  inl from_js_value (value : js_value) : resultm.result' (optionm'.option' sm'.json_value) sm'.std_string =
      inl value = join value
      !\($'"serde_wasm_bindgen::from_value(!value)"')
      |> resultm.map_error' fun (x : sm'.serde_wasm_bindgen_error) => x |> sm'.format'
  """,
  timeout: 300_000
)
```
