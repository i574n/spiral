/// # wasm
open rust
open rust_operators

/// ### rexie
nominal rexie =
    `(
        rust_type
            `($'rexie_Rexie')
            `($'rexie::Rexie')
            "type rexie_Rexie = class end"
    )

/// ### rexie_store
nominal rexie_store =
    `(
        rust_type
            `($'rexie_Store')
            `($'rexie::Store')
            "type rexie_Store = class end"
    )

/// ### rexie_transaction
nominal rexie_transaction =
    `(
        rust_type
            `($'rexie_Transaction')
            `($'rexie::Transaction')
            "type rexie_Transaction = class end"
    )

/// ### rexie_error
nominal rexie_error =
    `(
        rust_type
            `($'rexie_Error')
            `($'rexie::Error')
            "type rexie_Error = class end"
    )

/// ### js_value
nominal js_value =
    `(
        rust_type
            `($'wasm_bindgen_JsValue')
            `($'wasm_bindgen::JsValue')
            "type wasm_bindgen_JsValue = class end"
    )

/// ### closure
nominal closure t =
    `(
        rust_type
            `($'wasm_bindgen_closure_Closure<`t>')
            `($'wasm_bindgen::closure::Closure<`t>')
            "type wasm_bindgen_closure_Closure<'T> = class end"
    )

/// ### js_function
nominal js_function =
    `(
        rust_type
            `($'js_sys_Function')
            `($'js_sys::Function')
            "type js_sys_Function = class end"
    )

/// ### window
nominal window =
    `(
        rust_type
            `($'web_sys_Window')
            `($'web_sys::Window')
            "type web_sys_Window = class end"
    )

/// ### document
nominal document =
    `(
        rust_type
            `($'web_sys_Document')
            `($'web_sys::Document')
            "type web_sys_Document = class end"
    )

/// ### html_element
nominal html_element =
    `(
        rust_type
            `($'web_sys_HtmlElement')
            `($'web_sys::HtmlElement')
            "type web_sys_HtmlElement = class end"
    )

/// ### storage
nominal storage =
    `(
        rust_type
            `($'web_sys_Storage')
            `($'web_sys::Storage')
            "type web_sys_Storage = class end"
    )

/// ### closure_wrap
inl closure_wrap forall t. (x : rust.box t) : closure t =
    // Rust: a Box<dyn Fn> isn't Clone, so it goes to the macro as is (a join point's argument is cloned)
    inl x = if is_rust () then x else join x
    !\($'"wasm_bindgen::closure::Closure::wrap(!x)"')

/// ### closure_forget
inl closure_forget forall t. (closure : closure t) =
    !\($'"!closure.forget()"') : ()

/// ### closure_as_ref
inl closure_as_ref forall t. (closure : closure t) : rust.ref js_value =
    !\($'"wasm_bindgen::closure::Closure::as_ref(&!closure)"')

/// ### unchecked_ref
inl unchecked_ref (ref : rust.ref js_value) : rust.ref js_function =
    !\($'"wasm_bindgen::JsCast::unchecked_ref(!ref)"')

/// ### set_inner_html
inl set_inner_html (html : string) (el : html_element) =
    inl html = join html
    inl html = html |> sm'.as_str
    inl el = join el
    !\\(html, $'"!el.set_inner_html($0)"')

/// ### from_js_value
inl from_js_value (value : js_value) : resultm.result' (optionm'.option' sm'.json_value) sm'.std_string =
    inl value = join value
    !\($'"serde_wasm_bindgen::from_value(!value)"')
    |> resultm.map_error' fun (x : sm'.serde_wasm_bindgen_error) => x |> sm'.format'
