:< sm'_operators

:| ^ xml_node =
    | XmlElement : string * list (string * string) * list xml_node
    | XmlText : string

:= rust_first_char (s : string) (i : i32) : optionm'.option' unicode.rust_scalar =
    := at : convert.unativeint = convert.convert i
    $'(&*!s)[!at..].chars().next()' : optionm'.option' unicode.rust_scalar

:= rust_char_width (c : unicode.rust_scalar) : convert.unativeint =
    $'!c.len_utf8()' : convert.unativeint

:= zig_sequence_width (s : string) (i : i32) : u8 =
    := at : u64 = conv i
    $'std.unicode.utf8ByteSequenceLength((!s)[!at]) catch 1' : u8

:= code_point_at (s : string) (i : i32) : u32 =
    run_target \|
        | Rust => \ () => rust_first_char s i |> optionm'.map unicode.rust_char_code |> optionm'.unwrap_or 0u32
        | _ => \ () => failwith "code_point_at: no arm for this backend"

:= code_point_width (s : string) (i : i32) : i32 =
    run_target \|
        | Rust => \ () =>
            rust_first_char s i
            |> optionm'.map (\ c => convert.convert (rust_char_width c))
            |> optionm'.unwrap_or 1i32
        | Zig => \ () => ? i < sm'.length s ?> conv (zig_sequence_width s i) |: 1i32
        | _ => \ () => failwith "code_point_width: no arm for this backend"

:= code_point_count (s : string) : i32 = unicode.code_point_count s

:= code_point_string (c : u32) : string = unicode.char_of (conv c)

:= code_point_text (s : string) (i : i32) : string = sm'.substring i (code_point_width s i) s

:= read_text_replacing_invalid_utf8 (path : string) : string =
    run_target \|
        | Rust => fun () => $'std::rc::Rc::<str>::from(String::from_utf8_lossy(&std::fs::read(&*!path).unwrap()).as_re\
            f())' : string
        | _ => \ () => file_system.read_all_text path

:= is_file (path : string) : bool =
    run_target \|
        | Rust => \ () => $'std::path::Path::new(&*!path).is_file()' : bool
        | _ => \ () => failwith "is_file: no arm for this backend"

:= at (s : string) (pos : i32) : string = code_point_text s pos

:= is_space (c : string) : bool = c = " " || c = "\n" || c = "\r" || c = "\t"

:= is_name_end (c : string) : bool = is_space c || c = "/" || c = ">" || c = "="

:= decode_entities (text : string) : string =
    text
    |> sm'.replace "&lt;" "<"
    |> sm'.replace "&gt;" ">"
    |> sm'.replace "&quot;" "\""
    |> sm'.replace "&apos;" "'"
    |> sm'.replace "&amp;" "&"

:~ ^ skip_spaces (s : string) (pos : i32) : i32 =
    ? pos < sm'.length s && is_space (at s pos) ?> skip_spaces s (pos + 1i32) |: pos

:~ ^ name_end (s : string) (pos : i32) : i32 =
    ? pos < sm'.length s && is_name_end (at s pos) = !- ?> name_end s (pos + code_point_width s pos) |: pos

:= find_from (needle : string) (s : string) (pos : i32) : i32 =
    run_target \|
        | Rust => fun () => $'(&*!s)[(!pos as usize)..].find(&*!needle).map(|i| (i + !pos as usize) as \
            i32).unwrap_or(-1)' : i32
        | _ => \ () =>
            := found = sm'.substring pos (sm'.length s - pos) s |> sm'.index_of needle
            ? found < 0i32 ?> -1i32 |: pos + found

:~ ^ reverse_nodes (rest : list xml_node) (acc : list xml_node) : list xml_node =
    ?= rest ?|
    | x :: xs => reverse_nodes xs (x :: acc)
    | Nil => acc

:~ ^ reverse_attributes (rest : list (string * string)) (acc : list (string * string)) : list (string * string) =
    ?= rest ?|
    | x :: xs => reverse_attributes xs (x :: acc)
    | Nil => acc

:~ ^ read_attributes (s : string) (pos : i32) (acc : list (string * string)) : list (string * string) * i32 =
    := pos = skip_spaces s pos
    := c = at s pos
    ? c = ">" || c = "/" || c = "?" ?> reverse_attributes acc Nil, pos
    |:
        := name_stop = name_end s pos
        := name = sm'.substring pos (name_stop - pos) s
        := eq = skip_spaces s name_stop
        := quote_at = skip_spaces s (eq + 1i32)
        := quote = at s quote_at
        := value_stop = find_from quote s (quote_at + 1i32)
        := value = sm'.substring (quote_at + 1i32) (value_stop - quote_at - 1i32) s |> decode_entities
        read_attributes s (value_stop + 1i32) ((name, value) :: acc)

:~ ^ read_nodes (s : string) (pos : i32) (acc : list xml_node) : list xml_node * i32 =
    ? pos >= sm'.length s ?> reverse_nodes acc Nil, pos
    |? at s pos <> "<" ?>
        := stop = find_from "<" s pos
        := stop = ? stop < 0i32 ?> sm'.length s |: stop
        := text = sm'.substring pos (stop - pos) s |> sm'.trim |> decode_entities
        read_nodes s stop (? text = "" ?> acc |: XmlText text :: acc)
    |? sm'.substring pos 4i32 s = "<!--" ?> read_nodes s (find_from "-->" s pos + 3i32) acc
    |? sm'.substring pos 2i32 s = "<?" ?> read_nodes s (find_from "?>" s pos + 2i32) acc
    |? sm'.substring pos 2i32 s = "<!" ?> read_nodes s (find_from ">" s pos + 1i32) acc
    |? sm'.substring pos 2i32 s = "</" ?> reverse_nodes acc Nil, find_from ">" s pos + 1i32
    |:
        := name_stop = name_end s (pos + 1i32)
        := name = sm'.substring (pos + 1i32) (name_stop - pos - 1i32) s
        := attributes, after = read_attributes s name_stop Nil
        ? at s after = "/" ?> read_nodes s (after + 2i32) (XmlElement (name, attributes, Nil) :: acc)
        |:
            := children, after_children = read_nodes s (after + 1i32) Nil
            read_nodes s after_children (XmlElement (name, attributes, children) :: acc)

:= read_xml (s : string) : list xml_node =
    := nodes, _ = read_nodes s 0i32 Nil
    nodes

:= local_name (name : string) : string =
    := colon = sm'.index_of ":" name
    ? colon < 0i32 ?> name |: sm'.substring (colon + 1i32) (sm'.length name - colon - 1i32) name

:~ ^ count_named (target : string) (nodes : list xml_node) : i32 =
    ?= nodes ?|
    | XmlElement (name, _, children) :: rest =>
        (? local_name name = target ?> 1i32 |: 0i32) + count_named target children + count_named target rest
    | XmlText _ :: rest => count_named target rest
    | Nil => 0i32

:~ ^ attribute_of (key : string) (attributes : list (string * string)) : option string =
    ?= attributes ?|
    | (k, v) :: rest => ? k = key ?> Some v |: attribute_of key rest
    | Nil => None

:== root_view = { name : string; attributes : list (string * string); children : list xml_node }

:= single_root (nodes : list xml_node) : option root_view =
    ?= nodes ?|
    | XmlElement (name, attributes, children) :: Nil => Some { name; attributes; children }
    | _ => None

:= children_shape_is_b_then_c_text (children : list xml_node) : bool =
    ?= children ?|
    | XmlElement ("b", Nil, Nil) :: XmlElement ("c", _, (XmlText text :: Nil)) :: Nil => text = "hi & bye"
    | _ => !-

:= attribute_is (key : string) (expected : string) (attributes : list (string * string)) : bool =
    ?= attribute_of key attributes ?|
    | Some value => value = expected
    | None => !-

///> rust
///> zig
test reads_elements_attributes_and_text =
    := doc = "<?xml version=\"1.0\"?><!-- c --><a x=\"1\" y='two'><b/><c>hi &amp; bye</c></a>"
    ?= single_root (read_xml doc) ?|
    | Some { name attributes children } =>
        ? name <> "a" ?> failwith "root name"
        ? attribute_is "y" "two" attributes = !- ?> failwith "single-quoted attribute"
        ? children_shape_is_b_then_c_text children = !- ?> failwith "children"
    | None => failwith "one root element"

///> rust
///> zig
test counts_prefixed_schema_elements =
    := doc =
        "<xs:schema><xs:simpleType name=\"T\"><xs:restriction base=\"xs:string\"><xs:enumeration "
        ^^ "value=\"1\"/><xs:enumeration value=\"2\"/></xs:restriction></xs:simpleType></xs:schema>"
    := nodes = read_xml doc
    ? count_named "enumeration" nodes <> 2i32 ?> failwith "two enumerations"
    ? count_named "simpleType" nodes <> 1i32 ?> failwith "one simpleType"

/// ### element_names
:~ ^ element_names (nodes : list xml_node) (seen : list string) : list string =
    ?= nodes ?|
    | XmlElement (name, _, children) :: rest =>
        := name = local_name name
        := seen = ? listm'.contains name seen ?> seen |: name :: seen
        element_names rest (element_names children seen)
    | XmlText _ :: rest => element_names rest seen
    | Nil => seen

/// ### attributes_named
:~ ^ attributes_named (key : string) (attributes : list (string * string)) : i32 =
    ?= attributes ?|
    | (name, _) :: rest => (? local_name name = key ?> 1i32 |: 0i32) + attributes_named key rest
    | Nil => 0i32

/// ### count_attribute
:~ ^ count_attribute (key : string) (nodes : list xml_node) : i32 =
    ?= nodes ?|
    | XmlElement (_, attributes, children) :: rest =>
        attributes_named key attributes + count_attribute key children + count_attribute key rest
    | XmlText _ :: rest => count_attribute key rest
    | Nil => 0i32

/// ### depth
:~ ^ depth (nodes : list xml_node) : i32 =
    ?= nodes ?|
    | XmlElement (_, _, children) :: rest => max (1i32 + depth children) (depth rest)
    | XmlText _ :: rest => depth rest
    | Nil => 0i32

///> rust
///> zig
test measures_the_shape_of_a_schema =
    := doc =
        "<xs:schema><xs:simpleType name=\"T\"><xs:restriction base=\"xs:string\"><xs:enumeration "
        ^^ "value=\"1\"/><xs:enumeration value=\"2\"/></xs:restriction></xs:simpleType></xs:schema>"
    := nodes = read_xml doc
    ? listm.length (element_names nodes Nil) <> 4i32 ?> failwith "four element kinds"
    ? count_attribute "value" nodes <> 2i32 ?> failwith "two value attributes"
    ? depth nodes <> 4i32 ?> failwith "depth four"
:= element_children (node : xml_node) : list xml_node =
    ?= node ?|
    | XmlElement (_, _, children) => children
    | XmlText _ => Nil

:= element_attributes (node : xml_node) : list (string * string) =
    ?= node ?|
    | XmlElement (_, attributes, _) => attributes
    | XmlText _ => Nil

:~ ^ text_in (nodes : list xml_node) : string =
    ?= nodes ?|
    | XmlText text :: rest => text ++# text_in rest
    | _ :: rest => text_in rest
    | Nil => ""

:~ ^ children_named (target : string) (nodes : list xml_node) : list xml_node =
    ?= nodes ?|
    | XmlElement (name, attributes, children) :: rest =>
        ? local_name name = target ?> XmlElement (name, attributes, children) :: children_named target rest
        |: children_named target rest
    | _ :: rest => children_named target rest
    | Nil => Nil

:= first_child (target : string) (nodes : list xml_node) : option xml_node =
    ?= children_named target nodes ?|
    | node :: _ => Some node
    | Nil => None

:= has_child (target : string) (nodes : list xml_node) : bool =
    ?= children_named target nodes ?|
    | Cons _ => !+
    | Nil => !-

:~ ^ has_any_child (targets : list string) (nodes : list xml_node) : bool =
    ?= targets ?|
    | target :: rest => has_child target nodes || has_any_child rest nodes
    | Nil => !-

:= required_child (target : string) (nodes : list xml_node) : xml_node =
    ?= first_child target nodes ?|
    | Some node => node
    | None => failwith ("missing element " ++# target)

:= required_attribute (key : string) (attributes : list (string * string)) : string =
    ?= attribute_of key attributes ?|
    | Some value => value
    | None => failwith ("missing attribute " ++# key)

:= required_value \* t. (what : string) (value : option t) : t =
    ?= value ?|
    | Some x => x
    | None => failwith ("not a valid " ++# what)

:= element (name : string) (attributes : list (string * string)) (children : list xml_node) : xml_node =
    XmlElement (name, attributes, children)

:= text_children (text : string) : list xml_node = ? text = "" ?> Nil |: XmlText text :: Nil

:= option_list \* t. (value : option t) : list t =
    ?= value ?|
    | Some x => x :: Nil
    | None => Nil

:= option_concat \* t. (value : option (list t)) : list t =
    ?= value ?|
    | Some items => items
    | None => Nil

:= escape_text_xml (s : string) : string =
    s
    |> sm'.replace "&" "&amp;"
    |> sm'.replace "<" "&lt;"
    |> sm'.replace ">" "&gt;"

:= escape_attribute_xml (s : string) : string = escape_text_xml s |> sm'.replace "\"" "&quot;"

:~ ^ attributes_text (attributes : list (string * string)) : string =
    ?= attributes ?|
    | (key, value) :: rest =>
        " " ++# key ++# "=\"" ++# escape_attribute_xml value ++# "\"" ++# attributes_text rest
    | Nil => ""

:~ ^ write_node (node : xml_node) : string =
    ?= node ?|
    | XmlText text => escape_text_xml text
    | XmlElement (name, attributes, children) => write_element name attributes children

:& :~ write_element (name : string) (attributes : list (string * string)) (children : list xml_node) : string =
    ?= children ?|
    | Nil => "<" ++# name ++# attributes_text attributes ++# "/>"
    | _ => "<" ++# name ++# attributes_text attributes ++# ">" ++# write_nodes children ++# "</" ++# name ++# ">"

:& :~ write_nodes (nodes : list xml_node) : string =
    ?= nodes ?|
    | node :: rest => write_node node ++# write_nodes rest
    | Nil => ""

:= is_text_node (node : xml_node) : bool =
    ?= node ?|
    | XmlText _ => !+
    | XmlElement _ => !-

:= node_text (node : xml_node) : string =
    ?= node ?|
    | XmlText text => text
    | XmlElement _ => ""

:= node_name (node : xml_node) : string =
    ?= node ?|
    | XmlElement (name, _, _) => local_name name
    | XmlText _ => ""

:= is_namespace_declaration (key : string) : bool = key = "xmlns" || sm'.starts_with "xmlns:" key

:~ ^ data_attributes (attributes : list (string * string)) : list (string * string) =
    ?= attributes ?|
    | (key, value) :: rest =>
        ? is_namespace_declaration key ?> data_attributes rest |: (key, value) :: data_attributes rest
    | Nil => Nil

:~ ^ has_pair (key : string) (value : string) (attributes : list (string * string)) : bool =
    ?= attributes ?|
    | (k, v) :: rest => (k = key && v = value) || has_pair key value rest
    | Nil => !-

:~ ^ all_pairs_in (attributes : list (string * string)) (other : list (string * string)) : bool =
    ?= attributes ?|
    | (key, value) :: rest => has_pair key value other && all_pairs_in rest other
    | Nil => !+

:= same_attributes (a : list (string * string)) (b : list (string * string)) : bool =
    := a = data_attributes a
    := b = data_attributes b
    all_pairs_in a b && all_pairs_in b a

:~ ^ significant (nodes : list xml_node) : list xml_node =
    ?= nodes ?|
    | node :: rest =>
        ? is_text_node node && sm'.trim (node_text node) = "" ?> significant rest |: node :: significant rest
    | Nil => Nil

:~ ^ same_node (a : xml_node) (b : xml_node) : bool =
    ? is_text_node a || is_text_node b ?> is_text_node a && is_text_node b && node_text a = node_text b
    |:
        node_name a = node_name b
        && same_attributes (element_attributes a) (element_attributes b)
        && same_nodes (significant (element_children a)) (significant (element_children b))

:& :~ same_nodes (a : list xml_node) (b : list xml_node) : bool =
    ?= a ?|
    | x :: rest => same_first x rest b
    | Nil => ?= b ?| Nil => !+ | _ => !-

:& :~ same_first (x : xml_node) (rest : list xml_node) (b : list xml_node) : bool =
    ?= b ?|
    | y :: others => same_node x y && same_nodes rest others
    | Nil => !-

///> rust
test written_xml_reads_back_the_same =
    := text = "<a x=\"1\" xmlns=\"n\"><b>t &amp; u</b><c/>  </a>"
    ?= read_xml text ?|
    | original :: Nil =>
        ?= read_xml (write_node original) ?|
        | again :: Nil => ? same_node original again = !- ?> failwith "write then read keeps the tree"
        | _ => failwith "one element after writing"
    | _ => failwith "one element"

:~ ^ with_namespace (target : string) (uri : string) (node : xml_node) : xml_node =
    ?= node ?|
    | XmlElement (name, attributes, children) =>
        := attributes = ? local_name name = target ?> (("xmlns", uri) :: attributes) |: attributes
        XmlElement (name, attributes, with_namespace_all target uri children)
    | XmlText _ => node

:& :~ with_namespace_all (target : string) (uri : string) (nodes : list xml_node) : list xml_node =
    ?= nodes ?|
    | node :: rest => with_namespace target uri node :: with_namespace_all target uri rest
    | Nil => Nil
