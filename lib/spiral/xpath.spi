///- --package .
:< sm'_operators

:| token =
    | TName : string
    | TNumber : string
    | TText : string
    | TVariable : string
    | TSymbol : string

:! element_kind = ()

:! attribute_kind = ()

:| ^ axis k =
    | AxisChild :: axis element_kind
    | AxisDescendant :: axis element_kind
    | AxisDescendantOrSelf :: axis element_kind
    | AxisSelf :: axis element_kind
    | AxisParent :: axis element_kind
    | AxisAncestor :: axis element_kind
    | AxisAncestorOrSelf :: axis element_kind
    | AxisPreceding :: axis element_kind
    | AxisFollowing :: axis element_kind
    | AxisFollowingSibling :: axis element_kind
    | AxisPrecedingSibling :: axis element_kind
    | AxisAttribute :: axis attribute_kind

:| ^ step_axis =
    | ElementAxis : axis element_kind
    | AttributeAxis : axis attribute_kind
    | UnsupportedAxis : string

:= element_axis_name (a : axis element_kind) : string =
    ?= a ?|
    | AxisChild => "child"
    | AxisDescendant => "descendant"
    | AxisDescendantOrSelf => "descendant-or-self"
    | AxisSelf => "self"
    | AxisParent => "parent"
    | AxisAncestor => "ancestor"
    | AxisAncestorOrSelf => "ancestor-or-self"
    | AxisPreceding => "preceding"
    | AxisFollowing => "following"
    | AxisFollowingSibling => "following-sibling"
    | AxisPrecedingSibling => "preceding-sibling"

:= attribute_axis_name (a : axis attribute_kind) : string =
    ?= a ?|
    | AxisAttribute => "attribute"

:= axis_name (s : step_axis) : string =
    ?= s ?|
    | ElementAxis a => element_axis_name a
    | AttributeAxis a => attribute_axis_name a
    | UnsupportedAxis name => name

:~ ^ table_lookup \* t. (key : string) (table : list (string * t)) : option t =
    ?= table ?|
    | (k, v) :: rest => ? k = key ?> Some v |: table_lookup key rest
    | [] => None

:= axis_names () : list (string * step_axis) =
    [
        ("child", ElementAxis AxisChild)
        ("descendant", ElementAxis AxisDescendant)
        ("descendant-or-self", ElementAxis AxisDescendantOrSelf)
        ("self", ElementAxis AxisSelf)
        ("parent", ElementAxis AxisParent)
        ("ancestor", ElementAxis AxisAncestor)
        ("ancestor-or-self", ElementAxis AxisAncestorOrSelf)
        ("preceding", ElementAxis AxisPreceding)
        ("following", ElementAxis AxisFollowing)
        ("following-sibling", ElementAxis AxisFollowingSibling)
        ("preceding-sibling", ElementAxis AxisPrecedingSibling)
        ("attribute", AttributeAxis AxisAttribute)
    ]

:= step_axis_of (name : string) : step_axis =
    ?= table_lookup name (axis_names ()) ?|
    | Some axis => axis
    | None => UnsupportedAxis name

:! bool_result = ()

:! number_result = ()

:! nodes_result = ()

:| comparison =
    | CmpEq
    | CmpNe
    | CmpLt
    | CmpLe
    | CmpGt
    | CmpGe

:| comparison_flavor =
    | GeneralComparison
    | ValueComparison

:| ^ operator r =
    | OpOr :: operator bool_result
    | OpAnd :: operator bool_result
    | OpCompare :: comparison * comparison_flavor -> operator bool_result
    | OpAdd :: operator number_result
    | OpSubtract :: operator number_result
    | OpMultiply :: operator number_result
    | OpDivide :: operator number_result
    | OpModulo :: operator number_result
    | OpUnion :: operator nodes_result
    | OpIntersect :: operator nodes_result
    | OpExcept :: operator nodes_result

:| ^ binary_operator =
    | BoolOperator : operator bool_result
    | NumberOperator : operator number_result
    | NodesOperator : operator nodes_result

:= general_comparison_text (c : comparison) : string =
    ?= c ?|
    | CmpEq => "="
    | CmpNe => "!="
    | CmpLt => "<"
    | CmpLe => "<="
    | CmpGt => ">"
    | CmpGe => ">="

:= value_comparison_text (c : comparison) : string =
    ?= c ?|
    | CmpEq => "eq"
    | CmpNe => "ne"
    | CmpLt => "lt"
    | CmpLe => "le"
    | CmpGt => "gt"
    | CmpGe => "ge"

:= comparison_text (c : comparison) (flavor : comparison_flavor) : string =
    ?= flavor ?|
    | GeneralComparison => general_comparison_text c
    | ValueComparison => value_comparison_text c

:= bool_operator_text (o : operator bool_result) : string =
    ?= o ?|
    | OpOr => "or"
    | OpAnd => "and"
    | OpCompare (c, flavor) => comparison_text c flavor

:= number_operator_text (o : operator number_result) : string =
    ?= o ?|
    | OpAdd => "+"
    | OpSubtract => "-"
    | OpMultiply => "*"
    | OpDivide => "div"
    | OpModulo => "mod"

:= nodes_operator_text (o : operator nodes_result) : string =
    ?= o ?|
    | OpUnion => "|"
    | OpIntersect => "intersect"
    | OpExcept => "except"

:= operator_text (o : binary_operator) : string =
    ?= o ?|
    | BoolOperator b => bool_operator_text b
    | NumberOperator n => number_operator_text n
    | NodesOperator n => nodes_operator_text n

:= comparison_names () : list (string * (comparison * comparison_flavor)) =
    [
        ("=", (CmpEq, GeneralComparison))
        ("!=", (CmpNe, GeneralComparison))
        ("<", (CmpLt, GeneralComparison))
        ("<=", (CmpLe, GeneralComparison))
        (">", (CmpGt, GeneralComparison))
        (">=", (CmpGe, GeneralComparison))
        ("eq", (CmpEq, ValueComparison))
        ("ne", (CmpNe, ValueComparison))
        ("lt", (CmpLt, ValueComparison))
        ("le", (CmpLe, ValueComparison))
        ("gt", (CmpGt, ValueComparison))
        ("ge", (CmpGe, ValueComparison))
    ]

:= comparison_of (x : string) : option (comparison * comparison_flavor) = table_lookup x (comparison_names ())

:= operator_names () : list (string * binary_operator) =
    [
        ("or", BoolOperator OpOr)
        ("and", BoolOperator OpAnd)
        ("+", NumberOperator OpAdd)
        ("-", NumberOperator OpSubtract)
        ("*", NumberOperator OpMultiply)
        ("div", NumberOperator OpDivide)
        ("mod", NumberOperator OpModulo)
        ("|", NodesOperator OpUnion)
        ("union", NodesOperator OpUnion)
        ("intersect", NodesOperator OpIntersect)
        ("except", NodesOperator OpExcept)
    ]

:= compared_operator (x : string) : option binary_operator =
    ?= comparison_of x ?|
    | Some (c, flavor) => Some (BoolOperator (OpCompare (c, flavor)))
    | None => None

:= operator_of (x : string) : option binary_operator =
    ?= table_lookup x (operator_names ()) ?|
    | Some o => Some o
    | None => compared_operator x

:! value_result = ()

:| ^ builtin r =
    | FnNot :: builtin bool_result
    | FnTrue :: builtin bool_result
    | FnFalse :: builtin bool_result
    | FnBoolean :: builtin bool_result
    | FnExists :: builtin bool_result
    | FnEmpty :: builtin bool_result
    | FnContains :: builtin bool_result
    | FnStartsWith :: builtin bool_result
    | FnEndsWith :: builtin bool_result
    | FnGln :: builtin bool_result
    | FnMod11 :: builtin bool_result
    | FnMod97 :: builtin bool_result
    | FnSlack :: builtin bool_result
    | FnMatches :: builtin bool_result
    | FnAbn :: builtin bool_result
    | FnSeOrgnr :: builtin bool_result
    | FnTin :: builtin bool_result
    | FnPivaIt :: builtin bool_result
    | FnCf :: builtin bool_result
    | FnCodiceIpa :: builtin bool_result
    | FnCount :: builtin value_result
    | FnSum :: builtin value_result
    | FnNormalizeSpace :: builtin value_result
    | FnUpperCase :: builtin value_result
    | FnLowerCase :: builtin value_result
    | FnString :: builtin value_result
    | FnStringLength :: builtin value_result
    | FnSubstringAfter :: builtin value_result
    | FnSubstringBefore :: builtin value_result
    | FnConcat :: builtin value_result
    | FnRound :: builtin value_result
    | FnFloor :: builtin value_result
    | FnAbs :: builtin value_result
    | FnDecimal :: builtin value_result
    | FnNumber :: builtin value_result
    | FnDate :: builtin value_result
    | FnName :: builtin value_result
    | FnLocalName :: builtin value_result
    | FnDistinctValues :: builtin value_result
    | FnSubstring :: builtin value_result
    | FnCurrentDate :: builtin value_result
    | FnFormatNumber :: builtin value_result
    | FnDateTime :: builtin value_result
    | FnDayTimeDuration :: builtin value_result
    | FnCurrentDateTime :: builtin value_result
    | FnTranslate :: builtin value_result
    | FnTokenize :: builtin value_result
    | FnReplace :: builtin value_result
    | FnStringJoin :: builtin value_result
    | FnStringToCodepoints :: builtin value_result
    | FnCurrent :: builtin value_result
    | FnNamespaceUri :: builtin value_result

:| ^ function_ref =
    | BoolFunction : builtin bool_result
    | ValueFunction : builtin value_result
    | UnknownFunction : string

:= bool_function_text (f : builtin bool_result) : string =
    ?= f ?|
    | FnNot => "not"
    | FnTrue => "true"
    | FnFalse => "false"
    | FnBoolean => "boolean"
    | FnExists => "exists"
    | FnEmpty => "empty"
    | FnContains => "contains"
    | FnStartsWith => "starts-with"
    | FnEndsWith => "ends-with"
    | FnGln => "u:gln"
    | FnMod11 => "u:mod11"
    | FnMod97 => "u:mod97-0208"
    | FnSlack => "u:slack"
    | FnMatches => "matches"
    | FnAbn => "u:abn"
    | FnSeOrgnr => "u:checkSEOrgnr"
    | FnTin => "u:TinVerification"
    | FnPivaIt => "u:checkPIVAseIT"
    | FnCf => "u:checkCF"
    | FnCodiceIpa => "u:checkCodiceIPA"

:= value_function_text (f : builtin value_result) : string =
    ?= f ?|
    | FnCount => "count"
    | FnSum => "sum"
    | FnNormalizeSpace => "normalize-space"
    | FnUpperCase => "upper-case"
    | FnLowerCase => "lower-case"
    | FnString => "string"
    | FnStringLength => "string-length"
    | FnSubstringAfter => "substring-after"
    | FnSubstringBefore => "substring-before"
    | FnConcat => "concat"
    | FnRound => "round"
    | FnFloor => "floor"
    | FnAbs => "abs"
    | FnDecimal => "xs:decimal"
    | FnNumber => "number"
    | FnDate => "xs:date"
    | FnName => "name"
    | FnLocalName => "local-name"
    | FnDistinctValues => "distinct-values"
    | FnSubstring => "substring"
    | FnCurrentDate => "current-date"
    | FnFormatNumber => "format-number"
    | FnDateTime => "xs:dateTime"
    | FnDayTimeDuration => "xs:dayTimeDuration"
    | FnCurrentDateTime => "current-dateTime"
    | FnTranslate => "translate"
    | FnTokenize => "tokenize"
    | FnReplace => "replace"
    | FnStringJoin => "string-join"
    | FnStringToCodepoints => "string-to-codepoints"
    | FnCurrent => "current"
    | FnNamespaceUri => "namespace-uri"

:= function_text (f : function_ref) : string =
    ?= f ?|
    | BoolFunction b => bool_function_text b
    | ValueFunction v => value_function_text v
    | UnknownFunction name => name

:= bool_function_names () : list (string * function_ref) =
    [
        ("not", BoolFunction FnNot)
        ("true", BoolFunction FnTrue)
        ("false", BoolFunction FnFalse)
        ("boolean", BoolFunction FnBoolean)
        ("exists", BoolFunction FnExists)
        ("empty", BoolFunction FnEmpty)
        ("contains", BoolFunction FnContains)
        ("starts-with", BoolFunction FnStartsWith)
        ("ends-with", BoolFunction FnEndsWith)
        ("u:gln", BoolFunction FnGln)
        ("u:mod11", BoolFunction FnMod11)
        ("u:mod97-0208", BoolFunction FnMod97)
        ("u:slack", BoolFunction FnSlack)
        ("matches", BoolFunction FnMatches)
        ("u:abn", BoolFunction FnAbn)
        ("u:checkSEOrgnr", BoolFunction FnSeOrgnr)
        ("u:TinVerification", BoolFunction FnTin)
        ("u:checkPIVAseIT", BoolFunction FnPivaIt)
        ("u:checkCF", BoolFunction FnCf)
        ("u:checkCodiceIPA", BoolFunction FnCodiceIpa)
    ]

:= value_function_names () : list (string * function_ref) =
    [
        ("count", ValueFunction FnCount)
        ("sum", ValueFunction FnSum)
        ("normalize-space", ValueFunction FnNormalizeSpace)
        ("upper-case", ValueFunction FnUpperCase)
        ("lower-case", ValueFunction FnLowerCase)
        ("string", ValueFunction FnString)
        ("string-length", ValueFunction FnStringLength)
        ("substring-after", ValueFunction FnSubstringAfter)
        ("substring-before", ValueFunction FnSubstringBefore)
        ("concat", ValueFunction FnConcat)
        ("round", ValueFunction FnRound)
        ("floor", ValueFunction FnFloor)
        ("abs", ValueFunction FnAbs)
        ("xs:decimal", ValueFunction FnDecimal)
        ("number", ValueFunction FnNumber)
        ("xs:date", ValueFunction FnDate)
        ("name", ValueFunction FnName)
        ("local-name", ValueFunction FnLocalName)
        ("distinct-values", ValueFunction FnDistinctValues)
        ("substring", ValueFunction FnSubstring)
        ("current-date", ValueFunction FnCurrentDate)
        ("format-number", ValueFunction FnFormatNumber)
        ("xs:dateTime", ValueFunction FnDateTime)
        ("xs:dayTimeDuration", ValueFunction FnDayTimeDuration)
        ("current-dateTime", ValueFunction FnCurrentDateTime)
        ("translate", ValueFunction FnTranslate)
        ("tokenize", ValueFunction FnTokenize)
        ("replace", ValueFunction FnReplace)
        ("string-join", ValueFunction FnStringJoin)
        ("string-to-codepoints", ValueFunction FnStringToCodepoints)
        ("xs:integer", ValueFunction FnDecimal)
        ("xs:double", ValueFunction FnDecimal)
        ("current", ValueFunction FnCurrent)
        ("namespace-uri", ValueFunction FnNamespaceUri)
    ]

:= function_of (name : string) : function_ref =
    ?= table_lookup name (listm::append (bool_function_names ()) (value_function_names ())) ?|
    | Some f => f
    | None => UnknownFunction name

:| ^ xpath =
    | XInvalid : string
    | XNumber : string
    | XText : string
    | XVariable : string
    | XContext
    | XRoot
    | XStep : xpath * step_axis * string * list xpath
    | XFilter : xpath * list xpath
    | XCall : function_ref * list xpath
    | XBinary : binary_operator * xpath * xpath
    | XNegate : xpath
    | XQuantified : bool * string * xpath * xpath
    | XApply : xpath * xpath
    | XMember : xpath * string * list string
    | XIf : xpath * xpath * xpath
    | XSequence : list xpath
    | XFor : string * xpath * xpath
    | XCastable : xpath * string * bool

:| ^ kinded r =
    | ByOperator :: \* r. operator r * xpath -> kinded r
    | ByBoolCall :: builtin bool_result * xpath -> kinded bool_result
    | ByValueCall :: builtin value_result * xpath -> kinded value_result
    | ByNumber :: xpath -> kinded number_result
    | ByText :: xpath -> kinded value_result
    | ByNegate :: xpath -> kinded number_result
    | ByQuantifier :: xpath -> kinded bool_result
    | ByPath :: xpath -> kinded nodes_result

:| static_kind =
    | KindBool : kinded bool_result
    | KindNumber : kinded number_result
    | KindNodes : kinded nodes_result
    | KindValue : kinded value_result
    | KindDynamic : xpath

:= kinded_of (x : xpath) : static_kind =
    ?= x ?|
    | XBinary (BoolOperator o, _, _) => KindBool (ByOperator (o, x))
    | XBinary (NumberOperator o, _, _) => KindNumber (ByOperator (o, x))
    | XBinary (NodesOperator o, _, _) => KindNodes (ByOperator (o, x))
    | XCall (BoolFunction f, _) => KindBool (ByBoolCall (f, x))
    | XCall (ValueFunction f, _) => KindValue (ByValueCall (f, x))
    | XNumber _ => KindNumber (ByNumber x)
    | XText _ => KindValue (ByText x)
    | XNegate _ => KindNumber (ByNegate x)
    | XQuantified _ => KindBool (ByQuantifier x)
    | XContext => KindNodes (ByPath x)
    | XRoot => KindNodes (ByPath x)
    | XStep _ => KindNodes (ByPath x)
    | _ => KindDynamic x

:= kinded_source \* r. (k : kinded r) : xpath =
    ?= k ?|
    | ByOperator (_, x) => x
    | ByBoolCall (_, x) => x
    | ByValueCall (_, x) => x
    | ByNumber x => x
    | ByText x => x
    | ByNegate x => x
    | ByQuantifier x => x
    | ByPath x => x

:= cp_at (s : string) (i : i32) : u32 = xml::code_point_at s i

:= is_digit (c : u32) : bool = 48u32 <= c && c <= 57u32

:= is_letter (c : u32) : bool = (65u32 <= c && c <= 90u32) || (97u32 <= c && c <= 122u32)

:= is_name_start (c : u32) : bool = is_letter c || c = 95u32 || c > 127u32

:= is_name_char (c : u32) : bool = is_name_start c || is_digit c || c = 45u32 || c = 46u32

:~ ^ has_text (target : string) (items : list string) : bool =
    ?= items ?|
    | x :: rest => x = target || has_text target rest
    | [] => !-

:= is_star (c : u32) : bool = c = 42u32

:= colon_then (s : string) (i : i32) (accept : u32 -> bool) : bool =
    cp_at s i = 58u32 && i + 1i32 < sm'::length s && accept (cp_at s (i + 1i32))

:~ star_end (s : string) (i : i32) : i32 =
    ? colon_then s i is_star
    ?> i + 2i32
    |: i

:~ ^ name_end (s : string) (i : i32) : i32 =
    ? i >= sm'::length s
    ?> i
    |? is_name_char (cp_at s i)
    ?> name_end s (i + xml::code_point_width s i)
    |? colon_then s i is_name_start
    ?> name_end s (i + 1i32)
    |: star_end s i

:~ ^ digits_end (s : string) (i : i32) : i32 =
    ? i < sm'::length s && is_digit (cp_at s i) ?> digits_end s (i + 1i32) |: i

:~ ^ text_end (s : string) (quote : u32) (i : i32) : i32 =
    ? i >= sm'::length s
    ?> i
    |? cp_at s i = quote ?>
        ? i + 1i32 < sm'::length s && cp_at s (i + 1i32) = quote ?> text_end s quote (i + 2i32) |: i
    |: text_end s quote (i + xml::code_point_width s i)

:= paired_symbols () : list string = "!=" :: "<=" :: ">=" :: "//" :: "::" :: ".." :: []

:= xpath_is_space (c : u32) : bool = c = 32u32 || c = 9u32 || c = 10u32 || c = 13u32

:= xpath_starts_number (s : string) (i : i32) (c : u32) : bool =
    is_digit c || (c = 46u32 && i + 1i32 < sm'::length s && is_digit (cp_at s (i + 1i32)))

:= xpath_scan_text (s : string) (i : i32) (c : u32) : token * i32 =
    := quote = sm'::substring i 1i32 s
    := stop = text_end s c (i + 1i32)
    TText (sm'::substring (i + 1i32) (stop - i - 1i32) s |> sm'::replace (quote ++# quote) quote), stop + 1i32

:= xpath_scan_number (s : string) (i : i32) : token * i32 =
    := whole = digits_end s i
    := stop = ? whole < sm'::length s && cp_at s whole = 46u32 ?> digits_end s (whole + 1i32) |: whole
    TNumber (sm'::substring i (stop - i) s), stop

:= xpath_scan_variable (s : string) (i : i32) : token * i32 =
    := stop = name_end s (i + 1i32)
    TVariable (sm'::substring (i + 1i32) (stop - i - 1i32) s), stop

:= xpath_scan_name (s : string) (i : i32) : token * i32 =
    := stop = name_end s i
    TName (sm'::substring i (stop - i) s), stop

:= xpath_scan_symbol (s : string) (i : i32) : token * i32 =
    := pair = ? i + 1i32 < sm'::length s ?> sm'::substring i 2i32 s |: ""
    := width = xml::code_point_width s i
    ? has_text pair (paired_symbols ()) ?> (TSymbol pair, i + 2i32) |: (TSymbol (sm'::substring i width s), i + width)

:= xpath_scan_token (s : string) (i : i32) (c : u32) : token * i32 =
    ? c = 39u32 || c = 34u32
    ?> xpath_scan_text s i c
    |? xpath_starts_number s i c
    ?> xpath_scan_number s i
    |? c = 36u32
    ?> xpath_scan_variable s i
    |? is_name_start c
    ?> xpath_scan_name s i
    |: xpath_scan_symbol s i

:~ ^ tokens_from (s : string) (i : i32) (acc : list token) : list token =
    ? i >= sm'::length s
    ?> listm::rev acc
    |:
        := c = cp_at s i
        ? xpath_is_space c
        ?> tokens_from s (i + 1i32) acc
        |:
            := found, next = xpath_scan_token s i c
            tokens_from s next (found :: acc)

:= tokenize (s : string) : list token = tokens_from s 0i32 []

:= is_symbol (symbol : string) (tokens : list token) : bool =
    ?= tokens ?|
    | TSymbol x :: _ => x = symbol
    | _ => !-

:= is_word (word : string) (tokens : list token) : bool =
    ?= tokens ?|
    | TName x :: _ => x = word
    | _ => !-

:= after_first (tokens : list token) : list token =
    ?= tokens ?|
    | _ :: rest => rest
    | [] => []

:= closed (symbol : string) (parsed : xpath) (tokens : list token) : xpath * list token =
    ? is_symbol symbol tokens ?> (parsed, after_first tokens) |: (XInvalid ("expected " ++# symbol), tokens)

:= level_operators (level : i32) : string =
    ? level = 0i32
    ?> "or"
    |? level = 1i32
    ?> "and"
    |? level = 2i32
    ?> "= != < <= > >= eq ne lt le gt ge"
    |? level = 3i32
    ?> "+ -"
    |? level = 4i32
    ?> "* div mod"
    |? level = 5i32
    ?> "| union"
    |: "intersect except"

:= is_level_operator (level : i32) (x : string) : bool =
    sm'::contains (" " ++# x ++# " ") (" " ++# level_operators level ++# " ")

:= operator_at (level : i32) (tokens : list token) : option string =
    ?= tokens ?|
    | TSymbol x :: _ => ? is_level_operator level x ?> Some x |: None
    | TName x :: _ => ? is_level_operator level x ?> Some x |: None
    | _ => None

:= is_kind_test (name : string) : bool = name = "node" || name = "text" || name = "comment"

:= descendants (input : xpath) : xpath = XStep (input, ElementAxis AxisDescendantOrSelf, "node()", [])

:= starts_step (tokens : list token) : bool =
    ?= tokens ?|
    | TName _ :: _ => !+
    | TSymbol x :: _ => x = "*" || x = "@" || x = "." || x = ".."
    | _ => !-

:= starts_primary (tokens : list token) : bool =
    ?= tokens ?|
    | TText _ :: _ => !+
    | TNumber _ :: _ => !+
    | TVariable _ :: _ => !+
    | TSymbol x :: _ => x = "("
    | TName x :: TSymbol y :: _ => y = "(" && is_kind_test x = !-
    | _ => !-

:= sequence_of (parsed : list xpath * list token) : xpath * list token =
    ?= parsed ?|
    | items, rest => XSequence items, rest

:= xpath_parse_binary (op : string) (left : xpath) (right : xpath) : xpath =
    ?= operator_of op ?|
    | Some o => XBinary (o, left, right)
    | None => XInvalid ("unknown operator " ++# op)

:= xpath_parse_castable_as (operand : xpath) (ty : string) (tokens : list token) : xpath * list token =
    ? is_symbol "?" tokens ?> (XCastable (operand, ty, !+), after_first tokens) |: (XCastable (operand, ty, !-), tokens)

:= xpath_parse_starts_test (tokens : list token) : bool =
    ?= tokens ?|
    | TName _ :: _ => !+
    | TSymbol star :: _ => star = "*"
    | _ => !-

:= xpath_parse_kind_call (tokens : list token) : bool =
    ?= tokens ?|
    | TName kind :: TSymbol x :: TSymbol y :: _ => x = "(" && y = ")" && is_kind_test kind
    | _ => !-

:= quantifier_word (q : string) : bool = q = "every" || q = "some"

:~ ^ parse_expr (tokens : list token) : xpath * list token =
    ?= tokens ?|
    | TName q :: TVariable v :: TName word :: rest ?& word = "in" => xpath_parse_binding q v rest tokens
    | _ => parse_level 0i32 tokens

:& :~ xpath_parse_binding (q : string) (v : string) (rest : list token) (tokens : list token) : xpath * list token =
    ? quantifier_word q
    ?> xpath_parse_quantified (q = "every") v rest
    |? q = "for"
    ?> xpath_parse_for v rest
    |: parse_level 0i32 tokens

:& :~ xpath_parse_quantified (every : bool) (v : string) (tokens : list token) : xpath * list token =
    := domain, rest = parse_level 0i32 tokens
    ? is_word "satisfies" rest ?>
        := body, rest = parse_expr (after_first rest)
        XQuantified (every, v, domain, body), rest
    |: (XInvalid "expected satisfies", rest)

:& :~ xpath_parse_for (v : string) (tokens : list token) : xpath * list token =
    := domain, rest = parse_level 0i32 tokens
    ? is_word "return" rest ?>
        := body, rest = parse_expr (after_first rest)
        XFor (v, domain, body), rest
    |: (XInvalid "expected return", rest)

:& :~ parse_level (level : i32) (tokens : list token) : xpath * list token =
    ? level > 6i32
    ?> parse_castable tokens
    |:
        := left, rest = parse_level (level + 1i32) tokens
        parse_level_rest level left rest

:& :~ parse_level_rest (level : i32) (left : xpath) (tokens : list token) : xpath * list token =
    ?= operator_at level tokens ?|
    | Some op => xpath_parse_level_step level left op tokens
    | None => left, tokens

:& :~ xpath_parse_level_step (level : i32) (left : xpath) (op : string) (tokens : list token) : xpath * list token =
    := right, rest = parse_level (level + 1i32) (after_first tokens)
    parse_level_rest level (xpath_parse_binary op left right) rest

:& :~ parse_castable (tokens : list token) : xpath * list token =
    := operand, rest = parse_unary tokens
    ?= rest ?|
    | TName c :: TName a :: TName ty :: rest ?& c = "castable" && a = "as" => xpath_parse_castable_as operand ty rest
    | _ => operand, rest

:& :~ parse_unary (tokens : list token) : xpath * list token =
    ? is_symbol "-" tokens ?>
        := operand, rest = parse_unary (after_first tokens)
        XNegate operand, rest
    |: parse_path tokens

:& :~ parse_path (tokens : list token) : xpath * list token =
    ? is_symbol "//" tokens ?> parse_steps_after (descendants XRoot) (after_first tokens)
    |? is_symbol "/" tokens
    ?> xpath_parse_rooted (after_first tokens)
    |? starts_primary tokens
    ?> xpath_parse_filtered_steps tokens
    |: parse_steps_after XContext tokens

:& :~ xpath_parse_rooted (tokens : list token) : xpath * list token =
    ? starts_step tokens ?> parse_steps_after XRoot tokens |: (XRoot, tokens)

:& :~ xpath_parse_filtered_steps (tokens : list token) : xpath * list token =
    := filtered, rest = parse_filtered tokens
    parse_steps filtered rest

:& :~ parse_filtered (tokens : list token) : xpath * list token =
    := primary, rest = parse_primary tokens
    := predicates, rest = parse_predicates rest []
    (?= predicates ?| [] => primary | _ => XFilter (primary, predicates)), rest

:& :~ parse_steps (current : xpath) (tokens : list token) : xpath * list token =
    ? is_symbol "//" tokens ?> parse_steps_after (descendants current) (after_first tokens)
    |? is_symbol "/" tokens
    ?> parse_steps_after current (after_first tokens)
    |: current, tokens

:& :~ parse_steps_after (input : xpath) (tokens : list token) : xpath * list token =
    := step, rest = parse_step input tokens
    parse_steps step rest

:& :~ parse_step (input : xpath) (tokens : list token) : xpath * list token =
    ? starts_primary tokens ?>
        := filtered, rest = parse_filtered tokens
        XApply (input, filtered), rest
    |: parse_axis_step input tokens

:& :~ parse_axis_step (input : xpath) (tokens : list token) : xpath * list token =
    ?= tokens ?|
    | TSymbol _ :: _ => xpath_parse_symbol_step input tokens
    | TName _ :: _ => xpath_parse_name_step input tokens
    | _ => XInvalid "expected a step", tokens

:& :~ xpath_parse_symbol_step (input : xpath) (tokens : list token) : xpath * list token =
    ?= tokens ?|
    | TSymbol x :: rest ?& x = "." => XStep (input, ElementAxis AxisSelf, "node()", []), rest
    | TSymbol x :: rest ?& x = ".." => XStep (input, ElementAxis AxisParent, "node()", []), rest
    | TSymbol x :: TName name :: rest ?& x = "@" => with_predicates input (AttributeAxis AxisAttribute) name rest
    | TSymbol x :: TSymbol s :: r ?& x = "@" && s = "*" => with_predicates input (AttributeAxis AxisAttribute) "*" r
    | TSymbol star :: rest ?& star = "*" => with_predicates input (ElementAxis AxisChild) "*" rest
    | _ => XInvalid "expected a step", tokens

:& :~ xpath_parse_name_step (input : xpath) (tokens : list token) : xpath * list token =
    ?= tokens ?|
    | TName axis :: TSymbol x :: rest ?& x = "::" && xpath_parse_starts_test rest =>
        xpath_parse_node_test input (step_axis_of axis) rest
    | _ => xpath_parse_node_test input (ElementAxis AxisChild) tokens

:& :~ xpath_parse_node_test (input : xpath) (axis : step_axis) (tokens : list token) : xpath * list token =
    ?= tokens ?|
    | TName kind :: _ :: _ :: rest ?& xpath_parse_kind_call tokens => with_predicates input axis (kind ++# "()") rest
    | TName name :: rest => with_predicates input axis name rest
    | TSymbol star :: rest ?& star = "*" => with_predicates input axis "*" rest
    | _ => XInvalid "expected a step", tokens

:& :~ with_predicates (input : xpath) (axis : step_axis) (test : string) (tokens : list token) : xpath * list token =
    := predicates, rest = parse_predicates tokens []
    XStep (input, axis, test, predicates), rest

:& :~ parse_predicates (tokens : list token) (acc : list xpath) : list xpath * list token =
    ? is_symbol "[" tokens ?>
        := predicate, rest = parse_expr (after_first tokens)
        := predicate, rest = closed "]" predicate rest
        parse_predicates rest (predicate :: acc)
    |: (listm::rev acc, tokens)

:& :~ parse_primary (tokens : list token) : xpath * list token =
    ?= tokens ?|
    | TText text :: rest => XText text, rest
    | TNumber number :: rest => XNumber number, rest
    | TVariable name :: rest => XVariable name, rest
    | TSymbol x :: rest ?& x = "(" => xpath_parse_parenthesized rest
    | TName word :: rest ?& word = "if" && is_symbol "(" rest => xpath_parse_if (after_first rest)
    | TName name :: _ :: rest => xpath_parse_call name rest
    | _ => XInvalid "expected a primary expression", tokens

:& :~ xpath_parse_parenthesized (tokens : list token) : xpath * list token =
    ? is_symbol ")" tokens
    ?> (XSequence ([]), after_first tokens)
    |:
        := inner, rest = parse_expr tokens
        ? is_symbol "," rest
        ?> sequence_of (parse_arguments (after_first rest) (inner :: []))
        |: closed ")" inner rest

:& :~ xpath_parse_if (tokens : list token) : xpath * list token =
    := condition, rest = parse_expr tokens
    := condition, rest = closed ")" condition rest
    ?= rest ?|
    | TName then_word :: rest ?& then_word = "then" => xpath_parse_then condition rest
    | _ => XInvalid "expected then", rest

:& :~ xpath_parse_then (condition : xpath) (tokens : list token) : xpath * list token =
    := yes, rest = parse_expr tokens
    ?= rest ?|
    | TName else_word :: rest ?& else_word = "else" =>
        := no, rest = parse_expr rest
        XIf (condition, yes, no), rest
    | _ => XInvalid "expected else", rest

:& :~ xpath_parse_call (name : string) (tokens : list token) : xpath * list token =
    := arguments, rest = parse_arguments tokens []
    XCall (function_of name, arguments), rest

:& :~ parse_arguments (tokens : list token) (acc : list xpath) : list xpath * list token =
    ? is_symbol ")" tokens
    ?> (listm::rev acc, after_first tokens)
    |:
        := argument, rest = parse_expr tokens
        xpath_parse_argument_rest argument rest acc

:& :~ xpath_parse_argument_rest (argument : xpath) (tokens : list token) (acc : list xpath) : list xpath * list token =
    ? is_symbol "," tokens
    ?> parse_arguments (after_first tokens) (argument :: acc)
    |? is_symbol ")" tokens
    ?> (listm::rev (argument :: acc), after_first tokens)
    |: (listm::rev (XInvalid "expected , or )" :: argument :: acc), tokens)

:= parse (s : string) : xpath =
    := parsed, rest = parse_expr (tokenize s)
    ?= rest ?|
    | [] => parsed
    | _ => XInvalid "trailing tokens"

:~ ^ joined (items : list string) (acc : string) : string =
    ?= items ?|
    | item :: rest => joined rest (? acc = "" ?> item |: acc ++# " " ++# item)
    | [] => acc

:~ ^ xpath_text (x : xpath) : string =
    ?= x ?|
    | XInvalid reason => "(invalid " ++# reason ++# ")"
    | XNumber n => n
    | XText t => "'" ++# t ++# "'"
    | XVariable v => "$" ++# v
    | XContext => "."
    | XRoot => "/"
    | XStep (input, axis, test, predicates) => xpath_step_text input axis test predicates
    | XFilter (input, predicates) => "(filter " ++# xpath_text input ++# predicates_text predicates ++# ")"
    | XCall (name, arguments) => "(" ++# joined (function_text name :: texts_of arguments []) "" ++# ")"
    | XBinary (op, left, right) => xpath_binary_text op left right
    | XNegate operand => "(- " ++# xpath_text operand ++# ")"
    | XQuantified (every, v, domain, body) => xpath_quantified_text every v domain body
    | XApply (input, mapped) => "(apply " ++# xpath_text input ++# " " ++# xpath_text mapped ++# ")"
    | XMember (probe, _, codes) => "(member " ++# xpath_text probe ++# " " ++# joined codes "" ++# ")"
    | XIf (condition, yes, no) => xpath_if_text condition yes no
    | XSequence items => "(" ++# joined ("sequence" :: texts_of items []) "" ++# ")"
    | XFor (v, domain, body) => "(for $" ++# v ++# " " ++# xpath_text domain ++# " " ++# xpath_text body ++# ")"
    | XCastable (operand, ty, optional) => xpath_castable_text operand ty optional

:& :~ predicates_text (predicates : list xpath) : string =
    ?= predicates ?|
    | p :: rest => " [" ++# xpath_text p ++# "]" ++# predicates_text rest
    | [] => ""

:& :~ texts_of (items : list xpath) (acc : list string) : list string =
    ?= items ?|
    | item :: rest => texts_of rest (xpath_text item :: acc)
    | [] => listm::rev acc

:& :~ xpath_step_text (input : xpath) (axis : step_axis) (test : string) (predicates : list xpath) : string =
    "(" ++# axis_name axis ++# "::" ++# test ++# " " ++# xpath_text input ++# predicates_text predicates ++# ")"

:& :~ xpath_binary_text (op : binary_operator) (left : xpath) (right : xpath) : string =
    "(" ++# operator_text op ++# " " ++# xpath_text left ++# " " ++# xpath_text right ++# ")"

:& :~ xpath_quantified_text (every : bool) (v : string) (domain : xpath) (body : xpath) : string =
    := quantifier = ? every ?> "every" |: "some"
    "(" ++# quantifier ++# " $" ++# v ++# " " ++# xpath_text domain ++# " " ++# xpath_text body ++# ")"

:& :~ xpath_if_text (condition : xpath) (yes : xpath) (no : xpath) : string =
    "(if " ++# xpath_text condition ++# " " ++# xpath_text yes ++# " " ++# xpath_text no ++# ")"

:& :~ xpath_castable_text (operand : xpath) (ty : string) (optional : bool) : string =
    "(castable " ++# ty ++# (? optional ?> "?" |: "") ++# " " ++# xpath_text operand ++# ")"

:~ ^ node_count (counted : xpath -> bool) (x : xpath) : i32 = (? counted x ?> 1i32 |: 0i32) + child_count counted x

:& :~ child_count (counted : xpath -> bool) (x : xpath) : i32 =
    ?= x ?|
    | XStep (input, _, _, predicates) => node_count counted input + node_counts counted predicates
    | XFilter (input, predicates) => node_count counted input + node_counts counted predicates
    | XCall (_, arguments) => node_counts counted arguments
    | XBinary (_, left, right) => node_count counted left + node_count counted right
    | XNegate operand => node_count counted operand
    | XQuantified (_, _, domain, body) => node_count counted domain + node_count counted body
    | XApply (input, mapped) => node_count counted input + node_count counted mapped
    | XMember (probe, _, _) => node_count counted probe
    | XIf (condition, yes, no) => node_count counted condition + node_count counted yes + node_count counted no
    | XSequence items => node_counts counted items
    | XFor (_, domain, body) => node_count counted domain + node_count counted body
    | XCastable (operand, _, _) => node_count counted operand
    | _ => 0i32

:& :~ node_counts (counted : xpath -> bool) (items : list xpath) : i32 =
    ?= items ?|
    | item :: rest => node_count counted item + node_counts counted rest
    | [] => 0i32

:= invalid_count (x : xpath) : i32 = node_count (\| XInvalid _ => !+ | _ => !-) x

:= member_count (x : xpath) : i32 = node_count (\| XMember _ => !+ | _ => !-) x

:~ ^ spaced_words (s : string) (i : i32) (start : i32) (acc : list string) : list string =
    ? i >= sm'::length s
    ?> listm::rev acc
    |? cp_at s i = 32u32 ?>
        := acc = ? i > start && start > 0i32 ?> (sm'::substring start (i - start) s :: acc) |: acc
        spaced_words s (i + 1i32) (i + 1i32) acc
    |: spaced_words s (i + 1i32) start acc

:= padded_operand (x : xpath) : option xpath =
    ?= x ?|
    | XCall (name, (XText left :: inner :: XText right :: [])) ?& function_text name = "concat" =>
        ? left = " " && right = " " ?> Some inner |: None
    | _ => None

:~ ^ lift_code_lists (x : xpath) : xpath =
    ?= x ?|
    | XCall (name, (XText codes :: probe :: [])) ?& function_text name = "contains" => lifted_contains name codes probe
    | XStep (input, axis, test, predicates) => XStep (lift_code_lists input, axis, test, lifted predicates)
    | XFilter (input, predicates) => XFilter (lift_code_lists input, lifted predicates)
    | XCall (name, arguments) => XCall (name, lifted arguments)
    | XBinary (op, left, right) => XBinary (op, lift_code_lists left, lift_code_lists right)
    | XNegate operand => XNegate (lift_code_lists operand)
    | XQuantified (every, v, domain, body) => XQuantified (every, v, lift_code_lists domain, lift_code_lists body)
    | XApply (input, mapped) => XApply (lift_code_lists input, lift_code_lists mapped)
    | XMember (probe, codes, words) => XMember (lift_code_lists probe, codes, words)
    | XIf (condition, yes, no) => XIf (lift_code_lists condition, lift_code_lists yes, lift_code_lists no)
    | XSequence items => XSequence (lifted items)
    | XFor (v, domain, body) => XFor (v, lift_code_lists domain, lift_code_lists body)
    | XCastable (operand, ty, optional) => XCastable (lift_code_lists operand, ty, optional)
    | _ => x

:& :~ lifted (items : list xpath) : list xpath =
    ?= items ?|
    | item :: rest => lift_code_lists item :: lifted rest
    | [] => []

:& :~ lifted_contains (name : function_ref) (codes : string) (probe : xpath) : xpath =
    ?= padded_operand probe ?|
    | Some inner => XMember (lift_code_lists inner, codes, spaced_words codes 0i32 0i32 [])
    | None => XCall (name, XText codes :: lift_code_lists probe :: [])

///> rust
:# parses_the_en16931_xpath_subset =
    := check (source : string) (expected : string) =
        := got = xpath_text (parse source)
        ? got <> expected ?> failwith (source ++# " parsed as " ++# got)
    check "cbc:ID" "(child::cbc:ID .)"
    check "exists(cac:InvoiceLine) and not(@x)" "(and (exists (child::cac:InvoiceLine .)) (not (attribute::x .)))"
    check "//cac:TaxTotal/cbc:TaxAmount" "(child::cbc:TaxAmount (child::cac:TaxTotal (descendant-or-self::node() /)))"
    check "xs:decimal(cbc:Amount) >= 0" "(>= (xs:decimal (child::cbc:Amount .)) 0)"
    check "round(a * 10 div 2) = -1.5" "(= (round (div (* (child::a .) 10) 2)) (- 1.5))"
    check "normalize-space(.) != ''" "(!= (normalize-space (self::node() .)) '')"
    check "cac:Item[cbc:Name = 'it''s'][1]" "(child::cac:Item . [(= (child::cbc:Name .) 'it's')] [1])"
    check "every $x in cac:A satisfies $x/cbc:B" "(every $x (child::cac:A .) (child::cbc:B $x))"
    := union_expected = "(| (child::cbc:ID (parent::node() .)) (attribute::id (ancestor::cac:Party .)))"
    check "../cbc:ID | ancestor::cac:Party/@id" union_expected
    check "cac:TaxScheme/normalize-space(cbc:ID)" "(apply (child::cac:TaxScheme .) (normalize-space (child::cbc:ID .)))"
    check "//(a|b)/c" "(child::c (apply (descendant-or-self::node() /) (| (child::a .) (child::b .))))"
    check "for $c in a return $c + 1" "(for $c (child::a .) (+ $c 1))"
    check "string(.) castable as xs:date" "(castable xs:date (string (self::node() .)))"
    check "a castable as xs:integer?" "(castable xs:integer? (child::a .))"
    check "1 + a castable as xs:integer" "(+ 1 (castable xs:integer (child::a .)))"
    check "following::node()/hr:Name" "(child::hr:Name (following::node() .))"

///> rust
:# reports_malformed_expressions =
    ? invalid_count (parse "count(a") = 0i32 ?> failwith "an unclosed call is invalid"
    ? invalid_count (parse "a[b") = 0i32 ?> failwith "an unclosed predicate is invalid"
    ? invalid_count (parse "exists(a) b") = 0i32 ?> failwith "trailing tokens are invalid"
    ? invalid_count (parse "sum(a/b) + 1") <> 0i32 ?> failwith "a well formed sum"
    ? invalid_count (parse "string-length(text()) = 10 and (string(.) castable as xs:date)") <> 0i32
    ?> failwith "a castable test parses"
    ? invalid_count (parse "string-join(for $cp in string-to-codepoints(a) return string($cp - 55), '')") <> 0i32
    ?> failwith "a for expression parses inside a call"
    ? invalid_count (parse "for $x in a satisfies $x") = 0i32 ?> failwith "a for without return is invalid"

///> rust
:# lifts_code_lists_into_membership =
    := source = "contains(' C62 H87 KGM', concat(' ', normalize-space(@unitCode), ' '))"
    := expected = "(member (normalize-space (attribute::unitCode .)) C62 H87)"
    ? xpath_text (lift_code_lists (parse source)) <> expected ?> failwith "a padded contains is a member test"
    := guard = "not(contains(normalize-space(.), ' '))"
    ? xpath_text (lift_code_lists (parse guard)) <> xpath_text (parse guard) ?> failwith "an unpadded contains stays"

///> rust
:# classifies_static_kinds =
    := kind_shown (source : string) : string =
        ?= kinded_of (parse source) ?|
        | KindBool _ => "bool"
        | KindNumber _ => "number"
        | KindNodes _ => "nodes"
        | KindValue _ => "value"
        | KindDynamic _ => "dynamic"
    := check (source : string) (expected : string) =
        := got = kind_shown source
        ? got <> expected ?> failwith (source ++# " classified as " ++# got)
    check "a = 1" "bool"
    check "exists(a) and not(b)" "bool"
    check "1 + 2" "number"
    check "-1.5" "number"
    check "a | b" "nodes"
    check "//a/b" "nodes"
    check "a[1]" "nodes"
    check "count(a)" "value"
    check "'x'" "value"
    check "$x" "dynamic"
    := kept (source : string) =
        := x = parse source
        := back =
            ?= kinded_of x ?|
            | KindBool k => kinded_source k
            | KindNumber k => kinded_source k
            | KindNodes k => kinded_source k
            | KindValue k => kinded_source k
            | KindDynamic d => d
        ? xpath_text back <> xpath_text x ?> failwith (source ++# " lost its source")
    kept "a = 1"
    kept "1 + 2"
    kept "a | b"
    kept "count(a)"
    kept "$x"
