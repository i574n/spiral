///- --package .
:< sm'_operators
:< xml

:| xsd_facet =
    | Enumeration : string
    | Pattern : string
    | Length : i32
    | MinLength : i32
    | MaxLength : i32
    | WhiteSpace : string
    | TotalDigits : i32
    | FractionDigits : i32
    | OtherFacet : string * string

:| ^ xsd =
    | Simple : string * string * list xsd_facet
    | Complex : string * xsd * list xsd
    | Sequence : i32 * i32 * list xsd
    | Choice : i32 * i32 * list xsd
    | Element : string * string * i32 * i32 * option xsd
    | Derived : string * string * xsd * list xsd
    | Attribute : string * string * bool * string * option xsd
    | AnyContent
    | Empty

:== xsd_schema =
    {
        target_namespace : string
        includes : list string
        simple_types : list xsd
        complex_types : list xsd
        elements : list xsd
    }

:~ ^ reverse \* t. (rest : list t) (acc : list t) : list t =
    ?= rest ?|
    | x :: xs => reverse xs (x :: acc)
    | Nil => acc

:= digit_of (c : string) : i32 =
    ? c = "0" ?> 0i32 |? c = "1" ?> 1i32 |? c = "2" ?> 2i32 |? c = "3" ?> 3i32 |? c = "4" ?> 4i32
    |? c = "5" ?> 5i32 |? c = "6" ?> 6i32 |? c = "7" ?> 7i32 |? c = "8" ?> 8i32 |? c = "9" ?> 9i32
    |: -1i32

:~ ^ digits_value (s : string) (pos : i32) (acc : i32) : i32 =
    ? pos >= sm'.length s ?> acc
    |:
        := d = digit_of (xml.at s pos)
        ? d < 0i32 ?> -1i32 |: digits_value s (pos + 1i32) (acc * 10i32 + d)

:= parse_count (s : string) : i32 = ? s = "" ?> -1i32 |: digits_value s 0i32 0i32

:= attribute_or (key : string) (fallback : string) (attributes : list (string * string)) : string =
    ?= xml.attribute_of key attributes ?|
    | Some value => value
    | None => fallback

:= occurs (attributes : list (string * string)) : i32 * i32 =
    := min = attribute_or "minOccurs" "1" attributes |> parse_count
    := max_text = attribute_or "maxOccurs" "1" attributes
    min, (? max_text = "unbounded" ?> -1i32 |: parse_count max_text)

:~ ^ facets_of (nodes : list xml.xml_node) (acc : list xsd_facet) : list xsd_facet =
    ?= nodes ?|
    | XmlElement (name, attributes, _) :: rest =>
        := value = attribute_or "value" "" attributes
        := local = xml.local_name name
        := facet =
            ? local = "enumeration" ?> Some (Enumeration value)
            |? local = "pattern" ?> Some (Pattern value)
            |? local = "length" ?> Some (Length (parse_count value))
            |? local = "minLength" ?> Some (MinLength (parse_count value))
            |? local = "maxLength" ?> Some (MaxLength (parse_count value))
            |? local = "whiteSpace" ?> Some (WhiteSpace value)
            |? local = "totalDigits" ?> Some (TotalDigits (parse_count value))
            |? local = "fractionDigits" ?> Some (FractionDigits (parse_count value))
            |? local = "annotation" ?> None
            |: Some (OtherFacet (local, value))
        facets_of rest (?= facet ?| Some f => (f :: acc) | None => acc)
    | XmlText _ :: rest => facets_of rest acc
    | Nil => reverse acc Nil

:~ ^ first_named
    (target : string) (nodes : list xml.xml_node)
    : option (list (string * string) * list xml.xml_node)
    =
    ?= nodes ?|
    | XmlElement (name, attributes, children) :: rest =>
        ? xml.local_name name = target ?> Some (attributes, children) |: first_named target rest
    | XmlText _ :: rest => first_named target rest
    | Nil => None

:= is_pattern_facet (facet : xsd_facet) : bool = ?= facet ?| Pattern _ => !+ | _ => !-

:= is_enumeration_facet (facet : xsd_facet) : bool = ?= facet ?| Enumeration _ => !+ | _ => !-

:~ ^ all_facets (keep : xsd_facet -> bool) (facets : list xsd_facet) : bool =
    ?= facets ?|
    | facet :: rest => keep facet && all_facets keep rest
    | Nil => !+

:~ ^ union_member_facets (nodes : list xml.xml_node) (acc : list xsd_facet) : option (list xsd_facet) =
    ?= nodes ?|
    | XmlElement (name, _, children) :: rest ?& xml.local_name name = "simpleType" =>
        ?= first_named "restriction" children ?|
        | Some (attributes, facets) =>
            ? sm'.ends_with "string" (attribute_or "base" "" attributes)
            ?> union_member_facets rest (listm.append acc (facets_of facets Nil))
            |: None
        | None => None
    | XmlElement (name, _, _) :: rest ?& xml.local_name name = "annotation" => union_member_facets rest acc
    | XmlText _ :: rest => union_member_facets rest acc
    | _ :: _ => None
    | Nil => Some acc

:= union_of (name : string) (attributes : list (string * string)) (members : list xml.xml_node) : xsd =
    := member_types = attribute_or "memberTypes" "" attributes
    := marker = Simple (name, "", OtherFacet ("union", member_types) :: Nil)
    ? member_types <> "" ?> marker
    |:
        ?= union_member_facets members Nil ?|
        | Some facets =>
            ?= facets ?|
            | Nil => marker
            | _ =>
                ? all_facets is_pattern_facet facets || all_facets is_enumeration_facet facets
                ?> Simple (name, "xs:string", facets)
                |: marker
        | None => marker

:= simple_of (name : string) (children : list xml.xml_node) : xsd =
    ?= first_named "restriction" children ?|
    | Some (attributes, facets) => Simple (name, attribute_or "base" "" attributes, facets_of facets Nil)
    | None =>
        ?= first_named "union" children ?|
        | Some (attributes, members) => union_of name attributes members
        | None => Simple (name, "", Nil)

:~ ^ particle_of (node : xml.xml_node) : option xsd =
    ?= node ?|
    | XmlElement (name, attributes, children) =>
        := local = xml.local_name name
        := min, max = occurs attributes
        ? local = "element" ?>
            := inline =
                ?= first_named "simpleType" children ?|
                | Some (_, simple_children) => Some (simple_of "" simple_children)
                | None =>
                    ?= first_named "complexType" children ?|
                    | Some (complex_attributes, complex_children) =>
                        Some (complex_of "" complex_attributes complex_children)
                    | None => None
            Some (
                Element (
                    attribute_or "name" (attribute_or "ref" "" attributes) attributes,
                    attribute_or "type" "" attributes,
                    min,
                    max,
                    inline
                )
            )
        |? local = "sequence" ?> Some (Sequence (min, max, particles_of children Nil))
        |? local = "choice" ?> Some (Choice (min, max, particles_of children Nil))
        |? local = "any" ?> Some AnyContent
        |: None
    | XmlText _ => None

:& :~ particles_of (nodes : list xml.xml_node) (acc : list xsd) : list xsd =
    ?= nodes ?|
    | node :: rest => particles_of rest (?= particle_of node ?| Some p => (p :: acc) | None => acc)
    | Nil => reverse acc Nil

:& :~ complex_of (name : string) (_ : list (string * string)) (children : list xml.xml_node) : xsd =
    ?= first_named "complexContent" children ?|
    | Some (_, content_children) => derived_of name content_children
    | None =>
        ?= first_named "simpleContent" children ?|
        | Some (_, content_children) => derived_of name content_children
        | None => Complex (name, content_of children, attributes_of children Nil)

:& :~ content_of (children : list xml.xml_node) : xsd =
    ?= particles_of children Nil ?|
    | first :: _ => first
    | Nil => Empty

:& :~ derived_of (name : string) (children : list xml.xml_node) : xsd =
    ?= first_named "extension" children ?|
    | Some (attributes, inner) =>
        Derived (name, attribute_or "base" "" attributes, content_of inner, attributes_of inner Nil)
    | None =>
        ?= first_named "restriction" children ?|
        | Some (attributes, inner) =>
            Derived (name, attribute_or "base" "" attributes, content_of inner, attributes_of inner Nil)
        | None => Complex (name, Empty, Nil)

:& :~ attributes_of (nodes : list xml.xml_node) (acc : list xsd) : list xsd =
    ?= nodes ?|
    | XmlElement (name, attributes, children) :: rest =>
        ? xml.local_name name = "attribute" ?>
            := inline =
                ?= first_named "simpleType" children ?|
                | Some (_, simple_children) => Some (simple_of "" simple_children)
                | None => None
            := attribute =
                Attribute (
                    attribute_or "name" "" attributes,
                    attribute_or "type" "" attributes,
                    attribute_or "use" "optional" attributes = "required",
                    attribute_or "fixed" "" attributes,
                    inline
                )
            attributes_of rest (attribute :: acc)
        |: attributes_of rest acc
    | XmlText _ :: rest => attributes_of rest acc
    | Nil => reverse acc Nil

:~ ^ schema_items (nodes : list xml.xml_node) (schema : xsd_schema) : xsd_schema =
    ?= nodes ?|
    | XmlElement (name, attributes, children) :: rest =>
        := local = xml.local_name name
        := item_name = attribute_or "name" "" attributes
        := schema =
            ? local = "simpleType"
            ?> { schema ?| simple_types = (simple_of item_name children :: schema.simple_types) }
            |? local = "complexType"
            ?> { schema ?| complex_types = (complex_of item_name attributes children :: schema.complex_types) }
            |? local = "element" ?>
                ?= particle_of (XmlElement (name, attributes, children)) ?|
                | Some e => { schema ?| elements = (e :: schema.elements) }
                | None => schema
            |? local = "include" || local = "import"
            ?> { schema ?| includes = (attribute_or "schemaLocation" "" attributes :: schema.includes) }
            |: schema
        schema_items rest schema
    | XmlText _ :: rest => schema_items rest schema
    | Nil => schema

:= xml_schema_namespace () : string = "http://www.w3.org/2001/XMLSchema"

:= prefix_of (name : string) : string =
    := colon = sm'.index_of ":" name
    ? colon < 0i32 ?> "" |: sm'.substring 0i32 colon name

:~ ^ has_prefix (target : string) (prefixes : list string) : bool =
    ?= prefixes ?|
    | x :: rest => x = target || has_prefix target rest
    | Nil => !-

:~ ^ xml_schema_prefixes (attributes : list (string * string)) (acc : list string) : list string =
    ?= attributes ?|
    | (key, value) :: rest =>
        := acc =
            ? value <> xml_schema_namespace () ?> acc
            |? key = "xmlns" ?> "" :: acc
            |? sm'.starts_with "xmlns:" key ?> sm'.substring 6i32 (sm'.length key - 6i32) key :: acc
            |: acc
        xml_schema_prefixes rest acc
    | Nil => acc

:= canonical_reference (prefixes : list string) (reference : string) : string =
    ? reference = "" ?> reference
    |? has_prefix (prefix_of reference) prefixes ?> "xs:" ++# xml.local_name reference
    |: reference

:~ ^ canonical_item (prefixes : list string) (item : xsd) : xsd =
    ?= item ?|
    | Simple (name, base, facets) => Simple (name, canonical_reference prefixes base, facets)
    | Complex (name, content, attributes) =>
        Complex (name, canonical_item prefixes content, canonical_attributes prefixes attributes Nil)
    | Derived (name, base, content, attributes) =>
        Derived (
            name,
            canonical_reference prefixes base,
            canonical_item prefixes content,
            canonical_attributes prefixes attributes Nil
        )
    | Sequence (min, max, items) => Sequence (min, max, canonical_items prefixes items Nil)
    | Choice (min, max, items) => Choice (min, max, canonical_items prefixes items Nil)
    | Element (name, type_reference, min, max, inline) =>
        Element (name, canonical_reference prefixes type_reference, min, max, canonical_inline prefixes inline)
    | Attribute (name, type_reference, required, fixed, inline) =>
        Attribute (name, canonical_reference prefixes type_reference, required, fixed, canonical_inline prefixes inline)
    | AnyContent => AnyContent
    | Empty => Empty

:& :~ canonical_items (prefixes : list string) (items : list xsd) (acc : list xsd) : list xsd =
    ?= items ?|
    | item :: rest => canonical_items prefixes rest (canonical_item prefixes item :: acc)
    | Nil => reverse acc Nil

:& :~ canonical_inline (prefixes : list string) (inline : option xsd) : option xsd =
    ?= inline ?|
    | Some inner => Some (canonical_item prefixes inner)
    | None => None

:& :~ canonical_attributes (prefixes : list string) (attributes : list xsd) (acc : list xsd) : list xsd =
    canonical_items prefixes attributes acc

:= canonical_schema (prefixes : list string) (schema : xsd_schema) : xsd_schema =
    {
        target_namespace = schema.target_namespace
        includes = schema.includes
        simple_types = canonical_items prefixes schema.simple_types Nil
        complex_types = canonical_items prefixes schema.complex_types Nil
        elements = canonical_items prefixes schema.elements Nil
    }

:= read_schema (text : string) : xsd_schema =
    := empty = { target_namespace = ""; includes = Nil; simple_types = Nil; complex_types = Nil; elements = Nil }
    ?= first_named "schema" (xml.read_xml text) ?|
    | Some (attributes, children) =>
        := model = schema_items children { empty ?| target_namespace = attribute_or "targetNamespace" "" attributes }
        canonical_schema (xml_schema_prefixes attributes Nil) model
    | None => empty

///> rust
test occurs_and_facets_parse =
    := text =
        "<xs:schema targetNamespace=\"n\"><xs:complexType name=\"C\"><xs:sequence><xs:element name=\"a\" "
        ^^ "type=\"T\" minOccurs=\"0\" maxOccurs=\"unbounded\"/></xs:sequence><xs:attribute name=\"v\" "
        ^^ "type=\"xs:string\" use=\"required\"/></xs:complexType></xs:schema>"
    ?= (read_schema text).complex_types ?|
    | Complex (
            name,
            Sequence (_, _, (Element (element_name, type_ref, min, max, _) :: Nil)),
            (Attribute (attribute_name, _, required, _, _) :: Nil)
        )
        :: Nil
        =>
            ? name <> "C" || element_name <> "a" || type_ref <> "T" ?> failwith "names"
            ? min <> 0i32 || max <> -1i32 ?> failwith "occurs 0..unbounded"
            ? attribute_name <> "v" || required = !- ?> failwith "required attribute"
    | _ => failwith "complex type shape"

///> rust
test complex_content_extension_keeps_its_base =
    := text =
        "<xs:schema><xs:complexType name=\"D\"><xs:complexContent><xs:extension "
        ^^ "base=\"B\"><xs:sequence><xs:element name=\"e\" type=\"T\"/></xs:sequence><xs:attribute name=\"a\" "
        ^^ "type=\"xs:string\"/></xs:extension></xs:complexContent></xs:complexType></xs:schema>"
    ?= (read_schema text).complex_types ?|
    | Derived (
            name,
            base,
            Sequence (_, _, (Element (element_name, _, _, _, _) :: Nil)),
            (Attribute (attribute_name, _, _, _, _) :: Nil)
        )
        :: Nil
        => ? name <> "D" || base <> "B" || element_name <> "e" || attribute_name <> "a" ?> failwith "derived names"
    | _ => failwith "derived complex type shape"

///> rust
test default_xml_schema_namespace_marks_builtins =
    := text =
        "<schema xmlns=\"http://www.w3.org/2001/XMLSchema\" xmlns:ds=\"d\"><simpleType name=\"D\"><restriction "
        ^^ "base=\"base64Binary\"/></simpleType><simpleType name=\"E\"><restriction "
        ^^ "base=\"ds:D\"/></simpleType></schema>"
    ?= (read_schema text).simple_types ?|
    | Simple (_, first_base, _) :: Simple (_, second_base, _) :: Nil =>
        ? first_base <> "xs:base64Binary" && second_base <> "xs:base64Binary"
        ?> failwith "the unprefixed builtin becomes xs:base64Binary"
        ? first_base <> "ds:D" && second_base <> "ds:D" ?> failwith "a prefixed non-schema reference is kept"
    | _ => failwith "two simple types"

///> rust
test any_wildcard_is_kept =
    := text =
        "<xs:schema><xs:complexType name=\"W\"><xs:sequence><xs:any "
        ^^ "processContents=\"skip\"/></xs:sequence></xs:complexType></xs:schema>"
    ?= (read_schema text).complex_types ?|
    | Complex (_, Sequence (_, _, (AnyContent :: Nil)), _) :: Nil => ()
    | _ => failwith "xs:any becomes AnyContent"

///> rust
test attribute_fixed_value_and_inline_type_are_kept =
    := text =
        "<xs:schema><xs:complexType name=\"A\"><xs:attribute name=\"Algorithm\" type=\"T\" use=\"required\" "
        ^^ "fixed=\"urn:x\"/><xs:attribute name=\"Id\"><xs:simpleType><xs:restriction base=\"xs:ID\"><xs:pattern "
        ^^ "value=\"ID[0-9]{44}\"/></xs:restriction></xs:simpleType></xs:attribute></xs:complexType></xs:schema>"
    ?= (read_schema text).complex_types ?|
    | Complex (
            _,
            _,
            (Attribute (_, _, required, fixed, None) :: Attribute (_, _, _, _, Some (Simple (_, base, _))) :: Nil)
        )
        :: Nil
        =>
            ? required = !- || fixed <> "urn:x" ?> failwith "the fixed value is kept"
            ? base <> "xs:ID" ?> failwith "the inline attribute type keeps its base"
    | _ => failwith "two attributes, the second with an inline simple type"

///> rust
test pattern_unions_become_alternative_patterns =
    := member pattern =
        "<xsd:simpleType><xsd:restriction base=\"xsd:string\"><xsd:pattern value=\""
        ++# pattern
        ++# "\"/></xsd:restriction></xsd:simpleType>"
    := regon =
        "<xsd:simpleType name=\"TNrREGON\"><xsd:union>"
        ++# member "\\d{9}"
        ++# member "\\d{14}"
        ++# "</xsd:union></xsd:simpleType>"
    := named = "<xsd:simpleType name=\"M\"><xsd:union memberTypes=\"A B\"/></xsd:simpleType>"
    := text = "<xsd:schema xmlns:xsd=\"http://www.w3.org/2001/XMLSchema\">" ++# regon ++# named ++# "</xsd:schema>"
    ?= (read_schema text).simple_types ?|
    | Simple (first, first_base, first_facets) :: Simple (_, _, second_facets) :: Nil =>
        := regon_facets, other_facets =
            ? first = "TNrREGON" ?> first_facets, second_facets |: second_facets, first_facets
        ?= regon_facets ?|
        | Pattern a :: Pattern b :: Nil =>
            ? a <> "\\d{9}" || b <> "\\d{14}" ?> failwith "both member patterns, in order"
        | _ => failwith "a pattern union lowers to its member patterns"
        ?= other_facets ?|
        | OtherFacet (kind, members) :: Nil =>
            ? kind <> "union" || members <> "A B" ?> failwith "the named-member union marker"
        | _ => failwith "a memberTypes union keeps a marker"
        ? first = "TNrREGON" && first_base <> "xs:string" ?> failwith "the lowered union is a string"
    | _ => failwith "two simple types"

:~ ^ count_list \* t. (items : list t) : i32 =
    ?= items ?|
    | _ :: rest => 1i32 + count_list rest
    | Nil => 0i32

:~ ^ enumeration_count (types : list xsd) : i32 =
    ?= types ?|
    | Simple (_, _, facets) :: rest => count_enumerations facets + enumeration_count rest
    | _ :: rest => enumeration_count rest
    | Nil => 0i32

:& :~ count_enumerations (facets : list xsd_facet) : i32 =
    ?= facets ?|
    | Enumeration _ :: rest => 1i32 + count_enumerations rest
    | _ :: rest => count_enumerations rest
    | Nil => 0i32
