///- --package . --timeout 900000
:< sm'_operators
:< xsd

:= upper_letters () : string = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"

:= lower_letters () : string = "abcdefghijklmnopqrstuvwxyz"

:= alnum () : string = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789"

:= is_upper (c : string) : bool = sm'.index_of c (upper_letters ()) >= 0i32

:= is_lower (c : string) : bool = sm'.index_of c (lower_letters ()) >= 0i32

:= is_alnum (c : string) : bool = sm'.index_of c (alnum ()) >= 0i32

:~ ^ snake_from (s : string) (pos : i32) (previous_lower : bool) (previous_upper : bool) (acc : string) : string =
    ? pos >= sm'.length s ?> acc
    |:
        := c = xml.code_point_text s pos
        := after = pos + sm'.length c
        := next_lower = after < sm'.length s && is_lower (xml.code_point_text s after)
        := piece =
            ? is_upper c ?> (? previous_lower || (previous_upper && next_lower) ?> "_" |: "") ++# sm'.to_lower c
            |? is_alnum c ?> c
            |: "_"
        snake_from s after (is_lower c || (sm'.index_of c "0123456789" >= 0i32)) (is_upper c) (acc ++# piece)

:= type_name (xsd_name : string) : string = "x_" ++# snake_from xsd_name 0i32 !- !- ""

:~ ^ has_name (target : string) (items : list string) : bool =
    ?= items ?|
    | x :: rest => x = target || has_name target rest
    | [] => !-

:= spiral_keywords () : list string =
    [
        "and"
        "as"
        "elif"
        "else"
        "false"
        "forall"
        "fun"
        "function"
        "global"
        "if"
        "in"
        "inl"
        "instance"
        "let"
        "match"
        "module"
        "nominal"
        "open"
        "or"
        "prototype"
        "rec"
        "then"
        "true"
        "type"
        "union"
        "when"
        "with"
    ]

:= field_name (xsd_name : string) : string =
    := name = snake_from (xml.local_name xsd_name) 0i32 !- !- ""
    ? has_name name (spiral_keywords ()) ?> name ++# "_value" |: name

:~ ^ case_from (s : string) (pos : i32) (acc : string) : string =
    ? pos >= sm'.length s ?> acc
    |:
        := c = xml.code_point_text s pos
        case_from s (pos + sm'.length c) (acc ++# (? is_alnum c ?> c |: "_"))

:= capitalized (s : string) : string =
    ? sm'.length s > 0i32 && is_upper (xml.code_point_text s 0i32) ?> s |: "X" ++# s

:= uri_tail (value : string) : string =
    := length : i32 = sm'.length value
    := hash = sm'.last_index_of "#" value
    ? hash >= 0i32 ?> sm'.substring (hash + 1i32) (length - hash - 1i32) value
    |:
        := trimmed = ? sm'.ends_with "/" value ?> sm'.substring 0i32 (length - 1i32) value |: value
        := trimmed_length : i32 = sm'.length trimmed
        := slash = sm'.last_index_of "/" trimmed
        sm'.substring (slash + 1i32) (trimmed_length - slash - 1i32) trimmed

:= case_value (value : string) : string = ? sm'.contains "://" value ?> uri_tail value |: value

:= case_name (owner : string) (value : string) : string =
    capitalized (case_from owner 0i32 "") ++# "_" ++# case_from (case_value value) 0i32 ""

:~ ^ distinct_values (values : list string) (seen : list string) (acc : list string) : list string =
    ?= values ?|
    | v :: rest =>
        ? has_name v seen ?> distinct_values rest seen acc |: distinct_values rest (v :: seen) (v :: acc)
    | [] => reverse acc []

:~ ^ enumeration_values (facets : list xsd_facet) (acc : list string) : list string =
    ?= facets ?|
    | Enumeration value :: rest => enumeration_values rest (value :: acc)
    | _ :: rest => enumeration_values rest acc
    | [] => reverse acc []

:= escape_text (s : string) : string = s |> sm'.replace "\\" "\\\\" |> sm'.replace "\"" "\\\""

:~ ^ join_lines (lines : list string) (acc : string) : string =
    ?= lines ?|
    | line :: rest => join_lines rest (acc ++# line ++# "\n")
    | [] => acc

:~ ^ map_strings (f : string -> string) (items : list string) (acc : list string) : list string =
    ?= items ?|
    | x :: rest => map_strings f rest (f x :: acc)
    | [] => reverse acc []

:~ ^ unused_case (candidate : string) (used : list string) : string =
    ? has_name candidate used ?> unused_case (candidate ++# "_") used |: candidate

:~ ^ value_cases
    (owner : string) (values : list string) (used : list string) (acc : list (string * string))
    : list (string * string)
    =
    ?= values ?|
    | v :: rest =>
        := case = unused_case (case_name owner v) used
        value_cases owner rest (case :: used) ((v, case) :: acc)
    | [] => reverse acc []

:~ ^ case_lines
    (pairs : list (string * string)) (line : string -> string -> string) (acc : list string)
    : list string
    =
    ?= pairs ?|
    | (v, case) :: rest => case_lines rest line (line v case :: acc)
    | [] => reverse acc []

:= digit_text (d : i32) : string = sm'.substring d 1i32 "0123456789"

:~ ^ digits_text (n : i32) (acc : string) : string =
    ? n < 10i32 ?> digit_text n ++# acc |: digits_text (n / 10i32) (digit_text (n % 10i32) ++# acc)

:= int_text (n : i32) : string = ? n < 0i32 ?> "-" ++# digits_text (0i32 - n) "" |: digits_text n ""

:~ ^ take_items \* t. (count : i32) (items : list t) : list t =
    ?= items ?|
    | x :: rest => ? count <= 0i32 ?> [] |: x :: take_items (count - 1i32) rest
    | [] => []

:~ ^ variant_arms (pairs : list (string * string)) (count : i32) (index : i32) (acc : string) : string =
    ?= pairs ?|
    | (_, last_case) :: [] => acc ++# (? index = 0i32 ?> "    " |: "    else ") ++# last_case ++# "\n"
    | (_, variant_case) :: rest =>
        := keyword = ? index = 0i32 ?> "    if" |: "    elif"
        variant_arms rest count
            (index + 1i32)
            (acc ++# keyword ++# " index = " ++# int_text index ++# "i32 then " ++# variant_case ++# "\n")
    | [] => acc

:= text_instance (ty : string) : string = "instance to_text " ++# ty ++# " = fun x => " ++# ty ++# "_to_string x\n"

:= codec_prelude () : string =
    "prototype to_text t : t -> string\n\n"
    ++# "inl text_node forall t {to_text}. (name : string) (v : t) : xml.xml_node =\n"
    ++# "    xml.element name [] (xml.text_children (to_text v))\n\n"
    ++# "inl optional_text_nodes forall t {to_text}. (name : string) (v : option t) : list xml.xml_node =\n"
    ++# "    xml.option_list (optionm.map (text_node name) v)\n\n"
    ++# "inl repeated_text_nodes forall t {to_text}. (name : string) (vs : list t) : list xml.xml_node =\n"
    ++# "    listm.map (text_node name) vs\n\n"

:= normalized_input (normalizer : string) : string = ? normalizer = "" ?> "" |: "    inl s = " ++# normalizer ++# " s\n"

:= union_text (name : string) (values : list string) (normalizer : string) : string =
    := ty = type_name name
    := pairs = value_cases name values [] []
    := cases = case_lines pairs (\ _ case => "    | " ++# case) []
    := parse_arms =
        case_lines pairs (\ v case => "    | \"" ++# escape_text v ++# "\" => Some " ++# case) []
    := print_arms = case_lines pairs (\ v case => "    | " ++# case ++# " => \"" ++# escape_text v ++# "\"") []
    := union_part = join_lines ("union " ++# ty ++# " =" :: cases) ""
    := parse_part =
        join_lines
            (
                "inl " ++# ty ++# "_of_string (s : string) : option " ++# ty ++# " ="
                :: normalized_input normalizer
                ++# "    match s with"
                :: parse_arms
            )
            ""
    := print_part =
        join_lines
            ("inl " ++# ty ++# "_to_string (x : " ++# ty ++# ") : string =" :: "    match x with" :: print_arms)
            ""
    := example_part =
        ?= pairs ?|
        | _ :: _ =>
            := variants = take_items 8i32 pairs
            := count = count_list variants
            := arms = variant_arms variants count 0i32 ""
            "\ninl "
            ++# ty
            ++# "_example (k : i32) : "
            ++# ty
            ++# " =\n    inl index = ((k % "
            ++# int_text count
            ++# "i32) + "
            ++# int_text count
            ++# "i32) % "
            ++# int_text count
            ++# "i32\n"
            ++# arms
            ++# "\ninl "
            ++# ty
            ++# "_example_text (k : i32) : string = "
            ++# ty
            ++# "_to_string ("
            ++# ty
            ++# "_example k)\n"
        | [] => ""
    union_part ++# "\n" ++# parse_part ++# "    | _ => None\n\n" ++# print_part
    ++# "\n"
    ++# text_instance ty
    ++# example_part

:= union_value_limit () : i32 = 256i32

:~ ^ example_pairs (ty : string) (values : list string) (acc : list (string * string)) : list (string * string) =
    ?= values ?|
    | v :: rest =>
        := case = ty ++# " \"" ++# escape_text v ++# "\""
        example_pairs ty rest ((v, case) :: acc)
    | [] => reverse acc []

:= coded_text (name : string) (table : string) (values : list string) (normalizer : string) : string =
    := ty = type_name name
    := examples = example_pairs ty (take_items 8i32 values) []
    := count = count_list examples
    "nominal private "
    ++# ty
    ++# " = string\n\n"
    ++# "inl "
    ++# ty
    ++# "_table () : string = \""
    ++# (escape_text table |> sm'.replace "\n" "\\n")
    ++# "\"\n\n"
    ++# "inl "
    ++# ty
    ++# "_of_string (s : string) : option "
    ++# ty
    ++# " =\n"
    ++# normalized_input normalizer
    ++# "    if xsd_regex.table_matches ("
    ++# ty
    ++# "_table ()) s then Some ("
    ++# ty
    ++# " s) else None\n\n"
    ++# "inl "
    ++# ty
    ++# "_to_string (x : "
    ++# ty
    ++# ") : string = match x with "
    ++# ty
    ++# " s => s\n"
    ++# text_instance ty
    ++# "\n"
    ++# "inl "
    ++# ty
    ++# "_example (k : i32) : "
    ++# ty
    ++# " =\n    inl index = ((k % "
    ++# int_text count
    ++# "i32) + "
    ++# int_text count
    ++# "i32) % "
    ++# int_text count
    ++# "i32\n"
    ++# variant_arms examples count 0i32 ""
    ++# "\ninl "
    ++# ty
    ++# "_example_text (k : i32) : string = "
    ++# ty
    ++# "_to_string ("
    ++# ty
    ++# "_example k)\n"

:~ ^ join_with (separator : string) (items : list string) (acc : string) : string =
    ?= items ?|
    | item :: rest => join_with separator rest (? acc = "" ?> item |: acc ++# separator ++# item)
    | [] => acc

:= u32_text (n : u32) : string = int_text (conv n : i32)

:~ ^ range_tests
    (moves : list xsd_regex.dfa_move) (function_name : string) (keyword : string) (acc : string)
    : string
    =
    ?= moves ?|
    | move :: rest =>
        := test =
            ? move.low = move.high ?> "c = " ++# u32_text move.low ++# "u32"
            |: u32_text move.low ++# "u32 <= c && c <= " ++# u32_text move.high ++# "u32"
        := arm =
            "            "
            ++# keyword
            ++# " "
            ++# test
            ++# " then "
            ++# function_name
            ++# " "
            ++# int_text move.target
            ++# "i32 s next\n"
        range_tests rest function_name "elif" (acc ++# arm)
    | [] => ? acc = "" ?> "            false\n" |: acc ++# "            else false\n"

:~ ^ state_arms (rows : list xsd_regex.dfa_state) (function_name : string) (index : i32) (acc : string) : string =
    ?= rows ?|
    | row :: rest =>
        := keyword = ? index = 0i32 ?> "        if" |: "        elif"
        := arm =
            keyword ++# " state = " ++# int_text index ++# "i32 then\n" ++# range_tests row.moves function_name "if" ""
        state_arms rest function_name (index + 1i32) (acc ++# arm)
    | [] => acc ++# "        else false\n"

:~ ^ accepting_states (rows : list xsd_regex.dfa_state) (index : i32) (acc : string) : string =
    ?= rows ?|
    | row :: rest =>
        := acc =
            ? row.accepting ?> (? acc = "" ?> "" |: acc ++# " || ") ++# "state = " ++# int_text index ++# "i32"
            |: acc
        accepting_states rest (index + 1i32) acc
    | [] => ? acc = "" ?> "false" |: acc

:= dfa_function_text (function_name : string) (rows : list xsd_regex.dfa_state) : string =
    "let rec " ++# function_name ++# " (state : i32) (s : string) (i : i32) : bool =\n"
    ++# "    if i >= sm'.length s then " ++# accepting_states rows 0i32 "" ++# "\n"
    ++# "    else\n"
    ++# "        inl c = xml.code_point_at s i\n"
    ++# "        inl next = i + xml.code_point_width s i\n"
    ++# state_arms rows function_name 0i32 ""

:= direct_coded_state_limit () : i32 = 128i32

:= direct_coded_dfa (p : string) : option (list xsd_regex.dfa_state) =
    xsd_regex.dfa_of_pattern_within (direct_coded_state_limit ()) p

:~ ^ fnv_from (s : string) (i : i32) (h : u64) : u64 =
    ? i >= sm'.length s ?> h
    |:
        fnv_from s
            (i + xml.code_point_width s i)
            (((h ^^^ (conv (xml.code_point_at s i) : u64)) * 16777619u64) &&& 4294967295u64)

:~ ^ hex_text (n : u64) (digits : i32) (acc : string) : string =
    ? digits <= 0i32 ?> acc
    |:
        hex_text (n >>> 4i32) (digits - 1i32) (sm'.substring (conv (n &&& 15u64) : i32) 1i32 "0123456789abcdef" ++# acc)

:= pattern_function_name (p : string) : string =
    "xsd_pattern_" ++# hex_text (fnv_from p 0i32 2166136261u64) 8i32 "" ++# "_" ++# int_text (sm'.length p)

:| value_set =
    | NoValueSet
    | DfaValueSet : string
    | UnionValueSet : list string

:~ ^ same_strings (a : list string) (b : list string) : bool =
    ?= a, b ?|
    | (x :: a_rest), (y :: b_rest) => x = y && same_strings a_rest b_rest
    | [], [] => !+
    | _ => !-

:= same_value_set (a : value_set) (b : value_set) : bool =
    ?= a, b ?|
    | DfaValueSet x, DfaValueSet y => x = y
    | UnionValueSet x, UnionValueSet y => same_strings x y
    | _ => !-

:| item_role =
    | PlainItem
    | CertificateItem

:== emitted = { name : string; references : list string; text : string; value_set : value_set; role : item_role }

:= is_certificate (item : emitted) : bool =
    ?= item.role ?|
    | CertificateItem => !+
    | PlainItem => !-

:== pattern_code = { functions : list emitted; checks : list string; references : list string }

:~ ^ moves_certificate_text (moves : list xsd_regex.dfa_move) : string =
    ?= moves ?|
    | move :: rest =>
        "xsd_certificate.MovesNext ("
        ++# int_text (conv move.low : i32)
        ++# "u32, "
        ++# int_text (conv move.high : i32)
        ++# "u32, "
        ++# int_text move.target
        ++# "i32, "
        ++# moves_certificate_text rest
        ++# ")"
    | [] => "xsd_certificate.MovesEnd"

:~ ^ rows_certificate_text (rows : list xsd_regex.dfa_state) (acc : string) : string =
    ?= rows ?|
    | row :: rest =>
        := accepting = ? row.accepting ?> "true" |: "false"
        := line =
            "    xsd_certificate.CertifiedRow ("
            ++# accepting
            ++# ", xsd_certificate.PackedMoves (exists ("
            ++# moves_certificate_text row.moves
            ++# ")))\n    :: "
        rows_certificate_text rest (acc ++# line)
    | [] => acc ++# "[]\n"

:= certificate_item (name : string) (rows : list xsd_regex.dfa_state) : emitted =
    {
        name = name ++# "_certificate"
        references = []
        text = "inl " ++# name ++# "_certificate () =\n" ++# rows_certificate_text rows ""
        value_set = NoValueSet
        role = CertificateItem
    }

:~ ^ certificate_calls (items : list emitted) (acc : string) : string =
    ?= items ?|
    | item :: rest =>
        ? is_certificate item
        ?> certificate_calls rest (acc ++# " + xsd_certificate.certified_table (" ++# item.name ++# " ())")
        |: certificate_calls rest acc
    | [] => acc

:= certificates_checked_text (items : list emitted) : string =
    "\ninl certificates_checked () : i32 = 0i32" ++# certificate_calls items "" ++# "\n"

:= emit_enumeration (name : string) (values : list string) (normalizer : string) : list emitted =
    ? count_list values > union_value_limit () ?>
        := rows = xsd_regex.dfa_of_values values
        := table = xsd_regex.dfa_table_text rows
        {
            name = type_name name
            references = []
            text = coded_text name table values normalizer
            value_set = DfaValueSet table
            role = PlainItem
        }
        :: certificate_item (type_name name ++# "_table") rows
        :: []
    |:
        := values = distinct_values values [] []
        {
            name = type_name name
            references = []
            text = union_text name values normalizer
            value_set = UnionValueSet values
            role = PlainItem
        }
        :: []

:~ ^ pattern_checks (facets : list xsd_facet) (acc : pattern_code) : pattern_code =
    ?= facets ?|
    | Pattern p :: rest =>
        ?= direct_coded_dfa p ?|
        | Some rows =>
            := function_name = pattern_function_name p
            := state_function =
                {
                    name = function_name
                    references = []
                    text = dfa_function_text function_name rows
                    value_set = NoValueSet
                    role = PlainItem
                }
            pattern_checks rest {
                functions = (state_function :: certificate_item function_name rows :: acc.functions)
                checks = ((function_name ++# " 0i32 s 0i32") :: acc.checks)
                references = (function_name :: acc.references)
            }
        | None =>
            ?= xsd_regex.dfa_of_pattern p ?|
            | Some rows =>
                := table_name = pattern_function_name p ++# "_table"
                := table_text =
                    "inl "
                    ++# table_name
                    ++# " () : string = \""
                    ++# (escape_text (xsd_regex.dfa_table_text rows) |> sm'.replace "\n" "\\n")
                    ++# "\"\n"
                := table_function =
                    {
                        name = table_name
                        references = []
                        text = table_text
                        value_set = NoValueSet
                        role = PlainItem
                    }
                pattern_checks rest {
                    functions = (table_function :: certificate_item table_name rows :: acc.functions)
                    checks = (("xsd_regex.table_matches (" ++# table_name ++# " ()) s") :: acc.checks)
                    references = (table_name :: acc.references)
                }
            | None =>
                ? xsd_regex.is_xsd_pattern p = !-
                ?> failwith ("an xs:pattern XSD forbids (lookaround, or a quantifier with nothing to repeat): " ++# p)
                |:
                    pattern_checks rest { acc ?|
                        checks = (("xsd_regex.pattern_matches \"" ++# escape_text p ++# "\" s") :: acc.checks)
                    }
    | _ :: rest => pattern_checks rest acc
    | [] => { acc ?| checks = reverse acc.checks [] }

:~ ^ length_checks (facets : list xsd_facet) (acc : list string) : list string =
    ?= facets ?|
    | Length n :: rest => length_checks rest ("xml.code_point_count s = " ++# int_text n :: acc)
    | MinLength n :: rest => length_checks rest ("xml.code_point_count s >= " ++# int_text n :: acc)
    | MaxLength n :: rest => length_checks rest ("xml.code_point_count s <= " ++# int_text n :: acc)
    | _ :: rest => length_checks rest acc
    | [] => reverse acc []

:= validator_text (name : string) (code : pattern_code) (facets : list xsd_facet) : string =
    := patterns =
        ?= code.checks ?|
        | [] => []
        | checks => ("(" ++# join_with " || " checks "" ++# ")") :: []
    := conjuncts = listm.append patterns (length_checks facets [])
    := body =
        ?= conjuncts ?|
        | [] => "true"
        | _ => join_with " && " conjuncts ""
    "inl " ++# type_name name ++# "_is_valid (s : string) : bool = " ++# body ++# "\n"

:== collected = { fields : list string; references : list string; extra : list emitted }

:= is_builtin_reference (reference : string) : bool = reference = "" || xsd_resolve.is_builtin reference

:= reference_type (type_reference reference) : string =
    ? is_builtin_reference reference ?> "string" |: type_name (xml.local_name reference)

:= reference_dependency (type_reference reference) : list string =
    ? is_builtin_reference reference ?> [] |: type_name (xml.local_name reference) :: []

:= reference_type_of \* form. (reference : option (type_reference form)) : string =
    ?= reference ?|
    | Some r => reference_type r
    | None => "string"

:= reference_dependency_of \* form. (reference : option (type_reference form)) : list string =
    ?= reference ?|
    | Some r => reference_dependency r
    | None => []

:| occurs_shape =
    | Required
    | Optional
    | Repeated

:= shape_of (o : occurs) : occurs_shape =
    ?= o.max ?|
    | Bounded n => ? n <> 1i32 ?> Repeated |? o.min = 0i32 ?> Optional |: Required
    | Unbounded => Repeated

:= with_occurs (o : occurs) (t : string) : string =
    ?= shape_of o ?|
    | Optional => "option (" ++# t ++# ")"
    | Required => t
    | Repeated => "list (" ++# t ++# ")"

:~ ^ particle_requires_staged \* form. (staged : list string) (particle : xsd particle form) : bool =
    ?= particle ?|
    | Element e =>
        ? e.occurs.min < 1i32 ?> !-
        |? has_name (xml.local_name (tag_text e.name)) staged ?> !+
        |:
            ?= e.inline ?|
            | Some inner => type_requires_staged staged inner
            | None => !-
    | Sequence s => s.occurs.min >= 1i32 && any_particle_requires_staged staged s.items
    | Choice c =>
        c.occurs.min >= 1i32 && listm.length c.items > 0i32 && every_particle_requires_staged staged c.items
    | _ => !-

:& :~ any_particle_requires_staged \* form. (staged : list string) (items : list (xsd particle form)) : bool =
    ?= items ?|
    | item :: rest => particle_requires_staged staged item || any_particle_requires_staged staged rest
    | [] => !-

:& :~ every_particle_requires_staged \* form. (staged : list string) (items : list (xsd particle form)) : bool =
    ?= items ?|
    | item :: rest => particle_requires_staged staged item && every_particle_requires_staged staged rest
    | [] => !+

:& :~ type_requires_staged \* form. (staged : list string) (definition : xsd type_def form) : bool =
    ?= definition ?|
    | Complex c => particle_requires_staged staged c.content
    | Derived d => particle_requires_staged staged d.content
    | _ => !-

:~ ^ first_element_name \* form. (items : list (xsd particle form)) : string =
    ?= items ?|
    | (Element e) :: _ => tag_text e.name
    | (Sequence s) :: rest => first_in_group s.items rest
    | (Choice c) :: rest => first_in_group c.items rest
    | _ :: rest => first_element_name rest
    | [] => "empty"

:& :~ first_in_group \* form. (inner : list (xsd particle form)) (rest : list (xsd particle form)) : string =
    ?= inner ?|
    | [] => first_element_name rest
    | _ => first_element_name inner

:= inner_owner (owner : string) (name : string) : string = ? owner = "" ?> name |: owner ++# "_" ++# name

:= choice_owner \* form. (owner : string) (items : list (xsd particle form)) : string =
    owner ++# "_choice_" ++# first_element_name items

:~ ^ particle_mentions \* form. (names : list string) (owner : string) (particle : xsd particle form) : bool =
    ?= particle ?|
    | Element e =>
        ?= e.inline, e.type_ref ?|
        | Some inner, _ =>
            := raw = inner_owner owner (tag_text e.name)
            has_name (type_name raw) names || type_mentions names raw inner
        | None, Some reference => has_name (reference_type reference) names
        | None, None => !-
    | Sequence s => any_particle_mentions names owner s.items
    | Choice c => any_particle_mentions names (choice_owner owner c.items) c.items
    | _ => !-

:& :~ any_particle_mentions \* form. (names : list string) (owner : string) (items : list (xsd particle form)) : bool =
    ?= items ?|
    | item :: rest => particle_mentions names owner item || any_particle_mentions names owner rest
    | [] => !-

:& :~ type_mentions \* form. (names : list string) (owner : string) (definition : xsd type_def form) : bool =
    ?= definition ?|
    | Complex c => particle_mentions names owner c.content
    | Derived d => has_name (reference_type d.base) names || particle_mentions names owner d.content
    | _ => !-

:~ ^ inline_candidates \* form.
    (owner : string) (particle : xsd particle form) (acc : list (string * xsd type_def form))
    : list (string * xsd type_def form)
    =
    ?= particle ?|
    | Element e =>
        ?= e.inline ?|
        | Some inner =>
            := raw = inner_owner owner (tag_text e.name)
            inline_definition_candidates raw inner ((raw, inner) :: acc)
        | None => acc
    | Sequence s => inline_all_candidates owner s.items acc
    | Choice c => inline_all_candidates (choice_owner owner c.items) c.items acc
    | _ => acc

:& :~ inline_all_candidates \* form.
    (owner : string) (items : list (xsd particle form)) (acc : list (string * xsd type_def form))
    : list (string * xsd type_def form)
    =
    ?= items ?|
    | item :: rest => inline_all_candidates owner rest (inline_candidates owner item acc)
    | [] => acc

:& :~ inline_definition_candidates \* form.
    (owner : string) (definition : xsd type_def form) (acc : list (string * xsd type_def form))
    : list (string * xsd type_def form)
    =
    ?= definition ?|
    | Complex c => inline_candidates owner c.content acc
    | Derived d => inline_candidates owner d.content acc
    | _ => acc

:~ ^ named_candidates \* form.
    (definitions : list (xsd type_def form)) (acc : list (string * xsd type_def form))
    : list (string * xsd type_def form)
    =
    ?= definitions ?|
    | (Complex c) :: rest =>
        := raw = definition_text c.name
        named_candidates rest (inline_candidates raw c.content ((raw, Complex c) :: acc))
    | (Derived d) :: rest =>
        := raw = definition_text d.name
        named_candidates rest (inline_candidates raw d.content ((raw, Derived d) :: acc))
    | _ :: rest => named_candidates rest acc
    | [] => acc

:~ ^ directly_staged \* form.
    (staged : list string) (candidates : list (string * xsd type_def form)) (acc : list string)
    : list string
    =
    ?= candidates ?|
    | (raw, definition) :: rest =>
        := name = type_name raw
        := fresh = (has_name name acc) = !-
        directly_staged staged rest (? fresh && type_requires_staged staged definition ?> name :: acc |: acc)
    | [] => acc

:~ ^ add_staged \* form.
    (candidates : list (string * xsd type_def form)) (names : list string) (acc : list string)
    : list string
    =
    ?= candidates ?|
    | (raw, definition) :: rest =>
        := name = type_name raw
        := fresh = (has_name name acc) = !-
        add_staged rest names (? fresh && type_mentions names raw definition ?> name :: acc |: acc)
    | [] => acc

:~ ^ grow_staged \* form. (candidates : list (string * xsd type_def form)) (names : list string) : list string =
    := next = add_staged candidates names names
    ? (listm.length next : i32) = listm.length names ?> names |: grow_staged candidates next

:= field_line (name : string) (t : string) : string = "        " ++# field_name name ++# " : " ++# t

:= staging_prelude () : string =
    "nominal unsigned = ()\nnominal signed = ()\n\n"
    ++# "union staged s a =\n"
    ++# "    | Pending :: forall a. string -> staged unsigned a\n"
    ++# "    | Present :: forall a. a -> staged signed a\n\n"
    ++# "union stage s =\n"
    ++# "    | Unsigned :: stage unsigned\n"
    ++# "    | Signed :: stage signed\n\n"
    ++# "inl staged_of forall s a. (witness : stage s) (read : () -> a) : staged s a =\n"
    ++# "    match witness with\n"
    ++# "    | Unsigned => Pending \"unsigned\"\n"
    ++# "    | Signed => Present (read ())\n\n"
    ++# "inl signed_value forall a. (x : staged signed a) : a =\n"
    ++# "    match x with\n"
    ++# "    | Present v => v\n\n"
    ++# "inl staged_list forall s a b. (f : a -> b) (x : staged s a) : list b =\n"
    ++# "    match x with\n"
    ++# "    | Pending _ => []\n"
    ++# "    | Present v => [f v]\n\n"

:~ ^ staged_references (staged : list string) (text : string) : string =
    ?= staged ?|
    | t :: rest =>
        := text = sm'.replace (" : " ++# t ++# "\n") (" : " ++# t ++# " s\n") text
        := text = sm'.replace ("option (" ++# t ++# ")") ("option (" ++# t ++# " s)") text
        staged_references rest (sm'.replace ("list (" ++# t ++# ")") ("list (" ++# t ++# " s)") text)
    | [] => text

:= line_after (marker : string) (text : string) : option string =
    := at = sm'.index_of marker text
    ? at < 0i32 ?> None
    |:
        := from = at + sm'.length marker
        := tail = sm'.substring from (sm'.length text - from) text
        := stop = sm'.index_of "\n" tail
        Some (sm'.substring 0i32 (? stop < 0i32 ?> sm'.length tail |: stop) tail)

:= staged_type (t : string) : string = "staged s " ++# (? sm'.contains " " t ?> "(" ++# t ++# ")" |: t)

:~ ^ staged_signatures (signatures : list string) (text : string) : string =
    ?= signatures ?|
    | name :: rest =>
        := line = "\n" ++# field_line name ""
        ?= line_after line text ?|
        | Some t ?& sm'.starts_with "staged " t = !- =>
            staged_signatures rest (sm'.replace (line ++# t ++# "\n") (line ++# staged_type t ++# "\n") text)
        | _ => staged_signatures rest text
    | [] => text

:= staged_item (staged : list string) (signatures : list string) (item : emitted) : emitted =
    ? has_name item.name staged = !- ?> item
    |:
        := text = sm'.replace ("type " ++# item.name ++# " =") ("type " ++# item.name ++# " s =") item.text
        { item ?| text = staged_signatures signatures (staged_references staged text) }

:= staged_items (staged : list string) (signatures : list string) (items : list emitted) : list emitted =
    listm.map (staged_item staged signatures) items

:= choice_field_of (first : string) : string = field_name ("choice_" ++# xml.local_name first)

:= line_width () : i32 = 120i32

:= field_assignment (field : string) (expression : string) : string =
    := one_line = "        " ++# field ++# " = " ++# expression
    ? sm'.length one_line <= line_width () ?> one_line
    |: "        " ++# field ++# " =\n            " ++# expression

:= fitted_definition (head : string) (body : string) : string =
    := one_line = head ++# " " ++# body
    ? sm'.length one_line <= line_width () ?> one_line ++# "\n" |: head ++# "\n    " ++# body ++# "\n"

:= fitted_header (name : string) (parameters : string) (result : string) : string =
    := one_line = name ++# " " ++# parameters ++# " : " ++# result ++# " ="
    ? sm'.length one_line <= line_width () ?> one_line ++# "\n"
    |: name ++# "\n    " ++# parameters ++# "\n    : " ++# result ++# "\n    =\n"

:~ ^ patterns_accept (facets : list xsd_facet) (s : string) (matched : bool) (none_seen : bool) : bool =
    ?= facets ?|
    | Pattern p :: rest => patterns_accept rest s (matched || xsd_regex.pattern_matches p s) !-
    | _ :: rest => patterns_accept rest s matched none_seen
    | [] => matched || none_seen

:~ ^ lengths_accept (facets : list xsd_facet) (s : string) : bool =
    ?= facets ?|
    | Length n :: rest => xml.code_point_count s = n && lengths_accept rest s
    | MinLength n :: rest => xml.code_point_count s >= n && lengths_accept rest s
    | MaxLength n :: rest => xml.code_point_count s <= n && lengths_accept rest s
    | _ :: rest => lengths_accept rest s
    | [] => !+

:~ ^ first_pattern (facets : list xsd_facet) : option string =
    ?= facets ?|
    | Pattern p :: _ => Some p
    | _ :: rest => first_pattern rest
    | [] => None

:~ ^ has_length_facet (facets : list xsd_facet) : bool =
    ?= facets ?|
    | Length _ :: _ => !+
    | MinLength _ :: _ => !+
    | MaxLength _ :: _ => !+
    | _ :: rest => has_length_facet rest
    | [] => !-

:~ ^ min_length (facets : list xsd_facet) : i32 =
    ?= facets ?|
    | Length n :: _ => n
    | MinLength n :: _ => n
    | _ :: rest => min_length rest
    | [] => 1i32

:~ ^ example_search (facets : list xsd_facet) (r : xsd_regex.rx) (stars : i32) : string =
    ? stars > 64i32 ?> xsd_regex.example_with 1i32 r
    |:
        := candidate = xsd_regex.example_with stars r
        ? patterns_accept facets candidate !- !+ && lengths_accept facets candidate ?> candidate
        |: example_search facets r (stars + 1i32)

:= builtin_example (reference : string) : string =
    := local = xml.local_name reference
    ? local = "base64Binary" ?> "AAAA"
    |? local = "anyURI" ?> "http://example.com"
    |? local = "ID" ?> "ID1"
    |? local = "dateTime" ?> "2026-01-01T00:00:00"
    |? local = "date" ?> "2026-01-01"
    |? local = "boolean" ?> "true"
    |: "1"

:= is_calendar_builtin (base : string) : bool =
    := local = xml.local_name base
    base <> "" && is_builtin_reference base && (local = "date" || local = "dateTime")

:= prefers_builtin_example (base : string) : bool =
    is_calendar_builtin base || (is_builtin_reference base && xml.local_name base = "positiveInteger")

:= simple_example (base : string) (facets : list xsd_facet) : string =
    ?= first_pattern facets ?|
    | Some p =>
        := calendar = builtin_example base
        ? prefers_builtin_example base && xsd_regex.pattern_matches p calendar && has_length_facet facets = !-
        ?> calendar
        |:
            ?= xsd_regex.compile_pattern p ?|
            | Some r => example_search facets r 0i32
            | None => "1"
    | None =>
        ? is_builtin_reference base ?>
            := text = builtin_example base
            ? xml.code_point_count text >= min_length facets ?> text |: xsd_regex.repeated "1" (min_length facets)
        |: xsd_regex.repeated "1" (? min_length facets < 1i32 ?> 1i32 |: min_length facets)

:= is_constrained (facets : list xsd_facet) : bool =
    (?= first_pattern facets ?| Some _ => !+ | None => !-) || has_length_facet facets

:~ ^ explicit_white_space (facets : list xsd_facet) : option string =
    ?= facets ?|
    | WhiteSpace mode :: _ => Some mode
    | _ :: rest => explicit_white_space rest
    | [] => None

:= builtin_white_space (base : string) : string =
    := local = xml.local_name base
    ? base = "" || is_builtin_reference base = !- || local = "string" ?> "preserve"
    |? local = "normalizedString" ?> "replace"
    |: "collapse"

:= white_space_normalizer (base : string) (facets : list xsd_facet) : string =
    := mode = ?= explicit_white_space facets ?| Some mode => mode | None => builtin_white_space base
    ? mode = "collapse" ?> "xml.collapsed_space" |? mode = "replace" ?> "xml.replaced_space" |: ""

:= validated_text
    (ty : string) (name : string) (code : pattern_code) (facets : list xsd_facet) (normalizer : string)
    (example : string)
    : string =
    := checked = "if " ++# ty ++# "_is_valid s then Some (" ++# ty ++# " s) else None"
    := of_string =
        fitted_definition
            ("inl " ++# ty ++# "_of_string (s : string) : option " ++# ty ++# " =")
            (? normalizer = "" ?> checked |: "match " ++# normalizer ++# " s with s => " ++# checked)
    := to_string =
        fitted_definition
            ("inl " ++# ty ++# "_to_string (x : " ++# ty ++# ") : string =")
            ("match x with " ++# ty ++# " s => s")
    := example_value =
        fitted_definition
            ("inl " ++# ty ++# "_example (_ : i32) : " ++# ty ++# " =")
            (ty ++# " \"" ++# escape_text example ++# "\"")
    := example_text =
        fitted_definition
            ("inl " ++# ty ++# "_example_text (k : i32) : string =")
            (ty ++# "_to_string (" ++# ty ++# "_example k)")
    "nominal private "
    ++# ty
    ++# " = string\n\n"
    ++# validator_text name code facets
    ++# "\n"
    ++# of_string
    ++# "\n"
    ++# to_string
    ++# "\n"
    ++# text_instance ty
    ++# example_value
    ++# "\n"
    ++# example_text

:~ ^ emit_named_type \* form. (name : string) (item : xsd type_def form) : list emitted =
    ?= item ?|
    | Simple s =>
        ?= enumeration_values s.facets [] ?|
        | [] =>
            := ty = type_name name
            := inherits =
                is_builtin_reference (reference_text s.base) = !-
                && (?= first_pattern s.facets ?| Some _ => !- | None => !+)
                && has_length_facet s.facets = !-
            := example =
                ? inherits
                ?> "inl " ++# ty ++# "_example (k : i32) : string = " ++# reference_type s.base ++# "_example_text k\n"
                |:
                    "inl "
                    ++# ty
                    ++# "_example (_ : i32) : string = \""
                    ++# escape_text (simple_example (reference_text s.base) s.facets)
                    ++# "\"\n"
            := example_text = "\ninl " ++# ty ++# "_example_text (k : i32) : string = " ++# ty ++# "_example k\n"
            := code = pattern_checks s.facets { functions = []; checks = []; references = [] }
            := references = listm.append (? inherits ?> reference_dependency s.base |: []) code.references
            {
                name = ty
                references = references
                text =
                    ? is_constrained s.facets
                    ?>
                        := normalizer = white_space_normalizer (reference_text s.base) s.facets
                        := example = simple_example (reference_text s.base) s.facets
                        validated_text ty name code s.facets normalizer example
                    |:
                        "type "
                        ++# ty
                        ++# " = string\n\n"
                        ++# validator_text name code s.facets
                        ++# "\n"
                        ++# example
                        ++# example_text
                value_set = NoValueSet
                role = PlainItem
            }
            :: code.functions
        | values => emit_enumeration name values (white_space_normalizer (reference_text s.base) s.facets)
    | Complex c => emit_record name c.content c.attributes [] []
    | Derived d =>
        emit_record name d.content d.attributes
            (field_line "base" (reference_type d.base) :: [])
            (reference_dependency d.base)

:& :~ emit_named_group \* form. (name : string) (group : xsd particle form) : list emitted =
    emit_record name group [] [] []

:& :~ emit_record \* form.
    (name : string) (content : xsd particle form) (attributes : list (xsd attribute_decl form))
    (prefix_fields : list string)
    (prefix_references : list string)
    : list emitted
    =
    := (gathered : collected) =
        collect_attributes name attributes (
            collect_content name content { fields = []; references = []; extra = [] }
        )
    := fields = listm.append prefix_fields (reverse gathered.fields [])
    := ty = type_name name
    := text =
        ?= fields ?|
        | [] => "type " ++# ty ++# " = ()\n"
        | _ => "type " ++# ty ++# " =\n    {\n" ++# join_lines fields "" ++# "    }\n"
    {
        name = ty
        references = listm.append prefix_references gathered.references
        text = text
        value_set = NoValueSet
        role = PlainItem
    }
    :: gathered.extra

:& :~ collect_content \* form. (owner : string) (item : xsd particle form) (acc : collected) : collected =
    ?= item ?|
    | Sequence s => collect_items owner s.items acc
    | Choice c =>
        := choice_name = owner ++# "_choice_" ++# first_element_name c.items
        := union_emitted = emit_choice choice_name c.items
        := field = choice_field_of (first_element_name c.items)
        {
            fields =
                "        " ++# field ++# " : " ++# with_occurs c.occurs (type_name choice_name)
                :: acc.fields
            references = type_name choice_name :: acc.references
            extra = listm.append union_emitted acc.extra
        }
    | Element e =>
        := name = tag_text e.name
        ?= e.inline ?|
        | Some inner =>
            := inner_name = owner ++# "_" ++# name
            {
                fields = field_line name (with_occurs e.occurs (type_name inner_name)) :: acc.fields
                references = type_name inner_name :: acc.references
                extra = listm.append (emit_named_type inner_name inner) acc.extra
            }
        | None =>
            {
                fields = field_line name (with_occurs e.occurs (reference_type_of e.type_ref)) :: acc.fields
                references = listm.append (reference_dependency_of e.type_ref) acc.references
                extra = acc.extra
            }
    | AnyContent () =>
        {
            fields = field_line "any" "any_content" :: acc.fields
            references = acc.references
            extra = acc.extra
        }
    | Empty () => acc

:& :~ collect_items \* form. (owner : string) (items : list (xsd particle form)) (acc : collected) : collected =
    ?= items ?|
    | item :: rest => collect_items owner rest (collect_content owner item acc)
    | [] => acc

:& :~ emit_choice \* form. (choice_name : string) (items : list (xsd particle form)) : list emitted =
    := (cases : collected) = choice_cases choice_name items { fields = []; references = []; extra = [] }
    := ty = type_name choice_name
    := text = join_lines ("union " ++# ty ++# " =" :: reverse cases.fields []) ""
    { name = ty; references = cases.references; text = text; value_set = NoValueSet; role = PlainItem } :: cases.extra

:& :~ choice_cases \* form. (choice_name : string) (items : list (xsd particle form)) (acc : collected) : collected =
    ?= items ?|
    | (Element e) :: rest =>
        := name = tag_text e.name
        := case_label = "    | " ++# case_name choice_name name ++# " : "
        ?= e.inline ?|
        | Some inner =>
            := inner_name = choice_name ++# "_" ++# name
            choice_cases choice_name rest
                {
                    fields = case_label ++# with_occurs e.occurs (type_name inner_name) :: acc.fields
                    references = type_name inner_name :: acc.references
                    extra = listm.append (emit_named_type inner_name inner) acc.extra
                }
        | None =>
            choice_cases choice_name rest
                {
                    fields = case_label ++# with_occurs e.occurs (reference_type_of e.type_ref) :: acc.fields
                    references = listm.append (reference_dependency_of e.type_ref) acc.references
                    extra = acc.extra
                }
    | (Sequence s) :: rest =>
        := group_name = choice_name ++# "_group_" ++# first_element_name s.items
        choice_cases choice_name rest {
            fields =
                "    | "
                ++# case_name choice_name ("group_" ++# first_element_name s.items)
                ++# " : "
                ++# type_name group_name
                :: acc.fields
            references = type_name group_name :: acc.references
            extra = listm.append (emit_named_group group_name (Sequence s)) acc.extra
        }
    | _ :: rest => choice_cases choice_name rest acc
    | [] => acc

:& :~ collect_attributes \* form.
    (owner : string) (attributes : list (xsd attribute_decl form)) (acc : collected)
    : collected
    =
    ?= attributes ?|
    | (Attribute a) :: rest =>
        := inner_name = owner ++# "_" ++# tag_text a.name
        := t = ?= a.inline ?| Some _ => type_name inner_name | None => reference_type_of a.type_ref
        := references =
            ?= a.inline ?|
            | Some _ => type_name inner_name :: []
            | None => reference_dependency_of a.type_ref
        := extra = ?= a.inline ?| Some inner => emit_named_type inner_name inner | None => []
        collect_attributes owner rest
            {
                fields = field_line (tag_text a.name) (? a.required ?> t |: "option (" ++# t ++# ")") :: acc.fields
                references = listm.append references acc.references
                extra = listm.append extra acc.extra
            }
    | [] => acc

:= emit_type \* form. (item : xsd type_def form) : list emitted = emit_named_type (xsd_resolve.type_name_of item) item

:= emit_root \* form. (item : xsd particle form) : list emitted =
    ?= item ?|
    | Element e => ?= e.inline ?| Some inner => emit_named_type (tag_text e.name) inner | None => []
    | _ => []

:~ ^ emit_types \* form. (types : list (xsd type_def form)) (acc : list emitted) : list emitted =
    ?= types ?|
    | item :: rest => emit_types rest (listm.append (emit_type item) acc)
    | [] => acc

:~ ^ emit_roots \* form. (items : list (xsd particle form)) (acc : list emitted) : list emitted =
    ?= items ?|
    | item :: rest => emit_roots rest (listm.append (emit_root item) acc)
    | [] => acc

:~ ^ emitted_names (items : list emitted) (acc : list string) : list string =
    ?= items ?|
    | item :: rest => emitted_names rest (item.name :: acc)
    | [] => acc

:~ ^ unique_emitted (items : list emitted) (seen : list string) (acc : list emitted) : list emitted =
    ?= items ?|
    | item :: rest =>
        ? has_name item.name seen ?> unique_emitted rest seen acc
        |: unique_emitted rest (item.name :: seen) (item :: acc)
    | [] => reverse acc []

:~ ^ references_ready (references : list string) (done_names : list string) : bool =
    ?= references ?|
    | reference :: rest => has_name reference done_names && references_ready rest done_names
    | [] => !+

:~ ^ known_references (references : list string) (known : list string) (acc : list string) : list string =
    ?= references ?|
    | reference :: rest => known_references rest known (? has_name reference known ?> (reference :: acc) |: acc)
    | [] => reverse acc []

:~ ^ with_known_references (items : list emitted) (known : list string) (acc : list emitted) : list emitted =
    ?= items ?|
    | item :: rest =>
        with_known_references rest known ({ item ?| references = known_references item.references known [] } :: acc)
    | [] => reverse acc []

:~ ^ order_pass
    (pending : list emitted) (known : list string) (done_names : list string) (ordered : list emitted)
    (deferred : list emitted)
    : list string * list emitted * list emitted
    =
    ?= pending ?|
    | item :: rest =>
        ? references_ready item.references done_names
        ?> order_pass rest known (item.name :: done_names) (item :: ordered) deferred
        |: order_pass rest known done_names ordered (item :: deferred)
    | [] => done_names, ordered, reverse deferred []

:= reindented_fields (fields : string) : string =
    ? fields = "" ?> ""
    |: "    " ++# sm'.replace "\n" "\n    " (sm'.substring 0i32 (sm'.length fields - 1i32) fields) ++# "\n"

:= wrapped_record (head : string) (item : emitted) : string =
    := opening = "type " ++# item.name ++# " =\n    {\n"
    := closing = "    }\n"
    := fields =
        sm'.substring (sm'.length opening) (sm'.length item.text - sm'.length opening - sm'.length closing) item.text
    head
    ++# item.name
    ++# " =\n    | Record_"
    ++# item.name
    ++# " :\n        {\n"
    ++# reindented_fields fields
    ++# "        }\n"

:~ ^ group_members
    (items : list emitted) (first : bool) (members : list emitted) (others : list emitted) (wrapped : list string)
    : list emitted * list string
    =
    ?= items ?|
    | item :: rest =>
        := head = ? first ?> "union rec " |: "and union "
        ? sm'.starts_with ("type " ++# item.name ++# " =\n    {\n") item.text
        ?> group_members rest !- ({ item ?| text = wrapped_record head item } :: members) others (item.name :: wrapped)
        |? sm'.starts_with ("union " ++# item.name ++# " =") item.text
        ?>
            := tail = sm'.substring 6i32 (sm'.length item.text - 6i32) item.text
            group_members rest !- ({ item ?| text = head ++# tail } :: members) others wrapped
        |: group_members rest first members (item :: others) wrapped
    | [] => listm.append (reverse members []) (reverse others []), wrapped

:~ ^ order_emitted
    (pending : list emitted) (known : list string) (done_names : list string) (ordered : list emitted)
    : list emitted * list string
    =
    ?= pending ?|
    | [] => reverse ordered [], []
    | _ =>
        := done_names', ordered', deferred = order_pass pending known done_names ordered []
        ? count_list deferred = count_list pending
        ?>
            := group, wrapped = group_members deferred !+ [] [] []
            listm.append (reverse ordered' []) group, wrapped
        |: order_emitted deferred known done_names' ordered'


:~ ^ item_texts (items : list emitted) (acc : list string) : list string =
    ?= items ?|
    | item :: rest => item_texts rest (item.text ++# "\n" :: acc)
    | [] => reverse acc []

:= texts_of (items : list emitted) : string = sm'.concat_balanced "" (item_texts items [])

:~ ^ root_element \* form. (target : string) (roots : list (xsd particle form)) : option (xsd particle form) =
    ?= roots ?|
    | (Element e) :: rest => ? tag_text e.name = target ?> Some (Element e) |: root_element target rest
    | _ :: rest => root_element target rest
    | [] => None

:~ ^ wildcard_choice \* form. (items : list (xsd particle form)) (seen : bool) : bool =
    ?= items ?|
    | (AnyContent ()) :: rest => wildcard_choice rest !+
    | (Empty ()) :: rest => wildcard_choice rest seen
    | _ :: _ => !-
    | [] => seen

:~ ^ all_optional \* form. (items : list (xsd particle form)) : bool =
    ?= items ?|
    | (Element e) :: rest => e.occurs.min = 0i32 && all_optional rest
    | (AnyContent ()) :: rest => all_optional rest
    | (Empty ()) :: rest => all_optional rest
    | _ :: _ => !-
    | [] => !+

:~ ^ emptiable_heads \* form. (items : list (xsd particle form)) (acc : list string) : list string =
    ?= items ?|
    | (Element e) :: rest => emptiable_heads rest (? e.occurs.min = 0i32 ?> tag_text e.name :: acc |: acc)
    | (Sequence s) :: rest =>
        := emptiable = s.occurs.min = 0i32 || all_optional s.items
        emptiable_heads rest (? emptiable ?> first_element_name s.items :: acc |: acc)
    | _ :: rest => emptiable_heads rest acc
    | [] => reverse acc []

:~ ^ fallback_arm (heads : list string) (text : string) : option string =
    ?= heads ?|
    | head :: rest =>
        ?= line_after ("    elif xml.has_child \"" ++# head ++# "\" children then ") text ?|
        | Some expression => Some expression
        | None => fallback_arm rest text
    | [] => None

:= with_empty_fallback (heads : list string) (text : string) : string =
    ?= line_after "    else failwith \"" text ?|
    | Some failing =>
        ?= fallback_arm heads text ?|
        | Some expression => sm'.replace ("    else failwith \"" ++# failing) ("    else " ++# expression) text
        | None => text
    | None => text

:~ ^ dereferenced \* k form. (roots : list (xsd particle form)) (item : xsd k form) : xsd k form =
    ?= item ?|
    | Complex c => Complex { c ?| content = dereferenced roots c.content }
    | Derived d => Derived { d ?| content = dereferenced roots d.content }
    | Simple _ => item
    | Element e =>
        ?= e.inline ?|
        | Some inner => Element { e ?| inline = Some (dereferenced roots inner) }
        | None =>
            ?= e.type_ref ?|
            | Some _ => item
            | None =>
                ?= root_element (xml.local_name (tag_text e.name)) roots ?|
                | Some (Element root) => Element { root ?| occurs = e.occurs; name = e.name }
                | _ => item
    | Sequence s =>
        := items = dereferenced_all roots s.items []
        ?= items ?|
        | (Choice c) :: [] ?& is_repeated s.occurs && is_repeated c.occurs = !- =>
            Choice { c ?| occurs = { min = s.occurs.min * c.occurs.min; max = s.occurs.max } }
        | _ => Sequence { s ?| items = items }
    | Choice c =>
        := items = dereferenced_all roots c.items []
        ? wildcard_choice items !- ?> AnyContent () |: Choice { c ?| items = items }
    | AnyContent () => item
    | Empty () => item
    | Attribute _ => item

:& :~ dereferenced_all \* k form.
    (roots : list (xsd particle form)) (items : list (xsd k form)) (acc : list (xsd k form))
    : list (xsd k form)
    =
    ?= items ?|
    | item :: rest => dereferenced_all roots rest (dereferenced roots item :: acc)
    | [] => reverse acc []

:= staged_type_names \* form. (staged : list string) (schema : xsd_schema form) : list string =
    := complex_types = dereferenced_all schema.elements schema.complex_types []
    := elements = dereferenced_all schema.elements schema.elements []
    := candidates = inline_all_candidates "" elements (named_candidates complex_types [])
    reverse (grow_staged candidates (directly_staged staged candidates [])) []

:~ ^ first_with_key (key : value_set) (items : list emitted) : option string =
    ?= items ?|
    | item :: rest => ? same_value_set item.value_set key ?> Some item.name |: first_with_key key rest
    | [] => None

:= shared_union_text (name : string) (first : string) : string =
    "type " ++# name ++# " = " ++# first ++# "\n\n"
    ++# "inl " ++# name ++# "_of_string (s : string) : option " ++# name ++# " = " ++# first ++# "_of_string s\n\n"
    ++# "inl " ++# name ++# "_to_string (x : " ++# name ++# ") : string = " ++# first ++# "_to_string x\n\n"
    ++# "inl " ++# name ++# "_example (k : i32) : " ++# name ++# " = " ++# first ++# "_example k\n\n"
    ++# "inl " ++# name ++# "_example_text (k : i32) : string = " ++# first ++# "_example_text k\n"

:~ ^ share_unions (items : list emitted) (kept : list emitted) (acc : list emitted) : list emitted =
    ?= items ?|
    | item :: rest =>
        ?= item.value_set ?|
        | NoValueSet => share_unions rest kept (item :: acc)
        | value_set =>
            ?= first_with_key value_set kept ?|
            | Some first =>
                := shared =
                    {
                        name = item.name
                        references = (first :: [])
                        text = shared_union_text item.name first
                        value_set = NoValueSet
                        role = PlainItem
                    }
                share_unions rest kept (shared :: acc)
            | None => share_unions rest (item :: kept) (item :: acc)
    | [] => reverse acc []

:| type_kind =
    | KindText
    | KindEnum
    | KindValidated
    | KindRecord
    | KindRecursive

:= simple_kind (facets : list xsd_facet) : type_kind =
    ?= enumeration_values facets [] ?|
    | [] => ? is_constrained facets ?> KindValidated |: KindText
    | _ => KindEnum

:~ ^ kinds_of \* form.
    (types : list (xsd type_def form)) (acc : list (string * type_kind))
    : list (string * type_kind)
    =
    ?= types ?|
    | (Simple s) :: rest => kinds_of rest ((type_name (definition_text s.name), simple_kind s.facets) :: acc)
    | (Complex c) :: rest => kinds_of rest ((type_name (definition_text c.name), KindRecord) :: acc)
    | (Derived d) :: rest => kinds_of rest ((type_name (definition_text d.name), KindRecord) :: acc)
    | [] => acc

:~ ^ first_validated (kinds : list (string * type_kind)) : option string =
    ?= kinds ?|
    | (name, KindValidated) :: _ => Some name
    | _ :: rest => first_validated rest
    | [] => None

:= any_validated_type \* form. (schema : xsd_schema form) : option string =
    first_validated (kinds_of schema.simple_types [])

:~ ^ kind_lookup (target : string) (kinds : list (string * type_kind)) : type_kind =
    ?= kinds ?|
    | (name, kind) :: rest => ? name = target ?> kind |: kind_lookup target rest
    | [] => KindText

:~ ^ recursive_kinds
    (kinds : list (string * type_kind)) (wrapped : list string) (acc : list (string * type_kind))
    : list (string * type_kind)
    =
    ?= kinds ?|
    | (name, kind) :: rest =>
        recursive_kinds rest wrapped ((name, ? has_name name wrapped ?> KindRecursive |: kind) :: acc)
    | [] => reverse acc []

:= unwrapped_parameter (ty : string) (head : string) (text : string) : string =
    := rest = sm'.substring (sm'.length head) (sm'.length text - sm'.length head) text
    := head' = sm'.replace ("(x : " ++# ty ++# ")") ("(x' : " ++# ty ++# ")") head
    := unwrap = "\n    inl x = match x' with | Record_" ++# ty ++# " r => r"
    := body = ? sm'.starts_with "\n" rest ?> rest |: "\n    " ++# sm'.substring 1i32 (sm'.length rest - 1i32) rest
    sm'.replace (ty ++# "_get f x)") (ty ++# "_get f x')") (head' ++# unwrap ++# body)

:= recursive_text (ty : string) (text : string) : string =
    := children = "and let " ++# ty ++# "_children (x : " ++# ty ++# ") : list xml.xml_node ="
    := attributes = "and let " ++# ty ++# "_attributes (x : " ++# ty ++# ") : list (string * string) ="
    := getter = "inl " ++# ty ++# "_get forall r. (f : " ++# ty ++# "_field r) (x : " ++# ty ++# ") : r ="
    := builds =
        sm'.starts_with ("and let " ++# ty ++# "_of_children") text
        || sm'.starts_with ("and let " ++# ty ++# "_example ") text
    ? sm'.starts_with children text ?> unwrapped_parameter ty children text
    |? sm'.starts_with attributes text ?> unwrapped_parameter ty attributes text
    |? sm'.starts_with getter text ?> unwrapped_parameter ty getter text
    |? builds ?> sm'.replace "\n    {\n" ("\n    Record_" ++# ty ++# " {\n") text
    |: text

:~ ^ claimed_names \* form. (items : list (xsd particle form)) (acc : list string) : list string =
    ?= items ?|
    | (Element e) :: rest => claimed_names rest (tag_text e.name :: acc)
    | (Sequence s) :: rest => claimed_names (listm.append s.items rest) acc
    | (Choice c) :: rest => claimed_names (listm.append c.items rest) acc
    | _ :: rest => claimed_names rest acc
    | [] => reverse acc []

:= with_any_claims \* form. (content : xsd particle form) (texts : list string) : list string =
    := quoted = listm.map (\ n => "\"" ++# n ++# "\"") (claimed_names (content :: []) [])
    := claim = "        any = any_content_of (xml.unclaimed_children [" ++# join_with "; " quoted "" ++# "] children)\n"
    listm.map (sm'.replace "        any = []\n" claim) texts

:= recursive_texts (kinds : list (string * type_kind)) (ty : string) (texts : list string) : list string =
    ?= kind_lookup ty kinds ?|
    | KindRecursive => listm.map (recursive_text ty) texts
    | _ => texts

:= reference_kind (reference : string) (kinds : list (string * type_kind)) : type_kind =
    ? is_builtin_reference reference ?> KindText |: kind_lookup (type_name (xml.local_name reference)) kinds

:= reference_kind_of \* form.
    (reference : option (type_reference form)) (kinds : list (string * type_kind))
    : type_kind
    =
    ?= reference ?|
    | Some r => reference_kind (reference_text r) kinds
    | None => KindText

:= inline_kind \* form. (inner : xsd type_def form) : type_kind =
    ?= inner ?|
    | Simple s => simple_kind s.facets
    | _ => KindRecord

:= node_expression (kind : type_kind) (t : string) : string =
    ?= kind ?|
    | KindText => "xml.text_in (xml.element_children c)"
    | KindEnum | KindValidated =>
        "xml.required_value \"" ++# t ++# "\" (" ++# t ++# "_of_string (xml.text_in (xml.element_children c)))"
    | KindRecord | KindRecursive => t ++# "_of_xml c"

:= occurs_expression (name : string) (o : occurs) (body : string) : string =
    := lambda = "(fun c => " ++# body ++# ")"
    ?= shape_of o ?|
    | Optional => "optionm.map " ++# lambda ++# " (xml.first_child \"" ++# name ++# "\" children)"
    | Required => lambda ++# " (xml.required_child \"" ++# name ++# "\" children)"
    | Repeated => "listm.map " ++# lambda ++# " (xml.children_named \"" ++# name ++# "\" children)"

:= quoted_name (acc : string) (name : string) : string =
    ? acc = "" ?> "\"" ++# name ++# "\"" |: acc ++# "; \"" ++# name ++# "\""

:~ ^ single_element_arms \* form. (items : list (xsd particle form)) : bool =
    ?= items ?|
    | (Element _) :: rest => single_element_arms rest
    | (AnyContent ()) :: rest => single_element_arms rest
    | _ :: _ => !-
    | [] => !+

:~ ^ choice_names \* form. (items : list (xsd particle form)) (acc : string) : string =
    ?= items ?|
    | (Element e) :: rest => choice_names rest (quoted_name acc (tag_text e.name))
    | (Sequence s) :: rest => choice_names rest (quoted_name acc (first_element_name s.items))
    | _ :: rest => choice_names rest acc
    | [] => acc

:= base_field \* form. (kinds : list (string * type_kind)) (base : type_reference form) : string =
    := t = reference_type base
    ?= reference_kind (reference_text base) kinds ?|
    | KindRecord | KindRecursive => "        base = " ++# t ++# "_of_children attributes children"
    | KindEnum | KindValidated =>
        "        base = xml.required_value \"" ++# t ++# "\" (" ++# t ++# "_of_string (xml.text_in children))"
    | KindText => "        base = xml.text_in children"

:= attribute_type \* form.
    (kinds : list (string * type_kind)) (owner : string) (name : string) (type_reference : option (type_reference form))
    (inline : option (xsd type_def form))
    : string * type_kind
    =
    ?= inline ?|
    | Some inner => type_name (owner ++# "_" ++# name), inline_kind inner
    | None => reference_type_of type_reference, reference_kind_of type_reference kinds

:= value_node (kind : type_kind) (t : string) (name : string) (v : string) : string =
    ?= kind ?|
    | KindText => "xml.element \"" ++# name ++# "\" [] (xml.text_children " ++# v ++# ")"
    | KindEnum | KindValidated => "text_node \"" ++# name ++# "\" " ++# v
    | KindRecord | KindRecursive => t ++# "_to_xml \"" ++# name ++# "\" " ++# v

:= occurs_part (name : string) (o : occurs) (kind : type_kind) (t : string) (source : string) : string =
    := coded = ?= kind ?| KindEnum | KindValidated => !+ | _ => !-
    ?= shape_of o ?|
    | Optional ?& coded => "optional_text_nodes \"" ++# name ++# "\" " ++# source
    | Repeated ?& coded => "repeated_text_nodes \"" ++# name ++# "\" " ++# source
    | Optional => "xml.option_list (optionm.map (fun v => " ++# value_node kind t name "v" ++# ") " ++# source ++# ")"
    | Required => "[" ++# value_node kind t name source ++# "]"
    | Repeated => "listm.map (fun v => " ++# value_node kind t name "v" ++# ") " ++# source

:= concat_parts (parts : list string) : string =
    ?= parts ?|
    | [] => "[]"
    | only :: [] => only
    | _ => "listm.concat [" ++# join_with "; " parts "" ++# "]"

:= attribute_value_text (kind : type_kind) (t : string) (v : string) : string =
    ?= kind ?|
    | KindEnum | KindValidated => "to_text " ++# v
    | _ => v

:= base_children \* form. (kinds : list (string * type_kind)) (base : type_reference form) : list string =
    := t = reference_type base
    ?= reference_kind (reference_text base) kinds ?|
    | KindRecord | KindRecursive => t ++# "_children x.base" :: []
    | KindEnum | KindValidated => "xml.text_children (to_text x.base)" :: []
    | KindText => "xml.text_children x.base" :: []

:= base_attributes \* form. (kinds : list (string * type_kind)) (base : type_reference form) : list string =
    ?= reference_kind (reference_text base) kinds ?|
    | KindRecord | KindRecursive => reference_type base ++# "_attributes x.base" :: []
    | _ => []

:= value_example (kind : type_kind) (t : string) (reference : string) (variant : string) : string =
    ?= kind ?|
    | KindText =>
        ? is_builtin_reference reference ?> "\"" ++# escape_text (builtin_example reference) ++# "\""
        |: t ++# "_example " ++# variant
    | _ => t ++# "_example " ++# variant

:~ ^ repeated_items (value : string -> string) (index : i32) (count : i32) (acc : list string) : list string =
    ? index >= count ?> reverse acc []
    |: repeated_items value (index + 1i32) count (value ("(k + " ++# int_text index ++# "i32)") :: acc)

:= repeated_list (value : string -> string) (count : i32) : string =
    ? count <= 0i32 ?> "[]" |: "[" ++# join_with "; " (repeated_items value 0i32 count []) "" ++# "]"

:= fixed_example (kind : type_kind) (t : string) (fixed : string) : string =
    ?= kind ?|
    | KindEnum | KindValidated =>
        "xml.required_value \"" ++# t ++# "\" (" ++# t ++# "_of_string \"" ++# escape_text fixed ++# "\")"
    | _ => "\"" ++# escape_text fixed ++# "\""

:= occurs_example (o : occurs) (value : string -> string) : string =
    ?= shape_of o ?|
    | Optional => "None"
    | Required => value "k"
    | Repeated => repeated_list value o.min

:= value_example_of \* form.
    (kinds : list (string * type_kind)) (reference : option (type_reference form)) (variant : string)
    : string
    =
    ?= reference ?|
    | Some r => value_example (reference_kind (reference_text r) kinds) (reference_type r) (reference_text r) variant
    | None => value_example KindText "string" "" variant

:| reading = | Reading
:| writing = | Writing
:| exampling = | Exampling

:== witness = { case : string; t : string; field : string; fragment : string }

:== part = { text : string; witness : option witness }

:= plain (text : string) : part = { text = text; witness = None }

:= part_text (p : part) : string = p.text

:| walk_text =
    | FunctionText : string
    | ItemText : string

:~ ^ function_parts (texts : list walk_text) (acc : list string) : list string =
    ?= texts ?|
    | FunctionText t :: rest => function_parts rest (t :: acc)
    | ItemText _ :: rest => function_parts rest acc
    | [] => reverse acc []

:~ ^ all_witnessed (parts : list part) (acc : list witness) : option (list witness) =
    ?= parts ?|
    | p :: rest =>
        ?= p.witness ?|
        | Some w => all_witnessed rest (w :: acc)
        | None => None
    | [] => ? listm.length acc = 0i32 ?> None |: Some (reverse acc [])

:= witness_union (ty : string) (witnesses : list witness) : string =
    := case_line (w : witness) = "    | " ++# w.case ++# " :: " ++# ty ++# "_field (" ++# w.t ++# ")"
    join_lines ("union " ++# ty ++# "_field r =" :: listm.map case_line witnesses) ""

:= witness_get (ty : string) (witnesses : list witness) : string =
    := arm (w : witness) = "    | " ++# w.case ++# " => x." ++# w.field
    := head = "inl " ++# ty ++# "_get forall r. (f : " ++# ty ++# "_field r) (x : " ++# ty ++# ") : r ="
    join_lines (head :: "    match f with" :: listm.map arm witnesses) ""

:= witness_children (ty : string) (witnesses : list witness) : string =
    := arm (w : witness) = "        | " ++# w.case ++# " => " ++# w.fragment
    := packed (w : witness) = "exists " ++# w.case
    := lines =
        ("and let " ++# ty ++# "_children (x : " ++# ty ++# ") : list xml.xml_node =")
        :: ("    inl nodes forall r. (f : " ++# ty ++# "_field r) (v : r) : list xml.xml_node =")
        :: "        match f with"
        :: listm.append (listm.map arm witnesses) (
            ("    inl rec walk (fields : list (exists r. " ++# ty ++# "_field r)) : list xml.xml_node =")
            :: "        match fields with"
            :: "        | packed :: rest =>"
            :: "            inl exists r. f = packed"
            :: ("            listm.append (nodes f (" ++# ty ++# "_get f x)) (walk rest)")
            :: "        | [] => []"
            :: ("    walk [" ++# join_with "; " (listm.map packed witnesses) "" ++# "]")
            :: []
        )
    join_lines lines ""

:== walked = { parts : list part; attribute_parts : list string; functions : list walk_text }

:== element_view form =
    {
        name : string
        occurs : occurs
        kind : type_kind
        t : string
        inline : bool
        type_ref : option (type_reference form)
    }

:== attribute_view form =
    {
        name : string
        required : bool
        fixed : option string
        inline : bool
        type_ref : option (type_reference form)
        kind : type_kind
        t : string
    }

:= nothing_walked () : walked = { parts = []; attribute_parts = []; functions = [] }

:= push_part (p : part) (functions : list walk_text) (acc : walked) : walked =
    { parts = p :: acc.parts; attribute_parts = acc.attribute_parts; functions = listm.append functions acc.functions }

:= push (part : string) (functions : list walk_text) (acc : walked) : walked =
    {
        parts = plain part :: acc.parts
        attribute_parts = acc.attribute_parts
        functions = listm.append functions acc.functions
    }

:= record_body (lines : list string) : string =
    ?= lines ?|
    | [] => "    ()\n"
    | _ => "    {\n" ++# join_lines lines "" ++# "    }\n"

:? derived_prefix f : \* form. f -> list (string * type_kind) -> type_reference form -> walked
:? record_texts f : f -> string -> list part -> list string -> list string
:? choice_part f : \* form. f -> occurs -> list (xsd particle form) -> string -> string -> string
:? element_part f : \* form. f -> list (string * type_kind) -> element_view form -> string
:? any_part f : f -> string
:? attribute_step f : \* form. f -> walked -> attribute_view form -> walked
:? element_arm f : \* form. f -> list (string * type_kind) -> string -> element_view form -> string
:? group_arm f : f -> string -> string -> string -> string
:? choice_text f : f -> string -> list string -> string
:? first_arm_only f : f -> bool
:? witness_items f : f -> string -> list part -> list string
:? element_witness f : \* form. f -> string -> element_view form -> option witness
:? choice_witness f : f -> string -> occurs -> string -> string -> option witness
:? any_witness f : f -> string -> option witness

:= reader_attribute_value
    (name : string) (required : bool) (fixed : option string) (kind : type_kind) (t : string)
    : string
    =
    := attributes =
        ?= fixed ?|
        | Some value => "(xml.checked_fixed \"" ++# name ++# "\" \"" ++# escape_text value ++# "\" attributes)"
        | None => "attributes"
    ?= kind ?|
    | KindEnum | KindValidated =>
        ? required
        ?>
            "xml.required_value \""
            ++# t
            ++# "\" ("
            ++# t
            ++# "_of_string (xml.required_attribute \""
            ++# name
            ++# "\" "
            ++# attributes
            ++# "))"
        |:
            "optionm.map (fun v => xml.required_value \""
            ++# t
            ++# "\" ("
            ++# t
            ++# "_of_string v)) (xml.attribute_of \""
            ++# name
            ++# "\" "
            ++# attributes
            ++# ")"
    | _ =>
        ? required ?> "xml.required_attribute \"" ++# name ++# "\" " ++# attributes
        |: "xml.attribute_of \"" ++# name ++# "\" " ++# attributes

:+ derived_prefix reading =
    \ _ kinds base => { parts = plain (base_field kinds base) :: []; attribute_parts = []; functions = [] }
:+ record_texts reading = \ _ ty parts _ =>
    := lines = listm.map part_text parts
    := of_children =
        fitted_header
            ("and let " ++# ty ++# "_of_children")
            "(attributes : list (string * string)) (children : list xml.xml_node)"
            ty
        ++# record_body lines
    := of_xml =
        fitted_definition
            ("and let " ++# ty ++# "_of_xml (c : xml.xml_node) : " ++# ty ++# " =")
            (ty ++# "_of_children (xml.element_attributes c) (xml.element_children c)")
    of_children :: of_xml :: []
:+ choice_part reading =
    \ _ o items ty field =>
        := read = ty ++# "_of_children attributes children"
        := expression =
            ?= shape_of o ?|
            | Optional =>
                "if xml.has_any_child ["
                ++# choice_names items ""
                ++# "] children then Some ("
                ++# read
                ++# ") else None"
            | Required => read
            | Repeated =>
                ? single_element_arms items
                ?>
                    "listm.map (fun c => "
                    ++# ty
                    ++# "_of_children attributes [c]) (xml.claimed_children ["
                    ++# choice_names items ""
                    ++# "] children)"
                |: "[" ++# read ++# "]"
        field_assignment field expression
:+ element_part reading = \ _ _ v =>
    field_assignment (field_name v.name) (occurs_expression v.name v.occurs (node_expression v.kind v.t))
:+ any_part reading = \ _ => "        any = []"
:+ attribute_step reading = \ _ acc a =>
    push (field_assignment (field_name a.name) (reader_attribute_value a.name a.required a.fixed a.kind a.t)) [] acc
:+ element_arm reading = \ _ _ choice_name v =>
    "    elif xml.has_child \""
    ++# v.name
    ++# "\" children then "
    ++# case_name choice_name v.name
    ++# " ("
    ++# occurs_expression v.name v.occurs (node_expression v.kind v.t)
    ++# ")"
:+ group_arm reading = \ _ choice_name first group_name =>
    "    elif xml.has_child \""
    ++# first
    ++# "\" children then "
    ++# case_name choice_name ("group_" ++# first)
    ++# " ("
    ++# type_name group_name
    ++# "_of_children attributes children)"
:+ choice_text reading = \ _ choice_name arms =>
    := ty = type_name choice_name
    "and let "
    ++# ty
    ++# "_of_children (attributes : list (string * string)) (children : list xml.xml_node) : "
    ++# ty
    ++# " =\n    if false then failwith \"unreachable\"\n"
    ++# join_lines arms ""
    ++# "    else failwith \""
    ++# ty
    ++# ": no alternative present\"\n"
:+ first_arm_only reading = \ _ => !-
:+ witness_items reading = \ _ _ _ => []
:+ element_witness reading = \ _ _ _ => None
:+ choice_witness reading = \ _ _ _ _ _ => None
:+ any_witness reading = \ _ _ => None

:| staged_reading = | StagedReading : list string * list string

:= is_required_once (o : occurs) : bool = ?= shape_of o ?| Required => !+ | _ => !-

:+ derived_prefix staged_reading = \ _ kinds base => derived_prefix Reading kinds base
:+ record_texts staged_reading = \ f ty parts attribute_parts =>
    ?= f ?|
    | StagedReading (staged, _) =>
        ? has_name ty staged = !- ?> record_texts Reading ty parts attribute_parts
        |:
            := of_children =
                fitted_header
                    ("and let " ++# ty ++# "_of_children forall s.")
                    "(witness : stage s) (attributes : list (string * string)) (children : list xml.xml_node)"
                    (ty ++# " s")
                ++# record_body (listm.map part_text parts)
            := head = "and let " ++# ty ++# "_of_xml forall s. (witness : stage s) (c : xml.xml_node) : " ++# ty ++# " s ="
            := of_xml =
                fitted_definition head (ty ++# "_of_children witness (xml.element_attributes c) (xml.element_children c)")
            of_children :: of_xml :: []
:+ choice_part staged_reading = \ _ o items ty field => choice_part Reading o items ty field
:+ element_part staged_reading = \ f kinds v =>
    ?= f ?|
    | StagedReading (staged, signatures) =>
        := field = field_name v.name
        ? has_name (xml.local_name v.name) signatures && is_required_once v.occurs
        ?>
            := read = occurs_expression v.name v.occurs (node_expression v.kind v.t)
            field_assignment field ("staged_of witness (fun () => " ++# read ++# ")")
        |? has_name v.t staged ?> field_assignment field (occurs_expression v.name v.occurs (v.t ++# "_of_xml witness c"))
        |: element_part Reading kinds v
:+ any_part staged_reading = \ _ => any_part Reading
:+ attribute_step staged_reading = \ _ acc a => attribute_step Reading acc a
:+ element_arm staged_reading = \ _ kinds choice_name v => element_arm Reading kinds choice_name v
:+ group_arm staged_reading = \ _ choice_name first group_name => group_arm Reading choice_name first group_name
:+ choice_text staged_reading = \ _ choice_name arms => choice_text Reading choice_name arms
:+ first_arm_only staged_reading = \ _ => first_arm_only Reading
:+ witness_items staged_reading = \ _ ty parts => witness_items Reading ty parts
:+ element_witness staged_reading = \ _ owner v => element_witness Reading owner v
:+ choice_witness staged_reading = \ _ owner o field choice => choice_witness Reading owner o field choice
:+ any_witness staged_reading = \ _ owner => any_witness Reading owner

:+ derived_prefix writing = \ _ kinds base =>
    := parts = listm.map plain (base_children kinds base)
    { parts = parts; attribute_parts = base_attributes kinds base; functions = [] }
:+ record_texts writing = \ _ ty parts attribute_parts =>
    := children_function =
        ?= all_witnessed parts [] ?|
        | Some witnesses => witness_children ty witnesses
        | None =>
            fitted_definition
                ("and let " ++# ty ++# "_children (x : " ++# ty ++# ") : list xml.xml_node =")
                (concat_parts (listm.map part_text parts))
    := attributes_function =
        fitted_definition
            ("and let " ++# ty ++# "_attributes (x : " ++# ty ++# ") : list (string * string) =")
            (concat_parts attribute_parts)
    := to_xml =
        fitted_definition
            ("and let " ++# ty ++# "_to_xml (name : string) (x : " ++# ty ++# ") : xml.xml_node =")
            ("xml.element name (" ++# ty ++# "_attributes x) (" ++# ty ++# "_children x)")
    children_function :: attributes_function :: to_xml :: []
:+ choice_part writing = \ _ o _ ty field =>
    := source = "x." ++# field
    ?= shape_of o ?|
    | Optional => "xml.option_concat (optionm.map " ++# ty ++# "_children " ++# source ++# ")"
    | Required => ty ++# "_children " ++# source
    | Repeated => "listm.concat (listm.map " ++# ty ++# "_children " ++# source ++# ")"
:+ element_part writing = \ _ _ v => occurs_part v.name v.occurs v.kind v.t ("x." ++# field_name v.name)
:+ any_part writing = \ _ => "any_content_to x.any"
:+ attribute_step writing = \ _ acc a =>
    := source = "x." ++# field_name a.name
    := part =
        ? a.required ?> "[(\"" ++# a.name ++# "\", " ++# attribute_value_text a.kind a.t source ++# ")]"
        |:
            "xml.option_list (optionm.map (fun v => (\""
            ++# a.name
            ++# "\", "
            ++# attribute_value_text a.kind a.t "v"
            ++# ")) "
            ++# source
            ++# ")"
    { parts = acc.parts; attribute_parts = part :: acc.attribute_parts; functions = acc.functions }
:+ element_arm writing = \ _ _ choice_name v =>
    "    | " ++# case_name choice_name v.name ++# " v => " ++# occurs_part v.name v.occurs v.kind v.t "v"
:+ group_arm writing = \ _ choice_name first group_name =>
    "    | " ++# case_name choice_name ("group_" ++# first) ++# " v => " ++# type_name group_name ++# "_children v"
:+ choice_text writing =
    \ _ choice_name arms =>
        := ty = type_name choice_name
        "and let "
        ++# ty
        ++# "_children (x : "
        ++# ty
        ++# ") : list xml.xml_node =\n    match x with\n"
        ++# join_lines arms ""
:+ first_arm_only writing = \ _ => !-
:+ witness_items writing = \ _ ty parts =>
    ?= all_witnessed parts [] ?|
    | Some witnesses => witness_union ty witnesses :: witness_get ty witnesses :: []
    | None => []
:+ element_witness writing = \ _ owner v =>
    := fragment = occurs_part v.name v.occurs v.kind v.t "v"
    := case = case_name (owner ++# "_field") v.name
    Some { case = case; t = with_occurs v.occurs v.t; field = field_name v.name; fragment = fragment }
:+ choice_witness writing = \ _ owner o ty field =>
    := fragment =
        ?= shape_of o ?|
        | Optional => "xml.option_concat (optionm.map " ++# ty ++# "_children v)"
        | Required => ty ++# "_children v"
        | Repeated => "listm.concat (listm.map " ++# ty ++# "_children v)"
    Some { case = case_name (owner ++# "_field") field; t = with_occurs o ty; field = field; fragment = fragment }
:+ any_witness writing = \ _ owner =>
    Some {
        case = case_name (owner ++# "_field") "any"
        t = "any_content"
        field = "any"
        fragment = "any_content_to v"
    }

:| staged_writing = | StagedWriting : list string * list string

:= is_staged_owner (owner : string) (staged : list string) : bool =
    has_name owner staged || has_name (type_name owner) staged

:+ derived_prefix staged_writing = \ _ kinds base => derived_prefix Writing kinds base
:+ record_texts staged_writing = \ f ty parts attribute_parts =>
    ?= f ?|
    | StagedWriting (staged, _) =>
        ? has_name ty staged = !- ?> record_texts Writing ty parts attribute_parts
        |:
            := any_stage = "(x : " ++# ty ++# " s)"
            := children_function =
                fitted_definition
                    ("and let " ++# ty ++# "_children forall s. " ++# any_stage ++# " : list xml.xml_node =")
                    (concat_parts (listm.map part_text parts))
            := attributes_function =
                fitted_definition
                    ("and let " ++# ty ++# "_attributes forall s. " ++# any_stage ++# " : list (string * string) =")
                    (concat_parts attribute_parts)
            := to_xml =
                fitted_definition
                    ("and let " ++# ty ++# "_to_xml forall s. (name : string) " ++# any_stage ++# " : xml.xml_node =")
                    ("xml.element name (" ++# ty ++# "_attributes x) (" ++# ty ++# "_children x)")
            children_function :: attributes_function :: to_xml :: []
:+ choice_part staged_writing = \ _ o items ty field => choice_part Writing o items ty field
:+ element_part staged_writing = \ f kinds v =>
    ?= f ?|
    | StagedWriting (_, signatures) =>
        ? has_name (xml.local_name v.name) signatures && is_required_once v.occurs
        ?> "staged_list (fun v => " ++# value_node v.kind v.t v.name "v" ++# ") x." ++# field_name v.name
        |: element_part Writing kinds v
:+ any_part staged_writing = \ _ => any_part Writing
:+ attribute_step staged_writing = \ _ acc a => attribute_step Writing acc a
:+ element_arm staged_writing = \ _ kinds choice_name v => element_arm Writing kinds choice_name v
:+ group_arm staged_writing = \ _ choice_name first group_name => group_arm Writing choice_name first group_name
:+ choice_text staged_writing = \ _ choice_name arms => choice_text Writing choice_name arms
:+ first_arm_only staged_writing = \ _ => first_arm_only Writing
:+ witness_items staged_writing = \ f ty parts =>
    ?= f ?| StagedWriting (staged, _) => ? is_staged_owner ty staged ?> [] |: witness_items Writing ty parts
:+ element_witness staged_writing = \ f owner v =>
    ?= f ?| StagedWriting (staged, _) => ? is_staged_owner owner staged ?> None |: element_witness Writing owner v
:+ choice_witness staged_writing = \ f owner o ty field =>
    ?= f ?|
    | StagedWriting (staged, _) => ? is_staged_owner owner staged ?> None |: choice_witness Writing owner o ty field
:+ any_witness staged_writing = \ f owner =>
    ?= f ?| StagedWriting (staged, _) => ? is_staged_owner owner staged ?> None |: any_witness Writing owner

:= element_example \* form. (kinds : list (string * type_kind)) (v : element_view form) : string -> string =
    ? v.inline ?> (\ variant => v.t ++# "_example " ++# variant) |: value_example_of kinds v.type_ref

:+ derived_prefix exampling = \ _ kinds base =>
    := kind = reference_kind (reference_text base) kinds
    := line = "        base = " ++# value_example kind (reference_type base) (reference_text base) "k"
    { parts = plain line :: []; attribute_parts = []; functions = [] }
:+ record_texts exampling = \ _ ty parts _ =>
    := lines = listm.map part_text parts
    "and let " ++# ty ++# "_example (k : i32) : " ++# ty ++# " =\n" ++# record_body lines :: []
:+ choice_part exampling = \ _ o _ ty field =>
    field_assignment field (occurs_example o (\ variant => ty ++# "_example " ++# variant))
:+ element_part exampling = \ _ kinds v =>
    field_assignment (field_name v.name) (occurs_example v.occurs (element_example kinds v))
:+ any_part exampling = \ _ =>
    "        any = any_content_of [xml.element \"modal\" [(\"xmlns\", \"urn:example:any\")] []]"
:+ attribute_step exampling = \ _ acc a =>
    := value =
        ? a.required = !- ?> "None"
        |:
            ?= a.fixed ?|
            | Some f => fixed_example a.kind a.t f
            | None =>
                ? a.inline ?> a.t ++# "_example k"
                |:
                    ?= a.type_ref ?|
                    | Some r => value_example a.kind a.t (reference_text r) "k"
                    | None => value_example a.kind a.t "" "k"
    push (field_assignment (field_name a.name) value) [] acc
:+ element_arm exampling = \ _ kinds choice_name v =>
    case_name choice_name v.name ++# " (" ++# occurs_example v.occurs (element_example kinds v) ++# ")"
:+ group_arm exampling = \ _ choice_name first group_name =>
    case_name choice_name ("group_" ++# first) ++# " (" ++# type_name group_name ++# "_example k)"
:+ choice_text exampling = \ _ choice_name arms =>
    := ty = type_name choice_name
    := header = "and let " ++# ty ++# "_example (k : i32) : " ++# ty ++# " = "
    ?= arms ?|
    | arm :: _ => header ++# arm ++# "\n"
    | [] => header ++# "failwith \"" ++# ty ++# ": no first alternative\"\n"
:+ first_arm_only exampling = \ _ => !+
:+ witness_items exampling = \ _ _ _ => []
:+ element_witness exampling = \ _ _ _ => None
:+ choice_witness exampling = \ _ _ _ _ _ => None
:+ any_witness exampling = \ _ _ => None

:| staged_exampling = | StagedExampling : list string * list string

:+ derived_prefix staged_exampling = \ _ kinds base => derived_prefix Exampling kinds base
:+ record_texts staged_exampling = \ f ty parts attribute_parts =>
    ?= f ?|
    | StagedExampling (staged, _) =>
        ? has_name ty staged = !- ?> record_texts Exampling ty parts attribute_parts
        |:
            := head = "and let " ++# ty ++# "_example (k : i32) : " ++# ty ++# " unsigned =\n"
            head ++# record_body (listm.map part_text parts) :: []
:+ choice_part staged_exampling = \ _ o items ty field => choice_part Exampling o items ty field
:+ element_part staged_exampling = \ f kinds v =>
    ?= f ?|
    | StagedExampling (_, signatures) =>
        ? has_name (xml.local_name v.name) signatures && is_required_once v.occurs
        ?> field_assignment (field_name v.name) "Pending \"an unsigned example\""
        |: element_part Exampling kinds v
:+ any_part staged_exampling = \ _ => any_part Exampling
:+ attribute_step staged_exampling = \ _ acc a => attribute_step Exampling acc a
:+ element_arm staged_exampling = \ _ kinds choice_name v => element_arm Exampling kinds choice_name v
:+ group_arm staged_exampling = \ _ choice_name first group_name => group_arm Exampling choice_name first group_name
:+ choice_text staged_exampling = \ _ choice_name arms => choice_text Exampling choice_name arms
:+ first_arm_only staged_exampling = \ _ => first_arm_only Exampling
:+ witness_items staged_exampling = \ _ ty parts => witness_items Exampling ty parts
:+ element_witness staged_exampling = \ _ owner v => element_witness Exampling owner v
:+ choice_witness staged_exampling = \ _ owner o ty field => choice_witness Exampling owner o ty field
:+ any_witness staged_exampling = \ _ owner => any_witness Exampling owner

:= element_view_of \* form.
    (kinds : list (string * type_kind)) (owner : string) (name : string) (o : occurs)
    (type_ref : option (type_reference form))
    (inline : option (xsd type_def form))
    : element_view form
    =
    ?= inline ?|
    | Some inner =>
        {
            name = name
            occurs = o
            kind = inline_kind inner
            t = type_name (owner ++# "_" ++# name)
            inline = !+
            type_ref = type_ref
        }
    | None =>
        {
            name = name
            occurs = o
            kind = reference_kind_of type_ref kinds
            t = reference_type_of type_ref
            inline = !-
            type_ref = type_ref
        }

:~ ^ named_type_walk
    \* form f {
        derived_prefix;
        record_texts;
        choice_part;
        element_part;
        any_part;
        attribute_step;
        element_arm;
        group_arm;
        choice_text;
        first_arm_only;
        witness_items;
        element_witness;
        choice_witness;
        any_witness
    }.
    (family : f) (kinds : list (string * type_kind)) (name : string) (item : xsd type_def form) : list walk_text =
    ?= item ?|
    | Complex c => record_walk family kinds name c.content c.attributes (nothing_walked ())
    | Derived d => record_walk family kinds name d.content d.attributes (derived_prefix family kinds d.base)
    | Simple _ => []

:& :~ record_walk
    \* form f {
        derived_prefix;
        record_texts;
        choice_part;
        element_part;
        any_part;
        attribute_step;
        element_arm;
        group_arm;
        choice_text;
        first_arm_only;
        witness_items;
        element_witness;
        choice_witness;
        any_witness
    }.
    (family : f) (kinds : list (string * type_kind)) (name : string) (content : xsd particle form)
    (attributes : list (xsd attribute_decl form)) (prefix : walked)
    : list walk_text
    =
    := (gathered : walked) =
        attributes_walk family kinds name attributes (content_walk family kinds name content (nothing_walked ()))
    := parts = listm.append prefix.parts (reverse gathered.parts [])
    := attribute_parts = listm.append prefix.attribute_parts (reverse gathered.attribute_parts [])
    := texts =
        recursive_texts kinds (type_name name) (record_texts family (type_name name) parts attribute_parts)
        |> with_any_claims content
    := items = recursive_texts kinds (type_name name) (witness_items family (type_name name) parts)
    listm.append (listm.map ItemText items) (listm.append (listm.map FunctionText texts) gathered.functions)

:& :~ content_walk
    \* form f {
        derived_prefix;
        record_texts;
        choice_part;
        element_part;
        any_part;
        attribute_step;
        element_arm;
        group_arm;
        choice_text;
        first_arm_only;
        witness_items;
        element_witness;
        choice_witness;
        any_witness
    }.
    (family : f) (kinds : list (string * type_kind)) (owner : string) (item : xsd particle form) (acc : walked)
    : walked
    =
    ?= item ?|
    | Sequence s => items_walk family kinds owner s.items acc
    | Choice c =>
        := first = first_element_name c.items
        := choice_name = owner ++# "_choice_" ++# first
        := choice_field = choice_field_of first
        := part = choice_part family c.occurs c.items (type_name choice_name) choice_field
        := witness = choice_witness family owner c.occurs (type_name choice_name) choice_field
        push_part { text = part; witness = witness } (choice_walk family kinds choice_name c.items) acc
    | Element e =>
        := name = tag_text e.name
        := v = element_view_of kinds owner name e.occurs e.type_ref e.inline
        := p = { text = element_part family kinds v; witness = element_witness family owner v }
        push_part p (inline_walk family kinds owner name e.inline) acc
    | AnyContent () => push_part { text = any_part family; witness = any_witness family owner } [] acc
    | Empty () => acc

:& :~ inline_walk
    \* form f
    { derived_prefix; record_texts; choice_part; element_part; any_part; attribute_step; element_arm; group_arm; choice_text; first_arm_only; witness_items; element_witness; choice_witness; any_witness }.
    (family : f) (kinds : list (string * type_kind)) (owner : string) (name : string)
    (inline : option (xsd type_def form))
    : list walk_text
    =
    ?= inline ?|
    | Some inner => named_type_walk family kinds (owner ++# "_" ++# name) inner
    | None => []

:& :~ items_walk
    \* form f {
        derived_prefix;
        record_texts;
        choice_part;
        element_part;
        any_part;
        attribute_step;
        element_arm;
        group_arm;
        choice_text;
        first_arm_only;
        witness_items;
        element_witness;
        choice_witness;
        any_witness
    }.
    (family : f) (kinds : list (string * type_kind)) (owner : string) (items : list (xsd particle form)) (acc : walked)
    : walked
    =
    ?= items ?|
    | item :: rest => items_walk family kinds owner rest (content_walk family kinds owner item acc)
    | [] => acc

:& :~ choice_walk
    \* form f {
        derived_prefix;
        record_texts;
        choice_part;
        element_part;
        any_part;
        attribute_step;
        element_arm;
        group_arm;
        choice_text;
        first_arm_only;
        witness_items;
        element_witness;
        choice_witness;
        any_witness
    }.
    (family : f) (kinds : list (string * type_kind)) (choice_name : string) (items : list (xsd particle form))
    : list walk_text
    =
    := (arms : walked) = arms_walk family kinds choice_name items (nothing_walked ())
    := text = choice_text family choice_name (listm.map part_text (reverse arms.parts []))
    FunctionText (with_empty_fallback (emptiable_heads items []) text) :: arms.functions

:& :~ arms_walk
    \* form f
    { derived_prefix; record_texts; choice_part; element_part; any_part; attribute_step; element_arm; group_arm; choice_text; first_arm_only; witness_items; element_witness; choice_witness; any_witness }.
    (family : f) (kinds : list (string * type_kind)) (choice_name : string) (items : list (xsd particle form))
    (acc : walked)
    : walked
    =
    ?= items ?|
    | (Element e) :: rest =>
        := name = tag_text e.name
        := v = element_view_of kinds choice_name name e.occurs e.type_ref e.inline
        := next =
            push (element_arm family kinds choice_name v) (inline_walk family kinds choice_name name e.inline) acc
        ? first_arm_only family ?> next |: arms_walk family kinds choice_name rest next
    | (Sequence s) :: rest =>
        := first = first_element_name s.items
        := group_name = choice_name ++# "_group_" ++# first
        := group = record_walk family kinds group_name (Sequence s) [] (nothing_walked ())
        := next = push (group_arm family choice_name first group_name) group acc
        ? first_arm_only family ?> next |: arms_walk family kinds choice_name rest next
    | _ :: rest => ? first_arm_only family ?> acc |: arms_walk family kinds choice_name rest acc
    | [] => acc

:& :~ attributes_walk
    \* form f {
        derived_prefix;
        record_texts;
        choice_part;
        element_part;
        any_part;
        attribute_step;
        element_arm;
        group_arm;
        choice_text;
        first_arm_only;
        witness_items;
        element_witness;
        choice_witness;
        any_witness
    }.
    (family : f) (kinds : list (string * type_kind)) (owner : string) (attributes : list (xsd attribute_decl form))
    (acc : walked)
    : walked
    =
    ?= attributes ?|
    | (Attribute a) :: rest =>
        := t, kind = attribute_type kinds owner (tag_text a.name) a.type_ref a.inline
        := inline = ?= a.inline ?| Some _ => !+ | None => !-
        := view =
            {
                name = tag_text a.name
                required = a.required
                fixed = a.fixed
                inline = inline
                type_ref = a.type_ref
                kind = kind
                t = t
            }
        attributes_walk family kinds owner rest (attribute_step family acc view)
    | [] => acc

:~ ^ types_walk
    \* form f {
        derived_prefix;
        record_texts;
        choice_part;
        element_part;
        any_part;
        attribute_step;
        element_arm;
        group_arm;
        choice_text;
        first_arm_only;
        witness_items;
        element_witness;
        choice_witness;
        any_witness
    }.
    (family : f) (kinds : list (string * type_kind)) (types : list (xsd type_def form)) (acc : list walk_text)
    : list walk_text
    =
    ?= types ?|
    | item :: rest =>
        types_walk family kinds rest (
            listm.append (named_type_walk family kinds (xsd_resolve.type_name_of item) item) acc
        )
    | [] => acc

:~ ^ roots_walk
    \* form f {
        derived_prefix;
        record_texts;
        choice_part;
        element_part;
        any_part;
        attribute_step;
        element_arm;
        group_arm;
        choice_text;
        first_arm_only;
        witness_items;
        element_witness;
        choice_witness;
        any_witness
    }.
    (family : f) (kinds : list (string * type_kind)) (items : list (xsd particle form)) (acc : list walk_text)
    : list walk_text
    =
    ?= items ?|
    | (Element e) :: rest =>
        := own = ?= e.inline ?| Some inner => named_type_walk family kinds (tag_text e.name) inner | None => []
        roots_walk family kinds rest (listm.append own acc)
    | _ :: rest => roots_walk family kinds rest acc
    | [] => acc

:= function_key (text : string) : string =
    := stop = sm'.index_of " (" text
    ? stop < 0i32 ?> text |: sm'.substring 0i32 stop text

:~ ^ unique_texts (items : list string) (seen : list string) (acc : list string) : list string =
    ?= items ?|
    | item :: rest =>
        := key = function_key item
        ? has_name key seen ?> unique_texts rest seen acc |: unique_texts rest (key :: seen) (item :: acc)
    | [] => reverse acc []

:= walk_texts_with
    \* form f {
        derived_prefix;
        record_texts;
        choice_part;
        element_part;
        any_part;
        attribute_step;
        element_arm;
        group_arm;
        choice_text;
        first_arm_only;
        witness_items;
        element_witness;
        choice_witness;
        any_witness
    }.
    (reader : f) (kinds : list (string * type_kind)) (complex_types : list (xsd type_def form))
    (elements : list (xsd particle form))
    : list walk_text
    =
    := readers = roots_walk reader kinds elements (types_walk reader kinds complex_types [])
    := writers = roots_walk Writing kinds elements (types_walk Writing kinds complex_types [])
    := examples = roots_walk Exampling kinds elements (types_walk Exampling kinds complex_types [])
    listm.append readers (listm.append writers examples)

:= walk_texts \* form.
    (kinds : list (string * type_kind)) (complex_types : list (xsd type_def form)) (elements : list (xsd particle form))
    : list walk_text
    =
    walk_texts_with Reading kinds complex_types elements

:= function_texts \* form.
    (kinds : list (string * type_kind)) (complex_types : list (xsd type_def form)) (elements : list (xsd particle form))
    : list string
    =
    := readers = roots_walk Reading kinds elements (types_walk Reading kinds complex_types [])
    := writers = roots_walk Writing kinds elements (types_walk Writing kinds complex_types [])
    := examples = roots_walk Exampling kinds elements (types_walk Exampling kinds complex_types [])
    unique_texts (function_parts (listm.append readers (listm.append writers examples)) []) [] []

:= functions_group (functions : list string) : string =
    ?= functions ?|
    | first :: rest =>
        "let rec "
        ++# sm'.substring 8i32 (sm'.length first - 8i32) first
        ++# "\n"
        ++# sm'.concat_balanced "\n" rest
        ++# "\n"
    | [] => ""

:= readers_text \* form.
    (kinds : list (string * type_kind)) (complex_types : list (xsd type_def form)) (elements : list (xsd particle form))
    : string
    =
    functions_group (function_texts kinds complex_types elements)

:~ ^ item_parts (texts : list walk_text) (acc : list string) : list string =
    ?= texts ?|
    | ItemText t :: rest => item_parts rest (t :: acc)
    | FunctionText _ :: rest => item_parts rest acc
    | [] => reverse acc []

:~ ^ simple_aliases \* form.
    (types : list (xsd type_def form)) (known : list string) (acc : list (string * string))
    : list (string * string)
    =
    ?= types ?|
    | (Simple s) :: rest =>
        := parent = reference_type s.base
        := facet_free = listm.length (enumeration_values s.facets []) = 0i32 && is_constrained s.facets = !-
        ? facet_free && is_builtin_reference (reference_text s.base) = !- && has_name parent known
        ?> simple_aliases rest known ((type_name (definition_text s.name), parent) :: acc)
        |: simple_aliases rest known acc
    | _ :: rest => simple_aliases rest known acc
    | [] => acc

:~ ^ alias_parent (target : string) (aliases : list (string * string)) : option string =
    ?= aliases ?|
    | (name, parent) :: rest => ? name = target ?> Some parent |: alias_parent target rest
    | [] => None

:~ ^ resolved_kind
    (aliases : list (string * string)) (kinds : list (string * type_kind)) (name : string) (depth : i32)
    : type_kind
    =
    ?= alias_parent name aliases ?|
    | Some parent => ? depth > 64i32 ?> KindText |: resolved_kind aliases kinds parent (depth + 1i32)
    | None => kind_lookup name kinds

:~ ^ inherited_kinds
    (aliases : list (string * string)) (all : list (string * type_kind)) (kinds : list (string * type_kind))
    (acc : list (string * type_kind))
    : list (string * type_kind)
    =
    ?= kinds ?|
    | (name, kind) :: rest =>
        := inherited =
            ?= alias_parent name aliases ?|
            | Some _ => resolved_kind aliases all name 0i32
            | None => kind
        inherited_kinds aliases all rest ((name, inherited) :: acc)
    | [] => reverse acc []

:= alias_text (ty : string) (parent : string) (kind : type_kind) : string =
    := codec =
        ?= kind ?|
        | KindEnum | KindValidated =>
            "\ninl "
            ++# ty
            ++# "_of_string (s : string) : option "
            ++# ty
            ++# " = "
            ++# parent
            ++# "_of_string s\n\ninl "
            ++# ty
            ++# "_to_string (x : "
            ++# ty
            ++# ") : string = "
            ++# parent
            ++# "_to_string x\n"
        | _ => ""
    "type "
    ++# ty
    ++# " = "
    ++# parent
    ++# "\n\ninl "
    ++# ty
    ++# "_example (k : i32) = "
    ++# parent
    ++# "_example k\n\ninl "
    ++# ty
    ++# "_example_text (k : i32) : string = "
    ++# parent
    ++# "_example_text k\n"
    ++# codec

:~ ^ aliased_items
    (aliases : list (string * string)) (kinds : list (string * type_kind)) (items : list emitted)
    (acc : list emitted)
    : list emitted
    =
    ?= items ?|
    | item :: rest =>
        ?= alias_parent item.name aliases ?|
        | Some parent =>
            := text = alias_text item.name parent (kind_lookup item.name kinds)
            aliased_items aliases kinds rest ({ item ?| text = text; references = parent :: [] } :: acc)
        | None => aliased_items aliases kinds rest (item :: acc)
    | [] => reverse acc []

:== module_parts = { items : list emitted; functions : list string; witness_items : list string }

:= module_parts_by \* form.
    (walk : list (string * type_kind) -> list (xsd type_def form) -> list (xsd particle form) -> list walk_text)
    (schema : xsd_schema form)
    : module_parts
    =
    := complex_types = dereferenced_all schema.elements schema.complex_types []
    := elements = dereferenced_all schema.elements schema.elements []
    := all = reverse (emit_roots elements (emit_types complex_types (emit_types schema.simple_types []))) []
    := shared = share_unions (unique_emitted all [] []) [] []
    := aliases = simple_aliases schema.simple_types (emitted_names shared []) []
    := base_kinds = kinds_of schema.simple_types (kinds_of complex_types [])
    := kinds = inherited_kinds aliases base_kinds base_kinds []
    := unique = aliased_items aliases kinds shared []
    := known = emitted_names unique []
    := items, wrapped = order_emitted (with_known_references unique known []) known [] []
    := walked_texts = walk (recursive_kinds kinds wrapped []) complex_types elements
    {
        items = items
        functions = unique_texts (function_parts walked_texts []) [] []
        witness_items = distinct_values (item_parts walked_texts []) [] []
    }

:= module_parts_with
    \* form f {
        derived_prefix;
        record_texts;
        choice_part;
        element_part;
        any_part;
        attribute_step;
        element_arm;
        group_arm;
        choice_text;
        first_arm_only;
        witness_items;
        element_witness;
        choice_witness;
        any_witness
    }.
    (reader : f) (schema : xsd_schema form)
    : module_parts
    =
    module_parts_by (walk_texts_with reader) schema

:= staged_walk_texts \* form.
    (staged : list string) (signatures : list string) (kinds : list (string * type_kind))
    (complex_types : list (xsd type_def form)) (elements : list (xsd particle form))
    : list walk_text
    =
    := reader = StagedReading (staged, signatures)
    := writer = StagedWriting (staged, signatures)
    := exampler = StagedExampling (staged, signatures)
    := readers = roots_walk reader kinds elements (types_walk reader kinds complex_types [])
    := writers = roots_walk writer kinds elements (types_walk writer kinds complex_types [])
    := examples = roots_walk exampler kinds elements (types_walk exampler kinds complex_types [])
    listm.append readers (listm.append writers examples)

:= module_parts_staged \* form.
    (staged : list string) (signatures : list string) (schema : xsd_schema form)
    : module_parts
    =
    module_parts_by (staged_walk_texts staged signatures) schema

:= module_parts \* form. (schema : xsd_schema form) : module_parts = module_parts_with Reading schema

:= is_plain (item : emitted) : bool = is_certificate item = !-

:~ ^ kept_items (keep : emitted -> bool) (items : list emitted) (acc : list emitted) : list emitted =
    ?= items ?|
    | item :: rest => kept_items keep rest (? keep item ?> item :: acc |: acc)
    | [] => reverse acc []

:= untyped_any_content () : string =
    "type any_content = list xml.xml_node\n\n"
    ++# "inl any_content_of (nodes : list xml.xml_node) : any_content = nodes\n\n"
    ++# "inl any_content_to (content : any_content) : list xml.xml_node = content\n\n"

:= units_of_parts (any_content : string) (prelude : string) (parts : module_parts) : string * string =
    := certificates = kept_items is_certificate parts.items []
    := witnesses = join_lines parts.witness_items ""
    := plain_items = texts_of (kept_items is_plain parts.items [])
    := body = plain_items ++# witnesses ++# functions_group parts.functions
    := main = codec_prelude () ++# prelude ++# (? sm'.contains "any_content" body ?> any_content |: "") ++# body
    ?= certificates ?|
    | [] => main, ""
    | _ => main, texts_of certificates ++# certificates_checked_text certificates

:= generated_units_with \* form. (any_content : string) (schema : xsd_schema form) : string * string =
    units_of_parts any_content "" (module_parts schema)

:= generated_units_signed \* form.
    (signatures : list string) (any_content : string) (schema : xsd_schema form)
    : string * string
    =
    := staged = staged_type_names signatures schema
    ?= staged ?|
    | [] => generated_units_with any_content schema
    | _ =>
        := parts = module_parts_staged staged signatures schema
        units_of_parts any_content (staging_prelude ()) { parts ?| items = staged_items staged signatures parts.items }

:= generated_units \* form. (schema : xsd_schema form) : string * string =
    generated_units_with (untyped_any_content ()) schema

:= generate_module (schema : xsd_schema final) : string =
    := main, _ = generated_units schema
    main

:~ ^ item_text (name : string) (items : list emitted) : option string =
    ?= items ?|
    | item :: rest => ? item.name = name ?> Some item.text |: item_text name rest
    | [] => None

:~ ^ same_in_all (name : string) (text : string) (versions : list module_parts) : bool =
    ?= versions ?|
    | parts :: rest =>
        (?= item_text name parts.items ?| Some other => other = text | None => !-) && same_in_all name text rest
    | [] => !+

:~ ^ identical_names (items : list emitted) (versions : list module_parts) (acc : list string) : list string =
    ?= items ?|
    | item :: rest =>
        identical_names rest versions (? same_in_all item.name item.text versions ?> (item.name :: acc) |: acc)
    | [] => acc

:~ ^ all_shared (references : list string) (shared : list string) : bool =
    ?= references ?|
    | reference :: rest => has_name reference shared && all_shared rest shared
    | [] => !+

:~ ^ closed_pass (items : list emitted) (shared : list string) (acc : list string) : list string =
    ?= items ?|
    | item :: rest =>
        closed_pass rest shared (
            ? has_name item.name shared && all_shared item.references shared ?> (item.name :: acc) |: acc
        )
    | [] => acc

:~ ^ closed_shared (items : list emitted) (shared : list string) : list string =
    := next = closed_pass items shared []
    ? count_list next = count_list shared ?> shared |: closed_shared items next

:~ ^ owner_of (key : string) (names : list string) (best : string) : string =
    ?= names ?|
    | name :: rest =>
        := longer = sm'.starts_with ("and let " ++# name ++# "_") key && (sm'.length name : i32) > sm'.length best
        owner_of key rest (? longer ?> name |: best)
    | [] => best

:~ ^ has_text_in (text : string) (functions : list string) : bool =
    ?= functions ?|
    | f :: rest => f = text || has_text_in text rest
    | [] => !-

:~ ^ function_in_all (text : string) (versions : list module_parts) : bool =
    ?= versions ?|
    | parts :: rest => has_text_in text parts.functions && function_in_all text rest
    | [] => !+

:~ ^ split_items
    (items : list emitted) (shared : list string) (core : list emitted) (own : list emitted)
    : list emitted * list emitted
    =
    ?= items ?|
    | item :: rest =>
        ? has_name item.name shared ?> split_items rest shared (item :: core) own
        |: split_items rest shared core (item :: own)
    | [] => reverse core [], reverse own []

:~ ^ split_functions
    (functions : list string) (names : list string) (shared : list string) (versions : list module_parts)
    (core : list string) (own : list string)
    : list string * list string
    =
    ?= functions ?|
    | f :: rest =>
        := owner = owner_of (function_key f) names ""
        ? owner <> "" && has_name owner shared && function_in_all f versions
        ?> split_functions rest names shared versions (f :: core) own
        |: split_functions rest names shared versions core (f :: own)
    | [] => reverse core [], reverse own []

:~ ^ functions_outside (functions : list string) (core : list string) (acc : list string) : list string =
    ?= functions ?|
    | f :: rest => functions_outside rest core (? has_text_in f core ?> acc |: f :: acc)
    | [] => reverse acc []

:= function_name (text : string) : string =
    := key = function_key text
    sm'.substring 8i32 (sm'.length key - 8i32) key

:~ ^ mentions_any (text : string) (names : list string) : bool =
    ?= names ?|
    | name :: rest => sm'.contains name text || mentions_any text rest
    | [] => !-

:~ ^ function_names (functions : list string) (acc : list string) : list string =
    ?= functions ?|
    | f :: rest => function_names rest (function_name f :: acc)
    | [] => acc

:~ ^ self_contained (core : list string) (outside : list string) (acc : list string) : list string =
    ?= core ?|
    | f :: rest => self_contained rest outside (? mentions_any f outside ?> acc |: f :: acc)
    | [] => reverse acc []

:~ ^ closed_functions (core : list string) (all : list string) : list string =
    := outside = function_names (functions_outside all core []) []
    := next = self_contained core outside []
    ? count_list next = count_list core ?> core |: closed_functions next all

:~ ^ version_texts
    (versions : list module_parts) (shared : list string) (core_functions : list string) (core_module : string)
    (acc : list string)
    : list string
    =
    ?= versions ?|
    | parts :: rest =>
        := _, own_items = split_items parts.items shared [] []
        := own_functions = functions_outside parts.functions core_functions []
        := text = "open " ++# core_module ++# "\n\n" ++# texts_of own_items ++# functions_group own_functions
        version_texts rest shared core_functions core_module (text :: acc)
    | [] => reverse acc []

:== family_split = { shared : list string; core_text : string; version_texts : list string }

:= split_family (versions : list module_parts) (core_module : string) : family_split =
    ?= versions ?|
    | first :: _ =>
        := shared = closed_shared first.items (identical_names first.items versions [])
        := core_items, _ = split_items first.items shared [] []
        := candidates, _ = split_functions first.functions (emitted_names first.items []) shared versions [] []
        := core_functions = closed_functions candidates first.functions
        := texts = version_texts versions shared core_functions core_module []
        := core_body = texts_of core_items ++# functions_group core_functions
        := uses_any = sm'.contains "any_content" (core_body ++# sm'.concat_balanced "" texts)
        {
            shared = shared
            core_text = codec_prelude () ++# (? uses_any ?> untyped_any_content () |: "") ++# core_body
            version_texts = texts
        }
    | [] => { shared = []; core_text = ""; version_texts = [] }

:= generate_family \* form. (schemas : list (xsd_schema form)) (core_module : string) : string * list string =
    := split = split_family (listm.map module_parts schemas) core_module
    split.core_text, split.version_texts

:~ ^ has_function_key (key : string) (functions : list string) : bool =
    ?= functions ?|
    | f :: rest => function_key f = key || has_function_key key rest
    | [] => !-

:~ ^ read_in_all (name : string) (versions : list module_parts) : bool =
    ?= versions ?|
    | parts :: rest => has_function_key ("and let " ++# name ++# "_of_xml") parts.functions && read_in_all name rest
    | [] => !+

:~ ^ versioned_names
    (items : list emitted) (shared : list string) (versions : list module_parts) (acc : list string)
    : list string
    =
    ?= items ?|
    | item :: rest =>
        := versioned = has_name item.name shared = !- && read_in_all item.name versions
        versioned_names rest shared versions (? versioned ?> (item.name :: acc) |: acc)
    | [] => reverse acc []

:~ ^ common_prefix_length (a : string) (b : string) (pos : i32) : i32 =
    ? pos < sm'.length a && pos < sm'.length b && sm'.substring pos 1i32 a = sm'.substring pos 1i32 b
    ?> common_prefix_length a b (pos + 1i32)
    |: pos

:~ ^ shared_prefix (names : list string) (prefix : string) : string =
    ?= names ?|
    | name :: rest => shared_prefix rest (sm'.substring 0i32 (common_prefix_length prefix name 0i32) prefix)
    | [] => prefix

:~ ^ past_last_underscore (s : string) (pos : i32) (best : i32) : i32 =
    ? pos >= sm'.length s ?> best
    |: past_last_underscore s (pos + 1i32) (? sm'.substring pos 1i32 s = "_" ?> pos + 1i32 |: best)

:= version_prefix_length (modules : list string) : i32 =
    ?= modules ?|
    | first :: _ :: _ => past_last_underscore (shared_prefix modules first) 0i32 0i32
    | _ => 0i32

:= version_tag (prefix_length : i32) (module_name : string) : string =
    := tag = sm'.substring prefix_length (sm'.length module_name - prefix_length) module_name
    ? sm'.length tag > 0i32 && is_lower (sm'.substring 0i32 1i32 tag) ?> tag |: "v" ++# tag

:= upper_first (s : string) : string =
    := at = ? sm'.length s > 0i32 ?> sm'.index_of (sm'.substring 0i32 1i32 s) (lower_letters ()) |: 0i32 - 1i32
    ? at < 0i32 ?> capitalized s
    |: sm'.substring at 1i32 (upper_letters ()) ++# sm'.substring 1i32 (sm'.length s - 1i32) s

:= versioned_case (name : string) (tag : string) : string =
    upper_first (? sm'.starts_with "x_" name ?> sm'.substring 2i32 (sm'.length name - 2i32) name |: name)
    ++# "_"
    ++# tag

:~ ^ version_lines
    (modules : list string) (prefix_length : i32) (line : string -> string -> string) (acc : list string)
    : list string
    =
    ?= modules ?|
    | module_name :: rest =>
        version_lines rest prefix_length line (line module_name (version_tag prefix_length module_name) :: acc)
    | [] => reverse acc []

:= versioned_type_text (modules : list string) (prefix_length : i32) (name : string) : string =
    := cases =
        version_lines modules prefix_length
            \ module_name tag =>
                "    | "
                ++# versioned_case name tag
                ++# " :: "
                ++# module_name
                ++# "."
                ++# name
                ++# " -> "
                ++# name
                ++# " "
                ++# tag
            []
    := reads =
        version_lines modules prefix_length
            \ module_name tag =>
                "    | "
                ++# upper_first tag
                ++# " _ => "
                ++# versioned_case name tag
                ++# " ("
                ++# module_name
                ++# "."
                ++# name
                ++# "_of_xml c)"
            []
    "union "
    ++# name
    ++# " v =\n"
    ++# join_lines cases ""
    ++# "\ninl "
    ++# name
    ++# "_of_xml forall v. (witness : version_witness v) (c : xml.xml_node) : "
    ++# name
    ++# " v =\n    match witness with\n"
    ++# join_lines reads ""
    ++# "\n"

:~ ^ versioned_type_texts
    (modules : list string) (prefix_length : i32) (names : list string) (acc : list string)
    : list string
    =
    ?= names ?|
    | name :: rest =>
        versioned_type_texts modules prefix_length rest (versioned_type_text modules prefix_length name :: acc)
    | [] => reverse acc []

:= family_text (modules : list string) (names : list string) : string =
    := prefix_length = version_prefix_length modules
    := nominals = version_lines modules prefix_length (\ _ tag => "nominal " ++# tag ++# " = string") []
    := witnesses =
        version_lines modules prefix_length
            \ _ tag => "    | " ++# upper_first tag ++# " :: string -> version_witness " ++# tag
            []
    join_lines nominals ""
    ++# "\nunion version_witness v =\n"
    ++# join_lines witnesses ""
    ++# "\n"
    ++# sm'.concat_balanced "" (versioned_type_texts modules prefix_length names [])

:~ ^ member_modules \* form. (members : list (string * xsd_schema form)) (acc : list string) : list string =
    ?= members ?|
    | (module_name, _) :: rest => member_modules rest (module_name :: acc)
    | [] => reverse acc []

:~ ^ member_parts \* form. (members : list (string * xsd_schema form)) (acc : list module_parts) : list module_parts =
    ?= members ?|
    | (_, schema) :: rest => member_parts rest (module_parts schema :: acc)
    | [] => reverse acc []

:= generate_versioned_family \* form.
    (members : list (string * xsd_schema form)) (core_module : string)
    : string * list string * string
    =
    := versions = member_parts members []
    := split = split_family versions core_module
    ?= versions ?|
    | first :: _ =>
        split.core_text,
        split.version_texts,
        family_text (member_modules members []) (versioned_names first.items split.shared versions [])
    | [] => split.core_text, split.version_texts, ""

:= generate_enumerations \* form. (schema : xsd_schema form) : string =
    texts_of (reverse (emit_types schema.simple_types []) [])

///> rust
test names_follow_spiral_conventions =
    ? type_name "TCodUfIBGE" <> "x_t_cod_uf_ibge" ?> failwith "snake case type name"
    ? case_name "TCodUfIBGE" "35" <> "TCodUfIBGE_35" ?> failwith "numeric case name"
    ? case_name "TVerNFe" "1.04" <> "TVerNFe_1_04" ?> failwith "dotted case name"
    ? case_name "TOrigem" "Não" <> "TOrigem_N_o" ?> failwith "non-ASCII value becomes an underscore"
    ? case_name "enviNFe_versao" "4.00" <> "XenviNFe_versao_4_00" ?> failwith "lowercase owner gets a capital prefix"
    ? field_name "type" <> "type_value" ?> failwith "keyword field"
    ? type_name "TNFe" <> "x_tn_fe" ?> failwith "an upper run splits before its last capital"
    ? case_name "TTransformURI" "http://www.w3.org/2000/09/xmldsig#enveloped-signature"
        <> "TTransformURI_enveloped_signature"
    ?> failwith "a URI value is named by its fragment"
    ? case_name "TTransformURI" "http://www.w3.org/TR/2001/REC-xml-c14n-20010315"
        <> "TTransformURI_REC_xml_c14n_20010315"
    ?> failwith "a URI value without a fragment is named by its last path segment"

///> rust
test enumerations_parse_through_one_match =
    := text = union_text "TUf" ("SP" :: "RJ" :: []) ""
    ? sm'.contains "    match s with\n    | \"SP\" => Some TUf_SP\n" text = !- ?> failwith "one arm per value"
    ? sm'.contains "    | _ => None\n" text = !- ?> failwith "anything else is None"
    ? sm'.contains "if false" text ?> failwith "no dead first branch"
    := token_text = union_text "TUf" ("SP" :: "RJ" :: []) "xml.collapsed_space"
    ? sm'.contains "    inl s = xml.collapsed_space s\n    match s with\n" token_text = !-
    ?> failwith "a token enumeration collapses whitespace before matching, as XSD does"
    ? sm'.contains "inl s = " text ?> failwith "a string enumeration matches its text as written"

///> rust
test families_share_identical_closed_types_once =
    := shared =
        "<xs:simpleType name=\"Code\"><xs:restriction base=\"xs:string\"><xs:pattern "
        ^^ "value=\"[0-9]{2}\"/></xs:restriction></xs:simpleType>"
    := leaf one =
        "<xs:complexType name=\"Leaf\"><xs:sequence><xs:element name=\"c\" type=\"Code\"/>"
        ++# one
        ++# "</xs:sequence></xs:complexType>"
    := root =
        "<xs:complexType name=\"Root\"><xs:sequence><xs:element name=\"l\" "
        ^^ "type=\"Leaf\"/></xs:sequence></xs:complexType>"
    := v1 = read_schema ("<xs:schema>" ++# shared ++# leaf "" ++# root ++# "</xs:schema>")
    := v2 =
        read_schema (
            "<xs:schema>" ++# shared ++# leaf "<xs:element name=\"extra\" type=\"Code\"/>" ++# root ++# "</xs:schema>"
        )
    := core, versions = generate_family (v1 :: v2 :: []) "generated_demo_core"
    ? sm'.contains "nominal private x_code = string" core = !- ?> failwith "the identical leaf type is in the core"
    ? sm'.contains "type x_leaf" core ?> failwith "the changed type stays per version"
    ? sm'.contains "type x_root" core ?> failwith "a type over a changed type stays per version"
    ?= versions ?|
    | first :: second :: [] =>
        ? sm'.starts_with "open generated_demo_core" first = !- ?> failwith "a version opens its core"
        ? sm'.contains "nominal private x_code" second ?> failwith "the core type is not repeated"
        ? sm'.contains "extra" first || sm'.contains "extra" second = !-
        ?> failwith "the version keeps its own shape"
    | _ => failwith "two version modules"

///> rust
test versioned_families_read_through_one_witness =
    := shared =
        "<xs:simpleType name=\"Code\"><xs:restriction base=\"xs:string\"><xs:pattern "
        ^^ "value=\"[0-9]{2}\"/></xs:restriction></xs:simpleType>"
    := leaf one =
        "<xs:complexType name=\"Leaf\"><xs:sequence><xs:element name=\"c\" type=\"Code\"/>"
        ++# one
        ++# "</xs:sequence></xs:complexType>"
    := root =
        "<xs:complexType name=\"Root\"><xs:sequence><xs:element name=\"l\" "
        ^^ "type=\"Leaf\"/></xs:sequence></xs:complexType>"
    := v1 = read_schema ("<xs:schema>" ++# shared ++# leaf "" ++# root ++# "</xs:schema>")
    := v2 =
        read_schema (
            "<xs:schema>" ++# shared ++# leaf "<xs:element name=\"extra\" type=\"Code\"/>" ++# root ++# "</xs:schema>"
        )
    := _, _, family =
        generate_versioned_family (("generated_demo_v1", v1) :: ("generated_demo_v2", v2) :: []) "generated_demo_core"
    ? sm'.contains "nominal v1 = string\nnominal v2 = string\n" family = !-
    ?> failwith "one nominal per version, tagged past the shared prefix"
    ? sm'.contains "    | V2 :: string -> version_witness v2\n" family = !-
    ?> failwith "the witness indexes each version"
    ? sm'.contains "    | Leaf_v2 :: generated_demo_v2.x_leaf -> x_leaf v2\n" family = !-
    ?> failwith "a changed type becomes a version-indexed union"
    ? sm'.contains "    | V1 _ => Leaf_v1 (generated_demo_v1.x_leaf_of_xml c)\n" family = !-
    ?> failwith "the reader matches the witness once"
    ? sm'.contains "union x_root v =" family = !- ?> failwith "a type over a changed type is versioned too"
    ? sm'.contains "x_code" family ?> failwith "core types are not versioned"

:== complement_member form = { case_name : string; module_name : string; schema : xsd_schema form }

:= root_reader \* form. (member : complement_member form) : string * string =
    ?= member.schema.elements ?|
    | (Element e) :: _ =>
        := local = xml.local_name (tag_text e.name)
        ?= e.inline, e.type_ref ?|
        | Some _, _ => local, type_name (tag_text e.name)
        | None, Some reference => local, type_name (xml.local_name (reference_text reference))
        | None, None => local, type_name ""
    | _ => "", ""

:~ ^ complement_case_lines \* form. (members : list (complement_member form)) (acc : list string) : list string =
    ?= members ?|
    | member :: rest =>
        := _, ty = root_reader member
        complement_case_lines rest (
            "    | " ++# member.case_name ++# " : " ++# member.module_name ++# "." ++# ty :: acc
        )
    | [] => reverse acc []

:~ ^ complement_case_dispatch \* form. (members : list (complement_member form)) (acc : string) : string =
    ?= members ?|
    | member :: rest =>
        := element, ty = root_reader member
        := test =
            "local = \""
            ++# element
            ++# "\" && (space = \"\" || space = \""
            ++# escape_text (namespace_text member.schema.target_namespace)
            ++# "\")"
        complement_case_dispatch rest (
            acc
            ++# "if "
            ++# test
            ++# " then "
            ++# member.case_name
            ++# " ("
            ++# member.module_name
            ++# "."
            ++# ty
            ++# "_of_xml node)\n    el"
        )
    | [] => acc ++# "se Unknown node\n"

:~ ^ complement_case_writes \* form. (members : list (complement_member form)) (acc : list string) : list string =
    ?= members ?|
    | member :: rest =>
        := element, ty = root_reader member
        := space = escape_text (namespace_text member.schema.target_namespace)
        := written = member.module_name ++# "." ++# ty ++# "_to_xml \"" ++# element ++# "\" v"
        := body = ? space = "" ?> written |: "complement_in \"" ++# space ++# "\" (" ++# written ++# ")"
        complement_case_writes rest ("    | " ++# member.case_name ++# " v => " ++# body :: acc)
    | [] => reverse acc []

:= generate_complements \* form. (members : list (complement_member form)) : string =
    := head =
        "union complement =\n"
        ++# join_lines (complement_case_lines members []) ""
        ++# "    | Unknown : xml.xml_node\n"
    := space =
        "\ninl complement_namespace (node : xml.xml_node) : string =\n"
        ++# "    inl name = xml.node_name node\n"
        ++# "    inl colon = sm'.index_of \":\" name\n"
        ++# "    inl key = if colon >= 0i32 then sm'.(++#) \"xmlns:\" (sm'.substring 0i32 colon name) else \"xmlns\"\n"
        ++# "    match xml.attribute_of key (xml.element_attributes node) with\n"
        ++# "    | Some uri => uri\n"
        ++# "    | None => \"\"\n"
    := reader =
        "\ninl complement_of_xml (node : xml.xml_node) : complement =\n"
        ++# "    inl local = xml.local_name (xml.node_name node)\n"
        ++# "    inl space = complement_namespace node\n"
        ++# "    " ++# complement_case_dispatch members ""
    := writer =
        "\ninl complement_in (space : string) (node : xml.xml_node) : xml.xml_node =\n"
        ++# "    xml.element (xml.node_name node) ((\"xmlns\", space) :: xml.element_attributes node)"
        ++# " (xml.element_children node)\n"
        ++# "\ninl complement_to_xml (x : complement) : xml.xml_node =\n"
        ++# "    match x with\n"
        ++# join_lines (complement_case_writes members []) ""
        ++# "    | Unknown node => node\n"
    head ++# space ++# reader ++# writer

:= complement_any_content () : string =
    "type any_content = list complement\n\n"
    ++# "inl any_content_of (nodes : list xml.xml_node) : any_content = listm.map complement_of_xml nodes\n\n"
    ++# "inl any_content_to (content : any_content) : list xml.xml_node = listm.map complement_to_xml content\n\n"

///> rust
test complements_read_and_write_typed_cases_and_keep_unknown_elements_whole =
    := pagos =
        read_schema (
            "<xs:schema targetNamespace=\"http://www.sat.gob.mx/Pagos20\"><xs:element "
            ^^ "name=\"Pagos\"><xs:complexType><xs:sequence><xs:element name=\"Monto\" "
            ^^ "type=\"xs:string\"/></xs:sequence></xs:complexType></xs:element></xs:schema>"
        )
    := text =
        generate_complements ({ case_name = "Pagos20"; module_name = "generated_cfdi_pagos20"; schema = pagos } :: [])
    ?
        sm'.contains
            (
                "union complement =\n    | Pagos20 : generated_cfdi_pagos20.x_pagos\n"
                ^^ "    | Unknown : xml.xml_node\n"
            )
            text
        = !-
    ?> failwith "one typed case per complement plus Unknown"
    ? sm'.contains "then Pagos20 (generated_cfdi_pagos20.x_pagos_of_xml node)" text = !-
    ?> failwith "the reader builds the typed case"
    ? sm'.contains "else Unknown node\n" text = !- ?> failwith "an unknown complement keeps its whole element"
    ?
        sm'.contains
            (
                "    | Pagos20 v => complement_in \"http://www.sat.gob.mx/Pagos20\" "
                ^^ "(generated_cfdi_pagos20.x_pagos_to_xml \"Pagos\" v)\n"
            )
            text
        = !-
    ?> failwith "the writer emits the typed case in its schema namespace"
    ? sm'.contains "    | Unknown node => node\n" text = !- ?> failwith "the writer returns an unknown element as read"
    ? sm'.contains "exists" text ?> failwith "no existential in the runtime slot"
    ? sm'.contains "then sm'.(++#) \"xmlns:\" (sm'.substring 0i32 colon name)" text = !-
    ?> failwith "the emitted code spells the operator the way generated units do (they don't open sm'_operators)"

///> rust
test constrained_strings_become_validated_nominals =
    := schema =
        read_schema (
            "<xs:schema><xs:simpleType name=\"TCnpj\"><xs:restriction base=\"xs:string\"><xs:pattern "
            ++# "value=\"[0-9]{14}\"/></xs:restriction></xs:simpleType><xs:simpleType name=\"TFree\">"
            ++# "<xs:restriction base=\"xs:string\"/></xs:simpleType></xs:schema>"
        )
    := text = generate_module (xsd_resolve.finalize_names (xsd_resolve.qualify_schema [] schema))
    ? sm'.contains "nominal private x_t_cnpj = string" text = !- ?> failwith "a constrained string is a private nominal"
    ? sm'.contains "if x_t_cnpj_is_valid s then Some (x_t_cnpj s) else None" text = !-
    ?> failwith "the only way in is the validator"
    ? sm'.contains "type x_t_free = string" text = !- ?> failwith "an unconstrained string stays an alias"
    ?= any_validated_type schema ?|
    | Some name => ? name <> "x_t_cnpj" ?> failwith "the validated type is the constrained one"
    | None => failwith "a schema with a constrained string has a validated type"

///> rust
test value_sets_compare_by_kind_and_values =
    ? same_value_set (UnionValueSet [ "a"; "b" ]) (UnionValueSet [ "a"; "b" ]) = !-
    ?> failwith "equal value lists share"
    ? same_value_set (UnionValueSet [ "a" ]) (UnionValueSet [ "a"; "b" ]) ?> failwith "a prefix is not the same set"
    ? same_value_set (DfaValueSet "t") (UnionValueSet [ "t" ]) ?> failwith "a table never equals a value list"
    ? same_value_set NoValueSet NoValueSet ?> failwith "a type without a value set never shares"

///> rust
test dfa_tables_carry_their_certificates =
    := schema =
        read_schema (
            "<xs:schema><xs:simpleType name=\"TDigits\"><xs:restriction base=\"xs:string\"><xs:pattern "
            ++# "value=\"[0-9]{2}\"/></xs:restriction></xs:simpleType></xs:schema>"
        )
    := main, text = generated_units schema
    ? sm'.contains "_certificate () =" main ?> failwith "certificates leave the main unit"
    ? sm'.contains "_certificate () =" text = !- ?> failwith "a pattern's DFA is emitted with its certificate"
    ? sm'.contains "xsd_certificate.PackedMoves (exists (xsd_certificate.MovesNext (" text = !-
    ?> failwith "each row's moves are packed as a length-indexed witness"
    ? sm'.contains "inl certificates_checked () : i32 = 0i32 + xsd_certificate.certified_table (" text = !-
    ?> failwith "the module sums its certified tables"

///> rust
test pattern_restricted_dates_keep_a_valid_date =
    ? simple_example "xs:date" (Pattern "[0-9]{4}-[0-9]{2}-[0-9]{2}" :: []) <> "2026-01-01"
    ?> failwith "a date pattern keeps the builtin's valid date instead of zeros"
    ? simple_example "xs:date" (Pattern "1999-[0-9]{2}-[0-9]{2}" :: []) = "2026-01-01"
    ?> failwith "a pattern the builtin date does not match still searches"

///> rust
test coded_types_share_the_text_prototype =
    := coded = union_text "TUf" [ "SP"; "RJ" ] ""
    ? sm'.contains "instance to_text x_t_uf = fun x => x_t_uf_to_string x\n" coded = !-
    ?> failwith "an enum union gets its to_text instance"
    := schema =
        read_schema (
            "<xs:schema><xs:simpleType name=\"TCep\"><xs:restriction base=\"xs:string\">"
            ^^ "<xs:pattern value=\"[0-9]{8}\"/></xs:restriction></xs:simpleType></xs:schema>"
        )
    := generated = generate_module (xsd_resolve.finalize_names (xsd_resolve.qualify_schema [] schema))
    ? sm'.starts_with "prototype to_text t : t -> string\n" generated = !-
    ?> failwith "the module declares the prototype before any instance"
    ? sm'.contains "instance to_text x_t_cep = fun x => x_t_cep_to_string x\n" generated = !-
    ?> failwith "a validated nominal gets its instance"

///> rust
test a_type_named_like_a_certificate_stays_in_the_main_unit =
    := schema =
        read_schema (
            "<xs:schema><xs:complexType name=\"CertificateValuesType\"><xs:choice>"
            ++# "<xs:element name=\"EncapsulatedX509Certificate\" type=\"xs:string\"/>"
            ++# "<xs:element name=\"OtherCertificate\" type=\"xs:string\"/></xs:choice></xs:complexType></xs:schema>"
        )
    := main, certificates = generated_units schema
    ? sm'.contains "union x_certificate_values_type_choice_encapsulated_x509_certificate =" main = !-
    ?> failwith "a type whose name ends in _certificate stays in the main unit"
    ? sm'.contains "xsd_certificate.certified_table (x_certificate_values_type" certificates
    ?> failwith "only certificate items are certified"

///> rust
test a_choice_of_only_wildcards_is_any_content =
    := schema =
        read_schema (
            "<xs:schema><xs:complexType name=\"SignaturePropertyType\"><xs:choice maxOccurs=\"unbounded\">"
            ++# "<xs:any namespace=\"##other\" processContents=\"lax\"/></xs:choice>"
            ++# "<xs:attribute name=\"Target\" type=\"xs:anyURI\" use=\"required\"/></xs:complexType></xs:schema>"
        )
    := main, _ = generated_units schema
    ? sm'.contains "choice_empty" main ?> failwith "a wildcard-only choice emits no empty union"
    ? sm'.contains (field_line "any" "any_content") main = !-
    ?> failwith "a wildcard-only choice keeps its content as any_content"
    ? sm'.contains "type any_content = list xml.xml_node\n" main = !-
    ?> failwith "by default any_content is the raw nodes"

///> rust
test cyclic_types_become_one_recursive_group =
    := schema =
        read_schema (
            "<xs:schema><xs:complexType name=\"PartyType\"><xs:sequence>"
            ++# "<xs:element name=\"Name\" type=\"xs:string\"/>"
            ++# "<xs:element name=\"Location\" type=\"LocationType\" minOccurs=\"0\"/></xs:sequence></xs:complexType>"
            ++# "<xs:complexType name=\"LocationType\"><xs:sequence>"
            ++# "<xs:element name=\"Party\" type=\"PartyType\" minOccurs=\"0\" maxOccurs=\"unbounded\"/>"
            ++# "</xs:sequence></xs:complexType></xs:schema>"
        )
    := main, _ = generated_units schema
    ? sm'.contains "union rec x_" main = !- ?> failwith "a cycle opens one recursive group"
    ? sm'.contains "    | Record_x_party_type :\n        {\n" main = !-
    ?> failwith "a cyclic record is wrapped in its union"
    ? sm'.contains "inl x = match x' with | Record_x_party_type r => r" main = !- ?> failwith "its writer unwraps once"
    ? sm'.contains "type x_party_type =" main ?> failwith "no cyclic record stays a type alias"

///> rust
test a_wildcard_reads_the_children_no_named_element_claims =
    := schema =
        read_schema (
            "<xs:schema><xs:complexType name=\"ModalType\"><xs:sequence>"
            ++# "<xs:element name=\"Version\" type=\"xs:string\"/><xs:any processContents=\"skip\"/>"
            ++# "</xs:sequence></xs:complexType></xs:schema>"
        )
    := main, _ = generated_units schema
    ? sm'.contains "any = any_content_of (xml.unclaimed_children [\"Version\"] children)" main = !-
    ?> failwith "the reader keeps the wildcard's children instead of dropping them"
    ? sm'.contains "        any = []\n" main ?> failwith "no reader discards wildcard content"
    := typed, _ = generated_units_with (complement_any_content ()) schema
    ? sm'.contains "type any_content = list complement\n" typed = !-
    ?> failwith "a family with complements types its wildcard content"
    ? sm'.contains "list xml.xml_node\n\ninl any_content_of" typed ?> failwith "the override replaces the default"
    := plain, _ =
        generated_units (read_schema "<xs:schema><xs:element name=\"Note\" type=\"xs:string\"/></xs:schema>")
    ? sm'.contains "any_content" plain ?> failwith "a unit without a wildcard keeps no any_content"

///> rust
test a_choice_of_emptiable_alternatives_reads_its_empty_content =
    := schema =
        read_schema (
            "<xs:schema><xs:complexType name=\"TransportType\"><xs:choice><xs:sequence>"
            ++# "<xs:element name=\"Vehicle\" type=\"xs:string\" minOccurs=\"0\"/>"
            ++# "<xs:element name=\"Trailer\" type=\"xs:string\" minOccurs=\"0\" maxOccurs=\"5\"/></xs:sequence>"
            ++# "<xs:element name=\"Wagon\" type=\"xs:string\" minOccurs=\"0\"/></xs:choice></xs:complexType>"
            ++# "<xs:complexType name=\"PickType\"><xs:choice><xs:element name=\"A\" type=\"xs:string\"/>"
            ++# "<xs:element name=\"B\" type=\"xs:string\"/></xs:choice></xs:complexType></xs:schema>"
        )
    := main, _ = generated_units schema
    ? sm'.contains "x_transport_type_choice_vehicle: no alternative present" main
    ?> failwith "a choice whose alternatives can be empty reads its empty content"
    ? sm'.contains "x_pick_type_choice_a: no alternative present" main = !-
    ?> failwith "a choice of required alternatives still rejects missing content"

///> rust
test a_repeated_choice_reads_every_alternative_in_document_order =
    := schema =
        read_schema (
            "<xs:schema><xs:complexType name=\"KeyInfoType\"><xs:choice maxOccurs=\"unbounded\">"
            ++# "<xs:element name=\"KeyName\" type=\"xs:string\"/><xs:element name=\"MgmtData\" type=\"xs:string\"/>"
            ++# "</xs:choice></xs:complexType><xs:complexType name=\"X509DataType\">"
            ++# "<xs:sequence maxOccurs=\"unbounded\">"
            ++# "<xs:choice><xs:element name=\"X509SKI\" type=\"xs:string\"/><xs:element name=\"X509SubjectName\" "
            ++# "type=\"xs:string\"/></xs:choice></xs:sequence></xs:complexType>"
            ++# "<xs:complexType name=\"RegistroFacturaType\"><xs:choice><xs:element name=\"sf:RegistroAlta\" "
            ++# "type=\"xs:string\"/><xs:element name=\"sf:RegistroAnulacion\" "
            ++# "type=\"xs:string\"/></xs:choice></xs:complexType></xs:schema>"
        )
    := main, _ = generated_units schema
    ? sm'.contains "xml.claimed_children [\"KeyName\"; \"MgmtData\"] children" main = !-
    ?> failwith "each claimed child is read on its own, in document order"
    ? sm'.contains "xml.claimed_children [\"X509SKI\"; \"X509SubjectName\"] children" main = !-
    ?> failwith "a repeated sequence around one choice repeats the choice (xmldsig X509Data)"
    ? sm'.contains "        choice_registro_alta : x_registro_factura_type_choice" main = !-
    ?> failwith "a prefixed choice keeps its choice_ field name in the type (VeriFactu sf:RegistroAlta)"
    ? sm'.contains "        choice_registro_alta = x_registro_factura_type_choice" main = !-
    ?> failwith "the reader fills the same field the type declares"

///> rust
test restrictions_alias_parents_and_readers_apply_white_space_and_fixed =
    := schema =
        read_schema (
            "<xs:schema><xs:simpleType name=\"TString\"><xs:restriction base=\"xs:string\">"
            ++# "<xs:pattern value=\"[A-Z]+\"/></xs:restriction></xs:simpleType>"
            ++# "<xs:simpleType name=\"TServ\"><xs:restriction base=\"TString\"/></xs:simpleType>"
            ++# "<xs:simpleType name=\"TCode\"><xs:restriction base=\"xs:token\"><xs:pattern value=\"[A-Z]+\"/>"
            ++# "</xs:restriction></xs:simpleType><xs:simpleType name=\"TLine\"><xs:restriction base=\"xs:string\">"
            ++# "<xs:whiteSpace value=\"replace\"/><xs:maxLength value=\"9\"/>"
            ++# "</xs:restriction></xs:simpleType><xs:complexType name=\"TDoc\"><xs:attribute name=\"Version\" "
            ++# "type=\"xs:string\" use=\"required\" fixed=\"4.0\"/></xs:complexType></xs:schema>"
        )
    := main, _ = generated_units schema
    ? sm'.contains "type x_t_serv = x_t_string" main = !- ?> failwith "the restriction aliases its parent"
    ? sm'.contains "x_t_serv_of_string (s : string) : option x_t_serv = x_t_string_of_string s" main = !-
    ?> failwith "reading goes through the parent's validator"
    ? sm'.contains "match xml.collapsed_space s with s => if x_t_code_is_valid s" main = !-
    ?> failwith "a token restriction validates its collapsed value"
    ? sm'.contains "match xml.replaced_space s with s => if x_t_line_is_valid s" main = !-
    ?> failwith "an explicit whiteSpace facet wins over the base"
    ? sm'.contains "match xml.collapsed_space s with s => if x_t_string_is_valid" main
    ?> failwith "an xs:string restriction preserves its text"
    ? sm'.contains "xml.required_attribute \"Version\" (xml.checked_fixed \"Version\" \"4.0\" attributes)" main = !-
    ?> failwith "a fixed attribute reads through its check"

///> rust
test a_required_signature_stages_its_type_and_every_type_that_holds_it =
    := schema =
        read_schema (
            "<xs:schema><xs:complexType name=\"TDoc\"><xs:sequence><xs:element name=\"ID\" type=\"xs:string\"/>"
            ++# "<xs:element ref=\"ds:Signature\"/></xs:sequence></xs:complexType>"
            ++# "<xs:complexType name=\"TBatch\"><xs:sequence>"
            ++# "<xs:element name=\"Doc\" type=\"TDoc\" maxOccurs=\"unbounded\"/></xs:sequence></xs:complexType>"
            ++# "<xs:complexType name=\"TDraft\"><xs:sequence><xs:element name=\"ID\" type=\"xs:string\"/>"
            ++# "<xs:element ref=\"ds:Signature\" minOccurs=\"0\"/></xs:sequence></xs:complexType>"
            ++# "<xs:complexType name=\"TPlain\"><xs:sequence><xs:element name=\"Name\" type=\"xs:string\"/>"
            ++# "</xs:sequence></xs:complexType>"
            ++# "<xs:element name=\"Envelope\"><xs:complexType><xs:sequence><xs:element ref=\"ds:Signature\"/>"
            ++# "</xs:sequence></xs:complexType></xs:element></xs:schema>"
        )
    := names = staged_type_names ["Signature"] schema
    ? has_name (type_name "TDoc") names = !- ?> failwith "a required signature stages its type"
    ? has_name (type_name "TBatch") names = !- ?> failwith "a type that holds a staged type is staged too"
    ? has_name (type_name "Envelope") names = !- ?> failwith "an inline type with a required signature is staged"
    ? has_name (type_name "TDraft") names ?> failwith "an optional signature needs no stage"
    ? has_name (type_name "TPlain") names ?> failwith "a type without a signature is not staged"

///> rust
test staged_types_take_the_stage_and_pass_it_on =
    := schema =
        read_schema (
            "<xs:schema><xs:complexType name=\"TDoc\"><xs:sequence><xs:element name=\"ID\" type=\"xs:string\"/>"
            ++# "<xs:element ref=\"ds:Signature\"/></xs:sequence></xs:complexType>"
            ++# "<xs:complexType name=\"TBatch\"><xs:sequence>"
            ++# "<xs:element name=\"Doc\" type=\"TDoc\" maxOccurs=\"unbounded\"/></xs:sequence></xs:complexType>"
            ++# "<xs:complexType name=\"TDraft\"><xs:sequence><xs:element name=\"ID\" type=\"xs:string\"/>"
            ++# "<xs:element ref=\"ds:Signature\" minOccurs=\"0\"/></xs:sequence></xs:complexType>"
            ++# "<xs:complexType name=\"TPlain\"><xs:sequence><xs:element name=\"Name\" type=\"xs:string\"/>"
            ++# "</xs:sequence></xs:complexType></xs:schema>"
        )
    := staged = staged_type_names ["Signature"] schema
    := items = staged_items staged ["Signature"] (module_parts schema).items
    := text = join_lines (listm.map (\ (item : emitted) => item.text) items) ""
    := doc = type_name "TDoc"
    ? sm'.contains ("type " ++# doc ++# " s =\n") text = !- ?> failwith "a staged type takes the stage"
    ? sm'.contains (field_line "Signature" "staged s string" ++# "\n") text = !-
    ?> failwith "its signature is the staged slot"
    ? sm'.contains ("type " ++# type_name "TBatch" ++# " s =\n") text = !- ?> failwith "a container is staged too"
    ? sm'.contains (field_line "Doc" ("list (" ++# doc ++# " s)")) text = !-
    ?> failwith "a container passes the stage on"
    ? sm'.contains ("type " ++# type_name "TDraft" ++# " =\n") text = !-
    ?> failwith "an optional signature needs no stage"
    ? sm'.contains ("type " ++# type_name "TPlain" ++# " =\n") text = !- ?> failwith "an unsigned type is unchanged"
    ? sm'.contains "    | Present :: forall a. a -> staged signed a\n" (staging_prelude ()) = !-
    ?> failwith "one shared slot whose signed case holds the signature"

///> rust
test a_resolved_signature_and_a_referenced_signed_type_are_staged =
    := schema =
        read_schema (
            "<xs:schema><xs:element name=\"Signature\" type=\"SignatureType\"/>"
            ++# "<xs:complexType name=\"SignatureType\"><xs:sequence><xs:element name=\"Value\" type=\"xs:string\"/>"
            ++# "</xs:sequence></xs:complexType>"
            ++# "<xs:complexType name=\"TDoc\"><xs:sequence><xs:element name=\"ID\" type=\"xs:string\"/>"
            ++# "<xs:element ref=\"ds:Signature\"/></xs:sequence></xs:complexType>"
            ++# "<xs:element name=\"Doc\" type=\"TDoc\"/>"
            ++# "<xs:element name=\"Envelope\"><xs:complexType><xs:sequence><xs:element name=\"Set\"><xs:complexType>"
            ++# "<xs:sequence><xs:element ref=\"Doc\" maxOccurs=\"unbounded\"/></xs:sequence></xs:complexType>"
            ++# "</xs:element></xs:sequence></xs:complexType></xs:element></xs:schema>"
        )
    := staged = staged_type_names ["Signature"] schema
    ? has_name (type_name "Envelope_Set") staged = !-
    ?> failwith "an inline type named along its owners that holds a referenced signed type is staged"
    ? has_name (type_name "Envelope") staged = !- ?> failwith "and so is the element that holds it"
    := items = staged_items staged ["Signature"] (module_parts schema).items
    := text = join_lines (listm.map (\ (item : emitted) => item.text) items) ""
    ? sm'.contains (field_line "Signature" ("staged s " ++# type_name "SignatureType") ++# "\n") text = !-
    ?> failwith "a resolved signature element is the staged slot"
    ? sm'.contains (field_line "Doc" ("list (" ++# type_name "TDoc" ++# " s)")) text = !-
    ?> failwith "the inline set passes the stage on to the referenced documents"

///> rust
test staged_readers_take_the_witness_and_stage_the_signature =
    := schema =
        read_schema (
            "<xs:schema><xs:complexType name=\"TDoc\"><xs:sequence><xs:element name=\"ID\" type=\"xs:string\"/>"
            ++# "<xs:element ref=\"ds:Signature\"/></xs:sequence></xs:complexType>"
            ++# "<xs:complexType name=\"TBatch\"><xs:sequence>"
            ++# "<xs:element name=\"Doc\" type=\"TDoc\" maxOccurs=\"unbounded\"/></xs:sequence></xs:complexType>"
            ++# "<xs:complexType name=\"TPlain\"><xs:sequence><xs:element name=\"Name\" type=\"xs:string\"/>"
            ++# "</xs:sequence></xs:complexType></xs:schema>"
        )
    := staged = staged_type_names ["Signature"] schema
    := functions = join_lines (module_parts_with (StagedReading (staged, ["Signature"])) schema).functions ""
    := doc = type_name "TDoc"
    := plain = type_name "TPlain"
    ? sm'.contains ("and let " ++# doc ++# "_of_children forall s.") functions = !-
    ?> failwith "a staged type's reader takes the stage"
    ? sm'.contains "(witness : stage s)" functions = !- ?> failwith "and the stage's witness"
    ? sm'.contains "staged_of witness (fun () =>" functions = !- ?> failwith "the signature is read through the witness"
    ? sm'.contains (doc ++# "_of_xml witness c") functions = !- ?> failwith "a container passes the witness on"
    ? sm'.contains ("and let " ++# plain ++# "_of_children") functions = !- ?> failwith "an unsigned type still has a reader"
    ? sm'.contains (plain ++# "_of_children forall") functions ?> failwith "an unsigned type's reader takes no stage"
    ? sm'.contains "union stage s =\n" (staging_prelude ()) = !- ?> failwith "the prelude carries the stage witness"

///> rust
test staged_writers_write_any_stage_and_only_a_present_signature =
    := schema =
        read_schema (
            "<xs:schema><xs:complexType name=\"TDoc\"><xs:sequence><xs:element name=\"ID\" type=\"xs:string\"/>"
            ++# "<xs:element ref=\"ds:Signature\"/></xs:sequence></xs:complexType>"
            ++# "<xs:complexType name=\"TPlain\"><xs:sequence><xs:element name=\"Name\" type=\"xs:string\"/>"
            ++# "</xs:sequence></xs:complexType></xs:schema>"
        )
    := staged = staged_type_names ["Signature"] schema
    := functions = join_lines (module_parts_staged staged ["Signature"] schema).functions ""
    := doc = type_name "TDoc"
    := plain = type_name "TPlain"
    ? sm'.contains ("and let " ++# doc ++# "_to_xml forall s. (name : string) (x : " ++# doc ++# " s)") functions = !-
    ?> failwith "a staged writer writes a document at any stage (signing needs the unsigned XML)"
    ? sm'.contains "staged_list (fun v =>" functions = !- ?> failwith "the signature is written only when present"
    ? sm'.contains ("and let " ++# doc ++# "_of_children forall s.") functions = !-
    ?> failwith "the staged readers come with the staged writers"
    ? sm'.contains ("and let " ++# plain ++# "_to_xml (name : string) (x : " ++# plain ++# ")") functions = !-
    ?> failwith "an unsigned type keeps its plain writer"
    ? sm'.contains "inl staged_list forall s a b. (f : a -> b) (x : staged s a) : list b =" (staging_prelude ()) = !-
    ?> failwith "the prelude writes a pending slot as nothing"
    ? sm'.contains "inl signed_value forall a. (x : staged signed a) : a =" (staging_prelude ()) = !-
    ?> failwith "the prelude reads a signed slot without an unsigned case"

///> rust
test staged_examples_are_unsigned =
    := schema =
        read_schema (
            "<xs:schema><xs:complexType name=\"TDoc\"><xs:sequence><xs:element name=\"ID\" type=\"xs:string\"/>"
            ++# "<xs:element ref=\"ds:Signature\"/></xs:sequence></xs:complexType>"
            ++# "<xs:complexType name=\"TPlain\"><xs:sequence><xs:element name=\"Name\" type=\"xs:string\"/>"
            ++# "</xs:sequence></xs:complexType></xs:schema>"
        )
    := staged = staged_type_names ["Signature"] schema
    := functions = join_lines (module_parts_staged staged ["Signature"] schema).functions ""
    := doc = type_name "TDoc"
    := plain = type_name "TPlain"
    ? sm'.contains ("and let " ++# doc ++# "_example (k : i32) : " ++# doc ++# " unsigned =") functions = !-
    ?> failwith "a staged type's example is unsigned"
    ? sm'.contains "signature = Pending \"an unsigned example\"" functions = !- ?> failwith "its signature is pending"
    ? sm'.contains ("and let " ++# plain ++# "_example (k : i32) : " ++# plain ++# " =") functions = !-
    ?> failwith "an unsigned type's example is unchanged"

///> rust
test a_family_with_required_signatures_generates_staged_units =
    := signed =
        read_schema (
            "<xs:schema><xs:complexType name=\"TDoc\"><xs:sequence><xs:element name=\"ID\" type=\"xs:string\"/>"
            ++# "<xs:element ref=\"ds:Signature\"/></xs:sequence></xs:complexType></xs:schema>"
        )
    := main, _ = generated_units_signed ["Signature"] (untyped_any_content ()) signed
    := doc = type_name "TDoc"
    ? sm'.contains "union stage s =\n" main = !- ?> failwith "a signed family's unit carries the staging prelude"
    ? sm'.contains ("type " ++# doc ++# " s =\n") main = !- ?> failwith "its staged types take the stage"
    ? sm'.contains (doc ++# "_of_children forall s.") main = !- ?> failwith "its readers take the witness"
    := plain = read_schema "<xs:schema><xs:element name=\"Note\" type=\"xs:string\"/></xs:schema>"
    := unchanged, _ = generated_units_signed ["Signature"] (untyped_any_content ()) plain
    := before, _ = generated_units plain
    ? unchanged <> before ?> failwith "a family without required signatures generates exactly what it did before"
