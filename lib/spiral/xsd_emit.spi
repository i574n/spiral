///- --package .
:< sm'_operators
:< xsd

:= upper_letters () : string = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"

:= lower_letters () : string = "abcdefghijklmnopqrstuvwxyz"

:= alnum () : string = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789"

:= is_upper (c : string) : bool = sm'.index_of c (upper_letters ()) >= 0i32

:= is_lower (c : string) : bool = sm'.index_of c (lower_letters ()) >= 0i32

:= is_alnum (c : string) : bool = sm'.index_of c (alnum ()) >= 0i32

:~ ^ snake_from (s : string) (pos : i32) (previous_lower : bool) (previous_upper : bool) (acc : string) : string =
    ? pos >= sm'.length s ?> acc
    |:
        := c = xml.code_point_text s pos
        := after = pos + sm'.length c
        := next_lower = after < sm'.length s && is_lower (xml.code_point_text s after)
        := piece =
            ? is_upper c ?> (? previous_lower || (previous_upper && next_lower) ?> "_" |: "") ++# sm'.to_lower c
            |? is_alnum c ?> c
            |: "_"
        snake_from s after (is_lower c || (sm'.index_of c "0123456789" >= 0i32)) (is_upper c) (acc ++# piece)

:= type_name (xsd_name : string) : string = "x_" ++# snake_from xsd_name 0i32 !- !- ""

:~ ^ has_name (target : string) (items : list string) : bool =
    ?= items ?|
    | x :: rest => x = target || has_name target rest
    | Nil => !-

:= spiral_keywords () : list string =
    [
        "and"
        "as"
        "elif"
        "else"
        "false"
        "forall"
        "fun"
        "function"
        "global"
        "if"
        "in"
        "inl"
        "instance"
        "let"
        "match"
        "module"
        "nominal"
        "open"
        "or"
        "prototype"
        "rec"
        "then"
        "true"
        "type"
        "union"
        "when"
        "with"
    ]

:= field_name (xsd_name : string) : string =
    := name = snake_from xsd_name 0i32 !- !- ""
    ? has_name name (spiral_keywords ()) ?> name ++# "_value" |: name

:~ ^ case_from (s : string) (pos : i32) (acc : string) : string =
    ? pos >= sm'.length s ?> acc
    |:
        := c = xml.code_point_text s pos
        case_from s (pos + sm'.length c) (acc ++# (? is_alnum c ?> c |: "_"))

:= capitalized (s : string) : string =
    ? sm'.length s > 0i32 && is_upper (xml.code_point_text s 0i32) ?> s |: "X" ++# s

:= uri_tail (value : string) : string =
    := length : i32 = sm'.length value
    := hash = sm'.last_index_of "#" value
    ? hash >= 0i32 ?> sm'.substring (hash + 1i32) (length - hash - 1i32) value
    |:
        := trimmed = ? sm'.ends_with "/" value ?> sm'.substring 0i32 (length - 1i32) value |: value
        := trimmed_length : i32 = sm'.length trimmed
        := slash = sm'.last_index_of "/" trimmed
        sm'.substring (slash + 1i32) (trimmed_length - slash - 1i32) trimmed

:= case_value (value : string) : string = ? sm'.contains "://" value ?> uri_tail value |: value

:= case_name (owner : string) (value : string) : string =
    capitalized (case_from owner 0i32 "") ++# "_" ++# case_from (case_value value) 0i32 ""

:~ ^ distinct_values (values : list string) (seen : list string) (acc : list string) : list string =
    ?= values ?|
    | v :: rest =>
        ? has_name v seen ?> distinct_values rest seen acc |: distinct_values rest (v :: seen) (v :: acc)
    | Nil => reverse acc Nil

:~ ^ enumeration_values (facets : list xsd_facet) (acc : list string) : list string =
    ?= facets ?|
    | Enumeration value :: rest => enumeration_values rest (value :: acc)
    | _ :: rest => enumeration_values rest acc
    | Nil => reverse acc Nil

:= escape_text (s : string) : string = s |> sm'.replace "\\" "\\\\" |> sm'.replace "\"" "\\\""

:~ ^ join_lines (lines : list string) (acc : string) : string =
    ?= lines ?|
    | line :: rest => join_lines rest (acc ++# line ++# "\n")
    | Nil => acc

:~ ^ map_strings (f : string -> string) (items : list string) (acc : list string) : list string =
    ?= items ?|
    | x :: rest => map_strings f rest (f x :: acc)
    | Nil => reverse acc Nil

:~ ^ unused_case (candidate : string) (used : list string) : string =
    ? has_name candidate used ?> unused_case (candidate ++# "_") used |: candidate

:~ ^ value_cases
    (owner : string) (values : list string) (used : list string) (acc : list (string * string))
    : list (string * string)
    =
    ?= values ?|
    | v :: rest =>
        := case = unused_case (case_name owner v) used
        value_cases owner rest (case :: used) ((v, case) :: acc)
    | Nil => reverse acc Nil

:~ ^ case_lines
    (pairs : list (string * string)) (line : string -> string -> string) (acc : list string)
    : list string
    =
    ?= pairs ?|
    | (v, case) :: rest => case_lines rest line (line v case :: acc)
    | Nil => reverse acc Nil

:= digit_text (d : i32) : string = sm'.substring d 1i32 "0123456789"

:~ ^ digits_text (n : i32) (acc : string) : string =
    ? n < 10i32 ?> digit_text n ++# acc |: digits_text (n / 10i32) (digit_text (n % 10i32) ++# acc)

:= int_text (n : i32) : string = ? n < 0i32 ?> "-" ++# digits_text (0i32 - n) "" |: digits_text n ""

:~ ^ take_items \* t. (count : i32) (items : list t) : list t =
    ?= items ?|
    | x :: rest => ? count <= 0i32 ?> Nil |: x :: take_items (count - 1i32) rest
    | Nil => Nil

:~ ^ variant_arms (pairs : list (string * string)) (count : i32) (index : i32) (acc : string) : string =
    ?= pairs ?|
    | (_, last_case) :: Nil => acc ++# (? index = 0i32 ?> "    " |: "    else ") ++# last_case ++# "\n"
    | (_, variant_case) :: rest =>
        := keyword = ? index = 0i32 ?> "    if" |: "    elif"
        variant_arms rest count
            (index + 1i32)
            (acc ++# keyword ++# " index = " ++# int_text index ++# "i32 then " ++# variant_case ++# "\n")
    | Nil => acc

:= union_text (name : string) (values : list string) : string =
    := ty = type_name name
    := pairs = value_cases name values Nil Nil
    := cases = case_lines pairs (\ _ case => "    | " ++# case) Nil
    := parse_arms =
        case_lines pairs (\ v case => "    | \"" ++# escape_text v ++# "\" => Some " ++# case) Nil
    := print_arms = case_lines pairs (\ v case => "    | " ++# case ++# " => \"" ++# escape_text v ++# "\"") Nil
    := union_part = join_lines ("union " ++# ty ++# " =" :: cases) ""
    := parse_part =
        join_lines
            (
                "inl " ++# ty ++# "_of_string (s : string) : option " ++# ty ++# " ="
                :: "    match s with"
                :: parse_arms
            )
            ""
    := print_part =
        join_lines
            ("inl " ++# ty ++# "_to_string (x : " ++# ty ++# ") : string =" :: "    match x with" :: print_arms)
            ""
    := example_part =
        ?= pairs ?|
        | _ :: _ =>
            := variants = take_items 8i32 pairs
            := count = count_list variants
            := arms = variant_arms variants count 0i32 ""
            "\ninl "
            ++# ty
            ++# "_example (k : i32) : "
            ++# ty
            ++# " =\n    inl index = ((k % "
            ++# int_text count
            ++# "i32) + "
            ++# int_text count
            ++# "i32) % "
            ++# int_text count
            ++# "i32\n"
            ++# arms
            ++# "\ninl "
            ++# ty
            ++# "_example_text (k : i32) : string = "
            ++# ty
            ++# "_to_string ("
            ++# ty
            ++# "_example k)\n"
        | Nil => ""
    union_part ++# "\n" ++# parse_part ++# "    | _ => None\n\n" ++# print_part ++# example_part

:= union_value_limit () : i32 = 256i32

:~ ^ example_pairs (ty : string) (values : list string) (acc : list (string * string)) : list (string * string) =
    ?= values ?|
    | v :: rest =>
        := case = ty ++# " \"" ++# escape_text v ++# "\""
        example_pairs ty rest ((v, case) :: acc)
    | Nil => reverse acc Nil

:= coded_text (name : string) (table : string) (values : list string) : string =
    := ty = type_name name
    := examples = example_pairs ty (take_items 8i32 values) Nil
    := count = count_list examples
    "nominal "
    ++# ty
    ++# " = string\n\n"
    ++# "inl "
    ++# ty
    ++# "_table () : string = \""
    ++# (escape_text table |> sm'.replace "\n" "\\n")
    ++# "\"\n\n"
    ++# "inl "
    ++# ty
    ++# "_of_string (s : string) : option "
    ++# ty
    ++# " =\n"
    ++# "    if xsd_regex.table_matches ("
    ++# ty
    ++# "_table ()) s then Some ("
    ++# ty
    ++# " s) else None\n\n"
    ++# "inl "
    ++# ty
    ++# "_to_string (x : "
    ++# ty
    ++# ") : string = match x with "
    ++# ty
    ++# " s => s\n\n"
    ++# "inl "
    ++# ty
    ++# "_example (k : i32) : "
    ++# ty
    ++# " =\n    inl index = ((k % "
    ++# int_text count
    ++# "i32) + "
    ++# int_text count
    ++# "i32) % "
    ++# int_text count
    ++# "i32\n"
    ++# variant_arms examples count 0i32 ""
    ++# "\ninl "
    ++# ty
    ++# "_example_text (k : i32) : string = "
    ++# ty
    ++# "_to_string ("
    ++# ty
    ++# "_example k)\n"

:~ ^ join_with (separator : string) (items : list string) (acc : string) : string =
    ?= items ?|
    | item :: rest => join_with separator rest (? acc = "" ?> item |: acc ++# separator ++# item)
    | Nil => acc

:= u32_text (n : u32) : string = int_text (conv n : i32)

:~ ^ range_tests
    (moves : list xsd_regex.dfa_move) (function_name : string) (keyword : string) (acc : string)
    : string
    =
    ?= moves ?|
    | move :: rest =>
        := test =
            ? move.low = move.high ?> "c = " ++# u32_text move.low ++# "u32"
            |: u32_text move.low ++# "u32 <= c && c <= " ++# u32_text move.high ++# "u32"
        := arm =
            "            "
            ++# keyword
            ++# " "
            ++# test
            ++# " then "
            ++# function_name
            ++# " "
            ++# int_text move.target
            ++# "i32 s next\n"
        range_tests rest function_name "elif" (acc ++# arm)
    | Nil => ? acc = "" ?> "            false\n" |: acc ++# "            else false\n"

:~ ^ state_arms (rows : list xsd_regex.dfa_state) (function_name : string) (index : i32) (acc : string) : string =
    ?= rows ?|
    | row :: rest =>
        := keyword = ? index = 0i32 ?> "        if" |: "        elif"
        := arm =
            keyword ++# " state = " ++# int_text index ++# "i32 then\n" ++# range_tests row.moves function_name "if" ""
        state_arms rest function_name (index + 1i32) (acc ++# arm)
    | Nil => acc ++# "        else false\n"

:~ ^ accepting_states (rows : list xsd_regex.dfa_state) (index : i32) (acc : string) : string =
    ?= rows ?|
    | row :: rest =>
        := acc =
            ? row.accepting ?> (? acc = "" ?> "" |: acc ++# " || ") ++# "state = " ++# int_text index ++# "i32"
            |: acc
        accepting_states rest (index + 1i32) acc
    | Nil => ? acc = "" ?> "false" |: acc

:= dfa_function_text (function_name : string) (rows : list xsd_regex.dfa_state) : string =
    "let rec " ++# function_name ++# " (state : i32) (s : string) (i : i32) : bool =\n"
    ++# "    if i >= sm'.length s then " ++# accepting_states rows 0i32 "" ++# "\n"
    ++# "    else\n"
    ++# "        inl c = xml.code_point_at s i\n"
    ++# "        inl next = i + xml.code_point_width s i\n"
    ++# state_arms rows function_name 0i32 ""

:= direct_coded_state_limit () : i32 = 128i32

:= direct_coded_dfa (p : string) : option (list xsd_regex.dfa_state) =
    xsd_regex.dfa_of_pattern_within (direct_coded_state_limit ()) p

:~ ^ fnv_from (s : string) (i : i32) (h : u64) : u64 =
    ? i >= sm'.length s ?> h
    |:
        fnv_from s
            (i + xml.code_point_width s i)
            (((h ^^^ (conv (xml.code_point_at s i) : u64)) * 16777619u64) &&& 4294967295u64)

:~ ^ hex_text (n : u64) (digits : i32) (acc : string) : string =
    ? digits <= 0i32 ?> acc
    |:
        hex_text (n >>> 4i32) (digits - 1i32) (sm'.substring (conv (n &&& 15u64) : i32) 1i32 "0123456789abcdef" ++# acc)

:= pattern_function_name (p : string) : string =
    "xsd_pattern_" ++# hex_text (fnv_from p 0i32 2166136261u64) 8i32 "" ++# "_" ++# int_text (sm'.length p)

:== emitted = { name : string; references : list string; text : string; enumeration_key : string }

:== pattern_code = { functions : list emitted; checks : list string; references : list string }

:= emit_enumeration (name : string) (values : list string) : emitted =
    ? count_list values > union_value_limit () ?>
        := table = xsd_regex.dfa_table_text (xsd_regex.dfa_of_values values)
        {
            name = type_name name
            references = Nil
            text = coded_text name table values
            enumeration_key = "dfa\n" ++# table
        }
    |:
        := values = distinct_values values Nil Nil
        {
            name = type_name name
            references = Nil
            text = union_text name values
            enumeration_key = "union\n" ++# join_lines values ""
        }

:~ ^ pattern_checks (facets : list xsd_facet) (acc : pattern_code) : pattern_code =
    ?= facets ?|
    | Pattern p :: rest =>
        ?= direct_coded_dfa p ?|
        | Some rows =>
            := function_name = pattern_function_name p
            := state_function =
                {
                    name = function_name
                    references = Nil
                    text = dfa_function_text function_name rows
                    enumeration_key = ""
                }
            pattern_checks rest {
                functions = (state_function :: acc.functions)
                checks = ((function_name ++# " 0i32 s 0i32") :: acc.checks)
                references = (function_name :: acc.references)
            }
        | None =>
            ?= xsd_regex.dfa_of_pattern p ?|
            | Some rows =>
                := table_name = pattern_function_name p ++# "_table"
                := table_text =
                    "inl "
                    ++# table_name
                    ++# " () : string = \""
                    ++# (escape_text (xsd_regex.dfa_table_text rows) |> sm'.replace "\n" "\\n")
                    ++# "\"\n"
                := table_function = { name = table_name; references = Nil; text = table_text; enumeration_key = "" }
                pattern_checks rest {
                    functions = (table_function :: acc.functions)
                    checks = (("xsd_regex.table_matches (" ++# table_name ++# " ()) s") :: acc.checks)
                    references = (table_name :: acc.references)
                }
            | None =>
                pattern_checks rest { acc ?|
                    checks = (("xsd_regex.pattern_matches \"" ++# escape_text p ++# "\" s") :: acc.checks)
                }
    | _ :: rest => pattern_checks rest acc
    | Nil => { acc ?| checks = reverse acc.checks Nil }

:~ ^ length_checks (facets : list xsd_facet) (acc : list string) : list string =
    ?= facets ?|
    | Length n :: rest => length_checks rest ("xml.code_point_count s = " ++# int_text n :: acc)
    | MinLength n :: rest => length_checks rest ("xml.code_point_count s >= " ++# int_text n :: acc)
    | MaxLength n :: rest => length_checks rest ("xml.code_point_count s <= " ++# int_text n :: acc)
    | _ :: rest => length_checks rest acc
    | Nil => reverse acc Nil

:= validator_text (name : string) (code : pattern_code) (facets : list xsd_facet) : string =
    := pattern_part =
        ?= code.checks ?|
        | Nil => "true"
        | patterns => "(" ++# join_with " || " patterns "" ++# ")"
    := length_part =
        ?= length_checks facets Nil ?|
        | Nil => "true"
        | lengths => join_with " && " lengths ""
    "inl "
    ++# type_name name
    ++# "_is_valid (s : string) : bool = "
    ++# pattern_part
    ++# " && "
    ++# length_part
    ++# "\n"

:== collected = { fields : list string; references : list string; extra : list emitted }

:= is_builtin_reference (reference : string) : bool = reference = "" || xsd_resolve.is_builtin reference

:= reference_type (reference : string) : string =
    ? is_builtin_reference reference ?> "string" |: type_name (xml.local_name reference)

:= reference_dependency (reference : string) : list string =
    ? is_builtin_reference reference ?> Nil |: type_name (xml.local_name reference) :: Nil

:= with_occurs (min : i32) (max : i32) (t : string) : string =
    ? max = 1i32 ?> (? min = 0i32 ?> "option (" ++# t ++# ")" |: t) |: "list (" ++# t ++# ")"

:= field_line (name : string) (t : string) : string = "        " ++# field_name name ++# " : " ++# t

:= line_width () : i32 = 120i32

:= field_assignment (field : string) (expression : string) : string =
    := one_line = "        " ++# field ++# " = " ++# expression
    ? sm'.length one_line <= line_width () ?> one_line
    |: "        " ++# field ++# " =\n            " ++# expression

:= fitted_definition (head : string) (body : string) : string =
    := one_line = head ++# " " ++# body
    ? sm'.length one_line <= line_width () ?> one_line ++# "\n" |: head ++# "\n    " ++# body ++# "\n"

:= fitted_header (name : string) (parameters : string) (result : string) : string =
    := one_line = name ++# " " ++# parameters ++# " : " ++# result ++# " ="
    ? sm'.length one_line <= line_width () ?> one_line ++# "\n"
    |: name ++# "\n    " ++# parameters ++# "\n    : " ++# result ++# "\n    =\n"

:~ ^ patterns_accept (facets : list xsd_facet) (s : string) (matched : bool) (none_seen : bool) : bool =
    ?= facets ?|
    | Pattern p :: rest => patterns_accept rest s (matched || xsd_regex.pattern_matches p s) !-
    | _ :: rest => patterns_accept rest s matched none_seen
    | Nil => matched || none_seen

:~ ^ lengths_accept (facets : list xsd_facet) (s : string) : bool =
    ?= facets ?|
    | Length n :: rest => xml.code_point_count s = n && lengths_accept rest s
    | MinLength n :: rest => xml.code_point_count s >= n && lengths_accept rest s
    | MaxLength n :: rest => xml.code_point_count s <= n && lengths_accept rest s
    | _ :: rest => lengths_accept rest s
    | Nil => !+

:~ ^ first_pattern (facets : list xsd_facet) : option string =
    ?= facets ?|
    | Pattern p :: _ => Some p
    | _ :: rest => first_pattern rest
    | Nil => None

:~ ^ has_length_facet (facets : list xsd_facet) : bool =
    ?= facets ?|
    | Length _ :: _ => !+
    | MinLength _ :: _ => !+
    | MaxLength _ :: _ => !+
    | _ :: rest => has_length_facet rest
    | Nil => !-

:~ ^ min_length (facets : list xsd_facet) : i32 =
    ?= facets ?|
    | Length n :: _ => n
    | MinLength n :: _ => n
    | _ :: rest => min_length rest
    | Nil => 1i32

:~ ^ example_search (facets : list xsd_facet) (r : xsd_regex.rx) (stars : i32) : string =
    ? stars > 64i32 ?> xsd_regex.example_with 1i32 r
    |:
        := candidate = xsd_regex.example_with stars r
        ? patterns_accept facets candidate !- !+ && lengths_accept facets candidate ?> candidate
        |: example_search facets r (stars + 1i32)

:= builtin_example (reference : string) : string =
    := local = xml.local_name reference
    ? local = "base64Binary" ?> "AAAA"
    |? local = "anyURI" ?> "http://example.com"
    |? local = "ID" ?> "ID1"
    |? local = "dateTime" ?> "2026-01-01T00:00:00"
    |? local = "date" ?> "2026-01-01"
    |? local = "boolean" ?> "true"
    |: "1"

:= simple_example (base : string) (facets : list xsd_facet) : string =
    ?= first_pattern facets ?|
    | Some p =>
        ?= xsd_regex.compile_pattern p ?|
        | Some r => example_search facets r 0i32
        | None => "1"
    | None =>
        ? is_builtin_reference base ?>
            := text = builtin_example base
            ? xml.code_point_count text >= min_length facets ?> text |: xsd_regex.repeated "1" (min_length facets)
        |: xsd_regex.repeated "1" (? min_length facets < 1i32 ?> 1i32 |: min_length facets)

:~ ^ first_element_name (items : list xsd) : string =
    ?= items ?|
    | Element (name, _, _, _, _) :: _ => name
    | Sequence (_, _, inner) :: rest => first_in_group inner rest
    | Choice (_, _, inner) :: rest => first_in_group inner rest
    | _ :: rest => first_element_name rest
    | Nil => "empty"

:& :~ first_in_group (inner : list xsd) (rest : list xsd) : string =
    ?= inner ?|
    | Nil => first_element_name rest
    | _ => first_element_name inner

:~ ^ emit_named (name : string) (item : xsd) : list emitted =
    ?= item ?|
    | Simple (_, base, facets) =>
        ?= enumeration_values facets Nil ?|
        | Nil =>
            := ty = type_name name
            := inherits =
                is_builtin_reference base = !-
                && (?= first_pattern facets ?| Some _ => !- | None => !+)
                && has_length_facet facets = !-
            := example =
                ? inherits
                ?> "inl " ++# ty ++# "_example (k : i32) : string = " ++# reference_type base ++# "_example_text k\n"
                |:
                    "inl "
                    ++# ty
                    ++# "_example (_ : i32) : string = \""
                    ++# escape_text (simple_example base facets)
                    ++# "\"\n"
            := example_text = "\ninl " ++# ty ++# "_example_text (k : i32) : string = " ++# ty ++# "_example k\n"
            := code = pattern_checks facets { functions = Nil; checks = Nil; references = Nil }
            := references = listm.append (? inherits ?> reference_dependency base |: Nil) code.references
            {
                name = ty
                references = references
                text =
                    "type "
                    ++# ty
                    ++# " = string\n\n"
                    ++# validator_text name code facets
                    ++# "\n"
                    ++# example
                    ++# example_text
                enumeration_key = ""
            }
            :: code.functions
        | values => emit_enumeration name values :: Nil
    | Complex (_, content, attributes) => emit_record name content attributes Nil Nil
    | Derived (_, base, content, attributes) =>
        emit_record name content attributes (field_line "base" (reference_type base) :: Nil) (reference_dependency base)
    | Sequence _ => emit_record name item Nil Nil Nil
    | _ => Nil

:& :~ emit_record
    (name : string) (content : xsd) (attributes : list xsd) (prefix_fields : list string)
    (prefix_references : list string)
    : list emitted
    =
    := (gathered : collected) =
        collect_attributes name attributes (
            collect_content name content { fields = Nil; references = Nil; extra = Nil }
        )
    := fields = listm.append prefix_fields (reverse gathered.fields Nil)
    := ty = type_name name
    := text =
        ?= fields ?|
        | Nil => "type " ++# ty ++# " = ()\n"
        | _ => "type " ++# ty ++# " =\n    {\n" ++# join_lines fields "" ++# "    }\n"
    { name = ty; references = listm.append prefix_references gathered.references; text = text; enumeration_key = "" }
    :: gathered.extra

:& :~ collect_content (owner : string) (item : xsd) (acc : collected) : collected =
    ?= item ?|
    | Sequence (_, _, items) => collect_items owner items acc
    | Choice (min, max, items) =>
        := choice_name = owner ++# "_choice_" ++# first_element_name items
        := union_emitted = emit_choice choice_name items
        {
            fields =
                field_line ("choice_" ++# first_element_name items) (with_occurs min max (type_name choice_name))
                :: acc.fields
            references = type_name choice_name :: acc.references
            extra = listm.append union_emitted acc.extra
        }
    | Element (name, type_reference, min, max, inline) =>
        ?= inline ?|
        | Some inner =>
            := inner_name = owner ++# "_" ++# name
            {
                fields = field_line name (with_occurs min max (type_name inner_name)) :: acc.fields
                references = type_name inner_name :: acc.references
                extra = listm.append (emit_named inner_name inner) acc.extra
            }
        | None =>
            {
                fields = field_line name (with_occurs min max (reference_type type_reference)) :: acc.fields
                references = listm.append (reference_dependency type_reference) acc.references
                extra = acc.extra
            }
    | AnyContent =>
        {
            fields = field_line "any" "list xml.xml_node" :: acc.fields
            references = acc.references
            extra = acc.extra
        }
    | _ => acc

:& :~ collect_items (owner : string) (items : list xsd) (acc : collected) : collected =
    ?= items ?|
    | item :: rest => collect_items owner rest (collect_content owner item acc)
    | Nil => acc

:& :~ emit_choice (choice_name : string) (items : list xsd) : list emitted =
    := (cases : collected) = choice_cases choice_name items { fields = Nil; references = Nil; extra = Nil }
    := ty = type_name choice_name
    := text = join_lines ("union " ++# ty ++# " =" :: reverse cases.fields Nil) ""
    { name = ty; references = cases.references; text = text; enumeration_key = "" } :: cases.extra

:& :~ choice_cases (choice_name : string) (items : list xsd) (acc : collected) : collected =
    ?= items ?|
    | Element (name, type_reference, min, max, inline) :: rest =>
        := case_label = "    | " ++# case_name choice_name name ++# " : "
        ?= inline ?|
        | Some inner =>
            := inner_name = choice_name ++# "_" ++# name
            choice_cases choice_name rest
                {
                    fields = case_label ++# with_occurs min max (type_name inner_name) :: acc.fields
                    references = type_name inner_name :: acc.references
                    extra = listm.append (emit_named inner_name inner) acc.extra
                }
        | None =>
            choice_cases choice_name rest
                {
                    fields = case_label ++# with_occurs min max (reference_type type_reference) :: acc.fields
                    references = listm.append (reference_dependency type_reference) acc.references
                    extra = acc.extra
                }
    | Sequence (group_min, group_max, group_items) :: rest =>
        := group_name = choice_name ++# "_group_" ++# first_element_name group_items
        choice_cases choice_name rest {
            fields =
                "    | "
                ++# case_name choice_name ("group_" ++# first_element_name group_items)
                ++# " : "
                ++# type_name group_name
                :: acc.fields
            references = type_name group_name :: acc.references
            extra = listm.append (emit_named group_name (Sequence (group_min, group_max, group_items))) acc.extra
        }
    | _ :: rest => choice_cases choice_name rest acc
    | Nil => acc

:& :~ collect_attributes (owner : string) (attributes : list xsd) (acc : collected) : collected =
    ?= attributes ?|
    | Attribute (name, type_reference, required, _, inline) :: rest =>
        := inner_name = owner ++# "_" ++# name
        := t = ?= inline ?| Some _ => type_name inner_name | None => reference_type type_reference
        := references =
            ?= inline ?|
            | Some _ => type_name inner_name :: Nil
            | None => reference_dependency type_reference
        := extra = ?= inline ?| Some inner => emit_named inner_name inner | None => Nil
        collect_attributes owner rest
            {
                fields = field_line name (? required ?> t |: "option (" ++# t ++# ")") :: acc.fields
                references = listm.append references acc.references
                extra = listm.append extra acc.extra
            }
    | _ :: rest => collect_attributes owner rest acc
    | Nil => acc

:= emit_item (item : xsd) : list emitted =
    ?= item ?|
    | Simple (name, _, _) => emit_named name item
    | Complex (name, _, _) => emit_named name item
    | Derived (name, _, _, _) => emit_named name item
    | Element (name, _, _, _, Some inner) => emit_named name inner
    | _ => Nil

:~ ^ emit_types (types : list xsd) (acc : list emitted) : list emitted =
    ?= types ?|
    | item :: rest => emit_types rest (listm.append (emit_item item) acc)
    | Nil => acc

:~ ^ emitted_names (items : list emitted) (acc : list string) : list string =
    ?= items ?|
    | item :: rest => emitted_names rest (item.name :: acc)
    | Nil => acc

:~ ^ unique_emitted (items : list emitted) (seen : list string) (acc : list emitted) : list emitted =
    ?= items ?|
    | item :: rest =>
        ? has_name item.name seen ?> unique_emitted rest seen acc
        |: unique_emitted rest (item.name :: seen) (item :: acc)
    | Nil => reverse acc Nil

:~ ^ references_ready (references : list string) (done_names : list string) : bool =
    ?= references ?|
    | reference :: rest => has_name reference done_names && references_ready rest done_names
    | Nil => !+

:~ ^ known_references (references : list string) (known : list string) (acc : list string) : list string =
    ?= references ?|
    | reference :: rest => known_references rest known (? has_name reference known ?> (reference :: acc) |: acc)
    | Nil => reverse acc Nil

:~ ^ with_known_references (items : list emitted) (known : list string) (acc : list emitted) : list emitted =
    ?= items ?|
    | item :: rest =>
        with_known_references rest known ({ item ?| references = known_references item.references known Nil } :: acc)
    | Nil => reverse acc Nil

:~ ^ order_pass
    (pending : list emitted) (known : list string) (done_names : list string) (ordered : list emitted)
    (deferred : list emitted)
    : list string * list emitted * list emitted
    =
    ?= pending ?|
    | item :: rest =>
        ? references_ready item.references done_names
        ?> order_pass rest known (item.name :: done_names) (item :: ordered) deferred
        |: order_pass rest known done_names ordered (item :: deferred)
    | Nil => done_names, ordered, reverse deferred Nil

:~ ^ order_emitted
    (pending : list emitted) (known : list string) (done_names : list string) (ordered : list emitted)
    : list emitted
    =
    ?= pending ?|
    | Nil => reverse ordered Nil
    | _ =>
        := done_names', ordered', deferred = order_pass pending known done_names ordered Nil
        ? count_list deferred = count_list pending ?> listm.append (reverse ordered' Nil) deferred
        |: order_emitted deferred known done_names' ordered'

:~ ^ item_texts (items : list emitted) (acc : list string) : list string =
    ?= items ?|
    | item :: rest => item_texts rest (item.text ++# "\n" :: acc)
    | Nil => reverse acc Nil

:= texts_of (items : list emitted) : string = sm'.concat_balanced "" (item_texts items Nil)

:~ ^ root_element (target : string) (roots : list xsd) : option xsd =
    ?= roots ?|
    | Element (name, root_type, min, max, inline) :: rest =>
        ? name = target ?> Some (Element (name, root_type, min, max, inline)) |: root_element target rest
    | _ :: rest => root_element target rest
    | Nil => None

:~ ^ dereference (roots : list xsd) (item : xsd) : xsd =
    ?= item ?|
    | Element (name, type_reference, min, max, inline) => dereference_element roots name type_reference min max inline
    | Complex (name, content, attributes) => Complex (name, dereference roots content, attributes)
    | Derived (name, base, content, attributes) => Derived (name, base, dereference roots content, attributes)
    | Sequence (min, max, items) => Sequence (min, max, dereference_items roots items Nil)
    | Choice (min, max, items) => Choice (min, max, dereference_items roots items Nil)
    | _ => item

:& :~ dereference_element
    (roots : list xsd) (name : string) (type_reference : string) (min : i32) (max : i32) (inline : option xsd)
    : xsd
    =
    ?= inline ?|
    | Some inner => Element (name, type_reference, min, max, Some (dereference roots inner))
    | None =>
        ? type_reference <> "" ?> Element (name, type_reference, min, max, None)
        |:
            ?= root_element (xml.local_name name) roots ?|
            | Some (Element (root_name, root_type, _, _, root_inline)) =>
                Element (root_name, root_type, min, max, root_inline)
            | _ => Element (name, type_reference, min, max, None)

:& :~ dereference_items (roots : list xsd) (items : list xsd) (acc : list xsd) : list xsd =
    ?= items ?|
    | item :: rest => dereference_items roots rest (dereference roots item :: acc)
    | Nil => reverse acc Nil

:~ ^ first_with_key (key : string) (items : list emitted) : option string =
    ?= items ?|
    | item :: rest => ? item.enumeration_key = key ?> Some item.name |: first_with_key key rest
    | Nil => None

:= shared_union_text (name : string) (first : string) : string =
    "type " ++# name ++# " = " ++# first ++# "\n\n"
    ++# "inl " ++# name ++# "_of_string (s : string) : option " ++# name ++# " = " ++# first ++# "_of_string s\n\n"
    ++# "inl " ++# name ++# "_to_string (x : " ++# name ++# ") : string = " ++# first ++# "_to_string x\n\n"
    ++# "inl " ++# name ++# "_example (k : i32) : " ++# name ++# " = " ++# first ++# "_example k\n\n"
    ++# "inl " ++# name ++# "_example_text (k : i32) : string = " ++# first ++# "_example_text k\n"

:~ ^ share_unions (items : list emitted) (kept : list emitted) (acc : list emitted) : list emitted =
    ?= items ?|
    | item :: rest =>
        ? item.enumeration_key = "" ?> share_unions rest kept (item :: acc)
        |:
            ?= first_with_key item.enumeration_key kept ?|
            | Some first =>
                := shared =
                    {
                        name = item.name
                        references = (first :: Nil)
                        text = shared_union_text item.name first
                        enumeration_key = ""
                    }
                share_unions rest kept (shared :: acc)
            | None => share_unions rest (item :: kept) (item :: acc)
    | Nil => reverse acc Nil

:| type_kind =
    | KindText
    | KindEnum
    | KindRecord

:= simple_kind (facets : list xsd_facet) : type_kind =
    ?= enumeration_values facets Nil ?|
    | Nil => KindText
    | _ => KindEnum

:~ ^ kinds_of (types : list xsd) (acc : list (string * type_kind)) : list (string * type_kind) =
    ?= types ?|
    | Simple (name, _, facets) :: rest => kinds_of rest ((type_name name, simple_kind facets) :: acc)
    | Complex (name, _, _) :: rest => kinds_of rest ((type_name name, KindRecord) :: acc)
    | Derived (name, _, _, _) :: rest => kinds_of rest ((type_name name, KindRecord) :: acc)
    | _ :: rest => kinds_of rest acc
    | Nil => acc

:~ ^ kind_lookup (target : string) (kinds : list (string * type_kind)) : type_kind =
    ?= kinds ?|
    | (name, kind) :: rest => ? name = target ?> kind |: kind_lookup target rest
    | Nil => KindText

:= reference_kind (reference : string) (kinds : list (string * type_kind)) : type_kind =
    ? is_builtin_reference reference ?> KindText |: kind_lookup (type_name (xml.local_name reference)) kinds

:= inline_kind (inner : xsd) : type_kind =
    ?= inner ?|
    | Simple (_, _, facets) => simple_kind facets
    | _ => KindRecord

:= node_expression (kind : type_kind) (t : string) : string =
    ?= kind ?|
    | KindText => "xml.text_in (xml.element_children c)"
    | KindEnum =>
        "xml.required_value \"" ++# t ++# "\" (" ++# t ++# "_of_string (xml.text_in (xml.element_children c)))"
    | KindRecord => t ++# "_of_xml c"

:= occurs_expression (name : string) (min : i32) (max : i32) (body : string) : string =
    := lambda = "(fun c => " ++# body ++# ")"
    ? max = 1i32 ?>
        ? min = 0i32 ?> "optionm.map " ++# lambda ++# " (xml.first_child \"" ++# name ++# "\" children)"
        |: lambda ++# " (xml.required_child \"" ++# name ++# "\" children)"
    |: "listm.map " ++# lambda ++# " (xml.children_named \"" ++# name ++# "\" children)"

:= quoted_name (acc : string) (name : string) : string =
    ? acc = "" ?> "\"" ++# name ++# "\"" |: acc ++# "; \"" ++# name ++# "\""

:~ ^ choice_names (items : list xsd) (acc : string) : string =
    ?= items ?|
    | Element (name, _, _, _, _) :: rest => choice_names rest (quoted_name acc name)
    | Sequence (_, _, group_items) :: rest => choice_names rest (quoted_name acc (first_element_name group_items))
    | _ :: rest => choice_names rest acc
    | Nil => acc

:= base_field (kinds : list (string * type_kind)) (base : string) : string =
    := t = reference_type base
    ?= reference_kind base kinds ?|
    | KindRecord => "        base = " ++# t ++# "_of_children attributes children"
    | KindEnum => "        base = xml.required_value \"" ++# t ++# "\" (" ++# t ++# "_of_string (xml.text_in children))"
    | KindText => "        base = xml.text_in children"

:== readers = { lines : list string; functions : list string }

:= attribute_type
    (kinds : list (string * type_kind)) (owner : string) (name : string) (type_reference : string) (inline : option xsd)
    : string * type_kind
    =
    ?= inline ?|
    | Some inner => type_name (owner ++# "_" ++# name), inline_kind inner
    | None => reference_type type_reference, reference_kind type_reference kinds

:~ ^ reader_named (kinds : list (string * type_kind)) (name : string) (item : xsd) : list string =
    ?= item ?|
    | Complex (_, content, attributes) => record_reader kinds name content attributes Nil
    | Derived (_, base, content, attributes) =>
        record_reader kinds name content attributes (base_field kinds base :: Nil)
    | Sequence _ => record_reader kinds name item Nil Nil
    | _ => Nil

:& :~ record_reader
    (kinds : list (string * type_kind)) (name : string) (content : xsd) (attributes : list xsd)
    (prefix_lines : list string)
    : list string
    =
    := (gathered : readers) =
        attribute_readers kinds name attributes (content_readers kinds name content { lines = Nil; functions = Nil })
    := ty = type_name name
    := lines = listm.append prefix_lines (reverse gathered.lines Nil)
    := body =
        ?= lines ?|
        | Nil => "    ()\n"
        | _ => "    {\n" ++# join_lines lines "" ++# "    }\n"
    := of_children =
        fitted_header
            ("and let " ++# ty ++# "_of_children")
            "(attributes : list (string * string)) (children : list xml.xml_node)"
            ty
        ++# body
    := of_xml =
        fitted_definition
            ("and let " ++# ty ++# "_of_xml (c : xml.xml_node) : " ++# ty ++# " =")
            (ty ++# "_of_children (xml.element_attributes c) (xml.element_children c)")
    of_children :: of_xml :: gathered.functions

:& :~ content_readers (kinds : list (string * type_kind)) (owner : string) (item : xsd) (acc : readers) : readers =
    ?= item ?|
    | Sequence (_, _, items) => items_readers kinds owner items acc
    | Choice (min, max, items) =>
        := choice_name = owner ++# "_choice_" ++# first_element_name items
        := ty = type_name choice_name
        := read = ty ++# "_of_children attributes children"
        := expression =
            ? max = 1i32 ?>
                ? min = 0i32 ?>
                    "if xml.has_any_child ["
                    ++# choice_names items ""
                    ++# "] children then Some ("
                    ++# read
                    ++# ") else None"
                |: read
            |: "[" ++# read ++# "]"
        {
            lines = field_assignment (field_name ("choice_" ++# first_element_name items)) expression :: acc.lines
            functions = listm.append (choice_reader kinds choice_name items) acc.functions
        }
    | Element (name, type_reference, min, max, inline) =>
        ?= inline ?|
        | Some inner =>
            := inner_name = owner ++# "_" ++# name
            {
                lines =
                    field_assignment (field_name name) (occurs_expression name min max (
                        node_expression (inline_kind inner) (type_name inner_name)))
                    :: acc.lines
                functions = listm.append (reader_named kinds inner_name inner) acc.functions
            }
        | None =>
            {
                lines =
                    field_assignment (field_name name) (occurs_expression name min max (
                        node_expression (reference_kind type_reference kinds) (reference_type type_reference)))
                    :: acc.lines
                functions = acc.functions
            }
    | AnyContent => { lines = ("        any = Nil" :: acc.lines); functions = acc.functions }
    | _ => acc

:& :~ items_readers (kinds : list (string * type_kind)) (owner : string) (items : list xsd) (acc : readers) : readers =
    ?= items ?|
    | item :: rest => items_readers kinds owner rest (content_readers kinds owner item acc)
    | Nil => acc

:& :~ choice_reader (kinds : list (string * type_kind)) (choice_name : string) (items : list xsd) : list string =
    := (gathered : readers) = choice_arms kinds choice_name items { lines = Nil; functions = Nil }
    := ty = type_name choice_name
    := header =
        "and let "
        ++# ty
        ++# "_of_children (attributes : list (string * string)) (children : list xml.xml_node) : "
        ++# ty
        ++# " =\n    if false then failwith \"unreachable\"\n"
    := body =
        join_lines (reverse gathered.lines Nil) "" ++# "    else failwith \"" ++# ty ++# ": no alternative present\"\n"
    header ++# body :: gathered.functions

:& :~ choice_arms
    (kinds : list (string * type_kind)) (choice_name : string) (items : list xsd) (acc : readers)
    : readers
    =
    ?= items ?|
    | Element (name, type_reference, min, max, inline) :: rest =>
        := arm = "    elif xml.has_child \"" ++# name ++# "\" children then " ++# case_name choice_name name ++# " ("
        ?= inline ?|
        | Some inner =>
            := inner_name = choice_name ++# "_" ++# name
            choice_arms kinds choice_name rest {
                lines =
                    arm
                    ++# occurs_expression name min max (node_expression (inline_kind inner) (type_name inner_name))
                    ++# ")"
                    :: acc.lines
                functions = listm.append (reader_named kinds inner_name inner) acc.functions
            }
        | None =>
            choice_arms kinds choice_name rest {
                lines =
                    arm
                    ++# occurs_expression name min max (
                            node_expression (reference_kind type_reference kinds) (reference_type type_reference)
                        )
                    ++# ")"
                    :: acc.lines
                functions = acc.functions
            }
    | Sequence (group_min, group_max, group_items) :: rest =>
        := first = first_element_name group_items
        := group_name = choice_name ++# "_group_" ++# first
        := arm =
            "    elif xml.has_child \""
            ++# first
            ++# "\" children then "
            ++# case_name choice_name ("group_" ++# first)
            ++# " ("
            ++# type_name group_name
            ++# "_of_children attributes children)"
        choice_arms kinds choice_name rest {
            lines = arm :: acc.lines
            functions =
                listm.append
                    (reader_named kinds group_name (Sequence (group_min, group_max, group_items)))
                    acc.functions
        }
    | _ :: rest => choice_arms kinds choice_name rest acc
    | Nil => acc

:& :~ attribute_readers
    (kinds : list (string * type_kind)) (owner : string) (attributes : list xsd) (acc : readers)
    : readers
    =
    ?= attributes ?|
    | Attribute (name, type_reference, required, _, inline) :: rest =>
        := t, kind = attribute_type kinds owner name type_reference inline
        := expression =
            ?= kind ?|
            | KindEnum =>
                ? required ?>
                    "xml.required_value \""
                    ++# t
                    ++# "\" ("
                    ++# t
                    ++# "_of_string (xml.required_attribute \""
                    ++# name
                    ++# "\" attributes))"
                |:
                    "optionm.map (fun v => xml.required_value \""
                    ++# t
                    ++# "\" ("
                    ++# t
                    ++# "_of_string v)) (xml.attribute_of \""
                    ++# name
                    ++# "\" attributes)"
            | _ =>
                ? required ?> "xml.required_attribute \"" ++# name ++# "\" attributes"
                |: "xml.attribute_of \"" ++# name ++# "\" attributes"
        attribute_readers kinds owner rest {
            lines = (field_assignment (field_name name) expression :: acc.lines)
            functions = acc.functions
        }
    | _ :: rest => attribute_readers kinds owner rest acc
    | Nil => acc

:= reader_item (kinds : list (string * type_kind)) (item : xsd) : list string =
    ?= item ?|
    | Complex (name, _, _) => reader_named kinds name item
    | Derived (name, _, _, _) => reader_named kinds name item
    | Element (name, _, _, _, Some inner) => reader_named kinds name inner
    | _ => Nil

:~ ^ readers_of (kinds : list (string * type_kind)) (types : list xsd) (acc : list string) : list string =
    ?= types ?|
    | item :: rest => readers_of kinds rest (listm.append (reader_item kinds item) acc)
    | Nil => acc

:= value_node (kind : type_kind) (t : string) (name : string) (v : string) : string =
    ?= kind ?|
    | KindText => "xml.element \"" ++# name ++# "\" Nil (xml.text_children " ++# v ++# ")"
    | KindEnum => "xml.element \"" ++# name ++# "\" Nil (xml.text_children (" ++# t ++# "_to_string " ++# v ++# "))"
    | KindRecord => t ++# "_to_xml \"" ++# name ++# "\" " ++# v

:= occurs_part (name : string) (min : i32) (max : i32) (kind : type_kind) (t : string) (source : string) : string =
    ? max = 1i32 ?>
        ? min = 0i32
        ?> "xml.option_list (optionm.map (fun v => " ++# value_node kind t name "v" ++# ") " ++# source ++# ")"
        |: "[" ++# value_node kind t name source ++# "]"
    |: "listm.map (fun v => " ++# value_node kind t name "v" ++# ") " ++# source

:= concat_parts (parts : list string) : string =
    ?= parts ?|
    | Nil => "Nil"
    | only :: Nil => only
    | _ => "listm.concat [" ++# join_with "; " parts "" ++# "]"

:= attribute_value_text (kind : type_kind) (t : string) (v : string) : string =
    ?= kind ?|
    | KindEnum => t ++# "_to_string " ++# v
    | _ => v

:= base_children (kinds : list (string * type_kind)) (base : string) : list string =
    := t = reference_type base
    ?= reference_kind base kinds ?|
    | KindRecord => t ++# "_children x.base" :: Nil
    | KindEnum => "xml.text_children (" ++# t ++# "_to_string x.base)" :: Nil
    | KindText => "xml.text_children x.base" :: Nil

:= base_attributes (kinds : list (string * type_kind)) (base : string) : list string =
    ?= reference_kind base kinds ?|
    | KindRecord => reference_type base ++# "_attributes x.base" :: Nil
    | _ => Nil

:== writers = { children : list string; attributes : list string; functions : list string }

:~ ^ writer_named (kinds : list (string * type_kind)) (name : string) (item : xsd) : list string =
    ?= item ?|
    | Complex (_, content, attributes) => record_writer kinds name content attributes Nil Nil
    | Derived (_, base, content, attributes) =>
        record_writer kinds name content attributes (base_children kinds base) (base_attributes kinds base)
    | Sequence _ => record_writer kinds name item Nil Nil Nil
    | _ => Nil

:& :~ record_writer
    (kinds : list (string * type_kind)) (name : string) (content : xsd) (attributes : list xsd)
    (prefix_children : list string) (prefix_attributes : list string)
    : list string
    =
    := (gathered : writers) =
        attribute_writers kinds name attributes (
            content_writers kinds name content { children = Nil; attributes = Nil; functions = Nil }
        )
    := ty = type_name name
    := children = listm.append prefix_children (reverse gathered.children Nil)
    := attribute_parts = listm.append prefix_attributes (reverse gathered.attributes Nil)
    := children_function =
        fitted_definition
            ("and let " ++# ty ++# "_children (x : " ++# ty ++# ") : list xml.xml_node =")
            (concat_parts children)
    := attributes_function =
        fitted_definition
            ("and let " ++# ty ++# "_attributes (x : " ++# ty ++# ") : list (string * string) =")
            (concat_parts attribute_parts)
    := to_xml =
        fitted_definition
            ("and let " ++# ty ++# "_to_xml (name : string) (x : " ++# ty ++# ") : xml.xml_node =")
            ("xml.element name (" ++# ty ++# "_attributes x) (" ++# ty ++# "_children x)")
    children_function :: attributes_function :: to_xml :: gathered.functions

:& :~ content_writers (kinds : list (string * type_kind)) (owner : string) (item : xsd) (acc : writers) : writers =
    ?= item ?|
    | Sequence (_, _, items) => items_writers kinds owner items acc
    | Choice (min, max, items) =>
        := choice_name = owner ++# "_choice_" ++# first_element_name items
        := ty = type_name choice_name
        := source = "x." ++# field_name ("choice_" ++# first_element_name items)
        := part =
            ? max = 1i32 ?>
                ? min = 0i32 ?> "xml.option_concat (optionm.map " ++# ty ++# "_children " ++# source ++# ")"
                |: ty ++# "_children " ++# source
            |: "listm.concat (listm.map " ++# ty ++# "_children " ++# source ++# ")"
        {
            children = (part :: acc.children)
            attributes = acc.attributes
            functions = listm.append (choice_writer kinds choice_name items) acc.functions
        }
    | Element (name, type_reference, min, max, inline) =>
        := source = "x." ++# field_name name
        ?= inline ?|
        | Some inner =>
            := inner_name = owner ++# "_" ++# name
            {
                children = occurs_part name min max (inline_kind inner) (type_name inner_name) source :: acc.children
                attributes = acc.attributes
                functions = listm.append (writer_named kinds inner_name inner) acc.functions
            }
        | None =>
            {
                children =
                    occurs_part name min max
                        (reference_kind type_reference kinds)
                        (reference_type type_reference)
                        source
                    :: acc.children
                attributes = acc.attributes
                functions = acc.functions
            }
    | AnyContent => { children = ("x.any" :: acc.children); attributes = acc.attributes; functions = acc.functions }
    | _ => acc

:& :~ items_writers (kinds : list (string * type_kind)) (owner : string) (items : list xsd) (acc : writers) : writers =
    ?= items ?|
    | item :: rest => items_writers kinds owner rest (content_writers kinds owner item acc)
    | Nil => acc

:& :~ choice_writer (kinds : list (string * type_kind)) (choice_name : string) (items : list xsd) : list string =
    := (gathered : writers) =
        choice_writer_arms kinds choice_name items { children = Nil; attributes = Nil; functions = Nil }
    := ty = type_name choice_name
    := header = "and let " ++# ty ++# "_children (x : " ++# ty ++# ") : list xml.xml_node =\n    match x with\n"
    header ++# join_lines (reverse gathered.children Nil) "" :: gathered.functions

:& :~ choice_writer_arms
    (kinds : list (string * type_kind)) (choice_name : string) (items : list xsd) (acc : writers)
    : writers
    =
    ?= items ?|
    | Element (name, type_reference, min, max, inline) :: rest =>
        := arm = "    | " ++# case_name choice_name name ++# " v => "
        ?= inline ?|
        | Some inner =>
            := inner_name = choice_name ++# "_" ++# name
            choice_writer_arms kinds choice_name rest {
                children =
                    arm ++# occurs_part name min max (inline_kind inner) (type_name inner_name) "v" :: acc.children
                attributes = acc.attributes
                functions = listm.append (writer_named kinds inner_name inner) acc.functions
            }
        | None =>
            choice_writer_arms kinds choice_name rest {
                children =
                    arm
                    ++# occurs_part name min max
                            (reference_kind type_reference kinds)
                            (reference_type type_reference)
                            "v"
                    :: acc.children
                attributes = acc.attributes
                functions = acc.functions
            }
    | Sequence (group_min, group_max, group_items) :: rest =>
        := first = first_element_name group_items
        := group_name = choice_name ++# "_group_" ++# first
        := arm =
            "    | "
            ++# case_name choice_name ("group_" ++# first)
            ++# " v => "
            ++# type_name group_name
            ++# "_children v"
        choice_writer_arms kinds choice_name rest {
            children = arm :: acc.children
            attributes = acc.attributes
            functions =
                listm.append
                    (writer_named kinds group_name (Sequence (group_min, group_max, group_items)))
                    acc.functions
        }
    | _ :: rest => choice_writer_arms kinds choice_name rest acc
    | Nil => acc

:& :~ attribute_writers
    (kinds : list (string * type_kind)) (owner : string) (attributes : list xsd) (acc : writers)
    : writers
    =
    ?= attributes ?|
    | Attribute (name, type_reference, required, _, inline) :: rest =>
        := t, kind = attribute_type kinds owner name type_reference inline
        := source = "x." ++# field_name name
        := part =
            ? required ?> "[(\"" ++# name ++# "\", " ++# attribute_value_text kind t source ++# ")]"
            |:
                "xml.option_list (optionm.map (fun v => (\""
                ++# name
                ++# "\", "
                ++# attribute_value_text kind t "v"
                ++# ")) "
                ++# source
                ++# ")"
        attribute_writers kinds owner rest {
            children = acc.children
            attributes = (part :: acc.attributes)
            functions = acc.functions
        }
    | _ :: rest => attribute_writers kinds owner rest acc
    | Nil => acc

:= writer_item (kinds : list (string * type_kind)) (item : xsd) : list string =
    ?= item ?|
    | Complex (name, _, _) => writer_named kinds name item
    | Derived (name, _, _, _) => writer_named kinds name item
    | Element (name, _, _, _, Some inner) => writer_named kinds name inner
    | _ => Nil

:~ ^ writers_of (kinds : list (string * type_kind)) (types : list xsd) (acc : list string) : list string =
    ?= types ?|
    | item :: rest => writers_of kinds rest (listm.append (writer_item kinds item) acc)
    | Nil => acc

:= value_example (kind : type_kind) (t : string) (reference : string) (variant : string) : string =
    ?= kind ?|
    | KindText =>
        ? is_builtin_reference reference ?> "\"" ++# escape_text (builtin_example reference) ++# "\""
        |: t ++# "_example " ++# variant
    | _ => t ++# "_example " ++# variant

:~ ^ repeated_items (value : string -> string) (index : i32) (count : i32) (acc : list string) : list string =
    ? index >= count ?> reverse acc Nil
    |: repeated_items value (index + 1i32) count (value ("(k + " ++# int_text index ++# "i32)") :: acc)

:= repeated_list (value : string -> string) (count : i32) : string =
    ? count <= 0i32 ?> "Nil" |: "[" ++# join_with "; " (repeated_items value 0i32 count Nil) "" ++# "]"

:= fixed_example (kind : type_kind) (t : string) (fixed : string) : string =
    ?= kind ?|
    | KindEnum => "xml.required_value \"" ++# t ++# "\" (" ++# t ++# "_of_string \"" ++# escape_text fixed ++# "\")"
    | _ => "\"" ++# escape_text fixed ++# "\""

:= occurs_example (min : i32) (max : i32) (value : string -> string) : string =
    ? max = 1i32 ?> (? min = 0i32 ?> "None" |: value "k")
    |: repeated_list value min

:~ ^ example_named (kinds : list (string * type_kind)) (name : string) (item : xsd) : list string =
    ?= item ?|
    | Complex (_, content, attributes) => record_example kinds name content attributes Nil
    | Derived (_, base, content, attributes) =>
        := base_line = "        base = " ++# value_example (reference_kind base kinds) (reference_type base) base "k"
        record_example kinds name content attributes (base_line :: Nil)
    | Sequence _ => record_example kinds name item Nil Nil
    | _ => Nil

:& :~ record_example
    (kinds : list (string * type_kind)) (name : string) (content : xsd) (attributes : list xsd)
    (prefix_lines : list string)
    : list string
    =
    := (gathered : readers) =
        attribute_examples kinds name attributes (content_examples kinds name content { lines = Nil; functions = Nil })
    := ty = type_name name
    := lines = listm.append prefix_lines (reverse gathered.lines Nil)
    := body =
        ?= lines ?|
        | Nil => "    ()\n"
        | _ => "    {\n" ++# join_lines lines "" ++# "    }\n"
    "and let " ++# ty ++# "_example (k : i32) : " ++# ty ++# " =\n" ++# body :: gathered.functions

:& :~ content_examples (kinds : list (string * type_kind)) (owner : string) (item : xsd) (acc : readers) : readers =
    ?= item ?|
    | Sequence (_, _, items) => items_examples kinds owner items acc
    | Choice (min, max, items) =>
        := choice_name = owner ++# "_choice_" ++# first_element_name items
        {
            lines =
                field_assignment
                    (field_name ("choice_" ++# first_element_name items))
                    (occurs_example min max (\ variant => type_name choice_name ++# "_example " ++# variant))
                :: acc.lines
            functions = listm.append (choice_example kinds choice_name items) acc.functions
        }
    | Element (name, type_reference, min, max, inline) =>
        ?= inline ?|
        | Some inner =>
            := inner_name = owner ++# "_" ++# name
            {
                lines =
                    field_assignment
                        (field_name name)
                        (occurs_example min max (\ variant => type_name inner_name ++# "_example " ++# variant))
                    :: acc.lines
                functions = listm.append (example_named kinds inner_name inner) acc.functions
            }
        | None =>
            {
                lines =
                    field_assignment
                        (field_name name)
                        (
                            occurs_example min max (
                                value_example
                                    (reference_kind type_reference kinds)
                                    (reference_type type_reference)
                                    type_reference
                            )
                        )
                    :: acc.lines
                functions = acc.functions
            }
    | AnyContent =>
        {
            lines =
                "        any = [xml.element \"modal\" [(\"xmlns\", \"urn:example:any\")] Nil]"
                :: acc.lines
            functions = acc.functions
        }
    | _ => acc

:& :~ items_examples (kinds : list (string * type_kind)) (owner : string) (items : list xsd) (acc : readers) : readers =
    ?= items ?|
    | item :: rest => items_examples kinds owner rest (content_examples kinds owner item acc)
    | Nil => acc

:& :~ choice_example (kinds : list (string * type_kind)) (choice_name : string) (items : list xsd) : list string =
    := ty = type_name choice_name
    := header = "and let " ++# ty ++# "_example (k : i32) : " ++# ty ++# " = "
    ?= items ?|
    | Element (name, type_reference, min, max, inline) :: _ =>
        ?= inline ?|
        | Some inner =>
            := inner_name = choice_name ++# "_" ++# name
            header
            ++# case_name choice_name name
            ++# " ("
            ++# occurs_example min max \ variant => type_name inner_name ++# "_example " ++# variant
            ++# ")\n"
            :: example_named kinds inner_name inner
        | None =>
            header
            ++# case_name choice_name name
            ++# " ("
            ++# occurs_example min max (
                    value_example (reference_kind type_reference kinds) (reference_type type_reference) type_reference
                )
            ++# ")\n"
            :: Nil
    | Sequence (group_min, group_max, group_items) :: _ =>
        := first = first_element_name group_items
        := group_name = choice_name ++# "_group_" ++# first
        header ++# case_name choice_name ("group_" ++# first) ++# " (" ++# type_name group_name ++# "_example k)\n"
        :: example_named kinds group_name (Sequence (group_min, group_max, group_items))
    | _ => header ++# "failwith \"" ++# ty ++# ": no first alternative\"\n" :: Nil

:& :~ attribute_examples
    (kinds : list (string * type_kind)) (owner : string) (attributes : list xsd) (acc : readers)
    : readers
    =
    ?= attributes ?|
    | Attribute (name, type_reference, required, fixed, inline) :: rest =>
        := t, kind = attribute_type kinds owner name type_reference inline
        := value =
            ? required = !- ?> "None"
            |? fixed = "" ?>
                ?= inline ?|
                | Some _ => t ++# "_example k"
                | None => value_example kind t type_reference "k"
            |: fixed_example kind t fixed
        attribute_examples kinds owner rest {
            lines = (field_assignment (field_name name) value :: acc.lines)
            functions = acc.functions
        }
    | _ :: rest => attribute_examples kinds owner rest acc
    | Nil => acc

:= example_item (kinds : list (string * type_kind)) (item : xsd) : list string =
    ?= item ?|
    | Complex (name, _, _) => example_named kinds name item
    | Derived (name, _, _, _) => example_named kinds name item
    | Element (name, _, _, _, Some inner) => example_named kinds name inner
    | _ => Nil

:~ ^ examples_of (kinds : list (string * type_kind)) (types : list xsd) (acc : list string) : list string =
    ?= types ?|
    | item :: rest => examples_of kinds rest (listm.append (example_item kinds item) acc)
    | Nil => acc

:= function_key (text : string) : string =
    := stop = sm'.index_of " (" text
    ? stop < 0i32 ?> text |: sm'.substring 0i32 stop text

:~ ^ unique_texts (items : list string) (seen : list string) (acc : list string) : list string =
    ?= items ?|
    | item :: rest =>
        := key = function_key item
        ? has_name key seen ?> unique_texts rest seen acc |: unique_texts rest (key :: seen) (item :: acc)
    | Nil => reverse acc Nil

:= function_texts (kinds : list (string * type_kind)) (complex_types : list xsd) (elements : list xsd) : list string =
    := readers = readers_of kinds elements (readers_of kinds complex_types Nil)
    := writers = writers_of kinds elements (writers_of kinds complex_types Nil)
    := examples = examples_of kinds elements (examples_of kinds complex_types Nil)
    unique_texts (listm.append readers (listm.append writers examples)) Nil Nil

:= functions_group (functions : list string) : string =
    ?= functions ?|
    | first :: rest =>
        "let rec "
        ++# sm'.substring 8i32 (sm'.length first - 8i32) first
        ++# "\n"
        ++# sm'.concat_balanced "\n" rest
        ++# "\n"
    | Nil => ""

:= readers_text (kinds : list (string * type_kind)) (complex_types : list xsd) (elements : list xsd) : string =
    functions_group (function_texts kinds complex_types elements)

:== module_parts = { items : list emitted; functions : list string }

:= module_parts (schema : xsd_schema) : module_parts =
    := complex_types = dereference_items schema.elements schema.complex_types Nil
    := elements = dereference_items schema.elements schema.elements Nil
    := all = reverse (emit_types elements (emit_types complex_types (emit_types schema.simple_types Nil))) Nil
    := unique = share_unions (unique_emitted all Nil Nil) Nil Nil
    := kinds = kinds_of schema.simple_types (kinds_of complex_types Nil)
    := known = emitted_names unique Nil
    {
        items = order_emitted (with_known_references unique known Nil) known Nil Nil
        functions = function_texts kinds complex_types elements
    }

:= generate_module (schema : xsd_schema) : string =
    := parts = module_parts schema
    texts_of parts.items ++# functions_group parts.functions

:~ ^ item_text (name : string) (items : list emitted) : option string =
    ?= items ?|
    | item :: rest => ? item.name = name ?> Some item.text |: item_text name rest
    | Nil => None

:~ ^ same_in_all (name : string) (text : string) (versions : list module_parts) : bool =
    ?= versions ?|
    | parts :: rest =>
        (?= item_text name parts.items ?| Some other => other = text | None => !-) && same_in_all name text rest
    | Nil => !+

:~ ^ identical_names (items : list emitted) (versions : list module_parts) (acc : list string) : list string =
    ?= items ?|
    | item :: rest =>
        identical_names rest versions (? same_in_all item.name item.text versions ?> (item.name :: acc) |: acc)
    | Nil => acc

:~ ^ all_shared (references : list string) (shared : list string) : bool =
    ?= references ?|
    | reference :: rest => has_name reference shared && all_shared rest shared
    | Nil => !+

:~ ^ closed_pass (items : list emitted) (shared : list string) (acc : list string) : list string =
    ?= items ?|
    | item :: rest =>
        closed_pass rest shared (
            ? has_name item.name shared && all_shared item.references shared ?> (item.name :: acc) |: acc
        )
    | Nil => acc

:~ ^ closed_shared (items : list emitted) (shared : list string) : list string =
    := next = closed_pass items shared Nil
    ? count_list next = count_list shared ?> shared |: closed_shared items next

:~ ^ owner_of (key : string) (names : list string) (best : string) : string =
    ?= names ?|
    | name :: rest =>
        := longer = sm'.starts_with ("and let " ++# name ++# "_") key && (sm'.length name : i32) > sm'.length best
        owner_of key rest (? longer ?> name |: best)
    | Nil => best

:~ ^ has_text_in (text : string) (functions : list string) : bool =
    ?= functions ?|
    | f :: rest => f = text || has_text_in text rest
    | Nil => !-

:~ ^ function_in_all (text : string) (versions : list module_parts) : bool =
    ?= versions ?|
    | parts :: rest => has_text_in text parts.functions && function_in_all text rest
    | Nil => !+

:~ ^ split_items
    (items : list emitted) (shared : list string) (core : list emitted) (own : list emitted)
    : list emitted * list emitted
    =
    ?= items ?|
    | item :: rest =>
        ? has_name item.name shared ?> split_items rest shared (item :: core) own
        |: split_items rest shared core (item :: own)
    | Nil => reverse core Nil, reverse own Nil

:~ ^ split_functions
    (functions : list string) (names : list string) (shared : list string) (versions : list module_parts)
    (core : list string) (own : list string)
    : list string * list string
    =
    ?= functions ?|
    | f :: rest =>
        := owner = owner_of (function_key f) names ""
        ? owner <> "" && has_name owner shared && function_in_all f versions
        ?> split_functions rest names shared versions (f :: core) own
        |: split_functions rest names shared versions core (f :: own)
    | Nil => reverse core Nil, reverse own Nil

:~ ^ functions_outside (functions : list string) (core : list string) (acc : list string) : list string =
    ?= functions ?|
    | f :: rest => functions_outside rest core (? has_text_in f core ?> acc |: f :: acc)
    | Nil => reverse acc Nil

:= function_name (text : string) : string =
    := key = function_key text
    sm'.substring 8i32 (sm'.length key - 8i32) key

:~ ^ mentions_any (text : string) (names : list string) : bool =
    ?= names ?|
    | name :: rest => sm'.contains name text || mentions_any text rest
    | Nil => !-

:~ ^ function_names (functions : list string) (acc : list string) : list string =
    ?= functions ?|
    | f :: rest => function_names rest (function_name f :: acc)
    | Nil => acc

:~ ^ self_contained (core : list string) (outside : list string) (acc : list string) : list string =
    ?= core ?|
    | f :: rest => self_contained rest outside (? mentions_any f outside ?> acc |: f :: acc)
    | Nil => reverse acc Nil

:~ ^ closed_functions (core : list string) (all : list string) : list string =
    := outside = function_names (functions_outside all core Nil) Nil
    := next = self_contained core outside Nil
    ? count_list next = count_list core ?> core |: closed_functions next all

:~ ^ version_texts
    (versions : list module_parts) (shared : list string) (core_functions : list string) (core_module : string)
    (acc : list string)
    : list string
    =
    ?= versions ?|
    | parts :: rest =>
        := _, own_items = split_items parts.items shared Nil Nil
        := own_functions = functions_outside parts.functions core_functions Nil
        := text = "open " ++# core_module ++# "\n\n" ++# texts_of own_items ++# functions_group own_functions
        version_texts rest shared core_functions core_module (text :: acc)
    | Nil => reverse acc Nil

:== family_split = { shared : list string; core_text : string; version_texts : list string }

:= split_family (versions : list module_parts) (core_module : string) : family_split =
    ?= versions ?|
    | first :: _ =>
        := shared = closed_shared first.items (identical_names first.items versions Nil)
        := core_items, _ = split_items first.items shared Nil Nil
        := candidates, _ = split_functions first.functions (emitted_names first.items Nil) shared versions Nil Nil
        := core_functions = closed_functions candidates first.functions
        {
            shared = shared
            core_text = texts_of core_items ++# functions_group core_functions
            version_texts = version_texts versions shared core_functions core_module Nil
        }
    | Nil => { shared = Nil; core_text = ""; version_texts = Nil }

:= generate_family (schemas : list xsd_schema) (core_module : string) : string * list string =
    := split = split_family (listm.map module_parts schemas) core_module
    split.core_text, split.version_texts

:~ ^ has_function_key (key : string) (functions : list string) : bool =
    ?= functions ?|
    | f :: rest => function_key f = key || has_function_key key rest
    | Nil => !-

:~ ^ read_in_all (name : string) (versions : list module_parts) : bool =
    ?= versions ?|
    | parts :: rest => has_function_key ("and let " ++# name ++# "_of_xml") parts.functions && read_in_all name rest
    | Nil => !+

:~ ^ versioned_names
    (items : list emitted) (shared : list string) (versions : list module_parts) (acc : list string)
    : list string
    =
    ?= items ?|
    | item :: rest =>
        := versioned = has_name item.name shared = !- && read_in_all item.name versions
        versioned_names rest shared versions (? versioned ?> (item.name :: acc) |: acc)
    | Nil => reverse acc Nil

:~ ^ common_prefix_length (a : string) (b : string) (pos : i32) : i32 =
    ? pos < sm'.length a && pos < sm'.length b && sm'.substring pos 1i32 a = sm'.substring pos 1i32 b
    ?> common_prefix_length a b (pos + 1i32)
    |: pos

:~ ^ shared_prefix (names : list string) (prefix : string) : string =
    ?= names ?|
    | name :: rest => shared_prefix rest (sm'.substring 0i32 (common_prefix_length prefix name 0i32) prefix)
    | Nil => prefix

:~ ^ past_last_underscore (s : string) (pos : i32) (best : i32) : i32 =
    ? pos >= sm'.length s ?> best
    |: past_last_underscore s (pos + 1i32) (? sm'.substring pos 1i32 s = "_" ?> pos + 1i32 |: best)

:= version_prefix_length (modules : list string) : i32 =
    ?= modules ?|
    | first :: _ :: _ => past_last_underscore (shared_prefix modules first) 0i32 0i32
    | _ => 0i32

:= version_tag (prefix_length : i32) (module_name : string) : string =
    := tag = sm'.substring prefix_length (sm'.length module_name - prefix_length) module_name
    ? sm'.length tag > 0i32 && is_lower (sm'.substring 0i32 1i32 tag) ?> tag |: "v" ++# tag

:= upper_first (s : string) : string =
    := at = ? sm'.length s > 0i32 ?> sm'.index_of (sm'.substring 0i32 1i32 s) (lower_letters ()) |: 0i32 - 1i32
    ? at < 0i32 ?> capitalized s
    |: sm'.substring at 1i32 (upper_letters ()) ++# sm'.substring 1i32 (sm'.length s - 1i32) s

:= versioned_case (name : string) (tag : string) : string =
    upper_first (? sm'.starts_with "x_" name ?> sm'.substring 2i32 (sm'.length name - 2i32) name |: name)
    ++# "_"
    ++# tag

:~ ^ version_lines
    (modules : list string) (prefix_length : i32) (line : string -> string -> string) (acc : list string)
    : list string
    =
    ?= modules ?|
    | module_name :: rest =>
        version_lines rest prefix_length line (line module_name (version_tag prefix_length module_name) :: acc)
    | Nil => reverse acc Nil

:= versioned_type_text (modules : list string) (prefix_length : i32) (name : string) : string =
    := cases =
        version_lines modules prefix_length
            \ module_name tag =>
                "    | "
                ++# versioned_case name tag
                ++# " :: "
                ++# module_name
                ++# "."
                ++# name
                ++# " -> "
                ++# name
                ++# " "
                ++# tag
            Nil
    := reads =
        version_lines modules prefix_length
            \ module_name tag =>
                "    | "
                ++# upper_first tag
                ++# " _ => "
                ++# versioned_case name tag
                ++# " ("
                ++# module_name
                ++# "."
                ++# name
                ++# "_of_xml c)"
            Nil
    "union "
    ++# name
    ++# " v =\n"
    ++# join_lines cases ""
    ++# "\ninl "
    ++# name
    ++# "_of_xml forall v. (witness : version_witness v) (c : xml.xml_node) : "
    ++# name
    ++# " v =\n    match witness with\n"
    ++# join_lines reads ""
    ++# "\n"

:~ ^ versioned_type_texts
    (modules : list string) (prefix_length : i32) (names : list string) (acc : list string)
    : list string
    =
    ?= names ?|
    | name :: rest =>
        versioned_type_texts modules prefix_length rest (versioned_type_text modules prefix_length name :: acc)
    | Nil => reverse acc Nil

:= family_text (modules : list string) (names : list string) : string =
    := prefix_length = version_prefix_length modules
    := nominals = version_lines modules prefix_length (\ _ tag => "nominal " ++# tag ++# " = string") Nil
    := witnesses =
        version_lines modules prefix_length
            \ _ tag => "    | " ++# upper_first tag ++# " :: string -> version_witness " ++# tag
            Nil
    join_lines nominals ""
    ++# "\nunion version_witness v =\n"
    ++# join_lines witnesses ""
    ++# "\n"
    ++# sm'.concat_balanced "" (versioned_type_texts modules prefix_length names Nil)

:~ ^ member_modules (members : list (string * xsd_schema)) (acc : list string) : list string =
    ?= members ?|
    | (module_name, _) :: rest => member_modules rest (module_name :: acc)
    | Nil => reverse acc Nil

:~ ^ member_parts (members : list (string * xsd_schema)) (acc : list module_parts) : list module_parts =
    ?= members ?|
    | (_, schema) :: rest => member_parts rest (module_parts schema :: acc)
    | Nil => reverse acc Nil

:= generate_versioned_family
    (members : list (string * xsd_schema)) (core_module : string)
    : string * list string * string
    =
    := versions = member_parts members Nil
    := split = split_family versions core_module
    ?= versions ?|
    | first :: _ =>
        split.core_text,
        split.version_texts,
        family_text (member_modules members Nil) (versioned_names first.items split.shared versions Nil)
    | Nil => split.core_text, split.version_texts, ""

:= generate_enumerations (schema : xsd_schema) : string =
    texts_of (reverse (emit_types schema.simple_types Nil) Nil)

///> rust
test names_follow_spiral_conventions =
    ? type_name "TCodUfIBGE" <> "x_t_cod_uf_ibge" ?> failwith "snake case type name"
    ? case_name "TCodUfIBGE" "35" <> "TCodUfIBGE_35" ?> failwith "numeric case name"
    ? case_name "TVerNFe" "1.04" <> "TVerNFe_1_04" ?> failwith "dotted case name"
    ? case_name "TOrigem" "Não" <> "TOrigem_N_o" ?> failwith "non-ASCII value becomes an underscore"
    ? case_name "enviNFe_versao" "4.00" <> "XenviNFe_versao_4_00" ?> failwith "lowercase owner gets a capital prefix"
    ? field_name "type" <> "type_value" ?> failwith "keyword field"
    ? type_name "TNFe" <> "x_tn_fe" ?> failwith "an upper run splits before its last capital"
    ? case_name "TTransformURI" "http://www.w3.org/2000/09/xmldsig#enveloped-signature"
        <> "TTransformURI_enveloped_signature"
    ?> failwith "a URI value is named by its fragment"
    ? case_name "TTransformURI" "http://www.w3.org/TR/2001/REC-xml-c14n-20010315"
        <> "TTransformURI_REC_xml_c14n_20010315"
    ?> failwith "a URI value without a fragment is named by its last path segment"

///> rust
test enumerations_parse_through_one_match =
    := text = union_text "TUf" ("SP" :: "RJ" :: Nil)
    ? sm'.contains "    match s with\n    | \"SP\" => Some TUf_SP\n" text = !- ?> failwith "one arm per value"
    ? sm'.contains "    | _ => None\n" text = !- ?> failwith "anything else is None"
    ? sm'.contains "if false" text ?> failwith "no dead first branch"

///> rust
test families_share_identical_closed_types_once =
    := shared =
        "<xs:simpleType name=\"Code\"><xs:restriction base=\"xs:string\"><xs:pattern "
        ^^ "value=\"[0-9]{2}\"/></xs:restriction></xs:simpleType>"
    := leaf one =
        "<xs:complexType name=\"Leaf\"><xs:sequence><xs:element name=\"c\" type=\"Code\"/>"
        ++# one
        ++# "</xs:sequence></xs:complexType>"
    := root =
        "<xs:complexType name=\"Root\"><xs:sequence><xs:element name=\"l\" "
        ^^ "type=\"Leaf\"/></xs:sequence></xs:complexType>"
    := v1 = read_schema ("<xs:schema>" ++# shared ++# leaf "" ++# root ++# "</xs:schema>")
    := v2 =
        read_schema (
            "<xs:schema>" ++# shared ++# leaf "<xs:element name=\"extra\" type=\"Code\"/>" ++# root ++# "</xs:schema>"
        )
    := core, versions = generate_family (v1 :: v2 :: Nil) "generated_demo_core"
    ? sm'.contains "type x_code = string" core = !- ?> failwith "the identical leaf type is in the core"
    ? sm'.contains "type x_leaf" core ?> failwith "the changed type stays per version"
    ? sm'.contains "type x_root" core ?> failwith "a type over a changed type stays per version"
    ?= versions ?|
    | first :: second :: Nil =>
        ? sm'.starts_with "open generated_demo_core" first = !- ?> failwith "a version opens its core"
        ? sm'.contains "type x_code" second ?> failwith "the core type is not repeated"
        ? sm'.contains "extra" first || sm'.contains "extra" second = !-
        ?> failwith "the version keeps its own shape"
    | _ => failwith "two version modules"

///> rust
test versioned_families_read_through_one_witness =
    := shared =
        "<xs:simpleType name=\"Code\"><xs:restriction base=\"xs:string\"><xs:pattern "
        ^^ "value=\"[0-9]{2}\"/></xs:restriction></xs:simpleType>"
    := leaf one =
        "<xs:complexType name=\"Leaf\"><xs:sequence><xs:element name=\"c\" type=\"Code\"/>"
        ++# one
        ++# "</xs:sequence></xs:complexType>"
    := root =
        "<xs:complexType name=\"Root\"><xs:sequence><xs:element name=\"l\" "
        ^^ "type=\"Leaf\"/></xs:sequence></xs:complexType>"
    := v1 = read_schema ("<xs:schema>" ++# shared ++# leaf "" ++# root ++# "</xs:schema>")
    := v2 =
        read_schema (
            "<xs:schema>" ++# shared ++# leaf "<xs:element name=\"extra\" type=\"Code\"/>" ++# root ++# "</xs:schema>"
        )
    := _, _, family =
        generate_versioned_family (("generated_demo_v1", v1) :: ("generated_demo_v2", v2) :: Nil) "generated_demo_core"
    ? sm'.contains "nominal v1 = string\nnominal v2 = string\n" family = !-
    ?> failwith "one nominal per version, tagged past the shared prefix"
    ? sm'.contains "    | V2 :: string -> version_witness v2\n" family = !-
    ?> failwith "the witness indexes each version"
    ? sm'.contains "    | Leaf_v2 :: generated_demo_v2.x_leaf -> x_leaf v2\n" family = !-
    ?> failwith "a changed type becomes a version-indexed union"
    ? sm'.contains "    | V1 _ => Leaf_v1 (generated_demo_v1.x_leaf_of_xml c)\n" family = !-
    ?> failwith "the reader matches the witness once"
    ? sm'.contains "union x_root v =" family = !- ?> failwith "a type over a changed type is versioned too"
    ? sm'.contains "x_code" family ?> failwith "core types are not versioned"

:== complement_member = { case_name : string; module_name : string; schema : xsd_schema }

:= root_reader (member : complement_member) : string * string =
    ?= member.schema.elements ?|
    | Element (name, _, _, _, Some _) :: _ => xml.local_name name, type_name name
    | Element (name, reference, _, _, None) :: _ => xml.local_name name, type_name (xml.local_name reference)
    | _ => "", ""

:~ ^ complement_case_lines (members : list complement_member) (acc : list string) : list string =
    ?= members ?|
    | member :: rest =>
        := _, ty = root_reader member
        complement_case_lines rest (
            "    | " ++# member.case_name ++# " : " ++# member.module_name ++# "." ++# ty :: acc
        )
    | Nil => reverse acc Nil

:~ ^ complement_case_dispatch (members : list complement_member) (acc : string) : string =
    ?= members ?|
    | member :: rest =>
        := element, ty = root_reader member
        := test =
            "local = \""
            ++# element
            ++# "\" && (space = \"\" || space = \""
            ++# escape_text member.schema.target_namespace
            ++# "\")"
        complement_case_dispatch rest (
            acc
            ++# "if "
            ++# test
            ++# " then "
            ++# member.case_name
            ++# " ("
            ++# member.module_name
            ++# "."
            ++# ty
            ++# "_of_xml node)\n    el"
        )
    | Nil => acc ++# "se Unknown (local, xml.element_children node)\n"

:= generate_complements (members : list complement_member) : string =
    := head =
        "union complement =\n"
        ++# join_lines (complement_case_lines members Nil) ""
        ++# "    | Unknown : string * list xml.xml_node\n"
    := space =
        "\ninl complement_namespace (node : xml.xml_node) : string =\n"
        ++# "    inl name = xml.node_name node\n"
        ++# "    inl colon = sm'.index_of \":\" name\n"
        ++# "    inl key = if colon >= 0i32 then \"xmlns:\" ++# sm'.substring 0i32 colon name else \"xmlns\"\n"
        ++# "    match xml.attribute_of key (xml.element_attributes node) with\n"
        ++# "    | Some uri => uri\n"
        ++# "    | None => \"\"\n"
    := reader =
        "\ninl complement_of_xml (node : xml.xml_node) : complement =\n"
        ++# "    inl local = xml.local_name (xml.node_name node)\n"
        ++# "    inl space = complement_namespace node\n"
        ++# "    " ++# complement_case_dispatch members ""
    head ++# space ++# reader

///> rust
test complements_as_one_runtime_union_keep_typed_cases =
    := pagos =
        read_schema (
            "<xs:schema targetNamespace=\"http://www.sat.gob.mx/Pagos20\"><xs:element "
            ^^ "name=\"Pagos\"><xs:complexType><xs:sequence><xs:element name=\"Monto\" "
            ^^ "type=\"xs:string\"/></xs:sequence></xs:complexType></xs:element></xs:schema>"
        )
    := text =
        generate_complements ({ case_name = "Pagos20"; module_name = "generated_cfdi_pagos20"; schema = pagos } :: Nil)
    ?
        sm'.contains
            (
                "union complement =\n    | Pagos20 : generated_cfdi_pagos20.x_pagos\n"
                ^^ "    | Unknown : string * list xml.xml_node\n"
            )
            text
        = !-
    ?> failwith "one typed case per complement plus Unknown"
    ? sm'.contains "then Pagos20 (generated_cfdi_pagos20.x_pagos_of_xml node)" text = !-
    ?> failwith "the reader builds the typed case"
    ? sm'.contains "exists" text ?> failwith "no existential in the runtime slot"
