///- --package . --timeout 1800000
:< sm'_operators
:< xsd

:= upper_letters () : string = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"

:= lower_letters () : string = "abcdefghijklmnopqrstuvwxyz"

:= alnum () : string = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789"

:= is_upper (c : string) : bool = sm'::index_of c (upper_letters ()) >= 0i32

:= is_lower (c : string) : bool = sm'::index_of c (lower_letters ()) >= 0i32

:= is_alnum (c : string) : bool = sm'::index_of c (alnum ()) >= 0i32

:= snake_piece (c : string) (previous_lower : bool) (previous_upper : bool) (next_lower : bool) : string =
    ? is_upper c ?> (? previous_lower || (previous_upper && next_lower) ?> "_" |: "") ++# sm'::to_lower c
    |? is_alnum c ?> c
    |: "_"

:= lower_at (s : string) (at : i32) : bool = at < sm'::length s && is_lower (xml::code_point_text s at)

:= lower_or_digit (c : string) : bool = is_lower c || (sm'::index_of c "0123456789" >= 0i32)

:= emit_snake_piece_at (s : string) (pos : i32) (previous_lower : bool) (previous_upper : bool) : string =
    := c = xml::code_point_text s pos
    snake_piece c previous_lower previous_upper (lower_at s (pos + sm'::length c))

:~ ^ snake_from (s : string) (pos : i32) (previous_lower : bool) (previous_upper : bool) (acc : string) : string =
    ? pos >= sm'::length s ?> acc
    |:
        := c = xml::code_point_text s pos
        := piece = emit_snake_piece_at s pos previous_lower previous_upper
        snake_from s (pos + sm'::length c) (lower_or_digit c) (is_upper c) (acc ++# piece)

:= type_name (xsd_name : string) : string = "x_" ++# snake_from xsd_name 0i32 !- !- ""

:~ ^ has_name (target : string) (items : list string) : bool =
    ?= items ?|
    | x :: rest => x = target || has_name target rest
    | [] => !-

:= spiral_keywords () : list string =
    [
        "and"
        "as"
        "elif"
        "else"
        "false"
        "forall"
        "fun"
        "function"
        "global"
        "if"
        "in"
        "inl"
        "instance"
        "let"
        "match"
        "module"
        "nominal"
        "open"
        "or"
        "prototype"
        "rec"
        "then"
        "true"
        "type"
        "union"
        "when"
        "with"
    ]

:= field_name (xsd_name : string) : string =
    := name = snake_from (xml::local_name xsd_name) 0i32 !- !- ""
    ? has_name name (spiral_keywords ()) ?> name ++# "_value" |: name

:~ ^ case_from (s : string) (pos : i32) (acc : string) : string =
    ? pos >= sm'::length s ?> acc
    |:
        := c = xml::code_point_text s pos
        case_from s (pos + sm'::length c) (acc ++# (? is_alnum c ?> c |: "_"))

:= capitalized (s : string) : string =
    ? sm'::length s > 0i32 && is_upper (xml::code_point_text s 0i32) ?> s |: "X" ++# s

:= after_last_slash (value : string) (length : i32) : string =
    := trimmed = ? sm'::ends_with "/" value ?> sm'::substring 0i32 (length - 1i32) value |: value
    := trimmed_length : i32 = sm'::length trimmed
    := slash = sm'::last_index_of "/" trimmed
    sm'::substring (slash + 1i32) (trimmed_length - slash - 1i32) trimmed

:= uri_tail (value : string) : string =
    := length : i32 = sm'::length value
    := hash = sm'::last_index_of "#" value
    ? hash >= 0i32 ?> sm'::substring (hash + 1i32) (length - hash - 1i32) value |: after_last_slash value length

:= case_value (value : string) : string = ? sm'::contains "://" value ?> uri_tail value |: value

:= case_name (owner : string) (value : string) : string =
    capitalized (case_from owner 0i32 "") ++# "_" ++# case_from (case_value value) 0i32 ""

:~ ^ distinct_values (values : list string) (seen : list string) (acc : list string) : list string =
    ?= values ?|
    | v :: rest =>
        ? has_name v seen ?> distinct_values rest seen acc |: distinct_values rest (v :: seen) (v :: acc)
    | [] => reverse acc []

:~ ^ enumeration_values (facets : list xsd_facet) (acc : list string) : list string =
    ?= facets ?|
    | Enumeration value :: rest => enumeration_values rest (value :: acc)
    | _ :: rest => enumeration_values rest acc
    | [] => reverse acc []

:= escape_text (s : string) : string = s |> sm'::replace "\\" "\\\\" |> sm'::replace "\"" "\\\""

:~ ^ join_lines (lines : list string) (acc : string) : string =
    ?= lines ?|
    | line :: rest => join_lines rest (acc ++# line ++# "\n")
    | [] => acc

:~ ^ map_strings (f : string -> string) (items : list string) (acc : list string) : list string =
    ?= items ?|
    | x :: rest => map_strings f rest (f x :: acc)
    | [] => reverse acc []

:~ ^ unused_case (candidate : string) (used : list string) : string =
    ? has_name candidate used ?> unused_case (candidate ++# "_") used |: candidate

:~ ^ value_cases
    (owner : string) (values : list string) (used : list string) (acc : list (string * string))
    : list (string * string)
    =
    ?= values ?|
    | v :: rest =>
        := case = unused_case (case_name owner v) used
        value_cases owner rest (case :: used) ((v, case) :: acc)
    | [] => reverse acc []

:~ ^ case_lines
    (pairs : list (string * string)) (line : string -> string -> string) (acc : list string)
    : list string
    =
    ?= pairs ?|
    | (v, case) :: rest => case_lines rest line (line v case :: acc)
    | [] => reverse acc []

:= digit_text (d : i32) : string = sm'::substring d 1i32 "0123456789"

:~ ^ digits_text (n : i32) (acc : string) : string =
    ? n < 10i32 ?> digit_text n ++# acc |: digits_text (n / 10i32) (digit_text (n % 10i32) ++# acc)

:= int_text (n : i32) : string = ? n < 0i32 ?> "-" ++# digits_text (0i32 - n) "" |: digits_text n ""

:~ ^ take_items \* t. (count : i32) (items : list t) : list t =
    ?= items ?|
    | x :: rest => ? count <= 0i32 ?> [] |: x :: take_items (count - 1i32) rest
    | [] => []

:= last_variant_line (index : i32) (last_case : string) : string =
    (? index = 0i32 ?> "    " |: "    else ") ++# last_case ++# "\n"

:= variant_line (index : i32) (variant_case : string) : string =
    := keyword = ? index = 0i32 ?> "    if" |: "    elif"
    keyword ++# " index = " ++# int_text index ++# "i32 then " ++# variant_case ++# "\n"

:~ ^ variant_arms (pairs : list (string * string)) (count : i32) (index : i32) (acc : string) : string =
    ?= pairs ?|
    | (_, last_case) :: [] => acc ++# last_variant_line index last_case
    | (_, variant_case) :: rest => variant_arms rest count (index + 1i32) (acc ++# variant_line index variant_case)
    | [] => acc

:= text_instance (ty : string) : string = "instance to_text " ++# ty ++# " = fun x => " ++# ty ++# "_to_string x\n"

:= codec_prelude () : string =
    "open xml_codec\n\n"
    ++# "prototype to_text t : t -> string\n\n"
    ++# "inl text_node forall t {to_text}. (name : string) (v : t) : xml.xml_node =\n"
    ++# "    xml.element name [] (xml.text_children (to_text v))\n\n"
    ++# "inl optional_text_nodes forall t {to_text}. (name : string) (v : option t) : list xml.xml_node =\n"
    ++# "    xml.option_list (optionm.map (text_node name) v)\n\n"
    ++# "inl repeated_text_nodes forall t {to_text}. (name : string) (vs : list t) : list xml.xml_node =\n"
    ++# "    listm.map (text_node name) vs\n\n"

:= normalized_input (normalizer : string) : string = ? normalizer = "" ?> "" |: "    inl s = " ++# normalizer ++# " s\n"

:= coded_example_head (ty : string) (count : i32) : string =
    "inl "
    ++# ty
    ++# "_example (k : i32) : "
    ++# ty
    ++# " =\n    inl index = ((k % "
    ++# int_text count
    ++# "i32) + "
    ++# int_text count
    ++# "i32) % "
    ++# int_text count
    ++# "i32\n"

:= example_text_line (ty : string) : string =
    "\ninl " ++# ty ++# "_example_text (k : i32) : string = " ++# ty ++# "_to_string (" ++# ty ++# "_example k)\n"

:= coded_example_text (ty : string) (examples : list (string * string)) (count : i32) : string =
    coded_example_head ty count ++# variant_arms examples count 0i32 "" ++# example_text_line ty

:= emit_union_examples (ty : string) (variants : list (string * string)) : string =
    "\n" ++# coded_example_text ty variants (count_list variants)

:= union_example_text (ty : string) (pairs : list (string * string)) : string =
    ?= pairs ?|
    | _ :: _ => emit_union_examples ty (take_items 8i32 pairs)
    | [] => ""

:= union_parse_arms (pairs : list (string * string)) : list string =
    case_lines pairs (\ v case => "    | \"" ++# escape_text v ++# "\" => Some " ++# case) []

:= union_parse_text (ty : string) (normalizer : string) (pairs : list (string * string)) : string =
    := head = "inl " ++# ty ++# "_of_string (s : string) : option " ++# ty ++# " ="
    join_lines (head :: normalized_input normalizer ++# "    match s with" :: union_parse_arms pairs) ""

:= union_print_text (ty : string) (pairs : list (string * string)) : string =
    := print_arms = case_lines pairs (\ v case => "    | " ++# case ++# " => \"" ++# escape_text v ++# "\"") []
    join_lines ("inl " ++# ty ++# "_to_string (x : " ++# ty ++# ") : string =" :: "    match x with" :: print_arms) ""

:= union_declaration (ty : string) (pairs : list (string * string)) : string =
    join_lines ("union " ++# ty ++# " =" :: case_lines pairs (\ _ case => "    | " ++# case) []) ""

:= union_rest_text (ty : string) (pairs : list (string * string)) : string =
    union_print_text ty pairs ++# "\n" ++# text_instance ty ++# union_example_text ty pairs

:= union_text (name : string) (values : list string) (normalizer : string) : string =
    := ty = type_name name
    := pairs = value_cases name values [] []
    union_declaration ty pairs
    ++# "\n"
    ++# union_parse_text ty normalizer pairs
    ++# "    | _ => None\n\n"
    ++# union_rest_text ty pairs

:= union_value_limit () : i32 = 256i32

:~ ^ example_pairs (ty : string) (values : list string) (acc : list (string * string)) : list (string * string) =
    ?= values ?|
    | v :: rest =>
        := case = ty ++# " \"" ++# escape_text v ++# "\""
        example_pairs ty rest ((v, case) :: acc)
    | [] => reverse acc []

:= coded_table_text (ty : string) (table : string) : string =
    "inl " ++# ty ++# "_table () : string = \"" ++# (escape_text table |> sm'::replace "\n" "\\n") ++# "\"\n\n"

:= coded_parse_text (ty : string) (normalizer : string) : string =
    "inl "
    ++# ty
    ++# "_of_string (s : string) : option "
    ++# ty
    ++# " =\n"
    ++# normalized_input normalizer
    ++# "    if xsd_regex.table_matches ("
    ++# ty
    ++# "_table ()) s then Some ("
    ++# ty
    ++# " s) else None\n\n"

:= coded_print_text (ty : string) : string =
    "inl "
    ++# ty
    ++# "_to_string (x : "
    ++# ty
    ++# ") : string = match x with "
    ++# ty
    ++# " s => s\n"
    ++# text_instance ty
    ++# "\n"

:= coded_examples (ty : string) (values : list string) : string =
    := examples = example_pairs ty (take_items 8i32 values) []
    coded_example_text ty examples (count_list examples)

:= coded_head_text (ty : string) : string = "nominal private " ++# ty ++# " = string\n\n"

:= coded_text (name : string) (table : string) (values : list string) (normalizer : string) : string =
    := ty = type_name name
    coded_head_text ty
    ++# coded_table_text ty table
    ++# coded_parse_text ty normalizer
    ++# coded_print_text ty
    ++# coded_examples ty values

:~ ^ join_with (separator : string) (items : list string) (acc : string) : string =
    ?= items ?|
    | item :: rest => join_with separator rest (? acc = "" ?> item |: acc ++# separator ++# item)
    | [] => acc

:= u32_text (n : u32) : string = int_text (conv n : i32)

:= emit_range_test (move : xsd_regex::dfa_move) : string =
    ? move::low = move::high ?> "c = " ++# u32_text move::low ++# "u32"
    |: u32_text move::low ++# "u32 <= c && c <= " ++# u32_text move::high ++# "u32"

:= emit_range_arm (move : xsd_regex::dfa_move) (function_name : string) (keyword : string) : string =
    "            " ++# keyword ++# " " ++# emit_range_test move ++# " then " ++# function_name ++# " "
    ++# int_text move::target ++# "i32 s next\n"

:~ ^ range_tests
    (moves : list xsd_regex::dfa_move) (function_name : string) (keyword : string) (acc : string)
    : string
    =
    ?= moves ?|
    | move :: rest => range_tests rest function_name "elif" (acc ++# emit_range_arm move function_name keyword)
    | [] => ? acc = "" ?> "            false\n" |: acc ++# "            else false\n"

:= state_arm (row : xsd_regex::dfa_state) (function_name : string) (index : i32) : string =
    := keyword = ? index = 0i32 ?> "        if" |: "        elif"
    keyword ++# " state = " ++# int_text index ++# "i32 then\n" ++# range_tests row::moves function_name "if" ""

:~ ^ state_arms (rows : list xsd_regex::dfa_state) (function_name : string) (index : i32) (acc : string) : string =
    ?= rows ?|
    | row :: rest => state_arms rest function_name (index + 1i32) (acc ++# state_arm row function_name index)
    | [] => acc ++# "        else false\n"

:= accepting_acc (row : xsd_regex::dfa_state) (index : i32) (acc : string) : string =
    ? row::accepting ?> (? acc = "" ?> "" |: acc ++# " || ") ++# "state = " ++# int_text index ++# "i32" |: acc

:~ ^ accepting_states (rows : list xsd_regex::dfa_state) (index : i32) (acc : string) : string =
    ?= rows ?|
    | row :: rest => accepting_states rest (index + 1i32) (accepting_acc row index acc)
    | [] => ? acc = "" ?> "false" |: acc

:= dfa_function_head (function_name : string) (rows : list xsd_regex::dfa_state) : string =
    "let rec " ++# function_name ++# " (state : i32) (s : string) (i : i32) : bool =\n"
    ++# "    if i >= sm'.length s then " ++# accepting_states rows 0i32 "" ++# "\n"
    ++# "    else\n"

:= dfa_function_text (function_name : string) (rows : list xsd_regex::dfa_state) : string =
    dfa_function_head function_name rows
    ++# "        inl c = xml.code_point_at s i\n"
    ++# "        inl next = i + xml.code_point_width s i\n"
    ++# state_arms rows function_name 0i32 ""

:= direct_coded_state_limit () : i32 = 128i32

:= direct_coded_dfa (p : string) : option (list xsd_regex::dfa_state) =
    xsd_regex::dfa_of_pattern_within (direct_coded_state_limit ()) p

:~ ^ fnv_from (s : string) (i : i32) (h : u64) : u64 =
    ? i >= sm'::length s ?> h
    |:
        fnv_from s
            (i + xml::code_point_width s i)
            (((h ^^^ (conv (xml::code_point_at s i) : u64)) * 16777619u64) &&& 4294967295u64)

:~ ^ hex_text (n : u64) (digits : i32) (acc : string) : string =
    ? digits <= 0i32
    ?> acc
    |: hex_text (n >>> 4i32) (digits - 1i32) (sm'::substring (conv (n &&& 15u64) : i32) 1i32 "0123456789abcdef" ++# acc)

:= pattern_function_name (p : string) : string =
    "xsd_pattern_" ++# hex_text (fnv_from p 0i32 2166136261u64) 8i32 "" ++# "_" ++# int_text (sm'::length p)

:| value_set =
    | NoValueSet
    | DfaValueSet : string
    | UnionValueSet : list string

:~ ^ same_strings (a : list string) (b : list string) : bool =
    ?= a, b ?|
    | (x :: a_rest), (y :: b_rest) => x = y && same_strings a_rest b_rest
    | [], [] => !+
    | _ => !-

:= same_value_set (a : value_set) (b : value_set) : bool =
    ?= a, b ?|
    | DfaValueSet x, DfaValueSet y => x = y
    | UnionValueSet x, UnionValueSet y => same_strings x y
    | _ => !-

:| item_role =
    | PlainItem
    | CertificateItem

:== emitted = { name : string; references : list string; text : string; value_set : value_set; role : item_role }

:= is_certificate (item : emitted) : bool =
    ?= item::role ?|
    | CertificateItem => !+
    | PlainItem => !-

:== pattern_code = { functions : list emitted; checks : list string; references : list string }

:= move_head (move : xsd_regex::dfa_move) : string =
    "xsd_certificate.MovesNext ("
    ++# int_text (conv move::low : i32)
    ++# "u32, "
    ++# int_text (conv move::high : i32)
    ++# "u32, "
    ++# int_text move::target
    ++# "i32, "

:~ ^ moves_certificate_text (moves : list xsd_regex::dfa_move) : string =
    ?= moves ?|
    | move :: rest => move_head move ++# moves_certificate_text rest ++# ")"
    | [] => "xsd_certificate.MovesEnd"

:= certificate_row_line (row : xsd_regex::dfa_state) : string =
    := accepting = ? row::accepting ?> "true" |: "false"
    "    xsd_certificate.CertifiedRow ("
    ++# accepting
    ++# ", xsd_certificate.PackedMoves (exists ("
    ++# moves_certificate_text row::moves
    ++# ")))\n    :: "

:~ ^ rows_certificate_text (rows : list xsd_regex::dfa_state) (acc : string) : string =
    ?= rows ?|
    | row :: rest => rows_certificate_text rest (acc ++# certificate_row_line row)
    | [] => acc ++# "[]\n"

:= plain_item (name : string) (references : list string) (text : string) : emitted =
    { name = name; references = references; text = text; value_set = NoValueSet; role = PlainItem }

:= certificate_item (name : string) (rows : list xsd_regex::dfa_state) : emitted =
    {
        name = name ++# "_certificate"
        references = []
        text = "inl " ++# name ++# "_certificate () =\n" ++# rows_certificate_text rows ""
        value_set = NoValueSet
        role = CertificateItem
    }

:~ ^ certificate_calls (items : list emitted) (acc : string) : string =
    ?= items ?|
    | item :: rest =>
        ? is_certificate item
        ?> certificate_calls rest (acc ++# " + xsd_certificate.certified_table (" ++# item::name ++# " ())")
        |: certificate_calls rest acc
    | [] => acc

:= certificates_checked_text (items : list emitted) : string =
    "\ninl certificates_checked () : i32 = 0i32" ++# certificate_calls items "" ++# "\n"

:= dfa_item (name : string) (table : string) (values : list string) (normalizer : string) : emitted =
    {
        name = type_name name
        references = []
        text = coded_text name table values normalizer
        value_set = DfaValueSet table
        role = PlainItem
    }

:= coded_enumeration (name : string) (values : list string) (normalizer : string) : list emitted =
    := rows = xsd_regex::dfa_of_values values
    dfa_item name (xsd_regex::dfa_table_text rows) values normalizer
    :: certificate_item (type_name name ++# "_table") rows
    :: []

:= union_enumeration (name : string) (values : list string) (normalizer : string) : list emitted =
    := distinct = distinct_values values [] []
    {
        name = type_name name
        references = []
        text = union_text name distinct normalizer
        value_set = UnionValueSet distinct
        role = PlainItem
    }
    :: []

:= emit_enumeration (name : string) (values : list string) (normalizer : string) : list emitted =
    ? count_list values > union_value_limit ()
    ?> coded_enumeration name values normalizer
    |: union_enumeration name values normalizer

:= with_pattern
    (item : emitted) (certificate : emitted) (check : string) (reference : string) (acc : pattern_code)
    : pattern_code
    =
    {
        functions = (item :: certificate :: acc::functions)
        checks = (check :: acc::checks)
        references = (reference :: acc::references)
    }

:= coded_check (function_name : string) : string = function_name ++# " 0i32 s 0i32"

:= coded_pattern (p : string) (rows : list xsd_regex::dfa_state) (acc : pattern_code) : pattern_code =
    := function_name = pattern_function_name p
    := state_function = plain_item function_name [] (dfa_function_text function_name rows)
    with_pattern state_function (certificate_item function_name rows) (coded_check function_name) function_name acc

:= dfa_table_function_text (table_name : string) (rows : list xsd_regex::dfa_state) : string =
    "inl "
    ++# table_name
    ++# " () : string = \""
    ++# (escape_text (xsd_regex::dfa_table_text rows) |> sm'::replace "\n" "\\n")
    ++# "\"\n"

:= table_check (table_name : string) : string = "xsd_regex.table_matches (" ++# table_name ++# " ()) s"

:= table_pattern (p : string) (rows : list xsd_regex::dfa_state) (acc : pattern_code) : pattern_code =
    := table_name = pattern_function_name p ++# "_table"
    := table_function = plain_item table_name [] (dfa_table_function_text table_name rows)
    with_pattern table_function (certificate_item table_name rows) (table_check table_name) table_name acc

:= regex_pattern (p : string) (acc : pattern_code) : pattern_code =
    ? xsd_regex::is_xsd_pattern p = !-
    ?> failwith ("an xs:pattern XSD forbids (lookaround, or a quantifier with nothing to repeat): " ++# p)
    |: { acc ?| checks = (("xsd_regex.pattern_matches \"" ++# escape_text p ++# "\" s") :: acc::checks) }

:= uncoded_pattern (p : string) (acc : pattern_code) : pattern_code =
    ?= xsd_regex::dfa_of_pattern p ?|
    | Some rows => table_pattern p rows acc
    | None => regex_pattern p acc

:= pattern_check (p : string) (acc : pattern_code) : pattern_code =
    ?= direct_coded_dfa p ?|
    | Some rows => coded_pattern p rows acc
    | None => uncoded_pattern p acc

:~ ^ pattern_checks (facets : list xsd_facet) (acc : pattern_code) : pattern_code =
    ?= facets ?|
    | Pattern p :: rest => pattern_checks rest (pattern_check p acc)
    | _ :: rest => pattern_checks rest acc
    | [] => { acc ?| checks = reverse acc::checks [] }

:~ ^ length_checks (facets : list xsd_facet) (acc : list string) : list string =
    ?= facets ?|
    | Length n :: rest => length_checks rest ("xml.code_point_count s = " ++# int_text n :: acc)
    | MinLength n :: rest => length_checks rest ("xml.code_point_count s >= " ++# int_text n :: acc)
    | MaxLength n :: rest => length_checks rest ("xml.code_point_count s <= " ++# int_text n :: acc)
    | _ :: rest => length_checks rest acc
    | [] => reverse acc []

:= pattern_conjuncts (checks : list string) : list string =
    ?= checks ?|
    | [] => []
    | _ => ("(" ++# join_with " || " checks "" ++# ")") :: []

:= conjunction_text (conjuncts : list string) : string =
    ?= conjuncts ?|
    | [] => "true"
    | _ => join_with " && " conjuncts ""

:= validator_text (name : string) (code : pattern_code) (facets : list xsd_facet) : string =
    := conjuncts = listm::append (pattern_conjuncts code::checks) (length_checks facets [])
    "inl " ++# type_name name ++# "_is_valid (s : string) : bool = " ++# conjunction_text conjuncts ++# "\n"

:== collected = { fields : list string; references : list string; extra : list emitted }

:= is_builtin_reference (reference : string) : bool = reference = "" || xsd_resolve::is_builtin reference

:| builtin_kind =
    | Base64Builtin
    | UriBuiltin
    | IdBuiltin
    | DateTimeBuiltin
    | DateBuiltin
    | BooleanBuiltin
    | PositiveIntegerBuiltin
    | DecimalBuiltin
    | IntegerBuiltin
    | NonNegativeIntegerBuiltin
    | StringBuiltin
    | NormalizedStringBuiltin
    | OtherBuiltin

:= builtin_kinds () : list (string * builtin_kind) =
    [
        ("base64Binary", Base64Builtin); ("string", StringBuiltin); ("normalizedString", NormalizedStringBuiltin);
        ("anyURI", UriBuiltin); ("ID", IdBuiltin); ("dateTime", DateTimeBuiltin); ("date", DateBuiltin);
        ("boolean", BooleanBuiltin); ("positiveInteger", PositiveIntegerBuiltin); ("decimal", DecimalBuiltin);
        ("integer", IntegerBuiltin); ("long", IntegerBuiltin); ("int", IntegerBuiltin); ("short", IntegerBuiltin);
        ("byte", IntegerBuiltin); ("nonNegativeInteger", NonNegativeIntegerBuiltin);
        ("unsignedInt", NonNegativeIntegerBuiltin); ("unsignedShort", NonNegativeIntegerBuiltin);
        ("unsignedByte", NonNegativeIntegerBuiltin)
    ]

:~ ^ builtin_kind_in (local : string) (table : list (string * builtin_kind)) : builtin_kind =
    ?= table ?|
    | (name, kind) :: rest => ? name = local ?> kind |: builtin_kind_in local rest
    | [] => OtherBuiltin

:= builtin_kind_of (reference : string) : builtin_kind = builtin_kind_in (xml::local_name reference) (builtin_kinds ())

:== carrier = { kind : builtin_kind; name : string; value_type : string; parse : string; example : string * string }

:= carriers () : list carrier =
    [
        {
            kind = DecimalBuiltin
            name = "xsd_decimal"
            value_type = "decimal.decimal"
            parse = "decimal.parse"
            example = ("decimal.of_int 1i64", "1")
        }
        { kind = IntegerBuiltin; name = "xsd_integer"; value_type = "i64"; parse = "whole_of"; example = ("1i64", "1") }
        {
            kind = NonNegativeIntegerBuiltin
            name = "xsd_non_negative_integer"
            value_type = "i64"
            parse = "whole_at_least 0i64"
            example = ("1i64", "1")
        }
        {
            kind = PositiveIntegerBuiltin
            name = "xsd_positive_integer"
            value_type = "i64"
            parse = "whole_at_least 1i64"
            example = ("1i64", "1")
        }
        {
            kind = BooleanBuiltin
            name = "xsd_boolean"
            value_type = "bool"
            parse = "boolean_of"
            example = ("true", "true")
        }
    ]

:~ ^ carrier_in (kind : builtin_kind) (items : list carrier) : option string =
    ?= items ?|
    | c :: rest => ? c::kind = kind ?> Some c::name |: carrier_in kind rest
    | [] => None

:= kind_carrier (kind : builtin_kind) : option string = carrier_in kind (carriers ())

:= builtin_carrier (reference : string) : option string =
    ? reference = "" || is_builtin_reference reference = !- ?> None |: kind_carrier (builtin_kind_of reference)

:= reference_type (type_reference reference) : string =
    ?= builtin_carrier reference ?|
    | Some name => name
    | None => ? is_builtin_reference reference ?> "string" |: type_name (xml::local_name reference)

:= lexical_prelude () : string =
    "nominal lexical t = { value : t; text : string }\n\n"
    ++# "instance to_text lexical t = fun x => x.text\n\n"
    ++# "inl lexical_of forall t. (text : string) (value : option t) : option (lexical t) =\n"
    ++# "    optionm.map (fun v => lexical { value = v; text = text }) value\n\n"

:= whole_number_prelude () : string =
    "inl whole_of (text : string) : option i64 =\n"
    ++# "    if sm'.index_of \".\" text >= 0i32 then None\n"
    ++# "    else optionm.map (fun (d : decimal.decimal) => d.units) (decimal.parse text)\n\n"
    ++# "inl whole_at_least (least : i64) (text : string) : option i64 =\n"
    ++# "    match whole_of text with\n"
    ++# "    | Some n => if n >= least then Some n else None\n"
    ++# "    | None => None\n\n"

:= boolean_prelude () : string =
    "inl boolean_of (text : string) : option bool =\n"
    ++# "    match xml.collapsed_space text with\n"
    ++# "    | \"true\" => Some true\n"
    ++# "    | \"1\" => Some true\n"
    ++# "    | \"false\" => Some false\n"
    ++# "    | \"0\" => Some false\n"
    ++# "    | _ => None\n\n"

:= carrier_type_text (c : carrier) : string =
    "type " ++# c::name ++# " = lexical " ++# c::value_type ++# "\n\n"
    ++# "inl " ++# c::name ++# "_of_string (s : string) : option " ++# c::name
    ++# " = lexical_of s (" ++# c::parse ++# " s)\n\n"

:= carrier_example_text (c : carrier) : string =
    := value, text = c::example
    "inl " ++# c::name ++# "_example (_ : i32) : " ++# c::name
    ++# " = lexical { value = " ++# value ++# "; text = \"" ++# text ++# "\" }\n\n"
    ++# "inl " ++# c::name ++# "_example_text (_ : i32) : string = \"" ++# text ++# "\"\n\n"

:~ ^ used_carrier_texts (body : string) (items : list carrier) (acc : string) : string =
    ?= items ?|
    | c :: rest =>
        := text = ? sm'::contains c::name body ?> carrier_type_text c ++# carrier_example_text c |: ""
        used_carrier_texts body rest (acc ++# text)
    | [] => acc

:= carrier_prelude (body : string) : string =
    := used = used_carrier_texts body (carriers ()) ""
    ? used = "" ?> "" |: lexical_prelude () ++# whole_number_prelude () ++# boolean_prelude () ++# used

:= reference_dependency (type_reference reference) : list string =
    ? is_builtin_reference reference ?> [] |: type_name (xml::local_name reference) :: []

:= reference_type_of \* form. (reference : option (type_reference form)) : string =
    ?= reference ?|
    | Some r => reference_type r
    | None => "string"

:= reference_dependency_of \* form. (reference : option (type_reference form)) : list string =
    ?= reference ?|
    | Some r => reference_dependency r
    | None => []

:| occurs_shape =
    | Required
    | Optional
    | Repeated

:= shape_of (o : occurs) : occurs_shape =
    ?= o::max ?|
    | Bounded n => ? n <> 1i32 ?> Repeated |? o::min = 0i32 ?> Optional |: Required
    | Unbounded => Repeated

:= with_occurs (o : occurs) (t : string) : string =
    ?= shape_of o ?|
    | Optional => "option (" ++# t ++# ")"
    | Required => t
    | Repeated => "list (" ++# t ++# ")"

:~ ^ particle_requires_staged \* form. (staged : list string) (particle : xsd particle form) : bool =
    ?= particle ?|
    | Element e => emit_element_requires_staged staged e::occurs e::name e::inline
    | Sequence s => s::occurs::min >= 1i32 && any_particle_requires_staged staged s::items
    | Choice c => emit_choice_requires_staged staged c::occurs c::items
    | _ => !-

:& :~ emit_element_requires_staged \* form.
    (staged : list string) (o : occurs) (name : tag_name) (inline : option (xsd type_def form))
    : bool
    =
    ? o::min < 1i32 ?> !-
    |? has_name (xml::local_name (tag_text name)) staged ?> !+
    |:
        ?= inline ?|
        | Some inner => type_requires_staged staged inner
        | None => !-

:& :~ emit_choice_requires_staged \* form.
    (staged : list string) (o : occurs) (items : list (xsd particle form))
    : bool
    =
    o::min >= 1i32 && listm::length items > 0i32 && every_particle_requires_staged staged items

:& :~ any_particle_requires_staged \* form. (staged : list string) (items : list (xsd particle form)) : bool =
    ?= items ?|
    | item :: rest => particle_requires_staged staged item || any_particle_requires_staged staged rest
    | [] => !-

:& :~ every_particle_requires_staged \* form. (staged : list string) (items : list (xsd particle form)) : bool =
    ?= items ?|
    | item :: rest => particle_requires_staged staged item && every_particle_requires_staged staged rest
    | [] => !+

:& :~ type_requires_staged \* form. (staged : list string) (definition : xsd type_def form) : bool =
    ?= definition ?|
    | Complex c => particle_requires_staged staged c::content
    | Derived d => particle_requires_staged staged d::content
    | _ => !-

:~ ^ first_element_name \* form. (items : list (xsd particle form)) : string =
    ?= items ?|
    | (Element e) :: _ => tag_text e::name
    | (Sequence s) :: rest => first_in_group s::items rest
    | (Choice c) :: rest => first_in_group c::items rest
    | _ :: rest => first_element_name rest
    | [] => "empty"

:& :~ first_in_group \* form. (inner : list (xsd particle form)) (rest : list (xsd particle form)) : string =
    ?= inner ?|
    | [] => first_element_name rest
    | _ => first_element_name inner

:= inner_owner (owner : string) (name : string) : string = ? owner = "" ?> name |: owner ++# "_" ++# name

:= choice_owner \* form. (owner : string) (items : list (xsd particle form)) : string =
    owner ++# "_choice_" ++# first_element_name items

:~ ^ particle_mentions \* form. (names : list string) (owner : string) (particle : xsd particle form) : bool =
    ?= particle ?|
    | Element e => element_mentions names owner e::name e::inline e::type_ref
    | Sequence s => any_particle_mentions names owner s::items
    | Choice c => any_particle_mentions names (choice_owner owner c::items) c::items
    | _ => !-

:& :~ element_mentions \* form.
    (names : list string) (owner : string) (name : tag_name) (inline : option (xsd type_def form))
    (type_ref : option (type_reference form))
    : bool
    =
    ?= inline, type_ref ?|
    | Some inner, _ =>
        := raw = inner_owner owner (tag_text name)
        has_name (type_name raw) names || type_mentions names raw inner
    | None, Some reference => has_name (reference_type reference) names
    | None, None => !-

:& :~ any_particle_mentions \* form. (names : list string) (owner : string) (items : list (xsd particle form)) : bool =
    ?= items ?|
    | item :: rest => particle_mentions names owner item || any_particle_mentions names owner rest
    | [] => !-

:& :~ type_mentions \* form. (names : list string) (owner : string) (definition : xsd type_def form) : bool =
    ?= definition ?|
    | Complex c => particle_mentions names owner c::content
    | Derived d => has_name (reference_type d::base) names || particle_mentions names owner d::content
    | _ => !-

:~ ^ inline_candidates \* form.
    (owner : string) (particle : xsd particle form) (acc : list (string * xsd type_def form))
    : list (string * xsd type_def form)
    =
    ?= particle ?|
    | Element e => emit_element_candidates owner e::name e::inline acc
    | Sequence s => inline_all_candidates owner s::items acc
    | Choice c => inline_all_candidates (choice_owner owner c::items) c::items acc
    | _ => acc

:& :~ emit_element_candidates \* form.
    (owner : string) (name : tag_name) (inline : option (xsd type_def form)) (acc : list (string * xsd type_def form))
    : list (string * xsd type_def form)
    =
    ?= inline ?|
    | Some inner =>
        := raw = inner_owner owner (tag_text name)
        inline_definition_candidates raw inner ((raw, inner) :: acc)
    | None => acc

:& :~ inline_all_candidates \* form.
    (owner : string) (items : list (xsd particle form)) (acc : list (string * xsd type_def form))
    : list (string * xsd type_def form)
    =
    ?= items ?|
    | item :: rest => inline_all_candidates owner rest (inline_candidates owner item acc)
    | [] => acc

:& :~ inline_definition_candidates \* form.
    (owner : string) (definition : xsd type_def form) (acc : list (string * xsd type_def form))
    : list (string * xsd type_def form)
    =
    ?= definition ?|
    | Complex c => inline_candidates owner c::content acc
    | Derived d => inline_candidates owner d::content acc
    | _ => acc

:= definition_candidates \* form.
    (name : definition_name form) (definition : xsd type_def form) (content : xsd particle form)
    (acc : list (string * xsd type_def form))
    : list (string * xsd type_def form)
    =
    := raw = definition_text name
    inline_candidates raw content ((raw, definition) :: acc)

:~ ^ named_candidates \* form.
    (definitions : list (xsd type_def form)) (acc : list (string * xsd type_def form))
    : list (string * xsd type_def form)
    =
    ?= definitions ?|
    | (Complex c) :: rest => named_candidates rest (definition_candidates c::name (Complex c) c::content acc)
    | (Derived d) :: rest => named_candidates rest (definition_candidates d::name (Derived d) d::content acc)
    | _ :: rest => named_candidates rest acc
    | [] => acc

:~ ^ directly_staged \* form.
    (staged : list string) (candidates : list (string * xsd type_def form)) (acc : list string)
    : list string
    =
    ?= candidates ?|
    | (raw, definition) :: rest =>
        := name = type_name raw
        := fresh = (has_name name acc) = !-
        directly_staged staged rest (? fresh && type_requires_staged staged definition ?> name :: acc |: acc)
    | [] => acc

:~ ^ add_staged \* form.
    (candidates : list (string * xsd type_def form)) (names : list string) (acc : list string)
    : list string
    =
    ?= candidates ?|
    | (raw, definition) :: rest =>
        := name = type_name raw
        := fresh = (has_name name acc) = !-
        add_staged rest names (? fresh && type_mentions names raw definition ?> name :: acc |: acc)
    | [] => acc

:~ ^ grow_staged \* form. (candidates : list (string * xsd type_def form)) (names : list string) : list string =
    := next = add_staged candidates names names
    ? (listm::length next : i32) = listm::length names ?> names |: grow_staged candidates next

:= field_line (name : string) (t : string) : string = "        " ++# field_name name ++# " : " ++# t

:= staging_types_text () : string =
    "nominal unsigned = ()\nnominal signed = ()\n\n"
    ++# "union staged s a =\n"
    ++# "    | Pending :: forall a. string -> staged unsigned a\n"
    ++# "    | Present :: forall a. a -> staged signed a\n\n"
    ++# "union stage s =\n"
    ++# "    | Unsigned :: stage unsigned\n"
    ++# "    | Signed :: stage signed\n\n"
    ++# "prototype stage_of s : () -> stage s\n"
    ++# "instance stage_of unsigned = fun () => Unsigned\n"
    ++# "instance stage_of signed = fun () => Signed\n\n"

:= staged_read_text () : string =
    "inl staged_read forall s a.\n"
    ++# "    (witness : stage s) (read : list xml_codec.decode_error -> option a * list xml_codec.decode_error)\n"
    ++# "    (errors : list xml_codec.decode_error)\n"
    ++# "    : option (staged s a) * list xml_codec.decode_error\n"
    ++# "    =\n"
    ++# "    match witness with\n"
    ++# "    | Unsigned => Some (Pending \"unsigned\"), errors\n"
    ++# "    | Signed =>\n"
    ++# "        inl value, errors = read errors\n"
    ++# "        optionm.map (fun v => Present v) value, errors\n\n"

:= staged_access_text () : string =
    "inl signed_value forall a. (x : staged signed a) : a =\n"
    ++# "    match x with\n"
    ++# "    | Present v => v\n\n"
    ++# "inl staged_list forall s a b. (f : a -> b) (x : staged s a) : list b =\n"
    ++# "    match x with\n"
    ++# "    | Pending _ => []\n"
    ++# "    | Present v => [f v]\n\n"

:= staging_prelude () : string = staging_types_text () ++# staged_read_text () ++# staged_access_text ()

:= staged_field_types (t : string) (text : string) : string =
    sm'::replace (" : " ++# t ++# "\n") (" : " ++# t ++# " s\n") text
    |> sm'::replace ("option (" ++# t ++# ")") ("option (" ++# t ++# " s)")
    |> sm'::replace ("list (" ++# t ++# ")") ("list (" ++# t ++# " s)")

:~ ^ staged_references (staged : list string) (text : string) : string =
    ?= staged ?|
    | t :: rest => staged_references rest (staged_field_types t text)
    | [] => text

:= first_line (tail : string) : string =
    := stop = sm'::index_of "\n" tail
    sm'::substring 0i32 (? stop < 0i32 ?> sm'::length tail |: stop) tail

:= line_after (marker : string) (text : string) : option string =
    := at = sm'::index_of marker text
    ? at < 0i32 ?> None
    |:
        := from = at + sm'::length marker
        Some (first_line (sm'::substring from (sm'::length text - from) text))

:= staged_type (t : string) : string = "staged s " ++# (? sm'::contains " " t ?> "(" ++# t ++# ")" |: t)

:= staged_line_replaced (line : string) (t : string) (text : string) : string =
    sm'::replace (line ++# t ++# "\n") (line ++# staged_type t ++# "\n") text

:= staged_signature (name : string) (text : string) : string =
    := line = "\n" ++# field_line name ""
    ?= line_after line text ?|
    | Some t ?& sm'::starts_with "staged " t = !- => staged_line_replaced line t text
    | _ => text

:~ ^ staged_signatures (signatures : list string) (text : string) : string =
    ?= signatures ?|
    | name :: rest => staged_signatures rest (staged_signature name text)
    | [] => text

:= staged_declaration_text (name : string) (text : string) : string =
    sm'::replace ("type " ++# name ++# " =") ("type " ++# name ++# " s =") text
    |> sm'::replace ("nominal " ++# name ++# " =") ("nominal " ++# name ++# " s =")

:= staged_item (staged : list string) (signatures : list string) (item : emitted) : emitted =
    ? has_name item::name staged = !- ?> item
    |:
        := text = staged_declaration_text item::name item::text
        { item ?| text = staged_signatures signatures (staged_references staged text) }

:= staged_items (staged : list string) (signatures : list string) (items : list emitted) : list emitted =
    listm::map (staged_item staged signatures) items

:= choice_field_of (first : string) : string = field_name ("choice_" ++# xml::local_name first)

:= line_width () : i32 = 120i32

:= field_assignment (field : string) (expression : string) : string =
    := one_line = "        " ++# field ++# " = " ++# expression
    ? sm'::length one_line <= line_width () ?> one_line
    |: "        " ++# field ++# " =\n            " ++# expression

:= fitted_definition (head : string) (body : string) : string =
    := one_line = head ++# " " ++# body
    ? sm'::length one_line <= line_width () ?> one_line ++# "\n" |: head ++# "\n    " ++# body ++# "\n"

:= fitted_header (name : string) (parameters : string) (result : string) : string =
    := one_line = name ++# " " ++# parameters ++# " : " ++# result ++# " ="
    ? sm'::length one_line <= line_width () ?> one_line ++# "\n"
    |: name ++# "\n    " ++# parameters ++# "\n    : " ++# result ++# "\n    =\n"

:~ ^ patterns_accept (facets : list xsd_facet) (s : string) (matched : bool) (none_seen : bool) : bool =
    ?= facets ?|
    | Pattern p :: rest => patterns_accept rest s (matched || xsd_regex::pattern_matches p s) !-
    | _ :: rest => patterns_accept rest s matched none_seen
    | [] => matched || none_seen

:~ ^ lengths_accept (facets : list xsd_facet) (s : string) : bool =
    ?= facets ?|
    | Length n :: rest => xml::code_point_count s = n && lengths_accept rest s
    | MinLength n :: rest => xml::code_point_count s >= n && lengths_accept rest s
    | MaxLength n :: rest => xml::code_point_count s <= n && lengths_accept rest s
    | _ :: rest => lengths_accept rest s
    | [] => !+

:~ ^ first_pattern (facets : list xsd_facet) : option string =
    ?= facets ?|
    | Pattern p :: _ => Some p
    | _ :: rest => first_pattern rest
    | [] => None

:~ ^ has_length_facet (facets : list xsd_facet) : bool =
    ?= facets ?|
    | Length _ :: _ => !+
    | MinLength _ :: _ => !+
    | MaxLength _ :: _ => !+
    | _ :: rest => has_length_facet rest
    | [] => !-

:~ ^ min_length (facets : list xsd_facet) : i32 =
    ?= facets ?|
    | Length n :: _ => n
    | MinLength n :: _ => n
    | _ :: rest => min_length rest
    | [] => 1i32

:~ ^ example_search (facets : list xsd_facet) (r : xsd_regex::rx) (stars : i32) : string =
    ? stars > 64i32 ?> xsd_regex::example_with 1i32 r
    |:
        := candidate = xsd_regex::example_with stars r
        ? patterns_accept facets candidate !- !+ && lengths_accept facets candidate ?> candidate
        |: example_search facets r (stars + 1i32)

:= builtin_example (reference : string) : string =
    ?= builtin_kind_of reference ?|
    | Base64Builtin => "AAAA"
    | UriBuiltin => "http://example.com"
    | IdBuiltin => "ID1"
    | DateTimeBuiltin => "2026-01-01T00:00:00"
    | DateBuiltin => "2026-01-01"
    | BooleanBuiltin => "true"
    | PositiveIntegerBuiltin | DecimalBuiltin | IntegerBuiltin | NonNegativeIntegerBuiltin => "1"
    | StringBuiltin | NormalizedStringBuiltin | OtherBuiltin => "1"

:= is_calendar_builtin (base : string) : bool =
    ?= builtin_kind_of base ?|
    | DateBuiltin | DateTimeBuiltin => base <> "" && is_builtin_reference base
    | _ => !-

:= is_positive_integer_builtin (base : string) : bool =
    is_builtin_reference base && builtin_kind_of base = PositiveIntegerBuiltin

:= prefers_builtin_example (base : string) : bool = is_calendar_builtin base || is_positive_integer_builtin base

:~ ^ zero_padded_one (p : string) (left : i32) (text : string) : option string =
    ? left = 0i32 ?> None
    |? xsd_regex::pattern_matches p text ?> Some text
    |: zero_padded_one p (left - 1i32) ("0" ++# text)

:= positive_example (base : string) (p : string) (facets : list xsd_facet) : option string =
    ? is_positive_integer_builtin base && has_length_facet facets = !-
    ?> zero_padded_one p 18i32 "1"
    |: None

:= searched_example (p : string) (facets : list xsd_facet) : string =
    ?= xsd_regex::compile_pattern p ?|
    | Some r => example_search facets r 0i32
    | None => "1"

:= positive_or_searched (base : string) (p : string) (facets : list xsd_facet) : string =
    ?= positive_example base p facets ?|
    | Some text => text
    | None => searched_example p facets

:= patterned_example (base : string) (p : string) (facets : list xsd_facet) : string =
    := calendar = builtin_example base
    ? prefers_builtin_example base && xsd_regex::pattern_matches p calendar && has_length_facet facets = !-
    ?> calendar
    |: positive_or_searched base p facets

:= builtin_or_repeated (base : string) (facets : list xsd_facet) : string =
    := text = builtin_example base
    ? xml::code_point_count text >= min_length facets ?> text |: xsd_regex::repeated "1" (min_length facets)

:= unpatterned_example (base : string) (facets : list xsd_facet) : string =
    ? is_builtin_reference base ?> builtin_or_repeated base facets
    |: xsd_regex::repeated "1" (? min_length facets < 1i32 ?> 1i32 |: min_length facets)

:= simple_example (base : string) (facets : list xsd_facet) : string =
    ?= first_pattern facets ?|
    | Some p => patterned_example base p facets
    | None => unpatterned_example base facets

:= is_constrained (facets : list xsd_facet) : bool =
    (?= first_pattern facets ?| Some _ => !+ | None => !-) || has_length_facet facets

:~ ^ explicit_white_space (facets : list xsd_facet) : option string =
    ?= facets ?|
    | WhiteSpace mode :: _ => Some mode
    | _ :: rest => explicit_white_space rest
    | [] => None

:= builtin_white_space (base : string) : string =
    ? base = "" || is_builtin_reference base = !- ?> "preserve"
    |:
        ?= builtin_kind_of base ?|
        | StringBuiltin => "preserve"
        | NormalizedStringBuiltin => "replace"
        | _ => "collapse"

:= white_space_normalizer (base : string) (facets : list xsd_facet) : string =
    := mode = ?= explicit_white_space facets ?| Some mode => mode | None => builtin_white_space base
    ? mode = "collapse" ?> "xml.collapsed_space" |? mode = "replace" ?> "xml.replaced_space" |: ""

:= emit_validated_check (ty : string) : string = "if " ++# ty ++# "_is_valid s then Some (" ++# ty ++# " s) else None"

:= emit_validated_of_string (ty : string) (normalizer : string) : string =
    := checked = emit_validated_check ty
    fitted_definition
        ("inl " ++# ty ++# "_of_string (s : string) : option " ++# ty ++# " =")
        (? normalizer = "" ?> checked |: "match " ++# normalizer ++# " s with s => " ++# checked)

:= emit_validated_to_string (ty : string) : string =
    fitted_definition
        ("inl " ++# ty ++# "_to_string (x : " ++# ty ++# ") : string =")
        ("match x with " ++# ty ++# " s => s")

:= emit_validated_example (ty : string) (example : string) : string =
    fitted_definition
        ("inl " ++# ty ++# "_example (_ : i32) : " ++# ty ++# " =")
        (ty ++# " \"" ++# escape_text example ++# "\"")

:= emit_validated_example_text (ty : string) : string =
    fitted_definition
        ("inl " ++# ty ++# "_example_text (k : i32) : string =")
        (ty ++# "_to_string (" ++# ty ++# "_example k)")

:= emit_validated_head (ty : string) (name : string) (code : pattern_code) (facets : list xsd_facet) : string =
    "nominal private " ++# ty ++# " = string\n\n" ++# validator_text name code facets ++# "\n"

:= validated_text
    (ty : string) (name : string) (code : pattern_code) (facets : list xsd_facet) (normalizer : string)
    (example : string)
    : string
    =
    emit_validated_head ty name code facets ++# emit_validated_of_string ty normalizer ++# "\n"
    ++# emit_validated_to_string ty ++# "\n" ++# text_instance ty
    ++# emit_validated_example ty example ++# "\n" ++# emit_validated_example_text ty

:= occurs_once () : occurs = { min = 1i32; max = Bounded 1i32 }

:= group_identity \* form. (owner : string) (items : list (xsd particle form)) : string * string =
    := first = first_element_name items
    owner ++# "_group_" ++# first, field_name ("group_" ++# xml::local_name first)

:= collected_with (field : string) (references : list string) (extra : list emitted) (acc : collected) : collected =
    {
        fields = field :: acc::fields
        references = listm::append references acc::references
        extra = listm::append extra acc::extra
    }

:= inherited_example_text \* form. (ty : string) (base : type_reference form) : string =
    "inl " ++# ty ++# "_example (k : i32) : string = " ++# reference_type base ++# "_example_text k\n"

:= literal_example_text \* form. (ty : string) (base : type_reference form) (facets : list xsd_facet) : string =
    "inl "
    ++# ty
    ++# "_example (_ : i32) : string = \""
    ++# escape_text (simple_example (reference_text base) facets)
    ++# "\"\n"

:= simple_text_example \* form. (ty : string) (inherits : bool) (base : type_reference form) (facets : list xsd_facet)
    : string
    =
    ? inherits ?> inherited_example_text ty base |: literal_example_text ty base facets

:= inherits_base \* form. (base : type_reference form) (facets : list xsd_facet) : bool =
    is_builtin_reference (reference_text base) = !-
    && (?= first_pattern facets ?| Some _ => !- | None => !+)
    && has_length_facet facets = !-

:= emit_constrained_text \* form.
    (ty : string) (name : string) (base : type_reference form) (facets : list xsd_facet) (code : pattern_code)
    : string
    =
    := normalizer = white_space_normalizer (reference_text base) facets
    validated_text ty name code facets normalizer (simple_example (reference_text base) facets)

:= emit_simple_example_text (ty : string) : string =
    "\ninl " ++# ty ++# "_example_text (k : i32) : string = " ++# ty ++# "_example k\n"

:= emit_unconstrained_text \* form.
    (ty : string) (name : string) (base : type_reference form) (facets : list xsd_facet) (code : pattern_code)
    (inherits : bool)
    : string
    =
    "type " ++# ty ++# " = string\n\n" ++# validator_text name code facets ++# "\n"
    ++# simple_text_example ty inherits base facets ++# emit_simple_example_text ty

:= simple_type_text \* form.
    (ty : string) (name : string) (base : type_reference form) (facets : list xsd_facet) (code : pattern_code)
    (inherits : bool)
    : string
    =
    ? is_constrained facets ?> emit_constrained_text ty name base facets code
    |: emit_unconstrained_text ty name base facets code inherits

:= simple_references \* form. (inherits : bool) (base : type_reference form) (code : pattern_code) : list string =
    listm::append (? inherits ?> reference_dependency base |: []) code::references

:= facet_code (facets : list xsd_facet) : pattern_code =
    pattern_checks facets { functions = []; checks = []; references = [] }

:= emit_simple_text \* form. (name : string) (base : type_reference form) (facets : list xsd_facet) : list emitted =
    := ty = type_name name
    := inherits = inherits_base base facets
    := code = facet_code facets
    plain_item ty (simple_references inherits base code) (simple_type_text ty name base facets code inherits)
    :: code::functions

:= sequence_of \* form. (o : occurs) (items : list (xsd particle form)) : xsd particle form =
    Sequence { occurs = o; items = items }

:= once_sequence \* form. (items : list (xsd particle form)) : xsd particle form =
    Sequence { occurs = { min = 1i32; max = Bounded 1i32 }; items = items }

:= repeated_group_field (first : string) (o : occurs) (group_name : string) : string =
    field_line ("group_" ++# xml::local_name first) (with_occurs o (type_name group_name))

:= choice_field_line (first : string) (o : occurs) (choice_name : string) : string =
    "        " ++# choice_field_of first ++# " : " ++# with_occurs o (type_name choice_name)

:= group_case_field (choice_name : string) (first : string) (group_name : string) : string =
    "    | " ++# case_name choice_name ("group_" ++# first) ++# " : " ++# type_name group_name

:= choice_union_text (ty : string) (fields : list string) : string =
    join_lines ("union " ++# ty ++# " =" :: reverse fields []) ""

:= referenced_field \* form. (name : string) (o : occurs) (type_ref : option (type_reference form)) : string =
    field_line name (with_occurs o (reference_type_of type_ref))

:= emit_simple_named \* form. (name : string) (base : type_reference form) (facets : list xsd_facet) : list emitted =
    ?= enumeration_values facets [] ?|
    | [] => emit_simple_text name base facets
    | values => emit_enumeration name values (white_space_normalizer (reference_text base) facets)

:= emit_record_text (ty : string) (fields : list string) : string =
    ?= fields ?|
    | [] => "type " ++# ty ++# " = ()\n"
    | _ => "nominal " ++# ty ++# " =\n    {\n" ++# join_lines fields "" ++# "    }\n"

:= emit_record_item (name : string) (fields : list string) (references : list string) : emitted =
    plain_item (type_name name) references (emit_record_text (type_name name) fields)

:= emit_referenced_case \* form.
    (case_label : string) (o : occurs) (type_ref : option (type_reference form)) (acc : collected)
    : collected
    =
    collected_with (case_label ++# with_occurs o (reference_type_of type_ref)) (reference_dependency_of type_ref) [] acc

:= emit_attribute_type_text \* form.
    (inner_name : string) (inline : option (xsd type_def form)) (type_ref : option (type_reference form))
    : string
    =
    ?= inline ?|
    | Some _ => type_name inner_name
    | None => reference_type_of type_ref

:= emit_attribute_references \* form.
    (inner_name : string) (inline : option (xsd type_def form)) (type_ref : option (type_reference form))
    : list string
    =
    ?= inline ?|
    | Some _ => type_name inner_name :: []
    | None => reference_dependency_of type_ref

:= emit_attribute_field_text (name : tag_name) (required : bool) (t : string) : string =
    field_line (tag_text name) (? required ?> t |: "option (" ++# t ++# ")")

:= emit_attribute_with \* form.
    (inner_name : string) (name : tag_name) (required : bool) (inline : option (xsd type_def form))
    (type_ref : option (type_reference form)) (extra : list emitted) (acc : collected)
    : collected
    =
    := field = emit_attribute_field_text name required (emit_attribute_type_text inner_name inline type_ref)
    collected_with field (emit_attribute_references inner_name inline type_ref) extra acc

:~ ^ emit_named_type \* form. (name : string) (item : xsd type_def form) : list emitted =
    ?= item ?|
    | Simple s => emit_simple_named name s::base s::facets
    | Complex c => emit_record name c::content c::attributes [] []
    | Derived d => emit_derived_record name d::content d::attributes d::base

:& :~ emit_derived_record \* form.
    (name : string) (content : xsd particle form) (attributes : list (xsd attribute_decl form))
    (base : type_reference form)
    : list emitted
    =
    emit_record name content attributes (field_line "base" (reference_type base) :: []) (reference_dependency base)

:& :~ emit_named_group \* form. (name : string) (group : xsd particle form) : list emitted =
    emit_record name group [] [] []

:& :~ emit_record \* form.
    (name : string) (content : xsd particle form) (attributes : list (xsd attribute_decl form))
    (prefix_fields : list string)
    (prefix_references : list string)
    : list emitted
    =
    := (gathered : collected) = emit_gathered name content attributes
    := fields = listm::append prefix_fields (reverse gathered::fields [])
    emit_record_item name fields (listm::append prefix_references gathered::references) :: gathered::extra

:& :~ emit_gathered \* form.
    (name : string) (content : xsd particle form) (attributes : list (xsd attribute_decl form))
    : collected
    =
    collect_attributes name attributes (collect_content name content { fields = []; references = []; extra = [] })

:& :~ collect_content \* form. (owner : string) (item : xsd particle form) (acc : collected) : collected =
    ?= item ?|
    | Sequence s ?& is_repeated s::occurs => collect_repeated_group owner s::occurs s::items acc
    | Sequence s => collect_items owner s::items acc
    | Choice c => collect_choice owner c::occurs c::items acc
    | Element e => collect_element owner (tag_text e::name) e::occurs e::type_ref e::inline acc
    | AnyContent () => collected_with (field_line "any" "any_content") [] [] acc
    | Empty () => acc

:& :~ collect_repeated_group \* form.
    (owner : string) (o : occurs) (items : list (xsd particle form)) (acc : collected)
    : collected
    =
    := first = first_element_name items
    := group_name = owner ++# "_group_" ++# first
    := group = emit_named_group group_name (once_sequence items)
    collected_with (repeated_group_field first o group_name) [ type_name group_name ] group acc

:& :~ collect_choice \* form.
    (owner : string) (o : occurs) (items : list (xsd particle form)) (acc : collected)
    : collected
    =
    := choice_name = owner ++# "_choice_" ++# first_element_name items
    := field = choice_field_line (first_element_name items) o choice_name
    collected_with field [ type_name choice_name ] (emit_choice choice_name items) acc

:& :~ collect_element \* form.
    (owner : string) (name : string) (o : occurs) (type_ref : option (type_reference form))
    (inner_type : option (xsd type_def form)) (acc : collected)
    : collected
    =
    ?= inner_type ?|
    | Some inner => collect_inline_element owner name o inner acc
    | None => collected_with (referenced_field name o type_ref) (reference_dependency_of type_ref) [] acc

:& :~ collect_inline_element \* form.
    (owner : string) (name : string) (o : occurs) (inner : xsd type_def form) (acc : collected)
    : collected
    =
    := inner_name = owner ++# "_" ++# name
    := field = field_line name (with_occurs o (type_name inner_name))
    collected_with field [ type_name inner_name ] (emit_named_type inner_name inner) acc

:& :~ collect_items \* form. (owner : string) (items : list (xsd particle form)) (acc : collected) : collected =
    ?= items ?|
    | item :: rest => collect_items owner rest (collect_content owner item acc)
    | [] => acc

:& :~ emit_choice \* form. (choice_name : string) (items : list (xsd particle form)) : list emitted =
    := (cases : collected) = choice_cases choice_name items { fields = []; references = []; extra = [] }
    := ty = type_name choice_name
    plain_item ty cases::references (choice_union_text ty cases::fields) :: cases::extra

:& :~ choice_cases \* form. (choice_name : string) (items : list (xsd particle form)) (acc : collected) : collected =
    ?= items ?|
    | item :: rest => choice_cases choice_name rest (choice_case choice_name item acc)
    | [] => acc

:& :~ choice_case \* form. (choice_name : string) (item : xsd particle form) (acc : collected) : collected =
    ?= item ?|
    | Element e => element_case choice_name (tag_text e::name) e::occurs e::type_ref e::inline acc
    | Sequence s => group_case choice_name s::occurs s::items acc
    | _ => acc

:& :~ element_case \* form.
    (choice_name : string) (name : string) (o : occurs) (type_ref : option (type_reference form))
    (inline : option (xsd type_def form)) (acc : collected)
    : collected
    =
    := case_label = "    | " ++# case_name choice_name name ++# " : "
    ?= inline ?|
    | Some inner => inline_case choice_name name o inner case_label acc
    | None => emit_referenced_case case_label o type_ref acc

:& :~ inline_case \* form.
    (choice_name : string) (name : string) (o : occurs) (inner : xsd type_def form) (case_label : string)
    (acc : collected)
    : collected
    =
    := inner_name = choice_name ++# "_" ++# name
    := field = case_label ++# with_occurs o (type_name inner_name)
    collected_with field [ type_name inner_name ] (emit_named_type inner_name inner) acc

:& :~ group_case \* form.
    (choice_name : string) (o : occurs) (items : list (xsd particle form)) (acc : collected)
    : collected
    =
    := first = first_element_name items
    := group_name = choice_name ++# "_group_" ++# first
    := group = emit_named_group group_name (sequence_of o items)
    collected_with (group_case_field choice_name first group_name) [ type_name group_name ] group acc

:& :~ collect_attributes \* form.
    (owner : string) (attributes : list (xsd attribute_decl form)) (acc : collected)
    : collected
    =
    ?= attributes ?|
    | (Attribute a) :: rest =>
        collect_attributes owner rest (emit_attribute_collected owner a::name a::required a::inline a::type_ref acc)
    | [] => acc

:& :~ emit_attribute_collected \* form.
    (owner : string) (name : tag_name) (required : bool) (inline : option (xsd type_def form))
    (type_ref : option (type_reference form)) (acc : collected)
    : collected
    =
    := inner_name = owner ++# "_" ++# tag_text name
    := extra = ?= inline ?| Some inner => emit_named_type inner_name inner | None => []
    emit_attribute_with inner_name name required inline type_ref extra acc

:= emit_type \* form. (item : xsd type_def form) : list emitted = emit_named_type (xsd_resolve::type_name_of item) item

:= emit_root \* form. (item : xsd particle form) : list emitted =
    ?= item ?|
    | Element e => ?= e::inline ?| Some inner => emit_named_type (tag_text e::name) inner | None => []
    | _ => []

:~ ^ emit_types \* form. (types : list (xsd type_def form)) (acc : list emitted) : list emitted =
    ?= types ?|
    | item :: rest => emit_types rest (listm::append (emit_type item) acc)
    | [] => acc

:~ ^ emit_roots \* form. (items : list (xsd particle form)) (acc : list emitted) : list emitted =
    ?= items ?|
    | item :: rest => emit_roots rest (listm::append (emit_root item) acc)
    | [] => acc

:~ ^ emitted_names (items : list emitted) (acc : list string) : list string =
    ?= items ?|
    | item :: rest => emitted_names rest (item::name :: acc)
    | [] => acc

:~ ^ unique_emitted (items : list emitted) (seen : list string) (acc : list emitted) : list emitted =
    ?= items ?|
    | item :: rest =>
        ? has_name item::name seen ?> unique_emitted rest seen acc
        |: unique_emitted rest (item::name :: seen) (item :: acc)
    | [] => reverse acc []

:~ ^ references_ready (references : list string) (done_names : list string) : bool =
    ?= references ?|
    | reference :: rest => has_name reference done_names && references_ready rest done_names
    | [] => !+

:~ ^ known_references (references : list string) (known : list string) (acc : list string) : list string =
    ?= references ?|
    | reference :: rest => known_references rest known (? has_name reference known ?> (reference :: acc) |: acc)
    | [] => reverse acc []

:~ ^ with_known_references (items : list emitted) (known : list string) (acc : list emitted) : list emitted =
    ?= items ?|
    | item :: rest =>
        with_known_references rest known ({ item ?| references = known_references item::references known [] } :: acc)
    | [] => reverse acc []

:~ ^ order_pass
    (pending : list emitted) (known : list string) (done_names : list string) (ordered : list emitted)
    (deferred : list emitted)
    : list string * list emitted * list emitted
    =
    ?= pending ?|
    | item :: rest => emit_order_step item rest known done_names ordered deferred
    | [] => done_names, ordered, reverse deferred []

:& :~ emit_order_step
    (item : emitted) (rest : list emitted) (known : list string) (done_names : list string) (ordered : list emitted)
    (deferred : list emitted)
    : list string * list emitted * list emitted
    =
    ? references_ready item::references done_names
    ?> order_pass rest known (item::name :: done_names) (item :: ordered) deferred
    |: order_pass rest known done_names ordered (item :: deferred)

:= reindented_fields (fields : string) : string =
    ? fields = "" ?> ""
    |: "    " ++# sm'::replace "\n" "\n    " (sm'::substring 0i32 (sm'::length fields - 1i32) fields) ++# "\n"

:= record_fields_of (item : emitted) : string =
    := opening = "nominal " ++# item::name ++# " =\n    {\n"
    := closing = "    }\n"
    sm'::substring (sm'::length opening) (sm'::length item::text - sm'::length opening - sm'::length closing) item::text

:= wrapped_record (head : string) (item : emitted) : string =
    := fields = record_fields_of item
    head
    ++# item::name
    ++# " =\n    | Record_"
    ++# item::name
    ++# " :\n        {\n"
    ++# reindented_fields fields
    ++# "        }\n"

:= is_nominal_record (item : emitted) : bool = sm'::starts_with ("nominal " ++# item::name ++# " =\n    {\n") item::text

:= is_union_item (item : emitted) : bool = sm'::starts_with ("union " ++# item::name ++# " =") item::text

:= union_tail (item : emitted) : string = sm'::substring 6i32 (sm'::length item::text - 6i32) item::text

:= emit_member_head (first : bool) : string = ? first ?> "union rec " |: "and union "

:= emit_wrapped_member (first : bool) (item : emitted) : emitted =
    { item ?| text = wrapped_record (emit_member_head first) item }

:= emit_union_member (first : bool) (item : emitted) : emitted =
    { item ?| text = emit_member_head first ++# union_tail item }

:~ ^ group_members
    (items : list emitted) (first : bool) (members : list emitted) (others : list emitted) (wrapped : list string)
    : list emitted * list string
    =
    ?= items ?|
    | item :: rest => emit_group_member item rest first members others wrapped
    | [] => listm::append (reverse members []) (reverse others []), wrapped

:& :~ emit_group_member
    (item : emitted) (rest : list emitted) (first : bool) (members : list emitted) (others : list emitted)
    (wrapped : list string)
    : list emitted * list string
    =
    ? is_nominal_record item
    ?> group_members rest !- (emit_wrapped_member first item :: members) others (item::name :: wrapped)
    |: emit_group_other item rest first members others wrapped

:& :~ emit_group_other
    (item : emitted) (rest : list emitted) (first : bool) (members : list emitted) (others : list emitted)
    (wrapped : list string)
    : list emitted * list string
    =
    ? is_union_item item
    ?> group_members rest !- (emit_union_member first item :: members) others wrapped
    |: group_members rest first members (item :: others) wrapped

:= grouped_order (deferred : list emitted) (ordered : list emitted) : list emitted * list string =
    := group, wrapped = group_members deferred !+ [] [] []
    listm::append (reverse ordered []) group, wrapped

:~ ^ order_emitted
    (pending : list emitted) (known : list string) (done_names : list string) (ordered : list emitted)
    : list emitted * list string
    =
    ?= pending ?|
    | [] => reverse ordered [], []
    | _ => next_order pending known done_names ordered

:& :~ next_order
    (pending : list emitted) (known : list string) (done_names : list string) (ordered : list emitted)
    : list emitted * list string
    =
    := done_names', ordered', deferred = order_pass pending known done_names ordered []
    ? count_list deferred = count_list pending
    ?> grouped_order deferred ordered'
    |: order_emitted deferred known done_names' ordered'

:~ ^ item_texts (items : list emitted) (acc : list string) : list string =
    ?= items ?|
    | item :: rest => item_texts rest (item::text ++# "\n" :: acc)
    | [] => reverse acc []

:= texts_of (items : list emitted) : string = sm'::concat_balanced "" (item_texts items [])

:~ ^ root_element \* form. (target : string) (roots : list (xsd particle form)) : option (xsd particle form) =
    ?= roots ?|
    | (Element e) :: rest => ? tag_text e::name = target ?> Some (Element e) |: root_element target rest
    | _ :: rest => root_element target rest
    | [] => None

:~ ^ wildcard_choice \* form. (items : list (xsd particle form)) (seen : bool) : bool =
    ?= items ?|
    | (AnyContent ()) :: rest => wildcard_choice rest !+
    | (Empty ()) :: rest => wildcard_choice rest seen
    | _ :: _ => !-
    | [] => seen

:~ ^ all_optional \* form. (items : list (xsd particle form)) : bool =
    ?= items ?|
    | (Element e) :: rest => e::occurs::min = 0i32 && all_optional rest
    | (AnyContent ()) :: rest => all_optional rest
    | (Empty ()) :: rest => all_optional rest
    | _ :: _ => !-
    | [] => !+

:= is_emptiable_sequence \* form. (o : occurs) (items : list (xsd particle form)) : bool =
    o::min = 0i32 || all_optional items

:= emptiable_element (name : tag_name) (o : occurs) (acc : list string) : list string =
    ? o::min = 0i32 ?> tag_text name :: acc |: acc

:= emptiable_group \* form. (o : occurs) (items : list (xsd particle form)) (acc : list string) : list string =
    ? is_emptiable_sequence o items ?> first_element_name items :: acc |: acc

:~ ^ emptiable_heads \* form. (items : list (xsd particle form)) (acc : list string) : list string =
    ?= items ?|
    | (Element e) :: rest => emptiable_heads rest (emptiable_element e::name e::occurs acc)
    | (Sequence s) :: rest => emptiable_heads rest (emptiable_group s::occurs s::items acc)
    | _ :: rest => emptiable_heads rest acc
    | [] => reverse acc []

:~ ^ fallback_arm (heads : list string) (text : string) : option string =
    ?= heads ?|
    | head :: rest =>
        ?= line_after ("    elif xml.has_child \"" ++# head ++# "\" children then ") text ?|
        | Some expression => Some expression
        | None => fallback_arm rest text
    | [] => None

:= fallback_replaced (heads : list string) (text : string) (failing_line : string) : string =
    ?= fallback_arm heads text ?|
    | Some expression => sm'::replace failing_line ("    else " ++# expression) text
    | None => text

:= with_empty_fallback (heads : list string) (text : string) : string =
    := otherwise = "    else xml_codec.no_alternative \""
    ?= line_after otherwise text ?|
    | Some failing => fallback_replaced heads text (otherwise ++# failing)
    | None => text

:= collapsed_sequence \* form. (o : occurs) (items : list (xsd particle form)) : xsd particle form =
    ?= items ?|
    | (Choice c) :: [] ?& is_repeated o && is_repeated c::occurs = !- =>
        Choice { c ?| occurs = { min = o::min * c::occurs::min; max = o::max } }
    | _ => ? wildcard_choice items !- ?> AnyContent () |: sequence_of o items

:= collapsed_choice \* form. (o : occurs) (items : list (xsd particle form)) : xsd particle form =
    ? wildcard_choice items !- ?> AnyContent () |: Choice { occurs = o; items = items }

:= emit_with_inline \* form. (item : xsd particle form) (inner : xsd type_def form) : xsd particle form =
    ?= item ?|
    | Element e => Element { e ?| inline = Some inner }
    | _ => item

:~ ^ dereferenced_in \* k form.
    (seen : list string) (roots : list (xsd particle form)) (item : xsd k form)
    : xsd k form
    =
    ?= item ?|
    | Complex c => Complex { c ?| content = dereferenced_in seen roots c::content }
    | Derived d => Derived { d ?| content = dereferenced_in seen roots d::content }
    | Simple _ => item
    | Element e => emit_dereferenced_element seen roots e::name e::occurs e::type_ref e::inline (Element e)
    | Sequence s => collapsed_sequence s::occurs (dereferenced_all_in seen roots s::items [])
    | Choice c => collapsed_choice c::occurs (dereferenced_all_in seen roots c::items [])
    | AnyContent () => item
    | Empty () => item
    | Attribute _ => item

:& :~ emit_dereferenced_element \* form.
    (seen : list string) (roots : list (xsd particle form)) (name : tag_name) (o : occurs)
    (type_ref : option (type_reference form)) (inline : option (xsd type_def form)) (item : xsd particle form)
    : xsd particle form
    =
    ?= inline, type_ref ?|
    | Some inner, _ => emit_with_inline item (dereferenced_in seen roots inner)
    | None, Some _ => item
    | None, None => referenced_root seen roots (xml::local_name (tag_text name)) name o item

:& :~ referenced_root \* form.
    (seen : list string) (roots : list (xsd particle form)) (local : string) (name : tag_name) (o : occurs)
    (fallback : xsd particle form)
    : xsd particle form
    =
    ?= root_element local roots ?|
    | Some (Element root) =>
        := copy = Element { root ?| occurs = o; name = name }
        ? has_name local seen ?> copy |: dereferenced_in (local :: seen) roots copy
    | _ => fallback

:& :~ dereferenced_all_in \* k form.
    (seen : list string) (roots : list (xsd particle form)) (items : list (xsd k form)) (acc : list (xsd k form))
    : list (xsd k form)
    =
    ?= items ?|
    | item :: rest => dereferenced_all_in seen roots rest (dereferenced_in seen roots item :: acc)
    | [] => reverse acc []

:= dereferenced_all \* k form.
    (roots : list (xsd particle form)) (items : list (xsd k form)) (acc : list (xsd k form))
    : list (xsd k form)
    =
    dereferenced_all_in [] roots items acc

:= dereferenced_parts \* form. (schema : xsd_schema form) : list (xsd type_def form) * list (xsd particle form) =
    dereferenced_all schema::elements schema::complex_types [], dereferenced_all schema::elements schema::elements []

:= staged_type_names \* form. (staged : list string) (schema : xsd_schema form) : list string =
    := complex_types, elements = dereferenced_parts schema
    := candidates = inline_all_candidates "" elements (named_candidates complex_types [])
    reverse (grow_staged candidates (directly_staged staged candidates [])) []

:~ ^ first_with_key (key : value_set) (items : list emitted) : option string =
    ?= items ?|
    | item :: rest => ? same_value_set item::value_set key ?> Some item::name |: first_with_key key rest
    | [] => None

:= shared_union_conversions (name : string) (first : string) : string =
    "inl " ++# name ++# "_of_string (s : string) : option " ++# name ++# " = " ++# first ++# "_of_string s\n\n"
    ++# "inl " ++# name ++# "_to_string (x : " ++# name ++# ") : string = " ++# first ++# "_to_string x\n\n"

:= shared_union_examples (name : string) (first : string) : string =
    "inl " ++# name ++# "_example (k : i32) : " ++# name ++# " = " ++# first ++# "_example k\n\n"
    ++# "inl " ++# name ++# "_example_text (k : i32) : string = " ++# first ++# "_example_text k\n"

:= shared_union_text (name : string) (first : string) : string =
    "type " ++# name ++# " = " ++# first ++# "\n\n"
    ++# shared_union_conversions name first
    ++# shared_union_examples name first

:= emit_shared_item (item : emitted) (first : string) : emitted =
    plain_item item::name (first :: []) (shared_union_text item::name first)

:~ ^ share_unions (items : list emitted) (kept : list emitted) (acc : list emitted) : list emitted =
    ?= items ?|
    | item :: rest => emit_shared_step item rest kept acc
    | [] => reverse acc []

:& :~ emit_shared_step
    (item : emitted) (rest : list emitted) (kept : list emitted) (acc : list emitted)
    : list emitted
    =
    ?= item::value_set ?|
    | NoValueSet => share_unions rest kept (item :: acc)
    | value_set => emit_shared_keyed item value_set rest kept acc

:& :~ emit_shared_keyed
    (item : emitted) (value_set : value_set) (rest : list emitted) (kept : list emitted) (acc : list emitted)
    : list emitted
    =
    ?= first_with_key value_set kept ?|
    | Some first => share_unions rest kept (emit_shared_item item first :: acc)
    | None => share_unions rest (item :: kept) (item :: acc)

:| type_kind =
    | KindText
    | KindEnum
    | KindValidated
    | KindRecord
    | KindRecursive

:= simple_kind (facets : list xsd_facet) : type_kind =
    ?= enumeration_values facets [] ?|
    | [] => ? is_constrained facets ?> KindValidated |: KindText
    | _ => KindEnum

:~ ^ kinds_of \* form.
    (types : list (xsd type_def form)) (acc : list (string * type_kind))
    : list (string * type_kind)
    =
    ?= types ?|
    | (Simple s) :: rest => kinds_of rest ((type_name (definition_text s::name), simple_kind s::facets) :: acc)
    | (Complex c) :: rest => kinds_of rest ((type_name (definition_text c::name), KindRecord) :: acc)
    | (Derived d) :: rest => kinds_of rest ((type_name (definition_text d::name), KindRecord) :: acc)
    | [] => acc

:~ ^ first_validated (kinds : list (string * type_kind)) : option string =
    ?= kinds ?|
    | (name, KindValidated) :: _ => Some name
    | _ :: rest => first_validated rest
    | [] => None

:= any_validated_type \* form. (schema : xsd_schema form) : option string =
    first_validated (kinds_of schema::simple_types [])

:~ ^ kind_lookup (target : string) (kinds : list (string * type_kind)) : type_kind =
    ?= kinds ?|
    | (name, kind) :: rest => ? name = target ?> kind |: kind_lookup target rest
    | [] => KindText

:~ ^ recursive_kinds
    (kinds : list (string * type_kind)) (wrapped : list string) (acc : list (string * type_kind))
    : list (string * type_kind)
    =
    ?= kinds ?|
    | (name, kind) :: rest =>
        recursive_kinds rest wrapped ((name, ? has_name name wrapped ?> KindRecursive |: kind) :: acc)
    | [] => reverse acc []

:= primed_head (ty : string) (head : string) : string =
    sm'::replace ("(x : " ++# ty ++# ")") ("(x' : " ++# ty ++# ")") head

:= unwrapped_body (rest : string) : string =
    ? sm'::starts_with "\n" rest ?> rest |: "\n    " ++# sm'::substring 1i32 (sm'::length rest - 1i32) rest

:= unwrap_text (ty : string) : string = "\n    inl x = match x' with | Record_" ++# ty ++# " r => r"

:= unwrapped_parameter (ty : string) (head : string) (text : string) : string =
    := rest = sm'::substring (sm'::length head) (sm'::length text - sm'::length head) text
    sm'::replace
        (ty ++# "_get f x)")
        (ty ++# "_get f x')")
        (primed_head ty head ++# unwrap_text ty ++# unwrapped_body rest)

:= builds_record (ty : string) (text : string) : bool =
    sm'::starts_with ("and let " ++# ty ++# "_of_children") text
    || sm'::starts_with ("and let " ++# ty ++# "_example ") text

:= record_constructors (ty : string) (text : string) : string =
    sm'::replace ("\n    " ++# ty ++# " {\n") ("\n    Record_" ++# ty ++# " {\n") text
    |> sm'::replace ("(fun () => " ++# ty ++# " { ") ("(fun () => Record_" ++# ty ++# " { ")

:= emit_recursive_getter (ty : string) (text : string) : string =
    := getter = "inl " ++# ty ++# "_get forall r. (f : " ++# ty ++# "_field r) (x : " ++# ty ++# ") : r ="
    ? sm'::starts_with getter text ?> unwrapped_parameter ty getter text
    |? builds_record ty text ?> record_constructors ty text
    |: text

:= emit_recursive_attributes (ty : string) (text : string) : string =
    := attributes = "and let " ++# ty ++# "_attributes (x : " ++# ty ++# ") : list (string * string) ="
    ? sm'::starts_with attributes text ?> unwrapped_parameter ty attributes text |: emit_recursive_getter ty text

:= recursive_text (ty : string) (text : string) : string =
    := children = "and let " ++# ty ++# "_children (x : " ++# ty ++# ") : list xml.xml_node ="
    ? sm'::starts_with children text ?> unwrapped_parameter ty children text |: emit_recursive_attributes ty text

:~ ^ claimed_names \* form. (items : list (xsd particle form)) (acc : list string) : list string =
    ?= items ?|
    | (Element e) :: rest => claimed_names rest (tag_text e::name :: acc)
    | (Sequence s) :: rest => claimed_names (listm::append s::items rest) acc
    | (Choice c) :: rest => claimed_names (listm::append c::items rest) acc
    | _ :: rest => claimed_names rest acc
    | [] => reverse acc []

:= is_required_once (o : occurs) : bool = ?= shape_of o ?| Required => !+ | _ => !-

:= reader_of (kind : type_kind) (t : string) : string =
    ?= kind ?|
    | KindText => "xml_codec.read_text"
    | KindEnum | KindValidated => "(xml_codec.read_value " ++# t ++# "_of_string)"
    | KindRecord | KindRecursive => t ++# "_of_xml"

:= read_call (name : string) (o : occurs) (reader : string) : string =
    := tail = "\"" ++# name ++# "\" " ++# reader ++# " children errors"
    ?= shape_of o ?|
    | Optional => "xml_codec.read_optional " ++# tail
    | Required => "xml_codec.read_required " ++# tail
    | Repeated => "xml_codec.read_repeated " ++# tail

:= arm_tail (name : string) (reader : string) : string = "\"" ++# name ++# "\" " ++# reader ++# " children"

:= arm_read (name : string) (o : occurs) (reader : string) : string =
    ?= shape_of o ?|
    | Required => "xml_codec.read_child " ++# arm_tail name reader
    | Optional => "xml_codec.pair_decoded (xml_codec.read_optional " ++# arm_tail name reader ++# " [])"
    | Repeated => "xml_codec.pair_decoded (xml_codec.read_repeated " ++# arm_tail name reader ++# " [])"

:= binding (field : string) (expression : string) : string = "    inl v_" ++# field ++# ", errors = " ++# expression

:= option_binding (field : string) (expression : string) : string =
    "    inl o_" ++# field ++# ", errors = " ++# expression

:= field_binding (field : string) (o : occurs) (expression : string) : string =
    ? is_required_once o ?> option_binding field expression |: binding field expression

:= bound_name (head : string) : string = sm'::substring 10i32 (sm'::length head - 10i32) head

:= present_binding (head : string) : string = bound_name head ++# " = xml_codec.present o_" ++# bound_name head

:= bound_field (line : string) : option string =
    ?= sm'::split_list ", errors =" line ?|
    | head :: _ ?& sm'::starts_with "    inl v_" head => Some (bound_name head ++# " = v_" ++# bound_name head)
    | head :: _ ?& sm'::starts_with "    inl o_" head => Some (present_binding head)
    | _ => None

:~ ^ record_fields (lines : list string) (acc : list string) : list string =
    ?= lines ?|
    | line :: rest =>
        ?= bound_field line ?|
        | Some field => record_fields rest (field :: acc)
        | None => record_fields rest acc
    | [] => reverse acc []

:= built_record (ty : string) (fields : list string) : string =
    ? fields = [] ?> "()" |: ty ++# " { " ++# join_with "; " fields "" ++# " }"

:= decoded_body (ty : string) (lines : list string) : string =
    := built = built_record ty (record_fields lines [])
    := result = "    xml_codec.decoded_by errors (fun () => " ++# built ++# ")\n"
    "    inl errors = []\n" ++# join_lines lines "" ++# result

:= decode_result (ty : string) : string = "result (" ++# ty ++# ") (list xml_codec.decode_error)"

:= any_claim_text \* form. (content : xsd particle form) : string =
    := quoted = listm::map (\ n => "\"" ++# n ++# "\"") (claimed_names (content :: []) [])
    "any_content_of (xml.unclaimed_children [" ++# join_with "; " quoted "" ++# "] children), errors"

:= with_any_claims \* form. (content : xsd particle form) (texts : list string) : list string =
    listm::map
        (sm'::replace (binding "any" "[], errors" ++# "\n") (binding "any" (any_claim_text content) ++# "\n"))
        texts

:= recursive_texts (kinds : list (string * type_kind)) (ty : string) (texts : list string) : list string =
    ?= kind_lookup ty kinds ?|
    | KindRecursive => listm::map (recursive_text ty) texts
    | _ => texts

:= builtin_value_kind (reference : string) : type_kind =
    ?= builtin_carrier reference ?|
    | Some _ => KindValidated
    | None => KindText

:= reference_kind (reference : string) (kinds : list (string * type_kind)) : type_kind =
    ? is_builtin_reference reference
    ?> builtin_value_kind reference
    |: kind_lookup (type_name (xml::local_name reference)) kinds

:= reference_kind_of \* form.
    (reference : option (type_reference form)) (kinds : list (string * type_kind))
    : type_kind
    =
    ?= reference ?|
    | Some r => reference_kind (reference_text r) kinds
    | None => KindText

:= inline_kind \* form. (inner : xsd type_def form) : type_kind =
    ?= inner ?|
    | Simple s => simple_kind s::facets
    | _ => KindRecord

:= quoted_name (acc : string) (name : string) : string =
    ? acc = "" ?> "\"" ++# name ++# "\"" |: acc ++# "; \"" ++# name ++# "\""

:~ ^ single_element_arms \* form. (items : list (xsd particle form)) : bool =
    ?= items ?|
    | (Element _) :: rest => single_element_arms rest
    | (AnyContent ()) :: rest => single_element_arms rest
    | _ :: _ => !-
    | [] => !+

:~ ^ choice_names \* form. (items : list (xsd particle form)) (acc : string) : string =
    ?= items ?|
    | (Element e) :: rest => choice_names rest (quoted_name acc (tag_text e::name))
    | (Sequence s) :: rest => choice_names rest (quoted_name acc (first_element_name s::items))
    | _ :: rest => choice_names rest acc
    | [] => acc

:= record_base_binding (t : string) : string =
    option_binding "base" ("xml_codec.taken (" ++# t ++# "_of_children attributes children) errors")

:= coded_base_binding (t : string) : string =
    option_binding
        "base"
        ("xml_codec.taken (xml_codec.parsed_text " ++# t ++# "_of_string (xml.text_in children)) errors")

:= base_field \* form. (kinds : list (string * type_kind)) (base : type_reference form) : string =
    ?= reference_kind (reference_text base) kinds ?|
    | KindRecord | KindRecursive => record_base_binding (reference_type base)
    | KindEnum | KindValidated => coded_base_binding (reference_type base)
    | KindText => binding "base" "xml.text_in children, errors"

:= attribute_type \* form.
    (kinds : list (string * type_kind)) (owner : string) (name : string) (type_reference : option (type_reference form))
    (inline : option (xsd type_def form))
    : string * type_kind
    =
    ?= inline ?|
    | Some inner => type_name (owner ++# "_" ++# name), inline_kind inner
    | None => reference_type_of type_reference, reference_kind_of type_reference kinds

:= value_node (kind : type_kind) (t : string) (name : string) (v : string) : string =
    ?= kind ?|
    | KindText => "xml.element \"" ++# name ++# "\" [] (xml.text_children " ++# v ++# ")"
    | KindEnum | KindValidated => "text_node \"" ++# name ++# "\" " ++# v
    | KindRecord | KindRecursive => t ++# "_to_xml \"" ++# name ++# "\" " ++# v

:= is_coded_kind (kind : type_kind) : bool = ?= kind ?| KindEnum | KindValidated => !+ | _ => !-

:= mapped_value_text (kind : type_kind) (t : string) (name : string) : string =
    "(fun v => " ++# value_node kind t name "v" ++# ")"

:= occurs_part (name : string) (o : occurs) (kind : type_kind) (t : string) (source : string) : string =
    ?= shape_of o ?|
    | Optional ?& is_coded_kind kind => "optional_text_nodes \"" ++# name ++# "\" " ++# source
    | Repeated ?& is_coded_kind kind => "repeated_text_nodes \"" ++# name ++# "\" " ++# source
    | Optional => "xml.option_list (optionm.map " ++# mapped_value_text kind t name ++# " " ++# source ++# ")"
    | Required => "[" ++# value_node kind t name source ++# "]"
    | Repeated => "listm.map " ++# mapped_value_text kind t name ++# " " ++# source

:= concat_parts (parts : list string) : string =
    ?= parts ?|
    | [] => "[]"
    | only :: [] => only
    | _ => "listm.concat [" ++# join_with "; " parts "" ++# "]"

:= attribute_value_text (kind : type_kind) (t : string) (v : string) : string =
    ?= kind ?|
    | KindEnum | KindValidated => "to_text " ++# v
    | _ => v

:= base_children \* form. (kinds : list (string * type_kind)) (base : type_reference form) : list string =
    ?= reference_kind (reference_text base) kinds ?|
    | KindRecord | KindRecursive => reference_type base ++# "_children x.base" :: []
    | KindEnum | KindValidated => "xml.text_children (to_text x.base)" :: []
    | KindText => "xml.text_children x.base" :: []

:= base_attributes \* form. (kinds : list (string * type_kind)) (base : type_reference form) : list string =
    ?= reference_kind (reference_text base) kinds ?|
    | KindRecord | KindRecursive => reference_type base ++# "_attributes x.base" :: []
    | _ => []

:= value_example (kind : type_kind) (t : string) (reference : string) (variant : string) : string =
    ?= kind ?|
    | KindText =>
        ? is_builtin_reference reference ?> "\"" ++# escape_text (builtin_example reference) ++# "\""
        |: t ++# "_example " ++# variant
    | _ => t ++# "_example " ++# variant

:~ ^ repeated_items (value : string -> string) (index : i32) (count : i32) (acc : list string) : list string =
    ? index >= count ?> reverse acc []
    |: repeated_items value (index + 1i32) count (value ("(k + " ++# int_text index ++# "i32)") :: acc)

:= repeated_list (value : string -> string) (count : i32) : string =
    ? count <= 0i32 ?> "[]" |: "[" ++# join_with "; " (repeated_items value 0i32 count []) "" ++# "]"

:= fixed_example (kind : type_kind) (t : string) (fixed : string) : string =
    ?= kind ?|
    | KindEnum | KindValidated =>
        "xml.required_value \"" ++# t ++# "\" (" ++# t ++# "_of_string \"" ++# escape_text fixed ++# "\")"
    | _ => "\"" ++# escape_text fixed ++# "\""

:= occurs_example (o : occurs) (value : string -> string) : string =
    ?= shape_of o ?|
    | Optional => "None"
    | Required => value "k"
    | Repeated => repeated_list value o::min

:= value_example_of \* form.
    (kinds : list (string * type_kind)) (reference : option (type_reference form)) (variant : string)
    : string
    =
    ?= reference ?|
    | Some r => value_example (reference_kind (reference_text r) kinds) (reference_type r) (reference_text r) variant
    | None => value_example KindText "string" "" variant

:| reading = | Reading
:| writing = | Writing
:| exampling = | Exampling

:== witness = { case : string; t : string; field : string; fragment : string; tag : string; occurs : occurs }

:== part = { text : string; witness : option witness }

:= plain (text : string) : part = { text = text; witness = None }

:= part_text (p : part) : string = p::text

:| walk_text =
    | FunctionText : string
    | ItemText : string

:~ ^ function_parts (texts : list walk_text) (acc : list string) : list string =
    ?= texts ?|
    | FunctionText t :: rest => function_parts rest (t :: acc)
    | ItemText _ :: rest => function_parts rest acc
    | [] => reverse acc []

:~ ^ all_witnessed (parts : list part) (acc : list witness) : option (list witness) =
    ?= parts ?|
    | p :: rest =>
        ?= p::witness ?|
        | Some w => all_witnessed rest (w :: acc)
        | None => None
    | [] => ? listm::length acc = 0i32 ?> None |: Some (reverse acc [])

:= witness_union (ty : string) (witnesses : list witness) : string =
    := case_line (w : witness) = "    | " ++# w::case ++# " :: " ++# ty ++# "_field (" ++# w::t ++# ")"
    join_lines ("union " ++# ty ++# "_field r =" :: listm::map case_line witnesses) ""

:= witness_get (ty : string) (witnesses : list witness) : string =
    := arm (w : witness) = "    | " ++# w::case ++# " => x." ++# w::field
    := head = "inl " ++# ty ++# "_get forall r. (f : " ++# ty ++# "_field r) (x : " ++# ty ++# ") : r ="
    join_lines (head :: "    match f with" :: listm::map arm witnesses) ""

:= packed_case (w : witness) : string = "exists " ++# w::case

:= witness_fields (ty : string) (witnesses : list witness) : string =
    := cases = join_with "; " (listm::map packed_case witnesses) ""
    "inl " ++# ty ++# "_fields () : list (exists r. " ++# ty ++# "_field r) = [" ++# cases ++# "]"

:= bound_text (b : occurs_bound) : string = ?= b ?| Bounded n => "Some " ++# int_text n ++# "i32" | Unbounded => "None"

:= meta_record (w : witness) : string =
    := bounds = "; min = " ++# int_text w::occurs::min ++# "i32; max = " ++# bound_text w::occurs::max
    "{ tag = \"" ++# escape_text w::tag ++# "\"" ++# bounds ++# " }"

:= meta_arm (w : witness) : string = "    | " ++# w::case ++# " => " ++# meta_record w

:= witness_meta (ty : string) (witnesses : list witness) : string =
    := head = "inl " ++# ty ++# "_field_meta forall r. (f : " ++# ty ++# "_field r) : xml_codec.field_meta ="
    join_lines (head :: "    match f with" :: listm::map meta_arm witnesses) ""

:= emit_walk_tail_lines (ty : string) (witnesses : list witness) : list string =
    "            inl exists r. f = packed"
    :: ("            listm.append (nodes f (" ++# ty ++# "_get f x)) (walk rest)")
    :: "        | [] => []"
    :: ("    walk [" ++# join_with "; " (listm::map packed_case witnesses) "" ++# "]")
    :: []

:= witness_walk_lines (ty : string) (witnesses : list witness) : list string =
    ("    inl rec walk (fields : list (exists r. " ++# ty ++# "_field r)) : list xml.xml_node =")
    :: "        match fields with"
    :: "        | packed :: rest =>"
    :: emit_walk_tail_lines ty witnesses

:= witness_arm (w : witness) : string = "        | " ++# w::case ++# " => " ++# w::fragment

:= emit_nodes_lines (ty : string) (witnesses : list witness) : list string =
    ("    inl nodes forall r. (f : " ++# ty ++# "_field r) (v : r) : list xml.xml_node =")
    :: "        match f with"
    :: listm::append (listm::map witness_arm witnesses) (witness_walk_lines ty witnesses)

:= witness_children (ty : string) (witnesses : list witness) : string =
    := head = "and let " ++# ty ++# "_children (x : " ++# ty ++# ") : list xml.xml_node ="
    join_lines (head :: emit_nodes_lines ty witnesses) ""

:== walked = { parts : list part; attribute_parts : list string; functions : list walk_text }

:== element_view form =
    {
        name : string
        occurs : occurs
        kind : type_kind
        t : string
        inline : bool
        type_ref : option (type_reference form)
    }

:== attribute_view form =
    {
        owner : string
        name : string
        required : bool
        fixed : option string
        inline : bool
        type_ref : option (type_reference form)
        kind : type_kind
        t : string
    }

:= nothing_walked () : walked = { parts = []; attribute_parts = []; functions = [] }

:= push_part (p : part) (functions : list walk_text) (acc : walked) : walked =
    {
        parts = p :: acc::parts
        attribute_parts = acc::attribute_parts
        functions = listm::append functions acc::functions
    }

:= push (part : string) (functions : list walk_text) (acc : walked) : walked =
    {
        parts = plain part :: acc::parts
        attribute_parts = acc::attribute_parts
        functions = listm::append functions acc::functions
    }

:= record_body (ty : string) (lines : list string) : string =
    ?= lines ?|
    | [] => "    ()\n"
    | _ => "    " ++# ty ++# " {\n" ++# join_lines lines "" ++# "    }\n"

:? derived_prefix f : \* form. f -> list (string * type_kind) -> type_reference form -> walked

:? record_texts f : f -> string -> list part -> list string -> list string

:? choice_part f : \* form. f -> occurs -> list (xsd particle form) -> string -> string -> string

:? group_part f : \* form. f -> occurs -> list (xsd particle form) -> string -> string -> string

:? element_part f : \* form. f -> list (string * type_kind) -> element_view form -> string

:? any_part f : f -> string

:? attribute_step f : \* form. f -> walked -> attribute_view form -> walked

:? element_arm f : \* form. f -> list (string * type_kind) -> string -> element_view form -> string

:? group_arm f : f -> string -> string -> string -> string

:? choice_text f : f -> string -> list string -> string

:? first_arm_only f : f -> bool

:? witness_items f : f -> string -> list part -> list string

:? element_witness f : \* form. f -> string -> element_view form -> option witness

:? choice_witness f : f -> string -> occurs -> string -> string -> option witness

:? any_witness f : f -> string -> option witness

:= coded_attribute_read (field : string) (required : bool) (t : string) (key : string) : string =
    ? required ?> option_binding field ("xml_codec.attribute_parsed " ++# t ++# "_of_string " ++# key)
    |: binding field ("xml_codec.attribute_optional_parsed " ++# t ++# "_of_string " ++# key)

:= plain_attribute_read (field : string) (name : string) (required : bool) (key : string) : string =
    ? required ?> binding field ("xml_codec.attribute_required " ++# key)
    |: binding field ("xml.attribute_of \"" ++# name ++# "\" attributes, errors")

:= fixed_check_text (name : string) (value : string) : string =
    "\n    inl errors = xml_codec.fixed_checked \""
    ++# name
    ++# "\" \""
    ++# escape_text value
    ++# "\" attributes errors"

:= attribute_read
    (field : string) (name : string) (required : bool) (kind : type_kind) (t : string) (key : string)
    : string
    =
    ? is_coded_kind kind ?> coded_attribute_read field required t key |: plain_attribute_read field name required key

:= attribute_binding
    (field : string) (name : string) (required : bool) (fixed : option string) (kind : type_kind) (t : string)
    : string
    =
    := read = attribute_read field name required kind t ("\"" ++# name ++# "\" attributes errors")
    ?= fixed ?|
    | Some value => read ++# fixed_check_text name value
    | None => read

:= emit_reading_of_children (ty : string) (parts : list part) : string =
    fitted_header
        ("and let " ++# ty ++# "_of_children")
        "(attributes : list (string * string)) (children : list xml.xml_node)"
        (decode_result ty)
    ++# decoded_body ty (listm::map part_text parts)

:= emit_reading_of_xml (ty : string) : string =
    fitted_definition
        ("and let " ++# ty ++# "_of_xml (c : xml.xml_node) : " ++# decode_result ty ++# " =")
        (ty ++# "_of_children (xml.element_attributes c) (xml.element_children c)")

:= emit_optional_choice_read \* form. (items : list (xsd particle form)) (read : string) : string =
    "xml_codec.optional_taken (if xml.has_any_child ["
    ++# choice_names items ""
    ++# "] children then Some ("
    ++# read
    ++# ") else None) errors"

:= emit_claimed_choice_read \* form. (items : list (xsd particle form)) (ty : string) : string =
    "xml_codec.all_taken (listm.map (fun c => "
    ++# ty
    ++# "_of_children attributes [c]) (xml.claimed_children ["
    ++# choice_names items ""
    ++# "] children)) errors"

:= emit_repeated_choice_read \* form.
    (items : list (xsd particle form)) (ty : string) (field : string) (read : string)
    : string
    =
    ? single_element_arms items ?> binding field (emit_claimed_choice_read items ty)
    |: binding field ("xml_codec.all_taken [" ++# read ++# "] errors")

:= emit_reading_choice_part \* form.
    (o : occurs) (items : list (xsd particle form)) (ty : string) (field : string) (read : string)
    : string
    =
    ?= shape_of o ?|
    | Optional => binding field (emit_optional_choice_read items read)
    | Required => option_binding field ("xml_codec.taken (" ++# read ++# ") errors")
    | Repeated => emit_repeated_choice_read items ty field read

:= emit_group_runs_read \* form. (items : list (xsd particle form)) (ty : string) : string =
    "xml_codec.all_taken (listm.map (fun run => "
    ++# ty
    ++# "_of_children [] run) (xml.group_runs ["
    ++# choice_names items ""
    ++# "] children)) errors"

:= emit_reading_choice_head (ty : string) : string =
    "and let "
    ++# ty
    ++# "_of_children (attributes : list (string * string)) (children : list xml.xml_node) : "
    ++# decode_result ty
    ++# " =\n    if false then xml_codec.no_alternative \""
    ++# ty
    ++# "\"\n"

:= emit_reading_choice_text (choice_name : string) (arms : list string) : string =
    := ty = type_name choice_name
    emit_reading_choice_head ty ++# join_lines arms "" ++# "    else xml_codec.no_alternative \"" ++# ty ++# "\"\n"

:+ derived_prefix reading =
    \ _ kinds base => { parts = plain (base_field kinds base) :: []; attribute_parts = []; functions = [] }

:+ record_texts reading = \ _ ty parts _ => emit_reading_of_children ty parts :: emit_reading_of_xml ty :: []

:+ choice_part reading =
    \ _ o items ty field => emit_reading_choice_part o items ty field (ty ++# "_of_children attributes children")

:+ group_part reading = \ _ _ items ty field => binding field (emit_group_runs_read items ty)

:+ element_part reading = \ _ _ v =>
    field_binding (field_name v::name) v::occurs (read_call v::name v::occurs (reader_of v::kind v::t))

:+ any_part reading = \ _ => binding "any" "[], errors"

:+ attribute_step reading =
    \ _ acc a => push (attribute_binding (field_name a::name) a::name a::required a::fixed a::kind a::t) [] acc

:+ element_arm reading = \ _ _ choice_name v =>
    "    elif xml.has_child \""
    ++# v::name
    ++# "\" children then xml_codec.mapped (fun v => "
    ++# case_name choice_name v::name
    ++# " v) ("
    ++# arm_read v::name v::occurs (reader_of v::kind v::t)
    ++# ")"

:= emit_reading_group_arm (choice_name : string) (first : string) (group_name : string) : string =
    "    elif xml.has_child \""
    ++# first
    ++# "\" children then xml_codec.mapped (fun v => "
    ++# case_name choice_name ("group_" ++# first)
    ++# " v) ("
    ++# type_name group_name
    ++# "_of_children attributes children)"

:+ group_arm reading = \ _ choice_name first group_name => emit_reading_group_arm choice_name first group_name

:+ choice_text reading = \ _ choice_name arms => emit_reading_choice_text choice_name arms

:+ first_arm_only reading = \ _ => !-

:+ witness_items reading = \ _ _ _ => []

:+ element_witness reading = \ _ _ _ => None

:+ choice_witness reading = \ _ _ _ _ _ => None

:+ any_witness reading = \ _ _ => None

:| staged_reading = | StagedReading : list string * list string

:= is_staged_signature (signatures : list string) (name : string) (o : occurs) : bool =
    has_name (xml::local_name name) signatures && o::min >= 1i32

:= emit_staged_children_parameters () : string =
    "(witness : stage s) (attributes : list (string * string)) (children : list xml.xml_node)"

:= emit_staged_of_children (ty : string) (parts : list part) : string =
    fitted_header
        ("and let " ++# ty ++# "_of_children forall s.")
        (emit_staged_children_parameters ())
        (decode_result (ty ++# " s"))
    ++# decoded_body ty (listm::map part_text parts)

:= emit_staged_of_xml_head (ty : string) : string =
    "and let "
    ++# ty
    ++# "_of_xml forall s. (witness : stage s) (c : xml.xml_node) : "
    ++# decode_result (ty ++# " s")
    ++# " ="

:= emit_staged_of_xml (ty : string) : string =
    fitted_definition (emit_staged_of_xml_head ty) (
        ty ++# "_of_children witness (xml.element_attributes c) (xml.element_children c)"
    )

:= emit_staged_reading_records
    (staged : list string) (ty : string) (parts : list part) (attribute_parts : list string)
    : list string
    =
    ? has_name ty staged = !- ?> record_texts Reading ty parts attribute_parts
    |: emit_staged_of_children ty parts :: emit_staged_of_xml ty :: []

:= emit_signed_call \* form. (v : element_view form) : string =
    := call = read_call v::name v::occurs (reader_of v::kind v::t)
    ? is_required_once v::occurs ?> call |: "xml_codec.as_some (" ++# call ++# ")"

:= emit_signed_element_read \* form. (v : element_view form) : string =
    option_binding (field_name v::name) ("staged_read witness (fun errors => " ++# emit_signed_call v ++# ") errors")

:= emit_staged_element_field \* form. (v : element_view form) : string =
    field_binding (field_name v::name) v::occurs (read_call v::name v::occurs ("(" ++# v::t ++# "_of_xml witness)"))

:= emit_staged_element_read \* form.
    (staged : list string) (signatures : list string) (kinds : list (string * type_kind)) (v : element_view form)
    : string
    =
    ? is_staged_signature signatures v::name v::occurs ?> emit_signed_element_read v
    |? has_name v::t staged ?> emit_staged_element_field v
    |: element_part Reading kinds v

:+ derived_prefix staged_reading = \ _ kinds base => derived_prefix Reading kinds base

:+ record_texts staged_reading =
    \ f ty parts attribute_parts =>
        ?= f ?| StagedReading (staged, _) => emit_staged_reading_records staged ty parts attribute_parts

:+ choice_part staged_reading = \ _ o items ty field => choice_part Reading o items ty field

:+ group_part staged_reading = \ _ o items ty field => group_part Reading o items ty field

:+ element_part staged_reading =
    \ f kinds v => ?= f ?| StagedReading (staged, signatures) => emit_staged_element_read staged signatures kinds v

:+ any_part staged_reading = \ _ => any_part Reading

:+ attribute_step staged_reading = \ _ acc a => attribute_step Reading acc a

:+ element_arm staged_reading = \ _ kinds choice_name v => element_arm Reading kinds choice_name v

:+ group_arm staged_reading = \ _ choice_name first group_name => group_arm Reading choice_name first group_name

:+ choice_text staged_reading = \ _ choice_name arms => choice_text Reading choice_name arms

:+ first_arm_only staged_reading = \ _ => first_arm_only Reading

:+ witness_items staged_reading = \ _ ty parts => witness_items Reading ty parts

:+ element_witness staged_reading = \ _ owner v => element_witness Reading owner v

:+ choice_witness staged_reading = \ _ owner o field choice => choice_witness Reading owner o field choice

:+ any_witness staged_reading = \ _ owner => any_witness Reading owner

:= emit_plain_children (ty : string) (parts : list part) : string =
    fitted_definition
        ("and let " ++# ty ++# "_children (x : " ++# ty ++# ") : list xml.xml_node =")
        (concat_parts (listm::map part_text parts))

:= emit_writing_children (ty : string) (parts : list part) : string =
    ?= all_witnessed parts [] ?|
    | Some witnesses => witness_children ty witnesses
    | None => emit_plain_children ty parts

:= emit_writing_attributes (ty : string) (attribute_parts : list string) : string =
    fitted_definition
        ("and let " ++# ty ++# "_attributes (x : " ++# ty ++# ") : list (string * string) =")
        (concat_parts attribute_parts)

:= emit_writing_to_xml (ty : string) : string =
    fitted_definition
        ("and let " ++# ty ++# "_to_xml (name : string) (x : " ++# ty ++# ") : xml.xml_node =")
        ("xml.element name (" ++# ty ++# "_attributes x) (" ++# ty ++# "_children x)")

:= emit_writing_choice_part (o : occurs) (ty : string) (source : string) : string =
    ?= shape_of o ?|
    | Optional => "xml.option_concat (optionm.map " ++# ty ++# "_children " ++# source ++# ")"
    | Required => ty ++# "_children " ++# source
    | Repeated => "listm.concat (listm.map " ++# ty ++# "_children " ++# source ++# ")"

:= emit_optional_attribute_part \* form. (a : attribute_view form) (source : string) : string =
    "xml.option_list (optionm.map (fun v => (\""
    ++# a::name
    ++# "\", "
    ++# attribute_value_text a::kind a::t "v"
    ++# ")) "
    ++# source
    ++# ")"

:= emit_writing_attribute_part \* form. (a : attribute_view form) : string =
    := source = "x." ++# field_name a::name
    ? a::required ?> "[(\"" ++# a::name ++# "\", " ++# attribute_value_text a::kind a::t source ++# ")]"
    |: emit_optional_attribute_part a source

:= emit_witness_texts (ty : string) (witnesses : list witness) : list string =
    witness_union ty witnesses
    :: witness_get ty witnesses
    :: witness_fields ty witnesses
    :: witness_meta ty witnesses
    :: []

:= emit_element_witness \* form. (owner : string) (v : element_view form) : witness =
    {
        case = case_name (owner ++# "_field") v::name
        t = with_occurs v::occurs v::t
        field = field_name v::name
        fragment = occurs_part v::name v::occurs v::kind v::t "v"
        tag = v::name
        occurs = v::occurs
    }

:= emit_choice_witness (owner : string) (o : occurs) (ty : string) (field : string) : witness =
    {
        case = case_name (owner ++# "_field") field
        t = with_occurs o ty
        field = field
        fragment = emit_writing_choice_part o ty "v"
        tag = field
        occurs = o
    }

:+ derived_prefix writing = \ _ kinds base =>
    := parts = listm::map plain (base_children kinds base)
    { parts = parts; attribute_parts = base_attributes kinds base; functions = [] }

:+ record_texts writing = \ _ ty parts attribute_parts =>
    emit_writing_children ty parts :: emit_writing_attributes ty attribute_parts :: emit_writing_to_xml ty :: []

:+ choice_part writing = \ _ o _ ty field => emit_writing_choice_part o ty ("x." ++# field)

:+ group_part writing = \ _ o items ty field => choice_part Writing o items ty field

:+ element_part writing = \ _ _ v => occurs_part v::name v::occurs v::kind v::t ("x." ++# field_name v::name)

:+ any_part writing = \ _ => "any_content_to x.any"

:+ attribute_step writing = \ _ acc a =>
    { acc ?| attribute_parts = emit_writing_attribute_part a :: acc::attribute_parts }

:+ element_arm writing = \ _ _ choice_name v =>
    "    | " ++# case_name choice_name v::name ++# " v => " ++# occurs_part v::name v::occurs v::kind v::t "v"

:+ group_arm writing = \ _ choice_name first group_name =>
    "    | " ++# case_name choice_name ("group_" ++# first) ++# " v => " ++# type_name group_name ++# "_children v"

:+ choice_text writing =
    \ _ choice_name arms =>
        := ty = type_name choice_name
        "and let "
        ++# ty
        ++# "_children (x : "
        ++# ty
        ++# ") : list xml.xml_node =\n    match x with\n"
        ++# join_lines arms ""

:+ first_arm_only writing = \ _ => !-

:+ witness_items writing = \ _ ty parts =>
    ?= all_witnessed parts [] ?|
    | Some witnesses => emit_witness_texts ty witnesses
    | None => []

:+ element_witness writing = \ _ owner v => Some (emit_element_witness owner v)

:+ choice_witness writing = \ _ owner o ty field => Some (emit_choice_witness owner o ty field)

:+ any_witness writing = \ _ owner =>
    Some {
        case = case_name (owner ++# "_field") "any"
        t = "any_content"
        field = "any"
        fragment = "any_content_to v"
        tag = "any"
        occurs = { min = 0i32; max = Unbounded }
    }

:| staged_writing = | StagedWriting : list string * list string

:= is_staged_owner (owner : string) (staged : list string) : bool =
    has_name owner staged || has_name (type_name owner) staged

:= emit_any_stage (ty : string) : string = "(x : " ++# ty ++# " s)"

:= emit_staged_children (ty : string) (parts : list part) : string =
    fitted_definition
        ("and let " ++# ty ++# "_children forall s. " ++# emit_any_stage ty ++# " : list xml.xml_node =")
        (concat_parts (listm::map part_text parts))

:= emit_staged_attributes (ty : string) (attribute_parts : list string) : string =
    fitted_definition
        ("and let " ++# ty ++# "_attributes forall s. " ++# emit_any_stage ty ++# " : list (string * string) =")
        (concat_parts attribute_parts)

:= emit_staged_to_xml (ty : string) : string =
    fitted_definition
        ("and let " ++# ty ++# "_to_xml forall s. (name : string) " ++# emit_any_stage ty ++# " : xml.xml_node =")
        ("xml.element name (" ++# ty ++# "_attributes x) (" ++# ty ++# "_children x)")

:= emit_staged_writing_records
    (staged : list string) (ty : string) (parts : list part) (attribute_parts : list string)
    : list string
    =
    ? has_name ty staged = !- ?> record_texts Writing ty parts attribute_parts
    |: emit_staged_children ty parts :: emit_staged_attributes ty attribute_parts :: emit_staged_to_xml ty :: []

:= emit_signed_once_write \* form. (v : element_view form) : string =
    "staged_list (fun v => " ++# value_node v::kind v::t v::name "v" ++# ") x." ++# field_name v::name

:= emit_staged_list_write \* form. (v : element_view form) : string =
    := node = value_node v::kind v::t v::name "v"
    := present = "staged_list (fun vs => listm.map (fun v => " ++# node ++# ") vs) x." ++# field_name v::name
    "listm.concat (" ++# present ++# ")"

:= emit_staged_element_write \* form.
    (signatures : list string) (kinds : list (string * type_kind)) (v : element_view form)
    : string
    =
    ? is_staged_signature signatures v::name v::occurs && is_required_once v::occurs ?> emit_signed_once_write v
    |? is_staged_signature signatures v::name v::occurs ?> emit_staged_list_write v
    |: element_part Writing kinds v

:+ derived_prefix staged_writing = \ _ kinds base => derived_prefix Writing kinds base

:+ record_texts staged_writing = \ f ty parts attribute_parts =>
    ?= f ?| StagedWriting (staged, _) => emit_staged_writing_records staged ty parts attribute_parts

:+ choice_part staged_writing = \ _ o items ty field => choice_part Writing o items ty field

:+ group_part staged_writing = \ _ o items ty field => group_part Writing o items ty field

:+ element_part staged_writing = \ f kinds v =>
    ?= f ?| StagedWriting (_, signatures) => emit_staged_element_write signatures kinds v

:+ any_part staged_writing = \ _ => any_part Writing

:+ attribute_step staged_writing = \ _ acc a => attribute_step Writing acc a

:+ element_arm staged_writing = \ _ kinds choice_name v => element_arm Writing kinds choice_name v

:+ group_arm staged_writing = \ _ choice_name first group_name => group_arm Writing choice_name first group_name

:+ choice_text staged_writing = \ _ choice_name arms => choice_text Writing choice_name arms

:+ first_arm_only staged_writing = \ _ => first_arm_only Writing

:+ witness_items staged_writing = \ f ty parts =>
    ?= f ?| StagedWriting (staged, _) => ? is_staged_owner ty staged ?> [] |: witness_items Writing ty parts

:+ element_witness staged_writing = \ f owner v =>
    ?= f ?| StagedWriting (staged, _) => ? is_staged_owner owner staged ?> None |: element_witness Writing owner v

:+ choice_witness staged_writing = \ f owner o ty field =>
    ?= f ?|
    | StagedWriting (staged, _) => ? is_staged_owner owner staged ?> None |: choice_witness Writing owner o ty field

:+ any_witness staged_writing = \ f owner =>
    ?= f ?| StagedWriting (staged, _) => ? is_staged_owner owner staged ?> None |: any_witness Writing owner

:= element_example \* form. (kinds : list (string * type_kind)) (v : element_view form) : string -> string =
    ? v::inline ?> (\ variant => v::t ++# "_example " ++# variant) |: value_example_of kinds v::type_ref

:= emit_referenced_attribute_example \* form. (a : attribute_view form) (r : type_reference form) : string =
    ? is_builtin_reference (reference_text r) && builtin_kind_of (reference_text r) = IdBuiltin
    ?> "\"ID_" ++# type_name a::owner ++# "\""
    |: value_example a::kind a::t (reference_text r) "k"

:= emit_unfixed_attribute_example \* form. (a : attribute_view form) : string =
    ? a::inline ?> a::t ++# "_example k"
    |:
        ?= a::type_ref ?|
        | Some r => emit_referenced_attribute_example a r
        | None => value_example a::kind a::t "" "k"

:= emit_example_attribute_value \* form. (a : attribute_view form) : string =
    ? a::required = !- ?> "None"
    |:
        ?= a::fixed ?|
        | Some f => fixed_example a::kind a::t f
        | None => emit_unfixed_attribute_example a

:= emit_example_choice_text (choice_name : string) (arms : list string) : string =
    := ty = type_name choice_name
    := header = "and let " ++# ty ++# "_example (k : i32) : " ++# ty ++# " = "
    ?= arms ?|
    | arm :: _ => header ++# arm ++# "\n"
    | [] => header ++# "failwith \"" ++# ty ++# ": no first alternative\"\n"

:+ derived_prefix exampling = \ _ kinds base =>
    := kind = reference_kind (reference_text base) kinds
    := line = "        base = " ++# value_example kind (reference_type base) (reference_text base) "k"
    { parts = plain line :: []; attribute_parts = []; functions = [] }

:+ record_texts exampling = \ _ ty parts _ =>
    := lines = listm::map part_text parts
    "and let " ++# ty ++# "_example (k : i32) : " ++# ty ++# " =\n" ++# record_body ty lines :: []

:+ choice_part exampling = \ _ o _ ty field =>
    field_assignment field (occurs_example o (\ variant => ty ++# "_example " ++# variant))

:+ group_part exampling = \ _ o items ty field => choice_part Exampling o items ty field

:+ element_part exampling = \ _ kinds v =>
    field_assignment (field_name v::name) (occurs_example v::occurs (element_example kinds v))

:+ any_part exampling = \ _ =>
    "        any = any_content_of [xml.element \"modal\" [(\"xmlns\", \"urn:example:any\")] []]"

:+ attribute_step exampling = \ _ acc a =>
    push (field_assignment (field_name a::name) (emit_example_attribute_value a)) [] acc

:+ element_arm exampling = \ _ kinds choice_name v =>
    case_name choice_name v::name ++# " (" ++# occurs_example v::occurs (element_example kinds v) ++# ")"

:+ group_arm exampling = \ _ choice_name first group_name =>
    case_name choice_name ("group_" ++# first) ++# " (" ++# type_name group_name ++# "_example k)"

:+ choice_text exampling = \ _ choice_name arms => emit_example_choice_text choice_name arms

:+ first_arm_only exampling = \ _ => !+

:+ witness_items exampling = \ _ _ _ => []

:+ element_witness exampling = \ _ _ _ => None

:+ choice_witness exampling = \ _ _ _ _ _ => None

:+ any_witness exampling = \ _ _ => None

:| staged_exampling = | StagedExampling : list string * list string

:= emit_staged_example_record (ty : string) (parts : list part) : string =
    := head = "and let " ++# ty ++# "_example (k : i32) : " ++# ty ++# " unsigned =\n"
    head ++# record_body ty (listm::map part_text parts)

:= emit_staged_example_records
    (staged : list string) (ty : string) (parts : list part) (attribute_parts : list string)
    : list string
    =
    ? has_name ty staged = !- ?> record_texts Exampling ty parts attribute_parts
    |: emit_staged_example_record ty parts :: []

:= emit_staged_element_example \* form.
    (signatures : list string) (kinds : list (string * type_kind)) (v : element_view form)
    : string
    =
    ? is_staged_signature signatures v::name v::occurs
    ?> field_assignment (field_name v::name) "Pending \"an unsigned example\""
    |: element_part Exampling kinds v

:+ derived_prefix staged_exampling = \ _ kinds base => derived_prefix Exampling kinds base

:+ record_texts staged_exampling = \ f ty parts attribute_parts =>
    ?= f ?| StagedExampling (staged, _) => emit_staged_example_records staged ty parts attribute_parts

:+ choice_part staged_exampling = \ _ o items ty field => choice_part Exampling o items ty field

:+ group_part staged_exampling = \ _ o items ty field => group_part Exampling o items ty field

:+ element_part staged_exampling = \ f kinds v =>
    ?= f ?| StagedExampling (_, signatures) => emit_staged_element_example signatures kinds v

:+ any_part staged_exampling = \ _ => any_part Exampling

:+ attribute_step staged_exampling = \ _ acc a => attribute_step Exampling acc a

:+ element_arm staged_exampling = \ _ kinds choice_name v => element_arm Exampling kinds choice_name v

:+ group_arm staged_exampling = \ _ choice_name first group_name => group_arm Exampling choice_name first group_name

:+ choice_text staged_exampling = \ _ choice_name arms => choice_text Exampling choice_name arms

:+ first_arm_only staged_exampling = \ _ => first_arm_only Exampling

:+ witness_items staged_exampling = \ _ ty parts => witness_items Exampling ty parts

:+ element_witness staged_exampling = \ _ owner v => element_witness Exampling owner v

:+ choice_witness staged_exampling = \ _ owner o ty field => choice_witness Exampling owner o ty field

:+ any_witness staged_exampling = \ _ owner => any_witness Exampling owner

:= inline_view \* form.
    (owner : string) (name : string) (o : occurs) (type_ref : option (type_reference form)) (inner : xsd type_def form)
    : element_view form
    =
    {
        name = name
        occurs = o
        kind = inline_kind inner
        t = type_name (owner ++# "_" ++# name)
        inline = !+
        type_ref = type_ref
    }

:= referenced_view \* form.
    (kinds : list (string * type_kind)) (name : string) (o : occurs) (type_ref : option (type_reference form))
    : element_view form
    =
    {
        name = name
        occurs = o
        kind = reference_kind_of type_ref kinds
        t = reference_type_of type_ref
        inline = !-
        type_ref = type_ref
    }

:= element_view_of \* form.
    (kinds : list (string * type_kind)) (owner : string) (name : string) (o : occurs)
    (type_ref : option (type_reference form))
    (inline : option (xsd type_def form))
    : element_view form
    =
    ?= inline ?|
    | Some inner => inline_view owner name o type_ref inner
    | None => referenced_view kinds name o type_ref

:~ ^ attribute_names_of \* form. (attributes : list (xsd attribute_decl form)) (acc : list string) : list string =
    ?= attributes ?|
    | (Attribute a) :: rest => attribute_names_of rest (tag_text a::name :: acc)
    | [] => acc

:= kept_condition (names : list string) : string =
    join_with " && " (listm::map (\ n => "n <> \"" ++# n ++# "\"") names) ""

:= attribute_filter (kept : string) (part : string) : string =
    ? sm'::ends_with "_attributes x.base" part
    ?> "listm'.filter (fun (n, _) => " ++# kept ++# ") (" ++# part ++# ")"
    |: part

:= without_redeclared \* form. (attributes : list (xsd attribute_decl form)) (prefix : walked) : walked =
    ?= attribute_names_of attributes [] ?|
    | [] => prefix
    | names =>
        { prefix ?| attribute_parts = listm::map (attribute_filter (kept_condition names)) prefix::attribute_parts }

:= emit_record_function_texts
    \* form f {
        derived_prefix;
        record_texts;
        choice_part; group_part;
        element_part;
        any_part;
        attribute_step;
        element_arm;
        group_arm;
        choice_text;
        first_arm_only;
        witness_items;
        element_witness;
        choice_witness;
        any_witness
    }.
    (family : f) (kinds : list (string * type_kind)) (name : string) (content : xsd particle form) (parts : list part)
    (attribute_parts : list string)
    : list string
    =
    recursive_texts kinds (type_name name) (record_texts family (type_name name) parts attribute_parts)
    |> with_any_claims content

:= emit_record_item_texts
    \* f {
        derived_prefix;
        record_texts;
        choice_part; group_part;
        element_part;
        any_part;
        attribute_step;
        element_arm;
        group_arm;
        choice_text;
        first_arm_only;
        witness_items;
        element_witness;
        choice_witness;
        any_witness
    }.
    (family : f) (kinds : list (string * type_kind)) (name : string) (parts : list part)
    : list string
    =
    recursive_texts kinds (type_name name) (witness_items family (type_name name) parts)

:= emit_walk_joined (items : list string) (texts : list string) (functions : list walk_text) : list walk_text =
    listm::append (listm::map ItemText items) (listm::append (listm::map FunctionText texts) functions)

:= emit_walked_parts (prefix : walked) (gathered : walked) : list part =
    listm::append prefix::parts (reverse gathered::parts [])

:= emit_walked_attributes (prefix : walked) (gathered : walked) : list string =
    listm::append prefix::attribute_parts (reverse gathered::attribute_parts [])

:= emit_record_walk_texts
    \* form f {
        derived_prefix;
        record_texts;
        choice_part; group_part;
        element_part;
        any_part;
        attribute_step;
        element_arm;
        group_arm;
        choice_text;
        first_arm_only;
        witness_items;
        element_witness;
        choice_witness;
        any_witness
    }.
    (family : f) (kinds : list (string * type_kind)) (name : string) (content : xsd particle form) (prefix : walked)
    (gathered : walked)
    : list walk_text
    =
    := parts = emit_walked_parts prefix gathered
    := texts = emit_record_function_texts family kinds name content parts (emit_walked_attributes prefix gathered)
    emit_walk_joined (emit_record_item_texts family kinds name parts) texts gathered::functions

:= emit_group_walk_part
    \* form f {
        derived_prefix;
        record_texts;
        choice_part; group_part;
        element_part;
        any_part;
        attribute_step;
        element_arm;
        group_arm;
        choice_text;
        first_arm_only;
        witness_items;
        element_witness;
        choice_witness;
        any_witness
    }.
    (family : f) (owner : string) (o : occurs) (items : list (xsd particle form)) (ty : string) (field : string)
    : part
    =
    { text = group_part family o items ty field; witness = choice_witness family owner o ty field }

:= emit_choice_walk_part
    \* form f {
        derived_prefix;
        record_texts;
        choice_part; group_part;
        element_part;
        any_part;
        attribute_step;
        element_arm;
        group_arm;
        choice_text;
        first_arm_only;
        witness_items;
        element_witness;
        choice_witness;
        any_witness
    }.
    (family : f) (owner : string) (o : occurs) (items : list (xsd particle form)) (ty : string) (field : string)
    : part
    =
    { text = choice_part family o items ty field; witness = choice_witness family owner o ty field }

:= emit_attribute_view_with \* form.
    (owner : string) (name : string) (required : bool) (fixed : option string) (inline : bool)
    (type_ref : option (type_reference form)) (kind : type_kind) (t : string)
    : attribute_view form
    =
    {
        owner = owner
        name = name
        required = required
        fixed = fixed
        inline = inline
        type_ref = type_ref
        kind = kind
        t = t
    }

:= emit_attribute_view \* form.
    (kinds : list (string * type_kind)) (owner : string) (name : tag_name) (required : bool) (fixed : option string)
    (inline : option (xsd type_def form)) (type_ref : option (type_reference form))
    : attribute_view form
    =
    := t, kind = attribute_type kinds owner (tag_text name) type_ref inline
    := present = ?= inline ?| Some _ => !+ | None => !-
    emit_attribute_view_with owner (tag_text name) required fixed present type_ref kind t

:~ ^ named_type_walk
    \* form f {
        derived_prefix;
        record_texts;
        choice_part; group_part;
        element_part;
        any_part;
        attribute_step;
        element_arm;
        group_arm;
        choice_text;
        first_arm_only;
        witness_items;
        element_witness;
        choice_witness;
        any_witness
    }.
    (family : f) (kinds : list (string * type_kind)) (name : string) (item : xsd type_def form)
    : list walk_text
    =
    ?= item ?|
    | Complex c => record_walk family kinds name c::content c::attributes (nothing_walked ())
    | Derived d => emit_derived_walk family kinds name d::content d::attributes d::base
    | Simple _ => []

:& :~ emit_derived_walk
    \* form f {
        derived_prefix;
        record_texts;
        choice_part; group_part;
        element_part;
        any_part;
        attribute_step;
        element_arm;
        group_arm;
        choice_text;
        first_arm_only;
        witness_items;
        element_witness;
        choice_witness;
        any_witness
    }.
    (family : f) (kinds : list (string * type_kind)) (name : string) (content : xsd particle form)
    (attributes : list (xsd attribute_decl form)) (base : type_reference form)
    : list walk_text
    =
    record_walk family kinds name content attributes (without_redeclared attributes (derived_prefix family kinds base))

:& :~ record_walk
    \* form f {
        derived_prefix;
        record_texts;
        choice_part; group_part;
        element_part;
        any_part;
        attribute_step;
        element_arm;
        group_arm;
        choice_text;
        first_arm_only;
        witness_items;
        element_witness;
        choice_witness;
        any_witness
    }.
    (family : f) (kinds : list (string * type_kind)) (name : string) (content : xsd particle form)
    (attributes : list (xsd attribute_decl form)) (prefix : walked)
    : list walk_text
    =
    := (gathered : walked) =
        attributes_walk family kinds name attributes (content_walk family kinds name content (nothing_walked ()))
    emit_record_walk_texts family kinds name content prefix gathered

:& :~ content_walk
    \* form f
    { derived_prefix; record_texts; choice_part; group_part; element_part; any_part; attribute_step; element_arm; group_arm; choice_text; first_arm_only; witness_items; element_witness; choice_witness; any_witness }.
    (family : f) (kinds : list (string * type_kind)) (owner : string) (item : xsd particle form) (acc : walked)
    : walked
    =
    ?= item ?|
    | Sequence s ?& is_repeated s::occurs => repeated_group_walk family kinds owner s::occurs s::items acc
    | Sequence s => items_walk family kinds owner s::items acc
    | Choice c => choice_content_walk family kinds owner c::occurs c::items acc
    | Element e => element_content_walk family kinds owner (tag_text e::name) e::occurs e::type_ref e::inline acc
    | AnyContent () => push_part { text = any_part family; witness = any_witness family owner } [] acc
    | Empty () => acc

:& :~ repeated_group_walk
    \* form f
    { derived_prefix; record_texts; choice_part; group_part; element_part; any_part; attribute_step; element_arm; group_arm; choice_text; first_arm_only; witness_items; element_witness; choice_witness; any_witness }.
    (family : f) (kinds : list (string * type_kind)) (owner : string) (o : occurs) (items : list (xsd particle form))
    (acc : walked)
    : walked
    =
    := group_name, field = group_identity owner items
    := ty = type_name group_name
    := part = emit_group_walk_part family owner o items ty field
    push_part part (record_walk family kinds group_name (once_sequence items) [] (nothing_walked ())) acc

:& :~ choice_content_walk
    \* form f
    { derived_prefix; record_texts; choice_part; group_part; element_part; any_part; attribute_step; element_arm; group_arm; choice_text; first_arm_only; witness_items; element_witness; choice_witness; any_witness }.
    (family : f) (kinds : list (string * type_kind)) (owner : string) (o : occurs) (items : list (xsd particle form))
    (acc : walked)
    : walked
    =
    := first = first_element_name items
    := choice_name = owner ++# "_choice_" ++# first
    := part = emit_choice_walk_part family owner o items (type_name choice_name) (choice_field_of first)
    push_part part (choice_walk family kinds choice_name items) acc

:& :~ element_content_walk
    \* form f
    { derived_prefix; record_texts; choice_part; group_part; element_part; any_part; attribute_step; element_arm; group_arm; choice_text; first_arm_only; witness_items; element_witness; choice_witness; any_witness }.
    (family : f) (kinds : list (string * type_kind)) (owner : string) (name : string) (o : occurs)
    (type_ref : option (type_reference form)) (inline : option (xsd type_def form)) (acc : walked)
    : walked
    =
    := v = element_view_of kinds owner name o type_ref inline
    := p = { text = element_part family kinds v; witness = element_witness family owner v }
    push_part p (inline_walk family kinds owner name inline) acc

:& :~ inline_walk
    \* form f
    { derived_prefix; record_texts; choice_part; group_part; element_part; any_part; attribute_step; element_arm; group_arm; choice_text; first_arm_only; witness_items; element_witness; choice_witness; any_witness }.
    (family : f) (kinds : list (string * type_kind)) (owner : string) (name : string)
    (inline : option (xsd type_def form))
    : list walk_text
    =
    ?= inline ?|
    | Some inner => named_type_walk family kinds (owner ++# "_" ++# name) inner
    | None => []

:& :~ items_walk
    \* form f {
        derived_prefix;
        record_texts;
        choice_part; group_part;
        element_part;
        any_part;
        attribute_step;
        element_arm;
        group_arm;
        choice_text;
        first_arm_only;
        witness_items;
        element_witness;
        choice_witness;
        any_witness
    }.
    (family : f) (kinds : list (string * type_kind)) (owner : string) (items : list (xsd particle form)) (acc : walked)
    : walked
    =
    ?= items ?|
    | item :: rest => items_walk family kinds owner rest (content_walk family kinds owner item acc)
    | [] => acc

:& :~ choice_walk
    \* form f {
        derived_prefix;
        record_texts;
        choice_part; group_part;
        element_part;
        any_part;
        attribute_step;
        element_arm;
        group_arm;
        choice_text;
        first_arm_only;
        witness_items;
        element_witness;
        choice_witness;
        any_witness
    }.
    (family : f) (kinds : list (string * type_kind)) (choice_name : string) (items : list (xsd particle form))
    : list walk_text
    =
    := (arms : walked) = arms_walk family kinds choice_name items (nothing_walked ())
    := text = choice_text family choice_name (listm::map part_text (reverse arms::parts []))
    FunctionText (with_empty_fallback (emptiable_heads items []) text) :: arms::functions

:& :~ arms_walk
    \* form f
    { derived_prefix; record_texts; choice_part; group_part; element_part; any_part; attribute_step; element_arm; group_arm; choice_text; first_arm_only; witness_items; element_witness; choice_witness; any_witness }.
    (family : f) (kinds : list (string * type_kind)) (choice_name : string) (items : list (xsd particle form))
    (acc : walked)
    : walked
    =
    ?= items ?|
    | (Element e) :: rest => emit_arm_element family kinds choice_name e::name e::occurs e::type_ref e::inline rest acc
    | (Sequence s) :: rest => emit_arm_seq family kinds choice_name (first_element_name s::items) (Sequence s) rest acc
    | _ :: rest => emit_arms_continue family kinds choice_name rest acc
    | [] => acc

:& :~ emit_arms_continue
    \* form f {
        derived_prefix;
        record_texts;
        choice_part; group_part;
        element_part;
        any_part;
        attribute_step;
        element_arm;
        group_arm;
        choice_text;
        first_arm_only;
        witness_items;
        element_witness;
        choice_witness;
        any_witness
    }.
    (family : f) (kinds : list (string * type_kind)) (choice_name : string) (rest : list (xsd particle form))
    (next : walked)
    : walked
    =
    ? first_arm_only family ?> next |: arms_walk family kinds choice_name rest next

:& :~ emit_arm_element
    \* form f {
        derived_prefix;
        record_texts;
        choice_part; group_part;
        element_part;
        any_part;
        attribute_step;
        element_arm;
        group_arm;
        choice_text;
        first_arm_only;
        witness_items;
        element_witness;
        choice_witness;
        any_witness
    }.
    (family : f) (kinds : list (string * type_kind)) (choice_name : string) (name : tag_name) (o : occurs)
    (type_ref : option (type_reference form)) (inline : option (xsd type_def form)) (rest : list (xsd particle form))
    (acc : walked)
    : walked
    =
    := v = element_view_of kinds choice_name (tag_text name) o type_ref inline
    := inner = inline_walk family kinds choice_name (tag_text name) inline
    emit_arms_continue family kinds choice_name rest (push (element_arm family kinds choice_name v) inner acc)

:& :~ emit_arm_seq
    \* form f {
        derived_prefix;
        record_texts;
        choice_part; group_part;
        element_part;
        any_part;
        attribute_step;
        element_arm;
        group_arm;
        choice_text;
        first_arm_only;
        witness_items;
        element_witness;
        choice_witness;
        any_witness
    }.
    (family : f) (kinds : list (string * type_kind)) (choice_name : string) (first : string)
    (sequence : xsd particle form) (rest : list (xsd particle form)) (acc : walked)
    : walked
    =
    := group_name = choice_name ++# "_group_" ++# first
    := group = record_walk family kinds group_name sequence [] (nothing_walked ())
    emit_arms_continue family kinds choice_name rest (push (group_arm family choice_name first group_name) group acc)

:& :~ attributes_walk
    \* form f {
        derived_prefix;
        record_texts;
        choice_part; group_part;
        element_part;
        any_part;
        attribute_step;
        element_arm;
        group_arm;
        choice_text;
        first_arm_only;
        witness_items;
        element_witness;
        choice_witness;
        any_witness
    }.
    (family : f) (kinds : list (string * type_kind)) (owner : string) (attributes : list (xsd attribute_decl form))
    (acc : walked)
    : walked
    =
    ?= attributes ?|
    | (Attribute a) :: rest =>
        := view = emit_attribute_view kinds owner a::name a::required a::fixed a::inline a::type_ref
        attributes_walk family kinds owner rest (attribute_step family acc view)
    | [] => acc

:~ ^ types_walk
    \* form f {
        derived_prefix;
        record_texts;
        choice_part; group_part;
        element_part;
        any_part;
        attribute_step;
        element_arm;
        group_arm;
        choice_text;
        first_arm_only;
        witness_items;
        element_witness;
        choice_witness;
        any_witness
    }.
    (family : f) (kinds : list (string * type_kind)) (types : list (xsd type_def form)) (acc : list walk_text)
    : list walk_text
    =
    ?= types ?|
    | item :: rest =>
        types_walk family kinds rest (
            listm::append (named_type_walk family kinds (xsd_resolve::type_name_of item) item) acc
        )
    | [] => acc

:= root_own
    \* form f {
        derived_prefix;
        record_texts;
        choice_part; group_part;
        element_part;
        any_part;
        attribute_step;
        element_arm;
        group_arm;
        choice_text;
        first_arm_only;
        witness_items;
        element_witness;
        choice_witness;
        any_witness
    }.
    (family : f) (kinds : list (string * type_kind)) (name : tag_name) (inline : option (xsd type_def form))
    : list walk_text
    =
    ?= inline ?|
    | Some inner => named_type_walk family kinds (tag_text name) inner
    | None => []

:~ ^ roots_walk
    \* form f {
        derived_prefix;
        record_texts;
        choice_part; group_part;
        element_part;
        any_part;
        attribute_step;
        element_arm;
        group_arm;
        choice_text;
        first_arm_only;
        witness_items;
        element_witness;
        choice_witness;
        any_witness
    }.
    (family : f) (kinds : list (string * type_kind)) (items : list (xsd particle form)) (acc : list walk_text)
    : list walk_text
    =
    ?= items ?|
    | (Element e) :: rest => roots_walk family kinds rest (listm::append (root_own family kinds e::name e::inline) acc)
    | _ :: rest => roots_walk family kinds rest acc
    | [] => acc

:= function_key (text : string) : string =
    := stop = sm'::index_of " (" text
    ? stop < 0i32 ?> text |: sm'::substring 0i32 stop text

:~ ^ unique_texts (items : list string) (seen : list string) (acc : list string) : list string =
    ?= items ?|
    | item :: rest =>
        := key = function_key item
        ? has_name key seen ?> unique_texts rest seen acc |: unique_texts rest (key :: seen) (item :: acc)
    | [] => reverse acc []

:= written_and_exampled \* form.
    (kinds : list (string * type_kind)) (complex_types : list (xsd type_def form)) (elements : list (xsd particle form))
    : list walk_text
    =
    := writers = roots_walk Writing kinds elements (types_walk Writing kinds complex_types [])
    listm::append writers (roots_walk Exampling kinds elements (types_walk Exampling kinds complex_types []))

:= walk_texts_with
    \* form f {
        derived_prefix;
        record_texts;
        choice_part; group_part;
        element_part;
        any_part;
        attribute_step;
        element_arm;
        group_arm;
        choice_text;
        first_arm_only;
        witness_items;
        element_witness;
        choice_witness;
        any_witness
    }.
    (reader : f) (kinds : list (string * type_kind)) (complex_types : list (xsd type_def form))
    (elements : list (xsd particle form))
    : list walk_text
    =
    := readers = roots_walk reader kinds elements (types_walk reader kinds complex_types [])
    listm::append readers (written_and_exampled kinds complex_types elements)

:= walk_texts \* form.
    (kinds : list (string * type_kind)) (complex_types : list (xsd type_def form)) (elements : list (xsd particle form))
    : list walk_text
    =
    walk_texts_with Reading kinds complex_types elements

:= function_texts \* form.
    (kinds : list (string * type_kind)) (complex_types : list (xsd type_def form)) (elements : list (xsd particle form))
    : list string
    =
    := readers = roots_walk Reading kinds elements (types_walk Reading kinds complex_types [])
    unique_texts (function_parts (listm::append readers (written_and_exampled kinds complex_types elements)) []) [] []

:= functions_group (functions : list string) : string =
    ?= functions ?|
    | first :: rest =>
        "let rec "
        ++# sm'::substring 8i32 (sm'::length first - 8i32) first
        ++# "\n"
        ++# sm'::concat_balanced "\n" rest
        ++# "\n"
    | [] => ""

:= readers_text \* form.
    (kinds : list (string * type_kind)) (complex_types : list (xsd type_def form)) (elements : list (xsd particle form))
    : string
    =
    functions_group (function_texts kinds complex_types elements)

:~ ^ item_parts (texts : list walk_text) (acc : list string) : list string =
    ?= texts ?|
    | ItemText t :: rest => item_parts rest (t :: acc)
    | FunctionText _ :: rest => item_parts rest acc
    | [] => reverse acc []

:= emit_is_alias \* form.
    (base : type_reference form) (facets : list xsd_facet) (parent : string) (known : list string)
    : bool
    =
    := facet_free = listm::length (enumeration_values facets []) = 0i32 && is_constrained facets = !-
    facet_free && is_builtin_reference (reference_text base) = !- && has_name parent known

:= emit_with_alias \* form.
    (name : definition_name form) (base : type_reference form) (facets : list xsd_facet) (known : list string)
    (acc : list (string * string))
    : list (string * string)
    =
    := parent = reference_type base
    ? emit_is_alias base facets parent known ?> ((type_name (definition_text name), parent) :: acc) |: acc

:~ ^ simple_aliases \* form.
    (types : list (xsd type_def form)) (known : list string) (acc : list (string * string))
    : list (string * string)
    =
    ?= types ?|
    | (Simple s) :: rest => simple_aliases rest known (emit_with_alias s::name s::base s::facets known acc)
    | _ :: rest => simple_aliases rest known acc
    | [] => acc

:~ ^ alias_parent (target : string) (aliases : list (string * string)) : option string =
    ?= aliases ?|
    | (name, parent) :: rest => ? name = target ?> Some parent |: alias_parent target rest
    | [] => None

:~ ^ resolved_kind
    (aliases : list (string * string)) (kinds : list (string * type_kind)) (name : string) (depth : i32)
    : type_kind
    =
    ?= alias_parent name aliases ?|
    | Some parent => ? depth > 64i32 ?> KindText |: resolved_kind aliases kinds parent (depth + 1i32)
    | None => kind_lookup name kinds

:= inherited_kind
    (aliases : list (string * string)) (all : list (string * type_kind)) (name : string) (kind : type_kind)
    : type_kind
    =
    ?= alias_parent name aliases ?|
    | Some _ => resolved_kind aliases all name 0i32
    | None => kind

:~ ^ inherited_kinds
    (aliases : list (string * string)) (all : list (string * type_kind)) (kinds : list (string * type_kind))
    (acc : list (string * type_kind))
    : list (string * type_kind)
    =
    ?= kinds ?|
    | (name, kind) :: rest => inherited_kinds aliases all rest ((name, inherited_kind aliases all name kind) :: acc)
    | [] => reverse acc []

:= emit_alias_conversions (ty : string) (parent : string) : string =
    "\ninl " ++# ty ++# "_of_string (s : string) : option " ++# ty ++# " = " ++# parent ++# "_of_string s\n\ninl "
    ++# ty ++# "_to_string (x : " ++# ty ++# ") : string = " ++# parent ++# "_to_string x\n"

:= emit_alias_codec (ty : string) (parent : string) (kind : type_kind) : string =
    ?= kind ?|
    | KindEnum | KindValidated => emit_alias_conversions ty parent
    | _ => ""

:= alias_text (ty : string) (parent : string) (kind : type_kind) : string =
    "type " ++# ty ++# " = " ++# parent ++# "\n\ninl " ++# ty ++# "_example (k : i32) = " ++# parent
    ++# "_example k\n\ninl " ++# ty ++# "_example_text (k : i32) : string = " ++# parent ++# "_example_text k\n"
    ++# emit_alias_codec ty parent kind

:= aliased_item (item : emitted) (parent : string) (kinds : list (string * type_kind)) : emitted =
    { item ?| text = alias_text item::name parent (kind_lookup item::name kinds); references = parent :: [] }

:= aliased_or_plain (item : emitted) (aliases : list (string * string)) (kinds : list (string * type_kind)) : emitted =
    ?= alias_parent item::name aliases ?|
    | Some parent => aliased_item item parent kinds
    | None => item

:~ ^ aliased_items
    (aliases : list (string * string)) (kinds : list (string * type_kind)) (items : list emitted)
    (acc : list emitted)
    : list emitted
    =
    ?= items ?|
    | item :: rest => aliased_items aliases kinds rest (aliased_or_plain item aliases kinds :: acc)
    | [] => reverse acc []

:== module_parts = { items : list emitted; functions : list string; witness_items : list string }

:= shared_items \* form.
    (schema : xsd_schema form) (complex_types : list (xsd type_def form)) (elements : list (xsd particle form))
    : list emitted
    =
    := all = reverse (emit_roots elements (emit_types complex_types (emit_types schema::simple_types []))) []
    share_unions (unique_emitted all [] []) [] []

:= simple_kinds \* form.
    (schema : xsd_schema form) (complex_types : list (xsd type_def form))
    : list (string * type_kind)
    =
    kinds_of schema::simple_types (kinds_of complex_types [])

:= aliased_kinds_items \* form.
    (schema : xsd_schema form) (complex_types : list (xsd type_def form)) (shared : list emitted)
    : list (string * type_kind) * list emitted
    =
    := aliases = simple_aliases schema::simple_types (emitted_names shared []) []
    := base_kinds = simple_kinds schema complex_types
    := kinds = inherited_kinds aliases base_kinds base_kinds []
    kinds, aliased_items aliases kinds shared []

:= module_parts_of (items : list emitted) (walked_texts : list walk_text) : module_parts =
    {
        items = items
        functions = unique_texts (function_parts walked_texts []) [] []
        witness_items = distinct_values (item_parts walked_texts []) [] []
    }

:= module_kinds_items \* form.
    (schema : xsd_schema form) (complex_types : list (xsd type_def form)) (elements : list (xsd particle form))
    : list (string * type_kind) * list emitted
    =
    aliased_kinds_items schema complex_types (shared_items schema complex_types elements)

:= ordered_items (unique : list emitted) : list emitted * list string =
    := known = emitted_names unique []
    order_emitted (with_known_references unique known []) known [] []

:= module_parts_by \* form.
    (walk : list (string * type_kind) -> list (xsd type_def form) -> list (xsd particle form) -> list walk_text)
    (schema : xsd_schema form)
    : module_parts
    =
    := complex_types, elements = dereferenced_parts schema
    := kinds, unique = module_kinds_items schema complex_types elements
    := items, wrapped = ordered_items unique
    module_parts_of items (walk (recursive_kinds kinds wrapped []) complex_types elements)

:= module_parts_with
    \* form f {
        derived_prefix;
        record_texts;
        choice_part; group_part;
        element_part;
        any_part;
        attribute_step;
        element_arm;
        group_arm;
        choice_text;
        first_arm_only;
        witness_items;
        element_witness;
        choice_witness;
        any_witness
    }.
    (reader : f) (schema : xsd_schema form)
    : module_parts
    =
    module_parts_by (walk_texts_with reader) schema

:= emit_family_walk
    \* form f {
        derived_prefix;
        record_texts;
        choice_part; group_part;
        element_part;
        any_part;
        attribute_step;
        element_arm;
        group_arm;
        choice_text;
        first_arm_only;
        witness_items;
        element_witness;
        choice_witness;
        any_witness
    }.
    (family : f) (kinds : list (string * type_kind)) (complex_types : list (xsd type_def form))
    (elements : list (xsd particle form))
    : list walk_text
    =
    roots_walk family kinds elements (types_walk family kinds complex_types [])

:= emit_staged_writers_examples \* form.
    (staged : list string) (signatures : list string) (kinds : list (string * type_kind))
    (complex_types : list (xsd type_def form)) (elements : list (xsd particle form))
    : list walk_text
    =
    := writers = emit_family_walk (StagedWriting (staged, signatures)) kinds complex_types elements
    listm::append writers (emit_family_walk (StagedExampling (staged, signatures)) kinds complex_types elements)

:= staged_walk_texts \* form.
    (staged : list string) (signatures : list string) (kinds : list (string * type_kind))
    (complex_types : list (xsd type_def form)) (elements : list (xsd particle form))
    : list walk_text
    =
    := readers = emit_family_walk (StagedReading (staged, signatures)) kinds complex_types elements
    listm::append readers (emit_staged_writers_examples staged signatures kinds complex_types elements)

:= module_parts_staged \* form.
    (staged : list string) (signatures : list string) (schema : xsd_schema form)
    : module_parts
    =
    module_parts_by (staged_walk_texts staged signatures) schema

:= module_parts \* form. (schema : xsd_schema form) : module_parts = module_parts_with Reading schema

:= is_plain (item : emitted) : bool = is_certificate item = !-

:~ ^ kept_items (keep : emitted -> bool) (items : list emitted) (acc : list emitted) : list emitted =
    ?= items ?|
    | item :: rest => kept_items keep rest (? keep item ?> item :: acc |: acc)
    | [] => reverse acc []

:= untyped_any_content () : string =
    "type any_content = list xml.xml_node\n\n"
    ++# "inl any_content_of (nodes : list xml.xml_node) : any_content = nodes\n\n"
    ++# "inl any_content_to (content : any_content) : list xml.xml_node = content\n\n"

:| codec_shape =
    | PlainCodec : string
    | StagedCodec : string

:~ ^ has_codec_key (key : string) (functions : list string) : bool =
    ?= functions ?|
    | f :: rest => function_key f = key || has_codec_key key rest
    | [] => !-

:~ ^ alias_names (items : list emitted) (acc : list string) : list string =
    ?= items ?|
    | item :: rest =>
        alias_names rest (? sm'::starts_with ("type " ++# item::name ++# " ") item::text ?> item::name :: acc |: acc)
    | [] => acc

:= codec_name (key : string) (suffix : string) : string =
    := name = sm'::substring 8i32 (sm'::length key - 8i32) key
    sm'::substring 0i32 (sm'::length name - sm'::length suffix) name

:= plain_codec (functions : list string) (aliases : list string) (ty : string) : option codec_shape =
    ? has_codec_key ("and let " ++# ty ++# "_to_xml") functions && has_name ty aliases = !-
    ?> Some (PlainCodec ty)
    |: None

:= staged_codec (functions : list string) (aliases : list string) (ty : string) : option codec_shape =
    ? has_codec_key ("and let " ++# ty ++# "_to_xml forall s.") functions && has_name ty aliases = !-
    ?> Some (StagedCodec ty)
    |: None

:= codec_shape_of (functions : list string) (aliases : list string) (f : string) : option codec_shape =
    := key = function_key f
    ? sm'::ends_with "_of_xml forall s." key ?> staged_codec functions aliases (codec_name key "_of_xml forall s.")
    |? sm'::ends_with "_of_xml" key ?> plain_codec functions aliases (codec_name key "_of_xml")
    |: None

:= plain_codec_text (ty : string) : string =
    "instance of_xml " ++# ty ++# " = " ++# ty ++# "_of_xml\ninstance to_xml " ++# ty ++# " = " ++# ty ++# "_to_xml\n"

:= staged_codec_text (ty : string) : string =
    "instance of_xml " ++# ty ++# " s {stage_of} = fun c => " ++# ty ++# "_of_xml (stage_of ()) c\n"
    ++# "instance to_xml " ++# ty ++# " s = " ++# ty ++# "_to_xml\n"

:= codec_instance_text (shape : codec_shape) : string =
    ?= shape ?|
    | PlainCodec ty => plain_codec_text ty
    | StagedCodec ty => staged_codec_text ty

:= with_codec_instance
    (functions : list string) (aliases : list string) (f : string) (acc : list string)
    : list string
    =
    ?= codec_shape_of functions aliases f ?|
    | Some shape => codec_instance_text shape :: acc
    | None => acc

:~ ^ codec_instance_texts
    (functions : list string) (aliases : list string) (items : list string) (acc : list string)
    : list string
    =
    ?= items ?|
    | f :: rest => codec_instance_texts functions aliases rest (with_codec_instance functions aliases f acc)
    | [] => reverse acc []

:= codec_instances (functions : list string) (aliases : list string) : string =
    ?= codec_instance_texts functions aliases functions [] ?|
    | [] => ""
    | texts => "\n" ++# join_lines texts ""

:= module_body (parts : module_parts) : string =
    := witnesses = join_lines parts::witness_items ""
    := plain_items = texts_of (kept_items is_plain parts::items [])
    plain_items
    ++# witnesses
    ++# functions_group parts::functions
    ++# codec_instances parts::functions (alias_names parts::items [])

:= main_unit_text (any_content : string) (prelude : string) (body : string) : string =
    codec_prelude ()
    ++# carrier_prelude body
    ++# prelude
    ++# (? sm'::contains "any_content" body ?> any_content |: "")
    ++# body

:= certificate_unit_text (certificates : list emitted) : option string =
    ?= certificates ?|
    | [] => None
    | _ => Some (texts_of certificates ++# certificates_checked_text certificates)

:= units_of_parts (any_content : string) (prelude : string) (parts : module_parts) : string * option string =
    main_unit_text any_content prelude (module_body parts),
    certificate_unit_text (kept_items is_certificate parts::items [])

:= generated_units_with \* form. (any_content : string) (schema : xsd_schema form) : string * option string =
    units_of_parts any_content "" (module_parts schema)

:= staged_units \* form.
    (staged : list string) (signatures : list string) (any_content : string) (schema : xsd_schema form)
    : string * option string
    =
    := parts = module_parts_staged staged signatures schema
    units_of_parts any_content (staging_prelude ()) { parts ?| items = staged_items staged signatures parts::items }

:= generated_units_signed \* form.
    (signatures : list string) (any_content : string) (schema : xsd_schema form)
    : string * option string
    =
    := staged = staged_type_names signatures schema
    ?= staged ?|
    | [] => generated_units_with any_content schema
    | _ => staged_units staged signatures any_content schema

:= generated_units \* form. (schema : xsd_schema form) : string * option string =
    generated_units_with (untyped_any_content ()) schema

:= generate_module (schema : xsd_schema final) : string =
    := main, _ = generated_units schema
    main

:~ ^ item_text (name : string) (items : list emitted) : option string =
    ?= items ?|
    | item :: rest => ? item::name = name ?> Some item::text |: item_text name rest
    | [] => None

:~ ^ same_in_all (name : string) (text : string) (versions : list module_parts) : bool =
    ?= versions ?|
    | parts :: rest =>
        (?= item_text name parts::items ?| Some other => other = text | None => !-) && same_in_all name text rest
    | [] => !+

:~ ^ identical_names (items : list emitted) (versions : list module_parts) (acc : list string) : list string =
    ?= items ?|
    | item :: rest =>
        identical_names rest versions (? same_in_all item::name item::text versions ?> (item::name :: acc) |: acc)
    | [] => acc

:~ ^ all_shared (references : list string) (shared : list string) : bool =
    ?= references ?|
    | reference :: rest => has_name reference shared && all_shared rest shared
    | [] => !+

:~ ^ closed_pass (items : list emitted) (shared : list string) (acc : list string) : list string =
    ?= items ?|
    | item :: rest =>
        closed_pass rest shared (
            ? has_name item::name shared && all_shared item::references shared ?> (item::name :: acc) |: acc
        )
    | [] => acc

:~ ^ closed_shared (items : list emitted) (shared : list string) : list string =
    := next = closed_pass items shared []
    ? count_list next = count_list shared ?> shared |: closed_shared items next

:~ ^ owner_of (key : string) (names : list string) (best : string) : string =
    ?= names ?|
    | name :: rest =>
        := longer = sm'::starts_with ("and let " ++# name ++# "_") key && (sm'::length name : i32) > sm'::length best
        owner_of key rest (? longer ?> name |: best)
    | [] => best

:~ ^ has_text_in (text : string) (functions : list string) : bool =
    ?= functions ?|
    | f :: rest => f = text || has_text_in text rest
    | [] => !-

:~ ^ function_in_all (text : string) (versions : list module_parts) : bool =
    ?= versions ?|
    | parts :: rest => has_text_in text parts::functions && function_in_all text rest
    | [] => !+

:~ ^ split_items
    (items : list emitted) (shared : list string) (core : list emitted) (own : list emitted)
    : list emitted * list emitted
    =
    ?= items ?|
    | item :: rest =>
        ? has_name item::name shared ?> split_items rest shared (item :: core) own
        |: split_items rest shared core (item :: own)
    | [] => reverse core [], reverse own []

:= is_core_function (f : string) (names : list string) (shared : list string) (versions : list module_parts) : bool =
    := owner = owner_of (function_key f) names ""
    owner <> "" && has_name owner shared && function_in_all f versions

:~ ^ split_functions
    (functions : list string) (names : list string) (shared : list string) (versions : list module_parts)
    (core : list string) (own : list string)
    : list string * list string
    =
    ?= functions ?|
    | f :: rest =>
        ? is_core_function f names shared versions ?> split_functions rest names shared versions (f :: core) own
        |: split_functions rest names shared versions core (f :: own)
    | [] => reverse core [], reverse own []

:~ ^ functions_outside (functions : list string) (core : list string) (acc : list string) : list string =
    ?= functions ?|
    | f :: rest => functions_outside rest core (? has_text_in f core ?> acc |: f :: acc)
    | [] => reverse acc []

:= function_name (text : string) : string =
    := key = function_key text
    sm'::substring 8i32 (sm'::length key - 8i32) key

:~ ^ mentions_any (text : string) (names : list string) : bool =
    ?= names ?|
    | name :: rest => sm'::contains name text || mentions_any text rest
    | [] => !-

:~ ^ function_names (functions : list string) (acc : list string) : list string =
    ?= functions ?|
    | f :: rest => function_names rest (function_name f :: acc)
    | [] => acc

:~ ^ self_contained (core : list string) (outside : list string) (acc : list string) : list string =
    ?= core ?|
    | f :: rest => self_contained rest outside (? mentions_any f outside ?> acc |: f :: acc)
    | [] => reverse acc []

:~ ^ closed_functions (core : list string) (all : list string) : list string =
    := outside = function_names (functions_outside all core []) []
    := next = self_contained core outside []
    ? count_list next = count_list core ?> core |: closed_functions next all

:= version_text
    (parts : module_parts) (shared : list string) (core_functions : list string) (core_module : string)
    : string
    =
    := _, own_items = split_items parts::items shared [] []
    := own_functions = functions_outside parts::functions core_functions []
    "open " ++# core_module ++# "\n\n" ++# texts_of own_items ++# functions_group own_functions

:~ ^ version_texts
    (versions : list module_parts) (shared : list string) (core_functions : list string) (core_module : string)
    (acc : list string)
    : list string
    =
    ?= versions ?|
    | parts :: rest =>
        version_texts rest shared core_functions core_module (
            version_text parts shared core_functions core_module :: acc
        )
    | [] => reverse acc []

:== family_split = { shared : list string; core_text : string; version_texts : list string }

:= core_functions_of (first : module_parts) (shared : list string) (versions : list module_parts) : list string =
    := candidates, _ = split_functions first::functions (emitted_names first::items []) shared versions [] []
    closed_functions candidates first::functions

:= family_core_text (core_body : string) (texts : list string) : string =
    := all_text = core_body ++# sm'::concat_balanced "" texts
    := uses_any = sm'::contains "any_content" all_text
    codec_prelude () ++# carrier_prelude all_text ++# (? uses_any ?> untyped_any_content () |: "") ++# core_body

:= emit_core_body (first : module_parts) (shared : list string) (core_functions : list string) : string =
    := core_items, _ = split_items first::items shared [] []
    texts_of core_items ++# functions_group core_functions

:= emit_family_split (shared : list string) (core_body : string) (texts : list string) : family_split =
    { shared = shared; core_text = family_core_text core_body texts; version_texts = texts }

:= emit_split_shared
    (first : module_parts) (shared : list string) (versions : list module_parts) (core_module : string)
    : family_split
    =
    := core_functions = core_functions_of first shared versions
    := texts = version_texts versions shared core_functions core_module []
    emit_family_split shared (emit_core_body first shared core_functions) texts

:= emit_split_first (first : module_parts) (versions : list module_parts) (core_module : string) : family_split =
    := shared = closed_shared first::items (identical_names first::items versions [])
    emit_split_shared first shared versions core_module

:= split_family (versions : list module_parts) (core_module : string) : family_split =
    ?= versions ?|
    | first :: _ => emit_split_first first versions core_module
    | [] => { shared = []; core_text = ""; version_texts = [] }

:= generate_family \* form. (schemas : list (xsd_schema form)) (core_module : string) : string * list string =
    := split = split_family (listm::map module_parts schemas) core_module
    split::core_text, split::version_texts

:~ ^ has_function_key (key : string) (functions : list string) : bool =
    ?= functions ?|
    | f :: rest => function_key f = key || has_function_key key rest
    | [] => !-

:~ ^ read_in_all (name : string) (versions : list module_parts) : bool =
    ?= versions ?|
    | parts :: rest => has_function_key ("and let " ++# name ++# "_of_xml") parts::functions && read_in_all name rest
    | [] => !+

:~ ^ versioned_names
    (items : list emitted) (shared : list string) (versions : list module_parts) (acc : list string)
    : list string
    =
    ?= items ?|
    | item :: rest =>
        := versioned = has_name item::name shared = !- && read_in_all item::name versions
        versioned_names rest shared versions (? versioned ?> (item::name :: acc) |: acc)
    | [] => reverse acc []

:~ ^ common_prefix_length (a : string) (b : string) (pos : i32) : i32 =
    ? pos < sm'::length a && pos < sm'::length b && sm'::substring pos 1i32 a = sm'::substring pos 1i32 b
    ?> common_prefix_length a b (pos + 1i32)
    |: pos

:~ ^ shared_prefix (names : list string) (prefix : string) : string =
    ?= names ?|
    | name :: rest => shared_prefix rest (sm'::substring 0i32 (common_prefix_length prefix name 0i32) prefix)
    | [] => prefix

:~ ^ past_last_underscore (s : string) (pos : i32) (best : i32) : i32 =
    ? pos >= sm'::length s ?> best
    |: past_last_underscore s (pos + 1i32) (? sm'::substring pos 1i32 s = "_" ?> pos + 1i32 |: best)

:= version_prefix_length (modules : list string) : i32 =
    ?= modules ?|
    | first :: _ :: _ => past_last_underscore (shared_prefix modules first) 0i32 0i32
    | _ => 0i32

:= version_tag (prefix_length : i32) (module_name : string) : string =
    := tag = sm'::substring prefix_length (sm'::length module_name - prefix_length) module_name
    ? sm'::length tag > 0i32 && is_lower (sm'::substring 0i32 1i32 tag) ?> tag |: "v" ++# tag

:= upper_first (s : string) : string =
    := at = ? sm'::length s > 0i32 ?> sm'::index_of (sm'::substring 0i32 1i32 s) (lower_letters ()) |: 0i32 - 1i32
    ? at < 0i32 ?> capitalized s
    |: sm'::substring at 1i32 (upper_letters ()) ++# sm'::substring 1i32 (sm'::length s - 1i32) s

:= versioned_case (name : string) (tag : string) : string =
    upper_first (? sm'::starts_with "x_" name ?> sm'::substring 2i32 (sm'::length name - 2i32) name |: name)
    ++# "_"
    ++# tag

:~ ^ version_lines
    (modules : list string) (prefix_length : i32) (line : string -> string -> string) (acc : list string)
    : list string
    =
    ?= modules ?|
    | module_name :: rest =>
        version_lines rest prefix_length line (line module_name (version_tag prefix_length module_name) :: acc)
    | [] => reverse acc []

:= versioned_case_line (name : string) (module_name : string) (tag : string) : string =
    "    | " ++# versioned_case name tag ++# " :: " ++# module_name ++# "." ++# name ++# " -> " ++# name ++# " " ++# tag

:= versioned_read_line (name : string) (module_name : string) (tag : string) : string =
    "    | "
    ++# upper_first tag
    ++# " _ => xml_codec.mapped (fun x => "
    ++# versioned_case name tag
    ++# " x) ("
    ++# module_name
    ++# "."
    ++# name
    ++# "_of_xml c)"

:= versioned_reader_head (name : string) : string =
    "\ninl "
    ++# name
    ++# "_of_xml forall v. (witness : version_witness v) (c : xml.xml_node) : "
    ++# decode_result (name ++# " v")
    ++# " =\n    match witness with\n"

:= versioned_cases_text (modules : list string) (prefix_length : i32) (name : string) : string =
    "union " ++# name ++# " v =\n" ++# join_lines (version_lines modules prefix_length (versioned_case_line name) []) ""

:= versioned_type_text (modules : list string) (prefix_length : i32) (name : string) : string =
    := reads = version_lines modules prefix_length (versioned_read_line name) []
    versioned_cases_text modules prefix_length name ++# versioned_reader_head name ++# join_lines reads "" ++# "\n"

:~ ^ versioned_type_texts
    (modules : list string) (prefix_length : i32) (names : list string) (acc : list string)
    : list string
    =
    ?= names ?|
    | name :: rest =>
        versioned_type_texts modules prefix_length rest (versioned_type_text modules prefix_length name :: acc)
    | [] => reverse acc []

:= emit_nominal_line (_ : string) (tag : string) : string = "nominal " ++# tag ++# " = string"

:= emit_witness_line (_ : string) (tag : string) : string =
    "    | " ++# upper_first tag ++# " :: string -> version_witness " ++# tag

:= emit_family_witnesses (modules : list string) (prefix_length : i32) : string =
    := witnesses = version_lines modules prefix_length emit_witness_line []
    "\nunion version_witness v =\n" ++# join_lines witnesses "" ++# "\n"

:= emit_versioned_types (modules : list string) (prefix_length : i32) (names : list string) : string =
    sm'::concat_balanced "" (versioned_type_texts modules prefix_length names [])

:= family_text (modules : list string) (names : list string) : string =
    := prefix_length = version_prefix_length modules
    join_lines (version_lines modules prefix_length emit_nominal_line []) ""
    ++# emit_family_witnesses modules prefix_length
    ++# emit_versioned_types modules prefix_length names

:~ ^ member_modules \* form. (members : list (string * xsd_schema form)) (acc : list string) : list string =
    ?= members ?|
    | (module_name, _) :: rest => member_modules rest (module_name :: acc)
    | [] => reverse acc []

:~ ^ member_parts \* form. (members : list (string * xsd_schema form)) (acc : list module_parts) : list module_parts =
    ?= members ?|
    | (_, schema) :: rest => member_parts rest (module_parts schema :: acc)
    | [] => reverse acc []

:= versioned_family_text \* form.
    (members : list (string * xsd_schema form)) (first : module_parts) (split : family_split)
    (versions : list module_parts)
    : string
    =
    family_text (member_modules members []) (versioned_names first::items split::shared versions [])

:= family_third \* form.
    (members : list (string * xsd_schema form)) (versions : list module_parts) (split : family_split)
    : string
    =
    ?= versions ?|
    | first :: _ => versioned_family_text members first split versions
    | [] => ""

:= generate_versioned_family \* form.
    (members : list (string * xsd_schema form)) (core_module : string)
    : string * list string * string
    =
    := versions = member_parts members []
    := split = split_family versions core_module
    split::core_text, split::version_texts, family_third members versions split

:= generate_enumerations \* form. (schema : xsd_schema form) : string =
    texts_of (reverse (emit_types schema::simple_types []) [])

///> rust
:# names_follow_spiral_conventions =
    ? type_name "TCodUfIBGE" <> "x_t_cod_uf_ibge" ?> failwith "snake case type name"
    ? case_name "TCodUfIBGE" "35" <> "TCodUfIBGE_35" ?> failwith "numeric case name"
    ? case_name "TVerNFe" "1.04" <> "TVerNFe_1_04" ?> failwith "dotted case name"
    ? case_name "TOrigem" "Não" <> "TOrigem_N_o" ?> failwith "non-ASCII value becomes an underscore"
    ? case_name "enviNFe_versao" "4.00" <> "XenviNFe_versao_4_00" ?> failwith "lowercase owner gets a capital prefix"
    ? field_name "type" <> "type_value" ?> failwith "keyword field"
    ? type_name "TNFe" <> "x_tn_fe" ?> failwith "an upper run splits before its last capital"
    ? case_name "TTransformURI" "http://www.w3.org/2000/09/xmldsig#enveloped-signature"
        <> "TTransformURI_enveloped_signature"
    ?> failwith "a URI value is named by its fragment"
    ? case_name "TTransformURI" "http://www.w3.org/TR/2001/REC-xml-c14n-20010315"
        <> "TTransformURI_REC_xml_c14n_20010315"
    ?> failwith "a URI value without a fragment is named by its last path segment"

///> rust
:# enumerations_parse_through_one_match =
    := text = union_text "TUf" ("SP" :: "RJ" :: []) ""
    ? sm'::contains "    match s with\n    | \"SP\" => Some TUf_SP\n" text = !- ?> failwith "one arm per value"
    ? sm'::contains "    | _ => None\n" text = !- ?> failwith "anything else is None"
    ? sm'::contains "if false" text ?> failwith "no dead first branch"
    := token_text = union_text "TUf" ("SP" :: "RJ" :: []) "xml.collapsed_space"
    ? sm'::contains "    inl s = xml.collapsed_space s\n    match s with\n" token_text = !-
    ?> failwith "a token enumeration collapses whitespace before matching, as XSD does"
    ? sm'::contains "inl s = " text ?> failwith "a string enumeration matches its text as written"

///> rust
:# families_share_identical_closed_types_once =
    := shared =
        "<xs:simpleType name=\"Code\"><xs:restriction base=\"xs:string\"><xs:pattern "
        ^^ "value=\"[0-9]{2}\"/></xs:restriction></xs:simpleType>"
    := leaf one =
        "<xs:complexType name=\"Leaf\"><xs:sequence><xs:element name=\"c\" type=\"Code\"/>"
        ++# one
        ++# "</xs:sequence></xs:complexType>"
    := root =
        "<xs:complexType name=\"Root\"><xs:sequence><xs:element name=\"l\" "
        ^^ "type=\"Leaf\"/></xs:sequence></xs:complexType>"
    := v1 = read_schema ("<xs:schema>" ++# shared ++# leaf "" ++# root ++# "</xs:schema>")
    := v2 =
        read_schema (
            "<xs:schema>" ++# shared ++# leaf "<xs:element name=\"extra\" type=\"Code\"/>" ++# root ++# "</xs:schema>"
        )
    := core, versions = generate_family (v1 :: v2 :: []) "generated_demo_core"
    ? sm'::contains "nominal private x_code = string" core = !- ?> failwith "the identical leaf type is in the core"
    ? sm'::contains "type x_leaf" core || sm'::contains "nominal x_leaf" core
    ?> failwith "the changed type stays per version"
    ? sm'::contains "type x_root" core || sm'::contains "nominal x_root" core
    ?> failwith "a type over a changed type stays per version"
    ?= versions ?|
    | first :: second :: [] =>
        ? sm'::starts_with "open generated_demo_core" first = !- ?> failwith "a version opens its core"
        ? sm'::contains "nominal private x_code" second ?> failwith "the core type is not repeated"
        ? sm'::contains "extra" first || sm'::contains "extra" second = !-
        ?> failwith "the version keeps its own shape"
    | _ => failwith "two version modules"

///> rust
:# versioned_families_read_through_one_witness =
    := shared =
        "<xs:simpleType name=\"Code\"><xs:restriction base=\"xs:string\"><xs:pattern "
        ^^ "value=\"[0-9]{2}\"/></xs:restriction></xs:simpleType>"
    := leaf one =
        "<xs:complexType name=\"Leaf\"><xs:sequence><xs:element name=\"c\" type=\"Code\"/>"
        ++# one
        ++# "</xs:sequence></xs:complexType>"
    := root =
        "<xs:complexType name=\"Root\"><xs:sequence><xs:element name=\"l\" "
        ^^ "type=\"Leaf\"/></xs:sequence></xs:complexType>"
    := v1 = read_schema ("<xs:schema>" ++# shared ++# leaf "" ++# root ++# "</xs:schema>")
    := v2 =
        read_schema (
            "<xs:schema>" ++# shared ++# leaf "<xs:element name=\"extra\" type=\"Code\"/>" ++# root ++# "</xs:schema>"
        )
    := _, _, family =
        generate_versioned_family (("generated_demo_v1", v1) :: ("generated_demo_v2", v2) :: []) "generated_demo_core"
    ? sm'::contains "nominal v1 = string\nnominal v2 = string\n" family = !-
    ?> failwith "one nominal per version, tagged past the shared prefix"
    ? sm'::contains "    | V2 :: string -> version_witness v2\n" family = !-
    ?> failwith "the witness indexes each version"
    ? sm'::contains "    | Leaf_v2 :: generated_demo_v2.x_leaf -> x_leaf v2\n" family = !-
    ?> failwith "a changed type becomes a version-indexed union"
    := v1 = "    | V1 _ => xml_codec.mapped (fun x => Leaf_v1 x) (generated_demo_v1.x_leaf_of_xml c)\n"
    ? sm'::contains v1 family = !-
    ?> failwith "the reader matches the witness once"
    ? sm'::contains "union x_root v =" family = !- ?> failwith "a type over a changed type is versioned too"
    ? sm'::contains "x_code" family ?> failwith "core types are not versioned"

:== complement_member form = { case_name : string; module_name : string; schema : xsd_schema form }

:= element_root_type \* form.
    (name : tag_name) (inline : option (xsd type_def form)) (type_ref : option (type_reference form))
    : string
    =
    ?= inline, type_ref ?|
    | Some _, _ => type_name (tag_text name)
    | None, Some reference => type_name (xml::local_name (reference_text reference))
    | None, None => type_name ""

:= root_reader \* form. (member : complement_member form) : string * string =
    ?= member::schema::elements ?|
    | (Element e) :: _ => xml::local_name (tag_text e::name), element_root_type e::name e::inline e::type_ref
    | _ => "", ""

:~ ^ complement_case_lines \* form. (members : list (complement_member form)) (acc : list string) : list string =
    ?= members ?|
    | member :: rest =>
        := _, ty = root_reader member
        complement_case_lines rest (
            "    | " ++# member::case_name ++# " : " ++# member::module_name ++# "." ++# ty :: acc
        )
    | [] => reverse acc []

:~ ^ complement_case_dispatch \* form. (members : list (complement_member form)) (acc : string) : string =
    ?= members ?|
    | member :: rest =>
        := element, ty = root_reader member
        := test =
            "local = \""
            ++# element
            ++# "\" && (space = \"\" || space = \""
            ++# escape_text (namespace_text member::schema::target_namespace)
            ++# "\")"
        complement_case_dispatch rest (
            acc
            ++# "if "
            ++# test
            ++# " then xml_codec.decoded_or (fun v => "
            ++# member::case_name
            ++# " v) (Unknown node) ("
            ++# member::module_name
            ++# "."
            ++# ty
            ++# "_of_xml node)\n    el"
        )
    | [] => acc ++# "se Unknown node\n"

:~ ^ complement_case_writes \* form. (members : list (complement_member form)) (acc : list string) : list string =
    ?= members ?|
    | member :: rest =>
        := element, ty = root_reader member
        := space = escape_text (namespace_text member::schema::target_namespace)
        := written = member::module_name ++# "." ++# ty ++# "_to_xml \"" ++# element ++# "\" v"
        := body = ? space = "" ?> written |: "complement_in \"" ++# space ++# "\" (" ++# written ++# ")"
        complement_case_writes rest ("    | " ++# member::case_name ++# " v => " ++# body :: acc)
    | [] => reverse acc []

:= complement_namespace_text () : string =
    "\ninl complement_namespace (node : xml.xml_node) : string =\n"
    ++# "    inl name = xml.node_name node\n"
    ++# "    inl colon = sm'.index_of \":\" name\n"
    ++# "    inl key = if colon >= 0i32 then sm'.(++#) \"xmlns:\" (sm'.substring 0i32 colon name) else \"xmlns\"\n"
    ++# "    match xml.attribute_of key (xml.element_attributes node) with\n"
    ++# "    | Some uri => uri\n"
    ++# "    | None => \"\"\n"

:= complement_in_text () : string =
    "\ninl complement_in (space : string) (node : xml.xml_node) : xml.xml_node =\n"
    ++# "    xml.element (xml.node_name node) ((\"xmlns\", space) :: xml.element_attributes node)"
    ++# " (xml.element_children node)\n"

:= complement_reader_text \* form. (members : list (complement_member form)) : string =
    "\ninl complement_of_xml (node : xml.xml_node) : complement =\n"
    ++# "    inl local = xml.local_name (xml.node_name node)\n"
    ++# "    inl space = complement_namespace node\n"
    ++# "    "
    ++# complement_case_dispatch members ""

:= complement_writer_text \* form. (members : list (complement_member form)) : string =
    complement_in_text ()
    ++# "\ninl complement_to_xml (x : complement) : xml.xml_node =\n"
    ++# "    match x with\n"
    ++# join_lines (complement_case_writes members []) ""
    ++# "    | Unknown node => node\n"

:= generate_complements \* form. (members : list (complement_member form)) : string =
    := head =
        "union complement =\n"
        ++# join_lines (complement_case_lines members []) ""
        ++# "    | Unknown : xml.xml_node\n"
    head ++# complement_namespace_text () ++# complement_reader_text members ++# complement_writer_text members

:= complement_any_content () : string =
    "type any_content = list complement\n\n"
    ++# "inl any_content_of (nodes : list xml.xml_node) : any_content = listm.map complement_of_xml nodes\n\n"
    ++# "inl any_content_to (content : any_content) : list xml.xml_node = listm.map complement_to_xml content\n\n"

///> rust
:# complements_read_and_write_typed_cases_and_keep_unknown_elements_whole =
    := pagos =
        read_schema (
            "<xs:schema targetNamespace=\"http://www.sat.gob.mx/Pagos20\"><xs:element "
            ^^ "name=\"Pagos\"><xs:complexType><xs:sequence><xs:element name=\"Monto\" "
            ^^ "type=\"xs:string\"/></xs:sequence></xs:complexType></xs:element></xs:schema>"
        )
    := text =
        generate_complements ({ case_name = "Pagos20"; module_name = "generated_cfdi_pagos20"; schema = pagos } :: [])
    ?
        sm'::contains
            (
                "union complement =\n    | Pagos20 : generated_cfdi_pagos20.x_pagos\n"
                ^^ "    | Unknown : xml.xml_node\n"
            )
            text
        = !-
    ?> failwith "one typed case per complement plus Unknown"
    := typed =
        "then xml_codec.decoded_or (fun v => Pagos20 v) (Unknown node) (generated_cfdi_pagos20.x_pagos_of_xml node)"
    ? sm'::contains typed text = !-
    ?> failwith "the reader builds the typed case"
    ? sm'::contains "else Unknown node\n" text = !- ?> failwith "an unknown complement keeps its whole element"
    ?
        sm'::contains
            (
                "    | Pagos20 v => complement_in \"http://www.sat.gob.mx/Pagos20\" "
                ^^ "(generated_cfdi_pagos20.x_pagos_to_xml \"Pagos\" v)\n"
            )
            text
        = !-
    ?> failwith "the writer emits the typed case in its schema namespace"
    ? sm'::contains "    | Unknown node => node\n" text = !- ?> failwith "the writer returns an unknown element as read"
    ? sm'::contains "exists" text ?> failwith "no existential in the runtime slot"
    ? sm'::contains "then sm'.(++#) \"xmlns:\" (sm'.substring 0i32 colon name)" text = !-
    ?> failwith "the emitted code spells the operator the way generated units do (they don't open sm'_operators)"

///> rust
:# constrained_strings_become_validated_nominals =
    := schema =
        read_schema (
            "<xs:schema><xs:simpleType name=\"TCnpj\"><xs:restriction base=\"xs:string\"><xs:pattern "
            ++# "value=\"[0-9]{14}\"/></xs:restriction></xs:simpleType><xs:simpleType name=\"TFree\">"
            ++# "<xs:restriction base=\"xs:string\"/></xs:simpleType></xs:schema>"
        )
    := text = generate_module (xsd_resolve::finalize_names (xsd_resolve::qualify_schema [] schema))
    ? sm'::contains "nominal private x_t_cnpj = string" text = !-
    ?> failwith "a constrained string is a private nominal"
    ? sm'::contains "if x_t_cnpj_is_valid s then Some (x_t_cnpj s) else None" text = !-
    ?> failwith "the only way in is the validator"
    ? sm'::contains "type x_t_free = string" text = !- ?> failwith "an unconstrained string stays an alias"
    ?= any_validated_type schema ?|
    | Some name => ? name <> "x_t_cnpj" ?> failwith "the validated type is the constrained one"
    | None => failwith "a schema with a constrained string has a validated type"

///> rust
:# value_sets_compare_by_kind_and_values =
    ? same_value_set (UnionValueSet [ "a"; "b" ]) (UnionValueSet [ "a"; "b" ]) = !-
    ?> failwith "equal value lists share"
    ? same_value_set (UnionValueSet [ "a" ]) (UnionValueSet [ "a"; "b" ]) ?> failwith "a prefix is not the same set"
    ? same_value_set (DfaValueSet "t") (UnionValueSet [ "t" ]) ?> failwith "a table never equals a value list"
    ? same_value_set NoValueSet NoValueSet ?> failwith "a type without a value set never shares"

///> rust
:# dfa_tables_carry_their_certificates =
    := schema =
        read_schema (
            "<xs:schema><xs:simpleType name=\"TDigits\"><xs:restriction base=\"xs:string\"><xs:pattern "
            ++# "value=\"[0-9]{2}\"/></xs:restriction></xs:simpleType></xs:schema>"
        )
    := main, unit = generated_units schema
    ? sm'::contains "_certificate () =" main ?> failwith "certificates leave the main unit"
    ?= unit ?|
    | Some text =>
        ? sm'::contains "_certificate () =" text = !- ?> failwith "a pattern's DFA is emitted with its certificate"
        ? sm'::contains "xsd_certificate.PackedMoves (exists (xsd_certificate.MovesNext (" text = !-
        ?> failwith "each row's moves are packed as a length-indexed witness"
        ? sm'::contains "inl certificates_checked () : i32 = 0i32 + xsd_certificate.certified_table (" text = !-
        ?> failwith "the module sums its certified tables"
    | None => failwith "a pattern makes a certificates unit"

///> rust
:# pattern_restricted_dates_keep_a_valid_date =
    ? simple_example "xs:date" (Pattern "[0-9]{4}-[0-9]{2}-[0-9]{2}" :: []) <> "2026-01-01"
    ?> failwith "a date pattern keeps the builtin's valid date instead of zeros"
    ? simple_example "xs:date" (Pattern "1999-[0-9]{2}-[0-9]{2}" :: []) = "2026-01-01"
    ?> failwith "a pattern the builtin date does not match still searches"

///> rust
:# pattern_restricted_positive_integers_stay_positive =
    ? simple_example "xs:positiveInteger" (Pattern "[0-9][0-9]" :: TotalDigits 2i32 :: []) <> "01"
    ?> failwith "a two-digit positiveInteger pattern pads 1 instead of writing 00"
    ? simple_example "xs:positiveInteger" (Pattern "[0-9]{1,3}" :: []) <> "1"
    ?> failwith "a positiveInteger pattern that takes 1 keeps 1"

///> rust
:# example_ids_are_unique_per_owner =
    := schema =
        read_schema (
            "<xs:schema><xs:complexType name=\"SetDTE\"><xs:sequence/>"
            ^^ "<xs:attribute name=\"ID\" type=\"xs:ID\" use=\"required\"/></xs:complexType>"
            ^^ "<xs:complexType name=\"Documento\"><xs:sequence/>"
            ^^ "<xs:attribute name=\"ID\" type=\"xs:ID\" use=\"required\"/></xs:complexType></xs:schema>"
        )
    := generated = generate_module (xsd_resolve::finalize_names (xsd_resolve::qualify_schema [] schema))
    ? sm'::contains ("\"ID_" ++# type_name "SetDTE" ++# "\"") generated = !-
    ?> failwith "the SetDTE example ID names its owner"
    ? sm'::contains ("\"ID_" ++# type_name "Documento" ++# "\"") generated = !-
    ?> failwith "the Documento example ID names its owner"
    ? sm'::contains "\"ID1\"" generated
    ?> failwith "no two xs:ID sites share the constant ID1"

///> rust
:# each_field_meta_names_its_tag_and_occurs =
    := schema =
        read_schema (
            "<xs:schema><xs:complexType name=\"TLine\"><xs:sequence><xs:element name=\"Code\" "
            ^^ "type=\"xs:string\"/><xs:element name=\"Note\" type=\"xs:string\" minOccurs=\"0\"/><xs:element "
            ^^ "name=\"Mark\" type=\"xs:string\" minOccurs=\"0\" maxOccurs=\"unbounded\"/></xs:sequence></xs:complexTy"
            ^^ "pe></xs:schema>"
        )
    := generated = generate_module (xsd_resolve::finalize_names (xsd_resolve::qualify_schema [] schema))
    := ty = type_name "TLine"
    ? sm'::contains ("inl " ++# ty ++# "_fields () : list (exists r. " ++# ty ++# "_field r) = [exists ") generated = !-
    ?> failwith "a witnessed record lists its fields existentially"
    ?
        sm'::contains
            ("inl " ++# ty ++# "_field_meta forall r. (f : " ++# ty ++# "_field r) : xml_codec.field_meta =")
            generated
        = !-
    ?> failwith "a witnessed record maps each field to its meta"
    ? sm'::contains "{ tag = \"Code\"; min = 1i32; max = Some 1i32 }" generated = !-
    ?> failwith "a required element carries occurs 1..1"
    ? sm'::contains "{ tag = \"Note\"; min = 0i32; max = Some 1i32 }" generated = !-
    ?> failwith "an optional element carries occurs 0..1"
    ? sm'::contains "{ tag = \"Mark\"; min = 0i32; max = None }" generated = !-
    ?> failwith "a repeated element carries an open upper bound"

///> rust
:# coded_types_share_the_text_prototype =
    := coded = union_text "TUf" [ "SP"; "RJ" ] ""
    ? sm'::contains "instance to_text x_t_uf = fun x => x_t_uf_to_string x\n" coded = !-
    ?> failwith "an enum union gets its to_text instance"
    := schema =
        read_schema (
            "<xs:schema><xs:simpleType name=\"TCep\"><xs:restriction base=\"xs:string\">"
            ^^ "<xs:pattern value=\"[0-9]{8}\"/></xs:restriction></xs:simpleType></xs:schema>"
        )
    := generated = generate_module (xsd_resolve::finalize_names (xsd_resolve::qualify_schema [] schema))
    ? sm'::starts_with "open xml_codec\n\nprototype to_text t : t -> string\n" generated = !-
    ?> failwith "the module opens the codec prototypes, then declares to_text before any instance"
    ? sm'::contains "instance to_text x_t_cep = fun x => x_t_cep_to_string x\n" generated = !-
    ?> failwith "a validated nominal gets its instance"

///> rust
:# a_type_named_like_a_certificate_stays_in_the_main_unit =
    := schema =
        read_schema (
            "<xs:schema><xs:complexType name=\"CertificateValuesType\"><xs:choice>"
            ++# "<xs:element name=\"EncapsulatedX509Certificate\" type=\"xs:string\"/>"
            ++# "<xs:element name=\"OtherCertificate\" type=\"xs:string\"/></xs:choice></xs:complexType></xs:schema>"
        )
    := main, certificates = generated_units schema
    ? sm'::contains "union x_certificate_values_type_choice_encapsulated_x509_certificate =" main = !-
    ?> failwith "a type whose name ends in _certificate stays in the main unit"
    ?= certificates ?|
    | Some text ?& sm'::contains "xsd_certificate.certified_table (x_certificate_values_type" text =>
        failwith "only certificate items are certified"
    | _ => ()

///> rust
:# a_choice_of_only_wildcards_is_any_content =
    := schema =
        read_schema (
            "<xs:schema><xs:complexType name=\"SignaturePropertyType\"><xs:choice maxOccurs=\"unbounded\">"
            ++# "<xs:any namespace=\"##other\" processContents=\"lax\"/></xs:choice>"
            ++# "<xs:attribute name=\"Target\" type=\"xs:anyURI\" use=\"required\"/></xs:complexType></xs:schema>"
        )
    := main, _ = generated_units schema
    ? sm'::contains "choice_empty" main ?> failwith "a wildcard-only choice emits no empty union"
    ? sm'::contains (field_line "any" "any_content") main = !-
    ?> failwith "a wildcard-only choice keeps its content as any_content"
    ? sm'::contains "type any_content = list xml.xml_node\n" main = !-
    ?> failwith "by default any_content is the raw nodes"

///> rust
:# a_sequence_of_only_wildcards_is_any_content =
    := schema =
        read_schema (
            "<xs:schema><xs:complexType name=\"ObjectType\" mixed=\"true\">"
            ++# "<xs:sequence minOccurs=\"0\" maxOccurs=\"unbounded\">"
            ++# "<xs:any namespace=\"##any\" processContents=\"lax\"/>"
            ++# "</xs:sequence><xs:attribute name=\"Id\" type=\"xs:ID\" use=\"optional\"/></xs:complexType></xs:schema>"
        )
    := main, _ = generated_units schema
    ? sm'::contains "group_empty" main ?> failwith "a wildcard-only sequence emits no empty group"
    ? sm'::contains (field_line "any" "any_content") main = !-
    ?> failwith "a wildcard-only sequence keeps its content as any_content"
    ? sm'::contains "v_any, errors = any_content_of (xml.unclaimed_children" main = !-
    ?> failwith "the reader keeps every unclaimed child of a wildcard-only sequence"

///> rust
:# cyclic_types_become_one_recursive_group =
    := schema =
        read_schema (
            "<xs:schema><xs:complexType name=\"PartyType\"><xs:sequence>"
            ++# "<xs:element name=\"Name\" type=\"xs:string\"/>"
            ++# "<xs:element name=\"Location\" type=\"LocationType\" minOccurs=\"0\"/></xs:sequence></xs:complexType>"
            ++# "<xs:complexType name=\"LocationType\"><xs:sequence>"
            ++# "<xs:element name=\"Party\" type=\"PartyType\" minOccurs=\"0\" maxOccurs=\"unbounded\"/>"
            ++# "</xs:sequence></xs:complexType></xs:schema>"
        )
    := main, _ = generated_units schema
    ? sm'::contains "union rec x_" main = !- ?> failwith "a cycle opens one recursive group"
    ? sm'::contains "    | Record_x_party_type :\n        {\n" main = !-
    ?> failwith "a cyclic record is wrapped in its union"
    ? sm'::contains "inl x = match x' with | Record_x_party_type r => r" main = !- ?> failwith "its writer unwraps once"
    ? sm'::contains "type x_party_type =" main || sm'::contains "nominal x_party_type =" main
    ?> failwith "no cyclic record stays a type alias"

///> rust
:# a_wildcard_reads_the_children_no_named_element_claims =
    := schema =
        read_schema (
            "<xs:schema><xs:complexType name=\"ModalType\"><xs:sequence>"
            ++# "<xs:element name=\"Version\" type=\"xs:string\"/><xs:any processContents=\"skip\"/>"
            ++# "</xs:sequence></xs:complexType></xs:schema>"
        )
    := main, _ = generated_units schema
    ? sm'::contains "v_any, errors = any_content_of (xml.unclaimed_children [\"Version\"] children), errors" main = !-
    ?> failwith "the reader keeps the wildcard's children instead of dropping them"
    ? sm'::contains "        any = []\n" main ?> failwith "no reader discards wildcard content"
    := typed, _ = generated_units_with (complement_any_content ()) schema
    ? sm'::contains "type any_content = list complement\n" typed = !-
    ?> failwith "a family with complements types its wildcard content"
    ? sm'::contains "list xml.xml_node\n\ninl any_content_of" typed ?> failwith "the override replaces the default"
    := plain, _ =
        generated_units (read_schema "<xs:schema><xs:element name=\"Note\" type=\"xs:string\"/></xs:schema>")
    ? sm'::contains "any_content" plain ?> failwith "a unit without a wildcard keeps no any_content"

///> rust
:# a_choice_of_emptiable_alternatives_reads_its_empty_content =
    := schema =
        read_schema (
            "<xs:schema><xs:complexType name=\"TransportType\"><xs:choice><xs:sequence>"
            ++# "<xs:element name=\"Vehicle\" type=\"xs:string\" minOccurs=\"0\"/>"
            ++# "<xs:element name=\"Trailer\" type=\"xs:string\" minOccurs=\"0\" maxOccurs=\"5\"/></xs:sequence>"
            ++# "<xs:element name=\"Wagon\" type=\"xs:string\" minOccurs=\"0\"/></xs:choice></xs:complexType>"
            ++# "<xs:complexType name=\"PickType\"><xs:choice><xs:element name=\"A\" type=\"xs:string\"/>"
            ++# "<xs:element name=\"B\" type=\"xs:string\"/></xs:choice></xs:complexType></xs:schema>"
        )
    := main, _ = generated_units schema
    ? sm'::contains "    else xml_codec.no_alternative \"x_transport_type_choice_vehicle\"" main
    ?> failwith "a choice whose alternatives can be empty reads its empty content"
    ? sm'::contains "    else xml_codec.no_alternative \"x_pick_type_choice_a\"" main = !-
    ?> failwith "a choice of required alternatives still rejects missing content"

///> rust
:# a_repeated_choice_reads_every_alternative_in_document_order =
    := schema =
        read_schema (
            "<xs:schema><xs:complexType name=\"KeyInfoType\"><xs:choice maxOccurs=\"unbounded\">"
            ++# "<xs:element name=\"KeyName\" type=\"xs:string\"/><xs:element name=\"MgmtData\" type=\"xs:string\"/>"
            ++# "</xs:choice></xs:complexType><xs:complexType name=\"X509DataType\">"
            ++# "<xs:sequence maxOccurs=\"unbounded\">"
            ++# "<xs:choice><xs:element name=\"X509SKI\" type=\"xs:string\"/><xs:element name=\"X509SubjectName\" "
            ++# "type=\"xs:string\"/></xs:choice></xs:sequence></xs:complexType>"
            ++# "<xs:complexType name=\"RegistroFacturaType\"><xs:choice><xs:element name=\"sf:RegistroAlta\" "
            ++# "type=\"xs:string\"/><xs:element name=\"sf:RegistroAnulacion\" "
            ++# "type=\"xs:string\"/></xs:choice></xs:complexType></xs:schema>"
        )
    := main, _ = generated_units schema
    ? sm'::contains "xml.claimed_children [\"KeyName\"; \"MgmtData\"] children" main = !-
    ?> failwith "each claimed child is read on its own, in document order"
    ? sm'::contains "xml.claimed_children [\"X509SKI\"; \"X509SubjectName\"] children" main = !-
    ?> failwith "a repeated sequence around one choice repeats the choice (xmldsig X509Data)"
    ? sm'::contains "        choice_registro_alta : x_registro_factura_type_choice" main = !-
    ?> failwith "a prefixed choice keeps its choice_ field name in the type (VeriFactu sf:RegistroAlta)"
    := reader_field =
        "o_choice_registro_alta, errors = xml_codec.taken (x_registro_factura_type_choice_sf_registro_alta"
    ? sm'::contains reader_field main = !-
    ?> failwith "the reader fills the same field the type declares"

///> rust
:# restrictions_alias_parents_and_readers_apply_white_space_and_fixed =
    := schema =
        read_schema (
            "<xs:schema><xs:simpleType name=\"TString\"><xs:restriction base=\"xs:string\">"
            ++# "<xs:pattern value=\"[A-Z]+\"/></xs:restriction></xs:simpleType>"
            ++# "<xs:simpleType name=\"TServ\"><xs:restriction base=\"TString\"/></xs:simpleType>"
            ++# "<xs:simpleType name=\"TCode\"><xs:restriction base=\"xs:token\"><xs:pattern value=\"[A-Z]+\"/>"
            ++# "</xs:restriction></xs:simpleType><xs:simpleType name=\"TLine\"><xs:restriction base=\"xs:string\">"
            ++# "<xs:whiteSpace value=\"replace\"/><xs:maxLength value=\"9\"/>"
            ++# "</xs:restriction></xs:simpleType><xs:complexType name=\"TDoc\"><xs:attribute name=\"Version\" "
            ++# "type=\"xs:string\" use=\"required\" fixed=\"4.0\"/></xs:complexType></xs:schema>"
        )
    := main, _ = generated_units schema
    ? sm'::contains "type x_t_serv = x_t_string" main = !- ?> failwith "the restriction aliases its parent"
    ? sm'::contains "x_t_serv_of_string (s : string) : option x_t_serv = x_t_string_of_string s" main = !-
    ?> failwith "reading goes through the parent's validator"
    ? sm'::contains "match xml.collapsed_space s with s => if x_t_code_is_valid s" main = !-
    ?> failwith "a token restriction validates its collapsed value"
    ? sm'::contains "match xml.replaced_space s with s => if x_t_line_is_valid s" main = !-
    ?> failwith "an explicit whiteSpace facet wins over the base"
    ? sm'::contains "match xml.collapsed_space s with s => if x_t_string_is_valid" main
    ?> failwith "an xs:string restriction preserves its text"
    ?
        sm'::contains "xml_codec.attribute_required \"Version\" attributes errors" main = !-
        || sm'::contains "inl errors = xml_codec.fixed_checked \"Version\" \"4.0\" attributes errors" main = !-
    ?> failwith "a fixed attribute reads through its check"

///> rust
:# a_required_signature_stages_its_type_and_every_type_that_holds_it =
    := schema =
        read_schema (
            "<xs:schema><xs:complexType name=\"TDoc\"><xs:sequence><xs:element name=\"ID\" type=\"xs:string\"/>"
            ++# "<xs:element ref=\"ds:Signature\"/></xs:sequence></xs:complexType>"
            ++# "<xs:complexType name=\"TBatch\"><xs:sequence>"
            ++# "<xs:element name=\"Doc\" type=\"TDoc\" maxOccurs=\"unbounded\"/></xs:sequence></xs:complexType>"
            ++# "<xs:complexType name=\"TDraft\"><xs:sequence><xs:element name=\"ID\" type=\"xs:string\"/>"
            ++# "<xs:element ref=\"ds:Signature\" minOccurs=\"0\"/></xs:sequence></xs:complexType>"
            ++# "<xs:complexType name=\"TPlain\"><xs:sequence><xs:element name=\"Name\" type=\"xs:string\"/>"
            ++# "</xs:sequence></xs:complexType>"
            ++# "<xs:element name=\"Envelope\"><xs:complexType><xs:sequence><xs:element ref=\"ds:Signature\"/>"
            ++# "</xs:sequence></xs:complexType></xs:element></xs:schema>"
        )
    := names = staged_type_names [ "Signature" ] schema
    ? has_name (type_name "TDoc") names = !- ?> failwith "a required signature stages its type"
    ? has_name (type_name "TBatch") names = !- ?> failwith "a type that holds a staged type is staged too"
    ? has_name (type_name "Envelope") names = !- ?> failwith "an inline type with a required signature is staged"
    ? has_name (type_name "TDraft") names ?> failwith "an optional signature needs no stage"
    ? has_name (type_name "TPlain") names ?> failwith "a type without a signature is not staged"

///> rust
:# staged_types_take_the_stage_and_pass_it_on =
    := schema =
        read_schema (
            "<xs:schema><xs:complexType name=\"TDoc\"><xs:sequence><xs:element name=\"ID\" type=\"xs:string\"/>"
            ++# "<xs:element ref=\"ds:Signature\"/></xs:sequence></xs:complexType>"
            ++# "<xs:complexType name=\"TBatch\"><xs:sequence>"
            ++# "<xs:element name=\"Doc\" type=\"TDoc\" maxOccurs=\"unbounded\"/></xs:sequence></xs:complexType>"
            ++# "<xs:complexType name=\"TDraft\"><xs:sequence><xs:element name=\"ID\" type=\"xs:string\"/>"
            ++# "<xs:element ref=\"ds:Signature\" minOccurs=\"0\"/></xs:sequence></xs:complexType>"
            ++# "<xs:complexType name=\"TPlain\"><xs:sequence><xs:element name=\"Name\" type=\"xs:string\"/>"
            ++# "</xs:sequence></xs:complexType></xs:schema>"
        )
    := staged = staged_type_names [ "Signature" ] schema
    := items = staged_items staged [ "Signature" ] (module_parts schema)::items
    := text = join_lines (listm::map (\ (item : emitted) => item::text) items) ""
    := doc = type_name "TDoc"
    ? sm'::contains ("nominal " ++# doc ++# " s =\n") text = !- ?> failwith "a staged type takes the stage"
    ? sm'::contains (field_line "Signature" "staged s string" ++# "\n") text = !-
    ?> failwith "its signature is the staged slot"
    ? sm'::contains ("nominal " ++# type_name "TBatch" ++# " s =\n") text = !- ?> failwith "a container is staged too"
    ? sm'::contains (field_line "Doc" ("list (" ++# doc ++# " s)")) text = !-
    ?> failwith "a container passes the stage on"
    ? sm'::contains ("nominal " ++# type_name "TDraft" ++# " =\n") text = !-
    ?> failwith "an optional signature needs no stage"
    ? sm'::contains ("nominal " ++# type_name "TPlain" ++# " =\n") text = !- ?> failwith "an unsigned type is unchanged"
    ? sm'::contains "    | Present :: forall a. a -> staged signed a\n" (staging_prelude ()) = !-
    ?> failwith "one shared slot whose signed case holds the signature"

///> rust
:# a_resolved_signature_and_a_referenced_signed_type_are_staged =
    := schema =
        read_schema (
            "<xs:schema><xs:element name=\"Signature\" type=\"SignatureType\"/>"
            ++# "<xs:complexType name=\"SignatureType\"><xs:sequence><xs:element name=\"Value\" type=\"xs:string\"/>"
            ++# "</xs:sequence></xs:complexType>"
            ++# "<xs:complexType name=\"TDoc\"><xs:sequence><xs:element name=\"ID\" type=\"xs:string\"/>"
            ++# "<xs:element ref=\"ds:Signature\"/></xs:sequence></xs:complexType>"
            ++# "<xs:element name=\"Doc\" type=\"TDoc\"/>"
            ++# "<xs:element name=\"Envelope\"><xs:complexType><xs:sequence><xs:element name=\"Set\"><xs:complexType>"
            ++# "<xs:sequence><xs:element ref=\"Doc\" maxOccurs=\"unbounded\"/></xs:sequence></xs:complexType>"
            ++# "</xs:element></xs:sequence></xs:complexType></xs:element></xs:schema>"
        )
    := staged = staged_type_names [ "Signature" ] schema
    ? has_name (type_name "Envelope_Set") staged = !-
    ?> failwith "an inline type named along its owners that holds a referenced signed type is staged"
    ? has_name (type_name "Envelope") staged = !- ?> failwith "and so is the element that holds it"
    := items = staged_items staged [ "Signature" ] (module_parts schema)::items
    := text = join_lines (listm::map (\ (item : emitted) => item::text) items) ""
    ? sm'::contains (field_line "Signature" ("staged s " ++# type_name "SignatureType") ++# "\n") text = !-
    ?> failwith "a resolved signature element is the staged slot"
    ? sm'::contains (field_line "Doc" ("list (" ++# type_name "TDoc" ++# " s)")) text = !-
    ?> failwith "the inline set passes the stage on to the referenced documents"

///> rust
:# staged_readers_take_the_witness_and_stage_the_signature =
    := schema =
        read_schema (
            "<xs:schema><xs:complexType name=\"TDoc\"><xs:sequence><xs:element name=\"ID\" type=\"xs:string\"/>"
            ++# "<xs:element ref=\"ds:Signature\"/></xs:sequence></xs:complexType>"
            ++# "<xs:complexType name=\"TBatch\"><xs:sequence>"
            ++# "<xs:element name=\"Doc\" type=\"TDoc\" maxOccurs=\"unbounded\"/></xs:sequence></xs:complexType>"
            ++# "<xs:complexType name=\"TPlain\"><xs:sequence><xs:element name=\"Name\" type=\"xs:string\"/>"
            ++# "</xs:sequence></xs:complexType></xs:schema>"
        )
    := staged = staged_type_names [ "Signature" ] schema
    := functions = join_lines (module_parts_with (StagedReading (staged, [ "Signature" ])) schema)::functions ""
    := doc = type_name "TDoc"
    := plain = type_name "TPlain"
    ? sm'::contains ("and let " ++# doc ++# "_of_children forall s.") functions = !-
    ?> failwith "a staged type's reader takes the stage"
    ? sm'::contains "(witness : stage s)" functions = !- ?> failwith "and the stage's witness"
    ? sm'::contains "staged_read witness (fun errors =>" functions = !-
    ?> failwith "the signature is read through the witness"
    ? sm'::contains ("(" ++# doc ++# "_of_xml witness)") functions = !- ?> failwith "a container passes the witness on"
    ? sm'::contains ("and let " ++# plain ++# "_of_children") functions = !-
    ?> failwith "an unsigned type still has a reader"
    ? sm'::contains (plain ++# "_of_children forall") functions ?> failwith "an unsigned type's reader takes no stage"
    ? sm'::contains "union stage s =\n" (staging_prelude ()) = !- ?> failwith "the prelude carries the stage witness"

///> rust
:# staged_writers_write_any_stage_and_only_a_present_signature =
    := schema =
        read_schema (
            "<xs:schema><xs:complexType name=\"TDoc\"><xs:sequence><xs:element name=\"ID\" type=\"xs:string\"/>"
            ++# "<xs:element ref=\"ds:Signature\"/></xs:sequence></xs:complexType>"
            ++# "<xs:complexType name=\"TPlain\"><xs:sequence><xs:element name=\"Name\" type=\"xs:string\"/>"
            ++# "</xs:sequence></xs:complexType></xs:schema>"
        )
    := staged = staged_type_names [ "Signature" ] schema
    := functions = join_lines (module_parts_staged staged [ "Signature" ] schema)::functions ""
    := doc = type_name "TDoc"
    := plain = type_name "TPlain"
    ? sm'::contains ("and let " ++# doc ++# "_to_xml forall s. (name : string) (x : " ++# doc ++# " s)") functions = !-
    ?> failwith "a staged writer writes a document at any stage (signing needs the unsigned XML)"
    ? sm'::contains "staged_list (fun v =>" functions = !- ?> failwith "the signature is written only when present"
    ? sm'::contains ("and let " ++# doc ++# "_of_children forall s.") functions = !-
    ?> failwith "the staged readers come with the staged writers"
    ? sm'::contains ("and let " ++# plain ++# "_to_xml (name : string) (x : " ++# plain ++# ")") functions = !-
    ?> failwith "an unsigned type keeps its plain writer"
    ? sm'::contains "inl staged_list forall s a b. (f : a -> b) (x : staged s a) : list b =" (staging_prelude ()) = !-
    ?> failwith "the prelude writes a pending slot as nothing"
    ? sm'::contains "inl signed_value forall a. (x : staged signed a) : a =" (staging_prelude ()) = !-
    ?> failwith "the prelude reads a signed slot without an unsigned case"

///> rust
:# a_required_signature_list_is_staged_as_one_slot =
    := schema =
        read_schema (
            "<xs:schema><xs:complexType name=\"TDoc\"><xs:sequence><xs:element name=\"ID\" type=\"xs:string\"/>"
            ++# "<xs:element ref=\"ds:Signature\" minOccurs=\"1\" maxOccurs=\"5\"/></xs:sequence></xs:complexType>"
            ++# "<xs:complexType name=\"TOne\"><xs:sequence><xs:element name=\"ID\" type=\"xs:string\"/>"
            ++# "<xs:element ref=\"ds:Signature\"/></xs:sequence></xs:complexType></xs:schema>"
        )
    := staged = staged_type_names [ "Signature" ] schema
    := items = staged_items staged [ "Signature" ] (module_parts schema)::items
    := text = join_lines (listm::map (\ (item : emitted) => item::text) items) ""
    ? sm'::contains (field_line "Signature" "staged s (list (string))" ++# "\n") text = !-
    ?> failwith "a required signature list is one staged slot"
    := functions = join_lines (module_parts_staged staged [ "Signature" ] schema)::functions ""
    ? sm'::contains "staged_read witness (fun errors => xml_codec.as_some (xml_codec.read_repeated" functions = !-
    ?> failwith "the reader stages the whole list"
    ? sm'::contains "listm.concat (staged_list (fun vs => listm.map (fun v =>" functions = !-
    ?> failwith "the writer writes every present signature"
    ? sm'::contains "staged_list (fun v =>" functions = !-
    ?> failwith "a single required signature keeps its one-value slot"
    ? sm'::contains "signature = [" functions ?> failwith "the example leaves the whole signature list pending"

///> rust
:# staged_examples_are_unsigned =
    := schema =
        read_schema (
            "<xs:schema><xs:complexType name=\"TDoc\"><xs:sequence><xs:element name=\"ID\" type=\"xs:string\"/>"
            ++# "<xs:element ref=\"ds:Signature\"/></xs:sequence></xs:complexType>"
            ++# "<xs:complexType name=\"TPlain\"><xs:sequence><xs:element name=\"Name\" type=\"xs:string\"/>"
            ++# "</xs:sequence></xs:complexType></xs:schema>"
        )
    := staged = staged_type_names [ "Signature" ] schema
    := functions = join_lines (module_parts_staged staged [ "Signature" ] schema)::functions ""
    := doc = type_name "TDoc"
    := plain = type_name "TPlain"
    ? sm'::contains ("and let " ++# doc ++# "_example (k : i32) : " ++# doc ++# " unsigned =") functions = !-
    ?> failwith "a staged type's example is unsigned"
    ? sm'::contains "signature = Pending \"an unsigned example\"" functions = !- ?> failwith "its signature is pending"
    ? sm'::contains ("and let " ++# plain ++# "_example (k : i32) : " ++# plain ++# " =") functions = !-
    ?> failwith "an unsigned type's example is unchanged"

///> rust
:# a_family_with_required_signatures_generates_staged_units =
    := signed =
        read_schema (
            "<xs:schema><xs:complexType name=\"TDoc\"><xs:sequence><xs:element name=\"ID\" type=\"xs:string\"/>"
            ++# "<xs:element ref=\"ds:Signature\"/></xs:sequence></xs:complexType></xs:schema>"
        )
    := main, _ = generated_units_signed [ "Signature" ] (untyped_any_content ()) signed
    := doc = type_name "TDoc"
    ? sm'::contains "union stage s =\n" main = !- ?> failwith "a signed family's unit carries the staging prelude"
    ? sm'::contains ("nominal " ++# doc ++# " s =\n") main = !- ?> failwith "its staged types take the stage"
    ? sm'::contains (doc ++# "_of_children forall s.") main = !- ?> failwith "its readers take the witness"
    := plain = read_schema "<xs:schema><xs:element name=\"Note\" type=\"xs:string\"/></xs:schema>"
    := unchanged, _ = generated_units_signed [ "Signature" ] (untyped_any_content ()) plain
    := before, _ = generated_units plain
    ? unchanged <> before ?> failwith "a family without required signatures generates exactly what it did before"

///> rust
:# a_restriction_redeclaring_an_attribute_writes_it_once =
    := schema =
        read_schema (
            "<xs:schema><xs:complexType name=\"TBase\"><xs:simpleContent><xs:extension base=\"xs:decimal\">"
            ++# "<xs:attribute name=\"cur\" type=\"xs:string\" use=\"optional\"/>"
            ++# "<xs:attribute name=\"ver\" type=\"xs:string\" use=\"optional\"/></xs:extension></xs:simpleContent>"
            ++# "</xs:complexType><xs:complexType name=\"TAmount\"><xs:simpleContent><xs:restriction base=\"TBase\">"
            ++# "<xs:attribute name=\"cur\" type=\"xs:string\" use=\"required\"/></xs:restriction></xs:simpleContent>"
            ++# "</xs:complexType></xs:schema>"
        )
    := functions = join_lines (module_parts schema)::functions ""
    ? sm'::contains "listm'.filter (fun (n, _) => n <> \"cur\") (" functions = !-
    ?> failwith "the base's attributes leave out the one the restriction re-declares"
    ? sm'::contains "\"ver\"" functions = !- ?> failwith "the base's other attributes are still written"

///> rust
:# builtins_become_lexical_carriers =
    := schema =
        read_schema (
            "<xs:schema><xs:element name=\"Order\"><xs:complexType><xs:sequence>"
            ++# (
                "<xs:element name=\"Total\" type=\"xs:decimal\"/><xs:element name=\"Lines\" "
                ^^ "type=\"xs:positiveInteger\"/>"
            )
            ++# (
                "<xs:element name=\"Paid\" type=\"xs:boolean\" minOccurs=\"0\"/><xs:element name=\"Price\" "
                ^^ "type=\"TAmount\"/>"
            )
            ++# (
                "</xs:sequence><xs:attribute name=\"seq\" type=\"xs:int\" "
                ^^ "use=\"required\"/></xs:complexType></xs:element>"
            )
            ++# "<xs:complexType name=\"TAmount\"><xs:simpleContent><xs:extension base=\"xs:decimal\">"
            ++# (
                "<xs:attribute name=\"cur\" type=\"xs:string\"/></xs:extension></xs:simpleContent></xs:complexType>"
                ^^ "</xs:schema>"
            )
        )
    := main, _ = generated_units schema
    ? sm'::contains (field_line "total" "xsd_decimal") main = !- ?> failwith "xs:decimal is carried as xsd_decimal"
    ? sm'::contains (field_line "lines" "xsd_positive_integer") main = !-
    ?> failwith "xs:positiveInteger has its carrier"
    ? sm'::contains (field_line "paid" "option (xsd_boolean)") main = !- ?> failwith "an optional xs:boolean"
    ? sm'::contains (field_line "seq" "xsd_integer") main = !-
    ?> failwith "an xs:int attribute is carried as an integer"
    ? sm'::contains (field_line "base" "xsd_decimal") main = !- ?> failwith "a simpleContent decimal base is carried"
    ? sm'::contains "(xml_codec.read_value xsd_decimal_of_string)" main = !-
    ?> failwith "decimals read through their parser"
    ? sm'::contains "type xsd_decimal = lexical decimal.decimal\n" main = !-
    ?> failwith "the decimal carrier is declared"
    ? sm'::contains "instance to_text lexical t = fun x => x.text\n" main = !- ?> failwith "carriers print their text"
    ? sm'::contains "type xsd_non_negative_integer" main ?> failwith "a carrier the schema never uses is not declared"

///> rust
:# text_only_schemas_declare_no_carrier =
    := main, _ = generated_units (read_schema "<xs:schema><xs:element name=\"Note\" type=\"xs:string\"/></xs:schema>")
    ? sm'::contains "lexical" main
    ?> failwith "a schema without numeric or boolean builtins keeps its text-only prelude"

///> rust
:# a_schema_without_patterns_has_no_certificates_unit =
    := _, unit = generated_units (read_schema "<xs:schema><xs:element name=\"Note\" type=\"xs:string\"/></xs:schema>")
    ?= unit ?|
    | Some _ => failwith "nothing to certify means no certificates unit"
    | None => ()

///> rust
:# a_ref_inside_a_referenced_element_keeps_its_type =
    := schema =
        read_schema (
            "<xs:schema><xs:element name=\"AuditFile\"><xs:complexType><xs:sequence><xs:element ref=\"Header\"/>"
            ++# "</xs:sequence></xs:complexType></xs:element><xs:element name=\"Header\"><xs:complexType><xs:sequence>"
            ++# "<xs:element ref=\"CompanyAddress\"/></xs:sequence></xs:complexType></xs:element>"
            ++# (
                "<xs:element name=\"CompanyAddress\" type=\"AddressStructure\"/><xs:complexType "
                ^^ "name=\"AddressStructure\">"
            )
            ++# (
                "<xs:sequence><xs:element name=\"AddressDetail\" type=\"xs:string\"/></xs:sequence></xs:complexType"
                ^^ "></xs:schema>"
            )
        )
    := text = generate_module (xsd_resolve::finalize_names (xsd_resolve::qualify_schema [] schema))
    ? sm'::contains "company_address : string" text
    ?> failwith "a ref inside an element reached by ref is not flattened to text"
    ? sm'::contains "company_address : x_address_structure" text = !-
    ?> failwith "the nested ref keeps its global element's type"

///> rust
:# a_repeated_inner_sequence_reads_every_group =
    := schema =
        read_schema (
            "<xs:schema><xs:element name=\"ShipTo\"><xs:complexType><xs:sequence>"
            ++# "<xs:element name=\"DeliveryID\" type=\"xs:string\" minOccurs=\"0\"/>"
            ++# "<xs:sequence minOccurs=\"0\" maxOccurs=\"unbounded\">"
            ++# "<xs:element name=\"WarehouseID\" type=\"xs:string\" minOccurs=\"0\"/>"
            ++# "<xs:element name=\"LocationID\" type=\"xs:string\" minOccurs=\"0\"/></xs:sequence>"
            ++# "<xs:element name=\"Address\" type=\"xs:string\" minOccurs=\"0\"/>"
            ++# "</xs:sequence></xs:complexType></xs:element></xs:schema>"
        )
    := text = generate_module (xsd_resolve::finalize_names (xsd_resolve::qualify_schema [] schema))
    := group = type_name "ShipTo_group_WarehouseID"
    ? sm'::contains (": list (" ++# group ++# ")") text = !- ?> failwith "the owner keeps every group in a list"
    ? sm'::contains "xml.group_runs [" text = !- ?> failwith "the reader splits the children into group runs"
    ? sm'::contains ("listm.concat (listm.map " ++# group ++# "_children") text = !-
    ?> failwith "the writer writes every group"

///> rust
:# records_are_distinct_nominals =
    := schema =
        read_schema (
            "<xs:schema><xs:complexType name=\"TFrom\"><xs:sequence><xs:element name=\"City\" type=\"xs:string\"/>"
            ++# "</xs:sequence></xs:complexType><xs:complexType name=\"TTo\"><xs:sequence>"
            ++# "<xs:element name=\"City\" type=\"xs:string\"/></xs:sequence></xs:complexType></xs:schema>"
        )
    := text = generate_module (xsd_resolve::finalize_names (xsd_resolve::qualify_schema [] schema))
    ? sm'::contains ("nominal " ++# type_name "TFrom" ++# " =\n") text = !-
    ?> failwith "a record is a nominal, so two records with the same fields stay distinct types"
    ? sm'::contains ("nominal " ++# type_name "TTo" ++# " =\n") text = !-
    ?> failwith "the second record is its own nominal"
    ? sm'::contains ("type " ++# type_name "TFrom" ++# " =\n") text ?> failwith "no record is a structural alias"

///> rust
:# generated_types_have_codec_instances =
    := schema =
        read_schema (
            "<xs:schema><xs:element name=\"Order\" type=\"TOrder\"/><xs:complexType name=\"TOrder\"><xs:sequence>"
            ++# "<xs:element name=\"City\" type=\"xs:string\"/></xs:sequence></xs:complexType></xs:schema>"
        )
    := text = generate_module (xsd_resolve::finalize_names (xsd_resolve::qualify_schema [] schema))
    := ty = type_name "TOrder"
    ? sm'::contains "open xml_codec\n" text = !- ?> failwith "a generated unit opens the codec prototypes"
    ? sm'::contains ("instance of_xml " ++# ty ++# " = " ++# ty ++# "_of_xml\n") text = !-
    ?> failwith "a record reads through of_xml"
    ? sm'::contains ("instance to_xml " ++# ty ++# " = " ++# ty ++# "_to_xml\n") text = !-
    ?> failwith "a record writes through to_xml"
