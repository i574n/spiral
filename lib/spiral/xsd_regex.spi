///- --package .
:< sm'_operators

:| ^ rx =
    | RxNone
    | RxEps
    | RxClass : bool * list (u32 * u32)
    | RxSeq : rx * rx
    | RxAlt : rx * rx
    | RxStar : rx
    | RxRepeat : rx * i32 * i32

:= cp_at (s : string) (i : i32) : u32 = xml.code_point_at s i

:= cp_width (s : string) (i : i32) : i32 = xml.code_point_width s i

:= rx_tag (r : rx) : i32 =
    ?= r ?|
    | RxNone => 0i32
    | RxEps => 1i32
    | RxClass _ => 2i32
    | RxSeq _ => 3i32
    | RxAlt _ => 4i32
    | RxStar _ => 5i32
    | RxRepeat _ => 6i32

:~ ^ ranges_compare (a : list (u32 * u32)) (b : list (u32 * u32)) : i32 =
    ?= a ?|
    | [] => ?= b ?| [] => 0i32 | _ => -1i32
    | (a_low, a_high) :: a_rest =>
        ?= b ?|
        | [] => 1i32
        | (b_low, b_high) :: b_rest =>
            ? a_low < b_low ?> -1i32
            |? a_low > b_low ?> 1i32
            |? a_high < b_high ?> -1i32
            |? a_high > b_high ?> 1i32
            |: ranges_compare a_rest b_rest

:~ ^ rx_compare (a : rx) (b : rx) : i32 =
    := a_tag = rx_tag a
    := b_tag = rx_tag b
    ? a_tag < b_tag ?> -1i32
    |? a_tag > b_tag ?> 1i32
    |:
        ?= a ?|
        | RxClass (a_negated, a_ranges) =>
            ?= b ?|
            | RxClass (b_negated, b_ranges) =>
                ? a_negated = b_negated ?> ranges_compare a_ranges b_ranges
                |? a_negated ?> 1i32
                |: -1i32
            | _ => 0i32
        | RxSeq (a_head, a_tail) =>
            ?= b ?|
            | RxSeq (b_head, b_tail) =>
                := head_order = rx_compare a_head b_head
                ? head_order <> 0i32 ?> head_order |: rx_compare a_tail b_tail
            | _ => 0i32
        | RxAlt (a_first, a_rest) =>
            ?= b ?|
            | RxAlt (b_first, b_rest) =>
                := first_order = rx_compare a_first b_first
                ? first_order <> 0i32 ?> first_order |: rx_compare a_rest b_rest
            | _ => 0i32
        | RxStar a_inner => ?= b ?| RxStar b_inner => rx_compare a_inner b_inner | _ => 0i32
        | RxRepeat (a_inner, a_low, a_high) =>
            ?= b ?|
            | RxRepeat (b_inner, b_low, b_high) =>
                ? a_low < b_low ?> -1i32
                |? a_low > b_low ?> 1i32
                |? a_high < b_high ?> -1i32
                |? a_high > b_high ?> 1i32
                |: rx_compare a_inner b_inner
            | _ => 0i32
        | _ => 0i32

:= seq (a : rx) (b : rx) : rx =
    ?= a ?|
    | RxNone => RxNone
    | RxEps => b
    | _ =>
        ?= b ?|
        | RxNone => RxNone
        | RxEps => a
        | _ => RxSeq (a, b)

:~ ^ seq_similar (a : rx) (b : rx) : rx =
    ?= a ?|
    | RxSeq (head, tail) => seq_similar head (seq_similar tail b)
    | _ => seq a b

:= alt_written (a : rx) (b : rx) : rx =
    ?= a ?|
    | RxNone => b
    | _ =>
        ?= b ?|
        | RxNone => a
        | _ => RxAlt (a, b)

:~ ^ alt_leaves (r : rx) (leaves : list rx) : list rx =
    ?= r ?|
    | RxAlt (first, rest) => alt_leaves first (alt_leaves rest leaves)
    | RxNone => leaves
    | _ => r :: leaves

:~ ^ insert_leaf (leaf : rx) (sorted : list rx) : list rx =
    ?= sorted ?|
    | head :: rest =>
        := order = rx_compare leaf head
        ? order = 0i32 ?> sorted
        |? order < 0i32 ?> leaf :: sorted
        |: head :: insert_leaf leaf rest
    | [] => [ leaf ]

:~ ^ sort_leaves (leaves : list rx) (sorted : list rx) : list rx =
    ?= leaves ?|
    | leaf :: rest => sort_leaves rest (insert_leaf leaf sorted)
    | [] => sorted

:~ ^ alt_of_sorted (leaves : list rx) : rx =
    ?= leaves ?|
    | leaf :: rest =>
        ?= rest ?|
        | [] => leaf
        | _ => RxAlt (leaf, alt_of_sorted rest)
    | [] => RxNone

:= alt (a : rx) (b : rx) : rx = alt_of_sorted (sort_leaves (alt_leaves a (alt_leaves b [])) [])

:= star (a : rx) : rx =
    ?= a ?|
    | RxNone => RxEps
    | RxEps => RxEps
    | RxStar _ => a
    | _ => RxStar a

:! accepts_empty = ()
:! rejects_empty = ()

:| ^ nullable_evidence answer =
    | EpsAccepts :: nullable_evidence accepts_empty
    | StarAccepts :: nullable_evidence accepts_empty
    | RepeatFromZero :: nullable_evidence accepts_empty
    | RepeatOfNullable :: nullable_evidence accepts_empty -> nullable_evidence accepts_empty
    | SeqAccepts :: nullable_evidence accepts_empty * nullable_evidence accepts_empty -> nullable_evidence accepts_empty
    | AltLeftAccepts :: nullable_evidence accepts_empty -> nullable_evidence accepts_empty
    | AltRightAccepts :: nullable_evidence accepts_empty -> nullable_evidence accepts_empty
    | NoneRejects :: nullable_evidence rejects_empty
    | ClassRejects :: nullable_evidence rejects_empty
    | SeqLeftRejects :: nullable_evidence rejects_empty -> nullable_evidence rejects_empty
    | SeqRightRejects :: nullable_evidence rejects_empty -> nullable_evidence rejects_empty
    | AltRejects :: nullable_evidence rejects_empty * nullable_evidence rejects_empty -> nullable_evidence rejects_empty
    | RepeatRejects :: nullable_evidence rejects_empty -> nullable_evidence rejects_empty

:| ^ nullability =
    | Accepts : nullable_evidence accepts_empty
    | Rejects : nullable_evidence rejects_empty

:~ ^ nullability_of (r : rx) : nullability =
    ?= r ?|
    | RxNone => Rejects NoneRejects
    | RxEps => Accepts EpsAccepts
    | RxClass _ => Rejects ClassRejects
    | RxSeq (a, b) =>
        ?= nullability_of a ?|
        | Rejects left => Rejects (SeqLeftRejects left)
        | Accepts left =>
            ?= nullability_of b ?|
            | Accepts right => Accepts (SeqAccepts (left, right))
            | Rejects right => Rejects (SeqRightRejects right)
    | RxAlt (a, b) =>
        ?= nullability_of a ?|
        | Accepts left => Accepts (AltLeftAccepts left)
        | Rejects left =>
            ?= nullability_of b ?|
            | Accepts right => Accepts (AltRightAccepts right)
            | Rejects right => Rejects (AltRejects (left, right))
    | RxStar _ => Accepts StarAccepts
    | RxRepeat (a, low, _) =>
        ? low <= 0i32 ?> Accepts RepeatFromZero
        |:
            ?= nullability_of a ?|
            | Accepts inner => Accepts (RepeatOfNullable inner)
            | Rejects inner => Rejects (RepeatRejects inner)

:= nullable (r : rx) : bool =
    ?= nullability_of r ?|
    | Accepts _ => !+
    | Rejects _ => !-

:~ ^ accept_reason (evidence : nullable_evidence accepts_empty) : string =
    ?= evidence ?|
    | EpsAccepts => "eps"
    | StarAccepts => "star"
    | RepeatFromZero => "repeat-from-zero"
    | RepeatOfNullable inner => "repeat(" ++# accept_reason inner ++# ")"
    | SeqAccepts (left, right) => "seq(" ++# accept_reason left ++# ", " ++# accept_reason right ++# ")"
    | AltLeftAccepts inner => "left(" ++# accept_reason inner ++# ")"
    | AltRightAccepts inner => "right(" ++# accept_reason inner ++# ")"

:~ ^ reject_reason (evidence : nullable_evidence rejects_empty) : string =
    ?= evidence ?|
    | NoneRejects => "none"
    | ClassRejects => "class"
    | SeqLeftRejects inner => "seq-left(" ++# reject_reason inner ++# ")"
    | SeqRightRejects inner => "seq-right(" ++# reject_reason inner ++# ")"
    | AltRejects (left, right) => "alt(" ++# reject_reason left ++# ", " ++# reject_reason right ++# ")"
    | RepeatRejects inner => "repeat(" ++# reject_reason inner ++# ")"

:= nullability_text (r : rx) : string =
    ?= nullability_of r ?|
    | Accepts evidence => "accepts " ++# accept_reason evidence
    | Rejects evidence => "rejects " ++# reject_reason evidence

:= counted (atom : rx) (low : i32) (high : i32) : rx =
    := low = ? low < 0i32 ?> 0i32 |: low
    ? high <= 0i32 ?> RxEps
    |? low = 1i32 && high = 1i32 ?> atom
    |:
        ?= atom ?|
        | RxNone => ? low = 0i32 ?> RxEps |: RxNone
        | RxEps => RxEps
        | _ => RxRepeat (atom, low, high)

:~ ^ in_ranges (c : u32) (ranges : list (u32 * u32)) : bool =
    ?= ranges ?|
    | (low, high) :: rest => (low <= c && c <= high) || in_ranges c rest
    | [] => !-

:! as_written = ()
:! similar = ()

:| ^ derivative_form f =
    | AsWritten :: derivative_form as_written
    | Similar :: derivative_form similar

:= alt_by \* f. (form : derivative_form f) (a : rx) (b : rx) : rx =
    ?= form ?|
    | AsWritten => alt_written a b
    | Similar => alt a b

:= seq_by \* f. (form : derivative_form f) (a : rx) (b : rx) : rx =
    ?= form ?|
    | AsWritten => seq a b
    | Similar => seq_similar a b

:~ ^ derive_by \* f. (form : derivative_form f) (c : u32) (r : rx) : rx =
    ?= r ?|
    | RxNone => RxNone
    | RxEps => RxNone
    | RxClass (negated, ranges) => ? in_ranges c ranges <> negated ?> RxEps |: RxNone
    | RxSeq (a, b) =>
        := first = seq_by form (derive_by form c a) b
        ? nullable a ?> alt_by form first (derive_by form c b) |: first
    | RxAlt (a, b) => alt_by form (derive_by form c a) (derive_by form c b)
    | RxStar a => seq_by form (derive_by form c a) r
    | RxRepeat (a, low, high) => seq_by form (derive_by form c a) (counted a (low - 1i32) (high - 1i32))

:= derive (c : u32) (r : rx) : rx = derive_by AsWritten c r

:= derive_similar (c : u32) (r : rx) : rx = derive_by Similar c r

:= single (c : u32) : rx = RxClass (!-, [ (c, c) ])

:= escape_ranges (c : u32) : list (u32 * u32) =
    ? c = 100u32 ?> [ (48u32, 57u32) ]
    |? c = 115u32 ?> [ (32u32, 32u32); (9u32, 10u32); (13u32, 13u32) ]
    |? c = 119u32 ?> [ (48u32, 57u32); (65u32, 90u32); (97u32, 122u32); (95u32, 95u32) ]
    |? c = 110u32 ?> [ (10u32, 10u32) ]
    |? c = 114u32 ?> [ (13u32, 13u32) ]
    |? c = 116u32 ?> [ (9u32, 9u32) ]
    |: [ (c, c) ]

:= last_code_point () : u32 = 1114111u32

:= is_negated_escape (c : u32) : bool = c = 83u32 || c = 68u32 || c = 87u32

:= is_name_escape (c : u32) : bool = c = 105u32 || c = 99u32 || c = 73u32 || c = 67u32

:~ ^ insert_range (r : u32 * u32) (sorted : list (u32 * u32)) : list (u32 * u32) =
    ?= sorted ?|
    | head :: rest =>
        := low, _ = r
        := head_low, _ = head
        ? low <= head_low ?> r :: sorted |: head :: insert_range r rest
    | [] => r :: []

:~ ^ gaps_from (sorted : list (u32 * u32)) (next : u32) (acc : list (u32 * u32)) : list (u32 * u32) =
    ?= sorted ?|
    | (low, high) :: rest =>
        := acc = ? low > next ?> (next, low - 1u32) :: acc |: acc
        gaps_from rest (? high + 1u32 > next ?> high + 1u32 |: next) acc
    | [] => ? next <= last_code_point () ?> (next, last_code_point ()) :: acc |: acc

:= complement_ranges (ranges : list (u32 * u32)) : list (u32 * u32) =
    gaps_from (listm.fold (\ sorted r => insert_range r sorted) [] ranges) 0u32 []

:= escape_class (c : u32) : list (u32 * u32) =
    ? is_negated_escape c ?> complement_ranges (escape_ranges (c + 32u32)) |: escape_ranges c
:= block_range (name : string) : option (u32 * u32) =
    ? name = "IsBasicLatin" ?> Some (0u32, 127u32)
    |? name = "IsLatin-1Supplement" ?> Some (128u32, 255u32)
    |? name = "IsLatinExtended-A" ?> Some (256u32, 383u32)
    |? name = "IsLatinExtended-B" ?> Some (384u32, 591u32)
    |: None

:= outside_range (low : u32) (high : u32) : list (u32 * u32) =
    := above = ? high < last_code_point () ?> [ (high + 1u32, last_code_point ()) ] |: []
    ? low > 0u32 ?> (0u32, low - 1u32) :: above |: above

:= unparsable (p : string) : i32 = sm'.length p + 1i32

:= property_at (p : string) (i : i32) : option (list (u32 * u32) * i32) =
    := kind = cp_at p (i + 1i32)
    ? (kind = 112u32 || kind = 80u32) && cp_at p (i + 2i32) = 123u32 ?>
        := close = xml.find_from "}" p (i + 3i32)
        := block = ? close < 0i32 ?> None |: block_range (sm'.substring (i + 3i32) (close - i - 3i32) p)
        ?= block ?|
        | Some (low, high) => Some ((? kind = 80u32 ?> outside_range low high |: [ (low, high) ]), close + 1i32)
        | None => Some ([], unparsable p)
    |: None

:~ ^ read_number (p : string) (i : i32) (acc : i32) : i32 * i32 =
    := c = cp_at p i
    ? i < sm'.length p && 48u32 <= c && c <= 57u32
    ?> read_number p (i + 1i32) (acc * 10i32 + (conv (c - 48u32) : i32))
    |: acc, i

:~ ^ class_items (p : string) (i : i32) (acc : list (u32 * u32)) : list (u32 * u32) * i32 =
    ? i >= sm'.length p || cp_at p i = 93u32 ?> acc, i + 1i32
    |:
        := c = cp_at p i
        ? c = 92u32 ?>
            ?= property_at p i ?|
            | Some (ranges, next) => class_items p next (listm.append ranges acc)
            | None =>
                := e = cp_at p (i + 1i32)
                class_items p (i + 1i32 + cp_width p (i + 1i32)) (listm.append (escape_class e) acc)
        |:
            := next = i + cp_width p i
            ? cp_at p next = 45u32 && cp_at p (next + 1i32) <> 93u32 && next + 1i32 < sm'.length p ?>
                := high = cp_at p (next + 1i32)
                class_items p (next + 1i32 + cp_width p (next + 1i32)) ((c, high) :: acc)
            |: class_items p next ((c, c) :: acc)

:~ ^ parse_alt (p : string) (i : i32) : rx * i32 =
    := left, after_left = parse_seq p i RxEps
    ? after_left < sm'.length p && cp_at p after_left = 124u32 ?>
        := right, after_right = parse_alt p (after_left + 1i32)
        alt_written left right, after_right
    |: left, after_left

:& :~ parse_seq (p : string) (i : i32) (acc : rx) : rx * i32 =
    ? i >= sm'.length p || cp_at p i = 124u32 || cp_at p i = 41u32 ?> acc, i
    |:
        := atom, after_atom = parse_atom p i
        := quantified, after_quant = parse_quant p after_atom atom
        parse_seq p after_quant (seq acc quantified)

:& :~ parse_atom (p : string) (i : i32) : rx * i32 =
    := c = cp_at p i
    ? c = 40u32 ?>
        := inner, after_inner = parse_alt p (i + 1i32)
        inner, after_inner + 1i32
    |? c = 91u32 ?>
        ? cp_at p (i + 1i32) = 94u32 ?>
            := ranges, after = class_items p (i + 2i32) []
            RxClass (!+, ranges), after
        |:
            := ranges, after = class_items p (i + 1i32) []
            RxClass (!-, ranges), after
    |? c = 46u32 ?> RxClass (!+, [ (10u32, 10u32); (13u32, 13u32) ]), i + 1i32
    |? c = 92u32 ?>
        ?= property_at p i ?|
        | Some (ranges, next) => RxClass (!-, ranges), next
        | None =>
            := e = cp_at p (i + 1i32)
            := negated = is_negated_escape e
            RxClass (negated, escape_ranges (? negated ?> e + 32u32 |: e)), i + 1i32 + cp_width p (i + 1i32)
    |: single c, i + cp_width p i

:& :~ parse_quant (p : string) (i : i32) (atom : rx) : rx * i32 =
    ? i >= sm'.length p ?> atom, i
    |:
        := c = cp_at p i
        ? c = 63u32 ?> alt_written RxEps atom, i + 1i32
        |? c = 42u32 ?> star atom, i + 1i32
        |? c = 43u32 ?> seq atom (star atom), i + 1i32
        |? c = 123u32 ?>
            := n, after_n = read_number p (i + 1i32) 0i32
            ? cp_at p after_n = 125u32 ?> counted atom n n, after_n + 1i32
            |:
                := after_comma = after_n + 1i32
                ? cp_at p after_comma = 125u32 ?> seq (counted atom n n) (star atom), after_comma + 1i32
                |:
                    := m, after_m = read_number p after_comma 0i32
                    counted atom n m, after_m + 1i32
        |: atom, i

:~ ^ first_outside (ranges : list (u32 * u32)) (candidates : list u32) : u32 =
    ?= candidates ?|
    | c :: rest => ? in_ranges c ranges ?> first_outside ranges rest |: c
    | [] => 126u32

:~ ^ repeated (text : string) (count : i32) : string =
    ? count <= 0i32 ?> "" |: text ++# repeated text (count - 1i32)

:~ ^ first_inside (ranges : list (u32 * u32)) (candidates : list u32) : option u32 =
    ?= candidates ?|
    | c :: rest => ? in_ranges c ranges ?> Some c |: first_inside ranges rest
    | [] => None

:= class_example (negated : bool) (ranges : list (u32 * u32)) : string =
    ? negated ?> xml.code_point_string (first_outside ranges [ 65u32; 97u32; 49u32; 90u32; 122u32 ])
    |:
        ?= ranges ?|
        | (low, _) :: _ =>
            ? low >= 33u32 ?> xml.code_point_string low
            |:
                ?= first_inside ranges [ 65u32; 97u32; 49u32 ] ?|
                | Some c => xml.code_point_string c
                | None => xml.code_point_string low
        | [] => ""

:~ ^ example_with (stars : i32) (r : rx) : string =
    ?= r ?|
    | RxNone => ""
    | RxEps => ""
    | RxClass (negated, ranges) => class_example negated ranges
    | RxSeq (a, b) => example_with stars a ++# example_with stars b
    | RxAlt (a, _) => example_with stars a
    | RxStar a => repeated (example_with stars a) stars
    | RxRepeat (a, low, _) => repeated (example_with stars a) low

:~ ^ brace_end (p : string) (i : i32) : i32 =
    ? i >= sm'.length p ?> i
    |? cp_at p i = 125u32 ?> i + 1i32
    |: brace_end p (i + 1i32)

:= escape_end (p : string) (i : i32) : i32 =
    := letter = i + 1i32
    ? letter >= sm'.length p ?> letter
    |:
        := after = letter + cp_width p letter
        := c = cp_at p letter
        := braced = after < sm'.length p && cp_at p after = 123u32
        ? (c = 112u32 || c = 80u32) && braced ?> brace_end p after |: after

:~ ^ class_end (p : string) (i : i32) (depth : i32) : i32 =
    ? i >= sm'.length p ?> i
    |:
        := c = cp_at p i
        ? c = 92u32 ?> class_end p (escape_end p i) depth
        |? c = 91u32 ?> class_end p (i + cp_width p i) (depth + 1i32)
        |? c = 93u32 ?> (? depth = 0i32 ?> i + 1i32 |: class_end p (i + 1i32) (depth - 1i32))
        |: class_end p (i + cp_width p i) depth

:~ ^ invalid_from (p : string) (i : i32) (atom : bool) (quant : bool) : bool =
    ? i >= sm'.length p ?> !-
    |:
        := c = cp_at p i
        ? c = 92u32 ?> (? is_name_escape (cp_at p (i + 1i32)) ?> !+ |: invalid_from p (escape_end p i) !+ !-)
        |? c = 91u32 ?> invalid_from p (class_end p (i + 1i32) 0i32) !+ !-
        |? c = 40u32 || c = 124u32 ?> invalid_from p (i + 1i32) !- !-
        |? c = 63u32 || c = 42u32 || c = 43u32 || c = 123u32 ?>
            ? atom = !- || quant ?> !+
            |: invalid_from p (? c = 123u32 ?> brace_end p i |: i + 1i32) !- !+
        |: invalid_from p (i + cp_width p i) !+ !-

:= is_xsd_pattern (p : string) : bool = invalid_from p 0i32 !- !- = !-
:= compile_pattern (p : string) : option rx =
    ? is_xsd_pattern p = !- ?> None
    |:
        := r, stop = parse_alt p 0i32
        ? stop = sm'.length p ?> Some r |: None

:~ ^ matches_from (r : rx) (s : string) (i : i32) : bool =
    ? i >= sm'.length s ?> nullable r
    |:
        ?= r ?|
        | RxNone => !-
        | _ => matches_from (derive (cp_at s i) r) s (i + cp_width s i)

:= pattern_matches (p : string) (s : string) : bool =
    ?= compile_pattern p ?|
    | Some r => matches_from r s 0i32
    | None => !-

:~ ^ longest_from (r : rx) (s : string) (i : i32) (last : i32) : i32 =
    := last = ? nullable r ?> i |: last
    ? i >= sm'.length s ?> last
    |:
        ?= derive (cp_at s i) r ?|
        | RxNone => last
        | next => longest_from next s (i + cp_width s i) last

:= longest_match (r : rx) (s : string) (i : i32) : i32 = longest_from r s i (0i32 - 1i32)
///> rust
test patterns_match_like_xsd =
    ? pattern_matches "[0-9]{8}" "12345678" = !- ?> failwith "eight digits"
    ? pattern_matches "[0-9]{8}" "1234567" ?> failwith "seven digits rejected"
    ? pattern_matches "1\\.04" "1.04" = !- ?> failwith "escaped dot"
    ? pattern_matches "1\\.04" "1x04" ?> failwith "escaped dot is literal"
    ? pattern_matches "[1-9]{1}[0-9]{0,10}" "123" = !- ?> failwith "bounded repeat"
    ? pattern_matches "[1-9]{1}[0-9]{0,10}" "0123" ?> failwith "leading zero rejected"
    ? pattern_matches "[^@]+@[^\\.]+\\..+" "a@b.c" = !- ?> failwith "negated classes"
    ? pattern_matches "[^@]+@[^\\.]+\\..+" "ab.c" ?> failwith "missing at rejected"
    ? pattern_matches "[!-ÿ]{1}[ -ÿ]{0,}[!-ÿ]{1}|[!-ÿ]{1}" "Ação Ltda" = !- ?> failwith "latin-1 text"
    ? pattern_matches "[!-ÿ]{1}[ -ÿ]{0,}[!-ÿ]{1}|[!-ÿ]{1}" " leading" ?> failwith "leading space rejected"
    ? is_xsd_pattern "(?!0+$)([0-9]{1,2})" ?> failwith "lookaround is not XSD"
    ? is_xsd_pattern "a*?" || is_xsd_pattern "a|*b" || is_xsd_pattern "\\p{L}{2}{3}"
    ?> failwith "stacked or atomless quantifiers"
    ? is_xsd_pattern "(\\p{IsBasicLatin}{1,60})" = !- ?> failwith "a block escape keeps its braces"
    ? is_xsd_pattern "[a-z-[aeiou]]+" = !- || is_xsd_pattern "[?*]+" = !-
    ?> failwith "classes hold quantifier characters"
    ? pattern_matches "(?!0+$)([0-9]{1,2})" "?!00$0" ?> failwith "an invalid pattern matches nothing, not its own text"
    ? pattern_matches "\\S+" "ab" = !- || pattern_matches "\\S+" "a b" ?> failwith "\\S is every code point but space"
    ? pattern_matches "[\\D]" "x" = !- || pattern_matches "[\\D]" "5" ?> failwith "a negated escape inside a class"
    ? pattern_matches "\\W" "!" = !- || pattern_matches "\\W" "a" ?> failwith "\\W excludes word characters"
    ? is_xsd_pattern "\\i\\c*" ?> failwith "name escapes are refused until supported"
///> rust
test block_escapes_read_code_point_ranges =
    := latin = "[\\p{IsBasicLatin}\\p{IsLatin-1Supplement}]{1,60}"
    ? pattern_matches latin "Mario Rossi S.p.A. 12" = !- ?> failwith "basic latin letters, digits, dots and spaces"
    ? pattern_matches latin "Società à r.l." = !- ?> failwith "latin-1 supplement letters"
    ? pattern_matches latin "Łódź" ?> failwith "latin extended-a is outside both blocks"
    ? pattern_matches "(\\p{IsBasicLatin}{1,10})" "ABC-123" = !- ?> failwith "a block outside a class"
    ? pattern_matches "(\\p{IsBasicLatin}{1,10})" "ABC-1234567" ?> failwith "the count still bounds a block"
    ? pattern_matches "\\P{IsBasicLatin}" "à" = !- ?> failwith "a negated block"
    ? pattern_matches "\\P{IsBasicLatin}" "a" ?> failwith "a negated block rejects its own range"
    ?= compile_pattern "\\p{IsKlingon}" ?| Some _ => failwith "an unknown block does not compile" | None => ()

:~ ^ insert_point (point : u32) (sorted : list u32) : list u32 =
    ?= sorted ?|
    | head :: rest =>
        ? point = head ?> sorted
        |? point < head ?> point :: sorted
        |: head :: insert_point point rest
    | [] => [ point ]

:~ ^ range_points (ranges : list (u32 * u32)) (points : list u32) : list u32 =
    ?= ranges ?|
    | (low, high) :: rest =>
        := points = insert_point low points
        range_points rest (? high < last_code_point () ?> insert_point (high + 1u32) points |: points)
    | [] => points

:~ ^ interval_starts (r : rx) (points : list u32) : list u32 =
    ?= r ?|
    | RxClass (_, ranges) => range_points ranges points
    | RxSeq (a, b) => interval_starts a (interval_starts b points)
    | RxAlt (a, b) => interval_starts a (interval_starts b points)
    | RxStar a => interval_starts a points
    | RxRepeat (a, _, _) => interval_starts a points
    | RxNone => points
    | RxEps => points

:== dfa_move = { low : u32; high : u32; target : i32 }

:== dfa_state = { accepting : bool; moves : list dfa_move }

:~ ^ state_index (r : rx) (states : list rx) (index : i32) : i32 =
    ?= states ?|
    | head :: rest => ? rx_compare r head = 0i32 ?> index |: state_index r rest (index + 1i32)
    | [] => -1i32

:~ ^ with_state (r : rx) (states : list rx) : list rx =
    ?= states ?|
    | head :: rest => head :: with_state r rest
    | [] => [ r ]

:~ ^ state_rx (states : list rx) (index : i32) : rx =
    ?= states ?|
    | head :: rest => ? index = 0i32 ?> head |: state_rx rest (index - 1i32)
    | [] => RxNone

:~ ^ add_move (move : dfa_move) (moves : list dfa_move) : list dfa_move =
    ?= moves ?|
    | last :: rest =>
        ? last.target = move.target && last.high + 1u32 = move.low ?> { last ?| high = move.high } :: rest
        |: move :: moves
    | [] => [ move ]

:~ ^ reverse_moves (moves : list dfa_move) (reversed : list dfa_move) : list dfa_move =
    ?= moves ?|
    | move :: rest => reverse_moves rest (move :: reversed)
    | [] => reversed

:~ ^ state_moves
    (r : rx) (starts : list u32) (states : list rx) (count : i32) (moves : list dfa_move)
    : list rx * i32 * list dfa_move
    =
    ?= starts ?|
    | low :: rest =>
        := high = ?= rest ?| (next :: _) => next - 1u32 | [] => last_code_point ()
        := next_rx = derive_similar low r
        ?= next_rx ?|
        | RxNone => state_moves r rest states count moves
        | _ =>
            := known = state_index next_rx states 0i32
            ? known >= 0i32
            ?> state_moves r rest states count (add_move { low = low; high = high; target = known } moves)
            |:
                state_moves r rest
                    (with_state next_rx states)
                    (count + 1i32)
                    (add_move { low = low; high = high; target = count } moves)
    | [] => states, count, reverse_moves moves []

:~ ^ reverse_states (rows : list dfa_state) (reversed : list dfa_state) : list dfa_state =
    ?= rows ?|
    | row :: rest => reverse_states rest (row :: reversed)
    | [] => reversed

:~ ^ build_states
    (index : i32) (states : list rx) (count : i32) (limit : i32) (rows : list dfa_state)
    : option (list dfa_state)
    =
    ? index >= count ?> Some (reverse_states rows [])
    |? count > limit ?> None
    |:
        := r = state_rx states index
        := states, count, moves = state_moves r (interval_starts r [ 0u32 ]) states count []
        build_states (index + 1i32) states count limit ({ accepting = nullable r; moves = moves } :: rows)

:= dfa_state_limit () : i32 = 4096i32

:= dfa_of_pattern_within (limit : i32) (p : string) : option (list dfa_state) =
    ?= compile_pattern p ?|
    | Some r => build_states 0i32 [ r ] 1i32 limit []
    | None => None

:= dfa_of_pattern (p : string) : option (list dfa_state) = dfa_of_pattern_within (dfa_state_limit ()) p

:~ ^ move_target (c : u32) (moves : list dfa_move) : i32 =
    ?= moves ?|
    | move :: rest => ? c < move.low ?> -1i32 |? c <= move.high ?> move.target |: move_target c rest
    | [] => -1i32

:~ ^ dfa_row (rows : list dfa_state) (index : i32) : dfa_state =
    ?= rows ?|
    | row :: rest => ? index = 0i32 ?> row |: dfa_row rest (index - 1i32)
    | [] => { accepting = !-; moves = [] }

:~ ^ dfa_run (rows : list dfa_state) (state : i32) (s : string) (i : i32) : bool =
    ? state < 0i32 ?> !-
    |:
        := row = dfa_row rows state
        ? i >= sm'.length s ?> row.accepting
        |: dfa_run rows (move_target (cp_at s i) row.moves) s (i + cp_width s i)

:= dfa_matches (rows : list dfa_state) (s : string) : bool = dfa_run rows 0i32 s 0i32

///> rust
test dfa_keeps_xsd_semantics =
    ?= dfa_of_pattern "[0-9]{2,4}|[A-Z]+" ?|
    | Some rows =>
        ? dfa_matches rows "12" = !- ?> failwith "two digits"
        ? dfa_matches rows "1234" = !- ?> failwith "four digits"
        ? dfa_matches rows "12345" ?> failwith "five digits rejected"
        ? dfa_matches rows "ABC" = !- ?> failwith "letters"
        ? dfa_matches rows "" ?> failwith "empty rejected"
        ? dfa_matches rows "A1" ?> failwith "mixed rejected"
    | None => failwith "small pattern builds a DFA"

:~ ^ states_in (rows : list dfa_state) (count : i32) : i32 =
    ?= rows ?|
    | _ :: rest => states_in rest (count + 1i32)
    | [] => count

///> rust
test bounded_repeats_build_one_state_per_count =
    ?= dfa_of_pattern "[\\p{IsBasicLatin}\\p{IsLatin-1Supplement}]{1,1000}" ?|
    | Some rows =>
        ? states_in rows 0i32 <> 1001i32 ?> failwith "one state per remaining count"
        ? dfa_matches rows (repeated "é" 1000i32) = !- ?> failwith "a thousand latin-1 letters"
        ? dfa_matches rows (repeated "a" 1001i32) ?> failwith "a thousand and one rejected"
        ? dfa_matches rows "" ?> failwith "empty rejected"
    | None => failwith "a counted repeat stays within the state limit"

:~ ^ count_compiled (text : string) (pos : i32) (acc : i32 * i32) : i32 * i32 =
    ? pos >= sm'.length text ?> acc
    |:
        := stop = xml.find_from "\n" text pos
        := stop = ? stop < 0i32 ?> sm'.length text |: stop
        := line = sm'.substring pos (stop - pos) text |> sm'.trim
        := ok, failed = acc
        := acc =
            ? line = "" ?> acc
            |:
                ?= compile_pattern line ?|
                | Some _ => ok + 1i32, failed
                | None => ok, failed + 1i32
        count_compiled text (stop + 1i32) acc

:~ ^ lines_of (text : string) (pos : i32) (acc : list string) : list string =
    ? pos >= sm'.length text ?> listm.rev acc
    |:
        := stop = xml.find_from "\n" text pos
        := stop = ? stop < 0i32 ?> sm'.length text |: stop
        lines_of text (stop + 1i32) (sm'.substring pos (stop - pos) text :: acc)

:== disagreement = { count : i32; first : string }

:~ ^ row_disagreements
    (pattern : string) (matches : string -> bool) (probes : list string) (row : string) (j : i32) (acc : disagreement)
    : disagreement
    =
    ?= probes ?|
    | probe :: rest =>
        := expected = sm'.substring j 1i32 row = "1"
        := actual = matches probe
        := acc =
            ? expected = actual ?> acc
            |:
                {
                    count = acc.count + 1i32
                    first = ? acc.first = "" ?> pattern ++# " on [" ++# probe ++# "]" |: acc.first
                }
        row_disagreements pattern matches rest row (j + 1i32) acc
    | [] => acc

:= failed_pattern (reason : string) (pattern : string) (acc : disagreement) : disagreement =
    { count = acc.count + 1000000i32; first = ? acc.first = "" ?> reason ++# pattern |: acc.first }

:= derivative_disagreements
    (pattern : string) (row : string) (probes : list string) (acc : disagreement)
    : disagreement
    =
    ?= compile_pattern pattern ?|
    | Some r => row_disagreements pattern (\ probe => matches_from r probe 0i32) probes row 0i32 acc
    | None => failed_pattern "does not compile: " pattern acc

:= dfa_disagreements (pattern : string) (row : string) (probes : list string) (acc : disagreement) : disagreement =
    ?= dfa_of_pattern pattern ?|
    | Some rows => row_disagreements pattern (dfa_matches rows) probes row 0i32 acc
    | None => failed_pattern "no DFA within the state limit: " pattern acc

:~ ^ all_disagreements
    (check : string -> string -> list string -> disagreement -> disagreement) (patterns : list string)
    (rows : list string) (probes : list string) (acc : disagreement)
    : disagreement
    =
    ?= patterns ?|
    | pattern :: rest =>
        ?= rows ?|
        | row :: more_rows => all_disagreements check rest more_rows probes (check pattern row probes acc)
        | [] => { acc ?| count = acc.count + 1000000i32 }
    | [] => acc

:= digit_text (d : i32) : string = sm'.substring d 1i32 "0123456789"

:~ ^ count_text (n : i32) (acc : string) : string =
    ? n < 10i32 ?> digit_text n ++# acc |: count_text (n / 10i32) (digit_text (n % 10i32) ++# acc)

:== state_census =
    {
        patterns : i32
        without_dfa : i32
        states : i32
        largest : i32
        largest_pattern : string
        lines : string
    }

:~ ^ census_of (patterns : list string) (acc : state_census) : state_census =
    ?= patterns ?|
    | pattern :: rest =>
        ? pattern = "" ?> census_of rest acc
        |:
            := states = ?= dfa_of_pattern pattern ?| Some rows => states_in rows 0i32 | None => 0i32
            := larger = states > acc.largest
            := line = count_text states "" ++# "\t" ++# pattern ++# "\n"
            := acc =
                { acc ?|
                    patterns = (acc.patterns + 1i32)
                    states = (acc.states + states)
                    lines = (acc.lines ++# line)
                }
            := acc = ? states = 0i32 ?> { acc ?| without_dfa = acc.without_dfa + 1i32 } |: acc
            census_of rest (? larger ?> { acc ?| largest = states; largest_pattern = pattern } |: acc)
    | [] => acc

:~ ^ first_points (values : list string) (points : list u32) : list u32 =
    ?= values ?|
    | value :: rest =>
        first_points rest (? sm'.length value = 0i32 ?> points |: insert_point (cp_at value 0i32) points)
    | [] => points

:~ ^ tails_after (point : u32) (values : list string) (acc : list string) : list string =
    ?= values ?|
    | value :: rest =>
        ? sm'.length value > 0i32 && cp_at value 0i32 = point ?>
            := width = cp_width value 0i32
            tails_after point rest (sm'.substring width (sm'.length value - width) value :: acc)
        |: tails_after point rest acc
    | [] => acc

:~ ^ has_empty (values : list string) : bool =
    ?= values ?|
    | value :: rest => sm'.length value = 0i32 || has_empty rest
    | [] => !-

:~ ^ moves_equal (a : list dfa_move) (b : list dfa_move) : bool =
    ?= a ?|
    | x :: a_rest =>
        ?= b ?|
        | y :: b_rest => x.low = y.low && x.high = y.high && x.target = y.target && moves_equal a_rest b_rest
        | [] => !-
    | [] => ?= b ?| [] => !+ | _ => !-

:~ ^ registered (row : dfa_state) (register : list (dfa_state * i32)) : i32 =
    ?= register ?|
    | (known, id) :: rest =>
        ? known.accepting = row.accepting && moves_equal known.moves row.moves ?> id |: registered row rest
    | [] => -1i32

:== value_dfa = { register : list (dfa_state * i32); rows : list dfa_state; count : i32 }

:~ ^ value_state (values : list string) (built : value_dfa) : i32 * value_dfa =
    value_moves (first_points values []) values [] (has_empty values) built
:& :~ value_moves
    (points : list u32) (values : list string) (moves : list dfa_move) (accepting : bool) (built : value_dfa)
    : i32 * value_dfa
    =
    ?= points ?|
    | point :: rest =>
        := target, built = value_state (tails_after point values []) built
        value_moves rest values (add_move { low = point; high = point; target = target } moves) accepting built
    | [] =>
        := row = { accepting = accepting; moves = reverse_moves moves [] }
        := known = registered row built.register
        ? known >= 0i32 ?> known, built
        |:
            built.count,
            {
                register = (row, built.count) :: built.register
                rows = row :: built.rows
                count = built.count + 1i32
            }

:~ ^ renumbered_moves (last : i32) (moves : list dfa_move) (acc : list dfa_move) : list dfa_move =
    ?= moves ?|
    | move :: rest => renumbered_moves last rest ({ move ?| target = last - move.target } :: acc)
    | [] => reverse_moves acc []

:~ ^ renumbered_rows (last : i32) (rows : list dfa_state) (acc : list dfa_state) : list dfa_state =
    ?= rows ?|
    | row :: rest =>
        renumbered_rows last rest ({ row ?| moves = renumbered_moves last row.moves [] } :: acc)
    | [] => reverse_states acc []

:= dfa_of_values (values : list string) : list dfa_state =
    := _, built = value_state values { register = []; rows = []; count = 0i32 }
    renumbered_rows (built.count - 1i32) built.rows []

///> rust
test value_sets_become_minimal_dfas =
    := rows = dfa_of_values ("01001" :: "01002" :: "02001" :: "02002" :: "A" :: [])
    ? states_in rows 0i32 <> 6i32 ?> failwith "shared suffixes merge into six states"
    ? dfa_matches rows "02002" = !- ?> failwith "listed code"
    ? dfa_matches rows "A" = !- ?> failwith "short code"
    ? dfa_matches rows "01003" ?> failwith "unlisted code rejected"
    ? dfa_matches rows "0100" ?> failwith "prefix rejected"
    ? dfa_matches rows "" ?> failwith "empty rejected"

:~ ^ zeros (count : i32) (acc : string) : string = ? count <= 0i32 ?> acc |: zeros (count - 1i32) ("0" ++# acc)

:= padded (n : i32) (width : i32) : string =
    := text = count_text n ""
    zeros (width - sm'.length text) "" ++# text

:= move_prefix (move : dfa_move) : string =
    " " ++# count_text (conv move.low : i32) "" ++# "-" ++# count_text (conv move.high : i32) "" ++# ">"

:~ ^ row_length (moves : list dfa_move) (width : i32) (acc : i32) : i32 =
    ?= moves ?|
    | move :: rest => row_length rest width (acc + sm'.length (move_prefix move) + width)
    | [] => acc + 2i32

:~ ^ row_offsets (rows : list dfa_state) (width : i32) (offset : i32) (acc : list i32) : list i32 * i32 =
    ?= rows ?|
    | row :: rest => row_offsets rest width (offset + row_length row.moves width 0i32) (offset :: acc)
    | [] => listm.rev acc, offset

:~ ^ fitting_width (rows : list dfa_state) (width : i32) (limit : i32) : i32 * list i32 =
    := offsets, total = row_offsets rows width 0i32 []
    ? total < limit || width >= 9i32 ?> width, offsets |: fitting_width rows (width + 1i32) (limit * 10i32)

:~ ^ offset_at (offsets : list i32) (index : i32) : i32 =
    ?= offsets ?|
    | offset :: rest => ? index = 0i32 ?> offset |: offset_at rest (index - 1i32)
    | [] => -1i32

:~ ^ offset_moves (moves : list dfa_move) (offsets : list i32) (width : i32) (acc : string) : string =
    ?= moves ?|
    | move :: rest =>
        offset_moves rest offsets width (acc ++# move_prefix move ++# padded (offset_at offsets move.target) width)
    | [] => acc

:~ ^ offset_lines (rows : list dfa_state) (offsets : list i32) (width : i32) (acc : string) : string =
    ?= rows ?|
    | row :: rest =>
        offset_lines rest offsets width (
            acc ++# (? row.accepting ?> "1" |: "0") ++# offset_moves row.moves offsets width "" ++# "\n"
        )
    | [] => acc

:= dfa_table_text (rows : list dfa_state) : string =
    := width, offsets = fitting_width rows 1i32 10i32
    offset_lines rows offsets width ""

:~ ^ table_step (table : string) (c : u32) (i : i32) : i32 =
    ? i >= sm'.length table || cp_at table i <> 32u32 ?> -1i32
    |:
        := low, i = read_number table (i + 1i32) 0i32
        := high, i = read_number table (i + 1i32) 0i32
        := target, i = read_number table (i + 1i32) 0i32
        ? c < (conv low : u32) ?> -1i32 |? c <= (conv high : u32) ?> target |: table_step table c i

:~ ^ table_run (table : string) (line : i32) (s : string) (i : i32) : bool =
    ? i >= sm'.length s ?> cp_at table line = 49u32
    |:
        := next = table_step table (cp_at s i) (line + 1i32)
        ? next < 0i32 ?> !- |: table_run table next s (i + cp_width s i)

:= table_matches (table : string) (s : string) : bool = table_run table 0i32 s 0i32

///> rust
test dfa_tables_match_in_place =
    := rows = dfa_of_values ("01001" :: "01002" :: "02001" :: "A" :: [])
    := table = dfa_table_text rows
    ? table_matches table "02001" = !- ?> failwith "listed code"
    ? table_matches table "A" = !- ?> failwith "short code"
    ? table_matches table "02002" ?> failwith "unlisted code rejected"
    ? table_matches table "0200" ?> failwith "prefix rejected"
    ? table_matches table "A0" ?> failwith "longer code rejected"
    ? table_matches table "" ?> failwith "empty rejected"

///> rust
test nullability_carries_its_evidence =
    ?
        nullability_text (RxSeq (RxStar RxEps, RxRepeat (single 97u32, 0i32, 3i32)))
        <> "accepts seq(star, repeat-from-zero)"
    ?> failwith "both halves accept the empty word, each with its own reason"
    ? nullability_text (RxAlt (single 97u32, RxSeq (RxEps, RxNone))) <> "rejects alt(class, seq-right(none))"
    ?> failwith "an alternative rejects only when both sides reject"
    ? nullable (RxAlt (single 97u32, RxEps)) = !- ?> failwith "nullable reads the evidence"

///> rust
test broad_classes_pick_a_printable_example =
    ? class_example !- [ (0u32, 127u32) ] <> "A"
    ?> failwith "a class starting at a control character picks a printable example"
    ? class_example !- [ (9u32, 10u32); (32u32, 32u32) ] <> "\t"
    ?> failwith "a whitespace-only class keeps its own first character"
    ? class_example !- [ (48u32, 57u32) ] <> "0"
    ?> failwith "a printable class keeps its low bound"
