///- --package .
open sm'_operators
open xsd

type loaded_tree = { paths : list string; missing : list string; schema : xsd_schema }

inl directory_of (path : string) : string =
    inl slash = sm'.last_index_of "/" path
    if slash < 0i32 then "" else sm'.substring 0i32 (slash + 1i32) path

let rec has_string (target : string) (items : list string) : bool =
    match items with
    | x :: rest => x = target || has_string target rest
    | Nil => false

inl merge (more : xsd_schema) (into : xsd_schema) : xsd_schema =
    {
        into with
            simple_types = listm.append more.simple_types into.simple_types
            complex_types = listm.append more.complex_types into.complex_types
            elements = listm.append more.elements into.elements
    }

type schema_catalog = list (string * string)

let rec catalog_location (catalog : schema_catalog) (location : string) : option string =
    match catalog with
    | (key, local) :: rest =>
        if key = location then Some local
        elif sm'.ends_with "/" key && sm'.starts_with key location then
            Some (local ++# sm'.substring (sm'.length key) (sm'.length location - sm'.length key) location)
        else catalog_location rest location
    | Nil => None

let rec without_parent_steps (path : string) : string =
    inl marker = sm'.index_of "/../" path
    if marker <= 0i32 then path
    else
        inl head = sm'.substring 0i32 marker path
        inl slash = sm'.last_index_of "/" head
        inl tail = sm'.substring (marker + 4i32) (sm'.length path - marker - 4i32) path
        if slash < 0i32 || sm'.substring (slash + 1i32) (marker - slash - 1i32) path = ".." then path
        else without_parent_steps (sm'.substring 0i32 (slash + 1i32) head ++# tail)

inl resolved_location (catalog : schema_catalog) (directory : string) (location : string) : string =
    match catalog_location catalog location with
    | Some local => without_parent_steps local
    | None => without_parent_steps (directory ++# location)

let rec load_tree (catalog : schema_catalog) (path : string) (tree : loaded_tree) : loaded_tree =
    if has_string path tree.paths then tree
    elif xml.is_file path = false then { tree with missing = (path :: tree.missing) }
    else
        inl schema = xml.read_text_replacing_invalid_utf8 path |> read_schema
        inl loaded = { tree with paths = (path :: tree.paths); schema = merge schema tree.schema }
        load_includes catalog (directory_of path) schema.includes loaded

and let load_includes
    (catalog : schema_catalog)
    (directory : string)
    (locations : list string)
    (tree : loaded_tree)
    : loaded_tree
    =
    match locations with
    | location :: rest =>
        inl tree = if location = "" then tree else load_tree catalog (resolved_location catalog directory location) tree
        load_includes catalog directory rest tree
    | Nil => tree

inl load_schema_tree_with (catalog : schema_catalog) (path : string) : loaded_tree =
    inl empty = { target_namespace = ""; includes = Nil; simple_types = Nil; complex_types = Nil; elements = Nil }
    load_tree catalog path { paths = Nil; missing = Nil; schema = empty }

inl load_schema_tree (path : string) : loaded_tree = load_schema_tree_with Nil path

let rec type_names (types : list xsd) (acc : list string) : list string =
    match types with
    | Simple (name, _, _) :: rest => type_names rest (name :: acc)
    | Complex (name, _, _) :: rest => type_names rest (name :: acc)
    | Derived (name, _, _, _) :: rest => type_names rest (name :: acc)
    | _ :: rest => type_names rest acc
    | Nil => acc

let rec references_of (item : xsd) (acc : list string) : list string =
    match item with
    | Simple (_, base, _) => base :: acc
    | Complex (_, content, attributes) => references_of content (attribute_types attributes acc)
    | Derived (_, base, content, attributes) => references_of content (attribute_types attributes (base :: acc))
    | Sequence (_, _, items) => references_in items acc
    | Choice (_, _, items) => references_in items acc
    | Element (_, type_reference, _, _, inline) =>
        match inline with
        | Some inner => references_of inner (type_reference :: acc)
        | None => type_reference :: acc
    | Attribute (_, type_reference, _, _, inline) => inline_references inline (type_reference :: acc)
    | AnyContent => acc
    | Empty => acc

and let references_in (items : list xsd) (acc : list string) : list string =
    match items with
    | item :: rest => references_in rest (references_of item acc)
    | Nil => acc

and let inline_references (inline : option xsd) (acc : list string) : list string =
    match inline with
    | Some inner => references_of inner acc
    | None => acc

and let attribute_types (attributes : list xsd) (acc : list string) : list string =
    match attributes with
    | Attribute (_, type_reference, _, _, inline) :: rest =>
        attribute_types rest (inline_references inline (type_reference :: acc))
    | _ :: rest => attribute_types rest acc
    | Nil => acc

inl is_builtin (reference : string) : bool =
    inl prefix = prefix_of reference
    prefix = "xs" || prefix = "xsd"

let rec unresolved_in (names : list string) (references : list string) (acc : i32) : i32 =
    match references with
    | reference :: rest =>
        inl dangling =
            reference <> "" && is_builtin reference = false && has_string (xml.local_name reference) names = false
        unresolved_in names rest (if dangling then acc + 1i32 else acc)
    | Nil => acc

inl unresolved_count (tree : loaded_tree) : i32 =
    inl schema = tree.schema
    inl names = type_names schema.simple_types (type_names schema.complex_types Nil)
    inl references =
        references_in schema.elements (references_in schema.complex_types (references_in schema.simple_types Nil))
    unresolved_in names references 0i32

///> rust
test unresolved_count_counts_dangling_type_references =
    inl tree text = { paths = Nil; missing = Nil; schema = read_schema text }
    inl element = "<xs:sequence><xs:element name=\"a\" type=\"T\"/></xs:sequence>"
    inl dangling = "<xs:schema><xs:complexType name=\"C\">" ++# element ++# "</xs:complexType></xs:schema>"
    inl simple = "<xs:simpleType name=\"T\"><xs:restriction base=\"xs:string\"/></xs:simpleType>"
    inl defined =
        "<xs:schema>" ++# simple ++# "<xs:complexType name=\"C\">" ++# element ++# "</xs:complexType></xs:schema>"
    if unresolved_count (tree dangling) <> 1i32 then failwith "an undefined type is one dangling reference"
    if unresolved_count (tree defined) <> 0i32 then failwith "a defined type resolves"
    if is_builtin "xs:string" = false then failwith "xs:string is built in"
    if is_builtin "T" then failwith "a schema type is not built in"

///> rust
test catalog_maps_absolute_locations_to_local_files =
    inl site = "http://example.org/"
    inl catalog = (site ++# "cat.xsd", "C:/corpus/cat.xsd") :: (site ++# "types/", "C:/corpus/types/") :: Nil
    inl resolved location = resolved_location catalog "C:/corpus/" location
    if resolved (site ++# "cat.xsd") <> "C:/corpus/cat.xsd" then failwith "an exact entry"
    if resolved (site ++# "types/td.xsd") <> "C:/corpus/types/td.xsd" then failwith "a prefix entry"
    if resolved "local.xsd" <> "C:/corpus/local.xsd" then failwith "a relative location stays relative"
    if resolved_location Nil "C:/a/" "b.xsd" <> "C:/a/b.xsd" then failwith "an empty catalog changes nothing"
    if resolved_location Nil "C:/u/maindoc/" "../common/b.xsd" <> "C:/u/common/b.xsd"
    then failwith "a parent step folds"
    if without_parent_steps "C:/a/b/../../c.xsd" <> "C:/c.xsd" then failwith "two parent steps fold"
