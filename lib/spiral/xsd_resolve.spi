///- --package .
:< sm'_operators
:< xsd

:== loaded_tree form = { paths : list string; missing : list string; schema : xsd_schema form }

:= directory_of (path : string) : string =
    := slash = sm'::last_index_of "/" path
    ? slash < 0i32 ?> "" |: sm'::substring 0i32 (slash + 1i32) path

:~ ^ has_string (target : string) (items : list string) : bool =
    ?= items ?|
    | x :: rest => x = target || has_string target rest
    | [] => !-

:= resolve_merged_target \* form. (more : xsd_schema form) (into : xsd_schema form) : namespace_uri =
    ? namespace_text into::target_namespace = "" ?> more::target_namespace |: into::target_namespace

:= resolve_merged_types \* form. (more : xsd_schema form) (into : xsd_schema form) : xsd_schema form =
    {
        into ?|
            simple_types = listm::append more::simple_types into::simple_types
            complex_types = listm::append more::complex_types into::complex_types
    }

:= merge \* form. (more : xsd_schema form) (into : xsd_schema form) : xsd_schema form =
    := target = resolve_merged_target more into
    := typed = resolve_merged_types more into
    {
        typed ?|
            target_namespace = target
            elements = listm::append more::elements into::elements
    }

:== schema_catalog = list (string * string)

:= resolve_catalog_prefixed (key : string) (local : string) (location : string) : string =
    local ++# sm'::substring (sm'::length key) (sm'::length location - sm'::length key) location

:= resolve_parent_tail (path : string) (marker : i32) : string =
    sm'::substring (marker + 4i32) (sm'::length path - marker - 4i32) path

:= resolve_parent_blocked (path : string) (slash : i32) (marker : i32) : bool =
    slash < 0i32 || sm'::substring (slash + 1i32) (marker - slash - 1i32) path = ".."

:~ ^ catalog_location (catalog : schema_catalog) (location : string) : option string =
    ?= catalog ?|
    | (key, local) :: rest => resolve_catalog_entry key local rest location
    | [] => None

:& :~ resolve_catalog_entry
    (key : string) (local : string) (rest : schema_catalog) (location : string)
    : option string
    =
    ? key = location ?> Some local
    |? sm'::ends_with "/" key && sm'::starts_with key location ?> Some (resolve_catalog_prefixed key local location)
    |: catalog_location rest location

:~ ^ without_parent_steps (path : string) : string =
    := marker = sm'::index_of "/../" path
    ? marker <= 0i32 ?> path |: resolve_parent_step path marker

:& :~ resolve_parent_step (path : string) (marker : i32) : string =
    := head = sm'::substring 0i32 marker path
    := slash = sm'::last_index_of "/" head
    := tail = resolve_parent_tail path marker
    ? resolve_parent_blocked path slash marker ?> path
    |: without_parent_steps (sm'::substring 0i32 (slash + 1i32) head ++# tail)

:= resolved_location (catalog : schema_catalog) (directory : string) (location : string) : string =
    ?= catalog_location catalog location ?|
    | Some local => without_parent_steps local
    | None => without_parent_steps (directory ++# location)

///> rust
:# catalog_maps_absolute_locations_to_local_files =
    := site = "http://example.org/"
    := catalog = (site ++# "cat.xsd", "C:/corpus/cat.xsd") :: (site ++# "types/", "C:/corpus/types/") :: []
    := resolved location = resolved_location catalog "C:/corpus/" location
    ? resolved (site ++# "cat.xsd") <> "C:/corpus/cat.xsd" ?> failwith "an exact entry"
    ? resolved (site ++# "types/td.xsd") <> "C:/corpus/types/td.xsd" ?> failwith "a prefix entry"
    ? resolved "local.xsd" <> "C:/corpus/local.xsd" ?> failwith "a relative location stays relative"
    ? resolved_location [] "C:/a/" "b.xsd" <> "C:/a/b.xsd" ?> failwith "an empty catalog changes nothing"
    ? resolved_location [] "C:/u/maindoc/" "../common/b.xsd" <> "C:/u/common/b.xsd"
    ?> failwith "a parent step folds"
    ? without_parent_steps "C:/a/b/../../c.xsd" <> "C:/c.xsd" ?> failwith "two parent steps fold"

:= type_name_of \* form. (item : xsd type_def form) : string =
    ?= item ?|
    | Simple s => definition_text s::name
    | Complex c => definition_text c::name
    | Derived d => definition_text d::name

:~ ^ type_names \* form. (types : list (xsd type_def form)) (acc : list string) : list string =
    ?= types ?|
    | item :: rest => type_names rest (type_name_of item :: acc)
    | [] => acc

:= is_builtin (reference : string) : bool =
    := prefix = prefix_of reference
    prefix = "xs" || prefix = "xsd"

:~ ^ namespace_for (prefix : string) (namespaces : list (string * string)) : option string =
    ?= namespaces ?|
    | (key, uri) :: rest => ? key = prefix ?> Some uri |: namespace_for prefix rest
    | [] => None

:~ ^ declared_namespaces (attributes : list (string * string)) (acc : list (string * string)) : list (string * string) =
    ?= attributes ?|
    | (key, value) :: rest =>
        ? key = "xmlns"
        ?> declared_namespaces rest (("", value) :: acc)
        |? sm'::starts_with "xmlns:" key
        ?> declared_namespaces rest ((sm'::substring 6i32 (sm'::length key - 6i32) key, value) :: acc)
        |: declared_namespaces rest acc
    | [] => acc

:= schema_namespaces (text : string) : list (string * string) =
    ?= first_named "schema" (xml::read_xml text) ?|
    | Some (attributes, _) => declared_namespaces attributes []
    | None => []

:= qualified (uri : string) (local : string) : string = ? local = "" ?> "" |: "{" ++# uri ++# "}" ++# local

:= qualify_reference (namespaces : list (string * string)) (reference : string) : string =
    ? reference = "" || is_builtin reference ?> reference
    |:
        ?= namespace_for (prefix_of reference) namespaces ?|
        | Some uri => qualified uri (xml::local_name reference)
        | None => reference

:= renamed_definition \* a b.
    (rename : string -> string) ((definition_name name) : definition_name a)
    : definition_name b
    =
    definition_name (rename name)

:= renamed_reference \* a b.
    (rename : string -> string) ((type_reference reference) : type_reference a)
    : type_reference b
    =
    type_reference (rename reference)

:= rename_ref \* a b.
    (reference : type_reference a -> type_reference b) (r : option (type_reference a))
    : option (type_reference b)
    =
    ?= r ?|
    | Some x => Some (reference x)
    | None => None

:~ ^ renamed
    \* k a b.
    (definition : definition_name a -> definition_name b) (reference : type_reference a -> type_reference b)
    (item : xsd k a)
    : xsd k b
    =
    ?= item ?|
    | Simple s => Simple { s ?| name = definition s::name; base = reference s::base }
    | Complex c =>
        Complex { c ?|
            name = definition c::name
            content = renamed definition reference c::content
            attributes = renamed_all definition reference c::attributes []
        }
    | Derived d =>
        Derived { d ?|
            name = definition d::name
            base = reference d::base
            content = renamed definition reference d::content
            attributes = renamed_all definition reference d::attributes []
        }
    | Sequence s => Sequence { s ?| items = renamed_all definition reference s::items [] }
    | Choice c => Choice { c ?| items = renamed_all definition reference c::items [] }
    | Element e =>
        Element { e ?|
            type_ref = rename_ref reference e::type_ref
            inline = renamed_inline definition reference e::inline
        }
    | AnyContent () => AnyContent ()
    | Empty () => Empty ()
    | Attribute a =>
        Attribute { a ?|
            type_ref = rename_ref reference a::type_ref
            inline = renamed_inline definition reference a::inline
        }

:& :~ renamed_all
    \* k a b.
    (definition : definition_name a -> definition_name b) (reference : type_reference a -> type_reference b)
    (items : list (xsd k a)) (acc : list (xsd k b))
    : list (xsd k b)
    =
    ?= items ?|
    | item :: rest => renamed_all definition reference rest (renamed definition reference item :: acc)
    | [] => listm::rev acc

:& :~ renamed_inline \* a b.
    (definition : definition_name a -> definition_name b) (reference : type_reference a -> type_reference b)
    (inline : option (xsd type_def a))
    : option (xsd type_def b)
    =
    ?= inline ?|
    | Some inner => Some (renamed definition reference inner)
    | None => None

:= rename_schema \* a b.
    (definition : definition_name a -> definition_name b) (reference : type_reference a -> type_reference b)
    (schema : xsd_schema a)
    : xsd_schema b
    =
    {
        schema ?|
            simple_types = renamed_all definition reference schema::simple_types []
            complex_types = renamed_all definition reference schema::complex_types []
            elements = renamed_all definition reference schema::elements []
    }

:= qualify_schema (namespaces : list (string * string)) (schema : xsd_schema written) : xsd_schema qualified =
    := definitions = renamed_definition (qualified (namespace_text schema::target_namespace))
    rename_schema definitions (renamed_reference (qualify_reference namespaces)) schema

:== tag_scope =
    {
        root_namespace : string
        document_prefixes : list (string * string)
        file_namespace : string
        file_namespaces : list (string * string)
        qualified_locals : bool
    }

:~ ^ declared_document_prefixes
    (text : string) (attributes : list (string * string)) (acc : list (string * string))
    : list (string * string)
    =
    ?= attributes ?|
    | (key, value) :: rest =>
        := known = value = "http://www.w3.org/2001/XMLSchema" || value = "http://www.w3.org/2000/09/xmldsig#"
        := prefix = ? sm'::starts_with "xmlns:" key ?> sm'::substring 6i32 (sm'::length key - 6i32) key |: ""
        ? prefix <> "" && known = !- && sm'::contains ("ref=\"" ++# prefix ++# ":") text
        ?> declared_document_prefixes text rest ((prefix, value) :: acc)
        |: declared_document_prefixes text rest acc
    | [] => acc

:= schema_attributes (text : string) : list (string * string) =
    ?= first_named "schema" (xml::read_xml text) ?|
    | Some (attributes, _) => attributes
    | None => []

:~ ^ prefix_for (uri : string) (prefixes : list (string * string)) : option string =
    ?= prefixes ?|
    | (prefix, value) :: rest => ? value = uri ?> Some prefix |: prefix_for uri rest
    | [] => None

:= tag_in (scope : tag_scope) (uri : string) (local : string) (fallback : string) : string =
    ? uri = scope::root_namespace ?> local
    |:
        ?= prefix_for uri scope::document_prefixes ?|
        | Some prefix => prefix ++# ":" ++# local
        | None => fallback

:= scoped_tag (scope : tag_scope) (name : string) : string =
    ? sm'::contains ":" name ?>
        ?= namespace_for (prefix_of name) scope::file_namespaces ?|
        | Some uri => tag_in scope uri (xml::local_name name) name
        | None => name
    |? scope::qualified_locals ?> tag_in scope scope::file_namespace name name
    |: name

:~ ^ tagged \* k a. (scope : tag_scope) (item : xsd k a) : xsd k a =
    ?= item ?|
    | Simple s => Simple s
    | Complex c => Complex { c ?| content = tagged scope c::content }
    | Derived d => Derived { d ?| content = tagged scope d::content }
    | Sequence s => Sequence { s ?| items = tagged_all scope s::items [] }
    | Choice c => Choice { c ?| items = tagged_all scope c::items [] }
    | Element e =>
        Element { e ?| name = tag_name (scoped_tag scope (tag_text e::name)); inline = tagged_inline scope e::inline }
    | AnyContent () => AnyContent ()
    | Empty () => Empty ()
    | Attribute a => Attribute a

:& :~ tagged_all \* k a. (scope : tag_scope) (items : list (xsd k a)) (acc : list (xsd k a)) : list (xsd k a) =
    ?= items ?|
    | item :: rest => tagged_all scope rest (tagged scope item :: acc)
    | [] => listm::rev acc

:& :~ tagged_inline \* a. (scope : tag_scope) (inline : option (xsd type_def a)) : option (xsd type_def a) =
    ?= inline ?|
    | Some inner => Some (tagged scope inner)
    | None => None

:~ ^ tagged_top \* a.
    (scope : tag_scope) (items : list (xsd particle a)) (acc : list (xsd particle a))
    : list (xsd particle a)
    =
    ?= items ?|
    | (Element e) :: rest => tagged_top scope rest (Element { e ?| inline = tagged_inline scope e::inline } :: acc)
    | item :: rest => tagged_top scope rest (item :: acc)
    | [] => listm::rev acc

:= tag_schema \* a. (scope : tag_scope) (schema : xsd_schema a) : xsd_schema a =
    {
        schema ?|
            complex_types = tagged_all scope schema::complex_types []
            elements = tagged_top scope schema::elements []
    }

:= qualified_local (name : string) : string =
    := close = sm'::index_of "}" name
    ? sm'::starts_with "{" name && close > 0i32
    ?> sm'::substring (close + 1i32) (sm'::length name - close - 1i32) name
    |: name

:= qualified_uri (name : string) : string =
    := close = sm'::index_of "}" name
    ? sm'::starts_with "{" name && close > 0i32 ?> sm'::substring 1i32 (close - 1i32) name |: ""

:~ ^ uri_of_local (local : string) (names : list string) : option string =
    ?= names ?|
    | name :: rest => ? qualified_local name = local ?> Some (qualified_uri name) |: uri_of_local local rest
    | [] => None

:~ ^ colliding_locals (names : list string) (seen : list string) (acc : list string) : list string =
    ?= names ?|
    | name :: rest =>
        := local = qualified_local name
        := clash =
            ?= uri_of_local local seen ?|
            | Some uri => uri <> qualified_uri name
            | None => !-
        colliding_locals rest (name :: seen) (? clash && has_string local acc = !- ?> local :: acc |: acc)
    | [] => acc

:= namespace_tag (uri : string) : string =
    := trimmed = ? sm'::ends_with "/" uri ?> sm'::substring 0i32 (sm'::length uri - 1i32) uri |: uri
    := cut = sm'::last_index_of "/" trimmed
    := colon = sm'::last_index_of ":" trimmed
    := at = ? colon > cut ?> colon |: cut
    sm'::substring (at + 1i32) (sm'::length trimmed - at - 1i32) trimmed

:= final_name (root : string) (collisions : list string) (name : string) : string =
    ? sm'::starts_with "{" name = !- ?> name
    |:
        := local = qualified_local name
        := uri = qualified_uri name
        ? uri = root || has_string local collisions = !- ?> local |: namespace_tag uri ++# "_" ++# local

:= finalize_names (schema : xsd_schema qualified) : xsd_schema final =
    := names = type_names schema::simple_types (type_names schema::complex_types [])
    := final = final_name (namespace_text schema::target_namespace) (colliding_locals names [] [])
    rename_schema (renamed_definition final) (renamed_reference final) schema

:~ ^ catalogued_namespaces (catalog : schema_catalog) (namespaces : list string) (acc : list string) : list string =
    ?= namespaces ?|
    | namespace :: rest =>
        ?= catalog_location catalog namespace ?|
        | Some _ => catalogued_namespaces catalog rest (namespace :: acc)
        | None => catalogued_namespaces catalog rest acc
    | [] => acc

:== document_scope = { root_namespace : string; document_prefixes : list (string * string) }

:= attribute_text (key : string) (attributes : list (string * string)) : string =
    ?= xml::attribute_of key attributes ?|
    | Some value => value
    | None => ""

:= document_scope_of (text : string) : document_scope =
    := attributes = schema_attributes text
    {
        root_namespace = attribute_text "targetNamespace" attributes
        document_prefixes = declared_document_prefixes text attributes []
    }

:= file_scope (document : document_scope) (attributes : list (string * string)) : tag_scope =
    {
        root_namespace = document::root_namespace
        document_prefixes = document::document_prefixes
        file_namespace = attribute_text "targetNamespace" attributes
        file_namespaces = declared_namespaces attributes []
        qualified_locals = attribute_text "elementFormDefault" attributes = "qualified"
    }

:~ ^ load_tree
    (catalog : schema_catalog) (document : document_scope) (path : string) (tree : loaded_tree qualified)
    : loaded_tree qualified
    =
    ? has_string path tree::paths ?> tree
    |? xml::is_file path = !- ?> { tree ?| missing = (path :: tree::missing) }
    |:
        := text = xml::read_text_replacing_invalid_utf8 path
        := attributes = schema_attributes text
        := schema =
            text |> read_schema |> tag_schema (file_scope document attributes)
            |> qualify_schema (declared_namespaces attributes [])
        := loaded = { tree ?| paths = (path :: tree::paths); schema = merge schema tree::schema }
        := locations = listm::append schema::includes (catalogued_namespaces catalog schema::namespace_imports [])
        load_includes catalog document (directory_of path) locations loaded

:& :~ load_includes
    (catalog : schema_catalog)
    (document : document_scope)
    (directory : string)
    (locations : list string)
    (tree : loaded_tree qualified)
    : loaded_tree qualified
    =
    ?= locations ?|
    | location :: rest =>
        := next = resolved_location catalog directory location
        := tree = ? location = "" ?> tree |: load_tree catalog document next tree
        load_includes catalog document directory rest tree
    | [] => tree

:= load_schema_tree_with (catalog : schema_catalog) (path : string) : loaded_tree final =
    := empty =
        {
            target_namespace = namespace_uri ""
            includes = []
            namespace_imports = []
            simple_types = []
            complex_types = []
            elements = []
        }
    := document =
        ? xml::is_file path ?> document_scope_of (xml::read_text_replacing_invalid_utf8 path)
        |: { root_namespace = ""; document_prefixes = [] }
    := tree = load_tree catalog document path { paths = []; missing = []; schema = empty }
    { tree ?| schema = finalize_names tree::schema }

:= load_schema_tree (path : string) : loaded_tree final = load_schema_tree_with [] path

:= reference_into \* form. (r : option (type_reference form)) (acc : list string) : list string =
    ?= r ?|
    | Some x => reference_text x :: acc
    | None => acc

:~ ^ references_of \* k form. (item : xsd k form) (acc : list string) : list string =
    ?= item ?|
    | Simple s => reference_text s::base :: acc
    | Complex c => references_of c::content (references_all c::attributes acc)
    | Derived d => references_of d::content (references_all d::attributes (reference_text d::base :: acc))
    | Sequence s => references_all s::items acc
    | Choice c => references_all c::items acc
    | Element e => inline_references e::inline (reference_into e::type_ref acc)
    | AnyContent () => acc
    | Empty () => acc
    | Attribute a => inline_references a::inline (reference_into a::type_ref acc)

:& :~ references_all \* k form. (items : list (xsd k form)) (acc : list string) : list string =
    ?= items ?|
    | item :: rest => references_all rest (references_of item acc)
    | [] => acc

:& :~ inline_references \* form. (inline : option (xsd type_def form)) (acc : list string) : list string =
    ?= inline ?|
    | Some inner => references_of inner acc
    | None => acc

:~ ^ tags_of \* k form. (item : xsd k form) (acc : list string) : list string =
    ?= item ?|
    | Simple _ => acc
    | Complex c => tags_of c::content acc
    | Derived d => tags_of d::content acc
    | Sequence s => tags_all s::items acc
    | Choice c => tags_all c::items acc
    | Element e => inline_tags e::inline (tag_text e::name :: acc)
    | AnyContent () => acc
    | Empty () => acc
    | Attribute _ => acc

:& :~ tags_all \* k form. (items : list (xsd k form)) (acc : list string) : list string =
    ?= items ?|
    | item :: rest => tags_all rest (tags_of item acc)
    | [] => acc

:& :~ inline_tags \* form. (inline : option (xsd type_def form)) (acc : list string) : list string =
    ?= inline ?|
    | Some inner => tags_of inner acc
    | None => acc

///> rust
:# a_same_namespace_ref_writes_its_local_name =
    := text =
        "<xs:schema xmlns:xs=\"http://www.w3.org/2001/XMLSchema\" xmlns:SiiDte=\"urn:sii\" targetNamespace=\"urn:sii\">"
        ++# "<xs:element name=\"DTE\" type=\"xs:string\"/><xs:complexType name=\"SetDTE\"><xs:sequence>"
        ++# "<xs:element ref=\"SiiDte:DTE\"/></xs:sequence></xs:complexType></xs:schema>"
    := schema = tag_schema (file_scope (document_scope_of text) (schema_attributes text)) (read_schema text)
    := tags = tags_all schema::complex_types []
    ? has_string "DTE" tags = !- || has_string "SiiDte:DTE" tags
    ?> failwith "a ref into the root namespace writes the bare local name"

///> rust
:# a_qualified_import_writes_its_prefix =
    := xs = "xmlns:xs=\"http://www.w3.org/2001/XMLSchema\""
    := root_text =
        "<xs:schema " ++# xs ++# " xmlns:sfLR=\"urn:lr\" xmlns:sf=\"urn:sf\" targetNamespace=\"urn:lr\""
        ++# " elementFormDefault=\"qualified\"><xs:element name=\"Cabecera\" type=\"sf:CabeceraType\"/>"
        ++# "<xs:complexType name=\"R\"><xs:sequence><xs:element ref=\"sf:RegistroAlta\"/>"
        ++# "<xs:element name=\"Own\" type=\"xs:string\"/></xs:sequence></xs:complexType></xs:schema>"
    := imported form =
        "<xs:schema " ++# xs ++# " xmlns:sf=\"urn:sf\" targetNamespace=\"urn:sf\"" ++# form
        ++# "><xs:complexType name=\"CabeceraType\"><xs:sequence>"
        ++# "<xs:element name=\"ObligadoEmision\" type=\"xs:string\"/></xs:sequence></xs:complexType></xs:schema>"
    := document = document_scope_of root_text
    := tags_in scope text =
        := schema = tag_schema (file_scope scope (schema_attributes text)) (read_schema text)
        tags_all schema::complex_types []
    := qualified_text = imported " elementFormDefault=\"qualified\""
    ? has_string "sf:ObligadoEmision" (tags_in document qualified_text) = !-
    ?> failwith "a local element of a qualified imported schema takes the root's prefix"
    := root_tags = tags_in document root_text
    ? has_string "sf:RegistroAlta" root_tags = !- || has_string "Own" root_tags = !-
    ?> failwith "the root keeps a foreign ref's prefix and writes its own locals bare"
    ? has_string "ObligadoEmision" (tags_in { document ?| document_prefixes = [] } qualified_text) = !-
    ?> failwith "without a declared document prefix the name stays bare, never an undeclared prefix"
    ? has_string "ObligadoEmision" (tags_in document (imported "")) = !-
    ?> failwith "an unqualified schema writes its locals bare"

///> rust
:# colliding_local_names_keep_both_namespaces =
    := xs = "xmlns:xs=\"http://www.w3.org/2001/XMLSchema\""
    := sequence one = "<xs:sequence><xs:element name=\"" ++# one ++# "\" type=\"xs:string\"/></xs:sequence>"
    := root_text =
        "<xs:schema " ++# xs ++# " xmlns:tns=\"urn:a\" xmlns:etd=\"urn:b/Defs/\" targetNamespace=\"urn:a\">"
        ++# "<xs:complexType name=\"TAdres\">" ++# sequence "L1" ++# "</xs:complexType>"
        ++# "<xs:complexType name=\"Root\"><xs:sequence><xs:element name=\"own\" type=\"tns:TAdres\"/>"
        ++# "<xs:element name=\"their\" type=\"etd:TAdres\"/></xs:sequence></xs:complexType></xs:schema>"
    := imported_text =
        "<xs:schema " ++# xs ++# " xmlns:etd=\"urn:b/Defs/\" targetNamespace=\"urn:b/Defs/\">"
        ++# "<xs:complexType name=\"TAdres\">" ++# sequence "Pol" ++# "</xs:complexType></xs:schema>"
    := read text = text |> read_schema |> qualify_schema (schema_namespaces text)
    := schema = finalize_names (merge (read imported_text) (read root_text))
    := names = type_names schema::complex_types []
    ? has_string "TAdres" names = !- ?> failwith "the root namespace keeps its name"
    ? has_string "Defs_TAdres" names = !- ?> failwith "the imported namespace gets its tag"
    := references = references_all schema::complex_types []
    ? has_string "TAdres" references = !- || has_string "Defs_TAdres" references = !-
    ?> failwith "each reference names its own namespace's type"
    ? has_string "Root" names = !- ?> failwith "a name without a collision is unchanged"

:~ ^ unresolved_in (names : list string) (references : list string) (acc : i32) : i32 =
    ?= references ?|
    | reference :: rest =>
        := dangling =
            reference <> "" && is_builtin reference = !- && has_string (xml::local_name reference) names = !-
        unresolved_in names rest (? dangling ?> acc + 1i32 |: acc)
    | [] => acc

:= unresolved_count \* form. (tree : loaded_tree form) : i32 =
    := schema = tree::schema
    := names = type_names schema::simple_types (type_names schema::complex_types [])
    := references =
        references_all schema::elements (references_all schema::complex_types (references_all schema::simple_types []))
    unresolved_in names references 0i32

///> rust
:# unresolved_count_counts_dangling_type_references =
    := tree text = { paths = []; missing = []; schema = read_schema text }
    := element = "<xs:sequence><xs:element name=\"a\" type=\"T\"/></xs:sequence>"
    := dangling = "<xs:schema><xs:complexType name=\"C\">" ++# element ++# "</xs:complexType></xs:schema>"
    := simple = "<xs:simpleType name=\"T\"><xs:restriction base=\"xs:string\"/></xs:simpleType>"
    := defined =
        "<xs:schema>" ++# simple ++# "<xs:complexType name=\"C\">" ++# element ++# "</xs:complexType></xs:schema>"
    ? unresolved_count (tree dangling) <> 1i32 ?> failwith "an undefined type is one dangling reference"
    ? unresolved_count (tree defined) <> 0i32 ?> failwith "a defined type resolves"
    ? is_builtin "xs:string" = !- ?> failwith "xs:string is built in"
    ? is_builtin "T" ?> failwith "a schema type is not built in"

///> rust
:# namespace_only_imports_resolve_through_the_catalog =
    := catalog = ("urn:common", "C:/corpus/common.xsd") :: []
    ?= catalogued_namespaces catalog [ "urn:common"; "urn:unknown" ] [] ?|
    | only :: [] =>
        ? resolved_location catalog "C:/x/" only <> "C:/corpus/common.xsd"
        ?> failwith "a namespace key maps to its file"
    | _ => failwith "only the catalogued namespace is kept"
