:# zeta static =
    :< testing

:~ two_pi () : f64 = 2.0 * pi

:~ theta (t : f64) : f64 =
    := t3 = t * t * t
    := t5 = t3 * t * t
    := tail = 1.0 / (48.0 * t) + 7.0 / (5760.0 * t3) + 31.0 / (80640.0 * t5) + 127.0 / (430080.0 * t5 * t * t)
    t / 2.0 * log (t / two_pi ()) - t / 2.0 - pi / 8.0 + tail

:~ c0_at (p : f64) : f64 = cos (two_pi () * (p * p - p - 1.0 / 16.0)) / cos (two_pi () * p)

:~ c0 (p : f64) : f64 =
    := near_pole = cos (two_pi () * p)
    ? near_pole < 0.000000001 && near_pole > 0.0 - 0.000000001 ?> c0_at (p + 0.0000001) |: c0_at p

:~ c1 (p : f64) : f64 =
    := h = 0.001
    := third = (c0 (p + 2.0 * h) - 2.0 * c0 (p + h) + 2.0 * c0 (p - h) - c0 (p - 2.0 * h)) / (2.0 * h * h * h)
    0.0 - third / (96.0 * pi * pi)

:~ ^ main_sum (t : f64) (th : f64) (n : i32) (count : i32) (acc : f64) : f64 =
    ? n > count
    ?> acc
    |:
        := k : f64 = conv n
        main_sum t th (n + 1i32) count (acc + cos (th - t * log k) / sqrt k)

:~ riemann_siegel_z (t : f64) : f64 =
    := a = sqrt (t / two_pi ())
    := count : i32 = conv a
    := p = a - (conv count : f64)
    := sign = ? count % 2i32 = 1i32 ?> 1.0 |: 0.0 - 1.0
    := remainder = sign / sqrt a * (c0 p + c1 p / a)
    2.0 * main_sum t (theta t) 1i32 count 0.0 + remainder

:~ ^ bisect (lo : f64) (hi : f64) (z_lo : f64) (left : i32) : f64 =
    := mid = (lo + hi) / 2.0
    ? left <= 0i32
    ?> mid
    |:
        := z_mid = riemann_siegel_z mid
        ? (z_lo < 0.0) = (z_mid < 0.0) ?> bisect mid hi z_mid (left - 1i32) |: bisect lo mid z_lo (left - 1i32)

:~ zero_near (t : f64) : f64 = bisect (t - 0.05) (t + 0.05) (riemann_siegel_z (t - 0.05)) 50i32

:~ changes_sign (t : f64) : bool = (riemann_siegel_z (t - 0.05) < 0.0) <> (riemann_siegel_z (t + 0.05) < 0.0)

:~ distance (a : f64) (b : f64) : f64 = ? a > b ?> a - b |: b - a

:~ worse_miss (worst : f64) (z : f64) : f64 =
    := miss = distance (zero_near z) z
    ? miss > worst ?> miss |: worst

:= first_zeros () : list f64 =
    [
        14.134725142; 21.022039639; 25.010857580; 30.424876126; 32.935061588
        37.586178159; 40.918719012; 43.327073281; 48.005150881; 49.773832478
    ]

///> rust
///> gleam
:# theta_vanishes_at_the_first_gram_point =
    (distance (theta 17.8455995405) 0.0 < 0.000001) |> _assert_eq !+

:~ later_miss (w : f64) (z : f64) : f64 = ? z > 24.0 ?> worse_miss w z |: w

///> rust
///> gleam
:# riemann_siegel_z_changes_sign_at_each_of_the_first_ten_zeros =
    first_zeros () |> listm::fold (\ (ok : bool) (z : f64) => ok && changes_sign z) !+ |> _assert_eq !+

///> rust
///> gleam
:# riemann_siegel_z_locates_the_first_ten_zeros_closely =
    := zeros = first_zeros ()
    (listm::fold worse_miss 0.0 zeros < 0.003, listm::fold later_miss 0.0 zeros < 0.0005) |> _assert_eq (!+, !+)

:== complex = { re : f64; im : f64 }

:~ c_add (a : complex) (b : complex) : complex = { re = a::re + b::re; im = a::im + b::im }

:~ c_sub (a : complex) (b : complex) : complex = { re = a::re - b::re; im = a::im - b::im }

:~ c_mul (a : complex) (b : complex) : complex =
    { re = a::re * b::re - a::im * b::im; im = a::re * b::im + a::im * b::re }

:~ c_scale (k : f64) (a : complex) : complex = { re = k * a::re; im = k * a::im }

:~ c_div (a : complex) (b : complex) : complex =
    := d = b::re * b::re + b::im * b::im
    { re = (a::re * b::re + a::im * b::im) / d; im = (a::im * b::re - a::re * b::im) / d }

:~ power_neg (n : f64) (s : complex) : complex =
    := l = log n
    := m = exp (0.0 - s::re * l)
    { re = m * cos (s::im * l); im = 0.0 - m * sin (s::im * l) }

:~ bernoulli_top (k : i32) : f64 =
    ? k = 9i32 ?> (43867.0 / 798.0) / 6402373705728000.0
    |? k = 10i32 ?> (0.0 - 174611.0 / 330.0) / 2432902008176640000.0
    |: 0.0

:~ bernoulli_high (k : i32) : f64 =
    ? k = 6i32 ?> (0.0 - 691.0 / 2730.0) / 479001600.0
    |? k = 7i32 ?> (7.0 / 6.0) / 87178291200.0
    |? k = 8i32 ?> (0.0 - 3617.0 / 510.0) / 20922789888000.0
    |: bernoulli_top k

:~ bernoulli_over_factorial (k : i32) : f64 =
    ? k = 1i32 ?> (1.0 / 6.0) / 2.0
    |? k = 2i32 ?> (0.0 - 1.0 / 30.0) / 24.0
    |? k = 3i32 ?> (1.0 / 42.0) / 720.0
    |? k = 4i32 ?> (0.0 - 1.0 / 30.0) / 40320.0
    |? k = 5i32 ?> (5.0 / 66.0) / 3628800.0
    |: bernoulli_high k

:~ ^ head_sum (s : complex) (n : i32) (last : i32) (acc : complex) : complex =
    ? n > last
    ?> acc
    |: head_sum s (n + 1i32) last (c_add acc (power_neg (conv n) s))

:~ correction_term (s : complex) (big_n : f64) (k : i32) (rising : complex) : complex =
    := power = power_neg big_n { re = s::re + 2.0 * (conv k : f64) - 1.0; im = s::im }
    c_scale (bernoulli_over_factorial k) (c_mul rising power)

:~ next_rising (s : complex) (k : i32) (rising : complex) : complex =
    := j : f64 = conv (2i32 * k)
    c_mul (c_mul rising { re = s::re + j - 1.0; im = s::im }) { re = s::re + j; im = s::im }

:~ ^ correction_sum (s : complex) (big_n : f64) (k : i32) (rising : complex) (acc : complex) : complex =
    ? k > 10i32
    ?> acc
    |: correction_sum s big_n (k + 1i32) (next_rising s k rising) (c_add acc (correction_term s big_n k rising))

:~ em_parts (s : complex) (shifted : f64) : complex * complex =
    := n_s = power_neg shifted s
    c_div (c_scale shifted n_s) { re = s::re - 1.0; im = s::im }, c_add (c_scale 0.5 n_s) (correction_sum s shifted 1i32 s { re = 0.0; im = 0.0 })

:~ zeta_em_terms (count : i32) (s : complex) : complex =
    := head = head_sum s 1i32 (count - 1i32) { re = 0.0; im = 0.0 }
    := tail_integral, rest = em_parts s (conv count)
    c_add (c_add head tail_integral) rest

:~ zeta_em (s : complex) : complex = zeta_em_terms 30i32 s

:~ terms_for (t : f64) : i32 = conv (t / pi + 20.0)

:~ hardy_z_far (t : f64) : f64 =
    := z = zeta_em_terms (terms_for t) { re = 0.5; im = t }
    := th = theta t
    cos th * z::re - sin th * z::im

:~ gabcke_bound (t : f64) : f64 = 0.053 * exp (0.0 - 1.25 * log t)

:~ hardy_z_signed (t : f64) : f64 =
    ? t < 200.0
    ?> hardy_z_far t
    |:
        := r = riemann_siegel_z t
        ? distance r 0.0 > gabcke_bound t ?> r |: hardy_z_far t

:~ hardy_z (t : f64) : f64 =
    := z = zeta_em { re = 0.5; im = t }
    := th = theta t
    cos th * z::re - sin th * z::im

:~ ^ bisect_em (lo : f64) (hi : f64) (z_lo : f64) (left : i32) : f64 =
    := mid = (lo + hi) / 2.0
    ? left <= 0i32
    ?> mid
    |:
        := z_mid = hardy_z mid
        ? (z_lo < 0.0) = (z_mid < 0.0) ?> bisect_em mid hi z_mid (left - 1i32) |: bisect_em lo mid z_lo (left - 1i32)

:~ zero_em (t : f64) : f64 = bisect_em (t - 0.01) (t + 0.01) (hardy_z (t - 0.01)) 60i32

:~ worse_em (worst : f64) (z : f64) : f64 =
    := miss = distance (zero_em z) z
    ? miss > worst ?> miss |: worst

:= precise_zeros () : list f64 =
    [
        14.1347251417346937904; 21.0220396387715549926; 25.0108575801456887632; 30.4248761258595132103
        32.9350615877391896906; 37.5861781588256712572; 40.9187190121474951873; 43.3270732809149995194
        48.0051508811671597279; 49.7738324776723021819
    ]

///> rust
///> gleam
:# euler_maclaurin_zeta_gives_pi_squared_over_six_at_two =
    := two = zeta_em { re = 2.0; im = 0.0 }
    (distance two::re (pi * pi / 6.0) < 0.000000000001) |> _assert_eq !+

///> rust
///> gleam
:# euler_maclaurin_zeta_gives_minus_one_twelfth_at_minus_one =
    := minus_one = zeta_em { re = 0.0 - 1.0; im = 0.0 }
    (distance minus_one::re (0.0 - 1.0 / 12.0) < 0.000000000001) |> _assert_eq !+

///> rust
///> gleam
:# euler_maclaurin_zeta_matches_a_complex_value =
    := off_axis = zeta_em { re = 2.0; im = 0.0 - 2.0 }
    (distance off_axis::re 0.8673518296 < 0.000000001, distance off_axis::im 0.2751272388 < 0.000000001) |> _assert_eq (!+, !+)

///> rust
///> gleam
:# euler_maclaurin_finds_the_first_ten_zeros_to_a_billionth =
    ((precise_zeros () |> listm::fold worse_em 0.0) < 0.000000001) |> _assert_eq !+

:~ c_exp (z : complex) : complex =
    := m = exp z::re
    { re = m * cos z::im; im = m * sin z::im }

:~ c_log (z : complex) : complex = { re = log (sqrt (z::re * z::re + z::im * z::im)); im = math::atan2 z::im z::re }

:~ c_sin (z : complex) : complex =
    := up = exp z::im
    := down = exp (0.0 - z::im)
    { re = sin z::re * (up + down) / 2.0; im = cos z::re * (up - down) / 2.0 }

:~ real_power (a : f64) (s : complex) : complex = c_exp (c_scale (log a) s)

:~ stirling_coefficient (k : i32) : f64 =
    ? k = 1i32 ?> 1.0 / 12.0
    |? k = 2i32 ?> 0.0 - 1.0 / 360.0
    |? k = 3i32 ?> 1.0 / 1260.0
    |? k = 4i32 ?> 0.0 - 1.0 / 1680.0
    |? k = 5i32 ?> 1.0 / 1188.0
    |? k = 6i32 ?> 0.0 - 691.0 / 360360.0
    |? k = 7i32 ?> 1.0 / 156.0
    |: 0.0 - 3617.0 / 122400.0

:~ ^ inverse_power_sum (inv_sq : complex) (k : i32) (power : complex) (acc : complex) : complex =
    ? k > 8i32
    ?> acc
    |: inverse_power_sum inv_sq (k + 1i32) (c_mul power inv_sq) (c_add acc (c_scale (stirling_coefficient k) power))

:~ stirling_main (z : complex) : complex = c_sub (c_mul { re = z::re - 0.5; im = z::im } (c_log z)) z

:~ stirling_log_gamma (z : complex) : complex =
    := inv = c_div { re = 1.0; im = 0.0 } z
    := inv_sq = c_mul inv inv
    := main = stirling_main z
    := constant = { re = log (two_pi ()) / 2.0; im = 0.0 }
    c_add (c_add main constant) (inverse_power_sum inv_sq 1i32 inv { re = 0.0; im = 0.0 })

:~ ^ log_gamma_shifted (z : complex) (acc : complex) : complex =
    ? z::re >= 10.0
    ?> c_sub (stirling_log_gamma z) acc
    |: log_gamma_shifted { re = z::re + 1.0; im = z::im } (c_add acc (c_log z))

:~ gamma (z : complex) : complex = c_exp (log_gamma_shifted z { re = 0.0; im = 0.0 })

:~ terminates (s : complex) : bool =
    := whole : i32 = conv s::re
    s::im = 0.0 && s::re < 0.0 && s::re >= 0.0 - 18.0 && (conv whole : f64) = s::re

:~ zeta_balanced (s : complex) : complex =
    ? terminates s
    ?> zeta_em_terms 1i32 s
    |: ? s::re < 0.0 ?> zeta_em_terms (conv (8.0 + distance s::im 0.0 / 2.0)) s |: zeta_em s

:~ reflected_zeta (s : complex) : complex =
    := one_minus = { re = 1.0 - s::re; im = 0.0 - s::im }
    := factor =
        c_mul (c_mul (real_power 2.0 s) (real_power pi { re = s::re - 1.0; im = s::im })) (c_sin (c_scale (pi / 2.0) s))
    c_mul (c_mul factor (gamma one_minus)) (zeta_balanced one_minus)

:~ c_distance (a : complex) (b : complex) : f64 =
    := d = c_sub a b
    sqrt (d::re * d::re + d::im * d::im)

:~ reflects (ok : bool) (s : complex) : bool = ok && c_distance (zeta_em s) (reflected_zeta s) < 0.000000000001

:~ vanishes (ok : bool) (n : f64) : bool =
    ok && c_distance (zeta_balanced { re = 0.0 - n; im = 0.0 }) { re = 0.0; im = 0.0 } < 0.000000000001

///> rust
///> gleam
:# complex_gamma_matches_its_closed_forms =
    := half = gamma { re = 0.5; im = 0.0 }
    := five = gamma { re = 5.0; im = 0.0 }
    (distance half::re (sqrt pi) < 0.000000000001, distance five::re 24.0 < 0.00000000001) |> _assert_eq (!+, !+)

:= reflection_points () : list complex =
    [
        { re = 0.3; im = 5.0 }; { re = 0.25; im = 0.0 - 3.0 }; { re = 0.0 - 1.5; im = 2.0 }; { re = 3.0; im = 4.0 }
        { re = 2.5; im = 0.0 - 3.5 }; { re = 1.5; im = 2.5 }; { re = 0.5; im = 14.134725 }
    ]

///> rust
///> gleam
:# the_functional_equation_holds_off_the_line =
    reflection_points () |> listm::fold reflects !+ |> _assert_eq !+

///> rust
///> gleam
:# the_trivial_zeros_vanish =
    [ 2.0; 4.0; 6.0; 8.0; 18.0 ] |> listm::fold vanishes !+ |> _assert_eq !+

///> rust
///> gleam
:# zeta_is_conjugate_symmetric =
    := upper = zeta_em { re = 0.3; im = 7.0 }
    := lower = zeta_em { re = 0.3; im = 0.0 - 7.0 }
    (c_distance upper { re = lower::re; im = 0.0 - lower::im } < 0.000000000001) |> _assert_eq !+

:~ ^ sign_changes (t : f64) (stop : f64) (step : f64) (previous : f64) (count : i32) : i32 =
    ? t > stop
    ?> count
    |:
        := current = hardy_z_signed t
        := flipped = (previous < 0.0) <> (current < 0.0)
        sign_changes (t + step) stop step current (? flipped ?> count + 1i32 |: count)

:~ zeros_up_to (stop : f64) : i32 = sign_changes 10.05 stop 0.05 (hardy_z_signed 10.0) 0i32

:~ near_n_of_t (counted : i32) (stop : f64) (slack : f64) : bool = distance (conv counted : f64) (theta stop / pi + 1.0) < slack

///> rust
///> gleam
:# the_zeros_below_one_hundred_are_counted_by_sign_changes_and_match_n_of_t =
    := counted = zeros_up_to 100.0
    (counted, near_n_of_t counted 100.0 0.5) |> _assert_eq (29i32, !+)

///> rust
:# the_zeros_below_one_thousand_count_to_six_hundred_forty_nine =
    := counted = zeros_up_to 1000.0
    (counted, near_n_of_t counted 1000.0 1.0) |> _assert_eq (649i32, !+)

:~ ^ gram_newton (target : f64) (t : f64) (left : i32) : f64 =
    ? left <= 0i32
    ?> t
    |: gram_newton target (t - (theta t - target) / (0.5 * log (t / two_pi ()))) (left - 1i32)

:~ gram_point (n : i32) : f64 = gram_newton ((conv n : f64) * pi) (18.0 + 2.5 * (conv n : f64)) 60i32

:~ gram_law_holds (n : i32) : bool =
    := z = hardy_z_signed (gram_point n)
    ? n % 2i32 = 0i32 ?> z > 0.0 |: z < 0.0

:~ ^ first_gram_failure (n : i32) (stop : i32) : i32 =
    ? n > stop ?> 0i32 - 1i32 |? gram_law_holds n ?> first_gram_failure (n + 1i32) stop |: n

///> rust
///> gleam
:# gram_points_solve_theta =
    (distance (gram_point 0i32) 17.8455995405 < 0.00000001, distance (theta (gram_point 1i32)) pi < 0.000000001) |> _assert_eq (!+, !+)

///> rust
///> gleam
:# grams_law_first_fails_at_one_hundred_twenty_six =
    first_gram_failure 0i32 130i32 |> _assert_eq 126i32

:~ good_gram (n : i32) : bool = gram_law_holds n

:~ ^ next_good (n : i32) : i32 = ? good_gram (n + 1i32) ?> n + 1i32 |: next_good (n + 1i32)

:~ ^ changes_from (a : f64) (step : f64) (i : i32) (pieces : i32) (previous : f64) (count : i32) : i32 =
    ? i > pieces
    ?> count
    |:
        := current = hardy_z_signed (a + step * (conv i : f64))
        := flipped = (previous < 0.0) <> (current < 0.0)
        changes_from a step (i + 1i32) pieces current (? flipped ?> count + 1i32 |: count)

:~ changes_between (a : f64) (b : f64) (pieces : i32) : i32 =
    changes_from a ((b - a) / (conv pieces : f64)) 1i32 pieces (hardy_z_signed a) 0i32

:~ ^ adaptive_changes (a : f64) (b : f64) (need : i32) (pieces : i32) : i32 =
    := found = changes_between a b pieces
    ? found >= need || pieces > 10000i32 ?> found |: adaptive_changes a b need (pieces * 10i32)

:~ block_changes (n : i32) (m : i32) : i32 = adaptive_changes (gram_point n) (gram_point m) (m - n) (60i32 * (m - n))

:~ rosser_holds (n : i32) (m : i32) : bool = block_changes n m >= m - n

:~ ^ block_lower (n : i32) (stop : i32) (acc : i32) : i32 =
    ? n >= stop
    ?> acc
    |:
        := m = next_good n
        block_lower m stop (acc + block_changes n m)

:~ turing_blocks_needed (gp : f64) : f64 =
    := lead = 1.0 / (3.0 * pi) * (log (gp / two_pi ()) + 0.048 * pi * pi / (gp * gp))
    lead * (1.680 + 0.186 * log (log gp) + 0.0314 * log gp)

:~ ^ rosser_blocks (n : i32) (left : i32) : option i32 =
    ? left <= 0i32
    ?> Some n
    |:
        := m = next_good n
        ? rosser_holds n m ?> rosser_blocks m (left - 1i32) |: None

:~ ^ first_good_above (n : i32) (floor : f64) : i32 =
    ? gram_point n >= floor && good_gram n ?> n |: first_good_above (n + 1i32) floor

:~ lower_count (n : i32) : i32 = ? good_gram (0i32 - 1i32) ?> block_lower (0i32 - 1i32) n 0i32 |: 0i32

:~ certified_after (n : i32) (blocks : i32) (lower : i32) (p : i32) : option i32 =
    := enough = (conv blocks : f64) > turing_blocks_needed (gram_point p)
    ? good_gram n && gram_point n >= 653.0 && enough && lower >= n + 1i32 ?> Some lower |: None

:~ certified_count (n : i32) (blocks : i32) : option i32 =
    := lower = lower_count n
    ?= rosser_blocks n blocks ?|
    | Some p => certified_after n blocks lower p
    | None => None

///> rust
:# turing_and_rosser_certify_the_zero_count_at_the_first_good_gram_point_past_653 =
    := n = first_good_above 370i32 653.0
    certified_count n 3i32 |> _assert_eq (Some (n + 1i32))

///> rust
:# the_block_by_block_lower_bound_certifies_past_two_thousand =
    := n = first_good_above 1500i32 2000.0
    certified_count n 3i32 |> _assert_eq (Some (n + 1i32))

///> rust
:# the_zero_count_is_certified_exactly_past_ten_thousand =
    := n = first_good_above 10100i32 10000.0
    (n, certified_count n 3i32) |> _assert_eq (10143i32, Some 10144i32)

///> rust
:# the_zero_count_is_certified_past_one_hundred_thousand_and_matches_odlyzko =
    := n = first_good_above 138060i32 100000.0
    (certified_count n 3i32 = Some (n + 1i32), n + 1i32 >= 138069i32 && n + 1i32 <= 138080i32) |> _assert_eq (!+, !+)

:~ hardy_z_precise (t : f64) : f64 =
    := z = zeta_em_terms (conv (t + 30.0)) { re = 0.5; im = t }
    := th = theta t
    cos th * z::re - sin th * z::im

:~ ^ bisect_precise (lo : f64) (hi : f64) (z_lo : f64) (left : i32) : f64 =
    := mid = (lo + hi) / 2.0
    ? left <= 0i32
    ?> mid
    |:
        := z_mid = hardy_z_precise mid
        ? (z_lo < 0.0) = (z_mid < 0.0)
        ?> bisect_precise mid hi z_mid (left - 1i32)
        |: bisect_precise lo mid z_lo (left - 1i32)

:~ zero_precise (t : f64) : f64 = bisect_precise (t - 0.01) (t + 0.01) (hardy_z_precise (t - 0.01)) 60i32

:~ worse_precise (worst : f64) (z : f64) : f64 =
    := miss = distance (zero_precise z) z
    ? miss > worst ?> miss |: worst

:= odlyzko_first_hundred () : list f64 =
    [
        14.134725141734693; 21.022039638771554; 25.010857580145688; 30.424876125859513; 32.935061587739189
        37.586178158825671; 40.918719012147495; 43.327073280914999; 48.005150881167159; 49.773832477672302
        52.970321477714460; 56.446247697063394; 59.347044002602353; 60.831778524609809; 65.112544048081606
        67.079810529494173; 69.546401711173979; 72.067157674481907; 75.704690699083933; 77.144840068874805
