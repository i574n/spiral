///> rust
:# the_first_hundred_zeros_match_the_published_table_to_a_ten_billionth =
    := zeros = odlyzko_first_hundred ()
    (listm::length zeros : i32, (zeros |> listm::fold worse_precise 0.0) < 0.0000000001) |> _assert_eq (100i32, !+)

:= first_hundred_provenance () =
    {
        source = "https://www.lmfdb.org/zeros/zeta/list?N=1&limit=100"
        retrieved = "2026-11-14"
        rendering = "each LMFDB ordinate truncated to 15 decimals"
        fingerprint = "1c040572d10622f58a53b6e15e8b645643129e8c95c4d9aa51f0936e6dc9303d"
    }

:~ fixed_point_e12 (t : f64) : i64 = conv (t * 1000000000000.0 + 0.5)

:~ first_hundred_text () : string = odlyzko_first_hundred () |> listm::map (fixed_point_e12 >> sm'::show) |> sm'::concat_list (~~ "\n")

///> rust -d chrono regex sha2
:# the_first_hundred_zeros_are_the_pinned_lmfdb_rendering =
    := provenance = first_hundred_provenance ()
    first_hundred_text () |> crypto::hash_text |> _assert_eq provenance::fingerprint

:~ ^ hurwitz_head (s : complex) (a : f64) (n : i32) (last : i32) (acc : complex) : complex =
    ? n > last
    ?> acc
    |: hurwitz_head s a (n + 1i32) last (c_add acc (power_neg ((conv n : f64) + a) s))

:~ hurwitz_em_terms (count : i32) (s : complex) (a : f64) : complex =
    := head = hurwitz_head s a 0i32 (count - 1i32) { re = 0.0; im = 0.0 }
    := tail_integral, rest = em_parts s ((conv count : f64) + a)
    c_add (c_add head tail_integral) rest

:~ hurwitz_terms (s : complex) : i32 =
    := height = distance s::im 0.0
    ? terminates s ?> 1i32 |: ? s::re < 0.0 ?> conv (8.0 + height / 2.0) |: 30i32 + conv height

:~ hurwitz_zeta (s : complex) (a : f64) : complex = hurwitz_em_terms (hurwitz_terms s) s a

:~ ^ character_sum (s : complex) (q : i32) (chi : i32 -> f64) (a : i32) (acc : complex) : complex =
    ? a > q
    ?> acc
    |:
        := weight = chi a
        := fraction = (conv a : f64) / (conv q : f64)
        := term = ? weight = 0.0 ?> { re = 0.0; im = 0.0 } |: c_scale weight (hurwitz_zeta s fraction)
        character_sum s q chi (a + 1i32) (c_add acc term)

:~ dirichlet_l (q : i32) (chi : i32 -> f64) (s : complex) : complex =
    c_mul (power_neg (conv q : f64) s) (character_sum s q chi 1i32 { re = 0.0; im = 0.0 })

:~ chi_four (a : i32) : f64 = ? a = 1i32 ?> 1.0 |: ? a = 3i32 ?> 0.0 - 1.0 |: 0.0

:~ principal_one (a : i32) : f64 = 1.0

:~ l_four (x : f64) : f64 =
    := value = dirichlet_l 4i32 chi_four { re = x; im = 0.0 }
    value::re

:~ close_to (expected : f64) (value : f64) : bool = distance value expected < 0.000000000001

///> rust
///> gleam
:# dirichlet_l_chi_four_gives_catalan_at_two =
    close_to 0.9159655941772190150546035149 (l_four 2.0) |> _assert_eq !+

///> rust
///> gleam
:# dirichlet_l_of_the_principal_character_gives_zeta_two =
    := zeta_two = dirichlet_l 1i32 principal_one { re = 2.0; im = 0.0 }
    close_to (pi * pi / 6.0) zeta_two::re |> _assert_eq !+

///> rust
///> gleam
:# dirichlet_l_gives_euler_numbers_at_non_positive_integers =
    (close_to 0.5 (l_four 0.0), close_to (0.0 - 0.5) (l_four (0.0 - 2.0)), close_to 2.5 (l_four (0.0 - 4.0))) |> _assert_eq (!+, !+, !+)

:~ unit (z : complex) : complex =
    := size = sqrt (z::re * z::re + z::im * z::im)
    { re = z::re / size; im = z::im / size }

:~ rotated_l_four (t : f64) : complex =
    := value = dirichlet_l 4i32 chi_four { re = 0.5; im = t }
    := angle = t / 2.0 * log (4.0 / pi)
    := phase = c_mul (unit (gamma { re = 0.75; im = t / 2.0 })) { re = cos angle; im = sin angle }
    c_mul phase value

:~ hardy_l_four (t : f64) : f64 =
    := rotated = rotated_l_four t
    rotated::re

:~ ^ bisect_l_four (lo : f64) (hi : f64) (z_lo : f64) (left : i32) : f64 =
    := mid = (lo + hi) / 2.0
    ? left <= 0i32
    ?> mid
    |:
        := z_mid = hardy_l_four mid
        ? (z_lo < 0.0) = (z_mid < 0.0)
        ?> bisect_l_four mid hi z_mid (left - 1i32)
        |: bisect_l_four lo mid z_lo (left - 1i32)

:~ zero_l_four (t : f64) : f64 = bisect_l_four (t - 0.01) (t + 0.01) (hardy_l_four (t - 0.01)) 60i32

:~ worse_l_four (worst : f64) (z : f64) : f64 =
    := miss = distance (zero_l_four z) z
    ? miss > worst ?> miss |: worst

:~ real_on_the_line (ok : bool) (t : f64) : bool =
    := rotated = rotated_l_four t
    ok && distance rotated::im 0.0 < 0.000000000001

:= lmfdb_l_four_zeros () : list f64 =
    [
        6.02094890469759665490; 10.2437703041665545521; 12.9880980123124225075; 16.3426071045872221950
        18.2919931961235348385
    ]

///> rust
///> gleam
:# the_first_five_zeros_of_l_chi_four_match_lmfdb_to_a_ten_billionth =
    ((lmfdb_l_four_zeros () |> listm::fold worse_l_four 0.0) < 0.0000000001) |> _assert_eq !+

///> rust
///> gleam
:# the_rotated_l_chi_four_is_real_on_the_critical_line =
    [ 3.0; 7.5; 14.0; 21.0 ] |> listm::fold real_on_the_line !+ |> _assert_eq !+

:= two_thirds_paper () =
    {
        title = "More than two thirds of the zeros of the Riemann zeta function are simple and on the critical line"
        date = "2026-08-11"
        source = "https://www.anthropic.com/research/riemann-zeta"
        lean = "https://github.com/anthropics/zeta-23-lean (tag v1.0)"
    }

:~ montgomery_taylor_inverse () : f64 =
    := x = 1.0 / sqrt 2.0
    0.5 + x * cos x / sin x

///> rust
///> gleam
:# the_montgomery_taylor_constant_of_the_two_thirds_paper_reproduces =
    close_to 1.32749929632059 (montgomery_taylor_inverse ()) |> _assert_eq !+

///> rust
///> gleam
:# the_two_thirds_paper_proportions_reproduce =
    := c = montgomery_taylor_inverse ()
    (close_to 0.672500703679412 (2.0 - c), close_to 0.836250351839706 (0.5 * (3.0 - c))) |> _assert_eq (!+, !+)

///> rust
///> gleam
:# the_montgomery_taylor_proportions_clear_two_thirds_and_five_sixths =
    := c = montgomery_taylor_inverse ()
    (2.0 - c > 2.0 / 3.0, 0.5 * (3.0 - c) > 5.0 / 6.0) |> _assert_eq (!+, !+)

:~ ^ zero_terms (x : f64) (left : i32) (zeros : list f64) (acc : f64) : f64 =
    ?= zeros ?|
    | [] => acc
    | y :: rest =>
        ? left <= 0i32
        ?> acc
        |: zero_terms x (left - 1i32) rest (acc + sqrt x / (0.25 + y * y) * (0.5 * cos (y * log x) + y * sin (y * log x)))

:~ psi_from_zeros (x : f64) (count : i32) : f64 =
    x - 2.0 * zero_terms x count (odlyzko_first_hundred ()) 0.0 - log (2.0 * pi) - 0.5 * log (1.0 - 1.0 / (x * x))

:~ ^ least_divisor (n : i64) (d : i64) : i64 = ? d * d > n ?> n |? n % d = 0i64 ?> d |: least_divisor n (d + 1i64)

:~ ^ strip_factor (n : i64) (p : i64) : i64 = ? n % p = 0i64 ?> strip_factor (n / p) p |: n

:~ mangoldt_at (n : i64) : f64 =
    := p = least_divisor n 2i64
    ? strip_factor n p = 1i64 ?> log (conv p : f64) |: 0.0

:~ ^ psi_upto (n : i64) (k : i64) (acc : f64) : f64 = ? k > n ?> acc |: psi_upto n (k + 1i64) (acc + mangoldt_at k)

:~ psi_from_primes (x : f64) : f64 = psi_upto (conv x : i64) 2i64 0.0

:~ explicit_gap (count : i32) (x : f64) : f64 = distance (psi_from_zeros x count) (psi_from_primes x)

:~ explicit_points () : list f64 = [ 10.5; 30.5; 50.5; 100.5 ]

:~ worst_gap (count : i32) : f64 = explicit_points () |> listm::fold (\ w x => ? explicit_gap count x > w ?> explicit_gap count x |: w) 0.0

:~ total_gap (count : i32) : f64 = explicit_points () |> listm::fold (\ s x => s + explicit_gap count x) 0.0

///> rust
///> gleam
:# the_explicit_formula_over_the_pinned_zeros_reproduces_chebyshev_psi =
    (worst_gap 100i32 < 1.25, total_gap 100i32 < total_gap 10i32) |> _assert_eq (!+, !+)

:~ fejer_h (l : f64) (r : f64) : f64 =
    := x = l * r / 2.0
    ? distance x 0.0 < 0.000000000001 ?> 1.0 |: (sin x / x) * (sin x / x)

:~ fejer_h_imag (l : f64) (y : f64) : f64 =
    := x = l * y / 2.0
    := s = (exp x - exp (0.0 - x)) / 2.0
    (s / x) * (s / x)

:~ fejer_g (l : f64) (u : f64) : f64 =
    := a = distance u 0.0
    ? a >= l ?> 0.0 |: (1.0 - a / l) / l

:~ ^ digamma_shift (x : f64) (y : f64) (acc : f64) : f64 * f64 =
    ? x >= 20.0 ?> (x, acc) |: digamma_shift (x + 1.0) y (acc - x / (x * x + y * y))

:~ even_powers (a : f64) (b : f64) : f64 * f64 * f64 =
    := a2 = a * a - b * b
    := b2 = 2.0 * a * b
    := a4 = a2 * a2 - b2 * b2
    := b4 = 2.0 * a2 * b2
    a2, a4, a4 * a2 - b4 * b2

:~ digamma_re (x0 : f64) (y : f64) : f64 =
    := x, acc = digamma_shift x0 y 0.0
    := r2 = x * x + y * y
    := a = x / r2
    := a2, a4, a6 = even_powers a (0.0 - y / r2)
    acc + 0.5 * log r2 - 0.5 * a - a2 / 12.0 + a4 / 120.0 - a6 / 252.0

:~ ^ weil_integral_from (l : f64) (r : f64) (acc : f64) : f64 =
    ? r > 20000.0 ?> acc |: weil_integral_from l (r + 0.01) (acc + fejer_h l r * digamma_re 0.25 (r / 2.0))

:~ weil_integral (l : f64) : f64 = 2.0 * weil_integral_from l 0.005 0.0 * 0.01 / (2.0 * pi)

:~ ^ weil_primes_from (l : f64) (n : i64) (acc : f64) : f64 =
    := ln = log (conv n : f64)
    ? ln >= l ?> acc |: weil_primes_from l (n + 1i64) (acc + mangoldt_at n / sqrt (conv n : f64) * fejer_g l ln)

:~ ^ weil_zeros (l : f64) (zeros : list f64) (acc : f64) : f64 =
    ?= zeros ?|
    | [] => acc
    | y :: rest => weil_zeros l rest (acc + 2.0 * fejer_h l y)

:~ weil_right (l : f64) : f64 =
    2.0 * fejer_h_imag l 0.5 - fejer_g l 0.0 * log pi + weil_integral l - 2.0 * weil_primes_from l 2i64 0.0

///> rust
:# weils_explicit_formula_balances_the_pinned_zeros_against_the_primes =
    := l = 3.5
    := left = weil_zeros l (odlyzko_first_hundred ()) 0.0
    := right = weil_right l
    (distance left right < 0.002, left > 0.004) |> _assert_eq (!+, !+)
