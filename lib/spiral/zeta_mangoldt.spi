:# zeta_mangoldt static =
    :< testing

:< zeta_nat
:< zeta_prime

:= zeta_runtime_i64_add (left : i64) (right : i64) : i64 = !!!!Add(left, right)

:= zeta_runtime_mul_i64 (left : i64) (right : i64) : i64 =
    !!!!Mult(left, right)

:= ^ positive_positional_nat_to_i64 \* bits.
    (value : positive_positional_nat bits) : i64 =
    ?= value ?|
    | PositivePositionalOne => 1i64
    | PositivePositionalZeroBit tail =>
        zeta_runtime_mul_i64 2i64 (positive_positional_nat_to_i64 tail)
    | PositivePositionalOneBit tail =>
        zeta_runtime_i64_add 1i64 (zeta_runtime_mul_i64 2i64 (positive_positional_nat_to_i64 tail))

:= zeta_runtime_sub_i64 (left : i64) (right : i64) : i64 = !!!!Sub(left, right)

:= zeta_runtime_add_closure_i64 (left : i64) (right : i64) : i64 = !!!!Add(left, right)

:= ival_sealed_composite_children_runtime \* natural divisor quotient.
    (children : ival_sealed_composite_children natural divisor quotient)
    : i64 * i64 =
    ?= children ?|
    | CertifiedIntervalPositivePositionalSealedCompositeChildren payload =>
        := \? length.
            _, divisor_value, quotient_value, _, _, _ = payload
        positive_positional_nat_to_i64 divisor_value,
        positive_positional_nat_to_i64 quotient_value

:= ^ ival_complete_factorization_runtime \* natural.
    (tree : ival_complete_factorization_tree natural)
    : i64 * i64 * i64 * i64 =
    ?= tree ?|
    | CertifiedIntervalPositivePositionalCompleteUnit =>
        1i64, 0i64, 0i64, 1i64
    | CertifiedIntervalPositivePositionalCompletePrime payload =>
        := \? length. prime_value, _, _, _ = payload
        1i64, 1i64, 0i64, positive_positional_nat_to_i64 prime_value
    | CertifiedIntervalPositivePositionalCompleteSplit payload =>
        := \? length divisor quotient.
            root_value, _, _, _, _, _, _, left, right, _ = payload
        := left_nodes, left_primes, left_splits, _ =
            ival_complete_factorization_runtime left
        := right_nodes, right_primes, right_splits, _ =
            ival_complete_factorization_runtime right
        zeta_runtime_add_closure_i64 1i64
            (zeta_runtime_add_closure_i64 left_nodes right_nodes),
        zeta_runtime_add_closure_i64 left_primes right_primes,
        zeta_runtime_add_closure_i64 1i64
            (zeta_runtime_add_closure_i64 left_splits right_splits),
        positive_positional_nat_to_i64 root_value

:= ^ ival_complete_reconstruction_runtime \* natural.
    (certificate : ival_complete_reconstruction natural)
    : i64 * i64 * i64 * i64 * i64 * i64 =
    ?= certificate ?|
    | CertifiedIntervalPositivePositionalCompleteReconstructionUnit =>
        1i64, 0i64, 0i64, 0i64, 1i64, 1i64
    | CertifiedIntervalPositivePositionalCompleteReconstructionPrime payload =>
        := \? length. prime_value, _, _, _ = payload
        := value = positive_positional_nat_to_i64 prime_value
        1i64, 1i64, 0i64, 0i64, value, value
    | CertifiedIntervalPositivePositionalCompleteReconstructionSplit payload =>
        := \? divisor quotient.
            root_value, _, _, _, left, right, _ = payload
        := left_nodes, left_primes, left_splits, left_descents, _, left_product =
            ival_complete_reconstruction_runtime left
        := right_nodes, right_primes, right_splits, right_descents, _, right_product =
            ival_complete_reconstruction_runtime right
        zeta_runtime_add_closure_i64 1i64
            (zeta_runtime_add_closure_i64 left_nodes right_nodes),
        zeta_runtime_add_closure_i64 left_primes right_primes,
        zeta_runtime_add_closure_i64 1i64
            (zeta_runtime_add_closure_i64 left_splits right_splits),
        zeta_runtime_add_closure_i64 2i64
            (zeta_runtime_add_closure_i64 left_descents right_descents),
        positive_positional_nat_to_i64 root_value,
        zeta_runtime_mul_i64 left_product right_product

:= ival_complete_prime_sequence_cell_runtime
    (cell : ival_complete_prime_sequence_cell)
    : i64 =
    ?= cell ?|
    | CertifiedIntervalPositivePositionalCompletePrimeSequenceCell payload =>
        := \? natural length. prime_value, _, _, _ = payload
        positive_positional_nat_to_i64 prime_value

:= ^ ival_complete_prime_sequence_runtime
    (sequence : ival_complete_prime_sequence)
    : i64 * i64 * i64 * i64 =
    ?= sequence ?|
    | CertifiedIntervalPositivePositionalCompletePrimeSequenceDone =>
        0i64, 1i64, 0i64, 0i64
    | CertifiedIntervalPositivePositionalCompletePrimeSequenceMore (head, tail) =>
        := value =
            ival_complete_prime_sequence_cell_runtime head
        := tail_count, tail_product, tail_first, tail_order_mismatches =
            ival_complete_prime_sequence_runtime tail
        := local_order_mismatch : i64 =
            := test_0 = !!!!EQ(tail_count, 0i64)
            := test_1 = !!!!LTE(value, tail_first)
            := test_any = ? test_0 ?> !+ |? test_1 ?> !+ |: !-
            ? test_any ?> 0i64 |: 1i64
        zeta_runtime_add_closure_i64 1i64 tail_count,
        zeta_runtime_mul_i64 value tail_product,
        value,
        zeta_runtime_add_closure_i64 local_order_mismatch tail_order_mismatches

:= ^ ival_prime_multiplicity_counted_run_runtime \* head count.
    (run : ival_prime_multiplicity_counted_run_from head count) : i64 =
    ?= run ?|
    | CertifiedIntervalPositivePositionalPrimeMultiplicityCountedRunLast _ => 1i64
    | CertifiedIntervalPositivePositionalPrimeMultiplicityCountedRunMore payload =>
        := \? next. _, _, tail = payload
        zeta_runtime_add_closure_i64 1i64
            (ival_prime_multiplicity_counted_run_runtime tail)

:= ival_prime_multiplicity_exact_count_runtime \* head.
    (run : ival_prime_multiplicity_run_from head) : i64 =
    ?= index_ival_prime_multiplicity_exact_count run ?|
    | CertifiedIntervalPositivePositionalAnyPrimeMultiplicityCountedRun payload =>
        := \? count. counted = payload
        ival_prime_multiplicity_counted_run_runtime counted

:= ival_prime_multiplicity_normal_form_first_exact_count
    (normal : ival_prime_multiplicity_normal_form) : i64 =
    ?= normal ?|
    | CertifiedIntervalPositivePositionalPrimeMultiplicityNormalFormDone => 0i64
    | CertifiedIntervalPositivePositionalPrimeMultiplicityNormalFormSome payload =>
        := \? head. grouped = payload
        ?= grouped ?|
        | CertifiedIntervalPositivePositionalPrimeMultiplicityNormalFormLast run =>
            ival_prime_multiplicity_exact_count_runtime run
        | CertifiedIntervalPositivePositionalPrimeMultiplicityNormalFormMore payload =>
            := \? next. run, _, _ = payload
            ival_prime_multiplicity_exact_count_runtime run

:= ^ ival_prime_multiplicity_normal_form_total_exact_count_from \* head.
    (normal : ival_prime_multiplicity_normal_form_from head) : i64 =
    ?= normal ?|
    | CertifiedIntervalPositivePositionalPrimeMultiplicityNormalFormLast run =>
        ival_prime_multiplicity_exact_count_runtime run
    | CertifiedIntervalPositivePositionalPrimeMultiplicityNormalFormMore payload =>
        := \? next. run, _, tail = payload
        zeta_runtime_add_closure_i64
            (ival_prime_multiplicity_exact_count_runtime run)
            (ival_prime_multiplicity_normal_form_total_exact_count_from tail)

:= ival_prime_multiplicity_normal_form_total_exact_count
    (normal : ival_prime_multiplicity_normal_form) : i64 =
    ?= normal ?|
    | CertifiedIntervalPositivePositionalPrimeMultiplicityNormalFormDone => 0i64
    | CertifiedIntervalPositivePositionalPrimeMultiplicityNormalFormSome payload =>
        := \? head. grouped = payload
        ival_prime_multiplicity_normal_form_total_exact_count_from grouped

:= ^ ival_prime_multiplicity_run_from_runtime \* head.
    (run : ival_prime_multiplicity_run_from head)
    : i64 * i64 * i64 =
    ?= run ?|
    | CertifiedIntervalPositivePositionalPrimeMultiplicityRunLast cell =>
        := value =
            positive_positional_nat_to_i64 (
                ival_indexed_prime_cell_value cell)
        1i64, value, value
    | CertifiedIntervalPositivePositionalPrimeMultiplicityRunMore payload =>
        := \? next. cell, _, tail = payload
        := value =
            positive_positional_nat_to_i64 (
                ival_indexed_prime_cell_value cell)
        := tail_count, _, tail_product =
            ival_prime_multiplicity_run_from_runtime tail
        zeta_runtime_add_closure_i64 1i64 tail_count,
        value,
        zeta_runtime_mul_i64 value tail_product

:= ^ ival_prime_multiplicity_normal_form_from_runtime \* head.
    (normal : ival_prime_multiplicity_normal_form_from head)
    : i64 * i64 * i64 * i64 * i64 * i64 * i64 =
    ?= normal ?|
    | CertifiedIntervalPositivePositionalPrimeMultiplicityNormalFormLast run =>
        := multiplicity, prime_value, product =
            ival_prime_multiplicity_run_from_runtime run
        1i64, multiplicity, product, prime_value, prime_value, multiplicity, 0i64
    | CertifiedIntervalPositivePositionalPrimeMultiplicityNormalFormMore payload =>
        := \? next. run, _, rest = payload
        := multiplicity, prime_value, product =
            ival_prime_multiplicity_run_from_runtime run
        := groups, cells, tail_product, tail_first, tail_last, tail_max, tail_mismatches =
            ival_prime_multiplicity_normal_form_from_runtime rest
        := local_max : i64 = ? !!!!GTE(multiplicity, tail_max) ?> multiplicity |: tail_max
        := local_mismatch : i64 = ? !!!!LT(prime_value, tail_first) ?> 0i64 |: 1i64
        zeta_runtime_add_closure_i64 1i64 groups,
        zeta_runtime_add_closure_i64 multiplicity cells,
        zeta_runtime_mul_i64 product tail_product,
        prime_value,
        tail_last,
        local_max,
        zeta_runtime_add_closure_i64 local_mismatch tail_mismatches

:= ival_prime_multiplicity_normal_form_runtime
    (normal : ival_prime_multiplicity_normal_form)
    : i64 * i64 * i64 * i64 * i64 * i64 * i64 =
    ?= normal ?|
    | CertifiedIntervalPositivePositionalPrimeMultiplicityNormalFormDone =>
        0i64, 0i64, 1i64, 0i64, 0i64, 0i64, 0i64
    | CertifiedIntervalPositivePositionalPrimeMultiplicityNormalFormSome payload =>
        := \? head. grouped = payload
        ival_prime_multiplicity_normal_form_from_runtime grouped

:= ^ ival_ordered_prime_sequence_from_runtime \* head.
    (sequence : ival_ordered_prime_sequence_from head)
    : i64 * i64 * i64 * i64 * i64 =
    ?= sequence ?|
    | CertifiedIntervalPositivePositionalOrderedPrimeSequenceLast cell =>
        := value =
            positive_positional_nat_to_i64 (
                ival_indexed_prime_cell_value cell)
        1i64, value, value, value, 0i64
    | CertifiedIntervalPositivePositionalOrderedPrimeSequenceMore payload =>
        := \? next. cell, _, tail = payload
        := value =
            positive_positional_nat_to_i64 (
                ival_indexed_prime_cell_value cell)
        := tail_count, tail_product, tail_first, tail_last, tail_mismatches =
            ival_ordered_prime_sequence_from_runtime tail
        := local_mismatch : i64 =
            := test_0 = !!!!LTE(value, tail_first)
            ? test_0 ?> 0i64 |: 1i64
        zeta_runtime_add_closure_i64 1i64 tail_count,
        zeta_runtime_mul_i64 value tail_product,
        value,
        tail_last,
        zeta_runtime_add_closure_i64 local_mismatch tail_mismatches

:= ival_ordered_prime_sequence_runtime
    (sequence : ival_ordered_prime_sequence)
    : i64 * i64 * i64 * i64 * i64 =
    ?= sequence ?|
    | CertifiedIntervalPositivePositionalOrderedPrimeSequenceDone =>
        0i64, 1i64, 0i64, 0i64, 0i64
    | CertifiedIntervalPositivePositionalOrderedPrimeSequenceSome payload =>
        := \? head. ordered = payload
        ival_ordered_prime_sequence_from_runtime ordered

