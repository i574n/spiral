:< zeta_nat
:< zeta_prime
:< zeta_mangoldt

:# zeta_mangoldt_runtime static =
    :< testing

:| ^ bits_rt =
    | One
    | Zero : bits_rt
    | OneBit : bits_rt

:~ ^ bits_of (n : u64) : bits_rt =
    ? n <= 1u64 ?> One |? n % 2u64 = 0u64 ?> Zero (bits_of (n / 2u64)) |: OneBit (bits_of (n / 2u64))

:~ ^ value_of (b : bits_rt) : u64 =
    ?= b ?|
    | One => 1u64
    | Zero rest => 2u64 * value_of rest
    | OneBit rest => 2u64 * value_of rest + 1u64

:~ ^ succ_bits (b : bits_rt) : bits_rt =
    ?= b ?|
    | One => Zero One
    | Zero rest => OneBit rest
    | OneBit rest => Zero (succ_bits rest)

:~ ^ add_bits (a : bits_rt) (b : bits_rt) : bits_rt =
    ?= a, b ?|
    | One, _ => succ_bits b
    | _, One => succ_bits a
    | Zero x, Zero y => Zero (add_bits x y)
    | Zero x, OneBit y => OneBit (add_bits x y)
    | OneBit x, Zero y => OneBit (add_bits x y)
    | OneBit x, OneBit y => Zero (succ_bits (add_bits x y))

:~ ^ mul_bits (a : bits_rt) (b : bits_rt) : bits_rt =
    ?= b ?|
    | One => a
    | Zero rest => Zero (mul_bits a rest)
    | OneBit rest => add_bits (Zero (mul_bits a rest)) a

:~ ^ same_bits (a : bits_rt) (b : bits_rt) : bool =
    ?= a, b ?|
    | One, One => !+
    | Zero x, Zero y => same_bits x y
    | OneBit x, OneBit y => same_bits x y
    | _, _ => !-

:~ ^ power_bits (p : bits_rt) (k : u32) : bits_rt = ? k <= 1u32 ?> p |: mul_bits p (power_bits p (k - 1u32))

:== prime_factor = { prime : u64; exponent : u32 }

:== runtime_nf = { root : bits_rt; factors : list prime_factor }

:~ ^ least_factor (n : u64) (d : u64) : u64 = ? d * d > n ?> n |? n % d = 0u64 ?> d |: least_factor n (d + 1u64)

:~ ^ strip_count (n : u64) (p : u64) (k : u32) : u64 * u32 = ? n % p = 0u64 ?> strip_count (n / p) p (k + 1u32) |: n, k

:~ ^ factors_of (n : u64) : list prime_factor =
    ? n <= 1u64
    ?> []
    |:
        := p = least_factor n 2u64
        := rest, k = strip_count n p 0u32
        { prime = p; exponent = k } :: factors_of rest

:~ normal_form_of (n : u64) : runtime_nf = { root = bits_of n; factors = factors_of n }

:~ all_rejected (p : u64) : bool = p >= 2u64 && least_factor p 2u64 = p

:~ ^ strictly_ordered (factors : list prime_factor) : bool =
    ?= factors ?|
    | a :: rest =>
        ?= rest ?|
        | b :: _ => a::prime < b::prime && strictly_ordered rest
        | [] => !+
    | [] => !+

:~ product_bits (factors : list prime_factor) : bits_rt =
    factors |> listm::fold (\ (acc : bits_rt) (f : prime_factor) => mul_bits acc (power_bits (bits_of f::prime) f::exponent)) One

:~ certified (nf : runtime_nf) : bool =
    := primes = nf::factors |> listm::fold (\ (ok : bool) (f : prime_factor) => ok && all_rejected f::prime && f::exponent >= 1u32) !+
    primes && strictly_ordered nf::factors && same_bits (product_bits nf::factors) nf::root

:| prime_power_rt =
    | UnitRt
    | PrimePowerRt : u64 * u32
    | MultiplePrimesRt : i32

:~ decision_of (nf : runtime_nf) : prime_power_rt =
    ?= nf::factors ?|
    | [] => UnitRt
    | f :: [] => PrimePowerRt (f::prime, f::exponent)
    | many => MultiplePrimesRt (listm::length many : i32)

:~ certified_decision (n : u64) : prime_power_rt =
    := nf = normal_form_of n
    ? certified nf ?> decision_of nf |: mega_runtime_fail "zeta-mangoldt-runtime-certificate-rejected"

:~ mangoldt_prime (n : u64) : option u64 =
    ?= certified_decision n ?|
    | PrimePowerRt (p, _) => Some p
    | _ => None

:~ mangoldt_runtime (n : u64) : f64 =
    ?= mangoldt_prime n ?|
    | Some p => log (conv p : f64)
    | None => 0.0

:~ ^ mark_multiples (spf : array_base i32) (p : i32) (j : i32) (limit : i32) : () =
    ? j <= limit
    ?>
        ? am'::index_base j spf = 0i32 ?> am'::set_base spf j p |: ()
        mark_multiples spf p (j + p) limit
    |: ()

:~ ^ sieve_from (spf : array_base i32) (i : i32) (limit : i32) : () =
    ? i <= limit
    ?>
        ? am'::index_base i spf = 0i32
        ?>
            am'::set_base spf i i
            ? i <= 46340i32 ?> mark_multiples spf i (i * i) limit |: ()
        |: ()
        sieve_from spf (i + 1i32) limit
    |: ()

:~ ^ zero_from (spf : array_base i32) (i : i32) (limit : i32) : () =
    ? i <= limit
    ?>
        am'::set_base spf i 0i32
        zero_from spf (i + 1i32) limit
    |: ()

:~ smallest_factors (limit : i32) : array_base i32 =
    := spf : array_base i32 = am'::create_base (limit + 1i32)
    zero_from spf 0i32 limit
    sieve_from spf 2i32 limit
    spf

:~ ^ strip_prime (n : i32) (p : i32) : i32 = ? n % p = 0i32 ?> strip_prime (n / p) p |: n

:~ sieve_prime (spf : array_base i32) (n : i32) : option u64 =
    ? n < 2i32
    ?> None
    |:
        := p = am'::index_base n spf
        ? strip_prime n p = 1i32 ?> Some (conv p : u64) |: None

:~ ^ first_disagreement (spf : array_base i32) (n : i32) (limit : i32) : i32 =
    ? n > limit
    ?> 0i32
    |? sieve_prime spf n = mangoldt_prime (conv n : u64)
    ?> first_disagreement spf (n + 1i32) limit
    |: n

:~ disagreement_up_to (limit : i32) : i32 = first_disagreement (smallest_factors limit) 1i32 limit

///> rust
:# the_runtime_decision_agrees_with_the_static_certified_decision_on_twelve =
    zeta_root_contract () |> ignore
    certified_decision 12u64 |> _assert_eq (MultiplePrimesRt 2i32)

///> rust
:# erased_positional_naturals_round_trip =
    [ 1u64; 2u64; 3u64; 12u64; 1024u64; 999983u64 ] |> listm::map (bits_of >> value_of) |> _assert_eq [ 1u64; 2u64; 3u64; 12u64; 1024u64; 999983u64 ]

///> rust
:# erased_positional_arithmetic_matches_u64 =
    (value_of (add_bits (bits_of 999u64) (bits_of 1u64)), value_of (mul_bits (bits_of 997u64) (bits_of 1009u64))) |> _assert_eq (1000u64, 1005973u64)

///> rust
:# prime_powers_are_decided_with_their_base_and_exponent =
    (certified_decision 1024u64, certified_decision 999983u64) |> _assert_eq (PrimePowerRt (2u64, 10u32), PrimePowerRt (999983u64, 1u32))

///> rust
:# one_is_a_unit_and_thirty_has_three_primes =
    (certified_decision 1u64, certified_decision 30u64) |> _assert_eq (UnitRt, MultiplePrimesRt 3i32)

///> rust
:# a_forged_normal_form_is_rejected =
    certified { root = bits_of 12u64; factors = [ { prime = 2u64; exponent = 1u32 }; { prime = 6u64; exponent = 1u32 } ] } |> _assert_eq !-

///> rust
:# mangoldt_runtime_gives_log_p_on_prime_powers_and_zero_elsewhere =
    (mangoldt_runtime 8u64 = log 2.0, mangoldt_runtime 12u64 = 0.0, mangoldt_runtime 1u64 = 0.0) |> _assert_eq (!+, !+, !+)

///> rust
:# lambda_agrees_with_a_sieve_up_to_ten_thousand =
    disagreement_up_to 10000i32 |> _assert_eq 0i32

///> rust
:# lambda_agrees_with_a_sieve_up_to_one_million =
    disagreement_up_to 1000000i32 |> _assert_eq 0i32
