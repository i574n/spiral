:= positive_positional_predecessor_accessibility_root_value \* natural.
    (accessibility : positive_positional_predecessor_accessibility natural) :
    positive_positional_nat natural =
    ?= accessibility ?|
    | PositivePositionalPredecessorAccessibilityOne _ => PositivePositionalOne
    | PositivePositionalPredecessorAccessibilityStep payload =>
        := \? predecessor. predecessor_proof, _, _ = payload
        positive_positional_predecessor_input_value predecessor_proof

:| positive_positional_parent_derived_child_accessibility child =
    | PositivePositionalParentDerivedChildAccessibility :: \* child.
        (\? parent synthesized_child.
            positive_positional_predecessor_accessibility parent *
            positive_positional_predecessor parent synthesized_child *
            positive_positional_equal synthesized_child child *
            positive_positional_predecessor_accessibility synthesized_child) ->
        positive_positional_parent_derived_child_accessibility child

:= derive_positive_positional_parent_child_accessibility \* parent child.
    (parent_accessibility : positive_positional_predecessor_accessibility parent)
    (child_predecessor : positive_positional_predecessor parent child) :
    positive_positional_parent_derived_child_accessibility child =
    ?= parent_accessibility, child_predecessor ?|
    | PositivePositionalPredecessorAccessibilityStep payload, child_predecessor =>
        := \? synthesized_child. synthesized_predecessor, synthesized_accessibility, _ = payload
        := equal = positive_positional_predecessor_unique synthesized_predecessor child_predecessor
        PositivePositionalParentDerivedChildAccessibility (\? (
            parent_accessibility,
            synthesized_predecessor,
            equal,
            synthesized_accessibility))

