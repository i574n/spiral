    := ok_8 = !!!!EQ(flattened_edges, 0i64)
    := ok_9 = !!!!EQ(quotients_definitionally_shared, 1i64)
    ? ok_0 && ok_1 && ok_2 && ok_3 && ok_4 && ok_5 && ok_6 && ok_7 && ok_8 && ok_9
    ?> ()
    |: mega_runtime_fail "positive-positional-generic-flattened-quotient-chain-runtime-mismatch"

:| ^ positive_positional_transitive_predecessor_path input output =
    | PositivePositionalTransitivePredecessorPathDone :: \* natural.
        positive_positional_nat natural ->
        positive_positional_transitive_predecessor_path natural natural
    | PositivePositionalTransitivePredecessorPathStep :: \* input output.
        (\? middle.
            positive_positional_nat middle *
            positive_positional_predecessor input middle *
            positive_positional_less middle input *
            positive_positional_transitive_predecessor_path middle output) ->
        positive_positional_transitive_predecessor_path input output

:| positive_positional_strict_predecessor_path input output =
    | PositivePositionalStrictPredecessorPathOne :: \* input output.
        positive_positional_nat output *
        positive_positional_predecessor input output *
        positive_positional_less output input ->
        positive_positional_strict_predecessor_path input output
    | PositivePositionalStrictPredecessorPathMore :: \* input output.
        (\? middle.
            positive_positional_nat middle *
            positive_positional_predecessor input middle *
            positive_positional_less middle input *
            positive_positional_transitive_predecessor_path middle output) ->
        positive_positional_strict_predecessor_path input output

:= positive_positional_strict_predecessor_path_to_transitive_path \* input output.
    (path : positive_positional_strict_predecessor_path input output)
    : positive_positional_transitive_predecessor_path input output =
    ?= path ?|
    | PositivePositionalStrictPredecessorPathOne
        (output_value, predecessor, strict_less) =>
        PositivePositionalTransitivePredecessorPathStep (\? (
            output_value,
            predecessor,
            strict_less,
            PositivePositionalTransitivePredecessorPathDone output_value))
    | PositivePositionalStrictPredecessorPathMore payload =>
        := \? middle. middle_value, predecessor, strict_less, tail = payload
        PositivePositionalTransitivePredecessorPathStep (\? (
            middle_value,
            predecessor,
            strict_less,
            tail))

:= ^ positive_positional_transitive_predecessor_path_output_value \* input output.
    (path : positive_positional_transitive_predecessor_path input output)
    : positive_positional_nat output =
    ?= path ?|
    | PositivePositionalTransitivePredecessorPathDone output_value =>
        output_value
    | PositivePositionalTransitivePredecessorPathStep payload =>
        := \? middle. _, _, _, tail = payload
        positive_positional_transitive_predecessor_path_output_value tail

:= positive_positional_transitive_predecessor_path_output_accessibility \* input output.
    (path : positive_positional_transitive_predecessor_path input output)
    : positive_positional_predecessor_accessibility output =
    derive_positive_positional_predecessor_accessibility
        (positive_positional_transitive_predecessor_path_output_value path)

:= ^ positive_positional_accessibility_to_transitive_path \* natural.
    (value : positive_positional_nat natural)
    (accessibility : positive_positional_predecessor_accessibility natural)
    : positive_positional_transitive_predecessor_path natural positional_one =
    ?= accessibility ?|
    | PositivePositionalPredecessorAccessibilityOne _ =>
        PositivePositionalTransitivePredecessorPathDone PositivePositionalOne
    | PositivePositionalPredecessorAccessibilityStep payload =>
        := \? predecessor.
            predecessor_proof, tail, _ = payload
        := predecessor_value =
            positive_positional_predecessor_output_value predecessor_proof
        := predecessor_less =
            positive_positional_predecessor_implies_less predecessor_proof
        PositivePositionalTransitivePredecessorPathStep (\? (
            predecessor_value,
            predecessor_proof,
            predecessor_less,
            positive_positional_accessibility_to_transitive_path
                predecessor_value tail))

:= assert_positive_positional_transitive_predecessor_path_runtime
    (input : i64) (output : i64) (nodes : i64) (edges : i64)
    : ()
    =
    := ok_0 = !!!!EQ(input, 12i64)
    := ok_1 = !!!!EQ(output, 1i64)
    := ok_2 = !!!!EQ(nodes, 12i64)
    := ok_3 = !!!!EQ(edges, 11i64)
    ? ok_0 && ok_1 && ok_2 && ok_3
    ?> ()
    |: mega_runtime_fail "positive-positional-transitive-predecessor-path-runtime-mismatch"

:= ^ positive_positional_transitive_predecessor_path_append \* input bridge output.
    (left : positive_positional_transitive_predecessor_path input bridge)
    (right : positive_positional_transitive_predecessor_path bridge output)
    : positive_positional_transitive_predecessor_path input output =
    ?= left ?|
    | PositivePositionalTransitivePredecessorPathDone _ => right
    | PositivePositionalTransitivePredecessorPathStep payload =>
        := \? next. next_value, predecessor, strict_less, tail = payload
        PositivePositionalTransitivePredecessorPathStep (\? (
            next_value,
            predecessor,
            strict_less,
            positive_positional_transitive_predecessor_path_append tail right))

:= assert_positive_positional_nonidentity_three_segment_path_associativity_runtime
    (left_input : i64) (left_output : i64)
    (left_nodes : i64) (left_edges : i64)
    (right_input : i64) (right_output : i64)
    (right_nodes : i64) (right_edges : i64)
    : ()
    =
    := ok_0 = !!!!EQ(left_input, 4i64)
    := ok_1 = !!!!EQ(left_output, 1i64)
    := ok_2 = !!!!EQ(left_nodes, 4i64)
    := ok_3 = !!!!EQ(left_edges, 3i64)
    := ok_4 = !!!!EQ(right_input, 4i64)
    := ok_5 = !!!!EQ(right_output, 1i64)
    := ok_6 = !!!!EQ(right_nodes, 4i64)
    := ok_7 = !!!!EQ(right_edges, 3i64)
    ? ok_0 && ok_1 && ok_2 && ok_3 && ok_4 && ok_5 && ok_6 && ok_7
    ?> ()
    |: mega_runtime_fail "positive-positional-nonidentity-three-segment-path-associativity-runtime-mismatch"

:= assert_positive_positional_transitive_predecessor_path_append_measure_runtime
    (input : i64) (output : i64)
    (joined_nodes : i64) (joined_edges : i64)
    (expected_nodes : i64) (expected_edges : i64)
    : ()
    =
    := ok_0 = !!!!EQ(input, 4i64)
    := ok_1 = !!!!EQ(output, 1i64)
    := ok_2 = !!!!EQ(joined_nodes, 4i64)
    := ok_3 = !!!!EQ(joined_edges, 3i64)
    := ok_4 = !!!!EQ(joined_nodes, expected_nodes)
    := ok_5 = !!!!EQ(joined_edges, expected_edges)
    ? ok_0 && ok_1 && ok_2 && ok_3 && ok_4 && ok_5
    ?> ()
    |: mega_runtime_fail "positive-positional-transitive-predecessor-path-append-measure-runtime-mismatch"

:= ^ positive_positional_successor_output_value \* input output.
    (successor : positive_positional_successor input output)
    : positive_positional_nat output =
    ?= successor ?|
    | PositivePositionalSuccessorOne =>
        PositivePositionalZeroBit PositivePositionalOne
    | PositivePositionalSuccessorZeroBit tail =>
        PositivePositionalOneBit tail
    | PositivePositionalSuccessorOneBit tail =>
        PositivePositionalZeroBit (
            positive_positional_successor_output_value tail)

:= nonnegative_positional_successor_output_value \* input output.
    (successor : nonnegative_positional_successor input output)
    : nonnegative_positional_nat output =
    ?= successor ?|
    | NonnegativePositionalSuccessorZero =>
        NonnegativePositionalPositive PositivePositionalOne
    | NonnegativePositionalSuccessorPositive positive =>
        NonnegativePositionalPositive (
            positive_positional_successor_output_value positive)

:= assert_ival_sealed_composite_children_runtime
    (first_divisor : i64) (first_quotient : i64)
    (second_divisor : i64) (second_quotient : i64)
    : ()
    =
    := ok_0 = !!!!EQ(first_divisor, 6i64)
    := ok_1 = !!!!EQ(first_quotient, 2i64)
    := ok_2 = !!!!EQ(second_divisor, 9i64)
    := ok_3 = !!!!EQ(second_quotient, 2i64)
    ? ok_0 && ok_1 && ok_2 && ok_3
    ?> ()
    |: mega_runtime_fail "certified-interval-positive-positional-sealed-composite-children-runtime-mismatch"

:= assert_ival_membership_strict_path_runtime
    (first_root : i64) (first_divisor : i64)
    (first_path_nodes : i64) (first_path_edges : i64)
    (first_parent_nodes : i64) (first_parent_edges : i64)
    (first_child_nodes : i64) (first_child_edges : i64)
    (second_root : i64) (second_divisor : i64)
    (second_path_nodes : i64) (second_path_edges : i64)
    (second_parent_nodes : i64) (second_parent_edges : i64)
    (second_child_nodes : i64) (second_child_edges : i64)
    : ()
    =
    := ok_0 = !!!!EQ(first_root, 12i64)
    := ok_1 = !!!!EQ(first_divisor, 6i64)
    := ok_2 = !!!!EQ(first_path_nodes, 7i64)
    := ok_3 = !!!!EQ(first_path_edges, 6i64)
    := ok_4 = !!!!EQ(first_parent_nodes, 12i64)
    := ok_5 = !!!!EQ(first_parent_edges, 11i64)
    := ok_6 = !!!!EQ(first_child_nodes, 6i64)
    := ok_7 = !!!!EQ(first_child_edges, 5i64)
    := term_0 = !!!!Add(first_path_edges, first_child_edges)
    := ok_8 = !!!!EQ(first_parent_edges, term_0)
    := term_1 = !!!!Add(first_path_edges, first_child_nodes)
    := ok_9 = !!!!EQ(first_parent_nodes, term_1)
    := ok_10 = !!!!EQ(second_root, 18i64)
    := ok_11 = !!!!EQ(second_divisor, 9i64)
    := ok_12 = !!!!EQ(second_path_nodes, 10i64)
    := ok_13 = !!!!EQ(second_path_edges, 9i64)
    := ok_14 = !!!!EQ(second_parent_nodes, 18i64)
    := ok_15 = !!!!EQ(second_parent_edges, 17i64)
    := ok_16 = !!!!EQ(second_child_nodes, 9i64)
    := ok_17 = !!!!EQ(second_child_edges, 8i64)
    := term_2 = !!!!Add(second_path_edges, second_child_edges)
    := ok_18 = !!!!EQ(second_parent_edges, term_2)
    := term_3 = !!!!Add(second_path_edges, second_child_nodes)
    := ok_19 = !!!!EQ(second_parent_nodes, term_3)
    ?
        ok_0
        && ok_1
        && ok_2
        && ok_3
        && ok_4
        && ok_5
        && ok_6
        && ok_7
        && ok_8
        && ok_9
        && ok_10
        && ok_11
        && ok_12
        && ok_13
        && ok_14
        && ok_15
        && ok_16
        && ok_17
        && ok_18
        && ok_19
    ?> ()
    |: mega_runtime_fail "certified-interval-positive-positional-membership-strict-path-runtime-mismatch"

:! ival_first_run_multiplicity_shape_last head = head

:! ival_first_run_multiplicity_shape_more head = head

:= assert_ival_same_root_first_run_multiplicity_shape_runtime
    (left_shape : i64) (right_shape : i64) : () =
    := ok_0 = !!!!EQ(left_shape, 1i64)
    := ok_1 = !!!!EQ(right_shape, 1i64)
    ? ok_0 && ok_1 ?> () |: mega_runtime_fail "same-root-six-first-run-multiplicity-shape-mismatch"

:! ival_canonical_profile_outer_shape_done = ()

:! ival_canonical_profile_outer_shape_some head = head

:= assert_ival_six_distinct_tree_normalization_runtime
    (left_divisor : i64) (left_quotient : i64)
    (right_divisor : i64) (right_quotient : i64)
    (left_groups : i64) (left_cells : i64) (left_product : i64)
    (left_first : i64) (left_last : i64) (left_max : i64) (left_mismatch : i64)
    (right_groups : i64) (right_cells : i64) (right_product : i64)
    (right_first : i64) (right_last : i64) (right_max : i64) (right_mismatch : i64)
    : ()
    =
    := same (a : i64) (b : i64) : bool = !!!!EQ(a, b)
    ? same left_divisor 3i64 && same left_quotient 2i64 && same right_divisor 2i64 && same right_quotient 3i64 ?> ()
    |: mega_runtime_fail "same-root-six-factorization-shapes-are-not-distinct"
    ?
        same left_groups right_groups
        && same left_cells right_cells
        && same left_product right_product
        && same left_first right_first
        && same left_last right_last
        && same left_max right_max
        && same left_mismatch right_mismatch
    ?> ()
    |: mega_runtime_fail "same-root-six-canonical-normalization-disagrees"
    ?
        same left_groups 2i64
        && same left_cells 2i64
        && same left_product 6i64
        && same left_first 2i64
        && same left_last 3i64
        && same left_max 1i64
        && same left_mismatch 0i64
    ?> ()
    |: mega_runtime_fail "same-root-six-canonical-normalization-unexpected"

:| ^ certified_arithmetic_positive_exponent count =
    | CertifiedArithmeticPositiveExponentOne ::
        certified_arithmetic_positive_exponent (z_nat_succ z_nat_zero)
    | CertifiedArithmeticPositiveExponentMore :: \* previous.
        certified_arithmetic_positive_exponent previous ->
        certified_arithmetic_positive_exponent (z_nat_succ previous)

:| ^ certified_arithmetic_positive_exponent_equal left right =
    | CertifiedArithmeticPositiveExponentEqualOne ::
        certified_arithmetic_positive_exponent_equal
            (z_nat_succ z_nat_zero)
            (z_nat_succ z_nat_zero)
    | CertifiedArithmeticPositiveExponentEqualMore :: \* left_previous right_previous.
        certified_arithmetic_positive_exponent_equal left_previous right_previous ->
        certified_arithmetic_positive_exponent_equal
            (z_nat_succ left_previous)
            (z_nat_succ right_previous)

:= ^ certified_arithmetic_positive_exponent_equal_make \* left right.
    (left : certified_arithmetic_positive_exponent left)
    (right : certified_arithmetic_positive_exponent right) :
    certified_arithmetic_positive_exponent_equal left right =
    ?= left, right ?|
    | CertifiedArithmeticPositiveExponentOne, CertifiedArithmeticPositiveExponentOne =>
        CertifiedArithmeticPositiveExponentEqualOne
    | CertifiedArithmeticPositiveExponentMore left_previous,
      CertifiedArithmeticPositiveExponentMore right_previous =>
        CertifiedArithmeticPositiveExponentEqualMore (
            certified_arithmetic_positive_exponent_equal_make
                left_previous right_previous)
    | CertifiedArithmeticPositiveExponentOne,
      CertifiedArithmeticPositiveExponentMore _ =>
        mega_runtime_fail "zeta-positive-exponent-structural-equality-left-shorter"
    | CertifiedArithmeticPositiveExponentMore _,
      CertifiedArithmeticPositiveExponentOne =>
        mega_runtime_fail "zeta-positive-exponent-structural-equality-right-shorter"

:= ival_two_times_one () :
    positive_positional_multiply
        (positional_zero_bit positional_one)
        positional_one
        (positional_zero_bit positional_one) =
    PositivePositionalMultiplyOne (positive_positional_two_value ())

:= ival_two_times_two () :
    positive_positional_multiply
        (positional_zero_bit positional_one)
        (positional_zero_bit positional_one)
        (positional_zero_bit (positional_zero_bit positional_one)) =
    PositivePositionalMultiplyZeroBit (
        ival_two_times_one ())

:= ival_two_times_four () :
    positive_positional_multiply
        (positional_zero_bit positional_one)
        (positional_zero_bit (positional_zero_bit positional_one))
        (positional_zero_bit (positional_zero_bit (positional_zero_bit positional_one))) =
    PositivePositionalMultiplyZeroBit (
        ival_two_times_two ())

:= ival_six_plus_three () :
    positive_positional_add
        (positional_zero_bit (positional_one_bit positional_one))
        (positional_one_bit positional_one)
        (positional_one_bit (positional_zero_bit (positional_zero_bit positional_one))) =
    PositivePositionalAddZeroOne (
        PositivePositionalAddOneBitOne PositivePositionalSuccessorOne)

:= ival_three_times_three () :
    positive_positional_multiply
        (positional_one_bit positional_one)
        (positional_one_bit positional_one)
        (positional_one_bit (positional_zero_bit (positional_zero_bit positional_one))) =
    PositivePositionalMultiplyOneBit (\? (
        PositivePositionalMultiplyOne (positive_positional_three_value ()),
        ival_six_plus_three ()))

:= ^ certified_arithmetic_positive_exponent_equal_consume \* left right.
    (equal : certified_arithmetic_positive_exponent_equal left right) : string =
    ?= equal ?|
    | CertifiedArithmeticPositiveExponentEqualOne =>
        "positive-exponent-equality-consumed-at-one"
    | CertifiedArithmeticPositiveExponentEqualMore previous =>
        certified_arithmetic_positive_exponent_equal_consume previous

