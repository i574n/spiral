:= ival_prime_multiplicity_normal_form_outer_mismatch_symmetry
    (mismatch : ival_prime_multiplicity_normal_form_outer_mismatch)
    : ival_prime_multiplicity_normal_form_outer_mismatch
    =
    ?= mismatch ?|
    | CertifiedIntervalPositivePositionalPrimeMultiplicityNormalFormOuterMismatchLeftDoneRightSome right_payload =>
        := \? right. right_normal = right_payload
        CertifiedIntervalPositivePositionalPrimeMultiplicityNormalFormOuterMismatchLeftSomeRightDone (
            \? right_normal
        )
    | CertifiedIntervalPositivePositionalPrimeMultiplicityNormalFormOuterMismatchLeftSomeRightDone left_payload =>
        := \? left. left_normal = left_payload
        CertifiedIntervalPositivePositionalPrimeMultiplicityNormalFormOuterMismatchLeftDoneRightSome (
            \? left_normal
        )
    | CertifiedIntervalPositivePositionalPrimeMultiplicityNormalFormOuterMismatchBothSome payload =>
        := \? left right. left_normal, right_normal, typed_mismatch = payload
        CertifiedIntervalPositivePositionalPrimeMultiplicityNormalFormOuterMismatchBothSome (
            \? (
                right_normal,
                left_normal,
                ival_prime_multiplicity_normal_form_mismatch_from_symmetry
                    typed_mismatch
