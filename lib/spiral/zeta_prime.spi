        (\? previous_product.
            certified_arithmetic_prime_power_external_factor_descent factor previous_count previous_product external *
            positive_positional_multiply factor previous_product product *
            string) ->
        certified_arithmetic_prime_power_external_factor_descent factor (z_nat_succ previous_count) product external
    | CertifiedArithmeticPrimePowerExternalFactorPrimeProductSplitObstruction :: \* factor previous_count product
        external.
        (\? previous_product.
            ival_indexed_prime_cell external *
            positive_positional_multiply factor previous_product product *
            positive_positional_exact_factor_found_certificate product external *
            positive_positional_nonfactor_certificate factor external *
            positive_positional_nonfactor_certificate previous_product external) ->
        certified_arithmetic_prime_power_external_factor_descent factor (z_nat_succ previous_count) product external

:= ^ certified_arithmetic_prime_power_external_factor_descent_make \* factor count product external.
    (external_prime : ival_indexed_prime_cell external)
    (factor_value : positive_positional_nat factor)
    (external_value : positive_positional_nat external)
    (nonfactor : positive_positional_nonfactor_certificate factor external)
    (chain : certified_arithmetic_prime_power_leaf_nonfactor_chain factor count product external)
    (product_decision : positive_positional_exact_factor_decision product external)
    :
        certified_arithmetic_prime_power_external_factor_descent factor count product external
    =
    ?= product_decision ?|
    | PositivePositionalExactFactorRejected rejected_payload =>
        CertifiedArithmeticPrimePowerExternalFactorProductRejected (
            PositivePositionalNonfactorCertificate rejected_payload)
    | PositivePositionalExactFactorFound found_payload =>
        := product_found = positive_positional_exact_factor_found_certificate found_payload
        ?= chain ?|
        | CertifiedArithmeticPrimePowerLeafNonfactorLast _ =>
            CertifiedArithmeticPrimePowerExternalFactorBaseConflict (
                nonfactor,
                product_found,
                product_found,
                "a-found-external-factor-at-the-last-prime-power-cell-conflicts-with-the-existing-strict-order-nonf"
                ^^ "actor-certificate"
            )
        | CertifiedArithmeticPrimePowerLeafNonfactorMore payload =>
            := \? previous_product. previous_chain, multiplication = payload
            := previous_value = positive_positional_multiply_right_value multiplication
            ?=
                decide_positive_positional_exact_factor factor_value external_value,
                decide_positive_positional_exact_factor previous_value external_value
            ?|
            | PositivePositionalExactFactorFound factor_found_payload, _ =>
                CertifiedArithmeticPrimePowerExternalFactorBaseConflict (
                    nonfactor,
                    positive_positional_exact_factor_found_certificate factor_found_payload,
                    product_found,
                    "the-Euclid-descent-found-the-external-prime-in-the-base-factor-despite-the-linked-nonfactor-ce"
                    ^^ "rtificate"
                )
            | PositivePositionalExactFactorRejected _, previous_decision & PositivePositionalExactFactorFound _ =>
                CertifiedArithmeticPrimePowerExternalFactorDescend (
                    \? (
                        certified_arithmetic_prime_power_external_factor_descent_make
                            external_prime
                            factor_value
                            external_value
                            nonfactor
                            previous_chain
                            previous_decision,
                        multiplication,
                        "the-external-factor-descends-to-the-previous-prime-power-prefix-when-that-prefix-has-zero-"
                        ^^ "remainder"
                    )
                )
            | PositivePositionalExactFactorRejected factor_rejected_payload,
                PositivePositionalExactFactorRejected previous_rejected_payload
                =>
                    CertifiedArithmeticPrimePowerExternalFactorPrimeProductSplitObstruction (\? (
                        external_prime,
                        multiplication,
                        product_found,
                        PositivePositionalNonfactorCertificate factor_rejected_payload,
                        PositivePositionalNonfactorCertificate previous_rejected_payload))

:! certified_arithmetic_rooted_ordered_prime_power_nf_uniqueness_mixed_linked_prime_power_divisibility root =
    \? singleton_factor singleton_count second_factor second_count second_product.
        certified_arithmetic_prime_power singleton_factor singleton_count root *
        certified_arithmetic_prime_power second_factor second_count second_product *
        positive_positional_less singleton_factor second_factor *
        positive_positional_nonfactor_certificate singleton_factor second_factor *
        certified_arithmetic_prime_power_leaf_nonfactor_chain
            singleton_factor singleton_count root second_factor *
        positive_positional_exact_factor_decision root second_factor * string

:= certified_arithmetic_rooted_ordered_prime_power_nf_uniqueness_mixed_linked_prime_power_divisibility_make \*
    root.
    (mixed : certified_arithmetic_rooted_ordered_prime_power_nf_uniqueness_mixed_obstruction root)
    :
        certified_arithmetic_rooted_ordered_prime_power_nf_uniqueness_mixed_linked_prime_power_divisibility root
    =
    ?= mixed ?|
    | CertifiedArithmeticRootedOrderedPrimePowerNFUniquenessMixedLeftSingletonRightMore (frontier, _) =>
        ?= frontier ?|
        | certified_arithmetic_rooted_ordered_prime_power_nf_uniqueness_frontier payload =>
            := \?
                left_factor left_count left_product left_tail_product right_factor right_count right_product
                right_tail_product.
                left_power, left_tail, left_reconstruction, right_power, right_tail, _
                =
                payload
            ?= left_tail, left_reconstruction, right_tail ?|
            | CertifiedArithmeticOrderedPrimePowerProductTailEnd,
                PositivePositionalMultiplyOne _,
                CertifiedArithmeticOrderedPrimePowerProductTailMore more_payload
                =>
                    := \? second_factor second_count second_product second_tail_product.
                        ordering, second_power, _, _ = more_payload
                    := left_value = certified_arithmetic_prime_power_base_value left_power
                    := right_value = certified_arithmetic_prime_power_base_value right_power
                    ?= synthesize_positive_positional_order left_value right_value ?|
                    | PositivePositionalOrderDecisionEqual equal =>
                        := linked_less = positive_positional_less_rewrite_left equal ordering
                        := nonfactor = positive_positional_nonfactor_certificate_from_less linked_less
                        := root_value = certified_arithmetic_prime_power_product_value left_power
                        := second_value = certified_arithmetic_prime_power_base_value second_power
                        certified_arithmetic_rooted_ordered_prime_power_nf_uniqueness_mixed_linked_prime_power_divisibility
                            (
                                \? (
                                    left_power,
                                    second_power,
                                    linked_less,
                                    nonfactor,
                                    certified_arithmetic_prime_power_leaf_nonfactor_chain_from_power
                                        left_power
                                        nonfactor,
                                    decide_positive_positional_exact_factor root_value second_value,
                                    "one-linked-Mixed-authority-now-keeps-the-singleton-prime-power-strict-second-p"
                                    ^^ "rime-separation-leafwise-nonfactor-chain-and-root-divisibility-decision-on-the"
                                    ^^ "-same-p-and-q-indices"
                                )
                            )
                    | PositivePositionalOrderDecisionLess _ =>
                        mega_runtime_fail "zeta-linked-mixed-left-heads-must-be-equal"
                    | PositivePositionalOrderDecisionGreater _ =>
                        mega_runtime_fail "zeta-linked-mixed-left-heads-must-be-equal"
    | CertifiedArithmeticRootedOrderedPrimePowerNFUniquenessMixedLeftMoreRightSingleton (frontier, _) =>
        ?= frontier ?|
        | certified_arithmetic_rooted_ordered_prime_power_nf_uniqueness_frontier payload =>
            := \?
                left_factor left_count left_product left_tail_product right_factor right_count right_product
                right_tail_product.
                left_power, left_tail, _, right_power, right_tail, right_reconstruction
                =
                payload
            ?= right_tail, right_reconstruction, left_tail ?|
            | CertifiedArithmeticOrderedPrimePowerProductTailEnd,
                PositivePositionalMultiplyOne _,
                CertifiedArithmeticOrderedPrimePowerProductTailMore more_payload
                =>
                    := \? second_factor second_count second_product second_tail_product.
                        ordering, second_power, _, _ = more_payload
                    := left_value = certified_arithmetic_prime_power_base_value left_power
                    := right_value = certified_arithmetic_prime_power_base_value right_power
                    ?= synthesize_positive_positional_order left_value right_value ?|
                    | PositivePositionalOrderDecisionEqual equal =>
                        := linked_less =
                            positive_positional_less_rewrite_left
                                (positive_positional_equal_symmetry equal)
                                ordering
                        := nonfactor = positive_positional_nonfactor_certificate_from_less linked_less
                        := root_value = certified_arithmetic_prime_power_product_value right_power
                        := second_value = certified_arithmetic_prime_power_base_value second_power
                        certified_arithmetic_rooted_ordered_prime_power_nf_uniqueness_mixed_linked_prime_power_divisibility
                            (
                                \? (
                                    right_power,
                                    second_power,
                                    linked_less,
                                    nonfactor,
                                    certified_arithmetic_prime_power_leaf_nonfactor_chain_from_power
                                        right_power
                                        nonfactor,
                                    decide_positive_positional_exact_factor root_value second_value,
                                    "one-linked-Mixed-authority-now-keeps-the-singleton-prime-power-strict-second-p"
                                    ^^ "rime-separation-leafwise-nonfactor-chain-and-root-divisibility-decision-on-the"
                                    ^^ "-same-p-and-q-indices"
                                )
                            )
                    | PositivePositionalOrderDecisionLess _ =>
                        mega_runtime_fail "zeta-linked-mixed-right-heads-must-be-equal"
                    | PositivePositionalOrderDecisionGreater _ =>
                        mega_runtime_fail "zeta-linked-mixed-right-heads-must-be-equal"

:! certified_arithmetic_rooted_ordered_prime_power_nf_uniqueness_mixed_euclid_product_descent root =
    \? singleton_factor singleton_count second_factor.
        certified_arithmetic_prime_power_external_factor_descent
            singleton_factor singleton_count root second_factor * string

:= certified_arithmetic_rooted_ordered_prime_power_nf_uniqueness_mixed_euclid_product_descent_make \* root.
    (linked : certified_arithmetic_rooted_ordered_prime_power_nf_uniqueness_mixed_linked_prime_power_divisibility root)
    :
        certified_arithmetic_rooted_ordered_prime_power_nf_uniqueness_mixed_euclid_product_descent root
    =
    ?= linked ?|
    | certified_arithmetic_rooted_ordered_prime_power_nf_uniqueness_mixed_linked_prime_power_divisibility packed =>
        := \? singleton_factor singleton_count second_factor second_count second_product.
            singleton_power, second_power, _, nonfactor, chain, divisibility, _ = packed
        ?= second_power ?|
        | certified_arithmetic_prime_power (second_prime, _) =>
            certified_arithmetic_rooted_ordered_prime_power_nf_uniqueness_mixed_euclid_product_descent (
                \? (
                    certified_arithmetic_prime_power_external_factor_descent_make
                        second_prime
                        (certified_arithmetic_prime_power_base_value singleton_power)
                        (certified_arithmetic_prime_power_base_value second_power)
                        nonfactor
                        chain
                        divisibility,
                    "prime-power-divisibility-now-recurses-directly-from-the-linked-Mixed-authority-without-an-inte"
                    ^^ "rmediate-input-wrapper-until-it-reaches-a-base-factor-conflict-or-one-local-prime-product-spli"
                    ^^ "t-obstruction"
                )
            )

:! certified_arithmetic_kernel_public_surface root =
    certified_arithmetic_rooted_ordered_prime_power_nf root

:= certified_arithmetic_kernel_terminal () :
    certified_arithmetic_kernel_public_surface
        (positional_zero_bit (positional_zero_bit (positional_one_bit positional_one))) =
    := rooted_factor_nf =
        certified_arithmetic_product_multiplicity_rooted_ordered_prime_power_nf (
            ival_product_multiplicity_twelve ())
    certified_arithmetic_kernel_public_surface rooted_factor_nf

:= certified_arithmetic_kernel_public_surface_rooted_ordered_prime_power_nf \* root.
    (surface : certified_arithmetic_kernel_public_surface root) :
    certified_arithmetic_rooted_ordered_prime_power_nf root =
    ?= surface ?|
    | certified_arithmetic_kernel_public_surface rooted_factor_nf => rooted_factor_nf

:= certified_arithmetic_kernel_public_surface_root_value \* root.
    (surface : certified_arithmetic_kernel_public_surface root) : positive_positional_nat root =
    certified_arithmetic_rooted_ordered_prime_power_nf_root_value (
        certified_arithmetic_kernel_public_surface_rooted_ordered_prime_power_nf surface)

