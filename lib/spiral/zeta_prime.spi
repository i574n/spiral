:= decide_ival_prime_multiplicity_normal_form_agreement
    (left : ival_prime_multiplicity_normal_form)
    (right : ival_prime_multiplicity_normal_form)
    : ival_prime_multiplicity_normal_form_agreement_decision
    =
    ?= left, right ?|
    | CertifiedIntervalPositivePositionalPrimeMultiplicityNormalFormDone,
        CertifiedIntervalPositivePositionalPrimeMultiplicityNormalFormDone
        =>
            CertifiedIntervalPositivePositionalPrimeMultiplicityNormalFormAgreementMatched
                CertifiedIntervalPositivePositionalPrimeMultiplicityNormalFormAgreementDone
    | CertifiedIntervalPositivePositionalPrimeMultiplicityNormalFormSome left_payload,
        CertifiedIntervalPositivePositionalPrimeMultiplicityNormalFormSome right_payload
        =>
            := \? left_head. left_normal = left_payload
            := \? right_head. right_normal = right_payload
            ?= decide_ival_prime_multiplicity_normal_form_agreement_from
                    left_normal right_normal ?|
            | CertifiedIntervalPositivePositionalPrimeMultiplicityNormalFormAgreementFromMatched agreement =>
                CertifiedIntervalPositivePositionalPrimeMultiplicityNormalFormAgreementMatched (
                    CertifiedIntervalPositivePositionalPrimeMultiplicityNormalFormAgreementSome (\? agreement))
            | CertifiedIntervalPositivePositionalPrimeMultiplicityNormalFormAgreementFromMismatch mismatch =>
                CertifiedIntervalPositivePositionalPrimeMultiplicityNormalFormAgreementMismatch (
                    CertifiedIntervalPositivePositionalPrimeMultiplicityNormalFormOuterMismatchBothSome (\? (
                        left_normal,
                        right_normal,
                        mismatch)))
    | CertifiedIntervalPositivePositionalPrimeMultiplicityNormalFormDone,
        CertifiedIntervalPositivePositionalPrimeMultiplicityNormalFormSome right_payload
        =>
            := \? right_head. right_normal = right_payload
            CertifiedIntervalPositivePositionalPrimeMultiplicityNormalFormAgreementMismatch (
                CertifiedIntervalPositivePositionalPrimeMultiplicityNormalFormOuterMismatchLeftDoneRightSome (
                    \? right_normal
                )
            )
    | CertifiedIntervalPositivePositionalPrimeMultiplicityNormalFormSome left_payload,
        CertifiedIntervalPositivePositionalPrimeMultiplicityNormalFormDone
        =>
            := \? left_head. left_normal = left_payload
            CertifiedIntervalPositivePositionalPrimeMultiplicityNormalFormAgreementMismatch (
                CertifiedIntervalPositivePositionalPrimeMultiplicityNormalFormOuterMismatchLeftSomeRightDone (
                    \? left_normal
                )
