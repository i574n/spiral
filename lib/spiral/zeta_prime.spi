:= ival_prime_multiplicity_normal_form_outer_mismatch_note
    (mismatch : ival_prime_multiplicity_normal_form_outer_mismatch) : string =
    ?= mismatch ?|
    | CertifiedIntervalPositivePositionalPrimeMultiplicityNormalFormOuterMismatchLeftDoneRightSome _ =>
        "left-canonical-profile-is-empty-and-right-profile-is-nonempty"
    | CertifiedIntervalPositivePositionalPrimeMultiplicityNormalFormOuterMismatchLeftSomeRightDone _ =>
        "left-canonical-profile-is-nonempty-and-right-profile-is-empty"
    | CertifiedIntervalPositivePositionalPrimeMultiplicityNormalFormOuterMismatchBothSome payload =>
        := \? left right. _, _, typed_mismatch = payload
