:# zeta_prime static =
    :< testing

:< zeta_nat

:| positive_positional_euclidean_division dividend divisor quotient remainder =
    | PositivePositionalEuclideanDivision :: \* dividend divisor quotient remainder.
        (\? product.
            positive_positional_multiply quotient divisor product *
            positive_positional_add product remainder dividend *
            positive_positional_less remainder divisor) ->
        positive_positional_euclidean_division dividend divisor quotient remainder

:= positional_fourteen_div_three () :
    positive_positional_euclidean_division
        (positional_zero_bit (positional_one_bit (positional_one_bit positional_one)))
        (positional_one_bit positional_one)
        (positional_zero_bit (positional_zero_bit positional_one))
        (positional_zero_bit positional_one) =
    PositivePositionalEuclideanDivision (\? (
        positional_four_times_three (),
        positional_twelve_plus_two (),
        positional_two_less_three ()))

:| positive_division_strict_descent dividend divisor reduced =
    | PositiveDivisionStrictDescent :: \* dividend divisor reduced.
        synthesized_positive_positional_subtract dividend divisor reduced * string ->
        positive_division_strict_descent dividend divisor reduced

:| ^ value_synthesized_structural_division dividend divisor quotient remainder =
    | ValueSynthesizedStructuralDivisionLess :: \* dividend divisor.
        positive_positional_less dividend divisor ->
        value_synthesized_structural_division
            dividend divisor positional_zero dividend
    | ValueSynthesizedStructuralDivisionEqual :: \* dividend divisor.
        positive_positional_equal dividend divisor ->
        value_synthesized_structural_division
            dividend divisor positional_one positional_zero
    | ValueSynthesizedStructuralDivisionStep :: \* dividend divisor next_quotient remainder.
        (\? reduced quotient.
            positive_positional_nat reduced *
            positive_division_strict_descent dividend divisor reduced *
            synthesized_positive_positional_subtract dividend divisor reduced *
            value_synthesized_structural_division
                reduced divisor quotient remainder *
            nonnegative_positional_successor quotient next_quotient) ->
        value_synthesized_structural_division
            dividend divisor next_quotient remainder

:= alternate_four_div_two () :
    value_synthesized_structural_division
        (positional_zero_bit (positional_zero_bit positional_one))
        (positional_zero_bit positional_one)
        (positional_zero_bit positional_one)
        positional_zero =
    := subtraction =
        SynthesizedPositiveSubtractEvenEven SynthesizedPositiveSubtractOneFromTwo
    ValueSynthesizedStructuralDivisionStep (\? (
        positive_positional_two_value (),
        PositiveDivisionStrictDescent (
            subtraction,
            "four-minus-two-is-the-strict-reduced-dividend"),
        subtraction,
        ValueSynthesizedStructuralDivisionEqual (
            PositivePositionalEqualZeroBit PositivePositionalEqualOne),
        NonnegativePositionalSuccessorPositive PositivePositionalSuccessorOne))

:= alternate_six_div_two () :
    value_synthesized_structural_division
        (positional_zero_bit (positional_one_bit positional_one))
        (positional_zero_bit positional_one)
        (positional_one_bit positional_one)
        positional_zero =
    := subtraction =
        SynthesizedPositiveSubtractEvenEven (
            SynthesizedPositiveSubtractOneFromOdd PositivePositionalOne)
    ValueSynthesizedStructuralDivisionStep (\? (
        positive_positional_four_value (),
        PositiveDivisionStrictDescent (
            subtraction,
            "six-minus-two-is-the-strict-reduced-dividend"),
        subtraction,
        alternate_four_div_two (),
        NonnegativePositionalSuccessorPositive (
            PositivePositionalSuccessorZeroBit PositivePositionalOne)))

:| value_synthesized_division_materialized dividend divisor =
    | ValueSynthesizedDivisionMaterialized :: \* dividend divisor.
        (\? quotient remainder.
            nonnegative_positional_nat quotient *
            nonnegative_positional_nat remainder *
            value_synthesized_structural_division
                dividend divisor quotient remainder * string) ->
        value_synthesized_division_materialized dividend divisor

:= ^ synthesize_positive_division_from_values \* dividend divisor.
    (dividend_value : positive_positional_nat dividend)
    (divisor_value : positive_positional_nat divisor)
    : value_synthesized_division_materialized dividend divisor =
    ?= synthesize_positive_positional_order dividend_value divisor_value ?|
    | PositivePositionalOrderDecisionLess less =>
        ValueSynthesizedDivisionMaterialized (\? (
            NonnegativePositionalZero,
            NonnegativePositionalPositive dividend_value,
            ValueSynthesizedStructuralDivisionLess less,
            "order-and-remainder-are-derived-from-the-two-input-values"))
    | PositivePositionalOrderDecisionEqual equal =>
        ValueSynthesizedDivisionMaterialized (\? (
            NonnegativePositionalPositive PositivePositionalOne,
            NonnegativePositionalZero,
            ValueSynthesizedStructuralDivisionEqual equal,
            "equality-derives-one-and-zero-without-a-search-input"))
    | PositivePositionalOrderDecisionGreater greater =>
        ?= synthesize_positive_positional_subtraction greater ?|
        | SynthesizedPositivePositionalSubtraction subtraction_payload =>
            := \? reduced. reduced_value, subtraction = subtraction_payload
            ?= synthesize_positive_division_from_values reduced_value divisor_value ?|
            | ValueSynthesizedDivisionMaterialized materialized_payload =>
                := \? quotient remainder.
                    quotient_value, remainder_value, proof, _ = materialized_payload
                := descent =
                    PositiveDivisionStrictDescent (
                        subtraction,
                        "subtracting-a-positive-divisor-produces-the-next-structural-measure")
                ?= synthesize_nonnegative_positional_successor quotient_value ?|
                | NonnegativePositionalSuccessorSynthesis successor_payload =>
                    := \? next_quotient.
                        next_quotient_value, successor = successor_payload
                    ValueSynthesizedDivisionMaterialized (\? (
                        next_quotient_value,
                        remainder_value,
                        ValueSynthesizedStructuralDivisionStep (\? (
                            reduced_value,
                            descent,
                            subtraction,
                            proof,
                            successor)),
                        "the-evaluator-derives-a-strict-descent-witness-before-recursing"))

:| positive_positional_exact_factor_decision dividend divisor =
    | PositivePositionalExactFactorFound :: \* dividend divisor.
        (\? quotient.
            positive_positional_nat quotient *
            value_synthesized_structural_division
                dividend divisor quotient positional_zero * string) ->
        positive_positional_exact_factor_decision dividend divisor
    | PositivePositionalExactFactorRejected :: \* dividend divisor.
        (\? quotient remainder.
            nonnegative_positional_nat quotient *
            positive_positional_nat remainder *
            value_synthesized_structural_division
                dividend divisor quotient remainder * string) ->
        positive_positional_exact_factor_decision dividend divisor

:= decide_positive_positional_exact_factor \* dividend divisor.
    (dividend_value : positive_positional_nat dividend)
    (divisor_value : positive_positional_nat divisor)
    : positive_positional_exact_factor_decision dividend divisor =
    ?= synthesize_positive_division_from_values dividend_value divisor_value ?|
    | ValueSynthesizedDivisionMaterialized materialized_payload =>
        := \? quotient remainder.
            quotient_value, remainder_value, proof, _ = materialized_payload
        ?= quotient_value, remainder_value ?|
        | NonnegativePositionalPositive quotient_positive,
          NonnegativePositionalZero =>
            PositivePositionalExactFactorFound (\? (
                quotient_positive,
                proof,
                "the-positive-divisor-has-zero-remainder-and-produces-a-positive-quotient"))
        | _, NonnegativePositionalPositive remainder_positive =>
            PositivePositionalExactFactorRejected (\? (
                quotient_value,
                remainder_positive,
                proof,
                "the-positive-divisor-is-rejected-because-division-synthesizes-a-positive-remainder"))

:| positive_positional_factor_candidate_nonunit natural =
    | PositivePositionalFactorCandidateNonunitZeroBit :: \* tail.
        positive_positional_nat tail ->
        positive_positional_factor_candidate_nonunit (positional_zero_bit tail)
    | PositivePositionalFactorCandidateNonunitOneBit :: \* tail.
        positive_positional_nat tail ->
        positive_positional_factor_candidate_nonunit (positional_one_bit tail)

:| positive_positional_nonfactor_certificate dividend divisor =
    | PositivePositionalNonfactorCertificate :: \* dividend divisor.
        (\? quotient remainder.
            nonnegative_positional_nat quotient *
            positive_positional_nat remainder *
            value_synthesized_structural_division
                dividend divisor quotient remainder * string) ->
        positive_positional_nonfactor_certificate dividend divisor

:| ^ certified_positive_positional_candidate_interval start length =
    | CertifiedPositivePositionalCandidateIntervalOne :: string ->
        certified_positive_positional_candidate_interval positional_one z_nat_zero
    | CertifiedPositivePositionalCandidateIntervalTwo :: string ->
        certified_positive_positional_candidate_interval
            (positional_zero_bit positional_one) z_nat_zero
    | CertifiedPositivePositionalCandidateIntervalMore :: \* start previous.
        (\? candidate.
            positive_positional_nat candidate *
            positive_positional_factor_candidate_nonunit candidate *
            positive_positional_predecessor start candidate *
            certified_positive_positional_candidate_interval candidate previous *
            string) ->
        certified_positive_positional_candidate_interval start (z_nat_succ previous)

:| synthesized_certified_positive_positional_candidate_interval start =
    | SynthesizedCertifiedPositivePositionalCandidateInterval :: \* start.
        (\? length.
            certified_positive_positional_candidate_interval start length * string) ->
        synthesized_certified_positive_positional_candidate_interval start

:= ^ synthesize_certified_positive_positional_candidate_interval \* start.
    (start_value : positive_positional_nat start)
    : synthesized_certified_positive_positional_candidate_interval start =
    ?= start_value ?|
    | PositivePositionalOne =>
        SynthesizedCertifiedPositivePositionalCandidateInterval (\? (
            CertifiedPositivePositionalCandidateIntervalOne
                "one-has-no-nontrivial-factor-candidate-interval",
            "the-certified-interval-terminates-at-unit"))
    | PositivePositionalZeroBit tail =>
        ?= tail ?|
        | PositivePositionalOne =>
            SynthesizedCertifiedPositivePositionalCandidateInterval (\? (
                CertifiedPositivePositionalCandidateIntervalTwo
                    "two-excludes-one-and-itself-from-the-nontrivial-candidate-interval",
                "the-certified-interval-for-two-is-empty"))
        | PositivePositionalZeroBit _ =>
            ?= synthesize_positive_positional_predecessor tail ?|
            | PositivePositionalPredecessorResultSome payload =>
                := \? predecessor. predecessor_value, predecessor_proof = payload
                := candidate_value = PositivePositionalOneBit predecessor_value
                ?= synthesize_certified_positive_positional_candidate_interval candidate_value ?|
                | SynthesizedCertifiedPositivePositionalCandidateInterval tail_payload =>
                    := \? previous. certified_tail, _ = tail_payload
                    SynthesizedCertifiedPositivePositionalCandidateInterval (\? (
                        CertifiedPositivePositionalCandidateIntervalMore (\? (
                            candidate_value,
                            PositivePositionalFactorCandidateNonunitOneBit predecessor_value,
                            PositivePositionalPredecessorZeroBitHigher predecessor_proof,
                            certified_tail,
                            "the-even-start-contributes-its-exact-predecessor-before-recursing")),
                        "the-candidate-interval-preserves-a-predecessor-proof-at-every-cell"))
        | PositivePositionalOneBit _ =>
            ?= synthesize_positive_positional_predecessor tail ?|
            | PositivePositionalPredecessorResultSome payload =>
                := \? predecessor. predecessor_value, predecessor_proof = payload
                := candidate_value = PositivePositionalOneBit predecessor_value
                ?= synthesize_certified_positive_positional_candidate_interval candidate_value ?|
                | SynthesizedCertifiedPositivePositionalCandidateInterval tail_payload =>
                    := \? previous. certified_tail, _ = tail_payload
                    SynthesizedCertifiedPositivePositionalCandidateInterval (\? (
                        CertifiedPositivePositionalCandidateIntervalMore (\? (
                            candidate_value,
                            PositivePositionalFactorCandidateNonunitOneBit predecessor_value,
                            PositivePositionalPredecessorZeroBitHigher predecessor_proof,
                            certified_tail,
                            "the-even-start-contributes-its-exact-predecessor-before-recursing")),
                        "the-candidate-interval-preserves-a-predecessor-proof-at-every-cell"))
    | PositivePositionalOneBit tail =>
        := candidate_value = PositivePositionalZeroBit tail
        ?= synthesize_certified_positive_positional_candidate_interval candidate_value ?|
        | SynthesizedCertifiedPositivePositionalCandidateInterval tail_payload =>
            := \? previous. certified_tail, _ = tail_payload
            SynthesizedCertifiedPositivePositionalCandidateInterval (\? (
                CertifiedPositivePositionalCandidateIntervalMore (\? (
                    candidate_value,
                    PositivePositionalFactorCandidateNonunitZeroBit tail,
                    PositivePositionalPredecessorOneBit tail,
                    certified_tail,
                    "the-odd-start-contributes-its-exact-even-predecessor-before-recursing")),
                "the-candidate-interval-preserves-a-predecessor-proof-at-every-cell"))

:| ^ ival_factor_membership candidate start length =
    | CertifiedIntervalPositivePositionalFactorMembershipHere :: \* candidate start previous.
        positive_positional_nat candidate *
        positive_positional_factor_candidate_nonunit candidate *
        positive_positional_predecessor start candidate * string ->
        ival_factor_membership
            candidate start (z_nat_succ previous)
    | CertifiedIntervalPositivePositionalFactorMembershipThere :: \* candidate start previous.
        (\? head.
            positive_positional_nat candidate *
            positive_positional_nat head *
            positive_positional_factor_candidate_nonunit head *
            positive_positional_predecessor start head *
            ival_factor_membership
                candidate head previous * string) ->
        ival_factor_membership
            candidate start (z_nat_succ previous)

:= alternate_two_in_three_membership () :
    ival_factor_membership
        (positional_zero_bit positional_one)
        (positional_one_bit positional_one)
        (z_nat_succ z_nat_zero) =
    CertifiedIntervalPositivePositionalFactorMembershipHere (
        positive_positional_two_value (),
        PositivePositionalFactorCandidateNonunitZeroBit PositivePositionalOne,
        positional_three_predecessor_two (),
        "two-is-the-alternate-final-membership-cell")

:= alternate_two_in_four_membership () :
    ival_factor_membership
        (positional_zero_bit positional_one)
        (positional_zero_bit (positional_zero_bit positional_one))
        (z_nat_succ (z_nat_succ z_nat_zero)) =
    CertifiedIntervalPositivePositionalFactorMembershipThere (\? (
        positive_positional_two_value (),
        positive_positional_three_value (),
        PositivePositionalFactorCandidateNonunitOneBit PositivePositionalOne,
        positional_four_predecessor_three (),
        alternate_two_in_three_membership (),
        "the-alternate-membership-passes-through-three"))

:= alternate_two_in_five_membership () :
    ival_factor_membership
        (positional_zero_bit positional_one)
        (positional_one_bit (positional_zero_bit positional_one))
        (z_nat_succ (z_nat_succ (z_nat_succ z_nat_zero))) =
    CertifiedIntervalPositivePositionalFactorMembershipThere (\? (
        positive_positional_two_value (),
        positive_positional_four_value (),
        PositivePositionalFactorCandidateNonunitZeroBit (positive_positional_two_value ()),
        positional_five_predecessor_four (),
        alternate_two_in_four_membership (),
        "the-alternate-membership-passes-through-four"))

:= alternate_two_in_six_membership () :
    ival_factor_membership
        (positional_zero_bit positional_one)
        (positional_zero_bit (positional_one_bit positional_one))
        (z_nat_succ (z_nat_succ (z_nat_succ (z_nat_succ z_nat_zero)))) =
    CertifiedIntervalPositivePositionalFactorMembershipThere (\? (
        positive_positional_two_value (),
        positive_positional_five_value (),
        PositivePositionalFactorCandidateNonunitOneBit (positive_positional_two_value ()),
        positional_six_predecessor_five (),
        alternate_two_in_five_membership (),
        "the-alternate-membership-passes-through-five"))

:| ^ ival_all_rejected dividend start length =
    | CertifiedIntervalPositivePositionalAllRejectedOne :: \* dividend.
        string ->
        ival_all_rejected
            dividend positional_one z_nat_zero
    | CertifiedIntervalPositivePositionalAllRejectedTwo :: \* dividend.
        string ->
        ival_all_rejected
            dividend (positional_zero_bit positional_one) z_nat_zero
    | CertifiedIntervalPositivePositionalAllRejectedMore :: \* dividend start previous.
        (\? candidate.
            positive_positional_nat candidate *
            positive_positional_factor_candidate_nonunit candidate *
            positive_positional_predecessor start candidate *
            positive_positional_nonfactor_certificate dividend candidate *
            ival_all_rejected
                dividend candidate previous * string) ->
        ival_all_rejected
            dividend start (z_nat_succ previous)

:| ival_sealed_search natural start length =
    | CertifiedIntervalPositivePositionalSealedPrime :: \* natural start length.
        ival_all_rejected natural start length * string ->
        ival_sealed_search natural start length
    | CertifiedIntervalPositivePositionalSealedComposite :: \* natural start length.
        (\? divisor quotient.
            positive_positional_nat divisor *
            positive_positional_nat quotient *
            ival_factor_membership
                divisor start length *
            value_synthesized_structural_division
                natural divisor quotient positional_zero * string) ->
        ival_sealed_search natural start length

:= ^ search_ival_factor
    \* natural start length.
    (natural_value : positive_positional_nat natural)
    (interval : certified_positive_positional_candidate_interval start length)
    : ival_sealed_search natural start length =
    ?= interval ?|
    | CertifiedPositivePositionalCandidateIntervalOne note =>
        CertifiedIntervalPositivePositionalSealedPrime (
            CertifiedIntervalPositivePositionalAllRejectedOne note,
            "the-complete-interval-terminates-at-one")
    | CertifiedPositivePositionalCandidateIntervalTwo note =>
        CertifiedIntervalPositivePositionalSealedPrime (
            CertifiedIntervalPositivePositionalAllRejectedTwo note,
            "the-complete-interval-terminates-at-two")
    | CertifiedPositivePositionalCandidateIntervalMore payload =>
        := \? candidate.
            candidate_value, candidate_nonunit, predecessor, tail, note = payload
        ?= decide_positive_positional_exact_factor
                natural_value candidate_value ?|
        | PositivePositionalExactFactorFound factor_payload =>
            := \? quotient. quotient_value, division, factor_note = factor_payload
            CertifiedIntervalPositivePositionalSealedComposite (\? (
                candidate_value,
                quotient_value,
                CertifiedIntervalPositivePositionalFactorMembershipHere (
                    candidate_value,
                    candidate_nonunit,
                    predecessor,
                    "the-found-factor-is-the-current-certified-interval-cell"),
                division,
                factor_note))
        | PositivePositionalExactFactorRejected rejection_payload =>
            := \? rejected_quotient rejected_remainder.
                _, _, _, rejection_note = rejection_payload
            ?= search_ival_factor
                    natural_value tail ?|
            | CertifiedIntervalPositivePositionalSealedPrime (rejected_tail, prime_note) =>
                CertifiedIntervalPositivePositionalSealedPrime (
                    CertifiedIntervalPositivePositionalAllRejectedMore (\? (
                        candidate_value,
                        candidate_nonunit,
                        predecessor,
                        PositivePositionalNonfactorCertificate rejection_payload,
                        rejected_tail,
                        note)),
                    prime_note)
            | CertifiedIntervalPositivePositionalSealedComposite composite_payload =>
                := \? found_divisor found_quotient.
                    divisor_value, quotient_value, membership, division, composite_note =
                        composite_payload
                CertifiedIntervalPositivePositionalSealedComposite (\? (
                    divisor_value,
                    quotient_value,
                    CertifiedIntervalPositivePositionalFactorMembershipThere (\? (
                        divisor_value,
                        candidate_value,
                        candidate_nonunit,
                        predecessor,
                        membership,
                        "the-factor-occurs-in-the-certified-tail-after-this-rejected-cell")),
                    division,
                    composite_note))

:| ival_sealed_factor_class natural =
    | CertifiedIntervalPositivePositionalSealedUnit ::
        ival_sealed_factor_class positional_one
    | CertifiedIntervalPositivePositionalSealedPrimeClass :: \* natural.
        (\? length.
            positive_positional_nat natural *
            positive_positional_factor_candidate_nonunit natural *
            ival_all_rejected
                natural natural length * string) ->
        ival_sealed_factor_class natural
    | CertifiedIntervalPositivePositionalSealedCompositeClass :: \* natural.
        (\? length divisor quotient.
            positive_positional_nat natural *
            positive_positional_nat divisor *
            positive_positional_nat quotient *
            ival_factor_membership
                divisor natural length *
            value_synthesized_structural_division
                natural divisor quotient positional_zero * string) ->
        ival_sealed_factor_class natural

:| ival_sealed_composite_witness natural =
    | CertifiedIntervalPositivePositionalSealedCompositeWitness :: \* natural.
        (\? length divisor quotient.
            positive_positional_nat natural *
            positive_positional_nat divisor *
            positive_positional_nat quotient *
            ival_factor_membership
                divisor natural length *
            value_synthesized_structural_division
                natural divisor quotient positional_zero * string) ->
        ival_sealed_composite_witness natural

:| ival_sealed_composite_children natural divisor quotient =
    | CertifiedIntervalPositivePositionalSealedCompositeChildren :: \* natural divisor quotient.
        (\? length.
            positive_positional_nat natural *
            positive_positional_nat divisor *
            positive_positional_nat quotient *
            ival_factor_membership
                divisor natural length *
            value_synthesized_structural_division
                natural divisor quotient positional_zero * string) ->
        ival_sealed_composite_children natural divisor quotient

:= ival_sealed_composite_children_from_witness \* natural.
    (witness : ival_sealed_composite_witness natural)
    : (\? divisor quotient.
        ival_sealed_composite_children natural divisor quotient) =
    ?= witness ?|
    | CertifiedIntervalPositivePositionalSealedCompositeWitness payload =>
        := \? length divisor quotient.
            natural_value, divisor_value, quotient_value,
            membership, division, note = payload
        \? (
            CertifiedIntervalPositivePositionalSealedCompositeChildren (\? (
                natural_value,
                divisor_value,
                quotient_value,
                membership,
                division,
                note)))

:= ival_sealed_composite_children_classification
    \* natural divisor quotient.
    (children : ival_sealed_composite_children natural divisor quotient)
    : ival_sealed_factor_class natural =
    ?= children ?|
    | CertifiedIntervalPositivePositionalSealedCompositeChildren payload =>
        := \? length.
            natural_value, divisor_value, quotient_value,
            membership, division, note = payload
        CertifiedIntervalPositivePositionalSealedCompositeClass (\? (
            natural_value,
            divisor_value,
            quotient_value,
            membership,
            division,
            note))

:= ival_sealed_composite_classification \* natural.
    (witness : ival_sealed_composite_witness natural)
    : ival_sealed_factor_class natural =
    ?= witness ?|
    | CertifiedIntervalPositivePositionalSealedCompositeWitness payload =>
        CertifiedIntervalPositivePositionalSealedCompositeClass payload

:= classify_ival_sealed_factor
    \* natural.
    (natural_value : positive_positional_nat natural)
    : ival_sealed_factor_class natural =
    ?= natural_value ?|
    | PositivePositionalOne =>
        CertifiedIntervalPositivePositionalSealedUnit
    | PositivePositionalZeroBit tail =>
        := concrete = PositivePositionalZeroBit tail
        ?= synthesize_certified_positive_positional_candidate_interval concrete ?|
        | SynthesizedCertifiedPositivePositionalCandidateInterval interval_payload =>
            := \? length. interval, _ = interval_payload
            ?= search_ival_factor concrete interval ?|
            | CertifiedIntervalPositivePositionalSealedPrime (rejected, note) =>
                CertifiedIntervalPositivePositionalSealedPrimeClass (\? (
                    concrete,
                    PositivePositionalFactorCandidateNonunitZeroBit tail,
                    rejected,
                    note))
            | CertifiedIntervalPositivePositionalSealedComposite composite_payload =>
                := \? found_divisor found_quotient.
                    divisor_value, quotient_value, membership, division, note =
                        composite_payload
                CertifiedIntervalPositivePositionalSealedCompositeClass (\? (
                    concrete,
                    divisor_value,
                    quotient_value,
                    membership,
                    division,
                    note))
    | PositivePositionalOneBit tail =>
        := concrete = PositivePositionalOneBit tail
        ?= synthesize_certified_positive_positional_candidate_interval concrete ?|
        | SynthesizedCertifiedPositivePositionalCandidateInterval interval_payload =>
            := \? length. interval, _ = interval_payload
            ?= search_ival_factor concrete interval ?|
            | CertifiedIntervalPositivePositionalSealedPrime (rejected, note) =>
                CertifiedIntervalPositivePositionalSealedPrimeClass (\? (
                    concrete,
                    PositivePositionalFactorCandidateNonunitOneBit tail,
                    rejected,
                    note))
            | CertifiedIntervalPositivePositionalSealedComposite composite_payload =>
                := \? found_divisor found_quotient.
                    divisor_value, quotient_value, membership, division, note =
                        composite_payload
                CertifiedIntervalPositivePositionalSealedCompositeClass (\? (
                    concrete,
                    divisor_value,
                    quotient_value,
                    membership,
                    division,
                    note))

:= ival_factor_membership_candidate_value
    \* candidate start length.
    (membership : ival_factor_membership candidate start length)
    : positive_positional_nat candidate =
    ?= membership ?|
    | CertifiedIntervalPositivePositionalFactorMembershipHere payload =>
        := candidate_value, _, _, _ = payload
        candidate_value
    | CertifiedIntervalPositivePositionalFactorMembershipThere payload =>
        := \? head. candidate_value, _, _, _, _, _ = payload
        candidate_value

:| ival_recursive_descent parent child =
    | CertifiedIntervalPositivePositionalRecursiveDescent :: \* parent child.
        positive_positional_less child parent * string ->
        ival_recursive_descent parent child
    | CertifiedIntervalPositivePositionalRecursiveDescentFromMembership :: \* parent child.
        (\? length.
            ival_factor_membership child parent length * string) ->
        ival_recursive_descent parent child
    | CertifiedIntervalPositivePositionalRecursiveDescentFromCompositeQuotient :: \* parent quotient.
        (\? divisor.
            ival_sealed_composite_children parent divisor quotient * string) ->
        ival_recursive_descent parent quotient

:| ival_recursive_descent_decision parent child =
    | CertifiedIntervalPositivePositionalRecursiveDescentProven :: \* parent child.
        ival_recursive_descent parent child ->
        ival_recursive_descent_decision parent child
    | CertifiedIntervalPositivePositionalRecursiveDescentEqual :: \* parent child.
        positive_positional_equal child parent ->
        ival_recursive_descent_decision parent child
    | CertifiedIntervalPositivePositionalRecursiveDescentGreater :: \* parent child.
        positive_positional_less parent child ->
        ival_recursive_descent_decision parent child

:= derive_ival_recursive_descent
    \* parent child.
    (parent_value : positive_positional_nat parent)
    (child_value : positive_positional_nat child)
    : ival_recursive_descent_decision parent child =
    ?= synthesize_positive_positional_order child_value parent_value ?|
    | PositivePositionalOrderDecisionLess less =>
        CertifiedIntervalPositivePositionalRecursiveDescentProven (
            CertifiedIntervalPositivePositionalRecursiveDescent (
                less,
                "the-child-is-proved-strictly-smaller-before-the-recursive-call"))
    | PositivePositionalOrderDecisionEqual equal =>
        CertifiedIntervalPositivePositionalRecursiveDescentEqual equal
    | PositivePositionalOrderDecisionGreater greater =>
        CertifiedIntervalPositivePositionalRecursiveDescentGreater greater

:= derive_ival_membership_recursive_descent
    \* candidate start length.
    (_ : positive_positional_nat start)
    (membership : ival_factor_membership candidate start length)
    : ival_recursive_descent start candidate =
    CertifiedIntervalPositivePositionalRecursiveDescentFromMembership (\? (
        membership,
        "the-factor-membership-predecessor-chain-is-itself-a-nonempty-typed-descent-from-parent-to-candidate"))

:= derive_ival_quotient_recursive_descent_from_children
    \* parent divisor quotient.
    (children : ival_sealed_composite_children parent divisor quotient)
    : ival_recursive_descent parent quotient
    =
    CertifiedIntervalPositivePositionalRecursiveDescentFromCompositeQuotient (
        \? (
            children,
            "the-sealed-composite-factor-membership-and-exact-zero-remainder-division-jointly-govern-the-positive-q"
            ^^ "uotient-as-a-strict-recursive-child-without-a-second-order-decision"
        )
    )

:| ^ ival_complete_factorization_tree natural =
    | CertifiedIntervalPositivePositionalCompleteUnit ::
        ival_complete_factorization_tree positional_one
    | CertifiedIntervalPositivePositionalCompletePrime :: \* natural.
        (\? length.
            positive_positional_nat natural *
            positive_positional_factor_candidate_nonunit natural *
            ival_all_rejected natural natural length * string) ->
        ival_complete_factorization_tree natural
    | CertifiedIntervalPositivePositionalCompleteSplit :: \* natural.
        (\? length divisor quotient.
            positive_positional_nat natural *
            positive_positional_nat divisor *
            positive_positional_nat quotient *
            ival_factor_membership divisor natural length *
            value_synthesized_structural_division natural divisor quotient positional_zero *
            ival_recursive_descent natural divisor *
            ival_recursive_descent natural quotient *
            ival_complete_factorization_tree divisor *
            ival_complete_factorization_tree quotient * string) ->
        ival_complete_factorization_tree natural

:| ^ ival_complete_reconstruction natural =
    | CertifiedIntervalPositivePositionalCompleteReconstructionUnit ::
        ival_complete_reconstruction positional_one
    | CertifiedIntervalPositivePositionalCompleteReconstructionPrime :: \* natural.
        (\? length.
            positive_positional_nat natural *
            positive_positional_factor_candidate_nonunit natural *
            ival_all_rejected natural natural length * string) ->
        ival_complete_reconstruction natural
    | CertifiedIntervalPositivePositionalCompleteReconstructionSplit :: \* natural.
        (\? divisor quotient.
            positive_positional_nat natural *
            value_synthesized_structural_division natural divisor quotient positional_zero *
            ival_recursive_descent natural divisor *
            ival_recursive_descent natural quotient *
            ival_complete_reconstruction divisor *
            ival_complete_reconstruction quotient * string) ->
        ival_complete_reconstruction natural

:= ^ reconstruct_ival_complete_factorization \* natural.
    (tree : ival_complete_factorization_tree natural)
    : ival_complete_reconstruction natural =
    ?= tree ?|
    | CertifiedIntervalPositivePositionalCompleteUnit =>
        CertifiedIntervalPositivePositionalCompleteReconstructionUnit
    | CertifiedIntervalPositivePositionalCompletePrime payload =>
        CertifiedIntervalPositivePositionalCompleteReconstructionPrime payload
    | CertifiedIntervalPositivePositionalCompleteSplit payload =>
        := \? length divisor quotient.
            root_value, _, _, _, division,
            divisor_descent, quotient_descent, left, right, note = payload
        CertifiedIntervalPositivePositionalCompleteReconstructionSplit (\? (
            root_value,
            division,
            divisor_descent,
            quotient_descent,
            reconstruct_ival_complete_factorization left,
            reconstruct_ival_complete_factorization right,
            note))

:| ival_complete_prime_sequence_cell =
    | CertifiedIntervalPositivePositionalCompletePrimeSequenceCell ::
        (\? natural length.
            positive_positional_nat natural *
            positive_positional_factor_candidate_nonunit natural *
            ival_all_rejected natural natural length * string) ->
        ival_complete_prime_sequence_cell

:| ^ ival_complete_prime_sequence =
    | CertifiedIntervalPositivePositionalCompletePrimeSequenceDone
    | CertifiedIntervalPositivePositionalCompletePrimeSequenceMore ::
        ival_complete_prime_sequence_cell *
        ival_complete_prime_sequence ->
        ival_complete_prime_sequence

:= ^ append_ival_complete_prime_sequence
    (left : ival_complete_prime_sequence)
    (right : ival_complete_prime_sequence)
    : ival_complete_prime_sequence =
    ?= left ?|
    | CertifiedIntervalPositivePositionalCompletePrimeSequenceDone => right
    | CertifiedIntervalPositivePositionalCompletePrimeSequenceMore (head, tail) =>
        CertifiedIntervalPositivePositionalCompletePrimeSequenceMore (
            head,
            append_ival_complete_prime_sequence tail right)

:= ^ project_ival_complete_reconstruction_prime_sequence \* natural.
    (reconstruction : ival_complete_reconstruction natural)
    : ival_complete_prime_sequence =
    ?= reconstruction ?|
    | CertifiedIntervalPositivePositionalCompleteReconstructionUnit =>
        CertifiedIntervalPositivePositionalCompletePrimeSequenceDone
    | CertifiedIntervalPositivePositionalCompleteReconstructionPrime payload =>
        := \? length. prime_value, nonunit, rejected, note = payload
        CertifiedIntervalPositivePositionalCompletePrimeSequenceMore (
            CertifiedIntervalPositivePositionalCompletePrimeSequenceCell (\? (
                prime_value,
                nonunit,
                rejected,
                note)),
            CertifiedIntervalPositivePositionalCompletePrimeSequenceDone)
    | CertifiedIntervalPositivePositionalCompleteReconstructionSplit payload =>
        := \? divisor quotient. _, _, _, _, left, right, _ = payload
        append_ival_complete_prime_sequence
            (project_ival_complete_reconstruction_prime_sequence left)
            (project_ival_complete_reconstruction_prime_sequence right)

:| ival_prime_less_or_equal left right =
    | CertifiedIntervalPositivePositionalPrimeLessOrEqualLess :: \* left right.
        positive_positional_less left right ->
        ival_prime_less_or_equal left right
    | CertifiedIntervalPositivePositionalPrimeLessOrEqualEqual :: \* left right.
        positive_positional_equal left right ->
        ival_prime_less_or_equal left right

:| ival_indexed_prime_cell natural =
    | CertifiedIntervalPositivePositionalIndexedPrimeCell :: \* natural.
        (\? length.
            positive_positional_nat natural *
            positive_positional_factor_candidate_nonunit natural *
            ival_all_rejected natural natural length * string) ->
        ival_indexed_prime_cell natural

:| ival_any_indexed_prime_cell =
    | CertifiedIntervalPositivePositionalAnyIndexedPrimeCell ::
        (\? natural. ival_indexed_prime_cell natural) ->
        ival_any_indexed_prime_cell

:= ival_index_prime_sequence_cell
    (cell : ival_complete_prime_sequence_cell)
    : ival_any_indexed_prime_cell =
    ?= cell ?|
    | CertifiedIntervalPositivePositionalCompletePrimeSequenceCell payload =>
        := \? natural length. prime_value, nonunit, rejected, note = payload
        CertifiedIntervalPositivePositionalAnyIndexedPrimeCell (\? (
            CertifiedIntervalPositivePositionalIndexedPrimeCell (\? (
                prime_value,
                nonunit,
                rejected,
                note))))

:= ival_indexed_prime_cell_value \* natural.
    (cell : ival_indexed_prime_cell natural)
    : positive_positional_nat natural =
    ?= cell ?|
    | CertifiedIntervalPositivePositionalIndexedPrimeCell payload =>
        := \? length. prime_value, _, _, _ = payload
        prime_value

:| ^ ival_ordered_prime_sequence_from head =
    | CertifiedIntervalPositivePositionalOrderedPrimeSequenceLast :: \* head.
        ival_indexed_prime_cell head ->
        ival_ordered_prime_sequence_from head
    | CertifiedIntervalPositivePositionalOrderedPrimeSequenceMore :: \* head.
        (\? next.
            ival_indexed_prime_cell head *
            ival_prime_less_or_equal head next *
            ival_ordered_prime_sequence_from next) ->
        ival_ordered_prime_sequence_from head

:| ival_ordered_prime_sequence =
    | CertifiedIntervalPositivePositionalOrderedPrimeSequenceDone
    | CertifiedIntervalPositivePositionalOrderedPrimeSequenceSome ::
        (\? head. ival_ordered_prime_sequence_from head) ->
        ival_ordered_prime_sequence

:= ival_ordered_prime_sequence_head_value \* head.
    (sequence : ival_ordered_prime_sequence_from head)
    : positive_positional_nat head =
    ?= sequence ?|
    | CertifiedIntervalPositivePositionalOrderedPrimeSequenceLast cell =>
        ival_indexed_prime_cell_value cell
    | CertifiedIntervalPositivePositionalOrderedPrimeSequenceMore payload =>
        := \? next. cell, _, _ = payload
        ival_indexed_prime_cell_value cell

:= ^ ival_ordered_prime_sequence_insert_after \* head inserted.
    (head_to_inserted : ival_prime_less_or_equal head inserted)
    (inserted_cell : ival_indexed_prime_cell inserted)
    (sequence : ival_ordered_prime_sequence_from head)
    : ival_ordered_prime_sequence_from head =
    ?= sequence ?|
    | CertifiedIntervalPositivePositionalOrderedPrimeSequenceLast head_cell =>
        CertifiedIntervalPositivePositionalOrderedPrimeSequenceMore (\? (
            head_cell,
            head_to_inserted,
            CertifiedIntervalPositivePositionalOrderedPrimeSequenceLast inserted_cell))
    | CertifiedIntervalPositivePositionalOrderedPrimeSequenceMore payload =>
        := \? next. head_cell, head_to_next, tail = payload
        := inserted_value =
            ival_indexed_prime_cell_value inserted_cell
        := next_value =
            ival_ordered_prime_sequence_head_value tail
        ?= synthesize_positive_positional_order inserted_value next_value ?|
        | PositivePositionalOrderDecisionLess less =>
            CertifiedIntervalPositivePositionalOrderedPrimeSequenceMore (\? (
                head_cell,
                head_to_inserted,
                CertifiedIntervalPositivePositionalOrderedPrimeSequenceMore (\? (
                    inserted_cell,
                    CertifiedIntervalPositivePositionalPrimeLessOrEqualLess less,
                    tail))))
        | PositivePositionalOrderDecisionEqual equal =>
            CertifiedIntervalPositivePositionalOrderedPrimeSequenceMore (\? (
                head_cell,
                head_to_inserted,
                CertifiedIntervalPositivePositionalOrderedPrimeSequenceMore (\? (
                    inserted_cell,
                    CertifiedIntervalPositivePositionalPrimeLessOrEqualEqual equal,
                    tail))))
        | PositivePositionalOrderDecisionGreater greater =>
            CertifiedIntervalPositivePositionalOrderedPrimeSequenceMore (\? (
                head_cell,
                head_to_next,
                ival_ordered_prime_sequence_insert_after
                    (CertifiedIntervalPositivePositionalPrimeLessOrEqualLess greater)
                    inserted_cell
                    tail))

:= ival_ordered_prime_sequence_insert \* inserted.
    (inserted_cell : ival_indexed_prime_cell inserted)
    (sequence : ival_ordered_prime_sequence)
    : ival_ordered_prime_sequence =
    ?= sequence ?|
    | CertifiedIntervalPositivePositionalOrderedPrimeSequenceDone =>
        CertifiedIntervalPositivePositionalOrderedPrimeSequenceSome (\? (
            CertifiedIntervalPositivePositionalOrderedPrimeSequenceLast inserted_cell))
    | CertifiedIntervalPositivePositionalOrderedPrimeSequenceSome payload =>
        := \? head. ordered = payload
        := inserted_value =
            ival_indexed_prime_cell_value inserted_cell
        := head_value =
            ival_ordered_prime_sequence_head_value ordered
        ?= synthesize_positive_positional_order inserted_value head_value ?|
        | PositivePositionalOrderDecisionLess less =>
            CertifiedIntervalPositivePositionalOrderedPrimeSequenceSome (\? (
                CertifiedIntervalPositivePositionalOrderedPrimeSequenceMore (\? (
                    inserted_cell,
                    CertifiedIntervalPositivePositionalPrimeLessOrEqualLess less,
                    ordered))))
        | PositivePositionalOrderDecisionEqual equal =>
            CertifiedIntervalPositivePositionalOrderedPrimeSequenceSome (\? (
                CertifiedIntervalPositivePositionalOrderedPrimeSequenceMore (\? (
                    inserted_cell,
                    CertifiedIntervalPositivePositionalPrimeLessOrEqualEqual equal,
                    ordered))))
        | PositivePositionalOrderDecisionGreater greater =>
            CertifiedIntervalPositivePositionalOrderedPrimeSequenceSome (\? (
                ival_ordered_prime_sequence_insert_after
                    (CertifiedIntervalPositivePositionalPrimeLessOrEqualLess greater)
                    inserted_cell
                    ordered))

:= ^ canonicalize_ival_complete_prime_sequence
    (sequence : ival_complete_prime_sequence)
    : ival_ordered_prime_sequence =
    ?= sequence ?|
    | CertifiedIntervalPositivePositionalCompletePrimeSequenceDone =>
        CertifiedIntervalPositivePositionalOrderedPrimeSequenceDone
    | CertifiedIntervalPositivePositionalCompletePrimeSequenceMore (head, tail) =>
        := sorted_tail =
            canonicalize_ival_complete_prime_sequence tail
        ?= ival_index_prime_sequence_cell head ?|
        | CertifiedIntervalPositivePositionalAnyIndexedPrimeCell payload =>
            := \? inserted. indexed_head = payload
            ival_ordered_prime_sequence_insert
                indexed_head
                sorted_tail

:| ^ ival_prime_multiplicity_run_from head =
    | CertifiedIntervalPositivePositionalPrimeMultiplicityRunLast :: \* head.
        ival_indexed_prime_cell head ->
        ival_prime_multiplicity_run_from head
    | CertifiedIntervalPositivePositionalPrimeMultiplicityRunMore :: \* head.
        (\? next.
            ival_indexed_prime_cell head *
            positive_positional_equal head next *
            ival_prime_multiplicity_run_from next) ->
        ival_prime_multiplicity_run_from head

:| ^ ival_prime_multiplicity_normal_form_from head =
    | CertifiedIntervalPositivePositionalPrimeMultiplicityNormalFormLast :: \* head.
        ival_prime_multiplicity_run_from head ->
        ival_prime_multiplicity_normal_form_from head
    | CertifiedIntervalPositivePositionalPrimeMultiplicityNormalFormMore :: \* head.
        (\? next.
            ival_prime_multiplicity_run_from head *
            positive_positional_less head next *
            ival_prime_multiplicity_normal_form_from next) ->
        ival_prime_multiplicity_normal_form_from head

:| ival_prime_multiplicity_normal_form =
    | CertifiedIntervalPositivePositionalPrimeMultiplicityNormalFormDone
    | CertifiedIntervalPositivePositionalPrimeMultiplicityNormalFormSome ::
        (\? head. ival_prime_multiplicity_normal_form_from head) ->
        ival_prime_multiplicity_normal_form

:| ival_group_indexed_normal_form head shape =
    | CertifiedIntervalPositivePositionalGroupIndexedNormalFormLast :: \* head.
        ival_prime_multiplicity_run_from head ->
        ival_group_indexed_normal_form
            head ival_canonical_group_shape_last
    | CertifiedIntervalPositivePositionalGroupIndexedNormalFormMore :: \* head next.
        ival_prime_multiplicity_run_from head *
        positive_positional_less head next *
        ival_prime_multiplicity_normal_form_from next ->
        ival_group_indexed_normal_form
            head (ival_canonical_group_shape_more next)

:| ival_any_group_indexed_normal_form head =
    | CertifiedIntervalPositivePositionalAnyGroupIndexedNormalForm :: \* head.
        (\? shape.
            ival_group_indexed_normal_form head shape) ->
        ival_any_group_indexed_normal_form head

:= index_ival_canonical_group_shape \* head.
    (normal : ival_prime_multiplicity_normal_form_from head)
    : ival_any_group_indexed_normal_form head =
    ?= normal ?|
    | CertifiedIntervalPositivePositionalPrimeMultiplicityNormalFormLast run =>
        CertifiedIntervalPositivePositionalAnyGroupIndexedNormalForm (\? (
            CertifiedIntervalPositivePositionalGroupIndexedNormalFormLast run))
    | CertifiedIntervalPositivePositionalPrimeMultiplicityNormalFormMore payload =>
        := \? next. run, less, rest = payload
        CertifiedIntervalPositivePositionalAnyGroupIndexedNormalForm (\? (
            CertifiedIntervalPositivePositionalGroupIndexedNormalFormMore (
                run,
                less,
                rest)))

:= ival_prime_multiplicity_normal_form_prepend_equal \* head next.
    (head_cell : ival_indexed_prime_cell head)
    (head_to_next : positive_positional_equal head next)
    (normal : ival_prime_multiplicity_normal_form_from next)
    : ival_prime_multiplicity_normal_form_from head =
    ?= normal ?|
    | CertifiedIntervalPositivePositionalPrimeMultiplicityNormalFormLast run =>
        CertifiedIntervalPositivePositionalPrimeMultiplicityNormalFormLast (
            CertifiedIntervalPositivePositionalPrimeMultiplicityRunMore (\? (
                head_cell,
                head_to_next,
                run)))
    | CertifiedIntervalPositivePositionalPrimeMultiplicityNormalFormMore payload =>
        := \? following. run, next_to_following, rest = payload
        CertifiedIntervalPositivePositionalPrimeMultiplicityNormalFormMore (\? (
            CertifiedIntervalPositivePositionalPrimeMultiplicityRunMore (\? (
                head_cell,
                head_to_next,
                run)),
            positive_positional_less_rewrite_left head_to_next next_to_following,
            rest))

:= ^ compress_ival_ordered_prime_sequence_from \* head.
    (sequence : ival_ordered_prime_sequence_from head)
    : ival_prime_multiplicity_normal_form_from head =
    ?= sequence ?|
    | CertifiedIntervalPositivePositionalOrderedPrimeSequenceLast head_cell =>
        CertifiedIntervalPositivePositionalPrimeMultiplicityNormalFormLast (
            CertifiedIntervalPositivePositionalPrimeMultiplicityRunLast head_cell)
    | CertifiedIntervalPositivePositionalOrderedPrimeSequenceMore payload =>
        := \? next. head_cell, head_to_next, tail = payload
        := compressed_tail =
            compress_ival_ordered_prime_sequence_from tail
        ?= head_to_next ?|
        | CertifiedIntervalPositivePositionalPrimeLessOrEqualLess less =>
            CertifiedIntervalPositivePositionalPrimeMultiplicityNormalFormMore (\? (
                CertifiedIntervalPositivePositionalPrimeMultiplicityRunLast head_cell,
                less,
                compressed_tail))
        | CertifiedIntervalPositivePositionalPrimeLessOrEqualEqual equal =>
            ival_prime_multiplicity_normal_form_prepend_equal
                head_cell equal compressed_tail

:= compress_ival_ordered_prime_sequence
    (sequence : ival_ordered_prime_sequence)
    : ival_prime_multiplicity_normal_form =
    ?= sequence ?|
    | CertifiedIntervalPositivePositionalOrderedPrimeSequenceDone =>
        CertifiedIntervalPositivePositionalPrimeMultiplicityNormalFormDone
    | CertifiedIntervalPositivePositionalOrderedPrimeSequenceSome payload =>
        := \? head. ordered = payload
        CertifiedIntervalPositivePositionalPrimeMultiplicityNormalFormSome (\? (
            compress_ival_ordered_prime_sequence_from ordered))

:| ^ ival_prime_multiplicity_counted_run_from head count =
    | CertifiedIntervalPositivePositionalPrimeMultiplicityCountedRunLast :: \* head.
        ival_indexed_prime_cell head ->
        ival_prime_multiplicity_counted_run_from
            head (z_nat_succ z_nat_zero)
    | CertifiedIntervalPositivePositionalPrimeMultiplicityCountedRunMore :: \* head previous.
        (\? next.
            ival_indexed_prime_cell head *
            positive_positional_equal head next *
            ival_prime_multiplicity_counted_run_from next previous) ->
        ival_prime_multiplicity_counted_run_from
            head (z_nat_succ previous)

:| ival_any_prime_multiplicity_counted_run head =
    | CertifiedIntervalPositivePositionalAnyPrimeMultiplicityCountedRun :: \* head.
        (\? count.
            ival_prime_multiplicity_counted_run_from head count) ->
        ival_any_prime_multiplicity_counted_run head

:= ^ index_ival_prime_multiplicity_exact_count \* head.
    (run : ival_prime_multiplicity_run_from head) :
    ival_any_prime_multiplicity_counted_run head =
    ?= run ?|
    | CertifiedIntervalPositivePositionalPrimeMultiplicityRunLast cell =>
        CertifiedIntervalPositivePositionalAnyPrimeMultiplicityCountedRun (\? (
            CertifiedIntervalPositivePositionalPrimeMultiplicityCountedRunLast cell))
    | CertifiedIntervalPositivePositionalPrimeMultiplicityRunMore payload =>
        := \? next. cell, equal, tail = payload
        ?= index_ival_prime_multiplicity_exact_count tail ?|
        | CertifiedIntervalPositivePositionalAnyPrimeMultiplicityCountedRun counted_payload =>
            := \? previous. counted_tail = counted_payload
            CertifiedIntervalPositivePositionalAnyPrimeMultiplicityCountedRun (\? (
                CertifiedIntervalPositivePositionalPrimeMultiplicityCountedRunMore (\? (
                    cell,
                    equal,
                    counted_tail))))

:= assert_ival_prime_multiplicity_exact_counts
    (three : i64) (twelve : i64) (eighteen : i64) : () =
    := ok_0 = !!!!EQ(three, 1i64)
    := ok_1 = !!!!EQ(twelve, 2i64)
    := ok_2 = !!!!EQ(eighteen, 1i64)
    ? ok_0 && ok_1 && ok_2 ?> () |: mega_runtime_fail "zeta-exact-multiplicity-count-index-mismatch"

:= assert_ival_prime_multiplicity_total_exact_counts
    (three : i64) (three_cells : i64)
    (twelve : i64) (twelve_cells : i64)
    (eighteen : i64) (eighteen_cells : i64) : () =
    := ok_0 = !!!!EQ(three, three_cells)
    := ok_1 = !!!!EQ(twelve, twelve_cells)
    := ok_2 = !!!!EQ(eighteen, eighteen_cells)
    ? ok_0 && ok_1 && ok_2 ?> () |: mega_runtime_fail "zeta-total-exact-multiplicity-count-mismatch"

:= assert_ival_prime_multiplicity_normal_form_runtime
    (groups : i64) (cells : i64) (product_sum : i64) (max_sum : i64) (mismatches : i64)
    : ()
    =
    := ok_0 = !!!!EQ(groups, 5i64)
    := ok_1 = !!!!EQ(cells, 7i64)
    := ok_2 = !!!!EQ(product_sum, 33i64)
    := ok_3 = !!!!EQ(max_sum, 5i64)
    := ok_4 = !!!!EQ(mismatches, 0i64)
    ? ok_0 && ok_1 && ok_2 && ok_3 && ok_4
    ?> ()
    |: mega_runtime_fail "certified-interval-positive-positional-prime-multiplicity-normal-form-runtime-mismatch"

:= assert_ival_ordered_prime_sequence_runtime
    (count : i64) (product_sum : i64) (mismatches : i64)
    : ()
    =
    := ok_0 = !!!!EQ(count, 7i64)
    := ok_1 = !!!!EQ(product_sum, 33i64)
    := ok_2 = !!!!EQ(mismatches, 0i64)
    ? ok_0 && ok_1 && ok_2
    ?> ()
    |: mega_runtime_fail "certified-interval-positive-positional-ordered-prime-sequence-runtime-mismatch"

:= ^ derive_ival_factor_membership_parent_accessibility
    \* candidate start length.
    (membership :
        ival_factor_membership
            candidate start length)
    : positive_positional_parent_derived_child_accessibility candidate =
    ?= membership ?|
    | CertifiedIntervalPositivePositionalFactorMembershipHere
        (_, _, predecessor, _) =>
        := parent_value =
            positive_positional_predecessor_input_value predecessor
        := parent_accessibility =
            derive_positive_positional_predecessor_accessibility parent_value
        derive_positive_positional_parent_child_accessibility
            parent_accessibility predecessor
    | CertifiedIntervalPositivePositionalFactorMembershipThere payload =>
        := \? head.
            _, _, _, _, tail_membership, _ = payload
        derive_ival_factor_membership_parent_accessibility
            tail_membership

:= ^ derive_ival_factor_membership_accessibility
    \* candidate start length.
    (membership :
        ival_factor_membership
            candidate start length)
    : positive_positional_nat candidate *
      positive_positional_predecessor_accessibility candidate =
    ?= membership ?|
    | CertifiedIntervalPositivePositionalFactorMembershipHere
        (candidate_value, _, _, _) =>
        candidate_value,
        derive_positive_positional_predecessor_accessibility candidate_value
    | CertifiedIntervalPositivePositionalFactorMembershipThere payload =>
        := \? head.
            _, _, _, _, tail_membership, _ = payload
        derive_ival_factor_membership_accessibility
            tail_membership

:| ival_membership_accessibility_authority candidate start length =
    | CertifiedIntervalPositivePositionalMembershipAccessibilityAuthority :: \* candidate start length.
        ival_factor_membership candidate start length *
        positive_positional_nat candidate *
        positive_positional_predecessor_accessibility candidate ->
        ival_membership_accessibility_authority candidate start length

:= derive_ival_membership_accessibility_authority \* candidate start length.
    (membership : ival_factor_membership candidate start length)
    : ival_membership_accessibility_authority candidate start length =
    := candidate_value, accessibility =
        derive_ival_factor_membership_accessibility membership
    CertifiedIntervalPositivePositionalMembershipAccessibilityAuthority (
        membership, candidate_value, accessibility)

:= ival_membership_accessibility_authority_inputs \* candidate start length.
    (authority : ival_membership_accessibility_authority candidate start length)
    : positive_positional_nat candidate * positive_positional_predecessor_accessibility candidate =
    ?= authority ?|
    | CertifiedIntervalPositivePositionalMembershipAccessibilityAuthority (_, candidate_value, accessibility) =>
        candidate_value, accessibility

:| ival_accessible_step_prime_derivation natural =
    | CertifiedIntervalPositivePositionalAccessibleStepPrimeDerivation :: \* natural.
        (\? length predecessor.
            positive_positional_nat natural *
            positive_positional_factor_candidate_nonunit natural *
            ival_all_rejected
                natural natural length *
            positive_positional_predecessor natural predecessor *
            positive_positional_less predecessor natural *
            positive_positional_predecessor_accessibility predecessor *
            string * string) ->
        ival_accessible_step_prime_derivation natural

:= ival_accessible_step_prime_complete_tree \* natural.
    (derivation :
        ival_accessible_step_prime_derivation
            natural)
    : ival_complete_factorization_tree natural =
    ?= derivation ?|
    | CertifiedIntervalPositivePositionalAccessibleStepPrimeDerivation payload =>
        := \? length predecessor.
            prime_value, prime_nonunit, rejected,
            _, _, _, prime_note, _ = payload
        CertifiedIntervalPositivePositionalCompletePrime (\? (
            prime_value,
            prime_nonunit,
            rejected,
            prime_note))

:= assert_ival_accessible_step_prime_runtime
    (nodes : i64) (primes : i64) (splits : i64)
    (root : i64) (blocked : i64)
    : ()
    =
    := ok_0 = !!!!EQ(nodes, 1i64)
    := ok_1 = !!!!EQ(primes, 1i64)
    := ok_2 = !!!!EQ(splits, 0i64)
    := ok_3 = !!!!EQ(root, 3i64)
    := ok_4 = !!!!EQ(blocked, 0i64)
    ? ok_0 && ok_1 && ok_2 && ok_3 && ok_4
    ?> ()
    |: mega_runtime_fail "certified-interval-positive-positional-accessible-step-prime-runtime-mismatch"

:| ival_child_recursion_authority candidate start length =
    | CertifiedIntervalPositivePositionalChildRecursionAuthority :: \* candidate start length.
        ival_factor_membership candidate start length *
        positive_positional_nat candidate *
        ival_recursive_descent start candidate *
        positive_positional_predecessor_accessibility start *
        positive_positional_predecessor_accessibility candidate * string ->
        ival_child_recursion_authority candidate start length

:= derive_ival_child_recursion_authority \* candidate start length.
    (membership : ival_factor_membership candidate start length)
    (descent : ival_recursive_descent start candidate)
    (parent_accessibility : positive_positional_predecessor_accessibility start)
    : ival_child_recursion_authority candidate start length
    =
    := candidate_value =
        ival_factor_membership_candidate_value membership
    CertifiedIntervalPositivePositionalChildRecursionAuthority (
        membership,
        candidate_value,
        descent,
        parent_accessibility,
        derive_positive_positional_predecessor_accessibility candidate_value,
        "one-child-recursion-authority-carries-membership-value-strict-descent-and-both-the-exact-parent-and-child-"
        ^^ "accessibilities-in-one-indexed-payload"
    )

:= ival_child_recursion_authority_inputs \* candidate start length.
    (authority : ival_child_recursion_authority candidate start length)
    : positive_positional_nat candidate *
      ival_recursive_descent start candidate *
      positive_positional_predecessor_accessibility start *
      positive_positional_predecessor_accessibility candidate =
    ?= authority ?|
    | CertifiedIntervalPositivePositionalChildRecursionAuthority
        (_, candidate_value, descent, parent_accessibility, child_accessibility, _) =>
        candidate_value,
        descent,
        parent_accessibility,
        child_accessibility

:| ival_quotient_recursion_authority natural divisor quotient =
    | CertifiedIntervalPositivePositionalQuotientRecursionAuthority :: \* natural divisor quotient.
        value_synthesized_structural_division natural divisor quotient positional_zero *
        positive_positional_nat quotient *
        ival_recursive_descent natural quotient *
        positive_positional_predecessor_accessibility natural *
        positive_positional_predecessor_accessibility quotient * string ->
        ival_quotient_recursion_authority natural divisor quotient

:= ival_quotient_recursion_authority_inputs \* natural divisor quotient.
    (authority : ival_quotient_recursion_authority natural divisor quotient)
    : value_synthesized_structural_division natural divisor quotient positional_zero *
      positive_positional_nat quotient *
      ival_recursive_descent natural quotient *
      positive_positional_predecessor_accessibility natural *
      positive_positional_predecessor_accessibility quotient =
    ?= authority ?|
    | CertifiedIntervalPositivePositionalQuotientRecursionAuthority
        (division, quotient_value, quotient_descent, parent_accessibility, quotient_accessibility, _) =>
        division,
        quotient_value,
        quotient_descent,
        parent_accessibility,
        quotient_accessibility

:| ival_composite_recursion_authority child length divisor quotient =
    | CertifiedIntervalPositivePositionalCompositeRecursionAuthority :: \* child length divisor quotient.
        ival_factor_membership divisor child length *
        value_synthesized_structural_division child divisor quotient positional_zero *
        positive_positional_nat quotient *
        ival_recursive_descent child divisor *
        ival_recursive_descent child quotient *
        positive_positional_predecessor_accessibility child * string ->
        ival_composite_recursion_authority child length divisor quotient

:= ival_composite_recursion_authority_inputs
    \* child length divisor quotient.
    (authority :
        ival_composite_recursion_authority
            child length divisor quotient)
    : ival_factor_membership divisor child length *
      value_synthesized_structural_division child divisor quotient positional_zero *
      positive_positional_nat quotient *
      ival_recursive_descent child divisor *
      ival_recursive_descent child quotient *
      positive_positional_predecessor_accessibility child =
    ?= authority ?|
    | CertifiedIntervalPositivePositionalCompositeRecursionAuthority
        (membership, division, quotient_value, divisor_descent, quotient_descent,
            parent_accessibility, _) =>
        membership, division, quotient_value, divisor_descent, quotient_descent,
        parent_accessibility

:= ival_composite_recursion_authority_recursive_inputs
    \* child length divisor quotient.
    (authority :
        ival_composite_recursion_authority
            child length divisor quotient)
    : positive_positional_nat divisor *
      ival_recursive_descent child divisor *
      positive_positional_predecessor_accessibility divisor *
      value_synthesized_structural_division child divisor quotient positional_zero *
      positive_positional_nat quotient *
      ival_recursive_descent child quotient *
      positive_positional_predecessor_accessibility quotient =
    := membership, division, quotient_value, divisor_descent, quotient_descent,
        parent_accessibility =
        ival_composite_recursion_authority_inputs authority
    := divisor_authority =
        derive_ival_child_recursion_authority
            membership divisor_descent parent_accessibility
    := divisor_value, derived_divisor_descent, _, divisor_accessibility =
        ival_child_recursion_authority_inputs
            divisor_authority
    := quotient_authority :
        ival_quotient_recursion_authority
            child divisor quotient =
        CertifiedIntervalPositivePositionalQuotientRecursionAuthority (
            division,
            quotient_value,
            quotient_descent,
            parent_accessibility,
            derive_positive_positional_predecessor_accessibility quotient_value,
            "the-composite-authority-derives-the-quotient-authority-from-its-own-division-value-descent-and-stores-"
            ^^ "both-parent-and-quotient-accessibilities"
        )
    := derived_division, derived_quotient_value,
        derived_quotient_descent, _, quotient_accessibility =
        ival_quotient_recursion_authority_inputs
            quotient_authority
    divisor_value, derived_divisor_descent, divisor_accessibility,
    derived_division, derived_quotient_value,
    derived_quotient_descent, quotient_accessibility

:= ^ ival_accessible_child_completion \* child.
    (child_value : positive_positional_nat child)
    (accessibility : positive_positional_predecessor_accessibility child)
    : ival_complete_factorization_tree child =
    ?= accessibility ?|
    | PositivePositionalPredecessorAccessibilityOne _ =>
        CertifiedIntervalPositivePositionalCompleteUnit
    | PositivePositionalPredecessorAccessibilityStep step_payload =>
        ?=
            classify_ival_sealed_factor
                child_value
        ?|
        | CertifiedIntervalPositivePositionalSealedPrimeClass prime_payload =>
            := \? length.
                prime_material, prime_nonunit, rejected, prime_note = prime_payload
            := \? predecessor.
                predecessor_proof,
                predecessor_accessibility, step_note = step_payload
            := predecessor_less =
                positive_positional_predecessor_implies_less predecessor_proof
            ival_accessible_step_prime_complete_tree
                (CertifiedIntervalPositivePositionalAccessibleStepPrimeDerivation (\? (
                    prime_material,
                    prime_nonunit,
                    rejected,
                    predecessor_proof,
                    predecessor_less,
                    predecessor_accessibility,
                    prime_note,
                    step_note)))
        | CertifiedIntervalPositivePositionalSealedCompositeClass composite_payload =>
            := \? length divisor quotient.
                root_value, divisor_value, quotient_value,
                membership, division, composite_note = composite_payload
            := sealed_children :
                ival_sealed_composite_children
                    child divisor quotient =
                CertifiedIntervalPositivePositionalSealedCompositeChildren (\? (
                    root_value,
                    divisor_value,
                    quotient_value,
                    membership,
                    division,
                    composite_note))
            := divisor_descent =
                derive_ival_membership_recursive_descent
                    root_value membership
            := quotient_descent =
                derive_ival_quotient_recursive_descent_from_children
                    sealed_children
            := composite_authority :
                ival_composite_recursion_authority
                    child length divisor quotient =
                CertifiedIntervalPositivePositionalCompositeRecursionAuthority (
                    membership,
                    division,
                    quotient_value,
                    divisor_descent,
                    quotient_descent,
                    accessibility,
                    "one-composite-recursion-authority-carries-the-classification-facts-and-the-exact-parent-access"
                    ^^ "ibility-then-derives-both-child-authorities-internally"
                )
            := paired_divisor_value, paired_divisor_descent,
                paired_divisor_accessibility, authority_division,
                authority_quotient_value, authority_quotient_descent,
                quotient_accessibility =
                ival_composite_recursion_authority_recursive_inputs
                    composite_authority
            := left_tree =
                ival_accessible_child_completion
                    paired_divisor_value paired_divisor_accessibility
            := right_tree =
                ival_accessible_child_completion
                    authority_quotient_value quotient_accessibility
            CertifiedIntervalPositivePositionalCompleteSplit (
                \? (
                    root_value,
                    paired_divisor_value,
                    authority_quotient_value,
                    membership,
                    authority_division,
                    paired_divisor_descent,
                    authority_quotient_descent,
                    left_tree,
                    right_tree,
                    "the-composite-accessibility-branch-now-returns-a-total-tree-directly-from-two-authority-govern"
                    ^^ "ed-recursive-child-trees-with-no-success-or-refusal-wrapper"
                )
            )

:= alternate_six_complete_factorization_tree () :
    ival_complete_factorization_tree
        (positional_zero_bit (positional_one_bit positional_one)) =
    := root_value = positive_positional_six_value ()
    := divisor_value = positive_positional_two_value ()
    := quotient_value = positive_positional_three_value ()
    := membership = alternate_two_in_six_membership ()
    := division = alternate_six_div_two ()
    := children :
        ival_sealed_composite_children
            (positional_zero_bit (positional_one_bit positional_one))
            (positional_zero_bit positional_one)
            (positional_one_bit positional_one) =
        CertifiedIntervalPositivePositionalSealedCompositeChildren (\? (
            root_value,
            divisor_value,
            quotient_value,
            membership,
            division,
            "the-alternate-six-tree-seals-the-two-by-three-decomposition"))
    := divisor_descent =
        derive_ival_membership_recursive_descent
            root_value membership
    := quotient_descent =
        derive_ival_quotient_recursive_descent_from_children
            children
    := left_tree =
        ival_accessible_child_completion
            divisor_value
            (derive_positive_positional_predecessor_accessibility divisor_value)
    := right_tree =
        ival_accessible_child_completion
            quotient_value
            (derive_positive_positional_predecessor_accessibility quotient_value)
    CertifiedIntervalPositivePositionalCompleteSplit (\? (
        root_value,
        divisor_value,
        quotient_value,
        membership,
        division,
        divisor_descent,
        quotient_descent,
        left_tree,
        right_tree,
        "six-now-has-an-independent-two-times-three-complete-tree-beside-the-search-selected-tree"))

:= ival_accessible_child_unit_complete_tree
    (child_value : positive_positional_nat positional_one)
    (accessibility : positive_positional_predecessor_accessibility positional_one)
    : ival_complete_factorization_tree positional_one =
    ?= child_value, accessibility ?|
    | PositivePositionalOne, PositivePositionalPredecessorAccessibilityOne _ =>
        CertifiedIntervalPositivePositionalCompleteUnit

:= derive_positive_positional_quotient_accessibility \* dividend divisor quotient remainder.
    (division : positive_positional_euclidean_division dividend divisor quotient remainder)
    : positive_positional_nat quotient *
      positive_positional_predecessor_accessibility quotient =
    ?= division ?|
    | PositivePositionalEuclideanDivision payload =>
        := \? product. multiplication, _, _ = payload
        := quotient_value =
            positive_positional_multiply_left_value multiplication
        quotient_value,
        derive_positive_positional_predecessor_accessibility quotient_value

:= positional_four_div_three () :
    positive_positional_euclidean_division
        (positional_zero_bit (positional_zero_bit positional_one))
        (positional_one_bit positional_one)
        positional_one
        positional_one =
    PositivePositionalEuclideanDivision (\? (
        positional_one_times_three (),
        positional_three_plus_one (),
        positional_one_less_three ()))

:= derive_positive_positional_two_stage_quotient_accessibility
    \* dividend first_divisor middle first_remainder second_divisor quotient second_remainder.
    (first : positive_positional_euclidean_division dividend first_divisor middle first_remainder)
    (second : positive_positional_euclidean_division middle second_divisor quotient second_remainder)
    : positive_positional_nat middle *
      positive_positional_predecessor_accessibility middle *
      positive_positional_nat quotient *
      positive_positional_predecessor_accessibility quotient =
    := middle_value, middle_accessibility =
        derive_positive_positional_quotient_accessibility first
    := quotient_value, quotient_accessibility =
        derive_positive_positional_quotient_accessibility second
    middle_value, middle_accessibility,
    quotient_value, quotient_accessibility

:= positional_fourteen_div_nine () :
    positive_positional_euclidean_division
        (positional_zero_bit
            (positional_one_bit
                (positional_one_bit positional_one)))
        (positional_one_bit
            (positional_zero_bit
                (positional_zero_bit positional_one)))
        positional_one
        (positional_one_bit (positional_zero_bit positional_one)) =
    PositivePositionalEuclideanDivision (\? (
        positional_one_times_nine (),
        positional_nine_plus_five (),
        positional_five_less_nine ()))

:= flatten_positive_positional_two_stage_quotient_chain
    (first :
        positive_positional_euclidean_division
            (positional_zero_bit (positional_one_bit (positional_one_bit positional_one)))
            (positional_one_bit positional_one)
            (positional_zero_bit (positional_zero_bit positional_one))
            (positional_zero_bit positional_one))
    (second :
        positive_positional_euclidean_division
            (positional_zero_bit (positional_zero_bit positional_one))
            (positional_one_bit positional_one)
            positional_one positional_one)
    : positive_positional_euclidean_division
        (positional_zero_bit (positional_one_bit (positional_one_bit positional_one)))
        (positional_one_bit (positional_zero_bit (positional_zero_bit positional_one))) positional_one
        (positional_one_bit (positional_zero_bit positional_one))
    =
    ?= first, second ?|
    | PositivePositionalEuclideanDivision _,
      PositivePositionalEuclideanDivision _ =>
        positional_fourteen_div_nine ()

:= ^ ival_factor_membership_to_transitive_path
    \* candidate start length.
    (membership :
        ival_factor_membership
            candidate start length)
    : positive_positional_transitive_predecessor_path start candidate =
    ?= membership ?|
    | CertifiedIntervalPositivePositionalFactorMembershipHere
        (candidate_value, _, predecessor, _) =>
        PositivePositionalTransitivePredecessorPathStep (\? (
            candidate_value,
            predecessor,
            positive_positional_predecessor_implies_less predecessor,
            PositivePositionalTransitivePredecessorPathDone candidate_value))
    | CertifiedIntervalPositivePositionalFactorMembershipThere payload =>
        := \? head.
            _, head_value, _, predecessor, tail_membership, _ = payload
        PositivePositionalTransitivePredecessorPathStep (\? (
            head_value,
            predecessor,
            positive_positional_predecessor_implies_less predecessor,
            ival_factor_membership_to_transitive_path
                tail_membership))

:= ival_factor_membership_to_strict_path
    \* candidate start length.
    (membership : ival_factor_membership candidate start length)
    : positive_positional_strict_predecessor_path start candidate =
    ?= membership ?|
    | CertifiedIntervalPositivePositionalFactorMembershipHere
        (candidate_value, _, predecessor, _) =>
        PositivePositionalStrictPredecessorPathOne (
            candidate_value,
            predecessor,
            positive_positional_predecessor_implies_less predecessor)
    | CertifiedIntervalPositivePositionalFactorMembershipThere payload =>
        := \? head.
            _, head_value, _, predecessor, tail_membership, _ = payload
        PositivePositionalStrictPredecessorPathMore (\? (
            head_value,
            predecessor,
            positive_positional_predecessor_implies_less predecessor,
            ival_factor_membership_to_transitive_path
                tail_membership))

:| ival_membership_recursion_authority candidate start length =
    | CertifiedIntervalPositivePositionalMembershipRecursionAuthority :: \* candidate start length.
        ival_factor_membership candidate start length *
        positive_positional_transitive_predecessor_path start candidate *
        positive_positional_nat candidate *
        positive_positional_parent_derived_child_accessibility candidate * string ->
        ival_membership_recursion_authority candidate start length

:= derive_ival_membership_recursion_authority \* candidate start length.
    (membership : ival_factor_membership candidate start length)
    : ival_membership_recursion_authority candidate start length
    =
    := parent_derived_accessibility =
        derive_ival_factor_membership_parent_accessibility membership
    := candidate_value =
        ival_factor_membership_candidate_value membership
    CertifiedIntervalPositivePositionalMembershipRecursionAuthority (
        membership,
        ival_factor_membership_to_transitive_path membership,
        candidate_value,
        parent_derived_accessibility,
        "one-membership-proof-derives-path-and-parent-derived-accessibility-without-rebuilding-literal-child-access"
        ^^ "ibility"
    )

:= ival_membership_recursion_authority_path \* candidate start length.
    (authority : ival_membership_recursion_authority candidate start length)
    : positive_positional_transitive_predecessor_path start candidate =
    ?= authority ?|
    | CertifiedIntervalPositivePositionalMembershipRecursionAuthority
        (_, path, _, _, _) =>
        path

:= ival_membership_recursion_authority_value \* candidate start length.
    (authority : ival_membership_recursion_authority candidate start length)
    : positive_positional_nat candidate =
    ?= authority ?|
    | CertifiedIntervalPositivePositionalMembershipRecursionAuthority
        (_, _, candidate_value, _, _) =>
        candidate_value

:= ival_membership_recursion_authority_parent_derived_accessibility \* candidate
    start length.
    (authority : ival_membership_recursion_authority candidate start length)
    : positive_positional_parent_derived_child_accessibility candidate
    =
    ?= authority ?|
    | CertifiedIntervalPositivePositionalMembershipRecursionAuthority
        (_, _, _, parent_derived_accessibility, _) =>
        parent_derived_accessibility

:= assert_ival_factor_membership_accessibility_runtime
    (first_root : i64) (first_divisor : i64)
    (first_membership_nodes : i64) (first_membership_edges : i64)
    (first_accessibility_nodes : i64) (first_accessibility_edges : i64)
    (first_joined_nodes : i64) (first_joined_edges : i64)
    (second_root : i64) (second_divisor : i64)
    (second_membership_nodes : i64) (second_membership_edges : i64)
    (second_accessibility_nodes : i64) (second_accessibility_edges : i64)
    (second_joined_nodes : i64) (second_joined_edges : i64)
    : ()
    =
    := ok_0 = !!!!EQ(first_root, 12i64)
    := ok_1 = !!!!EQ(first_divisor, 6i64)
    := ok_2 = !!!!EQ(first_membership_nodes, 7i64)
    := ok_3 = !!!!EQ(first_membership_edges, 6i64)
    := ok_4 = !!!!EQ(first_accessibility_nodes, 6i64)
    := ok_5 = !!!!EQ(first_accessibility_edges, 5i64)
    := ok_6 = !!!!EQ(first_joined_nodes, 12i64)
    := ok_7 = !!!!EQ(first_joined_edges, 11i64)
    := ok_8 = !!!!EQ(second_root, 18i64)
    := ok_9 = !!!!EQ(second_divisor, 9i64)
    := ok_10 = !!!!EQ(second_membership_nodes, 10i64)
    := ok_11 = !!!!EQ(second_membership_edges, 9i64)
    := ok_12 = !!!!EQ(second_accessibility_nodes, 9i64)
    := ok_13 = !!!!EQ(second_accessibility_edges, 8i64)
    := ok_14 = !!!!EQ(second_joined_nodes, 18i64)
    := ok_15 = !!!!EQ(second_joined_edges, 17i64)
    ?
        ok_0
        && ok_1
        && ok_2
        && ok_3
        && ok_4
        && ok_5
        && ok_6
        && ok_7
        && ok_8
        && ok_9
        && ok_10
        && ok_11
        && ok_12
        && ok_13
        && ok_14
        && ok_15
    ?> ()
    |: mega_runtime_fail "certified-interval-positive-positional-factor-membership-accessibility-runtime-mismatch"

:= value_synthesized_structural_division_quotient_value
    \* dividend divisor quotient remainder.
    (division :
        value_synthesized_structural_division
            dividend divisor quotient remainder)
    : nonnegative_positional_nat quotient =
    ?= division ?|
    | ValueSynthesizedStructuralDivisionLess _ =>
        NonnegativePositionalZero
    | ValueSynthesizedStructuralDivisionEqual _ =>
        NonnegativePositionalPositive PositivePositionalOne
    | ValueSynthesizedStructuralDivisionStep payload =>
        := \? reduced previous_quotient.
            _, _, _, _, successor = payload
        nonnegative_positional_successor_output_value successor

:= assert_ival_division_accessible_quotient_runtime
    (first_claimed : i64) (first_projected : i64)
    (first_nodes : i64) (first_primes : i64)
    (first_splits : i64) (first_root : i64) (first_blocked : i64)
    (second_claimed : i64) (second_projected : i64)
    (second_nodes : i64) (second_primes : i64)
    (second_splits : i64) (second_root : i64) (second_blocked : i64)
    : ()
    =
    := ok_0 = !!!!EQ(first_claimed, 2i64)
    := ok_1 = !!!!EQ(first_projected, 2i64)
    := ok_2 = !!!!EQ(first_nodes, 1i64)
    := ok_3 = !!!!EQ(first_primes, 1i64)
    := ok_4 = !!!!EQ(first_splits, 0i64)
    := ok_5 = !!!!EQ(first_root, 2i64)
    := ok_6 = !!!!EQ(first_blocked, 0i64)
    := ok_7 = !!!!EQ(second_claimed, 2i64)
    := ok_8 = !!!!EQ(second_projected, 2i64)
    := ok_9 = !!!!EQ(second_nodes, 1i64)
    := ok_10 = !!!!EQ(second_primes, 1i64)
    := ok_11 = !!!!EQ(second_splits, 0i64)
    := ok_12 = !!!!EQ(second_root, 2i64)
    := ok_13 = !!!!EQ(second_blocked, 0i64)
    ? ok_0 && ok_1 && ok_2 && ok_3 && ok_4 && ok_5 && ok_6 && ok_7 && ok_8 && ok_9 && ok_10 && ok_11 && ok_12 && ok_13
    ?> ()
    |: mega_runtime_fail "certified-interval-positive-positional-division-accessible-quotient-runtime-mismatch"

:| ival_first_run_multiplicity_indexed_profile head shape =
    | CertifiedIntervalPositivePositionalFirstRunMultiplicityIndexedProfileLast :: \* head.
        ival_indexed_prime_cell head ->
        ival_first_run_multiplicity_indexed_profile
            head (ival_first_run_multiplicity_shape_last head)
    | CertifiedIntervalPositivePositionalFirstRunMultiplicityIndexedProfileMore :: \* head.
        (\? next.
            ival_indexed_prime_cell head *
            positive_positional_equal head next *
            ival_prime_multiplicity_run_from next) ->
        ival_first_run_multiplicity_indexed_profile
            head (ival_first_run_multiplicity_shape_more head)

:| ival_any_first_run_multiplicity_indexed_profile head =
    | CertifiedIntervalPositivePositionalAnyFirstRunMultiplicityIndexedProfile :: \* head.
        (\? shape.
            ival_first_run_multiplicity_indexed_profile head shape) ->
        ival_any_first_run_multiplicity_indexed_profile head

:= index_ival_first_run_multiplicity \* head.
    (run : ival_prime_multiplicity_run_from head)
    : ival_any_first_run_multiplicity_indexed_profile head =
    ?= run ?|
    | CertifiedIntervalPositivePositionalPrimeMultiplicityRunLast cell =>
        CertifiedIntervalPositivePositionalAnyFirstRunMultiplicityIndexedProfile (\? (
            CertifiedIntervalPositivePositionalFirstRunMultiplicityIndexedProfileLast cell))
    | CertifiedIntervalPositivePositionalPrimeMultiplicityRunMore payload =>
        CertifiedIntervalPositivePositionalAnyFirstRunMultiplicityIndexedProfile (\? (
            CertifiedIntervalPositivePositionalFirstRunMultiplicityIndexedProfileMore payload))

:= index_ival_normal_form_first_run_multiplicity \* head.
    (normal : ival_prime_multiplicity_normal_form_from head)
    : ival_any_first_run_multiplicity_indexed_profile head =
    ?= normal ?|
    | CertifiedIntervalPositivePositionalPrimeMultiplicityNormalFormLast run =>
        index_ival_first_run_multiplicity run
    | CertifiedIntervalPositivePositionalPrimeMultiplicityNormalFormMore payload =>
        := \? next. run, _, _ = payload
        index_ival_first_run_multiplicity run

:= ival_first_run_multiplicity_shape_runtime \* head shape.
    (profile : ival_first_run_multiplicity_indexed_profile head shape)
    : i64 =
    ?= profile ?|
    | CertifiedIntervalPositivePositionalFirstRunMultiplicityIndexedProfileLast _ => 1i64
    | CertifiedIntervalPositivePositionalFirstRunMultiplicityIndexedProfileMore _ => 2i64

:| ival_outer_indexed_canonical_profile shape =
    | CertifiedIntervalPositivePositionalOuterIndexedCanonicalProfileDone ::
        ival_outer_indexed_canonical_profile
            ival_canonical_profile_outer_shape_done
    | CertifiedIntervalPositivePositionalOuterIndexedCanonicalProfileSome :: \* head.
        ival_prime_multiplicity_normal_form_from head ->
        ival_outer_indexed_canonical_profile
            (ival_canonical_profile_outer_shape_some head)

:| ival_any_outer_indexed_canonical_profile =
    | CertifiedIntervalPositivePositionalAnyOuterIndexedCanonicalProfile ::
        (\? shape.
            ival_outer_indexed_canonical_profile shape) ->
        ival_any_outer_indexed_canonical_profile

:= index_ival_canonical_profile_outer_shape
    (normal : ival_prime_multiplicity_normal_form)
    : ival_any_outer_indexed_canonical_profile =
    ?= normal ?|
    | CertifiedIntervalPositivePositionalPrimeMultiplicityNormalFormDone =>
        CertifiedIntervalPositivePositionalAnyOuterIndexedCanonicalProfile (\? (
            CertifiedIntervalPositivePositionalOuterIndexedCanonicalProfileDone))
    | CertifiedIntervalPositivePositionalPrimeMultiplicityNormalFormSome payload =>
        := \? head. grouped = payload
        CertifiedIntervalPositivePositionalAnyOuterIndexedCanonicalProfile (\? (
            CertifiedIntervalPositivePositionalOuterIndexedCanonicalProfileSome grouped))

:| ival_same_root_factorization_pair natural =
    | CertifiedIntervalPositivePositionalSameRootFactorizationPair :: \* natural.
        ival_complete_factorization_tree natural *
        ival_complete_factorization_tree natural ->
        ival_same_root_factorization_pair natural

:| ival_rooted_canonical_profile natural =
    | CertifiedIntervalPositivePositionalRootedCanonicalProfile :: \* natural.
        ival_complete_reconstruction natural ->
        ival_rooted_canonical_profile natural

:= ival_rooted_canonical_profile_normal_form \* natural.
    (profile : ival_rooted_canonical_profile natural)
    : ival_prime_multiplicity_normal_form =
    ?= profile ?|
    | CertifiedIntervalPositivePositionalRootedCanonicalProfile reconstruction =>
        compress_ival_ordered_prime_sequence (
            canonicalize_ival_complete_prime_sequence (
                project_ival_complete_reconstruction_prime_sequence
                    reconstruction))

:| ival_product_indexed_normal_form natural =
    | CertifiedIntervalPositivePositionalProductIndexedNormalForm :: \* natural.
        ival_rooted_canonical_profile natural ->
        ival_product_indexed_normal_form natural

:= ival_product_indexed_normal_form_from_rooted \* natural.
    (profile : ival_rooted_canonical_profile natural)
    : ival_product_indexed_normal_form natural =
    CertifiedIntervalPositivePositionalProductIndexedNormalForm profile

:= ival_product_indexed_normal_form_project \* natural.
    (indexed : ival_product_indexed_normal_form natural)
    : ival_prime_multiplicity_normal_form =
    ?= indexed ?|
    | CertifiedIntervalPositivePositionalProductIndexedNormalForm profile =>
        ival_rooted_canonical_profile_normal_form profile

:! ival_same_root_canonical_profile_pair natural =
    ival_same_root_factorization_pair natural

:= ival_same_root_factorization_pair_canonical_profiles \* natural.
    (pair : ival_same_root_factorization_pair natural)
    : ival_same_root_canonical_profile_pair natural =
    ival_same_root_canonical_profile_pair pair

:= ival_same_root_canonical_profile_pair_left_profile \* natural.
    (authority : ival_same_root_canonical_profile_pair natural)
    : ival_rooted_canonical_profile natural =
    ?= authority ?|
    | ival_same_root_canonical_profile_pair pair =>
        ?= pair ?|
        | CertifiedIntervalPositivePositionalSameRootFactorizationPair (left_tree, _) =>
            CertifiedIntervalPositivePositionalRootedCanonicalProfile (
                reconstruct_ival_complete_factorization left_tree)

:= ival_same_root_canonical_profile_pair_right_profile \* natural.
    (authority : ival_same_root_canonical_profile_pair natural)
    : ival_rooted_canonical_profile natural =
    ?= authority ?|
    | ival_same_root_canonical_profile_pair pair =>
        ?= pair ?|
        | CertifiedIntervalPositivePositionalSameRootFactorizationPair (_, right_tree) =>
            CertifiedIntervalPositivePositionalRootedCanonicalProfile (
                reconstruct_ival_complete_factorization right_tree)

:= ival_same_root_canonical_profile_pair_left \* natural.
    (authority : ival_same_root_canonical_profile_pair natural)
    : ival_prime_multiplicity_normal_form =
    ival_rooted_canonical_profile_normal_form
        (ival_same_root_canonical_profile_pair_left_profile authority)

:= ival_same_root_canonical_profile_pair_right \* natural.
    (authority : ival_same_root_canonical_profile_pair natural)
    : ival_prime_multiplicity_normal_form =
    ival_rooted_canonical_profile_normal_form
        (ival_same_root_canonical_profile_pair_right_profile authority)

:! ival_same_root_product_indexed_normal_form_pair natural =
    ival_same_root_canonical_profile_pair natural *
    ival_product_indexed_normal_form natural *
    ival_product_indexed_normal_form natural

:= ival_same_root_product_indexed_normal_form_pair_from_authority \* natural.
    (authority : ival_same_root_canonical_profile_pair natural)
    : ival_same_root_product_indexed_normal_form_pair natural =
    := left = ival_product_indexed_normal_form_from_rooted (
        ival_same_root_canonical_profile_pair_left_profile authority)
    := right = ival_product_indexed_normal_form_from_rooted (
        ival_same_root_canonical_profile_pair_right_profile authority)
    ival_same_root_product_indexed_normal_form_pair (
        authority,
        left,
        right)

:| ^ ival_prime_multiplicity_run_agreement left right =
    | CertifiedIntervalPositivePositionalPrimeMultiplicityRunAgreementLast :: \* left right.
        ival_indexed_prime_cell left *
        ival_indexed_prime_cell right *
        positive_positional_equal left right ->
        ival_prime_multiplicity_run_agreement left right
    | CertifiedIntervalPositivePositionalPrimeMultiplicityRunAgreementMore :: \* left right.
        (\? left_next right_next.
            ival_indexed_prime_cell left *
            positive_positional_equal left left_next *
            ival_indexed_prime_cell right *
            positive_positional_equal right right_next *
            positive_positional_equal left right *
            ival_prime_multiplicity_run_agreement
                left_next right_next) ->
        ival_prime_multiplicity_run_agreement left right

:= ^ ival_prime_multiplicity_run_agreement_reflexive \* natural.
    (run : ival_prime_multiplicity_run_from natural) :
    ival_prime_multiplicity_run_agreement natural natural =
    ?= run ?|
    | CertifiedIntervalPositivePositionalPrimeMultiplicityRunLast cell =>
        CertifiedIntervalPositivePositionalPrimeMultiplicityRunAgreementLast (
            cell,
            cell,
            positive_positional_equal_reflexive (ival_indexed_prime_cell_value cell))
    | CertifiedIntervalPositivePositionalPrimeMultiplicityRunMore payload =>
        := \? next. cell, equal_next, tail = payload
        CertifiedIntervalPositivePositionalPrimeMultiplicityRunAgreementMore (\? (
            cell,
            equal_next,
            cell,
            equal_next,
            positive_positional_equal_reflexive (ival_indexed_prime_cell_value cell),
            ival_prime_multiplicity_run_agreement_reflexive tail))

:= ^ ival_prime_multiplicity_run_agreement_symmetry \* left right.
    (agreement : ival_prime_multiplicity_run_agreement left right) :
    ival_prime_multiplicity_run_agreement right left =
    ?= agreement ?|
    | CertifiedIntervalPositivePositionalPrimeMultiplicityRunAgreementLast (left_cell, right_cell, equal) =>
        CertifiedIntervalPositivePositionalPrimeMultiplicityRunAgreementLast (
            right_cell,
            left_cell,
            positive_positional_equal_symmetry equal)
    | CertifiedIntervalPositivePositionalPrimeMultiplicityRunAgreementMore payload =>
        := \? left_next right_next. left_cell, left_equal, right_cell, right_equal, head_equal, tail = payload
        CertifiedIntervalPositivePositionalPrimeMultiplicityRunAgreementMore (\? (
            right_cell,
            right_equal,
            left_cell,
            left_equal,
            positive_positional_equal_symmetry head_equal,
            ival_prime_multiplicity_run_agreement_symmetry tail))

:| ^ ival_prime_multiplicity_run_mismatch left right =
    | CertifiedIntervalPositivePositionalPrimeMultiplicityRunMismatchHeadLess :: \* left right.
        positive_positional_less left right ->
        ival_prime_multiplicity_run_mismatch left right
    | CertifiedIntervalPositivePositionalPrimeMultiplicityRunMismatchHeadGreater :: \* left right.
        positive_positional_less right left ->
        ival_prime_multiplicity_run_mismatch left right
    | CertifiedIntervalPositivePositionalPrimeMultiplicityRunMismatchLeftLastRightMore :: \* left right.
        (\? right_next.
            ival_indexed_prime_cell left *
            ival_indexed_prime_cell right *
            positive_positional_equal right right_next *
            ival_prime_multiplicity_run_from right_next) ->
        ival_prime_multiplicity_run_mismatch left right
    | CertifiedIntervalPositivePositionalPrimeMultiplicityRunMismatchLeftMoreRightLast :: \* left right.
        (\? left_next.
            ival_indexed_prime_cell left *
            positive_positional_equal left left_next *
            ival_prime_multiplicity_run_from left_next *
            ival_indexed_prime_cell right) ->
        ival_prime_multiplicity_run_mismatch left right
    | CertifiedIntervalPositivePositionalPrimeMultiplicityRunMismatchTail :: \* left right.
        (\? left_next right_next.
            ival_indexed_prime_cell left *
            positive_positional_equal left left_next *
            ival_prime_multiplicity_run_from left_next *
            ival_indexed_prime_cell right *
            positive_positional_equal right right_next *
            ival_prime_multiplicity_run_from right_next *
            positive_positional_equal left right *
            ival_prime_multiplicity_run_mismatch left_next right_next) ->
        ival_prime_multiplicity_run_mismatch left right

:= ^ ival_prime_multiplicity_run_mismatch_note \* left right.
    (mismatch : ival_prime_multiplicity_run_mismatch left right) : string =
    ?= mismatch ?|
    | CertifiedIntervalPositivePositionalPrimeMultiplicityRunMismatchHeadLess _ =>
        "prime-values-differ-left-less-than-right"
    | CertifiedIntervalPositivePositionalPrimeMultiplicityRunMismatchHeadGreater _ =>
        "prime-values-differ-left-greater-than-right"
    | CertifiedIntervalPositivePositionalPrimeMultiplicityRunMismatchLeftLastRightMore _ =>
        "run-multiplicities-left-last-right-more"
    | CertifiedIntervalPositivePositionalPrimeMultiplicityRunMismatchLeftMoreRightLast _ =>
        "run-multiplicities-left-more-right-last"
    | CertifiedIntervalPositivePositionalPrimeMultiplicityRunMismatchTail payload =>
        := \? left_next right_next. _, _, _, _, _, _, _, tail_mismatch = payload
        ival_prime_multiplicity_run_mismatch_note tail_mismatch

:= ^ ival_prime_multiplicity_run_mismatch_symmetry \* left right.
    (mismatch : ival_prime_multiplicity_run_mismatch left right) :
    ival_prime_multiplicity_run_mismatch right left =
    ?= mismatch ?|
    | CertifiedIntervalPositivePositionalPrimeMultiplicityRunMismatchHeadLess less =>
        CertifiedIntervalPositivePositionalPrimeMultiplicityRunMismatchHeadGreater less
    | CertifiedIntervalPositivePositionalPrimeMultiplicityRunMismatchHeadGreater greater =>
        CertifiedIntervalPositivePositionalPrimeMultiplicityRunMismatchHeadLess greater
    | CertifiedIntervalPositivePositionalPrimeMultiplicityRunMismatchLeftLastRightMore payload =>
        := \? right_next. left_cell, right_cell, right_equal, right_tail = payload
        CertifiedIntervalPositivePositionalPrimeMultiplicityRunMismatchLeftMoreRightLast (\? (
            right_cell,
            right_equal,
            right_tail,
            left_cell))
    | CertifiedIntervalPositivePositionalPrimeMultiplicityRunMismatchLeftMoreRightLast payload =>
        := \? left_next. left_cell, left_equal, left_tail, right_cell = payload
        CertifiedIntervalPositivePositionalPrimeMultiplicityRunMismatchLeftLastRightMore (\? (
            right_cell,
            left_cell,
            left_equal,
            left_tail))
    | CertifiedIntervalPositivePositionalPrimeMultiplicityRunMismatchTail payload =>
        := \? left_next right_next.
            left_cell, left_equal, left_tail,
            right_cell, right_equal, right_tail,
            head_equal, tail_mismatch = payload
        CertifiedIntervalPositivePositionalPrimeMultiplicityRunMismatchTail (\? (
            right_cell,
            right_equal,
            right_tail,
            left_cell,
            left_equal,
            left_tail,
            positive_positional_equal_symmetry head_equal,
            ival_prime_multiplicity_run_mismatch_symmetry tail_mismatch))

:= ival_prime_multiplicity_run_mismatch_symmetry_terminal () : string =
    := mismatch :
        ival_prime_multiplicity_run_mismatch
            (positional_zero_bit positional_one)
            (positional_one_bit positional_one) =
        CertifiedIntervalPositivePositionalPrimeMultiplicityRunMismatchHeadLess (
            positional_two_less_three ())
    ?= ival_prime_multiplicity_run_mismatch_symmetry mismatch ?|
    | CertifiedIntervalPositivePositionalPrimeMultiplicityRunMismatchHeadGreater _ =>
        "run-mismatch-symmetry-now-reverses-a-real-two-less-than-three-indexed-mismatch-into-three-greater-than-two"
        ^^ "-and-recurses-through-typed-tail-mismatches"
    | _ => "run-mismatch-symmetry-unexpected-shape"

:| ival_prime_multiplicity_run_agreement_decision left right =
    | CertifiedIntervalPositivePositionalPrimeMultiplicityRunAgreementMatched :: \* left right.
        ival_prime_multiplicity_run_agreement left right ->
        ival_prime_multiplicity_run_agreement_decision left right
    | CertifiedIntervalPositivePositionalPrimeMultiplicityRunAgreementMismatch :: \* left right.
        ival_prime_multiplicity_run_mismatch left right ->
        ival_prime_multiplicity_run_agreement_decision left right

:= ^ decide_ival_prime_multiplicity_run_agreement \* left right.
    (left_run : ival_prime_multiplicity_run_from left)
    (right_run : ival_prime_multiplicity_run_from right)
    : ival_prime_multiplicity_run_agreement_decision left right =
    ?= left_run, right_run ?|
    | CertifiedIntervalPositivePositionalPrimeMultiplicityRunLast left_cell,
      CertifiedIntervalPositivePositionalPrimeMultiplicityRunLast right_cell =>
        := left_value =
            ival_indexed_prime_cell_value left_cell
        := right_value =
            ival_indexed_prime_cell_value right_cell
        ?= synthesize_positive_positional_order left_value right_value ?|
        | PositivePositionalOrderDecisionEqual equal =>
            CertifiedIntervalPositivePositionalPrimeMultiplicityRunAgreementMatched (
                CertifiedIntervalPositivePositionalPrimeMultiplicityRunAgreementLast (
                    left_cell,
                    right_cell,
                    equal))
        | PositivePositionalOrderDecisionLess less =>
            CertifiedIntervalPositivePositionalPrimeMultiplicityRunAgreementMismatch (
                CertifiedIntervalPositivePositionalPrimeMultiplicityRunMismatchHeadLess less)
        | PositivePositionalOrderDecisionGreater greater =>
            CertifiedIntervalPositivePositionalPrimeMultiplicityRunAgreementMismatch (
                CertifiedIntervalPositivePositionalPrimeMultiplicityRunMismatchHeadGreater greater)
    | CertifiedIntervalPositivePositionalPrimeMultiplicityRunMore left_payload,
      CertifiedIntervalPositivePositionalPrimeMultiplicityRunMore right_payload =>
        := \? left_next. left_cell, left_equal, left_tail = left_payload
        := \? right_next. right_cell, right_equal, right_tail = right_payload
        := left_value =
            ival_indexed_prime_cell_value left_cell
        := right_value =
            ival_indexed_prime_cell_value right_cell
        ?= synthesize_positive_positional_order left_value right_value ?|
        | PositivePositionalOrderDecisionEqual equal =>
            ?= decide_ival_prime_multiplicity_run_agreement
                    left_tail right_tail ?|
            | CertifiedIntervalPositivePositionalPrimeMultiplicityRunAgreementMatched tail =>
                CertifiedIntervalPositivePositionalPrimeMultiplicityRunAgreementMatched (
                    CertifiedIntervalPositivePositionalPrimeMultiplicityRunAgreementMore (\? (
                        left_cell,
                        left_equal,
                        right_cell,
                        right_equal,
                        equal,
                        tail)))
            | CertifiedIntervalPositivePositionalPrimeMultiplicityRunAgreementMismatch tail_mismatch =>
                CertifiedIntervalPositivePositionalPrimeMultiplicityRunAgreementMismatch (
                    CertifiedIntervalPositivePositionalPrimeMultiplicityRunMismatchTail (\? (
                        left_cell,
                        left_equal,
                        left_tail,
                        right_cell,
                        right_equal,
                        right_tail,
                        equal,
                        tail_mismatch)))
        | PositivePositionalOrderDecisionLess less =>
            CertifiedIntervalPositivePositionalPrimeMultiplicityRunAgreementMismatch (
                CertifiedIntervalPositivePositionalPrimeMultiplicityRunMismatchHeadLess less)
        | PositivePositionalOrderDecisionGreater greater =>
            CertifiedIntervalPositivePositionalPrimeMultiplicityRunAgreementMismatch (
                CertifiedIntervalPositivePositionalPrimeMultiplicityRunMismatchHeadGreater greater)
    | CertifiedIntervalPositivePositionalPrimeMultiplicityRunLast left_cell,
      CertifiedIntervalPositivePositionalPrimeMultiplicityRunMore right_payload =>
        := \? right_next. right_cell, right_equal, right_tail = right_payload
        CertifiedIntervalPositivePositionalPrimeMultiplicityRunAgreementMismatch (
            CertifiedIntervalPositivePositionalPrimeMultiplicityRunMismatchLeftLastRightMore (\? (
                left_cell,
                right_cell,
                right_equal,
                right_tail)))
    | CertifiedIntervalPositivePositionalPrimeMultiplicityRunMore left_payload,
      CertifiedIntervalPositivePositionalPrimeMultiplicityRunLast right_cell =>
        := \? left_next. left_cell, left_equal, left_tail = left_payload
        CertifiedIntervalPositivePositionalPrimeMultiplicityRunAgreementMismatch (
            CertifiedIntervalPositivePositionalPrimeMultiplicityRunMismatchLeftMoreRightLast (\? (
                left_cell,
                left_equal,
                left_tail,
                right_cell)))

:| ^ ival_prime_multiplicity_normal_form_agreement_from left right =
    | CertifiedIntervalPositivePositionalPrimeMultiplicityNormalFormAgreementLast :: \* left right.
        ival_prime_multiplicity_run_agreement left right ->
        ival_prime_multiplicity_normal_form_agreement_from left right
    | CertifiedIntervalPositivePositionalPrimeMultiplicityNormalFormAgreementMore :: \* left right.
        (\? left_next right_next.
            ival_prime_multiplicity_run_agreement left right *
            positive_positional_less left left_next *
            positive_positional_less right right_next *
            ival_prime_multiplicity_normal_form_agreement_from
                left_next right_next) ->
        ival_prime_multiplicity_normal_form_agreement_from left right

:= ^ ival_prime_multiplicity_normal_form_agreement_reflexive \* natural.
    (normal : ival_prime_multiplicity_normal_form_from natural) :
    ival_prime_multiplicity_normal_form_agreement_from natural natural =
    ?= normal ?|
    | CertifiedIntervalPositivePositionalPrimeMultiplicityNormalFormLast run =>
        CertifiedIntervalPositivePositionalPrimeMultiplicityNormalFormAgreementLast (
            ival_prime_multiplicity_run_agreement_reflexive run)
    | CertifiedIntervalPositivePositionalPrimeMultiplicityNormalFormMore payload =>
        := \? next. run, less, rest = payload
        CertifiedIntervalPositivePositionalPrimeMultiplicityNormalFormAgreementMore (\? (
            ival_prime_multiplicity_run_agreement_reflexive run,
            less,
            less,
            ival_prime_multiplicity_normal_form_agreement_reflexive rest))

:= ^ ival_prime_multiplicity_normal_form_agreement_symmetry \* left right.
    (agreement : ival_prime_multiplicity_normal_form_agreement_from left right) :
    ival_prime_multiplicity_normal_form_agreement_from right left =
    ?= agreement ?|
    | CertifiedIntervalPositivePositionalPrimeMultiplicityNormalFormAgreementLast run_agreement =>
        CertifiedIntervalPositivePositionalPrimeMultiplicityNormalFormAgreementLast (
            ival_prime_multiplicity_run_agreement_symmetry run_agreement)
    | CertifiedIntervalPositivePositionalPrimeMultiplicityNormalFormAgreementMore payload =>
        := \? left_next right_next. run_agreement, left_less, right_less, tail = payload
        CertifiedIntervalPositivePositionalPrimeMultiplicityNormalFormAgreementMore (\? (
            ival_prime_multiplicity_run_agreement_symmetry run_agreement,
            right_less,
            left_less,
            ival_prime_multiplicity_normal_form_agreement_symmetry tail))

:| ^ ival_prime_multiplicity_normal_form_mismatch_from left right =
    | CertifiedIntervalPositivePositionalPrimeMultiplicityNormalFormMismatchFromRun :: \* left right.
        ival_prime_multiplicity_run_mismatch left right ->
        ival_prime_multiplicity_normal_form_mismatch_from left right
    | CertifiedIntervalPositivePositionalPrimeMultiplicityNormalFormMismatchFromTail :: \* left right.
        (\? left_next right_next.
            ival_prime_multiplicity_run_agreement left right *
            positive_positional_less left left_next *
            positive_positional_less right right_next *
            ival_prime_multiplicity_normal_form_mismatch_from
                left_next right_next) ->
        ival_prime_multiplicity_normal_form_mismatch_from left right
    | CertifiedIntervalPositivePositionalPrimeMultiplicityNormalFormMismatchLeftLastRightMore :: \* left right.
        (\? right_next.
            ival_prime_multiplicity_run_from left *
            ival_prime_multiplicity_run_from right *
            positive_positional_less right right_next *
            ival_prime_multiplicity_normal_form_from right_next) ->
        ival_prime_multiplicity_normal_form_mismatch_from left right
    | CertifiedIntervalPositivePositionalPrimeMultiplicityNormalFormMismatchLeftMoreRightLast :: \* left right.
        (\? left_next.
            ival_prime_multiplicity_run_from left *
            positive_positional_less left left_next *
            ival_prime_multiplicity_normal_form_from left_next *
            ival_prime_multiplicity_run_from right) ->
        ival_prime_multiplicity_normal_form_mismatch_from left right

:= ^ ival_prime_multiplicity_normal_form_mismatch_from_note \* left right.
    (mismatch : ival_prime_multiplicity_normal_form_mismatch_from left right)
    : string
    =
    ?= mismatch ?|
    | CertifiedIntervalPositivePositionalPrimeMultiplicityNormalFormMismatchFromRun run_mismatch =>
        ival_prime_multiplicity_run_mismatch_note run_mismatch
    | CertifiedIntervalPositivePositionalPrimeMultiplicityNormalFormMismatchFromTail payload =>
        := \? left_next right_next. _, _, _, tail_mismatch = payload
        ival_prime_multiplicity_normal_form_mismatch_from_note tail_mismatch
    | CertifiedIntervalPositivePositionalPrimeMultiplicityNormalFormMismatchLeftLastRightMore _ =>
        "canonical-left-group-is-last-while-right-group-has-a-tail"
    | CertifiedIntervalPositivePositionalPrimeMultiplicityNormalFormMismatchLeftMoreRightLast _ =>
        "canonical-left-group-has-a-tail-while-right-group-is-last"

:= ^ ival_prime_multiplicity_normal_form_mismatch_from_symmetry \* left right.
    (mismatch : ival_prime_multiplicity_normal_form_mismatch_from left right) :
    ival_prime_multiplicity_normal_form_mismatch_from right left =
    ?= mismatch ?|
    | CertifiedIntervalPositivePositionalPrimeMultiplicityNormalFormMismatchFromRun run_mismatch =>
        CertifiedIntervalPositivePositionalPrimeMultiplicityNormalFormMismatchFromRun (
            ival_prime_multiplicity_run_mismatch_symmetry run_mismatch)
    | CertifiedIntervalPositivePositionalPrimeMultiplicityNormalFormMismatchFromTail payload =>
        := \? left_next right_next. run_agreement, left_less, right_less, tail_mismatch = payload
        CertifiedIntervalPositivePositionalPrimeMultiplicityNormalFormMismatchFromTail (\? (
            ival_prime_multiplicity_run_agreement_symmetry run_agreement,
            right_less,
            left_less,
            ival_prime_multiplicity_normal_form_mismatch_from_symmetry tail_mismatch))
    | CertifiedIntervalPositivePositionalPrimeMultiplicityNormalFormMismatchLeftLastRightMore payload =>
        := \? right_next. left_run, right_run, right_less, right_tail = payload
        CertifiedIntervalPositivePositionalPrimeMultiplicityNormalFormMismatchLeftMoreRightLast (\? (
            right_run,
            right_less,
            right_tail,
            left_run))
    | CertifiedIntervalPositivePositionalPrimeMultiplicityNormalFormMismatchLeftMoreRightLast payload =>
        := \? left_next. left_run, left_less, left_tail, right_run = payload
        CertifiedIntervalPositivePositionalPrimeMultiplicityNormalFormMismatchLeftLastRightMore (\? (
            right_run,
            left_run,
            left_less,
            left_tail))

:= ival_prime_multiplicity_normal_form_mismatch_symmetry_terminal () : string =
    := mismatch :
        ival_prime_multiplicity_normal_form_mismatch_from
            (positional_zero_bit positional_one)
            (positional_one_bit positional_one) =
        CertifiedIntervalPositivePositionalPrimeMultiplicityNormalFormMismatchFromRun (
            CertifiedIntervalPositivePositionalPrimeMultiplicityRunMismatchHeadLess (
                positional_two_less_three ()))
    ?= ival_prime_multiplicity_normal_form_mismatch_from_symmetry mismatch ?|
    | CertifiedIntervalPositivePositionalPrimeMultiplicityNormalFormMismatchFromRun reversed =>
        ?= reversed ?|
        | CertifiedIntervalPositivePositionalPrimeMultiplicityRunMismatchHeadGreater _ =>
            "normal-form-mismatch-symmetry-lifts-the-real-two-less-than-three-run-mismatch-without-erasing-indices"
        | _ => "normal-form-mismatch-symmetry-unexpected-run-shape"
    | _ => "normal-form-mismatch-symmetry-unexpected-shape"

:| ival_prime_multiplicity_normal_form_agreement_from_decision left right =
    | CertifiedIntervalPositivePositionalPrimeMultiplicityNormalFormAgreementFromMatched :: \* left right.
        ival_prime_multiplicity_normal_form_agreement_from left right ->
        ival_prime_multiplicity_normal_form_agreement_from_decision left right
    | CertifiedIntervalPositivePositionalPrimeMultiplicityNormalFormAgreementFromMismatch :: \* left right.
        ival_prime_multiplicity_normal_form_mismatch_from left right ->
        ival_prime_multiplicity_normal_form_agreement_from_decision left right

:= ^ decide_ival_prime_multiplicity_normal_form_agreement_from \* left right.
    (left_normal : ival_prime_multiplicity_normal_form_from left)
    (right_normal : ival_prime_multiplicity_normal_form_from right)
    : ival_prime_multiplicity_normal_form_agreement_from_decision left right =
    ?= left_normal, right_normal ?|
    | CertifiedIntervalPositivePositionalPrimeMultiplicityNormalFormLast left_run,
      CertifiedIntervalPositivePositionalPrimeMultiplicityNormalFormLast right_run =>
        ?= decide_ival_prime_multiplicity_run_agreement
                left_run right_run ?|
        | CertifiedIntervalPositivePositionalPrimeMultiplicityRunAgreementMatched run_agreement =>
            CertifiedIntervalPositivePositionalPrimeMultiplicityNormalFormAgreementFromMatched (
                CertifiedIntervalPositivePositionalPrimeMultiplicityNormalFormAgreementLast
                    run_agreement)
        | CertifiedIntervalPositivePositionalPrimeMultiplicityRunAgreementMismatch mismatch =>
            CertifiedIntervalPositivePositionalPrimeMultiplicityNormalFormAgreementFromMismatch (
                CertifiedIntervalPositivePositionalPrimeMultiplicityNormalFormMismatchFromRun mismatch)
    | CertifiedIntervalPositivePositionalPrimeMultiplicityNormalFormMore left_payload,
      CertifiedIntervalPositivePositionalPrimeMultiplicityNormalFormMore right_payload =>
        := \? left_next. left_run, left_less, left_rest = left_payload
        := \? right_next. right_run, right_less, right_rest = right_payload
        ?= decide_ival_prime_multiplicity_run_agreement
                left_run right_run ?|
        | CertifiedIntervalPositivePositionalPrimeMultiplicityRunAgreementMatched run_agreement =>
            ?= decide_ival_prime_multiplicity_normal_form_agreement_from
                    left_rest right_rest ?|
            | CertifiedIntervalPositivePositionalPrimeMultiplicityNormalFormAgreementFromMatched rest_agreement =>
                CertifiedIntervalPositivePositionalPrimeMultiplicityNormalFormAgreementFromMatched (
                    CertifiedIntervalPositivePositionalPrimeMultiplicityNormalFormAgreementMore (\? (
                        run_agreement,
                        left_less,
                        right_less,
                        rest_agreement)))
            | CertifiedIntervalPositivePositionalPrimeMultiplicityNormalFormAgreementFromMismatch tail_mismatch =>
                CertifiedIntervalPositivePositionalPrimeMultiplicityNormalFormAgreementFromMismatch (
                    CertifiedIntervalPositivePositionalPrimeMultiplicityNormalFormMismatchFromTail (\? (
                        run_agreement,
                        left_less,
                        right_less,
                        tail_mismatch)))
        | CertifiedIntervalPositivePositionalPrimeMultiplicityRunAgreementMismatch mismatch =>
            CertifiedIntervalPositivePositionalPrimeMultiplicityNormalFormAgreementFromMismatch (
                CertifiedIntervalPositivePositionalPrimeMultiplicityNormalFormMismatchFromRun mismatch)
    | CertifiedIntervalPositivePositionalPrimeMultiplicityNormalFormLast left_run,
      CertifiedIntervalPositivePositionalPrimeMultiplicityNormalFormMore right_payload =>
        := \? right_next. right_run, right_less, right_rest = right_payload
        CertifiedIntervalPositivePositionalPrimeMultiplicityNormalFormAgreementFromMismatch (
            CertifiedIntervalPositivePositionalPrimeMultiplicityNormalFormMismatchLeftLastRightMore (\? (
                left_run,
                right_run,
                right_less,
                right_rest)))
    | CertifiedIntervalPositivePositionalPrimeMultiplicityNormalFormMore left_payload,
      CertifiedIntervalPositivePositionalPrimeMultiplicityNormalFormLast right_run =>
        := \? left_next. left_run, left_less, left_rest = left_payload
        CertifiedIntervalPositivePositionalPrimeMultiplicityNormalFormAgreementFromMismatch (
            CertifiedIntervalPositivePositionalPrimeMultiplicityNormalFormMismatchLeftMoreRightLast (\? (
                left_run,
                left_less,
                left_rest,
                right_run)))

:| ival_prime_multiplicity_normal_form_agreement =
    | CertifiedIntervalPositivePositionalPrimeMultiplicityNormalFormAgreementDone
    | CertifiedIntervalPositivePositionalPrimeMultiplicityNormalFormAgreementSome ::
        (\? left right.
            ival_prime_multiplicity_normal_form_agreement_from
                left right) ->
        ival_prime_multiplicity_normal_form_agreement

:= ival_prime_multiplicity_normal_form_agreement_symmetry_any
    (agreement : ival_prime_multiplicity_normal_form_agreement) :
    ival_prime_multiplicity_normal_form_agreement =
    ?= agreement ?|
    | CertifiedIntervalPositivePositionalPrimeMultiplicityNormalFormAgreementDone =>
        CertifiedIntervalPositivePositionalPrimeMultiplicityNormalFormAgreementDone
    | CertifiedIntervalPositivePositionalPrimeMultiplicityNormalFormAgreementSome payload =>
        := \? left right. indexed = payload
        CertifiedIntervalPositivePositionalPrimeMultiplicityNormalFormAgreementSome (\? (
            ival_prime_multiplicity_normal_form_agreement_symmetry indexed))

:| ival_prime_multiplicity_normal_form_outer_mismatch =
    | CertifiedIntervalPositivePositionalPrimeMultiplicityNormalFormOuterMismatchLeftDoneRightSome ::
        (\? right.
